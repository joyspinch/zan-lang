    /// Candlesticks with a MA-5 overlay and a dataZoom range slider: drag the
    /// handles (or the band) at the bottom to window the 120 bars.
    static void DemoK(App app, int x, int y, int w, int h) {
        List<Candle> cs = new List<Candle>();
        int price = 100;
        for (int i = 0; i < 120; i = i + 1) {
            int drift = ChartView.SinDeg((i * 13) % 360) * 6 / 1000
                      + ((i * 7) % 9) - 4;
            int open = price;
            int close = price + drift;
            if (close < 20) { close = 20; }
            int hi2 = open;
            if (close > hi2) { hi2 = close; }
            hi2 = hi2 + (i * 5) % 4;
            int lo2 = open;
            if (close < lo2) { lo2 = close; }
            lo2 = lo2 - (i * 3) % 4;
            cs.Add(Candle.Of(open, hi2, lo2, close));
            price = close;
        }
        // MA-5 overlay: a plain Line series aligned to the candle index.
        List<int> ma = new List<int>();
        for (int j = 0; j < cs.Count; j = j + 1) {
            int sum = 0;
            int cnt = 0;
            int k = j;
            while (k >= 0 && cnt < 5) { sum = sum + cs[k].close; cnt = cnt + 1; k = k - 1; }
            ma.Add(sum / cnt);
        }
        ChartOption o = ChartOption.Of(Charts.T("Daily price", "日线行情"), null,
            new List<ChartSeries>{
                ChartSeries.OfCandles("K", cs),
                ChartSeries.Line("MA5", ma)
            });
        o.zoom = true;
        ChartView.Keyed(o, Charts.KeyOf(15, 0)).Render(app, x, y, w, h);
    }

