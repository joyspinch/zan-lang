/// Zan Charts — gallery of the OFFICIAL ECharts examples (v6.1.0 注册表全量
/// 377 条)。菜单与标题来自内嵌 charts-registry（官方 chart-list 原文），
/// 每例 option/数据取内嵌 options/<id>.json —— 由官方源码 _scratch/ref5/
/// 逐字转换，Zan 侧只有加载与渲染调用；渲染失败=引擎缺口，进账本修复。
using System;
using System.Json;
using System.Threading;
using Gui;
using Gui.Widget;
using Gui.Component.Chart;

/// 核心契约与语义定义。
/// description（参考站每例的副标题，用来区分同名示例）。
class ChartsDemo {
    string cat;
    string id;
    string en;
    string zh;
    string den;
    string zhd;
    bool ready;
}

class ChartsNavRow {
    bool header;
    int demoIndex;
    string text;
    string desc;

    static ChartsNavRow Header(string text) {
        ChartsNavRow row = new ChartsNavRow();
        row.header = true;
        row.demoIndex = 0 - 1;
        row.text = text;
        row.desc = "";
        return row;
    }

    static ChartsNavRow Entry(int demoIndex, string text, string desc) {
        ChartsNavRow row = new ChartsNavRow();
        row.header = false;
        row.demoIndex = demoIndex;
        row.text = text;
        row.desc = desc;
        return row;
    }
}

/// <summary>
/// 图表选项缓存槽位强类型实体（消除 optIds / optCache / optPending 平行列表反模式）。
/// </summary>
class ChartOptionCacheEntry {
    public string id;
    public ChartOption option;
    public bool pending;

    public ChartOptionCacheEntry(string id, ChartOption option, bool pending) {
        this.id = id != null ? id : "";
        this.option = option;
        this.pending = pending;
    }
}

partial class Charts {
    static App app;
    static SignalInt lang;
    static SignalInt selected;
    static ListView<ChartsNavRow> nav;
    static List<ChartsNavRow> navRows;
    static int navLang = 0 - 1;
    static int navSelRow;
    static Button langEn;
    static Button langZh;
    static List<ChartsDemo> demos;

    static void Main() {
        Charts.BuildCatalog();
        Charts.RegisterMaps();
        // --parsecheck：无头全量校验——每个注册表例的 option 资源
        // 逐个 FromJson，失败清单写 _scratch/parsecheck.txt。渲染
        // 缺口另有账本，这里只验证"全部能装载"。
        if (Environment.ArgCount() > 0 && Environment.ArgAt(0) == "--parsecheck") {
            List<string> bad = new List<string>();
            int n = 0;
            for (int i = 0; i < Charts.demos.Count; i = i + 1) {
                ChartsDemo d = Charts.demos[i];
                if (!d.ready) { continue; }
                string src = Skin.EmbedRead("options/" + d.id + ".json");
                if (src == "") { bad.Add(d.id + ": resource missing"); continue; }
                ChartOption o = ChartOption.FromJson(src);
                if (o == null) { bad.Add(d.id + ": parse failed"); continue; }
                // series 解析成空（如单对象形态被漏收）也是装载失败：
                // 渲染出来只会是 "(no data)" 空板。
                if (o.series.Count < 1) { bad.Add(d.id + ": no series parsed"); continue; }
                n = n + 1;
            }
            string report = "parsed " + n + " / " + Charts.demos.Count + " ready";
            for (int i = 0; i < bad.Count; i = i + 1) { report = report + "\n" + bad[i]; }
            System.IO.File.WriteAllText("_scratch/parsecheck.txt", report);
            return;
        }
        // --census：无头数据普查——parsecheck 只验"能装载"（series
        // 非空数组），series 里没有一条数据照样整块画 "(no data)"。
        // 这里逐系列统计负载条数（data/points/boxes/... 之和），一条
        // 数据都没有的例记 EMPTY。清单写 _scratch/census.txt。
        if (Environment.ArgCount() > 0 && Environment.ArgAt(0) == "--census") {
            List<string> empty = new List<string>();
            int ok = 0;
            int readyN = 0;
            for (int i = 0; i < Charts.demos.Count; i = i + 1) {
                ChartsDemo d = Charts.demos[i];
                if (!d.ready) { continue; }
                readyN = readyN + 1;
                string src = Skin.EmbedRead("options/" + d.id + ".json");
                ChartOption o = src == "" ? null : ChartOption.FromJson(src);
                if (o == null) { empty.Add(d.id + " :: parse failed"); continue; }
                string detail = "";
                int withData = 0;
                for (int s2 = 0; s2 < o.series.Count; s2 = s2 + 1) {
                    ChartSeries cs = o.series[s2];
                    int pay = cs.data.Count + cs.candles.Count + cs.bubbles.Count
                        + cs.boxes.Count + cs.errors.Count + cs.points.Count
                        + cs.tree.Count + cs.links.Count + cs.regions.Count
                        + cs.events.Count + cs.geoLines.Count + cs.parRows.Count
                        + cs.matrix.Count;
                    if (cs.riverPoints.Count > 0) { pay = pay + 1; }
                    if (pay > 0) { withData = withData + 1; }
                    detail = detail + "[" + Convert.ToString(s2) + "]=" + Convert.ToString(pay) + " ";
                }
                if (withData == 0) { empty.Add(d.id + " :: " + detail); continue; }
                ok = ok + 1;
            }
            string creport = "with-data " + Convert.ToString(ok) + " / "
                + Convert.ToString(readyN) + " ready";
            for (int i = 0; i < empty.Count; i = i + 1) {
                creport = creport + "\nEMPTY " + empty[i];
            }
            System.IO.File.WriteAllText("_scratch/census.txt", creport);
            return;
        }
        // ECharts 示例页是白底亮色，画廊默认亮色主题（标题栏内置
        // 皮肤选择器，EnableSkins(1) 预选 Light）。
        App app = new App("Zan Charts", 1160, 760);
        Charts.app = app;
        Charts.lang = new SignalInt(1);
        Charts.selected = new SignalInt(0);
        Charts.InitNav();
        // 列表选中与示例选中从第一帧起就是一回事（否则首例只
        // 有反色文字、没有主色带）。
        Charts.SelectDemo(Charts.selected.Get());

        // 选中行用主色带（默认皮肤只给灰底）；带子加深到主色
        // 的应用需自己把行内文字换成反色——ListItem 默认不换字，
        // 两种皮肤下灰底 + 正常文字都可读。颜色全部走 token。
        app.UseAppCss("listrow:selected { background: var(--primary); }"
            + "listrow:hover { background: var(--bg-hover); }"
            + "listitem::title:selected, listitem::desc:selected"
            + " { color: var(--text-inverse); }");

        if (Environment.ArgCount() > 0) {
            string want = Environment.ArgAt(0);
            bool hit = false;
            // id 优先：demo id "line" 与类目名 "line" 同名，不能让
            // 类目匹配把同名词的第一项抢过去。
            for (int i = 0; i < Charts.demos.Count; i = i + 1) {
                if (want == Charts.demos[i].id) {
                    Charts.SelectDemo(i);
                    hit = true;
                    break;
                }
            }
            if (!hit) {
                for (int i = 0; i < Charts.demos.Count; i = i + 1) {
                    ChartsDemo d = Charts.demos[i];
                    if (want == d.en || want == d.zh || want == d.cat) {
                        Charts.SelectDemo(i);
                        break;
                    }
                }
            }
        }

        app.Show();
        // --nomouse：截图/回归模式——鼠标由自动化宿主管理，帧内
        // 把鼠标钉到窗口外并整体关闭 tooltip，悬停覆盖层不进画面。
        // --skin <name>：启动即选图表皮肤（ChartSkin 名），截图
        // 回归按皮肤取样。
        bool pin = false;
        string skinArg = "";
        for (int ai = 0; ai < Environment.ArgCount(); ai = ai + 1) {
            if (Environment.ArgAt(ai) == "--nomouse") { pin = true; }
            if (Environment.ArgAt(ai) == "--skin"
                && ai + 1 < Environment.ArgCount()) {
                skinArg = Environment.ArgAt(ai + 1);
            }
        }
        if (skinArg != "") { ChartSkin.SetCurrent(skinArg); }
        Charts.nomouse = pin;
        app.SetFrameBody(() => {
            WidgetId.ResetFrame();
            if (pin) { app.mouseX = 0 - 9999; app.mouseY = 0 - 9999; }
            Charts.Render(app);
            app.RenderChrome("Zan Charts");
        });
        WidgetId.Mark();

        // --bench：帧耗时插桩——连渲染 30 帧（首 5 帧丢弃，给字体
        // /贴图预热），逐帧毫秒写 _scratch/bench.txt 后退出。交互
        // 卡顿的量化入口：单帧毫秒 ≈ 鼠标掠过时每事件的全帧成本。
        for (int bi0 = 0; bi0 < Environment.ArgCount(); bi0 = bi0 + 1) {
            if (Environment.ArgAt(bi0) == "--bench") {
                string samples = "";
                for (int bi = 0; bi < 30; bi = bi + 1) {
                    int t0 = Window.GetTickMs();
                    app.BeginFrame();
                    WidgetId.ResetFrame();
                    Charts.Render(app);
                    app.RenderChrome("Zan Charts");
                    app.PresentFrame();
                    if (bi >= 5) {
                        samples = samples
                            + Convert.ToString(Window.GetTickMs() - t0) + " ";
                    }
                }
                System.IO.File.WriteAllText("_scratch/bench.txt",
                    "BENCH " + Environment.ArgAt(0) + " : " + samples);
                app.isRunning = false;
                break;
            }
        }

        // --sweep：全量离屏审查——registry 逐例 FromJson + KeyedStatic
        // 渲染，WritePixels 落 _scratch/sweep/<id>.zpx（ZPX1 裸 ARGB，
        // python 后处理转 PNG/统计/Oracle 对拍）。nomouse 语义：样本
        // 钉死、无悬停层，逐批可复现；单例渲染异常进 manifest 不中断
        // ——渲染失败=引擎缺口，审查 sweep 就是它们的定位机器。
        for (int si = 0; si < Environment.ArgCount(); si = si + 1) {
            if (Environment.ArgAt(si) == "--sweep") {
                Charts.RegisterMaps();
                // 落盘目录不预存时逐张 WritePixels 静默失败、末尾
                // manifest 整体 IOException——这里显式补建（干净检出
                // / 目录被清理后 sweep 依然自洽）。
                if (!System.IO.Directory.ExistsUtf8("_scratch/sweep")) {
                    System.IO.Directory.CreateDirectoryUtf8("_scratch/sweep");
                }
                string manifest = "";
                for (int di = 0; di < Charts.demos.Count; di = di + 1) {
                    ChartsDemo d = Charts.demos[di];
                    Console.WriteLine("SWEEP " + d.id);
                    int t0 = Window.GetTickMs();
                    string phase = "ok";
                    ChartOption o = null;
                    try {
                        string src = Skin.EmbedRead(
                            "options/" + d.id + ".json");
                        if (src == "") { phase = "nojson"; }
                        else { o = ChartOption.FromJson(src); }
                    } catch (Exception ex) {
                        phase = "json-error";
                    }
                    // 卡顿定位：parse（FromJson）与 render（布局+绘制+
                    // 落盘）分列计时——大数据 demo 卡死时先看时间花在
                    // 哪一段（manifest 第 5/6 列）。
                    int parseMs = Window.GetTickMs() - t0;
                    int renderMs = 0;
                    if (o != null) {
                        try {
                            app.BeginFrame();
                            WidgetId.ResetFrame();
                            app.canvas.Clear(0xFFFFFFFF);
                            ChartView.KeyedStatic(o, 7).Render(app,
                                0, 0, app.designW, app.designH);
                        } catch (Exception ex2) {
                            phase = "render-error";
                        }
                        try {
                            app.canvas.WritePixels("_scratch/sweep/"
                                + Charts.SweepFileOf(d.id) + ".zpx",
                                0, 0, app.designW, app.designH);
                        } catch (Exception ex3) {
                            phase = "write-error";
                        }
                        renderMs = Window.GetTickMs() - t0 - parseMs;
                    }
                    manifest = manifest + d.id + "\t"
                        + Convert.ToString(d.ready) + "\t" + phase + "\t"
                        + Convert.ToString(Window.GetTickMs() - t0) + "\t"
                        + Convert.ToString(parseMs) + "\t"
                        + Convert.ToString(renderMs) + "\n";
                }
                System.IO.File.WriteAllText("_scratch/sweep/manifest.txt",
                    manifest);
                app.isRunning = false;
                break;
            }
        }

        while (app.isRunning) {
            int r;
            if (app.needsRedraw) {
                int since = Window.GetTickMs() - app.lastPresentMs;
                if (app.lastPresentMs > 0 && since < 16) {
                    Window.SleepMs(16 - since);
                }
                r = app.window.PollEvent();
            } else if (app.animNextMs >= 0 || app.fxNextMs >= 0) {
                r = 1;
                bool waiting = true;
                while (waiting) {
                    int now = Window.GetTickMs();
                    int deadline = app.animNextMs;
                    if (deadline < 0
                        || (app.fxNextMs >= 0 && app.fxNextMs < deadline)) {
                        deadline = app.fxNextMs;
                    }
                    if (deadline < 0) { waiting = false; }
                    else if (now >= deadline) {
                        bool fxOnly = app.animNextMs < 0 || now < app.animNextMs;
                        if (!(fxOnly && app.FxPresent())) {
                            app.RequestRedraw();
                            waiting = false;
                        }
                    } else {
                        r = app.window.WaitEventTimeout(deadline - now);
                        if (r != 1) { waiting = false; }
                    }
                }
            } else {
                r = app.window.WaitEvent();
            }
            if (r < 0) { break; }
            app.DrainPosts();

            nint evh = Window.EventHwnd();
            int kind = app.window.EventKind();
            if (kind == 8) { break; }

            bool inputEv = kind == 2 || kind == 3 || kind == 13
                || kind == 4 || kind == 6 || kind == 1;
            bool doFrame = true;
            if (!app.needsRedraw && !inputEv) {
                doFrame = false;
            }
            app.ApplyEvent(evh);
            if (doFrame) {
                app.BeginFrame();
                WidgetId.ResetFrame();
                Charts.Render(app);
                app.RenderChrome("Zan Charts");
                app.PresentFrame();
            }
        }
    }

    static void BuildCatalog() {
        // 目录 = 官方注册表全量（chart-list 377 条，官方首现顺序）：
        // 内嵌 charts-registry（--embed 注入），这里只做装载映射。
        Charts.demos = new List<ChartsDemo>();
        JsonValue root = JsonValue.ParseLenient(Skin.EmbedRead("charts-registry"));
        for (int i = 0; i < root.Count(); i = i + 1) {
            JsonValue e = root.At(i);
            ChartsDemo d = new ChartsDemo();
            d.id = e.Str("id", "");
            d.cat = e.Str("cat", "other");
            d.en = e.Str("en", d.id);
            d.zh = e.Str("zh", d.en);
            d.den = "";
            d.zhd = "";
            d.ready = e.Bool("ready", false);
            Charts.demos.Add(d);
        }
    }

    static string T(string en, string zh) {
        if (Charts.lang.Get() == 1) { return zh; }
        return en;
    }

    static string NameOf(ChartsDemo d) { return Charts.T(d.en, d.zh); }

    /// sweep 落盘文件名：doc-example/xxx 的 '/' 换成 '__'。
    static string SweepFileOf(string id) {
        string s = "";
        for (int i = 0; i < id.Length; i = i + 1) {
            char c = id[i];
            if (c == '/') { s = s + "__"; } else { s = s + c; }
        }
        return s;
    }

    static string CatLabel(string cat) {
        // 类目 = 官方注册表（chart-list 6.x）的 category 原文，
        // 中英名对齐官方示例站导航。
        if (cat == "bar") { return Charts.T("Bar", "柱状图"); }
        if (cat == "line") { return Charts.T("Line", "折线图"); }
        if (cat == "pie") { return Charts.T("Pie", "饼图"); }
        if (cat == "scatter") { return Charts.T("Scatter", "散点图"); }
        if (cat == "map") { return Charts.T("Map", "地图"); }
        if (cat == "candlestick") { return Charts.T("Candlestick", "K线图"); }
        if (cat == "radar") { return Charts.T("Radar", "雷达图"); }
        if (cat == "treemap") { return Charts.T("Treemap", "矩形树图"); }
        if (cat == "tree") { return Charts.T("Tree", "树图"); }
        if (cat == "sunburst") { return Charts.T("Sunburst", "旭日图"); }
        if (cat == "boxplot") { return Charts.T("Boxplot", "箱型图"); }
        if (cat == "parallel") { return Charts.T("Parallel", "平行坐标"); }
        if (cat == "sankey") { return Charts.T("Sankey", "桑基图"); }
        if (cat == "themeRiver") { return Charts.T("Theme River", "主题河流"); }
        if (cat == "pictorialBar") { return Charts.T("Pictorial Bar", "象形柱图"); }
        if (cat == "graph") { return Charts.T("Graph", "关系图"); }
        if (cat == "gauge") { return Charts.T("Gauge", "仪表盘"); }
        if (cat == "funnel") { return Charts.T("Funnel", "漏斗图"); }
        if (cat == "calendar") { return Charts.T("Calendar", "日历图"); }
        if (cat == "heatmap") { return Charts.T("Heatmap", "热力图"); }
        if (cat == "custom") { return Charts.T("Custom", "自定义系列"); }
        if (cat == "lines") { return Charts.T("Lines", "路线图"); }
        if (cat == "dataset") { return Charts.T("Dataset", "数据集"); }
        if (cat == "graphic") { return Charts.T("Graphic", "原生图形元素"); }
        if (cat == "chord") { return Charts.T("Chord", "和弦图"); }
        if (cat == "matrix") { return Charts.T("Matrix", "矩阵坐标"); }
        return Charts.T("Other", "其他");
    }

    static int KeyOf(int demo, int sub) { return 700100 + demo * 16 + sub; }

    /// 截图/回归模式（--nomouse）：悬停 tooltip、轴指示器随宿主
    /// 光标进画面，整体关掉，截图只含图表本体。
    static bool nomouse;

    /// 图表皮肤（ChartSkin）选择器：nav 侧栏的单选按钮组，
    /// 一行四档；skinLang 记录建组时的语言（换语言重建选项）。
    static RadioGroup skinGroup;
    static int skinLang = 0 - 1;

    static void Show(App app, ChartOption o, int x, int y, int w, int h) {
        // toolbox/legend/tooltip 一律按 option 声明渲染（ECharts 6
        // 语义），不再整图强制开启。
        if (Charts.nomouse) { o.showTooltip = false; }
        ChartView.Keyed(o, Charts.KeyOf(Charts.selected.Get(), 0)).Render(app, x, y, w, h);
    }

    static void Render(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int top = app.titlebarH;
        int w = c.Width();
        int h = c.Height();
        app.RenderBackground(0, top, w, h - top, 0);

        int sw = app.Scale(260);
        Rect area = new Rect(0, top, w, h - top);
        Charts.RenderNav(app, c, t, area, sw);
        Charts.RenderPreview(app, c, t, area, sw);
    }

    static void RenderNav(App app, Canvas c, Theme t, Rect area, int sw) {
        c.FillRect(area.x, area.y, sw, area.height, t.bgSecondary);
        c.FillRect(area.x + sw - 1, area.y, 1, area.height, t.divider);

        int pad = app.Scale(14);
        c.DrawText(area.x + pad, area.y + app.Scale(20),
            "CHARTS", t.textTertiary, t.fontSizeSmall);

        // EN/中 切换：两个真实 Button，当前语言挂 primary 类。
        int lgH = app.Scale(20);
        int lgW = app.Scale(36);
        int lgY = area.y + app.Scale(15);
        if (Charts.langEn == null) {
            Charts.langEn = new Button("EN");
            Charts.langEn.Prefer(lgW, lgH);
            Charts.langEn.OnClick(() => {
                Charts.lang.Set(0);
                Charts.app.RequestRedraw();
            });
            Charts.langZh = new Button("中");
            Charts.langZh.Prefer(lgW, lgH);
            Charts.langZh.OnClick(() => {
                Charts.lang.Set(1);
                Charts.app.RequestRedraw();
            });
        }
        bool zh = Charts.lang.Get() == 1;
        Charts.langEn.Class = zh ? "" : "primary";
        Charts.langZh.Class = zh ? "primary" : "";
        int lgTotal = lgW * 2 + app.Scale(4);
        Panel.Row().Gap(app.Scale(4))
            .With(Charts.langEn).With(Charts.langZh)
            .RenderInside(app, new Rect(area.x + sw - pad - lgTotal, lgY,
                lgTotal, lgH));

        // 行文本随语言切换重建；列表本体（行、悬停、选中、滚动、
        // 滚动条）全部是 ListView 的职责，这里只喂矩形。
        if (Charts.lang.Get() != Charts.navLang) {
            Charts.navLang = Charts.lang.Get();
            Charts.RebuildNavRows();
            Charts.nav.Bind(Charts.navRows);
        }
        int listTop = area.y + app.Scale(52);
        int listBottom = area.y + area.height - app.Scale(8);
        Charts.nav.RenderInside(app, new Rect(area.x, listTop, sw,
            listBottom - listTop));
    }

    /// 建列表、灌行、接选中事件。只调一次。
    static void InitNav() {
        Charts.nav = new ListView<ChartsNavRow>(r => Charts.NavRowView(r));
        Charts.nav.Class = "flat";
        Charts.RebuildNavRows();
        Charts.nav.Bind(Charts.navRows);
        Charts.nav.OnSelect(Charts.NavPicked);
    }

    /// 按当前语言重建行数据（类目表头 + 示例条目交错）。
    static void RebuildNavRows() {
        Charts.navRows = new List<ChartsNavRow>();
        string lastCat = "";
        for (int i = 0; i < Charts.demos.Count; i = i + 1) {
            ChartsDemo d = Charts.demos[i];
            if (d.cat != lastCat) {
                Charts.navRows.Add(ChartsNavRow.Header(Charts.CatLabel(d.cat)));
                lastCat = d.cat;
            }
            Charts.navRows.Add(ChartsNavRow.Entry(i, Charts.NameOf(d),
                Charts.T(d.den, d.zhd)));
        }
    }

    /// 行模板：两行行的视觉（对称留白、字号、选中配色、省略号）
    /// 都在 stdlib 的 ListItem 里，这里只做数据到控件的映射。
    static Control NavRowView(ChartsNavRow r) {
        if (r.header) { return ListItem.Header(r.text); }
        ListItem it = new ListItem(r.text, r.desc);
        it.Selected = Charts.selected.Get() == r.demoIndex;
        return it;
    }

    /// 列表选中回调：映射回示例下标；类目行不可选中，弹回
    /// 当前示例行。重建行让标题/副标题换上选中配色。
    static void NavPicked() {
        int r = Charts.nav.SelectedIndex();
        if (r < 0 || r >= Charts.navRows.Count) { return; }
        ChartsNavRow row = Charts.navRows[r];
        if (row.header) {
            Charts.nav.SelectIndex(Charts.navSelRow);
            return;
        }
        Charts.navSelRow = r;
        Charts.selected.Set(row.demoIndex);
        Charts.nav.Refresh();
        Charts.app.RequestRedraw();
    }

    /// 按示例下标选中导航行（深链入口）。
    static void SelectDemo(int demoIdx) {
        Charts.selected.Set(demoIdx);
        for (int i = 0; i < Charts.navRows.Count; i = i + 1) {
            ChartsNavRow r = Charts.navRows[i];
            if (!r.header && r.demoIndex == demoIdx) {
                Charts.navSelRow = i;
                Charts.nav.SelectIndex(i);
                break;
            }
        }
        if (!Charts.nomouse && Charts.demos[demoIdx].id == "bump-chart") {
            Charts.ReRollBump();
        }
    }

    /// 凹凸图运行时随机化：官方 bump-chart.ts 每次页面加载用
    /// Math.random 洗牌 9 名 × 6 年的排名，内嵌 json 只是一次物化
    /// 样本。演示每次打开重掷一批（同一次打开内帧间稳定，缓存的
    /// option 被整只替换）；--nomouse 回归模式跳过——钉死样本，
    /// 截图/对比才可复现。
    static void ReRollBump() {
        string src = Skin.EmbedRead("options/bump-chart.json");
        ChartOption o = src == "" ? null : ChartOption.FromJson(src);
        if (o == null || o.series == null || o.series.Count < 2) { return; }
        Random rng = new Random();
        int years = o.series[0].data.Count;
        for (int y = 0; y < years; y = y + 1) {
            // 每年一列 1..N 的排列：先顺序，再 Fisher-Yates 洗牌，
            // 保证凹凸图"每列恰是名次排列"的数据不变量。
            List<int> col = new List<int>();
            for (int i = 0; i < o.series.Count; i = i + 1) { col.Add(i + 1); }
            for (int i = o.series.Count - 1; i > 0; i = i + 0 - 1) {
                int j = rng.NextBelow(i + 1);
                int t = col[i]; col[i] = col[j]; col[j] = t;
            }
            for (int si = 0; si < o.series.Count; si = si + 1) {
                ChartSeries s = o.series[si];
                if (y < s.data.Count) {
                    s.data[y].val = col[si];
                    s.data[y].number = (double)col[si];
                }
            }
        }
        // 启动参数路径 SelectDemo 早于任何 Draw，缓存列表可能还没建。
        if (Charts.optEntries == null) {
            Charts.optEntries = new List<ChartOptionCacheEntry>();
        }
        for (int i = 0; i < Charts.optEntries.Count; i = i + 1) {
            if (Charts.optEntries[i].id == "bump-chart") {
                Charts.optEntries[i].option = o;
                Charts.optEntries[i].pending = false;
                return;
            }
        }
        Charts.optEntries.Add(new ChartOptionCacheEntry("bump-chart", o, false));
    }

    static void RenderPreview(App app, Canvas c, Theme t, Rect area, int sw) {
        int x = area.x + sw;
        int w = area.width - sw;
        int pad = app.Scale(14);
        int sel = Charts.selected.Get();
        if (sel < 0 || sel >= Charts.demos.Count) { sel = 0; }
        ChartsDemo d = Charts.demos[sel];
        string head = Charts.CatLabel(d.cat) + "  /  " + Charts.NameOf(d)
            + "   ·   " + d.id;
        c.DrawText(x + pad, area.y + app.Scale(14), head,
            t.textSecondary, t.fontSizeSmall);

        // 图表皮肤（ChartSkin）选择：图表配色是独立板块，与全局
        // 皮肤主题无关。连体单选按钮组一行四档，随嵌入的图表显示
        // 在预览头，换肤全窗生效。
        int skW = app.Scale(64);
        c.DrawText(x + w - pad - app.Scale(380), area.y + app.Scale(18),
            Charts.T("CHART SKIN", "图表皮肤"), t.textTertiary, t.fontSizeSmall);
        if (Charts.skinLang != Charts.lang.Get()) {
            Charts.skinLang = Charts.lang.Get();
            bool skEn = Charts.skinLang == 0;
            RadioGroup skG = new RadioGroup();
            skG.Buttons = true;
            skG.Size = "small";
            for (int si = 0; si < ChartSkin.Count(); si = si + 1) {
                skG.AddOption(ChartSkin.Label(si, skEn), si);
            }
            int skCur = ChartSkin.IndexOf(ChartSkin.Current());
            skG.SetSelectedValue(skCur >= 0 ? skCur : 0);
            skG.OnChange(() => {
                int v = Charts.skinGroup.SelectedValue();
                if (v >= 0 && v < ChartSkin.Count()) {
                    ChartSkin.SetCurrent(ChartSkin.Name(v));
                }
                Charts.app.RequestRedraw();
            });
            Charts.skinGroup = skG;
        }
        Charts.skinGroup.RenderInside(app, new Rect(
            x + w - pad - app.Scale(380) + skW + app.Scale(8),
            area.y + app.Scale(10), app.Scale(310), app.Scale(24)));

        int top = area.y + app.Scale(40);
        Charts.Draw(app, d.id, x + pad, top,
            w - pad * 2, area.y + area.height - pad - top);
    }

    static string dynActiveId;
    static int dynLastTick;
    static Random dynRng;
    static int dynYear = 1950;

    static void StepDynamic(App app, string id, ChartOption o) {
        if (Charts.nomouse) { return; }
        if (id != "dynamic-data" && id != "dynamic-data2" && id != "bar-race" && id != "bar-race-country") {
            return;
        }
        if (Charts.dynRng == null) { Charts.dynRng = Random.Seeded(42); }
        int now = Window.GetTickMs();
        if (Charts.dynActiveId != id) {
            Charts.dynActiveId = id;
            Charts.dynLastTick = now;
            Charts.dynYear = 1950;
        }

        int interval = 1200;
        if (id == "bar-race" || id == "bar-race-country") { interval = 2000; }
        app.RequestAnimationFrame(interval);

        if (now - Charts.dynLastTick < interval) {
            return;
        }
        Charts.dynLastTick = now;

        if (id == "dynamic-data") {
            if (o.xAxes.Count > 0 && o.xAxes[0].categories.Count > 0) {
                o.xAxes[0].categories.RemoveAt(0);
                DateTime dt = DateTime.LocalNow();
                string ts = dt.ToTimeString();
                o.xAxes[0].categories.Add(ts);
            }
            if (o.series.Count > 0 && o.series[0].data.Count > 0) {
                o.series[0].data.RemoveAt(0);
                o.series[0].data.Add(ChartData.Of(Charts.dynRng.Between(50, 800)));
            }
            if (o.series.Count > 1 && o.series[1].data.Count > 0) {
                o.series[1].data.RemoveAt(0);
                double nv = (double)Charts.dynRng.Between(5, 25) + (double)Charts.dynRng.Between(0, 9) * 0.1;
                o.series[1].data.Add(ChartData.Numeric(nv));
            }
            app.RequestRedraw();
        } else if (id == "dynamic-data2") {
            if (o.series.Count > 0 && o.series[0].points.Count > 0) {
                o.series[0].points.RemoveAt(0);
                ChartPoint lastPt = o.series[0].points[o.series[0].points.Count - 1];
                int nextDay = lastPt.x + 1;
                int delta = Charts.dynRng.Between(-25, 26);
                int nextVal = lastPt.y + delta;
                if (nextVal < 100) { nextVal = 100; }
                if (nextVal > 1500) { nextVal = 1500; }
                o.series[0].points.Add(ChartPoint.Of(nextDay, nextVal));
            }
            app.RequestRedraw();
        } else if (id == "bar-race") {
            if (o.yAxes.Count > 0 && o.series.Count > 0 && o.series[0].data.Count > 0) {
                ChartSeries s = o.series[0];
                ChartAxis ya = o.yAxes[0];
                for (int i = 0; i < s.data.Count; i = i + 1) {
                    int add = Charts.dynRng.Between(0, 10) > 7 ? Charts.dynRng.Between(300, 1500) : Charts.dynRng.Between(50, 300);
                    s.data[i].val = s.data[i].val + add;
                    s.data[i].number = (double)s.data[i].val;
                }
                for (int i = 0; i < s.data.Count - 1; i = i + 1) {
                    for (int j = 0; j < s.data.Count - 1 - i; j = j + 1) {
                        if (s.data[j].val < s.data[j + 1].val) {
                            ChartData td = s.data[j]; s.data[j] = s.data[j + 1]; s.data[j + 1] = td;
                            if (j + 1 < ya.categories.Count) {
                                string tc = ya.categories[j]; ya.categories[j] = ya.categories[j + 1]; ya.categories[j + 1] = tc;
                            }
                        }
                    }
                }
            }
            app.RequestRedraw();
        } else if (id == "bar-race-country") {
            Charts.dynYear = Charts.dynYear + 5;
            if (Charts.dynYear > 2020) { Charts.dynYear = 1950; }
            if (o.yAxes.Count > 0 && o.series.Count > 0 && o.series[0].data.Count > 0) {
                ChartSeries s = o.series[0];
                ChartAxis ya = o.yAxes[0];
                for (int i = 0; i < s.data.Count; i = i + 1) {
                    double growth = 1.05 + (double)Charts.dynRng.Between(0, 12) * 0.01;
                    s.data[i].number = s.data[i].number * growth;
                    s.data[i].val = (int)s.data[i].number;
                }
                for (int i = 0; i < s.data.Count - 1; i = i + 1) {
                    for (int j = 0; j < s.data.Count - 1 - i; j = j + 1) {
                        if (s.data[j].number < s.data[j + 1].number) {
                            ChartData td = s.data[j]; s.data[j] = s.data[j + 1]; s.data[j + 1] = td;
                            if (j + 1 < ya.categories.Count) {
                                string tc = ya.categories[j]; ya.categories[j] = ya.categories[j + 1]; ya.categories[j + 1] = tc;
                            }
                        }
                    }
                }
                o.title = "GDP by Country (" + Charts.dynYear + ")";
            }
            app.RequestRedraw();
        }
    }

    static void Draw(App app, string id, int x, int y, int w, int h) {
        // 通用装载：id = 官方注册表 id，option 逐字来自内嵌资源
        // options/<id>.json（含 doc-example/ 子目录）。Zan 侧没有
        // 任何示例数据装配代码——渲染不对就是引擎缺口，进账本。
        ChartOption cached = Charts.OptionOf(id);
        if (cached == null) {
            if (Charts.IsPending(id)) { Charts.DrawLoading(app, x, y, w, h); }
            else { Charts.DrawEmpty(app, id, x, y, w, h); }
            return;
        }
        Charts.StepDynamic(app, id, cached);
        Charts.Show(app, cached, x, y, w, h);
    }

    /// 后台装载中的占位：worker 经 App.Post 收货后下一帧即为成图。
    static void DrawLoading(App app, int x, int y, int w, int h) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        c.DrawText(x + w / 2 - app.Scale(40), y + h / 2 - app.Scale(10),
            Charts.T("Loading…", "加载中…"), t.textTertiary,
            t.fontSizeMedium);
    }

    // ---- option 缓存 + 地图注册 ------------------------------------
    // FromJson 不是免费的（world.json 解析 + BindSeries 几何克隆），
    // 每帧重复会卡顿；ChartOption 交互态全部在 app.State（按 iwid），
    // option 本体跨帧复用安全。使用 ChartOptionCacheEntry 强类型实体消除平行列表。
    static List<ChartOptionCacheEntry> optEntries;

    static ChartOption OptionOf(string id) {
        if (Charts.optEntries == null) {
            Charts.optEntries = new List<ChartOptionCacheEntry>();
        }
        for (int i = 0; i < Charts.optEntries.Count; i = i + 1) {
            if (Charts.optEntries[i].id == id) { return Charts.optEntries[i].option; }
        }
        // 未内置例（registry ready=false，无 JSON）保持同步空态；
        // 可渲染例走后台装载——UI 线程 FromJson 会卡住交互（geo-svg
        // 系列实测 2.6s）。--nomouse 回归模式除外：单帧截图必须
        // 看到终态，保持同步。
        bool ready = false;
        for (int i = 0; i < Charts.demos.Count; i = i + 1) {
            if (Charts.demos[i].id == id) {
                ready = Charts.demos[i].ready == 1;
                break;
            }
        }
        ChartOptionCacheEntry entry = new ChartOptionCacheEntry(id, null, false);
        Charts.optEntries.Add(entry);
        int slot = Charts.optEntries.Count - 1;
        if (!ready || Charts.nomouse) {
            string src0 = Skin.EmbedRead("options/" + id + ".json");
            entry.option = src0 == "" ? null : ChartOption.FromJson(src0);
            entry.pending = false;
        } else {
            entry.pending = true;
            Charts.KickLoad(id, slot);
        }
        return entry.option;
    }

    /// 后台装载（DataTable.HttpSource / ImageHttp 同款定式）：worker
    /// 只做内嵌资源读取 + FromJson 纯计算，不触 UI 状态；成品经
    /// App.Post 捕获闭包整只移交 UI 线程——Post 自带 window.Wake()
    /// 唤醒阻塞中的事件循环，DrainPosts 执行后自动置 needsRedraw。
    static void KickLoad(string id, int slot) {
        Thread.Start(() => {
            string src = Skin.EmbedRead("options/" + id + ".json");
            ChartOption o = src == "" ? null : ChartOption.FromJson(src);
            Charts.app.Post(() => {
                if (slot < Charts.optEntries.Count
                    && Charts.optEntries[slot].id == id) {
                    Charts.optEntries[slot].option = o;
                    Charts.optEntries[slot].pending = false;
                }
            });
        });
    }

    static bool IsPending(string id) {
        if (Charts.optEntries == null) { return false; }
        for (int i = 0; i < Charts.optEntries.Count; i = i + 1) {
            if (Charts.optEntries[i].id == id) {
                return Charts.optEntries[i].pending;
            }
        }
        return false;
    }

    /// 进程级一次性：把内嵌地图资产注册进 ChartMaps（echarts
    /// registerMap 的对应物；名字与官方示例 option 里的 map/geo.map
    /// 逐字一致）。SVG 几何惰性扫描，注册本身只存文本。
    static int mapsRegistered = 0;

    static void RegisterMaps() {
        if (Charts.mapsRegistered == 1) { return; }
        Charts.mapsRegistered = 1;
        ChartMaps.RegisterRegions("china", MapChinaData.Regions());
        ChartMaps.Register("USA", Skin.EmbedRead("maps/USA.json"));
        ChartMaps.Register("world", Skin.EmbedRead("maps/world.json"));
        ChartMaps.Register("HK", Skin.EmbedRead("maps/HK.json"));
        ChartMaps.Register("iceland", Skin.EmbedRead("maps/iceland.json"));
        ChartMaps.Register("ch", Skin.EmbedRead("maps/ch.json"));
        ChartMaps.Register("target_map", Skin.EmbedRead("maps/ch.json"));
        ChartMaps.RegisterSvg("sicily",
            Skin.EmbedRead("maps/Sicily_prehellenic_topographic_map.svg"));
        ChartMaps.RegisterSvg("flight-seats",
            Skin.EmbedRead("maps/flight-seats.svg"));
        ChartMaps.RegisterSvg("organ_diagram",
            Skin.EmbedRead("maps/Veins_Medical_Diagram_clip_art.svg"));
        ChartMaps.RegisterSvg("Beef_cuts_France",
            Skin.EmbedRead("maps/Beef_cuts_France.svg"));
        ChartMaps.RegisterSvg("MacOdrum-LV5-floorplan-web",
            Skin.EmbedRead("maps/MacOdrum-LV5-floorplan-web.svg"));
        ChartMaps.RegisterSvg("ksia-ext-plan",
            Skin.EmbedRead("maps/ksia-ext-plan-min.svg"));
        ChartMaps.RegisterSvg("iceland_svg",
            Skin.EmbedRead("maps/Map_of_Iceland.svg"));
    }

    /// 注册表里未内置的例（ready=false）：运行时依赖桌面引擎
    /// 不具备的环境，明示原因而不是渲染空图。
    static void DrawEmpty(App app, string id, int x, int y, int w, int h) {
        string why;
        if (id == "custom-wind") {
            why = Charts.T("depends on echarts-gl (WebGL globe)", "依赖 WebGL 地球（echarts-gl）");
        } else if (id == "lines-ny") {
            why = Charts.T("streams 32 binary chunks (1M points)", "32 分片二进制流式加载 100 万点");
        } else if (id == "scatter-nebula") {
            why = Charts.T("points are generated by page script at runtime",
                "数据由页面脚本运行时随机生成");
        } else if (id == "doc-example/tutorial-async"
            || id == "doc-example/tutorial-loading") {
            why = Charts.T("demos asynchronous fetch() of remote data",
                "示例演示异步拉取远端数据（fetch）");
        } else {
            why = Charts.T("runtime dependency unavailable", "运行时依赖不可用");
        }
        Canvas c = app.canvas;
        Theme t = app.theme;
        string head = Charts.T("Not bundled: ", "未内置：") + id;
        c.DrawText(x + w / 2 - app.Scale(120), y + h / 2 - app.Scale(10),
            head, t.textSecondary, t.fontSizeMedium);
        c.DrawText(x + w / 2 - app.Scale(120), y + h / 2 + app.Scale(16),
            why, t.textTertiary, t.fontSizeSmall);
    }
}
