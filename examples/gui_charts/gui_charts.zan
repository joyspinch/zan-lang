                ChartSeries.Line(Charts.T("Day", "白天"),
                    new List<int>{ 11, 14, 18, 15, 12, 9, 13 }),
                ChartSeries.Line(Charts.T("Night", "夜间"),
                    new List<int>{ 2, 4, 6, 3, 1, 0 - 2, 3 })
            });
        o.smooth = true;
        o.markPoint = true;
        ChartView.Keyed(o, Charts.KeyOf(1, 0)).Render(app, x, y, w, h);
    }

