using System;
using Gui;
using Gui.Widget;
using Gui.Component.Chart;

// Zan Charts — a standalone chart gallery.
//
// Same skeleton as gui_gallery: a scrollable, grouped navigation on the left
// and a large live preview on the right. Every demo is one declarative
// ChartOption rendered through ChartView — the example never draws chart
// primitives itself, it only composes the component API (ECharts style:
// option < series < data item).
//
// First argument deep-links to a demo by its English or Chinese name:
//   charts_test.exe "Nested rings"

/// One navigation entry: category key plus the bilingual demo name.
class ChartsDemo {
    string cat;
    string en;
    string zh;
}

/// One rendered navigation row: category headers and demo entries share one
/// entity, so the list needs no sentinel demo index.
class ChartsNavRow {
    bool header;
    int demoIndex;
    string text;

    static ChartsNavRow Header(string text) {
        ChartsNavRow row = new ChartsNavRow();
        row.header = true;
        row.demoIndex = 0 - 1;
        row.text = text;
        return row;
    }

    static ChartsNavRow Entry(int demoIndex, string text) {
        ChartsNavRow row = new ChartsNavRow();
        row.header = false;
        row.demoIndex = demoIndex;
        row.text = text;
        return row;
    }
}

/// Virtual source for the ChartBig large-data demo: a single series read
/// straight from a raw List<int> — no per-point ChartData objects, so a 100k
/// point series costs one int list. With ring > 0 the reads wrap around an
/// ever-advancing offset, so the rolling demo scrolls the window with zero
/// data copying: Roll() just bumps the offset.
class ChartsWaveSource : ChartSource {
    List<int> data;
    string sname;
    int scolor;
    int ring;      // visible window length (0 = show the whole series)
    int off;       // ring offset, advanced by Roll()

    static ChartsWaveSource Of(List<int> data, string name, int color, int ring) {
        ChartsWaveSource s = new ChartsWaveSource();
        s.data = data;
        s.sname = name;
        s.scolor = color;
        s.ring = ring;
        s.off = 0;
        return s;
    }

    override int SeriesCount() { return 1; }
    override string SeriesName(int s) { return this.sname; }
    override int SeriesColor(int s) { return this.scolor; }
    override int PointCount(int s) {
        if (this.ring > 0) { return this.ring; }
        return this.data.Count;
    }
    override int ValueAt(int s, int i) {
        int n = this.data.Count;
        if (n < 1) { return 0; }
        if (this.ring > 0) { return this.data[(i + this.off) % n]; }
        if (i < 0 || i >= n) { return 0; }
        return this.data[i];
    }

    void Roll() { this.off = this.off + 1; }
}

class Charts {
    static App app;
    static SignalInt lang;
    static SignalInt selected;
    static ScrollView navView;
    static int lastMotionMs;
    static List<ChartsDemo> demos;

    // Static heavy datasets, built once and reused across frames.
    static ChartOption heat;
    static int heatSlot;
    static ChartState bigStaticState;
    static ChartsWaveSource bigStaticSrc;
    static ChartState bigRingState;
    static ChartsWaveSource bigRingSrc;

    static void Main() {
        App app = App.CreateDark("Zan Charts", 1160, 760);
        Charts.app = app;
        Charts.lang = new SignalInt(0);
        Charts.selected = new SignalInt(0);
        Charts.navView = new ScrollView();
        Charts.BuildCatalog();

        // Deep-link: first argument selects a demo by en/zh name or category.
        if (Environment.ArgCount() > 0) {
            string want = Environment.ArgAt(0);
            for (int i = 0; i < Charts.demos.Count; i = i + 1) {
                ChartsDemo d = Charts.demos[i];
                if (want == d.en || want == d.zh || want == d.cat) {
                    Charts.selected.Set(i);
                    break;
                }
            }
        }

        app.Show();
        // Same drawing code the loop below runs, registered so the framework
        // can paint a frame from inside the window procedure (the system modal
        // resize loop never returns to this loop while an edge is dragged).
        app.SetFrameBody(() => {
            WidgetId.ResetFrame();
            Charts.Render(app);
            app.RenderChrome("Zan Charts");
        });
        // Freeze the id baseline after all retained ids exist, so the
        // per-frame ResetFrame() below never reissues one of them.
        WidgetId.Mark();

        while (app.isRunning) {
            // Poll while a redraw is pending (capped at ~60fps); idle-wait to
            // the earliest animation deadline when one is armed; otherwise
            // block on the next OS event.
            int r;
            if (app.needsRedraw) {
                int since = Window.GetTickMs() - app.lastPresentMs;
                if (app.lastPresentMs > 0 && since < 16) {
                    Window.SleepMs(16 - since);
                }
                r = app.window.PollEvent();
            } else if (app.animNextMs >= 0 || app.fxNextMs >= 0) {
                r = 1;
                bool waiting = true;
                while (waiting) {
                    int now = Window.GetTickMs();
                    int deadline = app.animNextMs;
                    if (deadline < 0
                        || (app.fxNextMs >= 0 && app.fxNextMs < deadline)) {
                        deadline = app.fxNextMs;
                    }
                    if (deadline < 0) { waiting = false; }
                    else if (now >= deadline) {
                        bool fxOnly = app.animNextMs < 0 || now < app.animNextMs;
                        if (!(fxOnly && app.FxPresent())) {
                            app.RequestRedraw();
                            waiting = false;
                        }
                    } else {
                        // Single kernel wait until input or the deadline.
                        r = app.window.WaitEventTimeout(deadline - now);
                        if (r != 1) { waiting = false; }
                    }
                }
            } else {
                r = app.window.WaitEvent();
            }
            if (r < 0) { break; }
            app.DrainPosts();

            nint evh = Window.EventHwnd();
            int kind = app.window.EventKind();
            if (kind == 8) { break; }

            // Chart tooltips follow the pointer, so input events paint; pure
            // pointer motion is throttled to ~30fps so hovering a busy chart
            // can't peg the CPU.
            bool inputEv = kind == 2 || kind == 3 || kind == 13
                || kind == 4 || kind == 6;
            bool doFrame = true;
            if (!app.needsRedraw && !inputEv) {
                if (kind != 1) {
                    doFrame = false;
                } else {
                    int nowMotion = Window.GetTickMs();
                    if (nowMotion - Charts.lastMotionMs < 33) {
                        doFrame = false;
                    } else {
                        Charts.lastMotionMs = nowMotion;
                    }
                }
            }
            app.ApplyEvent(evh);
            if (doFrame) {
                app.BeginFrame();
                WidgetId.ResetFrame();
                Charts.Render(app);
                app.RenderChrome("Zan Charts");
                app.PresentFrame();
            }
        }
    }

    // ------------------------------------------------------------------
    // Catalog
    // ------------------------------------------------------------------

    static void Add(string cat, string en, string zh) {
        ChartsDemo d = new ChartsDemo();
        d.cat = cat;
        d.en = en;
        d.zh = zh;
        Charts.demos.Add(d);
    }

    static void BuildCatalog() {
        Charts.demos = new List<ChartsDemo>();
        Charts.Add("line", "Basic line", "基础折线图");
        Charts.Add("line", "Smooth + peaks", "平滑折线与峰值");
        Charts.Add("line", "Stacked area", "堆叠面积图");
        Charts.Add("line", "Step line", "阶梯折线");
        Charts.Add("bar", "Grouped bars", "分组柱状图");
        Charts.Add("bar", "Stacked bars", "堆叠柱状图");
        Charts.Add("bar", "Horizontal bars", "水平柱状图");
        Charts.Add("bar", "Waterfall", "瀑布图");
        Charts.Add("pie", "Pie + labels", "饼图与标签");
        Charts.Add("pie", "Donut", "环形图");
        Charts.Add("pie", "Rose", "玫瑰图");
        Charts.Add("pie", "Nested rings", "嵌套环饼图");
        Charts.Add("radar", "Radar", "雷达图");
        Charts.Add("scatter", "Scatter", "散点图");
        Charts.Add("scatter", "Bubble", "气泡图");
        Charts.Add("finance", "K-line + zoom", "K 线与缩放");
        Charts.Add("gauge", "Gauge + rings", "仪表盘与圆环");
        Charts.Add("funnel", "Funnel & pyramid", "漏斗与金字塔");
        Charts.Add("hier", "Treemap", "矩形树图");
        Charts.Add("hier", "Sunburst", "旭日图");
        Charts.Add("hier", "Tree", "树图");
        Charts.Add("graph", "Sankey", "桑基图");
        Charts.Add("graph", "Chord", "和弦图");
        Charts.Add("graph", "Force graph", "力导向图");
        Charts.Add("graph", "Event river", "事件河流");
        Charts.Add("graph", "Venn", "韦恩图");
        Charts.Add("more", "Word cloud", "词云");
        Charts.Add("more", "Heatmap", "热力图");
        Charts.Add("more", "Box & error", "箱线与误差");
        Charts.Add("more", "Big data", "大数据");
    }

    static string T(string en, string zh) {
        if (Charts.lang.Get() == 1) { return zh; }
        return en;
    }

    static string NameOf(ChartsDemo d) { return Charts.T(d.en, d.zh); }

    static string CatLabel(string cat) {
        if (cat == "line") { return Charts.T("Line", "折线"); }
        if (cat == "bar") { return Charts.T("Bar", "柱状"); }
        if (cat == "pie") { return Charts.T("Pie", "饼图"); }
        if (cat == "radar") { return Charts.T("Radar", "雷达"); }
        if (cat == "scatter") { return Charts.T("Scatter", "散点"); }
        if (cat == "finance") { return Charts.T("Finance", "金融"); }
        if (cat == "gauge") { return Charts.T("Gauge", "仪表"); }
        if (cat == "funnel") { return Charts.T("Funnel", "漏斗"); }
        if (cat == "hier") { return Charts.T("Hierarchy", "层级"); }
        if (cat == "graph") { return Charts.T("Relations", "关系"); }
        return Charts.T("More", "更多");
    }

    /// Stable per-demo interaction / animation keys (legend toggles, zoom
    /// window and the intro animation all persist on them across frames).
    static int KeyOf(int demo, int sub) { return 700100 + demo * 16 + sub; }

    // ------------------------------------------------------------------
    // Layout
    // ------------------------------------------------------------------

    static void Render(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int top = app.titlebarH;
        int w = c.Width();
        int h = c.Height();
        app.RenderBackground(0, top, w, h - top, 0);

        int sw = app.Scale(212);
        Rect area = new Rect(0, top, w, h - top);
        Charts.RenderNav(app, c, t, area, sw);
        Charts.RenderPreview(app, c, t, area, sw);
    }

    /// Left navigation: category headers interleaved with clickable demo
    /// rows, wheel-scrollable, with the active row highlighted.
    static void RenderNav(App app, Canvas c, Theme t, Rect area, int sw) {
        c.FillRect(area.x, area.y, sw, area.height, t.bgSecondary);
        c.FillRect(area.x + sw - 1, area.y, 1, area.height, t.divider);

        int pad = app.Scale(14);
        c.DrawText(area.x + pad, area.y + app.Scale(20),
            "CHARTS", t.textTertiary, t.fontSizeSmall);

        // EN / 中 language toggle, right-aligned in the header row.
        int lgW = app.Scale(34);
        int lgH = app.Scale(20);
        int lgY = area.y + app.Scale(15);
        int enX = area.x + sw - pad - lgW * 2 - app.Scale(2);
        int zhX = area.x + sw - pad - lgW;
        int curLang = Charts.lang.Get();
        Charts.RenderLangChip(app, c, t, enX, lgY, lgW, lgH, "EN", curLang == 0);
        Charts.RenderLangChip(app, c, t, zhX, lgY, lgW, lgH, "中", curLang == 1);
        if (app.window.EventKind() == 3) {
            if (app.mouseX >= enX && app.mouseX < enX + lgW
                    && app.mouseY >= lgY && app.mouseY < lgY + lgH) {
                Charts.lang.Set(0); app.RequestRedraw();
            } else if (app.mouseX >= zhX && app.mouseX < zhX + lgW
                    && app.mouseY >= lgY && app.mouseY < lgY + lgH) {
                Charts.lang.Set(1); app.RequestRedraw();
            }
        }

        List<ChartsNavRow> rows = new List<ChartsNavRow>();
        string lastCat = "";
        for (int i = 0; i < Charts.demos.Count; i = i + 1) {
            ChartsDemo d = Charts.demos[i];
            if (d.cat != lastCat) {
                rows.Add(ChartsNavRow.Header(Charts.CatLabel(d.cat)));
                lastCat = d.cat;
            }
            rows.Add(ChartsNavRow.Entry(i, Charts.NameOf(d)));
        }

        int listTop = area.y + app.Scale(52);
        int listBottom = area.y + area.height - app.Scale(8);
        int rowH = app.Scale(26);
        int viewH = listBottom - listTop;
        int contentH = rows.Count * rowH;

        // The ScrollView owns wheel handling, clipping and the scrollbar; the
        // list draws every row at its natural position minus the returned
        // offset and lets the container clip whatever falls outside.
        Rect view = new Rect(area.x, listTop, sw, viewH);
        int dy = Charts.navView.Begin(app, view, contentH);

        int sel = Charts.selected.Get();
        bool click = app.window.EventKind() == 3;
        int sx = area.x + pad;
        int swid = sw - pad * 2;
        for (int idx = 0; idx < rows.Count; idx = idx + 1) {
            int ry = listTop + idx * rowH - dy;
            if (ry + rowH > listTop && ry < listBottom) {
                ChartsNavRow row = rows[idx];
                if (row.header) {
                    c.DrawText(sx, ry + app.Scale(8), row.text,
                        t.textTertiary, t.fontSizeSmall);
                } else {
                    bool selRow = row.demoIndex == sel;
                    bool hot = !app.PointerCaptured()
                        && app.mouseX >= area.x && app.mouseX < area.x + sw
                        && app.mouseY >= listTop && app.mouseY < listBottom
                        && app.mouseY >= ry && app.mouseY < ry + rowH;
                    if (selRow) {
                        c.FillRoundRect(sx - app.Scale(4), ry,
                            swid + app.Scale(8), rowH - app.Scale(2),
                            app.Scale(4), t.primary);
                    } else if (hot) {
                        c.FillRoundRect(sx - app.Scale(4), ry,
                            swid + app.Scale(8), rowH - app.Scale(2),
                            app.Scale(4), t.bgHover);
                    }
                    int tc = t.textPrimary;
                    if (selRow) { tc = t.textInverse; }
                    c.DrawText(sx + app.Scale(8), ry + app.Scale(5),
                        row.text, tc, t.fontSizeSmall);
                    if (click && hot && !selRow) {
                        Charts.selected.Set(row.demoIndex);
                        app.RequestRedraw();
                    }
                }
            }
        }

        Charts.navView.End(app, view);
    }

    /// One cell of the EN / 中 language toggle.
    static void RenderLangChip(App app, Canvas c, Theme t, int x, int y,
                                int w, int h, string label, bool active) {
        int bg = t.bgTertiary;
        int fg = t.textSecondary;
        if (active) { bg = t.primary; fg = t.textInverse; }
        c.FillRoundRect(x, y, w, h, app.Scale(4), bg);
        int tw = Canvas.MeasureText(label, t.fontSizeSmall);
        c.DrawText(x + (w - tw) / 2, y + app.Scale(3), label, fg, t.fontSizeSmall);
    }

    /// Right pane: breadcrumb header plus the selected demo filling the rest.
    static void RenderPreview(App app, Canvas c, Theme t, Rect area, int sw) {
        int x = area.x + sw;
        int w = area.width - sw;
        int pad = app.Scale(14);
        int sel = Charts.selected.Get();
        if (sel < 0 || sel >= Charts.demos.Count) { sel = 0; }
        ChartsDemo d = Charts.demos[sel];
        c.DrawText(x + pad, area.y + app.Scale(14),
            Charts.CatLabel(d.cat) + "  /  " + Charts.NameOf(d),
            t.textSecondary, t.fontSizeSmall);
        int top = area.y + app.Scale(40);
        Charts.RenderDemo(app, sel, x + pad, top,
            w - pad * 2, area.y + area.height - pad - top);
    }

    // ------------------------------------------------------------------
    // Demo dispatch
    // ------------------------------------------------------------------

    static void RenderDemo(App app, int idx, int x, int y, int w, int h) {
        if (idx == 0) { Charts.DemoLine(app, x, y, w, h); }
        else if (idx == 1) { Charts.DemoLinePeaks(app, x, y, w, h); }
        else if (idx == 2) { Charts.DemoStackedArea(app, x, y, w, h); }
        else if (idx == 3) { Charts.DemoStepLine(app, x, y, w, h); }
        else if (idx == 4) { Charts.DemoBars(app, x, y, w, h); }
        else if (idx == 5) { Charts.DemoBarsStacked(app, x, y, w, h); }
        else if (idx == 6) { Charts.DemoBarsH(app, x, y, w, h); }
        else if (idx == 7) { Charts.DemoWaterfall(app, x, y, w, h); }
        else if (idx == 8) { Charts.DemoPie(app, x, y, w, h); }
        else if (idx == 9) { Charts.DemoDonut(app, x, y, w, h); }
        else if (idx == 10) { Charts.DemoRose(app, x, y, w, h); }
        else if (idx == 11) { Charts.DemoRings(app, x, y, w, h); }
        else if (idx == 12) { Charts.DemoRadar(app, x, y, w, h); }
        else if (idx == 13) { Charts.DemoScatter(app, x, y, w, h); }
        else if (idx == 14) { Charts.DemoBubble(app, x, y, w, h); }
        else if (idx == 15) { Charts.DemoK(app, x, y, w, h); }
        else if (idx == 16) { Charts.DemoGauge(app, x, y, w, h); }
        else if (idx == 17) { Charts.DemoFunnel(app, x, y, w, h); }
        else if (idx == 18) { Charts.DemoTreemap(app, x, y, w, h); }
        else if (idx == 19) { Charts.DemoSunburst(app, x, y, w, h); }
        else if (idx == 20) { Charts.DemoTree(app, x, y, w, h); }
        else if (idx == 21) { Charts.DemoSankey(app, x, y, w, h); }
        else if (idx == 22) { Charts.DemoChord(app, x, y, w, h); }
        else if (idx == 23) { Charts.DemoForce(app, x, y, w, h); }
        else if (idx == 24) { Charts.DemoEventRiver(app, x, y, w, h); }
        else if (idx == 25) { Charts.DemoVenn(app, x, y, w, h); }
        else if (idx == 26) { Charts.DemoWordCloud(app, x, y, w, h); }
        else if (idx == 27) { Charts.DemoHeatmap(app, x, y, w, h); }
        else if (idx == 28) { Charts.DemoBoxError(app, x, y, w, h); }
        else { Charts.DemoBig(app, x, y, w, h); }
    }

    // ------------------------------------------------------------------
    // Line family
    // ------------------------------------------------------------------

    static List<string> WeekCats() {
        return new List<string>{ Charts.T("Mon", "周一"), Charts.T("Tue", "周二"),
            Charts.T("Wed", "周三"), Charts.T("Thu", "周四"), Charts.T("Fri", "周五"),
            Charts.T("Sat", "周六"), Charts.T("Sun", "周日") };
    }

    static void DemoLine(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Weekly traffic", "每周流量"),
            Charts.WeekCats(), new List<ChartSeries>{
                ChartSeries.Line(Charts.T("Visits", "访问"),
                    new List<int>{ 820, 932, 901, 934, 1290, 1330, 1320 }),
                ChartSeries.Line(Charts.T("Signups", "注册"),
                    new List<int>{ 320, 332, 301, 334, 390, 330, 320 })
            });
        ChartView.Keyed(o, Charts.KeyOf(0, 0)).Render(app, x, y, w, h);
    }

    /// Smooth lines plus markPoint: an ECharts-style pin marks each line's
    /// maximum (and minimum when the series goes negative).
