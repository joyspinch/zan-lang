    static void DemoEventRiver(App app, int x, int y, int w, int h) {
        List<int> va = new List<int>();
        List<int> vb = new List<int>();
        List<int> vc = new List<int>();
        for (int i = 0; i < 24; i = i + 1) {
            // SinDeg 返回千分定点（1000 = 1.0），振幅必须 /1000 还原。
            va.Add(30 + ChartView.SinDeg((i * 15) % 360) * 22 / 1000 + (i * 7) % 12);
            vb.Add(24 + ChartView.SinDeg((i * 15 + 120) % 360) * 16 / 1000 + (i * 5) % 10);
            vc.Add(18 + ChartView.SinDeg((i * 15 + 240) % 360) * 12 / 1000 + (i * 3) % 8);
        }
        ChartOption o = ChartOption.Of(Charts.T("Release events", "发布事件流"),
            null, new List<ChartSeries>{
                ChartSeries.Of(Charts.T("Frontend", "前端"), ChartType.EventRiver, va),
                ChartSeries.Of(Charts.T("Backend", "后端"), ChartType.EventRiver, vb),
                ChartSeries.Of(Charts.T("Infra", "基础设施"), ChartType.EventRiver, vc)
            });
        ChartView.Keyed(o, Charts.KeyOf(24, 0)).Render(app, x, y, w, h);
    }

