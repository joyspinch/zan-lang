using System;
using Gui;
using Gui.Component.Chart;

partial class Charts {
    // 批 6：force / chord 参数化演示（scaling/gravity/minRadius/maxRadius、
    // 节点连线配色、sort/sortSub/gapDeg/ringWidth/ribbonType）。

    static void Force6(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Force params", "力导向参数化"),
            null, new List<ChartSeries>{ ChartSeries.Force(Charts.T("People", "成员"),
                new List<ChartLink>{
                    ChartLink.Of("Alice", "Bob", 12), ChartLink.Of("Alice", "Carol", 8),
                    ChartLink.Of("Bob", "Dave", 6), ChartLink.Of("Carol", "Dave", 9),
                    ChartLink.Of("Carol", "Eve", 5), ChartLink.Of("Dave", "Frank", 7),
                    ChartLink.Of("Eve", "Frank", 4), ChartLink.Of("Frank", "Alice", 10)
                }) });
        ChartSeries s = o.series[0];
        s.forceScaling = 260;           // 弹簧力 ×2.6：整体更舒展
        s.forceGravity = 160;           // 中心引力加强：不至于散到边角
        s.forceMinRadius = 5;           // 节点直径按权重在 5..16px 间插值
        s.forceMaxRadius = 16;
        s.forceLinkColor = Chart.Rgb(150, 156, 164);
        s.forceNodeColor = Chart.Rgb(56, 111, 180);
        o.showLegend = false;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Chord6(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Sorted chord", "权重排序和弦"),
            null, new List<ChartSeries>{ ChartSeries.Chord(Charts.T("Flow", "流量"),
                Charts.WebKitDep()) });
        ChartSeries s = o.series[0];
        s.chordSort = 1;                // ECharts chord.sort："descending"
        s.chordSortSub = true;          // chord.sortSub：子弧按值降序
        s.chordRingWidthPct = 14;       // chordStyle：外环更薄
        o.showLegend = false;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Chord7(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Path ribbons", "细线缎带和弦"),
            null, new List<ChartSeries>{ ChartSeries.Chord(Charts.T("Flow", "流量"),
                Charts.WebFlow()) });
        ChartSeries s = o.series[0];
        s.chordRibbonType = "path";     // ribbonType："path" 细线而非弧带
        s.chordGapDeg = 4;              // 节点间隙固定 4°
        o.showLegend = false;
        Charts.Show(app, o, x, y, w, h);
    }
}
