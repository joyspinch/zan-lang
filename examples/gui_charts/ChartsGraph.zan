    static List<ChartMapRegion> FourRegions(int n, int e, int s, int wgt) {
        return new List<ChartMapRegion>{
            ChartMapRegion.Of(Charts.T("North", "北区"), n, new List<ChartMapRing>{
                ChartMapRing.Of(new List<ChartMapPoint>{
                    ChartMapPoint.Of(5, 5), ChartMapPoint.Of(45, 5),
                    ChartMapPoint.Of(50, 20), ChartMapPoint.Of(35, 35),
                    ChartMapPoint.Of(10, 30), ChartMapPoint.Of(3, 18) }, false) }),
            ChartMapRegion.Of(Charts.T("East", "东区"), e, new List<ChartMapRing>{
                ChartMapRing.Of(new List<ChartMapPoint>{
                    ChartMapPoint.Of(55, 5), ChartMapPoint.Of(95, 5),
                    ChartMapPoint.Of(95, 25), ChartMapPoint.Of(55, 25) }, false),
                ChartMapRing.Of(new List<ChartMapPoint>{
                    ChartMapPoint.Of(60, 35), ChartMapPoint.Of(95, 35),
                    ChartMapPoint.Of(95, 60), ChartMapPoint.Of(60, 60) }, false) }),
            ChartMapRegion.Of(Charts.T("South", "南区"), s, new List<ChartMapRing>{
                ChartMapRing.Of(new List<ChartMapPoint>{
                    ChartMapPoint.Of(5, 55), ChartMapPoint.Of(45, 55),
                    ChartMapPoint.Of(50, 95), ChartMapPoint.Of(5, 95) }, false),
                ChartMapRing.Of(new List<ChartMapPoint>{
                    ChartMapPoint.Of(18, 68), ChartMapPoint.Of(32, 68),
                    ChartMapPoint.Of(32, 82), ChartMapPoint.Of(18, 82) }, true) }),
            ChartMapRegion.Of(Charts.T("West", "西区"), wgt, new List<ChartMapRing>{
                ChartMapRing.Of(new List<ChartMapPoint>{
                    ChartMapPoint.Of(55, 70), ChartMapPoint.Of(90, 70),
                    ChartMapPoint.Of(90, 95), ChartMapPoint.Of(55, 95) }, false) })
        };
    }

    static List<int> MapRampColors() {
        return new List<int>{
            Chart.Rgb(80, 163, 186), Chart.Rgb(234, 199, 54), Chart.Rgb(217, 78, 93) };
    }

    static List<ChartMapRegion> MapCopy(int scale, int add) {
        List<ChartMapRegion> src = MapChinaData.Regions();
        List<ChartMapRegion> outp = new List<ChartMapRegion>();
        for (int i = 0; i < src.Count; i = i + 1) {
            ChartMapRegion r = src[i];
            outp.Add(ChartMapRegion.Of(r.name, r.value * scale / 10 + add, r.rings));
        }
        return outp;
    }

    static List<ChartMapRegion> MapNamed(string[] keep, int scale) {
        List<ChartMapRegion> src = MapChinaData.Regions();
        List<ChartMapRegion> outp = new List<ChartMapRegion>();
        for (int i = 0; i < src.Count; i = i + 1) {
            ChartMapRegion r = src[i];
            bool hit = false;
            for (int k = 0; k < keep.Length; k = k + 1) {
                if (r.name == keep[k]) { hit = true; }
            }
            if (hit) {
                outp.Add(ChartMapRegion.Of(r.name, r.value * scale / 10, r.rings));
            }
        }
        return outp;
    }

    static void Map1(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("iPhone sales", "iphone 销量"),
            null, new List<ChartSeries>{
                ChartSeries.OfRegions("iphone3", Charts.MapCopy(10, 0)) });
        o.showLegend = false;
        o.VisualRange(0, 1000, Charts.MapRampColors());
        Charts.Show(app, o, x, y, w, h);
    }

