using System;
using Gui;
using Gui.Component.Chart;

partial class Charts {
    static List<ChartData> PieTraffic() {
        return new List<ChartData>{
            ChartData.Named(335, Charts.T("Direct", "直接访问")),
            ChartData.Named(310, Charts.T("Mail", "邮件营销")),
            ChartData.Named(234, Charts.T("Affiliate", "联盟广告")),
            ChartData.Named(135, Charts.T("Video", "视频广告")),
            ChartData.Named(1548, Charts.T("Search", "搜索引擎"))
        };
    }

    static void Pie1(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Traffic sources", "访问来源"),
            null, new List<ChartSeries>{
                ChartSeries.Named(Charts.T("Source", "访问来源"), ChartType.Pie, Charts.PieTraffic())
            });
        o.donutPct = 0;
        o.pieLabels = true;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Pie2(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Traffic (donut)", "访问来源（环形）"),
            null, new List<ChartSeries>{
                ChartSeries.Named(Charts.T("Source", "访问来源"), ChartType.Pie, Charts.PieTraffic())
            });
        o.donutPct = 55;
        o.pieLabels = true;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Pie3(App app, int x, int y, int w, int h) {
        List<ChartData> inner = Charts.PieTraffic();
        List<ChartData> outer = new List<ChartData>{
            ChartData.Named(335, Charts.T("Direct", "直达")),
            ChartData.Named(310, Charts.T("Mail", "邮件营销")),
            ChartData.Named(234, Charts.T("Affiliate", "联盟广告")),
            ChartData.Named(135, Charts.T("Video", "视频广告")),
            ChartData.Named(1048, Charts.T("Baidu", "百度")),
            ChartData.Named(251, Charts.T("Google", "谷歌")),
            ChartData.Named(147, Charts.T("Bing", "必应")),
            ChartData.Named(102, Charts.T("Other", "其他"))
        };
        ChartOption o = ChartOption.OfRings(Charts.T("Nested sources", "访问来源（嵌套）"),
            new List<ChartSeries>{
                ChartSeries.Named(Charts.T("Source", "来源"), ChartType.Pie, inner),
                ChartSeries.Named(Charts.T("Detail", "细分"), ChartType.Pie, outer)
            });
        o.showLegend = false;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Pie4(App app, int x, int y, int w, int h) {
        ChartSeries s = ChartSeries.Named(Charts.T("Radius", "半径"), ChartType.Pie,
            new List<ChartData>{
                ChartData.Named(40, "rose1"), ChartData.Named(38, "rose2"),
                ChartData.Named(32, "rose3"), ChartData.Named(30, "rose4"),
                ChartData.Named(28, "rose5"), ChartData.Named(26, "rose6"),
                ChartData.Named(22, "rose7"), ChartData.Named(18, "rose8")
            });
        s.roseType = "radius";
        ChartOption o = ChartOption.Of(Charts.T("Nightingale rose", "南丁格尔玫瑰图"),
            null, new List<ChartSeries>{ s });
        o.donutPct = 0;
        o.pieLabels = true;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Pie5(App app, int x, int y, int w, int h) {
        string[] names = new string[]{
            "Safari", "Firefox", "Chrome", "IE",
            "Opera", "Android", "iOS", Charts.T("Others", "其他") };
        int[] vals = new int[]{ 53, 27, 40, 18, 22, 35, 48, 12 };
        int gap = app.Scale(8);
        int cols = 4;
        int rows = 2;
        int cw = (w - gap * (cols - 1)) / cols;
        int ch = (h - gap * (rows - 1)) / rows;
        if (cw < app.Scale(40)) { cw = app.Scale(40); }
        if (ch < app.Scale(40)) { ch = app.Scale(40); }
        int restCol = Chart.Rgb(230, 232, 236);
        for (int i = 0; i < 8; i = i + 1) {
            int col = i % cols;
            int row = i / cols;
            ChartData hi = ChartData.Named(vals[i], names[i]);
            hi.selected = true;
            hi.color = Chart.Palette(app.theme, i);
            ChartData rest = ChartData.Named(100 - vals[i], "");
            rest.color = restCol;
            ChartSeries s = ChartSeries.Named(names[i], ChartType.Pie,
                new List<ChartData>{ hi, rest });
            ChartOption o = ChartOption.Of(names[i], null,
                new List<ChartSeries>{ s });
            o.donutPct = 68;
            o.pieLabels = false;
            o.showLegend = false;
            o.animate = false;
            int px = x + col * (cw + gap);
            int py = y + row * (ch + gap);
            Charts.ShowQuiet(app, o, i + 1, px, py, cw, ch);
        }
    }

    static void Pie6(App app, int x, int y, int w, int h) {
        ChartSeries s = ChartSeries.Named(Charts.T("Source", "访问来源"), ChartType.Pie,
            Charts.PieTraffic());
        s.data[4].selected = true;
        s.selectedOffset = 0;
        ChartOption o = ChartOption.Of(Charts.T("Are you happy?", "你幸福吗？"),
            null, new List<ChartSeries>{ s });
        o.donutPct = 62;
        o.pieLabels = false;
        o.showLegend = true;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Pie7(App app, int x, int y, int w, int h) {
        ChartOption a = ChartOption.Of(Charts.T("2011", "2011 年"),
            null, new List<ChartSeries>{
                ChartSeries.Named("2011", ChartType.Pie, new List<ChartData>{
                    ChartData.Named(335, Charts.T("Direct", "直接")),
                    ChartData.Named(310, Charts.T("Mail", "邮件")),
                    ChartData.Named(234, Charts.T("Affiliate", "联盟")),
                    ChartData.Named(135, Charts.T("Video", "视频"))
                }) });
        a.donutPct = 0;
        a.pieLabels = true;
        a.showLegend = false;
        ChartOption b = ChartOption.Of(Charts.T("2012", "2012 年"),
            null, new List<ChartSeries>{
                ChartSeries.Named("2012", ChartType.Pie, new List<ChartData>{
                    ChartData.Named(410, Charts.T("Direct", "直接")),
                    ChartData.Named(280, Charts.T("Mail", "邮件")),
                    ChartData.Named(190, Charts.T("Affiliate", "联盟")),
                    ChartData.Named(220, Charts.T("Video", "视频"))
                }) });
        b.donutPct = 0;
        b.pieLabels = true;
        b.showLegend = false;
        Charts.Split2(app, a, b, x, y, w, h);
    }

    static void Pie8(App app, int x, int y, int w, int h) {
        ChartSeries outer = ChartSeries.Named(Charts.T("Region", "区域"), ChartType.Pie,
            new List<ChartData>{
                ChartData.Named(435, Charts.T("East", "东区")),
                ChartData.Named(310, Charts.T("West", "西区")),
                ChartData.Named(235, Charts.T("North", "北区")) });
        ChartSeries mid = ChartSeries.Named(Charts.T("Channel", "渠道"), ChartType.Pie,
            new List<ChartData>{
                ChartData.Named(235, Charts.T("Online", "线上")),
                ChartData.Named(200, Charts.T("Retail", "门店")),
                ChartData.Named(190, Charts.T("Partner", "渠道商")),
                ChartData.Named(350, Charts.T("Direct", "直销")) });
        ChartSeries inner = ChartSeries.Named(Charts.T("Product", "产品"), ChartType.Pie,
            new List<ChartData>{
                ChartData.Named(335, Charts.T("Hardware", "硬件")),
                ChartData.Named(310, Charts.T("Software", "软件")),
                ChartData.Named(330, Charts.T("Service", "服务")) });
        ChartOption o = ChartOption.OfRings(Charts.T("Sales lasagna", "销售千层饼"),
