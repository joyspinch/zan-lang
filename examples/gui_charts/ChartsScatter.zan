using System;
using Gui;
using Gui.Component.Chart;

partial class Charts {
    static List<ChartPoint> HeightMale() {
        return new List<ChartPoint>{
            ChartPoint.Of(161, 51), ChartPoint.Of(167, 59), ChartPoint.Of(159, 49),
            ChartPoint.Of(157, 63), ChartPoint.Of(155, 53), ChartPoint.Of(170, 59),
            ChartPoint.Of(159, 47), ChartPoint.Of(166, 69), ChartPoint.Of(176, 66),
            ChartPoint.Of(160, 75), ChartPoint.Of(172, 55), ChartPoint.Of(170, 54),
            ChartPoint.Of(172, 62), ChartPoint.Of(153, 42), ChartPoint.Of(160, 50) };
    }

    static List<ChartPoint> HeightFemale() {
        return new List<ChartPoint>{
            ChartPoint.Of(174, 65), ChartPoint.Of(175, 71), ChartPoint.Of(193, 80),
            ChartPoint.Of(186, 72), ChartPoint.Of(187, 78), ChartPoint.Of(181, 74),
            ChartPoint.Of(184, 86), ChartPoint.Of(184, 78), ChartPoint.Of(175, 62),
            ChartPoint.Of(184, 81), ChartPoint.Of(180, 74), ChartPoint.Of(177, 64),
            ChartPoint.Of(192, 88), ChartPoint.Of(176, 63), ChartPoint.Of(174, 54) };
    }

    static void Scatter1(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Height vs weight", "男女身高体重分布"),
            null, new List<ChartSeries>{
                ChartSeries.OfPoints(Charts.T("Female", "女生"), Charts.HeightMale()),
                ChartSeries.OfPoints(Charts.T("Male", "男生"), Charts.HeightFemale())
            });
        o.X(ChartAxis.ValueRange(140, 200));
        o.Y(ChartAxis.ValueRange(40, 100));
        o.markPoint = true;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Scatter2(App app, int x, int y, int w, int h) {
        List<Bubble> f = new List<Bubble>();
        List<Bubble> m = new List<Bubble>();
        List<ChartPoint> fp = Charts.HeightMale();
        List<ChartPoint> mp = Charts.HeightFemale();
        for (int i = 0; i < fp.Count; i = i + 1) {
            f.Add(Bubble.Of(fp[i].x, fp[i].y, 6 + (i * 3) % 12));
        }
        for (int i = 0; i < mp.Count; i = i + 1) {
            m.Add(Bubble.Of(mp[i].x, mp[i].y, 8 + (i * 5) % 16));
        }
        ChartOption o = ChartOption.Of(Charts.T("Height-weight bubbles", "身高体重（气泡）"),
            null, new List<ChartSeries>{
                ChartSeries.OfBubbles(Charts.T("Female", "女生"), f),
                ChartSeries.OfBubbles(Charts.T("Male", "男生"), m)
            });
        o.X(ChartAxis.ValueRange(140, 200));
        o.Y(ChartAxis.ValueRange(40, 100));
        Charts.Show(app, o, x, y, w, h);
    }

    static void Scatter3(App app, int x, int y, int w, int h) {
        List<ChartPoint> a = new List<ChartPoint>();
        List<ChartPoint> b = new List<ChartPoint>();
        for (int i = 0; i < 800; i = i + 1) {
            a.Add(ChartPoint.Of((i * 37 + 11) % 100, (i * 53 + 17) % 90 + 5));
            b.Add(ChartPoint.Of((i * 41 + 7) % 100, (i * 29 + 31) % 90 + 8));
        }
        ChartOption o = ChartOption.Of(Charts.T("Large scatter (1.6k)", "大规模散点图"),
            null, new List<ChartSeries>{
                ChartSeries.OfPoints(Charts.T("A", "A 组"), a),
                ChartSeries.OfPoints(Charts.T("B", "B 组"), b)
            });
        Charts.Show(app, o, x, y, w, h);
    }

    static void Scatter4(App app, int x, int y, int w, int h) {
        List<ChartPoint> pts = new List<ChartPoint>();
        for (int i = 0; i < 40; i = i + 1) {
            pts.Add(ChartPoint.Of(i, 20 + (i * 13) % 50));
        }
        ChartOption o = ChartOption.Of(Charts.T("Category scatter", "类目散点图"),
            Charts.Week(), new List<ChartSeries>{
                ChartSeries.OfPoints(Charts.T("Samples", "样本"), pts)
            });
        o.zoom = true;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Scatter5(App app, int x, int y, int w, int h) {
        List<ChartPoint> pts = new List<ChartPoint>();
        for (int i = 0; i < 24; i = i + 1) {
            pts.Add(ChartPoint.Of(i, 40 + ChartView.SinDeg(i * 15) * 20 / 1000));
        }
        ChartOption o = ChartOption.Of(Charts.T("Hourly samples", "时间坐标散点"),
            null, new List<ChartSeries>{
                ChartSeries.OfPoints(Charts.T("Temp", "气温"), pts)
            });
        o.X(ChartAxis.ValueRange(0, 23));
        Charts.Show(app, o, x, y, w, h);
    }

    static void Scatter6(App app, int x, int y, int w, int h) {
        List<Bubble> y2000 = new List<Bubble>{
            Bubble.Of(40, 70, 20), Bubble.Of(55, 65, 35), Bubble.Of(70, 80, 50),
            Bubble.Of(30, 50, 12), Bubble.Of(85, 90, 60) };
        List<Bubble> y2010 = new List<Bubble>{
            Bubble.Of(48, 75, 24), Bubble.Of(62, 72, 40), Bubble.Of(78, 85, 55),
            Bubble.Of(38, 58, 16), Bubble.Of(90, 92, 70) };
        ChartOption a = ChartOption.Of("2000", null,
            new List<ChartSeries>{ ChartSeries.OfBubbles("2000", y2000) });
        a.X(ChartAxis.ValueRange(0, 100));
        a.Y(ChartAxis.ValueRange(0, 100));
        ChartOption b = ChartOption.Of("2010", null,
            new List<ChartSeries>{ ChartSeries.OfBubbles("2010", y2010) });
        b.X(ChartAxis.ValueRange(0, 100));
        b.Y(ChartAxis.ValueRange(0, 100));
        Charts.Split2(app, a, b, x, y, w, h);
    }

    static void Scatter7(App app, int x, int y, int w, int h) {
        List<Bubble> bs = new List<Bubble>();
        for (int i = 0; i < 40; i = i + 1) {
            bs.Add(Bubble.Of((i * 17 + 3) % 95, (i * 23 + 9) % 90, 4 + (i * 7) % 30));
        }
        ChartOption o = ChartOption.Of(Charts.T("Range roam", "值域漫游散点"),
            null, new List<ChartSeries>{ ChartSeries.OfBubbles(Charts.T("GDP", "GDP"), bs) });
        o.X(ChartAxis.ValueRange(0, 100));
        o.Y(ChartAxis.ValueRange(0, 100));
        Charts.Show(app, o, x, y, w, h);
    }

    static void Scatter8(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Styled scatter", "散点图个性化"),
            null, new List<ChartSeries>{
                ChartSeries.OfPoints(Charts.T("A", "A 组"), Charts.HeightMale())
            });
        o.X(ChartAxis.ValueRange(140, 200));
        o.Y(ChartAxis.ValueRange(40, 90));
        o.showValues = true;
        Charts.Show(app, o, x, y, w, h);
    }

    static List<Candle> KSample() {
        return new List<Candle>{
            Candle.Of(2320, 2363, 2287, 2303), Candle.Of(2300, 2308, 2288, 2291),
            Candle.Of(2295, 2347, 2295, 2347), Candle.Of(2347, 2364, 2337, 2359),
            Candle.Of(2361, 2384, 2348, 2382), Candle.Of(2383, 2392, 2371, 2385),
            Candle.Of(2377, 2421, 2370, 2419), Candle.Of(2426, 2440, 2418, 2428),
            Candle.Of(2411, 2437, 2403, 2433), Candle.Of(2433, 2442, 2428, 2434),
            Candle.Of(2431, 2434, 2394, 2419), Candle.Of(2417, 2443, 2414, 2432)
        };
    }

    static void K1(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Shanghai Composite", "上证指数"),
            new List<string>{ "1/24", "1/25", "1/28", "1/29", "1/30", "1/31",
                "2/1", "2/4", "2/5", "2/6", "2/7", "2/8" },
            new List<ChartSeries>{ ChartSeries.OfCandles(Charts.T("Daily", "日K"), Charts.KSample()) });
        o.zoom = true;
        o.markPoint = true;
        Charts.Show(app, o, x, y, w, h);
    }

    static void K2(App app, int x, int y, int w, int h) {
        List<int> ma = new List<int>{
            2316, 2320, 2328, 2342, 2352, 2361, 2379, 2396, 2404, 2410, 2409, 2409 };
        ChartOption o = ChartOption.Of(Charts.T("K + MA5", "K线个性化 + MA5"),
            new List<string>{ "1/24", "1/25", "1/28", "1/29", "1/30", "1/31",
                "2/1", "2/4", "2/5", "2/6", "2/7", "2/8" },
            new List<ChartSeries>{
                ChartSeries.OfCandles("K", Charts.KSample()),
                ChartSeries.Line("MA5", ma)
            });
        o.zoom = true;
        Charts.Show(app, o, x, y, w, h);
    }
}
