                ChartSeries.HBar(Charts.T("2012", "2012"),
                    new List<int>{ 88, 78, 95, 62, 86 })
            });
        o.showValues = true;
        Charts.Show(app, o, x, y, w, h);
    }

    /// 旋风：正负值混合水平条。
