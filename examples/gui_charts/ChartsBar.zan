using System;
using Gui;
using Gui.Component.Chart;

partial class Charts {
    /// ECharts bar1：蒸发量 vs 降水量，标注 + 标线。
    static void Bar1(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Evaporation vs precipitation", "蒸发量与降水量"),
            Charts.Months(), new List<ChartSeries>{
                ChartSeries.Bar(Charts.T("Evaporation", "蒸发量"),
                    new List<int>{ 2, 5, 8, 23, 26, 77, 136, 162, 33, 20, 6, 3 }),
                ChartSeries.Bar(Charts.T("Precipitation", "降水量"),
                    new List<int>{ 3, 6, 9, 26, 29, 71, 176, 182, 49, 19, 6, 2 })
            });
        o.markPoint = true;
        o.markLine = 42;
        o.markLabel = Charts.T("avg 42", "蒸发均值 42");
        Charts.Show(app, o, x, y, w, h);
    }

    static void Bar2(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Stacked weather", "堆积柱状图"),
            Charts.Months(), new List<ChartSeries>{
                ChartSeries.StackedBar(Charts.T("Evaporation", "蒸发量"),
                    new List<int>{ 2, 5, 8, 23, 26, 77, 136, 162, 33, 20, 6, 3 }),
                ChartSeries.StackedBar(Charts.T("Precipitation", "降水量"),
                    new List<int>{ 3, 6, 9, 26, 29, 71, 176, 182, 49, 19, 6, 2 })
            });
        o.markLine = 200;
        o.markLabel = Charts.T("200 mm", "200 mm");
        Charts.Show(app, o, x, y, w, h);
    }

    /// 温度计：底带铺满量程，彩色值段像水银。
    static void Bar3(App app, int x, int y, int w, int h) {
        ChartSeries s = ChartSeries.Bar(Charts.T("Score", "得分"),
            new List<int>{ 70, 82, 91, 64, 88, 75, 59 });
        s.showBackground = true;
        ChartOption o = ChartOption.Of(Charts.T("Thermometer", "温度计式图表"),
            Charts.Week(), new List<ChartSeries>{ s });
        o.showValues = true;
        o.Y(ChartAxis.ValueRange(0, 100));
        Charts.Show(app, o, x, y, w, h);
    }

    static void Bar4(App app, int x, int y, int w, int h) {
        List<ChartData> dta = new List<ChartData>();
        dta.Add(ChartData.Of(100));
        dta.Add(ChartData.Of(45));
        dta.Add(ChartData.Of(30));
        dta.Add(ChartData.Of(20));
        dta.Add(ChartData.Of(15));
        dta.Add(ChartData.Named(0, "total"));
        ChartOption o = ChartOption.Of(Charts.T("Composition waterfall", "组成瀑布图"),
            new List<string>{ Charts.T("Total", "总量"), Charts.T("A", "品类A"),
                Charts.T("B", "品类B"), Charts.T("C", "品类C"),
                Charts.T("D", "品类D"), Charts.T("Rest", "其他") },
            new List<ChartSeries>{ ChartSeries.Waterfall(Charts.T("Share", "构成"), dta) });
        o.showValues = true;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Bar5(App app, int x, int y, int w, int h) {
        List<ChartData> dta = new List<ChartData>();
        dta.Add(ChartData.Of(100));
        dta.Add(ChartData.Of(45));
        dta.Add(ChartData.Of(30));
        dta.Add(ChartData.Of(0 - 20));
        dta.Add(ChartData.Of(0 - 35));
        dta.Add(ChartData.Of(25));
        dta.Add(ChartData.Of(0 - 12));
        dta.Add(ChartData.Named(0, "total"));
        ChartOption o = ChartOption.Of(Charts.T("Cash flow (k$)", "变化瀑布图"),
            new List<string>{ Charts.T("Open", "期初"), Charts.T("Sales", "销售"),
                Charts.T("Funding", "融资"), Charts.T("Salaries", "工资"),
                Charts.T("Cloud", "云服务"), Charts.T("Licenses", "授权"),
                Charts.T("Ads", "广告"), Charts.T("Net", "净额") },
            new List<ChartSeries>{ ChartSeries.Waterfall(Charts.T("Flow", "现金流"), dta) });
        o.showValues = true;
        Charts.Show(app, o, x, y, w, h);
    }

    /// 多系列层叠：两组 stackName 并排。
    static void Bar6(App app, int x, int y, int w, int h) {
        ChartSeries a1 = ChartSeries.StackedBar(Charts.T("East A", "东区-A"),
            new List<int>{ 320, 302, 301, 334, 390, 330, 320 });
        a1.stackName = "east";
        ChartSeries a2 = ChartSeries.StackedBar(Charts.T("East B", "东区-B"),
            new List<int>{ 120, 132, 101, 134, 90, 230, 210 });
        a2.stackName = "east";
        ChartSeries b1 = ChartSeries.StackedBar(Charts.T("West A", "西区-A"),
            new List<int>{ 220, 182, 191, 234, 290, 330, 310 });
        b1.stackName = "west";
        ChartSeries b2 = ChartSeries.StackedBar(Charts.T("West B", "西区-B"),
            new List<int>{ 150, 212, 201, 154, 190, 330, 410 });
        b2.stackName = "west";
        ChartOption o = ChartOption.Of(Charts.T("Stacked groups", "多系列层叠"),
            Charts.Week(), new List<ChartSeries>{ a1, a2, b1, b2 });
        Charts.Show(app, o, x, y, w, h);
    }

    static void Bar7(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("World population (M)", "世界人口（百万）"),
            new List<string>{ "Brazil", "Indonesia", "USA", "India", "China" },
            new List<ChartSeries>{
                ChartSeries.HBar("2011", new List<int>{ 182, 234, 290, 1047, 1317 })
            });
        Charts.Show(app, o, x, y, w, h);
    }

    static void Bar8(App app, int x, int y, int w, int h) {
        ChartSeries s1 = ChartSeries.HBar(Charts.T("Search", "搜索引擎"),
            new List<int>{ 320, 302, 301, 334, 390, 330, 320 });
        s1.stack = 1;
        ChartSeries s2 = ChartSeries.HBar(Charts.T("Direct", "直接访问"),
            new List<int>{ 120, 132, 101, 134, 90, 230, 210 });
        s2.stack = 1;
        ChartSeries s3 = ChartSeries.HBar(Charts.T("Mail", "邮件营销"),
            new List<int>{ 220, 182, 191, 234, 290, 330, 310 });
        s3.stack = 1;
        ChartOption o = ChartOption.Of(Charts.T("Stacked h-bar", "堆积条形图"),
            Charts.Week(), new List<ChartSeries>{ s1, s2, s3 });
        Charts.Show(app, o, x, y, w, h);
    }

    static void Bar9(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Labeled h-bar", "多维条形图"),
            new List<string>{ "HTML", "CSS", "JS", "Zan", "C" },
            new List<ChartSeries>{
                ChartSeries.HBar(Charts.T("2011", "2011"),
