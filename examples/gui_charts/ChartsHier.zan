    static void Treemap1(App app, int x, int y, int w, int h) {
        ChartNode root = ChartNode.Group(Charts.T("Market", "手机份额"), new List<ChartNode>{
            ChartNode.Leaf("Apple", 42), ChartNode.Leaf("Samsung", 28),
            ChartNode.Leaf("Xiaomi", 14), ChartNode.Leaf("OPPO", 9),
            ChartNode.Leaf("Other", 7)
        });
        ChartOption o = ChartOption.Of(Charts.T("Treemap basic", "矩形树图最简配置"),
            null, new List<ChartSeries>{
                ChartSeries.OfTree(Charts.T("Share", "份额"), ChartType.Treemap, root) });
        Charts.Show(app, o, x, y, w, h);
    }

    static void Treemap2(App app, int x, int y, int w, int h) {
        ChartNode phone = ChartNode.Group(Charts.T("Phone", "手机"), new List<ChartNode>{
            ChartNode.Leaf(Charts.T("Flagship", "旗舰机"), 520),
            ChartNode.Leaf(Charts.T("Mid", "中端机"), 340) });
        ChartNode lap = ChartNode.Group(Charts.T("Laptop", "笔记本"), new List<ChartNode>{
            ChartNode.Leaf(Charts.T("Thin", "轻薄本"), 380),
            ChartNode.Leaf(Charts.T("Gaming", "游戏本"), 460) });
        ChartNode digital = ChartNode.Group(Charts.T("Electronics", "数码家电"),
            new List<ChartNode>{ phone, lap });
        ChartNode men = ChartNode.Group(Charts.T("Men", "男装"), new List<ChartNode>{
            ChartNode.Leaf(Charts.T("Coat", "外套"), 245),
            ChartNode.Leaf(Charts.T("Shirt", "衬衫"), 155) });
        ChartNode women = ChartNode.Group(Charts.T("Women", "女装"), new List<ChartNode>{
            ChartNode.Leaf(Charts.T("Dress", "连衣裙"), 305),
            ChartNode.Leaf(Charts.T("CoatW", "大衣"), 210) });
        ChartNode cloth = ChartNode.Group(Charts.T("Apparel", "服饰鞋包"),
            new List<ChartNode>{ men, women });
        ChartNode root = ChartNode.Group(Charts.T("Mall", "商场销售"),
            new List<ChartNode>{ digital, cloth });
        ChartOption o = ChartOption.Of(Charts.T("Mall drill-down", "矩形树图数据下钻"),
            null, new List<ChartSeries>{
                ChartSeries.OfTree(Charts.T("Sales", "销售"), ChartType.Treemap, root) });
        Charts.Show(app, o, x, y, w, h);
    }

    static void Treemap3(App app, int x, int y, int w, int h) {
        ChartNode root = ChartNode.Group("Zan", new List<ChartNode>{
            ChartNode.Group("src", new List<ChartNode>{
                ChartNode.Leaf("compiler", 42), ChartNode.Leaf("runtime", 35),
                ChartNode.Leaf("lsp", 18), ChartNode.Leaf("dap", 12) }),
            ChartNode.Group("stdlib", new List<ChartNode>{
                ChartNode.Leaf("Gui", 30), ChartNode.Leaf("System", 22),
                ChartNode.Leaf("Data", 14) }),
            ChartNode.Leaf("assets", 16)
        });
        ChartOption o = ChartOption.Of(Charts.T("Disk usage", "矩形树图个性化"),
            null, new List<ChartSeries>{
                ChartSeries.OfTree("disk", ChartType.Treemap, root) });
        Charts.Show(app, o, x, y, w, h);
    }

    static ChartNode TreeBasic() {
        return ChartNode.Group(Charts.T("Root", "根节点"), new List<ChartNode>{
            ChartNode.Group(Charts.T("Node 1", "节点1"), new List<ChartNode>{
                ChartNode.Leaf(Charts.T("Leaf 1", "叶子节点1"), 4),
                ChartNode.Leaf(Charts.T("Leaf 2", "叶子节点2"), 4),
                ChartNode.Leaf(Charts.T("Leaf 3", "叶子节点3"), 2),
                ChartNode.Leaf(Charts.T("Leaf 4", "叶子节点4"), 2),
                ChartNode.Leaf(Charts.T("Leaf 5", "叶子节点5"), 2),
                ChartNode.Leaf(Charts.T("Leaf 6", "叶子节点6"), 4) }),
            ChartNode.Group(Charts.T("Node 2", "节点2"), new List<ChartNode>{
                ChartNode.Leaf(Charts.T("Leaf 7", "叶子节点7"), 4),
                ChartNode.Leaf(Charts.T("Leaf 8", "叶子节点8"), 4) }),
            ChartNode.Group(Charts.T("Node 3", "节点3"), new List<ChartNode>{
                ChartNode.Leaf(Charts.T("Leaf 9", "叶子节点9"), 4),
                ChartNode.Leaf(Charts.T("Leaf 10", "叶子节点10"), 4),
                ChartNode.Leaf(Charts.T("Leaf 11", "叶子节点11"), 2),
                ChartNode.Leaf(Charts.T("Leaf 12", "叶子节点12"), 2) })
        });
    }

    static void Tree1(App app, int x, int y, int w, int h) {
        ChartOption o = ChartOption.Of(Charts.T("Tree", "树图"),
            null, new List<ChartSeries>{
                ChartSeries.OfTreeOrient(Charts.T("Tree", "树图"), Charts.TreeBasic(), "vertical") });
        o.roam = true;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Tree2(App app, int x, int y, int w, int h) {
        ChartNode nba = ChartNode.Group(Charts.T("NBA", "NBA 球星"), new List<ChartNode>{
            ChartNode.Leaf(Charts.T("LeBron", "勒布朗"), 2),
            ChartNode.Leaf(Charts.T("Kobe", "科比"), 2),
            ChartNode.Leaf(Charts.T("Durant", "杜兰特"), 2) });
        ChartNode sport = ChartNode.Group(Charts.T("Sports", "体育组"), new List<ChartNode>{
            nba,
            ChartNode.Leaf(Charts.T("Football", "足球球星"), 2),
            ChartNode.Leaf(Charts.T("Tennis", "网球名将"), 2) });
        ChartNode star = ChartNode.Group(Charts.T("Celebs", "名人组"), new List<ChartNode>{
            ChartNode.Leaf(Charts.T("Gates", "比尔·盖茨"), 2),
            ChartNode.Leaf(Charts.T("Cook", "库克"), 2),
            ChartNode.Leaf(Charts.T("Zuck", "扎克伯格"), 2) });
        ChartNode tech = ChartNode.Group(Charts.T("Tech", "科技组"), new List<ChartNode>{
            ChartNode.Leaf(Charts.T("Lei", "雷军"), 2),
            ChartNode.Leaf(Charts.T("Zhou", "周鸿祎"), 2) });
        ChartNode root = ChartNode.Group(Charts.T("Starter", "发起人"),
            new List<ChartNode>{ star, sport, tech });
        ChartOption o = ChartOption.Of(Charts.T("Ice bucket", "冰桶挑战"),
            null, new List<ChartSeries>{
                ChartSeries.OfTreeOrient(Charts.T("Challenge", "冰桶挑战"), root, "vertical") });
        o.roam = true;
        Charts.Show(app, o, x, y, w, h);
    }

