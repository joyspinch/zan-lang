    static void Word2(App app, int x, int y, int w, int h) {
        // 批 6：词云 sizeRange（逐系列字号区间）+ rotate vary（奇数词条 90°）。
        List<ChartData> words = new List<ChartData>{
            ChartData.Named(6800, "手机"), ChartData.Named(5200, "笔记本电脑"),
            ChartData.Named(4100, "平板电脑"), ChartData.Named(3500, "智能手表"),
            ChartData.Named(2900, "无线耳机"), ChartData.Named(2300, "相机"),
            ChartData.Named(1900, "游戏主机"), ChartData.Named(1500, "电子书阅读器"),
            ChartData.Named(1200, "无人机"), ChartData.Named(900, "投影仪"),
            ChartData.Named(700, "音箱"), ChartData.Named(500, "键盘")
        };
        ChartOption o = ChartOption.Of(Charts.T("Rotated word cloud", "旋转词云"),
            null, new List<ChartSeries>{ ChartSeries.WordCloud("3C", words) });
        ChartSeries s = o.series[0];
        s.wcRotate = "vary";
        s.wcMinFontSize = 12;
        s.wcMaxFontSize = 44;
        o.showLegend = false;
        Charts.Show(app, o, x, y, w, h);
    }
}
