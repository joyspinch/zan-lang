                ChartEvent.Of(Charts.T("1.0", "1.0 迭代"), 45, 80, 28),
                ChartEvent.Of(Charts.T("Promo", "促销活动"), 95, 150, 55),
                ChartEvent.Of(Charts.T("2.0", "大版本 2.0"), 165, 215, 38),
                ChartEvent.Of(Charts.T("Meetup", "线下沙龙"), 225, 250, 20)
            });
        ChartOption o = ChartOption.Single(ev);
        o.title = Charts.T("Product events", "产品事件");
        o.showLegend = false;
        Charts.Show(app, o, x, y, w, h);
    }

