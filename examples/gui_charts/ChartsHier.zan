using System;
using Gui;
using Gui.Component.Chart;

partial class Charts {
    static void Heat1(App app, int x, int y, int w, int h) {
        List<ChartSeries> rows = new List<ChartSeries>();
        for (int r = 0; r < 7; r = r + 1) {
            List<int> cells = new List<int>();
            for (int col = 0; col < 24; col = col + 1) {
                int wv = ChartView.SinDeg((r * 30 + col * 15) % 360);
                cells.Add(20 + wv * 40 / 1000 + (r * col) % 20);
            }
            rows.Add(ChartSeries.Of(Charts.Week()[r], ChartType.Heatmap, cells));
        }
        ChartOption o = ChartOption.Of(Charts.T("Hourly activity", "热力图个性化"),
            null, rows);
        o.VisualRange(0, 100, new List<int>{
            Chart.Rgb(80, 163, 186), Chart.Rgb(234, 199, 54), Chart.Rgb(217, 78, 93) });
        o.animate = false;
        Charts.Show(app, o, x, y, w, h);
    }

    static void Heat2(App app, int x, int y, int w, int h) {
        if (Charts.heat == null) {
            List<ChartSeries> rows = new List<ChartSeries>();
            for (int r = 0; r < 12; r = r + 1) {
                List<int> cells = new List<int>();
                for (int col = 0; col < 24; col = col + 1) {
                    int wv = ChartView.SinDeg((r * 30 + col * 15) % 360);
                    cells.Add(40 + wv * 30 / 1000 + (r * col) % 25);
                }
                rows.Add(ChartSeries.Of("R" + Convert.ToString(r + 1),
                    ChartType.Heatmap, cells));
            }
            ChartOption hm = ChartOption.Of(Charts.T("Hourly load", "热力图"), null, rows);
            hm.animate = false;
            Charts.heat = hm;
            Charts.heatSlot = ChartView.AllocCacheSlot();
        }
        ChartView.RenderCached(app, Charts.heat, Charts.heatSlot, x, y, w, h);
        ChartView.HeatmapHover(app, x, y, w, h, Charts.heat);
    }

    static void Heat3(App app, int x, int y, int w, int h) {
        List<string> days = new List<string>{
            Charts.T("Mon", "一"), Charts.T("Tue", "二"), Charts.T("Wed", "三"),
            Charts.T("Thu", "四"), Charts.T("Fri", "五"), Charts.T("Sat", "六"),
            Charts.T("Sun", "日") };
        List<ChartSeries> rows = new List<ChartSeries>();
        for (int r = 0; r < 7; r = r + 1) {
            List<int> cells = new List<int>();
            for (int col = 0; col < 52; col = col + 1) {
                cells.Add((r * 11 + col * 7) % 12);
            }
            rows.Add(ChartSeries.Of(days[r], ChartType.Heatmap, cells));
        }
        ChartOption o = ChartOption.Of(Charts.T("Contribution calendar", "日历热力图"),
            null, rows);
        o.VisualRange(0, 12, new List<int>{
            Chart.Rgb(22, 27, 34), Chart.Rgb(14, 68, 41), Chart.Rgb(38, 166, 65),
            Chart.Rgb(57, 211, 83) });
        o.animate = false;
        o.showLegend = false;
        Charts.Show(app, o, x, y, w, h);
    }

    static void River1(App app, int x, int y, int w, int h) {
        ChartSeries ev = ChartSeries.OfEvents(Charts.T("Product", "产品事件"),
