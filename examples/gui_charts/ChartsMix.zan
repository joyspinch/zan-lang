    static List<int> BigWave(int n, int seed, int amp, int baseV) {
        List<int> pts = new List<int>();
        for (int i = 0; i < n; i = i + 1) {
            int wv = ChartView.SinDeg((i * 5 + seed * 3) % 360) * amp / 1000
                   + ChartView.SinDeg((i * 17 + seed) % 360) * amp / 2000;
            pts.Add(baseV + wv + (i * 7 + seed) % 40);
        }
        return pts;
    }

    static void Other6(App app, int x, int y, int w, int h) {
        int halfH = (h - app.Scale(12)) / 2;
        if (Charts.bigStaticSrc == null) {
            Charts.bigStaticSrc = ChartsWaveSource.Of(
                Charts.BigWave(100000, 53, 520, 230),
                Charts.T("telemetry", "遥测"), 0, 0);
            Charts.bigStaticState = new ChartState();
            Charts.bigRingSrc = ChartsWaveSource.Of(
                Charts.BigWave(20000, 71, 520, 220),
                Charts.T("live", "实时"), 0, 8000);
            Charts.bigRingState = new ChartState();
        }
        ChartOption o1 = ChartOption.Create();
        o1.animate = false;
        o1.series = new List<ChartSeries>{ ChartSeries.Area("", new List<int>{ 0 }) };
        ChartBig.Render(app, Charts.bigStaticState, Charts.bigStaticSrc, o1,
            x, y, w, halfH, Charts.T("100,000 points", "100,000 点"));
        Charts.bigRingSrc.Roll();
        Charts.bigRingState.Invalidate();
        ChartOption o2 = ChartOption.Create();
        o2.animate = false;
        o2.series = new List<ChartSeries>{ ChartSeries.Area("", new List<int>{ 0 }) };
        ChartBig.Render(app, Charts.bigRingState, Charts.bigRingSrc, o2,
            x, y + halfH + app.Scale(12), w, halfH,
            Charts.T("Rolling window (20k)", "滚动窗口（2 万点）"));
        app.RequestAnimationFrame(33);
    }
}
