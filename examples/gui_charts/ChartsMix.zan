    static void Comp3(App app, int x, int y, int w, int h) {
        List<int> vals = new List<int>();
        for (int i = 0; i < 60; i = i + 1) {
            vals.Add(40 + ChartView.SinDeg((i * 12) % 360) * 30 / 1000 + (i * 3) % 15);
        }
        List<string> cats = new List<string>();
        for (int i = 0; i < 60; i = i + 1) { cats.Add(Convert.ToString(i + 1)); }
        ChartOption o = ChartOption.Of(Charts.T("Data zoom", "数据区域缩放"),
            cats, new List<ChartSeries>{ ChartSeries.Line(Charts.T("Series", "序列"), vals) });
        o.zoom = true;
        o.DataZoom(20, 70);
        Charts.Show(app, o, x, y, w, h);
    }

    static void Comp4(App app, int x, int y, int w, int h) {
        List<int> a = new List<int>();
        List<int> b = new List<int>();
        List<string> cats = new List<string>();
        for (int i = 0; i < 80; i = i + 1) {
            a.Add(50 + ChartView.SinDeg((i * 9) % 360) * 25 / 1000 + (i * 5) % 12);
            b.Add(40 + ChartView.SinDeg((i * 9 + 80) % 360) * 20 / 1000 + (i * 3) % 10);
            cats.Add(Convert.ToString(i + 1));
        }
        ChartOption o = ChartOption.Of(Charts.T("Zoom control", "数据区域控件"),
            cats, new List<ChartSeries>{
                ChartSeries.Line(Charts.T("A", "序列A"), a),
                ChartSeries.Line(Charts.T("B", "序列B"), b)
            });
        o.DataZoom(35, 85);
        Charts.Show(app, o, x, y, w, h);
    }

