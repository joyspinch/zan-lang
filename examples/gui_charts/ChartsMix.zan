partial class Charts {
    static void Mix1(App app, int x, int y, int w, int h) {
        ChartSeries bars = ChartSeries.Bar(Charts.T("Evaporation", "蒸发量"),
            new List<int>{ 2, 5, 8, 23, 26, 77, 136, 162, 33, 20, 6, 3 });
        ChartSeries line = ChartSeries.Line(Charts.T("Precipitation", "降水量"),
            new List<int>{ 3, 6, 9, 26, 29, 71, 176, 182, 49, 19, 6, 2 });
        line.axisIndex = 1;
        ChartOption o = ChartOption.Of(Charts.T("Line + bar", "折柱混搭"),
            Charts.Months(), new List<ChartSeries>{ bars, line });
        o.Y(ChartAxis.ValueTitled(Charts.T("mm", "蒸发 mm")));
        o.Y(ChartAxis.ValueTitled(Charts.T("mm rain", "降水 mm")));
        Charts.Show(app, o, x, y, w, h);
    }

    static void Mix2(App app, int x, int y, int w, int h) {
        ChartSeries lo = ChartSeries.StackedArea(Charts.T("Low", "下限"),
            new List<int>{ 10, 12, 14, 11, 13, 15, 12 });
        ChartSeries span = ChartSeries.StackedArea(Charts.T("Range", "区间"),
            new List<int>{ 8, 10, 6, 12, 9, 7, 11 });
        ChartSeries mid = ChartSeries.Line(Charts.T("Mean", "均值"),
            new List<int>{ 14, 17, 17, 17, 17, 18, 17 });
        ChartOption o = ChartOption.Of(Charts.T("Range mix", "折柱混搭（范围）"),
            Charts.Week(), new List<ChartSeries>{ lo, span, mid });
        Charts.Show(app, o, x, y, w, h);
    }

    static void Mix3(App app, int x, int y, int w, int h) {
        ChartOption bars = ChartOption.Of(Charts.T("By month", "逐月"),
            Charts.Months(), new List<ChartSeries>{
                ChartSeries.Bar(Charts.T("Sales", "销量"),
                    new List<int>{ 2, 5, 8, 23, 26, 77, 136, 162, 33, 20, 6, 3 })
            });
        ChartOption pie = ChartOption.Of(Charts.T("Share", "占比"),
            null, new List<ChartSeries>{
                ChartSeries.Named("q", ChartType.Pie, new List<ChartData>{
                    ChartData.Named(335, "Q1"), ChartData.Named(310, "Q2"),
                    ChartData.Named(234, "Q3"), ChartData.Named(135, "Q4")
                }) });
        pie.donutPct = 0;
        pie.pieLabels = true;
        pie.showLegend = false;
        int gap = app.Scale(12);
        int pw = w * 38 / 100;
        Charts.ShowN(app, bars, 0, x, y, w - pw - gap, h);
        Charts.ShowN(app, pie, 1, x + w - pw, y, pw, h);
    }

    static void Mix4(App app, int x, int y, int w, int h) {
        List<ChartPoint> pts = new List<ChartPoint>();
        List<ChartPoint> trend = new List<ChartPoint>();
        for (int i = 0; i < 12; i = i + 1) {
            int v = 20 + (i * 7) % 40;
            trend.Add(ChartPoint.Of(i, v));
            pts.Add(ChartPoint.Of(i, v + ((i * 11) % 9) - 4));
        }
        ChartSeries line = ChartSeries.OfPoints(Charts.T("Trend", "趋势"), trend);
        line.type = ChartType.Line;
        ChartOption o = ChartOption.Of(Charts.T("Line + scatter", "折线散点混搭"),
            null, new List<ChartSeries>{
                ChartSeries.OfPoints(Charts.T("Samples", "样本"), pts),
                line
            });
        o.X(ChartAxis.ValueRange(0, 11));
        Charts.Show(app, o, x, y, w, h);
    }

    static void Mix5(App app, int x, int y, int w, int h) {
