using System;
using System.Json;
using System.Threading;
using Gui;
using Gui.Widget;
using Gui.Component.Chart;

public class ChartOptionCacheEntry {
    public string id;
    public ChartOption option;
    public bool pending;

    public ChartOptionCacheEntry(string id, ChartOption option, bool pending) {
        this.id = id != null ? id : "";
        this.option = option;
        this.pending = pending;
    }
}
