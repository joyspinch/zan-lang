using System;
using System.Json;
using System.Threading;
using Gui;
using Gui.Widget;
using Gui.Component.Chart;

public class ChartsNavRow {
    bool header;
    int demoIndex;
    string text;
    string desc;

    static ChartsNavRow Header(string text) {
        ChartsNavRow row = new ChartsNavRow();
        row.header = true;
        row.demoIndex = 0 - 1;
        row.text = text;
        row.desc = "";
        return row;
    }

    static ChartsNavRow Entry(int demoIndex, string text, string desc) {
        ChartsNavRow row = new ChartsNavRow();
        row.header = false;
        row.demoIndex = demoIndex;
        row.text = text;
        row.desc = desc;
        return row;
    }
}

// 图表选项缓存槽位强类型实体（消除 optIds / optCache / optPending 平行列表反模式）。
