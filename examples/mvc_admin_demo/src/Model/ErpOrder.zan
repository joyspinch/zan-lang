using System;
using System.Data.Orm;

namespace MvcAdminDemo.Model;

/// <summary>
/// 业务示例实体：销售订单
/// 遵循 4 字节整数倍对齐与紧凑字段布局规范。
/// </summary>
[Table(Name = "erp_orders")]
public class ErpOrder {
    [Column(IsIdentity = true, IsPrimary = true)]
    public int id;                   // 主键自增 ID
    [Column(StringLength = 64)]
    public string order_no;          // 订单编号
    [Column(StringLength = 128)]
    public string customer_name;     // 客户名称
    public double amount;            // 订单金额
    public int department_id;        // 归属部门 ID（用于 5 级 DataScope 数据隔离）
    public int owner_id;             // 经办人/创建人 ID
    public int status;               // 订单状态: 1-待付款, 2-已付款, 3-已发货, 4-已完成
    public long created_at;          // 创建时间 Unix 秒时间戳
}
