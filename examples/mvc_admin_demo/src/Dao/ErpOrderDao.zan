using System;
using System.Data;
using System.Collections.Generic;
using Zan.Mvc.Admin.Data;
using MvcAdminDemo.Model;

namespace MvcAdminDemo.Dao;

/// <summary>
/// 业务订单 DAO：继承通用泛型基类 BaseDao<ErpOrder>。
/// 获得开箱即用的标准同步与异步 CRUD 矩阵（FindById/FindAll/Page/Count/Insert/Update/Delete），
/// 仅需在此编写当前业务特有的查询逻辑。
/// </summary>
public class ErpOrderDao : BaseDao<ErpOrder> {
    public ErpOrderDao(IDbConnection db) : base(db) {}

    public static ErpOrderDao Of(IDbConnection db) {
        return new ErpOrderDao(db);
    }

    /// <summary>根据订单唯一编号查找订单</summary>
    public ErpOrder FindByOrderNo(string orderNo) {
        return this.db.Select<ErpOrder>().W("t.order_no = ?").P(orderNo).First();
    }

    /// <summary>异步根据订单唯一编号查找订单</summary>
    public async ErpOrder FindByOrderNoAsync(string orderNo) {
        return await this.db.Select<ErpOrder>().W("t.order_no = ?").P(orderNo).FirstAsync();
    }

    /// <summary>查找某部门的所有订单</summary>
    public List<ErpOrder> FindByDepartment(int departmentId) {
        return this.db.Select<ErpOrder>().W("t.department_id = ?").Pi(departmentId).ToList();
    }

    /// <summary>异步查找某部门的所有订单</summary>
    public async List<ErpOrder> FindByDepartmentAsync(int departmentId) {
        return await this.db.Select<ErpOrder>().W("t.department_id = ?").Pi(departmentId).ToListAsync();
    }
}
