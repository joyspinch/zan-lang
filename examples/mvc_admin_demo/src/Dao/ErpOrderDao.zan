using System;
using System.Data;
using System.Collections.Generic;
using Zan.Mvc.Admin.Data;
using MvcAdminDemo.Model;

namespace MvcAdminDemo.Dao;

/// <summary>
/// 业务订单 DAO：继承通用泛型基类 BaseDao<ErpOrder>。
/// 获得开箱即用的标准表级同步与异步 CRUD 矩阵（FindAll/Page/Count/Insert/Update），
/// 主键（id）及业务唯一编号（order_no）的查询与删除完全由此处按需定义。
/// </summary>
public class ErpOrderDao : BaseDao<ErpOrder> {
    public ErpOrderDao(IDbConnection db) : base(db) {}

    public static ErpOrderDao Of(IDbConnection db) {
        return new ErpOrderDao(db);
    }

    // ==================== [主键精确操作] ====================

    /// <summary>根据主键 ID 查找订单（同步）</summary>
    public ErpOrder FindById(int id) {
        return this.db.Select<ErpOrder>().Where(o => o.id == id).First();
    }

    /// <summary>根据主键 ID 查找订单（异步）</summary>
    public async ErpOrder FindByIdAsync(int id) {
        return await this.db.Select<ErpOrder>().Where(o => o.id == id).FirstAsync();
    }

    /// <summary>根据主键 ID 删除订单（同步）</summary>
    public int DeleteById(int id) {
        return this.db.Delete<ErpOrder>().Where(o => o.id == id).ExecuteAffrows();
    }

    /// <summary>根据主键 ID 删除订单（异步）</summary>
    public async int DeleteByIdAsync(int id) {
        return await this.db.Delete<ErpOrder>().Where(o => o.id == id).ExecuteAffrowsAsync();
    }

    // ==================== [业务特定索引查询] ====================

    /// <summary>根据订单唯一编号查找订单（同步）</summary>
    public ErpOrder FindByOrderNo(string orderNo) {
        return this.db.Select<ErpOrder>().Where(o => o.order_no == orderNo).First();
    }

    /// <summary>根据订单唯一编号查找订单（异步）</summary>
    public async ErpOrder FindByOrderNoAsync(string orderNo) {
        return await this.db.Select<ErpOrder>().Where(o => o.order_no == orderNo).FirstAsync();
    }

    /// <summary>查找某部门的所有订单（同步）</summary>
    public List<ErpOrder> FindByDepartment(int departmentId) {
        return this.db.Select<ErpOrder>().Where(o => o.department_id == departmentId).ToList();
    }

    /// <summary>查找某部门的所有订单（异步）</summary>
    public async List<ErpOrder> FindByDepartmentAsync(int departmentId) {
        return await this.db.Select<ErpOrder>().Where(o => o.department_id == departmentId).ToListAsync();
    }
}
