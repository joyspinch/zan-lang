using System;
using System.IO;
using System.Web;
using System.Data;
using System.Data.Sqlite;
using Zan.Mvc.Admin;
using Zan.Mvc.Admin.Data;
using MvcAdminDemo.Model;
using MvcAdminDemo.Dao;
using MvcAdminDemo.Controller;

class Program {
    static async void Main() {
        Console.WriteLine("==================================================");
        Console.WriteLine("    Zan.Mvc.Admin 业务演示系统 (ERP 订单供应链)");
        Console.WriteLine("==================================================");

        string dbPath = "data/demo.db";
        string dir = Path.GetDirectoryName(dbPath);
        if (dir.Length > 0 && !Directory.Exists(dir)) {
            Directory.CreateDirectory(dir);
        }

        IDbConnection db = AdminApp.OpenDb(dbPath);

        // 业务表结构自动保障
        db.Execute("CREATE TABLE IF NOT EXISTS erp_orders ("
            + "id INTEGER PRIMARY KEY AUTOINCREMENT, "
            + "order_no TEXT, "
            + "customer_name TEXT, "
            + "amount REAL, "
            + "department_id INTEGER, "
            + "owner_id INTEGER, "
            + "status INTEGER, "
            + "created_at INTEGER);");

        // 初始化几条演示订单数据
        ErpOrderDao dao = ErpOrderDao.Of(db);
        if (dao.Count() == 0) {
            Console.WriteLine("[INIT] 插入测试销售订单数据...");
            dao.Insert(new ErpOrder {
                order_no = "ORD-2026-001",
                customer_name = "北京某大型科技集团",
                amount = 128000.0,
                department_id = 1,
                owner_id = 1,
                status = 1,
                created_at = DateTime.UtcNow().ToUnixSeconds()
            });
            dao.Insert(new ErpOrder {
                order_no = "ORD-2026-002",
                customer_name = "上海某智能制造股份公司",
                amount = 56000.0,
                department_id = 2,
                owner_id = 2,
                status = 2,
                created_at = DateTime.UtcNow().ToUnixSeconds()
            });
            Console.WriteLine("[INIT] 演示数据就绪，当前订单总数: " + Convert.ToString(dao.Count()));
        }

        WebApp app = new WebApp("127.0.0.1", 8088);

        // 统一装配中台核心：路由、鉴权中间件、静态资源挂载
        AdminApp.UseAdmin(app, db);

        Console.WriteLine("[SERVER] 服务已就绪，正在监听: http://127.0.0.1:8088");
        Console.WriteLine("  - 若系统首次启动，请访问: http://127.0.0.1:8088/install 引导安装");
        Console.WriteLine("  - 若已安装完成，请访问:   http://127.0.0.1:8088/admin/login 登录后台");

        await WebServer.Run(app, 1, false);
    }
}
