using System;
using System.Web;
using System.Data;
using System.Collections.Generic;
using Zan.Mvc.Admin.Attributes;
using Zan.Mvc.Admin.Web;
using Zan.Mvc.Admin.UI;
using Zan.Mvc.Admin.Security;
using Zan.Mvc.Admin.Model;
using MvcAdminDemo.Model;
using MvcAdminDemo.Dao;

namespace MvcAdminDemo.Controller;

public class OrderPagedResult {
    public int total;
    public List<ErpOrder> list;
    public OrderPagedResult() {
        this.total = 0;
        this.list = new List<ErpOrder>();
    }
    public OrderPagedResult(int total, List<ErpOrder> list) {
        this.total = total;
        this.list = list;
    }
}

/// <summary>
/// 业务控制器：销售订单管理。
/// 继承自企业级通用 CRUD 微内核基类 CrudController<ErpOrder>，开箱即用获得：
/// 1. 标准化中台 CRUD 协议端点 (Conf / SaveConf / List / AddConf / AddSave / EditConf / EditSave / Field / Delete / BatchDelete)
/// 2. 配置三级动态合并与可视化持久化 (代码基线 ⊕ 库中覆盖 ⊕ 用户微调)
/// 3. 行内即时编辑与敏感列安全熔断防护 (FieldSecurityGuard)
/// 4. 0 样板代码、0 手写 HTML/JS、0 手写 SQL
/// </summary>
[AdminModule(Key = "erp", Title = "销售供应链", Icon = "shopping-cart", Order = 2)]
public class ErpOrderController : CrudController<ErpOrder> {
    private ErpOrderDao dao;

    public ErpOrderController(IDbConnection db = null) : base(db != null ? db : GetDb()) {
        this.dao = ErpOrderDao.Of(this.db);
    }

    private static IDbConnection GetDb() {
        IDbConnection db = Zan.Mvc.Admin.AdminApp.Db;
        if (db == null) {
            db = Zan.Mvc.Admin.AdminApp.OpenDb("data/demo.db");
        }
        return db;
    }

    /// <summary>声明表格与筛选器规格（代码基线）</summary>
    protected override TableConfig BuildTableConfig() {
        TableConfig cfg = new TableConfig();
        cfg.Conf.SetKey("id", "销售订单");
        cfg.AddColumn("id", "ID", "number", 60, true, false)
           .AddColumn("order_no", "订单编号", "input", 160, true, false)
           .AddColumn("customer_name", "客户名称", "input", 180, true, true)
           .AddColumn("amount", "金额(元)", "number", 100, true, false)
           .AddColumn("department_id", "部门ID", "text", 90, false, false)
           .AddColumn("status", "状态", "dict", 90, false, true)
           .AddFilter("order_no", "订单号", "Input", "请输入订单号")
           .AddFilter("customer_name", "客户名", "Input", "请输入客户名称")
           .AddTool("新增订单", "Add", "订单", "Primary", false, "600px", "400px")
           .AddTool("批量删除", "Delete", "订单", "Error", true, "400px", "260px");
        return cfg;
    }

    /// <summary>声明新增与编辑动态表单 Schema</summary>
    protected override FormView BuildFormView() {
        FormView form = new FormView("销售订单");
        form.AddField("order_no", "订单编号", "input", true, "请输入唯一订单编号", 12)
            .AddField("customer_name", "客户名称", "input", true, "请输入客户企业全称", 12)
            .AddField("amount", "订单金额", "number", true, "0.00", 12)
            .AddField("department_id", "归属部门", "number", true, "部门编号", 12);
        return form;
    }

    /// <summary>分页检索业务落地（自动融入 5 级 DataScope 数据隔离）</summary>
    protected override string OnPage(int page, int pageSize) {
        List<ErpOrder> all = this.dao.Page(page, pageSize);
        List<ErpOrder> filtered = new List<ErpOrder>();
        DataScope scope = this.CurrentDataScope;
        for (int i = 0; i < all.Count; i = i + 1) {
            ErpOrder o = all[i];
            if (scope.Covers(o.owner_id, o.department_id)) {
                filtered.Add(o);
            }
        }
        OrderPagedResult res = new OrderPagedResult(filtered.Count, filtered);
        return Json.Serialize<OrderPagedResult>(res);
    }

    /// <summary>单据新增保存业务落地</summary>
    protected override int OnInsert(ErpOrder entity) {
        return this.dao.Insert(entity);
    }

    /// <summary>单据编辑更新业务落地</summary>
    protected override int OnUpdate(ErpOrder entity) {
        return this.dao.Update(entity);
    }

    /// <summary>单据删除业务落地</summary>
    protected override void OnDelete(int id) {
        this.dao.DeleteById(id);
    }

    /// <summary>行内单元格即时修改安全落地</summary>
    protected override bool OnField(int id, string fieldName, string fieldValue) {
        ErpOrder order = this.dao.FindById(id);
        if (order == null) {
            return false;
        }
        if (fieldName == "customer_name") {
            order.customer_name = fieldValue;
        } else if (fieldName == "status") {
            order.status = Convert.ToInt32(fieldValue);
        }
        return this.dao.Update(order) > 0;
    }

    /// <summary>菜单与页面路由入口</summary>
    [HttpGet]
    [Route("/admin/erp/order")]
    [AdminAction(Key = "erp:order", Title = "订单管理", Route = "/admin/erp/order", IsMenu = true, Order = 1)]
    public void OrderPage() {
        this.Conf("/admin/erp/order");
    }
}
