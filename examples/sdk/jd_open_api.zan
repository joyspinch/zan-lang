using System;
using Sdk.Jd;
using Sdk.Jd.Api.Area;

/// <summary>
/// 京东 JOS 强类型调用示例。
/// 参数：appKey appSecret accessToken；accessToken 不需要时传 "-"。
/// </summary>
class Program {
    static async void Main() {
        if (Environment.ArgCount() < 3) {
            Console.WriteLine("usage: jd_open_api <appKey> <appSecret> <accessToken|->");
            return;
        }

        JdClient client = new JdClient(Environment.ArgAt(0), Environment.ArgAt(1));
        string token = Environment.ArgAt(2);
        if (token != "-") { client.SetAccessToken(token); }

        JdAreaApi areaApi = new JdAreaApi(client);
        AreaProvinceGetRequest request = new AreaProvinceGetRequest();

        try {
            // 模块 API 自动签名、发送、解包并反序列化；无需处理 JdResponse.Data。
            AreaProvinceGetResponse response = await areaApi.ProvinceGetAsync(request);
            for (int i = 0; i < response.province_areas.Count; i = i + 1) {
                Console.WriteLine(Convert.ToString(response.province_areas[i].id)
                    + " " + response.province_areas[i].name);
            }
        } catch (JdException e) {
            Console.WriteLine("JD error: " + e.Code + " / " + e.Message);
            Console.WriteLine(e.Body);
        }
    }
}
