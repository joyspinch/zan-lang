using System;
using Sdk.Wechat;
using Sdk.Wechat.Mp;

/// <summary>微信公众号强类型用户信息接口示例。参数：appId appSecret openId。</summary>
class Program {
    static async void Main() {
        if (Environment.ArgCount() < 3) {
            Console.WriteLine("usage: wechat_mp <appId> <appSecret> <openId>");
            return;
        }

        WechatClient client = new WechatClient(
            Environment.ArgAt(0), Environment.ArgAt(1));
        WechatMpUserApi users = new WechatMpUserApi(client);
        WechatMpUserApiInfoRequest request = new WechatMpUserApiInfoRequest();
        request.OpenId(Environment.ArgAt(2));

        try {
            // Access token、query 和 JSON 解析均由 SDK 处理，结果字段可直接补全。
            WechatMpUserApiInfoResponse user = await users.InfoAsync(request);
            Console.WriteLine("openid=" + user.openid);
            Console.WriteLine("nickname=" + user.nickname);
            Console.WriteLine("subscribe=" + Convert.ToString(user.subscribe));
        } catch (WechatException e) {
            Console.WriteLine("WeChat error: " + e.Code + " / " + e.Message);
            Console.WriteLine(e.Body);
        }
    }
}
