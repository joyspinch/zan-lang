// Build & run:
using System;
using System.Input;
using System.Drawing;
using System.Threading;

namespace Demo;

public class MouseDemoProgram {
    static void Main() {
        Point p = Mouse.GetPos();
        Console.WriteLine("cursor at: " + Convert.ToString(p.x) + ","
            + Convert.ToString(p.y));

        Mouse.MoveTo(100, 100, 24);
        Thread.Sleep(200);

        Mouse.Click(Mouse.Left());
        Mouse.DoubleClick(Mouse.Left());
        Thread.Sleep(200);

        Mouse.Drag(200, 200, 300, 260);
        Thread.Sleep(200);

        Mouse.Wheel(120);

        Console.WriteLine("done. right-click to exit when satisfied.");
        Mouse.Click(Mouse.Right());
    }
}
