// System.Diagnostics demo: privilege/identity state and process control.
// Read-only by default -- it only queries the current process. The
// suspend/resume/terminate section is commented out because it operates on
// a child it spawns; uncomment to watch it work.
//
// Build & run:
//   build/zanc examples/input/process_control_demo.zan --auto-stdlib -o build/process_control_demo.exe
//   build/process_control_demo.exe
using System;
using System.Diagnostics;

namespace Demo;

class Prog {
    static void Main() {
        Console.WriteLine("== Privileges ==");
        Console.WriteLine("admin:   " + Convert.ToString(Privileges.IsAdmin() ? 1 : 0));
        Console.WriteLine("user:    " + Privileges.UserName());
        Console.WriteLine("sid:     " + Privileges.UserSid());
        #if WINDOWS
        Console.WriteLine("dbg:     " + Convert.ToString(Privileges.EnablePrivilege("SeDebugPrivilege") ? 1 : 0));
        #endif

        Console.WriteLine("== Self process ==");
        int self = ProcessList.SelfPid();
        ProcessEntry me = ProcessList.ByPid(self);
        Console.WriteLine("pid:     " + Convert.ToString(self));
        Console.WriteLine("exe:     " + (me == null ? "" : me.exePath));
        Console.WriteLine("mem:     " + Convert.ToString(me == null ? 0 : me.memoryBytes / 1024) + " KB");
        Console.WriteLine("running: " + Convert.ToString(ProcessControl.IsRunning(self) ? 1 : 0));
        Console.WriteLine("prio:    " + Convert.ToString(ProcessControl.GetPriority(self)));

        Console.WriteLine("== Top processes ==");
        List<ProcessEntry> all = ProcessList.List();
        for (int i = 0; i < all.Count && i < 8; i = i + 1) {
            ProcessEntry e = all[i];
            Console.WriteLine("  " + Convert.ToString(e.pid) + "  " + e.name);
        }
        Console.WriteLine("  ... (" + Convert.ToString(all.Count) + " total)");
    }
}
