// System.Automation.Window + UiElement demo: enumerate, find and wait for
// windows, inspect the MSAA accessibility tree, read/set titles, click controls and menus, move/resize, coordinate
// conversion and state queries -- the Win32 HWND automation surface.
//
// The demo starts its own Notepad instance (notepad.exe, present on every
// Windows since XP), waits for its main window, then:
//   1. prints its class / title / rect / thread / process info
//   2. sets a new title
//   3. walks the "文件/另存为" (File/Save As) style menus if present
//   4. centers the window and brings it to the foreground
//   5. enumerates its child controls
//   6. closes it and waits for it to disappear
//
// If notepad is unavailable, the demo falls back to read-only enumeration
// of the current desktop so the module still gets exercised.
//
// Build & run:
//   build/zanc examples/input/automation_demo.zan --auto-stdlib -o build/automation_demo.exe
//   build/automation_demo.exe
using System;
using System.Automation;

namespace Demo;

class Prog {
    static void Main() {
        #if WINDOWS
        Console.WriteLine("== top-level windows ==");
        List<nint> tops = Window.EnumTopLevel();
        Console.WriteLine("count: " + Convert.ToString(tops.Count));
        int shown = 0;
        for (int i = 0; i < tops.Count && shown < 8; i = i + 1) {
            nint h = tops[i];
            string t = Window.GetText(h);
            if (t != "" || Window.IsVisible(h)) {
                Console.WriteLine("  " + Convert.ToString((long)h)
                    + " cls=" + Window.GetClassName(h)
                    + " title=" + t);
                shown = shown + 1;
            }
        }

        Console.WriteLine("== notepad automation ==");
        nint wnd = (nint)0;
        // Launch notepad through the shell (cmd start), then wait for its
        // main window by class + title.
        Process.RunDetached("start \"\" notepad.exe");
        wnd = Window.WaitForWindow("Notepad", "", 0, 0, 5000);
        if (wnd == 0) {
            Console.WriteLine("notepad unavailable; read-only demo only");
        }

        if (wnd != 0) {
            Console.WriteLine("found: " + Convert.ToString((long)wnd));
            Console.WriteLine("  class:    " + Window.GetClassName(wnd));
            Console.WriteLine("  title:    " + Window.GetText(wnd));
            WindowRect r = Window.GetRect(wnd);
            Console.WriteLine("  rect:     " + Convert.ToString(r.x) + ","
                + Convert.ToString(r.y) + " " + Convert.ToString(r.width) + "x"
                + Convert.ToString(r.height));
            WindowThreadInfo tp = Window.GetThreadProcess(wnd);
            Console.WriteLine("  tid/pid:  " + Convert.ToString(tp.tid) + "/"
                + Convert.ToString(tp.pid));
            Console.WriteLine("  visible/minimized/maximized: "
                + Convert.ToString(Window.IsVisible(wnd) ? 1 : 0) + "/"
                + Convert.ToString(Window.IsMinimized(wnd) ? 1 : 0) + "/"
                + Convert.ToString(Window.IsMaximized(wnd) ? 1 : 0));
            Console.WriteLine("  hung:     " + Convert.ToString(Window.IsHung(wnd, 300) ? 1 : 0));

            Console.WriteLine("set title...");
            Window.SetText(wnd, "zan automation demo");

            Console.WriteLine("children (first 6):");
            List<nint> kids = Window.EnumChildren(wnd, false);
            for (int j = 0; j < kids.Count && j < 6; j = j + 1) {
                Console.WriteLine("  child " + Convert.ToString((long)kids[j])
                    + " cls=" + Window.GetClassName(kids[j])
                    + " id=" + Convert.ToString(Window.GetId(kids[j])));
            }

            Console.WriteLine("accessible elements (first 8):");
            UiElement root = UiElement.FromWindow(wnd);
            if (root.IsValid()) {
                List<UiElement> elements = root.FindAll("", 0);
                int k = 0;
                for (; k < elements.Count && k < 8; k = k + 1) {
                    Console.WriteLine("  " + UiElement.RoleName(elements[k].Role())
                        + " name=" + elements[k].Name()
                        + " value=" + elements[k].Value());
                }
                k = 0;
                while (k < elements.Count) {
                    elements[k].Dispose();
                    k = k + 1;
                }
                root.Dispose();
            }

            Console.WriteLine("center + foreground...");
            Window.CenterOnScreen(wnd);
            Window.SetForeground(wnd);

            Console.WriteLine("menu walk (may be empty on newer notepad):");
            if (Window.ClickMenu(wnd, "文件/另存为")) {
                Console.WriteLine("  posted File/SaveAs");
                nint dlg = Window.WaitForWindow("#32770", "另存为", 0, 0, 3000);
                if (dlg != 0) {
                    Console.WriteLine("  SaveAs dialog: " + Window.GetText(dlg));
                    Window.Close(dlg);
                }
            } else {
                Console.WriteLine("  no classic menu (win11 notepad), skip");
            }

            Console.WriteLine("close...");
            Window.Close(wnd);
            bool gone = Window.WaitForClose(wnd, 3000);
            Console.WriteLine("closed: " + Convert.ToString(gone ? 1 : 0));
        }
        #else
        Console.WriteLine("System.Automation.Window is Windows-only");
        #endif
    }
}
