// System.Management demo: prints CPU, memory, system, storage, display and
// power information. Read-only, safe to run anywhere.
//
// Build & run:
//   build/zanc examples/input/sysinfo_demo.zan --auto-stdlib -o build/sysinfo_demo.exe
//   build/sysinfo_demo.exe
using System;
using System.Management;

namespace Demo;

class Prog {
    static void Main() {
        Console.WriteLine("== CPU ==");
        Console.WriteLine("brand:   " + Cpu.Brand());
        Console.WriteLine("vendor:  " + Cpu.Vendor());
        Console.WriteLine("cores:   " + Convert.ToString(Cpu.LogicalCores()));
        Console.WriteLine("usage:   " + Convert.ToString(Cpu.Usage()) + "%");

        Console.WriteLine("== Memory ==");
        MemoryStatus m = Memory.GetStatus();
        Console.WriteLine("total:   " + Convert.ToString(m.totalPhys / 1048576) + " MB");
        Console.WriteLine("avail:   " + Convert.ToString(m.availPhys / 1048576) + " MB");
        Console.WriteLine("usage:   " + Convert.ToString(m.usagePercent) + "%");

        Console.WriteLine("== System ==");
        Console.WriteLine("name:    " + SystemInfo.ComputerName());
        Console.WriteLine("user:    " + SystemInfo.UserName());
        Console.WriteLine("os:      " + SystemInfo.OsName());
        Console.WriteLine("kernel:  " + SystemInfo.KernelVersion());
        Console.WriteLine("uptime:  " + Convert.ToString(SystemInfo.UptimeSeconds() / 3600) + " h");

        Console.WriteLine("== Storage ==");
        List<DiskUsage> drives = Storage.Drives();
        int i = 0;
        while (i < drives.Count) {
            DiskUsage d = drives[i];
            Console.WriteLine(d.name + "  total=" + Convert.ToString(d.totalBytes / 1048576)
                + " MB  free=" + Convert.ToString(d.freeBytes / 1048576)
                + " MB  " + Convert.ToString(d.UsagePercent()) + "%");
            i = i + 1;
        }

        Console.WriteLine("== Display ==");
        Console.WriteLine("primary: " + Convert.ToString(Display.ScreenWidth()) + "x"
            + Convert.ToString(Display.ScreenHeight()) + " @ "
            + Convert.ToString(Display.RefreshRate()) + " Hz "
            + Convert.ToString(Display.ColorDepth()) + "bpp");
        List<DisplayInfo> monitors = Display.Monitors();
        int j = 0;
        while (j < monitors.Count) {
            DisplayInfo d = monitors[j];
            Console.WriteLine("  #" + Convert.ToString(d.index) + " " + d.name + " "
                + Convert.ToString(d.width) + "x" + Convert.ToString(d.height)
                + " @" + Convert.ToString(d.refreshHz) + "Hz");
            j = j + 1;
        }

        Console.WriteLine("== Power ==");
        PowerStatus p = Power.GetStatus();
        Console.WriteLine("battery: " + Convert.ToString(p.onBattery ? 1 : 0)
            + "  pct=" + Convert.ToString(p.batteryPercent)
            + "  life=" + Convert.ToString(p.batteryLifeSeconds) + "s");
    }
}
