// System.ServiceProcess + System.Management demo: enumerate Windows
// services and scheduled tasks, and show the details of a few of them.
// Read-only: nothing is started, stopped, created or deleted.
//
// Build & run:
//   build/zanc examples/input/service_task_demo.zan --auto-stdlib -o build/service_task_demo.exe
//   build/service_task_demo.exe
using System;
using System.Management;
using System.ServiceProcess;

namespace Demo;

class Prog {
    static void Main() {
        Console.WriteLine("== Services ==");
        List<ServiceInfo> services = ServiceProcess.List();
        Console.WriteLine("total:    " + Convert.ToString(services.Count));
        int running = 0;
        int i = 0;
        while (i < services.Count) {
            if (services[i].state == 4) { running = running + 1; }
            i = i + 1;
        }
        Console.WriteLine("running:  " + Convert.ToString(running));
        // Show the first few running services.
        int shown = 0;
        i = 0;
        while (i < services.Count && shown < 5) {
            ServiceInfo s = services[i];
            if (s.state == 4) {
                Console.WriteLine("  - " + s.name + " [" + s.displayName + "]");
                shown = shown + 1;
            }
            i = i + 1;
        }

        Console.WriteLine("== Scheduled tasks ==");
        List<TaskInfo> tasks = TaskScheduler.List();
        Console.WriteLine("total:    " + Convert.ToString(tasks.Count));
        int ready = 0;
        i = 0;
        while (i < tasks.Count) {
            if (tasks[i].status == "就绪" || tasks[i].status == "Ready") {
                ready = ready + 1;
            }
            i = i + 1;
        }
        Console.WriteLine("ready:    " + Convert.ToString(ready));
        i = 0;
        while (i < tasks.Count && i < 5) {
            TaskInfo t = tasks[i];
            Console.WriteLine("  - " + t.name + "  next=" + t.nextRun
                + "  status=" + t.status);
            i = i + 1;
        }

        // A single-task query carries the full command line.
        if (tasks.Count > 0) {
            TaskInfo detail = TaskScheduler.Get(tasks[0].name);
            if (detail != null) {
                Console.WriteLine("detail[" + detail.name + "]");
                Console.WriteLine("  command: " + detail.command);
            }
        }
    }
}
