// Keyboard input demo -- INTERACTIVE: running this types into whatever has
// focus. Point your editor at a scratch file first.
//
// Build & run:
//   build/zanc examples/input/keyboard_demo.zan --auto-stdlib -o build/keyboard_demo.exe
//   build/keyboard_demo.exe
using System;
using System.Input;
using System.Threading;

namespace Demo;

class Prog {
    static void Main() {
        // Macro: modifiers are held down until the end, then released in
        // reverse order. "{Ctrl}{A}" selects all, then we type.
        Keyboard.Send("{Ctrl}{A}");       // select all
        Thread.Sleep(100);

        // Literal Unicode text -- layout-independent, CJK-safe.
        Keyboard.SendText("Hello from Zan input!\r\n");
        Keyboard.SendText("你好, 键盘宏\r\n");
        Thread.Sleep(100);

        // Key names: press Enter, type a line, press Up/Down/Home/End.
        Keyboard.Press(Keyboard.VK("Enter"));
        Keyboard.SendText("line one");
        Keyboard.Press(Keyboard.VK("Enter"));
        Keyboard.SendText("line two");
        Thread.Sleep(100);
        Keyboard.Press(Keyboard.VK("Home"));
        Keyboard.SendText(">> ");
        Thread.Sleep(100);

        // Repeat: backspace 3 times.
        Keyboard.Repeat(Keyboard.VK("Backspace"), 3);
        Thread.Sleep(100);

        // Lock-key state.
        Console.WriteLine("capslock: " + Convert.ToString(Keyboard.CapsLock() ? 1 : 0));

        // Hold Shift and type: press/release order matters.
        Keyboard.Down(Keyboard.Shift());
        Keyboard.SendText("SHIFTED");
        Keyboard.Up(Keyboard.Shift());
        Thread.Sleep(100);

        Console.WriteLine("done.");
    }
}
