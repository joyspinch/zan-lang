// 接口数据协议与执行契约。
// 核心契约与执行状态转移规范。
// 接口数据协议与执行契约。
// color.
// Build & run:
// 接口数据协议与执行契约。
// 核心契约与语义定义。
using System;
using System.Windows;

namespace Demo;

class Prog {
    static bool muted = false;
    static bool quit = false;

    static void OnTray(int action) {
        Console.WriteLine("tray action: " + Convert.ToString(action)
            + "  (1=left 2=double 3=right 4=middle)");
    }

    // 接口数据协议与执行契约。
    static void OnMenu(int id) {
        if (id == 1) {
            if (!Prog.muted) {
                TrayIcon.ShowBalloon("Zan", "Hello from the tray menu", 1, 3000);
            }
        } else if (id == 2) {
            Prog.muted = !Prog.muted;
            Prog.Menu();  // 接口数据协议与执行契约。
        } else if (id == 3) {
            Prog.quit = true;
        }
    }

    // 接口数据协议与执行契约。
    static void Menu() {
        List<TrayMenuItem> items = new List<TrayMenuItem>();
        items.Add(new TrayMenuItem(1, "Show balloon"));
        items.Add(new TrayMenuItem(2, "Mute").Check(Prog.muted));
        items.Add(TrayMenuItem.Separator());
        items.Add(new TrayMenuItem(3, "Exit"));
        TrayIcon.SetMenu(items, Prog.OnMenu);
    }

    static void Main() {
        Console.WriteLine("== Screen ==");
        Console.WriteLine("size:    " + Convert.ToString(Screen.ScreenWidth()) + "x"
            + Convert.ToString(Screen.ScreenHeight()) + " @ "
            + Convert.ToString(Screen.Dpi()) + " dpi");
        byte[] px = Screen.CapturePixels(0, 0, 16, 16);
        Console.WriteLine("16x16 capture: "
            + Convert.ToString(px == null ? 0 : px.Length) + " bytes");
        int c = Screen.GetPixel(0, 0);
        int r = (c >> 16) & 255;
        int g = (c >> 8) & 255;
        int b = c & 255;
        Console.WriteLine("pixel(0,0):  #" + Prog.Hex2(r) + Prog.Hex2(g) + Prog.Hex2(b));
        string path = Path.GetTempPath() + "zan_fullscreen.bmp";
        if (Screen.CaptureAllToBmp(path)) {
            Console.WriteLine("saved:   " + path + " ("
                + Convert.ToString(File.GetSize(path)) + " bytes)");
            File.Delete(path);
        }

        Console.WriteLine("== Tray ==");
        if (TrayIcon.Add("", "Zan demo", Prog.OnTray)) {
            Prog.Menu();
            Console.WriteLine("icon added; balloon showing for 4s...");
            TrayIcon.ShowBalloon("Zan", "Tray icon demo running", 1, 4000);
            Console.WriteLine("right-click the icon for the menu, or wait...");
            int waited = 0;
            while (waited < 30000 && !Prog.quit) {
                Thread.Sleep(100);
                waited = waited + 100;
            }
            TrayIcon.Remove();
            Console.WriteLine("done");
        } else {
            Console.WriteLine("tray add failed");
        }
    }

    static string Hex2(int v) {
        string h = "0123456789abcdef";
        return h.Substring((v >> 4) & 15, 1) + h.Substring(v & 15, 1);
    }
}
