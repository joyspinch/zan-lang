// Build & run:
using System;
using System.Input;
using System.Threading;

namespace Demo;

public class KeyboardDemoProgram {
    static void Main() {
        Keyboard.Send("{Ctrl}{A}");  // select all
        Thread.Sleep(100);

        Keyboard.SendText("Hello from Zan input!\r\n");
        Keyboard.SendText("你好, 键盘宏\r\n");
        Thread.Sleep(100);

        Keyboard.Press(Keyboard.VK("Enter"));
        Keyboard.SendText("line one");
        Keyboard.Press(Keyboard.VK("Enter"));
        Keyboard.SendText("line two");
        Thread.Sleep(100);
        Keyboard.Press(Keyboard.VK("Home"));
        Keyboard.SendText(">> ");
        Thread.Sleep(100);

        // Repeat: backspace 3 times.
        Keyboard.Repeat(Keyboard.VK("Backspace"), 3);
        Thread.Sleep(100);

        Console.WriteLine("capslock: " + Convert.ToString(Keyboard.CapsLock() ? 1 : 0));

        Keyboard.Down(Keyboard.Shift());
        Keyboard.SendText("SHIFTED");
        Keyboard.Up(Keyboard.Shift());
        Thread.Sleep(100);

        Console.WriteLine("done.");
    }
}
