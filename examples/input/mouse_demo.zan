// Mouse input demo -- INTERACTIVE: running this moves the real cursor,
// clicks and scrolls. Do not run it while you need the mouse elsewhere.
//
// Build & run:
//   build/zanc examples/input/mouse_demo.zan --auto-stdlib -o build/mouse_demo.exe
//   build/mouse_demo.exe
using System;
using System.Input;
using System.Drawing;
using System.Threading;

namespace Demo;

class Prog {
    static void Main() {
        Point p = Mouse.GetPos();
        Console.WriteLine("cursor at: " + Convert.ToString(p.x) + ","
            + Convert.ToString(p.y));

        // Glide across the screen in 24 eased hops (teleports are ignored by
        // some remote-desktop / game sessions, a trajectory is not).
        Mouse.MoveTo(100, 100, 24);
        Thread.Sleep(200);

        // Click the left button twice at the current position.
        Mouse.Click(Mouse.Left());
        Mouse.DoubleClick(Mouse.Left());
        Thread.Sleep(200);

        // Drag: press, glide, release.
        Mouse.Drag(200, 200, 300, 260);
        Thread.Sleep(200);

        // Wheel up one notch.
        Mouse.Wheel(120);

        Console.WriteLine("done. right-click to exit when satisfied.");
        Mouse.Click(Mouse.Right());
    }
}
