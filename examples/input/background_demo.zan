using System;
using System.Input;

/// 后台输入模拟示例 —— 不影响鼠标键盘操作。
///
/// 与 mouse_demo/keyboard_demo 的前台注入(SendInput)不同,这里的一切都
/// 通过 PostMessage 把 WM_ 消息投递给"指定窗口",事件不进系统输入队列:
/// 真实鼠标不动、真实键盘不占,你可以一边运行本程序一边正常使用电脑。
///
/// 用法:
///   1. 打开记事本(新建空白文档);
///   2. 运行本程序(无需把焦点给记事本);
///   3. 观察记事本里自动出现的文本、按键和点击效果。
///
/// 说明:消息级注入对普通 Win32/UI 框架程序有效;DirectInput 类游戏通常
/// 不读窗口消息,后台模拟对它们无效。
class Prog {
    static void Main() {
        // 1) 定位目标窗口:记事本标题(中文系统 "无标题 - 记事本",
        //    英文系统 "Untitled - Notepad",新版记事本可能带文件路径)。
        nint hwnd = Background.FindWindowByTitle("无标题 - 记事本");
        if (hwnd == 0) {
            hwnd = Background.FindWindowByTitle("Untitled - Notepad");
        }
        if (hwnd == 0) {
            Console.WriteLine("未找到记事本窗口,请先打开一个空白记事本再运行。");
            return;
        }
        Console.WriteLine("已定位记事本窗口,开始后台输入(你的鼠标键盘不受影响)...");

        // 2) 后台输入整段文本(中文/英文混排,逐字 WM_CHAR)。
        Background.SendText(hwnd, "这是后台模拟输入的第一行。\n");
        Background.SendText(hwnd, "Background input, mouse and keyboard stay yours.\n");

        // 3) 后台按键宏:与 Keyboard.Send 相同语法,但只发给目标窗口。
        //    回车换行、Ctrl+I 切换斜体、Ctrl+Shift+A 取消(旧版)/全选(新版)。
        Background.SendMacro(hwnd, "{Enter}");
        Background.SendMacro(hwnd, "宏按键:{Ctrl}{B}加粗{Ctrl}{B}结束。");

        // 4) 后台鼠标:客户区坐标点击 —— 模拟在文档中间点一下(光标定位),
        //    再滚轮往下翻两格。坐标是记事本客户区像素。
        Background.MouseClick(hwnd, Mouse.Left(), 120, 80);
        Background.MouseWheel(hwnd, -240, 120, 80);

        // 5) 同步变体:SyncKeyPress 用 SendMessage,等目标处理完再返回,
        //    适合"保存后立即做下一步"这类需要顺序保证的场景。这里用
        //    宏做 Ctrl+S 保存(注意宏是异步投递,记事本会依次处理)。
        Background.SendMacro(hwnd, "{Ctrl}{S}");
        Console.WriteLine("完成:文本、按键、点击、滚轮均已投递到记事本。");
    }
}
