// ZanWeb (Zan.Mvc) 生产级通用管理中台演示入口程序
using System;
using System.IO;
using System.Data;
using System.Data.Sqlite;
using System.Data.Orm;
using System.Web;
using ZanWeb.Core;
using ZanWeb.Web;
using ZanWeb.Admin;
using ZanWeb.Model;
using ZanWeb.Dao;
using ZanWeb.Security;
using ZanWeb.Services;
using Demo.Model;
using Demo.Controller;

public class Program {
    static async void IndexRedirect(HttpContext ctx) {
        ctx.Redirect("/admin");
    }

    static async bool SeedProducts(IZanSql zsql) {
        int count = await zsql.Select<Product>().CountAsync();
        if (count > 0) { return true; }
        long now = DateTime.UtcNow().ToUnixSeconds();
        await zsql.Insert<Product>(new Product { id = 1, name = "ThinkPad X1 Carbon 商务本", category = "数码3C", price = 9999.0, stock = 42, status = 1, createdAt = now }).ExecuteAffrowsAsync();
        await zsql.Insert<Product>(new Product { id = 2, name = "4K 极清电竞显示器 27寸", category = "数码3C", price = 1899.0, stock = 120, status = 1, createdAt = now }).ExecuteAffrowsAsync();
        await zsql.Insert<Product>(new Product { id = 3, name = "人体工学办公转椅", category = "家居日用", price = 899.0, stock = 65, status = 1, createdAt = now }).ExecuteAffrowsAsync();
        await zsql.Insert<Product>(new Product { id = 4, name = "云南精品高山咖啡豆 500g", category = "生鲜食品", price = 88.0, stock = 300, status = 1, createdAt = now }).ExecuteAffrowsAsync();
        Console.WriteLine("[Init] 演示商品种子数据注入完成！");
        return true;
    }

    static async int Main() {
        ProductController _prod = null;
        Console.WriteLine("=========================================================");
        Console.WriteLine("  正在启动 ZanWeb (Zan.Mvc) 生产级管理中台演示系统...");
        Console.WriteLine("=========================================================");

        string dbDir = "_scratch/admin_demo_data";
        Directory.CreateDirectoryRecursive(dbDir);
        string dbPath = dbDir + "/demo.db";

        // 1. 初始化配置与数据库
        Cfg.Db.driver = "sqlite";
        Cfg.Db.sqlitePath = dbPath;
        Cfg.Auth.bootstrapPassword = "admin123456";

        // 2. 构造连接池与 DbContext
        DbPool pool = SqliteConnector.Pool(dbPath, 4);
        DbContext dbCtx = DbContext.Of(pool);
        CacheContext cacheCtx = CacheContext.Of(null); // 单进程本地内存缓存
        AppServices services = new AppServices(dbCtx, cacheCtx);
        AppServices.Use(services);

        // 3. 注册业务种子并执行 Schema 自动迁移与超级管理员引导
        Schema.OnSeed(SeedProducts);
        bool ready = await Schema.Ensure(dbCtx);
        if (!ready) {
            Console.WriteLine("[Error] 数据库 Schema 初始化或迁移失败！");
            return 1;
        }

        // 4. 构建 WebApp 并配置鉴权
        int port = 8888;
        WebApp app = new WebApp("0.0.0.0", port);
        WebHost.Use(app);
        app.AuthResolver(AuthToken.Resolve);
        app.PermissionResolver(AuthUser.Allow);
        app.LoginPath(Routes.Login);

        // 注册所有属性控制器路由、权限位索引与管理区安全守门
        __AttrRoutes.Register(app);
        Perm.Index(app);
        Boot.AdminGate(app);

        // 根路径跳转至管理后台
        app.Get("/", IndexRedirect);

        Console.WriteLine("");
        Console.WriteLine("---------------------------------------------------------");
        Console.WriteLine("  ZanWeb 企业级管理后台服务已启动！");
        Console.WriteLine("  访问地址: http://127.0.0.1:" + Convert.ToString(port) + "/admin");
        Console.WriteLine("  超级管理员: admin / admin123456");
        Console.WriteLine("  业务演示: 电商商城 -> 商品管理 (/admin/shop/product)");
        Console.WriteLine("---------------------------------------------------------");
        Console.WriteLine("");

        return await WebServer.Run(app, 1, false);
    }
}
