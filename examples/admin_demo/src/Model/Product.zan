using System;
using System.Collections.Generic;
using System.Data.Orm;

namespace Demo.Model;

/// <summary>
/// 业务示例实体：电商商品
/// 纯 CodeFirst [Table] 标注驱动，自动建表与自动字段映射
/// </summary>
[Table("products")]
public class Product {
    [Column("id", IsPrimaryKey = true, IsIdentity = true)]
    public int id;

    [Column("name")]
    public string name;

    [Column("category")]
    public string category;

    [Column("price")]
    public double price;

    [Column("stock")]
    public int stock;

    [Column("status")]
    public int status;

    [Column("created_at")]
    public long created_at;

    public Product() {
        this.id = 0;
        this.name = "";
        this.category = "";
        this.price = 0.0;
        this.stock = 0;
        this.status = 1;
        this.created_at = 0;
    }
}

/// <summary>
/// 商品分页数据传输 DTO
/// </summary>
public class ProductPagedResult {
    public int total;
    public List<Product> items;

    public ProductPagedResult() {
        this.total = 0;
        this.items = new List<Product>();
    }

    public ProductPagedResult(int total, List<Product> items) {
        this.total = total;
        this.items = items;
    }
}
