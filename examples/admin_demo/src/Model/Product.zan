using System;
using System.Data.Orm;

namespace Demo.Model;

// 业务示例实体：电商商品
// 纯 CodeFirst [Table] 标注驱动，自动建表与自动字段映射
[Table(Name = "products")]
public class Product {
    [Column(IsIdentity = true)]
    public int id;

    [Column(StringLength = 128, IsNullable = false)]
    public string name;

    [Column(StringLength = 64, IsNullable = false)]
    public string category;

    public double price;

    public int stock;

    /* 所属店铺：数据域 "shop" 的行归属列（ProductController.Scope）。 */
    public int shopId;

    public int status;

    public long createdAt;

    public Product() {
        this.id = 0;
        this.name = "";
        this.category = "";
        this.price = 0.0;
        this.stock = 0;
        this.shopId = 0;
        this.status = 1;
        this.createdAt = 0;
    }
}
