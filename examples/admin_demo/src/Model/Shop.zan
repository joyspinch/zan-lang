using System;
using System.Data;
using System.Data.Orm;

namespace Demo.Model;

/* 演示用业务资源：店铺。数据域 "shop" 的资源表——运营账号被授予其中
   一个或多个 id，商品管理屏据此过滤（见 ProductController.Conf）。 */
[Table(Name = "shop")]
public class Shop {
    [Column(IsIdentity = true)]
    public int id;

    public string name;
    public string region;
    public int status;
    public long createdAt;
}
