using System;
using System.Collections.Generic;
using System.Web;
using Zan.Web.Admin;
using Zan.Web.Model;
using Zan.Web.Security;

namespace Demo.Controller;

/* 业务资源屏：店铺管理。
 *
 * 这一屏演示数据域的两个用法：
 *   1. Scope("shop", "id") —— 店铺本身就是域内资源，运营只能看到自己
 *      被授予的那几家（超管看全部）；
 *   2. 它的 /options 端点同样按域过滤——商品表单里的"所属店铺"下拉
 *      因此只会列出可见店铺，用户没有机会点到一个越权选项。 */
[Description("店铺管理")]
[Route("/admin/shop/shops")]
[Custom(Authorization = CustomAuthorization.Grant)]
public class ShopController : CrudScreenController {

    protected override CrudConf Def() {
        return CrudConf.Of("shop", "店铺管理", "admin/shop/shops")
            .Order("id", true)
            .Label("name")
            .Scope("shop", "id")

            .Col("id", "ID").Int().W("64px").Ro()
            .Col("name", "店铺名称").W("180px").Req().Max(64).Search("搜索店铺")
            .Col("region", "区域").W("110px").Req().Max(32)
                .Opts("华北=华北,华东=华东,华南=华南,西南=西南")
                .Inline()
            .Col("status", "状态").Opts("1=营业|ok,0=停业|off").W("88px").Def("1").Inline()
            .Col("createdAt", "创建时间").Time().W("150px").Ro()

            .TbarAdd("添加店铺")
            .TbarReload()
            .OpsEdit()
            .OpsDel("删除后不可恢复，确认删除该店铺吗？")
            .Created("createdAt");
    }

    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:store", Perm = PermBit.View)]
    [Description("店铺管理")]
    async void Index() { await this.DoList(); }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("店铺表格配置")]
    void Conf() { this.DoConf(); }

    [HttpPost]
    [Route("/admin/shop/shops/list")]
    [Custom(Perm = PermBit.View)]
    [Description("店铺数据")]
    async void ListData() { await this.DoListData(); }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("店铺行数据")]
    async void Edit() { await this.DoEdit(); }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("店铺表单配置")]
    void FormConf() { this.DoFormConf(); }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("店铺表单")]
    async void Form() { await this.DoForm(); }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存店铺")]
    async void Save() { await this.DoSave(); }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除店铺")]
    async void Delete() { await this.DoDelete(); }

    [HttpPost]
    [Custom(Perm = PermBit.Update | PermBit.Delete)]
    [Description("店铺批量启停或删除")]
    async void Batch() { await this.DoBatch(); }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("店铺行内修改")]
    async void Field() { await this.DoField(); }

    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("店铺选项")]
    async void Options() { await this.DoOptions(); }
}
