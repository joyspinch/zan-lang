// 核心契约与语义定义。
using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Web;
using System.Json;
using Zan.Mvc.Admin;
using Zan.Mvc.Admin.Web;
using Zan.Mvc.Admin.UI;
using Demo.Model;

namespace Demo.Controller;

/// <summary>
/// 业务控制器：电商商城 -> 商品管理。
/// 严格遵循 System.Web 标准注解：[Route], [Custom], [Description]。
/// 继承自通用 CrudController<Product>，开箱即用支持表格配置、分页、删除、导出与行内即时编辑。
/// </summary>
[Route("/admin/shop/product")]
[Custom(Authorization = CustomAuthorization.Grant, IsMenu = true, Icon = "box", Perm = PermBit.View)]
[Description("商品管理")]
public class ProductController : CrudController<Product> {

    public ProductController() : base() {
    }

    protected override TableConfig BuildTableConfig() {
        TableConfig cfg = new TableConfig();
        cfg.Conf.SetKey("id", "商品管理");
        cfg.AddColumn("id", "ID", "number", 60, true, false)
           .AddColumn("name", "商品名称", "input", 180, true, true)
           .AddColumn("category", "品类", "select", 100, true, true)
           .AddColumn("price", "售价(元)", "number", 90, true, true)
           .AddColumn("stock", "库存", "number", 80, true, true)
           .AddColumn("status", "状态", "dict", 80, true, true)
           .AddFilter("name", "商品名称", "Input", "输入商品名搜索")
           .AddTool("添加商品", "Add", "商品", "Primary", false, "600px", "420px")
           .AddTool("批量删除", "Delete", "商品", "Error", true, "400px", "260px")
           .AddTool("导出数据", "Export", "商品", "Default", false, "", "");
        return cfg;
    }

    protected override FormView BuildFormView() {
        FormView form = new FormView("商品信息");
        form.AddField("name", "商品名称", "input", true, "请输入商品全称", 12)
            .AddField("category", "商品品类", "select", true, "数码3C,生鲜食品,家居日用", 12)
            .AddField("price", "销售单价", "number", true, "0.00", 6)
            .AddField("stock", "当前库存", "number", true, "100", 6)
            .AddField("status", "上架状态", "radio", true, "1:上架,0:下架", 12);
        return form;
    }

    protected override string OnPage(int page, int pageSize) {
        List<Product> list = this.Product.OrderBy("id DESC")
                                         .Page(page, pageSize)
                                         .ToList();
        int total = this.Product.Count();
        ProductPagedResult res = new ProductPagedResult(total, list);
        return Json.Serialize<ProductPagedResult>(res);
    }

    protected override bool OnDelete(int id) {
        return this.Product.Delete().W("id = ?").Pi(id).ExecuteAffrows() > 0;
    }

    protected override bool OnBatchDelete(List<int> ids) {
        bool ok = true;
        for (int i = 0; i < ids.Count; i = i + 1) {
            if (this.Product.Delete().W("id = ?").Pi(ids[i]).ExecuteAffrows() <= 0) {
                ok = false;
            }
        }
        return ok;
    }

    protected override bool OnField(int id, string field, string value) {
        List<Product> list = this.Product.W("id = ?").Pi(id).ToList();
        if (list.Count == 0) { return false; }
        Product p = list[0];
        if (field == "name") { p.name = value; }
        else if (field == "category") { p.category = value; }
        else if (field == "price") { p.price = Convert.ToDouble(value); }
        else if (field == "stock") { p.stock = Convert.ToInt32(value); }
        else if (field == "status") { p.status = Convert.ToInt32(value); }
        return this.Product.Update(p).ExecuteAffrows() > 0;
    }

    protected override List<Dict<string, string>> OnExportRows() {
        List<Product> list = this.Product.OrderBy("id DESC").Limit(1000).ToList();
        List<Dict<string, string>> rows = new List<Dict<string, string>>();
        for (int i = 0; i < list.Count; i = i + 1) {
            Product p = list[i];
            Dict<string, string> r = new Dict<string, string>();
            r["id"] = Convert.ToString(p.id);
            r["name"] = p.name;
            r["category"] = p.category;
            r["price"] = Convert.ToString(p.price);
            r["stock"] = Convert.ToString(p.stock);
            r["status"] = p.status == 1 ? "上架" : "下架";
            rows.Add(r);
        }
        return rows;
    }
}
