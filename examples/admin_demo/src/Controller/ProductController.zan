using System;
using System.Collections.Generic;
using System.Web;
using Zan.Web.Admin;
using Zan.Web.Model;
using Zan.Web.Security;

namespace Demo.Controller;

// 业务控制器：电商商城 -> 商品管理。
// 严格遵循 System.Web 标准注解：[Route], [Custom], [Description]。
// 继承自现代通用 CrudScreenController，声明式 CrudConf 驱动，零样板代码。
[Description("商品管理")]
[Route("/admin/shop/product")]
/* Grant = 本屏受 RBAC 管：路由进权限索引（可按屏授权），未授权者调度器
   直接 403。没有这一行，路由不进权限表，任何登录账号都能打开——演示
   工程早期就是漏了它，按钮全 403、角色也授不了权。 */
[Custom(Authorization = CustomAuthorization.Grant)]
public class ProductController : CrudScreenController {

    protected override CrudConf Def() {
        return CrudConf.Of("products", "商品管理", "admin/shop/product")
            .Order("id", true)
            .Label("name")
            /* 数据域：本屏的行按 shopId 归属店铺。声明这一行后，列表、
               计数、详情、保存、批量、选项六处自动按账号可见的店铺过滤，
               屏体逻辑零改动。 */
            .Scope("shop", "shopId")

            .Col("id", "ID").Int().W("70px").Ro()
            .Col("name", "商品名称").W("180px").Req().Max(64)
                .Search("搜索商品名称").Inline()
            .Col("shopId", "所属店铺").Int().W("110px")
                .Search("店铺 ID")
            .Col("category", "商品品类").W("120px").Req().Max(32)
                .Opts("数码3C=数码3C,生鲜食品=生鲜食品,家居日用=家居日用")
                .Inline()
            .Col("price", "售价(元)").W("100px").Req().Def("0.00").Inline()
            .Col("stock", "库存").Int().W("80px").Def("100").Inline()
            .Col("status", "状态").Opts("1=上架|ok,0=下架|off").W("90px")
                .Def("1").Inline()
            .Col("createdAt", "创建时间").Time().W("150px").Ro()

            .TbarAdd("添加商品")
            .TbarReload()
            .OpsEdit()
            .OpsDel("删除后不可恢复，确认删除该商品吗？")
            .Created("createdAt");
    }

    [HttpGet]
    [Custom(IsMenu = true, Icon = "mdi:package-variant", Perm = PermBit.View)]
    [Description("商品管理")]
    async void Index() { await this.DoList(); }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("商品表格配置")]
    void Conf() { this.DoConf(); }

    [HttpPost]
    [Route("/admin/shop/product/list")]
    [Custom(Perm = PermBit.View)]
    [Description("商品数据")]
    async void ListData() { await this.DoListData(); }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("商品行数据")]
    async void Edit() { await this.DoEdit(); }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("商品表单配置")]
    void FormConf() { this.DoFormConf(); }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("商品表单")]
    async void Form() { await this.DoForm(); }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存商品")]
    async void Save() { await this.DoSave(); }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除商品")]
    async void Delete() { await this.DoDelete(); }

    [HttpPost]
    [Custom(Perm = PermBit.Update | PermBit.Delete)]
    [Description("商品批量启停或删除")]
    async void Batch() { await this.DoBatch(); }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("商品行内修改")]
    async void Field() { await this.DoField(); }

    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("商品选项")]
    async void Options() { await this.DoOptions(); }
}
