using System;
using System.Data;
using System.Collections.Generic;
using Zan.Mvc.Admin.Data;
using Demo.Model;

namespace Demo.Dao;

/// <summary>
/// 商品数据访问层 DAO
/// 继承自通用 BaseDao<Product>，开箱即用分页、插入、更新与统计
/// </summary>
public class ProductDao : BaseDao<Product> {
    public ProductDao(IDbConnection db) : base(db) {}

    public static ProductDao Of(IDbConnection db) {
        return new ProductDao(db);
    }
}
