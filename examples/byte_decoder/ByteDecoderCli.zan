using Ai.Tensor;
using System;

public class ByteDecoderCli {
    static int Main(string[] args) {
        if (args.Length != 3) {
            Console.ErrorWriteLine("usage: byte_decoder <checkpoint.safetensors> <prompt> <token-budget>");
            return 2;
        }

        if (!int.TryParse(args[2], out int budget) || budget < 0) {
            Console.ErrorWriteLine("byte_decoder: token budget must be a non-negative 32-bit integer");
            return 2;
        }

        try {
            ByteDecoder model = ByteDecoder.Open(args[0]);
            Console.WriteLine(model.Generate(args[1], budget));
            return 0;
        } catch (Exception e) {
            Console.ErrorWriteLine("byte_decoder: " + e.Message);
            return 1;
        }
    }
}
