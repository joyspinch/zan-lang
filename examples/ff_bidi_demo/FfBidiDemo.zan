using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Json;
using System.IO;
using Gui.Component.FirefoxBrowser;

// WebDriver BiDi 协议功能演示（控制台，无 GUI 依赖）。
// 流程：发现 Firefox → 专属 profile + 自动挑端口 → 以
// --remote-debugging-port 拉起（headless）→ WebSocket 连
// ws://127.0.0.1:<port>/session → 依次演示 BiDi 的核心能力：
//   session.new                     建 BiDi 会话
//   session.subscribe               订阅 domContentLoaded/load/log 事件
//   browsingContext.getTree         枚举浏览上下文
//   browsingContext.navigate        导航并等加载完成
//   script.evaluate                 页内求值（document.title）
//   browsingContext.captureScreenshot  抓帧落盘 PNG
//   browser.close                   协议级优雅关停
// 全部结果断言打分，结尾 PASS/FAIL。
// 跑起来（需本机有 Firefox，或 ZAN_FF_EXE 指定）：
//   ff_bidi_demo
public class FfBidiDemo {
    static int eventCount;
    static string lastEvent;
    // 请求台账："方法 URL" / "URL -> 状态码"（network 事件里记）。
    static List<string> requests;
    // 拦截到的待放行请求 id。
    static string pausedRequestId;
    // 对端是否真的发过 network 事件（能力探测的实据）。
    static bool sawNetworkEvent;

    static async int Main() {
        // 自举：发现 → 缓存 → （首次）官方源下载+静默安装，进度窗泵驱动。
        string exe = await FfBootstrap.EnsureAsync();
        Console.WriteLine("firefox: " + exe);
        if (exe == "") {
            Console.WriteLine(FfRuntime.lastError);
            return 1;
        }

        int port = FfHost.PickFreePort();
        // 每次运行独立 profile：上一轮的孤儿进程（若有的话）不会锁住
        // 下一轮——「already running」弹窗的根源就是复用 profile 目录。
        string profile = FfHost.CacheRoot() + "/bidi-" + port;
        FfHost.EnsureProfile(profile, port, true);
        Console.WriteLine("profile: " + profile);
        Console.WriteLine("bidi port: " + port);

        List<string> args = new List<string>();
        args.Add("-profile");
        args.Add(profile);
        args.Add("-no-remote");
        args.Add("--remote-debugging-port");
        args.Add(port + "");
        args.Add("-headless");
        // SpawnWithRetry：首装后安装器可能短暂持有 firefox.exe 句柄，
        // 第一次拉起会失败——15 秒窗口内重试，而不是直接报错退出。
        int launcherPid = FfHost.SpawnWithRetry(exe, args);
        if (launcherPid < 0) {
            Console.WriteLine("Firefox 启动失败：" + exe);
            return 2;
        }

        FfBidi bidi = FfBidi.Connect(port, 40000);
        if (bidi == null) {
            Console.WriteLine("连接失败：" + FfBidi.staticError);
            FfHost.TeardownFamily(launcherPid);
            return 3;
        }
        bidi.eventSink = FfBidiDemo.OnEvent;

        try {
            return FfBidiDemo.Run(bidi);
        } finally {
            // 优雅关停：browser.close 让 Firefox 正常退出（写 profile）。
            bidi.Shutdown();
            Thread.Sleep(2000);
            // 兜底：还没死透就家族级强杀（绝不波及用户自己的 Firefox）。
            if (FfHost.FamilyAlive(launcherPid)) {
                Console.WriteLine("优雅关停未生效，家族强杀");
                FfHost.TeardownFamily(launcherPid);
            }
            Console.WriteLine("Firefox 已退出");
        }
    }

    static int Run(FfBidi bidi) {
        // 1. 会话。
        if (!bidi.NewSession()) {
            Console.WriteLine("session.new 失败：" + bidi.lastError);
            return 4;
        }
        Console.WriteLine("sessionId: " + bidi.sessionId
            + "  Firefox 主版本: " + bidi.browserMajor);

        // 2. 订阅事件（含 network 模块：请求台账在 OnEvent 里记）。
        bidi.Subscribe("[\"browsingContext.domContentLoaded\","
            + "\"browsingContext.load\",\"log.entryAdded\","
            + "\"script.message\",\"network.beforeRequestSent\","
            + "\"network.responseStarted\",\"network.responseCompleted\"]");
        FfBidiDemo.requests = new List<string>();

        // 3. 枚举浏览上下文。
        string ctx = bidi.TopContext();
        Console.WriteLine("top context: " + ctx);
        if (ctx == "") {
            Console.WriteLine("getTree 失败：" + bidi.lastError);
            return 5;
        }

        // 4. 导航（wait: complete）。
        if (!bidi.Navigate(ctx, "https://example.com/")) {
            Console.WriteLine("navigate 失败：" + bidi.lastError);
            return 6;
        }
        Console.WriteLine("navigate 完成");

        // 5. 页内求值（BiDi 的 expression 是脚本语句，完成值即结果；
        //    不写 return；awaitPromise 由 FfBidi.Evaluate 补齐）。
        string title = bidi.Evaluate(ctx, "document.title");
        string url = bidi.Evaluate(ctx, "location.href");
        Console.WriteLine("document.title = " + title);
        Console.WriteLine("location.href  = " + url);

        // 6. 收 2 秒事件流。
        bidi.Drain(2000);
        Console.WriteLine("事件：收到 " + eventCount + " 条"
            + (lastEvent != "" ? "（最后一条 " + lastEvent + "）" : ""));

        // 7. Cookies：存 → 取 → 断言 → 删 → 断言消失。
        bool setOk = bidi.SetCookie("zan_demo", "hello_bidi",
            "example.com", "/", true, false, "lax", 0);
        string cookieVia = "storage";
        if (!setOk) {
            // 老版 Firefox 没有 storage 模块：走页面 JS 写 cookie。
            cookieVia = "js";
            setOk = bidi.Evaluate(ctx,
                "document.cookie='zan_demo=hello_bidi'") != "";
            if (!setOk) {
                Console.WriteLine("setCookie 失败：" + bidi.lastError);
            }
        }
        JsonValue cookies = cookieVia == "storage" ? bidi.GetCookies() : null;
        string cookieJson = cookies != null ? cookies.ToJson() : "";
        bool hasCookie;
        if (cookies != null) {
            hasCookie = cookieJson.IndexOf("zan_demo") >= 0
                && cookieJson.IndexOf("hello_bidi") >= 0;
        } else {
            string raw = bidi.Evaluate(ctx, "document.cookie");
            hasCookie = raw.IndexOf("zan_demo") >= 0
                && raw.IndexOf("hello_bidi") >= 0;
            cookieJson = raw;
        }
        Console.WriteLine("cookie（经 " + cookieVia + "）set=" + setOk
            + " 读取含 zan_demo=" + hasCookie);
        bool delOk = cookieVia == "storage"
            ? bidi.DeletePageCookie(ctx, "zan_demo", "/")
            : bidi.Evaluate(ctx,
                "document.cookie='zan_demo=; Max-Age=0'") != "";
        Console.WriteLine("cookie 删除调用=" + delOk);
        JsonValue cookies2 = bidi.GetCookies();
        bool cookieGone = cookies2 == null
            || cookies2.ToJson().IndexOf("zan_demo") < 0;
        Console.WriteLine("cookie 删除后已消失=" + cookieGone);

        // 8. 请求监听断言：前面 navigate 期间 network 事件已流进台账。
        int reqSeen = 0;
        int resp200 = 0;
        for (int i = 0; i < FfBidiDemo.requests.Count; i = i + 1) {
            string line = FfBidiDemo.requests[i];
            if (line.IndexOf("example.com") >= 0) {
                if (line.IndexOf("-> ") >= 0) {
                    if (line.IndexOf("-> 200") >= 0) { resp200 = resp200 + 1; }
                } else {
                    reqSeen = reqSeen + 1;
                }
            }
        }
        Console.WriteLine("请求监听：example.com 请求数=" + reqSeen
            + " 200 响应数=" + resp200
            + "（台账 " + FfBidiDemo.requests.Count + " 条）");

        // 9. 拦截 + 放行（不参与 PASS 判定——老版本 Firefox 可能不支持）。
        string intercept = bidi.AddIntercept("[\"beforeRequestSent\"]",
            "[{\"type\":\"pattern\",\"hostname\":\"example.com\","
            + "\"pathname\":\"/\"}]");
        if (intercept != "") {
            FfBidiDemo.requests.Clear();
            bidi.Navigate(ctx, "https://example.com/");
            bidi.Drain(500);
            bool resumed = false;
            if (FfBidiDemo.pausedRequestId != "") {
                resumed = bidi.ContinueRequest(FfBidiDemo.pausedRequestId);
            }
            bidi.Drain(1500);
            bidi.RemoveIntercept(intercept);
            Console.WriteLine("拦截演示：装拦截器=" + (intercept != "")
                + " 放行=" + resumed
                + " 期间请求=" + FfBidiDemo.requests.Count + " 条");
            FfBidiDemo.pausedRequestId = "";
        } else {
            Console.WriteLine("拦截演示：本版 Firefox 不支持（"
                + bidi.lastError + "），跳过");
        }

        // 10. 截图落盘。
        string shot = Path_Getwd() + "ff_bidi_shot.png";
        bool shotOk = bidi.CaptureScreenshot(ctx, shot);
        long shotBytes = shotOk ? File.ReadAllBytes(shot).Length : 0 - 1;
        Console.WriteLine("screenshot: " + shot + "（" + shotBytes + " 字节）");

        // 网络监听断言按能力门控：有 network 事件（新版本）才强校验；
        // 一条都没有（FF115 一代没实现 network 模块）记为信息性跳过，
        // 不让老平台背 FAIL。
        bool hasNetworkEvents = eventCount > 0
            && FfBidiDemo.sawNetworkEvent;
        bool networkAssert = !hasNetworkEvents
            || (reqSeen > 0 && resp200 > 0);
        if (!hasNetworkEvents) {
            Console.WriteLine("网络监听：本版 Firefox 无 network 事件，跳过断言");
        }
        bool pass = title.IndexOf("Example") >= 0
            && url.IndexOf("example.com") >= 0
            && shotOk && shotBytes > 1000
            && eventCount > 0
            && setOk && hasCookie && cookieGone
            && networkAssert;
        Console.WriteLine(pass ? "PASS" : "FAIL");
        return pass ? 0 : 7;
    }

    static void OnEvent(string method, string paramsJson) {
        eventCount = eventCount + 1;
        lastEvent = method;
        JsonValue v = JsonValue.ParseOrStr(paramsJson);
        JsonValue prms = v.Get("params");
        if (method == "network.beforeRequestSent" && prms != null) {
            JsonValue req = prms.Get("request");
            if (req != null) {
                JsonValue rid = req.Get("request");
                JsonValue u = req.Get("url");
                JsonValue m = req.Get("method");
                string url = u != null ? u.AsString("") : "";
                requests.Add((m != null ? m.AsString("") : "") + " " + url
                    + " [" + (rid != null ? rid.AsString("") : "") + "]");
                pausedRequestId = rid != null ? rid.AsString("") : "";
            }
        } else if (method == "network.responseCompleted" && prms != null) {
            JsonValue resp = prms.Get("response");
            if (resp != null) {
                JsonValue u = resp.Get("url");
                JsonValue st = resp.Get("status");
                string url = u != null ? u.AsString("") : "";
                long status = st != null ? st.AsInt(0) : 0;
                requests.Add(url + " -> " + status);
            }
        }
        if (method.IndexOf("network.") == 0) {
            sawNetworkEvent = true;
            return;
        }
        // 控制台只打一行摘要；network 事件不逐条刷屏。
        if (method.IndexOf("network.") != 0) {
            Console.WriteLine("  [event] " + method);
        }
    }

    // 当前工作目录（跨平台：Windows 用 \，其余用 /）。
    static string Path_Getwd() {
        #if WINDOWS
        return ".\\";
        #else
        return "./";
        #endif
    }
}
