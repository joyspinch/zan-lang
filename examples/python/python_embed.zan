using System;
using System.Scripting;

class Program {
    static void Main() {
        if (!Python.IsAvailable()) {
            Console.WriteLine("Python 驱动不可用，请在 ZanIDE 库商城安装 System.Scripting.Python");
            return;
        }

        Python.Initialize();

        PyObject pow = Python.Eval("pow");
        Console.WriteLine(pow(2.0, 10.0).ToDouble());

        PyObject math = Python.Import("math");
        Console.WriteLine(math.GetAttr("floor")(22.7).ToLong());

        PyObject values = Python.Eval("[10, 20, 30]");
        Console.WriteLine(values[1].ToLong());
        values[1] = Python.FromLong(99L);
        Console.WriteLine(values[1].ToLong());

        PyObject profile = Python.Eval("{'name': 'Zan'}");
        Console.WriteLine(profile["name"].ToStr());
        profile["language"] = "Zan";
        Console.WriteLine(profile["language"].ToStr());

        Python.Finalize();
    }
}
