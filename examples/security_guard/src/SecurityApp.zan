using System;
using Gui;

partial class SecurityApp : Form {
    // B-ID149 窗口即对象：类 ↔ 同目录同名 .html，事件按名自动接线；
    // 帧动画走 FrameHook/Every，复杂控件程序化初始化走 Get<T>(id)。
    int currentPageIndex = 0;
    int currentProtectSubIndex = 0;
    bool isMaximized = false;

    // 常用工具列表
    List<ToolEntry> toolsList = new List<ToolEntry>();
    List<ProtectItem> virusItems = new List<ProtectItem>();
    List<ProtectItem> systemItems = new List<ProtectItem>();
    List<ProtectItem> networkItems = new List<ProtectItem>();
    List<AccessItem> accessItems = new List<AccessItem>();
    bool isFavEditing = false;

    // 常用工具拖拽手势与悬浮图标状态机
    bool isDraggingTool = false;
    bool dragMouseDown = false;
    int dragStartX = 0;
    int dragStartY = 0;
    ToolEntry pendingDragTool = null;
    string dragToolId = "";
    string dragToolName = "";
    string dragToolIcon = "";
    long lastDragEndMs = 0;

    // 查杀扫描状态
    bool isScanning = false;
    bool isScanPaused = false;
    int scanPercent = 0;
    int scanCount = 0;
    int scanTick = 0;
    long scanStartMs = 0;
    string scanCurrentPath = "";
    bool isCustomScan = false;

    // 首页芯片与落区动态效果计时
    int animTick = 0;
