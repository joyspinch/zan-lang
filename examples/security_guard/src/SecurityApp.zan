    Switch swPwdProtect;
    Switch swGameMode;
    Control scanOverlay;
    Control dragAvatar;

    Control pageHome;
    Control pageProtect;
    Control pageAccess;
    Control pageTools;
    Control pageSettings;

    Button navBtnHome;
    Button navBtnProtect;
    Button navBtnAccess;
    Button navBtnTools;
    Button navBtnSettings;
    Button winBtnMax;

    Element protectNavVirus;
    Element protectNavSystem;
    Element protectNavNetwork;
    Element protectDetailTitle;
    Element protectDetailDesc;
    Element protectItemsList;
    Element accessGrid;
    Element sysToolsGrid;
    Element netToolsGrid;
    Element favToolsList;
    Element dropzoneBox;
    Button btnEditFavTools;
    Button btnDragAvatarIcon;
    Element txtDragAvatarName;
    Element scanModalTitle;
    Element scanHeadline;
    Element scanTargetFile;
    Button btnScanPause;
    Button btnScanStop;
    Element scanPercentText;
