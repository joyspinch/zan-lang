using System;
using Gui;

partial class SecurityApp {
    static int currentPageIndex = 0;

    static void OnLoad(Form form) {
        Console.WriteLine("[SecurityGuard] 火绒安全软件桌面端已就绪");

        // 注册事件处理器
        form.On("OnNavHome", OnNavHome);
        form.On("OnNavProtect", OnNavProtect);
        form.On("OnNavAccess", OnNavAccess);
        form.On("OnNavTools", OnNavTools);
        form.On("OnNavSettings", OnNavSettings);

        form.On("OnWinClose", OnWinClose);
        form.On("OnWinMin", OnWinMin);
        form.On("OnWinMax", OnWinMax);
        form.On("OnWinMenu", OnWinMenu);

        form.On("OnQuickScan", OnQuickScan);
        form.On("OnScanMenu", OnScanMenu);
        form.On("OnActionUpdate", OnActionUpdate);
        form.On("OnActionLog", OnActionLog);
        form.On("OnActionTrust", OnActionTrust);
        form.On("OnActionIso", OnActionIso);

        form.On("OnToggleSwitch", OnToggleSwitch);

        // 初始化全部防护开关为开启状态（使用品牌橙色）
        int orange = unchecked((int)0xFFF58220);
        if (swFile != null) { swFile.CheckedColor = orange; swFile.SetOn(true); }
        if (swMalware != null) { swMalware.CheckedColor = orange; swMalware.SetOn(true); }
        if (swMemory != null) { swMemory.CheckedColor = orange; swMemory.SetOn(true); }
        if (swUsb != null) { swUsb.CheckedColor = orange; swUsb.SetOn(true); }
        if (swDownload != null) { swDownload.CheckedColor = orange; swDownload.SetOn(true); }
        if (swMail != null) { swMail.CheckedColor = orange; swMail.SetOn(true); }
        if (swWeb != null) { swWeb.CheckedColor = orange; swWeb.SetOn(true); }
        if (swPwdProtect != null) { swPwdProtect.CheckedColor = orange; }
        if (swGameMode != null) { swGameMode.CheckedColor = orange; }

        // 初始展示首页，隐藏其余页面
        ShowPage(0);
    }

    static void ShowPage(int idx) {
        currentPageIndex = idx;
        if (pageHome != null) { pageHome.visible = (idx == 0); }
        if (pageProtect != null) { pageProtect.visible = (idx == 1); }
        if (pageAccess != null) { pageAccess.visible = (idx == 2); }
        if (pageTools != null) { pageTools.visible = (idx == 3); }
        if (pageSettings != null) { pageSettings.visible = (idx == 4); }

        // 更新侧栏按钮样式激活态
        UpdateNavBtn(navBtnHome, idx == 0);
        UpdateNavBtn(navBtnProtect, idx == 1);
        UpdateNavBtn(navBtnAccess, idx == 2);
        UpdateNavBtn(navBtnTools, idx == 3);
        UpdateNavBtn(navBtnSettings, idx == 4);

        if (__form != null) {
            __form.GetApp().RequestRedraw();
        }
    }

    static void UpdateNavBtn(Button btn, bool active) {
        if (btn == null) { return; }
        if (active) {
            btn.AddClass("active");
        } else {
            btn.SetClassIn("active", "");
        }
    }

    // 侧栏导航切换事件
    static void OnNavHome() {
        Console.WriteLine("[SecurityGuard] OnNavHome called");
        ShowPage(0);
    }
    static void OnNavProtect() {
        Console.WriteLine("[SecurityGuard] OnNavProtect called");
        ShowPage(1);
    }
    static void OnNavAccess() {
        Console.WriteLine("[SecurityGuard] OnNavAccess called");
        ShowPage(2);
    }
    static void OnNavTools() {
        Console.WriteLine("[SecurityGuard] OnNavTools called");
        ShowPage(3);
    }
    static void OnNavSettings() {
        Console.WriteLine("[SecurityGuard] OnNavSettings called");
        ShowPage(4);
    }

    // 窗口控制
    static void OnWinClose() {
        if (__form != null) { __form.Close(); }
    }

    static void OnWinMin() {
        if (__form != null) { __form.Minimize(); }
    }

    static void OnWinMax() {
        if (__form != null) { __form.ToggleMaximize(); }
    }

    static void OnWinMenu() {
        Console.WriteLine("[SecurityGuard] 打开主菜单");
    }

    // 首页操作
    static void OnQuickScan() {
        Console.WriteLine("[SecurityGuard] 触发快速查杀，正在扫描关键内存与系统文件...");
    }

    static void OnScanMenu() {
        Console.WriteLine("[SecurityGuard] 打开查杀选项（全盘查杀、自定义查杀）");
    }

    static void OnActionUpdate() {
        Console.WriteLine("[SecurityGuard] 检查更新：已是最新版本 (病毒库 2026-10-12 19:17)");
    }

    static void OnActionLog() {
        Console.WriteLine("[SecurityGuard] 打开安全日志");
    }

    static void OnActionTrust() {
        Console.WriteLine("[SecurityGuard] 打开信任区");
    }

    static void OnActionIso() {
        Console.WriteLine("[SecurityGuard] 打开隔离区");
    }

    // 防护开关切换
    static void OnToggleSwitch() {
        Console.WriteLine("[SecurityGuard] 防护中心防护项状态变更");
    }
}
