    // 拖拽工具跟随与置入常用工具
    static void StartDragTool(string name, string icon) {
        isDraggingTool = true;
        dragToolName = name;
        dragToolIcon = icon;
        if (dragAvatar != null) {
            dragAvatar.visible = true;
            dragAvatar.designFloat = true;
            dragAvatar.logPlaceSet = true;
            if (__form != null) {
                App app = __form.GetApp();
                int scale = app.dpiScale > 0 ? app.dpiScale : 100;
                dragAvatar.logX = app.mouseX * 100 / scale - 22;
                dragAvatar.logY = app.mouseY * 100 / scale - 22;
            }
        }
        if (btnDragAvatarIcon != null) {
            btnDragAvatarIcon.Icon = icon;
        }
        Console.WriteLine("[SecurityGuard] 拖拽开始: 拽出 [" + name + "] 图标跟随光标");
        if (__form != null) { __form.GetApp().RequestRedraw(); }
    }

    static void EndDragTool(bool dock) {
        if (!isDraggingTool) { return; }
        if (dock) {
            DockFavoriteTool(dragToolName);
        }
        isDraggingTool = false;
        dragToolName = "";
        dragToolIcon = "";
        if (dragAvatar != null) {
            dragAvatar.visible = false;
        }
        if (dropzoneBox != null) {
            dropzoneBox.SetProp("class", "dropzone-box");
        }
        if (__form != null) { __form.GetApp().RequestRedraw(); }
    }

    static void DockFavoriteTool(string toolName) {
        if (toolName == "漏洞修复") { isFavVuln = true; if (favCardVuln != null) { favCardVuln.visible = true; } }
        else if (toolName == "系统修复") { isFavSysFix = true; if (favCardSysFix != null) { favCardSysFix.visible = true; } }
        else if (toolName == "弹窗拦截") { isFavPopup = true; if (favCardPopup != null) { favCardPopup.visible = true; } }
        else if (toolName == "垃圾清理") { isFavTrash = true; if (favCardTrash != null) { favCardTrash.visible = true; } }
        else if (toolName == "启动项管理") { isFavStartup = true; if (favCardStartup != null) { favCardStartup.visible = true; } }
        else if (toolName == "流量监控") { isFavNetTraffic = true; if (favCardNetTraffic != null) { favCardNetTraffic.visible = true; } }
        else {
            Console.WriteLine("[SecurityGuard] 常用工具栏已达上限或未匹配: " + toolName);
            return;
        }
        Console.WriteLine("[SecurityGuard] 常用工具成功置顶置入: " + toolName);
        UpdateFavBadges(isFavEditing);
        if (__form != null) { __form.GetApp().RequestRedraw(); }
    }

    static void OnDropzoneClick() {
        if (isDraggingTool) {
            EndDragTool(true);
            return;
        }
        // 拖拽到此插槽：在编辑模式或普通模式下，置入下一个尚未收录的系统/网络工具
        if (!isFavVuln) {
            isFavVuln = true;
            if (favCardVuln != null) { favCardVuln.visible = true; }
            Console.WriteLine("[SecurityGuard] [拖拽到此] 插槽置入: 漏洞修复");
        } else if (!isFavPopup) {
            isFavPopup = true;
            if (favCardPopup != null) { favCardPopup.visible = true; }
            Console.WriteLine("[SecurityGuard] [拖拽到此] 插槽置入: 弹窗拦截");
        } else if (!isFavTrash) {
            isFavTrash = true;
            if (favCardTrash != null) { favCardTrash.visible = true; }
            Console.WriteLine("[SecurityGuard] [拖拽到此] 插槽置入: 垃圾清理");
        } else if (!isFavSysFix) {
            isFavSysFix = true;
            if (favCardSysFix != null) { favCardSysFix.visible = true; }
            Console.WriteLine("[SecurityGuard] [拖拽到此] 插槽置入: 系统修复");
        } else if (!isFavStartup) {
            isFavStartup = true;
            if (favCardStartup != null) { favCardStartup.visible = true; }
            Console.WriteLine("[SecurityGuard] [拖拽到此] 插槽置入: 启动项管理");
        } else if (!isFavNetTraffic) {
            isFavNetTraffic = true;
            if (favCardNetTraffic != null) { favCardNetTraffic.visible = true; }
            Console.WriteLine("[SecurityGuard] [拖拽到此] 插槽置入: 流量监控");
        } else {
            Console.WriteLine("[SecurityGuard] 常用工具栏已达上限 (6/6)，点击右上角'编辑'可管理或替换工具");
        }
        UpdateFavBadges(isFavEditing);
        if (__form != null) {
            __form.GetApp().RequestRedraw();
        }
    }

    static void OnToolCardVuln() {
        if (isFavEditing) {
            if (!isFavVuln) { StartDragTool("漏洞修复", "shield-check"); }
            else { Console.WriteLine("[SecurityGuard] 该工具已在常用工具中: 漏洞修复"); }
        } else {
            Console.WriteLine("[SecurityGuard] 打开工具: 漏洞修复");
        }
    }

