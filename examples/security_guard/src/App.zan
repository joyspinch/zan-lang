    static void OnToolCardShred() { Console.WriteLine("[SecurityGuard] 打开工具: 文件粉碎"); }
    static void OnToolCardContextMenu() { Console.WriteLine("[SecurityGuard] 打开工具: 右键管理"); }
    static void OnToolCardNetRescue() { Console.WriteLine("[SecurityGuard] 打开工具: 断网急救箱"); }

