    static void OnToolCardNetSpeed() { Console.WriteLine("[SecurityGuard] 打开工具: 网络测速"); }
    static void OnToolCardDnsOpt() { Console.WriteLine("[SecurityGuard] 打开工具: DNS优选"); }

    // ================= 5. 首页高保真科技感安全芯片矢量渲染与动态帧生成 =================
    static string BuildChipSvg(int tick) {
        int[] radarDx = new int[] { 80, 77, 69, 57, 40, 21, 0, -21, -40, -57, -69, -77, -80, -77, -69, -57, -40, -21, 0, 21, 40, 57, 69, 77 };
        int[] radarDy = new int[] { 0, 21, 40, 57, 69, 77, 80, 77, 69, 57, 40, 21, 0, -21, -40, -57, -69, -77, -80, -77, -69, -57, -40, -21 };
        int step = tick % 24;
        int rx = 160 + radarDx[step];
        int ry = 90 + radarDy[step];
        int prevStep = (step - 1 + 24) % 24;
        int rxPrev = 160 + radarDx[prevStep];
        int ryPrev = 90 + radarDy[prevStep];

        int pulse = 22 + (tick % 8);
        string pulseOpacity = (tick % 2 == 0) ? "0.6" : "0.35";

        StringBuilder sb = new StringBuilder();
        sb.Append("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 180' width='320' height='180'>");

        // 1. 底层全向雷达旋转扫描光束与渐变扇形
        sb.Append("<circle cx='160' cy='90' r='76' fill='none' stroke='#F58220' stroke-width='1' stroke-opacity='0.18'/>");
        sb.Append("<circle cx='160' cy='90' r='56' fill='none' stroke='#F58220' stroke-width='1' stroke-dasharray='3,3' stroke-opacity='0.25'/>");
        sb.Append("<polygon points='160,90 ");
        sb.Append(Convert.ToString(rx));
        sb.Append(",");
        sb.Append(Convert.ToString(ry));
        sb.Append(" ");
        sb.Append(Convert.ToString(rxPrev));
        sb.Append(",");
        sb.Append(Convert.ToString(ryPrev));
        sb.Append("' fill='#F58220' fill-opacity='0.22'/>");
        sb.Append("<line x1='160' y1='90' x2='");
        sb.Append(Convert.ToString(rx));
        sb.Append("' y2='");
        sb.Append(Convert.ToString(ry));
        sb.Append("' stroke='#F58220' stroke-width='2' stroke-opacity='0.85'/>");

        // 2. 外部高保真镀金引脚矩阵 (上下左右全环绕真实芯片封装引脚)
        for (int i = 0; i < 12; i = i + 1) {
            int px = 74 + i * 15;
            sb.Append("<rect x='");
            sb.Append(Convert.ToString(px));
            sb.Append("' y='14' width='6' height='10' rx='1' fill='#E0A438'/>");
            sb.Append("<rect x='");
            sb.Append(Convert.ToString(px + 1));
            sb.Append("' y='14' width='4' height='3' rx='1' fill='#FFF0C2'/>");
        }
        for (int i = 0; i < 12; i = i + 1) {
            int px = 74 + i * 15;
            sb.Append("<rect x='");
            sb.Append(Convert.ToString(px));
            sb.Append("' y='156' width='6' height='10' rx='1' fill='#E0A438'/>");
            sb.Append("<rect x='");
            sb.Append(Convert.ToString(px + 1));
            sb.Append("' y='163' width='4' height='3' rx='1' fill='#FFF0C2'/>");
        }
        for (int i = 0; i < 7; i = i + 1) {
            int py = 42 + i * 14;
            sb.Append("<rect x='40' y='");
            sb.Append(Convert.ToString(py));
            sb.Append("' width='10' height='6' rx='1' fill='#E0A438'/>");
            sb.Append("<rect x='40' y='");
            sb.Append(Convert.ToString(py + 1));
            sb.Append("' width='3' height='4' rx='1' fill='#FFF0C2'/>");
        }
        for (int i = 0; i < 7; i = i + 1) {
            int py = 42 + i * 14;
            sb.Append("<rect x='270' y='");
            sb.Append(Convert.ToString(py));
            sb.Append("' width='10' height='6' rx='1' fill='#E0A438'/>");
            sb.Append("<rect x='277' y='");
            sb.Append(Convert.ToString(py + 1));
            sb.Append("' width='3' height='4' rx='1' fill='#FFF0C2'/>");
        }

        // 3. 深灰哑光陶瓷封装基板与微倒角
        sb.Append("<rect x='48' y='22' width='224' height='136' rx='12' fill='#1A1D24' stroke='#2D3545' stroke-width='2'/>");
        sb.Append("<circle cx='62' cy='36' r='3.5' fill='#F58220'/>");
        sb.Append("<path d='M 56 28 L 64 28 M 56 28 L 56 36' stroke='#E0A438' stroke-width='1.5'/>");
        sb.Append("<path d='M 264 28 L 256 28 M 264 28 L 264 36' stroke='#E0A438' stroke-width='1.5'/>");
        sb.Append("<path d='M 56 152 L 64 152 M 56 152 L 56 144' stroke='#E0A438' stroke-width='1.5'/>");
        sb.Append("<path d='M 264 152 L 256 152 M 264 152 L 264 144' stroke='#E0A438' stroke-width='1.5'/>");

        // 4. PCB 纳米微电路总线走线与流光高亮点
        sb.Append("<polyline points='70,30 70,55 106,55' fill='none' stroke='#F58220' stroke-width='1.2' stroke-opacity='0.6'/>");
        sb.Append("<polyline points='110,24 110,40 126,46' fill='none' stroke='#E0A438' stroke-width='1.2' stroke-opacity='0.65'/>");
        sb.Append("<polyline points='210,24 210,40 194,46' fill='none' stroke='#E0A438' stroke-width='1.2' stroke-opacity='0.65'/>");
        sb.Append("<polyline points='250,30 250,55 214,55' fill='none' stroke='#F58220' stroke-width='1.2' stroke-opacity='0.6'/>");
        sb.Append("<polyline points='70,150 70,125 106,125' fill='none' stroke='#F58220' stroke-width='1.2' stroke-opacity='0.6'/>");
        sb.Append("<polyline points='250,150 250,125 214,125' fill='none' stroke='#F58220' stroke-width='1.2' stroke-opacity='0.6'/>");
        
        // 动态脉冲流动点
        int pulseOffset = (tick * 4) % 36;
        sb.Append("<circle cx='");
        sb.Append(Convert.ToString(70 + pulseOffset));
        sb.Append("' cy='55' r='2' fill='#FFE6A3'/>");
        sb.Append("<circle cx='");
        sb.Append(Convert.ToString(250 - pulseOffset));
        sb.Append("' cy='125' r='2' fill='#FFE6A3'/>");

        // 5. 表面贴装 SMD 芯片电容元件
        sb.Append("<rect x='80' y='68' width='8' height='4' rx='1' fill='#4C566A'/>");
        sb.Append("<rect x='80' y='68' width='2' height='4' fill='#8A95A8'/>");
        sb.Append("<rect x='86' y='68' width='2' height='4' fill='#8A95A8'/>");
        sb.Append("<rect x='80' y='76' width='8' height='4' rx='1' fill='#4C566A'/>");
        sb.Append("<rect x='80' y='76' width='2' height='4' fill='#8A95A8'/>");
        sb.Append("<rect x='86' y='76' width='2' height='4' fill='#8A95A8'/>");
        sb.Append("<rect x='232' y='68' width='8' height='4' rx='1' fill='#4C566A'/>");
        sb.Append("<rect x='232' y='68' width='2' height='4' fill='#8A95A8'/>");
        sb.Append("<rect x='238' y='68' width='2' height='4' fill='#8A95A8'/>");
        sb.Append("<rect x='232' y='76' width='8' height='4' rx='1' fill='#4C566A'/>");
        sb.Append("<rect x='232' y='76' width='2' height='4' fill='#8A95A8'/>");
        sb.Append("<rect x='238' y='76' width='2' height='4' fill='#8A95A8'/>");

        // 6. 中央抬升核心金属散热盖板 (Die Package)
        sb.Append("<rect x='106' y='46' width='108' height='88' rx='8' fill='#12141A' stroke='#F58220' stroke-width='1.5'/>");
        sb.Append("<rect x='110' y='50' width='100' height='80' rx='6' fill='none' stroke='#282E3A' stroke-width='1'/>");

        // 核心呼吸光圈
        sb.Append("<circle cx='160' cy='88' r='30' fill='none' stroke='#F58220' stroke-width='1.5' stroke-opacity='0.4'/>");
        sb.Append("<circle cx='160' cy='88' r='");
        sb.Append(Convert.ToString(pulse));
        sb.Append("' fill='none' stroke='#FFB066' stroke-width='2' stroke-opacity='");
        sb.Append(pulseOpacity);
        sb.Append("'/>");
        
        // 核心发光火绒盾牌与火焰图腾
        sb.Append("<path d='M 160 70 L 176 76 C 176 96 160 108 160 108 C 160 108 144 96 144 76 Z' fill='#F58220' stroke='#FFE0B2' stroke-width='1.5'/>");
        sb.Append("<path d='M 160 74 L 172 79 C 172 93 160 103 160 103 C 160 103 148 93 148 79 Z' fill='#FF9F43'/>");
        sb.Append("<path d='M 160 78 C 164 83 168 87 166 93 C 164 98 158 100 160 95 C 160 91 156 88 160 78 Z' fill='#FFFFFF'/>");

        sb.Append("</svg>");
        return sb.ToString();
    }

    // ================= 6. 查杀扫描盾牌雷达与进度条矢量图生成 =================
    static string BuildScanShieldSvg(int tick, bool isCompleted) {
        StringBuilder sb = new StringBuilder();
        sb.Append("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 140 140' width='140' height='140'>");
        if (!isCompleted) {
            int[] scanDx = new int[] { 45, 43, 39, 32, 22, 12, 0, -12, -22, -32, -39, -43, -45, -43, -39, -32, -22, -12, 0, 12, 22, 32, 39, 43 };
            int[] scanDy = new int[] { 0, 12, 22, 32, 39, 43, 45, 43, 39, 32, 22, 12, 0, -12, -22, -32, -39, -43, -45, -43, -39, -32, -22, -12 };
            int step = tick % 24;
            int sx = 70 + scanDx[step];
            int sy = 70 + scanDy[step];
            int pulse = 32 + (tick % 6);
            string pulseOpacity = (tick % 2 == 0) ? "0.5" : "0.25";

            // 外围雷达光环
            sb.Append("<circle cx='70' cy='70' r='58' fill='none' stroke='#F58220' stroke-width='1.5' stroke-dasharray='4,3' stroke-opacity='0.4'/>");
            sb.Append("<circle cx='70' cy='70' r='"); sb.Append(Convert.ToString(pulse)); sb.Append("' fill='none' stroke='#FFB066' stroke-width='2' stroke-opacity='"); sb.Append(pulseOpacity); sb.Append("'/>");
            sb.Append("<line x1='70' y1='70' x2='"); sb.Append(Convert.ToString(sx)); sb.Append("' y2='"); sb.Append(Convert.ToString(sy)); sb.Append("' stroke='#F58220' stroke-width='2.5' stroke-opacity='0.85'/>");

            // 中心金橙色火绒安全盾牌
            sb.Append("<path d='M 70 34 L 102 48 C 102 88 70 106 70 106 C 70 106 38 88 38 48 Z' fill='#F58220' stroke='#FFE0B2' stroke-width='2'/>");
            sb.Append("<path d='M 70 42 L 94 53 C 94 82 70 98 70 98 C 70 98 46 82 46 53 Z' fill='#FF9F43'/>");
            sb.Append("<path d='M 70 50 C 76 58 82 64 78 74 C 75 82 66 84 70 78 C 70 72 64 68 70 50 Z' fill='#FFFFFF'/>");
        } else {
            // 完成状态：安全绿光圈 + 绿盾牌 + 醒目白色对勾
            sb.Append("<circle cx='70' cy='70' r='60' fill='none' stroke='#00B578' stroke-width='2' stroke-opacity='0.3'/>");
            sb.Append("<circle cx='70' cy='70' r='52' fill='#E6F9F2' stroke='#00B578' stroke-width='2'/>");
            sb.Append("<path d='M 70 34 L 102 48 C 102 88 70 106 70 106 C 70 106 38 88 38 48 Z' fill='#00B578' stroke='#B7EB8F' stroke-width='2'/>");
            sb.Append("<polyline points='55,70 66,81 87,58' fill='none' stroke='#FFFFFF' stroke-width='4' stroke-linecap='round' stroke-linejoin='round'/>");
        }
        sb.Append("</svg>");
        return sb.ToString();
    }

    static string BuildScanProgressSvg(int percent) {
        if (percent < 0) { percent = 0; }
        if (percent > 100) { percent = 100; }
        int w = 400 * percent / 100;
        StringBuilder sb = new StringBuilder();
        sb.Append("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 8' width='400' height='8'>");
        sb.Append("<rect x='0' y='0' width='400' height='8' rx='4' fill='#EEF1F5'/>");
        if (w > 0) {
            sb.Append("<rect x='0' y='0' width='");
            sb.Append(Convert.ToString(w));
            sb.Append("' height='8' rx='4' fill='#F58220'/>");
        }
        sb.Append("</svg>");
        return sb.ToString();
    }

    // ================= 7. 查杀扫描启动与交互链路 =================
    static void StartScan(string targetPath, bool isDrop) {
        isScanning = true;
        isScanPaused = false;
        scanPercent = 0;
        scanCount = 18;
        scanTick = 0;
        scanStartMs = Stopwatch.GetMicroseconds() / 1000;
        scanCurrentPath = targetPath;
        isCustomScan = isDrop;

        if (scanOverlay != null) { scanOverlay.visible = true; }
        if (scanModalTitle != null) {
            scanModalTitle.Text = (isDrop ? "火绒安全 · 自定义文件查杀" : "火绒安全 · 快速查杀");
        }
        if (scanHeadline != null) {
            scanHeadline.SetText("正在进行病毒与恶意威胁查杀...");
        }
        if (scanTargetFile != null) {
            scanTargetFile.SetText("正在检测: " + targetPath);
        }
        if (btnScanPause != null) {
            btnScanPause.visible = true;
            btnScanPause.Text = "暂停查杀";
        }
        if (btnScanStop != null) {
            btnScanStop.Text = "停止查杀";
        }
        if (scanPercentText != null) { scanPercentText.Text = "0%"; }
        if (scanMetricCount != null) { scanMetricCount.Text = "18"; }
        if (scanMetricTime != null) { scanMetricTime.Text = "00:00"; }
        if (scanMetricThreats != null) { scanMetricThreats.Text = "0"; }
        if (imgScanProgress != null) {
            imgScanProgress.Src.Set("data:image/svg+xml;utf8," + BuildScanProgressSvg(0));
        }
        if (imgScanShield != null) {
            imgScanShield.Src.Set("data:image/svg+xml;utf8," + BuildScanShieldSvg(0, false));
        }
        if (__form != null) {
            __form.GetApp().RequestRedraw();
        }
    }

    static void OnScanModalClose() {
        isScanning = false;
        if (scanOverlay != null) { scanOverlay.visible = false; }
        if (__form != null) { __form.GetApp().RequestRedraw(); }
    }

    static void OnScanStop() {
        isScanning = false;
        if (scanOverlay != null) { scanOverlay.visible = false; }
        if (__form != null) { __form.GetApp().RequestRedraw(); }
    }

    static void OnScanPause() {
        if (!isScanning) { return; }
        isScanPaused = !isScanPaused;
        if (btnScanPause != null) {
            btnScanPause.Text = isScanPaused ? "继续查杀" : "暂停查杀";
        }
        if (scanHeadline != null) {
            scanHeadline.SetText(isScanPaused ? "查杀已暂停" : "正在进行病毒与恶意威胁查杀...");
        }
        if (__form != null) { __form.GetApp().RequestRedraw(); }
    }

    // ================= 8. 动画节律与每帧驱动 (支持全局文件拖拽与动态查杀推进) =================
    static void OnFrameAnimation() {
        if (__form == null) { return; }

        // 1. 全局监听外部拖入文件（支持任何页面将文件拖入火绒窗口触发查杀）
        if (__form.GetApp() != null && __form.GetApp().window != null) {
            List<string> drops = __form.GetApp().window.TakeDroppedFiles();
            if (drops != null && drops.Count > 0) {
                string droppedFile = drops[0];
                Console.WriteLine("[SecurityGuard] 捕获外部拖入文件/目录: " + droppedFile + "，正在启动专项查杀...");
                StartScan(droppedFile, true);
                return;
            }
        }

        long now = Stopwatch.GetMicroseconds() / 1000;
        if (now - lastAnimMs < 90) { return; } // ~11 FPS
        lastAnimMs = now;

        // 2. 查杀扫描动态推进逻辑
        if (isScanning) {
            scanTick = scanTick + 1;
            if (!isScanPaused && scanPercent < 100) {
                scanPercent = scanPercent + 5;
                if (scanPercent > 100) { scanPercent = 100; }
                scanCount = scanCount + 142;

                long elapsedSec = (now - scanStartMs) / 1000;
                long sec = elapsedSec % 60;
                long min = elapsedSec / 60;
                string timeStr = (min < 10 ? "0" : "") + Convert.ToString(min) + ":" + (sec < 10 ? "0" : "") + Convert.ToString(sec);

                if (imgScanProgress != null) {
                    imgScanProgress.Src.Set("data:image/svg+xml;utf8," + BuildScanProgressSvg(scanPercent));
                }
                if (scanPercentText != null) {
                    scanPercentText.Text = Convert.ToString(scanPercent) + "%";
                }
                if (scanMetricCount != null) {
                    scanMetricCount.Text = Convert.ToString(scanCount);
                }
                if (scanMetricTime != null) {
                    scanMetricTime.Text = timeStr;
                }

                if (scanPercent >= 100) {
                    if (scanHeadline != null) { scanHeadline.SetText("查杀完成，未发现安全威胁"); }
                    if (scanTargetFile != null) { scanTargetFile.SetText("已全面扫描完成 · 系统防护环境安全"); }
                    if (btnScanStop != null) { btnScanStop.Text = "完成"; }
                    if (btnScanPause != null) { btnScanPause.visible = false; }
                    if (imgScanShield != null) {
                        imgScanShield.Src.Set("data:image/svg+xml;utf8," + BuildScanShieldSvg(scanTick, true));
                    }
                } else {
                    if (imgScanShield != null) {
                        imgScanShield.Src.Set("data:image/svg+xml;utf8," + BuildScanShieldSvg(scanTick, false));
                    }
                }
            }
            __form.GetApp().RequestRedraw();
            return;
        }

        // 3. 常用工具拖拽图标光标跟随与落区高亮
        if (isDraggingTool && dragAvatar != null) {
            App app = __form.GetApp();
            int mx = app.mouseX;
            int my = app.mouseY;
            int scale = app.dpiScale > 0 ? app.dpiScale : 100;
            dragAvatar.logX = mx * 100 / scale - 22;
            dragAvatar.logY = my * 100 / scale - 22;
            dragAvatar.logPlaceSet = true;
            dragAvatar.designFloat = true;

            if (dropzoneBox != null) {
                if (mx >= dropzoneBox.bx && mx <= dropzoneBox.bx + dropzoneBox.bw &&
                    my >= dropzoneBox.by && my <= dropzoneBox.by + dropzoneBox.bh) {
                    dropzoneBox.SetProp("class", "dropzone-box drag-over");
                } else {
                    dropzoneBox.SetProp("class", "dropzone-box");
                }
            }
            app.RequestRedraw();
        }

        // 4. 首页芯片动画
        if (currentPageIndex != 0) { return; }

        animTick = (animTick + 1) % 24;

        if (imgChip != null) {
            imgChip.Src.Set("data:image/svg+xml;utf8," + BuildChipSvg(animTick));
        }

        if (chipBadgeText != null && animTick % 6 == 0) {
            int sub = animTick / 6;
            if (sub == 0) {
                chipBadgeText.SetText("● 威胁情报中心已连接 · 实时防护中");
            } else if (sub == 1) {
                chipBadgeText.SetText("● 启发式内存扫描引擎正在待命");
            } else if (sub == 2) {
                chipBadgeText.SetText("● 系统核心完整性与行为监控已激活");
            } else {
                chipBadgeText.SetText("● 恶意网址拦截与网络防火墙在线");
            }
        }

        __form.GetApp().RequestRedraw();
    }

    // ================= 9. 首页快速查杀与安全操作 =================
    static void OnQuickScan() {
        Console.WriteLine("[SecurityGuard] 触发快速查杀，正在扫描关键内存与系统文件...");
        StartScan("系统核心内存区与开机启动项", false);
    }

    static void OnScanMenu() {
        Console.WriteLine("[SecurityGuard] 打开查杀选项（全盘查杀、自定义查杀）");
    }

    static void OnActionUpdate() {
        Console.WriteLine("[SecurityGuard] 检查更新：已是最新版本 (病毒库 2026-10-12 19:17)");
    }

    static void OnActionLog() {
        Console.WriteLine("[SecurityGuard] 打开安全日志");
    }

    static void OnActionTrust() {
        Console.WriteLine("[SecurityGuard] 打开信任区");
    }

    static void OnActionIso() {
        Console.WriteLine("[SecurityGuard] 打开隔离区");
    }
}
