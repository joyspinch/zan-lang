using System;
using Gui;

partial class SecurityApp {
    static int currentPageIndex = 0;
    static int currentProtectSubIndex = 0;
    static bool isMaximized = false;

    // 常用工具收藏状态
    static bool isFavEditing = false;
    static bool isFavVuln = true;
    static bool isFavPopup = true;
    static bool isFavTrash = true;

    // 首页芯片动态效果计时
    static int animTick = 0;
    static long lastAnimMs = 0;

    static void OnLoad(Form form) {
        Console.WriteLine("[SecurityGuard] 火绒安全软件桌面端已就绪");

        // 设置无边框自绘标题栏拖动保护高度与右上角按钮区防拖拽保护带
        form.GetApp().SetTitlebarHeight(38);
        form.GetApp().SetCaptionZone(form.GetApp().Scale(160));

        // 安装每帧动态刷新钩子（用于首页科技感芯片呼吸发光与雷达扫描）
        form.FrameHook(OnFrameAnimation);

        // 一级导航事件绑定
        form.On("OnNavHome", OnNavHome);
        form.On("OnNavProtect", OnNavProtect);
        form.On("OnNavAccess", OnNavAccess);
        form.On("OnNavTools", OnNavTools);
        form.On("OnNavSettings", OnNavSettings);

        // 窗口系统控制按钮事件绑定
        form.On("OnWinClose", OnWinClose);
        form.On("OnWinMin", OnWinMin);
        form.On("OnWinMax", OnWinMax);
        form.On("OnWinMenu", OnWinMenu);

        // 首页查杀与底部操作事件绑定
        form.On("OnQuickScan", OnQuickScan);
        form.On("OnScanMenu", OnScanMenu);
        form.On("OnActionUpdate", OnActionUpdate);
        form.On("OnActionLog", OnActionLog);
        form.On("OnActionTrust", OnActionTrust);
        form.On("OnActionIso", OnActionIso);

        // 防护中心二级分类导航与开关
        form.On("OnProtectSubVirus", OnProtectSubVirus);
        form.On("OnProtectSubSystem", OnProtectSubSystem);
        form.On("OnProtectSubNetwork", OnProtectSubNetwork);
        form.On("OnToggleSwitch", OnToggleSwitch);

        // 安全工具常用工具编辑与收藏交互
        form.On("OnToggleEditFavTools", OnToggleEditFavTools);
        form.On("OnFavCardVuln", OnFavCardVuln);
        form.On("OnFavCardPopup", OnFavCardPopup);
        form.On("OnFavCardTrash", OnFavCardTrash);
        form.On("OnDropzoneClick", OnDropzoneClick);

        form.On("OnToolCardVuln", OnToolCardVuln);
        form.On("OnToolCardSysFix", OnToolCardSysFix);
        form.On("OnToolCardPopup", OnToolCardPopup);
        form.On("OnToolCardTrash", OnToolCardTrash);
        form.On("OnToolCardStartup", OnToolCardStartup);
        form.On("OnToolCardShred", OnToolCardShred);
        form.On("OnToolCardContextMenu", OnToolCardContextMenu);
        form.On("OnToolCardNetRescue", OnToolCardNetRescue);
        form.On("OnToolCardNetTraffic", OnToolCardNetTraffic);
        form.On("OnToolCardNetSpeed", OnToolCardNetSpeed);
        form.On("OnToolCardDnsOpt", OnToolCardDnsOpt);

        // 初始化品牌色高亮开关 (0xFFF58220)
        int orange = unchecked((int)0xFFF58220);

        // 病毒防护 (7项)
        InitSwitch(swFile, orange, true);
        InitSwitch(swMalware, orange, true);
        InitSwitch(swMemory, orange, true);
        InitSwitch(swUsb, orange, true);
        InitSwitch(swDownload, orange, true);
        InitSwitch(swMail, orange, true);
        InitSwitch(swWeb, orange, true);

        // 系统防护 (8项)
        InitSwitch(swSysIntegrity, orange, true);
        InitSwitch(swSysFileShred, orange, true);
        InitSwitch(swSysProcess, orange, true);
        InitSwitch(swSysRegistry, orange, true);
        InitSwitch(swSysBoot, orange, true);
        InitSwitch(swSysDriver, orange, true);
        InitSwitch(swSysExploit, orange, true);
        InitSwitch(swSysInstall, orange, true);

        // 网络防护 (7项)
        InitSwitch(swNetFirewall, orange, true);
        InitSwitch(swNetLan, orange, true);
        InitSwitch(swNetPortScan, orange, true);
        InitSwitch(swNetRdp, orange, true);
        InitSwitch(swNetUrlFilter, orange, true);
        InitSwitch(swNetBotnet, orange, true);
        InitSwitch(swNetBrowserHome, orange, true);

        // 访问控制与设置项开关
        InitSwitch(swPwdProtect, orange, false);
        InitSwitch(swGameMode, orange, false);

        // 初始化收藏工具删除标记默认隐藏
        UpdateFavBadges(false);

        // 默认显示首页，防护中心默认显示病毒防护子页
        ShowPage(0);
        ShowProtectSub(0);
    }

    static void InitSwitch(Switch sw, int color, bool on) {
        if (sw != null) {
            sw.CheckedColor = color;
            sw.SetOn(on);
        }
    }

    // ================= 1. 一级主页面路由 =================
    static void ShowPage(int idx) {
        currentPageIndex = idx;
        if (pageHome != null) { pageHome.visible = (idx == 0); }
        if (pageProtect != null) { pageProtect.visible = (idx == 1); }
        if (pageAccess != null) { pageAccess.visible = (idx == 2); }
        if (pageTools != null) { pageTools.visible = (idx == 3); }
        if (pageSettings != null) { pageSettings.visible = (idx == 4); }

        UpdateNavBtn(navBtnHome, idx == 0);
        UpdateNavBtn(navBtnProtect, idx == 1);
        UpdateNavBtn(navBtnAccess, idx == 2);
        UpdateNavBtn(navBtnTools, idx == 3);
        UpdateNavBtn(navBtnSettings, idx == 4);

        if (__form != null) {
            __form.GetApp().RequestRedraw();
        }
    }

    static void UpdateNavBtn(Button btn, bool active) {
        if (btn == null) { return; }
        if (active) {
            btn.AddClass("active");
        } else {
            btn.SetClassIn("active", "");
        }
    }

    static void OnNavHome() { ShowPage(0); }
    static void OnNavProtect() { ShowPage(1); }
    static void OnNavAccess() { ShowPage(2); }
    static void OnNavTools() { ShowPage(3); }
    static void OnNavSettings() { ShowPage(4); }

    // ================= 2. 窗口控制按钮 =================
    static void OnWinClose() {
        Console.WriteLine("[SecurityGuard] 触发窗口控制：关闭窗口");
        if (__form != null) { __form.Close(); }
    }

    static void OnWinMin() {
        Console.WriteLine("[SecurityGuard] 触发窗口控制：最小化窗口");
        if (__form != null) { __form.Minimize(); }
    }

    static void OnWinMax() {
        Console.WriteLine("[SecurityGuard] 触发窗口控制：最大化/还原切换");
        if (__form != null) {
            __form.ToggleMaximize();
            isMaximized = !isMaximized;
            if (winBtnMax != null) {
                winBtnMax.Icon = isMaximized ? "restore" : "maximize";
            }
        }
    }

    static void OnWinMenu() {
        Console.WriteLine("[SecurityGuard] 弹出火绒主功能菜单：关于、检查更新、设置、帮助");
    }

    // ================= 3. 防护中心二级分类子页切换 =================
    static void ShowProtectSub(int subIdx) {
        currentProtectSubIndex = subIdx;

        if (protectDetailVirus != null) { protectDetailVirus.visible = (subIdx == 0); }
        if (protectDetailSystem != null) { protectDetailSystem.visible = (subIdx == 1); }
        if (protectDetailNetwork != null) { protectDetailNetwork.visible = (subIdx == 2); }

        UpdateProtectNavCard(protectNavVirus, subIdx == 0);
        UpdateProtectNavCard(protectNavSystem, subIdx == 1);
        UpdateProtectNavCard(protectNavNetwork, subIdx == 2);

        if (__form != null) {
            __form.GetApp().RequestRedraw();
        }
    }

    static void UpdateProtectNavCard(Element card, bool active) {
        if (card == null) { return; }
        if (active) {
            card.AddClass("active");
        } else {
            card.SetClassIn("active", "");
        }
    }

    static void OnProtectSubVirus() { ShowProtectSub(0); }
    static void OnProtectSubSystem() { ShowProtectSub(1); }
    static void OnProtectSubNetwork() { ShowProtectSub(2); }

    static void OnToggleSwitch() {
        Console.WriteLine("[SecurityGuard] 防护中心开关状态变更，防护规则已热更新");
    }

    // ================= 4. 安全工具'常用工具'收藏与编辑交互 =================
    static void OnToggleEditFavTools() {
        isFavEditing = !isFavEditing;
        if (btnEditFavTools != null) {
            if (isFavEditing) {
                btnEditFavTools.AddClass("active");
                btnEditFavTools.Text = "完成";
            } else {
                btnEditFavTools.SetClassIn("active", "");
                btnEditFavTools.Text = "编辑";
            }
        }
        UpdateFavBadges(isFavEditing);
        if (__form != null) {
            __form.GetApp().RequestRedraw();
        }
    }

    static void UpdateFavBadges(bool show) {
        if (favBadgeVuln != null) { favBadgeVuln.visible = show; }
        if (favBadgePopup != null) { favBadgePopup.visible = show; }
        if (favBadgeTrash != null) { favBadgeTrash.visible = show; }
    }

    static void OnFavCardVuln() {
        if (isFavEditing) {
            isFavVuln = false;
            if (favCardVuln != null) { favCardVuln.visible = false; }
            Console.WriteLine("[SecurityGuard] 已将 [漏洞修复] 从常用工具中移除");
        } else {
            Console.WriteLine("[SecurityGuard] 启动 [漏洞修复] 模块");
        }
    }

    static void OnFavCardPopup() {
        if (isFavEditing) {
            isFavPopup = false;
            if (favCardPopup != null) { favCardPopup.visible = false; }
            Console.WriteLine("[SecurityGuard] 已将 [弹窗拦截] 从常用工具中移除");
        } else {
            Console.WriteLine("[SecurityGuard] 启动 [弹窗拦截] 模块");
        }
    }

    static void OnFavCardTrash() {
        if (isFavEditing) {
            isFavTrash = false;
            if (favCardTrash != null) { favCardTrash.visible = false; }
            Console.WriteLine("[SecurityGuard] 已将 [垃圾清理] 从常用工具中移除");
        } else {
            Console.WriteLine("[SecurityGuard] 启动 [垃圾清理] 模块");
        }
    }

    static void OnDropzoneClick() {
        // 拖拽到此插槽：恢复/新增被移除的工具，或提示添加
        if (!isFavVuln) {
            isFavVuln = true;
            if (favCardVuln != null) { favCardVuln.visible = true; }
            Console.WriteLine("[SecurityGuard] 已将 [漏洞修复] 置入常用工具栏");
        } else if (!isFavPopup) {
            isFavPopup = true;
            if (favCardPopup != null) { favCardPopup.visible = true; }
            Console.WriteLine("[SecurityGuard] 已将 [弹窗拦截] 置入常用工具栏");
        } else if (!isFavTrash) {
            isFavTrash = true;
            if (favCardTrash != null) { favCardTrash.visible = true; }
            Console.WriteLine("[SecurityGuard] 已将 [垃圾清理] 置入常用工具栏");
        } else {
            Console.WriteLine("[SecurityGuard] 常用工具栏槽位已就绪，可从下方点击任意系统工具快速收藏置顶");
        }
        if (__form != null) {
            __form.GetApp().RequestRedraw();
        }
    }

    static void OnToolCardVuln() {
        if (isFavEditing && !isFavVuln) {
            isFavVuln = true;
            if (favCardVuln != null) { favCardVuln.visible = true; }
            Console.WriteLine("[SecurityGuard] 常用工具置顶: 漏洞修复");
        } else {
            Console.WriteLine("[SecurityGuard] 打开工具: 漏洞修复");
        }
    }

    static void OnToolCardSysFix() { Console.WriteLine("[SecurityGuard] 打开工具: 系统修复"); }
    static void OnToolCardPopup() {
        if (isFavEditing && !isFavPopup) {
            isFavPopup = true;
            if (favCardPopup != null) { favCardPopup.visible = true; }
            Console.WriteLine("[SecurityGuard] 常用工具置顶: 弹窗拦截");
        } else {
            Console.WriteLine("[SecurityGuard] 打开工具: 弹窗拦截");
        }
    }
    static void OnToolCardTrash() {
        if (isFavEditing && !isFavTrash) {
            isFavTrash = true;
            if (favCardTrash != null) { favCardTrash.visible = true; }
            Console.WriteLine("[SecurityGuard] 常用工具置顶: 垃圾清理");
        } else {
            Console.WriteLine("[SecurityGuard] 打开工具: 垃圾清理");
        }
    }
    static void OnToolCardStartup() { Console.WriteLine("[SecurityGuard] 打开工具: 启动项管理"); }
    static void OnToolCardShred() { Console.WriteLine("[SecurityGuard] 打开工具: 文件粉碎"); }
    static void OnToolCardContextMenu() { Console.WriteLine("[SecurityGuard] 打开工具: 右键管理"); }
    static void OnToolCardNetRescue() { Console.WriteLine("[SecurityGuard] 打开工具: 断网急救箱"); }
    static void OnToolCardNetTraffic() { Console.WriteLine("[SecurityGuard] 打开工具: 流量监控"); }
    static void OnToolCardNetSpeed() { Console.WriteLine("[SecurityGuard] 打开工具: 网络测速"); }
    static void OnToolCardDnsOpt() { Console.WriteLine("[SecurityGuard] 打开工具: DNS优选"); }

    // ================= 5. 首页科技感芯片卡片呼吸发光与雷达扫描动画 =================
    static void OnFrameAnimation() {
        if (currentPageIndex != 0 || __form == null) { return; }

        long now = Stopwatch.GetMicroseconds() / 1000;
        if (now - lastAnimMs < 450) { return; } // 450ms 优雅节律
        lastAnimMs = now;
        animTick = (animTick + 1) % 4;

        if (chipAuraOuter != null) {
            if (animTick % 2 == 1) {
                chipAuraOuter.AddClass("pulse-expand");
            } else {
                chipAuraOuter.SetClassIn("pulse-expand", "");
            }
        }

        if (chipBadgeText != null) {
            if (animTick == 0) {
                chipBadgeText.SetText("● 威胁情报中心已连接 · 实时防护中");
            } else if (animTick == 1) {
                chipBadgeText.SetText("● 启发式内存扫描引擎正在待命");
            } else if (animTick == 2) {
                chipBadgeText.SetText("● 系统核心完整性与行为监控已激活");
            } else {
                chipBadgeText.SetText("● 恶意网址拦截与网络防火墙在线");
            }
        }

        __form.GetApp().RequestRedraw();
    }

    // ================= 6. 首页快速查杀与安全操作 =================
    static void OnQuickScan() {
        Console.WriteLine("[SecurityGuard] 触发快速查杀，正在扫描关键内存与系统文件...");
    }

    static void OnScanMenu() {
        Console.WriteLine("[SecurityGuard] 打开查杀选项（全盘查杀、自定义查杀）");
    }

    static void OnActionUpdate() {
        Console.WriteLine("[SecurityGuard] 检查更新：已是最新版本 (病毒库 2026-10-12 19:17)");
    }

    static void OnActionLog() {
        Console.WriteLine("[SecurityGuard] 打开安全日志");
    }

    static void OnActionTrust() {
        Console.WriteLine("[SecurityGuard] 打开信任区");
    }

    static void OnActionIso() {
        Console.WriteLine("[SecurityGuard] 打开隔离区");
    }
}
