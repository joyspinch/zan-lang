using System;
using Gui;

public class ToolEntry {
    string id;
    string name;
    string icon;
    string desc;
    bool isFav;

    ToolEntry(string id, string name, string icon, string desc, bool isFav) {
        this.id = id;
        this.name = name;
        this.icon = icon;
        this.desc = desc;
        this.isFav = isFav;
    }
}

