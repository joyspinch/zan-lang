using System;
using Gui;

public class ProtectItem {
    string id;
    string name;
    string icon;
    bool enabled;

    ProtectItem(string id, string name, string icon, bool enabled) {
        this.id = id;
        this.name = name;
        this.icon = icon;
        this.enabled = enabled;
    }
}

