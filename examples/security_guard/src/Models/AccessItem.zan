using System;
using Gui;

public class AccessItem {
    string id;
    string name;
    string desc;
    string icon;
    bool enabled;

    AccessItem(string id, string name, string desc, string icon, bool enabled) {
        this.id = id;
        this.name = name;
        this.desc = desc;
        this.icon = icon;
        this.enabled = enabled;
    }
}

