using System;
using SDL3;

/// 手柄输入示例：既演示事件驱动（GAMEPAD_ADDED / BUTTON / AXIS），
/// 也演示每帧直接查询按键与轴。没有插手柄时会等待接入。
/// 用 SDL_VIDEODRIVER=dummy 可在无显示环境下跑通流程。
class Program {
    /// 摇杆死区：小于该原始值当作 0，避免漂移刷屏。
    static int Deadzone() { return 8000; }

    static string ButtonName(int b) {
        if (b == SdlGamepadButton.South()) { return "A"; }
        if (b == SdlGamepadButton.East()) { return "B"; }
        if (b == SdlGamepadButton.West()) { return "X"; }
        if (b == SdlGamepadButton.North()) { return "Y"; }
        if (b == SdlGamepadButton.Start()) { return "Start"; }
        if (b == SdlGamepadButton.Back()) { return "Back"; }
        if (b == SdlGamepadButton.LeftShoulder()) { return "LB"; }
        if (b == SdlGamepadButton.RightShoulder()) { return "RB"; }
        if (b == SdlGamepadButton.DpadUp()) { return "Up"; }
        if (b == SdlGamepadButton.DpadDown()) { return "Down"; }
        if (b == SdlGamepadButton.DpadLeft()) { return "Left"; }
        if (b == SdlGamepadButton.DpadRight()) { return "Right"; }
        return "#" + b.ToString();
    }

    static void Main() {
        if (!Sdl.Init(SdlInit.Gamepad() + SdlInit.Events())) {
            Console.WriteLine("SDL 初始化失败: " + Sdl.Error());
            return;
        }
        SdlGamepad.Init();
        Console.WriteLine("connected at start: " + SdlGamepad.Count().ToString());

        SdlGamepad pad = SdlGamepad.OpenFirst();
        if (pad.IsOpen()) {
            Console.WriteLine("opened: " + pad.Name());
        } else {
            Console.WriteLine("no gamepad yet — plug one in (waiting 5s)");
        }

        int deadline = Sdl.Ticks() + 5000;
        while (Sdl.Ticks() < deadline) {
            while (SdlEvent.Poll()) {
                int type = SdlEvent.Type();
                if (type == SdlEventType.GamepadAdded()) {
                    if (!pad.IsOpen()) {
                        pad = SdlGamepad.Open(SdlEvent.GamepadWhich());
                        Console.WriteLine("added: " + pad.Name());
                        pad.Rumble(40000, 40000, 200);
                    }
                } else if (type == SdlEventType.GamepadRemoved()) {
                    Console.WriteLine("removed: " + SdlEvent.GamepadWhich().ToString());
                    pad.Close();
                } else if (type == SdlEventType.GamepadButtonDown()) {
                    Console.WriteLine("down " + Program.ButtonName(SdlEvent.GamepadButton()));
                } else if (type == SdlEventType.GamepadButtonUp()) {
                    Console.WriteLine("up   " + Program.ButtonName(SdlEvent.GamepadButton()));
                } else if (type == SdlEventType.GamepadAxisMotion()) {
                    int v = SdlEvent.GamepadAxisValue();
                    if (v > Program.Deadzone() || v < -Program.Deadzone()) {
                        Console.WriteLine("axis " + SdlEvent.GamepadAxis().ToString()
                            + " = " + v.ToString());
                    }
                } else if (type == SdlEventType.Quit()) {
                    deadline = 0;
                }
            }

            // 每帧直接查询（很多游戏用轮询而非事件）。
            if (pad.IsOpen() && pad.IsDown(SdlGamepadButton.South())) {
                double lx = pad.AxisNormalized(SdlGamepadAxis.LeftX());
                double ly = pad.AxisNormalized(SdlGamepadAxis.LeftY());
                Console.WriteLine("A held, left stick = ("
                    + ((int)(lx * 100.0)).ToString() + ", "
                    + ((int)(ly * 100.0)).ToString() + ")");
            }

            Sdl.Delay(16);
        }

        pad.Close();
        Sdl.Quit();
        Console.WriteLine("done");
    }
}
