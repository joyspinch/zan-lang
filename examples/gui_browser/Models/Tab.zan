using System;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Component.WebView;

public class Tab {
    WebView view;
    SignalString title;
    string url;

    static Tab Create(string startUrl) {
        Tab t = new Tab();
        t.view = new WebView();
        t.title = new SignalString("New Tab");
        t.url = startUrl;
        return t;
    }
}

// 地址栏控制区与实时 URL 状态监听管线。
