// 莫伤怀 - 网易云音乐沉浸播放界面：
// 真正的声明式开发：无任何 Form 创建、无边框关闭、样式注入或容器挂载等胶水代码。
// 窗口属性（标题、尺寸、无边框沉浸、居中）、CSS 样式与矢量图标均在 App.html 中声明，
// 后台 partial 类仅关注业务逻辑与交互响应。
using System;
using Gui;
partial class MusicApp {
    static bool isPlaying = false;
    static bool isFav = false;

    static void OnLoad(Form form) {
        Console.WriteLine("[MusicApp] 沉浸式网易云音乐播放器已就绪");
    }

    static void OnTogglePlay() {
        isPlaying = !isPlaying;
        if (isPlaying) {
            Console.WriteLine("[MusicApp] 正在播放：莫伤怀 - 于牧野");
        } else {
            Console.WriteLine("[MusicApp] 已暂停播放");
        }
    }

    static void OnFav() {
        isFav = !isFav;
        Console.WriteLine(isFav ? "[MusicApp] 已收藏到我喜欢的音乐" : "[MusicApp] 已取消收藏");
    }
}
