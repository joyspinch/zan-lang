using System;
using Gui;
using Gui.Core;
using Gui.Widget;

/* 音乐播放器 Code-behind 逻辑：
 * 纯粹处理窗口初始化、状态响应与事件绑定，
 * 无任何手写坐标，页面结构与视觉样式完全由 App.html 承载。
 */
class Program {
    static bool isPlaying = false;

    static int Main() {
        // 创建深色沉浸式播放器窗口
        Form form = Form.CreateDark("网易云音乐 - 沉浸播放", 1120, 720);

        // 沉浸式窗口：关闭系统外挂标题栏，由 App.html 的顶栏完全接管视口与标题按钮
        form.GetApp().SetChromeVisible(false);

        // 载入 HTML 中声明的 CSS 样式表（渐变、阴影、圆角、关键帧动画与 Flex 排版）
        form.GetApp().UseAppCss(AppHtml.Css);

        // 注册事件处理器
        HtmlHandlers handlers = new HtmlHandlers();
        handlers.Add("OnTogglePlay", OnTogglePlay);

        // 编译期构建 HTML 树
        Control root = AppHtml.Build(handlers);
        if (root == null) {
            Console.WriteLine("error: failed to build AppHtml root");
            return 1;
        }

        // 树根自动填满整个客户区
        root.DockFill();

        form.With(root);
        form.Run();
        return 0;
    }

    static void OnTogglePlay() {
        isPlaying = !isPlaying;
        if (isPlaying) {
            Console.WriteLine("[Player] 正在播放：莫伤怀 - 于牧野");
        } else {
            Console.WriteLine("[Player] 已暂停播放");
        }
    }
}
