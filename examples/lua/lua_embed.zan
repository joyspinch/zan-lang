using System;
using System.Scripting;

// Lua -> Zan 回调：lua_CFunction 形式，参数在栈上（下标从 1 起），
// 返回值是压入的结果个数。
class Program {
    static int ZanMul(nint L) {
        double a = Lua.ArgDouble(L, 1);
        double b = Lua.ArgDouble(L, 2);
        return Lua.ReturnDouble(L, a * b);
    }

    static void Main() {
        if (!Lua.IsAvailable()) {
            Console.WriteLine("Lua 驱动不可用，请在 ZanIDE 库商城安装 System.Scripting.Lua");
            return;
        }

        Lua.Initialize();

        // 表达式求值与标准库调用
        Console.WriteLine(Lua.Eval("2 ^ 10").ToDouble());
        Console.WriteLine(Lua.CallD("math.floor", 22.7));

        // 脚本定义的函数，像普通函数一样调用
        Lua.Exec("function greet(name)\n  return '你好, ' .. name .. '!'\nend\n");
        LuaValue greet = Lua.GetGlobal("greet");
        Console.WriteLine(greet("Zan").ToStr());

        // Lua 表既是数组也是字典
        LuaValue squares = Lua.Eval("{1, 4, 9}");
        Console.WriteLine(squares[2].ToLong());
        squares[2] = Lua.FromLong(99L);
        Console.WriteLine(squares[2].ToLong());

        LuaValue profile = Lua.Eval("{name = 'Zan'}");
        Console.WriteLine(profile["name"].ToStr());
        profile["language"] = "Lua";
        Console.WriteLine(profile["language"].ToStr());

        // Zan 方法暴露给脚本
        Lua.RegisterFunction("zan_mul", ZanMul);
        Console.WriteLine(Lua.Eval("zan_mul(6, 7)").ToDouble());

        Lua.Finalize();
    }
}
