// 系统底层交互与数据流转契约
// 演示内容：
// 1. Csv.Parse：CsvTable（首记录为表头），引号字段含逗号/引号/换行，
// UTF-8 BOM 自动剥除，CRLF/LF/CR 记录分隔符通吃
// 2. 表访问：Header / Rows / RowCount / Column（按表头名取整列）
// 3. Csv.ParseRow：单行记录解析
// 4. 写出：Serialize / RowToText / Escape（最小加引号，引号翻倍），解析往返
// 5. 自定义分隔符：ParseSep / SerializeSep（TSV）
// 系统底层交互与数据流转契约
using System;
using System.Csv;
using System.Text;

class Program {
    // ---- 演示用小助手：逗号连接、控制字符可见化（stdlib 无 Join/Replace） ----
    static string Join(List<string> items, string sep) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < items.Count; i = i + 1) {
            if (i > 0) { sb.Append(sep); }
            sb.Append(items[i]);
        }
        return sb.ToString();
    }

    static string Show(string s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c == 10) { sb.Append("\\n"); }
            else if (c == 9) { sb.Append("\\t"); }
            else if (c == 13) { sb.Append("\\r"); }
            else { sb.Append(s.Substring(i, 1)); }
        }
        return sb.ToString();
    }

    static void Main() {
        // ---- 1. 解析：BOM + CRLF + 引号字段（含逗号、翻倍引号、内嵌换行） ----
        string bom = Encoding.Utf8FromCodePoint(65279);  // Windows 工具常带 BOM
        string src = bom +
            "name,dept,tags\r\n" +
            "ada,infra,\"oncall, rotate\"\r\n" +
            "bob,web,\"says \"\"hi\"\"\"\r\n" +
            "carol,data,\"line1\nline2\"\r\n";
        CsvTable t = Csv.Parse(src);

        // ---- 2. 表访问 ----
        Console.WriteLine("header    = " + Join(t.Header(), "|"));
        Console.WriteLine("rows      = " + Convert.ToString(t.RowCount()));
        List<string> names = t.Column("name");
        if (names != null) {
            Console.WriteLine("names     = " + Join(names, ","));
        }
        Console.WriteLine("row1      = " + t.Rows()[0][0] + " / " + t.Rows()[0][1]
            + " / " + t.Rows()[0][2]);
        Console.WriteLine("row2 tags = " + t.Rows()[1][2]);
        Console.WriteLine("row3 tags = " + Show(t.Rows()[2][2]));

        // ---- 3. 单行解析（命令行工具场景） ----
        List<string> one = Csv.ParseRow("42,\"a,b\",done");
        Console.WriteLine("parseRow  = " + Convert.ToString(one.Count) + " fields, mid = " + one[1]);

        // ---- 4. 写出与往返：最小加引号，引号翻倍 ----
        List<List<string>> rows = new List<List<string>>();
        List<string> h = new List<string>();
        h.Add("id"); h.Add("note");
        rows.Add(h);
        List<string> r = new List<string>();
        r.Add("7"); r.Add("say \"hi\", ok");
        rows.Add(r);
        string text = Csv.Serialize(rows);
        Console.WriteLine("serialize = " + Show(text));
        CsvTable back = Csv.Parse(text);
        Console.WriteLine("roundtrip = " + (back.Header()[0] == "id"
            && back.Rows()[0][1] == "say \"hi\", ok"));

        // ---- 5. TSV：自定义分隔符 ----
        List<List<string>> tsvRows = new List<List<string>>();
        List<string> th = new List<string>();
        th.Add("x"); th.Add("y");
        tsvRows.Add(th);
        List<string> tr = new List<string>();
        tr.Add("1"); tr.Add("has\ttab");
        tsvRows.Add(tr);
        string tsvText = Csv.SerializeSep(tsvRows, "\t");
        Console.WriteLine("tsv       = " + Show(tsvText));
        CsvTable tsvBack = Csv.ParseSep(tsvText, "\t");
        Console.WriteLine("tsv back  = " + tsvBack.Rows()[0][1]);
    }
}
