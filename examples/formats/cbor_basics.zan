// CBOR 基础 —— Zan.Cbor（RFC 8949）：二进制 JSON，编解码与体量对比
// 演示内容：
// 1. Cbor.Encode / Decode：JsonValue ↔ CBOR 字节（规范最短整数形态）
// 2. Cbor.Load / Save：直接读写文件
// 3. 体量对比：同一段数据 JSON 文本 vs CBOR 字节数
// 系统底层交互与数据流转契约
using System;
using System.Json;
using System.Cbor;

class Program {
    // ---- 可空兜底助手：Get 缺失返回 null，取值统一走这里 ----
    static string S(JsonValue v, string d) {
        if (v == null) { return d; }
        return v.AsString(d);
    }

    static long L(JsonValue v, long d) {
        if (v == null) { return d; }
        return v.AsLong(d);
    }

    static double D(JsonValue v, double d) {
        if (v == null) { return d; }
        return v.AsDouble(d);
    }

    // 字节数组 → 十六进制（演示用，长串截断）。
    static string Hex(byte[] b) {
        string digits = "0123456789abcdef";
        string out2 = "";
        int i = 0;
        while (i < b.Length && i < 24) {
            int v = b[i] & 255;
            if (i > 0) { out2 = out2 + " "; }
            out2 = out2 + digits.Substring(v >> 4, 1) + digits.Substring(v & 15, 1);
            i = i + 1;
        }
        if (b.Length > 24) { out2 = out2 + " ..."; }
        return out2;
    }

    static void Main() {
        JsonValue v = JsonValue.NewObject();
        v.Put("id", JsonValue.NewInt(1234));
        v.Put("name", JsonValue.NewStr("sensor"));
        v.Put("ok", JsonValue.NewBool(true));
        v.Put("gain", JsonValue.NewDouble(0.5));
        JsonValue tags = JsonValue.NewArray();
        tags.Append(JsonValue.NewStr("a"));
        tags.Append(JsonValue.NewStr("b"));
        v.Put("tags", tags);

        // ---- 编码：整数字段走最短形态（1234 → 19 04 d2） ----
        byte[] bin = Cbor.Encode(v);
        Console.WriteLine("cbor      = " + Hex(bin) + " (" + bin.Length + " bytes)");

        // ---- 解码：回来的树与原值相等 ----
        JsonValue back = Cbor.Decode(bin);
        Console.WriteLine("id        = " + L(back.Get("id"), 0));
        Console.WriteLine("name      = " + S(back.Get("name"), ""));
        Console.WriteLine("gain      = " + D(back.Get("gain"), 0));
        JsonValue tagsBack = back.Get("tags");
        Console.WriteLine("tags      = " + (tagsBack == null ? 0 : tagsBack.Count()));

        // ---- 体量：JSON 文本 vs CBOR ----
        string json = v.ToJson();
        Console.WriteLine("size      = json " + json.Length + " chars vs cbor " + bin.Length + " bytes");

        // ---- 文件：Save/Load 对称 ----
        Cbor.Save(v, "_cbor_demo.bin");
        JsonValue disk = Cbor.Load("_cbor_demo.bin");
        Console.WriteLine("disk      = " + (L(disk.Get("id"), -1) == 1234));
        File.Delete("_cbor_demo.bin");

        // ---- 错误路径：截断字节流抛 CborException ----
        try {
            Cbor.Decode(new byte[] { 100, 73 });
            Console.WriteLine("truncated = NOT THROWN");
        } catch (CborException e) {
            Console.WriteLine("truncated = " + e.Message);
        }
    }
}
