// ============================================================================
// XML 基础 —— Zan.Xml（System.Xml）DOM 解析与构建
// ----------------------------------------------------------------------------
// 演示内容：
//   1. XmlDocument.Parse / ToXml：解析非法即抛 XmlException（带行列号）
//   2. 构建：XmlNode.NewElement / SetAttr / AddText / AddChild
//   3. 导航：Element / Elements / Attr / InnerText——缺失返回 null，
//      先落地判空再用
//   4. 往返：Parse(ToXml(doc)) 得到语义相同的树
//
// 运行：zanc examples/formats/xml_basics.zan --auto-stdlib -o xml.exe && ./xml.exe
// ============================================================================
using System;
using System.Xml;

class Program {
    // ---- 可空兜底助手：Attr 缺失返回 null，取值统一走这里 ----
    static string T(XmlNode n) {
        if (n == null) { return ""; }
        return n.InnerText();
    }

    static string A(XmlNode n, string name) {
        if (n == null) { return ""; }
        string v = n.Attr(name);
        if (v == null) { return ""; }
        return v;
    }

    static void Main() {
        // ---- 1. 解析：配置/报文里最常见的形态 ----
        XmlDocument doc = XmlDocument.Parse(
            "<?xml version=\"1.0\"?>\n" +
            "<server version=\"2\">\n" +
            "  <host>127.0.0.1</host>\n" +
            "  <port>8080</port>\n" +
            "  <user name=\"alice\" role=\"admin\"/>\n" +
            "  <user name=\"bob\" role=\"dev\"/>\n" +
            "</server>");
        XmlNode root = doc.RootElement();
        if (root == null) {
            Console.WriteLine("no root element");
            return;
        }
        Console.WriteLine("root      = " + root.LocalName());
        Console.WriteLine("version   = " + A(root, "version"));
        Console.WriteLine("host      = " + T(root.Element("host")));
        Console.WriteLine("port      = " + T(root.Element("port")));

        // 同名子元素遍历：Elements 返回全部，没有则空列表。
        List<XmlNode> users = root.Elements("user");
        int i = 0;
        while (i < users.Count) {
            Console.WriteLine("user      = " + A(users[i], "name")
                + " (" + A(users[i], "role") + ")");
            i = i + 1;
        }

        // 缺失的节点/属性返回 null——判空后再用。
        XmlNode missing = root.Element("cache");
        Console.WriteLine("cache     = " + (missing == null ? "(absent)" : "present"));

        // ---- 2. 构建：一个卡片节点并序列化 ----
        XmlNode card = XmlNode.NewElement("card");
        card.SetAttr("id", "42");
        card.AddText("hello");
        root.AddChild(card);
        Console.WriteLine("built     = " + doc.ToXml());

        // ---- 3. 往返：写出的文本再解析，语义一致 ----
        XmlDocument again = XmlDocument.Parse(doc.ToXml());
        XmlNode root2 = again.RootElement();
        XmlNode cardBack = root2 == null ? null : root2.Element("card");
        Console.WriteLine("roundtrip = " + (T(cardBack) == "hello"));

        // ---- 4. 错误路径：非法 XML 抛 XmlException，消息带行列号 ----
        try {
            XmlDocument.Parse("<a>\n  <b></c>\n</a>");
            Console.WriteLine("bad-input = NOT THROWN");
        } catch (XmlException e) {
            Console.WriteLine("bad-input = " + e.Message);
        }
    }
}
