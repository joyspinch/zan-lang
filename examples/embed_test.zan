// Headless validation of the embedded-resource chain AND the skin-name
// enumeration parsing that Skin.Available() uses, against the data baked in.
using System;

class Embed {
    static extern string zan_embed_read(string name);
    static extern int zan_embed_has(string name);
    static extern string zan_embed_list(string prefix);

    // mirror of Skin.EmbedSkinName
    static string SkinName(string line) {
        string pre = "skins/";
        if (line.Length <= pre.Length) { return ""; }
        if (line.Substring(0, pre.Length) != pre) { return ""; }
        string rest = line.Substring(pre.Length, line.Length - pre.Length);
        int slash = -1;
        int i = 0;
        while (i < rest.Length) {
            if (rest[i] == '/') { slash = i; i = rest.Length; }
            else { i = i + 1; }
        }
        if (slash <= 0) { return ""; }
        return rest.Substring(0, slash);
    }
}

class Program {
    static void Main() {
        Console.WriteLine("HAS_BASE=" + Convert.ToString(Embed.zan_embed_has("skins/base.css")));
        string css = Embed.zan_embed_read("skins/liquidglass/skin.css");
        Console.WriteLine("LIQUID_LEN=" + Convert.ToString(css.Length));

        // enumerate skin pack names from the embedded list (Skin.Available path)
        string emb = Embed.zan_embed_list("skins/");
        List<string> names = new List<string>();
        int p = 0;
        int start = 0;
        while (p <= emb.Length) {
            bool brk = false;
            if (p == emb.Length) { brk = true; }
            else if (emb[p] == '\n') { brk = true; }
            if (brk) {
                if (p > start) {
                    string line = emb.Substring(start, p - start);
                    string nm = Embed.SkinName(line);
                    bool dup = false;
                    int q = 0;
                    while (q < names.Count) { if (names[q] == nm) { dup = true; } q = q + 1; }
                    if (nm != "" && !dup) { names.Add(nm); }
                }
                start = p + 1;
            }
            p = p + 1;
        }
        Console.WriteLine("SKIN_PACKS=" + Convert.ToString(names.Count));
        int i = 0;
        while (i < names.Count) { Console.WriteLine("PACK=" + names[i]); i = i + 1; }
        Console.WriteLine("EMBED_TEST_DONE");
    }
}
