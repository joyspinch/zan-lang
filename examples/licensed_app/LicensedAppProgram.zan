using System;
using System.IO;
using System.Security.Cryptography;
using Security.Commercial;

/* Real LicenseClient integration. Configuration comes from the deployment;
 * no endpoint, activation code, account or issuer key is supplied by default.
 * Product must match the mall's exact slug@major-N identity. */
public class LicensedAppProgram {
    static bool ProductValid(string product) {
        int marker = product.IndexOf("@major-");
        if (marker <= 0) { return false; }
        string slug = product.Substring(0, marker);
        string major = product.Substring(marker + 7);
        if (major.Length == 0 || major[0] < 49 || major[0] > 57) { return false; }
        for (int i = 0; i < slug.Length; i++) {
            int c = slug[i];
            if (!((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45)) {
                return false;
            }
        }
        for (int i = 0; i < major.Length; i++) {
            if (major[i] < 48 || major[i] > 57) { return false; }
        }
        return true;
    }

    static bool PinIssuer(LicenseClient lic) {
        string path = ProcessHost.Env("ZAN_LICENSE_PUBLIC_KEYSET_PATH");
        if (path.Length == 0) { path = ProcessHost.Env("ZAN_LICENSE_PUBLIC_KEY_PATH"); }
        lic.VendorPublicKey("", "");
        if (path.Length == 0 || !File.Exists(path) || File.GetSize64(path) > 16384) { return false; }
        // Deployment-owned public PEM bundle; HTTP responses cannot add anchors.
        try { return lic.VendorPublicKeyPemBundle(File.ReadAllText(path)); }
        catch (Exception ex) { return false; }
    }

    static async int Run() {
        string product = ProcessHost.Env("ZAN_LICENSE_PRODUCT");
        if (!LicensedAppProgram.ProductValid(product)) {
            Console.WriteLine("[licensed_app] 请配置有效的 ZAN_LICENSE_PRODUCT（slug@major-N）。");
            return 2;
        }
        string server = ProcessHost.Env("ZAN_LICENSE_SERVER");
        LicenseClient lic = new LicenseClient();
        lic.Server(server, "LicensedAppExample");
        lic.Product(product);
        if (!LicensedAppProgram.PinIssuer(lic)) {
            Console.WriteLine("[licensed_app] 缺少或无法解析可信发行方公钥。");
            return 2;
        }

        string certificatePath = ProcessHost.Env("ZAN_LICENSE_CERTIFICATE_PATH");
        if (certificatePath.Length > 0) {
            LicenseCheckResult installed = lic.InstallCertificate(File.ReadAllText(certificatePath));
            if (!installed.ok) {
                Console.WriteLine("[licensed_app] 证书安装失败。");
                return 1;
            }
        }
        /* InstallCertificate persists data; only Check verifies the signature,
         * exact product, device and expiry. Never enter business code first. */
        LicenseCheckResult result = await lic.Check();
        if (!result.ok && certificatePath.Length == 0 && server.Length > 0) {
            string code = ProcessHost.Env("ZAN_LICENSE_ACTIVATION_CODE");
            string account = ProcessHost.Env("ZAN_LICENSE_ACCOUNT");
            string password = ProcessHost.Env("ZAN_LICENSE_PASSWORD");
            if (code.Length > 0) {
                result = await lic.Activate(code);
            } else if (account.Length > 0 && password.Length > 0) {
                result = await lic.Login(account, password);
            }
            if (result.ok) { result = await lic.Check(); }
        }
        if (!result.ok) {
            Console.WriteLine("[licensed_app] 授权校验未通过，主功能未启动。");
            return 1;
        }
        return await LicensedAppProgram.LicensedMain(lic);
    }

    /* A real app starts its window/main loop here and schedules Heartbeat for
     * online sessions. Signed certificates are checked locally, without HTTP. */
    static async int LicensedMain(LicenseClient lic) {
        if (lic.state.mode != "signed") {
            LicenseCheckResult heartbeat = await lic.Heartbeat();
            if (!heartbeat.ok) {
                Console.WriteLine("[licensed_app] 在线心跳未通过，主功能未启动。");
                return 1;
            }
        }
        Console.WriteLine("[licensed_app] 授权有效，进入主功能。");
        /* Keep state by default so the next process exercises persisted Check.
         * Explicit online logout clears local state even if notification fails. */
        if (lic.state.mode != "signed" && ProcessHost.Env("ZAN_LICENSE_LOGOUT") == "1") {
            LicenseCheckResult logout = await lic.LogoutOnline();
            Console.WriteLine(logout.ok
                ? "[licensed_app] 已清除本地授权并发送登出请求。"
                : "[licensed_app] 已清除本地授权，登出通知未成功。");
        }
        return 0;
    }

    static async int Main() {
        try { return await LicensedAppProgram.Run(); }
        catch (Exception error) {
            /* Endpoint responses, credentials and certificate contents must not
             * be copied from exception messages into application logs. */
            Console.WriteLine("[licensed_app] 配置读取或授权操作失败。");
            return 1;
        }
    }
}
