// GameKit — shared, self-contained helpers for the examples/game products.
// SDL-based (games always run on the SDL backend). No dependency on the ZGM UI
// stack; the bitmap font is embedded here so each game is standalone.
using System;
using System.Diagnostics;
using System.IO;
using System.Resources;
using System.Security;
using System.Security.Cryptography;
using SDL3;

namespace GameKit;

// Resolves repo-relative asset paths against the RUNNING EXECUTABLE rather than
// the working directory, which the launcher (IDE Run, a shortcut, a shell in
// another directory) picks arbitrarily -- getting it wrong loaded no texture at
// all and the game opened as a black window. Both layouts keep the assets
// repo-relative, so anchoring at the exe directory and walking up its parents
// finds them from build/game.exe as well as from a packaged dist/game.exe.
// The working directory is still tried last, for `zanc run` style launches
// where the exe lives in a temp directory.
class Assets {
    static string exeDir;
    static bool exeDirReady;

    public static string ExeDir() {
        if (Assets.exeDirReady) { return Assets.exeDir; }
        Assets.exeDirReady = true;
        Assets.exeDir = Assets.Parent(ProcessHost.SelfExe());
        return Assets.exeDir;
    }

    // Directory part of a path, "" when it has none.
    static string Parent(string path) {
        int cut = -1;
        for (int i = 0; i < path.Length; i = i + 1) {
            string c = path.Substring(i, 1);
            if (c == "/" || c == "\\") { cut = i; }
        }
        if (cut <= 0) { return ""; }
        return path.Substring(0, cut);
    }

    static string Find(string rel) {
        string dir = Assets.ExeDir();
        for (int up = 0; dir != "" && up < 4; up = up + 1) {
            string p = dir + "/" + rel;
            if (File.Exists(p)) { return p; }
            dir = Assets.Parent(dir);
        }
        // Fallback: the working directory and its parents (the IDE starts a
        // program in its project root, a shell run may sit a level or two in).
        string cwdRel = rel;
        for (int outward = 0; outward < 4; outward = outward + 1) {
            if (File.Exists(cwdRel)) { return cwdRel; }
            cwdRel = "../" + cwdRel;
        }
        return rel;
    }

    // GameKit 公共资源兼容两种布局：exe 同级 assets/common（推荐）或旧的
    // examples/game/common/assets（仓库源码布局）。优先新布局。
    public static string FindCommon(string name) {
        string p = Assets.Find("assets/common/" + name);
        if (File.Exists(p)) { return p; }
        p = Assets.Find("examples/game/common/assets/" + name);
        if (File.Exists(p)) { return p; }
        return "assets/common/" + name;
    }
}

// Embedded 8x8 ASCII glyph atlas (codepoints 32..126), hex-encoded, 8 row-bytes
// per glyph; bit 7 is the leftmost column. Decoded once on first use.
class Font {
    static int[] rows;
    static bool ready;

    static int Advance() { return 6; }

    static string Data() {
        return "";
    }

    static int HexVal(int ch) {
        if (ch >= 48 && ch <= 57) { return ch - 48; }
        if (ch >= 97 && ch <= 102) { return ch - 97 + 10; }
        if (ch >= 65 && ch <= 70) { return ch - 65 + 10; }
        return 0;
    }

    static void Ensure() {
        if (Font.ready) { return; }
        string hex = Font.Data();
        int n = hex.Length / 2;
        Font.rows = new int[n];
        for (int i = 0; i < n; i = i + 1) {
            int hi = Font.HexVal(hex[i * 2] & 255);
            int lo = Font.HexVal(hex[i * 2 + 1] & 255);
            Font.rows[i] = hi * 16 + lo;
        }
        Font.ready = true;
    }

    static int Row(int codepoint, int row) {
        Font.Ensure();
        if (codepoint < 32 || codepoint > 126) { return 0; }
        if (row < 0 || row >= 8) { return 0; }
        return Font.rows[(codepoint - 32) * 8 + row];
    }

    static int Measure(string text, int scale) {
        if (text == null) { return 0; }
        if (scale < 1) { scale = 1; }
        return text.Length * Font.Advance() * scale;
    }
}

// Smooth anti-aliased TrueType font baked to a texture atlas (white glyphs,
// tinted at draw time via SetColor). Falls back to the bitmap Font if the
// atlas assets are missing. Assets: assets/common/font.png + .txt
class GlyphFont {
    static SdlTexture atlas;
    static bool tried;
    static bool ok;
    static int cellW;   // design cell width (layout units)
    static int cellH;   // design cell height (layout units)
    static int cols;
    static int atlasScale;  // atlas is baked at this multiple of the design cell
    static int[] adv;   // advance width per glyph (codepoints 32..126)

    static int NextInt(string s, int[] pos) {
        int i = pos[0];
        int n = s.Length;
        bool started = false;
        while (i < n && !started) {
            int c = s[i] & 255;
            if (c >= 48 && c <= 57) { started = true; }
            else { i = i + 1; }
        }
        int v = 0;
        bool any = false;
        bool done = false;
        while (i < n && !done) {
            int c = s[i] & 255;
            if (c >= 48 && c <= 57) { v = v * 10 + (c - 48); any = true; i = i + 1; }
            else { done = true; }
        }
        pos[0] = i;
        if (!any) { return -1; }
        return v;
    }

    static bool Ready(SdlRenderer r) {
        if (GlyphFont.tried) { return GlyphFont.ok; }
        GlyphFont.tried = true;
        string metaPath = Assets.FindCommon("font.txt");
        if (!File.Exists(metaPath)) { return false; }
        SdlTexture t = SdlTexture.LoadImage(r, Assets.FindCommon("font.png"));
        if (t == null || !t.IsValid()) { return false; }
        t.SetNearest(false);
        t.SetBlendMode(1);
        string meta = File.ReadAllText(metaPath);
        int[] pos = new int[1];
        pos[0] = 0;
        GlyphFont.cellW = GlyphFont.NextInt(meta, pos);
        GlyphFont.cellH = GlyphFont.NextInt(meta, pos);
        GlyphFont.cols = GlyphFont.NextInt(meta, pos);
        int pad = GlyphFont.NextInt(meta, pos);
        GlyphFont.atlasScale = GlyphFont.NextInt(meta, pos);
        if (GlyphFont.atlasScale < 1) { GlyphFont.atlasScale = 1; }
        GlyphFont.adv = new int[95];
        for (int i = 0; i < 95; i = i + 1) {
            int a = GlyphFont.NextInt(meta, pos);
            if (a < 0) { a = GlyphFont.cellW; }
            GlyphFont.adv[i] = a;
        }
        GlyphFont.atlas = t;
        GlyphFont.ok = true;
        return true;
    }

    static int Measure(string text, int scale) {
        if (text == null) { return 0; }
        int w = 0;
        for (int i = 0; i < text.Length; i = i + 1) {
            int gi = (text[i] & 255) - 32;
            if (gi < 0 || gi >= 95) { gi = 0; }
            w = w + GlyphFont.adv[gi] * scale / 6;
        }
        return w;
    }

    // Draw one glyph (index into the 32..126 range) at design scale; returns
    // the pen advance.
    static int DrawGlyph(SdlRenderer r, int gi, int x, int y, int scale) {
        if (gi < 0 || gi >= 95) { return GlyphFont.adv[0] * scale / 6; }
        int m = GlyphFont.atlasScale;
        int scw = GlyphFont.cellW * m;
        int sch = GlyphFont.cellH * m;
        int col = gi % GlyphFont.cols;
        int row = gi / GlyphFont.cols;
        r.DrawTextureRegion(GlyphFont.atlas, col * scw, row * sch, scw, sch,
            x, y, GlyphFont.cellW * scale / 6, GlyphFont.cellH * scale / 6);
        return GlyphFont.adv[gi] * scale / 6;
    }

    static void Draw(SdlRenderer r, string text, int x, int y, int scale,
                     int cr, int cg, int cb, int ca) {
        int dw = GlyphFont.cellW * scale / 6;
        int dh = GlyphFont.cellH * scale / 6;
        int m = GlyphFont.atlasScale;
        int scw = GlyphFont.cellW * m;
        int sch = GlyphFont.cellH * m;
        // Batched path: every glyph is a same-texture quad from the atlas,
        // so one label collapses into a single geometry run. The flush at
        // the end keeps painter order with the surrounding immediate draws
        // (each label is an atomic ordered group).
        SdlSpriteBatch b = Host.FindBatch(r);
        if (b != null) {
            int pen = x;
            for (int i = 0; i < text.Length; i = i + 1) {
                int gi = (text[i] & 255) - 32;
                if (gi >= 0 && gi < 95) {
                    int col = gi % GlyphFont.cols;
                    int row = gi / GlyphFont.cols;
                    b.QueueRegion(GlyphFont.atlas, col * scw, row * sch,
                        scw, sch, pen, y, dw, dh, cr, cg, cb, ca);
                    pen = pen + GlyphFont.adv[gi] * scale / 6;
                } else {
                    pen = pen + GlyphFont.adv[0] * scale / 6;
                }
            }
            b.End();
            b.Begin();
            return;
        }
        GlyphFont.atlas.SetColor(cr, cg, cb);
        GlyphFont.atlas.SetOpacity(ca);
        int pen2 = x;
        for (int i = 0; i < text.Length; i = i + 1) {
            int gi = (text[i] & 255) - 32;
            if (gi >= 0 && gi < 95) {
                int col = gi % GlyphFont.cols;
                int row = gi / GlyphFont.cols;
                r.DrawTextureRegion(GlyphFont.atlas, col * scw,
                    row * sch, scw, sch,
                    pen2, y, dw, dh);
                pen2 = pen2 + GlyphFont.adv[gi] * scale / 6;
            } else {
                pen2 = pen2 + GlyphFont.adv[0] * scale / 6;
            }
        }
        GlyphFont.atlas.ResetColor();
        GlyphFont.atlas.SetOpacity(255);
    }
}

// Host: a DPI/resolution-proof window + renderer. Windowed by default (F11 or
// the game's toggle switches to fullscreen); the game always draws to a fixed
// logical canvas that the renderer letterbox-scales to the window/screen, so
// gameplay math is resolution-independent and looks correct on any DPI.
class Host {
    #if WINDOWS
    // SDL_RestoreWindow isn't in the zan_sdl3 bridge; call SDL3 directly so F11
    // un-maximizes back to the original window size instead of a maximized one.
    [DllImport("SDL3", EntryPoint = "SDL_RestoreWindow")]
    static extern int SdlRestoreWindow(nint win);
    #endif

    SdlWindow window;
    public SdlRenderer r;
    SdlTexture canvas;   // offscreen target; downsampled on present

    /// 宿主 SDL 窗口句柄（GameHud 接管合成层用）。
    public nint WindowHandle() { return this.window.Handle(); }
    /// 窗口当前客户区像素宽（GameHud 帧尺寸用）。
    public int WindowW() { return this.window.Width(); }
    /// 窗口当前客户区像素高。
    public int WindowH() { return this.window.Height(); }
    int logicalW;
    int logicalH;
    int canvasW;         // canvas raster size in native px (see CreateFull)
    int canvasH;
    bool running;
    bool fullscreen;
    bool ignoreMax;   // swallow the maximize event fired when leaving fullscreen
    int frameMs;      // target frame time (>0 caps the fps; 0 = vsync only)
    int nextFrame;    // absolute tick deadline for the next frame start
    int idleMs;       // frame time while minimized (0 = no idle throttle)
    bool minimized;
    int redrawMs;     // event-driven redraw interval (0 = render every frame)
    int nextRedraw;   // absolute tick when the next render is due
    bool hadEvent;    // any input/window event arrived since last render
    // Custom title bar (borderless window + game-drawn bar). SDL_HITTEST
    // handles dragging/resizing natively; the game only draws the bar.
    bool customBar;
    string barTitle;
    bool mouseBarDown;   // game feeds mouse state inside the bar zone
    // Geometry-batched sprite submission (see SdlSpriteBatch). Created
    // lazily against the renderer; Begin() opens a frame, End() flushes
    // before Present. Sprite.Ball/Glow route their textured quads through
    // it so hundreds of discs per frame cost runs, not draw calls.
    SdlSpriteBatch sprBatch;

    // ss=3 bakes a ~4K raster target (razor-sharp on 4K panels). Fill-heavy
    // games (idle games repaint hundreds of scanline fills per frame) should
    // pass 2: still anti-aliased after the linear downsample, at under half
    // the fill cost.
    static Host Create(string title, int logicalW, int logicalH) {
        return Host.CreateSs(title, logicalW, logicalH, 3);
    }

    static Host CreateSs(string title, int logicalW, int logicalH, int ss) {
        return Host.CreateFull(title, logicalW, logicalH, ss, false);
    }

    // customBar: borderless window + SDL hit-test drag/resize + game-drawn
    // title bar (Host.DrawTitleBar / TitleBarInput). The OS title bar on a
    // themed desktop clashes with game art; this keeps one visual language.
    // The single live game host (games are one-window). Sprite batch
    // routing resolves through it; null outside a game's lifetime.
    static Host liveHost;

    static Host CreateFull(string title, int logicalW, int logicalH, int ss, bool customBar) {
        Sdl.Init(SdlInit.Video() + SdlInit.Events());
        Host h = new Host();
        liveHost = h;
        int flags = SdlWindowFlags.Resizable() + SdlWindowFlags.HighPixelDensity();
        if (customBar) { flags = flags + SdlWindowFlags.Borderless(); }
        h.customBar = customBar;
        h.barTitle = title;
        // Windowed by default at 1.5x the logical size (comfortably large on
        // 1440p/4K without covering the desktop), resizable and high-DPI
        // aware; F11 toggles fullscreen. The letterboxed logical canvas keeps
        // gameplay math resolution-independent.
        h.window = SdlWindow.Create(title, logicalW * 3 / 2, logicalH * 3 / 2, flags);
        if (customBar) { h.window.SetGameHitTest(logicalW); }
        h.r = SdlRenderer.Create(h.window);
        h.r.SetBlend(1);
        h.r.SetVSync(true);
        // Canvas sizing (supersample-while-downscaling, SSRT): the scene is
        // rasterized into an offscreen target at the *output* resolution,
        // clamped to [logical .. ss x logical]. Games keep authoring in fixed
        // design units; r.Sc() maps them onto the canvas. This wastes no
        // fill on pixels that would be thrown away: a 1.5x window renders
        // 1920x1080 (1:1 with the display) instead of a blind 2x target, while
        // a 4K fullscreen still gets the full ss x raster for sharpness.
        // The linear downsample only happens when the window is smaller than
        // the logical size, which is also where the extra AA comes from.
        int f = ss;
        if (f < 1) { f = 1; }
        int outPacked = h.r.OutputSize();
        int outW = outPacked & 65535;
        int outH = outPacked >> 16;
        h.canvasW = outW;
        if (h.canvasW < logicalW) { h.canvasW = logicalW; }
        if (h.canvasW > logicalW * f) { h.canvasW = logicalW * f; }
        h.canvasH = outH;
        if (h.canvasH < logicalH) { h.canvasH = logicalH; }
        if (h.canvasH > logicalH * f) { h.canvasH = logicalH * f; }
        // Fractional scale factor canvas/logical as num/den for r.Sc().
        int num = h.canvasW;
        int den = logicalW;
        if (h.canvasH * den > h.canvasW * logicalH) { num = h.canvasH; den = logicalH; }
        int g0 = num; int g1 = den;
        while (g1 != 0) { int g = g0 % g1; g0 = g1; g1 = g; }
        if (g0 > 1) { num = num / g0; den = den / g0; }
        h.r.SetLogicalSize(h.canvasW, h.canvasH,
            SdlLogicalPresentation.Letterbox());
        h.r.SetUiScale(num, den);
        // Vector shapes rasterize at canvas resolution: 1:1 windows are
        // razor-sharp, smaller windows are anti-aliased by the linear
        // downsample. (Presentation alone only scales coordinates and
        // leaves jagged edges.)
        h.canvas = SdlTexture.CreateTarget(h.r, h.canvasW, h.canvasH);
        Sprite.Bake(h.r);
        Draw.EnsureRound(h.r);
        h.logicalW = logicalW;
        h.logicalH = logicalH;
        h.running = true;
        h.fullscreen = false;
        h.frameMs = 0;
        h.nextRedraw = 0;   // first frame always renders
        // Tamper defense is release-only: dev builds (compiled without -DPUBLISH)
        // must stay debuggable, so the guard is never armed there.
        #if PUBLISH
        Guard.Arm();
        #endif
        return h;
    }

    SdlRenderer Renderer() { return this.r; }
    int Width() { return this.logicalW; }
    int Height() { return this.logicalH; }
    bool Running() { return this.running; }
    void Quit() { this.running = false; }

    // Cap the render loop at ~fps. VSync usually already paces the loop, but
    // a 165Hz display paces it at 165fps -- the GPU still burns 2.75x the
    // frames a 2D idle game needs. This throttles to the requested budget by
    // sleeping until the frame *start* deadline (not after Present), so the
    // pace holds regardless of how fast Present returns.
    void LimitFps(int fps) {
        if (fps < 10) { fps = 10; }
        if (fps > 240) { fps = 240; }
        this.frameMs = 1000 / fps;
        this.nextFrame = Sdl.Ticks();
    }

    // Drop to the idle fps while the window is genuinely MINIMIZED, so a
    // background idle game costs ~nothing: rendering to an invisible window
    // is wasted power. Losing focus deliberately does NOT change the pace --
    // an unfocused-but-visible window keeps rendering and simulating at full
    // rate (see PaceFrame and the focus-event note in OnWindowEvent).
    void SetIdleFps(int fps) {
        if (fps < 1) { fps = 1; }
        this.idleMs = 1000 / fps;
    }

    // Event-driven redraw for mostly-static scenes (idle games, menus,
    // turn-based boards). The loop keeps polling events and stepping the
    // sim, but skips the whole render+present when nothing changed since
    // the last frame: no input, no animation tick due, no explicit
    // RequestRedraw(). A static scene then costs no GPU/CPU at all instead
    // of repainting 60 identical frames a second. When the scene does
    // animate, frames still pace at frameMs -- the interval only adds
    // skips, never delays a due frame. 0 (default) = render every frame.
    void SetRedrawInterval(int ms) {
        if (ms < 0) { ms = 0; }
        this.redrawMs = ms;
    }

    // Force the next frame to render even if nothing ticked (call after
    // changing state outside Step(), e.g. async callbacks).
    void RequestRedraw() {
        this.nextRedraw = 0;
    }

    void SetMinimized(bool m) {
        if (this.minimized == m) { return; }
        this.minimized = m;
        // skip the catch-up burst on restore
        this.nextFrame = Sdl.Ticks() + this.frameMs;
    }

    bool Minimized() { return this.minimized; }

    // Sleep until the next frame's start deadline, then advance it. Sleeping
    // before Present would stall the swap chain, so this runs from End() --
    // but on a vsync'd driver Present itself blocks, so the deadline is kept
    // in absolute ticks and only the surplus is slept.
    void PaceFrame() {
        int ms = this.frameMs;
        if (this.minimized && this.idleMs > ms) { ms = this.idleMs; }
        if (ms <= 0) { return; }
        int now = Sdl.Ticks();
        if (now < this.nextFrame) {
            int slack = this.nextFrame - now;
            if (slack > 4) { Sdl.Delay(slack - 3); }
        }
        this.nextFrame = this.nextFrame + ms;
        if (this.nextFrame < now) { this.nextFrame = now + ms; }
    }

    void ToggleFullscreen() {
        this.fullscreen = !this.fullscreen;
        this.window.SetFullscreen(this.fullscreen);
        // Leaving fullscreen restores the previous (maximized) state, which
        // re-fires WindowMaximized; swallow that one and un-maximize so F11
        // returns to the original window size instead of snapping back.
        if (!this.fullscreen) {
            this.ignoreMax = true;
            #if WINDOWS
            Host.SdlRestoreWindow(this.window.Handle());
            #endif
        }
    }
    bool IsFullscreen() { return this.fullscreen; }

    // ---- Custom title bar -------------------------------------------------
    // Games call DrawTitleBar() first in their render pass (logical units)
    // and TitleBarInput() in their event handler. Bar geometry is fixed:
    // 40 design units tall, caption buttons on the right (46x32, 8 gap).

    static int BarH() { return 40; }
    static int BtnW() { return 46; }
    static int BtnH() { return 32; }
    static int BtnGap() { return 8; }
    static int BtnPad() { return 10; }

    bool HasCustomBar() { return this.customBar; }

    // Draw the themed bar: title text left, minimize/maximize/close right.
    // Returns the three button rects so the game can also use them for hover.
    // ox/oy = x-offset of the button row (close btn x). Callers draw icons.
    void DrawTitleBarChrome(SdlRenderer r, int w, int themeR, int themeG, int themeB) {
        if (!this.customBar) { return; }
        int bh = Host.BarH();
        // bar background: slightly darker than game bg + bottom hairline
        Draw.RoundRectFill(r, 0, 0, w, bh, 0, themeR, themeG, themeB, 255);
        Draw.RoundRectFill(r, 0, bh - 1, w, 1, 0, 255, 255, 255, 26);
        // title (left, vertically centered)
        Text.DrawShadow(r, this.barTitle, 14, bh / 2 - 13, 2, 220, 226, 244, 255);
    }

    // Caption button rects (min, max, close) in logical units for width w.
    void BarButtons(int w, int[] outRects) {
        int bw = Host.BtnW();
        int bh = Host.BtnH();
        int y = (Host.BarH() - bh) / 2;
        int closeX = w - Host.BtnPad() - bw;
        int maxX = closeX - Host.BtnGap() - bw;
        int minX = maxX - Host.BtnGap() - bw;
        outRects[0] = minX; outRects[1] = y;
        outRects[2] = maxX; outRects[3] = y;
        outRects[4] = closeX; outRects[5] = y;
    }

    // Handle hover + click for the caption buttons. mx/my are window-client
    // coords in design units (Host.MouseX/Y). Returns:
    // 0 none, 1 minimize pressed, 2 maximize pressed, 3 close pressed.
    // The game should draw the button glyphs itself (hover tint differs).
    int BarInput(int mx, int my, int w) {
        if (!this.customBar) { return 0; }
        if (!Draw.PointIn(mx, my, 0, 0, w, Host.BarH())) { return 0; }
        int[] rc = new int[6];
        this.BarButtons(w, rc);
        if (!Draw.PointIn(mx, my, rc[0], rc[1], Host.BtnW() * 3 + Host.BtnGap() * 2, Host.BtnH())) {
            return 0;
        }
        if (!this.mouseBarDown) { return 0; }
        if (Draw.PointIn(mx, my, rc[0], rc[1], Host.BtnW(), Host.BtnH())) { return 1; }
        if (Draw.PointIn(mx, my, rc[2], rc[3], Host.BtnW(), Host.BtnH())) { return 2; }
        if (Draw.PointIn(mx, my, rc[4], rc[5], Host.BtnW(), Host.BtnH())) { return 3; }
        return 0;
    }

    // The game must feed mouse-down/up state for the bar zone each frame.
    void SetBarMouseDown(bool down) { this.mouseBarDown = down; }

    void ShowBarMenu() {
        #if WINDOWS
        Host.SdlShowSystemMenu(this.window.Handle());
        #endif
    }
    #if WINDOWS
    [DllImport("SDL3", EntryPoint = "SDL_ShowWindowSystemMenu")]
    static extern int SdlShowSystemMenuRaw(nint win, int x, int y);
    static void SdlShowSystemMenu(nint win) {
        Host.SdlShowSystemMenuRaw(win, 0, 0);
    }
    #endif

    // The OS maximize button enters borderless fullscreen (same as F11), so a
    // maximized game never shows a title bar.
    void OnWindowEvent(int type) {
        // Focus gained/lost events are deliberately ignored: an
        // unfocused-but-visible window keeps rendering at full rate. Only a
        // real minimize stretches the frame deadline (SetIdleFps).
        this.MarkEvent();
        if (type == SdlEventType.WindowMinimized()) { this.SetMinimized(true); }
        if (type == SdlEventType.WindowMaximized()) {
            if (this.ignoreMax) { this.ignoreMax = false; return; }
            if (!this.fullscreen) {
                this.fullscreen = true;
                this.window.SetFullscreen(true);
            }
        }
        if (type == SdlEventType.WindowRestored()) {
            this.ignoreMax = false;
            this.SetMinimized(false);
        }
    }

    void Minimize() { this.window.Minimize(); }

    // Games call this from their event loop after draining input (Host
    // also sets it internally for window events): any input means the
    // next frame should render even if no animation tick is due.
    void MarkEvent() {
        this.hadEvent = true;
    }

    // True when the upcoming frame must actually render: input arrived,
    // the redraw heartbeat came due, or the previous frame was skipped
    // (never skip twice in a row -- keeps vsync latency bounded).
    bool ShouldRender() {
        if (this.redrawMs <= 0) { return true; }
        int now = Sdl.Ticks();
        if (this.hadEvent || now >= this.nextRedraw) {
            this.hadEvent = false;
            this.nextRedraw = now + this.redrawMs;
            return true;
        }
        // Skipped frame: yield the CPU so the poll loop doesn't busy-spin
        // between heartbeats. Short slices keep input latency bounded.
        int slack = this.nextRedraw - now;
        if (slack > 8) { Sdl.Delay(8); }
        return false;
    }

    int MouseX() {
        return this.r.LogicalX(SdlEvent.MouseX(), SdlEvent.MouseY())
            * this.r.ScaleDen() / this.r.ScaleNum();
    }
    int MouseY() {
        return this.r.LogicalY(SdlEvent.MouseX(), SdlEvent.MouseY())
            * this.r.ScaleDen() / this.r.ScaleNum();
    }

    // Sprite-side lookup: the batch bound to this renderer, or null.
    // Games own exactly one Host/renderer, so a linear scan over the live
    // host is fine (called once per batched quad family, not per pixel).
    static SdlSpriteBatch FindBatch(SdlRenderer r) {
        if (liveHost == null) { return null; }
        SdlSpriteBatch b = liveHost.SprBatch();
        if (b == null || b.IsValid() == false) { return null; }
        return b;
    }

    // The host-owned sprite batch (lazy). Null while the renderer is
    // missing, so every caller must tolerate a null return.
    SdlSpriteBatch SprBatch() {
        if (this.sprBatch == null && this.r != null && this.r.IsValid()) {
            this.sprBatch = SdlSpriteBatch.Create(this.r, 1024);
        }
        return this.sprBatch;
    }

    void Begin(int cr, int cg, int cb) {
        if (this.canvas != null && this.canvas.IsValid()) {
            this.r.SetTarget(this.canvas);
        }
        this.r.SetColor(cr, cg, cb, 255);
        this.r.Clear();
        SdlSpriteBatch b = this.SprBatch();
        if (b != null) { b.Begin(); }
    }
    void End() {
        SdlSpriteBatch b = this.sprBatch;
        if (b != null) { b.End(); }
        if (this.canvas != null && this.canvas.IsValid()) {
            this.r.ResetTarget();
            this.r.SetColor(0, 0, 0, 255);
            this.r.Clear();
            // logical units: DrawTexture's Sc() maps them onto the actual
            // canvas raster, whatever its size.
            this.r.DrawTexture(this.canvas, 0, 0, this.logicalW, this.logicalH);
        }
        if (!this.hudMode) {
            // HUD 合成模式下 GameHud.Frame 负责 ReadPixels→SceneUpload→
            // ScenePresent，宿主这里不能自己 Present（会把 HUD 帧挤掉）。
            this.r.Present();
        }
        this.PaceFrame();
        #if PUBLISH
        Guard.Check();
        #endif
    }

    // Set to true by the GameHud bridge: End() then stops presenting, and the
    // compositor owns the final image (scene below, Gui HUD above).
    public bool hudMode;

    void Close() {
        if (this.sprBatch != null) {
            this.sprBatch.Close();
            this.sprBatch = null;
        }
        SysFont.Dispose();
        if (liveHost == this) { liveHost = null; }
        this.window.Close();
        Sdl.Quit();
    }
}

// Pre-baked disc sprites. FillCircle rasterizes one FillRect per native
// scanline, which is very expensive for the hundreds of large circles a
// frame that worm bodies / orbs / particles need. Sprite.Ball draws the same
// visual as a single tinted textured quad from a white disc baked once into
// a render-target texture; Sprite.Glow is a soft radial-falloff halo.
class Sprite {
    static SdlTexture disc;
    static SdlTexture glow;
    static bool baked;

    static int R() { return 96; }   // baked radius, native px

    static void Bake(SdlRenderer r) {
        if (Sprite.baked) { return; }
        Sprite.baked = true;
        int br = Sprite.R();
        int side = br * 2 + 2;
        SdlTexture d = SdlTexture.CreateTarget(r, side, side);
        if (d == null || !d.IsValid()) { return; }
        r.SetTarget(d);
        r.SetBlend(0);
        r.SetColor(255, 255, 255, 0);
        r.Clear();
        r.SetColor(255, 255, 255, 255);
        int dy = -br;
        while (dy <= br) {
            int dx = Draw.Isqrt(br * br - dy * dy);
            r.FillRectRaw(br + 1 - dx, br + 1 + dy, dx * 2 + 1, 1);
            dy = dy + 1;
        }
        d.SetBlendMode(1);
        SdlTexture g = SdlTexture.CreateTarget(r, side, side);
        if (g != null && g.IsValid()) {
            r.SetTarget(g);
            r.SetColor(255, 255, 255, 0);
            r.Clear();
            // radial falloff: stack translucent discs from the rim inward
            r.SetBlend(1);
            int ring = br;
            while (ring >= 4) {
                r.SetColor(255, 255, 255, 26);
                int ry = -ring;
                while (ry <= ring) {
                    int rx = Draw.Isqrt(ring * ring - ry * ry);
                    r.FillRectRaw(br + 1 - rx, br + 1 + ry, rx * 2 + 1, 1);
                    ry = ry + 1;
                }
                ring = ring - br / 12;
            }
            g.SetBlendMode(1);
            Sprite.glow = g;
        }
        r.SetBlend(1);
        r.ResetTarget();
        Sprite.disc = d;
    }

    // Route a tinted textured quad through the host's sprite batch when the
    // renderer is the batch's target renderer; adjacent same-texture quads
    // then collapse into one geometry run. Falls back to the immediate call
    // where no batch exists (plain SdlRenderer consumers).
    static bool QueueBatch(SdlRenderer r, SdlTexture tex,
                           int x, int y, int w, int h,
                           int cr, int cg, int cb, int ca) {
        SdlSpriteBatch b = Host.FindBatch(r);
        if (b == null) { return false; }
        b.Queue(tex, x, y, w, h, 0, 0, 0, 0, cr, cg, cb, ca);
        return true;
    }

    // Solid tinted disc, one draw call. Falls back to scanline FillCircle if
    // baking failed (e.g. render targets unsupported).
    static void Ball(SdlRenderer r, int cx, int cy, int rad,
                     int cr, int cg, int cb, int ca) {
        if (rad <= 0) { return; }
        if (Sprite.disc == null) { Draw.FillCircle(r, cx, cy, rad, cr, cg, cb, ca); return; }
        if (Sprite.QueueBatch(r, Sprite.disc, cx - rad, cy - rad, rad * 2, rad * 2, cr, cg, cb, ca)) { return; }
        Sprite.disc.SetColor(cr, cg, cb);
        Sprite.disc.SetOpacity(ca);
        r.DrawTexture(Sprite.disc, cx - rad, cy - rad, rad * 2, rad * 2);
    }

    // Soft halo disc (alpha fades toward the rim), one draw call.
    static void Glow(SdlRenderer r, int cx, int cy, int rad,
                     int cr, int cg, int cb, int ca) {
        if (rad <= 0) { return; }
        if (Sprite.glow == null) { Sprite.Ball(r, cx, cy, rad, cr, cg, cb, ca); return; }
        if (Sprite.QueueBatch(r, Sprite.glow, cx - rad, cy - rad, rad * 2, rad * 2, cr, cg, cb, ca)) { return; }
        Sprite.glow.SetColor(cr, cg, cb);
        Sprite.glow.SetOpacity(ca);
        r.DrawTexture(Sprite.glow, cx - rad, cy - rad, rad * 2, rad * 2);
    }
}

// Deterministic xorshift RNG (seedable for reproducible shuffles/AI).
class Rng {
    long state;

    static Rng Seed(long s) {
        Rng g = new Rng();
        if (s == 0) { s = 88172645463325252; }
        g.state = s;
        return g;
    }

    long NextLong() {
        long x = this.state;
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        this.state = x;
        return x;
    }

    int Next() {
        long v = this.NextLong();
        if (v < 0) { v = -v; }
        return (int)(v & 2147483647);
    }

    // Uniform integer in [lo, hi).
    int Range(int lo, int hi) {
        if (hi <= lo) { return lo; }
        return lo + this.Next() % (hi - lo);
    }

    // Uniform double in [0, 1).
    double NextDouble01() {
        return (this.Next() & 16777215) / 16777216.0;
    }
}

    // Integer drawing helpers not provided by the SDL wrapper.
    class Draw {
        // Filled rectangle with rounded corners, drawn as one pre-baked nine-slice
        // style texture (baked once per host) scaled over the target rect. This
        // replaces the per-frame scanline rasterization of every panel/button --
        // at 3x supersampling a fullscreen RoundRectFill is 2160 FillRectRaw calls
        // (~4000px wide each); text-heavy games stacking 30+ panels per frame
        // pegged the GPU. Falls back to scanlines only if baking failed.
        static SdlTexture roundTex;
    static bool roundTried;
    static int RP() { return 24; }   // baked corner radius, native px
    static int S() { return 4; }     // bake supersample

    static void EnsureRound(SdlRenderer r) {
        if (Draw.roundTried) { return; }
        Draw.roundTried = true;
        int s = Draw.S();
        int rad = Draw.RP();
        int side = rad * 2 * s;
        SdlTexture t = SdlTexture.CreateTarget(r, side, side);
        if (t == null || !t.IsValid()) { return; }
        r.SetTarget(t);
        r.SetBlend(0);
        r.SetColor(255, 255, 255, 0);
        r.Clear();
        // Supersampled coverage mask for smooth anti-aliased corners. The
        // texel grid is rad*2*s wide; rows are painted full-white, and the
        // alpha ramp comes from the linear downsample when scaled.
        for (int oy = 0; oy < side; oy = oy + 1) {
            double dy = (oy + 0.5) / s - rad;
            double under = rad * rad - dy * dy;
            if (under < 0) { continue; }
            double dxr = rad - Math.Sqrt(under);
            int inset = (int)(dxr * s + 0.5);
            int wid = side - inset * 2;
            if (wid <= 0) { continue; }
            r.SetColor(255, 255, 255, 255);
            r.FillRectRaw(inset, oy, wid, 1);
        }
        t.SetBlendMode(1);
        r.ResetTarget();
        Draw.roundTex = t;
    }

    // Nine-slice draw of the baked rounded rect: corners 1:1, edges stretched,
    // center stretched. The baked texel grid is rad*2*s wide; the top-left
    // corner block (rad*s px native) is the only curved part, everything else
    // samples from the solid middle. All slices source from one quadrant.
    static void RoundTex(SdlRenderer r, int x, int y, int w, int h, int rad,
                         int cr, int cg, int cb, int ca) {
        if (w <= 0 || h <= 0) { return; }
        if (rad * 2 > w) { rad = w / 2; }
        if (rad * 2 > h) { rad = h / 2; }
        if (Draw.roundTex == null || rad != Draw.RP()) {
            // rad != baked radius: nine-slice would distort the corners. The
            // scanline path below handles any radius; guard against mutual
            // recursion by never calling back into RoundRectFill.
            Draw.RoundRectScan(r, x, y, w, h, rad, cr, cg, cb, ca);
            return;
        }
        Draw.roundTex.SetColor(cr, cg, cb);
        Draw.roundTex.SetOpacity(ca);
        int m = Draw.S();
        int R = Draw.RP();          // design corner radius
        int c = R * m;              // native corner block size
        int g = R * 2 * m;          // native texel grid size
        int midW = w - R * 2;
        int midH = h - R * 2;
        // center
        if (midW > 0 && midH > 0) {
            r.DrawTextureRegion(Draw.roundTex, c, c, 2, 2, x + R, y + R, midW, midH);
        }
        // top / bottom edge
        if (midW > 0) {
            r.DrawTextureRegion(Draw.roundTex, c, 0, 2, c, x + R, y, midW, R);
            r.DrawTextureRegion(Draw.roundTex, c, c, 2, c,
                x + R, y + h - R, midW, R);
        }
        // left / right edge
        if (midH > 0) {
            r.DrawTextureRegion(Draw.roundTex, c, c, c, 2, x, y + R, R, midH);
            r.DrawTextureRegion(Draw.roundTex, c, c, c, 2,
                x + w - R, y + R, R, midH);
        }
        // corners: the four native corner blocks of the baked grid
        r.DrawTextureRegion(Draw.roundTex, 0, 0, c, c, x, y, R, R);
        r.DrawTextureRegion(Draw.roundTex, c, 0, c, c, x + w - R, y, R, R);
        r.DrawTextureRegion(Draw.roundTex, 0, c, c, c, x, y + h - R, R, R);
        r.DrawTextureRegion(Draw.roundTex, c, c, c, c, x + w - R, y + h - R, R, R);
        Draw.roundTex.ResetColor();
        Draw.roundTex.SetOpacity(255);
    }

    // Cached 1x-h vertical gradient strip, stretched per draw so a fullscreen
    // gradient costs one textured quad instead of h scanline fills.
    static SdlTexture gradTex;
    static int gradR0 = -1;
    static int gradG0 = -1;
    static int gradB0 = -1;
    static int gradR1 = -1;
    static int gradG1 = -1;
    static int gradB1 = -1;
    static int gradH = -1;

    // One-quad vertical gradient into rect (x,y,w,h). Bakes a 1x-h strip on
    // first use (or when colors/height change) and stretches it -- replaces
    // h FillRect scanlines per frame with a single textured quad.
    static void VGradient(SdlRenderer r, int x, int y, int w, int h,
                          int r0, int g0, int b0, int r1, int g1, int b1, int ca) {
        if (h <= 0) { return; }
        if (Draw.gradTex == null || h != Draw.gradH
            || r0 != Draw.gradR0 || g0 != Draw.gradG0 || b0 != Draw.gradB0
            || r1 != Draw.gradR1 || g1 != Draw.gradG1 || b1 != Draw.gradB1) {
            SdlTexture t = SdlTexture.CreateTarget(r, 1, h);
            if (t != null && t.IsValid()) {
                r.SetTarget(t);
                r.SetBlend(0);
                for (int j = 0; j < h; j = j + 1) {
                    r.SetColor(r0 + (r1 - r0) * j / h,
                               g0 + (g1 - g0) * j / h,
                               b0 + (b1 - b0) * j / h, 255);
                    r.FillRectRaw(0, j, 1, 1);
                }
                t.SetBlendMode(1);
                r.SetBlend(1);
                r.ResetTarget();
                Draw.gradTex = t;
                Draw.gradH = h;
                Draw.gradR0 = r0; Draw.gradG0 = g0; Draw.gradB0 = b0;
                Draw.gradR1 = r1; Draw.gradG1 = g1; Draw.gradB1 = b1;
            }
        }
        if (Draw.gradTex != null && h == Draw.gradH) {
            Draw.gradTex.SetOpacity(ca);
            r.DrawTexture(Draw.gradTex, x, y, w, h);
            Draw.gradTex.SetOpacity(255);
            return;
        }
        // fallback: original scanline path
        for (int j = 0; j < h; j = j + 1) {
            int cr = r0 + (r1 - r0) * j / h;
            int cg = g0 + (g1 - g0) * j / h;
            int cb = b0 + (b1 - b0) * j / h;
            r.SetColor(cr, cg, cb, ca);
            r.FillRect(x, y + j, w, 1);
        }
    }

    static int Isqrt(int n) {
        if (n <= 0) { return 0; }
        int x = n;
        int y = (x + 1) / 2;
        while (y < x) {
            x = y;
            y = (x + n / x) / 2;
        }
        return x;
    }

    static void FillCircle(SdlRenderer r, int cx, int cy, int rad,
                           int cr, int cg, int cb, int ca) {
        if (rad <= 0) { return; }
        // Rasterize at native resolution (after super-scale) so the circle is
        // smooth rather than a scaled-up low-res disc.
        int scx = r.Sc(cx); int scy = r.Sc(cy); int srad = r.Sc(rad);
        r.SetColor(cr, cg, cb, ca);
        int dy = -srad;
        while (dy <= srad) {
            int dx = Draw.Isqrt(srad * srad - dy * dy);
            r.FillRectRaw(scx - dx, scy + dy, dx * 2 + 1, 1);
            dy = dy + 1;
        }
    }

    // Axis-aligned filled ellipse, rasterized at native resolution.
    static void FillEllipse(SdlRenderer r, int cx, int cy, int rx, int ry,
                            int cr, int cg, int cb, int ca) {
        if (rx <= 0 || ry <= 0) { return; }
        int scx = r.Sc(cx); int scy = r.Sc(cy);
        int srx = r.Sc(rx); int sry = r.Sc(ry);
        r.SetColor(cr, cg, cb, ca);
        int dy = -sry;
        while (dy <= sry) {
            int t = sry * sry - dy * dy;
            if (t < 0) { t = 0; }
            int dx = Draw.Isqrt(srx * srx * t) / sry;
            r.FillRectRaw(scx - dx, scy + dy, dx * 2 + 1, 1);
            dy = dy + 1;
        }
    }

    // Filled triangle (any orientation), rasterized at native resolution.
    static void FillTriangle(SdlRenderer r, int ax, int ay, int bx, int by,
                             int ccx, int ccy, int cr, int cg, int cb, int ca) {
        int x0 = r.Sc(ax); int y0 = r.Sc(ay);
        int x1 = r.Sc(bx); int y1 = r.Sc(by);
        int x2 = r.Sc(ccx); int y2 = r.Sc(ccy);
        // sort by y ascending
        if (y1 < y0) { int t; t=x0;x0=x1;x1=t; t=y0;y0=y1;y1=t; }
        if (y2 < y0) { int t; t=x0;x0=x2;x2=t; t=y0;y0=y2;y2=t; }
        if (y2 < y1) { int t; t=x1;x1=x2;x2=t; t=y1;y1=y2;y2=t; }
        r.SetColor(cr, cg, cb, ca);
        int y = y0;
        while (y <= y2) {
            int xa; int xb;
            if (y2 == y0) { xa = x0; xb = x2; }
            else { xa = x0 + (x2 - x0) * (y - y0) / (y2 - y0); }
            if (y < y1) {
                if (y1 == y0) { xb = x1; }
                else { xb = x0 + (x1 - x0) * (y - y0) / (y1 - y0); }
            } else {
                if (y2 == y1) { xb = x2; }
                else { xb = x1 + (x2 - x1) * (y - y1) / (y2 - y1); }
            }
            if (y2 != y0) { xa = x0 + (x2 - x0) * (y - y0) / (y2 - y0); }
            int lo = xa; int hi = xb;
            if (lo > hi) { int t = lo; lo = hi; hi = t; }
            r.FillRectRaw(lo, y, hi - lo + 1, 1);
            y = y + 1;
        }
    }

    static void RingRect(SdlRenderer r, int x, int y, int w, int h, int t,
                         int cr, int cg, int cb, int ca) {
        r.SetColor(cr, cg, cb, ca);
        r.FillRect(x, y, w, t);
        r.FillRect(x, y + h - t, w, t);
        r.FillRect(x, y, t, h);
        r.FillRect(x + w - t, y, t, h);
    }

    static bool PointIn(int px, int py, int x, int y, int w, int h) {
        return px >= x && px < x + w && py >= y && py < y + h;
    }

    // Filled rectangle with rounded corners. Uses the pre-baked nine-slice
    // texture (one quad per slice) when possible; falls back to the scanline
    // rasterizer while baking is unavailable.
    static void RoundRectFill(SdlRenderer r, int x, int y, int w, int h, int rad,
                              int cr, int cg, int cb, int ca) {
        if (w <= 0 || h <= 0) { return; }
        if (rad * 2 > w) { rad = w / 2; }
        if (rad * 2 > h) { rad = h / 2; }
        if (Draw.roundTex != null) {
            Draw.RoundTex(r, x, y, w, h, rad, cr, cg, cb, ca);
            return;
        }
        Draw.RoundRectScan(r, x, y, w, h, rad, cr, cg, cb, ca);
    }

    // Scanline rasterizer for arbitrary radii (also the fallback while the
    // baked nine-slice texture is unavailable).
    static void RoundRectScan(SdlRenderer r, int x, int y, int w, int h, int rad,
                              int cr, int cg, int cb, int ca) {
        if (w <= 0 || h <= 0) { return; }
        if (rad * 2 > w) { rad = w / 2; }
        if (rad * 2 > h) { rad = h / 2; }
        r.SetColor(cr, cg, cb, ca);
        if (rad < 1) { r.FillRect(x, y, w, h); return; }
        int sx = r.Sc(x); int sy = r.Sc(y);
        int sw = r.Sc(x + w) - sx; int sh = r.Sc(y + h) - sy;
        int srad = r.Sc(rad);
        for (int dy = 0; dy < sh; dy = dy + 1) {
            int inset = 0;
            int t = 0;
            if (dy < srad) { t = srad - dy; }
            if (dy > sh - 1 - srad) { t = dy - (sh - 1 - srad); }
            if (t > 0) { inset = srad - Draw.Isqrt(srad * srad - t * t); }
            r.FillRectRaw(sx + inset, sy + dy, sw - inset * 2, 1);
        }
    }

    // Rounded-rectangle ring of thickness t drawn just outside (x,y,w,h)。
    // 旧实现直接 RoundRectFill 外扩矩形,把"描边"画成了实心色块
    // (选中格/悬停高亮整个被糊死)——这里按行扫出真正的环形。
    static void RoundRectStroke(SdlRenderer r, int x, int y, int w, int h, int rad,
                                int t, int cr, int cg, int cb, int ca) {
        if (w <= 0 || h <= 0 || t <= 0) { return; }
        if (rad * 2 > w) { rad = w / 2; }
        if (rad * 2 > h) { rad = h / 2; }
        int sx = r.Sc(x); int sy = r.Sc(y);
        int sw = r.Sc(x + w) - sx; int sh = r.Sc(y + h) - sy;
        int srad = r.Sc(rad);
        int st = r.Sc(t);
        if (st < 1) { st = 1; }
        if (st * 2 >= sh || st * 2 >= sw) {
            Draw.RoundRectFill(r, x, y, w, h, rad, cr, cg, cb, ca);
            return;
        }
        r.SetColor(cr, cg, cb, ca);
        int radin = srad - st;
        if (radin < 0) { radin = 0; }
        int shin = sh - st * 2;
        for (int dy = 0; dy < sh; dy = dy + 1) {
            int tt = 0;
            if (dy < srad) { tt = srad - dy; }
            if (dy > sh - 1 - srad) { tt = dy - (sh - 1 - srad); }
            int inset = 0;
            if (tt > 0) { inset = srad - Draw.Isqrt(srad * srad - tt * tt); }
            if (dy < st || dy >= sh - st) {
                r.FillRectRaw(sx + inset, sy + dy, sw - inset * 2, 1);
                continue;
            }
            int dyin = dy - st;
            int inset2 = st;
            int t2 = 0;
            if (radin > 0) {
                if (dyin < radin) { t2 = radin - dyin; }
                if (dyin > shin - 1 - radin) { t2 = dyin - (shin - 1 - radin); }
                if (t2 > 0) { inset2 = st + radin - Draw.Isqrt(radin * radin - t2 * t2); }
            }
            int lw = inset2 - inset;
            if (lw > 0) {
                r.FillRectRaw(sx + inset, sy + dy, lw, 1);
                r.FillRectRaw(sx + sw - inset2, sy + dy, lw, 1);
            }
        }
    }

    // Bottom-weighted darkening scrim to keep foreground text legible over art.
    static void Scrim(SdlRenderer r, int w, int h) {
        Draw.VGradient(r, 0, 0, w, h, 6, 8, 14, 6, 8, 14, 70);
        Draw.VGradient(r, 0, h * 3 / 5, w, h * 2 / 5, 6, 8, 14, 8, 10, 16, 150);
    }

    static bool PointInCircle(int px, int py, int cx, int cy, int rad) {
        int dx = px - cx; int dy = py - cy;
        return dx * dx + dy * dy <= rad * rad;
    }
}

// Talker: dynamic emotional commentary (praise / taunt / neutral banks).
// Reused across games to raise the "emotional value" — mostly praise, with
// playful jabs. Say() picks a random line from a bank and holds it on screen.
class Talker {
    List<string> praise;
    List<string> taunt;
    List<string> neutral;
    List<string> hype;
    string current;
    int kind;
    long until;
    Rng rng;

    static Talker Create(Rng rng) {
        Talker t = new Talker();
        t.praise = new List<string>();
        t.taunt = new List<string>();
        t.neutral = new List<string>();
        t.hype = new List<string>();
        t.current = "";
        t.kind = 2;
        t.until = 0;
        t.rng = rng;
        return t;
    }

    // bank: 0 praise, 1 taunt, 2 neutral, 3 hype
    void Add(int bank, string line) {
        if (bank == 0) { this.praise.Add(line); }
        else if (bank == 1) { this.taunt.Add(line); }
        else if (bank == 3) { this.hype.Add(line); }
        else { this.neutral.Add(line); }
    }

    List<string> Bank(int bank) {
        if (bank == 0) { return this.praise; }
        if (bank == 1) { return this.taunt; }
        if (bank == 3) { return this.hype; }
        return this.neutral;
    }

    void Say(int bank, int nowMs, int holdMs) {
        List<string> b = this.Bank(bank);
        if (b.Count == 0) { return; }
        this.current = b[this.rng.Range(0, b.Count)];
        this.kind = bank;
        this.until = (long)nowMs + (long)holdMs;
    }

    void SayExact(int bank, string line, int nowMs, int holdMs) {
        this.current = line;
        this.kind = bank;
        this.until = (long)nowMs + (long)holdMs;
    }

    string Current(int nowMs) {
        if ((long)nowMs > this.until) { return ""; }
        return this.current;
    }

    int Kind() { return this.kind; }
}

// UTF-8 decoding over Zan's byte-indexed strings, so game text can mix ASCII
// with CJK. Decode(s, pos) returns the codepoint at pos[0] and advances it.
class Utf8 {
    static int Decode(string s, int[] pos) {
        int i = pos[0];
        int b0 = s[i] & 255;
        if (b0 < 128) { pos[0] = i + 1; return b0; }
        if (b0 >= 240 && i + 3 < s.Length) {
            int cp = ((b0 & 7) << 18) + ((s[i + 1] & 63) << 12)
                   + ((s[i + 2] & 63) << 6) + (s[i + 3] & 63);
            pos[0] = i + 4; return cp;
        }
        if (b0 >= 224 && i + 2 < s.Length) {
            int cp = ((b0 & 15) << 12) + ((s[i + 1] & 63) << 6) + (s[i + 2] & 63);
            pos[0] = i + 3; return cp;
        }
        if (b0 >= 192 && i + 1 < s.Length) {
            int cp = ((b0 & 31) << 6) + (s[i + 1] & 63);
            pos[0] = i + 2; return cp;
        }
        pos[0] = i + 1;
        return 63;
    }
}

// Fixed-cell CJK glyph atlas baked by scripts/bake_cjk_font.py. The metadata
// lists the baked codepoints sorted ascending (binary-searched at draw time);
// any codepoint not in the atlas draws as a hollow box.
class CjkFont {
    static SdlTexture atlas;
    static bool tried;
    static bool ok;
    static int cell;    // design cell (square, layout units)
    static int cols;
    static int scalePx; // atlas px per design unit
    static int count;   // number of baked codepoints
    static int[] cps;   // sorted codepoints (count entries)

    static bool Ready(SdlRenderer r) {
        if (CjkFont.tried) { return CjkFont.ok; }
        CjkFont.tried = true;
        string metaPath = Assets.FindCommon("cjk_font.txt");
        if (!File.Exists(metaPath)) { return false; }
        SdlTexture t = SdlTexture.LoadImage(r, Assets.FindCommon("cjk_font.png"));
        if (t == null || !t.IsValid()) { return false; }
        t.SetNearest(false);
        t.SetBlendMode(1);
        string meta = File.ReadAllText(metaPath);
        int[] pos = new int[1];
        pos[0] = 0;
        CjkFont.cell = GlyphFont.NextInt(meta, pos);
        CjkFont.cols = GlyphFont.NextInt(meta, pos);
        CjkFont.scalePx = GlyphFont.NextInt(meta, pos);
        int n = GlyphFont.NextInt(meta, pos);
        if (n <= 0) { return false; }
        CjkFont.count = n;
        CjkFont.cps = new int[n];
        for (int i = 0; i < n; i = i + 1) {
            CjkFont.cps[i] = GlyphFont.NextInt(meta, pos);
        }
        CjkFont.atlas = t;
        CjkFont.ok = true;
        return true;
    }

    static int Index(int cp) {
        int lo = 0;
        int hi = CjkFont.count - 1;
        while (lo <= hi) {
            int mid = (lo + hi) / 2;
            if (CjkFont.cps[mid] == cp) { return mid; }
            if (CjkFont.cps[mid] < cp) { lo = mid + 1; } else { hi = mid - 1; }
        }
        return -1;
    }

    static int Advance(int scale) { return (CjkFont.cell + 2) * scale / 6; }

    static void DrawGlyph(SdlRenderer r, int cp, int x, int y, int scale) {
        int gi = CjkFont.Index(cp);
        int dw = CjkFont.cell * scale / 6;
        // vertically center within the ASCII cell height (57 design units)
        int dy = y + (57 - CjkFont.cell) * scale / 12;
        if (gi < 0) {
            r.DrawRect(x + scale / 2, dy + scale / 2, dw - scale, dw - scale);
            return;
        }
        int m = CjkFont.scalePx;
        int scw = CjkFont.cell * m;
        int col = gi % CjkFont.cols;
        int row = gi / CjkFont.cols;
        r.DrawTextureRegion(CjkFont.atlas, col * scw, row * scw, scw, scw,
            x, dy, dw, dw);
    }
}

// System-font text pipeline: rasterizes a whole run through zan_gui's native
// text engine (GDI ClearType on Windows, FreeType on Linux/Android) into an
// offscreen surface, uploads it once into a cached streaming texture, and
// blits that like any other atlas. Every character the system font covers
// renders correctly (full CJK, any size, no bake step), unlike the fixed
// CjkFont atlas which only knows the codepoints that were scanned at bake
// time. Caches are keyed (text, scale): rasterization + upload happen once,
// steady frames only pay the blit. The two surface slots ping-pong so a
// cache miss reuses whichever slot the previous miss used.
//
// Colour is baked at draw time via SetColor/opacity on the white-glyph
// texture, matching the GlyphFont/CjkFont convention.
class SysFont {
    [DllImport("zan_gui")]
    static extern int zan_gui_create_surface(int width, int height);
    [DllImport("zan_gui")]
    static extern void zan_gui_destroy_surface(int surfaceId);
    [DllImport("zan_gui")]
    static extern void zan_gui_clear(int surfaceId, int color);
    [DllImport("zan_gui")]
    static extern void zan_gui_draw_text(
        int surfaceId, int x, int y, string text, int color, int fontSize);
    [DllImport("zan_gui")]
    static extern int zan_gui_measure_text(string text, int fontSize);
    [DllImport("zan_gui")]
    static extern int zan_gui_font_height(int fontSize);
    [DllImport("zan_gui")]
    static extern nint zan_gui_get_pixels(int surfaceId);

    // One cache entry: the rasterized run as a GPU texture + its layout box.
    class SysRun {
        public string text;
        public int scale;
        public SdlTexture tex;
        public int drawW;   // measured run width (px at this scale)
        public int drawH;   // font line height (px at this scale)
        public int padX;    // surface padding subtracted from drawX
        public int padY;    // surface padding subtracted from drawY
        public long lastUsed;
    }

    static bool tried;
    static bool ok;
    static List<SysRun> runs;
    static List<string> keys;   // parallel to runs: "scale\x01text"
    const int MAX_RUNS = 96;    // cached textures (96 ≈ one busy frame's labels)
    static int surfA = -1;      // scratch surface A
    static int surfB = -1;      // scratch surface B
    static bool useA;
    const int PAD = 6;          // surface margin: ClearType bleed + tile.top
    static long tick;
    // scale → pixel font size. GameKit's design grid is 57 units per cell at
    // scale/6 (GlyphFont cellH=57, scale 2 ≈ 19px), so px = scale * 14 lands
    // 2 号 at ~28px and keeps 1 号 readable.
    static int PxOf(int scale) { return scale * 14; }

    static void CopyPixels(nint src, string dst, int bytes) {
        // GetString copies the raw RGBA buffer into one ARC-managed string
        // whose bytes SdlTexture.Update then hands straight to SDL.
        string s = NativeMemory.GetString(src, 0, bytes);
        for (int i = 0; i < bytes; i = i + 1) {
            dst[i] = s[i];
        }
    }

    /// True once zan_gui.dll is loadable and a probe run rasterized; false
    /// means the caller should fall back to the atlas pipeline.
    static bool Ready(SdlRenderer r) {
        if (SysFont.tried) { return SysFont.ok; }
        SysFont.tried = true;
        SysFont.runs = new List<SysRun>();
        SysFont.keys = new List<string>();
        int s = SysFont.CreateSurface(512, 96);
        if (s >= 0) {
            SysFont.useA = true;
            SysFont.ok = true;
        }
        return SysFont.ok;
    }

    static int CreateSurface(int w, int h) {
        int s = zan_gui_create_surface(w, h);
        if (s >= 0) { zan_gui_clear(s, 0); }
        return s;
    }

    static string Key(string text, int scale) {
        return Convert.ToString(scale) + "\x01" + text;
    }

    static SysRun Find(string key) {
        for (int i = 0; i < SysFont.keys.Count; i = i + 1) {
            if (SysFont.keys[i] == key) { return SysFont.runs[i]; }
        }
        return null;
    }

    /// Rasterize `text` at `scale` into the scratch surface and upload it as
    /// a cached texture. Returns the run or null on failure.
    static SysRun Bake(SdlRenderer r, string text, int scale) {
        int px = SysFont.PxOf(scale);
        int w = zan_gui_measure_text(text, px);
        if (w <= 0) { return null; }
        int h = zan_gui_font_height(px);
        if (h <= 0) { return null; }
        int sw = w + SysFont.PAD * 2;
        int sh = h + SysFont.PAD * 2;
        if (!SysFont.useA) {
            if (SysFont.surfB < 0) { SysFont.surfB = SysFont.CreateSurface(sw, sh); }
            if (SysFont.surfB < 0) { return null; }
            zan_gui_clear(SysFont.surfB, 0);
        } else {
            if (SysFont.surfA < 0) { SysFont.surfA = SysFont.CreateSurface(sw, sh); }
            if (SysFont.surfA < 0) { return null; }
            zan_gui_clear(SysFont.surfA, 0);
        }
        int surf = SysFont.useA ? SysFont.surfA : SysFont.surfB;
        zan_gui_draw_text(surf, SysFont.PAD, SysFont.PAD, text, -1, px);
        nint pix = zan_gui_get_pixels(surf);
        if (pix == 0) { return null; }

        SdlTexture tex = SdlTexture.CreateRgba32(r, sw, sh, true);
        if (tex == null || !tex.IsValid()) { return null; }
        // The native buffer is exactly sw*sh bytes of RGBA; SdlTexture.Update
        // byte-addresses its 'pixels' string, so build one from the raw
        // surface buffer.
        string buf = new string('\0', sw * sh * 4);
        SysFont.CopyPixels(pix, buf, sw * sh * 4);
        if (!tex.Update(buf, sw * 4)) { tex.Close(); return null; }
        tex.SetNearest(false);
        tex.SetBlendMode(1);

        SysFont.tick = SysFont.tick + 1;
        SysRun run = new SysRun();
        run.text = text;
        run.scale = scale;
        run.tex = tex;
        run.drawW = w;
        run.drawH = h;
        run.padX = SysFont.PAD;
        run.padY = SysFont.PAD;
        run.lastUsed = SysFont.tick;
        if (SysFont.runs.Count >= SysFont.MAX_RUNS) {
            // Evict the least recently used entry (and free its texture).
            int victim = 0;
            for (int i = 1; i < SysFont.runs.Count; i = i + 1) {
                if (SysFont.runs[i].lastUsed < SysFont.runs[victim].lastUsed) {
                    victim = i;
                }
            }
            SysFont.runs[victim].tex.Close();
            SysFont.runs.RemoveAt(victim);
            SysFont.keys.RemoveAt(victim);
        }
        SysFont.runs.Add(run);
        SysFont.keys.Add(SysFont.Key(text, scale));
        SysFont.useA = !SysFont.useA;
        return run;
    }

    /// Run width in pixels at `scale` (measurement only; no texture touched).
    static int Measure(string text, int scale) {
        if (text == null || text.Length == 0) { return 0; }
        if (scale < 1) { scale = 1; }
        int px = SysFont.PxOf(scale);
        int w = zan_gui_measure_text(text, px);
        if (w > 0) { return w; }
        return 0;
    }

    /// Font line height in pixels at `scale` (for row layout math).
    static int LineHeight(int scale) {
        if (scale < 1) { scale = 1; }
        int h = zan_gui_font_height(SysFont.PxOf(scale));
        return h > 0 ? h : scale * 20;
    }

    /// Draw `text` with its top-left at (x, y) — same contract as
    /// GlyphFont.Draw (y is the top of the line box, not the baseline).
    static void Draw(SdlRenderer r, string text, int x, int y, int scale,
                     int cr, int cg, int cb, int ca) {
        if (text == null || text.Length == 0) { return; }
        if (scale < 1) { scale = 1; }
        string key = SysFont.Key(text, scale);
        SysRun run = SysFont.Find(key);
        if (run == null) {
            run = SysFont.Bake(r, text, scale);
            if (run == null) { return; }
        }
        SysFont.tick = SysFont.tick + 1;
        run.lastUsed = SysFont.tick;
        run.tex.SetColor(cr, cg, cb);
        run.tex.SetOpacity(ca);
        SdlSpriteBatch b = Host.FindBatch(r);
        if (b != null) {
            b.Queue(run.tex, x - run.padX, y - run.padY,
                run.drawW + run.padX * 2, run.drawH + run.padY * 2,
                0, 0, run.drawW + run.padX * 2, run.drawH + run.padY * 2,
                cr, cg, cb, ca);
            b.End();
            b.Begin();
            return;
        }
        r.DrawTexture(run.tex, x - run.padX, y - run.padY,
            run.drawW + run.padX * 2, run.drawH + run.padY * 2);
    }

    /// Free every cached texture (called on Host teardown).
    static void Dispose() {
        if (SysFont.runs != null) {
            for (int i = 0; i < SysFont.runs.Count; i = i + 1) {
                SysFont.runs[i].tex.Close();
            }
        }
        SysFont.runs = null;
        SysFont.keys = null;
        if (SysFont.surfA >= 0) { zan_gui_destroy_surface(SysFont.surfA); }
        if (SysFont.surfB >= 0) { zan_gui_destroy_surface(SysFont.surfB); }
        SysFont.surfA = -1;
        SysFont.surfB = -1;
        SysFont.ok = false;
        SysFont.tried = false;
    }
}

class Text {
    static void Draw(SdlRenderer r, string text, int x, int y, int scale,
                     int cr, int cg, int cb, int ca) {
        if (text == null) { return; }
        if (scale < 1) { scale = 1; }
        // System font first: every codepoint the OS font covers renders
        // (full CJK, any size). The atlas pipeline below is the fallback and
        // the deliberate "pixel look" option.
        if (SysFont.Ready(r)) {
            SysFont.Draw(r, text, x, y, scale, cr, cg, cb, ca);
            return;
        }
        if (GlyphFont.Ready(r)) {
            if (Text.HasWide(text) && CjkFont.Ready(r)) {
                Text.DrawMixed(r, text, x, y, scale, cr, cg, cb, ca);
                return;
            }
            GlyphFont.Draw(r, text, x, y, scale, cr, cg, cb, ca);
            return;
        }
        r.SetColor(cr, cg, cb, ca);
        Text.DrawBitmap(r, text, x, y, scale);
    }

    static bool HasWide(string text) {
        for (int i = 0; i < text.Length; i = i + 1) {
            if ((text[i] & 255) > 127) { return true; }
        }
        return false;
    }

    // Mixed ASCII + CJK draw: ASCII comes from the antialiased GlyphFont
    // atlas, everything else from the CjkFont atlas, on one shared pen.
    // Batched variant: glyph quads from both atlases queue with per-quad
    // tint; the whole label is one ordered group flushed at the end, so
    // painter order against the surrounding immediate draws is unchanged.
    static void DrawMixed(SdlRenderer r, string text, int x, int y, int scale,
                          int cr, int cg, int cb, int ca) {
        SdlSpriteBatch b = Host.FindBatch(r);
        if (b != null) {
            int pen = x;
            int[] pos = new int[1];
            pos[0] = 0;
            while (pos[0] < text.Length) {
                int cp = Utf8.Decode(text, pos);
                if (cp >= 32 && cp <= 126) {
                    int gi = cp - 32;
                    int m = GlyphFont.atlasScale;
                    int scw = GlyphFont.cellW * m;
                    int sch = GlyphFont.cellH * m;
                    int dw = GlyphFont.cellW * scale / 6;
                    int dh = GlyphFont.cellH * scale / 6;
                    if (gi >= 0 && gi < 95) {
                        b.QueueRegion(GlyphFont.atlas,
                            (gi % GlyphFont.cols) * scw, (gi / GlyphFont.cols) * sch,
                            scw, sch, pen, y, dw, dh, cr, cg, cb, ca);
                    }
                    pen = pen + GlyphFont.adv[gi >= 0 && gi < 95 ? gi : 0] * scale / 6;
                } else {
                    int gi = CjkFont.Index(cp);
                    int dw = CjkFont.cell * scale / 6;
                    int dy = y + (57 - CjkFont.cell) * scale / 12;
                    if (gi >= 0) {
                        int m = CjkFont.scalePx;
                        int scw = CjkFont.cell * m;
                        b.QueueRegion(CjkFont.atlas,
                            (gi % CjkFont.cols) * scw, (gi / CjkFont.cols) * scw,
                            scw, scw, pen, dy, dw, dw, cr, cg, cb, ca);
                    } else {
                        // missing glyph placeholder is an immediate draw;
                        // flush what queued so far to keep pen order
                        b.End();
                        b.Begin();
                        r.SetColor(cr, cg, cb, ca);
                        r.DrawRect(pen + scale / 2, dy + scale / 2, dw - scale, dw - scale);
                    }
                    pen = pen + CjkFont.Advance(scale);
                }
            }
            b.End();
            b.Begin();
            return;
        }
        GlyphFont.atlas.SetColor(cr, cg, cb);
        GlyphFont.atlas.SetOpacity(ca);
        CjkFont.atlas.SetColor(cr, cg, cb);
        CjkFont.atlas.SetOpacity(ca);
        r.SetColor(cr, cg, cb, ca);
        int pen2 = x;
        int[] pos2 = new int[1];
        pos2[0] = 0;
        while (pos2[0] < text.Length) {
            int cp = Utf8.Decode(text, pos2);
            if (cp >= 32 && cp <= 126) {
                pen2 = pen2 + GlyphFont.DrawGlyph(r, cp - 32, pen2, y, scale);
            } else {
                CjkFont.DrawGlyph(r, cp, pen2, y, scale);
                pen2 = pen2 + CjkFont.Advance(scale);
            }
        }
        GlyphFont.atlas.ResetColor();
        GlyphFont.atlas.SetOpacity(255);
        CjkFont.atlas.ResetColor();
        CjkFont.atlas.SetOpacity(255);
    }

    static int MeasureMixed(string text, int scale) {
        int w = 0;
        int[] pos = new int[1];
        pos[0] = 0;
        while (pos[0] < text.Length) {
            int cp = Utf8.Decode(text, pos);
            if (cp >= 32 && cp <= 126) {
                w = w + GlyphFont.adv[cp - 32] * scale / 6;
            } else {
                w = w + CjkFont.Advance(scale);
            }
        }
        return w;
    }

    static void DrawBitmap(SdlRenderer r, string text, int x, int y, int scale) {
        int cx = x;
        for (int i = 0; i < text.Length; i = i + 1) {
            int cp = text[i] & 255;
            for (int ry = 0; ry < 8; ry = ry + 1) {
                int mask = Font.Row(cp, ry);
                for (int rx = 0; rx < 8; rx = rx + 1) {
                    if ((mask & (1 << (7 - rx))) != 0) {
                        r.FillRect(cx + rx * scale, y + ry * scale, scale, scale);
                    }
                }
            }
            cx = cx + Font.Advance() * scale;
        }
    }

    static void DrawCentered(SdlRenderer r, string text, int centerX, int y,
                             int scale, int cr, int cg, int cb, int ca) {
        int w = Text.Width(r, text, scale);
        Text.Draw(r, text, centerX - w / 2, y, scale, cr, cg, cb, ca);
    }

    static int Width(SdlRenderer r, string text, int scale) {
        if (SysFont.Ready(r)) {
            int w = SysFont.Measure(text, scale);
            if (w > 0) { return w; }
            return 0;
        }
        if (GlyphFont.Ready(r)) {
            if (Text.HasWide(text) && CjkFont.Ready(r)) {
                return Text.MeasureMixed(text, scale);
            }
            return GlyphFont.Measure(text, scale);
        }
        return Font.Measure(text, scale);
    }

    // Text with a soft drop shadow for legibility over rich backgrounds.
    // 尾参是主文字透明度 ca;阴影偏移随字号取小值。历史调用点传的 255 曾被
    // 当成偏移量,导致每段文字都在 (+255,+255) 处画出一个 45% 黑的重影。
    static void DrawShadow(SdlRenderer r, string text, int x, int y, int scale,
                           int cr, int cg, int cb, int ca) {
        int so = 2 + scale;
        Text.Draw(r, text, x + so, y + so, scale, 0, 0, 0, 150);
        Text.Draw(r, text, x, y, scale, cr, cg, cb, ca);
    }

    static void DrawCenteredShadow(SdlRenderer r, string text, int centerX, int y,
                                   int scale, int cr, int cg, int cb, int ca) {
        int w = Text.Width(r, text, scale);
        Text.DrawShadow(r, text, centerX - w / 2, y, scale, cr, cg, cb, ca);
    }
}

// Shared, polished UI kit: frosted panels, three-state stroked buttons, and a
// cover-fitted background image. Used by every game menu so they share one
// refined look instead of flat programmer-art rectangles.
class Ui {
    // Draw a background texture stretched to fully cover the logical canvas,
    // then a legibility scrim on top.
    static void Backdrop(SdlRenderer r, SdlTexture bg, int w, int h) {
        if (bg != null) {
            r.DrawTexture(bg, 0, 0, w, h);
        } else {
            Draw.VGradient(r, 0, 0, w, h, 18, 22, 32, 8, 10, 16, 255);
        }
        Draw.Scrim(r, w, h);
    }

    // Bake a decorative background (gradient + scattered stars) into a target
    // texture once; games blit it every frame for one draw call instead of
    // hundreds of scanline fills. Return null when render targets are
    // unavailable, in which case callers should fall back to VGradient.
    static SdlTexture BakeBackdrop(SdlRenderer r, int w, int h, Rng rng,
                                   int topR, int topG, int topB,
                                   int botR, int botG, int botB, int stars) {
        SdlTexture t = SdlTexture.CreateTarget(r, w, h);
        if (t == null || !t.IsValid()) { return null; }
        r.SetTarget(t);
        Draw.VGradient(r, 0, 0, w, h, topR, topG, topB, botR, botG, botB, 255);
        for (int i = 0; i < stars; i = i + 1) {
            int sx = rng.Range(0, w);
            int sy = rng.Range(0, h * 2 / 3);
            int b = rng.Range(30, 130);
            r.SetColor(200, 205, 255, b);
            r.FillRect(sx, sy, 2, 2);
        }
        r.ResetTarget();
        return t;
    }

    // Frosted translucent rounded panel with a hairline border.
    static void Panel(SdlRenderer r, int x, int y, int w, int h,
                      int cr, int cg, int cb, int ca) {
        Draw.RoundRectStroke(r, x, y, w, h, 14, 1, 255, 255, 255, 22);
        Draw.RoundRectFill(r, x, y, w, h, 14, cr, cg, cb, ca);
        // top sheen
        Draw.RoundRectFill(r, x + 2, y + 2, w - 4, h / 3, 12, 255, 255, 255, 12);
    }

    // Three-state stroked, glossy rounded button. kind: 0 normal, 1 accent,
    // 2 selected. Returns true when hovered.
    static bool Button(SdlRenderer r, int mx, int my, int x, int y, int w, int h,
                       string label, int scale, int kind) {
        bool hov = Draw.PointIn(mx, my, x, y, w, h);
        // body mid color + darker bottom shade, chosen per state
        int mr = 58; int mg = 64; int mb = 80;
        int dr = 30; int dg = 34; int db = 46;
        int tc = 236;
        if (kind == 1) {
            mr = 52; mg = 138; mb = 92; dr = 30; dg = 96; db = 62;
            if (hov) { mr = 64; mg = 162; mb = 108; }
        } else if (kind == 2) {
            mr = 224; mg = 176; mb = 66; dr = 196; dg = 146; db = 40;
            tc = 36;
        } else if (hov) {
            mr = 74; mg = 82; mb = 102; dr = 42; dg = 48; db = 62;
        }
        int rad = 12;
        if (hov) {
            int gr = 120; int gg = 180; int gb = 240;
            if (kind == 1) { gr = 120; gg = 230; gb = 170; }
            if (kind == 2) { gr = 250; gg = 210; gb = 110; }
            Draw.RoundRectFill(r, x - 5, y - 5, w + 10, h + 10, rad + 5, gr, gg, gb, 55);
        }
        // dark border, then rounded body on top (true rim, does not cover body)
        Draw.RoundRectFill(r, x - 2, y - 2, w + 4, h + 4, rad + 2, 8, 10, 16, 240);
        Draw.RoundRectFill(r, x, y, w, h, rad, mr, mg, mb, 255);
        // bottom shade + top sheen for a glossy read
        Draw.RoundRectFill(r, x + 2, y + h / 2, w - 4, h / 2 - 3, rad, dr, dg, db, 150);
        Draw.RoundRectFill(r, x + 3, y + 3, w - 6, h / 2 - 3, rad, 255, 255, 255, 38);
        Text.DrawCenteredShadow(r, label, x + w / 2, y + h / 2 - 4 * scale, scale, tc, tc, tc, 255);
        return hov;
    }
}

// ---------------------------------------------------------------------------
// PackedAssets -- encrypted resource pack (.zrp) consumer layer.
//
// Ships game assets as a single AES-256-GCM encrypted, RSA-signed .zrp next
// to the exe instead of a plaintext assets/ tree. Entries are addressed by
// project-relative names ("assets/ui/panel.png"), which is the same shape as
// Assets.Find's rel -- the {id, file} indirection lives in the entry names
// themselves, no extra manifest at runtime.
//
// Key handling follows the respack_roundtrip pattern: the master key is the
// XOR of two shares, each injected at build time (pack_game.ps1 --embed two
// share files, or const hex strings in a generated KeyShares.zan). The real
// key is reassembled in memory at Open() and never appears as a single
// literal in the binary.
//
// NOTE: this raises the bar (no plaintext on disk, no single key literal,
// per-entry HKDF keys so one leak doesn't cascade), it is NOT absolute
// protection -- a memory dump or debugger can still capture the decrypted
// buffers. Combine with Guard.Arm() (System.Security) for the debugger side;
// the full threat model lives in the arpg resource-engineering doc.
// ---------------------------------------------------------------------------
class PackedAssets {
    ResourcePack pack;

    PackedAssets() {
        this.pack = null;
    }

    /// <summary>Open a .zrp and authenticate its index.
    /// Both shares are 64-char hex strings (32 bytes each); the real key is
    /// their XOR, reassembled here and never stored as one literal.
    /// Throws IOException when the pack can't be read/authenticated:
    ///   "pack: io/magic"    (1) not a .zrp or truncated
    ///   "pack: auth"        (2) wrong master key (index failed GCM)
    ///   "pack: signature"   (3) index signature mismatch (repacked/tampered)
    /// </summary>
    public static PackedAssets Open(string packPath, string shareAHex, string shareBHex) {
        byte[] shareA = Hex.Decode(shareAHex);
        byte[] shareB = Hex.Decode(shareBHex);
        byte[] master = ResourcePack.MixKey(shareA, shareB, 32);
        // Open/Write 的 masterKey 形参是 string（字节缓冲）。ToStr 是
        // 内建转换，把 byte[] 内容拷成独立的 string 缓冲（mini2.zan
        // 路径对比：ToStr 与 Hex.Decode(keyHex) 同字节同结果，
        // count=2/err=0 完全一致；Runtime/irgen_expr.c:232）。
        return PackedAssets.OpenKeyed(packPath, master.ToStr(0, 32));
    }

    /// <summary>Open with an already-assembled master key (32 bytes as a
    /// byte buffer). Same error contract as <see cref="Open"/>.</summary>
    public static PackedAssets OpenKeyed(string packPath, string masterKey) {
        PackedAssets pa = new PackedAssets();
        List<int> err = new List<int>();
        err.Add(0);
        ResourcePack p = ResourcePack.Open(packPath, masterKey, null, null, err);
        if (p == null) {
            if (err[0] == 2) { throw new IOException("pack: auth (wrong master key?)"); }
            if (err[0] == 3) { throw new IOException("pack: signature"); }
            throw new IOException("pack: io/magic (" + packPath + ")");
        }
        pa.pack = p;
        return pa;
    }

    /// <summary>Open a SIGNED .zrp (packed with --sign-n/--sign-d) and
    /// authenticate AND signature-check its index before serving anything.
    /// Games that ship signed packs should use this: a stolen master key
    /// alone is then not enough to swap entries — the pack must be re-signed
    /// with the private key. The verify key (RSA modulus/exponent hex) is
    /// public material and may live in the binary — it's meant to be seen.
    /// <paramref name="nHex"/>/<paramref name="eHex"/> = public modulus and
    /// exponent (hex). Error contract is <see cref="Open"/>'s, plus:
    ///   "pack: signature"   (3) index signature missing/mismatched
    ///   (an unsigned pack is rejected too — signature is required here).</summary>
    public static PackedAssets OpenVerified(string packPath, string shareAHex,
        string shareBHex, string nHex, string eHex) {
        byte[] shareA = Hex.Decode(shareAHex);
        byte[] shareB = Hex.Decode(shareBHex);
        byte[] master = ResourcePack.MixKey(shareA, shareB, 32);
        // ToStr 拷出 masterKey（byte[]→string 隐式传参只在调用实参位置安全）。
        return PackedAssets.OpenKeyedVerified(packPath, master.ToStr(0, 32), nHex, eHex);
    }

    /// <summary>OpenVerified with an already-assembled master key (32 bytes
    /// as a byte buffer). Same error contract as <see cref="OpenVerified"/>.
    /// </summary>
    public static PackedAssets OpenKeyedVerified(string packPath, string masterKey,
        string nHex, string eHex) {
        PackedAssets pa = new PackedAssets();
        List<int> err = new List<int>();
        err.Add(0);
        ResourcePack p = ResourcePack.Open(packPath, masterKey, nHex, eHex, err);
        if (p == null) {
            if (err[0] == 2) { throw new IOException("pack: auth (wrong master key?)"); }
            if (err[0] == 3) { throw new IOException("pack: signature"); }
            throw new IOException("pack: io/magic (" + packPath + ")");
        }
        pa.pack = p;
        return pa;
    }

    /// <summary>Raw entry bytes. Throws IOException when the name is not in
    /// the pack or the payload fails GCM authentication (tampered).</summary>
    public byte[] Read(string name) {
        List<int> len = new List<int>();
        len.Add(0);
        byte[] data = this.pack.Read(name, len);
        if (data == null) { throw new IOException("pack: missing/tampered " + name); }
        return data;
    }

    /// <summary>Decode a PNG/JPEG entry straight from the decrypted bytes to
    /// a texture -- nothing touches the disk. Invalid handle (check
    /// IsValid()) when the bytes aren't a decodable image.</summary>
    public SdlTexture LoadImage(SdlRenderer renderer, string name) {
        byte[] data = this.Read(name);
        // ToStr 拷出为调用实参（native 侧只在本调用内同步读 buffer）。
        return SdlTexture.LoadImageFromMem(renderer, data.ToStr(0, data.Length), data.Length);
    }

    /// <summary>Parse a WAV entry straight from the decrypted bytes -- the
    /// PCM is copied out inside the call, nothing touches the disk. Invalid
    /// handle when the bytes aren't a WAV.</summary>
    public SdlAudioClip LoadWav(string name) {
        byte[] data = this.Read(name);
        // ToStr 拷出为调用实参（PCM 在调用内被拷出，见 Audio.zan 契约）。
        return SdlAudioClip.LoadWavFromMem(data.ToStr(0, data.Length), data.Length);
    }

    /// <summary>Entry existence probe (no decryption).</summary>
    public bool Contains(string name) { return this.pack.Contains(name); }

    /// <summary>Number of entries in the pack.</summary>
    public int Count() { return this.pack.Count(); }

    /// <summary>Byte size of one entry (no decryption), -1 when unknown.</summary>
    public int SizeOf(string name) { return this.pack.SizeOf(name); }
}

// ---------------------------------------------------------------------------
// KeyShares -- build-time master-key halves for PackedAssets.
//
// pack_game.ps1 (or a project's build script) generates two hex share files
// and embeds them with --embed; each game declares its own subclass supplying
// the two embedded paths. The XOR of the shares IS the master key, so the
// binary never contains the assembled key -- only its two independent halves.
//
// Games that prefer explicit code can instead hand their own hex literals to
// PackedAssets.Open(); KeyShares.File() is just the file-backed variant.
// ---------------------------------------------------------------------------
class KeyShares {
    /// <summary>Read one 64-char hex share from a file (typically an
    /// --embed'd copy, so File.ReadAllBytes finds it without a real file on
    /// disk). Trims whitespace/newlines.</summary>
    public static string File(string path) {
        byte[] raw = System.IO.File.ReadAllBytes(path);
        string s = raw.ToStr(0, raw.Length);
        // Trim whitespace and line breaks at both ends (builders write "\n").
        int start = 0;
        int end = s.Length;
        while (start < end && KeyShares.SpaceAt(s, start)) { start = start + 1; }
        while (end > start && KeyShares.SpaceAt(s, end - 1)) { end = end - 1; }
        return s.Substring(start, end - start);
    }

    static bool SpaceAt(string s, int i) {
        int c = s[i] & 255;
        return c == 32 || c == 9 || c == 10 || c == 13;
    }
}
