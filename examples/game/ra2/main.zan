using System;
using System.IO;
using SDL3;

namespace Ra2;

// Entry point. Boots SDL3, verifies the user's original RA2 install is present
// under data/, and runs the scene loop. Assets are never redistributed: the
// player supplies their own copy of the game.
class Ra2App {
    static string DataDir() { return "examples/game/ra2/data"; }

    // Returns the name of the first required archive that is missing, or "".
    static string MissingArchive() {
        if (!File.Exists(Ra2App.DataDir() + "/ra2.mix")) { return "ra2.mix"; }
        if (!File.Exists(Ra2App.DataDir() + "/language.mix")) { return "language.mix"; }
        if (!File.Exists(Ra2App.DataDir() + "/multi.mix")) { return "multi.mix"; }
        return "";
    }

    static void Main() {
        string missing = Ra2App.MissingArchive();
        if (missing != "") {
            Console.WriteLine("missing asset archive: " + missing);
            Console.WriteLine("place your Red Alert 2 install in " + Ra2App.DataDir());
            return;
        }
        Console.WriteLine("assets found in " + Ra2App.DataDir());
    }
}
