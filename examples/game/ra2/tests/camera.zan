// Camera: pan/zoom bookkeeping over a terrain far larger than the window.
//
// Pure arithmetic, no game data and no SDL. The clamp cases matter most: a
// camera that can scroll past the terrain shows a black band, and one that
// clamps a too-small map to the corner puts it off-centre.
using System;
using System.Collections.Generic;
using Ra2.Render;

namespace T;

class Program {
    static void Show(string label, Camera c) {
        Console.WriteLine(label + "=" + Convert.ToString(c.X()) + ","
            + Convert.ToString(c.Y())
            + " zoom=" + Convert.ToString(c.ZoomNum()) + ":"
            + Convert.ToString(c.ZoomDen())
            + " span=" + Convert.ToString(c.SpanW()) + "x"
            + Convert.ToString(c.SpanH()));
    }

    static void Main() {
        // A window onto a map much wider than it is tall, like a real one.
        Camera c = Camera.Create(1280, 720, 6300, 2865);
        Show("start", c);

        // Panning stops at the terrain edge rather than running off it.
        c.MoveBy(-99999, -99999);
        Show("topleft", c);
        c.MoveBy(99999, 99999);
        Show("botright", c);

        // Zooming out doubles the visible span; zooming in halves it.
        c.MoveBy(-99999, -99999);
        c.ZoomBy(-1);
        Show("zoomout", c);
        c.ZoomBy(1);
        Show("zoom11", c);
        c.ZoomBy(1);
        Show("zoomin", c);
        // Zoom is capped at both ends.
        c.ZoomBy(1);
        Show("zoomin_cap", c);
        c.ZoomBy(-1);
        c.ZoomBy(-1);
        c.ZoomBy(-1);
        Show("zoomout_cap", c);

        // Zoom keeps the centre of the view fixed. From a known centred
        // position, zooming in then out must land back where it started.
        Camera z = Camera.Create(1280, 720, 6300, 2865);
        int sx = z.X();
        int sy = z.Y();
        z.ZoomBy(1);
        z.ZoomBy(-1);
        Console.WriteLine("roundtrip=" + Convert.ToString(z.X() == sx && z.Y() == sy));

        // A terrain smaller than the view on both axes is centred, which puts
        // the origin negative -- the draw code letterboxes rather than
        // clamping the map into the corner.
        Camera small = Camera.Create(1280, 720, 400, 300);
        Show("small", small);
        small.MoveBy(500, 500);
        Show("small_pan", small);

        // Exactly-fitting terrain sits at the origin and cannot scroll.
        Camera exact = Camera.Create(1280, 720, 1280, 720);
        Show("exact", exact);
        exact.MoveBy(50, 50);
        Show("exact_pan", exact);
    }
}
