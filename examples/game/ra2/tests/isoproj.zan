// Isometric projection: cell space <-> screen pixels.
//
// Pure arithmetic, no game data. The round-trip cases matter most: mouse
// picking inverts the projection, and an off-by-one there selects the
// neighbouring cell.
using System;
using System.Collections.Generic;
using Ra2.Render;

namespace T;

class Program {
    static void Fwd(string label, int x, int y, int level) {
        Console.WriteLine(label + "=" + Convert.ToString(IsoProjection.ScreenX(x, y))
            + "," + Convert.ToString(IsoProjection.ScreenY(x, y, level)));
    }

    static void Inv(string label, int sx, int sy) {
        List<int> xy = new List<int>();
        IsoProjection.CellAt(sx, sy, xy);
        Console.WriteLine(label + "=" + Convert.ToString(xy[0])
            + "," + Convert.ToString(xy[1]));
    }

    // Every cell must survive cell -> screen -> cell. The sample point is the
    // centre of the diamond, which sits half a tile *below* the apex and not
    // to the right of it: ScreenX/ScreenY return the apex, and the diamond
    // spreads symmetrically around it on the x axis.
    static void RoundTrip(int x, int y) {
        int sx = IsoProjection.ScreenX(x, y);
        int sy = IsoProjection.ScreenY(x, y, 0);
        List<int> xy = new List<int>();
        IsoProjection.CellAt(sx, sy + IsoProjection.HalfH(), xy);
        if (xy[0] != x || xy[1] != y) {
            Console.WriteLine("roundtrip FAIL " + Convert.ToString(x) + ","
                + Convert.ToString(y) + " -> " + Convert.ToString(xy[0])
                + "," + Convert.ToString(xy[1]));
        }
    }

    static void Main() {
        Console.WriteLine("tile=" + Convert.ToString(IsoProjection.TileW())
            + "x" + Convert.ToString(IsoProjection.TileH()));

        // Origin sits at 0,0; x runs lower-right, y lower-left.
        Program.Fwd("c00", 0, 0, 0);
        Program.Fwd("c10", 1, 0, 0);
        Program.Fwd("c01", 0, 1, 0);
        Program.Fwd("c11", 1, 1, 0);
        // Both axes push down, so (1,1) is directly below (0,0) by one tile.
        Program.Fwd("c22", 2, 2, 0);

        // Elevation lifts the tile without moving it horizontally.
        Program.Fwd("lvl0", 5, 5, 0);
        Program.Fwd("lvl1", 5, 5, 1);
        Program.Fwd("lvl10", 5, 5, 10);

        // A real map's starting positions, to confirm the spread is sane.
        Program.Fwd("start0", 57, 98, 0);
        Program.Fwd("start2", 152, 96, 0);

        // Inverse: ScreenX/ScreenY give a cell's apex, so the diamond's centre
        // is half a tile straight down from it.
        Program.Inv("i_centre", 0, 15);
        Program.Inv("i_origin", 0, 0);
        // (30,15) is the apex of cell (1,0), not the centre of (0,0).
        Program.Inv("i_right", 30, 15);
        // Negative screen space is left of the origin -- cell y grows there.
        Program.Inv("i_left", -30, 15);

        // Exhaustive round-trip over a patch spanning the origin, including
        // negative cells (the map's bounding box starts at 0 but the camera
        // can scroll past it).
        int x = -20;
        while (x <= 20) {
            int y = -20;
            while (y <= 20) {
                Program.RoundTrip(x, y);
                y = y + 1;
            }
            x = x + 1;
        }
        Console.WriteLine("roundtrip done");
    }
}
