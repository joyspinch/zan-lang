// Recovery of the Blowfish key from an encrypted MIX header.
//
// Clean-room: the only real datum here is Westwood's *public* key, which ships
// in every copy of the game and is published in every open MIX tool. The
// ciphertext is synthetic -- picked so both 40-byte blocks decode to values
// that fit in 39 bytes, which is the case the header format relies on.
using System;
using Ra2.Formats;

namespace T;

class Program {
    [DllImport("crt")] static extern string calloc(int count, int size);

    // Takes the character's code, not the character: passing a char where a
    // string is declared makes the callee index it as a pointer.
    static int HexVal(int v) {
        if (v >= 48 && v <= 57) { return v - 48; }
        return (v - 97) + 10;
    }

    static string FromHex(string hex, int byteLen) {
        string buf = calloc(byteLen + 1, 1);
        int i = 0;
        while (i < byteLen) {
            int hi = Program.HexVal(hex[i * 2] & 0xFF);
            int lo = Program.HexVal(hex[i * 2 + 1] & 0xFF);
            buf[i] = (char)((hi << 4) | lo);
            i = i + 1;
        }
        return buf;
    }

    // Substring is the way to turn an indexed byte back into a string: `str +
    // buf[i]` would append the numeric value, not the character.
    static string Hex(string buf, int len) {
        string digits = "0123456789abcdef";
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < len) {
            int b = buf[i] & 0xFF;
            sb.Append(digits.Substring((b >> 4) & 0x0F, 1));
            sb.Append(digits.Substring(b & 0x0F, 1));
            i = i + 1;
        }
        return sb.ToString();
    }

    static void Main() {
        // The public modulus, so a base64/ASN.1 decoding regression is caught
        // without depending on the RSA step.
        Console.WriteLine("modbits=" + Convert.ToString(WsKey.ModulusBitLength()));
        Console.WriteLine("modlen=" + Convert.ToString(WsKey.ModulusByteLength()));
        Console.WriteLine("exp=" + Convert.ToString(WsKey.Exponent()));

        string src = Program.FromHex(
            "3a99b8d7f61534537291b0cfee0d2c4b6a89a8c7e60524436281a0bfdefd1c3b"
            + "5a7998b7d6f51433025364758697a8b9cadbecfd0e1f30415263748596a7b8c9d"
            + "aebfc0d1e2f405162738495a6b7c8d9", 80);
        string key = WsKey.Decrypt(src, 0);
        Console.WriteLine("key=" + Program.Hex(key, 56));
    }
}
