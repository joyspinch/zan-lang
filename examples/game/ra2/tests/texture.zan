// Texture: palette-indexed to RGBA conversion and compositing.
//
// Clean-room: the palette and index buffers below are built here. Index 0 is
// checked to stay transparent regardless of the colour sitting in slot 0,
// because RA2 art relies on that everywhere.
using System;
using System.Collections.Generic;
using Ra2.Assets;
using Ra2.Formats;

namespace T;

class Program {
    [DllImport("crt")] static extern string calloc(int count, int size);

    // A 768-byte palette whose entry i is (i, i*2, i*3) truncated to 6-bit
    // channels, so Scale8's expansion to 8-bit shows up in the output.
    static Palette BuildPalette() {
        string raw = Program.calloc(768 + 1, 1);
        int i = 0;
        while (i < 256) {
            raw[i * 3] = (char)(i & 0x3F);
            raw[i * 3 + 1] = (char)((i * 2) & 0x3F);
            raw[i * 3 + 2] = (char)((i * 3) & 0x3F);
            i = i + 1;
        }
        return Palette.Parse(raw, 768);
    }

    static string Hex8(int v) {
        string digits = "0123456789abcdef";
        StringBuilder sb = new StringBuilder();
        int shift = 28;
        while (shift >= 0) {
            sb.Append(digits.Substring((v >> shift) & 0x0F, 1));
            shift = shift - 4;
        }
        return sb.ToString();
    }

    static void Main() {
        Palette pal = Program.BuildPalette();

        // A 3x2 image. Slot 0 appears twice and must come out transparent even
        // though the palette has a real colour there.
        string idx = Program.calloc(6 + 1, 1);
        idx[0] = (char)0;
        idx[1] = (char)1;
        idx[2] = (char)2;
        idx[3] = (char)0;
        idx[4] = (char)63;
        idx[5] = (char)255;

        Texture t = Texture.FromIndexed(idx, 3, 2, pal);
        Console.WriteLine("size=" + Convert.ToString(t.Width())
            + "x" + Convert.ToString(t.Height()));
        Console.WriteLine("bytes=" + Convert.ToString(t.ByteLength()));

        // 0xAARRGGBB per pixel, row-major.
        int y = 0;
        while (y < 2) {
            int x = 0;
            while (x < 3) {
                Console.WriteLine("px" + Convert.ToString(x) + Convert.ToString(y)
                    + "=" + Program.Hex8(t.PixelAt(x, y)));
                x = x + 1;
            }
            y = y + 1;
        }

        // Out-of-bounds reads are 0 rather than a crash or a wrapped pixel.
        Console.WriteLine("oob_neg=" + Program.Hex8(t.PixelAt(-1, 0)));
        Console.WriteLine("oob_far=" + Program.Hex8(t.PixelAt(3, 0)));

        // Blit composites: transparent source pixels leave the destination
        // alone, opaque ones overwrite it.
        string bg = Program.calloc(12 + 1, 1);
        int i = 0;
        while (i < 12) {
            bg[i] = (char)7;
            i = i + 1;
        }
        Texture dst = Texture.FromIndexed(bg, 4, 3, pal);
        dst.Blit(t, 1, 1);
        Console.WriteLine("dst_untouched=" + Program.Hex8(dst.PixelAt(0, 0)));
        // (1,1) receives source (0,0), which is transparent -> background kept.
        Console.WriteLine("dst_kept=" + Program.Hex8(dst.PixelAt(1, 1)));
        // (2,1) receives source (1,0) = index 1 -> overwritten.
        Console.WriteLine("dst_over=" + Program.Hex8(dst.PixelAt(2, 1)));

        // A blit landing partly outside the destination clips instead of
        // writing past the buffer.
        dst.Blit(t, 3, 2);
        Console.WriteLine("dst_clip=" + Program.Hex8(dst.PixelAt(3, 2)));

        t.Close();
        Console.WriteLine("closed_w=" + Convert.ToString(t.Width()));
        dst.Close();
    }
}
