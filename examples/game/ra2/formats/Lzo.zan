using System;
using System.Collections.Generic;

namespace Ra2.Formats;

// LZO1X decompression. Despite the "Format5" name its chunks share with
// Format80, the map packs (IsoMapPack5, OverlayPack, OverlayDataPack) are
// LZO1X-compressed, not LCW -- a real IsoMapPack5 chunk begins with a byte
// that LCW would read as a back-reference at output position 0.
//
// The algorithm is a state machine over three instruction shapes:
//   - a literal run, whose length is either packed into the low bits of the
//     opcode or spelled out as a chain of zero bytes plus a remainder;
//   - a match, copying an earlier stretch of output, with the distance split
//     across the opcode and one or two following bytes;
//   - the two trailing bits of a match's last distance byte, which carry the
//     length of a short literal run that follows it directly.
//
// Matches may overlap the write cursor -- that is how runs are encoded -- so
// the copy loops must stay byte-at-a-time.
class Lzo {

    /// <summary>Decompresses into a fresh buffer of at most destCap bytes.
    /// The decoded length is written to outLen[0].</summary>
    static byte[] Decompress(string src, int srcStart, int srcLen, int destCap, List<int> outLen) {
        byte[] dest = new byte[destCap + 1];
        int n = Lzo.DecompressInto(src, srcStart, srcLen, dest, destCap);
        Format80.SetOut(outLen, n);
        return dest;
    }

    /// <summary>Decompresses into a caller-supplied buffer and returns the
    /// number of bytes written. A malformed stream truncates rather than
    /// running off either buffer.</summary>
    static int DecompressInto(string src, int srcStart, int srcLen, byte[] dest, int destCap) {
        int ip = srcStart;
        int end = srcStart + srcLen;
        int op = 0;
        int t = 0;
        int m = 0;

        // The state machine is expressed as an explicit state variable because
        // the original is a web of gotos that does not map onto structured
        // control flow. 0 = top, 1 = after-literal, 2 = match, 3 = match-done,
        // 4 = short-literal-after-match.
        int state = 0;

        if (ip < end && (src[ip] & 0xFF) > 17) {
            t = (src[ip] & 0xFF) - 17;
            ip = ip + 1;
            if (t < 4) {
                state = 4;
            } else {
                while (t > 0 && op < destCap && ip < end) {
                    dest[op] = (byte)(src[ip] & 0xFF);
                    op = op + 1;
                    ip = ip + 1;
                    t = t - 1;
                }
                state = 1;
            }
        }

        while (true) {
            if (state == 0) {
                if (ip >= end) { return op; }
                t = src[ip] & 0xFF;
                ip = ip + 1;
                if (t >= 16) { state = 2; continue; }
                if (t == 0) {
                    while (ip < end && (src[ip] & 0xFF) == 0) {
                        t = t + 255;
                        ip = ip + 1;
                    }
                    if (ip >= end) { return op; }
                    t = t + 15 + (src[ip] & 0xFF);
                    ip = ip + 1;
                }
                // Three bytes always precede the counted run.
                for (int k = 0; k < 3 && op < destCap && ip < end; k = k + 1) {
                    dest[op] = (byte)(src[ip] & 0xFF);
                    op = op + 1;
                    ip = ip + 1;
                }
                while (t > 0 && op < destCap && ip < end) {
                    dest[op] = (byte)(src[ip] & 0xFF);
                    op = op + 1;
                    ip = ip + 1;
                    t = t - 1;
                }
                state = 1;
                continue;
            }

            if (state == 1) {
                if (ip >= end) { return op; }
                t = src[ip] & 0xFF;
                ip = ip + 1;
                if (t >= 16) { state = 2; continue; }
                if (ip >= end) { return op; }
                m = op - (1 + 0x0800) - (t >> 2) - ((src[ip] & 0xFF) << 2);
                ip = ip + 1;
                if (m < 0) { return op; }
                for (int k = 0; k < 3 && op < destCap; k = k + 1) {
                    dest[op] = (byte)(dest[m] & 0xFF);
                    op = op + 1;
                    m = m + 1;
                }
                state = 3;
                continue;
            }

            if (state == 2) {
                bool shortMatch = false;
                if (t >= 64) {
                    if (ip >= end) { return op; }
                    m = op - 1 - ((t >> 2) & 7) - ((src[ip] & 0xFF) << 3);
                    ip = ip + 1;
                    t = (t >> 5) - 1;
                } else if (t >= 32) {
                    t = t & 31;
                    if (t == 0) {
                        while (ip < end && (src[ip] & 0xFF) == 0) {
                            t = t + 255;
                            ip = ip + 1;
                        }
                        if (ip >= end) { return op; }
                        t = t + 31 + (src[ip] & 0xFF);
                        ip = ip + 1;
                    }
                    if (ip + 1 >= end) { return op; }
                    m = op - 1 - (((src[ip] & 0xFF) >> 2) + ((src[ip + 1] & 0xFF) << 6));
                    ip = ip + 2;
                } else if (t >= 16) {
                    m = op - ((t & 8) << 11);
                    t = t & 7;
                    if (t == 0) {
                        while (ip < end && (src[ip] & 0xFF) == 0) {
                            t = t + 255;
                            ip = ip + 1;
                        }
                        if (ip >= end) { return op; }
                        t = t + 7 + (src[ip] & 0xFF);
                        ip = ip + 1;
                    }
                    if (ip + 1 >= end) { return op; }
                    m = m - (((src[ip] & 0xFF) >> 2) + ((src[ip + 1] & 0xFF) << 6));
                    ip = ip + 2;
                    // A match that would start exactly at the cursor is the
                    // end-of-stream marker, not a copy.
                    if (m == op) { return op; }
                    m = m - 0x4000;
                } else {
                    if (ip >= end) { return op; }
                    m = op - 1 - (t >> 2) - ((src[ip] & 0xFF) << 2);
                    ip = ip + 1;
                    if (m < 0) { return op; }
                    for (int k = 0; k < 2 && op < destCap; k = k + 1) {
                        dest[op] = (byte)(dest[m] & 0xFF);
                        op = op + 1;
                        m = m + 1;
                    }
                    shortMatch = true;
                }

                if (!shortMatch) {
                    if (m < 0) { return op; }
                    for (int k = 0; k < 2 && op < destCap; k = k + 1) {
                        dest[op] = (byte)(dest[m] & 0xFF);
                        op = op + 1;
                        m = m + 1;
                    }
                    while (t > 0 && op < destCap) {
                        dest[op] = (byte)(dest[m] & 0xFF);
                        op = op + 1;
                        m = m + 1;
                        t = t - 1;
                    }
                }
                state = 3;
                continue;
            }

            if (state == 3) {
                // The low two bits of the distance byte just consumed give the
                // length of a literal run that follows without its own opcode.
                if (ip - 2 < srcStart) { return op; }
                t = src[ip - 2] & 3;
                if (t == 0) { state = 0; continue; }
                state = 4;
            }

            if (state == 4) {
                while (t > 0 && op < destCap && ip < end) {
                    dest[op] = (byte)(src[ip] & 0xFF);
                    op = op + 1;
                    ip = ip + 1;
                    t = t - 1;
                }
                if (ip >= end) { return op; }
                t = src[ip] & 0xFF;
                ip = ip + 1;
                state = 2;
                continue;
            }
        }
        return op;
    }
}
