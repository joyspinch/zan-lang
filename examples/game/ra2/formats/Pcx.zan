using System;
using System.Collections.Generic;

namespace Ra2.Formats;

// A PCX image -- the format RA2 stores its shell art in (menu backdrops,
// side-select screens, loading screens).
//
// Only the 8-bit, single-plane, RLE-encoded variant is handled, because that
// is what the game ships; anything else parses to a zero-sized image rather
// than guessing.
//
// Layout (little-endian):
//   header(128) : manufacturer(u8=10), version(u8), encoding(u8=1),
//                 bpp(u8), xmin/ymin/xmax/ymax(u16 each), hdpi/vdpi(u16),
//                 egaPalette(48), reserved(u8), planes(u8),
//                 bytesPerLine(u16), paletteInfo(u16), filler(58)
//   body        : RLE runs -- a byte with the top two bits set is a count of
//                 (byte & 0x3F) repeats of the next byte; anything else is a
//                 literal. Runs never cross a scanline.
//   tail(769)   : 0x0C then a 256-entry RGB palette, 8 bits per channel.
class PcxImage {

    int width;
    int height;
    byte[] indices;     // width*height palette indices
    byte[] palette;     // 768 raw RGB bytes
    bool hasPalette;

    static PcxImage Parse(string data, int length) {
        PcxImage p = new PcxImage();
        p.width = 0;
        p.height = 0;
        p.indices = null;
        p.palette = null;
        p.hasPalette = false;
        if (length < 128) { return p; }
        if ((data[0] & 0xFF) != 10) { return p; }     // not a PCX
        if ((data[2] & 0xFF) != 1) { return p; }      // not RLE
        if ((data[3] & 0xFF) != 8) { return p; }      // not 8-bit
        if ((data[65] & 0xFF) != 1) { return p; }     // not single-plane

        int xmin = (data[4] & 0xFF) | ((data[5] & 0xFF) << 8);
        int ymin = (data[6] & 0xFF) | ((data[7] & 0xFF) << 8);
        int xmax = (data[8] & 0xFF) | ((data[9] & 0xFF) << 8);
        int ymax = (data[10] & 0xFF) | ((data[11] & 0xFF) << 8);
        int w = xmax - xmin + 1;
        int h = ymax - ymin + 1;
        if (w <= 0 || h <= 0) { return p; }
        int bytesPerLine = (data[66] & 0xFF) | ((data[67] & 0xFF) << 8);
        if (bytesPerLine <= 0) { bytesPerLine = w; }

        p.width = w;
        p.height = h;
        p.indices = new byte[w * h + 1];

        // Decode row by row. bytesPerLine can exceed the visible width (rows
        // are padded to an even length), and the padding has to be consumed
        // rather than written, or every row after the first is skewed.
        int at = 128;
        int y = 0;
        while (y < h && at < length) {
            int x = 0;
            while (x < bytesPerLine && at < length) {
                int b = data[at] & 0xFF;
                at = at + 1;
                int count = 1;
                int pixel = b;
                if ((b & 0xC0) == 0xC0) {
                    count = b & 0x3F;
                    if (at >= length) { break; }
                    pixel = data[at] & 0xFF;
                    at = at + 1;
                }
                int i = 0;
                while (i < count && x < bytesPerLine) {
                    if (x < w) { p.indices[y * w + x] = (byte)pixel; }
                    x = x + 1;
                    i = i + 1;
                }
            }
            y = y + 1;
        }

        // The palette is the last 769 bytes, introduced by 0x0C.
        if (length >= 769) {
            int tail = length - 769;
            if ((data[tail] & 0xFF) == 12) {
                p.palette = new byte[768 + 1];
                p.hasPalette = true;
                int i = 0;
                while (i < 768) {
                    p.palette[i] = (byte)(data[tail + 1 + i] & 0xFF);
                    i = i + 1;
                }
            }
        }
        return p;
    }

    int Width() { return this.width; }
    int Height() { return this.height; }
    bool IsValid() { return this.width > 0 && this.height > 0; }
    byte[] Indices() { return this.indices; }

    /// <summary>The image's own palette. PCX palettes are already 8-bit per
    /// channel, unlike the 6-bit .pal files the terrain uses.</summary>
    bool HasPalette() { return this.hasPalette; }

    int R(int index) { return this.Channel(index, 0); }
    int G(int index) { return this.Channel(index, 1); }
    int B(int index) { return this.Channel(index, 2); }

    int Channel(int index, int comp) {
        if (!this.hasPalette) { return 0; }
        if (index < 0 || index > 255) { return 0; }
        return this.palette[index * 3 + comp] & 0xFF;
    }

    int IndexAt(int x, int y) {
        if (x < 0 || y < 0 || x >= this.width || y >= this.height) { return 0; }
        return this.indices[y * this.width + x] & 0xFF;
    }

    void Close() {
        this.indices = null;
        this.palette = null;
        this.hasPalette = false;
        this.width = 0;
        this.height = 0;
    }
}
