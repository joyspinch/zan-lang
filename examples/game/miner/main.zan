    public SdlRenderer r;
    public Game g;
    public Snd snd;
    public Rng uiRng;

    public int mouseX;
    public int mouseY;
    public bool mouseDown;
    public long now;             // SDL ticks ms
    public long lastStepAt;      // Step() 上次执行的墙钟(真实 dt 用)
    public double simAccum;

    // UI 状态
    public int page;             // 0 矿井 1 矿队 2 深渊(轮回) 3 设置
    public int[] viewLv;         // 每类矿工当前升级档(轮换显示 3 项)
    public int floatPage;        // 0 无 1 圣物 2 强化 3 星盘 4 事件 5 装备背包
    public int selRelic;
    public int equipPage;        // 装备背包当前页
    public int equipHover;       // 装备背包悬停索引(-1 无),详情跟随展示
    public double offlineGain;   // >0 时开场弹离线结算
    public string offlineText;
    // 启动画面:加载纹理前先画 splash,纹理就绪后淡出进主界面
    public long splashBorn;      // splash 出现时刻(SDL ticks ms)
    public int splashMin = 1400; // 最短展示 ms(点击/按键可提前)
    public long splashStage;     // 0=画 splash 1=已结束
    public SdlTexture bg;        // 烘焙背景(渐变+星点)
