    public SdlTexture texBtnGoldHi; // 悬停金钮底(增亮变体)
    public SdlTexture texBarTrough; // 血条槽
    public SdlTexture texBarFill;   // 血条填充
    public SdlTexture texRowStone;  // 列表行石条
    public SdlTexture texSplashBg;  // 启动画面背景
    public SdlTexture texTitlePlate;// 启动画面标题铭牌
    public SdlTexture texLoadBar;   // 启动画面加载条
    public SdlTexture texChrome;    // 标题栏石板条
    public SdlTexture texWinGlyphs; // 最小化/最大化/关闭 字形图(384x128 三格)
    public SdlTexture texSocket;    // 星盘空槽(圆形凹座)
    public SdlTexture texGem;       // 白宝石(可染色:星盘点亮/圣物品质球)
    public SdlTexture[] texEquip;   // 40 枚装备图标(8 槽位×5 品阶,大图切图)

    public static int W() { return 1280; }
    public static int H() { return 720; }

    // 加载 assets 下的图片纹理;缺失或解码失败返回 null,调用方走矢量回退。
    static SdlTexture LoadTex(SdlRenderer r, string path) {
        string p = Assets.Find(path);
        if (!File.Exists(p)) { return null; }
        SdlTexture t = SdlTexture.LoadImage(r, p);
        if (t == null || !t.IsValid()) { return null; }
        t.SetNearest(false);
        t.SetBlendMode(1);
        return t;
    }

    // ---- 九宫格绘制(源为 3x3 满铺格子:四角含圆角+金饰实块,四边为
    // 边框带,中心为整块带纹理的内域) ----
    // 经典九宫语义:角块 1:1 缩到 k 显示 px(金线/圆角/铆钉不变形);
    // 边带从源四边整条取样横向/纵向拉伸(保留边框纹理走向);
    // 中心取样整块内域 (k..cell-k)² 缩放到内区——中心自带石纹/金属纹,
    // 不再是纯色矩形。矮面板自动收紧 k,防止角块重叠。
    static void NineImg(SdlRenderer r, SdlTexture tex, int tw, int th, int cell,
                        int k, int x, int y, int w, int h) {
        if (w <= 0 || h <= 0) { return; }
        int maxK = w / 2; if (maxK > h / 2) { maxK = h / 2; }
        if (maxK > cell / 2) { maxK = cell / 2; }
        if (k > maxK) { k = maxK; }
        if (k < 2) { k = 2; }
        int mid = cell - k * 2;    // 源内域边长
        if (mid < 4) { mid = 4; }
        int mx = x + k; int my = y + k;
        int mw = w - k * 2; int mh = h - k * 2;
        int e0 = cell - k;         // 右/下边带源起点
        // 中心:整块内域(带纹理)缩放铺满
        if (mw > 0 && mh > 0) {
            r.DrawTextureRegion(tex, k, k, mid, mid, mx, my, mw, mh);
        }
        // 四边带:整条取样拉伸(不串角饰)
        if (mw > 0) {
            r.DrawTextureRegion(tex, k, 0, mid, k, mx, y, mw, k);
            r.DrawTextureRegion(tex, k, e0, mid, k, mx, y + h - k, mw, k);
        }
        if (mh > 0) {
            r.DrawTextureRegion(tex, 0, k, k, mid, x, my, k, mh);
            r.DrawTextureRegion(tex, e0, k, k, mid, x + w - k, my, k, mh);
        }
        // 四角:源角块(含圆角+金饰)1:1 缩到 k
        r.DrawTextureRegion(tex, 0, 0, k, k, x, y, k, k);
        r.DrawTextureRegion(tex, e0, 0, k, k, x + w - k, y, k, k);
        r.DrawTextureRegion(tex, 0, e0, k, k, x, y + h - k, k, k);
        r.DrawTextureRegion(tex, e0, e0, k, k, x + w - k, y + h - k, k, k);
        _ = tw; _ = th;
    }

    // 槽+比例填充条(血条/进度条通用):槽整绘,填充按 p 从左截源宽。
    // 缺纹理回退 false,调用方走矢量。
    static bool DrawTrough(SdlRenderer r, SdlTexture trough, SdlTexture fill,
                           int x, int y, int w, int h, double p) {
        return MinerApp.DrawTroughSrc(r, trough, 768, 96, fill, x, y, w, h, p);
    }

    // 变长版:trough 源宽任意(如 load_bar 1024x72),填充按 p 截同宽源。
    static bool DrawTroughSrc(SdlRenderer r, SdlTexture trough, int tsw, int tsh,
                              SdlTexture fill, int x, int y, int w, int h, double p) {
        if (trough == null || !trough.IsValid() || fill == null || !fill.IsValid()) {
            return false;
        }
        if (p < 0) { p = 0; }
        if (p > 1) { p = 1; }
        r.DrawTexture(trough, x, y, w, h);
        int fw = (int)(w * p);
        if (fw > 0) {
            int sw = (int)(tsw * p);
            if (sw < 1) { sw = 1; }
            r.DrawTextureRegion(fill, 0, 0, sw, tsh, x, y, fw, h);
        }
        return true;
    }

    // ---- 布局常量(复用点击区与绘制) ----
    // 左列 x=24..856, 右列 x=880..1256
    public static int LX() { return 24; }
    public static int LW() { return 832; }
    public static int RX() { return 880; }
    public static int RW() { return 376; }

    public static MinerApp Create(Host h) {
        MinerApp a = new MinerApp();
        a.host = h;
        a.r = h.Renderer();
        a.uiRng = Rng.Seed(20260830);
        a.g = Game.New();
        a.page = 0;
        a.floatPage = 0;
        a.viewLv = new int[6];
        a.selRelic = 0;
        a.equipPage = 0;
        a.equipHover = -1;
        a.offlineText = "";
        a.snd = Snd.Create(true);
        // 石板九宫格 + 板材质:Th.texPanel 注入后所有面板统一换肤
        Th.texPanel = MinerApp.LoadTex(a.r, "examples/game/miner/assets/panel_nine.png");
        a.texBanner = MinerApp.LoadTex(a.r, "examples/game/miner/assets/banner.png");
        a.texBtnGold = MinerApp.LoadTex(a.r, "examples/game/miner/assets/btn_gold.png");
        a.texBtnDark = MinerApp.LoadTex(a.r, "examples/game/miner/assets/btn_dark.png");
        a.texBtnDarkHi = MinerApp.LoadTex(a.r, "examples/game/miner/assets/btn_dark_hi.png");
        a.texBtnGoldHi = MinerApp.LoadTex(a.r, "examples/game/miner/assets/btn_gold_hi.png");
        a.texBarTrough = MinerApp.LoadTex(a.r, "examples/game/miner/assets/bar_trough.png");
        a.texBarFill = MinerApp.LoadTex(a.r, "examples/game/miner/assets/bar_fill.png");
        a.texRowStone = MinerApp.LoadTex(a.r, "examples/game/miner/assets/row_stone.png");
        a.texSplashBg = MinerApp.LoadTex(a.r, "examples/game/miner/assets/splash_bg.jpg");
        a.texTitlePlate = MinerApp.LoadTex(a.r, "examples/game/miner/assets/title_plate.png");
        a.texLoadBar = MinerApp.LoadTex(a.r, "examples/game/miner/assets/load_bar.png");
        a.texChrome = MinerApp.LoadTex(a.r, "examples/game/miner/assets/bar_chrome.png");
        a.texWinGlyphs = MinerApp.LoadTex(a.r, "examples/game/miner/assets/win_glyphs.png");
        a.texSocket = MinerApp.LoadTex(a.r, "examples/game/miner/assets/astro_socket.png");
        a.texGem = MinerApp.LoadTex(a.r, "examples/game/miner/assets/astro_gem_w.png");
        a.texBg = MinerApp.LoadTex(a.r, "examples/game/miner/assets/bg_mine.jpg");
        a.texDim = MinerApp.LoadTex(a.r, "examples/game/miner/assets/dim_bg.jpg");
        a.texMobNormal = MinerApp.LoadTex(a.r, "examples/game/miner/assets/monster_normal.png");
        a.texMobBoss = MinerApp.LoadTex(a.r, "examples/game/miner/assets/monster_boss.png");
        a.texIcon = new SdlTexture[5];
        string[] iconFiles = new string[] { "icon_iron.png", "icon_copper.png", "icon_gold.png", "icon_crystal.png", "icon_core.png" };
        for (int i = 0; i < 5; i = i + 1) {
            a.texIcon[i] = MinerApp.LoadTex(a.r, "examples/game/miner/assets/" + iconFiles[i]);
        }
        a.texCrew = new SdlTexture[6];
        string[] crewFiles = new string[] { "crew_miner.png", "crew_rogue.png", "crew_shaman.png", "crew_bomber.png", "crew_giant.png", "crew_occult.png" };
        for (int i = 0; i < 6; i = i + 1) {
            a.texCrew[i] = MinerApp.LoadTex(a.r, "examples/game/miner/assets/" + crewFiles[i]);
        }
        a.texTab = new SdlTexture[4];
        string[] tabFiles = new string[] { "ui_tab_mine.png", "ui_tab_crew.png", "ui_tab_abyss.png", "ui_tab_set.png" };
        for (int i = 0; i < 4; i = i + 1) {
            a.texTab[i] = MinerApp.LoadTex(a.r, "examples/game/miner/assets/" + tabFiles[i]);
        }
        a.texRelic = MinerApp.LoadTex(a.r, "examples/game/miner/assets/ui_relic.png");
        a.texForge = MinerApp.LoadTex(a.r, "examples/game/miner/assets/ui_forge.png");
        a.texPrestige = MinerApp.LoadTex(a.r, "examples/game/miner/assets/ui_prestige.png");
        // 装备图标 40 枚:equip_c{type}_t{tier}.png(8 槽位×5 品阶)
        a.texEquip = new SdlTexture[40];
        for (int c = 0; c < 8; c = c + 1) {
            for (int t = 0; t < 5; t = t + 1) {
                a.texEquip[c * 5 + t] = MinerApp.LoadTex(a.r,
                    "examples/game/miner/assets/equip_c" + c + "_t" + t + ".png");
            }
        }
        return a;
    }

    public void AfterLoad() {
        this.g.dispHp = this.g.monsterHp;
        if (this.g.offlineGain > 0) {
            this.offlineText = "离线 " + Game.FmtDur(this.g.offlineGain) + " 结算完成";
            this.g.offlineGain = 0;
        }
    }

    // ---------------- 模拟步进 ----------------

    public void Step() {
        // dt 按真实墙钟走:循环在事件驱动重绘下会空转、会被跳帧,固定
        // 16ms 会把模拟时间跑快。用上一帧到现在的时间差,上限 100ms 防止
        // 卡顿后的追帧爆发。
        double dtMs = (double)(this.now - this.lastStepAt);
        this.lastStepAt = this.now;
        if (dtMs < 0) { dtMs = 0; }
        if (dtMs > 100) { dtMs = 100; }
        if (dtMs > 0) {
            this.simAccum = this.simAccum + dtMs / 1000.0;
            if (this.simAccum >= 0.2) {
                this.g.Tick(this.simAccum, true);
                this.simAccum = 0;
            }
        }
        // 血条平滑
        if (this.g.dispHp > this.g.monsterHp) {
            double k = this.g.dispHp - this.g.monsterHp;
            if (k > this.g.MonsterMaxHp() * 0.5) { this.g.dispHp = this.g.monsterHp; }
            else { this.g.dispHp = this.g.dispHp - this.g.dispHp * 3.0 * dtMs / 1000; }
            if (this.g.dispHp < this.g.monsterHp) { this.g.dispHp = this.g.monsterHp; }
        } else { this.g.dispHp = this.g.monsterHp; }
        // 自动存档 30s
        if ((this.now / 1000) % 30 == 0 && this.now % 1000 < 20) {
            this.g.SaveGame();
        }
    }

    // ---------------- 绘制辅助 ----------------

    void TextC(string t, int cx, int y, int scale, int cr, int cg, int cb, int ca) {
        Text.DrawCentered(this.r, t, cx, y, scale, cr, cg, cb, ca);
    }
    void TextCSh(string t, int cx, int y, int scale, int cr, int cg, int cb) {
        Text.DrawCenteredShadow(this.r, t, cx, y, scale, cr, cg, cb, 2);
    }
    void TextL(string t, int x, int y, int scale, int cr, int cg, int cb, int ca) {
        Text.Draw(this.r, t, x, y, scale, cr, cg, cb, ca);
    }
    void TextR(string t, int rightX, int y, int scale, int cr, int cg, int cb, int ca) {
        Text.Draw(this.r, t, rightX - Text.Width(this.r, t, scale), y, scale, cr, cg, cb, ca);
    }
    int ColR(int code) {
        if (code == 1) { return 125; }
        if (code == 2) { return 222; }
        if (code == 3) { return 255; }
        if (code == 4) { return 186; }
        if (code == 5) { return 255; }
        if (code == 6) { return 120; }
        return 255;
    }
    int ColG(int code) {
        if (code == 1) { return 211; }
        if (code == 2) { return 140; }
        if (code == 3) { return 215; }
        if (code == 4) { return 148; }
        if (code == 5) { return 120; }
        if (code == 6) { return 255; }
        return 255;
    }
    int ColB(int code) {
        if (code == 1) { return 252; }
        if (code == 2) { return 70; }
        if (code == 3) { return 0; }
        if (code == 4) { return 255; }
        if (code == 5) { return 110; }
        if (code == 6) { return 200; }
        return 255;
    }
    // 货币色:0铁 1铜 2金 3萤晶 4核心
    int CurR(int c) { return this.ColR(c + 1); }
    int CurG(int c) { return this.ColG(c + 1); }
    int CurB(int c) { return this.ColB(c + 1); }

    // 职业圆徽:有生图徽章画徽章,否则回退彩色圆 + 职业首字
    void DrawCrewBadge(int cx, int cy, int size, int type, bool unlocked) {
        SdlTexture t = this.texCrew[type];
        if (t != null && t.IsValid()) {
            if (!unlocked) { t.SetOpacity(110); }
            this.r.DrawTexture(t, cx - size / 2, cy - size / 2, size, size);
            if (!unlocked) { t.SetOpacity(255); }
            return;
        }
        int code = type + 1;
        Sprite.Glow(this.r, cx, cy, size / 2 + 5, this.ColR(code), this.ColG(code), this.ColB(code), unlocked ? 70 : 25);
        Sprite.Ball(this.r, cx, cy, size / 2 - 2, this.ColR(code), this.ColG(code), this.ColB(code), unlocked ? 245 : 120);
        TextCSh(this.g.UD[type].name.Substring(0, 1), cx, cy - size / 4, 2, 20, 20, 30);
    }

    // 精致扁平按钮:单层圆角底 + 1px 发丝描边,悬停轻提亮(无外发光/厚边框/
    // 光泽分层)。accent = 金色高亮(选中页签/可购买),disabled 灰暗降透明。
    bool Btn(int x, int y, int w, int h, string label, int scale, bool enabled, bool accent) {
        return this.BtnIc(x, y, w, h, label, scale, enabled, accent, null);
    }

    // 精致扁平按钮:图片底(btn_dark/btn_gold 九宫格铺放)+ 悬停增亮变体,
    // disabled 降透明。图标+文字整体居中,空间不够时退化为纯文字。
    bool BtnIc(int x, int y, int w, int h, string label, int scale, bool enabled, bool accent, SdlTexture icon) {
        bool hov = Draw.PointIn(this.mouseX, this.mouseY, x, y, w, h) && enabled;
        SdlTexture btBase = accent ? this.texBtnGold : this.texBtnDark;
        SdlTexture hi = accent ? this.texBtnGoldHi : this.texBtnDarkHi;
        SdlTexture tex = hov ? hi : btBase;
        if (tex == null || !tex.IsValid()) {
            return this.BtnVec(x, y, w, h, label, scale, enabled, accent, icon);
        }
        if (!enabled) { tex.SetOpacity(150); }
        MinerApp.NineImg(this.r, tex, 768, 192, 128, 14, x, y, w, h);
        if (!enabled) { tex.SetOpacity(255); }
        int tc = 228; int tg = 233; int tb = 248;
        if (accent) { tc = 255; tg = 224; tb = 150; }
        if (!enabled) { tc = 116; tg = 120; tb = 136; }
        int lw = Text.Width(this.r, label, scale);
        int ic = icon != null && icon.IsValid() ? scale * 13 : 0;
        int gap = ic > 0 ? 8 : 0;
        if (ic > 0 && ic + gap + lw > w - 10) { ic = 0; gap = 0; }
        int sx = x + (w - ic - gap - lw) / 2;
        if (ic > 0) {
            if (!enabled) { icon.SetOpacity(130); }
            this.r.DrawTexture(icon, sx, y + (h - ic) / 2, ic, ic);
            if (!enabled) { icon.SetOpacity(255); }
        }
        Text.DrawShadow(this.r, label, sx + ic + gap, y + h / 2 - 4 * scale, scale, tc, tg, tb, 2);
        return hov && this.mouseDown;
    }

    // 矢量按钮(缺素材兜底):单层圆角底 + 1px 描边。
    bool BtnVec(int x, int y, int w, int h, string label, int scale, bool enabled, bool accent, SdlTexture icon) {
        bool hov = Draw.PointIn(this.mouseX, this.mouseY, x, y, w, h) && enabled;
        int mr = 40; int mg = 43; int mb = 60;      // 冷灰蓝底
        int sr = 255; int sg = 255; int sb = 255; int sa = 20;
        int tc = 228; int tg = 233; int tb = 248;
        if (accent) {
            mr = 74; mg = 60; mb = 32;              // 暗金底
            sr = 255; sg = 205; sb = 115; sa = 70;
            tc = 255; tg = 224; tb = 150;
        }
        if (!enabled) {
            mr = 30; mg = 32; mb = 42; sa = 10;
            tc = 116; tg = 120; tb = 136;
        } else if (hov) {
            mr = mr + 12; mg = mg + 12; mb = mb + 12; sa = accent ? 120 : 64;
        }
        Draw.RoundRectFill(this.r, x, y, w, h, 9, mr, mg, mb, enabled ? 235 : 195);
        Draw.RoundRectStroke(this.r, x, y, w, h, 9, 1, sr, sg, sb, sa);
        int lw = Text.Width(this.r, label, scale);
        int ic = icon != null && icon.IsValid() ? scale * 13 : 0;
        int gap = ic > 0 ? 8 : 0;
        if (ic > 0 && ic + gap + lw > w - 10) { ic = 0; gap = 0; }
        int sx = x + (w - ic - gap - lw) / 2;
        if (ic > 0) {
            if (!enabled) { icon.SetOpacity(130); }
            this.r.DrawTexture(icon, sx, y + (h - ic) / 2, ic, ic);
            if (!enabled) { icon.SetOpacity(255); }
        }
        Text.DrawShadow(this.r, label, sx + ic + gap, y + h / 2 - 4 * scale, scale, tc, tg, tb, 2);
        return hov && this.mouseDown;
    }

    // 资源条:左列 5 枚货币胶囊,右侧深度/DPS
    void ResBar() {
        string[] icons = new string[] { "铁", "铜", "金", "萤晶", "核心" };
        double[] vals = new double[] { this.g.tie, this.g.tong, this.g.jin, this.g.cry, this.g.cores };
        int ry = Host.BarH() + 64;   // 页签行之下
        int x = MinerApp.LX();
        for (int i = 0; i < 5; i = i + 1) {
            string t = icons[i] + " " + Game.FmtNum(vals[i]);
            int w = 118;
            // 货币胶囊:石条底(row_stone 裁高铺放);缺图回退矢量胶囊
            SdlTexture row = this.texRowStone;
            if (row != null && row.IsValid()) {
                this.r.DrawTextureRegion(row, 8, 8, 400, 144, x, ry, w, 40);
            } else {
                Draw.RoundRectFill(this.r, x, ry, w, 40, 11, 34, 36, 52, 210);
                Draw.RoundRectStroke(this.r, x, ry, w, 40, 11, 1, 255, 255, 255, 16);
            }
            SdlTexture ic = this.texIcon[i];
            if (ic != null && ic.IsValid()) {
                this.r.DrawTexture(ic, x + 6, ry + 6, 28, 28);
            } else {
                Sprite.Ball(this.r, x + 16, ry + 20, 7, this.CurR(i), this.CurG(i), this.CurB(i), 255);
            }
            TextL(t, x + 30, ry + 12, 2, 235, 240, 255, 255);
            x = x + w + 10;
        }
        // 深度徽章:自适应宽度,不超过 DPS 列起点(留 16px 间隙)
        string depth = "第 " + (this.g.floor + 1) + " 层 · 最深 " + (this.g.best + 1);
        if (this.g.IsBoss()) { depth = depth + " · 首领!"; }
        int dbw = Text.Width(this.r, depth, 2) + 28;
        int maxw = MinerApp.RX() - (x + 8) - 16;
        if (dbw > maxw) { dbw = maxw; }
        SdlTexture row2 = this.texRowStone;
        if (row2 != null && row2.IsValid()) {
            this.texRowStone.SetColor(255, 205, 160);
            this.r.DrawTextureRegion(row2, 8, 8, 400, 144, x + 8, ry, dbw, 40);
            this.texRowStone.ResetColor();
        } else {
            Draw.RoundRectFill(this.r, x + 8, ry, dbw, 40, 11, 48, 36, 30, 210);
            Draw.RoundRectStroke(this.r, x + 8, ry, dbw, 40, 11, 1, 255, 190, 140, 45);
        }
        this.r.SetClip(x + 8, ry, dbw, 40);
        TextL(depth, x + 22, ry + 12, 2, 255, 190, 140, 255);
        this.r.ResetClip();
        // DPS/离线结算挂右上(与徽章同列起点,永不重叠)
        string dps = "DPS " + Game.FmtNum(this.g.EstDps());
        TextR(dps, MinerApp.W() - MinerApp.LX(), ry + 12, 2, 255, 130, 130, 255);
        // 当前称谓外显(DESIGN.md §4.5):主界面常驻,最高档称谓
        string tt = this.g.TopTitle();
        if (tt.Length > 0) {
            TextR("「" + tt + "」", MinerApp.W() - MinerApp.LX(), ry + 40, 2, 255, 215, 140, 255);
        }
        if (this.offlineText.Length > 0) {
            TextR(this.offlineText, MinerApp.W() - MinerApp.LX(), ry + 64, 1, 120, 255, 200, 255);
        }
    }

    // ---------------- 矿井页 ----------------

    void DrawMonsterCard(int x, int y, int w) {
        int h = 210;
        Th.Panel(this.r, x, y, w, h);
        // 怪物悬浮/脉动动画是常态(不只在受击时),矿井页要持续重绘
        this.host.MarkEvent();
        if (this.g.shakeUntil > 0 && this.now < this.g.shakeUntil) {
            int amp = 4;
            x = x + (int)(this.now * 7 % (amp * 2 + 1)) - amp;
        }
        bool boss = this.g.IsBoss();
        string mobName = "深 渊 之 物";
        if (boss) { mobName = "★ 首 领 ★"; }
        int ncr = 185; int ncg = 195; int ncb = 220;
        if (boss) { ncr = 255; ncg = 205; ncb = 120; }
        TextCSh(mobName, x + w / 2, y + 14, 3, ncr, ncg, ncb);
        // 怪物本体:生图立绘(悬浮 + 呼吸脉动),加载失败回退发光球双眼
        int cx = x + w / 2;
        int bob = (int)((this.now / 400) % 2) * 3;
        int cy = y + 92 + bob;
        int pulse = (int)((this.now / 120) % 6);
        if (pulse > 3) { pulse = 6 - pulse; }
        int rad = 34 + pulse;
        if (boss) { rad = rad + 12; }
        int mr = 150; int mg = 90; int mb = 200;
        if (boss) { mr = 210; mg = 70; mb = 80; }
        SdlTexture mob = boss ? this.texMobBoss : this.texMobNormal;
        if (mob != null && mob.IsValid()) {
            Sprite.Glow(this.r, cx, cy, rad + 24, mr, mg, mb, boss ? 90 : 60);
            int size = rad * 2 + 24;
            this.r.DrawTexture(mob, cx - size / 2, cy - size / 2, size, size);
        } else {
            Sprite.Glow(this.r, cx, cy, rad + 20, mr, mg, mb, boss ? 90 : 60);
            Sprite.Ball(this.r, cx, cy, rad, mr, mg, mb, 235);
            // 高光 + 双眼
            Sprite.Ball(this.r, cx - rad / 3, cy - rad / 3, rad / 5, 255, 255, 255, 90);
            int eo = rad / 2;
            Sprite.Ball(this.r, cx - eo, cy - 4, rad / 5 + 3, 255, 245, 245, 255);
            Sprite.Ball(this.r, cx + eo, cy - 4, rad / 5 + 3, 255, 245, 245, 255);
            Sprite.Ball(this.r, cx - eo, cy - 2, rad / 9 + 3, 25, 15, 35, 255);
            Sprite.Ball(this.r, cx + eo, cy - 2, rad / 9 + 3, 25, 15, 35, 255);
        }
        // 血条(更粗,带底色分层)
        double maxHp = this.g.MonsterMaxHp();
        double p = 0;
        if (maxHp > 0) { p = this.g.monsterHp / maxHp; }
        if (p < 0) { p = 0; }
        if (p > 1) { p = 1; }
        int bw = w - 48;
        int by = y + 152;
        if (!MinerApp.DrawTrough(this.r, this.texBarTrough, this.texBarFill, x + 24, by, bw, 22, p)) {
            Draw.RoundRectFill(this.r, x + 24, by, bw, 22, 10, 46, 20, 30, 255);
            int br3 = (int)(bw * p);
            if (br3 > 0) {
                int cr3 = 235; int cg3 = 70; int cb3 = 90;
                if (p > 0.5) { cr3 = 235; cg3 = 90; cb3 = 70; }
                if (p > 0.75) { cr3 = 235; cg3 = 130; cb3 = 70; }
                Draw.RoundRectFill(this.r, x + 24, by, br3, 22, 10, cr3, cg3, cb3, 255);
                Draw.RoundRectFill(this.r, x + 24, by + 2, br3, 9, 8, 255, 255, 255, 45);
            }
        }
        TextCSh(Game.FmtNum(this.g.monsterHp) + " / " + Game.FmtNum(maxHp), x + w / 2, by + 3, 2, 245, 245, 255);
        // 掉落概率
        double p0 = this.g.DropProb(0);
        double p1 = this.g.DropProb(1);
        double p2 = this.g.DropProb(2);
        TextC("铁 " + Game.FmtNum(p0) + "%   铜 " + Game.FmtNum(p1) + "%   金 " + Game.FmtNum(p2) + "%",
            x + w / 2, by + 30, 2, 175, 190, 225, 255);
    }

    void DrawRatesCard(int x, int y, int w) {
        int h = 92;
        Th.Panel(this.r, x, y, w, h);
        TextL("产出 / 秒", x + 16, y + 10, 2, 255, 210, 130, 255);
        string l1 = "铁 +" + Game.FmtNum(this.g.EstPerSec(0))
            + "    铜 +" + Game.FmtNum(this.g.EstPerSec(1))
            + "    金 +" + Game.FmtNum(this.g.EstPerSec(2));
        TextL(l1, x + 16, y + 34, 2, 215, 222, 245, 255);
        string l2 = "萤晶 +" + Game.FmtNum(this.g.CryPerSec())
            + "    DPS " + Game.FmtNum(this.g.EstDps());
        TextL(l2, x + 16, y + 60, 2, 215, 222, 245, 255);
        // 深渊低语 buff 提示
        if (this.g.playSec < this.g.buffUntil) {
            int left = (int)(this.g.buffUntil - this.g.playSec);
            TextL("低语 +" + left + "s", x + w - 110, y + 34, 2, 255, 120, 120, 255);
        }
    }

    void DrawEventCard(int x, int y, int w) {
        Evt e = this.g.ev;
        if (e == null) { return; }
        int h = 78;
        // 金边横幅背板(banner.png,含金饰边),缺图回退矢量金描边
        if (this.texBanner != null && this.texBanner.IsValid()) {
            this.r.DrawTexture(this.texBanner, x, y, w, h);
        } else {
            Th.Panel(this.r, x, y, w, h);
            Draw.RoundRectFill(this.r, x - 2, y - 2, w + 4, h + 4, 15, 255, 200, 90, 110);
            Draw.RoundRectFill(this.r, x, y, w, h, 14, 26, 28, 44, 0);
            Draw.RoundRectFill(this.r, x, y, w, h, 14, 46, 38, 30, 235);
        }
        string[] names = new string[] { "矿脉涌动", "黑市商人", "遗迹探秘", "深渊低语" };
        string[] desc = new string[] {
            "矿脉突然活跃,可立即收获一批铁",
            "用 30% 金币换萤晶(至少 100 金)",
            "探查古代遗迹,可能发现圣物",
            "倾听低语,60 秒伤害 +25%"
        };
        int left = (int)(e.until - this.g.playSec);
        TextL("! 事件 · " + names[e.type], x + 16, y + 12, 3, 255, 215, 120, 255);
        TextL(desc[e.type] + "   (" + left + "s)", x + 16, y + 44, 2, 205, 210, 230, 255);
        bool ok = this.g.EventUsable(0);
        if (this.Btn(x + w - 128, y + 18, 108, 42, "选 择", 2, ok, true)) {
            this.g.EventChoose(0);
            this.snd.Trade();
            this.mouseDown = false;
        }
    }

    void DrawMinerStrip(int x, int y, int w) {
        // 每类矿工一行:图标 名 xN 进度条 产出
        int rows = 6;
        int rh = 46;
        int h = rows * rh + 14;
        Th.Panel(this.r, x, y, w, h);
        TextL("矿队作业", x + 16, y + 10, 2, 255, 210, 130, 255);
        int n = 0;
        for (int t = 0; t < 6; t = t + 1) {
            int cnt = this.g.CrewCount(t);
            if (cnt == 0) { continue; }
            int ry = y + 40 + n * rh;
            // 图标:职业圆徽(生图),失败回退彩色圆 + 字
            int icx = x + 30;
            int icy = ry + rh / 2 - 6;
            int colCode = t + 1;
            SdlTexture ct = this.texCrew[t];
            if (ct != null && ct.IsValid()) {
                this.r.DrawTexture(ct, icx - 16, icy - 16, 32, 32);
            } else {
                Sprite.Glow(this.r, icx, icy, 17, this.ColR(colCode), this.ColG(colCode), this.ColB(colCode), 60);
                Sprite.Ball(this.r, icx, icy, 13, this.ColR(colCode), this.ColG(colCode), this.ColB(colCode), 245);
                TextCSh(this.g.UD[t].name.Substring(0, 1), icx, icy - 9, 2, 22, 22, 32);
            }
            string line = this.g.UD[t].name + " ×" + cnt;
            TextL(line, x + 54, ry + 6, 2, 235, 240, 252, 255);
            // 进度条
            Unit u0 = null;
            double timer = 0; double itv = 1;
            for (int i = 0; i < this.g.crew.Count; i = i + 1) {
                if (this.g.crew[i].type == t) { u0 = this.g.crew[i]; break; }
            }
            if (u0 != null) {
                timer = u0.timer;
                itv = this.g.UnitInterval(u0) * u0.mult;
            }
            int pw = 150;
            double pp = timer / itv;
            if (pp < 0) { pp = 0; }
            if (pp > 1) { pp = 1; }
            // 图片槽+填充(bar_trough/bar_fill);填充是红系,进度语义染绿
            if (MinerApp.DrawTrough(this.r, this.texBarTrough, this.texBarFill, x + w - 250, ry + 12, pw, 14, pp)) {
                this.texBarFill.SetColor(120, 235, 150);
                int swg = (int)(768 * pp);
                if (swg < 1) { swg = 1; }
                this.r.DrawTextureRegion(this.texBarFill, 0, 0, swg, 96, x + w - 250, ry + 12, (int)(pw * pp), 14);
                this.texBarFill.ResetColor();
            } else if (pw * pp > 0) {
                // 缺图:槽一次成型(暗底),绿填在底上,不再双层矢量
                Draw.RoundRectFill(this.r, x + w - 250, ry + 12, pw, 14, 7, 24, 22, 36, 255);
                Draw.RoundRectFill(this.r, x + w - 250, ry + 12, (int)(pw * pp), 14, 7, 120, 225, 160, 255);
            }
            string ytext = "+" + Game.FmtNum(this.g.UnitYield(u0 == null ? new Unit() : u0)) + "/次";
            TextL(ytext, x + w - 250 + pw + 12, ry + 8, 2, 175, 185, 215, 255);
            n = n + 1;
        }
        if (n == 0) {
            TextL("还没有矿工 — 去「矿队」雇佣第一位!", x + 20, y + 56, 2, 175, 185, 215, 255);
        }
    }

    // 矿队作业条第 utype 类矿工行的锚点(飘雪出生坐标)。行布局必须与
    // DrawMinerStrip 一致:面板 y + 40 + 可见行序 n * 46,锚点取进度条
    // 上方的行中心;返回 false 表示该类矿工当前不可见(行数超窗)。
    bool MinerRowAnchor(int utype, int[] outXY) {
        int x = MinerApp.LX();
        int ey = this.g.ev != null ? 240 : 152;
        int y = ey + 222;
        int w = MinerApp.LW();
        int n = 0;
        for (int t = 0; t < 6; t = t + 1) {
            if (this.g.CrewCount(t) == 0) { continue; }
            if (t == utype) {
                outXY[0] = x + w - 250 + 30;
                outXY[1] = y + 40 + n * 46 + 8;
                return true;
            }
            n = n + 1;
        }
        return false;
    }

    void DrawFloats() {
        // 浮字只属于矿井页(page 0,且无浮层)——否则会飘到矿队/设置等页
        if (this.page != 0 || this.floatPage != 0 || this.offlineText.Length > 0) {
            return;
        }
        bool drew = false;
        int[] axy = new int[2];
        double nowS = this.g.playSec;
        for (int i = this.g.floats.Count - 1; i >= 0; i = i + -1) {
            FText f = this.g.floats[i];
            long age = (long)(nowS * 1000) - f.bornAt;
            if (age > 1400) { this.g.floats.RemoveAt(i); continue; }
            int a = 255 - (int)(age * 255 / 1400);
            if (f.utype >= 0) {
                // 数字飘雪:从矿工行锚点出发,上飘 + 正弦横摆 + 水平漂移,
                // 出生时用 uiRng 注入各不相同的漂移参数,像矿尘雪片。
                if (f.vx == 0 && f.sway == 0) {
                    f.sway = 6 + this.uiRng.Next() % 14;
                    f.ph = this.uiRng.Next() % 628;
                    f.vx = (this.uiRng.Next() % 17) - 8;
                }
                if (!this.MinerRowAnchor(f.utype, axy)) { continue; }
                double ts = age / 1000.0;
                double sx = Math.Sin(ts * 3.0 + f.ph / 100.0) * f.sway;
                int fx = axy[0] + (int)(f.vx * ts + sx);
                int fy = axy[1] - (int)(age * 22 / 1000.0);
                TextC(f.text, fx, fy, 2, f.cr, f.cg, f.cb, a);
            } else {
                int fy = 340 - (int)(age / 12);
                TextC(f.text, 400 + (int)((i % 5) * 30) - 60, fy, 3, f.cr, f.cg, f.cb, a);
            }
            drew = true;
        }
        // 浮字活着 = 有动画在跑,事件驱动重绘要持续到它们淡出为止
        if (drew) { this.host.MarkEvent(); }
    }

    void DrawToasts() {
        for (int i = this.g.toasts.Count - 1; i >= 0; i = i + -1) {
            Toast t = this.g.toasts[i];
            long age = (long)(this.g.playSec * 1000) - t.bornAt;
            if (age > 3400) { this.g.toasts.RemoveAt(i); continue; }
            // toast 有退场动画,持续重绘到淡出完成
            this.host.MarkEvent();
            int a = 255;
            if (age > 2800) { a = 255 - (int)((age - 2800) * 255 / 600); }
            // 半透明底板让通知在任何背景下可读:石条底(暗染),缺图回退矢量
            int tw = Text.Width(this.r, t.text, 2) + 32;
            SdlTexture row = this.texRowStone;
            if (row != null && row.IsValid()) {
                row.SetOpacity(a * 3 / 4);
                this.r.DrawTextureRegion(row, 8, 8, 400, 144, MinerApp.W() / 2 - tw / 2, 452 + i * 34, tw, 30);
                row.SetOpacity(255);
            } else {
                Draw.RoundRectFill(this.r, MinerApp.W() / 2 - tw / 2, 452 + i * 34, tw, 30, 10, 12, 12, 22, a * 3 / 4);
            }
            TextCSh(t.text, MinerApp.W() / 2, 458 + i * 34, 2, t.cr, t.cg, t.cb);
        }
    }

    void DrawBanner() {
        if ((long)(this.g.playSec * 1000) > this.g.bannerUntil) { return; }
        this.host.MarkEvent();   // banner 有淡出动画,持续重绘到消失
        long remain = this.g.bannerUntil - (long)(this.g.playSec * 1000);
        // 进场 200ms 放大 + 退场前 300ms 淡出
        int sc = 4;
        int a = 255;
        if (remain < 300) { a = (int)(remain * 255 / 300); }
        int bw = Text.Width(this.r, this.g.bannerText, sc);
        int bx = MinerApp.W() / 2 - bw / 2 - 24;
        if (this.texBanner != null && this.texBanner.IsValid()) {
            // 横幅背板图,随文字宽度铺放并同步淡出
            this.texBanner.SetOpacity(a);
            this.r.DrawTexture(this.texBanner, bx, 126, bw + 48, 74);
            this.texBanner.SetOpacity(255);
        } else {
            Draw.RoundRectFill(this.r, bx, 132, bw + 48, 62, 16, 15, 13, 28, a * 5 / 6);
            Draw.RoundRectStroke(this.r, bx, 132, bw + 48, 62, 16, 1, 255, 215, 130, a * 3 / 4);
        }
        TextC(this.g.bannerText, MinerApp.W() / 2, 148, sc, 255, 225, 140, a);
    }

    // ---------------- 矿队页 ----------------

    void DrawCrewPage() {
        this.ResBar();
        // 左列:雇佣卡片(每类一张)
        int x = MinerApp.LX();
        int y = 154;
        int cw = (MinerApp.LW() - 20) / 2;
        for (int t = 0; t < 6; t = t + 1) {
            bool unlocked = this.g.TypeUnlocked(t);
            int cx = x + (t % 2) * (cw + 20);
            int cy = y + (t / 2) * 116;
            Th.Panel(this.r, cx, cy, cw, 104);
            this.DrawCrewBadge(cx + 34, cy + 52, 44, t, unlocked);
            TextL(this.g.UD[t].name + "  ×" + this.g.CrewCount(t), cx + 62, cy + 12, 3, 238, 242, 255, 255);
            TextL(this.g.UD[t].desc, cx + 62, cy + 40, 2, 172, 182, 208, 255);
            if (!unlocked) {
                TextL("第 " + (this.g.UD[t].unlockFloor + 1) + " 层解锁", cx + 62, cy + 66, 2, 255, 175, 120, 255);
                continue;
            }
            double cost = this.g.HireCost(t);
            int cur = this.g.UD[t].cur;
            bool can = this.g.Cur(cur) >= cost;
            string ct = "雇佣+升级 " + Game.FmtNum(cost) + " " + this.CurShort(cur);
            if (this.Btn(cx + 62, cy + 64, cw - 78, 34, ct, 2, can, can)) {
                if (this.g.BuyHire(t)) {
                    this.snd.Up();
                    this.g.Float(this.g.UD[t].name + " 加入!", 120, 255, 170, false);
                }
                this.mouseDown = false;
            }
        }
        // 右列:强化(滚动分页:每页 7 项)
        int rx = MinerApp.RX();
        Th.Panel(this.r, rx, 154, MinerApp.RW(), 518);
        TextL("强 化", rx + 16, 166, 3, 255, 210, 120, 255);
        int per = 6;
        int pages = (14 + per - 1) / per;
        if (this.viewLv[0] >= pages) { this.viewLv[0] = 0; }
        int start = this.viewLv[0] * per;
        int iy = 206;
        for (int k = 0; k < per; k = k + 1) {
            int i = start + k;
            if (i >= 14) { break; }
            bool unlocked = this.g.UpUnlocked(i);
            int lv = this.g.upLv[i];
            int cy = iy + k * 70;
            bool maxed = this.g.UPD[i].maxLv > 0 && lv >= this.g.UPD[i].maxLv;
            TextL(this.g.UPD[i].name + (this.g.UPD[i].maxLv > 0 ? "  Lv" + lv + "/" + this.g.UPD[i].maxLv : "  Lv" + lv),
                rx + 16, cy, 2, unlocked ? 235 : 145, unlocked ? 240 : 150, unlocked ? 252 : 165, 255);
            TextL(this.g.UPD[i].desc, rx + 16, cy + 26, 2, 170, 180, 205, 255);
            if (!unlocked) {
                TextL("需第 " + (this.g.UPD[i].unlockFloor + 1) + " 层" + (this.g.UPD[i].needType >= 0 ? " & 拥有" + this.g.UD[this.g.UPD[i].needType].name : ""),
                    rx + 16, cy + 48, 2, 255, 175, 120, 255);
                continue;
            }
            if (maxed) {
                TextL("已满级", rx + 16, cy + 48, 2, 120, 255, 200, 255);
                continue;
            }
            double cost = this.g.UpCost(i);
            int cur = this.g.UPD[i].cur;
            bool can = this.g.Cur(cur) >= cost;
            string ct = "升级 " + Game.FmtNum(cost) + " " + this.CurShort(cur);
            if (this.Btn(rx + MinerApp.RW() - 118, cy + 26, 102, 36, ct, 2, can, can)) {
                if (this.g.BuyUp(i)) { this.snd.Up(); }
                this.mouseDown = false;
            }
        }
        // 翻页
        if (this.Btn(rx + 14, 114 + 558 - 46, 84, 34, "上一页", 2, this.viewLv[0] > 0, false)) {
            this.viewLv[0] = this.viewLv[0] - 1;
            this.mouseDown = false;
        }
        TextC((this.viewLv[0] + 1) + "/" + pages, rx + MinerApp.RW() / 2, 114 + 558 - 42, 2, 205, 210, 230, 255);
        if (this.Btn(rx + MinerApp.RW() - 98, 114 + 558 - 46, 84, 34, "下一页", 2, this.viewLv[0] < pages - 1, false)) {
            this.viewLv[0] = this.viewLv[0] + 1;
            this.mouseDown = false;
        }
    }
    string CurShort(int c) {
        if (c == 0) { return "铁"; }
        if (c == 1) { return "铜"; }
        if (c == 2) { return "金"; }
        if (c == 3) { return "萤晶"; }
        return "核心";
    }

    // ---------------- 深渊页(轮回/星盘/锻造) ----------------

    void DrawAbyssPage() {
        this.ResBar();
        int x = MinerApp.LX();
        int rx = MinerApp.RX();
        // 左:轮回
        Th.Panel(this.r, x, 154, MinerApp.LW(), 244);
        if (this.texPrestige != null && this.texPrestige.IsValid()) {
            this.r.DrawTexture(this.texPrestige, x + MinerApp.LW() - 88, 174, 64, 64);
        }
        TextL("轮回 · 重入深渊", x + 16, 168, 3, 120, 255, 200, 255);
        TextL("携深渊核心重开一局:雇佣/强化/圣物清空,核心永久保留。", x + 16, 202, 2, 188, 198, 222, 255);
        double n = this.g.CoresFor();
        string req = n > 0 ? ("当前可获 " + Game.FmtNum(n) + " 深渊核心") : "第 15 层起可轮回";
        TextL(req, x + 16, 230, 3, n > 0 ? 120 : 255, n > 0 ? 255 : 175, n > 0 ? 200 : 120, 255);
        string cur = "核心 " + Game.FmtNum(this.g.cores) + " · 已轮回 " + this.g.prestiges + " 次";
        TextL(cur, x + 16, 264, 2, 205, 210, 230, 255);
        if (this.Btn(x + 16, 298, 220, 48, "轮  回", 3, n > 0, true)) {
            this.g.DoPrestige();
            this.snd.Box();
            this.mouseDown = false;
        }
        // 左下:锻造
        Th.Panel(this.r, x, 416, MinerApp.LW(), 148);
        if (this.texForge != null && this.texForge.IsValid()) {
            this.r.DrawTexture(this.texForge, x + MinerApp.LW() - 76, 432, 52, 52);
        }
        TextL("锻造台 · Lv" + this.g.forgeLv, x + 16, 430, 3, 255, 210, 120, 255);
        TextL("每级:伤害 +6%,产出 +4%(消耗萤晶+金)", x + 16, 464, 2, 188, 198, 222, 255);
        string fc = "锻 造  " + Game.FmtNum(this.g.ForgeCost()) + " 萤晶 + " + Game.FmtNum(this.g.ForgeJinCost()) + " 金";
        if (this.Btn(x + 16, 498, 330, 44, fc, 2, this.g.Cur(3) >= this.g.ForgeCost() && this.g.Cur(2) >= this.g.ForgeJinCost(), true)) {
            if (this.g.ForgeBuy()) { this.snd.Craft(); }
            this.mouseDown = false;
        }
        // 左下:称谓天梯(DESIGN.md §4.5 纯累积里程碑,两行三列)
        Th.Panel(this.r, x, 576, MinerApp.LW(), 136);
        TextL("称谓 · 纯累积里程碑,永不掉落", x + 16, 588, 2, 255, 215, 140, 255);
        for (int i = 0; i < 6; i = i + 1) {
            int tx = x + 16 + (i % 3) * 280;
            int ty = 614 + (i / 3) * 46;
            bool got = (this.g.titleMask & (1 << i)) != 0;
            TextL((got ? "◆ " : "◇ ") + Game.TitleName[i], tx, ty, 2,
                got ? 255 : 120, got ? 215 : 128, got ? 140 : 150, 255);
            TextL(got ? Game.TitleDesc[i] : this.TitleProgress(i), tx, ty + 24, 1,
                got ? 200 : 140, got ? 208 : 148, got ? 232 : 172, 255);
        }
        // 右:深渊核心升级
        Th.Panel(this.r, rx, 154, MinerApp.RW(), 412);
        TextL("深渊核心", rx + 16, 166, 3, 120, 255, 200, 255);
        string[] cn = new string[] { "蛮荒之力", "矿脉亲和", "迅捷之风", "启动资金", "圣物磁石", "离线延长", "自动矿务" };
        string[] cd = new string[] {
            "伤害 +25%/级", "产出 +25%/级", "全体间隔 -6%/级",
            "开局资金 ×5/级", "圣物掉落 +2%/级", "离线上限 +4h/级", "每 2s 自动购买"
        };
        for (int i = 0; i < 7; i = i + 1) {
            int cy = 204 + i * 50;
            bool maxed = this.g.coreLv[i] >= 20;
            double cost = Math.Floor(1 * Math.Pow(1.9, this.g.coreLv[i]));
            TextL(cn[i] + " Lv" + this.g.coreLv[i] + (maxed ? " (满)" : ""), rx + 16, cy, 2, 228, 233, 248, 255);
            TextL(cd[i], rx + 16, cy + 24, 2, 168, 178, 202, 255);
            if (!maxed) {
                bool can = this.g.cores >= cost;
                if (this.Btn(rx + MinerApp.RW() - 104, cy + 10, 88, 32, "升 " + Game.FmtNum(cost), 2, can, can)) {
                    if (this.g.Pay(4, cost)) {
                        this.g.coreLv[i] = this.g.coreLv[i] + 1;
                        this.snd.Up();
                    }
                    this.mouseDown = false;
                }
            }
        }
        // 右下:星盘(萤晶占星):空槽用凹座图,点亮用白宝石染色
        Th.Panel(this.r, rx, 584, MinerApp.RW(), 128);
        TextL("星盘 · 同类每颗 +3%", rx + 16, 594, 2, 195, 158, 255, 255);
        SdlTexture sock = this.texSocket;
        SdlTexture gem = this.texGem;
        for (int i = 0; i < 12; i = i + 1) {
            int sx = rx + 22 + (i % 6) * 56;
            int sy = 624 + (i / 6) * 40;
            bool on = (this.g.astroMask & (1 << i)) != 0;
            if (on) {
                int kind = i % 3;
                int cr2 = 255; int cg2 = 110; int cb2 = 110;
                if (kind == 1) { cr2 = 120; cg2 = 230; cb2 = 130; }
                if (kind == 2) { cr2 = 130; cg2 = 200; cb2 = 255; }
                if (gem != null && gem.IsValid()) {
                    gem.SetColor(cr2, cg2, cb2);
                    this.r.DrawTexture(gem, sx, sy, 28, 28);
                    gem.ResetColor();
                } else {
                    Sprite.Glow(this.r, sx + 14, sy + 14, 19, cr2, cg2, cb2, 90);
                    Sprite.Ball(this.r, sx + 14, sy + 14, 12, cr2, cg2, cb2, 255);
                }
            } else if (sock != null && sock.IsValid()) {
                this.r.DrawTexture(sock, sx, sy, 28, 28);
            } else {
                Draw.RoundRectFill(this.r, sx, sy, 28, 28, 8, 46, 48, 70, 255);
                Draw.RoundRectStroke(this.r, sx, sy, 28, 28, 8, 1, 195, 158, 255, 90);
            }
            if (!on && Draw.PointIn(this.mouseX, this.mouseY, sx - 8, sy - 8, 44, 44) && this.mouseDown) {
                if (this.g.AstroBuy(i)) { this.snd.Tip(); }
                this.mouseDown = false;
            }
        }
    }

    // ---------------- 圣物浮层 ----------------

    void DrawRelicsOverlay() {
        // 暗化遮罩透出背景,与离线弹窗同一语言(遮罩贴图,缺图回退纯色矩形)
        if (this.texDim != null && this.texDim.IsValid()) {
            this.texDim.SetOpacity(210);
            this.r.DrawTexture(this.texDim, 0, 0, MinerApp.W(), MinerApp.H());
            this.texDim.SetOpacity(255);
        } else {
            this.r.SetColor(8, 8, 14, 210);
            this.r.FillRect(0, 0, MinerApp.W(), MinerApp.H());
        }
        int x = 120; int y = 70; int w = MinerApp.W() - 240; int h = MinerApp.H() - 140;
        Th.Panel(this.r, x, y, w, h);
        TextL("圣物背包(" + this.g.relics.Count + " 件,装备 " + this.g.EquippedCount() + "/6)", x + 20, y + 16, 3, 196, 158, 255, 255);
        int per = 7;
        int pages = (this.g.relics.Count + per - 1) / per;
        if (pages == 0) { pages = 1; }
        if (this.viewLv[1] >= pages) { this.viewLv[1] = 0; }
        int start = this.viewLv[1] * per;
        for (int k = 0; k < per; k = k + 1) {
            int i = start + k;
            if (i >= this.g.relics.Count) { break; }
            Relic r = this.g.relics[i];
            int cy = y + 58 + k * 60;
            // 石条行底(row_stone.png),装备中染金;缺图回退矢量底
            SdlTexture row = this.texRowStone;
            if (row != null && row.IsValid()) {
                if (r.equipped) { row.SetColor(255, 215, 140); }
                this.r.DrawTexture(row, x + 18, cy, w - 36, 52);
                if (r.equipped) { row.ResetColor(); }
            } else {
                Draw.RoundRectFill(this.r, x + 18, cy, w - 36, 52, 11, r.equipped ? 50 : 36, r.equipped ? 44 : 38, r.equipped ? 66 : 56, 255);
                if (r.equipped) {
                    Draw.RoundRectStroke(this.r, x + 18, cy, w - 36, 52, 11, 1, 255, 215, 130, 130);
                }
            }
            // 品质球:白宝石按品质染色;缺图回退发光球
            int qg = this.RelicQColG(r.quality);
            SdlTexture gem = this.texGem;
            if (gem != null && gem.IsValid()) {
                gem.SetColor(255, qg, 120);
                this.r.DrawTexture(gem, x + 30, cy + 12, 28, 28);
                gem.ResetColor();
            } else {
                Sprite.Glow(this.r, x + 44, cy + 26, 16, 255, qg, 120, 80);
                Sprite.Ball(this.r, x + 44, cy + 26, 12, 255, qg, 120, 255);
            }
            TextL(this.g.RelicName[r.key], x + 68, cy + 5, 2, 238, 238, 252, 255);
            TextL(this.g.RelicDesc[r.key] + " · 品质 " + r.quality + " · " + this.RelicValText(r), x + 68, cy + 30, 2, 178, 188, 212, 255);
            if (this.Btn(x + w - 196, cy + 8, 84, 36, r.equipped ? "卸下" : "装备", 2, true, !r.equipped)) {
                if (this.g.RelicToggle(i)) { this.snd.Tip(); }
                this.mouseDown = false;
            }
            if (this.Btn(x + w - 102, cy + 8, 84, 36, "出售", 2, !r.equipped, false)) {
                this.SellOne(i);
                this.mouseDown = false;
            }
        }
        // 合成/出售最低
        if (this.Btn(x + 18, y + h - 56, 170, 42, "熔合(最低两件)", 2, true, true)) {
            if (this.g.MergeRelics()) { this.snd.Craft(); }
            this.mouseDown = false;
        }
        if (this.Btn(x + 200, y + h - 56, 170, 42, "出售最低品质", 2, true, false)) {
            if (this.g.SellRelic()) { this.snd.Trade(); }
            this.mouseDown = false;
        }
        if (this.Btn(x + w - 116, y + h - 56, 98, 42, "关 闭", 2, true, false)) {
            this.floatPage = 0;
            this.mouseDown = false;
        }
        // 翻页
        if (pages > 1) {
            if (this.Btn(x + w / 2 - 150, y + h - 56, 84, 42, "◀", 2, this.viewLv[1] > 0, false)) {
                this.viewLv[1] = this.viewLv[1] - 1;
                this.mouseDown = false;
            }
            TextC((this.viewLv[1] + 1) + "/" + pages, x + w / 2, y + h - 50, 2, 212, 217, 238, 255);
            if (this.Btn(x + w / 2 + 66, y + h - 56, 84, 42, "▶", 2, this.viewLv[1] < pages - 1, false)) {
                this.viewLv[1] = this.viewLv[1] + 1;
                this.mouseDown = false;
            }
        }
    }
    void SellOne(int idx) {
        Relic r = this.g.relics[idx];
        if (r.equipped) { return; }
        double gain = Math.Floor((20 + r.key * 8) * r.quality);
        if (r.quality <= 20) { this.g.AddCur(0, gain); }
        else if (r.quality <= 40) { this.g.AddCur(1, gain); }
        else { this.g.AddCur(2, gain); }
        this.g.relics.RemoveAt(idx);
        this.snd.Trade();
    }
    int RelicQColG(int q) {
        if (q <= 20) { return 170; }
        if (q <= 40) { return 120; }
        if (q <= 60) { return 80; }
        return 40;
    }
    string RelicValText(Relic r) {
        double v = Game.RelicVal(r.key, r.quality);
        if (r.key == 0) { return "+" + Game.FmtNum(v) + " 伤害"; }
        if (r.key == 1) { return "+" + Game.FmtNum(v) + "% 金产出"; }
        if (r.key == 2) { return "-" + Game.FmtNum(v) + "% 间隔"; }
        if (r.key == 3) { return v + "% 双倍伤害"; }
        if (r.key == 4) { return "+" + Game.FmtNum(v) + "% 掉落"; }
        return v + "% 窃金";
    }

    // ---------------- 装备背包浮层(MIR 式) ----------------

    int EquipTierCol(int tier) {
        // 阶 0..4:灰铁/铜/银/金/橙传奇
        if (tier == 0) { return 0; }
        if (tier == 1) { return 2; }
        if (tier == 2) { return 1; }
        if (tier == 3) { return 3; }
        return 5;
    }
    string EquipStatText(Equip e) {
        string nm = this.g.EquipName[e.type];
        double pw = e.roll * (0.4 + e.tier * 0.15);
        string pwS = Game.FmtNum(pw);
        if (e.type == 0 || e.type == 5) { return "+" + pwS + "% " + nm + "伤害"; }
        if (e.type == 1 || e.type == 6) { return "+" + pwS + "% 全员产出"; }
        if (e.type == 2 || e.type == 7) { return "-" + pwS + "% 挖掘间隔"; }
        if (e.type == 3) { return "+" + pwS + "% 金矿产出"; }
        return "+" + pwS + "% 铜/金掉落";
    }
    // 槽位图标:空槽画灰暗凹座+槽位名首字;有装备画对应品阶切图
    void DrawEquipSlotIcon(int type, int tier, int x, int y, int size, bool filled) {
        SdlTexture tex = filled ? this.texEquip[type * 5 + tier] : null;
        if (tex != null && tex.IsValid()) {
            if (!filled) { tex.SetOpacity(80); }
            this.r.DrawTexture(tex, x, y, size, size);
            if (!filled) { tex.SetOpacity(255); }
            return;
        }
        // 缺图回退:品阶色圆徽
        int tc = this.EquipTierCol(filled ? tier : 0);
        int a2 = filled ? 235 : 70;
        Sprite.Ball(this.r, x + size / 2, y + size / 2, size / 2 - 2, this.ColR(tc), this.ColG(tc), this.ColB(tc), a2);
        if (!filled) {
            TextCSh(this.g.EquipName[type].Substring(0, 1), x + size / 2, y + size / 2 - 9, 2, 150, 155, 175);
        }
    }

    void DrawEquipsOverlay() {
        // 暗化遮罩透出背景,与圣物浮层同一语言(遮罩贴图,缺图回退纯色矩形)
        if (this.texDim != null && this.texDim.IsValid()) {
            this.texDim.SetOpacity(210);
            this.r.DrawTexture(this.texDim, 0, 0, MinerApp.W(), MinerApp.H());
            this.texDim.SetOpacity(255);
        } else {
            this.r.SetColor(8, 8, 14, 210);
            this.r.FillRect(0, 0, MinerApp.W(), MinerApp.H());
        }
        int x = 120; int y = 70; int w = MinerApp.W() - 240; int h = MinerApp.H() - 140;
        Th.Panel(this.r, x, y, w, h);
        TextL("装 备 背 包(" + this.g.equips.Count + " 件,穿戴 " + this.g.EquipEquippedCount() + "/8)",
            x + 20, y + 16, 3, 255, 205, 120, 255);
        // 左侧 8 槽位穿戴栏(2 列 × 4 行):显示每槽已穿装备
        int sx = x + 20; int sy = y + 58;
        for (int s = 0; s < 8; s = s + 1) {
            int col = s % 2;
            int row = s / 2;
            int bx = sx + col * 178;
            int by = sy + row * 96;
            int idx = this.g.EquippedIndexOfType(s);
            bool has = idx >= 0;
            // 槽位底:石条行,穿戴中染金
            SdlTexture rowT = this.texRowStone;
            if (rowT != null && rowT.IsValid()) {
                if (has) { rowT.SetColor(255, 215, 140); }
                this.r.DrawTextureRegion(rowT, 8, 8, 400, 144, bx, by, 168, 86);
                if (has) { rowT.ResetColor(); }
            } else {
                Draw.RoundRectFill(this.r, bx, by, 168, 86, 11, has ? 50 : 36, has ? 44 : 38, has ? 66 : 56, 255);
            }
            this.DrawEquipSlotIcon(s, has ? this.g.equips[idx].tier : 0, bx + 12, by + 17, 52, has);
            if (has) {
                Equip e = this.g.equips[idx];
                TextL(this.g.EquipFullName(e), bx + 74, by + 12, 2, 238, 238, 252, 255);
                TextL("+" + e.roll + " · 阶" + e.tier, bx + 74, by + 36, 2, 178, 188, 212, 255);
                if (this.Btn(bx + 74, by + 54, 78, 26, "卸下", 2, true, false)) {
                    if (this.g.EquipToggle(idx)) { this.snd.Tip(); }
                    this.mouseDown = false;
                }
            } else {
                TextL(this.g.EquipName[s], bx + 74, by + 18, 2, 150, 158, 182, 255);
                TextL("(空)", bx + 74, by + 42, 2, 120, 128, 150, 255);
            }
        }
        // 右侧背包列表(7/页):翻页 + 出售
        int lx = x + 400; int lw2 = w - 420;
        int per = 7;
        int pages = (this.g.equips.Count + per - 1) / per;
        if (pages == 0) { pages = 1; }
        if (this.equipPage >= pages) { this.equipPage = 0; }
        int start = this.equipPage * per;
        TextL("背 包", lx + 4, sy - 4, 2, 255, 210, 130, 255);
        this.equipHover = -1;
        for (int k = 0; k < per; k = k + 1) {
            int i = start + k;
            if (i >= this.g.equips.Count) { break; }
            Equip e = this.g.equips[i];
            int cy = sy + 18 + k * 62;
            bool hov = Draw.PointIn(this.mouseX, this.mouseY, lx, cy, lw2 - 96, 54);
            if (hov) { this.equipHover = i; }
            // 行底:石条,穿戴中染金
            SdlTexture rowT = this.texRowStone;
            if (rowT != null && rowT.IsValid()) {
                if (e.equipped) { rowT.SetColor(255, 215, 140); }
                else if (hov) { rowT.SetColor(215, 215, 235); }
                this.r.DrawTextureRegion(rowT, 8, 8, 400, 144, lx, cy, lw2 - 96, 54);
                rowT.ResetColor();
            } else {
                Draw.RoundRectFill(this.r, lx, cy, lw2 - 96, 54, 11, e.equipped ? 50 : 36, e.equipped ? 44 : 38, e.equipped ? 66 : 56, 255);
            }
            this.DrawEquipSlotIcon(e.type, e.tier, lx + 8, cy + 7, 40, true);
            int tcol = this.EquipTierCol(e.tier);
            TextL(this.g.EquipFullName(e), lx + 58, cy + 5, 2, this.ColR(tcol), this.ColG(tcol), this.ColB(tcol), 255);
            TextL(this.EquipStatText(e) + (e.equipped ? " · 已穿戴" : ""), lx + 58, cy + 29, 2, 178, 188, 212, 255);
            if (this.Btn(lx + lw2 - 186, cy + 9, 84, 36, e.equipped ? "已穿" : "穿戴", 2, !e.equipped, !e.equipped)) {
                if (this.g.EquipToggle(i)) { this.snd.Tip(); }
                this.mouseDown = false;
            }
            if (this.Btn(lx + lw2 - 92, cy + 9, 84, 36, "出售", 2, !e.equipped, false)) {
                if (this.g.SellEquip(i)) { this.snd.Trade(); }
                this.mouseDown = false;
            }
        }
        if (this.g.equips.Count == 0) {
            TextL("背包空空如也 — 击败深渊怪物有几率掉落装备!", lx + 8, sy + 60, 2, 175, 185, 215, 255);
        }
        // 出售最低品质(自动清包)
        if (this.Btn(x + 20, y + h - 56, 170, 42, "出售最低阶", 2, true, false)) {
            if (this.g.SellEquipLowest()) { this.snd.Trade(); }
            this.mouseDown = false;
        }
        if (this.Btn(x + w - 116, y + h - 56, 98, 42, "关 闭", 2, true, false)) {
            this.floatPage = 0;
            this.mouseDown = false;
        }
        // 翻页
        if (pages > 1) {
            if (this.Btn(x + w / 2 - 150, y + h - 56, 84, 42, "◀", 2, this.equipPage > 0, false)) {
                this.equipPage = this.equipPage - 1;
                this.mouseDown = false;
            }
            TextC((this.equipPage + 1) + "/" + pages, x + w / 2, y + h - 50, 2, 212, 217, 238, 255);
            if (this.Btn(x + w / 2 + 66, y + h - 56, 84, 42, "▶", 2, this.equipPage < pages - 1, false)) {
                this.equipPage = this.equipPage + 1;
                this.mouseDown = false;
            }
        }
    }

    // ---------------- 离线弹窗 ----------------

    void DrawOffline() {
        // 暗化遮罩下透出一点背景,弹窗不突兀(遮罩贴图,缺图回退纯色矩形)
        if (this.texDim != null && this.texDim.IsValid()) {
            this.texDim.SetOpacity(210);
            this.r.DrawTexture(this.texDim, 0, 0, MinerApp.W(), MinerApp.H());
            this.texDim.SetOpacity(255);
        } else {
            this.r.SetColor(8, 8, 14, 210);
            this.r.FillRect(0, 0, MinerApp.W(), MinerApp.H());
        }
        int x = 360; int y = 220; int w = 560; int h = 280;
        Th.Panel(this.r, x, y, w, h);
        TextCSh("欢 迎 回 来", x + w / 2, y + 24, 5, 255, 215, 140);
        TextC(this.offlineText, x + w / 2, y + 100, 3, 222, 232, 252, 255);
        TextC("资源已入账,矿队状态保持", x + w / 2, y + 140, 3, 192, 202, 228, 255);
        // 金色大钮(btn_gold.png 九宫格),缺图回退标准按钮
        int obx = x + w / 2 - 110; int oby = y + 190; int obw = 220; int obh = 52;
        if (this.texBtnGold != null && this.texBtnGold.IsValid()) {
            bool hov = Draw.PointIn(this.mouseX, this.mouseY, obx, oby, obw, obh);
            SdlTexture bt = hov && this.texBtnGoldHi != null && this.texBtnGoldHi.IsValid()
                ? this.texBtnGoldHi : this.texBtnGold;
            MinerApp.NineImg(this.r, bt, 768, 192, 128, 14, obx, oby, obw, obh);
            int lw2 = Text.Width(this.r, "继续挖矿", 3);
            Text.DrawShadow(this.r, "继续挖矿", x + w / 2 - lw2 / 2, oby + obh / 2 - 12, 3, 255, 224, 150, 2);
            if (hov && this.mouseDown) {
                this.offlineText = "";
                this.mouseDown = false;
            }
        } else if (this.BtnIc(obx, oby, obw, obh, "继续挖矿", 3, true, true, this.texTab[0])) {
            this.offlineText = "";
            this.mouseDown = false;
        }
    }

    // ---------------- 设置页 ----------------

    void DrawSettingsPage() {
        this.ResBar();
        int x = 320; int w = 640;
        Th.Panel(this.r, x, 160, w, 460);
        TextL("设 置", x + 22, 178, 4, 255, 210, 120, 255);
        if (this.Btn(x + 22, 230, 300, 52, this.g.soundOn ? "音效:开" : "音效:关", 3, true, false)) {
            this.g.soundOn = !this.g.soundOn;
            this.snd.on = this.g.soundOn;
            this.mouseDown = false;
        }
        if (this.Btn(x + 22, 298, 300, 52, "立即保存", 3, true, true)) {
            this.g.SaveGame();
            this.g.AddToast("已保存 miner_save.txt", 120, 255, 200);
            this.mouseDown = false;
        }
        if (this.Btn(x + 22, 366, 300, 52, "重置存档", 3, true, false)) {
            if (File.Exists("miner_save.txt")) { File.Delete("miner_save.txt"); }
            this.g = Game.New();
            this.floatPage = 0;
            this.mouseDown = false;
        }
        TextL("miner_save.txt 保存在程序运行目录", x + 22, 442, 2, 165, 175, 200, 255);
        TextL("首领每 10 层出萤晶 · 第 15 层可轮回 · 圣物上限 6 件", x + 22, 468, 2, 165, 175, 200, 255);
        TextL("滚轮翻页 · F11 全屏 · Esc 退出", x + 22, 494, 2, 165, 175, 200, 255);
        TextL("游玩 " + Game.FmtDur(this.g.playSec) + " · 击杀 " + Game.FmtNum(this.g.kills) + " · 最深第 " + (this.g.best + 1) + " 层", x + 22, 538, 2, 205, 215, 238, 255);
    }

    // ---------------- 顶栏 + 主渲染 ----------------

    void DrawTop() {
        // 页签(标题栏 40px 之下):图标 + 文字
        string[] pages = new string[] { "矿井", "矿队", "深渊", "设置" };
        int x = MinerApp.LX();
        for (int i = 0; i < 4; i = i + 1) {
            bool sel = this.page == i;
            int tx = x + i * 124;
            if (this.BtnIc(tx, Host.BarH() + 12, 112, 42, pages[i], 2, true, sel, this.texTab[i])) {
                this.page = i;
                this.floatPage = 0;
                this.mouseDown = false;
            }
        }
        // 圣物按钮(图标+文字)
        string rt = "圣物 " + this.g.relics.Count + (this.g.EquippedCount() > 0 ? "(" + this.g.EquippedCount() + ")" : "");
        if (this.BtnIc(MinerApp.W() - 136, Host.BarH() + 12, 112, 42, rt, 2, true, this.g.relics.Count > 0, this.texRelic)) {
            this.floatPage = 1;
            this.mouseDown = false;
        }
        // 装备按钮(图标+文字):第二行右下,与事件倒计时同列
        string et = "装备 " + this.g.equips.Count + (this.g.EquipEquippedCount() > 0 ? "(" + this.g.EquipEquippedCount() + ")" : "");
        if (this.BtnIc(MinerApp.W() - 136, Host.BarH() + 62, 112, 42, et, 2, true, this.g.equips.Count > 0, this.texEquip != null && this.texEquip.Length > 0 && this.texEquip[0] != null ? this.texEquip[0] : null)) {
            this.floatPage = 5;
            this.mouseDown = false;
        }
        // 事件倒计时角标
        if (this.g.ev != null) {
            int left = (int)(this.g.ev.until - this.g.playSec);
            TextL("事件 " + left + "s", MinerApp.W() - 256, Host.BarH() + 22, 2, 255, 215, 120, 255);
        }
    }

    // 自绘标题栏:石板条(bar_chrome)打底 + 右侧三枚系统钮。按钮平时只有
    // 细字形(win_glyphs 图),悬停浮现增亮;关闭钮悬停红染字形。最大化态
    // 中间钮切"还原"双层窗口格。
    void DrawTitleBar() {
        if (!this.host.HasCustomBar()) { return; }
        int w = MinerApp.W();
        SdlTexture ch = this.texChrome;
        if (ch != null && ch.IsValid()) {
            this.r.DrawTexture(ch, 0, 0, w, Host.BarH());
        } else {
            this.host.DrawTitleBarChrome(this.r, w, 22, 17, 36);
        }
        int[] rc = new int[6];
        this.host.BarButtons(w, rc);
        bool maximized = this.host.IsFullscreen();
        SdlTexture gl = this.texWinGlyphs;
        for (int i = 0; i < 3; i = i + 1) {
            int bx = rc[i * 2];
            int by = rc[i * 2 + 1];
            bool hov = Draw.PointIn(this.mouseX, this.mouseY, bx, by, Host.BtnW(), Host.BtnH());
            int cx = bx + Host.BtnW() / 2;
            int cy = by + Host.BtnH() / 2;
            if (gl != null && gl.IsValid()) {
                // 三格字形图:减号/方框(或还原双层)/叉,中点缩放到 16px
                int g = maximized && i == 1 ? 2 : i;
                if (hov) { gl.SetOpacity(255); } else { gl.SetOpacity(190); }
                if (hov && i == 2) { gl.SetColor(255, 120, 120); }
                this.r.DrawTextureRegion(gl, g * 128, 0, 128, 128, cx - 8, cy - 8, 16, 16);
                if (hov && i == 2) { gl.ResetColor(); }
                gl.SetOpacity(255);
            } else {
                this.r.SetColor(206, 212, 232, hov ? 255 : 190);
                if (i == 0) {
                    this.r.FillRect(cx - 7, cy - 1, 14, 2);
                } else if (i == 1) {
                    if (maximized) {
                        // 还原:前后两层窗口
                        this.r.DrawRect(cx - 6, cy - 4, 9, 9);
                        this.r.DrawLine(cx - 3, cy - 4, cx - 3, cy - 7);
                        this.r.DrawLine(cx - 3, cy - 7, cx + 6, cy - 7);
                        this.r.DrawLine(cx + 6, cy - 7, cx + 6, cy + 2);
                        this.r.DrawLine(cx + 3, cy + 2, cx + 6, cy + 2);
                    } else {
                        this.r.DrawRect(cx - 6, cy - 6, 12, 12);
                    }
                } else {
                    this.r.DrawLine(cx - 6, cy - 6, cx + 6, cy + 6);
                    this.r.DrawLine(cx - 6, cy + 6, cx + 6, cy - 6);
                }
            }
        }
    }

    void Render() {
        this.host.Begin(10, 9, 20);
        // 背景:生图矿洞立绘优先;缺失时回退烘焙渐变 + 星点
        if (this.texBg != null && this.texBg.IsValid()) {
            this.r.DrawTexture(this.texBg, 0, 0, MinerApp.W(), MinerApp.H());
        } else {
            if (this.bg == null || !this.bg.IsValid()) {
                Rng br = Rng.Seed(20260831);
                this.bg = Ui.BakeBackdrop(this.r, MinerApp.W(), MinerApp.H(), br,
                    26, 20, 44, 9, 8, 18, 90);
            }
            if (this.bg != null && this.bg.IsValid()) {
                this.r.DrawTexture(this.bg, 0, 0, MinerApp.W(), MinerApp.H());
            } else {
                Draw.VGradient(this.r, 0, 0, MinerApp.W(), MinerApp.H(), 26, 20, 44, 9, 8, 18, 255);
            }
        }
        this.DrawTitleBar();
        this.DrawTop();
        if (this.floatPage == 1) {
            this.DrawResSilent();
            this.DrawRelicsOverlay();
        } else if (this.floatPage == 5) {
            this.DrawResSilent();
            this.DrawEquipsOverlay();
        } else if (this.offlineText.Length > 0) {
            this.DrawResSilent();
            this.DrawOffline();
        } else {
            if (this.page == 0) {
                this.ResBar();
                this.DrawEventCard(MinerApp.LX(), 152, MinerApp.LW());
                int ey = this.g.ev != null ? 240 : 152;
                this.DrawMonsterCard(MinerApp.LX(), ey, MinerApp.LW());
                this.DrawMinerStrip(MinerApp.LX(), ey + 222, MinerApp.LW());
                this.DrawRatesCard(MinerApp.RX(), 152, MinerApp.RW());
                this.DrawHintCard(MinerApp.RX(), 256, MinerApp.RW());
                this.DrawContractCard(MinerApp.RX(), 416, MinerApp.RW());
            } else if (this.page == 1) {
                this.DrawCrewPage();
            } else if (this.page == 2) {
                this.DrawAbyssPage();
            } else {
                this.DrawSettingsPage();
            }
        }
        this.DrawFloats();
        this.DrawToasts();
        this.DrawBanner();
        this.host.End();
    }

    void DrawResSilent() {
        // 浮层下的资源概要(不交互)
        string s = "铁 " + Game.FmtNum(this.g.tie) + "   铜 " + Game.FmtNum(this.g.tong)
            + "   金 " + Game.FmtNum(this.g.jin) + "   萤晶 " + Game.FmtNum(this.g.cry)
            + "   核心 " + Game.FmtNum(this.g.cores);
        TextCSh(s, MinerApp.W() / 2, 20, 3, 225, 232, 252);
    }

    void DrawHintCard(int x, int y, int w) {
        int h = 148;
        Th.Panel(this.r, x, y, w, h);
        TextL("矿井指南", x + 16, y + 12, 3, 255, 210, 120, 255);
        TextL("每 10 层是首领,击破得萤晶;", x + 16, y + 44, 2, 185, 195, 220, 255);
        TextL("第 15 层起可在「深渊」轮回。", x + 16, y + 68, 2, 185, 195, 220, 255);
        TextL("圣物可熔合升品质;离线也出矿", x + 16, y + 96, 2, 185, 195, 220, 255);
        TextL("(上限 " + (8 + this.g.coreLv[5] * 4) + " 小时)。", x + 16, y + 120, 2, 185, 195, 220, 255);
    }

    // 讨伐契约(DESIGN.md §4.2 · PRD 个人 BOSS 单机化):每日 1 次免费,
    // 萤晶可买第 2 次。目标 = 下一档首领 HP×1.6,30 秒演算定胜负。
    void DrawContractCard(int x, int y, int w) {
        int h = 150;
        Th.Panel(this.r, x, y, w, h);
        TextL("讨 伐 契 约", x + 16, y + 10, 2, 255, 200, 90, 255);
        double hp = this.g.ContractHp();
        double dps = this.g.EstDps();
        bool canWin = dps * 30 >= hp;
        TextL("目标 HP " + Game.FmtNum(hp) + " · DPS " + Game.FmtNum(dps),
            x + 16, y + 34, 2, 185, 195, 220, 255);
        TextL(canWin ? "胜算:30 秒内可击破" : "胜算不足 — 先强化队伍",
            x + 16, y + 58, 2, canWin ? 120 : 255, canWin ? 255 : 130, canWin ? 170 : 130, 255);
        // 定向圣物系(点击轮换)
        string aim = this.g.contractKey < 0 ? "随机" : this.g.RelicName[this.g.contractKey];
        if (this.Btn(x + 16, y + 84, 150, 34, "定向:" + aim, 2, true, false)) {
            this.g.contractKey = this.g.contractKey + 1;
            if (this.g.contractKey > 5) { this.g.contractKey = -1; }
            this.mouseDown = false;
        }
        // 开战按钮:冷却 > 免费档 > 付费档 > 已用竭
        double cost = this.g.ContractSecondCost();
        int cdi = (int)this.g.contractCd;
        if (cdi > 0) {
            TextL("冷却 " + cdi + "s", x + w - 110, y + 92, 2, 255, 130, 130, 255);
        } else if (this.g.ContractFreeReady()) {
            if (this.Btn(x + w - 176, y + 84, 160, 40, "开 战 · 免费", 2, true, true)) {
                this.ContractSnd(this.g.ContractFight());
                this.mouseDown = false;
            }
        } else {
            bool canPay = this.g.cry >= cost;
            if (this.Btn(x + w - 176, y + 84, 160, 40, "开战 " + Game.FmtNum(cost) + " 萤晶", 2, canPay, canPay)) {
                this.ContractSnd(this.g.ContractFight());
                this.mouseDown = false;
            }
        }
        TextL("每日 1 次免费 · 萤晶加 1 次 · 胜掉圣物+萤晶+碎片",
            x + 16, y + 128, 1, 160, 170, 198, 255);
    }
    void ContractSnd(int res) {
        if (res == 1) { this.snd.Craft(); }
        else if (res == 0) { this.snd.Tip(); }
    }
    // 称谓未达成时的进行度文本(深渊页称谓天梯用)
    string TitleProgress(int i) {
        Game g = this.g;
        if (i == 0) { return "完成一次轮回"; }
        if (i == 1) { return "击杀 " + Game.FmtNum(g.kills) + "/1000"; }
        if (i == 2) { return "开采 " + Game.FmtNum(g.oreMined) + "/1M"; }
        if (i == 3) {
            int o = 0;
            for (int k = 0; k < 12; k = k + 1) { if ((g.astroMask & (1 << k)) != 0) { o = o + 1; } }
            return "星盘 " + o + "/6";
        }
        if (i == 4) { return "熔合 " + g.mergeCount + "/50"; }
        return "击破第 100 层首领";
    }

    // ---------------- 输入 ----------------

    public void OnKey(int sc) {
        if (sc == 41) { this.g.SaveGame(); this.host.Quit(); }
        if (sc == 68) { this.host.ToggleFullscreen(); }
        if (sc == 42) {   // B 打开圣物
            this.floatPage = this.floatPage == 1 ? 0 : 1;
        }
        if (sc == 43) {   // E 打开装备背包
            this.floatPage = this.floatPage == 5 ? 0 : 5;
        }
        // 启动画面期间任意键/回车跳过等待
        if (sc == 40 || sc == 44) { this.splashMin = 0; }
    }
    public void OnWheel(double dy) {
        if (this.page == 1) {
            int pages = (14 + 6) / 7;
            if (dy < 0 && this.viewLv[0] < pages - 1) { this.viewLv[0] = this.viewLv[0] + 1; }
            if (dy > 0 && this.viewLv[0] > 0) { this.viewLv[0] = this.viewLv[0] - 1; }
        }
    }

    // ---------------- 主循环 ----------------

    public void Run() {
        while (this.host.Running()) {
            this.now = Sdl.Ticks();
            while (SdlEvent.Poll()) {
                int ty = SdlEvent.Type();
                this.host.OnWindowEvent(ty);
                if (SdlEvent.IsQuit()) { this.g.SaveGame(); this.host.Quit(); }
                if (ty == SdlEventType.KeyDown()) {
                    if (!SdlEvent.IsRepeat()) { this.OnKey(SdlEvent.Scancode()); }
                }
                if (ty == SdlEventType.MouseMotion()) {
                    this.mouseX = this.host.MouseX();
                    this.mouseY = this.host.MouseY();
                }
                if (ty == SdlEventType.MouseButtonDown() && SdlEvent.MouseButton() == SdlMouseButton.Left()) {
                    this.mouseX = this.host.MouseX();
                    this.mouseY = this.host.MouseY();
                    this.mouseDown = true;
                    // 自绘标题栏:按钮区按下交给 chrome 处理(最小化/最大化/关闭)
                    this.host.SetBarMouseDown(true);
                    if (this.host.BarInput(this.mouseX, this.mouseY, MinerApp.W()) == 3) {
                        this.g.SaveGame();
                        this.host.Quit();
                    }
                }
                if (ty == SdlEventType.MouseButtonUp() && SdlEvent.MouseButton() == SdlMouseButton.Left()) {
                    this.mouseDown = false;
                    this.host.SetBarMouseDown(false);
                    // 松开时结算最小化/最大化(按住拖离不误触)
                    int bar = this.host.BarInput(this.mouseX, this.mouseY, MinerApp.W());
                    if (bar == 1) { this.host.Minimize(); }
                    if (bar == 2) { this.host.ToggleFullscreen(); }
                }
                if (ty == SdlEventType.MouseButtonDown() && SdlEvent.MouseButton() == SdlMouseButton.Right()) {
                    // 标题栏空白处右键 → 系统菜单(还原/移动/大小/最小化/最大化/关闭)
                    if (this.host.BarInput(this.host.MouseX(), this.host.MouseY(), MinerApp.W()) == 0 &&
                        this.host.MouseY() < Host.BarH()) {
                        this.host.ShowBarMenu();
                    }
                }
                if (ty == SdlEventType.MouseWheel()) {
                    this.OnWheel(SdlEvent.MouseDeltaY());
                }
                this.host.MarkEvent();
            }
            // 模拟照常推进(挂机游戏离开输入也持续出矿),但它不是"画面
            // 变了"的渲染理由:进度条/数字本来就是 120ms 重绘节拍的量化
            // 对象,Step 不 MarkEvent,静止画面走心跳、GPU 几乎归零。
            this.Step();
            if (this.host.ShouldRender()) {
                this.Render();
            }
        }
    }

    static void Main() {
        // 无头平衡模拟:MINER_SIM=1(等价任意非空值)
        string sim = SysGetenv("MINER_SIM");
        if (sim.Length > 0) {
            MinerApp.SimRun();
            return;
        }
        Host h = Host.CreateFull("深渊矿队", MinerApp.W(), MinerApp.H(), 2, true);
        h.LimitFps(60);
        h.SetIdleFps(2);   // 最小化时降到 2fps,后台几乎零 GPU/CPU
        h.SetRedrawInterval(120);   // 事件驱动重绘:静止画面不重复渲染(动画 120ms 步进)
        MinerApp a = MinerApp.Create(h);
        // 启动画面:宿主/窗口就绪后先展示图片化 splash(背景+铭牌+加载条),
        // 期间完成存档读取;展示满/点击后淡出进主界面。
        a.splashBorn = Sdl.Ticks();
        bool[] done = new bool[] { false };
        while (!done[0]) {
            a.now = Sdl.Ticks();
            while (SdlEvent.Poll()) {
                int ty = SdlEvent.Type();
                a.host.OnWindowEvent(ty);
                if (SdlEvent.IsQuit()) { a.g.SaveGame(); a.host.Quit(); done[0] = true; }
                if (ty == SdlEventType.MouseButtonDown() && SdlEvent.MouseButton() == SdlMouseButton.Left()) {
                    a.splashMin = 0;   // 点击跳过
                }
                if (ty == SdlEventType.KeyDown() && !SdlEvent.IsRepeat()) {
                    a.splashMin = 0;   // 按键跳过
                }
                a.host.MarkEvent();
            }
            long seen = a.now - a.splashBorn;
            if (seen >= a.splashMin) {
                done[0] = true;
            }
            if (a.host.ShouldRender()) {
                a.RenderSplash(seen);
            }
        }
        if (a.host.Running() == false) { return; }
        double away = a.g.LoadGame();
        if (away > 0) {
            a.offlineText = "离线 " + Game.FmtDur(away) + " 结算完成";
        }
        a.Run();
        _ = a;
    }

    // 启动画面:全屏暗矿洞背景 + 居中铭牌 + 底部加载条(按展示进度走)。
    // 纹理缺失逐项回退:无背景用深色渐变,无铭牌直接大字标题。
    void RenderSplash(long seenMs) {
        this.host.Begin(6, 6, 11);
        if (this.texSplashBg != null && this.texSplashBg.IsValid()) {
            this.r.DrawTexture(this.texSplashBg, 0, 0, MinerApp.W(), MinerApp.H());
        } else {
            Draw.VGradient(this.r, 0, 0, MinerApp.W(), MinerApp.H(), 26, 22, 40, 8, 7, 14, 255);
        }
        // 铭牌淡入(前 300ms)
        int pa = seenMs < 300 ? (int)(seenMs * 255 / 300) : 255;
        int pw = 560; int ph = 190; int px = MinerApp.W() / 2 - pw / 2; int py = 190;
        if (this.texTitlePlate != null && this.texTitlePlate.IsValid()) {
            this.texTitlePlate.SetOpacity(pa);
            MinerApp.NineImg(this.r, this.texTitlePlate, 1408, 384, 176, 20, px, py, pw, ph);
            this.texTitlePlate.SetOpacity(255);
        } else {
            Draw.RoundRectFill(this.r, px, py, pw, ph, 18, 22, 18, 26, pa * 3 / 4);
        }
        int sub = seenMs < 600 ? (int)(seenMs * 255 / 600) : 255;
        TextCSh("深 渊 矿 队", MinerApp.W() / 2, py + 34, 7, 255, 215, 140);
        TextC("挂机 · 挖矿 · 轮回深渊", MinerApp.W() / 2, py + 116, 3, 205, 212, 235, sub);
        // 加载条:按展示进度推进,走完即进主界面
        int lbw = 420; int lbx = MinerApp.W() / 2 - lbw / 2; int lby = 470; int lbh = 26;
        double p = (double)seenMs / (double)(this.splashMin > 0 ? this.splashMin : 1);
        if (p > 1) { p = 1; }
        if (!MinerApp.DrawTroughSrc(this.r, this.texLoadBar, 1024, 72, this.texBarFill, lbx, lby, lbw, lbh, p)) {
            Draw.RoundRectFill(this.r, lbx, lby, lbw, lbh, 12, 30, 30, 48, 255);
            Draw.RoundRectFill(this.r, lbx + 3, lby + 3, (int)((lbw - 6) * p), lbh - 6, 9, 255, 200, 110, 255);
        }
        TextC("加载中…(点击跳过)", MinerApp.W() / 2, lby + 44, 2, 150, 158, 185, 255);
        this.host.End();
    }

    // ---------------- 无头模拟(平衡自测) ----------------

    public static void SimRun() {
        Console.WriteLine("== 深渊矿队 MINER_SIM 平衡模拟 ==");
        // 场景 A:纯手玩 3600s
        SimOne("A 手玩60min(自动买卖关闭)", false);
        // 场景 B:自动矿务 Lv1 起步
        Game g2 = Game.New();
        g2.coreLv[6] = 1;
        SimOneWith(g2, "B 自动矿务60min");
        // 场景 C:二期玩法面(契约/首杀表/称谓/碎片回收)——不影响 A/B 基线
        Game g3 = Game.New();
        for (int i = 0; i < 30; i = i + 1) { g3.BuyHire(0); }
        g3.jin = 1e9; g3.cry = 100;
        int cF = g3.ContractFight();
        int cP = g3.ContractFight();
        g3.floor = 9; g3.killStreak = 99;
        double cry0 = g3.cry;
        g3.OnKill(false);
        Console.WriteLine("-- C 二期玩法: 契约免费=" + cF + " 付费=" + cP
            + " 首杀位=" + g3.bossKilled + " 契约后萤晶=" + Game.FmtNum(g3.cry)
            + " 碎片=" + g3.prism + " 称谓mask=" + g3.titleMask
            + " relics=" + g3.relics.Count);
    }

    static void SimOne(string title, bool dummy) {
        Game g = Game.New();
        SimOneWith(g, title);
        _ = dummy;
    }

    static void SimOneWith(Game g, string title) {
        double dt = 0.1;
        long clicks = 0;   // 模拟玩家每 2s 买一次
        double nextBuy = 2;
        for (double t = 0; t < 3600; t = t + dt) {
            g.Tick(dt, false);
            if (t >= nextBuy) {
                nextBuy = t + 2;
                // 贪心:优先雇佣,买得起就买
                bool bought = true;
                while (bought) {
                    bought = false;
                    int bestT = -1;
                    double bestC = 1e30;
                    for (int ty = 0; ty < 6; ty = ty + 1) {
                        if (!g.TypeUnlocked(ty)) { continue; }
                        double c = g.HireCost(ty);
                        if (c < bestC && g.Cur(g.UD[ty].cur) >= c) { bestC = c; bestT = ty; }
                    }
                    int bestU = -1;
                    for (int i = 0; i < 14; i = i + 1) {
                        if (!g.UpUnlocked(i)) { continue; }
                        if (g.UPD[i].maxLv > 0 && g.upLv[i] >= g.UPD[i].maxLv) { continue; }
                        double c = g.UpCost(i);
                        if (c < bestC && g.Cur(g.UPD[i].cur) >= c) { bestC = c; bestU = i; }
                    }
                    if (bestT >= 0) { g.BuyHire(bestT); bought = true; clicks = clicks + 1; }
                    else if (bestU >= 0) { g.BuyUp(bestU); bought = true; clicks = clicks + 1; }
                }
            }
            // 每 120s 输出一次快照
            if (((int)t) % 600 == 0 && t > 0 && Math.Abs(t - ((long)t / 600) * 600) < dt / 2) {
                Console.WriteLine("t=" + (int)t + "s floor=" + (g.floor + 1)
                    + " crew=" + g.crew.Count
                    + " tie=" + Game.FmtNum(g.tie) + " tong=" + Game.FmtNum(g.tong)
                    + " jin=" + Game.FmtNum(g.jin) + " cry=" + Game.FmtNum(g.cry)
                    + " dps=" + Game.FmtNum(g.EstDps()));
            }
        }
        Console.WriteLine("-- " + title + " 结果: floor=" + (g.floor + 1) + " best=" + (g.best + 1)
            + " kills=" + Game.FmtNum(g.kills) + " crew=" + g.crew.Count
            + " avgCrew=" + Game.FmtNum(g.CrewAvg())
            + " cry=" + Game.FmtNum(g.cry) + " cores=" + Game.FmtNum(g.cores)
            + " relics=" + g.relics.Count + " (eq " + g.EquippedCount() + ")"
            + " equips=" + g.equips.Count + " (eq " + g.EquipEquippedCount() + ")"
            + " forge=" + g.forgeLv + " astro=" + g.AstroCount(0) + "/" + g.AstroCount(1) + "/" + g.AstroCount(2)
            + " CoresFor=" + Game.FmtNum(g.CoresFor())
            + " buys=" + clicks);
    }
}
