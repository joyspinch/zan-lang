    public SdlTexture texDim;      // 浮层暗化遮罩贴图(替代整屏纯色矩形)
    public SdlTexture texMobNormal; // 怪物立绘
    public SdlTexture texMobBoss;   // 首领立绘
    public SdlTexture[] texIcon;    // 5 枚货币图标
    public SdlTexture[] texCrew;    // 6 类矿工圆徽(矿队页+矿井页矿工行)
    public SdlTexture[] texTab;     // 4 枚页签图标(矿井/矿队/深渊/设置)
