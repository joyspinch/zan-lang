    // ---------------------------------------------------------------
    // 存档
    // ---------------------------------------------------------------
    public static string SavePath() {
        // 存档固定放在 exe 目录,不依赖当前工作目录
        return Assets.ExeDir() + "/legend_save.txt";
    }
    public void Save() {
        string sp = Game.SavePath();
        List<string> lines = new List<string>();
        lines.Add("v=1");
        lines.Add("name=" + this.p.name);
        lines.Add("cls=" + this.p.cls);
        lines.Add("lv=" + this.p.lv);
        lines.Add("xp=" + this.p.xp);
        lines.Add("turn=" + this.p.turn);
        lines.Add("bossk=" + this.p.bossKilled);
        lines.Add("kills=" + this.p.totalKills);
        lines.Add("vip=" + this.p.vip);
        lines.Add("charge=" + this.p.chargeTotal);
        for (int i = 0; i < Data.CUR_COUNT; i = i + 1) {
            lines.Add("cur" + i + "=" + this.p.cur[i]);
        }
        lines.Add("hjf=" + this.p.hjFloor);
        lines.Add("hjk=" + this.p.hjKills);
        lines.Add("hjt=" + this.p.hjTarget);
        lines.Add("hjb=" + this.p.hjBest);
        lines.Add("hjkacc=" + this.p.hjKillAcc);
        lines.Add("mjf=" + this.p.mjFloor);
        lines.Add("mjk=" + this.p.mjKills);
        lines.Add("mjb=" + this.p.mjBest);
        lines.Add("mju=" + this.p.mjUnlocked);
        for (int i = 0; i < 8; i = i + 1) {
            lines.Add("bh" + i + "=" + this.p.bhKilled[i]);
        }
        lines.Add("bhl=" + this.p.bhTriesLeft);
        lines.Add("ts=" + this.p.lastSeenTs);
        lines.Add("lkt=" + this.lastKillTs);
        lines.Add("d=" + this.p.lastDayTs);
        lines.Add("tpage=" + this.p.titlePage);
        lines.Add("trank=" + this.p.titleRank);
        lines.Add("don=" + this.p.donateAcc);
        lines.Add("nt=" + this.p.nobleTier);
        for (int i = 0; i < 5; i = i + 1) {
            lines.Add("wx" + i + "=" + this.p.wuxingMs[i]);
        }
        for (int i = 0; i < this.p.cardMaskLen; i = i + 1) {
            lines.Add("cm" + i + "=" + this.p.cardMask[i]);
        }
        lines.Add("tupu=" + this.p.tupuScore);
        lines.Add("dtc=" + this.p.dtCount);
        lines.Add("xbt=" + this.p.xbTickets);
        lines.Add("altm=" + this.p.altarMyProg);
        lines.Add("altg=" + this.p.altarGlobalProg);
        lines.Add("pkl=" + this.p.pkTriesLeft);
        lines.Add("ybl=" + this.p.ybTriesLeft);
        lines.Add("jbl=" + this.p.jbTriesLeft);
        lines.Add("tow=" + this.p.towerBest);
        lines.Add("city=" + this.p.cityOwned);
        lines.Add("cityms=" + this.p.cityLastMs);
        lines.Add("wbd=" + this.p.wbDamage);
        lines.Add("wbl=" + this.p.wbTriesLeft);
        lines.Add("gh=" + (this.p.hasGuild ? 1 : 0));
        lines.Add("ghn=" + this.p.guildName);
        lines.Add("ghg=" + this.p.guildGold);
        lines.Add("gha=" + this.p.guildAccTs);
        // 材料(逗号串)
        string mat = "";
        for (int i = 0; i < Data.MAT_COUNT; i = i + 1) {
            mat = mat + this.p.mats[i];
            if (i < Data.MAT_COUNT - 1) { mat = mat + ","; }
        }
        lines.Add("mat=" + mat);
        lines.Add("achv=" + this.p.achvMask);
        lines.Add("achvc=" + this.p.achvClaimed);
        lines.Add("wbw=" + this.p.wbWindowEndMs);
        lines.Add("bagsz=" + this.p.bagSizeBase);
        lines.Add("sbo=" + (this.p.sbkOwned ? 1 : 0));
        lines.Add("sbw=" + this.p.sbkWins);
        lines.Add("sbd=" + this.p.sbkDayMs);
        lines.Add("sbt=" + this.p.sbkTaxMs);
        lines.Add("rbs=" + this.p.rbSent);
        lines.Add("rbg=" + this.p.rbGot);
        lines.Add("rbd=" + this.p.rbDayMs);
        lines.Add("rbr=" + this.p.rbGrabMs);
        lines.Add("pkh=" + this.p.pkHourMs);
        lines.Add("wfd=" + this.p.welfareDayMs);
        string ng = "";
        for (int i = 0; i < 8; i = i + 1) {
            ng = ng + this.p.neigongLv[i];
            if (i < 7) { ng = ng + ","; }
        }
        lines.Add("ng=" + ng);
        // 图鉴 9×10(实存 Item,与背包同款序列化;空槽 = -1)
        string alb = "";
        for (int i = 0; i < this.p.albumSlots.Length; i = i + 1) {
            Item it = this.p.albumSlots[i];
            if (it == null) { alb = alb + "-1"; }
            else { alb = alb + it.slot + ":" + it.tier + ":" + it.coef + ":" + it.cls + ":" + it.seed; }
            if (i < this.p.albumSlots.Length - 1) { alb = alb + ";"; }
        }
        lines.Add("alb=" + alb);
        lines.Add("stc=" + this.p.studentCount);
        lines.Add("mc=" + this.p.mailCnt);
        for (int i = 0; i < 8; i = i + 1) {
            lines.Add("mt" + i + "=" + this.p.mailTitle[i]);
        }
        lines.Add("cc=" + this.p.chatCnt);
        for (int i = 0; i < this.p.chatCnt && i < 80; i = i + 1) {
            lines.Add("cl" + i + "=" + this.p.chatLog[i]);
        }
        lines.Add("bs=" + this.rkSeed);
        // 装备
        string eq = "";
        for (int i = 0; i < Data.SLOT_COUNT; i = i + 1) {
            Item it = this.p.equip[i];
            if (it == null) { eq = eq + "-1"; }
            else { eq = eq + it.slot + ":" + it.tier + ":" + it.coef + ":" + it.cls + ":" + it.seed; }
            if (i < Data.SLOT_COUNT - 1) { eq = eq + ";"; }
        }
        lines.Add("eq=" + eq);
        // 背包
        string bg = "";
        for (int i = 0; i < this.p.bagCnt && i < 60; i = i + 1) {
            Item it = this.p.bag[i];
            if (it == null) { bg = bg + "-1"; }
            else { bg = bg + it.slot + ":" + it.tier + ":" + it.coef + ":" + it.cls + ":" + it.seed; }
            if (i < this.p.bagCnt - 1) { bg = bg + ";"; }
        }
        lines.Add("bg=" + bg);
        lines.Add("bgc=" + this.p.bagCnt);

        // 写文件
        File.WriteAllLines(sp, lines);
    }

    static int ParseIdx(string s, int start) {
        int v = 0;
        bool neg = false;
        int i = start;
        if (i < s.Length && s.Substring(i, 1) == "-") { neg = true; i = i + 1; }
        while (i < s.Length) {
            string c = s.Substring(i, 1);
            if (c >= "0" && c <= "9") { v = v * 10 + Game.DigitOf(c); }
            else { break; }
            i = i + 1;
        }
        if (neg) { v = -v; }
        return v;
    }
    static Item ParseItem(string s) {
        if (s == null || s.Length < 3) { return null; }
        if (s.Substring(0, 1) == "-") { return null; }
        int[] parts = new int[5];
        int pi = 0;
        int vi = 0;
        int cur = 0;
        int[] vals = new int[5];
        int nv = 0;
        while (vi < s.Length && nv < 5) {
            string c = s.Substring(vi, 1);
            if (c == ":") {
                vals[nv] = cur;
                nv = nv + 1;
                cur = 0;
                vi = vi + 1;
            } else if (c >= "0" && c <= "9") {
                cur = cur * 10 + Game.DigitOf(c);
                vi = vi + 1;
            } else {
                break;
            }
        }
        if (nv < 4) {
            vals[nv] = cur;
        }
        return Item.New(vals[0], vals[1], vals[2], vals[3], vals[4]);
    }

    public bool Load() {
        string sp = Game.SavePath();
        if (!File.Exists(sp)) { return false; }
        List<string> lines = File.ReadAllLines(sp);
        this.p = new Player();
        for (int li = 0; li < lines.Count; li = li + 1) {
            string ln = lines[li];
            int eq = ln.IndexOf("=");
            if (eq < 0) { continue; }
            string k = ln.Substring(0, eq);
            string v = ln.Substring(eq + 1);
            if (k == "name") { this.p.name = v; }
            else if (k == "cls") { this.p.cls = Game.ParseIntS(v); }
            else if (k == "lv") { this.p.lv = Game.ParseIntS(v); }
            else if (k == "xp") { this.p.xp = Game.ParseLongS(v); }
            else if (k == "turn") { this.p.turn = Game.ParseIntS(v); }
            else if (k == "bossk") { this.p.bossKilled = Game.ParseLongS(v); }
            else if (k == "kills") { this.p.totalKills = Game.ParseLongS(v); }
            else if (k == "vip") { this.p.vip = Game.ParseIntS(v); }
            else if (k == "charge") { this.p.chargeTotal = Game.ParseLongS(v); }
            else if (k.Length == 4 && k.Substring(0, 3) == "cur") {
                int idx = Game.ParseIntS(k.Substring(3, 1));
                if (idx >= 0 && idx < Data.CUR_COUNT) { this.p.cur[idx] = Game.ParseLongS(v); }
            }
            else if (k == "hjf") { this.p.hjFloor = Game.ParseIntS(v); }
            else if (k == "hjk") { this.p.hjKills = Game.ParseIntS(v); }
            else if (k == "hjt") { this.p.hjTarget = Game.ParseIntS(v); }
            else if (k == "hjb") { this.p.hjBest = Game.ParseIntS(v); }
            else if (k == "hjkacc") { this.p.hjKillAcc = Game.ParseLongS(v); }
            else if (k == "mjf") { this.p.mjFloor = Game.ParseIntS(v); }
            else if (k == "mjk") { this.p.mjKills = Game.ParseIntS(v); }
            else if (k == "mjb") { this.p.mjBest = Game.ParseIntS(v); }
            else if (k == "mju") { this.p.mjUnlocked = Game.ParseIntS(v); }
            else if (k == "bhl") { this.p.bhTriesLeft = Game.ParseIntS(v); }
            else if (k.Length == 3 && k.Substring(0, 2) == "bh") {
                int idx = Game.DigitOf(k.Substring(2, 1));
                if (idx >= 0 && idx < 8) { this.p.bhKilled[idx] = Game.ParseIntS(v); }
            }
            else if (k == "ts") { this.p.lastSeenTs = Game.ParseLongS(v); }
            else if (k == "lkt") { this.lastKillTs = Game.ParseLongS(v); }
            else if (k == "d") { this.p.lastDayTs = Game.ParseLongS(v); }
            else if (k == "tpage") { this.p.titlePage = Game.ParseIntS(v); }
            else if (k == "trank") { this.p.titleRank = Game.ParseIntS(v); }
            else if (k == "don") { this.p.donateAcc = Game.ParseLongS(v); }
            else if (k == "nt") { this.p.nobleTier = Game.ParseIntS(v); }
            else if (k.Length == 3 && k.Substring(0, 2) == "wx") {
                int idx = Game.DigitOf(k.Substring(2, 1));
                if (idx >= 0 && idx < 5) { this.p.wuxingMs[idx] = Game.ParseLongS(v); }
            }
            else if (k.Length >= 3 && k.Substring(0, 2) == "cm") {
                int idx = Game.ParseIntS(k.Substring(2, k.Length - 2));
                if (idx >= 0 && idx < this.p.cardMaskLen) { this.p.cardMask[idx] = Game.ParseIntS(v); }
            }
            else if (k == "tupu") { this.p.tupuScore = Game.ParseLongS(v); }
            else if (k == "dtc") { this.p.dtCount = Game.ParseIntS(v); }
            else if (k == "xbt") { this.p.xbTickets = Game.ParseIntS(v); }
            else if (k == "altm") { this.p.altarMyProg = Game.ParseIntS(v); }
            else if (k == "altg") { this.p.altarGlobalProg = Game.ParseIntS(v); }
            else if (k == "pkl") { this.p.pkTriesLeft = Game.ParseIntS(v); }
            else if (k == "ybl") { this.p.ybTriesLeft = Game.ParseIntS(v); }
            else if (k == "jbl") { this.p.jbTriesLeft = Game.ParseIntS(v); }
            else if (k == "tow") { this.p.towerBest = Game.ParseIntS(v); }
            else if (k == "city") { this.p.cityOwned = Game.ParseIntS(v); }
            else if (k == "cityms") { this.p.cityLastMs = Game.ParseLongS(v); }
            else if (k == "wbd") { this.p.wbDamage = Game.ParseLongS(v); }
            else if (k == "wbl") { this.p.wbTriesLeft = Game.ParseIntS(v); }
            else if (k == "gh") { this.p.hasGuild = (Game.ParseIntS(v) != 0); }
            else if (k == "ghn") { this.p.guildName = v; }
            else if (k == "ghg") { this.p.guildGold = Game.ParseLongS(v); }
            else if (k == "gha") { this.p.guildAccTs = Game.ParseLongS(v); }
            else if (k == "mat") {
                // 逗号分隔的材料数量
                int mi = 0;
                string cur2 = "";
                for (int j = 0; j <= v.Length; j = j + 1) {
                    if (j == v.Length || v.Substring(j, 1) == ",") {
                        if (mi < Data.MAT_COUNT && cur2 != "") { this.p.mats[mi] = Game.ParseIntS(cur2); }
                        mi = mi + 1;
                        cur2 = "";
                    } else { cur2 = cur2 + v.Substring(j, 1); }
                }
            }
            else if (k == "achv") { this.p.achvMask = Game.ParseLongS(v); }
            else if (k == "achvc") { this.p.achvClaimed = Game.ParseIntS(v); }
            else if (k == "wbw") { this.p.wbWindowEndMs = Game.ParseLongS(v); }
            else if (k == "bagsz") { this.p.bagSizeBase = Game.ParseIntS(v); }
            else if (k == "sbo") { this.p.sbkOwned = (Game.ParseIntS(v) != 0); }
            else if (k == "sbw") { this.p.sbkWins = Game.ParseIntS(v); }
            else if (k == "sbd") { this.p.sbkDayMs = Game.ParseLongS(v); }
            else if (k == "sbt") { this.p.sbkTaxMs = Game.ParseLongS(v); }
            else if (k == "rbs") { this.p.rbSent = Game.ParseLongS(v); }
            else if (k == "rbg") { this.p.rbGot = Game.ParseLongS(v); }
            else if (k == "rbd") { this.p.rbDayMs = Game.ParseLongS(v); }
            else if (k == "rbr") { this.p.rbGrabMs = Game.ParseLongS(v); }
            else if (k == "pkh") { this.p.pkHourMs = Game.ParseLongS(v); }
            else if (k == "wfd") { this.p.welfareDayMs = Game.ParseLongS(v); }
            else if (k == "ng") {
                int ni = 0;
                string ncur = "";
                for (int j = 0; j <= v.Length; j = j + 1) {
                    if (j == v.Length || v.Substring(j, 1) == ",") {
                        if (ni < 8 && ncur != "") { this.p.neigongLv[ni] = Game.ParseIntS(ncur); }
                        ni = ni + 1;
                        ncur = "";
                    } else { ncur = ncur + v.Substring(j, 1); }
                }
            }
            else if (k == "alb") {
                int aslot = 0;
                string acur = "";
                for (int j = 0; j <= v.Length; j = j + 1) {
                    if (j == v.Length || v.Substring(j, 1) == ";") {
                        if (aslot < this.p.albumSlots.Length) {
                            this.p.albumSlots[aslot] = Game.ParseItem(acur);
                            aslot = aslot + 1;
                        }
                        acur = "";
                    } else { acur = acur + v.Substring(j, 1); }
                }
            }
            else if (k == "stc") { this.p.studentCount = Game.ParseIntS(v); }
            else if (k == "mc") { this.p.mailCnt = Game.ParseIntS(v); }
            else if (k.Length >= 3 && k.Substring(0, 2) == "mt") {
                int idx = Game.ParseIntS(k.Substring(2, k.Length - 2));
                if (idx >= 0 && idx < 8) { this.p.mailTitle[idx] = v; }
            }
            else if (k == "cc") { this.p.chatCnt = Game.ParseIntS(v); }
            else if (k.Length >= 3 && k.Substring(0, 2) == "cl") {
                int idx = Game.ParseIntS(k.Substring(2, k.Length - 2));
                if (idx >= 0 && idx < 80) { this.p.chatLog[idx] = v; }
            }
            else if (k == "bs") { this.rkSeed = Game.ParseLongS(v); }
            else if (k == "eq") {
                // parse multi slot
                string cur = "";
                for (int j = 0; j <= v.Length; j = j + 1) {
                    if (j == v.Length || v.Substring(j, 1) == ";") {
                        if (cur != "") {
                            int comma = cur.IndexOf(":");
                            if (comma <= 0) { continue; }
                            int slot = Game.ParseIntS(cur.Substring(0, comma));
                            if (slot >= 0 && slot < Data.SLOT_COUNT) {
                                this.p.equip[slot] = Game.ParseItem(cur);
                            }
                        }
                        cur = "";
                    } else { cur = cur + v.Substring(j, 1); }
                }
            }
            else if (k == "bg") {
                int slot = 0;
                string cur = "";
                for (int j = 0; j <= v.Length; j = j + 1) {
                    if (j == v.Length || v.Substring(j, 1) == ";") {
                        if (cur != "" && slot < 60) {
                            this.p.bag[slot] = Game.ParseItem(cur);
                            slot = slot + 1;
                        }
                        cur = "";
                    } else { cur = cur + v.Substring(j, 1); }
                }
            }
            else if (k == "bgc") { this.p.bagCnt = Game.ParseIntS(v); }
        }
        // 重建 Rng
        this.rng = Rng.Seed(this.rkSeed);
        // 重生怪物
        this.SpawnMonster(this.p.hjFloor, this.IsBossFloor(this.p.hjFloor));
        return true;
    }
}