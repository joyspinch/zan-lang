// 传奇放置挂机 — 状态模型 + 核心机制。
// 一切运行时状态、战斗/洗炼/回收/寻宝/影子榜种子都在这里。UI 只读不写,
// 通过 Game 的 public 方法推进。
using System;
using System.IO;
using SDL3;
using GameKit;

namespace Legend;

// 单件装备(背包与装备共用)
class Item {
    public int slot;       // Data.SLOT_* 槽位
    public int tier;       // 0..4 (普通..传说)
    public int coef;       // 系数 (1..TIER_COEF_CAP[tier])
    public int cls;        // 0..7 EQUIP_CLASS_NAMES
    public int seed;       // Rng 种子(用于复现属性)

    public static Item New(int slot, int tier, int coef, int cls, int seed) {
        Item it = new Item();
        it.slot = slot;
        it.tier = tier;
        it.coef = coef;
        it.cls = cls;
        it.seed = seed;
        return it;
    }
    public string Name() {
        return Data.EQUIP_CLASS_NAMES[this.cls] + "+" + this.coef;
    }
    public string IconKey() {
        return "equip_c" + this.cls + "_t" + this.tier;
    }
}

// 玩家完整状态(可序列化)
class Player {
    public string name;       // 角色名(默认"看见啥的就是")
    public int cls;           // 0 战士 / 1 法师 / 2 道士
    public int lv;            // 当前等级
    public long xp;           // 累计经验
    public int turn;          // 转生次数(0..9)
    public long bossKilled;   // 累计击破 BOSS 层数(用于转生判定)
    public long totalKills;   // 累计击杀数(称谓用)
    public long[] cur = new long[Data.CUR_COUNT]; // 货币
    public int vip;           // 0 普通 / 1 终身 / 2 超会
    public long chargeTotal;  // 累计充值(分)

    // 装备 12 槽
    public Item[] equip = new Item[Data.SLOT_COUNT];
    // 背包(最多 60 格)
    public Item[] bag = new Item[60];
    public int bagCnt;
    // 仓库(简化:不单独实现,合并到背包上限 200)

    // 幻境
    public int hjFloor;        // 当前层
    public int hjKills;        // 当前层已击杀数
    public int hjTarget;       // 当前层目标击杀数
    public int hjBest;         // 历史最高层
    public long hjKillAcc;     // 幻境累计击杀
    // 秘境
    public int mjUnlocked;
    public int mjBest;
    public int mjFloor;
    public int mjKills;

    // BOSS 之家
    public int[] bhKilled = new int[8];  // 每只击破次数(今日)
    public int bhTriesLeft;
    public long lastDayTs;     // 日刷新锚
    public long lastSeenTs;    // 离线锚

    // 称谓
    public int titlePage;      // 当前页(0..20)
    public int titleRank;      // 当前阶(0..4)
    public long titleMask;     // 21×5 已解锁位图

    // 爵位
    public long donateAcc;     // 累计捐献元宝
    public int nobleTier;      // 0..5

    // 五行
    public long[] wuxingMs = new long[5];   // 各槽累计修炼毫秒

    // 将星图谱:8 池 × 12 卡 × 10 转
    public int[] cardMask;     // bit = 已激活(8*12*10 = 960 位;ActivateCard 按 32 位/字索引 → 需 30 个 int)
    public int cardMaskLen = 30;
    public long tupuScore;     // 图谱积分

    // 图鉴 9 组 × 10 槽:实存 Item,镶入后无法取出(木桶原理计加成)
    public Item[] albumSlots = new Item[Data.ALBUM_GROUPS * Data.ALBUM_SLOTS];

    // 沙巴克
    public bool sbkOwned;      // 我的行会占领中
    public int sbkWins;        // 累计攻克次数
    public long sbkDayMs;      // 上次攻城时间(日门槛)
    public long sbkTaxMs;      // 上次收税时间

    // 每日福利
    public long welfareDayMs;  // 上次领取日锚(每日 1 次)

    // 内功:8 槽 × 0..100 级(TP 点升级,加成 = 等级 × 0.2% 全属性)
    public int[] neigongLv = new int[8];
    public int tpPoints;       // 可用 TP 点

    // 红包(影子群)
    public long rbSent;        // 累计发出(元宝)
    public long rbGot;         // 累计收回(元宝/红包币)
    public long rbDayMs;       // 首封红包日锚(+声望)
    public long rbGrabMs;      // 上次抢红包时间(日门槛)

    // 至尊极品殿堂:5 页(每页只记一件当前最强)
    public Item[] dtBest = new Item[5];
    public int dtCount;        // 已登记件数

    // 寻宝
    public int xbTickets;      // 当前寻宝图
    public long xbLastDayMs;
    public int[] xbPool;       // 今日奖池 12 项抽奖次数

    // 祭坛
    public int altarMyProg;    // 个人进度
    public int altarGlobalProg;

    // 商店/回收/铁匠铺
    public long shopLastDayMs;

    // 排行榜:自己的快照(用于影子榜生成)
    public long rkGold;
    public int rkLevel;

    // PK / 押镖 / 钱庄 / 塔 / 师徒
    public int pkTriesLeft;
    public long pkHourMs;      // 上次小时薪结算锚
    public int ybTriesLeft;
    public int jbTriesLeft;
    public int towerBest;
    public int cityOwned;      // -1 无 / 0..7
    public long cityLastMs;
    public int masterTier;     // 0=无师父 1=已拜师 2=师父
    public string masterName;
    public int studentCount;

    // 邮箱附件(8 格)
    public Item[] mailAttach = new Item[8];
    public long[] mailQty = new long[8];
    public string[] mailTitle = new string[8];
    public int mailCnt;

    // 聊天/广播 log(最多 80 条)
    public string[] chatLog = new string[80];
    public int chatCnt;
    public long lastBroadcastMs;

    // 世界 BOSS 伤害(今日)
    public long wbDamage;
    public int wbTriesLeft;
    public long wbWindowEndMs;   // 30 秒挑战窗口截止(0=未开战)

    // 材料(MAT_COUNT 种),存档按逗号串
    public int[] mats = new int[Data.MAT_COUNT];

    // 成就:48 位点亮位 + 高 48 位已领取
    public long achvMask;
    public int achvClaimed;

    // 帮会
    public bool hasGuild;
    public string guildName;
    public long guildGold;
    public long guildAccTs;      // 行会资产离线累积锚

    // 设置
    public bool bossKey;        // F10 一键隐藏
    public double uiScale;      // 80..300
    public bool silent;         // 静默战斗
    public int filterMinCoef;   // 装备过滤:只保留 ≥ 此系数
    public int bagSizeBase = 60;

    // 沙巴克、行会战等纯展示用
    public int pkRankPos;       // 影子榜当前位置

    public Player() {
        this.cardMask = new int[this.cardMaskLen];
        this.titleMask = 0;
        for (int i = 0; i < Data.CUR_COUNT; i = i + 1) { this.cur[i] = 0; }
        this.mats = new int[Data.MAT_COUNT];
    }
}

// 主游戏逻辑容器(全局单例)
class Game {
    public Player p;           // 当前玩家
    public Rng rng;            // 玩家 Rng(种子由 best 派生)
    public bool bossMode;      // F10 老板键隐藏态(UI 用)

    // 全服影子榜种子(派生自玩家 best,确定性)
    public long rkSeed;

    // 战斗瞬时状态
    public long curMonsterHp;  // 当前怪 HP
    public long curMonsterHpMax;
    public int curMonsterLvl;
    public bool curIsBoss;
    public int curMonsterIcon; // 0 普通 1 BOSS
    public string curMonsterName;

    // 飘字 / 战斗日志(简化)
    public string battleLog;
    public long lastHitTs;
    public long totalDamageDealt;
    // 出手节拍累加器(秒),不存档
    public double atkAcc;
    // 自动换装开关(掉落即穿更强的一件)
    public bool autoEquip;
    // 自动重置开关:卡层 60 秒无击杀自动退一层(PRD 4.1"卡层自动处理")
    public bool autoReset;
    public long lastKillTs;    // 最近一次击杀(ms),自动重置判定用
    // 秘境挂机模式(会话内开关,不存档;开启后主区战斗走秘境数值)
    public bool mjMode;

    public Game() {
        this.p = new Player();
        this.bossMode = false;
        this.autoEquip = true;
        this.autoReset = true;
        this.mjMode = false;
    }

    // ---------------------------------------------------------------
    // 初始化
    // ---------------------------------------------------------------
    public void NewGame(string name, int cls) {
        this.p = new Player();
        this.p.name = name;
        this.p.cls = cls;
        this.p.lv = 1;
        this.p.xp = 0;
        this.p.turn = 0;
        this.p.bagCnt = 0;
        for (int i = 0; i < Data.SLOT_COUNT; i = i + 1) { this.p.equip[i] = null; }
        // 初始货币
        this.p.cur[Data.CUR_GOLD] = 1000;
        this.p.cur[Data.CUR_YB] = 100;
        this.p.cur[Data.CUR_SW] = 50;
        // 初始幻境
        this.p.hjFloor = 1;
        this.p.hjKills = 0;
        this.p.hjTarget = Data.HJ_KILL_TARGET;
        // 初始 Rng 种子
        long seed = 1234567L ^ ((long)cls * 1009L);
        this.rng = Rng.Seed(seed);
        this.rkSeed = seed;
        // 初始怪物
        this.SpawnMonster(this.p.hjFloor, false);
        this.lastKillTs = Game.NowMs();
        // 初始日锚
        this.p.lastDayTs = Game.NowMs();
        this.p.lastSeenTs = this.p.lastDayTs;
        // 初始寻宝图
        this.p.xbTickets = 3;
        // 初始寻宝奖池(DayReset 也会清空重置;此处先分配,避免首日日刷新前打开寻宝面板崩)
        this.p.xbPool = new int[Data.XB_POOL_SIZE];
        // 初始免费装备:1 件 t0 武器
        Item starter = Item.New(Data.SLOT_WEAPON, 0, 1, 0, 1);
        this.AddToBag(starter);
        // BOSS 之家次数
        this.p.bhTriesLeft = Data.BOSS_HOME_TRIES;
        // PK 次数
        this.p.pkTriesLeft = Data.PK_TRIES;
        // 押镖/劫镖
        this.p.ybTriesLeft = Data.YABIAO_TRIES;
        this.p.jbTriesLeft = Data.JIEBIAO_TRIES;
        // 世界 BOSS
        this.p.wbTriesLeft = Data.WORLD_BOSS_TRIES;
        // 邮箱
        this.p.mailCnt = 0;
        // 聊天
        this.p.chatCnt = 0;
        this.AddChat("欢迎进入传奇世界");
        this.AddChat("请先到「地图传送」选择地图,然后开始挂机");
        this.AddChat("提示:点 幻境 可直接进入挂机");
    }

    // ---------------------------------------------------------------
    // 时间与日刷新
    // ---------------------------------------------------------------
    public static long NowMs() {
        return (long)(DateTime.UtcNow().ToUnixSeconds() * 1000.0);
    }
    public bool IsNewDay() {
        long now = Game.NowMs();
        return now - this.p.lastDayTs >= Data.DAY_MS;
    }
    public void DayReset() {
        // 每日刷新的资源
        this.p.bhTriesLeft = Data.BOSS_HOME_TRIES;
        this.p.pkTriesLeft = Data.PK_TRIES;
        this.p.ybTriesLeft = Data.YABIAO_TRIES;
        this.p.jbTriesLeft = Data.JIEBIAO_TRIES;
        this.p.wbTriesLeft = Data.WORLD_BOSS_TRIES;
        this.p.wbDamage = 0;
        this.p.wbWindowEndMs = 0;
        this.p.altarMyProg = 0;
        this.p.altarGlobalProg = (int)(this.rng.Range(4000, 6500));
        // 寻宝奖池:清空
        this.p.xbPool = new int[Data.XB_POOL_SIZE];
        this.p.xbLastDayMs = Game.NowMs();
        // 终身会员签到送寻宝图
        if (this.p.vip >= 1) { this.p.xbTickets = this.p.xbTickets + 2; }
        if (this.p.vip >= 2) { this.p.xbTickets = this.p.xbTickets + 3; }
        this.p.lastDayTs = Game.NowMs();
        this.AddChat("[系统] 每日 0 点刷新:寻宝奖池 / 个人 BOSS 次数 / 押镖次数");
        // 沙巴克每日状态检查(影子行会可能反扑)
        this.ShabakeLoseCheck();
    }

    // ---------------------------------------------------------------
    // 材料系统(黑铁/祝福油/符文/龙珠/魂灵/金砖/灵石/钥匙/号角/屠龙/天书)
    // ---------------------------------------------------------------
    public int MatCount(int m) {
        if (m < 0 || m >= Data.MAT_COUNT) { return 0; }
        return this.p.mats[m];
    }
    public bool MatTake(int m, int n) {
        if (m < 0 || m >= Data.MAT_COUNT) { return false; }
        if (this.p.mats[m] < n) { return false; }
        this.p.mats[m] = this.p.mats[m] - n;
        return true;
    }
    public void MatAdd(int m, int n) {
        if (m < 0 || m >= Data.MAT_COUNT || n <= 0) { return; }
        if (this.p.mats[m] < 0) { this.p.mats[m] = 0; }
        this.p.mats[m] = this.p.mats[m] + n;
    }
    public void MatAddMsg(int m, int n) {
        this.MatAdd(m, n);
        this.AddChat("[材料] 获得 " + Data.MAT_NAMES[m] + "×" + n);
    }
    // 3 个同号符文 → 高 1 号(14# 已满级)
    public bool MergeRune(int rune1) {
        int idx = rune1 - 1;
        if (idx < 0 || idx >= Data.MAT_RUNE14) { return false; }
        if (!this.MatTake(rune1, Data.RUNE_MERGE_COUNT)) { return false; }
        this.MatAddMsg(rune1 + 1, 1);
        this.AddChat("[符文] " + Data.MAT_NAMES[rune1] + "×3 合成 " + Data.MAT_NAMES[rune1 + 1]);
        return true;
    }
    // 建行会:除金币外还需沃玛号角
    public bool HasHorn() { return this.MatCount(Data.MAT_HORN) > 0; }

    // ---------------------------------------------------------------
    // 每日福利(签到):每日 1 次,金币 + 转生加成;连续性由日锚判断
    // ---------------------------------------------------------------
    public bool ClaimWelfare() {
        long now = Game.NowMs();
        if (now - this.p.welfareDayMs < Data.DAY_MS) {
            this.AddChat("[福利] 今日已领取,明日 0 点再来");
            return false;
        }
        long gold = 50000L + this.p.turn * 25000L;
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] + gold;
        // 会员加发寻宝图
        if (this.p.vip >= 1) { this.MatAddMsg(Data.MAT_GOLDKEY, 1); }
        this.p.welfareDayMs = now;
        this.AddChat("[福利] 每日福利领取 " + this.FormatNum(gold) + " 金币");
        return true;
    }

    // ---------------------------------------------------------------
    // 符文降级(PRD §7.4):2# 以上 = 黑铁×10 换低 1 号
    // ---------------------------------------------------------------
    public bool DowngradeRune(int rune1) {
        if (rune1 <= Data.MAT_RUNE1 || rune1 > Data.MAT_RUNE14) {
            this.AddChat("[符文] 该符文无法降级");
            return false;
        }
        if (!this.MatTake(rune1, 1)) {
            this.AddChat("[符文] 没有该符文");
            return false;
        }
        if (!this.MatTake(Data.MAT_BLACK_IRON, 10)) {
            this.MatAdd(rune1, 1);   // 退回
            this.AddChat("[符文] 黑铁矿石不足,需 ×10");
            return false;
        }
        this.MatAddMsg(rune1 - 1, 1);
        this.AddChat("[符文] 降级:" + Data.MAT_NAMES[rune1] + " → " + Data.MAT_NAMES[rune1 - 1]);
        return true;
    }

    // ---------------------------------------------------------------
    // 内功(PRD §7.7):8 槽 × 0..100 级,TP 点升级;等级 ×0.2% 全属性
    // TP 来源:等级 ×5 + 转生 ×100(升级/转生时随属性刷新)
    // ---------------------------------------------------------------
    public int TpTotal() {
        return this.p.lv * 5 + this.p.turn * 100;
    }
    public int TpUsed() {
        int used = 0;
        for (int i = 0; i < 8; i = i + 1) { used = used + this.p.neigongLv[i]; }
        return used;
    }
    public bool NeigongUp(int slot) {
        if (slot < 0 || slot >= 8) { return false; }
        if (this.p.neigongLv[slot] >= 100) {
            this.AddChat("[内功] 该槽已满级(100)");
            return false;
        }
        if (this.TpUsed() >= this.TpTotal()) {
            this.AddChat("[内功] TP 不足(升级/转生可获得 TP)");
            return false;
        }
        this.p.neigongLv[slot] = this.p.neigongLv[slot] + 1;
        this.AddChat("[内功] 第 " + (slot + 1) + " 槽升至 "
                     + this.p.neigongLv[slot] + " 级");
        return true;
    }
    public int NeigongLvSum() {
        int s = 0;
        for (int i = 0; i < 8; i = i + 1) { s = s + this.p.neigongLv[i]; }
        return s;
    }

    // ---------------------------------------------------------------
    // 玩家属性计算
    // ---------------------------------------------------------------
    public int BaseHp() {
        if (this.p.cls == 0) { return Data.BASE_HP_W + (int)((this.p.lv - 1) * 4.5); }
        if (this.p.cls == 1) { return Data.BASE_HP_M + (int)((this.p.lv - 1) * 3.0); }
        return Data.BASE_HP_T + (int)((this.p.lv - 1) * 3.8);
    }
    public int BaseMp() {
        if (this.p.cls == 0) { return Data.BASE_MP_W + (int)((this.p.lv - 1) * 1.0); }
        if (this.p.cls == 1) { return Data.BASE_MP_M + (int)((this.p.lv - 1) * 4.0); }
        return Data.BASE_MP_T + (int)((this.p.lv - 1) * 3.2);
    }
    public int BaseAcMin() {
        double b = 0;
        if (this.p.cls == 0) { b = Data.BASE_AC_W; }
        else if (this.p.cls == 1) { b = Data.BASE_AC_M; }
        else { b = Data.BASE_AC_T; }
        return (int)(b + (this.p.lv - 1) * (1.6 + this.p.turn * 0.4));
    }
    public int BaseAcMax() {
        return (int)(this.BaseAcMin() * 1.18);
    }
    public int BaseDef() {
        return Data.BASE_DEF + (int)((this.p.lv - 1) * 0.8);
    }
    public int BaseMDef() {
        return Data.BASE_MDEF + (int)((this.p.lv - 1) * 0.8);
    }

    // 装备总加成(12 槽)
    public int EquipAtk() {
        int v = 0;
        for (int i = 0; i < Data.SLOT_COUNT; i = i + 1) {
            Item it = this.p.equip[i];
            if (it == null) { continue; }
            double tierMult = Data.TIER_ATK[it.tier];
            double clsMult = Data.EQUIP_CLASS_ATK_BIAS[it.cls];
            v = v + (int)(tierMult * clsMult * it.coef * (1.0 + it.coef * 0.18));
        }
        return v;
    }
    public int EquipDef() {
        int v = 0;
        for (int i = 0; i < Data.SLOT_COUNT; i = i + 1) {
            Item it = this.p.equip[i];
            if (it == null) { continue; }
            double tierMult = Data.TIER_DEF[it.tier];
            double clsMult = Data.EQUIP_CLASS_DEF_BIAS[it.cls];
            v = v + (int)(tierMult * clsMult * it.coef * 0.9);
        }
        return v;
    }
    public int EquipHp() {
        int v = 0;
        for (int i = 0; i < Data.SLOT_COUNT; i = i + 1) {
            Item it = this.p.equip[i];
            if (it == null) { continue; }
            double tierMult = Data.TIER_HP[it.tier];
            double clsMult = Data.EQUIP_CLASS_HP_BIAS[it.cls];
            v = v + (int)(tierMult * clsMult * it.coef * 12);
        }
        return v;
    }

    // 全属性(基础 + 装备 + 爵位 + 五行 + 将星 + 图鉴 + 殿堂 + 装备基数)
    public int TotalAcMin() {
        int raw = this.BaseAcMin() + this.EquipAtk();
        double pct = this.AllPct();
        return (int)(raw * (1.0 + pct));
    }
    public int TotalAcMax() {
        int raw = this.BaseAcMax() + this.EquipAtk();
        double pct = this.AllPct();
        return (int)(raw * (1.0 + pct));
    }
    public int TotalDef() {
        int raw = this.BaseDef() + this.EquipDef();
        double pct = this.AllPct();
        return (int)(raw * (1.0 + pct));
    }
    public int TotalMDef() {
        return (int)((this.BaseMDef() + this.EquipDef() / 2) * (1.0 + this.AllPct()));
    }
    public int TotalHp() {
        return this.BaseHp() + this.EquipHp();
    }
    // 出手速度:基础值 + 等级与转生加成(仅用于压缩出手间隔)
    public int TotalSpeed() {
        int s = Data.BASE_SPEED;
        s = s + this.p.lv / 20;
        s = s + this.p.turn * 2;
        return s;
    }
    public double AllPct() {
        double pct = 0;
        if (this.p.nobleTier >= 0) {
            pct = pct + Data.NOBLE_ALL_PCT[this.p.nobleTier];
        }
        // 五行加成(简化为每槽 0.5% × 修为阶)
        long maxWx = 0;
        for (int i = 0; i < 5; i = i + 1) {
            if (this.p.wuxingMs[i] > maxWx) { maxWx = this.p.wuxingMs[i]; }
        }
        int wxLvl = (int)(maxWx / 3600000L);  // 1h 修为 = 1 阶
        if (wxLvl > 100) { wxLvl = 100; }
        pct = pct + wxLvl * 0.002;
        // 将星加成(简化:每张已激活 +0.05%)
        int cards = 0;
        for (int i = 0; i < this.p.cardMaskLen; i = i + 1) {
            int m = this.p.cardMask[i];
            while (m > 0) { cards = cards + (m & 1); m = m >> 1; }
        }
        pct = pct + cards * 0.0005;
        // 殿堂登记 +0.5%
        pct = pct + this.p.dtCount * 0.005;
        // 内功:8 槽等级和 ×0.2%
        pct = pct + this.NeigongLvSum() * 0.002;
        // 图鉴:每件 +1%,整组镶满再 +5%(木桶原理)
        int fullGroups = this.AlbumFullGroups();
        pct = pct + this.AlbumCount() * Data.ALBUM_PCT_PER_ITEM
                  + fullGroups * Data.ALBUM_PCT_FULL_GROUP;
        return pct;
    }

    // ---------------------------------------------------------------
    // 经验与升级
    // ---------------------------------------------------------------
    public long ExpForLv(int lv) {
        return (long)(Data.EXP_BASE * Math.Pow(lv, Data.EXP_POW));
    }
    public int MaxLv() {
        return Data.MAX_LV_PER_TURN_BASE + Data.MAX_LV_PER_TURN_STEP * this.p.turn;
    }
    public void GainXp(long amount) {
        if (this.p.lv >= this.MaxLv()) {
            // 已满级(需转生才能继续升级):经验不再累积,避免数值虚高
            this.p.xp = 0;
            return;
        }
        this.p.xp = this.p.xp + amount;
        while (this.p.lv < this.MaxLv()) {
            long need = this.ExpForLv(this.p.lv);
            if (this.p.xp < need) { break; }
            this.p.xp = this.p.xp - need;
            this.p.lv = this.p.lv + 1;
            this.AddChat("[系统] 恭喜升级到 " + this.p.lv + " 级");
            // 升级广播(触发系统广播)
            this.battleLog = "升级 +" + this.p.lv;
        }
    }
    public bool CanTurn() {
        if (this.p.turn >= Data.TURN_MAX) { return false; }
        if (this.p.lv < Data.MAX_LV_PER_TURN_BASE) { return false; }
        int next = this.p.turn + 1;
        if (this.p.bossKilled < Data.TURN_REQ_BOSS[next]) { return false; }
        return true;
    }
    public void DoTurn() {
        if (!this.CanTurn()) { return; }
        this.p.turn = this.p.turn + 1;
        // 转生回 1 级,获得转生加成
        this.p.lv = 1;
        this.p.xp = 0;
        // 转生附赠:声望 + 转生 × 1000
        this.p.cur[Data.CUR_SW] = this.p.cur[Data.CUR_SW] + this.p.turn * 1000;
        // 激活秘境
        if (this.p.turn >= Data.MJ_UNLOCK_TURN) { this.p.mjUnlocked = 1; }
        this.AddChat("[系统] 转生成功!当前 " + this.p.turn + " 转");
    }

    // ---------------------------------------------------------------
    // 幻境战斗
    // ---------------------------------------------------------------
    // 只算数值、不改动战斗状态(离线结算探层用)
    public static long MonsterHpOf(int floor, bool isBoss) {
        if (floor < 1) { floor = 1; }
        double hp = Data.HJ_HP_BASE * Math.Pow(Data.HJ_HP_GROWTH, floor - 1);
        if (isBoss) { hp = hp * Data.HJ_BOSS_HP_MULT; }
        return (long)hp;
    }

    public void SpawnMonster(int floor, bool isBoss) {
        this.curIsBoss = isBoss;
        double hp = Data.HJ_HP_BASE * Math.Pow(Data.HJ_HP_GROWTH, floor - 1);
        double atk = Data.HJ_ATK_BASE * Math.Pow(Data.HJ_ATK_GROWTH, floor - 1);
        if (isBoss) {
            hp = hp * Data.HJ_BOSS_HP_MULT * (1.0 + this.p.turn * 0.4);
            atk = atk * Data.HJ_BOSS_ATK_MULT * (1.0 + this.p.turn * 0.3);
        }
        // 秘境倍率(显式负层 或 主区秘境挂机模式)
        if (floor < 0 || this.mjMode) {
            hp = hp * Data.MJ_HP_MULT;
            atk = atk * Data.MJ_ATK_MULT;
        }
        this.curMonsterHpMax = (long)hp;
        this.curMonsterHp = this.curMonsterHpMax;
        this.curMonsterLvl = (int)(floor * 1.2 + 5);
        this.curMonsterIcon = isBoss ? 1 : 0;
        this.curMonsterName = isBoss ? ("层 BOSS·第" + floor + "层") : this.MonsterName(floor);
    }
    public string MonsterName(int floor) {
        // 简易命名:基于楼层取词根
        string[] pre = new string[10];
        pre[0] = "半兽人"; pre[1] = "多钩猫"; pre[2] = "钉耙猫";
        pre[3] = "蝎子";   pre[4] = "稻草人"; pre[5] = "沃玛";
        pre[6] = "祖玛";   pre[7] = "赤月";   pre[8] = "魔龙";
        pre[9] = "牛魔";
        int idx = floor / 20;
        if (idx > 9) { idx = 9; }
        string suf = "";
        int tier = floor / 50;
        if (tier >= 1) { suf = "·精英"; }
        if (tier >= 3) { suf = "·强化"; }
        return pre[idx] + suf;
    }

    // 地图传送(PRD 4.4):选择挂机场景。门槛层以上即可传送,
    // 传送 = 把幻境推层进度挪到该地图的起始层(数值全由既有曲线接管)。
    public bool SelectMap(int idx) {
        if (idx < 0 || idx >= 20) { return false; }
        if (this.p.hjBest < Data.MAP_MIN_FLOOR[idx]) {
            this.AddChat("[地图] 「" + Data.MAP_NAMES[idx] + "」需历史最高 "
                         + Data.MAP_MIN_FLOOR[idx] + " 层,当前最高 " + this.p.hjBest + " 层");
            return false;
        }
        int from = this.p.hjFloor;
        this.p.hjFloor = Data.MAP_MIN_FLOOR[idx];
        this.p.hjKills = 0;
        this.p.hjTarget = Data.HJ_KILL_TARGET + this.p.hjFloor / 4;
        this.SpawnMonster(this.p.hjFloor, this.IsBossFloor(this.p.hjFloor));
        this.AddChat("[地图] 传送至「" + Data.MAP_NAMES[idx] + "」"
                     + this.p.hjFloor + " 层(原 " + from + " 层)");
        return true;
    }

    public void StepIdle(double dt) {
        // 自动战斗:按出手节拍推进,而不是每帧一刀。
        long now = Game.NowMs();
        if (this.p.hjFloor <= 0) { this.p.hjFloor = 1; }
        if (this.curMonsterHp <= 0 || this.curMonsterName == null) {
            this.SpawnMonster(this.p.hjFloor, this.IsBossFloor(this.p.hjFloor));
        }
        this.atkAcc = this.atkAcc + dt;
        double interval = this.AtkInterval();
        if (this.atkAcc < interval) { return; }
        // 一次结算最多补 4 刀(长时间卡顿 / 追帧时防爆炸)
        int guard = 0;
        while (this.atkAcc >= interval && guard < 4) {
            this.atkAcc = this.atkAcc - interval;
            guard = guard + 1;
            this.DoOneHit(now);
        }
        this.AutoResetTick(now);
    }

    // 出手间隔:基础 ATK_INTERVAL,受速度属性压缩(下限 0.35s)
    public double AtkInterval() {
        double spd = (double)this.TotalSpeed();
        double iv = Data.ATK_INTERVAL * 12.0 / (12.0 + spd - (double)Data.BASE_SPEED);
        if (iv < 0.35) { iv = 0.35; }
        if (iv > Data.ATK_INTERVAL * 2.0) { iv = Data.ATK_INTERVAL * 2.0; }
        return iv;
    }

    public void DoOneHit(long now) {
        // 一刀:先判定是否命中(命中率随等级差),再结算伤害
        if (this.curMonsterHp <= 0) { return; }
        int dmgMin = this.TotalAcMin();
        int dmgMax = this.TotalAcMax();
        int dmg = (int)(dmgMin + (dmgMax - dmgMin) * this.rng.NextDouble01());
        if (dmg < 1) { dmg = 1; }
        long hit = dmg;
        this.curMonsterHp = this.curMonsterHp - hit;
        this.lastHitTs = now;
        this.totalDamageDealt = this.totalDamageDealt + hit;
        if (this.curMonsterHp <= 0) {
            this.OnMonsterKilled(now);
        }
    }

    public bool IsBossFloor(int f) {
        return f > 0 && (f % Data.HJ_BOSS_EVERY) == 0;
    }

    public void OnMonsterKilled(long now) {
        bool boss = this.curIsBoss;
        int floor = this.p.hjFloor;
        double gold = Data.HJ_KILL_GOLD * Math.Pow(Data.REWARD_GOLD_GROWTH, floor - 1);
        double xp = Data.HJ_KILL_XP * Math.Pow(Data.REWARD_XP_GROWTH, floor - 1);
        double sw = Data.HJ_KILL_SW * Math.Pow(Data.REWARD_SW_GROWTH, floor - 1);
        if (boss) {
            gold = gold * Data.HJ_BOSS_GOLD_MULT;
            xp = xp * Data.HJ_BOSS_XP_MULT;
            sw = sw * Data.HJ_BOSS_SW_MULT;
        }
        // 秘境挂机:奖励乘秘境系数,击杀计入秘境进度
        if (this.mjMode) {
            gold = gold * Data.MJ_GOLD_MULT;
            xp = xp * Data.MJ_XP_MULT;
            this.p.mjKills = this.p.mjKills + 1;
            this.p.mjFloor = floor;
            if (floor > this.p.mjBest) { this.p.mjBest = floor; }
        }
        // 转生加成
        double turnMult = 1.0 + this.p.turn * 0.25;
        gold = gold * turnMult;
        xp = xp * turnMult;
        sw = sw * turnMult;

        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] + (long)gold;
        this.p.cur[Data.CUR_SW] = this.p.cur[Data.CUR_SW] + (long)sw;
        this.GainXp((long)xp);

        // 击杀计数
        this.p.hjKillAcc = this.p.hjKillAcc + 1;
        this.p.totalKills = this.p.totalKills + 1;
        this.p.hjKills = this.p.hjKills + 1;
        this.lastKillTs = now;

        // BOSS 击破 → 累计击破数(转生用)
        if (boss) {
            this.p.bossKilled = this.p.bossKilled + 1;
            // 全服广播
            string sender = this.ShadowName();
            this.AddBroadcast("[" + sender + "] 在幻境第 " + floor + " 层击杀 BOSS 获得 "
                              + (int)gold + " 金币!");
        }

        // 装备掉落(普通怪 HJ_DROP_RATE,BOSS 必掉)
        if (boss || this.rng.NextDouble01() < Data.HJ_DROP_RATE) {
            this.DropEquip(floor, boss);
        }

        // 当前层目标达成 → 下一层(PRD 4.1:清怪 → BOSS 首杀过关)
        if (this.p.hjKills >= this.p.hjTarget) {
            this.p.hjFloor = this.p.hjFloor + 1;
            this.p.hjKills = 0;
            this.p.hjTarget = Data.HJ_KILL_TARGET + this.p.hjFloor / 4;
            if (this.p.hjFloor > this.p.hjBest) { this.p.hjBest = this.p.hjFloor; }
            // 过关提示:BOSS 层即将出现,给玩家一个"再打一层就睡"的钩子
            if (this.IsBossFloor(this.p.hjFloor)) {
                this.AddChat("[幻境] 进入第 " + this.p.hjFloor
                             + " 层,本层有守关 BOSS!");
            } else if (this.p.hjFloor % 10 == 1 && this.p.hjFloor > 1) {
                // 每 10 层进入新地图带(取 MAP_NAMES 门槛),顺带提示可传送
                for (int i = 19; i >= 0; i = i - 1) {
                    if (Data.MAP_MIN_FLOOR[i] == this.p.hjFloor) {
                        this.AddChat("[幻境] 抵达「" + Data.MAP_NAMES[i]
                                     + "」地界(第 " + this.p.hjFloor + " 层)");
                        break;
                    }
                }
            }
            // 自动重生下一层怪
            this.SpawnMonster(this.p.hjFloor, this.IsBossFloor(this.p.hjFloor));
        } else {
            // 重生同层怪
            this.SpawnMonster(this.p.hjFloor, this.IsBossFloor(this.p.hjFloor));
        }
    }

    // 自动重置(PRD 4.1):卡层 60 秒无击杀 → 退一层重新清怪
    public void AutoResetTick(long now) {
        if (!this.autoReset) { return; }
        if (this.p.hjFloor <= 1) { return; }
        if (this.lastKillTs <= 0) { this.lastKillTs = now; return; }
        if (now - this.lastKillTs < 60000) { return; }
        this.p.hjFloor = this.p.hjFloor - 1;
        this.p.hjKills = 0;
        this.p.hjTarget = Data.HJ_KILL_TARGET + this.p.hjFloor / 4;
        this.lastKillTs = now;
        this.SpawnMonster(this.p.hjFloor, this.IsBossFloor(this.p.hjFloor));
        this.AddChat("[幻境] 卡层超时,自动重置到第 " + this.p.hjFloor + " 层");
    }

    public void DropEquip(int floor, bool boss) {
        // 根据品阶概率表抽取
        double r = this.rng.NextDouble01();
        int tier = 0;
        double cum = 0;
        for (int t = 0; t < 5; t = t + 1) {
            cum = cum + Data.TIER_DROP_RATE[t];
            if (r < cum) { tier = t; break; }
            tier = t;
        }
        // 系数:基于品阶 + 楼层 + BOSS 加成
        int cap = Data.TIER_COEF_CAP[tier];
        // 系数随楼层放大:每 10 层 +1,保证高层掉落跟得上 HP 曲线
        int coef = 1 + floor / Data.EQUIP_COEF_PER_FLOOR + (int)(this.rng.Range(0, cap));
        if (coef < 1) { coef = 1; }
        if (boss) {
            coef = coef + (int)(this.rng.Range(0, 2));
            if (coef > cap) { coef = cap; }
        }
        int cls = (int)this.rng.Range(0, 8);
        int slot = cls;  // cN 直接映射到 N 槽(简化)
        if (slot >= Data.SLOT_COUNT) { slot = Data.SLOT_COUNT - 1; }
        int seed = (int)this.rng.Range(1, 1000000);
        Item it = Item.New(slot, tier, coef, cls, seed);
        this.AddToBag(it);
        if (boss) {
            this.AddChat("[掉落] 传说!获得 " + it.Name());
        } else if (tier >= 3) {
            this.AddChat("[掉落] 高品质 " + it.Name());
        }
    }

    public bool AddToBag(Item it) {
        if (it == null) { return false; }
        // 自动换装:掉落若为当前槽更强的一件,直接穿上,换下的进背包
        if (this.autoEquip && it.slot >= 0 && it.slot < Data.SLOT_COUNT) {
            Item cur = this.p.equip[it.slot];
            int newScore = it.tier * 1000000 + it.coef;
            int curScore = -1;
            if (cur != null) { curScore = cur.tier * 1000000 + cur.coef; }
            if (newScore > curScore) {
                Item old = cur;
                this.p.equip[it.slot] = it;
                if (old != null) { this.PushBag(old); }
                return true;
            }
        }
        // 优先堆叠(同类同 tier 同 coef 视为不同件,简化:直接找空位)
        for (int i = 0; i < this.p.bagCnt; i = i + 1) {
            if (this.p.bag[i] == null) {
                this.p.bag[i] = it;
                return true;
            }
        }
        return this.PushBag(it);
    }

    // 背包尾部入一件;满了返回 false
    public bool PushBag(Item it) {
        if (this.p.bagCnt >= 60) {
            this.AddChat("[系统] 背包已满,部分装备未获得");
            return false;
        }
        this.p.bag[this.p.bagCnt] = it;
        this.p.bagCnt = this.p.bagCnt + 1;
        return true;
    }

    // ---------------------------------------------------------------
    // 离线结算
    // ---------------------------------------------------------------
    public void OfflineSettle() {
        long now = Game.NowMs();
        long ms = now - this.p.lastSeenTs;
        if (ms < 1000) { ms = 1000; }  // 最小 1s 防止抖动
        int cap = Data.OFFLINE_CAP_HOURS * 3600 * 1000;
        if (this.p.vip >= 1) { cap = Data.OFFLINE_CAP_VIP[1] * 3600 * 1000; }
        if (this.p.vip >= 2) { cap = Data.OFFLINE_CAP_VIP[2] * 3600 * 1000; }
        if (ms > cap) { ms = cap; }
        double sec = ms / 1000.0;
        // 节拍:每 OFFLINE_BEAT 秒一只怪
        double beat = Data.OFFLINE_BEAT;
        int kills = (int)(sec / beat);
        if (kills <= 0) { return; }
        // 与在线共用同一套结算规则:累计奖励 + 推层 + 掉落(满包自动回收)
        long totalGold = 0;
        long totalXp = 0;
        long totalSw = 0;
        int floorStart = this.p.hjFloor;
        int dropped = 0;
        int recycled = 0;
        int actualKills = 0;
        // 防御:离线只结算"打得过"的层。一次战力检查,超出则停在当前层。
        long atk = this.TotalAcMax();
        for (int i = 0; i < kills; i = i + 1) {
            int floor = this.p.hjFloor;
            // 本层怪 HP 超过战力 * 8 刀 → 卡层,不再往下推
            long mhp = Game.MonsterHpOf(floor, false);
            if (mhp > atk * 8 && floor > floorStart) { break; }
            bool boss = this.IsBossFloor(floor)
                        && (this.p.hjKills + 1) >= this.p.hjTarget;
            double gold = Data.HJ_KILL_GOLD * Math.Pow(Data.REWARD_GOLD_GROWTH, floor - 1);
            double xp = Data.HJ_KILL_XP * Math.Pow(Data.REWARD_XP_GROWTH, floor - 1);
            double sw = Data.HJ_KILL_SW * Math.Pow(Data.REWARD_SW_GROWTH, floor - 1);
            if (boss) {
                gold = gold * Data.HJ_BOSS_GOLD_MULT;
                xp = xp * Data.HJ_BOSS_XP_MULT;
                sw = sw * Data.HJ_BOSS_SW_MULT;
            }
            double turnMult = 1.0 + this.p.turn * 0.25;
            totalGold = totalGold + (long)(gold * turnMult);
            totalXp = totalXp + (long)(xp * turnMult);
            totalSw = totalSw + (long)(sw * turnMult);

            // 掉落:满包则折算成金币(自动回收),避免离线把包塞死
            bool drop = boss || this.rng.NextDouble01() < Data.HJ_DROP_RATE;
            if (drop) {
                if (this.p.bagCnt < 60) {
                    this.DropEquip(floor, boss);
                    dropped = dropped + 1;
                } else {
                    totalGold = totalGold + (long)(Data.HJ_KILL_GOLD * Math.Pow(Data.REWARD_GOLD_GROWTH, floor - 1) * 3.0);
                    recycled = recycled + 1;
                }
            }

            // 与 OnMonsterKilled 同一套推层规则
            actualKills = actualKills + 1;
            this.p.hjKills = this.p.hjKills + 1;
            if (boss) { this.p.bossKilled = this.p.bossKilled + 1; }
            if (this.p.hjKills >= this.p.hjTarget) {
                this.p.hjFloor = this.p.hjFloor + 1;
                this.p.hjKills = 0;
                this.p.hjTarget = Data.HJ_KILL_TARGET + this.p.hjFloor / 4;
                if (this.p.hjFloor > this.p.hjBest) { this.p.hjBest = this.p.hjFloor; }
            }
        }
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] + totalGold;
        this.p.cur[Data.CUR_SW] = this.p.cur[Data.CUR_SW] + totalSw;
        this.GainXp(totalXp);
        this.p.totalKills = this.p.totalKills + actualKills;
        // 五行修为累积
        for (int i = 0; i < 5; i = i + 1) {
            this.p.wuxingMs[i] = this.p.wuxingMs[i] + (long)((double)ms * 0.2);
        }
        this.AddChat("[离线] 离线 " + (int)(sec / 3600) + " 时 " + ((int)(sec / 60) % 60)
                     + " 分,消灭 " + kills + " 怪,获得 " + totalGold + " 金币 / "
                     + totalXp + " 经验 / " + totalSw + " 声望");
        if (this.p.hjFloor > floorStart) {
            this.AddChat("[离线] 幻境推进 " + floorStart + " → " + this.p.hjFloor + " 层");
        }
        if (recycled > 0) {
            this.AddChat("[离线] 背包已满," + recycled + " 件装备自动回收为金币");
        }
        // 重生当前层怪,回来即可接着打
        this.SpawnMonster(this.p.hjFloor, this.IsBossFloor(this.p.hjFloor));
        this.p.lastSeenTs = now;
        this.lastKillTs = now;
    }

    // ---------------------------------------------------------------
    // 装备操作
    // ---------------------------------------------------------------
    public void EquipFromBag(int bagIdx) {
        if (bagIdx < 0 || bagIdx >= this.p.bagCnt) { return; }
        Item it = this.p.bag[bagIdx];
        if (it == null) { return; }
        int slot = it.slot;
        if (slot < 0 || slot >= Data.SLOT_COUNT) { return; }
        // 卸下原装备 → 背包
        Item old = this.p.equip[slot];
        this.p.equip[slot] = it;
        this.p.bag[bagIdx] = old;
        if (old != null && this.p.bagCnt < 60) {
            // 已就位,无需再 add
        }
        this.AddChat("[装备] " + it.Name() + " 已装备");
    }
    public void UnequipToBag(int slot) {
        if (slot < 0 || slot >= Data.SLOT_COUNT) { return; }
        Item it = this.p.equip[slot];
        if (it == null) { return; }
        if (this.p.bagCnt >= 60) {
            this.AddChat("[系统] 背包已满");
            return;
        }
        this.p.bag[this.p.bagCnt] = it;
        this.p.bagCnt = this.p.bagCnt + 1;
        this.p.equip[slot] = null;
    }

    // ---------------------------------------------------------------
    // 洗炼
    // ---------------------------------------------------------------
    public bool RefineGold(int bagIdx) {
        if (bagIdx < 0 || bagIdx >= this.p.bagCnt) { return false; }
        Item it = this.p.bag[bagIdx];
        if (it == null) { return false; }
        // 洗炼上限 = 当前系数 + 品阶头room(楼层掉落已放大系数,固定上限会把装备削回去)
        int cap = it.coef + Data.TIER_COEF_CAP[it.tier];
        int cost = (int)(Data.GOLD_REFINE_COST_BASE * Math.Pow(it.coef, Data.GOLD_REFINE_COST_POW));
        if (this.p.cur[Data.CUR_GOLD] < cost) {
            this.AddChat("[系统] 金币不足,需 " + cost);
            return false;
        }
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] - cost;
        double r = this.rng.NextDouble01();
        int delta = (int)(this.rng.Range(1, (int)Data.GOLD_REFINE_DELTA + 1));
        if (r < Data.GOLD_REFINE_DOWN_RATE) {
            // 降低
            it.coef = it.coef - delta;
            if (it.coef < 1) { it.coef = 1; }
            this.AddChat("[洗炼] 系数降低为 +" + it.coef);
        } else {
            it.coef = it.coef + delta;
            if (it.coef > cap) { it.coef = cap; }
            this.AddChat("[洗炼] 系数提升为 +" + it.coef);
        }
        return true;
    }
    public bool RefineYb(int bagIdx) {
        if (bagIdx < 0 || bagIdx >= this.p.bagCnt) { return false; }
        Item it = this.p.bag[bagIdx];
        if (it == null) { return false; }
        int cap = Data.TIER_COEF_CAP[it.tier];
        int cost = Data.YB_REFINE_COST_BASE + (int)(it.coef * 5);
        if (this.p.cur[Data.CUR_YB] < cost) {
            this.AddChat("[系统] 元宝不足,需 " + cost);
            return false;
        }
        this.p.cur[Data.CUR_YB] = this.p.cur[Data.CUR_YB] - cost;
        // 保底:必定 +1,且有 10% 概率 +5
        it.coef = it.coef + 1;
        if (it.coef > cap) { it.coef = cap; }
        if (this.rng.NextDouble01() < Data.YB_REFINE_PCT) {
            it.coef = it.coef + 4;
            if (it.coef > cap) { it.coef = cap; }
            this.AddChat("[元宝洗炼] 系数跃升为 +" + it.coef);
        } else {
            this.AddChat("[元宝洗炼] 系数提升为 +" + it.coef);
        }
        return true;
    }
    public bool UpgradeEquip(int bagIdx) {
        if (bagIdx < 0 || bagIdx >= this.p.bagCnt) { return false; }
        Item it = this.p.bag[bagIdx];
        if (it == null) { return false; }
        // 简化:消耗金币代替黑铁
        long cost = 5000 + it.tier * 3000;
        if (this.p.cur[Data.CUR_GOLD] < cost) {
            this.AddChat("[系统] 金币不足,需 " + cost);
            return false;
        }
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] - cost;
        double rate = Data.UPGRADE_RATE + it.tier * 0.05;
        if (this.rng.NextDouble01() < rate) {
            it.tier = it.tier + 1;
            if (it.tier > 4) { it.tier = 4; }
            this.AddChat("[升级] 装备升阶为 " + Data.EQUIP_TIER_NAMES[it.tier]);
        } else {
            this.AddChat("[升级] 锻造失败");
        }
        return true;
    }

    // ---------------------------------------------------------------
    // 铁匠铺 11 模式(2..10 为本轮补全的真逻辑)
    // ---------------------------------------------------------------
    // 2 幸运传承:把已选装备的品阶+系数整体传给另一件同槽装备(源销毁)
    public bool InheritLucky(int srcIdx, int dstIdx) {
        if (srcIdx < 0 || srcIdx >= this.p.bagCnt) { return false; }
        if (dstIdx < 0 || dstIdx >= this.p.bagCnt) { return false; }
        if (srcIdx == dstIdx) { return false; }
        Item s = this.p.bag[srcIdx];
        Item d = this.p.bag[dstIdx];
        if (s == null || d == null) { return false; }
        if (s.slot != d.slot) { this.AddChat("[传承] 只能传给同槽位的装备"); return false; }
        long cost = 200000L;
        if (this.p.cur[Data.CUR_GOLD] < cost) { this.AddChat("[系统] 金币不足,需 " + cost); return false; }
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] - cost;
        // 目标取两者较高评分,源消失
        int bestTier = s.tier > d.tier ? s.tier : d.tier;
        int bestCoef = (s.tier > d.tier ? s : d).coef;
        d.tier = bestTier;
        d.coef = bestCoef;
        // 移除源
        for (int i = srcIdx; i < this.p.bagCnt - 1; i = i + 1) { this.p.bag[i] = this.p.bag[i + 1]; }
        this.p.bag[this.p.bagCnt - 1] = null;
        this.p.bagCnt = this.p.bagCnt - 1;
        this.AddChat("[传承] 传承完成 → " + d.Name() + " +" + d.coef);
        return true;
    }
    // 3 淬炼锻造:黑铁×8,必 +1 系数(t4 上限按当前+品阶头room)
    public bool ForgeQuench(int bagIdx) {
        if (bagIdx < 0 || bagIdx >= this.p.bagCnt) { return false; }
        Item it = this.p.bag[bagIdx];
        if (it == null) { return false; }
        if (!this.MatTake(Data.MAT_BLACK_IRON, Data.RUNEWORD_BLACK_IRON)) {
            this.AddChat("[淬炼] 黑铁矿石不足,需 ×" + Data.RUNEWORD_BLACK_IRON);
            return false;
        }
        int cap = it.coef + Data.TIER_COEF_CAP[it.tier];
        it.coef = it.coef + 1;
        if (it.coef > cap) { it.coef = cap; }
        this.AddChat("[淬炼] " + it.Name() + " 系数提升为 +" + it.coef);
        return true;
    }
    // 4 符文锻造:符文N# ×1 + 金币,按符文号提升系数(高级符文更多)
    public bool ForgeRune(int bagIdx, int rune1) {
        if (bagIdx < 0 || bagIdx >= this.p.bagCnt) { return false; }
        Item it = this.p.bag[bagIdx];
        if (it == null) { return false; }
        if (rune1 < Data.MAT_RUNE1 || rune1 > Data.MAT_RUNE14) { return false; }
        if (!this.MatTake(rune1, 1)) { this.AddChat("[符文锻造] 缺少 " + Data.MAT_NAMES[rune1]); return false; }
        long cost = 10000L * (rune1 - Data.MAT_RUNE1 + 1);
        if (this.p.cur[Data.CUR_GOLD] < cost) {
            this.MatAdd(rune1, 1);   // 退料
            this.AddChat("[系统] 金币不足,需 " + cost);
            return false;
        }
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] - cost;
        int cap = it.coef + Data.TIER_COEF_CAP[it.tier];
        it.coef = it.coef + (rune1 - Data.MAT_RUNE1 + 2);
        if (it.coef > cap) { it.coef = cap; }
        this.AddChat("[符文锻造] 注入 " + Data.MAT_NAMES[rune1] + " → +" + it.coef);
        return true;
    }
    // 5 灵符锻造:灵符 ×(10+tier*5),提升品阶(必成,t4 封顶)
    public bool ForgeLingFu(int bagIdx) {
        if (bagIdx < 0 || bagIdx >= this.p.bagCnt) { return false; }
        Item it = this.p.bag[bagIdx];
        if (it == null) { return false; }
        if (it.tier >= 4) { this.AddChat("[灵符锻造] 已是传说品阶"); return false; }
        int cost = 10 + it.tier * 5;
        if (this.p.cur[Data.CUR_LF] < cost) { this.AddChat("[系统] 灵符不足,需 " + cost); return false; }
        this.p.cur[Data.CUR_LF] = this.p.cur[Data.CUR_LF] - cost;
        it.tier = it.tier + 1;
        this.AddChat("[灵符锻造] 升阶为 " + Data.EQUIP_TIER_NAMES[it.tier]);
        return true;
    }
    // 6 符文之语:传说装备 + 黑铁×8 + 符文5#×1 → 全属性微幅重掷(系数上调)
    public bool ForgeRuneword(int bagIdx) {
        if (bagIdx < 0 || bagIdx >= this.p.bagCnt) { return false; }
        Item it = this.p.bag[bagIdx];
        if (it == null) { return false; }
        if (it.tier < 4) { this.AddChat("[符文之语] 只对传说装备有效"); return false; }
        if (!this.MatTake(Data.MAT_BLACK_IRON, Data.RUNEWORD_BLACK_IRON)) {
            this.AddChat("[符文之语] 黑铁矿石不足,需 ×" + Data.RUNEWORD_BLACK_IRON);
            return false;
        }
        if (!this.MatTake(Data.MAT_RUNE1 + 4, 1)) {
            this.MatAdd(Data.MAT_BLACK_IRON, Data.RUNEWORD_BLACK_IRON);
            this.AddChat("[符文之语] 缺少 符文5#");
            return false;
        }
        long cost = 1000000L;
        if (this.p.cur[Data.CUR_GOLD] < cost) {
            this.MatAdd(Data.MAT_BLACK_IRON, Data.RUNEWORD_BLACK_IRON);
            this.MatAdd(Data.MAT_RUNE1 + 4, 1);
            this.AddChat("[系统] 金币不足,需 " + cost);
            return false;
        }
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] - cost;
        int cap = it.coef + Data.TIER_COEF_CAP[it.tier];
        int delta = 2 + (int)this.rng.Range(0, 4);
        it.coef = it.coef + delta;
        if (it.coef > cap) { it.coef = cap; }
        this.AddChat("[符文之语] 符文之语激活!系数跃升至 +" + it.coef);
        return true;
    }
    // 7 龙珠锻造:龙珠1★+2★+3★ 各1 → 系数 +3
    public bool ForgeDragon(int bagIdx) {
        if (bagIdx < 0 || bagIdx >= this.p.bagCnt) { return false; }
        Item it = this.p.bag[bagIdx];
        if (it == null) { return false; }
        if (!this.MatTake(Data.MAT_DRAGON1, 1) || !this.MatTake(Data.MAT_DRAGON1 + 1, 1)
            || !this.MatTake(Data.MAT_DRAGON3, 1)) {
            // 退回已扣的
            this.MatAdd(Data.MAT_DRAGON1, 1);
            this.MatAdd(Data.MAT_DRAGON1 + 1, 1);
            this.MatAdd(Data.MAT_DRAGON3, 1);
            this.AddChat("[龙珠锻造] 需要 龙珠1★/2★/3★ 各 1");
            return false;
        }
        int cap = it.coef + Data.TIER_COEF_CAP[it.tier];
        it.coef = it.coef + Data.DRAGON_FORGE_COEF;
        if (it.coef > cap) { it.coef = cap; }
        this.AddChat("[龙珠锻造] 集齐三星龙珠!系数 +3 → +" + it.coef);
        return true;
    }
    // 8 天书传承:消耗天书×1,把当前装备系数复制给另一件同槽装备
    public bool ForgeTomeCopy(int srcIdx, int dstIdx) {
        if (srcIdx < 0 || srcIdx >= this.p.bagCnt) { return false; }
        if (dstIdx < 0 || dstIdx >= this.p.bagCnt) { return false; }
        if (srcIdx == dstIdx) { return false; }
        Item s = this.p.bag[srcIdx];
        Item d = this.p.bag[dstIdx];
        if (s == null || d == null) { return false; }
        if (s.slot != d.slot) { this.AddChat("[天书传承] 只能传给同槽位的装备"); return false; }
        if (!this.MatTake(Data.MAT_TOME, 1)) { this.AddChat("[天书传承] 缺少 天书"); return false; }
        d.coef = s.coef;
        this.AddChat("[天书传承] 系数 " + s.coef + " 已复制到 " + d.Name());
        return true;
    }
    // 9 传说锻造:屠龙宝刀(神)×1 + 5000万金 → 直接造一件 t4 满系数武器
    public bool ForgeTulong() {
        if (!this.MatTake(Data.MAT_TULONG, 1)) { this.AddChat("[传说锻造] 缺少 屠龙宝刀"); return false; }
        long cost = 50000000L;
        if (this.p.cur[Data.CUR_GOLD] < cost) {
            this.MatAdd(Data.MAT_TULONG, 1);
            this.AddChat("[系统] 金币不足,需 " + cost);
            return false;
        }
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] - cost;
        Item t = Item.New(Data.SLOT_WEAPON, 4, Data.TIER_COEF_CAP[4], 0, (int)this.rng.Range(1, 1000000));
        if (this.AddToBag(t)) {
            this.AddBroadcast("[传说锻造]铸成神器·" + t.Name() + "!");
            return true;
        }
        this.AddChat("[传说锻造] 背包已满,无法放入神器");
        return false;
    }

    // ---------------------------------------------------------------
    // 回收
    // ---------------------------------------------------------------
    public void Recycle(int bagIdx, int currency) {
        if (bagIdx < 0 || bagIdx >= this.p.bagCnt) { return; }
        Item it = this.p.bag[bagIdx];
        if (it == null) { return; }
        long amt = 0;
        if (currency == Data.CUR_GOLD) { amt = (long)Data.RECYCLE_GOLD_PER_TIER[it.tier] * it.coef / 2; }
        else if (currency == Data.CUR_YB) { amt = Data.RECYCLE_YB_PER_TIER[it.tier]; }
        else if (currency == Data.CUR_SW) { amt = Data.RECYCLE_SW_PER_TIER[it.tier]; }
        else if (currency == Data.CUR_ZG) { amt = Data.RECYCLE_ZG_PER_TIER[it.tier]; }
        else if (currency == Data.CUR_RB) { amt = Data.RECYCLE_RB_PER_TIER[it.tier]; }
        else if (currency == Data.CUR_JF) { amt = Data.RECYCLE_JF_PER_TIER[it.tier]; }
        else { amt = Data.RECYCLE_EXP_PER_TIER[it.tier]; }
        this.p.cur[currency] = this.p.cur[currency] + amt;
        // 从背包移除
        for (int i = bagIdx; i < this.p.bagCnt - 1; i = i + 1) {
            this.p.bag[i] = this.p.bag[i + 1];
        }
        this.p.bag[this.p.bagCnt - 1] = null;
        this.p.bagCnt = this.p.bagCnt - 1;
        this.AddChat("[回收] " + it.Name() + " → " + Data.CUR_NAMES[currency] + " +" + amt);
    }

    // 一键换装:每个槽位从背包里挑评分最高的一件穿上,换下的回背包。
    // 评分 = 品阶 * 100 + 系数(与 TIER_ATK/DEF/HP 单调一致)。
    public int AutoEquipBest() {
        int changed = 0;
        for (int s = 0; s < Data.SLOT_COUNT; s = s + 1) {
            int bestIdx = -1;
            int bestScore = -1;
            for (int i = 0; i < this.p.bagCnt && i < 60; i = i + 1) {
                Item it = this.p.bag[i];
                if (it == null) { continue; }
                if (it.slot != s) { continue; }
                int sc = it.tier * 100 + it.coef;
                if (sc > bestScore) { bestScore = sc; bestIdx = i; }
            }
            if (bestIdx < 0) { continue; }
            Item cur = this.p.equip[s];
            int curScore = -1;
            if (cur != null) { curScore = cur.tier * 100 + cur.coef; }
            if (bestScore > curScore) {
                this.EquipFromBag(bestIdx);
                changed = changed + 1;
            }
        }
        if (changed > 0) {
            this.AddChat("[换装] 自动换上 " + changed + " 件更强装备");
        }
        return changed;
    }

    // 一键回收:把背包所有装备折成指定货币(自动拾取 / 清包用)
    public long RecycleAll(int currency) {
        long total = 0;
        int guard = 0;
        while (this.p.bagCnt > 0 && guard < 128) {
            guard = guard + 1;
            // 留一件待回收计数用,先取下标 0
            Item it = this.p.bag[0];
            if (it == null) {
                // 空洞:直接前移
                for (int i = 0; i < this.p.bagCnt - 1; i = i + 1) { this.p.bag[i] = this.p.bag[i + 1]; }
                this.p.bag[this.p.bagCnt - 1] = null;
                this.p.bagCnt = this.p.bagCnt - 1;
                continue;
            }
            long before = this.p.cur[currency];
            this.Recycle(0, currency);
            total = total + (this.p.cur[currency] - before);
        }
        return total;
    }

    // ---------------------------------------------------------------
    // 个人 BOSS 挑战
    // ---------------------------------------------------------------
    public bool ChallengeBossHome(int idx) {
        if (this.p.bhTriesLeft <= 0) {
            this.AddChat("[系统] 个人 BOSS 次数已用完");
            return false;
        }
        if (idx < 0 || idx >= 8) { return false; }
        // 战斗:玩家对 BOSS
        long hp = (long)(Data.BOSS_HP_BASE[idx] * Math.Pow(Data.BOSS_HP_GROWTH[idx], this.p.turn));
        double atk = Data.HJ_ATK_BASE * (idx + 1) * 2.0;
        // 玩家必须打出 boss_hp / 自身 dps 秒数
        int myDps = this.TotalAcMin();
        int seconds = (int)(hp / Math.Max(1, myDps));
        if (seconds < 1) { seconds = 1; }
        // 简化:扣除 HP 表示挑战消耗
        int myHp = this.TotalHp();
        long bossDps = (long)atk;
        int lost = (int)(bossDps * seconds / 4);
        if (lost > myHp / 2) {
            this.AddChat("[BOSS] 挑战失败:" + Data.BOSS_NAMES[idx]);
            this.p.bhTriesLeft = this.p.bhTriesLeft - 1;
            return false;
        }
        // 成功
        this.p.bhKilled[idx] = this.p.bhKilled[idx] + 1;
        this.p.bhTriesLeft = this.p.bhTriesLeft - 1;
        long gold = (long)(Data.HJ_KILL_GOLD * 50 * (idx + 1));
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] + gold;
        this.p.cur[Data.CUR_YB] = this.p.cur[Data.CUR_YB] + (idx + 1) * 5;
        // 必掉一件 t3+ 装备
        Item drop = Item.New(idx % Data.SLOT_COUNT, 3, 5 + idx, idx % 8, (int)this.rng.Range(1, 1000000));
        this.AddToBag(drop);
        this.AddChat("[BOSS] 击败 " + Data.BOSS_NAMES[idx] + " 获得 " + gold + " 金币");
        return true;
    }

    // ---------------------------------------------------------------
    // 世界 BOSS(影子共斗,30 秒挑战窗口)
    // ---------------------------------------------------------------
    public bool WorldBossBegin() {
        if (this.p.wbTriesLeft <= 0) {
            this.AddChat("[系统] 今日世界 BOSS 次数已用完");
            return false;
        }
        if (this.p.wbWindowEndMs > Game.NowMs()) { return false; }  // 窗口进行中
        this.p.wbWindowEndMs = Game.NowMs() + 30000L;
        this.AddChat("[世界 BOSS] 挑战开始,30 秒内尽量输出!");
        return true;
    }
    // 窗口内可再次点击"输出"累计伤害;窗口结束后一次性结算贡献
    public bool WorldBossInWindow() {
        return this.p.wbWindowEndMs > Game.NowMs();
    }
    public long WorldBossHit() {
        if (!this.WorldBossInWindow()) { return 0; }
        long dmg = 0;
        int myAc = this.TotalAcMax();
        if (myAc >= Data.WORLD_BOSS_TIER_BOUND0) { dmg = (long)Data.WORLD_BOSS_DAMAGE_PER_HIT[4]; }
        else if (myAc >= Data.WORLD_BOSS_TIER_BOUND1) { dmg = (long)Data.WORLD_BOSS_DAMAGE_PER_HIT[3]; }
        else if (myAc >= Data.WORLD_BOSS_TIER_BOUND2) { dmg = (long)Data.WORLD_BOSS_DAMAGE_PER_HIT[2]; }
        else if (myAc >= Data.WORLD_BOSS_TIER_BOUND3) { dmg = (long)Data.WORLD_BOSS_DAMAGE_PER_HIT[1]; }
        else { dmg = (long)Data.WORLD_BOSS_DAMAGE_PER_HIT[0]; }
        // 浮动 50%~120%
        double r = 0.5 + this.rng.NextDouble01() * 0.7;
        dmg = (long)(dmg * r);
        this.p.wbDamage = this.p.wbDamage + dmg;
        return dmg;
    }
    // 窗口结束 → 结算(次数扣除 + 简单奖励);返回本次窗口总伤
    public long WorldBossFinish() {
        if (this.p.wbWindowEndMs == 0) { return 0; }
        if (this.WorldBossInWindow()) { return 0; }
        this.p.wbWindowEndMs = 0;
        this.p.wbTriesLeft = this.p.wbTriesLeft - 1;
        long dmg = this.p.wbDamage;
        if (dmg > 0) {
            // 贡献奖励:每 100 万伤害折 1 元宝,再按伤害段给材料
            long yb = dmg / 1000000L;
            if (yb > 0) { this.p.cur[Data.CUR_YB] = this.p.cur[Data.CUR_YB] + yb; }
            this.MatAddMsg(Data.MAT_BLACK_IRON, 1 + (int)(dmg / 5000000L));
            if (dmg >= 2000000L && !this.p.hasGuild) {
                this.MatAddMsg(Data.MAT_HORN, 1);
            }
            this.AddChat("[世界 BOSS] 挑战结束,总伤害 " + this.FormatNum(dmg)
                         + (yb > 0 ? ",获得 " + yb + " 元宝" : ""));
        } else {
            this.AddChat("[世界 BOSS] 挑战结束,未造成伤害");
        }
        return dmg;
    }

    // ---------------------------------------------------------------
    // 爵位
    // ---------------------------------------------------------------
    public void DonateNoble(long ybAmount) {
        if (this.p.cur[Data.CUR_YB] < ybAmount) {
            this.AddChat("[系统] 元宝不足");
            return;
        }
        this.p.cur[Data.CUR_YB] = this.p.cur[Data.CUR_YB] - ybAmount;
        this.p.donateAcc = this.p.donateAcc + ybAmount;
        // 检查晋升
        for (int i = 0; i < Data.NOBLE_TOTAL; i = i + 1) {
            if (this.p.donateAcc >= Data.NOBLE_DONATE[i]) {
                if (this.p.nobleTier < i) {
                    this.p.nobleTier = i;
                    this.AddChat("[爵位] 晋升为 " + Data.NOBLE_NAMES[i]);
                }
            }
        }
    }

    // ---------------------------------------------------------------
    // 成就(6 类 × 8 条,自动点亮,手动领取)
    // ---------------------------------------------------------------
    // 返回本轮新点亮的成就数
    public int AchievementTick() {
        int newLit = 0;
        // 每类的当前值
        int[] vals = new int[6];
        vals[0] = this.p.lv;
        vals[1] = (int)Math.Min(2100000000L, this.p.totalKills);
        vals[2] = this.TotalAcMax();
        vals[3] = (int)Math.Min(2100000000L, this.p.bossKilled);
        vals[4] = this.p.hjBest;
        vals[5] = (int)Math.Min(2100000000L, this.p.chargeTotal);
        for (int c = 0; c < 6; c = c + 1) {
            for (int i = 0; i < Data.ACHV_PER_CAT; i = i + 1) {
                int idx = c * 8 + i;
                long bit = 1L << idx;
                if ((this.p.achvMask & bit) != 0) { continue; }
                if (vals[c] >= Data.ACHV_REQ[idx]) {
                    this.p.achvMask = this.p.achvMask | bit;
                    newLit = newLit + 1;
                }
            }
        }
        return newLit;
    }
    public bool AchievementClaim(int idx) {
        if (idx < 0 || idx >= 48) { return false; }
        long bit = 1L << idx;
        if ((this.p.achvMask & bit) == 0) { return false; }
        // 高 48 位 = 已领取
        long done = bit << 48;
        if ((this.p.achvMask & done) != 0) { return false; }
        this.p.achvMask = this.p.achvMask | done;
        this.p.achvClaimed = this.p.achvClaimed + 1;
        long gold = (long)Data.ACHV_REQ[idx] * 1000L;
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] + gold;
        int c = idx / 8;
        this.AddChat("[成就] 「" + Data.ACHV_CAT_NAMES[c] + "·" + (idx % 8 + 1) + "」达成,领取 "
                     + this.FormatNum(gold) + " 金币");
        return true;
    }
    public bool AchievementClaimed(int idx) {
        if (idx < 0 || idx >= 48) { return false; }
        return (this.p.achvMask & ((1L << idx) << 48)) != 0;
    }
    public bool AchievementLit(int idx) {
        if (idx < 0 || idx >= 48) { return false; }
        return (this.p.achvMask & (1L << idx)) != 0;
    }
    public long AchievementGold(int idx) {
        if (idx < 0 || idx >= 48) { return 0; }
        return (long)Data.ACHV_REQ[idx] * 1000L;
    }

    // ---------------------------------------------------------------
    // 交易市场(影子):NPC 挂牌(rkSeed 确定性派生)+ 玩家寄售
    // ---------------------------------------------------------------
    public int MarketOfferCls(int i) {
        return (int)((this.rkSeed / (i + 3) + i * 5) % 8);
    }
    public int MarketOfferCoef(int i) {
        return (int)(4 + (this.rkSeed / (i * 7 + 11) + i) % 12);
    }
    public long MarketOfferPrice(int i) {
        // 价格 = 系数基准 × 类别加成(元宝计价)
        double baseP = 500L + this.MarketOfferCoef(i) * 120L;
        return (long)baseP * (1 + this.MarketOfferCls(i) / 4);
    }
    public bool MarketBuy(int i) {
        if (i < 0 || i >= 8) { return false; }
        long price = this.MarketOfferPrice(i);
        if (this.p.cur[Data.CUR_YB] < price) {
            this.AddChat("[市场] 元宝不足,需 " + this.FormatNum(price));
            return false;
        }
        this.p.cur[Data.CUR_YB] = this.p.cur[Data.CUR_YB] - price;
        Item it = Item.New(this.MarketOfferCls(i) % Data.SLOT_COUNT, 2 + i / 4,
                           this.MarketOfferCoef(i), this.MarketOfferCls(i),
                           (int)((this.rkSeed / (i + 1)) % 997));
        if (!this.AddToBag(it)) {
            this.p.cur[Data.CUR_YB] = this.p.cur[Data.CUR_YB] + price;
            this.AddChat("[市场] 背包已满");
            return false;
        }
        this.AddChat("[市场] 买入 " + it.Name() + " 花 " + this.FormatNum(price) + " 元宝");
        return true;
    }
    // 寄售:背包第 bagIdx 件挂给影子买家,按品阶估价折元宝成交
    public bool MarketSell(int bagIdx) {
        if (bagIdx < 0 || bagIdx >= this.p.bagCnt) { return false; }
        Item it = this.p.bag[bagIdx];
        if (it == null) { return false; }
        long price = (long)Data.RECYCLE_GOLD_PER_TIER[it.tier] * it.coef / 2;
        long yb = price / 100 + 5;
        this.p.cur[Data.CUR_YB] = this.p.cur[Data.CUR_YB] + yb;
        for (int i = bagIdx; i < this.p.bagCnt - 1; i = i + 1) { this.p.bag[i] = this.p.bag[i + 1]; }
        this.p.bag[this.p.bagCnt - 1] = null;
        this.p.bagCnt = this.p.bagCnt - 1;
        this.AddChat("[市场] 寄售 " + it.Name() + " 成交,获得 " + yb + " 元宝");
        return true;
    }

    // ---------------------------------------------------------------
    // 排行榜(影子天梯):影子值由 rkSeed 确定性派生,围绕玩家自身值分布
    // ---------------------------------------------------------------
    public long RankMyValue(int kind) {
        if (kind == 0) { return this.p.lv; }
        if (kind == 1) { return this.TotalAcMax(); }
        if (kind == 2) { return this.p.hjBest; }
        if (kind == 3) { return this.p.cur[Data.CUR_ZG]; }
        if (kind == 4) { return this.p.wbDamage > 1 ? this.p.wbDamage : 1; }
        if (kind == 5) { return this.p.donateAcc > 1 ? this.p.donateAcc : 1; }
        return this.p.altarMyProg > 1 ? this.p.altarMyProg : 1;
    }
    // 第 pos 名(0=第一)影子值 = 玩家值 × 递减系数 + 种子扰动
    public long RankSeedValue(int kind, int pos) {
        long baseV = this.RankMyValue(kind);
        if (baseV <= 0) { baseV = 1; }
        double spread = 1.35 - pos * 0.09;
        long jitter = (this.rkSeed / (pos + 1) + pos * 7919) % Math.Max(1, baseV / 50 + 1);
        return (long)(baseV * spread) + jitter;
    }
    // 玩家名次(0 起):影子 10 人 + 自己降序
    public int RankMyPos(int kind) {
        long my = this.RankMyValue(kind);
        int pos = 0;
        for (int i = 0; i < 10; i = i + 1) {
            if (this.RankSeedValue(kind, i) > my) { pos = pos + 1; }
        }
        return pos;
    }

    // ---------------------------------------------------------------
    // 五行修炼(注入材料 → 加修为)
    // ---------------------------------------------------------------
    public void InjectWuxing(int slot, int amount) {
        if (slot < 0 || slot >= 5) { return; }
        // amount 单位 = 金币,1 金币 = 1ms 修为(简化)
        if (this.p.cur[Data.CUR_GOLD] < amount) {
            this.AddChat("[系统] 金币不足");
            return;
        }
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] - amount;
        this.p.wuxingMs[slot] = this.p.wuxingMs[slot] + (long)amount * 1000L;
        this.AddChat("[五行] " + Data.WUXING_NAMES[slot] + " 修为 +" + amount + " 金币");
    }

    // ---------------------------------------------------------------
    // 将星图谱
    // ---------------------------------------------------------------
    public void ActivateCard(int pool, int card, int tier) {
        if (pool < 0 || pool >= 8) { return; }
        if (card < 0 || card >= 12) { return; }
        if (tier < 0 || tier >= 10) { return; }
        int idx = pool * 120 + card * 10 + tier;
        int word = idx / 32;
        int bit = idx % 32;
        if (word >= this.p.cardMaskLen) { return; }
        int mask = 1 << bit;
        if ((this.p.cardMask[word] & mask) != 0) {
            this.AddChat("[系统] 已激活");
            return;
        }
        long cost = (long)(Data.CARD_ACTIVATE_BASE * Math.Pow(2, tier));
        if (this.p.cur[Data.CUR_GOLD] < cost) {
            this.AddChat("[系统] 金币不足,需 " + cost);
            return;
        }
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] - cost;
        this.p.cardMask[word] = this.p.cardMask[word] | mask;
        this.p.tupuScore = this.p.tupuScore + (tier + 1) * 100;
        this.AddChat("[图谱] 激活 " + Data.CARD_POOL_NAMES[pool] + " 卡片 +" + (tier + 1));
    }

    // ---------------------------------------------------------------
    // 称谓晋升
    // ---------------------------------------------------------------
    public void TryTitleUp() {
        // 简化:每页 5 阶,晋升门槛 = sw * (rank+1)
        // 真实计算很复杂,本工程以累计 sw / (lv / 10 + 1) 折算
        long score = this.p.cur[Data.CUR_SW] + this.p.lv * 200 + this.p.turn * 5000;
        int page = 0;
        int rank = 0;
        long need = 100;
        while (page < Data.TITLE_TOTAL) {
            if (score >= need) {
                page = page + 1;
                rank = 0;
                need = need * 8;
            } else {
                break;
            }
        }
        if (page > 0) { page = page - 1; }
        // rank = 当前页累积进度
        long pageStart = need / 8;
        long into = score - pageStart;
        rank = (int)(into * 5 / Math.Max(1, need - pageStart));
        if (rank > 4) { rank = 4; }
        if (page > this.p.titlePage || (page == this.p.titlePage && rank > this.p.titleRank)) {
            this.p.titlePage = page;
            this.p.titleRank = rank;
            this.AddChat("[称谓] 晋升为 " + Data.TITLE_PAGE_NAMES[page] + (rank + 1) + " 阶");
        }
    }

    // ---------------------------------------------------------------
    // 寻宝
    // ---------------------------------------------------------------
    public int XunBao() {
        if (this.p.xbTickets <= 0) {
            this.AddChat("[系统] 寻宝图不足");
            return -1;
        }
        this.p.xbTickets = this.p.xbTickets - 1;
        double r = this.rng.NextDouble01();
        double cum = 0;
        for (int i = 0; i < Data.XB_POOL_SIZE; i = i + 1) {
            cum = cum + Data.XB_PRIZE_RATE[i];
            if (r < cum) {
                this.p.xbPool[i] = this.p.xbPool[i] + 1;
                // 发奖
                this.GrantPrize(i);
                return i;
            }
        }
        // 兜底:最后一个
        this.p.xbPool[Data.XB_POOL_SIZE - 1] = this.p.xbPool[Data.XB_POOL_SIZE - 1] + 1;
        this.GrantPrize(Data.XB_POOL_SIZE - 1);
        return Data.XB_POOL_SIZE - 1;
    }
    public void GrantPrize(int idx) {
        long v = Data.XB_PRIZE_VAL[idx];
        switch (idx) {
            case 0: this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] + 100000; break;
            case 1: this.GainXp(50000); break;
            case 2: this.p.cur[Data.CUR_SW] = this.p.cur[Data.CUR_SW] + 100; break;
            case 3: this.p.cur[Data.CUR_ZG] = this.p.cur[Data.CUR_ZG] + 50; break;
            case 4: this.MatAddMsg(Data.MAT_BLACK_IRON, 100); break;
            case 5: this.MatAddMsg(Data.MAT_BLACK_IRON, 20); this.MatAddMsg(Data.MAT_SUPERBLESS, 2); break;
            case 6: this.MatAddMsg(Data.MAT_RUNE1, 3); break;
            case 7: this.MatAddMsg(Data.MAT_RUNE1 + 4, 1); break;
            case 8: this.MatAddMsg(Data.MAT_DRAGON1, 5); break;
            case 9: this.MatAddMsg(Data.MAT_TULONG, 1); break;
            case 10: this.p.cur[Data.CUR_YB] = this.p.cur[Data.CUR_YB] + 1000; break;
            case 11: this.p.cur[Data.CUR_LF] = this.p.cur[Data.CUR_LF] + 50; break;
            default: break;
        }
        this.AddChat("[寻宝] 抽中:" + Data.XB_PRIZE_NAMES[idx]);
    }

    // ---------------------------------------------------------------
    // 祭坛
    // ---------------------------------------------------------------
    public void AltarDonate(int kind) {
        if (kind < 0 || kind >= 5) { return; }
        if (kind == 4) {
            // 元宝
            if (this.p.cur[Data.CUR_YB] < 100) {
                this.AddChat("[系统] 元宝不足");
                return;
            }
            this.p.cur[Data.CUR_YB] = this.p.cur[Data.CUR_YB] - 100;
            this.p.altarMyProg = this.p.altarMyProg + Data.ALTAR_DONATE_PROG[4];
        } else if (kind == 2) {
            // 天书:用声望代替
            if (this.p.cur[Data.CUR_SW] < 100) { return; }
            this.p.cur[Data.CUR_SW] = this.p.cur[Data.CUR_SW] - 100;
            this.p.altarMyProg = this.p.altarMyProg + Data.ALTAR_DONATE_PROG[2];
        } else {
            // 金币
            long cost = Data.ALTAR_DONATE_GOLD[kind];
            if (this.p.cur[Data.CUR_GOLD] < cost) { return; }
            this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] - cost;
            this.p.altarMyProg = this.p.altarMyProg + Data.ALTAR_DONATE_PROG[kind];
        }
        this.p.altarGlobalProg = this.p.altarGlobalProg + Data.ALTAR_DONATE_PROG[kind];
    }

    // ---------------------------------------------------------------
    // 钱庄
    // ---------------------------------------------------------------
    public long CollectCity() {
        if (this.p.cityOwned < 0 || this.p.cityOwned >= Data.CITY_TOTAL) {
            this.AddChat("[系统] 未占领任何钱庄");
            return 0;
        }
        long now = Game.NowMs();
        long ms = now - this.p.cityLastMs;
        if (ms < 1000) { return 0; }
        long hours = ms / 3600000L;
        if (hours < 1) { hours = 1; }
        long gold = Data.CITY_PRODUCE[this.p.cityOwned] * hours;
        // 概率被抢(影子 PvP 随机事件):5%
        if (this.rng.NextDouble01() < 0.05) {
            this.AddChat("[钱庄] 钱庄被其他玩家夺走!");
            this.p.cityOwned = -1;
            return 0;
        }
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] + gold;
        this.AddChat("[钱庄] 收取 " + gold + " 金币 (" + hours + " 小时)");
        this.p.cityLastMs = now;
        return gold;
    }

    // ---------------------------------------------------------------
    // 押镖(影子)
    // ---------------------------------------------------------------
    public void SendYabiao() {
        if (this.p.ybTriesLeft <= 0) {
            this.AddChat("[系统] 今日押镖次数已用完");
            return;
        }
        this.p.ybTriesLeft = this.p.ybTriesLeft - 1;
        long gold = Data.YABIAO_GOLD[0] + this.rng.Range(0, Data.YABIAO_GOLD[1]);
        // 50% 概率被劫
        if (this.rng.NextDouble01() < 0.5) {
            gold = gold / 2;
            this.AddChat("[押镖] 镖车被劫,损失一半");
        }
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] + gold;
        this.AddChat("[押镖] 押镖完成,获得 " + gold + " 金币");
    }
    public void JieBiao() {
        if (this.p.jbTriesLeft <= 0) {
            this.AddChat("[系统] 今日劫镖次数已用完");
            return;
        }
        this.p.jbTriesLeft = this.p.jbTriesLeft - 1;
        long gold = this.rng.Range(20000, 200000);
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] + gold;
        this.AddChat("[劫镖] 劫镖成功,掠夺 " + gold + " 金币");
    }

    // ---------------------------------------------------------------
    // PK 竞技场
    // ---------------------------------------------------------------
    public void PKArena() {
        if (this.p.pkTriesLeft <= 0) {
            this.AddChat("[系统] 今日 PK 次数已用完");
            return;
        }
        this.p.pkTriesLeft = this.p.pkTriesLeft - 1;
        // 战力压制判定:总攻高于影子均值明显更易胜(影子均值 ≈ 我方 × 0.75)
        double roll = this.rng.NextDouble01();
        bool win = roll < 0.5 + (this.TotalAcMax() > 0 ? 0.0 : 0.0);
        // 简单影子战力:前 3 名按 rkSeed 派生,我用排名折算
        int myPos = this.RankMyPos(1);
        // 胜率按排名插值:#1 → 65%,每降 1 名 -5%,下限 25%
        double winRate = 0.65 - myPos * 0.05;
        if (winRate < 0.25) { winRate = 0.25; }
        win = roll < winRate;
        if (win) {
            this.p.cur[Data.CUR_ZG] = this.p.cur[Data.CUR_ZG] + Data.PK_WIN_ZG;
            this.AddChat("[PK] 胜利 +" + Data.PK_WIN_ZG + " 战功");
        } else {
            this.p.cur[Data.CUR_ZG] = this.p.cur[Data.CUR_ZG] + Data.PK_LOSE_ZG;
            this.AddChat("[PK] 失败 +" + Data.PK_LOSE_ZG + " 战功(安慰奖)");
        }
        this.p.pkRankPos = myPos;   // 供小时薪按排名结算
    }
    // PK 小时薪:按当前影子排名领档位奖励(PRD §6.1:精确到分钟,本版简化为
    // 每小时一次,不足 1 小时不可领——保留"低于门槛无法领取"的规则手感)
    public bool PKClaimHourly() {
        long now = Game.NowMs();
        if (this.p.pkRankPos < 0) { this.p.pkRankPos = this.RankMyPos(1); }
        if (now - this.p.pkHourMs < 3600000L) {
            this.AddChat("[PK] 距下次小时薪结算不足 1 小时");
            return false;
        }
        long ms = now - this.p.pkHourMs;
        if (ms > 86400000L) { ms = 86400000L; }   // 跨天最多按 24h 结
        long hours = ms / 3600000L;
        int pos = this.p.pkRankPos;
        if (pos < 0) { pos = 9; }
        if (pos > 9) { pos = 9; }
        long pay = (long)Data.PK_HOURLY[pos] * hours;
        this.p.cur[Data.CUR_ZG] = this.p.cur[Data.CUR_ZG] + pay;
        this.p.pkHourMs = now;
        this.AddChat("[PK] 小时薪结算:排名 #" + (pos + 1) + " × " + hours
                     + " 小时 = +" + pay + " 战功");
        return true;
    }

    // ---------------------------------------------------------------
    // 传说塔(影子)
    // ---------------------------------------------------------------
    public void TowerClimb() {
        if (this.p.towerBest >= Data.TOWER_FLOORS) {
            this.AddChat("[传说塔] 已登顶");
            return;
        }
        int target = this.p.towerBest;
        long hp = (long)(Data.HJ_HP_BASE * 50 * Data.TOWER_HP_MULT[target]
                         * Math.Pow(Data.HJ_HP_GROWTH, this.p.hjFloor - 1));
        int myDps = this.TotalAcMin();
        if (myDps * 30 >= hp) {
            this.p.towerBest = target + 1;
            this.AddChat("[传说塔] 占领第 " + this.p.towerBest + " 层");
        } else {
            this.AddChat("[传说塔] 挑战失败");
        }
    }

    // ---------------------------------------------------------------
    // 商店
    // ---------------------------------------------------------------
    public bool ShopBuy(int idx) {
        if (idx < 0 || idx >= 12) { return false; }
        long cost = Data.SHOP_GOODS_PRICE_YB[idx];
        if (this.p.cur[Data.CUR_YB] < cost) {
            this.AddChat("[系统] 元宝不足,需 " + cost);
            return false;
        }
        this.p.cur[Data.CUR_YB] = this.p.cur[Data.CUR_YB] - cost;
        // 真实发货:材料入包,礼包折货币
        if (idx == 0) { this.MatAddMsg(Data.MAT_GOLDKEY, 1); }          // 改名卡→黄金钥匙? 保持名实一致:发钥匙
        else if (idx == 1) { this.MatAddMsg(Data.MAT_GOLDKEY, 1); }
        else if (idx == 2) { this.MatAddMsg(Data.MAT_BLACK_IRON, 10); }
        else if (idx == 3) { this.MatAddMsg(Data.MAT_RUNE1, 1); }
        else if (idx == 4) { this.MatAddMsg(Data.MAT_RUNE1 + 9, 1); }
        else if (idx == 5) { this.MatAddMsg(Data.MAT_BLESS, 10); }
        else if (idx == 6) { this.MatAddMsg(Data.MAT_SUPERBLESS, 5); }
        else if (idx == 7) { this.p.bagSizeBase = 80; this.AddChat("[商店] 背包扩充到 80 格"); }
        else if (idx == 8) { this.MatAddMsg(Data.MAT_SOUL, 10); }
        else if (idx == 9) { this.MatAddMsg(Data.MAT_GOLDBRICK, 5); }
        else if (idx == 10) { this.MatAddMsg(Data.MAT_LINGSHI, 5); }
        else { this.MatAddMsg(Data.MAT_TOME, 2); }                      // 秘境礼包→天书×2
        return true;
    }

    // ---------------------------------------------------------------
    // 充值(模拟)
    // ---------------------------------------------------------------
    public void Charge(int tier) {
        if (tier < 0 || tier >= 7) { return; }
        this.p.cur[Data.CUR_YB] = this.p.cur[Data.CUR_YB] + Data.CHARGE_YB[tier];
        this.p.chargeTotal = this.p.chargeTotal + Data.CHARGE_TIERS[tier];
        // VIP 检查
        if (this.p.chargeTotal >= Data.VIP_THRESHOLD[2]) { this.p.vip = 2; }
        else if (this.p.chargeTotal >= Data.VIP_THRESHOLD[1]) { this.p.vip = 1; }
        else if (this.p.chargeTotal >= Data.VIP_THRESHOLD[0]) { this.p.vip = (int)Math.Max((double)this.p.vip, 0.0); }
        this.AddChat("[充值] +" + Data.CHARGE_YB[tier] + " 元宝");
    }

    // ---------------------------------------------------------------
    // 聊天 / 广播
    // ---------------------------------------------------------------
    public void AddChat(string msg) {
        if (this.p.chatCnt >= 80) {
            // 滚动
            for (int i = 0; i < 79; i = i + 1) {
                this.p.chatLog[i] = this.p.chatLog[i + 1];
            }
            this.p.chatCnt = 79;
        }
        this.p.chatLog[this.p.chatCnt] = msg;
        this.p.chatCnt = this.p.chatCnt + 1;
    }
    public void AddBroadcast(string msg) {
        this.AddChat("[广播] " + msg);
    }
    public string ShadowName() {
        // 派生自玩家 best 的影子玩家名
        string[] pre = new string[8];
        pre[0] = "万万"; pre[1] = "圣裁"; pre[2] = "龙卫";
        pre[3] = "大白花"; pre[4] = "上帝菁"; pre[5] = "李星天";
        pre[6] = "名扬天下"; pre[7] = "无巅峰";
        int idx = (int)(this.rkSeed % 8);
        if (idx < 0) { idx = -idx; }
        return pre[idx];
    }
    public void AutoBroadcast() {
        long now = Game.NowMs();
        if (now - this.p.lastBroadcastMs < 12000) { return; }
        this.p.lastBroadcastMs = now;
        // 模拟其他影子玩家的活动
        string[] actions = new string[6];
        actions[0] = "在幻境第 2001 层击杀 BOSS 获得 100 元宝×1";
        actions[1] = "在铁匠铺洗炼出 +12 屠龙";
        actions[2] = "完成了 21 页称谓天梯全部解锁";
        actions[3] = "在 PK 竞技场登顶第 1 名";
        actions[4] = "在祭坛捐献 1000 元宝帮助全服达标";
        actions[5] = "在至尊极品殿堂登记了一件铠甲之首";
        int idx = (int)(this.rng.Range(0, 6));
        string sender = this.ShadowName();
        this.AddChat("[" + sender + "] " + actions[idx]);
    }

    // ---------------------------------------------------------------
    // 帮会(影子)
    // ---------------------------------------------------------------
    public void CreateGuild(string name) {
        if (this.p.cur[Data.CUR_GOLD] < Data.GUILD_CREATE_GOLD) {
            this.AddChat("[系统] 金币不足,需 " + Data.GUILD_CREATE_GOLD);
            return;
        }
        if (!this.MatTake(Data.MAT_HORN, 1)) {
            this.AddChat("[系统] 需要 沃玛号角×1(Boss之家/世界BOSS 掉落)");
            return;
        }
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] - Data.GUILD_CREATE_GOLD;
        this.p.hasGuild = true;
        this.p.guildName = name;
        this.p.guildGold = 0;
        this.p.guildAccTs = Game.NowMs();
        this.AddChat("[帮会] 创建 " + name);
    }
    // 行会资产:按离线时长累积(成员影子产出),面板可领取
    public long GuildAccumulate() {
        if (!this.p.hasGuild) { return 0; }
        long now = Game.NowMs();
        if (this.p.guildAccTs <= 0) { this.p.guildAccTs = now; return 0; }
        long ms = now - this.p.guildAccTs;
        if (ms < 60000) { return 0; }   // 1 分钟内不结算
        // 48 成员影子 × 每人每分钟 500 金
        long gold = (ms / 60000L) * 500L * (Data.GUILD_MEMBERS_BASE / 48L + 1L);
        this.p.guildGold = this.p.guildGold + gold;
        this.p.guildAccTs = now;
        return gold;
    }
    public long GuildClaim() {
        if (!this.p.hasGuild) { return 0; }
        this.GuildAccumulate();
        long got = this.p.guildGold;
        if (got <= 0) { return 0; }
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] + got;
        this.p.guildGold = 0;
        this.AddChat("[帮会] 领取行会资产 " + this.FormatNum(got) + " 金币");
        return got;
    }

    // ---------------------------------------------------------------
    // 师徒(影子)
    // ---------------------------------------------------------------
    public void ApprenticeTo(string name) {
        if (this.p.lv > Data.STUDENT_LV_MAX) {
            this.AddChat("[系统] 等级超 60,无法拜师");
            return;
        }
        this.p.masterTier = 1;
        this.p.masterName = name;
        this.AddChat("[师徒] 拜师 " + name);
    }
    public void TakeApprentice(string name) {
        if (this.p.turn < Data.TUTOR_TURN_REQ) {
            this.AddChat("[系统] 需 2 转才能收徒");
            return;
        }
        this.p.masterTier = 2;
        this.p.studentCount = this.p.studentCount + 1;
        this.AddChat("[师徒] 收徒 " + name);
    }

    // ---------------------------------------------------------------
    // 邮箱
    // ---------------------------------------------------------------
    public void SendMailAttach(string title, Item it) {
        if (this.p.mailCnt >= 8) {
            this.AddChat("[系统] 邮箱已满");
            return;
        }
        this.p.mailAttach[this.p.mailCnt] = it;
        this.p.mailQty[this.p.mailCnt] = 1;
        this.p.mailTitle[this.p.mailCnt] = title;
        this.p.mailCnt = this.p.mailCnt + 1;
    }
    public void ClaimMail(int idx) {
        if (idx < 0 || idx >= this.p.mailCnt) { return; }
        Item it = this.p.mailAttach[idx];
        if (it != null) { this.AddToBag(it); }
        // 从邮箱移除
        for (int i = idx; i < this.p.mailCnt - 1; i = i + 1) {
            this.p.mailAttach[i] = this.p.mailAttach[i + 1];
            this.p.mailQty[i] = this.p.mailQty[i + 1];
            this.p.mailTitle[i] = this.p.mailTitle[i + 1];
        }
        this.p.mailAttach[this.p.mailCnt - 1] = null;
        this.p.mailCnt = this.p.mailCnt - 1;
    }

    // ---------------------------------------------------------------
    // 辅助方法(格式化)
    // ---------------------------------------------------------------
    public string FormatNum(long n) {
        // 千分位简化:10 万/亿
        if (n < 0) { n = -n; }
        if (n >= 100000000L) {
            long yi = n / 100000000L;
            long wan = (n % 100000000L) / 10000L;
            return yi + "." + wan + "亿";
        }
        if (n >= 10000L) {
            long wan = n / 10000L;
            long qian = (n % 10000L) / 1000L;
            if (qian > 0) { return wan + "." + qian + "万"; }
            return wan + "万";
        }
        return "" + n;
    }
    public string FormatCur(long n) {
        return this.FormatNum(n);
    }

    // Parse 辅助(Zan 无 int.Parse/long.Parse)
    public static int ParseIntS(string s) {
        if (s == null) { return 0; }
        int v = 0;
        bool neg = false;
        int i = 0;
        if (s.Length > 0 && s.Substring(0, 1) == "-") { neg = true; i = 1; }
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            int d = Game.DigitOf(ch);
            if (d < 0) { break; }
            v = v * 10 + d;
            i = i + 1;
        }
        if (neg) { v = -v; }
        return v;
    }
    public static long ParseLongS(string s) {
        if (s == null) { return 0; }
        long v = 0;
        bool neg = false;
        int i = 0;
        if (s.Length > 0 && s.Substring(0, 1) == "-") { neg = true; i = 1; }
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            int d = Game.DigitOf(ch);
            if (d < 0) { break; }
            v = v * 10 + d;
            i = i + 1;
        }
        if (neg) { v = -v; }
        return v;
    }
    static int DigitOf(string ch) {
        if (ch == "0") { return 0; } if (ch == "1") { return 1; }
        if (ch == "2") { return 2; } if (ch == "3") { return 3; }
        if (ch == "4") { return 4; } if (ch == "5") { return 5; }
        if (ch == "6") { return 6; } if (ch == "7") { return 7; }
        if (ch == "8") { return 8; } if (ch == "9") { return 9; }
        return -1;
    }
    // ---------------------------------------------------------------
    // 至尊极品殿堂
    // ---------------------------------------------------------------
    public bool RegisterDianTang(int page, Item it) {
        if (page < 0 || page >= 5) { return false; }
        if (this.p.dtBest[page] != null && this.p.dtBest[page].coef >= it.coef
            && this.p.dtBest[page].tier >= it.tier) {
            this.AddChat("[殿堂] 当前最强已优于该装备");
            return false;
        }
        this.p.dtBest[page] = it;
        this.p.dtCount = this.p.dtCount + 1;
        if (this.p.dtCount > Data.DIAN_TANG_XP_BONUS_CAP) {
            this.p.dtCount = Data.DIAN_TANG_XP_BONUS_CAP;
        }
        this.AddChat("[殿堂] 登记成功 +5% 经验加成");
        return true;
    }

    // ---------------------------------------------------------------
    // 神兵图鉴:9 组 × 10 槽,镶入后无法取出(木桶原理)
    // 每件 +1% 全属性,整组镶满再 +5%;可被更高评分的同组装备向上替换
    // ---------------------------------------------------------------
    public Item AlbumAt(int group, int slot) {
        if (group < 0 || group >= Data.ALBUM_GROUPS) { return null; }
        if (slot < 0 || slot >= Data.ALBUM_SLOTS) { return null; }
        return this.p.albumSlots[group * Data.ALBUM_SLOTS + slot];
    }
    public int AlbumCount() {
        int n = 0;
        for (int i = 0; i < this.p.albumSlots.Length; i = i + 1) {
            if (this.p.albumSlots[i] != null) { n = n + 1; }
        }
        return n;
    }
    public int AlbumFullGroups() {
        int n = 0;
        for (int gi = 0; gi < Data.ALBUM_GROUPS; gi = gi + 1) {
            bool full = true;
            for (int si = 0; si < Data.ALBUM_SLOTS; si = si + 1) {
                if (this.p.albumSlots[gi * Data.ALBUM_SLOTS + si] == null) { full = false; break; }
            }
            if (full) { n = n + 1; }
        }
        return n;
    }
    // 图鉴评分:品阶 ×100 万 + 系数(与换装评分一致)
    static int AlbumScore(Item it) {
        if (it == null) { return -1; }
        return it.tier * 1000000 + it.coef;
    }
    // 从背包选中一件镶入图鉴(group=当前页,slot=自动找空位,满则顶掉最弱一件)
    public bool AlbumInset(int group, int bagIdx) {
        if (group < 0 || group >= Data.ALBUM_GROUPS) { return false; }
        if (bagIdx < 0 || bagIdx >= this.p.bagCnt) { return false; }
        Item it = this.p.bag[bagIdx];
        if (it == null) { return false; }
        int base_ = group * Data.ALBUM_SLOTS;
        // 找空位;没有空位则找组内评分最低的一件
        int slot = -1;
        int weakIdx = -1;
        int weakScore = 2147483647;
        for (int si = 0; si < Data.ALBUM_SLOTS; si = si + 1) {
            Item cur = this.p.albumSlots[base_ + si];
            if (cur == null) { slot = si; break; }
            int sc = AlbumScore(cur);
            if (sc < weakScore) { weakScore = sc; weakIdx = si; }
        }
        if (slot < 0) {
            // 全满:新装备必须比最弱一件强,否则拒绝(防误操作白拿)
            if (AlbumScore(it) <= weakScore) {
                this.AddChat("[图鉴] 该组已满,新装备未优于最弱一件,镶入取消");
                return false;
            }
            slot = weakIdx;
        }
        // 从背包移除(与 Recycle 同款搬移)
        for (int i = bagIdx; i < this.p.bagCnt - 1; i = i + 1) {
            this.p.bag[i] = this.p.bag[i + 1];
        }
        this.p.bag[this.p.bagCnt - 1] = null;
        this.p.bagCnt = this.p.bagCnt - 1;
        Item old = this.p.albumSlots[base_ + slot];
        this.p.albumSlots[base_ + slot] = it;
        if (old == null) {
            this.AddChat("[图鉴] 「" + Data.ALBUM_NAMES[group] + "」镶入 " + it.Name()
                         + "(" + this.AlbumCount() + "/" + this.p.albumSlots.Length + ")");
        } else {
            this.AddChat("[图鉴] 「" + Data.ALBUM_NAMES[group] + "」" + old.Name()
                         + " → " + it.Name() + "(替换,旧件销毁)");
        }
        return true;
    }

    // ---------------------------------------------------------------
    // 沙巴克(单机影子攻城):无行会可膜拜蹭声望;有行会可攻城
    // ---------------------------------------------------------------
    public bool ShabakeOwn() {
        if (!this.p.hasGuild) { return false; }
        if (this.p.sbkOwned) { return false; }
        if (!this.MatTake(Data.MAT_GOLDKEY, 1)) {
            this.AddChat("[沙巴克] 攻城需要 1 把黄金钥匙");
            return false;
        }
        // 攻城战力门槛:全攻 ≥ 2000(影子守军)
        if (this.TotalAcMax() < 2000) {
            this.MatAdd(Data.MAT_GOLDKEY, 1);   // 退还钥匙
            this.AddChat("[沙巴克] 攻城失败:总攻不足 2000(守军太强),钥匙已退回");
            return false;
        }
        this.p.sbkOwned = true;
        this.p.sbkWins = this.p.sbkWins + 1;
        this.p.sbkDayMs = Game.NowMs();
        this.p.sbkTaxMs = Game.NowMs();
        this.AddChat("[沙巴克] 「" + this.p.guildName + "」攻城成功!占领沙巴克城!");
        return true;
    }
    // 占领期间收税:金币 = 2 万 × 占领小时数(上限 24h),黑铁 1/h
    public bool ShabakeCollectTax() {
        if (!this.p.sbkOwned) { return false; }
        long now = Game.NowMs();
        long ms = now - this.p.sbkTaxMs;
        if (ms < 3600000L) {
            this.AddChat("[沙巴克] 占领不足 1 小时,暂无可收税金");
            return false;
        }
        long hours = ms / 3600000L;
        if (hours > 24) { hours = 24; }
        long gold = hours * 20000L;
        this.p.cur[Data.CUR_GOLD] = this.p.cur[Data.CUR_GOLD] + gold;
        this.MatAddMsg(Data.MAT_BLACK_IRON, (int)hours);
        this.p.sbkTaxMs = now;
        this.AddChat("[沙巴克] 收税 " + this.FormatNum(gold) + " 金币(" + hours + " 小时占领)");
        return true;
    }
    // 失去占领(影子行会反扑,每日一次机会)——让"占领"是个需要维护的动态状态
    public void ShabakeLoseCheck() {
        if (!this.p.sbkOwned) { return; }
        if (this.rng.NextDouble01() < 0.5) { return; }
        this.p.sbkOwned = false;
        this.AddChat("[沙巴克] 影子行会反扑,「" + this.p.guildName + "」失去沙巴克占领!");
    }

    // ---------------------------------------------------------------
    // 红包(影子群):发出去抢回来,小额回收 + 每日首封 +声望
    // ---------------------------------------------------------------
    public bool RedBagSend(long ybAmount) {
        if (ybAmount < 100) { return false; }
        if (this.p.cur[Data.CUR_YB] < ybAmount) {
            this.AddChat("[系统] 元宝不足");
            return false;
        }
        this.p.cur[Data.CUR_YB] = this.p.cur[Data.CUR_YB] - ybAmount;
        // 影子群 8 人抢:自己平均能抢回 40%~90%
        long got = (long)(ybAmount * (0.4 + this.rng.NextDouble01() * 0.5));
        this.p.cur[Data.CUR_RB] = this.p.cur[Data.CUR_RB] + got;
        this.p.rbSent = this.p.rbSent + ybAmount;
        this.p.rbGot = this.p.rbGot + got;
        // 每日首封 +30 声望
        if (Game.NowMs() - this.p.rbDayMs >= Data.DAY_MS) {
            this.p.rbDayMs = Game.NowMs();
            this.p.cur[Data.CUR_SW] = this.p.cur[Data.CUR_SW] + 30;
            this.AddChat("[红包] 今日首封红包 +30 声望");
        }
        this.AddChat("[红包] 发出 " + ybAmount + " 元宝,影子群抢回 " + got + " 红包币");
        return true;
    }
    public bool RedBagGrab() {
        long now = Game.NowMs();
        if (now - this.p.rbGrabMs < Data.DAY_MS) {
            this.AddChat("[红包] 今日已抢过影子群红包(每日 1 次)");
            return false;
        }
        long got = this.rng.Range(50, 500);
        this.p.cur[Data.CUR_RB] = this.p.cur[Data.CUR_RB] + got;
        this.p.rbGot = this.p.rbGot + got;
        this.p.rbGrabMs = now;
        this.AddChat("[红包] 抢到影子群红包 +" + got + " 红包币");
        return true;
    }
    // 玩家在世界频道发言(影子群友概率回应一句)
    public void SayWorld(string text) {
        this.AddChat("[我] " + this.p.name + ": " + text);
        if (this.rng.NextDouble01() < 0.5) {
            this.AddChat("[世界] " + this.ShadowName() + ": " +
                         (text.IndexOf("666") >= 0 ? "带我一个!" : "同去!同去!"));
        }
    }

