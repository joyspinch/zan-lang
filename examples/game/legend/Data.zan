// 传奇放置挂机 — 静态数据表。
// 设计目标:数据与逻辑分离,便于调数值。表中只放常量与索引,所有运行时
// 计算(伤害公式/经验曲线/离线结算/影子榜种子)走 Game.zan。
using System;

namespace Legend;

// 三职业:0 战士 / 1 法师 / 2 道士
class ClassDef {
    public string name;        // 职业名(显示用)
    public string attr;        // 主属性缩写("攻击"/"魔法"/"道术")
    public double hpGrow;      // 每级 HP 增长系数
    public double mpGrow;      // 每级 MP 增长系数
    public double acGrow;      // 每级攻击(区间下限)增长
    public double acRange;     // 攻击浮动幅度(占 acGrow 的比例)
    public double defGrow;     // 每级防御
    public double mdefGrow;    // 每级魔防
}

