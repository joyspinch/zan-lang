        // 成就阈值:6 类 × 8 条(升序)
        // 0 等级奖励 / 1 幻境奖励(累计击杀) / 2 属性突破(攻击) /
        // 3 BOSS 挑战(累计击破) / 4 推图记录(最高层) / 5 推广拉新(收徒+充值)
        int[] reqs = new int[48];
        for (int i = 0; i < 8; i = i + 1) {
            reqs[0 * 8 + i] = 10 + i * 10;              // 等级 10..80
            reqs[1 * 8 + i] = 100 * (i + 1) * (i + 1);  // 击杀 100,400,900..6400
            reqs[2 * 8 + i] = 50 * (i + 1) * (i + 1);   // 攻击 50..3200
            reqs[3 * 8 + i] = 1 + i * 3;                // BOSS 1,4,7..22
            reqs[4 * 8 + i] = 5 + i * 35;               // 层数 5,40..250
            reqs[5 * 8 + i] = 200 * (i + 1);            // 充值(元) 200..1600
        }
        for (int i = 0; i < 48; i = i + 1) { ACHV_REQ[i] = reqs[i]; }
        MAIN_TOP = TITLE_BAR_H + NAV_ROW_H * NAV_ROWS;
    }
