    public void DrawCity(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w,
            "城池争夺 / 钱庄 — 当前占有:" +
            (this.g.p.cityOwned >= 0 ? Data.MAP_NAMES[this.g.p.cityOwned] : "无"));
        int gy = y + 76;
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 16, gy, 200, 32,
                      "收取金币", 2, 1)) {
            if (this.mouseJustUp) { this.g.CollectCity(); this.snd.Trade(); }
        }
        gy = gy + 40;
        for (int i = 0; i < Data.CITY_TOTAL; i = i + 1) {
            int col = i % 4;
            int row = i / 4;
            int bx = x + 16 + col * 220;
            int by = gy + row * 80;
            int bw = 210;
            int bh = 70;
            bool mine = (this.g.p.cityOwned == i);
            if (this.texPanel != null && this.texPanel.IsValid()) {
                LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, bx, by, bw, bh);
            } else {
                Ui.Panel(rd, bx, by, bw, bh, mine ? 50 : 38, mine ? 40 : 30, mine ? 30 : 22, 220);
            }
            Text.DrawShadow(rd, "钱庄 " + (i + 1), bx + 12, by + 8, 2, 240, 220, 180, 255);
            Text.DrawShadow(rd, "产出:" + this.g.FormatNum(Data.CITY_PRODUCE[i]) + " 金/h",
                            bx + 12, by + 30, 1, 220, 215, 180, 255);
            if (mine) {
                Text.DrawShadow(rd, "[已占领]", bx + 12, by + 50, 1, 230, 200, 130, 255);
            } else {
                if (Ui.Button(rd, this.mouseX, this.mouseY, bx + bw - 80, by + 38, 70, 24,
                              "攻打", 1, 0)) {
                    if (this.mouseJustUp) {
                        this.g.p.cityOwned = i;
                        this.g.p.cityLastMs = Game.NowMs();
                        this.g.AddChat("[钱庄] 占领 钱庄 " + (i + 1));
                    }
                }
            }
        }
    }

    public void DrawTower(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w,
            "传说塔 — 当前层:" + this.g.p.towerBest + "/" + Data.TOWER_FLOORS);
        int gy = y + 76;
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 16, gy, 200, 36,
                      "挑战下一层", 2, 1)) {
            if (this.mouseJustUp) { this.g.TowerClimb(); this.snd.Craft(); }
        }
        gy = gy + 50;
        for (int i = 0; i < Data.TOWER_FLOORS; i = i + 1) {
            int by = gy + i * 70;
            int bx = x + 16;
            int bw = w - 32;
            bool hold = (i < this.g.p.towerBest);
            if (this.texPanel != null && this.texPanel.IsValid()) {
                LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, bx, by, bw, 60);
            } else {
                Ui.Panel(rd, bx, by, bw, 60, hold ? 50 : 38, hold ? 38 : 30, hold ? 28 : 22, 220);
            }
            Text.DrawShadow(rd, "第 " + (i + 1) + " 层", bx + 12, by + 8, 2, 240, 220, 180, 255);
            Text.DrawShadow(rd, "守关:" + this.g.ShadowName() + "_" + (i + 1),
                            bx + 110, by + 8, 1, 240, 220, 180, 255);
            Text.DrawShadow(rd, hold ? "[已占领]" : "[未占领]",
                            bx + bw - 100, by + 22, 1, hold ? 230 : 200, hold ? 200 : 200, hold ? 130 : 220, 255);
        }
    }

