        BOT[0]="背包"; BOT[1]="铁匠铺"; BOT[2]="交易市场";
        BOT[3]="图鉴";   BOT[4]="爵位";   BOT[5]="称谓";
        BOT[6]="成就";   BOT[7]="商店";   BOT[8]="帮助";
