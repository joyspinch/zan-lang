    public void DrawShabake(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w, "沙巴克 — 行会攻城战(单机版仅展示)");
        int gy = y + 76;
        Text.DrawShadow(rd, "★ 沙巴克开战时间:每日 18:00-19:00",
                        x + 16, gy, 2, 250, 215, 130, 255);
        gy = gy + 30;
        Text.DrawShadow(rd, "★ 当前占领:影子行会_1", x + 16, gy, 1, 220, 215, 180, 255);
        gy = gy + 22;
        Text.DrawShadow(rd, "★ 占领时间:2026-09-01 18:05", x + 16, gy, 1, 220, 215, 180, 255);
        gy = gy + 30;
        Text.DrawShadow(rd, "(单机版不实现行会攻城,需联网)",
                        x + 16, gy, 2, 240, 120, 120, 255);
        gy = gy + 30;
        Text.DrawShadow(rd, "占领奖励:宝石 / 技能书 / 金币 / 黑铁 / 金砖 / 魂灵",
