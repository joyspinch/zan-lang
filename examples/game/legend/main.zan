class LegendApp {
    // SDL scancode for F10 (老板键);stdlib SdlScancode 只有 F1/F5/F11,F10 = F1 + 9 = 67
    public static int SC_F10 = 67;

    public Host host;
    public SdlRenderer r;
    public Game g;
    public Snd snd;
    public Rng uiRng;

    public int mouseX;
    public int mouseY;
    public bool mouseDown;
    public bool mouseJustDown;
    public bool mouseJustUp;
    public long now;
    public long lastStepAt;
    public double simAccum;
    public int flashRedDot;     // 0 无 / 1 全局红点(有可领取)

    public int modal;           // -1 无 / 0..30 模态页码
    public int modalSub;        // 子页(如铁匠铺 11 模式子页)
    public int modalHover;
    public int bagSel;          // 背包选中索引
    public int shopPage;        // 商店货币页签
    public int rankKind;        // 排行榜子榜 0..6
    public int forgeMode;       // 铁匠铺模式 0..10
    public bool forgeSel;       // 是否已选一件装备
    public int refineKind;      // 0 金币 1 元宝
    public int bossHomeIdx;     // BOSS 之家选中
    public int albumGroup;      // 图鉴分组
    public int dtPage;          // 殿堂子页
    public int towerFloor;      // 传说塔目标层
    public int cardPool;        // 将星卡池
    public int wuxingSlot;      // 五行槽
    public int mapCur;          // 当前地图

    public long splashStart;
    public long lastBroadcastTick;
    public string offlineText;
    public bool showOffline;

    // 资源
    public SdlTexture texBg;        // 烘焙背景
    public SdlTexture texSplash;    // 启动画面
    public SdlTexture texDim;       // 暗化遮罩
    public SdlTexture texPanel;     // panel_nine 9 宫格
    public SdlTexture texBtnDark;
    public SdlTexture texBtnDarkHi;
    public SdlTexture texBtnGold;
    public SdlTexture texBtnGoldHi;
    public SdlTexture texBarChrome;
    public SdlTexture texBarFill;
    public SdlTexture texBarTrough;
    public SdlTexture texRowStone;
    public SdlTexture texTitlePlate;
    public SdlTexture[]texIcon;     // 5 货币图标
    public SdlTexture[]texEquip;    // 8×5 装备图标
    public SdlTexture texMobNormal;
    public SdlTexture texMobBoss;
    public SdlTexture[]texClass;    // 3 职业立绘
    public SdlTexture[]texBoss;     // 4 大教主立绘
    public SdlTexture texMapBichon;
    public SdlTexture texMapStone;

    [DllImport("crt", EntryPoint = "getenv")]
    static extern string SysGetenvRaw(string name);

    static string SysGetenv(string name) {
        string v = LegendApp.SysGetenvRaw(name);
        if (v == null) { return ""; }
        return v;
    }

    public static int W() { return Data.W; }
    public static int H() { return Data.H; }
    public static int MainTop() { return Data.MAIN_TOP; }
    public static int MainBottom() { return Data.MAIN_BOTTOM(); }

    static SdlTexture LoadTex(SdlRenderer r, string rel, System.IO.StreamWriter log) {
        // 资源固定在 exe 相对路径,不依赖启动 cwd:ExeDir()/rel
        string p = Assets.ExeDir() + "/" + rel;
        bool exists = System.IO.File.Exists(p);
        SdlTexture t = exists ? SdlTexture.LoadImage(r, p) : null;
        bool ok = (t != null && t.IsValid());
        if (!ok) {
            log.WriteLine("[ASSET FAIL] rel=" + rel + " resolved=" + p + " exists=" + exists);
        } else {
            log.WriteLine("[ASSET OK] " + rel + " -> " + p);
        }
        return t;
    }

    public static LegendApp Create(Host h) {
        LegendApp a = new LegendApp();
        a.host = h;
        a.r = h.Renderer();
        a.uiRng = Rng.Seed(987654321L);
        string logDir = Assets.ExeDir();
        System.IO.StreamWriter log = new System.IO.StreamWriter(logDir + "/legend_assets.log");
        log.WriteLine("=== assets load log ===");
        string self = ProcessHost.SelfExe();
        string exeDir = Assets.ExeDir();
        log.WriteLine("SelfExe=" + self + " ExeDir=" + exeDir + " Cwd=" + System.IO.Directory.GetCurrentDirectory());
        // 货币图标(用 5 个,金币/元宝/声望/灵符/积分)
        a.texIcon = new SdlTexture[5];
        a.texIcon[0] = LegendApp.LoadTex(a.r, "assets/legend/icon_gold.png", log);
        a.texIcon[1] = LegendApp.LoadTex(a.r, "assets/legend/icon_crystal.png", log);
        a.texIcon[2] = LegendApp.LoadTex(a.r, "assets/legend/icon_iron.png", log);
        a.texIcon[3] = LegendApp.LoadTex(a.r, "assets/legend/icon_copper.png", log);
        a.texIcon[4] = LegendApp.LoadTex(a.r, "assets/legend/icon_core.png", log);
        // 装备 8×5
        a.texEquip = new SdlTexture[40];
        for (int c = 0; c < 8; c = c + 1) {
            for (int t = 0; t < 5; t = t + 1) {
                string p = "assets/legend/equip_c" + c + "_t" + t + ".png";
                a.texEquip[c * 5 + t] = LegendApp.LoadTex(a.r, p, log);
            }
        }
        // 怪物 / 职业立绘
        a.texMobNormal = LegendApp.LoadTex(a.r, "assets/legend/monster_normal.png", log);
        a.texMobBoss = LegendApp.LoadTex(a.r, "assets/legend/monster_boss.png", log);
        a.texClass = new SdlTexture[3];
        a.texClass[0] = LegendApp.LoadTex(a.r, "assets/legend/class_warrior.png", log);
        a.texClass[1] = LegendApp.LoadTex(a.r, "assets/legend/class_mage.png", log);
        a.texClass[2] = LegendApp.LoadTex(a.r, "assets/legend/class_taoist.png", log);
        a.texBoss = new SdlTexture[4];
        a.texBoss[0] = LegendApp.LoadTex(a.r, "assets/legend/boss_woma.png", log);
        a.texBoss[1] = LegendApp.LoadTex(a.r, "assets/legend/boss_zuma.png", log);
        a.texBoss[2] = LegendApp.LoadTex(a.r, "assets/legend/boss_chiyue.png", log);
        a.texBoss[3] = LegendApp.LoadTex(a.r, "assets/legend/boss_molong.png", log);
        a.texMapBichon = LegendApp.LoadTex(a.r, "assets/legend/map_bichon.png", log);
        a.texMapStone = LegendApp.LoadTex(a.r, "assets/legend/row_stone.png", log);
        a.texBg = LegendApp.LoadTex(a.r, "assets/legend/bg_mine.jpg", log);
        a.texSplash = LegendApp.LoadTex(a.r, "assets/legend/splash.png", log);
        a.texDim = LegendApp.LoadTex(a.r, "assets/legend/dim_bg.jpg", log);
        a.texPanel = LegendApp.LoadTex(a.r, "assets/legend/panel_nine.png", log);
        a.texBtnDark = LegendApp.LoadTex(a.r, "assets/legend/btn_dark.png", log);
        a.texBtnDarkHi = LegendApp.LoadTex(a.r, "assets/legend/btn_dark_hi.png", log);
        a.texBtnGold = LegendApp.LoadTex(a.r, "assets/legend/btn_gold.png", log);
        a.texBtnGoldHi = LegendApp.LoadTex(a.r, "assets/legend/btn_gold_hi.png", log);
        a.texBarChrome = LegendApp.LoadTex(a.r, "assets/legend/bar_chrome.png", log);
        a.texBarFill = LegendApp.LoadTex(a.r, "assets/legend/bar_fill.png", log);
        a.texBarTrough = LegendApp.LoadTex(a.r, "assets/legend/bar_trough.png", log);
        a.texRowStone = LegendApp.LoadTex(a.r, "assets/legend/row_stone.png", log);
        a.texTitlePlate = LegendApp.LoadTex(a.r, "assets/legend/title_plate.png", log);
        if (a.texBg != null && a.texBg.IsValid()) {
            a.texBg.SetBlendMode(1);
        }
        if (a.texSplash != null && a.texSplash.IsValid()) {
            a.texSplash.SetBlendMode(1);
        }
        // 启动游戏
        a.g = new Game();
        bool loaded = a.g.Load();
        if (!loaded) {
            a.g.NewGame("传奇玩家", 0);
        }
        // 离线结算
        a.g.OfflineSettle();
        // 检查日刷新
        if (a.g.IsNewDay()) { a.g.DayReset(); }
        a.modal = 31;  // 类选择屏
        a.splashStart = a.now;
        log.WriteLine("=== assets load end ===");
        log.Close();
        return a;
    }

    public void Tick() {
        if (this.modal == 31) {
            this.DrawClassSelect();
            return;
        }
        // 自动战斗(节拍 120ms)
        if (this.now - this.lastStepAt >= 120) {
            this.lastStepAt = this.now;
            this.g.StepIdle(0.12);
        }
        // 自动广播
        this.g.AutoBroadcast();
        this.DrawAll();
    }

    public void Save() { this.g.Save(); }

    // ---------------------------------------------------------------
    // 渲染:全局
    // ---------------------------------------------------------------
    public void DrawAll() {
        int w = LegendApp.W();
        int h = LegendApp.H();
        SdlRenderer rd = this.r;
        // 老板键隐藏
        if (this.g.bossMode) {
            rd.SetColor(28, 32, 44, 255);
            rd.Clear();
            Text.DrawCentered(rd, "(静默运行中…按 F10 恢复)", w / 2, h / 2, 3,
                              200, 200, 220, 255);
            return;
        }
        // 背景
        if (this.texBg != null && this.texBg.IsValid()) {
            rd.DrawTexture(this.texBg, 0, 0, w, h);
        } else {
            Draw.VGradient(rd, 0, 0, w, h, 18, 22, 32, 8, 10, 16, 255);
        }
        // 暗化遮罩
        if (this.texDim != null && this.texDim.IsValid()) {
            rd.SetColor(255, 255, 255, 80);
            rd.DrawTexture(this.texDim, 0, 0, w, h);
            rd.SetColor(255, 255, 255, 255);
        }
        // 标题栏
        this.DrawTitleBar();
        // 顶部两排导航
        this.DrawTopNav();
        // 主区
        this.DrawMainArea();
        // 底部导航
        this.DrawBottomNav();
        // 模态面板
        if (this.modal >= 0) { this.DrawModal(); }
    }

    public void DrawTitleBar() {
        int w = LegendApp.W();
        SdlRenderer rd = this.r;
        Draw.RoundRectFill(rd, 0, 0, w, Data.TITLE_BAR_H, 0, 12, 16, 26, 255);
        Draw.RoundRectFill(rd, 0, Data.TITLE_BAR_H - 2, w, 2, 0, 198, 158, 80, 220);
        // 标题
        Text.DrawShadow(rd, "传奇放置挂机", 16, 12, 2, 230, 198, 130, 255);
        // 角色信息
        string[] clsN = new string[3];
        clsN[0] = "战士"; clsN[1] = "法师"; clsN[2] = "道士";
        Text.DrawShadow(rd, "Lv." + this.g.p.lv + "  " + clsN[this.g.p.cls],
                        200, 12, 2, 230, 220, 200, 255);
        // 货币(右侧 4 个)
        int mx = w - 600;
        for (int i = 0; i < 5; i = i + 1) {
            int idx = i;
            if (idx == 4) { idx = 6; }  // 积分
            long v = this.g.p.cur[idx];
            string s = this.g.FormatCur(v);
            int tw = Text.Width(rd, s, 2);
            int ix = mx + i * 120;
            if (this.texIcon[i] != null && this.texIcon[i].IsValid()) {
                rd.DrawTexture(this.texIcon[i], ix, 8, 18, 18);
            }
            Text.DrawShadow(rd, s, ix + 22, 12, 2, 230, 215, 175, 255);
        }
        // 设置齿轮按钮
        int sx = w - 36;
        int sy = 4;
        if (Draw.PointIn(this.mouseX, this.mouseY, sx, sy, 32, 32)) {
            Draw.RoundRectFill(rd, sx - 2, sy - 2, 36, 36, 6, 90, 110, 140, 220);
            if (this.mouseJustUp) { this.modal = 14; this.g.ToggleBossKey(); }
        }
        Text.DrawCentered(rd, "⚙", sx + 16, sy + 8, 2, 230, 200, 130, 255);
    }

    public void DrawTopNav() {
        SdlRenderer rd = this.r;
        int y0 = Data.TITLE_BAR_H;
        int by = y0 + 6;
        int bh = Data.NAV_ROW_H - 12;
        // 排 1
        for (int i = 0; i < 10; i = i + 1) {
            int bx = i * 128 + 4;
            this.DrawNavBtn(bx, by, 120, bh, NavBtn.TOP1[i], NavBtn.TOP1_PG[i], 0);
        }
        // 排 2
        by = y0 + Data.NAV_ROW_H + 6;
        for (int i = 0; i < 10; i = i + 1) {
            int bx = i * 128 + 4;
            this.DrawNavBtn(bx, by, 120, bh, NavBtn.TOP2[i], NavBtn.TOP2_PG[i], 1);
        }
    }

    public void DrawBottomNav() {
        SdlRenderer rd = this.r;
        int by = LegendApp.MainBottom() + 4;
        for (int i = 0; i < 10; i = i + 1) {
            int bx = i * 128 + 4;
            this.DrawNavBtn(bx, by, 120, 60, NavBtn.BOT[i], NavBtn.BOT_PG[i], 2);
        }
    }

    public void DrawNavBtn(int x, int y, int w, int h, string label, int page, int row) {
        SdlRenderer rd = this.r;
        bool hov = Draw.PointIn(this.mouseX, this.mouseY, x, y, w, h);
        bool sel = (this.modal == page);
        SdlTexture tex;
        if (sel) { tex = this.texBtnGoldHi; }
        else if (hov) { tex = this.texBtnDarkHi; }
        else if (row == 0) { tex = this.texBtnGold; }
        else { tex = this.texBtnDark; }
        if (tex != null && tex.IsValid()) {
            LegendApp.NineImg(rd, tex, 256, 96, 16, 16, x, y, w, h);
        } else {
            Ui.Panel(rd, x, y, w, h, 46, 52, 70, 220);
        }
        int tc = sel ? 32 : 230;
        if (row == 2) { tc = 230; }
        Text.DrawCenteredShadow(rd, label, x + w / 2, y + h / 2 - 8, 2, tc, tc, tc, 1);
        if (hov && this.mouseJustUp) {
            if (this.modal == page) { this.modal = -1; }
            else { this.modal = page; this.modalSub = 0; }
            this.snd.Tip();
        }
    }

    // ---------------------------------------------------------------
    // 主区
    // ---------------------------------------------------------------
    public void DrawMainArea() {
        int w = LegendApp.W();
        int y0 = LegendApp.MainTop();
        int y1 = LegendApp.MainBottom();
        // 左角色面板
        this.DrawCharPanel(0, y0, 240, y1 - y0);
        // 中央:幻境主显示
        this.DrawHuanJingMain(240, y0, w - 240 - 320, y1 - y0);
        // 右聊天
        this.DrawChatPanel(w - 320, y0, 320, y1 - y0);
    }

    public void DrawCharPanel(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        if (this.texPanel != null && this.texPanel.IsValid()) {
            LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, x, y, w, h);
        } else {
            Ui.Panel(rd, x, y, w, h, 26, 30, 44, 232);
        }
        int pad = 12;
        int cy = y + pad;
        // 头像
        if (this.texClass != null && this.texClass[this.g.p.cls] != null
            && this.texClass[this.g.p.cls].IsValid()) {
            int ax = x + w / 2 - 36;
            int ay = cy;
            rd.DrawTexture(this.texClass[this.g.p.cls], ax, ay, 72, 72);
            cy = cy + 78;
        } else {
            Draw.RoundRectFill(rd, x + w / 2 - 36, cy, 72, 72, 8, 60, 50, 38, 255);
            cy = cy + 78;
        }
        // 角色名 + 转生
        Text.DrawCentered(rd, this.g.p.name, x + w / 2, cy, 2, 240, 220, 180, 255);
        cy = cy + 22;
        Text.DrawCentered(rd, this.g.p.turn + " 转", x + w / 2, cy, 1, 200, 170, 100, 255);
        cy = cy + 18;
        // 属性
        string[] attrs = new string[8];
        attrs[0] = "生命:" + this.g.TotalHp();
        attrs[1] = "魔法:" + this.g.BaseMp();
        attrs[2] = "攻击:" + this.g.TotalAcMin() + "-" + this.g.TotalAcMax();
        attrs[3] = "防御:" + this.g.TotalDef();
        attrs[4] = "魔防:" + this.g.TotalMDef();
        attrs[5] = "幸运:" + this.g.p.titleRank;
        attrs[6] = "经验:" + this.g.ExpForLv(this.g.p.lv);
        attrs[7] = "等级:" + this.g.p.lv;
        for (int i = 0; i < 8; i = i + 1) {
            Text.DrawShadow(rd, attrs[i], x + pad, cy, 1, 220, 210, 180, 255);
            cy = cy + 16;
        }
        // 经验条
        cy = cy + 4;
        LegendApp.BarImg(rd, x + pad, cy, w - pad * 2, 14,
                         this.g.p.xp, this.g.ExpForLv(this.g.p.lv));
        cy = cy + 22;
        // 货币
        for (int i = 0; i < 4; i = i + 1) {
            int idx = i;
            if (idx == 3) { idx = 6; }
            long v = this.g.p.cur[idx];
            string s = Data.CUR_NAMES[idx] + ":" + this.g.FormatCur(v);
            Text.DrawShadow(rd, s, x + pad, cy, 1, 220, 215, 180, 255);
            cy = cy + 16;
        }
        // 称谓 / 爵位
        cy = cy + 6;
        string tp = Data.TITLE_PAGE_NAMES[this.g.p.titlePage] + (this.g.p.titleRank + 1) + " 阶";
        Text.DrawShadow(rd, "称谓:" + tp, x + pad, cy, 1, 230, 200, 120, 255);
        cy = cy + 16;
        string np = this.g.p.nobleTier >= 0 ? Data.NOBLE_NAMES[this.g.p.nobleTier] : "平民";
        Text.DrawShadow(rd, "爵位:" + np, x + pad, cy, 1, 230, 200, 120, 255);
        cy = cy + 16;
        // 升级按钮
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + pad, cy, w - pad * 2, 30,
                      "升级", 2, 1)) {
            if (this.mouseJustUp) {
                this.g.TryTitleUp();
                if (this.g.CanTurn()) { this.g.DoTurn(); }
                this.snd.Up();
            }
        }
        cy = cy + 36;
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + pad, cy, w - pad * 2, 30,
                      "每日福利", 2, 0)) {
            if (this.mouseJustUp) {
                this.g.p.cur[Data.CUR_GOLD] = this.g.p.cur[Data.CUR_GOLD] + 50000;
                this.g.AddChat("[每日福利] 领取 5 万金币");
                this.snd.Box();
            }
        }
        cy = cy + 36;
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + pad, cy, w - pad * 2, 30,
                      "充值", 2, 1)) {
            if (this.mouseJustUp) { this.modal = 40; }
        }
    }

    public void DrawHuanJingMain(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        // 顶部 50px:层数 + 切换按钮
        int ty = y + 6;
        Text.DrawShadow(rd, "幻境 第 " + this.g.p.hjFloor + " 层 (击杀 " +
                        this.g.p.hjKills + "/" + this.g.p.hjTarget + ")",
                        x + 16, ty, 3, 250, 215, 130, 255);
        ty = ty + 28;
        // 地图名
        int mapIdx = 0;
        for (int i = 0; i < 20; i = i + 1) {
            if (Data.MAP_MIN_FLOOR[i] <= this.g.p.hjFloor) { mapIdx = i; }
        }
        Text.DrawShadow(rd, "当前地图:" + Data.MAP_NAMES[mapIdx],
                        x + 16, ty, 2, 200, 200, 220, 255);
        // 自动 / 挑战 / 扫荡 / 说明 按钮
        int bx = x + w - 380;
        int by = y + 8;
        if (Ui.Button(rd, this.mouseX, this.mouseY, bx, by, 80, 28,
                      "自动重置", 1, 0)) {
            if (this.mouseJustUp) {
                this.g.AddChat("[幻境] 已开启自动重置");
            }
        }
        bx = bx + 86;
        if (Ui.Button(rd, this.mouseX, this.mouseY, bx, by, 80, 28,
                      "挑战幻境", 1, 1)) {
            if (this.mouseJustUp) {
                this.g.StepIdle(0.12);
                this.snd.Craft();
            }
        }
        bx = bx + 86;
        if (Ui.Button(rd, this.mouseX, this.mouseY, bx, by, 80, 28,
                      "扫荡幻境", 1, 2)) {
            if (this.mouseJustUp) {
                if (this.g.p.vip >= 1) {
                    for (int i = 0; i < 5; i = i + 1) { this.g.StepIdle(0.12); }
                    this.g.AddChat("[幻境] 扫荡 5 次");
                } else {
                    this.g.AddChat("[系统] 扫荡为终身会员特权");
                }
            }
        }
        bx = bx + 86;
        if (Ui.Button(rd, this.mouseX, this.mouseY, bx, by, 80, 28,
                      "说明", 1, 0)) {
            if (this.mouseJustUp) { this.modal = 15; this.modalSub = 1; }
        }
        // 怪显示区
        int mx = x + w / 2;
        int my = y + 130;
        SdlTexture mt = this.g.curIsBoss ? this.texMobBoss : this.texMobNormal;
        if (mt != null && mt.IsValid()) {
            rd.DrawTexture(mt, mx - 100, my - 60, 200, 200);
        } else {
            Draw.RoundRectFill(rd, mx - 60, my, 120, 120, 12, 70, 60, 50, 220);
        }
        // 怪名
        Text.DrawCentered(rd, this.g.curMonsterName, mx, my - 70, 2, 240, 220, 180, 255);
        // HP bar
        LegendApp.BarImg(rd, mx - 80, my + 130, 160, 14,
                         this.g.curMonsterHp, this.g.curMonsterHpMax);
        Text.DrawCentered(rd, this.g.FormatNum(this.g.curMonsterHp) + "/" +
                        this.g.FormatNum(this.g.curMonsterHpMax),
                        mx, my + 148, 1, 220, 215, 180, 255);
        // 掉落墙(底部 8 格)
        int dwY = y + h - 100;
        Text.DrawShadow(rd, "掉落墙", x + 16, dwY - 18, 2, 220, 215, 180, 255);
        for (int i = 0; i < 12; i = i + 1) {
            int dx = x + 16 + i * 50;
            int dy = dwY;
            // 随机展示一个 ico(模拟最近掉落)
            int seedIdx = (this.g.p.hjKillAcc + i * 7) % 40;
            SdlTexture it = this.texEquip[seedIdx];
            if (it != null && it.IsValid()) {
                rd.DrawTexture(it, dx, dy, 40, 40);
            } else {
                Draw.RoundRectFill(rd, dx, dy, 40, 40, 4, 50, 50, 60, 200);
            }
            int tier = seedIdx % 5;
            int coef = 1 + (i + this.g.p.hjFloor) % 9;
            Text.DrawCentered(rd, "+" + coef, dx + 20, dy + 42, 1, 230, 220, 160, 255);
        }
        // 战斗统计
        int sy = y + h - 26;
        Text.DrawShadow(rd, "击杀:" + this.g.p.totalKills + "  BOSS:" + this.g.p.bossKilled
                        + "  累计伤害:" + this.g.FormatNum(this.g.totalDamageDealt),
                        x + 16, sy, 1, 180, 180, 200, 255);
    }

    public void DrawChatPanel(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        if (this.texPanel != null && this.texPanel.IsValid()) {
            LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, x, y, w, h);
        } else {
            Ui.Panel(rd, x, y, w, h, 26, 30, 44, 232);
        }
        Text.DrawShadow(rd, "聊天 / 广播", x + 12, y + 8, 2, 230, 200, 130, 255);
        // tab:世界 / 行会
        int ty = y + 32;
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 12, ty, 60, 22, "世界", 1, 2)) {
            if (this.mouseJustUp) { this.snd.Tip(); }
        }
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 80, ty, 60, 22, "行会", 1, 0)) {
            if (this.mouseJustUp) { this.snd.Tip(); }
        }
        ty = ty + 30;
        // log
        int maxLines = (h - 80) / 14;
        int start = this.g.p.chatCnt - maxLines;
        if (start < 0) { start = 0; }
        for (int i = start; i < this.g.p.chatCnt; i = i + 1) {
            string m = this.g.p.chatLog[i];
            if (m == null) { continue; }
            int cr = 200; int cg = 200; int cb = 210;
            if (m.IndexOf("[广播]") >= 0) { cr = 250; cg = 215; cb = 130; }
            else if (m.IndexOf("[系统]") >= 0) { cr = 240; cg = 180; cb = 90; }
            else if (m.IndexOf("[掉落]") >= 0 || m.IndexOf("[离线]") >= 0) {
                cr = 180; cg = 240; cb = 200;
            }
            Text.DrawShadow(rd, m, x + 12, ty, 1, cr, cg, cb, 255);
            ty = ty + 14;
        }
        // 输入框(简化)
        int iy = y + h - 32;
        Draw.RoundRectFill(rd, x + 12, iy, w - 80, 22, 4, 38, 42, 56, 220);
        Text.DrawShadow(rd, "(输入栏)", x + 18, iy + 6, 1, 180, 180, 200, 255);
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + w - 60, iy, 48, 22,
                      "发送", 1, 1)) {
            if (this.mouseJustUp) { this.snd.Tip(); }
        }
    }

    // ---------------------------------------------------------------
    // 模态分发
    // ---------------------------------------------------------------
    public void DrawModal() {
        int w = LegendApp.W();
        int h = LegendApp.H();
        SdlRenderer rd = this.r;
        // 暗化
        if (this.texDim != null && this.texDim.IsValid()) {
            rd.SetColor(255, 255, 255, 160);
            rd.DrawTexture(this.texDim, 0, 0, w, h);
            rd.SetColor(255, 255, 255, 255);
        } else {
            Draw.Scrim(rd, w, h);
        }
        // 模态矩形(中央)
        int mw = (int)Math.Min(1100.0, (double)(w - 40));
        int mh = (int)Math.Min(640.0, (double)(h - 100));
        int mx = (w - mw) / 2;
        int my = (h - mh) / 2;
        if (this.texPanel != null && this.texPanel.IsValid()) {
            LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, mx, my, mw, mh);
        } else {
            Ui.Panel(rd, mx, my, mw, mh, 30, 36, 52, 240);
        }
        // 分发
        if (this.modal == 0) { /* 幻境已在主区 */ this.modal = -1; return; }
        else if (this.modal == 1) { this.DrawBossHome(mx, my, mw, mh); }
        else if (this.modal == 2) { this.DrawForge(mx, my, mw, mh); }
        else if (this.modal == 3) { this.DrawRecycle(mx, my, mw, mh); }
        else if (this.modal == 4) { this.DrawXunBao(mx, my, mw, mh); }
        else if (this.modal == 5) { this.DrawAltar(mx, my, mw, mh); }
        else if (this.modal == 6) { this.DrawTitle(mx, my, mw, mh); }
        else if (this.modal == 7) { this.DrawNoble(mx, my, mw, mh); }
        else if (this.modal == 8) { this.DrawWuxing(mx, my, mw, mh); }
        else if (this.modal == 9) { this.DrawCardAlbum(mx, my, mw, mh); }
        else if (this.modal == 10) { this.DrawAchievement(mx, my, mw, mh); }
        else if (this.modal == 11) { this.DrawRanking(mx, my, mw, mh); }
        else if (this.modal == 12) { this.DrawShop(mx, my, mw, mh); }
        else if (this.modal == 13) { this.DrawMail(mx, my, mw, mh); }
        else if (this.modal == 14) { this.DrawSettings(mx, my, mw, mh); }
        else if (this.modal == 15) { this.DrawHelp(mx, my, mw, mh); }
        else if (this.modal == 16) { this.DrawBag(mx, my, mw, mh); }
        else if (this.modal == 17) { this.DrawAlbum(mx, my, mw, mh); }
        else if (this.modal == 18) { this.DrawDianTang(mx, my, mw, mh); }
        else if (this.modal == 19) { this.DrawWorldBoss(mx, my, mw, mh); }
        else if (this.modal == 20) { this.DrawPK(mx, my, mw, mh); }
        else if (this.modal == 21) { this.DrawYabiao(mx, my, mw, mh); }
        else if (this.modal == 22) { this.DrawCity(mx, my, mw, mh); }
        else if (this.modal == 23) { this.DrawTower(mx, my, mw, mh); }
        else if (this.modal == 24) { this.DrawMaster(mx, my, mw, mh); }
        else if (this.modal == 25) { this.DrawGuild(mx, my, mw, mh); }
        else if (this.modal == 26) { this.DrawShabake(mx, my, mw, mh); }
        else if (this.modal == 27) { this.DrawMap(mx, my, mw, mh); }
        else if (this.modal == 28) { this.DrawMijing(mx, my, mw, mh); }
        else if (this.modal == 29) { this.DrawRedBag(mx, my, mw, mh); }
        else if (this.modal == 30) { this.DrawMarket(mx, my, mw, mh); }
        else if (this.modal == 40) { this.DrawCharge(mx, my, mw, mh); }
        else { this.modal = -1; return; }
        // 关闭按钮(右上)
        int cx = mx + mw - 36;
        int cy = my + 6;
        if (Draw.PointIn(this.mouseX, this.mouseY, cx, cy, 28, 28)) {
            Draw.RoundRectFill(rd, cx - 2, cy - 2, 32, 32, 6, 200, 80, 80, 220);
            if (this.mouseJustUp) { this.modal = -1; this.snd.Tip(); }
        }
        Text.DrawCentered(rd, "X", cx + 14, cy + 8, 2, 255, 255, 255, 255);
        // 标题
        Text.DrawShadow(rd, this.ModalTitle(), mx + 16, my + 12, 3, 250, 215, 130, 255);
    }

