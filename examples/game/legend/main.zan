            Text.DrawShadow(rd, "排名:#" + (i + 1) + " 战力:" + this.g.FormatNum(1000 + i * 500),
                            bx + 12, by + 30, 1, 220, 215, 180, 255);
            Text.DrawShadow(rd, "胜 +100 战功 / 负 +20 战功",
                            bx + 12, by + 50, 1, 200, 200, 220, 255);
        }
