        TOP2[0]="五行修炼"; TOP2[1]="师徒";    TOP2[2]="秘境";
        TOP2[3]="世界BOSS"; TOP2[4]="祭坛";    TOP2[5]="寻宝";
        TOP2[6]="将星图谱"; TOP2[7]="回收系统"; TOP2[8]="发红包";
        TOP2[9]="至尊极品";
        TOP2_PG[0]=8; TOP2_PG[1]=24; TOP2_PG[2]=28;
