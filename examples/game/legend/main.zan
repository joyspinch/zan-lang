    // 通用面板标题(简化)
    public void DrawPanelHeader(int x, int y, int w, string subtitle) {
        SdlRenderer rd = this.r;
        Draw.RoundRectFill(rd, x + 4, y + 38, w - 8, 24, 6, 38, 30, 22, 180);
        Text.DrawShadow(rd, subtitle, x + 16, y + 44, 1, 230, 215, 180, 255);
    }

    // ---------------------------------------------------------------
    // 模态实现
    // ---------------------------------------------------------------

    public void DrawBossHome(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w, "今日剩余次数:" + this.g.p.bhTriesLeft);
        int yy = y + 76;
        int cols = 4;
        for (int i = 0; i < 8; i = i + 1) {
            int col = i % cols;
            int row = i / cols;
            int bx = x + 16 + col * ((w - 32) / cols);
            int by = yy + row * 110;
            int bw = (w - 32) / cols - 12;
            int bh = 100;
            bool hov = Draw.PointIn(this.mouseX, this.mouseY, bx, by, bw, bh);
            if (this.texPanel != null && this.texPanel.IsValid()) {
                LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, bx, by, bw, bh);
            } else {
                Ui.Panel(rd, bx, by, bw, bh, 38, 30, 22, 230);
            }
            // BOSS 立绘
            if (this.texBoss != null && i < 4 && this.texBoss[i] != null
                && this.texBoss[i].IsValid()) {
                rd.DrawTexture(this.texBoss[i], bx + 4, by + 4, 56, 56);
            } else if (this.texMobBoss != null && this.texMobBoss.IsValid()) {
                rd.DrawTexture(this.texMobBoss, bx + 4, by + 4, 56, 56);
            } else {
                Draw.RoundRectFill(rd, bx + 4, by + 4, 56, 56, 4, 80, 40, 40, 220);
            }
            Text.DrawShadow(rd, Data.BOSS_NAMES[i], bx + 66, by + 8, 1, 240, 220, 180, 255);
            Text.DrawShadow(rd, "Lv." + Data.BOSS_LV[i], bx + 66, by + 24, 1, 200, 200, 220, 255);
            Text.DrawShadow(rd, "HP:" + Data.BOSS_HP_BASE[i],
                            bx + 66, by + 40, 1, 220, 180, 180, 255);
            Text.DrawShadow(rd, "击杀:" + this.g.p.bhKilled[i],
                            bx + 66, by + 56, 1, 220, 200, 160, 255);
            // 挑战按钮
            if (Ui.Button(rd, this.mouseX, this.mouseY, bx + 4, by + 70, bw - 8, 24,
                          "挑战", 1, hov ? 1 : 0)) {
                if (this.mouseJustUp) {
                    this.g.ChallengeBossHome(i);
                    this.snd.Craft();
                }
            }
        }
    }

    public void DrawForge(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w, "铁匠铺 11 模式 / 当前:" + Data.FORGE_MODES[this.forgeMode]);
        // 左侧 11 模式按钮(纵排)
        int lx = x + 16;
        int ly = y + 76;
        int lw = 110;
        int lh = 26;
        for (int i = 0; i < 11; i = i + 1) {
            int by = ly + i * (lh + 4);
            int kind = this.forgeMode == i ? 2 : 0;
            if (Ui.Button(rd, this.mouseX, this.mouseY, lx, by, lw, lh,
                          Data.FORGE_MODES[i], 1, kind)) {
                if (this.mouseJustUp) { this.forgeMode = i; this.forgeSel = false; }
            }
        }
        // 右侧:装备列表面板
        int rx = lx + lw + 16;
        int ry = ly;
        int rw = w - (rx - x) - 16;
        int rh = h - (ry - y) - 16;
        if (this.texPanel != null && this.texPanel.IsValid()) {
            LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, rx, ry, rw, rh);
        } else {
            Ui.Panel(rd, rx, ry, rw, rh, 30, 36, 52, 230);
        }
        // 标题
        string title = "选择装备";
        if (this.forgeMode == 0) { title = "金币洗炼(可能降低)"; }
        else if (this.forgeMode == 1) { title = "元宝洗炼(保底)"; }
        else if (this.forgeMode == 3) { title = "升级锻造(耗金币)"; }
        Text.DrawShadow(rd, title, rx + 12, ry + 8, 2, 230, 215, 180, 255);
        ry = ry + 36;
        // 装备 60 格
        int gx = rx + 12;
        int gy = ry;
        for (int i = 0; i < this.g.p.bagCnt && i < 60; i = i + 1) {
            int c = i % 10;
            int r = i / 10;
            int bx = gx + c * 56;
            int by = gy + r * 56;
            Item it = this.g.p.bag[i];
            if (it == null) { continue; }
            SdlTexture tex = this.texEquip[it.cls * 5 + it.tier];
            bool hov = Draw.PointIn(this.mouseX, this.mouseY, bx, by, 48, 48);
            if (this.texPanel != null && this.texPanel.IsValid()) {
                LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, bx - 2, by - 2, 52, 52);
            } else {
                Draw.RoundRectFill(rd, bx, by, 48, 48, 4, 38, 42, 56, 220);
            }
            if (tex != null && tex.IsValid()) {
                rd.DrawTexture(tex, bx, by, 48, 48);
            }
            Text.DrawCentered(rd, "+" + it.coef, bx + 24, by + 48, 1, 230, 200, 130, 255);
            if (hov && this.mouseJustUp) {
                this.bagSel = i;
                this.forgeSel = true;
                this.snd.Tip();
            }
        }
        // 右侧详细 + 操作按钮
        int dx = rx + rw - 280;
        int dy = ry;
        if (this.forgeSel && this.bagSel >= 0 && this.bagSel < this.g.p.bagCnt) {
            Item it = this.g.p.bag[this.bagSel];
            if (it != null) {
                Text.DrawShadow(rd, it.Name(), dx, dy, 2, 240, 220, 180, 255);
                dy = dy + 26;
                Text.DrawShadow(rd, "品阶:" + Data.EQUIP_TIER_NAMES[it.tier], dx, dy, 1, 220, 210, 180, 255);
                dy = dy + 16;
                Text.DrawShadow(rd, "系数:" + it.coef + "/" + Data.TIER_COEF_CAP[it.tier], dx, dy, 1, 220, 210, 180, 255);
                dy = dy + 16;
                Text.DrawShadow(rd, "槽位:" + Data.SLOT_NAMES[it.slot], dx, dy, 1, 220, 210, 180, 255);
                dy = dy + 24;
                if (this.forgeMode == 0) {
                    int cost = (int)(Data.GOLD_REFINE_COST_BASE * Math.Pow(it.coef, Data.GOLD_REFINE_COST_POW));
                    Text.DrawShadow(rd, "金币洗炼 费用:" + cost, dx, dy, 1, 220, 215, 180, 255);
                    dy = dy + 18;
                    if (Ui.Button(rd, this.mouseX, this.mouseY, dx, dy, 240, 30,
                                  "开始洗炼", 2, 1)) {
                        if (this.mouseJustUp) {
                            this.g.RefineGold(this.bagSel);
                            this.snd.Craft();
                        }
                    }
                } else if (this.forgeMode == 1) {
                    int cost = Data.YB_REFINE_COST_BASE + it.coef * 5;
                    Text.DrawShadow(rd, "元宝洗炼 费用:" + cost, dx, dy, 1, 220, 215, 180, 255);
                    dy = dy + 18;
                    if (Ui.Button(rd, this.mouseX, this.mouseY, dx, dy, 240, 30,
                                  "开始洗炼", 2, 1)) {
                        if (this.mouseJustUp) {
                            this.g.RefineYb(this.bagSel);
                            this.snd.Craft();
                        }
                    }
                } else if (this.forgeMode == 3) {
                    long cost = 5000 + it.tier * 3000;
                    Text.DrawShadow(rd, "升级 费用:" + cost + " 金币", dx, dy, 1, 220, 215, 180, 255);
                    dy = dy + 18;
                    if (Ui.Button(rd, this.mouseX, this.mouseY, dx, dy, 240, 30,
                                  "锻造", 2, 1)) {
                        if (this.mouseJustUp) {
                            this.g.UpgradeEquip(this.bagSel);
                            this.snd.Craft();
                        }
                    }
                }
            }
        }
    }

    public void DrawRecycle(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w, "回收 — 一件装备可换 7 种货币");
        // 7 货币按钮
        int my = y + 76;
        int mx = x + 16;
        int bw = (w - 32) / 7;
        for (int i = 0; i < Data.CUR_COUNT; i = i + 1) {
            int bx = mx + i * bw;
            int kind = this.bagSel == -100 - i ? 2 : 0;
            if (Ui.Button(rd, this.mouseX, this.mouseY, bx, my, bw - 4, 28,
                          Data.CUR_NAMES[i], 1, kind)) {
                if (this.mouseJustUp) {
                    this.refineKind = i;
                    this.bagSel = -100 - i;
                }
            }
        }
        my = my + 36;
        // 装备列
        int gx = mx;
        int gy = my;
        for (int i = 0; i < this.g.p.bagCnt && i < 60; i = i + 1) {
            int c = i % 12;
            int r = i / 12;
            int bx = gx + c * 52;
            int by = gy + r * 52;
            Item it = this.g.p.bag[i];
            if (it == null) { continue; }
            SdlTexture tex = this.texEquip[it.cls * 5 + it.tier];
            bool hov = Draw.PointIn(this.mouseX, this.mouseY, bx, by, 48, 48);
            if (this.texPanel != null && this.texPanel.IsValid()) {
                LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, bx - 2, by - 2, 52, 52);
            } else {
                Draw.RoundRectFill(rd, bx, by, 48, 48, 4, 38, 42, 56, 220);
            }
            if (tex != null && tex.IsValid()) {
                rd.DrawTexture(tex, bx, by, 48, 48);
            }
            Text.DrawCentered(rd, "+" + it.coef, bx + 24, by + 48, 1, 230, 200, 130, 255);
            if (hov && this.mouseJustUp && this.refineKind >= 0) {
                this.g.Recycle(i, this.refineKind);
                this.snd.Trade();
            }
        }
    }

    public void DrawXunBao(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w, "寻宝 — 今日寻宝图:" + this.g.p.xbTickets);
        int cy = y + 76;
        // 抽一次
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 16, cy, 160, 40,
                      "抽一次", 2, 1)) {
            if (this.mouseJustUp) { this.g.XunBao(); this.snd.Box(); }
        }
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 184, cy, 160, 40,
                      "抽十次", 2, 0)) {
            if (this.mouseJustUp) {
                for (int i = 0; i < 10; i = i + 1) { this.g.XunBao(); }
                this.snd.Box();
            }
        }
        // 奖池
        cy = cy + 60;
        for (int i = 0; i < Data.XB_POOL_SIZE; i = i + 1) {
            int col = i % 4;
            int row = i / 4;
            int bx = x + 16 + col * 250;
            int by = cy + row * 90;
            int bw = 240;
            int bh = 80;
            if (this.texPanel != null && this.texPanel.IsValid()) {
                LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, bx, by, bw, bh);
            } else {
                Ui.Panel(rd, bx, by, bw, bh, 38, 30, 22, 220);
            }
            Text.DrawShadow(rd, Data.XB_PRIZE_NAMES[i], bx + 10, by + 8, 1, 240, 220, 180, 255);
            Text.DrawShadow(rd, "价值:" + Data.XB_PRIZE_VAL[i] + " 元宝", bx + 10, by + 26, 1, 200, 200, 220, 255);
            string pr = "";
            double r = Data.XB_PRIZE_RATE[i];
            int r100 = (int)(r * 10000);
            pr = r100 / 100 + "." + (r100 % 100) + "%";
            Text.DrawShadow(rd, "概率:" + pr, bx + 10, by + 42, 1, 200, 200, 220, 255);
            Text.DrawShadow(rd, "今日:" + this.g.p.xbPool[i] + " 次",
                            bx + 10, by + 58, 1, 230, 200, 130, 255);
        }
    }

    public void DrawAltar(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w, "祭坛 — 个人 + 全服共建");
        int my = y + 76;
        Text.DrawShadow(rd, "我的进度:" + this.g.p.altarMyProg + "/" + Data.ALTAR_MY_TARGET,
                        x + 16, my, 2, 220, 215, 180, 255);
        LegendApp.BarImg(rd, x + 16, my + 22, w - 32, 14,
                         this.g.p.altarMyProg, Data.ALTAR_MY_TARGET);
        my = my + 50;
        Text.DrawShadow(rd, "全服进度:" + this.g.p.altarGlobalProg + "/" + Data.ALTAR_GLOBAL_TARGET,
                        x + 16, my, 2, 220, 215, 180, 255);
        LegendApp.BarImg(rd, x + 16, my + 22, w - 32, 14,
                         this.g.p.altarGlobalProg, Data.ALTAR_GLOBAL_TARGET);
        my = my + 60;
        // 捐献按钮
        string[] lbl = new string[5];
        lbl[0] = "金币×1"; lbl[1] = "金砖×1"; lbl[2] = "天书×1";
        lbl[3] = "黑铁×500"; lbl[4] = "100 元宝";
        for (int i = 0; i < 5; i = i + 1) {
            int bx = x + 16 + i * 130;
            if (Ui.Button(rd, this.mouseX, this.mouseY, bx, my, 120, 30,
                          lbl[i], 1, 1)) {
                if (this.mouseJustUp) { this.g.AltarDonate(i); this.snd.Trade(); }
            }
        }
        my = my + 40;
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 16, my, 160, 30,
                      "补领昨日奖励", 1, 1)) {
            if (this.mouseJustUp) {
                this.g.p.cur[Data.CUR_GOLD] = this.g.p.cur[Data.CUR_GOLD] + 30000;
                this.g.AddChat("[祭坛] 补领 3 万金币");
            }
        }
    }

    public void DrawTitle(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w,
            "称谓 天梯(21 页 × 5 阶) 当前:" +
            Data.TITLE_PAGE_NAMES[this.g.p.titlePage] + (this.g.p.titleRank + 1) + " 阶");
        // 3 列 7 行 = 21 页
        int gx = x + 16;
        int gy = y + 76;
        int cellW = (w - 32) / 3 - 4;
        int cellH = 30;
        for (int i = 0; i < Data.TITLE_TOTAL; i = i + 1) {
            int col = i % 3;
            int row = i / 3;
            int bx = gx + col * (cellW + 4);
            int by = gy + row * (cellH + 4);
            bool cur = (i == this.g.p.titlePage);
            int kind = cur ? 2 : 0;
            if (Ui.Button(rd, this.mouseX, this.mouseY, bx, by, cellW, cellH,
                          Data.TITLE_PAGE_NAMES[i], 1, kind)) {
                if (this.mouseJustUp) { this.g.TryTitleUp(); this.snd.Tip(); }
            }
        }
    }

