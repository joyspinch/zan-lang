    [DllImport("crt", EntryPoint = "getenv")]
    static extern string SysGetenvRaw(string name);

    static string SysGetenv(string name) {
        string v = LegendApp.SysGetenvRaw(name);
        if (v == null) { return ""; }
        return v;
    }

    public static int W() { return Data.W; }
    public static int H() { return Data.H; }
    public static int MainTop() { return Data.MAIN_TOP; }
    public static int MainBottom() { return Data.MAIN_BOTTOM(); }

    static SdlTexture LoadTex(SdlRenderer r, string rel, System.IO.StreamWriter log) {
        // 顺序:① Assets.Find 命中的磁盘路径直接 LoadImage;② 磁盘读不出时
        // 尝试内嵌副本(ExtractEmbedded 落盘再读)。注意不能用 File.Exists
        // 做【磁盘】判定 —— 它对相对路径会因内嵌兜底返回 true,与 stbi 的
        // 磁盘读取错位,必须以 LoadImage 实际结果为准。
        string p = Assets.Find(rel);
        SdlTexture t = SdlTexture.LoadImage(r, p);
        bool ok = (t != null && t.IsValid());
        if (!ok && System.IO.File.EmbedExists(rel)) {
            string tmp = Assets.ExeDir() + "/_embed_" + System.IO.Path.GetFileName(rel);
            if (System.IO.File.ExtractEmbedded(rel, tmp)) {
                t = SdlTexture.LoadImage(r, tmp);
                ok = (t != null && t.IsValid());
                p = tmp + " (embed)";
            }
        }
        if (!ok) {
            log.WriteLine("[ASSET FAIL] rel=" + rel + " resolved=" + p);
        } else {
            log.WriteLine("[ASSET OK] " + rel + " -> " + p);
        }
        return t;
    }

    // 音效加载:磁盘优先,内嵌回退(WAV 同样可能只在内嵌里)。
    static SdlAudioClip LoadWav2(string rel) {
        string p = Assets.Find(rel);
        SdlAudioClip c = SdlAudioClip.LoadWav(p);
        if (c != null && c.IsValid()) { return c; }
        if (System.IO.File.EmbedExists(rel)) {
            string tmp = Assets.ExeDir() + "/_embed_" + System.IO.Path.GetFileName(rel);
            if (System.IO.File.ExtractEmbedded(rel, tmp)) {
                c = SdlAudioClip.LoadWav(tmp);
                if (c != null && c.IsValid()) { return c; }
            }
        }
        return c;
    }

    public static LegendApp Create(Host h) {
        LegendApp a = new LegendApp();
        a.host = h;
        a.r = h.Renderer();
        appRef = a;
        a.uiRng = Rng.Seed(987654321L);
        string logDir = Assets.ExeDir();
        System.IO.StreamWriter log = new System.IO.StreamWriter(logDir + "/legend_assets.log");
        log.WriteLine("=== assets load log ===");
        string self = ProcessHost.SelfExe();
        string exeDir = Assets.ExeDir();
        log.WriteLine("SelfExe=" + self + " ExeDir=" + exeDir + " Cwd=" + System.IO.Directory.GetCurrentDirectory());
        // 货币图标(用 5 个,金币/元宝/声望/灵符/积分)
        a.texIcon = new SdlTexture[5];
        a.texIcon[0] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/icon_gold.png", log);
        a.texIcon[1] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/icon_crystal.png", log);
        a.texIcon[2] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/icon_iron.png", log);
        a.texIcon[3] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/icon_copper.png", log);
        a.texIcon[4] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/icon_core.png", log);
        // 装备 8×5
        a.texEquip = new SdlTexture[40];
        for (int c = 0; c < 8; c = c + 1) {
            for (int t = 0; t < 5; t = t + 1) {
                string p = "examples/game/legend/assets/equip_c" + c + "_t" + t + ".png";
                a.texEquip[c * 5 + t] = LegendApp.LoadTex(a.r, p, log);
            }
        }
        // 怪物 / 职业立绘
        a.texMobNormal = LegendApp.LoadTex(a.r, "examples/game/legend/assets/monster_normal.png", log);
        a.texMobBoss = LegendApp.LoadTex(a.r, "examples/game/legend/assets/monster_boss.png", log);
        a.texClass = new SdlTexture[3];
        a.texClass[0] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/class_warrior.png", log);
        a.texClass[1] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/class_mage.png", log);
        a.texClass[2] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/class_taoist.png", log);
        a.texBossFull = new SdlTexture[28];
        a.texBossFull[0] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/boss_woma.png", log);
        a.texBossFull[1] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/boss_zuma.png", log);
        a.texBossFull[2] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/boss_chiyue.png", log);
        a.texBossFull[3] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/boss_molong.png", log);
        for (int i = 4; i < 28; i = i + 1) {
            string bn = (i < 10 ? "0" : "") + i;
            a.texBossFull[i] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/boss_p" + bn + ".png", log);
        }
        a.texMob = new SdlTexture[64];
        for (int i = 0; i < 64; i = i + 1) {
            string mn2 = (i < 10 ? "0" : "") + i;
            a.texMob[i] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/mob_" + mn2 + ".png", log);
        }
        a.texGem = new SdlTexture[5];
        for (int i = 0; i < 5; i = i + 1) {
            a.texGem[i] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/gem_" + i + ".png", log);
        }
        a.texBook = LegendApp.LoadTex(a.r, "examples/game/legend/assets/ui_book.png", log);
        a.texSkillIc = new SdlTexture[7];
        for (int i = 0; i < 7; i = i + 1) {
            a.texSkillIc[i] = LegendApp.LoadTex(a.r, "examples/game/legend/assets/ui_skill_" + i + ".png", log);
        }
        a.texMapBichon = LegendApp.LoadTex(a.r, "examples/game/legend/assets/map_bichon.png", log);
        a.texBg = LegendApp.LoadTex(a.r, "examples/game/legend/assets/bg_mine.jpg", log);
        a.texSplash = LegendApp.LoadTex(a.r, "examples/game/legend/assets/splash.png", log);
        a.texDim = LegendApp.LoadTex(a.r, "examples/game/legend/assets/dim_bg.jpg", log);
        a.texBtnDark = LegendApp.LoadTex(a.r, "examples/game/legend/assets/btn_dark.png", log);
        a.texBtnDarkHi = LegendApp.LoadTex(a.r, "examples/game/legend/assets/btn_dark_hi.png", log);
        a.texBtnGold = LegendApp.LoadTex(a.r, "examples/game/legend/assets/btn_gold.png", log);
        a.texBtnGoldHi = LegendApp.LoadTex(a.r, "examples/game/legend/assets/btn_gold_hi.png", log);
        a.texBtnGreen = LegendApp.LoadTex(a.r, "examples/game/legend/assets/btn_green.png", log);
        a.texPanelNine = LegendApp.LoadTex(a.r, "examples/game/legend/assets/panel_nine.png", log);
        a.texSlot = LegendApp.LoadTex(a.r, "examples/game/legend/assets/slot.png", log);
        a.texRowPlate = LegendApp.LoadTex(a.r, "examples/game/legend/assets/row_plate.png", log);
        a.texBarTrough = LegendApp.LoadTex(a.r, "examples/game/legend/assets/bar_trough.png", log);
        if (a.texBg != null && a.texBg.IsValid()) {
            a.texBg.SetBlendMode(1);
        }
        if (a.texSplash != null && a.texSplash.IsValid()) {
            a.texSplash.SetBlendMode(1);
        }
        // 启动游戏
        a.g = new Game();
        bool loaded = a.g.Load();
        if (!loaded) {
            a.g.NewGame("传奇玩家", 0);
        }
        // 离线结算
        a.g.OfflineSettle();
        // 检查日刷新
        if (a.g.IsNewDay()) { a.g.DayReset(); }
        a.modal = 31;  // 类选择屏
        a.splashStart = a.now;
        log.WriteLine("=== assets load end ===");
        log.Close();
        return a;
    }

    public void Tick() {
        if (this.modal == 31) {
            this.DrawClassSelect();
            return;
        }
        // 自动战斗(节拍 120ms)
        if (this.now - this.lastStepAt >= 120) {
            this.lastStepAt = this.now;
            this.g.StepIdle(0.12);
        }
        // 自动广播
        this.g.AutoBroadcast();
        this.DrawAll();
    }

    public void Save() { this.g.Save(); }

    // ---------------------------------------------------------------
    // 渲染:全局
    // ---------------------------------------------------------------
    public void DrawAll() {
        int w = LegendApp.W();
        int h = LegendApp.H();
        SdlRenderer rd = this.r;
        // 老板键隐藏
        if (this.g.bossMode) {
            rd.SetColor(28, 32, 44, 255);
            rd.Clear();
            Text.DrawCentered(rd, "(静默运行中…按 F10 恢复)", w / 2, h / 2, 3,
                              200, 200, 220, 255);
            return;
        }
        // 背景
        if (this.texBg != null && this.texBg.IsValid()) {
            rd.DrawTexture(this.texBg, 0, 0, w, h);
        } else {
            Draw.VGradient(rd, 0, 0, w, h, 18, 22, 32, 8, 10, 16, 255);
        }
        // 暗化遮罩
        if (this.texDim != null && this.texDim.IsValid()) {
            rd.SetColor(255, 255, 255, 80);
            rd.DrawTexture(this.texDim, 0, 0, w, h);
            rd.SetColor(255, 255, 255, 255);
        }
        // 标题栏
        this.DrawTitleBar();
        // 顶部两排导航
        this.DrawTopNav();
        // 主区
        this.DrawMainArea();
        // 底部导航
        this.DrawBottomNav();
        // 模态面板
        if (this.modal >= 0) { this.DrawModal(); }
    }

    public void DrawTitleBar() {
        int w = LegendApp.W();
        SdlRenderer rd = this.r;
        Draw.RoundRectFill(rd, 0, 0, w, Data.TITLE_BAR_H, 0, 12, 16, 26, 255);
        Draw.RoundRectFill(rd, 0, Data.TITLE_BAR_H - 2, w, 2, 0, 198, 158, 80, 220);
        // 标题
        Text.DrawShadow(rd, "传奇放置挂机", 16, 12, 2, 230, 198, 130, 255);
        // 角色信息
        string[] clsN = new string[3];
        clsN[0] = "战士"; clsN[1] = "法师"; clsN[2] = "道士";
        Text.DrawShadow(rd, "Lv." + this.g.p.lv + "  " + clsN[this.g.p.cls],
                        200, 12, 2, 230, 220, 200, 255);
        // 货币(右侧 5 个,右对齐收尾,等距 120,图标-文字同基线)
        int mx = w - 600;
        for (int i = 0; i < 5; i = i + 1) {
            int idx = i;
            if (idx == 4) { idx = 6; }  // 积分
            long v = this.g.p.cur[idx];
            string s = this.g.FormatCur(v);
            int tw = Text.Width(rd, s, 2);
            int ix = mx + i * 120;
            // 图标与文字垂直居中于 40px 标题栏中线
            if (this.texIcon[i] != null && this.texIcon[i].IsValid()) {
                rd.DrawTexture(this.texIcon[i], ix, 11, 18, 18);
            }
            Text.DrawShadow(rd, s, ix + 24, 12, 2, 230, 215, 175, 255);
        }
        // 设置齿轮按钮
        int sx = w - 36;
        int sy = 4;
        if (Draw.PointIn(this.mouseX, this.mouseY, sx, sy, 32, 32)) {
            Draw.RoundRectFill(rd, sx - 2, sy - 2, 36, 36, 6, 90, 110, 140, 220);
            if (this.mouseJustUp) { this.modal = 14; this.g.ToggleBossKey(); }
        }
        Text.DrawCentered(rd, "⚙", sx + 16, sy + 8, 2, 230, 200, 130, 255);
    }

    public void DrawTopNav() {
        SdlRenderer rd = this.r;
        int y0 = Data.TITLE_BAR_H;
        int by = y0 + 6;
        int bh = Data.NAV_ROW_H - 12;
        // 排 1
        for (int i = 0; i < 10; i = i + 1) {
            int bx = i * 128 + 4;
            this.DrawNavBtn(bx, by, 120, bh, NavBtn.TOP1[i], NavBtn.TOP1_PG[i], 0);
        }
        // 排 2
        by = y0 + Data.NAV_ROW_H + 6;
        for (int i = 0; i < 10; i = i + 1) {
            int bx = i * 128 + 4;
            this.DrawNavBtn(bx, by, 120, bh, NavBtn.TOP2[i], NavBtn.TOP2_PG[i], 1);
        }
    }

    public void DrawBottomNav() {
        SdlRenderer rd = this.r;
        int by = LegendApp.MainBottom() + 4;
        for (int i = 0; i < 10; i = i + 1) {
            int bx = i * 128 + 4;
            this.DrawNavBtn(bx, by, 120, 60, NavBtn.BOT[i], NavBtn.BOT_PG[i], 2);
        }
    }

    public void DrawNavBtn(int x, int y, int w, int h, string label, int page, int row) {
        SdlRenderer rd = this.r;
        bool hov = Draw.PointIn(this.mouseX, this.mouseY, x, y, w, h);
        bool sel = (this.modal == page);
        SdlTexture tex;
        if (sel) { tex = this.texBtnGoldHi; }
        else if (hov && row != 0) { tex = this.texBtnDarkHi; }
        else if (row == 0) { tex = this.texBtnGold; }
        else { tex = this.texBtnDark; }
        if (hov && !sel) {
            // 悬停不换底色(金底变暗色像坏了),只描一圈金亮框
            Draw.RoundRectStroke(rd, x - 3, y - 3, w + 6, h + 6, 10, 2,
                                 250, 214, 120, 200);
        }
        if (tex != null && tex.IsValid()) {
            // btn_*.png 为 128x128 整板:0..13 与 114..127 是连续雕花边框带,
            // 14..113 是均匀平板。按整块、边框 14 切九宫,雕花完整落在四角,
            // 拉伸只发生在中心;切小了会把雕花采样进可拉伸区,边缘残缺。
            LegendApp.NineImg(rd, tex, 128, 128, 14, 14, x, y, w, h);
        } else {
            Ui.Panel(rd, x, y, w, h, 46, 52, 70, 220);
        }
        // 金底(选中/顶排)用深棕字且不带阴影,深底用白字带阴影
        int ty = y + h / 2 - 9;
        if (sel || row == 0) {
            Text.Draw(rd, label, x + w / 2 - Text.Width(rd, label, 2) / 2,
                      ty, 2, 62, 40, 12, 255);
        } else {
            Text.DrawCenteredShadow(rd, label, x + w / 2, ty, 2,
                                    235, 235, 235, 255);
        }
        if (hov && this.mouseJustUp) {
            if (this.modal == page) { this.modal = -1; }
            else { this.modal = page; this.modalSub = 0; }
            this.snd.Tip();
        }
    }

    // ---------------------------------------------------------------
    // 主区
    // ---------------------------------------------------------------
    public void DrawMainArea() {
        int w = LegendApp.W();
        int y0 = LegendApp.MainTop();
        int y1 = LegendApp.MainBottom();
        // 左角色面板
        this.DrawCharPanel(0, y0, 240, y1 - y0);
        // 中央:幻境主显示
        this.DrawHuanJingMain(240, y0, w - 240 - 320, y1 - y0);
        // 右聊天
        this.DrawChatPanel(w - 320, y0, 320, y1 - y0);
    }

    public void DrawCharPanel(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        LegendApp.PanelImg(rd, x, y, w, h);
        LegendApp.ModBegin(rd, x + 2, y + 2, w - 4, h - 4);
        int pad = 12;
        int cy = y + pad;
        // 头像(左) + 装备格 4x3(右),名字/转生压在头像下;
        // 4 列 28px 格 + 3px 缝 = 121px,从 x+108 起正好收在面板内(旧 34px 格越界 8px)
        int ax = x + pad;
        if (this.texClass != null && this.texClass[this.g.p.cls] != null
            && this.texClass[this.g.p.cls].IsValid()) {
            rd.DrawTexture(this.texClass[this.g.p.cls], ax, cy, 84, 84);
        } else {
            Draw.RoundRectFill(rd, ax, cy, 84, 84, 8, 60, 50, 38, 255);
        }
        Text.DrawCentered(rd, this.g.p.name, ax + 42, cy + 88, 2, 240, 220, 180, 255);
        Text.DrawCentered(rd, this.g.p.turn + " 转 · Lv." + this.g.p.lv,
                          ax + 42, cy + 110, 1, 200, 170, 100, 255);
        // ===== 装备格 4 列 x 3 行 = 12 槽,点击卸下 =====
        int gx = x + pad + 96;
        int cell = 28;
        int gap = 3;
        Text.DrawShadow(rd, "装备", gx, cy - 2, 1, 230, 200, 120, 255);
        for (int i = 0; i < Data.SLOT_COUNT; i = i + 1) {
            int col = i % 4;
            int row = i / 4;
            int sx = gx + col * (cell + gap);
            int sy = cy + 16 + row * (cell + gap);
            Item eq = this.g.p.equip[i];
            if (this.EquipSlot(sx, sy, cell, cell, eq, null)) {
                this.g.UnequipToBag(i);
                this.snd.Tip();
            }
        }
        cy = cy + 16 + 3 * (cell + gap) + 10;
        // 属性:一行一条,2 号字(面板有充足纵向空间,不再两列挤 1 号小字)
        Text.DrawShadow(rd, "生命:" + this.g.TotalHp()
                             + "    魔法:" + this.g.TotalMp(),
                        x + pad, cy, 2, 220, 210, 180, 255);
        cy = cy + 24;
        Text.DrawShadow(rd, "攻击:" + this.g.TotalAcMin() + "-" + this.g.TotalAcMax(),
                        x + pad, cy, 2, 220, 210, 180, 255);
        cy = cy + 24;
        Text.DrawShadow(rd, "防御:" + this.g.TotalDef()
                             + "    魔防:" + this.g.TotalMDef(),
                        x + pad, cy, 2, 220, 210, 180, 255);
        cy = cy + 24;
        Text.DrawShadow(rd, "经验:" + this.g.ExpForLv(this.g.p.lv),
                        x + pad, cy, 2, 220, 210, 180, 255);
        cy = cy + 26;
        // 经验条
        LegendApp.BarImg(rd, x + pad, cy, w - pad * 2, 14,
                         this.g.p.xp, this.g.ExpForLv(this.g.p.lv));
        cy = cy + 22;
        // 货币(4 条,2 号字,金色调)
        for (int i = 0; i < 4; i = i + 1) {
            int idx = i;
            if (idx == 3) { idx = 6; }
            long v = this.g.p.cur[idx];
            string s = Data.CUR_NAMES[idx] + ":" + this.g.FormatCur(v);
            Text.DrawShadow(rd, s, x + pad, cy, 2, 225, 205, 150, 255);
            cy = cy + 24;
        }
        // 称谓 / 爵位(各占一行,2 号字)
        string tp = Data.TITLE_PAGE_NAMES[this.g.p.titlePage] + (this.g.p.titleRank + 1) + " 阶";
        Text.DrawShadow(rd, "称谓:" + tp, x + pad, cy, 2, 230, 200, 120, 255);
        cy = cy + 24;
        string np = this.g.p.nobleTier >= 0 ? Data.NOBLE_NAMES[this.g.p.nobleTier] : "平民";
        Text.DrawShadow(rd, "爵位:" + np, x + pad, cy, 2, 230, 200, 120, 255);
        // 按钮锚在面板底部(不再吊在半空留一大截死区)
        int by2 = y + h - pad - 30;
        int bw3 = (w - pad * 2 - 8) / 3;
        if (this.BtnTex(x + pad, by2, bw3, 30, "升级", 1, 1)) {
            if (this.mouseJustUp) {
                this.g.TryTitleUp();
                if (this.g.CanTurn()) { this.g.DoTurn(); }
                this.snd.Up();
            }
        }
        if (this.BtnTex(x + pad + bw3 + 4, by2, bw3, 30, "福利", 1, 0)) {
            if (this.mouseJustUp) { this.g.ClaimWelfare(); this.snd.Box(); }
        }
        if (this.BtnTex(x + pad + (bw3 + 4) * 2, by2, bw3, 30, "充值", 1, 1)) {
            if (this.mouseJustUp) { this.modal = 40; }
        }
        LegendApp.ModEnd(rd);
    }

    public void DrawHuanJingMain(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        int pad = 16;
        // ===== 顶部标题行:层数 + 击杀进度条 + 地图名,同一基线 =====
        int ty = y + 10;
        Text.DrawShadow(rd, "幻境 第 " + this.g.p.hjFloor + " 层",
                        x + pad, ty, 2, 250, 215, 130, 255);
        // 地图名(右侧,与层数同基线)
        int mapIdx = 0;
        for (int i = 0; i < 20; i = i + 1) {
            if (Data.MAP_MIN_FLOOR[i] <= this.g.p.hjFloor) { mapIdx = i; }
        }
        string mapS = "当前地图:" + Data.MAP_NAMES[mapIdx];
        int mapW = Text.Width(rd, mapS, 2);
        Text.DrawShadow(rd, mapS, x + w - pad - mapW, ty + 4, 1, 200, 200, 220, 255);
        ty = ty + 26;
        // 击杀进度条(整行宽,替代散乱数字)
        LegendApp.BarImg(rd, x + pad, ty, w - pad * 2, 14,
                         this.g.p.hjKills, this.g.p.hjTarget);
        string prog = "击杀进度 " + this.g.p.hjKills + " / " + this.g.p.hjTarget
                      + "   (最高 " + this.g.p.hjBest + " 层)";
        Text.DrawCentered(rd, prog, x + w / 2, ty + 16, 1, 220, 215, 180, 255);
        // ===== 右上按钮列:自动重置 / 挑战 / 扫荡 / 说明,统一 96×30 =====
        int bw = 96;
        int bh = 30;
        int bx = x + w - pad - bw;
        int byb = y + 52;
        bool ar = this.g.autoReset;
        if (this.BtnTex(bx, byb, bw, bh,
                      ar ? "自动重置:开" : "自动重置:关", 1, ar ? 1 : 0)) {
            if (this.mouseJustUp) { this.g.autoReset = !ar; this.snd.Tip(); }
        }
        byb = byb + 32;
        if (this.BtnTex(bx, byb, bw, bh,
                      "挑战幻境", 1, 1)) {
            if (this.mouseJustUp) {
                this.g.StepIdle(0.12);
                this.snd.Craft();
            }
        }
        byb = byb + 32;
        if (this.BtnTex(bx, byb, bw, bh,
                      "扫荡幻境", 1, 2)) {
            if (this.mouseJustUp) {
                if (this.g.p.vip >= 1) {
                    for (int i = 0; i < 5; i = i + 1) { this.g.StepIdle(0.12); }
                    this.g.AddChat("[幻境] 扫荡 5 次");
                } else {
                    this.g.AddChat("[系统] 扫荡为终身会员特权");
                }
            }
        }
        byb = byb + 32;
        if (this.BtnTex(bx, byb, bw, bh,
                      "说明", 1, 0)) {
            if (this.mouseJustUp) { this.modal = 15; this.modalSub = 1; }
        }
        // ===== 中央怪显示区(避开右上按钮列,水平居中) =====
        int mx = x + (w - bw - pad * 2) / 2;
        int my = y + 96;
        SdlTexture mt = null;
        if (this.g.curBossIdx >= 0 && this.texBossFull != null
            && this.g.curBossIdx < this.texBossFull.Length
            && this.texBossFull[this.g.curBossIdx] != null) {
            mt = this.texBossFull[this.g.curBossIdx];
        } else if (this.g.curMobIdx >= 0 && this.texMob != null
                   && this.g.curMobIdx < Data.MON_COUNT) {
            int pic = Data.MON_PIC[this.g.curMobIdx];
            if (pic >= 0 && pic < this.texMob.Length && this.texMob[pic] != null) {
                mt = this.texMob[pic];
            }
        }
        if (mt == null) { mt = this.g.curIsBoss ? this.texMobBoss : this.texMobNormal; }
        if (mt != null && mt.IsValid()) {
            rd.DrawTexture(mt, mx - 100, my, 200, 200);
        } else {
            Draw.RoundRectFill(rd, mx - 60, my + 40, 120, 120, 12, 70, 60, 50, 220);
        }
        // 怪名 + 等级(怪上方,居中)
        Text.DrawCentered(rd, this.g.curMonsterName + "  Lv." + this.g.curMonsterLvl,
                          mx, my - 24, 1, 240, 220, 180, 255);
        // BOSS 标记
        if (this.g.curIsBoss) {
            Text.DrawCentered(rd, "★ 本关 BOSS ★", mx, my - 46, 3, 255, 120, 90, 255);
        }
        // HP 条(怪下方,整列宽对齐)
        LegendApp.BarImg(rd, mx - 100, my + 206, 200, 14,
                         this.g.curMonsterHp, this.g.curMonsterHpMax);
        Text.DrawCentered(rd, this.g.FormatNum(this.g.curMonsterHp) + " / "
                          + this.g.FormatNum(this.g.curMonsterHpMax),
                          mx, my + 224, 2, 220, 215, 180, 255);
        // ===== 掉落墙(底部,12 格对齐) =====
        int dwY = y + h - 108;
        Text.DrawShadow(rd, "掉落墙", x + pad, dwY - 20, 1, 220, 215, 180, 255);
        for (int i = 0; i < 12; i = i + 1) {
            int dx = x + pad + i * 50;
            int seedIdx = (int)((this.g.p.hjKillAcc + i * 7) % 40);
            SdlTexture it = this.texEquip[seedIdx];
            if (it != null && it.IsValid()) {
                rd.DrawTexture(it, dx, dwY, 40, 40);
            } else {
                Draw.RoundRectFill(rd, dx, dwY, 40, 40, 4, 50, 50, 60, 200);
            }
            int coef = 1 + (i + this.g.p.hjFloor) % 9;
            Text.DrawCentered(rd, "+" + coef, dx + 20, dwY + 42, 1, 230, 220, 160, 255);
        }
        // ===== 战斗统计(左下角,PRD §14) =====
        int sy = y + h - 24;
        Text.DrawShadow(rd, "击杀:" + this.g.p.totalKills + "  BOSS:"
                        + this.g.p.bossKilled + "  累计伤害:"
                        + this.g.FormatNum(this.g.totalDamageDealt),
                        x + pad, sy, 2, 180, 180, 200, 255);
    }

    public void DrawChatPanel(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        LegendApp.PanelImg(rd, x, y, w, h);
        Text.DrawShadow(rd, "聊天 / 广播", x + 12, y + 8, 2, 230, 200, 130, 255);
        // tab:世界 / 行会(真实频道过滤)
        int ty = y + 34;
        if (this.BtnTex(x + 12, ty, 64, 26, "世界", 1, this.chatChannel == 0 ? 2 : 0)) {
            if (this.mouseJustUp) { this.chatChannel = 0; this.snd.Tip(); }
        }
        if (this.BtnTex(x + 84, ty, 64, 26, "行会", 1, this.chatChannel == 1 ? 2 : 0)) {
            if (this.mouseJustUp) { this.chatChannel = 1; this.snd.Tip(); }
        }
        ty = ty + 34;
        // log(scale-2 字形高约 19px,行距 24 才不重叠)
        int maxLines = (h - 92) / 15;
        int start = this.g.p.chatCnt - maxLines;
        if (start < 0) { start = 0; }
        for (int i = start; i < this.g.p.chatCnt; i = i + 1) {
            string m = this.g.p.chatLog[i];
            if (m == null) { continue; }
            bool isGuild = m.IndexOf("[帮会]") >= 0 || m.IndexOf("[沙巴克]") >= 0;
            if (this.chatChannel == 1 && !isGuild) { continue; }
            int cr = 200; int cg = 200; int cb = 210;
            if (m.IndexOf("[广播]") >= 0) { cr = 250; cg = 215; cb = 130; }
            else if (m.IndexOf("[系统]") >= 0) { cr = 240; cg = 180; cb = 90; }
            else if (m.IndexOf("[掉落]") >= 0 || m.IndexOf("[离线]") >= 0) {
                cr = 180; cg = 240; cb = 200;
            }
            else if (m.IndexOf("[我]") >= 0) { cr = 140; cg = 220; cb = 250; }
            Text.DrawShadow(rd, m, x + 12, ty, 1, cr, cg, cb, 255);
            ty = ty + 15;
        }
        // 快捷发言(单机无键盘输入,以影子世界频道的口吻发出真实消息)
        // 三个均分整行宽;原固定 118 间距在 320 宽面板下会溢出并与发言按钮相叠
        int iy = y + h - 34;
        string[] quick = new string[3];
        quick[0] = "666"; quick[1] = "带带我"; quick[2] = "同去!";
        int cw = (w - 24 - 16) / 3;
        for (int qi = 0; qi < 3; qi = qi + 1) {
            if (this.BtnTex(x + 12 + qi * (cw + 8), iy, cw, 24, quick[qi], 1, 0)) {
                if (this.mouseJustUp) { this.g.SayWorld(quick[qi]); this.snd.Tip(); }
            }
        }
    }

    // ---------------------------------------------------------------
    // 模态分发
    // ---------------------------------------------------------------
    // 选项卡式面板:按设计,导航打开的不是全屏弹窗,而是中央区域
    // (左角色面板与右聊天之间)的整体切换——背景不暗化,其余区域照常。
    public void DrawModal() {
        int w = LegendApp.W();
        int h = LegendApp.H();
        SdlRenderer rd = this.r;
        // 中央区域矩形(与 DrawMainArea 的三分栏一致)
        int mx = 240;
        int my = LegendApp.MainTop();
        int mw = w - 240 - 320;
        int mh = LegendApp.MainBottom() - my;
        if (this.modal == 0) { /* 幻境已在主区 */ this.modal = -1; return; }
        // 面板底
        LegendApp.PanelImg(rd, mx, my, mw, mh);
        // 正文裁剪在中央区内:行数写多的面板不再把文字画出面板外
        LegendApp.ModBegin(rd, mx + 6, my + 6, mw - 12, mh - 12);
        // 分发
        if (this.modal == 1) { this.DrawBossHome(mx, my, mw, mh); }
        else if (this.modal == 2) { this.DrawForge(mx, my, mw, mh); }
        else if (this.modal == 3) { this.DrawRecycle(mx, my, mw, mh); }
        else if (this.modal == 4) { this.DrawXunBao(mx, my, mw, mh); }
        else if (this.modal == 5) { this.DrawAltar(mx, my, mw, mh); }
        else if (this.modal == 6) { this.DrawTitle(mx, my, mw, mh); }
        else if (this.modal == 7) { this.DrawNoble(mx, my, mw, mh); }
        else if (this.modal == 8) { this.DrawWuxing(mx, my, mw, mh); }
        else if (this.modal == 9) { this.DrawCardAlbum(mx, my, mw, mh); }
        else if (this.modal == 10) { this.DrawAchievement(mx, my, mw, mh); }
        else if (this.modal == 11) { this.DrawRanking(mx, my, mw, mh); }
        else if (this.modal == 12) { this.DrawShop(mx, my, mw, mh); }
        else if (this.modal == 13) { this.DrawMail(mx, my, mw, mh); }
        else if (this.modal == 14) { this.DrawSettings(mx, my, mw, mh); }
        else if (this.modal == 15) { this.DrawHelp(mx, my, mw, mh); }
        else if (this.modal == 16) { this.DrawBag(mx, my, mw, mh); }
        else if (this.modal == 17) { this.DrawAlbum(mx, my, mw, mh); }
        else if (this.modal == 18) { this.DrawDianTang(mx, my, mw, mh); }
        else if (this.modal == 19) { this.DrawWorldBoss(mx, my, mw, mh); }
        else if (this.modal == 20) { this.DrawPK(mx, my, mw, mh); }
        else if (this.modal == 21) { this.DrawYabiao(mx, my, mw, mh); }
        else if (this.modal == 22) { this.DrawCity(mx, my, mw, mh); }
        else if (this.modal == 23) { this.DrawTower(mx, my, mw, mh); }
        else if (this.modal == 24) { this.DrawMaster(mx, my, mw, mh); }
        else if (this.modal == 25) { this.DrawGuild(mx, my, mw, mh); }
        else if (this.modal == 26) { this.DrawShabake(mx, my, mw, mh); }
        else if (this.modal == 27) { this.DrawMap(mx, my, mw, mh); }
        else if (this.modal == 28) { this.DrawMijing(mx, my, mw, mh); }
        else if (this.modal == 29) { this.DrawRedBag(mx, my, mw, mh); }
        else if (this.modal == 30) { this.DrawMarket(mx, my, mw, mh); }
        else if (this.modal == 32) { this.DrawSkill(mx, my, mw, mh); }
        else if (this.modal == 40) { this.DrawCharge(mx, my, mw, mh); }
        else { this.modal = -1; LegendApp.ModEnd(rd); return; }
        LegendApp.ModEnd(rd);
        // 关闭按钮(面板右上,30x30 大热区)
        int cx = mx + mw - 40;
        int cy = my + 8;
        if (Draw.PointIn(this.mouseX, this.mouseY, cx, cy, 30, 30)) {
            Draw.RoundRectFill(rd, cx - 2, cy - 2, 34, 34, 6, 200, 80, 80, 220);
            if (this.mouseJustUp) { this.modal = -1; this.snd.Tip(); }
        }
        Text.DrawCentered(rd, "X", cx + 15, cy + 5, 2, 255, 255, 255, 255);
        // 选项卡标题
        Text.DrawShadow(rd, this.ModalTitle(), mx + 16, my + 12, 3, 250, 215, 130, 255);
    }

