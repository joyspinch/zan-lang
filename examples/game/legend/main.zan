    public void DrawCardAlbum(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w, "将星图谱 — 8 卡池 × 12 卡 × 10 转");
        int gy = y + 76;
        // 卡池选择
        for (int i = 0; i < 8; i = i + 1) {
            int bx = x + 16 + i * 100;
            int kind = this.cardPool == i ? 2 : 0;
            if (Ui.Button(rd, this.mouseX, this.mouseY, bx, gy, 92, 24,
                          Data.CARD_POOL_NAMES[i], 1, kind)) {
                if (this.mouseJustUp) { this.cardPool = i; }
            }
        }
        gy = gy + 32;
        // 12 卡 × 10 转(简化为 12 卡 1 行,激活费用按 tier 显示)
        for (int i = 0; i < 12; i = i + 1) {
            int bx = x + 16 + i * 84;
            int by = gy;
            int tier = 0; // 默认显示 0 转
            int idx = this.cardPool * 120 + i * 10 + tier;
            int word = idx / 32;
            int bit = idx % 32;
            bool on = (word < this.g.p.cardMaskLen
                       && (this.g.p.cardMask[word] & (1 << bit)) != 0);
            int kind = on ? 2 : 0;
            if (Ui.Button(rd, this.mouseX, this.mouseY, bx, by, 76, 24,
                          "卡 " + (i + 1), 1, kind)) {
                if (this.mouseJustUp) { this.g.ActivateCard(this.cardPool, i, tier); this.snd.Trade(); }
            }
            Text.DrawCentered(rd, "+0转", bx + 38, by + 26, 1, 180, 180, 200, 255);
        }
        gy = gy + 36;
        // tier 选择
        for (int t = 0; t < 10; t = t + 1) {
            int bx = x + 16 + t * 84;
            long cost = (long)(Data.CARD_ACTIVATE_BASE * Math.Pow(2, t));
            if (Ui.Button(rd, this.mouseX, this.mouseY, bx, gy, 76, 24,
                          t + "转", 1, 0)) {
                if (this.mouseJustUp) { /* 切换 tier 提示 */ }
            }
            Text.DrawCentered(rd, this.g.FormatCur(cost), bx + 38, gy + 26, 1, 200, 200, 220, 255);
        }
    }

    public void DrawAchievement(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w, "成就 — 48 条 (6 类 × 8 条)");
        int gy = y + 76;
        for (int c = 0; c < 6; c = c + 1) {
            int bx = x + 16 + c * ((w - 32) / 6);
            int bw = (w - 32) / 6 - 4;
            Text.DrawShadow(rd, Data.ACHV_CAT_NAMES[c], bx, gy, 1, 230, 200, 130, 255);
            for (int i = 0; i < 8; i = i + 1) {
                int by = gy + 20 + i * 36;
                if (this.texPanel != null && this.texPanel.IsValid()) {
                    LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, bx, by, bw, 30);
                } else {
                    Draw.RoundRectFill(rd, bx, by, bw, 30, 4, 38, 30, 22, 220);
                }
                int lvReq = (c + 1) * 5 + i * 8;
                Text.DrawShadow(rd, "Lv." + lvReq, bx + 6, by + 8, 1, 220, 215, 180, 255);
                Text.DrawShadow(rd, "奖励:" + (lvReq * 1000) + " 金",
                                bx + 6, by + 18, 1, 200, 200, 220, 255);
            }
        }
    }

    public void DrawRanking(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w, "排行榜 — 影子天梯(10 人)");
        // 子榜
        string[] rk = new string[7];
        rk[0] = "等级榜"; rk[1] = "攻击榜"; rk[2] = "幻境榜";
        rk[3] = "PK 榜"; rk[4] = "世界 BOSS 榜";
        rk[5] = "钱庄榜"; rk[6] = "祭坛榜";
        for (int i = 0; i < 7; i = i + 1) {
            int bx = x + 16 + i * 110;
            int kind = this.rankKind == i ? 2 : 0;
            if (Ui.Button(rd, this.mouseX, this.mouseY, bx, y + 56, 100, 24,
                          rk[i], 1, kind)) {
                if (this.mouseJustUp) { this.rankKind = i; }
            }
        }
        // 10 影子玩家
        int gy = y + 100;
        for (int i = 0; i < 10; i = i + 1) {
            int by = gy + i * 38;
            int bx = x + 16;
            int bw = w - 32;
            if (this.texPanel != null && this.texPanel.IsValid()) {
                LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, bx, by, bw, 32);
            } else {
                Draw.RoundRectFill(rd, bx, by, bw, 32, 4, 30, 34, 48, 220);
            }
            Text.DrawShadow(rd, (i + 1) + ".", bx + 8, by + 10, 2,
                            i < 3 ? 250 : 220, i < 3 ? 215 : 210, i < 3 ? 130 : 180, 255);
            Text.DrawShadow(rd, this.g.ShadowName() + "_" + (i + 1), bx + 50, by + 10, 1,
                            240, 220, 180, 255);
            // 数值
            string val = "";
            if (this.rankKind == 0) { val = "Lv." + (this.g.p.lv + (10 - i) * 3); }
            else if (this.rankKind == 1) { val = (this.g.TotalAcMin() + (10 - i) * 200) + "-" + (this.g.TotalAcMax() + (10 - i) * 300); }
            else if (this.rankKind == 2) { val = "第 " + (this.g.p.hjBest + (10 - i)) + " 层"; }
            else if (this.rankKind == 3) { val = this.g.FormatNum(500 + (10 - i) * 100) + " 战功"; }
            else if (this.rankKind == 4) { val = this.g.FormatNum(1000000 - i * 100000) + " 伤害"; }
            else if (this.rankKind == 5) { val = "钱庄 " + ((i + 1) % 8 + 1); }
            else { val = "捐献 " + this.g.FormatNum(10000 + i * 1000); }
            Text.DrawShadow(rd, val, bx + bw - 200, by + 10, 1, 230, 200, 130, 255);
        }
    }

    public void DrawShop(int x, int y, int w, int h) {
