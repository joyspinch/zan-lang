// 传奇放置挂机 — SDL3 主机 + UI + 全部面板。
// 运行:  build/zanc.exe examples/game/legend/main.zan \
//                examples/game/legend/Game.zan \
//                examples/game/legend/Data.zan \
//                examples/game/common/GameKit.zan \
//                --auto-stdlib -o build/legend.exe
// 自测:  LEGEND_SIM=1 build/legend.exe  → 无头 60s 离线结算+推层模拟
using System;
using System.IO;
using SDL3;
using GameKit;
using Legend;

class Snd {
    public SdlAudioClip up;
    public SdlAudioClip box;
    public SdlAudioClip tip;
    public SdlAudioClip trade;
    public SdlAudioClip craft;
    public bool ready;
    public bool on;

    public static Snd Create(bool on) {
        Snd s = new Snd();
        s.on = on;
        if (!SdlAudio.Open()) { return s; }
        s.up = LegendApp.LoadWav2("examples/game/legend/assets/up.wav");
        s.box = LegendApp.LoadWav2("examples/game/legend/assets/box.wav");
        s.tip = LegendApp.LoadWav2("examples/game/legend/assets/tip.wav");
        s.trade = LegendApp.LoadWav2("examples/game/legend/assets/trade.wav");
        s.craft = LegendApp.LoadWav2("examples/game/legend/assets/craft.wav");
        s.ready = s.up.IsValid() || s.tip.IsValid();
        return s;
    }
    public void Play(SdlAudioClip c, double gain) {
        if (!this.on || c == null || !c.IsValid()) { return; }
        c.Play(gain, 0);
    }
    public void Up() { this.Play(this.up, 0.7); }
    public void Craft() { this.Play(this.craft, 0.6); }
    public void Box() { this.Play(this.box, 0.9); }
    public void Tip() { this.Play(this.tip, 0.4); }
    public void Trade() { this.Play(this.trade, 0.7); }
}

