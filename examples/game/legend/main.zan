                          "购买", 1, 1)) {
                if (this.mouseJustUp) { this.g.ShopBuy(i); this.snd.Trade(); }
            }
        }
    }

    public void DrawMail(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w, "邮箱 — 附件 " + this.g.p.mailCnt + "/8");
        int gy = y + 76;
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 16, gy, 120, 28,
                      "一键领取", 1, 1)) {
            if (this.mouseJustUp) {
                while (this.g.p.mailCnt > 0) { this.g.ClaimMail(0); }
                this.snd.Box();
            }
        }
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 144, gy, 120, 28,
                      "清空已领", 1, 0)) {
            if (this.mouseJustUp) {
                this.g.p.mailCnt = 0;
                this.snd.Tip();
            }
        }
        gy = gy + 40;
        for (int i = 0; i < 8; i = i + 1) {
            int by = gy + i * 50;
            int bx = x + 16;
            int bw = w - 32;
            if (this.texPanel != null && this.texPanel.IsValid()) {
                LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, bx, by, bw, 44);
            } else {
                Ui.Panel(rd, bx, by, bw, 44, 30, 34, 48, 220);
            }
            if (i < this.g.p.mailCnt) {
                Text.DrawShadow(rd, this.g.p.mailTitle[i], bx + 8, by + 6, 1, 240, 220, 180, 255);
                if (Ui.Button(rd, this.mouseX, this.mouseY, bx + bw - 80, by + 8, 70, 28,
                              "领取", 1, 1)) {
                    if (this.mouseJustUp) { this.g.ClaimMail(i); this.snd.Box(); }
                }
            } else {
                Text.DrawShadow(rd, "(空)", bx + 8, by + 14, 1, 100, 100, 120, 255);
            }
        }
    }

    public void DrawSettings(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w, "设置");
        int gy = y + 76;
        // 老板键
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 16, gy, 220, 32,
                      "老板键 F10 (当前:" + (this.g.bossMode ? "开" : "关") + ")",
                      1, this.g.bossMode ? 2 : 0)) {
            if (this.mouseJustUp) { this.g.ToggleBossKey(); this.snd.Tip(); }
        }
        gy = gy + 40;
        // 界面缩放
        Text.DrawShadow(rd, "界面缩放:" + (int)(this.g.p.uiScale * 100) + "%",
                        x + 16, gy, 1, 220, 215, 180, 255);
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 220, gy, 60, 28, "-", 1, 0)) {
            if (this.mouseJustUp) { this.g.SetUiScale(this.g.p.uiScale - 0.1); }
        }
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 290, gy, 60, 28, "+", 1, 0)) {
            if (this.mouseJustUp) { this.g.SetUiScale(this.g.p.uiScale + 0.1); }
        }
        gy = gy + 40;
        // 自动换装
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 16, gy, 220, 32,
                      "自动换装 (当前:" + (this.g.autoEquip ? "开" : "关") + ")",
                      1, this.g.autoEquip ? 2 : 0)) {
            if (this.mouseJustUp) { this.g.autoEquip = !this.g.autoEquip; this.snd.Tip(); }
        }
        gy = gy + 40;
        // 静默模式
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 16, gy, 220, 32,
                      "静默战斗 (当前:" + (this.g.p.silent ? "开" : "关") + ")",
                      1, this.g.p.silent ? 2 : 0)) {
            if (this.mouseJustUp) { this.g.ToggleSilent(); this.snd.Tip(); }
        }
        gy = gy + 40;
        // 装备过滤
        Text.DrawShadow(rd, "装备过滤:只保留 ≥+" + this.g.p.filterMinCoef,
                        x + 16, gy, 1, 220, 215, 180, 255);
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 220, gy, 60, 28, "-", 1, 0)) {
            if (this.mouseJustUp) {
                this.g.p.filterMinCoef = this.g.p.filterMinCoef - 1;
                if (this.g.p.filterMinCoef < 0) { this.g.p.filterMinCoef = 0; }
            }
        }
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 290, gy, 60, 28, "+", 1, 0)) {
            if (this.mouseJustUp) { this.g.p.filterMinCoef = this.g.p.filterMinCoef + 1; }
        }
        gy = gy + 40;
        // 转永久区
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 16, gy, 220, 32,
                      "转永久区", 1, 1)) {
            if (this.mouseJustUp) {
                this.g.AddChat("[系统] 已转入永久区(单机版模拟)");
            }
        }
        gy = gy + 40;
        // 改名
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 16, gy, 220, 32,
                      "改名(消耗改名卡)", 1, 1)) {
            if (this.mouseJustUp) {
                this.g.p.name = "玩家" + (Game.NowMs() % 1000);
                this.g.AddChat("[系统] 改名成功");
            }
        }
        gy = gy + 40;
        // 保存
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 16, gy, 220, 32,
                      "保存存档", 1, 1)) {
            if (this.mouseJustUp) { this.g.Save(); this.g.AddChat("[系统] 存档已保存"); }
        }
    }

    public void DrawHelp(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w, "帮助 — 数值公式全公开");
        int gy = y + 76;
        string[] lines = new string[20];
        lines[0] = "★ 经验曲线:EXP = 80 * LV ^ 1.45";
        lines[1] = "★ 攻击区间:基础 + 装备,浮动 ±18%";
        lines[2] = "★ 幻境层 HP:30 * 1.18^(N-1)";
        lines[3] = "★ 层 BOSS:每 10 层 1 只,HP × 6";
        lines[4] = "★ 装备品阶:普通/高级/稀有/史诗/传说";
        lines[5] = "★ 系数公式:效果 = 基础 * (1 + 系数*0.18)";
        lines[6] = "★ 洗炼概率:金币 35% 概率降低,元宝 100% 提升";
        lines[7] = "★ 转生:等级 80 + 累计击破 BOSS";
        lines[8] = "★ 爵位:累计元宝捐献,全属性 +X%";
        lines[9] = "★ 五行:离线时间池,1h 修为 = 0.2% 加成";
        lines[10] = "★ 寻宝奖池:每 0 点刷新,12 奖项";
        lines[11] = "★ 祭坛:个人 1000 进度 + 全服 8000 进度";
        lines[12] = "★ PK 竞技场:影子天梯,胜+100/负+20";
        lines[13] = "★ 押镖/劫镖:每日 5+5 次,50% 被劫";
        lines[14] = "★ 钱庄:8 城,5% 概率被夺";
        lines[15] = "★ 传说塔:5 层,镜像挑战";
        lines[16] = "★ 师徒:师父 2 转,拜师 ≤60 级";
        lines[17] = "★ 帮会:500 万金币 + 沃玛号角创建";
        lines[18] = "★ 离线结算:24h 上限(终身 48h/超会 72h)";
        lines[19] = "★ 帮助菜单:进阶玩法 / 公式算法 / 交易权限";
        for (int i = 0; i < 20; i = i + 1) {
            Text.DrawShadow(rd, lines[i], x + 16, gy + i * 20, 1, 220, 215, 180, 255);
        }
    }

    public void DrawBag(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w, "背包 — " + this.g.p.bagCnt + "/60");
        // 12 列(适配宽度)
        int cols = 12;
        int gx = x + 16;
        int gy = y + 76;
        int cell = (int)Math.Min(48.0, (double)((w - 32) / cols));
        for (int i = 0; i < this.g.p.bagCnt && i < 60; i = i + 1) {
            int c = i % cols;
            int r = i / cols;
            int bx = gx + c * (cell + 4);
            int by = gy + r * (cell + 18);
            Item it = this.g.p.bag[i];
            if (it == null) { continue; }
            SdlTexture tex = this.texEquip[it.cls * 5 + it.tier];
            bool hov = Draw.PointIn(this.mouseX, this.mouseY, bx, by, cell, cell);
            if (this.texPanel != null && this.texPanel.IsValid()) {
                LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, bx - 2, by - 2, cell + 4, cell + 4);
            } else {
                Draw.RoundRectFill(rd, bx, by, cell, cell, 4, 38, 42, 56, 220);
            }
            if (tex != null && tex.IsValid()) {
                rd.DrawTexture(tex, bx, by, cell, cell);
            }
            Text.DrawCentered(rd, "+" + it.coef, bx + cell / 2, by + cell + 4, 1, 230, 200, 130, 255);
            if (hov && this.mouseJustUp) { this.bagSel = i; this.snd.Tip(); }
        }
        // 选中详情
        if (this.bagSel >= 0 && this.bagSel < this.g.p.bagCnt) {
            Item it = this.g.p.bag[this.bagSel];
            int dx = x + w - 280;
            int dy = y + 76;
            Text.DrawShadow(rd, it.Name(), dx, dy, 2, 240, 220, 180, 255);
            dy = dy + 26;
            Text.DrawShadow(rd, "品阶:" + Data.EQUIP_TIER_NAMES[it.tier], dx, dy, 1, 220, 210, 180, 255);
            dy = dy + 16;
            Text.DrawShadow(rd, "系数:" + it.coef + "/" + Data.TIER_COEF_CAP[it.tier], dx, dy, 1, 220, 210, 180, 255);
            dy = dy + 16;
            Text.DrawShadow(rd, "槽位:" + Data.SLOT_NAMES[it.slot], dx, dy, 1, 220, 210, 180, 255);
            dy = dy + 24;
            if (Ui.Button(rd, this.mouseX, this.mouseY, dx, dy, 240, 30,
                          "装备", 2, 1)) {
                if (this.mouseJustUp) { this.g.EquipFromBag(this.bagSel); this.snd.Up(); }
            }
            dy = dy + 36;
            if (Ui.Button(rd, this.mouseX, this.mouseY, dx, dy, 240, 30,
                          "回收", 2, 0)) {
                if (this.mouseJustUp) {
                    this.g.Recycle(this.bagSel, Data.CUR_GOLD);
                    this.snd.Trade();
                }
            }
        }
        // 一键操作:换装 / 回收
        int actY = y + h - 178;
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 16, actY, 150, 30,
                      "一键换装", 2, 1)) {
            if (this.mouseJustUp) {
                int n = this.g.AutoEquipBest();
                if (n == 0) { this.g.AddChat("[换装] 背包里没有更强的装备"); }
                this.snd.Up();
            }
        }
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 176, actY, 150, 30,
                      "一键回收(金币)", 2, 0)) {
            if (this.mouseJustUp) {
                long got = this.g.RecycleAll(Data.CUR_GOLD);
                this.g.AddChat("[回收] 清空背包,共获得 " + this.g.FormatNum(got) + " 金币");
                this.bagSel = -1;
                this.snd.Trade();
            }
        }
        // 当前已装备
        int eqY = y + h - 140;
        Text.DrawShadow(rd, "已装备 (12 槽)", x + 16, eqY, 2, 230, 200, 130, 255);
        for (int i = 0; i < Data.SLOT_COUNT; i = i + 1) {
            int bx = x + 16 + i * 84;
            int by = eqY + 24;
            Item it = this.g.p.equip[i];
            if (this.texPanel != null && this.texPanel.IsValid()) {
                LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, bx, by, 76, 76);
            } else {
                Draw.RoundRectFill(rd, bx, by, 76, 76, 4, 36, 30, 22, 220);
            }
            if (it != null) {
                SdlTexture tex = this.texEquip[it.cls * 5 + it.tier];
                if (tex != null && tex.IsValid()) {
                    rd.DrawTexture(tex, bx + 4, by + 4, 68, 68);
                }
                Text.DrawCentered(rd, "+" + it.coef, bx + 38, by + 56, 1, 230, 200, 130, 255);
            }
            Text.DrawCentered(rd, Data.SLOT_NAMES[i], bx + 38, by + 76, 1, 220, 210, 180, 255);
        }
    }

    public void DrawAlbum(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w, "神兵图鉴 — 9 组 × 10 槽");
        // 9 组选择
        for (int i = 0; i < 9; i = i + 1) {
            int bx = x + 16 + i * 100;
            int kind = this.albumGroup == i ? 2 : 0;
            if (Ui.Button(rd, this.mouseX, this.mouseY, bx, y + 56, 92, 24,
                          Data.ALBUM_NAMES[i], 1, kind)) {
                if (this.mouseJustUp) { this.albumGroup = i; }
            }
        }
        int gy = y + 100;
        for (int i = 0; i < Data.ALBUM_SLOTS; i = i + 1) {
            int bx = x + 16 + i * 92;
            int by = gy;
            if (this.texPanel != null && this.texPanel.IsValid()) {
                LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, bx, by, 84, 84);
            } else {
                Draw.RoundRectFill(rd, bx, by, 84, 84, 6, 38, 30, 22, 220);
            }
            // 占位(未实现收集态,显示空槽)
            Draw.RoundRectFill(rd, bx + 8, by + 8, 68, 68, 4, 24, 26, 36, 220);
            Text.DrawCentered(rd, "空槽", bx + 42, by + 38, 1, 100, 100, 120, 255);
        }
        Text.DrawCentered(rd, "(放入后无法取出,木桶原理)", x + w / 2, gy + 110, 2, 220, 200, 130, 255);
    }

    public void DrawDianTang(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w,
            "至尊极品殿堂 — 登记 +" + (this.g.p.dtCount * 5) + "% 经验(上限 50%)");
        int gy = y + 76;
        for (int i = 0; i < 5; i = i + 1) {
            int bx = x + 16 + i * 200;
            int by = gy;
            int bw = 190;
            int bh = 100;
            if (this.texPanel != null && this.texPanel.IsValid()) {
                LegendApp.NineImg(rd, this.texPanel, 960, 960, 101, 16, bx, by, bw, bh);
            } else {
                Ui.Panel(rd, bx, by, bw, bh, 38, 30, 22, 220);
            }
            Text.DrawShadow(rd, Data.DIAN_TANG_NAMES[i], bx + 10, by + 8, 1, 240, 220, 180, 255);
            Item dt = this.g.p.dtBest[i];
            if (dt != null) {
                SdlTexture tex = this.texEquip[dt.cls * 5 + dt.tier];
                if (tex != null && tex.IsValid()) {
                    rd.DrawTexture(tex, bx + 10, by + 30, 48, 48);
                }
                Text.DrawShadow(rd, dt.Name(), bx + 64, by + 36, 1, 230, 215, 180, 255);
                Text.DrawShadow(rd, "主人:玩家_" + (i + 1), bx + 64, by + 52, 1, 200, 200, 220, 255);
                Text.DrawShadow(rd, "复制:" + Data.DIAN_TANG_COST_LF[i] + " 灵符", bx + 64, by + 68, 1, 230, 200, 130, 255);
            } else {
                Text.DrawShadow(rd, "(空)", bx + 64, by + 36, 1, 100, 100, 120, 255);
            }
        }
    }

    public void DrawWorldBoss(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
        this.DrawPanelHeader(x, y, w, "世界 BOSS — 影子共斗  HP:" +
                              this.g.FormatNum((long)Data.WORLD_BOSS_HP));
        int my = y + 76;
        // BOSS 立绘
        if (this.texBoss != null && this.texBoss[3] != null && this.texBoss[3].IsValid()) {
            rd.DrawTexture(this.texBoss[3], x + 16, my, 200, 200);
        }
        // 进度
        long dmg = this.g.p.wbDamage;
        long total = (long)Data.WORLD_BOSS_HP;
        double pct = (double)dmg / total;
        if (pct > 1) { pct = 1; }
        LegendApp.BarImg(rd, x + 240, my, w - 280, 18, dmg, total);
        Text.DrawShadow(rd, "已伤害:" + this.g.FormatNum(dmg) + " / " + this.g.FormatNum(total),
                        x + 240, my + 22, 1, 220, 215, 180, 255);
        // 操作
        if (Ui.Button(rd, this.mouseX, this.mouseY, x + 240, my + 50, 160, 32,
                      "挑战(剩余 " + this.g.p.wbTriesLeft + ")", 2, 1)) {
            if (this.mouseJustUp) { this.g.HitWorldBoss(); this.snd.Craft(); }
        }
        // 影子榜
        int sy = my + 100;
        for (int i = 0; i < 10; i = i + 1) {
            int sx = x + 240;
            int sw = w - 280;
            int sy2 = sy + i * 24;
            string rankDmg = this.g.FormatNum(1000000000L - i * 100000000L);
            Text.DrawShadow(rd, (i + 1) + ". " + this.g.ShadowName() + "_" + (i + 1) + "  伤害:" + rankDmg,
                            sx, sy2, 1, 220, 215, 180, 255);
        }
    }

    public void DrawPK(int x, int y, int w, int h) {
        SdlRenderer rd = this.r;
