using System;
using SDL3;

/// SDL_GPU 精灵批次示例。着色器有 SPIR-V / DXBC / MSL 三个变体，
/// SdlGpu 会按后端自动挑一个，所以 Vulkan(Linux/Windows)、
/// D3D12(Windows)、Metal(macOS) 上都能跑。
///
/// 这里用离屏上下文：渲染到内存目标再把像素读回来校验，
/// 因此无显示环境也能验证 GPU 路径确实通了。
class Program {
    static int Width() { return 64; }
    static int Height() { return 64; }

    /// 把 0xRRGGBBAA 拆成四个通道打印，便于和期望值对照。
    static string Channels(int rgba) {
        string s = "";
        for (int shift = 24; shift >= 0; shift = shift - 8) {
            s = s + ((rgba >> shift) & 255).ToString() + " ";
        }
        return s;
    }

    static void Main() {
        if (!Sdl.Init(SdlInit.Video())) {
            Console.WriteLine("SDL 初始化失败: " + Sdl.Error());
            return;
        }

        SdlGpu gpu = SdlGpu.CreateOffscreen(Program.Width(), Program.Height());
        if (!gpu.IsValid()) {
            Console.WriteLine("没有可用的 GPU 后端，回落到 2D renderer: "
                + Sdl.Error());
            Sdl.Quit();
            return;
        }
        Console.WriteLine("driver: " + gpu.DriverName());
        Console.WriteLine("shader: " + gpu.ShaderFormat());

        // 1x1 白色纹理，靠顶点色着色：精灵管线最基本的用法。
        SdlGpuTexture white = gpu.SolidTexture(1, 1);
        if (!white.IsValid()) {
            Console.WriteLine("建纹理失败: " + Sdl.Error());
            gpu.Destroy();
            Sdl.Quit();
            return;
        }

        gpu.Begin(0, 0, 0, 255);
        // 左上象限画不透明红色，右下象限画半透明绿色（走 alpha 混合）。
        gpu.Draw(white, 0, 0, 32, 32, 255, 0, 0, 255);
        gpu.Draw(white, 32, 32, 32, 32, 0, 255, 0, 128);
        gpu.End();

        Console.WriteLine("bg     " + Program.Channels(gpu.ReadPixel(48, 8)));
        Console.WriteLine("red    " + Program.Channels(gpu.ReadPixel(16, 16)));
        Console.WriteLine("green  " + Program.Channels(gpu.ReadPixel(48, 48)));

        white.Free();
        gpu.Destroy();
        Sdl.Quit();
    }
}
