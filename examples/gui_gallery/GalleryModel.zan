using System;
using System.Globalization;
using System.IO;
using System.Json;
using System.Threading;
using System.Net.Http;
using System.Net.Sockets;
using System.Security.Cryptography;
using System.Diagnostics;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;
using Gui.Component.Chart;
using Gui.Component.CodeEditor;
using Gui.Component.DataTable;
using Gui.Designer;
using Gui.Hmi;

public class GalleryModel {
    string inputText;
    string otpCode;  // InputOtp.form 的双向绑定目标
    bool toggle;
    bool toggleB;
    bool cbSmall;
    bool cbDefault;
    bool cbLarge;
    bool cbPrimary;
    bool cbSuccess;
    bool cbWarning;
    int level;
    // ---- Slider 演示族（Naive UI n-slider 对齐）的模型字段 ----------
    int sldLo;  // Slider.range 低值（双柄范围演示）
    int sldHi;  // Slider.range 高值
    int sldMark;  // Slider.marks / Slider.stepmark 共享当前值
    int sldFmt;  // Slider.tooltip 三态演示共享当前值
    // ---- InputNumber 演示族（Naive UI n-input-number 对齐）的模型字段 --
    int numBasic;  // 基础 / 按钮位置 / 尺寸三卡共享（双向同步）
    int numMin;  // 最小值&最大值演示：低界盒
    int numMax;  // 最小值&最大值演示：高界盒
    int numGroup;  // 千分位演示（1075 -> "1,075"）
    int numYen;  // 自定义解析演示（1079 -> "1,079 ¥"）
    int numPrec;  // 精度演示（定点：50@2 -> "0.50"）
    int numLoad;  // 加载状态演示的数值
    int numCheck;  // 自定义验证演示（min 10，越界红描边）
    bool numLoading;  // 加载卡上的开关：拨动即切 InputNumber.Loading
    int radioGroup2;
    // Radio 演示的三个独立分组：基础组 / 尺寸组 / 禁用组。各组绑定
    // 自己的字段，互不串扰（绑定同一个字段才是同一组）。
    int radioChoice;
    int radioSize;
    int radioLock;
    // 第五组：每个选项一个语义 class，选中谁就亮谁的强调色。
    int radioAccent;
    // Radio.bordered 演示的三组（基础 / 语义色 / 禁用）。
    int radioBorder;
    int radioBorder2;
    int radioBorder3;
    // RadioGroup.options / .buttons 演示：组级绑定字段与 LIVE STATES
    // 的上一帧值。
    int rgCity;
    string notes;
    int pick;
    int slide;
    // ---- 复杂表单演示的模型字段（.data 双向绑定直接写这里）----
    // Form.validate：注册表单。
    string suName;
    string suMail;
    string suPwd;
    string suPwd2;
    bool suAgree;
    // Form.dependencies：配送单。radio 选配送方式、switch 开发票/礼品包装。
    int orderShip;  // 0 快递配送 / 1 到店自提
    string orderAddr;
    bool orderGift;
    string orderGiftNote;
    bool orderInvoice;
    string orderInvoiceTitle;
    // Switch.master：总开关 + 两个子功能。
    bool masterOn;
    bool featA;
    bool featB;
    // Radio.dependent：渠道单选，「其他」的备注。
    int howhear;  // 0 广告 / 1 朋友推荐 / 2 其他
    string otherNote;
    // ---- 更丰富的 Switch / Radio 展示 --------------------------------
    // Switch.settings：三行设置的模型字段（行每帧重建，开关保留态）。
    bool setSync;
    bool setCompact;
    bool setPublic;
    // Switch.async：异步保存——「保存完成」那一刻才落值的影子字段。
    bool asyncOn;
    // Switch.dataValue：自定义选中值的 int 绑定轴（10 = 开、20 = 关）。
    int swVal;
    // Radio.cards：选中卡片下标（三张卡的单选钮共享绑定）。
    int radioPick;
    // ---- Rate 演示族（半星按 *2 编码；悬浮预览值由 HoverChange
    // 处理器写入，0 = 指针已离开）----
    int rateHalf;
    int rateClr;
    int rateSize;
    int rateHeart;
    int rateAccent;
    int rateRo;
    int rateHover;
    int rateHoverVal;
    // ---- QrCode 演示族：主卡内容/纠错级别/logo/尺寸，与导出卡的渲染类型。
    // 主卡属性帧帧从这些字段读回（同 Watermark 配置面板的思路：改字段
    // 即改外观，没有事件时序要操心）。----
    string qrText;  // 编码内容（与输入框双向绑定）
    string qrEcl;  // "L"/"M"/"Q"/"H"
    bool qrLogo;  // 叠加 logo（自动升 H）
    int qrPx;  // 主卡边长（逻辑 px）
    bool qrSvg;  // 导出卡渲染类型：false 画布 / true SVG
    // ---- Pagination 演示族：100 页大分页的当前页（窗口省略号、
    // 跳页输入框与每页条数下拉共享它）----
    int pagJump;
    // ---- Watermark.custom：自定义水印演示的配置面板字段 ----------
    // 面板控件经 .data 双向绑到这里；水印每帧按字段现造——旋钮改
    // 字段，下一帧水印直接长成新样子，没有事件时序要操心。
    string wmText;  // 水印内容（\n 分行）
    string wmColor;  // 颜色文本：0x/#/裸十六进制（AARRGGBB 或 RRGGBB），空 = 默认淡黑
    int wmFontPx;  // 字体大小（逻辑 px）
    int wmWeight;  // 字重：0 正常 / 1 加粗（下拉框下标）
    int wmRotate;  // 旋转角度（度，正 = 顺时针）
    int wmLineH;  // 行高（逻辑 px，0 = 默认行高）
    int wmTileW;  // 贴片宽（逻辑 px，0 = 按内容）
    int wmTileH;  // 贴片高（逻辑 px，0 = 按内容）
    int wmGapX;  // X 轴间隔（逻辑 px）
    int wmGapY;  // Y 轴间隔（逻辑 px）
    int wmOffX;  // X 轴偏移（逻辑 px）
    int wmOffY;  // Y 轴偏移（逻辑 px）
    int wmAlign;  // 文本对齐：0 左 / 1 中 / 2 右
    bool wmNoClip;  // 是否跨越边界（不被水印框裁剪）
    // ---- Steps 演示族：点击切换演示绑定的当前步（0..2）----------
    int stepClick;
    // ---- ColorPicker 演示族：打包色模型字段（0xAARRGGBB）--------
    int cpBase;  // 基础卡 / 无透明度卡共享（双向同步）
    int cpForm;  // 和表单一起使用卡（data 双向绑定）
}
