using Gui.Component.CodeEditor;
using Gui.Component.DataTable;
using Gui.Designer;
using Gui.Hmi;

public class GalleryItemRow {
    bool header;
    bool sel;
    string text;
    string desc;

    static GalleryItemRow Head(string text) {
        GalleryItemRow r = new GalleryItemRow();
        r.header = true;
        r.sel = false;
        r.text = text;
        r.desc = "";
        return r;
    }

    static GalleryItemRow Row(string text, string desc, bool sel) {
        GalleryItemRow r = new GalleryItemRow();
        r.header = false;
        r.sel = sel;
        r.text = text;
        r.desc = desc;
        return r;
    }

    // 行模板：视觉都在 ListItem 里，这里只做映射。
    static Control View(GalleryItemRow r) {
        if (r.header) { return ListItem.Header(r.text); }
        ListItem it = new ListItem(r.text, r.desc);
        it.Selected = r.sel;
        return it;
    }
}

