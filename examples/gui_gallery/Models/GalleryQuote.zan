public class GalleryQuote {
    public string name;
    public string price;
    public string change;

    public GalleryQuote(string name, string price, string change) {
        this.name = name != null ? name : "";
        this.price = price != null ? price : "";
        this.change = change != null ? change : "";
    }
}

