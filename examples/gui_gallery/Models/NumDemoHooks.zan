public class NumDemoHooks {
    // format：数值文本 -> 展示文本（后缀 ¥，配合千分位分组）。
    static string Yen(string s) { return s + " ¥"; }
    // parse：展示文本 -> 可解析串（剥掉 " ¥" 后缀；逗号由控件剥除）。
    static string StripYen(string s) { return s.Replace(" ¥", ""); }
    // validator：最小 10（Naive UI 自定义验证演示同款语义）。
    static bool AtLeast10(int v) { return v >= 10; }
}
