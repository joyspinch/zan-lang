public class GalleryOverlayItem {
    public string name;
    public int x;
    public int y;
    public int w;

    public GalleryOverlayItem(string name, int x, int y, int w) {
        this.name = name;
        this.x = x;
        this.y = y;
        this.w = w;
    }
}

