public class CodeDisplayLine {
    string text;
    int lineNo;
    List<CodeSpan> spans;

    CodeDisplayLine(string text, int lineNo, List<CodeSpan> spans) {
        this.text = text;
        this.lineNo = lineNo;
        this.spans = spans;
    }
}
