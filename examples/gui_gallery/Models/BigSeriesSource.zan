using Gui.Hmi;

public class BigSeriesSource : ChartSource {
    List<int> data;
    string sname;
    int scolor;
    int ring;  
    int off;  // ring offset, advanced by Roll()

    static BigSeriesSource Of(List<int> data, string name, int color, int ring) {
        BigSeriesSource s = new BigSeriesSource();
        s.data = data;
        s.sname = name;
        s.scolor = color;
        s.ring = ring;
        s.off = 0;
        return s;
    }

    override int SeriesCount() { return 1; }
    override string SeriesName(int s) { return this.sname; }
    override int SeriesColor(int s) { return this.scolor; }
    override int PointCount(int s) {
        if (this.ring > 0) { return this.ring; }
        return this.data.Count;
    }
    override int ValueAt(int s, int i) {
        int n = this.data.Count;
        if (n < 1) { return 0; }
        if (this.ring > 0) { return this.data[(i + this.off) % n]; }
        if (i < 0 || i >= n) { return 0; }
        return this.data[i];
    }

    void Roll() { this.off = this.off + 1; }
}

// 导航项视图实体：统一承载分组表头与组件条目。
// 单实体数据模型绑定，无需哨兵组件索引。
// Upload 演示卡的 mock 上传任务：CustomRequest 委托（静态方法组）
// 把它入队，后台线程模拟推进进度，经宿主 uiApp.Post 封送回 UI 线程
// 调 SetItemPercent/SetItemStatus（App.Post 是 Zan 侧调用，实例方法组
// 在那里是安全的——闭包 ABI 限制只在 Thread.Start 入口）。
