using System;
using System.Globalization;
using System.IO;
using System.Json;
using System.Threading;
using System.Net.Http;
using System.Net.Sockets;
using System.Security.Cryptography;
using System.Diagnostics;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;
using Gui.Component.Chart;
using Gui.Component.CodeEditor;
using Gui.Component.DataTable;
using Gui.Designer;
using Gui.Hmi;

public class GalleryNavRow {
    bool header;
    int compIndex;
    string text;

    static GalleryNavRow Header(string text) {
        GalleryNavRow row = new GalleryNavRow();
        row.header = true;
        row.compIndex = 0;
        row.text = text;
        return row;
    }

    static GalleryNavRow Component(int compIndex, string text) {
        GalleryNavRow row = new GalleryNavRow();
        row.header = false;
        row.compIndex = compIndex;
        row.text = text;
        return row;
    }
}

