using System;
using System.Globalization;
using System.IO;
using System.Json;
using System.Threading;
using System.Net.Http;
using System.Net.Sockets;
using System.Security.Cryptography;
using System.Diagnostics;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;
using Gui.Component.Chart;
using Gui.Component.CodeEditor;
using Gui.Component.DataTable;
using Gui.Designer;
using Gui.Hmi;

public class ScoreStyler : CellStyler {
    // 列索引由 Bind() 按列名动态绑定，避免硬编码。
    // 列重排自适应：按列标识而非绝对索引查询单元格数据。
    int scoreCol;
    int cityCol;

    // 主题色彩缓存：动态同步当前主题的前后景色。
    // 视觉渲染规则：根据数值段应用主题强调色与预警色阶。
    int rowTint;
    int goodFg;
    int badFg;

    // 每帧渲染前绑定关注列索引并更新主题色。
    void Bind(App app, List<DataColumn> cols) {
        scoreCol = DataTable.Col(cols, "score");
        cityCol = DataTable.Col(cols, "city");
        rowTint = DataTable.LerpColor(app.theme.bgPrimary, app.theme.error, 1, 6);
        goodFg = app.theme.success;
        badFg = app.theme.error;
    }

    override int RowBg(DataSource src, int row) {
        if (scoreCol < 0) { return 0; }
        if (DataTable.ParseInt(src.CellText(row, scoreCol)) < 80) { return rowTint; }
        return 0;
    }

    override int CellFg(DataSource src, int row, int col) {
        if (col != scoreCol || scoreCol < 0) { return 0; }
        int v = DataTable.ParseInt(src.CellText(row, scoreCol));
        if (v >= 90) { return goodFg; }
        if (v < 80) { return badFg; }
        return 0;
    }

    override bool PaintCell(App app, DataSource src, int row, int col,
                            int x, int y, int w, int h) {
        // 自定义列绘制钩子：自绘指示圆点与对齐文本。
        if (col != cityCol || cityCol < 0) { return false; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        string city = src.CellText(row, cityCol);
        int dot = t.textTertiary;
        if (city == "San Francisco") { dot = t.primary; }
        else if (city == "New York") { dot = t.warning; }
        else if (city == "Seattle") { dot = t.success; }
        int r = app.Scale(3);
        c.FillCircle(x + t.paddingSmall + r, y + h / 2, r, dot);
        int tx = x + t.paddingSmall + r * 2 + app.Scale(6);
        c.DrawText(tx, y + (h - Canvas.FontHeight(t.fontSizeSmall)) / 2,
                   city, t.textSecondary, t.fontSizeSmall);
        return true;
    }
}

// 大数据量图表虚拟数据源：基于连续整数列表实现无对象开销渲染。
