using System;
using System.Globalization;
using System.IO;
using System.Json;
using System.Threading;
using System.Net.Http;
using System.Net.Sockets;
using System.Security.Cryptography;
using System.Diagnostics;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;
using Gui.Component.Chart;
using Gui.Component.CodeEditor;
using Gui.Component.DataTable;
using Gui.Designer;
using Gui.Hmi;

public class BigDataSource : DataSource {
    int rowCount;
    int colCount;

    BigDataSource(int rows, int cols) {
        this.rowCount = rows;
        this.colCount = cols;
    }

    override int RowCount() { return this.rowCount; }

    override int CellNum(int row, int col) {
        return ((row + col * 13) % 97) * 37 % 1000;
    }

    override string CellText(int row, int col) {
        if (col == 0) { return "Row " + Convert.ToString(row + 1); }
        return Convert.ToString(((row + col * 13) % 97) * 37 % 1000);
    }
}
