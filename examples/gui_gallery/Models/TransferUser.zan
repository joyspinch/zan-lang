public class TransferUser {
    string name;
    string role;
    bool vip;
    TransferUser(string n, string r, bool v) { name = n; role = r; vip = v; }

    // Transfer 的行文本缺省取 item.ToString()（引用类型没有统一的
    // ToString，编译器也不再让 Convert.ToString 打印指针地址）——
    // 演示类自己给一份可读的。
    public string ToString() { return name; }
}

// InputNumber 演示的 format/parse/validator 钩子（Naive UI 同款委托）。
// 委托不能捕获环境，所以写成静态方法组。
