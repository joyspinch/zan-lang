using System;
using System.Globalization;
using System.IO;
using System.Json;
using System.Threading;
using System.Net.Http;
using System.Net.Sockets;
using System.Security.Cryptography;
using System.Diagnostics;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;
using Gui.Component.Chart;
using Gui.Component.CodeEditor;
using Gui.Component.DataTable;
using Gui.Designer;
using Gui.Hmi;

public class Comp {
    string category;
    string name;
    string desc;
    string code;
    // 声明式 JSON 配置代码片段（数据驱动形态）。
    string json;
    // 组件多态演示卡片集合；为空时回退至单卡片布局。
    List<Demo> demos;
    List<ApiRow> props;
    List<ApiRow> events;

    // 页面描述折行文本缓存，仅在宽度或字号变化时重新计算。
    string descSig;
    List<string> descLines;

    Comp(string category, string name, string desc, string code) {
        this.category = category;
        this.name = name;
        this.desc = desc;
        this.code = code;
        this.json = "";
        this.demos = new List<Demo>();
        this.props = new List<ApiRow>();
        this.events = new List<ApiRow>();
        this.descSig = "";
    }

    // 页面描述已折行缓存列表。
    List<string> DescLines(int cw, int fs) {
        string sig = Convert.ToString(cw) + "|" + Convert.ToString(fs);
        if (sig != descSig) {
            descSig = sig;
            descLines = Gallery.WrapText(desc, cw, fs);
        }
        return descLines;
    }

    Comp AddDemo(string title, string desc, string previewId, int previewH,
            string code, string json) {
        demos.Add(new Demo(title, desc, previewId, previewH, code, json));
        return this;
    }

    // 把 desc/code/json 那张「Basic usage」卡显式排到最前面。
    // EffectiveDemos 只在演示列表为空时才合成这张卡，所以给一个老组件
    // 补第一个 AddDemo，会顺手把它原有的基础示例顶掉 —— 页面上看起来
    // 就是「基础用法这一节没了」。两者都要留的组件调用这个。
    Comp WithBasic(int previewH) {
        demos.Insert(0, new Demo("Basic usage", "", name, previewH, code, json));
        return this;
    }

    Comp AddProp(string name, string type, string deflt, string desc) {
        props.Add(new ApiRow(name, type, deflt, desc));
        return this;
    }

    Comp AddEvent(string name, string sig, string desc) {
        events.Add(new ApiRow(name, sig, "", desc));
        return this;
    }

    // 流式接口：绑定备用卡片的声明式 JSON 配置。
    Comp Json(string j) {
        json = j;
        return this;
    }

    static Comp CreateJson(string category, string name, string desc,
            string code, string json) {
        Comp e = new Comp(category, name, desc, code);
        e.json = json;
        return e;
    }
}

// 组件 API 属性/事件声明条目。
