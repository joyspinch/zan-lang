using System;
using System.Globalization;
using System.IO;
using System.Json;
using System.Threading;
using System.Net.Http;
using System.Net.Sockets;
using System.Security.Cryptography;
using System.Diagnostics;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;
using Gui.Component.Chart;
using Gui.Component.CodeEditor;
using Gui.Component.DataTable;
using Gui.Designer;
using Gui.Hmi;

public class MockUploadJob {
    public Upload host;
    public int itemId;
    public int pct;
    public bool done;

    // UI 线程：刷新当前进度。
    public void Tick() {
        if (host != null) { host.SetItemPercent(itemId, pct); }
    }

    // UI 线程：置完成（Finish 事件由组件自己发）。
    public void Done() {
        if (host != null) { host.SetItemStatus(itemId, UploadStatus.Success(), ""); }
    }
}
