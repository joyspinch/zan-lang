    static DataRow DtRow7(string a, string b, string cc, string d, string e, string f, string g) {
        DataRow r = new DataRow();
        r.Push(a); r.Push(b); r.Push(cc); r.Push(d); r.Push(e); r.Push(f); r.Push(g);
        return r;
    }

    // ---- The DataTable demos' async Excel export ----
    // which: 1 = the DataTable demo (list source), 2 = the DataTable 1M demo
    // (virtual source). The UI guard only stops double clicks; the library's
    // single-job AtomicInt busy gate stays as the final backstop.
    static void OnDtExportClick() { Gallery.StartExport(1); }
    static void OnBigExportClick() { Gallery.StartExport(2); }

    static void StartExport(int which) {
        if (GalleryExportProgress.running) {
            Gallery.SetExportStatus(which, Gallery.T("An export is already running.", "已有导出在运行。"));
            Gallery.app.RequestRedraw();
            return;
        }
        string path;
        List<DataColumn> cols;
        DataSource src;
        DataTableState st;
        if (which == 1) {
            if (Gallery.dtDemoCols == null || Gallery.demoRows == null) { return; }
            path = "datatable_demo.xlsx";
            cols = Gallery.dtDemoCols;
            src = new RowListSource(Gallery.demoRows);
            st = Gallery.demoTableState;
        } else {
            if (Gallery.bigCols == null || Gallery.bigSource == null) { return; }
            path = "datatable_1m_export.xlsx";
            cols = Gallery.bigCols;
            src = Gallery.bigSource;
            st = Gallery.bigTableState;
        }
        GalleryExportProgress prog = new GalleryExportProgress();
        GalleryExportProgress.running = true;
        GalleryExportProgress.done = 0;
        GalleryExportProgress.total = 0;
        GalleryExportProgress.okFlag = false;
        GalleryExportProgress.message = "";
        GalleryExportProgress.path = path;
        GalleryExportProgress.slot = which;
        if (!DataTable.ExportToXlsxAsync(st, cols, src, path, false, prog)) {
            // "Nothing to export" returns without a callback; a thread-start
            // failure does call OnDone and overwrites this status line.
            GalleryExportProgress.running = false;
            Gallery.SetExportStatus(which, Gallery.T("Nothing to export.", "没有可导出的内容。"));
            Gallery.app.RequestRedraw();
            return;
        }
        Gallery.SetExportStatus(which, Gallery.T("Exporting… 0%", "正在导出… 0%"));
        Gallery.app.RequestRedraw();
    }

    static void SetExportStatus(int which, string s) {
        if (which == 1) { Gallery.dtExportStatus = s; }
        else { Gallery.bigExportStatus = s; }
    }

    // The two below run on the UI thread via App.Post and only read the
    // static mirrors on GalleryExportProgress.
    static void ApplyExportProgress() {
        int pct = 0;
        if (GalleryExportProgress.total > 0) {
            pct = GalleryExportProgress.done * 100 / GalleryExportProgress.total;
            if (pct > 100) { pct = 100; }
        }
        Gallery.SetExportStatus(GalleryExportProgress.slot,
            Gallery.T("Exporting… ", "正在导出… ") + Convert.ToString(pct) + "%");
        Gallery.app.RequestRedraw();
    }

    static void ApplyExportDone() {
        if (GalleryExportProgress.okFlag) {
            Gallery.SetExportStatus(GalleryExportProgress.slot,
                Gallery.T("Exported: ", "已导出：") + GalleryExportProgress.path);
        } else {
            Gallery.SetExportStatus(GalleryExportProgress.slot,
                Gallery.T("Export failed: ", "导出失败：") + GalleryExportProgress.message);
        }
        Gallery.app.RequestRedraw();
    }
