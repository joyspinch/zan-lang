        // paints (content bottom + margin), so cards stop carrying dead
        // whitespace while tall interactive previews still get room.
        if (name == "Label") { return 195; }
        if (name == "Events") { return 175; }
        if (name == "Checkbox") { return 175; }
        if (name == "Radio") { return 270; }
        if (name == "Statistic") { return 130; }
        if (name == "Countdown") { return 110; }
        if (name == "Countdown.controls") { return 130; }
        if (name == "Countdown.multi") { return 140; }
        if (name == "Countdown.styles") { return 140; }
        if (name == "Countdown.scenes") { return 150; }
        if (name == "NumberAnimation") { return 110; }
        if (name == "QrCode") { return 330; }
        if (name == "QrCode.levels") { return 170; }
        if (name == "QrCode.colors") { return 155; }
        if (name == "QrCode.logo") { return 170; }
        if (name == "QrCode.export") { return 230; }
        if (name == "Divider") { return 205; }
        if (name == "Breadcrumb") { return 105; }
        if (name == "PageHeader") { return 115; }
        if (name == "Panel") { return 145; }
        if (name == "Skeleton") { return 175; }
        if (name == "CheckboxGroup") { return 205; }
        if (name == "Form") { return 320; }
        if (name == "Form.validate") { return 470; }
        if (name == "Form.dependencies") { return 520; }
        if (name == "Switch.states") { return 110; }
        if (name == "Switch.master") { return 140; }
        if (name == "Radio.dependent") { return 130; }
        if (name == "Radio.bordered") { return 160; }
        if (name == "RadioGroup.options") { return 120; }
        if (name == "RadioGroup.buttons") { return 190; }
        if (name == "Switch.settings") { return 230; }
        if (name == "Switch.async") { return 120; }
        if (name == "Switch.content") { return 150; }
        if (name == "Switch.value") { return 110; }
