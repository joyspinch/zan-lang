        } else if (name == "Upload.download") {
            Panel ucol = Panel.Column().Gap(app.Scale(8));
            ucol.With(Gallery.demoUploadDl);
            ucol.With(Gallery.demoUploadDlLabel);
            Gallery.LayoutAuto(app, ucol, name, px, py,
                             w - app.Scale(36), app.Scale(130));
        } else if (name == "Upload.limit") {
            Panel ucol = Panel.Column().Gap(app.Scale(8));
            ucol.With(Gallery.demoUploadLimit);
            Gallery.LayoutAuto(app, ucol, name, px, py,
                             w - app.Scale(36), app.Scale(120));
        } else if (name == "Upload.dragger") {
            Panel ucol = Panel.Column().Gap(app.Scale(8));
            ucol.With(Gallery.demoUploadDrag);
            Gallery.LayoutAuto(app, ucol, name, px, py,
                             w - app.Scale(36), app.Scale(190));
        } else if (name == "Upload.wall") {
            Panel ucol = Panel.Column().Gap(app.Scale(8));
            ucol.With(Gallery.demoUploadWall);
            Gallery.LayoutAuto(app, ucol, name, px, py,
