                ChartLink.Of(Gallery.T("网关", "网关"), Gallery.T("传感器组", "传感器组"), 4) };
            ChartOption fso = ChartOption.Single(
                ChartSeries.Force(Gallery.T("智能家居网络", "智能家居网络"), fsLinks));
            ChartView.KeyedStatic(fso, 8713).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));


        } else if (name == "Chart.echarts_webkit_dep") {
            // ECharts webkit-dep：内核模块依赖网。
            List<ChartLink> wd = new List<ChartLink>{
                ChartLink.Of("WebCore", "Loader", 30),
                ChartLink.Of("WebCore", "Rendering", 45),
                ChartLink.Of("WebCore", "DOM", 38),
                ChartLink.Of("WebCore", "Platform", 16),
                ChartLink.Of("JavaScriptCore", "Interpreter", 28),
                ChartLink.Of("JavaScriptCore", "JIT", 34),
                ChartLink.Of("JavaScriptCore", "Runtime", 15),
                ChartLink.Of("Loader", "DOM", 22),
                ChartLink.Of("Loader", "Network", 19),
                ChartLink.Of("Rendering", "DOM", 26),
                ChartLink.Of("Rendering", "Graphics", 31),
                ChartLink.Of("DOM", "EventTarget", 14),
                ChartLink.Of("JIT", "Interpreter", 18),
                ChartLink.Of("Interpreter", "Runtime", 12),
                ChartLink.Of("Network", "Platform", 17),
                ChartLink.Of("Platform", "Graphics", 20),
                ChartLink.Of("WebCore", "JavaScriptCore", 12),
                ChartLink.Of("Runtime", "Platform", 9) };
            ChartOption wdo = ChartOption.Single(
                ChartSeries.Force(Gallery.T("WebKit 依赖", "WebKit 依赖"), wd));
            ChartView.KeyedStatic(wdo, 8714).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));


        } else if (name == "Chart.echarts_bubble_sex") {
            // ECharts scatter2：性别气泡图（半径按 sqrt(weight)）。
            List<Bubble> bf = new List<Bubble>{
                Bubble.Of(161, 52, 9), Bubble.Of(168, 59, 7),
                Bubble.Of(160, 49, 5), Bubble.Of(157, 63, 8),
                Bubble.Of(166, 57, 6) };
            List<Bubble> bm = new List<Bubble>{
                Bubble.Of(174, 66, 10), Bubble.Of(175, 72, 14),
                Bubble.Of(194, 81, 18), Bubble.Of(187, 73, 12),
                Bubble.Of(187, 79, 13), Bubble.Of(180, 69, 9) };
            ChartOption bbx = ChartOption.Of(
                Gallery.T("男女生身高体重（气泡）", "男女生身高体重（气泡）"), null,
                new List<ChartSeries>{
                    ChartSeries.OfBubbles(Gallery.T("女生", "女生"), bf),
                    ChartSeries.OfBubbles(Gallery.T("男生", "男生"), bm) });
            bbx.X(ChartAxis.ValueRange(140, 200));
            bbx.Y(ChartAxis.ValueRange(40, 100));
            bbx.showLegend = true;
            ChartView.KeyedStatic(bbx, 8715).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));


        } else if (name == "Chart.echarts_event_river2") {
            // ECharts eventRiver2：双事件带汇入同一时间河。
            ChartSeries eri = ChartSeries.OfEvents("iOS", new List<ChartEvent>{
                ChartEvent.Of(Gallery.T("iPhone 初代", "iPhone 初代"), 5, 35, 42),
                ChartEvent.Of(Gallery.T("App Store", "App Store"), 45, 80, 35),
                ChartEvent.Of(Gallery.T("Siri 问世", "Siri 问世"), 95, 140, 30),
                ChartEvent.Of(Gallery.T("Face ID", "Face ID"), 165, 215, 26) });
            ChartSeries era = ChartSeries.OfEvents("Android", new List<ChartEvent>{
                ChartEvent.Of(Gallery.T("G1 发布", "G1 发布"), 15, 50, 36),
                ChartEvent.Of(Gallery.T("蜂巢系统", "蜂巢系统"), 70, 110, 28),
                ChartEvent.Of(Gallery.T("KitKat", "KitKat"), 130, 170, 24),
                ChartEvent.Of(Gallery.T("可折叠形态", "可折叠形态"), 200, 250, 20) });
            ChartOption ero = ChartOption.Single(eri);
            ero.series.Add(era);
            ero.showLegend = true;
            ChartView.KeyedStatic(ero, 8716).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));


        } else if (name == "Chart.echarts_radar_period") {
            // ECharts radar 多期对照：Q1 / Q2 并列极坐标。
            List<string> rdims = new List<string>{
                "销售", "管理", "信息技术", "客服", "研发" };
            int cY = y + app.Scale(30);
            int cH = app.Scale(420);
            int halfW = (w - app.Scale(28) - app.Scale(12)) / 2;
            int c0X = x + app.Scale(14);
            int c1X = c0X + halfW + app.Scale(12);
            ChartSeries rcur = ChartSeries.Polar(Gallery.T("本季度", "本季度"),
                new List<int>{ 4300, 10000, 28000, 35000, 50000 });
            rcur.areaStyle = true;
            ChartOption rq1 = ChartOption.Of(Gallery.T("Q1 团队评估", "Q1 团队评估"),
                rdims, new List<ChartSeries>{ rcur });
            rq1.RadarMax(new List<int>{ 6500, 16000, 30000, 38000, 52000 });
            ChartView.KeyedStatic(rq1, 8718).Render(app, c0X, cY, halfW, cH);
            ChartSeries rnxt = ChartSeries.Polar(Gallery.T("下季度目标", "下季度目标"),
                new List<int>{ 4600, 11200, 29600, 36400, 51500 });
            rnxt.areaStyle = true;
            ChartOption rq2 = ChartOption.Of(Gallery.T("Q2 团队评估", "Q2 团队评估"),
                rdims, new List<ChartSeries>{ rnxt });
            rq2.RadarMax(new List<int>{ 6500, 16000, 30000, 38000, 52000 });
            ChartView.KeyedStatic(rq2, 8719).Render(app, c1X, cY, halfW, cH);
        } else if (name == "Chart.echarts_timeline") {
            // ECharts pie7（timeline）：同一张饼按年份帧切换，底部
            // 播放器条自动轮播（播放/暂停 + 前后帧 + 帧点）。
            ChartOption tlA = ChartOption.Of(Gallery.T("2011", "2011 年"), null,
                new List<ChartSeries>{
                    ChartSeries.Named("2011", ChartType.Pie, new List<ChartData>{
                        ChartData.Named(335, Gallery.T("Direct", "直接访问")),
                        ChartData.Named(310, Gallery.T("Mail", "邮件营销")),
                        ChartData.Named(234, Gallery.T("Affiliate", "联盟广告")),
                        ChartData.Named(135, Gallery.T("Video", "视频广告")) }) });
            tlA.donutPct = 0;
            tlA.pieLabels = true;
            tlA.showLegend = false;
            tlA.toolboxShow = false;
            ChartOption tlB = ChartOption.Of(Gallery.T("2012", "2012 年"), null,
                new List<ChartSeries>{
                    ChartSeries.Named("2012", ChartType.Pie, new List<ChartData>{
                        ChartData.Named(410, Gallery.T("Direct", "直接访问")),
                        ChartData.Named(280, Gallery.T("Mail", "邮件营销")),
                        ChartData.Named(190, Gallery.T("Affiliate", "联盟广告")),
                        ChartData.Named(220, Gallery.T("Video", "视频广告")) }) });
            tlB.donutPct = 0;
            tlB.pieLabels = true;
            tlB.showLegend = false;
            tlB.toolboxShow = false;
            ChartTimeline tlp = ChartTimeline.Of()
                .Frame(tlA).Frame(tlB)
                .Labels(new List<string>{ Gallery.T("2011", "2011 年"),
                    Gallery.T("2012", "2012 年") })
                .AutoPlay(1600);
            // 布局：图表占上部，播放器条贴底；帧号/播放态持久化在
            // 8720 的 App 状态里，立即模式重建不丢。
            int tlX = x + app.Scale(14);
            int tlY = y + app.Scale(30);
            int tlW = w - app.Scale(28);
            int tlBar = ChartTimeline.Height(app);
            int tlH = app.Scale(420) - tlBar;
            int tlIdx = ChartTimeline.TimelineIdxOf(app, 8720, tlp.FrameCount());
            ChartView.KeyedStatic(ChartTimeline.Merge(tlA, tlp.Current(tlIdx)), 8720)
                .Render(app, tlX, tlY, tlW, tlH);
            tlp.Draw(app, 8720, tlX, tlY + tlH, tlW);
        } else if (name == "Chart.echarts_connect") {
            // ECharts connect：同组两张图共享交互态——拖左图 dataZoom
            // 滑块或悬停任一张，另一张同帧跟随（同组图例开关也同步）。
            List<string> cwkl = new List<string>{
                "周一", "周二", "周三", "周四", "周五", "周六", "周日" };
            ChartOption cnA = ChartOption.Of(Gallery.T("Line", "折线图"), cwkl,
                new List<ChartSeries>{
                    ChartSeries.Line(Gallery.T("Mail", "邮件营销"),
                        new List<int>{ 120, 132, 101, 134, 90, 230, 210 }),
                    ChartSeries.Line(Gallery.T("Ad", "联盟广告"),
                        new List<int>{ 220, 182, 191, 234, 290, 330, 310 }) });
            cnA.DataZoom(20, 70);
            cnA.ConnectGroup(8723);
            ChartOption cnB = ChartOption.Of(Gallery.T("Bar", "柱状图"), cwkl,
                new List<ChartSeries>{
                    ChartSeries.Bar(Gallery.T("Mail", "邮件营销"),
                        new List<int>{ 320, 332, 301, 334, 390, 330, 320 }),
                    ChartSeries.Bar(Gallery.T("Ad", "联盟广告"),
                        new List<int>{ 820, 932, 901, 934, 1290, 1330, 1320 }) });
            cnB.ConnectGroup(8723);
            int cnY = y + app.Scale(30);
            int cnH = app.Scale(420);
            int cnHalf = (w - app.Scale(28) - app.Scale(12)) / 2;
            int cnX = x + app.Scale(14);
            ChartView.KeyedStatic(cnA, 8721).Render(app, cnX, cnY, cnHalf, cnH);
            ChartView.KeyedStatic(cnB, 8722).Render(
                app, cnX + cnHalf + app.Scale(12), cnY, cnHalf, cnH);


        } else if (name == "Ellipsis") {
            string longText = "A very long component description that will not fit a narrow column";
            Gallery.EllipsisRow(app, px, py - app.Scale(6), app.Scale(160), longText);
            Gallery.EllipsisRow(app, px, py + app.Scale(30), app.Scale(280), longText);
            Gallery.EllipsisRow(app, px, py + app.Scale(66), app.Scale(440), longText);
        } else if (name == "Divider") {
            // Plain divider, labeled divider, and a vertical rule — showing the
            // three basic uses of the rule, stacked by a column.
            Panel col = Panel.Column().Gap(app.Scale(18));
            col.With(new Divider());
            col.With(new Divider("Section"));
            Panel row = Panel.Row().Gap(app.Scale(20));
            row.With(new Label { Text = "Left" });
            Divider vert = new Divider();
            vert.Class = "vertical";
            row.With(vert);
            row.With(new Label { Text = "Right" });
            col.With(row);
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(150));
        } else if (name == "Progress.line") {
            // Naive UI basic: one line bar per type, plus a bare bar with no
            // indicator text.
            Panel col = Panel.Column().Gap(app.Scale(12));
            col.With(new Progress(72, 0));
            col.With(new Progress(45, 2));
            col.With(new Progress(90, 3));
            col.With(new Progress(30, 4));
            col.With(new Progress(60, 0).ShowText(false));
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(170));
        } else if (name == "Progress.processing") {
            // Naive UI processing state: Processing(true) rolls highlight
            // stripes through the fill while the task runs.
            Panel col = Panel.Column().Gap(app.Scale(12));
            col.With(new Progress(65, 0).Processing(true));
            col.With(new Progress(80, 3).Processing(true));
            col.With(new Progress(35, 4).Processing(true));
            col.With(new Progress(95, 5).Processing(true));
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(150));
        } else if (name == "Progress.height") {
            // Naive UI custom height: StrokeWidth thickens the track in px.
            Panel col = Panel.Column().Gap(app.Scale(12));
            col.With(new Progress(72, 0).StrokeWidth(4));
            col.With(new Progress(72, 0).StrokeWidth(10));
            col.With(new Progress(72, 0).StrokeWidth(18));
            col.With(new Progress(72, 0).StrokeWidth(26));
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(160));
        } else if (name == "Progress.colors") {
            // Naive UI custom colour: FillColor swaps the fill, RailColor the
            // track (0 restores the skin).
            Panel col = Panel.Column().Gap(app.Scale(12));
            col.With(new Progress(66, 0)
                .FillColor(Theme.Rgb(122, 90, 248))
                .RailColor(Theme.Rgb(238, 236, 252)));
            col.With(new Progress(80, 0)
                .FillColor(Theme.Rgb(0, 150, 136))
                .RailColor(Theme.Rgb(224, 242, 241)));
            col.With(new Progress(45, 0)
                .FillColor(Theme.Rgb(240, 98, 146))
                .RailColor(Theme.Rgb(252, 228, 236)));
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(130));
        } else if (name == "Progress.indicator") {
            // Naive UI custom indicator: every {0} in the Format template
            // becomes the percent number.
            Panel col = Panel.Column().Gap(app.Scale(12));
            col.With(new Progress(66, 0).Format("已完成 {0}%"));
            col.With(new Progress(45, 4).Format("剩余 {0}%"));
            col.With(new Progress(80, 2).Format("8 hours {0}%"));
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(130));
        } else if (name == "Progress.circle") {
            // Naive UI circle: rings per type, a smaller Size(48) pair and one
            // with the indicator text off.
            Flex row = Flex.Wrapped().Gap(app.Scale(24));
            row.With(new Progress(72, 0).Ring());
            row.With(new Progress(90, 3).Ring());
            row.With(new Progress(45, 4).Ring());
            row.With(new Progress(60, 2).Ring().Size(48));
            row.With(new Progress(30, 0).Ring().ShowText(false).Size(48));
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(6),
                             w - app.Scale(36), app.Scale(110));
        } else if (name == "Progress.dashboard") {
            // Naive UI dashboard: a 270° arc starting at the lower-left with a
            // gap at the bottom.
            Flex row = Flex.Wrapped().Gap(app.Scale(24));
            row.With(new Progress(45, 0).Dashboard());
            row.With(new Progress(70, 3).Dashboard());
            row.With(new Progress(60, 4).Dashboard());
            row.With(new Progress(85, 2).Dashboard());
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(6),
                             w - app.Scale(36), app.Scale(120));
        } else if (name == "Progress.multi") {
            // Naive UI multiple circles: one ring per AddCircle(value, type),
            // outermost first; the centre lists every ring in its own colour.
            // 140px 起步：中心要放下 n 行百分比，88px 会把弧线挤进文字。
            Flex row = Flex.Wrapped().Gap(app.Scale(32));
            row.With(new Progress(0, 0).Multi().Size(140)
                .AddCircle(90, 3).AddCircle(60, 0).AddCircle(30, 2));
            row.With(new Progress(0, 0).Multi().Size(140)
                .AddCircle(45, 4).AddCircle(75, 5));
            row.With(new Progress(0, 0).Multi().Size(140)
                .AddCircle(80, 2).AddCircle(55, 3).AddCircle(35, 4)
                .AddCircle(15, 5));
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(6),
                             w - app.Scale(36), app.Scale(170));
        } else if (name == "Alert.types") {
            // Inline banners: one per role, the full type set side by side.
            int aw = w - app.Scale(36);
            int aay = py - app.Scale(20);
            int step = Layer.NotifyH(app) + app.Scale(12);
            Layer.DrawNotify(app, px, aay, aw,
                Gallery.T("Default — plain banner without a role tint.",
                          "默认 — 无角色着色的普通横幅。"), 0);
            Layer.DrawNotify(app, px, aay + step, aw,
                Gallery.T("Info — additional context that does not demand action.",
                          "信息 — 需要了解但无需操作的上下文。"), 2);
            Layer.DrawNotify(app, px, aay + step * 2, aw,
                Gallery.T("Success — the build finished.", "成功 — 构建完成。"), 3);
            Layer.DrawNotify(app, px, aay + step * 3, aw,
                Gallery.T("Warning — low disk space.", "警告 — 磁盘空间不足。"), 4);
            Layer.DrawNotify(app, px, aay + step * 4, aw,
                Gallery.T("Error — deployment failed.", "错误 — 部署失败。"), 5);
            Gallery.RecordBottom(app, name,
                aay + step * 4 + Layer.NotifyH(app));
        } else if (name == "Alert.queue") {
            // Transient queues: every button fires the real API; the toasts
            // and corner cards render from the app's overlay pass (gallery
            // main loop calls Layer.RenderToasts/RenderNotifs every frame).
            int bw = app.Scale(96);
            int bh = t.heightMedium;
            int gapq = app.Scale(8);
            int bx = px;
            int by = py - app.Scale(16);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                bx, by - app.Scale(24),
                Gallery.T("Layer.Msg · top-centred toast",
                          "Layer.Msg · 顶部居中消息"),
                t.textPrimary, t.fontSizeMedium);
            int qm0 = new Button { Text = Gallery.T("Default", "默认") }
                .Render(app, bx, by, bw);
            if (Ui.Clicked(app, qm0)) { Layer.Msg("Message saved.", 0); }
            int qm2 = new Button { Text = "Info" }
                .Render(app, bx + (bw + gapq), by, bw);
            if (Ui.Clicked(app, qm2)) { Layer.Msg("Context loaded.", 2); }
            int qm3 = new Button { Text = "Success" }
                .Render(app, bx + (bw + gapq) * 2, by, bw);
            if (Ui.Clicked(app, qm3)) { Layer.Msg("Saved successfully", 3); }
            int qm4 = new Button { Text = "Warning" }
                .Render(app, bx + (bw + gapq) * 3, by, bw);
            if (Ui.Clicked(app, qm4)) { Layer.Msg("Unsaved changes", 4); }
            int qm5 = new Button { Text = "Error" }
                .Render(app, bx + (bw + gapq) * 4, by, bw);
            if (Ui.Clicked(app, qm5)) { Layer.Msg("Network error", 5); }
            by = by + bh + app.Scale(34);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                bx, by - app.Scale(24),
                Gallery.T("Layer.Notify · top-right corner card",
                          "Layer.Notify · 右上角通知卡"),
                t.textPrimary, t.fontSizeMedium);
            int qn0 = new Button { Text = Gallery.T("Default", "默认") }
                .Render(app, bx, by, bw);
            if (Ui.Clicked(app, qn0)) { Layer.Notify("Deploy started", 0); }
            int qn2 = new Button { Text = "Info" }
                .Render(app, bx + (bw + gapq), by, bw);
            if (Ui.Clicked(app, qn2)) { Layer.Notify("New version available", 2); }
            int qn3 = new Button { Text = "Success" }
                .Render(app, bx + (bw + gapq) * 2, by, bw);
            if (Ui.Clicked(app, qn3)) { Layer.Notify("Build completed", 3); }
            int qn4 = new Button { Text = "Warning" }
                .Render(app, bx + (bw + gapq) * 3, by, bw);
            if (Ui.Clicked(app, qn4)) { Layer.Notify("Disk almost full", 4); }
            int qn5 = new Button { Text = "Error" }
                .Render(app, bx + (bw + gapq) * 4, by, bw);
            if (Ui.Clicked(app, qn5)) { Layer.Notify("Tests failed", 5); }
            Gallery.RecordBottom(app, name, by + bh);
        } else if (name == "Result") {
            // Every status side by side: success / warning / error, arranged by
            // a row that lets each card keep its natural width.
            Result r1 = new Result("Success", "Changes saved.");
            r1.Class = Result.StatusClass(1);
            Result r2 = new Result("Warning", "Review the config.");
            r2.Class = Result.StatusClass(2);
            Result r3 = new Result("Error", "The build failed.");
            r3.Class = Result.StatusClass(3);
            Flex row = Flex.Wrapped().Gap(app.Scale(18));
            row.With(r1); row.With(r2); row.With(r3);
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(20),
                             w - app.Scale(36), app.Scale(220));
        } else if (name == "Tooltip") {
            // Triggers: hover shows the tip while the pointer is over the target;
            // click toggles it; manual is fully programmatic (Show/Hide buttons
            // drive the bubble from caller state alone). All three feed the same
            // Tooltip.RenderAt / RenderBox renderer.
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py - app.Scale(28),
                Gallery.T("Triggers · hover / click / manual",
                          "触发方式 · 悬浮 / 点击 / 手动"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int bw = app.Scale(110);
            // Hover tip: the Button's Tip property handles everything inside the
            // component (no manual anchor math at the call site).
            int hoverId = new Button { Text = "Hover me", Tip = "Shown on hover" }
                .Render(app, px, py, bw);
            int clickX = px + bw + app.Scale(14);
            int clickId = new Button { Text = "Click me" }.Render(app, clickX, py, bw);
            if (Ui.Clicked(app, clickId)) {
                Gallery.tipClickOn.Set(!Gallery.tipClickOn.Get());
            }
            if (Gallery.tipClickOn.Get()) {
                // Pass the button's rectangle; Tooltip places itself below it.
                Tooltip.RenderBox(app, clickX, py, bw, t.heightMedium,
                                  "Toggled by click", 1, 0);
            }
            // Manual: the caller owns the on/off state entirely — like Naive
            // UI's "manual" trigger, no pointer involvement at all.
            int manX = clickX + bw + app.Scale(14);
            int mbw = app.Scale(76);
            int showId = new Button { Text = Gallery.T("Show", "显示") }
                .Render(app, manX, py, mbw);
            if (Ui.Clicked(app, showId)) { Gallery.tipManual.Set(true); }
            int hideX = manX + mbw + app.Scale(14);
            int hideId = new Button { Text = Gallery.T("Hide", "隐藏") }
                .Render(app, hideX, py, mbw);
            if (Ui.Clicked(app, hideId)) { Gallery.tipManual.Set(false); }
            if (Gallery.tipManual.Get()) {
                Tooltip.RenderBox(app, manX, py, mbw * 2 + app.Scale(14),
                                  t.heightMedium,
                                  Gallery.T("Controlled by caller state",
                                            "完全由调用方状态控制"),
                                  3, 0);
            }

            // Placements: four widely-spaced anchors, each always-on so all four
            // sides are visible at once without overlapping.
            int rowY = py + app.Scale(120);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, rowY - app.Scale(30),
                Gallery.T("Placements · top / bottom / left / right",
                          "位置 · 上 / 下 / 左 / 右"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int dot = app.Scale(7);
            int pw = w - app.Scale(52);
            int p0 = px + app.Scale(30);
            int pstep = pw / 4;
            c.FillCircle(p0, rowY, dot, t.primary);
            Tooltip.RenderAt(app, p0, rowY - dot, "Top", 0, 0);
            c.FillCircle(p0 + pstep, rowY, dot, t.primary);
            Tooltip.RenderAt(app, p0 + pstep, rowY + dot, "Bottom", 1, 0);
            c.FillCircle(p0 + pstep * 2, rowY, dot, t.primary);
            Tooltip.RenderAt(app, p0 + pstep * 2 - dot, rowY, "Left", 2, 0);
            c.FillCircle(p0 + pstep * 3, rowY, dot, t.primary);
            Tooltip.RenderAt(app, p0 + pstep * 3 + dot, rowY, "Right", 3, 0);

            // Body style: Tooltip.RenderRich paints a two-line bubble — bold
            // title over a muted description — for hint content that needs a
            // little more structure than one plain line.
            int richY = py + app.Scale(250);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, richY - app.Scale(30),
                Gallery.T("Body style · bold title + muted description",
                          "主体样式 · 粗体标题 + 弱化描述"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int richId = new Button { Text = Gallery.T("California girl", "加州女孩") }
                .Render(app, px, richY, bw);
            if (app.focus.IsHovered(richId)) {
                Tooltip.RenderRich(app, px,
                                   richY + t.heightMedium + app.Scale(8),
                                   Gallery.T("California girl", "加州女孩"),
                                   Gallery.T("Bold title on top, muted description below.",
                                             "粗体标题在上，弱化描述在下。"));
            }

            // Long text: wraps automatically; a scrollbar appears past the cap
            // and the wheel scrolls the bubble content while the pointer is over it.
            int longY = py + app.Scale(380);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, longY - app.Scale(8),
                Gallery.T("Long text · auto-wrap + wheel scroll",
                          "长文本 · 自动换行 + 滚轮滚动"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            c.FillCircle(p0, longY + app.Scale(18), dot, t.info);
            string longTip = "Long text wraps automatically onto multiple lines. When it grows past the height cap a scrollbar appears on the right and the mouse wheel scrolls the content while the pointer is over the bubble, so nothing is clipped away and the bubble still stays fully on screen no matter which edge it is near.";
            int tipMaxW = app.Scale(140);
            int tipAX = p0 + dot;
            int tipAY = longY + app.Scale(18);
            Rect tipBox = Tooltip.BoxRect(app, tipAX, tipAY, longTip, 3, tipMaxW);
            if (app.CaptureWheel(tipBox.x, tipBox.y, tipBox.width, tipBox.height)) {
                int wd = app.window.EventKeyCode();
                int cur = Gallery.tipScroll.Get() - wd * app.Scale(24) / 120;
                int tmax = Tooltip.MaxScroll(app, longTip, tipMaxW);
                if (cur < 0) { cur = 0; }
                if (cur > tmax) { cur = tmax; }
                Gallery.tipScroll.Set(cur);
                app.RequestRedraw();
            }
            Tooltip.RenderScroll(app, tipAX, tipAY, longTip, 3, tipMaxW, Gallery.tipScroll.Get());

            // Edge flip: the anchor asks for Right but sits close enough to the
            // window's right edge that the bubble cannot fit, so BoxRect flips
            // it to the Left instead of clipping it.
            int flipY = py + app.Scale(510);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, flipY - app.Scale(30),
                Gallery.T("Edge flip · asked Right, clamped to Left by the window edge",
                          "贴边自动翻转 · 请求 Right，被窗口右缘翻成 Left"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int flipX = px + w - app.Scale(56);
            c.FillCircle(flipX, flipY, dot, t.primary);
            Tooltip.RenderAt(app, flipX, flipY,
                Gallery.T("Asked for Right, flipped to Left near the window edge",
                          "请求 Right，靠近窗口右缘自动翻到 Left"), 3, 0);
            Gallery.RecordBottom(app, name, flipY + app.Scale(44));
        } else if (name == "Spin.plain") {
            Spin big = new Spin(56);
            big.Class = "info";
            Flex row = Flex.Wrapped().Gap(app.Scale(26));
            row.With(new Spin(28));
            row.With(new Spin(40));
            row.With(big);
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(4),
                             w - app.Scale(36), app.Scale(70));
        } else if (name == "Spin.tip") {
            Spin load = new Spin(36);
            load.Tip = "Loading data...";
            load.RenderInside(app, new Rect(px, py - app.Scale(20),
                                               app.Scale(300),
                                               app.Scale(110)));
        } else if (name == "Skeleton") {
            Skeleton dot = new Skeleton(40, 40);
            dot.Class = "circle";
            Panel col = Panel.Column().Gap(app.Scale(12));
            Panel row = Panel.Row().Gap(app.Scale(12));
            row.With(dot);
            row.With(new Skeleton(180, 14));
            col.With(row);
            col.With(new Skeleton(180, 14));
            col.With(new Skeleton(180, 14));
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(4),
                             w - app.Scale(36), app.Scale(120));
        } else if (name == "FloatButton") {
            // A fixed utility rail (like a page's bottom-right dock): a stack of
            // quick actions plus a "back to top" that only appears once the
            // content has been scrolled, and jumps the viewport home when hit.
            int vx = px;
            int vy = py - app.Scale(16);
            int vw = w - app.Scale(120);
            int vh = app.Scale(250);
            int rowH = app.Scale(30);
            int rows = 24;
            int contentH = rowH * rows;
            c.FillRoundRect(vx, vy, vw, vh, app.Scale(4), t.bgPrimary);
            c.DrawRoundRect(vx, vy, vw, vh, app.Scale(4), t.borderPrimary, 1);
            Scrollbar.HandleWheel(app, vx, vy, vw, vh, contentH, Gallery.fbScroll);
            int fbo = Gallery.fbScroll.Get();
            int fbmo = contentH - vh;
            if (fbmo < 0) { fbmo = 0; }
            if (fbo > fbmo) { fbo = fbmo; }
            c.PushClip(vx, vy, vw - app.Scale(16), vh);
            for (int fri = 0; fri < rows; fri = fri + 1) {
                int ry = vy + fri * rowH - fbo + app.Scale(7);
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "", Style.SNormal()),
                    vx + app.Scale(14), ry, Gallery.T("Scrollable content line ", "可滚动内容第 ") + Convert.ToString(fri + 1) + Gallery.T("", " 行"),
                    app.theme.textPrimary, app.theme.fontSizeMedium);
            }
            c.PopClip();
            Scrollbar.RenderVerticalScroll(app, vx + vw - app.Scale(13), vy,
                vh, vh, contentH, Gallery.fbScroll);

            // The floating dock, anchored bottom-right of the viewport.
            int fbSz = app.Scale(46);
            int fbGap = app.Scale(12);
            int stackX = vx + vw + app.Scale(20);
            int stackY = vy + vh - fbSz;
            new FloatButton("settings") { Size = fbSz }
                .Render(app, stackX, stackY);
            new FloatButton("info") { Size = fbSz }
                .Render(app, stackX, stackY - (fbSz + fbGap));
            new FloatButton("bell") { Size = fbSz }
                .Render(app, stackX, stackY - (fbSz + fbGap) * 2);
            if (fbo > 0) {
                int topId = new FloatButton("arrow-up") {
                        Size = fbSz, Class = "primary" }
                    .Render(app, stackX, stackY - (fbSz + fbGap) * 3);
                if (app.window.EventKind() == 3
                        && app.hitTester.HitTest(app.mouseX, app.mouseY) == topId) {
                    Gallery.fbScroll.Set(0);
                    app.RequestRedraw();
                }
            }
        } else if (name == "Scrollbar") {
            // Interactive: mouse-wheel over the list, drag the thumb, or click
            // the track to scroll.
            int vx = px;
            int vy = py - app.Scale(16);
            int vw = app.Scale(300);
            int vh = app.Scale(130);
            int rowH = app.Scale(28);
            int contentH = rowH * 16;
            c.FillRoundRect(vx, vy, vw, vh, app.Scale(4), t.bgPrimary);
            c.DrawRoundRect(vx, vy, vw, vh, app.Scale(4), t.borderPrimary, 1);
            Scrollbar.HandleWheel(app, vx, vy, vw, vh, contentH, Gallery.scrollOff);
            int off = Gallery.scrollOff.Get();
            int mo = contentH - vh;
            if (mo < 0) { mo = 0; }
            if (off > mo) { off = mo; }
            c.PushClip(vx, vy, vw - app.Scale(16), vh);
            for (int ri = 0; ri < 16; ri = ri + 1) {
                int ry = vy + ri * rowH - off + app.Scale(6);
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "", Style.SNormal()),
                    vx + app.Scale(14), ry, Gallery.T("List row ", "列表行 ") + Convert.ToString(ri + 1),
                    app.theme.textPrimary, app.theme.fontSizeMedium);
            }
            c.PopClip();
            Scrollbar.RenderVerticalScroll(app, vx + vw - app.Scale(13), vy,
                vh, vh, contentH, Gallery.scrollOff);
        } else if (name == "Ribbon") {
            List<string> rtabs = new List<string>{
                Gallery.T("Home", "开始"),
                Gallery.T("Insert", "插入"),
                Gallery.T("View", "视图")
            };
            // Each tab shows a different set of groups so switching is visible.
            List<RibbonGroup> rgroups = new List<RibbonGroup>();
            int rtab = Gallery.ribbonTab.Get();
            if (rtab == 1) {
                rgroups = new List<RibbonGroup>{
                    RibbonGroup.Of(Gallery.T("Insert", "插入"), new List<RibbonItem>{
                        RibbonItem.Large("table", Gallery.T("Table", "表格")),
                        RibbonItem.Large("grid", Gallery.T("Grid", "网格"))
                    }),
                    RibbonGroup.Of(Gallery.T("Links", "链接"), new List<RibbonItem>{
                        RibbonItem.Small("globe", Gallery.T("Link", "链接")),
                        RibbonItem.Small("mail", Gallery.T("Mail", "邮件")),
                        RibbonItem.Small("file", Gallery.T("File", "文件"))
                    })
                };
            } else if (rtab == 2) {
                rgroups = new List<RibbonGroup>{
                    RibbonGroup.Of(Gallery.T("Show", "显示"), new List<RibbonItem>{
                        RibbonItem.Small("eye", Gallery.T("Preview", "预览")),
                        RibbonItem.Small("menu", Gallery.T("Sidebar", "侧栏")),
                        RibbonItem.Small("grid", Gallery.T("Grid", "网格"))
                    }),
                    RibbonGroup.Of(Gallery.T("Zoom", "缩放"), new List<RibbonItem>{
                        RibbonItem.Large("plus", Gallery.T("Zoom In", "放大")),
                        RibbonItem.Large("minus", Gallery.T("Zoom Out", "缩小"))
                    }),
                    RibbonGroup.Of(Gallery.T("Theme", "主题"), new List<RibbonItem>{
                        RibbonItem.Small("sun", Gallery.T("Light", "浅色")),
                        RibbonItem.Small("moon", Gallery.T("Dark", "深色"))
                    })
                };
            } else {
                rgroups = new List<RibbonGroup>{
                    RibbonGroup.Of(Gallery.T("File", "文件"), new List<RibbonItem>{
                        RibbonItem.Large("folder", Gallery.T("Open", "打开")),
                        RibbonItem.Large("save", Gallery.T("Save", "保存"))
                    }),
                    RibbonGroup.Of(Gallery.T("Edit", "编辑"), new List<RibbonItem>{
                        RibbonItem.Small("copy", Gallery.T("Copy", "复制")),
                        RibbonItem.Small("edit", Gallery.T("Rename", "重命名")),
                        RibbonItem.Small("trash", Gallery.T("Delete", "删除"))
                    }),
                    RibbonGroup.Of(Gallery.T("Run", "运行"), new List<RibbonItem>{
                        RibbonItem.Large("play", Gallery.T("Run", "运行")),
                        RibbonItem.Small("bug", Gallery.T("Debug", "调试")),
                        RibbonItem.Small("settings", Gallery.T("Config", "配置"))
                    })
                };
            }
            Ribbon.RenderTabbed(app, px, py - app.Scale(20),
                w - app.Scale(36), rtabs, Gallery.ribbonTab, rgroups);
        } else if (name == "Wizard") {
            // Full inline wizard: template list + name/location fields + a live
            // description + Create/Cancel. (Wizard.Render draws the same layout
            // full-window inside its own dialog -- see the Examples snippet.)
            List<WizardItem> witems = new List<WizardItem>{
                new WizardItem(Gallery.T("Console app", "控制台应用"), "code",
                    Gallery.T("A terminal program with a main() entry point.",
                        "带有 main() 入口的终端程序。")),
                new WizardItem(Gallery.T("GUI app", "图形界面应用"), "grid",
                    Gallery.T("A windowed app built on the Zan GUI toolkit.",
                        "基于 Zan GUI 工具包的窗口应用。")),
                new WizardItem(Gallery.T("Library", "库项目"), "file",
                    Gallery.T("A reusable library with no entry point.",
                        "无入口点的可复用库。"))
            };
            int wListW = app.Scale(240);
            int wy = py - app.Scale(8);
            int wListH = app.Scale(180);
            Wizard.RenderList(app, px, wy, wListW, wListH, witems, Gallery.wizSel);
            int wfx = px + wListW + app.Scale(24);
            int wfw = w - app.Scale(36) - (wListW + app.Scale(24));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                wfx, wy, Gallery.T("Name", "名称"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            Gallery.wizName.Render(app, wfx, wy + app.Scale(20), wfw, t.heightMedium);
            int wny = wy + app.Scale(20) + t.heightMedium + app.Scale(12);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                wfx, wny, Gallery.T("Location", "位置"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            Gallery.wizLoc.Render(app, wfx, wny + app.Scale(20), wfw, t.heightMedium);
            int wdy = wny + app.Scale(20) + t.heightMedium + app.Scale(14);
            int wsel = Gallery.wizSel.Get();
            if (wsel >= 0 && wsel < witems.Count) {
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "secondary", Style.SNormal()),
                    wfx, wdy, witems[wsel].desc,
                    app.theme.textPrimary, app.theme.fontSizeMedium);
            }
            int wby = wy + wListH + app.Scale(16);
            int wbw = app.Scale(104);
            new Button { Text = Gallery.T("Cancel", "取消") }.Render(app, wfx, wby, wbw);
            new Button { Text = Gallery.T("Create", "创建"), Class = "primary" }.Render(
                app, wfx + wbw + t.gapMedium, wby, wbw);
        } else if (name == "Split") {
            // Two real, draggable Split widgets: a vertical divider (left|right)
            // and a horizontal one (top|bottom). Drag the coloured handle.
            int sy = py - app.Scale(16);
            int sh = app.Scale(250);
            int colW = (w - app.Scale(56)) / 2;
            Rect a1 = new Rect(px, sy, colW, sh);
            Split sp = Split.Vertical(app, a1, Gallery.splitVFirst,
                app.Scale(70), app.Scale(70));
            c.FillRect(sp.first.x, sp.first.y, sp.first.width, sp.first.height,
                t.bgSecondary);
            c.FillRect(sp.second.x, sp.second.y, sp.second.width,
                sp.second.height, t.bgTertiary);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                sp.first.x + app.Scale(10), sp.first.y + app.Scale(8), Gallery.T("Left", "左侧"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                sp.second.x + app.Scale(10), sp.second.y + app.Scale(8), Gallery.T("Right", "右侧"),
                app.theme.textPrimary, app.theme.fontSizeMedium);

            Rect a2 = new Rect(px + colW + app.Scale(24), sy, colW, sh);
            Split sp2 = Split.Horizontal(app, a2, Gallery.splitHFirst,
                app.Scale(50), app.Scale(50));
            c.FillRect(sp2.first.x, sp2.first.y, sp2.first.width,
                sp2.first.height, t.bgSecondary);
            c.FillRect(sp2.second.x, sp2.second.y, sp2.second.width,
                sp2.second.height, t.bgTertiary);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                sp2.first.x + app.Scale(10), sp2.first.y + app.Scale(8), Gallery.T("Top", "上部"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                sp2.second.x + app.Scale(10), sp2.second.y + app.Scale(8), Gallery.T("Bottom", "下部"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
        } else if (name == "FilePicker") {
            // Live: each button opens the real modal dialog window; the chosen
            // path is read back from TakeResult() in the main loop. The open-file
            // dialog offers several extension filters (see BeginOpenFileFilters).
            int fbw = app.Scale(160);
            int fbh = t.heightMedium;
            int fgap = app.Scale(10);
            int ofId = new Button { Text = Gallery.T("Open file...", "打开文件...") }.Render(app, px, py, fbw);
            if (Ui.Clicked(app, ofId)) {
                List<FileFilter> filters = new List<FileFilter>();
                filters.Add(new FileFilter(
                    Gallery.T("Zan source (*.zan)", "Zan 源文件 (*.zan)"), ".zan"));
                filters.Add(new FileFilter(
                    Gallery.T("Text (*.txt;*.md)", "文本 (*.txt;*.md)"), ".txt;.md"));
                filters.Add(new FileFilter(
                    Gallery.T("Data (*.json)", "数据 (*.json)"), ".json"));
                filters.Add(new FileFilter(
                    Gallery.T("All files (*.*)", "所有文件 (*.*)"), ""));
                Gallery.filePicker.BeginOpenFileFilters("", filters,
                    Gallery.T("Open file", "打开文件"));
            }
            int odId = new Button { Text = Gallery.T("Open folder...", "打开文件夹...") }.Render(
                app, px + fbw + fgap, py, fbw);
            if (Ui.Clicked(app, odId)) {
                Gallery.filePicker.BeginFolder("",
                    Gallery.T("Open folder", "打开文件夹"));
            }
            int fr2 = py + fbh + fgap;
            int sfId = new Button { Text = Gallery.T("Save file...", "保存文件...") }.Render(app, px, fr2, fbw);
            if (Ui.Clicked(app, sfId)) {
                Gallery.filePicker.BeginSaveFile("", ".zan", "untitled.zan",
                    Gallery.T("Save file", "保存文件"));
            }
            int sdId = new Button { Text = Gallery.T("Save to folder...", "保存到文件夹...") }.Render(
                app, px + fbw + fgap, fr2, fbw);
            if (Ui.Clicked(app, sdId)) {
                Gallery.filePicker.BeginFolder("",
                    Gallery.T("Save to folder", "保存到文件夹"));
            }
            int fry = fr2 + fbh + app.Scale(16);
            if (Gallery.pickerResult != "") {
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "", Style.SNormal()),
                    px, fry, Gallery.T("Selected path:", "已选路径："),
                    app.theme.textPrimary, app.theme.fontSizeMedium);
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "secondary", Style.SNormal()),
                    px, fry + app.Scale(20), Ellipsis.Fit(Gallery.pickerResult, w - app.Scale(52), t.fontSizeMedium),
                    app.theme.textPrimary, app.theme.fontSizeMedium);
            } else {
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "secondary", Style.SNormal()),
                    px, fry, Gallery.T("No selection yet -- click a button to open a dialog.", "尚未选择 —— 点击按钮打开对话框。"),
                    app.theme.textPrimary, app.theme.fontSizeMedium);
            }
        } else if (name == "CodeEditor") {
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                px, py - app.Scale(12), "The code panel below is a read-only CodeEditor view.",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py + app.Scale(16), "CodeEditor powers this IDE's editor: highlighting,",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py + app.Scale(38), "line numbers, selection, completion and diagnostics.",
                app.theme.textPrimary, app.theme.fontSizeMedium);
        } else if (name == "ClickEvent") {
            Panel col = Panel.Column().Gap(app.Scale(10));
            col.With(Gallery.evtButton);
            col.With(new Label { Text = "Click fired on the UI thread · count: " + Convert.ToString(Gallery.evtClicks) });
            col.With(new Label { Text = "registered once with  button.Click += handler", Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(8),
                             w - app.Scale(36), app.Scale(120));
        } else if (name == "Events") {
            Panel col = Panel.Column().Gap(app.Scale(10));
            col.With(Gallery.evtStartButton);
            if (Gallery.evtRunning.Get()) {
                col.With(new Label { Text = "Ticks posted from worker thread: " + Convert.ToString(Gallery.evtValue.Get()) });
                col.With(new Label { Text = "running - app.Post marshals each tick to the UI thread", Class = "secondary" });
            } else {
                col.With(new Label { Text = "Ticks posted from worker thread: " + Convert.ToString(Gallery.evtValue.Get()) });
                col.With(new Label { Text = "idle - click to spawn a Thread that reports back safely", Class = "secondary" });
            }
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(8),
                             w - app.Scale(36), app.Scale(120));
        } else if (name == "Hmi.tags") {
            // The tag table itself: one simulated scan drives every column,
            // and the engineering text / percent / alarm state are all derived
            // from the same fixed-point raw counts.
            Gallery.HmiTick(app, x, y, w, h);
            int fs = t.fontSizeSmall;
            int c0 = px;
            int c1 = px + app.Scale(150);
            int c2 = px + app.Scale(250);
            int c3 = px + app.Scale(330);
            int c4 = px + app.Scale(410);
            int hy = py - app.Scale(10);
            c.DrawText(c0, hy, Gallery.T("Tag", "位号"), t.textTertiary, fs);
            c.DrawText(c1, hy, Gallery.T("Value", "工程值"), t.textTertiary, fs);
            c.DrawText(c2, hy, Gallery.T("Raw", "原始值"), t.textTertiary, fs);
            c.DrawText(c3, hy, Gallery.T("Percent", "量程 %"), t.textTertiary, fs);
            c.DrawText(c4, hy, Gallery.T("State", "状态"), t.textTertiary, fs);
            int ry = hy + app.Scale(22);
            c.DrawLine(px, ry - app.Scale(6), px + w - app.Scale(52),
                ry - app.Scale(6), t.divider, 1);
            for (int hi = 0; hi < Gallery.hmiIo.Count(); hi = hi + 1) {
                IoTag tg = Gallery.hmiIo.At(hi);
                int al = tg.Alarm();
                int vc = t.textPrimary;
                string stt = Gallery.T("normal", "正常");
                if (al == 1) { vc = t.info; stt = Gallery.T("LO alarm", "低报"); }
                if (al == 2) { vc = t.error; stt = Gallery.T("HI alarm", "高报"); }
                if (!tg.IsGood()) {
                    vc = t.textDisabled;
                    stt = Gallery.T("bad quality", "坏值");
                }
                c.DrawText(c0, ry, tg.Name(), t.textSecondary, fs);
                c.DrawText(c1, ry, tg.TextWithUnit(), vc, fs);
                c.DrawText(c2, ry, Convert.ToString(tg.Raw()), t.textSecondary, fs);
                c.DrawText(c3, ry, Convert.ToString(tg.Percent()) + " %",
                    t.textSecondary, fs);
                c.DrawText(c4, ry, stt, vc, fs);
                ry = ry + app.Scale(24);
            }
            c.DrawText(px, ry + app.Scale(14),
                Gallery.T("io.AlarmCount() = ", "io.AlarmCount() = ")
                    + Convert.ToString(Gallery.hmiIo.AlarmCount())
                    + Gallery.T("   ·   scan period ", "   ·   采集周期 ")
                    + Convert.ToString(Gallery.hmiIo.Period()) + " ms",
                t.textTertiary, fs);
        } else if (name == "Hmi.digital") {
            Gallery.HmiTick(app, x, y, w, h);
            Flex row = Flex.Wrapped().Gap(app.Scale(12));
            row.With(Gallery.hmiDigPv);
            row.With(Gallery.hmiDigSp);
            row.With(Gallery.hmiDigFlow);
            row.With(Gallery.hmiDigLevel);
            Gallery.LayoutAuto(app,
                Gallery.Captioned(app, row,
                    Gallery.T("Colour is the tag's alarm state; a bad tag reads \"----\".",
                        "颜色即位号的报警状态；坏值位号显示 \"----\"。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(120));
        } else if (name == "Hmi.led") {
            Gallery.HmiTick(app, x, y, w, h);
            Flex row = Flex.Wrapped().Gap(app.Scale(24));
            row.With(Gallery.hmiLedOff);
            row.With(Gallery.hmiLedRun);
            row.With(Gallery.hmiLedWarn);
            row.With(Gallery.hmiLedFault);
            row.With(Gallery.hmiLedComm);
            Panel ledCol = Gallery.Captioned(app, row,
                Gallery.T("States 0 off / 1 green / 2 yellow / 3 red / 4 blue; WARN and FAULT blink.",
                    "状态 0 灭 / 1 绿 / 2 黄 / 3 红 / 4 蓝；WARN 与 FAULT 闪烁。"));
            ledCol.With(Gallery.Caption(
                Gallery.T("COMM turns red while the simulated scan drops out.",
                    "模拟采集中断时 COMM 转红。")));
            Gallery.LayoutAuto(app, ledCol, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(110));
        } else if (name == "Hmi.gauge") {
            Gallery.HmiTick(app, x, y, w, h);
            Flex row = Flex.Wrapped().Gap(app.Scale(18));
            row.With(Gallery.hmiGaugePv);
            row.With(Gallery.hmiGaugeFlow);
            row.With(Gallery.hmiGaugeFree);
            Gallery.LayoutAuto(app,
                Gallery.Captioned(app, row,
                    Gallery.T("The arc is coloured by the tag's alarm limits; the needle follows the tag's alarm state and quality.",
                        "弧段按位号报警限着色；指针颜色跟随位号的报警状态与质量。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(250));
        } else if (name == "Hmi.bargraph") {
            Gallery.HmiTick(app, x, y, w, h);
            // 两根竖条一栏、横条一栏。棒图自己知道该多大（竖 64x180、
            // 横 220x40），所以两栏都不用给尺寸；横条那栏用原子类
            // `grow` 吃掉剩余宽度，宽度不再由这里算。
            Flex barRow = Flex.Wrapped().Gap(app.Scale(28));
            Panel barVert = Panel.Row().Gap(app.Scale(28));
            barVert.With(Gallery.hmiBarPv);
            barVert.With(Gallery.hmiBarFlow);
            Panel barLevel = Gallery.Captioned(app, Gallery.hmiBarLevel,
                Gallery.T("Bargraph.Horizontal() swaps the axis; the thin lines are the LO / HI limits.",
                    "Bargraph.Horizontal() 切换方向；细线是低报 / 高报限。"));
            barLevel.Class = "grow";
            barRow.With(barVert);
            barRow.With(barLevel);
            Gallery.LayoutAuto(app, barRow, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(220));
        } else if (name == "Hmi.trend") {
            // Live rolling trend: HmiTick samples all three pens on a 250 ms
            // beat into their ring buffers, so the window scrolls without the
            // preview holding any history of its own.
            Gallery.HmiTick(app, x, y, w, h);
            // 趋势图的高度是作者定的（它没有固有高度）：钉在控件上，
            // 外层那一列才能把它和说明文字一起量出来。
            Gallery.hmiTrend.Prefer(0, app.Scale(230));
            Gallery.LayoutAuto(app,
                Gallery.Captioned(app, Gallery.hmiTrend,
                    Gallery.T("Pens keep a fixed-capacity ring buffer, so a shift running for days costs no extra memory.",
                        "曲线使用定容环形缓冲，因此连续运行数天也不增长内存。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(280));
        } else if (name == "Hmi.alarmBanner") {
            Gallery.HmiTick(app, x, y, w, h);
            // 横幅、两个按钮、两行说明全部进控件树：按钮改成保留模式
            // 的 Click 事件（不再 Ui.Clicked 配手写坐标），说明文字用
            // caption 类的 Label，于是整块高度由测量得出。
            Panel abCol = Panel.Column().Gap(app.Scale(16));
            abCol.With(Gallery.hmiBanner);
            Flex abBtns = Flex.Wrapped().Gap(app.Scale(10));
            Button abWarn = new Button { Text = Gallery.T("Raise WARN", "产生警告") };
            abWarn.Prefer(app.Scale(150), 0);
            abWarn.Click += () => {
                Gallery.hmiAlarms.Raise("PT104",
                    Gallery.T("filter differential high", "过滤器压差高"), 1);
            };
            Button abFault = new Button { Text = Gallery.T("Raise FAULT", "产生故障"),
                Class = "error" };
            abFault.Prefer(app.Scale(150), 0);
            abFault.Click += () => {
                Gallery.hmiAlarms.Raise("M105",
                    Gallery.T("motor overload tripped", "电机过载跳闸"), 2);
            };
            abBtns.With(abWarn);
            abBtns.With(abFault);
            abCol.With(abBtns);
            abCol.With(Gallery.Caption(
                Gallery.T("Unacknowledged: ", "未确认：")
                    + Convert.ToString(Gallery.hmiAlarms.UnackedCount())
                    + Gallery.T("   ·   buffered: ", "   ·   缓冲：")
                    + Convert.ToString(Gallery.hmiAlarms.Count())));
            abCol.With(Gallery.Caption(
                Gallery.T("The banner blinks until acknowledged; its Ack button clears the whole buffer.",
                    "横幅在确认前持续闪烁；确认按钮一次清掉整个缓冲。")));
            Gallery.LayoutAuto(app, abCol, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(190));
        } else if (name == "Hmi.alarmList") {
            Gallery.HmiTick(app, x, y, w, h);
            AlarmItem sel = Gallery.hmiAlarmList.SelectedItem();
            string selTxt = Gallery.T("No row selected -- click one.",
                "尚未选中行 —— 点击任意一行。");
            if (sel != null) {
                selTxt = Gallery.T("Selected: ", "已选：") + sel.Point()
                    + "  " + sel.Message();
            }
            Gallery.hmiAlarmList.Prefer(0, app.Scale(200));
            Panel alCol = Gallery.Captioned(app, Gallery.hmiAlarmList, selTxt);
            alCol.With(Gallery.Caption(
                Gallery.T("Same AlarmBuffer as the banner demo, so an ack there shows up here.",
                    "与横幅示例共用同一个 AlarmBuffer，因此在那里确认这里同步生效。")));
            Gallery.LayoutAuto(app, alCol, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(270));
        } else if (name == "Hmi.numpad") {
            Gallery.HmiTick(app, x, y, w, h);
            // 键盘一栏、数显加三行说明一栏。两个控件都有固有尺寸
            // （键盘 200x260、数显 150x72），说明文字进树参与测量，
            // 右栏 grow 占满剩余宽度。
            Flex padRow = Flex.Wrapped().Gap(app.Scale(24));
            padRow.With(Gallery.hmiPad);
            Panel padSide = Panel.Column().Gap(app.Scale(10));
            padSide.Class = "grow";
            padSide.With(Gallery.hmiDigSp);
            padSide.With(Gallery.Caption(
                Gallery.T("Type a value, then ENT -- the keypad converts it to raw counts (scale 10) and writes TIC101.SV.",
                    "输入数值后按 ENT —— 键盘按刻度（10）换算成原始计数并写入 TIC101.SV。")));
            padSide.With(new Label {
                Text = Gallery.T("Entry buffer: ", "输入缓冲：") + "\""
                    + Gallery.hmiPad.Text() + "\"",
                Class = "hint" });
            padSide.With(Gallery.Caption(
                Gallery.T("The trend's SV pen follows every commit.",
                    "趋势图的 SV 曲线随每次写入变化。")));
            padRow.With(padSide);
            Gallery.LayoutAuto(app, padRow, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(290));
        } else if (name == "Hmi.equip") {
            Gallery.HmiTick(app, x, y, w, h);
            Gallery.LayoutAuto(app,
                Gallery.Captioned(app, Gallery.hmiWall,
                    Gallery.T("The panel is the container: it reflows its cards into as many columns as the width allows.",
                        "面板本身就是容器：按可用宽度把卡片重排成相应的列数。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(340));
        } else if (name == "Hmi.deviceCard") {
            Gallery.HmiTick(app, x, y, w, h);
            Gallery.hmiCard.Prefer(app.Scale(250), app.Scale(132));
            Panel notes = Panel.Column().Gap(app.Scale(8));
            notes.With(Gallery.Caption(
                Gallery.T("The status chip and the left colour bar cycle through the five states.",
                    "状态标签与左侧色条在五种状态间循环。")));
            notes.With(Gallery.Caption(
                Gallery.T("Value rows read their tags directly, so no per-card copy exists.",
                    "数值行直接读位号，因此卡片内没有值的副本。")));
            // 卡片在左、说明在右；窄窗口下说明整块折到卡片下面，
            // 而不是被右边缘切掉。
            Flex cardRow = Flex.Wrapped().Gap(app.Scale(18));
            cardRow.With(Gallery.hmiCard);
            cardRow.With(notes);
            Gallery.LayoutAuto(app, cardRow, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(150));
        } else if (name == "Button.tertiary") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Button { Text = "Default", Tertiary = true });
            row.With(new Button { Text = "Primary", Tertiary = true, Class = "primary" });
            row.With(new Button { Text = "Info",    Tertiary = true, Class = "info" });
            row.With(new Button { Text = "Success", Tertiary = true, Class = "success" });
            row.With(new Button { Text = "Warning", Tertiary = true, Class = "warning" });
            row.With(new Button { Text = "Error",   Tertiary = true, Class = "error" });
            Gallery.LayoutAuto(app, row, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(34));
        } else if (name == "Button.quaternary") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Button { Text = "Default", Quaternary = true });
            row.With(new Button { Text = "Primary", Quaternary = true, Class = "primary" });
            row.With(new Button { Text = "Info",    Quaternary = true, Class = "info" });
            row.With(new Button { Text = "Success", Quaternary = true, Class = "success" });
            row.With(new Button { Text = "Warning", Quaternary = true, Class = "warning" });
            row.With(new Button { Text = "Error",   Quaternary = true, Class = "error" });
            Gallery.LayoutAuto(app, row, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(34));
        } else if (name == "Button.color") {
            int brand = 0xFF1890FF;
            int warm = 0xFFFF7A45;
            int mint = 0xFF18A058;
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Button { Text = "Primary", Color = brand });
            row.With(new Button { Text = "Warm", Color = warm });
            row.With(new Button { Text = "Mint", Color = mint });
            row.With(new Button { Text = "Strong", Color = brand, Strong = true });
            Gallery.LayoutAuto(app, row, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(34));
        } else if (name == "Button.iconButton") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Button { Icon = "search", Class = "primary circle" });
            row.With(new Button { Icon = "edit", Class = "info circle" });
            row.With(new Button { Icon = "trash", Class = "error circle outline" });
            row.With(new Button { Icon = "download", Class = "success round" });
            row.With(new Button { Icon = "plus", Class = "circle", Tip = "Add" });
            Gallery.LayoutAuto(app, row, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(34));
        } else if (name == "Button.strong") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Button { Text = "Default" });
            row.With(new Button { Text = "Strong", Strong = true });
            row.With(new Button { Text = "Primary", Class = "primary" });
            row.With(new Button { Text = "Strong + Primary", Class = "primary",
                Strong = true });
            row.With(new Button { Text = "Tertiary + Strong", Tertiary = true,
                Strong = true });
            Gallery.LayoutAuto(app, row, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(34));
        } else if (name == "Button.events") {
            Button b = new Button { Text = "Click me", Class = "primary" };
            b.Click += () => {
                Gallery.evtClicks = Gallery.evtClicks + 1;
            };
            Panel col = Panel.Column().Gap(app.Scale(10));
            col.With(b);
            col.With(new Label {
                Text = "clicked " + Convert.ToString(Gallery.evtClicks)
                    + " time(s) -- Click is a UiEvent; On adds Enter/Leave/...",
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(84));
        } else if (name == "Button.popover") {
            // Hover tip rides the built-in Tip; the second button toggles an
            // anchored Tooltip.RenderBox to show the programmatic pattern.
            Button hoverB = new Button { Text = "Hover me",
                Tip = "Shown on hover after 900ms" };
            hoverB.Render(app, px, py - app.Scale(8), app.Scale(120));
            int pbx = px + app.Scale(140);
            Button popB = new Button { Text = "Toggle tip", Class = "primary" };
            popB.Click += () => {
                Gallery.popTipOn.Set(!Gallery.popTipOn.Get());
            };
            popB.Render(app, pbx, py - app.Scale(8), app.Scale(130));
            if (Gallery.popTipOn.Get()) {
                Tooltip.RenderBox(app, pbx, py - app.Scale(8), app.Scale(130),
                    t.heightMedium, "Toggled by click", 1, 0);
            }
        } else if (name == "Input.password") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Password", Gallery.demoPw,
                    Gallery.T("Masked with *; the trailing eye reveals it while keeping the caret.",
                        "以 * 掩码显示；尾端眼睛图标在保持光标的同时切回明文。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.size") {
            Panel col = Panel.Column().Gap(app.Scale(10));
            Panel r1 = Panel.Row().Gap(app.Scale(10));
            r1.With(new Label { Text = "Tiny" });
            r1.With(Gallery.demoTiny);
            Panel r2 = Panel.Row().Gap(app.Scale(10));
            r2.With(new Label { Text = "Small" });
            r2.With(Gallery.demoSmall);
            Panel r3 = Panel.Row().Gap(app.Scale(10));
            r3.With(new Label { Text = "Large" });
            r3.With(Gallery.demoLargeF);
            col.With(r1);
            col.With(r2);
            col.With(r3);
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34), app.Scale(420),
                app.Scale(150));
        } else if (name == "Input.clearable") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Clearable", Gallery.demoClr,
                    Gallery.T("Type something and stay focused: an X appears in the trailing slot.",
                        "输入内容并保持聚焦：尾端出现 X，点击清空。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.autoselect") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Autoselect", Gallery.demoAuto,
                    Gallery.T("Click away, then back in: everything is selected so typing replaces it all.",
                        "先点别处再点回来：内容全选，直接输入即整段替换。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.icons") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Icons", Gallery.demoIcons,
                    Gallery.T("iconLead / iconTrail reserve glyph slots so text never runs under them.",
                        "iconLead / iconTrail 预留图标槽位，文本不会滑到图标下面。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.disabled") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Label { Text = "Disabled" });
            row.With(Gallery.demoOff);
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(8), app.Scale(360),
                t.heightMedium);
        } else if (name == "Input.error") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Label { Text = "Email" });
            row.With(Gallery.demoErr);
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(8), app.Scale(360),
                t.heightMedium);
        } else if (name == "Input.slots") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Prefix / suffix", Gallery.demoSlot,
                    Gallery.T("Text slots live outside the edit area; PrefixIcon keeps the leading glyph.",
                        "文字槽在编辑区外；PrefixIcon 保留前端图标槽。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.loading") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Loading", Gallery.demoLoad,
                    Gallery.T("The trailing slot becomes a spinner while an async op runs.",
                        "异步进行时尾端槽位变转圈。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.count") {
            Panel colC = Panel.Column().Gap(app.Scale(10));
            colC.With(Gallery.FieldWithCaption(app, "Show count", Gallery.demoCount,
                Gallery.T("\"current / max\" under the box, right-aligned; the cap counts code points.",
                    "框下右对齐显示「当前 / 上限」；上限按码点计数。")));
            colC.With(Gallery.FieldWithCaption(app, "Count graphemes", Gallery.demoGraph,
