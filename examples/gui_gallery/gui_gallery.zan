                    ChartNode.Leaf(Gallery.T("Platform", "平台"), 60), ChartNode.Leaf(Gallery.T("Product", "产品"), 45), ChartNode.Leaf("QA", 30) }),
                ChartNode.Group("G&A", new List<ChartNode>{
