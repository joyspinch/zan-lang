            ma.color = Chart.Rgb(250, 200, 88);
            ChartOption cmd = ChartOption.Of(Gallery.T("AAPL daily", "AAPL 日线"), null,
                new List<ChartSeries>{ ChartSeries.OfCandles("AAPL", cs), ma });
            ChartView.KeyedStatic(cmd, 8152).Render(app, c0X, cY, halfW, cH);

            // A second, shorter ticker on the right half.
