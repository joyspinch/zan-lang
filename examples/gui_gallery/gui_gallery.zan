        } else if (name == "Chart.echarts_funnel") {
            // ECharts funnel：展现 → 点击 → 访问 → 咨询 → 订单，
            // 每个单值系列是一个阶段，逐级收窄。
            ChartOption cfu = ChartOption.Of(Gallery.T("转化分析", "转化分析"), null,
                new List<ChartSeries>{
                    ChartSeries.Funnel("展现", new List<int>{ 100 }),
                    ChartSeries.Funnel("点击", new List<int>{ 80 }),
                    ChartSeries.Funnel("访问", new List<int>{ 60 }),
                    ChartSeries.Funnel("咨询", new List<int>{ 40 }),
                    ChartSeries.Funnel("订单", new List<int>{ 20 })
                });
            ChartView.KeyedStatic(cfu, 8413).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));
        } else if (name == "Chart.echarts_rose") {
            // ECharts pie2 南丁格尔玫瑰图：角度均分、半径按值缩放
            // （radius 变体），扇区名沿用官方示例的 rose1..rose8。
            ChartOption cro = ChartOption.Of(Gallery.T("南丁格尔玫瑰图", "南丁格尔玫瑰图"), null,
                new List<ChartSeries>{
                    ChartSeries.Rose("rose1", new List<int>{ 10 }),
                    ChartSeries.Rose("rose2", new List<int>{ 5 }),
                    ChartSeries.Rose("rose3", new List<int>{ 15 }),
                    ChartSeries.Rose("rose4", new List<int>{ 25 }),
                    ChartSeries.Rose("rose5", new List<int>{ 20 }),
                    ChartSeries.Rose("rose6", new List<int>{ 35 }),
                    ChartSeries.Rose("rose7", new List<int>{ 30 }),
                    ChartSeries.Rose("rose8", new List<int>{ 40 })
                });
            ChartView.KeyedStatic(cro, 8414).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));
        } else if (name == "Chart.echarts_heatmap") {
            // ECharts heatmap：一周 × 24 小时活跃强度矩阵——每行一个
            // 系列（周一..周日），列由值索引决定；确定性伪数据，
            // 白天强、夜间弱，周末时段后移。单元格颜色不按行取色，
            // 而是 visualMap 式按值在 inRange 色带上插值
            // （#50a3ba → #eac736 → #d94e5d，与参考站一致）。
            List<string> hourLabels = new List<string>();
            for (int hh = 0; hh < 24; hh = hh + 1) {
                hourLabels.Add(Convert.ToString(hh));
            }
            List<string> dayNames = new List<string>{
                "周一", "周二", "周三", "周四", "周五", "周六", "周日" };
            List<ChartSeries> dayRows = new List<ChartSeries>();
            for (int dd = 0; dd < 7; dd = dd + 1) {
                List<int> rowVals = new List<int>();
                for (int hh = 0; hh < 24; hh = hh + 1) {
                    bool dayActive = dd >= 5 ? (hh >= 11 && hh <= 23)
                                             : (hh >= 9 && hh <= 21);
                    int amp = dayActive ? 60 : 12;
                    rowVals.Add(amp * (40 + (dd * 31 + hh * 17) % 60) / 100
                        + (dd * 13 + hh * 7) % 8);
                }
                dayRows.Add(ChartSeries.Of(dayNames[dd], ChartType.Heatmap, rowVals));
            }
            List<int> ramp = new List<int>{
                Chart.Rgb(80, 163, 186), Chart.Rgb(234, 199, 54),
                Chart.Rgb(217, 78, 93) };
            ChartOption chc = ChartOption.Of(Gallery.T("一周活跃强度", "一周活跃强度"),
                hourLabels, dayRows).VisualRange(0, 60, ramp);
            ChartView.KeyedStatic(chc, 8415).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));
        } else if (name == "Chart.echarts_wordcloud") {
            // ECharts wordcloud：搜索关键词权重云，字号随权重缩放。
            List<ChartData> kwData = new List<ChartData>{
                ChartData.Named(95, "大数据"),     ChartData.Named(88, "云计算"),
                ChartData.Named(82, "人工智能"),   ChartData.Named(74, "物联网"),
                ChartData.Named(70, "区块链"),     ChartData.Named(66, "深度学习"),
                ChartData.Named(60, "智能制造"),   ChartData.Named(55, "数字孪生"),
                ChartData.Named(52, "边缘计算"),   ChartData.Named(50, "5G"),
                ChartData.Named(46, "微服务"),     ChartData.Named(42, "数据中台"),
                ChartData.Named(38, "低代码"),     ChartData.Named(32, "DevOps"),
                ChartData.Named(28, "容器"),       ChartData.Named(22, "隐私计算")
            };
            ChartOption cwc = ChartOption.Of(Gallery.T("搜索关键词", "搜索关键词"), null,
                new List<ChartSeries>{ ChartSeries.WordCloud("关键词", kwData) });
            cwc.showLegend = false;
            ChartView.KeyedStatic(cwc, 8416).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));
        } else if (name == "Chart.echarts_treemap") {
