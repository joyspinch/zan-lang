        Gallery.demoQuoteNames.Add("NVDA");
        Gallery.demoQuotePrices.Add("192.60");
        Gallery.demoQuoteChanges.Add("+0.02");
        Gallery.demoQuoteNames.Add("TSLA");
        Gallery.demoQuotePrices.Add("439.69");
        Gallery.demoQuoteChanges.Add("+1.00");
