        } else if (name == "Chart.hbar") {
            // Horizontal bars: categories down the left, values across. A single
            // series reads as a ranked list (ECharts bar3).
            int cY = y + app.Scale(30);
            int cH = app.Scale(240);
            int halfW = (w - app.Scale(28) - app.Scale(12)) / 2;
            int c0X = x + app.Scale(14);
            int c1X = c0X + halfW + app.Scale(12);
            ChartOption ho = ChartOption.Of(Gallery.T("Page load (ms)", "页面加载（ms）"),
                new List<string>{ Gallery.T("Images", "图片"), Gallery.T("Scripts", "脚本"), Gallery.T("Styles", "样式"),
                                  Gallery.T("Fonts", "字体"), "HTML", "API" },
                new List<ChartSeries>{ ChartSeries.HBar(Gallery.T("Load", "加载"), new List<int>{ 240, 180, 120, 90, 60, 45 }) });
            ho.showValues = true;
            ChartView.KeyedStatic(ho, 8191).Render(app, c0X, cY, halfW, cH);

            // A second, horizontal STACK (ECharts bar4): series sharing a
            // stackName accumulate in one band, groups split each row.
            ChartSeries hA = ChartSeries.HBar(Gallery.T("Saving", "储蓄"), new List<int>{ 8, 12, 10, 14, 9, 15 });
            hA.stackName = "A";
            ChartSeries hB = ChartSeries.HBar(Gallery.T("Food", "食品"), new List<int>{ 20, 22, 24, 21, 25, 23 });
            hB.stackName = "A";
            ChartSeries hC = ChartSeries.HBar(Gallery.T("Rent", "房租"), new List<int>{ 30, 30, 32, 32, 34, 34 });
            hC.stackName = "A";
            ChartSeries hD = ChartSeries.HBar(Gallery.T("Fun", "娱乐"), new List<int>{ 10, 8, 12, 9, 11, 10 });
            hD.stackName = "A";
            ChartOption ho2 = ChartOption.Of(Gallery.T("Monthly spend (k$)", "月度支出（k$）"),
                new List<string>{ "Jan", "Feb", "Mar", "Apr", "May", "Jun" },
                new List<ChartSeries>{ hA, hB, hC, hD });
            ChartView.KeyedStatic(ho2, 8192).Render(app, c1X, cY, halfW, cH);
        } else if (name == "Chart.negpos") {
            // Positive and negative bars (ECharts bar5): the value axis auto
            // extends below 0 and bars hang from the zero baseline; per-item
            // colours split gains (green) from losses (red).
            int cY = y + app.Scale(30);
            int cH = app.Scale(240);
            int halfW = (w - app.Scale(28) - app.Scale(12)) / 2;
            int c0X = x + app.Scale(14);
            int c1X = c0X + halfW + app.Scale(12);
            List<string> np1 = new List<string>{ "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
            List<int> nv1 = new List<int>{ 5, 20, 36, 10, 10, -10, -20, -5, 8, 15, -12, 6 };
            ChartSeries nps = ChartSeries.Bar("Δ", nv1);
            ChartOption npo = ChartOption.Of(Gallery.T("Temperature delta (°C)", "温度变化（°C）"), np1,
                new List<ChartSeries>{ nps });
            ChartView.KeyedStatic(npo, 8201).Render(app, c0X, cY, halfW, cH);

            // Second card: per-bar green/red via ChartData.Colored (bar5 style).
            List<ChartData> nv2 = new List<ChartData>();
            nv2.Add(ChartData.Colored(40, Chart.Rgb(145, 204, 117)));
            nv2.Add(ChartData.Colored(-15, Chart.Rgb(238, 102, 102)));
            nv2.Add(ChartData.Colored(60, Chart.Rgb(145, 204, 117)));
            nv2.Add(ChartData.Colored(-30, Chart.Rgb(238, 102, 102)));
            nv2.Add(ChartData.Colored(25, Chart.Rgb(145, 204, 117)));
            nv2.Add(ChartData.Colored(-45, Chart.Rgb(238, 102, 102)));
            nv2.Add(ChartData.Colored(55, Chart.Rgb(145, 204, 117)));
            nv2.Add(ChartData.Colored(-20, Chart.Rgb(238, 102, 102)));
            ChartOption npo2 = ChartOption.Of(Gallery.T("P&L by quarter (k$)", "分季度盈亏（k$）"),
                new List<string>{ "Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7", "Q8" },
                new List<ChartSeries>{ ChartSeries.Named(Gallery.T("P&L", "盈亏"), ChartType.Bar, nv2) });
            ChartView.KeyedStatic(npo2, 8202).Render(app, c1X, cY, halfW, cH);
        } else if (name == "Chart.stackedmulti") {
            // Two independent stack groups side by side (ECharts bar12 stack):
            // each series carries a stackName; series sharing one group into a
            // column, different groups sit beside each other.
            int cY = y + app.Scale(30);
            int cH = app.Scale(240);
            int halfW = (w - app.Scale(28) - app.Scale(12)) / 2;
            int c0X = x + app.Scale(14);
            int c1X = c0X + halfW + app.Scale(12);
            ChartSeries bj1 = ChartSeries.StackedBar(Gallery.T("Food", "食品"), new List<int>{ 12, 15, 18, 14, 20 });
            bj1.stackName = "Beijing";
            ChartSeries bj2 = ChartSeries.StackedBar(Gallery.T("Transport", "交通"), new List<int>{ 8, 9, 11, 10, 12 });
            bj2.stackName = "Beijing";
            ChartSeries bj3 = ChartSeries.StackedBar(Gallery.T("Rent", "房租"), new List<int>{ 30, 30, 30, 32, 32 });
            bj3.stackName = "Beijing";
            ChartSeries sh1 = ChartSeries.StackedBar(Gallery.T("Food", "食品"), new List<int>{ 10, 12, 14, 11, 16 });
            sh1.stackName = "Shanghai";
            ChartSeries sh2 = ChartSeries.StackedBar(Gallery.T("Transport", "交通"), new List<int>{ 6, 7, 8, 9, 10 });
            sh2.stackName = "Shanghai";
            ChartSeries sh3 = ChartSeries.StackedBar(Gallery.T("Rent", "房租"), new List<int>{ 22, 22, 24, 24, 26 });
            sh3.stackName = "Shanghai";
            ChartOption sm = ChartOption.Of(Gallery.T("Monthly budget (k$) by city", "各城市月度预算（k$）"),
                new List<string>{ "Jan", "Feb", "Mar", "Apr", "May" },
                new List<ChartSeries>{ bj1, bj2, bj3, sh1, sh2, sh3 });
            ChartView.KeyedStatic(sm, 8193).Render(app, c0X, cY, halfW, cH);

            // A second multi-stack: quarterly revenue streams per region.
            ChartSeries ea = ChartSeries.StackedBar(Gallery.T("Hardware", "硬件"), new List<int>{ 90, 110, 95, 130 });
            ea.stackName = "EMEA";
            ChartSeries eb = ChartSeries.StackedBar(Gallery.T("Software", "软件"), new List<int>{ 60, 75, 82, 90 });
            eb.stackName = "EMEA";
            ChartSeries na = ChartSeries.StackedBar(Gallery.T("Hardware", "硬件"), new List<int>{ 120, 105, 135, 118 });
            na.stackName = "NAM";
            ChartSeries nb = ChartSeries.StackedBar(Gallery.T("Software", "软件"), new List<int>{ 95, 108, 88, 122 });
            nb.stackName = "NAM";
            ChartOption sm2 = ChartOption.Of(Gallery.T("Revenue (k$) by region", "各区域营收（k$）"),
                new List<string>{ "Q1", "Q2", "Q3", "Q4" },
                new List<ChartSeries>{ ea, eb, na, nb });
            ChartView.KeyedStatic(sm2, 8194).Render(app, c1X, cY, halfW, cH);
        } else if (name == "Chart.rainbow") {
            // One series whose bars each carry their own colour via
            // ChartData.Colored -- the data-item level of ECharts' three-level
            // colour control (option < series < data item).
            int cY = y + app.Scale(30);
            int cH = app.Scale(240);
            int halfW = (w - app.Scale(28) - app.Scale(12)) / 2;
            int c0X = x + app.Scale(14);
            int c1X = c0X + halfW + app.Scale(12);
            List<ChartData> rd = new List<ChartData>();
            rd.Add(ChartData.Colored(64, Chart.Rgb(229, 115, 115)));
            rd.Add(ChartData.Colored(52, Chart.Rgb(229, 160, 104)));
            rd.Add(ChartData.Colored(61, Chart.Rgb(242, 203, 93)));
            rd.Add(ChartData.Colored(73, Chart.Rgb(119, 200, 116)));
            rd.Add(ChartData.Colored(58, Chart.Rgb(89, 176, 209)));
            rd.Add(ChartData.Colored(68, Chart.Rgb(147, 137, 211)));
            rd.Add(ChartData.Colored(46, Chart.Rgb(205, 132, 175)));
            ChartOption rb = ChartOption.Of(Gallery.T("Weekly activity score", "每周活跃得分"),
                new List<string>{ Gallery.T("Mon", "周一"), Gallery.T("Tue", "周二"), Gallery.T("Wed", "周三"),
                                  Gallery.T("Thu", "周四"), Gallery.T("Fri", "周五"), Gallery.T("Sat", "周六"),
                                  Gallery.T("Sun", "周日") },
                new List<ChartSeries>{ ChartSeries.Named(Gallery.T("Score", "得分"), ChartType.Bar, rd) });
            ChartView.KeyedStatic(rb, 8195).Render(app, c0X, cY, halfW, cH);

            // A second rainbow set: Q-series revenue buckets.
            List<ChartData> rd2 = new List<ChartData>();
            rd2.Add(ChartData.Colored(120, Chart.Rgb(229, 115, 115)));
            rd2.Add(ChartData.Colored(86, Chart.Rgb(229, 160, 104)));
            rd2.Add(ChartData.Colored(102, Chart.Rgb(242, 203, 93)));
            rd2.Add(ChartData.Colored(148, Chart.Rgb(119, 200, 116)));
            ChartOption rb2 = ChartOption.Of(Gallery.T("Revenue by product line (k$)", "各产品线营收（k$）"),
                new List<string>{ "A", "B", "C", "D" },
                new List<ChartSeries>{ ChartSeries.Named(Gallery.T("Revenue", "营收"), ChartType.Bar, rd2) });
            ChartView.KeyedStatic(rb2, 8196).Render(app, c1X, cY, halfW, cH);
        } else if (name == "Chart.mix") {
            // Mixed series types in one option: a line with a scatter overlay
            // reads as trend + outliers; bars with a line combine a breakdown
            // with an overall trend (ECharts mix4).
            int cY = y + app.Scale(30);
            int cH = app.Scale(240);
            int halfW = (w - app.Scale(28) - app.Scale(12)) / 2;
            int c0X = x + app.Scale(14);
            int c1X = c0X + halfW + app.Scale(12);
            ChartOption mx = ChartOption.Of(Gallery.T("Sensor readings", "传感器读数"),
                new List<string>{ "00", "01", "02", "03", "04", "05", "06", "07" },
                new List<ChartSeries>{
                    ChartSeries.Line(Gallery.T("Baseline", "基线"), new List<int>{ 22, 24, 23, 26, 25, 28, 27, 30 }),
                    ChartSeries.OfPoints(Gallery.T("Spikes", "尖峰"), new List<ChartPoint>{
                        ChartPoint.Of(0, 22), ChartPoint.Of(1, 24), ChartPoint.Of(2, 44), ChartPoint.Of(3, 26),
                        ChartPoint.Of(4, 25), ChartPoint.Of(5, 50), ChartPoint.Of(6, 27), ChartPoint.Of(7, 30)
                    })
                });
            ChartView.KeyedStatic(mx, 8197).Render(app, c0X, cY, halfW, cH);

            // A second mix: monthly sales bars + a 3-month moving-average line.
            List<string> ml = new List<string>();
            List<int> sales = new List<int>();
            List<int> mavg = new List<int>();
            for (int mi2 = 0; mi2 < 12; mi2 = mi2 + 1) {
                ml.Add("M" + Convert.ToString(mi2 + 1));
                sales.Add(80 + (mi2 * 7) % 40);
                int s0 = 80 + (mi2 * 7) % 40;
                int s1 = 80 + ((mi2 - 1) * 7) % 40;
                int s2 = 80 + ((mi2 - 2) * 7) % 40;
                int s3 = 80 + ((mi2 - 3) * 7) % 40;
                if (mi2 < 1) { s1 = s0; s2 = s0; s3 = s0; }
                if (mi2 < 2) { s2 = s0; s3 = s0; }
                if (mi2 < 3) { s3 = s0; }
                mavg.Add((s0 + s1 + s2 + s3) / 4);
            }
            ChartSeries bms = ChartSeries.Bar(Gallery.T("Sales", "销售额"), sales);
            ChartSeries mls = ChartSeries.Line("MA4", mavg);
            mls.color = Chart.Rgb(250, 200, 88);
            ChartOption mx2 = ChartOption.Of(Gallery.T("Monthly sales + MA4", "月度销售 + 4 期均线"), ml,
                new List<ChartSeries>{ bms, mls });
            ChartView.KeyedStatic(mx2, 8198).Render(app, c1X, cY, halfW, cH);
        } else if (name == "Chart.dynamic") {
            // Live-updating series (ECharts dynamicLineBar): the data window
            // slides on a wall-clock beat and the card re-arms a throttled
            // animation frame each paint, so the line and bars scroll smoothly
            // with no timer thread. The bars share the line's axis, exactly
            // like the ECharts reference.
            int nowMs = Window.GetTickMs();
            int ph = nowMs / 120;
            Gallery.dynPhase = ph;
            int cY = y + app.Scale(30);
            int cH = app.Scale(240);
            int halfW = (w - app.Scale(28) - app.Scale(12)) / 2;
            int c0X = x + app.Scale(14);
            int c1X = c0X + halfW + app.Scale(12);
            List<string> dl = new List<string>();
            List<int> dline = new List<int>();
            List<int> dbar = new List<int>();
            for (int dd = 0; dd < 20; dd = dd + 1) {
                dl.Add("T" + Convert.ToString(dd + 1));
                int wl = ChartView.SinDeg((ph + dd * 7) % 360) * 30 / 1000;
                dline.Add(55 + (dd * 3) % 25 + wl);
                int wb = ChartView.SinDeg((ph * 2 + dd * 11) % 360) * 20 / 1000;
                dbar.Add(25 + (dd * 5) % 30 + wb);
            }
            ChartOption dy = ChartOption.Of(Gallery.T("Live signal (rolling 20)", "实时信号（滚动 20）"), dl,
                new List<ChartSeries>{
                    ChartSeries.Line(Gallery.T("Trend", "趋势"), dline),
                    ChartSeries.Bar(Gallery.T("Volume", "成交量"), dbar)
                });
            dy.smooth = true;
            ChartView.KeyedStatic(dy, 8199).Render(app, c0X, cY, halfW, cH);

            // Second card: two live curves (CPU vs memory) sweeping the same
            // window, the classic dynamic-data look.
            List<string> d2 = new List<string>();
            List<int> cpu = new List<int>();
            List<int> mem = new List<int>();
            for (int ddi = 0; ddi < 16; ddi = ddi + 1) {
                d2.Add("s" + Convert.ToString(ddi + 1));
                int wc = ChartView.SinDeg((ph + ddi * 5) % 360) * 22 / 1000;
                cpu.Add(45 + (ddi * 2) % 20 + wc);
                int wm = ChartView.SinDeg((ph * 3 + ddi * 9) % 360) * 12 / 1000;
                mem.Add(60 + (ddi * 3) % 15 + wm);
            }
            ChartOption dy2 = ChartOption.Of(Gallery.T("CPU / memory", "CPU / 内存"), d2,
                new List<ChartSeries>{
                    ChartSeries.Line("CPU %", cpu),
                    ChartSeries.Line(Gallery.T("Mem %", "内存 %"), mem)
                });
            dy2.smooth = true;
            ChartView.KeyedStatic(dy2, 8200).Render(app, c1X, cY, halfW, cH);

            // Keep the demo animating at ~30fps: RequestAnimationFrame re-arms
            // the next throttled frame instead of busy-looping the compositor.
            app.RequestAnimationFrame(33);
        } else if (name == "Chart.performance") {
            // 性能演示：左侧 96x48=4608-cell 热力图走区域缓存
            // (RenderCached) —— 首帧全量光栅化 + 快照，之后每帧一次像素
            // 拷贝恢复，成本与点位数量无关；右侧三个动态迷你图同时滚动，
            // 由同一个 RequestAnimationFrame 统一驱动。底部状态行用
            // Canvas.RasterStat 展示每帧光栅化调用数，佐证缓存生效。
            int cY = y + app.Scale(30);
            int halfW = (w - app.Scale(28) - app.Scale(12)) / 2;
            int c0X = x + app.Scale(14);
            int c1X = c0X + halfW + app.Scale(12);
            int heatH = app.Scale(150);
            // --- 左：缓存热力图（96 列 x 48 行，数据静态只建一次）---
            if (Gallery.perfHeat == null) {
                List<ChartSeries> hsr = new List<ChartSeries>();
                for (int hrow = 0; hrow < 48; hrow = hrow + 1) {
                    List<ChartData> hv = new List<ChartData>();
                    for (int hcol = 0; hcol < 96; hcol = hcol + 1) {
                        int wv = ChartView.SinDeg((hrow * 3 + hcol * 2) % 360);
                        hv.Add(ChartData.Of(40 + wv * 40 / 1000 + (hrow * hcol) % 30));
                    }
                    hsr.Add(ChartSeries.Named("R" + Convert.ToString(hrow + 1),
                        ChartType.Heatmap, hv));
                }
                ChartOption hmp = ChartOption.Of(Gallery.T("Heatmap 96x48 (cached)", "热力图 96x48（已缓存）"), null, hsr);
                hmp.animate = false;
                Gallery.perfHeat = hmp;
                Gallery.perfHeatSlot = ChartView.AllocCacheSlot();
            }
            ChartView.RenderCached(app, Gallery.perfHeat, Gallery.perfHeatSlot,
                c0X, cY, halfW, heatH);
            ChartView.HeatmapHover(app, c0X, cY, halfW, heatH, Gallery.perfHeat);
            // --- 右：三个动态迷你图（line / bar / area）同时滚动 ---
            int ph = Window.GetTickMs() / 120;
            int dynW = halfW;
            int dynH = app.Scale(58);
            for (int dcol = 0; dcol < 3; dcol = dcol + 1) {
                List<string> dl2 = new List<string>();
                List<int> dv = new List<int>();
                for (int dp = 0; dp < 12; dp = dp + 1) {
                    dl2.Add("t" + Convert.ToString(dp + 1));
                    int wb = ChartView.SinDeg((ph * (5 + dcol * 2) + dp * 29) % 360) * 28 / 1000;
                    dv.Add(40 + (dp * (7 + dcol * 3)) % 30 + wb);
                }
                ChartOption dmo = ChartOption.Of(dcol == 0 ? Gallery.T("Line", "折线") : (dcol == 1 ? Gallery.T("Bars", "柱状") : Gallery.T("Area", "面积")),
                    dl2, new List<ChartSeries>{
                        dcol == 0 ? ChartSeries.Line("v", dv)
                            : (dcol == 1 ? ChartSeries.Bar("v", dv)
                                         : ChartSeries.Area("v", dv))
                    });
                dmo.smooth = true;
                ChartView.KeyedStatic(dmo, 8203 + dcol).Render(app, c1X,
                    cY + dcol * (dynH + app.Scale(6)), dynW, dynH);
            }
            app.RequestAnimationFrame(33);
            // --- 底部：每帧光栅化统计（rounded-rect 调用 / restore 调用 / restore 像素）---
            int stY = cY + heatH + app.Scale(12);
            int rCalls = Canvas.RasterStat(3, 0);
            int rsCalls = Canvas.RasterStat(9, 0);
            int rsPx = Canvas.RasterStat(9, 1);
            string stat = Gallery.T("raster: ", "光栅化: ") + Convert.ToString(rCalls) + Gallery.T(" rounded, ", " 圆角, ")
                + Convert.ToString(rsCalls) + Gallery.T(" restores, ", " 恢复, ")
                + Convert.ToString(rsPx) + "K " + Gallery.T("restore px", "恢复像素");
            c.DrawText(c0X, stY, stat, t.textTertiary, t.fontSizeSmall);
        } else if (name == "Chart.big10k") {
            // 大数据演示 1：10,000 点。ChartBig 首帧把每个系列降采样为每
            // 绘图像素一列的 min/max 包络（缓存进 ChartState），之后每帧
            // 只花 O(绘图宽度) 重画 —— 点数与帧成本解耦。左卡线 + 渐变
            // 面积（Area 系列标记），右卡单线（另一波形 / 配色）。
            if (Gallery.big10kStateA == null) {
                Gallery.big10kStateA = new ChartState();
                Gallery.big10kA = BigSeriesSource.Of(
                    Gallery.BigWave(10000, 11, 520, 220),
                    Gallery.T("wave A", "波 A"), Chart.Palette(t, 0), 0);
                Gallery.big10kStateB = new ChartState();
                Gallery.big10kB = BigSeriesSource.Of(
                    Gallery.BigWave(10000, 37, 540, 180),
                    Gallery.T("wave B", "波 B"), Chart.Palette(t, 2), 0);
            }
            int bY = y + app.Scale(30);
            int bH = app.Scale(240);
            int halfW = (w - app.Scale(28) - app.Scale(12)) / 2;
            int b0X = x + app.Scale(14);
            int b1X = b0X + halfW + app.Scale(12);
            ChartOption bo1 = ChartOption.Create();
            bo1.animate = false;
            bo1.series = new List<ChartSeries>{ ChartSeries.Area("", new List<int>{ 0 }) };
            ChartBig.Render(app, Gallery.big10kStateA, Gallery.big10kA, bo1,
                b0X, bY, halfW, bH,
                Gallery.T("10,000 points (line + area)", "10,000 点（线 + 面积）"));
            ChartOption bo2 = ChartOption.Create();
            bo2.animate = false;
            bo2.series = new List<ChartSeries>{ ChartSeries.Line("", new List<int>{ 0 }) };
            ChartBig.Render(app, Gallery.big10kStateB, Gallery.big10kB, bo2,
                b1X, bY, halfW, bH,
                Gallery.T("10,000 points (line)", "10,000 点（线）"));
        } else if (name == "Chart.big100k") {
            // 大数据演示 2：100,000 点，全宽。源是裸 List<int>（BigSeries
            // Source，零逐点对象），首帧 O(n) 构建包络后每帧 O(宽度)。
            // 右下角角标由 ChartBig 自动打印总点数。
            if (Gallery.big100kState == null) {
                Gallery.big100kState = new ChartState();
                Gallery.big100kA = BigSeriesSource.Of(
                    Gallery.BigWave(100000, 53, 520, 230),
                    Gallery.T("telemetry", "遥测"), Chart.Palette(t, 4), 0);
            }
            ChartOption bo3 = ChartOption.Create();
            bo3.animate = false;
            bo3.series = new List<ChartSeries>{ ChartSeries.Area("", new List<int>{ 0 }) };
            ChartBig.Render(app, Gallery.big100kState, Gallery.big100kA, bo3,
                x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(240),
                Gallery.T("100,000 points (decimated)", "100,000 点（降采样）"));
        } else if (name == "Chart.bigdynamic") {
            // 大数据演示 3：动态。两条 8,000 点窗口在 20,000 点环形缓冲上
            // 滚动 —— Roll() 只推进偏移量，零数据拷贝；ChartState.Invalidate
            // 让下一帧按新窗口重建包络（每帧 O(窗口)），折线平滑前移。
            if (Gallery.bigDynStateA == null) {
                Gallery.bigDynStateA = new ChartState();
                Gallery.bigDynA = BigSeriesSource.Of(
                    Gallery.BigWave(20000, 71, 520, 220),
                    Gallery.T("live A", "实时 A"), Chart.Palette(t, 5), 8000);
                Gallery.bigDynStateB = new ChartState();
                Gallery.bigDynB = BigSeriesSource.Of(
                    Gallery.BigWave(20000, 89, 540, 190),
                    Gallery.T("live B", "实时 B"), Chart.Palette(t, 1), 8000);
            }
            Gallery.bigDynA.Roll();
            Gallery.bigDynB.Roll();
            Gallery.bigDynStateA.Invalidate();
            Gallery.bigDynStateB.Invalidate();
            int dY = y + app.Scale(30);
            int dH = app.Scale(240);
            int halfW = (w - app.Scale(28) - app.Scale(12)) / 2;
            int d0X = x + app.Scale(14);
            int d1X = d0X + halfW + app.Scale(12);
            ChartOption bd1 = ChartOption.Create();
            bd1.animate = false;
            bd1.series = new List<ChartSeries>{ ChartSeries.Line("", new List<int>{ 0 }) };
            ChartBig.Render(app, Gallery.bigDynStateA, Gallery.bigDynA, bd1,
                d0X, dY, halfW, dH,
                Gallery.T("8,000-point rolling window", "8,000 点滚动窗口"));
            ChartOption bd2 = ChartOption.Create();
            bd2.animate = false;
            bd2.series = new List<ChartSeries>{ ChartSeries.Line("", new List<int>{ 0 }) };
            ChartBig.Render(app, Gallery.bigDynStateB, Gallery.bigDynB, bd2,
                d1X, dY, halfW, dH,
                Gallery.T("8,000-point rolling window", "8,000 点滚动窗口"));
            app.RequestAnimationFrame(33);
        // ---- ECharts 示例还原系列（数据与配置对照官方 gallery 同名示例）----
        } else if (name == "Chart.markpoint") {
            // ECharts line1：五系列折线 + 自动 markPoint(max/min) + 均值 markLine。
            // 五个图例项在窄卡上换行到标题下方，验证图例避让。
            List<string> wk = new List<string>{
                "周一", "周二", "周三", "周四", "周五", "周六", "周日" };
            ChartOption cm = ChartOption.Of(Gallery.T("一周流量来源", "一周流量来源"),
                wk, new List<ChartSeries>{
                    ChartSeries.Line("邮件营销", new List<int>{ 120, 132, 101, 134, 90, 230, 210 }),
                    ChartSeries.Line("联盟广告", new List<int>{ 220, 182, 191, 234, 290, 330, 310 }),
                    ChartSeries.Line("视频广告", new List<int>{ 150, 232, 201, 154, 190, 330, 410 }),
                    ChartSeries.Line("直接访问", new List<int>{ 320, 332, 301, 334, 390, 330, 320 }),
                    ChartSeries.Line("搜索引擎", new List<int>{ 820, 932, 901, 934, 1290, 1330, 1320 })
                });
            cm.markPoint = true;
            cm.markLine = 408;
            cm.markLabel = Gallery.T("平均 408", "平均 408");
            ChartView.KeyedStatic(cm, 8401).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(240));
        } else if (name == "Chart.bar_classic") {
            // ECharts bar1：蒸发量 / 降水量分组柱状 + 标注标线。
            List<string> mo = new List<string>{
                "1月", "2月", "3月", "4月", "5月", "6月",
                "7月", "8月", "9月", "10月", "11月", "12月" };
            ChartOption cbm = ChartOption.Of(Gallery.T("蒸发量与降水量", "蒸发量与降水量"),
                mo, new List<ChartSeries>{
                    ChartSeries.Bar(Gallery.T("蒸发量", "蒸发量"),
                        new List<int>{ 2, 5, 8, 23, 26, 77, 136, 162, 33, 20, 6, 3 }),
                    ChartSeries.Bar(Gallery.T("降水量", "降水量"),
                        new List<int>{ 3, 6, 9, 26, 29, 71, 176, 182, 49, 19, 6, 2 })
                });
            cbm.markPoint = true;
            cbm.markLine = 60;
            cbm.markLabel = Gallery.T("月均 60", "月均 60");
            ChartView.KeyedStatic(cbm, 8402).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(240));
        } else if (name == "Chart.pie_classic") {
            // ECharts pie1：访问来源标准饼图，具名数据项驱动。
            List<ChartData> pd = new List<ChartData>{
                ChartData.Named(235, "视频广告"),
                ChartData.Named(274, "联盟广告"),
                ChartData.Named(310, "邮件营销"),
                ChartData.Named(335, "直接访问"),
                ChartData.Named(400, "搜索引擎")
            };
            ChartOption cpm = ChartOption.Single(
                ChartSeries.Named(Gallery.T("访问来源", "访问来源"), ChartType.Pie, pd));
            cpm.pieLabels = true;
            cpm.donutPct = 0;   // pie1 是实心标准饼图（默认 55% 会变成环图）
            ChartView.KeyedStatic(cpm, 8403).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(240));
        } else if (name == "Chart.pie_nested") {
            // ECharts pie3 / 千层饼：内环来源、外环细分，各环独立总计。
            List<ChartData> innerD = new List<ChartData>{
                ChartData.Named(335, "直接访问"), ChartData.Named(310, "邮件营销"),
                ChartData.Named(234, "联盟广告"), ChartData.Named(135, "视频广告"),
                ChartData.Named(1548, "搜索引擎")
            };
            List<ChartData> outerD = new List<ChartData>{
                ChartData.Named(335, "直达"), ChartData.Named(310, "邮件营销"),
                ChartData.Named(234, "联盟广告"), ChartData.Named(135, "视频广告"),
                ChartData.Named(1048, "百度"), ChartData.Named(251, "谷歌"),
                ChartData.Named(147, "必应"), ChartData.Named(102, "其他")
            };
            ChartOption cnm = ChartOption.OfRings(
                Gallery.T("访问来源（嵌套）", "访问来源（嵌套）"),
                new List<ChartSeries>{
                    // 环序从外到内：细分（8 项）在外环，来源（5 类）在内环。
                    ChartSeries.Named(Gallery.T("细分", "细分"), ChartType.Pie, outerD),
                    ChartSeries.Named(Gallery.T("来源", "来源"), ChartType.Pie, innerD)
                });
            cnm.showLegend = false;
            // 内环小孔（千层饼观感）；渲染器会把过大的孔钳回环带内。
            cnm.series[1].innerPct = 22;
            ChartView.KeyedStatic(cnm, 8404).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(240));
        } else if (name == "Chart.chord_web") {
            // ECharts chord：节点弧按流量合计分宽，缎带粗细随链接值。
            List<ChartLink> cl = new List<ChartLink>{
                ChartLink.Of("搜索引擎", "首页", 400),
                ChartLink.Of("搜索引擎", "商品页", 350),
                ChartLink.Of("直接访问", "首页", 300),
                ChartLink.Of("直接访问", "商品页", 180),
                ChartLink.Of("外部链接", "博客", 220),
                ChartLink.Of("社交媒体", "博客", 160),
                ChartLink.Of("邮件营销", "商品页", 120),
                ChartLink.Of("外部链接", "帮助", 90)
            };
            ChartOption ccm = ChartOption.Single(
                ChartSeries.Chord(Gallery.T("流量来源 → 页面", "流量来源 → 页面"), cl));
            ChartView.KeyedStatic(ccm, 8405).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(250));
        } else if (name == "Chart.force_net") {
            // ECharts force：树状关系网络径向展开，边宽随链接值。
            List<ChartLink> fl = new List<ChartLink>{
                ChartLink.Of("网关", "温度传感器", 10),
                ChartLink.Of("网关", "湿度传感器", 8),
                ChartLink.Of("网关", "光照传感器", 12),
                ChartLink.Of("网关", "摄像头", 9),
                ChartLink.Of("温度传感器", "客厅", 4),
                ChartLink.Of("温度传感器", "卧室", 3),
