    /// 模板模式演示行：行是任意控件子树（这里是一行三个
    /// Label 的 Panel.Row），只在进入视口时才会被构建。
    static Control QuoteRow(int qi) {
        Panel row = Panel.Row();
        row.Padding(0, 12, 0, 12);
        row.Gap(14);
        row.With(new Label(Gallery.demoQuoteNames[qi]));
        Label px = new Label(Gallery.demoQuotePrices[qi]);
        px.Class = "secondary";
        row.With(px);
        Label ch = new Label(Gallery.demoQuoteChanges[qi]);
        ch.Class = "secondary";
        row.With(ch);
        return row;
    }

    static void Main() {
        App app = App.CreateDark("Zan GUI Components", 1120, 720);
        // 损伤区重绘（默认关，见 App.SetPartialFrames）。开着它，动画帧
        // 只重画自己声明的那一块，而不是每 60ms 把 1702x1136 的整窗在
        // CPU 上重新光栅一遍 —— 后者是 HMI 各页 CPU 高的全部原因。
        // 用 ZAN_GALLERY_FULLFRAMES=1 可以关掉，用来对比排查残影。
        app.SetPartialFrames(UiDriver.Env("ZAN_GALLERY_FULLFRAMES") != "1");
        Gallery.ringDump = UiDriver.Env("ZAN_CANVAS_RING") != "";
        Gallery.audit = UiDriver.Env("ZAN_GALLERY_AUDIT") == "1";
        Gallery.auditSeen = new Dictionary<string, string>();
        // App-level CSS: brand classes the demos use, layered over the skin.
