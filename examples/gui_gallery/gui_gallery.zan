            QrCode qr = Gallery.demoQr;
            qr.Text = Gallery.model.qrText;
            qr.Ecl = Gallery.model.qrEcl;
            qr.Logo = Gallery.model.qrLogo
                ? Gallery.PhotoAsset("carousel1.jpeg") : "";
            qr.Size = Gallery.model.qrPx;
            Gallery.demoQrEclBtn.Text = "Ecl: " + Gallery.model.qrEcl;
            Gallery.demoQrLogoBtn.Text = Gallery.model.qrLogo
                ? Gallery.T("Logo: on", "Logo：开")
                : Gallery.T("Logo: off", "Logo：关");
            QrMatrix qmx = qr.Matrix();
            string qe = "L";
            if ((int)qmx.ecl == 1) { qe = "M"; }
            if ((int)qmx.ecl == 2) { qe = "Q"; }
            if ((int)qmx.ecl == 3) { qe = "H"; }
            Gallery.demoQrInfo.Text = "v" + Convert.ToString(qmx.version)
                + " · " + Convert.ToString(qmx.size) + "x"
                + Convert.ToString(qmx.size) + " modules · " + qe
                + " · " + Convert.ToString(Gallery.model.qrPx) + "px";
            Panel qcol = Panel.Column().Gap(app.Scale(10));
            Panel qtop = Panel.Row().Gap(app.Scale(8));
            qtop.With(Gallery.demoQrText);
            qcol.With(qtop);
            Panel qrow = Panel.Row().Gap(app.Scale(20));
            qrow.With(qr);
            Panel qbtns = Panel.Column().Gap(app.Scale(8));
            qbtns.With(Gallery.demoQrEclBtn);
            qbtns.With(Gallery.demoQrLogoBtn);
            Panel qsz = Panel.Row().Gap(app.Scale(8));
            qsz.With(Gallery.demoQrMinus);
            qsz.With(Gallery.demoQrPlus);
            qbtns.With(qsz);
            qrow.With(qbtns);
            qcol.With(qrow);
            qcol.With(Gallery.demoQrInfo);
            Gallery.LayoutAuto(app, qcol, name, px, py,
                             w - app.Scale(36), app.Scale(304));
        } else if (name == "QrCode.levels") {
            Flex lrow = Flex.Wrapped().Gap(app.Scale(20));
