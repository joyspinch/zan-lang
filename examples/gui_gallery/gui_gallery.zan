/// Zan GUI component gallery.
using System;
using System.Threading;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;
using Gui.Component.Chart;
using Gui.Component.CodeEditor;
using Gui.Component.DataTable;
using Gui.Designer;
using Gui.Hmi;

// Zan GUI component gallery.
//
// A NaiveUI-style component showcase: a scrollable component navigation on the
// left, and a detail pane on the right with a short description, a live preview
// of the component's real states, and a copyable code snippet showing the exact
// current API. Click "Copy" to place the snippet on the clipboard.
//
// Run it from the IDE (Run / F5) or:
//   zanc --emit-ir examples/gui_gallery/gui_gallery.zan > gallery.ll
//   clang gallery.ll -o gallery <gui link args>

/// Virtual data source for the large-data DataTable demo.
///
/// Cells are generated on demand from their (row, col) coordinates, so the
/// source stores NO per-cell data — memory is O(1) in the row count. A real
/// app would instead read these from columnar typed arrays, a file, or a DB.
class BigDataSource : DataSource {
    int rowCount;
    int colCount;

    BigDataSource(int rows, int cols) {
        this.rowCount = rows;
        this.colCount = cols;
    }

    override int RowCount() { return this.rowCount; }

    override int CellNum(int row, int col) {
        return ((row + col * 13) % 97) * 37 % 1000;
    }

    override string CellText(int row, int col) {
        if (col == 0) { return "Row " + Convert.ToString(row + 1); }
        return Convert.ToString(((row + col * 13) % 97) * 37 % 1000);
    }
}

/// Appearance hook for the DataTable demo. Zan delegates can't capture locals,
/// so a styler is a subclass rather than a lambda: it reads the row it is asked
/// about straight from the source. Here, under-performers are tinted, the Score
/// column is coloured by band, and the City column is painted by hand.
class ScoreStyler : CellStyler {
    // Resolved from field names by Bind() rather than hard-coded, so the
    // styler keeps working if the columns are reordered.
    int scoreCol;
    int cityCol;

    /// Look the columns this styler cares about up by name. Called once per
    /// frame before the table renders, since the demo rebuilds its columns.
    void Bind(List<DataColumn> cols) {
        scoreCol = DataTable.Col(cols, "score");
        cityCol = DataTable.Col(cols, "city");
    }

    override int RowBg(DataSource src, int row) {
        // A failing score tints the whole row, so it is visible even when the
        // Score column has been scrolled out of view.
        if (scoreCol < 0) { return 0; }
        if (DataTable.ParseInt(src.CellText(row, scoreCol)) < 80) { return DataTable.Rgb(255, 240, 240); }
        return 0;
    }

    override int CellFg(DataSource src, int row, int col) {
        if (col != scoreCol || scoreCol < 0) { return 0; }
        int v = DataTable.ParseInt(src.CellText(row, scoreCol));
        if (v >= 90) { return DataTable.Rgb(21, 128, 61); }
        if (v < 80) { return DataTable.Rgb(185, 28, 28); }
        return 0;
    }

    override bool PaintCell(App app, DataSource src, int row, int col,
                            int x, int y, int w, int h) {
        // The City column is drawn entirely by this hook: a dot keyed to the
        // city plus the name. Returning true means the grid's own cell
        // renderer is skipped for this cell.
        if (col != cityCol || cityCol < 0) { return false; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        string city = src.CellText(row, cityCol);
        int dot = t.textTertiary;
        if (city == "San Francisco") { dot = t.primary; }
        else if (city == "New York") { dot = t.warning; }
        else if (city == "Seattle") { dot = t.success; }
        int r = app.Scale(3);
        c.FillCircle(x + t.paddingSmall + r, y + h / 2, r, dot);
        int tx = x + t.paddingSmall + r * 2 + app.Scale(6);
        c.DrawText(tx, y + (h - Canvas.FontHeight(t.fontSizeSmall)) / 2,
                   city, t.textSecondary, t.fontSizeSmall);
        return true;
    }
}

/// Virtual source for the ChartBig large-data demos: a single series read
/// straight from a raw List<int> — no per-point ChartData objects, so a 100k
/// point series costs one int list, not 100k heap cells. With ring > 0 the
/// reads wrap around an ever-advancing offset, so the dynamic demo scrolls the
/// window with zero data copying: Roll() just bumps the offset.
class BigSeriesSource : ChartSource {
    List<int> data;
    string sname;
    int scolor;
    int ring;      // visible window length (0 = show the whole series)
    int off;       // ring offset, advanced by Roll()

    static BigSeriesSource Of(List<int> data, string name, int color, int ring) {
        BigSeriesSource s = new BigSeriesSource();
        s.data = data;
        s.sname = name;
        s.scolor = color;
        s.ring = ring;
        s.off = 0;
        return s;
    }

    override int SeriesCount() { return 1; }
    override string SeriesName(int s) { return this.sname; }
    override int SeriesColor(int s) { return this.scolor; }
    override int PointCount(int s) {
        if (this.ring > 0) { return this.ring; }
        return this.data.Count;
    }
    override int ValueAt(int s, int i) {
        int n = this.data.Count;
        if (n < 1) { return 0; }
        if (this.ring > 0) { return this.data[(i + this.off) % n]; }
        if (i < 0 || i >= n) { return 0; }
        return this.data[i];
    }

    void Roll() { this.off = this.off + 1; }
}

/// One rendered navigation row: category headers and component entries share
/// one entity, so the list does not need a sentinel component index.
class GalleryNavRow {
    bool header;
    int compIndex;
    string text;

    static GalleryNavRow Header(string text) {
        GalleryNavRow row = new GalleryNavRow();
        row.header = true;
        row.compIndex = 0;
        row.text = text;
        return row;
    }

    static GalleryNavRow Component(int compIndex, string text) {
        GalleryNavRow row = new GalleryNavRow();
        row.header = false;
        row.compIndex = compIndex;
        row.text = text;
        return row;
    }
}

/// One catalog entry: which category it belongs to, its display name, a short
/// description, and the code snippet shown (and copied) in the detail pane.
class Comp {
    string category;
    string name;
    string desc;
    string code;
    // Optional JSON config version of the snippet (the data-driven form of the
    // same demo). Empty when a component has no JSON representation yet.
    string json;
    // Multiple demo cards for this component (Naive-UI style). When empty the
    // page falls back to a single card built from desc/code/json.
    List<Demo> demos;
    // Bottom-of-page API documentation.
    List<ApiRow> props;
    List<ApiRow> events;

    // Memoised wrap of the page description (fontSizeMedium), rebuilt only when
    // the content width or font size changes -- see Demo.EnsureCache.
    string descSig;
    List<string> descLines;

    Comp(string category, string name, string desc, string code) {
        this.category = category;
        this.name = name;
        this.desc = desc;
        this.code = code;
        this.json = "";
        this.demos = new List<Demo>();
        this.props = new List<ApiRow>();
        this.events = new List<ApiRow>();
        this.descSig = "";
    }

    /// Wrapped page-description lines, recomputed only when (width, font) change.
    List<string> DescLines(int cw, int fs) {
        string sig = Convert.ToString(cw) + "|" + Convert.ToString(fs);
        if (sig != descSig) {
            descSig = sig;
            descLines = Gallery.WrapText(desc, cw, fs);
        }
        return descLines;
    }

    Comp AddDemo(string title, string desc, string previewId, int previewH,
            string code, string json) {
        demos.Add(new Demo(title, desc, previewId, previewH, code, json));
        return this;
    }

    Comp AddProp(string name, string type, string deflt, string desc) {
        props.Add(new ApiRow(name, type, deflt, desc));
        return this;
    }

    Comp AddEvent(string name, string sig, string desc) {
        events.Add(new ApiRow(name, sig, "", desc));
        return this;
    }

    /// Fluent: attach the declarative (.zform-style) JSON config for the
    /// component's single fallback card. Mirrors the strongly-typed props so
    /// the same UI can be authored as data instead of code.
    Comp Json(string j) {
        json = j;
        return this;
    }

    static Comp CreateJson(string category, string name, string desc,
            string code, string json) {
        Comp e = new Comp(category, name, desc, code);
        e.json = json;
        return e;
    }
}

/// One row in a component's API table: a property (name/type/default/desc) or
/// an event (name = event, type = signature, deflt unused).
class ApiRow {
    string name;
    string type;
    string deflt;
    string desc;

    ApiRow(string name, string type, string deflt, string desc) {
        this.name = name;
        this.type = type;
        this.deflt = deflt;
        this.desc = desc;
    }
}

class CodeDisplayLine {
    string text;
    int lineNo;
    List<CodeSpan> spans;

    CodeDisplayLine(string text, int lineNo, List<CodeSpan> spans) {
        this.text = text;
        this.lineNo = lineNo;
        this.spans = spans;
    }
}

/// One demo card on a component page: a titled block with its own description,
/// a live preview (keyed by previewId), and its own Zan / JSON snippets.
class Demo {
    string title;
    string desc;
    string previewId;
    int previewH;   // unscaled preview box height
    string code;
    string json;
    // Active code tab for THIS card only: 0 = Zan, 1 = JSON. Each card owns
    // its own tab so toggling one demo's JSON view leaves the others alone.
    int tab;
    // Stable identity for this card, so the shared code-selection state knows
    // which single code box owns the current selection (no cross-box bleed).
    static int seq;
    int uid;

    // --- Per-frame render cache -------------------------------------------
    // Wrapping the description and tokenising the code snippet for syntax
    // highlighting are pure functions of (content width, code tab, font size),
    // yet they were recomputed every frame. Memoise them here and only rebuild
    // when one of those inputs changes (window resize, DPI/theme, tab switch).
    // Demo objects are retained in Comp.demos, so the cache survives frames.
    // Each display line owns its wrapped text, source line number and colored
    // spans, so rendering cannot desynchronise parallel cache indexes.
    string cacheSig;
    string cacheSrc;
    List<string> cacheDescLines;
    List<CodeDisplayLine> cacheDisplayLines;
    // Gutter width chosen in EnsureCache (from the source line count) so the
    // wrap width and the render pass agree on where text starts.
    int cacheGutterW;
    // The code panel's Copy control is a real Button, retained per card so it
    // keeps its own hover/press state across frames.
    Button copyBtn;

    Demo(string title, string desc, string previewId,
            int previewH, string code, string json) {
        this.title = title;
        this.desc = desc;
        this.previewId = previewId;
        this.previewH = previewH;
        this.code = code;
        this.json = json;
        this.tab = 0;
        this.uid = Demo.seq;
        Demo.seq = Demo.seq + 1;
        this.cacheSig = "";
        this.copyBtn = new Button { Text = "Copy", Icon = "copy",
                                    Class = "primary small" };
    }

    /// Rebuilds the wrap/highlight cache when (width, tab, font size) change.
    /// Idempotent within a frame, so callers can invoke it freely.
    void EnsureCache(App app, Theme t, int cw, int tab) {
        int fs = t.fontSizeSmall;
        string sig = Convert.ToString(cw) + "|" + Convert.ToString(tab)
            + "|" + Convert.ToString(fs) + "|" + Convert.ToString(t.bgPrimary);
        if (sig == cacheSig) { return; }
        cacheSig = sig;

        cacheDescLines = Gallery.WrapText(desc, cw, fs);

        string src = code;
        if (tab == 1) {
            if (json != "") { src = json; }
            else { src = "// This demo has no JSON config version yet."; }
        }
        cacheSrc = src;
        List<string> srcLines = CodeEditor.SplitLines(src);
        cacheDisplayLines = new List<CodeDisplayLine>();

        int gnW = Canvas.MeasureText(Convert.ToString(srcLines.Count), fs);
        cacheGutterW = gnW + app.Scale(20);
        // Width available for code text; wrap long lines to fit instead of
        // letting them run past the panel edge. Small margin avoids overshoot
        // from per-glyph vs whole-run measurement rounding.
        int maxTextW = cw - cacheGutterW - app.Scale(8) - app.Scale(10);
        if (maxTextW < app.Scale(80)) { maxTextW = app.Scale(80); }

        for (int ci = 0; ci < srcLines.Count; ci = ci + 1) {
            List<CodeSpan> spans = new List<CodeSpan>();
            CodeEditor.HighlightSpans(srcLines[ci], t.info, t.success,
                t.warning, t.textTertiary, t.primary, t.textPrimary, false, spans);
            WrapCode(fs, maxTextW, ci + 1, spans);
        }
    }

    /// Emits one source line as one or more display rows that each fit within
    /// maxW. The first row carries the real line number; wrapped continuation
    /// rows carry 0. Highlight spans are split at the wrap point, preserving
    /// colour, and appended as complete display-line records.
    void WrapCode(int fs, int maxW, int lineNo, List<CodeSpan> spans) {
        string curText = "";
        List<CodeSpan> curSpans = new List<CodeSpan>();
        int curW = 0;
        bool first = true;

        for (int gi = 0; gi < spans.Count; gi = gi + 1) {
            CodeSpan span = spans[gi];
            string s = span.text;
            int col = span.color;
            int p = 0;
            int slen = s.Length;
            while (p < slen) {
                int start = p;
                while (p < slen) {
                    int chW = Canvas.MeasureText(s.Substring(p, 1), fs);
                    if (curW + chW > maxW && curW > 0) { break; }
                    curW = curW + chW;
                    p = p + 1;
                }
                if (p > start) {
                    string piece = s.Substring(start, p - start);
                    curSpans.Add(new CodeSpan(piece, col));
                    curText = curText + piece;
                }
                if (p < slen) {
                    // Line is full: flush this display row and start a new one.
                    FlushRow(curText, curSpans, first, lineNo);
                    first = false;
                    curText = "";
                    curSpans = new List<CodeSpan>();
                    curW = 0;
                }
            }
        }
        // Always emit the final (or only, possibly empty) row.
        FlushRow(curText, curSpans, first, lineNo);
    }

    void FlushRow(string text, List<CodeSpan> spans, bool first, int lineNo) {
        int displayLineNo = 0;
        if (first) { displayLineNo = lineNo; }
        cacheDisplayLines.Add(new CodeDisplayLine(text, displayLineNo, spans));
    }

}

/// Plain-field demo view-model. The new widget usage binds a widget's `.data`
/// straight to a model field (`input.data = model.inputText;`) instead of the
/// caller owning a Signal, so edits flow both ways through the field.
class GalleryModel {
    string inputText;
    bool toggle;
    bool toggleB;
    bool cbSmall;
    bool cbDefault;
    bool cbLarge;
    bool cbPrimary;
    bool cbSuccess;
    bool cbWarning;
    int level;
    int radioGroup2;
    string notes;
    int pick;
    int slide;
}

class Gallery {
    // Shared demo state. Only the selected component's preview renders each
    // frame, so a single set of signals is enough to drive every interactive
    // example.
    static GalleryModel model;
    static SignalBool demoBool;
    static SignalInt demoInt;
    static Input demoInput;
    static Checkbox demoCheck;
    static Switch demoSwitch;
    static Radio demoRadioA;
    static Radio demoRadioB;
    static Slider demoSlider;
    static Rate demoRate;
    static TextArea demoArea;
    static SelectBox demoSelect;
    static SelectBox demoMulti;
    static SelectBox demoLong;
    static SelectBox demoLarge;
    static SelectBox demoSelectLow;
    static Dropdown<string> demoDropdown;
    static Popover demoPopover;
    static FilePicker filePicker;
    static string pickerResult;
    static string pendingPicker;
    // Deep-link scroll target for the detail pane, applied after measurement.
    static int pendingScroll;
    static VirtualList demoVList;
    static Label demoSelLabel;
    static VirtualList demoVListTpl;
    static List<string> demoQuoteNames;
    static List<string> demoQuotePrices;
    static List<string> demoQuoteChanges;
    static ListView<string> demoList;
    static CarouselAnim demoCarousel;
    static CarouselAnim carAnim2;

    // Delegate/event demo state. Retained buttons register their handlers once
    // with the C#-style `Click += handler`; a background Thread reports progress
    // back to the UI thread through app.Post, which mutates these signals on the
    // UI thread.
    static App app;
    static SignalInt evtValue;
    static SignalBool evtRunning;
    static Button evtButton;
    static Button evtStartButton;
    // Copy buttons of the two API tables (properties / events).
    static Button apiCopyProps;
    static Button apiCopyEvents;
    static int evtClicks;

    // Showcase navigation / scroll state.
    static SignalInt selected;
    static SignalInt navScroll;
    static SignalInt codeScroll;
    // Active code tab: 0 = Zan API, 1 = JSON config.
    static SignalInt codeTab;
    // The detail page is a scroll container that owns wheel/clip/scrollbar.
    static ScrollView detailView;
    // Content height measured on the previous frame (fed back to the view).
    static SignalInt detailContentH;
    // Visible detail viewport bounds (set each frame by RenderDetail) so the
    // glass backdrop blur can be clamped to it -- BlurRect ignores the clip
    // rect, so without this a scrolled card would smear pixels above/below.
    static int detailClipTop;
    static int detailClipBottom;
    // Wall-clock of the last mouse-motion-driven repaint, used to throttle
    // hover refreshes so dragging the pointer never spins the CPU.
    static int lastMotionMs;
    // 画布环缓冲转储开关（ZAN_CANVAS_RING），见主循环里的转储点。
    static bool ringDump;
    static int ringIdx;
    static ScrollView navView;
    static Tabs tbLine;
    static Tabs tbCard;
    static Tabs tbSeg;
    static Tabs tbVert;
    static List<Comp> comps;

    // Read-only code selection (line/col anchor..focus into the current
    // snippet's split lines). selDrag is true while the mouse button is held.
    static bool selHas;
    static bool selDrag;
    // uid of the Demo whose code box currently owns the selection (-1 = none),
    // combined with the tab so a Zan/JSON switch doesn't reuse stale offsets.
    static int selOwner;
    static int selTab;
    // Retained state for the deferred-overlay / interactive demos.
    static string copiedIcon;
    static DataTableState demoTableState;
    static ScoreStyler demoStyler;      // kept typed so its columns can be rebound
    // The demo rows are built once and kept, not rebuilt per frame: rows the
    // user adds, edits or deletes have to survive the next repaint.
    static List<DataRow> demoRows;
    static DataTableState bigTableState;    // large-data demo
    static List<DataColumn> bigCols;
    static BigDataSource bigSource;         // virtual source (no per-row storage)
    static SelectBox bigRowsSelect;            // row-count picker (a "setting")
    static SignalInt bigRowsSel;
    static int bigRowCount;
    static int bigBuildMs;
    static DataRow DtRow7(string a, string b, string cc, string d, string e, string f, string g) {
        DataRow r = new DataRow();
        r.Push(a); r.Push(b); r.Push(cc); r.Push(d); r.Push(e); r.Push(f); r.Push(g);
        return r;
    }
    /// The Dept column's dropdown list, covering every value in the demo rows so
    /// the strict editor accepts what is already there.
    static List<string> DeptChoices() {
        List<string> d = new List<string>();
        d.Add("Engineering"); d.Add("Sales"); d.Add("Operations");
        d.Add("Support"); d.Add("Finance");
        return d;
    }
    // Retained state for the unified Layer demo: draggable windows, the modal
    // alert/confirm/prompt dialogs, plus the loading / tips / photos toggles.
    static List<LayerState> demoLayers;
    static int layerSeq;
    static LayerState dlgAlert;
    static LayerState dlgConfirm;
    static LayerState dlgPrompt;
    static SignalBool tipsOn;
    static SignalBool tipClickOn;
    static SignalInt scrollOff;
    static SignalInt tipScroll;
    static SignalBool photosOpen;
    static int loadStartMs;
    static SignalInt photoIdx;
    static CarouselAnim photoAnim;
    static List<string> photoSlides;
    static string popupResult;
    static int selAL;
    static int selAC;
    static int selFL;
    static int selFC;
    static int copiedFrame;
    // API-table (Properties / Events) row selection. Independent from the code
    // panel selection above so the two never clobber each other. kind: 0 none,
    // 1 Properties, 2 Events. anchor/focus are inclusive row indices.
    static int apiSelKind;
    static int apiSelA;
    static int apiSelB;
    static bool apiSelDrag;
    static int apiCopiedFrame;
    // Phase counter for the live-updating Chart.dynamic demo (bumped per frame).
    static int dynPhase;
    // Static 96x48 heatmap option for the Chart.performance demo, built once
    // and reused every frame (RenderCached keeps its snapshot alive).
    static ChartOption perfHeat;
    static int perfHeatSlot;
    // Static 2000-point scatter cloud for the Chart.scatter demo (built once,
    // cached like the heatmap) and the GitHub-style calendar heatmap.
    static ChartOption scatterCloud;
    static int scatterCloudSlot;
    static ChartOption calHeat;
    // Big-data chart demos (ChartBig): decimated min/max caches + virtual
    // sources, built lazily on the first frame. big10k / big100k are static;
    // the dynamic card rolls a ring window (Roll + Invalidate per frame) with
    // no data copying.
    static ChartState big10kStateA;
    static BigSeriesSource big10kA;
    static ChartState big10kStateB;
    static BigSeriesSource big10kB;
    static ChartState big100kState;
    static BigSeriesSource big100kA;
    static ChartState bigDynStateA;
    static BigSeriesSource bigDynA;
    static ChartState bigDynStateB;
    static BigSeriesSource bigDynB;
    // Interactive Tag demo: closable chips the user can remove (x) or append (+ Add).
    static List<string> demoTags;

    // Bilingual demos: 0 = English, 1 = 中文. Toggled from the header; mirrored
    // into Wizard.lang / FilePicker.lang so their child windows follow suit.
    static SignalInt lang;

    // Persistent demo models (must survive across frames so interaction sticks).
    static SignalInt splitVFirst;        // left pane width  (left|right split)
    static SignalInt splitHFirst;        // top pane height  (top|bottom split)
    static List<TreeNode> treeNodes;     // TreeView demo tree
