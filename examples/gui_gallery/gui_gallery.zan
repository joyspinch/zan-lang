    /// Scaled (device-px) height of a demo's preview box for a given card width.
    /// Most previews are a fixed design height, but content that wraps to a
    /// width-dependent number of rows (the Icon gallery grid) must grow taller
    /// as the window narrows, otherwise its lower rows spill past the fixed box
    /// and get clipped. Callers use this for both layout and the drawn frame so
    /// the box, the card height and the grid always agree.
    /// 预览框内容区的上下内缩：上边留出 "LIVE STATES" 标题带，
    /// 下边是收口留白。LayoutAuto 量到的是内容高度，加上这两段
    /// 才是框高，所以两边必须读同一对值。
    static int PreviewPadTop(App app) { return app.Scale(34); }
    static int PreviewPadBottom(App app) { return app.Scale(14); }

    /// Preview box height (unscaled) for a component: complex widgets that
    /// need more vertical room get a taller box so they aren't clipped.
    static int PreviewBoxH(App app, string name, int previewHUnscaled, int w) {
        // 已经改用 LayoutAuto 的演示：框高由上一帧量到的内容底边决定，
        // 注册处的 previewHUnscaled 只在第一帧（还没量过）起作用。
        int auto = Gallery.AutoContentH(name, w);
        if (auto > 0) { return auto + Gallery.PreviewPadBottom(app); }
        if (name == "Icon") {
            int cell = app.Scale(62);
            int gcols = (w - app.Scale(24)) / cell;
            if (gcols < 1) { gcols = 1; }
            int n = Icon.Names().Count;
            int rows = (n + gcols - 1) / gcols;
            if (rows < 1) { rows = 1; }
            return app.Scale(34) + rows * cell + app.Scale(12);
        }
        if (name == "IconSvg.catalog") {
            int cell = app.Scale(62);
            int gcols = (w - app.Scale(24)) / cell;
            if (gcols < 1) { gcols = 1; }
            int n = IconSvg.Count();
            if (n > 120) { n = 120; }
            int rows = (n + gcols - 1) / gcols;
            if (rows < 1) { rows = 1; }
            return app.Scale(34) + rows * cell + app.Scale(12);
        }
        if (name == "Chart.dashboard" && w < app.Scale(560)) {
            return app.Scale(834);
        }
        return app.Scale(previewHUnscaled);
    }

    /// Lays out and paints a retained-mode subtree inside a rect -- the same
    /// three calls a Form makes for the whole window, scoped to the preview box.
    /// The demos use this so their preview is the retained tree the snippet
    /// builds (no hand-placed x/y), matching what an app developer would copy.
    static void LayoutIn(App app, Control root, int x, int y, int w, int h) {
        root.MeasureTree(app);
        root.Arrange(x, y, w, h);
        root.RenderTree(app);
    }

    /// LayoutIn 的自测量版本：高度由子树自己量出来，而不是调用方传一个
    /// 手调的数字。演示改用它之后，AddDemo 里的高度只是第一帧的种子，
    /// 窗口变窄让 Flex 换行时卡片会跟着长高，而不是把内容裁掉。
    ///
    /// 参数与 LayoutIn 完全一致，只多了开头的 `name`（该演示的
    /// previewId，PreviewBoxH 用同一个键回读）；末尾的 `fallbackH`
    /// 就是原来那个手调高度，仅在子树量不出高度时兜底。
    static void LayoutAuto(App app, Control root, string name,
                           int x, int y, int w, int fallbackH) {
        // 宽度已知，先告诉容器：换行的一排按钮才能在第一次测量就
        // 算出正确行数（演示每帧重建控件树，没有上一帧的状态可用）。
        root.HintWrapWidth(w);
        root.MeasureTree(app);
        int h = root.prefH;
        if (h < 1) {
            // 这棵树量不出高度——根多半是个跨帧复用的容器，它的
            // 测量早已定型。保持改造前的行为：用调用方给的框高，
            // 也不要写进缓存，否则卡片会塌成一条线。
            root.Arrange(x, y, w, fallbackH);
            root.RenderTree(app);
            Gallery.ReportTree(app, name, root);
            return;
        }
        root.Arrange(x, y, w, h);
        root.RenderTree(app);
        Gallery.ReportTree(app, name, root);
        // 记的是「内容底边相对框顶的距离」而不是纯内容高度：各演示
        // 的内容起点偏移并不统一（有的 y+34，有的 py-16），只有算到
        // 框顶为止，PreviewBoxH 才能不管偏移直接得出框高。
        Gallery.RecordAuto(app, name, y - Gallery.previewBoxTop + h);
    }

    /// 下拉框四项能力的演示数据。放在一处，因为它们只是同一个 SelectBox
    /// 的不同配置，而不是四个不同的控件。
    static void BuildSelectDemos() {
        // 键入筛选：候选项多到不值得逐条翻的时候，搜索框才是入口。
        Gallery.demoFilter = new SelectBox("Type to filter countries")
            .Filterable(true)
            .FilterHint(Gallery.T("Search countries", "搜索国家/地区"));
        List<string> cs = new List<string>{
            "Argentina", "Australia", "Austria", "Belgium", "Brazil", "Canada",
            "Chile", "China", "Denmark", "Egypt", "Finland", "France",
            "Germany", "Greece", "India", "Indonesia", "Ireland", "Italy",
            "Japan", "Kenya", "Korea", "Malaysia", "Mexico", "Netherlands",
            "New Zealand", "Norway", "Peru", "Poland", "Portugal", "Singapore",
            "South Africa", "Spain", "Sweden", "Switzerland", "Thailand",
            "Turkey", "Ukraine", "United Kingdom", "United States", "Vietnam" };
        for (int i = 0; i < cs.Count; i = i + 1) {
            Gallery.demoFilter.AddOption(cs[i]);
        }

        // 表格式选项：一行三列，筛选对所有列生效（按代码搜和按名称搜
        // 同样自然）。
        Gallery.demoTablePick = new SelectBox("Pick a stock")
            .Filterable(true)
            .FilterHint(Gallery.T("Code or name", "代码或名称"));
        Gallery.demoTablePick.Table(
            new List<string>{ Gallery.T("Code", "代码"),
                              Gallery.T("Name", "名称"),
                              Gallery.T("Last", "最新价") },
            new List<int>{ 80, 150, 90 });
        Gallery.demoTablePick.AddRow(new List<string>{ "600519", "Kweichow Moutai", "1712.00" });
        Gallery.demoTablePick.AddRow(new List<string>{ "000858", "Wuliangye", "128.44" });
        Gallery.demoTablePick.AddRow(new List<string>{ "601318", "Ping An", "56.31" });
        Gallery.demoTablePick.AddRow(new List<string>{ "600036", "Merchants Bank", "39.02" });
        Gallery.demoTablePick.AddRow(new List<string>{ "000333", "Midea Group", "72.18" });
        Gallery.demoTablePick.AddRow(new List<string>{ "300750", "CATL", "241.60" });
        Gallery.demoTablePick.AddRow(new List<string>{ "002594", "BYD", "265.77" });
