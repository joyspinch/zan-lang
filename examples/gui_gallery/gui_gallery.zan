            rowS.With(Gallery.FieldWithCaption(app, "Warning", Gallery.demoWarn, ""));
            Gallery.LayoutAuto(app, rowS, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.passive") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Passively activated", Gallery.demoPassive,
                    Gallery.T("Looks disabled until Enter arms it (Naive UI passively-activated).",
                        "外观禁用，按回车激活（Naive UI passively-activated）。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.manual") {
            Button bClr = new Button { Text = Gallery.T("Clear", "清空") };
