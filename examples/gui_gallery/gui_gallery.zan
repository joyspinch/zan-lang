                ChartSeries.OfTreeOrient(Gallery.T("冰桶挑战", "冰桶挑战"),
                    iceRoot, "vertical"));
            ChartView.KeyedStatic(ice, 8711).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));


        } else if (name == "Chart.echarts_treemap_deep") {
            // ECharts treemap1：三层结构的下钻树图。
            ChartNode tmPhone = ChartNode.Group(Gallery.T("手机", "手机"),
                new List<ChartNode>{
                    ChartNode.Leaf(Gallery.T("旗舰机", "旗舰机"), 520),
                    ChartNode.Leaf(Gallery.T("中端机", "中端机"), 340) });
            ChartNode tmLap = ChartNode.Group(Gallery.T("笔记本", "笔记本"),
                new List<ChartNode>{
                    ChartNode.Leaf(Gallery.T("轻薄本", "轻薄本"), 380),
                    ChartNode.Leaf(Gallery.T("游戏本", "游戏本"), 460) });
            ChartNode tmDigital = ChartNode.Group(Gallery.T("数码家电", "数码家电"),
                new List<ChartNode>{ tmPhone, tmLap });
            ChartNode tmMen = ChartNode.Group(Gallery.T("男装", "男装"),
                new List<ChartNode>{
                    ChartNode.Leaf(Gallery.T("外套", "外套"), 245),
                    ChartNode.Leaf(Gallery.T("衬衫", "衬衫"), 155) });
            ChartNode tmWomen = ChartNode.Group(Gallery.T("女装", "女装"),
                new List<ChartNode>{
                    ChartNode.Leaf(Gallery.T("连衣裙", "连衣裙"), 305),
                    ChartNode.Leaf(Gallery.T("大衣", "大衣"), 210) });
            ChartNode tmCloth = ChartNode.Group(Gallery.T("服饰鞋包", "服饰鞋包"),
                new List<ChartNode>{ tmMen, tmWomen });
            ChartNode tmRoot = ChartNode.Group(Gallery.T("商场销售", "商场销售"),
                new List<ChartNode>{ tmDigital, tmCloth });
            ChartOption tmd = ChartOption.Single(
                ChartSeries.OfTree(Gallery.T("销售构成", "销售构成"),
                    ChartType.Treemap, tmRoot));
            ChartView.KeyedStatic(tmd, 8712).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));


        } else if (name == "Chart.echarts_force_simple") {
            // ECharts force1：五节点星型网络。
            List<ChartLink> fsLinks = new List<ChartLink>{
                ChartLink.Of(Gallery.T("网关", "网关"), Gallery.T("摄像头", "摄像头"), 10),
                ChartLink.Of(Gallery.T("网关", "网关"), Gallery.T("门锁", "门锁"), 8),
                ChartLink.Of(Gallery.T("网关", "网关"), Gallery.T("音箱", "音箱"), 6),
                ChartLink.Of(Gallery.T("网关", "网关"), Gallery.T("传感器组", "传感器组"), 4) };
            ChartOption fso = ChartOption.Single(
                ChartSeries.Force(Gallery.T("智能家居网络", "智能家居网络"), fsLinks));
            ChartView.KeyedStatic(fso, 8713).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));


        } else if (name == "Chart.echarts_webkit_dep") {
            // ECharts webkit-dep：内核模块依赖网。
            List<ChartLink> wd = new List<ChartLink>{
                ChartLink.Of("WebCore", "Loader", 30),
                ChartLink.Of("WebCore", "Rendering", 45),
                ChartLink.Of("WebCore", "DOM", 38),
                ChartLink.Of("WebCore", "Platform", 16),
                ChartLink.Of("JavaScriptCore", "Interpreter", 28),
                ChartLink.Of("JavaScriptCore", "JIT", 34),
                ChartLink.Of("JavaScriptCore", "Runtime", 15),
                ChartLink.Of("Loader", "DOM", 22),
                ChartLink.Of("Loader", "Network", 19),
                ChartLink.Of("Rendering", "DOM", 26),
                ChartLink.Of("Rendering", "Graphics", 31),
                ChartLink.Of("DOM", "EventTarget", 14),
                ChartLink.Of("JIT", "Interpreter", 18),
                ChartLink.Of("Interpreter", "Runtime", 12),
                ChartLink.Of("Network", "Platform", 17),
                ChartLink.Of("Platform", "Graphics", 20),
                ChartLink.Of("WebCore", "JavaScriptCore", 12),
                ChartLink.Of("Runtime", "Platform", 9) };
            ChartOption wdo = ChartOption.Single(
                ChartSeries.Force(Gallery.T("WebKit 依赖", "WebKit 依赖"), wd));
            ChartView.KeyedStatic(wdo, 8714).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));


        } else if (name == "Chart.echarts_bubble_sex") {
            // ECharts scatter2：性别气泡图（半径按 sqrt(weight)）。
            List<Bubble> bf = new List<Bubble>{
                Bubble.Of(161, 52, 9), Bubble.Of(168, 59, 7),
                Bubble.Of(160, 49, 5), Bubble.Of(157, 63, 8),
                Bubble.Of(166, 57, 6) };
            List<Bubble> bm = new List<Bubble>{
                Bubble.Of(174, 66, 10), Bubble.Of(175, 72, 14),
                Bubble.Of(194, 81, 18), Bubble.Of(187, 73, 12),
                Bubble.Of(187, 79, 13), Bubble.Of(180, 69, 9) };
            ChartOption bbx = ChartOption.Of(
                Gallery.T("男女生身高体重（气泡）", "男女生身高体重（气泡）"), null,
                new List<ChartSeries>{
                    ChartSeries.OfBubbles(Gallery.T("女生", "女生"), bf),
                    ChartSeries.OfBubbles(Gallery.T("男生", "男生"), bm) });
            bbx.X(ChartAxis.ValueRange(140, 200));
            bbx.Y(ChartAxis.ValueRange(40, 100));
            bbx.showLegend = true;
            ChartView.KeyedStatic(bbx, 8715).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));


        } else if (name == "Chart.echarts_event_river2") {
            // ECharts eventRiver2：双事件带汇入同一时间河。
            ChartSeries eri = ChartSeries.OfEvents("iOS", new List<ChartEvent>{
                ChartEvent.Of(Gallery.T("iPhone 初代", "iPhone 初代"), 5, 35, 42),
                ChartEvent.Of(Gallery.T("App Store", "App Store"), 45, 80, 35),
                ChartEvent.Of(Gallery.T("Siri 问世", "Siri 问世"), 95, 140, 30),
                ChartEvent.Of(Gallery.T("Face ID", "Face ID"), 165, 215, 26) });
            ChartSeries era = ChartSeries.OfEvents("Android", new List<ChartEvent>{
                ChartEvent.Of(Gallery.T("G1 发布", "G1 发布"), 15, 50, 36),
                ChartEvent.Of(Gallery.T("蜂巢系统", "蜂巢系统"), 70, 110, 28),
                ChartEvent.Of(Gallery.T("KitKat", "KitKat"), 130, 170, 24),
                ChartEvent.Of(Gallery.T("可折叠形态", "可折叠形态"), 200, 250, 20) });
            ChartOption ero = ChartOption.Single(eri);
            ero.series.Add(era);
            ero.showLegend = true;
            ChartView.KeyedStatic(ero, 8716).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));


        } else if (name == "Chart.echarts_radar_period") {
            // ECharts radar 多期对照：Q1 / Q2 并列极坐标。
            List<string> rdims = new List<string>{
                "销售", "管理", "信息技术", "客服", "研发" };
            int cY = y + app.Scale(30);
            int cH = app.Scale(420);
            int halfW = (w - app.Scale(28) - app.Scale(12)) / 2;
            int c0X = x + app.Scale(14);
            int c1X = c0X + halfW + app.Scale(12);
            ChartSeries rcur = ChartSeries.Polar(Gallery.T("本季度", "本季度"),
                new List<int>{ 4300, 10000, 28000, 35000, 50000 });
            rcur.areaStyle = true;
            ChartOption rq1 = ChartOption.Of(Gallery.T("Q1 团队评估", "Q1 团队评估"),
                rdims, new List<ChartSeries>{ rcur });
            rq1.RadarMax(new List<int>{ 6500, 16000, 30000, 38000, 52000 });
            ChartView.KeyedStatic(rq1, 8718).Render(app, c0X, cY, halfW, cH);
            ChartSeries rnxt = ChartSeries.Polar(Gallery.T("下季度目标", "下季度目标"),
                new List<int>{ 4600, 11200, 29600, 36400, 51500 });
            rnxt.areaStyle = true;
            ChartOption rq2 = ChartOption.Of(Gallery.T("Q2 团队评估", "Q2 团队评估"),
                rdims, new List<ChartSeries>{ rnxt });
            rq2.RadarMax(new List<int>{ 6500, 16000, 30000, 38000, 52000 });
            ChartView.KeyedStatic(rq2, 8719).Render(app, c1X, cY, halfW, cH);
        } else if (name == "Chart.echarts_timeline") {
            // ECharts pie7（timeline）：同一张饼按年份帧切换，底部
            // 播放器条自动轮播（播放/暂停 + 前后帧 + 帧点）。
            ChartOption tlA = ChartOption.Of(Gallery.T("2011", "2011 年"), null,
                new List<ChartSeries>{
                    ChartSeries.Named("2011", ChartType.Pie, new List<ChartData>{
                        ChartData.Named(335, Gallery.T("Direct@直接访问", "直接访问")),
                        ChartData.Named(310, Gallery.T("Mail@邮件营销", "邮件营销")),
                        ChartData.Named(234, Gallery.T("Affiliate", "联盟广告")),
                        ChartData.Named(135, Gallery.T("Video", "视频广告")) }) });
            tlA.donutPct = 0;
            tlA.pieLabels = true;
            tlA.showLegend = false;
            tlA.toolboxShow = false;
            ChartOption tlB = ChartOption.Of(Gallery.T("2012", "2012 年"), null,
                new List<ChartSeries>{
                    ChartSeries.Named("2012", ChartType.Pie, new List<ChartData>{
                        ChartData.Named(410, Gallery.T("Direct@直接访问", "直接访问")),
                        ChartData.Named(280, Gallery.T("Mail@邮件营销", "邮件营销")),
                        ChartData.Named(190, Gallery.T("Affiliate", "联盟广告")),
                        ChartData.Named(220, Gallery.T("Video", "视频广告")) }) });
            tlB.donutPct = 0;
            tlB.pieLabels = true;
            tlB.showLegend = false;
            tlB.toolboxShow = false;
            ChartTimeline tlp = ChartTimeline.Of()
                .Frame(tlA).Frame(tlB)
                .Labels(new List<string>{ Gallery.T("2011", "2011 年"),
                    Gallery.T("2012", "2012 年") })
                .AutoPlay(1600);
            // 布局：图表占上部，播放器条贴底；帧号/播放态持久化在
            // 8720 的 App 状态里，立即模式重建不丢。
            int tlX = x + app.Scale(14);
            int tlY = y + app.Scale(30);
            int tlW = w - app.Scale(28);
            int tlBar = ChartTimeline.Height(app);
            int tlH = app.Scale(420) - tlBar;
            int tlIdx = ChartTimeline.TimelineIdxOf(app, 8720, tlp.FrameCount());
            ChartView.KeyedStatic(ChartTimeline.Merge(tlA, tlp.Current(tlIdx)), 8720)
                .Render(app, tlX, tlY, tlW, tlH);
            tlp.Draw(app, 8720, tlX, tlY + tlH, tlW);
        } else if (name == "Chart.echarts_connect") {
            // ECharts connect：同组两张图共享交互态——拖左图 dataZoom
            // 滑块或悬停任一张，另一张同帧跟随（同组图例开关也同步）。
            List<string> cwkl = new List<string>{
                "周一", "周二", "周三", "周四", "周五", "周六", "周日" };
            ChartOption cnA = ChartOption.Of(Gallery.T("Line@折线图", "折线图"), cwkl,
                new List<ChartSeries>{
                    ChartSeries.Line(Gallery.T("Mail@邮件营销", "邮件营销"),
                        new List<int>{ 120, 132, 101, 134, 90, 230, 210 }),
                    ChartSeries.Line(Gallery.T("Ad", "联盟广告"),
                        new List<int>{ 220, 182, 191, 234, 290, 330, 310 }) });
            cnA.DataZoom(20, 70);
            cnA.ConnectGroup(8723);
            ChartOption cnB = ChartOption.Of(Gallery.T("Bar", "柱状图"), cwkl,
                new List<ChartSeries>{
                    ChartSeries.Bar(Gallery.T("Mail@邮件营销", "邮件营销"),
                        new List<int>{ 320, 332, 301, 334, 390, 330, 320 }),
                    ChartSeries.Bar(Gallery.T("Ad", "联盟广告"),
                        new List<int>{ 820, 932, 901, 934, 1290, 1330, 1320 }) });
            cnB.ConnectGroup(8723);
            int cnY = y + app.Scale(30);
            int cnH = app.Scale(420);
            int cnHalf = (w - app.Scale(28) - app.Scale(12)) / 2;
            int cnX = x + app.Scale(14);
            ChartView.KeyedStatic(cnA, 8721).Render(app, cnX, cnY, cnHalf, cnH);
            ChartView.KeyedStatic(cnB, 8722).Render(
                app, cnX + cnHalf + app.Scale(12), cnY, cnHalf, cnH);


        } else if (name == "Ellipsis") {
            string longText = "A very long component description that will not fit a narrow column";
            Gallery.EllipsisRow(app, px, py - app.Scale(6), app.Scale(160), longText);
            Gallery.EllipsisRow(app, px, py + app.Scale(30), app.Scale(280), longText);
            Gallery.EllipsisRow(app, px, py + app.Scale(66), app.Scale(440), longText);
        } else if (name == "Divider") {
            // Plain divider, labeled divider, and a vertical rule — showing the
            // three basic uses of the rule, stacked by a column.
            Panel col = Panel.Column().Gap(app.Scale(18));
            col.With(new Divider());
            col.With(new Divider("Section"));
            Panel row = Panel.Row().Gap(app.Scale(20));
            row.With(new Label { Text = "Left" });
            Divider vert = new Divider();
            vert.Class = "vertical";
            row.With(vert);
            row.With(new Label { Text = "Right" });
            col.With(row);
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(150));
        } else if (name == "Progress.line") {
            // Naive UI basic: one line bar per type, plus a bare bar with no
            // indicator text.
            Panel col = Panel.Column().Gap(app.Scale(12));
            col.With(new Progress(72, 0));
            col.With(new Progress(45, 2));
            col.With(new Progress(90, 3));
            col.With(new Progress(30, 4));
            col.With(new Progress(60, 0).ShowText(false));
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(170));
        } else if (name == "Progress.processing") {
            // Naive UI processing state: Processing(true) rolls highlight
            // stripes through the fill while the task runs.
            Panel col = Panel.Column().Gap(app.Scale(12));
            col.With(new Progress(65, 0).Processing(true));
            col.With(new Progress(80, 3).Processing(true));
            col.With(new Progress(35, 4).Processing(true));
            col.With(new Progress(95, 5).Processing(true));
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(150));
        } else if (name == "Progress.height") {
            // Naive UI custom height: StrokeWidth thickens the track in px.
            Panel col = Panel.Column().Gap(app.Scale(12));
            col.With(new Progress(72, 0).StrokeWidth(4));
            col.With(new Progress(72, 0).StrokeWidth(10));
            col.With(new Progress(72, 0).StrokeWidth(18));
            col.With(new Progress(72, 0).StrokeWidth(26));
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(160));
        } else if (name == "Progress.colors") {
            // Naive UI custom colour: FillColor swaps the fill, RailColor the
            // track (0 restores the skin).
            Panel col = Panel.Column().Gap(app.Scale(12));
            col.With(new Progress(66, 0)
                .FillColor(Theme.Rgb(122, 90, 248))
                .RailColor(Theme.Rgb(238, 236, 252)));
            col.With(new Progress(80, 0)
                .FillColor(Theme.Rgb(0, 150, 136))
                .RailColor(Theme.Rgb(224, 242, 241)));
            col.With(new Progress(45, 0)
                .FillColor(Theme.Rgb(240, 98, 146))
                .RailColor(Theme.Rgb(252, 228, 236)));
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(130));
        } else if (name == "Progress.indicator") {
            // Naive UI custom indicator: every {0} in the Format template
            // becomes the percent number.
            Panel col = Panel.Column().Gap(app.Scale(12));
            col.With(new Progress(66, 0).Format("已完成 {0}%"));
            col.With(new Progress(45, 4).Format("剩余 {0}%"));
            col.With(new Progress(80, 2).Format("8 hours {0}%"));
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(130));
        } else if (name == "Progress.circle") {
            // Naive UI circle: rings per type, a smaller Size(48) pair and one
            // with the indicator text off.
            Flex row = Flex.Wrapped().Gap(app.Scale(24));
            row.With(new Progress(72, 0).Ring());
            row.With(new Progress(90, 3).Ring());
            row.With(new Progress(45, 4).Ring());
            row.With(new Progress(60, 2).Ring().Size(48));
            row.With(new Progress(30, 0).Ring().ShowText(false).Size(48));
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(6),
                             w - app.Scale(36), app.Scale(110));
        } else if (name == "Progress.dashboard") {
            // Naive UI dashboard: a 270° arc starting at the lower-left with a
            // gap at the bottom.
            Flex row = Flex.Wrapped().Gap(app.Scale(24));
            row.With(new Progress(45, 0).Dashboard());
            row.With(new Progress(70, 3).Dashboard());
            row.With(new Progress(60, 4).Dashboard());
            row.With(new Progress(85, 2).Dashboard());
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(6),
                             w - app.Scale(36), app.Scale(120));
        } else if (name == "Progress.multi") {
            // Naive UI multiple circles: one ring per AddCircle(value, type),
            // outermost first; the centre lists every ring in its own colour.
            // 140px 起步：中心要放下 n 行百分比，88px 会把弧线挤进文字。
            Flex row = Flex.Wrapped().Gap(app.Scale(32));
            row.With(new Progress(0, 0).Multi().Size(140)
                .AddCircle(90, 3).AddCircle(60, 0).AddCircle(30, 2));
            row.With(new Progress(0, 0).Multi().Size(140)
                .AddCircle(45, 4).AddCircle(75, 5));
            row.With(new Progress(0, 0).Multi().Size(140)
                .AddCircle(80, 2).AddCircle(55, 3).AddCircle(35, 4)
                .AddCircle(15, 5));
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(6),
                             w - app.Scale(36), app.Scale(170));
        } else if (name == "Alert.types") {
            // Inline banners: one per role, the full type set side by side.
            int aw = w - app.Scale(36);
            int aay = py - app.Scale(20);
            int step = Layer.NotifyH(app) + app.Scale(12);
            Layer.DrawNotify(app, px, aay, aw,
                Gallery.T("Default — plain banner without a role tint.",
                          "默认 — 无角色着色的普通横幅。"), 0);
            Layer.DrawNotify(app, px, aay + step, aw,
                Gallery.T("Info — additional context that does not demand action.",
                          "信息 — 需要了解但无需操作的上下文。"), 2);
            Layer.DrawNotify(app, px, aay + step * 2, aw,
                Gallery.T("Success — the build finished.", "成功 — 构建完成。"), 3);
            Layer.DrawNotify(app, px, aay + step * 3, aw,
                Gallery.T("Warning — low disk space.", "警告 — 磁盘空间不足。"), 4);
            Layer.DrawNotify(app, px, aay + step * 4, aw,
                Gallery.T("Error — deployment failed.", "错误 — 部署失败。"), 5);
            Gallery.RecordBottom(app, name,
                aay + step * 4 + Layer.NotifyH(app));
        } else if (name == "Alert.queue") {
            // Transient queues: every button fires the real API; the toasts
            // and corner cards render from the app's overlay pass (gallery
            // main loop calls Layer.RenderToasts/RenderNotifs every frame).
            int bw = app.Scale(96);
            int bh = t.heightMedium;
            int gapq = app.Scale(8);
            int bx = px;
            int by = py - app.Scale(16);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                bx, by - app.Scale(24),
                Gallery.T("Layer.Msg · top-centred toast",
                          "Layer.Msg · 顶部居中消息"),
                t.textPrimary, t.fontSizeMedium);
            int qm0 = new Button { Text = Gallery.T("Default@默认", "默认") }
                .Render(app, bx, by, bw);
            if (Ui.Clicked(app, qm0)) { Layer.Msg("Message saved.", 0); }
            int qm2 = new Button { Text = "Info" }
                .Render(app, bx + (bw + gapq), by, bw);
            if (Ui.Clicked(app, qm2)) { Layer.Msg("Context loaded.", 2); }
            int qm3 = new Button { Text = "Success" }
                .Render(app, bx + (bw + gapq) * 2, by, bw);
            if (Ui.Clicked(app, qm3)) { Layer.Msg("Saved successfully", 3); }
            int qm4 = new Button { Text = "Warning" }
                .Render(app, bx + (bw + gapq) * 3, by, bw);
            if (Ui.Clicked(app, qm4)) { Layer.Msg("Unsaved changes", 4); }
            int qm5 = new Button { Text = "Error" }
                .Render(app, bx + (bw + gapq) * 4, by, bw);
            if (Ui.Clicked(app, qm5)) { Layer.Msg("Network error", 5); }
            by = by + bh + app.Scale(34);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                bx, by - app.Scale(24),
                Gallery.T("Layer.Notify · top-right corner card",
                          "Layer.Notify · 右上角通知卡"),
                t.textPrimary, t.fontSizeMedium);
            int qn0 = new Button { Text = Gallery.T("Default@默认", "默认") }
                .Render(app, bx, by, bw);
            if (Ui.Clicked(app, qn0)) { Layer.Notify("Deploy started", 0); }
            int qn2 = new Button { Text = "Info" }
                .Render(app, bx + (bw + gapq), by, bw);
            if (Ui.Clicked(app, qn2)) { Layer.Notify("New version available", 2); }
            int qn3 = new Button { Text = "Success" }
                .Render(app, bx + (bw + gapq) * 2, by, bw);
            if (Ui.Clicked(app, qn3)) { Layer.Notify("Build completed", 3); }
            int qn4 = new Button { Text = "Warning" }
                .Render(app, bx + (bw + gapq) * 3, by, bw);
            if (Ui.Clicked(app, qn4)) { Layer.Notify("Disk almost full", 4); }
            int qn5 = new Button { Text = "Error" }
                .Render(app, bx + (bw + gapq) * 4, by, bw);
            if (Ui.Clicked(app, qn5)) { Layer.Notify("Tests failed", 5); }
            Gallery.RecordBottom(app, name, by + bh);
        } else if (name == "Result") {
            // Every status side by side: success / warning / error, arranged by
            // a row that lets each card keep its natural width.
            Result r1 = new Result("Success", "Changes saved.");
            r1.Class = Result.StatusClass(1);
            Result r2 = new Result("Warning", "Review the config.");
            r2.Class = Result.StatusClass(2);
            Result r3 = new Result("Error", "The build failed.");
            r3.Class = Result.StatusClass(3);
            Flex row = Flex.Wrapped().Gap(app.Scale(18));
            row.With(r1); row.With(r2); row.With(r3);
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(20),
                             w - app.Scale(36), app.Scale(220));
        } else if (name == "Tooltip") {
            // Triggers: hover shows the tip while the pointer is over the target;
            // click toggles it; manual is fully programmatic (Show/Hide buttons
            // drive the bubble from caller state alone). All three feed the same
            // Tooltip.RenderAt / RenderBox renderer.
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py - app.Scale(28),
                Gallery.T("Triggers · hover / click / manual",
                          "触发方式 · 悬浮 / 点击 / 手动"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int bw = app.Scale(110);
            // Hover tip: the Button's Tip property handles everything inside the
            // component (no manual anchor math at the call site).
            int hoverId = new Button { Text = "Hover me", Tip = "Shown on hover" }
                .Render(app, px, py, bw);
            int clickX = px + bw + app.Scale(14);
            int clickId = new Button { Text = "Click me" }.Render(app, clickX, py, bw);
            if (Ui.Clicked(app, clickId)) {
                Gallery.tipClickOn.Set(!Gallery.tipClickOn.Get());
            }
            if (Gallery.tipClickOn.Get()) {
                // Pass the button's rectangle; Tooltip places itself below it.
                Tooltip.RenderBox(app, clickX, py, bw, t.heightMedium,
                                  "Toggled by click", 1, 0);
            }
            // Manual: the caller owns the on/off state entirely — like Naive
            // UI's "manual" trigger, no pointer involvement at all.
            int manX = clickX + bw + app.Scale(14);
            int mbw = app.Scale(76);
            int showId = new Button { Text = Gallery.T("Show", "显示") }
                .Render(app, manX, py, mbw);
            if (Ui.Clicked(app, showId)) { Gallery.tipManual.Set(true); }
            int hideX = manX + mbw + app.Scale(14);
            int hideId = new Button { Text = Gallery.T("Hide", "隐藏") }
                .Render(app, hideX, py, mbw);
            if (Ui.Clicked(app, hideId)) { Gallery.tipManual.Set(false); }
            if (Gallery.tipManual.Get()) {
                Tooltip.RenderBox(app, manX, py, mbw * 2 + app.Scale(14),
                                  t.heightMedium,
                                  Gallery.T("Controlled by caller state",
                                            "完全由调用方状态控制"),
                                  3, 0);
            }

            // Placements: four widely-spaced anchors, each always-on so all four
            // sides are visible at once without overlapping.
            int rowY = py + app.Scale(120);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, rowY - app.Scale(30),
                Gallery.T("Placements · top / bottom / left / right",
                          "位置 · 上 / 下 / 左 / 右"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int dot = app.Scale(7);
            int pw = w - app.Scale(52);
            int p0 = px + app.Scale(30);
            int pstep = pw / 4;
            c.FillCircle(p0, rowY, dot, t.primary);
            Tooltip.RenderAt(app, p0, rowY - dot, "Top", 0, 0);
            c.FillCircle(p0 + pstep, rowY, dot, t.primary);
            Tooltip.RenderAt(app, p0 + pstep, rowY + dot, "Bottom", 1, 0);
            c.FillCircle(p0 + pstep * 2, rowY, dot, t.primary);
            Tooltip.RenderAt(app, p0 + pstep * 2 - dot, rowY, "Left", 2, 0);
            c.FillCircle(p0 + pstep * 3, rowY, dot, t.primary);
            Tooltip.RenderAt(app, p0 + pstep * 3 + dot, rowY, "Right", 3, 0);

            // Body style: Tooltip.RenderRich paints a two-line bubble — bold
            // title over a muted description — for hint content that needs a
            // little more structure than one plain line.
            int richY = py + app.Scale(250);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, richY - app.Scale(30),
                Gallery.T("Body style · bold title + muted description",
                          "主体样式 · 粗体标题 + 弱化描述"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int richId = new Button { Text = Gallery.T("California girl", "加州女孩") }
                .Render(app, px, richY, bw);
            if (app.focus.IsHovered(richId)) {
                Tooltip.RenderRich(app, px,
                                   richY + t.heightMedium + app.Scale(8),
                                   Gallery.T("California girl", "加州女孩"),
                                   Gallery.T("Bold title on top, muted description below.",
                                             "粗体标题在上，弱化描述在下。"));
            }

            // Long text: wraps automatically; a scrollbar appears past the cap
            // and the wheel scrolls the bubble content while the pointer is over it.
            int longY = py + app.Scale(380);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, longY - app.Scale(8),
                Gallery.T("Long text · auto-wrap + wheel scroll",
                          "长文本 · 自动换行 + 滚轮滚动"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            c.FillCircle(p0, longY + app.Scale(18), dot, t.info);
            string longTip = "Long text wraps automatically onto multiple lines. When it grows past the height cap a scrollbar appears on the right and the mouse wheel scrolls the content while the pointer is over the bubble, so nothing is clipped away and the bubble still stays fully on screen no matter which edge it is near.";
            int tipMaxW = app.Scale(140);
            int tipAX = p0 + dot;
            int tipAY = longY + app.Scale(18);
            Rect tipBox = Tooltip.BoxRect(app, tipAX, tipAY, longTip, 3, tipMaxW);
            if (app.CaptureWheel(tipBox.x, tipBox.y, tipBox.width, tipBox.height)) {
                int wd = app.window.EventKeyCode();
                int cur = Gallery.tipScroll.Get() - wd * app.Scale(24) / 120;
                int tmax = Tooltip.MaxScroll(app, longTip, tipMaxW);
                if (cur < 0) { cur = 0; }
                if (cur > tmax) { cur = tmax; }
                Gallery.tipScroll.Set(cur);
                app.RequestRedraw();
            }
            Tooltip.RenderScroll(app, tipAX, tipAY, longTip, 3, tipMaxW, Gallery.tipScroll.Get());

            // Edge flip: the anchor asks for Right but sits close enough to the
            // window's right edge that the bubble cannot fit, so BoxRect flips
            // it to the Left instead of clipping it.
            int flipY = py + app.Scale(510);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, flipY - app.Scale(30),
                Gallery.T("Edge flip · asked Right, clamped to Left by the window edge",
                          "贴边自动翻转 · 请求 Right，被窗口右缘翻成 Left"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int flipX = px + w - app.Scale(56);
            c.FillCircle(flipX, flipY, dot, t.primary);
            Tooltip.RenderAt(app, flipX, flipY,
                Gallery.T("Asked for Right, flipped to Left near the window edge",
                          "请求 Right，靠近窗口右缘自动翻到 Left"), 3, 0);
            Gallery.RecordBottom(app, name, flipY + app.Scale(44));
        } else if (name == "Spin.plain") {
            Spin big = new Spin(56);
            big.Class = "info";
            Flex row = Flex.Wrapped().Gap(app.Scale(26));
            row.With(new Spin(28));
            row.With(new Spin(40));
            row.With(big);
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(4),
                             w - app.Scale(36), app.Scale(70));
        } else if (name == "Spin.tip") {
            Spin load = new Spin(36);
            load.Tip = "Loading data...";
            load.RenderInside(app, new Rect(px, py - app.Scale(20),
                                               app.Scale(300),
                                               app.Scale(110)));
        } else if (name == "Skeleton") {
            Skeleton dot = new Skeleton(40, 40);
            dot.Class = "circle";
            Panel col = Panel.Column().Gap(app.Scale(12));
            Panel row = Panel.Row().Gap(app.Scale(12));
            row.With(dot);
            row.With(new Skeleton(180, 14));
            col.With(row);
            col.With(new Skeleton(180, 14));
            col.With(new Skeleton(180, 14));
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(4),
                             w - app.Scale(36), app.Scale(120));
        } else if (name == "FloatButton") {
            // A fixed utility rail (like a page's bottom-right dock): a stack of
            // quick actions plus a "back to top" that only appears once the
            // content has been scrolled, and jumps the viewport home when hit.
            int vx = px;
            int vy = py - app.Scale(16);
            int vw = w - app.Scale(120);
            int vh = app.Scale(250);
            int rowH = app.Scale(30);
            int rows = 24;
            int contentH = rowH * rows;
            c.FillRoundRect(vx, vy, vw, vh, app.Scale(4), t.bgPrimary);
            c.DrawRoundRect(vx, vy, vw, vh, app.Scale(4), t.borderPrimary, 1);
            Scrollbar.HandleWheel(app, vx, vy, vw, vh, contentH, Gallery.fbScroll);
            int fbo = Gallery.fbScroll.Get();
            int fbmo = contentH - vh;
            if (fbmo < 0) { fbmo = 0; }
            if (fbo > fbmo) { fbo = fbmo; }
            c.PushClip(vx, vy, vw - app.Scale(16), vh);
            for (int fri = 0; fri < rows; fri = fri + 1) {
                int ry = vy + fri * rowH - fbo + app.Scale(7);
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "", Style.SNormal()),
                    vx + app.Scale(14), ry, Gallery.T("Scrollable content line ", "可滚动内容第 ") + Convert.ToString(fri + 1) + Gallery.T("", " 行"),
                    app.theme.textPrimary, app.theme.fontSizeMedium);
            }
            c.PopClip();
            Scrollbar.RenderVerticalScroll(app, vx + vw - app.Scale(13), vy,
                vh, vh, contentH, Gallery.fbScroll);

            // The floating dock, anchored bottom-right of the viewport.
            int fbSz = app.Scale(46);
            int fbGap = app.Scale(12);
            int stackX = vx + vw + app.Scale(20);
            int stackY = vy + vh - fbSz;
            new FloatButton("settings") { Size = fbSz }
                .Render(app, stackX, stackY);
            new FloatButton("info") { Size = fbSz }
                .Render(app, stackX, stackY - (fbSz + fbGap));
            new FloatButton("bell") { Size = fbSz }
                .Render(app, stackX, stackY - (fbSz + fbGap) * 2);
            if (fbo > 0) {
                int topId = new FloatButton("arrow-up") {
                        Size = fbSz, Class = "primary" }
                    .Render(app, stackX, stackY - (fbSz + fbGap) * 3);
                if (app.window.EventKind() == 3
                        && app.hitTester.HitTest(app.mouseX, app.mouseY) == topId) {
                    Gallery.fbScroll.Set(0);
                    app.RequestRedraw();
                }
            }
        } else if (name == "Scrollbar") {
            // Interactive: mouse-wheel over the list, drag the thumb, or click
            // the track to scroll.
            int vx = px;
            int vy = py - app.Scale(16);
            int vw = app.Scale(300);
            int vh = app.Scale(130);
            int rowH = app.Scale(28);
            int contentH = rowH * 16;
            c.FillRoundRect(vx, vy, vw, vh, app.Scale(4), t.bgPrimary);
            c.DrawRoundRect(vx, vy, vw, vh, app.Scale(4), t.borderPrimary, 1);
            Scrollbar.HandleWheel(app, vx, vy, vw, vh, contentH, Gallery.scrollOff);
            int off = Gallery.scrollOff.Get();
            int mo = contentH - vh;
            if (mo < 0) { mo = 0; }
            if (off > mo) { off = mo; }
            c.PushClip(vx, vy, vw - app.Scale(16), vh);
            for (int ri = 0; ri < 16; ri = ri + 1) {
                int ry = vy + ri * rowH - off + app.Scale(6);
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "", Style.SNormal()),
                    vx + app.Scale(14), ry, Gallery.T("List row ", "列表行 ") + Convert.ToString(ri + 1),
                    app.theme.textPrimary, app.theme.fontSizeMedium);
            }
            c.PopClip();
            Scrollbar.RenderVerticalScroll(app, vx + vw - app.Scale(13), vy,
                vh, vh, contentH, Gallery.scrollOff);
        } else if (name == "Ribbon") {
            List<string> rtabs = new List<string>{
                Gallery.T("Home", "开始"),
                Gallery.T("Insert", "插入"),
                Gallery.T("View", "视图")
            };
            // Each tab shows a different set of groups so switching is visible.
            List<RibbonGroup> rgroups = new List<RibbonGroup>();
            int rtab = Gallery.ribbonTab.Get();
            if (rtab == 1) {
                rgroups = new List<RibbonGroup>{
                    RibbonGroup.Of(Gallery.T("Insert", "插入"), new List<RibbonItem>{
                        RibbonItem.Large("table", Gallery.T("Table", "表格")),
                        RibbonItem.Large("grid", Gallery.T("Grid", "网格"))
                    }),
                    RibbonGroup.Of(Gallery.T("Links", "链接"), new List<RibbonItem>{
                        RibbonItem.Small("globe", Gallery.T("Link", "链接")),
                        RibbonItem.Small("mail", Gallery.T("Mail@邮件", "邮件")),
                        RibbonItem.Small("file", Gallery.T("File", "文件"))
                    })
                };
            } else if (rtab == 2) {
                rgroups = new List<RibbonGroup>{
                    RibbonGroup.Of(Gallery.T("Show", "显示"), new List<RibbonItem>{
                        RibbonItem.Small("eye", Gallery.T("Preview", "预览")),
                        RibbonItem.Small("menu", Gallery.T("Sidebar", "侧栏")),
                        RibbonItem.Small("grid", Gallery.T("Grid", "网格"))
                    }),
                    RibbonGroup.Of(Gallery.T("Zoom", "缩放"), new List<RibbonItem>{
                        RibbonItem.Large("plus", Gallery.T("Zoom In", "放大")),
                        RibbonItem.Large("minus", Gallery.T("Zoom Out", "缩小"))
                    }),
                    RibbonGroup.Of(Gallery.T("Theme", "主题"), new List<RibbonItem>{
                        RibbonItem.Small("sun", Gallery.T("Light", "浅色")),
                        RibbonItem.Small("moon", Gallery.T("Dark", "深色"))
                    })
                };
            } else {
                rgroups = new List<RibbonGroup>{
                    RibbonGroup.Of(Gallery.T("File", "文件"), new List<RibbonItem>{
                        RibbonItem.Large("folder", Gallery.T("Open@打开", "打开")),
                        RibbonItem.Large("save", Gallery.T("Save", "保存"))
                    }),
                    RibbonGroup.Of(Gallery.T("Edit", "编辑"), new List<RibbonItem>{
                        RibbonItem.Small("copy", Gallery.T("Copy", "复制")),
                        RibbonItem.Small("edit", Gallery.T("Rename", "重命名")),
                        RibbonItem.Small("trash", Gallery.T("Delete", "删除"))
                    }),
                    RibbonGroup.Of(Gallery.T("Run", "运行"), new List<RibbonItem>{
                        RibbonItem.Large("play", Gallery.T("Run", "运行")),
                        RibbonItem.Small("bug", Gallery.T("Debug", "调试")),
                        RibbonItem.Small("settings", Gallery.T("Config", "配置"))
                    })
                };
            }
            Ribbon.RenderTabbed(app, px, py - app.Scale(20),
                w - app.Scale(36), rtabs, Gallery.ribbonTab, rgroups);
        } else if (name == "Wizard") {
            // Full inline wizard: template list + name/location fields + a live
            // description + Create/Cancel. (Wizard.Render draws the same layout
            // full-window inside its own dialog -- see the Examples snippet.)
            List<WizardItem> witems = new List<WizardItem>{
                new WizardItem(Gallery.T("Console app", "控制台应用"), "code",
                    Gallery.T("A terminal program with a main() entry point.",
                        "带有 main() 入口的终端程序。")),
                new WizardItem(Gallery.T("GUI app", "图形界面应用"), "grid",
                    Gallery.T("A windowed app built on the Zan GUI toolkit.",
                        "基于 Zan GUI 工具包的窗口应用。")),
                new WizardItem(Gallery.T("Library", "库项目"), "file",
                    Gallery.T("A reusable library with no entry point.",
                        "无入口点的可复用库。"))
            };
            int wListW = app.Scale(240);
            int wy = py - app.Scale(8);
            int wListH = app.Scale(180);
            Wizard.RenderList(app, px, wy, wListW, wListH, witems, Gallery.wizSel);
            int wfx = px + wListW + app.Scale(24);
            int wfw = w - app.Scale(36) - (wListW + app.Scale(24));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                wfx, wy, Gallery.T("Name", "名称"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            Gallery.wizName.Render(app, wfx, wy + app.Scale(20), wfw, t.heightMedium);
            int wny = wy + app.Scale(20) + t.heightMedium + app.Scale(12);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                wfx, wny, Gallery.T("Location", "位置"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            Gallery.wizLoc.Render(app, wfx, wny + app.Scale(20), wfw, t.heightMedium);
            int wdy = wny + app.Scale(20) + t.heightMedium + app.Scale(14);
            int wsel = Gallery.wizSel.Get();
            if (wsel >= 0 && wsel < witems.Count) {
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "secondary", Style.SNormal()),
                    wfx, wdy, witems[wsel].desc,
                    app.theme.textPrimary, app.theme.fontSizeMedium);
            }
            int wby = wy + wListH + app.Scale(16);
            int wbw = app.Scale(104);
            new Button { Text = Gallery.T("Cancel", "取消") }.Render(app, wfx, wby, wbw);
            new Button { Text = Gallery.T("Create", "创建"), Class = "primary" }.Render(
                app, wfx + wbw + t.gapMedium, wby, wbw);
        } else if (name == "Split") {
            // Two real, draggable Split widgets: a vertical divider (left|right)
            // and a horizontal one (top|bottom). Drag the coloured handle.
            int sy = py - app.Scale(16);
            int sh = app.Scale(250);
            int colW = (w - app.Scale(56)) / 2;
            Rect a1 = new Rect(px, sy, colW, sh);
            Split sp = Split.Vertical(app, a1, Gallery.splitVFirst,
                app.Scale(70), app.Scale(70));
            c.FillRect(sp.first.x, sp.first.y, sp.first.width, sp.first.height,
                t.bgSecondary);
            c.FillRect(sp.second.x, sp.second.y, sp.second.width,
                sp.second.height, t.bgTertiary);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                sp.first.x + app.Scale(10), sp.first.y + app.Scale(8), Gallery.T("Left@左侧", "左侧"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                sp.second.x + app.Scale(10), sp.second.y + app.Scale(8), Gallery.T("Right@右侧", "右侧"),
                app.theme.textPrimary, app.theme.fontSizeMedium);

            Rect a2 = new Rect(px + colW + app.Scale(24), sy, colW, sh);
            Split sp2 = Split.Horizontal(app, a2, Gallery.splitHFirst,
                app.Scale(50), app.Scale(50));
            c.FillRect(sp2.first.x, sp2.first.y, sp2.first.width,
                sp2.first.height, t.bgSecondary);
            c.FillRect(sp2.second.x, sp2.second.y, sp2.second.width,
                sp2.second.height, t.bgTertiary);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                sp2.first.x + app.Scale(10), sp2.first.y + app.Scale(8), Gallery.T("Top", "上部"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                sp2.second.x + app.Scale(10), sp2.second.y + app.Scale(8), Gallery.T("Bottom", "下部"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
        } else if (name == "FilePicker") {
            // Live: each button opens the real modal dialog window; the chosen
            // path is read back from TakeResult() in the main loop. The open-file
            // dialog offers several extension filters (see BeginOpenFileFilters).
            int fbw = app.Scale(160);
            int fbh = t.heightMedium;
            int fgap = app.Scale(10);
            int ofId = new Button { Text = Gallery.T("Open file...", "打开文件...") }.Render(app, px, py, fbw);
            if (Ui.Clicked(app, ofId)) {
                List<FileFilter> filters = new List<FileFilter>();
                filters.Add(new FileFilter(
                    Gallery.T("Zan source (*.zan)", "Zan 源文件 (*.zan)"), ".zan"));
                filters.Add(new FileFilter(
                    Gallery.T("Text (*.txt;*.md)", "文本 (*.txt;*.md)"), ".txt;.md"));
                filters.Add(new FileFilter(
                    Gallery.T("Data (*.json)", "数据 (*.json)"), ".json"));
                filters.Add(new FileFilter(
                    Gallery.T("All files (*.*)", "所有文件 (*.*)"), ""));
                Gallery.filePicker.BeginOpenFileFilters("", filters,
                    Gallery.T("Open file", "打开文件"));
            }
            int odId = new Button { Text = Gallery.T("Open folder...", "打开文件夹...") }.Render(
                app, px + fbw + fgap, py, fbw);
            if (Ui.Clicked(app, odId)) {
                Gallery.filePicker.BeginFolder("",
                    Gallery.T("Open folder", "打开文件夹"));
            }
            int fr2 = py + fbh + fgap;
            int sfId = new Button { Text = Gallery.T("Save file...", "保存文件...") }.Render(app, px, fr2, fbw);
            if (Ui.Clicked(app, sfId)) {
                Gallery.filePicker.BeginSaveFile("", ".zan", "untitled.zan",
                    Gallery.T("Save file", "保存文件"));
            }
            int sdId = new Button { Text = Gallery.T("Save to folder...", "保存到文件夹...") }.Render(
                app, px + fbw + fgap, fr2, fbw);
            if (Ui.Clicked(app, sdId)) {
                Gallery.filePicker.BeginFolder("",
                    Gallery.T("Save to folder", "保存到文件夹"));
            }
            int fry = fr2 + fbh + app.Scale(16);
            if (Gallery.pickerResult != "") {
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "", Style.SNormal()),
                    px, fry, Gallery.T("Selected path:", "已选路径："),
                    app.theme.textPrimary, app.theme.fontSizeMedium);
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "secondary", Style.SNormal()),
                    px, fry + app.Scale(20), Ellipsis.Fit(Gallery.pickerResult, w - app.Scale(52), t.fontSizeMedium),
                    app.theme.textPrimary, app.theme.fontSizeMedium);
            } else {
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "secondary", Style.SNormal()),
                    px, fry, Gallery.T("No selection yet -- click a button to open a dialog.", "尚未选择 —— 点击按钮打开对话框。"),
                    app.theme.textPrimary, app.theme.fontSizeMedium);
            }
        } else if (name == "CodeEditor") {
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                px, py - app.Scale(12), "The code panel below is a read-only CodeEditor view.",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py + app.Scale(16), "CodeEditor powers this IDE's editor: highlighting,",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py + app.Scale(38), "line numbers, selection, completion and diagnostics.",
                app.theme.textPrimary, app.theme.fontSizeMedium);
        } else if (name == "ClickEvent") {
            Panel col = Panel.Column().Gap(app.Scale(10));
            col.With(Gallery.evtButton);
            col.With(new Label { Text = "Click fired on the UI thread · count: " + Convert.ToString(Gallery.evtClicks) });
            col.With(new Label { Text = "registered once with  button.Click += handler", Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(8),
                             w - app.Scale(36), app.Scale(120));
        } else if (name == "Events") {
            Panel col = Panel.Column().Gap(app.Scale(10));
            col.With(Gallery.evtStartButton);
            if (Gallery.evtRunning.Get()) {
                col.With(new Label { Text = "Ticks posted from worker thread: " + Convert.ToString(Gallery.evtValue.Get()) });
                col.With(new Label { Text = "running - app.Post marshals each tick to the UI thread", Class = "secondary" });
            } else {
                col.With(new Label { Text = "Ticks posted from worker thread: " + Convert.ToString(Gallery.evtValue.Get()) });
                col.With(new Label { Text = "idle - click to spawn a Thread that reports back safely", Class = "secondary" });
            }
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(8),
                             w - app.Scale(36), app.Scale(120));
        } else if (name == "Hmi.tags") {
            // The tag table itself: one simulated scan drives every column,
            // and the engineering text / percent / alarm state are all derived
            // from the same fixed-point raw counts.
            Gallery.HmiTick(app, x, y, w, h);
            int fs = t.fontSizeSmall;
            int c0 = px;
            int c1 = px + app.Scale(150);
            int c2 = px + app.Scale(250);
            int c3 = px + app.Scale(330);
            int c4 = px + app.Scale(410);
            int hy = py - app.Scale(10);
            c.DrawText(c0, hy, Gallery.T("Tag", "位号"), t.textTertiary, fs);
            c.DrawText(c1, hy, Gallery.T("Value", "工程值"), t.textTertiary, fs);
            c.DrawText(c2, hy, Gallery.T("Raw", "原始值"), t.textTertiary, fs);
            c.DrawText(c3, hy, Gallery.T("Percent", "量程 %"), t.textTertiary, fs);
            c.DrawText(c4, hy, Gallery.T("State", "状态"), t.textTertiary, fs);
            int ry = hy + app.Scale(22);
            c.DrawLine(px, ry - app.Scale(6), px + w - app.Scale(52),
                ry - app.Scale(6), t.divider, 1);
            for (int hi = 0; hi < Gallery.hmiIo.Count(); hi = hi + 1) {
                IoTag tg = Gallery.hmiIo.At(hi);
                int al = tg.Alarm();
                int vc = t.textPrimary;
                string stt = Gallery.T("normal", "正常");
                if (al == 1) { vc = t.info; stt = Gallery.T("LO alarm", "低报"); }
                if (al == 2) { vc = t.error; stt = Gallery.T("HI alarm", "高报"); }
                if (!tg.IsGood()) {
                    vc = t.textDisabled;
                    stt = Gallery.T("bad quality", "坏值");
                }
                c.DrawText(c0, ry, tg.Name(), t.textSecondary, fs);
                c.DrawText(c1, ry, tg.TextWithUnit(), vc, fs);
                c.DrawText(c2, ry, Convert.ToString(tg.Raw()), t.textSecondary, fs);
                c.DrawText(c3, ry, Convert.ToString(tg.Percent()) + " %",
                    t.textSecondary, fs);
                c.DrawText(c4, ry, stt, vc, fs);
                ry = ry + app.Scale(24);
            }
            c.DrawText(px, ry + app.Scale(14),
                Gallery.T("io.AlarmCount() = ", "io.AlarmCount() = ")
                    + Convert.ToString(Gallery.hmiIo.AlarmCount())
                    + Gallery.T("   ·   scan period ", "   ·   采集周期 ")
                    + Convert.ToString(Gallery.hmiIo.Period()) + " ms",
                t.textTertiary, fs);
        } else if (name == "Hmi.digital") {
            Gallery.HmiTick(app, x, y, w, h);
            Flex row = Flex.Wrapped().Gap(app.Scale(12));
            row.With(Gallery.hmiDigPv);
            row.With(Gallery.hmiDigSp);
            row.With(Gallery.hmiDigFlow);
            row.With(Gallery.hmiDigLevel);
            Gallery.LayoutAuto(app,
                Gallery.Captioned(app, row,
                    Gallery.T("Colour is the tag's alarm state; a bad tag reads \"----\".",
                        "颜色即位号的报警状态；坏值位号显示 \"----\"。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(120));
        } else if (name == "Hmi.led") {
            Gallery.HmiTick(app, x, y, w, h);
            Flex row = Flex.Wrapped().Gap(app.Scale(24));
            row.With(Gallery.hmiLedOff);
            row.With(Gallery.hmiLedRun);
            row.With(Gallery.hmiLedWarn);
            row.With(Gallery.hmiLedFault);
            row.With(Gallery.hmiLedComm);
            Panel ledCol = Gallery.Captioned(app, row,
                Gallery.T("States 0 off / 1 green / 2 yellow / 3 red / 4 blue; WARN and FAULT blink.",
                    "状态 0 灭 / 1 绿 / 2 黄 / 3 红 / 4 蓝；WARN 与 FAULT 闪烁。"));
            ledCol.With(Gallery.Caption(
                Gallery.T("COMM turns red while the simulated scan drops out.",
                    "模拟采集中断时 COMM 转红。")));
            Gallery.LayoutAuto(app, ledCol, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(110));
        } else if (name == "Hmi.gauge") {
            Gallery.HmiTick(app, x, y, w, h);
            Flex row = Flex.Wrapped().Gap(app.Scale(18));
            row.With(Gallery.hmiGaugePv);
            row.With(Gallery.hmiGaugeFlow);
            row.With(Gallery.hmiGaugeFree);
            Gallery.LayoutAuto(app,
                Gallery.Captioned(app, row,
                    Gallery.T("The arc is coloured by the tag's alarm limits; the needle follows the tag's alarm state and quality.",
                        "弧段按位号报警限着色；指针颜色跟随位号的报警状态与质量。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(250));
        } else if (name == "Hmi.bargraph") {
            Gallery.HmiTick(app, x, y, w, h);
            // 两根竖条一栏、横条一栏。棒图自己知道该多大（竖 64x180、
            // 横 220x40），所以两栏都不用给尺寸；横条那栏用原子类
            // `grow` 吃掉剩余宽度，宽度不再由这里算。
            Flex barRow = Flex.Wrapped().Gap(app.Scale(28));
            Panel barVert = Panel.Row().Gap(app.Scale(28));
            barVert.With(Gallery.hmiBarPv);
            barVert.With(Gallery.hmiBarFlow);
            Panel barLevel = Gallery.Captioned(app, Gallery.hmiBarLevel,
                Gallery.T("Bargraph.Horizontal() swaps the axis; the thin lines are the LO / HI limits.",
                    "Bargraph.Horizontal() 切换方向；细线是低报 / 高报限。"));
            barLevel.Class = "grow";
            barRow.With(barVert);
            barRow.With(barLevel);
            Gallery.LayoutAuto(app, barRow, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(220));
        } else if (name == "Hmi.trend") {
            // Live rolling trend: HmiTick samples all three pens on a 250 ms
            // beat into their ring buffers, so the window scrolls without the
            // preview holding any history of its own.
            Gallery.HmiTick(app, x, y, w, h);
            // 趋势图的高度是作者定的（它没有固有高度）：钉在控件上，
            // 外层那一列才能把它和说明文字一起量出来。
            Gallery.hmiTrend.Prefer(0, app.Scale(230));
            Gallery.LayoutAuto(app,
                Gallery.Captioned(app, Gallery.hmiTrend,
                    Gallery.T("Pens keep a fixed-capacity ring buffer, so a shift running for days costs no extra memory.",
                        "曲线使用定容环形缓冲，因此连续运行数天也不增长内存。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(280));
        } else if (name == "Hmi.alarmBanner") {
            Gallery.HmiTick(app, x, y, w, h);
            // 横幅、两个按钮、两行说明全部进控件树：按钮改成保留模式
            // 的 Click 事件（不再 Ui.Clicked 配手写坐标），说明文字用
            // caption 类的 Label，于是整块高度由测量得出。
            Panel abCol = Panel.Column().Gap(app.Scale(16));
            abCol.With(Gallery.hmiBanner);
            Flex abBtns = Flex.Wrapped().Gap(app.Scale(10));
            Button abWarn = new Button { Text = Gallery.T("Raise WARN", "产生警告") };
            abWarn.Prefer(app.Scale(150), 0);
            abWarn.Click += () => {
                Gallery.hmiAlarms.Raise("PT104",
                    Gallery.T("filter differential high", "过滤器压差高"), 1);
            };
            Button abFault = new Button { Text = Gallery.T("Raise FAULT", "产生故障"),
                Class = "error" };
            abFault.Prefer(app.Scale(150), 0);
            abFault.Click += () => {
                Gallery.hmiAlarms.Raise("M105",
                    Gallery.T("motor overload tripped", "电机过载跳闸"), 2);
            };
            abBtns.With(abWarn);
            abBtns.With(abFault);
            abCol.With(abBtns);
            abCol.With(Gallery.Caption(
                Gallery.T("Unacknowledged: ", "未确认：")
                    + Convert.ToString(Gallery.hmiAlarms.UnackedCount())
                    + Gallery.T("   ·   buffered: ", "   ·   缓冲：")
                    + Convert.ToString(Gallery.hmiAlarms.Count())));
            abCol.With(Gallery.Caption(
                Gallery.T("The banner blinks until acknowledged; its Ack button clears the whole buffer.",
                    "横幅在确认前持续闪烁；确认按钮一次清掉整个缓冲。")));
            Gallery.LayoutAuto(app, abCol, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(190));
        } else if (name == "Hmi.alarmList") {
            Gallery.HmiTick(app, x, y, w, h);
            AlarmItem sel = Gallery.hmiAlarmList.SelectedItem();
            string selTxt = Gallery.T("No row selected -- click one.",
                "尚未选中行 —— 点击任意一行。");
            if (sel != null) {
                selTxt = Gallery.T("Selected: @已选：", "已选：") + sel.Point()
                    + "  " + sel.Message();
            }
            Gallery.hmiAlarmList.Prefer(0, app.Scale(200));
            Panel alCol = Gallery.Captioned(app, Gallery.hmiAlarmList, selTxt);
            alCol.With(Gallery.Caption(
                Gallery.T("Same AlarmBuffer as the banner demo, so an ack there shows up here.",
                    "与横幅示例共用同一个 AlarmBuffer，因此在那里确认这里同步生效。")));
            Gallery.LayoutAuto(app, alCol, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(270));
        } else if (name == "Hmi.numpad") {
            Gallery.HmiTick(app, x, y, w, h);
            // 键盘一栏、数显加三行说明一栏。两个控件都有固有尺寸
            // （键盘 200x260、数显 150x72），说明文字进树参与测量，
            // 右栏 grow 占满剩余宽度。
            Flex padRow = Flex.Wrapped().Gap(app.Scale(24));
            padRow.With(Gallery.hmiPad);
            Panel padSide = Panel.Column().Gap(app.Scale(10));
            padSide.Class = "grow";
            padSide.With(Gallery.hmiDigSp);
            padSide.With(Gallery.Caption(
                Gallery.T("Type a value, then ENT -- the keypad converts it to raw counts (scale 10) and writes TIC101.SV.",
                    "输入数值后按 ENT —— 键盘按刻度（10）换算成原始计数并写入 TIC101.SV。")));
            padSide.With(new Label {
                Text = Gallery.T("Entry buffer: ", "输入缓冲：") + "\""
                    + Gallery.hmiPad.Text() + "\"",
                Class = "hint" });
            padSide.With(Gallery.Caption(
                Gallery.T("The trend's SV pen follows every commit.",
                    "趋势图的 SV 曲线随每次写入变化。")));
            padRow.With(padSide);
            Gallery.LayoutAuto(app, padRow, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(290));
        } else if (name == "Hmi.equip") {
            Gallery.HmiTick(app, x, y, w, h);
            Gallery.LayoutAuto(app,
                Gallery.Captioned(app, Gallery.hmiWall,
                    Gallery.T("The panel is the container: it reflows its cards into as many columns as the width allows.",
                        "面板本身就是容器：按可用宽度把卡片重排成相应的列数。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(340));
        } else if (name == "Hmi.deviceCard") {
            Gallery.HmiTick(app, x, y, w, h);
            Gallery.hmiCard.Prefer(app.Scale(250), app.Scale(132));
            Panel notes = Panel.Column().Gap(app.Scale(8));
            notes.With(Gallery.Caption(
                Gallery.T("The status chip and the left colour bar cycle through the five states.",
                    "状态标签与左侧色条在五种状态间循环。")));
            notes.With(Gallery.Caption(
                Gallery.T("Value rows read their tags directly, so no per-card copy exists.",
                    "数值行直接读位号，因此卡片内没有值的副本。")));
            // 卡片在左、说明在右；窄窗口下说明整块折到卡片下面，
            // 而不是被右边缘切掉。
            Flex cardRow = Flex.Wrapped().Gap(app.Scale(18));
            cardRow.With(Gallery.hmiCard);
            cardRow.With(notes);
            Gallery.LayoutAuto(app, cardRow, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(150));
        } else if (name == "Button.tertiary") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Button { Text = "Default", Tertiary = true });
            row.With(new Button { Text = "Primary", Tertiary = true, Class = "primary" });
            row.With(new Button { Text = "Info",    Tertiary = true, Class = "info" });
            row.With(new Button { Text = "Success", Tertiary = true, Class = "success" });
            row.With(new Button { Text = "Warning", Tertiary = true, Class = "warning" });
            row.With(new Button { Text = "Error",   Tertiary = true, Class = "error" });
            Gallery.LayoutAuto(app, row, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(34));
        } else if (name == "Button.quaternary") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Button { Text = "Default", Quaternary = true });
            row.With(new Button { Text = "Primary", Quaternary = true, Class = "primary" });
            row.With(new Button { Text = "Info",    Quaternary = true, Class = "info" });
            row.With(new Button { Text = "Success", Quaternary = true, Class = "success" });
            row.With(new Button { Text = "Warning", Quaternary = true, Class = "warning" });
            row.With(new Button { Text = "Error",   Quaternary = true, Class = "error" });
            Gallery.LayoutAuto(app, row, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(34));
        } else if (name == "Button.color") {
            int brand = 0xFF1890FF;
            int warm = 0xFFFF7A45;
            int mint = 0xFF18A058;
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Button { Text = "Primary", Color = brand });
            row.With(new Button { Text = "Warm", Color = warm });
            row.With(new Button { Text = "Mint", Color = mint });
            row.With(new Button { Text = "Strong", Color = brand, Strong = true });
            Gallery.LayoutAuto(app, row, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(34));
        } else if (name == "Button.iconButton") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Button { Icon = "search", Class = "primary circle" });
            row.With(new Button { Icon = "edit", Class = "info circle" });
            row.With(new Button { Icon = "trash", Class = "error circle outline" });
            row.With(new Button { Icon = "download", Class = "success round" });
            row.With(new Button { Icon = "plus", Class = "circle", Tip = "Add" });
            Gallery.LayoutAuto(app, row, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(34));
        } else if (name == "Button.strong") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Button { Text = "Default" });
            row.With(new Button { Text = "Strong", Strong = true });
            row.With(new Button { Text = "Primary", Class = "primary" });
            row.With(new Button { Text = "Strong + Primary", Class = "primary",
                Strong = true });
            row.With(new Button { Text = "Tertiary + Strong", Tertiary = true,
                Strong = true });
            Gallery.LayoutAuto(app, row, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(34));
        } else if (name == "Button.events") {
            Button b = new Button { Text = "Click me", Class = "primary" };
            b.Click += () => {
                Gallery.evtClicks = Gallery.evtClicks + 1;
            };
            Panel col = Panel.Column().Gap(app.Scale(10));
            col.With(b);
            col.With(new Label {
                Text = "clicked " + Convert.ToString(Gallery.evtClicks)
                    + " time(s) -- Click is a UiEvent; On adds Enter/Leave/...",
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(84));
        } else if (name == "Button.popover") {
            // Hover tip rides the built-in Tip; the second button toggles an
            // anchored Tooltip.RenderBox to show the programmatic pattern.
            Button hoverB = new Button { Text = "Hover me",
                Tip = "Shown on hover after 900ms" };
            hoverB.Render(app, px, py - app.Scale(8), app.Scale(120));
            int pbx = px + app.Scale(140);
            Button popB = new Button { Text = "Toggle tip", Class = "primary" };
            popB.Click += () => {
                Gallery.popTipOn.Set(!Gallery.popTipOn.Get());
            };
            popB.Render(app, pbx, py - app.Scale(8), app.Scale(130));
            if (Gallery.popTipOn.Get()) {
                Tooltip.RenderBox(app, pbx, py - app.Scale(8), app.Scale(130),
                    t.heightMedium, "Toggled by click", 1, 0);
            }
        } else if (name == "Input.password") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Password", Gallery.demoPw,
                    Gallery.T("Masked with *; the trailing eye reveals it while keeping the caret.",
                        "以 * 掩码显示；尾端眼睛图标在保持光标的同时切回明文。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.size") {
            Panel col = Panel.Column().Gap(app.Scale(10));
            Panel r1 = Panel.Row().Gap(app.Scale(10));
            r1.With(new Label { Text = "Tiny" });
            r1.With(Gallery.demoTiny);
            Panel r2 = Panel.Row().Gap(app.Scale(10));
            r2.With(new Label { Text = "Small" });
            r2.With(Gallery.demoSmall);
            Panel r3 = Panel.Row().Gap(app.Scale(10));
            r3.With(new Label { Text = "Large" });
            r3.With(Gallery.demoLargeF);
            col.With(r1);
            col.With(r2);
            col.With(r3);
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34), app.Scale(420),
                app.Scale(150));
        } else if (name == "Input.clearable") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Clearable", Gallery.demoClr,
                    Gallery.T("Type something and stay focused: an X appears in the trailing slot.",
                        "输入内容并保持聚焦：尾端出现 X，点击清空。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.autoselect") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Autoselect", Gallery.demoAuto,
                    Gallery.T("Click away, then back in: everything is selected so typing replaces it all.",
                        "先点别处再点回来：内容全选，直接输入即整段替换。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.icons") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Icons", Gallery.demoIcons,
                    Gallery.T("iconLead / iconTrail reserve glyph slots so text never runs under them.",
                        "iconLead / iconTrail 预留图标槽位，文本不会滑到图标下面。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.disabled") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Label { Text = "Disabled" });
            row.With(Gallery.demoOff);
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(8), app.Scale(360),
                t.heightMedium);
        } else if (name == "Input.error") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Label { Text = "Email" });
            row.With(Gallery.demoErr);
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(8), app.Scale(360),
                t.heightMedium);
        } else if (name == "Input.slots") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Prefix / suffix", Gallery.demoSlot,
                    Gallery.T("Text slots live outside the edit area; PrefixIcon keeps the leading glyph.",
                        "文字槽在编辑区外；PrefixIcon 保留前端图标槽。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.loading") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Loading", Gallery.demoLoad,
                    Gallery.T("The trailing slot becomes a spinner while an async op runs.",
                        "异步进行时尾端槽位变转圈。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.count") {
            Panel colC = Panel.Column().Gap(app.Scale(10));
            colC.With(Gallery.FieldWithCaption(app, "Show count", Gallery.demoCount,
                Gallery.T("\"current / max\" under the box, right-aligned; the cap counts code points.",
                    "框下右对齐显示「当前 / 上限」；上限按码点计数。")));
            colC.With(Gallery.FieldWithCaption(app, "Count graphemes", Gallery.demoGraph,
                Gallery.T("With countGraphemes the skin-thumb and the ZWJ family each count as ONE.",
                    "开启 countGraphemes 后，肤色拇指与 ZWJ 家庭各按 1 字计。")));
            Gallery.LayoutAuto(app, colC, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(150));
        } else if (name == "Input.filter") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Only digits", Gallery.demoDigits,
                    Gallery.T("Filter (allow-input) rewrites every candidate; rejected text never lands.",
                        "Filter（allow-input）逐候选改写；被拒绝的输入不会落地。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.round") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Round", Gallery.demoRound,
                    Gallery.T("Border-radius goes pill.",
                        "边框圆角拉成药丸形。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.status") {
            Panel rowS = Panel.Row().Gap(app.Scale(14));
            rowS.With(Gallery.FieldWithCaption(app, "Success", Gallery.demoOk, ""));
            rowS.With(Gallery.FieldWithCaption(app, "Warning", Gallery.demoWarn, ""));
            Gallery.LayoutAuto(app, rowS, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.passive") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Passively activated", Gallery.demoPassive,
                    Gallery.T("Looks disabled until Enter arms it (Naive UI passively-activated).",
                        "外观禁用，按回车激活（Naive UI passively-activated）。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(70));
        } else if (name == "Input.manual") {
            Button bClr = new Button { Text = Gallery.T("Clear", "清空") };
            bClr.Click += () => { Gallery.demoManual.Clear(); Gallery.manualLog.Text = "Clear()"; };
            Button bSel = new Button { Text = Gallery.T("Select all", "全选") };
            bSel.Click += () => { Gallery.demoManual.Focus(); Gallery.demoManual.SelectAll(); Gallery.manualLog.Text = "SelectAll()"; };
            Button bEnd = new Button { Text = Gallery.T("Scroll to end", "末尾") };
            bEnd.Click += () => { Gallery.demoManual.Focus(); Gallery.demoManual.ScrollToEnd(); Gallery.manualLog.Text = "ScrollToEnd()"; };
            Button bBlur = new Button { Text = Gallery.T("Blur", "失焦") };
            bBlur.Click += () => { Gallery.demoManual.Blur(); Gallery.manualLog.Text = "Blur()"; };
            Panel colM = Panel.Column().Gap(app.Scale(8));
            colM.With(Gallery.demoManual);
            Panel rowM = Panel.Row().Gap(app.Scale(8));
            rowM.With(bClr);
            rowM.With(bSel);
            rowM.With(bEnd);
            rowM.With(bBlur);
            colM.With(rowM);
            colM.With(Gallery.manualLog);
            Gallery.LayoutAuto(app, colM, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(150));
        } else if (name == "InputOtp") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Verification code", Gallery.demoOtp,
                    Gallery.T("Six cells, one character per cell; type to fill left to right, Backspace walks back.",
                        "六个格子，一格一字符；键入从左到右填充，退格向回走。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(90));
        } else if (name == "InputOtp.mask") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Password mode", Gallery.demoOtpMask,
                    Gallery.T("MaskMode shows a dot (or MaskChar) per filled cell.",
                        "MaskMode：已填格子以圆点（或 MaskChar）显示。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(90));
        } else if (name == "InputOtp.block") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Block", Gallery.demoOtpBlock,
                    Gallery.T("Block stretches the cells across the full width given to Render.",
                        "Block：格子横向平铺到 Render 给的整个宽度。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(90));
        } else if (name == "InputOtp.status") {
            Panel colO = Panel.Column().Gap(app.Scale(10));
            colO.With(Gallery.Captioned(app, Gallery.demoOtpRo,
                Gallery.T("readonly — focusable, never edits", "只读 — 可聚焦、不可编辑")));
            colO.With(Gallery.Captioned(app, Gallery.demoOtpDis,
                Gallery.T("disabled", "禁用")));
            colO.With(Gallery.Captioned(app, Gallery.demoOtpWarn,
                    Gallery.T("status warning", "状态 warning")));
            colO.With(Gallery.Captioned(app, Gallery.demoOtpErr,
                    Gallery.T("status error", "状态 error")));
            Gallery.LayoutAuto(app, colO, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(230));
        } else if (name == "InputOtp.group") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Custom render", Gallery.demoOtpGroup,
                    Gallery.T("Groups {2,2,2} + separator '-' draws 65-43-21.",
                        "Groups {2,2,2} 加分隔符 '-'，渲染成 65-43-21。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(90));
        } else if (name == "InputOtp.size") {
            Panel colS = Panel.Column().Gap(app.Scale(10));
            colS.With(Gallery.Captioned(app, Gallery.demoOtpSmall, "small"));
            colS.With(Gallery.Captioned(app, Gallery.demoOtpMed, "medium"));
            colS.With(Gallery.Captioned(app, Gallery.demoOtpLarge, "large"));
            Gallery.LayoutAuto(app, colS, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(180));
        } else if (name == "InputOtp.form") {
            // 配合表单：data 双向绑定 model.otpCode，验证按钮读 IsFull。
            Button bOtp = new Button { Text = Gallery.T("Verify", "验证"), Class = "primary" };
            bOtp.Click += () => {
                if (Gallery.demoOtpForm.IsFull()) {
                    Gallery.demoOtpForm.SetStatus("");
                    Gallery.otpFormLog.Text = Gallery.T("code: ", "验证码：")
                        + Gallery.demoOtpForm.GetCode();
                } else {
                    Gallery.demoOtpForm.SetStatus(Control.StatusError());
                    Gallery.otpFormLog.Text = Gallery.T("please enter the 6-digit code",
                        "请输入完整 6 位验证码");
                }
            };
            Panel rowF = Panel.Row().Gap(app.Scale(10));
            rowF.With(new Label { Text = Gallery.T("Verification code", "验证码") });
            rowF.With(Gallery.demoOtpForm);
            rowF.With(bOtp);
            Panel colF = Panel.Column().Gap(app.Scale(8));
            colF.With(rowF);
            colF.With(Gallery.otpFormLog);
            Gallery.LayoutAuto(app, colF, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(110));
        } else if (name == "InputOtp.allowinput") {
            Panel colA = Panel.Column().Gap(app.Scale(10));
            colA.With(Gallery.Captioned(app, Gallery.demoOtpDigits,
                Gallery.T("Filter = Input.OnlyDigits — letters are silently dropped",
                          "Filter = Input.OnlyDigits — 字母被静默丢弃")));
            colA.With(Gallery.Captioned(app, Gallery.demoOtpLetters,
                Gallery.T("Filter = InputOtp.OnlyLetters — digits are silently dropped",
                          "Filter = InputOtp.OnlyLetters — 数字被静默丢弃")));
            Gallery.LayoutAuto(app, colA, name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(150));
        } else if (name == "DatePicker") {
            // 各模式并排。月历/宫格弹层由 DatePicker 自己在框架的覆盖
            // 层里画（OnPaintOverlay），所以这里和普通字段没有区别：
            // 排进去就行。
            Flex row = Flex.Wrapped().Gap(app.Scale(18));
            row.With(Gallery.Captioned(app, Gallery.demoDay,
                Gallery.T("date — the default", "date — 默认")));
            row.With(Gallery.Captioned(app, Gallery.demoWhen,
                Gallery.T("datetime — extra hour/minute row",
                          "datetime — 弹层多一行时分")));
            row.With(Gallery.Captioned(app, Gallery.demoSpan,
                Gallery.T("daterange — two-month panel, click start then end",
                          "daterange — 左右双月历，点起始再点结束")));
            Gallery.LayoutAuto(app, row, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(70));
            // 第二行：Naive UI 其余取值粒度（周/月/季度/年 + 月区间）。
            Flex row2 = Flex.Wrapped().Gap(app.Scale(18));
            row2.With(Gallery.Captioned(app, Gallery.demoWeek,
                Gallery.T("week — click any day to take the whole week",
                          "week — 点任意一天选中整周")));
            row2.With(Gallery.Captioned(app, Gallery.demoMonth,
                Gallery.T("month — 12-cell grid", "month — 12 宫格选月")));
            row2.With(Gallery.Captioned(app, Gallery.demoQuarter,
                Gallery.T("quarter — Q1..Q4", "quarter — Q1-Q4 选季度")));
            row2.With(Gallery.Captioned(app, Gallery.demoYear,
                Gallery.T("year — 12-year page", "year — 12 年一页")));
            row2.With(Gallery.Captioned(app, Gallery.demoMonthRange,
                Gallery.T("monthrange — two panels, start then end",
                          "monthrange — 双面板选月区间")));
            Gallery.LayoutAuto(app, row2, name, px, y + app.Scale(116),
                w - app.Scale(36), app.Scale(70));
        } else if (name == "ColorPicker") {
            // 弹层由 ColorPicker 自己在框架的覆盖层里画
            // （OnPaintOverlay），这里和普通字段没有区别：排进去就行。
            Panel col = Panel.Column().Gap(app.Scale(10));
            col.With(new Label {
                Text = Gallery.T("value = ", "当前值 = ")
                    + Gallery.demoCp.Text()
                    + Gallery.T("  -- drag the panel / bars, or type in any format.",
                                "  —— 拖色盘 / 色条，或直接输入任意格式。"),
                Class = "secondary" });
            col.With(Gallery.demoCp);
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(76));
        } else if (name == "ColorPicker.noalpha") {
            Panel col = Panel.Column().Gap(app.Scale(10));
            col.With(Gallery.Captioned(app, Gallery.demoCpNoAlpha,
                Gallery.T("showAlpha = false -- the alpha bar is hidden and the value is always opaque (rgb() / #RRGGBB).",
                          "showAlpha = false —— 透明度条隐藏，取值恒为不透明（rgb() / #RRGGBB）。")));
            col.With(Gallery.Captioned(app, Gallery.demoCpHex,
                Gallery.T("modes = [\"hex\"] -- the format tabs collapse to one, the value reads #RRGGBBAA.",
                          "modes = [\"hex\"] —— 格式页签只剩一个，取值恒为 #RRGGBBAA。")));
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(150));
        } else if (name == "ColorPicker.form") {
            // 配合表单：data 双向绑定 model.cpForm，Change 报 LIVE STATES，
            // 下方灰字实时回显最新取值文本。
            Panel colF = Panel.Column().Gap(app.Scale(8));
            colF.With(Gallery.demoCpForm);
            colF.With(Gallery.cpFormLog);
            Gallery.LayoutAuto(app, colF, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(90));
        } else if (name == "Avatar.shape") {
            Avatar aC = new Avatar("A", 44, "");
            Avatar aR = new Avatar("R", 44, "");
            aR.Shape = "rounded";
            Avatar aS = new Avatar("S", 44, "");
            aS.Shape = "square";
            Flex row = Flex.Wrapped().Gap(app.Scale(24));
            row.With(aC);
            row.With(aR);
            row.With(aS);
            Gallery.LayoutAuto(app,
                Gallery.Captioned(app, row,
                    "circle (default)      rounded      square"),
                name, px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(80));
        } else if (name == "Form") {
            Gallery.LayoutAuto(app, Gallery.demoForm, name,
                px, y + app.Scale(34), w - app.Scale(36),
                app.Scale(280));
        } else if (name == "Form.validate") {
            // 整棵 FormGroup 是保留态（Main 里建一次）：输入焦点、
            // 校验状态、按钮处理器都跨帧存活。
            Gallery.LayoutAuto(app, Gallery.demoSignup, name,
                px, y + app.Scale(34), w - app.Scale(36), app.Scale(470));
        } else if (name == "Form.dependencies") {
            // 联动是每帧按模型值同步的（gallery 的轮询写法）：radio 选
            // 「到店自提」时地址行隐藏、门店行出现；两个 switch 分别
            // 控制贺卡与抬头行。隐藏的行不参与 Validate。
            bool express = Gallery.model.orderShip == 0;
            FormRow addrRow = Gallery.demoOrder.Field("addr");
            FormRow storeRow = Gallery.demoOrder.Field("store");
            FormRow noteRow = Gallery.demoOrder.Field("giftNote");
            FormRow titleRow = Gallery.demoOrder.Field("title");
            if (addrRow != null) { addrRow.SetShown(express); }
            if (storeRow != null) { storeRow.SetShown(!express); }
            if (noteRow != null) { noteRow.SetShown(Gallery.model.orderGift); }
            if (titleRow != null) { titleRow.SetShown(Gallery.model.orderInvoice); }
            Gallery.LayoutAuto(app, Gallery.demoOrder, name,
                px, y + app.Scale(34), w - app.Scale(36), app.Scale(520));
        } else if (name == "Switch.states") {
            // 每帧组装行是本文件 radio/checkbox 演示的同一写法：开关的
            // 状态都在模型字段里，行本身只是当帧的排布。
            Switch swMini = new Switch();
            swMini.Size = "tiny";
            swMini.data = Gallery.model.toggle;
            Switch swTiny = new Switch();
            swTiny.Class = "small";
            swTiny.data = Gallery.model.toggle;
            Switch swLarge = new Switch();
            swLarge.Class = "large";
            swLarge.data = Gallery.model.toggle;
            Switch swLoading = new Switch();
            swLoading.Loading = true;
            Switch swSquare = new Switch();
            swSquare.Round = false;
            swSquare.data = Gallery.model.toggleB;
            Switch swOff = new Switch();
            swOff.data = Gallery.model.toggleB;
            Switch swDis = new Switch();
            swDis.Disabled = true;
            swDis.data = Gallery.model.toggle;
            Flex row = Flex.Wrapped().Gap(app.Scale(16));
            row.With(swMini);
            row.With(swTiny);
            row.With(Gallery.demoSwitch);
            row.With(swLarge);
            row.With(swLoading);
            row.With(swSquare);
            row.With(swOff);
            row.With(swDis);
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(row);
            col.With(new Label {
                Text = Gallery.T("toggle is ", "当前状态：")
                    + (Gallery.model.toggle
                        ? Gallery.T("ON", "开") : Gallery.T("OFF", "关")),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(110));
        } else if (name == "Switch.master") {
            // 总开关关 -> 整组 Disabled（沿树继承，置灰 + 不响应），
            // 每帧从模型值同步，无需事件订阅。
            Gallery.demoMasterGroup.Disabled = !Gallery.model.masterOn;
            Panel head = Panel.Row().Gap(app.Scale(12));
            head.With(Gallery.demoMaster);
            head.With(new Label(Gallery.T("Power features", "高级功能")));
            Panel col = Panel.Column().Gap(app.Scale(10));
            col.With(head);
            col.With(Gallery.demoMasterGroup);
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(140));
        } else if (name == "Radio.dependent") {
            // 依赖联动（禁用形态）：选中「其他」才允许编辑备注；字段
            // 一直可见但 Disabled 随组值变化，与 Form.dependencies 的
            // 整行显隐互补。备注框是保留态输入框，打字焦点不漂移。
            Radio hearAd = new Radio(0, Gallery.T("From an ad", "广告"));
            hearAd.data = Gallery.model.howhear;
            Radio hearFriend = new Radio(1, Gallery.T("A friend", "朋友推荐"));
            hearFriend.data = Gallery.model.howhear;
            Radio hearOther = new Radio(2, Gallery.T("Other", "其他"));
            hearOther.data = Gallery.model.howhear;
            Gallery.demoHowhearNote.Disabled = Gallery.model.howhear != 2;
            Panel col = Panel.Column().Gap(app.Scale(10));
            col.With(new Label(Gallery.T("How did you hear about us?", "你从哪里了解到我们？")));
            col.With(Panel.Row().Gap(app.Scale(18))
                .With(hearAd).With(hearFriend).With(hearOther));
            col.With(Gallery.demoHowhearNote);
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(130));
        } else if (name == "Switch.settings") {
            // 设置卡片行：卡片（Column + 卡片表面）里一行 Flex——左侧
            // 标题 + 描述，右侧开关由 grow 占位推到行尾；底部一行实时
            // 汇总启用数。行每帧重建，开关是保留态。
            Panel col = Panel.Column().Gap(app.Scale(8));
            col.With(Gallery.SettingsRow(app,
                Gallery.T("Background sync", "后台同步"),
                Gallery.T("Changes upload automatically while you work",
                    "改动在工作时自动上传"),
                Gallery.demoSetSync));
            col.With(Gallery.SettingsRow(app,
                Gallery.T("Compact rows", "紧凑行距"),
                Gallery.T("Fit more content on screen", "一屏容纳更多内容"),
                Gallery.demoSetCompact));
            col.With(Gallery.SettingsRow(app,
                Gallery.T("Public profile", "公开资料"),
                Gallery.T("Anyone can see your stats", "任何人都能看到你的统计"),
                Gallery.demoSetPublic));
            int n = (Gallery.model.setSync ? 1 : 0)
                + (Gallery.model.setCompact ? 1 : 0)
                + (Gallery.model.setPublic ? 1 : 0);
            col.With(new Label {
                Text = Gallery.T(Convert.ToString(n) + " of 3 enabled",
                    Convert.ToString(n) + " / 3 项已启用"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(210));
            if (n != Gallery.setPrevCount) {
                Gallery.setPrevCount = n;
                Gallery.Fired(app, name, Convert.ToString(n) + "/3");
            }
        } else if (name == "Switch.async") {
            // 异步保存：拨动不立即生效——把点击回卷成「没点过」，点亮
            // Loading 跑约半秒，完成那一刻才落值。操作期间的再点击同样
            // 被回卷，小状态机只有一个入口，没有事件时序要操心。
            if (Gallery.asyncPending > 0) {
                Gallery.model.asyncOn = Gallery.asyncApplied;
                Gallery.asyncPending = Gallery.asyncPending - 1;
                if (Gallery.asyncPending == 0) {
                    Gallery.model.asyncOn = Gallery.asyncTarget;
                    Gallery.asyncApplied = Gallery.asyncTarget;
                    Gallery.demoAsyncSw.Loading = false;
                    Gallery.Fired(app, name, Gallery.T("Saved", "已保存"));
                }
            } else if (Gallery.model.asyncOn != Gallery.asyncApplied) {
                Gallery.asyncTarget = Gallery.model.asyncOn;
                Gallery.model.asyncOn = Gallery.asyncApplied;
                Gallery.asyncPending = 36;
                Gallery.demoAsyncSw.Loading = true;
            }
            Panel col = Panel.Column().Gap(app.Scale(8));
            Flex row = Flex.Wrapped().Gap(app.Scale(12));
            row.With(Gallery.demoAsyncSw);
            row.With(new Label { Text = Gallery.T("Cloud sync", "云同步") });
            col.With(row);
            Label st = new Label { Class = "secondary" };
            if (Gallery.asyncPending > 0) {
                st.Text = Gallery.T("Saving…", "正在保存…");
            } else if (Gallery.asyncApplied) {
                st.Text = Gallery.T("Synced just now", "刚刚完成同步");
            } else {
                st.Text = Gallery.T("Sync is off", "同步未开启");
            }
            col.With(st);
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(120));
        } else if (name == "Switch.content") {
            // 内嵌内容：文字/图标画在拇指对侧空区、轨道自动撑宽；
            // Round=false 得方形；自定义色覆盖皮肤 off/on 底色
            // （Progress color= 同款约定，0 = 跟随皮肤）。
            Switch swTxt = new Switch();
            swTxt.CheckedText = "开";
            swTxt.UncheckedText = "关";
            swTxt.data = Gallery.model.toggle;
            Switch swIco = new Switch();
            swIco.CheckedIcon = "check";
            swIco.UncheckedIcon = "close";
            swIco.data = Gallery.model.toggleB;
            Switch swSq = new Switch();
            swSq.Round = false;
            swSq.CheckedText = "开";
            swSq.UncheckedText = "关";
            swSq.data = Gallery.model.toggle;
            Switch swCol = new Switch();
            swCol.CheckedColor = 0x1677FF;
            swCol.UncheckedColor = 0x0E9F6E;
            swCol.CheckedText = "开";
            swCol.data = Gallery.model.toggleB;
            Switch swLoad = new Switch();
            swLoad.Loading = true;
            swLoad.CheckedText = "同步";
            swLoad.data = Gallery.model.toggle;
            Flex row = Flex.Wrapped().Gap(app.Scale(16));
            row.With(swTxt);
            row.With(swIco);
            row.With(swSq);
            row.With(swCol);
            row.With(swLoad);
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(row);
            col.With(new Label {
                Text = Gallery.T("Inner text/icons widen the track; "
                    + "Round=false squares it; custom colors override "
                    + "the skin; Loading spins on the thumb and deafens clicks.",
                    "内嵌文字/图标会撑宽轨道；Round=false 得方形；"
                    + "自定义色覆盖皮肤底色；Loading 在拇指上转圈并屏蔽点击。"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(150));
        } else if (name == "Switch.value") {
            // 自定义选中值：开关表达「model.swVal == CheckedValue」，
            // 拨动写回 10/20（Ant Design checked-value / unchecked-value）。
            Panel col = Panel.Column().Gap(app.Scale(8));
            Flex row = Flex.Wrapped().Gap(app.Scale(12));
            row.With(Gallery.demoSwVal);
            row.With(new Label { Text = Gallery.T("Server status (int field)",
                                                  "服务器状态（int 字段）") });
            col.With(row);
            Label st = new Label { Class = "secondary" };
            if (Gallery.model.swVal == 10) {
                st.Text = Gallery.T("model.swVal = 10 (ON)", "swVal = 10（开）");
            } else if (Gallery.model.swVal == 20) {
                st.Text = Gallery.T("model.swVal = 20 (OFF)", "swVal = 20（关）");
            } else {
                st.Text = Gallery.T("model.swVal = ", "swVal = ")
                    + Convert.ToString(Gallery.model.swVal)
                    + Gallery.T(" (neither value -> switch shows off)",
                                "（两值皆非 → 开关显示关）");
            }
            col.With(st);
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(110));
        } else if (name == "Radio.cards") {
            // 卡片选择：点整张卡即选中，不必瞄准小圆点。卡片每帧重建
            // 没关系——布局完成后读回每张卡的实际矩形，用 Ui.Activate 把
            // 命中区域注册成整卡：几何点击与聚焦后的键盘激活都算换选。
            // 单选钮仍是共享 radioPick 的保留态 Radio；选中的卡再描一圈
            // 主题强调色边，未选中的卡悬停时淡入同色的细边。
            int id0 = WidgetId.Next();
            int id1 = WidgetId.Next();
            int id2 = WidgetId.Next();
            Panel col = Panel.Column().Gap(app.Scale(8));
            Panel c0 = Gallery.PickCard(app, Gallery.demoPick0,
                Gallery.T("Starter", "入门版"),
                Gallery.T("Up to 3 projects", "最多 3 个项目"),
                Gallery.model.radioPick == 0);
            col.With(c0);
            Panel c1 = Gallery.PickCard(app, Gallery.demoPick1,
                Gallery.T("Team", "团队版"),
                Gallery.T("Unlimited projects, shared workspaces",
                    "项目数不限，共享工作区"),
                Gallery.model.radioPick == 1);
            col.With(c1);
            Panel c2 = Gallery.PickCard(app, Gallery.demoPick2,
                Gallery.T("Enterprise", "企业版"),
                Gallery.T("SSO, audit logs, dedicated support",
                    "SSO 登录、审计日志、专属支持"),
                Gallery.model.radioPick == 2);
            col.With(c2);
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(230));
            StyleBox cards = Style.Of(app, "card", "", Style.SNormal());
            int acc = cards.AccentOr(0);
            int rad = cards.RadiusOr(t.borderRadiusMedium);
            Gallery.PickCardHit(app, id0, c0, 0, acc, rad);
            Gallery.PickCardHit(app, id1, c1, 1, acc, rad);
            Gallery.PickCardHit(app, id2, c2, 2, acc, rad);
            if (Gallery.model.radioPick != Gallery.radioPickPrev) {
                Gallery.radioPickPrev = Gallery.model.radioPick;
                Gallery.Fired(app, name, Gallery.T("Picked -> plan ",
                    "已选择 -> 套餐 ")
                    + Convert.ToString(Gallery.radioPickPrev + 1));
            }
        } else if (name == "CheckboxGroup") {
            // 子项留在 Gallery.demoCbg 上，勾选状态跨帧保持。“全选”
            // 父项就是一个真的 Checkbox：三态由 Indeterminate 表达
            // （全选=勾，部分=横线，全不选=空框），和下面代码示例里
            // 写的 API 完全一致，不再手绘方框和横线。
            int n = Gallery.demoCbg.CheckedCount();
            int total = Gallery.demoCbg.Count();
            Checkbox all = new Checkbox(
                Gallery.T("Select all - mirrors the children (partial shows a dash)",
                    "全选 - 随子项聚合（部分选中显示横线）"));
            all.SetChecked(total > 0 && n == total);
            all.Indeterminate = n > 0 && n < total;
            all.Change += () => {
                Gallery.demoCbg.SetAllChecked(all.IsChecked());
            };
            Panel cbgCol = Panel.Column().Gap(app.Scale(10));
            cbgCol.With(all);
            cbgCol.With(Gallery.demoCbg);
            Gallery.LayoutAuto(app, cbgCol, name, px, y + app.Scale(34),
                w - app.Scale(36), app.Scale(150));
        } else if (name == "Empty") {
            Empty e1 = new Empty("No results");
            e1.Icon = "search";
            e1.RenderInside(app, new Rect(px, py - app.Scale(8),
                app.Scale(300), app.Scale(120)));
            Empty e2 = new Empty("Nothing here") { Class = "small" };
            e2.RenderInside(app, new Rect(px + app.Scale(330),
                y + app.Scale(56), app.Scale(200), app.Scale(80)));
        } else {
            rendered = false;
        }
        if (!rendered) {
            c.DrawGlyph("code", px, py, app.Scale(30), t.primary);
            c.DrawText(px + app.Scale(46), py, "Overlay / interactive component", t.textPrimary, t.fontSizeMedium);
            c.DrawText(px + app.Scale(46), py + app.Scale(28), "Copy the API example below to use it.", t.textSecondary, t.fontSizeSmall);
        }
        c.PopClip();
        if (!measureOnly) {
            Gallery.Audit(app, name, x, y, w, h, rendered);
        }
        return h;
    }

    /// ZAN_GALLERY_AUDIT=1 时，每渲染一个演示就记一行到 gallery_audit.log：
    /// 框高、实测内容底边、是否走了 LayoutAuto、是否有渲染分支。逐页肉眼
    /// 看 135 个演示既慢又漏，让程序自己报「谁没画、谁被裁、谁还在用手调
    /// 高度」要可靠得多。
    static void Audit(App app, string name, int x, int y, int w, int h,
                      bool rendered) {
        if (!Gallery.audit) { return; }
        int content = Gallery.AutoContentH(name, w);
        // 卡片高度读的是上一帧的实测值（见 PreviewBoxH），所以第一帧的
        // box 还是种子高度。逐帧比对、只在数字变化时补记一行，日志里
        // 每个演示的最后一行就是收敛后的真值。
        string sig = Convert.ToString(h) + "/" + Convert.ToString(content)
            + "/" + Convert.ToString(w);
        if (Gallery.auditSeen.ContainsKey(name)) {
            if (Gallery.auditSeen[name] == sig) { return; }
            Gallery.auditSeen.Remove(name);
        }
        Gallery.auditSeen.Add(name, sig);
        File.AppendAllText("gallery_audit.log",
            "demo=" + name
            + " box=" + Convert.ToString(h)
            + " content=" + Convert.ToString(content)
            + " auto=" + (content > 0 ? "1" : "0")
            + " rendered=" + (rendered ? "1" : "0")
            + " w=" + Convert.ToString(w)
            + "\n");
    }

    /// Components whose live demo floats outside the preview box (dropdowns,
    /// menus, popovers, a table with a filter panel). They are drawn in the
    /// deferred overlay pass so their popups sit above the code panel.
    /// 这份名单必须与 RenderOverlay 的分支一一对应：名单漏了谁，那个
    /// 演示的基础通道就走到最后的 else 去画「Overlay / interactive
    /// component」占位卡，而 RenderOverlay 里写好的演示永远不会被调到 ——
    /// Compose 与 DataTable 就是这样各自丢了一整个示例，且不报任何错。
    /// tests/run_gallery_overlay_pairing.cmake 会核对两处是否一致。
    static bool IsOverlayComp(string name) {
        if (name == "Select") { return true; }
        if (name == "SelectBox") { return true; }
        if (name == "Dropdown") { return true; }
        if (name == "Popover") { return true; }
        if (name == "SelectBox.filter") { return true; }
        if (name == "SelectBox.table") { return true; }
        if (name == "SelectBox.virtual") { return true; }
        if (name == "SelectBox.hover") { return true; }
        if (name == "SelectBox.cascade") { return true; }
        if (name == "SelectBox.cascadeMulti") { return true; }
        if (name == "SelectBox.tree") { return true; }
        if (name == "SelectBox.group") { return true; }
        if (name == "DataTable") { return true; }
        if (name == "DataTable 1M") { return true; }
        if (name == "Compose") { return true; }
        if (name == "Layer") { return true; }
        if (name == "Designer") { return true; }
        return false;
    }

    static void RenderOverlay(App app, Canvas c, Theme t, string name,
            int x, int y, int w) {
        int px = x + app.Scale(18);
        int py = y + app.Scale(48);
        if (name == "SelectBox") {
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py - app.Scale(24), "single · clearable",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            Gallery.demoSelect.Render(app, px, py, app.Scale(180));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px + app.Scale(200), py - app.Scale(24), "multi-select",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            Gallery.demoMulti.Render(app, px + app.Scale(200), py, app.Scale(180));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px + app.Scale(400), py - app.Scale(24), "long · scrolls",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            Gallery.demoLong.Render(app, px + app.Scale(400), py, app.Scale(180));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py + t.heightMedium + app.Scale(14), "large · Size(Large())",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            Gallery.demoLarge.Render(app, px, py + t.heightMedium + app.Scale(32),
                                     app.Scale(180));
        } else if (name == "SelectBox.filter") {
            // Filterable(true)：弹层顶部一个搜索框，键入即时过滤。
            // 四十个候选项已经不值得逐条翻了。
            Gallery.demoFilter.Render(app, px, py, app.Scale(260));
            Gallery.SelCaption(app, name, px, py + t.heightMedium + app.Scale(12),
                Gallery.T("Filterable(true) · type to narrow, X clears",
                          "Filterable(true) · 键入即筛，X 清空"));
            Gallery.SelReport(app, name, Gallery.demoFilter);
        } else if (name == "SelectBox.table") {
            // Table(headers, widths) + AddRow(cells)：弹层是一张对齐的表，
            // 而不是把三段文字拼成一条长字符串。筛选对所有列生效。
            Gallery.demoTablePick.Render(app, px, py, app.Scale(320));
            Gallery.SelCaption(app, name, px, py + t.heightMedium + app.Scale(12),
                Gallery.T("Table(headers, widths) + AddRow(cells) · the filter hits every column",
                          "Table(headers, widths) + AddRow(cells) · 筛选命中所有列"));
            Gallery.SelReport(app, name, Gallery.demoTablePick);
        } else if (name == "SelectBox.virtual") {
            // 两万条选项。弹层每帧只遍历视口里的那十几行，宽度只量一次；
            // 滚动到底也一样流畅。
            Gallery.demoHugePick.Render(app, px, py, app.Scale(280));
            Gallery.SelCaption(app, name, px, py + t.heightMedium + app.Scale(12),
                Gallery.T("20000 options · only the visible rows are walked each frame",
                          "两万条选项 · 每帧只遍历可见的那几行"));
            Gallery.SelReport(app, name, Gallery.demoHugePick);
        } else if (name == "SelectBox.hover") {
            // Hover 事件 + Hovered()：指到哪条就报哪条，联动预览/详情面板
            // 靠的就是这一对。
            Gallery.demoHoverPick.Render(app, px, py, app.Scale(220));
            Gallery.SelCaption(app, name, px, py + t.heightMedium + app.Scale(12),
                Gallery.T("Hover an option · the index is reported at the top of this card",
                          "把鼠标移到选项上 · 序号报在卡片头部"));
            int hv = Gallery.demoHoverPick.Hovered();
            string hvText = Gallery.T("(nothing hovered)", "（未悬停）");
            if (hv >= 0) {
                hvText = "Hovered #" + Convert.ToString(hv)
                    + " · " + Gallery.demoHoverPick.OptionLabel(hv);
            }
            Gallery.Fired(app, name, hvText);
        } else if (name == "SelectBox.cascade") {
            // 级联单选：点中带子级的选项在右侧展开下一列；叶子收值后
            // 触发器显示完整路径，重开弹层自动展开到选中链。
            Gallery.demoCascade.Render(app, px, py, app.Scale(220));
            Gallery.SelCaption(app, name, px, py + t.heightMedium + app.Scale(12),
                Gallery.T("Cascade() · pick a leaf, columns expand to the right",
                          "Cascade() · 选到叶子为止，逐列向右展开"));
            Gallery.SelReport(app, name, Gallery.demoCascade);
        } else if (name == "SelectBox.cascadeMulti") {
            // 级联多选：行首勾选框父子联动（全勾=勾、部分=短横），
            // 勾选策略 child 只把叶子计入值；悬停即展开下一列，过滤
            // 平铺整棵树按完整路径搜，触发器是可单独移除的标签芯片。
            Gallery.demoCascadeMulti.Render(app, px, py, app.Scale(300));
            Gallery.SelCaption(app, name, px, py + t.heightMedium + app.Scale(12),
                Gallery.T("Multi + Cascade · linked checkboxes, check-strategy child, hover expand, path filter",
                          "多选 + 级联 · 勾选父子联动、child 勾选策略、悬停展开、路径过滤"));
            Gallery.SelReport(app, name, Gallery.demoCascadeMulti);
        } else if (name == "SelectBox.tree") {
            // 树形：弹层内嵌真 TreeView，展开/折叠/滚动都是它自己的行为。
            Gallery.demoTreePick.Render(app, px, py, app.Scale(240));
            Gallery.SelCaption(app, name, px, py + t.heightMedium + app.Scale(12),
                Gallery.T("Tree() · the popup embeds a real TreeView",
                          "Tree() · 弹层内嵌真 TreeView"));
            Gallery.SelReport(app, name, Gallery.demoTreePick);
        } else if (name == "SelectBox.group") {
            // 分组 + 禁用项：标题行只是小标题，禁用项置灰不可点。
            Gallery.demoGroupPick.Render(app, px, py, app.Scale(220));
            Gallery.SelCaption(app, name, px, py + t.heightMedium + app.Scale(12),
                Gallery.T("AddGroup(title) + AddOption(label, true) · headers are not selectable, disabled items are grayed out",
                          "AddGroup(title) + AddOption(label, true) · 标题行不可选，禁用项置灰"));
            Gallery.SelReport(app, name, Gallery.demoGroupPick);
        } else if (name == "Select") {
            // Retained instance: owns its open state and defers the option list
            // to the framework overlay layer (draws above the code panel, one
            // centralized dispatch). No manual hit-testing here.
            Gallery.demoSelectLow.Render(app, px, py, app.Scale(220));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py + t.heightMedium + app.Scale(10), "click to open · Change fires on select",
                app.theme.textPrimary, app.theme.fontSizeMedium);
        } else if (name == "Dropdown") {
            // 动作菜单定位：左边基础用法（选中即执行动作，触发器回到
            // 提示语——保留选中值是 SelectBox 的事），右边 Rows(4) 长命令
            // 菜单滚动 + OnOpen/OnClose 事件。Retained：弹层延迟到覆盖层
            // 绘制，画在代码面板之上、点击不穿透、外部按下或 Esc 关闭。
            Gallery.demoDropdownAct.RenderInside(app,
                new Rect(px, py, app.Scale(200), t.heightMedium));
            Gallery.demoDropdownManual.RenderInside(app,
                new Rect(px + app.Scale(240), py, app.Scale(200), t.heightMedium));
            Gallery.demoDropdownTree.RenderInside(app,
                new Rect(px + app.Scale(480), py, app.Scale(200), t.heightMedium));
            Gallery.SelCaption(app, name, px, py + t.heightMedium + app.Scale(12),
                Gallery.T("pick = run the action · trigger resets to its hint",
                          "选中即执行动作 · 触发器回到提示语"));
            Gallery.SelCaption(app, name, px + app.Scale(240),
                py + t.heightMedium + app.Scale(12),
                Gallery.T("Rows(4) scrolls · open/close hit the header",
                          "Rows(4) 长菜单滚动 · 开/关事件报在卡片头部"));
            Gallery.SelCaption(app, name, px + app.Scale(480),
                py + t.heightMedium + app.Scale(12),
                Gallery.T("BindMenu: icons · submenu · disabled · danger",
                          "BindMenu：图标 · 子菜单 · 禁用 · 危险项"));
        } else if (name == "Popover") {
            // Retained: click the trigger to open an anchored, word-wrapped,
            // click-blocking panel that closes on an outside press or Esc.
            Gallery.demoPopover.Render(app, px, py, app.Scale(150), t.heightMedium);
        } else if (name == "DataTable 1M") {
            // Big-data demo backed by a virtual DataSource: cells are supplied
            // on demand for the visible window only, so the grid stores NO rows
            // and memory stays flat regardless of the row count (a List<DataRow>
            // of 70M string cells would cost ~1.8 GB; the virtual source costs a
            // few MB for the sort-order index). Row count is a live setting.
            int want = Gallery.BigRowCountFor(Gallery.bigRowsSel.Get());
            if (Gallery.bigCols == null) {
                Gallery.bigCols = new List<DataColumn>();
                for (int bci = 0; bci < 70; bci = bci + 1) {
                    string bt = Gallery.T("Col ", "列 ") + Convert.ToString(bci + 1);
                    if (bci == 0) {
                        Gallery.bigCols.Add(DataColumn.Text(bt, app.Scale(96)));
                    } else if (bci == 1) {
                        DataColumn sc = DataColumn.Numeric(bt, app.Scale(96));
                        sc.summary = 1;   // Σ
                        Gallery.bigCols.Add(sc);
                    } else if (bci == 2) {
                        DataColumn sc = DataColumn.Numeric(bt, app.Scale(96));
                        sc.summary = 2;   // avg
                        Gallery.bigCols.Add(sc);
                    } else if (bci == 3) {
                        DataColumn sc = DataColumn.Numeric(bt, app.Scale(96));
                        sc.summary = 3;   // min
                        Gallery.bigCols.Add(sc);
                    } else if (bci == 4) {
                        DataColumn sc = DataColumn.Numeric(bt, app.Scale(96));
                        sc.summary = 4;   // max
                        Gallery.bigCols.Add(sc);
                    } else if (bci == 5) {
                        // Derived total: Σcol1 as a percent of Σcol2 — computed
                        // from the cached aggregates, so it costs O(1) and never
                        // rescans the rows.
                        Gallery.bigCols.Add(DataColumn.Derived(
                            Gallery.T("%1/2", "占比1/2"), app.Scale(96), 0, 1, 2));
                    } else {
                        Gallery.bigCols.Add(DataColumn.Numeric(bt, app.Scale(96)));
                    }
                }
            }
            if (Gallery.bigSource == null || Gallery.bigRowCount != want) {
                int bt0 = Window.GetTickMs();
                Gallery.bigRowCount = want;
                Gallery.bigSource = new BigDataSource(want, 70);
                Gallery.bigTableState.dirty = true;
                Gallery.bigBuildMs = Window.GetTickMs() - bt0;
            }
            Gallery.bigRowsSelect.Render(app, px, py - app.Scale(26), app.Scale(150));
            Gallery.BoxCaption(app, px + app.Scale(162), py - app.Scale(22),
                w - app.Scale(36) - app.Scale(162),
                Convert.ToString(Gallery.bigRowCount) + Gallery.T(" rows x 70 cols · virtual source, flat memory · wheel scrolls rows, Shift+wheel pans columns", " 行 x 70 列 · 虚拟数据源，内存恒定 · 滚轮翻行，Shift+滚轮横向移动"),
                app.theme.fontSizeMedium);
            DataTable.RenderSource(app, px, py + app.Scale(12), w - app.Scale(36),
                app.Scale(336), Gallery.bigCols, Gallery.bigSource,
                Gallery.bigTableState);
            // Export Excel: streams the whole virtual view to a real .xlsx on a
            // worker thread; the status line below reports progress/done.
            if (Gallery.bigExportBtn == null) {
                Gallery.bigExportBtn = new Button { Text = Gallery.T("Export Excel", "导出 Excel") };
                Gallery.bigExportBtn.Click += Gallery.OnBigExportClick;
            }
            Gallery.bigExportBtn.Text = Gallery.T("Export Excel", "导出 Excel");
            int gexY = py + app.Scale(356);
            Gallery.bigExportBtn.Render(app, px, gexY, app.Scale(130));
            if (Gallery.bigExportStatus != null && Gallery.bigExportStatus != "") {
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "secondary", Style.SNormal()),
                    px + app.Scale(142), gexY + app.Scale(6), Gallery.bigExportStatus,
                    app.theme.textPrimary, app.theme.fontSizeMedium);
            }
        } else if (name == "DataTable") {
            List<DataColumn> cols = new List<DataColumn>();
            // Every column is named, so the styler below and any handler can
            // say "score" instead of 2 — and keep working if a column moves.
            cols.Add(DataColumn.Field(DataColumn.Pin(DataColumn.Text("Team", app.Scale(110))), "team"));
            // Name must be filled in and fits a short label; Score is a spinner
            // bounded to a percentage; Dept picks from a fixed list.
            cols.Add(DataColumn.Field(DataColumn.Pin(DataColumn.MaxLength(
                DataColumn.Required(DataColumn.Editable(DataColumn.Text("Name", app.Scale(130)))), 16)), "name"));
            cols.Add(DataColumn.Field(DataColumn.Avg(DataColumn.Range(
                DataColumn.Spinner(DataColumn.Percent(DataColumn.Numeric("Score", app.Scale(90))), 1.0),
                0.0, 100.0)), "score"));
            cols.Add(DataColumn.Field(DataColumn.Sum(DataColumn.Editable(
                DataColumn.Money(DataColumn.Numeric("Salary", app.Scale(120)), "$"))), "salary"));
            cols.Add(DataColumn.Field(DataColumn.Dropdown(DataColumn.Text("Dept", app.Scale(120)),
                                         Gallery.DeptChoices(), true), "dept"));
            cols.Add(DataColumn.Field(DataColumn.Text("City", app.Scale(110)), "city"));
            // Frozen to the right: a running total belongs where it stays
            // readable no matter how far the middle columns are scrolled.
            cols.Add(DataColumn.Field(DataColumn.PinRight(
                DataColumn.Money(DataColumn.Numeric("Total", app.Scale(110)), "$")), "total"));
            // The demo rebuilds its columns every frame, so the styler
            // re-resolves the ones it needs by name (and the theme colours,
            // so the tint follows the active theme).
            Gallery.demoStyler.Bind(app, cols);
            Gallery.BoxCaption(app, px, py - app.Scale(20), w - app.Scale(36),
                Gallery.T("Team/Name frozen left, Total frozen right · drag a header to reorder · right-click a header for freeze/group/aggregate · arrows/Tab move, F2 edits · Ctrl+Z undoes",
                          "Team/Name 冻结在左、Total 冻结在右 · 拖动表头换序 · 右键表头可冻结/分组/汇总 · 方向键/Tab 移动，F2 编辑 · Ctrl+Z 撤销"),
                app.theme.fontSizeMedium);
            Gallery.dtDemoCols = cols;
            DataTable.Render(app, px, py, w - app.Scale(36),
                app.Scale(256), cols, Gallery.demoRows, Gallery.demoTableState);
            // Export Excel: async streaming export of this small grid, with the
            // progress/result reported on the status line below the table.
            if (Gallery.dtExportBtn == null) {
                Gallery.dtExportBtn = new Button { Text = Gallery.T("Export Excel", "导出 Excel") };
                Gallery.dtExportBtn.Click += Gallery.OnDtExportClick;
            }
            Gallery.dtExportBtn.Text = Gallery.T("Export Excel", "导出 Excel");
            int dexY = py + app.Scale(266);
            Gallery.dtExportBtn.Render(app, px, dexY, app.Scale(130));
            if (Gallery.dtExportStatus != null && Gallery.dtExportStatus != "") {
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "secondary", Style.SNormal()),
                    px + app.Scale(142), dexY + app.Scale(6), Gallery.dtExportStatus,
                    app.theme.textPrimary, app.theme.fontSizeMedium);
            }
        } else if (name == "Compose") {
            // Fluent retained-mode composition: a titled card holding a column
            // of a label, a progress bar and a row of buttons — all nested with
            // With(), auto-docked and auto-measured.
            Panel card = new Panel("card");
            card.Titled("Create account");
            card.Add(
                Panel.Column().Gap(app.Scale(10))
                    .With(new Label { Text = "Fill in the details below.", Class = "secondary" })
                    .With(new Progress(66, 3))
                    .With(Panel.Row().Gap(app.Scale(10))
                        .With(new Button { Text = "Cancel" })
                        .With(new Button { Text = "Save", Class = "primary" })));
            // Round-trip through the serializer: what you see is rebuilt from the
            // saved document, proving save/load preserves the whole tree + props.
            string doc = Serialize.Save(card);
            Control loaded = Serialize.Load(doc);
            loaded.MeasureTree(app);
            loaded.Arrange(px, py - app.Scale(8), w - app.Scale(36), app.Scale(190));
            loaded.RenderTree(app);
        } else if (name == "Designer") {
            Gallery.designer.Render(app, x, y, w, app.Scale(Gallery.PreviewHeight(name)));
        } else if (name == "Layer") {
            Gallery.RenderLayerDemo(app, t, px, py, w);
        }
    }

    /// The unified Layer demo: a layui-style grid of trigger buttons that open
    /// every overlay flavour, then the active layers drawn above everything.
    static void RenderLayerDemo(App app, Theme t, int px, int py, int w) {
        int bx = px;
        int by = py;
        int bw = app.Scale(118);
        int bh = t.heightMedium;
        int gap = app.Scale(10);
        int rowGap = app.Scale(34);

        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary", Style.SNormal()),
            bx, by - app.Scale(22), "Dialogs",
            app.theme.textPrimary, app.theme.fontSizeMedium);
        int a1 = new Button { Text = "Alert" }.Render(app, bx, by, bw);
        if (Ui.Clicked(app, a1)) { Gallery.dlgAlert.Open(); }
        int a2 = new Button { Text = "Confirm" }.Render(app, bx + (bw + gap), by, bw);
        if (Ui.Clicked(app, a2)) { Gallery.dlgConfirm.Open(); }
        int a3 = new Button { Text = "Prompt" }.Render(app, bx + (bw + gap) * 2, by, bw);
        if (Ui.Clicked(app, a3)) { Gallery.dlgPrompt.Open(); }
        by = by + bh + rowGap;

        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary", Style.SNormal()),
            bx, by - app.Scale(22), "Message toasts · queue, auto-dismiss, collapse upward",
            app.theme.textPrimary, app.theme.fontSizeMedium);
        int m1 = new Button { Text = "Success msg" }.Render(app, bx, by, bw);
        if (Ui.Clicked(app, m1)) { Layer.Msg("Saved successfully", 3); }
        int m2 = new Button { Text = "Warning msg" }.Render(app, bx + (bw + gap), by, bw);
        if (Ui.Clicked(app, m2)) { Layer.Msg("Unsaved changes", 4); }
        int m3 = new Button { Text = "Error msg" }.Render(app, bx + (bw + gap) * 2, by, bw);
        if (Ui.Clicked(app, m3)) { Layer.Msg("Network error", 5); }
        by = by + bh + rowGap;

        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary", Style.SNormal()),
            bx, by - app.Scale(22), "Notification · loading · tips",
            app.theme.textPrimary, app.theme.fontSizeMedium);
        int n1 = new Button { Text = "Notify" }.Render(app, bx, by, bw);
        if (Ui.Clicked(app, n1)) { Layer.Notify("Build completed", 3); }
        int n2 = new Button { Text = "Loading" }.Render(app, bx + (bw + gap), by, bw);
        if (Ui.Clicked(app, n2)) { Gallery.loadStartMs = Window.GetTickMs(); }
        int tipsX = bx + (bw + gap) * 2;
        bool tipsNow = Gallery.tipsOn.Get();
        string tlbl = "Tips";
        if (tipsNow) { tlbl = "Hide tips"; }
        int n3 = new Button { Text = tlbl }.Render(app, tipsX, by, bw);
        if (Ui.Clicked(app, n3)) { Gallery.tipsOn.Set(!tipsNow); }
        int tipAX = tipsX + bw / 2;
        // Anchor the tip to the button's TOP edge so the top-placed bubble sits
        // above the whole button (notch touching the top edge) instead of
        // growing up from the bottom edge and covering the label.
        int tipAY = by;
        by = by + bh + rowGap;

        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary", Style.SNormal()),
            bx, by - app.Scale(22), "Draggable windows · full-screen photo carousel",
            app.theme.textPrimary, app.theme.fontSizeMedium);
        int w1 = new Button { Text = "Open window", Class = "primary" }.Render(app, bx, by, bw);
        if (Ui.Clicked(app, w1)) { Gallery.SpawnLayer(app); }
        int w2 = new Button { Text = "Photos" }.Render(app, bx + (bw + gap), by, bw);
        if (Ui.Clicked(app, w2)) {
            Gallery.photoIdx.Set(0);
            Gallery.photosOpen.Set(true);
        }
        int w3 = new Button { Text = "Open form" }.Render(app, bx + (bw + gap) * 2, by, bw);
        if (Ui.Clicked(app, w3)) { Gallery.SpawnFormWindow(app); }
        Gallery.PopupHint(app, bx + (bw + gap) * 3, by);

        by = by + bh + rowGap;
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary", Style.SNormal()),
            bx, by - app.Scale(22),
            "Prompt forms (Esc = cancel, Enter = OK)",
            app.theme.textPrimary, app.theme.fontSizeMedium);
        int pw1 = new Button { Text = "Prompt password" }.Render(app, bx, by, bw);
        if (Ui.Clicked(app, pw1)) {
            Gallery.dlgPromptPw = LayerState.PromptWith("Password", "secret",
                1, "", 64);
            Gallery.dlgPromptPw.shadeClose = true;
            Gallery.dlgPromptPw.Open();
        }
        int pw2 = new Button { Text = "Prompt multiline" }.Render(app, bx + (bw + gap), by, bw);
        if (Ui.Clicked(app, pw2)) {
            Gallery.dlgPromptArea = LayerState.PromptWith("Notes",
                "write here...", 2, "", 0);
            Gallery.dlgPromptArea.Open();
        }

        if (Gallery.loadStartMs > 0) {
            int el = Window.GetTickMs() - Gallery.loadStartMs;
            if (el >= 3000) {
                Gallery.loadStartMs = 0;
                Gallery.popupResult = "loading: done";
            } else {
                Layer.RenderLoad(app, px - app.Scale(6), py - app.Scale(6),
                    w - app.Scale(24), app.Scale(300), "Loading data...");
                app.RequestAnimationFrame(16);
            }
        }

        if (Gallery.tipsOn.Get()) {
            Layer.Tips(app, tipAX, tipAY, "This is a tip bubble.");
        }

    }

    /// Spawns a new floating Layer window, cascaded down-right from the last
    /// one so several are visibly stacked. Each is independent and draggable.
    static void SpawnLayer(App app) {
        int n = Gallery.layerSeq;
        Gallery.layerSeq = n + 1;
        int off = (n % 6) * app.Scale(28);
        LayerState win = new LayerState(
            "Window " + Convert.ToString(n + 1),
            app.Scale(360) + off, app.Scale(150) + off,
            app.Scale(400), app.Scale(230));
        win.body = "Drag to move; drag edges/corners to resize.";
        win.Open();
        Gallery.demoLayers.Add(win);
    }

    /// page 层宿主控件的演示：窗口正文挂一棵保留的表单
    /// （Input + TextArea + Button）。控件树在点击回调里中途构造，
    /// 必须包在 Layer.BeginBody()/EndBody() 里领 Layer body 保留段
    /// 的 id，否则重演「信号污染」。单实例：已开着就不再开。
    static void SpawnFormWindow(App app) {
        if (Gallery.formWin != null && Gallery.formWin.open) { return; }
        Layer.BeginBody();
        Panel form = Panel.Column().Gap(app.Scale(10));
        Gallery.formName = new Input("Your name");
        Gallery.formNote = new TextArea("Note...");
        Gallery.formOk = new Button { Text = "Save form", Class = "primary" };
        form.With(Gallery.formName);
        form.With(Gallery.formNote);
        form.With(Gallery.formOk);
        Layer.EndBody();
        Gallery.formWin = new LayerState("Form window",
            app.Scale(300), app.Scale(140), app.Scale(380), app.Scale(300));
        Gallery.formWin.body = "Embedded components (page layer).";
        Gallery.formWin.SetBody(form);
        Gallery.formWin.Open();
        Gallery.demoLayers.Add(Gallery.formWin);
    }

    /// Shows the last popup action beneath the trigger button in a demo.
    static void PopupHint(App app, int px, int py) {
        if (Gallery.popupResult != "") {
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py + app.Scale(46), "last: " + Gallery.popupResult,
                app.theme.textPrimary, app.theme.fontSizeMedium);
        } else {
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py + app.Scale(46), "click the button to open",
                app.theme.textPrimary, app.theme.fontSizeMedium);
        }
    }

    // ------------------------------------------------------------------
    // Text wrapping helper
    // ------------------------------------------------------------------

    // Scratch byte for Utf8Width: allocated once, never grows.
    static nint wrapProbe;

    /// UTF-8 byte width of the character `ch` starts, read from its lead byte:
    /// 1 for ASCII, 2/3/4 for a multi-byte sequence. Strings are byte-indexed,
    /// so the wrapper needs this to step character by character.
    static int Utf8Width(string ch) {
        if (ch.Length == 0) { return 1; }
        if (Gallery.wrapProbe == 0) { Gallery.wrapProbe = NativeMemory.Alloc(8); }
        NativeMemory.PutString(Gallery.wrapProbe, 0, ch, ch.Length);
        int c0 = new Span<byte>(Gallery.wrapProbe, 4)[0];
        if ((c0 & 0x80) == 0) { return 1; }
        if ((c0 & 0xE0) == 0xC0) { return 2; }
        if ((c0 & 0xF0) == 0xE0) { return 3; }
        return 4;
    }

    /// Appends `word` to the current line, starting a new line when it no
    /// longer fits. `sep` inserts the space the word was split on.
    static string WrapPush(List<string> lines, string cur, string word, bool sep,
            int width, int fontSize) {
        if (word == "") { return cur; }
        string trial = cur;
        if (trial != "" && sep) { trial = trial + " "; }
        trial = trial + word;
        if (Canvas.MeasureText(trial, fontSize) > width && cur != "") {
            lines.Add(cur);
            return word;
        }
        return trial;
    }

    /// Wraps `text` to `width` pixels at `fontSize`. Latin text breaks on
    /// spaces; CJK has none, so every wide character is also a break
    /// opportunity -- otherwise a Chinese paragraph is one unbreakable word
    /// and runs off the pane.
    static List<string> WrapText(string text, int width, int fontSize) {
        List<string> lines = new List<string>();
        string cur = "";
        string word = "";
        bool sep = false;
        int i = 0;
        while (i < text.Length) {
            string ch = text.Substring(i, 1);
            int cl = Gallery.Utf8Width(ch);
            if (cl > 1) { ch = text.Substring(i, cl); }
            i = i + cl;
            if (cl == 1 && ch == " ") {
                cur = Gallery.WrapPush(lines, cur, word, sep, width, fontSize);
                word = "";
                sep = true;
            } else if (cl > 1) {
                cur = Gallery.WrapPush(lines, cur, word, sep, width, fontSize);
                word = "";
                sep = false;
                cur = Gallery.WrapPush(lines, cur, ch, false, width, fontSize);
            } else {
                word = word + ch;
            }
        }
        cur = Gallery.WrapPush(lines, cur, word, sep, width, fontSize);
        if (cur != "") { lines.Add(cur); }
        if (lines.Count == 0) { lines.Add(""); }
        return lines;
    }

    // ------------------------------------------------------------------
    // Catalog -- 数据驱动（assets/gallery.json）
    // ------------------------------------------------------------------
    // 组件目录（分类/名称/描述/代码框/JSON 配置/属性表/事件表/演示卡）全部
    // 外置到 assets/gallery.json，经 Gallery.DataText 的三级候选路径 + 内嵌
    // 副本链路加载；渲染分发（RenderDemo 的 name == "..." 分支）留在代码里。
    // 描述是 { en, zh } 双语对象，加载时按 Gallery.lang 选定一侧，语言切换
    // 走 SetLang 的整目录重建（pack 只解析一次，缓存在 staticGalleryPack）。

    /// 解析后的目录数据包缓存：Parse 一次，语言切换只重建 Comp 树。
    static JsonValue galleryPack;

    static JsonValue GalleryPack() {
        if (Gallery.galleryPack != null) { return Gallery.galleryPack; }
        string raw = Gallery.DataText("gallery.json");
        if (raw == "") {
            Console.WriteLine("gallery: assets/gallery.json missing -- catalog empty");
            Gallery.galleryPack = JsonValue.NewArray();
            return Gallery.galleryPack;
        }
        Gallery.galleryPack = JsonValue.Parse(raw);
        return Gallery.galleryPack;
    }

    /// 双语对象 {"en": "...", "zh": "..."} -> 按当前语言取一侧；缺侧回退另一侧。
    static string LangText(JsonValue o) {
        if (o == null) { return ""; }
        // kind 3 = 字符串值（非双语对象）：直接用原字符串（如默认值 "120"）。
        if (o.Count() == 0) { return o.AsString(""); }
        string en = o.Str("en", "");
        string zh = o.Str("zh", "");
        if (Gallery.lang.Get() == 1) { return zh != "" ? zh : en; }
        return en != "" ? en : zh;
    }

    static void BuildComps(List<Comp> list) {
        JsonValue rootPack = Gallery.GalleryPack();
        JsonValue pack = rootPack.Get("comps");
        if (pack == null) { pack = JsonValue.NewArray(); }
        for (int ci = 0; ci < pack.Count(); ci = ci + 1) {
            JsonValue jc = pack.At(ci);
            Comp e = new Comp(jc.Str("category", ""), jc.Str("name", ""),
                Gallery.LangText(jc.Get("desc")), jc.Str("code", ""));
            e.json = jc.Str("json", "");
            // 演示卡：previewId 是渲染分发的键，previewH 是框高种子。
            JsonValue jd = jc.Get("demos");
            if (jd != null) {
                for (int di = 0; di < jd.Count(); di = di + 1) {
                    JsonValue d = jd.At(di);
                    e.AddDemo(Gallery.LangText(d.Get("title")),
                        Gallery.LangText(d.Get("desc")),
                        d.Str("previewId", ""), d.Int("previewH", 120),
                        d.Str("code", ""), d.Str("json", ""));
                }
            }
            // 属性 / 事件表：deflt 可能是双语对象（如 "位号量程"），可能是字符串。
            JsonValue jp = jc.Get("props");
            if (jp != null) {
                for (int pi = 0; pi < jp.Count(); pi = pi + 1) {
                    JsonValue p = jp.At(pi);
                    e.AddProp(p.Str("name", ""), p.Str("type", ""),
                        Gallery.LangText(p.Get("deflt")),
                        Gallery.LangText(p.Get("desc")));
                }
            }
            JsonValue je = jc.Get("events");
            if (je != null) {
                for (int ei = 0; ei < je.Count(); ei = ei + 1) {
                    JsonValue ev = je.At(ei);
                    e.AddEvent(ev.Str("name", ""), ev.Str("sig", ""),
                        Gallery.LangText(ev.Get("desc")));
                }
            }
            list.Add(e);
        }
        // 老式 desc/code 组件的「Basic usage」卡必须在这里（WidgetId.Mark
        // 之前）就合成，不能留给 EffectiveDemos 在页面首帧中途补建：Demo
        // 的 copyBtn 是 retained 控件，帧中途领到的是 ResetFrame 之后的
        // 帧回收区间 id，下一帧起这个 id 会被重新发放给每帧重建的第一个
        // 演示控件（Radio 页恰好是 new Radio）——点击卡片的 Copy 就会
        // 同时触发那个控件的 Change。
        for (int ci = 0; ci < list.Count; ci = ci + 1) {
            Gallery.EffectiveDemos(list[ci]);
        }
    }

}
