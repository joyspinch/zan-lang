            ChartView.KeyedStatic(cfm, 8406).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));
        } else if (name == "Chart.venn_set") {
            // ECharts venn：两个集合圆与交集 [A, B, A∩B]。
            List<ChartData> vd = new List<ChartData>{
                ChartData.Named(60, Gallery.T("浏览商品", "浏览商品")),
                ChartData.Named(40, Gallery.T("加入购物车", "加入购物车")),
                ChartData.Named(25, Gallery.T("两者都", "两者都"))
            };
            ChartOption cvm = ChartOption.Single(
                ChartSeries.Venn(Gallery.T("转化重叠", "转化重叠"), vd));
            ChartView.KeyedStatic(cvm, 8407).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));
        } else if (name == "Chart.eventriver_demo") {
            // ECharts eventRiver：产品里程碑在时间轴上的波浪带。
            ChartSeries ev = ChartSeries.OfEvents(Gallery.T("产品事件", "产品事件"),
                new List<ChartEvent>{
                    ChartEvent.Of(Gallery.T("首次发布", "首次发布"), 5, 35, 42),
                    ChartEvent.Of(Gallery.T("1.0 迭代", "1.0 迭代"), 45, 80, 28),
                    ChartEvent.Of(Gallery.T("促销活动", "促销活动"), 95, 150, 55),
                    ChartEvent.Of(Gallery.T("大版本 2.0", "大版本 2.0"), 165, 215, 38),
                    ChartEvent.Of(Gallery.T("线下沙龙", "线下沙龙"), 225, 250, 20)
                });
            ChartOption cem = ChartOption.Single(ev);
            cem.showLegend = false;
            ChartView.KeyedStatic(cem, 8408).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));
        } else if (name == "Chart.radar_fill") {
            // ECharts radar2：填充雷达图，每指标独立 indicator.max。
            ChartSeries bud = ChartSeries.Polar(Gallery.T("预算", "预算"),
                new List<int>{ 4300, 10000, 28000, 35000, 50000, 19000 });
            bud.areaStyle = true;
            ChartSeries act = ChartSeries.Polar(Gallery.T("开销", "开销"),
                new List<int>{ 5000, 14000, 28000, 31000, 42000, 21000 });
            act.areaStyle = true;
            ChartOption crm = ChartOption.Of(Gallery.T("预算 vs 开销", "预算 vs 开销"),
                new List<string>{ "销售", "管理", "信息技术", "客服", "研发", "市场" },
                new List<ChartSeries>{ bud, act });
            crm.RadarMax(new List<int>{ 6500, 16000, 30000, 38000, 52000, 25000 });
            ChartView.KeyedStatic(crm, 8409).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));
        } else if (name == "Chart.echarts_scatter") {
            // ECharts scatter1：男女生身高体重分布，双数值轴散点；
            // 两个系列正好演示图例色块点击切换显隐。样本对照官方
            // 示例数据（四舍五入到整数）。
            List<ChartPoint> femalePts = new List<ChartPoint>{
                ChartPoint.Of(161, 52), ChartPoint.Of(168, 59), ChartPoint.Of(160, 49),
                ChartPoint.Of(157, 63), ChartPoint.Of(156, 54), ChartPoint.Of(170, 59),
                ChartPoint.Of(159, 48), ChartPoint.Of(166, 70), ChartPoint.Of(176, 67),
                ChartPoint.Of(160, 75), ChartPoint.Of(173, 55), ChartPoint.Of(171, 54),
                ChartPoint.Of(173, 63), ChartPoint.Of(153, 42), ChartPoint.Of(160, 50),
                ChartPoint.Of(147, 50), ChartPoint.Of(168, 49), ChartPoint.Of(175, 73),
                ChartPoint.Of(157, 48), ChartPoint.Of(168, 69), ChartPoint.Of(160, 51),
                ChartPoint.Of(175, 83), ChartPoint.Of(167, 57), ChartPoint.Of(177, 88),
                ChartPoint.Of(170, 73) };
            List<ChartPoint> malePts = new List<ChartPoint>{
                ChartPoint.Of(174, 66), ChartPoint.Of(175, 72), ChartPoint.Of(194, 81),
                ChartPoint.Of(187, 73), ChartPoint.Of(187, 79), ChartPoint.Of(182, 75),
                ChartPoint.Of(184, 86), ChartPoint.Of(185, 78), ChartPoint.Of(175, 62),
                ChartPoint.Of(184, 82), ChartPoint.Of(180, 77), ChartPoint.Of(178, 84),
                ChartPoint.Of(192, 90), ChartPoint.Of(176, 75), ChartPoint.Of(174, 71),
                ChartPoint.Of(184, 80), ChartPoint.Of(193, 94), ChartPoint.Of(172, 70),
                ChartPoint.Of(173, 72), ChartPoint.Of(176, 86), ChartPoint.Of(176, 79),
                ChartPoint.Of(181, 78), ChartPoint.Of(173, 66), ChartPoint.Of(176, 86),
                ChartPoint.Of(174, 82) };
            ChartOption csc = ChartOption.Of(
                Gallery.T("男女生身高体重分布", "男女生身高体重分布"), null,
                new List<ChartSeries>{
                    ChartSeries.OfPoints("女生", femalePts),
                    ChartSeries.OfPoints("男生", malePts)
                });
            // 显式数值轴范围（ECharts xAxis/yAxis min/max）：
            // 原例网格 150-190 / 40-90，取整样本放宽到 140-200 / 40-100。
            csc.X(ChartAxis.ValueRange(140, 200));
            csc.Y(ChartAxis.ValueRange(40, 100));
            // visualMap 色带：Y 轴值 40-100 映射到蓝→青→黄→红。
            csc.rampColors = new List<int>{
                0xFF3B82F6, 0xFF22D3EE, 0xFF84CC16, 0xFFF59E0B, 0xFFEF4444 };
            csc.rampLo = 40;
            csc.rampHi = 100;
            ChartView.KeyedStatic(csc, 8410).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));
        } else if (name == "Chart.echarts_k") {
