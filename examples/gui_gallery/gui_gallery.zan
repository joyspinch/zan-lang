    static EquipPanel hmiWall;
    static DeviceCard hmiCard;
    static Gauge hmiGaugePv;
    static Gauge hmiGaugeFlow;
    static Gauge hmiGaugeFree;
    static SignalInt hmiLoad;
    static Bargraph hmiBarPv;
    static Bargraph hmiBarFlow;
    static Bargraph hmiBarLevel;
    static Led hmiLedOff;
    static Led hmiLedRun;
    static Led hmiLedWarn;
    static Led hmiLedFault;
    static Led hmiLedComm;
    static Digital hmiDigPv;
    static Digital hmiDigFlow;
    static Digital hmiDigLevel;
    static Digital hmiDigSp;
    static int hmiScanMs;      // last simulated I/O scan (wall clock)
    static int hmiSampleMs;    // last trend sample (wall clock)

    /// 模板模式演示行：行是任意控件子树（这里是一行三个
    /// Label 的 Panel.Row），只在进入视口时才会被构建。
    static Control QuoteRow(int qi) {
        Panel row = Panel.Row();
        row.Padding(0, 12, 0, 12);
        row.Gap(14);
        row.With(new Label(Gallery.demoQuoteNames[qi]));
        Label px = new Label(Gallery.demoQuotePrices[qi]);
        px.Class = "secondary";
        row.With(px);
        Label ch = new Label(Gallery.demoQuoteChanges[qi]);
        ch.Class = "secondary";
        row.With(ch);
        return row;
    }

    static void Main() {
        App app = App.CreateDark("Zan GUI Components", 1120, 720);
        Gallery.ringDump = UiDriver.Env("ZAN_CANVAS_RING") != "";
        // App-level CSS: brand classes the demos use, layered over the skin.
        app.UseAppCss("button.pink { background: #e91e63; color: #fff; border-color: #e91e63 }"
                      + " button.teal { background: #13c2c2; color: #fff; border-color: #13c2c2 }");
        Gallery.demoBool = new SignalBool(true);
        Gallery.demoInt = new SignalInt(1);
        Gallery.model = new GalleryModel();
        Gallery.model.inputText = "Zan";
        Gallery.model.toggle = true;
        Gallery.model.toggleB = false;
        Gallery.model.cbDefault = true;
        Gallery.model.cbPrimary = true;
        Gallery.model.cbSuccess = true;
        Gallery.model.level = 1;
        Gallery.demoInput = new Input("type here");
        Gallery.demoInput.data = Gallery.model.inputText;
        // New usage: instance widgets bound to plain model fields via `.data`.
        Gallery.demoCheck = new Checkbox("Checked");
        Gallery.demoCheck.data = Gallery.model.toggle;
        Gallery.demoSwitch = new Switch();
        Gallery.demoSwitch.data = Gallery.model.toggle;
