                ChartNode.Leaf(Gallery.T("Backups", "备份"), 310)
            });
            ChartOption tm2 = ChartOption.Of(Gallery.T("Disk usage", "磁盘占用"), null,
                new List<ChartSeries>{ ChartSeries.OfTree(Gallery.T("Disk", "磁盘"), ChartType.Treemap, root2) });
            ChartView.KeyedStatic(tm2, 8185).Render(app, c1X, cY, halfW, cH);
        } else if (name == "Chart.tree") {
