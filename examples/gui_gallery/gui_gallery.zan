            for (int mi = 0; mi < 2600; mi = mi + 1) {
                int hf = 145 + (mi * 37 + mi * mi * 13) % 28;
                int wf = 42 + (mi * 53 + mi * mi * 7) % 27;
                massF.Add(ChartPoint.Of(hf, wf));
                int hm = 152 + (mi * 41 + mi * mi * 11) % 42;
                int wm = 48 + (mi * 29 + mi * mi * 17) % 44;
                massM.Add(ChartPoint.Of(hm, wm));
            }
            ChartOption msm = ChartOption.Of(
                Gallery.T("男女生身高体重分布", "男女生身高体重分布"), null,
                new List<ChartSeries>{
                    ChartSeries.OfPoints(Gallery.T("女生", "女生"), massF),
                    ChartSeries.OfPoints(Gallery.T("男生", "男生"), massM) });
            msm.X(ChartAxis.ValueRange(140, 200));
            msm.Y(ChartAxis.ValueRange(40, 100));
            msm.showLegend = true;
            ChartView.KeyedStatic(msm, 8706).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(420));


