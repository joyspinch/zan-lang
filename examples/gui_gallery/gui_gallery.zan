        Gallery.demoSlider.data = Gallery.model.level;
        Gallery.demoRate = new Rate(5);
        Gallery.demoRate.data = Gallery.model.level;
        Gallery.model.notes = "Multiline input.\nType, press Enter for a new line,\nuse arrows / Home / End to move.\nIt scrolls itself when it overflows.";
        Gallery.demoArea = new TextArea("Write something...");
        Gallery.demoArea.data = Gallery.model.notes;
        Gallery.demoSelect = new SelectBox("Pick a status").Clearable(true);
        Gallery.demoSelect.AddOption("Default");
        Gallery.demoSelect.AddOption("Success");
        Gallery.demoSelect.AddOption("Warning");
        Gallery.demoSelect.AddOption("Error");
