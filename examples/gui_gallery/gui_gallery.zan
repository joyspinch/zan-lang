        if (name == "SelectBox") { return 240; }
        if (name == "VirtualList") { return 235; }
        if (name == "ClickEvent") { return 175; }
        // 种子高必须盖到覆盖通道的整段内容：提示行 + 表格 + Export 按钮
        // （py+356 处起、heightMedium 高）——盖不到时按钮越过框底压在
        // 代码面板上（弹层通道无裁剪，框是唯一边界）。
        if (name == "DataTable 1M") { return 452; }
        if (name == "DataTable") { return 360; }
        if (name == "PivotTable") { return 330; }
        if (name == "Chart") { return 320; }
        if (name == "Alert.types") { return 195; }
        if (name == "Alert.queue") { return 155; }
        if (name == "Ellipsis") { return 165; }
        if (name == "Timeline") { return 1620; }
        if (name == "TreeView") { return 305; }
        if (name == "Collapse") { return 190; }
        if (name == "Table") { return 225; }
        if (name == "ListView") { return 335; }
        if (name == "Calendar") { return 430; }
        if (name == "Carousel") { return 300; }
        if (name == "Layer") { return 360; }
        if (name == "Menu") { return 180; }
        if (name == "Menu.render") { return 260; }
        if (name == "Menu.expand") { return 460; }
        if (name == "Steps") { return 820; }
        if (name == "Tooltip") { return 640; }
