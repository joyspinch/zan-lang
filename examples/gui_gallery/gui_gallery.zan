            });
            ChartOption tm = ChartOption.Of(Gallery.T("Visitor share", "访客占比"), null,
                new List<ChartSeries>{ ChartSeries.OfTree(Gallery.T("Visits", "访问"), ChartType.Treemap, root) });
            ChartView.KeyedStatic(tm, 8172).Render(app, c0X, cY, halfW, cH);

