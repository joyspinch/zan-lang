            }
            Gallery.LayoutAuto(app, lrow, name, px, py,
                             w - app.Scale(36), app.Scale(160));
        } else if (name == "QrCode.colors") {
            Flex crow = Flex.Wrapped().Gap(app.Scale(20));
            List<QrCode> cqrs = new List<QrCode>{ Gallery.demoQrGreen,
                Gallery.demoQrBlue, Gallery.demoQrInvert };
            List<string> cnames = new List<string>{
                Gallery.T("Brand green", "品牌绿"),
                Gallery.T("Indigo", "靛蓝"),
                Gallery.T("Inverted", "深底反相") };
            for (int ci = 0; ci < cqrs.Count; ci = ci + 1) {
                Panel cell = Panel.Column().Gap(app.Scale(4));
