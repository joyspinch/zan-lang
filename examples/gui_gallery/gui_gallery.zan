        // 和表单一起使用：data 双向绑定 model.cpForm，Change 报 LIVE STATES。
        Gallery.cpFormLog = new Label { Text = "", Class = "secondary" };
        Gallery.demoCpForm = new ColorPicker(0xFFF0A020);
        Gallery.demoCpForm.data = Gallery.model.cpForm;
        Gallery.demoCpForm.Change += Gallery.OnCpChange;
        // 全选父项 + 半选（indeterminate）演示组。
        Gallery.demoCbg = new CheckboxGroup();
        Gallery.demoCbg.AddOption("Cheese");
        Gallery.demoCbg.AddOption("Tomato");
        Gallery.demoCbg.AddOption("Basil");
        // One .zform-style document instantiated into a real control
        // tree: the designer saves exactly this JSON, and the preview
        // and runtime share the same Build path.
        // 双语助手 T() 读语言信号，复杂表单演示（下面）和
        // BuildSelectDemos 都要在 lang 就绪之后才能建。
        // 默认中文（产品要求）：lang 信号驱动 EN/中 chip 高亮与
        // LangText/Wizard/FilePicker 的目录侧选；Lang.Set 让键式查找
        // 生效。两者必须同侧，否则启动态三处各说各话。
        Gallery.lang = new SignalInt(1);
        // 语言包：键式查找的核心。候选目录与 DataText 同款三级链
        // （仓库内相对路径 + 发布形态的 assets/ 相对路径 + --embed
        // 内嵌副本）；zh 包未命中或缺失时 T(en, zh) 回退到内置中文
        // 缺省串，行为与外置前一致。
        List<string> langDirs = new List<string>{
            "examples/gui_gallery/assets/lang",
            "../examples/gui_gallery/assets/lang",
            "assets/lang" };
        Lang.LoadDirs(langDirs);
        Lang.Set("zh");
        Gallery.demoForm = FormBuilder.Build(JsonValue.Parse(
            "{ \"layoutMode\": 0, \"fields\": [\n    { \"kind\": \"Input\", \"label\": \"Email\", \"name\": \"email\", \"placeholder\": \"you@example.com\" },\n    { \"kind\": \"SelectBox\", \"label\": \"Role\", \"name\": \"role\", \"options\": [\"Admin\", \"Editor\", \"Viewer\"] },\n    { \"kind\": \"Switch\", \"label\": \"Weekly digest\", \"name\": \"digest\", \"defOn\": true },\n    { \"kind\": \"TextArea\", \"label\": \"Bio\", \"name\": \"bio\", \"placeholder\": \"A few words about you\", \"span\": 24 }\n ] }"));
        Panel formActions = Panel.Row().Gap(app.Scale(10));
        formActions.With(new Button { Text = "Cancel" });
        formActions.With(new Button { Text = "Create account", Class = "primary" });
        Gallery.demoForm.Add(formActions);
        // ---- Form.validate：带校验的注册表单 ------------------------
        // FormGroup 把每个字段包成「标题 + 控件 + 错误行」，Validate()
        // 就地显示第一条错误：Input 用自带的红框错误态，其余控件用行内
        // label.error。被联动隐藏/禁用的行自动跳过，因此依赖表单里
        // 「选了配送才出现的地址」在自提时不会阻塞提交。
        Input suName = new Input("2-16 个字符");
        suName.name = "name";
        suName.data = Gallery.model.suName;
        Input suMail = new Input("you@example.com");
        suMail.name = "mail";
        suMail.data = Gallery.model.suMail;
        Input suPwd = new Input("至少 6 位");
        suPwd.name = "pwd";
        suPwd.password = true;
        suPwd.data = Gallery.model.suPwd;
        Input suPwd2 = new Input("再输入一次");
        suPwd2.name = "pwd2";
        suPwd2.password = true;
        suPwd2.data = Gallery.model.suPwd2;
        Checkbox suAgree = new Checkbox(Gallery.T("I agree to the Terms of Service",
            "我已阅读并同意服务条款"));
        suAgree.name = "agree";
        suAgree.data = Gallery.model.suAgree;
        Gallery.demoSignup = new FormGroup();
        Gallery.demoSignup.Add(Gallery.T("Username", "用户名"), suName)
            .Rule(FormRule.Required(Gallery.T("Username is required", "请输入用户名")))
            .Rule(FormRule.MinLen(2, Gallery.T("At least 2 characters", "至少 2 个字符")));
        Gallery.demoSignup.Add(Gallery.T("Email@邮箱", "邮箱"), suMail)
            .Rule(FormRule.Required(Gallery.T("Email is required", "请输入邮箱")))
            .Rule(FormRule.Email(Gallery.T("Not a valid email address", "邮箱格式不对")));
        Gallery.demoSignup.Add(Gallery.T("Password", "密码"), suPwd)
            .Rule(FormRule.Required(Gallery.T("Password is required", "请输入密码")))
            .Rule(FormRule.MinLen(6, Gallery.T("At least 6 characters", "至少 6 个字符")));
        Gallery.demoSignup.Add(Gallery.T("Confirm password", "确认密码"), suPwd2)
            .Rule(FormRule.EqualsField(Gallery.demoSignup.Field("pwd"),
                Gallery.T("Passwords do not match", "两次输入的密码不一致")));
        Gallery.demoSignup.Add("", suAgree)
            .Rule(FormRule.Checked(Gallery.T("Please agree first", "请先勾选同意")));
        Panel signupActions = Panel.Row().Gap(app.Scale(10));
        Button signupGo = new Button { Text = Gallery.T("Create account", "创建账号"), Class = "primary" };
        signupGo.OnClick(() => {
            if (Gallery.demoSignup.Validate()) {
                Gallery.demoSignupStatus.Text = Gallery.T(
                    "Submitted - all checks passed.", "提交成功：全部校验通过。");
                Gallery.demoSignupStatus.Class = "success";
            } else {
                Gallery.demoSignupStatus.Text = Gallery.T(
                    "Fix the highlighted fields first ("
                        + Convert.ToString(Gallery.demoSignup.ErrorCount()) + ").",
                    "请先修改标红的字段（" + Convert.ToString(Gallery.demoSignup.ErrorCount()) + " 处）。");
                Gallery.demoSignupStatus.Class = "error";
            }
        });
        Button signupReset = new Button { Text = Gallery.T("Reset", "重置") };
        signupReset.OnClick(() => {
            suName.SetText(""); suMail.SetText(""); suPwd.SetText(""); suPwd2.SetText("");
            suAgree.SetChecked(false);
            Gallery.demoSignup.ClearErrors();
            Gallery.demoSignupStatus.Text = "";
            Gallery.demoSignupStatus.Class = "";
        });
        signupActions.With(signupGo);
        signupActions.With(signupReset);
        Gallery.demoSignupStatus = new Label("");
        Gallery.demoSignup.With(signupActions);
        Gallery.demoSignup.With(Gallery.demoSignupStatus);
        // ---- Form.dependencies：依赖联动的配送单 --------------------
        // Radio / Switch 只负责把选择写进模型；显隐由预览分支每帧按
        // 模型值 SetShown（gallery 的轮询写法，无需事件时序假设）。
        // 整行隐藏 = 标题、控件、错误行一起走，且不再参与校验。
        Radio shipExpress = new Radio(0, Gallery.T("Express delivery", "快递配送"));
        shipExpress.data = Gallery.model.orderShip;
        Radio shipPickup = new Radio(1, Gallery.T("Store pickup", "到店自提"));
        shipPickup.data = Gallery.model.orderShip;
        Input orderAddr = new Input(Gallery.T("Street, city, postcode", "省市区 / 街道 / 门牌"));
        orderAddr.name = "addr";
        orderAddr.data = Gallery.model.orderAddr;
        SelectBox orderStore = new SelectBox(Gallery.T("Pick a store", "选择自提门店"));
        orderStore.name = "store";
        orderStore.AddOption(Gallery.T("Flagship - Nanjing Rd", "旗舰店 · 南京路"));
        orderStore.AddOption(Gallery.T("Campus - Tech Park", "园区店 · 科技园"));
        orderStore.AddOption(Gallery.T("Harbor - Pier 7", "港口店 · 七号栈"));
        Switch orderGift = new Switch();
        orderGift.name = "gift";
        orderGift.data = Gallery.model.orderGift;
        Input orderGiftNote = new Input(Gallery.T("Message on the card", "贺卡留言"));
        orderGiftNote.name = "giftNote";
        orderGiftNote.data = Gallery.model.orderGiftNote;
        Switch orderInvoice = new Switch();
        orderInvoice.name = "invoice";
        orderInvoice.data = Gallery.model.orderInvoice;
        Input orderTitle = new Input(Gallery.T("Company or person", "抬头（单位或个人）"));
        orderTitle.name = "title";
        orderTitle.data = Gallery.model.orderInvoiceTitle;
        Gallery.demoOrder = new FormGroup();
        Panel shipRow = Panel.Column().Gap(app.Scale(4));
        shipRow.With(new Label(Gallery.T("Delivery method", "配送方式")));
        shipRow.With(Panel.Row().Gap(app.Scale(24)).With(shipExpress).With(shipPickup));
        Gallery.demoOrder.With(shipRow);
        Gallery.demoOrder.Add(Gallery.T("Shipping address", "收货地址"), orderAddr)
            .Rule(FormRule.Required(Gallery.T("Address is required for delivery", "快递配送需要收货地址")));
        Gallery.demoOrder.Add(Gallery.T("Pickup store", "自提门店"), orderStore)
            .Rule(FormRule.Required(Gallery.T("Pick a store first", "请选择自提门店")));
        Gallery.demoOrder.Add(Gallery.T("Gift wrap + card", "礼品包装 + 贺卡"), orderGift);
        Gallery.demoOrder.Add("", orderGiftNote);
        Gallery.demoOrder.Add(Gallery.T("Invoice", "需要发票"), orderInvoice);
        Gallery.demoOrder.Add(Gallery.T("Invoice title", "发票抬头"), orderTitle)
            .Rule(FormRule.Required(Gallery.T("Invoice title is required", "开具发票需要抬头")));
        Panel orderActions = Panel.Row().Gap(app.Scale(10));
        Button orderGo = new Button { Text = Gallery.T("Place order", "提交订单"), Class = "primary" };
        orderGo.OnClick(() => {
            if (Gallery.demoOrder.Validate()) {
                Gallery.demoOrderStatus.Text = Gallery.T("Order placed.", "订单已提交。");
                Gallery.demoOrderStatus.Class = "success";
            } else {
                Gallery.demoOrderStatus.Text = Gallery.T(
                    "Check the highlighted fields ("
                        + Convert.ToString(Gallery.demoOrder.ErrorCount()) + ").",
                    "请先处理标红的字段（" + Convert.ToString(Gallery.demoOrder.ErrorCount()) + " 处）。");
                Gallery.demoOrderStatus.Class = "error";
            }
        });
        orderActions.With(orderGo);
        Gallery.demoOrderStatus = new Label("");
        Gallery.demoOrder.With(orderActions);
        Gallery.demoOrder.With(Gallery.demoOrderStatus);
        // ---- Switch.master：总开关禁用子开关组 ----------------------
        Gallery.demoMaster = new Switch();
        Gallery.demoMaster.data = Gallery.model.masterOn;
        Gallery.demoMasterA = new Switch();
        Gallery.demoMasterA.data = Gallery.model.featA;
        Gallery.demoMasterB = new Switch();
        Gallery.demoMasterB.data = Gallery.model.featB;
        Gallery.demoMasterGroup = Panel.Column().Gap(app.Scale(8));
        Panel masterRowA = Panel.Row().Gap(app.Scale(12));
        masterRowA.With(new Label(Gallery.T("Email alerts", "邮件提醒")));
        masterRowA.With(Gallery.demoMasterA);
        Panel masterRowB = Panel.Row().Gap(app.Scale(12));
        masterRowB.With(new Label(Gallery.T("Weekly digest", "每周摘要")));
        masterRowB.With(Gallery.demoMasterB);
        Gallery.demoMasterGroup.With(masterRowA);
        Gallery.demoMasterGroup.With(masterRowB);
        // ---- Radio.dependent：「其他」才启用的备注输入框 -------------
        Gallery.demoHowhearNote = new Input(Gallery.T("Tell us more", "请具体说明"));
        Gallery.demoHowhearNote.name = "howhearNote";
        Gallery.demoHowhearNote.data = Gallery.model.otherNote;
        // ---- Switch.settings：设置行（左标题+描述，右开关）----------
        Gallery.model.setSync = true;
        Gallery.demoSetSync = new Switch();
        Gallery.demoSetSync.data = Gallery.model.setSync;
        Gallery.demoSetCompact = new Switch();
        Gallery.demoSetCompact.data = Gallery.model.setCompact;
        Gallery.demoSetPublic = new Switch();
        Gallery.demoSetPublic.data = Gallery.model.setPublic;
        Gallery.setPrevCount = 0;
        // ---- Switch.async：异步保存（拨动后 Loading 半秒再落值）-----
        Gallery.demoAsyncSw = new Switch();
        Gallery.demoAsyncSw.data = Gallery.model.asyncOn;
        // ---- Switch.value：int 绑定轴（开关表达 swVal==10，写回 10/20）--
        Gallery.demoSwVal = new Switch();
        Gallery.demoSwVal.value = Gallery.model.swVal;
        Gallery.demoSwVal.CheckedValue = 10;
        Gallery.demoSwVal.UncheckedValue = 20;
        // Watermark.custom：配置面板控件建一次并双向绑到 model.wm*。
        // InputNumber/Slider 自带取值范围，越界值在控件里就被钳住，
        // 水印侧不必再防野值。
        Gallery.model.wmText = "内部资料\nINTERNAL";
        Gallery.model.wmColor = "0x4D808080";
        Gallery.model.wmFontPx = 16;
        Gallery.model.wmWeight = 0;
        Gallery.model.wmRotate = 0 - 22;
        Gallery.model.wmLineH = 0;
        Gallery.model.wmTileW = 0;
        Gallery.model.wmTileH = 0;
        Gallery.model.wmGapX = 100;
        Gallery.model.wmGapY = 100;
        Gallery.model.wmOffX = 0;
        Gallery.model.wmOffY = 0;
        Gallery.model.wmAlign = 0;
        Gallery.model.wmNoClip = false;
        Gallery.wmTextInput = new Input("水印文本，\\n 分行");
        Gallery.wmTextInput.data = Gallery.model.wmText;
        Gallery.wmColorInput = new Input("0xAARRGGBB / RRGGBB");
        Gallery.wmColorInput.data = Gallery.model.wmColor;
        Gallery.wmFontNum = new InputNumber(4, 72);
        Gallery.wmFontNum.data = Gallery.model.wmFontPx;
        Gallery.wmWeightSel = SelectBox.FromOptions(
            new List<string> { Gallery.T("Normal", "正常"),
                               Gallery.T("Bold", "加粗") }, "");
        Gallery.wmWeightSel.data = Gallery.model.wmWeight;
        Gallery.wmRotateSld = new Slider(0 - 90, 90);
        Gallery.wmRotateSld.data = Gallery.model.wmRotate;
        Gallery.wmLineHNum = new InputNumber(0, 64);
        Gallery.wmLineHNum.data = Gallery.model.wmLineH;
        Gallery.wmTileWNum = new InputNumber(0, 400);
        Gallery.wmTileWNum.data = Gallery.model.wmTileW;
        Gallery.wmTileHNum = new InputNumber(0, 240);
        Gallery.wmTileHNum.data = Gallery.model.wmTileH;
        Gallery.wmGapXNum = new InputNumber(0, 200);
        Gallery.wmGapXNum.data = Gallery.model.wmGapX;
        Gallery.wmGapYNum = new InputNumber(0, 200);
        Gallery.wmGapYNum.data = Gallery.model.wmGapY;
        Gallery.wmOffXNum = new InputNumber(0 - 100, 100);
        Gallery.wmOffXNum.data = Gallery.model.wmOffX;
        Gallery.wmOffYNum = new InputNumber(0 - 100, 100);
        Gallery.wmOffYNum.data = Gallery.model.wmOffY;
        Gallery.wmAlignSel = SelectBox.FromOptions(
            new List<string> { Gallery.T("Left@左对齐", "左对齐"),
                               Gallery.T("Center", "居中"),
                               Gallery.T("Right@右对齐", "右对齐") }, "");
        Gallery.wmAlignSel.data = Gallery.model.wmAlign;
        Gallery.wmClipSw = new Switch();
        Gallery.wmClipSw.data = Gallery.model.wmNoClip;
        Gallery.asyncApplied = false;
        Gallery.asyncPending = 0;
        // ---- Radio.cards：三张选项卡的单选钮（只画圆点，文字在卡上）--
        Gallery.demoPick0 = new Radio(0, "");
        Gallery.demoPick0.data = Gallery.model.radioPick;
        Gallery.demoPick1 = new Radio(1, "");
        Gallery.demoPick1.data = Gallery.model.radioPick;
        Gallery.demoPick2 = new Radio(2, "");
        Gallery.demoPick2.data = Gallery.model.radioPick;
        Gallery.radioPickPrev = 0;
        // ---- RadioGroup：组容器自持选项排布与选中信号 ----------------
        Gallery.demoRg = new RadioGroup();
        Gallery.demoRg.AddOption(Gallery.T("Same-day delivery", "当日达配送"));
        Gallery.demoRg.AddOption(Gallery.T("Store pickup (flagship)", "门店自提（旗舰店）"));
        Gallery.demoRg.AddOption(Gallery.T("Courier locker", "快递柜投递"));
        Gallery.demoRg.AddOption(Gallery.T("Scheduled slot", "预约时段配送"));
        Gallery.rgPrev = 0;
        // New usage: instance widgets bound to plain model fields via `.data`.
        Gallery.demoCheck = new Checkbox("Checked");
        Gallery.demoCheck.data = Gallery.model.toggle;
        Gallery.demoSwitch = new Switch();
        Gallery.demoSwitch.data = Gallery.model.toggle;
        Gallery.demoRadioA = new Radio(0, "Option A");
        Gallery.demoRadioA.data = Gallery.model.level;
        Gallery.demoRadioB = new Radio(1, "Option B");
        Gallery.demoRadioB.data = Gallery.model.level;
        Gallery.demoSlider = new Slider(0, 100);
        Gallery.demoSlider.data = Gallery.model.level;
        // ---- Slider 演示族：范围 / 标记 / 垂直 / 气泡 / 禁用 ----------
        Gallery.model.sldLo = 30;
        Gallery.model.sldHi = 70;
        Gallery.demoSliderRange = new Slider(0, 100);
        Gallery.demoSliderRange.range = true;
        Gallery.demoSliderRange.data = Gallery.model.sldLo;
        Gallery.demoSliderRange.dataHigh = Gallery.model.sldHi;
        Gallery.demoSliderLo = new InputNumber(0, 100);
        Gallery.demoSliderLo.data = Gallery.model.sldLo;
        Gallery.demoSliderHi = new InputNumber(0, 100);
        Gallery.demoSliderHi.data = Gallery.model.sldHi;
        Gallery.model.sldMark = 37;
        Gallery.demoSliderMarks = new Slider(0, 100);
        Gallery.demoSliderMarks.AddMark(0, "0°C");
        Gallery.demoSliderMarks.AddMark(20, "20°C");
        Gallery.demoSliderMarks.AddMark(37, "37°C");
        Gallery.demoSliderMarks.AddMark(100, "100°C");
        Gallery.demoSliderMarks.data = Gallery.model.sldMark;
        Gallery.demoSliderStepMark = new Slider(0, 100);
        Gallery.demoSliderStepMark.AddMark(0, "0°C");
        Gallery.demoSliderStepMark.AddMark(20, "20°C");
        Gallery.demoSliderStepMark.AddMark(37, "37°C");
        Gallery.demoSliderStepMark.AddMark(100, "100°C");
        Gallery.demoSliderStepMark.stepMark = true;
        Gallery.demoSliderStepMark.data = Gallery.model.sldMark;
        Gallery.demoSliderVt = new Slider(0, 100);
        Gallery.demoSliderVt.vertical = true;
        Gallery.demoSliderVt.AddMark(0, "0°C");
        Gallery.demoSliderVt.AddMark(37, "37°C");
        Gallery.demoSliderVt.AddMark(100, "100°C");
        Gallery.demoSliderVt.data = Gallery.model.sldMark;
        Gallery.demoSliderVtRev = new Slider(0, 100);
        Gallery.demoSliderVtRev.vertical = true;
        Gallery.demoSliderVtRev.reverse = true;
        Gallery.demoSliderVtRev.data = Gallery.model.sldMark;
        Gallery.model.sldFmt = 50;
        Gallery.demoSliderNoTip = new Slider(0, 100);
        Gallery.demoSliderNoTip.tooltip = false;
        Gallery.demoSliderNoTip.data = Gallery.model.sldFmt;
        Gallery.demoSliderAlways = new Slider(0, 100);
        Gallery.demoSliderAlways.showTooltip = true;
        Gallery.demoSliderAlways.data = Gallery.model.sldFmt;
        Gallery.demoSliderFmt = new Slider(0, 100);
        Gallery.demoSliderFmt.tipFormat = "{v}%";
        Gallery.demoSliderFmt.data = Gallery.model.sldFmt;
        Gallery.demoSliderDisabled = new Slider(0, 100);
        Gallery.demoSliderDisabled.SetValue(50);
        Gallery.demoSliderDisabled.Disabled = true;
        // ---- Transfer 演示族：基础 / 可过滤 / 一大堆数据 / 自定义标签。
        // 两侧列表都是 Gallery 自持的实时列表，Bind 不拷贝——中缝按钮
        // 直接在这两份列表上增删，宿主读回的就是同一对象。
        Gallery.trfSrc = new List<string>();
        Gallery.trfTgt = new List<string>();
        for (int ti = 1; ti <= 8; ti = ti + 1) {
            Gallery.trfSrc.Add("Option " + Convert.ToString(ti));
        }
        Gallery.trfTgt.Add("Option 5");
        Gallery.demoTransfer = new Transfer<string>();
        Gallery.demoTransfer.Bind(Gallery.trfSrc, Gallery.trfTgt);
        Gallery.trfCitySrc = new List<string>();
        Gallery.trfCityTgt = new List<string>();
        for (int ci2 = 1; ci2 <= 20; ci2 = ci2 + 1) {
            Gallery.trfCitySrc.Add(Gallery.T("City ", "城市 ") + Convert.ToString(ci2));
        }
        Gallery.trfCityTgt.Add(Gallery.T("City ", "城市 ") + "7");
        Gallery.demoTransferFilter = new Transfer<string>();
        Gallery.demoTransferFilter.Bind(Gallery.trfCitySrc, Gallery.trfCityTgt);
        Gallery.demoTransferFilter.WithSearchHints(
            Gallery.T("type to filter", "请输入筛选条件"),
            Gallery.T("type to filter", "请输入筛选条件"));
        // 四万两千项：行区每帧只遍历视口切片，这份数据只喂给一次 Order。
        Gallery.trfHugeSrc = new List<string>();
        Gallery.trfHugeTgt = new List<string>();
        for (int hi = 0; hi < 42000; hi = hi + 1) {
            Gallery.trfHugeSrc.Add("Item " + Convert.ToString(hi));
        }
        Gallery.trfHugeSrc.Add("Special");   // 搜索命中的 needle in a stack
        Gallery.demoTransferHuge = new Transfer<string>();
        Gallery.demoTransferHuge.Bind(Gallery.trfHugeSrc, Gallery.trfHugeTgt);
        Gallery.demoTransferHuge.WithSearch();
        Gallery.trfUserSrc = new List<TransferUser>();
        Gallery.trfUserTgt = new List<TransferUser>();
        Gallery.trfUserSrc.Add(new TransferUser("Tom", Gallery.T("Developer", "工程师"), true));
        Gallery.trfUserSrc.Add(new TransferUser("Jerry", Gallery.T("Designer", "设计师"), false));
        Gallery.trfUserSrc.Add(new TransferUser("Spike", Gallery.T("Product", "产品"), true));
        Gallery.trfUserSrc.Add(new TransferUser("Tyke", Gallery.T("Tester", "测试"), false));
        Gallery.trfUserSrc.Add(new TransferUser("Butch", Gallery.T("Ops@运维", "运维"), false));
        Gallery.trfUserTgt.Add(new TransferUser("Lighty", Gallery.T("Manager", "经理"), true));
        Gallery.demoTransferUser = new Transfer<TransferUser>();
        Gallery.demoTransferUser.Bind(Gallery.trfUserSrc, Gallery.trfUserTgt);
        Gallery.demoTransferUser.WithLabel(u => u.name + " · " + u.role);
        Gallery.demoTransferUser.WithIcon(u => u.vip ? "star" : "");
        Gallery.demoTransferUser.WithSearch();
        // ---- InputNumber 演示族：位置 / 前后缀 / 范围 / 分组 / 精度 /
        // 加载 / 验证（Naive UI n-input-number 对齐，全部保留态）。
        Gallery.model.numBasic = 1;
        Gallery.demoNumBasic = new InputNumber(0 - 9999, 9999);
        Gallery.demoNumBasic.data = Gallery.model.numBasic;
        Gallery.demoNumRight = new InputNumber(0 - 9999, 9999);
        Gallery.demoNumRight.Placement = "right";
        Gallery.demoNumRight.data = Gallery.model.numBasic;
        Gallery.demoNumSmall = new InputNumber(0 - 9999, 9999);
