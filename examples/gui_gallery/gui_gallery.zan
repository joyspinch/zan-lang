        } else if (name == "Input.filter") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Only digits", Gallery.demoDigits,
                    Gallery.T("Filter (allow-input) rewrites every candidate; rejected text never lands.",
                        "Filter（allow-input）逐候选改写；被拒绝的输入不会落地。")),
                name, px, y + app.Scale(34), w - app.Scale(36),
