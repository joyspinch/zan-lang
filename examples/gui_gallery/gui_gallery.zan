        Gallery.demoQuoteNames.Add("BABA");
        Gallery.demoQuotePrices.Add("171.20");
        Gallery.demoQuoteChanges.Add("-1.43");
        Gallery.demoVListTpl = new VirtualList();
        Gallery.demoVListTpl.SetRowHeight(36);
        Gallery.demoVListTpl.SetRows(Gallery.demoQuoteNames.Count,
            qi => Gallery.QuoteRow(qi));
        Gallery.selected = new SignalInt(0);
        Gallery.navScroll = new SignalInt(0);
        Gallery.codeTab = new SignalInt(0);
        Gallery.detailView = new ScrollView();
        Gallery.detailView.SetEdgeInset(true);
        Gallery.detailContentH = new SignalInt(0);
        Gallery.codeScroll = new SignalInt(0);
        Gallery.navView = new ScrollView();
        Gallery.tbLine = new Tabs(Tabs.Line());
        Gallery.tbLine.Add("Overview", false);
        Gallery.tbLine.Add("API", false);
        Gallery.tbLine.Add("Examples", false);
        Gallery.tbSeg = new Tabs(Tabs.Segment());
        Gallery.tbSeg.Add("Day", false);
        Gallery.tbSeg.Add("Week", false);
        Gallery.tbSeg.Add("Month", false);
        // Card style: closable tabs + a trailing "+" to add tabs, with enough
        // tabs to overflow the demo width (chevrons / wheel scroll / right-click
        // context menu all reachable).
        Gallery.tbCard = new Tabs(Tabs.Card());
        Gallery.tbCard.SetShowAdd(true);
        Gallery.tbCard.Add("index.zan", true);
        Gallery.tbCard.Add("parser.c", true);
        Gallery.tbCard.Add("irgen.c", true);
        Gallery.tbCard.Add("Render.zan", true);
        Gallery.tbCard.Add("ScrollView.zan", true);
        Gallery.tbCard.Add("Tabs.zan", true);
        // Vertical rail: header strip on the side, page content drawn separately.
        Gallery.tbVert = Tabs.CreateVertical(Tabs.Line());
        Gallery.tbVert.Add("Files", false);
        Gallery.tbVert.Add("Search", false);
        Gallery.tbVert.Add("Source Control", false);
        Gallery.tbVert.Add("Run", false);
        Gallery.selHas = false;
        Gallery.selDrag = false;
        Gallery.demoTags = new List<string>();
        Gallery.demoTags.Add("Design"); Gallery.demoTags.Add("Frontend");
        Gallery.demoTags.Add("Urgent");
        List<string> lowOpts = new List<string>();
        lowOpts.Add("Default"); lowOpts.Add("Success"); lowOpts.Add("Warning");
        Gallery.model.pick = 0;
        Gallery.demoSelectLow = SelectBox.FromOptions(lowOpts, "Choose a state");
        Gallery.demoSelectLow.data = Gallery.model.pick;
        List<string> ddItems = new List<string>();
        ddItems.Add("Edit"); ddItems.Add("Duplicate"); ddItems.Add("Delete");
        Gallery.demoDropdown = new Dropdown<string>(s => s);
        Gallery.demoDropdown.Hint("Actions");
        Gallery.demoDropdown.Bind(ddItems);
        Gallery.demoPopover = new Popover("More info",
            "Popover", "Anchored, word-wrapped content that stays on screen and blocks clicks to the widgets beneath it.", app.Scale(260));
        Gallery.filePicker = new FilePicker();
        Gallery.pickerResult = "";
        Gallery.pendingPicker = "";
        Gallery.copiedIcon = "";
        Gallery.demoTableState = new DataTableState();
        Gallery.demoStyler = new ScoreStyler();
        Gallery.demoTableState.styler = Gallery.demoStyler;
        Gallery.demoTableState.allowAddRow = true;   // show the "add row" line
        Gallery.demoRows = new List<DataRow>();
        Gallery.demoRows.Add(Gallery.DtRow7("Alpha", "Zan", "98", "128000", "Engineering", "San Francisco", "143400"));
        Gallery.demoRows.Add(Gallery.DtRow7("Beta", "Lang", "87", "94500", "Sales", "New York", "105800"));
        Gallery.demoRows.Add(Gallery.DtRow7("Alpha", "Kite", "91", "112300", "Engineering", "Los Angeles", "125800"));
        Gallery.demoRows.Add(Gallery.DtRow7("Beta", "Vale", "82", "88000", "Operations", "New York", "98600"));
        Gallery.demoRows.Add(Gallery.DtRow7("Alpha", "Orin", "76", "76400", "Engineering", "Seattle", "85600"));
        Gallery.demoRows.Add(Gallery.DtRow7("Beta", "Nyx", "95", "141200", "Sales", "San Francisco", "158100"));
        Gallery.demoRows.Add(Gallery.DtRow7("Gamma", "Rune", "88", "99900", "Operations", "Los Angeles", "111900"));
        Gallery.demoRows.Add(Gallery.DtRow7("Alpha", "Sol", "69", "65000", "Engineering", "Seattle", "72800"));
        Gallery.demoRows.Add(Gallery.DtRow7("Gamma", "Wren", "93", "133750", "Sales", "San Francisco", "149800"));
        Gallery.demoRows.Add(Gallery.DtRow7("Beta", "Iris", "74", "81200", "Operations", "New York", "90900"));
        Gallery.demoRows.Add(Gallery.DtRow7("Gamma", "Fox", "81", "90500", "Engineering", "Los Angeles", "101400"));
        Gallery.demoRows.Add(Gallery.DtRow7("Alpha", "Ash", "90", "119000", "Sales", "Seattle", "133300"));
        Gallery.bigTableState = new DataTableState();
        Gallery.bigTableState.showSummary = true;
        Gallery.bigCols = null;
        Gallery.bigSource = null;
        Gallery.bigRowCount = 0;
        Gallery.bigBuildMs = 0;
        Gallery.bigRowsSel = new SignalInt(2);
        List<string> bigRowOpts = new List<string>();
        bigRowOpts.Add("100,000"); bigRowOpts.Add("500,000");
        bigRowOpts.Add("1,000,000"); bigRowOpts.Add("5,000,000");
        Gallery.bigRowsSelect = SelectBox.Bind(bigRowOpts, Gallery.bigRowsSel, "rows");
        Gallery.demoLayers = new List<LayerState>();
        Gallery.layerSeq = 0;
        Gallery.dlgAlert = LayerState.Alert("Notice", "Your changes have been saved.", 1);
        Gallery.dlgConfirm = LayerState.Confirm("Please confirm", "Delete this item permanently?", 2);
        Gallery.dlgPrompt = LayerState.Prompt("Rename item", "new name");
        Gallery.tipsOn = new SignalBool(false);
        Gallery.tipClickOn = new SignalBool(false);
        Gallery.scrollOff = new SignalInt(0);
        Gallery.tipScroll = new SignalInt(0);
        Gallery.photosOpen = new SignalBool(false);
        Gallery.loadStartMs = 0;
        Gallery.photoIdx = new SignalInt(0);
        Gallery.photoAnim = new CarouselAnim();
        Gallery.photoSlides = new List<string>();
        Gallery.photoSlides.Add("Aurora");
        Gallery.photoSlides.Add("Canyon");
        Gallery.photoSlides.Add("Harbor");
        Gallery.photoSlides.Add("Meadow");
        Gallery.photoSlides.Add("Skyline");
        Gallery.popupResult = "";
        Gallery.copiedFrame = 0;
        Gallery.apiSelKind = 0;
        Gallery.apiSelA = 0;
        Gallery.apiSelB = 0;
        Gallery.apiSelDrag = false;
        Gallery.apiCopiedFrame = 0;
        Gallery.designer = new Designer();
        Gallery.designer.Seed(app);

        // Bilingual + persistent demo models.
        Gallery.lang = new SignalInt(0);
        Gallery.splitVFirst = new SignalInt(app.Scale(150));
        Gallery.splitHFirst = new SignalInt(app.Scale(70));
        Gallery.treeSel = new SignalInt(2);
        Gallery.treeNodes = Gallery.BuildTree();
        Gallery.treeTv = new TreeView();
        Gallery.treeTv.BindSel(Gallery.treeSel).WithChecks();
        Gallery.treeTv.OnContext(Gallery.TreeMenu);
        Gallery.treeMenuOpen = new SignalBool(false);
        Gallery.treeMenuAction = new SignalInt(0 - 1);
        Gallery.treeMenuSub = new SignalInt(0 - 1);
        Gallery.treeMenuX = 0;
        Gallery.treeMenuY = 0;
        Gallery.treeMenuNode = 0 - 1;
        Gallery.treeMenuBaseId = WidgetId.Block(256);
        Gallery.ribbonTab = new SignalInt(0);
        Gallery.wizName = Input.Bind(new SignalString("MyApp"), "project name");
        Gallery.wizLoc = Input.Bind(new SignalString("d:/projects"), "location");
        Gallery.wizSel = new SignalInt(1);
        Gallery.fbScroll = new SignalInt(0);
        Gallery.navSearch = Input.Bind(new SignalString(""), "Search components");
        Gallery.HmiSetup(app);

        Gallery.comps = new List<Comp>();
        Gallery.BuildComps(Gallery.comps);

        // Title-bar skin picker is now a built-in window feature: App.Create/
        // CreateDark call EnableSkins() so the theme caption button is the
        // shared Theme.PresetNames dropdown and App applies the pick itself.
        Gallery.app = app;
        // Optional deep-link: `gallery_test.exe <ComponentName>` lands directly
        // on that component (used for screenshot/verification and handy nav).
        if (Environment.ArgCount() > 0) {
            string want = Environment.ArgAt(0);
            int ci = 0;
            while (ci < Gallery.comps.Count) {
                if (Gallery.comps[ci].name == want) {
                    Gallery.selected.Set(ci);
                    ci = Gallery.comps.Count;
                } else {
                    ci = ci + 1;
                }
            }
            // Second arg "open" pre-opens the selected popup demo so its
            // open state can be captured for verification screenshots.
            for (int ti = 0; ti < Environment.ArgCount(); ti = ti + 1) {
                string a = Environment.ArgAt(ti);
                if (a == "light") { Gallery.SelectTheme(app, 1); }
                else if (a == "dark") { Gallery.SelectTheme(app, 0); }
                else if (a == "liquidglass") { Gallery.SelectTheme(app, 2); }
                else if (a == "custom") { Gallery.designer.ScrollPaletteToEnd(); }
                // "free" opens the designer demo on the free canvas, the
                // layout a .zform window design uses, so screenshots can
                // check the canvas and not just the flow form.
                else if (a == "free") { Gallery.designer.SetLayoutMode(1); }
                else if (a == "glass") { Gallery.SelectTheme(app, 2); }
                else if (a == "neon") { Gallery.SelectTheme(app, 3); }
                else if (a == "brutalism") { Gallery.SelectTheme(app, 4); }
                else if (a == "chinese") { Gallery.SelectTheme(app, 5); }
                // Any other installed skin pack can be named directly, so a
                // screenshot can pin down the exact skin ("dreamy", "darkgold").
                else if (app.SkinIndexOf(a) >= 0) { app.ApplySkinName(a); }
                else if (a == "zh") { Gallery.SetLang(1); }
                else if (a == "en") { Gallery.SetLang(0); }
                else if (a.Length > 1 && a[0] == 'y') {
                    // yNNN scrolls the detail pane to pixel NNN once the page
                    // has been measured (see pendingScroll).
                    Gallery.pendingScroll =
                        Gallery.ArgInt(a.Substring(1, a.Length - 1));
                }
            }
            if (Environment.ArgCount() > 1 && Environment.ArgAt(1) == "open") {
                if (want == "Layer") {
                    string st = "window";
                    if (Environment.ArgCount() > 2) { st = Environment.ArgAt(2); }
                    if (st == "alert") { Gallery.dlgAlert.Open(); }
                    else if (st == "confirm") { Gallery.dlgConfirm.Open(); }
                    else if (st == "prompt") { Gallery.dlgPrompt.Open(); }
                    else if (st == "msg") {
                        Layer.Msg("Saved successfully", 3);
                        Layer.Msg("Unsaved changes", 4);
                        Layer.Msg("Network error", 5);
                    } else if (st == "notify") {
                        Layer.Notify("Build completed", 3);
                        Layer.Notify("New version available", 2);
                    } else if (st == "load") {
                        Gallery.loadStartMs = Window.GetTickMs();
                    } else if (st == "tips") {
                        Gallery.tipsOn.Set(true);
                    } else if (st == "photos") {
                        Gallery.photosOpen.Set(true);
                    } else {
                        Gallery.SpawnLayer(app);
                        if (st == "two") { Gallery.SpawnLayer(app); }
                    }
                } else if (want == "FilePicker") {
                    Gallery.pendingPicker = "file";
                    if (Environment.ArgCount() > 2) {
                        Gallery.pendingPicker = Environment.ArgAt(2);
                    }
                } else if (want == "Dropdown") {
                    Gallery.demoDropdown.Open();
                }
            }
        }

        // Delegate/event demo wiring: keep the app handle for background threads
        // and register the click handler once (retained, like OnClick += ...).
        Gallery.app = app;
        Gallery.evtValue = new SignalInt(0);
        Gallery.evtRunning = new SignalBool(false);
        Gallery.evtClicks = 0;
        Gallery.evtButton = new Button { Text = "Click me", Class = "primary" };
        Gallery.evtButton.Click += Gallery.OnDemoClick;
        Gallery.evtStartButton = new Button { Text = "Start background task", Class = "primary" };
        Gallery.evtStartButton.Click += Gallery.StartTask;
        Gallery.apiCopyProps = new Button { Text = "Copy", Icon = "copy",
                                            Class = "secondary small" };
        Gallery.apiCopyEvents = new Button { Text = "Copy", Icon = "copy",
                                             Class = "secondary small" };

        app.Show();
        // Same drawing code the loop below runs, registered so the framework can
        // paint a frame from inside the window procedure: dragging a window edge
        // enters the system modal resize loop, which never returns to this loop,
        // so without it the surface stays at the old size and the newly exposed
        // strip is blank until the drag ends.
        app.SetFrameBody(() => {
            WidgetId.ResetFrame();
            Gallery.Render(app);
            app.RenderChrome("Zan GUI Components");
        });
        // Freeze the id baseline after all retained ids (chrome etc.) exist, so
        // the per-frame ResetFrame() below never reissues one of them.
        WidgetId.Mark();
        // Deep-link dialog opens are deferred to here: paint the main window once
        // so it owns the OS foreground, then open the child so its show-time
        // focus grab succeeds (opening before the parent is foreground lets the
        // parent steal focus straight back).
        if (Gallery.pendingPicker != "") {
            app.BeginFrame();
            WidgetId.ResetFrame();
            Gallery.Render(app);
            app.RenderChrome("Zan GUI Components");
            app.PresentFrame();
            if (Gallery.pendingPicker == "folder") {
                Gallery.filePicker.BeginFolder("", "Open folder");
            } else if (Gallery.pendingPicker == "save") {
                Gallery.filePicker.BeginSaveFile("", ".zan", "untitled.zan", "Save file");
            } else {
                Gallery.filePicker.BeginOpenFile("", ".zan", "Open file");
            }
            Gallery.pendingPicker = "";
        }
        while (app.isRunning) {
            // One shared event pump drives BOTH the main window and the
            // FilePicker's child dialog window (open/save file/folder). Poll (to
            // keep animating) when either wants a repaint; otherwise block.
            Gallery.filePicker.ApplySkin(app.ThemeMenuIndex());
            int r;
            if (Gallery.filePicker.NeedsRedraw()
                || (!Gallery.filePicker.IsOpen() && app.needsRedraw)) {
                int since = Window.GetTickMs() - app.lastPresentMs;
                if (app.lastPresentMs > 0 && since < 16) {
                    Window.SleepMs(16 - since);
                }
                r = app.window.PollEvent();
            } else if (!Gallery.filePicker.IsOpen()
                       && (app.animNextMs >= 0 || app.fxNextMs >= 0)) {
                // A throttled animation (spinner/skeleton) and/or the skin
                // effect layer wants its next frame; idle until the earliest
                // deadline, but poll in slices so input still wakes the loop
                // promptly. An effect-only tick is served in place by
                // App.FxPresent (frame-snapshot restore + re-composite).
                r = 1;
                bool waiting = true;
                while (waiting) {
                    int now = Window.GetTickMs();
                    int deadline = app.animNextMs;
                    if (deadline < 0
                        || (app.fxNextMs >= 0 && app.fxNextMs < deadline)) {
                        deadline = app.fxNextMs;
                    }
                    if (deadline < 0) { waiting = false; }
                    else if (now >= deadline) {
                        bool fxOnly = app.animNextMs < 0 || now < app.animNextMs;
                        if (!(fxOnly && app.FxPresent())) {
                            app.RequestRedraw();
                            waiting = false;
                        }
                    } else {
                        // Single kernel wait until input or the deadline (no
                        // poll + sleep slices; idle waiting costs no CPU).
                        r = app.window.WaitEventTimeout(deadline - now);
                        if (r != 1) { waiting = false; }
                    }
                }
            } else {
                r = app.window.WaitEvent();
            }
            if (r < 0) { break; }
            app.DrainPosts();
            // 自定义事件循环要自行推进自动化驱动（标准循环在
            // ProcessEvent 里做）；否则 ZAN_UI_SCRIPT 永不前进。
            UiDriver.Tick();

            nint evh = Window.EventHwnd();
            int kind = app.window.EventKind();

            if (kind == 8) {
                if (Gallery.filePicker.OwnsWindow(evh)) {
                    Gallery.filePicker.ApplyEvent(evh);
                } else if (evh == app.WindowHandle()) {
                    break;
                }
            } else if (Gallery.filePicker.OwnsWindow(evh)) {
                // Route each input frame to whichever window OWNS it (by native
                // hwnd), not merely to the dialog whenever it is open. Native
                // events already carry their originating window, and each App
                // only acts on its own (App.ApplyEvent ignores foreign hwnds),
                // so the parent stays fully responsive while the child dialog is
                // open and there is still no cross-window click-through.
                Gallery.filePicker.ApplyEvent(evh);
            } else {
                // The gallery handles wheel scrolling and code selection inside
                // its own Render pass, so it paints on every input event rather
                // than only when the framework flags a repaint. Pointer motion
                // (kind 1) is throttled to ~30fps so moving over a busy page (or
                // the glass theme's per-frame blur) can't peg the CPU.
                bool inputEv = kind == 2 || kind == 3 || kind == 13
                    || kind == 4 || kind == 6;
                bool doFrame = true;
                if (!app.needsRedraw && !inputEv) {
                    if (kind != 1) {
                        doFrame = false;
                    } else {
                        int nowMotion = Window.GetTickMs();
                        if (nowMotion - Gallery.lastMotionMs < 33) {
                            doFrame = false;
                        } else {
                            Gallery.lastMotionMs = nowMotion;
                        }
                    }
                }
                app.ApplyEvent(evh);
                if (doFrame) {
                    app.BeginFrame();
                    // Pure immediate-mode page: every preview widget is rebuilt
                    // each frame, so rewind the widget-id counter here to keep
                    // ids stable across frames -- otherwise hover/press/click
                    // never match the pointer target resolved last frame.
                    WidgetId.ResetFrame();
                    Gallery.Render(app);
                    app.RenderChrome("Zan GUI Components");
                    app.PresentFrame();
                    // 诊断环缓冲：ZAN_CANVAS_RING 打开后每帧把画布转储到
                    // 固定 50 个槽位（c_0..c_49.bmp，循环覆盖）。退出前
                    // 磁盘上恰好是最后 50 个已呈现帧，用于把屏幕上的
                    // 瞬时花屏与画布真值逐帧对质。
                    if (Gallery.ringDump) {
                        app.canvas.Dump("c_"
                            + Convert.ToString(Gallery.ringIdx) + ".bmp");
                        Gallery.ringIdx = (Gallery.ringIdx + 1) % 50;
                    }
                }
            }

            // Paint the dialog window (if open) and harvest its result.
            Gallery.filePicker.RenderWindow();
            int pr = Gallery.filePicker.TakeResult();
            if (pr != 0) {
                // The dialog just closed. Opening it force-activated the child
                // window (borderless children don't get OS foreground for free),
                // so on close the OS hands foreground to some other window, not
                // the parent -- leaving it without keyboard focus. Re-activate
                // the parent (Show performs the raise + foreground + text-input
                // hand-off) and repaint it so it is fully live again.
                app.window.Show();
                app.RequestRedraw();
                if (pr == 1) {
                    Gallery.pickerResult = Gallery.filePicker.SelectedPath();
                }
            }
        }
    }

    // ------------------------------------------------------------------
    // Delegate / thread-safe event demo callbacks
    // ------------------------------------------------------------------

    // Handler registered with `button.Click += ...`. Fires on the UI thread.
    static void OnDemoClick() {
        Gallery.evtClicks = Gallery.evtClicks + 1;
    }

    // Click handler registered on the EventHub. Spawns a background worker
    // thread once (ignored while one is already running).
    static void StartTask() {
        if (!Gallery.evtRunning.Get()) {
            Gallery.evtValue.Set(0);
            Gallery.evtRunning.Set(true);
            Thread.Start(Gallery.EventsWorker);
        }
    }

    // Runs on a background OS thread: it must NOT touch UI state directly, so it
    // hands each update back to the UI thread with app.Post (Control.Invoke).
    static void EventsWorker() {
        for (int i = 0; i < 5; i = i + 1) {
            Thread.Sleep(140);
            Gallery.app.Post(Gallery.Tick);
        }
        Gallery.app.Post(Gallery.Finish);
    }

    // These run on the UI thread when the queue is drained each frame.
    static void Tick() { Gallery.evtValue.Set(Gallery.evtValue.Get() + 1); }
    static void Finish() { Gallery.evtRunning.Set(false); }

    // ------------------------------------------------------------------
    // Theme switching
    // ------------------------------------------------------------------

    /// Programmatic switch (deep-link args): applies the built-in skin and keeps
    /// the title-bar picker model in sync (App owns the index -> Theme mapping).
    static void SelectTheme(App app, int i) {
        app.ApplySkin(i);
    }

    // ------------------------------------------------------------------
    // Bilingual helpers
    // ------------------------------------------------------------------

    /// Pick the English or Chinese string for the current demo language.
    static string T(string en, string zh) {
        if (Gallery.lang.Get() == 1) { return zh; }
        return en;
    }

    /// Map the row-count picker index to a row count for the large-data demo.
    static int BigRowCountFor(int idx) {
        if (idx == 0) { return 100000; }
        if (idx == 1) { return 500000; }
        if (idx == 3) { return 5000000; }
        return 1000000;
    }

    /// Switch language and rebuild the catalog so descriptions, snippets and
    /// demo data (all built through T() at catalog time) pick up the new
    /// language. Live widget state lives in stable static signals, so it is
    /// untouched by the rebuild. The static chart caches (perfHeat / scatter
    /// cloud / calendar heatmap) hold language-bound labels and series names,
    /// so they are released and rebuilt on the next frame instead.
    static void SetLang(int lang) {
        if (Gallery.lang.Get() == lang) { return; }
        Gallery.lang.Set(lang);
        if (Gallery.perfHeat != null && Gallery.app != null) {
            ChartView.ReleaseCached(Gallery.app.canvas, Gallery.perfHeatSlot);
        }
        Gallery.perfHeat = null;
        Gallery.scatterCloud = null;
        Gallery.calHeat = null;
        Gallery.comps = new List<Comp>();
        Gallery.BuildComps(Gallery.comps);
    }

    /// Builds the demo plant every HMI preview shares: one tag table plus the
    /// retained HMI widgets bound to it. Retained here (not in the catalog
    /// builder) because the catalog is rebuilt on a language switch while the
    /// live widget state -- keypad entry, acknowledged alarms, trend history --
    /// must survive.
    static void HmiSetup(App app) {
        Theme t = app.theme;
        Gallery.hmiIo = new TagTable();
        Gallery.hmiIo.SetPeriod(500);
        Gallery.hmiPv = Gallery.hmiIo.Add("TIC101.PV", "°C", 10)
            .Range(0, 3000).Limits(500, 2500);
        Gallery.hmiSp = Gallery.hmiIo.Add("TIC101.SV", "°C", 10).Range(0, 3000);
        Gallery.hmiFlow = Gallery.hmiIo.Add("FIC102.PV", "m3/h", 10)
            .Range(0, 5000).Limits(300, 4500);
        Gallery.hmiLevel = Gallery.hmiIo.Add("LI103.PV", "%", 1)
            .Range(0, 100).Limits(10, 90);
        Gallery.hmiPv.SetRaw(1500);
        Gallery.hmiSp.SetRaw(1800);
        Gallery.hmiFlow.SetRaw(2500);
        Gallery.hmiLevel.SetRaw(50);

        Gallery.hmiAlarms = new AlarmBuffer();
        Gallery.hmiBanner = new AlarmBanner(Gallery.hmiAlarms);
        Gallery.hmiAlarmList = new AlarmList(Gallery.hmiAlarms);

        Gallery.hmiTrend = new Trend("TIC101 / FIC102", 0, 5000, 10, 120);
        Gallery.hmiTrend.Add("TIC101.PV", Gallery.hmiPv, t.success);
        Gallery.hmiTrend.Add("TIC101.SV", Gallery.hmiSp, t.info);
        Gallery.hmiTrend.Add("FIC102.PV", Gallery.hmiFlow, t.warning);

        Gallery.hmiPad = new NumPad();
        Gallery.hmiPad.Target(Gallery.hmiSp);

        Gallery.hmiWall = new EquipPanel();
        DeviceCard w1 = Gallery.hmiWall.AddDevice("1# 进料泵");
        w1.Row("流量", Gallery.hmiFlow);
        w1.Row("液位", Gallery.hmiLevel);
        DeviceCard w2 = Gallery.hmiWall.AddDevice("2# 进料泵");
        w2.Row("流量", Gallery.hmiFlow);
        DeviceCard w3 = Gallery.hmiWall.AddDevice("反应釜 R101");
        w3.Row("温度", Gallery.hmiPv);
        w3.Row("设定", Gallery.hmiSp);
        DeviceCard w4 = Gallery.hmiWall.AddDevice("引风机");
        w4.Row("液位", Gallery.hmiLevel);

        Gallery.hmiCard = new DeviceCard("1# 压缩机");
        Gallery.hmiCard.Row("排气温度", Gallery.hmiPv);
        Gallery.hmiCard.Row("排气流量", Gallery.hmiFlow);

        Gallery.hmiGaugePv = new Gauge("TIC101.PV", Gallery.hmiPv)
            .Limits(500, 2500);
        Gallery.hmiGaugeFlow = new Gauge("FIC102.PV", Gallery.hmiFlow)
            .Limits(300, 4500);
        Gallery.hmiLoad = new SignalInt(62);
        Gallery.hmiGaugeFree = new Gauge("Load %", Gallery.hmiLoad, 0, 100);

        Gallery.hmiBarPv = new Bargraph("TIC101", Gallery.hmiPv);
        Gallery.hmiBarPv.Limits(500, 2500);
        Gallery.hmiBarFlow = new Bargraph("FIC102", Gallery.hmiFlow);
        Gallery.hmiBarFlow.Limits(300, 4500);
        Gallery.hmiBarLevel = new Bargraph("LI103", Gallery.hmiLevel);
        Gallery.hmiBarLevel.Limits(10, 90);
        Gallery.hmiBarLevel.Orient(Bargraph.Horizontal());

        Gallery.hmiLedOff = new Led("STOP");
        Gallery.hmiLedRun = new Led("RUN");
        Gallery.hmiLedRun.Set(1);
        Gallery.hmiLedWarn = new Led("WARN");
        Gallery.hmiLedWarn.Set(2);
        Gallery.hmiLedWarn.SetBlink(true);
        Gallery.hmiLedFault = new Led("FAULT");
        Gallery.hmiLedFault.Set(3);
        Gallery.hmiLedFault.SetBlink(true);
        Gallery.hmiLedComm = new Led("COMM");
        Gallery.hmiLedComm.Set(4);

        Gallery.hmiDigPv = new Digital("TIC101.PV", Gallery.hmiPv);
        Gallery.hmiDigSp = new Digital("TIC101.SV", Gallery.hmiSp);
        Gallery.hmiDigFlow = new Digital("FIC102.PV", Gallery.hmiFlow);
        Gallery.hmiDigLevel = new Digital("LI103.PV", Gallery.hmiLevel);

        Gallery.hmiScanMs = 0;
        Gallery.hmiSampleMs = 0;
    }

    /// The simulated I/O scan behind the HMI previews: it writes raw counts
    /// into the shared tags, samples the trend on its own beat and lets the
    /// alarm buffer derive alarms from the tag limits -- the same shape as a
    /// real Modbus/OPC poll thread, minus the field bus. Throttled to one pass
    /// per period, so the number of HMI cards on screen does not change the
    /// simulated scan rate.
    static void HmiTick(App app) {
        int now = Window.GetTickMs();
        if (now - Gallery.hmiScanMs < 60) { return; }
        Gallery.hmiScanMs = now;
        int ph = now / 40;
        Gallery.hmiPv.SetRaw(1500 + Gauge.SinDeg(ph % 360) * 1150 / 1000);
        Gallery.hmiFlow.SetRaw(2500
            + Gauge.SinDeg((ph * 2 + 60) % 360) * 2100 / 1000);
        Gallery.hmiLevel.SetRaw(50
            + Gauge.SinDeg((ph / 2 + 120) % 360) * 46 / 1000);
        // A recurring comms dropout, so the bad-quality styling (a "----"
        // readout, a greyed needle) shows up without faking the values.
        bool dropout = (now / 4000) % 5 == 4;
        if (dropout) {
            Gallery.hmiFlow.SetBad();
            Gallery.hmiLedComm.Set(3);
        } else {
            Gallery.hmiLedComm.Set(4);
        }
        Gallery.hmiLoad.Set(Gallery.hmiLevel.Percent());
        Gallery.hmiAlarms.Scan(Gallery.hmiIo);
        // Acknowledged + cleared records are dropped, so the demo list stays
        // the "what is wrong now" view rather than growing forever.
        Gallery.hmiAlarms.Purge();
        int st = (now / 3000) % 5;
        Gallery.hmiWall.Set("1# 进料泵", 1);
        Gallery.hmiWall.Set("2# 进料泵", st);
        Gallery.hmiWall.Set("反应釜 R101", 1);
        Gallery.hmiWall.Set("引风机", 4);
        Gallery.hmiCard.Set((now / 2500) % 5);
        if (now - Gallery.hmiSampleMs >= 250) {
            Gallery.hmiSampleMs = now;
            Gallery.hmiTrend.Sample();
        }
        app.RequestAnimationFrame(60);
    }

    /// One cell of the EN / 中 language toggle.
    static void RenderLangChip(App app, Canvas c, Theme t, int x, int y,
                               int w, int h, string label, bool active) {
        int bg = t.bgTertiary;
        int fg = t.textSecondary;
        if (active) { bg = t.primary; fg = t.textInverse; }
        c.FillRoundRect(x, y, w, h, app.Scale(4), bg);
        int tw = Canvas.MeasureText(label, t.fontSizeSmall);
        c.DrawText(x + (w - tw) / 2, y + app.Scale(3), label, fg, t.fontSizeSmall);
    }

    /// Keep the child-window widgets (Wizard / FilePicker draw in their own
    /// windows) on the same language as the gallery.
    static void SyncLang() {
        Wizard.lang = Gallery.lang.Get();
        FilePicker.lang = Gallery.lang.Get();
        Tabs.lang = Gallery.lang.Get();
    }

    /// A right-click on any tree row opens the demo's action menu at the row.
    static void TreeMenu() {
        Gallery.treeMenuOpen.Set(true);
        Gallery.treeMenuNode = Gallery.treeTv.ContextRow();
        Gallery.treeMenuX = Gallery.treeTv.ContextX();
        Gallery.treeMenuY = Gallery.treeTv.ContextY();
        Gallery.treeMenuSub.Set(0 - 1);
    }

    /// Seed tree for the TreeView demo: a small but multi-level project tree
    /// exercising nested directories, mixed file icons, expand/collapse and
    /// selection. Built once so toggles persist across frames.
    static List<TreeNode> BuildTree() {
        List<TreeNode> n = new List<TreeNode>();
        n.Add(TreeNode.Dir("src", 0, true));
        n.Add(TreeNode.Dir("compiler", 1, true));
        n.Add(TreeNode.FileIcon("lexer.c", 2, "file"));
        n.Add(TreeNode.FileIcon("parser.c", 2, "file"));
        n.Add(TreeNode.FileIcon("irgen.c", 2, "file"));
        n.Add(TreeNode.Dir("gui", 1, false));
        n.Add(TreeNode.FileIcon("App.zan", 2, "file"));
        n.Add(TreeNode.FileIcon("Canvas.zan", 2, "file"));
        n.Add(TreeNode.FileIcon("main.zan", 1, "file"));
        n.Add(TreeNode.Dir("tests", 0, false));
        n.Add(TreeNode.FileIcon("lexer_test.zan", 1, "file"));
        n.Add(TreeNode.FileIcon("parser_test.zan", 1, "file"));
        n.Add(TreeNode.FileIcon("README.md", 0, "file"));
        n.Add(TreeNode.FileIcon("build.ps1", 0, "file"));
        return n;
    }

    // ------------------------------------------------------------------
    // Layout
    // ------------------------------------------------------------------

    static void Render(App app) {
        Gallery.SyncLang();
        Canvas c = app.canvas;
        Theme t = app.theme;
        int top = app.titlebarH;
        int w = c.Width();
        int h = c.Height();
        Rect area = new Rect(0, top, w, h - top);
        // Themed backdrop (gradient/glass wallpaper or flat fill) is a built-in
        // window feature now, so every window renders skins identically.
        app.RenderBackground(area.x, area.y, area.width, area.height, 0);

        int sw = app.Scale(272);
        Rect content = new Rect(0, top, w, h - top);
        Gallery.RenderNav(app, c, t, content, sw);
        Gallery.RenderDetail(app, c, t, content, sw);
    }

    /// Left navigation: category headers interleaved with clickable component
    /// rows, wheel-scrollable, with the active row highlighted.
    static void RenderNav(App app, Canvas c, Theme t, Rect area, int sw) {
        c.FillRect(area.x, area.y, sw, area.height, t.bgSecondary);
        c.FillRect(area.x + sw - 1, area.y, 1, area.height, t.divider);

        int pad = app.Scale(14);
        c.DrawText(area.x + pad, area.y + app.Scale(20),
            Gallery.T("COMPONENTS", "组件"),
            t.textTertiary, t.fontSizeSmall);

        // EN / 中 language toggle, right-aligned in the header row.
        int lgW = app.Scale(34);
        int lgH = app.Scale(20);
        int lgY = area.y + app.Scale(15);
        int enX = area.x + sw - pad - lgW * 2 - app.Scale(2);
        int zhX = area.x + sw - pad - lgW;
        int curLang = Gallery.lang.Get();
        Gallery.RenderLangChip(app, c, t, enX, lgY, lgW, lgH, "EN", curLang == 0);
        Gallery.RenderLangChip(app, c, t, zhX, lgY, lgW, lgH, "中", curLang == 1);
        bool navClick = app.window.EventKind() == 3;
        if (navClick) {
            if (app.mouseX >= enX && app.mouseX < enX + lgW
                    && app.mouseY >= lgY && app.mouseY < lgY + lgH) {
                Gallery.SetLang(0); app.RequestRedraw();
            } else if (app.mouseX >= zhX && app.mouseX < zhX + lgW
                    && app.mouseY >= lgY && app.mouseY < lgY + lgH) {
                Gallery.SetLang(1); app.RequestRedraw();
            }
        }

        // Search box: filters components by name or category.
        int searchY = area.y + app.Scale(48);
        Gallery.navSearch.Render(app, area.x + pad, searchY,
            sw - pad * 2, app.Scale(30));
        string q = Gallery.navSearch.GetText();

        // Build display rows: category headers and component entries are typed
        // entities, so no sentinel index is needed.
        List<GalleryNavRow> rows = new List<GalleryNavRow>();
        string lastCat = "";
        for (int i = 0; i < Gallery.comps.Count; i = i + 1) {
            Comp e = Gallery.comps[i];
            bool match = q.Length == 0
                || Gallery.ContainsCI(e.name, q)
                || Gallery.ContainsCI(e.category, q);
            if (match) {
                if (e.category != lastCat) {
                    rows.Add(GalleryNavRow.Header(e.category));
                    lastCat = e.category;
                }
                rows.Add(GalleryNavRow.Component(i, e.name));
            }
        }

        int listTop = area.y + app.Scale(92);
        int listBottom = area.y + area.height - app.Scale(8);
        int rowH = app.Scale(26);
        int viewH = listBottom - listTop;
        int contentH = rows.Count * rowH;

        // The ScrollView owns wheel handling, clipping and the scrollbar; the
        // list just draws every row at its natural position minus the returned
        // offset and lets the container clip whatever falls outside.
        Rect view = new Rect(area.x, listTop, sw, viewH);
        int dy = Gallery.navView.Begin(app, view, contentH);

        int sel = Gallery.selected.Get();
        bool click = app.window.EventKind() == 3;
        int sx = area.x + pad;
        int swid = sw - pad * 2;
        for (int idx = 0; idx < rows.Count; idx = idx + 1) {
            int ry = listTop + idx * rowH - dy;
            if (ry + rowH > listTop && ry < listBottom) {
                GalleryNavRow row = rows[idx];
                if (row.header) {
                    c.DrawText(sx, ry + app.Scale(8), row.text,
                        t.textTertiary, t.fontSizeSmall);
                } else {
                    bool selRow = row.compIndex == sel;
                    bool hot = !app.PointerCaptured()
                        && app.mouseX >= area.x && app.mouseX < area.x + sw
                        && app.mouseY >= listTop && app.mouseY < listBottom
                        && app.mouseY >= ry && app.mouseY < ry + rowH;
                    if (selRow) {
                        c.FillRoundRect(sx - app.Scale(4), ry,
                            swid + app.Scale(8), rowH - app.Scale(2),
                            app.Scale(4), t.primary);
                    } else if (hot) {
                        c.FillRoundRect(sx - app.Scale(4), ry,
                            swid + app.Scale(8), rowH - app.Scale(2),
                            app.Scale(4), t.bgHover);
                    }
                    int tc = t.textPrimary;
                    if (selRow) { tc = t.textInverse; }
                    c.DrawText(sx + app.Scale(8), ry + app.Scale(5),
                        row.text, tc, t.fontSizeSmall);
                    if (click && hot) {
                        Gallery.selected.Set(row.compIndex);
                        Gallery.codeScroll.Set(0);
                        Gallery.detailView.ScrollTo(0);
                        Gallery.selHas = false;
                        Gallery.selDrag = false;
                        Gallery.apiSelKind = 0;
                        Gallery.apiSelDrag = false;
                        app.RequestRedraw();
                    }
                }
            }
        }

        Gallery.navView.End(app, view);
    }

    /// Effective demo cards for a component: its own list, or a single card
    /// synthesised from the legacy desc/code/json fields.
    static List<Demo> EffectiveDemos(Comp e) {
        if (e.demos.Count > 0) { return e.demos; }
        // Synthesise the single card once and retain it on the Comp. Building a
        // fresh Demo each frame would reset its per-card tab (and render cache)
        // every frame, so toggling Zan/JSON would never stick.
        e.demos.Add(new Demo("Basic usage", "", e.name,
            Gallery.PreviewHeight(e.name), e.code, e.json));
        return e.demos;
    }

    static int CardCodeH(App app, Theme t, Demo d, int tab) {
        string src = d.code;
        if (tab == 1) {
            if (d.json != "") { src = d.json; }
            else { src = "// x"; }
        }
        int lineH = Canvas.FontHeight(t.fontSizeSmall) + app.Scale(4);
        return app.Scale(28) + CodeEditor.SplitLines(src).Count * lineH
            + app.Scale(16);
    }

    static int DescBlockH(App app, Theme t, string desc, int cw) {
        if (desc == "") { return 0; }
        int lineH = Canvas.FontHeight(t.fontSizeSmall) + app.Scale(4);
        return Gallery.WrapText(desc, cw, t.fontSizeSmall).Count * lineH;
    }

    static int CardH(App app, Theme t, Demo d, int cw, int tab) {
        int h = app.Scale(22);
        int db = Gallery.DescBlockH(app, t, d.desc, cw);
        if (db > 0) { h = h + db + app.Scale(4); }
        h = h + app.Scale(10) + app.Scale(d.previewH) + app.Scale(12)
            + Gallery.CardCodeH(app, t, d, tab);
        return h;
    }

    static int TableH(App app, Theme t, List<ApiRow> rows) {
        if (rows.Count == 0) { return 0; }
        return app.Scale(30) + app.Scale(26) + rows.Count * app.Scale(24)
            + app.Scale(16);
    }

    /// Exact laid-out height of one demo card, matching the draw order in
    /// RenderDetail. Reads the wrap/highlight cache (call EnsureCache first),
    /// so it is cheap enough to run for every card each frame -- it lets the
    /// detail page cull off-screen cards instead of drawing then clipping them.
    static int DemoCardHeight(App app, Theme t, Demo d, int cw) {
        int lineH = Canvas.FontHeight(t.fontSizeSmall) + app.Scale(4);
        int h = app.Scale(22);
        if (d.desc != "") {
            h = h + d.cacheDescLines.Count * lineH + app.Scale(4);
        }
        h = h + app.Scale(10)
            + Gallery.PreviewBoxH(app, d.previewId, d.previewH, cw)
            + app.Scale(12);
        int panelH = app.Scale(28) + d.cacheDisplayLines.Count * lineH
            + app.Scale(16);
        h = h + panelH + app.Scale(26);
        return h;
    }

    /// Right detail pane: scrollable Naive-UI style page -- title, page
    /// description, a stack of demo cards (each with its own preview and
    /// Zan/JSON code), and Properties / Events API tables at the bottom.
    static void RenderDetail(App app, Canvas c, Theme t, Rect area, int sw) {
        int sel = Gallery.selected.Get();
        if (sel < 0 || sel >= Gallery.comps.Count) { return; }
        Comp e = Gallery.comps[sel];

        int cx = area.x + sw + app.Scale(28);
        int cw = area.x + area.width - app.Scale(28) - cx - app.Scale(14);
        if (cw < app.Scale(220)) { cw = app.Scale(220); }
        int contentTop = area.y + app.Scale(26);
        int viewBottom = area.y + area.height - app.Scale(8);
        int viewH = viewBottom - contentTop;
        Gallery.detailClipTop = contentTop;
        Gallery.detailClipBottom = viewBottom;
        List<Demo> demos = Gallery.EffectiveDemos(e);

        int bodyLineH = Canvas.FontHeight(t.fontSizeMedium) + app.Scale(4);
        List<string> pl = e.DescLines(cw, t.fontSizeMedium);

        // The whole page lives inside a ScrollView: that parent container owns
        // the wheel, the clip and the scrollbar and shows it automatically when
        // the content (measured last frame) overflows the viewport -- demos and
        // previews never handle scrolling themselves.
        int clipX = cx - app.Scale(12);
        Rect view = new Rect(clipX, contentTop,
            area.x + area.width - clipX, viewH);
        int scroll = Gallery.detailView.Begin(app, view,
            Gallery.detailContentH.Get());
        int yy = contentTop - scroll;

        c.DrawText(cx, yy, e.category, t.info, t.fontSizeSmall);
        yy = yy + app.Scale(20);
        c.DrawText(cx, yy, e.name, t.textPrimary, t.fontSizeLarge);
        yy = yy + app.Scale(30);
        c.FillRect(cx, yy, cw, 1, t.divider);
        yy = yy + app.Scale(16);
        for (int pi = 0; pi < pl.Count; pi = pi + 1) {
            c.DrawText(cx, yy, pl[pi], t.textSecondary, t.fontSizeMedium);
            yy = yy + bodyLineH;
        }
        yy = yy + app.Scale(14);

        int overlayPX = 0; int overlayPY = 0; int overlayPW = 0;
        bool haveOverlay = false;
        for (int dj = 0; dj < demos.Count; dj = dj + 1) {
            Demo d = demos[dj];
            d.EnsureCache(app, t, cw, d.tab);
            int cardTop = yy;
            int cardBottom = cardTop + Gallery.DemoCardHeight(app, t, d, cw);
            // Viewport culling: a card fully above/below the visible area still
            // costs one GDI text render + alpha blend per DrawText if drawn, so
            // skip its draws entirely and just advance past it. This keeps
            // scrolling cheap regardless of how many cards the page has.
            if (cardBottom >= contentTop && cardTop <= viewBottom) {
                c.DrawText(cx, yy, d.title, t.textPrimary, t.fontSizeMedium);
                yy = yy + app.Scale(22);
                if (d.desc != "") {
                    int dLineH = Canvas.FontHeight(t.fontSizeSmall) + app.Scale(4);
                    List<string> dl = d.cacheDescLines;
                    for (int ddi = 0; ddi < dl.Count; ddi = ddi + 1) {
                        c.DrawText(cx, yy, dl[ddi], t.textSecondary,
                            t.fontSizeSmall);
                        yy = yy + dLineH;
                    }
                    yy = yy + app.Scale(4);
                }
                yy = yy + app.Scale(10);
                int pvY = yy;
                Gallery.RenderPreview(app, c, t, d.previewId, cx, pvY, cw,
                    d.previewH);
                if (Gallery.IsOverlayComp(d.previewId)) {
                    overlayPX = cx; overlayPY = pvY; overlayPW = cw;
                    haveOverlay = true;
                }
                yy = yy + Gallery.PreviewBoxH(app, d.previewId, d.previewH, cw)
                    + app.Scale(12);
                Gallery.RenderCardCode(app, c, t, d, cx, yy, cw, d.tab);
            }
            yy = cardBottom;
        }

        int propsH = Gallery.TableH(app, t, e.props);
        if (propsH > 0 && yy + propsH >= contentTop && yy <= viewBottom) {
            Gallery.RenderApiTable(app, c, t, "Properties", e.props, true,
                cx, yy, cw);
        }
        yy = yy + propsH;
        int eventsH = Gallery.TableH(app, t, e.events);
        if (eventsH > 0 && yy + eventsH >= contentTop && yy <= viewBottom) {
            Gallery.RenderApiTable(app, c, t, "Events", e.events, false,
                cx, yy, cw);
        }
        yy = yy + eventsH;
        yy = yy + app.Scale(20);

        int contentH = yy - (contentTop - scroll);
        Gallery.detailView.End(app, view);

        int prevH = Gallery.detailContentH.Get();
        if (contentH != prevH) {
            Gallery.detailContentH.Set(contentH);
            app.RequestRedraw();
        }
        // A --scroll deep link can only be honoured once the page height is
        // known, since Begin() clamps to the previous frame's content height.
        if (Gallery.pendingScroll > 0 && contentH > 0) {
            Gallery.detailView.ScrollTo(Gallery.pendingScroll);
            Gallery.pendingScroll = 0;
            app.RequestRedraw();
        }

        if (haveOverlay) {
            Gallery.RenderOverlay(app, c, t, e.name, overlayPX, overlayPY,
                overlayPW);
        }
    }

    /// Case-insensitive substring test. The Zan string type has no reliable
    /// ToLower()/Contains(), so fold ASCII case manually (mirrors DataTable).
    static int FoldC(int cc) {
        if (cc >= 65 && cc <= 90) { return cc + 32; }
        return cc;
    }

    /// Decimal digits of `s` as an int (deep-link args only).
    static int ArgInt(string s) {
        int v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = (int)s[i];
            if (c < 48 || c > 57) { return v; }
            v = v * 10 + (c - 48);
        }
        return v;
    }

    static bool MatchAt(string hay, string needle, int off) {
        for (int j = 0; j < needle.Length; j = j + 1) {
            char ch = hay[off + j];
            char cn = needle[j];
            if (Gallery.FoldC((int)ch) != Gallery.FoldC((int)cn)) { return false; }
        }
        return true;
    }

    static bool ContainsCI(string hay, string needle) {
        int nl = needle.Length;
        int hl = hay.Length;
        if (nl == 0) { return true; }
        if (nl > hl) { return false; }
        for (int i = 0; i <= hl - nl; i = i + 1) {
            if (Gallery.MatchAt(hay, needle, i)) { return true; }
        }
        return false;
    }

    /// One API row as a tab-separated line (used for selection copy).
    static string ApiRowText(ApiRow r, bool isProps) {
        if (isProps) {
            return r.name + "\t" + r.type + "\t" + r.deflt + "\t" + r.desc;
        }
        return r.name + "\t" + r.type + "\t" + r.desc;
    }

    /// Bottom API table (Properties or Events). Returns the y below the table.
    /// Rows are drag-selectable and a Copy button yields the selected rows (or
    /// the whole table) as tab-separated text.
    static int RenderApiTable(App app, Canvas c, Theme t, string title,
            List<ApiRow> rows, bool isProps, int cx, int yy, int cw) {
        if (rows.Count == 0) { return yy; }
        int kind = 2;
        if (isProps) { kind = 1; }
        int fh = t.fontSizeSmall;
        c.DrawText(cx, yy, title, t.textPrimary, t.fontSizeMedium);

        // Copy button on the title row (right-aligned) — a real Button, one
        // retained instance per table kind so both tables keep their own state.
        Button cpBtn = Gallery.apiCopyProps;
        if (!isProps) { cpBtn = Gallery.apiCopyEvents; }
        cpBtn.Text = Gallery.T("Copy", "复制");
        int cpH = app.Scale(20);
        cpBtn.MeasureTree(app);
        int cpW = cpBtn.prefW;
        int cpMin = app.Scale(62);
        if (cpW < cpMin) { cpW = cpMin; }
        int cpX = cx + cw - cpW;
        int cpY = yy - app.Scale(2);
        cpBtn.Arrange(cpX, cpY, cpW, cpH);
        cpBtn.RenderTree(app);
        bool cpHot = !app.PointerCaptured()
            && app.mouseX >= cpX && app.mouseX < cpX + cpW
            && app.mouseY >= cpY && app.mouseY < cpY + cpH;

        yy = yy + app.Scale(30);
        int nameX = cx + app.Scale(6);
        int col1 = cx + cw * 24 / 100;
        int col2 = cx + cw * 44 / 100;
        int descX = cx + cw * 62 / 100;
        if (!isProps) { descX = cx + cw * 44 / 100; }
        c.FillRect(cx, yy, cw, app.Scale(26), t.bgSecondary);
        c.DrawText(nameX, yy + app.Scale(6), Gallery.T("Name", "名称"),
            t.textTertiary, fh);
        if (isProps) {
            c.DrawText(col1 + app.Scale(6), yy + app.Scale(6),
                Gallery.T("Type", "类型"), t.textTertiary, fh);
            c.DrawText(col2 + app.Scale(6), yy + app.Scale(6),
                Gallery.T("Default", "默认值"), t.textTertiary, fh);
        } else {
            c.DrawText(col1 + app.Scale(6), yy + app.Scale(6),
                Gallery.T("Signature", "签名"), t.textTertiary, fh);
        }
        c.DrawText(descX + app.Scale(6), yy + app.Scale(6),
            Gallery.T("Description", "说明"), t.textTertiary, fh);
        yy = yy + app.Scale(26);
        int rowH = app.Scale(24);
        int bodyTop = yy;

        // Drag selection over the row body (row-granular).
        int bodyBottom = bodyTop + rows.Count * rowH;
        int ek = app.window.EventKind();
        bool inBody = !app.PointerCaptured()
            && app.mouseX >= cx && app.mouseX < cx + cw
            && app.mouseY >= bodyTop && app.mouseY < bodyBottom;
        if (ek == 2 && inBody) {
            int hitRow = (app.mouseY - bodyTop) / rowH;
            if (hitRow < 0) { hitRow = 0; }
            if (hitRow >= rows.Count) { hitRow = rows.Count - 1; }
            Gallery.apiSelKind = kind;
            Gallery.apiSelA = hitRow;
            Gallery.apiSelB = hitRow;
            Gallery.apiSelDrag = true;
            app.RequestRedraw();
        } else if (ek == 1 && Gallery.apiSelDrag && Gallery.apiSelKind == kind) {
            int hitRow = (app.mouseY - bodyTop) / rowH;
            if (hitRow < 0) { hitRow = 0; }
            if (hitRow >= rows.Count) { hitRow = rows.Count - 1; }
            Gallery.apiSelB = hitRow;
            app.RequestRedraw();
        } else if (ek == 3 && Gallery.apiSelDrag) {
            Gallery.apiSelDrag = false;
            app.RequestRedraw();
        }

        int selLo = Gallery.apiSelA;
        int selHi = Gallery.apiSelB;
        if (selHi < selLo) { selLo = Gallery.apiSelB; selHi = Gallery.apiSelA; }
        bool hasSel = Gallery.apiSelKind == kind;

        for (int ri = 0; ri < rows.Count; ri = ri + 1) {
            ApiRow r = rows[ri];
            if (hasSel && ri >= selLo && ri <= selHi) {
                c.FillRect(cx, yy, cw, rowH, 0x553B82F6);
            } else if (ri % 2 == 1) {
                c.FillRect(cx, yy, cw, rowH, t.bgSecondary);
            }
            // 每列截断在自己的列宽内——子元素不越出父容器边界；
            // 完整文本仍可通过 Copy 按钮取得（ApiRowText 用原串）。
            int typeRight = descX;
            if (isProps) { typeRight = col2; }
            c.DrawText(nameX, yy + app.Scale(5),
                Ellipsis.Fit(r.name, col1 - nameX - app.Scale(10), fh),
                t.textPrimary, fh);
            c.DrawText(col1 + app.Scale(6), yy + app.Scale(5),
                Ellipsis.Fit(r.type, typeRight - col1 - app.Scale(12), fh),
                t.info, fh);
            if (isProps) {
                c.DrawText(col2 + app.Scale(6), yy + app.Scale(5),
                    Ellipsis.Fit(r.deflt, descX - col2 - app.Scale(12), fh),
                    t.textSecondary, fh);
            }
            c.DrawText(descX + app.Scale(6), yy + app.Scale(5),
                Ellipsis.Fit(r.desc, cx + cw - descX - app.Scale(10), fh),
                t.textSecondary, fh);
            yy = yy + rowH;
        }

        // Copy: selected rows for this table, else the whole table.
        if (app.window.EventKind() == 3 && cpHot) {
            int from = 0;
            int to = rows.Count - 1;
            if (hasSel) { from = selLo; to = selHi; }
            string outp = "";
            int k = from;
            while (k <= to) {
                if (k > from) { outp = outp + "\n"; }
                outp = outp + Gallery.ApiRowText(rows[k], isProps);
                k = k + 1;
            }
            Clipboard.SetText(outp);
            Gallery.apiCopiedFrame = 8;
            app.RequestRedraw();
        }

        return yy + app.Scale(16);
    }

    /// Per-card code panel: Zan / JSON tabs, a Copy button (copies the active
    /// tab), line-number gutter and syntax highlighting. Sized to fit all lines
    /// (the whole page scrolls, so the panel never needs its own scrollbar).
    static int RenderCardCode(App app, Canvas c, Theme t, Demo d,
            int cx, int cy, int cw, int tab) {
        d.EnsureCache(app, t, cw, tab);
        string src = d.cacheSrc;
        List<CodeDisplayLine> displayLines = d.cacheDisplayLines;
        int fs = t.fontSizeSmall;
        int codeLineH = Canvas.FontHeight(fs) + app.Scale(4);
        int hdrH = app.Scale(28);
        int panelH = hdrH + displayLines.Count * codeLineH + app.Scale(16);
        c.FillRoundRect(cx, cy, cw, panelH, app.Scale(6), t.bgSecondary);
        c.DrawRect(cx, cy, cw, panelH, t.borderPrimary, 1);
        c.FillRect(cx, cy + hdrH, cw, 1, t.divider);

        int gutterW = d.cacheGutterW;
        int textX = cx + gutterW + app.Scale(8);
        int codeY0 = cy + hdrH + app.Scale(8);
        c.FillRect(cx + 1, cy + hdrH + 1, gutterW, panelH - hdrH - 2, t.bgTertiary);

        int tabY = cy + app.Scale(4);
        int tabH = app.Scale(20);
        int t0W = app.Scale(46);
        int t1W = app.Scale(52);
        int t0X = cx + app.Scale(8);
        int t1X = t0X + t0W + app.Scale(4);
        Gallery.DrawCodeTab(app, c, t, "Zan", t0X, tabY, t0W, tabH, tab == 0);
        Gallery.DrawCodeTab(app, c, t, "JSON", t1X, tabY, t1W, tabH, tab == 1);
        if (app.window.EventKind() == 3 && !app.PointerCaptured()) {
            if (app.mouseX >= t0X && app.mouseX < t0X + t0W
                && app.mouseY >= tabY && app.mouseY < tabY + tabH) {
                d.tab = 0; app.RequestRedraw();
            } else if (app.mouseX >= t1X && app.mouseX < t1X + t1W
                && app.mouseY >= tabY && app.mouseY < tabY + tabH) {
                d.tab = 1; app.RequestRedraw();
            }
        }

        // Copy is a real Button control (retained on the card), laid out in the
        // panel header instead of a hand-drawn pill.
        int cpH = app.Scale(20);
        d.copyBtn.MeasureTree(app);
        int cpW = d.copyBtn.prefW;
        int cpMin = app.Scale(62);
        if (cpW < cpMin) { cpW = cpMin; }
        int cpX = cx + cw - cpW - app.Scale(8);
        int cpY = cy + (hdrH - cpH) / 2;
        d.copyBtn.Arrange(cpX, cpY, cpW, cpH);
        d.copyBtn.RenderTree(app);
        bool cpHot = !app.PointerCaptured()
            && app.mouseX >= cpX && app.mouseX < cpX + cpW
            && app.mouseY >= cpY && app.mouseY < cpY + cpH;
        // This code box owns the selection only if its uid+tab match.
        bool selMine = Gallery.selOwner == d.uid && Gallery.selTab == tab;
        if (app.window.EventKind() == 3 && cpHot) {
            // Copy the current selection when there is one, else the whole snippet.
            string toCopy = src;
            if (selMine && Gallery.SelNonEmpty()) { toCopy = Gallery.SelectedText(displayLines); }
            Clipboard.SetText(toCopy);
            app.RequestRedraw();
        }

        // Drag to select text in the code body: press sets the anchor, moving
        // with the button held extends the selection, release finalises it.
        int textTop = codeY0;
        int textBottom = codeY0 + displayLines.Count * codeLineH;
        int ek = app.window.EventKind();
        bool inCode = !app.PointerCaptured()
            && app.mouseX >= cx && app.mouseX < cx + cw
            && app.mouseY >= textTop && app.mouseY < textBottom;
        if (ek == 2 && inCode) {
            int ll = Gallery.HitLine(displayLines, 0, app.mouseY, codeY0, codeLineH);
            int cc = Gallery.ColAt(displayLines[ll].text, fs, app.mouseX - textX);
            Gallery.selAL = ll; Gallery.selAC = cc;
            Gallery.selFL = ll; Gallery.selFC = cc;
            Gallery.selDrag = true;
            Gallery.selOwner = d.uid; Gallery.selTab = tab;
            selMine = true;
            app.RequestRedraw();
        } else if (ek == 1 && Gallery.selDrag && selMine) {
            int ll = Gallery.HitLine(displayLines, 0, app.mouseY, codeY0, codeLineH);
            int cc = Gallery.ColAt(displayLines[ll].text, fs, app.mouseX - textX);
            Gallery.selFL = ll; Gallery.selFC = cc;
            app.RequestRedraw();
        } else if (ek == 3 && Gallery.selDrag && selMine) {
            Gallery.selDrag = false;
            app.RequestRedraw();
        }

        // Normalised selection bounds (start <= end) for the highlight pass.
        // Only the owning box (matching uid+tab) paints the highlight.
        bool showSel = selMine && Gallery.SelNonEmpty();
        int nl0 = Gallery.selAL; int nc0 = Gallery.selAC;
        int nl1 = Gallery.selFL; int nc1 = Gallery.selFC;
        if (nl1 < nl0 || (nl1 == nl0 && nc1 < nc0)) {
            nl0 = Gallery.selFL; nc0 = Gallery.selFC;
            nl1 = Gallery.selAL; nc1 = Gallery.selAC;
        }

        int codeY = codeY0;
        for (int ci = 0; ci < displayLines.Count; ci = ci + 1) {
            CodeDisplayLine displayLine = displayLines[ci];
            // Selection highlight behind this line's text.
            if (showSel && ci >= nl0 && ci <= nl1) {
                int lineLen = displayLine.text.Length;
                int sc = 0;
                if (ci == nl0) { sc = nc0; }
                int ec = lineLen;
                if (ci == nl1) { ec = nc1; }
                if (sc < 0) { sc = 0; }
                if (sc > lineLen) { sc = lineLen; }
                if (ec > lineLen) { ec = lineLen; }
                if (ec < sc) { ec = sc; }
                int hx0 = textX + Canvas.MeasureText(displayLine.text.Substring(0, sc), fs);
                int hx1 = textX + Canvas.MeasureText(displayLine.text.Substring(0, ec), fs);
                if (hx1 < hx0 + app.Scale(2)) { hx1 = hx0 + app.Scale(4); }
                c.FillRect(hx0, codeY - app.Scale(1), hx1 - hx0,
                    codeLineH, 0x553B82F6);
            }
            int lno = displayLine.lineNo;
            if (lno > 0) {
                string lnoS = Convert.ToString(lno);
                int lnoW = Canvas.MeasureText(lnoS, fs);
                c.DrawText(cx + gutterW - lnoW - app.Scale(6), codeY,
                    lnoS, t.textTertiary, fs);
            }
            int sx = textX;
            for (int si = 0; si < displayLine.spans.Count; si = si + 1) {
                CodeSpan span = displayLine.spans[si];
                c.DrawText(sx, codeY, span.text, span.color, fs);
                sx = sx + Canvas.MeasureText(span.text, fs);
            }
            codeY = codeY + codeLineH;
        }
        return panelH;
    }

    /// A small pill tab in the code panel header (Zan / JSON switch).
    static void DrawCodeTab(App app, Canvas c, Theme t, string label,
            int x, int y, int w, int h, bool active) {
        bool hot = !app.PointerCaptured()
            && app.mouseX >= x && app.mouseX < x + w
            && app.mouseY >= y && app.mouseY < y + h;
        int bg = (int)0xFF2D2D30;
        int fg = t.textTertiary;
        if (active) { bg = (int)0xFF0E639C; fg = (int)0xFFFFFFFF; }
        else if (hot) { bg = (int)0xFF3E3E42; fg = (int)0xFFFFFFFF; }
        c.FillRoundRect(x, y, w, h, app.Scale(3), bg);
        int tw = Canvas.MeasureText(label, t.fontSizeSmall);
        c.DrawText(x + (w - tw) / 2,
            y + (h - Canvas.FontHeight(t.fontSizeSmall)) / 2, label,
            fg, t.fontSizeSmall);
    }

    /// Maps a mouse y to a code line index (clamped to the snippet).
    static int HitLine(List<CodeDisplayLine> lines, int scroll, int my,
            int codeY0, int lineH) {
        int hl = scroll + (my - codeY0) / lineH;
        if (hl < 0) { hl = 0; }
        if (hl >= lines.Count) { hl = lines.Count - 1; }
        return hl;
    }

    /// Maps a horizontal offset (px, relative to the text origin) to a caret
    /// column inside `line`, snapping to the nearer character boundary.
    static int ColAt(string line, int fs, int localX) {
        if (localX <= 0) { return 0; }
        int n = line.Length;
        int prevW = 0;
        for (int col = 0; col < n; col = col + 1) {
            int w = Canvas.MeasureText(line.Substring(0, col + 1), fs);
            if (localX < (prevW + w) / 2) { return col; }
            prevW = w;
        }
        return n;
    }

    /// True when the current selection spans at least one character.
    static bool SelNonEmpty() {
        if (Gallery.selAL != Gallery.selFL) { return true; }
        return Gallery.selAC != Gallery.selFC;
    }

    /// Extracts the selected substring from the cached display lines.
    static string SelectedText(List<CodeDisplayLine> lines) {
        int sL = Gallery.selAL; int sC = Gallery.selAC;
        int eL = Gallery.selFL; int eC = Gallery.selFC;
        if (sL > eL || (sL == eL && sC > eC)) {
            sL = Gallery.selFL; sC = Gallery.selFC;
            eL = Gallery.selAL; eC = Gallery.selAC;
        }
        if (sL < 0) { sL = 0; }
        if (eL >= lines.Count) { eL = lines.Count - 1; }
        if (sL == eL) {
            string only = lines[sL].text;
            if (sC < 0) { sC = 0; }
            if (eC > only.Length) { eC = only.Length; }
            return only.Substring(sC, eC - sC);
        }
        string first = lines[sL].text;
        if (sC < 0) { sC = 0; }
        string res = first.Substring(sC, first.Length - sC);
        int i = sL + 1;
        while (i < eL) {
            res = res + "\n" + lines[i].text;
            i = i + 1;
        }
        string last = lines[eL].text;
        if (eC > last.Length) { eC = last.Length; }
        res = res + "\n" + last.Substring(0, eC);
        return res;
    }

    // ------------------------------------------------------------------
    // Live previews (real widget states for the selected component)
    // ------------------------------------------------------------------

    /// Preview box height (unscaled) for a component: complex widgets that
    /// need more vertical room get a taller box so they aren't clipped.
    static void StateSwatch(App app, int x, int y, int w, int h, string label,
            bool hov, bool pr, bool sel, bool dis) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        c.FillRoundRect(x, y, w, h, t.borderRadiusMedium,
            States.Bg(app, hov, pr, sel, dis));
        c.DrawRect(x, y, w, h, States.Border(app, hov, pr, false, dis), 1);
        if (sel) { c.FillRect(x, y, app.Scale(3), h, States.Accent(app)); }
        c.DrawTextCentered(x, y, w, h, label, States.Text(app, sel, dis), t.fontSizeSmall);
    }

    /// One Ellipsis demo row: a fixed-width guide box with the text truncated to
    /// fit, plus the pixel width label to its right.
    static void EllipsisRow(App app, int x, int y, int w, string text) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        c.DrawRect(x, y - app.Scale(2), w, app.Scale(24), t.borderSecondary, 1);
        Ellipsis.Render(app, x + app.Scale(5), y + app.Scale(3), w - app.Scale(10), text);
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary", Style.SNormal()),
            x + w + app.Scale(10), y + app.Scale(3), Convert.ToString(w) + "px",
            app.theme.textPrimary, app.theme.fontSizeMedium);
    }

    /// Synthesise a pseudo-random waveform for the ChartBig big-data demos:
    /// two detuned sines plus a small per-sample jitter, so 10k / 100k point
    /// traces look like real dense telemetry rather than a bare sinusoid.
    static List<int> BigWave(int n, int seed, int baseV, int amp) {
        List<int> v = new List<int>();
        for (int i = 0; i < n; i = i + 1) {
            int w = ChartView.SinDeg((i * 5 + seed * 3) % 360) * amp / 1000
                  + ChartView.SinDeg((i * 17 + seed) % 360) * amp / 2000
                  + (i * 7 + seed * 11) % 47;
            v.Add(baseV + w);
        }
        return v;
    }

    static int PreviewHeight(string name) {
        // Every preview box is at least 300px tall so interactive demos have
        // room to breathe; taller components opt into more.
        if (name == "Button") { return 470; }
        if (name == "Icon") { return 360; }
        if (name == "States") { return 300; }
        if (name == "Tabs") { return 400; }
        if (name == "TextArea") { return 300; }
        if (name == "SelectBox") { return 300; }
        if (name == "VirtualList") { return 300; }
        if (name == "ClickEvent") { return 300; }
        if (name == "DataTable 1M") { return 430; }
        if (name == "DataTable") { return 320; }
        if (name == "PivotTable") { return 300; }
        if (name == "Chart") { return 320; }
        if (name == "Alert") { return 360; }
        if (name == "Ellipsis") { return 300; }
        if (name == "Timeline") { return 300; }
        if (name == "TreeView") { return 300; }
        if (name == "Collapse") { return 300; }
        if (name == "Table") { return 300; }
        if (name == "ListView") { return 340; }
        if (name == "Carousel") { return 300; }
        if (name == "Layer") { return 360; }
        if (name == "Menu") { return 300; }
        if (name == "Steps") { return 420; }
        if (name == "Tooltip") { return 500; }
        if (name == "Pagination") { return 350; }
        if (name == "Scrollbar") { return 300; }
        if (name == "FloatButton") { return 300; }
        if (name == "FilePicker") { return 300; }
        if (name == "Ribbon") { return 300; }
        if (name == "Wizard") { return 320; }
        if (name == "Split") { return 320; }
        if (name == "Result") { return 300; }
        if (name == "Tag") { return 300; }
        if (name == "Progress") { return 300; }
        if (name == "Compose") { return 300; }
        if (name == "Card") { return 420; }
        if (name == "Designer") { return 860; }
        return 300;
    }

    /// Scaled (device-px) height of a demo's preview box for a given card width.
    /// Most previews are a fixed design height, but content that wraps to a
    /// width-dependent number of rows (the Icon gallery grid) must grow taller
    /// as the window narrows, otherwise its lower rows spill past the fixed box
    /// and get clipped. Callers use this for both layout and the drawn frame so
    /// the box, the card height and the grid always agree.
    static int PreviewBoxH(App app, string name, int previewHUnscaled, int w) {
        if (name == "Icon") {
            int cell = app.Scale(62);
            int gcols = (w - app.Scale(24)) / cell;
            if (gcols < 1) { gcols = 1; }
            int n = Icon.Names().Count;
            int rows = (n + gcols - 1) / gcols;
            if (rows < 1) { rows = 1; }
            return app.Scale(34) + rows * cell + app.Scale(12);
        }
        if (name == "Chart.dashboard" && w < app.Scale(560)) {
            return app.Scale(834);
        }
        return app.Scale(previewHUnscaled);
    }

    /// Lays out and paints a retained-mode subtree inside a rect -- the same
    /// three calls a Form makes for the whole window, scoped to the preview box.
    /// The demos use this so their preview is the retained tree the snippet
    /// builds (no hand-placed x/y), matching what an app developer would copy.
    static void LayoutIn(App app, Control root, int x, int y, int w, int h) {
        root.MeasureTree(app);
        root.Arrange(x, y, w, h);
        root.RenderTree(app);
    }

    static int RenderPreview(App app, Canvas c, Theme t, string name,
            int x, int y, int w, int previewHUnscaled) {
        int h = Gallery.PreviewBoxH(app, name, previewHUnscaled, w);
        if (t.glass != 0) {
            // Real frosted glass: blur the wallpaper behind the box (clamped to
            // the scroll viewport so it never smears the fixed header), then a
            // light translucent tint + white frost veil + top sheen + rim.
            int by = y;
            int bh = h;
            if (by < Gallery.detailClipTop) {
                bh = bh - (Gallery.detailClipTop - by);
                by = Gallery.detailClipTop;
            }
            if (by + bh > Gallery.detailClipBottom) {
                bh = Gallery.detailClipBottom - by;
            }
            if (bh > 0) {
                c.BlurRectCached(x, by, w, bh, app.Scale(22),
                    app.NextBlurSlot(), app.BackdropDirty());
            }
            c.FillRoundRect(x, y, w, h, app.Scale(6), Style.Fade(t.bgSecondary, 300));
            c.FillRoundRect(x, y, w, h, app.Scale(6), Style.Fade(t.textPrimary, 40));
            c.FillRoundRect(x, y, w, app.Scale(2), app.Scale(6),
                            Style.Fade(t.textPrimary, 140));
            c.DrawRect(x, y, w, h, Style.Fade(t.textPrimary, 85), 1);
        } else {
            c.FillRoundRect(x, y, w, h, app.Scale(6), t.bgSecondary);
            c.DrawRect(x, y, w, h, t.borderPrimary, 1);
        }
        c.DrawText(x + app.Scale(12), y + app.Scale(9), "LIVE STATES",
            t.textTertiary, t.fontSizeSmall);
        // Floating/interactive components are drawn later in the deferred
        // overlay pass (above the code panel); the base pass only frames them.
        if (Gallery.IsOverlayComp(name)) { return h; }
        // Clip every base demo to the preview box so nothing bleeds into the
        // title, description or the code panel below (fixes the overflow and
        // scroll "see-through" artifacts).
        c.PushClip(x, y, w, h);
        int px = x + app.Scale(18);
        int py = y + app.Scale(48);
        bool rendered = true;
        if (name == "Button.types") {
            Panel row = Panel.Row().Gap(app.Scale(10));
            row.With(new Button { Text = "Default" });
            row.With(new Button { Text = "Primary", Class = "primary" });
            row.With(new Button { Text = "Info", Class = "info" });
            row.With(new Button { Text = "Success", Class = "success" });
            row.With(new Button { Text = "Warning", Class = "warning" });
            row.With(new Button { Text = "Error", Class = "error" });
            Gallery.LayoutIn(app, row, px, y + app.Scale(34), w - app.Scale(36), app.Scale(34));
        } else if (name == "Button.styles") {
            Panel row = Panel.Row().Gap(app.Scale(10));
            row.With(new Button { Text = "Solid", Class = "primary" });
            row.With(new Button { Text = "Outline", Class = "primary outline" });
            row.With(new Button { Text = "Text", Class = "primary text" });
            row.With(new Button { Text = "Dashed", Class = "primary dashed" });
            row.With(new Button { Text = "Secondary", Class = "primary secondary" });
            row.With(new Button { Text = "Ghost", Class = "primary ghost" });
            Gallery.LayoutIn(app, row, px, y + app.Scale(34), w - app.Scale(36), app.Scale(34));
        } else if (name == "Button.specular") {
            Panel row = Panel.Row().Gap(app.Scale(10));
            row.With(new Button { Text = "Hover me", Class = "primary specular" });
            row.With(new Button { Text = "Success", Class = "success specular" });
            row.With(new Button { Text = "Error", Class = "error specular" });
            row.With(new Button { Text = "Default", Class = "specular" });
            Gallery.LayoutIn(app, row, px, y + app.Scale(34), w - app.Scale(36), app.Scale(34));
        } else if (name == "Button.secondary") {
            Panel row = Panel.Row().Gap(app.Scale(10));
            row.With(new Button { Text = "Default", Class = "secondary" });
            row.With(new Button { Text = "Primary", Class = "primary secondary" });
            row.With(new Button { Text = "Info", Class = "info secondary" });
            row.With(new Button { Text = "Success", Class = "success secondary" });
            row.With(new Button { Text = "Warning", Class = "warning secondary" });
            row.With(new Button { Text = "Error", Class = "error secondary" });
            Gallery.LayoutIn(app, row, px, y + app.Scale(34), w - app.Scale(36), app.Scale(34));
        } else if (name == "Button.states") {
            Panel row = Panel.Row().Gap(app.Scale(10));
            row.With(new Button { Text = "Loading", Class = "primary loading" });
            Button bldg = new Button { Class = "success loading" };
            bldg.Class = bldg.Class + " circle";
            row.With(bldg);
            Button bdis = new Button { Text = "Disabled" };
            bdis.Disabled = true;
            row.With(bdis);
            row.With(new Button { Text = "Pink", Class = "pink" });
            row.With(new Button { Text = "Teal", Class = "teal" });
            Gallery.LayoutIn(app, row, px, y + app.Scale(34), w - app.Scale(36), app.Scale(34));
        } else if (name == "Button.shapes") {
            Panel row = Panel.Row().Gap(app.Scale(10));
            row.With(new Button { Text = "Round", Class = "primary round" });
            row.With(new Button { Text = "Save", Icon = "save", Class = "success" });
            row.With(new Button { Icon = "plus", Class = "primary circle" });
            row.With(new Button { Icon = "settings", Class = "circle" });
            Gallery.LayoutIn(app, row, px, y + app.Scale(34), w - app.Scale(36), app.Scale(34));
        } else if (name == "Button.sizes") {
            Panel row = Panel.Row().Gap(app.Scale(10));
            row.With(new Button { Text = "Tiny", Class = "tiny" });
            row.With(new Button { Text = "Small", Class = "small" });
            row.With(new Button { Text = "Medium", Class = "medium" });
            row.With(new Button { Text = "Large", Class = "large" });
            Gallery.LayoutIn(app, row, px, y + app.Scale(34), w - app.Scale(36), app.Scale(40));
        } else if (name == "Button.group") {
            int cur = y + app.Scale(34);
            ButtonGroup g1 = new ButtonGroup(1);
            g1.Add("Left"); g1.Add("Middle"); g1.Add("Right");
            g1.Render(app, px, cur);
            ButtonGroup g2 = new ButtonGroup(2).Outline(true);
            g2.Add("Day"); g2.Add("Week"); g2.Add("Month"); g2.Add("Year");
            g2.Render(app, px + app.Scale(240), cur);
        } else if (name == "Icon") {
            List<string> icons = Icon.Names();
            int cell = app.Scale(62);
            int iconSz = app.Scale(22);
            int gcols = (w - app.Scale(24)) / cell;
            if (gcols < 1) { gcols = 1; }
            bool iconClick = app.window.EventKind() == 3;
            int gx0 = x + app.Scale(12);
            int gy0 = y + app.Scale(34);
            for (int gi = 0; gi < icons.Count; gi = gi + 1) {
                int gr = gi / gcols;
                int gc = gi % gcols;
                int gx = gx0 + gc * cell;
                int gy = gy0 + gr * cell;
                bool hot = !app.PointerCaptured()
                    && app.mouseX >= gx && app.mouseX < gx + cell
                    && app.mouseY >= gy && app.mouseY < gy + cell;
                if (hot) {
                    c.FillRoundRect(gx, gy, cell - app.Scale(4), cell - app.Scale(4),
                        app.Scale(4), t.bgHover);
                }
                c.DrawGlyphIn(icons[gi], gx, gy + app.Scale(6),
                    cell - app.Scale(4), iconSz, iconSz, t.textPrimary);
                c.DrawTextCentered(gx, gy + iconSz + app.Scale(12), cell - app.Scale(4),
                    Canvas.FontHeight(t.fontSizeSmall),
                    Ellipsis.Fit(icons[gi], cell - app.Scale(6), t.fontSizeSmall),
                    t.textTertiary, t.fontSizeSmall);
                if (hot && iconClick) {
                    Clipboard.SetText("c.DrawGlyph(\"" + icons[gi] + "\", x, y, 24, color);");
                    Gallery.copiedIcon = icons[gi];
                    app.RequestRedraw();
                }
            }
            if (Gallery.copiedIcon != "") {
                c.DrawText(x + app.Scale(110), y + app.Scale(9),
                    "copied  c.DrawGlyph(\"" + Gallery.copiedIcon + "\", ...)",
                    t.success, t.fontSizeSmall);
            }
        } else if (name == "Label") {
            Panel col = Panel.Column().Gap(app.Scale(10));
            col.With(new Label { Text = "Title", Class = "title" });
            col.With(new Label { Text = "Default label" });
            col.With(new Label { Text = "Secondary", Class = "secondary" });
            col.With(new Label { Text = "Hint / muted caption text", Class = "hint" });
            Gallery.LayoutIn(app, col, px, py - app.Scale(16),
                             w - app.Scale(36), app.Scale(140));
        } else if (name == "Typography") {
            // A full heading scale + a paragraph: showing h1..h4 and body copy
            // lets the reader see the whole font ramp at once.
            Panel col = Panel.Column().Gap(app.Scale(4));
            col.With(Typography.H("h1 · Display / page title", 1));
            col.With(Typography.H("h2 · Section heading", 2));
            col.With(Typography.H("h3 · Subsection heading", 3));
            col.With(Typography.H("h4 · Group / card title", 4));
            col.With(Typography.P("Body paragraph — readable text for application content. Long lines wrap naturally and the size paces long-form reading."));
            col.With(new Label { Text = "Hint / muted caption text", Class = "hint" });
            Gallery.LayoutIn(app, col, px, py - app.Scale(24),
                             w - app.Scale(36), app.Scale(260));
        } else if (name == "Input") {
            // A labelled input: the row lays the hint beside the field.
            Panel row = Panel.Row().Gap(app.Scale(10));
            row.With(new Label { Text = "Your name" });
            row.With(Gallery.demoInput);
            Gallery.LayoutIn(app, row, px, py - app.Scale(8),
                             w - app.Scale(36), t.heightMedium);
        } else if (name == "TextArea") {
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(new Label { Text = "Description", Class = "secondary" });
            col.With(Gallery.demoArea);
            Gallery.LayoutIn(app, col, px, py - app.Scale(20),
                             w - app.Scale(36), app.Scale(180));
        } else if (name == "Checkbox") {
            // Sizes + semantic accents, laid out by Panel flow (no coordinates).
            // EVERY checkbox is bound to its own model field via `.data` so
            // each one toggles independently.
            Checkbox cbS = new Checkbox("Small");
            cbS.Class = "small";
            cbS.data = Gallery.model.cbSmall;
            Checkbox cbM = new Checkbox("Default");
            cbM.data = Gallery.model.cbDefault;
            Checkbox cbL = new Checkbox("Large");
            cbL.Class = "large";
            cbL.data = Gallery.model.cbLarge;
            Checkbox ck = new Checkbox("Primary");
            ck.Class = "primary";
            ck.data = Gallery.model.cbPrimary;
            Checkbox ck2 = new Checkbox("Success");
            ck2.Class = "success";
            ck2.data = Gallery.model.cbSuccess;
            Checkbox ck3 = new Checkbox("Warning");
            ck3.Class = "warning";
            ck3.data = Gallery.model.cbWarning;
            Panel col = Panel.Column().Gap(app.Scale(12));
            col.With(Panel.Row().Gap(app.Scale(24)).With(cbS).With(cbM).With(cbL));
            col.With(Panel.Row().Gap(app.Scale(24)).With(ck).With(ck2).With(ck3));
            Gallery.LayoutIn(app, col, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(120));
        } else if (name == "Radio") {
            // A radio GROUP = every option shares one two-way data binding;
            // clicking any option writes the group value to the model field.
            Radio ra = new Radio(0, "Option A");
            ra.data = Gallery.model.level;
            Radio rb = new Radio(1, "Option B");
            rb.data = Gallery.model.level;
            // A large, success-styled second group on its OWN model value --
            // an independent group must not share `level` with the first one.
            Radio gl = new Radio(0, "Large");
            gl.Class = "large";
            gl.data = Gallery.model.radioGroup2;
            Radio gs = new Radio(1, "Large");
            gs.Class = "large success";
            gs.data = Gallery.model.radioGroup2;
            Panel col = Panel.Column().Gap(app.Scale(14));
            col.With(Panel.Row().Gap(app.Scale(24)).With(ra).With(rb));
            col.With(Panel.Row().Gap(app.Scale(24)).With(gl).With(gs));
            Gallery.LayoutIn(app, col, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(120));
        } else if (name == "Switch") {
            Panel row = Panel.Row().Gap(app.Scale(12));
            row.With(Gallery.demoSwitch);
            row.With(new Label { Text = "Interactive state" });
            Gallery.LayoutIn(app, row, px, py - app.Scale(8),
                             w - app.Scale(36), app.Scale(40));
        } else if (name == "Slider") {
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(new Label { Text = "Level: " + Convert.ToString(Gallery.model.level), Class = "secondary" });
            col.With(Gallery.demoSlider);
            Gallery.LayoutIn(app, col, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(70));
        } else if (name == "Rate") {
            Panel col = Panel.Column().Gap(app.Scale(8));
            col.With(new Label { Text = "Rate · " + Convert.ToString(Gallery.model.level), Class = "secondary" });
            col.With(Gallery.demoRate);
            Gallery.LayoutIn(app, col, px, py - app.Scale(8),
                             w - app.Scale(36), app.Scale(70));
        } else if (name == "Tabs") {
            // Retained Tabs component: header strip + a
            // separately drawn page area. Multiple styles, sizes, orientations.
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py - app.Scale(24), "Line · underline",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            Gallery.tbLine.Render(app, px, py, app.Scale(360));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py + app.Scale(68) - app.Scale(24), "Segment · pill group",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            Gallery.tbSeg.Render(app, px, py + app.Scale(68), app.Scale(240));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py + app.Scale(136) - app.Scale(24), "Card · closable · add (+) · overflow (wheel / chevrons) · right-click",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            Gallery.tbCard.Render(app, px, py + app.Scale(136), app.Scale(320));

            // Vertical rail with its own page region drawn by the caller —
            // header and page are fully decoupled.
            int vy = py + app.Scale(210);
            int railW = app.Scale(150);
            int railH = Gallery.tbVert.HeaderHeight(app) * Gallery.tbVert.Count();
            Gallery.tbVert.RenderVertical(app, px, vy, railW, railH);
            int pageX = px + railW + app.Scale(16);
            int pageW = app.Scale(300);
            Panel pane = new Panel("page").Titled(Gallery.tbVert.ActiveLabel());
            pane.RenderInside(app, new Rect(pageX, vy, pageW, railH));
            Rect page = pane.Inner();
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                page.x, page.y, "Active page: " + Gallery.tbVert.ActiveLabel(),
                app.theme.textPrimary, app.theme.fontSizeMedium);
        } else if (name == "Steps") {
            // WYSIWYG: retained instances laid out by a column — no coordinates.
            Steps s1 = new Steps();
            s1.data = Gallery.model.level;
            s1.AddStep("Details"); s1.AddStep("Review"); s1.AddStep("Done");
            Steps s2 = new Steps();
            s2.data = Gallery.model.level;
            s2.AddStep("Upload"); s2.AddStep("Verify"); s2.AddStep("Publish");
            s2.ErrorIndex = 1;
            Steps s3 = new Steps();
            s3.AddStepDesc("Account", "Email and password");
            s3.AddStepDesc("Profile", "Name and avatar");
            s3.AddStepDesc("Finish", "Review and submit");
            s3.Class = "vertical";
            Panel col = Panel.Column().Gap(app.Scale(12));
            col.With(new Label { Text = "Horizontal · bound current step", Class = "secondary" });
            col.With(s1);
            col.With(new Label { Text = "Error state", Class = "secondary" });
            col.With(s2);
            col.With(new Label { Text = "Vertical · with descriptions", Class = "secondary" });
            col.With(s3);
            col.MeasureTree(app);
            col.Arrange(px, py - app.Scale(20), w - app.Scale(36), app.Scale(380));
            col.RenderTree(app);
        } else if (name == "Breadcrumb") {
            // WYSIWYG: a retained Breadcrumb instance, auto-measured/placed.
            Breadcrumb bc = new Breadcrumb();
            bc.AddItem("Home"); bc.AddItem("Components"); bc.AddItem("Breadcrumb");
            Panel col = Panel.Column();
            col.With(bc);
            Gallery.LayoutIn(app, col, px, py,
                             w - app.Scale(36), app.Scale(36));
        } else if (name == "Menu") {
            List<string> menuItems = new List<string>();
            menuItems.Add("Overview"); menuItems.Add("Settings");
            int id = Menu.RenderVertical(app, px, py - app.Scale(20), app.Scale(220), py + app.Scale(74), app.Scale(36), menuItems, Gallery.demoInt, 0);
            Menu.HandleClick(app, id, menuItems.Count, Gallery.demoInt);
        } else if (name == "PageHeader") {
            PageHeader ph = new PageHeader("Component page", "Title, subtitle and back action");
            Panel col = Panel.Column();
            col.With(ph);
            Gallery.LayoutIn(app, col, px, py - app.Scale(16),
                             w - app.Scale(36), app.Scale(64));
        } else if (name == "Pagination") {
            // Multiple styles, each bound to its own current-page signal,
            // stacked by a Panel column with a label above each one.
            Pagination pg = new Pagination(12);
            pg.Page = Gallery.model.pick;   // two-way
            Pagination pill = new Pagination(12);
            pill.Page = Gallery.model.pick;   // two-way
            pill.Class = "pill";
            Pagination small = new Pagination(12);
            small.Page = Gallery.model.pick;   // two-way
            small.Class = "small";
            Pagination simple = new Pagination(12);
            simple.Page = Gallery.model.pick;   // two-way
            simple.Class = "simple";
            Panel col = Panel.Column().Gap(app.Scale(10));
            col.With(new Label { Text = "Default · windowed with ellipses", Class = "secondary" });
            col.With(pg);
            col.With(new Label { Text = "Pill · rounded buttons", Class = "secondary" });
            col.With(pill);
            col.With(new Label { Text = "Small · compact size", Class = "secondary" });
            col.With(small);
            col.With(new Label { Text = "Simple · prev / total / next", Class = "secondary" });
            col.With(simple);
            Gallery.LayoutIn(app, col, px, py - app.Scale(20),
                             w - app.Scale(36), app.Scale(310));
        } else if (name == "Card") {
            int cy0 = py - app.Scale(12);
            int cw = app.Scale(380);
            int ch = app.Scale(150);
            int lx = app.Scale(14);
            // Row 1, card 1 — reactbits "border-glow", via the declarative
            // FxOptions config (card.WithFx(o)).
            FxOptions fxGlow = new FxOptions();
            fxGlow.borderGlow = true;
            new Card("BorderGlow").WithFx(fxGlow).RenderInside(app,
                new Rect(px, cy0, cw, ch));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                px + lx, Card.ContentY(cy0, t), "Animated border light",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            // Row 1, card 2 — magic-bento spotlight: a soft glow follows the cursor.
            int px2 = px + cw + app.Scale(24);
            FxOptions fxSpot = new FxOptions();
            fxSpot.spotlight = true;
            new Card("Spotlight").WithFx(fxSpot).RenderInside(app,
                new Rect(px2, cy0, cw, ch));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                px2 + lx, Card.ContentY(cy0, t), "Hover — light follows cursor",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            // Row 2 — four opt-in card motion variants, each clipped in-bounds.
            int ry = cy0 + ch + app.Scale(22);
            int cw2 = app.Scale(184);
            int g2 = app.Scale(16);
            int rh = app.Scale(150);
            int cxa = px;
            FxOptions fxSheen = new FxOptions();
            fxSheen.sheen = true;
            fxSheen.glowPeriodMs = 1600;
            new Card("Sheen").WithFx(fxSheen).RenderInside(app,
                new Rect(cxa, ry, cw2, rh));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                cxa + lx, Card.ContentY(ry, t), "Diagonal sheen",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int cxb = cxa + cw2 + g2;
            FxOptions fxAur = new FxOptions();
            fxAur.aurora = true;
            new Card("Aurora").WithFx(fxAur).RenderInside(app,
                new Rect(cxb, ry, cw2, rh));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                cxb + lx, Card.ContentY(ry, t), "Drifting aurora",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int cxc = cxb + cw2 + g2;
            FxOptions fxBr = new FxOptions();
            fxBr.breath = true;
            fxBr.glowPeriodMs = 2800;
            new Card("Breath").WithFx(fxBr).RenderInside(app,
                new Rect(cxc, ry, cw2, rh));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                cxc + lx, Card.ContentY(ry, t), "Breathing rim",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int cxd = cxc + cw2 + g2;
            FxOptions fxMo = new FxOptions();
            fxMo.motes = true;
            new Card("Motes").WithFx(fxMo).RenderInside(app,
                new Rect(cxd, ry, cw2, rh));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                cxd + lx, Card.ContentY(ry, t), "Rising motes",
                app.theme.textPrimary, app.theme.fontSizeMedium);
        } else if (name == "Panel") {
            // Panel is a titleless container surface (fill + border + padding);
            // Titled() adds the header rule.
            Panel box = new Panel("panel");
            box.RenderInside(app, new Rect(px, py - app.Scale(20),
                                             w - app.Scale(36), app.Scale(96)));
            Rect content = box.Inner();
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                content.x, content.y, "Titleless container surface",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                content.x, content.y + app.Scale(26), "Group content here; reach for Card when a header is needed.",
                app.theme.textPrimary, app.theme.fontSizeMedium);
        } else if (name == "Tag") {
            // Row 1: colour variants.
            Tag.Chip(app, px, py, "Default", "");
            Tag.Chip(app, px + app.Scale(84), py, "Primary", "primary");
            Tag.Chip(app, px + app.Scale(168), py, "Info", "info");
            Tag.Chip(app, px + app.Scale(240), py, "Success", "success");
            Tag.Chip(app, px + app.Scale(330), py, "Warning", "warning");
            Tag.Chip(app, px + app.Scale(426), py, "Error", "error");
            // Row 2: interactive closable chips + an "+ Add" action.
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py + app.Scale(30), "Closable · click x to remove, + Add to append",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int ty2 = py + app.Scale(54);
            int tx = px;
            int ti = 0;
            while (ti < Gallery.demoTags.Count) {
                string tg = Gallery.demoTags[ti];
                int cid = Tag.ChipClosable(app, tx, ty2, tg, "primary");
                int tgw = Tag.ClosableWidth(app, tg, "primary");
                if (Ui.Clicked(app, cid)) {
                    Gallery.demoTags.RemoveAt(ti);
                    app.RequestRedraw();
                } else {
                    tx = tx + tgw + app.Scale(8);
                    ti = ti + 1;
                }
            }
            Button addBtn = new Button { Text = "+ Add",
                                        Class = "primary outline small" };
            int abId = addBtn.Render(app, tx, ty2 - app.Scale(2), app.Scale(64));
            if (Ui.Clicked(app, abId)) {
                Gallery.demoTags.Add("Tag " + Convert.ToString(Gallery.demoTags.Count + 1));
                app.RequestRedraw();
            }
        } else if (name == "Avatar.text") {
            Panel row = Panel.Row().Gap(app.Scale(20));
            row.With(new Avatar("A", 32, ""));
            row.With(new Avatar("Z", 42, ""));
            row.With(new Avatar("GK", 52, ""));
            Gallery.LayoutIn(app, row, px, py,
                             w - app.Scale(36), app.Scale(60));
        } else if (name == "Avatar.icon") {
            Panel row = Panel.Row().Gap(app.Scale(20));
            row.With(new Avatar("", 42, "user"));
            row.With(new Avatar("", 42, "settings"));
            Gallery.LayoutIn(app, row, px, py,
                             w - app.Scale(36), app.Scale(52));
        } else if (name == "Badge.dot") {
            Panel row = Panel.Row().Gap(app.Scale(14));
            row.With(new Badge(0));
            row.With(new Label { Text = "unread / active", Class = "secondary" });
            Gallery.LayoutIn(app, row, px, py - app.Scale(2),
                             w - app.Scale(36), app.Scale(30));
        } else if (name == "Badge.count") {
            Panel row = Panel.Row().Gap(app.Scale(14));
            row.With(new Badge(5));
            row.With(new Badge(12));
            row.With(new Badge(99));
            row.With(new Badge(120));
            Gallery.LayoutIn(app, row, px, py,
                             w - app.Scale(36), app.Scale(30));
        } else if (name == "Statistic") {
            Statistic st1 = new Statistic("Active users", "12,480");
            Statistic st2 = new Statistic("Deploys", "1,024");
            st2.Class = "success";
            Statistic st3 = new Statistic("Errors", "3");
            st3.Class = "error";
            Panel row = Panel.Row().Gap(app.Scale(24));
            row.With(st1); row.With(st2); row.With(st3);
            Gallery.LayoutIn(app, row, px, py - app.Scale(8),
                             w - app.Scale(36), app.Scale(70));
        } else if (name == "Timeline") {
            List<TimelineItem> items = new List<TimelineItem>();
            items.Add(new TimelineItem("09:00", "Created", "Project initialized", "success"));
            items.Add(new TimelineItem("12:30", "Published", "Executable generated"));
            Timeline tl = Timeline.Of(items);
            Panel col = Panel.Column();
            col.With(tl);
            Gallery.LayoutIn(app, col, px, py - app.Scale(24),
                             w - app.Scale(36), app.Scale(120));
        } else if (name == "VirtualList") {
            // 两个模式并排一行、说明文字走布局容器——演示区里
            // 不手摆绝对坐标。
            Gallery.demoSelLabel.Text = Gallery.demoVList.SelectedText();
            Panel vrow = Panel.Row();
            vrow.Gap(40);
            Panel c1 = Panel.Column();
            c1.With(Gallery.demoVList);
            vrow.With(c1);
            Panel c2 = Panel.Column();
            c2.With(Gallery.demoVListTpl);
            vrow.With(c2);
            Panel c3 = Panel.Column();
            c3.Gap(8);
            c3.With(new Label("2000 rows · only visible ones drawn"));
            c3.With(new Label("SetRows: each row is a custom component"));
            c3.With(Gallery.demoSelLabel);
            vrow.With(c3);
            Gallery.LayoutIn(app, vrow, px, py - app.Scale(16),
                w - app.Scale(36), app.Scale(170));
        } else if (name == "ListView") {
            List<string> items = new List<string>();
            items.Add(Gallery.T("Inbox", "收件箱"));
            items.Add(Gallery.T("Starred", "已加星标"));
            items.Add(Gallery.T("Sent", "已发送"));
            items.Add(Gallery.T("Drafts", "草稿"));
            items.Add(Gallery.T("Spam", "垃圾邮件"));
            items.Add(Gallery.T("Trash", "回收站"));
            items.Add(Gallery.T("Archive", "归档"));
            if (Gallery.demoList == null) {
                Gallery.demoList = new ListView<string>(
                    new ListColumn<string>("", s => s));
                Gallery.demoList.Class = "flat";
            }
            Gallery.demoList.Bind(items);
            Gallery.demoList.RenderInside(app, new Rect(
                px, py - app.Scale(16), app.Scale(300),
                items.Count * app.theme.heightLarge));
        } else if (name == "Table") {
            List<string> columns = new List<string>();
            columns.Add(Gallery.T("Task", "任务"));
            columns.Add(Gallery.T("Owner", "负责人"));
            columns.Add(Gallery.T("Status", "状态"));
            List<int> widths = new List<int>();
            widths.Add(app.Scale(200)); widths.Add(app.Scale(140));
            widths.Add(app.Scale(120));
            int ty0 = py - app.Scale(16);
            Table.RenderHeader(app, px, ty0, columns, widths);
            List<string> t0 = new List<string>();
            t0.Add(Gallery.T("Lexer", "词法分析"));
            t0.Add("Ada"); t0.Add(Gallery.T("Done", "完成"));
            List<string> t1 = new List<string>();
            t1.Add(Gallery.T("Parser", "语法分析"));
            t1.Add("Bjarne"); t1.Add(Gallery.T("Review", "评审中"));
            List<string> t2 = new List<string>();
            t2.Add(Gallery.T("IR codegen", "IR 生成"));
            t2.Add("Chris"); t2.Add(Gallery.T("WIP", "进行中"));
            List<string> t3 = new List<string>();
            t3.Add(Gallery.T("Linker", "链接器"));
            t3.Add("Dennis"); t3.Add(Gallery.T("Blocked", "受阻"));
            int rh = t.heightMedium;
            Table.RenderRow(app, px, ty0 + rh, t0, widths, false);
            Table.RenderRow(app, px, ty0 + rh * 2, t1, widths, true);
            Table.RenderRow(app, px, ty0 + rh * 3, t2, widths, false);
            Table.RenderRow(app, px, ty0 + rh * 4, t3, widths, true);
        } else if (name == "PivotTable") {
            // region(0) x year(1) with two measures: units(2) and revenue(3).
            List<DataRow> rows = new List<DataRow>();
            DataRow p0 = new DataRow();
            p0.Push("North"); p0.Push("2025"); p0.Push("42"); p0.Push("120"); rows.Add(p0);
            DataRow p1 = new DataRow();
            p1.Push("North"); p1.Push("2026"); p1.Push("55"); p1.Push("160"); rows.Add(p1);
            DataRow p2 = new DataRow();
            p2.Push("South"); p2.Push("2025"); p2.Push("35"); p2.Push("90"); rows.Add(p2);
            DataRow p3 = new DataRow();
            p3.Push("South"); p3.Push("2026"); p3.Push("48"); p3.Push("140"); rows.Add(p3);
            PivotConfig cfg = new PivotConfig(0, 1, 2, 0);
            PivotConfig.AddValue(cfg, 2, 0, "Units");
            PivotConfig.AddValue(cfg, 3, 0, "Rev");
            PivotTable.Render(app, px, py - app.Scale(20), w - app.Scale(36), app.Scale(190), rows, cfg);
        } else if (name == "TreeView") {
            // Multi-level tree with selection checkboxes: click a folder to
            // expand/collapse, click a row to select, click a box to (de)select
            // (folders cascade to descendants), right-click for the action menu.
            int tact = Gallery.treeMenuAction.Get();
            if (tact >= 0) {
                Gallery.treeMenuAction.Set(0 - 1);
                Gallery.treeMenuSub.Set(0 - 1);
                Gallery.treeMenuOpen.Set(false);
                if (tact == 0) { Gallery.treeTv.ExpandAll(); }
                else if (tact == 1) { Gallery.treeTv.CollapseAll(); }
                else if (tact == 2) { Gallery.treeTv.SetAllChecked(true); }
                else if (tact == 3) { Gallery.treeTv.SetAllChecked(false); }
                else if (tact == 4) { Gallery.treeTv.Toggle(Gallery.treeMenuNode); }
                app.RequestRedraw();
            }

            Rect tvArea = new Rect(px, py - app.Scale(16),
                app.Scale(320), app.Scale(250));
            Gallery.treeTv.Bind(Gallery.treeNodes);
            Gallery.treeTv.RenderInside(app, tvArea);
            if (Gallery.treeMenuOpen.Get()) {
                List<MenuItem> items = new List<MenuItem>();
                items.Add(MenuItem.Header(Gallery.T("Tree actions", "树操作")));
                items.Add(MenuItem.Item(Gallery.T("Toggle check", "勾选 / 取消"), "check", 4));
                items.Add(MenuItem.Item(Gallery.T("Expand all", "全部展开"), "chevron-down", 0));
                items.Add(MenuItem.Item(Gallery.T("Collapse all", "全部折叠"), "chevron-right", 1));
                items.Add(MenuItem.Separator());
                List<MenuItem> sub = new List<MenuItem>();
                sub.Add(MenuItem.Item(Gallery.T("Check all", "全选"), "check", 2));
                sub.Add(MenuItem.Item(Gallery.T("Clear", "清空"), "close", 3));
                items.Add(MenuItem.Submenu(Gallery.T("Selection", "选择"), "copy", sub));
                app.AddOverlay(OverlayPopup.RichMenu(Gallery.treeMenuX,
                    Gallery.treeMenuY, items, Gallery.treeMenuBaseId,
                    Gallery.treeMenuAction, Gallery.treeMenuOpen,
                    Gallery.treeMenuSub));
            }

            int tsel = Gallery.treeSel.Get();
            string picked = "";
            if (tsel >= 0 && tsel < Gallery.treeNodes.Count) {
                picked = Gallery.treeNodes[tsel].label;
            }
            int infoX = px + app.Scale(340);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                infoX, py - app.Scale(16), Gallery.T("Selected: ", "已选择：") + picked,
                app.theme.textPrimary, app.theme.fontSizeMedium);
            List<string> chk = Gallery.treeTv.CheckedLabels();
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                infoX, py + app.Scale(8), Gallery.T("Checked: ", "已勾选：") + Convert.ToString(chk.Count),
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int cly = py + app.Scale(32);
            for (int cli = 0; cli < chk.Count && cli < 7; cli = cli + 1) {
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "secondary", Style.SNormal()),
                    infoX, cly, "• " + chk[cli],
                    app.theme.textPrimary, app.theme.fontSizeMedium);
                cly = cly + app.Scale(20);
            }
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                infoX, cly + app.Scale(6), Gallery.T("Right-click a row for actions", "右键任意行打开操作菜单"),
                app.theme.textPrimary, app.theme.fontSizeMedium);
        } else if (name == "Collapse") {
            Collapse c = new Collapse();
            c.AddPanel("General", "Theme, language and startup");
            c.AddPanel("Advanced", "Developer options, diagnostics and logs");
            c.Active = Gallery.model.pick;   // two-way open index
            Panel col = Panel.Column();
            col.With(c);
            Gallery.LayoutIn(app, col, px, py - app.Scale(20),
                             w - app.Scale(36), app.Scale(140));
        } else if (name == "Carousel.basic") {
            Carousel car = new Carousel();
            car.AddSlide("First slide"); car.AddSlide("Second slide"); car.AddSlide("Third slide");
            car.Index = Gallery.model.slide;   // two-way
            Panel col = Panel.Column().Gap(app.Scale(8));
            col.With(car);
            Gallery.LayoutIn(app, col, px, py - app.Scale(10),
                             w - app.Scale(36), app.Scale(140));
        } else if (name == "Carousel.anim") {
            Carousel car = new Carousel();
            car.AddSlide("Overview"); car.AddSlide("Metrics"); car.AddSlide("Reports"); car.AddSlide("Settings");
            car.Index = Gallery.model.slide;   // two-way
            car.Animate(Gallery.demoCarousel);
            Panel col = Panel.Column().Gap(app.Scale(8));
            col.With(car);
            Gallery.LayoutIn(app, col, px, py - app.Scale(10),
                             w - app.Scale(36), app.Scale(140));
        } else if (name == "Carousel.many") {
            Carousel car = new Carousel();
            car.AddSlide("Aurora"); car.AddSlide("Canyon"); car.AddSlide("Harbor");
            car.AddSlide("Meadow"); car.AddSlide("Skyline"); car.AddSlide("Tundra");
            car.Index = Gallery.model.slide;   // two-way
            car.Animate(Gallery.carAnim2);
            Panel col = Panel.Column().Gap(app.Scale(8));
            col.With(car);
            Gallery.LayoutIn(app, col, px, py - app.Scale(10),
                             w - app.Scale(36), app.Scale(140));
        } else if (name == "Chart.line") {
            // Declarative one-shot: title + categories + series list, in the
            // same shape as an ECharts option (series[i] carries its own type).
            ChartOption cm = ChartOption.Of(Gallery.T("Monthly revenue", "月度营收"),
                new List<string>{ "Jan", "Feb", "Mar", "Apr", "May", "Jun",
                                  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" },
                new List<ChartSeries>{
                    ChartSeries.Line(Gallery.T("Revenue", "营收"), new List<int>{ 32, 45, 38, 52, 61, 48, 57, 66, 74, 69, 82, 95 }),
                    ChartSeries.Line(Gallery.T("Cost", "成本"), new List<int>{ 18, 22, 20, 26, 30, 28, 25, 31, 36, 33, 39, 44 }),
                    ChartSeries.Line(Gallery.T("Profit", "利润"), new List<int>{ 14, 23, 18, 26, 31, 20, 32, 35, 38, 36, 43, 51 })
                });
            ChartView.KeyedStatic(cm, 8110).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(240));
        } else if (name == "Chart.area") {
            // Distinct data from the line demo: 14-day DAU split by platform.
            ChartOption cm = ChartOption.Of(Gallery.T("Daily active users (14d)", "日活跃用户（14 天）"),
                new List<string>{ "D1", "D2", "D3", "D4", "D5", "D6", "D7",
                                  "D8", "D9", "D10", "D11", "D12", "D13", "D14" },
                new List<ChartSeries>{
                    ChartSeries.Area(Gallery.T("Web", "网页端"), new List<int>{ 88, 95, 92, 108, 120, 116, 132, 128, 141, 138, 152, 149, 163, 171 }),
                    ChartSeries.Area(Gallery.T("Mobile", "移动端"), new List<int>{ 64, 70, 76, 82, 90, 96, 105, 110, 118, 125, 133, 140, 148, 155 }),
                    ChartSeries.Area("API", new List<int>{ 22, 24, 23, 28, 30, 33, 31, 36, 39, 41, 45, 44, 49, 52 })
                });
            ChartView.KeyedStatic(cm, 8111).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(240));
        } else if (name == "Chart.smooth") {
            // Smoothing demo: an hour-by-hour price trace + its moving average.
            ChartOption cm = ChartOption.Of(Gallery.T("BTC price (24h)", "BTC 价格（24 小时）"),
                new List<string>{ "00", "02", "04", "06", "08", "10", "12",
                                  "14", "16", "18", "20", "22" },
                new List<ChartSeries>{
                    ChartSeries.Line(Gallery.T("Price", "价格"), new List<int>{ 118, 121, 117, 124, 128, 126, 132, 130, 135, 133, 138, 141 }),
                    ChartSeries.Line("MA12", new List<int>{ 118, 119, 119, 121, 122, 123, 125, 126, 128, 129, 131, 132 })
                });
            cm.smooth = true;
            ChartView.KeyedStatic(cm, 8112).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(240));
        } else if (name == "Chart.bar") {
            ChartOption cm = ChartOption.Of(Gallery.T("Q2 sales by region", "Q2 分区销售额"),
                new List<string>{ "Asia", "Europe", "Americas", "Africa", "Oceania" },
                new List<ChartSeries>{
                    ChartSeries.Bar(Gallery.T("Online", "线上"), new List<int>{ 84, 61, 73, 28, 35 }),
                    ChartSeries.Bar(Gallery.T("Retail", "门店"), new List<int>{ 52, 44, 58, 21, 18 })
                });
            cm.showValues = true;
            ChartView.KeyedStatic(cm, 8113).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(240));
        } else if (name == "Chart.stacked") {
            ChartOption cm = ChartOption.Of(Gallery.T("Energy mix (TWh)", "能源结构（TWh）"),
                new List<string>{ "Jan", "Feb", "Mar", "Apr", "May", "Jun",
                                  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" },
                new List<ChartSeries>{
                    ChartSeries.StackedBar(Gallery.T("Solar", "太阳能"), new List<int>{ 12, 15, 18, 22, 26, 30, 33, 31, 27, 22, 16, 12 }),
                    ChartSeries.StackedBar(Gallery.T("Wind", "风电"), new List<int>{ 28, 25, 30, 27, 24, 22, 20, 23, 27, 30, 33, 31 }),
                    ChartSeries.StackedBar(Gallery.T("Hydro", "水电"), new List<int>{ 22, 21, 20, 19, 18, 17, 16, 17, 18, 19, 21, 22 }),
                    ChartSeries.StackedBar(Gallery.T("Coal", "火电"), new List<int>{ 40, 38, 36, 33, 30, 27, 25, 26, 29, 33, 37, 39 }),
                    ChartSeries.StackedBar(Gallery.T("Gas", "燃气"), new List<int>{ 24, 23, 22, 24, 25, 26, 27, 26, 25, 24, 23, 24 })
                });
            ChartView.KeyedStatic(cm, 8114).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(240));
        } else if (name == "Chart.pie") {
            // Part-of-whole charts are small: show pie + donut side by side
            // (two per row) instead of one stretched across the full width.
            int cY = y + app.Scale(30);
            int cH = app.Scale(240);
            int halfW = (w - app.Scale(28) - app.Scale(12)) / 2;
            int c0X = x + app.Scale(14);
            int c1X = c0X + halfW + app.Scale(12);

            ChartOption pm = ChartOption.Of(Gallery.T("Language share", "语言占比"), null,
                new List<ChartSeries>{
                    ChartSeries.Pie("Zan", new List<int>{ 38 }),
                    ChartSeries.Pie("C", new List<int>{ 22 }),
                    ChartSeries.Pie("Rust", new List<int>{ 16 }),
                    ChartSeries.Pie("TypeScript", new List<int>{ 10 }),
                    ChartSeries.Pie("Go", new List<int>{ 9 }),
                    ChartSeries.Pie("Other", new List<int>{ 5 })
                });
            // 外置标签 + 引导线（ECharts labelLine 形态）。
            for (int li = 0; li < pm.series.Count; li = li + 1) {
                pm.series[li].labelShow = true;
            }
            ChartView.KeyedStatic(pm, 8120).Render(app, c0X, cY, halfW, cH);

            // Donut shows a different dataset so the two charts do not just
            // restate each other: browser share + the total in the hole.
            ChartOption dm = ChartOption.Of(Gallery.T("Browser share", "浏览器份额"), null,
                new List<ChartSeries>{
                    ChartSeries.Donut("Chrome", new List<int>{ 63 }),
                    ChartSeries.Donut("Safari", new List<int>{ 19 }),
                    ChartSeries.Donut("Edge", new List<int>{ 11 }),
                    ChartSeries.Donut("Firefox", new List<int>{ 7 })
                });
            ChartView.KeyedStatic(dm, 8121).Render(app, c1X, cY, halfW, cH);
        } else if (name == "Chart.gauge") {
            ChartSeries gs = ChartSeries.Gauge(Gallery.T("CPU load", "CPU 负载"), 72);
            gs.gauge.radius = ChartScalar.Pct(76);
            gs.gauge.detail.formatter = "{value}%";
            ChartOption gm = ChartOption.Of(Gallery.T("Standard gauge", "标准仪表盘"), null,
                new List<ChartSeries>{ gs });
            ChartView.KeyedStatic(gm, 8130).Render(app, x + app.Scale(14), y + app.Scale(30),
                w - app.Scale(28), app.Scale(300));
        } else if (name == "Chart.gaugeHalf") {
            ChartSeries hs = ChartSeries.Gauge(Gallery.T("Temperature", "温度"), 68);
            hs.gauge.min = 0;
            hs.gauge.max = 120;
            hs.gauge.startAngle = 180;
            hs.gauge.endAngle = 0;
            hs.gauge.center = ChartPosition.Of(ChartScalar.Pct(50), ChartScalar.Pct(88));
            hs.gauge.radius = ChartScalar.Pct(90);
            hs.gauge.splitNumber = 6;
            hs.gauge.axisTick.splitNumber = 4;
            hs.gauge.axisLine.lineStyle.width = 14;
            hs.gauge.pointer.length = ChartScalar.Pct(72);
            hs.gauge.pointer.width = 5;
            hs.gauge.title.offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(0 - 42));
            hs.gauge.detail.offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(0 - 20));
            hs.gauge.detail.formatter = "{value} °C";
            hs.gauge.axisLine.colors = new List<GaugeColorStop>{
                GaugeColorStop.Of(350, Chart.Rgb(115, 192, 222)),
                GaugeColorStop.Of(600, Chart.Rgb(84, 112, 198)),
                GaugeColorStop.Of(800, Chart.Rgb(250, 200, 88)),
                GaugeColorStop.Of(1000, Chart.Rgb(238, 102, 102))
            };
            ChartOption hm = ChartOption.Of(Gallery.T("Half gauge", "个性化半圆仪表"), null,
                new List<ChartSeries>{ hs });
            ChartView.KeyedStatic(hm, 8132).Render(app, x + app.Scale(14), y + app.Scale(30),
                w - app.Scale(28), app.Scale(300));
        } else if (name == "Chart.gaugeMulti") {
            // 汽车仪表组：小-大-小。中间车速大盘，
            // 左侧转速小盘，右侧油量 / 水温共用的小盘。
            int dialValue = Chart.Rgb(64, 158, 255);
            ChartSeries rpm = ChartSeries.Gauge(Gallery.T("x1000 r/min", "转速 x1000"), 4);
            rpm.gauge.min = 0; rpm.gauge.max = 8; rpm.gauge.splitNumber = 8;
            rpm.gauge.center = ChartPosition.Of(ChartScalar.Pct(17), ChartScalar.Pct(45));
            rpm.gauge.radius = ChartScalar.Pct(54); rpm.gauge.detail.formatter = "{value}";
            rpm.gauge.title.offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(0 - 28));
            rpm.gauge.detail.offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(82));
            rpm.gauge.detail.textStyle.color = dialValue;
            rpm.gauge.detail.textStyle.fontSize = 26;
            ChartSeries speed = ChartSeries.Gauge(Gallery.T("km/h", "车速 km/h"), 128);
            speed.gauge.min = 0; speed.gauge.max = 220; speed.gauge.splitNumber = 11;
            speed.gauge.center = ChartPosition.Of(ChartScalar.Pct(50), ChartScalar.Pct(45));
            speed.gauge.radius = ChartScalar.Pct(94); speed.gauge.detail.formatter = "{value}";
            speed.gauge.title.offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(0 - 25));
            speed.gauge.detail.offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(80));
            speed.gauge.detail.textStyle.color = dialValue;
            speed.gauge.detail.textStyle.fontSize = 34;
            // 油量 / 水温共用一只小盘：上半段油量、下半段水温，
            // 只留 Gas / Water 名称，不显示数字刻度。
            ChartSeries fuel = ChartSeries.Gauge(Gallery.T("Gas", "油量"), 1);
            fuel.gauge.max = 2; fuel.gauge.startAngle = 180; fuel.gauge.endAngle = 90;
            fuel.gauge.splitNumber = 2; fuel.gauge.center = ChartPosition.Of(ChartScalar.Pct(83), ChartScalar.Pct(45));
            fuel.gauge.radius = ChartScalar.Pct(54); fuel.gauge.detail.show = false;
            fuel.gauge.axisLabel.show = false;
            fuel.gauge.title.offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(0 - 30));
            ChartSeries water = ChartSeries.Gauge(Gallery.T("Water", "水温"), 1);
            water.gauge.max = 2; water.gauge.startAngle = 90; water.gauge.endAngle = 0;
            water.gauge.splitNumber = 2; water.gauge.center = ChartPosition.Of(ChartScalar.Pct(83), ChartScalar.Pct(45));
            water.gauge.radius = ChartScalar.Pct(54); water.gauge.axisTick.show = false;
            water.gauge.detail.show = false; water.gauge.axisLabel.show = false;
            water.gauge.title.offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(45));
            ChartOption mm = ChartOption.Of(Gallery.T("Vehicle cluster", "车辆仪表组"), null,
                new List<ChartSeries>{ rpm, speed, fuel, water });
            ChartView.KeyedStatic(mm, 8133).Render(app, x + app.Scale(14), y + app.Scale(30),
                w - app.Scale(28), app.Scale(360));
        } else if (name == "Chart.dashboard") {
            int gap = app.Scale(12);
            int left = x + app.Scale(14);
            int top = y + app.Scale(30);
            int cellW = (w - app.Scale(28) - gap) / 2;
            int cellH = app.Scale(190);
            bool narrow = w < app.Scale(560);
            if (narrow) { cellW = w - app.Scale(28); }
            int x1 = left + cellW + gap;
            int y1 = top;
            int x2 = left;
            int y2 = top + cellH + gap;
            int x3 = x1;
            int y3 = y2;
            if (narrow) {
                x1 = left; y1 = top + cellH + gap;
                x2 = left; y2 = top + (cellH + gap) * 2;
                x3 = left; y3 = top + (cellH + gap) * 3;
            }

            ChartOption channels;
            if (narrow) {
                ChartSeries attainment = ChartSeries.Gauge(Gallery.T("Revenue target", "营收目标"), 84);
                attainment.gauge.radius = ChartScalar.Pct(74);
                attainment.gauge.detail.formatter = "{value}%";
                channels = ChartOption.Of(Gallery.T("Revenue attainment", "营收达成"), null,
                    new List<ChartSeries>{ attainment });
            } else {
                channels = ChartOption.Of(Gallery.T("Revenue mix", "营收构成"), null,
                    new List<ChartSeries>{
                        ChartSeries.Donut(Gallery.T("Subscription", "订阅"), new List<int>{ 46 }),
                        ChartSeries.Donut(Gallery.T("Usage", "用量"), new List<int>{ 29 }),
                        ChartSeries.Donut(Gallery.T("Services", "服务"), new List<int>{ 17 }),
                        ChartSeries.Donut(Gallery.T("Other", "其他"), new List<int>{ 8 })
                    });
            }
            ChartView.KeyedStatic(channels, 8301).Render(app, left, top, cellW, cellH);

            ChartOption health = ChartOption.Of(Gallery.T("Service health", "服务健康度"),
                new List<string>{ Gallery.T("Latency", "延迟"), Gallery.T("Uptime", "可用性"),
                                  Gallery.T("Capacity", "容量"), Gallery.T("Errors", "错误"),
                                  Gallery.T("Security", "安全") },
                new List<ChartSeries>{
                    ChartSeries.Polar(Gallery.T("Current", "当前"), new List<int>{ 82, 96, 74, 88, 91 }),
                    ChartSeries.Polar(Gallery.T("Target", "目标"), new List<int>{ 92, 99, 88, 95, 96 })
                });
            health.showLegend = !narrow;
            ChartView.KeyedStatic(health, 8302).Render(app, x1, y1, cellW, cellH);

            ChartOption funnel;
            if (narrow) {
                ChartNode journey = ChartNode.Group(Gallery.T("Journey", "转化"), new List<ChartNode>{
                    ChartNode.Leaf(Gallery.T("Visits", "访问"), 100),
                    ChartNode.Leaf(Gallery.T("Trials", "试用"), 63),
                    ChartNode.Leaf(Gallery.T("Activated", "激活"), 41),
                    ChartNode.Leaf(Gallery.T("Paid", "付费"), 24)
                });
                funnel = ChartOption.Of(Gallery.T("Customer journey", "客户转化"), null,
                    new List<ChartSeries>{ ChartSeries.OfTree(Gallery.T("Journey", "转化"), ChartType.Treemap, journey) });
            } else {
                funnel = ChartOption.Of(Gallery.T("Customer journey", "客户转化"), null,
                    new List<ChartSeries>{
                        ChartSeries.Funnel(Gallery.T("Visits", "访问"), new List<int>{ 100 }),
                        ChartSeries.Funnel(Gallery.T("Trials", "试用"), new List<int>{ 63 }),
                        ChartSeries.Funnel(Gallery.T("Activated", "激活"), new List<int>{ 41 }),
                        ChartSeries.Funnel(Gallery.T("Paid", "付费"), new List<int>{ 24 })
                    });
            }
            ChartView.KeyedStatic(funnel, 8303).Render(app, x2, y2, cellW, cellH);

            ChartOption activity = ChartOption.Of(Gallery.T("Traffic intensity", "流量强度"),
                new List<string>{ "00", "04", "08", "12", "16", "20" },
                new List<ChartSeries>{
                    ChartSeries.Of("API", ChartType.Heatmap, new List<int>{ 8, 5, 46, 82, 71, 28 }),
                    ChartSeries.Of(Gallery.T("Web", "网页"), ChartType.Heatmap, new List<int>{ 3, 2, 38, 68, 89, 44 }),
                    ChartSeries.Of(Gallery.T("Mobile", "移动"), ChartType.Heatmap, new List<int>{ 2, 1, 30, 74, 92, 51 })
                });
            activity.showLegend = !narrow;
            ChartView.KeyedStatic(activity, 8304).Render(app, x3, y3, cellW, cellH);
        } else if (name == "Chart.radial") {
            ChartOption rm = ChartOption.Of(Gallery.T("Resource usage", "资源占用"), null,
                new List<ChartSeries>{
                    ChartSeries.RadialBars("CPU", 80),
                    ChartSeries.RadialBars("RAM", 55),
                    ChartSeries.RadialBars("Disk", 30),
                    ChartSeries.RadialBars("GPU", 64),
                    ChartSeries.RadialBars("Net", 42)
                });
            rm.gaugeMax = 100;
            ChartView.KeyedStatic(rm, 8131).Render(app, x + app.Scale(14), y + app.Scale(30),
                w - app.Scale(28), app.Scale(240));
        } else if (name == "Chart.wordcloud") {
            List<ChartData> words = new List<ChartData>{
                ChartData.Named(100, "Zan"), ChartData.Named(86, "Compiler"),
                ChartData.Named(78, "Runtime"), ChartData.Named(70, "GUI"),
                ChartData.Named(62, "Chart"), ChartData.Named(55, "Async"),
                ChartData.Named(48, "Native"), ChartData.Named(43, "Types"),
                ChartData.Named(38, "Canvas"), ChartData.Named(34, "JSON"),
                ChartData.Named(30, "LSP"), ChartData.Named(27, "Debug"),
                ChartData.Named(24, "Fast"), ChartData.Named(21, "Safe")
            };
            ChartOption wc = ChartOption.Of(Gallery.T("Technology signals", "技术关键词"), null,
                new List<ChartSeries>{ ChartSeries.WordCloud(Gallery.T("Keywords", "关键词"), words) });
            wc.showLegend = false;
            ChartView.KeyedStatic(wc, 8305).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(240));
        } else if (name == "Chart.heatmap") {
            // Two heatmaps side by side: weekly activity per team, and an
            // hourly intensity grid. Both are compact, so half width each.
            int cY = y + app.Scale(30);
            int cH = app.Scale(240);
            int halfW = (w - app.Scale(28) - app.Scale(12)) / 2;
            int c0X = x + app.Scale(14);
            int c1X = c0X + halfW + app.Scale(12);
            ChartOption hm = ChartOption.Of(Gallery.T("Weekly activity (2 weeks)", "每周活跃（2 周）"),
                new List<string>{ Gallery.T("Mon", "周一"), Gallery.T("Tue", "周二"), Gallery.T("Wed", "周三"),
                                  Gallery.T("Thu", "周四"), Gallery.T("Fri", "周五"), Gallery.T("Sat", "周六"),
                                  Gallery.T("Sun", "周日"), Gallery.T("Mon", "周一"), Gallery.T("Tue", "周二"),
                                  Gallery.T("Wed", "周三"), Gallery.T("Thu", "周四"), Gallery.T("Fri", "周五"),
                                  Gallery.T("Sat", "周六"), Gallery.T("Sun", "周日") },
                new List<ChartSeries>{
                    ChartSeries.Of(Gallery.T("Team A", "A 组"), ChartType.Heatmap, new List<int>{ 12, 35, 50, 28, 64, 18, 8, 15, 30, 45, 22, 58, 12, 6 }),
                    ChartSeries.Of(Gallery.T("Team B", "B 组"), ChartType.Heatmap, new List<int>{ 40, 22, 70, 90, 55, 30, 15, 35, 25, 66, 82, 48, 24, 10 }),
                    ChartSeries.Of(Gallery.T("Team C", "C 组"), ChartType.Heatmap, new List<int>{ 5, 60, 45, 38, 80, 52, 20, 8, 55, 40, 33, 72, 46, 18 }),
                    ChartSeries.Of(Gallery.T("Team D", "D 组"), ChartType.Heatmap, new List<int>{ 28, 48, 20, 62, 34, 70, 44, 25, 42, 18, 56, 30, 62, 38 })
                });
            ChartView.KeyedStatic(hm, 8140).Render(app, c0X, cY, halfW, cH);

            // Hourly intensity: 24 slots per channel.
            ChartOption hh = ChartOption.Of(Gallery.T("Hourly intensity", "小时强度"),
                new List<string>{ "00", "02", "04", "06", "08", "10", "12",
                                  "14", "16", "18", "20", "22" },
                new List<ChartSeries>{
                    ChartSeries.Of(Gallery.T("Web", "网页端"), ChartType.Heatmap, new List<int>{ 2, 1, 0, 4, 22, 58, 72, 66, 48, 30, 14, 6 }),
                    ChartSeries.Of(Gallery.T("Mobile", "移动端"), ChartType.Heatmap, new List<int>{ 1, 1, 0, 2, 12, 34, 48, 52, 44, 26, 10, 4 }),
                    ChartSeries.Of("API", ChartType.Heatmap, new List<int>{ 8, 6, 4, 10, 26, 44, 40, 38, 36, 28, 18, 12 })
                });
            ChartView.KeyedStatic(hh, 8141).Render(app, c1X, cY, halfW, cH);
        } else if (name == "Chart.heatmap_calendar") {
            // GitHub 风格日历热力图：7 行（周几）x 52 列（一年周数），
            // 全部 series 统一绿色，由数值强度混合出分层绿（浅→深）——
            // 正是 contribution graph 的观感。列标签省略（52 列无空间），
            // 行标签 Mon..Sun；hover 显示具体值。
            if (Gallery.calHeat == null) {
                List<ChartSeries> csr = new List<ChartSeries>();
                List<string> dows = new List<string>{
                    Gallery.T("Mon", "周一"), Gallery.T("Tue", "周二"), Gallery.T("Wed", "周三"),
                    Gallery.T("Thu", "周四"), Gallery.T("Fri", "周五"), Gallery.T("Sat", "周六"),
                    Gallery.T("Sun", "周日") };
                for (int d = 0; d < 7; d = d + 1) {
                    List<int> cw2 = new List<int>();
                    for (int wk = 0; wk < 52; wk = wk + 1) {
                        int v = (d * 31 + wk * 17) % 100;
                        if (d >= 5) { v = v / 3; }
                        cw2.Add(v);
                    }
                    ChartSeries cs = ChartSeries.Of(dows[d], ChartType.Heatmap, cw2);
                    cs.color = Chart.Rgb(56, 164, 88);
                    csr.Add(cs);
                }
                ChartOption co3 = ChartOption.Of(Gallery.T("Contributions (GitHub style)", "贡献日历（GitHub 风格）"),
                    new List<string>(), csr);
                Gallery.calHeat = co3;
            }
            ChartView.KeyedStatic(Gallery.calHeat, 8166).Render(app,
                x + app.Scale(14), y + app.Scale(30),
                w - app.Scale(28), app.Scale(250));
        } else if (name == "Chart.json") {
            // The exact same chart, driven entirely by a JSON data document
            // instead of imperative Add() calls (color 0 = auto palette).
            string doc = "{\"title\":\"Monthly active users\","
                + "\"labels\":[\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\"],"
                + "\"series\":[{\"name\":\"Web\",\"color\":0,\"values\":[30,45,38,60,72,85,78,96]},"
                + "{\"name\":\"Mobile\",\"color\":0,\"values\":[20,32,40,52,64,80,74,88]},"
                + "{\"name\":\"Desktop\",\"color\":0,\"values\":[12,16,20,24,22,28,26,31]}]}";
            ChartOption cm = ChartOption.FromJson(doc);
            cm.smooth = true;
            cm.showValues = false;
            ChartView.KeyedStatic(cm, 8115).Render(
                app, x + app.Scale(14), y + app.Scale(30),
                w - app.Scale(28), app.Scale(240));
        } else if (name == "Chart.scatter") {
            int cY = y + app.Scale(30);
            int cH = app.Scale(240);
            int halfW = (w - app.Scale(28) - app.Scale(12)) / 2;
            int c0X = x + app.Scale(14);
            int c1X = c0X + halfW + app.Scale(12);
            // 左：双系列散点 + 线性回归趋势线。趋势线用 OfPoints 造两个
            // 端点，type 改 Line —— DrawScatterCore 对 Line 系列画连线。
            List<ChartPoint> points = new List<ChartPoint>();
            int sx2 = 0; int sy2 = 0; int sxx2 = 0; int sxy2 = 0;
            for (int xi = 0; xi < 14; xi = xi + 1) {
                int xv = 6 + xi * 6;
                int yv = 10 + xv * 2 / 3 + (xi * 7) % 12;
                points.Add(ChartPoint.Of(xv, yv));
                sx2 = sx2 + xv; sy2 = sy2 + yv;
                sxx2 = sxx2 + xv * xv; sxy2 = sxy2 + xv * yv;
            }
            int denom = 14 * sxx2 - sx2 * sx2;
            int slopeK = 0;
            if (denom != 0) { slopeK = (14 * sxy2 - sx2 * sy2) * 1000 / denom; }
            int interK = (sy2 * 1000 - slopeK * sx2) / 14;
            List<ChartPoint> trendPoints = new List<ChartPoint>{
                ChartPoint.Of(points[0].x, interK + slopeK * points[0].x / 1000),
                ChartPoint.Of(points[13].x, interK + slopeK * points[13].x / 1000)
            };
            ChartSeries trend = ChartSeries.OfPoints(Gallery.T("Trend", "趋势线"), trendPoints);
            trend.type = ChartType.Line;
            List<ChartPoint> pointsB = new List<ChartPoint>();
            for (int bi2 = 0; bi2 < 10; bi2 = bi2 + 1) {
                pointsB.Add(ChartPoint.Of(8 + bi2 * 8, 30 + (bi2 * 9) % 38));
            }
            ChartOption so = ChartOption.Of(Gallery.T("Samples + regression", "样本 + 回归"), null,
                new List<ChartSeries>{
                    ChartSeries.OfPoints(Gallery.T("Series A", "系列 A"), points),
                    ChartSeries.OfPoints(Gallery.T("Series B", "系列 B"), pointsB),
                    trend
                });
            ChartView.KeyedStatic(so, 8170).Render(app, c0X, cY, halfW, cH);

            // 右：2000 点大规模散点。数据静态懒构建，走 RenderCached（首帧
            // 光栅化 + 快照，之后每帧一次拷贝），hover 由 ScatterHover 叠加。
            if (Gallery.scatterCloud == null) {
                List<ChartPoint> cloudPoints = new List<ChartPoint>();
                for (int pi = 0; pi < 2000; pi = pi + 1) {
                    int pxv = 3 + (pi * 37 + pi * pi * 13) % 90;
                    int pyv = 5 + (pi * 53 + pi * pi * 7) % 72;
                    cloudPoints.Add(ChartPoint.Of(pxv, pyv));
                }
                ChartOption co2 = ChartOption.Of(Gallery.T("Cloud 2000 pts", "2000 点点云"), null,
                    new List<ChartSeries>{ ChartSeries.OfPoints(Gallery.T("Cloud", "点云"), cloudPoints) });
                Gallery.scatterCloud = co2;
                Gallery.scatterCloudSlot = ChartView.AllocCacheSlot();
            }
            ChartView.RenderCached(app, Gallery.scatterCloud, Gallery.scatterCloudSlot,
                c1X, cY, halfW, cH);
            ChartView.ScatterHover(app, c1X, cY, halfW, cH, Gallery.scatterCloud);
        } else if (name == "Chart.step") {
            ChartOption sm = ChartOption.Of(Gallery.T("Server load", "服务器负载"),
                new List<string>{ "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun",
                                  "Mon2", "Tue2", "Wed2", "Thu2", "Fri2", "Sat2", "Sun2" },
                new List<ChartSeries>{
                    ChartSeries.StepLine(Gallery.T("req/s", "请求/秒"), new List<int>{ 10, 14, 12, 20, 18, 26, 24, 12, 16, 13, 22, 20, 28, 25 }),
                    ChartSeries.StepLine(Gallery.T("errors", "错误数"), new List<int>{ 1, 0, 2, 1, 3, 1, 0, 2, 1, 1, 2, 0, 3, 1 })
                });
            ChartView.KeyedStatic(sm, 8150).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(240));
        } else if (name == "Chart.stackedarea") {
            ChartOption am = ChartOption.Of(Gallery.T("Traffic", "流量"),
                new List<string>{ "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug" },
                new List<ChartSeries>{
                    ChartSeries.StackedArea(Gallery.T("Web", "网页端"), new List<int>{ 30, 45, 38, 60, 72, 85, 78, 96 }),
                    ChartSeries.StackedArea(Gallery.T("Mobile", "移动端"), new List<int>{ 20, 32, 40, 52, 64, 80, 74, 88 }),
                    ChartSeries.StackedArea("API", new List<int>{ 10, 18, 22, 30, 28, 40, 36, 44 })
                });
            am.smooth = true;
            ChartView.KeyedStatic(am, 8151).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(240));
        } else if (name == "Chart.stackedline") {
            // ECharts `line + stack`: a stackName groups series into one
            // cumulative band (total stack), exactly like ECharts' stack.
            List<string> dlabs = new List<string>{
                Gallery.T("Mon", "周一"), Gallery.T("Tue", "周二"), Gallery.T("Wed", "周三"),
                Gallery.T("Thu", "周四"), Gallery.T("Fri", "周五"), Gallery.T("Sat", "周六"),
                Gallery.T("Sun", "周日") };
            ChartSeries e1 = ChartSeries.StackedLine(Gallery.T("Email marketing", "邮件营销"), new List<int>{ 120, 132, 101, 134, 90, 230, 210 });
            e1.stackName = Gallery.T("Total", "总量");
            ChartSeries e2 = ChartSeries.StackedLine(Gallery.T("Affiliate ads", "联盟广告"), new List<int>{ 220, 182, 191, 234, 290, 330, 310 });
            e2.stackName = Gallery.T("Total", "总量");
            ChartSeries e3 = ChartSeries.StackedLine(Gallery.T("Video ads", "视频广告"), new List<int>{ 150, 232, 201, 154, 190, 330, 410 });
            e3.stackName = Gallery.T("Total", "总量");
            ChartSeries e4 = ChartSeries.StackedLine(Gallery.T("Direct access", "直接访问"), new List<int>{ 320, 332, 301, 334, 390, 330, 320 });
            e4.stackName = Gallery.T("Total", "总量");
            ChartSeries e5 = ChartSeries.StackedLine(Gallery.T("Search engines", "搜索引擎"), new List<int>{ 830, 932, 901, 934, 1290, 1330, 1320 });
            e5.stackName = Gallery.T("Total", "总量");
            ChartOption sl = ChartOption.Of(Gallery.T("Traffic sources (stacked line)", "访问来源（堆叠折线）"),
                dlabs, new List<ChartSeries>{ e1, e2, e3, e4, e5 });
            sl.smooth = true;
            ChartView.KeyedStatic(sl, 8180).Render(
                app, x + app.Scale(14), y + app.Scale(30), w - app.Scale(28), app.Scale(240));
        } else if (name == "Chart.candle") {
            // Two tickers side by side: AAPL (with MA overlay) and TSLA.
            int cY = y + app.Scale(30);
            int cH = app.Scale(240);
            int halfW = (w - app.Scale(28) - app.Scale(12)) / 2;
            int c0X = x + app.Scale(14);
            int c1X = c0X + halfW + app.Scale(12);
            List<Candle> cs = new List<Candle>();
            cs.Add(Candle.Of(100, 115, 95, 110));
            cs.Add(Candle.Of(110, 120, 104, 106));
            cs.Add(Candle.Of(106, 112, 100, 111));
            cs.Add(Candle.Of(111, 130, 109, 128));
            cs.Add(Candle.Of(128, 132, 118, 121));
            cs.Add(Candle.Of(121, 126, 112, 114));
            cs.Add(Candle.Of(114, 140, 113, 138));
            cs.Add(Candle.Of(138, 145, 132, 134));
