        Gallery.pgDefault = new Pagination(12);
        Gallery.pgDefault.Page = Gallery.model.pick;
        Gallery.pgPill = new Pagination(12);
        Gallery.pgPill.Page = Gallery.model.pick;
        Gallery.pgPill.Class = "pill";
        Gallery.pgSmall = new Pagination(12);
        Gallery.pgSmall.Page = Gallery.model.pick;
        Gallery.pgSmall.Class = "small";
        Gallery.pgSimple = new Pagination(12);
        Gallery.pgSimple.Page = Gallery.model.pick;
        Gallery.pgSimple.Class = "simple";
        Gallery.pgRich = new Pagination(100);
        Gallery.pgRich.Page = Gallery.model.pagJump;
        Gallery.pgRich.Jumper(true).ShowSizes(true).ShowTotal(true);
        Gallery.pgRich.Prefix(Gallery.T("Items", "条目"));
        Gallery.pgRich.Suffix(Gallery.T("end", "完"));
        Gallery.pgCounted = Pagination.WithCount(205, 20,
                                                  Gallery.model.pagJump);
        Gallery.pgCounted.ShowSizes(true);
        Gallery.pgArrowed = new Pagination(101);
        Gallery.pgArrowed.Page = Gallery.model.pagJump;
        Gallery.pgArrowed.PrevText(Gallery.T("Back", "往回走"));
        Gallery.pgArrowed.NextText(Gallery.T("Onward", "继续走"));
        Gallery.pgOrdered = new Pagination(100);
        Gallery.pgOrdered.Page = Gallery.model.pagJump;
        Gallery.pgOrdered.Jumper(true).ShowSizes(true);
        Gallery.pgOrdered.SetOrderText("jumper, sizes, pager");
        Panel col = Panel.Column().Gap(app.Scale(10));
        col.With(new Label { Text = "Default · windowed with ellipses", Class = "secondary" });
        col.With(Gallery.pgDefault);
        col.With(new Label { Text = "Pill · rounded buttons", Class = "secondary" });
        col.With(Gallery.pgPill);
        col.With(new Label { Text = "Small · compact size", Class = "secondary" });
        col.With(Gallery.pgSmall);
        col.With(new Label { Text = "Simple · editable current page (Enter)", Class = "secondary" });
        col.With(Gallery.pgSimple);
        col.With(new Label { Text = "100 pages · total + jumper + page sizes + prefix/suffix · ellipsis jumps ±5", Class = "secondary" });
        col.With(Gallery.pgRich);
        col.With(new Label { Text = "Item-count mode · 205 items at 20/page derives 11 pages", Class = "secondary" });
        col.With(Gallery.pgCounted);
        col.With(new Label { Text = "Custom prev/next labels", Class = "secondary" });
        col.With(Gallery.pgArrowed);
        col.With(new Label { Text = "Custom order: jumper, sizes, pager", Class = "secondary" });
        col.With(Gallery.pgOrdered);
        Gallery.pgPanel = col;
    }

    /// Upload 演示组（对齐 Naive UI 上传文档的卡片集）。传输三件套
    /// （basic/manual/callback）挂同一个 mock CustomRequest：后台线程
    /// 模拟推进度；defaults/thumbs/download 直接预置数据；limit 演示
    /// accept+max 两道门；drag 演示大拖拽区；wall 演示照片墙。
    static void BuildUploadDemos() {
        Gallery.demoUploads = new List<Upload>();
        Gallery.demoMockLock = Mutex.Create();
        Gallery.demoMockPending = new List<MockUploadJob>();

        Gallery.demoUploadBasic = new Upload();
        Gallery.demoUploadBasic.WithCustomRequest(Gallery.MockUpload);
        Gallery.demoUploadBasic.Tip = Gallery.T(
            "Click the button to pick a file; the mock transport simulates progress.",
            "点按钮选文件；mock 传输模拟进度推进。");
        Gallery.demoUploadManual = new Upload();
        Gallery.demoUploadManual.WithCustomRequest(Gallery.MockUpload);
        Gallery.demoUploadManual.AutoUpload = false;
        Gallery.demoUploadSubmitBtn = new Button {
            Text = Gallery.T("Submit", "提交上传") };
        Gallery.demoUploadSubmitBtn.OnClick(() => {
            Gallery.demoUploadManual.Submit();
        });
        Gallery.demoUploadCb = new Upload();
        Gallery.demoUploadCb.WithCustomRequest(Gallery.MockUpload);
        Gallery.demoUploadCbLabel = new Label("");
        Gallery.demoUploadCbLabel.Class = "secondary";
        Gallery.demoUploadCb.Change.Add(() => {
            UploadFile it = Gallery.demoUploadCb.LastItem;
            Gallery.demoUploadCbLabel.Text = Gallery.T("Change: ", "列表变化：")
                + Gallery.UploadStateName(it) + " · " + it.name;
        });
        Gallery.demoUploadCb.Finish.Add(() => {
            Gallery.demoUploadCbLabel.Text = Gallery.T(
                "Finish: ", "上传完成：") + Gallery.demoUploadCb.LastItem.name;
        });

        // 默认文件列表 / 缩略图列表 / 下载：预置数据，不依赖传输。
        Gallery.demoUploadDefaults = new Upload();
        Gallery.demoUploadDefaults.Multiple = true;
        Gallery.demoUploadDefaults.AddFile("raffle.xlsx", "", "");
        Gallery.demoUploadDefaults.AddFile("beef-sausage-bag.avif", "", "");
        Gallery.demoUploadDefaults.AddFile("two-tigers.mp3", "", "");
        Gallery.demoUploadThumbs = new Upload();
        Gallery.demoUploadThumbs.Multiple = true;
        Gallery.demoUploadThumbs.Thumbnail = true;
        string ph1 = Gallery.PhotoAsset("carousel1.jpeg");
        UploadFile th1 = Gallery.demoUploadThumbs.AddFile(
            "carousel1.jpeg", ph1, ph1);
        if (th1 != null) { th1.thumb = ph1; }
        UploadFile th2 = Gallery.demoUploadThumbs.AddFile("cat.mp4", "", "");
        th2.status = UploadStatus.Uploading();
        th2.percent = 56;
        Gallery.demoUploadThumbs.AddFile("two-tigers.mp3", "", "");

        // 自定义上传：CustomRequest 只把项标成 Uploading 就返回，
        // 进度与完成完全由「服务器」线程推进（mock 队列）。
        Gallery.demoUploadCustom = new Upload();
        Gallery.demoUploadCustom.WithCustomRequest(Gallery.MockUpload);
        Gallery.demoUploadCustom.Tip = Gallery.T(
            "CustomRequest takes over the transport; percent and finish come from the mock worker.",
            "CustomRequest 接管传输；进度与完成由 mock 线程推进。");

        // 受控的文件列表：宿主交出 List 引用，增删即时反映。
        Gallery.demoUploadCtlList = new List<UploadFile>();
        Gallery.demoUploadCtl = new Upload();
        Gallery.demoUploadCtl.Multiple = true;
        Gallery.demoUploadCtl.SetFiles(Gallery.demoUploadCtlList);
        Gallery.demoUploadCtl.Clear();
        Gallery.demoUploadCtl.AddFile("controlled-a.txt", "", "");
        Gallery.demoUploadAddSeq = 1;
        Gallery.demoUploadCtlAddBtn = new Button {
            Text = Gallery.T("Add file", "外部加一项") };
        Gallery.demoUploadCtlAddBtn.OnClick(() => {
            Gallery.demoUploadCtl.AddFile(
                "added-" + Convert.ToString(Gallery.demoUploadAddSeq) + ".txt",
                "", "");
            Gallery.demoUploadAddSeq = Gallery.demoUploadAddSeq + 1;
        });
        Gallery.demoUploadCtlClearBtn = new Button {
            Text = Gallery.T("Clear", "清空") };
        Gallery.demoUploadCtlClearBtn.OnClick(() => {
            Gallery.demoUploadCtl.Clear();
        });

        // 下载：Success 且有 url 的文件名呈链接色，点击触发 Download。
        Gallery.demoUploadDl = new Upload();
        Gallery.demoUploadDl.ShowDownloadButton = true;
        Gallery.demoUploadDlLabel = new Label("");
        Gallery.demoUploadDlLabel.Class = "secondary";
        UploadFile dl1 = Gallery.demoUploadDl.AddFile(
            "report.pdf", "", "https://example.com/report.pdf");
        UploadFile dl2 = Gallery.demoUploadDl.AddFile(
            "archive.zip", "", "https://example.com/archive.zip");
        Gallery.demoUploadDl.Download.Add(() => {
            Gallery.demoUploadDlLabel.Text = Gallery.T(
                "Download clicked: ", "点击下载：")
                + Gallery.demoUploadDl.LastItem.name;
        });

        // 限制上传文件：accept 白名单 + max 上限 + Exceed 事件。
        Gallery.demoUploadLimit = new Upload();
        Gallery.demoUploadLimit.Multiple = true;
        Gallery.demoUploadLimit.Accept = "png,jpg,jpeg,gif";
        Gallery.demoUploadLimit.Max = 3;
        Gallery.demoUploadLimit.Tip = Gallery.T(
            "accept: png/jpg/jpeg/gif · max: 3 · excess files fire Exceed.",
            "accept：png/jpg/jpeg/gif · max：3 · 超限触发 Exceed。");

        // 拖拽上传：整块虚线区，支持 OS 文件拖入。
        Gallery.demoUploadDrag = new Upload();
        Gallery.demoUploadDrag.Dragger = true;
        Gallery.demoUploadDrag.WithCustomRequest(Gallery.MockUpload);
        Gallery.demoUploadDrag.Multiple = true;

        // 照片墙：方格 + 「+」补位块，缩略图用画廊自带照片资产。
        Gallery.demoUploadWall = new Upload();
        Gallery.demoUploadWall.Multiple = true;
        Gallery.demoUploadWall.PictureCard = true;
        Gallery.demoUploadWall.WithCustomRequest(Gallery.MockUpload);
        List<string> wallNames = new List<string>{ "carousel1.jpeg", "carousel2.jpeg",
            "carousel3.jpeg", "carousel4.jpeg" };
        for (int wi = 0; wi < wallNames.Count; wi = wi + 1) {
            string wp = Gallery.PhotoAsset(wallNames[wi]);
            UploadFile wf = Gallery.demoUploadWall.AddFile(
                wallNames[wi], wp, wp);
            if (wf != null) { wf.thumb = wp; }
        }

        Gallery.demoUploads.Add(Gallery.demoUploadBasic);
        Gallery.demoUploads.Add(Gallery.demoUploadManual);
        Gallery.demoUploads.Add(Gallery.demoUploadCb);
        Gallery.demoUploads.Add(Gallery.demoUploadDefaults);
        Gallery.demoUploads.Add(Gallery.demoUploadThumbs);
        Gallery.demoUploads.Add(Gallery.demoUploadCustom);
        Gallery.demoUploads.Add(Gallery.demoUploadCtl);
        Gallery.demoUploads.Add(Gallery.demoUploadDl);
        Gallery.demoUploads.Add(Gallery.demoUploadLimit);
        Gallery.demoUploads.Add(Gallery.demoUploadDrag);
        Gallery.demoUploads.Add(Gallery.demoUploadWall);
    }

    static string UploadStateName(UploadFile f) {
        if (f.status == UploadStatus.Uploading()) {
            return Gallery.T("uploading", "上传中");
        }
        if (f.status == UploadStatus.Success()) { return Gallery.T("success", "成功"); }
        if (f.status == UploadStatus.Error()) { return Gallery.T("error", "失败"); }
        return Gallery.T("pending", "待上传");
    }

    // ---- Upload 演示的 mock 传输 ------------------------------------------

    /// CustomRequest 入口（静态方法组）：项已被组件标成 Uploading，
    /// 这里只入队交给后台 worker。
    static void MockUpload(UploadFile item) {
        MockUploadJob j = new MockUploadJob();
        j.host = item.owner;
        j.itemId = item.id;
        j.pct = 0;
        j.done = false;
        Mutex.Lock(Gallery.demoMockLock);
        Gallery.demoMockPending.Add(j);
        bool need = !Gallery.demoMockWorker;
        Gallery.demoMockWorker = true;
        Mutex.Unlock(Gallery.demoMockLock);
        if (need) { Thread.Start(Gallery.MockUploadWorker); }
    }

    /// 后台线程入口（静态方法组，A70）：逐条推进 mock 任务直到全部
    /// 完成，然后退场复位标志（ImageHttp/UploadJob 同款队列范式）。
    static void MockUploadWorker() {
        while (true) {
            MockUploadJob job = Gallery.MockUploadNext();
            if (job == null) {
                bool empty = true;
                Mutex.Lock(Gallery.demoMockLock);
                int i = 0;
                while (i < Gallery.demoMockPending.Count) {
                    if (!Gallery.demoMockPending[i].done) { empty = false; break; }
                    i = i + 1;
                }
                if (empty) {
                    Gallery.demoMockWorker = false;
                    Mutex.Unlock(Gallery.demoMockLock);
                    return;
                }
                Mutex.Unlock(Gallery.demoMockLock);
                Thread.Sleep(30);
                continue;
            }
            Thread.Sleep(150);
            job.pct = job.pct + 9;
            if (job.pct >= 100) {
                job.pct = 100;
                job.done = true;
                if (job.host != null && job.host.uiApp != null) {
                    job.host.uiApp.Post(job.Done);
                }
            } else {
                if (job.host != null && job.host.uiApp != null) {
                    job.host.uiApp.Post(job.Tick);
                }
            }
        }
    }

    static MockUploadJob MockUploadNext() {
        MockUploadJob job = null;
        Mutex.Lock(Gallery.demoMockLock);
        int i = 0;
        while (i < Gallery.demoMockPending.Count) {
            if (!Gallery.demoMockPending[i].done) {
                job = Gallery.demoMockPending[i];
                break;
            }
            i = i + 1;
        }
        Mutex.Unlock(Gallery.demoMockLock);
        return job;
    }

    // ---- 主泵对 Upload 内建弹窗的路由（与 filePicker 同款三段式） --------

    static bool AnyUploadDialogOpen() {
        if (Gallery.demoUploads == null) { return false; }
        int i = 0;
        while (i < Gallery.demoUploads.Count) {
            if (Gallery.demoUploads[i].DialogOpen()) { return true; }
            i = i + 1;
        }
        return false;
    }

    static bool AnyUploadDialogRedraw() {
        if (Gallery.demoUploads == null) { return false; }
        int i = 0;
        while (i < Gallery.demoUploads.Count) {
            if (Gallery.demoUploads[i].DialogNeedsRedraw()) { return true; }
            i = i + 1;
        }
        return false;
    }

    static bool UploadOwnsWindow(nint evh) {
        if (Gallery.demoUploads == null) { return false; }
        int i = 0;
        while (i < Gallery.demoUploads.Count) {
            if (Gallery.demoUploads[i].OwnsEventWindow(evh)) { return true; }
            i = i + 1;
        }
        return false;
    }

    static void UploadApplyEvent(nint evh) {
        if (Gallery.demoUploads == null) { return; }
        int i = 0;
        while (i < Gallery.demoUploads.Count) {
            if (Gallery.demoUploads[i].ApplyEventWindow(evh)) { return; }
            i = i + 1;
        }
    }

    /// 每圈渲染所有开着的 Upload 弹窗并收结果；有弹窗刚关闭
    /// 返回 true（宿主据此重新激活主窗口，与 filePicker 同款处理）。
    static bool RenderUploadDialogs() {
        bool closed = false;
        if (Gallery.demoUploads == null) { return false; }
        int i = 0;
        while (i < Gallery.demoUploads.Count) {
            Upload u = Gallery.demoUploads[i];
            if (u.DialogOpen()) { u.RenderDialog(); }
            // 收结果不问开合：关闭那一刻 IsOpen 已是 false，
            // 只在开着时收会把选中路径永远漏掉（filePicker 同款语义）。
            if (u.TakeDialogResult() != 0) { closed = true; }
            i = i + 1;
        }
        return closed;
    }

    /// 立即模式的演示（直接把内容 Draw/Render 到算好的坐标上，没有控件树
    /// 可量）报告自己内容的底边，框高就跟着内容走，与 LayoutAuto 共用同一
    /// 个缓存 —— 只是高度由演示自己算，而不是由控件树量出来。
    ///
    /// 注册处那个手调的 previewH 之所以总有一边不对，是因为同一个数字要
    /// 同时伺候宽窗口和窄窗口两种排布结果：窄了内容换行就被裁掉，宽了就
    /// 空出一大片。
    static void RecordBottom(App app, string name, int bottomY) {
        Gallery.RecordAuto(app, name, bottomY - Gallery.previewBoxTop);
    }

    /// 说明小字。用 `label.caption` 而不是 DrawText + textTertiary：
    /// 这样它是控件树的一员，能被测量、能跟着 CSS 换肤。
    static Control Caption(string text) {
        return new Label { Text = text, Class = "caption" };
    }

    /// 把一棵子树和它下面的说明小字装进一列。说明文字参与测量，
    /// 框高才能把它算进去 —— 原先那些 `py + 84` 之类的手算偏移就
    /// 不需要了。返回的还是这一列，需要第二行说明时接着
    /// `.With(Gallery.Caption(...))`。
    static Panel Captioned(App app, Control body, string caption) {
        Panel col = Panel.Column().Gap(app.Scale(8));
        col.With(body);
        col.With(Gallery.Caption(caption));
        return col;
    }

    /// 一个字段行加一行说明小字，整棵树都能被测量。
    static Control FieldWithCaption(App app, string label, Control field,
                                    string caption) {
        Flex row = Flex.Wrapped().Gap(app.Scale(10));
        row.With(new Label { Text = label });
        row.With(field);
        return Gallery.Captioned(app, row, caption);
    }

    // ---- Image 演示的共享数据 ------------------------------------------
    // 全部在程序内合成，离线可复现，不依赖仓库里的任何图片资源。

    // 程序内合成的一张 64x40 RGB 渐变（PNM P6），构建一次后缓存：
    // base64 数据 URI 演示与本地 HttpServer 演示共用同一份字节。
    static byte[] imageDemoPnm;
    static int imageDemoPnmLen;
    static string imageDemoB64;
    static bool imageServerStarted;

    static byte[] PnmBytes() {
        if (Gallery.imageDemoPnm != null) { return Gallery.imageDemoPnm; }
        int w = 64;
        int h = 40;
        string header = "P6\n" + w + " " + h + "\n255\n";
        int hl = header.Length;
        byte[] all = new byte[hl + w * h * 3];
        for (int i = 0; i < hl; i = i + 1) { all[i] = (byte)(header[i] & 255); }
        int o = hl;
        for (int y = 0; y < h; y = y + 1) {
            for (int x = 0; x < w; x = x + 1) {
                all[o] = (byte)(40 + x * 3);
                all[o + 1] = (byte)(30 + y * 4);
                all[o + 2] = (byte)(120 + (x + y) * 3 % 120);
                o = o + 3;
            }
        }
        Gallery.imageDemoPnm = all;
        Gallery.imageDemoPnmLen = o;
        return all;
    }

    static string DataUriPnm() {
        if (Gallery.imageDemoB64 != null) { return Gallery.imageDemoB64; }
        string raw = Gallery.PnmBytes().ToStr(0, Gallery.imageDemoPnmLen);
        Gallery.imageDemoB64 = "data:image/x-portable-anymap;base64,"
            + Base64.Encode(raw, Gallery.imageDemoPnmLen);
        return Gallery.imageDemoB64;
    }

    static string SvgDataUri() {
        return "data:image/svg+xml,"
            + "<svg xmlns='http://www.w3.org/2000/svg' width='72' height='48'>"
            + "<rect width='72' height='48' rx='10' fill='#2b6cb0'/>"
            + "<circle cx='24' cy='24' r='12' fill='#f6ad55'/>"
            + "<rect x='44' y='12' width='16' height='24' fill='#68d391'/>"
            + "</svg>";
    }

    // 真实照片（600x415 JPEG，naive-ui 轮播图，assets/carousel1.jpeg）：
    // 按运行目录探测仓库内路径，找不到时照片演示回退到合成渐变。
    static string PhotoPath() {
        return Gallery.PhotoAsset("carousel1.jpeg");
    }

    /// gallery 自带照片资产（naive-ui 轮播示例图 carousel1-4.jpeg）。
    /// 按运行目录的三种可能深度探测，找不到返回空串，演示回退到
    /// base64 占位图。照片以路径喂给 Image/Upload（要有真实文件句柄），
    /// 所以不走内嵌副本 —— 纯文本资产才经 DataText 的内嵌回退链路。
    static string PhotoAsset(string name) {
        List<string> candidates = new List<string>{
            "examples/gui_gallery/assets/" + name,
            "../examples/gui_gallery/assets/" + name,
            "assets/" + name };
        for (int i = 0; i < candidates.Count; i = i + 1) {
            if (File.Exists(candidates[i])) { return candidates[i]; }
        }
        return "";
    }

    /// echarts@4.9 官方 china.json（assets/，构建 --embed 烤进 exe）经
    /// ChartGeoJson 运行时解码；值按省名确定性散列到 10..800（map1
    /// 参考站的销量本就是虚构数）。
    static List<ChartMapRegion> chinaRegions;
    static List<ChartMapRegion> ChinaRegions() {
        if (Gallery.chinaRegions != null) { return Gallery.chinaRegions; }
        List<ChartMapRegion> rs = ChartGeoJson.ParseText(Gallery.DataText("china.json"));
        for (int i = 0; i < rs.Count; i = i + 1) {
            rs[i].value = 10 + Gallery.NameValue(rs[i].name) % 791;
        }
        Gallery.chinaRegions = rs;
        return rs;
    }

    /// 读 assets/<name>：先盘上（gallery 惯例的三级候选路径），没有再
    /// 查 --embed 内嵌副本。都没有返回空串（demo 呈现空地图而非崩溃）。
    static string DataText(string name) {
        List<string> candidates = new List<string>{
            "examples/gui_gallery/assets/" + name,
            "../examples/gui_gallery/assets/" + name,
            "assets/" + name };
        for (int i = 0; i < candidates.Count; i = i + 1) {
            if (File.Exists(candidates[i]) || File.EmbedExists(candidates[i])) {
                return File.ReadAllText(candidates[i]);
            }
        }
        return "";
    }

    /// 字符串 → 确定性散列（与 gui_charts 的 Charts.NameValue 同源）。
    static int NameValue(string name) {
        int h = 7;
        for (int i = 0; i < name.Length; i = i + 1) {
            h = (h * 31 + (name[i] & 255)) % 2147483647;
        }
        return h;
    }

    /// 四张示例照片里实际存在的那些（缺资产的跳过）。
    static List<string> PhotoSet() {
        List<string> all = new List<string>{
            "carousel1.jpeg", "carousel2.jpeg",
            "carousel3.jpeg", "carousel4.jpeg" };
        List<string> found = new List<string>();
        for (int i = 0; i < all.Count; i = i + 1) {
            string p = Gallery.PhotoAsset(all[i]);
            if (p != "") { found.Add(p); }
        }
        if (found.Count == 0) { found.Add(Gallery.DataUriPnm()); }
        return found;
    }

    // URL 演示的本地回环服务（127.0.0.1:18747）。首次进入演示时启动；
    // 端口被占用时该演示只剩 Error 占位，不影响其它演示。
    static void EnsureImageServer() {
        if (Gallery.imageServerStarted) { return; }
        Gallery.imageServerStarted = true;
        Thread.Start(Gallery.ImageServerLoop);
    }

    // 工作线程里驱动 HttpServer 的协程调度（DownloadJob 的
    // Thread.Start + await 写法：worker 线程自带调度器）。
    static void ImageServerLoop() {
        Socket.Initialize();
        HttpServer server = new HttpServer("127.0.0.1", 18747);
        server.OnRequest(Gallery.ImageServerHandle);
        Task.Spawn(server.Start());
        while (true) { await Task.Delay(1000); }
    }

    static async HttpResponse ImageServerHandle(HttpRequest req) {
        if (req.path == "/img.pnm") {
            return HttpResponse.Bytes(Gallery.PnmBytes(),
                                      Gallery.imageDemoPnmLen,
                                      "image/x-portable-anymap");
        }
        if (req.path == "/photo.jpeg") {
            string p = Gallery.PhotoPath();
            if (p != "") {
                byte[] bytes = File.ReadAllBytes(p);
                return HttpResponse.Bytes(bytes, bytes.Length, "image/jpeg");
            }
        }
        return HttpResponse.NotFound();
    }

    /// 上一帧为 `name` 量到的内容底边偏移（设备像素，自框顶算起），
    /// 没有或卡片宽度已变则返回 0（调用方回退到种子高度）。
    /// `cardW` 是预览卡的宽度，也就是 PreviewBoxH 拿到的那个 w。
    static int AutoContentH(string name, int cardW) {
        if (Gallery.autoH == null) { return 0; }
        if (!Gallery.autoH.ContainsKey(name)) { return 0; }
        if (Gallery.autoW[name] != cardW) { return 0; }
        return Gallery.autoH[name];
    }

    /// 把演示从「实测高度」体系里除名：PreviewBoxH 从此永远用它的种子
    /// 高度，覆盖通道的迟到记录被 RecordAuto 丢弃。弹层类演示专用 ——
    /// 它们的框高一旦被滚动中途改写，以下内容整体平移就是滚动跳跃。
    static void SuppressAuto(string name) {
        if (Gallery.autoH != null && Gallery.autoH.ContainsKey(name)) {
            Gallery.autoH.Remove(name);
            Gallery.autoW.Remove(name);
        }
        if (Gallery.autoSuppressed == null) {
            Gallery.autoSuppressed = new Dictionary<string, bool>();
        }
        if (!Gallery.autoSuppressed.ContainsKey(name)) {
            Gallery.autoSuppressed.Add(name, true);
        }
    }

    /// 记下这一帧量到的内容高度。与上一帧不同就请求重绘：卡片高度
    /// 已经按旧值排过了，得再来一帧才能对上。
    ///
    /// 失效键用的是「当前预览卡的宽度」（RenderPreview 存下的
    /// previewCardW），而不是调用方传给 LayoutAuto 的那个内容宽度。
    /// 后者各演示写法不一（`w - Scale(36)`、`Scale(360)`、`Scale(400)`…），
    /// 一旦不等于 PreviewBoxH 回读时用的值，实测高度就永远读不到，
    /// 于是那个演示不声不响退回注册处的手调高度 —— Input.disabled /
    /// Input.error 正是这样明明写了 LayoutAuto 却仍在用固定高度。
    ///
    /// 返回 1 表示本帧接受了新高度（调用方要重排），0 表示维持旧值。
    static int RecordAuto(App app, string name, int h) {
        // 被 SuppressAuto 除名的演示（弹层类）：内容在覆盖通道才画，
        // 这里迟到的高度报告一律丢弃，否则框高在滚动中途改写会把该卡
        // 以下的内容整体平移，用户感知为「滚轮一滚页面跳一下」。
        if (Gallery.autoSuppressed != null && Gallery.autoSuppressed.ContainsKey(name)) {
            return 0;
        }
        if (Gallery.autoH == null) {
            Gallery.autoH = new Dictionary<string, int>();
            Gallery.autoW = new Dictionary<string, int>();
        }
        int cardW = Gallery.previewCardW;
        bool have = Gallery.autoH.ContainsKey(name);
        if (have && Gallery.autoH[name] == h && Gallery.autoW[name] == cardW) {
            return 0;
        }
        // 已有实测值时的新值若与旧值同代（相差 <= 缩放后的两像素），视为
        // 同一内容在不同帧的舍入抖动，保持旧值：滚动中卡片高度改写会把
        // 该卡以下的所有内容整体平移，用户感知为「滚轮滚动时页面跳跃」
        // （实测 +7px/次，来自弹层类演示迟到两帧才报高度）。整档高差
        // （换行数变化、内容真的变了）仍然照常接受。
        if (have) {
            int d = h - Gallery.autoH[name];
            if (d < 0) { d = 0 - d; }
            if (d <= app.Scale(2)) {
                Gallery.autoW.Remove(name);
                Gallery.autoW.Add(name, cardW);
                return 0;
            }
        }
        if (have) {
            Gallery.autoH.Remove(name);
            Gallery.autoW.Remove(name);
        }
        Gallery.autoH.Add(name, h);
        Gallery.autoW.Add(name, cardW);
        app.RequestRedraw();
        return 1;
    }

    /// 遍历演示的整棵控件树，把「刚才谁被按了 / 哪个值变了」报到卡片
    /// 头部。这样每个走 LayoutAuto 的演示都自动带上事件反馈，不必逐个
    /// 接线：
    ///   * 主动作用 Control.FiredIn()（Click 的轮询版）；
    ///   * 状态变化比对 Props() —— 设计器和序列化器读的是同一份声明，
    ///     所以任何声明了属性的控件都自动被覆盖。
    ///
    /// 只在真实输入帧（按下/松开/按键/滚轮，不含纯移动与动画帧）上报：
    /// HMI 各页的位号每 60ms 就变一次，那不是用户事件，逐帧报出来只会
    /// 把真正的交互刷掉。基线仍然每帧更新，否则动画期间攒下的变化会在
    /// 下一次点击时一股脑冒出来。
    static void ReportTree(App app, string demo, Control root) {
        int k = app.EventKind();
        bool live = k != 0 && k != 1;
        Control hit = root.FiredIn();
        if (hit != null) {
            string label = hit.GetProp("label");
            if (label == "") { label = hit.GetProp("icon"); }
            if (label == "") { label = hit.Kind(); }
            Gallery.FiredN(app, demo, label + " clicked");
        }
        Gallery.watchSeq = 0;
        Gallery.WatchTree(app, demo, root, live);
    }

    static void WatchTree(App app, string demo, Control c, bool live) {
        Gallery.watchSeq = Gallery.watchSeq + 1;
        string id = Convert.ToString(Gallery.watchSeq);
        List<PropSpec> ps = c.Props();
        for (int i = 0; i < ps.Count; i = i + 1) {
            PropSpec p = ps[i];
            if (p.kind == 5 || !p.IsBound()) { continue; }
            string key = demo + "/" + id + "/" + p.key;
            string val = p.Read();
            if (!Gallery.watch.ContainsKey(key)) {
                Gallery.watch.Add(key, val);
                continue;
            }
            if (Gallery.watch[key] == val) { continue; }
            Gallery.watch.Remove(key);
            Gallery.watch.Add(key, val);
            if (live) {
                Gallery.Fired(app, demo,
                    c.Kind() + "." + p.key + " = " + Gallery.Short(val));
            }
        }
        for (int j = 0; j < c.children.Count; j = j + 1) {
            Gallery.WatchTree(app, demo, c.children[j], live);
        }
    }

    /// 事件文字里的值截断：多行文本域或长文本一整段贴上去会把
    /// 卡片头部撑爆。
    static string Short(string v) {
        if (v.Length <= 24) { return v; }
        return v.Substring(0, 24) + "...";
    }

    /// 演示的事件处理器报告「刚刚发生了什么」：文字画在该卡片
    /// "LIVE STATES" 行的右端，读者按一下就能确认事件真的通了。
    static void Fired(App app, string demo, string text) {
        if (Gallery.lastEvent.ContainsKey(demo)) {
            if (Gallery.lastEvent[demo] == text) { return; }
            Gallery.lastEvent.Remove(demo);
        }
        Gallery.lastEvent.Add(demo, text);
        app.RequestRedraw();
    }

    /// 同上，但把该演示的触发次数一起报出来（"Primary clicked x3"）：
    /// 连按同一个按钮时文字不变，没有计数就看不出后面几次通没通。
    static void FiredN(App app, string demo, string label) {
        int n = 1;
        if (Gallery.eventN.ContainsKey(demo)) {
            n = Gallery.eventN[demo] + 1;
            Gallery.eventN.Remove(demo);
        }
        Gallery.eventN.Add(demo, n);
        Gallery.Fired(app, demo, label + " x" + Convert.ToString(n));
    }

    /// 弹层类演示的一条说明小字，画在触发器下面并报告框高。
    ///
    /// 这些演示走立即模式（不进控件树 —— 弹层的锚点是触发器的屏幕位置，
    /// 交给容器排版会让它每帧漂移），所以说明文字只能画，高度也得自己报。
    /// 放在触发器右边看着省地方，但窄窗口下它就直接被卡片裁掉了。
    static void SelCaption(App app, string demo, int x, int y, string text) {
        int fs = app.theme.fontSizeSmall;
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary", Style.SNormal()),
            x, y, text, app.theme.textSecondary, fs);
        Gallery.RecordBottom(app, demo, y + Canvas.FontHeight(fs));
    }

    /// 弹层演示预览框内的说明行。弹层通道跑在滚动视口裁剪弹出之后
    /// （弹窗要能浮到代码面板上方），这里的绘制不再受任何裁剪约束，
    /// 长文字会一路画出卡片、直到窗口右缘——所以按卡片内宽用
    /// Ellipsis.Fit 截断，静态文字永远留在框内，弹窗照常浮出。
    static void BoxCaption(App app, int x, int y, int w, string text, int fs) {
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "secondary", Style.SNormal()),
            x, y, Ellipsis.Fit(text, w, fs), app.theme.textPrimary, fs);
    }

    /// 把下拉框当前的选择报到卡片头部：一个只能点开、点完什么都不说的
    /// 下拉框，读者判断不出事件到底通没通。
    static void SelReport(App app, string demo, SelectBox sel) {
        string txt = sel.Text();
        if (txt == "") {
            Gallery.Fired(app, demo,
                Gallery.T("(nothing selected)", "（未选择）"));
            return;
        }
        Gallery.Fired(app, demo, "Selected: " + txt);
    }

    // ---- Dropdown（动作菜单）演示的事件 ----

    /// 基础用法：选中即执行动作。执行完 Clear()，触发器回到提示语——
    /// 它是命令菜单，不像 SelectBox 那样把选中值留在触发器上。
    static void OnDropdownBook() {
        string pick = Gallery.demoDropdownAct.Selected();
        Gallery.demoDropdownAct.Clear();
        string msg = Gallery.T("Booked: " + pick, "已预订：" + pick);
        Gallery.Fired(Gallery.app, "Dropdown", msg);
        Layer.Msg(msg, 3);
    }

    /// 命令菜单：执行所选动作并报到卡片头部。
    static void OnDropdownRun() {
        string act = Gallery.demoDropdownManual.Selected();
        Gallery.demoDropdownManual.Clear();
        Gallery.Fired(Gallery.app, "Dropdown",
            Gallery.T("Ran: " + act, "已执行：" + act));
    }

    static void OnDropdownOpened() {
        Gallery.Fired(Gallery.app, "Dropdown",
            Gallery.T("menu opened", "菜单打开"));
    }

    static void OnDropdownClosed() {
        Gallery.Fired(Gallery.app, "Dropdown",
            Gallery.T("menu closed", "菜单关闭"));
    }

    /// 多级菜单：BindMenu 模式下命中叶子的 action 经 Action() 读取；
    /// Clear() 让触发器回到提示语（动作菜单不保留选中值）。
    static void OnDropdownTree() {
        int act = Gallery.demoDropdownTree.Action();
        Gallery.demoDropdownTree.Clear();
        string msg = "";
        if (act == 1) {
            msg = Gallery.T("Renamed", "已重命名");
        } else if (act == 2) {
            msg = Gallery.T("Path copied", "路径已复制");
        } else if (act == 31) {
            msg = "PNG " + Gallery.T("exported", "已导出");
        } else if (act == 32) {
            msg = "SVG " + Gallery.T("exported", "已导出");
        } else if (act == 33) {
            msg = "PDF " + Gallery.T("exported", "已导出");
        }
        if (msg != "") {
            Gallery.Fired(Gallery.app, "Dropdown", msg);
            Layer.Msg(msg, 3);
        }
    }

    /// 演示用按钮：建出来就登记，接线交给 ReportClicks 统一做。
    static Button Btn(string text, string cls) {
        Button b = new Button { Text = text, Class = cls };
        Gallery.demoBtns.Add(b);
        return b;
    }

    /// 图标按钮（无文字），事件里报图标名。
    static Button IconBtn(string icon, string cls) {
        Button b = new Button { Icon = icon, Class = cls };
        Gallery.demoBtns.Add(b);
        return b;
    }

    /// 登记过的按钮里谁被按了就报到卡片头部。WasClicked 是 Button.Click
    /// 的轮询版本，因此每帧重建的演示也不必保留处理器。
    static void ReportClicks(App app, string demo) {
        for (int i = 0; i < Gallery.demoBtns.Count; i = i + 1) {
            Button b = Gallery.demoBtns[i];
            if (!b.WasClicked()) { continue; }
            string label = b.Text.Get();
            if (label == "") { label = b.Icon; }
            Gallery.FiredN(app, demo, label + " clicked");
        }
    }

    static void DrawLastEvent(App app, Canvas c, Theme t, string demo,
            int x, int y, int w) {
        if (!Gallery.lastEvent.ContainsKey(demo)) { return; }
        string msg = Gallery.lastEvent[demo];
        if (msg == "") { return; }
        int fs = t.fontSizeSmall;
        int avail = w - app.Scale(120);
        if (avail < app.Scale(60)) { return; }
        msg = Ellipsis.Fit(msg, avail, fs);
        int tw = Canvas.MeasureText(msg, fs);
        c.DrawText(x + w - app.Scale(12) - tw, y + app.Scale(9), msg,
                   t.primary, fs);
    }

    // ---- Menu v2 树形菜单演示：批量渲染钩子 ----------------------------
    // 三个静态方法对齐 layui 的 render-label / render-icon / expand-icon，
    // 在调用点以方法组传给 Menu.RenderTree。委托不能捕获局部变量，故逐行
    // 上下文全从 MenuItem 参数里取（label/icon/key）。
    static string MenuDemoLabel(MenuItem m) {
        // 书签组统一在标签后追加「· 未读」，演示 render-label 批量改写。
        if (m.icon == "bookmark") { return m.label + "  · 未读"; }
        return m.label;
    }

    static string MenuDemoIcon(MenuItem m) {
        // 所有书签行统一画成 star，演示 render-icon 批量换图。
        if (m.icon == "bookmark") { return "star"; }
        return m.icon;
    }

    static string MenuDemoExpand(MenuItem m, bool expanded) {
        // 文件夹箭头：展开用 folder-open，收起用 folder。
        if (expanded) { return "folder-open"; }
        return "folder";
    }

    static MenuItem MenuLeaf2(string label, string icon) {
        return MenuItem.Item(label, icon, 0);
    }

    /// 「批量渲染钩子」卡的数据树：三枚书签 + 一个子菜单（弹珠玩具），
    /// 书签 icon=bookmark 被 render-icon 批量换成 star、被 render-label 加后缀。
    static List<MenuItem> MenuBookmarkTree() {
        List<MenuItem> kids = new List<MenuItem>();
        kids.Add(Gallery.MenuLeaf2("且听风吟", "bookmark"));
        kids.Add(Gallery.MenuLeaf2("1973年的弹珠玩具", "bookmark"));
        List<MenuItem> items = new List<MenuItem>();
        items.Add(Gallery.MenuLeaf2("寻羊冒险记", "bookmark"));
        MenuItem sub = MenuItem.Submenu("舞，舞，舞", "bookmark", kids);
        items.Add(sub);
        return items;
    }

    /// 「展开子菜单」卡的三层树：人物/饮品/食物 + 一个深层禁用项，
    /// 不设 defaultExpandedKeys，靠选中项「三明治」自动展开其父链。
    static List<MenuItem> MenuCharTree() {
        List<MenuItem> persons = new List<MenuItem>();
        persons.Add(Gallery.MenuLeaf2("叙事者", "user"));
        persons.Add(Gallery.MenuLeaf2("羊男", "user"));
        persons.Add(MenuItem.Disabled("绝版", "user", 0));
        List<MenuItem> drinks = new List<MenuItem>();
        drinks.Add(Gallery.MenuLeaf2("鸡尾酒", "heart"));
        List<MenuItem> foods = new List<MenuItem>();
        foods.Add(Gallery.MenuLeaf2("三明治", "heart"));
        List<MenuItem> root = new List<MenuItem>();
        root.Add(MenuItem.Header("舞，舞，舞"));
        root.Add(MenuItem.Submenu("人物", "user", persons));
        root.Add(MenuItem.Submenu("饮品", "heart", drinks));
        root.Add(MenuItem.Submenu("食物", "heart", foods));
        root.Add(Gallery.MenuLeaf2("过去增多，未来减少", "file"));
        return root;
    }

    /// measureOnly=false 的常规入口：画框、跑演示、量高度一步到位。
    static int RenderPreview(App app, Canvas c, Theme t, string name,
            int x, int y, int w, int previewHUnscaled) {
        return Gallery.RenderPreviewEx(app, c, t, name, x, y, w,
            previewHUnscaled, false);
    }

    /// measureOnly：开页预量专用 —— 跳过框体/玻璃模糊/LIVE STATES 等纯
    /// 装饰（玻璃模糊不理裁剪区，画到视口外的卡上会把糊块抹进页眉），
    /// 只跑演示分支里的测量与记录。视口裁剪仍然兜底，看不见任何像素。
    static int RenderPreviewEx(App app, Canvas c, Theme t, string name,
            int x, int y, int w, int previewHUnscaled, bool measureOnly) {
        // 把这一段的耗时和「凭什么整窗重绘」都记到演示名下（ZAN_FRAME_PROF
        // 关着时是空操作）。整窗帧比损伤帧贵十几倍，出问题时得能指名道姓
        // 地问是哪个演示要的。
        app.PerfMark(name);
        Gallery.demoBtns.Clear();
        int h = Gallery.PreviewBoxH(app, name, previewHUnscaled, w);
        if (!measureOnly) {
            if (t.glass != 0) {
                // Real frosted glass: blur the wallpaper behind the box (clamped to
                // the scroll viewport so it never smears the fixed header), then a
                // light translucent tint + white frost veil + top sheen + rim.
                int by = y;
                int bh = h;
                if (by < Gallery.detailClipTop) {
                    bh = bh - (Gallery.detailClipTop - by);
                    by = Gallery.detailClipTop;
                }
                if (by + bh > Gallery.detailClipBottom) {
                    bh = Gallery.detailClipBottom - by;
                }
                if (bh > 0) {
                    c.BlurRectCached(x, by, w, bh, app.Scale(22),
                        app.NextBlurSlot(), app.BackdropDirty());
                }
                c.FillRoundRect(x, y, w, h, app.Scale(6), Style.Fade(t.bgSecondary, 300));
                c.FillRoundRect(x, y, w, h, app.Scale(6), Style.Fade(t.textPrimary, 40));
                c.FillRoundRect(x, y, w, app.Scale(2), app.Scale(6),
                                Style.Fade(t.textPrimary, 140));
                c.DrawRect(x, y, w, h, Style.Fade(t.textPrimary, 85), 1);
            } else {
                c.FillRoundRect(x, y, w, h, app.Scale(6), t.bgSecondary);
                c.DrawRect(x, y, w, h, t.borderPrimary, 1);
            }
            c.DrawText(x + app.Scale(12), y + app.Scale(9), "LIVE STATES",
                t.textTertiary, t.fontSizeSmall);
            Gallery.DrawLastEvent(app, c, t, name, x, y, w);
        }
        // 实测高度的两个基准（框顶、卡片宽度）在这里就位，好让延迟到
        // 覆盖通道去画的演示也能报自己的高度。
        Gallery.previewBoxTop = y;
        Gallery.previewCardW = w;
        // Floating/interactive components are drawn later in the deferred
        // overlay pass (above the code panel); the base pass only frames them.
        if (Gallery.IsOverlayComp(name)) {
            // 弹层类卡片高度提前定死：内容在覆盖通道才画，那里的
            // SelCaption 等会把「说明行底边」迟到两帧才报到 autoH，
            // 卡片滚进视口的瞬间框高 180→187、以下全部内容被推移，
            // 用户看到「滚轮一滚页面跳一下」。框高一律用种子值
            // Scale(previewH)，不再被覆盖通道的迟到记录改写。
            Gallery.SuppressAuto(name);
            if (!measureOnly) { Gallery.Audit(app, name, x, y, w, h, true); }
            return h;
        }
        // Clip every base demo to the preview box so nothing bleeds into the
        // title, description or the code panel below (fixes the overflow and
        // scroll "see-through" artifacts).
        c.PushClip(x, y, w, h);
        int px = x + app.Scale(18);
        int py = y + app.Scale(48);
        bool rendered = true;
        if (name == "Button.types") {
            // Flex.Wrapped(): 六个按钮在窄窗口里折行而不是被裁掉，卡片
            // 高度由 LayoutAuto 量出来跟着长——这是所有按钮行的样板。
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(Gallery.Btn("Default", ""));
            row.With(Gallery.Btn("Primary", "primary"));
            row.With(Gallery.Btn("Info", "info"));
            row.With(Gallery.Btn("Success", "success"));
            row.With(Gallery.Btn("Warning", "warning"));
            row.With(Gallery.Btn("Error", "error"));
            Gallery.LayoutAuto(app, row, name, px, y + Gallery.PreviewPadTop(app),
                               w - app.Scale(36), app.Scale(34));
            Gallery.ReportClicks(app, name);
        } else if (name == "Button.styles") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(Gallery.Btn("Solid", "primary"));
            row.With(Gallery.Btn("Outline", "primary outline"));
            row.With(Gallery.Btn("Text", "primary text"));
            row.With(Gallery.Btn("Dashed", "primary dashed"));
            row.With(Gallery.Btn("Secondary", "primary secondary"));
            row.With(Gallery.Btn("Ghost", "primary ghost"));
            Gallery.LayoutAuto(app, row, name, px, y + Gallery.PreviewPadTop(app),
                               w - app.Scale(36), app.Scale(34));
            Gallery.ReportClicks(app, name);
        } else if (name == "Button.specular") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(Gallery.Btn("Hover me", "primary specular"));
            row.With(Gallery.Btn("Success", "success specular"));
            row.With(Gallery.Btn("Error", "error specular"));
            row.With(Gallery.Btn("Default", "specular"));
            Gallery.LayoutAuto(app, row, name, px, y + Gallery.PreviewPadTop(app),
                               w - app.Scale(36), app.Scale(34));
            Gallery.ReportClicks(app, name);
        } else if (name == "Button.secondary") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(Gallery.Btn("Default", "secondary"));
            row.With(Gallery.Btn("Primary", "primary secondary"));
            row.With(Gallery.Btn("Info", "info secondary"));
            row.With(Gallery.Btn("Success", "success secondary"));
            row.With(Gallery.Btn("Warning", "warning secondary"));
            row.With(Gallery.Btn("Error", "error secondary"));
            Gallery.LayoutAuto(app, row, name, px, y + Gallery.PreviewPadTop(app),
                               w - app.Scale(36), app.Scale(34));
            Gallery.ReportClicks(app, name);
        } else if (name == "Button.states") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Button { Text = "Loading", Class = "primary loading" });
            Button bldg = new Button { Class = "success loading" };
            bldg.Class = bldg.Class + " circle";
            row.With(bldg);
            Button bdis = new Button { Text = "Disabled" };
            bdis.Disabled = true;
            row.With(bdis);
            row.With(Gallery.Btn("Pink", "pink"));
            row.With(Gallery.Btn("Teal", "teal"));
            Gallery.LayoutAuto(app, row, name, px, y + app.Scale(34), w - app.Scale(36), app.Scale(34));
            // loading / disabled 的按钮不派发 Click（Button.RenderIn 在
            // Ui.Activate 之前就返回了），所以这一排只有后两个会报事件
            // —— 这正是本演示要说明的行为。
            Gallery.ReportClicks(app, name);
        } else if (name == "Button.shapes") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(Gallery.Btn("Round", "primary round"));
            Button bsave = Gallery.Btn("Save", "success");
            bsave.Icon = "save";
            row.With(bsave);
            row.With(Gallery.IconBtn("plus", "primary circle"));
            row.With(Gallery.IconBtn("settings", "circle"));
            Gallery.LayoutAuto(app, row, name, px, y + app.Scale(34), w - app.Scale(36), app.Scale(34));
            Gallery.ReportClicks(app, name);
        } else if (name == "Button.sizes") {
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(Gallery.Btn("Tiny", "tiny"));
            row.With(Gallery.Btn("Small", "small"));
            row.With(Gallery.Btn("Medium", "medium"));
            row.With(Gallery.Btn("Large", "large"));
            Gallery.LayoutAuto(app, row, name, px, y + app.Scale(34), w - app.Scale(36), app.Scale(40));
            Gallery.ReportClicks(app, name);
        } else if (name == "Button.group") {
            int cur = y + app.Scale(34);
            ButtonGroup g1 = new ButtonGroup(1);
            g1.Add("Left"); g1.Add("Middle"); g1.Add("Right");
            g1.Render(app, px, cur);
            ButtonGroup g2 = new ButtonGroup(2).Outline(true);
            g2.Add("Day"); g2.Add("Week"); g2.Add("Month"); g2.Add("Year");
            g2.Render(app, px + app.Scale(240), cur);
        } else if (name == "Icon") {
            List<string> icons = Icon.Names();
            int cell = app.Scale(62);
            int iconSz = app.Scale(22);
            int gcols = (w - app.Scale(24)) / cell;
            if (gcols < 1) { gcols = 1; }
            bool iconClick = app.window.EventKind() == 3;
            int gx0 = x + app.Scale(12);
            int gy0 = y + app.Scale(34);
            for (int gi = 0; gi < icons.Count; gi = gi + 1) {
                int gr = gi / gcols;
                int gc = gi % gcols;
                int gx = gx0 + gc * cell;
                int gy = gy0 + gr * cell;
                bool hot = !app.PointerCaptured()
                    && app.mouseX >= gx && app.mouseX < gx + cell
                    && app.mouseY >= gy && app.mouseY < gy + cell;
                if (hot) {
                    c.FillRoundRect(gx, gy, cell - app.Scale(4), cell - app.Scale(4),
                        app.Scale(4), t.bgHover);
                }
                c.DrawGlyphIn(icons[gi], gx, gy + app.Scale(6),
                    cell - app.Scale(4), iconSz, iconSz, t.textPrimary);
                c.DrawTextCentered(gx, gy + iconSz + app.Scale(12), cell - app.Scale(4),
                    Canvas.FontHeight(t.fontSizeSmall),
                    Ellipsis.Fit(icons[gi], cell - app.Scale(6), t.fontSizeSmall),
                    t.textTertiary, t.fontSizeSmall);
                if (hot && iconClick) {
                    Clipboard.SetText("c.DrawGlyph(\"" + icons[gi] + "\", x, y, 24, color);");
                    Gallery.copiedIcon = icons[gi];
                    app.RequestRedraw();
                }
            }
            if (Gallery.copiedIcon != "") {
                c.DrawText(x + app.Scale(110), y + app.Scale(9),
                    "copied  c.DrawGlyph(\"" + Gallery.copiedIcon + "\", ...)",
                    t.success, t.fontSizeSmall);
            }
        } else if (name == "IconSvg") {
            // 组件嵌套的用法：IconView 控件放进 Flex/Panel 树，交给
            // 布局测量排列，而不是逐个手绘定位。三排样本——常用图标、
            // 尺寸阶梯、语义色与窗口铬件形；卡片高度由 LayoutAuto 量
            // 出来跟着长。完整清单见 IconSvg.Names()（997 个）。
            Panel col = Panel.Column().Gap(app.Scale(14));
            Flex common = Flex.Wrapped().Gap(app.Scale(14));
            common.With(new IconView { Name = "home", Box = 22 });
            common.With(new IconView { Name = "search", Box = 22 });
            common.With(new IconView { Name = "settings", Box = 22 });
            common.With(new IconView { Name = "user", Box = 22 });
            common.With(new IconView { Name = "folder", Box = 22 });
            common.With(new IconView { Name = "save", Box = 22 });
            common.With(new IconView { Name = "edit", Box = 22 });
            common.With(new IconView { Name = "trash", Box = 22 });
            common.With(new IconView { Name = "copy", Box = 22 });
            common.With(new IconView { Name = "cut", Box = 22 });
            common.With(new IconView { Name = "clipboard", Box = 22 });
            common.With(new IconView { Name = "download", Box = 22 });
            common.With(new IconView { Name = "upload", Box = 22 });
            common.With(new IconView { Name = "refresh", Box = 22 });
            common.With(new IconView { Name = "plus", Box = 22 });
            common.With(new IconView { Name = "close", Box = 22 });
            common.With(new IconView { Name = "check", Box = 22 });
            common.With(new IconView { Name = "warning", Box = 22 });
            common.With(new IconView { Name = "info", Box = 22 });
            common.With(new IconView { Name = "star", Box = 22 });
            common.With(new IconView { Name = "heart", Box = 22 });
            common.With(new IconView { Name = "lock", Box = 22 });
            common.With(new IconView { Name = "pin", Box = 22 });
            common.With(new IconView { Name = "eye", Box = 22 });
            common.With(new IconView { Name = "bell", Box = 22 });
            common.With(new IconView { Name = "mail", Box = 22 });
            common.With(new IconView { Name = "calendar", Box = 22 });
            common.With(new IconView { Name = "clock", Box = 22 });
            col.With(common);
            col.With(new Label {
                Text = "sizes 16/24/32/48/64 · alpha 50%",
                Class = "hint" });
            Flex sizes = Flex.Row().Gap(app.Scale(22));
            sizes.With(new IconView { Name = "settings", Box = 16 });
            sizes.With(new IconView { Name = "settings", Box = 24 });
            sizes.With(new IconView { Name = "settings", Box = 32 });
            sizes.With(new IconView { Name = "settings", Box = 48 });
            sizes.With(new IconView { Name = "settings", Box = 64 });
            sizes.With(new IconView { Name = "heart", Box = 48,
                Color = Style.Fade(t.primary, 500) });
            col.With(sizes);
            Flex roles = Flex.Wrapped().Gap(app.Scale(14));
            roles.With(new IconView { Name = "circle-check", Box = 24,
                Color = t.success });
            roles.With(new IconView { Name = "circle-x", Box = 24,
                Color = t.error });
            roles.With(new IconView { Name = "alert-triangle", Box = 24,
                Color = t.warning });
            roles.With(new IconView { Name = "info-circle", Box = 24,
                Color = t.info });
            roles.With(new IconView { Name = "star-filled", Box = 24,
                Color = t.warning });
            roles.With(new IconView { Name = "window-minimize", Box = 24 });
            roles.With(new IconView { Name = "window-maximize", Box = 24 });
            roles.With(new IconView { Name = "lock-open", Box = 24,
                Color = t.success });
            col.With(roles);
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(16),
                w - app.Scale(36), app.Scale(240));
        } else if (name == "IconSvg.software") {
            // 软件/窗口铬件专用的一批：窗口框架、最小化/最大化/还原、
            // 折叠展开、图钉、锁、电源、密钥。标题栏、对话框、托盘
            // 菜单都从这一批取形；每格是 IconView + Label 的组件嵌套。
            List<string> soft = new List<string>{
                "window", "app-window", "window-minimize", "window-maximize",
                "minimize", "maximize", "restore", "picture-in-picture",
                "arrows-minimize", "arrows-maximize",
                "layout-navbar-collapse", "fold", "fold-up", "fold-down",
                "pinned", "pinned-off", "pin", "lock", "lock-open",
                "power", "key", "square-key", "shield-lock", "eye-off" };
            Flex batch = Flex.Wrapped().Gap(app.Scale(18));
            for (int si = 0; si < soft.Count; si = si + 1) {
                Flex cell = Flex.Column().Gap(app.Scale(6));
                cell.With(new IconView { Name = soft[si], Box = 28 });
                cell.With(new Label { Text = soft[si], Class = "hint" });
                batch.With(cell);
            }
            Gallery.LayoutAuto(app, batch, name, px, y + Gallery.PreviewPadTop(app),
                w - app.Scale(36), app.Scale(90));
        } else if (name == "IconSvg.catalog") {
            // 与 Icon 页网格同样的交互：悬停高亮、点击复制名字。
            // 只展示前 120 个（字母序），完整清单见 IconSvg.Names()。
            List<string> ticons = IconSvg.Names();
            int shown = IconSvg.Count();
            if (shown > 120) { shown = 120; }
            int tcell = app.Scale(62);
            int tsz = app.Scale(24);
            int tcols = (w - app.Scale(24)) / tcell;
            if (tcols < 1) { tcols = 1; }
            bool tsvgClick = app.window.EventKind() == 3;
            int tx0 = x + app.Scale(12);
            int ty0 = y + app.Scale(34);
            for (int ti = 0; ti < shown; ti = ti + 1) {
                int tr = ti / tcols;
                int tc = ti % tcols;
                int tx = tx0 + tc * tcell;
                int ty = ty0 + tr * tcell;
                bool thot = !app.PointerCaptured()
                    && app.mouseX >= tx && app.mouseX < tx + tcell
                    && app.mouseY >= ty && app.mouseY < ty + tcell;
                if (thot) {
                    c.FillRoundRect(tx, ty, tcell - app.Scale(4),
                        tcell - app.Scale(4), app.Scale(4), t.bgHover);
                }
                IconSvg.Draw(c, ticons[ti],
                    tx + (tcell - app.Scale(4) - tsz) / 2, ty + app.Scale(6),
                    tsz, t.textPrimary);
                c.DrawTextCentered(tx, ty + tsz + app.Scale(12),
                    tcell - app.Scale(6), Canvas.FontHeight(t.fontSizeSmall),
                    Ellipsis.Fit(ticons[ti], tcell - app.Scale(6), t.fontSizeSmall),
                    t.textTertiary, t.fontSizeSmall);
                if (thot && tsvgClick) {
                    Clipboard.SetText("\"" + ticons[ti] + "\"");
                    Gallery.copiedIcon = ticons[ti];
                    app.RequestRedraw();
                }
            }
            if (Gallery.copiedIcon != "") {
                c.DrawText(x + app.Scale(110), y + app.Scale(9),
                    "copied  \"" + Gallery.copiedIcon + "\"",
                    t.success, t.fontSizeSmall);
            }
        } else if (name == "Label") {
            Panel col = Panel.Column().Gap(app.Scale(10));
            col.With(new Label { Text = "Title", Class = "title" });
            col.With(new Label { Text = "Default label" });
            col.With(new Label { Text = "Secondary", Class = "secondary" });
            col.With(new Label { Text = "Hint / muted caption text", Class = "hint" });
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(16),
                             w - app.Scale(36), app.Scale(140));
        } else if (name == "Typography") {
            // A full heading scale + a paragraph: showing h1..h4 and body copy
            // lets the reader see the whole font ramp at once.
            Panel col = Panel.Column().Gap(app.Scale(4));
            col.With(Typography.H("h1 · Display / page title", 1));
            col.With(Typography.H("h2 · Section heading", 2));
            col.With(Typography.H("h3 · Subsection heading", 3));
            col.With(Typography.H("h4 · Group / card title", 4));
            col.With(Typography.P("Body paragraph — readable text for application content. Long lines wrap naturally and the size paces long-form reading."));
            col.With(new Label { Text = "Hint / muted caption text", Class = "hint" });
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(24),
                             w - app.Scale(36), app.Scale(260));
        } else if (name == "Input") {
            // A labelled input: the row lays the hint beside the field.
            Flex row = Flex.Wrapped().Gap(app.Scale(10));
            row.With(new Label { Text = "Your name" });
            row.With(Gallery.demoInput);
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(8),
                             w - app.Scale(36), t.heightMedium);
        } else if (name == "TextArea") {
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(new Label { Text = "Description", Class = "secondary" });
            col.With(Gallery.demoArea);
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(20),
                             w - app.Scale(36), app.Scale(180));
        } else if (name == "TextArea.count") {
            // 多行同款增强拆卡：count / round / status / filter 各一景。
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Show count", Gallery.demoTaCount,
                    Gallery.T("Same \"current / max\" part as Input, under the box, right-aligned.",
                        "与 Input 同款「当前 / 上限」部件，位于框下右对齐。")),
                name, px, py - app.Scale(20), w - app.Scale(36), app.Scale(140));
        } else if (name == "TextArea.round") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Round", Gallery.demoTaRound,
                    Gallery.T("Soft rounded corners -- multiline fields never pull to a stadium pill.",
                        "软圆角——多行框不拉整高胶囊，保持矩形观感。")),
                name, px, py - app.Scale(20), w - app.Scale(36), app.Scale(140));
        } else if (name == "TextArea.status") {
            Panel colTa = Panel.Column().Gap(app.Scale(8));
            colTa.With(new Label { Text = "Success", Class = "secondary" });
            colTa.With(Gallery.demoTaOk);
            colTa.With(new Label { Text = "Warning", Class = "secondary" });
            colTa.With(Gallery.demoTaWarn);
            Gallery.LayoutAuto(app, colTa, name, px, py - app.Scale(20),
                             w - app.Scale(36), app.Scale(210));
        } else if (name == "TextArea.filter") {
            Gallery.LayoutAuto(app,
                Gallery.FieldWithCaption(app, "Only digits", Gallery.demoTaDigits,
                    Gallery.T("Filter rewrites every candidate before it lands; rejected text never inserts.",
                        "Filter 逐候选改写后才落地；被拒绝的输入不会插入。")),
                name, px, py - app.Scale(20), w - app.Scale(36), app.Scale(140));
        } else if (name == "Checkbox") {
            // Sizes + semantic accents, laid out by Panel flow (no coordinates).
            // EVERY checkbox is bound to its own model field via `.data` so
            // each one toggles independently.
            Checkbox cbS = new Checkbox("Small");
            cbS.Class = "small";
            cbS.data = Gallery.model.cbSmall;
            Checkbox cbM = new Checkbox("Default");
            cbM.data = Gallery.model.cbDefault;
            Checkbox cbL = new Checkbox("Large");
            cbL.Class = "large";
            cbL.data = Gallery.model.cbLarge;
            Checkbox ck = new Checkbox("Primary");
            ck.Class = "primary";
            ck.data = Gallery.model.cbPrimary;
            Checkbox ck2 = new Checkbox("Success");
            ck2.Class = "success";
            ck2.data = Gallery.model.cbSuccess;
            Checkbox ck3 = new Checkbox("Warning");
            ck3.Class = "warning";
            ck3.data = Gallery.model.cbWarning;
            Panel col = Panel.Column().Gap(app.Scale(12));
            col.With(Panel.Row().Gap(app.Scale(24)).With(cbS).With(cbM).With(cbL));
            col.With(Panel.Row().Gap(app.Scale(24)).With(ck).With(ck2).With(ck3));
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(120));
        } else if (name == "Radio") {
            // A radio GROUP = every option shares one two-way data binding;
            // clicking any option writes the group value to the model field.
            // Each row is its own group on its own model field: labels,
            // sizes (small / large), semantic accents, and the disabled
            // state — clicking a disabled radio must do nothing.
            Radio ra = new Radio(0, "Option A");
            ra.data = Gallery.model.radioChoice;
            Radio rb = new Radio(1, "Option B");
            rb.data = Gallery.model.radioChoice;
            Radio rc = new Radio(2, "Option C");
            rc.data = Gallery.model.radioChoice;
            // Sizes are classes: the ring/dot rescale with the label font.
            Radio rs = new Radio(0, "Small");
            rs.Class = "small";
            rs.data = Gallery.model.radioSize;
            Radio rm = new Radio(1, "Default");
            rm.data = Gallery.model.radioSize;
            Radio rt = new Radio(3, "Tiny");
            rt.Class = "tiny";
            rt.data = Gallery.model.radioSize;
            Radio rl = new Radio(2, "Large");
            rl.Class = "large";
            rl.data = Gallery.model.radioSize;
            // Semantic accents recolor the checked ring + dot.
            Radio ri = new Radio(0, "Info");
            ri.Class = "info";
            ri.data = Gallery.model.radioGroup2;
            Radio rw = new Radio(1, "Success");
            rw.Class = "success";
            rw.data = Gallery.model.radioGroup2;
            Radio rn = new Radio(2, "Warning");
            rn.Class = "warning";
            rn.data = Gallery.model.radioGroup2;
            Radio re = new Radio(3, "Error");
            re.Class = "error";
            re.data = Gallery.model.radioGroup2;
            // Disabled pair on its own field: one checked, one not —
            // the checked one shows the muted accent, and neither fires.
            Radio rd0 = new Radio(0, "Locked off");
            rd0.Disabled = true;
            rd0.data = Gallery.model.radioLock;
            Radio rd1 = new Radio(1, "Locked on");
            rd1.Disabled = true;
            rd1.data = Gallery.model.radioLock;
            // One group, one accent PER OPTION: whoever is checked lights
            // up in its own semantic color — the tier meaning travels with
            // the option, not with the group.
            Radio ma = new Radio(0, "Basic");
            ma.data = Gallery.model.radioAccent;
            Radio mb = new Radio(1, "Pro");
            mb.Class = "info";
            mb.data = Gallery.model.radioAccent;
            Radio mc = new Radio(2, "Team");
            mc.Class = "success";
            mc.data = Gallery.model.radioAccent;
            Radio md = new Radio(3, "Enterprise");
            md.Class = "warning";
            md.data = Gallery.model.radioAccent;
            Panel col = Panel.Column().Gap(app.Scale(12));
            col.With(Panel.Row().Gap(app.Scale(24)).With(ra).With(rb).With(rc));
            col.With(Panel.Row().Gap(app.Scale(20))
                .With(rs).With(rm).With(rt).With(rl));
            col.With(Panel.Row().Gap(app.Scale(20))
                .With(ri).With(rw).With(rn).With(re));
            col.With(Panel.Row().Gap(app.Scale(24)).With(rd0).With(rd1));
            col.With(Panel.Row().Gap(app.Scale(20))
                .With(ma).With(mb).With(mc).With(md));
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(220));
            // 基础组翻转的那一帧把 Change 报到 LIVE STATES 行：绑定值
            // 就是组选择，轮询对比即可，无需 lambda 捕获。
            if (Gallery.model.radioChoice != Gallery.radioPrevChoice) {
                Gallery.radioPrevChoice = Gallery.model.radioChoice;
                Gallery.Fired(app, name, Gallery.T("Changed -> option ",
                    "已切换 -> 选项 ")
                    + Convert.ToString(Gallery.model.radioChoice + 1));
            }
            if (Gallery.model.radioAccent != Gallery.radioAccentPrev) {
                Gallery.radioAccentPrev = Gallery.model.radioAccent;
                Gallery.Fired(app, name, Gallery.T("Tier -> ",
                    "已切换 -> 档位 ")
                    + Convert.ToString(Gallery.radioAccentPrev + 1));
            }
        } else if (name == "Radio.bordered") {
            // 边框变体（el-radio border）：整项变描边圆角盒，选中描边
            // 走强调色；禁用与语义色联动各一枚。
            Radio bo0 = new Radio(0, "每日送");
            bo0.Bordered = true;
            bo0.data = Gallery.model.radioBorder;
            Radio bo1 = new Radio(1, "自提");
            bo1.Bordered = true;
            bo1.data = Gallery.model.radioBorder;
            Radio bo2 = new Radio(0, "成功");
            bo2.Bordered = true;
            bo2.Class = "success";
            bo2.data = Gallery.model.radioBorder2;
            Radio bo3 = new Radio(1, "警告");
            bo3.Bordered = true;
            bo3.Class = "warning";
            bo3.data = Gallery.model.radioBorder2;
            Radio bo4 = new Radio(0, "锁定");
            bo4.Bordered = true;
            bo4.Disabled = true;
            bo4.data = Gallery.model.radioBorder3;
            Radio bo5 = new Radio(1, "锁定选中");
            bo5.Bordered = true;
            bo5.Disabled = true;
            bo5.data = Gallery.model.radioBorder3;
            Panel colB = Panel.Column().Gap(app.Scale(12));
            colB.With(Panel.Row().Gap(app.Scale(16)).With(bo0).With(bo1));
            colB.With(Panel.Row().Gap(app.Scale(16)).With(bo2).With(bo3));
            colB.With(Panel.Row().Gap(app.Scale(16)).With(bo4).With(bo5));
            Gallery.LayoutAuto(app, colB, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(160));
        } else if (name == "RadioGroup.options") {
            // Options 数据源：选项带自定义 value 与禁用位；组级 Value
            // 双向绑定到模型字段；LIVE STATES 上报选中 value。
            if (Gallery.demoRgOpt == null) {
                Gallery.demoRgOpt = new RadioGroup();
                Gallery.demoRgOpt.AddOption("北京", 10);
                Gallery.demoRgOpt.AddOption("上海", 20);
                Gallery.demoRgOpt.AddOption("广州", 30, true);
                Gallery.demoRgOpt.AddOption("深圳", 40);
                Gallery.demoRgOpt.Value = Gallery.model.rgCity;
                Gallery.model.rgCity = 20;
                Gallery.demoRgOpt.SyncGroup();
            }
            Panel colO = Panel.Column().Gap(app.Scale(10));
            colO.With(Gallery.demoRgOpt);
            colO.With(new Label {
                Text = Gallery.T("Selected value: ", "选中值：")
                    + Convert.ToString(Gallery.demoRgOpt.SelectedValue())
                    + Gallery.T("  (index ", "  （下标 ")
                    + Convert.ToString(Gallery.demoRgOpt.SelectedIndex()) + ")",
                Class = "secondary" });
            Gallery.LayoutAuto(app, colO, name, px, py - app.Scale(8),
                             w - app.Scale(36), app.Scale(120));
            if (Gallery.demoRgOpt.SelectedValue() != Gallery.rgOptPrev) {
                Gallery.rgOptPrev = Gallery.demoRgOpt.SelectedValue();
                Gallery.Fired(app, name, Gallery.T("Changed -> value ",
                    "已切换 -> 值 ")
                    + Convert.ToString(Gallery.rgOptPrev));
            }
        } else if (name == "RadioGroup.buttons") {
            // 按钮组形态：连体段，禁用段置灰；尺寸档位两排对照。
            if (Gallery.demoRgBtn == null) {
                Gallery.demoRgBtn = new RadioGroup();
                Gallery.demoRgBtn.AddOption("当日达配送");
                Gallery.demoRgBtn.AddOption("门店自提（旗舰店）");
                Gallery.demoRgBtn.AddOption("快递柜投递", 3, true);
                Gallery.demoRgBtn.Buttons = true;
                Gallery.demoRgBtn.SyncGroup();
            }
            RadioGroup gL = new RadioGroup();
            gL.AddOption("Rock'n'Roll Star");
            gL.AddOption("Shakermaker");
            gL.AddOption("Live Forever");
            gL.AddOption("Up in the Sky");
            gL.Buttons = true;
            gL.Size = "medium";
            gL.SyncGroup();
            RadioGroup gS = new RadioGroup();
            gS.AddOption("Rock'n'Roll Star");
            gS.AddOption("Shakermaker");
            gS.AddOption("Live Forever");
            gS.AddOption("Up in the Sky");
            gS.Buttons = true;
            gS.Size = "small";
            gS.SyncGroup();
            Panel colB2 = Panel.Column().Gap(app.Scale(12));
            colB2.With(Gallery.demoRgBtn);
            colB2.With(gL);
            colB2.With(gS);
            Gallery.LayoutAuto(app, colB2, name, px, py - app.Scale(8),
                             w - app.Scale(36), app.Scale(190));
            if (Gallery.demoRgBtn.SelectedValue() != Gallery.rgBtnPrev) {
                Gallery.rgBtnPrev = Gallery.demoRgBtn.SelectedValue();
                Gallery.Fired(app, name, Gallery.T("Changed -> option ",
                    "已切换 -> 选项 ")
                    + Convert.ToString(Gallery.rgBtnPrev + 1));
            }
        } else if (name == "RadioGroup") {
            // 组容器：AddOption 把选项交给组排布，宽度不够自动换行；
            // Selected() 是全组共享的选中信号，直接读即可。
            Panel col = Panel.Column().Gap(app.Scale(10));
            col.With(Gallery.demoRg);
            col.With(new Label {
                Text = Gallery.T("Selected: option ", "当前选中：选项 ")
                    + Convert.ToString(Gallery.demoRg.Selected().Get() + 1),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(8),
                             w - app.Scale(36), app.Scale(120));
            if (Gallery.demoRg.Selected().Get() != Gallery.rgPrev) {
                Gallery.rgPrev = Gallery.demoRg.Selected().Get();
                Gallery.Fired(app, name, Gallery.T("Changed -> option ",
                    "已切换 -> 选项 ")
                    + Convert.ToString(Gallery.rgPrev + 1));
            }
        } else if (name == "Switch") {
            Flex row = Flex.Wrapped().Gap(app.Scale(12));
            row.With(Gallery.demoSwitch);
            row.With(new Label { Text = "Interactive state" });
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(8),
                             w - app.Scale(36), app.Scale(40));
        } else if (name == "Slider") {
            Gallery.demoSlider.Prefer(app.Scale(360), 0);
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(new Label { Text = "Level: " + Convert.ToString(Gallery.model.level), Class = "secondary" });
            col.With(Gallery.demoSlider);
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(12),
                             w - app.Scale(36), app.Scale(70));
        } else if (name == "Slider.range") {
            // 范围：双柄共享一对模型字段，两枚 InputNumber 也绑同一对
            // 字段——滑块和输入框互相同步（Naive UI range 演示同款）。
            Panel col = Panel.Column().Gap(app.Scale(8));
            col.With(Gallery.demoSliderRange);
            Panel row = Panel.Row().Gap(app.Scale(12));
            row.With(Gallery.demoSliderLo);
            row.With(Gallery.demoSliderHi);
            col.With(row);
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(110));
        } else if (name == "Slider.marks") {
            // 标记刻度 + 限取标记值：上面一条自由取值、刻度只是可视
            // 锚点；下面一条 stepMark=true 只能停在标记上（键盘同样）。
            Gallery.demoSliderMarks.Prefer(app.Scale(360), 0);
            Gallery.demoSliderStepMark.Prefer(app.Scale(360), 0);
            Panel col = Panel.Column().Gap(app.Scale(10));
            // 两侧留白，让 0/100 端点标记的文字不被演示框裁掉。
            Panel mkRow = Panel.Row();
            mkRow.Padding(0, app.Scale(30), 0, app.Scale(30));
            mkRow.With(Gallery.demoSliderMarks);
            col.With(mkRow);
            Panel smkRow = Panel.Row();
            smkRow.Padding(0, app.Scale(30), 0, app.Scale(30));
            smkRow.With(Gallery.demoSliderStepMark);
            col.With(smkRow);
            col.With(new Label {
                Text = Gallery.T("value = ", "当前值 = ")
                    + Convert.ToString(Gallery.model.sldMark)
                    + Gallery.T("  -- bottom slider: stepMark restricts to marks.",
                                "  —— 下面一条 stepMark=true，只能停在标记上。"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(150));
        } else if (name == "Slider.vertical") {
            // 垂直 + 倒转：竖向滑块需要真实高度（Prefer 定死），
            // 左边普通（min 在下、刻度文字在右），右边 reverse（min 在上）。
            Gallery.demoSliderVt.Prefer(app.Scale(80), app.Scale(220));
            Gallery.demoSliderVtRev.Prefer(app.Scale(80), app.Scale(220));
            Panel row = Panel.Row().Gap(app.Scale(28));
            row.With(Gallery.demoSliderVt);
            row.With(Gallery.demoSliderVtRev);
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(row);
            col.With(new Label {
                Text = Gallery.T("vertical marks / vertical + reverse (min at top)",
                                 "垂直刻度 / 垂直 + 倒转（min 在顶端）"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(270));
        } else if (name == "Slider.tooltip") {
            // 气泡三态：tooltip=false 拖动也不出泡；showTooltip 常显；
            // tipFormat="{v}%" 格式化（Naive UI format-tooltip）。
            // 行距要大于气泡全高（约 63 逻辑像素）：常显气泡悬在拇指
            // 上方，贴太近就把上一条滑块的拇指盖住了。
            Panel col = Panel.Column().Gap(app.Scale(64));
            Gallery.demoSliderNoTip.Prefer(app.Scale(360), 0);
            Gallery.demoSliderAlways.Prefer(app.Scale(360), 0);
            Gallery.demoSliderFmt.Prefer(app.Scale(360), 0);
            col.With(Gallery.demoSliderNoTip);
            col.With(Gallery.demoSliderAlways);
            col.With(Gallery.demoSliderFmt);
            col.With(new Label {
                Text = Gallery.T("tooltip=false / showTooltip / tipFormat \"{v}%\"",
                                 "tooltip=false 关泡 / showTooltip 常显 / tipFormat \"{v}%\" 格式化"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(260));
        } else if (name == "InputNumber") {
            // 基础 + 尺寸 + 按钮位置：三行共享一个模型字段，改哪一行
            // 其余两行跟着同步（Naive UI 尺寸/按钮位置演示同款布局）。
            Gallery.demoNumBasic.Prefer(app.Scale(140), 0);
            Gallery.demoNumSmall.Prefer(app.Scale(140), 0);
            Gallery.demoNumLarge.Prefer(app.Scale(140), 0);
            Panel col = Panel.Column().Gap(app.Scale(8));
            Flex r1 = Flex.Wrapped().Gap(app.Scale(12));
            r1.With(Gallery.demoNumBasic);
            r1.With(new Label { Text = "medium", Class = "secondary" });
            Flex r2 = Flex.Wrapped().Gap(app.Scale(12));
            r2.With(Gallery.demoNumSmall);
            r2.With(new Label { Text = "small", Class = "secondary" });
            r2.With(Gallery.demoNumRight);
            r2.With(new Label { Text = Gallery.T("placement: right",
                                                 "按钮位置：right"),
                                Class = "secondary" });
            Flex r3 = Flex.Wrapped().Gap(app.Scale(12));
            r3.With(Gallery.demoNumLarge);
            r3.With(new Label { Text = "large", Class = "secondary" });
            col.With(r1);
            col.With(r2);
            col.With(r3);
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(150));
        } else if (name == "InputNumber.prefix") {
            Panel col = Panel.Column().Gap(app.Scale(8));
            Flex row = Flex.Wrapped().Gap(app.Scale(12));
            Gallery.demoNumPrefix.Prefer(app.Scale(170), 0);
            Gallery.demoNumSuffix.Prefer(app.Scale(170), 0);
            Gallery.demoNumSufOnly.Prefer(app.Scale(170), 0);
            row.With(Gallery.demoNumPrefix);
            row.With(Gallery.demoNumSuffix);
            row.With(Gallery.demoNumSufOnly);
            col.With(row);
            col.With(new Label {
                Text = Gallery.T("Prefix / suffix are static labels around the value; both stay in sync (shared field).",
                                 "前缀 / 后缀是数值两侧的常显文字；三枚共享一个字段，改一处处处同步。"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(90));
        } else if (name == "InputNumber.minmax") {
            Panel col = Panel.Column().Gap(app.Scale(8));
            Flex row = Flex.Wrapped().Gap(app.Scale(12));
            Gallery.demoNumMin.Prefer(app.Scale(170), 0);
            Gallery.demoNumMax.Prefer(app.Scale(170), 0);
            row.With(Gallery.demoNumMin);
            row.With(Gallery.demoNumMax);
            col.With(row);
            col.With(new Label {
                Text = Gallery.T("Values clamp to [min, max] on every path: buttons, arrows, typing.",
                                 "任何路径——按钮、方向键、直接输入——都会被钳到 [min, max]。"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(90));
        } else if (name == "InputNumber.format") {
            // 自定义解析：千分位分组 + format/parse 钩子（"1,075" /
            // "1,079 ¥"），编辑与提交两条路都过钩子（Naive UI 同款）。
            Panel col = Panel.Column().Gap(app.Scale(8));
            Flex row = Flex.Wrapped().Gap(app.Scale(12));
            Gallery.demoNumGroup.Prefer(app.Scale(170), 0);
            Gallery.demoNumYen.Prefer(app.Scale(170), 0);
            row.With(Gallery.demoNumGroup);
            row.With(Gallery.demoNumYen);
            col.With(row);
            col.With(new Label {
                Text = Gallery.T("GroupDigits thousands-separators; WithFormatter / WithParser add the currency suffix.",
                                 "GroupDigits 千分位；WithFormatter / WithParser 钩子加 ¥ 后缀。"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(90));
        } else if (name == "InputNumber.precision") {
            // 精度：定点数——模型存显示值 x 10^Precision，step=10 即
            // 0.10 步进（与 Naive UI precision + decimal-step 同义）。
            Panel col = Panel.Column().Gap(app.Scale(8));
            Flex row = Flex.Wrapped().Gap(app.Scale(12));
            Gallery.demoNumPrec.Prefer(app.Scale(170), 0);
            row.With(Gallery.demoNumPrec);
            col.With(row);
            col.With(new Label {
                Text = Gallery.T("precision=2: model holds 50, shown as 0.50; step 10 = 0.10.",
                                 "precision=2：模型值 50 显示为 0.50；步进 10 即 0.10。"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(90));
        } else if (name == "InputNumber.loading") {
            // 加载态：开关拨动即置 Loading——整框落灰、钮位换成旋转
            // 圆点、指针键盘全不响应（远端取数进行中的形态）。
            Gallery.demoNumLoad.Loading = Gallery.model.numLoading;
            Panel col = Panel.Column().Gap(app.Scale(8));
            Flex row = Flex.Wrapped().Gap(app.Scale(12));
            Gallery.demoNumLoad.Prefer(app.Scale(170), 0);
            row.With(Gallery.demoNumLoad);
            row.With(Gallery.demoNumLoadSw);
            row.With(new Label { Text = "Loading", Class = "secondary" });
            col.With(row);
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(70));
        } else if (name == "InputNumber.validator") {
            // 自定义验证：Check 钩子对将要写入的值投票，未通过时值仍
            // 写入，但整框画 input::error 红描边并触发 Invalid。
            Panel col = Panel.Column().Gap(app.Scale(8));
            Flex row = Flex.Wrapped().Gap(app.Scale(12));
            Gallery.demoNumCheck.Prefer(app.Scale(170), 0);
            row.With(Gallery.demoNumCheck);
            col.With(row);
            col.With(new Label {
                Text = Gallery.T("validator rejects < 10: value commits, red ring + Invalid event fires.",
                                 "validator 拒绝 < 10 的值：值照常写入，红描边 + 触发 Invalid。"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(90));
        } else if (name == "Slider.disabled") {
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(Gallery.demoSliderDisabled);
            col.With(new Label {
                Text = Gallery.T("Disabled = true greys the whole slider and ignores pointer / keyboard.",
                                 "Disabled = true 整条落灰，指针与键盘都不响应。"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(90));
        } else if (name == "Transfer") {
            // 基础用法：勾选左栏 → 中缝「>」穿梭；右栏勾选可「<」移回。
            // 头部全选框随可见行聚合（部分勾选画横线），计数行报两侧。
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(Gallery.demoTransfer);
            col.With(new Label {
                Text = Gallery.T("left ", "左栏 ")
                    + Convert.ToString(Gallery.trfSrc.Count)
                    + Gallery.T(" · right ", " · 右栏 ")
                    + Convert.ToString(Gallery.trfTgt.Count)
                    + Gallery.T(" · ticked ", " · 已勾 ")
                    + Convert.ToString(Gallery.demoTransfer.Checked().Count),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(8),
                             w - app.Scale(36), app.Scale(300));
        } else if (name == "Transfer.filter") {
            // 可过滤：头部下各一个搜索框，行文本子串匹配（忽略大小写）。
            // 全选与移动都只看过滤结果——整列勾上再搜一个字，穿过去的
            // 就只有命中的那些。
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(Gallery.demoTransferFilter);
            col.With(new Label {
                Text = Gallery.T("select-all and the middle buttons only ever see the filtered rows.",
                                 "全选与中缝按钮只看得见过滤结果。"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(300));
        } else if (name == "Transfer.huge") {
            // 一大堆数据：四万两千项，行区每帧只画视口切片——滚动、
            // 过滤、穿梭的开销与列表长度无关。搜 "Special" 试试。
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(Gallery.demoTransferHuge);
            col.With(new Label {
                Text = Convert.ToString(Gallery.trfHugeSrc.Count)
                    + Gallery.T(" items · only the visible slice is painted each frame.",
                                " 项 · 每帧只画视口里的那几行。"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(300));
        } else if (name == "Transfer.custom") {
            // 自定义标签：WithLabel 成员取值拼行文本，WithIcon 按条目
            // 选行首图标（vip 行给 star）。委托不捕获环境，只读参数。
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(Gallery.demoTransferUser);
            col.With(new Label {
                Text = Gallery.T("WithLabel(u => u.name + \" · \" + u.role) · WithIcon(u => u.vip ? \"star\" : \"\")",
                                 "WithLabel(u => u.name + \" · \" + u.role) · WithIcon(u => u.vip ? \"star\" : \"\")"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(300));
        } else if (name == "Rate") {
            Panel col = Panel.Column().Gap(app.Scale(8));
            col.With(new Label { Text = "Rate · " + Convert.ToString(Gallery.model.level), Class = "secondary" });
            col.With(Gallery.demoRate);
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(8),
                             w - app.Scale(36), app.Scale(70));
        } else if (name == "Rate.half") {
            // 允许半颗：每颗星拆左右两个命中格，左半 = i+0.5、右半
            // = i+1；悬停预览跟随到半格（rate::star-half 半透明实心）。
            int v = Gallery.model.rateHalf;
            string vs = Convert.ToString(v / 2)
                + (v % 2 == 1 ? ".5" : "");
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(Gallery.demoRateHalf);
            col.With(new Label {
                Text = Gallery.T("value = ", "当前值 = ") + vs
                    + Gallery.T("  -- click the left / right half of a star.",
                                "  —— 点击星星的左 / 右半格。"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(76));
        } else if (name == "Rate.clearable") {
            // 可清空：再点当前值对应的那一格即归零（只消费一次的
            // 点击语义在这里尤其要紧——清零后不能又被同一事件写回）。
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(Gallery.demoRateClr);
            col.With(new Label {
                Text = Gallery.T("value = ", "当前值 = ")
                    + Convert.ToString(Gallery.model.rateClr)
                    + Gallery.T("  -- click the star matching the value to clear it.",
                                "  —— 再点与当前值相同的那颗星即清空。"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(76));
        } else if (name == "Rate.sizes") {
            // 尺寸是 class（rate.small/.large），三行共享同一个值。
            Panel col = Panel.Column().Gap(app.Scale(8));
            Panel r1 = Panel.Row().Gap(app.Scale(12));
            r1.With(new Label { Text = Gallery.T("Small", "小") });
            r1.With(Gallery.demoRateSm);
            Panel r2 = Panel.Row().Gap(app.Scale(12));
            r2.With(new Label { Text = Gallery.T("Medium", "中") });
            r2.With(Gallery.demoRateMd);
            Panel r3 = Panel.Row().Gap(app.Scale(12));
            r3.With(new Label { Text = Gallery.T("Large", "大") });
            r3.With(Gallery.demoRateLg);
            col.With(r1);
            col.With(r2);
            col.With(r3);
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(150));
        } else if (name == "Rate.icon") {
            // 自定义图标：Icon / VoidIcon 换成任何图标组件认识的名字
            // （走 IconSvg 优先、IconVector 回退的同一管线）。
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(Gallery.demoRateHeart);
            col.With(new Label {
                Text = Gallery.T("Icon = \"heart\", VoidIcon = \"heart\" -- any icon name works.",
                    "Icon = \"heart\"、VoidIcon = \"heart\" —— 任何图标名都行。"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(76));
        } else if (name == "Rate.color") {
            // 颜色：语义色 class 换 ::star 的颜色（base.css 的
            // rate.info/.success/.error），三行共享同一个值。
            Panel col = Panel.Column().Gap(app.Scale(8));
            Panel c1 = Panel.Row().Gap(app.Scale(12));
            c1.With(new Label { Text = Gallery.T("Info", "信息") });
            c1.With(Gallery.demoRateInfo);
            Panel c2 = Panel.Row().Gap(app.Scale(12));
            c2.With(new Label { Text = Gallery.T("Success", "成功") });
            c2.With(Gallery.demoRateOk);
            Panel c3 = Panel.Row().Gap(app.Scale(12));
            c3.With(new Label { Text = Gallery.T("Error", "错误") });
            c3.With(Gallery.demoRateErr);
            col.With(c1);
            col.With(c2);
            col.With(c3);
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(150));
        } else if (name == "Rate.readonly") {
            // 只读：照常绘制，但不注册命中区——无悬停预览、点击无效。
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(Gallery.demoRateRo);
            col.With(new Label {
                Text = Gallery.T("readonly -- drawn but deaf: no hover preview, clicks do nothing.",
                    "readonly —— 只画不听：无悬停预览，点击无效。"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(76));
        } else if (name == "Rate.hover") {
            // 监听悬浮变化：HoverChange 处理器把预览值写进模型，这里
            // 每帧回读；变化的那一帧报一条 LIVE STATES。
            if (Gallery.model.rateHoverVal != Gallery.rateHoverPrev) {
                Gallery.rateHoverPrev = Gallery.model.rateHoverVal;
                Gallery.Fired(app, name, Gallery.T("hover -> ", "悬浮 -> ")
                    + Convert.ToString(Gallery.model.rateHoverVal));
            }
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(Gallery.demoRateHover);
            col.With(new Label {
                Text = Gallery.T("hover value: ", "悬浮预览：")
                    + Convert.ToString(Gallery.model.rateHoverVal)
                    + Gallery.T("  (0 = pointer left)", "  （0 = 已离开）"),
                Class = "secondary" });
            Gallery.LayoutAuto(app, col, name, px, y + app.Scale(34),
                             w - app.Scale(36), app.Scale(92));
        } else if (name == "Tabs") {
            // Retained Tabs component: header strip + a
            // separately drawn page area. Multiple styles, sizes, orientations.
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py - app.Scale(24), "Line · underline",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            Gallery.tbLine.Render(app, px, py, app.Scale(360));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py + app.Scale(68) - app.Scale(24), "Segment · pill group",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            Gallery.tbSeg.Render(app, px, py + app.Scale(68), app.Scale(240));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py + app.Scale(136) - app.Scale(24), "Card · closable · add (+) · overflow (wheel / chevrons) · right-click",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            Gallery.tbCard.Render(app, px, py + app.Scale(136), app.Scale(320));

            // Vertical rail with its own page region drawn by the caller —
            // header and page are fully decoupled.
            int vy = py + app.Scale(210);
            int railW = app.Scale(150);
            int railH = Gallery.tbVert.HeaderHeight(app) * Gallery.tbVert.Count();
            Gallery.tbVert.RenderVertical(app, px, vy, railW, railH);
            int pageX = px + railW + app.Scale(16);
            int pageW = app.Scale(300);
            Panel pane = new Panel("page").Titled(Gallery.tbVert.ActiveLabel());
            pane.RenderInside(app, new Rect(pageX, vy, pageW, railH));
            Rect page = pane.Inner();
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                page.x, page.y, "Active page: " + Gallery.tbVert.ActiveLabel(),
                app.theme.textPrimary, app.theme.fontSizeMedium);
        } else if (name == "Steps") {
            // WYSIWYG: retained instances laid out by a column — no coordinates.
            Steps s1 = new Steps();
            s1.data = Gallery.model.level;
            s1.AddStep("Details"); s1.AddStep("Review"); s1.AddStep("Done");
            Steps s2 = new Steps();
            s2.data = Gallery.model.level;
            s2.AddStep("Upload"); s2.AddStep("Verify"); s2.AddStep("Publish");
            s2.ErrorIndex = 1;
            Steps s3 = new Steps();
            s3.AddStepDesc("Account", "Email and password");
            s3.AddStepDesc("Profile", "Name and avatar");
            s3.AddStepDesc("Finish", "Review and submit");
            s3.Class = "vertical";
            // placement=right：次要文字在标题右列（Naive vertical 变体）。
            Steps s4 = new Steps();
            s4.data = Gallery.model.level;
            s4.Placement = "right";
            s4.AddStepDesc("Shipping", "SF Express, 2 days");
            s4.AddStepDesc("Payment", "Card or invoice");
            s4.AddStepDesc("Done", "Order confirmed");
            // status：整条流程按语义状态着色（成功回顾 / 失败排查）。
            Steps s5 = new Steps();
            s5.Status = "success";
            s5.AddStep("Picked"); s5.AddStep("Packed"); s5.AddStep("Shipped");
            Steps s6 = new Steps();
            s6.Status = "error";
            s6.AddStep("Picked"); s6.AddStep("Packed"); s6.AddStep("Shipped");
            // 定制图标：完成态对勾换成 smile，每步图标可另指定（咖啡）。
            Steps s7 = new Steps();
            s7.data = Gallery.model.level;
            s7.FinishIcon = "smile";
            s7.AddStepIconDesc("Order", " placed", "coffee");
            s7.AddStep("Prepare"); s7.AddStep("Serve");
            // 点击切换：Clickable 下点已到达的圆点回退当前步。
            Steps s8 = new Steps();
            s8.data = Gallery.model.stepClick;
            s8.Clickable = true;
            s8.AddStepDesc("Cart", "Review items");
            s8.AddStepDesc("Address", "Where to ship");
            s8.AddStepDesc("Pay", "Confirm payment");
            Panel col = Panel.Column().Gap(app.Scale(12));
            col.With(new Label { Text = "Horizontal · bound current step", Class = "secondary" });
            col.With(s1);
            col.With(new Label { Text = "Error state", Class = "secondary" });
            col.With(s2);
            col.With(new Label { Text = "Vertical · with descriptions", Class = "secondary" });
            col.With(s3);
            col.With(new Label { Text = "Placement right · secondary beside title", Class = "secondary" });
            col.With(s4);
            col.With(new Label { Text = "Status success / error · whole-flow color", Class = "secondary" });
            Panel row56 = Panel.Row().Gap(app.Scale(24));
            row56.With(s5);
            row56.With(s6);
            col.With(row56);
            col.With(new Label { Text = "Custom icons · finishIcon=smile, per-step coffee", Class = "secondary" });
            col.With(s7);
            col.With(new Label { Text = "Clickable · click a reached step to go back (LIVE EVENTS)", Class = "secondary" });
            col.With(s8);
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(20),
                             w - app.Scale(36), app.Scale(760));
        } else if (name == "Breadcrumb") {
            // WYSIWYG: a retained Breadcrumb instance, auto-measured/placed.
            Breadcrumb bc = new Breadcrumb();
            bc.AddItem("Home"); bc.AddItem("Components"); bc.AddItem("Breadcrumb");
            Panel col = Panel.Column();
            col.With(bc);
            Gallery.LayoutAuto(app, col, name, px, py,
                             w - app.Scale(36), app.Scale(36));
        } else if (name == "Menu") {
            List<string> menuItems = new List<string>();
            menuItems.Add("Overview"); menuItems.Add("Settings");
            int id = Menu.RenderVertical(app, px, py - app.Scale(20), app.Scale(220), py + app.Scale(74), app.Scale(36), menuItems, Gallery.demoInt, 0);
            Menu.HandleClick(app, id, menuItems.Count, Gallery.demoInt);
        } else if (name == "Menu.render") {
            // 批量渲染钩子：书签全部被 render-icon 换成 star、被 render-label
            // 追加「· 未读」；子菜单箭头被 expand-icon 换成 folder/folder-open。
            List<MenuItem> tree = Gallery.MenuBookmarkTree();
            int id = Menu.RenderTree(app, px, py - app.Scale(20), app.Scale(220),
                py + app.Scale(232), app.Scale(32), tree, Gallery.menuSel,
                Gallery.menuSt, Gallery.MenuDemoLabel, Gallery.MenuDemoIcon,
                Gallery.MenuDemoExpand, null, 0);
            Menu.HandleTreeClick(app, id, tree, Gallery.menuSt, Gallery.menuSel);
        } else if (name == "Menu.expand") {
            // 展开子菜单：不设 defaultExpandedKeys（null），菜单首帧自动展开
            // 选中项「三明治」的全部父级（食物组）。null 钩子 ⇒ 用条目自带 icon。
            List<MenuItem> tree = Gallery.MenuCharTree();
            int id = Menu.RenderTree(app, px, py - app.Scale(20), app.Scale(240),
                py + app.Scale(432), app.Scale(32), tree, Gallery.menuSel2,
                Gallery.menuSt2, null, null, null, null, 0);
            Menu.HandleTreeClick(app, id, tree, Gallery.menuSt2, Gallery.menuSel2);
        } else if (name == "PageHeader") {
            PageHeader ph = new PageHeader("Component page", "Title, subtitle and back action");
            Panel col = Panel.Column();
            col.With(ph);
            Gallery.LayoutAuto(app, col, name, px, py - app.Scale(16),
                             w - app.Scale(36), app.Scale(64));
        } else if (name == "Pagination") {
            // 八个实例连同标签列由 BuildPaginationDemos 建一次（保留态，
            // 同 Form.validate 的 FormGroup）：sizes 弹层开合、跳页输入框
            // 草稿的状态住在实例字段里，每帧 new 会让「弹层打开」活不过
            // 下一帧 —— 下拉看起来永远点不开。每帧只是把这棵保留树重新
            // 测量、排进预览框。
            Gallery.LayoutAuto(app, Gallery.pgPanel, name, px,
                               py - app.Scale(20), w - app.Scale(36),
                               app.Scale(700));
        } else if (name == "Card") {
            int cy0 = py - app.Scale(12);
            int cw = app.Scale(380);
            int ch = app.Scale(150);
            int lx = app.Scale(14);
            // Row 1, card 1 — reactbits "border-glow", via the declarative
            // FxOptions config (card.WithFx(o)).
            FxOptions fxGlow = new FxOptions();
            fxGlow.borderGlow = true;
            new Card("BorderGlow").WithFx(fxGlow).RenderInside(app,
                new Rect(px, cy0, cw, ch));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                px + lx, Card.ContentY(cy0, t), "Animated border light",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            // Row 1, card 2 — magic-bento spotlight: a soft glow follows the cursor.
            int px2 = px + cw + app.Scale(24);
            FxOptions fxSpot = new FxOptions();
            fxSpot.spotlight = true;
            new Card("Spotlight").WithFx(fxSpot).RenderInside(app,
                new Rect(px2, cy0, cw, ch));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                px2 + lx, Card.ContentY(cy0, t), "Hover — light follows cursor",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            // Row 2 — four opt-in card motion variants, each clipped in-bounds.
            int ry = cy0 + ch + app.Scale(22);
            int cw2 = app.Scale(184);
            int g2 = app.Scale(16);
            int rh = app.Scale(150);
            int cxa = px;
            FxOptions fxSheen = new FxOptions();
            fxSheen.sheen = true;
            fxSheen.glowPeriodMs = 1600;
            new Card("Sheen").WithFx(fxSheen).RenderInside(app,
                new Rect(cxa, ry, cw2, rh));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                cxa + lx, Card.ContentY(ry, t), "Diagonal sheen",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int cxb = cxa + cw2 + g2;
            FxOptions fxAur = new FxOptions();
            fxAur.aurora = true;
            new Card("Aurora").WithFx(fxAur).RenderInside(app,
                new Rect(cxb, ry, cw2, rh));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                cxb + lx, Card.ContentY(ry, t), "Drifting aurora",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int cxc = cxb + cw2 + g2;
            FxOptions fxBr = new FxOptions();
            fxBr.breath = true;
            fxBr.glowPeriodMs = 2800;
            new Card("Breath").WithFx(fxBr).RenderInside(app,
                new Rect(cxc, ry, cw2, rh));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                cxc + lx, Card.ContentY(ry, t), "Breathing rim",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int cxd = cxc + cw2 + g2;
            FxOptions fxMo = new FxOptions();
            fxMo.motes = true;
            new Card("Motes").WithFx(fxMo).RenderInside(app,
                new Rect(cxd, ry, cw2, rh));
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                cxd + lx, Card.ContentY(ry, t), "Rising motes",
                app.theme.textPrimary, app.theme.fontSizeMedium);
        } else if (name == "Panel") {
            // Panel is a titleless container surface (fill + border + padding);
            // Titled() adds the header rule.
            Panel box = new Panel("panel");
            box.RenderInside(app, new Rect(px, py - app.Scale(20),
                                             w - app.Scale(36), app.Scale(96)));
            Rect content = box.Inner();
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "", Style.SNormal()),
                content.x, content.y, "Titleless container surface",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                content.x, content.y + app.Scale(26), "Group content here; reach for Card when a header is needed.",
                app.theme.textPrimary, app.theme.fontSizeMedium);
        } else if (name == "Tag") {
            // Row 1: colour variants.
            Tag.Chip(app, px, py, "Default", "");
            Tag.Chip(app, px + app.Scale(84), py, "Primary", "primary");
            Tag.Chip(app, px + app.Scale(168), py, "Info", "info");
            Tag.Chip(app, px + app.Scale(240), py, "Success", "success");
            Tag.Chip(app, px + app.Scale(330), py, "Warning", "warning");
            Tag.Chip(app, px + app.Scale(426), py, "Error", "error");
            // Row 2: interactive closable chips + an "+ Add" action.
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py + app.Scale(30), "Closable · click x to remove, + Add to append",
                app.theme.textPrimary, app.theme.fontSizeMedium);
            int ty2 = py + app.Scale(54);
            int tx = px;
            int ti = 0;
            while (ti < Gallery.demoTags.Count) {
                string tg = Gallery.demoTags[ti];
                int cid = Tag.ChipClosable(app, tx, ty2, tg, "primary");
                int tgw = Tag.ClosableWidth(app, tg, "primary");
                if (Ui.Clicked(app, cid)) {
                    Gallery.demoTags.RemoveAt(ti);
                    app.RequestRedraw();
                } else {
                    tx = tx + tgw + app.Scale(8);
                    ti = ti + 1;
                }
            }
            Button addBtn = new Button { Text = "+ Add",
                                        Class = "primary outline small" };
            int abId = addBtn.Render(app, tx, ty2 - app.Scale(2), app.Scale(64));
            if (Ui.Clicked(app, abId)) {
                Gallery.demoTags.Add("Tag " + Convert.ToString(Gallery.demoTags.Count + 1));
                app.RequestRedraw();
            }
        } else if (name == "DynamicTags") {
            // 保留实例：输入框里的草稿和增删结果跨帧存活。
            if (Gallery.dynTags == null) {
                DynamicTags dt = new DynamicTags();
                List<string> seed = new List<string>{ "调查中", "已发布" };
                dt.SetItems(seed);
                Gallery.dynTags = dt;
            }
            int before = Gallery.dynTags.Count();
            Gallery.dynTags.Render(app, px, py);
            if (Gallery.dynTags.Count() != before) {
                Gallery.Fired(app, name, "Change -> "
                    + Convert.ToString(Gallery.dynTags.Count()) + " tags");
            }
            app.canvas.DrawStyledText(
                Style.Of(app, "label", "secondary", Style.SNormal()),
                px, py + app.Scale(34),
                "Click '+ Add' for an inline input; Enter or an outside click commits, Esc cancels, x removes.",
                app.theme.textPrimary, app.theme.fontSizeMedium);
        } else if (name == "Avatar.text") {
            Flex row = Flex.Wrapped().Gap(app.Scale(20));
            row.With(new Avatar("A", 32, ""));
            row.With(new Avatar("Z", 42, ""));
            row.With(new Avatar("GK", 52, ""));
            Gallery.LayoutAuto(app, row, name, px, py,
                             w - app.Scale(36), app.Scale(60));
        } else if (name == "Avatar.icon") {
            Flex row = Flex.Wrapped().Gap(app.Scale(20));
            row.With(new Avatar("", 42, "user"));
            row.With(new Avatar("", 42, "settings"));
            Gallery.LayoutAuto(app, row, name, px, py,
                             w - app.Scale(36), app.Scale(52));
        } else if (name == "Image.datauri") {
            // base64 数据 URI 与内联 SVG 数据 URI：全部内存解码，
            // 不落盘。占位框显示 Alt 文本。
            Flex row = Flex.Wrapped().Gap(app.Scale(18));
            row.With(new Image(Gallery.DataUriPnm(), "base64 pnm", ""));
            row.With(new Image(Gallery.SvgDataUri(), "inline svg", ""));
            Gallery.LayoutAuto(app, row, name, px, py,
                             w - app.Scale(36), app.Scale(60));
        } else if (name == "Image.fit") {
            // 同一来源，四种 Fit 内嵌在 Flex 列里：contain 留白、
            // cover 裁剪铺满、fill 拉伸、none 原始尺寸居中。盒子尺寸
            // 来自皮肤类 fit-box，说明文字用 label.caption 参与测量，
            // 不手摆坐标、不直接绘制。
            string src = Gallery.DataUriPnm();
            Flex row = Flex.Wrapped().Gap(app.Scale(20));
            List<string> fits = new List<string>{
                "contain", "cover", "fill", "none" };
            for (int i = 0; i < fits.Count; i = i + 1) {
                Image im = new Image(src, "", fits[i]);
                im.Class = "fit-box";
                Panel cell = Panel.Column().Gap(app.Scale(6));
                cell.With(im);
                cell.With(new Label { Text = fits[i], Class = "caption" });
                row.With(cell);
            }
            Gallery.LayoutAuto(app, row, name, px, py,
                             w - app.Scale(36), app.Scale(160));
        } else if (name == "Image.url") {
            // http(s) 地址在后台线程取回，App.Post 封送回 UI 线程解码。
            // 本地 HttpServer 兜底，演示离线可跑；照片区放大到 560x300，
            // 二进制正文经 HttpClient 的字节安全通道取回。
            Gallery.EnsureImageServer();
            Panel col = Panel.Column().Gap(app.Scale(8));
            Image net = new Image("http://127.0.0.1:18747/img.pnm",
                                  "loading...", "");
            net.Loaded += () => app.RequestRedraw();
            net.Error += () => app.RequestRedraw();
            col.With(net);
            Image photoNet = new Image("http://127.0.0.1:18747/photo.jpeg",
                                       "loading 64KB photo...", "contain");
            photoNet.Class = "url-photo";
            photoNet.Loaded += () => app.RequestRedraw();
            photoNet.Error += () => app.RequestRedraw();
            col.With(photoNet);
            col.With(new Label {
                Text = "http://127.0.0.1:18747/{img.pnm, photo.jpeg} -- background fetch",
                Class = "caption" });
            Gallery.LayoutAuto(app, col, name, px, py,
                             w - app.Scale(36), app.Scale(430));
        } else if (name == "Image.photofit") {
            // 真实照片（600x415 / 800x450）放进比例失衡的固定盒子：
            // cover 的两个分支各裁一个轴（宽盒裁上下、高盒裁左右），
            // contain 完整显示留白。内嵌 Flex 列 + caption，说明文字
            // 参与测量；盒子要多大有多大，不再挤在小格里。
            List<string> photos = Gallery.PhotoSet();
            string photo = photos[0];
            Flex row = Flex.Wrapped().Gap(app.Scale(20));
            Panel c1 = Panel.Column().Gap(app.Scale(6));
            Image wide = new Image(photo, "", "cover");
            wide.Class = "photo-banner";
            c1.With(wide);
            c1.With(new Label {
                Text = "cover 560x300 -- crops top/bottom",
                Class = "caption" });
            row.With(c1);
            Panel c2 = Panel.Column().Gap(app.Scale(6));
            Image sq = new Image(photo, "", "cover");
            sq.Class = "photo-card";
            c2.With(sq);
            c2.With(new Label {
                Text = "cover 300x220 -- crops sides",
                Class = "caption" });
            row.With(c2);
            Panel c3 = Panel.Column().Gap(app.Scale(6));
            Image tall = new Image(photo, "", "cover");
            tall.Class = "photo-tall";
            c3.With(tall);
            c3.With(new Label {
                Text = "cover 220x340 -- crops sides",
                Class = "caption" });
            row.With(c3);
            Panel c4 = Panel.Column().Gap(app.Scale(6));
            Image cont = new Image(photo, "", "contain");
            cont.Class = "photo-wide";
            c4.With(cont);
            c4.With(new Label {
                Text = "contain 560x260 -- letterbox",
                Class = "caption" });
            row.With(c4);
            Gallery.LayoutAuto(app, row, name, px, py,
                             w - app.Scale(36), app.Scale(640));
        } else if (name == "Image.photoscale") {
            // 同一张 600x415 的照片缩到四个尺寸：缩小时对覆盖到的源
            // 像素做面积平均（box filter），细线不丢列，边缘不闪烁。
            // 各档宽高比与原图一致，差别只在像素密度。
            List<string> photos = Gallery.PhotoSet();
            string photo = photos[0];
            Flex row = Flex.Wrapped().Gap(app.Scale(20));
            List<string> boxes = new List<string>{
                "scale-360", "scale-240", "scale-160", "scale-80" };
            List<string> names = new List<string>{
                "600x415 -> 360x249", "-> 240x166", "-> 160x111",
                "-> 80x55" };
            for (int i = 0; i < boxes.Count; i = i + 1) {
                Image sim = new Image(photo, "", "fill");
                sim.Class = boxes[i];
                Panel cell = Panel.Column().Gap(app.Scale(6));
                cell.With(sim);
                cell.With(new Label { Text = names[i], Class = "caption" });
                row.With(cell);
            }
            Gallery.LayoutAuto(app, row, name, px, py,
                             w - app.Scale(36), app.Scale(320));
        } else if (name == "Image.carousel") {
            // naive-ui 轮播示例的那几张真实照片：Carousel 挂图片页
            // （AddSlideView 内嵌 Image 组件），cover 铺满、自动播放、
            // 滑动过渡；箭头与指示点是轮播自带的，这里只负责内嵌。
            if (Gallery.photoCarAnim == null) {
                Gallery.photoCarAnim = new CarouselAnim();
            }
            Carousel car = new Carousel(Gallery.carImgIdx);
            List<string> carPhotos = Gallery.PhotoSet();
            for (int i = 0; i < carPhotos.Count; i = i + 1) {
                Image slide = new Image(carPhotos[i], "", "cover");
                car.AddSlideView(slide);
            }
            car.autoplay = true;
            car.intervalMs = 3500;
            car.Animate(Gallery.photoCarAnim);
            car.Class = "photo-car";
            Panel col = Panel.Column().Gap(app.Scale(6));
            col.With(car);
            col.With(new Label {
                Text = "Image slides via AddSlideView -- autoplay 3.5s, cover-fit, arrows/dots built in",
                Class = "caption" });
            Gallery.LayoutAuto(app, col, name, px, py,
                             w - app.Scale(36), app.Scale(440));
        } else if (name == "Image.grid") {
            // 图片墙：示例照片按 cover 裁成统一比例的瓦片，
            // Flex.Wrapped 在窄窗口里自动折行。
            List<string> gridPhotos = Gallery.PhotoSet();
            Flex row = Flex.Wrapped().Gap(app.Scale(14));
            for (int i = 0; i < gridPhotos.Count; i = i + 1) {
                Image tile = new Image(gridPhotos[i], "", "cover");
                tile.Class = "photo-thumb";
                row.With(tile);
            }
            Gallery.LayoutAuto(app, row, name, px, py,
                             w - app.Scale(36), app.Scale(330));
        } else if (name == "Watermark.text") {
            // 水印盖在内容上：作为最后一个子节点 Grow() 铺满剩余空间，
            // 默认 -22° 倾斜、内置淡黑。多行文本整块一起倾斜。
            // 水印自身测量为 0×0（覆盖层不参与排版），宿主必须自己
            // 有高度——Prefer 定住文档框，Grow 的水印才有剩余空间可占。
            Panel doc = Panel.Column().Gap(app.Scale(8));
            doc.Class = "wm-doc";
            doc.Prefer(0, app.Scale(170));
            doc.With(new Label { Text = "Q3 business review (draft)", Class = "title" });
            doc.With(new Label {
                Text = "Numbers below are unaudited and still being reconciled.",
                Class = "caption" });
            doc.With(new Label { Text = "Content underneath stays visible and interactive.", Class = "caption" });
            Watermark wm = new Watermark("INTERNAL USE ONLY\nDo not distribute");
            wm.GapX = 80;
            wm.GapY = 64;
            doc.With(wm.Grow());
            Gallery.LayoutAuto(app, doc, name, px, py,
                             w - app.Scale(36), app.Scale(170));
        } else if (name == "Watermark.style") {
            // 颜色 / 字号 / 角度 / 间距都归调用方：品牌色水平平铺 +
            // 密间距，读起来更像表格底纹。宿主同样要自己定高度。
            Panel doc = Panel.Column().Gap(app.Scale(8));
            doc.Class = "wm-doc";
            doc.Prefer(0, app.Scale(170));
            doc.With(new Label { Text = "Console export", Class = "title" });
            doc.With(new Label { Text = "Rows 1-4,012 of 41,038 -- environment: staging.", Class = "caption" });
            Watermark wm = new Watermark("STAGING");
            wm.Color = 0x2E1890FF;
            wm.FontPx = 18;
            wm.Rotate = 0;
            wm.GapX = 44;
            wm.GapY = 36;
            doc.With(wm.Grow());
            Gallery.LayoutAuto(app, doc, name, px, py,
                             w - app.Scale(36), app.Scale(170));
        } else if (name == "Watermark.custom") {
            // 自定义水印：右侧配置面板的每个旋钮都双向绑到 model.wm*，
            // 水印每帧按字段现造——拖滑块/改输入的下一帧就是新样子，
            // 没有事件要接。预览文档与 antd 的自定义水印演示同构：
            // 标题 + 段落 + 轻量表格 + 图片，水印作为最后一个子节点
            // Grow() 盖在最上面。控件已在 Main 里建好（保留态），
            // 这里只负责摆进格子和按字段造水印。
            int cw = app.Scale(124);
            Panel conf = Panel.Column().Gap(app.Scale(10));
            Panel r1 = Panel.Row().Gap(app.Scale(12));
            r1.With(Gallery.WmCell(app,
                Gallery.T("Watermark content", "水印内容"),
                Gallery.wmTextInput, cw * 2 + app.Scale(12)));
            conf.With(r1);
            Panel r2 = Panel.Row().Gap(app.Scale(12));
            r2.With(Gallery.WmCell(app, Gallery.T("Font size", "字体大小"),
                Gallery.wmFontNum, cw));
            r2.With(Gallery.WmCell(app, Gallery.T("Font color", "字体颜色"),
                Gallery.wmColorInput, cw));
            conf.With(r2);
            Panel r3 = Panel.Row().Gap(app.Scale(12));
            r3.With(Gallery.WmCell(app, Gallery.T("Font weight", "字重"),
                Gallery.wmWeightSel, cw));
            r3.With(Gallery.WmCell(app, Gallery.T("Text align", "文本对齐"),
                Gallery.wmAlignSel, cw));
            conf.With(r3);
            Panel r4 = Panel.Row().Gap(app.Scale(12));
            r4.With(Gallery.WmCell(app,
                Gallery.T("Rotate (-90 ~ 90)", "旋转角度（-90 ~ 90）"),
                Gallery.wmRotateSld, cw * 2 + app.Scale(12)));
            conf.With(r4);
            Panel r5 = Panel.Row().Gap(app.Scale(12));
            r5.With(Gallery.WmCell(app,
                Gallery.T("Line height (0 = auto)", "行高（0 = 默认）"),
                Gallery.wmLineHNum, cw));
            r5.With(Gallery.WmCell(app,
                Gallery.T("Tile width (0 = auto)", "贴片宽（0 = 自适应）"),
                Gallery.wmTileWNum, cw));
            conf.With(r5);
            Panel r6 = Panel.Row().Gap(app.Scale(12));
            r6.With(Gallery.WmCell(app,
                Gallery.T("Tile height (0 = auto)", "贴片高（0 = 自适应）"),
                Gallery.wmTileHNum, cw));
            r6.With(Gallery.WmCell(app, Gallery.T("Gap X", "X 轴间隔"),
                Gallery.wmGapXNum, cw));
            conf.With(r6);
            Panel r7 = Panel.Row().Gap(app.Scale(12));
            r7.With(Gallery.WmCell(app, Gallery.T("Gap Y", "Y 轴间隔"),
                Gallery.wmGapYNum, cw));
            r7.With(Gallery.WmCell(app, Gallery.T("Offset X", "X 轴偏移"),
                Gallery.wmOffXNum, cw));
            conf.With(r7);
            Panel r8 = Panel.Row().Gap(app.Scale(12));
            r8.With(Gallery.WmCell(app, Gallery.T("Offset Y", "Y 轴偏移"),
                Gallery.wmOffYNum, cw));
            r8.With(Gallery.WmCell(app,
                Gallery.T("Cross boundary", "是否跨越边界"),
                Gallery.wmClipSw, 0));
            conf.With(r8);
            // 左侧预览：定住高度（水印测量 0×0，Grow 才有剩余空间可
            // 占），内容只是给水印垫背景的——真正的主角是水印层。
            Panel doc = Panel.Column().Gap(app.Scale(8));
            doc.Class = "wm-doc";
            doc.Prefer(0, app.Scale(470));
            doc.Grow();
            doc.With(new Label {
                Text = Gallery.T("Q3 business review", "三季度经营复盘"),
                Class = "title" });
            doc.With(new Label {
                Text = Gallery.T(
                    "Numbers below are unaudited and still being reconciled; figures lock once finance closes the books.",
                    "以下数字未经审计、仍在核对口径，财务关账后锁定。"),
                Class = "paragraph" });
            int cw0 = app.Scale(96);
            int cw1 = app.Scale(72);
            int cw2 = app.Scale(64);
            Panel tbl = Panel.Column().Gap(0);
            Panel th = Panel.Row().Gap(0);
            th.With(new Label { Text = Gallery.T("Metric", "指标"), Class = "caption" }
                .Prefer(cw0, 0));
            th.With(new Label { Text = Gallery.T("This quarter", "本季"), Class = "caption" }
                .Prefer(cw1, 0));
            th.With(new Label { Text = Gallery.T("QoQ", "环比"), Class = "caption" }
                .Prefer(cw2, 0));
            tbl.With(th);
            for (int i = 0; i < 3; i = i + 1) {
                string m;
                string q;
                string d;
                if (i == 0) {
                    m = Gallery.T("Revenue", "营收");
                    q = "¥ 12.8M";
                    d = "+8.2%";
                } else if (i == 1) {
                    m = Gallery.T("Active users", "活跃用户");
                    q = "1.24M";
                    d = "+3.1%";
                } else {
                    m = Gallery.T("NPS", "净推荐值");
                    q = "54";
                    d = "-2";
                }
                Panel tr = Panel.Row().Gap(0);
                tr.With(new Label { Text = m, Class = "secondary" }.Prefer(cw0, 0));
                tr.With(new Label { Text = q, Class = "secondary" }.Prefer(cw1, 0));
                tr.With(new Label { Text = d, Class = "secondary" }.Prefer(cw2, 0));
                tbl.With(tr);
            }
            doc.With(tbl);
            Image ph = new Image(Gallery.PhotoSet()[0], "", "cover");
            ph.Class = "photo-thumb";
            doc.With(ph);
            Watermark wm = new Watermark(Gallery.model.wmText);
            wm.Color = Gallery.WmColorParse(Gallery.model.wmColor);
            wm.FontPx = Gallery.model.wmFontPx;
            if (Gallery.model.wmWeight == 1) { wm.Weight = 600; }
            wm.Rotate = Gallery.model.wmRotate;
            wm.LineHeight = Gallery.model.wmLineH;
            wm.TileW = Gallery.model.wmTileW;
            wm.TileH = Gallery.model.wmTileH;
            wm.GapX = Gallery.model.wmGapX;
            wm.GapY = Gallery.model.wmGapY;
            wm.OffsetX = Gallery.model.wmOffX;
            wm.OffsetY = Gallery.model.wmOffY;
            wm.TextAlign = Gallery.model.wmAlign;
            wm.NoClip = Gallery.model.wmNoClip;
            doc.With(wm.Grow());
            // 参考版式：预览在左（吃掉剩余宽），配置面板靠右。Row 用
            // flex 而不是 dock 面板——加满顺序 = 视觉顺序，Grow 原地
            // 扩展，不会像 dock fill 那样被排到非 grow 兄弟的后面。
            Flex host = Flex.Row().Gap(app.Scale(16));
            host.With(doc.Grow());
            host.With(conf);
            Gallery.LayoutAuto(app, host, name, px, py,
                             w - app.Scale(36), app.Scale(470));
        } else if (name == "Badge.dot") {
            Flex row = Flex.Wrapped().Gap(app.Scale(14));
            row.With(new Badge(0));
            row.With(new Label { Text = "unread / active", Class = "secondary" });
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(2),
                             w - app.Scale(36), app.Scale(30));
        } else if (name == "Badge.count") {
            Flex row = Flex.Wrapped().Gap(app.Scale(14));
            row.With(new Badge(5));
            row.With(new Badge(12));
            row.With(new Badge(99));
            row.With(new Badge(120));
            Gallery.LayoutAuto(app, row, name, px, py,
                             w - app.Scale(36), app.Scale(30));
        } else if (name == "Statistic") {
            Statistic st1 = new Statistic("Active users", "12,480");
            Statistic st2 = new Statistic("Deploys", "1,024");
            st2.Class = "success";
            Statistic st3 = new Statistic("Errors", "3");
            st3.Class = "error";
            Flex row = Flex.Wrapped().Gap(app.Scale(24));
            row.With(st1); row.With(st2); row.With(st3);
            Gallery.LayoutAuto(app, row, name, px, py - app.Scale(8),
                             w - app.Scale(36), app.Scale(70));
        } else if (name == "Upload") {
            Panel ucol = Panel.Column().Gap(app.Scale(8));
            ucol.With(Gallery.demoUploadBasic);
            Gallery.LayoutAuto(app, ucol, name, px, py,
                             w - app.Scale(36), app.Scale(120));
        } else if (name == "Upload.manual") {
            Panel ucol = Panel.Column().Gap(app.Scale(8));
            ucol.With(Gallery.demoUploadManual);
            Panel ubtns = Panel.Row().Gap(app.Scale(10));
            ubtns.With(Gallery.demoUploadSubmitBtn);
            ucol.With(ubtns);
            Gallery.LayoutAuto(app, ucol, name, px, py,
                             w - app.Scale(36), app.Scale(140));
        } else if (name == "Upload.callback") {
            Panel ucol = Panel.Column().Gap(app.Scale(8));
            ucol.With(Gallery.demoUploadCb);
            ucol.With(Gallery.demoUploadCbLabel);
            Gallery.LayoutAuto(app, ucol, name, px, py,
