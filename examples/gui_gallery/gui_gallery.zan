            // A second sankey: user journey through a funnel.
            ChartOption sk2 = ChartOption.Of(Gallery.T("User journey", "用户旅程"), null,
                new List<ChartSeries>{
                    ChartSeries.OfLinks(Gallery.T("Journey", "旅程"), new List<ChartLink>{
                        ChartLink.Of(Gallery.T("Visit", "访问"), Gallery.T("Browse", "浏览"), 1000),
