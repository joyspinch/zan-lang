                Gallery.demoQrLvM, Gallery.demoQrLvQ, Gallery.demoQrLvH };
            List<string> lnames = new List<string>{ "L (~7%)", "M (~15%)",
                "Q (~25%)", "H (~30%)" };
            for (int li = 0; li < lqrs.Count; li = li + 1) {
                Panel cell = Panel.Column().Gap(app.Scale(4));
