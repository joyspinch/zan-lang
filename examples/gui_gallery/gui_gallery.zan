            ucol.With(Gallery.demoUploadWall);
            Gallery.LayoutAuto(app, ucol, name, px, py,
                             w - app.Scale(36), app.Scale(230));
        } else if (name == "Countdown") {
            // 三种格式与三档字号；第三只归零后由 Finish 翻成 error 色。
            Flex crow = Flex.Wrapped().Gap(app.Scale(28));
            crow.With(Gallery.demoCountdownA);
            crow.With(Gallery.demoCountdownB);
            crow.With(Gallery.demoCountdownC);
            Gallery.LayoutAuto(app, crow, name, px, py,
                             w - app.Scale(36), app.Scale(44));
        } else if (name == "Countdown.controls") {
            Panel ccol = Panel.Column().Gap(app.Scale(10));
            ccol.With(Gallery.demoCountdownCtl);
            Panel cbtns = Panel.Row().Gap(app.Scale(10));
            cbtns.With(Gallery.demoCountdownPause);
            cbtns.With(Gallery.demoCountdownRestart);
            ccol.With(cbtns);
            ccol.With(Gallery.demoCountdownStatus);
            Gallery.LayoutAuto(app, ccol, name, px, py,
                             w - app.Scale(36), app.Scale(108));
        } else if (name == "Countdown.multi") {
            // 五只倒计时同屏：三档节奏混跑的高频重绘压力页。
            Flex mrow = Flex.Wrapped().Gap(app.Scale(28));
            mrow.With(Gallery.demoCountdownM1);
            mrow.With(Gallery.demoCountdownM2);
            mrow.With(Gallery.demoCountdownM3);
            mrow.With(Gallery.demoCountdownM4);
            mrow.With(Gallery.demoCountdownM5);
            Gallery.LayoutAuto(app, mrow, name, px, py,
                             w - app.Scale(36), app.Scale(108));
        } else if (name == "Countdown.styles") {
            // 角色类只给进度条换色，large 档放大数字；默认档做对照。
            Flex srow = Flex.Wrapped().Gap(app.Scale(28));
            srow.With(Gallery.demoCountdownPlain);
            srow.With(Gallery.demoCountdownOk);
            srow.With(Gallery.demoCountdownWarn);
            srow.With(Gallery.demoCountdownErr);
            srow.With(Gallery.demoCountdownLarge);
            Gallery.LayoutAuto(app, srow, name, px, py,
                             w - app.Scale(36), app.Scale(108));
        } else if (name == "Countdown.scenes") {
            // 真实布局：说明文案叠倒计时（Panel 列），令牌夹字面量。
            Panel sceneRow = Panel.Row().Gap(app.Scale(44));
            Panel sc1 = Panel.Column().Gap(app.Scale(6));
            sc1.With(new Label {
                Text = Gallery.T("Flash sale ends in", "距限时抢购结束"),
                Class = "hint" });
            sc1.With(Gallery.demoCountdownFlash);
            Panel sc2 = Panel.Column().Gap(app.Scale(6));
            sc2.With(new Label {
                Text = Gallery.T("Until 3.0 ships", "距 3.0 发布"),
                Class = "hint" });
            sc2.With(Gallery.demoCountdownLaunch);
            Panel sc3 = Panel.Column().Gap(app.Scale(6));
            sc3.With(new Label {
                Text = Gallery.T("Hourly flash deal", "整点秒杀"),
                Class = "hint" });
            sc3.With(Gallery.demoCountdownSale);
            sceneRow.With(sc1);
            sceneRow.With(sc2);
            sceneRow.With(sc3);
            Gallery.LayoutAuto(app, sceneRow, name, px, py,
                             w - app.Scale(36), app.Scale(96));
        } else if (name == "NumberAnimation") {
            // 三只同框：默认 / large / small 三档字号。
            Flex nrow = Flex.Wrapped().Gap(app.Scale(28));
