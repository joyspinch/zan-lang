using System;
using System.IO;
using System.Json;
using System.Diagnostics;
using System.Net.Sockets;
using System.Threading;

/// Minimal MCP (Model Context Protocol) server for the Zan IDE project,
/// using the streamable-HTTP transport: external AI tools POST JSON-RPC
/// to http://127.0.0.1:8848/ (methods: initialize, tools/list, tools/call).
///
/// Run it from the project root (the IDE Tools pane runs tools there).
/// Exposed tools (all sandboxed to the current project root):
///   list_files(path)          - list a project directory
///   read_file(path)           - read a project file
///   write_file(path, content) - write a project file
///   build()                   - zanc build of src/main.zan (template layout)
///   zan_api_search(query)      - search the generated stdlib symbol index
///   zan_example(topic)         - return a verified golden template/example
///   zan_compile(filename,content) - compile one snippet, structured diagnostics
///   zan_build_project(entry)   - compile the synced project, structured diagnostics
///
/// SECURITY: every path is validated to stay inside the project root (no
/// absolute paths, no `..` traversal). Pass `--token <secret>` to require an
/// `Authorization: Bearer <secret>` header on every request (use this whenever
/// the endpoint is reachable beyond localhost).

// ---- MCP protocol entities -------------------------------------------------
// Fixed-shape JSON-RPC result bodies are declared as classes and serialized
// with Json.Serialize<T>. The dynamic parts stay JsonValue: `inputSchema`
// because its `properties` are a key->schema map, `capabilities` because it
// is a sparse member map, and the JSON-RPC envelope `id`/`result`/`error`
// because id may be a number or string and result/error are mutually
// exclusive (a DTO would emit the unused one as null).

class McpToolDoc {
    string name;
    string description;
    JsonValue inputSchema;
}

class McpToolsDoc {
    List<McpToolDoc> tools;
}

class McpServerInfoDoc {
    string name;
    string version;
}

class McpInitializeResultDoc {
    string protocolVersion;
    JsonValue capabilities;
    McpServerInfoDoc serverInfo;
}

class McpContentItemDoc {
    string type;
    string text;
}

class McpCallToolResultDoc {
    List<McpContentItemDoc> content;
}

class McpServer {
    static string root;
    static string token;
    static string indexPath;
    static string galleryPath;
    static string workRoot;
    static string zancPath;
    static string stdlibPath;
    static int compileSeq;

    static void Main() {
        McpServer.root = ".";
        McpServer.token = "";
        McpServer.zancPath = "zanc";
        McpServer.stdlibPath = "";
        McpServer.compileSeq = 0;
        int i = 0;
        while (i < Environment.ArgCount()) {
            string a = Environment.ArgAt(i);
            if (a == "--token" && i + 1 < Environment.ArgCount()) {
                McpServer.token = Environment.ArgAt(i + 1);
                i = i + 2;
                continue;
            }
            if (a == "--zanc" && i + 1 < Environment.ArgCount()) {
                McpServer.zancPath = Environment.ArgAt(i + 1);
                i = i + 2;
                continue;
            }
            if (a == "--stdlib" && i + 1 < Environment.ArgCount()) {
                McpServer.stdlibPath = Environment.ArgAt(i + 1);
                i = i + 2;
                continue;
            }
            if (a.Length >= 2 && a.Substring(0, 2) == "--") { i = i + 1; continue; }
            McpServer.root = a;
            i = i + 1;
        }
        McpServer.indexPath = McpServer.root + "/.zanmap/symbols.json";
        McpServer.galleryPath = McpServer.root + "/examples/mcp_server/gallery.json";
        McpServer.workRoot = McpServer.root + "/_scratch/mcp_compile";
        if (McpServer.stdlibPath == "") { McpServer.stdlibPath = McpServer.root + "/stdlib"; }
        Console.WriteLine("Zan MCP server: project root = " + McpServer.root);
        Console.WriteLine("zanc = " + McpServer.zancPath + "; stdlib = " + McpServer.stdlibPath);
        if (McpServer.token != "") { Console.WriteLine("Auth: Bearer token required"); }
        Console.WriteLine("MCP endpoint: http://127.0.0.1:8848/ (streamable HTTP JSON-RPC)");
        int r = await McpServer.Serve();
    }

    static async int Serve() {
        Socket.Initialize();
        nint listener = Socket.CreateTcp();
        Socket.SetReuseAddr(listener);
        Socket.Bind(listener, "127.0.0.1", 8848);
        Socket.Listen(listener, 16);
        Socket.SetNonBlocking(listener);
        while (true) {
            nint client = await AsyncSocket.Accept(listener);
            Socket.SetNonBlocking(client);
            Task.Spawn(McpServer.HandleConn(client));
        }
        return 0;
    }

    /// One request per connection ("Connection: close"): reads the request
    /// until Content-Length bytes of body have arrived, answers, closes.
    static async void HandleConn(nint client) {
        string raw = "";
        int need = 0 - 1;
        for (int rounds = 0; rounds < 200; rounds = rounds + 1) {
            string chunk = await AsyncSocket.Receive(client, 65536);
            if (chunk.Length == 0) { break; }
            raw = raw + chunk;
            int hdrEnd = McpServer.Find(raw, "\r\n\r\n");
            if (hdrEnd >= 0) {
                if (need < 0) { need = McpServer.ContentLength(raw); }
                if (raw.Length - hdrEnd - 4 >= need) { break; }
            }
        }
        string body = "";
        int he = McpServer.Find(raw, "\r\n\r\n");
        if (he >= 0) { body = raw.Substring(he + 4, raw.Length - he - 4); }
        string method = "GET";
        if (raw.Length >= 4 && raw.Substring(0, 4) == "POST") { method = "POST"; }
        if (McpServer.token != "" && !McpServer.AuthOk(raw)) {
            string err = "{\"error\": \"unauthorized\"}";
            string r401 = "HTTP/1.1 401 Unauthorized\r\nContent-Type: application/json\r\n"
                + "Content-Length: " + Convert.ToString(err.Length)
                + "\r\nConnection: close\r\n\r\n" + err;
            int _u = await AsyncSocket.SendString(client, r401);
            Socket.Close(client);
            return;
        }
        string respBody = McpServer.Handle(method, body);
        string resp = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n"
            + "Content-Length: " + Convert.ToString(respBody.Length)
            + "\r\nConnection: close\r\n\r\n" + respBody;
        int _sent = await AsyncSocket.SendString(client, resp);
        Socket.Close(client);
    }

    /// First index of `pat` in `s`, or -1.
    static int Find(string s, string pat) {
        if (pat.Length == 0 || s.Length < pat.Length) { return 0 - 1; }
        for (int i = 0; i <= s.Length - pat.Length; i = i + 1) {
            if (s.Substring(i, pat.Length) == pat) { return i; }
        }
        return 0 - 1;
    }

    static int ContentLength(string raw) {
        int p = McpServer.Find(raw, "Content-Length:");
        if (p < 0) { p = McpServer.Find(raw, "content-length:"); }
        if (p < 0) { return 0; }
        int i = p + 15;
        while (i < raw.Length && raw.Substring(i, 1) == " ") { i = i + 1; }
        int n = 0;
        while (i < raw.Length) {
            string ch = raw.Substring(i, 1);
            if (ch < "0" || ch > "9") { break; }
            n = n * 10 + Convert.ToInt32(ch);
            i = i + 1;
        }
        return n;
    }

    static string Handle(string method, string body) {
        if (method != "POST") {
            return "{\"error\": \"POST JSON-RPC to this endpoint\"}";
        }
        JsonValue v = JsonValue.ParseLenient(body);
        if (v == null) {
            return McpServer.RpcError("null", 0 - 32700, "parse error");
        }
        string id = v.Str("id", "");
        JsonValue idv = v.Get("id");
        if (idv != null) { id = idv.AsString(id); }
        string rpc = v.Str("method", "");
        if (rpc == "initialize") {
            McpInitializeResultDoc result = new McpInitializeResultDoc();
            result.protocolVersion = "2024-11-05";
            result.capabilities = JsonValue.NewObject();
            result.capabilities.Put("tools", JsonValue.NewObject());
            result.serverInfo = new McpServerInfoDoc();
            result.serverInfo.name = "zan-ide-mcp";
            result.serverInfo.version = "1.0";
            return McpServer.RpcResult(id,
                Json.Serialize<McpInitializeResultDoc>(result));
        }
        if (rpc == "notifications/initialized" || rpc == "initialized") {
            return "{}";
        }
        if (rpc == "tools/list") {
            return McpServer.RpcResult(id, McpServer.ToolsJson());
        }
        if (rpc == "tools/call") {
            JsonValue p = v.Get("params");
            string name = "";
            JsonValue targs = null;
            if (p != null) {
                name = p.Str("name", "");
                targs = p.Get("arguments");
            }
            string text = McpServer.CallTool(name, targs);
            McpCallToolResultDoc result = new McpCallToolResultDoc();
            result.content = new List<McpContentItemDoc>();
            McpContentItemDoc item = new McpContentItemDoc();
            item.type = "text";
            item.text = text;
            result.content.Add(item);
            return McpServer.RpcResult(id,
                Json.Serialize<McpCallToolResultDoc>(result));
        }
        return McpServer.RpcError(id, 0 - 32601, "method not found: " + rpc);
    }

    static string CallTool(string name, JsonValue args) {
        string path = "";
        if (args != null) { path = args.Str("path", ""); }
        if (name == "list_files") {
            string full = McpServer.Safe(path);
            if (full == "") { return "error: path outside project root"; }
            List<string> dirs = Directory.GetDirectories(full);
            List<string> files = Directory.GetFiles(full);
            StringBuilder sb = new StringBuilder();
            int i = 0;
            for (; i < dirs.Count; i = i + 1) { sb.Append(dirs[i] + "/\n"); }
            i = 0;
            while (i < files.Count) { sb.Append(files[i] + "\n"); i = i + 1; }
            return sb.ToString();
        }
        if (name == "read_file") {
            string full = McpServer.Safe(path);
            if (full == "") { return "error: path outside project root"; }
            if (!File.Exists(full)) { return "error: file not found: " + path; }
            return File.ReadAllText(full);
        }
        if (name == "write_file") {
            string full = McpServer.Safe(path);
            if (full == "") { return "error: path outside project root"; }
            string content = "";
            if (args != null) { content = args.Str("content", ""); }
            File.WriteAllText(full, content);
            return "ok: wrote " + path;
        }
        if (name == "build") {
            List<string> outp = Process.RunCapture(
                "cd \"" + McpServer.root + "\" && zanc build src/main.zan 2>&1");
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < outp.Count; i = i + 1) { sb.Append(outp[i] + "\n"); }
            return sb.ToString();
        }
        if (name == "zan_api_search") {
            string query = "";
            if (args != null) { query = args.Str("query", ""); }
            int limit = 40;
            if (args != null) {
                string lim = args.Str("limit", "");
                if (lim != "") { limit = McpServer.ParseInt(lim, 40); }
            }
            return McpServer.ApiSearch(query, limit);
        }
        if (name == "zan_example") {
            string topic = "";
            if (args != null) { topic = args.Str("topic", ""); }
            return McpServer.Example(topic);
        }
        if (name == "zan_compile") {
            string fn = "";
            string content = "";
            if (args != null) {
                fn = args.Str("filename", "");
                content = args.Str("content", "");
            }
            return McpServer.Compile(fn, content);
        }
        if (name == "zan_build_project") {
            string entry = "src/main.zan";
            if (args != null) {
                string e = args.Str("entry", "");
                if (e != "") { entry = e; }
            }
            return McpServer.BuildProject(entry);
        }
        return "error: unknown tool " + name;
    }

    // ---- Auth ---------------------------------------------------------------
    static bool AuthOk(string raw) {
        string want = "Bearer " + McpServer.token;
        return McpServer.Find(raw, want) >= 0;
    }

    static int ParseInt(string s, int dflt) {
        int n = 0;
        bool any = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch < "0" || ch > "9") { return dflt; }
            n = n * 10 + Convert.ToInt32(ch);
            any = true;
        }
        if (!any) { return dflt; }
        return n;
    }

    // ---- zan_api_search -----------------------------------------------------
    // Line-oriented scan of the RepoMap symbol index (one JSON object per
    // line: {name,kind,file,line,sig}). Case-insensitive substring match on
    // the whole record so both symbol names and signatures are searchable.
    static string ApiSearch(string query, int limit) {
        if (query == "") { return "error: 'query' is required"; }
        if (!File.Exists(McpServer.indexPath)) {
            return "error: symbol index not found at .zanmap/symbols.json. "
                + "Generate it once with: zanc tools/repomap/RepoMap.zan "
                + "--auto-stdlib -o repomap.exe  then  repomap.exe stdlib";
        }
        List<string> lines = File.ReadAllLines(McpServer.indexPath);
        JsonValue results = JsonValue.NewArray();
        int found = 0;
        for (int i = 0; i < lines.Count; i = i + 1) {
            if (found >= limit) { break; }
            string line = lines[i];
            if (McpServer.Find(line, "\"name\"") < 0) { continue; }
            if (McpServer.Find(line, query) < 0) { continue; }
            string trimmed = line;
            if (trimmed.Length > 0 && trimmed.Substring(trimmed.Length - 1, 1) == ",") {
                trimmed = trimmed.Substring(0, trimmed.Length - 1);
            }
            JsonValue rec = JsonValue.ParseLenient(trimmed);
            if (rec == null) { continue; }
            results.Append(rec);
            found = found + 1;
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("query", JsonValue.NewStr(query));
        o.Put("count", JsonValue.NewNum(Convert.ToString(found)));
        o.Put("results", results);
        if (found == 0) {
            o.Put("hint", JsonValue.NewStr(
                "no match; try a shorter symbol fragment, e.g. 'Button' or 'App.Create'"));
        }
        return o.ToJson();
    }

    // ---- zan_example --------------------------------------------------------
    // Returns a shipped, build-verified template/example verbatim. With no
    // topic it lists the catalog. Agents copy the returned file(s) rather
    // than inventing API usage.
    static string Example(string topic) {
        if (!File.Exists(McpServer.galleryPath)) {
            return "error: gallery.json not found at examples/mcp_server/gallery.json";
        }
        JsonValue man = JsonValue.ParseLenient(File.ReadAllText(McpServer.galleryPath));
        if (man == null) { return "error: gallery.json is not valid JSON"; }
        JsonValue entries = man.Get("entries");
        if (entries == null) { return "error: gallery.json has no 'entries'"; }
        if (topic == "") {
            JsonValue list = JsonValue.NewArray();
            for (int i = 0; i < entries.Count(); i = i + 1) {
                JsonValue e = entries.At(i);
                JsonValue row = JsonValue.NewObject();
                row.Put("topic", JsonValue.NewStr(e.Str("topic", "")));
                row.Put("kind", JsonValue.NewStr(e.Str("kind", "")));
                row.Put("summary", JsonValue.NewStr(e.Str("summary", "")));
                list.Append(row);
            }
            JsonValue o = JsonValue.NewObject();
            o.Put("topics", list);
            o.Put("usage", JsonValue.NewStr(
                "call zan_example with one of these 'topic' values to get the files"));
            return o.ToJson();
        }
        JsonValue match = McpServer.MatchEntry(entries, topic);
        if (match == null) {
            return "error: no example for topic '" + topic
                + "'. Call zan_example with no topic to list the catalog.";
        }
        string kind = match.Str("kind", "");
        JsonValue o = JsonValue.NewObject();
        o.Put("topic", JsonValue.NewStr(match.Str("topic", "")));
        o.Put("kind", JsonValue.NewStr(kind));
        o.Put("summary", JsonValue.NewStr(match.Str("summary", "")));
        o.Put("build", JsonValue.NewStr(match.Str("build", "")));
        JsonValue models = man.Get("models");
        if (models != null && models.Has(kind)) {
            o.Put("model", models.Get(kind));
        }
        JsonValue files = match.Get("files");
        JsonValue outFiles = JsonValue.NewArray();
        if (files != null) {
            for (int i = 0; i < files.Count(); i = i + 1) {
                string rel = files.At(i).AsString("");
                JsonValue fo = JsonValue.NewObject();
                fo.Put("path", JsonValue.NewStr(rel));
                string full = McpServer.root + "/" + rel;
                if (File.Exists(full)) {
                    fo.Put("content", JsonValue.NewStr(File.ReadAllText(full)));
                } else {
                    fo.Put("error", JsonValue.NewStr("file missing on server"));
                }
                outFiles.Append(fo);
            }
        }
        o.Put("files", outFiles);
        return o.ToJson();
    }

    static JsonValue MatchEntry(JsonValue entries, string topic) {
        for (int i = 0; i < entries.Count(); i = i + 1) {
            if (entries.At(i).Str("topic", "") == topic) { return entries.At(i); }
        }
        for (int i = 0; i < entries.Count(); i = i + 1) {
            if (McpServer.Find(entries.At(i).Str("topic", ""), topic) >= 0) {
                return entries.At(i);
            }
        }
        return null;
    }

    // ---- zan_compile --------------------------------------------------------
    // Writes one snippet into an isolated work dir and compiles it with the
    // shipped zanc, returning structured diagnostics. filename must be a bare
    // name (no path separators / traversal).
    static string Compile(string filename, string content) {
        if (filename == "") { filename = "snippet.zan"; }
        if (!McpServer.IsBareName(filename)) {
            return "error: filename must be a bare file name with no path separators";
        }
        McpServer.compileSeq = McpServer.compileSeq + 1;
        string dir = McpServer.workRoot + "/" + Convert.ToString(McpServer.compileSeq);
        Directory.CreateDirectoryRecursive(dir);
        File.WriteAllText(dir + "/" + filename, content);
        // Paths are relative to the server's working directory (project root),
        // so no `cd` -- that keeps stdlib/output resolution cwd-independent.
        List<string> lines = Process.RunCapture(
            "\"" + McpServer.zancPath + "\" \"" + dir + "/" + filename
            + "\" --stdlib-path \"" + McpServer.stdlibPath + "\" -o \""
            + dir + "/out.exe\" 2>&1");
        bool ok = File.Exists(dir + "/out.exe");
        return McpServer.DiagResult(ok, lines);
    }

    static string BuildProject(string entry) {
        string full = McpServer.Safe(entry);
        if (full == "") { return "error: entry path outside project root"; }
        List<string> lines = Process.RunCapture(
            "\"" + McpServer.zancPath + "\" \"" + full
            + "\" --stdlib-path \"" + McpServer.stdlibPath + "\" -o \""
            + McpServer.root + "/_scratch/mcp_project_out.exe\" 2>&1");
        bool ok = File.Exists(McpServer.root + "/_scratch/mcp_project_out.exe");
        return McpServer.DiagResult(ok, lines);
    }

    static bool IsBareName(string s) {
        if (s == "") { return false; }
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == "/" || ch == "\\") { return false; }
        }
        for (int i = 0; i + 1 < s.Length; i = i + 1) {
            if (s.Substring(i, 2) == "..") { return false; }
        }
        return true;
    }

    // Turns raw zanc output into {ok, diagnostics:[{location,line,col,severity,
    // message}], raw}. Recognizes 'error:' / 'warning:' / 'note:' markers.
    static string DiagResult(bool ok, List<string> lines) {
        JsonValue diags = JsonValue.NewArray();
        StringBuilder rawSb = new StringBuilder();
        for (int i = 0; i < lines.Count; i = i + 1) {
            string line = McpServer.StripAnsi(lines[i]);
            rawSb.Append(line + "\n");
            string sev = "";
            int pos = McpServer.Find(line, " error:");
            if (pos >= 0) { sev = "error"; }
            if (sev == "") {
                pos = McpServer.Find(line, " warning:");
                if (pos >= 0) { sev = "warning"; }
            }
            if (sev == "") {
                pos = McpServer.Find(line, " note:");
                if (pos >= 0) { sev = "note"; }
            }
            if (sev == "") { continue; }
            string loc = line.Substring(0, pos);
            if (loc.Length > 0 && loc.Substring(loc.Length - 1, 1) == ":") {
                loc = loc.Substring(0, loc.Length - 1);
            }
            int markerLen = sev.Length + 2;
            string msg = line.Substring(pos + markerLen, line.Length - pos - markerLen);
            JsonValue d = JsonValue.NewObject();
            d.Put("severity", JsonValue.NewStr(sev));
            d.Put("location", JsonValue.NewStr(loc));
            McpServer.PeelLineCol(loc, d);
            d.Put("message", JsonValue.NewStr(McpServer.Trim(msg)));
            diags.Append(d);
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("ok", JsonValue.NewBool(ok));
        o.Put("diagnostics", diags);
        o.Put("raw", JsonValue.NewStr(rawSb.ToString()));
        return o.ToJson();
    }

    // Removes ANSI SGR sequences (ESC '[' ... final-letter). Zan string
    // literals can't encode ESC (0x1b), so ESC is detected as a control byte
    // (< space) immediately followed by '['. zanc always colorizes its output.
    static string StripAnsi(string s) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch < " " && i + 1 < s.Length && s.Substring(i + 1, 1) == "[") {
                i = i + 2;
                while (i < s.Length) {
                    string c2 = s.Substring(i, 1);
                    i = i + 1;
                    if ((c2 >= "A" && c2 <= "Z") || (c2 >= "a" && c2 <= "z")) { break; }
                }
                continue;
            }
            sb.Append(ch);
            i = i + 1;
        }
        return sb.ToString();
    }

    // Extracts trailing :line:col from a 'file:line:col' location string.
    static void PeelLineCol(string loc, JsonValue d) {
        int c2 = McpServer.LastColon(loc);
        if (c2 < 0) { return; }
        string colStr = loc.Substring(c2 + 1, loc.Length - c2 - 1);
        string head = loc.Substring(0, c2);
        int c1 = McpServer.LastColon(head);
        if (c1 < 0) { return; }
        string lineStr = head.Substring(c1 + 1, head.Length - c1 - 1);
        if (McpServer.AllDigits(colStr) && McpServer.AllDigits(lineStr)) {
            d.Put("file", JsonValue.NewStr(head.Substring(0, c1)));
            d.Put("line", JsonValue.NewNum(lineStr));
            d.Put("col", JsonValue.NewNum(colStr));
        }
    }

    static int LastColon(string s) {
        for (int i = s.Length - 1; i >= 0; i = i - 1) {
            if (s.Substring(i, 1) == ":") { return i; }
        }
        return 0 - 1;
    }

    static bool AllDigits(string s) {
        if (s.Length == 0) { return false; }
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch < "0" || ch > "9") { return false; }
        }
        return true;
    }

    static string Trim(string s) {
        int a = 0;
        int b = s.Length;
        while (a < b && s.Substring(a, 1) == " ") { a = a + 1; }
        while (b > a && s.Substring(b - 1, 1) == " ") { b = b - 1; }
        return s.Substring(a, b - a);
    }

    /// Resolves a project-relative path, rejecting absolute paths and any
    /// `..` traversal so access stays inside the project root.
    static string Safe(string rel) {
        if (rel.Length > 0 && (rel.Substring(0, 1) == "/" || rel.Substring(0, 1) == "\\")) {
            return "";
        }
        if (rel.Length > 1 && rel.Substring(1, 1) == ":") { return ""; }
        for (int i = 0; i + 1 < rel.Length; i = i + 1) {
            if (rel.Substring(i, 2) == "..") { return ""; }
        }
        if (rel == "..") { return ""; }
        if (rel == "" || rel == ".") { return McpServer.root; }
        return McpServer.root + "/" + rel;
    }

    static string ToolsJson() {
        McpToolsDoc o = new McpToolsDoc();
        o.tools = new List<McpToolDoc>();
        o.tools.Add(McpServer.Tool("list_files",
            "List a directory inside the Zan project (path is project-relative).",
            "path"));
        o.tools.Add(McpServer.Tool("read_file",
            "Read a text file inside the Zan project.", "path"));
        o.tools.Add(McpServer.Tool("write_file",
            "Write a text file inside the Zan project.", "path", "content"));
        o.tools.Add(McpServer.Tool("build",
            "Build the Zan project (zanc build src/main.zan) and return the compiler output."));
        o.tools.Add(McpServer.Tool("zan_api_search",
            "Search the Zan stdlib symbol index (name/kind/file/line/signature). Use BEFORE writing Gui/Game code to get exact signatures instead of guessing.",
            "query"));
        o.tools.Add(McpServer.ToolOptional("zan_example",
            "Return a shipped, build-verified template/example for a topic (e.g. gui-window, gui-hmi, gui-chart, game-arcade2d, game-board, game-cards, console, server-mvc). Call with no topic to list the catalog. Copy the returned files instead of inventing API usage.",
            "topic"));
        o.tools.Add(McpServer.Tool("zan_compile",
            "Compile one Zan snippet in an isolated workspace with the shipped zanc; returns structured diagnostics {ok, diagnostics[], raw}.",
            "filename", "content"));
        o.tools.Add(McpServer.ToolOptional("zan_build_project",
            "Compile the synced project (default entry src/main.zan) with the shipped zanc; returns structured diagnostics {ok, diagnostics[], raw}.",
            "entry"));
        return Json.Serialize<McpToolsDoc>(o);
    }

    /// One MCP tool declaration: name, description and an inputSchema built
    /// from the given string-typed parameter names (none = empty schema).
    static McpToolDoc Tool(string name, string desc) {
        return McpServer.Tool(name, desc, "");
    }

    static McpToolDoc Tool(string name, string desc, string p1) {
        return McpServer.Tool(name, desc, p1, "");
    }

    // A tool with a single, OPTIONAL string parameter (not in `required`).
    static McpToolDoc ToolOptional(string name, string desc, string p1) {
        McpToolDoc o = new McpToolDoc();
        o.name = name;
        o.description = desc;
        JsonValue props = JsonValue.NewObject();
        JsonValue s1 = JsonValue.NewObject();
        s1.Put("type", JsonValue.NewStr("string"));
        props.Put(p1, s1);
        JsonValue schema = JsonValue.NewObject();
        schema.Put("type", JsonValue.NewStr("object"));
        schema.Put("properties", props);
        schema.Put("required", JsonValue.NewArray());
        o.inputSchema = schema;
        return o;
    }

    static McpToolDoc Tool(string name, string desc, string p1, string p2) {
        McpToolDoc o = new McpToolDoc();
        o.name = name;
        o.description = desc;
        JsonValue props = JsonValue.NewObject();
        if (p1.Length > 0) {
            JsonValue s1 = JsonValue.NewObject();
            s1.Put("type", JsonValue.NewStr("string"));
            props.Put(p1, s1);
        }
        if (p2.Length > 0) {
            JsonValue s2 = JsonValue.NewObject();
            s2.Put("type", JsonValue.NewStr("string"));
            props.Put(p2, s2);
        }
        JsonValue schema = JsonValue.NewObject();
        schema.Put("type", JsonValue.NewStr("object"));
        schema.Put("properties", props);
        JsonValue req = JsonValue.NewArray();
        if (p1.Length > 0) { req.Append(JsonValue.NewStr(p1)); }
        if (p2.Length > 0) { req.Append(JsonValue.NewStr(p2)); }
        schema.Put("required", req);
        o.inputSchema = schema;
        return o;
    }

    static string RpcResult(string id, string resultJson) {
        JsonValue o = JsonValue.NewObject();
        o.Put("jsonrpc", JsonValue.NewStr("2.0"));
        o.Put("id", McpServer.IdValue(id));
        JsonValue r = JsonValue.ParseLenient(resultJson);
        if (r != null) { o.Put("result", r); }
        return o.ToJson();
    }

    static string RpcError(string id, int code, string msg) {
        JsonValue o = JsonValue.NewObject();
        o.Put("jsonrpc", JsonValue.NewStr("2.0"));
        o.Put("id", McpServer.IdValue(id));
        JsonValue e = JsonValue.NewObject();
        e.Put("code", JsonValue.NewNum(Convert.ToString(code)));
        e.Put("message", JsonValue.NewStr(msg));
        o.Put("error", e);
        return o.ToJson();
    }

    /// The `id` member of a JSON-RPC message: numeric strings stay numbers
    /// (clients may use numeric ids), everything else becomes a string.
    static JsonValue IdValue(string id) {
        if (id == "") { return JsonValue.NewNull(); }
        bool numeric = true;
        for (int i = 0; i < id.Length; i = i + 1) {
            string ch = id.Substring(i, 1);
            if (ch < "0" || ch > "9") { numeric = false; }
        }
        if (numeric) { return JsonValue.NewNum(id); }
        return JsonValue.NewStr(id);
    }

}
