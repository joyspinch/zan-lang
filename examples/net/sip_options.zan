// ============================================================================
// SIP 信令 —— VoIP/软电话的会话协议（RFC 3261，UDP 5060）
// ----------------------------------------------------------------------------
// 演示内容：
//   1. SipClient.OptionsAsync：OPTIONS 保活/能力探测（SIP 世界的 ping）
//   2. SipClient.RegisterAsync：向注册服务器登记联系地址；401/407 挑战会原样
//      返回给调用方（摘要认证/INVITE 通话/RTP 媒体不在标准库范围内）
//   3. SipMessage.Parse / Serialize：请求与响应的文本模型，头部大小写不敏感
//   4. 内置非 INVITE 事务重传（500ms 倍增到 4s，32s 放弃），丢包自动补发
//   5. 本例在同进程里起一个最小注册服务端应答 200 OK，无需外部 PBX；
//      接真实服务时换成 PBX/网关地址（如 Asterisk、FreeSWITCH）
//
// 运行：zanc examples/net/sip_options.zan --auto-stdlib -o sip.exe && ./sip.exe
// ============================================================================
using System;
using System.Net.Sip;
using System.Net.Sockets;

class Program {
    static int PORT = 55060;
    static bool serverUp = false;

    // ---- 最小 SIP 服务端：解析请求，回显 Via/From/To/Call-ID/CSeq 的 200 ----
    // 只服务两次请求就退出：调度器会等所有协程结束，永久阻塞在 recv 上的
    // 服务协程会让进程无法退出。
    static async void Server() {
        UdpClient udp = UdpClient.Bind("127.0.0.1", PORT);
        serverUp = true;
        int handled = 0;
        while (handled < 2) {
            handled = handled + 1;
            string data = await Socket.RecvFromPeerAsync(udp.GetSocket(), 65536);
            SipMessage req = SipMessage.Parse(data);
            if (req == null) { continue; }
            StringBuilder sb = new StringBuilder();
            sb.Append("SIP/2.0 200 OK\r\n");
            sb.Append("Via: " + req.Header("Via") + "\r\n");
            sb.Append("From: " + req.Header("From") + "\r\n");
            sb.Append("To: " + req.Header("To") + ";tag=srv\r\n");
            sb.Append("Call-ID: " + req.Header("Call-ID") + "\r\n");
            sb.Append("CSeq: " + req.Header("CSeq") + "\r\n");
            if (req.method == "OPTIONS") {
                sb.Append("Allow: OPTIONS, REGISTER\r\n");
            }
            sb.Append("Content-Length: 0\r\n\r\n");
            string resp = sb.ToString();
            int _s = await udp.SendToAsync(resp, Socket.PeerIp(), Socket.PeerPort());
        }
        udp.Close();
    }

    static async int Main() {
        Task.Spawn(Program.Server());
        while (!serverUp) { await Task.Delay(10); }

        SipClient c = new SipClient("127.0.0.1", PORT, "zan-demo");

        SipMessage r = await c.OptionsAsync();
        if (r == null) { Console.WriteLine("OPTIONS 超时"); return 1; }
        Console.WriteLine("OPTIONS -> " + Convert.ToString(r.status) + " " + r.reason
            + "（Allow: " + r.Header("Allow") + "）");

        SipMessage reg = await c.RegisterAsync("alice", 3600);
        if (reg == null) { Console.WriteLine("REGISTER 超时"); return 1; }
        Console.WriteLine("REGISTER alice -> " + Convert.ToString(reg.status)
            + " " + reg.reason);
        return 0;
    }
}
