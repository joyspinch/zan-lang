// 最小 HTTP 服务端：等价于 swoole 的 $http->on('request', ...)
//   zanc examples/net/quick/quick_http.zan --auto-stdlib -o http_server
using System;
using System.Net;
using System.Net.Http;

class Program {
    static async HttpResponse Request(HttpRequest req) {
        return HttpResponse.Text("Hello World " + req.path);
    }

    static async void Main() {
        Worker w = new Worker("http", "0.0.0.0", 9501);
        w.count = 4;                    // 4 个 worker 进程
        w.onRequest = Program.Request;
        await Worker.RunAll();
    }
}
