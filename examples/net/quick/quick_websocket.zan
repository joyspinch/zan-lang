// 最小 WebSocket 服务端：等价于 swoole 的 on('open'/'message'/'close')。
// 同一个端口同时响应普通 HTTP（onRequest），客户端发 Upgrade 才升级成 ws。
//   zanc examples/net/quick/quick_websocket.zan --auto-stdlib -o ws_server
using System;
using System.Net;
using System.Net.Http;

class Program {
    static async void Open(Connection conn) {
        Console.WriteLine("connection open: " + Convert.ToString(conn.GetId()));
    }

    // 返回值会被自动打成一帧发回；要主动推送用 conn.Send / WsFrame
    static async string Message(Connection conn, string data) {
        Console.WriteLine("received message: " + data);
        return "{\"hello\":\"world\"}";
    }

    static async void Closed(Connection conn) {
        Console.WriteLine("connection close: " + Convert.ToString(conn.GetId()));
    }

    // 同端口的普通 HTTP 请求
    static async HttpResponse Request(HttpRequest req) {
        return HttpResponse.Text("http on the ws port: " + req.path);
    }

    static async void Main() {
        Worker w = Worker.Create("websocket", "0.0.0.0", 9502);
        w.count = 4;
        w.onOpen = Program.Open;
        w.onMessage = Program.Message;
        w.onClose = Program.Closed;
        w.onRequest = Program.Request;
        await Worker.RunAll();
    }
}
