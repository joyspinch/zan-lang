// 最小 UDP 服务端：等价于 swoole 的 on('packet', ...)
// 核心契约与语义定义。
using System;
using System.Net;

class Program {
    // 返回值直接回给发包方，无需自己 sendTo
    static async string Packet(string data) {
        return "Server: " + data;
    }

    static async void Main() {
        Worker w = new Worker("udp", "0.0.0.0", 9504);
        w.onPacket = Program.Packet;
        await Worker.RunAll();
    }
}
