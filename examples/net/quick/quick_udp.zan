// 最小 UDP 服务端：等价于 swoole 的 on('packet', ...)
//   zanc examples/net/quick/quick_udp.zan --auto-stdlib -o udp_server
using System;
using System.Net;

class Program {
    // 返回值直接回给发包方，无需自己 sendTo
    static async string Packet(string data) {
        return "Server: " + data;
    }

    static async void Main() {
        Worker w = Worker.Create("udp", "0.0.0.0", 9504);
        w.onPacket = Program.Packet;
        await Worker.RunAll();
    }
}
