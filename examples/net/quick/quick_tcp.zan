// 最小 TCP 服务端：等价于 swoole 的 on('connect'/'receive'/'close')
//   zanc examples/net/quick/quick_tcp.zan --auto-stdlib -o tcp_server
using System;
using System.Net;

class Program {
    static async void Connect(Connection conn) {
        Console.WriteLine("connection open: " + Convert.ToString(conn.GetId()));
    }

    // 返回值即回给对端的数据，返回 "" 表示不回复
    static async string Receive(Connection conn, string data) {
        return "Zan: " + data;
    }

    static async void Closed(Connection conn) {
        Console.WriteLine("connection close: " + Convert.ToString(conn.GetId()));
    }

    static async void Main() {
        Worker w = Worker.Create("tcp", "0.0.0.0", 9503);
        w.count = 4;
        w.onConnect = Program.Connect;
        w.onReceive = Program.Receive;
        w.onClose = Program.Closed;
        await Worker.RunAll();
    }
}
