// 进程管理命令行（workerman 那一套），业务代码只写回调：
//   ./service            前台（调试）启动
//   ./service start      同上
//   ./service start -d   守护进程方式启动
//   ./service stop       停止
//   ./service restart    重启
//   ./service reload     平滑重启（逐个换 worker，老 worker 处理完在途请求再退出）
//   ./service status     查看状态
//
//   zanc examples/net/quick/quick_service.zan --auto-stdlib -o service
using System;
using System.Net;
using System.Net.Http;

class Program {
    static async HttpResponse Request(HttpRequest req) {
        return HttpResponse.Text("pid " + Convert.ToString(ProcessHost.Pid())
            + " path " + req.path);
    }

    static async void Main() {
        Worker w = Worker.Create("http", "0.0.0.0", 9501);
        w.count = 4;
        w.onRequest = Program.Request;
        await Worker.RunCommand();
    }
}
