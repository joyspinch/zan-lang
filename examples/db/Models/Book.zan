using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Data.Postgres;

public class Book {
    [Column(IsIdentity = true)]
    int id;
    [Column(StringLength = 128)]
    string title;
    string author;
    double price;

    static Book Of(string title, string author, double price) {
        Book b = new Book();
        b.title = title;
        b.author = author;
        b.price = price;
        return b;
    }

    int Id() { return this.id; }
    string Title() { return this.title; }
    string Author() { return this.author; }
    double Price() { return this.price; }
}
