using System;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.IO;

public class User {
    [Column(IsIdentity = true)]
    int id;
    [Column(StringLength = 64)]
    string name;
    string email;
    int age;
    int score;
    bool active;

    static User Of(string name, string email, int age, int score, bool active) {
        User u = new User();
        u.name = name;
        u.email = email;
        u.age = age;
        u.score = score;
        u.active = active;
        return u;
    }

    int Id() { return this.id; }
    string Name() { return this.name; }
    string Email() { return this.email; }
    int Age() { return this.age; }
    int Score() { return this.score; }
    bool Active() { return this.active; }
}

// 继承通用泛型仓储，直接拥有标准 CRUD，只需补充特定领域查询
