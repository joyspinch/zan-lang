using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Data.Postgres;

class BookRepository : BaseRepository<Book> {
    BookRepository(IFreeSql fsql) : base(fsql) {}

    List<Book> BooksPricedAbove(double minPrice) {
        return this.GetExecutor().Select<Book>()
            .Where(a => a.price > minPrice)
            .OrderBy(a => a.id)
            .ToList();
    }
}
