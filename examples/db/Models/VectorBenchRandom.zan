using System;
using System.Collections.Generic;
using System.Data.ZanDb;

class VectorBenchRandom {
    long state;
    VectorBenchRandom(int seed) { this.state = seed; }
    double Unit() {
        this.state = (this.state * 48271) % 2147483647;
        return (double)this.state / 2147483647.0;
    }
}
