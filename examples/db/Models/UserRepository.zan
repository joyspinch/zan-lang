using System;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.IO;

class UserRepository : BaseRepository<User> {
    UserRepository(IFreeSql fsql) : base(fsql) {}

    User ById(int id) {
        return this.GetExecutor().Select<User>().Where(a => a.id == id).ToOne();
    }

    List<User> ActiveUsers() {
        return this.GetExecutor().Select<User>().Where(a => a.active).ToList();
    }
}
