// FreeSql 风格强类型 ORM 完整实战示例
// 演示内容：
// 1. CodeFirst 实体定义：[Table]、[Column(IsIdentity=true)]
// 2. FreeSqlBuilder 构建 IFreeSql 统一门面
// 3. CodeFirst 结构自动同步：fsql.CodeFirst().SyncStructure<T>()
// 4. BaseRepository<T> 强类型通用泛型仓储：开箱即用增删查改
// 5. Fluent 链式查询：Select<T>() / Where / WhereIf / OrderBy / Page / ToList
// 6. 聚合统计：Count / Any / Sum / Max / Avg
// 7. Fluent 链式更新：Update<T>() / Set / SetIncr / ExecuteAffrows
// 8. IUnitOfWork 工作单元与事务：原子提交与回滚
// 运行：build/zanc examples/db/orm_model.zan --auto-stdlib -o _scratch/orm_model.exe
using System;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.IO;

[Table(Name = "t_user")]
class User {
    [Column(IsIdentity = true)]
    int id;
    [Column(StringLength = 64)]
    string name;
    string email;
    int age;
    int score;
    bool active;

    static User Of(string name, string email, int age, int score, bool active) {
        User u = new User();
        u.name = name;
        u.email = email;
        u.age = age;
        u.score = score;
        u.active = active;
        return u;
    }

    int Id() { return this.id; }
    string Name() { return this.name; }
    string Email() { return this.email; }
    int Age() { return this.age; }
    int Score() { return this.score; }
    bool Active() { return this.active; }
}

// 继承通用泛型仓储，直接拥有标准 CRUD，只需补充特定领域查询
class UserRepository : BaseRepository<User> {
    UserRepository(IFreeSql fsql) : base(fsql) {}

    User ById(int id) {
        return this.GetExecutor().Select<User>().Where(a => a.id == id).ToOne();
    }

    List<User> ActiveUsers() {
        return this.GetExecutor().Select<User>().Where(a => a.active).ToList();
    }
}

class Program {
    static void Main() {
        string path = "orm_freesql_demo.tmp.db";
        File.Delete(path);

        // 1. 构建 IFreeSql 门面
        IFreeSql fsql = new FreeSqlBuilder()
            .UseConnectionString(DbProvider.SQLite, path)
            .Build();

        // 2. CodeFirst: 表结构幂等同步
        fsql.CodeFirst().SyncStructure<User>();
        Console.WriteLine("CodeFirst: table synchronized");

        // 3. 通用仓储 BaseRepository
        UserRepository repo = new UserRepository(fsql);

        int id1 = repo.InsertIdentity(User.Of("Alice", "alice@example.com", 25, 100, true));
        int id2 = repo.InsertIdentity(User.Of("Bob", "bob@example.com", 30, 80, true));
        int id3 = repo.InsertIdentity(User.Of("Carol", "carol@example.com", 22, 95, false));

        Console.WriteLine("Total users: " + Convert.ToString(repo.Count()));

        // 4. Fluent 链式查询
        List<User> list = fsql.Select<User>()
            .Where(a => a.age >= 25)
            .OrderByDescending(a => a.score)
            .ToList();
        Console.WriteLine("Age >= 25 count: " + Convert.ToString(list.Count) + ", top: " + list[0].Name());

        // 5. WhereIf 动态条件查询
        string keyword = "Al";
        bool filterName = true;
        List<User> search = fsql.Select<User>()
            .WhereIf(filterName, a => a.name.StartsWith(keyword))
            .ToList();
        Console.WriteLine("Search found: " + Convert.ToString(search.Count) + ", name: " + search[0].Name());

        // 6. Fluent 链式更新与原子递增
        int rows = fsql.Update<User>()
            .Set(a => a.active, true)
            .SetIncr(a => a.score, 10)
            .Where(a => a.id == id3)
            .ExecuteAffrows();
        Console.WriteLine("Updated rows: " + Convert.ToString(rows));

        User carol = repo.ById(id3);
        Console.WriteLine("Carol score: " + Convert.ToString(carol.Score()) + ", active: " + Convert.ToString(carol.Active()));

        // 7. 工作单元事务 (IUnitOfWork)
        using (IUnitOfWork uow = fsql.CreateUnitOfWork()) {
            repo.Attach(uow);
            repo.Insert(User.Of("David", "david@example.com", 28, 90, true));
            uow.Commit();
        }
        repo.Detach();
        Console.WriteLine("After UoW commit, total: " + Convert.ToString(repo.Count()));

        // 8. 仓储删除与统计
        fsql.Delete<User>().Where(a => a.id == id1).ExecuteAffrows();
        Console.WriteLine("After delete, total: " + Convert.ToString(repo.Count()));

        fsql.Dispose();
        File.Delete(path);
        Console.WriteLine("FreeSql demo completed successfully.");
    }
}
