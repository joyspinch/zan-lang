using System;
using System.Text;

public class ZanDbSearchBench {
    static string DocumentText(int id) {
        string text = "中文数据库文档 mysql common group" + Convert.ToString(id % 100);
        if (id % 1000 == 0) { text = text + " rareanchor 星际航线"; }
        return text;
    }

    static void Compare(List<Bm25Hit> actual, List<Bm25Hit> expected) {
        if (actual.Count != 5 || actual.Count != expected.Count) {
            throw new InvalidOperationException("BM25 scan/posting top5 hit count mismatch");
        }
        for (int i = 0; i < actual.Count; i = i + 1) {
            double difference = actual[i].score - expected[i].score;
            if (difference < 0.0) { difference = -difference; }
            if (actual[i].id != expected[i].id || !(difference < 0.0000000001)) {
                throw new InvalidOperationException("BM25 scan/posting top5 ID or score mismatch");
            }
        }
    }

    static void RunQuery(Bm25Index index, BenchTextScan scan, string query, string label,
            int postingQueries, int scanQueries) {
        List<Bm25Hit> actual = index.SearchTop(query, 5);
        List<Bm25Hit> expected = scan.SearchTop(query, 5);
        ZanDbSearchBench.Compare(actual, expected);
        int postingHits = 0;
        long postingVisits = 0;
        long postingStart = Stopwatch.GetMicroseconds();
        for (int i = 0; i < postingQueries; i = i + 1) {
            actual = index.SearchTop(query, 5);
            postingHits = postingHits + actual.Count;
            postingVisits = postingVisits + index.LastVisitedPostings();
        }
        long postingUs = Stopwatch.GetMicroseconds() - postingStart;
        int scanHits = 0;
        long scanVisits = 0;
        long scanStart = Stopwatch.GetMicroseconds();
        for (int i = 0; i < scanQueries; i = i + 1) {
            expected = scan.SearchTop(query, 5);
            scanHits = scanHits + expected.Count;
            scanVisits = scanVisits + scan.LastVisitedDocuments();
        }
        long scanUs = Stopwatch.GetMicroseconds() - scanStart;
        ZanDbSearchBench.Compare(actual, expected);
        Console.WriteLine("text " + label + " posting_queries=" + Convert.ToString(postingQueries)
            + " posting_query_us=" + Convert.ToString(postingUs)
            + " posting_avg_us=" + Convert.ToString((double)postingUs / (double)postingQueries)
            + " posting_hits=" + Convert.ToString(postingHits)
            + " postings_visited=" + Convert.ToString(index.LastVisitedPostings())
            + " total_postings_visited=" + Convert.ToString(postingVisits));
        Console.WriteLine("text " + label + " scan_queries=" + Convert.ToString(scanQueries)
            + " scan_query_us=" + Convert.ToString(scanUs)
            + " scan_avg_us=" + Convert.ToString((double)scanUs / (double)scanQueries)
            + " scan_hits=" + Convert.ToString(scanHits)
            + " scan_doc_visits=" + Convert.ToString(scan.LastVisitedDocuments())
            + " total_scan_doc_visits=" + Convert.ToString(scanVisits)
            + " total_docs=" + Convert.ToString(index.Count())
            + " top5_match=1");
        for (int i = 0; i < actual.Count; i = i + 1) {
            Console.WriteLine("text " + label + " rank=" + Convert.ToString(i + 1)
                + " posting_id=" + Convert.ToString(actual[i].id)
                + " scan_id=" + Convert.ToString(expected[i].id)
                + " posting_score=" + Convert.ToString(actual[i].score)
                + " scan_score=" + Convert.ToString(expected[i].score));
        }
    }

    static void RunText() {
        int n = 10000;
        TextTokenizer tokenizer = new TextTokenizer();
        tokenizer.AddWord("星际航线");
        Bm25Index index = new Bm25Index(tokenizer);
        long buildStart = Stopwatch.GetMicroseconds();
        for (int i = 0; i < n; i = i + 1) { index.Add(i, ZanDbSearchBench.DocumentText(i)); }
        long buildUs = Stopwatch.GetMicroseconds() - buildStart;
        BenchTextScan scan = new BenchTextScan(tokenizer);
        long prepareStart = Stopwatch.GetMicroseconds();
        for (int i = 0; i < n; i = i + 1) { scan.Add(i, ZanDbSearchBench.DocumentText(i)); }
        long prepareUs = Stopwatch.GetMicroseconds() - prepareStart;
        Console.WriteLine("text docs=" + Convert.ToString(index.Count())
            + " build_us=" + Convert.ToString(buildUs)
            + " scan_prepare_us=" + Convert.ToString(prepareUs));
        ZanDbSearchBench.RunQuery(index, scan, "rareanchor 星际航线", "sparse", 50, 20);
        ZanDbSearchBench.RunQuery(index, scan, "mysql", "common", 1, 1);
    }

    static void Main() {
        ZanDbSearchBench.RunText();
    }
}
