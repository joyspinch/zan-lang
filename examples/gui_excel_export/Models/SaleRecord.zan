using System;
using System.IO;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Component.DataTable;

public class SaleRecord {
    public string name;
    public string region;
    public int qty;
    public double price;
    public int day;
    public bool delivered;

    public SaleRecord(string name, string region, int qty, double price, int day, bool delivered) {
        this.name = name != null ? name : "";
        this.region = region != null ? region : "";
        this.qty = qty;
        this.price = price;
        this.day = day;
        this.delivered = delivered;
    }
}

// 销售数据源：基于 List<SaleRecord> 强类型实体集合，CellText 给显示文本，
// 类型化键（CellNum/CellReal/CellDay/CellBool）与列声明走同一条路径——
// 排序、汇总和导出用的都是它们。
