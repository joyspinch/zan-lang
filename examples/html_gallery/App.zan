/* Wizard 向导的卡片内演示。Wizard 本体的 Render/Show 是 App 级
 * 全窗绘制（自带标题栏和按钮），不是可 Dock 进卡片的子控件；
 * 这里按组件文档的推荐用法嵌它的模板列表子件
 * Wizard.RenderList（自带行命中注册、悬停高亮与滚动），下方
 * 实时显示所选模板的名称与描述——点列表行即切换。 */
class WizardDemo : Control {
    List<WizardItem> items;
    SignalInt sel;

    WizardDemo() {
        this.InitControl("wizarddemo", 5);
        items = new List<WizardItem>();
        items.Add(new WizardItem("控制台应用", "code",
                                 "带有 main() 入口的命令行程序。"));
        items.Add(new WizardItem("图形界面应用", "grid",
                                 "基于 Gui 工具包的窗口应用。"));
        items.Add(new WizardItem("类库", "file",
                                 "无入口点的可复用库项目。"));
        sel = new SignalInt(0);
    }

    override void OnMeasure(App app) {
        prefW = app.Scale(320);
        prefH = app.Scale(200);
    }

    override void OnPaint(App app) {
        int listH = app.Scale(126);
        Wizard.RenderList(app, bx, by, bw, listH, items, sel);
        int i = sel.Get();
        if (i < 0 || i >= items.Count) { return; }
        WizardItem it = items[i];
        Theme t = app.theme;
        int ty = by + listH + app.Scale(12);
        app.canvas.DrawText(bx, ty, it.name, t.textPrimary,
                            t.fontSizeMedium);
        int ty2 = ty + Canvas.FontHeight(t.fontSizeMedium)
                  + app.Scale(6);
        app.canvas.DrawText(bx, ty2, it.desc, t.textSecondary,
                            t.fontSizeSmall);
    }
}

/* FormField 表单字段的卡片内演示。FormField 是设计器文档节点
 * 本身没有运行时绘制；它的运行时形态是经 FormBuilder.Build 把
 * 设计 JSON 实例化成真控件树——设计器画布预览与运行时窗口
 * 共用的就是这一条实例化路径，这里按同样方式喂一张迷你表单。 */
class FormFieldDemo : Control {
    FormFieldDemo() {
        this.InitControl("formfielddemo", 5);
        JsonValue fs = JsonValue.NewArray();
        fs.Append(FormFieldDemo.Fld("Input", "项目名称", "name",
                                    "请输入项目名称", null, 32));
        fs.Append(FormFieldDemo.Fld("SelectBox", "项目类型", "tpl", "",
                                    FormFieldDemo.Opts("控制台应用",
                                        "窗口应用", "类库"), 32));
        fs.Append(FormFieldDemo.Fld("Switch", "初始化 Git 仓库", "git",
                                    "", null, 32));
        fs.Append(FormFieldDemo.Fld("TextArea", "项目描述", "desc",
                                    "一句话描述这个项目", null, 56));
        JsonValue doc = JsonValue.NewObject();
        doc.Put("layoutMode", JsonValue.NewNum("0"));
        doc.Put("fields", fs);
        Control root = FormBuilder.Build(doc);
        root.Dock(Dock.Fill());
        this.Add(root);
    }

    static List<string> Opts(string a, string b, string c) {
        List<string> xs = new List<string>();
        xs.Add(a);
        xs.Add(b);
        xs.Add(c);
        return xs;
    }

    // 一个表单字段的设计 JSON（键与 Designer.SaveJson 一致；
    // options 必须是字符串数组，FormBuilder.JoinOpts 才会接管）。
    static JsonValue Fld(string kind, string label, string fname,
                         string ph, List<string> opts, int h) {
        JsonValue o = JsonValue.NewObject();
        o.Put("kind", JsonValue.NewStr(kind));
        o.Put("label", JsonValue.NewStr(label));
        o.Put("name", JsonValue.NewStr(fname));
        if (ph != "") { o.Put("placeholder", JsonValue.NewStr(ph)); }
        if (opts != null) {
            JsonValue oa = JsonValue.NewArray();
            for (int i = 0; i < opts.Count; i = i + 1) {
                oa.Append(JsonValue.NewStr(opts[i]));
            }
            o.Put("options", oa);
        }
        o.Put("fh", JsonValue.NewNum(Convert.ToString(h)));
        return o;
    }

    override void OnMeasure(App app) {
        prefW = app.Scale(320);
        prefH = app.Scale(230);
    }
}
