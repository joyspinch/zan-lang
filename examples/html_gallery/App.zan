using System;
using System.IO;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Hmi;
using Gui.Component;
using Gui.Component.DataTable;

/* HTML 组件全量画廊：组件目录 78 个中的 75 个 + 目录漏登的
 * CheckboxGroup/ListView，共 77 张演示卡；另有「更多组件」页 9 张
 * 目录外真控件（ChatView/FileTree/PropertyGrid/ScrollColumn/
 * RichText/Grid/Dropdown/Flex/FormGroup），合计 86 卡，按 8 个
 * 分类页组织。
 * 两个浏览器组件（WebViewBox/CefBrowserBox）按需求不进画廊；
 * ChoiceGroup 是抽象基类（零参构造不初始化），由它的两个具体
 * 子类 RadioGroup/CheckboxGroup 各自的卡片覆盖。
 *
 * 职责分界：
 *   - App.html（设计稿）声明全部结构：Card 卡片 + 按组件特性配置
 *     尺寸的演示节点。静态属性走 data-x-props / data-x-options，
 *     声明路径喂不进去的组件（泛型/需模型/无零参构造）在
 *     HTML 里落 Panel 占位，由本文件构造真控件填进去。
 *   - 本文件（code-behind）：顶部 Tabs 分类切换（带选中高亮）、
 *     演示数据喂养、启动自检（逐组件断言构造正确，正常启动把
 *     SELFTEST 结果打到控制台）。
 */

class DemoRow {
    string name;
    string kind;
    int size;
}

partial class HtmlGallery {
    static int fails;

    static void Check(Control c, string want, string id) {
        if (c == null) {
            fails = fails + 1;
            Console.WriteLine("MISSING " + id);
            return;
        }
        if (c.Kind() != want) {
            fails = fails + 1;
            Console.WriteLine("WRONGKIND " + id + ": got " + c.Kind()
                              + " want " + want);
        }
    }

    static DemoRow MkRow(string name, string kind, int size) {
        DemoRow r = new DemoRow();
        r.name = name;
        r.kind = kind;
        r.size = size;
        return r;
    }

    static Control VRow(int qi) {
        return new Label("第 " + Convert.ToString(qi + 1)
                         + " 行 · 虚拟滚动演示");
    }

    static List<TreeNode> TreeNodes() {
        List<TreeNode> ns = new List<TreeNode>();
        ns.Add(TreeNode.Dir("src", 0, true));
        ns.Add(TreeNode.Dir("compiler", 1, true));
        ns.Add(TreeNode.FileIcon("lexer.zan", 2, "file"));
        ns.Add(TreeNode.FileIcon("parser.zan", 2, "file"));
        ns.Add(TreeNode.Dir("runtime", 1, false));
        ns.Add(TreeNode.FileIcon("arc.zan", 2, "file"));
        ns.Add(TreeNode.FileIcon("scheduler.zan", 2, "file"));
        return ns;
    }

    static void ShowPage(int i) {
        Page0.SetShown(0 == i);
        Page1.SetShown(1 == i);
        Page2.SetShown(2 == i);
        Page3.SetShown(3 == i);
        Page4.SetShown(4 == i);
        Page5.SetShown(5 == i);
        Page6.SetShown(6 == i);
        Page7.SetShown(7 == i);
    }

    static void OnLoad(Form form) {
        Console.WriteLine("WIN " + form.bw + "x" + form.bh);

        // 分类页签：Tabs 自带当前选中高亮，TabChanged 驱动翻页。
        Cats.Add("基础控件", false);
        Cats.Add("输入", false);
        Cats.Add("数据展示", false);
        Cats.Add("导航", false);
        Cats.Add("反馈", false);
        Cats.Add("列表与表格", false);
        Cats.Add("HMI 专用", false);
        Cats.Add("更多组件", false);
        Cats.TabChanged.Add(() => {
            Console.WriteLine("TAB -> " + Cats.Active());
            ShowPage(Cats.Active());
        });
        ShowPage(0);

        // ---- 基础控件 ----
        List<string> tags = new List<string>();
        tags.Add("调查中");
        tags.Add("已发布");
        DemoDynamicTags.SetItems(tags);

        // ---- 输入 ----

        // ---- 数据展示 ----
        List<string> code = new List<string>();
        code.Add("App.Create(\"画廊\", 1280, 800)");
        code.Add("    .LoadHtml(\"App.html\")");
        code.Add("    .Run();");
        DemoCodeBlock.SetLines(code);
        DemoCodeBlock.Copy.Add(() => {
            Clipboard.SetText(string.Join("\n", code));
        });
        DemoTimeline.AddItem("09:00", "站会", "同步昨日进展");
        DemoTimeline.AddItem("14:00", "评审", "设计稿与接口评审");
        DemoTimeline.AddItem("18:00", "发布", "打包并跑冒烟测试");

        // ---- 导航 ----
        DemoTabs.Add("概述", false);
        DemoTabs.Add("配置", false);
        DemoTabs.Add("日志", false);
        DemoBreadcrumb.AddItem("首页");
        DemoBreadcrumb.AddItem("组件库");
        DemoBreadcrumb.AddItem("Button");
        DemoSteps.AddStep("选择模板");
        DemoSteps.AddStepDesc("填写配置", "项目名与位置");
        DemoSteps.AddStepDesc("确认生成", "创建项目文件");
        DemoSteps.SetProp("current", "1");
        DemoWizard.Add(new WizardDemo());
        DemoCollapse.AddPanel("常规", "基础显示设置");
        DemoCollapse.AddPanel("高级", "性能与诊断选项");
        DemoCarousel.AddSlide("第一帧");
        DemoCarousel.AddSlide("第二帧");
        DemoCarousel.AddSlide("第三帧");
        List<TreeNode> tns = HtmlGallery.TreeNodes();
        DemoTreeView.Bind(tns);
        DemoTreeView.BindSel(new SignalInt(0));

        // ---- 反馈 ----
        AlarmBuffer buf = new AlarmBuffer();
        buf.Raise("TIC101.PV", "压力高高限", 2);
        buf.Raise("FIC102.PV", "流量波动", 1);
        AlarmBanner ban = new AlarmBanner(buf);
        ban.Dock(Dock.Fill());
        DemoAlarmBanner.Add(ban);
        AlarmList al = new AlarmList(buf);
        al.Dock(Dock.Fill());
        DemoAlarmList.Add(al);
        Popover pop = new Popover("更多信息", "Popover 气泡",
                                  "锚定触发元素的弹出层，内容自动换行。", 220);
        pop.Dock(Dock.Fill());
        DemoPopover.Add(pop);
        DemoFormField.Add(new FormFieldDemo());
        DemoResult.Class = Result.StatusClass(1);

        // ---- 列表与表格 ----
        List<ListColumn<string>> lcols = new List<ListColumn<string>>();
        lcols.Add(new ListColumn<string>("组件", (string s) => s));
        ListView<string> lv = new ListView<string>(lcols);
        List<string> lrows = new List<string>();
        lrows.Add("Button 按钮");
        lrows.Add("Input 输入框");
        lrows.Add("Tabs 页签");
        lrows.Add("DataGrid 表格");
        lv.Bind(lrows);
        lv.Dock(Dock.Fill());
        DemoListView.Add(lv);
        DemoVirtualList.SetRowHeight(32);
        DemoVirtualList.SetRows(200, (int qi) => HtmlGallery.VRow(qi));
        List<DemoRow> rows = new List<DemoRow>();
        rows.Add(HtmlGallery.MkRow("Button", "基础控件", 12));
        rows.Add(HtmlGallery.MkRow("SelectBox", "输入", 9));
        rows.Add(HtmlGallery.MkRow("Chart", "图表", 5));
        rows.Add(HtmlGallery.MkRow("DataGrid", "列表与表格", 1));
        rows.Add(HtmlGallery.MkRow("Trend", "HMI 专用", 3));
        DemoDataGrid.Bind(rows);
        List<string> tsrc = new List<string>();
        tsrc.Add("待办");
        tsrc.Add("进行中");
        List<string> ttgt = new List<string>();
        ttgt.Add("已完成");
        DemoTransfer.Bind(tsrc, ttgt);
        List<string> logs = new List<string>();
        logs.Add("[09:00:01] build started");
        logs.Add("[09:00:03] compile App.zan ok");
        logs.Add("[09:00:04] link hg.exe ok");
        logs.Add("[09:00:05] selftest passed");
        DemoConsoleView.Bind(logs);
        DemoBandGrid.Bind(6, 12);
        for (int r = 0; r < 6; r = r + 1) {
            for (int c = 0; c < 12; c = c + 1) {
                DemoBandGrid.SetNum(r, c, 18 + r * 11 + c * 4);
            }
        }
        DemoBandGrid.SetText(0, 0, "频段");
        // 格底色缺省与表底同色（热力图组件，视觉由 Heat/BarMax
        // 驱动）：不设 Heat 时整片矩阵与底色融为一体，只剩行头细条。
        DemoBandGrid.Heat(0xFF378ADD);
        DemoBandGrid.BarMax(117);
        List<GraphNode> gns = new List<GraphNode>();
        GraphNode ga = GraphNode.Of("init", "初始化");
        GraphNode gb = GraphNode.Of("build", "构建");
        GraphNode gc = GraphNode.Of("test", "测试");
        GraphNode gd = GraphNode.Of("release", "发布");
        gb.deps.Add("init");
        gc.deps.Add("build");
        gd.deps.Add("test");
        gns.Add(ga);
        gns.Add(gb);
        gns.Add(gc);
        gns.Add(gd);
        DemoGraphView.Bind(gns);

        // ---- HMI 专用 ----
        TagTable io = new TagTable();
        IoTag pv = io.Add("TIC101.PV", "°C", 10);
        pv.SetRaw(1520);
        IoTag fl = io.Add("FIC102.PV", "m3/h", 10);
        fl.SetRaw(2400);
        DemoTrend.Add("PV", pv, 0xFF4CAF50);
        DemoTrend.Add("FLOW", fl, 0xFF2196F3);
        // 量程是原始计数（显示值 = raw/scale，位号 scale=10）：
        // 缺省 0..100 装不下 PV=1520 / FLOW=2400，整条线被裁没。
        // 放到 0..3000，轴即 0..300，两条曲线都进画面。
        DemoTrend.Range(0, 3000);
        // 静态演示没有周期采样源：手工灌一段历史，最后落回位号
        // 的现行值（设备卡与数显读的就是它）。
        for (int i = 0; i < 48; i = i + 1) {
            pv.SetRaw(900 + (i % 14) * 45);
            fl.SetRaw(1500 + (i % 9) * 110);
            DemoTrend.Sample();
        }
        pv.SetRaw(1520);
        fl.SetRaw(2400);
        DemoTrend.Sample();
        DemoBargraph.Value().Set(62);
        EquipPanel wall = new EquipPanel();
        DeviceCard w1 = wall.AddDevice("1# 进料泵");
        w1.Row("流量", fl);
        DeviceCard w2 = wall.AddDevice("2# 进料泵");
        w2.Row("压力", pv);
        wall.Dock(Dock.Fill());
        DemoEquipPanel.Add(wall);
        DeviceCard dc = new DeviceCard("1# 压缩机");
        dc.Row("排气温度", pv);
        dc.Row("排气流量", fl);
        dc.Dock(Dock.Fill());
        DemoDeviceCard.Add(dc);
        ButtonGroup bg = new ButtonGroup(1);
        bg.Add("左");
        bg.Add("中");
        bg.Add("右");
        bg.Dock(Dock.Fill());
        DemoButtonGroup.Add(bg);

        // ---- 更多组件（目录外真控件，全部 code-behind 喂活） ----
        ChatView chat = new ChatView();
        List<ChatMessage> msgs = new List<ChatMessage>();
        msgs.Add(ChatMessage.Create("user", "这个组件库还有哪些控件？"));
        msgs.Add(ChatMessage.Create("assistant",
            "84 张演示卡，全部用标准库组件渲染。"));
        msgs.Add(ChatMessage.Create("user", "聊天视图也内嵌进卡片了吗？"));
        msgs.Add(ChatMessage.Create("assistant",
            "是的——ChatView 绑一列 ChatMessage 就能跑。"));
        chat.Bind(msgs);
        chat.Dock(Dock.Fill());
        DemoChatView.Add(chat);

        // FileTree 是目录 → TreeNode 的扫描器：扫启动目录喂
        // TreeView（用 "." 而非固定子目录，画廊从任意工作目录启动
