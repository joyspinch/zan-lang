        specs.Add(PropSpec.Section("演示对象"));
        PropSpec pName = PropSpec.Text("name", "名称");
        pName.sstr = new SignalString("zan-lang 画廊");
        specs.Add(pName);
        PropSpec pRows = PropSpec.Int("rows", "演示卡数");
        pRows.snum = new SignalInt(84);
        specs.Add(pRows);
        PropSpec pLive = PropSpec.Bool("live", "实机数据");
        pLive.sflag = new SignalBool(true);
        specs.Add(pLive);
        pg.Bind("画廊", specs);
        pg.Dock(Dock.Fill());
        DemoPropertyGrid.Add(pg);

        // ScrollColumn：子控件停靠 top 依次堆叠，超出即出滚动条。
        ScrollColumn sc = new ScrollColumn();
        for (int i = 0; i < 12; i = i + 1) {
