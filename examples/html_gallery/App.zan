        RichText rich = new RichText();
        // 快捷色挑亮底可见的（#W 白、#Y 纯黄是深色游戏底的色，
        // 亮色卡片上一画就隐形）。
        rich.SetMarkup("富文本 RichText：#R颜色快捷色 #B分段着色，"
                       + "#H标记语法与 Game.Arpg 同一种，#L支持行内混排。");
        rich.Dock(Dock.Fill());
        DemoRichText.Add(rich);

        Grid grid = Grid.Of(3);
        grid.Add(new Label("栅 1"));
        grid.Add(new Label("栅 2"));
        grid.Add(new Label("栅 3"));
        grid.Add(new Label("栅 4"));
        grid.Add(new Label("栅 5"));
        grid.Add(new Label("栅 6"));
        grid.Dock(Dock.Fill());
        DemoGrid.Add(grid);

        Dropdown<string> dd = new Dropdown<string>((string s) => s);
        dd.InitDropdown();
        List<string> dopts = new List<string>();
        dopts.Add("Web 前端");
        dopts.Add("桌面客户端");
        dopts.Add("服务端");
        dd.Bind(dopts);
        dd.Hint("选择部署目标");
        dd.Dock(Dock.Fill());
        DemoDropdown.Add(dd);

        // Flex：主轴分布与自动换行都落在 CSS 类上——标题行用
        // Between（左标题右按钮），标签排用 Wrap（超宽自动折行）。
        Flex head = Flex.Row().Between().AlignCenter();
        head.With(new Label("标题行：左标题 · 右动作"));
        head.With(new Button("右侧动作"));
        head.Dock(Dock.Top());
        DemoFlex.Add(head);
        Flex tags = Flex.Row().Wrapped().Size("small");
        tags.With(new Tag("弹性布局"));
        tags.With(new Tag("自动换行"));
        tags.With(new Tag("间距档"));
        tags.With(new Tag("主轴分布"));
        tags.With(new Tag("交叉轴对齐"));
        tags.With(new Tag("CSS 类驱动"));
        tags.With(new Tag("超宽折行演示标签"));
        tags.Dock(Dock.Top());
        DemoFlex.Add(tags);

        // FormGroup：Add 包成「标题 + 字段 + 错误行」，规则链式追加；
        // 点校验按钮就地画错（红框 + 字段下消息），改对即清除。
        FormGroup form = new FormGroup();
        Input user = new Input("空着点校验试试");
        form.Add("用户名", user)
            .Rule(FormRule.Required("请输入用户名"))
            .Rule(FormRule.MinLen(3, "至少 3 个字符"));
        Input mail = new Input("选填，填了才校验格式");
        form.Add("邮箱", mail).Rule(FormRule.Email("邮箱格式不对"));
        Button check = new Button("校验表单");
        check.OnClick(() => { form.Validate(); });
        form.Add(check);
        form.Dock(Dock.Fill());
        DemoFormGroup.Add(form);

        // ---- 构造层自检：68 个声明式演示 + 9 个占位壳（Panel） ----
        Check(DemoButton, "Button", "DemoButton");
        Check(DemoLabel, "Label", "DemoLabel");
        Check(DemoTypography, "Typography", "DemoTypography");
        Check(DemoIconView, "IconView", "DemoIconView");
        Check(DemoDivider, "Divider", "DemoDivider");
        Check(DemoImage, "Image", "DemoImage");
        Check(DemoAvatar, "Avatar", "DemoAvatar");
        Check(DemoBadge, "Badge", "DemoBadge");
        Check(DemoTag, "Tag", "DemoTag");
        Check(DemoDynamicTags, "DynamicTags", "DemoDynamicTags");
        Check(DemoWatermark, "Watermark", "DemoWatermark");
        Check(DemoCard, "Card", "DemoCard");
        Check(DemoPanel, "Panel", "DemoPanel");
        Check(DemoInput, "Input", "DemoInput");
        Check(DemoTextArea, "TextArea", "DemoTextArea");
        Check(DemoInputNumber, "InputNumber", "DemoInputNumber");
        Check(DemoInputOtp, "InputOtp", "DemoInputOtp");
        Check(DemoCheckbox, "Checkbox", "DemoCheckbox");
        Check(DemoSwitch, "Switch", "DemoSwitch");
        Check(DemoRadio, "Radio", "DemoRadio");
        Check(DemoRadioButton, "RadioButton", "DemoRadioButton");
        Check(DemoRadioGroup, "RadioGroup", "DemoRadioGroup");
        Check(DemoRadioButtonGroup, "RadioButtonGroup", "DemoRadioButtonGroup");
        Check(DemoCheckboxGroup, "CheckboxGroup", "DemoCheckboxGroup");
        Check(DemoSlider, "Slider", "DemoSlider");
        Check(DemoRate, "Rate", "DemoRate");
        Check(DemoDatePicker, "DatePicker", "DemoDatePicker");
        Check(DemoColorPicker, "ColorPicker", "DemoColorPicker");
        Check(DemoUpload, "Upload", "DemoUpload");
        // 核心契约与语义定义。
        Check(DemoSelectBox, "SelectBox", "DemoSelectBox");
        Check(DemoStatistic, "Statistic", "DemoStatistic");
        Check(DemoCountdown, "Countdown", "DemoCountdown");
        Check(DemoNumberAnimation, "NumberAnimation", "DemoNumberAnimation");
        Check(DemoMarquee, "Marquee", "DemoMarquee");
        Check(DemoQrCode, "QrCode", "DemoQrCode");
        Check(DemoCalendar, "Calendar", "DemoCalendar");
        Check(DemoTimeline, "Timeline", "DemoTimeline");
        Check(DemoListItem, "ListItem", "DemoListItem");
        Check(DemoSkeleton, "Skeleton", "DemoSkeleton");
        Check(DemoSpin, "Spin", "DemoSpin");
        Check(DemoCodeBlock, "CodeBlock", "DemoCodeBlock");
        Check(DemoProgress, "Progress", "DemoProgress");
        Check(DemoTabs, "Tabs", "DemoTabs");
        Check(DemoPageHeader, "PageHeader", "DemoPageHeader");
        Check(DemoBreadcrumb, "Breadcrumb", "DemoBreadcrumb");
        Check(DemoPagination, "Pagination", "DemoPagination");
        Check(DemoSteps, "Steps", "DemoSteps");
        Check(DemoFloatButton, "FloatButton", "DemoFloatButton");
        Check(DemoSplitPanel, "SplitPanel", "DemoSplitPanel");
        Check(DemoCarousel, "Carousel", "DemoCarousel");
        Check(DemoCollapse, "Collapse", "DemoCollapse");
        Check(DemoTreeView, "TreeView", "DemoTreeView");
        Check(DemoEmpty, "Empty", "DemoEmpty");
