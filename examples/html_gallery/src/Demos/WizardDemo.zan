using System;
using System.IO;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Hmi;
using Gui.Component;
using Gui.Component.DataTable;
using Gui.Component.CodeEditor;

public class WizardDemo : Control {
    List<WizardItem> items;
    SignalInt sel;

    WizardDemo() {
        this.InitControl("wizarddemo", 5);
        items = new List<WizardItem>();
        items.Add(new WizardItem("控制台应用", "code",
                                 "带有 main() 入口的命令行程序。"));
        items.Add(new WizardItem("图形界面应用", "grid",
                                 "基于 Gui 工具包的窗口应用。"));
        items.Add(new WizardItem("类库", "file",
                                 "无入口点的可复用库项目。"));
        sel = new SignalInt(0);
    }

    override void OnMeasure(App app) {
        prefW = app.Scale(320);
        prefH = app.Scale(200);
    }

    override void OnPaint(App app) {
        int listH = app.Scale(126);
        Wizard.RenderList(app, bx, by, bw, listH, items, sel);
        int i = sel.Get();
        if (i < 0 || i >= items.Count) { return; }
        WizardItem it = items[i];
        Theme t = app.theme;
        int ty = by + listH + app.Scale(12);
        app.canvas.DrawText(bx, ty, it.name, t.textPrimary,
                            t.fontSizeMedium);
        int ty2 = ty + Canvas.FontHeight(t.fontSizeMedium)
                  + app.Scale(6);
        app.canvas.DrawText(bx, ty2, it.desc, t.textSecondary,
                            t.fontSizeSmall);
    }
}

/* FormField 表单字段的卡片内演示。FormField 是设计器文档节点
 * 本身没有运行时绘制；它的运行时形态是经 FormBuilder.Build 把
 * 设计 JSON 实例化成真控件树——设计器画布预览与运行时窗口
 * 共用的就是这一条实例化路径，这里按同样方式喂一张迷你表单。 */
