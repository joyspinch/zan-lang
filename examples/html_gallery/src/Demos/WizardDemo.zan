using System;
using Gui;
using Gui.Widget;

public class WizardDemo : Control {
    public override int StyleDisplay() { return 1; } // Flex
    public override int StyleFlexDir() { return 1; } // Column

    public WizardDemo() {
        this.InitControl("wizarddemo", 5);
        this.ClassName = "wizard-demo col flex-1";

        Wizard wiz = new Wizard();
        wiz.AddStep("项目类型", new Label("带有 main() 入口的命令行程序或窗口应用"));
        wiz.AddStep("配置选项", new Label("配置项目名称、命名空间与目标平台"));
        wiz.AddStep("完成创建", new Label("确认工程结构并完成初始化向导"));

        this.Add(wiz);
    }
}
