using System;
using System.IO;
using Gui;
using Gui.Widget;
using Gui.Hmi;
using Gui.Component;
using Gui.Component.DataTable;
using Gui.Component.CodeEditor;
using Gui.Markup;

public class FormFieldDemo : Control {
    FormFieldDemo() {
        this.InitControl("formfielddemo", 5);
        string formHtml = "<form>"
            + "<input name=\"name\" placeholder=\"请输入项目名称\" data-label=\"项目名称\">"
            + "<select name=\"tpl\" data-label=\"项目类型\"><option>控制台应用</option><option>窗口应用</option><option>类库</option></select>"
            + "<switch name=\"git\" data-label=\"初始化 Git 仓库\"></switch>"
            + "<textarea name=\"desc\" placeholder=\"一句话描述这个项目\" data-label=\"项目描述\" data-fh=\"56\"></textarea>"
            + "</form>";
        HtmlDoc doc = Html.Parse(formHtml, "", null);
        Control root = doc != null ? doc.root : null;
        if (root != null) {
            root.DockFill();
            this.Add(root);
        }
    }

    override void OnMeasure(App app) {
        prefW = app.Scale(320);
        prefH = app.Scale(230);
    }
}
