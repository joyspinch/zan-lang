using System;
using System.Json;

class Program {
    static void Doit() {
        JsonValue v = JsonValue.Parse("{\"a\":1}");
        if (v.Has("a")) {
            throw new Exception("boom");
        }
    }
    static void Main() {
        try { Doit(); } catch (Exception e) { Console.WriteLine("caught"); }
    }
}
