cmake_policy(SET CMP0012 NEW)
if(NOT ZANC OR NOT SRC OR NOT OUT_EXE OR NOT WORKDIR)
  message(FATAL_ERROR "ZANC, SRC, OUT_EXE and WORKDIR are required")
endif()
set(assets "${WORKDIR}/embed_first_read_assets")
file(REMOVE_RECURSE "${assets}")
file(MAKE_DIRECTORY "${assets}")
set(alphabet ABCDEFGHIJKLMNOPQRSTUVWXYZ)
foreach(i RANGE 0 63)
  math(EXPR letter "${i} % 26")
  math(EXPR odd "${i} % 2")
  string(SUBSTRING "${alphabet}" ${letter} 1 ch)
  if(odd)
    set(size 257)
  else()
    set(size 65536)
  endif()
  string(REPEAT "${ch}" ${size} content)
  file(WRITE "${assets}/${i}.txt" "${content}")
endforeach()
execute_process(COMMAND "${ZANC}" "${SRC}" --auto-stdlib --check-leaks --arc-guard
  --embed "${assets}=race" -o "${OUT_EXE}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 120)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "compile failed (${rc}): ${out}${err}")
endif()
foreach(iteration RANGE 1 8)
  execute_process(COMMAND "${OUT_EXE}" WORKING_DIRECTORY "${WORKDIR}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 90)
  if(NOT rc EQUAL 0 OR NOT out MATCHES "PASS embed first read concurrency" OR
     "${out}${err}" MATCHES "memory leak detected|ARC guard|FAIL")
    message(FATAL_ERROR "first-read run ${iteration} failed (${rc}): ${out}${err}")
  endif()
endforeach()
file(REMOVE_RECURSE "${assets}")
message(STATUS "PASS embed first read concurrency: 8 fresh processes, 16 threads, 64 first reads")
