// S13（docs/ZAN_STANDARD.md §3）：Environment.Exit 在 Main 返回前退出，栈帧局部量
// 与静态字段（这里是 Encoding 的静态实例）仍活着——它们是根，不是泄漏。
// 只有不可达的孤儿环才算泄漏：本例一个都没有，退出报告必须保持沉默。
using System;
using System.Text;
using System.Collections.Generic;

class ExitHolder {
    public ExitHolder Peer;
}

public class Program {
    public static void Main() {
        byte[] bytes = Encoding.UTF8.GetBytes("hi");
        List<string> held = new List<string>();
        held.Add("kept by the live frame");
        ExitHolder x = new ExitHolder();
        ExitHolder y = new ExitHolder();
        x.Peer = y;
        y.Peer = x;
        Console.WriteLine("exit " + bytes.Length);
        Environment.Exit(0);
    }
}
