// S13（docs/ZAN_STANDARD.md §3）：--check-leaks 退出报告对孤儿环逐条打印路径。
// 三个环：Node 自环（.Next 指向自己）；Node -> List<Node> -> Node 的三跳环；
// 以及经闭包的环 LeakSub .pub -> LeakPub .hs -> List<Action> [0] -> closure .this
// -> LeakSub（闭包记录的捕获槽与委托值的标记指针都要能走通）。
using System;
using System.Collections.Generic;

class LeakNode {
    public string Name;
    public LeakNode Next;
    public List<LeakNode> Kids = new List<LeakNode>();
}

class LeakPub {
    public List<Action> hs = new List<Action>();
}

class LeakSub {
    public LeakPub pub = new LeakPub();
    public LeakSub() {
        LeakPub p = pub;
        p.hs.Add(() => Ping());
    }
    void Ping() { }
}

public class Program {
    public static void Main() {
        LeakNode a = new LeakNode();
        LeakNode b = new LeakNode();
        a.Next = b;
        b.Kids.Add(a);
        LeakNode self = new LeakNode();
        self.Next = self;
        a = null;
        b = null;
        self = null;
        LeakSub sub = new LeakSub();
        sub = null;
        Console.WriteLine("done");
    }
}
