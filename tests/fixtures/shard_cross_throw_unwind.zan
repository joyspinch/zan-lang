// S-UNWIND 跨片抛出回归钉（收缩 pass ② 的设计约束）：
// thrower 与 catch caller 被 ZAN_SHARD_MAX_FN=1 强制拆进不同分片——caller
// 模块里 thrower 只是 declaration。第一版 nounwind pass 曾把跨片 Zan 声明
// 误判为 C ABI nothrow 并塌缩其 invoke，拆掉必需的 unwind 边，异常逃逸到
// 顶层（IDE 绿 exe 启动即 FileNotFoundException）。本夹具在该形态下必须：
// catch 路径正常工作、stdout 与红（关断塌缩）逐字节一致、无顶层异常。
using System;

class Throwy {
    static string Boom() { throw new Exception("boom"); }
    static string Echo(string s) { return "e:" + s; }
}

class App {
    static int Work() {
        int r = 0;
        try {
            string s = Throwy.Echo("x") + Throwy.Boom();
            r = s.Length;
        } catch (Exception e) {
            r = 7;
        }
        return r;
    }

    static void Main() {
        Console.WriteLine(Work());
        Console.WriteLine("done");
    }
}
