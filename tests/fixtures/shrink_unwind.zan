using System;

// S-UNWIND 收缩 pass 红绿夹具：
// try 作用域内混排可证不抛调用（助手/串/列表/打印）与一个真实 raise
// 站点（除零），塌缩后必须：不抛 invoke 归零、raise 路径原样、输出
// 逐字节一致。
namespace ShrinkUnwindRepro;

class Prog {
    static int Twice(int x) { return x * 2; }
    static string Tag(string s) { return "v:" + s; }

    static int Runner() {
        int acc = 0;
        for (int i = 0; i < 100; i = i + 1) { acc = acc + Twice(i); }
        return acc;
    }

    static int Main() {
        List<string> parts = new List<string>();
        int acc = 0;
        try {
            parts.Add(Tag("a"));
            parts.Add(Tag("b"));
            for (int i = 0; i < 100; i = i + 1) { acc = acc + Twice(i); }
            acc = acc + Runner();
            Console.WriteLine(Convert.ToString(acc));
            int z = 0;
            int boom = 10 / z;
            Console.WriteLine(Convert.ToString(boom));
        } catch (Exception e) {
            Console.WriteLine("caught:" + Tag(e.ToString()));
        }
        Console.WriteLine(Convert.ToString(parts.Count));
        return 0;
    }
}
