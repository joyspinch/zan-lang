# Invoke through scripts/build_gate.ps1 (or a registered CTest wrapper).
# GEN1, CLANG, OUTDIR, RT_OBJS and SYSLIBS follow run_sync_exception_landing.cmake.
if(NOT GEN1 OR NOT CLANG OR NOT OUTDIR)
  message(FATAL_ERROR "GEN1, CLANG and OUTDIR are required")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/exception_ownership_provenance.cmake")
ownership_pin_stdlib()
file(MAKE_DIRECTORY "${OUTDIR}")
set(_src "${CMAKE_CURRENT_LIST_DIR}/sync_pending_scope.zan")
set(_gold "${CMAKE_CURRENT_LIST_DIR}/sync_pending_scope.out")
set(_inputs "${GEN1}" "${CLANG}" ${RT_OBJS} "${CMAKE_CURRENT_LIST_FILE}" "${_src}" "${_gold}")
foreach(_lib IN LISTS SYSLIBS)
  if(EXISTS "${_lib}")
    list(APPEND _inputs "${_lib}")
  endif()
endforeach()
ownership_capture(before _before)
file(WRITE "${OUTDIR}/identities.txt" "${_before}")
set(_ll "${OUTDIR}/sync_pending_scope.ll")
if(WIN32)
  set(_exe "${OUTDIR}/sync_pending_scope.exe")
else()
  set(_exe "${OUTDIR}/sync_pending_scope")
endif()
file(REMOVE "${_ll}" "${_exe}")
execute_process(COMMAND "${GEN1}" "${_ll}" "${_src}"
  WORKING_DIRECTORY "${OWNERSHIP_WORKDIR}"
  RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 120)
file(WRITE "${OUTDIR}/emit.log" "exit=${_rc}\n${_out}${_err}")
if(NOT _rc STREQUAL "0" OR NOT EXISTS "${_ll}")
  message(FATAL_ERROR "Pending scope emit failed (${_rc})\n${_out}${_err}")
endif()
execute_process(COMMAND "${CLANG}" "${_ll}" ${RT_OBJS} ${SYSLIBS} -o "${_exe}"
  RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 120)
file(WRITE "${OUTDIR}/link.log" "exit=${_rc}\n${_out}${_err}")
if(NOT _rc STREQUAL "0" OR NOT EXISTS "${_exe}")
  message(FATAL_ERROR "Pending scope link failed (${_rc})\n${_out}${_err}")
endif()
execute_process(COMMAND "${_exe}" RESULT_VARIABLE _rc
  OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10)
file(WRITE "${OUTDIR}/stdout" "${_out}")
file(WRITE "${OUTDIR}/stderr" "${_err}")
file(READ "${_gold}" _expected)
string(REPLACE "\r\n" "\n" _expected "${_expected}")
string(REPLACE "\r\n" "\n" _actual "${_out}")
if(NOT _rc STREQUAL "0" OR NOT _actual STREQUAL _expected OR NOT _err STREQUAL "")
  message(FATAL_ERROR "Pending scope trace/owner mismatch (exit=${_rc})\n${_out}${_err}")
endif()
foreach(_artifact "${_ll}" "${_exe}")
  file(SHA256 "${_artifact}" _hash)
  file(APPEND "${OUTDIR}/identities.txt" "${_artifact} ${_hash}\n")
endforeach()
ownership_capture(after _after)
if(NOT _before STREQUAL _after)
  message(FATAL_ERROR "Compiler, runtime, source or expected output changed during pending scope validation")
endif()
message(STATUS "Selfhost pending scope trace and weak owner lifetimes match")
