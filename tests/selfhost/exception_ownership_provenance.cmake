# A conservative input closure, not an exact compiler depfile: every file and
# directory in the selected stdlib is inventoried on EACH capture. This covers
# transitive auto-pull sources, namespace discovery, metadata and native inputs;
# additions/deletions and link retargeting must invalidate the evidence too.
set(_ownership_provenance_script "${CMAKE_CURRENT_LIST_FILE}")
set(_ownership_provenance_dir "${CMAKE_CURRENT_LIST_DIR}")

function(ownership_pin_stdlib)
  get_filename_component(_repo "${_ownership_provenance_dir}/../.." REALPATH)
  get_filename_component(_expected "${_repo}/stdlib" REALPATH)
  if(NOT IS_DIRECTORY "${_expected}/System")
    message(FATAL_ERROR "Main-repository stdlib/System is required")
  endif()
  if(DEFINED STDLIB_ROOT AND NOT "${STDLIB_ROOT}" STREQUAL "")
    get_filename_component(_requested "${STDLIB_ROOT}" REALPATH)
    if(NOT _requested STREQUAL _expected)
      message(FATAL_ERROR "Exception ownership requires main-repository stdlib: ${_expected}")
    endif()
  endif()
  # The selfhost driver checks this BEFORE ZAN_HOME / executable-relative roots.
  # set(ENV) affects this cmake process and its children, never the caller shell.
  set(ENV{ZAN_STDLIB_PATH} "${_expected}")
  set(STDLIB_ROOT "${_expected}" PARENT_SCOPE)
  set(OWNERSHIP_WORKDIR "${_repo}" PARENT_SCOPE)
endfunction()

function(ownership_tree_identity _root _result)
  if(NOT IS_DIRECTORY "${_root}")
    message(FATAL_ERROR "Provenance tree is missing: ${_root}")
  endif()
  # FOLLOW_SYMLINKS is intentional: a namespace exposed through a directory link
  # is still an input. Record both its logical path and canonical target.
  file(GLOB_RECURSE _entries LIST_DIRECTORIES true FOLLOW_SYMLINKS
    RELATIVE "${_root}" "${_root}/*")
  list(SORT _entries)
  get_filename_component(_canonical "${_root}" REALPATH)
  set(_identity "tree\t${_root}\t${_canonical}\n")
  foreach(_entry IN LISTS _entries)
    set(_path "${_root}/${_entry}")
    get_filename_component(_real "${_path}" REALPATH)
    if(IS_DIRECTORY "${_path}")
      string(APPEND _identity "directory\t${_entry}\t${_real}\n")
    elseif(EXISTS "${_path}")
      file(SHA256 "${_path}" _hash)
      string(APPEND _identity "${_hash}\t${_entry}\t${_real}\n")
    else()
      # Broken links / concurrent deletions cannot silently disappear.
      string(APPEND _identity "missing\t${_entry}\t${_real}\n")
    endif()
  endforeach()
  set(${_result} "${_identity}" PARENT_SCOPE)
endfunction()

function(ownership_capture _label _result)
  ownership_tree_identity("${STDLIB_ROOT}" _stdlib)
  set(_identities "exception-ownership-provenance-v2\n${_stdlib}")
  set(_files ${_inputs} "${_ownership_provenance_script}")
  list(REMOVE_DUPLICATES _files)
  list(SORT _files)
  foreach(_input IN LISTS _files)
    if(EXISTS "${_input}" AND NOT IS_DIRECTORY "${_input}")
      file(SHA256 "${_input}" _hash)
    else()
      if(_label STREQUAL "before")
        message(FATAL_ERROR "Required provenance input is missing: ${_input}")
      endif()
      set(_hash missing)
    endif()
    get_filename_component(_real "${_input}" REALPATH)
    string(APPEND _identities "${_hash}\t${_input}\t${_real}\n")
  endforeach()
  string(APPEND _identities "RT_OBJS=${RT_OBJS}\nSYSLIBS=${SYSLIBS}\n")
  file(WRITE "${OUTDIR}/identities-${_label}.txt" "${_identities}")
  set(${_result} "${_identities}" PARENT_SCOPE)
endfunction()
