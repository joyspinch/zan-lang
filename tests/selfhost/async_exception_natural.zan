using System;
class NaturalOriginal : Exception {
    public int stamp;
    public NaturalOriginal() : base("original") { stamp = 101; }
}
class NaturalReplacement : Exception {
    public int stamp;
    public NaturalReplacement() : base("replacement") { stamp = 201; }
}
class Program {
    static NaturalOriginal original;
    static NaturalReplacement replacement;
    static async void Pending() {
        try { throw original; }
        finally {
            await Task.Yield();
            try { throw replacement; }
            catch (NaturalReplacement nested) { await Task.Yield(); nested.stamp = nested.stamp + 1; }
        }
    }
    static async void Replace() {
        try { throw original; }
        finally {
            await Task.Yield();
            try { throw replacement; }
            catch (NaturalReplacement nested) { await Task.Yield(); throw; }
        }
    }
    static void Main() {
        // Natural external owners are reused, without extra keep-alive retains.
        // Every named catch binding must release only its own reference.
        original = new NaturalOriginal(); replacement = new NaturalReplacement();
        int i = 0;
        while (i < 3) {
            try { await Pending(); }
            catch (NaturalOriginal caught) { Console.WriteLine(caught == original); Console.WriteLine(caught.stamp); }
            i = i + 1;
        }
        i = 0;
        while (i < 2) {
            try { await Replace(); }
            catch (NaturalReplacement caught) { Console.WriteLine(caught == replacement); Console.WriteLine(caught.stamp); }
            i = i + 1;
        }
    }
}
