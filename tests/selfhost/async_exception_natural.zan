using System;
using System.Collections.Generic;
class NaturalOriginal : Exception {
    public int stamp;
    public NaturalOriginal() : base("original") { stamp = 101; }
}
class NaturalReplacement : Exception {
    public int stamp;
    public NaturalReplacement() : base("replacement") { stamp = 201; }
}
class NaturalBox {
    public int Val;
    public string Name;
    public List<NaturalBox> Items;
    public NaturalBox(int v) { this.Val = v; this.Name = "nb_" + v; this.Items = new List<NaturalBox>(); }
    public static NaturalBox operator ++(NaturalBox a) { return new NaturalBox(a.Val + 1); }
}
class NaturalPropHolder {
    NaturalBox inner;
    public NaturalPropHolder(int v) { this.inner = new NaturalBox(v); }
    public NaturalBox Current {
        get { return new NaturalBox(this.inner.Val); }
        set { this.inner = value; }
    }
}
record NaturalRec(string A, string B);
interface INatDummy { void Ping(); }
interface INatAdder { int Add(int x); }
interface INatSubAdder : INatAdder { int Mul(int x); }
interface INatGet<T> { T Get(int x); }
interface INatDefCalc { int Calc(int x) { return x + 10; } }
interface INatAsyncBox { Task<NaturalBox> GetAsync(bool boom); }
async delegate Task<NaturalBox> NatAsyncBoxDel(bool boom);
struct NatStructAdder : INatAdder {
    public int Base;
    public NatStructAdder(int b) { this.Base = b; }
    public int Add(int x) { return this.Base + x; }
}
class NatMultiImpl : INatDummy, INatSubAdder, INatGet<NaturalBox>, INatDefCalc, INatAsyncBox {
    public NaturalBox Tag;
    public NatMultiImpl(int v) { this.Tag = new NaturalBox(v); }
    public void Ping() { }
    public int Add(int x) { return this.Tag.Val + x; }
    public int Mul(int x) { return this.Tag.Val * x; }
    public NaturalBox Get(int x) { return new NaturalBox(this.Tag.Val + x); }
    public async Task<NaturalBox> GetAsync(bool boom) {
        NaturalBox local = new NaturalBox(this.Tag.Val + 1);
        await Task.Yield();
        if (boom) { throw new Exception("nmi_" + local.Name); }
        return local;
    }
}
class NatStrGetImpl : INatDummy, INatGet<string> {
    public string Prefix;
    public NatStrGetImpl(string p) { this.Prefix = p; }
    public void Ping() { }
    public string Get(int x) { return this.Prefix + "_" + x.ToString(); }
}
struct NatArcPair {
    public NaturalBox A;
    public string S;
    public NatArcPair(NaturalBox a, string s) { this.A = a; this.S = s; }
}
struct NatGenPair<T> {
    public T First;
    public T Second;
    public NatGenPair(T a, T b) { this.First = a; this.Second = b; }
}
struct NatOuterHolder {
    public NatGenPair<NaturalBox> P;
    public int Tag;
}
class NatGenBase<T> {
    public T Seed;
    public NaturalBox Fixed;
    public NatGenBase(T s) { this.Seed = s; this.Fixed = new NaturalBox(100); }
    public virtual T Pick(T alt, bool useAlt) { return useAlt ? alt : this.Seed; }
}
class NatGenSub<T> : NatGenBase<T> {
    public T Extra;
    public NatGenSub(T s, T e) : base(s) { this.Extra = e; }
    public NatGenSub(T s) : this(s, s) { }
    public NatGenSub(T s, bool boom) : base(s) {
        this.Extra = s;
        if (boom) { throw new Exception("nat_sub_boom"); }
    }
    public override T Pick(T alt, bool useAlt) { return useAlt ? this.Seed : alt; }
}
class NatConcreteSub : NatGenBase<NaturalBox> {
    public NaturalBox Own;
    public NatConcreteSub(NaturalBox s, NaturalBox o) : base(s) { this.Own = o; }
    public NatConcreteSub(NaturalBox s, bool boom) : base(s) {
        if (boom) { throw new Exception("nat_conc_boom"); }
        this.Own = s;
    }
    public override NaturalBox Pick(NaturalBox alt, bool useAlt) { return useAlt ? this.Seed : this.Own; }
}
class NatConcretePass : NatGenBase<NaturalBox> {
    public NatConcretePass(NaturalBox s) : base(s) { }
}
class NatConcreteStructSub : NatGenBase<NatArcPair> {
    public NatConcreteStructSub(NatArcPair s) : base(s) { }
}
class NatGenMid<A, B> : NatGenBase<B> {
    public A First;
    public NatGenMid(A a, B b) : base(b) { this.First = a; }
}
class NatGenLeaf<U> : NatGenMid<string, U> {
    public U Leaf;
    public NatGenLeaf(string k, U u, U l) : base(k, u) { this.Leaf = l; }
}
class NatSwapMid<A, B> : NatGenMid<B, A> {
    public A OwnA;
    public NatSwapMid(A a, B b) : base(b, a) { this.OwnA = a; }
}
class NatGenDefInit<T> {
    public T Item;
    public T[] Buf;
    public NatGenDefInit() { this.Buf = new T[2]; }
}
class NatGenArrBase<T> {
    public T[] Items = new T[2];
}
class NatConcreteArrSub : NatGenArrBase<NaturalBox> {
}
class Program {
    static NaturalOriginal original;
    static NaturalReplacement replacement;
    static NatGenPair<NaturalBox> sGenPair;
    static NaturalBox MakeBox(int v) { return new NaturalBox(v); }
    static object MakeObjBox(int v) { return new NaturalBox(v); }
    static NaturalRec MakeRec(int v) { return new NaturalRec("a" + v.ToString(), "b" + v.ToString()); }
    static (NaturalBox, NaturalBox) MakePair(int v) { return (new NaturalBox(v), new NaturalBox(v + 1)); }
    static string BoomStr() { throw new Exception("boom_str"); }
    static NaturalBox BoomBox() { throw new Exception("boom_box"); }
    static object NextObjBox(int i) {
        if (i < 3) { return new NaturalBox(10 + i); }
        return null;
    }
    static bool TryMakeBox(int v, out NaturalBox b) {
        b = new NaturalBox(v);
        return v > 0;
    }
    static async Task<int> AsyncIsAndOut() {
        int acc = 0;
        if (MakeObjBox(5) is NaturalBox b) {
            await Task.Yield();
            acc = acc + b.Val + b.Name.Length;
        }
        if (MakeBox(1).Val > 0 && MakeObjBox(9) is NaturalBox b2) {
            await Task.Yield();
            acc = acc + b2.Val + b2.Name.Length;
        }
        Func<int> cap = null;
        if (MakeObjBox(5) is NaturalBox b3) {
            await Task.Yield();
            cap = () => b3.Val + b3.Name.Length;
        }
        await Task.Yield();
        if (cap != null) { acc = acc + cap(); }
        int wi = 0;
        while (NextObjBox(wi) is NaturalBox wb) {
            await Task.Yield();
            wi = wi + 1;
            if (wi == 1) { continue; }
            acc = acc + wb.Val;
            if (wi == 2) { break; }
        }
        try {
            int tj = 0;
            while (NextObjBox(tj) is NaturalBox tb) {
                await Task.Yield();
                if (tj == 1) { throw new Exception("w_" + tb.Name); }
                tj = tj + 1;
            }
        } catch (Exception e) {
            await Task.Yield();
            acc = acc + e.Message.Length;
        }
        if (TryMakeBox(5, out NaturalBox ab)) {
            await Task.Yield();
            acc = acc + ab.Val + ab.Name.Length;
        }
        Func<int> outCap = null;
        if (TryMakeBox(7, out NaturalBox cb)) {
            await Task.Yield();
            outCap = () => cb.Val + cb.Name.Length;
        }
        await Task.Yield();
        if (outCap != null) { acc = acc + outCap(); }
        int oi = 0;
        while (TryMakeBox(2 - oi, out NaturalBox ob)) {
            await Task.Yield();
            acc = acc + ob.Val + ob.Name.Length;
            oi = oi + 1;
        }
        return acc;
    }
    static int SyncDeconAndSwitchCapture() {
        int acc = 0;
        Func<int> dcap = null;
        {
            var (a, b) = MakePair(7);
            dcap = () => a.Val + b.Val;
            a = new NaturalBox(20);
        }
        acc = acc + dcap();
        Func<int> scap = null;
        switch (MakeObjBox(5)) {
            case NaturalBox b:
                scap = () => b.Val;
                b = new NaturalBox(50);
                break;
        }
        acc = acc + scap();
        Func<int> seCap = MakeObjBox(6) switch {
            NaturalBox b => () => b.Val + b.Name.Length,
            _ => () => 0
        };
        acc = acc + seCap();
        return acc;
    }
    static async Task<int> AsyncWithDeconSwitch() {
        int acc = 0;
        int j = 0;
        while (j < 2) {
            NaturalRec r = (MakeRec(j) with { A = "x" + j.ToString() }) with { B = MakeBox(j).Name };
            await Task.Yield();
            acc = acc + r.A.Length + r.B.Length;
            j = j + 1;
        }
        try {
            NaturalRec r2 = (MakeRec(9) with { A = "y" }) with { B = BoomStr() };
            acc = acc + r2.A.Length;
        } catch (Exception e) {
            await Task.Yield();
            acc = acc + e.Message.Length;
        }
        int i = 0;
        while (i < 3) {
            var (_, b) = MakePair(i + 1);
            await Task.Yield();
            Func<int> f = () => b.Val;
            b = new NaturalBox(10 + i);
            await Task.Yield();
            acc = acc + f();
            i = i + 1;
        }
        try {
            var (c, d) = MakePair(7);
            await Task.Yield();
            throw new Exception("decon_" + c.Name + d.Name);
        } catch (Exception e) {
            await Task.Yield();
            acc = acc + e.Message.Length;
        }
        int k = 0;
        while (k < 2) {
            Func<int> swf = null;
            switch (MakeObjBox(k + 1)) {
                case NaturalBox sb:
                    await Task.Yield();
                    swf = () => sb.Val;
                    sb = new NaturalBox(20 + k);
                    break;
            }
            await Task.Yield();
            acc = acc + swf();
            k = k + 1;
        }
        Func<int> sef = MakeObjBox(7) switch {
            NaturalBox eb => () => eb.Val + eb.Name.Length,
            _ => () => 0
        };
        await Task.Yield();
        acc = acc + sef();
        return acc;
    }
    static async Task<int> AsyncCtorAndCollectionInit() {
        int acc = 0;
        await Task.Yield();
        NaturalBox b1 = new NaturalBox(42) { Name = MakeBox(1).Name };
        acc = acc + b1.Val + b1.Name.Length;
        try {
            await Task.Yield();
            NaturalBox b2 = new NaturalBox(1) { Name = MakeBox(2).Name, Items = { MakeBox(3), BoomBox() } };
            acc = acc + b2.Val;
        } catch (Exception e) {
            await Task.Yield();
            acc = acc + e.Message.Length;
        }
        List<NaturalBox> l1 = new List<NaturalBox>(4) { MakeBox(10), MakeBox(20) };
        await Task.Yield();
        acc = acc + l1.Count + l1[0].Val + l1[1].Val;
        List<NaturalBox> lCopy = new List<NaturalBox>(l1) { MakeBox(30) };
        acc = acc + lCopy.Count + lCopy[2].Val;
        try {
            await Task.Yield();
            List<NaturalBox> lBad = new List<NaturalBox>(4) { MakeBox(1), BoomBox() };
            acc = acc + lBad.Count;
        } catch (Exception e) {
            await Task.Yield();
            acc = acc + e.Message.Length;
        }
        Dictionary<string, NaturalBox> d1 = new Dictionary<string, NaturalBox>(4) { { "k1", MakeBox(5) } };
        await Task.Yield();
        acc = acc + d1.Count + d1["k1"].Val;
        try {
            Dictionary<string, NaturalBox> dBad = new Dictionary<string, NaturalBox>(4) { { MakeBox(1).Name, MakeBox(2) }, { MakeBox(3).Name, BoomBox() } };
            acc = acc + dBad.Count;
        } catch (Exception e) {
            await Task.Yield();
            acc = acc + e.Message.Length;
        }
        NaturalPropHolder ph = new NaturalPropHolder(20);
        NaturalBox oldProp = ph.Current++;
        acc = acc + oldProp.Val + ph.Current.Val;
        return acc;
    }
    static async Task<(NaturalBox, NaturalBox)> MakeTupleAsync(int v) {
        await Task.Yield();
        return (MakeBox(v), MakeBox(v + 1));
    }
    static async Task<NaturalBox> MakeBoxAsync(int v) {
        await Task.Yield();
        return MakeBox(v);
    }
    static async Task<int> MakeIntAsync(int v) {
        await Task.Yield();
        return v;
    }
    static async Task<Exception> MakeExAsync(string tag) {
        await Task.Yield();
        return new Exception("ex_" + tag);
    }
    static async Task<int> AsyncDeconThrowLock() {
        int acc = 0;
        var (a, b) = await MakeTupleAsync(10);
        var tp = await MakeTupleAsync(20);
        var (c, d) = tp;
        var solo = await MakeBoxAsync(30);
        await Task.Yield();
        acc = acc + a.Val + b.Val + c.Val + d.Val + solo.Val; // 92
        try {
            throw await MakeExAsync("boom");
        } catch (Exception e) {
            await Task.Yield();
            acc = acc + e.Message.Length; // 7
        }
        lock (await MakeBoxAsync(5)) {
            int x = 10 + await MakeIntAsync(6);
            acc = acc + x; // 16
        }
        NatMultiImpl mi = new NatMultiImpl(10);
        INatAdder ia = mi;
        Func<int, int> fa = ia.Add;
        acc = acc + fa(5); // 15
        INatSubAdder isa = mi;
        Func<int, int> fm = isa.Mul;
        acc = acc + fm(3); // 30
        Func<int, int> baseFn = isa.Add;
        acc = acc + baseFn(6); // 16
        INatGet<NaturalBox> igb = mi;
        Func<int, NaturalBox> fgb = igb.Get;
        acc = acc + fgb(7).Val; // 17
        INatGet<string> igs = new NatStrGetImpl("hi");
        Func<int, string> fgs = igs.Get;
        acc = acc + fgs(99).Length; // 5
        INatDefCalc idc = mi;
        Func<int, int> fc = idc.Calc;
        acc = acc + fc(4); // 14
        INatAdder sa = new NatStructAdder(20);
        Func<int, int> fsa = sa.Add;
        acc = acc + fsa(4); // 24
        INatAsyncBox iab = mi;
        NatAsyncBoxDel fad = iab.GetAsync;
        NaturalBox okb = await fad(false);
        acc = acc + okb.Val; // 11
        try {
            NaturalBox badb = await fad(true);
            acc = acc + badb.Val;
        } catch (Exception e) {
            await Task.Yield();
            acc = acc + e.Message.Length; // "nmi_nb_11" = 9
        }
        return acc; // 115+15+30+16+17+5+14+24+11+9 = 256
    }
    static async void Pending() {
        try { throw original; }
        finally {
            await Task.Yield();
            try { throw replacement; }
            catch (NaturalReplacement nested) { await Task.Yield(); nested.stamp = nested.stamp + 1; }
        }
    }
    static async void Replace() {
        try { throw original; }
        finally {
            await Task.Yield();
            try { throw replacement; }
            catch (NaturalReplacement nested) { await Task.Yield(); throw; }
        }
    }
    static NatArcPair MakeArcPair(int v) { return new NatArcPair(MakeBox(v), "p_" + v.ToString()); }
    static int GenericInheritanceAndStructOwnership() {
        int acc = 0;
        NatGenBase<NaturalBox> gb = new NatGenSub<NaturalBox>(MakeBox(30));
        NaturalBox c1 = MakeBox(3);
        acc = acc + gb.Pick(c1, true).Val; // 30
        NatGenSub<NaturalBox> gs2 = new NatGenSub<NaturalBox>(MakeBox(40), MakeBox(50));
        acc = acc + gs2.Seed.Val + gs2.Extra.Val; // 90
        try {
            NatGenSub<NaturalBox> bad = new NatGenSub<NaturalBox>(MakeBox(60), true);
            acc = acc + bad.Seed.Val;
        } catch (Exception e) { acc = acc + e.Message.Length; } // 12
        NatGenSub<NatArcPair> gsp = new NatGenSub<NatArcPair>(MakeArcPair(8), MakeArcPair(9));
        acc = acc + gsp.Seed.A.Val + gsp.Extra.A.Val; // 17
        NatGenBase<NaturalBox> cb = new NatConcreteSub(MakeBox(70), MakeBox(80));
        acc = acc + cb.Pick(c1, true).Val + cb.Pick(c1, false).Val; // 150
        try {
            NatConcreteSub bad2 = new NatConcreteSub(MakeBox(71), true);
            acc = acc + bad2.Seed.Val;
        } catch (Exception e) { acc = acc + e.Message.Length; } // 13
        NatConcretePass cp = new NatConcretePass(MakeBox(11));
        NatGenBase<NaturalBox> cpb = cp;
        acc = acc + cp.Pick(c1, false).Val + cpb.Pick(MakeBox(12), true).Val; // 23
        cp.Seed = MakeBox(15);
        acc = acc + cp.Seed.Val; // 15
        NatConcreteStructSub cs = new NatConcreteStructSub(MakeArcPair(20));
        acc = acc + cs.Seed.A.Val + cs.Seed.S.Length; // 24
        NatGenLeaf<NaturalBox> gl = new NatGenLeaf<NaturalBox>("k_" + MakeBox(1).Name, MakeBox(21), MakeBox(22));
        acc = acc + gl.First.Length + gl.Seed.Val + gl.Leaf.Val; // 6+21+22 = 49
        NatSwapMid<NaturalBox, string> sw = new NatSwapMid<NaturalBox, string>(MakeBox(31), "s_" + MakeBox(2).Name);
        acc = acc + sw.OwnA.Val + sw.Seed.Val + sw.First.Length; // 31+31+6 = 68
        NatGenPair<NaturalBox> p1 = new NatGenPair<NaturalBox>(MakeBox(10), MakeBox(20));
        NatGenPair<NaturalBox> p2 = p1;
        p2 = new NatGenPair<NaturalBox>(MakeBox(30), MakeBox(40));
        acc = acc + p1.First.Val + p2.Second.Val; // 50
        NatGenPair<NaturalBox> u;
        u.First = MakeBox(10);
        NatGenPair<NaturalBox> uCopy = u;
        uCopy.First = MakeBox(99);
        acc = acc + u.First.Val + uCopy.First.Val; // 109
        NatGenPair<NaturalBox>[] a1 = new NatGenPair<NaturalBox>[2];
        a1[0].First = MakeBox(5);
        a1[1] = new NatGenPair<NaturalBox>(MakeBox(6), MakeBox(7));
        acc = acc + a1[0].First.Val + a1[1].First.Val + a1[1].Second.Val; // 18
        NatGenPair<NaturalBox>[,] a2 = new NatGenPair<NaturalBox>[2, 2];
        a2[0, 1] = new NatGenPair<NaturalBox>(MakeBox(8), MakeBox(9));
        acc = acc + a2[0, 1].First.Val + a2[0, 1].Second.Val; // 17
        sGenPair.First = MakeBox(13);
        sGenPair.Second = MakeBox(14);
        acc = acc + sGenPair.First.Val + sGenPair.Second.Val; // 27
        sGenPair = new NatGenPair<NaturalBox>(MakeBox(1), MakeBox(2));
        NatGenPair<NatArcPair> gp1 = new NatGenPair<NatArcPair>(MakeArcPair(21), MakeArcPair(22));
        NatGenPair<NatArcPair> gp2 = gp1;
        gp2.First = MakeArcPair(88);
        acc = acc + gp1.First.A.Val + gp2.First.A.Val; // 109
        NatGenPair<NatGenPair<NaturalBox>> ng1 = new NatGenPair<NatGenPair<NaturalBox>>(
            new NatGenPair<NaturalBox>(MakeBox(3), MakeBox(4)),
            new NatGenPair<NaturalBox>(MakeBox(5), MakeBox(6)));
        NatGenPair<NatGenPair<NaturalBox>> ng2 = ng1;
        ng2.First = new NatGenPair<NaturalBox>(MakeBox(70), MakeBox(80));
        acc = acc + ng1.First.First.Val + ng2.First.Second.Val; // 83
        NatGenPair<string> ps1 = new NatGenPair<string>("a_" + MakeBox(1).Name, "b_" + MakeBox(2).Name);
        NatGenPair<string> ps2 = ps1;
        ps2 = new NatGenPair<string>("c_" + MakeBox(3).Name, "d_" + MakeBox(4).Name);
        acc = acc + ps1.First.Length + ps2.Second.Length; // 6+6 = 12
        NatGenPair<NaturalBox[]> pa1 = new NatGenPair<NaturalBox[]>(new NaturalBox[] { MakeBox(11) }, new NaturalBox[] { MakeBox(12) });
        NatGenPair<NaturalBox[]> pa2 = pa1;
        pa2 = new NatGenPair<NaturalBox[]>(new NaturalBox[] { MakeBox(13) }, new NaturalBox[] { MakeBox(14) });
        acc = acc + pa1.First[0].Val + pa2.Second[0].Val; // 25
        List<NatGenPair<NaturalBox>> lp = new List<NatGenPair<NaturalBox>>();
        lp.Add(new NatGenPair<NaturalBox>(MakeBox(15), MakeBox(16)));
        lp[0] = new NatGenPair<NaturalBox>(MakeBox(17), MakeBox(18));
        acc = acc + lp[0].First.Val + lp[0].Second.Val; // 35
        NatOuterHolder[] oh = new NatOuterHolder[2];
        oh[0].P.First = MakeBox(19);
        oh[0].Tag = 2;
        NatOuterHolder ohCopy = oh[0];
        ohCopy.P.First = MakeBox(20);
        acc = acc + oh[0].P.First.Val + ohCopy.P.First.Val + oh[0].Tag; // 41
        NatGenDefInit<NaturalBox> di = new NatGenDefInit<NaturalBox> { Item = MakeBox(25) };
        di.Buf[0] = MakeBox(26);
        di.Buf[1] = MakeBox(27);
        acc = acc + di.Item.Val + di.Buf[0].Val + di.Buf[1].Val; // 78
        NatConcreteArrSub cas = new NatConcreteArrSub();
        cas.Items[0] = MakeBox(30);
        cas.Items[1] = MakeBox(31);
        acc = acc + cas.Items[0].Val + cas.Items[1].Val; // 61
        return acc; // 1156
    }
    static void Main() {
        // Natural external owners are reused, without extra keep-alive retains.
        // Every named catch binding must release only its own reference.
        original = new NaturalOriginal(); replacement = new NaturalReplacement();
        int i = 0;
        while (i < 3) {
            try { await Pending(); }
            catch (NaturalOriginal caught) { Console.WriteLine(caught == original); Console.WriteLine(caught.stamp); }
            i = i + 1;
        }
        i = 0;
        while (i < 2) {
            try { await Replace(); }
            catch (NaturalReplacement caught) { Console.WriteLine(caught == replacement); Console.WriteLine(caught.stamp); }
            i = i + 1;
        }
        Console.WriteLine(await AsyncIsAndOut());
        Console.WriteLine(SyncDeconAndSwitchCapture());
        Console.WriteLine(await AsyncWithDeconSwitch());
        Console.WriteLine(await AsyncCtorAndCollectionInit());
        Console.WriteLine(await AsyncDeconThrowLock());
        Console.WriteLine(GenericInheritanceAndStructOwnership());
    }
}
