# Invoke under the shared build gate; this is a standalone semantic oracle.
# A pass identifies the supplied GEN1 binary; build provenance is recorded by
# the caller, independently of this execution-time stability check.
if(DEFINED OUTDIR AND NOT "${OUTDIR}" STREQUAL "")
  file(REMOVE "${OUTDIR}/passed.txt")
  foreach(_stage emit verify link run)
    file(REMOVE "${OUTDIR}/${_stage}.exit" "${OUTDIR}/${_stage}.stdout" "${OUTDIR}/${_stage}.stderr")
  endforeach()
endif()
foreach(_required GEN1 CLANG LLVM_AS OUTDIR)
  if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
    message(FATAL_ERROR "${_required} is required")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/exception_ownership_provenance.cmake")
ownership_pin_stdlib()
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(_source "${CMAKE_CURRENT_LIST_DIR}/exception_payload_ownership.zan")
set(_gold "${CMAKE_CURRENT_LIST_DIR}/exception_payload_ownership.out")
set(_manifest "${_root}/scripts/selfhost_sources.txt")
file(STRINGS "${_manifest}" _sources)
set(_inputs "${GEN1}" "${CLANG}" "${LLVM_AS}" ${RT_OBJS}
  "${_source}" "${_gold}" "${_manifest}" "${CMAKE_CURRENT_LIST_FILE}")
foreach(_lib IN LISTS SYSLIBS)
  if(EXISTS "${_lib}" AND NOT IS_DIRECTORY "${_lib}")
    list(APPEND _inputs "${_lib}")
  endif()
endforeach()
foreach(_item IN LISTS _sources)
  string(STRIP "${_item}" _item)
  if(NOT _item STREQUAL "" AND NOT _item MATCHES "^#")
    if(IS_ABSOLUTE "${_item}")
      list(APPEND _inputs "${_item}")
    else()
      list(APPEND _inputs "${_root}/src/${_item}.zan")
    endif()
  endif()
endforeach()
file(MAKE_DIRECTORY "${OUTDIR}")
ownership_capture(before _before)
set(_ll "${OUTDIR}/exception_payload_ownership.ll")
set(_bc "${OUTDIR}/exception_payload_ownership.bc")
set(_exe "${OUTDIR}/exception_payload_ownership${CMAKE_EXECUTABLE_SUFFIX}")
if(WIN32)
  set(_exe "${OUTDIR}/exception_payload_ownership.exe")
endif()
# Only invalidate this runner's known artifacts, never the containing directory.
file(REMOVE "${_ll}" "${_bc}" "${_exe}" "${OUTDIR}/passed.txt")
file(WRITE "${OUTDIR}/link-inputs.txt" "RT_OBJS=${RT_OBJS}\nSYSLIBS=${SYSLIBS}\n")
function(_stage _name _timeout)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${OWNERSHIP_WORKDIR}" RESULT_VARIABLE _rc
    OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT ${_timeout})
  file(WRITE "${OUTDIR}/${_name}.exit" "${_rc}\n")
  file(WRITE "${OUTDIR}/${_name}.stdout" "${_out}")
  file(WRITE "${OUTDIR}/${_name}.stderr" "${_err}")
  if(NOT _rc STREQUAL "0")
    ownership_capture(after _after)
    message(FATAL_ERROR "Payload ${_name} failed: ${_rc}\n${_out}${_err}")
  endif()
endfunction()
_stage(emit 120 "${GEN1}" "${_ll}" "${_source}")
_stage(verify 120 "${LLVM_AS}" "${_ll}" -o "${_bc}")
_stage(link 120 "${CLANG}" "${_ll}" ${RT_OBJS} ${SYSLIBS} -o "${_exe}")
_stage(run 30 "${_exe}")
file(READ "${_gold}" _want)
file(READ "${OUTDIR}/run.stdout" _actual)
file(READ "${OUTDIR}/run.stderr" _stderr)
string(REPLACE "\r\n" "\n" _want "${_want}")
string(REPLACE "\r\n" "\n" _actual "${_actual}")
ownership_capture(after _after)
if(NOT _before STREQUAL _after)
  message(FATAL_ERROR "Payload validation input drift; evidence is diagnostic only")
endif()
if(NOT _actual STREQUAL _want OR NOT _stderr STREQUAL "")
  message(FATAL_ERROR "Payload exact trace mismatch\n${_actual}${_stderr}")
endif()
file(WRITE "${OUTDIR}/passed.txt" "Exact stdout, empty runtime stderr, zero stage exits, LLVM verification and stable input identities.\n")
message(STATUS "exception_payload_ownership: exact trace and LLVM verification match")
