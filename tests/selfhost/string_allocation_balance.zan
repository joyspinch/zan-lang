using System;
using System.Collections.Generic;

class StringHolder {
    public string value;
}

class Program {
    [DllImport("crt", EntryPoint = "string_probe_begin")]
    static extern void Begin();
    [DllImport("crt", EntryPoint = "string_probe_end")]
    static extern long End();

    static string Fresh(string part) { return part + "!"; }
    static string BorrowedReturn(string value) { return value; }
    static int Local() {
        string first = "left";
        string second = "right";
        string value = first + second;
        string alias = value;
        value = value + "?";
        return alias.Length + value.Length;
    }
    static int Expressions() {
        int i = 0;
        int count = 0;
        while (i < 4) {
            count = count + (Fresh("x") + i).Length;
            string alternating = i % 2 == 0 ? Fresh("yes") : "no";
            count = count + alternating.Length;
            i = i + 1;
        }
        string branch = count > 0 ? Fresh("yes") : Fresh("no");
        return count + branch.Length;
    }
    static int Returns() {
        string value = Fresh("return");
        string alias = BorrowedReturn(value);
        return value.Length + alias.Length;
    }
    static int Fields() {
        StringHolder holder = new StringHolder();
        holder.value = Fresh("field");
        string alias = holder.value;
        holder.value = Fresh("replace");
        return alias.Length + holder.value.Length;
    }
    static int Containers() {
        List<string> values = new List<string>();
        values.Add(Fresh("one"));
        values.Add(Fresh("two"));
        values[0] = Fresh("new");
        string[] array = values.ToArray();
        Dictionary<string, string> map = new Dictionary<string, string>();
        map[Fresh("key")] = Fresh("value");
        map["key!"] = Fresh("replacement");
        return values[0].Length + array[1].Length + map["key!"].Length;
    }
    static int Transforms() {
        string value = Fresh(" ab,cd ");
        string clean = value.Trim().ToUpper().Replace("AB", "xy");
        List<string> parts = clean.Split(",");
        string joined = string.Join("-", parts);
        return joined.Substring(1).Length;
    }
    static int EmbeddedNul() {
        string value = "A\0B" + Fresh("C");
        string alias = BorrowedReturn(value);
        return value.Length + alias.Length;
    }
    static void ThrowFresh() { throw Fresh("exception"); }
    static string Escape() {
        try { ThrowFresh(); }
        catch (string caught) { return caught; }
        return "unreachable";
    }
    static int Exceptional() {
        string result = Escape();
        return result.Length;
    }
    static int Unwind() {
        try {
            string local = Fresh("local");
            ThrowFresh();
            return local.Length;
        } catch (string caught) {
            return caught.Length;
        }
    }
    static object DynamicFresh() { return Fresh("dynamic"); }
    static int Dynamic() {
        object value = DynamicFresh();
        object alias = value;
        value = Fresh("replacement");
        List<object> items = new List<object>();
        items.Add(alias);
        items.Add(Fresh("item"));
        return ((string)items[0]).Length + ((string)value).Length;
    }
    static async string AsyncFresh() {
        string value = Fresh("async");
        await Task.Yield();
        return BorrowedReturn(value);
    }
    static async string AsyncEscape() {
        string value = Fresh("before");
        await Task.Yield();
        try { throw Fresh("async-exception"); }
        catch (string caught) {
            await Task.Yield();
            return caught;
        }
        return value;
    }
    static int Async() {
        string first = await AsyncFresh();
        string second = await AsyncEscape();
        return first.Length + second.Length;
    }
    static void Main() {
        Begin(); int a = Local(); long ba = End(); Console.WriteLine(a); Console.WriteLine(ba);
        Begin(); int b = Expressions(); long bb = End(); Console.WriteLine(b); Console.WriteLine(bb);
        Begin(); int c = Returns(); long bc = End(); Console.WriteLine(c); Console.WriteLine(bc);
        Begin(); int d = Fields(); long bd = End(); Console.WriteLine(d); Console.WriteLine(bd);
        Begin(); int e = Containers(); long be = End(); Console.WriteLine(e); Console.WriteLine(be);
        Begin(); int f = Transforms(); long bf = End(); Console.WriteLine(f); Console.WriteLine(bf);
        Begin(); int g = EmbeddedNul(); long bg = End(); Console.WriteLine(g); Console.WriteLine(bg);
        Begin(); int h = Exceptional(); long bh = End(); Console.WriteLine(h); Console.WriteLine(bh);
        Begin(); int i = Unwind(); long bi = End(); Console.WriteLine(i); Console.WriteLine(bi);
        Begin(); int j = Dynamic(); long bj = End(); Console.WriteLine(j); Console.WriteLine(bj);
        Begin(); int k = Async(); long bk = End(); Console.WriteLine(k); Console.WriteLine(bk);
    }
}
