// Math.Abs lowers the integer path with `ashr i64 <op>`, so a class
// instance (a pointer) must be refused.
//
// The C host reports
//   Math.Abs requires an int or floating-point argument
// The self-hosted backend produced invalid IR for the same program.
using System;

class Box {
    public int Value;
}

class Program {
    static void Main() {
        Box b = new Box();
        b.Value = 42;
        int r = Math.Abs(b);
        Console.WriteLine(r);
    }
}
