// A struct is not a number either: Convert.ToInt32 must refuse it.
//
// The C host reports
//   Convert.ToInt32: cannot convert 'Pt' to a number -- pass a string or a numeric value
// The self-hosted backend answered 0 instead of refusing the program.
using System;

struct Pt {
    public int X;
    public int Y;
}

class Program {
    static void Main() {
        Pt p = new Pt();
        int r = Convert.ToInt32(p);
        Console.WriteLine(r);
    }
}
