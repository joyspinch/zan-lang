// A class instance is not a number: Convert.ToInt32 must refuse it.
//
// The C host reports
//   Convert.ToInt32: cannot convert 'Box' to a number -- pass a string or a numeric value
// The self-hosted backend answered 0 for the class instance (and read the
// object's bytes as text on the string path) -- a silent wrong answer where
// the host refuses the program.
using System;

class Box {
    public int Value;
}

class Program {
    static void Main() {
        Box b = new Box();
        b.Value = 42;
        int r = Convert.ToInt32(b);
        Console.WriteLine(r);
    }
}
