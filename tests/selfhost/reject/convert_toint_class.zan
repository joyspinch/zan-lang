// Convert.ToInt shares the whitelist with ToInt32: a class instance must be
// refused.
//
// The C host reports
//   Convert.ToInt: cannot convert 'Box' to a number -- pass a string or a numeric value
// The self-hosted backend answered 0 instead of refusing the program.
using System;

class Box {
    public int Value;
}

class Program {
    static void Main() {
        Box b = new Box();
        b.Value = 42;
        int r = Convert.ToInt(b);
        Console.WriteLine(r);
    }
}
