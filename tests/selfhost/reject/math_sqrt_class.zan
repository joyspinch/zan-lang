// A class instance is not a number: Math.Sqrt must refuse it.
//
// The C host reports
//   Math.Sqrt requires an int or floating-point argument
// The self-hosted backend used to lower the pointer with `sitofp i64 <ptr>`,
// which is invalid IR -- the compile died in the LLVM verifier with an
// internal error instead of a diagnostic the user can act on.
using System;

class Box {
    public int Value;
}

class Program {
    static void Main() {
        Box b = new Box();
        b.Value = 42;
        double r = Math.Sqrt(b);
        Console.WriteLine(r);
    }
}
