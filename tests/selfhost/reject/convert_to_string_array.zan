// An array is not a string: the C host reports
//   Convert.ToString: cannot convert 'int[]' to a string -- call .ToString() on the value instead
// The name is the ELEMENT's name plus the rank suffix -- the array's own
// name is not a name the user can act on.
using System;

class Program {
    static void Main() {
        Console.WriteLine(Convert.ToString(new int[3]));
    }
}
