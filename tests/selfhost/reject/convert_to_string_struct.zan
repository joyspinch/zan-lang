// A struct is not a string either: the C host reports
//   Convert.ToString: cannot convert 'Pt' to a string -- call .ToString() on the value instead
// A struct used to land in the numeric branch and produce IR that LLVM
// rejects ("Call parameter type does not match function signature").
using System;

struct Pt {
    public int X;
    public int Y;
}

class Program {
    static void Main() {
        Pt p = new Pt();
        Console.WriteLine(Convert.ToString(p));
    }
}
