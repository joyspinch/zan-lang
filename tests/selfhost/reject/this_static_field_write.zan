// `this.S = v` where S is a static field: an instance reference cannot reach
// a static member. The read was already E3009; the write used to store
// nothing (host) or emit an invalid field GEP (gen1). Both now refuse it.
using System;
class Counter {
    public static int calls;
    public Counter() { this.calls = 0; }
}
public class Program {
    public static void Main() { Counter c = new Counter(); Console.WriteLine(Counter.calls); }
}
