// A call the self-hosted backend cannot lower.
//
// `Math.Max` is a C-host builtin (src/compiler/builtin_api.c, members_math),
// but the self-hosted backend implements only a part of that surface
// (`Math.Round`). The old lowering answered with the constant 0, so the
// program silently got a wrong value instead of a diagnostic. The
// self-hosted compiler must refuse the program.
using System;

class Program {
    static void Main() {
        Console.WriteLine(Math.Max(3, 7));
    }
}
