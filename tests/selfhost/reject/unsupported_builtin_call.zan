// A call the self-hosted backend cannot lower.
//
// `Task.IsDone` is a C-host builtin (src/compiler/builtin_api.c, members_task),
// but the self-hosted backend has no coroutine frame layout yet, so it cannot
// lower the Task.* family (see TASKS.md A385). The lowering used to answer
// with the constant 0, so the program silently got a wrong value instead of
// a diagnostic. The self-hosted compiler must refuse the program.
using System;

class Program {
    static void Main() {
        Console.WriteLine(Task.IsDone(3));
    }
}
