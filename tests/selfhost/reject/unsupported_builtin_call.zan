// A call the self-hosted backend cannot lower.
//
// The task handle family is lowered now (Task.Run / Task.Spawn / t.Wait() /
// t.Result / t.IsCompleted / Task.IsDone / Task.Cancel / Task.IsCancellationRequested
// -- see TASKS.md A419), but the rest of the C host's task builtins are not:
// `Task.JoinNew` is one of them (src/compiler/builtin_api.c, members_task).
// The self-hosted compiler must refuse the program.
using System;

class Program {
    static void Main() {
        long h = Task.JoinNew(1, 0);
        Console.WriteLine(h);
    }
}
