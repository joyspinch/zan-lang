// A call the self-hosted backend cannot lower.
//
// The task handle family is lowered now (Task.Run / Task.Spawn / t.Wait() /
// t.Result / t.IsCompleted / Task.IsDone / Task.Cancel -- see TASKS.md
// A419), but the rest of the C host's task builtins are not:
// `Task.IsCancellationRequested` is one of them (src/compiler/builtin_api.c,
// members_task). The lowering used to answer with the constant 0, so the
// program silently got a wrong value instead of a diagnostic. The self-hosted
// compiler must refuse the program.
using System;

class Program {
    static void Main() {
        int flag = Task.IsCancellationRequested();
        Console.WriteLine(flag);
    }
}
