// A bool is not a number: Math.Sqrt must refuse it (A498).
//
// The C host used to lower bool with `sitofp i1 <op>`, treating true as -1.0
// and answering with NaN. The self-hosted backend used to allow it as well.
// Both compilers must refuse it with the exact same diagnostic.
using System;

class Program {
    static void Main() {
        double r = Math.Sqrt(true);
        Console.WriteLine(r);
    }
}
