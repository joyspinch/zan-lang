// An array is not a number: Convert.ToInt32 must refuse it. The C host
// prints the ELEMENT's name -- an array names its element with the rank
// beside it.
//
// The C host reports
//   Convert.ToInt32: cannot convert 'int' to a number -- pass a string or a numeric value
// The self-hosted backend sitofp'd the array pointer -- invalid IR.
using System;

class Program {
    static void Main() {
        int[] a = new int[3];
        int r = Convert.ToInt32(a);
        Console.WriteLine(r);
    }
}
