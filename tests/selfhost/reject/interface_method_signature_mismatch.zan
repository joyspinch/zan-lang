// B-ID186 Wave 11: interface contract checking runs in normal compilation mode
// and rejects mismatched parameter/return signatures with [E1015].
using System;

interface ICalc {
    int Compute(int x);
}

class BadCalc : ICalc {
    public int Compute(uint x) { return 0; }
}

class Program {
    static void Main() {
        ICalc c = new BadCalc();
        Console.WriteLine(c.Compute(1));
    }
}
