// A class instance is not a string: Convert.ToString must refuse it.
//
// The C host reports
//   Convert.ToString: cannot convert 'Box' to a string -- call .ToString() on the value instead
// The self-hosted backend used to print the OBJECT ADDRESS instead (the value
// fell into the `snprintf("%lld", ptr)` branch) -- an information leak and a
// useless answer. A442: both compilers now refuse it with the same wording.
using System;

class Box {
    public int Value;
}

class Program {
    static void Main() {
        Box b = new Box();
        Console.WriteLine(Convert.ToString(b));
    }
}
