// `!` has no operator-overload path (the host has no `operator !`), so a
// class instance is just as wrong as a string: the lowering would be
// "compare the reference with 0". The C host answers the same program with
// the same wording -- the reject case pins both.
using System;

class Box {
    public int v = 0;
}

class Program {
    static void Main() {
        Box b = new Box();
        Console.WriteLine(!b);
    }
}
