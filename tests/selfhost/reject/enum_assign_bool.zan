// An enum slot does not accept a boolean value (A486).
//
// The C host reports
//   cannot convert 'bool' to 'Color' in initializer: no implicit conversion
// The self-hosted checker used to skip enum targets entirely, accepting
// programs the host refuses.
using System;

enum Color { Red, Green, Blue }

class Program {
    static void Main() {
        Color c = true;
        Console.WriteLine(c);
    }
}
