// An `await` whose operand is not a coroutine frame.
//
// The self-hosted backend lowers `await <call>` into a read of the awaited
// frame's slot 5 (the resume entry). An operand that is not a frame -- here
// `Task.Delay`, which the C host lowers as a task handle -- has no such
// slot: the old lowering produced `bitcast i8* 0 to i64*`, which is not
// valid IR at all (clang rejects it with "integer constant must have
// integer type"). The self-hosted compiler must report a diagnostic
// instead.
using System;

class Program {
    static void Main() {
        await Task.Delay(80);
        Console.WriteLine("done");
    }
}
