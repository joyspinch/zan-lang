// The self-hosted compiler must refuse `!` on a non-bool operand: the
// lowering is `icmp eq i64 <ptr>, 0` -- valid IR, but it compares a
// pointer with zero. The C host answers the same program with the same
// wording -- the reject case pins both.
using System;

class Program {
    static void Main() {
        string s = "x";
        Console.WriteLine(!s);
    }
}
