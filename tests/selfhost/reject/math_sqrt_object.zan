// `object` is not a number: the C host lowers it to a pointer, so
// Math.Sqrt must refuse it.
//
// The C host reports
//   Math.Sqrt requires an int or floating-point argument
// The self-hosted backend let it through (the type table has no `object`
// entry) and sitofp'd the pointer -- invalid IR.
using System;

class Box {
    public int Value;
}

class Program {
    static void Main() {
        Box b = new Box();
        b.Value = 42;
        object o = b;
        double r = Math.Sqrt(o);
        Console.WriteLine(r);
    }
}
