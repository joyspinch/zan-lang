// 一个 Task 形状的槽位只收任务句柄：把裸值（这里是 double）塞进去必须
// 在编译期被拒绝，而且用宿主的那句诊断
// （"cannot convert 'double' to 'Task' in initializer: no implicit
// conversion"）——注意目标类型拼的是 'Task'，不带类型实参。
using System;

class Program {
    static double Half(double x) { return x / 2.0; }

    static void Main() {
        Task<double> t = Half(5.0);
        Console.WriteLine(t);
    }
}
