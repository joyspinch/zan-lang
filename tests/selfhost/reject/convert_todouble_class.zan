// Convert.ToDouble shares the whitelist with the integer conversions: a
// class instance must be refused.
//
// The C host reports
//   Convert.ToDouble: cannot convert 'Box' to a number -- pass a string or a numeric value
// The self-hosted backend sitofp'd the class pointer -- invalid IR.
using System;

class Box {
    public int Value;
}

class Program {
    static void Main() {
        Box b = new Box();
        b.Value = 42;
        double r = Convert.ToDouble(b);
        Console.WriteLine(r);
    }
}
