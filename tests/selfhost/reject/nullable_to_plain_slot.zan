// A nullable value does not land in a plain slot: `int?` is not `int`.
//
// The C host used to answer
//   cannot convert 'int' to 'int' in initializer: no implicit conversion
// -- the nullable's name IS the element type's name, so the diagnostic named
// a type the user never wrote. Both sides now say
//   cannot convert 'int?' to 'int' in initializer: no implicit conversion
using System;

class Program {
    static void Main() {
        int? n = 5;
        int x = n;
        Console.WriteLine(x);
    }
}
