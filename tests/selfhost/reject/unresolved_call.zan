// A call whose receiver resolves to nothing.
//
// The receiver name is not a variable, a type or a namespace, so the call
// cannot be lowered at all. The old lowering evaluated the receiver into
// the constant 0 and answered the call with 0 -- the program silently got
// a wrong value. The self-hosted compiler must refuse the program.
using System;

class Program {
    static void Main() {
        Console.WriteLine(NotAType.Anything(1));
    }
}
