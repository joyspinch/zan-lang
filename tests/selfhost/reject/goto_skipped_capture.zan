using System;
public delegate int GotoRead();
class OwnedGotoValue { public int value; }
class Program {
    static void Main() {
        bool skip = true;
        if (skip) { goto after; }
        OwnedGotoValue value = new OwnedGotoValue();
        GotoRead read = () => value.value;
        after:
        Console.WriteLine("unreachable");
    }
}
