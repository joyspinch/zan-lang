// B-ID83: an `internal` member is reachable only from its own module (the
// first two namespace segments). Acc.Other calling Acc.Inner's internal
// method must be refused by the self-hosted compiler -- with the same
// sentence the C host emits for tests/diag/access_internal_module.zan.
using System;
using Acc.Inner;

namespace Acc.Other;

class Abuser {
    static int Steal() { return Core.Tag(); }
}

class Program {
    static void Main() {
        Console.WriteLine(Abuser.Steal());
    }
}
