// An enum slot is an integral slot: a float value narrows into it.
//
// The C host reports
//   narrowing conversion from 'double' to 'Color' in initializer needs an explicit cast (C# rules)
using System;

enum Color { Red, Green }

class Program {
    static void Main() {
        Color c = 5.0;
        Console.WriteLine(c);
    }
}
