// A handle that carries no result used where a Task<T> is expected.
//
// Task.Run(lambda/Action) starts an action frame: the completion path
// releases it. Reading the same handle as a result handle releases it a
// second time (the reader reaps it) -- a double free that aborts the
// process. The C host rejects this at compile time
// (tests/diag/task_run_action_result_type.zan); the self-hosted checker
// must reject it with the same diagnostic, not fall through to the
// backend's "Task.Run is not supported" complaint.
using System;

class Program {
    static void Main() {
        Task<int> t = Task.Run(() => { Console.WriteLine("action-ran"); });
        Console.WriteLine(t.Result);
    }
}
