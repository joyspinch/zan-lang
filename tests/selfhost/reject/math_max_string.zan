// Math.Max judges BOTH arguments on their own: a string next to an integer
// must be refused with the plural wording.
//
// The C host reports
//   Math.Max requires numeric arguments
// The self-hosted backend used to sitofp the string pointer -- invalid IR.
using System;

class Program {
    static void Main() {
        int r = Math.Max("3", 1);
        Console.WriteLine(r);
    }
}
