// An integral constant that does not fit the target's range narrows as
// well -- `byte b = 200;` is fine, `byte b = 300;` is not.
//
// The C host reports
//   narrowing conversion from 'int' to 'byte' in initializer needs an explicit cast (C# rules)
using System;

class Program {
    static void Main() {
        byte b = 300;
        Console.WriteLine(b);
    }
}
