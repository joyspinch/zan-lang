// A delegate is not a number either -- and the self-hosted binder keeps the
// delegates out of its type table, so a lookup there would not see them.
//
// The C host reports
//   Convert.ToInt32: cannot convert 'D' to a number -- pass a string or a numeric value
// The self-hosted backend answered 0 instead of refusing the program.
using System;

delegate int D(int x);

class Program {
    static void Main() {
        D d = (x) => x + 1;
        int r = Convert.ToInt32(d);
        Console.WriteLine(r);
    }
}
