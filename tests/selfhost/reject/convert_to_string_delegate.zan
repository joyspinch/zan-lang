// A delegate is not a string: the C host reports
//   Convert.ToString: cannot convert 'D' to a string -- call .ToString() on the value instead
// The self-hosted binder keeps the delegates OUT of its type table (they live
// in `delegates`), so a lookup in the type table would not see them.
using System;

delegate int D(int x);

class Program {
    static void Main() {
        D d = (x) => x + 1;
        Console.WriteLine(Convert.ToString(d));
    }
}
