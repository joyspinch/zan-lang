// A float value does not land in an integral slot: the host reports the
// narrowing rule, not the general "no implicit conversion" one.
//
// The C host reports
//   narrowing conversion from 'double' to 'int' in initializer needs an explicit cast (C# rules)
using System;

class Program {
    static void Main() {
        int y = 5.0;
        Console.WriteLine(y);
    }
}
