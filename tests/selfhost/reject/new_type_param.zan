// 类型参数不能实例化：宿主与自举必须用同一句措辞拒绝它。
// （`new T()` 没有可用的构造入口，只能造出一个 null 引用——运行期第一次
//   成员访问就崩进程。数组形态 `new T[n]` 是合法的，不在此列。）
using System;

class Maker<T> {
    public T Make() {
        T t = new T();
        return t;
    }
}

class Program {
    static void Main() {
        Maker<int> mk = new Maker<int>();
        Console.WriteLine(mk.Make());
    }
}
