// The general assignability check: a string does not land in an int slot.
//
// The C host reports
//   cannot convert 'string' to 'int' in initializer: no implicit conversion
// The self-hosted checker used to stay silent -- it only had the two
// Task-specific rules -- so the self-host compiled the program and let the
// string pointer land in the int slot (the host's own run of such a program
// answers a garbage number).
using System;

class Program {
    static void Main() {
        int y = "hello";
        Console.WriteLine(y);
    }
}
