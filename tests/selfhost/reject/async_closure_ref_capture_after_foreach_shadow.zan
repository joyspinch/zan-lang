using System;

delegate int Read();

class Program {
    static async int Capture(ref int value) {
        int[] values = new int[1];
        foreach (int value in values) { }
        // The iteration-local is out of scope; this captures the ref parameter.
        Read read = () => value;
        await Task.Delay(1);
        return read();
    }

    static void Main() { }
}
