// B-ID163①：同步 lambda 赋给 async 委托必须编译错误 E3104。
// lambda 不是协程（体内 await 本身就是 E3032）；旧实现静默通过，调用侧
// 按协程帧步进发射、结果槽永远留默认值——string 形即静默空串。
// 方法组路径的孪生检查是 E3047（check_delegate_async_match）。
using System;

async delegate string Fetch(string url);

class Program {
    static int Main() {
        Fetch f = (string u) => u;
        Console.WriteLine(f == null);
        return 0;
    }
}
