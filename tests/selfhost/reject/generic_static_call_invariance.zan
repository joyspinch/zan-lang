// B-ID186 Wave 13: static generic factory call `Box<int>.Create()` must
// substitute the static receiver's type arguments into the return type so
// invariant mismatches are rejected with [E2024].
using System;

class Box<T> {
    public static Box<T> Create() { return new Box<T>(); }
}

class Program {
    static void Main() {
        Box<long> b = Box<int>.Create();
    }
}
