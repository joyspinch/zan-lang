// The narrowing rule on the return path: a float value in an int slot.
//
// The C host reports
//   narrowing conversion from 'double' to 'int' in return statement needs an explicit cast (C# rules)
using System;

class Program {
    static int Value() {
        return 5.0;
    }

    static void Main() {
        Console.WriteLine(Value());
    }
}
