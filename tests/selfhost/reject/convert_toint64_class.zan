// Convert.ToInt64 shares the whitelist with ToInt32: a class instance must
// be refused.
//
// The C host reports
//   Convert.ToInt64: cannot convert 'Box' to a number -- pass a string or a numeric value
// The self-hosted backend handed the class pointer out as an i64 -- invalid
// IR.
using System;

class Box {
    public int Value;
}

class Program {
    static void Main() {
        Box b = new Box();
        b.Value = 42;
        long r = Convert.ToInt64(b);
        Console.WriteLine(r);
    }
}
