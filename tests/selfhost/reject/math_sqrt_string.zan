// A string is not a number: Math.Sqrt must refuse it.
//
// The C host reports
//   Math.Sqrt requires an int or floating-point argument
// The self-hosted backend used to lower the string pointer with
// `sitofp i64 <ptr>` -- invalid IR, and the program the host rejects
// compiled here.
using System;

class Program {
    static void Main() {
        double r = Math.Sqrt("3.0");
        Console.WriteLine(r);
    }
}
