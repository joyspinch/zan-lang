// 同一条规则在 return 语句上：一个没有 async 标记的 Task 返回方法，
// 方法体里 return 一个裸值必须被拒绝
// （"cannot convert 'int' to 'Task' in return statement: no implicit
// conversion"）。
using System;

class Program {
    static Task<int> Bad() {
        return 5;
    }

    static void Main() {
        Console.WriteLine("x");
    }
}
