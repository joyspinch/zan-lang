using System;
using System.Threading;

namespace Diag;

// An un-awaited async call yields its coroutine frame rather than its result:
// using it as a value must fail with E2116 on both compilers, while statement
// calls, `await`, and `Task.Spawn`/`Task.Run` arguments remain allowed.
class Program {
    static async int Count(int i) {
        await Task.Delay(0);
        return i;
    }

    static async bool Allowed() {
        await Task.Delay(0);
        return false;
    }

    static void Main() {
        Count(1);
        Task.Spawn(Program.Count(2));
        int ok = await Count(3);
        int bad = Count(4);
        if (!Allowed()) {
            Console.WriteLine("denied");
        }
        Console.WriteLine(Convert.ToString(ok + bad));
    }
}
