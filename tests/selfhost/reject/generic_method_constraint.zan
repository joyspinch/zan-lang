using System;

class Entity {
    public int Id;
}

class Program {
    static T FirstItem<T>(List<T> xs) where T : Entity {
        return xs[0];
    }

    public static void Main() {
        List<int> ints = new List<int>();
        ints.Add(5);
        int v = FirstItem(ints);
        Console.WriteLine(v);
    }
}
