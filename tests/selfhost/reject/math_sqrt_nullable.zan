// A nullable is not a number: the C host lowers it to a struct, so
// Math.Sqrt must refuse it.
//
// The C host reports
//   Math.Sqrt requires an int or floating-point argument
// The self-hosted backend treated `int?` as an integer (the integer test
// ignores the nullable mark) and satofp'd the boxed cell -- invalid IR.
using System;

class Program {
    static void Main() {
        int? x = 5;
        double r = Math.Sqrt(x);
        Console.WriteLine(r);
    }
}
