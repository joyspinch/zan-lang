// B-ID186 Wave 13: converting a concrete class implementing `BoxSource<int>`
// to `BoxSource<sbyte>` must be rejected with [E2024].
using System;

interface BoxSource<T> {
    T Get();
}

class IntBox : BoxSource<int> {
    public int Get() { return 1; }
}

class Program {
    static void Main() {
        BoxSource<sbyte> src = new IntBox();
    }
}
