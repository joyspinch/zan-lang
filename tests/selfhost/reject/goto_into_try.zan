using System;

class Program {
    static void Forward(bool jump) {
        if (jump) { goto InsideForward; }
        try {
        InsideForward:
            if (jump) { return; }
        } finally { }
    }

    static void Backward(bool jump) {
        try {
        InsideTry:
            if (jump) { return; }
        } finally { }
        if (jump) { goto InsideTry; }
    }

    static void Sibling(bool jump) {
        try {
            if (jump) { goto InsideSibling; }
        } finally { }
        try {
        InsideSibling:
            if (jump) { return; }
        } finally { }
    }

    static void CatchAndFinally(bool jump) {
        try {
            if (jump) { goto InsideCatch; }
        } catch (Exception) {
        InsideCatch:
            if (jump) { goto InsideFinally; }
        } finally {
        InsideFinally:
            if (jump) { return; }
        }
    }

    static void LockBody(object gate, bool jump) {
        if (jump) { goto InsideLock; }
        lock (gate) {
        InsideLock:
            if (jump) { return; }
        }
    }

    static void SameNameInTryAndFinally(bool jump) {
        try {
        Shared:
            if (jump) { return; }
        } finally {
        Shared:
            if (jump) { jump = false; }
        }
        if (jump) { goto Shared; }
    }

    static void Main() { }
}
