// The self-hosted compiler must refuse a unary minus on a string: its
// lowering is `sub i64 0, <ptr>`, which is invalid IR (and on `~` it takes
// the compiler down). The C host answers the same program with the same
// wording -- the reject case pins both.
using System;

class Program {
    static void Main() {
        string s = "x";
        Console.WriteLine(-s);
    }
}
