// A conditional expression whose arms are strings is a string: it cannot
// land in an int slot.
//
// The C host reports
//   cannot convert 'string' to 'int' in initializer: no implicit conversion
// The self-hosted checker used to give the conditional expression NO type
// (InferType had no AK.Conditional branch), so the assignment was never
// judged -- the self-hosted compiler accepted a program the host refuses.
using System;

class Program {
    static void Main() {
        bool isSet = true;
        int x = isSet ? "a" : "b";
        Console.WriteLine(x);
    }
}
