// `await` 落在 async 方法的 lambda 体内：lambda 不是协程。
//
// lambda 体在 irgen 里发射时把协程帧置空，它里面的 await 只能挂到**外层
// 协程**的块上——跨函数的 br，LLVM 校验直接失败（"Referring to a basic
// block in another function"）。自举没有 async-lambda 形态，宿主以前干脆
// 发出非法 IR：两个后端都必须拒绝它，而且措辞一致。
//
// 边界：同步方法里的同样写法合法（没有外层协程，根驱动等得到），不在此列。
using System;

class Program {
    public delegate void F(int n);

    static async int Work(int n) {
        await Task.Delay(1);
        return n * 2;
    }

    static async void Main() {
        F f = (int n) => {
            int v = await Program.Work(n);
            Console.WriteLine("v=" + Convert.ToString(v));
        };
        f(21);
    }
}
