# Selfhost-only semantic regression: deliberately does not compare to host output.
# Invoke under scripts/build_gate.ps1 or a registered CTest wrapper, with:
# cmake -DGEN1=<fresh gen1> -DCLANG=<clang> -DOUTDIR=<build/test-out/...>
#   "-DRT_OBJS=<selfhost runtime list>" "-DSYSLIBS=<link libraries>"
#   -P tests/selfhost/run_sync_exception_landing.cmake
if(NOT GEN1 OR NOT CLANG OR NOT OUTDIR)
  message(FATAL_ERROR "GEN1, CLANG and OUTDIR are required")
endif()
file(MAKE_DIRECTORY "${OUTDIR}")
set(_inputs "${GEN1}" "${CLANG}" ${RT_OBJS} "${CMAKE_CURRENT_LIST_FILE}")
foreach(_name sync_exception_landing sync_exception_lock_landing)
  list(APPEND _inputs "${CMAKE_CURRENT_LIST_DIR}/${_name}.zan" "${CMAKE_CURRENT_LIST_DIR}/${_name}.out")
endforeach()
foreach(_lib IN LISTS SYSLIBS)
  if(EXISTS "${_lib}")
    list(APPEND _inputs "${_lib}")
  endif()
endforeach()
set(_before)
file(WRITE "${OUTDIR}/identities.txt" "")
foreach(_input IN LISTS _inputs)
  file(SHA256 "${_input}" _hash)
  list(APPEND _before "${_hash}")
  file(APPEND "${OUTDIR}/identities.txt" "${_input} ${_hash}\n")
endforeach()
foreach(_name sync_exception_landing sync_exception_lock_landing)
  set(_src "${CMAKE_CURRENT_LIST_DIR}/${_name}.zan")
  set(_gold "${CMAKE_CURRENT_LIST_DIR}/${_name}.out")
  set(_ll "${OUTDIR}/${_name}.ll")
  if(WIN32)
    set(_exe "${OUTDIR}/${_name}.exe")
  else()
    set(_exe "${OUTDIR}/${_name}")
  endif()
  file(REMOVE "${_ll}" "${_exe}")
  execute_process(COMMAND "${GEN1}" "${_ll}" "${_src}"
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 120)
  file(WRITE "${OUTDIR}/${_name}.emit.log" "exit=${_rc}\n${_out}${_err}")
  if(NOT _rc STREQUAL "0" OR NOT EXISTS "${_ll}")
    message(FATAL_ERROR "${_name}: emit failed (${_rc})\n${_out}${_err}")
  endif()
  execute_process(COMMAND "${CLANG}" "${_ll}" ${RT_OBJS} ${SYSLIBS} -o "${_exe}"
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 120)
  file(WRITE "${OUTDIR}/${_name}.link.log" "exit=${_rc}\n${_out}${_err}")
  if(NOT _rc STREQUAL "0" OR NOT EXISTS "${_exe}")
    message(FATAL_ERROR "${_name}: link failed (${_rc})\n${_out}${_err}")
  endif()
  execute_process(COMMAND "${_exe}" RESULT_VARIABLE _rc
    OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10)
  file(WRITE "${OUTDIR}/${_name}.stdout" "${_out}")
  file(WRITE "${OUTDIR}/${_name}.stderr" "${_err}")
  file(READ "${_gold}" _expected)
  string(REPLACE "\r\n" "\n" _expected "${_expected}")
  string(REPLACE "\r\n" "\n" _actual "${_out}")
  if(NOT _rc STREQUAL "0" OR NOT _actual STREQUAL _expected OR NOT _err STREQUAL "")
    message(FATAL_ERROR "${_name}: execution/trace mismatch (exit=${_rc})\n${_out}${_err}")
  endif()
  file(SHA256 "${_ll}" _ll_hash)
  file(SHA256 "${_exe}" _exe_hash)
  file(APPEND "${OUTDIR}/identities.txt" "${_name}.ll ${_ll_hash}\n${_name}.exe ${_exe_hash}\n")
endforeach()
set(_after)
foreach(_input IN LISTS _inputs)
  file(SHA256 "${_input}" _hash)
  list(APPEND _after "${_hash}")
endforeach()
if(NOT _before STREQUAL _after)
  message(FATAL_ERROR "Compiler, runtime, source or expected output changed during validation")
endif()
message(STATUS "Selfhost synchronous exception cleanup traces match; monitor entered on another OS thread")
