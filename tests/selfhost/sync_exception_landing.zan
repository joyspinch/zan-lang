using System;

class LandingOriginal : Exception {
    public LandingOriginal() : base("original") { }
}

class LandingReplacement : Exception {
    public LandingReplacement() : base("replacement") { }
}

class LandingGate { }

class Program {
    static void Fail() {
        throw new LandingReplacement();
    }

    static void Main() {
        try {
            try {
                throw new LandingOriginal();
            } catch (LandingOriginal) {
                Fail();
            } catch (LandingReplacement) {
                Console.WriteLine("wrong sibling catch");
            } finally {
                Console.WriteLine("catch finally");
            }
        } catch (LandingReplacement e) {
            Console.WriteLine(e.Message);
        }

        try {
            try {
                try {
                    throw new LandingOriginal();
                } finally {
                    Console.WriteLine("explicit finally");
                }
            } finally {
                Console.WriteLine("outer finally");
            }
        } catch (LandingOriginal) {
            Console.WriteLine("explicit original");
        }

        try {
            try {
                try {
                    throw new LandingOriginal();
                } catch (LandingOriginal) {
                    throw;
                }
            } finally {
                try { Fail(); } catch (LandingReplacement) { }
                Console.WriteLine("rethrow finally");
            }
        } catch (LandingOriginal e) {
            Console.WriteLine(e.Message);
        }

        LandingGate gate = new LandingGate();
        try {
            lock (gate) {
                Fail();
            }
        } catch (LandingReplacement e) {
            Console.WriteLine("lock: " + e.Message);
        }
    }
}
