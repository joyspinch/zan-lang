# No compiler/build/ctest required. Synthetic fixture only; never copies stdlib.
if(NOT TEST_DIR)
  message(FATAL_ERROR "TEST_DIR under build/test-out or _scratch is required")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/exception_ownership_provenance.cmake")
if(MODE STREQUAL "reject-root")
  set(STDLIB_ROOT "${TEST_DIR}")
  ownership_pin_stdlib()
  message(FATAL_ERROR "Foreign stdlib was accepted")
endif()
set(_fixture "${TEST_DIR}/ownership-provenance-fixture")
file(REMOVE_RECURSE "${_fixture}")
file(MAKE_DIRECTORY "${_fixture}/System/Nested")
file(WRITE "${_fixture}/System/Nested/Dependency.zan" "original\n")
ownership_tree_identity("${_fixture}" _original)
ownership_tree_identity("${_fixture}" _repeat)
if(NOT _original STREQUAL _repeat)
  message(FATAL_ERROR "Unchanged tree is unstable")
endif()
file(WRITE "${_fixture}/System/Nested/Dependency.zan" "modified\n")
ownership_tree_identity("${_fixture}" _modified)
if(_original STREQUAL _modified)
  message(FATAL_ERROR "Transitive source content drift was missed")
endif()
file(WRITE "${_fixture}/System/Nested/NewSource.zan" "added\n")
ownership_tree_identity("${_fixture}" _added)
if(_modified STREQUAL _added)
  message(FATAL_ERROR "Source addition was missed")
endif()
file(REMOVE "${_fixture}/System/Nested/Dependency.zan")
ownership_tree_identity("${_fixture}" _deleted)
if(_deleted STREQUAL _added)
  message(FATAL_ERROR "Source deletion was missed")
endif()
file(MAKE_DIRECTORY "${_fixture}/System/EmptyNamespace")
ownership_tree_identity("${_fixture}" _namespace)
if(_namespace STREQUAL _deleted)
  message(FATAL_ERROR "Namespace directory addition was missed")
endif()
# Exercise the public capture path too: membership must be recomputed, not
# frozen by the first capture. All inputs here are synthetic.
set(STDLIB_ROOT "${_fixture}")
set(OUTDIR "${TEST_DIR}/ownership-provenance-evidence")
file(MAKE_DIRECTORY "${OUTDIR}")
set(_inputs "${_fixture}/System/Nested/NewSource.zan")
ownership_capture(before _before)
ownership_capture(repeat _repeat)
if(NOT _before STREQUAL _repeat)
  message(FATAL_ERROR "Public capture is unstable for unchanged inputs")
endif()
file(WRITE "${_fixture}/System/Another.zan" "new auto-pull candidate\n")
ownership_capture(after _after)
if(_before STREQUAL _after OR NOT _after MATCHES "Another.zan"
   OR NOT _before MATCHES "exception_ownership_provenance.cmake")
  message(FATAL_ERROR "Public capture omitted the dynamic tree or its helper")
endif()
unset(STDLIB_ROOT)
set(ENV{ZAN_STDLIB_PATH} "${_fixture}")
set(ENV{ZAN_HOME} "${_fixture}")
ownership_pin_stdlib()
if(NOT "$ENV{ZAN_STDLIB_PATH}" STREQUAL STDLIB_ROOT)
  message(FATAL_ERROR "Ambient stdlib selection was not pinned")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DTEST_DIR=${_fixture}"
  -DMODE=reject-root -P "${CMAKE_CURRENT_LIST_FILE}"
  RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
if(_rc STREQUAL "0" OR NOT _err MATCHES "requires main-repository stdlib")
  message(FATAL_ERROR "Foreign stdlib root was not rejected: ${_out}${_err}")
endif()
file(REMOVE_RECURSE "${_fixture}" "${OUTDIR}")
message(STATUS "Ownership provenance detects nested content/add/delete/namespace drift and pins stdlib")
