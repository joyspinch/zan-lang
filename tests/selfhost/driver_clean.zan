namespace DriverIdentity {
    class Item {
        public static int Value() { return 1; }
    }

    partial class Outer {
        public partial class Item {
            public static int First() { return 2; }
        }

        public static int Value() { return Item.First() + Item.Second(); }
    }

    partial class Outer {
        public partial class Item {
            public static int Second() { return 4; }
        }
    }

    class Other {
        public class Item {
            public static int Value() { return 8; }
        }
    }

    partial class Split {
        public static int Value() { return 16; }
    }
}

namespace DriverIdentityOther {
    partial class Split {
        public static int Value() { return 32; }
    }
}

class DriverClean {
    static void Main() {
        int sum = DriverIdentity.Item.Value() + DriverIdentity.Outer.Value()
            + DriverIdentity.Outer.Item.Second() + DriverIdentity.Other.Item.Value()
            + DriverIdentity.Split.Value() + DriverIdentityOther.Split.Value();
        if (sum != 67) { throw "wrong declaration identity"; }
    }
}
