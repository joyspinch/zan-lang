using System;
using System.Threading;

class LandingMonitor { public int visits; }

class Program {
    static LandingMonitor gate = new LandingMonitor();
    static AtomicInt entered = new AtomicInt(0);

    static void Fail() { throw new Exception("locked"); }

    static void Worker() {
        lock (gate) { gate.visits = gate.visits + 1; }
        entered.Increment();
    }

    static void Main() {
        try {
            lock (gate) { Fail(); }
        } catch (Exception e) {
            Console.WriteLine(e.Message);
        }
        if (!Thread.Start(Worker)) {
            Console.WriteLine("worker start failed");
            return;
        }
        for (int i = 0; i < 500 && entered.Load() == 0; i = i + 1) { Thread.Sleep(2); }
        Console.WriteLine(entered.Load() == 1 ? "monitor released" : "monitor blocked");
    }
}
