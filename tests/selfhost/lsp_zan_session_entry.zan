namespace Zan;

/// tool_lsp_zan_session 用例入口：把 LspServer.Run() 暴露成独立 exe。
/// lsp.zan 本体无 Main（gen1 编译集的入口在 driver/main.zan），会话测试
/// 需要一个能直接进 LSP 主循环的可执行文件，因此由本文件提供入口并排在
/// zanc 命令行第一位（zanc 只给 paths[0] 生成 Main）。
public class LspZanSessionEntry {
    public static void Main() {
        LspServer.Run();
    }
}

/// 本测试编译集不含 driver/main.zan，但 frontend 的 ParseUnit() 引用
/// Program.DedupTopTypes（parser_scan.zan:561），Checker 会检查该未被
/// 调用的方法体。照抄 driver 的实现补齐 partial 合并；LSP 分析走
/// ParseDeclsOnly()，此方法实际不会被调用。
public partial class Program {
    public static void DedupTopTypes(Node unit) {
        List<string> seen = new List<string>();
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            int k = d.kind;
            bool isType = k == AK.ClassDecl() || k == AK.StructDecl()
                || k == AK.EnumDecl() || k == AK.DelegateDecl();
            bool dup = false;
            if (isType) {
                string full = d.nsName != null && d.nsName != "" ? d.nsName + "." + d.sval : d.sval;
                int j = 0;
                while (j < seen.Count) {
                    if (seen[j] == full) { dup = true; break; }
                    j = j + 1;
                }
            }
            if (dup) {
                unit.kids.RemoveAt(i);
                continue;
            }
            if (isType) {
                string full = d.nsName != null && d.nsName != "" ? d.nsName + "." + d.sval : d.sval;
                seen.Add(full);
            }
            i = i + 1;
        }
    }
}
