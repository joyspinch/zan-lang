// 核心契约与语义定义。
class JsonValue {
    string jv;
    public JsonValue(string x) { jv = x; }
    public static JsonValue NewNull() { return new JsonValue("null"); }
    public static JsonValue NewObject() { return new JsonValue("{}"); }
    public static JsonValue NewNum(string n) { return new JsonValue(n); }
    public static JsonValue NewStr(string s) { return new JsonValue(s); }
    public static JsonValue ParseLenient(string s) { return new JsonValue(s); }
    public bool IsObject() { return true; }
    public JsonValue Get(string k) { return new JsonValue(""); }
    public int Int(string k, int d) { return d; }
    public void Put(string k, JsonValue x) { jv = jv + "x"; }
}

class StringBuilder {
    string buf;
    public StringBuilder() { buf = ""; }
    public void Append(string x) { buf = buf + x; }
    public string ToString() { return buf; }
}

class Convert {
    public static string ToString(int x) { return "" + x; }
}

class Payload {
    int id;
    int[] arr;
}

class Program {
    static void Main() {
        Payload p = Json.Deserialize<Payload>("{}");
        Payload q = Json.Serialize<Payload>(p);
    }
}
