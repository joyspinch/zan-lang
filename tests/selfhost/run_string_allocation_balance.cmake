# Invoke under the shared build gate. Instrumented IR is an observation build;
# source expressions and generated ownership operations are left unchanged.
if(DEFINED OUTDIR AND NOT "${OUTDIR}" STREQUAL "")
  file(REMOVE "${OUTDIR}/passed.txt")
endif()
foreach(_required GEN1 CLANG LLVM_AS OUTDIR)
  if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
    message(FATAL_ERROR "${_required} is required")
  endif()
endforeach()
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/exception_ownership_provenance.cmake")
ownership_pin_stdlib()
set(_source "${CMAKE_CURRENT_LIST_DIR}/string_allocation_balance.zan")
set(_expected_count 11)
set(_expected "19\n1\n28\n1\n14\n1\n14\n1\n20\n1\n6\n1\n10\n1\n10\n1\n10\n1\n20\n1\n22\n1\n")
if(DEFINED FIXTURE AND FIXTURE STREQUAL "nullable")
  set(_source "${CMAKE_CURRENT_LIST_DIR}/nullable_allocation_balance.zan")
  set(_expected_count 4)
  set(_expected "11\n1\n1\n1\n131\n1\n41\n1\n")
endif()
set(_monitor "${CMAKE_CURRENT_LIST_DIR}/string_allocation_monitor.c")
set(_inputs "${GEN1}" "${CLANG}" "${LLVM_AS}" "${_source}" "${_monitor}" "${CMAKE_CURRENT_LIST_FILE}" ${RT_OBJS})
foreach(_lib IN LISTS SYSLIBS)
  if(EXISTS "${_lib}" AND NOT IS_DIRECTORY "${_lib}")
    list(APPEND _inputs "${_lib}")
  endif()
endforeach()
function(_identities _label _result)
  ownership_capture("${_label}" _text)
  set(${_result} "${_text}" PARENT_SCOPE)
endfunction()
file(MAKE_DIRECTORY "${OUTDIR}")
file(REMOVE "${OUTDIR}/passed.txt" "${OUTDIR}/raw.ll" "${OUTDIR}/raw.bc" "${OUTDIR}/monitored.ll" "${OUTDIR}/probe.bc" "${OUTDIR}/probe.exe")
_identities(before _before)
file(WRITE "${OUTDIR}/inputs-before.txt" "${_before}")
function(_stage _name)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "ZAN_STDLIB_PATH=${STDLIB_ROOT}" ${ARGN} WORKING_DIRECTORY "${_root}"
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 120)
  file(WRITE "${OUTDIR}/${_name}.exit" "${_rc}\n")
  file(WRITE "${OUTDIR}/${_name}.stdout" "${_out}")
  file(WRITE "${OUTDIR}/${_name}.stderr" "${_err}")
  if(NOT _rc STREQUAL "0")
    message(FATAL_ERROR "String allocation ${_name} failed: ${_rc}\n${_out}${_err}")
  endif()
endfunction()
_stage(emit "${GEN1}" "${OUTDIR}/raw.ll" "${_source}")
_stage(verify-raw "${LLVM_AS}" "${OUTDIR}/raw.ll" -o "${OUTDIR}/raw.bc")
file(READ "${OUTDIR}/raw.ll" _ir)
# Exact external symbol boundaries; monitor itself calls the original CRT.
foreach(_name malloc calloc realloc free)
  string(REPLACE "@${_name}(" "@string_probe_${_name}(" _ir "${_ir}")
endforeach()
file(WRITE "${OUTDIR}/monitored.ll" "${_ir}")
_stage(verify "${LLVM_AS}" "${OUTDIR}/monitored.ll" -o "${OUTDIR}/probe.bc")
_stage(link "${CLANG}" "${OUTDIR}/monitored.ll" "${_monitor}" ${RT_OBJS} ${SYSLIBS} -o "${OUTDIR}/probe.exe")
_stage(run "${OUTDIR}/probe.exe")
file(READ "${OUTDIR}/run.stdout" _actual)
file(READ "${OUTDIR}/run.stderr" _stderr)
string(REPLACE "\r\n" "\n" _actual "${_actual}")
string(REGEX MATCHALL "balance alloc=[0-9]+ free=[0-9]+ blocks=-?[0-9]+ bytes=-?[0-9]+ bad=[0-9]+" _balances "${_actual}")
list(LENGTH _balances _count)
if(NOT _count EQUAL _expected_count)
  message(FATAL_ERROR "Expected ${_expected_count} completed allocation observations, got ${_count}\n${_actual}")
endif()
foreach(_balance IN LISTS _balances)
  if(NOT _balance MATCHES "alloc=([0-9]+) free=([0-9]+) blocks=0 bytes=0 bad=0$")
    message(FATAL_ERROR "String allocation imbalance: ${_balance}")
  endif()
  if(NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2 OR CMAKE_MATCH_1 STREQUAL "0")
    message(FATAL_ERROR "Allocation/free counters do not prove exercised balance: ${_balance}")
  endif()
endforeach()
string(REGEX REPLACE "balance alloc=[0-9]+ free=[0-9]+ blocks=0 bytes=0 bad=0\n" "" _values "${_actual}")
_identities(after _after)
file(WRITE "${OUTDIR}/inputs-after.txt" "${_after}")
if(NOT _before STREQUAL _after)
  message(FATAL_ERROR "String allocation validation input drift")
endif()
if(NOT _values STREQUAL _expected OR NOT _stderr STREQUAL "")
  message(FATAL_ERROR "String allocation value/boolean oracle mismatch\n${_actual}${_stderr}")
endif()
file(WRITE "${OUTDIR}/passed.txt" "${_expected_count} natural ownership shapes from ${_source}: nonzero paired allocations/frees, zero live block/byte deltas, zero invalid frees, LLVM verification, exact values and stable recorded inputs.\n")
message(STATUS "allocation_balance: ${_expected_count} value and allocation/free observations pass")
