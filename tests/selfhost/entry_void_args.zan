using System;

class EntryVoidArgsTest {
    static void Main(string[] args) {
        Console.WriteLine(args.Length);
        for (int i = 0; i < args.Length; i = i + 1) {
            Console.WriteLine(args[i]);
        }
        if (args.Length > 0) {
            args[0] = "replaced";
            Console.WriteLine(args[0]);
        }
    }
}
