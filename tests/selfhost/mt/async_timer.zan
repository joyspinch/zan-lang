// The shipped runtime drives the frames: the self-hosted backend's coroutine
// frame starts with the scheduler's header (zan_co_fhdr), so a self-hosted
// program can be linked against the shipped multi-worker runtime and the
// runtime's timer ready hook really re-queues a delayed frame.
using System;
using System.Threading.Tasks;

class Program {
    static async Task<int> Work(int n) {
        await Task.Delay(20);
        int t = 0;
        int i = 0;
        while (i < n) { t = t + i; i = i + 1; }
        await Task.Delay(10);
        return t;
    }

    static async Task<string> Name() {
        await Task.Delay(5);
        return "zane";
    }

    static void Main() {
        int a = await Work(10);
        int b = await Work(20);
        string s = await Name();
        Console.WriteLine("a=" + a);
        Console.WriteLine("b=" + b);
        Console.WriteLine("s=" + s);
    }
}
