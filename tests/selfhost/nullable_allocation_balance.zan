using System;
using System.Collections.Generic;

class Program {
    [DllImport("crt", EntryPoint = "string_probe_begin")]
    static extern void Begin();
    [DllImport("crt", EntryPoint = "string_probe_end")]
    static extern long End();
    static int? Fresh(int value) { int? local = value; return local; }
    static int? Borrowed(int? value) { return value; }
    static int Locals() {
        int? first = Fresh(11);
        int? alias = Borrowed(first);
        first = null;
        alias = alias;
        int i = 0;
        while (i < 32) {
            int? temp = Fresh(i);
            int? second = temp;
            temp = null;
            if (second.Value != i) { return -1; }
            i = i + 1;
        }
        return alias.Value;
    }
    static int Decimal() {
        decimal? wide = 1.25m;
        decimal? previous = wide++;
        decimal? sum = wide + previous;
        previous = null;
        wide = null;
        return sum.Value == 3.50m ? 1 : 0;
    }
    static int Containers() {
        int?[] one = new int?[] { Fresh(43), null, Fresh(41) };
        int? saved = one[0];
        one[0] = null;
        one[2] = one[2];
        int?[,] rect = new int?[1,2];
        rect[0,0] = saved;
        saved = null;
        List<int?> items = new List<int?>();
        items.Add(Fresh(47));
        int? fromList = items[0];
        items.Clear();
        return rect[0,0].Value + one[2].Value + fromList.Value;
    }
    static async Task<int?> Across(int? value) {
        int? local = value;
        await Task.Yield();
        value = null;
        return local;
    }
    static int Async() {
        int? result = await Across(Fresh(41));
        return result.Value;
    }
    static void Main() {
        Begin(); int a = Locals(); long ba = End(); Console.WriteLine(a); Console.WriteLine(ba);
        Begin(); int b = Decimal(); long bb = End(); Console.WriteLine(b); Console.WriteLine(bb);
        Begin(); int c = Containers(); long bc = End(); Console.WriteLine(c); Console.WriteLine(bc);
        Begin(); int d = Async(); long bd = End(); Console.WriteLine(d); Console.WriteLine(bd);
    }
}
