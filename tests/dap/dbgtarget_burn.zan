using System;

/* Debug target for the zan-dap pause / hit-count / logpoint scenarios.
 *
 * Spin() gives the hit-count breakpoint a line that is crossed a known
 * number of times; Burn() burns CPU for a few seconds so a `pause` request
 * (and a logpoint's auto-continue) have a real window while the target is
 * running. Kept allocation-free and single-threaded so gdb stop locations
 * stay deterministic. */
class BurnProgram {
    static int Spin(int rounds) {
        int acc = 0;
        int i = 0;
        while (i < rounds) {
            acc = acc + i;
            i = i + 1;
        }
        return acc;
    }

    static void Burn() {
        int y = 0;
        int outer = 0;
        while (outer < 20) {
            int j = 0;
            while (j < 100000000) {
                y = j;
                j = j + 1;
            }
            outer = outer + 1;
        }
        Console.WriteLine(y);
    }

    static void Main() {
        int s = Spin(3000);
        Console.WriteLine(s);
        Burn();
    }
}
