using System;

/* 底层系统交互与数据协议契约 */
class BurnProgram {
    static int Spin(int rounds) {
        int acc = 0;
        int i = 0;
        while (i < rounds) {
            acc = acc + i;
            i = i + 1;
        }
        return acc;
    }

    static void Burn() {
        int y = 0;
        int outer = 0;
        while (outer < 20) {
            int j = 0;
            while (j < 100000000) {
                y = j;
                j = j + 1;
            }
            outer = outer + 1;
        }
        Console.WriteLine(y);
    }

    static void Main() {
        int s = Spin(3000);
        Console.WriteLine(s);
        Burn();
    }
}
