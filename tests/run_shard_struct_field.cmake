# Reuse publish execution/golden checks, but require extraction of the fixture.
if(NOT ZANC OR NOT SRC OR NOT EXPECTED OR NOT OUT_EXE OR NOT WORKDIR)
  message(FATAL_ERROR "run_shard_struct_field.cmake: ZANC, SRC, EXPECTED, OUT_EXE and WORKDIR are required")
endif()

file(MAKE_DIRECTORY "${WORKDIR}")
set(_shard_dump "${WORKDIR}/shard-struct-field.ll")
set(_manifest "${WORKDIR}/codegen-manifest.json")
set(COMPILE_OUT_FILE "${WORKDIR}/compile.stdout.log")
set(COMPILE_ERR_FILE "${WORKDIR}/compile.stderr.log")
file(REMOVE "${_shard_dump}" "${_manifest}" "${COMPILE_OUT_FILE}" "${COMPILE_ERR_FILE}")
set(ENV{ZAN_CODEGEN_MANIFEST_JSON} "${_manifest}")
set(ENV{ZAN_SHARD} 1)
set(ENV{ZAN_NO_SHARD} 0)
set(ENV{ZAN_SHARD_MAX_FN} 1)
set(ENV{ZAN_SHARD_MAX_INSN} 1)
set(ENV{ZAN_SHARD_DUMP} "${_shard_dump}")
include("${CMAKE_CURRENT_LIST_DIR}/run_arcnet.cmake")

if(NOT EXISTS "${_manifest}")
  message(FATAL_ERROR "missing codegen manifest; compile diagnostics saved under ${WORKDIR}")
endif()
file(READ "${_manifest}" _manifest_json)
foreach(_fn ShardFieldController_Score ShardFieldController_CatchScore)
  string(FIND "${_manifest_json}" "\"name\":\"${_fn}\"" _manifest_pos)
  if(_manifest_pos EQUAL -1)
    message(FATAL_ERROR "${_fn} missing from manifest; inspect ${COMPILE_OUT_FILE} and ${COMPILE_ERR_FILE}")
  endif()
endforeach()

if(NOT "${compile_out}${compile_err}" MATCHES "shard: [1-9][0-9]* objects emitted" OR
   "${compile_out}${compile_err}" MATCHES "falling back to single module")
  message(FATAL_ERROR "nested struct sharding was not exercised\n${compile_out}${compile_err}")
endif()
if(NOT EXISTS "${_shard_dump}")
  message(FATAL_ERROR "missing nested struct shard dump")
endif()
file(READ "${_shard_dump}" _shard_ir)
foreach(_type ShardFieldPoint ShardFieldPose ShardFieldController)
  if(NOT _shard_ir MATCHES "%struct\\.${_type} = type ")
    message(FATAL_ERROR "shard dump did not contain the ${_type} definition")
  endif()
endforeach()
if(NOT _shard_ir MATCHES "define[^\n]*@ShardFieldController_Score")
  message(FATAL_ERROR "shard dump did not contain the nested struct field reader")
endif()
if(NOT _shard_ir MATCHES "personality ptr @(__gxx_personality_seh0|__gxx_personality_v0|__gxx_wasm_personality_v0)")
  message(FATAL_ERROR "shard dump did not retain a function personality reference")
endif()
set(_personality "${CMAKE_MATCH_1}")
if(NOT _shard_ir MATCHES "declare i32 @${_personality}\\(")
  message(FATAL_ERROR "shard dump did not declare ${_personality}")
endif()
