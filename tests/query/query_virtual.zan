// S2（docs/ZAN_STANDARD.md §1）：zanc --query 的虚调用与方法组夹具（tests/test_query.py）。
// 接口调用连到实现、抽象方法调用连到 override、方法组当值用连 deferred 边（算能力不算抛出）。
using System;
using System.IO;
using System.Collections.Generic;

public interface IStore { string Load(string p); }
public class FileStore : IStore {
    public string Load(string p) { return File.ReadAllText(p); }
}
public abstract class Shape {
    public abstract int Area();
    public int Twice() { return Area() * 2; }
}
public class Bad : Shape {
    public override int Area() { throw new InvalidOperationException("no"); }
}
public class Ev {
    List<Action> hs = new List<Action>();
    public static Ev op_add(Ev self, Action h) { self.hs.Add(h); return self; }
}
public class Ui {
    public Ev Click = new Ev();
    public void Wire() { Click += OnClick; }
    void OnClick() { File.Delete("x"); }
}
public class Program {
    public static string Use(IStore s) { return s.Load("a"); }
    public static void Main() { Console.WriteLine(Use(new FileStore())); }
}
