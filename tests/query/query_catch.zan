// S2（docs/ZAN_STANDARD.md §1）：zanc --query 的 catch 扣除夹具（tests/test_query.py）。
// 具体类型 / 基类型 / 裸 catch 收住；rethrow 与 catch 体里新抛的照样逃出；
// lambda 体是委托被调用时才执行的代码，不算外层方法会抛；互递归各算各的 catch。
using System;
using System.IO;

public class Svc {
    public string Specific(string p) {
        try { return File.ReadAllText(p); } catch (FileNotFoundException e) { return ""; }
    }
    public string Base(string p) {
        try { return File.ReadAllText(p); } catch (IOException e) { return ""; }
    }
    public string All(string p) {
        try { Fail(); return File.ReadAllText(p); } catch { return ""; }
    }
    public string Rethrow(string p) {
        try { return File.ReadAllText(p); } catch (Exception e) { throw; }
    }
    public void InCatch() {
        try { Fail(); } catch (InvalidOperationException e) { throw new ArgumentException("x"); }
    }
    public Action Later() {
        Action a = null;
        try { a = () => { Fail(); }; } catch { }
        return a;
    }
    public void Fail() { throw new InvalidOperationException("boom"); }
    public void A(int n) { try { B(n); } catch (InvalidOperationException e) { } }
    public void B(int n) { if (n > 0) { A(n - 1); } throw new InvalidOperationException("b"); }
}
public class Program { public static void Main() { new Svc().Specific("x"); } }
