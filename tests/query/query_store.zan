// S2（docs/ZAN_STANDARD.md §1）：zanc --query 的契约夹具（tests/test_query.py）。
// Store.Load：直接抛 ArgumentException、经 Check() 可达 InvalidOperationException、
// 经 File.ReadAllText 用到 File 能力；lambda 捕获 this 与形参 path；Main 调两次。
using System;
using System.IO;
using System.Collections.Generic;

public class Store {
    List<string> lines = new List<string>();
    int loads = 0;
    public void Load(string path) {
        if (path == null) { throw new ArgumentException("path"); }
        string text = File.ReadAllText(path);
        Action count = () => { loads = loads + 1; Console.WriteLine(path); };
        count();
        lines.Add(text);
        Check();
    }
    void Check() { if (lines.Count > 100) { throw new InvalidOperationException("full"); } }
}

public class Program {
    public static void Main() {
        Store s = new Store();
        s.Load("q.zan");
        s.Load("q.zan");
    }
}
