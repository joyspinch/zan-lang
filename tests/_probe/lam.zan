using System;

class Person { string name; }
delegate void PersonRow(Person p, int y, bool sel);

class Program {
    static void Main() {
        Person a = new Person(); a.name = "Ann";
        PersonRow f = (p, y, sel) => {
            Console.WriteLine(p.name + " @" + y.ToString() + " sel=" + sel.ToString());
        };
        f(a, 7, true);
    }
}
