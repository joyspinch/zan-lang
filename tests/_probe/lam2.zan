using System;
class Person { string name; }
delegate void PersonRow(Person p, int y);

class Holder { PersonRow painter; }

class Program {
    static void Take(PersonRow f, Person a) { f(a, 3); }
    static void Main() {
        Person a = new Person(); a.name = "Ann";

        Console.WriteLine("-- 1 local var --");
        PersonRow f1 = (p, y) => { Console.WriteLine(p.name + " @" + y.ToString()); };
        f1(a, 1);

        Console.WriteLine("-- 2 field assign --");
        Holder h = new Holder();
        h.painter = (p, y) => { Console.WriteLine(p.name + " @" + y.ToString()); };
        h.painter(a, 2);

        Console.WriteLine("-- 3 argument --");
        Program.Take((p, y) => { Console.WriteLine(p.name + " @" + y.ToString()); }, a);
    }
}
