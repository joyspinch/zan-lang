using System;
class Person { string name; }
delegate void RowPaint<T>(T item, int y);

/* A: 泛型 delegate，但字段用具体实例化声明，宿主类非泛型 */
class HostA { RowPaint<Person> painter; }

/* B: 泛型 delegate，字段用 T 声明，宿主类泛型 */
class HostB<T> { RowPaint<T> painter; }

class Program {
    static void Main() {
        Person a = new Person(); a.name = "Ann";

        Console.WriteLine("-- A: RowPaint<Person> field on plain class --");
        HostA ha = new HostA();
        ha.painter = (p, y) => { Console.WriteLine(p.name + " @" + y.ToString()); };
        ha.painter(a, 1);

        Console.WriteLine("-- B: RowPaint<T> field on generic class --");
        HostB<Person> hb = new HostB<Person>();
        hb.painter = (p, y) => { Console.WriteLine(p.name + " @" + y.ToString()); };
        hb.painter(a, 2);
    }
}
