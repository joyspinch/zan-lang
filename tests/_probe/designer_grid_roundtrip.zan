using System;
using Gui;
using Gui.Widget;
using Gui.Designer;

/// Probe: the designer must not swallow declarative-grid keys it does not
/// model (of / columns / rowFactory / props) across a load -> save cycle.
class DesignerGridRoundtrip {
    static void Main() {
        string doc = "{ \"fields\": [ { \"kind\": \"DataGrid\", \"name\": \"Grid\"," +
            " \"of\": \"GridRow\", \"rowFactory\": true," +
            " \"props\": { \"striped\": \"true\" }," +
            " \"columns\": [ { \"field\": \"name\", \"title\": \"名称\"," +
            " \"width\": 220 } ] } ] }";
        Designer d = new Designer();
        List<FormField> fs = d.ParseComponentFields(doc);
        if (fs.Count != 1) {
            Console.WriteLine("FAIL parse: " + Convert.ToString(fs.Count));
            return;
        }
        JsonValue back = d.FieldJson(fs[0]);
        string s = back.ToJson();
        bool ok = true;
        if (back.Get("of") == null) { ok = false; Console.WriteLine("FAIL of lost"); }
        JsonValue cols = back.Get("columns");
        if (cols == null || !cols.IsArray() || cols.Count() != 1) {
            ok = false; Console.WriteLine("FAIL columns lost");
        } else {
            JsonValue c = cols.At(0);
            if (c.Str("field", "") != "name" || c.Int("width", 0) != 220) {
                ok = false; Console.WriteLine("FAIL column content: " + s);
            }
        }
        if (back.Get("rowFactory") == null) { ok = false; Console.WriteLine("FAIL rowFactory lost"); }
        if (back.Get("props") == null) { ok = false; Console.WriteLine("FAIL props lost"); }
        if (ok) { Console.WriteLine("ROUNDTRIP_OK"); }
    }
}
