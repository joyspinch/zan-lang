using System;
using System.IO;

class ProjExistsProbe {
    static void Check(string p) {
        Console.WriteLine("path=" + p);
        Console.WriteLine("  File.Exists=" + Convert.ToString(File.Exists(p)));
        Console.WriteLine("  Dir.FileExistsUtf8=" + Convert.ToString(Directory.FileExistsUtf8(p)));
    }

    static void Main() {
        ProjExistsProbe.Check("D:/project/素材大师-v5.4.10/WebServer/zan.proj");
        ProjExistsProbe.Check("D:\\project\\素材大师-v5.4.10\\WebServer\\zan.proj");
        ProjExistsProbe.Check("D:/project/zan-lang/zan.proj");
        Console.WriteLine("dir exists=" + Convert.ToString(
            Directory.ExistsUtf8("D:/project/素材大师-v5.4.10/WebServer")));
        List<string> names = Directory.GetFiles("D:/project/素材大师-v5.4.10/WebServer");
        Console.WriteLine("files count=" + Convert.ToString(names.Count));
        for (int i = 0; i < names.Count && i < 20; i = i + 1) {
            Console.WriteLine("  f: " + names[i]);
        }
        Console.WriteLine("PROBE_DONE");
    }
}
