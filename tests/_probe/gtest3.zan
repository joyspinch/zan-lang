using System;

class Person { string name; string desc; }
delegate void PersonRow(int x, int y, int w, int h, Person item, bool sel);
delegate void RowPaint<T>(int x, int y, int w, int h, T item, bool sel);

class PList {
    List<Person> items;
    PersonRow painter;
    void Init() { items = new List<Person>(); }
    void Add(Person p) { items.Add(p); }
    void Draw() {
        for (int i = 0; i < items.Count; i = i + 1) { painter(0, i * 40, 200, 40, items[i], i == 1); }
    }
}

class GList<T> {
    List<T> items;
    RowPaint<T> painter;
    void Init() { items = new List<T>(); }
    void Add(T x) { items.Add(x); }
    void Draw() {
        for (int i = 0; i < items.Count; i = i + 1) { painter(0, i * 40, 200, 40, items[i], i == 1); }
    }
}

class Program {
    static void Main() {
        Person a = new Person(); a.name = "Ann"; a.desc = "engineer";
        Person b = new Person(); b.name = "Bob"; b.desc = "designer";

        Console.WriteLine("-- concrete delegate, field assign, 6 params --");
        PList v = new PList(); v.Init(); v.Add(a); v.Add(b);
        v.painter = (x, y, w, h, p, sel) => {
            Console.WriteLine(p.name + " / " + p.desc + " @" + y.ToString() + " sel=" + sel.ToString());
        };
        v.Draw();

        Console.WriteLine("-- generic delegate, field assign, 6 params --");
        GList<Person> g = new GList<Person>(); g.Init(); g.Add(a); g.Add(b);
        g.painter = (x, y, w, h, p, sel) => {
            Console.WriteLine(p.name + " / " + p.desc + " @" + y.ToString() + " sel=" + sel.ToString());
        };
        g.Draw();
    }
}
