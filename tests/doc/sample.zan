using System;

namespace Sample.Docs;

/// <summary>A widget that does something.</summary>
class Widget {
    int size;

    /// <summary>Creates a widget of the given size.</summary>
    /// <returns>The new widget.</returns>
    static Widget Create(int size) {
        Widget w = new Widget();
        w.size = size;
        return w;
    }

    /// <summary>The current size.</summary>
    int Size() { return this.size; }

    void Grow(int by) { this.size = this.size + by; }
}

/// <summary>A point in the plane.</summary>
struct Point {
    int x;
    int y;

    /// <summary>Manhattan distance from the origin.</summary>
    int Norm() { return this.x + this.y; }
}

/// <summary>What a widget can be asked to do.</summary>
interface IDrawable {
    void Draw();
}
