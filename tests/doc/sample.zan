using System;

namespace Sample.Docs;

/// 核心契约与语义定义。
class Widget {
    int size;

    /// 核心契约与语义定义。
    /// 核心契约与语义定义。
    static Widget Create(int size) {
        Widget w = new Widget();
        w.size = size;
        return w;
    }

    /// 核心契约与语义定义。
    int Size() { return this.size; }

    void Grow(int by) { this.size = this.size + by; }
}

/// 核心契约与语义定义。
struct Point {
    int x;
    int y;

    /// 核心契约与语义定义。
    int Norm() { return this.x + this.y; }
}

/// 核心契约与语义定义。
interface IDrawable {
    void Draw();
}
