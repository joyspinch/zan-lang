using System;

namespace Sample.Docs;

/// <summary>A widget that does something.</summary>
class Widget {
    int size;

    /// <summary>Creates a widget of the given size.</summary>
    /// <returns>The new widget.</returns>
    static Widget Create(int size) {
        Widget w = new Widget();
        w.size = size;
        return w;
    }

    /// <summary>The current size.</summary>
    int Size() { return this.size; }

    void Grow(int by) { this.size = this.size + by; }
}

/// <summary>A point in the plane.</summary>
struct Point {
    int x;
    int y;

    /// <summary>Manhattan distance from the origin.</summary>
    int Norm() { return this.x + this.y; }
}

/// <summary>What a widget can be asked to do.</summary>
interface IDrawable {
    /// <summary>Renders the drawable.</summary>
    void Draw();
}

/// <summary>
/// 规则定义（多行 summary 块）。
/// </summary>
class Rule {
    // 字段带行内注释、且注释里含括号：这一行不得被当成方法。
    int week; // 1-5 (5 = 最后一周)
    int dayOfWeek; // 0-6 (0 = 星期日)

    // 带初始化的字段：初始化表达式里的括号不得让它变成方法。
    static Rule shared = Rule.Create();
    List<string> names = new List<string>();

    /// <summary>Creates an empty rule.</summary>
    static Rule Create() {
        Rule r = new Rule();
        if (r == null) { return null; }
        return r;
    }

    /// <summary>True when the rule has a name.</summary>
    bool HasName() { return this.names.Count > 0; }

    // 参数列表跨行的声明：累积到括号配平后按一个签名处理。
    static Rule Join(
        int seed,
        bool strict
    ) {
        return new Rule();
    }
}