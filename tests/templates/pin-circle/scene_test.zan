using System;
using Gui;
using Game.Foundation.Gui;
using PinCircle;

class SolvedPinScene : PinPlayScene {
    SolvedPinScene(PinWorld game, PinView view) : base(game, view) { }

    override void FixedStep(int dtMs) {
        if (this.game.level == 1 && this.game.state == RoundState.Playing
            && !this.game.paused && !this.game.flying && PinWorldTest.SafeShot(this.game)) {
            this.Fire();
        }
        base.FixedStep(dtMs);
    }
}

class PinSceneTest {
    static void Main() {
        PinWorld game = new PinWorld();
        PinView view = new PinView();
        SceneRouter router = SceneRouter.CreateFixed("Pin Circle scene regression", 600, 900, 16);
        router.Register("menu", new PinMenuScene(game, view));
        router.Register("play", new SolvedPinScene(game, view));
        router.Register("over", new PinOverScene(game, view));
        router.Run("play");
    }
}
