using System;

class PinWorldTest {
    static void Require(bool condition, string message) {
        if (!condition) {
            Console.WriteLine("FAIL: " + message);
            throw new Exception(message);
        }
    }

    // Full-state lookahead (phase clock, wobble, boss ring) lives in the model.
    static bool SafeShot(PinWorld source) { return source.SafeShot(); }

    #if !PIN_SCENE_TEST
    static void Main() { PinWorldTest.Run(); }
    #endif

    static void Run() {
        PinWorld g = new PinWorld();
        PinLevel first = PinLevels.Get(1);
        PinWorldTest.Require(g.level == 1 && g.target == first.phases[0].target
            && g.pins.Count == first.phases[0].presets.Count && g.PhaseCount() == 1, "first round setup");
        PinWorldTest.Require(g.Shoot() && !g.Shoot(), "one needle in flight");
        g.TogglePause();
        double radius = g.shotRadius;
        double rotation = g.rotation;
        int elapsed = g.elapsedMs;
        g.Step(1000);
        PinWorldTest.Require(g.shotRadius == radius && g.rotation == rotation && g.elapsedMs == elapsed,
            "pause freezes both wheel and shot");
        PinWorldTest.Require(!g.Shoot(), "paused round rejects shots");
        g.TogglePause();
        g.Step(192);
        PinWorldTest.Require(g.inserted == 1 && !g.flying && g.Remaining() == g.target - 1, "first pin attaches once");
        g.Step(16);
        PinWorldTest.Require(g.inserted == 1, "idle frames do not attach another pin");

        g.StartRound(1, 0);
        g.pins.Clear();
        g.pins.Add(new Pin(PinWorld.Down, true));
        PinWorldTest.Require(g.ShotCollides(PinWorld.PinRadius), "head to head collision");
        PinWorldTest.Require(g.ShotCollides(PinWorld.PinRadius + 70), "incoming shaft touches an existing head");
        PinWorldTest.Require(!g.ShotCollides(PinWorld.LaunchRadius), "launch position has clearance");
        g.pins.Clear();
        g.pins.Add(new Pin(PinWorld.Down + PinWorld.Tau - 0.03, true));
        PinWorldTest.Require(g.ShotCollides(PinWorld.PinRadius), "collision wraps at a full turn");
        g.pins.Clear();
        g.pins.Add(new Pin(PinWorld.Down + 0.2, true));
        PinWorldTest.Require(!g.ShotCollides(PinWorld.PinRadius), "nearby visible gap is safe");
        g.pins.Clear();
        g.pins.Add(new Pin(PinWorld.Down, true));
        g.Shoot();
        g.Step(1000);
        PinWorldTest.Require(g.state == RoundState.Failed && g.inserted == 0, "long step cannot tunnel through pins");
        int frozenTime = g.elapsedMs;
        PinWorldTest.Require(!g.Shoot(), "failed round rejects shots");
        g.Step(1000);
        PinWorldTest.Require(g.elapsedMs == frozenTime && g.pulseMs == 0, "failed wheel freezes but feedback ends");

        // Rotor mechanics by level.
        g.StartRound(4, 0);
        double speed = g.AngularSpeed();
        g.Step(1000);
        PinWorldTest.Require(Math.Abs(speed - g.AngularSpeed()) > 0.1, "speed-changing rounds");
        g.StartRound(7, 0);
        speed = g.AngularSpeed();
        g.Step(4000);
        PinWorldTest.Require(speed * g.AngularSpeed() < 0, "sudden-reversal rounds change direction");
        g.StartRound(7, 0);
        bool warned = false;
        for (int i = 0; i < 200 && !warned; i = i + 1) { g.Step(16); warned = g.FlipWarning(); }
        PinWorldTest.Require(warned && g.NextFlipIn() > 0 && g.NextFlipIn() <= PinWorld.FlipWarnMs,
            "reversals are telegraphed before they happen");
        g.StartRound(2, 0);
        PinWorldTest.Require(g.AngularSpeed() < 0, "level 2 starts counterclockwise");
        g.StartRound(24, 0);
        double maxSway = 0;
        for (int i = 0; i < 200; i = i + 1) { g.Step(16); maxSway = Math.Max(maxSway, Math.Abs(g.wobble)); }
        PinWorldTest.Require(maxSway > 10 && maxSway <= g.Phase().wobblePx + 0.0001, "wobbling rotor sways within range");

        PinWorld batch = new PinWorld();
        PinWorld small = new PinWorld();
        batch.StartRound(28, 87);
        small.StartRound(28, 87);
        batch.Shoot();
        small.Shoot();
        batch.Step(160);
        for (int i = 0; i < 10; i = i + 1) { small.Step(16); }
        PinWorldTest.Require(Math.Abs(batch.rotation - small.rotation) < 0.000001
            && batch.shotRadius == small.shotRadius && batch.state == small.state
            && Math.Abs(batch.wobble - small.wobble) < 0.000001,
            "fixed substeps are independent of caller chunking");

        // Boss rings: clearing a ring re-arms the rotor and blocks fire for the interlude.
        int bosses = 0;
        for (int level = 10; level <= PinLevels.Count; level = level + 10) {
            PinLevel spec = PinLevels.Get(level);
            PinWorldTest.Require(spec.Boss() && spec.phases.Count >= 2, "boss level " + level + " has several rings");
            g.StartRound(level, 0);
            int ringsSeen = 1;
            bool interludeChecked = false;
            for (int tick = 0; tick < 12000 && g.state == RoundState.Playing; tick = tick + 1) {
                int phase = g.phase;
                if (!g.flying && g.SafeShot()) { g.Shoot(); }
                g.Step(16);
                if (g.phase != phase) {
                    ringsSeen = ringsSeen + 1;
                    PinWorldTest.Require(g.inserted == 0 && g.pins.Count == g.Phase().presets.Count
                        && !g.Armed() && !g.Shoot(), "ring change re-arms the rotor with fire held");
                    interludeChecked = true;
                }
            }
            PinWorldTest.Require(g.state == RoundState.Cleared && ringsSeen == spec.phases.Count && interludeChecked
                && g.totalInserted == spec.TotalPins(), "boss level " + level + " clears every ring");
            bosses = bosses + 1;
        }

        // Every level is solvable by a correct player from several start angles.
        int solved = 0;
        for (int level = 1; level <= PinLevels.Count; level = level + 1) {
            for (int seed = 0; seed < 4; seed = seed + 1) {
                g.StartRound(level, seed * 83);
                for (int tick = 0; tick < 12000 && g.state == RoundState.Playing; tick = tick + 1) {
                    if (!g.flying && g.SafeShot()) { g.Shoot(); }
                    g.Step(16);
                    PinWorldTest.Require(g.inserted >= 0 && g.inserted <= g.target, "insertion bounds");
                    for (int i = 0; i < g.pins.Count; i = i + 1) {
                        double a = PinWorld.Wrap(g.pins[i].angle + g.rotation);
                        PinWorldTest.Require(a >= 0 && a < PinWorld.Tau, "wrapped angular coordinates");
                    }
                }
                PinWorldTest.Require(g.state == RoundState.Cleared,
                    "round solvability: level=" + level + " seed=" + seed + " inserted=" + g.inserted
                    + " elapsed=" + g.elapsedMs + " state=" + (int)g.state);
                PinWorldTest.Require(g.Remaining() == 0 && !g.flying && !g.Shoot(), "cleared round is terminal");
                int cleared = g.clearedRounds;
                g.Step(1000);
                PinWorldTest.Require(g.clearedRounds == cleared, "completion is counted once");
                solved = solved + 1;
            }
        }

        int wins = 0;
        int losses = 0;
        for (int level = 1; level <= 10; level = level + 1) {
            for (int seed = 0; seed < 12; seed = seed + 1) {
                g.StartRound(level, seed * 29);
                int rhythm = 16 + seed * 8;
                for (int tick = 0; tick < 8000 && g.state == RoundState.Playing; tick = tick + 1) {
                    if (tick % rhythm == 0) { g.Shoot(); }
                    g.Step(16);
                }
                PinWorldTest.Require(g.state != RoundState.Playing, "repeated-click games terminate");
                if (g.state == RoundState.Cleared) { wins = wins + 1; } else { losses = losses + 1; }
            }
        }
        PinWorldTest.Require(wins > 0 && losses > 0, "medium players exercise both outcomes");

        g.StartRound(99, 0);
        PinLevel last = PinLevels.Get(PinLevels.Count);
        PinWorldTest.Require(g.level == PinLevels.Count && g.target == last.phases[0].target
            && g.pins.Count == last.phases[0].presets.Count && g.phase == 0 && g.flying == false,
            "late levels clamp to the last level and restart resets flight");
        g.StartRound(-3, 0);
        PinWorldTest.Require(g.level == 1, "levels below 1 clamp to the first level");
        Console.WriteLine("PASS pin-circle: boundaries, pause, substeps, mechanics, " + bosses + " boss levels, "
            + solved + " solved rounds, 120 rhythmic players (wins=" + wins + ", losses=" + losses + ")");
    }
}
