wait 6500
assert probe pin.scene equals over
assert probe pin.state equals 1
assert probe pin.level equals 1
assert probe pin.inserted equals 5
dump pixels cleared.zpx
click 300 680
wait 250
assert probe pin.scene equals menu
click 300 752
wait 250
assert probe pin.scene equals play
assert probe pin.state equals 0
assert probe pin.level equals 1
assert probe pin.paused equals 0
wait 6500
assert probe pin.scene equals over
assert probe pin.state equals 1
assert probe pin.level equals 1
assert probe pin.inserted equals 5
click 300 566
wait 250
assert probe pin.scene equals play
assert probe pin.level equals 2
assert probe pin.inserted equals 0
keydown 80
keyup 80
wait 350
assert probe pin.paused equals 1
dump pixels next-level.zpx
click 300 680
wait 250
assert probe pin.scene equals menu
quit
