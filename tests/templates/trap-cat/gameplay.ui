wait 1800
assert probe trap.moves equals 0
assert probe trap.cat equals 40
assert probe trap.level equals 1
assert probe trap.result equals playing
dump tree initial-tree.json
dump pixels initial.zpx
dump probe trap.cat.pose pose-0.txt
dump probe trap.cat.sprite sprite-size.txt
wait 200
dump pixels dance.zpx
dump probe trap.cat.pose pose-1.txt
assert probe trap.cat.moving equals false
assert probe trap.moves equals 0
clickid @Cell39
wait 80
assert probe trap.cat.moving equals true
dump pixels hop.zpx
assert probe trap.moves equals 1
clickid @Cell40
wait 300
assert probe trap.cat.moving equals false
assert probe trap.moves equals 2
clickid @Undo
wait 300
assert probe trap.moves equals 1
clickid @Undo
wait 300
assert probe trap.moves equals 0
assert probe trap.cat equals 40
clickid @Level2
wait 300
assert probe trap.level equals 2
assert probe trap.moves equals 0
clickid @Cell39
wait 300
assert probe trap.moves equals 1
clickid @NewRound
wait 300
assert probe trap.moves equals 0
assert probe trap.cat equals 40
clickid @Level0
wait 300
assert probe trap.level equals 0
dump pixels easy.zpx
dump tree easy-tree.json
quit
