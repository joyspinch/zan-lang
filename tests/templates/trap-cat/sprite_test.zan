using System;
using System.IO;
using Gui;

class TrapCatSpriteTest {
    static void Require(bool ok, string message) {
        if (!ok) { throw new Exception(message); }
    }

    static void Main() {
        string outDir = Environment.GetEnvironmentVariable("ZAN_TRAP_CAT_ART_OUT");
        if (outDir != "") { Directory.CreateDirectory(outDir); }
        Canvas canvas = new Canvas(320, 360);
        for (int mood = 0; mood < 4; mood++) {
            long previousHash = 0;
            int different = 0;
            for (int frame = 0; frame < 32; frame++) {
                string svg = TrapCatSprite.PoseSvg(frame * TrapCatSprite.PoseCount / 32, mood);
                string key = "mem:cat-test-" + mood + "-" + frame;
                int loaded = Canvas.ImageLoadSvg(key, svg, 256, 288);
                TrapCatSpriteTest.Require(loaded > 0, "SVG pose failed to load");
                TrapCatSpriteTest.Require(Canvas.ImageWidth(key) == 256 && Canvas.ImageHeight(key) == 288, "SVG pose raster dimensions changed");
                canvas.Clear(0xfff1f6ed);
                canvas.BlitImage(key, 32, 36, 256, 288, 0, 0, 0, 0);
                int count = 0;
                long hash = 0;
                for (int y = 36; y < 324; y += 3) {
                    for (int x = 32; x < 288; x += 3) {
                        int pixel = canvas.GetPixel(x, y);
                        if (pixel != 0xfff1f6ed) { count++; }
                        hash = (hash * 31 + (pixel & 0xffffff)) % 100000007;
                    }
                }
                TrapCatSpriteTest.Require(count > 800, "SVG pose contains too little artwork");
                if (frame > 0 && hash != previousHash) { different++; }
                previousHash = hash;
                if (outDir != "") {
                    TrapCatSpriteTest.Require(canvas.DumpRaw(outDir + "/cat-" + mood + "-" + frame + ".bmp", 0, 0, 320, 360) == 1, "Could not export SVG pose");
                }
                Canvas.EvictImage(key);
            }
            TrapCatSpriteTest.Require(different > 8, "SVG animation poses did not change");
        }
        canvas.Destroy();
        Console.WriteLine("PASS 128 SVG poses across dance, hop, trapped and escaped states");
    }
}
