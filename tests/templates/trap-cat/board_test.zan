using System;

class TrapCatBoardTest {
    static void Require(bool condition, string message) {
        if (!condition) { throw new Exception("FAIL: " + message); }
    }

    static TrapCatBoard EmptyBoard(long seed) {
        TrapCatBoard board = new TrapCatBoard();
        board.NewRound(1, seed);
        for (int i = 0; i < TrapCatBoard.Count; i++) { board.blocked[i] = false; }
        board.FindRoutes();
        return board;
    }

    static void Main() {
        for (int cell = 0; cell < TrapCatBoard.Count; cell++) {
            for (int dir = 0; dir < 6; dir++) {
                int next = TrapCatBoard.Neighbor(cell, dir);
                if (next >= 0) {
                    bool reverse = false;
                    for (int back = 0; back < 6; back++) {
                        if (TrapCatBoard.Neighbor(next, back) == cell) { reverse = true; }
                    }
                    TrapCatBoardTest.Require(reverse, "hex adjacency must be symmetric");
                }
            }
        }
        TrapCatBoard empty = TrapCatBoardTest.EmptyBoard(23);
        TrapCatBoardTest.Require(empty.distance[empty.cat] == 4, "center is four steps from an empty edge");
        TrapCatBoardTest.Require(!empty.Block(-1) && !empty.Block(81) && !empty.Block(empty.cat), "invalid clicks do not consume a turn");
        TrapCatBoardTest.Require(empty.moves == 0, "invalid click move count");
        empty.Block(10);
        int movedCat = empty.cat;
        TrapCatBoardTest.Require(empty.moves == 1 && empty.cat != TrapCatBoard.Center, "one block moves the cat once");
        TrapCatBoardTest.Require(!empty.Block(10), "already blocked cell is rejected");
        TrapCatBoardTest.Require(empty.Undo() && !empty.blocked[10] && empty.cat == TrapCatBoard.Center, "undo restores both participants");
        empty.Block(10);
        TrapCatBoardTest.Require(empty.cat == movedCat, "undo and replay preserve tie breaking");

        TrapCatBoard trapped = TrapCatBoardTest.EmptyBoard(71);
        for (int dir = 0; dir < 5; dir++) { trapped.blocked[TrapCatBoard.Neighbor(trapped.cat, dir)] = true; }
        int last = TrapCatBoard.Neighbor(trapped.cat, 5);
        trapped.Block(last);
        TrapCatBoardTest.Require(trapped.result == TrapCatResult.Trapped && trapped.cat == TrapCatBoard.Center, "closing the last exit wins without moving the cat");
        TrapCatBoardTest.Require(!trapped.Block(1), "finished board rejects input");
        trapped.Undo();
        TrapCatBoardTest.Require(trapped.result == TrapCatResult.Playing && !trapped.blocked[last], "undo also reopens a finished round");

        TrapCatBoard island = TrapCatBoardTest.EmptyBoard(101);
        for (int cell = 0; cell < TrapCatBoard.Count; cell++) {
            int row = cell / 9;
            int col = cell % 9;
            if (row == 2 || row == 6 || col == 2 || col == 6) { island.blocked[cell] = true; }
        }
        island.Block(0);
        TrapCatBoardTest.Require(island.result == TrapCatResult.Trapped, "a closed region wins even when local neighbors remain open");

        TrapCatBoard escaped = TrapCatBoardTest.EmptyBoard(17);
        escaped.cat = 10;
        escaped.Block(80);
        TrapCatBoardTest.Require(escaped.result == TrapCatResult.Escaped && TrapCatBoard.IsEdge(escaped.cat), "reaching the edge loses immediately");

        int rounds = 0;
        int wins = 0;
        int losses = 0;
        for (int level = 0; level < 3; level++) {
            for (int seed = 1; seed <= 100; seed++) {
                TrapCatBoard board = new TrapCatBoard();
                board.NewRound(level, seed);
                int blockedCount = 0;
                for (int cell = 0; cell < TrapCatBoard.Count; cell++) {
                    if (board.blocked[cell]) { blockedCount++; }
                }
                TrapCatBoardTest.Require(blockedCount == TrapCatBoard.InitialBlocks(level), "initial obstacle count");
                TrapCatBoardTest.Require(board.distance[board.cat] > 0 && !board.blocked[board.cat], "every random round starts with an escape path");
                Random player = Random.Seeded(seed * 65537 + level);
                while (board.result == TrapCatResult.Playing) {
                    int target = -1;
                    int shortest = 1000;
                    for (int dir = 0; dir < 6; dir++) {
                        int next = TrapCatBoard.Neighbor(board.cat, dir);
                        if (next >= 0 && !board.blocked[next] && board.distance[next] >= 0 && board.distance[next] < shortest) {
                            shortest = board.distance[next];
                            target = next;
                        }
                    }
                    if (target < 0 || player.NextBelow(3) == 0) {
                        do { target = player.NextBelow(TrapCatBoard.Count); } while (board.blocked[target] || target == board.cat);
                    }
                    int oldCat = board.cat;
                    int oldMoves = board.moves;
                    TrapCatBoardTest.Require(board.Block(target), "simulated legal click is accepted");
                    TrapCatBoardTest.Require(board.moves == oldMoves + 1 && !board.blocked[board.cat], "move and occupancy invariants");
                    if (board.result != TrapCatResult.Trapped) {
                        bool adjacent = false;
                        for (int dir = 0; dir < 6; dir++) {
                            if (TrapCatBoard.Neighbor(oldCat, dir) == board.cat) { adjacent = true; }
                        }
                        TrapCatBoardTest.Require(adjacent && board.distance[board.cat] == board.distance[oldCat] - 1, "cat follows a shortest legal path");
                    }
                    TrapCatBoardTest.Require(board.moves < TrapCatBoard.Count, "rounds terminate");
                }
                rounds++;
                if (board.result == TrapCatResult.Trapped) { wins++; } else { losses++; }
            }
        }
        TrapCatBoardTest.Require(wins > 0 && losses > 0, "simulation exercises both outcomes");
        Console.WriteLine("PASS trap-cat rules, undo, adjacency and " + rounds + " seeded rounds; wins=" + wins + " losses=" + losses);
    }
}
