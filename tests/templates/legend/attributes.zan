using System;
using System.IO;
using Legend;

class LegendAttributeTests {
    static int checks;
    static void Check(bool ok, string message) { checks = checks + 1; if (!ok) { Console.WriteLine("FAIL ON: " + message); throw new Exception("FAIL: " + message); } }
    static Equipment Item(Game g, int id) { Equipment e = g.CreateItem(id, 0, 1); e.coefficient = 1; return e; }
    static void Main() {
        string dir = KnownFolders.GetEnv("LEGEND_DATA_DIR"); if (dir == "") { dir = "templates/game/legend/data"; }
        if (KnownFolders.GetEnv("LEGEND_VALIDATE_ONLY") == "1") {
            try { GameTables.Initialize(dir); } catch (Exception ex) { Console.WriteLine("Configuration rejected"); throw ex; }
            return;
        }
        Console.WriteLine("Step 1");
        GameTables.Initialize(dir); GameTables t = GameTables.current;
        Console.WriteLine("Step 2: items=" + Rules.N(t.items.rows.Count));
        Check(t.items.rows.Count == 732, "all source items"); Check(t.attributes.rows.Count == 12, "twelve independent attributes");
        Game g = new Game(); g.Choose(0); g.equipped[0] = null;
        int attack = g.Stat("attack_max"); int health = g.MaxHp(); int armor = g.Defense();
        Equipment sword = Item(g, 16); g.equipped[0] = sword;
        Check(sword.Stat("attack_min") == 2 && sword.Stat("attack_max") == 5, "wood sword source 2-5");
        Check(g.Stat("attack_max") == attack + 5, "equipped physical stat");
        Check(g.MaxHp() == health && g.Defense() == armor, "weapon score must not create HP/defense");
        Check(sword.Stat("magic_max") == 0 && sword.Stat("tao_max") == 0, "no invented magic/tao");
        Equipment cloth = Item(g, 14); g.equipped[1] = cloth;
        Check(cloth.Stat("defense_max") == 2 && cloth.Stat("magic_defense_max") == 1, "cloth separate defenses");
        Check(g.Defense() == armor + 2 && g.MaxHp() == health, "armor not converted into health");
        Check(t.items.At(224).Int("hp") == 0 && t.items.At(224).Int("mp") == 0, "gold bar payload is not HP/MP");
        Check(t.items.At(316).Int("hp") == 50 && t.items.At(316).Int("mp") == 25, "equipment HP MP retained");
        Equipment robe = Item(g, 26);
        Check(!robe.CanWear(0, 30, 0) && robe.CanWear(1, 30, 0), "class restriction");
        Check(!robe.CanWear(1, 1, 0), "level restriction");
        Equipment ascended = Item(g, 248); Check(!ascended.CanWear(0, 1500, 0), "rebirth restriction");
        g.bag.Add(robe); int before = g.bag.Count; g.Wear(before - 1);
        Check(g.bag.Count == before && g.equipped[1] == cloth, "invalid wear is atomic");
        DataRow definition = t.items.At(16); definition.fields["attack_max"] = "105";
        Check(g.Stat("attack_max") == attack + 105, "editable item stat drives aggregation");
        definition.fields["hp"] = "40"; definition.fields["mp"] = "20";
        Check(g.MaxHp() == health + 40 && g.MaxMp() == t.jobs.At(0).Int("mp_base") + g.level * t.jobs.At(0).Int("mp_level") + 20, "independent HP MP aggregation");
        sword.upgrade = 1; Check(sword.Stat("attack_max") == 110, "per-stat upgrade percentage");
        t.attributes.Get("attack_max").fields["upgrade_pct"] = "20";
        Check(sword.Stat("attack_max") == 126, "editable upgrade rule");
        t.attributes.Get("attack_max").fields["upgrade_pct"] = "5"; sword.upgrade = 0;
        sword.tier = 1; Check(sword.Stat("attack_max") == 131, "quality scaling");
        sword.coefficient = 2; Check(sword.Stat("attack_max") == 262 && sword.Stat("defense_max") == 0, "coefficient is per actual attribute");
        sword.tier = 0; sword.coefficient = 1;
        definition.fields["attack_max"] = "5"; definition.fields["hp"] = "0"; definition.fields["mp"] = "0";
        // 核心契约与语义定义。
        DataRow monster = g.EnemyData();
        monster.fields["defense_min"] = "100000"; monster.fields["defense_max"] = "100000";
        monster.fields["magic_defense_min"] = "0"; monster.fields["magic_defense_max"] = "0";
        Check(g.Strike("attack", 100) == 1, "physical defense mitigates physical strike");
        Check(g.Strike("magic", 100) > 1, "physical defense does not mitigate magic");
        monster.fields["magic_defense_min"] = "100000"; monster.fields["magic_defense_max"] = "100000";
        Check(g.Strike("magic", 100) == 1 && g.Strike("tao", 100) == 1, "magic defense mitigates magic and tao");
        for (int i = 0; i < 50; i = i + 1) { int n = g.RollRange(5, 10); Check(n >= 5 && n <= 10, "range roll bounded"); }
        Check(g.RollRange(9, 2) == 9, "minimum-only item contributions cannot invert final roll");
        Check(sword.Detail().Contains("攻击加成") && sword.Detail().Contains("魔防") && sword.Detail().Contains("全职业"), "full equipment detail");
        GameTables.Initialize(dir); t = GameTables.current;
        g = new Game(); g.Choose(0); g.bag.Clear(); sword = Item(g, 16); g.equipped[0] = sword; sword.locked = true;
        g.savedAt = 1000; g.enemyHp = g.enemyMax / 2; g.round = 7;
        string saved = SaveStore.Encode(g).ToJson();
        // 核心契约与语义定义。
        DataRow first = t.items.rows[0]; t.items.rows.RemoveAt(0); t.items.rows.Add(first);
        Game restored = SaveStore.Decode(saved);
        Check(restored.equipped[0].definitionId == 16 && restored.equipped[0].locked, "stable-ID save roundtrip");
        Check(restored.Stat("attack_max") == g.Stat("attack_max") && restored.round == 7, "attributes and fight progress survive save");
        int oldMax = g.enemyMax; g.EnemyData().fields["hp"] = Rules.N(oldMax * 2);
        restored = SaveStore.Decode(saved);
        Check(restored.enemyMax == oldMax * 2 && restored.enemyHp == oldMax, "save re-resolves current monster stats with HP ratio");
        g.gold = 0; g.iron = 0; g.Forge(0, 0); Check(sword.upgrade == 0 && g.gold == 0, "failed forge no mutation");
        g.gold = 10000; g.iron = 100; g.Forge(0, 0); Check(sword.upgrade == 1 && g.gold == 9920 && g.iron == 97, "forge configured resource transaction");
        GameTables.Initialize(dir);
        for (int job = 0; job < 3; job = job + 1) {
            Game play = new Game(); play.Choose(job); play.Advance(3600, 100000);
            Check(play.kills > 0 && play.level > 1, "all jobs can progress in one-hour simulation");
            Check(play.hp >= 0 && play.hp <= play.MaxHp() && play.mp >= 0 && play.mp <= play.MaxMp(), "combat resource bounds");
            Console.WriteLine("job=" + Rules.N(job) + " level=" + Rules.N(play.level) + " floor=" + Rules.N(play.best) + " kills=" + Rules.N(play.kills));
        }
        Console.WriteLine("PASS legend attributes checks=" + Rules.N(checks));
    }
}
