using System;
using System.Json;
using Legend;
class LegendSystemTests {
    static int checks;
    static void Check(bool ok, string message) { checks = checks + 1; if (!ok) { throw new Exception("FAIL " + message); } }
    static void Main() {
        GameTables.Initialize("templates/game/legend/data"); Game g = new Game(); g.Choose(0);
        Check(g.SkillAtSlot(0).Text("kind") == "active" && g.SkillAtSlot(1).Text("kind") == "passive" && g.SkillRank(0) == 1, "eight-slot skill loadout initializes by job");
        int skillGold = g.gold; int skillIron = g.iron; g.TrainSkill(1);
        Check(g.SkillRank(1) == 2 && g.gold == skillGold - 100 && g.iron == skillIron - 2, "passive skill trains with configured costs");
        g.ToggleSkill(1); Check(!g.IsSkillEquipped(1), "skill can be unequipped"); g.ToggleSkill(1); Check(g.IsSkillEquipped(1), "skill can be re-equipped");
        Equipment forgeItem = g.CreateItem(16, 1, 1); g.equipped[0] = forgeItem; g.gold = 10000; g.iron = 100; g.runes = 100;
        string forgePreview = g.ForgePreview(0, 0); Check(forgePreview.Contains("费用：金币 80") && forgePreview.Contains("成功率：100%"), "forge preview exposes scaled cost and success rate");
        g.Forge(0, 0); Check(forgeItem.upgrade == 1 && g.gold == 9920 && g.iron == 97, "forge success consumes configured resources and mutates once");
        g.gold = 10000; g.iron = 100; g.runes = 0; int beforeUpgrade = forgeItem.upgrade; g.Forge(0, 3);
        Check(forgeItem.upgrade == beforeUpgrade && g.gold == 10000 && g.iron == 100, "forge rune shortage is atomic across all currencies");
        Check(GameTables.current.forge.At(1).Int("success_pct") == 70 && GameTables.current.forge.At(1).Text("failure") == "downgrade", "gold reroll declares probabilistic downgrade failure");
        g.AddRune(1, 3); Check(g.RuneCount(1) == 3, "rune inventory accepts levelled rune counts");
        Check(g.SynthesizeRune(1) && g.RuneCount(1) == 0 && g.RuneCount(2) == 1, "three same runes synthesize into the next level");
        int runeIron = g.iron; g.iron = 0; Check(!g.DowngradeRune(2) && g.RuneCount(2) == 1 && g.iron == 0, "rune downgrade shortage is atomic");
        g.iron = 10; Check(g.DowngradeRune(2) && g.RuneCount(2) == 0 && g.RuneCount(1) == 1 && g.iron == 0, "rune downgrade consumes one rune and ten iron");
        g.AddRune(14, 2); Check(!g.SynthesizeRune(14) && g.RuneCount(14) == 2, "highest rune cannot synthesize past 14#");
        g.gems = 100; int shopRune1 = g.RuneCount(1); g.Shop(5); Check(g.RuneCount(1) == shopRune1 + 1 && g.gems == 0, "shop sells a documented 1# rune for yuan");
        g.gems = 2000; int shopRune10 = g.RuneCount(10); g.Shop(6); Check(g.RuneCount(10) == shopRune10 + 1 && g.gems == 0, "shop sells a documented 10# rune for yuan");
        g.gems = 0; int noBuyRune = g.RuneCount(1); g.Shop(5); Check(g.RuneCount(1) == noBuyRune, "rune shop purchase is atomic when yuan is insufficient");
        g.gems = 200; int oreBefore = g.legendOre; g.Shop(7); Check(g.legendOre == oreBefore + 100 && g.gems == 0, "shop sells legendary ore for yuan");
        g.gems = 300; int ballBefore = g.DragonBallCount(1); g.Shop(8); Check(g.DragonBallCount(1) == ballBefore + 10 && g.gems == 0, "shop sells dragon balls for yuan");
        g.gems = 20000; int thirteenthBefore = g.RuneCount(13); g.Shop(17); Check(g.RuneCount(13) == thirteenthBefore + 1 && g.gems == 0, "shop sells 13# runes for rune words");
        int floor = g.floor; g.active = false; int wave = g.wave; int tries = g.bossTries;
        g.level = 1; g.Challenge(1, 0); Check(g.mode == 0 && g.bossTries == tries, "boss level gate atomic");
        g.level = 80; g.Challenge(1, -1); Check(g.bossTries == tries, "invalid boss does not consume tries");
        g.Challenge(1, 0); Check(g.mode == 1 && g.bossTries == tries - 1 && g.challenge == 1, "boss has distinct mode and configured identity");
        g.Challenge(4, 0); Check(g.mode == 1 && g.bossTries == tries - 1, "cannot replace current challenge");
        g.Victory(); Check(g.mode == 0 && !g.active && g.bossWins == 1 && g.floor == floor && g.wave == wave, "boss restores paused field without advancing illusion");
        g.bossAutoNext = true; tries = g.bossTries; g.Challenge(1, 0); g.Victory();
        Check(g.mode == 1 && g.challenge == 2 && g.bossTries == tries - 2, "auto next consumes one attempt per boss");
        g.LeaveChallenge(); Check(g.mode == 0 && !g.active && g.bossTries == tries - 2, "withdrawal no refund and original pause restored");
        g.bossAutoNext = false; g.bossTries = 0; g.Challenge(1,0); Check(g.mode == 0, "boss daily limit");
        g.rebirth = 0; g.Challenge(4,0); Check(g.mode == 0, "secret rebirth gate");
        g.rebirth = 1; g.Challenge(4,0); Check(g.mode == 4 && g.secretFloor == 1 && g.floor == floor, "secret independent entry");
        for (int i = 0; i < g.B("secret_wave_count"); i = i + 1) { g.Victory(); }
        Check(g.mode == 4 && g.secretWave == g.B("secret_wave_count") && g.secrets == 0, "secret mobs precede guardian");
        g.Victory(); Check(g.mode == 4 && g.secretFloor == 2 && g.secretWave == 0 && g.secrets == 1 && g.floor == floor, "secret guardian advances only secret floor");
        g.secretAutoPush = false;
        for (int i = 0; i <= g.B("secret_wave_count"); i = i + 1) { g.Victory(); }
        Check(g.secretFloor == 2 && g.secrets == 2 && g.mode == 4, "secret repeat floor toggle independent");
        g.LeaveChallenge(); Check(g.mode == 0 && !g.active && g.secretFloor == 2 && g.floor == floor, "secret exit preserves both progress tracks");
        g.Challenge(4,0); Check(g.secretFloor == 2 && g.mode == 4, "secret resume");
        g.hp = 1; g.autoPotion = false; g.round = g.B("round_limit"); g.Step(1700000000);
        Check(g.mode == 4 && g.recovery > 0 && g.floor == floor, "secret defeat does not turn into illusion");
        g.LeaveChallenge(); Check(g.mode == 4, "withdrawal cannot skip recovery");
        g.Advance(g.B("recovery_seconds"),1700000010); g.LeaveChallenge();
        Check(g.mode == 0 && !g.active, "revive then exit restores pause");
        g.Challenge(4,0); g.secretAutoPush = true; g.secretFloor = GameTables.current.encounters.At(4).Int("max_progress"); g.secretWave = g.B("secret_wave_count"); g.Victory();
        Check(g.mode == 4 && !g.active && g.secretFloor == g.secrets, "secret cap stays in secret"); g.LeaveChallenge();
        g.elementTraining = true; int kills = g.kills; g.Advance(60,1700000100);
        Check(g.elementPool == 60 * g.B("element_xp_per_second") && g.elementSeconds == 60 && g.kills == kills, "training independent of paused battle and offline capable");
        int before = g.Stat("attack_max"); int pool = g.elementPool; g.UpgradeElement(0);
        Check(g.elementRanks[0] == 0 && g.elementPool == pool, "upgrade requires injected xp");
        g.InjectElement(0); Check(g.elementPool == 0 && g.elementXp[0] == 60 && g.elementRanks[0] == 0, "inject transfers not upgrades");
        int ironBeforeElement = g.iron; g.UpgradeElement(0); Check(g.elementRanks[0] == 1 && g.elementXp[0] == 0 && g.iron == ironBeforeElement - 2 && g.Stat("attack_max") == before + 2, "element rank changes stat and consumes configured material");
        int rankBeforeShortage = g.elementRanks[1]; int xpBeforeShortage = g.elementXp[1]; g.elementXp[1] = g.ElementNeed(1); g.iron = 0; g.gems = 0; g.UpgradeElement(1); Check(g.elementRanks[1] == rankBeforeShortage && g.elementXp[1] == xpBeforeShortage + 60 && g.iron == 0 && g.gems == 0, "element breakthrough shortage is atomic");
        Check(g.ElementNeed(0) == 90 && g.elementRanks[1] == 0, "independent levels and configured scaling");
        g.elementPool = g.B("element_pool_cap") - 1; g.Advance(3,1700000110);
        Check(g.elementPool == g.B("element_pool_cap") && g.elementSeconds == 61, "training cap no overflow/time inflation");
        g.elementTraining = false; g.Step(1700000111); Check(g.elementSeconds == 61, "training stop");
        g.InjectElement(-1); g.UpgradeElement(5); Check(g.elementRanks[0] == 1, "invalid element safe");
        g.elementRanks[4] = 100; pool = g.elementPool; g.InjectElement(4); g.UpgradeElement(4);
        Check(g.elementPool == pool && g.elementRanks[4] == 100, "element max does not spend xp");
        int dragon = -1;
        foreach (DataRow item in GameTables.current.items.rows) { if (item.Text("name") == "屠龙") { dragon = item.Int("id"); } }
        Check(dragon >= 0, "reference named equipment exists");
        g.filter = 1; g.filterCoefficient = 4; g.filterMinLevel = 20; g.filterJobOnly = true;
        Equipment filtered = g.CreateItem(dragon, 1, 40); filtered.coefficient = 4;
        Check(g.KeepDrop(filtered), "pickup filters keep matching universal equipment");
        filtered.coefficient = 3; Check(!g.KeepDrop(filtered), "pickup coefficient filter rejects weak equipment");
        filtered.coefficient = 4; filtered.level = 10; Check(!g.KeepDrop(filtered), "pickup level filter rejects low-level equipment");
        int otherJobItem = -1;
        foreach (DataRow item in GameTables.current.items.rows) { if (item.Int("slot") >= 0 && item.Int("required_job") >= 0 && item.Int("required_job") != g.job) { otherJobItem = item.Int("id"); break; } }
        Check(otherJobItem >= 0, "job-specific equipment exists");
        Equipment offJob = g.CreateItem(otherJobItem, 1, 40); offJob.coefficient = 4;
        Check(!g.KeepDrop(offJob), "pickup job filter rejects off-job equipment");
        g.filterJobOnly = false; Check(g.KeepDrop(offJob), "pickup job filter can be disabled");
        g.filter = 0; g.filterCoefficient = 1; g.filterMinLevel = 0;
        g.bag.Clear(); Equipment e = g.CreateItem(dragon,0,1); g.bag.Add(e);
        Check(g.RecyclePrice(e,0) == 1000000, "reference dragon gold price");
        int gold = g.gold; int iron = g.iron; e.locked = true; g.RecycleAs(e,0);
        Check(g.bag.Count == 1 && g.gold == gold, "locked recycle atomic"); e.locked = false;
        g.gold = 1000000000; g.RecycleAs(e,0); Check(g.bag.Count == 1 && g.gold == 1000000000, "wallet cap preserves item");
        g.gold = gold; g.RecycleAs(e,0); Check(g.bag.Count == 0 && g.gold == gold + 1000000 && g.iron == iron, "recycle one selected currency not gold plus iron");
        gold = g.gold; g.RecycleAs(e,0); Check(g.gold == gold, "stale selection cannot double redeem");
        e = g.CreateItem(dragon,0,1); g.storage.Add(e); g.RecycleAs(e,0); Check(g.storage.Count == 1 && g.gold == gold, "warehouse protected");
        g.RecycleAs(g.equipped[0],0); Check(g.equipped[0] != null && g.gold == gold, "equipped protected");
        for (int c = 2; c <= 6; c = c + 1) {
            e = g.CreateItem(dragon,0,1); g.bag.Add(e); int old = g.RecycleBalance(c); int reward = g.RecyclePrice(e,c); g.RecycleAs(e,c);
            Check(g.bag.Count == 0 && g.RecycleBalance(c) == old + reward && g.gold == gold && g.iron == iron, "separate non-gold currency " + c.ToString());
        }
        g.bag.Clear();
        Equipment weakOne = g.CreateItem(24, 0, 13); Equipment weakTwo = g.CreateItem(24, 1, 13); weakTwo.locked = true;
        g.bag.Add(weakOne); g.bag.Add(weakTwo); int beforeGold = g.gold; int beforeRecycled = g.recycled;
        Check(g.RecycleWeakCount() == 1 && g.RecycleWeakGold() == g.RecyclePrice(weakOne, 0), "batch recycle previews eligible count and merged reward");
        g.RecycleWeak(); Check(g.bag.Count == 1 && g.bag[0] == weakTwo && g.gold == beforeGold + g.RecyclePrice(weakOne, 0) && g.recycled == beforeRecycled + 1, "batch recycle consumes only eligible items and merges reward");
        g.bag.Clear(); Equipment batchOne = g.CreateItem(dragon, 0, 1); Equipment batchTwo = g.CreateItem(dragon, 1, 1);
        g.bag.Add(batchOne); g.bag.Add(batchTwo); List<Equipment> selected = new List<Equipment>(); selected.Add(batchTwo); selected.Add(batchOne);
        int oldGems = g.gems; int oldGoldForBatch = g.gold; int oldIronForBatch = g.iron; int batchReward = g.RecyclePrice(batchOne, 5) + g.RecyclePrice(batchTwo, 5);
        Check(g.RecycleBatch(selected, 5), "batch recycle selected currency succeeds");
        Check(g.bag.Count == 0 && g.gems == oldGems + batchReward && g.gold == oldGoldForBatch && g.iron == oldIronForBatch, "batch recycle removes selected items in any order and does not grant other currencies");
        g.bag.Clear(); batchOne = g.CreateItem(dragon, 0, 1); batchTwo = g.CreateItem(dragon, 1, 1); batchTwo.locked = true;
        g.bag.Add(batchOne); g.bag.Add(batchTwo); Check(g.RecycleEligibleCount(0) == 1, "recycle eligible count excludes locked equipment");
        selected.Clear(); selected.Add(batchTwo); selected.Add(batchOne); int oldBatchBalance = g.RecycleBalance(0); int oldBatchBag = g.bag.Count;
        Check(!g.RecycleBatch(selected, 0) && g.bag.Count == oldBatchBag && g.RecycleBalance(0) == oldBatchBalance, "batch recycle validates all selections atomically");
        int treasureMaps = g.treasureMaps; g.Treasure();
        Check(g.treasureMaps == treasureMaps - 1 && g.treasureDraws == 1, "treasure map draw consumes one map and records today's draw");
        int dailyMaps = g.treasureMaps; g.Daily();
        Check(g.treasureMaps == dailyMaps + g.B("daily_treasure_maps"), "daily welfare grants configured treasure maps");
        g.AddRune(13, 1);
        Equipment blood = g.CreateItem(151, 1, 30); g.bag.Add(blood);
        int craftBag = g.bag.Count; int rune13ForCraft = g.RuneCount(13);
        g.legendOre = g.B("rune_word_ore") - 1;
        Check(!g.CraftLegend(0, g.bag.Count - 1) && g.bag.Count == craftBag && g.legendOre == g.B("rune_word_ore") - 1 && g.RuneCount(13) == rune13ForCraft, "legend craft ore shortage is atomic");
        g.legendOre = g.B("rune_word_ore");
        Check(g.CraftLegend(0, g.bag.Count - 1) && g.bag.Count == craftBag && g.legendOre == 0 && g.RuneCount(13) == rune13ForCraft - 1, "legend sword craft consumes base, ore and one 13# rune");
        Equipment legendary = g.bag[g.bag.Count - 1];
        Check(legendary.definitionId == g.B("legend_first_form") && legendary.tier == blood.tier && legendary.coefficient == blood.coefficient && legendary.upgrade == blood.upgrade, "legend sword becomes first form preserving quality");
        Check(!g.CraftLegend(1, g.bag.Count - 1) && g.bag[g.bag.Count - 1] == legendary, "legend recipe rejects wrong base without consuming");
        Equipment bloodLocked = g.CreateItem(151, 2, 30); g.bag.Add(bloodLocked); bloodLocked.locked = true;
        g.legendOre = g.B("rune_word_ore"); g.AddRune(13, 1); int lockedBag = g.bag.Count;
        Check(!g.CraftLegend(0, g.bag.Count - 1) && g.bag.Count == lockedBag && g.legendOre == g.B("rune_word_ore"), "locked legend base is rejected atomically");
        Equipment robeMale = g.CreateItem(341, 1, 30); g.bag.Add(robeMale);
        g.legendOre = g.B("rune_word_ore"); g.AddRune(13, 1);
        Check(g.CraftLegend(1, g.bag.Count - 1) && g.bag[g.bag.Count - 1].definitionId == g.B("legend_first_form") + g.B("legend_form_count"), "city lord male robe crafts legendary robe first form");
        Equipment robeFemale = g.CreateItem(342, 1, 30); g.bag.Add(robeFemale);
        g.legendOre = g.B("rune_word_ore"); g.AddRune(13, 1);
        Check(g.CraftLegend(2, g.bag.Count - 1) && g.bag[g.bag.Count - 1].definitionId == g.B("legend_first_form") + g.B("legend_form_count") * 2, "city lord female robe crafts legendary skirt first form");
        Equipment formOne = g.bag[g.bag.Count - 1];
        g.dragonBalls[0] = g.B("form_growth_balls") - 1; g.AddRune(13, 1);
        int formId = formOne.definitionId; int growRune13 = g.RuneCount(13); int growBag = g.bag.Count;
        Check(!g.GrowLegendForm(g.bag.Count - 1) && formOne.definitionId == formId && g.RuneCount(13) == growRune13 && g.bag.Count == growBag, "form growth ball shortage is atomic");
        g.dragonBalls[0] = g.B("form_growth_balls");
        Check(g.GrowLegendForm(g.bag.Count - 1) && formOne.definitionId == formId + 1 && formOne.coefficient == robeFemale.coefficient && g.RuneCount(13) == growRune13 - 1 && g.dragonBalls[0] == 0, "form growth advances chain in place preserving identity and quality");
        formOne.definitionId = g.B("legend_first_form") + g.B("legend_form_count") * 3 - 1;
        g.dragonBalls[8] = g.B("form_growth_balls"); g.AddRune(13, 1);
        Check(!g.GrowLegendForm(g.bag.Count - 1) && formOne.definitionId == g.B("legend_first_form") + g.B("legend_form_count") * 3 - 1, "ninth form is the template terminal");
        g.legendOre = 1234; g.dragonBalls[4] = 77;
        g.filter = 3; g.filterCoefficient = 5; g.filterMinLevel = 40; g.filterJobOnly = true;
        g.AddRune(3, 4);
        g.savedAt = 1700000120; Game loaded = SaveStore.Decode(SaveStore.Encode(g).ToJson());
        Check(loaded.secretFloor == g.secretFloor && loaded.secrets == g.secrets && !loaded.active, "secret save roundtrip");
        Check(loaded.filter == 3 && loaded.filterCoefficient == 5 && loaded.filterMinLevel == 40 && loaded.filterJobOnly, "pickup filters save roundtrip");
        Check(loaded.elementPool == g.elementPool && loaded.elementSeconds == 61 && loaded.elementRanks[0] == 1 && loaded.elementRanks[4] == 100, "elements save roundtrip");
        Check(loaded.reputation == g.reputation && loaded.redPackets == g.redPackets && loaded.recyclePoints == g.recyclePoints, "recycle wallets persisted");
        Check(loaded.treasureMaps == g.treasureMaps && loaded.treasureDraws == g.treasureDraws, "treasure map state persisted");
        Check(loaded.RuneCount(1) == 2 && loaded.RuneCount(3) == 4 && loaded.RuneCount(14) == 2, "levelled rune inventory survives save roundtrip");
        Check(loaded.legendOre == g.legendOre && loaded.DragonBallCount(5) == 77 && loaded.DragonBallCount(9) == g.DragonBallCount(9), "legendary materials survive save roundtrip");
        Check(loaded.SkillRank(1) == 2 && loaded.IsSkillEquipped(1) && loaded.SkillAtSlot(7).Text("kind") == "passive", "skill ranks and loadout persisted");
        JsonValue broken = SaveStore.Encode(g); broken.Set("elementRanks",JsonValue.NewArray()); bool rejected = false;
        try { SaveStore.Decode(broken.ToJson()); } catch (Exception ex) { rejected = true; } Check(rejected,"malformed elements rejected");
        broken = SaveStore.Encode(g); broken.Set("dragonBalls", JsonValue.NewArray()); rejected = false;
        try { SaveStore.Decode(broken.ToJson()); } catch (Exception ex) { rejected = true; } Check(rejected, "malformed dragon balls rejected");
        Console.WriteLine("PASS system gameplay checks=" + checks.ToString());
    }
}
