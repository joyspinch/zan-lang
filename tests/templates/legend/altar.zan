using System;
using Legend;
class LegendAltarTests {
    static int checks;
    static void Check(bool ok, string message) { checks = checks + 1; if (!ok) { throw new Exception("FAIL " + message); } }
    static void Main() {
        GameTables.Initialize("templates/game/legend/data"); Game g = new Game(); g.Choose(0);
        g.gold = 5000; g.gems = 2000; g.iron = 1000;
        g.DonateAltar(0);
        Check(g.gold == 4900 && g.altarPersonal == 100 && g.altarWorld == 100 && g.altarDonations == 1, "gold donation consumes and advances both tracks");
        int beforeGold = g.gold; int beforeIron = g.iron; g.iron = 20; g.DonateAltar(3);
        Check(g.gold == beforeGold && g.iron == 20 && g.altarPersonal == 100, "insufficient iron donation is atomic");
        g.iron = 1000;
        for (int i = 0; i < 9; i = i + 1) { g.DonateAltar(0); }
        Check(g.altarPersonal == 1000, "personal progress reaches configured claim line");
        int rewardGold = g.gold; int rewardYuan = g.gems; g.ClaimAltarPersonal();
        Check(g.altarPersonal == 0 && g.gold == rewardGold + g.B("altar_personal_reward_gold") && g.gems == rewardYuan + g.B("altar_personal_reward_yuan"), "personal altar reward claims exactly once");
        g.altarPersonal = 950; g.DonateAltar(0); g.ClaimAltarPersonal();
        Check(g.altarPersonal == 50, "personal progress overflow is retained after claim");
        g.altarWorld = 7990; g.gold = 500; g.gems = 0; int jackpots = g.altarJackpots; g.DonateAltar(0);
        Check(g.altarWorld == 90 && g.altarJackpots == jackpots + 1 && g.gold == 500 - 100 + g.B("altar_world_reward_gold"), "world threshold pays local jackpot and preserves overflow");
        g.savedAt = 1700000120; Game loaded = SaveStore.Decode(SaveStore.Encode(g).ToJson());
        Check(loaded.altarPersonal == g.altarPersonal && loaded.altarWorld == g.altarWorld && loaded.altarJackpots == g.altarJackpots && loaded.altarDonations == g.altarDonations, "altar progress saves and restores");
        Console.WriteLine("PASS altar gameplay checks=" + checks.ToString());
    }
}
