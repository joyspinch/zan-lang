using System;
using Legend;
class MapTravelTests {
    static int checks;
    static void Check(bool ok, string message) { checks = checks + 1; if (!ok) { throw new Exception("FAIL " + message); } }
    static void Main() {
        GameTables.Initialize("templates/game/legend/data"); Game g = new Game();
        g.Travel(1); Check(g.job == -1 && g.floor == 1 && g.enemyHp == 0, "no travel before creation");
        g.Choose(0); g.active = false; g.level = 10; g.best = 10; g.floor = 6; g.Spawn();
        int enemy = g.enemyHp; int seed = g.seed; int gold = g.gold;
        g.Travel(-1); g.Travel(1000);
        Check(g.floor == 6 && g.enemyHp == enemy && g.seed == seed && g.gold == gold, "invalid destination has no game effect");
        g.Travel(2); Check(g.floor == 6 && g.enemyHp == enemy && g.best == 10, "unreached floor cannot teleport");
        g.best = 100; g.Travel(4); Check(g.floor == 6 && g.enemyHp == enemy, "level requirement enforced");
        g.level = 100; g.Travel(13); Check(g.floor == 6 && g.enemyHp == enemy, "rebirth requirement enforced");
        g.mode = 1; g.Travel(0); Check(g.floor == 6 && g.mode == 1 && g.enemyHp == enemy, "cannot escape challenge through maps");
        g.mode = 0; g.recovery = 5; g.Travel(0); Check(g.floor == 6 && g.recovery == 5, "cannot bypass recovery");
        g.recovery = 0; g.wave = 2; g.Travel(0);
        Check(g.floor == 1 && g.wave == 0 && g.enemyHp == g.enemyMax && g.best == 100, "successful travel changes only current destination not best record");
        Check(!g.active && g.gold == gold, "teleport preserves pause and gold");
        g.Travel(1); Check(g.floor == GameTables.current.maps.rows[1].Int("start_floor") && g.EnemyData().Int("id") == GameTables.current.maps.rows[1].Int("monster_id"), "target monster matches map definition");
        Check(g.travelMap == 1 && g.homeFloor == 6 && g.homeWave == 2, "travel preserves the illusion track for return");
        g.wave = g.B("wave_count"); int stationFloor = g.floor; int stationBest = g.best; g.Victory();
        Check(g.travelMap == 1 && g.floor == stationFloor && g.wave == 0 && g.best == stationBest, "stationed guardian clear loops without pushing floors or best");
        g.Travel(4); Check(g.travelMap == 4 && g.homeFloor == 6 && g.homeWave == 2 && g.floor == 21, "switching stations keeps the original illusion track");
        g.savedAt = 1700000000; Game stationedSave = SaveStore.Decode(SaveStore.Encode(g).ToJson());
        Check(stationedSave.travelMap == 4 && stationedSave.homeFloor == 6 && stationedSave.homeWave == 2 && stationedSave.floor == 21, "station and home track persist together");
        g.ReturnHome(); Check(g.travelMap == -1 && g.floor == 6 && g.wave == 2 && g.enemyHp == g.enemyMax, "return restores illusion floor and wave");
        g.savedAt = 1700000000; Game restored = SaveStore.Decode(SaveStore.Encode(g).ToJson());
        Check(restored.floor == g.floor && restored.best == g.best && !restored.active, "destination saved and restored");
        Console.WriteLine("PASS map travel checks=" + checks.ToString());
    }
}
