using System;
using Wuwei;
class Program {
    static void Check(bool condition,string message) { if (!condition) {Console.WriteLine(message);throw new Exception(message);} }
    static void Main() {
        Game g=new Game();g.Init("templates/game/wuwei/data");
        Check(g.Data.Recipes.Count==108 && g.Data.Maps.Count==29 && g.Data.Enemies.Count==69,"original tables");
        Check(g.StartCultivation(),"cultivation start");g.Tick(30);Check(g.Qi==330 && g.Xp==1170,"cultivation transfer");
        Check(g.ClaimQuest(),"quest ready");Check(!g.ClaimQuest(),"no duplicate quest rewards");
        g.StopActivity();double before=g.AgeSeconds;g.Tick(-10);Check(g.AgeSeconds==before,"negative time");
        Check(g.StartBattle(0),"battle entry");g.Tick(90);Check(g.Kills>0,"battle rewards");
        g.StopActivity();Check(g.StartCraft(0),"gather start");g.Tick(32);Check(g.GatherCount>=4,"gather production");
        g.GainKarma(20);Check(g.UpgradeTalent(0),"permanent talent");int karma=g.Karma;int kills=g.TotalKills;g.Prestige();
        Check(g.Level==1 && g.Rebirths==1 && g.SpiritRoot==1 && g.Karma==karma && g.TotalKills==kills && g.CraftCount==0,"prestige state partition");
        for (int realm=0;realm<8;realm=realm+1) {
            g.Level=realm*12+12;g.Qi=g.QiNeed();Check(!g.Breakthrough(),"pill gate");
            g.AddItem(g.Data.Realms[realm].Text("pill"),1);Check(g.Breakthrough(),"realm breakthrough");Check(g.Realm()==realm+1,"realm advancement");
        }
        g.Level=108;Check(!g.Breakthrough(),"final realm gate");
        g.Prestige();double applied=g.SimulateOffline(999999);Check(applied==28800,"eight hour cap");Check(g.NeedsPrestige,"lifespan expiry");
        double frozen=g.AgeSeconds;g.Tick(100);Check(g.AgeSeconds==frozen,"expired run frozen");
        g.Prestige();g.Hp=10;Check(g.UseItem("alchemy_heal_pill") && g.Hp>10,"healing item");
        g.AddItem("alchemy_foundation_pill",1);Check(!g.UseItem("alchemy_foundation_pill") && g.ItemCount("alchemy_foundation_pill")==1,"breakthrough pills cannot be consumed as xp");
        string saved=g.Serialize();Game restored=new Game();restored.Init("templates/game/wuwei/data");
        Check(restored.LoadState(saved),"save roundtrip");Check(restored.Serialize()==saved,"all persisted fields roundtrip");
        Check(!restored.LoadState(saved.Replace("state,Level,1","state,Level,999")),"invalid level rejected");Check(restored.Serialize()==saved,"failed load transactional");
        Check(!restored.LoadState("schema,version,1\nstate,Level,1\n"),"missing state rejected");
        Check(!restored.LoadState(saved+"state,Level,1\n"),"duplicate keys rejected");
        Check(!restored.LoadState(saved.Replace("state,Hp,45","state,Hp,NaN")),"nonfinite rejected");
        g.StartBattle(0);g.Tick(30);string battleSave=g.Serialize();Check(restored.LoadState(battleSave),"battle inventory save");
        g.Tick(60);restored.SimulateOffline(60);Check(g.Kills==restored.Kills && g.Hp==restored.Hp && g.Seed==restored.Seed && g.Xp==restored.Xp,"online offline deterministic parity");
        g.Prestige();g.Level=12;g.SkillLevels["attack"]=99;g.PermanentAttack=120;g.PermanentDefense=100;g.PermanentHp=600;g.Hp=g.MaxHp();
        Check(g.StartBattle(20),"first extreme challenge");g.Tick(600);Check(g.BossKills==1 && g.ItemCount("alchemy_foundation_pill")==1,"nine waves first clear pill");
        Check(g.Data.Achievements.Count==33 && g.Data.Arena.Count==10 && g.Data.SectVault.Count==6 && g.Data.Effects.Count==30,"complete original extension tables");
        g.Prestige();g.Level=13;g.SkillLevels.Clear();Check(g.MaxHp()==359 && g.Attack()>58.39 && g.Attack()<58.41 && g.Defense()>19.79,"total level stat formulas");
        for (int sect=0;sect<2;sect=sect+1) {
            g.Prestige();g.Level=108;g.Hp=g.MaxHp();g.Contribution=100000;Check(g.JoinSect(sect),"join actual sect");Check(g.ArenaOpponentCount()==5 && g.SectVaultCount()==3,"all actual sect content");
            for (int v=0;v<3;v=v+1) {Row row=g.SectVaultRow(v);Check(row!=null && g.ItemRow(row.Id)!=null,"real vault IDs");double contribution=g.Contribution;Check(g.ExchangeSectVault(v),"vault exchange");Check(g.Contribution<contribution,"vault charges contribution");}
            Check(g.SectManual==1 && g.SectVaultCost(1)==1040,"escalating manual price");
            string pill=g.SectVaultItem(2);double xp=g.Xp;Check(g.UseItem(pill) && g.Xp==xp+3000,"sect potion effect");
            g.PermanentAttack=120;g.SkillLevels["attack"]=99;g.SpiritRoot=100;g.Constitution=100;g.Hp=g.MaxHp();g.PlayedSeconds=0;foreach (Row item in g.Data.Items) {if (item.Text("slot")!="") {g.AddItem(item.Id,1);}}foreach (string id in g.Inventory.Keys) {Row item=g.ItemRow(id);if (item!=null && item.Text("slot")!="" && g.CompareGear(id,item.Text("slot"))) {g.UseItem(id);}}g.Hp=g.MaxHp();
            for (int opponent=0;opponent<5;opponent=opponent+1) {Row row=g.ArenaOpponentRow(opponent);Check(row!=null && row.Int("req")== (opponent==0 ? 13 : opponent==1 ? 25 : opponent==2 ? 49 : opponent==3 ? 73 : 97),"authentic arena gates");double contribution=g.Contribution;Check(g.ArenaFightOpponent(opponent),"arena win");Check(g.Contribution==contribution+row.Num("reward") && g.ArenaOpponentWon(opponent),"arena real reward and cycle win");Check(!g.ArenaFightOpponent(opponent),"no duplicate cycle win");}
            Check(g.ArenaWins()==5,"five wins");g.PlayedSeconds=300;Check(!g.ArenaAvailable(),"arena closed window");g.PlayedSeconds=900;Check(g.ArenaAvailable() && !g.ArenaOpponentWon(0) && g.ArenaFightOpponent(0),"new cycle resets opponent");
            string arenaSave=g.Serialize();Check(restored.LoadState(arenaSave) && restored.ArenaWins()==6 && restored.ArenaOpponentWon(0),"arena save roundtrip");
        }
        g.Prestige();g.Level=108;g.Hp=g.MaxHp();
        foreach (Row item in g.Data.Items) {if (item.Text("type")=="alchemy") {g.AddItem(item.Id,1);g.Hp=1;g.AgeSeconds=500;double xp=g.Xp;Check(g.UseItem(item.Id),"all alchemy effects consume: "+item.Id);if (item.Text("effect")=="xp_500") {Check(g.Xp==xp+500,"original xp500");}if (item.Text("effect")=="xp_10000") {Check(g.Xp==xp+10000,"original xp10000");}if (item.Text("effect")=="qi") {Check(g.Xp==xp+40,"original spirit pill40");}}}
        foreach (Row effect in g.Data.Effects) {
            g.WineTimers.Clear();g.Formation="";g.FormationStars=1;
            if (effect.Id.IndexOf("brewing_")==0) {g.AddItem(effect.Id,1);Check(g.UseItem(effect.Id) && g.WineTimers[effect.Id]==720,"all wine activation");foreach (string stat in effect.Fields.Keys) {if (stat!="id" && effect.Text(stat)!="") {Check(g.WineMultiplier(stat)>1+effect.Num(stat)-0.000001 && g.WineMultiplier(stat)<1+effect.Num(stat)+0.000001,"every wine numerical effect "+effect.Id+" "+stat);}}g.Tick(180);Check(g.WineTimers[effect.Id]==0,"wine expiration");}
            if (effect.Id.IndexOf("formation_")==0) {g.AddItem(effect.Id,1);g.Mastery[effect.Id]=1000;Check(g.UseItem(effect.Id),"all formations activate");foreach (string stat in effect.Fields.Keys) {if (stat!="id" && effect.Text(stat)!="") {Check(g.FormationEffect(stat)==effect.Num(stat)*g.MasteryStar(effect.Id),"every formation numerical effect");}}}
            if (effect.Id.IndexOf("talisman_")==0) {g.AddItem(effect.Id,1);Check(g.UseItem(effect.Id),"all talismans equip");g.EnemyMaxHp=1000;g.EnemyHp=1000;g.BattleTalismans();if (effect.Num("opening")>0) {Check(g.EnemyHp>1000*(1-effect.Num("opening"))-0.0001 && g.EnemyHp<1000*(1-effect.Num("opening"))+0.0001,"opening talisman actual damage");}if (effect.Num("swift")>0) {Check(g.Count(g.RunState,"swift")==effect.Int("swift"),"swift battle duration");}if (effect.Num("opening")==0 && effect.Num("swift")==0) {Check(g.ConsumeTalisman(effect.Id),"defensive loadout consumes only equipped item");}}
        }
        for (int defenseTest=0;defenseTest<4;defenseTest=defenseTest+1) {
            Game plain=new Game();plain.Init("templates/game/wuwei/data");plain.Level=108;plain.AutoHeal=false;plain.Hp=plain.MaxHp();plain.StartBattle(28);plain.EnemyClock=100;plain.PlayerClock=0;plain.Seed=1234;
            Game ward=new Game();ward.Init("templates/game/wuwei/data");Check(ward.LoadState(plain.Serialize()),"defensive snapshot");string id=defenseTest==0 ? "talisman_golden_armor" : defenseTest==1 ? "talisman_guard" : defenseTest==2 ? "talisman_heal" : "talisman_rebirth";ward.AddItem(id,1);ward.UseItem(id);
            if (defenseTest>=2) {plain.Hp=defenseTest==3 ? 1 : plain.MaxHp()*0.5;ward.Hp=plain.Hp;}plain.Step(0.25);ward.Step(0.25);
            Check(ward.ItemCount(id)==0,"defensive talisman combat consumption "+id);Check(ward.Hp>plain.Hp,"defensive talisman real damage "+id);if (defenseTest==3) {Check(ward.Recovery==0 && ward.Hp==ward.MaxHp()*0.5,"rebirth saves life");}
        }
        g.Prestige();g.Level=97;g.Constitution=0;g.PermanentAttack=0;g.PermanentHp=0;g.PermanentDefense=0;g.Hp=g.MaxHp();g.JoinSect(0);g.PlayedSeconds=0;
        Check(!g.ArenaFightOpponent(4) && g.ArenaOpponentAttempted(4) && !g.ArenaOpponentWon(4),"failed arena attempt consumed");Check(!g.ArenaFightOpponent(4),"no retry after arena loss");g.PlayedSeconds=900;Check(!g.ArenaOpponentAttempted(4),"arena failed attempt resets by cycle");
        g.Prestige();g.Level=108;g.Hp=g.MaxHp();g.QuestIndex=15;Check(!g.ClaimQuest(),"arts quest rejects missing composite gates");g.ArtLevels["fishing"]=5;g.Crafted["alchemy_heal_pill"]=3;g.Mastery["alchemy_heal_pill"]=100;Check(g.ClaimQuest() && g.ItemCount("heavenly_essence")==2,"arts quest actual reward");Check(!g.ClaimQuest(),"formation quest requires talisman and formation");g.Crafted["talisman_fire"]=1;g.Crafted["formation_sharp"]=1;g.Formation="formation_sharp";Check(g.ClaimQuest() && g.ItemCount("talisman_guard")==2,"formation composite reward");
        g.QuestIndex=18;g.MapKills["10"]=3;g.MapKills["11"]=3;g.MapKills["12"]=3;int skillBefore=g.Skill("mind");Check(g.ClaimQuest() && g.Skill("mind")==skillBefore+1 && g.GearBases.Count==2,"quest18 all skills and two rare gear");g.BossKills=1;Check(g.ClaimQuest() && g.GearBases.Count==5,"quest19 three rare gear");
        g.Prestige();g.Level=108;g.Hp=g.MaxHp();g.AddItem("taicang_robe",2);string gear="";foreach (string id in g.Inventory.Keys) {if (g.ItemBaseId(id)=="taicang_robe") {gear=id;}}
        Check(gear!="" && g.ItemCount(gear)==1 && g.GearBases.Count==2,"durable gear identities do not stack");Check(g.UseItem(gear) && g.Equipment["robe"]==gear,"equip durable identity");Check(g.Unequip("robe") && g.ItemCount(gear)==1,"unequip durable identity");Check(!g.RecycleGear("unknown"),"recycle null safe");Check(g.RecycleGear(gear),"recycle gear");
        string gearSave=g.Serialize();Check(restored.LoadState(gearSave),"gear schema2 roundtrip");
        g.Prestige();g.Level=13;g.QuestIndex=12;Check(g.ClaimQuest(),"retroactive foundation quest avoids soft lock");g.QuestIndex=20;Check(g.ClaimQuest(),"final quest unconditional after earlier gates");
        g.QuestIndex=8;g.ManualSaves=1;Check(!g.ClaimQuest(),"music and save both required");g.SetMusicAdjusted();Check(g.ClaimQuest(),"music preference gate");
        // 核心契约与语义定义。
        g.Level=108;g.TotalKills=1000;g.CultivationSeconds=30;g.Rebirths=1;g.SpiritRoot=1;g.Constitution=1;g.Insight=1;g.Fortune=1;g.QuestIndex=g.Data.Quests.Count;
        foreach (Row enemy in g.Data.Enemies) {g.EnemyKills[enemy.Id]=1;}foreach (Row recipe in g.Data.Recipes) {g.Crafted[recipe.Id]=1;}foreach (Row market in g.Data.Market) {g.Collect("market",market.Id);}
        foreach (Row item in g.Data.Items) {if (item.Text("slot")!="" && !g.Equipment.ContainsKey(item.Text("slot"))) {g.GiveGear(item.Id,4);string id=item.Id+"#"+Convert.ToString(g.Count(g.RunState,"gear_serial"));Check(g.UseItem(id),"equip achievement slot");}}g.Hp=g.MaxHp();
        for (int a=0;a<g.AchievementCount();a=a+1) {Row row=g.AchievementRow(a);Check(g.AchievementUnlocked(a) && g.AchievementName(a)==row.Name && g.AchievementProgress(a)>=row.Int("target"),"all 33 real achievement predicates "+row.Id);}
        string achievementSave=g.Serialize();Check(restored.LoadState(achievementSave),"achievement save");g.Prestige();for (int a=0;a<33;a=a+1) {Check(g.AchievementUnlocked(a),"achievement persists across prestige");}
        g.Prestige();g.Constitution=0;g.SpiritRoot=0;g.Hp=g.MaxHp();g.Achievements.Clear();g.AchievementStats.Clear();g.Collections.Clear();string modern=g.Serialize();
        // 核心契约与语义定义。
        List<List<string>> legacyRows=System.Text.Csv.Parse(modern);List<List<string>> legacy=new List<List<string>>();List<string> header=legacyRows[0];header[2]="1";
        foreach (List<string> row in legacyRows) {string group=row[0];if (group!="Achievements" && group!="AchievementStats" && group!="Collections" && group!="ArenaState" && group!="RunState" && group!="GearQualities" && group!="WineTimers" && group!="GearBases" && group!="Loadout") {legacy.Add(row);}}
        Check(restored.LoadState(System.Text.Csv.Serialize(legacy)),"schema1 migration preserves old scalars and dictionaries");
        g.Level=108;g.Hp=g.MaxHp();g.SpiritRoot=100;g.Constitution=100;g.PermanentAttack=120;g.SkillLevels["attack"]=99;g.Hp=g.MaxHp();Check(g.StartBattle(28),"final ascending gate");g.Wave=9;g.EnemyHp=1;g.Victory();Check(g.Ascended && g.BossKills==1,"final ascension after ninth boss wave");
        Console.WriteLine("Wuwei core model tests passed: source tables, 33 achievements, 10 opponents, effects, identities, quests, migration, ascension");
    }
}
