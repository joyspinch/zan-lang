using System;

class Model {
    string name;
}

class Widget {
    Binding<string> text;

    void SetConst(string s) {
        text = s;            // const-binding reassignment (like Label.SetText each frame)
    }
    void SetLive(Model m) {
        text = m.name;       // live-binding reassignment
    }
    string Read() {
        if (text == null) { return ""; }
        return text.Get();
    }
}

class Program {
    static void Main() {
        Model m = new Model();
        m.name = "hello";
        Widget w = new Widget();

        int i = 0;
        for (; i < 300000; i = i + 1) {
            w.SetConst("v" + Convert.ToString(i % 97));
            string a = w.Read();
            w.SetLive(m);
            string b = w.Read();
        }
        Console.WriteLine("DONE loops=" + Convert.ToString(i) + " last=" + w.Read());
    }
}
