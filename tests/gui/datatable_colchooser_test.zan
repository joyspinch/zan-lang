using System;
using Gui;
using Gui.Widget;

namespace DataTableColumnChooserTest;

class Program {
    static DataRow Row(string id, string region, string price, string grade) {
        DataRow row = new DataRow();
        row.Push(id);
        row.Push(region);
        row.Push(price);
        row.Push(grade);
        return row;
    }

    // 按当前可见顺序拼出表头序列——列选择器改动
    // 的最终效果就是它。
    static string HeaderDump(DataTableState st, List<DataColumn> cols) {
        string s = "";
        List<int> ord = DataTable.VisibleOrder(st, cols);
        for (int i = 0; i < ord.Count; i = i + 1) {
            s = s + cols[ord[i]].field + " ";
        }
        return s;
    }

    static void Main() {
        List<DataRow> rows = new List<DataRow>();
        rows.Add(Program.Row("a", "EU", "100", "A"));
        rows.Add(Program.Row("b", "EU", "50", "B"));
        rows.Add(Program.Row("c", "US", "200", "C"));
        rows.Add(Program.Row("d", "APAC", "30", "A"));
        LocalDataSource src = new LocalDataSource(rows);

        List<DataColumn> cols = new List<DataColumn>();
        cols.Add(DataColumn.Field(new DataColumn("Id", 70), "id"));
        cols.Add(DataColumn.Field(new DataColumn("Region", 80), "region"));
        cols.Add(DataColumn.Field(DataColumn.Numeric("Price", 80), "price"));
        cols.Add(DataColumn.Field(new DataColumn("Grade", 70), "grade"));

        DataTableState st = new DataTableState();
        DataTable.EnsureInit(st, cols, src);
        DataTable.Recompute(st, cols, src);
        Console.WriteLine("base=" + (Program.HeaderDump(st, cols) == "id region price grade "));

        // ---- 打开/关闭与状态复位 ----
        Console.WriteLine("initiallyClosed=" + (DataTable.IsColumnChooserOpen(st) == false));
        st.colChooserSearch = "junk";
        st.colChooserScroll = 2;
        DataTable.SetColumnChooser(st, true);
        Console.WriteLine("openResets=" + (DataTable.IsColumnChooserOpen(st)
            && st.colChooserSearch == "" && st.colChooserScroll == 0));

        // ---- 行序：colOrder 在前、声明序补后；未登记时=声明序 ----
        List<int> ord = DataTable.ChooserOrder(st, cols);
        Console.WriteLine("orderDecl=" + (ord.Count == 4 && ord[0] == 0 && ord[1] == 1
            && ord[2] == 2 && ord[3] == 3));
        // 模拟用户重排（price 提到最前）：EnsureInit 已把 colOrder
        // 归一成完整声明序，重排必须保持"每列恰好一次"。
        st.colOrder.RemoveAt(2);
        st.colOrder.Insert(0, 2);
        List<int> ord2 = DataTable.ChooserOrder(st, cols);
        Console.WriteLine("orderUser=" + (ord2.Count == 4 && ord2[0] == 2 && ord2[1] == 0
            && ord2[2] == 1 && ord2[3] == 3));

        // ---- 搜索框按标题过滤（大小写不敏感） ----
        st.colChooserSearch = "re";
        List<int> ord3 = DataTable.ChooserOrder(st, cols);
        Console.WriteLine("searchFilter=" + (ord3.Count == 1 && ord3[0] == 1));
        st.colChooserSearch = "";
        DataTable.SetColumnChooser(st, false);
        Console.WriteLine("closeResets=" + (DataTable.IsColumnChooserOpen(st) == false
            && st.colChooserSearch == ""));

        // ---- 勾选/取消：与 HideField 同落点（price 已被提到最前，
        // ---- 显示后应回到首位） ----
        DataTable.ChooserToggle(st, cols, 2, false);
        Console.WriteLine("uncheckHides=" + (st.colHidden[2] == true
            && Program.HeaderDump(st, cols) == "id region grade "));
        DataTable.ChooserToggle(st, cols, 2, true);
        Console.WriteLine("checkShows=" + (st.colHidden[2] == false
            && Program.HeaderDump(st, cols) == "price id region grade "));

        // ---- 行内重排：前移/后移各一位 ----
        // price 已在最前：前移空操作，先右移一位再移回来。
        DataTable.ChooserMove(st, cols, 2, true);
        Console.WriteLine("moveLeftNoop=" + (Program.HeaderDump(st, cols) == "price id region grade "));
        DataTable.ChooserMove(st, cols, 2, false);
        Console.WriteLine("moveRight=" + (Program.HeaderDump(st, cols) == "id price region grade "));
        DataTable.ChooserMove(st, cols, 2, true);
        Console.WriteLine("moveLeftBack=" + (Program.HeaderDump(st, cols) == "price id region grade "));
        // 中段后移：grade 后移一位到末尾。
        DataTable.ChooserMove(st, cols, 3, false);
        Console.WriteLine("moveRightEnd=" + (Program.HeaderDump(st, cols) == "price id region grade "));

        // ---- Show All：清除所有隐藏（含独立 HideField 设置的） ----
        DataTable.HideField(st, cols, "id", true);
        DataTable.ChooserToggle(st, cols, 1, false);
        Console.WriteLine("mixedHidden=" + (DataTable.HiddenCount(st) == 2));
        st.colHidden[0] = false;
        st.colHidden[1] = false;
        Console.WriteLine("showAll=" + (DataTable.HiddenCount(st) == 0
            && Program.HeaderDump(st, cols) == "price id region grade "));

        // ---- 重排与可见性互不干扰；数据读取仍按源列 ----
        string s0 = "";
        for (int i = 0; i < DataTable.DispCount(st); i = i + 1) {
            s0 = s0 + src.CellText(DataTable.DispRowOf(st, i), 0);
        }
        Console.WriteLine("dataStable=" + (s0 == "abcd"));
    }
}
