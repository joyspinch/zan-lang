// 分区后端驻留串地址回归：build_partition 曾把 unnamed_addr 的类型名驻留串
// 在每个单元各复制一份，而 is/强转按指针比较类型名——Gui 包内跨单元
// 分配的 GuiCoreState 强转失败，所有 GUI 程序在 Form.Create 抛
// InvalidCastException。这里走真实 Gui 包（足够大，分区一定开启）。
// golden: FORM_CREATE_OK
using System;
using Gui;

class FormCreateCast {
    static void Main() {
        Form f = Form.CreateDark("partition cast", 320, 200);
        Console.WriteLine(f != null ? "FORM_CREATE_OK" : "FORM_NULL");
    }
}
