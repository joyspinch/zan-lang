using System;
using System.IO;
using Gui;
using Game.Scene;
using Game.Foundation;

partial class ZfSceneAdapter {
    static int enters;

    static SceneDoc BuildScene() {
        return SceneDoc.Parse(File.ReadAllText("tests/gui/scene_adapter.html"));
    }

    static void OnLoad(App app) { }

    static void OnSceneEnter() { enters = enters + 1; }
    static void OnSceneExit() { }
    static void OnScenePause() { }
    static void OnSceneResume() { }
    static void OnSceneFixedUpdate(int deltaMilliseconds) { }
}

class ZfSceneAdapterScene : IGameScene {
    SceneDoc d;
    App host;
    SceneViewSession view;

    public string Name() { return "ZfSceneAdapter"; }

    public void Host(App app) {
        host = app;
        if (d != null && host != null) {
            if (view == null) { view = SceneView.Attach(host, d); } else { view.Bind(host); }
        }
    }

    public void Enter() {
        d = ZfSceneAdapter.BuildScene();
        d.SetLayersActive(true);
        ZfSceneAdapter.OnSceneEnter();
        if (host != null) { view = SceneView.Attach(host, d); }
    }

    public void Exit() {
        SceneViewSession previous = view;
        view = null;
        if (previous != null) { previous.Retire(); }
        ZfSceneAdapter.OnSceneExit();
        d = null;
    }

    public void Pause() { ZfSceneAdapter.OnScenePause(); }

    public void Resume() { ZfSceneAdapter.OnSceneResume(); }

    public void FixedUpdate(int deltaMilliseconds) {
        ZfSceneAdapter.OnSceneFixedUpdate(deltaMilliseconds);
    }

    public void Update(int deltaMilliseconds) {
        if (d == null || host == null) { return; }
        if (!host.needsRedraw) { return; }
        host.BeginFrame();
        if (!host.PrepareStandardHostFrame()) { return; }
        if (view != null) { view.Render(host); }
        if (!host.ContinuePreparedFrame()) { return; }
        host.PresentFrame();
    }

    public SceneDoc Doc() { return d; }

    public string PendingScene() {
        return d == null ? "" : d.PendingScene();
    }
}

class SceneAdapterTest {
    static int fails;

    static void Ok(string what, bool cond) {
        if (cond) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Main() {
        fails = 0;

        ZfSceneAdapterScene s = new ZfSceneAdapterScene();
        Ok("iface", s is IGameScene);

        SceneStack st = new SceneStack();
        st.Push(s);
        Ok("count", st.Count() == 1);
        Ok("current", st.Current() == s);
        Ok("name", s.Name() == "ZfSceneAdapter");

        Ok("doc-live", s.Doc() != null);
        Ok("layer-closed", !s.Doc().LayerOpen("confirm"));

        int fires = 0;
        s.Doc().SetHandler("OnNext", () => { fires = fires + 1; });
        s.Doc().RunActions("OnNext", "");
        Ok("handler", fires == 1);

        s.Doc().RunActions("OpenScene:Settings", "");
        Ok("pending", s.PendingScene() == "Settings");
        s.Doc().ClearPendingScene();
        Ok("consumed", s.PendingScene().Length == 0);
        s.Exit();
        Ok("doc-null", s.Doc() == null);
        st.Pop();
        Ok("stack-clear", st.Count() == 0);

        s.Update(16);

        s.Pause();
        s.Resume();
        s.FixedUpdate(33);

        st.Push(s);
        st.Pop();
        Ok("stack-clear-2", st.Count() == 0);

        Ok("enters", ZfSceneAdapter.enters == 2);
        Console.WriteLine("adapter-done=" + (fails == 0));
    }
}
