using System;
using Gui;
using Game.Scene;
using Game.Foundation;

/// Code-behind of the tested scene document (scene_adapter.zscene): the
/// generated projection nests a `partial class ZfSceneAdapterScene :
/// Game.Foundation.IGameScene` inside the design class, so the designed scene
/// plugs into a SceneStack with zero hand-written glue.
partial class ZfSceneAdapter {
    static int enters;

    static void OnLoad(App app) { }

    static void OnSceneEnter() { enters = enters + 1; }
    static void OnSceneExit() { }
    static void OnScenePause() { }
    static void OnSceneResume() { }
    static void OnSceneFixedUpdate(int deltaMilliseconds) { }
}

class SceneAdapterTest {
    static int fails;

    static void Ok(string what, bool cond) {
        if (cond) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Main() {
        fails = 0;

        // The adapter implements the IGameScene contract; the design class
        // keeps its static projection (BuildScene/Run) untouched.
        ZfSceneAdapterScene s = new ZfSceneAdapterScene();
        Ok("iface", s is IGameScene);

        // Push through a SceneStack: Push fires Enter (the business hook
        // runs) and the stack reports the adapter as current.
        SceneStack st = new SceneStack();
        st.Push(s);
        Ok("count", st.Count() == 1);
        Ok("current", st.Current() == s);
        Ok("name", s.Name() == "ZfSceneAdapter");

        // Enter rebuilt the design document and switched on interaction
        // (layer filtering), so the designed "confirm" layer starts closed.
        Ok("doc-live", s.Doc() != null);
        Ok("layer-closed", !s.Doc().LayerOpen("confirm"));

        // Click handlers register on the live document; the designed button
        // action ("OnNext") fires through SceneDoc.RunActions.
        int fires = 0;
        s.Doc().SetHandler("OnNext", () => { fires = fires + 1; });
        s.Doc().RunActions("OnNext", "");
        Ok("handler", fires == 1);

        // OpenScene queues on the live document and shows through the
        // adapter; the host consumes it with ClearPendingScene.
        s.Doc().RunActions("OpenScene:Settings", "");
        Ok("pending", s.PendingScene() == "Settings");
        s.Doc().ClearPendingScene();
        Ok("consumed", s.PendingScene().Length == 0);
        s.Exit();
        Ok("doc-null", s.Doc() == null);
        st.Pop();
        Ok("stack-clear", st.Count() == 0);

        // Without a host window Update must no-op (safe outside Enter).
        s.Update(16);

        // Pause/Resume/FixedUpdate forward to the business hooks.
        s.Pause();
        s.Resume();
        s.FixedUpdate(33);

        // Re-push exercises the stack's Pause/Resume path: Push Enter/Pop
        // Exit fires the hooks a second time.
        st.Push(s);
        st.Pop();
        Ok("stack-clear-2", st.Count() == 0);

        Ok("enters", ZfSceneAdapter.enters == 2);
        Console.WriteLine("adapter-done=" + (fails == 0));
    }
}
