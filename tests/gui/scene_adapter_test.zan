using System;
using Gui;
using Game.Scene;
using Game.Foundation;

/// 接口数据协议与执行契约。
/// 核心契约与语义定义。
/// 接口数据协议与执行契约。
/// 接口数据协议与执行契约。
partial class ZfSceneAdapter {
    static int enters;

    static void OnLoad(App app) { }

    static void OnSceneEnter() { enters = enters + 1; }
    static void OnSceneExit() { }
    static void OnScenePause() { }
    static void OnSceneResume() { }
    static void OnSceneFixedUpdate(int deltaMilliseconds) { }
}

class SceneAdapterTest {
    static int fails;

    static void Ok(string what, bool cond) {
        if (cond) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Main() {
        fails = 0;

        // 接口数据协议与执行契约。
        // 接口数据协议与执行契约。
        ZfSceneAdapterScene s = new ZfSceneAdapterScene();
        Ok("iface", s is IGameScene);

        // 接口数据协议与执行契约。
        // 接口数据协议与执行契约。
        SceneStack st = new SceneStack();
        st.Push(s);
        Ok("count", st.Count() == 1);
        Ok("current", st.Current() == s);
        Ok("name", s.Name() == "ZfSceneAdapter");

        // 接口数据协议与执行契约。
        // 接口数据协议与执行契约。
        Ok("doc-live", s.Doc() != null);
        Ok("layer-closed", !s.Doc().LayerOpen("confirm"));

        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        int fires = 0;
        s.Doc().SetHandler("OnNext", () => { fires = fires + 1; });
        s.Doc().RunActions("OnNext", "");
        Ok("handler", fires == 1);

        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        s.Doc().RunActions("OpenScene:Settings", "");
        Ok("pending", s.PendingScene() == "Settings");
        s.Doc().ClearPendingScene();
        Ok("consumed", s.PendingScene().Length == 0);
        s.Exit();
        Ok("doc-null", s.Doc() == null);
        st.Pop();
        Ok("stack-clear", st.Count() == 0);

        // 接口数据协议与执行契约。
        s.Update(16);

        // 接口数据协议与执行契约。
        s.Pause();
        s.Resume();
        s.FixedUpdate(33);

        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        st.Push(s);
        st.Pop();
        Ok("stack-clear-2", st.Count() == 0);

        Ok("enters", ZfSceneAdapter.enters == 2);
        Console.WriteLine("adapter-done=" + (fails == 0));
    }
}
