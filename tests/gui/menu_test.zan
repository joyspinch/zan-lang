using System;
using Gui;
using Gui.Widget;

// Gui.Widget.Menu 保留式树形菜单 conformance：
// 1. MenuExpandState 集合语义（Expand / Collapse / Toggle / Contains）。
// 2. 树形构建与组行展开/收起（不改选中状态，子级按需出现/消失）。
// 3. 保留式点击交互：点组行 toggle expandState；点叶子写回 selectedKey；
//    disabled 行点击不触发 Select 且不修改 selectedKey；SelectKey/SelectIndex
//    及 SetProp/GetProp 与 Binding<string> 双向同步。
class MenuTest {
    static int fails;
    static int selectEvents;

    static void Eq(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got "
            + Convert.ToString(got) + " want " + Convert.ToString(want));
    }

    static void Str(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got
            + "' want '" + want + "'");
    }

    static void True(string what, bool ok) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void OnMenuSelect() {
        selectEvents = selectEvents + 1;
    }

    static MenuItem Leaf(string label, string icon) {
        return MenuItem.Item(label, icon, 0);
    }

    static List<MenuItem> MakeTree(out MenuItem grp) {
        MenuItem a = MenuTest.Leaf("a", "");
        MenuItem b = MenuTest.Leaf("b", "");
        MenuItem c = MenuItem.Disabled("c", "", 0);
        List<MenuItem> kids = new List<MenuItem>();
        kids.Add(a);
        kids.Add(b);
        kids.Add(c);
        grp = MenuItem.Submenu("grp", "folder", kids);
        grp.key = "g1";
        List<MenuItem> items = new List<MenuItem>();
        items.Add(MenuItem.Header("nav"));
        items.Add(MenuTest.Leaf("home", "home"));
        items.Add(MenuItem.Separator());
        items.Add(grp);
        return items;
    }

    static Button FindMenuButton(Control root, string label) {
        if (root == null) { return null; }
        if (root is Button) {
            for (int i = 0; i < root.ChildCount(); i = i + 1) {
                Control ch = root.ChildAt(i);
                if (ch is Label && ch.GetProp("text") == label) {
                    return (Button)root;
                }
                for (int j = 0; j < ch.ChildCount(); j = j + 1) {
                    Control gch = ch.ChildAt(j);
                    if (gch is Label && gch.GetProp("text") == label) {
                        return (Button)root;
                    }
                }
            }
        }
        for (int i = 0; i < root.ChildCount(); i = i + 1) {
            Button found = MenuTest.FindMenuButton(root.ChildAt(i), label);
            if (found != null) { return found; }
        }
        return null;
    }

    static void Main() {
        Dispatcher.Init();
        fails = 0;
        selectEvents = 0;
        MenuItem grp;
        List<MenuItem> items = MenuTest.MakeTree(out grp);

        // ---- MenuExpandState 集合语义 ------------------------------------
        MenuExpandState st = new MenuExpandState();
        True("initially collapsed", !st.Contains("g1"));
        st.Expand("g1");
        True("Expand adds key", st.Contains("g1"));
        st.Toggle("g1");
        True("Toggle off", !st.Contains("g1"));
        st.Toggle("g1");
        True("Toggle on", st.Contains("g1"));
        st.Collapse("nope");
        True("Collapse absent is no-op", st.Contains("g1"));

        // ---- 保留式 Menu 建树与点击 --------------------------------------
        Binding<string> sel = "b";
        Menu menu = new Menu(items, sel);
        menu.Select.Add(MenuTest.OnMenuSelect);

        App app = App.CreateOffscreen("menu", 320, 480);
        app.SetRootControl(menu);
        app.BeginOffscreenFrame();
        menu.MeasureTree(app, 220);
        menu.Arrange(0, 0, 220, 480);
        app.EndOffscreenFrame();

        // 初始收起：只见 grp，不见子项 a/b/c。
        Button grpBtn = MenuTest.FindMenuButton(menu, "grp");
        True("group button built", grpBtn != null);
        True("child hidden when collapsed", MenuTest.FindMenuButton(menu, "a") == null);

        // 点击组行：展开 g1，不改 selectedKey，也不触发 Select。
        if (grpBtn != null) { grpBtn.Click.Raise(); }
        True("group click expands g1", menu.expandState.Contains("g1"));
        Str("group click keeps selection", sel.Get(), "b");
        Eq("group click does not fire Select", selectEvents, 0);

        Button childA = MenuTest.FindMenuButton(menu, "a");
        Button childB = MenuTest.FindMenuButton(menu, "b");
        Button childC = MenuTest.FindMenuButton(menu, "c");
        True("child a visible after expand", childA != null);
        True("child b active class", childB != null && childB.ClassName.Contains("active"));
        True("disabled child marked disabled", childC != null && childC.IsDisabled());

        // 点击禁用项：忽略。
        int ver = sel.Version();
        if (childC != null) { childC.Click.Raise(); }
        Eq("disabled click keeps version", sel.Version(), ver);
        Eq("disabled click keeps Select count", selectEvents, 0);

        // 点击叶子 a：更新 Binding<string> 并触发 Select。
        if (childA != null) { childA.Click.Raise(); }
        Str("child selected", sel.Get(), "a");
        Eq("child click fires Select", selectEvents, 1);

        // 再次点击组行：收起 g1，子项移除但选中保持 "a"。
        Button grpBtn2 = MenuTest.FindMenuButton(menu, "grp");
        if (grpBtn2 != null) { grpBtn2.Click.Raise(); }
        True("group click collapses g1", !menu.expandState.Contains("g1"));
        True("child removed after collapse", MenuTest.FindMenuButton(menu, "a") == null);
        Str("collapse keeps selection", sel.Get(), "a");

        // SetProp / GetProp / SyncBinding
        menu.SetProp("selectedKey", "home");
        Str("GetProp selectedKey", menu.GetProp("selectedKey"), "home");
        sel.Set("b");
        menu.SyncBinding();
        Str("SyncBinding reflects external write", menu.GetProp("selectedKey"), "b");

        app.StopLoop();
        app.SetRootControl(null);
        app.canvas.Destroy();
        Dispatcher.Clear();

        if (fails == 0) { Console.WriteLine("menu_test: OK"); }
        else {
            Console.WriteLine("menu_test: " + Convert.ToString(fails)
                + " failure(s)");
        }
    }
}
