using System;
using System.IO;
using System.Web;
using Gui;
using Gui.Widget;

// 工具箱 kind → 真身控件的归一映射：设计稿里 27 种调色板 kind 经
// 运行期投影（DesignerHtml.ToJsonDoc + FormBuilder.Build）全部建出
// 非空控件，kind 归一正确（Tag/Led/Dropdown 原名直通，序列化名
// "Alert"（ftype 28 显示名）与真身 "AlertBox" 都落到 AlertBox）。
class DesignPaletteTest {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" +
                          want + "'");
    }

    static void Main() {
        string html = File.ReadAllText("tests/gui/design_palette.html");
        Control root = FormBuilder.Build(
            JsonValue.ParseLenient(DesignerHtml.ToJsonDoc(html)));
        string[] ids = new string[]{
            "tag1", "badge1", "avatar1", "statistic1", "timeline1",
            "treeview1", "collapse1", "empty1", "result1", "skeleton1",
            "spin1", "steps1", "breadcrumb1", "pageheader1", "listview1",
            "dropdown1", "carousel1", "led1", "digital1", "gauge1",
            "bargraph1", "trend1", "numpad1", "devicecard1", "equippanel1",
            "alert1", "alertbox1"};
        for (int i = 0; i < ids.Length; i = i + 1) {
            if (root.Find(ids[i]) == null) {
                fails = fails + 1;
                Console.WriteLine("FAIL palette widget " + ids[i] + " missing");
            }
        }

        Control tag1 = root.Find("tag1");
        Control led1 = root.Find("led1");
        Control dropdown1 = root.Find("dropdown1");
        Control alert1 = root.Find("alert1");
        Control alertbox1 = root.Find("alertbox1");
        if (tag1 == null || led1 == null || dropdown1 == null
            || alert1 == null || alertbox1 == null) {
            Console.WriteLine("FAIL key palette widgets missing");
            return;
        }
        DesignPaletteTest.Eq("tag kind", tag1.Kind(), "Tag");
        DesignPaletteTest.Eq("led kind", led1.Kind(), "Led");
        DesignPaletteTest.Eq("dropdown kind", dropdown1.Kind(), "Dropdown");
        // 序列化 kind "Alert"（设计器 ftype 28 的显示名）与真身
        // "AlertBox" 都必须落到 Gui.Widget.AlertBox。
        DesignPaletteTest.Eq("alert kind", alert1.Kind(), "AlertBox");
        DesignPaletteTest.Eq("alertbox kind", alertbox1.Kind(), "AlertBox");

        if (fails == 0) { Console.WriteLine("DESIGN_PALETTE_OK"); }
    }
}
