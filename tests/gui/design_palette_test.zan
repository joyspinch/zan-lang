using System;
using Gui;
using Gui.Widget;
using Gui.Hmi;

/// 模拟用户项目里与工具箱 kind 同名的全局类。生成代码的控件
/// 声明与构造必须发射真实命名空间路径（Gui.Widget.* / Gui.Hmi.*，
/// 见 GenForm.QualifyKind）：裸名会被这里的类压过（A312/A314），
/// 错命名空间的限定名在同名类出现时直接报 undefined。
class Tag : Gui.Widget.Panel {
}

class Led : Gui.Widget.Panel {
}

class Dropdown : Gui.Widget.Panel {
}

/// Code-behind of the tested control document (design_palette.html):
/// every designer palette family, one instance each.
partial class Pal {
    void OnInit() {
    }
}

/// Covers the toolbox ↔ registry ↔ codegen unification: all 27
/// display/feedback/navigation/industrial kinds placed from the palette
/// generate compiling, constructing code even under user classes with
/// colliding names, and the select-family widgets keep their registry
/// contract (parameterless construction, options round-trip channel).
class DesignPaletteTest {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" +
                          want + "'");
    }

    static void Main() {
        Pal p = new Pal();
        Control[] all = new Control[]{
            p.tag1, p.badge1, p.avatar1, p.statistic1, p.timeline1,
            p.treeview1, p.collapse1, p.empty1, p.result1, p.skeleton1,
            p.spin1, p.steps1, p.breadcrumb1, p.pageheader1, p.listview1,
            p.dropdown1, p.carousel1, p.led1, p.digital1, p.gauge1,
            p.bargraph1, p.trend1, p.numpad1, p.devicecard1, p.equippanel1,
            p.alert1, p.alertbox1 };
        for (int i = 0; i < all.Length; i = i + 1) {
            if (all[i] == null) {
                fails = fails + 1;
                Console.WriteLine("FAIL palette field " + Convert.ToString(i) +
                                  " is null");
            }
        }

        // The colliding user classes above must NOT have captured these
        // fields: stdlib controls self-report their own kind labels.
        DesignPaletteTest.Eq("tag kind", p.tag1.Kind(), "Tag");
        DesignPaletteTest.Eq("led kind", p.led1.Kind(), "Led");
        DesignPaletteTest.Eq("dropdown kind", p.dropdown1.Kind(), "Dropdown");
        // 序列化 kind "Alert"（设计器 ftype 28 的显示名）与真身
        // "AlertBox" 都必须落到 Gui.Widget.AlertBox（A312/A314）。
        DesignPaletteTest.Eq("alert kind", p.alert1.Kind(), "AlertBox");
        DesignPaletteTest.Eq("alertbox kind", p.alertbox1.Kind(), "AlertBox");

        if (fails == 0) { Console.WriteLine("DESIGN_PALETTE_OK"); }
    }
}
