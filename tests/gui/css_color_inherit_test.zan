// CSS color: inherit / unset 回归：color 本就是继承属性，这两个关键字等于
// “不声明、沿用父级”。曾被当颜色解析成 0（全透明）且记为已声明，
// 游戏 HUD 常见的 `button.x label { color: inherit }` 让按钮文字整片隐形
// （背景照画，只剩空按钮）。按钮字色必须取按钮自己的 color。
// golden: COLOR_INHERIT_OK / COLOR_UNSET_OK
using System;
using Gui;
using Gui.Widget;

class CssColorInheritTest {
    static string Run(string keyword) {
        App app = App.CreateOffscreen("color inherit", 320, 100);
        try {
            app.UseAppCss("button.cta{position:absolute;padding:0;margin:0;justify-content:center;"
                + "align-items:center;font-size:24px;color:#102030;background:#ffd666;border:0}"
                + "button.cta label{background:transparent;border:0;padding:0;margin:0;"
                + "font-size:inherit;color:" + keyword + ";text-align:center}");
            Panel root = new Panel("root");
            Button b = new Button("TAP TO PLAY");
            b.Class = "cta";
            root.Add(b);
            root.UseApp(app);
            root.MeasureTree(app);
            root.Arrange(0, 0, 320, 100);
            b.Arrange(10, 10, 300, 80);
            app.canvas.Clear(0xffffffff);
            root.RenderTree(app);
            int dark = 0;
            for (int y = 10; y < 90; y = y + 1) {
                for (int x = 10; x < 310; x = x + 1) {
                    int p = app.canvas.GetPixel(x, y);
                    if (((p >> 8) & 255) < 120) { dark = dark + 1; }
                }
            }
            string tag = keyword == "inherit" ? "COLOR_INHERIT" : "COLOR_UNSET";
            if (dark < 40) { return tag + "_BLANK dark=" + Convert.ToString(dark); }
            return tag + "_OK";
        } finally { app.canvas.Destroy(); }
    }

    static void Main() {
        Canvas.SetBackend(RenderBackend.Cpu());
        Console.WriteLine(Run("inherit"));
        Console.WriteLine(Run("unset"));
    }
}
