using System;
using Gui;
using Gui.Widget;

namespace DynamicTagsTest;

/// Headless check of the dynamic tags' model bookkeeping: add/remove raise
/// exactly one Change each, bogus indices are silent no-ops, Max only gates
/// the interactive trigger (never programmatic Add), and the `|`-joined
/// options text round-trips through GetExtra/SetExtra for the designer.
class Program {
    static int changes;

    static string Shape(DynamicTags t) {
        string s = Convert.ToString(t.Count()) + " [";
        for (int i = 0; i < t.Count(); i = i + 1) {
            if (i > 0) { s = s + " "; }
            s = s + t.TextAt(i);
        }
        return s + "] canAdd=" + Convert.ToString(t.CanAdd());
    }

    static void Main() {
        DynamicTags t = new DynamicTags();
        t.Change += () => { changes = changes + 1; };
        Console.WriteLine("defaults closable=" + Convert.ToString(t.Closable)
            + " kind=" + t.Kind());
        Console.WriteLine("empty " + Program.Shape(t));

        // SetItems is a host-driven bulk sync: it replaces the whole
        // collection and must not count as a user edit.
        List<string> seed = new List<string>{ "调查中", "已发布", "已归档" };
        t.SetItems(seed);
        Console.WriteLine("seeded " + Program.Shape(t) + " changes="
            + Convert.ToString(changes));
        Console.WriteLine("options '" + t.GetProp("options") + "'");

        // Each single-item change is one Change, in the order it happened.
        t.Add("新标签");
        t.RemoveAt(1);
        Console.WriteLine("edited " + Program.Shape(t) + " changes="
            + Convert.ToString(changes));

        // Bogus indices must not fire anything.
        t.RemoveAt(0 - 1);
        t.RemoveAt(99);
        Console.WriteLine("bogus " + Program.Shape(t) + " changes="
            + Convert.ToString(changes));

        // Max gates the trigger only: programmatic Add still works and the
        // gate reopens once the host removes down below the limit.
        DynamicTags mx = new DynamicTags();
        mx.Max = 2;
        mx.Add("a");
        mx.Add("b");
        Console.WriteLine("maxed " + Program.Shape(mx));
        mx.Add("c");
        Console.WriteLine("overMax " + Program.Shape(mx));
        mx.RemoveAt(0);
        Console.WriteLine("atLimit " + Program.Shape(mx));
        mx.RemoveAt(0);
        Console.WriteLine("reopened " + Program.Shape(mx));

        // The designer writes `options` as a `|`-joined text; empty segments
        // (trailing separators, double pipes) collapse away.
        DynamicTags p = new DynamicTags();
        Console.WriteLine("setOptions " + Convert.ToString(p.SetExtra("options", "one|two|three"))
            + " " + Program.Shape(p));
        Console.WriteLine("setOptions emptySegs " + Convert.ToString(p.SetExtra("options", "x||y|"))
            + " " + Program.Shape(p));
        Console.WriteLine("roundTrip '" + p.GetProp("options") + "'");
        Console.WriteLine("unknownKey " + Convert.ToString(p.SetExtra("text", "nope"))
            + " extra='" + p.GetProp("nope") + "'");
        Console.WriteLine("cleared " + Program.Shape(p) + " options='"
            + p.GetProp("options") + "'");
    }
}
