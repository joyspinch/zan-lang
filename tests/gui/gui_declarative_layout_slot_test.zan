using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;

class MockUser {
    public string id;
    public string name;
    public string role;
    public bool online;

    public MockUser(string i, string n, string r, bool o) {
        this.id = i;
        this.name = n;
        this.role = r;
        this.online = o;
    }
}

class GuiDeclarativeLayoutSlotTest {
    static int fails;

    static void Check(string label, bool ok) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL: " + label);
    }

    static void Main() {
        Form win = Form.CreateOffscreen("DeclarativeUiWindow", 960, 760);

        // 1. 验证声明式代码树排版原语（Row, Column, Spacer, Center, View, TextBlock）
        TextBlock title = new TextBlock("用户管理系统") {
            ClassName = "title strong primary"
        };
        Check("TextBlock has strong class", title.HasClass("strong"));
        Check("TextBlock has primary class", title.HasClass("primary"));

        Button addBtn = new Button("新增用户");
        Spacer spacer = new Spacer();
        Check("Spacer is growable", spacer.grow);

        Row headerRow = new Row {
            ClassName = "gap-medium align-center",
            Children = [
                title,
                spacer,
                addBtn
            ]
        };
        Check("Row children count is 3", headerRow.ChildCount() == 3);

        Center centerBox = new Center {
            Children = [
                new TextBlock("居中文本") { ClassName = "muted" }
            ]
        };
        Check("Center has 1 child", centerBox.ChildCount() == 1);
        Check("Center is growable", centerBox.grow);

        // 2. 验证声明式代码树结构模式（CollapseItem + View + IconView + TextBlock + RelativeBindingSource.Ancestor<T>）
        string iconSvg = "<svg viewBox='0 0 24 24'><path d='M12 2L2 7l10 5 10-5-10-5z' stroke='currentColor'/></svg>";
        CollapseItem section = new CollapseItem {
            ItemKey = "general",
            IsExpanded = true,
            ArrowPlacement = "right",
            Header = new View {
                ClassName = "flex flex-row items-center gap-2",
                Children = [
                    new IconView {
                        ClassName = "w-4 h-4 text-sky-400 transition-transform duration-300",
                        Content = iconSvg,
                        Binding = [
                            new PropertyBinding<CollapseItem> {
                                TargetProperty = Control.ClassNameProperty,
                                Source = RelativeBindingSource.Ancestor<CollapseItem>(),
                                SourceProperty = p => p.IsExpanded,
                                Convert = expanded => expanded
                                    ? "w-4 h-4 text-sky-400 rotate-12 scale-110 transition-transform duration-300"
                                    : "w-4 h-4 text-sky-400 rotate-0 scale-100 transition-transform duration-300"
                            }
                        ]
                    },
                    new TextBlock {
                        ClassName = "text-sm font-semibold text-slate-100",
                        Text = "通用配置"
                    }
                ]
            },
            Content = new View {
                ClassName = "column gap-small",
                Children = [
                    new TextBlock("配置项 A"),
                    new TextBlock("配置项 B")
                ]
            },
            ClassName = "bg-slate-800/75 border border-slate-700/80 rounded-lg overflow-hidden",
            HeaderClassName = "px-3.5 py-2.5 bg-slate-800/90 hover:bg-slate-700/60 transition-colors duration-150",
            TitleClassName = "text-sm font-semibold text-slate-100",
            ContentClassName = "px-3.5 pb-3.5 pt-2 bg-slate-900/50 border-t border-slate-700/60",
            ArrowClassName = "text-slate-400 transition-transform duration-300"
        };

        // 3. 验证强类型双向绑定（DataContext 上下文继承 + Input/Switch/TextBlock 双向联动）
        MockUser editUser = new MockUser("u0", "张三", "架构师", true);
        Input nameInput = new Input("请输入姓名") {
            Binding = [
                new PropertyBinding<MockUser> {
                    TargetProperty = Control.ValueProperty,
                    SourceText = u => u.name,
                    SetSourceText = (u, val) => { u.name = val; }
                }
            ]
        };
        Switch onlineSwitch = new Switch {
            Binding = [
                new PropertyBinding<MockUser> {
                    TargetProperty = Control.ValueProperty,
                    SourceProperty = u => u.online,
                    SetSource = (u, val) => { u.online = val; }
                }
            ]
        };
        TextBlock statusLabel = new TextBlock {
            Binding = [
                new PropertyBinding<MockUser> {
                    TargetProperty = Control.TextProperty,
                    SourceProperty = u => u.online,
                    Convert = on => on ? "状态:在线" : "状态:离线"
                }
            ]
        };
        View formCard = new View {
            DataContext = editUser,
            ClassName = "row gap-small align-center",
            Children = [
                nameInput,
                onlineSwitch,
                statusLabel
            ]
        };

        // 4. 验证组件任意互嵌：ListView 行内嵌套 CollapseItem + 双向绑定 Switch + Table/TableCell 复合嵌套
        List<MockUser> users = new List<MockUser>();
        users.Add(new MockUser("u1", "王维", "研发总监", true));
        users.Add(new MockUser("u2", "李白", "资深工程师", false));

        ListView<MockUser> nestedList = new ListView<MockUser>((MockUser item) => new CollapseItem {
            Title = item.name,
            IsExpanded = false,
            Content = new View {
                ClassName = "column gap-small",
                Children = [
                    new TextBlock {
                        Binding = [
                            new PropertyBinding<MockUser> {
                                TargetProperty = Control.TextProperty,
                                SourceText = u => u.role
                            }
                        ]
                    },
                    new Table {
                        Children = [
                            new TableRow {
                                Children = [
                                    new TableCell { CellText = "在线开关", ColWidth = 100 },
                                    new TableCell {
                                        Content = new Switch {
                                            Binding = [
                                                new PropertyBinding<MockUser> {
                                                    TargetProperty = Control.ValueProperty,
                                                    SourceProperty = u => u.online,
                                                    SetSource = (u, v) => { u.online = v; }
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        });
        nestedList.Bind(users);

        // 5. 验证 DataGrid<T> 声明式代码树模式（Columns = [ ... ] + Template 任意组件互嵌 + 双向绑定）
        Switch row0SwitchRef = null;
        TextBlock row0StatusRef = null;
        DataGrid<MockUser> grid = new DataGrid<MockUser> {
            RowHeightPx = 40,
            ShowRowNumbers = true,
            IsStriped = true,
            ItemsSource = users,
            KeySelector = u => RowKey.Of(u.id),
            Columns = [
                new GridColumn<MockUser> {
                    Title = "姓名",
                    Width = 120,
                    Text = u => u.name
                },
                new GridColumn<MockUser> {
                    Title = "角色",
                    Width = 140,
                    Text = u => u.role
                },
                new GridColumn<MockUser> {
                    Title = "状态与操作",
                    Width = 240,
                    Template = u => {
                        Switch sw = new Switch {
                            Binding = [
                                new PropertyBinding<MockUser> {
                                    TargetProperty = Control.ValueProperty,
                                    SourceProperty = x => x.online,
                                    SetSource = (x, v) => { x.online = v; }
                                }
                            ]
                        };
                        TextBlock badge = new TextBlock {
                            Binding = [
                                new PropertyBinding<MockUser> {
                                    TargetProperty = Control.TextProperty,
                                    SourceProperty = x => x.online,
                                    Convert = on => on ? "在线" : "离线"
                                }
                            ]
                        };
                        if (u.id == "u1") {
                            row0SwitchRef = sw;
                            row0StatusRef = badge;
                        }
                        return new View {
                            ClassName = "flex flex-row items-center gap-2",
                            Children = [
                                sw,
                                badge,
                                new Button("详情") { ClassName = "small" }
                            ]
                        };
                    }
                }
            ]
        };

        // 6. 组合进入主页面容器，验证整个声明式界面的离线挂载与测量
        Column page = new Column {
            ClassName = "gap-medium",
            Children = [
                headerRow,
                centerBox,
                section,
                formCard,
                nestedList,
                grid
            ]
        };

        win.Add(page);

        // 触发布局与绘制快照
        Canvas snapshot = win.CaptureSnapshot();
        Check("snapshot not null", snapshot != null);

        // 校验 Ancestor 绑定与折叠面板
        IconView boundIcon = (IconView)section.Header.ChildAt(0);
        Check("Ancestor binding applied expanded class", boundIcon.ClassName.Contains("rotate-12 scale-110"));
        Check("Expanded CollapseItem mounts header + content", section.ChildCount() == 2);

        section.SetExpanded(false);
        win.CaptureSnapshot();
        Check("Ancestor binding updated collapsed class", boundIcon.ClassName.Contains("rotate-0 scale-100"));
        Check("Collapsed CollapseItem hides content node", section.ChildCount() == 1);

        // 校验双向绑定（Model <-> Target Control）
        Check("TwoWay Input initial sync from DataContext", nameInput.GetText() == "张三");
        Check("TwoWay Switch initial sync from DataContext", onlineSwitch.IsOn() == true);
        Check("OneWay status label initial sync", statusLabel.Text.Get() == "状态:在线");

        // UI -> Model 回写验证
        nameInput.SetText("李四");
        onlineSwitch.SetOn(false);
        onlineSwitch.TriggerEvent("Change");
        win.CaptureSnapshot();
        Check("TwoWay Input pushed new text to model", editUser.name == "李四");
        Check("TwoWay Switch pushed false to model", editUser.online == false);
        Check("Sibling status label reacted to Switch two-way change", statusLabel.Text.Get() == "状态:离线");

        // Model -> UI 反向同步验证
        editUser.name = "赵六";
        editUser.online = true;
        win.CaptureSnapshot();
        Check("TwoWay Input synced model mutation", nameInput.GetText() == "赵六");
        Check("TwoWay Switch synced model mutation", onlineSwitch.IsOn() == true);
        Check("Sibling status label synced model mutation", statusLabel.Text.Get() == "状态:在线");

        // 校验 ListView 内嵌 CollapseItem 动态展开高度重算
        int collapsedListH = nestedList.ContentHeightForTest();
        CollapseItem row0Panel = (CollapseItem)nestedList.RowControl(0);
        Check("ListView mounted nested CollapseItem row", row0Panel != null);
        row0Panel.SetExpanded(true);
        win.CaptureSnapshot();
        int expandedListH = nestedList.ContentHeightForTest();
        Check("Nested CollapseItem expansion grew ListView content height", expandedListH > collapsedListH);

        // 校验 DataGrid<T> 声明式 Template 列挂载与格内双向绑定联动
        Check("DataGrid template column mounted row0 controls", row0SwitchRef != null && row0StatusRef != null);
        Check("DataGrid cell Switch initial state is true", row0SwitchRef.IsOn() == true);
        Check("DataGrid cell TextBlock initial text is 在线", row0StatusRef.Text.Get() == "在线");

        // 格内 Switch 切换 -> 自动回写 users[0].online 并刷新同格 TextBlock
        row0SwitchRef.SetOn(false);
        row0SwitchRef.TriggerEvent("Change");
        win.CaptureSnapshot();
        Check("DataGrid cell Switch two-way updated users[0].online", users[0].online == false);
        Check("DataGrid cell sibling TextBlock updated to 离线", row0StatusRef.Text.Get() == "离线");

        // 外部修改 users[0].online -> 自动同步回 DataGrid 单元格内的 Switch 与 TextBlock
        users[0].online = true;
        win.CaptureSnapshot();
        Check("DataGrid cell Switch synced external model mutation", row0SwitchRef.IsOn() == true);
        Check("DataGrid cell TextBlock synced external model mutation", row0StatusRef.Text.Get() == "在线");

        // 7. 验证 HTML+CSS 流布局模式与代码树模式共享同一套控件树与排版引擎
        HtmlDoc htmlDoc = Html.Parse("<div class='column gap-small'><ui-collapse-panel title='HTML折叠面板' expanded='true'><view class='row gap-small'><text-block>流式内容</text-block></view></ui-collapse-panel></div>", "", null);
        Check("HTML+CSS flow layout parsed ui-collapse-panel tree", htmlDoc != null && htmlDoc.root != null && htmlDoc.root.ChildCount() == 1);

        if (fails == 0) {
            Console.WriteLine("ALL TESTS PASSED: Two-way binding, deep component nesting, DataGrid template columns & dual-mode layout verified.");
        } else {
            Console.WriteLine("TOTAL FAILS: " + fails);
            Environment.Exit(1);
        }
    }
}
