using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

class MockUser {
    public string name;
    public string role;
    public bool online;

    MockUser(string n, string r, bool o) {
        this.name = n;
        this.role = r;
        this.online = o;
    }
}

class GuiDeclarativeLayoutSlotTest {
    static int fails;

    static void Check(string label, bool ok) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL: " + label);
    }

    static void Main() {
        Form win = Form.CreateOffscreen("DeclarativeUiWindow", 800, 600);

        // 1. 验证现代排版原语（Row, Column, Spacer, Center）与声明式流畅 API
        Label title = Label.Of("用户管理系统").Title().Bold().Primary();
        Check("Label Bold has strong class", title.HasClass("strong"));
        Check("Label Primary has primary class", title.HasClass("primary"));

        Button addBtn = new Button("新增用户");
        Spacer spacer = Spacer.Create();
        Check("Spacer is growable", spacer.grow);

        Row headerRow = Row.Create()
            .Gap(12)
            .Align("center")
            .Child(title)
            .Child(spacer)
            .Child(addBtn);

        Check("Row children count is 3", headerRow.children.Count == 3);

        Center centerBox = Center.Of(Label.Of("居中文本").Muted());
        Check("Center has 1 child", centerBox.children.Count == 1);
        Check("Center is growable", centerBox.grow);

        // 2. 验证 ListView 声明式多列与组件插槽机制（SlotColumn）
        List<MockUser> users = new List<MockUser>();
        users.Add(new MockUser("Alice", "Admin", true));
        users.Add(new MockUser("Bob", "Developer", false));

        bool editClicked = false;

        ListView<MockUser> table = new ListView<MockUser>()
            .Column("姓名", u => u.name)
            .Column("角色", u => u.role)
            .SlotColumn("状态", u => u.online ? Label.Of("在线").Success() : Label.Of("离线").Muted())
            .SlotColumn("操作", u => {
                Button btn = new Button("编辑");
                btn.OnClick(() => { editClicked = true; });
                return btn;
            });

        table.Bind(users);

        Check("ListView recognizes slot columns as templated", table.Templated());

        // 3. 组合进入主页面容器，验证整个声明式界面的离线挂载与测量
        Column page = Column.Create()
            .Gap(16)
            .Child(headerRow)
            .Child(centerBox)
            .Child(table);

        win.Add(page);

        // 触发布局与绘制快照
        Canvas snapshot = win.CaptureSnapshot();
        Check("snapshot not null", snapshot != null);

        // 验证经过一次绘制后，ListView 自动将插槽列合成为行控件树
        Check("ListView generated rows for items", table.children.Count == 2);
        if (table.children.Count == 2) {
            Control firstRow = table.children[0];
            Check("Generated row is Row control", firstRow.Kind() == "Flex" || firstRow is Row);
            Check("Generated row has 4 column cells", firstRow.children.Count == 4);
        }

        if (fails == 0) {
            Console.WriteLine("ALL TESTS PASSED: Declarative layout primitives & slot columns verified.");
        } else {
            Console.WriteLine("TOTAL FAILS: " + fails);
            Environment.Exit(1);
        }
    }
}
