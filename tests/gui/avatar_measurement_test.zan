using System;
using Gui;
using Gui.Widget;

class AvatarMeasurementTest {
    static int failures;

    static void Eq(string name, int actual, int expected) {
        if (actual == expected) { return; }
        failures = failures + 1;
        Console.WriteLine("FAIL " + name + ": " + Convert.ToString(actual)
            + " != " + Convert.ToString(expected));
    }

    static void Square(App app, Avatar avatar, int expected, string name) {
        Control row = new Control();
        row.SetProp("style", "display:flex;flex-direction:row;align-items:center");
        avatar.SetProp("style", "flex-shrink:0");
        row.Add(avatar);
        Label beside = new Label("project");
        beside.SetProp("style", "flex:1;min-width:0");
        row.Add(beside);
        row.MeasureTree(app);
        Eq(name + " preferred width", avatar.prefW, expected);
        Eq(name + " preferred height", avatar.prefH, expected);
        row.Arrange(0, 0, app.Scale(240), app.Scale(80));
        Eq(name + " arranged width", avatar.bw, expected);
        Eq(name + " arranged height", avatar.bh, expected);
        Control content = avatar.ChildAt(0);
        int centerX = (content.bx * 2 + content.bw) - (avatar.bx * 2 + avatar.bw);
        int centerY = (content.by * 2 + content.bh) - (avatar.by * 2 + avatar.bh);
        if (centerX < 0) { centerX = 0 - centerX; }
        if (centerY < 0) { centerY = 0 - centerY; }
        Eq(name + " content centered horizontally", centerX <= 2 ? 1 : 0, 1);
        Eq(name + " content centered vertically", centerY <= 2 ? 1 : 0, 1);
        Eq(name + " content contained horizontally",
            content.bx >= avatar.bx && content.bx + content.bw <= avatar.bx + avatar.bw ? 1 : 0, 1);
        Eq(name + " content contained vertically",
            content.by >= avatar.by && content.by + content.bh <= avatar.by + avatar.bh ? 1 : 0, 1);
    }

    static void Main() {
        App app = App.CreateOffscreen("Avatar measurement", 400, 200);
        Square(app, new Avatar("g"), app.Scale(32), "short initial");
        Square(app, new Avatar("many initials"), app.Scale(32), "long initial");
        Avatar sized = new Avatar("g");
        sized.Size = 48;
        Square(app, sized, app.Scale(48), "Size property");
        Square(app, new Avatar("g", 40), app.Scale(40), "numeric constructor size");

        Avatar width = new Avatar("g");
        width.Prefer(app.Scale(52), 0);
        width.MeasureTree(app);
        Eq("explicit width retained", width.prefW, app.Scale(52));
        Eq("unspecified height uses diameter", width.prefH, app.Scale(32));
        Avatar height = new Avatar("g");
        height.Prefer(0, app.Scale(44));
        height.MeasureTree(app);
        Eq("unspecified width uses diameter", height.prefW, app.Scale(32));
        Eq("explicit height retained", height.prefH, app.Scale(44));
        app.canvas.Destroy();
        if (failures != 0) { throw new Exception("Avatar measurement failures: " + Convert.ToString(failures)); }
        Console.WriteLine("avatar measurement OK");
    }
}
