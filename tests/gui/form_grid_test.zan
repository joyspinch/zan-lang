// 设计稿 DataGrid 字段的运行期投影契约：fields 里的 DataGrid 节点经
// FormBuilder 建为真实控件（需先 DataTableBootstrap.Install 注册工厂），
// data-x-columns 压成列头预览串（previewColumns）并回填列元数据
// （gcols，B-ID43），data-x-props 直通控件属性；Bind/Count 走
// DataGrid<T> 门面，行工厂（CanInsert/InsertRow）与列隐藏（HideCol/
// State）经 source 生效。类型化单元格读写（CellText/SetCell 回写行
// 对象）仍未通——运行期投影还没有 "of" 实体的字段访问通道（B-ID45），
// 通了以后本用例随之补齐。
using System;
using System.IO;
using System.Web;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;

class GridRow {
    string name;
    int clicks;
    double spend;
    bool active;

    GridRow() {
        name = "";
        clicks = 0;
        spend = 0.0;
        active = false;
    }
}

class FormGridTest {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" +
                          want + "'");
    }

    static void Main() {
        fails = 0;
        DataTableBootstrap.Install();
        string html = File.ReadAllText("tests/gui/form_grid.html");
        Control root = FormBuilder.Build(
            JsonValue.ParseLenient(DesignerHtml.ToJsonDoc(html)));

        Control gc = root.Find("Grid");
        if (gc == null) {
            Console.WriteLine("FAIL DataGrid field not projected");
            fails = fails + 1;
            return;
        }
        Eq("kind", gc.Kind(), "DataGrid");
        DataGrid<GridRow> g = (DataGrid<GridRow>)gc;

        Eq("columns", g.GetProp("previewColumns"),
                         "220,名称|80,点击|100,花费|70,在投");
        Eq("gcols", Convert.ToString(g.gcols.Count), "4");
        Eq("striped", g.GetProp("striped"), "true");
        Eq("rowHeight", g.GetProp("rowHeight"), "22");
        Eq("summary", g.GetProp("summary"), "true");
        Eq("allowAddRow", g.GetProp("allowAddRow"), "true");

        List<GridRow> rows = new List<GridRow>();
        GridRow a = new GridRow();
        a.name = "计划A";
        a.clicks = 3;
        a.spend = 12.5;
        a.active = true;
        rows.Add(a);
        GridRow b = new GridRow();
        b.name = "计划B";
        b.clicks = 4;
        rows.Add(b);
        g.Bind(rows);
        Eq("count", Convert.ToString(g.Count()), "2");

        // 行工厂回填（B-ID43）：CanInsert → InsertRow 真插行。
        GridSource<GridRow> src = g.source;
        if (src == null) {
            Console.WriteLine("FAIL DataGrid has no source");
            fails = fails + 1;
        } else {
            if (!src.CanInsert()) {
                Console.WriteLine("FAIL rowFactory did not reach the source");
                fails = fails + 1;
            }
            src.InsertRow(2);
            Eq("insert", Convert.ToString(rows.Count), "3");
        }

        // 列隐藏经 source 列元数据生效（HideCol → State().colHidden）。
        g.HideCol("clicks", true);
        if (!g.State().colHidden[1]) {
            Console.WriteLine("FAIL HideCol did not hide the clicks column");
            fails = fails + 1;
        }
        g.HideCol("clicks", false);
        if (g.State().colHidden[1]) {
            Console.WriteLine("FAIL HideCol did not restore the clicks column");
            fails = fails + 1;
        }
        g.HideCol("missing", true);

        if (fails == 0) { Console.WriteLine("FORM_GRID_OK"); }
    }
}
