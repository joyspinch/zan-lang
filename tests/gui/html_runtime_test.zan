// 运行期 HTML 文档（非设计稿）装载用例：夹具经 --embed 烤进 exe、
// Html.Load 装载——:visible → visible 单向值声明、data-for → Element SetAttr
// （与 Html.Parse 同语义），宿主挂模型验证展开/插拔/回写。
using System;
using System.IO;
using System.Json;
using Gui;
using Gui.Widget;

class RuntimeDocWin : ChildWindow {
    public void Attach(App app, Control tree, object model) {
        host = app;
        open = true;
        this.SetView(tree, model);
    }
}

class GenHtmlProbe {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    // 布尔转字符串的字面量口径在 "1"/"0" 与 "true"/"false" 之间变过
    // ——断言只认真假，不认字面量。
    static string Vis(bool v) { return v ? "1" : "0"; }

    static ModelBindingDeclaration FindBinding(Control c, string property) {
        for (int i = 0; i < c.BindingCount; i = i + 1) {
            ModelBindingDeclaration binding = c.BindingAt(i);
            if (binding.Property == property) { return binding; }
        }
        throw new Exception("missing binding property " + property);
    }

    static void Main() {
        fails = 0;
        // 模板行展开经 App 克隆槽（Gui.Html.Install 注册）：App 编译图
        // 不背 HTML 声明层，用 template data-for 的宿主必须先装；行内
        // 控件克隆走 ControlFactory kind 重建，ControlBootstrap.Install
        // 同样要装（先注册后可用）。
        Html.Install();
        Form f = Form.Create("runtime-doc", 400, 300);
        App app = f.GetApp();
        string doc = File.ReadAllText("tests/gui/html_runtime.html");
        Control rootT = Html.Load(app, doc, null, "");
        if (rootT == null) { Console.WriteLine("FAIL: html loader missing"); return; }
        GenHtmlProbe.Eq("root kind", rootT.Kind(), "body");
        Control div = rootT.ChildAt(0);
        GenHtmlProbe.Eq("div kind", div.Kind(), "div");

        // 模板节点 + data-for parity（编译通道 SetAttr 落属性表）。
        Control tpl = div.ChildAt(0);
        GenHtmlProbe.Eq("tpl kind", tpl.Kind(), "template");
        GenHtmlProbe.Eq("tpl for", tpl.CssAttr("data-for"), "items");

        // :visible 落 Property=visible 的单向值声明（Input 控件）。
        Control title = div.ChildAt(1);
        ModelBindingDeclaration titleVisible = FindBinding(title, "visible");
        GenHtmlProbe.Eq("title binding count", Convert.ToString(title.BindingCount), "2");
        GenHtmlProbe.Eq("title visible binding path", titleVisible.Path, "showTitle");
        GenHtmlProbe.Eq("title visible binding property", titleVisible.Property, "visible");
        GenHtmlProbe.Eq("title visible binding direction", Vis(titleVisible.TwoWay), "0");

        JsonValue model = JsonValue.Parse(
            "{\"showTitle\":true,\"showUser\":true,\"showInput\":true,\"title\":\"hello\","
            + "\"user\":{\"name\":\"Zan\"},\"items\":[{\"name\":\"a\"},{\"name\":\"b\"}]}");
        RuntimeDocWin w = new RuntimeDocWin();
        w.Attach(app, rootT, model);

        // 展开 + 行内作用域推送。
        GenHtmlProbe.Eq("div kids", Convert.ToString(div.ChildCount()), "4");
        Control row0 = div.ChildAt(1);
        GenHtmlProbe.Eq("row0 kind", row0.Kind(), "li");
        GenHtmlProbe.Eq("row0 name", row0.ChildAt(0).GetProp("text"), "a");
        GenHtmlProbe.Eq("row1 name", div.ChildAt(2).ChildAt(0).GetProp("text"), "b");

        // 插拔（外部改模型必须显式标脏：B-ID149⑤ 脏跳过只认
        // App 同步 / 事件处理器收尾，不认 JsonValue 原地变异）。
        GenHtmlProbe.Eq("title visible", Vis(title.visible), "1");
        model.PathSet("showTitle", "false");
        app.SyncModelHosts();
        GenHtmlProbe.Eq("title hidden", Vis(title.visible), "0");

        // 收缩 + 回写。
        JsonValue items2 = JsonValue.Parse("[{\"name\":\"a\"}]");
        model.PathSetValue("items", items2);
        app.SyncModelHosts();
        GenHtmlProbe.Eq("div kids after shrink",
                        Convert.ToString(div.ChildCount()), "3");
        div.ChildAt(1).ChildAt(0).SetProp("text", "z");
        app.WriteBackModelHosts();
        JsonValue back = model.Get("items");
        JsonValue back0 = back == null ? null : back.At(0);
        JsonValue backn = back0 == null ? null : back0.Get("name");
        GenHtmlProbe.Eq("model items[0].name",
                        backn == null ? "?" : backn.AsString(""), "z");

        // data-arg 编译通道：EmitDecl 落 handlerArg 字段、EmitWiring
        // 发射 WireArg。宿主两条路都验——Build(null) + ChildWindow
        // 二次解析；Build(handlers) 生成码即时接线。
        Control argDiv = rootT.ChildAt(1);
        Control ok = argDiv.ChildAt(0);
        GenHtmlProbe.Eq("ok handlerArg", ok.handlerArg, "apple");
        string got = "";
        w.HandleArg("save", (string s) => { got = s; });
        w.SetView(rootT, model);
        ((Button)ok).Click.Raise();
        GenHtmlProbe.Eq("host wired arg", got, "apple");

        // 现代声明式值绑定、可见性与事件断言：
        // bind / :visible -> BindingAt 中的双向/单向值声明。
        Control uName = argDiv.ChildAt(1);
        GenHtmlProbe.Eq("userName binding count", Convert.ToString(uName.BindingCount), "2");
        ModelBindingDeclaration userNameValue = FindBinding(uName, "");
        GenHtmlProbe.Eq("userName binding path", userNameValue.Path, "user.name");
        GenHtmlProbe.Eq("userName binding property", userNameValue.Property, "");
        GenHtmlProbe.Eq("userName binding direction", Vis(userNameValue.TwoWay), "1");
        ModelBindingDeclaration userNameVisible = FindBinding(uName, "visible");
        GenHtmlProbe.Eq("userName visible binding path", userNameVisible.Path, "showUser");
        GenHtmlProbe.Eq("userName visible binding property", userNameVisible.Property, "visible");
        GenHtmlProbe.Eq("userName visible binding direction", Vis(userNameVisible.TwoWay), "0");

        Control btnDbl = argDiv.ChildAt(2);
        GenHtmlProbe.Eq("btnDbl dblclick handler", btnDbl.GetHandler("DoubleClick"), "onDblSave");

        Control inpChange = argDiv.ChildAt(3);
        GenHtmlProbe.Eq("inputChange change handler", inpChange.GetHandler("Change"), "onNameChange");
        GenHtmlProbe.Eq("inputChange binding count", Convert.ToString(inpChange.BindingCount), "1");
        ModelBindingDeclaration inputVisible = FindBinding(inpChange, "visible");
        GenHtmlProbe.Eq("inputChange visible binding path", inputVisible.Path, "showInput");
        GenHtmlProbe.Eq("inputChange visible binding property", inputVisible.Property, "visible");
        GenHtmlProbe.Eq("inputChange visible binding direction", Vis(inputVisible.TwoWay), "0");

        // <select><option> 运行时通道映射 SelectBox（options 文本 +
        // selected 下标；无 selected 显示首项），与设计稿通道
        // （DesignerHtml 折叠规则）同形。
        HtmlDoc selDoc = Html.Parse(
            "<select id=\"city\"><option>北京</option>"
            + "<option selected>上海</option><option>广州</option></select>",
            "", null);
        Control selBox = selDoc.root.ChildAt(0);
        GenHtmlProbe.Eq("select kind", selBox.Kind(), "SelectBox");
        GenHtmlProbe.Eq("select options", selBox.GetProp("options"),
                        "北京|上海|广州");
        GenHtmlProbe.Eq("select selected",
                        Convert.ToString(((SelectBox)selBox).Selected()), "1");
        GenHtmlProbe.Eq("select name", selBox.name, "city");
        HtmlDoc selDef = Html.Parse(
            "<select><option>a</option><option>b</option></select>", "", null);
        GenHtmlProbe.Eq("select default first",
                        Convert.ToString(((SelectBox)selDef.root.ChildAt(0))
                                             .Selected()), "0");

        // 未知事件后缀与未注册名字的警告通道：两类“点了没反应”
        // 都在装载期打一行 HTML_WIRE_WARN（金样断言输出）。
        HtmlDoc warnDoc = Html.Parse(
            "<button data-on-clic=\"save\">Go</button>"
            + "<button data-on-click=\"nosuch\">Del</button>", "", null);
        HtmlHandlers reg = new HtmlHandlers();
        reg.Add("save", () => { });
        Html.Parse("<button data-on-click=\"nosuch\">X</button>", "", reg);

        HtmlHandlers hs = new HtmlHandlers();
        string got2 = "";
        bool dblCalled = false;
        bool changeCalled = false;
        hs.AddArg("save", (string s) => { got2 = s; });
        hs.Add("onDblSave", () => { dblCalled = true; });
        hs.Add("onNameChange", () => { changeCalled = true; });
        Control root2 = Html.Load(app, doc, hs, "");
        if (root2 == null) { Console.WriteLine("FAIL: html loader missing"); return; }
        Control ok2 = root2.ChildAt(1).ChildAt(0);
        ((Button)ok2).Click.Raise();
        GenHtmlProbe.Eq("build(handlers) arg", got2, "apple");

        Button btnDbl2 = (Button)root2.ChildAt(1).ChildAt(2);
        btnDbl2.On.DoubleClick.Raise();
        GenHtmlProbe.Eq("dblclick raised", Vis(dblCalled), "1");

        Input inpChange2 = (Input)root2.ChildAt(1).ChildAt(3);
        inpChange2.Change.Raise();
        GenHtmlProbe.Eq("change raised", Vis(changeCalled), "1");

        if (fails == 0) { Console.WriteLine("GUI_HTML_RUNTIME_OK"); }
    }
}
