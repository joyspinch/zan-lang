// WEB_GUI_ROADMAP P8 用例：运行期 HTML 文档（非设计稿）经 GenHtml
// 编译期生成建树类：data-if → bindIf、data-for → Element
// SetAttr（与运行时 Html.Parse 同语义），宿主挂模型验证展开/
// 插拔/回写与动态装载通道一致。
using System;
using System.Json;
using Gui;
using Gui.Widget;

class RuntimeDocWin : ChildWindow {
}

class GenHtmlProbe {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void Main() {
        fails = 0;
        // 模板行展开经 App 克隆槽（Gui.Html.Install 注册）：App 编译图
        // 不背 HTML 声明层，用 template data-for 的宿主必须先装；行内
        // 控件克隆走 ControlFactory kind 重建，ControlBootstrap.Install
        // 同样要装（先注册后可用）。
        Html.Install();
        ControlBootstrap.Install();
        Control rootT = HtmlRuntimeHtml.Build(null);
        GenHtmlProbe.Eq("root kind", rootT.Kind(), "body");
        Control div = rootT.children[0];
        GenHtmlProbe.Eq("div kind", div.Kind(), "div");

        // 模板节点 + data-for parity（编译通道 SetAttr 落属性表）。
        Control tpl = div.children[0];
        GenHtmlProbe.Eq("tpl kind", tpl.Kind(), "template");
        GenHtmlProbe.Eq("tpl for", tpl.CssAttr("data-for"), "items");

        // data-if 落 bindIf（Input 控件）。
        Control title = div.children[1];
        GenHtmlProbe.Eq("title bindIf", title.bindIf, "showTitle");

        JsonValue model = JsonValue.Parse(
            "{\"showTitle\":true,\"title\":\"hello\","
            + "\"items\":[{\"name\":\"a\"},{\"name\":\"b\"}]}");
        RuntimeDocWin w = new RuntimeDocWin();
        w.SetRoot(rootT, model);
        w.Wire();

        // 展开 + 行内作用域推送。
        GenHtmlProbe.Eq("div kids", Convert.ToString(div.ChildCount()), "4");
        Control row0 = div.children[1];
        GenHtmlProbe.Eq("row0 kind", row0.Kind(), "li");
        GenHtmlProbe.Eq("row0 name", row0.children[0].GetProp("text"), "a");
        GenHtmlProbe.Eq("row1 name", div.children[2].children[0].GetProp("text"), "b");

        // 插拔。
        GenHtmlProbe.Eq("title visible", Convert.ToString(title.visible), "1");
        model.PathSet("showTitle", "false");
        w.SyncFromModel();
        GenHtmlProbe.Eq("title hidden", Convert.ToString(title.visible), "0");

        // 收缩 + 回写。
        JsonValue items2 = JsonValue.Parse("[{\"name\":\"a\"}]");
        model.PathSetValue("items", items2);
        w.SyncFromModel();
        GenHtmlProbe.Eq("div kids after shrink",
                        Convert.ToString(div.ChildCount()), "3");
        div.children[1].children[0].SetProp("text", "z");
        w.SyncChangedNode(rootT);
        JsonValue back = model.Get("items");
        JsonValue back0 = back == null ? null : back.At(0);
        JsonValue backn = back0 == null ? null : back0.Get("name");
        GenHtmlProbe.Eq("model items[0].name",
                        backn == null ? "?" : backn.AsString(""), "z");

        // data-arg 编译通道：EmitDecl 落 handlerArg 字段、EmitWiring
        // 发射 WireArg。宿主两条路都验——Build(null) + ChildWindow
        // 二次解析；Build(handlers) 生成码即时接线。
        Control argDiv = rootT.children[1];
        Control ok = argDiv.children[0];
        GenHtmlProbe.Eq("ok handlerArg", ok.handlerArg, "apple");
        string got = "";
        w.HandleArg("save", (string s) => { got = s; });
        w.Wire();
        ((Button)ok).Click.Raise();
        GenHtmlProbe.Eq("host wired arg", got, "apple");

        // <select><option> 运行时通道映射 SelectBox（options 文本 +
        // selected 下标；无 selected 显示首项），与设计稿通道
        // （DesignerHtml 折叠规则）同形。
        HtmlDoc selDoc = Html.Parse(
            "<select id=\"city\"><option>北京</option>"
            + "<option selected>上海</option><option>广州</option></select>",
            "", null);
        Control selBox = selDoc.root.children[0];
        GenHtmlProbe.Eq("select kind", selBox.Kind(), "Select");
        GenHtmlProbe.Eq("select options", selBox.GetProp("options"),
                        "北京|上海|广州");
        GenHtmlProbe.Eq("select selected",
                        Convert.ToString(((SelectBox)selBox).Selected()), "1");
        GenHtmlProbe.Eq("select name", selBox.name, "city");
        HtmlDoc selDef = Html.Parse(
            "<select><option>a</option><option>b</option></select>", "", null);
        GenHtmlProbe.Eq("select default first",
                        Convert.ToString(((SelectBox)selDef.root.children[0])
                                             .Selected()), "0");

        // 未知事件后缀与未注册名字的警告通道：两类“点了没反应”
        // 都在装载期打一行 HTML_WIRE_WARN（金样断言输出）。
        HtmlDoc warnDoc = Html.Parse(
            "<button data-on-clic=\"save\">Go</button>"
            + "<button data-on-click=\"nosuch\">Del</button>", "", null);
        HtmlHandlers reg = new HtmlHandlers();
        reg.Add("save", () => { });
        Html.Parse("<button data-on-click=\"nosuch\">X</button>", "", reg);

        HtmlHandlers hs = new HtmlHandlers();
        string got2 = "";
        hs.AddArg("save", (string s) => { got2 = s; });
        Control root2 = HtmlRuntimeHtml.Build(hs);
        Control ok2 = root2.children[1].children[0];
        ((Button)ok2).Click.Raise();
        GenHtmlProbe.Eq("build(handlers) arg", got2, "apple");

        if (fails == 0) { Console.WriteLine("GUI_HTML_RUNTIME_OK"); }
    }
}
