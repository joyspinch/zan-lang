using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

class GuiCompositeCardButtonTest {
    static int fails;

    static void Check(string label, bool ok) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL: " + label);
    }

    static void Main() {
        Form win = Form.CreateOffscreen("CardButtonCompositeWindow", 800, 600);

        // 1. 测试复合 Button：免自绘，在按钮内自由塞入 Row、图标与加粗文本
        Label rocketIcon = new Label("🚀");
        Label btnText = new Label("立即部署") { ClassName = "strong" };
        Row btnContent = new Row {
            Gap = 6,
            Children = [ rocketIcon, btnText ]
        };

        Button compBtn = new Button(btnContent) { ClassName = "primary" };
        Check("Button has 1 composite child", compBtn.ChildCount() == 1);
        Check("Button child is Row", compBtn.ChildAt(0) == btnContent);
        Check("Button has primary class", compBtn.HasClass("primary"));

        // 2. 测试声明式 Card（对齐 Naive UI n-card）：包含 Header 与 CardActions 底部插槽
        Button refreshBtn = new Button("刷新") { ClassName = "ghost small" };
        Column cardBody = new Column {
            Gap = 8,
            Children = [
                new Label("在线节点: 12 / 12") { ClassName = "success" },
                new Label("负载均值: 0.45") { ClassName = "secondary" }
            ]
        };
        Button resetBtn = new Button("重置配置") { ClassName = "small" };
        Button applyBtn = new Button("应用变更") { ClassName = "primary small" };
        Card card = new Card("集群节点状态") {
            Header = refreshBtn,
            Body = cardBody,
            CardActions = new List<Control> { resetBtn, applyBtn }
        };

        // 3. 将整个复合结构挂载进离线窗口进行排版测量与快照渲染
        Column page = new Column {
            Gap = 20,
            Children = [ compBtn, card ]
        };
        win.Add(page);

        Canvas snapshot = win.CaptureSnapshot();
        Check("snapshot not null", snapshot != null);

        // 验证 Card 内各插槽已自动排列到对应几何位置（0 像素手算）
        Check("Card attached to form", card.FindForm() == win);
        Check("HeaderExtra attached and arranged", refreshBtn.bx > card.bx);
        Check("Actions attached and arranged at bottom", applyBtn.by > cardBody.by);

        if (fails == 0) {
            Console.WriteLine("ALL TESTS PASSED: Composite Button & Card slots verified.");
        } else {
            Console.WriteLine("TOTAL FAILS: " + fails);
            Environment.Exit(1);
        }
    }
}
