using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

class GuiCompositeCardButtonTest {
    static int fails;

    static void Check(string label, bool ok) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL: " + label);
    }

    static void Main() {
        Form win = Form.CreateOffscreen("CardButtonCompositeWindow", 800, 600);

        // 1. 测试复合 Button：免自绘，在按钮内自由塞入 Row、图标与加粗文本
        Label rocketIcon = Label.Of("🚀");
        Label btnText = Label.Of("立即部署").Bold();
        Row btnContent = Row.Create().Gap(6).Child(rocketIcon).Child(btnText);

        Button compBtn = Button.Of(btnContent).Primary();
        Check("Button has 1 composite child", compBtn.children.Count == 1);
        Check("Button child is Row", compBtn.children[0] == btnContent);
        Check("Button has primary class", compBtn.HasClass("primary"));

        // 2. 测试声明式 Card（对齐 Naive UI n-card）：包含 HeaderExtra 与 Actions 底部插槽
        Card card = new Card("集群节点状态");
        Button refreshBtn = new Button("刷新").Small().Ghost();
        card.HeaderExtra(refreshBtn);

        Column cardBody = Column.Create()
            .Gap(8)
            .Child(Label.Of("在线节点: 12 / 12").Success())
            .Child(Label.Of("负载均值: 0.45").Muted());
        card.Content(cardBody);

        Button resetBtn = new Button("重置配置").Small();
        Button applyBtn = new Button("应用变更").Small().Primary();
        card.Actions(new List<Control> { resetBtn, applyBtn });

        // 3. 将整个复合结构挂载进离线窗口进行排版测量与快照渲染
        Column page = Column.Create().Gap(20).Child(compBtn).Child(card);
        win.Add(page);

        Canvas snapshot = win.CaptureSnapshot();
        Check("snapshot not null", snapshot != null);

        // 验证 Card 内各插槽已自动排列到对应几何位置（0 像素手算）
        Check("Card attached to form", card.FindForm() == win);
        Check("HeaderExtra attached and arranged", refreshBtn.bx > card.bx);
        Check("Actions attached and arranged at bottom", applyBtn.by > cardBody.by);

        if (fails == 0) {
            Console.WriteLine("ALL TESTS PASSED: Composite Button & Card slots verified.");
        } else {
            Console.WriteLine("TOTAL FAILS: " + fails);
            Environment.Exit(1);
        }
    }
}
