using System;
using Gui;
using Gui.Widget;
using Gui.Component.Chart;

// 无窗口：声明式属性与代码 SetProp 必须到达同一控件属性协议。
class HtmlPropsEquivalenceTest {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static Control One(string html) {
        HtmlDoc doc = Html.Parse(html, "", null);
        return doc.root.ChildAt(0);
    }

    static void Same(string what, Control html, Control code, string key, string want) {
        HtmlPropsEquivalenceTest.Eq(what + " kind", html.Kind(), code.Kind());
        HtmlPropsEquivalenceTest.Eq(what + " code", code.GetProp(key), want);
        HtmlPropsEquivalenceTest.Eq(what + " html", html.GetProp(key), code.GetProp(key));
    }

    static void Charts() {
        // HTML 和代码共用 ChartHost 发布的属性协议，不能另建属性白名单。
        ChartHost.Install();
        ChartHost code = new ChartHost();
        code.SetProp("type", "pie");
        code.SetProp("title", "Traffic");
        Control chart = HtmlPropsEquivalenceTest.One("<chart type='pie' title='Traffic'></chart>");
        HtmlPropsEquivalenceTest.Same("chart type", chart, code, "type", "pie");
        HtmlPropsEquivalenceTest.Same("chart title", chart, code, "title", "Traffic");
        ChartOption option = ((ChartHost)chart).GetOption();
        HtmlPropsEquivalenceTest.Eq("chart option title", option.title, "Traffic");

        Control alias = HtmlPropsEquivalenceTest.One("<zan-chart type='pie' title='Traffic'></zan-chart>");
        HtmlPropsEquivalenceTest.Same("zan-chart type", alias, code, "type", "pie");
        HtmlPropsEquivalenceTest.Same("zan-chart title", alias, code, "title", "Traffic");
        Control host = HtmlPropsEquivalenceTest.One("<zan-chart-host type='pie' title='Traffic'></zan-chart-host>");
        HtmlPropsEquivalenceTest.Same("zan-chart-host type", host, code, "type", "pie");
        HtmlPropsEquivalenceTest.Same("zan-chart-host title", host, code, "title", "Traffic");

        // type 的小写化仅供 <input> 分派；组件属性值保留原文。
        ChartHost mixedCode = new ChartHost();
        mixedCode.SetProp("type", "wordCloud");
        Control mixed = HtmlPropsEquivalenceTest.One("<chart type='wordCloud'></chart>");
        HtmlPropsEquivalenceTest.Same("chart mixed-case type", mixed, mixedCode, "type", "wordCloud");
    }

    static void Check(string what, bool ok) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void ChartPropertyOrder() {
        ChartHost code = new ChartHost();
        code.SetProp("title", "Traffic");
        code.SetProp("type", "pie");
        Control reverse = HtmlPropsEquivalenceTest.One("<chart title='Traffic' type='pie'></chart>");
        HtmlPropsEquivalenceTest.Same("reverse chart type", reverse, code, "type", "pie");
        HtmlPropsEquivalenceTest.Same("reverse chart title", reverse, code, "title", "Traffic");
        HtmlPropsEquivalenceTest.Eq("reverse option title", ((ChartHost)reverse).GetOption().title, "Traffic");

        ChartOption pie = code.GetOption();
        pie.series[0].data[0].val = 123;
        code.SetProp("type", "pie");
        HtmlPropsEquivalenceTest.Check("repeated type retains option and data",
            code.GetOption() == pie && code.GetOption().series[0].data[0].val == 123);
        HtmlPropsEquivalenceTest.Eq("repeated type retains title", code.GetProp("title"), "Traffic");
        code.SetChartType("line");
        HtmlPropsEquivalenceTest.Check("different type rebuilds series",
            code.GetOption() != pie && code.GetOption().series[0].type == ChartType.Line);
        HtmlPropsEquivalenceTest.Eq("different type retains title", code.GetOption().title, "Traffic");
        code.SetProp("title", "Updated");
        code.SetProp("type", "bar");
        HtmlPropsEquivalenceTest.Eq("latest title survives property switch", code.GetProp("title"), "Updated");
        ChartOption bar = code.GetOption();
        code.SetProp("type", "");
        code.SetChartType(null);
        HtmlPropsEquivalenceTest.Check("default type replay retains option", code.GetOption() == bar);
        HtmlPropsEquivalenceTest.Eq("default type normalized", code.GetProp("type"), "bar");
    }

    static void ChartMetadata() {
        ChartHost chart = new ChartHost();
        List<PropSpec> specs = chart.Props();
        HtmlPropsEquivalenceTest.Check("chart metadata complete", specs.Count == 3);
        PropSpec type = PropSpec.Find(specs, "type", true);
        PropSpec title = PropSpec.Find(specs, "title", true);
        PropSpec toolbox = PropSpec.Find(specs, "widgetToolbox", true);
        HtmlPropsEquivalenceTest.Check("chart metadata bound", type != null && title != null && toolbox != null);
        if (type == null || title == null || toolbox == null) { return; }
        HtmlPropsEquivalenceTest.Check("chart metadata editor kinds",
            type.kind == PropKind.Enum && title.kind == PropKind.Text && toolbox.kind == PropKind.Bool);
        HtmlPropsEquivalenceTest.Check("chart metadata value kinds",
            type.ValueKind() == PropValueKind.Text && title.ValueKind() == PropValueKind.Text && toolbox.ValueKind() == PropValueKind.Bool);
        HtmlPropsEquivalenceTest.Check("chart metadata defaults present",
            type.HasDefault() && title.HasDefault() && toolbox.HasDefault());
        HtmlPropsEquivalenceTest.Eq("type default", type.DefaultValue(), "bar");
        HtmlPropsEquivalenceTest.Eq("title default", title.DefaultValue(), "");
        HtmlPropsEquivalenceTest.Eq("toolbox default", toolbox.DefaultValue(), "false");
        HtmlPropsEquivalenceTest.Eq("bound type initial", type.ReadFrom(chart), "bar");
        HtmlPropsEquivalenceTest.Eq("bound title initial", title.ReadFrom(chart), "");
        HtmlPropsEquivalenceTest.Eq("bound toolbox initial", toolbox.ReadFrom(chart), "false");
        for (int i = (int)ChartType.Line; i <= (int)ChartType.Custom; i = i + 1) {
            string name = ChartKinds.TypeName((ChartType)i);
            HtmlPropsEquivalenceTest.Check("chart enum " + name, type.options.Contains(name));
        }
        string[] aliases = new string[]{ "area", "stacked", "hbar", "hstacked", "donut" };
        for (int i = 0; i < aliases.Length; i = i + 1) {
            HtmlPropsEquivalenceTest.Check("chart alias " + aliases[i], type.options.Contains(aliases[i]));
        }

        title.WriteTo(chart, "Bound title");
        type.WriteTo(chart, "pie");
        HtmlPropsEquivalenceTest.Check("bound type uses semantic setter",
            chart.GetOption().series[0].type == ChartType.Pie);
        HtmlPropsEquivalenceTest.Eq("bound switch retains title", title.ReadFrom(chart), "Bound title");
        ChartOption pie = chart.GetOption();
        type.WriteTo(chart, "pie");
        HtmlPropsEquivalenceTest.Check("bound repeated type retains option", chart.GetOption() == pie);
        toolbox.WriteTo(chart, "true");
        HtmlPropsEquivalenceTest.Check("bound toolbox writes host", chart.IsWidgetToolbox());
        chart.SetWidgetToolbox(false);
        HtmlPropsEquivalenceTest.Eq("bound toolbox follows direct setter", toolbox.ReadFrom(chart), "false");
        chart.SetProp("widgetToolbox", "1");
        HtmlPropsEquivalenceTest.Eq("toolbox property reads metadata", toolbox.ReadFrom(chart), "true");

        ChartOption replacement = ChartHost.SampleOf("scatter");
        replacement.title = "Replacement";
        chart.SetOption(replacement);
        HtmlPropsEquivalenceTest.Eq("existing type binding follows SetOption", type.ReadFrom(chart), "scatter");
        HtmlPropsEquivalenceTest.Eq("existing title binding follows SetOption", title.ReadFrom(chart), "Replacement");
        type.WriteTo(chart, "scatter");
        HtmlPropsEquivalenceTest.Check("SetOption data survives repeated type", chart.GetOption() == replacement);
        title.WriteTo(chart, "Current option");
        HtmlPropsEquivalenceTest.Eq("existing binding writes current option", replacement.title, "Current option");
        HtmlPropsEquivalenceTest.Eq("existing binding leaves old option alone", pie.title, "Bound title");
        chart.SetProp("title", "Property title");
        HtmlPropsEquivalenceTest.Eq("property writes reach existing binding", title.ReadFrom(chart), "Property title");
        chart.SetChartType("boxplot");
        PropSpec custom = PropSpec.Find(chart.Props(), "type", true);
        HtmlPropsEquivalenceTest.Check("custom type available to metadata export",
            custom != null && custom.options.Contains("boxplot"));
        HtmlPropsEquivalenceTest.Eq("custom type retains title", chart.GetOption().title, "Property title");
    }

    static void Values() {
        Slider slider = new Slider();
        slider.SetProp("value", "37");
        HtmlPropsEquivalenceTest.Same("slider value",
            HtmlPropsEquivalenceTest.One("<slider value='37'></slider>"), slider, "value", "37");
        HtmlPropsEquivalenceTest.Same("range value",
            HtmlPropsEquivalenceTest.One("<input type='range' value='37'>"), slider, "value", "37");

        InputNumber number = new InputNumber();
        number.SetProp("value", "23");
        number.SetProp("placeholder", "Amount");
        Control inputNumber = HtmlPropsEquivalenceTest.One("<input type='number' value='23' placeholder='Amount'>");
        HtmlPropsEquivalenceTest.Same("number input value", inputNumber, number, "value", "23");
        HtmlPropsEquivalenceTest.Same("number input placeholder", inputNumber, number, "placeholder", "Amount");
        Control registeredNumber = HtmlPropsEquivalenceTest.One("<zan-input-number value='23' placeholder='Amount'></zan-input-number>");
        HtmlPropsEquivalenceTest.Same("registered number value", registeredNumber, number, "value", "23");
        HtmlPropsEquivalenceTest.Same("registered number placeholder", registeredNumber, number, "placeholder", "Amount");

        Checkbox checkbox = new Checkbox();
        checkbox.SetProp("value", "true");
        Control check = HtmlPropsEquivalenceTest.One("<input type='checkbox' value='true'>");
        HtmlPropsEquivalenceTest.Same("checkbox value", check, checkbox, "value", "true");

        Progress progress = new Progress();
        progress.SetProp("type", "success");
        progress.SetProp("value", "41");
        Control bar = HtmlPropsEquivalenceTest.One("<progress type='success' value='41'></progress>");
        HtmlPropsEquivalenceTest.Same("progress type", bar, progress, "type", "2");
        HtmlPropsEquivalenceTest.Same("progress value", bar, progress, "value", "41");
    }

    static void Titles() {
        Card card = new Card();
        card.SetProp("title", "Card heading");
        HtmlPropsEquivalenceTest.Same("card title",
            HtmlPropsEquivalenceTest.One("<card title='Card heading'></card>"), card, "title", "Card heading");
        Card valueCard = new Card();
        valueCard.SetProp("value", "Card value");
        HtmlPropsEquivalenceTest.Same("card value alias",
            HtmlPropsEquivalenceTest.One("<card value='Card value'></card>"), valueCard, "value", "Card value");

        Button button = new Button("Save");
        button.SetProp("type", "primary");
        button.SetProp("tip", "Save changes");
        Control htmlButton = HtmlPropsEquivalenceTest.One("<button type='primary' title='Save changes'>Save</button>");
        HtmlPropsEquivalenceTest.Same("button title compatibility", htmlButton, button, "tip", "Save changes");
        HtmlPropsEquivalenceTest.Eq("button type class", htmlButton.Class, button.Class);
        HtmlPropsEquivalenceTest.Eq("button primary", htmlButton.HasClass("primary") ? "true" : "false", "true");
        HtmlPropsEquivalenceTest.Same("button tip",
            HtmlPropsEquivalenceTest.One("<button tip='Save changes'>Save</button>"), button, "tip", "Save changes");

        Element element = new Element();
        element.InitElement("div", "");
        element.SetProp("title", "Element hint");
        HtmlPropsEquivalenceTest.Same("element title",
            HtmlPropsEquivalenceTest.One("<div title='Element hint'></div>"), element, "title", "Element hint");
    }

    static void ConstructorAttributes() {
        Input input = new Input();
        input.InitInput("secret", "Password");
        input.SetProp("password", "true");
        Control htmlInput = HtmlPropsEquivalenceTest.One("<input type='password' value='secret' placeholder='Password'>");
        HtmlPropsEquivalenceTest.Same("text input value", htmlInput, input, "value", "secret");
        HtmlPropsEquivalenceTest.Same("text input placeholder", htmlInput, input, "placeholder", "Password");
        HtmlPropsEquivalenceTest.Same("password input", htmlInput, input, "password", "true");

        TextArea area = new TextArea();
        area.InitTextArea("", "");
        area.SetProp("placeholder", "Notes");
        HtmlPropsEquivalenceTest.Same("textarea placeholder",
            HtmlPropsEquivalenceTest.One("<textarea placeholder='Notes'></textarea>"), area, "placeholder", "Notes");

        Image image = new Image();
        image.SetProp("src", "test-image.png");
        image.SetProp("alt", "Image description");
        Control registeredImage = HtmlPropsEquivalenceTest.One("<zan-image src='test-image.png' alt='Image description'></zan-image>");
        HtmlPropsEquivalenceTest.Same("registered image src", registeredImage, image, "src", "test-image.png");
        HtmlPropsEquivalenceTest.Same("registered image alt", registeredImage, image, "alt", "Image description");
        Control img = HtmlPropsEquivalenceTest.One("<img src='test-image.png' alt='Image description'>");
        HtmlPropsEquivalenceTest.Same("img src", img, image, "src", "test-image.png");
        HtmlPropsEquivalenceTest.Same("img alt", img, image, "alt", "Image description");
    }

    static void CatalogMetadata() {
        List<string> kinds = ControlFactory.Kinds();
        HtmlPropsEquivalenceTest.Check("catalog includes standard widgets", kinds.Count > 50);
        for (int i = 0; i < kinds.Count; i = i + 1) {
            Control control = ControlFactory.Create(kinds[i]);
            HtmlPropsEquivalenceTest.Check("catalog creates " + kinds[i], control != null);
            if (control == null) { continue; }
            List<PropSpec> specs = control.Props();
            for (int j = 0; j < specs.Count; j = j + 1) {
                PropSpec spec = specs[j];
                if (spec.key == "" || !spec.IsBound()) { continue; }
                string label = kinds[i] + "." + spec.key;
                try {
                    string value = spec.ReadFrom(control);
                    HtmlPropsEquivalenceTest.Eq(label + " protocol", control.GetProp(spec.key), value);
                    control.SetProp(spec.key, value);
                    HtmlPropsEquivalenceTest.Eq(label + " property replay", spec.ReadFrom(control), value);
                    spec.WriteTo(control, value);
                    HtmlPropsEquivalenceTest.Eq(label + " metadata replay", control.GetProp(spec.key), value);
                } catch (Exception failure) {
                    fails = fails + 1;
                    Console.WriteLine("FAIL " + label + ": " + failure.Message);
                }
            }
        }
    }

    static void Main() {
        ControlBootstrap.Install();
        fails = 0;
        HtmlPropsEquivalenceTest.Charts();
        HtmlPropsEquivalenceTest.ChartPropertyOrder();
        HtmlPropsEquivalenceTest.ChartMetadata();
        HtmlPropsEquivalenceTest.Values();
        HtmlPropsEquivalenceTest.Titles();
        HtmlPropsEquivalenceTest.ConstructorAttributes();
        HtmlPropsEquivalenceTest.CatalogMetadata();
        Console.WriteLine(fails == 0 ? "html props equivalence ok" : "html props equivalence FAILED");
    }
}
