using System;
using Gui;
using Gui.Widget;
using Gui.Component.Chart;

// 无窗口：声明式属性与代码 SetProp 必须到达同一控件属性协议。
class HtmlPropsEquivalenceTest {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static Control One(string html) {
        HtmlDoc doc = Html.Parse(html, "", null);
        return doc.root.children[0];
    }

    static void Same(string what, Control html, Control code, string key, string want) {
        HtmlPropsEquivalenceTest.Eq(what + " kind", html.Kind(), code.Kind());
        HtmlPropsEquivalenceTest.Eq(what + " code", code.GetProp(key), want);
        HtmlPropsEquivalenceTest.Eq(what + " html", html.GetProp(key), code.GetProp(key));
    }

    static void Charts() {
        // ChartHost 只覆写 SetProp/GetProp，未发布 title/type PropSpec；
        // HTML 必须尊重虚方法，不能另建一份属性白名单。
        ChartHost.Install();
        ChartHost code = new ChartHost();
        code.SetProp("type", "pie");
        code.SetProp("title", "Traffic");
        Control chart = HtmlPropsEquivalenceTest.One("<chart type='pie' title='Traffic'></chart>");
        HtmlPropsEquivalenceTest.Same("chart type", chart, code, "type", "pie");
        HtmlPropsEquivalenceTest.Same("chart title", chart, code, "title", "Traffic");
        ChartOption option = ((ChartHost)chart).GetOption();
        HtmlPropsEquivalenceTest.Eq("chart option title", option.title, "Traffic");

        Control alias = HtmlPropsEquivalenceTest.One("<zan-chart type='pie' title='Traffic'></zan-chart>");
        HtmlPropsEquivalenceTest.Same("zan-chart type", alias, code, "type", "pie");
        HtmlPropsEquivalenceTest.Same("zan-chart title", alias, code, "title", "Traffic");
        Control host = HtmlPropsEquivalenceTest.One("<zan-chart-host type='pie' title='Traffic'></zan-chart-host>");
        HtmlPropsEquivalenceTest.Same("zan-chart-host type", host, code, "type", "pie");
        HtmlPropsEquivalenceTest.Same("zan-chart-host title", host, code, "title", "Traffic");

        // type 的小写化仅供 <input> 分派；组件属性值保留原文。
        ChartHost mixedCode = new ChartHost();
        mixedCode.SetProp("type", "wordCloud");
        Control mixed = HtmlPropsEquivalenceTest.One("<chart type='wordCloud'></chart>");
        HtmlPropsEquivalenceTest.Same("chart mixed-case type", mixed, mixedCode, "type", "wordCloud");
    }

    static void Values() {
        Slider slider = new Slider();
        slider.SetProp("value", "37");
        HtmlPropsEquivalenceTest.Same("slider value",
            HtmlPropsEquivalenceTest.One("<slider value='37'></slider>"), slider, "value", "37");
        HtmlPropsEquivalenceTest.Same("range value",
            HtmlPropsEquivalenceTest.One("<input type='range' value='37'>"), slider, "value", "37");

        InputNumber number = new InputNumber();
        number.SetProp("value", "23");
        number.SetProp("placeholder", "Amount");
        Control inputNumber = HtmlPropsEquivalenceTest.One("<input type='number' value='23' placeholder='Amount'>");
        HtmlPropsEquivalenceTest.Same("number input value", inputNumber, number, "value", "23");
        HtmlPropsEquivalenceTest.Same("number input placeholder", inputNumber, number, "placeholder", "Amount");
        Control registeredNumber = HtmlPropsEquivalenceTest.One("<zan-input-number value='23' placeholder='Amount'></zan-input-number>");
        HtmlPropsEquivalenceTest.Same("registered number value", registeredNumber, number, "value", "23");
        HtmlPropsEquivalenceTest.Same("registered number placeholder", registeredNumber, number, "placeholder", "Amount");

        Checkbox checkbox = new Checkbox();
        checkbox.SetProp("value", "true");
        Control check = HtmlPropsEquivalenceTest.One("<input type='checkbox' value='true'>");
        HtmlPropsEquivalenceTest.Same("checkbox value", check, checkbox, "value", "true");

        Progress progress = new Progress();
        progress.SetProp("type", "success");
        progress.SetProp("value", "41");
        Control bar = HtmlPropsEquivalenceTest.One("<progress type='success' value='41'></progress>");
        HtmlPropsEquivalenceTest.Same("progress type", bar, progress, "type", "2");
        HtmlPropsEquivalenceTest.Same("progress value", bar, progress, "value", "41");
    }

    static void Titles() {
        Card card = new Card();
        card.SetProp("title", "Card heading");
        HtmlPropsEquivalenceTest.Same("card title",
            HtmlPropsEquivalenceTest.One("<card title='Card heading'></card>"), card, "title", "Card heading");
        Card valueCard = new Card();
        valueCard.SetProp("value", "Card value");
        HtmlPropsEquivalenceTest.Same("card value alias",
            HtmlPropsEquivalenceTest.One("<card value='Card value'></card>"), valueCard, "value", "Card value");

        Button button = new Button("Save");
        button.SetProp("type", "primary");
        button.SetProp("tip", "Save changes");
        Control htmlButton = HtmlPropsEquivalenceTest.One("<button type='primary' title='Save changes'>Save</button>");
        HtmlPropsEquivalenceTest.Same("button title compatibility", htmlButton, button, "tip", "Save changes");
        HtmlPropsEquivalenceTest.Eq("button type class", htmlButton.Class, button.Class);
        HtmlPropsEquivalenceTest.Eq("button primary", htmlButton.HasClass("primary") ? "true" : "false", "true");
        HtmlPropsEquivalenceTest.Same("button tip",
            HtmlPropsEquivalenceTest.One("<button tip='Save changes'>Save</button>"), button, "tip", "Save changes");

        Element element = new Element();
        element.InitElement("div", "");
        element.SetProp("title", "Element hint");
        HtmlPropsEquivalenceTest.Same("element title",
            HtmlPropsEquivalenceTest.One("<div title='Element hint'></div>"), element, "title", "Element hint");
    }

    static void ConstructorAttributes() {
        Input input = new Input();
        input.InitInput(new SignalString("secret"), "Password");
        input.SetProp("password", "true");
        Control htmlInput = HtmlPropsEquivalenceTest.One("<input type='password' value='secret' placeholder='Password'>");
        HtmlPropsEquivalenceTest.Same("text input value", htmlInput, input, "value", "secret");
        HtmlPropsEquivalenceTest.Same("text input placeholder", htmlInput, input, "placeholder", "Password");
        HtmlPropsEquivalenceTest.Same("password input", htmlInput, input, "password", "true");

        TextArea area = new TextArea();
        area.InitTextArea(new SignalString(""), "");
        area.SetProp("placeholder", "Notes");
        HtmlPropsEquivalenceTest.Same("textarea placeholder",
            HtmlPropsEquivalenceTest.One("<textarea placeholder='Notes'></textarea>"), area, "placeholder", "Notes");

        Image image = new Image();
        image.SetProp("src", "test-image.png");
        image.SetProp("alt", "Image description");
        Control registeredImage = HtmlPropsEquivalenceTest.One("<zan-image src='test-image.png' alt='Image description'></zan-image>");
        HtmlPropsEquivalenceTest.Same("registered image src", registeredImage, image, "src", "test-image.png");
        HtmlPropsEquivalenceTest.Same("registered image alt", registeredImage, image, "alt", "Image description");
        Control img = HtmlPropsEquivalenceTest.One("<img src='test-image.png' alt='Image description'>");
        HtmlPropsEquivalenceTest.Same("img src", img, image, "src", "test-image.png");
        HtmlPropsEquivalenceTest.Same("img alt", img, image, "alt", "Image description");
    }

    static void Main() {
        fails = 0;
        HtmlPropsEquivalenceTest.Charts();
        HtmlPropsEquivalenceTest.Values();
        HtmlPropsEquivalenceTest.Titles();
        HtmlPropsEquivalenceTest.ConstructorAttributes();
        Console.WriteLine(fails == 0 ? "html props equivalence ok" : "html props equivalence FAILED");
    }
}
