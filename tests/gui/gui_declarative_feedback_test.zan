using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

class GuiDeclarativeFeedbackTest {
    static int fails = 0;

    static void Check(string desc, bool ok) {
        if (ok) {
            Console.WriteLine("[PASS] " + desc);
        } else {
            Console.WriteLine("[FAIL] " + desc);
            fails = fails + 1;
        }
    }

    static void Main(string[] args) {
        Form win = Form.CreateOffscreen("Feedback Test", 800, 600);

        // ----------------- 1. Message 全局轻提示测试 -----------------
        Message.Info(win.GetApp(), "系统正在同步数据...");
        Message.Success(win.GetApp(), "用户创建成功！");
        Message.Warning(win.GetApp(), "网络延迟较高");
        Message.Error(win.GetApp(), "操作失败，请重试");
        Check("Message APIs executed without error", true);

        // ----------------- 2. Empty 空状态占位组件测试 -----------------
        Button createBtn = new Button("新建项目") { ClassName = "primary small" };
        Empty empty = new Empty("暂无任何项目") {
            DescriptionText = "当前工作区为空，请点击下方按钮快速初始化",
            ExtraContent = createBtn
        };

        Check("Empty extra slot attached", empty.GetExtra() == createBtn);

        // ----------------- 3. Result 结果页组件测试 -----------------
        Button backBtn = new Button("返回控制台") { ClassName = "secondary small" };
        Button retryBtn = new Button("再次尝试") { ClassName = "primary small" };

        Result result = new Result {
            StatusKind = "success",
            TitleText = "支付结算成功",
            DescriptionText = "交易单号: ZAN-2026-889900，电子发票已发送至您的邮箱",
            ActionButtons = new List<Control> { backBtn, retryBtn }
        };

        Check("Result extra slot attached", result.GetExtra() != null);

        // 挂载进入离线窗体进行排版与快照渲染
        Column page = new Column {
            Gap = 20,
            Children = [ empty, result ]
        };
        win.Add(page);

        Canvas snapshot = win.CaptureSnapshot();
        Check("Snapshot rendered successfully", snapshot != null);

        // 验证 Empty 内部按钮的几何排布（自动定位在空状态区域内部下方）
        Check("Empty createBtn arranged inside empty area", createBtn.by > empty.by);
        Check("Empty createBtn horizontally centered", createBtn.bx > empty.bx);

        // 验证 Result 内部按钮排布（backBtn 与 retryBtn 水平排列并位于结果页下方）
        Check("Result actions arranged below header", backBtn.by > result.by);
        Check("Result actions horizontally sequenced", retryBtn.bx > backBtn.bx);

        if (fails == 0) {
            Console.WriteLine("ALL TESTS PASSED: Modern Message, Empty & Result verified.");
        } else {
            Console.WriteLine("TOTAL FAILS: " + fails);
            Environment.Exit(1);
        }
    }
}
