using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

class GuiDeclarativeTreeTabsTest {
    static int fails = 0;

    static void Check(string desc, bool ok) {
        if (ok) {
            Console.WriteLine("[PASS] " + desc);
        } else {
            Console.WriteLine("[FAIL] " + desc);
            fails = fails + 1;
        }
    }

    static void Main(string[] args) {
        Form win = Form.CreateOffscreen("Tree & Tabs Declarative Test", 800, 600);

        // ----------------- 1. TreeView 复合节点与 Extra 插槽测试 -----------------
        List<TreeNode> nodes = new List<TreeNode>();
        TreeNode root = TreeNode.Dir("src", 0, true);
        Button runBtn = new Button("运行") { ClassName = "success small" };
        TreeNode fileNode = TreeNode.File("main.zan", 1);
        fileNode.Extra(runBtn);
        nodes.Add(root);
        nodes.Add(fileNode);

        TreeView tree = new TreeView {
            ItemsSource = nodes
        };

        // 验证自动感知复合节点并激活行装配模板
        Check("TreeView automatically detects node extra slot", tree.Templated());

        // 验证声明式 NodeTemplate 支持
        tree.NodeTemplate = n => {
            Row r = new Row {
                AlignItems = "center",
                Gap = 4,
                Children = [ new Label(n.label) { ClassName = "strong" } ]
            };
            if (n.extra != null) {
                r.Add(new Spacer());
                r.Add(n.extra);
            }
            return r;
        };
        Check("TreeView NodeTemplate configured successfully", tree.Templated());

        // ----------------- 2. Tabs 声明式 TabPane 与 ExtraContent 插槽测试 -----------------
        Label page1 = new Label("这是概览内容页面");
        Label page2 = new Label("这是日志分析页面");
        Button newTabBtn = new Button("+ 新建") { ClassName = "primary small" };

        Tabs tabs = new Tabs {
            ExtraContent = newTabBtn,
            Children = [
                new TabPane("系统概览", page1),
                new TabPane("运行日志", page2)
            ]
        };

        Check("Tabs count matches declared tabs (2)", tabs.Count() == 2);
        Check("Tabs extra slot attached", tabs.GetExtra() == newTabBtn);
        Check("Initial active tab is 0", tabs.Active() == 0);

        tabs.Select(1);
        Check("Active tab switches to 1", tabs.Active() == 1);

        // ----------------- 3. 挂载到窗体并进行快照测量断言 -----------------
        Column layout = new Column {
            Gap = 20,
            Children = [ tree, tabs ]
        };
        win.Add(layout);

        Canvas snapshot = win.CaptureSnapshot();
        Check("Snapshot rendered successfully", snapshot != null);

        // 验证 Tabs 的 extraSlot 停靠在 TabBar 右侧
        Check("Tabs newTabBtn arranged to the right edge", newTabBtn.bx > tabs.bx + 200);

        if (fails == 0) {
            Console.WriteLine("ALL TESTS PASSED: Modern TreeView & Tabs slots verified.");
        } else {
            Console.WriteLine("TOTAL FAILS: " + fails);
            Environment.Exit(1);
        }
    }
}
