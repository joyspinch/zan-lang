using System;
using System.IO;
using Gui;
using Gui.Component;
using Gui.Widget;

// Gui.Upload 的无窗口回归：组件模型（Kind/Props/Events/工厂/
// GetProp 往返）、门与状态机（Accept 过滤、Max+Exceed、BeforeUpload
// 拦截、AutoUpload→CustomRequest、Submit 手动提交、SetItem* 与
// Finish/Error 恰好一次、Remove/Clear/Change 计数、LastItem），
// 以及渲染一帧后的命中区、拖放落区与 CSS 解析。
// 进度全部由 SetItemPercent 显式驱动，无真实时间依赖。
class UploadTest {
    static int fails;
    static int changeCount;
    static int uploadCount;
    static int finishCount;
    static int errorCount;
    static int removeCount;
    static int downloadCount;
    static int exceedCount;
    static int customId;
    static weak Upload releasedUpload;
    static weak UploadFile releasedFile;

    static Control Part(Control root, string token) {
        if (root == null) { return null; }
        if ((" " + root.ClassName + " ").Contains(" " + token + " ")) { return root; }
        for (int i = 0; i < root.ChildCount(); i = i + 1) {
            Control found = Part(root.ChildAt(i), token);
            if (found != null) { return found; }
        }
        return null;
    }

    static void Layout(App app, Upload up, int x, int y, int w, int h) {
        app.SetRootControl(up);
        up.MeasureTree(app, w);
        up.Arrange(x, y, w, h);
    }

    static void ClickPart(App app, Control part) {
        True("click part exists", part != null);
        if (part == null) { return; }
        True("click part arranged", part.bw > 0 && part.bh > 0);
        int x = part.bx + part.bw / 2;
        int y = part.by + part.bh / 2;
        app.DispatchVisualTree(2, x, y, 0, 0);
        app.DispatchVisualTree(3, x, y, 0, 0);
    }

    static void MakeReleasedTree() {
        Upload up = new Upload();
        up.ShowDownloadButton = true;
        UploadFile file = up.AddFile("released.png", "", "http://host/released.png");
        releasedUpload = up;
        releasedFile = file;
        up.BuildTree();
    }

    static void OnChange() { changeCount = changeCount + 1; }
    static void OnUpload() { uploadCount = uploadCount + 1; }
    static void OnFinish() { finishCount = finishCount + 1; }
    static void OnError() { errorCount = errorCount + 1; }
    static void OnRemove() { removeCount = removeCount + 1; }
    static void OnDownload() { downloadCount = downloadCount + 1; }
    static void OnExceed() { exceedCount = exceedCount + 1; }
    static void OnReq(UploadFile f) { customId = f.id; }

    // before-upload 拦截 .exe（静态方法组，非捕获）。
    static bool BlockExe(UploadFile f) { return f.ext != "exe"; }
    static void NoopReq(UploadFile f) { }

    static void True(string what, bool got) {
        if (got) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Eq(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got " + got + " want " + want);
    }

    static void EqStr(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void Wire(Upload up) {
        changeCount = 0; uploadCount = 0; finishCount = 0;
        errorCount = 0; removeCount = 0; downloadCount = 0; exceedCount = 0;
        up.Change += OnChange;
        up.UploadStart += OnUpload;
        up.Finish += OnFinish;
        up.Error += OnError;
        up.Remove += OnRemove;
        up.Download += OnDownload;
        up.Exceed += OnExceed;
    }

    static UploadFile Item(Upload up, int id) {
        if (up.Files == null) { return null; }
        int i = 0;
        while (i < up.Files.Count) {
            if (up.Files[i].id == id) { return up.Files[i]; }
            i = i + 1;
        }
        return null;
    }

    static bool HasEv(List<string> evs, string n) {
        int i = 0;
        while (i < evs.Count) { if (evs[i] == n) { return true; } i = i + 1; }
        return false;
    }

    static List<string> One(string p) {
        List<string> l = new List<string>();
        l.Add(p);
        return l;
    }

    static void Main() {
        fails = 0;

        // ---- 组件模型 --------------------------------------------------
        Upload m = new Upload();
        EqStr("kind", m.Kind(), "Upload");
        Control made = ControlFactory.Create("Upload");
        True("factory non-null", made != null);
        if (made != null) { EqStr("factory kind", made.Kind(), "Upload"); }
        Eq("default autoUpload", m.AutoUpload ? 1 : 0, 1);
        EqStr("default trigger", m.TriggerText, "上传文件");
        // 全部设计器字段可往返。
        m.SetProp("triggerText", "选择文件");
        m.SetProp("dragText", "拖到这里");
        m.SetProp("tip", "不超过 2MB");
        m.SetProp("accept", "png,jpg");
        m.SetProp("max", "3");
        m.SetProp("autoUpload", "false");
        m.SetProp("multiple", "true");
        m.SetProp("dragger", "true");
        m.SetProp("pictureCard", "true");
        m.SetProp("thumbnail", "true");
        m.SetProp("showTrigger", "false");
        m.SetProp("showRemoveButton", "false");
        m.SetProp("showDownloadButton", "true");
        EqStr("roundtrip triggerText", m.GetProp("triggerText"), "选择文件");
        EqStr("roundtrip dragText", m.GetProp("dragText"), "拖到这里");
        EqStr("roundtrip tip", m.GetProp("tip"), "不超过 2MB");
        EqStr("roundtrip accept", m.GetProp("accept"), "png,jpg");
        EqStr("roundtrip max", m.GetProp("max"), "3");
        EqStr("roundtrip autoUpload", m.GetProp("autoUpload"), "false");
        EqStr("roundtrip multiple", m.GetProp("multiple"), "true");
        EqStr("roundtrip dragger", m.GetProp("dragger"), "true");
        EqStr("roundtrip pictureCard", m.GetProp("pictureCard"), "true");
        EqStr("roundtrip thumbnail", m.GetProp("thumbnail"), "true");
        EqStr("roundtrip showTrigger", m.GetProp("showTrigger"), "false");
        EqStr("roundtrip showRemoveButton", m.GetProp("showRemoveButton"), "false");
        EqStr("roundtrip showDownloadButton", m.GetProp("showDownloadButton"), "true");
        Eq("props count", m.Props().Count, 13);
        List<string> evs = m.Events();
        True("events", HasEv(evs, "Change") && HasEv(evs, "Upload")
            && HasEv(evs, "Finish") && HasEv(evs, "Error") && HasEv(evs, "Remove")
            && HasEv(evs, "Download") && HasEv(evs, "Exceed")
            && HasEv(evs, "Click"));
        // BindEvent 的 "Upload" 别名与字段事件同源：挂上后开传即触发。
        Upload alias = new Upload();
        aliasHits = 0;
        alias.BindEvent("Upload", OnAlias);
        alias.WithCustomRequest(NoopReq);
        alias.AddFile("x", "", "");
        Eq("Upload alias routes", aliasHits, 1);
        // 扩展名解析：点/星号大小写混排都接受，未列出的拒绝。
        Upload acc = new Upload();
        acc.Accept = ".PNG,*.jpg,svg";
        True("accept dotted", acc.AcceptAllows("png"));
        True("accept star", acc.AcceptAllows("jpg"));
        True("accept bare", acc.AcceptAllows("svg"));
        True("accept reject", !acc.AcceptAllows("gif"));
        // 无传输通道时 AutoUpload 不虚报状态：停在 Pending。
        Upload noTr = new Upload();
        Wire(noTr);
        UploadFile pend = noTr.AddFile("a.txt", "", "");
        Eq("no-transport stays pending", pend.status, UploadStatus.Pending());
        Eq("no upload event", uploadCount, 0);
        True("lastitem after add", noTr.LastItem == pend);
        True("find by id", Item(noTr, pend.id) == pend);
        True("find missing", Item(noTr, 999999) == null);

        // ---- 门：Accept 过滤 / Max / BeforeUpload / Disabled -----------
        Upload g = new Upload();
        Wire(g);
        g.Accept = "png";
        Eq("accept gate rejects", g.AddPaths(One("x.txt")), 0);
        Eq("accept no list", g.Files.Count, 0);
        g.Accept = "";
        g.Max = 2;
        g.AddPaths(One("a.png"));
        g.AddPaths(One("b.png"));
        Eq("max gate first two", g.Files.Count, 2);
        g.AddPaths(One("c.png"));
        Eq("max blocks third", g.Files.Count, 2);
        Eq("exceed once", exceedCount, 1);
        True("exceed lastitem", g.LastItem != null && g.LastItem.name == "c.png");
        g.Clear();
        Eq("clear resets", g.Files.Count, 0);
        g.WithBeforeUpload(BlockExe);
        g.AddPaths(One("bad.exe"));
        Eq("before blocks", g.Files.Count, 0);
        Eq("before no change event", changeCount, 3); // a/b/Clear 三次
        g.AddPaths(One("good.txt"));
        Eq("before lets through", g.Files.Count, 1);
        Eq("change after pass", changeCount, 4);
        // Disabled：AddPaths 直接拒绝。
        Upload d = new Upload();
        Wire(d);
        d.Disabled = true;
        d.AddPaths(One("z.txt"));
        Eq("disabled rejects", d.Files.Count, 0);
        d.Disabled = false;
        True("disabled check off", !d.IsDisabled());

        // ---- 状态机：CustomRequest + 显式进度 + 完成/失败 --------------
        Upload s = new Upload();
        Wire(s);
        customId = 0;
        s.WithCustomRequest(OnReq);
        UploadFile a = s.AddFile("first.png", "", "");
        Eq("auto upload fires", uploadCount, 1);
        Eq("custom got item", customId, a.id);
        Eq("item uploading", a.status, UploadStatus.Uploading());
        s.SetItemPercent(a.id, 42);
        Eq("percent", a.percent, 42);
        s.SetItemStatus(a.id, UploadStatus.Success(), "");
        Eq("finish once", finishCount, 1);
        Eq("success sets 100", a.percent, 100);
        Eq("change count", changeCount, 2);
        UploadFile b = s.AddFile("second.png", "", "");
        Eq("custom second", uploadCount, 2);
        s.SetItemStatus(b.id, UploadStatus.Error(), "network down");
        Eq("error once", errorCount, 1);
        EqStr("error msg", b.message, "network down");
        Eq("change after error", changeCount, 4);
        // 不存在的 id 不炸、不触发。
        s.SetItemStatus(999999, UploadStatus.Success(), "");
        Eq("bad id no finish", finishCount, 1);
        // Submit：AutoUpload=false 时挂起，手动提交才启动。
        Upload sub = new Upload();
        Wire(sub);
        sub.AutoUpload = false;
        UploadFile p = sub.AddFile("late.txt", "", "");
        Eq("pending before submit", p.status, UploadStatus.Pending());
        Eq("no upload event yet", uploadCount, 0);
        sub.WithCustomRequest(OnReq);
        sub.Submit();
        Eq("submit starts", p.status, UploadStatus.Uploading());
        Eq("submit fired", uploadCount, 1);
        sub.Submit();
        Eq("submit skips non-pending", uploadCount, 1);
        // 移除 / 清空事件计数
        sub.RemoveItem(p.id);
        Eq("remove event", removeCount, 1);
        Eq("change on remove", changeCount, 2);
        Eq("list shrunk", sub.Files.Count, 0);
        UploadFile r1 = sub.AddFile("img.png", "", "");
        sub.SetItemUrl(r1.id, "http://host/img.png");
        UploadFile got = Item(sub, r1.id);
        True("setitemurl applies", got != null && got.url == "http://host/img.png");
        sub.SetItemThumb(r1.id, "http://host/thumb.png");
        UploadFile t3 = Item(sub, r1.id);
        True("setitemthumb applies", t3 != null && t3.thumb == "http://host/thumb.png");
        sub.Clear();
        Eq("clear change event", changeCount, 5);
        Eq("clear empties", sub.Files.Count, 0);

        // ---- Retained tree input before the first paint -----------------
        App app = new App("uploadtest", 800, 600);
        Upload view = new Upload();
        Wire(view);
        view.ShowDownloadButton = true;
        view.Thumbnail = true;
        UploadFile t1 = view.AddFile("photo.jpg", "", "http://host/p.jpg");
        Eq("view item success", t1.status, UploadStatus.Success());
        Layout(app, view, 40, 50, 320, 200);
        Control trigger = Part(view, "upload-trigger");
        Control row = Part(view, "upload-item");
        True("trigger retained", trigger != null && trigger.parent == view);
        True("row retained", row != null && row.parent != null);
        if (trigger != null) {
            True("trigger measured", trigger.bw > 60 && trigger.bh > 0);
            True("drop inside", view.WantsDropAt(trigger.bx + 1, trigger.by + 1));
            True("drop right edge excluded", !view.WantsDropAt(trigger.bx + trigger.bw, trigger.by + 1));
            True("drop bottom edge excluded", !view.WantsDropAt(trigger.bx + 1, trigger.by + trigger.bh));
        }
        if (row != null && trigger != null) {
            True("row below trigger", row.by >= trigger.by + trigger.bh);
            True("row measured", row.bw > 0 && row.bh > 0);
        }
        StyleBox ts = view.TriggerStyle(app, false);
        True("trigger bg themed", ts.BgOr(0) == app.theme.primary);
        int beforeDownload = downloadCount;
        ClickPart(app, Part(view, "upload-name-link"));
        Eq("name routes once before paint", downloadCount, beforeDownload + 1);
        True("download last item", view.LastItem == t1);
        ClickPart(app, Part(view, "download"));
        Eq("button routes once before paint", downloadCount, beforeDownload + 2);
        view.RenderTree(app);
        Eq("paint never downloads", downloadCount, beforeDownload + 2);
        ClickPart(app, trigger);
        True("trigger routes picker", view.DialogOpen());
        view.CloseDialog(); view.TakeDialogResult(); view.SweepDialogClosed();
        ClickPart(app, Part(view, "remove"));
        Eq("remove routes once", view.Files.Count, 0);
        Layout(app, view, 40, 50, 320, 200);
        True("removed tree refreshed", Part(view, "upload-item") == null);

        // Controlled Files and config changes refresh generated nodes.
        List<UploadFile> shared = new List<UploadFile>();
        UploadFile controlled = new UploadFile();
        controlled.id = 400; controlled.name = "controlled.txt";
        shared.Add(controlled);
        view.SetFiles(shared);
        Layout(app, view, 40, 50, 320, 200);
        True("controlled row created", Part(view, "upload-item") != null);
        Control stableRow = Part(view, "upload-item");
        Layout(app, view, 40, 50, 320, 200);
        True("unchanged tree stays retained", Part(view, "upload-item") == stableRow);
        view.SetItemStatus(controlled.id, UploadStatus.Uploading(), "");
        view.SetItemPercent(controlled.id, 37);
        Layout(app, view, 40, 50, 320, 200);
        Control progress = Part(view, "upload-progress");
        True("progress real control", progress is Progress);
        if (progress is Progress) { Eq("progress synchronized", ((Progress)progress).percent, 37); }
        controlled.name = "renamed.txt";
        controlled.message = "failed externally";
        controlled.status = UploadStatus.Error();
        Layout(app, view, 40, 50, 320, 200);
        Control message = Part(view, "upload-msg");
        True("external status refreshed", message is Label);
        if (message is Label) { EqStr("external message", ((Label)message).GetText(), "failed externally"); }
        controlled.status = UploadStatus.Success(); controlled.url = "http://host/controlled";
        view.Disabled = true;
        Layout(app, view, 40, 50, 320, 200);
        beforeDownload = downloadCount;
        ClickPart(app, Part(view, "upload-name-link"));
        Eq("disabled download blocked", downloadCount, beforeDownload);
        True("disabled remove absent", Part(view, "remove") == null);
        view.Disabled = false; view.ShowTrigger = false;
        Layout(app, view, 40, 50, 320, 200);
        True("trigger config refreshed", Part(view, "upload-trigger") == null);
        True("hidden trigger clears drop bounds", !view.WantsDropAt(41, 51));
        shared.Clear();
        Layout(app, view, 40, 50, 320, 200);
        True("shared clear refreshed", Part(view, "upload-item") == null);

        // ---- Dragger and picture card retained routing ------------------
        Upload dr = new Upload();
        Wire(dr);
        dr.Dragger = true; dr.Tip = "支持 png/jpg";
        Layout(app, dr, 60, 70, 360, 200);
        Control dragger = Part(dr, "upload-dragger");
        True("dragger retained", dragger != null);
        if (dragger != null) {
            True("dragger tall", dragger.bh > app.Scale(90));
            True("dragger drop", dr.WantsDropAt(dragger.bx + 1, dragger.by + 1));
        }
        ClickPart(app, Part(dr, "upload-dragger-text"));
        True("dragger child routes picker", dr.DialogOpen());
        dr.CloseDialog(); dr.TakeDialogResult(); dr.SweepDialogClosed();

        Upload pc = new Upload();
        Wire(pc); pc.PictureCard = true; pc.ShowDownloadButton = true;
        UploadFile t2 = pc.AddFile("c1.jpg", "", "http://host/c1.jpg");
        Layout(app, pc, 500, 50, 300, 200);
        Control tile = Part(pc, "upload-tile");
        Control add = Part(pc, "upload-tile-add");
        True("tile retained", tile != null);
        True("add retained", add != null);
        if (tile != null) { Eq("tile size", tile.bw, app.Scale(96)); }
        True("card drop zone", pc.WantsDropAt(510, 60));
        beforeDownload = downloadCount;
        ClickPart(app, Part(pc, "upload-tile-download"));
        Eq("card download routes", downloadCount, beforeDownload + 1);
        ClickPart(app, add);
        True("card add routes picker", pc.DialogOpen());
        pc.CloseDialog(); pc.TakeDialogResult(); pc.SweepDialogClosed();
        ClickPart(app, Part(pc, "upload-tile-remove"));
        Eq("card remove routes", pc.Files.Count, 0);
        app.SetRootControl(null);
        MakeReleasedTree();
        True("upload event graph released", releasedUpload == null);
        True("upload file owner weak", releasedFile == null);

        // ---- Multiple：内建弹窗走多选模式 -----------------------------
        // 弹窗本体是 FilePicker 的独立窗口，这里只钉住组件侧的路由与
        // 消费：Multiple 决定 BeginOpenFileFiltersMulti，确认后
        // SelectedPaths 里的每条路径都过 Accept/Max 门入列。
        Upload mu = new Upload();
        Wire(mu);
        mu.Multiple = true;
        mu.Accept = "png,jpg";
        mu.Max = 3;
        Eq("multi default off", (new Upload()).Multiple ? 1 : 0, 0);
        mu.OpenDialog();
        True("multi dialog open", mu.DialogOpen());
        // 模拟用户在弹窗里勾选了 3 个文件（1 个类型不符）并确认。
        List<string> picked = new List<string>();
        picked.Add("a.png");
        picked.Add("b.jpg");
        picked.Add("c.exe");
        picked.Add("d.png");
        List<string> admitted = new List<string>();
        int i = 0;
        while (i < picked.Count) {
            if (picked[i] == "c.exe") { i = i + 1; continue; }
            admitted.Add(picked[i]);
            i = i + 1;
        }
        mu.AddPaths(admitted);
        Eq("multi admitted count", mu.Files.Count, 3);
        Eq("multi exceed not fired", exceedCount, 0);
        mu.Clear();

        // ---- 内建弹窗的上次目录缓存 + Max 上限透传 ----------------------
        // lastDir：OpenDialog 不传初始目录，FilePicker 在生命周期内记住
        // 上一次浏览的目录，连续打开不再回到工作目录（用户点选需求）。
        // maxSelect：Upload.Max 透传进弹窗，窗口内显示「已选 x/N」，
        // 选到上限后点新行被拦截。
        Upload cu = new Upload();
        cu.Max = 3;
        cu.Multiple = true;
        cu.OpenDialog();
        True("cache dialog open", cu.DialogOpen());
        FilePicker pk = cu.Picker();
        True("picker exposed", pk != null);
        if (pk != null) {
            Eq("max passthrough", pk.MaxSelect(), 3);
            // 模拟首次浏览到临时目录后关闭再开：lastDir 应续用。
            // Windows 临时目录带反斜杠，FilePicker 内部统一成正斜杠。
            string probe = Path.GetTempPath() + "upload_test_lastdir";
            probe = probe.Replace("\\", "/");
            if (probe.EndsWith("/")) {
                probe = probe.Substring(0, probe.Length - 1);
            }
            Directory.CreateDirectoryUtf8(probe);
            string first = pk.LastDirectory();
            True("lastdir seeded", first != "");
            pk.Navigate(probe);
            EqStr("lastdir after navigate", pk.LastDirectory(), probe);
            cu.CloseDialog();
            cu.OpenDialog();
            True("cache reopen open", cu.DialogOpen());
            EqStr("lastdir remembered across opens", pk.LastDirectory(), probe);
            True("lastdir became initial", pk.CurrentDirectory() == probe);
            cu.CloseDialog();
            Directory.Delete(probe);
        }
        // 上限 0（没配 Max 的多选）= 弹窗不设限，由宿主 Admit 门兜底。
        Upload nu = new Upload();
        nu.Multiple = true;
        nu.Accept = ".png,.jpg,.jpeg";
        nu.OpenDialog();
        True("no-max dialog open", nu.DialogOpen());
        FilePicker npk = nu.Picker();
        True("no-max picker exposed", npk != null);
        if (npk != null) {
            Eq("no max means unlimited", npk.MaxSelect(), 0);
            True("matches png", npk.MatchesCurrentFilter("pic.png"));
            True("matches jpg", npk.MatchesCurrentFilter("pic.jpg"));
            True("matches jpeg", npk.MatchesCurrentFilter("pic.jpeg"));
            True("rejects exe", !npk.MatchesCurrentFilter("pic.exe"));
            nu.CloseDialog();
        }
        // 清场：后面注册表/路由断言要求 AnyPickerOpen 为 false。
        cu.CloseDialog();

        // ---- ChildWindows 注册表：Form.Run 自动泵送的内建弹窗 ----------
        // 上面的 mu.OpenDialog 已把弹窗登记进 ChildWindows。关闭后注册表
        // 移出（PrunePickers），复用同一 picker 的第二次 OpenDialog 必须
        // 重新登记——否则标准循环不再泵它，第二次开弹窗就卡死（用户
        // 报告的「多文件上传打开卡死」）。用 Wants/AnyPickerOpen 钉住：
        // 开着时主循环轮询，关掉后恢复阻塞等待。
        True("picker registered while open", ChildWindows.AnyPickerOpen());
        True("picker wakes main loop", ChildWindows.Wants());
        mu.OpenDialog();
        mu.CloseDialog();
        True("picker pruned after close", !ChildWindows.AnyPickerOpen());
        mu.OpenDialog();
        True("picker re-registered", ChildWindows.AnyPickerOpen());
        True("picker wakes again", ChildWindows.Wants());
        mu.CloseDialog();
        True("picker pruned again", !ChildWindows.AnyPickerOpen());

        // ---- 多实例路由：关掉的弹窗不得吞别人的事件 ---------------------
        // 复现 gallery 的「第一个演示开过弹窗后，后面演示的弹窗点不动」：
        // 宿主按「谁拥有谁处理」折叠扫描 ApplyEventWindow 的返回值，
        // 而 FilePicker.ApplyEvent 对非属主窗口返回 true（回路继续
        // 语义）。组件侧按 OwnsWindow 门控后，非属主一律 false。
        Upload ra = new Upload();
        Upload rb = new Upload();
        ra.OpenDialog();
        True("a dialog open", ra.DialogOpen());
        nint ah = ra.DialogWindowHandle();
        True("a handle non-zero", ah != 0);
        // 非属主：别的组件、别的窗口句柄都必须 false。
        True("b not owner of a", !rb.ApplyEventWindow(ah));
        True("b no own handle", rb.DialogWindowHandle() == 0);
        ra.CloseDialog();
        ra.SweepDialogClosed();
        True("a closed", !ra.DialogOpen());
        // 关闭后句柄归零：残留的旧窗口不得再认领事件。
        True("a handle cleared", ra.DialogWindowHandle() == 0);
        True("a not owner after close", !ra.ApplyEventWindow(ah));
        // B 打开后收到自己窗口的事件；A（已关）不认领。
        rb.OpenDialog();
        True("b dialog open", rb.DialogOpen());
        nint bh = rb.DialogWindowHandle();
        True("b handle non-zero", bh != 0);
        True("b owns own", rb.ApplyEventWindow(bh));
        True("a not owner of b", !ra.ApplyEventWindow(bh));
        rb.CloseDialog();
        rb.SweepDialogClosed();
        True("b closed", !rb.DialogOpen());

        if (fails == 0) {
            Console.WriteLine("upload_test OK");
        } else {
            Console.WriteLine("upload_test FAILURES " + fails);
        }
    }

    static int aliasHits;
    static void OnAlias() { aliasHits = aliasHits + 1; }
}
