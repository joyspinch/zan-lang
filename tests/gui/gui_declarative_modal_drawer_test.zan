using System;
using Gui;
using Gui.Widget;

class GuiDeclarativeModalDrawerTest {
    static int fails = 0;

    static void Check(string desc, bool ok) {
        if (ok) {
            Console.WriteLine("[PASS] " + desc);
        } else {
            Console.WriteLine("[FAIL] " + desc);
            fails = fails + 1;
        }
    }

    static void Main(string[] args) {
        Form win = new Form("Modal & Drawer Test", 800, 600);

        // ----------------- 1. Modal 模态对话框测试 -----------------
        Label modalContent = new Label("这是对话框内部复杂的表单或数据视图");
        bool okTriggered = false;
        bool cancelTriggered = false;

        Modal modal = Modal.Create("用户信息编辑")
            .Width(500)
            .Content(modalContent)
            .OkText("确认提交")
            .CancelText("取消关闭")
            .OnOk(() => { okTriggered = true; })
            .OnCancel(() => { cancelTriggered = true; });

        Check("Modal initially closed", !modal.IsOpen());
        modal.Show();
        Check("Modal opened after Show()", modal.IsOpen());

        win.Add(modal);

        // 渲染一帧捕获快照并让排版层执行 Arrange
        Canvas snapshot1 = win.CaptureSnapshot();
        Check("Snapshot 1 created", snapshot1 != null);

        // 验证 Modal 居中几何（宽 500，窗口 800，左右居中则 x 坐标约为 (800-500)/2 = 150）
        Card box = modal.Box();
        Check("Modal box attached and measured", box != null && box.bw == 500);
        Check("Modal box horizontally centered", box.bx == 150);
        Check("Modal box vertically positioned in upper region", box.by > 0 && box.by < 300);

        // 测试隐藏
        modal.Hide();
        Check("Modal closed after Hide()", !modal.IsOpen());

        // ----------------- 2. Drawer 抽屉组件测试 -----------------
        Label drawerContent = new Label("抽屉内部的详细属性面板");
        Drawer drawer = Drawer.Create("数据抽屉")
            .Placement("right")
            .Width(300)
            .Content(drawerContent);

        Check("Drawer initially closed", !drawer.IsOpen());
        drawer.Show();
        Check("Drawer opened after Show()", drawer.IsOpen());

        win.Add(drawer);

        // 渲染一帧捕获快照
        Canvas snapshot2 = win.CaptureSnapshot();
        Check("Snapshot 2 created", snapshot2 != null);

        Panel dbox = drawer.Box();
        Check("Drawer box attached", dbox != null);
        Check("Drawer width matches size (300)", dbox.bw == 300);
        Check("Drawer height spans client area", dbox.bh == win.bh);
        // 贴右排布：x 坐标应为 800 - 300 = 500
        Check("Drawer docked to the right edge (x=500)", dbox.bx == 500);

        // 切换贴左排布
        drawer.Placement("left");
        win.CaptureSnapshot();
        Check("Drawer docked to the left edge after Placement(left) (x=0)", dbox.bx == 0);

        drawer.Hide();
        Check("Drawer closed after Hide()", !drawer.IsOpen());

        if (fails == 0) {
            Console.WriteLine("ALL TESTS PASSED: Modern Modal & Drawer verified.");
        } else {
            Console.WriteLine("TOTAL FAILS: " + fails);
            Environment.Exit(1);
        }
    }
}
