using System;
using Gui;
using Gui.Widget;

class FilterWitness {
    public weak TreeView Tree;
    public weak Input Filter;
    public weak App Host;
}

class TreeFilterInputTest {
    static void Check(bool ok, string label) {
        if (!ok) { throw new Exception(label); }
    }

    static void Exercise(FilterWitness witness) {
        App app = App.CreateOffscreen("Tree filter", 320, 200);
        TreeView tree = new TreeView();
        Input filter = new Input("Search");
        tree.WithFilter(filter);
        witness.Tree = tree;
        witness.Filter = filter;
        witness.Host = app;
        app.SetRootControl(tree);
        tree.UseApp(app);
        app.BeginOffscreenFrame();
        tree.RenderInside(app, new Rect(10, 10, 280, 160));
        app.EndOffscreenFrame();
        Check(tree.Children.Count == 2 && tree.RowCount() == 0 && filter.parent == tree, "real filter/body tree keeps business row mapping empty");
        int x = filter.bx + filter.bw / 2;
        int y = filter.by + filter.bh / 2;
        Check(tree.HitTest(x, y, 0) == filter, "filter hit must enter input subtree");
        app.ProcessOffscreenInput(2, x, y, 0, 0, 0, 0);
        app.ProcessOffscreenInput(3, x, y, 0, 0, 0, 0);
        Check(filter.IsFocused(app), "pointer focuses filter");
        app.ProcessOffscreenInput(6, 0, 0, 0, 65, 0, 0);
        Check(filter.GetText() == "A", "filter edits before repaint");
        app.CapturePointer(filter);
        Input replacement = new Input("Replacement");
        tree.WithFilter(replacement);
        Check(app.GetCapturedPointer() == null && !filter.IsFocused(app), "replacement releases old input state");
        Check(filter.parent == null && filter.FindApp() == null, "replacement detaches old host");
        Check(replacement.parent == tree && tree.RowCount() == 0 && tree.Children.Count == 2, "replacement preserves real structure and business row mapping");

        App other = App.CreateOffscreen("Other tree host", 320, 200);
        app.SetRootControl(null);
        other.SetRootControl(tree);
        tree.UseApp(other);
        Check(replacement.FindApp() == other, "real filter inherits moved host immediately");
        replacement.Focus(other);
        other.ProcessOffscreenInput(6, 0, 0, 0, 66, 0, 0);
        Check(replacement.GetText() == "B" && replacement.FindApp() == other,
            "filter inherits moved host before repaint");
        tree.WithFilter(null);
        Check(!replacement.IsFocused(other) && replacement.parent == null, "remove filter releases focus");
        other.SetRootControl(null);
        other.canvas.Destroy();
        app.canvas.Destroy();
    }

    static void Main() {
        App frame = App.CreateOffscreen("Frame context", 2, 2);
        FilterWitness witness = new FilterWitness();
        Exercise(witness);
        Check(witness.Tree == null && witness.Filter == null && witness.Host == null, "filter tree lifetime");
        frame.canvas.Destroy();
        Console.WriteLine("TREEVIEW_FILTER_INPUT_OK");
    }
}
