using System;
using Gui;
using Gui.Component;
using Gui.Component.CefBrowser;

// Depends on the independent Ribbon ControlInputHost candidate and hosted delta.
class BrowserControlHostLifecycleTest {
    static void Check(bool value, string message) {
        if (!value) { throw new Exception(message); }
    }
    static void Turn(App app) { app.ProcessOffscreenInput(0, 0, 0, 0, 0, 0, 0); }
    static void Main() {
        Check(!CefHost.IsRunning(), "offline fixture requires unstarted CEF");
        App frame = App.CreateOffscreen("Independent frame", 16, 16);
        App app = App.CreateOffscreen("Borrowed browser", 640, 480);
        Control fallback = new Control("fallback"); fallback.UseApp(app);
        app.SetRootControl(fallback);
        Control borrowed = new Control("borrowed");
        borrowed.bw = 300; borrowed.bh = 220;
        CefBrowserBox box = new CefBrowserBox(); borrowed.Add(box);
        ControlInputHost host = new ControlInputHost(borrowed); host.Bind(app);
        box.Arrange(0, 0, 240, 160);
        BrowserNativeEntry first = box.view.nativeEntry;
        Turn(app);
        borrowed.Visible = false;
        Check(!host.ContainsInputControl(box) && host.ContainsHostedControl(box),
            "hidden borrowed content remains hosted independently of input filter");
        Turn(app);
        Check(!first.retired && !first.shown, "hidden borrowed native surface progresses while hidden");
        borrowed.Visible = true;
        host.Hide(); Turn(app);
        Check(first.retired && app.rootControl == fallback,
            "host Hide detaches borrowed content and retires endpoint");
        host.Bind(app); box.Arrange(0, 0, 240, 160); Turn(app);
        BrowserNativeEntry rebound = box.view.nativeEntry;
        Check(rebound != first && !rebound.retired && host.ContainsHostedControl(box),
            "host rebind restores new native lifecycle");
        Control replacement = new Control("replacement"); replacement.UseApp(app);
        app.SetRootControl(replacement); Turn(app);
        Check(rebound.retired, "external root replacement retires borrowed endpoint");
        app.StopLoop(); app.SetRootControl(null); app.canvas.Destroy(); frame.canvas.Destroy();
        Console.WriteLine("control host hidden content / hide / rebind / root replacement: ok");
        Console.WriteLine("browser_control_host_lifecycle: ok");
    }
}
