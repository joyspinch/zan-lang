// 用户 Main 优先（B-ID147）：源里同时有用户 static Main 与零参
// DocApp.Bootstrap() 调用时，编译器不得合成 __ZanDocMain 入口——
// 用户 Main 整体优先。Bootstrap 调用放在永不执行的死方法里（类型
// 检查看得见、运行期不开窗）；若 shim 被错误注入，入口会是
// __DesignMain 开窗阻塞，输不出 USER_MAIN_WINS。
using System;
using Gui;

class UserMainWins {
    static void Never() {
        DocApp.Bootstrap();
    }

    static void Main() {
        Console.WriteLine("USER_MAIN_WINS");
    }
}
