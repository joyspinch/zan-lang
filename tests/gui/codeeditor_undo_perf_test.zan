using System;
using Gui;
using Gui.Widget;

namespace CodeEditorUndoPerfTest;

class Program {
    static void Assert(bool cond, string msg) {
        if (!cond) {
            Console.WriteLine("FAIL: " + msg);
            Environment.Exit(1);
        }
    }

    static void Main() {
        // 1. 连续输入字符合并测试
        CodeEditor e = new CodeEditor();
        e.lines[0] = "";
        e.curLine = 0;
        e.curCol = 0;

        string word = "hello";
        for (int i = 0; i < word.Length; i = i + 1) {
            e.SaveUndoTyping();
            e.InsertStr(word.Substring(i, 1));
        }

        Assert(e.lines[0] == "hello", "lines[0] should be 'hello'");
        Assert(e.undoStack.Count == 1, "continuous typing should coalesce into 1 undo snapshot");

        // 撤销一次，回到初始状态
        e.Undo();
        Assert(e.lines[0] == "", "after undo, lines[0] should be empty");
        Assert(e.curCol == 0, "after undo, curCol should be 0");

        // 重做一次，回到 "hello"
        e.Redo();
        Assert(e.lines[0] == "hello", "after redo, lines[0] should be 'hello'");
        Assert(e.curCol == 5, "after redo, curCol should be 5");

        // 2. 换行终结合并事务
        e.EndUndoGroup();
        e.SaveUndo();
        e.NewLine();
        e.SaveUndoTyping();
        e.InsertStr("world");

        Assert(e.lines.Count == 2, "lines count should be 2");
        Assert(e.lines[1] == "world", "lines[1] should be 'world'");

        // 撤销 world
        e.Undo();
        Assert(e.lines[1] == "", "after undo world, line 1 should be empty");

        // 撤销换行
        e.Undo();
        Assert(e.lines.Count == 1, "after undo newline, line count should be 1");
        Assert(e.lines[0] == "hello", "line 0 should be hello");

        // 3. 连续退格合并测试
        CodeEditor bk = new CodeEditor();
        bk.lines[0] = "hello";
        bk.curCol = 5;
        for (int b = 0; b < 3; b = b + 1) {
            bk.SaveUndoBackspace();
            bk.BackspaceEdit();
        }
        Assert(bk.lines[0] == "he", "after 3 backspaces, line 0 should be 'he'");
        Assert(bk.undoStack.Count == 1, "continuous backspaces should coalesce into 1 undo snapshot");

        // 撤销退格，恢复成 "hello"
        bk.Undo();
        Assert(bk.lines[0] == "hello", "after undo backspace, line 0 should be 'hello'");

        // 4. 大文档性能测试（3000 行文本）
        CodeEditor big = new CodeEditor();
        for (int l = 1; l < 3000; l = l + 1) {
            big.lines.Add("int value_" + Convert.ToString(l) + " = " + Convert.ToString(l * 10) + ";");
        }
        Assert(big.lines.Count == 3000, "big lines count should be 3000");

        // 测试连续 50 次单字输入与撤销
        for (int k = 0; k < 50; k = k + 1) {
            big.SaveUndoTyping();
            big.InsertStr("a");
        }
        Assert(big.undoStack.Count == 1, "50 typing operations on 3000 lines should be 1 snapshot");

        big.Undo();
        Assert(big.lines[0] == "", "big file undo succeeded");
        big.Redo();
        Assert(big.lines[0].Length == 50, "big file redo succeeded");

        Console.WriteLine("ALL_TESTS_PASSED");
    }
}
