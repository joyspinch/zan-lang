using System;
using Gui;
using Gui.Widget;

partial class DesignFormSizeLarge { void OnInit() { } }
partial class DesignFormSizeDefault { void OnInit() { } }
partial class DesignFormSizeSmall { void OnInit() { } }

class DesignFormSizeTest {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void Main() {
        DesignFormSizeLarge large = new DesignFormSizeLarge();
        DesignFormSizeDefault medium = new DesignFormSizeDefault();
        DesignFormSizeSmall small = new DesignFormSizeSmall();

        DesignFormSizeTest.Eq("large default class",
            large.AutoButton.GetProp("class"), "text large");
        DesignFormSizeTest.Eq("nested large class",
            large.NestedButton.GetProp("class"), "text large");
        DesignFormSizeTest.Eq("explicit size wins",
            large.ExplicitButton.GetProp("class"), "text tiny");
        DesignFormSizeTest.Eq("medium default class",
            medium.AutoButton.GetProp("class"), "text");
        DesignFormSizeTest.Eq("small default class",
            small.AutoButton.GetProp("class"), "text small");

        App app = new App("form-size", 320, 160);
        large.AutoButton.MeasureTree(app);
        medium.AutoButton.MeasureTree(app);
        small.AutoButton.MeasureTree(app);
        if (!(large.AutoButton.prefH > medium.AutoButton.prefH &&
              medium.AutoButton.prefH > small.AutoButton.prefH)) {
            fails = fails + 1;
            Console.WriteLine("FAIL button heights do not follow large > medium > small");
        }
        if (!(large.AutoButton.prefW > medium.AutoButton.prefW &&
              medium.AutoButton.prefW > small.AutoButton.prefW)) {
            fails = fails + 1;
            Console.WriteLine("FAIL button widths do not follow size padding");
        }

        if (fails == 0) { Console.WriteLine("FORM_SIZE_OK"); }
    }
}
