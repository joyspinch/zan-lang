using System;
using System.IO;
using System.Web;
using Gui;
using Gui.Widget;

class DesignFormSizeTest {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static Control Build(string file) {
        string html = File.ReadAllText(file);
        return FormBuilder.Build(JsonValue.ParseLenient(DesignerHtml.ToJsonDoc(html)));
    }

    static void Main() {
        Control large = Build("tests/gui/design_form_size_large.html");
        Control medium = Build("tests/gui/design_form_size_default.html");
        Control small = Build("tests/gui/design_form_size_small.html");
        Control la = large.Find("AutoButton");
        Control ma = medium.Find("AutoButton");
        Control sa = small.Find("AutoButton");
        if (la == null || ma == null || sa == null) {
            Console.WriteLine("FAIL missing AutoButton");
            return;
        }

        DesignFormSizeTest.Eq("large default class",
            la.GetProp("class"), "text large");
        Control nb = large.Find("NestedButton");
        Control eb = large.Find("ExplicitButton");
        if (nb == null || eb == null) {
            Console.WriteLine("FAIL missing NestedButton/ExplicitButton");
            return;
        }
        DesignFormSizeTest.Eq("nested large class",
            nb.GetProp("class"), "text large");
        DesignFormSizeTest.Eq("explicit size wins",
            eb.GetProp("class"), "text tiny");
        DesignFormSizeTest.Eq("medium default class",
            ma.GetProp("class"), "text");
        DesignFormSizeTest.Eq("small default class",
            sa.GetProp("class"), "text small");

        App app = new App("form-size", 320, 160);
        la.MeasureTree(app);
        ma.MeasureTree(app);
        sa.MeasureTree(app);
        if (!(la.prefH > ma.prefH && ma.prefH > sa.prefH)) {
            fails = fails + 1;
            Console.WriteLine("FAIL button heights do not follow large > medium > small");
        }
        if (!(la.prefW > ma.prefW && ma.prefW > sa.prefW)) {
            fails = fails + 1;
            Console.WriteLine("FAIL button widths do not follow size padding");
        }
        app.canvas.Destroy();

        if (fails == 0) { Console.WriteLine("FORM_SIZE_OK"); }
    }
}
