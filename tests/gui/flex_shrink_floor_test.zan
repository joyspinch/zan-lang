using System;
using Gui;
using Gui.Widget;

// 无窗口回归：flex 收缩的 min-content 下限（A545，CSS `min-width:auto`
// 的近似）。溢出行的比例收缩不再把内容不可重排的子项压扁——内容
// 测得的叶子停在自然尺寸，缺口转摊给还能让位（可重排）的子项，
// 恰好填满时精确对齐右缘，全都顶住时整行按自然尺寸溢出。作者声明
// 尺寸（Prefer → prefSet）与 `flex-shrink: 0` 的老行为保持不变。
class Program {
    static void Line(string s) { Console.WriteLine(s); }

    // 内容测得的叶子：模拟 OnMeasure 的产物——prefW/prefH 直接落
    // 字段，不走 Prefer()（那会置 prefSet，成为"作者尺寸"，可协商）。
    static Control Measured(int w, int h) {
        Label l = new Label("x");
        l.prefW = w;
        l.prefH = h;
        return l;
    }

    // 可重排的"容器"叶子：prefW/prefH 由流内容补齐（fillW/fillH），
    // 两个轴都无内在下限，照旧按比例收缩。
    static Control Flow(int w, int h) {
        Label l = new Label("x");
        l.prefW = w;
        l.prefH = h;
        l.fillW = true;
        l.fillH = true;
        return l;
    }

    // 作者声明尺寸的叶子：Prefer() 置 prefSet，照旧按比例收缩。
    static Control Authored(int w, int h) {
        Label l = new Label("x");
        l.Prefer(w, h);
        return l;
    }

    // 直接构造一个 flex 容器的已解析样式（与 flex_test 同款）。
    static StyleBox FlexBox(int dir, int wrap, int gap) {
        StyleBox b = new StyleBox();
        b.display = 1;
        b.flexDir = dir;
        b.wrap = wrap;
        b.gap = gap;
        return b;
    }

    // 子项样式：`flex-shrink: 0`（行溢出时不让位）。
    static StyleBox Fixed() {
        StyleBox b = new StyleBox();
        b.shrink = 0;
        return b;
    }

    static void Dump(string label, Control c) {
        for (int i = 0; i < c.children.Count; i = i + 1) {
            Control k = c.children[i];
            Line($"{label}[{i}] {k.bx},{k.by} {k.bw}x{k.bh}");
        }
    }

    static void Main() {
        // ---- 内容测得的叶子不再被压扁：两个 200 顶在自然尺寸，整行
        // 溢出 300 的容器——溢出可见好过压成 0 宽（看不见也点不着）。
        Line("=== measured leaves hold natural width ===");
        Flex a = new Flex();
        a.computedStyle = Program.FlexBox(0, 0, 0);
        a.Add(Program.Measured(200, 30));
        a.Add(Program.Measured(200, 30));
        a.Arrange(0, 0, 300, 60);
        Program.Dump("hold", a);

        // ---- 冻结 + 转摊：顶住下限的不动，缺口全给可重排的同伴，
        // 恰好填满 300。
        Line("=== floored item frozen, reflowable absorbs ===");
        Flex b = new Flex();
        b.computedStyle = Program.FlexBox(0, 0, 0);
        b.Add(Program.Measured(200, 30));
        b.Add(Program.Flow(200, 30));
        b.Arrange(0, 0, 300, 60);
        Program.Dump("split", b);

        // ---- 舍入余数归最后一件还能让位的：250 = 100 + 100 + 50。
        Line("=== rounding remainder to the last giver ===");
        Flex c = new Flex();
        c.computedStyle = Program.FlexBox(0, 0, 0);
        c.Add(Program.Measured(100, 30));
        c.Add(Program.Flow(200, 30));
        c.Add(Program.Flow(100, 30));
        c.Arrange(0, 0, 250, 60);
        Program.Dump("round", c);

        // ---- 纵向同理：主轴是高，测得的叶子保住高度，可重排的让位。
        Line("=== column: measured leaf holds natural height ===");
        Flex d = new Flex();
        d.computedStyle = Program.FlexBox(1, 0, 0);
        d.Add(Program.Measured(60, 80));
        d.Add(Program.Flow(60, 80));
        d.Arrange(0, 0, 200, 100);
        Program.Dump("col", d);

        // ---- 老行为不变：作者声明尺寸（Prefer）照旧按比例收缩。
        Line("=== authored (Prefer) sizes still shrink ===");
        Flex e = new Flex();
        e.computedStyle = Program.FlexBox(0, 0, 0);
        e.Add(Program.Authored(200, 30));
        e.Add(Program.Authored(200, 30));
        e.Arrange(0, 0, 300, 60);
        Program.Dump("auth", e);

        // ---- flex-shrink: 0 的子项原样不动，可收缩的独自让位。
        Line("=== shrink-0 leaf untouched ===");
        Flex f = new Flex();
        f.computedStyle = Program.FlexBox(0, 0, 0);
        Control keep = f.Add(Program.Measured(200, 30));
        keep.computedStyle = Program.Fixed();
        f.Add(Program.Flow(200, 30));
        f.Arrange(0, 0, 300, 60);
        Program.Dump("keep", f);
    }
}
