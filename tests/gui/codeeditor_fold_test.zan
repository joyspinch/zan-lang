using System;
using Gui;

namespace CodeEditorFoldTest;

// 核心契约与语义定义。
class Program {
    static void Main() {
        // ---- 注入与折叠状态 ----
        // 0 class { / 1 method { / 2 body / 3 } / 4 }
        CodeEditor e = new CodeEditor();
        List<string> ls = new List<string>();
        ls.Add("class A {");
        ls.Add("    void M() {");
        ls.Add("        int x = 1;");
        ls.Add("    }");
        ls.Add("}");
        e.SetLines(ls);
        List<int> fs = new List<int>();
        List<int> fe = new List<int>();
        fs.Add(0); fe.Add(4);
        fs.Add(1); fe.Add(3);
        e.SetFoldRanges(fs, fe);
        Console.WriteLine(e.FoldRegionCount());
        Console.WriteLine(e.FoldableAt(0));
        Console.WriteLine(e.FoldableAt(1));
        Console.WriteLine(e.FoldableAt(2));
        Console.WriteLine(e.AnyFolded());

        // ---- 折叠内层：行 2/3 隐藏，起点行 1 可见 ----
        e.ToggleFold(1);
        Console.WriteLine(e.FoldedAt(1));
        Console.WriteLine(e.FoldHides(2));
        Console.WriteLine(e.FoldHides(3));
        Console.WriteLine(e.FoldHides(1));
        Console.WriteLine(e.FoldVisibleTotal());
        Console.WriteLine(e.FoldVisibleRowOf(0));
        Console.WriteLine(e.FoldVisibleRowOf(4));
        Console.WriteLine(e.FoldDocLineOfRow(2));

        // ---- 折叠态行布局：隐藏行不占行槽 ----
        Rect area = new Rect(0, 0, 400, 60);
        e.BuildRowLayout(area, 20, 0);
        Console.WriteLine(e.rowLine.Count);
        Console.WriteLine(e.rowLine[0]);
        Console.WriteLine(e.rowLine[1]);
        Console.WriteLine(e.rowLine[2]);
        Console.WriteLine(e.LineTopY(2));

        // ---- 光标落点保护：展开覆盖区间 ----
        e.curLine = 2;
        e.UnfoldContaining(e.curLine);
        Console.WriteLine(e.AnyFolded());

        // ---- 外层折叠 + 内层保持折叠：嵌套各自隐藏 ----
        e.ToggleFold(1);
        e.ToggleFold(0);
        Console.WriteLine(e.FoldedAt(0));
        Console.WriteLine(e.FoldedAt(1));
        Console.WriteLine(e.FoldVisibleTotal());
        e.UnfoldAll();
        Console.WriteLine(e.AnyFolded());

        // ---- 编辑即全部展开（行号漂移安全态）----
        e.ToggleFold(0);
        e.lines[1] = "    void M2() {";
        e.BumpTextVersion();
        Console.WriteLine(e.AnyFolded());

        // ---- 漂移后的失效区间：不可折叠、不隐藏 ----
        List<int> fs2 = new List<int>();
        List<int> fe2 = new List<int>();
        fs2.Add(2); fe2.Add(3);
        e.SetFoldRanges(fs2, fe2);
        e.ToggleFold(2);
        Console.WriteLine(e.FoldableAt(2));
        Console.WriteLine(e.AnyFolded());
        Console.WriteLine(e.FoldHides(3));

        // ---- 无折叠时布局与映射恒等 ----
        List<int> none = new List<int>();
        e.SetFoldRanges(none, new List<int>());
        Console.WriteLine(e.FoldRegionCount());
        Console.WriteLine(e.FoldVisibleRowOf(3));
        Console.WriteLine(e.FoldDocLineOfRow(3));
        e.BuildRowLayout(area, 20, 0);
        Console.WriteLine(e.rowLine.Count);
    }
}
