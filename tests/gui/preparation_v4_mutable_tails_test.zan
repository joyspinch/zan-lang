using System;
using Gui;
namespace Gui;

// SOURCE ONLY. Exercises the real prepared PresentFrame -> present tails path.
internal class V4TailLayout : AppHostLayout {
    internal override bool SyncLayout(App app, bool forInput) { return true; }
}

class PreparationV4MutableTailsTest {
    static AppLoopRegistration host;
    static bool clear;
    static bool proofStayedCurrent;
    static int firstCalls;
    static int secondCalls;
    static void Check(bool ok, string message) { if (!ok) { throw new Exception(message); } }
    static void First(App app) {
        firstCalls = firstCalls + 1;
        if (clear) { App.presentTails.Clear(); }
        else { App.presentTails.RemoveAt(0); }
        proofStayedCurrent = app.HostLayoutPrepared(host);
    }
    static void Second(App app) { secondCalls = secondCalls + 1; }
    static void RunCase(bool clearList) {
        App app = App.CreateOffscreen("mutable tails", 160, 100);
        host = app.RegisterLoopParticipant(app, new V4TailLayout());
        clear = clearList; firstCalls = 0; secondCalls = 0; proofStayedCurrent = false;
        App.presentTails = null;
        App.AddPresentTail(First); App.AddPresentTail(Second);
        Check(App.presentTails.Count == 2, "two real tails registered");
        app.BeginOffscreenFrame();
        Check(app.PrepareStandardHostFrame(), "standard host frame prepared");
        app.PresentFrame();
        Check(firstCalls == 1 && secondCalls == 0, "dynamic Count preserves existing removal/skip semantics");
        Check(proofStayedCurrent && !app.preparationFrameAborted && app.HostLayoutPrepared(host),
            "collection mutation leaves frame proof current and does not cause out-of-range access");
        Check(App.presentTails.Count == (clearList ? 0 : 1), "callback mutated the actual shared list");
        host.Invalidate(); host = null; app.StopLoop(); app.canvas.Destroy();
    }
    static void Main() {
        App sentinel = App.CreateOffscreen("mutable tails sentinel", 1, 1);
        var prior = App.presentTails;
        try { RunCase(true); RunCase(false); }
        finally { App.presentTails = prior; }
        sentinel.canvas.Destroy();
        Console.WriteLine("preparation-v4-mutable-tails:ok");
    }
}
