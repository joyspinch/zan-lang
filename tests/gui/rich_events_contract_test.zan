using System;
using Gui;
using Gui.Widget;
using Gui.Designer;
using System.Web;
using System.Json;
using Gui.Component.DataTable;

class RichEventsContractTest {
    static int fails;

    static void Fail(string msg) {
        fails = fails + 1;
        Console.WriteLine("FAIL: " + msg);
    }

    static void AssertEq(string actual, string expect, string desc) {
        if (actual != expect) {
            Fail(desc + " expected '" + expect + "' but got '" + actual + "'");
        }
    }

    static void AssertTrue(bool condition, string desc) {
        if (!condition) {
            Fail(desc + " condition is false");
        }
    }

    static void Main() {
        TestHtmlEventNormalization();
        TestTabsDeclarativeBinding();
        TestControlRichEvents();
        TestDataGridRichEvents();
        TestTreeViewRichEvents();
        TestPaginationRichEvents();

        if (fails == 0) {
            Console.WriteLine("RICH_EVENTS_CONTRACT_TEST_OK");
        } else {
            Console.WriteLine("RICH_EVENTS_CONTRACT_TEST_FAIL (fails=" + Convert.ToString(fails) + ")");
        }
    }

    static void TestHtmlEventNormalization() {
        string html = "<div id=\"Box\" "
            + "@click=\"OnClick\" "
            + "@dblclick=\"OnDbl\" "
            + "@right-click=\"OnRightClick\" "
            + "@right-dblclick=\"OnRightDbl\" "
            + "@tab-change=\"OnTabChange\" "
            + "@row-click=\"OnRowClick\" "
            + "@row-dblclick=\"OnRowDbl\" "
            + "@cell-click=\"OnCellClick\" "
            + "@cell-dblclick=\"OnCellDbl\" "
            + "@col-click=\"OnColClick\" "
            + "@column-resize=\"OnColResize\" "
            + "@column-reorder=\"OnColReorder\" "
            + "@sort=\"OnSort\" "
            + "@filter-change=\"OnFilter\" "
            + "@node-click=\"OnNodeClick\" "
            + "@page-change=\"OnPageChange\" "
            + "@show=\"OnShow\" "
            + "@hide=\"OnHide\" "
            + "@resize=\"OnResize\" "
            + "></div>";

        string json = DesignerHtml.ToJsonDoc(html);
        JsonValue doc = JsonValue.Parse(json);
        AssertTrue(doc != null, "ToJsonDoc returns valid JSON");
        if (doc == null) { return; }

        JsonValue fields = doc.Get("fields");
        AssertTrue(fields != null && fields.Count() > 0, "Fields array has elements");
        if (fields == null || fields.Count() == 0) { return; }

        JsonValue f = fields.At(0);
        AssertEq(f.Str("onClick", ""), "OnClick", "Normalizes @click -> onClick");
        AssertEq(f.Str("onDoubleClick", ""), "OnDbl", "Normalizes @dblclick -> onDoubleClick");
        AssertEq(f.Str("onRightClick", ""), "OnRightClick", "Normalizes @right-click -> onRightClick");
        AssertEq(f.Str("onRightDoubleClick", ""), "OnRightDbl", "Normalizes @right-dblclick -> onRightDoubleClick");
        AssertEq(f.Str("onTabChanged", ""), "OnTabChange", "Normalizes @tab-change -> onTabChanged");
        AssertEq(f.Str("onRowClick", ""), "OnRowClick", "Normalizes @row-click -> onRowClick");
        AssertEq(f.Str("onRowDoubleClick", ""), "OnRowDbl", "Normalizes @row-dblclick -> onRowDoubleClick");
        AssertEq(f.Str("onCellClick", ""), "OnCellClick", "Normalizes @cell-click -> onCellClick");
        AssertEq(f.Str("onCellDoubleClick", ""), "OnCellDbl", "Normalizes @cell-dblclick -> onCellDoubleClick");
        AssertEq(f.Str("onHeaderClick", ""), "OnColClick", "Normalizes @col-click -> onHeaderClick");
        AssertEq(f.Str("onColumnResize", ""), "OnColResize", "Normalizes @column-resize -> onColumnResize");
        AssertEq(f.Str("onColumnReorder", ""), "OnColReorder", "Normalizes @column-reorder -> onColumnReorder");
        AssertEq(f.Str("onSort", ""), "OnSort", "Normalizes @sort -> onSort");
        AssertEq(f.Str("onFilterChanged", ""), "OnFilter", "Normalizes @filter-change -> onFilterChanged");
        AssertEq(f.Str("onNodeClick", ""), "OnNodeClick", "Normalizes @node-click -> onNodeClick");
        AssertEq(f.Str("onPageChanged", ""), "OnPageChange", "Normalizes @page-change -> onPageChanged");
        AssertEq(f.Str("onShow", ""), "OnShow", "Normalizes @show -> onShow");
        AssertEq(f.Str("onHide", ""), "OnHide", "Normalizes @hide -> onHide");
        AssertEq(f.Str("onResize", ""), "OnResize", "Normalizes @resize -> onResize");
    }

    static void TestTabsDeclarativeBinding() {
        Tabs tabs = new Tabs();
        tabs.SetProp("options", "Item1|Item2|Item3");
        AssertTrue(tabs.Count() == 3, "Tabs options set Count to 3");

        int tabChangeFired = 0;
        tabs.BindEvent("TabChanged", () => {
            tabChangeFired = tabChangeFired + 1;
        });

        tabs.TabChanged.Raise();
        AssertTrue(tabChangeFired == 1, "Tabs TabChanged event fired via BindEvent");
    }

    static void TestControlRichEvents() {
        Panel panel = new Panel();
        int rightClickCount = 0;
        int dblClickCount = 0;

        panel.BindEvent("RightClick", () => {
            rightClickCount = rightClickCount + 1;
        });
        panel.BindEvent("DoubleClick", () => {
            dblClickCount = dblClickCount + 1;
        });

        panel.On.RightClick.Raise();
        panel.On.DoubleClick.Raise();

        AssertTrue(rightClickCount == 1, "Panel RightClick fired via BindEvent");
        AssertTrue(dblClickCount == 1, "Panel DoubleClick fired via BindEvent");
    }

    static void TestDataGridRichEvents() {
        DataGrid<string> grid = new DataGrid<string>();
        int rowClickCount = 0;
        int cellClickCount = 0;
        int cellDblClickCount = 0;
        int rowContextCount = 0;
        int headerClickCount = 0;
        int sortCount = 0;
        int colResizeCount = 0;
        int senderFired = 0;

        grid.BindEvent("RowClick", () => {
            rowClickCount = rowClickCount + 1;
        });
        grid.BindEvent("CellClick", () => {
            cellClickCount = cellClickCount + 1;
        });
        grid.BindEvent("CellDoubleClick", () => {
            cellDblClickCount = cellDblClickCount + 1;
        });
        grid.BindEvent("RowContext", () => {
            rowContextCount = rowContextCount + 1;
        });
        grid.BindEvent("HeaderClick", () => {
            headerClickCount = headerClickCount + 1;
        });
        grid.BindEvent("Sort", () => {
            sortCount = sortCount + 1;
        });
        grid.BindEvent("ColumnResize", () => {
            colResizeCount = colResizeCount + 1;
        });

        // 测试 BindEventS 携带 sender
        grid.BindEventS("CellDoubleClick", (Control sender) => {
            if (sender == grid) {
                senderFired = senderFired + 1;
            }
        });

        grid.State().RowClick.Raise();
        grid.State().CellClick.Raise();
        grid.State().CellDoubleClick.Raise();
        grid.State().RowContext.Raise();
        grid.State().HeaderClick.Raise();
        grid.State().Sort.Raise();
        grid.State().ColumnResize.Raise();

        AssertTrue(rowClickCount == 1, "DataGrid RowClick fired via BindEvent");
        AssertTrue(cellClickCount == 1, "DataGrid CellClick fired via BindEvent");
        AssertTrue(cellDblClickCount == 1, "DataGrid CellDoubleClick fired via BindEvent");
        AssertTrue(rowContextCount == 1, "DataGrid RowContext fired via BindEvent");
        AssertTrue(headerClickCount == 1, "DataGrid HeaderClick fired via BindEvent");
        AssertTrue(sortCount == 1, "DataGrid Sort fired via BindEvent");
        AssertTrue(colResizeCount == 1, "DataGrid ColumnResize fired via BindEvent");
        AssertTrue(senderFired == 1, "DataGrid BindEventS correctly delivers grid as sender");
    }

    static void TestTreeViewRichEvents() {
        TreeView tree = new TreeView();
        int selectCount = 0;
        int expandCount = 0;
        Control selectSender = null;

        tree.BindEventS("Select", (s) => {
            selectCount = selectCount + 1;
            selectSender = s;
        });
        tree.BindEvent("Expand", () => {
            expandCount = expandCount + 1;
        });

        tree.Select.RaiseS(tree);
        tree.Expand.RaiseS(tree);

        AssertTrue(selectCount == 1, "TreeView Select fired via BindEventS");
        AssertTrue(selectSender == tree, "TreeView Select sender is tree");
        AssertTrue(expandCount == 1, "TreeView Expand fired via BindEvent");
    }

    static void TestPaginationRichEvents() {
        Pagination pager = new Pagination(10);
        int pageChangedCount = 0;
        int pageSizeChangedCount = 0;
        Control pageSender = null;

        pager.BindEventS("Change", (s) => {
            pageChangedCount = pageChangedCount + 1;
            pageSender = s;
        });
        pager.BindEvent("SizeChange", () => {
            pageSizeChangedCount = pageSizeChangedCount + 1;
        });

        pager.Change.RaiseS(pager);
        pager.SizeChange.RaiseS(pager);

        AssertTrue(pageChangedCount == 1, "Pagination Change fired via BindEventS");
        AssertTrue(pageSender == pager, "Pagination Change sender is pager");
        AssertTrue(pageSizeChangedCount == 1, "Pagination SizeChange fired via BindEvent");
    }
}
