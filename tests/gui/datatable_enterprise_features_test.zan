using System;
using System.IO;
using System.IO.Compression;
using System.Text;
using Gui;
using Gui.Widget;
using Gui.Backend;
using Gui.Component.DataTable;

class CustomBadgeRenderer : CellRenderer {
    int calls;

    CustomBadgeRenderer() {
        this.calls = 0;
    }

    override bool Paint(App app, Canvas c, DataSource src, int row, int col,
                       int x, int y, int w, int h, bool selected, bool hovered) {
        this.calls = this.calls + 1;
        return true;
    }
}

class CustomUpperEditor : CellEditor {
    Input input;

    CustomUpperEditor() {
        this.input = null;
    }

    override Control CreateWidget(App app, DataTableState st, DataColumn col) {
        if (this.input == null) {
            this.input = new Input();
        }
        return this.input;
    }

    override void BeginEdit(Control ctl, string initValue, DataColumn col) {
        Input inp = (Input)ctl;
        inp.SetText(initValue);
    }

    override string GetValue(Control ctl, DataColumn col) {
        Input inp = (Input)ctl;
        return inp.GetText();
    }
}

class MinLengthValidator : CellValidator {
    int minLen;

    MinLengthValidator(int len) {
        this.minLen = len;
    }

    override string Validate(DataColumn col, string value, int row, int colIdx) {
        if (value.Length < this.minLen) {
            return "Too short";
        }
        return "";
    }
}

class TestRowSource : DataSource {
    List<string> names;
    List<string> roles;
    List<string> scores;

    TestRowSource() {
        names = new List<string>();
        roles = new List<string>();
        scores = new List<string>();
        names.Add("Alice"); roles.Add("Admin"); scores.Add("100");
        names.Add("Bob"); roles.Add("Engineer"); scores.Add("60");
    }

    override int RowCount() { return names.Count; }
    override string CellText(int row, int col) {
        if (col == 0) { return names[row]; }
        if (col == 1) { return roles[row]; }
        return scores[row];
    }
    override void SetCell(int row, int col, string v) {
        if (col == 0) { names[row] = v; }
        else if (col == 1) { roles[row] = v; }
        else { scores[row] = v; }
    }
}

class TestCustomSummaryProvider : CustomSummaryProvider {
    override string CalculateSummary(DataTableState st, List<DataColumn> cols, DataSource src, int col) {
        if (col == 1) {
            return "CustomSum: $999,999";
        }
        return null;
    }
}

class TestPerson {
    string name;
    int score;
    TestPerson(string n, int s) { this.name = n; this.score = s; }
}

class Program {
    static void Main() {
        // 1. 测试 DataColumn 现代构建器 (Renderer, Editor, Slot)
        CustomBadgeRenderer badgeR = new CustomBadgeRenderer();
        CustomUpperEditor upperEd = new CustomUpperEditor();

        DataColumn c0 = DataColumn.Renderer(DataColumn.Field(DataColumn.Text("Name", 120), "name"), badgeR);
        DataColumn c1 = DataColumn.Editor(DataColumn.Field(DataColumn.Text("Role", 150), "role"), upperEd);
        DataColumn c2 = DataColumn.Slot(DataColumn.Text("Action", 100), "action-slot");

        if (c0.renderer == badgeR) { Console.WriteLine("renderer-bound=1"); }
        if (c1.editor == upperEd && c1.editable) { Console.WriteLine("editor-bound=1"); }
        if (c2.slot == "action-slot") { Console.WriteLine("slot-bound=1"); }

        // 2. 测试 CellEditor 生命周期与 DataTable.BeginEdit / CommitEdit 挂接
        List<DataColumn> cols = new List<DataColumn>();
        cols.Add(c0);
        cols.Add(c1);

        TestRowSource src = new TestRowSource();
        DataTableState st = new DataTableState();
        DataTable.EnsureInit(st, cols, src);

        // 开启编辑第 1 行第 1 列（Role 列）
        DataTable.BeginEdit(st, cols, src, 1, 1);
        if (st.editing && st.editRow == 1 && st.editCol == 1) {
            Console.WriteLine("editing-active=1");
        }
        if (st.activeEditorWidget != null) {
            Console.WriteLine("widget-attached=1");
        }

        // 模拟用户在 Input 中输入新值
        Input activeInp = (Input)st.activeEditorWidget;
        activeInp.SetText("Lead Architect");

        // 提交编辑
        DataTable.CommitEdit(st, cols, src);
        if (!st.editing && st.activeEditorWidget == null) {
            Console.WriteLine("editing-settled=1");
        }
        if (src.CellText(1, 1) == "Lead Architect") {
            Console.WriteLine("src-updated=1");
        }

        // 3. 测试 TextCellEditor 默认单例
        TextCellEditor defEd = new TextCellEditor();
        Control ctl = defEd.CreateWidget(null, st, c0);
        defEd.BeginEdit(ctl, "Hello", c0);
        if (defEd.GetValue(ctl, c0) == "Hello") {
            Console.WriteLine("text-cell-editor=1");
        }

        // 4. 测试零样板代码：直接把任意 Gui.Control 传入当作单元格编辑器
        // 4.1 Input 测试
        Input directInp = new Input();
        DataColumn cDirect = DataColumn.ControlEditor(DataColumn.Text("Direct", 100), directInp);
        if (cDirect.editor != null && cDirect.editable) {
            Control directCtl = cDirect.editor.CreateWidget(null, st, cDirect);
            cDirect.editor.BeginEdit(directCtl, "ZeroGlueCode", cDirect);
            if (cDirect.editor.GetValue(directCtl, cDirect) == "ZeroGlueCode") {
                Console.WriteLine("direct-input-editor=1");
            }
        }

        // 4.2 SelectBox 下拉框直接当单元格编辑器
        List<string> opts = new List<string>();
        opts.Add("Apple");
        opts.Add("Banana");
        opts.Add("Orange");
        SelectBox directSel = SelectBox.FromOptions(opts, "Choose fruit");
        DataColumn cSel = DataColumn.ControlEditor(DataColumn.Text("Fruit", 100), directSel);
        if (cSel.editor != null) {
            Control selCtl = cSel.editor.CreateWidget(null, st, cSel);
            cSel.editor.BeginEdit(selCtl, "Banana", cSel);
            if (cSel.editor.GetValue(selCtl, cSel) == "Banana") {
                Console.WriteLine("direct-selectbox-editor=1");
            }
        }

        // 4.3 Checkbox 复选框直接当单元格编辑器
        Checkbox directChk = new Checkbox();
        DataColumn cChk = DataColumn.ControlEditor(DataColumn.Text("Active", 60), directChk);
        if (cChk.editor != null) {
            Control chkCtl = cChk.editor.CreateWidget(null, st, cChk);
            cChk.editor.BeginEdit(chkCtl, "true", cChk);
            if (cChk.editor.GetValue(chkCtl, cChk) == "true") {
                Console.WriteLine("direct-checkbox-editor=1");
            }
        }

        // 4.4 DatePicker 日期选择器直接当单元格编辑器
        DatePicker directDate = new DatePicker();
        DataColumn cDate = DataColumn.ControlEditor(DataColumn.Text("Birthday", 120), directDate);
        if (cDate.editor != null) {
            Control dateCtl = cDate.editor.CreateWidget(null, st, cDate);
            cDate.editor.BeginEdit(dateCtl, "2026-10-16", cDate);
            if (cDate.editor.GetValue(dateCtl, cDate) == "2026-10-16") {
                Console.WriteLine("direct-datepicker-editor=1");
            }
        }

        // 4.5 测试完全无硬编码的自定义复合组件与委托通道（ControlEditorCustom）
        Panel customComposite = new Panel();
        DataColumn cCustom = DataColumn.ControlEditorCustom(
            DataColumn.Text("Custom", 120),
            customComposite,
            (Control c, string v) => { c.name = "CustomPrefix:" + v; },
            (Control c) => { return c.name; }
        );
        if (cCustom.editor != null) {
            Control customCtl = cCustom.editor.CreateWidget(null, st, cCustom);
            cCustom.editor.BeginEdit(customCtl, "Data123", cCustom);
            if (cCustom.editor.GetValue(customCtl, cCustom) == "CustomPrefix:Data123") {
                Console.WriteLine("custom-delegate-editor=1");
            }
        }

        // 5. 任务 3：测试 Master-Detail 真 Control 挂载（ControlDetailProvider & SetDetailControl）
        DataTable.SetDetailControl(st, (App a, DataSource s, int r) => {
            Panel p = new Panel();
            p.name = "DetailPanelRow" + Convert.ToString(r);
            return p;
        }, 4);
        if (st.detail != null) {
            Console.WriteLine("detail-provider-attached=1");
            if (st.detail.Slots(src, 0) == 4) {
                Console.WriteLine("detail-slots=4");
            }
            Control detailCtl = st.detail.ProvideControl(null, src, 1, 0, 0, 200, 100);
            if (detailCtl != null && detailCtl.name == "DetailPanelRow1") {
                Console.WriteLine("detail-control-provided=1");
            }
        }

        // 6. 任务 4：测试表格状态持久化与列工具面板（ExportStateJson / ImportStateJson / ColumnToolPanel）
        st.colWidths[0] = 188;
        DataTable.HideField(st, cols, "role", true);
        string stateJson = DataTable.ExportStateJson(st, cols);
        if (stateJson.Length > 0) {
            Console.WriteLine("export-state-json=1");
        }

        DataTableState st2 = new DataTableState();
        DataTable.EnsureInit(st2, cols, src);
        bool importOk = DataTable.ImportStateJson(st2, cols, stateJson);
        if (importOk && st2.colWidths[0] == 188) {
            Console.WriteLine("import-state-json=1");
        }

        // 列工具面板控制
        DataTable.OpenColumnToolPanel(st);
        if (DataTable.IsColumnToolPanelOpen(st)) {
            Console.WriteLine("column-tool-panel-open=1");
        }
        ColumnToolPanel toolPanel = new ColumnToolPanel(st, cols, src);
        if (toolPanel != null) {
            Console.WriteLine("column-tool-panel-instantiated=1");
        }
        DataTable.CloseColumnToolPanel(st);
        if (!DataTable.IsColumnToolPanelOpen(st)) {
            Console.WriteLine("column-tool-panel-close=1");
        }

        // 7. 任务 2：测试 Fill Handle 填充柄状态模型
        st.isFilling = true;
        st.fillTargetR = 5;
        st.fillTargetC = 1;
        if (st.isFilling && st.fillTargetR == 5 && st.fillTargetC == 1) {
            Console.WriteLine("fill-handle-state=1");
        }

        // 8. 任务 6：测试置顶行与置底固定行 (Pinned Rows / Floating Rows)
        List<DataRow> topRows = new List<DataRow>();
        DataRow tr1 = new DataRow();
        tr1.cells.Add("Target Baseline");
        tr1.cells.Add("99.9%");
        topRows.Add(tr1);
        DataTable.SetPinnedTopRows(st, topRows);
        if (DataTable.PinnedTopRowCount(st) == 1) {
            Console.WriteLine("pinned-top-rows=1");
        }

        List<DataRow> bottomRows = new List<DataRow>();
        DataRow br1 = new DataRow();
        br1.cells.Add("Quick Add Row");
        br1.cells.Add("");
        bottomRows.Add(br1);
        DataTable.SetPinnedBottomRows(st, bottomRows);
        if (DataTable.PinnedBottomRowCount(st) == 1) {
            Console.WriteLine("pinned-bottom-rows=1");
        }
        DataTable.ClearPinnedRows(st);
        if (DataTable.PinnedTopRowCount(st) == 0 && DataTable.PinnedBottomRowCount(st) == 0) {
            Console.WriteLine("pinned-rows-cleared=1");
        }

        // 9. 任务 7：测试单表自关联树形层级模式 (IdTreeAdapter & SetTreeHierarchy)
        // 构造带 id / parentId 的层级数据源
        List<DataRow> treeRows = new List<DataRow>();
        // 列 0: id, 列 1: parentId, 列 2: deptName
        DataRow rNode1 = new DataRow();
        rNode1.cells.Add("10"); rNode1.cells.Add(""); rNode1.cells.Add("HQ");
        DataRow rNode2 = new DataRow();
        rNode2.cells.Add("20"); rNode2.cells.Add("10"); rNode2.cells.Add("R&D");
        DataRow rNode3 = new DataRow();
        rNode3.cells.Add("30"); rNode3.cells.Add("20"); rNode3.cells.Add("Compiler Team");
        treeRows.Add(rNode1);
        treeRows.Add(rNode2);
        treeRows.Add(rNode3);
        RowListSource treeSource = new RowListSource(treeRows);

        IdTreeAdapter treeAd = new IdTreeAdapter(0, 1);
        if (treeAd.RootCount(treeSource) == 1 && treeAd.RootAt(treeSource, 0) == 0) {
            Console.WriteLine("tree-root-resolved=1");
        }
        if (treeAd.ChildCount(treeSource, 0) == 1 && treeAd.ChildOf(treeSource, 0, 0) == 1) {
            Console.WriteLine("tree-child-resolved=1");
        }
        if (treeAd.ParentOf(treeSource, 2) == 1) {
            Console.WriteLine("tree-parent-resolved=1");
        }
        DataTable.SetTreeHierarchy(st, 0, 1, 2);
        if (DataTable.HasTree(st) && st.treeCol == 2) {
            Console.WriteLine("set-tree-hierarchy=1");
        }

        // 10. 任务 8：测试全局检索关键词高亮 (SetHighlightQuery)
        DataTable.SetHighlightQuery(st, "Architect");
        if (st.highlightQuery == "Architect") {
            Console.WriteLine("set-highlight-query=1");
        }

        // 11. 任务 10：测试业务级单元格跨列与跨行合并 (CellSpanProvider & TableSpanModel)
        TableSpanModel spanModel = new TableSpanModel();
        // 设置第 0 行第 0 列跨 2 行 3 列
        spanModel.AddSpan(0, 0, 2, 3);
        CellSpan masterSpan = spanModel.GetSpan(src, 0, 0);
        if (masterSpan != null && masterSpan.IsMaster() && masterSpan.rowSpan == 2 && masterSpan.colSpan == 3) {
            Console.WriteLine("cell-span-master=1");
        }
        CellSpan coveredSpan = spanModel.GetSpan(src, 0, 1);
        if (coveredSpan != null && coveredSpan.IsCovered()) {
            Console.WriteLine("cell-span-covered-col=1");
        }
        CellSpan coveredRowSpan = spanModel.GetSpan(src, 1, 0);
        if (coveredRowSpan != null && coveredRowSpan.IsCovered()) {
            Console.WriteLine("cell-span-covered-row=1");
        }
        CellSpan normalSpan = spanModel.GetSpan(src, 5, 5);
        if (normalSpan != null && !normalSpan.IsMaster() && !normalSpan.IsCovered()) {
            Console.WriteLine("cell-span-normal=1");
        }
        DataTable.SetCellSpanProvider(st, spanModel);
        if (DataTable.GetCellSpanProvider(st) == spanModel) {
            Console.WriteLine("cell-span-provider-registered=1");
        }
        DataTable.AddCellSpan(st, 2, 2, 3, 2);
        CellSpan dynSpan = st.spanProvider.GetSpan(src, 2, 2);
        if (dynSpan != null && dynSpan.rowSpan == 3 && dynSpan.colSpan == 2) {
            Console.WriteLine("add-cell-span=1");
        }
        DataTable.ClearCellSpans(st);
        CellSpan clearedSpan = st.spanProvider.GetSpan(src, 2, 2);
        if (clearedSpan != null && !clearedSpan.IsMaster()) {
            Console.WriteLine("clear-cell-spans=1");
        }

        // 12. 任务 11：测试列拖拽重排状态与指示器逻辑
        st.dragCol = 1;
        st.dragColStartX = 150;
        st.dragColMoved = true;
        if (st.dragCol == 1 && st.dragColMoved) {
            Console.WriteLine("column-drag-reorder-state=1");
        }
        st.dragCol = -1;
        st.dragColMoved = false;

        // 13. 测试自定义汇总行计算器 (CustomSummaryProvider)
        TestCustomSummaryProvider customSummary = new TestCustomSummaryProvider();
        DataTable.SetCustomSummaryProvider(st, customSummary);
        if (DataTable.GetCustomSummaryProvider(st) == customSummary) {
            Console.WriteLine("custom-summary-registered=1");
        }
        st.showSummary = true;
        DataTable.Recompute(st, cols, src);
        if (st.summaryText.Count > 1 && st.summaryText[1] == "CustomSum: $999,999") {
            Console.WriteLine("custom-summary-calculated=1");
        }

        // 14. 测试复制带表头与 CSV 导出格式
        string tsvWithHeaders = DataTable.CopyTextWithHeaders(st, cols, src);
        if (tsvWithHeaders.IndexOf("Name\tRole") >= 0) {
            Console.WriteLine("copy-with-headers-tsv=1");
        }
        string csvText = DataTable.CopyCsv(st, cols, src, true);
        if (csvText.IndexOf("Name,Role") >= 0 || csvText.IndexOf("\"Name\",\"Role\"") >= 0) {
            Console.WriteLine("copy-as-csv=1");
        }

        // 15. 测试空数据与加载中覆盖层控件插槽 (EmptyWidget / LoadingWidget)
        Panel emptyPnl = new Panel();
        DataTable.SetEmptyWidget(st, emptyPnl);
        if (DataTable.GetEmptyWidget(st) == emptyPnl && st.emptyWidget == emptyPnl) {
            Console.WriteLine("empty-widget-registered=1");
        }
        Panel loadPnl = new Panel();
        DataTable.SetLoadingWidget(st, loadPnl);
        if (DataTable.GetLoadingWidget(st) == loadPnl && st.loadingWidget == loadPnl) {
            Console.WriteLine("loading-widget-registered=1");
        }

        // 16. 测试单元格自定义业务校验器 (CellValidator & ValidateCellEx)
        MinLengthValidator minVal = new MinLengthValidator(4);
        c0.WithValidator(minVal);
        string vErrPass = DataTable.ValidateCellEx(c0, "Alexander", 0, 0);
        string vErrFail = DataTable.ValidateCellEx(c0, "Al", 0, 0);
        if (vErrPass.Length == 0 && vErrFail == "Too short") {
            Console.WriteLine("cell-validator-rule-applied=1");
        }

        // 17. 测试选区状态栏自动统计 (ComputeSelectionSummary / GetSelectionSummaryText)
        DataColumn cScore = DataColumn.Numeric("Score", 80);
        cols.Add(cScore);
        DataTable.EnsureInit(st, cols, src);

        // 设置覆盖第 0~1 行、第 0~2 列的矩形选区 (包含 2 行 x 3 列 = 6 个单元格，其中 Score 列有 2 个数值: 100 和 60)
        st.rangeR0 = 0;
        st.rangeC0 = 0;
        st.rangeR1 = 1;
        st.rangeC1 = 2;
        SelectionSummary selSummary = DataTable.ComputeSelectionSummary(st, cols, src);
        if (selSummary.cellCount == 6 && selSummary.numericCount == 2
            && selSummary.sum == 160.0 && selSummary.average == 80.0
            && selSummary.min == 60.0 && selSummary.max == 100.0) {
            Console.WriteLine("selection-summary-computed=1");
        }
        string summaryTxt = DataTable.GetSelectionSummaryText(st, cols, src);
        if (summaryTxt.IndexOf("Count: 6") >= 0 && summaryTxt.IndexOf("Sum: 160") >= 0) {
            Console.WriteLine("selection-summary-formatted=1");
        }

        // 18. 测试选区批量清空与一键撤销 (ClearSelection & UndoOne/UndoDepth)
        // 开启可编辑状态
        cScore.editable = true;
        // 选区定在第 0 行第 2 列 (Score: 100)
        st.rangeR0 = 0;
        st.rangeC0 = 2;
        st.rangeR1 = 0;
        st.rangeC1 = 2;
        int cleared = DataTable.ClearSelection(st, cols, src);
        if (cleared == 1 && src.CellText(0, 2) == "") {
            Console.WriteLine("selection-cleared=1");
        }
        // 执行撤销，恢复原值 "100"
        bool undone = DataTable.Undo(st, cols, src);
        if (undone && src.CellText(0, 2) == "100") {
            Console.WriteLine("selection-clear-undone=1");
        }

        // 19. 测试内置开箱即用主从明细提供器 (ChildGridDetailProvider & CardDetailProvider)
        TestRowSource childSrc = new TestRowSource();
        List<DataColumn> childCols = new List<DataColumn>();
        childCols.Add(DataColumn.Text("SubName", 100));
        childCols.Add(DataColumn.Text("SubRole", 100));
        DetailProvider childGridP = DataTable.MakeChildGrid(childSrc, 0, 0, childCols, 6);
        if (childGridP.CanExpand(src, 0)) {
            Console.WriteLine("child-grid-can-expand=1");
        }
        int cSlots = childGridP.Slots(src, 0);
        if (cSlots >= 2) {
            Console.WriteLine("child-grid-slots-computed=1");
        }

        List<string> cardLabels = new List<string>();
        cardLabels.Add("User Name");
        cardLabels.Add("Role Name");
        List<int> cardCols = new List<int>();
        cardCols.Add(0);
        cardCols.Add(1);
        DetailProvider cardP = DataTable.MakeCard(cardLabels, cardCols, 3);
        if (cardP.Slots(src, 0) == 3) {
            Console.WriteLine("card-detail-slots-ok=1");
        }

        // 20. 测试 Excel 导出包含 OpenXML <mergeCells> 规范
        DataTable.ClearCellSpans(st);
        DataTable.AddCellSpan(st, 0, 0, 2, 2); // 第 0 行第 0 列跨 2 行 2 列 (对应 Excel A2:B3)
        string testXlsxPath = "_scratch/test_merged_export.xlsx";
        if (File.Exists(testXlsxPath)) { File.Delete(testXlsxPath); }
        DataTableXlsx.InstallExportUi();
        DataTableExportSnapshot xlsxSnap = DataTable.ExportSnapshot(st, cols.Count, src, false);
        if (xlsxSnap != null) {
            bool exportOk = DataTableXlsx.ExportXlsxSnapshot(xlsxSnap, cols, src, testXlsxPath, null);
            if (exportOk && File.Exists(testXlsxPath)) {
                byte[] xlsxBytes = File.ReadAllBytes(testXlsxPath);
                List<ZipEntry> zipEntries = Zip.Read(xlsxBytes);
                if (zipEntries != null) {
                    for (int zi = 0; zi < zipEntries.Count; zi = zi + 1) {
                        if (zipEntries[zi].name == "xl/worksheets/sheet1.xml") {
                            byte[] sheetBytes = Zip.Extract(xlsxBytes, zipEntries[zi]);
                            if (sheetBytes != null) {
                                string sheetXml = Encoding.UTF8.GetString(sheetBytes);
                                if (sheetXml.IndexOf("<mergeCells count=\"1\"><mergeCell ref=\"A2:B3\"/></mergeCells>") >= 0) {
                                    Console.WriteLine("excel-merge-cells-exported=1");
                                }
                            }
                        }
                    }
                }
                File.Delete(testXlsxPath);
            }
        }

        // Case 21: 多级复合表头（Banded Headers）导出到 OpenXML Excel 单元格合并与冻结验证
        List<DataColumn> bandedCols = new List<DataColumn>();
        DataColumn bcol0 = DataColumn.Text("国内营收", 120);
        bcol0.band = "Sales";
        bandedCols.Add(bcol0);

        DataColumn bcol1 = DataColumn.Text("海外营收", 120);
        bcol1.band = "Sales";
        bandedCols.Add(bcol1);

        DataColumn bcol2 = DataColumn.Text("编号", 80);
        bcol2.band = "";
        bandedCols.Add(bcol2);

        DataTableState bandedSt = new DataTableState();
        DataTable.EnsureInit(bandedSt, bandedCols, src);
        DataTable.Recompute(bandedSt, bandedCols, src);

        string testBandedPath = "_scratch/test_banded_header.xlsx";
        if (File.Exists(testBandedPath)) { File.Delete(testBandedPath); }

        DataTableExportSnapshot bSnap = DataTable.ExportSnapshot(bandedSt, bandedCols.Count, src, false);
        if (bSnap != null) {
            bool bExportOk = DataTableXlsx.ExportXlsxSnapshot(bSnap, bandedCols, src, testBandedPath, null);
            if (bExportOk && File.Exists(testBandedPath)) {
                byte[] bBytes = File.ReadAllBytes(testBandedPath);
                List<ZipEntry> bEntries = Zip.Read(bBytes);
                if (bEntries != null) {
                    for (int bi = 0; bi < bEntries.Count; bi = bi + 1) {
                        if (bEntries[bi].name == "xl/worksheets/sheet1.xml") {
                            byte[] sBytes = Zip.Extract(bBytes, bEntries[bi]);
                            if (sBytes != null) {
                                string bXml = Encoding.UTF8.GetString(sBytes);
                                if (bXml.IndexOf("<mergeCell ref=\"A1:B1\"/>") >= 0) {
                                    Console.WriteLine("banded-header-hmerge=1");
                                }
                                if (bXml.IndexOf("<mergeCell ref=\"C1:C2\"/>") >= 0) {
                                    Console.WriteLine("banded-header-vmerge=1");
                                }
                                if (bXml.IndexOf("ySplit=\"2\"") >= 0) {
                                    Console.WriteLine("banded-header-freeze=1");
                                }
                            }
                        }
                    }
                }
                File.Delete(testBandedPath);
            }
        }

        // Case 22: 分组行标题自定义格式化器 (GroupDisplayFormatter & SetGroupFormatFunc)
        DataTable.SetGroupFormatFunc(st, (GroupRow grp, List<DataColumn> cs, DataSource s) => {
            return "Dept: " + grp.label + " [" + Convert.ToString(grp.count) + " Users]";
        });
        GroupDisplayFormatter gFmt = DataTable.GetGroupFormatter(st);
        if (gFmt != null) {
            Console.WriteLine("group-formatter-registered=1");
            GroupRow testGrp = new GroupRow("Engineering", 0, 15, "Engineering", false);
            string gText = gFmt.Format(testGrp, cols, src);
            if (gText == "Dept: Engineering [15 Users]") {
                Console.WriteLine("group-header-custom-formatted=1");
            }
        }

        // Case 23: 选区实时统计浮条 (Selection Summary Pill) 与显隐控制
        if (DataTable.GetShowSelectionSummary(st)) {
            Console.WriteLine("selection-summary-default-enabled=1");
        }
        DataTable.SetShowSelectionSummary(st, false);
        if (!DataTable.GetShowSelectionSummary(st)) {
            Console.WriteLine("selection-summary-disabled=1");
        }
        DataTable.SetShowSelectionSummary(st, true);
        if (DataTable.GetShowSelectionSummary(st)) {
            Console.WriteLine("selection-summary-re-enabled=1");
        }

        // Case 24: 自定义上下文菜单插槽 (CustomContextMenuProvider & TableContextMenuItem)
        bool customMenuTriggered = false;
        DataTable.SetContextMenuFunc(st, (DataTableState s, List<DataColumn> cs, DataSource ds, int row, int col) => {
            List<TableContextMenuItem> customItems = new List<TableContextMenuItem>();
            customItems.Add(TableContextMenuItem.Item("View Details", "eye", (DataTableState s2, DataSource ds2, int r, int c) => {
                customMenuTriggered = true;
            }));
            return customItems;
        });
        ContextMenuFunc cmFn = DataTable.GetContextMenuFunc(st);
        if (cmFn != null) {
            Console.WriteLine("context-menu-func-registered=1");
            List<TableContextMenuItem> genItems = cmFn(st, cols, src, 0, 1);
            if (genItems != null && genItems.Count == 1 && genItems[0].label == "View Details") {
                Console.WriteLine("custom-context-menu-items-generated=1");
                genItems[0].onClick(st, src, 0, 1);
                if (customMenuTriggered) {
                    Console.WriteLine("custom-context-menu-action-dispatched=1");
                }
            }
        }

        // Case 25: 全表自适应充满视口 (SizeColumnsToFit)
        List<DataColumn> fitCols = new List<DataColumn>();
        fitCols.Add(DataColumn.Text("Col0", 80));
        fitCols.Add(DataColumn.Text("Col1", 100));
        fitCols.Add(DataColumn.Text("Col2", 120));
        DataTableState fitSt = new DataTableState();
        int origSum = 80 + 100 + 120;
        DataTable.SizeColumnsToFit(fitSt, fitCols, 1000);
        int newSum = fitSt.colWidths[0] + fitSt.colWidths[1] + fitSt.colWidths[2];
        int fixedW = (fitSt.showRowNum ? 40 : 0) + (fitSt.showSelect ? 36 : 0);
        if (newSum > origSum && newSum == 1000 - fixedW) {
            Console.WriteLine("size-columns-to-fit-expanded=1");
        }

        // Case 26: 整行业务样式条件规则 (RowStyleFunc & RowStyle)
        DataTable.SetRowStyleFunc(st, (DataSource ds, int rowIdx) => {
            if (rowIdx == 0) {
                return RowStyle.Danger();
            } else if (rowIdx == 1) {
                return RowStyle.Warning();
            }
            return null;
        });
        RowStyleFunc rsFn = DataTable.GetRowStyleFunc(st);
        if (rsFn != null) {
            Console.WriteLine("row-style-func-registered=1");
            RowStyle rs0 = rsFn(src, 0);
            RowStyle rs1 = rsFn(src, 1);
            RowStyle rs2 = rsFn(src, 2);
            if (rs0 != null && rs0.bg == 0x30FF4D4F && rs0.fg == 0xCF1322) {
                Console.WriteLine("row-style-danger-matched=1");
            }
            if (rs1 != null && rs1.bg == 0x28FFAA00 && rs1.fg == 0xD48800) {
                Console.WriteLine("row-style-warning-matched=1");
            }
            if (rs2 == null) {
                Console.WriteLine("row-style-default-fallback=1");
            }
        }

        // Case 27: 盲打直出 (Type-to-Edit) 快捷激活与初值直接灌入
        DataTableState tteSt = new DataTableState();
        List<DataColumn> tteCols = new List<DataColumn>();
        tteCols.Add(DataColumn.Field(DataColumn.Text("Col0", 100), "name"));
        tteCols.Add(DataColumn.Field(DataColumn.Text("Col1", 100), "score"));
        tteCols[0].editable = true;
        tteCols[1].editable = true;
        TestRowSource tteSrc = new TestRowSource();
        DataTable.EnsureInit(tteSt, tteCols, tteSrc);
        DataTable.Recompute(tteSt, tteCols, tteSrc);

        DataTable.BeginEdit(tteSt, tteCols, tteSrc, 0, 1);
        tteSt.editBuf = "9";
        tteSt.editCur = 1;
        if (tteSt.editing && tteSt.editBuf == "9") {
            Console.WriteLine("type-to-edit-activated=1");
        }
        DataTable.CommitEdit(tteSt, tteCols, tteSrc);
        if (tteSrc.CellText(0, 1) == "9") {
            Console.WriteLine("type-to-edit-committed=1");
        }

        // Case 28: TSV 剪贴板矩阵批量粘贴多行多列与单次全量撤销 (Undo Group)
        string tsvMatrix = "Alpha\t88\nBeta\t77";
        tteSt.hitOrder = 0;
        tteSt.hitCol = 0;
        int pasteCount = DataTable.PasteText(tteSt, tteCols, tteSrc, tsvMatrix);
        if (pasteCount == 4 && tteSrc.CellText(0, 0) == "Alpha" && tteSrc.CellText(1, 0) == "Beta"
            && tteSrc.CellText(0, 1) == "88" && tteSrc.CellText(1, 1) == "77") {
            Console.WriteLine("tsv-matrix-batch-pasted=1");
        }
        bool undoOk = DataTable.Undo(tteSt, tteCols, tteSrc);
        if (undoOk && tteSrc.CellText(0, 0) == "Alice" && tteSrc.CellText(1, 0) == "Bob") {
            Console.WriteLine("tsv-matrix-undo-all=1");
        }

        // Case 29: 列虚拟化边界判定 (BandLeft / BandRight)
        int bandL = DataTable.BandLeft(1, 76, 200, 800);
        int bandR = DataTable.BandRight(1, 76, 200, 400, 800, 0, 0, 600);
        if (bandL == 200 && bandR == 600) {
            Console.WriteLine("column-virtualization-bounds-ok=1");
        }

        // Case 30: 泛型 DataGrid<T> 链式企业级 API 配置 (ContextMenu / RowStyle / ShowSelectionSummary / SizeColumnsToFit)
        List<TestPerson> persons = new List<TestPerson>();
        persons.Add(new TestPerson("Alice", 95));
        persons.Add(new TestPerson("Bob", 65));

        DataGrid<TestPerson> grid = new DataGrid<TestPerson>();
        grid.Bind(persons);
        grid.Col("Name", 100, (TestPerson p) => { return p.name; });
        grid.NumCol("Score", 100, (TestPerson p) => { return p.score; });

        grid.ShowSelectionSummary(true)
            .RowStyle((DataSource ds, int r) => {
                if (r == 1) { return RowStyle.Danger(); }
                return null;
            })
            .ContextMenu((DataTableState s, List<DataColumn> cs, DataSource ds, int r, int c) => {
                List<TableContextMenuItem> items = new List<TableContextMenuItem>();
                items.Add(TableContextMenuItem.Item("Inspect", "eye", null));
                return items;
            })
            .SizeColumnsToFit(800);

        if (grid.State().showSelectionSummary && grid.State().rowStyleFunc != null && grid.State().contextMenuFunc != null) {
            Console.WriteLine("datagrid-fluent-enterprise-apis-ok=1");
        }

        Console.WriteLine("all-enterprise-tests-passed=1");
    }
}
