using System;
using Gui;
using Gui.Widget;

// Retained Layer geometry, input, photo lifetime and lifecycle regressions.
class Program {
    static int fails;

    static void True(string what, bool got) {
        if (got) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Eq(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine($"FAIL {what}: got {got} want {want}");
    }

    static void Draw(App app) { Draw(app, "retained layer frame prepares"); }

    static void Draw(App app, string label) {
        app.BeginOffscreenFrame();
        True(label, app.PrepareStandardHostFrame());
        app.EndOffscreenFrame();
    }

    static int[] Pixels(App app) {
        int width = app.canvas.Width(); int height = app.canvas.Height();
        int[] pixels = new int[width * height];
        for (int y = 0; y < height; y = y + 1) {
            for (int x = 0; x < width; x = x + 1) { pixels[y * width + x] = app.canvas.GetPixel(x, y); }
        }
        return pixels;
    }

    static bool DifferentPixels(int[] first, int[] second) {
        for (int i = 0; i < first.Length; i = i + 1) { if (first[i] != second[i]) { return true; } }
        return false;
    }

    // 生命周期回调计数（Opened / Closed）。
    static int openedCount;
    static int closedCount;
    static void OnOpened() { openedCount = openedCount + 1; }
    static void OnClosed() { closedCount = closedCount + 1; }

    static void Main() {
        fails = 0;

        // ---- 唯一 ID 分配：各窗口与内部控件 ID 独立且互不冲突 ----------
        LayerState win = new LayerState("W", 50, 60, 300, 200);
        True("barId valid", win.barId > 0);
        True("closeId valid", win.closeId > 0);
        True("maxId valid", win.maxId > 0);
        True("minId valid", win.minId > 0);
        True("chrome ids distinct",
             win.closeId != win.barId && win.maxId != win.closeId
             && win.minId != win.maxId && win.minId != win.barId);
        True("okBtn id valid", win.okBtn.CommonId() > 0);
        True("cancelBtn id valid", win.cancelBtn.CommonId() > 0);
        True("altBtn id valid", win.altBtn.CommonId() > 0);
        LayerState ask = LayerState.Prompt("P", "hint");
        True("promptInput id valid", ask.promptInput.CommonId() > 0);
        // 第二、三个窗口 ID 互不重叠。
        LayerState win2 = new LayerState("W2", 0, 0, 100, 100);
        LayerState w3 = new LayerState("W3", 90, 100, 300, 200);
        True("windows use distinct ids",
             win2.barId != win.barId && w3.barId != win2.barId
             && ask.promptInput.CommonId() != win.barId
             && ask.promptInput.CommonId() != win2.barId);

        // ---- 最小化任务条：左下角横排 ------------------------------
        App app = App.CreateOffscreen("layer", 800, 600);
        int H = app.canvas.Height();
        int bar = Layer.BarH(app);
        int margin = app.Scale(8);
        int mw = app.Scale(260);
        int gap = app.Scale(8);

        Draw(app);
        int[] blank = Pixels(app);
        win.Open(app);
        win2.Open(app);
        w3.Open(app);
        win.openMs = 0; win2.openMs = 0; w3.openMs = 0;
        True("Open installs retained input root before Paint", app.rootControl is InputRootAdapter);
        Draw(app);
        True("App frame paints retained windows", DifferentPixels(blank, Pixels(app)));
        List<int> r0 = new List<int>(); Layer.Bounds(app, win, r0);
        Eq("normal x", r0[0], 50); Eq("normal y", r0[1], 60);
        win2.state = 2; w3.state = 2;
        Draw(app);
        List<int> r1 = new List<int>(); Layer.Bounds(app, win2, r1);
        List<int> r2 = new List<int>(); Layer.Bounds(app, w3, r2);
        Eq("min slot0 x", r1[0], margin);
        Eq("min slot0 bottom", r1[1] + r1[3], H - margin);
        Eq("min slot1 x", r2[0], margin + mw + gap);
        Eq("min slot1 y", r2[1], r1[1]);
        Control chip = app.rootControl.HitTest(r1[0] + 10, r1[1] + bar / 2, 0);
        True("minimized title is a retained input control", chip != null);
        app.ProcessOffscreenInput(2, r1[0] + 10, r1[1] + bar / 2, 0, 0, 0, 0);
        app.ProcessOffscreenInput(3, r1[0] + 10, r1[1] + bar / 2, 0, 0, 0, 0);
        Eq("minimized title restores before repaint", win2.state, 0);
        Draw(app);
        List<int> r2b = new List<int>(); Layer.Bounds(app, w3, r2b);
        Eq("remaining chip moves to slot zero", r2b[0], margin);
        w3.open = false;
        Draw(app);
        True("closed chip is absent from input", app.rootControl.HitTest(r2b[0] + 10, r2b[1] + bar / 2, 0) != chip);

        Binding<int> pidx = 0;
        CarouselAnim panim = new CarouselAnim();
        List<string> slides = new List<string>();
        slides.Add("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='72' height='48'><rect width='72' height='48' fill='blue'/></svg>");
        slides.Add(slides[0]);
        PhotoViewer photos = Layer.OpenPhotos(app, slides, pidx, panim);
        True("photos owns retained overlay", app.overlayHost.ActiveRoot() == photos);
        Layer.ClosePhotos(app);
        True("explicit photo close retires immediately", !photos.Active && app.overlayHost.ActiveRoot() == null);

        // ---- 窗口缩放：把手命中区 + 几何推导 ----------------------
        Draw(app);
        True("right resize edge belongs to retained window",
        app.rootControl.HitTest(win.x + win.w - 2, win.y + win.h / 2, 0) != null);

        win.rDir = 2;
        win.rStartX = 50; win.rStartY = 60;
        win.rStartW = 300; win.rStartH = 200;
        win.grabDx = 350; win.grabDy = 0;
        Layer.ApplyResize(app, win, 420, 0);
        Eq("resize right grows w", win.w, 370);
        win.rDir = 1;
        win.rStartX = 50; win.rStartW = 300;
        win.grabDx = 50;
        Layer.ApplyResize(app, win, 30, 0);
        Eq("resize left edge moves x", win.x, 30);
        Eq("resize left edge grows w", win.w, 320);
        win.rStartX = 50; win.rStartW = 300;
        // 向右拖收窄（mx-grabDx=+200 > 300-220），触发最小宽钳制。
        Layer.ApplyResize(app, win, 250, 0);
        Eq("resize left min width", win.w, app.Scale(220));
        Eq("resize left min pins x", win.x, 50 + 300 - app.Scale(220));
        win.rDir = 3;
        win.rStartY = 60; win.rStartH = 200;
        win.grabDy = 260;
        Layer.ApplyResize(app, win, 0, 400);
        Eq("resize bottom grows h", win.h, 340);
        win.rDir = 4;
        win.rStartW = 300; win.rStartH = 200;
        win.grabDx = 350; win.grabDy = 260;
        Layer.ApplyResize(app, win, 450, 360);
        Eq("resize SE grows w", win.w, 400);
        Eq("resize SE grows h", win.h, 300);

        // ---- 孪生矩形窗口：锚点重绑定必须落在最顶层 ----------------
        LayerState twinA = new LayerState("TA", 120, 90, 400, 230);
        LayerState twinB = new LayerState("TB", 120, 90, 400, 230);
        twinA.Open(app); twinB.Open(app); twinA.openMs = 0; twinB.openMs = 0;
        Draw(app);
        int tcx = 120 + 400 - Layer.BtnW(app) / 2;
        int tcy = 90 + Layer.BarH(app) / 2;
        app.ProcessOffscreenInput(2, tcx, tcy, 0, 0, 0, 0);
        app.ProcessOffscreenInput(3, tcx, tcy, 0, 0, 0, 0);
        Action pending = Dispatcher.Take();
        while (pending != null) { pending(); pending = Dispatcher.Take(); }
        True("topmost twin receives close", !twinB.open && twinA.open);
        twinA.open = false;

        // ---- 生命周期回调：Opened / Closed / AutoCloseMs -----------
        // Opened 在入场动画走完的第一帧触发一次（入场中不触发）；
        // Closed 在关闭沿触发一次——宿主直接置 open=false 时由下一次
        // 渲染补触发，Layer.Close 立即触发，AutoCloseMs 到期自动关闭
        // 并触发。重开重新武装两个回调。
        openedCount = 0;
        closedCount = 0;
        LayerState lc = new LayerState("LC", 40, 40, 300, 200);
        lc.Opened += OnOpened;
        lc.Closed += OnClosed;
        lc.Open(app);
        Draw(app);
        Eq("opened suppressed during entrance", openedCount, 0);
        Window.SleepMs(220);
        Draw(app);
        Eq("opened fired once after entrance", openedCount, 1);
        Draw(app);
        Eq("opened fires exactly once", openedCount, 1);
        // 宿主直接置 open=false：关闭沿在下一次渲染触发 Closed。
        lc.open = false;
        Draw(app);
        Eq("closed edge after host close", closedCount, 1);
        Draw(app);
        Eq("closed fires exactly once", closedCount, 1);
        // 重开再关：Opened 再计一次，Layer.Close 立即触发 Closed。
        lc.Open(app);
        Window.SleepMs(220);
        Draw(app);
        Eq("reopened fires opened again", openedCount, 2);
        Layer.Close(app, lc);
        Eq("close fires closed immediately", closedCount, 2);
        // AutoCloseMs：到期经 Layer.Close 自动关闭并触发 Closed。
        lc.Open(app);
        lc.AutoCloseMs = 60;
        Window.SleepMs(120);
        Draw(app, "autoclose retained layer frame prepares");
        True("autoclose closed the layer", !lc.open);
        Eq("autoclose fires closed", closedCount, 3);

        // ---- 键盘语义：Esc/Enter/箭头 ------------------------------
        // Enter 确认最上层对话框（action 1），Esc 取消（action 2），
        // ←/→ 在 photos 会话里翻页（250ms 活跃窗），Esc 无对话框时
        // 请求关闭 photos。
        LayerState dlg2 = LayerState.Confirm("Q", "body", 0);
        dlg2.Open(app);
        True("key: dialog consumed enter",
             Layer.Key(app, 13) && dlg2.action == 1);
        dlg2.open = false;
        dlg2.action = 0;
        dlg2.Open(app);
        True("key: dialog consumed esc",
             Layer.Key(app, 27) && dlg2.action == 2);
        // 宿主读到 action 后关闭（Key 不直接置 open——关闭权在调用方）。
        dlg2.open = false;
        photos = Layer.OpenPhotos(app, slides, pidx, panim);
        True("key: photos eats right arrow", Layer.Key(app, 39));
        Eq("key: photos idx advanced", pidx.Get(), 1);
        True("key: photos eats left arrow", Layer.Key(app, 37));
        Eq("key: photos idx back", pidx.Get(), 0);
        True("key: photos eats esc", Layer.Key(app, 27));
        True("photos closes in the key event", !photos.Active);

        // ---- page 层正文控件树：独立对象树组装 ----------
        Panel form = Panel.Column();
        Button formBtn = new Button("Save");
        form.With(formBtn);
        True("body view id valid", formBtn.CommonId() > 0);
        win.SetBody(form);
        Draw(app);
        True("body view belongs to retained input", app.rootControl.ContainsInputControl(formBtn));

        // ---- 关闭编排：CloseLast / CloseAll ------------------------
        LayerState win4 = new LayerState("W4", 10, 10, 200, 150);
        win4.Open(app);
        LayerState dlg3 = LayerState.Confirm("C", "b", 0);
        dlg3.Open(app);
        True("closeLast kind1 closes dialog", Layer.CloseLast(app, 1));
        True("dialog closed", !dlg3.open);
        True("closeLast kind0 closes window", Layer.CloseLast(app, 0));
        True("window4 closed", !win4.open);
        win4.Open(app);
        dlg3.Open(app);
        Layer.CloseAll(app, 0);
        True("closeAll windows closed", !win4.open && !win.open);
        True("closeAll keeps dialogs", dlg3.open);

        app.canvas.Destroy();
        if (fails == 0) {
            Console.WriteLine("layer: OK");
        } else {
            Console.WriteLine("layer: FAIL " + Convert.ToString(fails));
        }
    }
}
