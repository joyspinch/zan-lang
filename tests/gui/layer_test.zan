using System;
using Gui;
using Gui.Widget;

/// Gui.Layer 的无窗口回归：两条容易回归的机制。
///
/// 1. 窗口 id 保留段——LayerState 可以在点击回调里中途创建，而即时模式
///    宿主每帧 WidgetId.ResetFrame 会把计数器回卷重发；若构造器直接从
///    宿主计数领号，窗口标题栏/关闭钮领走的正是宿主随后每帧控件的本命
///    id（gallery：点窗口标题栏触发 Photos 按钮，点关闭触发别的演示
///    控件——即“信号污染”）。断言：构造器前后宿主计数器连续，窗口
///    自身与子控件的 id 全部落进 Layer 专属的 930000 保留段，且多窗口
///    之间互不重叠。
/// 2. 最小化任务条——state=2 的窗口按堆叠顺序在左下角横排成一条标题
///    栏（宽 260、高一条标题栏），命中区与绘制取同一个 MinPos；还原后
///    回到原几何，余下窗口向左收拢。断言全部走 hitTester.RectOf，与
///    屏幕命中同源。
class Program {
    static int fails;

    static void True(string what, bool got) {
        if (got) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Eq(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine($"FAIL {what}: got {got} want {want}");
    }

    static bool InBand(int id) {
        return id >= 1930001 && id < 1930400;
    }

    // 生命周期回调计数（Opened / Closed）。
    static int openedCount;
    static int closedCount;
    static void OnOpened() { openedCount = openedCount + 1; }
    static void OnClosed() { closedCount = closedCount + 1; }

    static void Main() {
        fails = 0;

        // ---- id 保留段：宿主计数器不受中途创建窗口的影响 ----------
        int hostA = WidgetId.Next();
        LayerState win = new LayerState("W", 50, 60, 300, 200);
        int hostB = WidgetId.Next();
        Eq("host counter untouched", hostB - hostA, 1);
        True("barId in band", InBand(win.barId));
        True("closeId in band", InBand(win.closeId));
        True("maxId in band", InBand(win.maxId));
        True("minId in band", InBand(win.minId));
        True("chrome ids distinct",
             win.closeId != win.barId && win.maxId != win.closeId
             && win.minId != win.maxId);
        True("okBtn in band", InBand(win.okBtn.wid));
        True("cancelBtn in band", InBand(win.cancelBtn.wid));
        True("altBtn in band", InBand(win.altBtn.wid));
        LayerState ask = LayerState.Prompt("P", "hint");
        True("promptInput in band", InBand(ask.promptInput.wid));
        // 第二、三个窗口向后继续领段，互不重叠。
        LayerState win2 = new LayerState("W2", 0, 0, 100, 100);
        LayerState w3 = new LayerState("W3", 90, 100, 300, 200);
        True("windows use disjoint bands",
             win2.barId > win.minId && w3.barId > win2.minId
             && ask.promptInput.wid > win.minId
             && ask.promptInput.wid < win2.barId);

        // ---- 最小化任务条：左下角横排 ------------------------------
        App app = new App("layer", 800, 600);
        int H = app.canvas.Height();
        int bar = Layer.BarH(app);
        int margin = app.Scale(8);
        int mw = app.Scale(260);
        int gap = app.Scale(8);

        List<LayerState> stack = new List<LayerState>();
        win.Open();
        win2.Open();
        w3.Open();
        stack.Add(win);
        stack.Add(win2);
        stack.Add(w3);
        // 等入场动画（180ms）走完，命中区落在终位再断言。测试直接调
        // RenderStack 不经 BeginFrame，命中区不会自动清帧——每帧先
        // Clear() 再渲染，RectOf 读到的才是本帧注册的几何。
        Window.SleepMs(220);
        app.hitTester.Clear();
        Layer.RenderStack(app, stack);

        List<int> r0 = app.hitTester.RectOf(win.barId);
        if (r0 == null) {
            fails = fails + 1;
            Console.WriteLine("FAIL normal bar registered");
        } else {
            Eq("normal bar x", r0[0], 50);
            Eq("normal bar y", r0[1], 60);
            // 标题栏可拖拽：命中区类型必须是 6（四向移动光标），
            // 不能再落回分割条的 5（上下缩放箭头）。
            Eq("bar cursor type", app.hitTester.GetWidgetType(win.barId), 6);
        }

        win2.state = 2;
        w3.state = 2;
        app.hitTester.Clear();
        Layer.RenderStack(app, stack);
        List<int> r1 = app.hitTester.RectOf(win2.barId);
        List<int> r2 = app.hitTester.RectOf(w3.barId);
        if (r1 == null || r2 == null) {
            fails = fails + 1;
            Console.WriteLine("FAIL minimized bars registered");
        } else {
            // barId 的命中区是标题栏去掉三个 caption 按钮的部分：
            // 宽 260 - 3*BtnW，从 chip 左缘起。槽位间距仍是一整个 chip。
            Eq("min chip bar w", r1[2], mw - Layer.BtnW(app) * 3);
            Eq("min chip h", r1[3], bar);
            Eq("min slot0 x", r1[0], margin);
            Eq("min slot0 bottom", r1[1] + r1[3], H - margin);
            Eq("min slot1 x", r2[0], margin + mw + gap);
            Eq("min slot1 y", r2[1], r1[1]);
            // 命中解析与命中区同源：任务条中点必须点中自己的标题栏。
            Eq("min slot0 hit", app.hitTester.HitTest(r1[0] + r1[2] / 2,
               r1[1] + r1[3] / 2), win2.barId);
            // 正常态的窗口不受影响。
            List<int> r0b = app.hitTester.RectOf(win.barId);
            Eq("normal bar still x", r0b[0], 50);
        }

        // 还原 win2：它回到原几何，w3 向左收拢到槽 0。
        win2.state = 0;
        app.hitTester.Clear();
        Layer.RenderStack(app, stack);
        List<int> r1b = app.hitTester.RectOf(win2.barId);
        List<int> r2b = app.hitTester.RectOf(w3.barId);
        Eq("restored x", r1b[0], 0);
        Eq("restored y", r1b[1], 0);
        Eq("re-slotted x", r2b[0], margin);

        // 关闭后不再注册命中区。
        w3.open = false;
        app.hitTester.Clear();
        Layer.RenderStack(app, stack);
        True("closed chip unregistered", app.hitTester.RectOf(w3.barId) == null);

        // ---- photos 全屏查看器：遮罩语义与恢复 --------------------
        // 宿主必须把 RenderPhotos 挂在全局覆盖层 pass（不能挂在某个
        // 演示卡/选项卡的渲染分支里：切走选项卡整层消失，photosOpen
        // 残留成看不见的开态，切回来时遮罩吞掉一切点击——表现为
        // 「打开过 photos 后按钮全部失效」）。标准库侧契约：开着时
        // 遮罩吞掉一切解析（含 layer 窗口标题栏钮），关闭后立即恢复。
        SignalBool photosOpen = new SignalBool(false);
        SignalInt pidx = new SignalInt(0);
        CarouselAnim panim = new CarouselAnim();
        List<string> slides = new List<string>();
        slides.Add("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg'"
            + " width='72' height='48'><rect width='72' height='48'"
            + " fill='#2b6cb0'/></svg>");
        slides.Add(slides[0]);
        int cbw = Layer.BtnW(app);
        int ccx = 50 + 300 - cbw + cbw / 2;
        int ccy = 60 + Layer.BarH(app) / 2;

        photosOpen.Set(true);
        app.hitTester.Clear();
        Layer.RenderStack(app, stack);
        Layer.RenderPhotos(app, slides, pidx, panim);
        app.hitTester.KeepFullSnapshot();
        app.hitTester.AnchorAt(1, ccx, ccy, false);
        app.hitTester.Clear();
        Layer.RenderStack(app, stack);
        Layer.RenderPhotos(app, slides, pidx, panim);
        int blocked = app.hitTester.AnchorIdOf(1);
        True("photos scrim blocks window close",
             blocked != win.closeId && blocked != win.barId
             && blocked != win.maxId && blocked != win.minId);

        photosOpen.Set(false);
        app.hitTester.Clear();
        Layer.RenderStack(app, stack);
        app.hitTester.KeepFullSnapshot();
        app.hitTester.AnchorAt(1, ccx, ccy, false);
        app.hitTester.Clear();
        Layer.RenderStack(app, stack);
        Eq("window close recovers after photos closed",
           app.hitTester.AnchorIdOf(1), win.closeId);

        // ---- 窗口缩放：把手命中区 + 几何推导 ----------------------
        // 把手领保留段 id（跨帧稳定）：右缘 wtype 4 (SIZEWE)、下缘
        // 5 (SIZENS)、右下角 7 / 左下角 8（对角缩放光标）。几何推导
        // ApplyResize 与渲染拖动共用，直接喂合成鼠标位断言。
        app.hitTester.Clear();
        Layer.RenderStack(app, stack);
        List<int> rz = app.hitTester.RectOf(win.rsRId);
        True("resize right zone", rz != null);
        if (rz != null) {
            Eq("resize right x", rz[0], 50 + 300 - app.Scale(5));
            Eq("resize right type", app.hitTester.GetWidgetType(win.rsRId), 4);
        }
        List<int> rb = app.hitTester.RectOf(win.rsBId);
        True("resize bottom zone", rb != null);
        if (rb != null) {
            Eq("resize bottom type", app.hitTester.GetWidgetType(win.rsBId), 5);
        }
        Eq("resize SE type", app.hitTester.GetWidgetType(win.rsSEId), 7);
        Eq("resize SW type", app.hitTester.GetWidgetType(win.rsSWId), 8);

        win.rDir = 2;
        win.rStartX = 50; win.rStartY = 60;
        win.rStartW = 300; win.rStartH = 200;
        win.grabDx = 350; win.grabDy = 0;
        Layer.ApplyResize(app, win, 420, 0);
        Eq("resize right grows w", win.w, 370);
        win.rDir = 1;
        win.rStartX = 50; win.rStartW = 300;
        win.grabDx = 50;
        Layer.ApplyResize(app, win, 30, 0);
        Eq("resize left edge moves x", win.x, 30);
        Eq("resize left edge grows w", win.w, 320);
        win.rStartX = 50; win.rStartW = 300;
        // 向右拖收窄（mx-grabDx=+200 > 300-220），触发最小宽钳制。
        Layer.ApplyResize(app, win, 250, 0);
        Eq("resize left min width", win.w, app.Scale(220));
        Eq("resize left min pins x", win.x, 50 + 300 - app.Scale(220));
        win.rDir = 3;
        win.rStartY = 60; win.rStartH = 200;
        win.grabDy = 260;
        Layer.ApplyResize(app, win, 0, 400);
        Eq("resize bottom grows h", win.h, 340);
        win.rDir = 4;
        win.rStartW = 300; win.rStartH = 200;
        win.grabDx = 350; win.grabDy = 260;
        Layer.ApplyResize(app, win, 450, 360);
        Eq("resize SE grows w", win.w, 400);
        Eq("resize SE grows h", win.h, 300);

        // ---- 孪生矩形窗口：锚点重绑定必须落在最顶层 ----------------
        // gallery 的 SpawnLayer 按 (n%6)*Scale(28) 级联，开到第 7 个
        // 窗口时与第 1 个矩形完全重合。命中区按绘制次序注册（底层
        // 先、顶层后），锚点重绑定若取首匹配，按住/点击目标会被下层
        // 孪生窗口抢走——表现为顶层窗口按钮全哑、拖不动。断言：重
        // 绑定后按住/点击锚点仍指向顶层窗口。
        LayerState twinA = new LayerState("TA", 120, 90, 400, 230);
        LayerState twinB = new LayerState("TB", 120, 90, 400, 230);
        twinA.Open();
        twinB.Open();
        List<LayerState> twins = new List<LayerState>();
        twins.Add(twinA);
        twins.Add(twinB);
        Window.SleepMs(220);
        int tcx = 120 + 400 - Layer.BtnW(app) + Layer.BtnW(app) / 2;
        int tcy = 90 + Layer.BarH(app) / 2;
        app.hitTester.Clear();
        Layer.RenderStack(app, twins);
        app.hitTester.KeepFullSnapshot();
        app.hitTester.AnchorAt(1, tcx, tcy, false);
        app.hitTester.Clear();
        Layer.RenderStack(app, twins);
        Eq("twin rebind keeps topmost click", app.hitTester.AnchorIdOf(1),
           twinB.closeId);
        app.hitTester.AnchorAt(0, tcx, tcy, false);
        app.hitTester.Clear();
        Layer.RenderStack(app, twins);
        Eq("twin rebind keeps topmost press", app.hitTester.AnchorIdOf(0),
           twinB.closeId);
        twinA.open = false;
        twinB.open = false;

        // ---- 生命周期回调：Opened / Closed / AutoCloseMs -----------
        // Opened 在入场动画走完的第一帧触发一次（入场中不触发）；
        // Closed 在关闭沿触发一次——宿主直接置 open=false 时由下一次
        // 渲染补触发，Layer.Close 立即触发，AutoCloseMs 到期自动关闭
        // 并触发。重开重新武装两个回调。
        openedCount = 0;
        closedCount = 0;
        LayerState lc = new LayerState("LC", 40, 40, 300, 200);
        lc.Opened += OnOpened;
        lc.Closed += OnClosed;
        List<LayerState> lcStack = new List<LayerState>();
        lcStack.Add(lc);
        lc.Open();
        app.hitTester.Clear();
        Layer.RenderStack(app, lcStack);
        Eq("opened suppressed during entrance", openedCount, 0);
        Window.SleepMs(220);
        app.hitTester.Clear();
        Layer.RenderStack(app, lcStack);
        Eq("opened fired once after entrance", openedCount, 1);
        app.hitTester.Clear();
        Layer.RenderStack(app, lcStack);
        Eq("opened fires exactly once", openedCount, 1);
        // 宿主直接置 open=false：关闭沿在下一次渲染触发 Closed。
        lc.open = false;
        app.hitTester.Clear();
        Layer.RenderStack(app, lcStack);
        Eq("closed edge after host close", closedCount, 1);
        app.hitTester.Clear();
        Layer.RenderStack(app, lcStack);
        Eq("closed fires exactly once", closedCount, 1);
        // 重开再关：Opened 再计一次，Layer.Close 立即触发 Closed。
        lc.Open();
        Window.SleepMs(220);
        app.hitTester.Clear();
        Layer.RenderStack(app, lcStack);
        Eq("reopened fires opened again", openedCount, 2);
        Layer.Close(app, lc);
        Eq("close fires closed immediately", closedCount, 2);
        // AutoCloseMs：到期经 Layer.Close 自动关闭并触发 Closed。
        lc.Open();
        lc.AutoCloseMs = 60;
        Window.SleepMs(120);
        app.hitTester.Clear();
        Layer.RenderStack(app, lcStack);
        True("autoclose closed the layer", !lc.open);
        Eq("autoclose fires closed", closedCount, 3);

        // ---- 键盘语义：Esc/Enter/箭头 ------------------------------
        // Enter 确认最上层对话框（action 1），Esc 取消（action 2），
        // ←/→ 在 photos 会话里翻页（250ms 活跃窗），Esc 无对话框时
        // 请求关闭 photos。
        LayerState dlg2 = LayerState.Confirm("Q", "body", 0);
        dlg2.Open();
        True("key: dialog consumed enter",
             Layer.Key(app, 13) && dlg2.action == 1);
        dlg2.open = false;
        dlg2.action = 0;
        dlg2.Open();
        True("key: dialog consumed esc",
             Layer.Key(app, 27) && dlg2.action == 2);
        // 宿主读到 action 后关闭（Key 不直接置 open——关闭权在调用方）。
        dlg2.open = false;
        // 重新渲染 photos 刷新键盘会话（photosTick 有 250ms 新鲜度窗，
        // 前面缩放/孪生/生命周期段的耗时会让它过期）。
        app.hitTester.Clear();
        Layer.RenderPhotos(app, slides, pidx, panim);
        True("key: photos eats right arrow", Layer.Key(app, 39));
        Eq("key: photos idx advanced", pidx.Get(), 1);
        True("key: photos eats left arrow", Layer.Key(app, 37));
        Eq("key: photos idx back", pidx.Get(), 0);
        True("key: photos eats esc", Layer.Key(app, 27));
        app.hitTester.Clear();
        True("photos close request delivered",
             Layer.RenderPhotos(app, slides, pidx, panim));

        // ---- page 层正文控件树：BeginBody/EndBody 保留段 ----------
        // 正文控件在点击回调里中途构造，若从宿主计数领号会重演
        // “信号污染”；包裹后宿主计数零消耗、控件 id 落在 body 段。
        int hostA2 = WidgetId.Next();
        Layer.BeginBody();
        Panel form = Panel.Column();
        Button formBtn = new Button("Save");
        form.With(formBtn);
        Layer.EndBody();
        int hostB2 = WidgetId.Next();
        Eq("body view host counter untouched", hostB2 - hostA2, 1);
        True("body view id in reserved band", formBtn.wid >= 1980001);
        win.SetBody(form);
        app.hitTester.Clear();
        Layer.RenderStack(app, stack);
        True("body view rendered", app.hitTester.RectOf(win.barId) != null);

        // ---- 关闭编排：CloseLast / CloseAll ------------------------
        LayerState win4 = new LayerState("W4", 10, 10, 200, 150);
        win4.Open();
        LayerState dlg3 = LayerState.Confirm("C", "b", 0);
        dlg3.Open();
        True("closeLast kind1 closes dialog", Layer.CloseLast(1));
        True("dialog closed", !dlg3.open);
        True("closeLast kind0 closes window", Layer.CloseLast(0));
        True("window4 closed", !win4.open);
        win4.Open();
        dlg3.Open();
        Layer.CloseAll(0);
        True("closeAll windows closed", !win4.open && !win.open);
        True("closeAll keeps dialogs", dlg3.open);

        if (fails == 0) {
            Console.WriteLine("layer: OK");
        } else {
            Console.WriteLine("layer: FAIL " + Convert.ToString(fails));
        }
    }
}
