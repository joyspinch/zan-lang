// Window 基类引导用例（B-ID147）：类 ↔ 文档同目录同名（Docapp_test ↔
// docapp_test.html），字段+方法即全部业务代码；Main 只为离屏断言存在
// （真窗口工程连这行都由编译器合成）。golden: GUI_DOCAPP_OK
using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

class Docapp_test : Form {
    // ---- 业务代码（字段即 ViewModel，方法即事件）----

    string name = "init-name";
    string title = "T1";
    bool showTitle = true;
    List<object> rows = new List<object>();

    int okCount = 0;
    bool loaded = false;
    Form loadForm;

    void OnLoad(Form form) {
        loaded = true;
        loadForm = form;
        DocAppRow r1 = new DocAppRow();
        r1.label = "a";
        DocAppRow r2 = new DocAppRow();
        r2.label = "b";
        rows.Add(r1);
        rows.Add(r2);
    }

    void OnOk() { okCount = okCount + 1; }

    void Hide() { showTitle = false; }

    // ---- 断言 ----

    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static Control Pick(Control root, string id) {
        Control c = root.Find(id);
        if (c == null) {
            fails = fails + 1;
            Console.WriteLine("FAIL find '" + id + "'");
            return new Panel();
        }
        return c;
    }

    static void Main() {
        fails = 0;
        Docapp_test vm = new Docapp_test();
        vm.ShowOffscreen();
        Form form = vm;

        // OnLoad 钩子：装配期已触发，拿到的是同一扇窗。
        Eq("onload fired", Convert.ToString(vm.loaded), "true");
        Eq("onload form", form == vm.loadForm ? "1" : "0", "1");

        // AutoWire：@click="OnOk" 按名接到了本实例方法。
        Button ok = vm.Get<Button>("OkBtn");
        if (ok == null) {
            fails = fails + 1;
            Console.WriteLine("FAIL Get<Button> OkBtn");
        } else {
            ok.Click.Raise();
            Eq("autowire click", Convert.ToString(vm.okCount), "1");
        }

        // 首帧：字段值 → 控件，data-for 展开。
        form.CaptureSnapshot();
        Eq("bind name", Pick(vm.docRoot, "NameInput").GetProp("value"), "init-name");
        Eq("bind title", Pick(vm.docRoot, "TitleLabel").GetProp("text"), "T1");
        Control page = Pick(vm.docRoot, "page");
        Eq("rows expanded", Convert.ToString(page.ChildCount()), "6");
        Control row0 = page.children[4];
        Eq("row0 text", row0.children[0].GetProp("text"), "a");
        Eq("row1 text", page.children[5].children[0].GetProp("text"), "b");

        // 回写：控件 → 字段。
        Pick(vm.docRoot, "NameInput").SetProp("value", "typed");
        form.CaptureSnapshot();
        Eq("writeback name", vm.name, "typed");

        // data-if：字段翻转 → 下一帧插拔。
        vm.Hide();
        form.CaptureSnapshot();
        Eq("data-if hidden", Convert.ToString(Pick(vm.docRoot, "TitleLabel").visible), "false");

        if (fails == 0) { Console.WriteLine("GUI_DOCAPP_OK"); }
    }
}

class DocAppRow {
    string label = "";
}
