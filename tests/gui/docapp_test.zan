// DocApp 引导用例（B-ID147）：类 ↔ 文档同目录同名（Docapp_test ↔
// docapp_test.html），字段+方法即全部业务代码；Main 一行引导（P2 编译器
// 合成落地后模板里连这行也没有）。golden: GUI_DOCAPP_OK
using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

class Docapp_test {
    // ---- 业务代码（ViewModel 字段 + 事件方法）----

    string name = "init-name";
    string title = "T1";
    bool showTitle = true;
    List<object> rows = new List<object>();

    int okCount = 0;
    bool loaded = false;
    Form loadForm;

    void OnLoad(Form form) {
        loaded = true;
        loadForm = form;
        DocAppRow r1 = new DocAppRow();
        r1.label = "a";
        DocAppRow r2 = new DocAppRow();
        r2.label = "b";
        rows.Add(r1);
        rows.Add(r2);
    }

    void OnOk() { okCount = okCount + 1; }

    void Hide() { showTitle = false; }

    // ---- 断言 ----

    static int fails;
    static DocAppHost host;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static Control Pick(Control root, string id) {
        Control c = root.Find(id);
        if (c == null) {
            fails = fails + 1;
            Console.WriteLine("FAIL find '" + id + "'");
            return new Panel();
        }
        return c;
    }

    static void Main() {
        fails = 0;
        host = DocApp.BootstrapOffscreen(new VmFactory[] { () => new Docapp_test() });
        Docapp_test vm = (Docapp_test)host.Vm;
        Form form = host.Form;

        Eq("onload fired", Convert.ToString(vm.loaded), "true");
        Eq("onload form", form == vm.loadForm ? "1" : "0", "1");

        Button ok = host.Ctl<Button>("OkBtn");
        if (ok == null) {
            fails = fails + 1;
            Console.WriteLine("FAIL ctl<Button> OkBtn");
        } else {
            ok.Click.Raise();
            Eq("autowire click", Convert.ToString(vm.okCount), "1");
        }

        // 首帧：POCO 字段 → 控件，data-for 展开。
        form.CaptureSnapshot();
        Eq("bind name", Pick(host.Root, "NameInput").GetProp("value"), "init-name");
        Eq("bind title", Pick(host.Root, "TitleLabel").GetProp("text"), "T1");
        Control page = Pick(host.Root, "page");
        Eq("rows expanded", Convert.ToString(page.ChildCount()), "6");
        Control row0 = page.children[4];
        Eq("row0 text", row0.children[0].GetProp("text"), "a");
        Eq("row1 text", page.children[5].children[0].GetProp("text"), "b");

        // 回写：控件 → POCO 字段。
        Pick(host.Root, "NameInput").SetProp("value", "typed");
        form.CaptureSnapshot();
        Eq("writeback name", vm.name, "typed");

        // data-if：字段翻转 → 下一帧插拔。
        vm.Hide();
        form.CaptureSnapshot();
        Eq("data-if hidden", Convert.ToString(Pick(host.Root, "TitleLabel").visible), "false");

        if (fails == 0) { Console.WriteLine("GUI_DOCAPP_OK"); }
    }
}

class DocAppRow {
    string label = "";
}
