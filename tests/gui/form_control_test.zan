using System;
using Gui;
using Gui.Widget;

partial class ZfPanel {
    void OnInit() {
    }
}

class FormControlTest {
    static int fails;
    static bool went;

    static void Went() { went = true; }

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void Main() {
        fails = 0;

        ZfPanel p = new ZfPanel();
        FormControlTest.Eq("kind", p.Kind(), "ZfPanel");

        if (p.ChildCount() == 0) {
            fails = fails + 1;
            Console.WriteLine("FAIL control has no designed children");
        }

        FormControlTest.Eq("label text", p.Caption.GetProp("text"),
                            "side panel");
        FormControlTest.Eq("button text", p.GoBtn.GetProp("text"), "Go");
        FormControlTest.Eq("button name", p.GoBtn.name, "GoBtn");

        if (p.Box == null || p.Box.ChildCount() != 1) {
            fails = fails + 1;
            Console.WriteLine("FAIL designed Card did not take its child");
        }
        FormControlTest.Eq("card note", p.BoxNote.GetProp("text"), "in card");

        FormControlTest.Eq("container text", p.Body.GetProp("text"), "");
        FormControlTest.Eq("container class", p.Body.GetProp("class"), "");

        ZfPanel q = new ZfPanel();
        if (q.GoBtn == p.GoBtn || q.Caption == p.Caption) {
            fails = fails + 1;
            Console.WriteLine("FAIL second instance shares the first's widgets");
        }
        q.Caption.SetProp("text", "other panel");
        FormControlTest.Eq("first instance untouched",
                            p.Caption.GetProp("text"), "side panel");
        FormControlTest.Eq("second instance edited",
                            q.Caption.GetProp("text"), "other panel");

        p.__Dispatch("go");

        Form form = new Form("host", 200, 100);
        form.On("go", FormControlTest.Went);
        form.Add(p);
        p.__Dispatch("go");
        if (!went) {
            fails = fails + 1;
            Console.WriteLine("FAIL attaching the control did not hand it the form");
        }
        went = false;
        q.__Dispatch("go");
        if (went) {
            fails = fails + 1;
            Console.WriteLine("FAIL an unattached instance reached the host form");
        }

        if (fails == 0) { Console.WriteLine("FORM_CONTROL_OK"); }
    }
}
