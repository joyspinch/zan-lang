using System;
using System.IO;
using Gui.Widget;
using Gui;
using Gui.Backend;
using Game.Scene;

class IdeEditorTabsPaintLeaf : Control {
    public weak ZanIDE ide;
    public int paints;
    public int tabsGeneration;
    public int explorerGeneration;
    public int toolsGeneration;
    public IdeEditorTabsPaintLeaf(ZanIDE ide) : base("ide-editor-tabs-paint") { this.ide = ide; this.Prefer(100, 40); }
    public override void OnPaint(App app) {
        paints = paints + 1; ide.SyncEditorTabs();
        tabsGeneration = app.inputRootGeneration;
        ide.explorerPanel.Render(app, ide.dock.ContentParked("explorer"), ide.tree);
        explorerGeneration = app.inputRootGeneration;
        ide.toolsPanel.Render(app, ide.dock.ContentParked("tools"), ide.rtToolTree);
        toolsGeneration = app.inputRootGeneration;
    }
}

class IdeEditorTabsProbeForm : Form {
    public IdeEditorTabsProbeForm() : base("IDE editor tabs preparation", 800, 600, true) { }
    public void Verify() {
        App app = this.GetApp();
        ZanIDE ide = new ZanIDE(app);
        IdeEditorTabsPaintLeaf leaf = new IdeEditorTabsPaintLeaf(ide);
        this.Add(leaf);
        // InitShell registers Tabs before Form.Run installs its scoped root.
        ide.SyncEditorTabs();
        ide.InitializeTreePanels();
        app.UseAppCss(File.ReadAllText("src/ide_zan/assets/ide.css"));
        Control startupRoot = app.rootControl;
        this.RunScoped(() => {
            IdeEditorTabsPreparationTest.Check(app.rootControl == this && startupRoot != app.rootControl
            && !app.rootControl.ContainsInputControl(ide.editorTabs), "Form replaces the startup input chain");
            IdeEditorTabsPreparationTest.VerifyTreePanels(app, ide, leaf);
            for (int pass = 0; pass < 3; pass = pass + 1) {
                bool prepared = false;
                // Restoring the replaced root can reject a registration handshake.
                // Only preparation retries: the first painted body must keep its proof.
                for (int attempt = 0; attempt < 3 && !prepared; attempt = attempt + 1) {
                    int paints = leaf.paints;
                    app.BeginFrame();
                    prepared = app.PrepareStandardHostFrame();
                    IdeEditorTabsPreparationTest.Check(leaf.paints == paints, "preparation attempts never Paint");
                    if (!prepared) { app.CancelOffscreenFrame(); }
                }
                IdeEditorTabsPreparationTest.Check(prepared, "hidden page prepares after restoring startup input chain");
                bool tabsHostedBeforePaint = app.rootControl.ContainsInputControl(ide.editorTabs);
                int generation = app.inputRootGeneration;
                Control root = app.rootControl;
                int paintsBeforeBody = leaf.paints;
                app.frameBody();
                IdeEditorTabsPreparationTest.Check(leaf.paints == paintsBeforeBody + 1, "prepared body paints exactly once");
                bool current = app.ContinuePreparedFrame();
                if (!tabsHostedBeforePaint || !current || root != app.rootControl || generation != app.inputRootGeneration) {
                    throw new Exception("startup Tabs proof: hosted=" + Convert.ToString(tabsHostedBeforePaint)
                    + " current=" + Convert.ToString(current) + " rootGeneration=" + Convert.ToString(generation)
                    + "/" + Convert.ToString(app.inputRootGeneration) + " paints=" + Convert.ToString(leaf.paints)
                    + " stages=" + Convert.ToString(leaf.tabsGeneration) + "/" + Convert.ToString(leaf.explorerGeneration)
                    + "/" + Convert.ToString(leaf.toolsGeneration));
                }
                IdeEditorTabsPreparationTest.Check(!ide.sceneDesigner.InputVisible(), "non-scene page keeps scene retired");
                app.CancelOffscreenFrame();
            }
            int paintsBeforeScene = leaf.paints;
            for (int visit = 0; visit < 2; visit = visit + 1) {
                ide.SetScene(true);
                app.ProcessOffscreenInput(2, 300, 200, 0, 0, 0, 0);
                IdeEditorTabsPreparationTest.Check(leaf.paints == paintsBeforeScene,
                "scene first input and reentry prepare without Paint");
                Control canvas = ide.sceneDesigner.CanvasRoot();
                IdeEditorTabsPreparationTest.Check(ide.sceneDesigner.InputVisible() && canvas.Visible
                && canvas.bw > 0 && canvas.bh > 0 && app.rootControl.ContainsInputControl(canvas),
                "active scene mounts and lays out actual canvas through preparation SetBounds");
                app.ProcessOffscreenInput(3, 300, 200, 0, 0, 0, 0);
                // Initial registration can reject one preparation turn. The next
                // complete frame must carry its proof through the real Paint call.
                bool complete = false;
                for (int attempt = 0; attempt < 3 && !complete; attempt = attempt + 1) {
                    app.BeginFrame();
                    if (app.PrepareStandardHostFrame()) {
                        app.frameBody(); complete = app.ContinuePreparedFrame();
                    }
                    app.CancelOffscreenFrame();
                }
                IdeEditorTabsPreparationTest.Check(complete, "active scene keeps its prepared proof through Paint");
                paintsBeforeScene = leaf.paints;
                ide.SetScene(false);
                app.ProcessOffscreenInput(2, 300, 200, 0, 0, 0, 0);
                app.ProcessOffscreenInput(3, 300, 200, 0, 0, 0, 0);
                IdeEditorTabsPreparationTest.Check(!ide.sceneDesigner.InputVisible()
                && !app.rootControl.ContainsInputControl(canvas), "leaving scene retires its input before Paint");
            }
            app.BeginFrame();
            IdeEditorTabsPreparationTest.Check(app.PrepareStandardHostFrame(), "returned hidden page prepares");
            app.frameBody();
            IdeEditorTabsPreparationTest.Check(app.ContinuePreparedFrame()
            && !ide.sceneDesigner.InputVisible(), "returned hidden page remains stable after Paint");
            app.CancelOffscreenFrame();
            ide.Close();
            IdeEditorTabsPreparationTest.Check(!app.rootControl.ContainsInputControl(ide.explorerPanel.Tree)
            && !app.rootControl.ContainsInputControl(ide.toolsPanel.Tree), "closing retires both panel input domains");
        });
        app.StopLoop(); app.SetRootControl(null); app.canvas.Destroy();
    }
}

class IdeEditorTabsOwnerWitness {
    public weak ZanIDE owner;
}

class IdeEditorTabsPreparationTest {
    public static void Check(bool value, string label) { if (!value) { throw new Exception(label); } }
    public static void Prepare(App app) {
        // BeforeInput restores all borrowed startup roots before target snapshots exist.
        // BeforePaint rejects a root change, so it cannot bootstrap several adapters at once.
        app.ProcessOffscreenInput(1, 400, 560, 0, 0, 0, 0);
        bool ready = false;
        for (int attempt = 0; attempt < 3 && !ready; attempt = attempt + 1) {
            app.BeginFrame(); ready = app.PrepareStandardHostFrame(); app.CancelOffscreenFrame();
        }
        Check(ready, "tree panel preparation completes without Paint");
    }

    public static void VerifyTreeInput(App app, TreeView tree, Input filter) {
        Check(app.rootControl.ContainsInputControl(tree) && tree.bw > 0 && tree.bh > 0
        && filter.bw > 0 && filter.bh > 0, "actual designed tree and filter mounted before first Paint");
        Rect rows = tree.ScrollViewport();
        Control panel = tree.parent;
        Check(panel != null && tree.bx == panel.bx && tree.by == panel.by
        && tree.bw == panel.bw && tree.bh == panel.bh && rows.y + rows.height <= panel.by + panel.bh
        && tree.scrollExtent > rows.height, "real tree and scroll body stay inside allocated dock viewport");
        app.ProcessOffscreenInput(13, rows.x + 5, rows.y + 5, 0, -120, 0, 0);
        int offset = tree.ScrollTop();
        Check(offset > 0 && tree.scroll.Get() == offset, "real body wheel commits and preserves legacy scroll projection");
        tree.SetScrollTop(0);
        Control target = tree.HitTest(rows.x + 5, rows.y + 5, 0);
        Check(target != null, "real body hit for edge bubbling");
        RoutedEventArgs edge = new RoutedEventArgs("Wheel", target, rows.x + 5, rows.y + 5);
        edge.delta = 120; target.RouteEvent(edge);
        Check(!edge.handled && tree.ScrollTop() == 0, "top edge wheel remains unhandled for ancestor bubbling");
        app.ProcessOffscreenInput(2, filter.bx + 5, filter.by + 5, 0, 0, 0, 0);
        app.ProcessOffscreenInput(3, filter.bx + 5, filter.by + 5, 0, 0, 0, 0);
        Check(filter.IsFocused(app), "real pointer focuses filter before Paint");
        app.ProcessOffscreenInput(6, 0, 0, 0, 120, 0, 0);
        Check(filter.GetText() == "x", "filter accepts text before Paint");
        Prepare(app);
        Check(tree.RowCount() == 0, "filter data binding runs in preparation");
        filter.SetText(""); Prepare(app);
        Check(tree.RowCount() == 40, "clearing filter restores business row mapping before Paint");
    }

    public static void VerifyTreePanels(App app, ZanIDE ide, IdeEditorTabsPaintLeaf leaf) {
        Prepare(app);
        VerifyTreeInput(app, ide.explorerPanel.Tree, ide.treeFilter);
        VerifyTreeInput(app, ide.toolsPanel.Tree, ide.rtToolFilter);
        Check(leaf.paints == 0, "both tree panels handle first input without any Paint");
        for (int side = 0; side < 2; side = side + 1) {
            string id = side == 0 ? "explorer" : "tools";
            TreeView tree = side == 0 ? ide.explorerPanel.Tree : ide.toolsPanel.Tree;
            Input filter = side == 0 ? ide.treeFilter : ide.rtToolFilter;
            filter.Focus(app); app.CapturePointer(filter, true);
            ide.dock.Close(id); Prepare(app);
            Check(!app.rootControl.ContainsInputControl(tree) && !filter.IsFocused(app)
            && app.GetCapturedPointer() == null, "hidden dock retires focus capture and input domain");
            app.BeginFrame(); Check(app.PrepareStandardHostFrame(), "hidden panel Paint has a preparation proof");
            Control root = app.rootControl; int generation = app.inputRootGeneration;
            ide.explorerPanel.Render(app, ide.dock.ContentParked("explorer"), ide.tree);
            ide.toolsPanel.Render(app, ide.dock.ContentParked("tools"), ide.rtToolTree);
            Check(app.rootControl == root && app.inputRootGeneration == generation
            && !app.rootControl.ContainsInputControl(tree) && app.ContinuePreparedFrame(),
            "Paint cannot remount a hidden panel or invalidate preparation");
            app.CancelOffscreenFrame();
            ide.dock.Show(id);
            DockPanel panel = ide.dock.Find(id);
            if (panel != null) { panel.body = new Rect(side == 0 ? 0 : 610, 40, 190, 220); }
            Prepare(app);
            Check(app.rootControl.ContainsInputControl(tree), "reopened panel remounts through preparation");
            VerifyTreeInput(app, tree, filter);
        }
        Check(leaf.paints == 0, "hide and reopen never require first Paint");
    }

    public static ZanIDE EventOwner(App app) {
        ZanIDE ide = new ZanIDE(app);
        for (int i = 1; i < 3; i = i + 1) {
            TabRecord record = new TabRecord();
            record.name = "File " + Convert.ToString(i); record.path = "file.zan";
            ide.tabs.Add(record);
        }
        ide.editorTabs = new Tabs(Tabs.Card());
        ide.editorTabs.SetHostModel(true);
        ide.editorTabs.SetShowAdd(true);
        for (int i = 0; i < ide.tabs.Count; i = i + 1) {
            ide.editorTabs.Add(ide.tabs[i].name, true);
        }
        ide.BindEditorTabHandlers();
        return ide;
    }

    public static void VerifyEvents(App app) {
        ZanIDE ide = EventOwner(app);
        ide.editorTabs.Select(1);
        Check(ide.activeTab.Get() == 1, "current retained TabChanged updates the IDE model");
        ide.editorTabs.TriggerAdd();
        Check(ide.added == 1, "TabAdded invokes the current IDE wizard callback");
        ide.editorTabs.CloseAll();
        Check(ide.closeEvents.Count == 3 && ide.closeEvents[0] == 2
        && ide.closeEvents[1] == 1 && ide.closeEvents[2] == 0
        && ide.editorTabs.ClosedIndex() == -1, "bulk close consumes every callback-local ClosedIndex");
        ide.closeEvents.Clear(); ide.closeReentry = true;
        ide.editorTabs.CloseTab(2);
        Check(ide.closeEvents.Count == 2 && ide.closeEvents[0] == 2 && ide.closeEvents[1] == 0
        && ide.editorTabs.ClosedIndex() == -1, "reentrant close preserves both event indices");
        Tabs stale = ide.editorTabs;
        ide.tabs[0].name = "Replacement"; ide.SyncEditorTabs();
        stale.Select(2); stale.TriggerAdd(); stale.CloseTab(0);
        Check(ide.activeTab.Get() == 1 && ide.added == 1 && ide.closeEvents.Count == 2,
        "replaced Tabs cannot select add or close through stale senders");
        ide.closeEvents.Clear(); ide.rebuildOnClose = true;
        ide.editorTabs.CloseAll();
        Check(ide.closeEvents.Count == 1 && ide.closeEvents[0] == 2,
        "reentrant strip replacement fences the remaining old bulk callbacks");
        ide.closeRequested = true;
        ide.editorTabs.Select(2); ide.editorTabs.TriggerAdd(); ide.editorTabs.CloseTab(0);
        Check(ide.activeTab.Get() == 1 && ide.added == 1 && ide.closeEvents.Count == 1,
        "closing IDE ignores all late tab callbacks");
        ide.Close();
    }

    public static Tabs BorrowOwner(App app, IdeEditorTabsOwnerWitness witness) {
        ZanIDE ide = EventOwner(app);
        witness.owner = ide;
        return ide.editorTabs;
    }

    static void Main() {
        ControlBootstrap.Install();
        App eventApp = App.CreateOffscreen("editor tab events", 800, 600);
        VerifyEvents(eventApp);
        IdeEditorTabsOwnerWitness witness = new IdeEditorTabsOwnerWitness();
        Tabs borrowed = BorrowOwner(eventApp, witness);
        Check(witness.owner == null, "retained tab delegates do not retain their IDE owner");
        borrowed.Select(1); borrowed.TriggerAdd(); borrowed.CloseTab(0);
        eventApp.StopLoop(); eventApp.canvas.Destroy();
        App sentinel = App.CreateOffscreen("editor tabs sentinel", 1, 1);
        IdeEditorTabsProbeForm form = new IdeEditorTabsProbeForm(); form.Verify();
        sentinel.canvas.Destroy();
        Console.WriteLine("IDE_EDITOR_TABS_PREPARATION_OK");
    }
}
