using System;
using Gui.Core;

class VelocityTrackerTest {
    static int fails;

    static void True(string what, bool got) {
        if (got) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    public static void Main() {
        VelocityTracker vt = new VelocityTracker();
        True("initial vx == 0", vt.XVelocity() == 0.0f);
        True("initial vy == 0", vt.YVelocity() == 0.0f);

        // 模拟 100ms 内向右下方滑动 200px, 100px
        vt.AddMovement(0, 100, 100);
        vt.AddMovement(50, 200, 150);
        vt.AddMovement(100, 300, 200);

        // 计算每秒速度 (units = 1000)
        vt.ComputeCurrentVelocity(1000, 5000.0f);

        // 200px / 100ms * 1000 = 2000 px/s
        // 100px / 100ms * 1000 = 1000 px/s
        True("vx > 1800", vt.XVelocity() > 1800.0f && vt.XVelocity() < 2200.0f);
        True("vy > 900", vt.YVelocity() > 900.0f && vt.YVelocity() < 1100.0f);

        // 重置清空
        vt.Clear();
        True("cleared vx == 0", vt.XVelocity() == 0.0f);
        True("cleared vy == 0", vt.YVelocity() == 0.0f);

        if (fails == 0) {
            Console.WriteLine("velocity_tracker_test OK");
        } else {
            Console.WriteLine("velocity_tracker_test FAILED: " + fails + " errors");
        }
    }
}
