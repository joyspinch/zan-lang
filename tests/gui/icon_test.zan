using System;
using Gui;

namespace IconTest;

/// Headless check of the vector icon renderer: every named icon must map to a
/// codepoint and rasterize onto a surface without faulting (the shapes are
/// built from Canvas line/rect/circle/sector calls, see Gui.IconVector).
class Program {
    static void Main() {
        Canvas c = Canvas.Create(64, 64);
        List<string> names = Icon.Names();
        int drawn = 0;
        for (int i = 0; i < names.Count; i = i + 1) {
            string n = names[i];
            int cp = Icon.Codepoint(n);
            Console.WriteLine($"{n} {cp}");
            if (cp != 0) {
                c.Clear(0xFFFFFFFF);
                Icon.Draw(c, n, 8, 8, 32, 0xFF112233);
                Icon.Draw(c, n, 0, 0, 9, 0xFF112233);
                drawn = drawn + 1;
            }
        }
        Console.WriteLine($"drawn {drawn}");
        c.Destroy();
    }
}
