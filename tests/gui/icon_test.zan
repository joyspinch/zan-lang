using System;
using Gui;

namespace IconTest;

// 核心契约与语义定义。
class Program {
    static void Main() {
        Canvas c = new Canvas(64, 64);
        List<string> names = Icon.Names();
        int drawn = 0;
        for (int i = 0; i < names.Count; i = i + 1) {
            string n = names[i];
            int cp = Icon.Codepoint(n);
            Console.WriteLine($"{n} {cp}");
            if (cp != 0) {
                c.Clear(0xFFFFFFFF);
                c.DrawGlyph(n, 8, 8, 32, 0xFF112233);
                c.DrawGlyph(n, 0, 0, 9, 0xFF112233);
                drawn = drawn + 1;
            }
        }
        Console.WriteLine($"drawn {drawn}");
        c.Destroy();
    }
}
