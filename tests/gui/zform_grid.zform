{
  "name": "ZfGrid",
  "role": "control",
  "layoutMode": 1,
  "fields": [
    { "kind": "DataGrid", "name": "Grid", "of": "GridRow", "dock": 5,
      "rowFactory": true,
      "props": { "striped": "true", "rowHeight": "22", "summary": "true",
                 "allowAddRow": "true" },
      "columns": [
        { "field": "name",   "title": "名称", "width": 220, "editable": true },
        { "field": "clicks", "title": "点击", "width": 80, "type": "num",
          "sum": true, "editable": true },
        { "field": "spend",  "title": "花费", "width": 100, "type": "real",
          "decimals": 2, "money": "¥", "sum": true },
        { "field": "active", "title": "在投", "width": 70, "type": "bool",
          "align": "center", "sortable": false }
      ] }
  ]
}
