}

class CaseMain {
    static int Main() {
        Html.Install();
        App host = App.CreateDark("diag", 200, 160);
        GhostWin w = new GhostWin();
        w.OpenHost(host);
        Console.WriteLine("NOT_REACHED");
        return 0;
    }
}
