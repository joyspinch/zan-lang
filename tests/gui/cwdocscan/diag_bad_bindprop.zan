// 运行期诊断：:prop="field"（如 :options）引用了窗上不存在的字段——
// 启动期 bind 对账 fail-fast exit 1 列出（DocWire.CheckBinds）。此前
// 拼错的字段名只会静默把下拉渲染成空。期望退出码 1。
using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

class BadPropWin : ChildWindow {
    public List<string> names;
}

class CaseMain {
    static int Main() {
        Html.Install();
        ControlBootstrap.Install();
        App host = App.CreateDark("diag", 200, 160);
        BadPropWin w = new BadPropWin();
        w.OpenHost(host);
        Console.WriteLine("NOT_REACHED");
        return 0;
    }
}
