// 运行期诊断：html 声明了 z-mount="..."，而窗上该字段缺失或在 OnCreate
// 之后仍为 null——装配期 fail-fast exit 1，一次性列出全部坏槽位名
// （DocWire.MountSlots，与缺失处理器同语义）。期望退出码 1。
using System;
using Gui;
using Gui.Widget;

class BadMountWin : ChildWindow {
    public Control ghostPanel;
}

class CaseMain {
    static int Main() {
        Html.Install();
        ControlBootstrap.Install();
        App host = App.CreateDark("diag", 200, 160);
        BadMountWin w = new BadMountWin();
        w.OpenHost(host);
        Console.WriteLine("NOT_REACHED");
        return 0;
    }
}
