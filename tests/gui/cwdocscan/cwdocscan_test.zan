// ChildWindow 声明式装配回归（子窗正典：装配全在框架，窗代码零装载语句）：
// 1) OpenHost 自动装载：DesignName 未覆写时按"类名 ↔ 同名 .html"——顶层
//    裸名（FlatCw.html）与 src/Deep 嵌套递归（NestedCw.html，GetDirectories
//    裸名口径须拼父路径）；窗代码里不调任何装载（EnsureDesign 是 private）；
// 2) OnCreate 钩子：装载之后、宿主创建之前恰好调一次（时序同旧"先 Build
//    再 OpenHost"）；ViewModel() 覆写换挂 JsonValue 模型（bind 走它、事件
//    仍解析窗方法，JsonValue 键不是反射字段——bind 对账跳过）；
// 3) 默认模型 = 窗自身：data-bind/z-text 初始推送 + 改字段一帧同步；
//    :options 绑 List<string> 字段、:disabled 绑 bool 字段；z-mount 把
//    OnCreate 里建的 Control 字段挂进槽位；
// 4) 装配序：@click 自动接线到实例方法（UiEvent.Raise 模拟点击）、OnLoad
//    钩子按名 Invoke；
// 5) html 声明了不存在的方法/路径/挂载字段时 fail-fast exit 1（DocWire.
//    AutoWire/CheckBinds/MountSlots）——由同目录 diag 子用例钉住。
using System;
using System.Collections.Generic;
using System.Json;
using Gui;
using Gui.Widget;

class FlatCw : ChildWindow {
    public int hits = 0;
    public string greeting = "hi";
    public bool loaded = false;
    public int creates = 0;
    public bool rootAtCreate = false;
    public bool hostlessAtCreate = false;
    public List<string> names;
    public bool busy = true;
    public Control panel;

    protected override void OnCreate() {
        this.creates = this.creates + 1;
        this.rootAtCreate = this.root != null;
        this.hostlessAtCreate = this.Host() == null;
        this.names = new List<string>();
        this.names.Add("alpha");
        this.names.Add("beta");
        this.panel = new Label("mounted");
    }

    [Custom]
    public void OnLoad(ChildWindow w) { this.loaded = true; }

    public void HitMe() { this.hits = this.hits + 1; }
}

class NestedCw : ChildWindow {
    public JsonValue mdl;

    protected override void OnCreate() {
        this.mdl = JsonValue.NewObject();
        this.mdl.PathSet("ghostkey", "jv");
    }

    protected override object ViewModel() { return this.mdl; }
}

// Close↔OnCloseRequested 互递归钉子：覆写里再调 Close() 是窗作者的
// 自然写法（关窗时顺带取消后台任务等），框架必须以 !open 早退兜底，
// 不得爆栈（B-ID163）。无同名设计稿：装载 no-op，root 保持 null。
class CloseRecursionCw : ChildWindow {
    public int closeRequests = 0;

    override void OnCloseRequested() {
        this.closeRequests = this.closeRequests + 1;
        this.Close();
    }
}

// z-text + 裸 readonly 通道：textarea 文本绑定实例字段（bindProp=text
// 初始推送 + 一帧同步）；裸 readonly 属性经 Html 属性协议落
// PropSpec("readonly") 真生效。
class TextCw : ChildWindow {
    public string introText = "hello";
}

class CaseMain {
    static int Main() {
        Html.Install();
        ControlBootstrap.Install();
        // 语义用例不钉帧耗时：首帧冷启动（字形图集/样式解析）在负载机上
        // 会越过 200ms 告警阈值往 stdout 打 UIWATCHDOG 行，破坏 golden；
        // 渲染耗时契约归 childwindow_budget_test。
        ChildWindows.SetSlowRenderWarnMs(0);
        int bad = 0;

        // 1+2+3+4：装配全链（窗代码零装载语句）
        App host = App.CreateDark("cwdocscan", 320, 240);
        FlatCw f = new FlatCw();
        f.OpenHost(host);
        if (f.root == null || f.root.Find("f1") == null) {
            Console.WriteLine("FLAT_MISS");
            bad = bad + 1;
        }
        if (f.creates != 1 || !f.rootAtCreate || !f.hostlessAtCreate) {
            Console.WriteLine("ONCREATE_ORDER_MISS");
            bad = bad + 1;
        }
        if (!f.loaded) {
            Console.WriteLine("ONLOAD_MISS");
            bad = bad + 1;
        }
        Label fl = (Label)f.root.Find("flabel");
        if (fl == null || fl.GetText() != "hi") {
            Console.WriteLine("BIND_INIT_MISS");
            bad = bad + 1;
        }
        Button fb = (Button)f.root.Find("fbtn");
        if (fb == null) {
            Console.WriteLine("BTN_MISS");
            bad = bad + 1;
        } else {
            fb.Click.Raise();
            if (f.hits != 1) {
                Console.WriteLine("WIRE_MISS");
                bad = bad + 1;
            }
        }
        Control slot = f.root.Find("fslot");
        if (slot == null || slot.children.Count != 1 || slot.children[0] != f.panel) {
            Console.WriteLine("MOUNT_MISS");
            bad = bad + 1;
        }
        SelectBox sel = (SelectBox)f.root.Find("fsel");
        if (sel == null || sel.Count() != 2) {
            Console.WriteLine("OPTIONS_LIST_MISS");
            bad = bad + 1;
        }
        Button busyBtn = (Button)f.root.Find("fbusy");
        if (busyBtn == null || !busyBtn.Disabled.Get()) {
            Console.WriteLine("DISABLED_INIT_MISS");
            bad = bad + 1;
        }
        f.greeting = "yo";
        f.busy = false;
        f.names.Add("gamma");
        f.MarkDirty();
        f.RequestRedraw();
        f.Render();
        if (fl.GetText() != "yo") {
            Console.WriteLine("BIND_SYNC_MISS");
            bad = bad + 1;
        }
        if (busyBtn.Disabled.Get()) {
            Console.WriteLine("DISABLED_SYNC_MISS");
            bad = bad + 1;
        }
        if (sel.Count() != 3) {
            Console.WriteLine("OPTIONS_SYNC_MISS");
            bad = bad + 1;
        }
        f.Close();

        // 1b+2：嵌套递归装载 + ViewModel() 换挂 JsonValue 模型——bind 走
        // JsonValue（n2 推送出 "jv"），且 bind 对账跳过（ghostkey 不是反射
        // 字段，不跳过必假失败 exit 1）。
        NestedCw n = new NestedCw();
        n.OpenHost(host);
        if (n.root == null || n.root.Find("n1") == null) {
            Console.WriteLine("NESTED_MISS");
            bad = bad + 1;
        }
        Label n2 = n.root != null ? (Label)n.root.Find("n2") : null;
        if (n2 == null || n2.GetText() != "jv") {
            Console.WriteLine("VIEWMODEL_MISS");
            bad = bad + 1;
        }
        n.Close();

        // Close 重入幂等：Close() 触发 OnCloseRequested，覆写再调 Close()
        // 必须早退——走到这里没爆栈且计数恰为 1 即证明幂等成立。
        CloseRecursionCw cr = new CloseRecursionCw();
        cr.OpenHost(host);
        cr.Close();
        if (cr.closeRequests != 1) {
            Console.WriteLine("CLOSE_RECURSION_MISS");
            bad = bad + 1;
        }

        // z-text 绑定 + 裸 readonly：初始推送、只读落 PropSpec、
        // 改字段一帧同步（SyncFromNode bindProp=text 路径）。
        TextCw t = new TextCw();
        t.OpenHost(host);
        TextArea ta = (TextArea)t.root.Find("ta1");
        if (ta == null || ta.GetText() != "hello") {
            Console.WriteLine("ZTEXT_INIT_MISS");
            bad = bad + 1;
        }
        if (ta.GetProp("readonly") != "true") {
            Console.WriteLine("READONLY_MISS");
            bad = bad + 1;
        }
        t.introText = "changed";
        t.MarkDirty();
        t.RequestRedraw();
        t.Render();
        if (ta.GetText() != "changed") {
            Console.WriteLine("ZTEXT_SYNC_MISS");
            bad = bad + 1;
        }
        t.Close();

        if (bad == 0) {
            Console.WriteLine("CWDOCSCAN_OK");
            return 0;
        }
        return 1;
    }
}
