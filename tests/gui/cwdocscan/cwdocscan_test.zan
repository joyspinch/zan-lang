// ChildWindow 声明式装配回归（子窗收官）：
// 1) DesignName 未覆写时按"类名 ↔ 同名 .html"装载——顶层裸名（FlatCw.html）
//    与 src/Deep 嵌套递归（NestedCw.html，GetDirectories 裸名口径须拼父路径）；
// 2) EnsureDesign 默认挂窗自身为模型：data-bind="greeting" 对实例字段
//    初始推送 + 改字段后一帧同步（model→UI）；
// 3) OpenHost 装配序：@click 自动接线到实例方法（UiEvent.Raise 模拟点击）、
//    OnLoad 钩子按名 Invoke；
// 4) html 声明了不存在的方法/路径时 fail-fast exit 1（DocWire.AutoWire/
//    CheckBinds，与 Form.AutoWireDoc 同语义）——由同目录 diag 子用例钉住。
using System;
using System.Json;
using Gui;
using Gui.Widget;

class FlatCw : ChildWindow {
    public int hits = 0;
    public string greeting = "hi";
    public bool loaded = false;
    public Control seen;

    public void Grab() { this.seen = this.root; }

    [Custom]
    public void OnLoad(ChildWindow w) { this.loaded = true; }

    public void HitMe() { this.hits = this.hits + 1; }
}

class NestedCw : ChildWindow {
    public Control seen;

    public void Grab() { this.seen = this.root; }
}

// Close↔OnCloseRequested 互递归钉子：覆写里再调 Close() 是窗作者的
// 自然写法（关窗时顺带取消后台任务等），框架必须以 !open 早退兜底，
// 不得爆栈（B-ID163）。
class CloseRecursionCw : ChildWindow {
    public int closeRequests = 0;

    override void OnCloseRequested() {
        this.closeRequests = this.closeRequests + 1;
        this.Close();
    }
}

// z-text + 裸 readonly 通道（子窗迁移主配方）：textarea 文本绑定实例
// 字段（bindProp=text 初始推送 + 一帧同步）；裸 readonly 属性经 Html
// 属性协议落 PropSpec("readonly") 真生效（旧键 "readOnly" 大小写不
// 命中，裸属性值 "" 也不算开——均已在框架侧修正）。
class TextCw : ChildWindow {
    public string introText = "hello";
}

class CaseMain {
    static int Main() {
        Html.Install();
        ControlBootstrap.Install();
        int bad = 0;

        // 1+2+3：装配全链
        App host = App.CreateDark("cwdocscan", 320, 240);
        FlatCw f = new FlatCw();
        f.EnsureDesign();
        f.Grab();
        if (f.seen == null || f.seen.Find("f1") == null) {
            Console.WriteLine("FLAT_MISS");
            bad = bad + 1;
        }
        f.OpenHost(host);
        if (!f.loaded) {
            Console.WriteLine("ONLOAD_MISS");
            bad = bad + 1;
        }
        Label fl = (Label)f.seen.Find("flabel");
        if (fl == null || fl.GetText() != "hi") {
            Console.WriteLine("BIND_INIT_MISS");
            bad = bad + 1;
        }
        Button fb = (Button)f.seen.Find("fbtn");
        if (fb == null) {
            Console.WriteLine("BTN_MISS");
            bad = bad + 1;
        } else {
            fb.Click.Raise();
            if (f.hits != 1) {
                Console.WriteLine("WIRE_MISS");
                bad = bad + 1;
            }
        }
        f.greeting = "yo";
        f.MarkDirty();
        f.RequestRedraw();
        f.Render();
        if (fl.GetText() != "yo") {
            Console.WriteLine("BIND_SYNC_MISS");
            bad = bad + 1;
        }
        f.Close();

        // 1b：嵌套递归装载 + JsonValue 模型跳过 bind 对账（JsonValue 的
        // 键不是反射字段，CheckBinds 若不跳过必假失败 exit 1——ghostkey
        // 在 JsonValue 模型上不存在于反射面，能走到 OK 即证明跳过生效）
        NestedCw n = new NestedCw();
        n.EnsureDesign();
        n.Grab();
        if (n.seen == null || n.seen.Find("n1") == null) {
            Console.WriteLine("NESTED_MISS");
            bad = bad + 1;
        }
        JsonValue mdl = JsonValue.NewObject();
        mdl.PathSet("k", "v");
        n.SetRoot(n.seen, mdl);
        n.OpenHost(host);
        n.Close();

        // Close 重入幂等：Close() 触发 OnCloseRequested，覆写再调 Close()
        // 必须早退——走到这里没爆栈且计数恰为 1 即证明幂等成立。
        CloseRecursionCw cr = new CloseRecursionCw();
        cr.EnsureDesign();
        cr.OpenHost(host);
        cr.Close();
        if (cr.closeRequests != 1) {
            Console.WriteLine("CLOSE_RECURSION_MISS");
            bad = bad + 1;
        }

        // z-text 绑定 + 裸 readonly：初始推送、只读落 PropSpec、
        // 改字段一帧同步（SyncFromNode bindProp=text 路径）。
        TextCw t = new TextCw();
        t.EnsureDesign();
        t.OpenHost(host);
        TextArea ta = (TextArea)t.root.Find("ta1");
        if (ta == null || ta.GetText() != "hello") {
            Console.WriteLine("ZTEXT_INIT_MISS");
            bad = bad + 1;
        }
        if (ta.GetProp("readonly") != "true") {
            Console.WriteLine("READONLY_MISS");
            bad = bad + 1;
        }
        t.introText = "changed";
        t.MarkDirty();
        t.RequestRedraw();
        t.Render();
        if (ta.GetText() != "changed") {
            Console.WriteLine("ZTEXT_SYNC_MISS");
            bad = bad + 1;
        }
        t.Close();

        if (bad == 0) {
            Console.WriteLine("CWDOCSCAN_OK");
            return 0;
        }
        return 1;
    }
}
