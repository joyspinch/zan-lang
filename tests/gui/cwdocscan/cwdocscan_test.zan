// ChildWindow.EnsureDesign 类名回退 + 开发态散盘递归扫描回归：
// 1) DesignName() 未覆写时按"类名 ↔ 同名 .html"装载（此前默认 "" 恒
//    no-op，114 个子窗全数断供）；
// 2) 裸 html 在工作目录顶层命中（FlatCw.html）；
// 3) 嵌套 html 经 src/Deep/ 递归命中——Directory.GetDirectories 返回
//    裸目录名（stdlib 刻意口径），递归必须手动拼回父路径，此前子目录
//    永远按 CWD 相对名解析失败。
using System;
using Gui;
using Gui.Widget;

class FlatCw : ChildWindow {
    public Control seen;
    public void Grab() { this.seen = this.root; }
}

class NestedCw : ChildWindow {
    public Control seen;
    public void Grab() { this.seen = this.root; }
}

class App {
    static int Main() {
        Html.Install();
        ControlBootstrap.Install();
        int bad = 0;
        FlatCw f = new FlatCw();
        f.EnsureDesign();
        f.Grab();
        if (f.seen == null || f.seen.Find("f1") == null) {
            Console.WriteLine("FLAT_MISS");
            bad = bad + 1;
        }
        NestedCw n = new NestedCw();
        n.EnsureDesign();
        n.Grab();
        if (n.seen == null || n.seen.Find("n1") == null) {
            Console.WriteLine("NESTED_MISS");
            bad = bad + 1;
        }
        if (bad == 0) {
            Console.WriteLine("CWDOCSCAN_OK");
            return 0;
        }
        return 1;
    }
}
