using System;
using System.Globalization;
using Gui;
using Gui.Widget;

// Explicit source set (do not include ZanIDE.zan or other shell partials):
// this file, models/IdeRibbonFixture.zan, models/IdeRibbonWitness.zan,
// src/ide_zan/src/shell/{ZanIDE.Ribbon,ZanIDE.RibbonView,IdeRibbonViewOwner}.zan.
// Use --auto-stdlib --package-project <repo>; Gui/Workplace/Lang are real packages.
class IdeRibbonRetainedInputTest {
    static void Check(bool value, string label) { if (!value) { throw new Exception(label); } }
    static void Drain(App app) {
        app.DrainPosts();
        while (true) { Action action = Dispatcher.Take(); if (action == null) { break; } action(); }
    }
    static void Input(App app, int kind, int x, int y) { app.ProcessOffscreenInput(kind, x, y, 0, 0, 0, 0); }
    static Control GroupButton(Ribbon ribbon, int group, int item) {
        return ribbon.ChildAt(1).ChildAt(group).ChildAt(0).ChildAt(item);
    }
    static Control ButtonFor(Ribbon ribbon, int act) {
        for (int g = 0; g < ribbon.groups.Count; g = g + 1) {
            for (int j = 0; j < ribbon.groups[g].items.Count; j = j + 1) {
                if (ribbon.groups[g].items[j].act == act) { return GroupButton(ribbon, g, j); }
            }
        }
        return null;
    }
    static RibbonItem ItemFor(List<RibbonGroup> groups, int act) {
        for (int g = 0; g < groups.Count; g = g + 1) {
            for (int j = 0; j < groups[g].items.Count; j = j + 1) {
                if (groups[g].items[j].act == act) { return groups[g].items[j]; }
            }
        }
        return null;
    }
    static Label Caption(Control button) {
        for (int i = 0; i < button.ChildCount(); i = i + 1) {
            Control child = button.ChildAt(i);
            if (child is Label) { return (Label)child; }
        }
        return null;
    }
    static void CheckButtonContents(App app, Control button) {
        int left = button.bx + button.StyleInsetL();
        int right = button.bx + button.bw - button.StyleInsetR();
        for (int i = 0; i < button.ChildCount(); i = i + 1) {
            Control child = button.ChildAt(i);
            if (!child.StyleVisible()) { continue; }
            Check(child.bx >= left && child.bx + child.bw <= right,
                "standard Ribbon icon and caption stay inside the Button content box");
            if (child is Label) {
                Label label = (Label)child;
                // Relational selectors use MeasureTree's Label context. Inspect
                // that measured style; resolving here would use the caller's context.
                StyleBox measuredStyle = label.computedStyle;
                if (measuredStyle == null) { throw new Exception("prepared caption retains its measured style"); }
                int font = measuredStyle.FontOr(Style.FontFallback(app, "medium"));
                Check(label.bw - label.StyleInsetL() - label.StyleInsetR() >= Canvas.MeasureText(label.Str(), font),
                    "complete localized caption fits without clipping or ellipsis at the actual font size");
            }
        }
    }
    static void CheckVisibleContents(App app, Ribbon tree) {
        RibbonLayout layout = tree.CurrentLayout();
        Check(layout != null, "production Ribbon supplies prepared geometry");
        Control more = tree.OverflowButton();
        int right = more.Visible ? more.bx : tree.bx + tree.bw;
        for (int i = 0; i < layout.slots.Count; i = i + 1) {
            RibbonSlot slot = layout.slots[i];
            Control button = GroupButton(tree, slot.group, slot.item);
            if (slot.overflow) {
                Check(!button.Visible, "overflow retires the whole command Button");
                continue;
            }
            Check(button.Visible && button.bx >= tree.bx && button.bx + button.bw <= right,
                "every visible command stays inside the band or reserved overflow boundary");
            if (slot.kind != 2) {
                Check(button.bw >= button.prefW, "visible labeled Button receives its natural measured width");
                Label caption = Caption(button);
                Check(caption != null && caption.Visible && caption.Str() == slot.cmd.label,
                    "visible command keeps its original localized caption");
                if (slot.cmd.icon != "") {
                    Control icon = button.ChildAt(0);
                    Check(icon is IconView && icon.bw > 0 && icon.bh > 0, "command uses its real icon child");
                    if (slot.kind == 0) {
                        int centers = icon.bx * 2 + icon.bw - caption.bx * 2 - caption.bw;
                        Check(icon.by + icon.bh <= caption.by && centers >= -2 && centers <= 2,
                            "large command centers the icon above its caption");
                        Check(icon.by >= button.by && caption.by + caption.bh <= button.by + button.bh,
                            "large command contains both rows");
                    } else {
                        Check(icon.bx + icon.bw <= caption.bx, "small command keeps its icon beside the caption");
                    }
                }
            }
            CheckButtonContents(app, button);
        }
        if (tree.OverflowSlots().Count > 0) {
            Check(more.Visible && more.bw > 0 && more.bx >= tree.bx && more.bx + more.bw <= tree.bx + tree.bw,
                "real overflow Button remains visible inside the narrow host");
        }
    }
    static void CheckCommandReachability(Ribbon tree) {
        RibbonLayout layout = tree.CurrentLayout();
        List<RibbonSlot> overflow = tree.OverflowSlots();
        int flat = 0;
        for (int g = 0; g < tree.groups.Count; g = g + 1) {
            for (int j = 0; j < tree.groups[g].items.Count; j = j + 1) {
                int entries = 0;
                for (int i = 0; i < layout.slots.Count; i = i + 1) {
                    if (layout.slots[i].flat == flat && !layout.slots[i].overflow) { entries = entries + 1; }
                }
                for (int i = 0; i < overflow.Count; i = i + 1) {
                    if (overflow[i].flat == flat) { entries = entries + 1; }
                }
                Check(entries == 1, "every production command has exactly one visible band or overflow entry, including optional commands");
                flat = flat + 1;
            }
        }
    }
    static void CheckOverflowOrder(Ribbon tree, string expected) {
        string actual = "";
        List<RibbonSlot> slots = tree.OverflowSlots();
        for (int i = 0; i < slots.Count; i = i + 1) {
            if (i > 0) { actual = actual + ","; }
            actual = actual + Convert.ToString(slots[i].cmd.act);
        }
        Check(actual == expected, "production overflow keeps the complete ordered command set: " + actual);
    }
    static void CheckPopupInput(App app, Ribbon tree, Control popup, string expected) {
        List<Control> endpoints = new List<Control>();
        popup.CollectInputFocus(app, endpoints);
        popup.CollectInputClicks(app, popup, endpoints);
        List<RibbonSlot> slots = tree.OverflowSlots();
        Check(popup.ChildCount() == slots.Count, "all overflow commands remain in the painted menu");
        string actual = "";
        for (int i = 0; i < popup.ChildCount(); i = i + 1) {
            Control row = popup.ChildAt(i);
            Check(row.parent == popup && popup.ChildInViewport(row),
                "every painted menu row belongs directly to the current popup viewport");
            Control hit = popup.HitTest(row.bx + row.bw / 2, row.by + row.bh / 2, 0);
            Check(hit != null && row.ContainsInputControl(hit),
                "every complete menu row is geometrically hit, including disabled commands");
            Check(row.IsDisabled() == !slots[i].cmd.enabled
                && row.InputFocusEligible(app, popup) == slots[i].cmd.enabled
                && endpoints.Contains(row) == slots[i].cmd.enabled,
                "focus and click endpoints follow the production command enabled state");
            if (!endpoints.Contains(row)) { continue; }
            if (actual != "") { actual = actual + ","; }
            actual = actual + Convert.ToString(slots[i].cmd.act);
        }
        Check(actual == expected, "popup exposes the complete ordered set of executable commands: " + actual);
    }
    static void CheckPopupSurface(ZanIDE ide, Control popup) {
        App app = ide.Host();
        Check(popup.Kind() == "ContextMenu" && popup.name == "ribbon-overflow-menu",
            "Ribbon popup uses the standard ContextMenu surface with stable identity");
        StyleBox surface = popup.computedStyle;
        if (surface == null) { throw new Exception("prepared popup retains its standard surface style"); }
        int background = surface.BgOr(0);
        Check(background != 0 && background == app.theme.bgSecondary, "popup background comes from the standard menu palette");
        int bottom = popup.by + popup.bh - popup.StyleInsetB();
        for (int i = 0; i < popup.ChildCount(); i = i + 1) {
            Control row = popup.ChildAt(i);
            Check(row.by >= popup.by + popup.StyleInsetT() && row.by + row.bh <= bottom
                && row.bh == row.StyleHeightIn(0), "normal-height popup contains every complete declared-height command row");
            CheckButtonContents(app, row);
        }
        app.BeginOffscreenFrame();
        Check(app.PrepareStandardHostFrame(), "standard frame prepares popup paint");
        ide.Paint();
        // A contrasting underlying surface makes a missing menu background visible.
        app.canvas.FillRect(popup.bx, popup.by, popup.bw, popup.bh, (int)0xFFE12779);
        app.overlayHost.RenderAll(app); app.EndOffscreenFrame();
        int x = popup.bx + popup.StyleInsetL() - app.Scale(1);
        Check(app.canvas.GetPixel(x, popup.by + popup.StyleInsetT()) == background
            && app.canvas.GetPixel(x, popup.by + popup.bh / 2) == background
            && app.canvas.GetPixel(x, bottom - 1) == background,
            "real menu paint covers top, middle and bottom padding without showing the underlying surface");
    }
    static void Down(App app, Control control) {
        Check(control != null && control.Visible && control.bw > 0 && control.bh > 0, "actual IDE button is laid out");
        Input(app, 2, control.bx + control.bw / 2, control.by + control.bh / 2);
        Check(app.GetCapturedPointer() == control, "IDE Down captures the production button");
    }
    static void Up(App app, Control control) {
        Input(app, 3, control.bx + control.bw / 2, control.by + control.bh / 2); Drain(app);
    }
    static void Click(App app, Control control) { Down(app, control); Up(app, control); }
    static void QueueMutation(ZanIDE ide, Control control, Action mutation) {
        App app = ide.Host(); Down(app, control);
        // Up's EndLoopTurn drains mutation before the real queued Button action.
        app.Post(mutation); Up(app, control);
    }
    static void Paint(ZanIDE ide) {
        App app = ide.Host(); app.BeginOffscreenFrame();
        Check(app.PrepareStandardHostFrame(), "standard frame prepares the production Ribbon before Paint");
        ide.Paint(); app.overlayHost.RenderAll(app); app.EndOffscreenFrame();
    }
    static void Close(ZanIDE ide) {
        App app = ide.Host(); ide.Retire(); app.SetRootControl(null);
        app.StopLoop(); Drain(app); app.canvas.Destroy();
    }
    static void FirstDownAndLiveCommands() {
        App app = App.CreateOffscreen("IDE production Ribbon", 1800, 700);
        ZanIDE ide = new ZanIDE(app, 0); ide.SetLanguage("en"); Ribbon tree = ide.Tree();
        Check(tree.ChildCount() == 0 && !ide.Ready(), "startup has not prepared or painted Ribbon");
        int x = app.ShapeOffX() + app.Scale(36);
        int y = app.ShapeOffY() + app.ContentTop() + Ribbon.TabStripHeight(app)
            + app.theme.paddingSmall + app.Scale(24);
        Input(app, 2, x, y);
        Control first = ButtonFor(tree, 0);
        Check(ide.Ready() && first != null && app.GetCapturedPointer() == first,
            "very first Down prepares and captures through production view registration without Paint");
        Input(app, 3, x, y); Drain(app);
        Check(ide.Executed == 1 && ide.Seen == 0, "first Up executes semantic UiCommand exactly once without Paint");
        Control band = tree.ChildAt(1); UiViewScope view = ide.View();
        for (int i = 0; i < 3; i = i + 1) { ide.PrepareRibbonView(app); }
        Check(ide.Tree() == tree && ide.View() == view && tree.ChildAt(1) == band && ButtonFor(tree, 0) == first,
            "unchanged production reprepare keeps scope, band and button identity");
        Paint(ide); Paint(ide);
        Check(ide.Executed == 1 && tree.ChildAt(1) == band && ButtonFor(tree, 0) == first,
            "production Paint never rebuilds or replays a command");

        int commands = 0;
        for (int g = 0; g < tree.groups.Count; g = g + 1) { commands = commands + tree.groups[g].items.Count; }
        for (int frame = 0; frame < 2; frame = frame + 1) {
            app.BeginOffscreenFrame();
            int reads = ide.CommandStateReads;
            Check(app.PrepareStandardHostFrame(), "independent Ribbon owner prepares a standard frame");
            RibbonLayout layout = tree.CurrentLayout();
            Check(layout != null && ide.CommandStateReads == reads + commands,
            "standard frame projects live command state once through its Ribbon owner");
            ide.Paint(); ide.Paint();
            Check(tree.CurrentLayout() == layout && ide.CommandStateReads == reads + commands,
            "repeated Paint reuses the prepared layout without projecting command state");
            app.EndOffscreenFrame();
        }

        UiCommand command = ide.SharedCommand(0);
        List<RibbonGroup> before = ide.CommandGroups(0);
        ide.SetCommandState(false, true); List<RibbonGroup> after = ide.CommandGroups(0);
        RibbonItem oldItem = ItemFor(before, 0); RibbonItem newItem = ItemFor(after, 0);
        Check(oldItem != null && newItem != null && oldItem.enabled && !oldItem.on && !newItem.enabled && newItem.on,
            "CommandRibbonGroups keeps live UiCommand availability and checked state without changing older snapshots");
        Check(ide.SharedCommand(0) == command && command.Text == newItem.label,
            "live model projection preserves shared command identity and localized Text");
        ide.PrepareRibbonView(app);
        Check(ButtonFor(tree, 0) == first && first.IsDisabled() && first.ClassName.Contains(" on"),
            "enabled/checked changes refresh the retained production button without rebuilding");
        ide.SetCommandState(true, false); ide.PrepareRibbonView(app);
        Down(app, first); app.focus.SetFocused(first.WidgetId(), first);
        ide.SetCommandState(true, true); ide.PrepareRibbonView(app);
        Check(app.GetCapturedPointer() == null && !app.focus.IsFocused(first.WidgetId()) && ButtonFor(tree, 0) == first,
            "checked-only change retires capture and focus while preserving button identity");
        Up(app, first); Check(ide.Executed == 1, "release after checked-state retirement cannot execute");
        Down(app, first); ide.SetCommandState(false, true); Up(app, first);
        Check(ide.Executed == 1 && first.IsDisabled(), "Up prepares new CanExecute state before command dispatch");
        ide.SetCommandState(true, false); ide.PrepareRibbonView(app);
        QueueMutation(ide, first, () => {
            ide.SetCommandState(false, true); ide.PrepareRibbonView(app);
            ide.SetCommandState(true, false); ide.PrepareRibbonView(app); ide.Mutations = ide.Mutations + 1;
        });
        Check(ide.Mutations == 1 && ide.Executed == 1 && !first.IsDisabled(),
            "enabled off/on roundtrip retires the actual queued old command");
        Click(app, first); Check(ide.Executed == 2 && ide.Seen == 0, "fresh endpoint still executes after live state retirement");
        QueueMutation(ide, first, () => {
            ide.SetCompact(true); ide.PrepareRibbonView(app);
            ide.SetCompact(false); ide.PrepareRibbonView(app); ide.Mutations = ide.Mutations + 1;
        });
        Check(ide.Mutations == 2 && ide.Executed == 2 && ButtonFor(tree, 0) == first,
            "compact away/back invalidates old queued production input while keeping unchanged buttons");
        Click(app, ButtonFor(tree, 20));
        Check(ide.Executed == 3 && ide.Seen == 20 && !tree.Visible && !ide.Ready()
            && app.GetCapturedPointer() == null, "production compact command retires its own Ribbon immediately");
        ide.SetCompact(false); ide.PrepareRibbonView(app);
        Check(ide.Ready() && ButtonFor(tree, 0) == first, "production input resumes in the same retained tree after compact");
        Close(ide); Console.WriteLine("IDE_RIBBON_FIRST_INPUT_LIVE_STATE_OK");
    }
    static void TabsLanguageAndPanels() {
        App app = App.CreateOffscreen("IDE Ribbon tabs", 1800, 700);
        ZanIDE ide = new ZanIDE(app, 0); ide.SetLanguage("en"); ide.PrepareRibbonView(app);
        Ribbon tree = ide.Tree(); Control oldBand = tree.ChildAt(1); Control oldButton = ButtonFor(tree, 0);
        Click(app, tree.ChildAt(0).ChildAt(1));
        Check(ide.Ready() && tree.ChildAt(1) != oldBand && oldButton.FindApp() == null && ButtonFor(tree, 19) != null,
            "real tab click rebuilds and prepares IDE View command groups before Paint");
        Control panel = GroupButton(tree, 2, 0);
        Check(tree.groups[2].items[0].act == -3 && !ide.Dock().IsHidden("panel0"),
            "panel acts encode negative global flat index after semantic commands");
        Click(app, panel);
        Check(ide.Executed == 0 && ide.Dock().IsHidden("panel0") && !tree.groups[2].items[0].on,
            "first panel Down/Up uses production negative-act dispatch and real DockHost without Paint");
        Check(GroupButton(tree, 2, 0) == panel && panel.Tip.Contains("Show panel"),
            "panel state and hint refresh in place after production dispatch");
        oldBand = tree.ChildAt(1); Control oldTab = tree.ChildAt(0).ChildAt(1);
        UiCommand agent = ide.SharedCommand(19);
        Check(tree.tabs[0] == "Home" && agent.Text == "Agent", "fixture exercises real English Lang lookup before switching");
        ide.SetLanguage("zh");
        ide.PrepareRibbonView(app);
        Check(ide.Ready() && tree.ChildAt(1) != oldBand && oldTab.FindApp() == null,
            "language change replaces old tab and band trees without Paint");
        Check(tree.tabs[0] == "开始" && agent == ide.SharedCommand(19) && agent.Text == "智能体",
            "language rebuild updates shared UiCommand Text without replacing the command");
        oldBand = tree.ChildAt(1); Control agentButton = ButtonFor(tree, 19);
        QueueMutation(ide, agentButton, () => {
            ide.SetTab(0); ide.PrepareRibbonView(app); ide.SetTab(1); ide.PrepareRibbonView(app);
            ide.Mutations = ide.Mutations + 1;
        });
        Check(ide.Mutations == 1 && ide.Executed == 0 && tree.ChildAt(1) != oldBand,
            "tab away/back rejects a real queued old production command");
        agentButton = ButtonFor(tree, 19);
        QueueMutation(ide, agentButton, () => {
            ide.SetLanguage("en"); ide.PrepareRibbonView(app);
            ide.SetLanguage("zh"); ide.PrepareRibbonView(app); ide.Mutations = ide.Mutations + 1;
        });
        Check(ide.Mutations == 2 && ide.Executed == 0, "language away/back rejects a real queued old command");
        ide.SetLanguage("en"); Close(ide); Console.WriteLine("IDE_RIBBON_TABS_LANGUAGE_PANEL_OK");
    }
    static void ChineseCaptionsAtDpi(int dpi) {
        App app = App.CreateOffscreen("IDE Chinese Ribbon widths", 1800, 900);
        app.SetOffscreenViewport(1800, 900, dpi);
        ZanIDE ide = new ZanIDE(app, 0); ide.SetLanguage("zh"); ide.PrepareRibbonView(app);
        Ribbon tree = ide.Tree();
        Check(ide.Ready() && tree.OverflowSlots().Count == 0, "wide Chinese Home keeps all production commands");
        CheckVisibleContents(app, tree);
        Control hot = ButtonFor(tree, 11); Control project = ButtonFor(tree, 12);
        Label hotCaption = Caption(hot); Label configCaption = Caption(project);
        Label compactCaption = Caption(ButtonFor(tree, 20)); Label updateCaption = Caption(ButtonFor(tree, 18));
        if (hotCaption == null || configCaption == null || compactCaption == null || updateCaption == null) {
            throw new Exception("all four long Chinese production commands retain their standard Label");
        }
        Check(hotCaption.Str() == "热重载" && configCaption.Str() == "工程配置"
            && compactCaption.Str() == "极简模式" && updateCaption.Str() == "检查更新",
            "long Chinese labels come from unchanged production command definitions");
        int initialProjectWidth = project.prefW;
        int initialCaptionWidth = configCaption.prefW;
        UiCommand command = ide.SharedCommand(11);
        Check(command.Text == hotCaption.Str() && hot.bw >= hot.prefW,
            "semantic UiCommand and actual standard Button share the complete localized label");
        Click(app, hot);
        Check(ide.Executed == 1 && ide.Seen == 11 && ide.SharedCommand(11) == command,
            "naturally widened production command executes the same UiCommand exactly once");

        app.SetOffscreenViewport(900, 900, dpi); ide.PrepareRibbonView(app);
        CheckVisibleContents(app, tree); CheckCommandReachability(tree);
        Check(tree.OverflowSlots().Count > 0 && tree.OverflowButton().Visible,
            "900 logical pixel Home keeps optional commands reachable through the real overflow Button");
        CheckOverflowOrder(tree, "14,18,17");
        Click(app, tree.OverflowButton()); Control standardPopup = app.overlayHost.ActiveRoot();
        Check(standardPopup != null, "900 logical pixel Home opens its retained optional command menu");
        CheckPopupSurface(ide, standardPopup);
        Click(app, standardPopup.ChildAt(standardPopup.ChildCount() - 1));
        Check(ide.Seen == 17 && !app.overlayHost.HasActive(), "last optional assistant command remains visible and clickable");
        app.SetOffscreenViewport(540, 900, dpi); ide.PrepareRibbonView(app);
        CheckVisibleContents(app, tree); CheckCommandReachability(tree);
        CheckOverflowOrder(tree, "12,15,13,20,14,18,17");
        Click(app, tree.OverflowButton()); standardPopup = app.overlayHost.ActiveRoot();
        Check(standardPopup != null && standardPopup.ChildCount() == tree.OverflowSlots().Count,
            "540 logical pixel Home opens every overflow entry including optional commands");
        CheckPopupSurface(ide, standardPopup);
        Click(app, standardPopup.ChildAt(standardPopup.ChildCount() - 1));
        Check(ide.Seen == 17 && !app.overlayHost.HasActive(), "540 logical pixel menu includes a complete clickable last row");

        // The real empty Start page has no project: configuration and extensions
        // stay painted, but are deliberately absent from executable endpoints.
        ide.SetProjectAvailable(false); ide.PrepareRibbonView(app);
        CheckOverflowOrder(tree, "12,15,13,20,14,18,17");
        Click(app, tree.OverflowButton()); standardPopup = app.overlayHost.ActiveRoot();
        if (standardPopup == null) { throw new Exception("empty Start page opens all seven overflow rows"); }
        CheckPopupSurface(ide, standardPopup);
        CheckPopupInput(app, tree, standardPopup, "13,20,14,18,17");
        int beforeDisabledClick = ide.Executed;
        for (int i = 0; i < 2; i = i + 1) {
            Control disabled = standardPopup.ChildAt(i);
            Check(disabled.IsDisabled(), "project-only overflow command is disabled without a project");
            int x = disabled.bx + disabled.bw / 2;
            int y = disabled.by + disabled.bh / 2;
            Input(app, 2, x, y);
            Check(app.GetCapturedPointer() == null, "disabled menu row does not capture the real pointer");
            Input(app, 3, x, y); Drain(app);
            Check(ide.Executed == beforeDisabledClick && app.overlayHost.ActiveRoot() == standardPopup,
                "disabled project command neither executes nor dismisses the retained popup");
        }
        ide.SetProjectAvailable(true); ide.PrepareRibbonView(app);
        Check(!app.overlayHost.HasActive(), "project availability retires the old disabled popup session");
        for (int i = 0; i < 2; i = i + 1) {
            Click(app, tree.OverflowButton()); standardPopup = app.overlayHost.ActiveRoot();
            if (standardPopup == null) { throw new Exception("project state reopens the current overflow session"); }
            CheckOverflowOrder(tree, "12,15,13,20,14,18,17");
            CheckPopupInput(app, tree, standardPopup, "12,15,13,20,14,18,17");
            int beforeProjectClick = ide.Executed;
            Click(app, standardPopup.ChildAt(i));
            Check(ide.Executed == beforeProjectClick + 1 && ide.Seen == (i == 0 ? 12 : 15)
                && !app.overlayHost.HasActive(), "enabled project command routes the formerly disabled row exactly once");
        }

        // Check real child font and box-model changes, rather than a parallel
        // ribbon::item text estimate which cannot see the standard Button tree.
        app.SetOffscreenViewport(2400, 900, dpi);
        app.UseAppCss(".ribbon-cmd { padding:var(--padding-small) var(--padding-large); column-gap:var(--gap-large); }"
            + ".ribbon-cmd > label { font-size:18px; }");
        ide.PrepareRibbonView(app);
        Check(ButtonFor(tree, 11) == hot && ButtonFor(tree, 12) == project,
            "font and padding remeasure preserve production retained Buttons");
        CheckVisibleContents(app, tree);
        Label projectCaption = Caption(project);
        if (projectCaption == null) { throw new Exception("remeasured project command retains its standard Label"); }
        StyleBox measuredCaptionStyle = projectCaption.computedStyle;
        if (measuredCaptionStyle == null) { throw new Exception("remeasured project Label retains its contextual font style"); }
        int changedFont = measuredCaptionStyle.FontOr(0);
        Check(changedFont == app.Scale(18), "caption assertion uses the overridden real Label font");
        Check(projectCaption.prefW == Canvas.MeasureText(projectCaption.Str(), changedFont)
                + projectCaption.StyleInsetL() + projectCaption.StyleInsetR()
            && projectCaption.prefW > initialCaptionWidth && project.prefW > initialProjectWidth,
            "stylesheet font and padding changes increase actual Label measurement and retained Button natural width");

        app.SetOffscreenViewport(900, 900, dpi); ide.PrepareRibbonView(app);
        Check(tree.OverflowSlots().Count > 0 && tree.OverflowButton().Visible,
            "900 logical pixel Chinese Home reserves a real overflow Button after normal Fit degradation");
        CheckVisibleContents(app, tree);
        int selected = -1; int act = -1;
        for (int i = 0; i < tree.OverflowSlots().Count; i = i + 1) {
            RibbonItem item = tree.OverflowSlots()[i].cmd;
            if (item.act != 20) { selected = i; act = item.act; break; }
        }
        Check(selected >= 0, "Chinese narrow Home retains a semantic command in overflow");
        Click(app, tree.OverflowButton()); Control popup = app.overlayHost.ActiveRoot();
        Check(popup != null && popup.ChildCount() == tree.OverflowSlots().Count,
            "real Down/Up opens the production overflow popup before Paint");
        for (int i = 0; i < popup.ChildCount(); i = i + 1) { CheckButtonContents(app, popup.ChildAt(i)); }
        int executions = ide.Executed;
        Click(app, popup.ChildAt(selected));
        Check(ide.Executed == executions + 1 && ide.Seen == act && !app.overlayHost.HasActive(),
            "Chinese overflow selection executes its original semantic command exactly once");
        app.SetOffscreenViewport(2400, 900, dpi); ide.PrepareRibbonView(app);
        Check(ButtonFor(tree, 11) == hot && ButtonFor(tree, 12) == project && tree.OverflowSlots().Count == 0,
            "widening restores labels and original Buttons without a compatibility tree");
        CheckVisibleContents(app, tree);
        Close(ide);
    }
    static void OverflowAtDpi(int dpi) {
        App app = App.CreateOffscreen("IDE Ribbon panel overflow", 180, 900);
        app.SetOffscreenViewport(180, 900, dpi);
        ZanIDE ide = new ZanIDE(app, 1); ide.SetLanguage("en"); ide.PrepareRibbonView(app);
        Ribbon tree = ide.Tree();
        Check(ide.Ready() && app.canvas.Width() == app.Scale(180) && tree.bw == app.ClientWidth()
            && tree.bx == app.ShapeOffX() && tree.by == app.ShapeOffY() + app.ContentTop(),
            "narrow IDE preparation uses DPI-scaled client geometry inside the shape insets");
        Check(tree.OverflowSlots().Count > 0 && tree.OverflowButton().Visible,
            "narrow IDE prepare creates production overflow without Paint");
        RibbonLayout layout = tree.CurrentLayout();
        Check(layout.width > tree.bw, "narrow fixture forces overflow after production Fit degradation");
        Check(layout.slots[0].w >= app.Scale(64), "IDE retained layout keeps current DPI size floor and natural content width");
        CheckVisibleContents(app, tree);
        for (int i = 0; i < layout.slots.Count; i = i + 1) {
            RibbonSlot slot = layout.slots[i];
            if (slot.overflow) { continue; }
            Control button = GroupButton(tree, slot.group, slot.item);
            Check(button.bx >= tree.bx && button.bx + button.bw <= tree.OverflowButton().bx,
                "visible production commands stay inside reserved overflow geometry");
        }
        int selected = -1; int flat = -1;
        for (int i = 0; i < tree.OverflowSlots().Count; i = i + 1) {
            RibbonSlot slot = tree.OverflowSlots()[i];
            if (slot.cmd.act < 0) { selected = i; flat = slot.flat; break; }
        }
        Check(selected >= 0 && flat >= 2, "real panel switch overflows after two semantic View commands");
        string panelId = "panel" + Convert.ToString(flat - 2);
        Check(!ide.Dock().IsHidden(panelId), "overflow target starts visible");
        ide.Overflow();
        Control popup = app.overlayHost.ActiveRoot();
        Check(popup != null && popup.ChildCount() == tree.OverflowSlots().Count,
            "production OpenRibbonOverflow creates the component popup");
        ide.PrepareRibbonView(app); Paint(ide); Paint(ide);
        Check(app.overlayHost.ActiveRoot() == popup, "unchanged IDE prepare and Paint preserve live popup session");
        Click(app, popup.ChildAt(selected));
        Check(ide.Dock().IsHidden(panelId) && ide.Executed == 0 && !app.overlayHost.HasActive(),
            "overflow panel selection reaches DockHost with correct flat index at current DPI");
        Check(!tree.groups[2].items[flat - 2].on, "overflow panel state is refreshed immediately by production preparation");
        ide.Overflow(); popup = app.overlayHost.ActiveRoot();
        Check(popup != null, "production overflow reopens after panel toggle");
        Control retainedAgent = ButtonFor(tree, 19);
        QueueMutation(ide, popup.ChildAt(selected), () => {
            app.SetOffscreenViewport(180, 900, dpi == 200 ? 150 : 200); ide.PrepareRibbonView(app);
            app.SetOffscreenViewport(180, 900, dpi); ide.PrepareRibbonView(app);
            ide.Mutations = ide.Mutations + 1;
        });
        Check(ide.Mutations == 1 && ide.Dock().IsHidden(panelId) && ide.Executed == 0
            && !app.overlayHost.HasActive() && ButtonFor(tree, 19) == retainedAgent,
            "DPI away/back keeps buttons but retires actual queued old panel popup action");
        ide.Overflow(); popup = app.overlayHost.ActiveRoot();
        Check(popup != null, "overflow opens with fresh DPI endpoints");
        Control firstPopup = popup.ChildAt(0);
        Down(app, firstPopup); app.focus.SetFocused(firstPopup.WidgetId(), firstPopup);
        ide.SetCompact(true); ide.PrepareRibbonView(app);
        Check(!tree.Visible && !ide.Ready() && !app.overlayHost.HasActive()
            && app.GetCapturedPointer() == null && !app.focus.IsFocused(firstPopup.WidgetId()),
            "compact preparation retires popup, capture and focus");
        Up(app, firstPopup); ide.SetCompact(false); ide.PrepareRibbonView(app);
        Check(ide.Ready() && ide.Executed == 0, "compact exit prepares fresh input without replaying popup command");
        app.SetOffscreenViewport(1800, 900, dpi); ide.PrepareRibbonView(app);
        Control agentButton = ButtonFor(tree, 19); Check(agentButton != null, "View command restored after wide reprepare");
        QueueMutation(ide, agentButton, () => {
            app.SetOffscreenViewport(180, 900, dpi); ide.PrepareRibbonView(app);
            app.SetOffscreenViewport(1800, 900, dpi); ide.PrepareRibbonView(app);
            ide.Mutations = ide.Mutations + 1;
        });
        Check(ide.Mutations == 2 && ide.Executed == 0 && ButtonFor(tree, 19) == agentButton,
            "narrow/wide reprepare preserves buttons and rejects queued old geometry command");
        Close(ide);
    }
    static void RetireAndStop() {
        App app = App.CreateOffscreen("IDE Ribbon retire queue", 1800, 700);
        ZanIDE ide = new ZanIDE(app, 0); ide.SetLanguage("en"); ide.PrepareRibbonView(app);
        Ribbon oldTree = ide.Tree(); UiEvent oldCommand = oldTree.CommandClicked;
        QueueMutation(ide, ButtonFor(oldTree, 0), () => { ide.Retire(); ide.Mutations = ide.Mutations + 1; });
        oldTree.lastAct = 0; oldCommand.Raise();
        Check(ide.Mutations == 1 && ide.Executed == 0 && ide.Tree() == null,
            "production retirement rejects real queued command and retained old semantic endpoint");
        ide.PrepareRibbonView(app); Ribbon fresh = ide.Tree();
        Check(fresh != oldTree && ide.Ready(), "new production view initializes after explicit retirement");
        oldCommand.Raise(); Click(app, ButtonFor(fresh, 0));
        Check(ide.Executed == 1, "old delegate cannot execute against replacement view while new input works");
        Close(ide);

        App stopped = App.CreateOffscreen("IDE Ribbon stop queue", 1800, 700);
        ZanIDE stopIde = new ZanIDE(stopped, 0); stopIde.SetLanguage("en"); stopIde.PrepareRibbonView(stopped);
        Ribbon stopTree = stopIde.Tree(); Control button = ButtonFor(stopTree, 0);
        UiEvent semantic = stopTree.CommandClicked; UiEvent click = ((Button)button).Click;
        // Global posts deliberately survive App.StopLoop; guards must reject them.
        stopTree.lastAct = 0; semantic.Post(); click.Post(); stopped.StopLoop(); Drain(stopped);
        Check(stopIde.Executed == 0 && !stopIde.View().IsActive(), "Stop invalidates globally queued production delegates");
        semantic.Raise(); click.Raise(); stopIde.PrepareRibbonView(stopped);
        Check(stopIde.Executed == 0 && stopIde.Tree() == null, "stopped production owner retires its input and never reinitializes");
        Close(stopIde); Console.WriteLine("IDE_RIBBON_RETIRE_STOP_OK");
    }
    static void Borrow(IdeRibbonWitness witness, bool stop) {
        App app = App.CreateOffscreen("IDE Ribbon weak", 180, 900);
        ZanIDE ide = new ZanIDE(app, 1); ide.SetLanguage("en"); ide.PrepareRibbonView(app);
        Ribbon tree = ide.Tree();
        witness.Ide = ide; witness.App = app; witness.Ribbon = tree;
        witness.Host = ide.InputHost(); witness.View = ide.View(); witness.Owner = ide.ViewOwner();
        witness.Button = tree.OverflowButton(); witness.CommandEndpoint = tree.CommandClicked;
        witness.ButtonEndpoint = tree.OverflowButton().Click;
        ide.Overflow(); Control popup = app.overlayHost.ActiveRoot();
        Check(popup != null, "weak fixture opens actual production popup");
        witness.Popup = popup; witness.PopupEndpoint = ((Button)popup.ChildAt(0)).Click;
        Paint(ide);
        if (stop) { app.StopLoop(); }
        ide.Retire(); app.SetRootControl(null); Drain(app); app.canvas.Destroy();
    }
    static void WeakRelease(bool stop) {
        IdeRibbonWitness witness = new IdeRibbonWitness(); Borrow(witness, stop);
        Check(witness.Ide == null && witness.App == null && witness.Ribbon == null && witness.Host == null
            && witness.View == null && witness.Owner == null && witness.Button == null && witness.Popup == null,
            "production IDE, App, scope, adapter, owner, button and popup weak references release with delegates retained");
        witness.CommandEndpoint.Raise(); witness.ButtonEndpoint.Raise(); witness.PopupEndpoint.Raise();
        witness.CommandEndpoint.Post(); witness.ButtonEndpoint.Post(); witness.PopupEndpoint.Post();
        while (true) { Action action = Dispatcher.Take(); if (action == null) { break; } action(); }
    }
    static void Main() {
        App frame = App.CreateOffscreen("independent frame", 8, 8);
        // Deterministic language configuration; no IDE assets or disk reads.
        Lang.packs = new Dictionary<string, Dictionary<string, string>>();
        Dictionary<string, string> english = new Dictionary<string, string>();
        english.Add("Home", "Home"); english.Add("View", "View"); english.Add("Agent", "Agent");
        Lang.packs.Add("en", english);
        FirstDownAndLiveCommands(); TabsLanguageAndPanels();
        ChineseCaptionsAtDpi(100); ChineseCaptionsAtDpi(150); ChineseCaptionsAtDpi(200);
        OverflowAtDpi(100); OverflowAtDpi(150); OverflowAtDpi(200);
        Console.WriteLine("IDE_RIBBON_OVERFLOW_DPI_COMPACT_OK");
        RetireAndStop(); WeakRelease(false); WeakRelease(true);
        Lang.Set(""); Lang.packs = null; Lang.dirs = null;
        frame.canvas.Destroy(); Console.WriteLine("IDE_RIBBON_VISIBLE_WEAK_OK");
    }
}
