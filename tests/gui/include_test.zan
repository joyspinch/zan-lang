// B-ID149②: <include> 组合——装载期把被引片段展开进窗口树，事件与
// 绑定对宿主窗口的类照常按名接线。离屏装载 + 触发断言，golden 单行。
// GREET 走字段（who）变更路径：@click 处理器改字段 → 自动标脏 → 泵推
// 进 Label（B-ID149⑤ 脏跳过下的正确性契约）。
using System;
using Gui;
using Gui.Widget;

class Include_test : Form {
    string who = "";

    void OnGreet() {
        who = "你好";
    }

    static void Main() {
        Include_test w = new Include_test();
        w.ShowOffscreen();
        Label frag = w.Get<Label>("FragLabel");
        Console.WriteLine("FRAG " + (frag != null ? frag.Text.Get() : "null"));
        Button b = w.Get<Button>("FragBtn");
        if (b == null) { Console.WriteLine("FRAG_BTN_NULL"); return; }
        b.Click.Raise();
        w.CaptureSnapshot();
        Label greet = w.Get<Label>("GreetLabel");
        Console.WriteLine("GREET " + (greet != null ? greet.Text.Get() : "null"));
        Console.WriteLine("INCLUDE_OK");
    }
}
