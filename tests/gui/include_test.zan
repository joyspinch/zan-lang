// B-ID149②: <include> 组合——装载期把被引片段展开进窗口树，事件与
// 绑定对宿主窗口的类照常按名接线。离屏装载 + 触发断言，golden 单行。
// GREET 走字段（who）变更路径：@click 处理器改字段 → 自动标脏 → 泵推
// 进 Label（B-ID149⑤ 脏跳过下的正确性契约）。
using System;
using Gui;
using Gui.Widget;

class Include_test : Form {
    string who = "";

    void OnGreet() {
        who = "你好";
    }

    static Control CreateControl(string kind) {
        if (kind == "Label") { return new Label(); }
        if (kind == "Button") { return new Button(); }
        return null;
    }

    static void Main() {
        HtmlDoc fragment = Html.ParseWith("<include src='include_frag.html' />", "", null, CreateControl);
        if (!(fragment.root.Find("FragLabel") is Label) || !(fragment.root.Find("FragBtn") is Button)) {
            throw new Exception("fragment-start include did not use the document factory");
        }
        HtmlDoc fallback = Html.ParseWith("<table id='table'><tbody id='rows'><tr><td>"
            + "<label id='cell'>Cell</label></td></tr></tbody></table>"
            + "<tabs id='tabs'><tab-pane id='pane'><button id='action'>Action</button></tab-pane></tabs>"
            + "<select id='select'><option id='option'>Option</option></select>", "", null, CreateControl);
        Control rows = fallback.root.Find("rows");
        Control pane = fallback.root.Find("pane");
        Control option = fallback.root.Find("option");
        if (!(rows is Element) || rows.parent != fallback.root.Find("table") || !(rows.Find("cell") is Label)
            || !(pane is Element) || pane.parent != fallback.root.Find("tabs") || !(pane.Find("action") is Button)
            || !(option is Element) || option.parent != fallback.root.Find("select")
            || option.GetProp("text") != "Option") {
            throw new Exception("fallback elements lost their document children");
        }
        HtmlDoc textFallback = Html.ParseWith("<label id='label'>A &amp; B</label>"
            + "<button id='button'>  Click  me </button><textarea id='area'>Notes</textarea>",
            "", null, (string kind) => null);
        Control label = textFallback.root.Find("label");
        Control button = textFallback.root.Find("button");
        Control area = textFallback.root.Find("area");
        if (!(label is Element) || label.GetProp("text") != "A & B"
            || !(button is Element) || button.GetProp("text") != "Click me"
            || !(area is Element) || area.GetProp("text") != "Notes") {
            throw new Exception("fallback elements lost their inline text");
        }
        Include_test w = new Include_test();
        w.ShowOffscreen();
        Label frag = w.Get<Label>("FragLabel");
        Console.WriteLine("FRAG " + (frag != null ? frag.Text.Get() : "null"));
        Button b = w.Get<Button>("FragBtn");
        if (b == null) { Console.WriteLine("FRAG_BTN_NULL"); return; }
        b.Click.Raise();
        w.CaptureSnapshot();
        Label greet = w.Get<Label>("GreetLabel");
        Console.WriteLine("GREET " + (greet != null ? greet.Text.Get() : "null"));
        Console.WriteLine("INCLUDE_OK");
    }
}
