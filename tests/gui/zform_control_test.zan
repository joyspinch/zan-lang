using System;
using Gui;
using Gui.Widget;

/// Code-behind of the tested control document (zform_control.zform): a
/// `"role": "control"` .zform generates `partial class ZfPanel : Control`, so
/// the panel is embeddable in another design instead of being a whole window.
partial class ZfPanel {
    void OnInit() {
    }
}

/// Covers what a control document must produce headlessly: the designed tree
/// lands under the control itself, and the designer's `label` reaches every
/// control that publishes a `text` property (containers keep it as a design
/// note only). Event delivery goes through __Dispatch, which drops the event
/// when no host form is attached.
class ZformControlTest {
    static int fails;
    static bool went;

    static void Went() { went = true; }

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void Main() {
        fails = 0;

        ZfPanel p = new ZfPanel();
        ZformControlTest.Eq("kind", p.Kind(), "ZfPanel");

        // The design tree is the control's own children, not a window's.
        if (p.ChildCount() == 0) {
            fails = fails + 1;
            Console.WriteLine("FAIL control has no designed children");
        }

        // `label` is the caption of anything publishing `text`.
        ZformControlTest.Eq("label text", p.Caption.GetProp("text"),
                            "side panel");
        ZformControlTest.Eq("button text", p.GoBtn.GetProp("text"), "Go");
        ZformControlTest.Eq("button name", p.GoBtn.name, "GoBtn");

        // A designed container field is built with `new <Kind>()`, so every
        // container kind must have a parameterless constructor that runs
        // InitControl: a container whose constructor never ran has a null
        // child list and faults on the first Add (the Help page's gallery).
        if (p.Box == null || p.Box.ChildCount() != 1) {
            fails = fails + 1;
            Console.WriteLine("FAIL designed Card did not take its child");
        }
        ZformControlTest.Eq("card note", p.BoxNote.GetProp("text"), "in card");

        // A container has no text property: its label stays a design note and
        // must not degrade into a style class.
        ZformControlTest.Eq("container text", p.Body.GetProp("text"), "");
        ZformControlTest.Eq("container class", p.Body.GetProp("class"), "");

        // A control document is a type, not a singleton: a second instance
        // owns a second widget tree, and editing one leaves the other alone.
        ZfPanel q = new ZfPanel();
        if (q.GoBtn == p.GoBtn || q.Caption == p.Caption) {
            fails = fails + 1;
            Console.WriteLine("FAIL second instance shares the first's widgets");
        }
        q.Caption.SetProp("text", "other panel");
        ZformControlTest.Eq("first instance untouched",
                            p.Caption.GetProp("text"), "side panel");
        ZformControlTest.Eq("second instance edited",
                            q.Caption.GetProp("text"), "other panel");

        // Unhosted dispatch is a no-op rather than a crash.
        p.__Dispatch("go");

        // Adding the control to a window hands it its host form, so a designed
        // event reaches the registry without the host wiring anything by hand.
        Form form = new Form("host", 200, 100);
        form.On("go", ZformControlTest.Went);
        form.Add(p);
        p.__Dispatch("go");
        if (!went) {
            fails = fails + 1;
            Console.WriteLine("FAIL attaching the control did not hand it the form");
        }
        // The other instance is still unhosted: its events go nowhere.
        went = false;
        q.__Dispatch("go");
        if (went) {
            fails = fails + 1;
            Console.WriteLine("FAIL an unattached instance reached the host form");
        }

        if (fails == 0) { Console.WriteLine("ZFORM_CONTROL_OK"); }
    }
}
