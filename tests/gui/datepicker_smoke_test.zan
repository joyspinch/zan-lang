using System;
using Gui;
using Gui.Widget;

partial class DatePickerSmokePanel {
    void OnInit() {
    }
}

class DatePickerSmokeTest {
    static int fails;
    static bool changed;

    static void Check(string what, bool ok) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Changed() {
        DatePickerSmokeTest.changed = true;
    }

    static void Main() {
        fails = 0;
        DatePickerSmokePanel panel = new DatePickerSmokePanel();
        DateTime initial = panel.Picker.GetDate();
        DatePickerSmokeTest.Check("designed picker", panel.Picker != null);
        DatePickerSmokeTest.Check("initial text", panel.Picker.Text().Length == 10);

        panel.Picker.SetDate(DateTime.FromDate(2024, 2, 29));
        DatePickerSmokeTest.Check("set date",
            panel.Picker.Text() == "2024-02-29");

        panel.Picker.SetText("2024-02-30");
        DatePickerSmokeTest.Check("invalid date keeps value",
            panel.Picker.GetDate().Equals(DateTime.FromDate(2024, 2, 29)));
        DatePickerSmokeTest.Check("invalid date does not crash",
            panel.Picker.Text() == "2024-02-30");

        DatePickerSmokeTest.changed = false;
        panel.Picker.OnChange(DatePickerSmokeTest.Changed);
        panel.Picker.SetText("2025-01-03");
        DatePickerSmokeTest.Check("valid text updates value",
            panel.Picker.GetDate().Equals(DateTime.FromDate(2025, 1, 3)));
        DatePickerSmokeTest.Check("change event", DatePickerSmokeTest.changed);
        DatePickerSmokeTest.Check("initial instance remained independent",
            initial != null);

        DatePicker first = new DatePicker();
        DatePicker second = new DatePicker();
        first.SetDate(DateTime.FromDate(2023, 3, 4));
        second.SetDate(DateTime.FromDate(2023, 4, 5));
        DatePickerSmokeTest.Check("multiple instances keep first value",
            first.Text() == "2023-03-04");
        DatePickerSmokeTest.Check("multiple instances keep second value",
            second.Text() == "2023-04-05");

        if (fails == 0) {
            Console.WriteLine("DATEPICKER_SMOKE_OK");
        }
    }
}
