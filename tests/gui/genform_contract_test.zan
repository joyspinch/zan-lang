using System;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;

class ContractRow {
    string caption;
    int count;
}

partial class GenFormContract {
    static void OnLoad(Form form) {
    }
}

/// 核心契约与语义定义。
class GenFormContractTest {
    static int fails;

    static void Ok(string what, bool value) {
        if (value) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static string Tree(Control c) {
        string value = c.Kind() + "#" + c.name + "." + c.Class
            + ":" + Convert.ToString(c.dock)
            + ":" + Convert.ToString(c.logW) + "," + Convert.ToString(c.logH)
            + "," + Convert.ToString(c.logX) + "," + Convert.ToString(c.logY)
            + ":" + Convert.ToString(c.designFloat) + "," + Convert.ToString(c.designAnchor);
        if (c is Element) {
            Element element = (Element)c;
            if (element.elOrder != null) {
                for (int i = 0; i < element.elOrder.Count; i = i + 1) {
                    FlowEntry entry = element.elOrder[i];
                    if (entry.kid == null) { value = value + "[text:" + entry.text + "]"; }
                    else { value = value + "[order:" + entry.kid.Kind() + "#" + entry.kid.name + "]"; }
                }
            }
        }
        for (int i = 0; i < c.children.Count; i = i + 1) {
            value = value + "[" + Tree(c.children[i]) + "]";
        }
        return value;
    }

    static void Main() {
        fails = 0;
        DataTableBootstrap.Install();
        Control root = GenFormContract.__BuildForm();
        Control dynamicRoot = FormBuilder.Build(JsonValue.Parse(GenFormContract.__designDoc.ToJson()));
        Ok("generated and runtime trees identical", Tree(root) == Tree(dynamicRoot));
        Ok("HTML root and CSS", root is Element && root.Kind() == "body"
            && root.Class == "document" && root.designCss.Contains("body.document"));
        Element mixed = GenFormContract.Mixed;
        Ok("htmlTag emits typed Element", mixed.Kind() == "span" && mixed.Class == "natural");
        Ok("mixed text preserved", mixed.elOrder != null && mixed.elOrder.Count == 3
            && mixed.elOrder[0].text == "left " && mixed.elOrder[2].text == " right");
        Ok("typed child identity", mixed.elOrder != null
            && mixed.elOrder[1].kid == GenFormContract.Action
            && mixed.children[0] == GenFormContract.Action);
        Ok("anchor and scalar metadata", GenFormContract.Action.designFloat
            && GenFormContract.Action.designAnchor == 9 && GenFormContract.Action.logX == 3);
        Ok("event argument", GenFormContract.Action.handlerArg == "row.id"
            && GenFormContract.Action.GetHandler("Click") == "Execute");
        Ok("tabs slots", GenFormContract.PageFirst.parent == GenFormContract.Tabs.SlotHost(0)
            && GenFormContract.PageSecond.parent == GenFormContract.Tabs.SlotHost(1)
            && GenFormContract.Tabs.GetProp("activeTab") == "1");
        Ok("split slots", GenFormContract.Left.parent == GenFormContract.Split.SlotHost(0)
            && GenFormContract.Right.parent == GenFormContract.Split.SlotHost(1));
        Ok("input properties and unsupported metadata", GenFormContract.Entry.Class == "large"
            && GenFormContract.Entry.GetProp("required") == ""
            && GenFormContract.Entry.GetProp("placeholder") == "required entry");
        Ok("binding retained", GenFormContract.Left.bindPath == "left.value");
        DataGrid<ContractRow> typedGrid = GenFormContract.Grid;
        Ok("typed generic columns retained", typedGrid.gcols.Count == 2 && typedGrid.source.factory != null);
        Form host = Form.CreateOffscreen("events", 400, 300);
        int calls = 0;
        host.On("Execute", () => { calls = calls + 1; });
        host.On("AnonymousExecute", () => { calls = calls + 10; });
        GenFormContract.__WireForm(host);
        GenFormContract.Action.Click.Raise();
        Ok("event wiring retained", calls == 1);
        Control last = root.children[root.children.Count - 1];
        if (last is Button) {
            Button anonymous = (Button)last;
            anonymous.Click.Raise();
        }
        Ok("anonymous event wiring retained", calls == 11);
        host.GetApp().canvas.Destroy();
        Ok("validation API retained", GenFormContract.__ValidateForm());
        if (fails == 0) { Console.WriteLine("GENFORM_CONTRACT_OK"); }
    }
}
