using System;
using System.IO;
using System.Json;
using System.Web;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;

class ContractRow {
    string caption;
    int count;
}

class ContractDocWin : ChildWindow {
}

class GenFormContractTest {
    static int fails;

    static void Ok(string what, bool value) {
        if (value) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static Control Ctl(Control root, string name) {
        Control c = root.Find(name);
        if (c == null) { throw new Exception("missing " + name); }
        return c;
    }

    static void Main() {
        fails = 0;
        DataTableBootstrap.Install();
        string html = File.ReadAllText("tests/gui/genform_contract.html");
        JsonValue document = JsonValue.ParseLenient(DesignerHtml.ToJsonDoc(html));
        Control root = FormBuilder.Build(document);

        Ok("HTML root and CSS", root is Element && root.Kind() == "body"
            && root.Class == "document" && root.designCss.Contains("body.document"));
        Element mixed = (Element)Ctl(root, "Mixed");
        Ok("htmlTag emits typed Element", mixed.Kind() == "span" && mixed.Class == "natural");
        Ok("mixed text preserved", mixed.elOrder != null && mixed.elOrder.Count == 3
            && mixed.elOrder[0].text == "left " && mixed.elOrder[2].text == " right");
        Control action = Ctl(root, "Action");
        Ok("typed child identity", mixed.elOrder != null
            && mixed.elOrder[1].kid == action
            && mixed.children[0] == action);
        Ok("anchor and scalar metadata", action.designFloat
            && action.designAnchor == 9 && action.logX == 3);
        Ok("event argument", action.handlerArg == "row.id"
            && action.GetHandler("Click") == "Execute");
        Tabs tabs = (Tabs)Ctl(root, "Tabs");
        Ok("tabs slots", Ctl(root, "PageFirst").parent == tabs.SlotHost(0)
            && Ctl(root, "PageSecond").parent == tabs.SlotHost(1)
            && tabs.GetProp("activeTab") == "1");
        SplitPanel split = (SplitPanel)Ctl(root, "Split");
        Ok("split slots", Ctl(root, "Left").parent == split.SlotHost(0)
            && Ctl(root, "Right").parent == split.SlotHost(1));
        Control entry = Ctl(root, "Entry");
        Ok("input properties and unsupported metadata", entry.Class == "large"
            && entry.GetProp("required") == ""
            && entry.GetProp("placeholder") == "required entry");
        Ok("binding retained", Ctl(root, "Left").bindPath == "left.value");
        Control modernModel = Ctl(root, "ModernModel");
        Ok("modern z-model and z-show retained", modernModel.bindPath == "form.username"
            && modernModel.bindIf == "form.isVip"
            && modernModel.GetHandler("Change") == "OnUserChange");
        Control modernBtn = Ctl(root, "ModernBtn");
        Ok("modern z-hide and dblclick retained", modernBtn.bindIf == "!form.loading"
            && modernBtn.GetHandler("DoubleClick") == "OnFastSubmit");
        Control gridCtl = Ctl(root, "Grid");
        DataGrid<ContractRow> typedGrid = (DataGrid<ContractRow>)gridCtl;
        Ok("grid built via runtime factory", typedGrid.Kind() == "DataGrid"
            && typedGrid.gcols.Count == 2 && typedGrid.source.factory != null
            && typedGrid.GetProp("of") == "ContractRow");
        Ok("grid column metadata preserved", typedGrid.gcols[0].desc.field == "caption"
            && typedGrid.gcols[0].desc.title == "Caption"
            && typedGrid.gcols[0].desc.editable
            && typedGrid.gcols[1].desc.field == "count"
            && typedGrid.gcols[1].desc.title == "Count"
            && typedGrid.gcols[1].desc.numeric
            && typedGrid.gcols[1].desc.summary == 1);

        // 事件接线走运行期通道：宿主窗口 Wire() 把 data-on-click 名字
        // 接到同名 Handle 槽（含 data-arg 透传）。
        ContractDocWin w = new ContractDocWin();
        int calls = 0;
        w.Handle("Execute", () => { calls = calls + 1; });
        w.Handle("AnonymousExecute", () => { calls = calls + 10; });
        w.SetRoot(root, JsonValue.Parse("{}"));
        w.Wire();
        ((Button)action).Click.Raise();
        Ok("event wiring retained", calls == 1);
        Control last = root.children[root.children.Count - 1];
        if (last is Button) {
            Button anonymous = (Button)last;
            anonymous.Click.Raise();
        }
        Ok("anonymous event wiring retained", calls == 11);
        if (fails == 0) { Console.WriteLine("GENFORM_CONTRACT_OK"); }
    }
}
