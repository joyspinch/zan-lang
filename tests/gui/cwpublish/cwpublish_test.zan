// publish 形态设计稿事件处理器保留：html 声明的处理器只经 Invoke 按名
// 调用，静态不可见。无注解 public 方法、基类继承方法、无修饰符的基类
// Close 在 --publish 产物里都必须真实执行，不能 HasMethod 真而点击静默
// 失效。子窗-only 工程的设计稿同样要内嵌。
using System;
using Gui;
using Gui.Widget;

class PubBase : ChildWindow {
    public int hits = 0;

    public void BaseHit() { this.hits = this.hits + 1; }
}

class PubCw : PubBase {
    public void OwnHit() { this.hits = this.hits + 10; }

    public Control Tree() { return this.root; }
}

class CaseMain {
    static int Main() {
        Html.Install();
        ControlBootstrap.Install();
        App host = App.CreateDark("cwpublish", 320, 240);
        PubCw w = new PubCw();
        w.EnsureDesign();
        Control r = w.Tree();
        if (r == null) {
            Console.WriteLine("DESIGN_MISS");
            return 1;
        }
        w.OpenHost(host);
        Button bBase = (Button)r.Find("bBase");
        Button bOwn = (Button)r.Find("bOwn");
        Button bClose = (Button)r.Find("bClose");
        bBase.Click.Raise();
        if (w.hits != 1) { Console.WriteLine("BASE_HANDLER_DEAD"); return 1; }
        bOwn.Click.Raise();
        if (w.hits != 11) { Console.WriteLine("OWN_HANDLER_DEAD"); return 1; }
        bClose.Click.Raise();
        if (w.IsOpen()) { Console.WriteLine("CLOSE_HANDLER_DEAD"); return 1; }
        Console.WriteLine("CWPUBLISH_OK");
        return 0;
    }
}
