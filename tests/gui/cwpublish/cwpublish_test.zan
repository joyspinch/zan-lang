// 发布后的子窗通过显式资源别名和类型化处理器装配设计稿。
// 继承的 BaseHit/Close、本类的 OwnHit 及 OnLoad 生命周期钩子都必须执行。
using System;
using System.IO;
using Gui;
using Gui.Widget;

class PubBase : ChildWindow {
    public int hits = 0;

    public void BaseHit() { this.hits = this.hits + 1; }
}

class PubCw : PubBase {
    public void OwnHit() { this.hits = this.hits + 10; }

    public void Register(ModelBinder binder) {
        binder.Handle("BaseHit", this.BaseHit);
        binder.Handle("OwnHit", this.OwnHit);
        binder.Handle("Close", this.Close);
    }

    public void OnLoad(ChildWindow w) { this.hits = this.hits + 100; }

    public Control Tree() { return this.root; }
}

class CaseMain {
    static Control CreateControl(string kind) {
        if (kind == "Button") { return new Button(); }
        return null;
    }

    static int Main() {
        if (File.EmbedExists("src/PubCw.html")) {
            Console.WriteLine("UNDECLARED_DESIGN_EMBEDDED");
            return 1;
        }
        App host = App.CreateDark("cwpublish", 320, 240);
        PubCw w = new PubCw();
        w.OpenHostWith(host, "publish-fixture/child/PubCw.html", CreateControl, w.Register);
        if (w.hits != 100) { Console.WriteLine("ONLOAD_HANDLER_DEAD"); return 1; }
        Control r = w.Tree();
        if (r == null) {
            Console.WriteLine("DESIGN_MISS");
            return 1;
        }
        Button bBase = (Button)r.Find("bBase");
        Button bOwn = (Button)r.Find("bOwn");
        Button bClose = (Button)r.Find("bClose");
        bBase.Click.Raise();
        if (w.hits != 101) { Console.WriteLine("BASE_HANDLER_DEAD"); return 1; }
        bOwn.Click.Raise();
        if (w.hits != 111) { Console.WriteLine("OWN_HANDLER_DEAD"); return 1; }
        bClose.Click.Raise();
        if (w.IsOpen()) { Console.WriteLine("CLOSE_HANDLER_DEAD"); return 1; }
        Console.WriteLine("CWPUBLISH_OK");
        return 0;
    }
}
