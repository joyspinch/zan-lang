// S21（docs/ZAN_STANDARD.md §5）：语义树一次性导出夹具（tests/test_ui_dump.py）。
// 程序在 OnLoad 里启用 UiDriver（模板默认如此），ZAN_UI_DUMP=<文件> 运行：首帧完整呈现后
// 导出语义树并退出。
using System;
using Gui;
using Gui.Widget;

partial class UiDumpProbe : Form {
    string name = "ada";
    // 与模板生成的应用同样在 OnLoad 里选择加入自动化（Testing 是旁路层，核心层不依赖它）
    void OnLoad(Form form) { Gui.Backend.UiDriver.Enable(form.GetApp()); }
    void OnSave() { }
}

public class Program {
    public static void Main() { new UiDumpProbe().Show(); }
}
