using System;
using System.IO;
using Gui;
using Gui.Widget;
using Gui.Component;

class IdePanelOwnerWitness {
    public weak DebugPanel debug;
    public weak DocsSectionTabs docs;
    public weak AiSettingsWindow settings;
    public weak AiSettingsDialog dialog;
}

// Generated control roots retain the panel class but are not Element(body).
// Use the full IDE source list, with this file first and --subsystem console,
// and run from the repository root to load the actual IDE stylesheet.
class IdePanelLayoutTest {
    static App app;
    static string ideCss;
    static int W;

    static void Check(string what, bool ok) {
        if (ok) { return; }
        Console.WriteLine("FAIL " + what);
        throw new Exception("IDE panel layout: " + what);
    }

    static void LoadCss() {
        string path = "src/ide_zan/assets/ide.css";
        Check("ide.css exists at " + path, File.Exists(path));
        ideCss = File.ReadAllText(path);
        Check("ide.css non-empty", ideCss != null && ideCss.Length > 100);
    }

    // 每组尺寸一个离屏帧：先定视口，再装真实 ide.css（面板构造可能
    // 重设应用样式，渲染前重装一次保证被测的就是线上的这份），帧内
    // 完成测量 + 排布 + 绘制（列表行矩形在 OnPaint 里落）。
    static void BeginArea(int h, int scale) {
        app.SetOffscreenViewport(W, h, scale);
        app.UseAppCss(ideCss);
        app.BeginOffscreenFrame();
    }

    static void OutputAt(int h, int scale) {
        OutputPanel p = new OutputPanel();
        List<string> log = new List<string>();
        log.Add("> [Debug] build started");
        log.Add("");
        BeginArea(h, scale);
        p.Prepare(app, log);
        p.UseApp(app); p.MeasureTree(app, W); p.Arrange(0, 0, W, h);
        p.Render(app, new Rect(0, 0, W, h), log);
        string tag = "output h=" + Convert.ToString(h)
        + " dpi=" + Convert.ToString(scale) + " ";
        Check(tag + "generated root uses flex", p.StyleDisplay() == 1);
        Check(tag + "toolbar natural height", p.Bar.bh > 0 && p.Bar.bh < h);
        Check(tag + "toolbar spans body", p.Bar.bx == 0 && p.Bar.bw == W);
        Check(tag + "filter filled", p.Filter.bw > 0 && p.Filter.bh > 0);
        Check(tag + "clear button natural", p.ClearBtn.bw > 0 && p.ClearBtn.bh > 0
        && p.ClearBtn.bh <= p.Bar.bh);
        Check(tag + "toolbar no overlap",
        p.Filter.bx + p.Filter.bw <= p.ClearBtn.bx
        && p.ClearBtn.bx + p.ClearBtn.bw <= p.Bar.bx + p.Bar.bw);
        Check(tag + "rule below toolbar", p.Rule.bh > 0
        && p.Rule.by >= p.Bar.by + p.Bar.bh);
        // 反 bh=0 回归的精确式：控制台高度必须等于剩余空间，差一像素
        // 都说明又回到了非 Flex 通道。
        Check(tag + "console fills exactly the rest",
        p.Log.by >= p.Rule.by + p.Rule.bh && p.Log.bh > 0
        && p.Log.by + p.Log.bh == h
        && p.Log.bh == h - p.Bar.bh - p.Rule.bh);
        int pad = LogView.Padding(app);
        int rowH = LogView.RowHeight(app);
        int textX = p.Log.bx + pad;
        int textY = p.Log.by + pad + rowH;
        Check(tag + "sample within console", textY + rowH <= p.Log.by + p.Log.bh
        && textX + 200 <= p.Log.bx + p.Log.bw);
        List<int> blank = new List<int>();
        for (int y = textY; y < textY + rowH; y = y + 1) {
            for (int x = textX; x < textX + 200; x = x + 1) {
                blank.Add(app.canvas.GetPixel(x, y));
            }
        }
        app.EndOffscreenFrame();
        log[1] = "> Zan IDE ready. Workspace: publish fixture";
        BeginArea(h, scale);
        p.Prepare(app, log);
        p.UseApp(app); p.MeasureTree(app, W); p.Arrange(0, 0, W, h);
        p.Render(app, new Rect(0, 0, W, h), log);
        int ink = 0;
        int sample = 0;
        for (int y = textY; y < textY + rowH; y = y + 1) {
            for (int x = textX; x < textX + 200; x = x + 1) {
                if (app.canvas.GetPixel(x, y) != blank[sample]) { ink = ink + 1; }
                sample = sample + 1;
            }
        }
        Check(tag + "plain output text visible", ink > 20);
        Check(tag + "copy source preserved", p.Shown().Count == log.Count
        && p.Shown()[1] == log[1]);
        app.EndOffscreenFrame();
    }

    static void ErrorsAt(int h, int scale) {
        ErrorsPanel p = new ErrorsPanel();
        List<DiagnosticRecord> recs = new List<DiagnosticRecord>();
        for (int i = 0; i < 11; i = i + 1) {
            string what;
            if (i % 3 == 0) {
                what = "unknown type 'Foo" + Convert.ToString(i) + "'";
            }
            else if (i % 3 == 1) {
                what = "undeclared variable y" + Convert.ToString(i);
            }
            else { what = "missing semicolon before }"; }
            recs.Add(new DiagnosticRecord(
            "src/demo/file" + Convert.ToString(i) + ".zan",
            Convert.ToString(i + 1), what));
        }
        BeginArea(h, scale);
        p.Render(app, new Rect(0, 0, W, h), recs);
        app.EndOffscreenFrame();

        string tag = "errors h=" + Convert.ToString(h)
        + " dpi=" + Convert.ToString(scale) + " ";
        Check(tag + "panel count", p.Count() == 11);
        // 面板体只有列表一处填充：列表必须吃满整个面板。
        Check(tag + "list filled", p.List.bh == h && p.List.by == 0
        && p.List.bw == W);
        ListView<DiagnosticRecord> inner = (ListView<DiagnosticRecord>)p.List.ChildAt(0);
        Check(tag + "inner list filled", inner.bh == h && inner.bw > 0);
        Check(tag + "rows bound", inner.Count() == 11);
        for (int i = 0; i < 11; i = i + 1) {
            Control row = inner.RowControl(i);
            Check(tag + "row " + Convert.ToString(i) + " positive height",
            row != null && row.bh > 0);
            if (i > 0) {
                Control prev = inner.RowControl(i - 1);
                Check(tag + "row " + Convert.ToString(i)
                + " stacks without overlap",
                row.by == prev.by + prev.bh);
            }
        }
        Check(tag + "first row at top", inner.RowControl(0).by == inner.by);
        // 短视口下后面的行允许滚出裁剪，但第一行必须真的看得见。
        Check(tag + "first row visible", inner.RowControl(0).visible);
    }

    static void TreePanelsAt(int h, int scale) {
        ExplorerPanel pe = new ExplorerPanel();
        ExamplesPanel px = new ExamplesPanel();
        StdlibPanel ps = new StdlibPanel();
        StructurePanel pt = new StructurePanel();
        ToolsPanel po = new ToolsPanel();
        BeginArea(h, scale);
        pe.RenderInside(app, new Rect(0, 0, W, h));
        px.RenderInside(app, new Rect(0, 0, W, h));
        ps.RenderInside(app, new Rect(0, 0, W, h));
        pt.RenderInside(app, new Rect(0, 0, W, h));
        po.RenderInside(app, new Rect(0, 0, W, h));
        app.EndOffscreenFrame();

        string tag = "trees h=" + Convert.ToString(h)
        + " dpi=" + Convert.ToString(scale) + " ";
        Check(tag + "explorer filled", pe.Tree.bh == h && pe.Tree.bw == W);
        Check(tag + "examples filled", px.Tree.bh == h && px.Tree.bw == W);
        Check(tag + "stdlib filled", ps.Tree.bh == h && ps.Tree.bw == W);
        Check(tag + "structure filled", pt.Tree.bh == h && pt.Tree.bw == W);
        Check(tag + "tools filled", po.Tree.bh == h && po.Tree.bw == W);
    }

    // 四个 AI 内嵌视图：宿主（AiPanel.Prepare）给的是固定带高，视图
    // 体内各段自然高、填充段吃剩余。一次帧内各排一块互不干扰。
    static void Views() {
        RunStrip run = new RunStrip();
        SendCue cue = new SendCue();
        PlanStrip plan = new PlanStrip();
        TeamBoard team = new TeamBoard();
        BeginArea(300, 100);
        run.RenderInside(app, new Rect(0, 0, 220, 22));
        cue.RenderInside(app, new Rect(0, 40, 260, 26));
        plan.RenderInside(app, new Rect(0, 0, 300, 240));
        team.RenderInside(app, new Rect(0, 0, 240, 120));
        app.EndOffscreenFrame();

        // RunStrip：状态行撑满、细分隔线保持声明高并垫底。
        Check("runstrip line plus rule is strip height (line=" + Convert.ToString(run.Line.bh)
        + " rule=" + Convert.ToString(run.Rule.bh) + ")",
        run.Line.bh + run.Rule.bh == 22 && run.Line.bh > 0);
        Check("runstrip rule below line",
        run.Rule.by == run.Line.by + run.Line.bh);
        Check("runstrip dots natural", run.Dots.bw > 0 && run.Dots.bh > 0);
        Check("runstrip status filled", run.StatusLbl.bw > 0);
        // SendCue：整行吃满宿主带高；说明文字自然宽，下拉宿主保持声明宽。
        Check("sendcue line filled", cue.Line.bh == 26 && cue.Line.bw == 260);
        Check("sendcue label natural", cue.ToLbl.bw > 0 && cue.ToLbl.bh > 0);
        Check("sendcue pick host declared width",
        cue.PickHost.bw == app.Scale(170));
        // PlanStrip：状态条声明高、两行表头自然高、步骤清单吃剩余、
        // 底部细线保持声明高。
        int used = plan.Run.bh + plan.Head.bh + plan.FilesHead.bh
        + plan.Files.bh + plan.Rule.bh;
        Check("planstrip run declared height", plan.Run.bh == app.Scale(22));
        Check("planstrip heads natural",
        plan.Head.bh > 0 && plan.FilesHead.bh > 0);
        Check("planstrip titles filled",
        plan.TitleBtn.bw > 0 && plan.FilesBtn.bw > 0);
        Check("planstrip rows fill the rest",
        plan.Rows.bh == 240 - used && plan.Rows.bh > 0);
        Check("planstrip rule keeps hairline", plan.Rule.bh == app.Scale(4));
        Check("planstrip section order",
        plan.Head.by == plan.Run.by + plan.Run.bh
        && plan.Rows.by == plan.Files.by + plan.Files.bh);
        // TeamBoard：头行自然高、开关与徽标区有宽、默认折叠段隐藏。
        Check("teamboard head natural", team.Head.bh > 0);
        Check("teamboard switch and chips",
        team.ModeSw.bw > 0 && team.Chips.bw > 0);
        Check("teamboard collapsed by default",
        !team.Pipeline.visible && !team.Graph.visible
        && !team.Sizer.visible && !team.Why.visible);
    }

    static void Click(Control target) {
        app.ProcessOffscreenInput(2, target.bx + target.bw / 2, target.by + target.bh / 2, 0, 0, 0, 0);
        app.ProcessOffscreenInput(3, target.bx + target.bw / 2, target.by + target.bh / 2, 0, 0, 0, 0);
        app.DrainPosts();
        while (true) { Action posted = Dispatcher.Take(); if (posted == null) { break; } posted(); }
    }

    static Tabs DebugOwner(IdePanelOwnerWitness witness) {
        DebugPanel panel = new DebugPanel();
        witness.debug = panel;
        Binding<int> selected = 0;
        panel.Prepare(app, selected, new List<string>(), new List<DbgVar>(), new List<DbgVar>(), new List<DbgFrame>());
        panel.TabBar.Select(2);
        Check("debug tab changes model before Paint", selected.Get() == 2);
        panel.SetShown(false); panel.TabBar.Select(1);
        Check("hidden debug owner ignores tab callback", selected.Get() == 2);
        panel.SetShown(true);
        Tabs foreign = new Tabs(Tabs.Line()); foreign.Add("Other", false);
        panel.TabPicked(foreign);
        Check("debug tab fences foreign sender", selected.Get() == 2);
        return panel.TabBar;
    }

    static Tabs DocsOwner(IdePanelOwnerWitness witness) {
        DocsSectionTabs.Sections(new List<string>{ "Basics", "Controls" });
        DocsSectionTabs.Sel().Set(0);
        DocsSectionTabs panel = new DocsSectionTabs(); witness.docs = panel;
        panel.UseApp(app); panel.MeasureTree(app, 180); panel.Arrange(0, 0, 180, 240);
        panel.strip.Select(1);
        Check("docs section changes model before Paint", DocsSectionTabs.Sel().Get() == 1);
        panel.SetShown(false); panel.strip.Select(0);
        Check("hidden docs owner ignores tab callback", DocsSectionTabs.Sel().Get() == 1);
        return panel.strip;
    }

    static Tabs SettingsOwner(IdePanelOwnerWitness witness) {
        AiSettingsWindow window = new AiSettingsWindow(); witness.settings = window;
        window.host = App.CreateOffscreen("settings tab owner", 840, 780);
        window.host.UseAppCss(ideCss); window.open = true; window.lang = "en";
        window.profiles = new List<AiProfile>();
        window.profiles.Add(AiProfile.Create("Test", "", "", "model", "model", "{}"));
        window.presets = new List<AiPreset>();
        window.rolePrompts = "{}"; window.curRoleId = "";
        window.state = new System.Collections.Generic.Dictionary<string, string>();
        window.state["sel"] = "0"; window.state["preset"] = "0";
        window.state["status"] = ""; window.state["ctx"] = ""; window.state["out"] = "";
        window.state["autocont"] = "";
        window.LoadFields(); window.BuildUi();
        witness.dialog = window.content;
        Tabs strip = window.content.TabBar;
        strip.Select(window.ActTab());
        Check("settings current tab changes page before Paint", window.tab == window.ActTab()
        && window.content.ActPage.StyleVisible() && !window.content.ModelsPage.StyleVisible());
        Tabs foreign = new Tabs(Tabs.Line()); foreign.Add("Other", false);
        window.TabPicked(foreign);
        Check("settings tab fences foreign sender", window.tab == window.ActTab());
        window.open = false; strip.Select(0);
        Check("closed settings owner ignores tab callback", window.tab == window.ActTab());
        window.Teardown();
        app.DrainPosts();
        Check("queued settings selection ignores retired host", window.tab == window.ActTab());
        return strip;
    }

    static void TabOwnerLifetimes() {
        IdePanelOwnerWitness witness = new IdePanelOwnerWitness();
        Tabs debug = DebugOwner(witness);
        Check("retained debug Tabs releases owner", witness.debug == null);
        debug.Select(0);
        Tabs docs = DocsOwner(witness);
        Check("retained docs Tabs releases owner", witness.docs == null);
        DocsSectionTabs.Sel().Set(0); docs.Select(1);
        Check("retired docs Tabs cannot update global selection", DocsSectionTabs.Sel().Get() == 0);
        Tabs settings = SettingsOwner(witness);
        Check("retained settings Tabs releases window", witness.settings == null);
        settings.Select(1);
        settings = null;
        Check("settings dialog row delegates release dialog", witness.dialog == null);
        DocsSectionTabs.Sections(null); DocsSectionTabs.Sel().Set(0);
    }

    static void RetainedInputs() {
        CtxRing ring = new CtxRing();
        ring.Sync(30, new List<UsageStat>(), new List<UsageStat>(), "");
        ring.UseApp(app); ring.MeasureTree(app, 80); ring.Arrange(0, 0, 80, 40);
        app.SetRootControl(ring);
        Click(ring.Ring);
        Check("context ring child click pins without Paint", ring.pinned);
        Click(ring.Ring);
        Check("context ring second child click unpins", !ring.pinned);

        RunStrip run = new RunStrip();
        run.Sync(AiRun.Begin("test", "event probe", 0), new List<AiTask>(), "");
        run.UseApp(app); run.MeasureTree(app, 480); run.Arrange(0, 0, 480, 22);
        app.SetRootControl(run);
        Control phase = run.phaseTargets[0];
        Check("phase has full strip click height=" + Convert.ToString(phase.bh), phase.bh >= app.Scale(19));
        Click(phase);
        Check("retained phase click opens evidence before Paint", run.shown == 0 && run.evidencePopup.IsOpen());
        run.evidencePopup.DismissPopup();

        TeamBoard team = new TeamBoard();
        team.Sizer.SetShown(true); team.Graph.SetShown(true);
        team.UseApp(app); team.MeasureTree(app, 480); team.Arrange(0, 0, 480, 240);
        app.SetRootControl(team);
        int x = team.Sizer.bx + team.Sizer.bw / 2;
        int y = team.Sizer.by + team.Sizer.bh / 2;
        app.ProcessOffscreenInput(2, x, y, 0, 0, 0, 0);
        Check("sizer captures actual pointer before Paint", app.GetCapturedPointer() == team.Sizer);
        app.ProcessOffscreenInput(1, x, team.Graph.by + 180, 0, 0, 0, 0);
        Check("captured sizer changes graph height", team.graphLogH == 180);
        app.ProcessOffscreenInput(3, x, team.Graph.by + 180, 0, 0, 0, 0);
        Check("sizer release clears gesture capture", app.GetCapturedPointer() == null && !team.sizing);
        RoutedEventArgs reset = new RoutedEventArgs("Click", team.Sizer, x, y);
        reset.isDoubleClick = true; team.Sizer.RouteEvent(reset);
        Check("retained double click restores graph auto height", team.graphLogH == 0 && reset.handled);

        GalleryDemoHost table = new GalleryDemoHost("DataTable", 180);
        table.UseApp(app); table.MeasureTree(app, 480); table.Arrange(0, 0, 480, 180);
        app.SetRootControl(table);
        Check("gallery table is an arranged persistent child before Paint", table.tableView != null
        && table.tableView.parent == table && table.tableView.bw > 0 && table.tableView.bh > 0);
        Control retained = table.tableView;
        table.MeasureTree(app, 320); table.Arrange(0, 0, 320, 160);
        Check("gallery resize preserves table control", table.tableView == retained && table.tableView.bw == 320);
        app.SetRootControl(null);
        TeamBoard.current = null;
    }

    static void Main() {
        app = App.CreateOffscreen("IDE panel layout", 480, 240);
        W = 480;
        LoadCss();
        if (Environment.ArgCount() > 0 && Environment.ArgAt(0) == "--tab-owners") {
            app.UseAppCss(ideCss); TabOwnerLifetimes();
            app.StopLoop(); app.canvas.Destroy();
            Console.WriteLine("IDE_TAB_OWNERS_OK");
            return;
        }
        if (Environment.ArgCount() > 0 && Environment.ArgAt(0) == "--retained-input") {
            app.SetOffscreenViewport(480, 400, 100);
            app.UseAppCss(ideCss);
            RetainedInputs();
            app.StopLoop(); app.canvas.Destroy();
            Console.WriteLine("IDE_RETAINED_INPUT_OK");
            return;
        }
        // 多高度 × 多 DPI：填充式必须在一整圈尺寸下都成立。
        OutputAt(240, 100);
        ErrorsAt(240, 100);
        TreePanelsAt(240, 100);
        OutputAt(160, 100);
        ErrorsAt(160, 100);
        TreePanelsAt(160, 100);
        OutputAt(420, 100);
        ErrorsAt(420, 100);
        TreePanelsAt(420, 100);
        OutputAt(240, 150);
        ErrorsAt(240, 150);
        TreePanelsAt(240, 150);
        OutputAt(160, 150);
        ErrorsAt(160, 150);
        TreePanelsAt(160, 150);
        Views();
        app.SetOffscreenViewport(480, 400, 100);
        RetainedInputs();
        if (Environment.ArgCount() == 0 || Environment.ArgAt(0) != "--layout-only") { TabOwnerLifetimes(); }
        app.StopLoop(); app.canvas.Destroy();
        Console.WriteLine("IDE_PANEL_LAYOUT_OK");
    }
}
