using System;
using Gui;
using Gui.Widget;
using Gui.Designer;
using Game.Scene;

class DesignerPropsAlignTest {
    static int fails;

    static void Fail(string msg) {
        Console.WriteLine("FAIL: " + msg);
        fails = fails + 1;
    }

    static void AssertTrue(bool condition, string desc) {
        if (!condition) {
            Fail(desc + " condition is false");
        }
    }

    static void AssertEq(string actual, string expected, string desc) {
        if (actual != expected) {
            Fail(desc + " expected '" + expected + "', got '" + actual + "'");
        }
    }

    static void AssertEqInt(int actual, int expected, string desc) {
        if (actual != expected) {
            Fail(desc + " expected " + Convert.ToString(expected) + ", got " + Convert.ToString(actual));
        }
    }

    static void Main() {
        TestExtractPropOptions();
        TestCleanPropLabel();
        TestAlignGroupMultiSelection();
        TestDistributeHorizontal();
        TestDistributeVertical();
        TestImageAndAssetProps();
        TestColorProps();
        TestSelectAll();
        TestSceneDesignerColor();

        if (fails == 0) {
            Console.WriteLine("DESIGNER_PROPS_ALIGN_TEST_OK");
        } else {
            Console.WriteLine("DESIGNER_PROPS_ALIGN_TEST_FAIL (fails=" + Convert.ToString(fails) + ")");
        }
    }

    static void TestExtractPropOptions() {
        List<string> opts = Designer.ExtractPropOptions("Type (primary/info/success/warning/error)");
        AssertTrue(opts.Count == 6, "Type options count is 6 (including empty default)");
        AssertEq(opts[0], "", "First option is empty string for unselected default");
        AssertEq(opts[1], "primary", "Option 1 is primary");
        AssertEq(opts[2], "info", "Option 2 is info");
        AssertEq(opts[3], "success", "Option 3 is success");
        AssertEq(opts[4], "warning", "Option 4 is warning");
        AssertEq(opts[5], "error", "Option 5 is error");

        List<string> boolOpts = Designer.ExtractPropOptions("Checked (true/false)");
        AssertEqInt(boolOpts.Count, 0, "Boolean true/false is not parsed as enum options");

        List<string> noOpts = Designer.ExtractPropOptions("Text");
        AssertEqInt(noOpts.Count, 0, "Plain label has 0 options");
    }

    static void TestCleanPropLabel() {
        string c1 = Designer.CleanPropLabel("Type (primary/info/success)");
        AssertEq(c1, "Type", "CleanPropLabel strips options in parentheses");

        string c2 = Designer.CleanPropLabel("Width (px)");
        AssertEq(c2, "Width (px)", "CleanPropLabel preserves units like (px)");

        string c3 = Designer.CleanPropLabel("Title");
        AssertEq(c3, "Title", "CleanPropLabel preserves plain label");
    }

    static void TestAlignGroupMultiSelection() {
        Designer d = new Designer();
        d.layoutMode = 1; // free mode

        FormField primary = FormField.New(49, 1);
        primary.kind = "Button";
        primary.fx = 100;
        primary.fy = 150;
        primary.fw = 80;
        primary.fh = 32;

        FormField f2 = FormField.New(0, 2);
        f2.kind = "Input";
        f2.fx = 300;
        f2.fy = 400;
        f2.fw = 120;
        f2.fh = 32;

        d.fields.Add(primary);
        d.fields.Add(f2);

        d.sel = primary;
        d.freeExtra.Clear();
        d.freeExtra.Add(f2);

        // Mode 0: Left align relative to primary
        d.AlignSelGroup(0);
        AssertEqInt(f2.fx, 100, "Left align matches primary.fx");

        // Mode 2: Right align relative to primary (primary.fx + primary.fw - f2.fw = 100 + 80 - 120 = 60)
        d.AlignSelGroup(2);
        AssertEqInt(f2.fx, 60, "Right align matches primary right edge");

        // Mode 3: Top align relative to primary
        d.AlignSelGroup(3);
        AssertEqInt(f2.fy, 150, "Top align matches primary.fy");

        // Mode 4: Middle vertical align relative to primary
        d.AlignSelGroup(4);
        AssertEqInt(f2.fy, 150, "Middle vertical align matches primary middle");
    }

    static void TestDistributeHorizontal() {
        Designer d = new Designer();
        d.layoutMode = 1;

        FormField f1 = FormField.New(49, 1);
        f1.fx = 10;
        f1.fw = 40;
        f1.fy = 50;
        f1.fh = 30;

        FormField f2 = FormField.New(49, 2);
        f2.fx = 500; // intermediate item initially far away
        f2.fw = 40;
        f2.fy = 50;
        f2.fh = 30;

        FormField f3 = FormField.New(49, 3);
        f3.fx = 250; // last item at right edge 250+40=290
        f3.fw = 40;
        f3.fy = 50;
        f3.fh = 30;

        d.fields.Add(f1);
        d.fields.Add(f2);
        d.fields.Add(f3);

        d.sel = f1;
        d.freeExtra.Clear();
        d.freeExtra.Add(f2);
        d.freeExtra.Add(f3);

        // Span from minX (10) to maxX (f2 right edge = 540)
        // items sorted: f1 (10..50), f3 (250..290), f2 (500..540)
        // totalSpan = 540 - 10 = 530
        // totalW = 40 + 40 + 40 = 120
        // totalGap = 530 - 120 = 410
        // gap = 410 / 2 = 205
        // expected intermediate item f3.fx = 10 + 40 + 205 = 255
        d.DistributeSelGroup(0);

        AssertEqInt(f1.fx, 10, "Anchor item 1 fx unchanged");
        AssertEqInt(f3.fx, 255, "Intermediate item f3 evenly distributed");
        AssertEqInt(f2.fx, 500, "Anchor item 2 fx unchanged");

        int gap1 = f3.fx - (f1.fx + f1.fw);
        int gap2 = f2.fx - (f3.fx + f3.fw);
        AssertEqInt(gap1, gap2, "Adjacent horizontal gaps are equal");
    }

    static void TestDistributeVertical() {
        Designer d = new Designer();
        d.layoutMode = 1;

        FormField f1 = FormField.New(49, 1);
        f1.fx = 50;
        f1.fw = 40;
        f1.fy = 100;
        f1.fh = 30;

        FormField f2 = FormField.New(49, 2);
        f2.fx = 50;
        f2.fw = 40;
        f2.fy = 200;
        f2.fh = 30;

        FormField f3 = FormField.New(49, 3);
        f3.fx = 50;
        f3.fw = 40;
        f3.fy = 400;
        f3.fh = 30;

        d.fields.Add(f1);
        d.fields.Add(f2);
        d.fields.Add(f3);

        d.sel = f1;
        d.freeExtra.Clear();
        d.freeExtra.Add(f2);
        d.freeExtra.Add(f3);

        // Sorted: f1 (100..130), f2 (200..230), f3 (400..430)
        // totalSpan = 430 - 100 = 330
        // totalH = 90
        // totalGap = 330 - 90 = 240
        // gap = 240 / 2 = 120
        // expected f2.fy = 100 + 30 + 120 = 250
        d.DistributeSelGroup(1);

        AssertEqInt(f1.fy, 100, "Anchor item 1 fy unchanged");
        AssertEqInt(f2.fy, 250, "Intermediate item f2 evenly distributed vertically");
        AssertEqInt(f3.fy, 400, "Anchor item 3 fy unchanged");

        int gap1 = f2.fy - (f1.fy + f1.fh);
        int gap2 = f3.fy - (f2.fy + f2.fh);
        AssertEqInt(gap1, gap2, "Adjacent vertical gaps are equal");
    }

    static void TestImageAndAssetProps() {
        // 1. Image.SetProp 动态设值测试
        Image img = new Image();
        img.SetProp("src", "assets/player.png");
        img.SetProp("fit", "cover");
        img.SetProp("alt", "Avatar Image");

        AssertEq(img.Fit, "cover", "Image Fit prop set correctly");
        AssertEq(img.Alt, "Avatar Image", "Image Alt prop set correctly");
        AssertEq(img.Src.Get(), "assets/player.png", "Image Src binding set correctly");

        // 2. IsAssetProp 判定测试
        AssertTrue(Designer.IsAssetProp("src"), "src is asset prop");
        AssertTrue(Designer.IsAssetProp("image"), "image is asset prop");
        AssertTrue(Designer.IsAssetProp("avatar"), "avatar is asset prop");
        AssertTrue(Designer.IsAssetProp("filePath"), "filePath is asset prop");
        AssertTrue(Designer.IsAssetProp("bgImagePath"), "bgImagePath is asset prop");
        AssertTrue(!Designer.IsAssetProp("icon"), "icon is not asset prop (is icon)");
        AssertTrue(!Designer.IsAssetProp("size"), "size is not asset prop");

        // 3. RelativizePath 路径测试
        AssertEq(Designer.RelativizePath(""), "", "empty path relativizes to empty");
        AssertEq(Designer.RelativizePath(null), "", "null path relativizes to empty");
    }

    static void TestColorProps() {
        AssertTrue(Designer.IsColorProp("color"), "color is color prop");
        AssertTrue(Designer.IsColorProp("textColor"), "textColor is color prop");
        AssertTrue(Designer.IsColorProp("bgColor"), "bgColor is color prop");
        AssertTrue(Designer.IsColorProp("backgroundColor"), "backgroundColor is color prop");
        AssertTrue(Designer.IsColorProp("borderColor"), "borderColor is color prop");
        AssertTrue(Designer.IsColorProp("fill"), "fill is color prop");
        AssertTrue(Designer.IsColorProp("stroke"), "stroke is color prop");
        AssertTrue(Designer.IsColorProp("tint"), "tint is color prop");
        AssertTrue(Designer.IsColorProp("accent"), "accent is color prop");
        AssertTrue(!Designer.IsColorProp("icon"), "icon is not color prop");
        AssertTrue(!Designer.IsColorProp("size"), "size is not color prop");

        // 颜色取值文本 ↔ 颜色：取色器写回的是 CSS 形态。
        AssertTrue(Designer.ParseColorValue("#1890ff").IsNone() == false,
            "hex value is a literal color");
        AssertTrue(Designer.ParseColorValue("var(--primary)").IsNone(),
            "token value is not a literal color");
        AssertEq(Designer.ColorValueText(0 - 65536), "#ff0000",
            "Packed red renders as #ff0000");
        AssertEq(Designer.ColorValueText(0 - 2130771968), "#80ff0000",
            "Packed half-transparent red renders as #80ff0000");
    }

    static void TestSelectAll() {
        Designer d = new Designer();
        FormField f1 = FormField.New(0, 1);
        FormField f2 = FormField.New(0, 2);
        FormField f3 = FormField.New(0, 3);
        d.fields.Add(f1);
        d.fields.Add(f2);
        d.fields.Add(f3);

        d.SelectAll();
        AssertTrue(d.sel == f1, "sel is set to f1");
        AssertEqInt(d.freeExtra.Count, 2, "freeExtra contains 2 extra items");
        AssertTrue(d.freeExtra[0] == f2, "freeExtra[0] is f2");
        AssertTrue(d.freeExtra[1] == f3, "freeExtra[1] is f3");
    }

    static void TestSceneDesignerColor() {
        AssertEq(SceneDesigner.HexByte(255), "ff", "255 to hex is ff");
        AssertEq(SceneDesigner.HexByte(0), "00", "0 to hex is 00");
        AssertEq(SceneDesigner.HexByte(16), "10", "16 to hex is 10");
        AssertEq(SceneDesigner.HexByte(254), "fe", "254 to hex is fe");

        AssertEq(SceneDesigner.RgbaToHex(255, 255, 255), "#ffffff", "White RGB to hex");
        AssertEq(SceneDesigner.RgbaToHex(0, 0, 0), "#000000", "Black RGB to hex");
        AssertEq(SceneDesigner.RgbaToHex(24, 144, 255), "#1890ff", "Primary blue RGB to hex");

        AssertEq(SceneDesigner.NextPresetHex("#1890ff"), "#52c41a", "Scene preset cycle from blue to green");
        AssertEq(SceneDesigner.NextPresetHex(""), "#1890ff", "Empty preset defaults to blue");

        SceneElement elem = new SceneElement("button", "btnTest");
        elem.Tint(100, 150, 200, 128);
        AssertEqInt(elem.R(), 100, "SceneElement R matches tint");
        AssertEqInt(elem.G(), 150, "SceneElement G matches tint");
        AssertEqInt(elem.B(), 200, "SceneElement B matches tint");
        AssertEqInt(elem.A(), 128, "SceneElement A matches tint");
    }
}
