using System;
using Gui;
using Gui.Component.Chart;

/// 堆叠面积带边界的亚像素抗锯齿回归（真实 App 离屏渲染）。
///
/// 用户报告：Line4（堆积面积图）条带边缘全是毛刺——根因是
/// DrawStackedArea 的带边界 topY/botY 用整数 YOf 计算并被量化到
/// 整像素行，FillBandFx 的亚像素光栅化器拿不到 1/256 精度，
/// 缓坡上每列硬跳一整行，放大看是阶梯锯齿。
///
/// 修复后边界以 16.8 定点（Chart.YOfFx）进入 BuildPathFxEx/
/// FillBandFx，本用例统计画面里"两种纯彩带颜色直接硬相接、
/// 中间没有任何混合行"的位置数：量化阶梯会产生大量硬相接，
/// 亚像素 AA 会在每条边界铺出渐变混合行。断言用定性阈值，
/// 对两条栅格化路径（GDI / FreeType）与不同 DPI 缩放成立：
/// 全部彩带互异且占满画面，硬相接上限取保守值。
class ChartStackedAreaAaTest {
    static App app;
    static int fails;

    static void True(string what, bool got) {
        if (got) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    // 与 Line4 一致的五段堆积面积图（ECharts 参考站同数据）。
    static void Body() {
        app.BeginFrame();
        WidgetId.ResetFrame();
        ChartOption o = ChartOption.Of("",
            new List<string>{ "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" },
            new List<ChartSeries>{
                ChartSeries.StackedArea("Mail", new List<int>{ 120, 132, 101, 134, 90, 230, 210 }),
                ChartSeries.StackedArea("Affiliate", new List<int>{ 220, 182, 191, 234, 290, 330, 310 }),
                ChartSeries.StackedArea("Video", new List<int>{ 150, 232, 201, 154, 190, 330, 410 }),
                ChartSeries.StackedArea("Direct", new List<int>{ 320, 332, 301, 334, 390, 330, 320 }),
                ChartSeries.StackedArea("Search", new List<int>{ 820, 932, 901, 934, 1290, 1330, 1320 })
            });
        o.xAxes[0].boundaryGap = false;
        ChartView.KeyedStatic(o, 9101).Render(app, 10, 10, 1100, 280);
        app.RunOverlays();
    }

    // 灰色（背景/网格/文字/描边黑）——只统计彩色墨迹。
    static bool Gray(int p) {
        int r = (p >> 16) & 255; int g = (p >> 8) & 255; int b = p & 255;
        int mx = r > g ? r : g; if (b > mx) { mx = b; }
        int mn = r < g ? r : g; if (b < mn) { mn = b; }
        return mx - mn < 24;
    }

    /// 已定色判定：p 与任一"已定色"（描边原色 / 带填充合成色）的
    /// 三通道差都 ≤6。混合行（AA 覆盖率渐变、描边透填充合成）
    /// 必然落在已定色之外——它们是边界存在亚像素过渡的证据。
    static bool Settled(int p, int[] settled) {
        int pr = (p >> 16) & 255; int pg = (p >> 8) & 255; int pb = p & 255;
        for (int si = 0; si < settled.Length; si = si + 1) {
            int dr = pr - ((settled[si] >> 16) & 255); if (dr < 0) { dr = 0 - dr; }
            if (dr > 6) { continue; }
            int dg = pg - ((settled[si] >> 8) & 255); if (dg < 0) { dg = 0 - dg; }
            if (dg > 6) { continue; }
            int db = pb - (settled[si] & 255); if (db < 0) { db = 0 - db; }
            if (db <= 6) { return true; }
        }
        return false;
    }

    static void Main() {
        fails = 0;
        app = new App("chart-stackedarea-aa", 1120, 300);
        app.Show();
        for (int i = 0; i < 3; i = i + 1) {
            ChartStackedAreaAaTest.Body();
            // 直呼 Body 渲染后泵处于完全静止（无挂起重绘/事件/动画
            // 截止），ProcessEvent 会走阻塞 GetMessageW 等下一条 OS
            // 事件——环境消息流一安静就永挂。请求重绘让泵走非阻塞
            // 轮询路径（datatable 系测试同款定式）。
            app.RequestRedraw();
            app.PumpGuarded();
        }
        Canvas c = app.canvas;

        // 硬相接 = 相邻两像素都是纯彩（非灰、非混合）且颜色差大。
        // 混合像素的判定：与上下彩带任一端相比，通道值落在两端
        // 之间（通道级混合）——混合行的中点像素通道值必然介于
        // 两带纯色之间，不满足"两侧都是纯彩"。
        //
        // 计数按"去重色对"：带顶的 2px 不透明折线描边（ECharts 每
        // 条堆叠面积顶边都有描边，描边修复后真实可见）与相邻带填
        // 充的交接是合法硬相接，同一条边界逐列重复上千次——去重后
        // 一条边界只贡献 1 个色对。量化阶梯（本用例的回归对象）在
        // 缓坡上逐列产生大量不同色对，去重不掉。
        //
        // 已定色集合（ECharts 6.1 语义，全部从引擎调色板推导，不写
        // 死色值——v6 九档换掉 ECharts2 #6495ED 系后写死色值曾让旧
        // 豁免全空转）：
        //   描边 = 调色板原色（每条堆叠带顶边 2px 不透明折线）；
        //   带填充 = 系列色 @ opacity 0.7（LineView.ts 面积多边形
        //   缺省）铺白底：c×179/255 + 255×76/255。
        // 逐像素取证（x150-180/y136-150）确认的真实层序：带填充各
        // 自只铺白底（band2 填充实测 = 84869c = 505372@179 直接铺
        // 白，不叠在带1填充上）；每条描边的上半截会被上一条带的半
        // 透明填充盖住（描边透填充"暗行"）——ECharts canvas 同层
        // 按系列序绘制同样过绘，是忠实行为不是引擎缺陷。
        int[] strokes = new int[] {
            Chart.Palette(app.theme, 0), Chart.Palette(app.theme, 1),
            Chart.Palette(app.theme, 2), Chart.Palette(app.theme, 3),
            Chart.Palette(app.theme, 4)
        };
        int[] settled = new int[strokes.Length * 2];
        for (int si = 0; si < strokes.Length; si = si + 1) {
            settled[si] = strokes[si];
            int sr = (strokes[si] >> 16) & 255; int sg = (strokes[si] >> 8) & 255;
            int sb = strokes[si] & 255;
            int fr = (sr * 179 + 255 * 76) / 255;
            int fg = (sg * 179 + 255 * 76) / 255;
            int fb = (sb * 179 + 255 * 76) / 255;
            settled[strokes.Length + si] = (fr << 16) | (fg << 8) | fb;
        }
        List<long> pairs = new List<long>();
        int colorBands = 0;
        for (int x = 60; x < 1060; x = x + 1) {
            for (int y = 25; y < 270; y = y + 1) {
                int c0 = c.GetPixel(x, y) & 0x00FFFFFF;
                int c1 = c.GetPixel(x, y + 1) & 0x00FFFFFF;
                if (Settled(c0, settled)) { colorBands = colorBands + 1; }
                if (c0 == c1 || Gray(c0) || Gray(c1)) { continue; }
                int r0 = (c0 >> 16) & 255; int g0 = (c0 >> 8) & 255;
                int r1 = (c1 >> 16) & 255; int g1 = (c1 >> 8) & 255;
                int dr = r0 - r1; if (dr < 0) { dr = 0 - dr; }
                int dg = g0 - g1; if (dg < 0) { dg = 0 - dg; }
                // 纯彩带间色差大（ECharts 调色板相邻带通道差 ≥64）；
                // 带内阴影/网格的微弱色差不算。
                if (dr < 64 || dg < 64) { continue; }
                // 硬边 = 两个已定色直接相邻。任一端是混合行（描边
                // AA 渐变行、带填充边缘、描边透填充合成）即存在亚
                // 像素过渡，豁免——旧"描边×a+白底"逐背景拟合模型
                // 覆盖不了 描边×a+带填充 合成行，对 v6 深填充色误
                // 报 138 对；本判定只认"无过渡的证据"，普适。
                if (!Settled(c0, settled) || !Settled(c1, settled)) { continue; }
                colorBands = colorBands + 1;
                long lo = c0 < c1 ? c0 : c1;
                long hi = c0 < c1 ? c1 : c0;
                long key = lo * 16777216 + hi;
                bool seenPair = false;
                for (int pi = 0; pi < pairs.Count; pi = pi + 1) {
                    if (pairs[pi] == key) { seenPair = true; break; }
                }
                if (!seenPair) { pairs.Add(key); }
            }
        }
        int hardEdges = pairs.Count;
        // 修复前：整数边界量化 → 全画布上千处已定色直接硬相接
        // （实测 1065 对）。修复后：每条边界都有亚像素混合行，
        // 剩余对子只是描边/填充边界恰好落在整行的少数列。
        True("stacked band edges are anti-aliased", hardEdges <= 32);
        True("chart painted colored bands", colorBands > 0);
        Console.WriteLine("stackedarea-aa:" + Convert.ToString(fails == 0 ? 1 : 0));
    }
}
