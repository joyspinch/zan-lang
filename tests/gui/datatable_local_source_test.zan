using System;
using Gui;
using Gui.Widget;

namespace DataTableLocalSourceTest;

class IndexKeyProvider : RowKeyProvider {
    override RowKey Key(DataSource src, int row) {
        return RowKey.Of("local:" + Convert.ToString(row));
    }
}

class Program {
    static DataRow Row(string value) {
        DataRow row = new DataRow();
        row.Push(value);
        return row;
    }

    static DataRow Pair(string name, string score) {
        DataRow row = new DataRow();
        row.Push(name);
        row.Push(score);
        return row;
    }

    static DataRow Triple(string name, string score, string enabled) {
        DataRow row = Program.Pair(name, score);
        row.Push(enabled);
        return row;
    }

    static void Main() {
        List<DataRow> input = new List<DataRow>();
        input.Add(Program.Row("v0"));
        input.Add(Program.Row("v1"));
        input.Add(Program.Row("v2"));
        input.Add(Program.Row("v3"));
        input.Add(Program.Row("v4"));
        LocalDataSource source = new LocalDataSource(input);
        input[2].Set(0, "outside");
        source.SetPageSize(2);
        source.SetKeyProvider(new IndexKeyProvider());

        DataTableState st = new DataTableState();
        QueryDescriptor query = QueryDescriptor.Of(st, "local", QueryCapabilities.Page);
        QueryViewport page2 = new QueryViewport(2, 2, "");
        QueryRequestToken token2 = source.RequestQuery(query, page2, null);
        Console.WriteLine("poll2=" + source.Poll());
        Console.WriteLine("text2=" + source.CellText(2, 0));
        Console.WriteLine("text3=" + source.CellText(3, 0));
        RowKey key2 = source.GetRowKey(2);
        Console.WriteLine("key2=" + (key2 == null ? "" : key2.Canonical()));
        Console.WriteLine("rowCount=" + Convert.ToString(source.RowCount()));
        Console.WriteLine("ready4=" + source.CellReady(4, 0));
        Console.WriteLine("cacheBytes=" + (source.CacheBytes() > 0));

        QueryViewport page0 = new QueryViewport(0, 2, "");
        source.RequestQuery(query, page0, null);
        Console.WriteLine("poll0=" + source.Poll());
        Console.WriteLine("text0=" + source.CellText(0, 0));
        Console.WriteLine("text2FromCache=" + source.CellText(2, 0));

        source.SetCell(2, 0, "changed");
        source.RequestQuery(query, page2, null);
        Console.WriteLine("pollChanged=" + source.Poll());
        Console.WriteLine("textChanged=" + source.CellText(2, 0));
        source.ClearCache();
        Console.WriteLine("cacheCleared=" + (source.CacheBytes() == 0));

        List<DataRow> rankedRows = new List<DataRow>();
        rankedRows.Add(Program.Pair("alpha", "30"));
        rankedRows.Add(Program.Pair("beta", "10"));
        rankedRows.Add(Program.Pair("alphabet", "20"));
        LocalDataSource ranked = new LocalDataSource(rankedRows);
        QueryDescriptor shaped = QueryDescriptor.Of(st, "ranked", QueryCapabilities.Filter + QueryCapabilities.Sort);
        shaped.AddFilter(new QueryFilterClause(0, QueryFilterMode.Contains, "alp", "", 0));
        shaped.AddSort(new QuerySortClause(1, 2, 1));
        QueryViewport shapedPage = new QueryViewport(0, 10, "");
        ranked.RequestQuery(shaped, shapedPage, null);
        Console.WriteLine("shapedPoll=" + ranked.Poll());
        Console.WriteLine("shapedCount=" + Convert.ToString(ranked.RowCount()));
        Console.WriteLine("shapedFirst=" + ranked.CellText(0, 0));
        Console.WriteLine("shapedSecond=" + ranked.CellText(1, 0));
        QueryDescriptor roundTrip = QueryDescriptor.FromJson(shaped.ToJson());
        Console.WriteLine("roundTrip=" + (roundTrip != null && shaped.SameQuery(roundTrip)));

        QueryPlan validPlan = shaped.BuildPlan(2, ranked.Capabilities());
        Console.WriteLine("planValid=" + validPlan.IsValid());
        Console.WriteLine("planFilters=" + Convert.ToString(validPlan.FilterCount()));
        shaped.ClearFilters();
        shaped.ClearSorts();
        Console.WriteLine("planSnapshot=" + Convert.ToString(validPlan.FilterCount())
            + ":" + Convert.ToString(validPlan.SortCount()));
        QueryDescriptor badColumn = QueryDescriptor.Of(st, "ranked", QueryCapabilities.Filter);
        badColumn.AddFilter(new QueryFilterClause(2, QueryFilterMode.Equals, "x", "", 0));
        QueryPlan badColumnPlan = badColumn.BuildPlan(2, ranked.Capabilities());
        Console.WriteLine("badColumn=" + badColumnPlan.Issue().Code());
        QueryDescriptor badOp = QueryDescriptor.Of(st, "ranked", QueryCapabilities.Filter);
        badOp.AddFilter(new QueryFilterClause(0, 99, "x", "", 0));
        QueryPlan badOpPlan = badOp.BuildPlan(2, ranked.Capabilities());
        Console.WriteLine("badOp=" + badOpPlan.Issue().Code());
        QueryDescriptor badKind = QueryDescriptor.Of(st, "ranked", QueryCapabilities.Filter);
        badKind.AddFilter(new QueryFilterClause(0, QueryFilterMode.Equals, "x", "", 9));
        QueryPlan badKindPlan = badKind.BuildPlan(2, ranked.Capabilities());
        Console.WriteLine("badKind=" + badKindPlan.Issue().Code());
        QueryDescriptor badSort = QueryDescriptor.Of(st, "ranked", QueryCapabilities.Sort);
        badSort.AddSort(new QuerySortClause(1, 7, 1));
        QueryPlan badSortPlan = badSort.BuildPlan(2, ranked.Capabilities());
        Console.WriteLine("badDirection=" + badSortPlan.Issue().Code());
        QueryDescriptor noFilterCapability = QueryDescriptor.Of(st, "ranked", QueryCapabilities.Sort);
        noFilterCapability.AddFilter(new QueryFilterClause(0, QueryFilterMode.Equals, "alpha", "", 0));
        QueryPlan unsupported = noFilterCapability.BuildPlan(2,
            QueryCapabilities.Of(QueryCapabilities.Sort));
        Console.WriteLine("unsupportedFilter=" + unsupported.Issue().Code());
        LocalDataSource invalidSource = new LocalDataSource(rankedRows);
        invalidSource.RequestQuery(badColumn, new QueryViewport(0, 5, ""), null);
        Console.WriteLine("invalidPoll=" + invalidSource.Poll());
        Console.WriteLine("invalidError=" + (invalidSource.ErrorResult() != null
            && invalidSource.ErrorResult().Error() == "query filter column is outside schema"));

        List<DataRow> typedRows = new List<DataRow>();
        typedRows.Add(Program.Triple("a", "10", "false"));
        typedRows.Add(Program.Triple("b", "20", "true"));
        typedRows.Add(Program.Triple("c", "30", "true"));
        LocalDataSource typed = new LocalDataSource(typedRows);
        QueryDescriptor numeric = QueryDescriptor.Of(st, "typed", QueryCapabilities.Filter + QueryCapabilities.Sort);
        numeric.AddFilter(new QueryFilterClause(1, QueryFilterMode.GreaterOrEqual, "20", "", 1));
        numeric.AddSort(new QuerySortClause(1, 1, 1));
        typed.RequestQuery(numeric, new QueryViewport(0, 10, ""), null);
        Console.WriteLine("numericPoll=" + typed.Poll());
        Console.WriteLine("numericCount=" + typed.RowCount());
        Console.WriteLine("numericFirst=" + typed.CellText(0, 0));
        QueryDescriptor boolQuery = QueryDescriptor.Of(st, "typed", QueryCapabilities.Filter);
        boolQuery.AddFilter(new QueryFilterClause(2, QueryFilterMode.Equals, "true", "", 3));
        typed.RequestQuery(boolQuery, new QueryViewport(0, 10, ""), null);
        Console.WriteLine("boolPoll=" + typed.Poll());
        Console.WriteLine("boolCount=" + typed.RowCount());
        Console.WriteLine("boolFirst=" + typed.CellText(0, 0));
        QueryDescriptor emptyQuery = QueryDescriptor.Of(st, "typed", QueryCapabilities.Filter);
        emptyQuery.AddFilter(new QueryFilterClause(0, QueryFilterMode.Equals, "missing", "", 0));
        typed.RequestQuery(emptyQuery, new QueryViewport(0, 10, ""), null);
        Console.WriteLine("emptyPoll=" + typed.Poll());
        Console.WriteLine("emptyCount=" + typed.RowCount());

        List<SchemaColumn> schema = new List<SchemaColumn>();
        schema.Add(new SchemaColumn("name", "name", 1));
        schema.Add(new SchemaColumn("score", "score", 2));
        schema.Add(new SchemaColumn("enabled", "enabled", 4));
        QueryPlan schemaValid = numeric.BuildPlan(schema, typed.Capabilities());
        Console.WriteLine("schemaValid=" + schemaValid.IsValid());
        QueryDescriptor schemaBad = QueryDescriptor.Of(st, "typed", QueryCapabilities.Filter);
        schemaBad.AddFilter(new QueryFilterClause(1, QueryFilterMode.Equals, "20", "", 0));
        QueryPlan schemaBadPlan = schemaBad.BuildPlan(schema, typed.Capabilities());
        Console.WriteLine("schemaMismatch=" + schemaBadPlan.Issue().Code());

        QueryDescriptor shapedQuery = QueryDescriptor.Of(st, "typed",
            QueryCapabilities.Filter + QueryCapabilities.Group
            + QueryCapabilities.Aggregate);
        shapedQuery.AddGroup(new QueryGroupClause(2, 3));
        shapedQuery.AddAggregate(new QueryAggregateClause(1, 1, 1));
        QueryPlan shapedPlan = shapedQuery.BuildPlan(schema,
            QueryCapabilities.Of(QueryCapabilities.Filter + QueryCapabilities.Group
                + QueryCapabilities.Aggregate));
        Console.WriteLine("shapePlan=" + shapedPlan.IsValid());
        Console.WriteLine("shapeCounts=" + Convert.ToString(shapedPlan.GroupCount())
            + ":" + Convert.ToString(shapedPlan.AggregateCount()));
        QueryDescriptor shapeRoundTrip = QueryDescriptor.FromJson(shapedQuery.ToJson());
        Console.WriteLine("shapeRoundTrip=" + (shapeRoundTrip != null
            && shapedQuery.SameQuery(shapeRoundTrip)));
        typed.RequestQuery(shapedQuery, new QueryViewport(0, 10, ""), null);
        Console.WriteLine("shapePoll=" + typed.Poll());
        QueryResult shapeResult = typed.CurrentResult();
        Console.WriteLine("shapeResult=" + (shapeResult != null
            && shapeResult.Groups().Count == 2
            && shapeResult.Aggregates().Count == 1));
        if (shapeResult != null && shapeResult.Groups().Count > 0
            && shapeResult.Aggregates().Count > 0) {
            Console.WriteLine("shapeBucket=" + shapeResult.Groups()[0].Count());
            Console.WriteLine("shapeAggregate=" + shapeResult.Aggregates()[0].Number());
        }
        QueryDescriptor unsupportedGroup = QueryDescriptor.Of(st, "typed",
            QueryCapabilities.Filter);
        unsupportedGroup.AddGroup(new QueryGroupClause(0, 0));
        QueryPlan unsupportedGroupPlan = unsupportedGroup.BuildPlan(3,
            QueryCapabilities.Of(QueryCapabilities.Filter));
        Console.WriteLine("unsupportedGroup=" + unsupportedGroupPlan.Issue().Code());
    }
}
