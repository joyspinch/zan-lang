using System;
using Gui;
using Gui.Widget;

/// 无窗口回归：Carousel 的方向轴、控件页排布与覆盖层挂载次序。
///
/// ShowSlides 的排布是纯几何：横向沿 x 滑、纵向沿 y 滑，离开页停在
/// by/bx - dir*shift；chrome 要等首次 Arrange 才惰性挂为末位子控件
/// （RenderTree 先画父 OnPaint 再画子树，chrome 必须排在控件页之后
/// 才不会被图片页盖住）。这些都不需要窗口，直接喂矩形断言，对着
/// golden 比。
class Program {
    static void Line(string s) { Console.WriteLine(s); }

    /// 带固定测量尺寸的页（替代 Image，避免牵进解码器）。
    static Control Leaf(int w, int h) {
        Label l = new Label("p");
        l.Prefer(w, h);
        return l;
    }

    static void Main() {
        // ---- 横向（默认）：过渡沿 x --------------------------------
        Line("=== horizontal ===");
        Carousel h = new Carousel();
        Control ha = Program.Leaf(400, 300);
        Control hb = Program.Leaf(400, 300);
        h.AddSlideView(ha);
        h.AddSlideView(hb);
        h.Arrange(10, 20, 400, 300);
        Line($"frame {h.bx},{h.by} {h.bw}x{h.bh}");
        Line($"views {h.slideViews.Count} slides {h.slides.Count}");
        // 静止帧：当前页摆在框位，其余页隐藏。
        h.ShowSlides(0, 0, 0, 1);
        Line($"stay a {ha.bx},{ha.by} vis {ha.visible} b vis {hb.visible}");
        // 过渡帧：离开页向左挪 shift，进入页在框位。
        h.ShowSlides(0, 1, 150, 1);
        Line($"move a {ha.bx},{ha.by} b {hb.bx},{hb.by}");

        // ---- 纵向：同一调用，位移换到 y ------------------------------
        Line("=== vertical ===");
        Carousel v = new Carousel();
        Control va = Program.Leaf(400, 300);
        Control vb = Program.Leaf(400, 300);
        v.AddSlideView(va);
        v.AddSlideView(vb);
        v.Direction("vertical");
        Line($"vert {v.Vert()} dir {v.direction}");
        v.Arrange(0, 0, 400, 300);
        v.ShowSlides(0, 1, 120, 1);
        Line($"move a {va.bx},{va.by} b {vb.bx},{vb.by}");
        // 反向（上一页）：离开页向下挪。
        v.ShowSlides(0, 1, 120, 0 - 1);
        Line($"back a {va.bx},{va.by} b {vb.bx},{vb.by}");

        // ---- chrome 惰性挂载：首次 Arrange 之后，恒为末位子控件 -----
        Line("=== chrome order ===");
        Carousel c = new Carousel();
        c.AddSlide("text only");
        Line($"before children {c.children.Count} chrome {(c.chrome == null ? "null" : "set")}");
        c.Arrange(0, 0, 200, 100);
        Line($"after children {c.children.Count} last-is-chrome {(c.children[c.children.Count - 1] == c.chrome ? "yes" : "no")}");
        c.AddSlideView(Program.Leaf(200, 100));
        c.Arrange(0, 0, 200, 100);
        Line($"withview children {c.children.Count} last-is-chrome {(c.children[c.children.Count - 1] == c.chrome ? "yes" : "no")}");
        // 再排一次不重复挂载。
        c.Arrange(0, 0, 200, 100);
        Line($"again children {c.children.Count}");
    }
}
