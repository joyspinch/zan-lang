using System;
using Gui;

class WindowRoundRestoreTest {
    static void Assert(bool cond, string msg) {
        if (!cond) {
            Console.WriteLine("FAIL: " + msg);
            throw new Exception("Assertion failed: " + msg);
        }
    }

    static void Main() {
        App app = App.CreateOffscreen("WindowRoundRestoreTest", 800, 600);

        // 1. 普通窗口 DWM 圆角偏好设置
        app.SetWindowRoundCorners(true);
        Assert(app.windowRound, "windowRound should be true");

        // 2. 异形/圆角规格与阴影配置
        string originalSpec = "1,0,0,800,600,16";
        app.SetWindowShape(originalSpec);
        app.SetWindowShadow(12);

        Assert(app.shapeMode == 1, "shapeMode should be 1");
        Assert(app.shapeRadius == 16, "shapeRadius should be 16");
        Assert(app.shapeShadow == 12, "shapeShadow should be 12");
        Assert(app.shapeOffX == 12, "shapeOffX should be 12");
        Assert(app.shapeOffY == 12, "shapeOffY should be 12");

        // 3. 模拟最大化触发：规格清除与暂存
        app.maxSavedShapeSpec = app.shapeSpec;
        app.maxSavedShapeShadow = app.shapeShadow;
        app.shapeShadow = 0;
        app.SetWindowShape("");

        Assert(app.shapeMode == 0, "shapeMode should be 0 when maximized");
        Assert(app.shapeRadius == 0, "shapeRadius should be 0 when maximized");
        Assert(app.shapeShadow == 0, "shapeShadow should be 0 when maximized");
        Assert(app.shapeOffX == 0, "shapeOffX should be 0 when maximized");
        Assert(app.shapeOffY == 0, "shapeOffY should be 0 when maximized");

        // 4. 模拟退出最大化：还原原本的异形、圆角与阴影规格
        string restoreSpec = app.maxSavedShapeSpec;
        int restoreShadow = app.maxSavedShapeShadow;
        app.maxSavedShapeSpec = "";
        app.maxSavedShapeShadow = 0;
        app.SetWindowShape(restoreSpec);
        if (restoreShadow > 0) {
            app.SetWindowShadow(restoreShadow);
        }

        Assert(app.shapeMode == 1, "shapeMode restored to 1");
        Assert(app.shapeRadius == 16, "shapeRadius restored to 16");
        Assert(app.shapeShadow == 12, "shapeShadow restored to 12");
        Assert(app.shapeOffX == 12, "shapeOffX restored to 12");
        Assert(app.shapeOffY == 12, "shapeOffY restored to 12");
        Assert(app.maxSavedShapeSpec == "", "maxSavedShapeSpec cleared after restore");

        Console.WriteLine("window-round-restore:pass");
    }
}
