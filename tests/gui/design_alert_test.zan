using System;
using Gui;
using Gui.Widget;

partial class DesignAlert {
    static void OnLoad(Form form) { }
}

class DesignAlertTest {
    static int fails;

    static void Main() {
        Control root = DesignAlert.__BuildForm();
        // legacy kind "Alert" 生成真身 AlertBox 字段
        AlertBox warn = DesignAlert.Warn;
        if (warn == null || warn.Kind() != "AlertBox") {
            fails = fails + 1;
            Console.WriteLine("FAIL Warn kind");
        }
        // 新 kind 直通
        AlertBox ok = DesignAlert.Ok;
        if (ok == null) {
            fails = fails + 1;
            Console.WriteLine("FAIL Ok field");
        }
        // data-label 经 SetDesignText 落 text 属性
        if (warn != null && warn.Label() != "Watch out") {
            fails = fails + 1;
            Console.WriteLine("FAIL Warn text: " + warn.Label());
        }
        // name 收尾回写不被标题覆盖
        if (warn != null && warn.name != "Warn") {
            fails = fails + 1;
            Console.WriteLine("FAIL Warn name: " + warn.name);
        }
        // Find 可达
        if (root.Find("Warn") == null) {
            fails = fails + 1;
            Console.WriteLine("FAIL Find");
        }
        // type 通道在生成实例上可用
        ok.SetProp("type", "warning");
        if (ok.GetProp("type") != "2") {
            fails = fails + 1;
            Console.WriteLine("FAIL type: " + ok.GetProp("type"));
        }
        if (fails == 0) { Console.WriteLine("alert design OK"); }
        
    }
}
