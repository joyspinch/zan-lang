using System;
using System.IO;
using System.Web;
using Gui;
using Gui.Widget;

class DesignAlertTest {
    static int fails;

    static Control Ctl(Control root, string name) {
        Control c = root.Find(name);
        if (c == null) { throw new Exception("missing " + name); }
        return c;
    }

    static void Main() {
        string html = File.ReadAllText("tests/gui/design_alert.html");
        JsonValue document = JsonValue.ParseLenient(DesignerHtml.ToJsonDoc(html));
        Control root = FormBuilder.Build(document);
        // legacy kind "Alert" 归一成真身 AlertBox
        AlertBox warn = (AlertBox)Ctl(root, "Warn");
        if (warn.Kind() != "AlertBox") {
            fails = fails + 1;
            Console.WriteLine("FAIL Warn kind");
        }
        // 新 kind 直通
        AlertBox ok = (AlertBox)Ctl(root, "Ok");
        // data-label 经 SetDesignText 落 text 属性
        if (warn.Label() != "Watch out") {
            fails = fails + 1;
            Console.WriteLine("FAIL Warn text: " + warn.Label());
        }
        // name 收尾回写不被标题覆盖
        if (warn.name != "Warn") {
            fails = fails + 1;
            Console.WriteLine("FAIL Warn name: " + warn.name);
        }
        // Find 可达
        if (root.Find("Warn") == null) {
            fails = fails + 1;
            Console.WriteLine("FAIL Find");
        }
        // type 通道在运行期建出的实例上可用
        ok.SetProp("type", "warning");
        if (ok.GetProp("type") != "2") {
            fails = fails + 1;
            Console.WriteLine("FAIL type: " + ok.GetProp("type"));
        }
        if (fails == 0) { Console.WriteLine("alert design OK"); }

    }
}
