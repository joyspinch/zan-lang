using System;
using Gui;
using Gui.Widget;

namespace DataTableFormulaTest;

class Program {
    static DataRow Row(string id, string qty, string price) {
        DataRow row = new DataRow();
        row.Push(id);
        row.Push(qty);
        row.Push(price);
        return row;
    }

    static string Dump(DataSource src, DataTableState st, List<DataColumn> cols, int col) {
        string s = "";
        for (int i = 0; i < DataTable.DispCount(st); i = i + 1) {
            s = s + DataTable.CellTextRouted(cols, src, DataTable.DispRowOf(st, i), col) + " ";
        }
        return s;
    }

    static string IdDump(DataSource src, DataTableState st) {
        string s = "";
        for (int i = 0; i < DataTable.DispCount(st); i = i + 1) {
            s = s + src.CellText(DataTable.DispRowOf(st, i), 0) + " ";
        }
        return s;
    }

    static void Main() {
        // 数据：a(10,4)=40 b(30,2)=60 c(20,6)=120 d(40,1)=40
        List<DataRow> rows = new List<DataRow>();
        rows.Add(Program.Row("a", "10", "4"));
        rows.Add(Program.Row("b", "30", "2"));
        rows.Add(Program.Row("c", "20", "6"));
        rows.Add(Program.Row("d", "40", "1"));
        LocalDataSource src = new LocalDataSource(rows);

        List<DataColumn> cols = new List<DataColumn>();
        cols.Add(DataColumn.Field(new DataColumn("Id", 60), "id"));
        cols.Add(DataColumn.Field(DataColumn.Numeric("Qty", 80), "qty"));
        cols.Add(DataColumn.Field(DataColumn.Numeric("Price", 80), "price"));
        cols.Add(DataColumn.Field(DataColumn.Formula("Total", 100, "qty * price"), "total"));
        cols.Add(DataColumn.Field(DataColumn.Formula("Nest", 90, "total / 2"), "nest"));

        DataTableState st = new DataTableState();
        DataTable.EnsureInit(st, cols, src);
        DataTable.Recompute(st, cols, src);

        // ---- 基础四则与优先级 ----
        // qty*price：a=40 b=60 c=120 d=40（2 位小数格式）
        Console.WriteLine("total=" + (Program.Dump(src, st, cols, 3) == "40.00 60.00 120.00 40.00 "));
        // 优先级：qty + price * 2 = qty + (price*2)
        cols.Add(DataColumn.Field(DataColumn.Formula("Mix", 90, "qty + price * 2"), "mix"));
        DataTable.InvalidateFormulaCache();
        DataTable.EnsureInit(st, cols, src);
        DataTable.Recompute(st, cols, src);
        // a=18 b=34 c=32 d=42
        Console.WriteLine("mix=" + (Program.Dump(src, st, cols, 5) == "18.00 34.00 32.00 42.00 "));
        // 括号改变优先级：(qty + price) * 2
        cols.Add(DataColumn.Field(DataColumn.Formula("Par", 90, "(qty + price) * 2"), "par"));
        DataTable.InvalidateFormulaCache();
        DataTable.EnsureInit(st, cols, src);
        DataTable.Recompute(st, cols, src);
        // a=28 b=64 c=52 d=82
        Console.WriteLine("par=" + (Program.Dump(src, st, cols, 6) == "28.00 64.00 52.00 82.00 "));
        // 一元负号：-(qty - 30)
        cols.Add(DataColumn.Field(DataColumn.Formula("Neg", 90, "-(qty - 30)"), "neg"));
        DataTable.InvalidateFormulaCache();
        DataTable.EnsureInit(st, cols, src);
        DataTable.Recompute(st, cols, src);
        // a=-(-20)=20 … 注意：-(10-30) = 20；-(30-30)=0；-(20-30)=10；-(40-30)=-10
        Console.WriteLine("neg=" + (Program.Dump(src, st, cols, 7) == "20.00 0.00 10.00 -10.00 "));

        // ---- 函数 ----
        // min/max/abs
        cols.Add(DataColumn.Field(DataColumn.Formula("Fn", 90, "min(qty, price, 25) + max(qty, price) + abs(price - qty)"), "fn"));
        DataTable.InvalidateFormulaCache();
        DataTable.EnsureInit(st, cols, src);
        DataTable.Recompute(st, cols, src);
        // a: min(10,4,25)=4 max=10 abs=6 → 20
        // b: min(30,2,25)=2 max=30 abs=28 → 60
        // c: min(20,6,25)=6 max=20 abs=14 → 40
        // d: min(40,1,25)=1 max=40 abs=39 → 80
        Console.WriteLine("fn=" + (Program.Dump(src, st, cols, 8) == "20.00 60.00 40.00 80.00 "));
        // round(x, 1) / floor / ceil
        cols.Add(DataColumn.Field(DataColumn.Formula("Rc", 90, "round(qty / 3, 1)"), "rc"));
        cols.Add(DataColumn.Field(DataColumn.Formula("Fc", 90, "floor(qty / 3) * 10 + ceil(qty / 3)"), "fc"));
        DataTable.InvalidateFormulaCache();
        DataTable.EnsureInit(st, cols, src);
        DataTable.Recompute(st, cols, src);
        // a: 10/3=3.33→3.3；floor=3, ceil=4 → 34
        // b: 30/3=10.0；floor=10, ceil=10 → 104（3.3*... 无，floor(10)*10+ceil(10)=104? no: 100+10=110）
        //   重算：b floor(10)=10 → 100 + 10 = 110？10*10+10=110
        // c: 20/3=6.67→6.7；floor=6, ceil=7 → 67
        // d: 40/3=13.33→13.3；floor=13, ceil=14 → 144
        Console.WriteLine("rc=" + (Program.Dump(src, st, cols, 9) == "3.30 10.00 6.70 13.30 "));
        Console.WriteLine("fc=" + (Program.Dump(src, st, cols, 10) == "34.00 110.00 67.00 144.00 "));
        // sqrt（Newton）。显示位数由列 decimals（默认 2）决定，
        // round(...,3) 只影响数值本身；要 3 位显示须 Decimals(c,3)。
        cols.Add(DataColumn.Field(DataColumn.Formula("Sq", 90, "round(sqrt(qty), 3)"), "sq"));
        DataTable.InvalidateFormulaCache();
        DataTable.EnsureInit(st, cols, src);
        DataTable.Recompute(st, cols, src);
        // sqrt(10)=3.162 sqrt(30)=5.477 sqrt(20)=4.472 sqrt(40)=6.325
        Console.WriteLine("sq=" + (Program.Dump(src, st, cols, 11) == "3.16 5.48 4.47 6.33 "));
        DataColumn sq3 = DataColumn.Formula("Sq3", 90, "round(sqrt(qty), 3)");
        DataColumn.Decimals(sq3, 3);
        cols.Add(DataColumn.Field(sq3, "sq3"));
        DataTable.InvalidateFormulaCache();
        DataTable.EnsureInit(st, cols, src);
        DataTable.Recompute(st, cols, src);
        Console.WriteLine("sq3=" + (Program.Dump(src, st, cols, 12) == "3.162 5.477 4.472 6.325 "));

        // ---- fail-soft：畸形表达式整列空、未知列整列空、除以 0 该行空 ----
        cols.Add(DataColumn.Field(DataColumn.Formula("Bad", 90, "qty +"), "bad"));
        cols.Add(DataColumn.Field(DataColumn.Formula("Unk", 90, "nope + 1"), "unk"));
        cols.Add(DataColumn.Field(DataColumn.Formula("Trash", 90, "qty 5"), "trash"));
        cols.Add(DataColumn.Field(DataColumn.Formula("Dz", 90, "qty / 0"), "dz"));
        cols.Add(DataColumn.Field(DataColumn.Formula("Half", 90, "qty / (price - 4)"), "half"));
        DataTable.InvalidateFormulaCache();
        DataTable.EnsureInit(st, cols, src);
        DataTable.Recompute(st, cols, src);
        Console.WriteLine("bad=" + (Program.Dump(src, st, cols, 13) == "    "));
        Console.WriteLine("unk=" + (Program.Dump(src, st, cols, 14) == "    "));
        Console.WriteLine("trash=" + (Program.Dump(src, st, cols, 15) == "    "));
        Console.WriteLine("dz=" + (Program.Dump(src, st, cols, 16) == "    "));
        // half: a 除以 0 → 空；b: 30/-2=-15；c: 20/2=10；d: 40/-3=-13.33
        Console.WriteLine("half=" + (Program.Dump(src, st, cols, 17) == " -15.00 10.00 -13.33 "));

        // ---- 嵌套公式引用读到源数据（空），fail-soft 显示 0.00 ----
        Console.WriteLine("nest=" + (Program.Dump(src, st, cols, 4) == "0.00 0.00 0.00 0.00 "));

        // ---- 排序（按公式实数键） ----
        DataTable.SortBy(st, 3, 2);
        DataTable.Recompute(st, cols, src);
        // total 降序：c(120) b(60) a(40) d(40)——a/d 并列保持源序
        Console.WriteLine("sortdesc=" + (Program.IdDump(src, st) == "c b a d "));
        DataTable.SortBy(st, 3, 1);
        DataTable.Recompute(st, cols, src);
        Console.WriteLine("sortasc=" + (Program.IdDump(src, st) == "a d b c "));
        DataTable.SortBy(st, -1, 1);
        DataTable.Recompute(st, cols, src);

        // ---- 页脚汇总（公式实数路径） ----
        DataTable.SetAggregate(st, 3, 1);
        DataTable.Recompute(st, cols, src);
        Console.WriteLine("sum=" + (st.summaryText[3] == "260.00"));
        DataTable.SetAggregate(st, 3, 2);
        DataTable.Recompute(st, cols, src);
        Console.WriteLine("avg=" + (st.summaryText[3] == "65.00"));
        DataTable.SetAggregate(st, 3, 0);

        // ---- FilterBuilder 数值条件作用于公式列 ----
        FilterGroup root = FilterGroup.And();
        root.Conditions().Add(FilterCondition.Greater("total", "50"));
        DataTable.SetFilterTree(st, root);
        DataTable.Recompute(st, cols, src);
        Console.WriteLine("filtergt=" + (Program.IdDump(src, st) == "b c "));
        DataTable.SetFilterTree(st, null);
        DataTable.Recompute(st, cols, src);
        Console.WriteLine("filterclear=" + (Program.IdDump(src, st) == "a b c d "));

        // ---- 类型配置 ----
        Console.WriteLine("kind=" + (cols[3].numeric && cols[3].editable == false
            && cols[3].decimals == 2 && cols[3].formula.Length > 0));
        Console.WriteLine("plain=" + (cols[0].formula.Length == 0 && cols[0].numeric == false));
    }
}
