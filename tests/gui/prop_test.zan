using System;
using Gui;
using Gui.Widget;

class PropTest {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void Main() {
        fails = 0;

        Button b = new Button("Save");
        b.Icon = "save";
        PropTest.Eq("text", b.GetProp("text"), "Save");
        PropTest.Eq("icon", b.GetProp("icon"), "save");
        PropTest.Eq("disabled", b.GetProp("disabled"), "false");
        PropTest.Eq("checked", b.GetProp("checked"), "false");

        b.SetProp("text", "Open");
        b.SetProp("icon", "folder");
        b.SetProp("tip", "Open a file");
        b.SetProp("tipSide", "top");
        b.SetProp("disabled", "true");
        PropTest.Eq("text after set", b.Label(), "Open");
        PropTest.Eq("icon after set", b.Icon, "folder");
        PropTest.Eq("tip after set", b.Tip, "Open a file");
        // 提示方位此前没进 Props()：设计器那一行写的是样式类，按钮
        // 的气泡方位纹丝不动。
        PropTest.Eq("tipSide after set", b.GetProp("tipSide"), "top");
        if (b.TipSide != "top") {
            fails = fails + 1;
            Console.WriteLine("FAIL tipSide did not reach the field");
        }
        PropTest.Eq("disabled after set", b.GetProp("disabled"), "true");
        if (!b.IsDisabled()) {
            fails = fails + 1;
            Console.WriteLine("FAIL IsDisabled after SetProp");
        }

        b.SetProp("class", "primary");
        b.SetProp("round", "true");
        b.SetProp("size", "small");
        PropTest.Eq("class", b.GetProp("class"), "primary round small");

        Panel grp = Panel.Row();
        Button cmd = new Button("Bold");
        grp.Add(cmd);
        grp.Disabled = true;
        if (!cmd.IsDisabled()) {
            fails = fails + 1;
            Console.WriteLine("FAIL inherited Disabled");
        }
        grp.Disabled = false;
        if (cmd.IsDisabled()) {
            fails = fails + 1;
            Console.WriteLine("FAIL Disabled cleared");
        }

        ToggleModel vm = new ToggleModel();
        cmd.Checked = vm.bold;
        if (!cmd.IsToggle()) {
            fails = fails + 1;
            Console.WriteLine("FAIL IsToggle for a bound Checked");
        }
        cmd.SetProp("checked", "true");
        if (!vm.bold) {
            fails = fails + 1;
            Console.WriteLine("FAIL SetProp('checked') did not write the model");
        }

        Label lab = new Label("Name");
        lab.SetProp("text", "Renamed");
        PropTest.Eq("label text", lab.GetProp("text"), "Renamed");
        PropTest.Eq("label name", lab.GetProp("name"), "Renamed");

        Tag tag = new Tag("beta");
        tag.SetProp("closable", "true");
        if (!tag.Closable) {
            fails = fails + 1;
            Console.WriteLine("FAIL closable did not reach the field");
        }
        PropTest.Eq("closable", tag.GetProp("closable"), "true");

        SwitchModel sm = new SwitchModel();
        Switch sw = new Switch();
        sw.data = sm.on;
        PropTest.Eq("switch value", sw.GetProp("value"), "false");
        sw.SetProp("checked", "true");          // document alias
        if (!sm.on) {
            fails = fails + 1;
            Console.WriteLine("FAIL switch alias did not write the model");
        }
        PropTest.Eq("switch on alias", sw.GetProp("on"), "true");
        sw.SetProp("value", "false");
        if (sm.on) {
            fails = fails + 1;
            Console.WriteLine("FAIL switch value did not write the model");
        }

        SliderModel vol = new SliderModel();
        Slider sl = new Slider(0, 10);
        sl.data = vol.cur;
        sl.SetProp("max", "20");
        sl.SetProp("value", "17");
        PropTest.Eq("slider max", sl.GetProp("max"), "20");
        PropTest.Eq("slider value", Convert.ToString(vol.cur), "17");

        Breadcrumb bc = new Breadcrumb();
        bc.SetProp("items", "home,docs,api");
        bc.SetProp("separator", "chevron");
        PropTest.Eq("items", bc.GetProp("items"), "home,docs,api");
        PropTest.Eq("separator", bc.GetProp("separator"), "chevron");

        Badge bg = new Badge(7);
        string cls = bg.GetProp("class");
        bg.SetProp("dot", "true");
        PropTest.Eq("dot count", bg.GetProp("count"), "0");
        PropTest.Eq("dot stayed off the classes", bg.GetProp("class"), cls);

        if (fails == 0) { Console.WriteLine("prop_test: OK"); }
        else { Console.WriteLine("prop_test: " + Convert.ToString(fails) + " failure(s)"); }
    }
}

class ToggleModel {
    bool bold;
    ToggleModel() { bold = false; }
}

class SwitchModel {
    bool on;
    SwitchModel() { on = false; }
}

class SliderModel {
    int cur;
    SliderModel() { cur = 5; }
}
