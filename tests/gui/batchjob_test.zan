using System;
using Gui;
using Gui.Widget;

// 核心契约与语义定义。
// "批量任务进度窗" ask: a saved component (components/BatchJobProgress.zcomp)
// 核心契约与语义定义。
partial class BatchJobApp {
    void OnInit() {
    }
}

class BatchJobTest {
    static int fails;

    static void Ok(string what, bool cond) {
        if (cond) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void Main() {
        fails = 0;

        BatchJobApp app = new BatchJobApp();

        // 核心契约与语义定义。
        Eq("shell kind", app.Job1.Kind(), "Panel");
        Eq("shell kind 2", app.Job2.Kind(), "Panel");

        // 核心契约与语义定义。
        Control title1 = app.Job1.Find("Import Data");
        Ok("instance title", title1 != null);
        Control bar1 = app.Job1.Find("Job1_Bar");
        Ok("instance bar", bar1 != null);
        if (bar1 != null) { Eq("instance percent", bar1.GetProp("percent"), "30"); }
        Control st1 = app.Job1.Find("Job1_StatusLine");
        if (st1 != null) { Eq("instance status", st1.GetProp("text"), "importing 30%"); }

        Control bar2 = app.Job2.Find("Job2_Bar");
        Ok("default bar", bar2 != null);
        if (bar2 != null) { Eq("default percent", bar2.GetProp("percent"), "0"); }
        Control st2 = app.Job2.Find("Job2_StatusLine");
        if (st2 != null) { Eq("default status", st2.GetProp("text"), "waiting…"); }
        Ok("default title by caption", app.Job2.Find("Batch Job") != null);

        // 核心契约与语义定义。
        if (bar1 != null) {
            bar1.SetProp("percent", "90");
            Eq("driven percent", bar1.GetProp("percent"), "90");
        }
        if (st1 != null) {
            st1.SetProp("text", "done");
            Eq("driven status", st1.GetProp("text"), "done");
        }

        if (fails == 0) { Console.WriteLine("BATCHJOB_OK"); }
    }
}
