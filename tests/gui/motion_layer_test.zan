using System;
using Gui;
using Gui.Animation;
using Gui.Backend;
using Gui.Widget;

class MotionLayerTest {
    static void Check(bool cond, string msg) {
        if (!cond) {
            Console.WriteLine("FAIL: " + msg);
            throw new Exception("MotionLayerTest: " + msg);
        }
    }

    static void TestAnimationEngine() {
        // Easing: CubicBezier + Steps + ElasticInOut
        float cb = Easing.CubicBezier(0.25f, 0.1f, 0.25f, 1.0f, 0.5f);
        Check(cb > 0.75f && cb < 0.85f, "CubicBezier ease(0.5) ~0.80");
        float stEnd = Easing.Steps(4, true, 0.3f);
        Check(stEnd > 0.24f && stEnd < 0.26f, "Steps(4, jumpEnd=true, 0.3) == 0.25");
        float stStart = Easing.Steps(4, false, 0.3f);
        Check(stStart > 0.49f && stStart < 0.51f, "Steps(4, jumpEnd=false, 0.3) == 0.50");
        float el = Easing.Evaluate(EaseType.ElasticInOut, 0.5f);
        Check(el > 0.45f && el < 0.55f, "ElasticInOut(0.5) ~0.5");

        // SpringAnim substepped convergence + retarget
        SpringAnim sp = SpringAnim.Create(0.0f, 100.0f, 180.0f, 20.0f, 1.0f, null);
        sp.Play();
        for (int i = 0; i < 60; i++) { sp.Step(50); }
        Check(sp.finished && sp.value > 99.5f && sp.value < 100.5f, "SpringAnim settles at 100");
        sp.Retarget(50.0f);
        Check(!sp.finished && sp.active, "SpringAnim restarts on Retarget");
        for (int i = 0; i < 60; i++) { sp.Step(50); }
        Check(sp.finished && sp.value > 49.5f && sp.value < 50.5f, "SpringAnim settles at 50");

        // AnimationTimeline Pause eviction fix + Tween yoyo/delay
        AnimationTimeline tl = new AnimationTimeline();
        Tween tw = Tween.Create(0.0f, 100.0f, 200, EaseType.Linear, null);
        tw.WithDelay(50).WithRepeat(1).WithYoyo(true);
        tl.Add(tw);
        tw.Play();
        tl.Tick(30);
        Check(tw.currentVal == 0.0f, "Tween holds start during delay");
        tw.Pause();
        tl.Tick(500);
        Check(tl.EntryCount() == 1 && tw.currentVal == 0.0f, "Paused tween not evicted from timeline");
        tw.Resume();
        tl.Tick(120);
        Check(tw.currentVal > 45.0f && tw.currentVal < 55.0f, "Resumed tween advances cleanly");

        // AnimGroup Sequence
        AnimGroup seq = AnimGroup.Sequence();
        Tween a = Tween.Create(0.0f, 10.0f, 100, EaseType.Linear, null);
        Tween b = Tween.Create(0.0f, 20.0f, 100, EaseType.Linear, null);
        seq.Add(a).Add(b);
        seq.Play();
        seq.Step(50);
        Check(a.currentVal > 4.5f && a.currentVal < 5.5f && b.currentVal == 0.0f, "Sequence plays item 0 first");
        seq.Step(50);
        Check(a.finished && b.active, "Sequence hands off to item 1");
        seq.Step(50);
        Check(b.currentVal > 9.0f && b.currentVal < 11.0f, "Sequence advances into item 1");
        seq.Step(50);
        Check(seq.finished && b.currentVal == 20.0f, "Sequence completes cleanly");
    }

    static void TestKeyframesAndTransition() {
        string css =
            ":root { --hi: #ff0000; }\n"
            + "@keyframes pulse-slide {\n"
            + "  0%, 100% { opacity: 0.2; transform: translateX(0px) rotate(0deg); background: #000000; }\n"
            + "  50% { opacity: 1.0; transform: translateX(40px) rotate(90deg); background: var(--hi); }\n"
            + "}\n"
            + ".box {\n"
            + "  animation: pulse-slide 400ms cubic-bezier(0.25, 0.1, 0.25, 1.0) 100ms 2 alternate forwards;\n"
            + "  transition: opacity 200ms cubic-bezier(0.0, 0.0, 1.0, 1.0) 50ms;\n"
            + "}\n";
        StyleSheet sheet = Css.Parse(css);
        Check(sheet.atRulesDropped == 0, "@keyframes not dropped");
        CssKeyframeRule kf = sheet.FindKeyframes("pulse-slide");
        Check(kf != null && kf.stops.Count == 3, "keyframes stop count == 3");

        StyleBox baseBox = new StyleBox();
        sheet.ApplyBox(baseBox, ".box");
        Check(baseBox.motion != null, "MotionSpec allocated");
        Check(baseBox.motion.animName == "pulse-slide" && baseBox.animMs == 400, "anim name & duration");
        Check(baseBox.motion.animDelayMs == 100 && baseBox.motion.animIterations == 2, "anim delay & iterations");
        Check(baseBox.motion.animDirection == 2 && baseBox.motion.animFillMode == 1, "anim direction & fill");
        Check(baseBox.motion.transitionDelayMs == 50 && baseBox.motion.transitionPropMask == MotionSpec.PropOpacity(), "transition delay & mask");

        StyleBox mid = kf.Evaluate(baseBox, 500);
        Check(mid.opacity == 1000 && mid.tx == 40 && mid.rotate == 90, "50% stop evaluation");
        StyleBox quarter = kf.Evaluate(baseBox, 250);
        Check(quarter.opacity >= 590 && quarter.opacity <= 610 && quarter.tx == 20 && quarter.rotate == 45, "25% stop interpolation");

        Dispatcher.Init();
        App app = App.CreateOffscreen("motion-trans", 120, 80);
        Button btn = new Button("");
        btn.ClassName = "step-btn";
        app.sheet = Css.Parse(
            "button.step-btn { background: #000000; opacity: 0.2; border: 0; border-radius: 0;"
            + " transition: opacity 200ms steps(4, end) 50ms; }\n"
            + "button.step-btn:hover { background: #00ff00; opacity: 1.0; }\n"
        );
        app.SetRootControl(btn);

        app.FreezeAnimClock(1000);
        app.BeginOffscreenFrame();
        app.canvas.Clear(0xff000000);
        btn.RenderInside(app, new Rect(10, 10, 60, 40));
        app.EndOffscreenFrame();

        app.ProcessOffscreenInput(1, 30, 30, 0, 0, 0, 0);
        app.BeginOffscreenFrame();
        app.canvas.Clear(0xff000000);
        btn.RenderInside(app, new Rect(10, 10, 60, 40));
        app.EndOffscreenFrame();

        app.FreezeAnimClock(1030);
        app.BeginOffscreenFrame();
        app.canvas.Clear(0xff000000);
        btn.RenderInside(app, new Rect(10, 10, 60, 40));
        app.EndOffscreenFrame();
        int gDelay = (app.canvas.GetPixel(30, 30) >> 8) & 255;
        Check(gDelay >= 45 && gDelay <= 60, "transition delay holds opacity while bg snaps");

        app.FreezeAnimClock(1110);
        app.BeginOffscreenFrame();
        app.canvas.Clear(0xff000000);
        btn.RenderInside(app, new Rect(10, 10, 60, 40));
        app.EndOffscreenFrame();
        int gStep = (app.canvas.GetPixel(30, 30) >> 8) & 255;
        Check(gStep >= 95 && gStep <= 112, "steps(4,end) advances at step 1/4");

        app.FreezeAnimClock(1300);
        app.BeginOffscreenFrame();
        app.canvas.Clear(0xff000000);
        btn.RenderInside(app, new Rect(10, 10, 60, 40));
        app.EndOffscreenFrame();
        Check(((app.canvas.GetPixel(30, 30) >> 8) & 255) == 255, "transition finishes at full green");
    }

    static void TestRuntimeKeyframesAndLayers() {
        App app = App.CreateOffscreen("motion-layers", 120, 120);
        app.sheet = Css.Parse(
            "@keyframes shift {\n"
            + "  from { background: #ff0000; transform: translateX(0px); }\n"
            + "  to   { background: #ff0000; transform: translateX(40px); }\n"
            + "}\n"
            + ".anim-box { animation: shift 200ms linear 50ms 1 normal forwards; background: #ff0000; border: 0; border-radius: 0; }\n"
        );
        Panel item = new Panel();
        item.ClassName = "anim-box";
        app.SetRootControl(item);

        app.FreezeAnimClock(1000);
        app.BeginOffscreenFrame();
        app.canvas.Clear(0xff000000);
        item.RenderInside(app, new Rect(10, 10, 20, 20));
        app.EndOffscreenFrame();
        Check(((app.canvas.GetPixel(15, 20) >> 16) & 255) > 200, "kf start pos");

        app.FreezeAnimClock(1150);
        app.BeginOffscreenFrame();
        app.canvas.Clear(0xff000000);
        item.RenderInside(app, new Rect(10, 10, 20, 20));
        app.EndOffscreenFrame();
        Check(((app.canvas.GetPixel(15, 20) >> 16) & 255) == 0, "kf mid left cleared");
        Check(((app.canvas.GetPixel(40, 20) >> 16) & 255) > 200, "kf mid shifted");

        app.FreezeAnimClock(1300);
        app.BeginOffscreenFrame();
        app.canvas.Clear(0xff000000);
        item.RenderInside(app, new Rect(10, 10, 20, 20));
        app.EndOffscreenFrame();
        Check(((app.canvas.GetPixel(60, 20) >> 16) & 255) > 200, "kf forwards hold");

        Canvas c = app.canvas;
        c.Clear(0xff000000);
        Check(c.PushLayerOpacity(10, 10, 40, 40, 500), "PushLayerOpacity");
        c.FillRect(0, 0, 40, 40, 0xffff0000);
        c.FillRect(0, 0, 40, 40, 0xff00ff00);
        c.PopLayer();
        int px = c.GetPixel(25, 25);
        Check(((px >> 16) & 255) == 0 && ((px >> 8) & 255) >= 120 && ((px >> 8) & 255) <= 135, "true group opacity");

        c.Clear(0xff000000);
        Check(c.PushLayer(20, 20, 20, 20, 1000, 1000, 90), "PushLayer rotate 90");
        c.FillRect(0, 0, 20, 4, 0xff0000ff);
        c.PopLayer();
        Check((c.GetPixel(38, 30) & 255) > 200 && (c.GetPixel(22, 30) & 255) < 20, "90deg CW rotation");

        c.Clear(0xff000000);
        Check(c.PushLayer(40, 40, 20, 20, 1000, 2000, 0), "PushLayer scale 2x");
        c.FillRect(0, 0, 20, 20, 0xffff00ff);
        c.PopLayer();
        Check(((c.GetPixel(32, 32) >> 16) & 255) > 200, "2x layer scale");

        IconView icon = new IconView("refresh", 20);
        icon.ClassName = "spin-icon";
        app.sheet = Css.Parse(".spin-icon { animation: spin 900ms linear infinite; color: #ffffff; }");
        app.SetRootControl(icon);
        app.FreezeAnimClock(1225);
        app.BeginOffscreenFrame();
        app.canvas.Clear(0xff000000);
        icon.RenderInside(app, new Rect(20, 20, 24, 24));
        app.EndOffscreenFrame();
    }

    static bool exitCallbackFired;
    static void OnExitDone() { exitCallbackFired = true; }

    static void TestSpringFlipAndFx() {
        // 1. CSS spring(...) parsing + analytical underdamped overshoot
        StyleSheet sh = Css.Parse(
            ".sp1 { transition: transform 400ms spring(0.45); }\n"
            + ".sp2 { transition-timing-function: spring(300, 18); }\n"
            + ".sp3 { transition-timing-function: spring-bouncy; }\n"
            + ".sp4 { animation: orbit 2200ms; }\n"
            + ".sp5 { animation: skeleton 1400ms; }\n"
        );
        StyleBox b1 = new StyleBox(); sh.ApplyBox(b1, ".sp1");
        Check(b1.easing == 7 && b1.motion != null, "CSS spring(bounce) parsed");
        int peak = 0;
        for (int p = 50; p <= 950; p = p + 50) {
            int v = b1.motion.EvalTransitionCurve(b1.easing, p);
            if (v > peak) { peak = v; }
        }
        Check(peak > 1020, "underdamped spring overshoots > 1000");
        Check(b1.motion.EvalTransitionCurve(b1.easing, 1000) == 1000, "spring settles at 1000");

        StyleBox b2 = new StyleBox(); sh.ApplyBox(b2, ".sp2");
        Check(b2.easing == 7 && b2.motion.springStiffness > 299.0f && b2.motion.springDamping < 19.0f, "CSS spring(k,c) parsed");
        StyleBox b3 = new StyleBox(); sh.ApplyBox(b3, ".sp3");
        Check(b3.easing == 7, "CSS spring-bouncy preset parsed");
        StyleBox b4 = new StyleBox(); sh.ApplyBox(b4, ".sp4");
        Check(b4.anim == Style.AnimOrbit(), "CSS animation: orbit parsed");
        StyleBox b5 = new StyleBox(); sh.ApplyBox(b5, ".sp5");
        Check(b5.anim == Style.AnimSkeleton(), "CSS animation: skeleton parsed");

        // 2. Overshoot-safe StyleBox.Blend + shadow2 transition
        StyleBox fromB = new StyleBox();
        fromB.bg = (int)0xFF102030u; fromB.tx = 0; fromB.scale = 1000; fromB.opacity = 1000;
        fromB.shadow2 = (int)0x40000000u; fromB.shadow2Dy = 4; fromB.shadow2Blur = 12;
        StyleBox toB = new StyleBox();
        toB.bg = (int)0xFFF0F4FFu; toB.tx = 100; toB.scale = 1100; toB.opacity = 1000;
        toB.shadow2 = (int)0x80102030u; toB.shadow2Dy = 12; toB.shadow2Blur = 24;
        StyleBox overB = StyleBox.Blend(fromB, toB, 1150);
        Check(overB.tx == 115 && overB.scale == 1115, "transform overshoots organically");
        Check(overB.bg == toB.bg && overB.opacity == 1000, "color & opacity clamp safely on overshoot");
        StyleBox midB = StyleBox.Blend(fromB, toB, 500);
        Check(midB.shadow2Dy == 8 && midB.shadow2Blur == 18, "shadow2 interpolates under Blend");

        // 3. SpringAnim presets & Spring2D
        SpringAnim sn = SpringAnim.Snappy(0.0f, 50.0f, null);
        sn.Play();
        for (int i = 0; i < 60; i = i + 1) { sn.Step(32); }
        Check(sn.finished && sn.value > 49.5f && sn.value < 50.5f, "SpringAnim.Snappy converges");

        Spring2D s2 = Spring2D.Bouncy(0.0f, 0.0f, 80.0f, -40.0f, null);
        s2.Play();
        for (int i = 0; i < 80; i = i + 1) { s2.Step(32); }
        Check(s2.finished && s2.x.value > 79.5f && s2.y.value < -39.5f, "Spring2D converges");
        s2.Retarget(10.0f, 20.0f);
        for (int i = 0; i < 80; i = i + 1) { s2.Step(32); }
        Check(s2.finished && s2.x.value > 9.5f && s2.x.value < 10.5f && s2.y.value > 19.5f, "Spring2D retarget converges");

        // 4. Zero-alloc motion transform + FlipGroup FLIP & Presence Enter/Exit
        App app = App.CreateOffscreen("flip-fx", 160, 120);
        Panel host = new Panel();
        Panel cA = new Panel();
        Panel cB = new Panel();
        cA.InlineStyle("background: #3366ff; border-radius: 8px;");
        host.Add(cA); host.Add(cB);
        cA.bx = 10; cA.by = 10; cA.bw = 40; cA.bh = 30;
        cB.bx = 10; cB.by = 50; cB.bw = 40; cB.bh = 30;

        FlipGroup flip = new FlipGroup();
        flip.Capture(host);
        // Simulate reorder (swap vertical positions)
        cA.by = 50; cB.by = 10;
        int moved = flip.Play(app, 0.25f, 0.10f);
        Check(moved == 2, "FlipGroup detects 2 moved children");
        Check(cA.MotionTy() == -40 && cB.MotionTy() == 40, "FlipGroup inverts immediately");
        Check(cA.InlineStyleCss() == "background: #3366ff; border-radius: 8px;", "FlipGroup does not mutate inlineStyleCss");
        StyleBox resolved = cA.Box(app);
        Check(resolved.ty == -40, "zero-alloc motion composes into StyleBox");
        for (int i = 0; i < 80; i = i + 1) { AnimationTimeline.Shared.Tick(25); }
        Check(!cA.HasMotion() && !cB.HasMotion(), "FlipGroup resets motion on settle");

        // Presence Enter & Exit
        exitCallbackFired = false;
        FlipGroup.Enter(app, cA, 0, 24, 920, 0, 0.22f, 0.05f, null);
        Check(cA.HasMotion() && cA.MotionTy() == 24, "Presence Enter starts offset");
        for (int i = 0; i < 80; i = i + 1) { AnimationTimeline.Shared.Tick(25); }
        Check(!cA.HasMotion(), "Presence Enter settles and resets motion");

        FlipGroup.Exit(app, cA, 0, -16, 940, 0, 0.20f, 0.0f, OnExitDone);
        for (int i = 0; i < 80; i = i + 1) { AnimationTimeline.Shared.Tick(25); }
        Check(exitCallbackFired, "Presence Exit fires onDone callback");
        cA.ResetMotion();

        // 5. Fx rounded perimeter + Ripple + ShimmerSkeleton + GradientBorder + CardBreath + CardSheen
        app.FreezeAnimClock(1400);
        app.canvas.Clear((int)0xFF0F172Au);
        Fx.Ripple(app, 10, 10, 80, 40, 10, 50, 30, 350, (int)0x8038BDF8u);
        Check(app.canvas.GetPixel(50, 30) != (int)0xFF0F172Au, "Fx.Ripple paints inside bounds");
        app.canvas.Clear((int)0xFF0F172Au);
        Fx.ShimmerSkeleton(app, 10, 10, 120, 30, 8, (int)0xFF1E293Bu, (int)0x60FFFFFFu, 1600);
        Check(app.canvas.GetPixel(40, 25) != (int)0xFF0F172Au, "Fx.ShimmerSkeleton renders");
        app.canvas.Clear((int)0xFF0F172Au);
        Fx.GradientBorder(app, 10, 10, 100, 60, 14, (int)0xFF6366F1u, (int)0xFF06B6D4u, 2400);
        // Verify corner pixel (10,10) stays dark because perimeter traces the 14px rounded arc!
        Check(app.canvas.GetPixel(10, 10) == (int)0xFF0F172Au, "Fx.GradientBorder traces rounded corner arc");
        Fx.CardBreath(app, 10, 10, 100, 60, 14, (int)0xFF38BDF8u, 2000);
        Fx.CardSheen(app, 10, 10, 100, 60, (int)0xFFFFFFFFu, 2000);
        // 6. Control.Translate/ScalePct/Rotate/Opacity independent zero-alloc composition + combined native layer composite
        Panel comp = new Panel();
        comp.Translate(12, -8);
        comp.ScalePct(125);
        comp.Rotate(15);
        comp.Opacity(60);
        for (int i = 0; i < 40; i = i + 1) {
            comp.Translate(i, -i);
            comp.Opacity(50 + (i % 50));
        }
        StyleBox compBox = comp.Box(app);
        Check(compBox.tx == 39 && compBox.ty == -39 && compBox.scale == 1250
            && compBox.rotate == 15 && compBox.opacity == 890
            && comp.InlineStyleCss() == "", "Control motion helpers compose independently without CSS bloat");

        app.canvas.Clear((int)0xFF000000u);
        Check(app.canvas.PushLayer(40, 40, 30, 30, 500, 1500, 45), "PushLayer combined rotate+scale+opacity");
        app.canvas.FillRect(0, 0, 30, 30, (int)0xFFFF0000u);
        app.canvas.PopLayer();
        int midPx = app.canvas.GetPixel(55, 55);
        Check(((midPx >> 16) & 255) >= 120 && ((midPx >> 16) & 255) <= 136
            && ((midPx >> 8) & 255) == 0, "native composite rotate+scale+opacity center matches 50% red");

        app.canvas.Destroy();
    }

    static void Main() {
        TestAnimationEngine();
        TestKeyframesAndTransition();
        TestRuntimeKeyframesAndLayers();
        TestSpringFlipAndFx();
        Console.WriteLine("MOTION_LAYER_TEST_OK");
    }
}
