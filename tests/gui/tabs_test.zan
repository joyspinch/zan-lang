using System;
using Gui;
using Gui.Widget;

namespace TabsTest;

/// Headless check of the tab strip's close bookkeeping. Closing a tab while the
/// strip is being drawn shrinks the list under the pass that is drawing it, so
/// the strip stops on the frame a tab goes away; what this test can see is the
/// state that pass would be left holding -- above all that an empty strip has no
/// active tab, because a 0 there is an index into nothing.
class Program {
    static string Shape(Tabs t) {
        string s = Convert.ToString(t.Count()) + " active=" +
            Convert.ToString(t.Active()) + " label='" + t.ActiveLabel() + "'";
        return s;
    }

    static void Main() {
        Tabs t = new Tabs(Tabs.Line(), Tabs.Horizontal());
        t.Add("One", true);
        t.Add("Two", true);
        t.Add("Three", true);
        t.Select(2);
        Console.WriteLine("start " + Program.Shape(t));

        // Closing a tab before the active one carries the selection along with
        // it, so the same page stays open.
        t.CloseAt(0);
        Console.WriteLine("closed first " + Program.Shape(t));
        Console.WriteLine("closedIndex " + Convert.ToString(t.TakeClosed()));
        Console.WriteLine("taken twice " + Convert.ToString(t.TakeClosed()));

        // Closing the active last tab falls back to its neighbour.
        t.CloseAt(1);
        Console.WriteLine("closed active " + Program.Shape(t));

        // ...and closing the only one leaves nothing selected.
        t.CloseAt(0);
        Console.WriteLine("closed last " + Program.Shape(t));

        // An index nobody has cannot close anything.
        t.CloseAt(0);
        t.CloseAt(0 - 1);
        Console.WriteLine("after bogus " + Program.Shape(t));

        // Adding one back selects it, which is the only tab there is.
        t.Add("Fresh", true);
        t.Select(0);
        Console.WriteLine("re-added " + Program.Shape(t));
    }
}
