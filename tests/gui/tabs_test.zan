using System;
using Gui;
using Gui.Widget;

namespace TabsTest;

/// Headless check of the tab strip's close bookkeeping. Closing a tab while the
/// strip is being drawn shrinks the list under the pass that is drawing it, so
/// the strip stops on the frame a tab goes away; what this test can see is the
/// state that pass would be left holding -- above all that an empty strip has no
/// active tab, because a 0 there is an index into nothing.
class Program {
    static string Shape(Tabs t) {
        string s = Convert.ToString(t.Count()) + " active=" +
            Convert.ToString(t.Active()) + " label='" + t.ActiveLabel() + "'";
        return s;
    }

    /// 把宿主该领的关闭索引一个不剩地领完：批量关闭下这是一串，
    /// 而它们的顺序就是宿主能不能按索引安全删自己那份并行数组。
    static string Drain(Tabs t) {
        string s = "";
        int i = t.TakeClosed();
        while (i >= 0) {
            if (s != "") { s = s + ","; }
            s = s + Convert.ToString(i);
            i = t.TakeClosed();
        }
        if (s == "") { s = "-"; }
        return s;
    }

    static void Main() {
        Tabs t = new Tabs(Tabs.Line(), Tabs.Horizontal());
        t.Add("One", true);
        t.Add("Two", true);
        t.Add("Three", true);
        t.Select(2);
        Console.WriteLine("start " + Program.Shape(t));

        // Closing a tab before the active one carries the selection along with
        // it, so the same page stays open.
        t.CloseAt(0);
        Console.WriteLine("closed first " + Program.Shape(t));
        Console.WriteLine("closedIndex " + Convert.ToString(t.TakeClosed()));
        Console.WriteLine("taken twice " + Convert.ToString(t.TakeClosed()));

        // Closing the active last tab falls back to its neighbour.
        t.CloseAt(1);
        Console.WriteLine("closed active " + Program.Shape(t));

        // ...and closing the only one leaves nothing selected.
        t.CloseAt(0);
        Console.WriteLine("closed last " + Program.Shape(t));

        // An index nobody has cannot close anything.
        t.CloseAt(0);
        t.CloseAt(0 - 1);
        Console.WriteLine("after bogus " + Program.Shape(t));

        // Adding one back selects it, which is the only tab there is.
        t.Add("Fresh", true);
        t.Select(0);
        Console.WriteLine("re-added " + Program.Shape(t));

        // 「关闭全部」：固定标签（closable == false）是宿主的常驻页，不能连它
        // 一起端走；关掉的每一个都要上报，否则宿主只删一项，剩下的页与
        // 浏览器全部错位到别人的标签上。
        Tabs all = new Tabs(Tabs.Line(), Tabs.Horizontal());
        all.Add("Home", false);
        all.Add("A", true);
        all.Add("B", true);
        all.Add("C", true);
        all.Select(3);
        all.CloseAll();
        Console.WriteLine("close all " + Program.Shape(all));
        Console.WriteLine("close all drained " + Program.Drain(all));
        Console.WriteLine("close all changed " +
            Convert.ToString(all.TakeChanged()));

        // 「关闭其他」留下右键的那个标签和固定标签，选中项跟着保留的
        // 标签走（它前面关掉几个就往前挪几格）。
        Tabs others = new Tabs(Tabs.Line(), Tabs.Horizontal());
        others.Add("Home", false);
        others.Add("A", true);
        others.Add("B", true);
        others.Add("C", true);
        others.Select(1);
        others.CloseOthers(2);
        Console.WriteLine("close others " + Program.Shape(others));
        Console.WriteLine("close others drained " + Program.Drain(others));
        Console.WriteLine("close others changed " +
            Convert.ToString(others.TakeChanged()));

        // 全部可关闭时「关闭全部」清空标签条，此时没有活动标签；
        // 补回一个标签就接管选中。
        Tabs bare = new Tabs(Tabs.Line(), Tabs.Horizontal());
        bare.Add("A", true);
        bare.Add("B", true);
        bare.CloseAll();
        Console.WriteLine("emptied " + Program.Shape(bare));
        Console.WriteLine("emptied drained " + Program.Drain(bare));
        bare.Add("Back", true);
        Console.WriteLine("refilled " + Program.Shape(bare));

        // 固定标签只是不画关闭按钮，右键菜单的「关闭」走的还是 CloseAt：
        // 它必须原地不动、也不上报，否则宿主删掉一份并行数组项就和标签
        // 错位（点固定标签的「关闭」直接闪退就是这么来的）。菜单据此
        // 置灰，靠的是同一组判断。
        Tabs pinned = new Tabs(Tabs.Line(), Tabs.Horizontal());
        pinned.Add("Home", false);
        pinned.Add("A", true);
        pinned.Select(0);
        Console.WriteLine("pinned closable " +
            Convert.ToString(pinned.Closable(0)) + "," +
            Convert.ToString(pinned.Closable(1)) + "," +
            Convert.ToString(pinned.Closable(9)));
        pinned.CloseAt(0);
        Console.WriteLine("pinned kept " + Program.Shape(pinned));
        Console.WriteLine("pinned drained " + Program.Drain(pinned));
        // 「关闭其他/关闭全部」的可用性：只剩固定标签时无事可做。
        Console.WriteLine("pinned others " +
            Convert.ToString(pinned.ClosableCount(1)) + "," +
            Convert.ToString(pinned.ClosableCount(0 - 1)));
        pinned.CloseAt(1);
        Console.WriteLine("pinned alone " + Program.Shape(pinned));
        Console.WriteLine("pinned alone drained " + Program.Drain(pinned));
        Console.WriteLine("pinned alone counts " +
            Convert.ToString(pinned.ClosableCount(0)) + "," +
            Convert.ToString(pinned.ClosableCount(0 - 1)));
        pinned.CloseAll();
        Console.WriteLine("pinned close all " + Program.Shape(pinned));
        Console.WriteLine("pinned close all drained " + Program.Drain(pinned));
    }
}
