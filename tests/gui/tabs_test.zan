using System;
using Gui;
using Gui.Widget;

namespace TabsTest;

// 关闭序列监听：TabClosed 回调内读 ClosedIndex；批量关闭一次派发一串，
// 它们的顺序就是宿主能不能按索引安全删自己那份并行数组。
class TabsListener {
    public List<int> closed = new List<int>();
    public int changed;
    public void Closed(Control s) { closed.Add(((Tabs)s).ClosedIndex()); }
    public void Changed(Control s) { changed = changed + 1; }
}

class Program {
    static string Shape(Tabs t) {
        string s = Convert.ToString(t.Count()) + " active=" +
            Convert.ToString(t.Active()) + " label='" + t.LabelAt(t.Active()) + "'";
        return s;
    }

    static string Closed(TabsListener l) {
        string s = "";
        for (int i = 0; i < l.closed.Count; i = i + 1) {
            if (i > 0) { s = s + ","; }
            s = s + Convert.ToString(l.closed[i]);
        }
        if (s == "") { s = "-"; }
        return s;
    }

    static void Main() {
        Tabs t = new Tabs(Tabs.Line(), Tabs.Horizontal());
        TabsListener listen = new TabsListener();
        t.TabClosed.AddS(listen.Closed);
        t.TabChanged.AddS(listen.Changed);
        t.Add("One", true);
        t.Add("Two", true);
        t.Add("Three", true);
        t.Select(2);
        Console.WriteLine("start " + Program.Shape(t));

        t.CloseTab(0);
        Console.WriteLine("closed first " + Program.Shape(t));
        Console.WriteLine("closedIndex " + Convert.ToString(listen.closed[0]));
        Console.WriteLine("closed events " + Convert.ToString(listen.closed.Count));

        t.CloseTab(1);
        Console.WriteLine("closed active " + Program.Shape(t));

        t.CloseTab(0);
        Console.WriteLine("closed last " + Program.Shape(t));

        t.CloseTab(0);
        t.CloseTab(0 - 1);
        Console.WriteLine("after bogus " + Program.Shape(t));

        t.Add("Fresh", true);
        t.Select(0);
        Console.WriteLine("re-added " + Program.Shape(t));

        // 「关闭全部」：固定标签（closable == false）是宿主的常驻页，不能连它
        // 一起端走；关掉的每一个都要上报，否则宿主只删一项，剩下的页与
        // 浏览器全部错位到别人的标签上。
        Tabs all = new Tabs(Tabs.Line(), Tabs.Horizontal());
        TabsListener allListen = new TabsListener();
        all.Add("Home", false);
        all.Add("A", true);
        all.Add("B", true);
        all.Add("C", true);
        all.Select(3);
        // 宿主在初始装配后才挂回调：计数只含此后的交互变更。
        all.TabClosed.AddS(allListen.Closed);
        all.TabChanged.AddS(allListen.Changed);
        all.CloseAll();
        Console.WriteLine("close all " + Program.Shape(all));
        Console.WriteLine("close all drained " + Program.Closed(allListen));
        Console.WriteLine("close all changed " + Convert.ToString(allListen.changed));

        // 「关闭其他」留下右键的那个标签和固定标签，选中项跟着保留的
        // 标签走（它前面关掉几个就往前挪几格）。
        Tabs others = new Tabs(Tabs.Line(), Tabs.Horizontal());
        TabsListener othersListen = new TabsListener();
        others.Add("Home", false);
        others.Add("A", true);
        others.Add("B", true);
        others.Add("C", true);
        others.Select(1);
        others.TabClosed.AddS(othersListen.Closed);
        others.TabChanged.AddS(othersListen.Changed);
        others.CloseOthers(2);
        Console.WriteLine("close others " + Program.Shape(others));
        Console.WriteLine("close others drained " + Program.Closed(othersListen));
        Console.WriteLine("close others changed " + Convert.ToString(othersListen.changed));

        // 全部可关闭时「关闭全部」清空标签条，此时没有活动标签；
        // 补回一个标签就接管选中。
        Tabs bare = new Tabs(Tabs.Line(), Tabs.Horizontal());
        TabsListener bareListen = new TabsListener();
        bare.TabClosed.AddS(bareListen.Closed);
        bare.Add("A", true);
        bare.Add("B", true);
        bare.CloseAll();
        Console.WriteLine("emptied " + Program.Shape(bare));
        Console.WriteLine("emptied drained " + Program.Closed(bareListen));
        bare.Add("Back", true);
        Console.WriteLine("refilled " + Program.Shape(bare));

        // 固定标签只是不画关闭按钮，右键菜单的「关闭」走的还是 CloseTab：
        // 它必须原地不动、也不上报，否则宿主删掉一份并行数组项就和标签
        // 错位（点固定标签的「关闭」直接闪退就是这么来的）。菜单据此
        // 置灰，靠的是同一组判断。
        Tabs pinned = new Tabs(Tabs.Line(), Tabs.Horizontal());
        TabsListener pinnedListen = new TabsListener();
        pinned.TabClosed.AddS(pinnedListen.Closed);
        pinned.Add("Home", false);
        pinned.Add("A", true);
        pinned.Select(0);
        Console.WriteLine("pinned closable " +
            Convert.ToString(pinned.Closable(0)) + "," +
            Convert.ToString(pinned.Closable(1)) + "," +
            Convert.ToString(pinned.Closable(9)));
        pinned.CloseTab(0);
        Console.WriteLine("pinned kept " + Program.Shape(pinned));
        Console.WriteLine("pinned drained " + Program.Closed(pinnedListen));
        // 「关闭其他/关闭全部」的可用性：只剩固定标签时无事可做。
        Console.WriteLine("pinned others " +
            Convert.ToString(pinned.ClosableCount(1)) + "," +
            Convert.ToString(pinned.ClosableCount(0 - 1)));
        pinned.CloseTab(1);
        Console.WriteLine("pinned alone " + Program.Shape(pinned));
        Console.WriteLine("pinned alone drained " + Program.Closed(pinnedListen));
        Console.WriteLine("pinned alone counts " +
            Convert.ToString(pinned.ClosableCount(0)) + "," +
            Convert.ToString(pinned.ClosableCount(0 - 1)));
        pinnedListen.closed.Clear();
        pinned.CloseAll();
        Console.WriteLine("pinned close all " + Program.Shape(pinned));
        Console.WriteLine("pinned close all drained " + Program.Closed(pinnedListen));

        // The active identity changes even though its numeric index stays zero.
        Tabs shifted = new Tabs();
        TabsListener shiftedListen = new TabsListener();
        shifted.TabClosed.AddS(shiftedListen.Closed);
        shifted.TabChanged.AddS(shiftedListen.Changed);
        shifted.Add("A", true);
        shifted.Add("Home", false);
        shifted.Page(0);
        Panel homePage = shifted.Page(1);
        shifted.CloseAll();
        Console.WriteLine("same index all " + Program.Shape(shifted));
        Console.WriteLine("same index all page " + Convert.ToString(shifted.Page(0) == homePage));
        Console.WriteLine("same index all event " + Convert.ToString(shiftedListen.changed));
        Console.WriteLine("same index all drained " + Program.Closed(shiftedListen));
        shiftedListen.closed.Clear();
        shifted.CloseAll();
        Console.WriteLine("same index pinned noop " + Convert.ToString(shiftedListen.changed)
            + "," + Program.Closed(shiftedListen));

        Tabs replaced = new Tabs();
        TabsListener replacedListen = new TabsListener();
        replaced.TabClosed.AddS(replacedListen.Closed);
        replaced.TabChanged.AddS(replacedListen.Changed);
        replaced.Add("A", true);
        replaced.Add("B", true);
        replaced.Page(0);
        Panel keptPage = replaced.Page(1);
        replaced.CloseOthers(1);
        Console.WriteLine("same index others " + Program.Shape(replaced));
        Console.WriteLine("same index others page " + Convert.ToString(replaced.Page(0) == keptPage));
        Console.WriteLine("same index others event " + Convert.ToString(replacedListen.changed));
        Console.WriteLine("same index others drained " + Program.Closed(replacedListen));
    }
}
