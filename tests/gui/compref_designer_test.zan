using System;
using System.Json;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
#if !GUI_SCOPED_COMPONENTS
using Gui.Designer;

class CompRefClickProbe {
    public int clicks;
    public void OnClick(Control sender) { clicks = clicks + 1; }
}
#endif

class CompRefDesignerTest {
    static int fails;

    static void Ok(string what, bool cond) {
        if (cond) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void TraceTree(Control root, string indent) {
        Console.WriteLine(indent + root.Kind() + " #" + root.name);
        for (int i = 0; i < root.ChildCount(); i = i + 1) {
            TraceTree(root.ChildAt(i), indent + "  ");
        }
    }

    static string CompDoc() {
        return "{\n"
            + "  \"name\": \"BadgeCard\",\n"
            + "  \"role\": \"control\",\n"
            + "  \"winW\": 260,\n"
            + "  \"winH\": 120,\n"
            + "  \"layoutMode\": 0,\n"
            + "  \"props\": [\n"
            + "    {\n"
            + "      \"key\": \"btnText\",\n"
            + "      \"label\": \"按钮文字\",\n"
            + "      \"kind\": \"text\",\n"
            + "      \"target\": \"InnerBtn\",\n"
            + "      \"prop\": \"text\",\n"
            + "      \"def\": \"Go\"\n"
            + "    }\n"
            + "  ],\n"
            + "  \"fields\": [\n"
            + "    {\n"
            + "      \"kind\": \"Label\",\n"
            + "      \"label\": \"inner title\",\n"
            + "      \"name\": \"InnerTitle\",\n"
            + "      \"span\": 24,\n"
            + "      \"options\": [],\n"
            + "      \"style\": \"position:absolute;left:16px;top:12px;width:200px;height:24px\"\n"
            + "    },\n"
            + "    {\n"
            + "      \"kind\": \"Button\",\n"
            + "      \"label\": \"Go\",\n"
            + "      \"name\": \"InnerBtn\",\n"
            + "      \"span\": 24,\n"
            + "      \"options\": [],\n"
            + "      \"style\": \"position:absolute;left:16px;top:48px;width:120px;height:28px\"\n"
            + "    }\n"
            + "  ]\n"
            + "}";
    }

    static Control CreateScopedChild(string kind) {
        if (kind == "Button") { return new Button(); }
        return null;
    }

    static Control CreateScoped(string kind) {
        if (kind.ToLower() == "badgecard") {
            return UserComponentRegistry.BuildWith(kind, CreateScoped);
        }
        return CreateScopedChild(kind);
    }

    static void TestScopedComponents() {
        UserComponentRegistry.RegisterDefinition("BadgeCard", CompDoc());
        Ok("component definition leaves the global factory unregistered", !ControlFactory.Has("BadgeCard"));

        Control direct = UserComponentRegistry.BuildWith("BadgeCard", CreateScopedChild);
        Ok("direct scoped component uses its widget factory", direct != null && direct.Find("InnerBtn") is Button);
        Ok("omitted scoped widget is an Element", direct != null && direct.Find("InnerTitle") is Element);
        if (direct != null) {
            direct.SetProp("btnText", "Direct value");
            Control directClone = Html.Clone(direct);
            Ok("direct scoped clone rebuilds its supplied widget",
                directClone != null && directClone != direct && directClone.Find("InnerBtn") is Button);
            Ok("direct scoped clone keeps omitted widget as Element",
                directClone != null && directClone.Find("InnerTitle") is Element);
            Eq("direct scoped clone preserves instance property",
                directClone == null ? "" : directClone.GetProp("btnText"), "Direct value");
        }

        App markupApp = App.CreateOffscreen("scoped component markup", 320, 200);
        Control scoped = Html.LoadWith(markupApp, "<BadgeCard id='scoped-card' btnText='Scoped value'></BadgeCard>",
            null, "", CreateScoped);
        Control card = scoped == null ? null : scoped.Find("scoped-card");
        Control clone = card == null ? null : Html.Clone(card);
        Ok("HTML scoped clone rebuilds its supplied widget", clone != null && clone.Find("InnerBtn") is Button);
        Eq("HTML scoped clone preserves instance property", clone == null ? "" : clone.GetProp("btnText"), "Scoped value");
        markupApp.canvas.Destroy();
    }

    static void Main() {
        fails = 0;
        TestScopedComponents();
#if GUI_SCOPED_COMPONENTS
        if (fails == 0) { Console.WriteLine("GUI_SCOPED_COMPONENTS_OK"); }
#else
        // 控件重建走 ControlFactory→HeavyControls 注册表（拉入收编后
        // 标准控件不再内联构造分支），先装注册表再动设计器。

        Designer d = new Designer();
        List<UserComponent> comps = new List<UserComponent>();
        comps.Add(new UserComponent("BadgeCard", CompDoc()));
        d.SetUserComponents(comps);

        d.AddUserComponent(0);
        FormField f = d.sel;
        Ok("ref node selected", f != null);
        if (f == null) { Console.WriteLine("CD_FAIL"); return; }
        Eq("ref kind", f.customKind, "BadgeCard");
        Ok("ref flagged", f.compRef);
        Eq("ref default w", Convert.ToString(f.fw), "260");
        Eq("ref default h", Convert.ToString(f.fh), "120");
        Eq("one top-level field", Convert.ToString(d.fields.Count), "1");

        string saved = d.SaveJson();
        JsonValue doc = JsonValue.ParseLenient(saved);
        JsonValue fs = doc.Get("fields");
        Ok("saved fields", fs != null && fs.Count() == 1);
        JsonValue f0 = fs.At(0);
        Eq("saved ref key", f0.Str("ref", ""), "BadgeCard");
        Ok("saved ref has no inlined kids", !f0.Has("kids"));

        d.LoadJson(saved);
        Ok("reload clean", !d.loadError);
        Ok("reloaded a ref", d.fields[0].compRef);
        Eq("reloaded ref name", d.fields[0].customKind, "BadgeCard");
        string again = d.SaveJson();
        JsonValue doc2 = JsonValue.ParseLenient(again);
        JsonValue fs2 = doc2.Get("fields");
        Ok("round trip fields", fs2 != null && fs2.Count() == 1);
        Eq("ref survives round trip",
            fs2 == null ? "" : fs2.At(0).Str("ref", ""), "BadgeCard");

        App editor = App.CreateOffscreen("component preview host", 640, 480);
        Ok("document preview prepared", d.PrepareDesignPreview(editor));
        Control pv = d.pvDocRoot;
        Ok("preview built", pv != null);
        if (pv != null) {
            Control title = pv.Find("InnerTitle");
            if (title == null) { Console.WriteLine(d.SaveHtml()); TraceTree(pv, ""); }
            Ok("preview label", title != null && title.GetProp("text") == "inner title");
            Ok("preview button", pv.Find("InnerBtn") != null);
            Control pb = pv.Find("InnerBtn");
            Eq("preview default prop", pb == null ? "" : pb.GetProp("text"), "Go");
        }

        d.EnsureCompPropDecls("BadgeCard");
        Eq("decl count", Convert.ToString(d.compPropDecls.Count), "1");
        Eq("decl key", d.compPropDecls.Count == 1 ? d.compPropDecls[0].key : "", "btnText");
        Eq("decl default", d.compPropDecls.Count == 1 ? d.compPropDecls[0].def : "", "Go");

        d.SetCompPropValue(d.fields[0], "btnText", "HEY!");
        d.MarkDocDirty();
        Ok("instance props preview prepared", d.PrepareDesignPreview(editor));
        Control pv2 = d.pvDocRoot;
        Ok("preview rebuilt for new props", pv2 != null);
        if (pv2 != null) {
            Control pb2 = pv2.Find("InnerBtn");
            Eq("preview instance prop", pb2 == null ? "" : pb2.GetProp("text"), "HEY!");
        }

        string pSaved = d.SaveJson();
        Ok("props serialized", pSaved.Contains("\"btnText\"")
            && pSaved.Contains("HEY!"));
        d.LoadJson(pSaved);
        Ok("reload clean with props", !d.loadError);
        Eq("props reload",
            d.CompPropValue(d.fields[0], "btnText", "<def>"), "HEY!");
        Ok("reloaded document preview prepared", d.PrepareDesignPreview(editor));
        Control pv3 = d.pvDocRoot;
        if (pv3 != null) {
            Control pb3 = pv3.Find("InnerBtn");
            Eq("preview after reload", pb3 == null ? "" : pb3.GetProp("text"), "HEY!");
        } else { Ok("preview after reload built", false); }

        Control liveButton = pv3 != null ? pv3.Find("InnerBtn") : null;
        if (liveButton != null) {
            CompRefClickProbe probe = new CompRefClickProbe();
            liveButton.BindEvent("Click", probe.OnClick);
            int x = liveButton.bx + liveButton.bw / 2;
            int y = liveButton.by + liveButton.bh / 2;
            d.pvDocForm.ProcessOffscreenInput(2, x, y, 0, 0, 0, 0);
            d.pvDocForm.ProcessOffscreenInput(3, x, y, 0, 0, 0, 0);
            d.RenderDesignPreview();
            d.RenderDesignPreview();
            Ok("component click routed once across snapshots", probe.clicks == 1);
        } else { Ok("component click target exists", false); }

        d.UnpackUserComponent(d.fields[0]);
        Ok("unpack replaced the ref", !d.fields[0].compRef);
        Eq("unpack head label", d.fields[0].label, "BadgeCard");
        Eq("unpack head kids", Convert.ToString(d.fields[0].kids.Count), "2");
        Ok("unpack kept the name", d.fields[0].fname == d.fields[0].name
            && d.fields[0].fname.Length > 0);
        JsonValue doc3 = JsonValue.ParseLenient(d.SaveJson());
        JsonValue fs3 = doc3.Get("fields");
        Ok("unpacked design has no ref",
            fs3 == null || fs3.At(0).Str("ref", "") == "");

        Ok("no open request initially", d.ConsumeOpenComponent() == "");
        d.openCompRequested = true;
        d.openCompName = "BadgeCard";
        Eq("consume open component", d.ConsumeOpenComponent(), "BadgeCard");
        Ok("consume is one-shot", d.ConsumeOpenComponent() == "");

        UserComponentRegistry.SetAll(comps);
        Control rt = UserComponentRegistry.Build("BadgeCard");
        Ok("registry built", rt != null);
        if (rt != null) {
            Control rb = rt.Find("InnerBtn");
            Eq("registry default prop", rb == null ? "" : rb.GetProp("text"), "Go");
        }
        JsonValue inst = JsonValue.ParseLenient("{\"btnText\":\"DYN!\"}");
        Control rt2 = UserComponentRegistry.Build("BadgeCard", inst);
        Ok("registry built with instance", rt2 != null);
        if (rt2 != null) {
            Control rb2 = rt2.Find("InnerBtn");
            Eq("registry instance prop",
                rb2 == null ? "" : rb2.GetProp("text"), "DYN!");
        }
        Ok("unknown component is null",
            UserComponentRegistry.Build("Nope") == null);
        Control code = ControlFactory.Create("BadgeCard");
        Ok("registered component uses the shared factory", code != null && code.Find("InnerBtn") is Button);
        if (code != null) {
            code.SetProp("btnText", "Code value");
            Control codeButton = code.Find("InnerBtn");
            Eq("factory property uses shared setter", codeButton == null ? "" : codeButton.GetProp("text"), "Code value");
            Eq("factory property reads the target", code.GetProp("btnText"), "Code value");
        }
        App markupApp = App.CreateOffscreen("component markup", 320, 200);
        Control markup = Html.Load(markupApp, "<BadgeCard btnText=\"Markup value\"></BadgeCard>");
        Ok("HTML component builds the same widget kind", markup != null && markup.Find("InnerBtn") is Button);
        if (markup != null) {
            Control markupButton = markup.Find("InnerBtn");
            Eq("HTML instance property uses shared setter",
                markupButton == null ? "" : markupButton.GetProp("text"), "Markup value");
        }
        markupApp.canvas.Destroy();
        UserComponentRegistry.Register("BadgeCard", CompDoc().Replace("\"Go\"", "\"Reloaded\""));
        Control reloaded = ControlFactory.Create("BadgeCard");
        Control reloadedButton = reloaded == null ? null : reloaded.Find("InnerBtn");
        Ok("factory resolves the current definition", reloadedButton != null
            && reloadedButton.GetProp("text") == "Reloaded");
        if (code != null) {
            Eq("registry reload keeps existing instance values", code.GetProp("btnText"), "Code value");
        }
        UserComponentRegistry.SetAll(new List<UserComponent>());
        Ok("removed component factory does not retain its definition", ControlFactory.Create("BadgeCard") == null);
        UserComponentRegistry.Register("LoopCard", "<body><LoopCard></LoopCard></body>");
        bool cycle = false;
        try { UserComponentRegistry.Build("LoopCard"); }
        catch (InvalidOperationException error) { cycle = true; }
        Ok("circular component reference fails explicitly", cycle);
        UserComponentRegistry.SetAll(comps);
        Ok("preview and registry agree",
            UserComponentRegistry.JsonOf("BadgeCard") == CompDoc());

        FormField rf = new FormField(23);
        Designer.SetCompPropValue(rf, "alpha", "A");
        Designer.SetCompPropValue(rf, "beta", "B");
        Ok("rename onto existing refused",
            !Designer.RenameCompProp(rf, "alpha", "beta"));
        Eq("beta value preserved", Designer.CompPropValue(rf, "beta", ""), "B");
        Eq("alpha value preserved", Designer.CompPropValue(rf, "alpha", ""), "A");
        Ok("free rename ok", Designer.RenameCompProp(rf, "alpha", "gamma"));
        Eq("gamma carries the value",
            Designer.CompPropValue(rf, "gamma", ""), "A");
        Ok("alpha removed by rename", !Designer.HasCompProp(rf, "alpha"));
        Ok("renaming a missing key refused",
            !Designer.RenameCompProp(rf, "alpha", "delta"));
        Ok("same-name rename refused",
            !Designer.RenameCompProp(rf, "gamma", "gamma"));

        FormField rowf = new FormField(23);
        d.LoadRowScratch(rowf, 0);
        d.rowEdTitle = "";
        d.rowEdField = "";
        Eq("cleared row joins empty", d.JoinRowOption(rowf), "");

        d.DisposeDesignPreview();
        d.propGrid.BeforeChange = null;
        d.propGrid.Change.Clear();
        editor.canvas.Destroy();
        UserComponentRegistry.SetAll(new List<UserComponent>());
        if (fails == 0) { Console.WriteLine("COMPREF_DESIGNER_OK"); }
#endif
    }
}
