using System;
using System.Json;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Designer;

/// Headless acceptance for saved user components as *references* in the
/// form designer: dropping a component places one ref node (no inlined
/// copy), the .zform round-trips {"kind":X,"ref":X}, the canvas preview
/// builds the component's real widget tree via FormBuilder, and "unpack"
/// splices an independent inline copy back in.
class CompRefDesignerTest {
    static int fails;

    static void Ok(string what, bool cond) {
        if (cond) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static string CompDoc() {
        return "{\"name\":\"BadgeCard\",\"role\":\"control\","
            + "\"winW\":260,\"winH\":120,\"layoutMode\":0,"
            + "\"props\":[{\"key\":\"btnText\",\"label\":\"按钮文字\","
            + "\"kind\":\"text\",\"target\":\"InnerBtn\",\"prop\":\"text\","
            + "\"def\":\"Go\"}],"
            + "\"fields\":["
            + "{\"kind\":\"Label\",\"label\":\"inner title\",\"name\":\"InnerTitle\","
            + "\"span\":24,\"fx\":16,\"fy\":12,\"fw\":200,\"fh\":24,\"options\":[]},"
            + "{\"kind\":\"Button\",\"label\":\"Go\",\"name\":\"InnerBtn\","
            + "\"span\":24,\"fx\":16,\"fy\":48,\"fw\":120,\"fh\":28,\"options\":[]}"
            + "]}";
    }

    static void Main() {
        fails = 0;

        // 控件重建走 ControlFactory→HeavyControls 注册表（拉入收编后
        // 标准控件不再内联构造分支），先装注册表再动设计器。
        ControlBootstrap.Install();

        Designer d = new Designer();
        List<UserComponent> comps = new List<UserComponent>();
        comps.Add(new UserComponent("BadgeCard", CompDoc()));
        d.SetUserComponents(comps);

        // ---- drop = one reference node, sized from the component doc ----
        d.AddUserComponent(0);
        FormField f = d.sel;
        Ok("ref node selected", f != null);
        if (f == null) { Console.WriteLine("CD_FAIL"); return; }
        Eq("ref kind", f.customKind, "BadgeCard");
        Ok("ref flagged", f.compRef);
        Eq("ref default w", Convert.ToString(f.fw), "260");
        Eq("ref default h", Convert.ToString(f.fh), "120");
        Eq("one top-level field", Convert.ToString(d.fields.Count), "1");

        // The saved design carries the ref, not the inlined tree.
        string saved = d.SaveJson();
        JsonValue doc = JsonValue.ParseLenient(saved);
        JsonValue fs = doc.Get("fields");
        Ok("saved fields", fs != null && fs.Count() == 1);
        JsonValue f0 = fs.At(0);
        Eq("saved ref key", f0.Str("ref", ""), "BadgeCard");
        Ok("saved ref has no inlined kids", !f0.Has("kids"));

        // ---- the ref round-trips through Load/Save ----
        d.LoadJson(saved);
        Ok("reload clean", !d.loadError);
        Ok("reloaded a ref", d.fields[0].compRef);
        Eq("reloaded ref name", d.fields[0].customKind, "BadgeCard");
        string again = d.SaveJson();
        JsonValue doc2 = JsonValue.ParseLenient(again);
        JsonValue fs2 = doc2.Get("fields");
        Ok("round trip fields", fs2 != null && fs2.Count() == 1);
        Eq("ref survives round trip",
            fs2 == null ? "" : fs2.At(0).Str("ref", ""), "BadgeCard");

        // ---- canvas preview builds the component's real widgets ----
        Control pv = d.PvCompCtl(d.fields[0], 260, 120);
        Ok("preview built", pv != null);
        if (pv != null) {
            // Flow docs build into a docked flow container; the component's
            // widgets live inside. Label text syncs the node name, so the
            // label is findable by caption, the button by design name.
            Ok("preview label", pv.Find("inner title") != null);
            Ok("preview button", pv.Find("InnerBtn") != null);
            // Declared prop with no instance value: the default applies.
            Control pb = pv.Find("InnerBtn");
            Eq("preview default prop", pb == null ? "" : pb.GetProp("text"), "Go");
        }

        // ---- declared props: schema, instance values, serialization ----
        d.EnsureCompPropDecls("BadgeCard");
        Eq("decl count", Convert.ToString(d.compPropKeys.Count), "1");
        Eq("decl key", d.compPropKeys.Count == 1 ? d.compPropKeys[0] : "", "btnText");
        Eq("decl default", d.compPropDefs.Count == 1 ? d.compPropDefs[0] : "", "Go");

        // Writing an instance value refreshes the preview (cache key folds
        // the instance props in) and lands it on the target control.
        d.SetCompPropValue(d.fields[0], "btnText", "HEY!");
        Control pv2 = d.PvCompCtl(d.fields[0], 260, 120);
        Ok("preview rebuilt for new props", pv2 != null);
        if (pv2 != null) {
            Control pb2 = pv2.Find("InnerBtn");
            Eq("preview instance prop", pb2 == null ? "" : pb2.GetProp("text"), "HEY!");
        }

        // The instance value round-trips through Save/Load via the
        // unmodeled "props" passthrough on the ref node.
        string pSaved = d.SaveJson();
        Ok("props serialized", pSaved.Contains("\"btnText\"")
            && pSaved.Contains("HEY!"));
        d.LoadJson(pSaved);
        Ok("reload clean with props", !d.loadError);
        Eq("props reload",
            d.CompPropValue(d.fields[0], "btnText", "<def>"), "HEY!");
        Control pv3 = d.PvCompCtl(d.fields[0], 260, 120);
        if (pv3 != null) {
            Control pb3 = pv3.Find("InnerBtn");
            Eq("preview after reload", pb3 == null ? "" : pb3.GetProp("text"), "HEY!");
        } else { Ok("preview after reload built", false); }

        // Preview off -> the designer falls back to the placeholder chip.
        d.fields[0].pvPreview = false;
        // (placeholder path draws via canvas; nothing to assert headlessly
        // beyond the flag round-tripping)
        d.fields[0].pvPreview = true;

        // ---- unpack splices an independent inline copy ----
        d.UnpackUserComponent(d.fields[0]);
        Ok("unpack replaced the ref", !d.fields[0].compRef);
        Eq("unpack head label", d.fields[0].label, "BadgeCard");
        Eq("unpack head kids", Convert.ToString(d.fields[0].kids.Count), "2");
        Ok("unpack kept the name", d.fields[0].fname == d.fields[0].name
            && d.fields[0].fname.Length > 0);
        JsonValue doc3 = JsonValue.ParseLenient(d.SaveJson());
        JsonValue fs3 = doc3.Get("fields");
        Ok("unpacked design has no ref",
            fs3 == null || fs3.At(0).Str("ref", "") == "");

        // ---- double-click open request: one-shot, names the component ----
        Ok("no open request initially", d.ConsumeOpenComponent() == "");
        d.openCompRequested = true;
        d.openCompName = "BadgeCard";
        Eq("consume open component", d.ConsumeOpenComponent(), "BadgeCard");
        Ok("consume is one-shot", d.ConsumeOpenComponent() == "");

        // ---- runtime registry: instantiate without compile-time refs ----
        UserComponentRegistry.SetAll(comps);
        Control rt = UserComponentRegistry.Build("BadgeCard");
        Ok("registry built", rt != null);
        if (rt != null) {
            Control rb = rt.Find("InnerBtn");
            Eq("registry default prop", rb == null ? "" : rb.GetProp("text"), "Go");
        }
        JsonValue inst = JsonValue.ParseLenient("{\"btnText\":\"DYN!\"}");
        Control rt2 = UserComponentRegistry.Build("BadgeCard", inst);
        Ok("registry built with instance", rt2 != null);
        if (rt2 != null) {
            Control rb2 = rt2.Find("InnerBtn");
            Eq("registry instance prop",
                rb2 == null ? "" : rb2.GetProp("text"), "DYN!");
        }
        Ok("unknown component is null",
            UserComponentRegistry.Build("Nope") == null);
        Ok("preview and registry agree",
            UserComponentRegistry.JsonOf("BadgeCard") == CompDoc());

        // ---- rename conflict guard: renaming onto an existing key must be
        // refused — the old Drop+Set body silently overwrote the target's
        // value (data loss read as a successful rename).
        FormField rf = new FormField(23);
        Designer.SetCompPropValue(rf, "alpha", "A");
        Designer.SetCompPropValue(rf, "beta", "B");
        Ok("rename onto existing refused",
            !Designer.RenameCompProp(rf, "alpha", "beta"));
        Eq("beta value preserved", Designer.CompPropValue(rf, "beta", ""), "B");
        Eq("alpha value preserved", Designer.CompPropValue(rf, "alpha", ""), "A");
        Ok("free rename ok", Designer.RenameCompProp(rf, "alpha", "gamma"));
        Eq("gamma carries the value",
            Designer.CompPropValue(rf, "gamma", ""), "A");
        Ok("alpha removed by rename", !Designer.HasCompProp(rf, "alpha"));
        Ok("renaming a missing key refused",
            !Designer.RenameCompProp(rf, "alpha", "delta"));
        Ok("same-name rename refused",
            !Designer.RenameCompProp(rf, "gamma", "gamma"));

        // ---- row editor: cleared scratch fields join to "" — the frame
        // write-back now lands the empty string instead of silently keeping
        // the stale option text (clearing is an edit, deletion is the
        // toolbar's delete button).
        FormField rowf = new FormField(23);
        d.LoadRowScratch(rowf, 0);
        d.rowEdTitle = "";
        d.rowEdField = "";
        Eq("cleared row joins empty", d.JoinRowOption(rowf), "");

        if (fails == 0) { Console.WriteLine("COMPREF_DESIGNER_OK"); }
    }
}
