using System;
using Gui.Backend;

class CapiPlatformTest {
    static void Check(string name, bool ok) {
        if (!ok) { throw new Exception("CAPI platform: " + name); }
    }

    #if (LINUX && !ANDROID && !OHOS) || MACOS
    static void AwaitSize(CapiPlatform platform, nint window, int w, int h) {
        for (int i = 0; i < 200; i = i + 1) {
            if (platform.ClientWidth(window) == w && platform.ClientHeight(window) == h) {
                return;
            }
            platform.WaitEventTimeout(10);
        }
        Check("device client size", false);
    }
    #endif

    static void Main() {
        #if (LINUX && !ANDROID && !OHOS) || MACOS
        CapiPlatform platform = new CapiPlatform();
        nint first = platform.CreateWindow("Capi first", 240, 160);
        nint second = platform.CreateWindow("Capi second", 260, 180);
        Check("separate windows", first != 0 && second != 0 && first != second);
        platform.ShowWindow(first);
        platform.ShowWindow(second);
        int peerW = platform.ClientWidth(second);
        int peerH = platform.ClientHeight(second);
        platform.ResizeClient(first, 321, 239);
        AwaitSize(platform, first, 321, 239);
        Check("peer size isolated", platform.ClientWidth(second) == peerW
        && platform.ClientHeight(second) == peerH);
        platform.ResizeClientExact(second, 483, 361);
        AwaitSize(platform, second, 483, 361);
        Check("first size isolated", platform.ClientWidth(first) == 321
        && platform.ClientHeight(first) == 239);
        platform.SetPosition(first, 30, 40);
        platform.ImeSetCaret(20, 30);
        platform.ImeSetOpen(true);
        Check("system composition UI", platform.ImeComposing() == "");
        Check("no pending drop", !platform.DropPending());
        Check("empty drop batch", platform.TakeDroppedFiles().Count == 0);
        Check("desktop keyboard", platform.KeyboardHeight() == 0);
        Check("unsupported notification", platform.NotificationSend("title", "body", "", 0, "") == -1);
        Check("unknown network", platform.NetworkType() == -1);
        Check("unsupported permission", platform.PermissionCheck(0) == -1);
        Check("target identity", platform.DeviceInfoGet(3) == OperatingSystem.Platform);
        Check("no biometric authentication", !platform.BiometricsCanAuthenticate()
        && !platform.BiometricsAuthenticate("test", ""));
        platform.ImeSetOpen(false);
        platform.Destroy(second);
        platform.Destroy(first);
        Console.WriteLine("CAPI_PLATFORM_OK");
        #endif
    }
}
