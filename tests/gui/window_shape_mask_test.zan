using System;
using Gui;

class WindowShapeMaskTest {
    static void Check(string name, bool ok) {
        if (!ok) {
            Console.WriteLine("FAIL shape mask: " + name);
            throw new Exception("shape mask: " + name);
        }
    }

    static void CoverageAndAlpha() {
        WindowShapeMask mask = new WindowShapeMask();
        List<WindowShapeRegion> regions = new List<WindowShapeRegion>();
        regions.Add(new WindowShapeRegion(3, 0, 0, 32, 16, 4));
        regions.Add(new WindowShapeRegion(1, 2, 2, 8, 8, 0));
        regions.Add(new WindowShapeRegion(1, 20, 2, 8, 8, 0));
        byte[] first = mask.Coverage(32, 16, 100, regions);
        Check("square interior full coverage", first[6 * 32 + 6] == 255);
        Check("second region participates", first[6 * 32 + 24] == 255);
        Check("shadow band is not an entity", first[15 * 32 + 15] == 0);
        Check("stable cache", first == mask.Coverage(32, 16, 100, regions));
        byte[] scaled = mask.Coverage(48, 24, 150, regions);
        Check("DPI coverage", scaled[9 * 48 + 9] == 255);
        Check("size and DPI invalidate", first != scaled);
        byte[] dpiOnly = mask.Coverage(32, 16, 150, regions);
        Check("DPI alone invalidates", dpiOnly != mask.Coverage(32, 16, 100, regions));
        byte[] beforeRadius = mask.Coverage(32, 16, 100, regions);
        regions[1].radius = 4;
        byte[] rounded = mask.Coverage(32, 16, 100, regions);
        Check("in place radius invalidates", rounded != beforeRadius);
        Check("round corner clipped", rounded[2 * 32 + 2] < 128);
        regions[1].kind = 2;
        byte[] ellipse = mask.Coverage(32, 16, 100, regions);
        Check("ellipse center", ellipse[6 * 32 + 6] == 255);
        Check("ellipse corner", ellipse[2 * 32 + 2] < 128);
        Check("partial straight alpha", WindowShapeMask.SnapshotStraightArgb(0x80FF0000, 128, false) == 0x40FF0000);
        Check("partial premultiplied alpha", WindowShapeMask.LayeredArgb(0x80FF0000, 128, false) == 0x40400000);
        Check("transparent edge", WindowShapeMask.LayeredArgb(0x00FF0000, 128, false) == 0);
        Check("shadow threshold retained", WindowShapeMask.SnapshotStraightArgb(0xEF102030, 0, true) == 0xEF102030);
        Check("opaque outside clipped", WindowShapeMask.SnapshotStraightArgb(0xF0102030, 0, true) == 0);
        Check("unmarked shadow clipped", WindowShapeMask.SnapshotStraightArgb(0x01102030, 0, false) == 0);
    }

    static void Snapshot(int backend) {
        Canvas.SetBackend(backend);
        Canvas source = new Canvas(32, 24);
        Canvas result = new Canvas(32, 24);
        List<WindowShapeRegion> regions = new List<WindowShapeRegion>();
        regions.Add(new WindowShapeRegion(1, 4, 4, 24, 16, 6));
        WindowShapeMask mask = new WindowShapeMask();
        string key = "mem:window-shape-test";
        source.Clear(0xFF304050);
        Check("snapshot registered", source.SnapshotWindowShape(key, mask, regions, 100));
        result.Clear(0xFF000000);
        result.BlitImage(key, 0, 0, 32, 24, 0, 0, 32, 24);
        Check("outside transparent", result.GetPixel(0, 0) == 0xFF000000);
        Check("inside preserved", result.GetPixel(16, 12) == 0xFF304050);
        for (int y = 0; y < 24; y = y + 1) {
            for (int x = 0; x < 32; x = x + 1) {
                Check("snapshot does not mutate surface", source.GetPixel(x, y) == 0xFF304050);
            }
        }
        source.Clear(0xFF506070);
        Check("snapshot replaces stable key", source.SnapshotWindowShape(key, mask, regions, 100));
        result.Clear(0xFF000000);
        result.BlitImage(key, 0, 0, 32, 24, 0, 0, 32, 24);
        Check("new frame visible", result.GetPixel(16, 12) == 0xFF506070);
        regions.Clear();
        Check("empty shape rejected", !source.SnapshotWindowShape(key, mask, regions, 100));
        Check("rectangular opacity", source.SnapshotWindowShape(key, mask, regions, 100, 50));
        result.Clear(0xFF000000);
        result.BlitImage(key, 0, 0, 32, 24, 0, 0, 32, 24);
        Canvas transparent = new Canvas(32, 24);
        Canvas reference = new Canvas(32, 24);
        transparent.Clear(0x7F506070);
        reference.Clear(0xFF000000);
        reference.BlitSurfaceScaled(transparent, 0, 0, 32, 24, 0, 0, 32, 24);
        Check("constant opacity rounding", result.GetPixel(16, 12) == reference.GetPixel(16, 12));
        Check("opacity preserves source", source.GetPixel(16, 12) == 0xFF506070);
        transparent.Destroy();
        reference.Destroy();
        Canvas.EvictImage(key);
        source.Destroy();
        result.Destroy();
    }

    static void Main() {
        CoverageAndAlpha();
        Snapshot(RenderBackend.Cpu());
        Snapshot(RenderBackend.Gpu());
        Console.WriteLine("WINDOW_SHAPE_MASK_OK");
    }
}
