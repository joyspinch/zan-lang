using System;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;

// 接口数据协议与执行契约。
class GridRow {
    string name;
    int clicks;
    double spend;
    bool active;

    GridRow() {
        name = "";
        clicks = 0;
        spend = 0.0;
        active = false;
    }
}

// 接口数据协议与执行契约。
partial class ZfGrid {
    void OnInit() {
    }
}

// 接口数据协议与执行契约。
class ZformGridTest {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" +
                          want + "'");
    }

    static void Main() {
        fails = 0;
        ZfGrid p = new ZfGrid();

        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        DataGrid<GridRow> g = p.Grid;

        // 接口数据协议与执行契约。
        ZformGridTest.Eq("columns", g.GetProp("previewColumns"),
                         "220,名称|80,点击|100,花费|70,在投");

        // 接口数据协议与执行契约。
        ZformGridTest.Eq("striped", g.GetProp("striped"), "true");
        ZformGridTest.Eq("rowHeight", g.GetProp("rowHeight"), "22");
        ZformGridTest.Eq("summary", g.GetProp("summary"), "true");
        ZformGridTest.Eq("allowAddRow", g.GetProp("allowAddRow"), "true");

        // 接口数据协议与执行契约。
        List<GridRow> rows = new List<GridRow>();
        GridRow a = new GridRow();
        a.name = "计划A";
        a.clicks = 3;
        a.spend = 12.5;
        a.active = true;
        rows.Add(a);
        GridRow b = new GridRow();
        b.name = "计划B";
        b.clicks = 4;
        rows.Add(b);
        g.Bind(rows);
        ZformGridTest.Eq("count", Convert.ToString(g.Count()), "2");

        GridSource<GridRow> src = g.source;
        ZformGridTest.Eq("cell text", src.CellText(0, 0), "计划A");
        ZformGridTest.Eq("cell num", src.CellText(1, 1), "4");
        ZformGridTest.Eq("cell real", src.CellText(0, 2), "12.50");
        ZformGridTest.Eq("cell bool", src.CellText(0, 3), "true");
        ZformGridTest.Eq("cell bool off", src.CellText(1, 3), "false");

        // 接口数据协议与执行契约。
        src.SetCell(0, 0, "改名");
        ZformGridTest.Eq("edit text", a.name, "改名");
        src.SetCell(1, 1, "9");
        ZformGridTest.Eq("edit num", Convert.ToString(b.clicks), "9");
        // 接口数据协议与执行契约。
        src.SetCell(0, 2, "99.99");
        ZformGridTest.Eq("readonly real", src.CellText(0, 2), "12.50");

        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        g.HideCol("clicks", true);
        if (!g.State().colHidden[1]) {
            fails = fails + 1;
            Console.WriteLine("FAIL HideCol did not hide the clicks column");
        }
        g.HideCol("clicks", false);
        if (g.State().colHidden[1]) {
            fails = fails + 1;
            Console.WriteLine("FAIL HideCol did not restore the clicks column");
        }
        g.HideCol("missing", true);

        // 核心契约与语义定义。
        if (!src.CanInsert()) {
            fails = fails + 1;
            Console.WriteLine("FAIL rowFactory did not reach the source");
        }
        src.InsertRow(2);
        ZformGridTest.Eq("insert", Convert.ToString(rows.Count), "3");

        if (fails == 0) { Console.WriteLine("ZFORM_GRID_OK"); }
    }
}
