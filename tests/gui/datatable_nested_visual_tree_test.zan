using System;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;

class NestedTreeTestItem {
    public string name;
    public bool active;
    public NestedTreeTestItem(string n, bool a) {
        this.name = n;
        this.active = a;
    }
}

public class DataTableNestedVisualTreeTest {
    public static void Main() {
        App app = App.CreateDark("Nested Tree Test", 1024, 768);

        // 1. 验证 DataGrid 宿主子控件树挂载
        DataGrid<NestedTreeTestItem> grid = new DataGrid<NestedTreeTestItem>();
        List<NestedTreeTestItem> items = new List<NestedTreeTestItem>();
        items.Add(new NestedTreeTestItem("Item1", true));
        items.Add(new NestedTreeTestItem("Item2", false));
        grid.Bind(items);
        grid.Col("Name", 120, u => u.name);

        // 创建自定义真控件行明细
        Panel detailPanel = Panel.Root("detail_panel");
        Button detailBtn = new Button("Detail Action");
        detailPanel.With(detailBtn);

        grid.State().detail = new ControlDetailProvider((a, src, r) => detailPanel, 4);
        grid.State().expandedRows.Add(0); // 展开第 0 行

        // 布局 DataGrid
        grid.Arrange(10, 10, 600, 400);
        grid.OnPaint(app);

        // 验证 detailPanel 已被挂载到 grid 的视觉子树
        if (grid.children == null || grid.children.Count == 0) {
            Console.WriteLine("FAIL: children not populated");
            return;
        }

        bool foundDetail = false;
        for (int i = 0; i < grid.children.Count; i = i + 1) {
            if (grid.children[i] == detailPanel) {
                foundDetail = true;
                break;
            }
        }
        if (!foundDetail) {
            Console.WriteLine("FAIL: detailPanel not found in grid.children");
            return;
        }

        // 验证 parent 拓扑引用链路
        if (detailPanel.Parent() != grid) {
            Console.WriteLine("FAIL: detailPanel.parent != grid");
            return;
        }

        // 2. 验证 Visual Tree 空间命中测试穿透
        int targetX = detailBtn.bx + 2;
        int targetY = detailBtn.by + 2;
        Control hit = grid.HitTest(targetX, targetY);
        if (hit != detailBtn) {
            Console.WriteLine("FAIL: HitTest did not reach detailBtn");
            return;
        }

        // 3. 验证事件双向路由分发（从子控件向父网格冒泡）
        bool btnClicked = false;
        bool gridSawBubble = false;

        detailBtn.OnRouted((Control sender, RoutedEventArgs e) => {
            if (e.eventName == "click") {
                btnClicked = true;
            }
        });

        grid.OnRouted((Control sender, RoutedEventArgs e) => {
            if (e.eventName == "click") {
                gridSawBubble = true;
            }
        });

        RoutedEventArgs evt = new RoutedEventArgs("click", hit);
        evt.x = targetX;
        evt.y = targetY;

        Control.RouteEvent(hit, evt);

        if (!btnClicked) {
            Console.WriteLine("FAIL: detailBtn did not receive click");
            return;
        }
        if (!gridSawBubble) {
            Console.WriteLine("FAIL: grid did not see bubbling click from detailBtn");
            return;
        }

        Console.WriteLine("ALL NESTED VISUAL TREE TESTS PASSED.");
    }
}
