using System;
using Gui;
using Gui.Widget;

partial class DesignLabelName {
    static void OnLoad(Form form) { }
}

class DesignLabelNameTest {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got
            + "' want '" + want + "'");
    }

    static void Main() {
        // 回归：Label 的 text 规格带 syncName，GenForm 曾把 SetProp("text")
        // 发射在 .name 之后——带文本的设计 label 的字段名被标题文本整个
        // 覆盖，Find/探针/生成字段三者失联（空 label 不受影响，所以
        // 只在真实页面塌)。属性发射完毕后必须把 name 拨回字段名。
        Control root = DesignLabelName.__BuildForm();
        Eq("Named.name", DesignLabelName.Named.name, "Named");
        Eq("Empty.name", DesignLabelName.Empty.name, "Empty");
        Eq("Okay.name", DesignLabelName.Okay.name, "Okay");
        Eq("Named.text", DesignLabelName.Named.Str(), "你好");
        Eq("Named.find", root.Find("Named") == null ? "miss" : "hit", "hit");
        Eq("Empty.find", root.Find("Empty") == null ? "miss" : "hit", "hit");
        if (fails == 0) { Console.WriteLine("design label name OK"); }
    }
}
