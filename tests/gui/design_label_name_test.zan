using System;
using System.IO;
using System.Web;
using Gui;
using Gui.Widget;

class DesignLabelNameTest {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got
            + "' want '" + want + "'");
    }

    static void Main() {
        // 带文本的设计 label 的名字会被标题文本整个覆盖，Find/探针
        // 三者失联（空 label 不受影响，所以只在真实页面塌)。建树完毕
        // 后名字必须保持 id 原文。
        string html = File.ReadAllText("tests/gui/design_label_name.html");
        JsonValue document = JsonValue.ParseLenient(DesignerHtml.ToJsonDoc(html));
        Control root = FormBuilder.Build(document);
        Control named = root.Find("Named");
        Control empty = root.Find("Empty");
        Control okay = root.Find("Okay");
        if (named == null || empty == null || okay == null) {
            Console.WriteLine("FAIL find: " + (named == null ? "Named " : "")
                + (empty == null ? "Empty " : "") + (okay == null ? "Okay" : ""));
            return;
        }
        Eq("Named.name", named.name, "Named");
        Eq("Empty.name", empty.name, "Empty");
        Eq("Okay.name", okay.name, "Okay");
        Eq("Named.text", named.GetProp("text"), "你好");
        Eq("Named.find", root.Find("Named") == null ? "miss" : "hit", "hit");
        Eq("Empty.find", root.Find("Empty") == null ? "miss" : "hit", "hit");
        if (fails == 0) { Console.WriteLine("design label name OK"); }
    }
}
