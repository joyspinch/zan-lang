using System;
using System.IO;
using Gui.Markup;
using Gui;
using Gui.Widget;

class DesignLabelNameTest {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got
            + "' want '" + want + "'");
    }

    static void Refresh(Control root, Control label) {
        label.SetProp("text", "first refresh");
        Eq("first refresh identity", root.FindByName("Named") == label ? "same" : "miss", "same");
        label.SetProp("value", "second refresh");
        Eq("second refresh identity", root.FindByName("Named") == label ? "same" : "miss", "same");
        Eq("second refresh text", label.GetProp("text"), "second refresh");
        label.SetProp("data", "");
        Eq("empty refresh identity", root.FindByName("Named") == label ? "same" : "miss", "same");
        Eq("empty refresh text", label.GetProp("text"), "");
        label.SetProp("name", "Renamed");
        Eq("explicit rename", root.FindByName("Renamed") == label ? "same" : "miss", "same");
        Eq("old identity retired", root.FindByName("Named") == null ? "absent" : "present", "absent");
    }

    static void Main() {
        // HTML and code preserve node identity through repeated content updates.
        string html = File.ReadAllText("tests/gui/design_label_name.html");
        Control root = Html.Parse(html, "", null).root;
        Control named = root.Find("Named");
        Control empty = root.Find("Empty");
        Control okay = root.Find("Okay");
        if (named == null || empty == null || okay == null) {
            Console.WriteLine("FAIL find: " + (named == null ? "Named " : "")
                + (empty == null ? "Empty " : "") + (okay == null ? "Okay" : ""));
            return;
        }
        Eq("Named.name", named.name, "Named");
        Eq("Empty.name", empty.name, "Empty");
        Eq("Okay.name", okay.name, "Okay");
        Eq("Named.text", named.GetProp("text"), "你好");
        Eq("Named.find", root.Find("Named") == null ? "miss" : "hit", "hit");
        Eq("Empty.find", root.Find("Empty") == null ? "miss" : "hit", "hit");
        Refresh(root, named);
        Panel codeRoot = new Panel();
        Label codeLabel = new Label("你好");
        codeLabel.Named("Named");
        codeRoot.Add(codeLabel);
        Refresh(codeRoot, codeLabel);
        if (fails == 0) { Console.WriteLine("design label name OK"); }
    }
}
