using System;
using Gui;
using Gui.Widget;

/// End-to-end check for saved user components (.zcomp) referenced from a
/// design: zanc's generator expands {"kind":"BadgeCard","ref":"BadgeCard"}
/// into the component's field tree, so the compiled control owns the
/// component's widgets plus the named Panel shell ("Card1"). Internals stay
/// private: no typed field is projected for them (this file would not
/// compile if `Card1_InnerTitle` were declared) — they stay reachable at
/// runtime only, under their shell-prefixed names.
partial class CompRefApp {
    void OnInit() {
    }
}

class CompRefTest {
    static int fails;

    static void Ok(string what, bool cond) {
        if (cond) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void Main() {
        fails = 0;

        CompRefApp app = new CompRefApp();

        // The ref node became a typed Panel shell named after it.
        CompRefTest.Eq("shell kind", app.Card1.Kind(), "Panel");
        CompRefTest.Eq("shell name", app.Card1.name, "Card1");

        // The component's widgets landed inside the shell as real controls.
        Ok("shell has children", app.Card1.ChildCount() == 2);

        // The Label keeps its shell-prefixed design name like every other
        // control: the design doc's declared field name wins over the
        // caption (SetDesignText syncName rename is transient during
// construction; GenForm/FormBuilder re-apply the field name). The
// caption stays reachable as content.
        Control title = app.Card1.Find("Card1_InnerTitle");
        Ok("inner label found", title != null);
        if (title != null) {
            CompRefTest.Eq("inner label caption", title.GetProp("text"), "inner title");
        }

        // The Button keeps its shell-prefixed design name. Card1 carries an
        // instance value for the component's declared prop btnText, so its
        // caption is the override, not the declared default "Go".
        Control btn = app.Card1.Find("Card1_InnerBtn");
        Ok("inner button found", btn != null);
        if (btn != null) {
            CompRefTest.Eq("inner button text (instance prop)", btn.GetProp("text"), "OK!");
        }

        // Card2 has no instance props: the declared default still applies.
        CompRefTest.Eq("shell kind 2", app.Card2.Kind(), "Panel");
        Control btn2 = app.Card2.Find("Card2_InnerBtn");
        Ok("inner button 2 found", btn2 != null);
        if (btn2 != null) {
            CompRefTest.Eq("inner button 2 text (default prop)", btn2.GetProp("text"), "Go");
        }

        // The window's own fields are untouched.
        CompRefTest.Eq("outer text", app.Outer.GetProp("text"), "outer");

        if (fails == 0) { Console.WriteLine("COMPREF_OK"); }
    }
}
