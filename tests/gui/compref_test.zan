using System;
using Gui;
using Gui.Widget;

partial class CompRefApp {
    void OnInit() {
    }
}

class CompRefTest {
    static int fails;

    static void Ok(string what, bool cond) {
        if (cond) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void Main() {
        fails = 0;

        CompRefApp app = new CompRefApp();

        CompRefTest.Eq("shell kind", app.Card1.Kind(), "Panel");
        CompRefTest.Eq("shell name", app.Card1.name, "Card1");

        Ok("flow component keeps legacy docking", app.Card1.ChildCount() == 2
            && app.Card1.children[0].dock == Dock.Top()
            && app.Card1.children[1].dock == Dock.Top()
            && app.Card1.children[0].parent == app.Card1
            && app.Card1.children[1].parent == app.Card1);

        Control title = app.Card1.Find("Card1_InnerTitle");
        Ok("inner label found", title != null);
        if (title != null) {
            CompRefTest.Eq("inner label caption", title.GetProp("text"), "inner title");
        }

        Control btn = app.Card1.Find("Card1_InnerBtn");
        Ok("inner button found", btn != null);
        if (btn != null) {
            CompRefTest.Eq("inner button text (instance prop)", btn.GetProp("text"), "OK!");
        }

        CompRefTest.Eq("shell kind 2", app.Card2.Kind(), "Panel");
        Control btn2 = app.Card2.Find("Card2_InnerBtn");
        Ok("inner button 2 found", btn2 != null);
        if (btn2 != null) {
            CompRefTest.Eq("inner button 2 text (default prop)", btn2.GetProp("text"), "Go");
        }

        CompRefTest.Eq("outer text", app.Outer.GetProp("text"), "outer");

        if (fails == 0) { Console.WriteLine("COMPREF_OK"); }
    }
}
