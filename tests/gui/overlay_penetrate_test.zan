using System;
using Gui;
using Gui.Widget;

// 弹层“按外部关闭”点击穿透回归（真实 App + 注入事件）。
// // 用户报告：抽屉/弹出层/下拉/菜单/layer 等所有浮层时不时出现
// “鼠标悬停、点击穿透到后面去”。其中点击穿透的系统性根因是
// 释放解析的时序：按外部关闭的浮层（OverlayPopup 选项列表、
// Popover、主题抽屉……）在本帧渲染时读到 kind==2 把自己关掉，
// 于是释放帧（BeginFrame 已清掉弹层）的命中快照里弹层不存在，
// 同一次手势的释放被解析成其下控件的点击——先关弹层再点穿到
// 背后的内容。修复：按下落在阻挡区/空白（pressOnBlocker）时
// 释放不发布点击目标、ClickAvailable 一并拒绝。
// // 本用例按真实帧序重放三种场景：
// 1. 纯 App 防线（pressOnBlocker）：内容 + 全窗遮罩帧上按下，
// 下一帧遮罩消失，释放不得触发遮罩下方的按钮（修复前触发）；
// 防线不粘滞，之后的普通点击照常触发。
// 2. OverlayPopup 端到端：SelectBox 打开后在弹层外按一下，弹层
// 关闭且其下按钮不被该手势触发；开启帧悬停在弹层正下方的
// 按钮坐标上，PointerCaptured 使悬停不穿透。
// 3. retained ContextMenu/OverlayHost：菜单外手势只关闭弹层，
// 其下按钮不被触发；选择、重开与显式关闭的通知各自恰好一次。
class OverlayPenetrateTest {
    static int fails;
    static App app;
    static SelectBox pick;
    static Button underBtn;
    static Button menuBtn;
    static int underClicks;

    static void True(string what, bool got) {
        if (got) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void EqInt(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got "
        + Convert.ToString(got) + " want " + Convert.ToString(want));
    }

    // 帧体只负责画内容：BeginFrame/PresentFrame 由 FrameGuarded 完成。
    static void Body() {
        // 场景 1/2 的内容：一只按钮 + 手动铺的全窗遮罩（maskOn），
        // 模拟任意“按外部关闭”的浮层在关闭前最后一帧的样子。
        underBtn.Render(app, 40, 40, 120);
        // 场景 2 的内容：SelectBox 触发器画在按钮下方。
        pick.RenderTree(app);
        // 场景 3 的内容：按钮正上方的坐标 (100,60) 供 ContextMenu
        // 菜单外释放命中。
        menuBtn.Render(app, 200, 40, 120);
        // 菜单只在打开时配置；FrameGuarded 的 overlay 尾部负责真实绘制。
        if (ctxMode && menu == null) { OverlayPenetrateTest.OpenMenu(); }
    }

    static Control inputRoot;
    static void UnderClick() { underClicks = underClicks + 1; }
    static void MenuButtonClick() { underClicks = underClicks + 1000; }
    static bool ctxMode;
    static ContextMenu menu;
    static int menuDismissals;
    static int menuActions;
    static int menuNotices;

    static void MenuAction() {
        menuActions = menuActions + 1;
        menu = null;
        ctxMode = false;
    }

    static void MenuNotice() { menuNotices = menuNotices + 1; }

    static void MenuDismissed(Control sender) {
        if (menu != sender) { return; }
        menuDismissals = menuDismissals + 1;
        menu = null;
        ctxMode = false;
    }

    static void OpenMenu() {
        ContextMenu created = new ContextMenu();
        created.AddItem("Alpha", OverlayPenetrateTest.MenuAction);
        created.AddItem("Beta", OverlayPenetrateTest.MenuAction);
        created.ActionSelected.Add(OverlayPenetrateTest.MenuNotice);
        created.Dismissed.AddS(OverlayPenetrateTest.MenuDismissed);
        menu = created;
        created.ShowAt(app, 60, 140);
        if (created.IsOpen() && app.overlayHost.ActiveRoot() == created) {
            menu = created;
            ctxMode = true;
        }
    }

    // 真实循环里每一次渲染都 preceded 一次泵。press 与 release
    // 各自需要一次泵+帧（InjectEvent 每次只入队一条）。
    static void PumpAndFrame() {
        app.PumpGuarded();
        app.FrameGuarded(OverlayPenetrateTest.Body);
    }

    static void MoveTo(int x, int y) {
        app.window.InjectEvent(1, x, y, 0, 0, 0);
        OverlayPenetrateTest.PumpAndFrame();
    }

    static void Press(int x, int y) {
        app.window.InjectEvent(2, x, y, 0, 0, 0);
        OverlayPenetrateTest.PumpAndFrame();
    }

    static void Release(int x, int y) {
        app.window.InjectEvent(3, x, y, 0, 0, 0);
        OverlayPenetrateTest.PumpAndFrame();
    }

    static void Main() {
        fails = 0;
        app = new App("overlay-penetrate", 400, 300);
        app.Show();
        app.RequestAnimationFrame(16);
        underBtn = new Button("Under");
        menuBtn = new Button("Menu");
        pick = new SelectBox("Pick", false);
        pick.UseApp(app);
        pick.MeasureTree(app);
        pick.Arrange(40, 90, 160, pick.prefH);
        underBtn.Click.Add(UnderClick);
        menuBtn.Click.Add(MenuButtonClick);
        inputRoot = new Control();
        inputRoot.Add(underBtn); inputRoot.Add(menuBtn); inputRoot.Add(pick);
        inputRoot.UseApp(app);
        inputRoot.Arrange(0, 0, 400, 300);
        app.SetRootControl(inputRoot);
        underClicks = 0;
        app.mouseX = 200;
        app.mouseY = 200;

        // 基线帧：让控件注册进快照。
        OverlayPenetrateTest.MoveTo(200, 200);

        // ---- 1. 纯 App 防线：遮罩上按下，遮罩消失后释放 ----------
        Control mask = new Control();
        mask.UseApp(app); mask.Prefer(80, 60);
        app.overlayHost.ShowAt(app, mask, 250, 180);
        app.window.InjectEvent(2, 100, 60, 0, 0, 0);
        OverlayPenetrateTest.PumpAndFrame();
        app.overlayHost.Dismiss();
        app.window.InjectEvent(3, 100, 60, 0, 0, 0);
        OverlayPenetrateTest.PumpAndFrame();  // 释放帧：弹层已“关闭”
        EqInt("release after press-on-blocker fires nothing",
        underClicks, 0);
        // 后续普通点击照常（防线不粘滞）。
        OverlayPenetrateTest.MoveTo(100, 60);
        OverlayPenetrateTest.Press(100, 60);
        OverlayPenetrateTest.Release(100, 60);
        EqInt("normal click after barrier still fires",
        underClicks, 1);

        // ---- 2. OverlayPopup 端到端：SelectBox 外部点击关闭 --------
        // 打开：点击触发器（press+release 各一帧）。
        OverlayPenetrateTest.MoveTo(100, 100);
        OverlayPenetrateTest.Press(100, 100);
        OverlayPenetrateTest.Release(100, 100);
        True("selectbox opened", pick.IsOpen());
        // 弹层开启帧：悬停穿透防线——指针虽落在按钮坐标上，
        // 遮罩把悬停收走。
        OverlayPenetrateTest.MoveTo(100, 60);
        True("hover under open popup does not reach button",
        !app.focus.IsHovered(underBtn.wid));
        // 弹层外按一下（触发器与弹层矩形之外）：SelectBox 靠
        // 释放收尾关闭（ClickAvailable），因此弹层在释放帧关闭；
        // 这次"点外部"手势不得触发其下按钮。
        OverlayPenetrateTest.Press(300, 250);
        OverlayPenetrateTest.Release(300, 250);
        True("selectbox closed by outside release", !pick.IsOpen());
        app.FrameGuarded(OverlayPenetrateTest.Body);
        app.FrameGuarded(OverlayPenetrateTest.Body);
        EqInt("dismiss click does not fire control under popup",
        underClicks, 1);

        // ---- 3. retained ContextMenu：真实 overlay 输入与通知 --------
        ctxMode = true;
        OverlayPenetrateTest.MoveTo(300, 250);
        True("retained context menu opened", menu != null && menu.IsOpen());
        OverlayPenetrateTest.Press(300, 250);
        OverlayPenetrateTest.Release(300, 250);
        True("context menu closed by outside press", menu == null);
        EqInt("outside dismissal notified once", menuDismissals, 1);
        EqInt("context menu dismiss does not fire control under",
        underClicks, 1);
        OverlayPenetrateTest.MoveTo(100, 60);
        OverlayPenetrateTest.Press(100, 60);
        OverlayPenetrateTest.Release(100, 60);
        EqInt("new click after dismiss still fires once", underClicks, 2);

        // OverlayHost consumes an Escape key press, not a character or release.
        ctxMode = true;
        OverlayPenetrateTest.MoveTo(300, 250);
        app.window.InjectEvent(6, 0, 0, 0, 27, 0);
        OverlayPenetrateTest.PumpAndFrame();
        True("context menu ignores Escape character", menu != null && menuDismissals == 1);
        app.window.InjectEvent(5, 0, 0, 0, 27, 0);
        OverlayPenetrateTest.PumpAndFrame();
        True("context menu ignores Escape key release", menu != null && menuDismissals == 1);
        app.window.InjectEvent(4, 0, 0, 0, 65, 0);
        OverlayPenetrateTest.PumpAndFrame();
        True("context menu ignores other keys", menu != null && menuDismissals == 1);
        app.window.InjectEvent(4, 0, 0, 0, 27, 0);
        OverlayPenetrateTest.PumpAndFrame();
        True("context menu Escape closes once", menu == null && menuDismissals == 2);
        True("context menu claims Escape key", app.IsKeyHandled());
        app.FrameGuarded(OverlayPenetrateTest.Body);
        True("context menu does not reuse consumed Escape", menu == null && menuDismissals == 2);

        // A real routed item click publishes Action/ActionSelected, not Dismissed.
        ctxMode = true;
        OverlayPenetrateTest.MoveTo(300, 250);
        Control item = menu.ChildAt(0);
        int itemX = item.bx + item.bw / 2;
        int itemY = item.by + item.bh / 2;
        OverlayPenetrateTest.MoveTo(itemX, itemY);
        OverlayPenetrateTest.Press(itemX, itemY);
        OverlayPenetrateTest.Release(itemX, itemY);
        EqInt("menu item Action runs once", menuActions, 1);
        EqInt("menu ActionSelected runs once", menuNotices, 1);
        EqInt("selection is not an outside dismissal", menuDismissals, 2);
        EqInt("selection does not penetrate", underClicks, 2);

        // Reopening the same instance dismisses its old session exactly once.
        ctxMode = true;
        OverlayPenetrateTest.MoveTo(300, 250);
        ContextMenu reopened = menu;
        reopened.ShowAt(app, 70, 150);
        EqInt("reopen dismisses old session once", menuDismissals, 3);
        True("reopened menu owns a live session", reopened.IsOpen());
        menu = reopened;
        ctxMode = true;
        app.overlayHost.Hide(reopened);
        app.overlayHost.Hide(reopened);
        EqInt("explicit close notifies at most once", menuDismissals, 4);
        True("explicit close leaves no retained menu", menu == null && !reopened.IsOpen());
        reopened.ClearCallbacks();
        True("ClearCallbacks clears both menu notifications",
        reopened.ActionSelected.CountAll() == 0 && reopened.Dismissed.CountAll() == 0);

        Console.WriteLine(fails == 0 ? "OVERLAY PENETRATE PASS"
        : "OVERLAY PENETRATE FAIL " + Convert.ToString(fails));
    }
}
