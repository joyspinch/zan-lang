using System;
using System.Collections.Generic;
using System.Automation;
using System.Net;
using Gui;
using Gui.Component;
using Gui.Component.DataTable;
using Gui.Component.Chart;
using Gui.Widget;

class ComponentAppEncapsulationTest {
    static int fails;

    static void True(string what, bool got) {
        if (got) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Eq(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got " + got + " want " + want);
    }

    public static void Main() {
        App app = new App("encap_test", 800, 600);

        // 1. Control.App 上下文注入与无参 Box / HasFocus / 交互状态测试
        Control root = new Control();
        root.UseApp(app);
        True("root has App", root.App != null);
        True("root Box() succeeds", root.Box() != null);
        True("root BoxState() succeeds", root.BoxState(Style.SNormal()) != null);
        True("root HasFocus() returns false", !root.HasFocus());
        True("root IsHovered() returns false", !root.IsHovered());
        True("root IsPressed() returns false", !root.IsPressed());
        True("root IsActive() returns false", !root.IsActive());
        True("root WasClicked() returns false", !root.WasClicked());
        True("root IsRightClicked() returns false", !root.IsRightClicked());
        True("root IsDoubleClicked() returns false", !root.IsDoubleClicked());
        root.Focus();
        root.Blur();

        // 2. ListView 无参度量测试
        ListView<string> list = new ListView<string>();
        root.Add(list);
        True("list inherits App from tree", list.App != null);
        List<string> items = new List<string>();
        items.Add("Alpha");
        items.Add("Beta");
        items.Add("Gamma");
        list.Bind(items);
        list.BuildRows();
        True("list RowHeight() > 0", list.RowHeight() > 0);
        True("list HeaderHeight() >= 0", list.HeaderHeight() >= 0);
        True("list ContentHeight() > 0", list.ContentHeight() > 0);
        True("list ContentHeightForTest() > 0", list.ContentHeightForTest() > 0);

        // 3. TreeView 无参度量测试
        TreeView tree = new TreeView();
        root.Add(tree);
        List<TreeNode> nodes = new List<TreeNode>();
        nodes.Add(TreeNode.Dir("Root", 0, true));
        nodes.Add(TreeNode.File("Leaf", 1));
        tree.Bind(nodes);
        tree.BuildRows();
        True("tree RowHeight() > 0", tree.RowHeight() > 0);
        True("tree FilterHeight() >= 0", tree.FilterHeight() >= 0);
        True("tree ContentHeight() > 0", tree.ContentHeight() > 0);

        // 4. Upload 无参样式测试
        Upload up = new Upload();
        root.Add(up);
        True("up StyleGap() >= 0", up.StyleGap() >= 0);
        True("up RowH() > 0", up.RowH() > 0);
        True("up TriggerStyle() != null", up.TriggerStyle(false) != null);
        True("up TriggerH() > 0", up.TriggerH() > 0);
        True("up TriggerW() > 0", up.TriggerW() > 0);
        True("up DraggerH() > 0", up.DraggerH() > 0);

        // 5. Carousel 实例翻页测试
        Carousel car = new Carousel();
        car.AddSlide("Page1");
        car.AddSlide("Page2");
        car.AddSlide("Page3");
        root.Add(car);
        Eq("carousel initial", car.CurrentIndex(), 0);
        car.Next();
        Eq("carousel next", car.CurrentIndex(), 1);
        car.Prev();
        Eq("carousel prev", car.CurrentIndex(), 0);
        car.GoTo(2);
        Eq("carousel goto", car.CurrentIndex(), 2);

        // 6. Button / Label / ListItem / Marquee / Skeleton / Typography
        Button btn = new Button("Click");
        root.Add(btn);
        True("btn ResolvedStyle() != null", btn.ResolvedStyle() != null);

        Label lbl = new Label("Text");
        root.Add(lbl);
        True("lbl ResolvedStyle() != null", lbl.ResolvedStyle() != null);

        ListItem li = new ListItem("Title");
        root.Add(li);
        True("li ResolvedStyle() != null", li.ResolvedStyle() != null);
        True("li TitleStyle() != null", li.TitleStyle() != null);
        True("li DescStyle() != null", li.DescStyle() != null);

        Marquee mar = new Marquee("News");
        root.Add(mar);
        True("mar ResolvedStyle() != null", mar.ResolvedStyle() != null);

        Skeleton sk = new Skeleton(100, 20);
        root.Add(sk);
        True("sk ResolvedStyle() != null", sk.ResolvedStyle() != null);
        Skeleton line = Skeleton.Line(120);
        True("Skeleton.Line() != null", line != null);

        Typography typ = new Typography("Head");
        root.Add(typ);
        True("typ ResolvedStyle() != null", typ.ResolvedStyle() != null);

        // 7. Tabs / VirtualList / Avatar / FloatButton
        Tabs tabs = new Tabs();
        root.Add(tabs);
        True("tabs HeaderHeight() > 0", tabs.HeaderHeight() > 0);

        VirtualList vlist = new VirtualList();
        root.Add(vlist);
        True("vlist ResolveRowH() > 0", vlist.ResolveRowH() > 0);

        Avatar av = new Avatar("User");
        root.Add(av);
        True("av Diameter() > 0", av.Diameter() > 0);

        FloatButton fb = new FloatButton("up");
        root.Add(fb);
        True("fb Diameter() > 0", fb.Diameter() > 0);

        // 8. TextArea / RichText
        TextArea ta = new TextArea();
        root.Add(ta);
        ta.SetText("Hello\nWorld");
        True("TextArea.LineHeight() > 0", TextArea.LineHeight() > 0);
        True("ta ContentHeight() > 0", ta.ContentHeight() > 0);
        True("ta BottomRowH() >= 0", ta.BottomRowH() >= 0);

        RichText rt = new RichText();
        root.Add(rt);
        True("rt ResolveFontPx() > 0", rt.ResolveFontPx() > 0);
        True("rt BarW() > 0", rt.BarW() > 0);

        // 9. SafeAreaView / Dropdown
        SafeAreaView sa = new SafeAreaView();
        root.Add(sa);
        sa.SyncSafeArea();

        Dropdown dd = new Dropdown();
        root.Add(dd);
        True("dd SyncItems() != null", dd.SyncItems() != null);

        // 10. SelectBox / DatePicker / ColorPicker
        SelectBox sb = new SelectBox();
        root.Add(sb);
        True("sb EnsurePopupCard() != null", sb.EnsurePopupCard() != null);
        True("sb FontSize() > 0", sb.FontSize(sb.Box()) > 0);

        DatePicker dp = new DatePicker();
        root.Add(dp);
        True("dp EnsurePopupCard() != null", dp.EnsurePopupCard() != null);

        ColorPicker cp = new ColorPicker();
        root.Add(cp);
        True("cp EnsurePopupCard() != null", cp.EnsurePopupCard() != null);
        True("cp TriggerH() > 0", cp.TriggerH() > 0);

        // 11. DataTableControl 面向对象实例方法测试
        DataColumn colChain = DataColumn.Text("Price", 120).Field("price").Editable().Pin().Right();
        True("colChain is non-null", colChain != null);
        True("colChain FieldName() == 'price'", colChain.FieldName() == "price");
        True("colChain is editable", colChain.editable);
        True("colChain is pinned", colChain.pinned);

        List<DataColumn> cols = new List<DataColumn>();
        cols.Add(new DataColumn("name", 80));
        cols.Add(DataColumn.Numeric("age", 80));
        cols.Add(colChain);
        List<DataRow> rows = new List<DataRow>();
        DataRow r1 = new DataRow();
        r1.Push("Alice");
        r1.Push("25");
        rows.Add(r1);
        DataRow r2 = new DataRow();
        r2.Push("Bob");
        r2.Push("30");
        rows.Add(r2);
        DataSource src = new RowListSource(rows);
        DataTableControl grid = new DataTableControl(cols, src);
        root.Add(grid);
        True("grid has App", grid.App != null);
        grid.AutoFitAll();
        grid.AutoFitColumn(0);
        grid.SelectAll(true);
        grid.ClearSelection();
        grid.SortBy("name", 1);
        grid.GroupBy("age");
        grid.ResetColumns();
        grid.OpenFind();
        grid.SetHighlightQuery("Ali");
        grid.CloseFind();

        // 12. ChartHost 面向对象图表宿主控件测试
        ChartHost ch = new ChartHost();
        root.Add(ch);
        True("ch has App", ch.App != null);
        ch.SetChartType("line");
        ch.SetTheme("dark");
        True("ch.GetOption() != null", ch.GetOption() != null);

        // 13. Transfer 无参 ComputeMetrics 与 Render 测试
        Transfer<string> tr = new Transfer<string>();
        root.Add(tr);
        True("tr has App", tr.App != null);
        tr.ComputeMetrics();
        tr.Render(0, 0, 400, 300);

        // 14. DynamicTags 无参 FinishEdit 测试
        DynamicTags dt = new DynamicTags();
        root.Add(dt);
        True("dt has App", dt.App != null);
        dt.StartEdit();
        dt.FinishEdit(false);

        // 15. Watermark 无参 EffectiveFont 测试
        Watermark wm = new Watermark("CONFIDENTIAL");
        root.Add(wm);
        True("wm has App", wm.App != null);
        True("wm EffectiveFont() > 0", wm.EffectiveFont(wm.Box()) > 0);

        // 16. PropertyGrid 无参 RowHeight 与 ContentHeight 测试
        PropertyGrid pg = new PropertyGrid();
        root.Add(pg);
        True("pg has App", pg.App != null);
        True("pg RowHeight() > 0", pg.RowHeight() > 0);
        True("pg ContentHeight() >= 0", pg.ContentHeight() >= 0);

        // 17. Layer 全局门面无参/自动上下文字符串与弹窗测试
        Layer.Msg("test message", 1);
        Layer.Msg("test message default");
        Layer.Notify("test notice", 1);
        Layer.Notify("test notice default");
        Layer.Tips(10, 20, "hover tip");
        Layer.Tips("hover tip 2", 30, 40);
        int modalHit = Layer.Modal(400, 300, "Modal Title");
        True("Layer.Modal completes", modalHit >= 0);

        // LayerState 面向对象原生生命周期与层级判定测试
        LayerState ls = LayerState.Alert("Test Alert", "Alert Body", 0);
        ls.Open();
        True("ls.IsTopmost() is true after open", ls.IsTopmost());
        ls.Close();
        True("ls.Close() sets open false", !ls.open);

        // 18. Chart 模型面向对象首选实例 Clone() 与静态空安全转发测试
        ChartAxis ax = new ChartAxis();
        ax.title = "X Axis";
        ChartAxis axClone = ax.Clone();
        True("ax.Clone() copies title", axClone != null && axClone.title == "X Axis");
        True("ChartAxis.Clone(null) is safe", ChartAxis.Clone(null) == null);

        ChartData cd = new ChartData();
        cd.name = "Sales";
        cd.val = 100;
        ChartData cdClone = cd.Clone();
        True("cd.Clone() copies fields", cdClone != null && cdClone.name == "Sales" && cdClone.val == 100);

        ChartSeries cs = new ChartSeries();
        cs.name = "Series1";
        cs.data = new List<ChartData>();
        cs.data.Add(cd);
        ChartSeries csClone = cs.Clone();
        True("cs.Clone() deep copies data", csClone != null && csClone.data.Count == 1 && csClone.data[0].val == 100);

        ChartOption opt = new ChartOption();
        opt.title = "Main Chart";
        opt.xAxes = new List<ChartAxis>();
        opt.xAxes.Add(ax);
        opt.series = new List<ChartSeries>();
        opt.series.Add(cs);
        ChartOption optClone = opt.Clone();
        True("opt.Clone() deep copies tree", optClone != null && optClone.title == "Main Chart" && optClone.series.Count == 1);
        True("optClone deep copied axis", optClone.xAxes.Count == 1 && optClone.xAxes[0].title == "X Axis");

        // 19. Ui 无参交互门面与自动 App 帧上下文测试
        True("Ui.Clicked(0) returns false without crash", !Ui.Clicked(0));
        True("Ui.Hovered(0) returns false without crash", !Ui.Hovered(0));
        True("Ui.Pressed(0) returns false without crash", !Ui.Pressed(0));
        True("Ui.Active(0) returns false without crash", !Ui.Active(0));
        True("Ui.Focused(0) returns false without crash", !Ui.Focused(0));
        True("Ui.Over(0, 0, 10, 10) safe", !Ui.Over(0, 0, 10, 10));

        // 20. UiRole / UiState 标准 PascalCase 常量与 UiElement 语义化实例方法
        Eq("UiRole.PushButton constant", UiRole.PushButton, 0x2B);
        Eq("UiState.Focusable constant", UiState.Focusable, 0x100000);
        UiElement elem = new UiElement((nint)0, 0);
        True("elem.IsPushButton() safe", !elem.IsPushButton());
        True("elem.IsFocusable() safe", !elem.IsFocusable());
        elem.Dispose();

        // 21. ChartRenderContext 单帧上下文对象化管理与 EndFrame 收拢测试
        Chart.toolReserve = 80;
        Chart.legendBottomReserve = 40;
        Eq("Chart.toolReserve set", Chart.toolReserve, 80);
        Eq("Chart.RenderContext.toolReserve", Chart.RenderContext.toolReserve, 80);
        Chart.EndFrame();
        Eq("Chart.EndFrame resets toolReserve", Chart.toolReserve, 0);
        Eq("Chart.EndFrame resets legendBottomReserve", Chart.legendBottomReserve, 0);

        // 22. WebSocketHub / SseHub 面向对象连接中枢服务测试
        WebSocketHub wsHub = new WebSocketHub();
        Eq("wsHub initial conn count", wsHub.ConnCount(), 0);
        wsHub.Clear();

        SseHub sseHub = new SseHub();
        Eq("sseHub initial conn count", sseHub.ConnCount(), 0);
        sseHub.Clear();

        // 23. Style 样式门面零-App 自动上下文与无参解析测试
        StyleBox btnStyle = Style.Of("button", Style.SNormal());
        True("Style.Of() without App succeeds", btnStyle != null);
        StyleBox easedBtn = Style.Eased(1001, "button", "primary");
        True("Style.Eased() without App succeeds", easedBtn != null);
        int stateBit = Style.StateOf(1001);
        Eq("Style.StateOf() without App safe", stateBit, 0);

        if (fails == 0) {
            Console.WriteLine("component_app_encapsulation_test OK");
        } else {
            Console.WriteLine("component_app_encapsulation_test FAILED: " + fails + " errors");
        }
    }
}
