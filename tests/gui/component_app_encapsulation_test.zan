using System;
using System.Collections.Generic;
using Gui;
using Gui.Component;
using Gui.Component.DataTable;
using Gui.Component.Chart;
using Gui.Widget;

class ComponentAppEncapsulationTest {
    static int fails;

    static void True(string what, bool got) {
        if (got) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Eq(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got " + got + " want " + want);
    }

    public static void Main() {
        App app = new App("encap_test", 800, 600);

        // 1. Control.App 上下文注入与无参 Box / HasFocus 测试
        Control root = new Control();
        root.UseApp(app);
        True("root has App", root.App != null);
        True("root Box() succeeds", root.Box() != null);
        True("root BoxState() succeeds", root.BoxState(Style.SNormal()) != null);
        True("root HasFocus() returns false", !root.HasFocus());

        // 2. ListView 无参度量测试
        ListView<string> list = new ListView<string>();
        root.Add(list);
        True("list inherits App from tree", list.App != null);
        List<string> items = new List<string>();
        items.Add("Alpha");
        items.Add("Beta");
        items.Add("Gamma");
        list.Bind(items);
        list.BuildRows();
        True("list RowHeight() > 0", list.RowHeight() > 0);
        True("list HeaderHeight() >= 0", list.HeaderHeight() >= 0);
        True("list ContentHeight() > 0", list.ContentHeight() > 0);
        True("list ContentHeightForTest() > 0", list.ContentHeightForTest() > 0);

        // 3. TreeView 无参度量测试
        TreeView tree = new TreeView();
        root.Add(tree);
        List<TreeNode> nodes = new List<TreeNode>();
        nodes.Add(TreeNode.Dir("Root", 0, true));
        nodes.Add(TreeNode.File("Leaf", 1));
        tree.Bind(nodes);
        tree.BuildRows();
        True("tree RowHeight() > 0", tree.RowHeight() > 0);
        True("tree FilterHeight() >= 0", tree.FilterHeight() >= 0);
        True("tree ContentHeight() > 0", tree.ContentHeight() > 0);

        // 4. Upload 无参样式测试
        Upload up = new Upload();
        root.Add(up);
        True("up StyleGap() >= 0", up.StyleGap() >= 0);
        True("up RowH() > 0", up.RowH() > 0);
        True("up TriggerStyle() != null", up.TriggerStyle(false) != null);
        True("up TriggerH() > 0", up.TriggerH() > 0);
        True("up TriggerW() > 0", up.TriggerW() > 0);
        True("up DraggerH() > 0", up.DraggerH() > 0);

        // 5. Carousel 实例翻页测试
        Carousel car = new Carousel();
        car.AddSlide("Page1");
        car.AddSlide("Page2");
        car.AddSlide("Page3");
        root.Add(car);
        Eq("carousel initial", car.CurrentIndex(), 0);
        car.Next();
        Eq("carousel next", car.CurrentIndex(), 1);
        car.Prev();
        Eq("carousel prev", car.CurrentIndex(), 0);
        car.GoTo(2);
        Eq("carousel goto", car.CurrentIndex(), 2);

        // 6. Button / Label / ListItem / Marquee / Skeleton / Typography
        Button btn = new Button("Click");
        root.Add(btn);
        True("btn ResolvedStyle() != null", btn.ResolvedStyle() != null);

        Label lbl = new Label("Text");
        root.Add(lbl);
        True("lbl ResolvedStyle() != null", lbl.ResolvedStyle() != null);

        ListItem li = new ListItem("Title");
        root.Add(li);
        True("li ResolvedStyle() != null", li.ResolvedStyle() != null);
        True("li TitleStyle() != null", li.TitleStyle() != null);
        True("li DescStyle() != null", li.DescStyle() != null);

        Marquee mar = new Marquee("News");
        root.Add(mar);
        True("mar ResolvedStyle() != null", mar.ResolvedStyle() != null);

        Skeleton sk = new Skeleton(100, 20);
        root.Add(sk);
        True("sk ResolvedStyle() != null", sk.ResolvedStyle() != null);
        Skeleton line = Skeleton.Line(120);
        True("Skeleton.Line() != null", line != null);

        Typography typ = new Typography("Head");
        root.Add(typ);
        True("typ ResolvedStyle() != null", typ.ResolvedStyle() != null);

        // 7. Tabs / VirtualList / Avatar / FloatButton
        Tabs tabs = new Tabs();
        root.Add(tabs);
        True("tabs HeaderHeight() > 0", tabs.HeaderHeight() > 0);

        VirtualList vlist = new VirtualList();
        root.Add(vlist);
        True("vlist ResolveRowH() > 0", vlist.ResolveRowH() > 0);

        Avatar av = new Avatar("User");
        root.Add(av);
        True("av Diameter() > 0", av.Diameter() > 0);

        FloatButton fb = new FloatButton("up");
        root.Add(fb);
        True("fb Diameter() > 0", fb.Diameter() > 0);

        // 8. TextArea / RichText
        TextArea ta = new TextArea();
        root.Add(ta);
        ta.SetText("Hello\nWorld");
        True("TextArea.LineHeight() > 0", TextArea.LineHeight() > 0);
        True("ta ContentHeight() > 0", ta.ContentHeight() > 0);
        True("ta BottomRowH() >= 0", ta.BottomRowH() >= 0);

        RichText rt = new RichText();
        root.Add(rt);
        True("rt ResolveFontPx() > 0", rt.ResolveFontPx() > 0);
        True("rt BarW() > 0", rt.BarW() > 0);

        // 9. SafeAreaView / Dropdown
        SafeAreaView sa = new SafeAreaView();
        root.Add(sa);
        sa.SyncSafeArea();

        Dropdown dd = new Dropdown();
        root.Add(dd);
        True("dd SyncItems() != null", dd.SyncItems() != null);

        // 10. SelectBox / DatePicker / ColorPicker
        SelectBox sb = new SelectBox();
        root.Add(sb);
        True("sb EnsurePopupCard() != null", sb.EnsurePopupCard() != null);
        True("sb FontSize() > 0", sb.FontSize(sb.Box()) > 0);

        DatePicker dp = new DatePicker();
        root.Add(dp);
        True("dp EnsurePopupCard() != null", dp.EnsurePopupCard() != null);

        ColorPicker cp = new ColorPicker();
        root.Add(cp);
        True("cp EnsurePopupCard() != null", cp.EnsurePopupCard() != null);
        True("cp TriggerH() > 0", cp.TriggerH() > 0);

        // 11. DataTableControl 面向对象实例方法测试
        List<DataColumn> cols = new List<DataColumn>();
        cols.Add(new DataColumn("name", 80));
        cols.Add(DataColumn.Numeric("age", 80));
        List<DataRow> rows = new List<DataRow>();
        DataRow r1 = new DataRow();
        r1.Push("Alice");
        r1.Push("25");
        rows.Add(r1);
        DataRow r2 = new DataRow();
        r2.Push("Bob");
        r2.Push("30");
        rows.Add(r2);
        DataSource src = new RowListSource(rows);
        DataTableControl grid = new DataTableControl(cols, src);
        root.Add(grid);
        True("grid has App", grid.App != null);
        grid.AutoFitAll();
        grid.AutoFitColumn(0);
        grid.SelectAll(true);
        grid.ClearSelection();
        grid.SortBy("name", 1);
        grid.GroupBy("age");
        grid.ResetColumns();
        grid.OpenFind();
        grid.SetHighlightQuery("Ali");
        grid.CloseFind();

        // 12. ChartHost 面向对象图表宿主控件测试
        ChartHost ch = new ChartHost();
        root.Add(ch);
        True("ch has App", ch.App != null);
        ch.SetChartType("line");
        ch.SetTheme("dark");
        True("ch.GetOption() != null", ch.GetOption() != null);

        if (fails == 0) {
            Console.WriteLine("component_app_encapsulation_test OK");
        } else {
            Console.WriteLine("component_app_encapsulation_test FAILED: " + fails + " errors");
        }
    }
}
