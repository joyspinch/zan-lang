using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Component.CodeEditor;

// 「插入代码片段…」的端到端回归（无头 UiDriver）：
// 真右键 → 菜单里点「插入代码片段…」→ 选择器弹窗里只有片段
// → 选中后插入模板并进入洞位模式（Tab 在洞之间跳）。
// 这条链跨了右键菜单、弹窗和片段引擎三层，单测盖不住。
class CodeEditorSnippetPickerUiTest {
    static int fails;
    static App app;
    static CodeEditor ed;

    static void EqStr(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void EqInt(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got " + Convert.ToString(got)
        + " want " + Convert.ToString(want));
    }

    static void Body() {
        if (!app.PrepareStandardHostFrame()) { throw new Exception("menu host preparation"); }
        ed.UseApp(app); ed.MeasureTree(app); ed.Arrange(40, 60, 640, 400);
        ed.RenderTree(app);
        app.RequestAnimationFrame(16);

    }

    static void Frame() {
        app.PumpGuarded();
        app.FrameGuarded(CodeEditorSnippetPickerUiTest.Body);
    }

    static void Frames(int n) {
        for (int i = 0; i < n; i = i + 1) { Frame(); }
    }

    // 从真实菜单子树取得目标行，并先滚动到可见视口。
    static Control MenuRow(int index) {
        ContextMenu menu = app.overlayHost.ActiveRoot() as ContextMenu;
        if (menu == null) { throw new Exception("editor menu has a retained root"); }
        Control row = menu.ChildAt(index);
        Rect viewport = menu.ScrollViewport();
        if (row.by + row.bh > viewport.Bottom()) {
            menu.SetScrollTop(menu.ScrollTop() + row.by + row.bh - viewport.Bottom());
            Frame();
        }
        if (!row.ContainsInputControl(menu.HitTest(row.bx + row.bw / 2, row.by + row.bh / 2))) {
            throw new Exception("snippet menu row is hittable: row=" + Convert.ToString(row.by)
            + "/" + Convert.ToString(row.bh) + " viewport=" + Convert.ToString(viewport.y)
            + "/" + Convert.ToString(viewport.height) + " scroll=" + Convert.ToString(menu.ScrollTop()));
        }
        return row;
    }

    static void Main() {
        fails = 0;
        app = new App("snip-picker-ui", 1200, 900);
        app.Show();
        app.RequestAnimationFrame(16);

        ed = new CodeEditor();
        ed.UseApp(app); app.SetRootControl(ed);
        ed.documentPath = "probe.zan";
        ed.LoadText("class Program {\n    static void Main() { }\n}\n");
        Frames(2);

        UiDriver.SetApp(app);
        Directory.CreateDirectoryRecursive("build/test-out/gui-cleanup-completion");
        UiDriver.SetResultsPath("build/test-out/gui-cleanup-completion/snip_picker_ui_results.log");
        UiDriver.SetProbes(new List<UiProbe>());
        if (File.Exists(UiDriver.ResultsPath())) { File.Delete(UiDriver.ResultsPath()); }

        // ---- 右键 → 菜单 ----
        bool ok = UiDriver.Exec("rclick 120 120");
        EqInt("rclick accepted", ok ? 1 : 0, 1);
        Frames(5);
        EqInt("menu open", ed.CtxMenuOpen() ? 1 : 0, 1);

        List<ContextMenuItem> items = ed.BuildCtxMenuItems();
        int idx = -1;
        for (int i = 0; i < items.Count; i = i + 1) {
            if (items[i].action == 21) { idx = i; }
        }
        EqInt("snippet item in menu", idx >= 0 ? 1 : 0, 1);

        // ---- 点「插入代码片段…」→ 片段选择器 ----
        Control row = MenuRow(idx);
        int y = row.by + row.bh / 2;
        int x = row.bx + row.bw / 2;
        bool ok2 = UiDriver.Exec("click " + Convert.ToString(x) + " " + Convert.ToString(y));
        EqInt("click accepted", ok2 ? 1 : 0, 1);
        Frames(5);
        EqInt("menu closed", ed.CtxMenuOpen() ? 1 : 0, 0);
        EqInt("picker open", ed.acActive ? 1 : 0, 1);

        // 选择器里只有片段。
        bool allSnippets = ed.acKinds.Count > 0;
        for (int i = 0; i < ed.acKinds.Count; i = i + 1) {
            if (ed.acKinds[i] != "S") { allSnippets = false; }
        }
        EqInt("picker lists snippets only", allSnippets ? 1 : 0, 1);
        bool hasIf = false;
        for (int i = 0; i < ed.acItems.Count; i = i + 1) {
            if (ed.acItems[i] == "if") { hasIf = true; }
        }
        EqInt("picker has the if snippet", hasIf ? 1 : 0, 1);

        // ---- 选中 if：模板进文档，光标落在第一个洞 ----
        int sel = -1;
        for (int i = 0; i < ed.acItems.Count; i = i + 1) {
            if (ed.acItems[i] == "if") { sel = i; }
        }
        ed.acSel = sel;
        ed.AcceptCompletion(false);
        // 右键落点决定了插入位置，这里只断言模板本身进去了。
        string txt = ed.GetText();
        bool hasTpl = txt.IndexOf("if () {") >= 0 && txt.IndexOf("}") >= 0;
        EqInt("template inserted", hasTpl ? 1 : 0, 1);
        EqInt("snippet mode on", ed.SnippetActive() ? 1 : 0, 1);
        EqInt("caret left the template head", ed.CurCol() > 0 ? 1 : 0, 1);

        if (File.Exists(UiDriver.ResultsPath())) { File.Delete(UiDriver.ResultsPath()); }
        ed.DetachAnalysis(); app.SetRootControl(null);
        UiDriver.SetApp(null); UiDriver.SetProbes(null); ed = null;
        app.StopLoop(); app.DrainPosts(); app.window.Destroy(); app.canvas.Destroy();
        if (App.FrameApp() == app) { App.SetFrameApp(null); }
        app = null;
        Console.WriteLine(fails == 0 ? "OK" : "FAILS " + Convert.ToString(fails));
    }
}
