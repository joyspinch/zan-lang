using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Component.CodeEditor;

// 「插入代码片段…」的端到端回归（无头 UiDriver）：
// 真右键 → 菜单里点「插入代码片段…」→ 选择器弹窗里只有片段
// → 选中后插入模板并进入洞位模式（Tab 在洞之间跳）。
// 这条链跨了右键菜单、弹窗和片段引擎三层，单测盖不住。
class CodeEditorSnippetPickerUiTest {
    static int fails;
    static App app;
    static CodeEditor ed;

    static void EqStr(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void EqInt(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got " + Convert.ToString(got)
            + " want " + Convert.ToString(want));
    }

    static void Body() {
        ed.Render(app, new Rect(40, 60, 640, 400));
        ed.RenderCtxMenu(app);
    }

    static void Frame() {
        app.PumpGuarded();
        app.FrameGuarded(CodeEditorSnippetPickerUiTest.Body);
    }

    static void Frames(int n) {
        for (int i = 0; i < n; i = i + 1) { Frame(); }
    }

    // 菜单里第 `action` 项的点击坐标（与编辑器自绘菜单的几何一致）。
    static int ItemY(List<ContextMenuItem> items, int index) {
        int fontSize = Style.FontFallback(app, "medium");
        int lineH = Canvas.FontHeight(fontSize) + app.Scale(4);
        int sepH = app.Scale(7);
        int mY = ed.CtxAnchorY();
        int mH = app.Scale(6);
        for (int i = 0; i < items.Count; i = i + 1) {
            if (items[i].action == 0) { mH = mH + sepH; } else { mH = mH + lineH; }
        }
        if (mY + mH > app.canvas.Height()) { mY = app.canvas.Height() - mH - app.Scale(4); }
        if (mY < app.titlebarH) { mY = app.titlebarH; }
        int y = mY + app.Scale(3);
        for (int i = 0; i < index; i = i + 1) {
            if (items[i].action == 0) { y = y + sepH; } else { y = y + lineH; }
        }
        return y;
    }

    static void Main() {
        fails = 0;
        app = new App("snip-picker-ui", 1200, 900);
        app.Show();
        app.RequestAnimationFrame(16);

        ed = new CodeEditor();
        ed.documentPath = "probe.zan";
        ed.LoadText("class Program {\n    static void Main() { }\n}\n");
        Frames(2);

        UiDriver.app = app;
        UiDriver.resultsPath = "build/snip_picker_ui_results.log";
        UiDriver.probes = new List<UiProbe>();
        if (File.Exists(UiDriver.resultsPath)) { File.Delete(UiDriver.resultsPath); }

        // ---- 右键 → 菜单 ----
        bool ok = UiDriver.Exec("rclick 120 120");
        EqInt("rclick accepted", ok ? 1 : 0, 1);
        Frames(5);
        EqInt("menu open", ed.CtxMenuOpen() ? 1 : 0, 1);

        List<ContextMenuItem> items = ed.BuildCtxMenuItems();
        int idx = -1;
        for (int i = 0; i < items.Count; i = i + 1) {
            if (items[i].action == 21) { idx = i; }
        }
        EqInt("snippet item in menu", idx >= 0 ? 1 : 0, 1);

        // ---- 点「插入代码片段…」→ 片段选择器 ----
        int y = ItemY(items, idx);
        int x = ed.CtxAnchorX() + 12;
        bool ok2 = UiDriver.Exec("click " + Convert.ToString(x) + " " + Convert.ToString(y));
        EqInt("click accepted", ok2 ? 1 : 0, 1);
        Frames(5);
        EqInt("menu closed", ed.CtxMenuOpen() ? 1 : 0, 0);
        EqInt("picker open", ed.acActive ? 1 : 0, 1);

        // 选择器里只有片段。
        bool allSnippets = ed.acKinds.Count > 0;
        for (int i = 0; i < ed.acKinds.Count; i = i + 1) {
            if (ed.acKinds[i] != "S") { allSnippets = false; }
        }
        EqInt("picker lists snippets only", allSnippets ? 1 : 0, 1);
        bool hasIf = false;
        for (int i = 0; i < ed.acItems.Count; i = i + 1) {
            if (ed.acItems[i] == "if") { hasIf = true; }
        }
        EqInt("picker has the if snippet", hasIf ? 1 : 0, 1);

        // ---- 选中 if：模板进文档，光标落在第一个洞 ----
        int sel = -1;
        for (int i = 0; i < ed.acItems.Count; i = i + 1) {
            if (ed.acItems[i] == "if") { sel = i; }
        }
        ed.acSel = sel;
        ed.AcceptCompletion(false);
        // 右键落点决定了插入位置，这里只断言模板本身进去了。
        string txt = ed.GetText();
        EqInt("template inserted", txt.IndexOf("if () {\n    \n}") >= 0 ? 1 : 0, 1);
        EqInt("snippet mode on", ed.SnippetActive() ? 1 : 0, 1);
        EqInt("caret left the template head", ed.CurCol() > 0 ? 1 : 0, 1);

        if (File.Exists(UiDriver.resultsPath)) { File.Delete(UiDriver.resultsPath); }
        Console.WriteLine(fails == 0 ? "OK" : "FAILS " + Convert.ToString(fails));
    }
}
