// 标记里的 p/h1–h6 经 TagToKind 落到 Typography（Label 族）；正文在解析
// 节点的 items 而非 n.text，AddDocumentText 曾只认 TableCell/TabPane 等几种
// kind——标题、段落文字整段丢失，只剩空框（模板标题/说明全空白）。
// label/button 正文走 n.text，不得因此重复。
using System;
using Gui;
using Gui.Markup;

class App {
    static string TextOf(HtmlDoc doc, string id) {
        Control c = doc.root.Find(id);
        if (c == null) { return "<null>"; }
        return c.GetProp("text");
    }

    static int Main() {
        HtmlDoc doc = Html.Parse(
            "<div><h1 id=\"t\">围住神经猫</h1><h3 id=\"s\">Sub title</h3>"
            + "<p id=\"p\">它想溜走，你来封路。</p>"
            + "<label id=\"l\">Name</label><button id=\"b\">Go</button></div>",
            "", null);
        string got = TextOf(doc, "t") + "|" + TextOf(doc, "s") + "|" + TextOf(doc, "p")
            + "|" + TextOf(doc, "l") + "|" + TextOf(doc, "b");
        Console.WriteLine(got);
        if (got == "围住神经猫|Sub title|它想溜走，你来封路。|Name|Go") {
            Console.WriteLine("MARKUP_TYPOGRAPHY_TEXT_OK");
            return 0;
        }
        return 1;
    }
}
