using System;
using Gui;
using Gui.Core;
using Gui.Widget;

class TouchPhysicsTest {
    static int fails;

    static void True(string what, bool got) {
        if (got) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    public static void Main() {
        // 1. 验证橡皮筋阻尼拉伸
        float r0 = ScrollPhysics.RubberBandClamp(0.0f, 600.0f);
        True("r0 == 0", r0 == 0.0f);

        float r1 = ScrollPhysics.RubberBandClamp(100.0f, 600.0f);
        True("r1 in [48, 53]", r1 > 48.0f && r1 < 53.0f);

        // 2. 验证面向对象 FlingState 惯性动量衰减
        FlingState fling = new FlingState(2000.0f);
        float dist = 0.0f;
        for (int i = 0; i < 200; i = i + 1) {
            float delta = fling.Step(16);
            dist = dist + delta;
            if (fling.velocity == 0.0f) { break; }
        }
        True("fling stopped", fling.velocity == 0.0f);
        True("dist > 300", dist > 300.0f);

        // 3. 验证面向对象 SpringState 阻尼弹簧回弹
        SpringState spring = new SpringState(50.0f);
        bool settled = false;
        for (int i = 0; i < 60; i = i + 1) {
            settled = spring.Step(16);
            if (settled) { break; }
        }
        True("spring settled", settled);
        True("spring disp == 0", spring.displacement == 0.0f);

        // 4. 验证 GestureDetector
        GestureDetector gd = new GestureDetector("touch_area");
        bool tapped = false;
        bool flung = false;
        gd.OnTap((int x, int y) => {
            tapped = true;
        });
        gd.OnFling((float vx, float vy) => {
            flung = true;
        });

        // 模拟单击
        gd.HandleTouchDown(100, 50, 50);
        gd.HandleTouchUp(150, 50, 50);
        True("tapped triggered", tapped);

        // 模拟快速拖拽甩手 (Fling)
        gd.HandleTouchDown(1000, 50, 100);
        gd.HandleTouchMove(1020, 50, 150);
        gd.HandleTouchMove(1040, 50, 220);
        gd.HandleTouchMove(1060, 50, 310);
        gd.HandleTouchUp(1080, 50, 420);
        True("flung triggered", flung);

        if (fails == 0) {
            Console.WriteLine("touch_physics_test OK");
        } else {
            Console.WriteLine("touch_physics_test FAILED: " + fails + " errors");
        }
    }
}
