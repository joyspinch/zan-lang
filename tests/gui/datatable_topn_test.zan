using System;
using Gui;
using Gui.Widget;

namespace DataTableTopNTest;

class Program {
    static DataRow Row(int i) {
        DataRow r = new DataRow();
        r.Push(Convert.ToString(i));
        r.Push(Convert.ToString(i % 1000));
        return r;
    }

    static string Names(DataSource src, List<int> order) {
        string outp = "";
        for (int i = 0; i < order.Count && i < 3; i = i + 1) {
            if (i > 0) { outp = outp + ","; }
            outp = outp + src.CellText(order[i], 0);
        }
        return outp;
    }

    static void Main() {
        List<DataRow> rows = new List<DataRow>();
        for (int i = 0; i < 100000; i = i + 1) { rows.Add(Program.Row(i)); }

        List<DataColumn> cols = new List<DataColumn>();
        cols.Add(new DataColumn("id", 80));
        cols.Add(DataColumn.Real("value", 80, 0));
        DataSource src = new RowListSource(rows);
        DataTableState st = new DataTableState();
        DataTable.EnsureInit(st, cols, src);

        st.filters[1].topMode = 1;
        st.filters[1].topN = 5;
        st.dirty = true;
        DataTable.Recompute(st, cols, src);
        Console.WriteLine("top5 count=" + Convert.ToString(st.order.Count));
        Console.WriteLine("top5 first=" + Program.Names(src, st.order));
        Console.WriteLine("top5 min=" + src.CellText(st.order[st.order.Count - 1], 1));

        st.filters[1].topMode = 2;
        st.filters[1].topN = 5;
        st.dirty = true;
        DataTable.Recompute(st, cols, src);
        Console.WriteLine("bottom5 count=" + Convert.ToString(st.order.Count));
        Console.WriteLine("bottom5 first=" + Program.Names(src, st.order));
        Console.WriteLine("bottom5 max=" + src.CellText(st.order[st.order.Count - 1], 1));

        st.filters[1].topMode = 3;
        st.filters[1].topN = 1;
        st.dirty = true;
        DataTable.Recompute(st, cols, src);
        Console.WriteLine("top1pct count=" + Convert.ToString(st.order.Count));
        Console.WriteLine("top1pct first=" + Program.Names(src, st.order));

        st.filters[1].topMode = 1;
        st.filters[1].topN = 1;
        st.dirty = true;
        DataTable.Recompute(st, cols, src);
        Console.WriteLine("tie count=" + Convert.ToString(st.order.Count));
        Console.WriteLine("tie first=" + Program.Names(src, st.order));
    }
}
