// 运行期 HTML 装载的中文字符用例：夹具（.html 含中文与任意 ASCII 乱码）
// 经 --embed 烤进 exe，LoadHtmlWith 装载——原始文本只进 HTML 解析器，
// 绝不进 Zan 词法器（旧编译期通道曾把原始 HTML 喂给词法器，每个中文
// 字节都报 unexpected character）。断言建出的树与事件参数在中文字面量
// 下依然逐字正确。
using System;
using System.IO;
using Gui;
using Gui.Widget;

class HtmlCjkProbe {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void Main() {
        fails = 0;
        Html.Install(); // App 编译图不背 HTML 声明层，用 LoadHtml 的宿主先装。
        Form f = Form.Create("cjk", 400, 300);
        App app = f.GetApp();
        string doc = File.ReadAllText("tests/gui/html_runtime_cjk.html");
        Control root = app.LoadHtmlWith(doc, null, "");
        if (root == null) { Console.WriteLine("FAIL: html loader missing"); return; }
        HtmlCjkProbe.Eq("root kind", root.Kind(), "body");
        Control title = root.children[0];
        HtmlCjkProbe.Eq("title kind", title.Kind(), "Label");
        HtmlCjkProbe.Eq("title text", title.GetProp("text"), "微聊登录");
        Control user = root.children[1];
        HtmlCjkProbe.Eq("placeholder", ((Input)user).GetProp("placeholder"),
                        "微信号 / 昵称");
        Control go = root.children[2];
        HtmlCjkProbe.Eq("go text", go.GetProp("text"), "进入微聊");

        string got = "";
        HtmlHandlers hs = new HtmlHandlers();
        hs.AddArg("go", (string s) => { got = s; });
        Control root2 = app.LoadHtmlWith(doc, hs, "");
        if (root2 == null) { Console.WriteLine("FAIL: html loader missing"); return; }
        ((Button)root2.children[2]).Click.Raise();
        HtmlCjkProbe.Eq("cjk arg", got, "中文参数");

        if (fails == 0) { Console.WriteLine("GUI_HTML_CJK_OK"); }
    }
}
