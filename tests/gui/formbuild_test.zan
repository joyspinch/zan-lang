using System;
using System.Json;
using Gui;
using Gui.Widget;

// 接口数据协议与执行契约。
class FormBuildTest {
    static int fails;

    static void Ok(string what, bool cond) {
        if (cond) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static JsonValue Field(string kind, string label, string name) {
        JsonValue o = JsonValue.NewObject();
        o.Put("kind", JsonValue.NewStr(kind));
        if (label != "") { o.Put("label", JsonValue.NewStr(label)); }
        if (name != "") { o.Put("name", JsonValue.NewStr(name)); }
        return o;
    }

    static void Main() {
        fails = 0;

        JsonValue doc = JsonValue.NewObject();
        doc.Put("name", JsonValue.NewStr("FbDoc"));
        JsonValue fields = JsonValue.NewArray();

        JsonValue fin = Field("Input", "Name", "in1");
        fin.Put("placeholder", JsonValue.NewStr("your name"));
        fields.Append(fin);

        JsonValue fcb = Field("Checkbox", "Agree", "agree");
        fcb.Put("defOn", JsonValue.NewBool(true));
        fields.Append(fcb);

        JsonValue fpan = JsonValue.NewObject();
        fpan.Put("kind", JsonValue.NewStr("Panel"));
        JsonValue kids = JsonValue.NewArray();
        kids.Append(Field("Label", "inner", ""));
        fpan.Put("kids", kids);
        fields.Append(fpan);

        doc.Put("fields", fields);

        Control root = FormBuilder.Build(doc);
        Ok("root built", root != null);
        Eq("root name", root.name, "root");
        Ok("flow is the only child", root.ChildCount() == 1);

        FbFlow flow = (FbFlow)root.children[0];
        Eq("three cells", Convert.ToString(flow.ChildCount()), "3");

        // 接口数据协议与执行契约。
        Control c0 = flow.children[0];
        Ok("caption cell wraps input", c0 is FbStack);
        FbStack st = (FbStack)c0;
        Eq("caption text", st.children[0].GetProp("text"), "Name");
        Eq("placeholder reaches input", st.children[1].GetProp("placeholder"),
           "your name");

        // 接口数据协议与执行契约。
        Control cb = flow.children[1];
        Eq("checkbox label", cb.GetProp("label"), "Agree");
        Eq("checkbox defOn", cb.GetProp("defOn"), "true");

        // 接口数据协议与执行契约。
        Control pan = flow.children[2];
        Ok("container keeps its flow", pan.ChildCount() == 1);
        Eq("container text stays empty", pan.GetProp("text"), "");
        Ok("container kid built", pan.children[0].ChildCount() == 1);

        if (fails == 0) { Console.WriteLine("FORMBUILD_OK"); }
    }
}
