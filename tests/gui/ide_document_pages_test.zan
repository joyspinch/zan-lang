using System;
using System.IO;
using System.Globalization;
using Gui;
using Gui.Widget;

// The dedicated registration links real pages, row templates, models and staging.
// Its only shell fixture supplies ZanIDE.T; no IDE startup or editor fixture runs.
class IdeDocumentPagesOwner : IdeDocumentPageOwner {
    public int Count;
    public int Action;
    public bool Accept;
    public string Path = "";
    public weak StartPage StartSender;
    public weak DiffView DiffSender;
    public StartPage HeldStart;
    public DiffView HeldDiff;

    public void StartPageAction(StartPage sender, int action, string path) {
        Count = Count + 1; StartSender = sender; DiffSender = null;
        Action = action; Path = path;
    }
    public void DiffViewAction(DiffView sender, bool accept, string path) {
        Count = Count + 1; DiffSender = sender; StartSender = null;
        Accept = accept; Path = path;
    }
}

class IdeDocumentPagesSnapshot {
    public List<Control> Nodes = new List<Control>();
    public List<string> States = new List<string>();

    public void Capture(Control node) {
        Nodes.Add(node);
        States.Add(node.Kind() + "|" + node.name + "|" + node.Class + "|" + node.GetProp("text")
        + "|" + Convert.ToString(node.bx) + "," + Convert.ToString(node.by)
        + "," + Convert.ToString(node.bw) + "," + Convert.ToString(node.bh)
        + "|" + Convert.ToString(node.ChildCount()) + "|" + node.GetProp("visible"));
        for (int i = 0; i < node.ChildCount(); i = i + 1) { this.Capture(node.ChildAt(i)); }
    }
    public void Check(Control root) {
        IdeDocumentPagesSnapshot after = new IdeDocumentPagesSnapshot(); after.Capture(root);
        IdeDocumentPagesTest.Check(Nodes.Count == after.Nodes.Count, "Paint preserves the complete page tree");
        for (int i = 0; i < Nodes.Count; i = i + 1) {
            IdeDocumentPagesTest.Check(Nodes[i] == after.Nodes[i] && States[i] == after.States[i],
            "Paint preserves every retained node, geometry, text and visibility");
        }
    }
}

class IdeDocumentPagesWitness {
    public weak IdeDocumentPagesOwner Owner;
    public weak App StartApp;
    public weak App DiffApp;
    public weak StartPage Start;
    public weak DiffView Diff;
    public weak Control Recent;
    public weak Control Quick;
    public weak Control Accept;
    public Control HeldRecent;
    public UiEvent QuickEndpoint;
    public UiEvent AcceptEndpoint;
    public UiEvent RejectEndpoint;
}

class IdeDocumentPagesTest {
    public static void Check(bool ok, string reason) { if (!ok) { throw new Exception(reason); } }

    static App Host(string title) {
        App app = App.CreateOffscreen(title, 2200, 1100);
        app.UseAppCss(File.ReadAllText("src/ide_zan/assets/ide.css"));
        return app;
    }
    static void PrepareAt(App app, Control page, int x, int y, int width, int height) {
        page.UseApp(app); app.SetRootControl(page);
        page.MeasureTree(app, width); page.Arrange(x, y, width, height);
    }
    static void Prepare(App app, Control page, int width, int height) {
        PrepareAt(app, page, 24, 28, width, height);
    }
    static void Drain(App app) {
        app.DrainPosts();
        while (true) { Action action = Dispatcher.Take(); if (action == null) { break; } action(); }
    }
    static void Input(App app, int kind, int x, int y) {
        // This is App's real offscreen input entry: DispatchWindowInput routes
        // Down/Up through HitTest, capture and the production semantic handlers.
        app.ProcessOffscreenInput(kind, x, y, 0, 0, 0, 0);
    }
    static void ClickAt(App app, int x, int y) { Input(app, 2, x, y); Input(app, 3, x, y); }
    static void ClickControl(App app, Control control) {
        Check(control != null && control.bw > 0 && control.bh > 0, "production control is prepared before Paint");
        ClickAt(app, control.bx + control.bw / 2, control.by + control.bh / 2);
    }
    static Button ButtonNamed(Control root, string name) {
        Control control = root.FindByName(name);
        Check(control is Button, "named production button exists in the real child tree");
        return (Button)control;
    }
    static void Down(App app, Button button) {
        Check(button.bw > 0 && button.bh > 0, "button is arranged before input");
        Input(app, 2, button.bx + button.bw / 2, button.by + button.bh / 2);
        Check(app.GetCapturedPointer() == button, "real Down captures the production button before Paint");
    }
    static void Up(App app, Button button) {
        Input(app, 3, button.bx + button.bw / 2, button.by + button.bh / 2);
    }
    static void ClickButton(App app, Button button) { Down(app, button); Up(app, button); }
    static void QueueMutation(App app, Button button, Action mutation) {
        Down(app, button);
        // EndLoopTurn drains this mutation before the real Button.Click callback
        // queued by Up. No test calls Click.Raise/TriggerEvent or a page action.
        app.Post(mutation); Up(app, button);
    }
    static Control ListWithClass(Control root, string cls) {
        if (root.Kind() == "ListView" && Style.Has(root.Class, cls)) { return root; }
        for (int i = 0; i < root.ChildCount(); i = i + 1) {
            Control found = ListWithClass(root.ChildAt(i), cls);
            if (found != null) { return found; }
        }
        return null;
    }
    static List<RecentItem> Recents(string path) {
        List<RecentItem> items = new List<RecentItem>(); items.Add(RecentItem.Create(path)); return items;
    }
    static List<NewsItem> News(string link) {
        List<NewsItem> items = new List<NewsItem>();
        items.Add(NewsItem.Create("Retained document pages", "IDE", "info", link)); return items;
    }
    static void Populate(StartPage page, string path, string link) {
        page.SetRecents(Recents(path)); page.SetNews(News(link));
    }
    static void ExpectStart(IdeDocumentPagesOwner owner, StartPage page, int count, int action, string path) {
        Check(owner.Count == count && owner.StartSender == page && owner.DiffSender == null
        && owner.Action == action && owner.Path == path,
        "Start input synchronously submits the exact instance, action and path snapshot");
    }
    static void ExpectDiff(IdeDocumentPagesOwner owner, DiffView page, int count, bool accept, string path) {
        Check(owner.Count == count && owner.DiffSender == page && owner.StartSender == null
        && owner.Accept == accept && owner.Path == path,
        "Diff input synchronously submits the exact instance, accept flag and path snapshot");
    }
    static void PaintReadOnly(App app, Control page) {
        IdeDocumentPagesSnapshot snapshot = new IdeDocumentPagesSnapshot(); snapshot.Capture(page);
        app.BeginOffscreenFrame();
        page.RenderTree(app); snapshot.Check(page);
        page.RenderTree(app); snapshot.Check(page);
        app.EndOffscreenFrame(); snapshot.Check(page);
    }
    static void Close(App app) {
        app.SetRootControl(null); app.StopLoop(); Drain(app); app.canvas.Destroy();
    }
    static string Bounds(Control control) {
        return Convert.ToString(control.bx) + "," + Convert.ToString(control.by)
        + "," + Convert.ToString(control.bw) + "," + Convert.ToString(control.bh);
    }
    static string CaptureName(App app) {
        Control captured = app.GetCapturedPointer();
        return captured != null ? captured.name + "/" + captured.Kind() : "null";
    }
    static void MoveHostAndClick(App app, Control page, Button button, IdeDocumentPagesOwner owner) {
        string name = button.name; string oldHost = Bounds(page); string oldButton = Bounds(button);
        int oldX = button.bx + button.bw / 2; int oldY = button.by + button.bh / 2;
        int count = owner.Count; int newY = oldY + app.Scale(32);
        // Width alone need not move a button in the capped recent-project card.
        // Move the host below the old click point while keeping it on the canvas.
        PrepareAt(app, page, 24, newY, 1900, app.canvas.Height() - newY - app.Scale(24));
        string detail = name + " host=" + oldHost + "->" + Bounds(page) + " button=" + oldButton + "->" + Bounds(button)
        + " oldPoint=" + Convert.ToString(oldX) + "," + Convert.ToString(oldY);
        Check(page.FindByName(name) == button && !page.ContainsPoint(oldX, oldY) && !button.ContainsPoint(oldX, oldY),
        "moved host keeps identity and retires old bounds: " + detail);
        Input(app, 2, oldX, oldY);
        Check(app.GetCapturedPointer() == null && owner.Count == count,
        "old Down captured=" + CaptureName(app) + ": " + detail);
        Input(app, 3, oldX, oldY);
        Check(app.GetCapturedPointer() == null && owner.Count == count,
        "old Up count=" + Convert.ToString(owner.Count) + "/" + Convert.ToString(count) + ": " + detail);
        int edgeX = button.bx + button.bw - 1; int edgeY = button.by + button.bh / 2;
        detail = detail + " edge=" + Convert.ToString(edgeX) + "," + Convert.ToString(edgeY);
        Check(button.bw > 0 && button.bh > 0 && page.ContainsPoint(edgeX, edgeY), "new edge is in host: " + detail);
        Input(app, 2, edgeX, edgeY);
        Check(app.GetCapturedPointer() == button, "new edge captured=" + CaptureName(app) + ": " + detail);
        Input(app, 3, edgeX, edgeY);
        Check(app.GetCapturedPointer() == null && owner.Count == count + 1,
        "new edge Up count=" + Convert.ToString(owner.Count) + "/" + Convert.ToString(count + 1) + ": " + detail);
    }

    static Control ClassChild(Control parent, string cls) {
        for (int i = 0; i < parent.ChildCount(); i = i + 1) {
            Control child = parent.ChildAt(i);
            if (Style.Has(child.Class, cls)) { return child; }
        }
        return null;
    }
    static void Inside(Control outer, Control inner, string reason) {
        Check(inner != null && inner.bw > 0 && inner.bh > 0
        && inner.bx >= outer.bx && inner.by >= outer.by
        && inner.bx + inner.bw <= outer.bx + outer.bw
        && inner.by + inner.bh <= outer.by + outer.bh,
        reason + " outer=" + Bounds(outer) + " inner=" + (inner != null ? Bounds(inner) : "null"));
    }
    static void CardGeometry(StartPage page) {
        Control recent = page.FindByName("start-recent-card");
        Control articles = page.FindByName("start-news-card");
        Control list = page.FindByName("start-recents");
        Control news = page.FindByName("start-news");
        Control quick = page.FindByName("start-quick");
        Check(recent != null && articles != null && list != null && news != null && quick != null,
        "production Start page exposes its semantic cards, lists and actions");
        Control header = ClassChild(recent, "card-header");
        Control body = ClassChild(recent, "card-body");
        Control footer = ClassChild(recent, "card-footer");
        Inside(recent, header, "recent title stays within its card");
        Inside(recent, body, "recent body stays within its card");
        Inside(recent, footer, "recent footer stays within its card");
        Inside(body, list, "recent list fills the real Card.Content slot");
        Inside(footer, quick, "quick actions stay in the real Card.Action slot");
        Check(header.by + header.bh <= body.by && body.by + body.bh <= footer.by,
        "recent title, empty/list body and actions occupy separate rows");
        Control newsHeader = ClassChild(articles, "card-header");
        Control newsBody = ClassChild(articles, "card-body");
        Inside(articles, newsHeader, "news title stays within its card");
        Inside(articles, newsBody, "news body stays within its card");
        Inside(newsBody, news, "news list fills the real Card.Content slot");
        Check(newsHeader.by + newsHeader.bh <= newsBody.by, "news title never intersects articles");
        for (int i = 0; i < quick.ChildCount(); i = i + 1) {
            Control action = quick.ChildAt(i); Inside(quick, action, "every quick action remains inside its group");
            Check(action.bw >= action.prefW && action.bh >= action.prefH, "quick actions retain measured text size");
            for (int j = i + 1; j < quick.ChildCount(); j = j + 1) {
                Control other = quick.ChildAt(j);
                Check(action.bx + action.bw <= other.bx || other.bx + other.bw <= action.bx
                || action.by + action.bh <= other.by || other.by + other.bh <= action.by,
                "wrapped quick actions never overlap");
            }
        }
    }
    static void StartLayout() {
        App app = Host("Start responsive Card layout");
        IdeDocumentPagesOwner owner = new IdeDocumentPagesOwner();
        StartPage page = new StartPage(); page.owner = owner;
        List<int> scales = new List<int> { 100, 150, 200 };
        for (int i = 0; i < scales.Count; i = i + 1) {
            app.dpiScale = scales[i]; app.SetTheme(Theme.Light());
            page.SetRecents(new List<RecentItem>()); page.SetNews(News("https://example.invalid/layout"));
            Prepare(app, page, app.Scale(900), app.Scale(520)); CardGeometry(page);
            Control recent = page.FindByName("start-recent-card");
            Control articles = page.FindByName("start-news-card");
            Check(recent.by == articles.by && recent.bx + recent.bw <= articles.bx,
            "wide Start has two readable columns");
            Check(articles.bw >= app.Scale(320) && page.ScrollTop() == 0,
            "wide news keeps a readable width without page scrolling");
            List<int> widths = new List<int> { 340, 280 };
            for (int j = 0; j < widths.Count; j = j + 1) {
                Prepare(app, page, app.Scale(widths[j]), app.Scale(420)); CardGeometry(page);
                Check(recent.bx == articles.bx && recent.by + recent.bh <= articles.by,
                "narrow Start stacks the same retained cards");
                Check(recent.bx >= page.bx && articles.bx >= page.bx
                && recent.bx + recent.bw <= page.bx + page.bw
                && articles.bx + articles.bw <= page.bx + page.bw,
                "stacked cards fit the document without horizontal scrolling");
                Check(page.scrollExtent > page.ScrollViewport().height, "narrow Start keeps articles reachable by scrolling");
            }
            Prepare(app, page, app.Scale(900), app.Scale(180)); CardGeometry(page);
            Check(page.scrollExtent > page.ScrollViewport().height, "short Start scrolls instead of crushing card content");
            Control quick = page.FindByName("start-quick");
            int before = quick.by;
            app.ProcessOffscreenInput(13, page.bx + app.Scale(4), page.by + app.Scale(4), 0, -120, 0, 0);
            Check(page.ScrollTop() > 0, "real wheel commits the short page offset before Paint");
            Prepare(app, page, app.Scale(900), app.Scale(180));
            Check(quick.by < before, "shell preparation projects the wheel offset before Paint");
            page.SetScrollTop(page.scrollExtent);
            Prepare(app, page, app.Scale(900), app.Scale(180));
            CardGeometry(page);
            Button action = ButtonNamed(page, "start-open-project"); Inside(page, action, "scrolled quick action is reachable");
            int count = owner.Count; ClickButton(app, action); ExpectStart(owner, page, count + 1, 4, "");
            PaintReadOnly(app, page);
            page.SetScrollTop(0);
        }
        Close(app);
    }

    static double LinearChannel(int channel) {
        double value = (double)channel / 255.0;
        return value <= 0.04045 ? value / 12.92 : Math.Pow((value + 0.055) / 1.055, 2.4);
    }
    static double Luminance(int color) {
        return 0.2126 * LinearChannel((color >> 16) & 255)
            + 0.7152 * LinearChannel((color >> 8) & 255) + 0.0722 * LinearChannel(color & 255);
    }
    static void NewsTagSkins() {
        App app = Host("real news tag roles"); StartPage page = new StartPage();
        List<string> roles = new List<string>{ "primary", "info", "success", "warning", "error" };
        List<NewsItem> items = new List<NewsItem>();
        for (int i = 0; i < roles.Count; i = i + 1) {
            items.Add(NewsItem.Create("Readable news", "IDE", roles[i], "https://example.invalid/news"));
        }
        page.SetNews(items); Prepare(app, page, 1180, 620);
        ListView<NewsItem> news = (ListView<NewsItem>)ListWithClass(page, "news");
        List<Control> rows = new List<Control>();
        for (int i = 0; i < roles.Count; i = i + 1) { rows.Add(news.RowControl(i)); }
        List<string> skins = new List<string>{ "porcelain", "graphite", "navy", "porcelain" };
        for (int i = 0; i < skins.Count; i = i + 1) {
            int index = app.SkinIndexOf(skins[i]);
            Check(index >= 0, "news tag skin exists " + skins[i]); app.ApplySkin(index);
            app.BeginOffscreenFrame(); Prepare(app, page, 1180, 620); page.RenderTree(app);
            for (int role = 0; role < roles.Count; role = role + 1) {
                string phase = skins[i] + " " + roles[role];
                Control row = news.RowControl(role);
                Check(row is NewsRow && row == rows[role] && row.ChildAt(0) is Tag,
                    "news retains its real row and Tag across skin changes " + phase);
                Tag chip = (Tag)row.ChildAt(0);
                Check(chip.ChildAt(0) is Label, "news Tag owns its real text Label " + phase);
                Label text = (Label)chip.ChildAt(0);
                StyleBox fill = chip.computedStyle; StyleBox ink = text.computedStyle;
                Check(fill != null && ink != null && chip.bw > 0 && chip.bh > 0 && text.bw > 0 && text.bh > 0,
                    "news role fill and text are actually prepared and painted " + phase);
                int background = fill.BgOr(0); int foreground = ink.FgOr(0);
                Check(background == Style.Full(app, "tag", roles[role], "", Style.SNormal()).BgOr(0),
                    "news Tag paints its actual semantic role background " + phase);
                Check(foreground == fill.FgOr(0) && foreground == app.theme.textInverse,
                    "news text consumes the same inverse foreground as its role fill " + phase);
                double a = Luminance(background); double b = Luminance(foreground);
                double ratio = a >= b ? (a + 0.05) / (b + 0.05) : (b + 0.05) / (a + 0.05);
                Check(ratio >= 4.5, "actual news Label foreground contrasts with Tag background " + phase);
                Check(app.canvas.GetPixel(chip.bx + chip.bw / 2, chip.by + chip.bh - 2) == background,
                    "news Tag role background reaches the final pixels " + phase);
            }
            app.EndOffscreenFrame();
        }
        Close(app);
    }

    static void StartInput() {
        App firstApp = Host("first real Start page"); App secondApp = Host("second real Start page");
        StartPage first = new StartPage(); StartPage second = new StartPage();
        IdeDocumentPagesOwner firstOwner = new IdeDocumentPagesOwner();
        IdeDocumentPagesOwner secondOwner = new IdeDocumentPagesOwner();
        first.owner = firstOwner; second.owner = secondOwner;
        Populate(first, "first/project.zan", "https://example.invalid/first");
        Populate(second, "second/project.zan", "https://example.invalid/second");
        Prepare(firstApp, first, 1180, 620); Prepare(secondApp, second, 1180, 620);
        Check(first.FindByName("ide-start-page") == first && second.FindByName("ide-start-page") == second,
        "each Start page is its own retained input root");
        List<string> names = new List<string> { "start-new-project", "start-new-file", "start-open-file", "start-open-project" };
        for (int i = 0; i < names.Count; i = i + 1) {
            ClickButton(firstApp, ButtonNamed(first, names[i]));
            ExpectStart(firstOwner, first, i + 1, i + 1, "");
            Check(secondOwner.Count == 0, "constructing another Start page cannot redirect first-page quick input");
        }
        ClickButton(secondApp, ButtonNamed(second, "start-new-file"));
        ExpectStart(secondOwner, second, 1, 2, "");
        Check(firstOwner.Count == 4, "second-page quick input cannot replay first-page actions");

        ListView<RecentItem> recentList = (ListView<RecentItem>)ListWithClass(first, "recent");
        ListView<NewsItem> newsList = (ListView<NewsItem>)ListWithClass(first, "news");
        Check(recentList != null && newsList != null && recentList.RowControl(0) is RecentRow
        && newsList.RowControl(0) is NewsRow, "real row templates are adopted and arranged before Paint");
        Control row = recentList.RowControl(0);
        ClickAt(firstApp, row.bx + 8, row.by + row.bh / 2);
        ExpectStart(firstOwner, first, 5, 5, "first/project.zan");
        Control article = newsList.RowControl(0); ClickControl(firstApp, article);
        ExpectStart(firstOwner, first, 6, 6, "https://example.invalid/first");
        ClickButton(firstApp, ButtonNamed(row, "recent-remove"));
        ExpectStart(firstOwner, first, 7, 7, "first/project.zan");
        ListView<RecentItem> secondRecents = (ListView<RecentItem>)ListWithClass(second, "recent");
        ClickButton(secondApp, ButtonNamed(secondRecents.RowControl(0), "recent-remove"));
        ExpectStart(secondOwner, second, 2, 7, "second/project.zan");
        Check(firstOwner.Count == 7, "Recent remove dispatch stays with its owning page");

        Button retiredClose = ButtonNamed(row, "recent-remove");
        QueueMutation(firstApp, retiredClose, () => {
            first.SetRecents(Recents("first/replacement.zan")); Prepare(firstApp, first, 1180, 620);
        });
        Check(firstOwner.Count == 7 && !first.ContainsInputControl(row) && row.FindApp() == null,
        "real queued close from a retired RecentRow cannot submit against its surviving page");
        row = recentList.RowControl(0);
        ClickButton(firstApp, ButtonNamed(row, "recent-remove"));
        ExpectStart(firstOwner, first, 8, 7, "first/replacement.zan");
        first.SetNews(News("https://example.invalid/rebound")); Prepare(firstApp, first, 1180, 620);
        ClickControl(firstApp, newsList.RowControl(0));
        ExpectStart(firstOwner, first, 9, 6, "https://example.invalid/rebound");

        Button hidden = ButtonNamed(first, "start-open-project");
        QueueMutation(firstApp, hidden, () => { first.SetShown(false); });
        Check(firstOwner.Count == 9 && firstApp.GetCapturedPointer() == null,
        "hiding Start rejects an already queued real quick action");
        ClickAt(firstApp, hidden.bx + hidden.bw / 2, hidden.by + hidden.bh / 2);
        Check(firstOwner.Count == 9, "hidden Start page cannot receive physical input");
        first.SetShown(true); Prepare(firstApp, first, 1180, 620);

        Button resized = ButtonNamed(first, "start-new-project");
        MoveHostAndClick(firstApp, first, resized, firstOwner);
        ExpectStart(firstOwner, first, 10, 1, "");
        PaintReadOnly(firstApp, first); PaintReadOnly(secondApp, second);
        Check(firstOwner.Count == 10 && secondOwner.Count == 2, "repeated Start Paint cannot replay any action");
        Close(firstApp); Close(secondApp); Console.WriteLine("IDE_DOCUMENT_PAGES_START_INPUT_OK");
    }

    static void DiffInputAndRefresh() {
        string firstPath = "build/cases/ide_document_pages_source_a.zan";
        string secondPath = "build/cases/ide_document_pages_source_b.zan";
        Check(!File.Exists(firstPath) && !File.Exists(secondPath), "staging fixture paths have no physical source files");
        AiStaging.Clear(); AiStaging.Stage("", firstPath, "original-preview");
        AiStaging.Stage("", secondPath, "second-preview");
        App firstApp = Host("first real Diff page"); App secondApp = Host("second real Diff page");
        DiffView first = new DiffView(); DiffView second = new DiffView();
        IdeDocumentPagesOwner firstOwner = new IdeDocumentPagesOwner();
        IdeDocumentPagesOwner secondOwner = new IdeDocumentPagesOwner();
        first.owner = firstOwner; second.owner = secondOwner;
        first.BindPath("@diff:" + firstPath); second.BindPath("@diff:" + secondPath);
        Prepare(firstApp, first, 1180, 620); Prepare(secondApp, second, 1180, 620);
        Check(first.FindByName("ide-diff-page") == first && second.FindByName("ide-diff-page") == second,
        "each Diff page is its own retained input root");
        Button accept = ButtonNamed(first, "diff-accept"); Button reject = ButtonNamed(first, "diff-reject");
        ClickButton(firstApp, accept); ExpectDiff(firstOwner, first, 1, true, firstPath);
        ClickButton(firstApp, reject); ExpectDiff(firstOwner, first, 2, false, firstPath);
        Check(secondOwner.Count == 0, "constructing another Diff cannot redirect either first-page button");
        ClickButton(secondApp, ButtonNamed(second, "diff-accept"));
        ExpectDiff(secondOwner, second, 1, true, secondPath);
        ClickButton(secondApp, ButtonNamed(second, "diff-reject"));
        ExpectDiff(secondOwner, second, 2, false, secondPath);
        Check(firstOwner.Count == 2, "second Diff buttons cannot alter first-page action snapshots");

        ListView<DiffLine> lines = (ListView<DiffLine>)first.ChildAt(1);
        Check(lines.RowControl(0) is Label && lines.RowControl(0).GetProp("text").Contains("original-preview"),
        "real DiffRow text is prepared from staged content before Paint");
        StagedFile before = AiStaging.Get(firstPath); Control oldRow = lines.RowControl(0);
        StagedFile changed = AiStaging.Stage("", firstPath, "fresh-one\nfresh-two");
        Check(changed == before, "same-path Stage mutates the existing real StagedFile");
        first.BindPath("@diff:" + firstPath); Prepare(firstApp, first, 1180, 620);
        Check(lines.data == changed.diffs && lines.Count() == 2 && lines.RowControl(0) != oldRow
        && lines.RowControl(0).GetProp("text").Contains("fresh-one")
        && lines.RowControl(1).GetProp("text").Contains("fresh-two"),
        "same-path staging refreshes production rows instead of returning a stale path cache");
        Check(first.ChildAt(0).ChildAt(1).GetProp("text") == "  +2 -0",
        "same-path staging refreshes displayed add/delete statistics");
        // Acceptance IO belongs to the shell. The page projects this real staged
        // record's state without writing extra fixture files to the workspace.
        changed.accepted = true; first.BindPath("@diff:" + firstPath); Prepare(firstApp, first, 1180, 620);
        string acceptedText = Lang.Tr("Accepted", "已接受");
        Check(first.ChildAt(0).ChildAt(0).GetProp("text") == "Diff: " + firstPath + " [" + acceptedText + "]",
        "same-path accepted state refreshes the title before Paint");
        AiStaging.Stage("", firstPath, "pending-again");
        first.BindPath("@diff:" + firstPath); Prepare(firstApp, first, 1180, 620);
        string pendingText = Lang.Tr("Pending Review", "待审阅");
        Check(first.ChildAt(0).ChildAt(0).GetProp("text") == "Diff: " + firstPath + " [" + pendingText + "]"
        && lines.Count() == 1 && lines.RowControl(0).GetProp("text").Contains("pending-again"),
        "staging an accepted path again resets review state and replaces text");
        Control stableRow = lines.RowControl(0);
        first.BindPath("@diff:" + firstPath); Prepare(firstApp, first, 1180, 620);
        Check(lines.RowControl(0) == stableRow, "unchanged BindPath preserves retained DiffRow identity");
        ListView<DiffLine> secondLines = (ListView<DiffLine>)second.ChildAt(1);
        Check(secondLines.Count() == 1 && secondLines.RowControl(0).GetProp("text").Contains("second-preview")
        && second.ChildAt(0).ChildAt(0).GetProp("text").Contains(secondPath) && secondOwner.Path == secondPath,
        "refreshing first Diff preserves the second instance's rows, title and action snapshot");

        QueueMutation(firstApp, accept, () => {
            first.BindPath("@diff:" + secondPath); Prepare(firstApp, first, 1180, 620);
        });
        Check(first.CurrentPath() == secondPath && ButtonNamed(first, "diff-accept") == accept,
        "queued accept rebind prepares the new path in the same retained button");
        ExpectDiff(firstOwner, first, 2, false, firstPath);
        ClickButton(firstApp, accept); ExpectDiff(firstOwner, first, 3, true, secondPath);
        QueueMutation(firstApp, reject, () => {
            first.BindPath("@diff:" + firstPath); Prepare(firstApp, first, 1180, 620);
        });
        Check(first.CurrentPath() == firstPath && ButtonNamed(first, "diff-reject") == reject,
        "queued reject rebind prepares the new path in the same retained button");
        ExpectDiff(firstOwner, first, 3, true, secondPath);
        ClickButton(firstApp, reject); ExpectDiff(firstOwner, first, 4, false, firstPath);
        QueueMutation(firstApp, accept, () => {
            AiStaging.Stage("", firstPath, "queued-refresh");
            first.BindPath("@diff:" + firstPath); Prepare(firstApp, first, 1180, 620);
        });
        Check(first.CurrentPath() == firstPath && ButtonNamed(first, "diff-accept") == accept
        && lines.RowControl(0).GetProp("text").Contains("queued-refresh"),
        "same-path Stage prepares refreshed content while retaining the accept button");
        ExpectDiff(firstOwner, first, 4, false, firstPath);
        QueueMutation(firstApp, accept, () => { first.SetShown(false); });
        Check(firstOwner.Count == 4 && firstApp.GetCapturedPointer() == null,
        "hiding Diff rejects an already queued accept action");
        ClickControl(firstApp, accept); ClickControl(firstApp, reject);
        Check(firstOwner.Count == 4, "hidden Diff buttons cannot submit input");
        first.SetShown(true); Prepare(firstApp, first, 1180, 620);

        MoveHostAndClick(firstApp, first, accept, firstOwner);
        ExpectDiff(firstOwner, first, 5, true, firstPath);
        PaintReadOnly(firstApp, first); PaintReadOnly(secondApp, second);
        Check(firstOwner.Count == 5 && secondOwner.Count == 2, "repeated Diff Paint cannot replay actions");
        Close(firstApp); Close(secondApp); AiStaging.Clear();
        Console.WriteLine("IDE_DOCUMENT_PAGES_DIFF_REFRESH_OK");
    }

    static void LendOwner(StartPage start, DiffView diff, IdeDocumentPagesWitness witness) {
        IdeDocumentPagesOwner owner = new IdeDocumentPagesOwner();
        owner.HeldStart = start; owner.HeldDiff = diff;
        start.owner = owner; diff.owner = owner; witness.Owner = owner;
    }
    static void OwnerRelease() {
        App startApp = Host("Start weak owner"); App diffApp = Host("Diff weak owner");
        StartPage start = new StartPage(); DiffView diff = new DiffView();
        Populate(start, "weak/owner.zan", "https://example.invalid/weak"); diff.BindPath("weak/owner.zan");
        Prepare(startApp, start, 1180, 620); Prepare(diffApp, diff, 1180, 620);
        IdeDocumentPagesWitness witness = new IdeDocumentPagesWitness(); LendOwner(start, diff, witness);
        Check(witness.Owner == null && start.owner == null && diff.owner == null,
        "live pages and their event relays do not retain a shell owner which owns the pages");
        ClickButton(startApp, ButtonNamed(start, "start-new-file"));
        ClickButton(startApp, ButtonNamed(start, "recent-remove"));
        ClickButton(diffApp, ButtonNamed(diff, "diff-accept"));
        ClickButton(diffApp, ButtonNamed(diff, "diff-reject"));
        Close(startApp); Close(diffApp);
    }
    static void LendPages(IdeDocumentPagesWitness witness, IdeDocumentPagesOwner owner) {
        App startApp = Host("Start weak page"); App diffApp = Host("Diff weak page");
        StartPage start = new StartPage(); DiffView diff = new DiffView();
        start.owner = owner; diff.owner = owner;
        Populate(start, "weak/page.zan", "https://example.invalid/page"); diff.BindPath("weak/page.zan");
        Prepare(startApp, start, 1180, 620); Prepare(diffApp, diff, 1180, 620);
        witness.StartApp = startApp; witness.DiffApp = diffApp; witness.Start = start; witness.Diff = diff;
        witness.HeldRecent = ((ListView<RecentItem>)ListWithClass(start, "recent")).RowControl(0);
        witness.Recent = witness.HeldRecent;
        Button quick = ButtonNamed(start, "start-new-project"); Button accept = ButtonNamed(diff, "diff-accept");
        witness.Quick = quick; witness.Accept = accept;
        witness.QuickEndpoint = quick.Click; witness.AcceptEndpoint = accept.Click;
        witness.RejectEndpoint = ButtonNamed(diff, "diff-reject").Click;
        Close(startApp); Close(diffApp);
    }
    static void WeakRelease() {
        OwnerRelease();
        IdeDocumentPagesWitness witness = new IdeDocumentPagesWitness();
        IdeDocumentPagesOwner owner = new IdeDocumentPagesOwner(); LendPages(witness, owner);
        Check(witness.Start == null && witness.Diff == null && witness.Quick == null && witness.Accept == null
        && witness.StartApp == null && witness.DiffApp == null && witness.Recent != null,
        "pages, Apps and buttons release while real event endpoints and a RecentRow remain retained");
        witness.HeldRecent = null;
        Check(witness.Recent == null && owner.Count == 0, "retained RecentRow and its weak page relay release without actions");
        witness.QuickEndpoint = null; witness.AcceptEndpoint = null; witness.RejectEndpoint = null;
        Console.WriteLine("IDE_DOCUMENT_PAGES_WEAK_RELEASE_OK");
    }
    static void Main() {
        // App's first instance is process-retained. Keep that primer independent
        // of every page/owner lifetime assertion below.
        App primer = App.CreateOffscreen("document page lifetime primer", 2, 2);
        Lang.Set(""); StartLayout(); NewsTagSkins(); StartInput(); DiffInputAndRefresh(); WeakRelease();
        AiStaging.Clear(); Lang.packs = null; Lang.dirs = null;
        primer.StopLoop(); primer.canvas.Destroy();
    }
}
