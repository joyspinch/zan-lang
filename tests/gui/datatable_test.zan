using System;
using Gui;
using Gui.Widget;

namespace DataTableTest;

/// Headless verification of DataTable's data pipeline: loose ParseReal,
/// half-up FormatReal, decimal/date/bool-aware cell compare and format, the
/// filter stages (comparison, date presets, top-N), cell-cursor movement, and
/// a full sort + footer-aggregate pass where fractions must survive (a sum
/// keeps its cents, an average is not truncated to an int).
class Program {
    static DataRow Row(string a, string b, string c) {
        DataRow r = DataRow.Create();
        r.Push(a);
        r.Push(b);
        r.Push(c);
        return r;
    }

    static DataRow Row2(string a, string b) {
        DataRow r = DataRow.Create();
        r.Push(a);
        r.Push(b);
        return r;
    }

    static void Main() {
        // ---- ParseReal accepts separators / currency / sign; FormatReal is half-up ----
        Console.WriteLine(DataTable.FormatReal(DataTable.ParseReal("1234.5678"), 4));
        Console.WriteLine(DataTable.FormatReal(DataTable.ParseReal("$1,234.50"), 2));
        Console.WriteLine(DataTable.FormatReal(DataTable.ParseReal("-0.75"), 2));
        Console.WriteLine(DataTable.FormatReal(2.345, 2));
        Console.WriteLine(DataTable.FormatReal(7.6, 0));

        // ---- a decimals>0 column compares by value, so 1.5 and 1.9 no longer tie ----
        DataColumn rc = DataColumn.Real("v", 60, 2);
        Console.WriteLine(DataTable.CompareCellCol(rc, "1.5", "1.9"));
        Console.WriteLine(DataTable.CompareCellCol(rc, "1.9", "1.5"));
        Console.WriteLine(DataTable.CompareCellCol(rc, "1.5", "1.50"));

        // ---- FormatCell renders to the column's declared decimals ----
        Console.WriteLine(DataTable.FormatCell(rc, "3.5"));
        Console.WriteLine(DataTable.FormatCell(rc, "3.567"));

        // ---- sort + aggregate through the grid pipeline ----
        List<DataColumn> cols = new List<DataColumn>();
        cols.Add(DataColumn.Create("name", 80));
        cols.Add(DataColumn.Sum(DataColumn.Real("val", 80, 2)));
        cols.Add(DataColumn.Avg(DataColumn.Numeric("qty", 80)));

        List<DataRow> rows = new List<DataRow>();
        rows.Add(Row("a", "1.9", "3"));
        rows.Add(Row("b", "1.5", "4"));
        rows.Add(Row("c", "10.25", "0"));

        DataSource src = RowListSource.Create(rows);
        DataTableState st = DataTableState.Create();
        DataTable.EnsureInit(st, cols, src);

        DataTable.SortBy(st, 1, 1);
        st.dirty = true;
        DataTable.Recompute(st, cols, src);
        string seq = "";
        foreach (int oi in st.order) { seq = seq + src.CellText(oi, 0); }
        Console.WriteLine(seq);

        DataTable.SortBy(st, 1, 2);
        st.dirty = true;
        DataTable.Recompute(st, cols, src);
        seq = "";
        foreach (int oi in st.order) { seq = seq + src.CellText(oi, 0); }
        Console.WriteLine(seq);

        // sum keeps its cents; avg of 3+4+0 is 2.3333, not the truncated 2
        DataTable.ComputeSummary(st, cols, src);
        Console.WriteLine(DataTable.FormatReal(st.aggReal[1], 2));
        Console.WriteLine(DataTable.FormatReal(st.aggReal[2], 4));
        // The footer strings carry a non-ASCII sigma, so compare in-program and
        // print the verdict — the golden file stays pure ASCII.
        Console.WriteLine(st.summaryText[1] == Text.CharStr(931) + " 13.65");
        Console.WriteLine(st.summaryText[2]);

        // ---- date columns: parse, render, sort and bucket ----
        // A date column keys on days since the epoch, so a chronological order
        // holds across a year boundary where a string compare would not.
        Console.WriteLine(DataTable.ParseDate("2026-07-26", 0));
        Console.WriteLine(DataTable.ParseDate("2026/7/26", 0));
        Console.WriteLine(DataTable.ParseDate("20260726", 0));
        Console.WriteLine(DataTable.ParseDate("26/07/2026", 1));
        Console.WriteLine(DataTable.ParseDate("07/26/2026", 2));
        Console.WriteLine(DataTable.ParseDate("2026-07-26 13:45:00", 0));
        // two-digit years split at 70 (d-m-y order, so the year is last)
        Console.WriteLine(DataTable.ParseDate("01-01-99", 1) == DataTable.ParseDate("1999-01-01", 0));
        Console.WriteLine(DataTable.ParseDate("01-01-26", 1) == DataTable.ParseDate("2026-01-01", 0));
        // junk, an out-of-range day and a non-leap 29 Feb are all rejected...
        Console.WriteLine(DataTable.ParseDate("n/a", 0) == DataTable.NoDate());
        Console.WriteLine(DataTable.ParseDate("2026-02-30", 0) == DataTable.NoDate());
        Console.WriteLine(DataTable.ParseDate("2023-02-29", 0) == DataTable.NoDate());
        Console.WriteLine(DataTable.ParseDate("99-01-01", 1) == DataTable.NoDate());
        // ...but a real leap day parses
        Console.WriteLine(DataTable.ParseDate("2024-02-29", 0) == DataTable.NoDate());

        int day = DataTable.ParseDate("2026-07-26", 0);
        Console.WriteLine(DataTable.FormatDate(day, 0));
        Console.WriteLine(DataTable.FormatDate(day, 1));
        Console.WriteLine(DataTable.FormatDate(day, 2));
        Console.WriteLine(DataTable.FormatDate(day, 4));
        Console.WriteLine(DataTable.FormatDate(day, 5));
        Console.WriteLine(DataTable.FormatDate(day, 6));
        Console.WriteLine(DataTable.FormatDate(DataTable.NoDate(), 0) == "");

        Console.WriteLine(DataTable.DateGroupKey(day, 1));
        Console.WriteLine(DataTable.DateGroupKey(day, 2));
        Console.WriteLine(DataTable.DateGroupKey(day, 3));
        Console.WriteLine(DataTable.DateGroupKey(day, 4));

        // FormatCell normalises mixed stored spellings to one display pattern
        DataColumn dc = DataColumn.Date("when", 110);
        Console.WriteLine(DataTable.FormatCell(dc, "2026/7/6"));
        Console.WriteLine(DataTable.FormatCell(dc, "20260706"));
        Console.WriteLine(DataTable.FormatCell(dc, "not a date"));
        // chronological, not lexical: 2026-01-05 comes after 2025-12-31
        Console.WriteLine(DataTable.CompareCellCol(dc, "2025-12-31", "2026-01-05"));

        List<DataColumn> dcols = new List<DataColumn>();
        dcols.Add(DataColumn.Create("name", 80));
        dcols.Add(DataColumn.Date("when", 110));
        dcols.Add(DataColumn.Create("pad", 40));

        List<DataRow> drows = new List<DataRow>();
        drows.Add(Row("x", "2026-01-05", ""));
        drows.Add(Row("y", "2025-12-31", ""));
        drows.Add(Row("z", "2026-07-26", ""));

        DataSource dsrc = RowListSource.Create(drows);
        DataTableState dst = DataTableState.Create();
        DataTable.EnsureInit(dst, dcols, dsrc);
        DataTable.SortBy(dst, 1, 1);
        dst.dirty = true;
        DataTable.Recompute(dst, dcols, dsrc);
        seq = "";
        foreach (int oi in dst.order) { seq = seq + dsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        // grouping by month collapses the two 2026 dates into distinct buckets
        // but every day of one month into a single header
        DataColumn.DateGroup(dcols[1], 2);
        DataTable.GroupBy(dst, 1);
        dst.dirty = true;
        DataTable.Recompute(dst, dcols, dsrc);
        Console.WriteLine(dst.groups.Count);
        foreach (GroupRow g in dst.groups) { Console.WriteLine(g.label); }

        // ---- bool columns: parse, normalise, sort and toggle ----
        // Every accepted spelling reads as one truth value...
        Console.WriteLine(DataTable.ParseBool("1"));
        Console.WriteLine(DataTable.ParseBool("TRUE"));
        Console.WriteLine(DataTable.ParseBool(" Yes "));
        Console.WriteLine(DataTable.ParseBool("on"));
        // ...and everything else is false, including blanks and junk
        Console.WriteLine(DataTable.ParseBool("0"));
        Console.WriteLine(DataTable.ParseBool("false"));
        Console.WriteLine(DataTable.ParseBool(""));
        Console.WriteLine(DataTable.ParseBool("maybe"));

        DataColumn bc = DataColumn.BoolText(DataColumn.Bool("ok", 70), "Yes", "No");
        // FormatCell collapses a mixed vocabulary onto the column's own pair
        Console.WriteLine(DataTable.FormatCell(bc, "1"));
        Console.WriteLine(DataTable.FormatCell(bc, "TRUE"));
        Console.WriteLine(DataTable.FormatCell(bc, ""));
        // false sorts before true, and equal truths tie whatever the spelling
        Console.WriteLine(DataTable.CompareCellCol(bc, "0", "1"));
        Console.WriteLine(DataTable.CompareCellCol(bc, "yes", "1"));

        List<DataColumn> bcols = new List<DataColumn>();
        bcols.Add(DataColumn.Create("name", 80));
        bcols.Add(DataColumn.Editable(DataColumn.BoolText(DataColumn.Bool("ok", 70), "Yes", "No")));
        bcols.Add(DataColumn.Create("pad", 40));

        List<DataRow> brows = new List<DataRow>();
        brows.Add(Row("p", "yes", ""));
        brows.Add(Row("q", "0", ""));
        brows.Add(Row("r", "TRUE", ""));

        DataSource bsrc = RowListSource.Create(brows);
        DataTableState bst = DataTableState.Create();
        DataTable.EnsureInit(bst, bcols, bsrc);
        DataTable.SortBy(bst, 1, 1);
        bst.dirty = true;
        DataTable.Recompute(bst, bcols, bsrc);
        seq = "";
        foreach (int oi in bst.order) { seq = seq + bsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        // toggling writes the column's own text back and reports an edit
        DataTable.ToggleBoolCell(bst, bcols, bsrc, 1, 1);
        Console.WriteLine(bsrc.CellText(1, 1));
        Console.WriteLine(bsrc.CellBool(1, 1));
        DataTable.ToggleBoolCell(bst, bcols, bsrc, 1, 1);
        Console.WriteLine(bsrc.CellText(1, 1));
        Console.WriteLine(bst.EditValue());
        // a non-editable bool column ignores the toggle
        DataTable.ToggleBoolCell(bst, bcols, bsrc, 0, 2);
        Console.WriteLine(bsrc.CellText(0, 2) == "");

        // grouping yields exactly two buckets despite three spellings
        DataTable.GroupBy(bst, 1);
        bst.dirty = true;
        DataTable.Recompute(bst, bcols, bsrc);
        Console.WriteLine(bst.groups.Count);
        foreach (GroupRow g in bst.groups) { Console.WriteLine(g.label); }

        // ---- comparison rules compare by the column's type, not lexically ----
        ColFilter cf = ColFilter.Create();
        cf.cmpMode = 1;                 // greater than
        cf.cmpA = "9";
        // "10.25" > "9" numerically, though it sorts before "9" as text
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "10.25", 0));
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "1.5", 0));
        cf.cmpMode = 7;                 // between, inclusive
        cf.cmpA = "1.5";
        cf.cmpB = "2";
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "1.5", 0));
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "1.9", 0));
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "2.01", 0));
        // reversed bounds still describe the same range
        cf.cmpA = "2";
        cf.cmpB = "1.5";
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "1.9", 0));
        cf.cmpMode = 8;                 // not between inverts it exactly
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "1.9", 0));
        cf.cmpMode = 9;                 // is empty ignores the operands
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "   ", 0));
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "0", 0));
        cf.cmpMode = 10;
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "0", 0));

        // ---- date presets resolve against a fixed "today" ----
        // 2026-07-26 is a Sunday, so "this week" starts on that very day.
        int today = DateTime.DaysFromCivil(2026, 7, 26);
        ColFilter df = ColFilter.Create();
        df.datePreset = 1;              // today
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-26", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-25", today));
        // a cell with no readable date never satisfies a preset
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "n/a", today));
        df.datePreset = 3;              // this week (Sunday-based)
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-08-01", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-08-02", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-25", today));
        df.datePreset = 5;              // this month spans exactly July
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-01", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-31", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-08-01", today));
        df.datePreset = 7;              // Q3 = Jul..Sep
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-09-30", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-06-30", today));
        df.datePreset = 9;              // YTD stops at today, unlike "this year"
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-01-01", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-12-31", today));
        df.datePreset = 8;
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-12-31", today));
        df.datePreset = 10;             // past excludes today itself
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-26", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-25", today));
        df.datePreset = 11;             // and so does future
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-26", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-27", today));

        // ---- top-N runs over the surviving set, keeping the user's row order ----
        List<DataColumn> tcols = new List<DataColumn>();
        tcols.Add(DataColumn.Create("name", 80));
        tcols.Add(DataColumn.Real("v", 60, 1));
        tcols.Add(DataColumn.Create("pad", 40));

        List<DataRow> trows = new List<DataRow>();
        trows.Add(Row("a", "1", ""));
        trows.Add(Row("b", "5", ""));
        trows.Add(Row("c", "3", ""));
        trows.Add(Row("d", "9", ""));
        trows.Add(Row("e", "7", ""));

        DataSource tsrc = RowListSource.Create(trows);
        DataTableState tst = DataTableState.Create();
        DataTable.EnsureInit(tst, tcols, tsrc);
        tst.filters[1].topMode = 1;      // top 2 by value
        tst.filters[1].topN = 2;
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        // rows come back in source order (d before e), not ranked order
        seq = "";
        foreach (int oi in tst.order) { seq = seq + tsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        tst.filters[1].topMode = 2;      // bottom 2
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        seq = "";
        foreach (int oi in tst.order) { seq = seq + tsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        tst.filters[1].topMode = 5;      // above the mean of 5
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        seq = "";
        foreach (int oi in tst.order) { seq = seq + tsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        tst.filters[1].topMode = 3;      // top 40% of 5 rows = 2 rows
        tst.filters[1].topN = 40;
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        seq = "";
        foreach (int oi in tst.order) { seq = seq + tsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        // a tie on the cut line keeps every tied row rather than truncating
        tsrc.SetCell(4, 1, "9");
        tst.filters[1].topMode = 1;
        tst.filters[1].topN = 1;
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        seq = "";
        foreach (int oi in tst.order) { seq = seq + tsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        // cell rules and the set pass compose: >4 leaves b,d,e; top 2 of those
        tst.filters[1].cmpMode = 1;
        tst.filters[1].cmpA = "4";
        tst.filters[1].topN = 2;
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        seq = "";
        foreach (int oi in tst.order) { seq = seq + tsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        // Reset() drops every stage at once
        tst.filters[1].Reset();
        Console.WriteLine(tst.filters[1].Active());
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        Console.WriteLine(tst.order.Count);

        // ---- cell-cursor movement steps over group headers ----
        DataTable.GroupBy(tst, 1);
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        // grouping by a 5-value column gives 4 headers (9 appears twice)
        // interleaved with the data rows
        Console.WriteLine(tst.dispRows.Count);
        // the first display slot is a group header, so the first *data* slot is 1
        Console.WriteLine(tst.dispRows[0].kind);
        Console.WriteLine(DataTable.FirstDataSlot(tst));
        Console.WriteLine(tst.dispRows[DataTable.LastDataSlot(tst)].kind);
        // walking down from a data slot skips the header that follows it
        int s1 = DataTable.FirstDataSlot(tst);
        int s2 = DataTable.NextDataSlot(tst, s1 + 1, 1);
        Console.WriteLine(s2 - s1);
        // walking past the end reports no slot rather than clamping
        Console.WriteLine(DataTable.NextDataSlot(tst, tst.dispRows.Count, 1));

        // MoveCursor collapses the range; with extend it grows from the anchor
        DataTable.ClearRange(tst);
        Console.WriteLine(DataTable.MoveCursor(tst, s1, 1, false));
        Console.WriteLine(tst.HitRow());
        Console.WriteLine(tst.rangeR0 == s1 && tst.rangeR1 == s1);
        Console.WriteLine(DataTable.MoveCursor(tst, s2, 2, true));
        Console.WriteLine(tst.rangeR0 == s1 && tst.rangeR1 == s2);
        Console.WriteLine(tst.rangeC0 == 1 && tst.rangeC1 == 2);
        // a group-header slot is never a cursor target
        Console.WriteLine(DataTable.MoveCursor(tst, 0, 1, false));

        // VisPos reports the position within the visible column order
        List<int> vord = DataTable.VisibleOrder(tst, tcols);
        Console.WriteLine(vord.Count);
        Console.WriteLine(DataTable.VisPos(vord, vord[0]) == 0);
        Console.WriteLine(DataTable.VisPos(vord, 99));

        // ---- NavTarget: the pure key -> (slot, column) decision ----
        // grouped, so the walk has headers to step over. Cursor starts at the
        // first data slot in the first visible column.
        List<int> gv = DataTable.VisibleOrder(tst, tcols);
        DataTable.MoveCursor(tst, s1, gv[0], false);
        // Down lands on the next data slot, skipping the header between them
        List<int> nt = DataTable.NavTarget(tst, gv, 3, 40, 0);
        Console.WriteLine(nt[0] == s2 && nt[1] == gv[0]);
        // Right moves one visible column, staying on the same row
        nt = DataTable.NavTarget(tst, gv, 3, 39, 0);
        Console.WriteLine(nt[0] == s1 && nt[1] == gv[1]);
        // Left at the first column has nowhere to go, so nothing moves
        nt = DataTable.NavTarget(tst, gv, 3, 37, 0);
        Console.WriteLine(nt[0]);
        // Up at the first data row likewise holds position
        nt = DataTable.NavTarget(tst, gv, 3, 38, 0);
        Console.WriteLine(nt[0]);
        // End jumps to the last visible column; Home back to the first
        nt = DataTable.NavTarget(tst, gv, 3, 35, 0);
        Console.WriteLine(nt[1] == gv[gv.Count - 1]);
        DataTable.MoveCursor(tst, s1, gv[gv.Count - 1], false);
        nt = DataTable.NavTarget(tst, gv, 3, 36, 0);
        Console.WriteLine(nt[1] == gv[0]);
        // Ctrl+End goes to the last data slot, Ctrl+Home back to the first
        nt = DataTable.NavTarget(tst, gv, 3, 35, Modifiers.Ctrl());
        Console.WriteLine(nt[0] == DataTable.LastDataSlot(tst));
        DataTable.MoveCursor(tst, DataTable.LastDataSlot(tst), gv[0], false);
        nt = DataTable.NavTarget(tst, gv, 3, 36, Modifiers.Ctrl());
        Console.WriteLine(nt[0] == DataTable.FirstDataSlot(tst));
        // PageDown from the last row has nowhere to go and holds position
        DataTable.MoveCursor(tst, DataTable.LastDataSlot(tst), gv[0], false);
        nt = DataTable.NavTarget(tst, gv, 3, 34, 0);
        Console.WriteLine(nt[0]);
        // PageDown from the top advances about a page and lands on a data row,
        // never on a group header
        DataTable.MoveCursor(tst, s1, gv[0], false);
        nt = DataTable.NavTarget(tst, gv, 3, 34, 0);
        Console.WriteLine(nt[0] > s1);
        Console.WriteLine(tst.dispRows[nt[0]].kind);
        // PageUp from the bottom comes back up without landing on a header
        DataTable.MoveCursor(tst, DataTable.LastDataSlot(tst), gv[0], false);
        nt = DataTable.NavTarget(tst, gv, 3, 33, 0);
        Console.WriteLine(nt[0] < DataTable.LastDataSlot(tst));
        Console.WriteLine(tst.dispRows[nt[0]].kind);
        // Tab wraps off the right edge onto the next row's first column
        DataTable.MoveCursor(tst, s1, gv[gv.Count - 1], false);
        nt = DataTable.NavTarget(tst, gv, 3, 9, 0);
        Console.WriteLine(nt[0] == s2 && nt[1] == gv[0]);
        // Shift+Tab wraps backwards onto the previous row's last column
        DataTable.MoveCursor(tst, s2, gv[0], false);
        nt = DataTable.NavTarget(tst, gv, 3, 9, Modifiers.Shift());
        Console.WriteLine(nt[0] == s1 && nt[1] == gv[gv.Count - 1]);
        // a non-navigation key is not claimed
        Console.WriteLine(DataTable.IsNavKey(65));
        nt = DataTable.NavTarget(tst, gv, 3, 65, 0);
        Console.WriteLine(nt[0]);
        // with no cursor at all, any arrow lands on the top-left cell
        tst.hitOrder = -1;
        tst.hitCol = -1;
        nt = DataTable.NavTarget(tst, gv, 3, 40, 0);
        Console.WriteLine(nt[0] == DataTable.FirstDataSlot(tst) && nt[1] == gv[0]);

        // ---- scrolling brings a slot into view by the minimum amount ----
        DataTable.Ungroup(tst);
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        tst.scrollRow = 0;
        DataTable.ScrollSlotIntoView(tst, 1, 2);   // already visible: no move
        Console.WriteLine(tst.ScrollTop());
        DataTable.ScrollSlotIntoView(tst, 4, 2);   // scrolls just enough
        Console.WriteLine(tst.ScrollTop());
        DataTable.ScrollSlotIntoView(tst, 0, 2);   // back to the top
        Console.WriteLine(tst.ScrollTop());

        // ---- copy / paste / clear over a range ----
        List<DataColumn> pcols = new List<DataColumn>();
        pcols.Add(DataColumn.Create("ro", 80));                          // not editable
        pcols.Add(DataColumn.Editable(DataColumn.Create("txt", 80)));
        pcols.Add(DataColumn.Editable(DataColumn.BoolText(DataColumn.Bool("ok", 70), "Yes", "No")));

        List<DataRow> prows = new List<DataRow>();
        prows.Add(Row("r0", "a", "0"));
        prows.Add(Row("r1", "b", "0"));
        prows.Add(Row("r2", "c", "0"));

        DataSource psrc = RowListSource.Create(prows);
        DataTableState pst = DataTableState.Create();
        DataTable.EnsureInit(pst, pcols, psrc);
        pst.dirty = true;
        DataTable.Recompute(pst, pcols, psrc);

        // copying a 2x2 range yields tab-separated rows
        pst.rangeR0 = 0; pst.rangeC0 = 0;
        pst.rangeR1 = 1; pst.rangeC1 = 1;
        string copied = DataTable.CopyText(pst, pcols, psrc);
        Console.WriteLine(copied == "r0\ta\r\nr1\tb\r\n");

        // pasting fills down and right from the cursor; the read-only column 0
        // is skipped, and the bool column normalises "yes" to its own text
        DataTable.ClearRange(pst);
        pst.hitOrder = 0;
        pst.hitCol = 1;
        Console.WriteLine(DataTable.PasteText(pst, pcols, psrc, "x\tyes\ny\t0\n"));
        Console.WriteLine(psrc.CellText(0, 1));
        Console.WriteLine(psrc.CellText(0, 2));
        Console.WriteLine(psrc.CellText(1, 1));
        Console.WriteLine(psrc.CellText(1, 2));
        Console.WriteLine(psrc.CellText(2, 1));      // untouched third row
        // a paste that runs past the last row stops instead of erroring
        pst.hitOrder = 2;
        pst.hitCol = 1;
        Console.WriteLine(DataTable.PasteText(pst, pcols, psrc, "p\nq\nr\n"));
        Console.WriteLine(psrc.CellText(2, 1));
        // pasting onto a read-only column alone writes nothing
        pst.hitCol = 0;
        Console.WriteLine(DataTable.PasteText(pst, pcols, psrc, "nope\n"));
        Console.WriteLine(psrc.CellText(2, 0));
        // an empty clipboard is a no-op
        pst.hitCol = 1;
        Console.WriteLine(DataTable.PasteText(pst, pcols, psrc, ""));

        // clearing a range blanks editable text and falsifies editable bools,
        // leaving the read-only column alone
        pst.rangeR0 = 0; pst.rangeC0 = 0;
        pst.rangeR1 = 1; pst.rangeC1 = 2;
        Console.WriteLine(DataTable.ClearRangeCells(pst, pcols, psrc));
        Console.WriteLine(psrc.CellText(0, 0));
        Console.WriteLine(psrc.CellText(0, 1) == "");
        Console.WriteLine(psrc.CellText(0, 2));
        Console.WriteLine(psrc.CellText(1, 2));

        // ---- a cursor on a group caption writes to the first data row under it ----
        DataTable.GroupBy(pst, 0);
        pst.dirty = true;
        DataTable.Recompute(pst, pcols, psrc);
        // slot 0 is a caption, so the paste must land on the data row after it
        Console.WriteLine(pst.dispRows[0].kind);
        DataTable.ClearRange(pst);
        pst.hitOrder = 0;
        pst.hitCol = 1;
        Console.WriteLine(DataTable.PasteText(pst, pcols, psrc, "grp\n"));
        int firstData = pst.dispRows[DataTable.FirstDataSlot(pst)].row;
        Console.WriteLine(psrc.CellText(firstData, 1));
        // and the reported edit row is that data row, never the caption
        Console.WriteLine(pst.EditRow() == firstData);
        // clearing from a caption anchor behaves the same way
        pst.rangeR0 = 0; pst.rangeC0 = 1;
        pst.rangeR1 = 1; pst.rangeC1 = 1;
        Console.WriteLine(DataTable.ClearRangeCells(pst, pcols, psrc));
        Console.WriteLine(psrc.CellText(firstData, 1) == "");
        Console.WriteLine(pst.EditRow() == firstData);

        Program.EditorTests();
        Program.StylerTests();
        Program.FieldTests();
        Program.RowEditTests();
    }

    // Rejection counter for the CellValidating handler below. Static fields so
    // the handler stays a plain parameterless Action, matching the event model.
    static int rejects;
    static DataTableState vst;

    static void RejectOdd() {
        // Refuse a value the demo considers reserved, proving a handler can veto
        // a commit that already cleared the declarative rules.
        if (vst.EditValue() == "reserved") {
            rejects = rejects + 1;
            vst.Reject("Name is reserved");
        }
    }

    /// The editor system: declarative validation, the CellValidating veto,
    /// dropdown filtering, the numeric spinner and the calendar grid.
    static void EditorTests() {
        Console.WriteLine("-- editors --");

        // ---- ValidateCell against each declarative rule ----
        DataColumn tc = DataColumn.Required(DataColumn.Editable(DataColumn.Text("Name", 80)));
        DataColumn.MaxLength(tc, 5);
        Console.WriteLine(DataTable.ValidateCell(tc, "abc") == "");
        Console.WriteLine(DataTable.ValidateCell(tc, "") == "Value required");
        Console.WriteLine(DataTable.ValidateCell(tc, "   ") == "Value required");  // blanks are empty
        Console.WriteLine(DataTable.ValidateCell(tc, "abcdefg"));

        // a numeric column checks shape before range
        DataColumn nc = DataColumn.Range(DataColumn.Editable(DataColumn.Numeric("Qty", 60)), 1.0, 10.0);
        Console.WriteLine(DataTable.ValidateCell(nc, "5") == "");
        Console.WriteLine(DataTable.ValidateCell(nc, "abc"));
        Console.WriteLine(DataTable.ValidateCell(nc, "0"));
        Console.WriteLine(DataTable.ValidateCell(nc, "11"));
        Console.WriteLine(DataTable.ValidateCell(nc, "1") == "");    // bounds are inclusive
        Console.WriteLine(DataTable.ValidateCell(nc, "10") == "");
        // an optional column lets a blank through without a format complaint
        Console.WriteLine(DataTable.ValidateCell(nc, "") == "");

        // a date column rejects unparseable text
        DataColumn dc = DataColumn.DatePicker(DataColumn.Date("When", 100));
        Console.WriteLine(DataTable.ValidateCell(dc, "2026-07-26") == "");
        Console.WriteLine(DataTable.ValidateCell(dc, "2026-13-01"));   // month out of range
        Console.WriteLine(DataTable.ValidateCell(dc, "not a date"));

        // ---- dropdown choices ----
        List<string> opts = new List<string>();
        opts.Add("Shipping"); opts.Add("Sales"); opts.Add("Support"); opts.Add("Legal");
        DataColumn sc = DataColumn.Dropdown(DataColumn.Text("Team", 90), opts, true);
        Console.WriteLine(DataTable.ValidateCell(sc, "Sales") == "");
        Console.WriteLine(DataTable.ValidateCell(sc, "sales") == "");     // case-insensitive
        Console.WriteLine(DataTable.ValidateCell(sc, "Nope"));
        // the same column in loose mode accepts free text
        DataColumn lc = DataColumn.Dropdown(DataColumn.Text("Team", 90), opts, false);
        Console.WriteLine(DataTable.ValidateCell(lc, "Nope") == "");

        // filtering narrows the list by case-insensitive substring
        Console.WriteLine(DataTable.FilterChoices(sc, "").Count);        // 4: empty shows all
        Console.WriteLine(DataTable.FilterChoices(sc, "s").Count);       // 3: all but Legal
        Console.WriteLine(DataTable.FilterChoices(sc, "SUP").Count);     // 1
        Console.WriteLine(DataTable.FilterChoices(sc, "zz").Count);      // 0
        Console.WriteLine(DataTable.IndexOfChoice(sc, "Support"));       // 2
        Console.WriteLine(DataTable.IndexOfChoice(sc, "  legal  "));     // 3: trimmed + folded
        Console.WriteLine(DataTable.IndexOfChoice(sc, "Nope"));          // -1

        // ---- spinner stepping, clamped to the declared bounds ----
        DataColumn pc = DataColumn.Range(DataColumn.Spinner(DataColumn.Numeric("N", 60), 0.5), 0.0, 2.0);
        DataColumn.Decimals(pc, 1);
        Console.WriteLine(DataTable.StepValue(pc, "1.0", 1));      // 1.5
        Console.WriteLine(DataTable.StepValue(pc, "1.0", -1));     // 0.5
        Console.WriteLine(DataTable.StepValue(pc, "2.0", 1));      // clamps at the max
        Console.WriteLine(DataTable.StepValue(pc, "0.0", -1));     // clamps at the min
        Console.WriteLine(DataTable.StepValue(pc, "junk", 1));     // unparseable starts at the min
        Console.WriteLine(DataTable.StepValue(pc, "", 1));

        // ---- calendar grid ----
        // July 2026 starts on a Wednesday and has 31 days.
        int ym = DataTable.YearMonth(2026, 7);
        Console.WriteLine(DataTable.YmYear(ym));
        Console.WriteLine(DataTable.YmMonth(ym));
        Console.WriteLine(DataTable.MonthFirstDow(ym));            // 3 = Wednesday
        List<int> cells = DataTable.MonthCells(ym);
        Console.WriteLine(cells.Count);                            // always 42
        Console.WriteLine(cells[0]);                               // 0: leading blank
        Console.WriteLine(cells[3]);                               // 1: the 1st sits in slot 3
        Console.WriteLine(cells[33]);                              // 31: the last day
        Console.WriteLine(cells[34]);                              // 0: trailing blank
        // stepping across a year boundary rolls the packed month correctly
        Console.WriteLine(DataTable.YmMonth(DataTable.YearMonth(2026, 12) + 1));   // 1
        Console.WriteLine(DataTable.YmYear(DataTable.YearMonth(2026, 12) + 1));    // 2027
        Console.WriteLine(DataTable.YmMonth(DataTable.YearMonth(2026, 1) - 1));    // 12
        Console.WriteLine(DataTable.YmYear(DataTable.YearMonth(2026, 1) - 1));     // 2025

        // a date written back uses the column's *stored* order, not its display
        // pattern, so it survives a re-parse
        DataColumn ddc = DataColumn.DateFormat(DataColumn.AsDate(DataColumn.Text("D", 90), 1), 3);
        Console.WriteLine(DataTable.DateStoreFormat(ddc));          // 1, matching dateOrder
        int day = DateTime.DaysFromCivil(2026, 7, 26);
        string stored = DataTable.FormatDate(day, DataTable.DateStoreFormat(ddc));
        Console.WriteLine(stored);
        Console.WriteLine(DataTable.ParseDate(stored, ddc.dateOrder) == day);

        // ---- BeginEdit / CommitEdit through a real source ----
        List<DataColumn> ecols = new List<DataColumn>();
        ecols.Add(DataColumn.MaxLength(DataColumn.Required(DataColumn.Editable(DataColumn.Text("Name", 90))), 8));
        ecols.Add(DataColumn.Dropdown(DataColumn.Text("Team", 90), opts, true));
        ecols.Add(DataColumn.Range(DataColumn.Spinner(DataColumn.Numeric("Qty", 60), 1.0), 0.0, 5.0));
        List<DataRow> erows = new List<DataRow>();
        erows.Add(Program.Row("Ann", "Sales", "2"));
        erows.Add(Program.Row("Bob", "Legal", "3"));
        DataSource esrc = RowListSource.Create(erows);
        vst = DataTableState.Create();
        DataTable.EnsureInit(vst, ecols, esrc);
        DataTable.Recompute(vst, ecols, esrc);
        rejects = 0;
        vst.CellValidating.Add(Program.RejectOdd);

        // a good edit commits and closes the editor
        DataTable.BeginEdit(vst, ecols, esrc, 0, 0);
        Console.WriteLine(vst.editing);
        Console.WriteLine(vst.editBuf);
        vst.editBuf = "Anna";
        DataTable.CommitEdit(vst, ecols, esrc);
        Console.WriteLine(vst.editing);
        Console.WriteLine(esrc.CellText(0, 0));

        // a value failing a declarative rule keeps the editor open, reports why,
        // and leaves the stored cell untouched
        DataTable.BeginEdit(vst, ecols, esrc, 0, 0);
        vst.editBuf = "";
        DataTable.CommitEdit(vst, ecols, esrc);
        Console.WriteLine(vst.editing);
        Console.WriteLine(vst.EditError());
        Console.WriteLine(esrc.CellText(0, 0));
        // correcting it commits
        vst.editBuf = "Bea";
        DataTable.CommitEdit(vst, ecols, esrc);
        Console.WriteLine(vst.editing);
        Console.WriteLine(esrc.CellText(0, 0));

        // a handler veto behaves the same way, and did run
        DataTable.BeginEdit(vst, ecols, esrc, 1, 0);
        vst.editBuf = "reserved";
        DataTable.CommitEdit(vst, ecols, esrc);
        Console.WriteLine(vst.editing);
        Console.WriteLine(vst.EditError());
        Console.WriteLine(rejects);
        Console.WriteLine(esrc.CellText(1, 0));
        DataTable.CancelEdit(vst);
        Console.WriteLine(vst.editing);
        Console.WriteLine(vst.EditError() == "");   // cancelling clears the message

        // opening a dropdown editor pre-selects the current value and shows the
        // whole list
        DataTable.BeginEdit(vst, ecols, esrc, 0, 1);
        Console.WriteLine(vst.edPopOpen);
        Console.WriteLine(vst.edPopItems.Count);
        Console.WriteLine(vst.edPopSel);              // 1 = Sales
        // typing narrows it and moves the highlight to the first hit
        vst.editBuf = "su";
        DataTable.RefreshChoices(vst, ecols[1]);
        Console.WriteLine(vst.edPopItems.Count);
        Console.WriteLine(vst.edPopSel);              // 2 = Support
        // committing a prefix stores the highlighted item, not what was typed
        DataTable.CommitEdit(vst, ecols, esrc);
        Console.WriteLine(esrc.CellText(0, 1));
        Console.WriteLine(vst.editing);
        // text matching nothing leaves no highlight, and the strict column
        // refuses to store it
        DataTable.BeginEdit(vst, ecols, esrc, 0, 1);
        vst.editBuf = "zzz";
        DataTable.RefreshChoices(vst, ecols[1]);
        Console.WriteLine(vst.edPopItems.Count);
        Console.WriteLine(vst.edPopSel);
        DataTable.CommitEdit(vst, ecols, esrc);
        Console.WriteLine(vst.editing);
        Console.WriteLine(vst.EditError());
        Console.WriteLine(esrc.CellText(0, 1));       // still Support
        DataTable.CancelEdit(vst);

        // MoveChoice walks the filtered list and stops at both ends
        DataTable.BeginEdit(vst, ecols, esrc, 0, 1);
        vst.edPopSel = 0;
        DataTable.MoveChoice(vst, 1);
        Console.WriteLine(vst.edPopSel);              // 1
        DataTable.MoveChoice(vst, -5);
        Console.WriteLine(vst.edPopSel);              // 0, clamped
        DataTable.MoveChoice(vst, 99);
        Console.WriteLine(vst.edPopSel);              // 3, clamped
        DataTable.CancelEdit(vst);

        // a spinner column rejects an out-of-range commit
        DataTable.BeginEdit(vst, ecols, esrc, 0, 2);
        vst.editBuf = "9";
        DataTable.CommitEdit(vst, ecols, esrc);
        Console.WriteLine(vst.editing);
        Console.WriteLine(vst.EditError());
        Console.WriteLine(esrc.CellText(0, 2));       // unchanged
        DataTable.CancelEdit(vst);

        // pasting is held to the same rules: the bad field is skipped, the good
        // one lands
        vst.hitOrder = 0;
        vst.hitCol = 0;
        DataTable.ClearRange(vst);
        Console.WriteLine(DataTable.PasteText(vst, ecols, esrc, "waytoolongname\tLegal\n"));
        Console.WriteLine(esrc.CellText(0, 0));       // still Bea: over MaxLength
        Console.WriteLine(esrc.CellText(0, 1));       // Legal: accepted

        // and a required column can't be blanked by Delete
        vst.rangeR0 = 0; vst.rangeC0 = 0;
        vst.rangeR1 = 0; vst.rangeC1 = 1;
        Console.WriteLine(DataTable.ClearRangeCells(vst, ecols, esrc));
        Console.WriteLine(esrc.CellText(0, 0));       // Bea survives
        Console.WriteLine(esrc.CellText(0, 1) == ""); // the optional one cleared
    }

    /// Row / cell appearance resolution: which colour wins, and how a styled
    /// row blends with selection and hover instead of losing its meaning.
    static void StylerTests() {
        Console.WriteLine("-- styler --");

        int red = DataTable.Rgb(255, 0, 0);
        int white = DataTable.Rgb(255, 255, 255);
        int grey = DataTable.Rgb(240, 240, 240);
        int blue = DataTable.Rgb(0, 0, 255);
        int hoverC = DataTable.Rgb(0, 255, 0);

        List<DataColumn> scols = new List<DataColumn>();
        scols.Add(DataColumn.Text("Name", 80));
        scols.Add(DataColumn.Text("State", 80));
        List<DataRow> srows = new List<DataRow>();
        DataRow s0 = DataRow.Create(); s0.Push("Ann"); s0.Push("Overdue"); srows.Add(s0);
        DataRow s1 = DataRow.Create(); s1.Push("Bob"); s1.Push("Paid"); srows.Add(s1);
        RowListSource ssrc = RowListSource.Create(srows);
        DataTableState sst = DataTableState.Create();
        DataTable.EnsureInit(sst, scols, ssrc);

        // ---- no styler: the stock striping / selection / hover order ----
        Console.WriteLine(DataTable.RowBackground(sst, ssrc, 0, white, blue, hoverC, false, false) == white);
        Console.WriteLine(DataTable.RowBackground(sst, ssrc, 0, grey, blue, hoverC, false, false) == grey);
        Console.WriteLine(DataTable.RowBackground(sst, ssrc, 0, white, blue, hoverC, true, false) == blue);
        // hover outranks selection, as in the stock renderer
        Console.WriteLine(DataTable.RowBackground(sst, ssrc, 0, white, blue, hoverC, true, true) == hoverC);
        Console.WriteLine(DataTable.CellBackground(sst, ssrc, 0, 0) == 0);
        Console.WriteLine(DataTable.CellForeground(sst, ssrc, 0, 0) == 0);

        // ---- with a styler ----
        sst.styler = new TestStyler();

        // row 0 is "Overdue": its colour replaces the striping outright
        Console.WriteLine(DataTable.RowBackground(sst, ssrc, 0, white, blue, hoverC, false, false) == red);
        // row 1 is not: it keeps whatever stripe it was given
        Console.WriteLine(DataTable.RowBackground(sst, ssrc, 1, grey, blue, hoverC, false, false) == grey);

        // selecting a styled row blends rather than erasing — half red, half
        // blue — so the row still reads as overdue while it is active
        int selBlend = DataTable.RowBackground(sst, ssrc, 0, white, blue, hoverC, true, false);
        Console.WriteLine(selBlend == DataTable.LerpColor(red, blue, 1, 2));
        Console.WriteLine(selBlend != red);
        Console.WriteLine(selBlend != blue);
        // hover blends the same way and still outranks selection
        Console.WriteLine(DataTable.RowBackground(sst, ssrc, 0, white, blue, hoverC, true, true)
                          == DataTable.LerpColor(red, hoverC, 1, 2));

        // ---- cell background: only column 1 of row 0 is tinted ----
        Console.WriteLine(DataTable.CellBackground(sst, ssrc, 0, 1) == blue);
        Console.WriteLine(DataTable.CellBackground(sst, ssrc, 0, 0) == 0);
        Console.WriteLine(DataTable.CellBackground(sst, ssrc, 1, 1) == 0);

        // ---- foreground: a per-cell colour beats the row's, which covers the rest ----
        Console.WriteLine(DataTable.CellForeground(sst, ssrc, 0, 0) == white);  // row colour
        Console.WriteLine(DataTable.CellForeground(sst, ssrc, 0, 1) == red);    // cell wins
        Console.WriteLine(DataTable.CellForeground(sst, ssrc, 1, 0) == 0);      // neither set

        // ---- clearing the styler restores the stock appearance exactly ----
        sst.styler = null;
        Console.WriteLine(DataTable.RowBackground(sst, ssrc, 0, white, blue, hoverC, false, false) == white);
        Console.WriteLine(DataTable.CellForeground(sst, ssrc, 0, 1) == 0);
    }

    /// Field-name addressing: the point is that indices may move underneath
    /// application code, and names must not.
    static void FieldTests() {
        Console.WriteLine("-- fields --");

        List<DataColumn> fc = new List<DataColumn>();
        fc.Add(DataColumn.Field(DataColumn.Text("Name", 100), "name"));
        fc.Add(DataColumn.Field(DataColumn.Numeric("Score", 60), "score"));
        fc.Add(DataColumn.Text("City", 80));            // deliberately unnamed
        List<DataRow> frows = new List<DataRow>();
        frows.Add(Program.Row("Ann", "91", "Seattle"));
        frows.Add(Program.Row("Bob", "72", "Denver"));
        RowListSource fsrc = RowListSource.Create(frows);

        // ---- lookup ----
        Console.WriteLine(DataTable.Col(fc, "name") == 0);
        Console.WriteLine(DataTable.Col(fc, "score") == 1);
        Console.WriteLine(DataTable.Col(fc, "nope") == -1);
        // an empty argument must not select the unnamed column at index 2
        Console.WriteLine(DataTable.Col(fc, "") == -1);
        Console.WriteLine(DataTable.HasCol(fc, "score"));
        Console.WriteLine(DataTable.HasCol(fc, "city") == false);

        // ---- reads / writes go through the name ----
        Console.WriteLine(DataTable.Cell(fsrc, fc, 0, "name"));
        Console.WriteLine(DataTable.Cell(fsrc, fc, 1, "score"));
        Console.WriteLine(DataTable.Cell(fsrc, fc, 0, "nope") == "");   // unknown reads blank
        Console.WriteLine(DataTable.CellValue(fsrc, fc, 0, "score") == 91.0);
        Console.WriteLine(DataTable.CellValue(fsrc, fc, 0, "nope") == 0.0);
        DataTable.SetCellField(fsrc, fc, 0, "score", "95");
        Console.WriteLine(fsrc.CellText(0, 1));
        // an unknown field must not fall through onto some other column
        DataTable.SetCellField(fsrc, fc, 0, "nope", "wrecked");
        Console.WriteLine(fsrc.CellText(0, 0));
        Console.WriteLine(fsrc.CellText(0, 1));
        Console.WriteLine(fsrc.CellText(0, 2));

        // ---- the same names still resolve after a column is inserted ----
        // This is the whole point: index 0 stops meaning "name", but the name
        // does not stop meaning the name.
        List<DataColumn> fc2 = new List<DataColumn>();
        fc2.Add(DataColumn.Field(DataColumn.Text("Team", 80), "team"));
        fc2.Add(DataColumn.Field(DataColumn.Text("Name", 100), "name"));
        fc2.Add(DataColumn.Field(DataColumn.Numeric("Score", 60), "score"));
        Console.WriteLine(DataTable.Col(fc2, "name") == 1);
        Console.WriteLine(DataTable.Col(fc2, "score") == 2);
        // and a title change doesn't move the name either
        DataColumn.Field(fc2[1], "name");
        fc2[1].title = "Full name";
        Console.WriteLine(DataTable.Col(fc2, "name") == 1);

        // ---- state operations by name ----
        DataTableState fst = DataTableState.Create();
        DataTable.EnsureInit(fst, fc, fsrc);

        DataTable.SortByField(fst, fc, "score", 2);
        Console.WriteLine(fst.SortColIndex() == 1);
        Console.WriteLine(fst.SortDirection() == 2);
        DataTable.AddSortField(fst, fc, "name", 1);
        Console.WriteLine(fst.sortKeys.Count == 2);
        Console.WriteLine(fst.sortKeys[1].col == 0);
        // an unknown field changes nothing at all
        DataTable.AddSortField(fst, fc, "nope", 1);
        Console.WriteLine(fst.sortKeys.Count == 2);
        DataTable.SortByField(fst, fc, "nope", 1);
        Console.WriteLine(fst.sortKeys.Count == 2);

        DataTable.SetAggregateField(fst, fc, "score", 1);
        Console.WriteLine(fst.aggMode[1] == 1);
        DataTable.SetAggregateField(fst, fc, "nope", 1);
        Console.WriteLine(fst.aggMode[0] == 0);

        DataTable.PinField(fst, fc, "name", true);
        Console.WriteLine(DataTable.IsPinned(fst, 0));
        DataTable.PinField(fst, fc, "name", false);
        Console.WriteLine(DataTable.IsPinned(fst, 0) == false);
        DataTable.PinField(fst, fc, "nope", true);
        Console.WriteLine(DataTable.IsPinned(fst, 0) == false);

        DataTable.HideField(fst, fc, "score", true);
        // Compared rather than printed bare: a List<bool> element currently
        // materialises as -1 instead of 1 (irgen sign-extends the i1 on store),
        // and the golden must not enshrine that.
        Console.WriteLine(fst.colHidden[1] == true);
        Console.WriteLine(DataTable.HiddenCount(fst) == 1);
        DataTable.HideField(fst, fc, "score", false);
        Console.WriteLine(DataTable.HiddenCount(fst) == 0);

        DataTable.GroupByField(fst, fc, "name");
        Console.WriteLine(fst.groupCols.Count == 1);
        Console.WriteLine(fst.groupCols[0] == 0);

        // ---- naming the column an event reports ----
        fst.hitCol = 1;
        Console.WriteLine(DataTable.HitField(fst, fc));
        fst.hitCol = 2;                       // the unnamed column
        Console.WriteLine(DataTable.HitField(fst, fc) == "");
        fst.hitCol = -1;
        Console.WriteLine(DataTable.HitField(fst, fc) == "");
        fst.editCol = 0;
        Console.WriteLine(DataTable.EditField(fst, fc));
        fst.editCol = 99;                     // out of range, not a crash
        Console.WriteLine(DataTable.EditField(fst, fc) == "");
    }

    /// Row insert / delete and the undo journal. The interesting part is what
    /// has to move when a row does: the per-row selection flags, an open
    /// editor's row, and the indices of edits still sitting in the journal.
    static void RowEditTests() {
        Console.WriteLine("-- rows --");

        List<DataColumn> rcols = new List<DataColumn>();
        rcols.Add(DataColumn.Field(DataColumn.Editable(DataColumn.Text("Name", 100)), "name"));
        rcols.Add(DataColumn.Field(DataColumn.Editable(DataColumn.Text("City", 100)), "city"));
        List<DataRow> rrows = new List<DataRow>();
        rrows.Add(Program.Row2("Ann", "Seattle"));
        rrows.Add(Program.Row2("Bob", "Denver"));
        rrows.Add(Program.Row2("Cid", "Austin"));
        RowListSource rsrc = RowListSource.Create(rrows);
        DataTableState rst = DataTableState.Create();
        DataTable.EnsureInit(rst, rcols, rsrc);

        Console.WriteLine(rsrc.CanInsert());
        Console.WriteLine(rsrc.RowCount() == 3);

        // ---- append ----
        int added = DataTable.AppendRow(rst, rcols, rsrc);
        Console.WriteLine(added == 3);
        Console.WriteLine(rsrc.RowCount() == 4);
        Console.WriteLine(rsrc.CellText(3, 0) == "");
        Console.WriteLine(rst.HitRow() == 3);

        // ---- insert in the middle shifts the rows after it ----
        int mid = DataTable.InsertRow(rst, rcols, rsrc, 1);
        Console.WriteLine(mid == 1);
        Console.WriteLine(rsrc.CellText(0, 0));       // Ann, unmoved
        Console.WriteLine(rsrc.CellText(1, 0) == ""); // the new blank
        Console.WriteLine(rsrc.CellText(2, 0));       // Bob, pushed down

        // ---- selection flags travel with their rows ----
        // Cid is at index 3 now; select it and insert above, and the flag must
        // follow Cid rather than stay on index 3.
        rst.selected[3] = true;
        DataTable.InsertRow(rst, rcols, rsrc, 0);
        Console.WriteLine(rsrc.CellText(4, 0));            // Cid moved to 4
        Console.WriteLine(rst.selected[4] == true);        // and so did its flag
        Console.WriteLine(rst.selected[3] == false);
        // deleting above it moves the flag back down
        DataTable.DeleteRow(rst, rcols, rsrc, 0);
        Console.WriteLine(rsrc.CellText(3, 0));
        Console.WriteLine(rst.selected[3] == true);
        rst.selected[3] = false;

        // ---- an open editor is closed when its own row is deleted ----
        DataTable.BeginEdit(rst, rcols, rsrc, 2, 0);
        Console.WriteLine(rst.editing);
        DataTable.DeleteRow(rst, rcols, rsrc, 2);
        Console.WriteLine(rst.editing == false);          // not left dangling
        // ...but only shifted when an earlier row goes
        DataTable.BeginEdit(rst, rcols, rsrc, 2, 0);
        Console.WriteLine(rst.EditRow() == 2);
        DataTable.DeleteRow(rst, rcols, rsrc, 0);
        Console.WriteLine(rst.editing);
        Console.WriteLine(rst.EditRow() == 1);
        DataTable.CancelEdit(rst);

        // ---- undo a cell edit ----
        List<DataRow> urows = new List<DataRow>();
        urows.Add(Program.Row2("Ann", "Seattle"));
        urows.Add(Program.Row2("Bob", "Denver"));
        RowListSource usrc = RowListSource.Create(urows);
        DataTableState ust = DataTableState.Create();
        DataTable.EnsureInit(ust, rcols, usrc);
        Console.WriteLine(DataTable.UndoDepth(ust) == 0);
        Console.WriteLine(DataTable.Undo(ust, rcols, usrc) == false);  // nothing to undo

        DataTable.BeginEdit(ust, rcols, usrc, 0, 1);
        ust.editBuf = "Portland";
        DataTable.CommitEdit(ust, rcols, usrc);
        Console.WriteLine(usrc.CellText(0, 1));
        Console.WriteLine(DataTable.UndoDepth(ust) == 1);
        Console.WriteLine(DataTable.Undo(ust, rcols, usrc));
        Console.WriteLine(usrc.CellText(0, 1));        // back to Seattle
        Console.WriteLine(DataTable.UndoDepth(ust) == 0);

        // ---- undo an insert removes it again ----
        DataTable.AppendRow(ust, rcols, usrc);
        Console.WriteLine(usrc.RowCount() == 3);
        DataTable.Undo(ust, rcols, usrc);
        Console.WriteLine(usrc.RowCount() == 2);
        // and undoing did not itself become undoable
        Console.WriteLine(DataTable.UndoDepth(ust) == 0);

        // ---- undo a delete restores the row's contents, not just a blank ----
        DataTable.DeleteRow(ust, rcols, usrc, 0);
        Console.WriteLine(usrc.RowCount() == 1);
        Console.WriteLine(usrc.CellText(0, 0));        // Bob is now first
        DataTable.Undo(ust, rcols, usrc);
        Console.WriteLine(usrc.RowCount() == 2);
        Console.WriteLine(usrc.CellText(0, 0));        // Ann is back
        Console.WriteLine(usrc.CellText(0, 1));        // with her city
        Console.WriteLine(usrc.CellText(1, 0));        // and Bob after her

        // ---- a multi-cell paste is ONE undo, not one per cell ----
        // Paste anchors on the *display* order, so the view has to be built
        // first; without it there is no row 0 to paste into.
        DataTable.Recompute(ust, rcols, usrc);
        ust.hitOrder = 0;
        ust.hitCol = 0;
        DataTable.ClearRange(ust);
        int pasted = DataTable.PasteText(ust, rcols, usrc, "Xan\tOslo\nYin\tLima\n");
        Console.WriteLine(pasted == 4);
        Console.WriteLine(usrc.CellText(0, 0));
        Console.WriteLine(usrc.CellText(1, 1));
        Console.WriteLine(DataTable.UndoDepth(ust) == 1);   // grouped
        Console.WriteLine(DataTable.Undo(ust, rcols, usrc));
        Console.WriteLine(usrc.CellText(0, 0));            // all four restored
        Console.WriteLine(usrc.CellText(0, 1));
        Console.WriteLine(usrc.CellText(1, 0));
        Console.WriteLine(usrc.CellText(1, 1));
        Console.WriteLine(DataTable.UndoDepth(ust) == 0);

        // ---- deleting several selected rows is also one undo ----
        ust.selected[0] = true;
        ust.selected[1] = true;
        Console.WriteLine(DataTable.DeleteSelectedRows(ust, rcols, usrc) == 2);
        Console.WriteLine(usrc.RowCount() == 0);
        Console.WriteLine(DataTable.UndoDepth(ust) == 1);
        DataTable.Undo(ust, rcols, usrc);
        Console.WriteLine(usrc.RowCount() == 2);
        // and they come back in their original order, not reversed
        Console.WriteLine(usrc.CellText(0, 0));
        Console.WriteLine(usrc.CellText(1, 0));

        // ---- the journal is capped ----
        DataTable.ClearUndo(ust);
        ust.undoLimit = 3;
        int k = 0;
        while (k < 10) {
            DataTable.BeginEdit(ust, rcols, usrc, 0, 0);
            ust.editBuf = "v" + Convert.ToString(k);
            DataTable.CommitEdit(ust, rcols, usrc);
            k = k + 1;
        }
        Console.WriteLine(DataTable.UndoDepth(ust) == 3);
        // the three surviving entries still undo in order, back to v6
        DataTable.Undo(ust, rcols, usrc);
        Console.WriteLine(usrc.CellText(0, 0));
        DataTable.Undo(ust, rcols, usrc);
        Console.WriteLine(usrc.CellText(0, 0));

        // ---- a data row is not a display slot ----
        // Restore known names first: the cap test above left "v7" in row 0, and
        // the point here is the slot mapping, not whatever ordering that yields.
        DataTable.ClearUndo(ust);
        usrc.SetCell(0, 0, "Ann");
        usrc.SetCell(1, 0, "Bob");
        // Sorting descending puts Bob first, so row 0 is shown at slot 1; the
        // add-row flow must go through SlotOfRow or it would park the cursor on
        // the wrong line.
        DataTable.SortBy(ust, 0, 2);
        DataTable.Recompute(ust, rcols, usrc);
        Console.WriteLine(usrc.CellText(0, 0));                   // Ann, still row 0
        Console.WriteLine(DataTable.SlotOfRow(ust, 0) == 1);      // shown second
        Console.WriteLine(DataTable.SlotOfRow(ust, 1) == 0);
        Console.WriteLine(DataTable.SlotOfRow(ust, 99) == -1);    // no such row

        // FocusRow parks the cursor and opens the first editable column
        DataTable.FocusRow(ust, rcols, usrc, 0);
        Console.WriteLine(ust.hitOrder == 1);
        Console.WriteLine(ust.HitRow() == 0);
        Console.WriteLine(ust.editing);
        Console.WriteLine(ust.EditRow() == 0);
        Console.WriteLine(ust.editCol == 0);
        DataTable.CancelEdit(ust);
        // a filtered-out row can't be focused, and asking is not a crash
        DataTable.FocusRow(ust, rcols, usrc, 99);
        Console.WriteLine(ust.editing == false);
        // a hidden first column is skipped: the editor opens on the next one
        ust.colHidden[0] = true;
        DataTable.FocusRow(ust, rcols, usrc, 0);
        Console.WriteLine(ust.editCol == 1);
        DataTable.CancelEdit(ust);
        ust.colHidden[0] = false;
        DataTable.SortBy(ust, -1, 1);

        // ---- a read-only source refuses, and says so ----
        RoSource ro = new RoSource();
        DataTableState rost = DataTableState.Create();
        DataTable.EnsureInit(rost, rcols, ro);
        Console.WriteLine(ro.CanInsert() == false);
        Console.WriteLine(DataTable.AppendRow(rost, rcols, ro) == -1);
        Console.WriteLine(DataTable.DeleteRow(rost, rcols, ro, 0) == false);
        Console.WriteLine(DataTable.UndoDepth(rost) == 0);  // nothing journalled
    }
}

/// A source that serves rows but refuses to grow or shrink — the default
/// DataSource behaviour, which the grid must respect.
class RoSource : DataSource {
    override int RowCount() { return 2; }
    override string CellText(int row, int col) { return "ro"; }
}

/// A styler that colours "Overdue" rows and picks out the state cell, used to
/// prove the row/cell precedence rules above.
class TestStyler : CellStyler {
    override int RowBg(DataSource src, int row) {
        if (src.CellText(row, 1) == "Overdue") { return DataTable.Rgb(255, 0, 0); }
        return 0;
    }
    override int RowFg(DataSource src, int row) {
        if (src.CellText(row, 1) == "Overdue") { return DataTable.Rgb(255, 255, 255); }
        return 0;
    }
    override int CellBg(DataSource src, int row, int col) {
        if (col == 1 && src.CellText(row, 1) == "Overdue") { return DataTable.Rgb(0, 0, 255); }
        return 0;
    }
    override int CellFg(DataSource src, int row, int col) {
        if (col == 1 && src.CellText(row, 1) == "Overdue") { return DataTable.Rgb(255, 0, 0); }
        return 0;
    }
}
