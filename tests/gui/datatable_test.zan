        Console.WriteLine(DataTable.HasDetail(dt2) == false);
        Console.WriteLine(DataTable.DispCount(dt2) == 3);
        // IDE 工具链交互与状态驱动契约。
        DataTable.ExpandRow(dt2, ds2, 0);
        Console.WriteLine(DataTable.ExpandedCount(dt2) == 0);

        DataTable.SetDetail(dt2, new FixedDetail());
        DataTable.Recompute(dt2, dc2, ds2);
        Console.WriteLine(DataTable.HasDetail(dt2));
        Console.WriteLine(DataTable.DispCount(dt2) == 3);      // nothing expanded yet
        Console.WriteLine(DataTable.DetailSlots(dt2, ds2, 0) == 2);

        // IDE 工具链交互与状态驱动契约。
        DataTable.ExpandRow(dt2, ds2, 1);
        DataTable.Recompute(dt2, dc2, ds2);
        Console.WriteLine(DataTable.DispCount(dt2) == 5);
        Console.WriteLine(DataTable.DispKind(dt2, 1) == 0 && DataTable.DispRowOf(dt2, 1) == 1);
        Console.WriteLine(DataTable.DispKind(dt2, 2) == 2 && DataTable.DispRowOf(dt2, 2) == 1);
        Console.WriteLine(DataTable.DispPart(dt2, 2) == 0);
        Console.WriteLine(DataTable.DispKind(dt2, 3) == 2 && DataTable.DispPart(dt2, 3) == 1);
        Console.WriteLine(DataTable.DispKind(dt2, 4) == 0 && DataTable.DispRowOf(dt2, 4) == 2);
        // IDE 工具链交互与状态驱动契约。
        Console.WriteLine(DataTable.DispNo(dt2, 0) == 1 && DataTable.DispNo(dt2, 1) == 2);
        Console.WriteLine(DataTable.DispNo(dt2, 4) == 3);
        Console.WriteLine(DataTable.DispNo(dt2, 2) == 0);

        // IDE 工具链交互与状态驱动契约。
        Console.WriteLine(DataTable.NextDataSlot(dt2, 2, 1) == 4);
        Console.WriteLine(DataTable.NextDataSlot(dt2, 3, -1) == 1);

        // IDE 工具链交互与状态驱动契约。
        DataTable.CollapseRow(dt2, 1);
        DataTable.Recompute(dt2, dc2, ds2);
        Console.WriteLine(DataTable.DispCount(dt2) == 3);

        // 核心契约与语义定义。
        DataTable.ToggleDetail(dt2, ds2, 0);
        Console.WriteLine(DataTable.IsExpanded(dt2, 0));
        DataTable.ToggleDetail(dt2, ds2, 0);
        Console.WriteLine(DataTable.IsExpanded(dt2, 0) == false);

        // IDE 工具链交互与状态驱动契约。
        DataTable.ExpandRow(dt2, ds2, 0);          // source row 0 == "a"
        DataTable.SortBy(dt2, 0, 2);               // sort by k descending: c,b,a
        DataTable.Recompute(dt2, dc2, ds2);
        Console.WriteLine(DataTable.DispCount(dt2) == 5);
        // IDE 工具链交互与状态驱动契约。
        Console.WriteLine(DataTable.DispKind(dt2, 2) == 0 && DataTable.DispRowOf(dt2, 2) == 0);
        Console.WriteLine(DataTable.DispKind(dt2, 3) == 2 && DataTable.DispRowOf(dt2, 3) == 0);
        Console.WriteLine(DataTable.DispKind(dt2, 4) == 2 && DataTable.DispRowOf(dt2, 4) == 0);
        DataTable.SortBy(dt2, 0, 1);
        DataTable.CollapseAllDetail(dt2);
        DataTable.Recompute(dt2, dc2, ds2);
        Console.WriteLine(DataTable.DispCount(dt2) == 3);

        // IDE 工具链交互与状态驱动契约。
        DataTable.SetDetail(dt2, new PerRowDetail());
        DataTable.Recompute(dt2, dc2, ds2);
