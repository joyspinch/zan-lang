        grs.Add(Program.Row2("x", "2"));
        grs.Add(Program.Row2("y", "3"));
        DataSource gs2 = new RowListSource(grs);
        DataTableState gt2 = new DataTableState();
        DataTable.EnsureInit(gt2, dc2, gs2);
        DataTable.SetDetail(gt2, new FixedDetail());
        DataTable.GroupBy(gt2, 0);                 // group by k: [x: 2] [y: 1]
        DataTable.Recompute(gt2, dc2, gs2);
        // 核心契约与语义定义。
        Console.WriteLine(DataTable.DispCount(gt2) == 5);
        DataTable.ExpandRow(gt2, gs2, 0);
        DataTable.Recompute(gt2, dc2, gs2);
        Console.WriteLine(DataTable.DispCount(gt2) == 7);   // + 2 detail slots
        // 用例前置构造与行为断言。
        Console.WriteLine(DataTable.DispKind(gt2, 0) == 1);          // group header "x"
        Console.WriteLine(DataTable.DispKind(gt2, 1) == 0 && DataTable.DispRowOf(gt2, 1) == 0);
        Console.WriteLine(DataTable.DispKind(gt2, 2) == 2 && DataTable.DispRowOf(gt2, 2) == 0);
        Console.WriteLine(DataTable.DispKind(gt2, 3) == 2);
        Console.WriteLine(DataTable.DispKind(gt2, 4) == 0 && DataTable.DispRowOf(gt2, 4) == 1);
        // 用例前置构造与行为断言。
        DataTable.ToggleCollapse(gt2, DataTable.PathKey(gt2, dc2, gs2, 0, 0));
        DataTable.Recompute(gt2, dc2, gs2);
        Console.WriteLine(DataTable.DispCount(gt2) == 3);   // [x] header + [y] header + y row
        Console.WriteLine(DataTable.IsExpanded(gt2, 0));  // still expanded, just hidden

