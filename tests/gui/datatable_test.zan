        gpcols.Add(new DataColumn("dept", 80));
        gpcols.Add(new DataColumn("name", 80));
        List<DataRow> gprows = new List<DataRow>();
        gprows.Add(Program.Row("Rome", "Ops", "a"));
        gprows.Add(Program.Row("Rome", "Dev", "b"));
        gprows.Add(Program.Row("Oslo", "Ops", "c"));
        DataSource gpsrc = new RowListSource(gprows);
        DataTableState gpst = new DataTableState();
        DataTable.EnsureInit(gpst, gpcols, gpsrc);
        gpst.showGroupPanel = true;
        DataTable.GroupBy(gpst, 0);                    // city
        DataTable.GroupBy(gpst, 1);                    // then dept
        DataTable.Recompute(gpst, gpcols, gpsrc);
        Console.WriteLine(gpst.groupCols.Count == 2);
        Console.WriteLine(gpst.groupCols[0] == 0 && gpst.groupCols[1] == 1);
        // 用例前置构造与行为断言。
        Console.WriteLine(gpst.groups[0].label);        // Oslo
        int panelSlots = DataTable.DispCount(gpst);

        // 用例前置构造与行为断言。
        // IDE 工具链交互与状态驱动契约。
        DataTable.MoveGroup(gpst, 1, 0);
        DataTable.Recompute(gpst, gpcols, gpsrc);
        Console.WriteLine(gpst.groupCols[0] == 1 && gpst.groupCols[1] == 0);
        Console.WriteLine(gpst.groups[0].label);        // Dev
        Console.WriteLine(DataTable.DispKind(gpst, 0) == 1 && DataTable.DispLevel(gpst, 0) == 0);

        // IDE 工具链交互与状态驱动契约。
        DataTable.MoveGroup(gpst, 1, 9);
        Console.WriteLine(gpst.groupCols[0] == 0 && gpst.groupCols[1] == 1);
        DataTable.MoveGroup(gpst, 1, 0 - 3);
        Console.WriteLine(gpst.groupCols[0] == 1 && gpst.groupCols[1] == 0);
        // 核心契约与语义定义。
        DataTable.MoveGroup(gpst, 2, 0);
        Console.WriteLine(gpst.groupCols.Count == 2 && gpst.groupCols[0] == 1);

        // IDE 工具链交互与状态驱动契约。
        DataTable.UngroupOne(gpst, 1);
        DataTable.Recompute(gpst, gpcols, gpsrc);
        Console.WriteLine(gpst.groupCols.Count == 1 && gpst.groupCols[0] == 0);
        Console.WriteLine(DataTable.DispCount(gpst) < panelSlots);   // one nesting less
        Console.WriteLine(gpst.groups[0].label);        // Oslo again
        // 核心契约与语义定义。
        DataTable.UngroupOne(gpst, 2);
        Console.WriteLine(gpst.groupCols.Count == 1);
        // 核心契约与语义定义。
        DataTable.UngroupOne(gpst, 0);
        DataTable.Recompute(gpst, gpcols, gpsrc);
        Console.WriteLine(gpst.groupCols.Count == 0);
        Console.WriteLine(DataTable.DispCount(gpst) == 3);

        // 用例前置构造与行为断言。
        // IDE 工具链交互与状态驱动契约。
        DataTable.GroupByAt(gpst, 0, 0);
        DataTable.GroupByAt(gpst, 1, 0);
        Console.WriteLine(gpst.groupCols[0] == 1 && gpst.groupCols[1] == 0);
        DataTable.GroupByAt(gpst, 1, 1);
