// IDE 工具链交互与状态驱动契约。
// 用例前置构造与行为断言。
class TestServerSource : ServerDataSource {
    static List<DataRow> serverRows;
    static int fetchCalls;

    static TestServerSource CreateWith(List<DataRow> rows, int blockSize) {
        TestServerSource s = new TestServerSource();
        s.Setup(blockSize);
        TestServerSource.serverRows = rows;
        TestServerSource.fetchCalls = 0;
        return s;
    }

    override int FillBlock(int start, int count, List<DataRow> dst) {
        TestServerSource.fetchCalls = TestServerSource.fetchCalls + 1;
        int n = 0;
        int i = start;
        for (; i < TestServerSource.serverRows.Count && n < count; n = n + 1) {
            dst.Add(TestServerSource.serverRows[i]);
            i = i + 1;
        }
        return n;
    }
}

// 用例前置构造与行为断言。
// IDE 工具链交互与状态驱动契约。
class TagWidgetProvider : CellWidgetProvider {
    static int provides;

    override Control Provide(App app, DataSource src, int row, int col,
                             int x, int y, int w, int h) {
        TagWidgetProvider.provides = TagWidgetProvider.provides + 1;
        if (col != 0) { return null; }
        Button b = new Button("tag-" + Convert.ToString(row));
        b.Class = "small text";
        return b;
    }
}
