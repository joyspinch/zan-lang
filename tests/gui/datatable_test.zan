        List<DataRow> srows = new List<DataRow>();
        for (int si2 = 0; si2 < 500; si2 = si2 + 1) {
            srows.Add(Row("s" + Convert.ToString(si2), Convert.ToString(si2), ""));
        }
        TestServerSource ss = TestServerSource.CreateWith(srows, 25);
        Console.WriteLine(ss.RowCount() == 0);            // nothing fetched yet
        Console.WriteLine(ss.HasMore());                  // unknown total -> more
        Console.WriteLine(ss.CellReady(0, 0) == false);   // unfetched row

        // 核心契约与执行状态转移规范。
        ss.RequestBlock(0);
        Console.WriteLine(ss.Poll());                     // folded in
        Console.WriteLine(ss.RowCount() == 25);
        Console.WriteLine(ss.CellReady(0, 0));
        Console.WriteLine(ss.CellText(0, 0) == "s0");
        Console.WriteLine(ss.CellText(24, 0) == "s24");
        Console.WriteLine(ss.Poll() == false);            // idle afterwards

        // IDE 工具链交互与状态驱动契约。
