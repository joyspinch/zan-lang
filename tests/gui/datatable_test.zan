using System;
using Gui;
using Gui.Widget;

namespace DataTableTest;

/// Headless verification of DataTable's data pipeline: loose ParseReal,
/// half-up FormatReal, decimal/date/bool-aware cell compare and format, the
/// filter stages (comparison, date presets, top-N), cell-cursor movement, and
/// a full sort + footer-aggregate pass where fractions must survive (a sum
/// keeps its cents, an average is not truncated to an int).
class Program {
    static DataRow Row(string a, string b, string c) {
        DataRow r = DataRow.Create();
        r.Push(a);
        r.Push(b);
        r.Push(c);
        return r;
    }

    static void Main() {
        // ---- ParseReal accepts separators / currency / sign; FormatReal is half-up ----
        Console.WriteLine(DataTable.FormatReal(DataTable.ParseReal("1234.5678"), 4));
        Console.WriteLine(DataTable.FormatReal(DataTable.ParseReal("$1,234.50"), 2));
        Console.WriteLine(DataTable.FormatReal(DataTable.ParseReal("-0.75"), 2));
        Console.WriteLine(DataTable.FormatReal(2.345, 2));
        Console.WriteLine(DataTable.FormatReal(7.6, 0));

        // ---- a decimals>0 column compares by value, so 1.5 and 1.9 no longer tie ----
        DataColumn rc = DataColumn.Real("v", 60, 2);
        Console.WriteLine(DataTable.CompareCellCol(rc, "1.5", "1.9"));
        Console.WriteLine(DataTable.CompareCellCol(rc, "1.9", "1.5"));
        Console.WriteLine(DataTable.CompareCellCol(rc, "1.5", "1.50"));

        // ---- FormatCell renders to the column's declared decimals ----
        Console.WriteLine(DataTable.FormatCell(rc, "3.5"));
        Console.WriteLine(DataTable.FormatCell(rc, "3.567"));

        // ---- sort + aggregate through the grid pipeline ----
        List<DataColumn> cols = new List<DataColumn>();
        cols.Add(DataColumn.Create("name", 80));
        cols.Add(DataColumn.Sum(DataColumn.Real("val", 80, 2)));
        cols.Add(DataColumn.Avg(DataColumn.Numeric("qty", 80)));

        List<DataRow> rows = new List<DataRow>();
        rows.Add(Row("a", "1.9", "3"));
        rows.Add(Row("b", "1.5", "4"));
        rows.Add(Row("c", "10.25", "0"));

        DataSource src = RowListSource.Create(rows);
        DataTableState st = DataTableState.Create();
        DataTable.EnsureInit(st, cols, src);

        DataTable.SortBy(st, 1, 1);
        st.dirty = true;
        DataTable.Recompute(st, cols, src);
        string seq = "";
        foreach (int oi in st.order) { seq = seq + src.CellText(oi, 0); }
        Console.WriteLine(seq);

        DataTable.SortBy(st, 1, 2);
        st.dirty = true;
        DataTable.Recompute(st, cols, src);
        seq = "";
        foreach (int oi in st.order) { seq = seq + src.CellText(oi, 0); }
        Console.WriteLine(seq);

        // sum keeps its cents; avg of 3+4+0 is 2.3333, not the truncated 2
        DataTable.ComputeSummary(st, cols, src);
        Console.WriteLine(DataTable.FormatReal(st.aggReal[1], 2));
        Console.WriteLine(DataTable.FormatReal(st.aggReal[2], 4));
        // The footer strings carry a non-ASCII sigma, so compare in-program and
        // print the verdict — the golden file stays pure ASCII.
        Console.WriteLine(st.summaryText[1] == Text.CharStr(931) + " 13.65");
        Console.WriteLine(st.summaryText[2]);

        // ---- date columns: parse, render, sort and bucket ----
        // A date column keys on days since the epoch, so a chronological order
        // holds across a year boundary where a string compare would not.
        Console.WriteLine(DataTable.ParseDate("2026-07-26", 0));
        Console.WriteLine(DataTable.ParseDate("2026/7/26", 0));
        Console.WriteLine(DataTable.ParseDate("20260726", 0));
        Console.WriteLine(DataTable.ParseDate("26/07/2026", 1));
        Console.WriteLine(DataTable.ParseDate("07/26/2026", 2));
        Console.WriteLine(DataTable.ParseDate("2026-07-26 13:45:00", 0));
        // two-digit years split at 70 (d-m-y order, so the year is last)
        Console.WriteLine(DataTable.ParseDate("01-01-99", 1) == DataTable.ParseDate("1999-01-01", 0));
        Console.WriteLine(DataTable.ParseDate("01-01-26", 1) == DataTable.ParseDate("2026-01-01", 0));
        // junk, an out-of-range day and a non-leap 29 Feb are all rejected...
        Console.WriteLine(DataTable.ParseDate("n/a", 0) == DataTable.NoDate());
        Console.WriteLine(DataTable.ParseDate("2026-02-30", 0) == DataTable.NoDate());
        Console.WriteLine(DataTable.ParseDate("2023-02-29", 0) == DataTable.NoDate());
        Console.WriteLine(DataTable.ParseDate("99-01-01", 1) == DataTable.NoDate());
        // ...but a real leap day parses
        Console.WriteLine(DataTable.ParseDate("2024-02-29", 0) == DataTable.NoDate());

        int day = DataTable.ParseDate("2026-07-26", 0);
        Console.WriteLine(DataTable.FormatDate(day, 0));
        Console.WriteLine(DataTable.FormatDate(day, 1));
        Console.WriteLine(DataTable.FormatDate(day, 2));
        Console.WriteLine(DataTable.FormatDate(day, 4));
        Console.WriteLine(DataTable.FormatDate(day, 5));
        Console.WriteLine(DataTable.FormatDate(day, 6));
        Console.WriteLine(DataTable.FormatDate(DataTable.NoDate(), 0) == "");

        Console.WriteLine(DataTable.DateGroupKey(day, 1));
        Console.WriteLine(DataTable.DateGroupKey(day, 2));
        Console.WriteLine(DataTable.DateGroupKey(day, 3));
        Console.WriteLine(DataTable.DateGroupKey(day, 4));

        // FormatCell normalises mixed stored spellings to one display pattern
        DataColumn dc = DataColumn.Date("when", 110);
        Console.WriteLine(DataTable.FormatCell(dc, "2026/7/6"));
        Console.WriteLine(DataTable.FormatCell(dc, "20260706"));
        Console.WriteLine(DataTable.FormatCell(dc, "not a date"));
        // chronological, not lexical: 2026-01-05 comes after 2025-12-31
        Console.WriteLine(DataTable.CompareCellCol(dc, "2025-12-31", "2026-01-05"));

        List<DataColumn> dcols = new List<DataColumn>();
        dcols.Add(DataColumn.Create("name", 80));
        dcols.Add(DataColumn.Date("when", 110));
        dcols.Add(DataColumn.Create("pad", 40));

        List<DataRow> drows = new List<DataRow>();
        drows.Add(Row("x", "2026-01-05", ""));
        drows.Add(Row("y", "2025-12-31", ""));
        drows.Add(Row("z", "2026-07-26", ""));

        DataSource dsrc = RowListSource.Create(drows);
        DataTableState dst = DataTableState.Create();
        DataTable.EnsureInit(dst, dcols, dsrc);
        DataTable.SortBy(dst, 1, 1);
        dst.dirty = true;
        DataTable.Recompute(dst, dcols, dsrc);
        seq = "";
        foreach (int oi in dst.order) { seq = seq + dsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        // grouping by month collapses the two 2026 dates into distinct buckets
        // but every day of one month into a single header
        DataColumn.DateGroup(dcols[1], 2);
        DataTable.GroupBy(dst, 1);
        dst.dirty = true;
        DataTable.Recompute(dst, dcols, dsrc);
        Console.WriteLine(dst.groups.Count);
        foreach (GroupRow g in dst.groups) { Console.WriteLine(g.label); }

        // ---- bool columns: parse, normalise, sort and toggle ----
        // Every accepted spelling reads as one truth value...
        Console.WriteLine(DataTable.ParseBool("1"));
        Console.WriteLine(DataTable.ParseBool("TRUE"));
        Console.WriteLine(DataTable.ParseBool(" Yes "));
        Console.WriteLine(DataTable.ParseBool("on"));
        // ...and everything else is false, including blanks and junk
        Console.WriteLine(DataTable.ParseBool("0"));
        Console.WriteLine(DataTable.ParseBool("false"));
        Console.WriteLine(DataTable.ParseBool(""));
        Console.WriteLine(DataTable.ParseBool("maybe"));

        DataColumn bc = DataColumn.BoolText(DataColumn.Bool("ok", 70), "Yes", "No");
        // FormatCell collapses a mixed vocabulary onto the column's own pair
        Console.WriteLine(DataTable.FormatCell(bc, "1"));
        Console.WriteLine(DataTable.FormatCell(bc, "TRUE"));
        Console.WriteLine(DataTable.FormatCell(bc, ""));
        // false sorts before true, and equal truths tie whatever the spelling
        Console.WriteLine(DataTable.CompareCellCol(bc, "0", "1"));
        Console.WriteLine(DataTable.CompareCellCol(bc, "yes", "1"));

        List<DataColumn> bcols = new List<DataColumn>();
        bcols.Add(DataColumn.Create("name", 80));
        bcols.Add(DataColumn.Editable(DataColumn.BoolText(DataColumn.Bool("ok", 70), "Yes", "No")));
        bcols.Add(DataColumn.Create("pad", 40));

        List<DataRow> brows = new List<DataRow>();
        brows.Add(Row("p", "yes", ""));
        brows.Add(Row("q", "0", ""));
        brows.Add(Row("r", "TRUE", ""));

        DataSource bsrc = RowListSource.Create(brows);
        DataTableState bst = DataTableState.Create();
        DataTable.EnsureInit(bst, bcols, bsrc);
        DataTable.SortBy(bst, 1, 1);
        bst.dirty = true;
        DataTable.Recompute(bst, bcols, bsrc);
        seq = "";
        foreach (int oi in bst.order) { seq = seq + bsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        // toggling writes the column's own text back and reports an edit
        DataTable.ToggleBoolCell(bst, bcols, bsrc, 1, 1);
        Console.WriteLine(bsrc.CellText(1, 1));
        Console.WriteLine(bsrc.CellBool(1, 1));
        DataTable.ToggleBoolCell(bst, bcols, bsrc, 1, 1);
        Console.WriteLine(bsrc.CellText(1, 1));
        Console.WriteLine(bst.EditValue());
        // a non-editable bool column ignores the toggle
        DataTable.ToggleBoolCell(bst, bcols, bsrc, 0, 2);
        Console.WriteLine(bsrc.CellText(0, 2) == "");

        // grouping yields exactly two buckets despite three spellings
        DataTable.GroupBy(bst, 1);
        bst.dirty = true;
        DataTable.Recompute(bst, bcols, bsrc);
        Console.WriteLine(bst.groups.Count);
        foreach (GroupRow g in bst.groups) { Console.WriteLine(g.label); }

        // ---- comparison rules compare by the column's type, not lexically ----
        ColFilter cf = ColFilter.Create();
        cf.cmpMode = 1;                 // greater than
        cf.cmpA = "9";
        // "10.25" > "9" numerically, though it sorts before "9" as text
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "10.25", 0));
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "1.5", 0));
        cf.cmpMode = 7;                 // between, inclusive
        cf.cmpA = "1.5";
        cf.cmpB = "2";
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "1.5", 0));
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "1.9", 0));
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "2.01", 0));
        // reversed bounds still describe the same range
        cf.cmpA = "2";
        cf.cmpB = "1.5";
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "1.9", 0));
        cf.cmpMode = 8;                 // not between inverts it exactly
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "1.9", 0));
        cf.cmpMode = 9;                 // is empty ignores the operands
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "   ", 0));
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "0", 0));
        cf.cmpMode = 10;
        Console.WriteLine(DataTable.CellPassesCol(cf, rc, "0", 0));

        // ---- date presets resolve against a fixed "today" ----
        // 2026-07-26 is a Sunday, so "this week" starts on that very day.
        int today = DateTime.DaysFromCivil(2026, 7, 26);
        ColFilter df = ColFilter.Create();
        df.datePreset = 1;              // today
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-26", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-25", today));
        // a cell with no readable date never satisfies a preset
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "n/a", today));
        df.datePreset = 3;              // this week (Sunday-based)
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-08-01", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-08-02", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-25", today));
        df.datePreset = 5;              // this month spans exactly July
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-01", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-31", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-08-01", today));
        df.datePreset = 7;              // Q3 = Jul..Sep
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-09-30", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-06-30", today));
        df.datePreset = 9;              // YTD stops at today, unlike "this year"
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-01-01", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-12-31", today));
        df.datePreset = 8;
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-12-31", today));
        df.datePreset = 10;             // past excludes today itself
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-26", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-25", today));
        df.datePreset = 11;             // and so does future
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-26", today));
        Console.WriteLine(DataTable.CellPassesCol(df, dcols[1], "2026-07-27", today));

        // ---- top-N runs over the surviving set, keeping the user's row order ----
        List<DataColumn> tcols = new List<DataColumn>();
        tcols.Add(DataColumn.Create("name", 80));
        tcols.Add(DataColumn.Real("v", 60, 1));
        tcols.Add(DataColumn.Create("pad", 40));

        List<DataRow> trows = new List<DataRow>();
        trows.Add(Row("a", "1", ""));
        trows.Add(Row("b", "5", ""));
        trows.Add(Row("c", "3", ""));
        trows.Add(Row("d", "9", ""));
        trows.Add(Row("e", "7", ""));

        DataSource tsrc = RowListSource.Create(trows);
        DataTableState tst = DataTableState.Create();
        DataTable.EnsureInit(tst, tcols, tsrc);
        tst.filters[1].topMode = 1;      // top 2 by value
        tst.filters[1].topN = 2;
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        // rows come back in source order (d before e), not ranked order
        seq = "";
        foreach (int oi in tst.order) { seq = seq + tsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        tst.filters[1].topMode = 2;      // bottom 2
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        seq = "";
        foreach (int oi in tst.order) { seq = seq + tsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        tst.filters[1].topMode = 5;      // above the mean of 5
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        seq = "";
        foreach (int oi in tst.order) { seq = seq + tsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        tst.filters[1].topMode = 3;      // top 40% of 5 rows = 2 rows
        tst.filters[1].topN = 40;
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        seq = "";
        foreach (int oi in tst.order) { seq = seq + tsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        // a tie on the cut line keeps every tied row rather than truncating
        tsrc.SetCell(4, 1, "9");
        tst.filters[1].topMode = 1;
        tst.filters[1].topN = 1;
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        seq = "";
        foreach (int oi in tst.order) { seq = seq + tsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        // cell rules and the set pass compose: >4 leaves b,d,e; top 2 of those
        tst.filters[1].cmpMode = 1;
        tst.filters[1].cmpA = "4";
        tst.filters[1].topN = 2;
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        seq = "";
        foreach (int oi in tst.order) { seq = seq + tsrc.CellText(oi, 0); }
        Console.WriteLine(seq);

        // Reset() drops every stage at once
        tst.filters[1].Reset();
        Console.WriteLine(tst.filters[1].Active());
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        Console.WriteLine(tst.order.Count);

        // ---- cell-cursor movement steps over group headers ----
        DataTable.GroupBy(tst, 1);
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        // grouping by a 5-value column gives 4 headers (9 appears twice)
        // interleaved with the data rows
        Console.WriteLine(tst.dispRows.Count);
        // the first display slot is a group header, so the first *data* slot is 1
        Console.WriteLine(tst.dispRows[0].kind);
        Console.WriteLine(DataTable.FirstDataSlot(tst));
        Console.WriteLine(tst.dispRows[DataTable.LastDataSlot(tst)].kind);
        // walking down from a data slot skips the header that follows it
        int s1 = DataTable.FirstDataSlot(tst);
        int s2 = DataTable.NextDataSlot(tst, s1 + 1, 1);
        Console.WriteLine(s2 - s1);
        // walking past the end reports no slot rather than clamping
        Console.WriteLine(DataTable.NextDataSlot(tst, tst.dispRows.Count, 1));

        // MoveCursor collapses the range; with extend it grows from the anchor
        DataTable.ClearRange(tst);
        Console.WriteLine(DataTable.MoveCursor(tst, s1, 1, false));
        Console.WriteLine(tst.HitRow());
        Console.WriteLine(tst.rangeR0 == s1 && tst.rangeR1 == s1);
        Console.WriteLine(DataTable.MoveCursor(tst, s2, 2, true));
        Console.WriteLine(tst.rangeR0 == s1 && tst.rangeR1 == s2);
        Console.WriteLine(tst.rangeC0 == 1 && tst.rangeC1 == 2);
        // a group-header slot is never a cursor target
        Console.WriteLine(DataTable.MoveCursor(tst, 0, 1, false));

        // VisPos reports the position within the visible column order
        List<int> vord = DataTable.VisibleOrder(tst, tcols);
        Console.WriteLine(vord.Count);
        Console.WriteLine(DataTable.VisPos(vord, vord[0]) == 0);
        Console.WriteLine(DataTable.VisPos(vord, 99));

        // ---- NavTarget: the pure key -> (slot, column) decision ----
        // grouped, so the walk has headers to step over. Cursor starts at the
        // first data slot in the first visible column.
        List<int> gv = DataTable.VisibleOrder(tst, tcols);
        DataTable.MoveCursor(tst, s1, gv[0], false);
        // Down lands on the next data slot, skipping the header between them
        List<int> nt = DataTable.NavTarget(tst, gv, 3, 40, 0);
        Console.WriteLine(nt[0] == s2 && nt[1] == gv[0]);
        // Right moves one visible column, staying on the same row
        nt = DataTable.NavTarget(tst, gv, 3, 39, 0);
        Console.WriteLine(nt[0] == s1 && nt[1] == gv[1]);
        // Left at the first column has nowhere to go, so nothing moves
        nt = DataTable.NavTarget(tst, gv, 3, 37, 0);
        Console.WriteLine(nt[0]);
        // Up at the first data row likewise holds position
        nt = DataTable.NavTarget(tst, gv, 3, 38, 0);
        Console.WriteLine(nt[0]);
        // End jumps to the last visible column; Home back to the first
        nt = DataTable.NavTarget(tst, gv, 3, 35, 0);
        Console.WriteLine(nt[1] == gv[gv.Count - 1]);
        DataTable.MoveCursor(tst, s1, gv[gv.Count - 1], false);
        nt = DataTable.NavTarget(tst, gv, 3, 36, 0);
        Console.WriteLine(nt[1] == gv[0]);
        // Ctrl+End goes to the last data slot, Ctrl+Home back to the first
        nt = DataTable.NavTarget(tst, gv, 3, 35, Modifiers.Ctrl());
        Console.WriteLine(nt[0] == DataTable.LastDataSlot(tst));
        DataTable.MoveCursor(tst, DataTable.LastDataSlot(tst), gv[0], false);
        nt = DataTable.NavTarget(tst, gv, 3, 36, Modifiers.Ctrl());
        Console.WriteLine(nt[0] == DataTable.FirstDataSlot(tst));
        // PageDown from the last row has nowhere to go and holds position
        DataTable.MoveCursor(tst, DataTable.LastDataSlot(tst), gv[0], false);
        nt = DataTable.NavTarget(tst, gv, 3, 34, 0);
        Console.WriteLine(nt[0]);
        // PageDown from the top advances about a page and lands on a data row,
        // never on a group header
        DataTable.MoveCursor(tst, s1, gv[0], false);
        nt = DataTable.NavTarget(tst, gv, 3, 34, 0);
        Console.WriteLine(nt[0] > s1);
        Console.WriteLine(tst.dispRows[nt[0]].kind);
        // PageUp from the bottom comes back up without landing on a header
        DataTable.MoveCursor(tst, DataTable.LastDataSlot(tst), gv[0], false);
        nt = DataTable.NavTarget(tst, gv, 3, 33, 0);
        Console.WriteLine(nt[0] < DataTable.LastDataSlot(tst));
        Console.WriteLine(tst.dispRows[nt[0]].kind);
        // Tab wraps off the right edge onto the next row's first column
        DataTable.MoveCursor(tst, s1, gv[gv.Count - 1], false);
        nt = DataTable.NavTarget(tst, gv, 3, 9, 0);
        Console.WriteLine(nt[0] == s2 && nt[1] == gv[0]);
        // Shift+Tab wraps backwards onto the previous row's last column
        DataTable.MoveCursor(tst, s2, gv[0], false);
        nt = DataTable.NavTarget(tst, gv, 3, 9, Modifiers.Shift());
        Console.WriteLine(nt[0] == s1 && nt[1] == gv[gv.Count - 1]);
        // a non-navigation key is not claimed
        Console.WriteLine(DataTable.IsNavKey(65));
        nt = DataTable.NavTarget(tst, gv, 3, 65, 0);
        Console.WriteLine(nt[0]);
        // with no cursor at all, any arrow lands on the top-left cell
        tst.hitOrder = -1;
        tst.hitCol = -1;
        nt = DataTable.NavTarget(tst, gv, 3, 40, 0);
        Console.WriteLine(nt[0] == DataTable.FirstDataSlot(tst) && nt[1] == gv[0]);

        // ---- scrolling brings a slot into view by the minimum amount ----
        DataTable.Ungroup(tst);
        tst.dirty = true;
        DataTable.Recompute(tst, tcols, tsrc);
        tst.scrollRow = 0;
        DataTable.ScrollSlotIntoView(tst, 1, 2);   // already visible: no move
        Console.WriteLine(tst.ScrollTop());
        DataTable.ScrollSlotIntoView(tst, 4, 2);   // scrolls just enough
        Console.WriteLine(tst.ScrollTop());
        DataTable.ScrollSlotIntoView(tst, 0, 2);   // back to the top
        Console.WriteLine(tst.ScrollTop());

        // ---- copy / paste / clear over a range ----
        List<DataColumn> pcols = new List<DataColumn>();
        pcols.Add(DataColumn.Create("ro", 80));                          // not editable
        pcols.Add(DataColumn.Editable(DataColumn.Create("txt", 80)));
        pcols.Add(DataColumn.Editable(DataColumn.BoolText(DataColumn.Bool("ok", 70), "Yes", "No")));

        List<DataRow> prows = new List<DataRow>();
        prows.Add(Row("r0", "a", "0"));
        prows.Add(Row("r1", "b", "0"));
        prows.Add(Row("r2", "c", "0"));

        DataSource psrc = RowListSource.Create(prows);
        DataTableState pst = DataTableState.Create();
        DataTable.EnsureInit(pst, pcols, psrc);
        pst.dirty = true;
        DataTable.Recompute(pst, pcols, psrc);

        // copying a 2x2 range yields tab-separated rows
        pst.rangeR0 = 0; pst.rangeC0 = 0;
        pst.rangeR1 = 1; pst.rangeC1 = 1;
        string copied = DataTable.CopyText(pst, pcols, psrc);
        Console.WriteLine(copied == "r0\ta\r\nr1\tb\r\n");

        // pasting fills down and right from the cursor; the read-only column 0
        // is skipped, and the bool column normalises "yes" to its own text
        DataTable.ClearRange(pst);
        pst.hitOrder = 0;
        pst.hitCol = 1;
        Console.WriteLine(DataTable.PasteText(pst, pcols, psrc, "x\tyes\ny\t0\n"));
        Console.WriteLine(psrc.CellText(0, 1));
        Console.WriteLine(psrc.CellText(0, 2));
        Console.WriteLine(psrc.CellText(1, 1));
        Console.WriteLine(psrc.CellText(1, 2));
        Console.WriteLine(psrc.CellText(2, 1));      // untouched third row
        // a paste that runs past the last row stops instead of erroring
        pst.hitOrder = 2;
        pst.hitCol = 1;
        Console.WriteLine(DataTable.PasteText(pst, pcols, psrc, "p\nq\nr\n"));
        Console.WriteLine(psrc.CellText(2, 1));
        // pasting onto a read-only column alone writes nothing
        pst.hitCol = 0;
        Console.WriteLine(DataTable.PasteText(pst, pcols, psrc, "nope\n"));
        Console.WriteLine(psrc.CellText(2, 0));
        // an empty clipboard is a no-op
        pst.hitCol = 1;
        Console.WriteLine(DataTable.PasteText(pst, pcols, psrc, ""));

        // clearing a range blanks editable text and falsifies editable bools,
        // leaving the read-only column alone
        pst.rangeR0 = 0; pst.rangeC0 = 0;
        pst.rangeR1 = 1; pst.rangeC1 = 2;
        Console.WriteLine(DataTable.ClearRangeCells(pst, pcols, psrc));
        Console.WriteLine(psrc.CellText(0, 0));
        Console.WriteLine(psrc.CellText(0, 1) == "");
        Console.WriteLine(psrc.CellText(0, 2));
        Console.WriteLine(psrc.CellText(1, 2));

        // ---- a cursor on a group caption writes to the first data row under it ----
        DataTable.GroupBy(pst, 0);
        pst.dirty = true;
        DataTable.Recompute(pst, pcols, psrc);
        // slot 0 is a caption, so the paste must land on the data row after it
        Console.WriteLine(pst.dispRows[0].kind);
        DataTable.ClearRange(pst);
        pst.hitOrder = 0;
        pst.hitCol = 1;
        Console.WriteLine(DataTable.PasteText(pst, pcols, psrc, "grp\n"));
        int firstData = pst.dispRows[DataTable.FirstDataSlot(pst)].row;
        Console.WriteLine(psrc.CellText(firstData, 1));
        // and the reported edit row is that data row, never the caption
        Console.WriteLine(pst.EditRow() == firstData);
        // clearing from a caption anchor behaves the same way
        pst.rangeR0 = 0; pst.rangeC0 = 1;
        pst.rangeR1 = 1; pst.rangeC1 = 1;
        Console.WriteLine(DataTable.ClearRangeCells(pst, pcols, psrc));
        Console.WriteLine(psrc.CellText(firstData, 1) == "");
        Console.WriteLine(pst.EditRow() == firstData);
    }
}
