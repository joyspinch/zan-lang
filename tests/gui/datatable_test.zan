        Console.WriteLine(DataTable.IsSelected(sr, ds2, 2));
        Console.WriteLine(DataTable.IsSelected(sr, ds2, 1) == false);
        DataTable.SortBy(sr, 0, 2);                    // selection follows the keys
        DataTable.Recompute(sr, dc2, ds2);
        Console.WriteLine(DataTable.IsSelected(sr, ds2, DataTable.RowIndexOfKey(sr, ds2, RowKey.Of("a"))));
        Console.WriteLine(DataTable.IsSelected(sr, ds2, DataTable.RowIndexOfKey(sr, ds2, RowKey.Of("c"))));

