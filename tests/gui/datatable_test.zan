        ss.RequestBlock(3);
        Console.WriteLine(ss.Poll() == false);
        Console.WriteLine(TestServerSource.fetchCalls == callsBefore);

        // 用例前置构造与行为断言。
        for (int guard = 0; ss.HasMore() && guard < 1000; guard = guard + 1) {
            ss.RequestNextBlock();
            ss.Poll();
        }
        Console.WriteLine(ss.RowCount() == 500);          // all rows streamed
        Console.WriteLine(ss.HasMore() == false);         // short block pinned end
        Console.WriteLine(ss.CellText(499, 0) == "s499");
        Console.WriteLine(ss.Poll() == false);            // idle

