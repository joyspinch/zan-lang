using System;
using Gui;
using Gui.Widget;

// Real retained hit ancestry: input commits once before any paint.
class WheelRouteTest {
    static int fails;
    static void EqInt(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got " + Convert.ToString(got) + " want " + Convert.ToString(want));
    }
    static ScrollColumn Make(App app, int extent) {
        ScrollColumn column = new ScrollColumn();
        column.UseApp(app);
        column.SetProp("style", "padding:0;gap:0;overflow-y:auto");
        Control content = new Control();
        content.Prefer(100, extent);
        column.Add(content);
        column.MeasureTree(app);
        return column;
    }
    static void Paint(App app, Control root) {
        app.BeginOffscreenFrame();
        root.RenderTree(app);
        root.RenderTree(app);
        app.EndOffscreenFrame();
    }
    static void Wheel(App app, int x, int y, int delta) {
        app.ProcessOffscreenInput(13, x, y, 0, delta, 0, 0);
    }
    static void Main() {
        App frame = App.CreateOffscreen("Frame context", 2, 2);
        App app = App.CreateOffscreen("wheel-route", 400, 300);
        ScrollColumn outer = Make(app, 5000);
        outer.Arrange(20, 40, 240, 200);
        app.SetRootControl(outer);
        for (int notch = 0; notch < 3; notch = notch + 1) {
            Wheel(app, 100, 100, -120);
            EqInt("linear input before paint", outer.ScrollTop(), app.scrollSpeed * (notch + 1));
        }
        Paint(app, outer);
        Paint(app, outer);
        EqInt("paint never replays", outer.ScrollTop(), 3 * app.scrollSpeed);
        Wheel(app, 10, 10, -120);
        EqInt("outside wheel", outer.ScrollTop(), 3 * app.scrollSpeed);
        Wheel(app, 100, 100, -120);
        EqInt("teleport in commits immediately", outer.ScrollTop(), 4 * app.scrollSpeed);
        outer.SetScrollTop(0);
        ScrollColumn inner = Make(app, 5000);
        outer.Add(inner);
        inner.Arrange(100, 80, 120, 100);
        Wheel(app, 120, 100, -120);
        EqInt("inner advances alone", inner.ScrollTop(), app.scrollSpeed);
        EqInt("outer held", outer.ScrollTop(), 0);
        Wheel(app, 120, 100, 120);
        EqInt("inner returns", inner.ScrollTop(), 0);
        EqInt("outer held on return", outer.ScrollTop(), 0);
        Wheel(app, 60, 60, -120);
        EqInt("switch to outer has no replay delay", outer.ScrollTop(), app.scrollSpeed);
        outer.SetScrollTop(0);
        inner.SetScrollTop(inner.ScrollExtent() - inner.ScrollViewport().height);
        Wheel(app, 120, 100, -120);
        EqInt("inner boundary bubbles", outer.ScrollTop(), app.scrollSpeed);
        outer.Remove(inner);
        outer.SetScrollTop(0);
        ScrollColumn flat = Make(app, 100);
        outer.Add(flat);
        flat.Arrange(100, 80, 120, 100);
        Wheel(app, 120, 100, -120);
        EqInt("flat container passes wheel", outer.ScrollTop(), app.scrollSpeed);
        EqInt("flat remains zero", flat.ScrollTop(), 0);
        Wheel(app, 120, 100, -120);
        EqInt("outer stays linear over flat", outer.ScrollTop(), 2 * app.scrollSpeed);
        outer.SetDisabled(true);
        Wheel(app, 120, 100, -120);
        EqInt("disabled ancestry inert", outer.ScrollTop(), 2 * app.scrollSpeed);
        app.SetRootControl(null);
        app.canvas.Destroy();
        frame.canvas.Destroy();
        Console.WriteLine(fails == 0 ? "WHEELROUTE PASS" : "WHEELROUTE FAIL " + Convert.ToString(fails));
    }
}
