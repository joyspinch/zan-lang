// GenHtml 编译期样式 scoping（Vue <style scoped> 同语义）端到端：
// 生成器给每个元素混入文档作用域类 zs-<基名> 并改写文档 CSS 的每个
// 复合块，两份文档同名类合装同一张 appCss 后各自身份、body:flex
// 不跨文档泄漏。无头 MeasureTree/Arrange 断言几何。
using System;
using Gui;

class HtmlScopeProbe {
    static int fails;

    static void Eq(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": "
            + Convert.ToString(got) + " != " + Convert.ToString(want));
    }

    static void Main() {
        Form f = Form.Create("scope", 400, 300);
        App app = f.GetApp();
        app.UseAppCss(HtmlScopeHtml.Css + "\n" + HtmlScopeBHtml.Css);

        Control ra = HtmlScopeHtml.Build(null);
        ra.MeasureTree(app);
        ra.Arrange(0, 0, 400, 300);
        Control k1 = ra.Find("K1");
        Control k2 = ra.Find("K2");
        Eq("A card width 120", k1 == null ? 0 - 1 : k1.bw, 120);
        Eq("A body flex (K2 right of K1)",
           k1 != null && k2 != null && k2.bx > k1.bx ? 1 : 0, 1);
        Eq("A css rewritten with scope class",
           HtmlScopeHtml.Css.IndexOf(".card.zs-html-scope") >= 0 ? 1 : 0,
           1);
        Eq("A root carries scope class",
           Style.Has(ra.Class, "zs-html-scope") ? 1 : 0, 1);

        Control rb = HtmlScopeBHtml.Build(null);
        rb.MeasureTree(app);
        rb.Arrange(0, 0, 400, 300);
        Control k3 = rb.Find("K3");
        Control k4 = rb.Find("K4");
        Eq("B card width 40 (own rule wins)",
           k3 == null ? 0 - 1 : k3.bw, 40);
        Eq("B body stays block (no flex leak)",
           k3 != null && k4 != null && k4.by > k3.by ? 1 : 0, 1);
        Eq("B root carries own scope class",
           Style.Has(rb.Class, "zs-html-scope-b") ? 1 : 0, 1);

        // ---- 运行期装载通道同语义：LoadHtml 即组件，同名类互不串 ----
        // 先装 120px 再装 40px——无 scoping 时后装的规则会整体覆盖前者。
        string docA = "<style>.card { width: 120px; height: 10px; }"
            + "</style><div class=\"card\" id=\"L1\"></div>";
        string docB = "<style>.card { width: 40px; height: 10px; }"
            + "</style><div class=\"card\" id=\"L2\"></div>";
        Control r1 = app.LoadHtmlWith(docA, null, "");
        r1.MeasureTree(app);
        r1.Arrange(0, 0, 400, 300);
        Control l1 = r1.Find("L1");
        Eq("runtime docA keeps 120", l1 == null ? 0 - 1 : l1.bw, 120);
        Eq("runtime docA scoped",
           Style.Has(r1.Class, "zs-load-0") ? 1 : 0, 1);
        Control r2 = app.LoadHtmlWith(docB, null, "");
        r2.MeasureTree(app);
        r2.Arrange(0, 0, 400, 300);
        Control l2 = r2.Find("L2");
        Eq("runtime docB keeps 40 (own rule)",
           l2 == null ? 0 - 1 : l2.bw, 40);
        Eq("runtime docB scoped",
           Style.Has(r2.Class, "zs-load-1") ? 1 : 0, 1);

        if (fails == 0) { Console.WriteLine("GUI_HTML_SCOPE_OK"); }
    }
}
