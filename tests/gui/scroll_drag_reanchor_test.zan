using System;
using Gui;
using Gui.Widget;

// Retained capture reanchors when content or viewport geometry changes mid-drag.
class ScrollDragReanchorTest {
    static int fails;
    static void EqInt(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got " + Convert.ToString(got) + " want " + Convert.ToString(want));
    }
    static void Input(App app, int kind, int x, int y, int button) {
        app.ProcessOffscreenInput(kind, x, y, button, 0, 0, 0);
    }
    static void Main() {
        App frame = App.CreateOffscreen("Frame context", 2, 2);
        App app = App.CreateOffscreen("scroll-drag", 400, 300);
        ScrollColumn column = new ScrollColumn();
        column.UseApp(app);
        column.SetProp("style", "padding:0;gap:0;overflow-y:auto");
        Control content = new Control();
        content.Prefer(100, 2800);
        column.Add(content);
        column.MeasureTree(app);
        column.Arrange(0, 0, 390, 280);
        app.SetRootControl(column);
        ScrollState geometry = new ScrollState();
        Rect view = column.ScrollViewport();
        Rect track = geometry.Track(app, view.x, view.y, view.width, view.height, false);
        int x = track.x + track.width / 2;
        int y = track.y + geometry.ThumbLength(app, view.height, column.ScrollExtent()) / 2;
        Input(app, 2, x, y, 0);
        EqInt("captured before paint", app.GetCapturedPointer() == column ? 1 : 0, 1);
        EqInt("press keeps offset", column.ScrollTop(), 0);
        int travel = view.height - geometry.ThumbLength(app, view.height, column.ScrollExtent());
        int expected = 70 * (column.ScrollExtent() - view.height) / travel;
        Input(app, 1, x, y + 70, 0);
        EqInt("mid drag commits", column.ScrollTop(), expected);
        content.Prefer(100, 5600);
        column.MeasureTree(app);
        column.Arrange(0, 0, 390, 280);
        Input(app, 1, x, y + 71, 0);
        EqInt("content change reanchors", column.ScrollTop(), expected);
        Input(app, 1, x, y + 71, 0);
        EqInt("hold does not drift", column.ScrollTop(), expected);
        app.BeginOffscreenFrame();
        column.RenderTree(app);
        column.RenderTree(app);
        app.EndOffscreenFrame();
        EqInt("paint does not drag", column.ScrollTop(), expected);
        Input(app, 3, x, y + 80, 1);
        EqInt("secondary release preserves capture", app.GetCapturedPointer() == column ? 1 : 0, 1);
        Input(app, 3, x, y + 81, 0);
        EqInt("primary release retires capture", app.GetCapturedPointer() == null ? 1 : 0, 1);
        int newTravel = view.height - geometry.ThumbLength(app, view.height, column.ScrollExtent());
        EqInt("release commits final coordinate", column.ScrollTop(), expected + 10 * (column.ScrollExtent() - view.height) / newTravel);
        app.SetRootControl(null);
        app.canvas.Destroy();
        frame.canvas.Destroy();
        Console.WriteLine(fails == 0 ? "SCROLLDRAG PASS" : "SCROLLDRAG FAIL " + Convert.ToString(fails));
    }
}
