using System;
using System.Diagnostics;
using System.Json;
using System.Net.Sockets;
using System.Net.Http;
using System.Threading;
using Gui;
using Gui.Component.DataTable;

// 核心契约与语义定义。
class HttpTestSrv {
    static HttpServer srv;
    static int hits;

    static int hitCount() { return hits; }

    static int SafeInt(string s) {
        if (s == "" || s == null) { return 0; }
        return Convert.ToInt32(s);
    }

    static async HttpResponse Handle(HttpRequest req) {
        hits = hits + 1;
        int start = SafeInt(req.GetQueryParam("start"));
        int count = SafeInt(req.GetQueryParam("count"));
        string rows = "";
        int made = 0;
        for (int i = 0; i < count; i = i + 1) {
            int idx = start + i;
            if (idx >= 10) { break; }
            if (made > 0) { rows = rows + ","; }
            rows = rows + "[\"r" + Convert.ToString(idx) + "c0\","
                + "\"r" + Convert.ToString(idx) + "c1\"]";
            made = made + 1;
        }
        return HttpResponse.Json("{\"total\":10,\"rows\":[" + rows + "]}");
    }

    static void Entry() {
        Socket.Initialize();
        srv = new HttpServer("127.0.0.1", 18365);
        srv.OnRequest(HttpTestSrv.Handle);
        srv.Start();
    }
}

class HttpSourceTest {
    static int fails;

    static void Ok(string what, bool cond) {
        if (cond) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void Purge(string dir, HttpTableSource src) {
        string p = src.CachePath(0, 100);
        if (File.Exists(p)) { File.Delete(p); }
    }

    static bool PollUntil(HttpTableSource src, int wantRows, int tries) {
        for (int i = 0; i < tries; i = i + 1) {
            src.Poll();
            if (src.RowCount() >= wantRows) { return true; }
            Thread.Sleep(20);
        }
        return false;
    }

    static void Main() {
        fails = 0;
        // 缓存目录必须用绝对路径：File 读族在相对路径 miss 时会回退到
        // exe 目录（rt_file.c 的 alt-base），于是 CWD 相对的清理防不住
        // exe 侧的残留缓存（首轮 fetch 变缓存命中，hits==0 而行数据照常
        // 到达）。绝对路径让清理/读/写三边锚定同一棵树，alt-base 永远
        // 不会介入。
        string cacheRoot = ProcessHost.AppDir();
        if (cacheRoot == "") { cacheRoot = Directory.GetCurrentDirectory(); }
        string cacheDir1 = cacheRoot + "/hts_cache";
        string cacheDir2 = cacheRoot + "/hts_cache2";
        Directory.DeleteRecursive(cacheDir1);
        Directory.DeleteRecursive(cacheDir2);
        Directory.CreateDirectory(cacheDir1);
        Directory.CreateDirectory(cacheDir2);
        Thread.Start(HttpTestSrv.Entry);
        Thread.Sleep(300);

        try {
            // 核心契约与语义定义。
            HttpTableSource a = HttpTableSource.Create("127.0.0.1", 18365,
                                                       "/data", cacheDir1);
            Purge(cacheDir1, a);
            a.RequestBlock(0);
            Ok("network block arrived", PollUntil(a, 10, 300));
            Eq("row count from total", Convert.ToString(a.RowCount()), "10");
            Eq("cell 0,0", a.CellText(0, 0), "r0c0");
            Eq("cell 9,1", a.CellText(9, 1), "r9c1");
            Eq("no error", a.LastError(), "");
            Eq("one http hit", Convert.ToString(HttpTestSrv.hitCount()), "1");
        } catch (Exception ex) {
            Console.WriteLine("EXC network: " + ex.Message);
            fails = fails + 1;
        }

        try {
            // 核心契约与语义定义。
            HttpTableSource b = HttpTableSource.Create("127.0.0.1", 18365,
                                                       "/data", cacheDir1);
            b.RequestBlock(0);
            Ok("cache block arrived", PollUntil(b, 10, 100));
            Eq("cell from cache", b.CellText(3, 0), "r3c0");
            Eq("cache avoided the network",
               Convert.ToString(HttpTestSrv.hitCount()), "1");
        } catch (Exception ex) {
            Console.WriteLine("EXC cache: " + ex.Message);
            fails = fails + 1;
        }

        try {
            // 核心契约与语义定义。
            HttpTableSource c = HttpTableSource.Create("127.0.0.1", 18366,
                                                       "/data", cacheDir2);
            c.RequestBlock(0);
            for (int i = 0; i < 200; i = i + 1) {
                c.Poll();
                if (c.LastError() != "") { break; }
                Thread.Sleep(20);
            }
            Ok("offline error surfaced", c.LastError() != "");
            Eq("offline has no rows", Convert.ToString(c.RowCount()), "0");
        } catch (Exception ex) {
            Console.WriteLine("EXC offline: " + ex.Message);
            fails = fails + 1;
        }

        if (fails == 0) { Console.WriteLine("HTTSOURCE_OK"); }
    }
}
