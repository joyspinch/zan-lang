using System;
using Gui;
using Gui.Widget;

// 无窗口回归：Rate 保留式星级子控件树、MaxStars / SetStars / OnStarClick
// 契约与 allowHalf/readOnly/clearable 属性边界。
class Program {
    static void Line(string s) { Console.WriteLine(s); }

    static void Main() {
        Rate a = new Rate(5);
        a.allowHalf = true;
        Line("stars a = " + Convert.ToString(a.MaxStars()) + " children = " + Convert.ToString(a.ChildCount()));

        a.SetStars(3);
        Line("setStars 3 = " + Convert.ToString(a.Value.Get()));
        a.OnStarClick(3);
        Line("click idx 3 = " + Convert.ToString(a.Value.Get()));

        a.clearable = true;
        a.OnStarClick(3);
        Line("clearable same = " + Convert.ToString(a.Value.Get()));

        a.readOnly = true;
        a.OnStarClick(1);
        Line("readonly ignore = " + Convert.ToString(a.Value.Get()));

        Rate b = new Rate(3);
        b.Max(4);
        Line("resized b = " + Convert.ToString(b.MaxStars()) + " children = " + Convert.ToString(b.ChildCount()));
    }
}
