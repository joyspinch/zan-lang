using System;
using Gui;
using Gui.Widget;

/// 无窗口回归：Rate 的命中 id 预留必须是 2× 星数。
///
/// allowHalf 时 PaintStars 注册 baseId+i（左半）与
/// baseId+maxStars+i（右半）两组矩形；InitRate 若只 Block(stars)，
/// 右半格 id 就越界进后一个控件的 id 空间——后一个 Rate 的点击被
/// 前一个误认领成"右半格"，两个控件互偷悬停/点击（悬停 A 行 → B
/// 行跟着预览；点 B 行 → A 行值被改写）。allowHalf 是构造之后才设
/// 的属性，所以预留一律按 2×，不依赖该标志。
class Program {
    static void Line(string s) { Console.WriteLine(s); }

    static void Main() {
        // ---- 预留 2×：相邻 Rate 的 id 空间不相交 ------------------
        Rate a = new Rate(5);
        a.allowHalf = true;              // 构造后才开半星
        Rate b = new Rate(5);
        Line("gap a->b = " + Convert.ToString(b.baseId - a.baseId)
             + " (expect 10)");
        Line("a block disjoint b: "
             + Convert.ToString(a.baseId + 2 * 5 - 1 < b.baseId));

        // ---- 连续控件（allowHalf 与整星混排）两两不相交 -----------
        Rate c = new Rate(3);
        c.allowHalf = true;
        Rate d = new Rate(4);
        Line("c block disjoint d: " + Convert.ToString(c.baseId + 6 - 1 < d.baseId));
        Line("blocks monotonic: "
             + Convert.ToString(a.baseId < b.baseId && b.baseId < c.baseId
                                && c.baseId < d.baseId));
    }
}
