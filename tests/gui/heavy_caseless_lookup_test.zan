// HeavyControls 查表大小写不敏感回归：HTML 标签名按规范大小写不敏感
// （HtmlParser 统一小写化后再进 Build），注册键却是 PascalCase kind——
// 查表若只做精确匹配，<zebprobectl> 这类解析后的小写 tag 必 miss，
// 控件静默回落 Element（kind 串还在，肉眼难察觉，事件/布局全失效）。
// 修复后：精确命中优先，未中再走大小写不敏感兜底，工厂收到正典 kind。
using System;
using Gui;
using Gui.Markup;

class ZebProbeCtrl : Control {
    public ZebProbeCtrl() {
        this.InitControl("zeb-probe-ctrl", 1);
    }
}

class App {
    static int Main() {
        HeavyControls.Register("ZebProbeCtrl", (string k) => new ZebProbeCtrl());
        HtmlDoc doc = Html.Parse("<zebprobectrl id=\"probe\"></zebprobectrl>", "", null);
        Control c = doc.root.Find("probe");
        if (c is ZebProbeCtrl) {
            Console.WriteLine("CASELESS_LOOKUP_OK");
            return 0;
        }
        Console.WriteLine("CASELESS_LOOKUP_FAIL kind="
            + (c != null ? c.Kind() : "null"));
        return 1;
    }
}
