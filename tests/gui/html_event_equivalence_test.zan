using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Markup;

// 用户自定义控件只需以 [Event] 声明事件：按名接线、HTML @事件、设计器
// 事件表都由基类 EventTable 自动生成，无需重写 BindEvent/Events。
class HtmlEventProbe : Control {
    [Event]
    public UiEvent CustomCompleted = new UiEvent();

    public override string Kind() { return "HtmlEventProbe"; }
}

class HtmlEventEquivalenceTest {
    static int htmlCalls;
    static int codeCalls;
    static Control sender;

    static void Check(bool ok, string label) {
        if (!ok) { throw new Exception("HTML event equivalence: " + label); }
    }
    static void HtmlCall() { htmlCalls = htmlCalls + 1; }
    static void CodeCall(Control control) { codeCalls = codeCalls + 1; sender = control; }

    static void Raise(Control control, string evt) {
        if (control is Input) { ((Input)control).Submit.Raise(control); }
        else if (control is Menu) { ((Menu)control).Select.Raise(control); }
        else if (control is Ribbon) { ((Ribbon)control).CommandClicked.Raise(control); }
        else if (control is ListView<string>) {
            ListView<string> list = (ListView<string>)control;
            if (evt == "Select") { list.Select.Raise(control); }
            else if (evt == "Activate") { list.Activate.Raise(control); }
            else { list.Context.Raise(control); }
        } else if (control is TreeView) {
            TreeView tree = (TreeView)control;
            if (evt == "Select") { tree.Select.Raise(control); }
            else if (evt == "Activate") { tree.Activate.Raise(control); }
            else { tree.Context.Raise(control); }
        } else { ((HtmlEventProbe)control).CustomCompleted.Raise(control); }
    }

    static void Case(string tag, string spelling, string evt) {
        HtmlHandlers handlers = new HtmlHandlers();
        handlers.Add("OnEvent", HtmlCall);
        HtmlDoc doc = Html.Parse("<" + tag + " @" + spelling + "=\"OnEvent\"></" + tag + ">", "", handlers);
        Control control = doc.root.ChildAt(0);
        Check(control.GetHandler(evt) == "OnEvent", tag + " resolves " + evt);
        control.BindEvent(evt, CodeCall);
        htmlCalls = 0;
        codeCalls = 0;
        sender = null;
        Raise(control, evt);
        Check(htmlCalls == 1 && codeCalls == 1 && sender == control, tag + " shares " + evt + " slot");
    }

    static void Main() {
        ControlFactory.Register("HtmlEventProbe", (string kind) => new HtmlEventProbe());
        Case("input", "submit", "Submit");
        Case("zan-menu", "select", "Select");
        Case("zan-ribbon", "command-clicked", "CommandClicked");
        Case("zan-list-view", "select", "Select");
        Case("zan-list-view", "activate", "Activate");
        Case("zan-list-view", "context", "Context");
        Case("zan-tree-view", "select", "Select");
        Case("zan-tree-view", "activate", "Activate");
        Case("zan-tree-view", "context", "Context");
        Case("zan-html-event-probe", "custom-completed", "CustomCompleted");
        Case("zan-html-event-probe", "CUSTOMCOMPLETED", "CustomCompleted");
        Check(HtmlText.EventKind("size-change", new Pagination().Events()) == "SizeChange", "SizeChange is not Resize");
        Check(HtmlText.EventKind("command-clicked.once", new Ribbon().Events()) == "CommandClicked", "modifiers stay syntax");
        Check(DesignerHtml.NormalizeEventName("custom-completed") == "CustomCompleted", "codec preserves custom semantic event");
        Check(DesignerHtml.NormalizeEventName("size-change") == "SizeChange", "codec preserves SizeChange");
        Check(DesignerHtml.NormalizeEventName("dblclick") == "DoubleClick", "DOM double click syntax");
        Console.WriteLine("HTML_EVENT_EQUIVALENCE_OK");
    }
}
