using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

class ClickCounter {
    public int count;
    public void Bump() { count = count + 1; }
}

class GuiOverlayLayoutEncapsulationTest {
    static void Check(bool ok, string label) {
        if (!ok) { throw new Exception("EncapsulationTest FAIL: " + label); }
    }

    static void Drain(App app) {
        app.DrainPosts();
        while (true) {
            Action a = Dispatcher.Take();
            if (a == null) { return; }
            a();
        }
    }

    static void TestTabSwitchGlobalLayoutStability(App app) {
        Panel root = Panel.Column();
        root.SetInlineStyleCss("padding: 12; gap: 10;");

        Card topCard = new Card();
        topCard.SetInlineStyleCss("padding: 8; gap: 6;");
        Panel row1 = Panel.Row();
        row1.Add(new Button("Skin A"));
        row1.Add(new Button("Skin B"));
        Panel row2 = Panel.Row();
        row2.Add(new Button("Fx A"));
        row2.Add(new Button("Fx B"));
        topCard.Add(row1);
        topCard.Add(row2);
        root.Add(topCard);

        Tabs tabs = new Tabs(Tabs.Line(), Tabs.Horizontal());
        tabs.Grow();
        tabs.Add("Short", false);
        tabs.Add("Tall", false);

        ScrollColumn sc0 = new ScrollColumn();
        sc0.Grow();
        for (int i = 0; i < 4; i = i + 1) { sc0.Add(new Button("S" + Convert.ToString(i))); }
        tabs.Page(0).Add(sc0);

        ScrollColumn sc1 = new ScrollColumn();
        sc1.Grow();
        for (int i = 0; i < 40; i = i + 1) { sc1.Add(new Button("T" + Convert.ToString(i))); }
        tabs.Page(1).Add(sc1);

        root.Add(tabs);
        app.SetRootControl(root);

        tabs.Select(0);
        root.UseApp(app);
        root.MeasureTree(app, 800);
        root.Arrange(0, 0, 800, 540);
        int h0 = topCard.bh;
        int pref0 = topCard.prefH;
        Check(h0 >= pref0 && h0 > 0, "topCard not crushed on short tab h0=" + Convert.ToString(h0) + " pref=" + Convert.ToString(pref0));

        tabs.Select(1);
        root.MeasureTree(app, 800);
        root.Arrange(0, 0, 800, 540);
        int h1 = topCard.bh;
        Check(h1 == h0, "switching to tall tab keeps topCard height identical h0=" + Convert.ToString(h0) + " h1=" + Convert.ToString(h1));
        Check(tabs.by + tabs.bh <= 540, "tabs stays bounded inside viewport");
        app.SetRootControl(null);
    }

    static void TestGlassPopupOpacityAndTabStates(App app) {
        app.EnableSkins();
        app.UseSkin("liquid");

        RichMenuPanel menu = new RichMenuPanel(null, 0);
        Check(menu.StyleType() == "contextmenu", "RichMenuPanel uses contextmenu style type");
        StyleBox menuBox = menu.ResolveStyle(app, Style.SNormal());
        int menuA = StyleBox.AlphaOf(menuBox.bg);
        Check(menuA >= 210, "liquid contextmenu bg alpha >= 210 actual=" + Convert.ToString(menuA));

        Modal modal = new Modal("Dialog");
        Check(Style.Has(modal.modalBox.Class, "modal-surface"), "Modal box carries modal-surface class");
        StyleBox modalBox = modal.modalBox.ResolveStyle(app, Style.SNormal());
        int modalA = StyleBox.AlphaOf(modalBox.bg);
        Check(modalA >= 210, "liquid modal-surface bg alpha >= 210 actual=" + Convert.ToString(modalA));

        Card popCard = new Card();
        popCard.ClassName = "popover-card";
        StyleBox popBox = popCard.ResolveStyle(app, Style.SNormal());
        Check(StyleBox.AlphaOf(popBox.bg) >= 210, "liquid popover-card bg alpha >= 210");

        StyleBox tabHover = Style.Of(app, "tab", "line", Style.SHover());
        StyleBox tabSel = Style.Of(app, "tab", "line", Style.SSelected());
        StyleBox tabSelHover = Style.Of(app, "tab", "line", Style.SSelected() | Style.SHover());
        Check(tabSel.FgOr(0) == app.theme.primary, "liquid selected tab uses primary color");
        Check(tabSelHover.FgOr(0) == app.theme.primary, "liquid selected:hover tab preserves primary color");
        Check(StyleBox.AlphaOf(tabSel.bg) > StyleBox.AlphaOf(tabHover.bg),
            "liquid selected tab pill is visually stronger than unselected hover");

        app.UseSkin("frosted");
        StyleBox frostedMenu = menu.ResolveStyle(app, Style.SNormal());
        Check(StyleBox.AlphaOf(frostedMenu.bg) >= 210, "frosted contextmenu bg alpha >= 210");
        StyleBox frostedModal = modal.modalBox.ResolveStyle(app, Style.SNormal());
        Check(StyleBox.AlphaOf(frostedModal.bg) >= 210, "frosted modal-surface bg alpha >= 210");
    }

    static void TestOverlayEventIsolation(App app) {
        Panel root = Panel.Column();
        root.SetInlineStyleCss("padding: 10; gap: 8;");

        ClickCounter bgClicks = new ClickCounter();
        Button bgBtn = new Button("Background");
        bgBtn.Click.Add(bgClicks.Bump);
        root.Add(bgBtn);

        ScrollColumn bgScroll = new ScrollColumn();
        bgScroll.SetInlineStyleCss("height: 160;");
        for (int i = 0; i < 20; i = i + 1) { bgScroll.Add(new Button("Row " + Convert.ToString(i))); }
        root.Add(bgScroll);

        PopupControl pop = new PopupControl("popup", 220, 120);
        Button trig = new Button("Open Popup");
        pop.TriggerContent = trig;
        ClickCounter innerClicks = new ClickCounter();
        Panel popPanel = Panel.Column();
        popPanel.SetInlineStyleCss("padding: 8;");
        Button innerBtn = new Button("Inside Popup");
        innerBtn.Click.Add(innerClicks.Bump);
        popPanel.Add(innerBtn);
        pop.SetPopupContent(popPanel);
        Check(!popPanel.StyleVisible(), "closed popup panel starts hidden");
        root.Add(pop);

        app.SetRootControl(root);
        app.BeginOffscreenFrame();
        root.RenderInside(app, new Rect(0, 0, 800, 600));
        app.EndOffscreenFrame();
        Drain(app);

        pop.SetOpen(true);
        Check(pop.IsOpen() && popPanel.StyleVisible(), "opening popup shows popupPanel");
        Check(!app.IsPointerEligible(bgBtn), "background button ineligible while popup open");
        Check(app.IsPointerEligible(innerBtn), "inner popup button eligible while popup open");

        int ix = innerBtn.bx + innerBtn.bw / 2;
        int iy = innerBtn.by + innerBtn.bh / 2;
        app.ProcessOffscreenInput(2, ix, iy, 0, 0, 0, 0);
        app.ProcessOffscreenInput(3, ix, iy, 0, 0, 0, 0);
        Drain(app);
        Check(innerClicks.count == 1, "click inside popup fires inner button once");
        Check(bgClicks.count == 0, "click inside popup never penetrates to background");

        // Wheel over popup must not scroll background ScrollColumn
        app.ProcessOffscreenInput(13, ix, iy, 0, -120, 0, 0);
        Drain(app);
        Check(bgScroll.ScrollTop() == 0, "wheel on popup never scrolls background ScrollColumn");

        pop.SetOpen(false);
        Check(!popPanel.StyleVisible(), "closing popup hides popupPanel");

        // Modal mask blocks wheel & click penetration and closes cleanly on mask click
        Modal modal = new Modal("Mask Test");
        modal.Content(new Label("Modal body"));
        modal.Show();
        app.overlayHost.Push(app, null, modal, true);
        Check(modal.bw == app.canvas.Width() && modal.bh == app.canvas.Height(),
            "OverlayHost arranges unanchored Modal to full viewport");
        int mx = 8;
        int my = 8;
        app.ProcessOffscreenInput(13, mx, my, 0, -120, 0, 0);
        Drain(app);
        Check(bgScroll.ScrollTop() == 0, "wheel on modal mask never scrolls background");
        app.ProcessOffscreenInput(2, mx, my, 0, 0, 0, 0);
        app.ProcessOffscreenInput(3, mx, my, 0, 0, 0, 0);
        Drain(app);
        Check(!modal.IsOpen(), "clicking modal mask closes maskClosable modal");
        Check(bgClicks.count == 0, "clicking modal mask never clicks background button");

        app.SetRootControl(null);
    }

    static void TestTooltipCoordsInPushedLayerAndWrapGuard(App app) {
        app.reducedMotion = true;
        Panel root = Panel.Column();
        root.SetInlineStyleCss("padding: 180 0 0 160;");
        Card layerCard = new Card();
        layerCard.SetInlineStyleCss("transform: scale(0.99); padding: 12;");
        Button tipBtn = new Button("Hover Tip");
        tipBtn.Tip = "Layer Tip";
        tipBtn.TipSide = "top";
        layerCard.Add(tipBtn);
        root.Add(layerCard);

        app.SetRootControl(root);
        app.BeginOffscreenFrame();
        root.RenderInside(app, new Rect(0, 0, 800, 600));
        app.EndOffscreenFrame();
        Drain(app);

        int bx = tipBtn.bx + tipBtn.bw / 2;
        int by = tipBtn.by + tipBtn.bh / 2;
        Check(bx >= 160 && by >= 180, "button is positioned away from top-left origin");
        app.ProcessOffscreenInput(1, bx, by, 0, 0, 0, 0);
        Drain(app);

        app.BeginOffscreenFrame();
        root.RenderInside(app, new Rect(0, 0, 800, 600));
        // Inspect requested tooltip anchor before Flush clears it
        TooltipRequest tipReq = Tooltip.Suspend(app);
        Check(tipReq.text.Contains("Layer Tip"), "tooltip requested for hovered button in transformed layer actual=" + tipReq.text);
        Check(tipReq.x >= 160 && tipReq.y >= 180,
            "tooltip anchor uses window-space coords instead of layer-local (0,0) actual="
            + Convert.ToString(tipReq.x) + "," + Convert.ToString(tipReq.y));
        Tooltip.Restore(app, tipReq);
        app.EndOffscreenFrame();
        Drain(app);

        // WrapLines termination guard with narrow maxW on multibyte CJK text
        List<string> wrapped = Tooltip.WrapLines("中文超长字符串不带空格测试换行边界守卫", 14, 10);
        Check(wrapped.Count > 1, "Tooltip.WrapLines terminates cleanly on narrow multibyte text");

        app.reducedMotion = false;
        app.SetRootControl(null);
    }

    static void TestStandardComponentEncapsulation(App app) {
        // 1. Timeline row height is not double-scaled at 150% DPI
        app.SetOffscreenViewport(800, 600, 150);
        int rh = Timeline.RowHeightFor(app, "");
        Check(rh > 40 && rh < 165, "Timeline.RowHeightFor avoids double scaling at 150% DPI actual=" + Convert.ToString(rh));

        // 2. Collapse.AddPanel wraps text by default
        Collapse col = new Collapse();
        CollapseItem item = col.AddPanel("Section", "Long wrapped description paragraph for collapse panel.");
        Check(item.Content is Label && ((Label)item.Content).wrap, "Collapse.AddPanel creates wrapped Label");

        // 3. Steps fits strictly inside container width with zero right overflow
        Steps steps = new Steps();
        steps.AddStepDesc("选择皮肤", "16 套内置预设");
        steps.AddStepDesc("配置材质", "玻璃/柔陶/波普");
        steps.AddStepDesc("叠加动效", "脏矩形合成");
        steps.AddStepDesc("实时验收", "全 DPI 对齐");
        steps.Current.Set(1);
        steps.BuildSteps();
        steps.UseApp(app);
        steps.MeasureTree(app, 600);
        steps.Arrange(0, 0, 600, 80);
        Check(steps.ChildCount() == 4, "Steps has 4 step items");
        Control lastStep = steps.ChildAt(3);
        Check(Style.Has(lastStep.Class, "last"), "last horizontal step carries .last class");
        Check(lastStep.bx + lastStep.bw <= steps.bx + steps.bw + 1,
            "Steps last item stays within right bound lastRight="
            + Convert.ToString(lastStep.bx + lastStep.bw) + " stepsRight=" + Convert.ToString(steps.bx + steps.bw));

        // 4. Result description wraps by default
        Result res = Result.Create("success", "Ready");
        res.Description("Long wrapped description for narrow card.");
        bool foundWrappedDesc = false;
        for (int ri = 0; ri < res.ChildCount(); ri = ri + 1) {
            Control rc = res.ChildAt(ri);
            if (rc is Label && Style.Has(rc.Class, "result-desc") && ((Label)rc).wrap) {
                foundWrappedDesc = true;
            }
        }
        Check(foundWrappedDesc, "Result description label enables wrap by default");

        // 5. Ribbon command buttons are excluded from pill border-radius: 999 in liquid/starlight skins
        app.EnableSkins();
        app.UseSkin("liquid");
        Button ribBtn = new Button("Paste");
        ribBtn.ClassName = "ribbon-cmd";
        StyleBox ribBoxLiquid = ribBtn.ResolveStyle(app, Style.SNormal());
        Check(ribBoxLiquid.radius < 100, "liquid button.ribbon-cmd avoids 999 pill radius actual=" + Convert.ToString(ribBoxLiquid.radius));
        app.UseSkin("starlight");
        StyleBox ribBoxStar = ribBtn.ResolveStyle(app, Style.SNormal());
        Check(ribBoxStar.radius < 100, "starlight button.ribbon-cmd avoids 999 pill radius actual=" + Convert.ToString(ribBoxStar.radius));
    }

    static void TestTabPaneScrollBarAndFlexWrapConvergence(App app) {
        app.SetOffscreenViewport(800, 540, 100);
        Panel root = Panel.Column();
        root.SetInlineStyleCss("padding: 10; gap: 8;");

        Tabs tabs = new Tabs(Tabs.Line());
        tabs.Grow();

        ScrollColumn sc = new ScrollColumn();
        sc.Grow();
        Panel tall = Panel.Column();
        tall.SetInlineStyleCss("gap: 8;");
        for (int i = 0; i < 30; i = i + 1) {
            tall.Add(new Button("Overflow Item #" + Convert.ToString(i)));
        }
        sc.Add(tall);
        tabs.Add(new TabPane("Overflow Tab", sc));

        // Flex-wrap convergence next to a fixed-width sibling
        Panel splitRow = Panel.Row();
        splitRow.SetInlineStyleCss("gap: 12;");
        Panel leftCol = Panel.Column();
        leftCol.Grow();
        Card wrapCard = new Card("Wrap Convergence");
        Panel wrapRow = Panel.Row();
        wrapRow.SetInlineStyleCss("gap: 8; flex-wrap: wrap;");
        Button lastBtn = null;
        for (int j = 0; j < 10; j = j + 1) {
            lastBtn = new Button("Action Button #" + Convert.ToString(j));
            wrapRow.Add(lastBtn);
        }
        wrapCard.Add(wrapRow);
        leftCol.Add(wrapCard);
        splitRow.Add(leftCol);
        Card rightFixed = new Card("Side");
        rightFixed.SetInlineStyleCss("width: 280;");
        rightFixed.Add(new Label("Fixed sidebar"));
        splitRow.Add(rightFixed);
        tabs.Add(new TabPane("Wrap Tab", splitRow));

        root.Add(tabs);
        app.SetRootControl(root);

        // Verify Tab 0: TabPane + ScrollColumn bounds to viewport, wants scrollbar, and scrolls on wheel
        tabs.Select(0);
        app.BeginOffscreenFrame();
        root.RenderInside(app, new Rect(0, 0, 800, 540));
        app.EndOffscreenFrame();
        Drain(app);
        Check(sc.bh > 100 && sc.bh < 520, "TabPane ScrollColumn bounds height to viewport bh=" + Convert.ToString(sc.bh));
        Check(sc.ScrollExtent() > sc.bh + 200, "TabPane ScrollColumn reports overflow extent=" + Convert.ToString(sc.ScrollExtent()) + " bh=" + Convert.ToString(sc.bh));
        int sx = sc.bx + sc.bw / 2;
        int sy = sc.by + sc.bh / 2;
        app.ProcessOffscreenInput(13, sx, sy, 0, -240, 0, 0);
        Drain(app);
        Check(sc.ScrollTop() > 0, "wheel inside TabPane ScrollColumn scrolls content top=" + Convert.ToString(sc.ScrollTop()));

        // Verify Tab 1: flex-wrap card encloses its wrapped last button on Frame 1
        tabs.Select(1);
        app.BeginOffscreenFrame();
        root.RenderInside(app, new Rect(0, 0, 800, 540));
        app.EndOffscreenFrame();
        Drain(app);
        Check(lastBtn != null && lastBtn.by + lastBtn.bh <= wrapCard.by + wrapCard.bh,
            "flex-wrap Card encloses wrapped last child bottom="
            + Convert.ToString(lastBtn.by + lastBtn.bh) + " cardBottom=" + Convert.ToString(wrapCard.by + wrapCard.bh));

        app.SetRootControl(null);
    }

    static void TestInputNumberNarrowWidth(App app) {
        Panel host = Panel.Column();
        host.SetProp("style", "padding: 8; gap: 8; width: 100%; height: 100%;");

        Panel narrowCol = Panel.Column();
        narrowCol.SetProp("style", "width: 140; gap: 8;");
        InputNumber narrowNum = new InputNumber(0, 100);
        narrowNum.SetValue(12);
        narrowCol.Add(narrowNum);

        Panel formWrap = Panel.Column();
        formWrap.SetProp("style", "width: 180;");
        FormGroup fg = new FormGroup();
        InputNumber formNum = new InputNumber(0, 32);
        formNum.SetValue(8);
        fg.Add("圆角数值", formNum);
        formWrap.Add(fg);

        host.Add(narrowCol);
        host.Add(formWrap);
        app.SetRootControl(host);
        app.BeginOffscreenFrame();
        host.MeasureTree(app, app.canvas.Width());
        host.Arrange(0, 0, app.canvas.Width(), app.canvas.Height());
        host.RenderTree(app);
        app.EndOffscreenFrame();
        Drain(app);

        Check(narrowNum.minusBtn.bw > 0 && narrowNum.plusBtn.bw > 0 && narrowNum.inputNode.bw > 0,
            "narrow InputNumber keeps minus/input/plus visible");
        Check(narrowNum.plusBtn.bx + narrowNum.plusBtn.bw <= narrowNum.bx + narrowNum.bw,
            "narrow InputNumber plus button stays inside container bounds");
        Check(formNum.minusBtn.bw > 0 && formNum.plusBtn.bw > 0 && formNum.inputNode.bw > 0,
            "FormGroup InputNumber keeps minus/input/plus visible");
        Check(formNum.plusBtn.bx + formNum.plusBtn.bw <= formNum.bx + formNum.bw,
            "FormGroup InputNumber plus button stays inside container bounds");

        app.SetRootControl(null);
    }

    static void TestRoundedPopupLayoutAndConcentricRadii(App app) {
        app.SetOffscreenViewport(900, 640, 100);
        app.EnableSkins();

        // 1. Icon alias: "layers" resolves to a valid Tabler glyph
        Check(IconSvgData.IndexOf(IconSvg.Alias("layers")) >= 0,
            "IconSvg.Alias maps 'layers' to a valid icon glyph");

        // 2. Skin concentric radii & button.select-option exclusion across liquid / clay / starlight / brutal
        app.UseSkin("liquid");
        Card selPop = new Card("");
        selPop.ClassName = "select-popup";
        StyleBox selBoxLiquid = selPop.ResolveStyle(app, Style.SNormal());
        Check(selBoxLiquid.radius > 0 && selBoxLiquid.radius <= 12,
            "liquid .select-popup uses compact concentric radius <= 12 actual=" + Convert.ToString(selBoxLiquid.radius));

        Button optBtn = new Button("Option A");
        optBtn.ClassName = "select-option align-left";
        StyleBox optLiquid = optBtn.ResolveStyle(app, Style.SNormal());
        Check(optLiquid.radius < 100 && optLiquid.BorderWOr(0) == 0,
            "liquid button.select-option avoids 999 pill & raised border radius="
            + Convert.ToString(optLiquid.radius) + " bw=" + Convert.ToString(optLiquid.BorderWOr(0)));

        app.UseSkin("clay");
        StyleBox selBoxClay = selPop.ResolveStyle(app, Style.SNormal());
        Check(selBoxClay.radius > 0 && selBoxClay.radius <= 14,
            "clay .select-popup uses compact concentric radius <= 14 actual=" + Convert.ToString(selBoxClay.radius));
        StyleBox optClay = optBtn.ResolveStyle(app, Style.SNormal());
        Check(optClay.BorderWOr(0) == 0 && optClay.bg == 0,
            "clay button.select-option keeps flat transparent idle state");

        app.UseSkin("brutal");
        StyleBox selBoxBrutal = selPop.ResolveStyle(app, Style.SNormal());
        Check(selBoxBrutal.radius == 0 && selBoxBrutal.BorderWOr(0) >= 2,
            "brutal .select-popup applies brutalist 0 radius and 2px border");

        // 3. RichMenu: comfortable row metrics, concentric submenu gap & row alignment
        app.UseSkin("liquid");
        Check(RichMenu.RowHeight(app) >= 28 && RichMenu.PadV(app) >= 6 && RichMenu.PadH(app) >= 12,
            "RichMenu metrics provide concentric clearance inside rounded panels");
        RichMenu rm = new RichMenu();
        List<MenuItem> subItems = new List<MenuItem>();
        subItems.Add(MenuItem.Item("Sub A", "sparkles", 11));
        subItems.Add(MenuItem.Item("Sub B", "flame", 12));
        List<MenuItem> rootItems = new List<MenuItem>();
        rootItems.Add(MenuItem.Header("动作菜单"));
        rootItems.Add(MenuItem.Item("普通项", "check", 1));
        rootItems.Add(MenuItem.Submenu("背景动效子菜单", "layers", subItems));
        rootItems.Add(MenuItem.Separator());
        rootItems.Add(MenuItem.Danger("危险操作", "trash", 2));
        rm.SetItems(rootItems);
        rm.ShowAt(app, 60, 80);
        Control triggerRow = rm.rootPanel.ChildAt(2);
        rm.Hover(rm.rootPanel, 2, rm.Session());
        rm.Arrange(rm.bx, rm.by, rm.bw, rm.bh);
        Check(rm.childPanel.visible, "RichMenu opens submenu on hover");
        Check(rm.childPanel.bx >= rm.rootPanel.bx + rm.rootPanel.bw + 3,
            "RichMenu submenu separates cleanly from parent rounded border gap="
            + Convert.ToString(rm.childPanel.bx - (rm.rootPanel.bx + rm.rootPanel.bw)));
        Check(rm.childPanel.by == triggerRow.by - RichMenu.PadV(app),
            "RichMenu submenu aligns first item with trigger row");
        Check(rm.IsSubOpen(0, 2), "RichMenu reports active open submenu row");
        rm.Close();

        // 4. ContextMenu: concentric padding & clean containment
        ContextMenu cm = new ContextMenu();
        cm.AddItem(MenuItem.Header("菜单标题"));
        cm.AddItem(MenuItem.Item("复制", "copy", 1));
        cm.AddSeparator();
        cm.AddItem(MenuItem.Danger("删除", "trash", 2));
        cm.ShowAt(app, 100, 100);
        Check(cm.bw >= 160 && cm.bh > 80, "ContextMenu measures comfortable rounded bounds");
        Control lastCm = cm.ChildAt(cm.ChildCount() - 1);
        Check(lastCm.by + lastCm.bh <= cm.by + cm.bh - 5,
            "ContextMenu last item stays inset inside bottom padding");
        app.overlayHost.Hide(cm);

        // 5. SelectBox cascade: columns inset concentrically inside rounded popup card
        SelectBox casc = new SelectBox("地区");
        casc.Cascade();
        int p0 = casc.AddBranch("华东");
        casc.AddChild(p0, "上海");
        casc.AddChild(p0, "杭州");
        casc.UseApp(app);
        app.SetRootControl(casc);
        casc.MeasureTree(app);
        casc.Arrange(40, 40, 200, 34);
        casc.SetOpen(true);
        Control cascPopup = app.overlayHost.ActiveRoot();
        Check(cascPopup != null && casc.cascadePanel != null && casc.cascadePanel.ChildCount() >= 1,
            "Cascade SelectBox mounts popup card");
        Control col0 = casc.cascadePanel.ChildAt(0);
        Check(col0.bx >= cascPopup.bx + 6 && col0.by >= cascPopup.by + 6,
            "CascadePanel column insets concentrically inside rounded select-popup");
        casc.SetOpen(false);

        // 6. DatePicker: inner calendar strips opaque square background & border inside datepicker-popup
        DatePicker dp = new DatePicker();
        dp.UseApp(app);
        app.SetRootControl(dp);
        dp.MeasureTree(app);
        dp.Arrange(40, 40, 200, 34);
        Card dpCard = dp.EnsurePopupCard(app);
        Check(dpCard != null && dp.calendarWidget != null, "DatePicker creates popup card with Calendar");
        StyleBox innerCalStyle = dp.calendarWidget.ResolveStyle(app, Style.SNormal());
        Check(innerCalStyle.bg == 0 && innerCalStyle.BorderWOr(0) == 0,
            "Calendar inside card.datepicker-popup strips square background and border bg="
            + Convert.ToString(innerCalStyle.bg) + " bw=" + Convert.ToString(innerCalStyle.BorderWOr(0)));

        app.SetRootControl(null);
    }

    static void Main() {
        Dispatcher.Init();
        App app = App.CreateOffscreen("encapsulation regression", 800, 600);
        app.SetChromeVisible(false);
        TestTabSwitchGlobalLayoutStability(app);
        TestGlassPopupOpacityAndTabStates(app);
        TestOverlayEventIsolation(app);
        TestTooltipCoordsInPushedLayerAndWrapGuard(app);
        TestStandardComponentEncapsulation(app);
        TestTabPaneScrollBarAndFlexWrapConvergence(app);
        TestInputNumberNarrowWidth(app);
        TestRoundedPopupLayoutAndConcentricRadii(app);
        app.StopLoop();
        app.SetRootControl(null);
        Drain(app);
        app.canvas.Destroy();
        Console.WriteLine("GUI_OVERLAY_LAYOUT_ENCAPSULATION_OK");
    }
}
