using System;
using Gui;
using Gui.Widget;

class AnimationPhaseTest {
    static void Check(string label, bool ok) {
        if (ok) { return; }
        Console.WriteLine("FAIL " + label);
        throw new Exception("Animation phase: " + label);
    }

    static void Eq(string label, int actual, int expected) {
        AnimationPhaseTest.Check(label, actual == expected);
    }

    static void Near(string label, double actual, double expected) {
        double delta = actual - expected;
        AnimationPhaseTest.Check(label, delta > -0.000001 && delta < 0.000001);
    }

    static void Main() {
        AnimationPhaseTest.Eq("start phase", Spin.DotPhase(0), 0);
        AnimationPhaseTest.Eq("mid-dot phase", Spin.DotPhase(45), 500);
        AnimationPhaseTest.Eq("next dot phase", Spin.DotPhase(90), 1000);
        AnimationPhaseTest.Eq("720ms period", Spin.DotPhase(720), 0);
        AnimationPhaseTest.Eq("period after offset", Spin.DotPhase(765), Spin.DotPhase(45));
        AnimationPhaseTest.Eq("negative clock normalization", Spin.DotPhase(-90), 7000);
        AnimationPhaseTest.Eq("initial head", Spin.DotLevel(0, 0, 0), 1000);
        AnimationPhaseTest.Eq("fading head", Spin.DotLevel(500, 0, 0), 500);
        AnimationPhaseTest.Eq("rising next head", Spin.DotLevel(500, 1, 0), 500);
        AnimationPhaseTest.Eq("handoff completed", Spin.DotLevel(1000, 1, 0), 1000);
        AnimationPhaseTest.Eq("old head cleared", Spin.DotLevel(1000, 0, 0), 0);
        AnimationPhaseTest.Eq("wrap fading head", Spin.DotLevel(7500, 7, 0), 500);
        AnimationPhaseTest.Eq("wrap rising head", Spin.DotLevel(7500, 0, 0), 500);
        AnimationPhaseTest.Check("8ms produces distinct highlight weights",
            Spin.DotLevel(Spin.DotPhase(8), 0, 0) != Spin.DotLevel(Spin.DotPhase(0), 0, 0));
        for (int ms = 0; ms < 720; ms = ms + 8) {
            int phase = Spin.DotPhase(ms);
            int head = 0;
            int tail = 0;
            for (int dot = 0; dot < 8; dot = dot + 1) {
                head = head + Spin.DotLevel(phase, dot, 0);
                tail = tail + Spin.DotLevel(phase, dot, 1);
            }
            AnimationPhaseTest.Eq("head intensity conserved", head, 1000);
            AnimationPhaseTest.Eq("two-dot intensity conserved", tail, 2000);
        }
        Canvas canvas = new Canvas(32, 32);
        canvas.Clear(0xff000000);
        Spin.PaintDot(canvas, 16, 16, 4, 2, 0xffffffff, 1000);
        int full = canvas.GetPixel(21, 16);
        canvas.Clear(0xff000000);
        Spin.PaintDot(canvas, 16, 16, 4, 2, 0xffffffff, 500);
        int half = canvas.GetPixel(21, 16);
        AnimationPhaseTest.Check("intermediate head has distinct pixels",
            half != full && half != 0xff000000);
        canvas.Destroy();
        AnimationPhaseTest.Near("stripe within old tick", Progress.StripePhase(8, 12), 8.0 / 33.0);
        AnimationPhaseTest.Near("stripe speed unchanged", Progress.StripePhase(33, 12), 1.0);
        AnimationPhaseTest.Near("stripe half cycle", Progress.StripePhase(198, 12), 6.0);
        AnimationPhaseTest.Near("stripe cycle", Progress.StripePhase(396, 12), 0.0);
        AnimationPhaseTest.Near("stripe negative clock", Progress.StripePhase(-33, 12), 11.0);
        AnimationPhaseTest.Near("stripe invalid period", Progress.StripePhase(10, 0), 0.0);
        Console.WriteLine("ANIMATION_PHASE_OK");
    }
}
