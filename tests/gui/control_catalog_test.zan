using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

// 编译器合成的控件目录（B-ID172，docs/GUI_CONTROL_CATALOG.md）：
// 用户自定义控件自动入目录、[ControlKind] 别名工厂与泛型闭合、
// 内部/抽象/无无参构造的类不入目录、大小写不敏感、Require 未命中抛异常、
// 运行期 Register 优先于目录。

namespace CatalogProbe;

public class MyCard : Control {
    public MyCard() { }
}

[ControlKind(Name = "MyBadge", Factory = "Make")]
public class MyTagged : Control {
    public MyTagged() { }
    public static MyTagged Make() {
        MyTagged t = new MyTagged();
        t.name = "made";
        return t;
    }
}

[ControlKind(Of = "int")]
public class MyList<T> : Control {
    public MyList() { }
}

public abstract class MyAbstract : Control { }

public class NeedsArgs : Control {
    public NeedsArgs(int n) { }
}

internal class Hidden : Control {
    public Hidden() { }
}

class Program {
    static int fails;

    static void Check(string what, bool ok) {
        if (!ok) {
            fails = fails + 1;
            Console.WriteLine("FAIL " + what);
        }
    }

    static void Main() {
        Check("user control", ControlFactory.Create("MyCard") is MyCard);
        Control made = ControlFactory.Create("MyBadge");
        Check("alias factory", made is MyTagged && made.name == "made");
        Check("alias keeps class kind", ControlFactory.Create("MyTagged") is MyTagged);
        Check("generic closed", ControlFactory.Create("MyList") is MyList<int>);
        Check("abstract excluded", !ControlFactory.Has("MyAbstract"));
        Check("no default ctor excluded", !ControlFactory.Has("NeedsArgs"));
        Check("internal excluded", !ControlFactory.Has("Hidden"));
        Check("standard widget", ControlFactory.Create("Button") is Button);
        Check("radio button form", ControlFactory.Require("RadioButton").Kind() == "RadioButton");
        Check("generic widget", ControlFactory.Create("ListView") is ListView<string>);
        Check("case insensitive", ControlFactory.Create("mycard") is MyCard);
        Check("miss is null", ControlFactory.Create("NoSuchKind") == null);
        bool threw = false;
        try { ControlFactory.Require("NoSuchKind"); }
        catch (Exception e) { threw = e.Message.Contains("NoSuchKind"); }
        Check("require throws", threw);
        Check("require hits", ControlFactory.Require("MyCard") is MyCard);
        ControlFactory.Register("MyCard", (string k) => new Button());
        Check("register overrides catalog", ControlFactory.Create("MyCard") is Button);
        List<string> kinds = ControlFactory.Kinds();
        int myCard = 0;
        for (int i = 0; i < kinds.Count; i = i + 1) {
            if (kinds[i] == "MyCard") { myCard = myCard + 1; }
        }
        Check("kinds deduplicated", myCard == 1);
        Console.WriteLine(fails == 0 ? "CONTROL_CATALOG_OK" : "CONTROL_CATALOG_FAILED");
    }
}
