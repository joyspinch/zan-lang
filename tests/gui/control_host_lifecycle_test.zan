using System;
using Gui;
using Gui.Widget;

class HostLifetimeWatch {
    public weak App app;
    public weak Control root;
}

class ControlHostLifecycleTest {
    static void Check(string label, bool ok) {
        if (!ok) { throw new Exception("control host lifecycle: " + label); }
    }
    static void CreateTree(HostLifetimeWatch watch, bool editable) {
        App app = App.CreateOffscreen("host lifecycle", 320, 240);
        Panel root = Panel.Column();
        if (editable) {
            root.Add(new Input());
            root.Add(new TextArea());
        } else {
            root.Add(new Button("owned root"));
        }
        app.SetRootControl(root);
        app.BeginOffscreenFrame();
        root.RenderInside(app, new Rect(0, 0, 320, 240));
        app.EndOffscreenFrame();
        watch.app = app;
        watch.root = root;
        Check("tree resolves live host", root.FindApp() == app);
        app.canvas.Destroy();
    }
    static void Main() {
        // The first App is retained by the legacy frame context until process exit.
        App frame = App.CreateOffscreen("frame context", 8, 8);
        HostLifetimeWatch watch = new HostLifetimeWatch();
        CreateTree(watch, false);
        Check("host and button tree release without manual detach", watch.app == null && watch.root == null);
        CreateTree(watch, true);
        Check("editable host caches do not retain window", watch.app == null && watch.root == null);
        frame.canvas.Destroy();
        Console.WriteLine("CONTROL_HOST_LIFECYCLE_OK");
    }
}
