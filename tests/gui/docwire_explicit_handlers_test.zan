using System;
using Gui;
using Gui.Widget;

class HandlerModel {
    public int reflected;
    public int overridden;
    public void Fallback() { this.reflected = this.reflected + 1; }
    public void Explicit() { this.overridden = this.overridden + 1; }
}
class Program {
    static int plain;
    static string argument;
    static Control sender;
    static Control itemSender;
    static object itemValue;
    static void Check(bool ok, string text) {
        if (!ok) { throw new InvalidOperationException(text); }
        Console.WriteLine("PASS " + text);
    }
    static Button Declared(Panel root, string handler) {
        Button button = new Button(handler);
        button.SetHandler("Click", handler);
        root.Add(button);
        return button;
    }
    static void Main(string[] args) {
        Panel root = new Panel();
        HandlerModel model = new HandlerModel();
        ModelBinder binder = new ModelBinder();
        binder.SetRoot(root, model);
        if (args.Length > 0 && args[0] == "missing") {
            Program.Declared(root, "MissingHandler");
            DocWire.AutoWire(root, model, binder, () => { });
            throw new InvalidOperationException("missing handler must exit");
        }
        Button plain = Program.Declared(root, "Explicit");
        Button arg = Program.Declared(root, "Argument");
        arg.handlerArg = "captured";
        Button sender = Program.Declared(root, "Sender");
        Button item = Program.Declared(root, "Item");
        item.item = model;
        Button fallback = Program.Declared(root, "Fallback");
        binder.Handle("Explicit", () => { Program.plain = Program.plain + 1; });
        binder.HandleArg("Argument", (string value) => { Program.argument = value; });
        binder.HandleSender("Sender", (Control control) => { Program.sender = control; });
        binder.HandleItem("Item", (Control control, object value) => { Program.itemSender = control; Program.itemValue = value; });
        DocWire.AutoWire(root, model, binder, () => { });
        binder.Wire();
        plain.Click.RaiseS(plain);
        arg.Click.RaiseS(arg);
        sender.Click.RaiseS(sender);
        item.Click.RaiseS(item);
        fallback.Click.RaiseS(fallback);
        Program.Check(Program.plain == 1 && model.overridden == 0, "explicit plain handler wins over same-name model method");
        Program.Check(Program.argument == "captured", "explicit argument handler preserved");
        Program.Check(Program.sender == sender, "explicit sender handler preserved");
        Program.Check(Program.itemSender == item && Program.itemValue == model, "explicit item handler preserved");
        Program.Check(model.reflected == 1, "unregistered model method wired by reflection");
    }
}
