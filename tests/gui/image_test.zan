using System;
using System.Security.Cryptography;
using Gui;
using Gui.Widget;

namespace ImageTest;

/// Gui.Image 的无窗口回归：内存图像注册表（ImageLoadMem /
/// ImageLoadSvg / EvictImage）与组件模型（Kind/Props/Events/
/// ControlFactory）。像素数据在程序内合成（PNM P5 文本头 +
/// ASCII 范围内的灰度字节），不依赖任何外部资源。
class Program {
    static int fails;

    static void Eq(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine($"FAIL {what}: got {got} want {want}");
    }

    static void EqStr(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine($"FAIL {what}: got '{got}' want '{want}'");
    }

    static int RampVal(int i) {
        if (i == 0) { return 0; }
        if (i == 1) { return 100; }
        if (i == 2) { return 200; }
        return 255;
    }

    /// 渐变图的灰度字节直接写进 byte[]（值可以超过 ASCII 范围）。
    static int LoadRamp(string key, int w, int h, int v0, int v1, int v2,
                        int v3) {
        string head = "P5\n" + w + " " + h + "\n255\n";
        byte[] all = new byte[head.Length + 4];
        for (int i = 0; i < head.Length; i = i + 1) {
            all[i] = (byte)(head[i] & 255);
        }
        all[head.Length + 0] = (byte)v0;
        all[head.Length + 1] = (byte)v1;
        all[head.Length + 2] = (byte)v2;
        all[head.Length + 3] = (byte)v3;
        return Canvas.ImageLoadMem(key, all, head.Length + 4);
    }

    static int Gray(Canvas c, int x, int y) {
        return c.GetPixel(x, y) & 255;
    }

    static void Main() {
        fails = 0;
        Canvas c = new Canvas(64, 64);

        // ---- 内存注册表：合成 P5 PNM（4x2，灰度字节全为 'd'=100，
        // 保持整个缓冲区落在 ASCII 范围，跨平台逐字节确定）。
        string pnm = "P5\n4 2\n255\n" + "dddddddd";
        int w = Canvas.ImageLoadMem("mem:t.pnm", pnm, pnm.Length);
        Eq("pnm width", w, 4);
        Eq("pnm height", Canvas.ImageHeight("mem:t.pnm"), 2);
        c.BlitImage("mem:t.pnm", 0, 0, 8, 4, 0, 0, 0, 0);
        Canvas.EvictImage("mem:t.pnm");
        Eq("pnm evicted", Canvas.ImageWidth("mem:t.pnm"), 0);
        w = Canvas.ImageLoadMem("mem:t.pnm", pnm, pnm.Length);
        Eq("pnm re-registered", w, 4);

        // ---- 垃圾字节：解码失败返回 0，且不产生可查询的尺寸
        //（mem key 绝不回落到文件路径加载）。
        string junk = "not an image at all";
        Eq("garbage", Canvas.ImageLoadMem("mem:t.bad", junk, junk.Length), 0);
        Eq("garbage size", Canvas.ImageWidth("mem:t.bad"), 0);

        // ---- SVG：固有 48x24；按 32x24 盒子 contain 重光栅 → 32x16。
        string svg = "<svg xmlns=\"http://www.w3.org/2000/svg\" "
            + "width=\"48\" height=\"24\">"
            + "<rect width=\"48\" height=\"24\" fill=\"#204060\"/></svg>";
        w = Canvas.ImageLoadSvg("mem:t.svg", svg, 0, 0);
        Eq("svg intrinsic w", w, 48);
        Eq("svg intrinsic h", Canvas.ImageHeight("mem:t.svg"), 24);
        w = Canvas.ImageLoadSvg("mem:t.svg@32x24", svg, 32, 24);
        Eq("svg box w", w, 32);
        Eq("svg box h", Canvas.ImageHeight("mem:t.svg@32x24"), 16);
        Eq("bad svg", Canvas.ImageLoadSvg("mem:t.badsvg", "<svg", 0, 0), 0);

        // ---- base64 载荷：与 Image 组件解析 data URI 走同一条
        // Decode + ImageLoadMem 路径。
        string b64 = Base64.Encode(pnm, pnm.Length);
        List<int> n = new List<int>();
        n.Add(0);
        byte[] bytes = Base64.Decode(b64, n);
        Eq("b64 length", n[0], pnm.Length);
        w = Canvas.ImageLoadMem("mem:t.b64", bytes, n[0]);
        Eq("b64 width", w, 4);
        Eq("b64 height", Canvas.ImageHeight("mem:t.b64"), 2);

        // ---- 采样器边界（GetPixel 读回断言）--------------------------
        // 缩小走 box filter（覆盖到的源像素求平均），放大/1:1 按目标
        // 像素中心最近邻；裁剪与部分越界都不得越界读。
        int rw = LoadRamp("mem:t.ramp", 4, 1, 0, 100, 200, 255);
        Eq("ramp width", rw, 4);
        c.Clear(0xFFFFFFFF);
        // 1:1 逐像素恒等。
        c.BlitImage("mem:t.ramp", 0, 0, 4, 1, 0, 0, 0, 0);
        for (int i = 0; i < 4; i = i + 1) {
            Eq("identity " + i, Gray(c, i, 0), RampVal(i));
        }
        Eq("identity alpha", (c.GetPixel(0, 0) >> 24) & 255, 255);
        // 缩小 4→2：box filter 平均，四舍五入。
        c.BlitImage("mem:t.ramp", 0, 2, 2, 1, 0, 0, 0, 0);
        Eq("box 4->2 lo", Gray(c, 0, 2), 50);
        Eq("box 4->2 hi", Gray(c, 1, 2), 228);
        // 缩小 4→3：非整数比，各目标列覆盖 2 个源像素。
        c.BlitImage("mem:t.ramp", 0, 12, 3, 1, 0, 0, 0, 0);
        Eq("box 4->3 a", Gray(c, 0, 12), 50);
        Eq("box 4->3 b", Gray(c, 1, 12), 150);
        Eq("box 4->3 c", Gray(c, 2, 12), 228);
        // 放大 4→8：中心采样，两两成对且对称。
        c.BlitImage("mem:t.ramp", 0, 4, 8, 1, 0, 0, 0, 0);
        for (int i = 0; i < 8; i = i + 1) {
            Eq("up4->8 " + i, Gray(c, i, 4),
               RampVal(i / 2));
        }
        // 放大 3→4：中心采样复制中间列（旧的 floor 映射会偏左）。
        LoadRamp("mem:t.ramp3", 3, 1, 0, 128, 255, 0);
        c.BlitImage("mem:t.ramp3", 0, 6, 4, 1, 0, 0, 0, 0);
        Eq("up3->4 a", Gray(c, 0, 6), 0);
        Eq("up3->4 b", Gray(c, 1, 6), 128);
        Eq("up3->4 c", Gray(c, 2, 6), 128);
        Eq("up3->4 d", Gray(c, 3, 6), 255);
        // 源矩形裁剪（cover 的一般化）：sx=1,sw=2 放大到 4 宽。
        c.BlitImage("mem:t.ramp", 0, 9, 4, 1, 1, 0, 2, 1);
        Eq("crop up a", Gray(c, 0, 9), 100);
        Eq("crop up b", Gray(c, 1, 9), 100);
        Eq("crop up c", Gray(c, 2, 9), 200);
        Eq("crop up d", Gray(c, 3, 9), 200);
        // 目标部分越界（负 dx / 右溢出）：可见部分仍逐像素正确。
        c.BlitImage("mem:t.ramp", -2, 8, 4, 1, 0, 0, 0, 0);
        Eq("clip left", Gray(c, 0, 8), 200);
        Eq("clip left2", Gray(c, 1, 8), 255);
        c.BlitImage("mem:t.ramp", 62, 10, 4, 1, 0, 0, 0, 0);
        Eq("clip right", Gray(c, 62, 10), 0);
        Eq("clip right2", Gray(c, 63, 10), 100);
        // 垂直方向同上：1x4 渐变，dy=-2 起可见的是源第 2/3 行。
        LoadRamp("mem:t.vamp", 1, 4, 0, 100, 200, 255);
        c.BlitImage("mem:t.vamp", 20, -2, 1, 4, 0, 0, 0, 0);
        Eq("clip top", Gray(c, 20, 0), 200);
        Eq("clip top2", Gray(c, 20, 1), 255);
        Eq("oob", c.GetPixel(999, 999), -1);

        // ---- 组件模型（对齐 prop_test 的往返方式）。
        Image img = new Image("https://example.com/a.png", "pic", "cover");
        EqStr("kind", img.Kind(), "Image");
        Eq("props count", img.Props().Count, 4);
        EqStr("fit", img.GetExtra("fit"), "cover");
        img.SetExtra("fit", "fill");
        EqStr("fit after set", img.GetExtra("fit"), "fill");
        img.SetProp("src", "x.png");
        EqStr("prop src", img.GetProp("src"), "x.png");
        img.SetProp("alt", "hello");
        EqStr("prop alt", img.GetProp("alt"), "hello");
        bool hasLoaded = false;
        bool hasError = false;
        List<string> evs = img.Events();
        for (int i = 0; i < evs.Count; i = i + 1) {
            if (evs[i] == "Loaded") { hasLoaded = true; }
            if (evs[i] == "Error") { hasError = true; }
        }
        if (!hasLoaded) {
            fails = fails + 1;
            Console.WriteLine("FAIL events: no Loaded");
        }
        if (!hasError) {
            fails = fails + 1;
            Console.WriteLine("FAIL events: no Error");
        }
        Control made = ControlFactory.Create("Image");
        if (made == null) {
            fails = fails + 1;
            Console.WriteLine("FAIL factory: null");
        } else {
            EqStr("factory kind", made.Kind(), "Image");
        }

        if (fails == 0) {
            Console.WriteLine("image_test OK");
        } else {
            Console.WriteLine($"image_test FAILURES {fails}");
        }
        c.Destroy();
    }
}
