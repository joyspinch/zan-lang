using System;
using System.IO;
using System.Threading;
using Gui;
using Gui.Widget;
using Gui.Component;
using Game.Scene;

// Real DocumentPages, DocumentLoad, Recent, workers, staging and document models
// are linked by the dedicated test. Only unrelated shell services are fixtures.
partial class ZanIDE {
    public App app;
    public Control shellRoot = new Panel();
    public StartPage startPage = new StartPage();
    public DiffView diffView = new DiffView();
    public CodeEditor editor = new CodeEditor();
    public DocBaseline docs = DocBaseline.Create();
    public List<TabRecord> tabs = new List<TabRecord>();
    public SignalInt activeTab = new SignalInt(0);
    public List<string> log = new List<string>();
    public List<TreeNode> tree = new List<TreeNode>();
    public SignalInt treeSel = new SignalInt(-1);
    public int lastActive = -1;
    public bool closeRequested;
    public bool haveProject;
    public bool rescan;
    public string root = "";
    public int pendingGotoLine = -1;
    public int pendingGotoCol;
    public int projectSourceRequests;
    public static string configRoot = "";

    public ZanIDE(App host) {
        app = host;
        startPage.owner = this; diffView.owner = this;
        shellRoot.Add(startPage); shellRoot.Add(diffView);
    }

    public static string T(string en, string zh) { return en; }
    public static bool IsHtmlPath(string path) { return path.EndsWith(".html"); }
    public static bool IsHtmlDesignBody(string text) { return text.Contains("data-zan-design"); }
    public static bool IsFormPath(string path) { return false; }
    public static bool IsScenePath(string path) { return false; }
    public static bool SamePath(string left, string right) { return left == right; }
    public static int FindTabByPath(List<TabRecord> records, string path) {
        for (int i = 0; i < records.Count; i = i + 1) { if (records[i].path == path) { return i; } }
        return -1;
    }
    public bool CodeNavigationBusy() { return false; }
    public void CancelCodeNavigationThen(Action next) { next(); }
    public void RunRibbonCommand(App host, int key) { }
    public void OpenProjectAsync(string path) { }
    public void RequestFirstDocumentAsync() { }
    public void RequestProjectSourcesAsync() { projectSourceRequests = projectSourceRequests + 1; }
    public void RefreshFoldRanges() { }
    public void TrackPreparedDocument(string path, string text, long stamp) { docs.Note(path, text, stamp); }
    public void AdoptSymbolIndex() { this.CancelDocumentReads(); }
    public void AdoptProjectChats() { }
    public static string FindProjectRoot(string path) { return ""; }
    public static string DirOf(string path) { return Path.GetDirectoryName(path); }
    public static List<string> ExpandedPaths(List<TreeNode> nodes) { return new List<string>(); }
    public static List<TreeNode> ScanTree(string path) { return new List<TreeNode>(); }
    public static void ApplyExpanded(List<TreeNode> nodes, List<string> paths) { }

    public static string UserConfigDir() { return configRoot; }
    public static string NormSlashes(string text) { return text.Replace("\\", "/"); }
    public static List<string> Lines(string text) { return text.Split("\n"); }
    public static void WriteLastProject(string path) {
        Directory.CreateDirectoryRecursive(ZanIDE.UserConfigDir());
        File.WriteAllText(ZanIDE.UserConfigDir() + "/last_project.txt", path);
        ZanIDE.AddRecentProject(path);
    }
    public static void WriteDockLayout(string layout) { }
    public static void SaveSettings(int treeWidth, int bottomHeight, int width, int height,
    int autoRun, string skin, int rightWidth, int opacity, string wallpaper,
    int wallpaperOpacity, int partialFrames, int renderBackend) { }
}
