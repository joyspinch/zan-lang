using Gui;
using Gui.Component;
using Gui.Component.CefBrowser;

// First browser attachment happens during input preparation, before the turn's
// participant count snapshot. This is not a paint-driven registration fixture.
class BrowserInputRegistration : AppLoopParticipant, AppPreparationParticipant {
    public weak CefBrowser Browser;
    public BrowserWorkCounter Counter;
    public int Registrations;

    public int NextDeadline() { return -1; }
    public void Tick(App app, int now) { }
    public void BeforePaint(App app, int frameSequence) { }
    public void BeforeInput(App app, int kind) {
        if (Registrations != 0) { return; }
        CefBrowser browser = Browser;
        if (browser == null) { return; }
        BrowserNativeEntry entry = browser.AttachNative(app, null);
        if (entry == null) { return; }
        entry.SetBounds(0, 0, 32, 32);
        BrowserNativeLoop loop = BrowserNativeLoop.For(app);
        loop.WorkBackend = Counter.Work;
        Registrations = Registrations + 1;
    }
}
