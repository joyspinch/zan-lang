using Gui;
using Gui.Component;

// The production host's pre-input geometry call; registration is deliberately
// separate so first input and resume can assert that no participant is added.
class SessionListHostPreparation : AppLoopParticipant, AppPreparationParticipant {
    public weak SessionList List;
    public bool Enabled;
    public bool Client;
    public int X;
    public int Y;
    public int Width;
    public int Height;
    public int Top;
    public int Calls;

    public int NextDeadline() { return -1; }
    public void Tick(App app, int now) { }
    public void BeforePaint(App app, int frameSequence) { }
    public void BeforeInput(App app, int kind) {
        SessionList list = List;
        if (!Enabled || list == null || list.HostApp() != app) { return; }
        Calls = Calls + 1;
        if (Client) { list.PrepareHostClient(app, Top); }
        else { list.PrepareHost(app, X, Y, Width, Height); }
    }
}
