using System;
using System.IO;
using Gui;
using Gui.Widget;
using Gui.Component;

// Only shell state and persistence/AI effects are supplied here. The linked
// production session consumer, child lifecycle and sidebar layout stay unchanged.
partial class ZanIDE : AppLoopOwner {
    static ZanIDE current;
    App app;
    DockHost dock;
    AiPanel aiPanel;
    SessionList aiSessNav;
    AiAssistantWindow aiWin;
    bool aiWinPending;
    bool shuttingDown;
    bool closeRequested;
    List<AiSession> aiSessions = new List<AiSession>();
    List<string> aiSessionImages = new List<string>();
    int aiSessCur;
    string aiSaveSig;
    bool aiSessionPending;
    bool aiSessionDrafts;
    SignalInt aiBusy = new SignalInt(0);
    List<ChatMessage> aiMsgs = new List<ChatMessage>();
    List<string> aiPlan = new List<string>();
    List<string> aiTasks = new List<string>();
    string root;
    string aiModelSelSig;
    string aiPendingCall;
    string aiGraphSel;
    string aiSendTo;
    IdeAiHostState aiTeamSt = new IdeAiHostState();
    SignalInt aiTeamOpen = new SignalInt(0);
    bool aiTeamMode;
    bool aiAutoExec;
    int aiProfActive;
    int ctxKind;
    int ctxX;
    int ctxY;
    string ctxTaskId;
    ContextMenu ctxMenu;
    App ctxMenuApp;
    ContextMenu CreateContextMenu(App host, int kind, List<string> labels) {
        return new ContextMenu();
    }
    void CloseIdeContextMenu() {
        if (ctxMenu != null && ctxMenuApp != null) { ctxMenuApp.overlayHost.Hide(ctxMenu); }
        ctxMenu = null; ctxMenuApp = null; ctxKind = 0;
    }
    public int Saves;
    AppLoopRegistration prepare;

    public ZanIDE(App host) {
        app = host; current = this;
        dock = new DockHost();
        dock.RegisterFixed("editor", "Editor");
        dock.Register("agent", "Agent", DockSide.Right(), true, false);
        dock.SetSideExtent(DockSide.Right(), 600);
        dock.Show("agent");
        app.UseAppCss(File.ReadAllText("src/ide_zan/assets/ide.css"));
        aiPanel = new AiPanel(app);
        aiSessNav = new SessionList("Search", "New chat");
        aiSessNav.Action.Add(ZanIDE.AiSessionNavigationChanged);
        for (int i = 0; i < 3; i = i + 1) {
            AiSession session = AiSession.Create("", 0);
            session.title = "Chat " + Convert.ToString(i);
            aiSessions.Add(session); aiSessionImages.Add("");
        }
        // Production startup registers SessionList before input preparation.
        aiSessNav.InitializeHost(host);
        prepare = host.RegisterLoopParticipant(this, new IdeAiDockPreparation(this));
    }
    public void PrepareDock() {
        if (dock.parent == null && app.rootControl != null) { app.rootControl.Add(dock); }
        dock.PrepareHost(app, new Rect(0, app.ContentTop(), app.ClientWidth(), app.ClientHeight() - app.ContentTop()));
        this.PrepareAiSessionsView(app);
    }
    public SessionList List() { return aiSessNav; }
    public App Host() { return app; }
    public DockHost Dock() { return dock; }
    public void ToggleDock() { this.ToggleAgent(); }
    public AiAssistantWindow Child(App childApp) {
        AiAssistantWindow.ToggleFromRibbon();
        childApp.UseAppCss(app.AppCss());
        AiAssistantWindow window = new AiAssistantWindow();
        window.host = childApp; window.open = true; window.parentApp = app;
        aiWin = window; aiWinPending = false;
        window.InitializeSessionsHost(childApp);
        return window;
    }
    public void Shutdown() { closeRequested = true; this.RetireAiSessionsView(); }
    public void Dispose() {
        this.RetireAiSessionsView(); prepare.Invalidate();
        if (aiWin != null) { aiWin.Close(); aiWin = null; }
        current = null;
    }
    static string T(string en, string zh) { return en; }
    static string AiSessTitleOf(AiSession session) { return session.derived; }
    void SaveAiSessions() { Saves = Saves + 1; }
    void RememberAiSessionCurrent() { }
    void AiSessionChanged() { }
    void UseAiSessionCurrent(int index) { aiSessCur = index; }
    void AiResetContextState() { }
    void AiChatReset() { }
    void PrepareAiPanel(App host, Rect area) { }
    void RenderAiPanel(App host, Rect area) { this.AiRenderSessions(host, area); }
    void AiGraphMenuLabels(List<string> labels) { }
    void AiGraphMenu(string id, int choice) { }
}
