using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Designer;
using Game.Scene;

// Only shell state/unrelated callbacks are fixtures. EditorFormat, Form,
// SceneDesigner and the retained preparation/input chain are production code.
class TabRecord {
    public string name;
    public string path;
    public bool designDoc;
}

partial class ZanIDE : UiViewOwner {
    public App app;
    public DockHost dock = new DockHost();
    public Tabs editorTabs;
    public ControlInputHost editorTabsInput;
    public UiViewScope editorTabsView;
    public List<TabRecord> tabs = new List<TabRecord>();
    public Binding<int> activeTab = 0;
    public Designer formDesigner = new Designer();
    public SceneDesigner sceneDesigner = new SceneDesigner();
    public bool shuttingDown;
    public bool closeRequested;
    public string codeViewForm = "";
    public Control dlg;
    public ExplorerPanel explorerPanel;
    public ToolsPanel toolsPanel;
    public StdlibPanel stdlibPanel;
    public List<TreeNode> exTree = new List<TreeNode>();
    public List<TreeNode> tree = new List<TreeNode>();
    public List<TreeNode> rtToolTree = new List<TreeNode>();
    public Input treeFilter = new Input("Explorer");
    public Input rtToolFilter = new Input("Tools");
    // 页签条事件回调用到的外壳状态桩（真实实现分布在其余 partial 里）。
    public int ctxKind;
    public int dlgMode;

    public int added;
    public Control OpenWizardHost(App host, string title, int w, int h, int mode) {
        added = added + 1;
        return null;
    }
    public int closed = 0 - 1;
    public List<int> closeEvents = new List<int>();
    public bool closeReentry;
    public bool rebuildOnClose;
    public void RequestCloseTab(int i) {
        closed = i;
        closeEvents.Add(i);
        if (closeReentry) {
            closeReentry = false;
            editorTabs.CloseTab(0);
        }
        if (rebuildOnClose) {
            rebuildOnClose = false;
            tabs[i].name = "Rebuilt";
            this.SyncEditorTabs();
        }
    }
    public void OnDesignTabChanged(Control sender) { }
    public void OnLspStatusClicked(Control sender) { }

    public ZanIDE(App host) {
        app = host;
        TabRecord record = new TabRecord(); record.name = "Start"; record.path = "@start";
        tabs.Add(record);
        dock.RegisterFixed("editor", "Editor");
        DockPanel panel = dock.Find("editor");
        if (panel != null) { panel.body = new Rect(0, 30, 600, 400); }
    }
    public void InitializeTreePanels() {
        dock.Register("explorer", "Explorer", DockSide.Left(), true, true);
        dock.Register("tools", "Tools", DockSide.Right(), true, true);
        DockPanel left = dock.Find("explorer");
        DockPanel right = dock.Find("tools");
        if (left != null) { left.body = new Rect(0, 40, 190, 220); }
        if (right != null) { right.body = new Rect(610, 40, 190, 220); }
        for (int i = 0; i < 40; i = i + 1) {
            tree.Add(TreeNode.File("file" + Convert.ToString(i), 0));
            rtToolTree.Add(TreeNode.File("tool" + Convert.ToString(i), 0));
        }
        explorerPanel = new ExplorerPanel();
        Binding<int> explorerSel = 0 - 1;
        explorerPanel.Wire(explorerSel, treeFilter);
        explorerPanel.InitializeHost(app, this);
        toolsPanel = new ToolsPanel();
        Binding<int> toolsSel = 0 - 1;
        toolsPanel.Wire(toolsSel, rtToolFilter);
        toolsPanel.InitializeHost(app, this);
    }
    public static string T(string english, string chinese) { return english; }
    public static string BaseDir() { return ""; }
    public static void ExplorerPicked() { }
    public static void ExplorerContext() { }
    public static void ToolActivated() { }
    public static void ToolContext() { }
    public static void ExamplePicked() { }
    public static void StdlibContext() { }
    public static List<TreeNode> FilterNodes(List<TreeNode> nodes, string query) {
        if (query == "") { return nodes; }
        List<TreeNode> shown = new List<TreeNode>();
        for (int i = 0; i < nodes.Count; i = i + 1) {
            if (nodes[i].label.ToLower().Contains(query.ToLower())) { shown.Add(nodes[i]); }
        }
        return shown;
    }
    public void SetScene(bool active) {
        tabs[0].path = active ? "probe.scene" : "@start";
    }
    public void Close() {
        this.RetireEditorTabsView(); sceneDesigner.SetVisible(false);
        if (explorerPanel != null) { explorerPanel.RetireHost(); }
        if (toolsPanel != null) { toolsPanel.RetireHost(); }
    }
    public void PrepareAiSessionsView(App host) { }
    public void PrepareRibbonView(App host) { }
    public void RetireRibbonView() { }
    public bool FormDesignReady() { return false; }
    public bool SceneDesignReady() { return true; }
    public bool DesignTabsApplicable() { return false; }
    public static bool IsFormPath(string path) { return false; }
    public static bool IsScenePath(string path) { return path.EndsWith(".scene"); }
    public static string ToolchainDir() { return ""; }
    public static string ExeSuffix() { return ".exe"; }
    public static string ExeDir() { return ""; }
    public static string WindowCacheDir() { return ""; }
    public static void EnsureCacheDir() { }
}
