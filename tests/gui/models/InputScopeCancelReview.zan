using System;
using Gui;
using Gui.Widget;

class InputScopeCancelReview : InputRetirementObserver {
    public weak App App;
    public weak LayerState Layer;
    public weak Control Footer;
    public bool RenderSame;
    public bool RestoreDialogFooter;
    public Exception Failure;
    public InputRetirementToken Late;
    public int Cancels;
    public int FooterCancels;
    public int LateCalls;
    public void Cancel(Control sender, RoutedEventArgs e) {
        if (e.eventName != "PointerCancel") { return; }
        Cancels = Cancels + 1;
        App app = App; LayerState layer = Layer;
        if (app == null || layer == null) { return; }
        if (RestoreDialogFooter) {
            RestoreDialogFooter = false;
            layer.altText = "Cancel renewed"; layer.twoButtons = true; layer.Open(app); layer.openMs = 0;
            Gui.Widget.Layer.RegisterOpen(app, layer);
            Late = app.WatchInputRetirement(layer.cancelBtn, this);
            layer.cancelBtn.Focus(app); app.CapturePointer(layer.cancelBtn);
        }
        if (Failure != null) {
            Late = app.WatchInputRetirement(layer.dialogFooter, this);
            throw Failure;
        }
        if (RenderSame) {
            Gui.Widget.Layer.RegisterOpen(app, layer);
            layer.promptInput.Focus(app); app.CapturePointer(Footer);
        }
    }
    public void FooterCancel(Control sender, RoutedEventArgs e) {
        if (e.eventName == "PointerCancel") { FooterCancels = FooterCancels + 1; }
    }
    public void OnInputRetired(InputRetirementToken token) { LateCalls = LateCalls + 1; }
}
