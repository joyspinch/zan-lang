using Gui;
using Gui.Widget;
using Game.Foundation.Gui;
using Match3;

// One synchronous callback probe, shared by root replacement and Stop reentry.
public class Match3PreparationProbe : Panel {
    public weak GuiHost host;
    public weak Match3Hud hud;
    public Control replacement;
    public int mode;
    public Match3PreparationProbe() : base("preparation-probe") { }
    public override void OnMeasure(App app) {
        int action = mode;
        mode = 0;
        GuiHost currentHost = host;
        Match3Hud currentHud = hud;
        if (action == 2 && currentHud != null) {
            currentHud.StopPreparation();
            currentHud.StopPreparation();
        }
        if (action != 0 && currentHost != null) { currentHost.SetContentRoot(replacement); }
        base.OnMeasure(app);
    }
}
