using Gui;
using System.Collections.Generic;

// Test fixture for the common base lifecycle; business callbacks remain synchronous.
class AdapterLifecycleProbe : InputRootAdapter {
    public weak Control Borrowed;
    public bool RetireBorrowed = true;
    public bool FallbackInput = true;
    public int Priority;

    public AdapterLifecycleProbe(Control root) : base("adapter_lifecycle_probe") { Borrowed = root; }
    public override int InputPriority() { return Priority; }
    public Control Fallback() { return content; }
    public App BoundApp() { return inputApp; }
    public override void Bind(App app) {
        Control root = Borrowed;
        if (root != null) { root.InheritApp(app); }
        base.Bind(app);
    }
    public override Control HitTest(int x, int y, int pointerType) {
        Control root = Borrowed;
        Control hit = root != null ? root.HitTest(x, y, pointerType) : null;
        return hit != null ? hit : (FallbackInput && content != null ? content.HitTest(x, y, pointerType) : null);
    }
    public override bool ContainsInputControl(Control control) {
        Control root = Borrowed;
        return control == this || (root != null && root.ContainsInputControl(control))
            || (FallbackInput && content != null && content.ContainsInputControl(control));
    }
    public override Control FindInputFocus(App app) {
        Control root = Borrowed;
        Control focused = root != null ? root.FindInputFocus(app) : null;
        return focused != null ? focused : (FallbackInput && content != null ? content.FindInputFocus(app) : null);
    }
    public override void CollectInputFocus(App app, List<Control> controls) {
        Control root = Borrowed;
        if (root != null) { root.CollectInputFocus(app, controls); }
        if (FallbackInput) { base.CollectInputFocus(app, controls); }
    }
    protected override void OnReleaseInput(App app) {
        Control root = Borrowed;
        if (RetireBorrowed && root != null) { app.ReleaseInputSubtree(root); }
    }
}
