using System;
using System.Globalization;
using Gui;
using Gui.Widget;
using Gui.Component;

// Link this fixture with the production Ribbon, RibbonView and view owner files.
// Only the IDE's business/outer-shell boundary is substituted. Model creation,
// preparation, input ownership, dispatch, DockHost and UiCommand stay production.
partial class ZanIDE : UiCommandOwner {
    App app;
    DockHost dock = new DockHost();
    Binding<int> ribbonTab;
    List<string> ribbonTabs;
    static string uiLang = "en";
    bool shuttingDown;
    bool closeRequested;
    bool compactHeader;
    int ctxKind;
    List<UiCommand> commands = new List<UiCommand>();
    bool commandEnabled = true;
    bool projectAvailable = true;
    bool commandChecked;
    public int Executed;
    public int Seen = -1;
    public int Mutations;
    public int CommandStateReads;

    public ZanIDE(App host, int tab) {
        app = host; ribbonTab = tab;
        for (int key = 0; key <= 20; key = key + 1) {
            commands.Add(new UiCommand(this, key, ""));
        }
        dock.RegisterFixed("editor", "Editor");
        for (int i = 0; i < 14; i = i + 1) {
            string id = "panel" + Convert.ToString(i);
            dock.Register(id, "Panel " + Convert.ToString(i), 1, true, false);
            dock.SetIcon(id, "grid");
            dock.SetTip(id, "Panel help " + Convert.ToString(i));
        }
        dock.SetSwitchHints("Hide panel", "Show panel");
        // Startup creates the view subscription; the first input turn prepares
        // its still-empty tree through UiViewOwner without any Paint beforehand.
        this.InitializeRibbonView();
    }

    UiCommand Command(int key) { return commands[key]; }
    public bool CanExecuteCommand(int key) {
        CommandStateReads = CommandStateReads + 1;
        // Match the production project's command gate for the empty Start page.
        if (key == 8 || key == 11 || key == 12 || key == 15) {
            return commandEnabled && !closeRequested && projectAvailable;
        }
        return commandEnabled && !closeRequested;
    }
    public bool IsCommandChecked(int key) { return commandChecked; }
    public void ExecuteCommand(int key) {
        Executed = Executed + 1; Seen = key;
        if (key == 20) { compactHeader = true; }
    }

    public App Host() { return app; }
    public DockHost Dock() { return dock; }
    public Ribbon Tree() { return ribbonControl; }
    public UiViewScope View() { return ribbonView; }
    public IdeRibbonViewOwner ViewOwner() { return ribbonViewOwner; }
    public ControlInputHost InputHost() { return ribbonInput; }
    public bool Ready() { return this.RibbonViewReady(app); }
    public UiCommand SharedCommand(int key) { return this.Command(key); }
    public List<RibbonGroup> CommandGroups(int tab) { return this.CommandRibbonGroups(tab); }
    public void SetCommandState(bool enabled, bool on) { commandEnabled = enabled; commandChecked = on; }
    public void SetProjectAvailable(bool value) { projectAvailable = value; }
    public void SetCompact(bool value) { compactHeader = value; }
    public void SetTab(int value) { ribbonTab.Set(value); }
    public void SetLanguage(string value) { ZanIDE.uiLang = value; Lang.Set(value); }
    public void Overflow() { this.OpenRibbonOverflow(); }
    public void Retire() { this.RetireRibbonView(); }
    public void Paint() {
        if (this.RibbonViewReady(app)) { ribbonControl.RenderTree(app); }
    }

    // Referenced by the linked Ribbon file's preference reader, never exercised
    // here: this regression must not load editor preferences or other IDE files.
    static string EditorPrefsPath() { return ""; }
    static string CfgStr(string source, string key, string fallback) { return fallback; }
}
