using System;
using Gui;

class InputScopeRetirementProbe : InputRetirementObserver {
    public weak App App;
    public weak Control Scope;
    public weak Control Leaf;
    public weak InputRootAdapter Adapter;
    public InputRetirementToken Token;
    public InputRetirementToken Replacement;
    public Exception Failure;
    public int Calls;
    public bool SawConsumed;
    public bool Renew;
    public bool Reclaim;
    public bool Reobserve;

    public void OnInputRetired(InputRetirementToken token) {
        Calls = Calls + 1;
        SawConsumed = !token.IsActive();
        if (Failure != null) { throw Failure; }
        App app = App;
        Control scope = Scope;
        Control leaf = Leaf;
        if (app == null || scope == null) { return; }
        if (Reclaim) {
            InputRootAdapter adapter = Adapter;
            if (adapter != null) { adapter.Bind(app); }
        }
        if (Renew || Reclaim || Reobserve) { Replacement = app.WatchInputRetirement(scope, this); }
        if ((Renew || Reclaim) && leaf != null) {
            leaf.Focus(app);
            app.CapturePointer(leaf);
        }
    }
}
