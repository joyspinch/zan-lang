using Gui;

// Counts the injected process pump, never calls a CEF driver.
class BrowserWorkCounter {
    public int Calls;
    public weak App NestedApp;
    public weak App StopApp;

    public void Work() {
        Calls = Calls + 1;
        App nested = NestedApp;
        NestedApp = null;
        if (nested != null) { nested.ProcessOffscreenInput(0, 0, 0, 0, 0, 0, 0); }
        App closing = StopApp;
        StopApp = null;
        if (closing != null) { closing.StopLoop(); }
    }
}
