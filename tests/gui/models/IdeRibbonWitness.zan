using Gui;
using Gui.Widget;

class IdeRibbonWitness {
    public weak ZanIDE Ide;
    public weak App App;
    public weak Ribbon Ribbon;
    public weak ControlInputHost Host;
    public weak UiViewScope View;
    public weak IdeRibbonViewOwner Owner;
    public weak Control Button;
    public weak Control Popup;
    // Keep production delegate endpoints alive after all their owners leave.
    public UiEvent CommandEndpoint;
    public UiEvent ButtonEndpoint;
    public UiEvent PopupEndpoint;
}
