using Gui;
using System;

class AdapterLifecycleHooks {
    public weak AdapterLifecycleProbe Probe;
    public weak AdapterLifecycleProbe Owner;
    public weak App Target;
    public weak Control Root;
    public weak Control Button;
    public bool RenewOwner;
    public int Cancels;

    public void RoutedCancel(Control sender, RoutedEventArgs e) {
        if (e.eventName == "PointerCancel") { this.Cancel(); }
    }

    public void RoutedThrowCancel(Control sender, RoutedEventArgs e) {
        if (e.eventName == "PointerCancel") { this.ThrowCancel(); }
    }

    public void ThrowCancel() {
        Cancels = Cancels + 1;
        throw new Exception("adapter cancellation sentinel");
    }

    public void Cancel() {
        Cancels = Cancels + 1;
        if (Cancels != 1) { return; }
        AdapterLifecycleProbe probe = Probe;
        AdapterLifecycleProbe owner = Owner;
        App app = Target;
        Control root = Root;
        Control button = Button;
        if (probe == null || app == null || root == null || button == null) { return; }
        if (RenewOwner) {
            if (owner == null) { return; }
            owner.Detach(); owner.Bind(app);
        } else { probe.Bind(app); }
        root.MeasureTree(app); root.Arrange(10, 10, 280, 120);
        app.ProcessOffscreenInput(2, button.bx + button.bw / 2, button.by + button.bh / 2, 0, 0, 0, 0);
        app.focus.SetFocused(button.WidgetId(), button);
    }
}
