using System;
using System.IO;
using Gui;
using Gui.Widget;

// Load the actual AI panel document and IDE CSS; unrelated custom AI widgets
// remain inert document elements. LayoutSidebarForSessions is linked production.
partial class AiPanel : Column {
    public Control Sidebar;
    public Control SideRule;
    public AiPanel(App app) {
        Control document = Html.Load(app,
        File.ReadAllText("src/ide_zan/src/panels/AiPanel.html"), null, "");
        this.With(document); document.Grow();
        Sidebar = document.Find("Sidebar"); SideRule = document.Find("SideRule");
        if (Sidebar == null || SideRule == null) { throw new Exception("actual AI document sidebar missing"); }
    }
    Rect SidebarRect() { return new Rect(Sidebar.bx, Sidebar.by, Sidebar.bw, Sidebar.bh); }
}
