using Gui;
using Gui.Widget;

class RibbonComponentHooks {
    public weak Ribbon Ribbon;
    public weak App App;
    public Control Target;
    public int Count;
    public int Mutations;
    public int Seen;
    public bool Rebuild;
    public bool Reenter;
    public int Cancels;
    public void RoutedCancel(Control sender, RoutedEventArgs e) {
        if (e.eventName == "PointerCancel") { this.Cancel(); }
    }
    public void Command() {
        Count = Count + 1;
        Ribbon ribbon = Ribbon;
        if (ribbon != null) {
            Seen = ribbon.lastAct;
            if (Rebuild) { ribbon.BuildTree(); }
        }
    }
    public void Cancel() {
        Cancels = Cancels + 1;
        if (!Reenter) { return; }
        Reenter = false;
        Ribbon ribbon = Ribbon;
        if (ribbon != null) { ribbon.BuildTree(); }
    }
}
