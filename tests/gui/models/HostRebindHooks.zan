using Gui;

class HostRebindHooks {
    public weak ControlInputHost Host;
    public weak App OldApp;
    public weak App NewApp;
    public weak Control Root;
    public weak Control Button;
    public int Cancels;

    public void RoutedCancel(Control sender, RoutedEventArgs e) {
        if (e.eventName == "PointerCancel") { this.Cancel(); }
    }

    public void Cancel() {
        Cancels = Cancels + 1;
        App oldApp = OldApp;
        App nextApp = NewApp;
        ControlInputHost host = Host;
        Control root = Root;
        Control button = Button;
        if (oldApp == null || nextApp == null || host == null || root == null || button == null) { return; }
        if (Cancels == 1) {
            // A new resource is allowed during cancellation without rebinding the host.
            oldApp.CapturePointer(button);
        } else if (Cancels == 2) {
            // The second cancellation synchronously creates a newer host session.
            host.Bind(nextApp);
            root.MeasureTree(nextApp);
            root.Arrange(10, 10, 280, 120);
            int x = button.bx + button.bw / 2;
            int y = button.by + button.bh / 2;
            nextApp.ProcessOffscreenInput(2, x, y, 0, 0, 0, 0);
            nextApp.focus.SetFocused(button.WidgetId(), button);
        }
    }
}
