using System;
using Gui;
using Gui.Widget;

class InputScopeReviewProbe : InputRetirementObserver {
    public weak App App;
    public weak LayerState Layer;
    public weak Control Scope;
    public weak InputRootAdapter Adapter;
    public InputRetirementToken Sibling;
    public InputRetirementToken Replacement;
    public Input NewLeaf;
    public Exception Failure;
    public int Calls;
    public bool Reopen;
    public bool ReplaceFooter;
    public bool RestoreDialogFooter;
    public bool Reclaim;

    public void OnInputRetired(InputRetirementToken token) {
        Calls = Calls + 1;
        if (Failure != null) { throw Failure; }
        if (Sibling != null) { Sibling.Invalidate(); }
        App app = App;
        if (app == null) { return; }
        InputRootAdapter adapter = Adapter;
        if (Reclaim && adapter != null) { adapter.Bind(app); }
        LayerState layer = Layer;
        if (layer == null || (!Reopen && !ReplaceFooter && !RestoreDialogFooter)) { return; }
        if (RestoreDialogFooter) {
            RestoreDialogFooter = false;
            layer.altText = "Renewed"; layer.twoButtons = true; layer.Open(app);
            layer.openMs = 0;
            Gui.Widget.Layer.RegisterOpen(app, layer);
            Replacement = app.WatchInputRetirement(layer.cancelBtn, this);
            layer.cancelBtn.Focus(app); app.CapturePointer(layer.cancelBtn);
            return;
        }
        Control scope = Scope;
        if (ReplaceFooter) {
            Flex footerRoot = new Flex(); NewLeaf = new Input(""); footerRoot.Add(NewLeaf);
            layer.windowFooter = footerRoot; scope = footerRoot;
        }
        if (Reopen) { layer.Open(app); }
        layer.openMs = 0;
        Gui.Widget.Layer.RegisterOpen(app, layer);
        if (scope != null) { Replacement = app.WatchInputRetirement(scope, this); }
        Control leaf = ReplaceFooter ? NewLeaf : Scope;
        if (leaf != null) { leaf.Focus(app); app.CapturePointer(leaf); }
    }
}
