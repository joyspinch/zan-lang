using System.Collections.Generic;
using Gui;
using Gui.Widget;

public class GalleryRetainedFixture {
    public weak GalleryRetainedInput owner;
    public bool ribbonShown = true;
    public bool designerShown;
    public bool searchShown;
    public int selectedSeen = -1;
    public int commands;
    public string label = "Home";
    public Rect bounds = new Rect(20, 20, 760, 180);
    public Rect clip = new Rect(20, 20, 760, 180);
    public weak GalleryDemoView demo;
    public weak App app;
    public int paints;
    public int picks;
    public bool retireDuringPaint;

    public void Prepare(App app) {
        GalleryRetainedInput current = owner;
        if (current == null) { return; }
        current.BeginDemos();
        GalleryDemoView navigation = current.Demo("navigation-search");
        if (searchShown && navigation != null) {
            navigation.Layout(new Rect(14, 80, 244, 30), new Rect(0, 32, 272, 568));
        }
        if (demo != null) {
            demo.Layout(new Rect(20, 400, 300, 100), new Rect(20, 400, 300, 100));
        }
        current.EndDemos();
        GalleryRibbonView view = current.RibbonView();
        if (ribbonShown) {
            RibbonGroup group = new RibbonGroup("Commands");
            RibbonItem command = RibbonItem.Large("save", label); command.act = 41; group.Add(command);
            view.Configure(new List<string>{ label, "Insert", "View" }, new List<RibbonGroup>{ group });
            view.Layout(bounds.x, bounds.y, bounds.width, bounds.height, clip);
        } else { view.Hide(); }
        if (designerShown) { current.PrepareDesigner(app, new Rect(10, 220, 1100, 460)); }
        else { current.HideDesigner(); }
    }

    public void Paint() {
        paints = paints + 1;
        demo.Render(app);
        if (retireDuringPaint) { owner.Retire(); }
    }

    public void Command() { commands = commands + 1; }
    public void DemoCommand() { commands = commands + 1; }
    public void Pick() { picks = picks + 1; }
}
