using Gui;

// Supply Form's outer preparation boundary, not an imitation of AI host logic.
class IdeAiDockPreparation : AppLoopParticipant, AppPreparationParticipant {
    private weak ZanIDE owner;
    public IdeAiDockPreparation(ZanIDE owner) { this.owner = owner; }
    public int NextDeadline() { return -1; }
    public void Tick(App app, int now) { }
    public void BeforePaint(App app, int frameSequence) { this.Prepare(); }
    public void BeforeInput(App app, int kind) { this.Prepare(); }
    private void Prepare() { ZanIDE ide = owner; if (ide != null) { ide.PrepareDock(); } }
}
