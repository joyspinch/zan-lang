using System;
using Gui;
using Gui.Widget;
using Gui.Designer;

class DesignerPropResetTest {
    static int fails;

    static void Fail(string msg) {
        Console.WriteLine("FAIL: " + msg);
        fails = fails + 1;
    }

    static void AssertTrue(bool cond, string desc) {
        if (!cond) { Fail(desc); }
    }

    static void AssertEq(string actual, string expected, string desc) {
        if (actual != expected) {
            Fail(desc + " expected '" + expected + "', got '" + actual + "'");
        }
    }

    static PropSpec Find(List<PropSpec> ps, string key) {
        for (int i = 0; i < ps.Count; i = i + 1) {
            if (ps[i].key == key) { return ps[i]; }
        }
        return null;
    }

    static int IndexOf(List<PropSpec> ps, string key) {
        for (int i = 0; i < ps.Count; i = i + 1) {
            if (ps[i].key == key) { return i; }
        }
        return 0 - 1;
    }

    // 默认值挂载：文本/布尔属性有默认值，枚举属性没有。
    static void TestDefaultsAttached() {
        Designer d = new Designer();
        d.layoutMode = 0;
        FormField f = FormField.New(0, 1); // Input
        List<PropSpec> ps = d.AllFieldSpecs(f);

        PropSpec lbl = Find(ps, "label");
        AssertTrue(lbl != null, "label spec exists");
        AssertTrue(lbl.HasDefault(), "label has a default");
        AssertEq(lbl.DefaultValue(), FormField.DefaultLabel(0), "label default is the type default");

        PropSpec ph = Find(ps, "placeholder");
        AssertTrue(ph != null, "placeholder spec exists");
        AssertEq(ph.DefaultValue(), FormField.DefaultPlaceholder(0), "placeholder default is the type default");

        PropSpec vis = Find(ps, "visible");
        AssertTrue(vis != null, "visible spec exists");
        AssertEq(vis.DefaultValue(), "true", "visible default is true");

        PropSpec dis = Find(ps, "disabled");
        AssertTrue(dis != null, "disabled spec exists");
        if (dis != null) {
            AssertEq(dis.DefaultValue(), "false", "disabled default is false");
        }

        // 枚举属性表示不一致（序号/选项文本/类型强制值混用），不给默认值。
        PropSpec dock = Find(ps, "dock");
        AssertTrue(dock != null, "dock spec exists");
        AssertTrue(!dock.HasDefault(), "dock (enum) has no default");

        // 几何属性随布局而定，不给默认值。
        PropSpec w = Find(ps, "w");
        if (w != null) {
            AssertTrue(!w.HasDefault(), "w (geometry) has no default");
        }
    }

    // 复位：值 ≠ 默认值时给出入口，点下去写回默认值。
    static void TestResetRestores() {
        Designer d = new Designer();
        d.layoutMode = 0;
        FormField f = FormField.New(0, 1);
        f.label = "My Caption";
        List<PropSpec> ps = d.AllFieldSpecs(f);

        int li = IndexOf(ps, "label");
        AssertTrue(li >= 0, "label row index found");
        PropSpec lbl = ps[li];
        AssertTrue(lbl.Read() != lbl.DefaultValue(), "edited label differs from default");

        PropertyGrid grid = new PropertyGrid();
        int beforeChanges = 0;
        grid.OnBeforeChange((string k) => { beforeChanges = beforeChanges + 1; });
        grid.Bind("fld1", ps);
        AssertTrue(grid.RowNeedsReset(li), "row offers reset when value differs from default");

        grid.ResetToDefault(li);
        AssertEq(f.label, FormField.DefaultLabel(0), "label reset to the type default");
        AssertEq(lbl.Read(), lbl.DefaultValue(), "spec reads the default after reset");
        AssertTrue(!grid.RowNeedsReset(li), "row no longer offers reset after reset");
        AssertTrue(beforeChanges == 1, "reset went through the before-change hook (undo stack)");

        // 值本来就等于默认值时不给复位入口。
        PropertyGrid grid2 = new PropertyGrid();
        grid2.Bind("fld2", ps);
        AssertTrue(!grid2.RowNeedsReset(li), "row with default value offers no reset");
    }

    static void Main() {
        TestDefaultsAttached();
        TestResetRestores();

        if (fails == 0) {
            Console.WriteLine("DESIGNER_PROP_RESET_TEST_OK");
        } else {
            Console.WriteLine("DESIGNER_PROP_RESET_TEST_FAIL (fails=" + Convert.ToString(fails) + ")");
        }
    }
}
