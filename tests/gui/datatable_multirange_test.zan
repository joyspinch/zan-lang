using System;
using Gui;
using Gui.Widget;

namespace DataTableMultiRangeTest;

class Program {
    static DataRow Row(string price, string qty) {
        DataRow r = new DataRow();
        r.Push(price);
        r.Push(qty);
        return r;
    }

    static string DumpRange(DataTableState st, int i) {
        int r0; int c0; int r1; int c1;
        if (!DataTable.RangeAt(st, i, out r0, out c0, out r1, out c1)) { return "none"; }
        return Convert.ToString(r0) + "," + Convert.ToString(c0)
            + "-" + Convert.ToString(r1) + "," + Convert.ToString(c1);
    }

    // 汇总模拟状态栏口径：逐区域求 numeric 列之和（含并集去重）。
    static int SumRanges(DataTableState st, List<DataColumn> cols, DataSource src) {
        int n = DataTable.RangeCount(st);
        int sum = 0;
        for (int qi = 0; qi < n; qi = qi + 1) {
            int r0; int c0; int r1; int c1;
            if (!DataTable.RangeAt(st, qi, out r0, out c0, out r1, out c1)) { continue; }
            int ri = r0;
            while (ri <= r1 && ri < DataTable.DispCount(st)) {
                if (DataTable.DispKind(st, ri) == 0) {
                    int ci = c0;
                    while (ci <= c1 && ci < cols.Count) {
                        bool dup = false;
                        for (int qj = 0; qj < qi && !dup; qj = qj + 1) {
                            int jr0; int jc0; int jr1; int jc1;
                            if (DataTable.RangeAt(st, qj, out jr0, out jc0, out jr1, out jc1)
                                && ri >= jr0 && ri <= jr1 && ci >= jc0 && ci <= jc1) { dup = true; }
                        }
                        if (!dup && cols[ci].numeric) {
                            sum = sum + src.CellNum(DataTable.DispRowOf(st, ri), ci);
                        }
                        ci = ci + 1;
                    }
                }
                ri = ri + 1;
            }
        }
        return sum;
    }

    static void Main() {
        List<DataRow> rows = new List<DataRow>();
        rows.Add(Program.Row("10", "1"));
        rows.Add(Program.Row("20", "2"));
        rows.Add(Program.Row("30", "3"));
        rows.Add(Program.Row("40", "4"));
        rows.Add(Program.Row("50", "5"));
        DataSource src = new RowListSource(rows);

        List<DataColumn> cols = new List<DataColumn>();
        cols.Add(DataColumn.Numeric("price", 80));
        cols.Add(DataColumn.Numeric("qty", 80));
        DataTableState st = new DataTableState();
        DataTable.EnsureInit(st, cols, src);
        DataTable.Recompute(st, cols, src);

        // ---- 初始无范围 ----
        Console.WriteLine("initialEmpty=" + (!DataTable.HasRange(st)
            && DataTable.RangeCount(st) == 0 && !DataTable.HasMulti(st)));

        // ---- 拖出第一个区域：行 0..1 × 列 0..1 ----
        st.rangeR0 = 0; st.rangeR1 = 1;
        st.rangeC0 = 0; st.rangeC1 = 1;
        Console.WriteLine("singleRange=" + (DataTable.RangeCount(st) == 1 && !DataTable.HasMulti(st)));

        // ---- Ctrl 追加：归档当前，开新区域 行3..4 × 列0 ----
        DataTable.ArchiveRange(st);
        st.rangeR0 = 3; st.rangeR1 = 4;
        st.rangeC0 = 0; st.rangeC1 = 0;
        Console.WriteLine("archived=" + (DataTable.MultiCount(st) == 1 && DataTable.HasMulti(st)));
        Console.WriteLine("count2=" + (DataTable.RangeCount(st) == 2));
        Console.WriteLine("region0=" + (Program.DumpRange(st, 0) == "0,0-1,1"));
        Console.WriteLine("region1=" + (Program.DumpRange(st, 1) == "3,0-4,0"));

        // ---- 并集汇总：区域0 = (10+20)+(1+2)=33，区域1 = 40+50=90 → 123 ----
        Console.WriteLine("unionSum=" + (Program.SumRanges(st, cols, src) == 123));

        // ---- 重叠区域不重复计：追加与区域0部分重叠的 行1..2 × 列1 ----
        DataTable.ArchiveRange(st);
        st.rangeR0 = 1; st.rangeR1 = 2;
        st.rangeC0 = 1; st.rangeC1 = 1;
        // 新增贡献：行2列1 = 3（行1列1 已被区域0 计过）
        Console.WriteLine("overlapSum=" + (Program.SumRanges(st, cols, src) == 126));
        Console.WriteLine("count3=" + (DataTable.RangeCount(st) == 3));

        // ---- 多区域复制：BuildText 按区域拼接 ----
        string txt = DataTable.BuildText(st, cols, src, false, false);
        // 区域0 两行两列 + 区域1 两行一列 + 区域2 两行一列
        // 行计数：尾随换行按含尾计——用手工数换行符。
        int lines = 0;
        for (int ci = 0; ci < txt.Length; ci = ci + 1) {
            if ((int)txt[ci] == 10) { lines = lines + 1; }
        }
        Console.WriteLine("copyLines=" + (lines == 6));
        Console.WriteLine("copyHasFirst=" + (txt.IndexOf("10\t1") >= 0));
        Console.WriteLine("copyHasLast=" + (txt.IndexOf("50") >= 0));

        // ---- 多区域清空：仅 editable 列计数。价格列设为
        // 可编辑后，区域0 贡献 2 格、区域1 贡献 2 格、区域2
        // 与区域0 重叠的 1 格不再重复清 → 共 4 格。 ----
        cols[0].editable = true;
        int cleared = DataTable.ClearRangeCells(st, cols, src);
        Console.WriteLine("clearCells=" + (cleared == 4));

        // ---- 普通点击丢弃全部归档（渲染层语义的单测等价） ----
        DataTable.ClearMulti(st);
        DataTable.ClearRange(st);
        Console.WriteLine("clearMulti=" + (!DataTable.HasMulti(st)
            && DataTable.RangeCount(st) == 0));

        // ---- 滚轮扩展语义的纯逻辑等价：远端推进/收缩 ----
        st.rangeR0 = 1; st.rangeR1 = 2;
        st.rangeC0 = 0; st.rangeC1 = 1;
        // 模拟 Ctrl+滚轮向下：远端 rangeR1 +1
        st.rangeR1 = st.rangeR1 + 1;
        Console.WriteLine("wheelGrow=" + (Program.DumpRange(st, 0) == "1,0-3,1"));
        // 模拟 Ctrl+滚轮向上收缩：远端 rangeR1 -1（回到锚点）
        st.rangeR1 = st.rangeR1 - 2;
        Console.WriteLine("wheelShrink=" + (Program.DumpRange(st, 0) == "1,0-1,1"));

        // ---- 单格 Ctrl 追加：归档单格区域 ----
        DataTable.ClearMulti(st);
        st.rangeR0 = 0; st.rangeR1 = 0;
        st.rangeC0 = 1; st.rangeC1 = 1;
        DataTable.ArchiveRange(st);
        st.rangeR0 = 4; st.rangeR1 = 4;
        st.rangeC0 = 0; st.rangeC1 = 0;
        Console.WriteLine("cellAppend=" + (DataTable.RangeCount(st) == 2
            && Program.DumpRange(st, 0) == "0,1-0,1"
            && Program.DumpRange(st, 1) == "4,0-4,0"));

        // ================= 精细化操作：填充/粘贴/重做 =================

        // 恢复干净数据（clearCells 清过部分 price）。
        src.SetCell(0, 0, "10"); src.SetCell(1, 0, "20"); src.SetCell(2, 0, "30");
        src.SetCell(3, 0, "40"); src.SetCell(4, 0, "50");

        // ---- Ctrl+D 向下填充：顶行复制到其余行（qty 不可编辑） ----
        DataTable.ClearMulti(st);
        st.rangeR0 = 0; st.rangeR1 = 2; st.rangeC0 = 0; st.rangeC1 = 1;
        int fd = DataTable.FillDown(st, cols, src);
        Console.WriteLine("fillDown=" + (fd == 2 && src.CellText(1, 0) == "10"
            && src.CellText(2, 0) == "10"));

        // ---- 撤销/重做成对：一组填充一次回退、一次重放 ----
        bool u1 = DataTable.Undo(st, cols, src);
        Console.WriteLine("fillUndo=" + (u1 && src.CellText(1, 0) == "20"
            && src.CellText(2, 0) == "30"));
        bool rr = DataTable.Redo(st, cols, src);
        Console.WriteLine("fillRedo=" + (rr && src.CellText(1, 0) == "10"
            && src.CellText(2, 0) == "10"));

        // ---- 重做过的操作保持可撤销：撤销⇄重放闭环 ----
        bool ru = DataTable.Undo(st, cols, src);
        Console.WriteLine("redoUndo=" + (ru && src.CellText(1, 0) == "20"
            && src.CellText(2, 0) == "30"));
        bool rrr = DataTable.Redo(st, cols, src);
        Console.WriteLine("redoRedo=" + (rrr && src.CellText(1, 0) == "10"
            && src.CellText(2, 0) == "10"));
        DataTable.Undo(st, cols, src);

        // ---- 新编辑分支历史：Journal 清空 redoLog ----
        DataTable.WriteCellValue(st, cols, src, 0, 0, "99");
        Console.WriteLine("redoCleared=" + (!DataTable.Redo(st, cols, src)));

        // ---- 粘贴进选区：1x1 块平铺整个范围 ----
        st.rangeR0 = 1; st.rangeR1 = 3; st.rangeC0 = 0; st.rangeC1 = 0;
        int pt = DataTable.PasteText(st, cols, src, "77");
        Console.WriteLine("pasteTile=" + (pt == 3 && src.CellText(3, 0) == "77"));

        // ---- 多区域粘贴：逐区域独立平铺 ----
        DataTable.ClearMulti(st);
        DataTable.ClearRange(st);
        st.rangeR0 = 0; st.rangeR1 = 0; st.rangeC0 = 0; st.rangeC1 = 0;
        DataTable.ArchiveRange(st);
        st.rangeR0 = 3; st.rangeR1 = 3; st.rangeC0 = 0; st.rangeC1 = 0;
        int pm = DataTable.PasteText(st, cols, src, "5");
        Console.WriteLine("pasteMulti=" + (pm == 2 && src.CellText(0, 0) == "5"
            && src.CellText(3, 0) == "5"));

        // ---- 填充柄：数值级差外推（Excel 拖两格数字） ----
        DataTable.ClearMulti(st);
        DataTable.ClearRange(st);
        src.SetCell(0, 0, "5"); src.SetCell(1, 0, "20");
        int fs = DataTable.FillApply(st, cols, src, 0, 0, 1, 0, 2, 0, 4, 0);
        Console.WriteLine("fillSeries=" + (fs == 3 && src.CellText(2, 0) == "35"
            && src.CellText(3, 0) == "50" && src.CellText(4, 0) == "65"));

        // ---- 填充柄：单格块复制（无级差） ----
        int fc = DataTable.FillApply(st, cols, src, 0, 0, 0, 0, 1, 0, 2, 0);
        Console.WriteLine("fillCopy=" + (fc == 2 && src.CellText(1, 0) == "5"
            && src.CellText(2, 0) == "5"));

        // ---- 同值写入跳过：重复填充不产生任何日志写入 ----
        int fsame = DataTable.FillApply(st, cols, src, 0, 0, 0, 0, 1, 0, 2, 0);
        Console.WriteLine("fillNoop=" + (fsame == 0));

        // ---- Ctrl+R 向右填充：左列复制到其余列 ----
        cols[1].editable = true;
        src.SetCell(0, 0, "8"); src.SetCell(0, 1, "3");
        st.rangeR0 = 0; st.rangeR1 = 0; st.rangeC0 = 0; st.rangeC1 = 1;
        int fr = DataTable.FillRight(st, cols, src);
        Console.WriteLine("fillRight=" + (fr == 1 && src.CellText(0, 1) == "8"));

        // ---- 数据透视：行维度=第一文本列、值=数值列求和 ----
        // 三行数据：类别×区域交叉。Apples/North=10+30=40、
        // Apples/South=20、Pears/North=5、Pears/South=15。
        List<DataRow> prows = new List<DataRow>();
        Program.PRow(prows, "Apples", "North", "10");
        Program.PRow(prows, "Apples", "South", "20");
        Program.PRow(prows, "Apples", "North", "30");
        Program.PRow(prows, "Pears", "North", "5");
        Program.PRow(prows, "Pears", "South", "15");
        DataSource psrc = new RowListSource(prows);
        List<DataColumn> pcols = new List<DataColumn>();
        pcols.Add(DataColumn.Text("item", 100));
        pcols.Add(DataColumn.Text("region", 100));
        pcols.Add(DataColumn.Numeric("amt", 80));
        DataTableState pst = new DataTableState();
        DataTable.EnsureInit(pst, pcols, psrc);
        pst.rangeR0 = 0; pst.rangeR1 = 4;
        pst.rangeC0 = 0; pst.rangeC1 = 2;
        bool pb = DataTable.BuildPivotFromRange(pst, pcols, psrc);
        // 2 行（Apples、Pears 保序）× 2 列（North、South）
        int aNX = pst.pivotCols.IndexOf("North");
        int aSX = pst.pivotCols.IndexOf("South");
        int aA = pst.pivotRows.IndexOf("Apples");
        int aP = pst.pivotRows.IndexOf("Pears");
        Console.WriteLine("pivotBuild=" + (pb && pst.pivotRows.Count == 2
            && pst.pivotCols.Count == 2 && aNX == 0 && aSX == 1
            && aA == 0 && aP == 1));
        Console.WriteLine("pivotSum=" + (pst.pivotData[aA * 2 + aNX] == 40.0
            && pst.pivotData[aA * 2 + aSX] == 20.0
            && pst.pivotData[aP * 2 + aNX] == 5.0
            && pst.pivotData[aP * 2 + aSX] == 15.0
            && pst.pivotRowTot[aA] == 60.0 && pst.pivotColTot[aNX] == 45.0
            && pst.pivotGrand == 80.0));
    }

    static void PRow(List<DataRow> list, string item, string region, string amt) {
        DataRow r = new DataRow();
        r.Push(item);
        r.Push(region);
        r.Push(amt);
        list.Add(r);
    }
}
