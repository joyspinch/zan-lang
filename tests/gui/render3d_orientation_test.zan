// Render3D GPU 路径的上下方向回归：相机正视 -z，方块放在视线上方（+y），
// 画进窗口画布（GL FBO）后回读，方块必须落在画面上半部、下半部保持背景。
// 曾经 3D 顶点着色器对 clip.y 取反（误以为画布 FBO 顶朝下），整幅 3D 世界
// 上下颠倒而 HUD 正常（macOS 上 fps-3d 可见，模板曾用镜像相机绕行）。
// 没有 GPU 后端（Draw 返回 0）时只在 stderr 记 SKIP，golden 不变。
// golden: R3D_UP_OK
using System;
using System.Numerics;
using Gui;
using Game.Graphics;
using Game.Render3D;

class Render3DOrientationTest {
    static int Lit(Canvas c, int x0, int y0, int x1, int y1) {
        int n = 0;
        for (int y = y0; y < y1; y = y + 2) {
            for (int x = x0; x < x1; x = x + 2) {
                int p = c.GetPixel(x, y);
                int r = (p >> 16) & 255;
                int g = (p >> 8) & 255;
                if (r > 120 && g < 90) { n = n + 1; }
            }
        }
        return n;
    }

    static int Main() {
        App app = new App("render3d orientation", 200, 160);
        int result = 0;
        try {
            app.Show();
            Canvas c = app.canvas;
            Camera3D cam = new Camera3D();
            cam.Position = new Vector3(0.0f, 0.0f, 6.0f);
            cam.Target = Vector3.Zero;
            cam.SetViewport(c.Width(), c.Height());
            RenderPlan plan = new RenderPlan(cam);
            plan.AmbientRed = 1.0f; plan.AmbientGreen = 1.0f; plan.AmbientBlue = 1.0f;
            Renderer3D renderer = new Renderer3D(8);
            SceneNode root = new SceneNode("root");
            SceneNode box = new SceneNode("box");
            box.SetPosition(0.0f, 1.4f, 0.0f);
            box.Material = Material.Emissive(1.0f, 0.1f, 0.1f);
            box.BoundsRadius = 1.0f;
            root.AddChild(box);
            bool framed = app.SafeFrame(() => {
                c.FillRect(0, 0, c.Width(), c.Height(), unchecked((int)0xff101010));
                box.MeshKey = c.MeshUpload(Primitives3D.CreateCube(1.2f, 1.2f, 1.2f));
                plan.Build(root);
                result = renderer.Draw(c, plan);
            });
            if (!framed || result == 0) {
                Console.ErrorWriteLine("SKIP: no GPU 3D backend (framed=" + Convert.ToString(framed)
                    + " draw=" + Convert.ToString(result) + ")");
                Console.WriteLine("R3D_UP_OK");
                return 0;
            }
            int w = c.Width();
            int h = c.Height();
            int top = Lit(c, 0, 0, w, h / 2);
            int bottom = Lit(c, 0, h / 2, w, h);
            if (top > 20 && bottom * 4 < top) {
                Console.WriteLine("R3D_UP_OK");
            } else {
                Console.WriteLine("R3D_UPSIDE_DOWN top=" + Convert.ToString(top)
                    + " bottom=" + Convert.ToString(bottom));
            }
            renderer.Dispose();
        } finally {
            app.window.Destroy();
            app.canvas.Destroy();
        }
        return 0;
    }
}
