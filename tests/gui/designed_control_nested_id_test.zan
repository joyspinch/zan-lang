using System;
using Gui;
using Gui.Widget;

public class NestedIdHost : DesignedControl {
    NestedIdHost() {
        this.Design("NestedIdHost", "nested-id-test.html");
        this.name = "Host";
    }

    public Button InnerButton() {
        return (Button)this.Ctl("Host");
    }

    public bool OldHostInclusiveLookupFails() {
        try {
            Button old = (Button)this.Find("Host");
            return old == null;
        } catch (Exception _ex) {
            return true;
        }
    }

    public bool MissingStillThrows() {
        try {
            this.Ctl("Missing");
            return false;
        } catch (Exception _ex) {
            return true;
        }
    }
}

class DesignedControlNestedIdTest {
    static void Main() {
        NestedIdHost host = new NestedIdHost();
        Button button = host.InnerButton();
        if (!host.OldHostInclusiveLookupFails()) { Environment.Exit(1); }
        if (button == null || button.Kind() != "Button") { Environment.Exit(2); }
        if (!host.MissingStillThrows()) { Environment.Exit(3); }
        Console.WriteLine("DESIGNED_CONTROL_NESTED_ID_PASS");
    }
}
