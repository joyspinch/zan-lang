using System;
using Gui;
using Gui.Widget;

public class NestedIdHost : DesignedControl {
    NestedIdHost() {
        this.Design("NestedIdHost", "nested-id-test.html");
        this.name = "Host";
    }

    public Button InnerButton() {
        return (Button)this.Ctl("Host");
    }

    public bool OldHostInclusiveLookupFails() {
        try {
            Button old = (Button)this.Find("Host");
            return old == null;
        } catch (Exception _ex) {
            return true;
        }
    }

    public bool MissingStillThrows() {
        try {
            this.Ctl("Missing");
            return false;
        } catch (Exception _ex) {
            return true;
        }
    }
}

class DesignedControlNestedIdTest {
    static void Main() {
        NestedIdHost host = new NestedIdHost();
        Button button = host.InnerButton();
        if (!host.OldHostInclusiveLookupFails()) { Environment.Exit(1); }
        if (button == null || button.Kind() != "Button") { Environment.Exit(2); }
        if (!host.MissingStillThrows()) { Environment.Exit(3); }

        Form f = Form.CreateOffscreen("NestedScope", 600, 300);
        App app = f.GetApp();
        Html.Install();
        string outerHtml = "<body style=\"display:grid;grid-template-columns:minmax(0,1fr)\">"
            + "<nested-id-host id=\"Outer\" style=\"width:400px;height:180px\"></nested-id-host>"
            + "</body>";
        Control tree = Html.LoadWith(app, outerHtml, null, "",
            (string kind) => kind == "NestedIdHost" || kind == "nested-id-host"
                ? (Control)new NestedIdHost() : null);
        if (tree == null) { Environment.Exit(4); }
        f.Add(tree);
        f.MeasureTree(app);
        f.Arrange(0, 0, 600, 300);
        NestedIdHost outer = (NestedIdHost)tree.Find("Outer");
        if (outer == null) { Environment.Exit(5); }
        if (outer.bw != 400) { Environment.Exit(6); }
        Button innerBtn = outer.InnerButton();
        if (innerBtn == null || innerBtn.bw != 120) { Environment.Exit(7); }
        if (Style.Has(innerBtn.Class, "zs-load-0")) { Environment.Exit(8); }
        if (!Style.Has(innerBtn.Class, outer.OwnScopeClass())) { Environment.Exit(9); }

        Console.WriteLine("DESIGNED_CONTROL_NESTED_ID_PASS");
    }
}
