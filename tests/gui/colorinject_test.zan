using System;
using Gui;
using Gui.Widget;

class Program {
    static int fails;

    static void True(string what, bool got) {
        if (got) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static Button Colored(int c) {
        Button b = new Button("X");
        b.Color = c;
        return b;
    }

    static void Main() {
        fails = 0;
        App app = new App("colorinject", 80, 40);
        app.sheet = StyleSheet.FromCss("button { padding: 4; }\n");

        int gen0 = app.bgThemeGen;
        int brandBg = 0xFF1890FF;
        int secondBg = 0xFFFF7A45;
        int fgCol = 0xFF112233;

        Button first = Colored(brandBg);
        first.SyncBinding();
        True("color projection does not mutate sheet gen", app.bgThemeGen == gen0);
        True("color projects to styleBg", first.styleBg == brandBg && first.styleBgTo == 0);
        True("resolved box keeps brand bg", first.Box(app).bg == brandBg);

        first.Color = secondBg;
        first.SyncBinding();
        True("color change updates styleBg", first.styleBg == secondBg);
        True("resolved box updates bg", first.Box(app).bg == secondBg);

        first.Color = 0;
        first.SyncBinding();
        True("clearing color releases projection", first.styleBg == 0);
        True("resolved box falls back to sheet/theme", first.Box(app).bg != secondBg);

        first.TextColor = fgCol;
        first.SyncBinding();
        True("text color projects to styleColor", first.styleColor == fgCol);
        True("resolved box keeps text color", first.Box(app).fg == fgCol);

        StyleSheet skins = StyleSheet.FromCss(
            "button[class*=\"custom-\"] { background: #101010; }\n"
            + "button[class*=\"custom-1890ff\"] { background: #1890ff; }\n");
        // 赋给 int 先回绕：Zan 里超出 int 的十六进制字面量按无符号
        // 参与 ==，直接和字段比较恒为 false。
        int genericBg = 0xFF101010;
        StyleBox other = new StyleBox();
        skins.ApplyMatch(other, "button", "custom-ff7a45", "", "", 0);
        True("other hex gets the generic rule", other.bg == genericBg);
        StyleBox fit = new StyleBox();
        skins.ApplyMatch(fit, "button", "custom-1890ff", "", "", 0);
        True("own hex gets the specific rule", fit.bg == brandBg);

        if (fails == 0) { Console.WriteLine("colorinject: OK"); return; }
        Console.WriteLine("colorinject: FAIL " + Convert.ToString(fails));
    }
}
