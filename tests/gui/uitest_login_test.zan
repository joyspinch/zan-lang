// S23 / S24（docs/ZAN_STANDARD.md §5）：Gui.Testing.UiTest 脱窗 UI 测试的契约。
// 窗体（ViewModel）不起窗口、不建 App：UiTest.Open 按类型名取 --embed 的
// LoginForm.html 建树并绑定；之后输入、点击、断言可见性/文本/启用态，名字写错给
// "did you mean"，禁用控件拒绝操作；语义树快照与 tests/gui/uitest/ 下的金样对账。
using System;
using Gui;
using Gui.Widget;
using Gui.Testing;

partial class LoginForm : Form {
    string user = "";
    string error = "";
    bool showError = false;
    int logins = 0;
    void OnLogin() {
        if (user.Trim() == "") { error = "name required"; showError = true; return; }
        error = "";
        showError = false;
        logins = logins + 1;
    }
    void OnDelete() { }
}

public class Program {
    static void Rejects(string what, Action a) {
        try { a(); Console.WriteLine(what + ": NOT rejected"); }
        catch (UiTestException e) { Console.WriteLine(what + ": " + e.Message); }
    }

    public static void Main() {
        LoginForm vm = new LoginForm();
        UiTest t = UiTest.Open(vm);
        Console.WriteLine("app=" + (vm.GetApp() == null ? "none" : "created"));
        t.Expect("Error").Hidden();
        t.MatchSnapshot("tests/gui/uitest/login_initial.snapshot.json");
        t.Click("Login");
        t.Expect("Error").Visible().Text("name required");
        t.Type("UserName", "admin");
        Console.WriteLine("vm.user=" + vm.user);
        t.Click("Login");
        t.Expect("Error").Hidden();
        Console.WriteLine("logins=" + vm.logins);
        t.Expect("Delete").Disabled();
        Rejects("click disabled", () => { t.Click("Delete"); });
        Rejects("typo", () => { t.Click("Logn"); });
        Rejects("wrong value", () => { t.Expect("UserName").Value("root"); });
        Console.WriteLine("UITEST_LOGIN_OK");
    }
}
