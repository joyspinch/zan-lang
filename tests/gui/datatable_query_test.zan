using System;
using Gui;
using Gui.Widget;

namespace DataTableQueryTest;

class Program {
    static void Main() {
        DataTableState st = new DataTableState();
        int caps = QueryCapabilities.Filter + QueryCapabilities.Sort
            + QueryCapabilities.StableKeys + QueryCapabilities.Server;
        QueryDescriptor q = QueryDescriptor.Of(st, "orders", caps);

        Console.WriteLine(q.Dataset());
        Console.WriteLine(q.DataRevision());
        Console.WriteLine(q.QueryRevision());
        Console.WriteLine(q.ViewRevision());
        Console.WriteLine(QueryCapabilities.Of(caps).Has(QueryCapabilities.Filter));
        Console.WriteLine(QueryCapabilities.Of(caps).Has(QueryCapabilities.Sort));
        Console.WriteLine(QueryCapabilities.Of(caps).Has(QueryCapabilities.Edit) == false);
        Console.WriteLine(q.ToJson());

        QueryDescriptor copy = QueryDescriptor.FromJson(q.ToJson());
        Console.WriteLine(copy != null);
        if (copy != null) {
            Console.WriteLine(q.SameQuery(copy));
            Console.WriteLine(q.Fingerprint() == copy.Fingerprint());
        }
        Console.WriteLine(q.IsCurrent(st));

        DataTable.InvalidateQuery(st);
        Console.WriteLine(q.IsCurrent(st) == false);
        Console.WriteLine(st.queryRevision == 1);
        QueryDescriptor q2 = QueryDescriptor.Of(st, "orders", caps);
        Console.WriteLine(q.SameQuery(q2) == false);
        Console.WriteLine(q2.IsCurrent(st));

        DataTable.InvalidateView(st);
        QueryDescriptor q3 = QueryDescriptor.Of(st, "orders", caps);
        Console.WriteLine(q2.SameQuery(q3));
        Console.WriteLine(q2.IsCurrent(st) == false);

        DataTable.InvalidateData(st);
        Console.WriteLine(st.dataRevision == 1);
        Console.WriteLine(st.queryRevision == 2);
        Console.WriteLine(st.viewRevision == 3);
        Console.WriteLine(QueryDescriptor.FromJson("{\"ver\":99}") == null);
        Console.WriteLine(QueryDescriptor.FromJson("{\"ver\":1}") == null);
    }
}
