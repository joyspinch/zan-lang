using System;
using System.Web;
using Gui;
using Gui.Widget;
using Gui.Designer;

// 浮动件的定位基准要让开父容器最上面那条顶部停靠件（标题栏 / 工具条 /
// 面包屑）：否则 fy=0 的浮动件正好压在标题栏上。设计器预览与生成的
// 运行时程序必须给出同一个位置。
partial class FloatBand {
    static void OnLoad(Form form) { }
}

class DesignerFloatBandTest {
    static int fails;

    static void Check(string label, bool ok) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + label);
    }

    static Control Node(Control tree, string name) {
        Control ctl = tree.Find(name);
        if (ctl == null) { throw new Exception("missing " + name); }
        return ctl;
    }

    static void Freeze(App app) {
        app.freezeAnimClock = true;
        app.nowMs = 10000;
        app.lastFrameMs = 10000;
    }

    static void SameRects(Designer designer, Control runtime) {
        for (int i = 0; i < designer.pvDocNodes.Count; i = i + 1) {
            DesignPreviewNode node = designer.pvDocNodes[i];
            if (node.control == null || node.field.fname == "") { continue; }
            Control reference = DesignerFloatBandTest.Node(runtime, node.field.fname);
            Control actual = node.control;
            DesignerFloatBandTest.Check("preview rect " + node.field.fname,
                actual.bx == reference.bx && actual.by == reference.by
                && actual.bw == reference.bw && actual.bh == reference.bh);
        }
    }

    static void Run() {
        string html = DesignerFloatBandTest.Html();
        Designer designer = new Designer();
        designer.LoadHtmlText(html);
        App editor = App.CreateOffscreen("editor", 760, 500);
        editor.SetOffscreenViewport(760, 500, 100);
        designer.targetDpi = 100;
        Check("prepare", designer.PrepareDesignPreview(editor));
        DesignerFloatBandTest.Freeze(designer.pvDocForm.GetApp());
        designer.PrepareDesignPreview(editor);

        JsonValue document = JsonValue.ParseLenient(DesignerHtml.ToJsonDoc(html));
        Control tree = FloatBand.__BuildForm();
        Form runtime = Form.CreateOffscreen("Float band", 480, 320);
        App app = runtime.GetApp();
        app.SetOffscreenViewport(480, 320, 100);
        FormBuilder.ConfigureWindow(app, document);
        FormBuilder.ApplyStyles(app, document);
        runtime.Add(tree);
        DesignerFloatBandTest.Freeze(app);
        runtime.CaptureSnapshot();

        Control bar = DesignerFloatBandTest.Node(tree, "TitleBar");
        Control floating = DesignerFloatBandTest.Node(tree, "FloatBox");
        Control inner = DesignerFloatBandTest.Node(tree, "Inner");
        Control innerFloat = DesignerFloatBandTest.Node(tree, "InnerFloat");

        // 标题栏占住内容区上沿一条：浮动件落在它下面，不压在它身上。
        Check("float clears the title bar",
            floating.by >= bar.by + bar.bh
            && floating.by == bar.by + bar.bh);
        // 没有停靠条的容器里，浮动件仍贴着内容区上沿（没有多让开）。
        Check("float without band stays at content top",
            innerFloat.by == inner.by + inner.StyleInsetT());

        // 设计器预览与生成的运行时程序给同一个位置。
        DesignerFloatBandTest.SameRects(designer, tree);

        designer.DisposeDesignPreview();
        app.canvas.Destroy();
        editor.canvas.Destroy();
    }

    static string Html() {
        return "<!doctype html><html><head><style>"
            + "body.surface { display: block; padding: 0; margin: 0; }"
            + ".bar { height: 40px; background: #dce8f4; }"
            + ".box { width: 120px; height: 60px; background: #ffd0d0; }"
            + "</style></head>"
            + "<body data-zan-design id=\"FloatBand\" data-win-w=\"480\" data-win-h=\"320\""
            + " data-layout-mode=\"1\" class=\"surface\">"
            + "<div id=\"TitleBar\" class=\"bar\" data-dock=\"1\" data-fh=\"40\"></div>"
            + "<div id=\"FloatBox\" class=\"box\" data-position=\"1\" data-fx=\"16\" data-fy=\"0\""
            + " data-fw=\"120\" data-fh=\"60\"></div>"
            + "<div id=\"Inner\" style=\"height: 120px; background: #eef2f6;\">"
            + "<div id=\"InnerFloat\" class=\"box\" data-position=\"1\" data-fx=\"8\" data-fy=\"0\""
            + " data-fw=\"60\" data-fh=\"30\"></div>"
            + "</div></body></html>";
    }

    static void Main() {
        DesignerFloatBandTest.Run();
        if (DesignerFloatBandTest.fails > 0) {
            Console.WriteLine("DESIGNER_FLOAT_BAND_TEST_FAILED");
            return;
        }
        Console.WriteLine("DESIGNER_FLOAT_BAND_TEST_OK");
    }
}
