using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

class EventCaptureBox {
    public int value;
    public void Set(int v) { value = v; }
}

class EventsLazyAllocationTest {
    static string order;
    static Control lastSender;
    static int hits;

    static void Check(bool ok, string label) {
        if (!ok) { throw new Exception("lazy events: " + label); }
    }

    static void Plain() { order = order + "A"; }
    static void PlainSecond() { order = order + "B"; }
    static void Sender(Control sender) { order = order + "S"; lastSender = sender; }
    static void SenderSecond(Control sender) { order = order + "T"; lastSender = sender; }
    static void Hit() { hits = hits + 1; }

    static void Drain() {
        Action action = Dispatcher.Take();
        while (action != null) {
            action();
            action = Dispatcher.Take();
        }
    }

    static void Allocation() {
        // 同一进程用现有累计字节诊断比较对象成本，不绑定环境字节数或耗时。
        UiEvent[] bare = new UiEvent[1000];
        WidgetEvents[] bags = new WidgetEvents[1000];
        Control[] nodes = new Control[1000];
        long before = GC.GetAllocatedBytesForCurrentThread();
        for (int i = 0; i < 1000; i = i + 1) { bare[i] = new UiEvent(); }
        long eventBytes = GC.GetAllocatedBytesForCurrentThread() - before;
        before = GC.GetAllocatedBytesForCurrentThread();
        for (int i = 0; i < 1000; i = i + 1) { bags[i] = new WidgetEvents(); }
        long bagBytes = GC.GetAllocatedBytesForCurrentThread() - before;
        Check(eventBytes > 0 && bagBytes > 0 && bagBytes < eventBytes * 21,
            "empty bags cost less than 21 bare events per node");
        for (int i = 0; i < 1000; i = i + 1) { nodes[i] = new Panel(); }

        bool empty = true;
        before = GC.GetAllocatedBytesForCurrentThread();
        for (int i = 0; i < 1000; i = i + 1) {
            Control node = nodes[i];
            if (node.On.Any() || node.AcceptsRetainedLongPress()) { empty = false; }
            node.TriggerEvent("Click");
            node.TriggerEvent("DoubleClick");
            node.On.FireByName("Unknown", node);
            node.TriggerEvent("Resize");
            node.TriggerEvent("Show");
            node.TriggerEvent("Hide");
            node.FireKeyNamed("KeyDown");
            bare[i].Count();
            bare[i].CountS();
            bare[i].CountAll();
            bare[i].Raise();
            bare[i].RaiseS(node);
            bare[i].Post();
            bare[i].PostS(node);
            bare[i].Clear();
        }
        long queryBytes = GC.GetAllocatedBytesForCurrentThread() - before;
        Check(empty && queryBytes == 0, "1000 empty nodes query/fire/post/clear allocate nothing");

        before = GC.GetAllocatedBytesForCurrentThread();
        for (int i = 0; i < 1000; i = i + 1) { nodes[i].Click.CountAll(); }
        long materializedBytes = GC.GetAllocatedBytesForCurrentThread() - before;
        Check(materializedBytes > eventBytes, "explicit access materializes event and slot storage");
        before = GC.GetAllocatedBytesForCurrentThread();
        for (int i = 0; i < 1000; i = i + 1) { nodes[i].Click.CountAll(); }
        Check(GC.GetAllocatedBytesForCurrentThread() - before == 0,
            "repeated property access preserves identity without allocations");
        Action plain = EventsLazyAllocationTest.Plain;
        ControlEvent senderHandler = EventsLazyAllocationTest.Sender;
        before = GC.GetAllocatedBytesForCurrentThread();
        bare[0].Add(plain);
        Check(GC.GetAllocatedBytesForCurrentThread() - before > 0,
            "first plain subscription allocates its list");
        before = GC.GetAllocatedBytesForCurrentThread();
        bare[0].AddS(senderHandler);
        Check(GC.GetAllocatedBytesForCurrentThread() - before > 0,
            "first sender subscription independently allocates its list");
        bare[0].Clear();
        before = GC.GetAllocatedBytesForCurrentThread();
        bare[0].Remove(plain);
        bare[0].RemoveS(senderHandler);
        bare[0].Clear();
        Check(GC.GetAllocatedBytesForCurrentThread() - before == 0,
            "empty Remove and Clear allocate no replacement lists");
        Console.WriteLine("1000 empty nodes: zero query allocations");
    }

    static void MappingAndCompatibility() {
        WidgetEvents w = new WidgetEvents();
        UiEvent replacement = new UiEvent();
        w.DoubleClick = replacement;
        Check(w.DoubleClick == replacement, "event object replacement");
        w.DoubleClick += EventsLazyAllocationTest.Plain;
        Check(w.DoubleClick == replacement && w.DoubleClick.Count() == 1, "property += writes same event back");
        w.DoubleClick -= EventsLazyAllocationTest.Plain;
        Check(w.DoubleClick.CountAll() == 0 && !w.Any(), "property -= updates gate");
        w.DoubleClick = null;
        Check(!w.Any(), "null replacement is empty");
        Check(w.DoubleClick != replacement, "access after null materializes a fresh event");

        // 按名称反射访问必须仍能调用属性 getter/setter；字段枚举不作为事件名单。
        object reflected = w.GetFieldObject("DoubleClick");
        Check(reflected == w.DoubleClick, "reflected property getter");
        Check(w.SetFieldObject("DoubleClick", replacement), "reflected property setter accepted");
        Check(w.DoubleClick == replacement, "reflected replacement identity");
        Control clickOwner = new Panel();
        clickOwner.Click = replacement;
        clickOwner.BindEvent("Click", EventsLazyAllocationTest.Hit);
        clickOwner.BindEventS("Click", EventsLazyAllocationTest.Sender);
        hits = 0;
        lastSender = null;
        clickOwner.TriggerEvent("Click");
        Check(hits == 1 && lastSender == clickOwner && clickOwner.Click == replacement,
            "named and direct Click subscriptions share one event");
        replacement.Clear();
        Check(!w.AddByName("Click", EventsLazyAllocationTest.Hit)
            && !w.AddByNameS("Click", EventsLazyAllocationTest.Sender), "no duplicate Click slot");

        List<string> names = WidgetEvents.Names();
        Check(names.Count == 20 && names[0] == "DoubleClick" && names[15] == "LongPress"
            && names[19] == "Drop", "shared event mapping order");
        Control sender = new Panel();
        for (int i = 0; i < names.Count; i = i + 1) {
            string name = names[i];
            Check(w.AddByName(name, EventsLazyAllocationTest.Hit), "named subscription");
            Check(w.AddByNameS(name, EventsLazyAllocationTest.Sender), "named sender subscription");
            hits = 0;
            lastSender = null;
            w.FireByName(name, sender);
            Check(hits == 1 && lastSender == sender, "shared named fire mapping");
            object ev = w.GetFieldObject(name);
            Check(ev is UiEvent, "public property exists for each mapped name");
        }
        Check(w.HasLongPress(), "sender and plain longpress subscriptions opt in");
        w.LongPress.Clear();
        Check(!w.HasLongPress(), "cleared longpress opts out");
        Check(!w.AddByName("Unknown", EventsLazyAllocationTest.Hit)
            && !w.AddByNameS("Unknown", EventsLazyAllocationTest.Sender), "unknown names rejected");
        List<string> common = Control.CommonEvents();
        Check(common.Count == 24 && common[21] == "Resize" && common[23] == "Hide",
            "common lifecycle ordering");
        common.Add("Local");
        Check(Control.CommonEvents().Count == 24, "event lists are independent");
        Console.WriteLine("mapping, assignment, operators and reflection preserved");
    }

    static void SubscriptionAndPost() {
        Control sender = new Panel();
        UiEvent ev = new UiEvent();
        ev.Remove(EventsLazyAllocationTest.Plain);
        ev.RemoveS(EventsLazyAllocationTest.Sender);
        ev.AddS(EventsLazyAllocationTest.Sender);
        ev.Add(EventsLazyAllocationTest.Plain);
        ev.AddS(EventsLazyAllocationTest.SenderSecond);
        ev.Add(EventsLazyAllocationTest.PlainSecond);
        order = "";
        ev.RaiseS(sender);
        Check(order == "ABST" && lastSender == sender, "sync plain-before-sender registration order");
        order = "";
        ev.PostS(sender);
        Check(order == "", "PostS is deferred");
        ev.Clear();
        Check(ev.CountAll() == 0, "Clear empties both channels");
        EventsLazyAllocationTest.Drain();
        Check(order == "ABST" && lastSender == sender, "Clear preserves queued PostS order and sender");
        ev.Add(EventsLazyAllocationTest.Plain);
        ev.Add(EventsLazyAllocationTest.PlainSecond);
        ev.Add(EventsLazyAllocationTest.Plain);
        ev.Remove(EventsLazyAllocationTest.Plain);
        ev.AddS(EventsLazyAllocationTest.Sender);
        ev.AddS(EventsLazyAllocationTest.Sender);
        ev.RemoveS(EventsLazyAllocationTest.Sender);
        Check(ev.Count() == 2 && ev.CountS() == 1, "Remove removes the last equal registration");
        order = "";
        ev.Post();
        Check(order == "", "Post is deferred");
        EventsLazyAllocationTest.Drain();
        Check(order == "AB", "Post only queues plain channel in registration order");
        ev.Clear();
        ev.Add(() => { ev.Clear(); });
        ev.Add(() => { throw new Exception("cleared plain callback ran"); });
        ev.AddS((Control s) => { throw new Exception("cleared sender callback ran"); });
        ev.RaiseS(sender);
        // 清除捕获自身的回调，防止测试构成 ev -> callback -> ev 环。
        ev.Clear();
        Console.WriteLine("subscription, removal, reentrant Clear and deferred order preserved");
    }

    static void RoutingAndButton() {
        Control node = new Panel();
        node.BindEvent("Click", EventsLazyAllocationTest.Plain);
        node.BindEventS("Click", EventsLazyAllocationTest.Sender);
        order = "";
        RoutedEventArgs click = new RoutedEventArgs("Click", node);
        node.OnRoutedEvent(click);
        Check(order == "AS" && lastSender == node, "routed event synchronous sender");
        node.On.LongPress.AddS(EventsLazyAllocationTest.Sender);
        Check(node.AcceptsRetainedLongPress(), "longpress sender-only ownership");
        order = "";
        RoutedEventArgs press = new RoutedEventArgs("LongPress", node);
        node.OnRoutedEvent(press);
        Check(order == "S" && lastSender == node, "routed longpress exactly once");
        node.On.LongPress.Clear();
        Check(!node.AcceptsRetainedLongPress(), "longpress ownership clears");

        Button button = new Button();
        button.BindEvent("Click", EventsLazyAllocationTest.Plain);
        button.BindEventS("Click", EventsLazyAllocationTest.Sender);
        button.Click.Add(EventsLazyAllocationTest.PlainSecond);
        button.Click.AddS(EventsLazyAllocationTest.SenderSecond);
        order = "";
        button.TriggerEvent("Click");
        Check(order == "", "Button Click stays deferred");
        EventsLazyAllocationTest.Drain();
        Check(order == "ABST" && lastSender == button, "Button Click uses one plain-before-sender event");
        lastSender = null;
        Console.WriteLine("routing, longpress ownership and single Button Click preserved");
    }

    static WeakReference<EventCaptureBox> SubscribeCapture(UiEvent ev) {
        EventCaptureBox capture = new EventCaptureBox();
        WeakReference<EventCaptureBox> watch = new WeakReference<EventCaptureBox>(capture);
        ev.Add(() => { capture.Set(1); });
        ev.AddS((Control sender) => { capture.Set(2); });
        return watch;
    }

    static WeakReference<EventCaptureBox> RemoveCapture(UiEvent ev) {
        EventCaptureBox capture = new EventCaptureBox();
        WeakReference<EventCaptureBox> watch = new WeakReference<EventCaptureBox>(capture);
        Action plain = () => { capture.Set(1); };
        ControlEvent sender = (Control s) => { capture.Set(2); };
        ev.Add(plain);
        ev.AddS(sender);
        ev.Remove(plain);
        ev.RemoveS(sender);
        return watch;
    }

    static WeakReference<Control> QueueSender() {
        Control sender = new Panel();
        WeakReference<Control> watch = new WeakReference<Control>(sender);
        sender.Click.AddS((Control s) => { s.On.Any(); });
        sender.Click.PostS(sender);
        return watch;
    }

    static WeakReference<Control> SubscribedNode() {
        Control node = new Panel();
        node.Click.Add(EventsLazyAllocationTest.Plain);
        node.Click.AddS(EventsLazyAllocationTest.Sender);
        return new WeakReference<Control>(node);
    }

    static void Lifetime() {
        UiEvent ev = new UiEvent();
        WeakReference<EventCaptureBox> capture = EventsLazyAllocationTest.SubscribeCapture(ev);
        Check(capture.IsAlive, "subscribed closure retains captured object");
        ev.Clear();
        Check(!capture.IsAlive, "Clear releases both channel closures");
        WeakReference<EventCaptureBox> removed = EventsLazyAllocationTest.RemoveCapture(ev);
        Check(!removed.IsAlive && ev.CountAll() == 0, "Remove releases both channel closures");
        WeakReference<Control> subscribed = EventsLazyAllocationTest.SubscribedNode();
        Check(!subscribed.IsAlive, "event storage does not retain owner");
        WeakReference<Control> pending = EventsLazyAllocationTest.QueueSender();
        Check(pending.IsAlive, "PostS retains sender until dispatch");
        EventsLazyAllocationTest.Drain();
        Check(!pending.IsAlive, "drained PostS releases sender and its event bag");
        Console.WriteLine("weak closure, owner and queued sender lifetimes preserved");
    }

    static void Main() {
        Dispatcher.Init();
        order = "";
        EventsLazyAllocationTest.Allocation();
        EventsLazyAllocationTest.MappingAndCompatibility();
        EventsLazyAllocationTest.SubscriptionAndPost();
        EventsLazyAllocationTest.RoutingAndButton();
        EventsLazyAllocationTest.Lifetime();
        Dispatcher.Clear();
        Console.WriteLine("ALL PASS");
    }
}
