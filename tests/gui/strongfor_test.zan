// 强类型 List<T> 行展开（B-ID154）：data-for 源不再要求 List<object>——
// List<Row> 经反射 Count/Get 通道（InvokeInt/InvokeObject）数行与取行，
// 行对象为用户类实例，行内 data-bind 与 @click 走既有反射通道。
// Main 只为离屏断言存在（真窗口工程由编译器合成）。golden: GUI_STRONGFOR_OK
using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

class StrongForRow {
    public string label;
}

class Strongfor_test : Form {
    // ---- 业务代码：唯一差异就是字段是强类型 List<StrongForRow> ----

    List<StrongForRow> rows = new List<StrongForRow>();
    int added = 0;

    void OnLoad(Form form) {
        StrongForRow a = new StrongForRow();
        a.label = "one";
        StrongForRow b = new StrongForRow();
        b.label = "two";
        rows.Add(a);
        rows.Add(b);
    }

    void OnAdd() {
        added = added + 1;
        StrongForRow r = new StrongForRow();
        r.label = "extra" + Convert.ToString(added);
        rows.Add(r);
    }

    // ---- 断言 ----

    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static Control Pick(Control root, string id) {
        Control c = root.Find(id);
        if (c == null) {
            fails = fails + 1;
            Console.WriteLine("FAIL find '" + id + "'");
            return new Panel();
        }
        return c;
    }

    static void Main() {
        fails = 0;
        Strongfor_test vm = new Strongfor_test();
        vm.ShowOffscreen();
        Form form = vm;

        form.CaptureSnapshot();
        Control page = Pick(vm.docRoot, "page");
        Eq("initial_count", Convert.ToString(page.ChildCount()), "4");
        if (page.ChildCount() >= 4) {
            Eq("row0_text", page.children[2].GetProp("text"), "one");
            Eq("row1_text", page.children[3].GetProp("text"), "two");
        }

        // 行变化：@click 加一行 → 标脏 → 下一帧强类型通道重建。
        ((Button)Pick(vm.docRoot, "AddBtn")).Click.Raise();
        form.CaptureSnapshot();
        Eq("expanded_count", Convert.ToString(page.ChildCount()), "5");
        if (page.ChildCount() >= 5) {
            Eq("row2_text", page.children[4].GetProp("text"), "extra1");
        }

        if (fails == 0) {
            Console.WriteLine("GUI_STRONGFOR_OK");
        } else {
            Console.WriteLine("GUI_STRONGFOR_FAIL fails=" + Convert.ToString(fails));
        }
    }
}
