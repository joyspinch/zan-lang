using System;
using Gui;

namespace CssTest;

/// Headless verification of the CSS skin pipeline: Css.Parse (comments,
/// selector lists, :root variables, state suffixes) plus StyleSheet.ApplyBox
/// (colors, gradients, borders, radii, spacing, typography, motion). Prints
/// the resolved StyleBox fields so the parsing math can be diffed against a
/// golden file - no window, no driver.
class Program {
    static void FontSources() {
        List<string> names = new List<string>();
        List<string> vals = new List<string>();
        Css.CollectVars(":root { --font-size-small: 21; }", names, vals);
        StyleSheet external = Css.ParseWith("label { font-size: var(--font-size-small); }", names, vals);
        StyleSheet local = Css.Parse(":root { --font-size-small: 14; } label { font-size: var(--font-size-small); }");
        StyleSheet shadow = Css.ParseWith(":root { --font-size-small: 16; } label { font-size: var(--font-size-small); }", names, vals);
        StyleSheet alias = Css.ParseWith(":root { --caption: var(--font-size-small); } label { font-size: var(--caption); }", names, vals);
        StyleSheet cycle = Css.ParseWith(":root { --caption: var(--caption); } label { font-size: var(--caption); }", names, vals);
        Program.FontSource(external, "external");
        Program.FontSource(local, "local");
        Program.FontSource(shadow, "shadow");
        Program.FontSource(alias, "alias");
        Program.FontSource(cycle, "cycle");
        names.Add("--font-size-small"); vals.Add("15");
        StyleSheet inherited = Css.ParseWithSources("label { font-size: var(--font-size-small); }", names, vals, 1);
        Program.FontSource(inherited, "inherited");
    }
    static void FontSource(StyleSheet sheet, string name) {
        StyleBox b = new StyleBox(); sheet.ApplyBox(b, "label");
        int physical = b.IsPrescaled(StyleBox.SourceFont()) ? 1 : 0;
        Console.WriteLine($"font-source {name} px {b.fontPx} physical {physical}");
    }

    static StyleSheet Sheet() {
        string css = "/* skin */\n"
            + ":root { --accent: #d92b2b; --radius: 12; }\n"
            + "button, tab.item { background: #202430; color: #e8e8f0;\n"
            + "                   padding: 6 14; radius: var(--radius);\n"
            + "                   border: 2 var(--accent); font-size: 15; }\n"
            + "button.primary { background: linear-gradient(to right, #ffd76a, #e0a020);\n"
            + "                 color: rgb(20, 22, 30); font-weight: bold;\n"
            + "                 box-shadow: 0 4 12 rgba(0, 0, 0, 0.5);\n"
            + "                 transition: 180ms ease-in-out; }\n"
            + "button.primary:hover { background: #ffe08a; opacity: 0.8; }\n"
            + "button.primary:disabled { background: hsl(220, 10%, 30%); }\n"
            + "card { background: transparent; radius: 8 8 20 20;\n"
            + "       border-bottom: 3 navy; margin: 4 8 12 16;\n"
            + "       backdrop-filter: blur(18px); animation: pulse 900ms; }\n"
            + "input:focus { border: 1 #3b82f6; letter-spacing: 2;\n"
            + "              text-align: center; text-overflow: ellipsis; }\n"
            + "option { gap: 7; }\n"
            + "::option { padding-left: 3; }\n"
            + "select::option { padding-right: 4; }\n"
            + ".primary::option { padding-top: 5; }\n"
            + "select.primary::option { padding-bottom: 6; }\n"
            + "#city::option { width: 70; }\n"
            + "select.primary::option:hover { height: 31; }\n"
            + "#city::option:selected { min-width: 80; }\n"
            + "checkbox::box { width: 18; padding-left: 2; }\n"
            + "checkbox::box:hover { height: 19; border: 2 #15803d; }\n"
            + "checkbox::box:checked { background: #16a34a; padding-left: 6; }\n"
            + "slider::track { height: 5; background: #202020; }\n"
            + "slider::fill { height: 3; background: #2563eb; }\n"
            + "slider::thumb { width: 20; height: 20; border: 3 #1d4ed8; }\n"
            + ".success::fill { background: #22c55e; }\n"
            + "progress.success::fill { height: 7; }\n"
            + "progress::label { color: #475569; font-size: 13; }\n"
            + ".el-bar::track { background: #171e29; height: 9; }\n"
            + ".el-bar::fill { background: #089cf3; }\n";
        return Css.Parse(css);
    }

    static void Box(StyleSheet sheet, string selector) {
        StyleBox b = new StyleBox();
        sheet.ApplyBox(b, selector);
        Console.WriteLine($"--- {selector}");
        Console.WriteLine($"bg {b.bg} to {b.bgTo} dir {b.bgDir} opacity {b.opacity} blur {b.blur}");
        Console.WriteLine($"fg {b.fg} font {b.fontPx} weight {b.fontWeight} align {b.align} spacing {b.letterSpacing} ellipsis {b.ellipsis}");
        Console.WriteLine($"border {b.borderW}/{b.borderColor} bottom {b.borderBottomW}/{b.borderBottomColor}");
        Console.WriteLine($"radius {b.radius} corners {b.radiusTL},{b.radiusTR},{b.radiusBR},{b.radiusBL}");
        Console.WriteLine($"pad {b.padL},{b.padT},{b.padR},{b.padB} margin {b.marL},{b.marT},{b.marR},{b.marB}");
        Console.WriteLine($"shadow {b.shadow} {b.shadowDx},{b.shadowDy} blur {b.shadowBlur} inset {b.shadowInset}");
        Console.WriteLine($"motion {b.transitionMs}ms easing {b.easing} anim {b.anim} {b.animMs}ms");
    }

    static void Part(StyleSheet sheet, int state, string label) {
        StyleBox b = new StyleBox();
        Style.ApplySheet(sheet, b, "option", "primary", "", state);
        Style.ApplyPartSheet(sheet, b, "select", "option", "primary", "city", state);
        Console.WriteLine($"part {label} pad {b.padL},{b.padT},{b.padR},{b.padB} size {b.width},{b.height} min {b.minW} gap {b.gap}");
    }

    static void CheckedPart(StyleSheet sheet, int state, string label) {
        StyleBox b = new StyleBox();
        Style.ApplyPartSheet(sheet, b, "checkbox", "box", "", "", state);
        Console.WriteLine($"checked {label} bg {b.bg} size {b.width},{b.height} pad {b.padL} border {b.borderW}/{b.borderColor}");
    }

    static void RangePart(StyleSheet sheet, string type, string part, string cls) {
        StyleBox b = new StyleBox();
        Style.ApplyPartSheet(sheet, b, type, part, cls, "", Style.SNormal());
        Console.WriteLine($"range {type}.{cls}::{part} bg {b.bg} fg {b.fg} size {b.width},{b.height} font {b.fontPx} border {b.borderW}/{b.borderColor}");
    }

    /// 应用 CSS 通过 ParseWith 认得外部（主题/皮肤）的 :root 变量：
    /// 外部变量参与 var() 展开但不进结果表的 vars；同名时这份 CSS
    /// 自己声明的值胜出。
    static void ExternalVars() {
        List<string> names = new List<string>();
        List<string> vals = new List<string>();
        Css.CollectVars(":root { --text-primary: #101828; --accent: #2563eb;\n"
                        + "        --card-blur: 18; }\n", names, vals);
        string css = ":root { --accent: #d92b2b; }\n"
            + "label { color: var(--text-primary); }\n"
            + "button { background: var(--accent); }\n"
            + "card { backdrop-filter: blur(var(--card-blur)px); }\n"
            + "panel { color: var(--nope); background: #111111; }\n";
        StyleSheet sheet = Css.ParseWith(css, names, vals);
        Console.WriteLine($"theme var seen {names.Count} own accent "
                          + sheet.Var("--accent"));
        string leaked = sheet.Var("--text-primary");
        Console.WriteLine($"leaked text-primary [{leaked}]");
        Program.Box(sheet, "label");
        Program.Box(sheet, "button");
        Program.Box(sheet, "card");
        Program.Box(sheet, "panel");
        StyleSheet plain = Css.Parse(css);
        StyleBox pb = new StyleBox();
        plain.ApplyBox(pb, "label");
        Console.WriteLine($"without theme vars fg {pb.fg}");
    }

    /// 渐变方向：关键字与角度都要落到光栅化支持的四向
    /// （0 下、1 右、2 右下、3 上、4 左下），角度吸附到最近的一向。
    static void GradDirs() {
        string css = "a { background: linear-gradient(to bottom, #111111, #222222); }\n"
            + "b { background: linear-gradient(to right, #111111, #222222); }\n"
            + "c { background: linear-gradient(to bottom right, #111111, #222222); }\n"
            + "d { background: linear-gradient(to top, #111111, #222222); }\n"
            + "e { background: linear-gradient(to bottom left, #111111, #222222); }\n"
            + "f { background: linear-gradient(135deg, #111111, #222222); }\n"
            + "g { background: linear-gradient(210deg, #111111, #222222); }\n"
            + "h { background: linear-gradient(#111111, #333333, #222222); }\n"
            + "i { background: linear-gradient(225deg, rgba(255,43,43,0.85),"
            + " rgba(43,107,255,0.35)); }\n";
        StyleSheet sheet = Css.Parse(css);
        List<string> sels = new List<string>();
        sels.Add("a"); sels.Add("b"); sels.Add("c"); sels.Add("d");
        sels.Add("e"); sels.Add("f"); sels.Add("g"); sels.Add("h");
        sels.Add("i");
        for (int i = 0; i < sels.Count; i = i + 1) {
            StyleBox b = new StyleBox();
            sheet.ApplyBox(b, sels[i]);
            Console.WriteLine($"grad {sels[i]} dir {b.bgDir} bg {b.bg} via {b.bgVia} to {b.bgTo}");
        }
    }

    /// 主题导出的按钮/tab token（Style.RootFromTheme）：按钮的角色色、
    /// ghost/secondary 混色与禁用形状都从这里取值，base.css 只消费
    /// token。名字或算法改了这里就会变，因此金标里钉住它们。
    static void ThemeTokens() {
        StyleSheet sheet = Css.Parse(Style.RootFromTheme(Theme.Light()));
        List<string> names = new List<string>();
        names.Add("--primary"); names.Add("--primary-hover");
        names.Add("--primary-pressed"); names.Add("--error-hover");
        names.Add("--neutral-ghost-hover-bg");
        names.Add("--neutral-ghost-active-bg");
        names.Add("--neutral-soft-bg"); names.Add("--neutral-soft-hover-bg");
        names.Add("--neutral-soft-active-bg");
        names.Add("--primary-soft-bg"); names.Add("--primary-ghost-active-bg");
        names.Add("--disabled-bg"); names.Add("--disabled-border");
        names.Add("--disabled-fg");
        // 表单族 token：选区混色在导出时算好，绘制路径不再 LerpColor。
        names.Add("--selection-bg"); names.Add("--scrollbar");
        names.Add("--scrollbar-hover"); names.Add("--field-bg");
        names.Add("--drop-tint");
        // 容器浮层族 token（A2）：遮罩/媒体 scrim 及其上控件色。
        names.Add("--overlay"); names.Add("--scrim");
        names.Add("--scrim-chip"); names.Add("--scrim-chip-hover");
        names.Add("--on-scrim"); names.Add("--tooltip-text-muted");
        for (int i = 0; i < names.Count; i = i + 1) {
            Console.WriteLine($"token {names[i]} {sheet.Var(names[i])}");
        }
    }

    /// 按钮的角色 × 变体 × 状态：颜色规则已从 Style.ButtonDefaults
    /// 迁到 CSS，所以这里按 base.css 的写法验证级联结果——伪状态
    /// 压过类、同权重按出现顺序、`border: 0 <色>` 清掉单边。
    static StyleSheet ButtonSheet() {
        string css = "button { background: var(--bg-primary); color: var(--text-primary);\n"
            + "         border: 1 var(--border-primary); }\n"
            + "button:hover { background: var(--bg-hover); border-color: var(--border-hover); }\n"
            + "button:active { background: var(--bg-active); border-color: var(--border-hover); }\n"
            + "button:focus { border-color: var(--border-focus); }\n"
            + "button.primary { background: var(--primary); color: var(--text-inverse);\n"
            + "                 border: 0 var(--primary); }\n"
            + "button.primary:hover { background: var(--primary-hover);\n"
            + "                       border-color: var(--primary-hover); }\n"
            + "button.primary:active { background: var(--primary-pressed);\n"
            + "                        border-color: var(--primary-pressed); }\n"
            + "button.ghost { background: transparent; color: var(--text-primary);\n"
            + "               border: 1 var(--text-primary); }\n"
            + "button.ghost:hover { background: var(--neutral-ghost-hover-bg);\n"
            + "                     border-color: var(--text-primary); }\n"
            + "button.ghost.primary { color: var(--primary); border-color: var(--primary); }\n"
            + "button.ghost.primary:hover { background: var(--primary-ghost-hover-bg);\n"
            + "                             border-color: var(--primary); }\n"
            + "button.secondary { background: var(--neutral-soft-bg);\n"
            + "                   color: var(--text-primary); border-width: 0; }\n"
            + "button.secondary.error { background: var(--error-soft-bg); color: var(--error); }\n"
            + "button.secondary.error:hover { background: var(--error-soft-hover-bg); }\n"
            + "button.text { background: transparent; color: var(--text-primary);\n"
            + "              border-width: 0; }\n"
            + "button.text:hover { background: var(--bg-hover); }\n"
            + "button.text:selected { color: var(--primary); }\n"
            + "button.text:selected:hover { color: var(--primary-hover); }\n"
            + "button.outline { background: var(--bg-primary); color: var(--text-primary);\n"
            + "                 border: 1 var(--text-primary); }\n"
            + "button.outline.error { color: var(--error); border: 1 var(--error); }\n"
            + "button:disabled { background: var(--disabled-bg);\n"
            + "                  color: var(--disabled-fg);\n"
            + "                  border: 1 var(--disabled-border); }\n"
            + "floatbutton { border-radius: 9999; }\n";
        List<string> names = new List<string>();
        List<string> vals = new List<string>();
        Css.CollectVars(Style.RootFromTheme(Theme.Light()), names, vals);
        return Css.ParseWith(css, names, vals);
    }

    static void Btn(StyleSheet sheet, string type, string cls, int state,
                    string label) {
        StyleBox b = new StyleBox();
        Style.ApplySheet(sheet, b, type, cls, "", state);
        Console.WriteLine($"btn {label} bg {b.bg} fg {b.fg} border {b.borderW}/"
                          + $"{b.borderColor} bottom {b.borderBottomW} radius {b.radius}");
    }

    static void ButtonStates() {
        StyleSheet sheet = Program.ButtonSheet();
        int hover = Style.SHover();
        int press = Style.SHover() + Style.SActive();
        Program.Btn(sheet, "button", "", Style.SNormal(), "base");
        Program.Btn(sheet, "button", "", hover, "hover");
        Program.Btn(sheet, "button", "", Style.SFocus(), "focus");
        Program.Btn(sheet, "button", "primary", Style.SNormal(), "primary");
        Program.Btn(sheet, "button", "primary", hover, "primary-hover");
        Program.Btn(sheet, "button", "primary", press, "primary-press");
        Program.Btn(sheet, "button", "ghost", hover, "ghost-hover");
        Program.Btn(sheet, "button", "ghost primary", hover, "ghost-primary-hover");
        Program.Btn(sheet, "button", "secondary", Style.SNormal(), "secondary");
        Program.Btn(sheet, "button", "secondary error", hover, "secondary-error-hover");
        Program.Btn(sheet, "button", "text", Style.SSelected(), "text-selected");
        Program.Btn(sheet, "button", "text", Style.SSelected() + hover,
                    "text-selected-hover");
        Program.Btn(sheet, "button", "outline error", Style.SNormal(), "outline-error");
        Program.Btn(sheet, "button", "primary", Style.SDisabled(), "primary-disabled");
        // 浮动按钮借用整套 button 规则（Style.SheetAlias），同时保留
        // 自己的 `floatbutton` 声明——皮肤不必把按钮规则复制一遍。
        Program.Btn(sheet, "floatbutton", "primary", hover, "float-primary-hover");
    }

    /// 组合伪类（`:selected:hover`）与未知伪类：状态个数计入特异性，
    /// 因此“选中且悬停”的规则压过只写 `.cls:selected` 的规则；
    /// 引擎不认识的伪类永不匹配，而不是退化成无状态规则。
    static void MultiState() {
        string css = "row:selected { color: #111111; }\n"
            + "row.pinned:selected { color: #222222; }\n"
            + "row:selected:hover { color: #333333; }\n"
            + "row:nope { color: #444444; }\n"
            + "row:checked:disabled { color: #555555; }\n";
        StyleSheet sheet = Css.Parse(css);
        int sel = Style.SSelected();
        int selHover = Style.SSelected() + Style.SHover();
        Program.Btn(sheet, "row", "pinned", sel, "sel");
        Program.Btn(sheet, "row", "pinned", selHover, "sel-hover");
        Program.Btn(sheet, "row", "", Style.SChecked(), "checked-only");
        Program.Btn(sheet, "row", "", Style.SChecked() + Style.SDisabled(),
                    "checked-disabled");
    }

    /// 单个 tab 的三种条状变体：颜色全在 CSS 里，选中的卡片式
    /// tab 用 `border` 简写清掉基础规则的下划线。
    static void TabStates() {
        string css = "tab { background: transparent; color: var(--text-secondary); }\n"
            + "tab.card { background: var(--bg-secondary); }\n"
            + "tab:hover { background: var(--bg-hover); color: var(--text-primary); }\n"
            + "tab:selected { background: transparent; color: var(--primary);\n"
            + "               border-bottom: 2 var(--primary); }\n"
            + "tab.card:selected { background: var(--bg-primary); color: var(--primary);\n"
            + "                    border: 1 var(--border-primary); }\n"
            + "tab:disabled { color: var(--text-disabled); }\n";
        List<string> names = new List<string>();
        List<string> vals = new List<string>();
        Css.CollectVars(Style.RootFromTheme(Theme.Light()), names, vals);
        StyleSheet sheet = Css.ParseWith(css, names, vals);
        Program.Btn(sheet, "tab", "", Style.SNormal(), "tab");
        Program.Btn(sheet, "tab", "", Style.SHover(), "tab-hover");
        Program.Btn(sheet, "tab", "", Style.SSelected(), "tab-selected");
        Program.Btn(sheet, "tab", "", Style.SSelected() + Style.SHover(),
                    "tab-selected-hover");
        Program.Btn(sheet, "tab", "card", Style.SNormal(), "card");
        Program.Btn(sheet, "tab", "card", Style.SSelected(), "card-selected");
        Program.Btn(sheet, "tab", "", Style.SDisabled(), "tab-disabled");
    }

    /// 表单族（A1 批）：镜像 base.css 的字段与内部-part 规则——字段的
    /// 状态边框与校验类、checkbox/radio/switch/slider 的 part×状态、
    /// 角色类只在 :checked 时重着色。控件代码只在两份已解析样式之间
    /// Blend，所以这里钉住的就是控件最终画出的颜色。
    static StyleSheet FormSheet() {
        string css = "input, textarea, select { background: var(--field-bg);\n"
            + "  color: var(--text-primary); border: 1 var(--border-primary);\n"
            + "  border-radius: 3; }\n"
            + "input:hover, textarea:hover, select:hover { border-color: var(--border-hover); }\n"
            + "input:focus, textarea:focus, select:focus { border-color: var(--border-focus); }\n"
            + "input:disabled, textarea:disabled, select:disabled {\n"
            + "  background: var(--bg-disabled); border-color: var(--border-secondary); }\n"
            + "input::placeholder, textarea::placeholder, select::placeholder {\n"
            + "  color: var(--text-tertiary); }\n"
            + "input::selection, textarea::selection { background: var(--selection-bg); }\n"
            + "input::caret, textarea::caret { background: var(--primary); width: 1; }\n"
            + "input::icon { color: var(--text-tertiary); }\n"
            + "input::icon:hover, input::icon:selected { color: var(--primary); }\n"
            + "input::error { color: var(--error); border: 2 var(--error); font-size: 12; }\n"
            + "textarea::scrollbar, select::scrollbar { width: 6; background: var(--scrollbar); }\n"
            + "textarea::scrollbar-track { background: var(--bg-tertiary); }\n"
            + "select::arrow { color: var(--text-secondary); }\n"
            + "select::clear { color: var(--text-tertiary); }\n"
            + "select::clear:hover { color: var(--error); }\n"
            + "select::checkmark { color: var(--primary); }\n"
            + "select::popup { background: var(--bg-secondary); border-radius: 3; }\n"
            + "input.success, input.success:hover, input.success:focus,\n"
            + "select.success, select.success:hover, select.success:focus {\n"
            + "  border-color: var(--success); }\n"
            + "input.error, input.error:hover, input.error:focus,\n"
            + "select.error, select.error:hover, select.error:focus {\n"
            + "  border-color: var(--error); }\n"
            + "checkbox { gap: 8; }\n"
            + "checkbox::box { width: 18; background: var(--bg-primary);\n"
            + "  border: 1 var(--border-primary); border-radius: 3; }\n"
            + "checkbox:hover::box { border-color: var(--primary-hover); }\n"
            + "checkbox:checked::box { background: var(--primary); border-color: var(--primary); }\n"
            + "checkbox:checked:hover::box { background: var(--primary-hover);\n"
            + "  border-color: var(--primary-hover); }\n"
            + "checkbox::check { color: var(--text-inverse); padding-left: 3; }\n"
            + "radio::indicator { width: 18; background: var(--bg-primary);\n"
            + "  border: 1 var(--border-primary); }\n"
            + "radio:hover::indicator { border-color: var(--primary-hover); }\n"
            + "radio:checked::indicator { border-color: var(--primary); border-width: 2; }\n"
            + "radio::dot { width: 8; background: var(--primary); }\n"
            + "switch::track { width: 40; height: 22;\n"
            + "  background: var(--text-tertiary); padding-left: 2; }\n"
            + "switch:hover::track { background: var(--text-secondary); }\n"
            + "switch:checked::track { background: var(--primary); }\n"
            + "switch:checked:hover::track { background: var(--primary-hover); }\n"
            + "switch::thumb { background: var(--text-inverse);\n"
            + "  box-shadow: 0 1 0 var(--shadow-color); }\n"
            + "slider::track { height: 4; background: var(--bg-tertiary); }\n"
            + "slider::fill { background: var(--primary); }\n"
            + "slider::thumb { width: 18; background: var(--bg-primary);\n"
            + "  border: 2 var(--border-primary); }\n"
            + "slider:hover::thumb, slider:active::thumb { border-color: var(--primary);\n"
            + "  box-shadow: 0 0 4 var(--bg-hover); }\n"
            + "checkbox.success:checked::box { background: var(--success);\n"
            + "  border-color: var(--success); }\n"
            + "checkbox.success:checked:hover::box { background: var(--success-hover);\n"
            + "  border-color: var(--success-hover); }\n"
            + "radio.error:checked::indicator { border-color: var(--error); }\n"
            + "radio.error::dot { background: var(--error); }\n"
            + "switch.warning:checked::track { background: var(--warning); }\n"
            + "slider.success::fill { background: var(--success); }\n"
            + "slider.success:hover::thumb { border-color: var(--success); }\n";
        List<string> names = new List<string>();
        List<string> vals = new List<string>();
        Css.CollectVars(Style.RootFromTheme(Theme.Light()), names, vals);
        return Css.ParseWith(css, names, vals);
    }

    static void FormPart(StyleSheet sheet, string type, string part, string cls,
                         int state, string label) {
        StyleBox b = new StyleBox();
        Style.ApplyPartSheet(sheet, b, type, part, cls, "", state);
        Console.WriteLine($"form {label} bg {b.bg} fg {b.fg} border {b.borderW}/"
                          + $"{b.borderColor} size {b.width},{b.height} pad {b.padL}"
                          + $" shadow {b.shadow} blur {b.shadowBlur} dy {b.shadowDy}");
    }

    static void FormStates() {
        StyleSheet sheet = Program.FormSheet();
        int hover = Style.SHover();
        int chk = Style.SChecked();
        int chkHover = chk + hover;
        // 字段根：状态边框与校验类压过 :hover/:focus。
        Program.Btn(sheet, "input", "", Style.SNormal(), "input");
        Program.Btn(sheet, "input", "", hover, "input-hover");
        Program.Btn(sheet, "input", "", Style.SFocus(), "input-focus");
        Program.Btn(sheet, "input", "", Style.SDisabled(), "input-disabled");
        Program.Btn(sheet, "input", "error", Style.SFocus(), "input-error-focus");
        Program.Btn(sheet, "textarea", "", hover, "textarea-hover");
        Program.Btn(sheet, "select", "", Style.SFocus(), "select-focus");
        Program.Btn(sheet, "select", "success", hover, "select-success-hover");
        // 字段内部 part。
        Program.FormPart(sheet, "input", "placeholder", "", Style.SNormal(), "input::placeholder");
        Program.FormPart(sheet, "input", "selection", "", Style.SNormal(), "input::selection");
        Program.FormPart(sheet, "input", "caret", "", Style.SNormal(), "input::caret");
        Program.FormPart(sheet, "input", "icon", "", Style.SNormal(), "input::icon");
        Program.FormPart(sheet, "input", "icon", "", hover, "input::icon-hover");
        Program.FormPart(sheet, "input", "error", "", Style.SNormal(), "input::error");
        Program.FormPart(sheet, "textarea", "scrollbar", "", Style.SNormal(), "textarea::scrollbar");
        Program.FormPart(sheet, "textarea", "scrollbar-track", "", Style.SNormal(), "textarea::scrollbar-track");
        Program.FormPart(sheet, "select", "arrow", "", Style.SNormal(), "select::arrow");
        Program.FormPart(sheet, "select", "clear", "", hover, "select::clear-hover");
        Program.FormPart(sheet, "select", "checkmark", "", Style.SNormal(), "select::checkmark");
        Program.FormPart(sheet, "select", "popup", "", Style.SSelected(), "select::popup");
        // checkbox：off/on/hover 与角色类，控件按进度 Blend off↔on。
        Program.FormPart(sheet, "checkbox", "box", "", Style.SNormal(), "checkbox::box");
        Program.FormPart(sheet, "checkbox", "box", "", hover, "checkbox::box-hover");
        Program.FormPart(sheet, "checkbox", "box", "", chk, "checkbox::box-checked");
        Program.FormPart(sheet, "checkbox", "box", "", chkHover, "checkbox::box-checked-hover");
        Program.FormPart(sheet, "checkbox", "check", "", chk, "checkbox::check");
        Program.FormPart(sheet, "checkbox", "box", "success", chkHover, "checkbox.success::box-checked-hover");
        // radio / switch / slider 的 part×状态。
        Program.FormPart(sheet, "radio", "indicator", "", Style.SNormal(), "radio::indicator");
        Program.FormPart(sheet, "radio", "indicator", "", chk, "radio::indicator-checked");
        Program.FormPart(sheet, "radio", "dot", "", chk, "radio::dot");
        Program.FormPart(sheet, "radio", "indicator", "error", chk, "radio.error::indicator-checked");
        Program.FormPart(sheet, "radio", "dot", "error", chk, "radio.error::dot");
        Program.FormPart(sheet, "switch", "track", "", Style.SNormal(), "switch::track");
        Program.FormPart(sheet, "switch", "track", "", hover, "switch::track-hover");
        Program.FormPart(sheet, "switch", "track", "", chk, "switch::track-checked");
        Program.FormPart(sheet, "switch", "track", "", chkHover, "switch::track-checked-hover");
        Program.FormPart(sheet, "switch", "thumb", "", Style.SNormal(), "switch::thumb");
        Program.FormPart(sheet, "switch", "track", "warning", chk, "switch.warning::track-checked");
        Program.FormPart(sheet, "slider", "track", "", Style.SNormal(), "slider::track");
        Program.FormPart(sheet, "slider", "fill", "", Style.SNormal(), "slider::fill");
        Program.FormPart(sheet, "slider", "thumb", "", Style.SNormal(), "slider::thumb");
        Program.FormPart(sheet, "slider", "thumb", "", hover, "slider::thumb-hover");
        Program.FormPart(sheet, "slider", "thumb", "", Style.SActive(), "slider::thumb-active");
        Program.FormPart(sheet, "slider", "fill", "success", Style.SNormal(), "slider.success::fill");
        Program.FormPart(sheet, "slider", "thumb", "success", hover, "slider.success::thumb-hover");
        // 控件的实际用法：off/on 两份已解析样式按动画进度 Blend。
        StyleBox off = new StyleBox();
        Style.ApplyPartSheet(sheet, off, "switch", "track", "", "", Style.SNormal());
        StyleBox on = new StyleBox();
        Style.ApplyPartSheet(sheet, on, "switch", "track", "", "", chk);
        StyleBox mid = StyleBox.Blend(off, on, 500);
        Console.WriteLine($"form switch-track-mid bg {mid.bg}");
    }

    /// 列表导航族（A3 批）：镜像 base.css 的 part/state 规则，确保
    /// 颜色由样式层解析后再进入各控件的绘制路径。
    static StyleSheet A3Sheet() {
        string css = "tab::close { color: var(--text-tertiary); }\n"
            + "tab::close:hover { background: var(--bg-active); color: var(--error); }\n"
            + "tabs::add { color: var(--text-secondary); }\n"
            + "tabs::add:hover { background: var(--bg-hover); color: var(--primary); }\n"
            + "tabs::chevron { color: var(--text-secondary); }\n"
            + "tabs::chevron:hover { background: var(--bg-hover); color: var(--text-secondary); }\n"
            + "tabs::divider { background: var(--divider); }\n"
            + "tab::indicator { background: var(--primary); }\n"
            + "listview::empty { color: var(--text-secondary); }\n"
            + "listview::header { background: var(--bg-secondary); }\n"
            + "listview::divider { background: var(--divider); }\n"
            + "listview::column { color: var(--text-tertiary); }\n"
            + "listview::cell { color: var(--text-primary); }\n"
            + "listview::cell.secondary { color: var(--text-secondary); }\n"
            + "listrow:hover { background: var(--bg-secondary); }\n"
            + "listrow:selected { background: var(--bg-tertiary); }\n"
            + "treeview::arrow { color: var(--text-tertiary); }\n"
            + "treeview::count { color: var(--text-tertiary); }\n"
            + "treeview::icon { color: var(--text-secondary); }\n"
            + "treeview::icon.dir { color: var(--primary); }\n"
            + "treeview::label { color: var(--text-primary); }\n"
            + "treeview::label:selected { color: var(--primary); }\n"
            + "treeview::indicator { background: var(--primary); }\n"
            + "treeview::empty { color: var(--text-primary); }\n"
            + "treeview::row:hover { background: var(--bg-hover); }\n"
            + "treeview::row:selected { background: var(--bg-active); }\n"
            + "steps::marker { background: var(--border-primary); color: var(--text-primary); }\n"
            + "steps::marker.done, steps::marker.active { background: var(--primary); color: var(--text-inverse); }\n"
            + "steps::marker.error { background: var(--error); color: var(--text-inverse); }\n"
            + "steps::connector { background: var(--border-primary); }\n"
            + "steps::connector.done, steps::connector.active { background: var(--primary); }\n"
            + "steps::title { color: var(--text-secondary); }\n"
            + "steps::title.active { color: var(--text-primary); }\n"
            + "steps::title.error { color: var(--error); }\n"
            + "steps::description { color: var(--text-tertiary); }\n"
            + "pagination::item { background: var(--bg-primary); color: var(--text-primary); border: 1 var(--border-primary); }\n"
            + "pagination::item:selected { background: var(--primary); color: var(--text-inverse); border-color: var(--primary); }\n"
            + "pagination::item:hover { background: var(--bg-hover); border-color: var(--border-hover); }\n"
            + "pagination::arrow { color: var(--text-primary); }\n"
            + "pagination::arrow:disabled { color: var(--text-disabled); }\n"
            + "pagination::ellipsis { color: var(--text-tertiary); }\n"
            + "pagination::label { color: var(--text-secondary); }\n"
            + "breadcrumb::separator { color: var(--text-tertiary); }\n"
            + "breadcrumb::item { color: var(--text-secondary); }\n"
            + "breadcrumb::item.current { color: var(--text-primary); }\n"
            + "timeline::line { background: var(--divider); }\n"
            + "timeline::dot { background: var(--primary); }\n"
            + "timeline::dot.info { background: var(--info); }\n"
            + "timeline::dot.success { background: var(--success); }\n"
            + "timeline::dot.warning { background: var(--warning); }\n"
            + "timeline::dot.error { background: var(--error); }\n"
            + "timeline::time { color: var(--text-tertiary); }\n"
            + "timeline::title { color: var(--text-primary); }\n"
            + "timeline::desc { color: var(--text-secondary); }\n"
            + "pageheader::back { color: var(--text-secondary); }\n"
            + "pageheader::back:hover { color: var(--primary); }\n"
            + "pageheader::title { color: var(--text-primary); }\n"
            + "pageheader::subtitle { color: var(--text-tertiary); }\n"
            + "table::header { background: var(--bg-secondary); color: var(--text-secondary); }\n"
            + "table::divider { background: var(--divider); }\n"
            + "table::row.striped { background: var(--bg-secondary); }\n"
            + "table::cell { color: var(--text-primary); }\n"
            + "virtuallist { background: var(--bg-primary); border: 1 var(--border-secondary); }\n"
            + "virtuallist::divider { background: var(--divider); }\n"
            + "carousel::slide.primary { background: var(--primary); }\n"
            + "carousel::slide.info { background: var(--info); }\n"
            + "carousel::slide.warning { background: var(--warning); }\n"
            + "carousel::slide.error { background: var(--error); }\n"
            + "carousel::slide.success { background: var(--success); }\n"
            + "carousel::caption { color: var(--text-inverse); }\n"
            + "carousel::arrow { background: var(--overlay); color: var(--text-inverse); }\n"
            + "carousel::dot { background: var(--overlay); }\n"
            + "carousel::dot:selected { background: var(--text-inverse); }\n"
            + "sessionlist::filter { color: var(--text-tertiary); }\n"
            + "sessionlist::filter:hover, sessionlist::filter:selected { color: var(--text-secondary); }\n"
            + "sessionlist::divider { background: var(--divider); }\n"
            + "sessionlist::hint { color: var(--text-tertiary); }\n"
            + "sessionlist::title { color: var(--text-secondary); }\n"
            + "sessionlist::title.current { color: var(--text-primary); }\n"
            + "sessionlist::title.archived { color: var(--text-tertiary); }\n"
            + "sessionlist::action { color: var(--text-tertiary); }\n"
            + "sessionlist::action:hover { color: var(--text-primary); }\n"
            + "docktabs::activity { background: var(--divider); }\n"
            + "docktabs::activity.live { background: var(--primary); }\n"
            + "docktab::label { color: var(--text-tertiary); }\n"
            + "docktab::close { color: var(--text-tertiary); }\n"
            + "docktab::close:hover { background: var(--bg-active); color: var(--text-primary); }\n"
            + "dockgroup::drop { background: var(--drop-tint); border: 2 var(--primary); }\n"
            + "dockgroup::ghost { background: var(--bg-primary); border: 1 var(--primary); color: var(--text-primary); }\n";
        List<string> names = new List<string>();
        List<string> vals = new List<string>();
        Css.CollectVars(Style.RootFromTheme(Theme.Light()), names, vals);
        return Css.ParseWith(css, names, vals);
    }

