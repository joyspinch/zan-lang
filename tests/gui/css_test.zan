    /// 数据密集族（A4 批）：镜像 base.css 的 datatable/chart/designer/hmi
    /// 规则。四族的绘制路径只消费解析后的 StyleBox；条件格式、
    /// 系列色等数据语义色不经过样式层，也不在此钉住。
    static StyleSheet A4Sheet() {
        string css = "datatable { background: var(--bg-primary); color: var(--text-primary); border: 1 var(--border-primary); }\n"
            + "datatable::grid { background: var(--divider); }\n"
            + "datatable::header { background: var(--bg-secondary); color: var(--text-secondary); }\n"
            + "datatable::header:hover { background: var(--bg-hover); }\n"
            + "datatable::icon { color: var(--text-tertiary); }\n"
            + "datatable::icon:selected { color: var(--primary); }\n"
            + "datatable::band { background: var(--bg-tertiary); color: var(--text-secondary); }\n"
            + "datatable::accent { background: var(--primary); color: var(--text-inverse); }\n"
            + "datatable::row { background: var(--bg-primary); color: var(--text-primary); }\n"
            + "datatable::row.striped { background: var(--bg-secondary); }\n"
            + "datatable::row:hover { background: var(--bg-hover); }\n"
            + "datatable::row:selected { background: var(--bg-active); }\n"
            + "datatable::cell { color: var(--text-primary); }\n"
            + "datatable::cell.link { color: var(--primary); }\n"
            + "datatable::mark { color: var(--success); }\n"
            + "datatable::mark.off { color: var(--text-tertiary); }\n"
            + "datatable::progress-track { background: var(--bg-tertiary); }\n"
            + "datatable::progress-fill { background: var(--primary); }\n"
            + "datatable::progress-fill.done { background: var(--success); }\n"
            + "datatable::tag { background: var(--bg-secondary); color: var(--text-secondary); }\n"
            + "datatable::tag.error { color: var(--error); }\n"
            + "datatable::field { background: var(--bg-primary); color: var(--text-primary); border: 1 var(--border-primary); }\n"
            + "datatable::field:focus { border-color: var(--border-focus); }\n"
            + "datatable::editor { background: var(--bg-primary); color: var(--text-primary); border: 2 var(--border-focus); }\n"
            + "datatable::editor.invalid { border-color: var(--error); color: var(--error); }\n"
            + "datatable::button.primary { background: var(--primary); color: var(--text-inverse); }\n"
            + "datatable::button.primary:hover { background: var(--primary-hover); }\n"
            + "chart { background: var(--bg-primary); color: var(--text-primary); border: 1 var(--border-primary); }\n"
            + "chart::legend { color: var(--text-secondary); }\n"
            + "chart::legend.off { color: var(--text-tertiary); background: var(--border-primary); }\n"
            + "chart::grid { background: var(--divider); }\n"
            + "chart::axis { background: var(--border-secondary); color: var(--text-tertiary); }\n"
            + "chart::mark { background: var(--error); color: var(--error); }\n"
            + "chart::zoom-window { background: var(--bg-hover); border: 1 var(--border-hover); }\n"
            + "chart::zoom-handle { background: var(--primary); }\n"
            + "chart::label { color: var(--text-secondary); }\n"
            + "chart::value { color: var(--text-primary); }\n"
            + "chart::tooltip { background: var(--bg-secondary); color: var(--text-secondary); border: 1 var(--border-primary); }\n"
            + "chart::accent { background: var(--primary); }\n"
            + "chart::cell { background: var(--bg-tertiary); border: 1 var(--text-primary); }\n"
            + "designer { background: var(--bg-primary); color: var(--text-primary); border: 1 var(--border-primary); }\n"
            + "designer::accent { background: var(--primary); color: var(--primary); }\n"
            + "designer::accent.warning { background: var(--warning); color: var(--warning); }\n"
            + "designer::badge { color: var(--text-inverse); }\n"
            + "designer::field { background: var(--bg-secondary); color: var(--text-secondary); border: 1 var(--border-secondary); }\n"
            + "designer::panel { background: var(--bg-secondary); color: var(--text-tertiary); border: 1 var(--border-primary); }\n"
            + "designer::panel:active { background: var(--bg-active); }\n"
            + "designer::shadow { background: var(--shadow-color); }\n"
            + "hmi::status { background: var(--info); color: var(--info); }\n"
            + "hmi::status.ok { background: var(--success); color: var(--success); }\n"
            + "hmi::status.warning { background: var(--warning); color: var(--warning); }\n"
            + "hmi::status.error { background: var(--error); color: var(--error); }\n"
            + "hmi::status.off { background: var(--border-secondary); color: var(--text-disabled); }\n"
            + "hmi::accent { background: var(--primary); color: var(--text-inverse); }\n"
            + "hmi::panel { background: var(--bg-secondary); border: 1 var(--border-primary); }\n"
            + "hmi::track { background: var(--bg-tertiary); }\n"
            + "hmi::track:hover { background: var(--bg-hover); }\n";
        List<string> names = new List<string>();
        List<string> vals = new List<string>();
        Css.CollectVars(Style.RootFromTheme(Theme.Light()), names, vals);
        return Css.ParseWith(css, names, vals);
    }

    static void A4States() {
        StyleSheet sheet = Program.A4Sheet();
        int hover = Style.SHover();
        int selected = Style.SSelected();
        int focus = Style.SFocus();
        // 数据网格：表面/表头/行状态/单元格/标记/进度/标签/编辑器。
        Program.Btn(sheet, "datatable", "", Style.SNormal(), "datatable");
        Program.FormPart(sheet, "datatable", "grid", "", Style.SNormal(), "datatable::grid");
        Program.FormPart(sheet, "datatable", "header", "", Style.SNormal(), "datatable::header");
        Program.FormPart(sheet, "datatable", "header", "", hover, "datatable::header-hover");
        Program.FormPart(sheet, "datatable", "icon", "", selected, "datatable::icon-selected");
        Program.FormPart(sheet, "datatable", "accent", "", Style.SNormal(), "datatable::accent");
        Program.FormPart(sheet, "datatable", "row", "striped", Style.SNormal(), "datatable::row-striped");
        Program.FormPart(sheet, "datatable", "row", "", hover, "datatable::row-hover");
        Program.FormPart(sheet, "datatable", "row", "", selected, "datatable::row-selected");
        Program.FormPart(sheet, "datatable", "cell", "link", Style.SNormal(), "datatable::cell-link");
        Program.FormPart(sheet, "datatable", "mark", "", Style.SNormal(), "datatable::mark");
        Program.FormPart(sheet, "datatable", "mark", "off", Style.SNormal(), "datatable::mark-off");
        Program.FormPart(sheet, "datatable", "progress-fill", "done", Style.SNormal(), "datatable::progress-fill-done");
        Program.FormPart(sheet, "datatable", "tag", "error", Style.SNormal(), "datatable::tag-error");
        Program.FormPart(sheet, "datatable", "field", "", focus, "datatable::field-focus");
        Program.FormPart(sheet, "datatable", "editor", "invalid", Style.SNormal(), "datatable::editor-invalid");
        Program.FormPart(sheet, "datatable", "button", "primary", hover, "datatable::button-primary-hover");
        // 图表共享框架：面板/图例/轴网/标记/缩放/标签/单元格底色。
        Program.Btn(sheet, "chart", "", Style.SNormal(), "chart");
        Program.FormPart(sheet, "chart", "legend", "", Style.SNormal(), "chart::legend");
        Program.FormPart(sheet, "chart", "legend", "off", Style.SNormal(), "chart::legend-off");
        Program.FormPart(sheet, "chart", "grid", "", Style.SNormal(), "chart::grid");
        Program.FormPart(sheet, "chart", "axis", "", Style.SNormal(), "chart::axis");
        Program.FormPart(sheet, "chart", "mark", "", Style.SNormal(), "chart::mark");
        Program.FormPart(sheet, "chart", "zoom-window", "", Style.SNormal(), "chart::zoom-window");
        Program.FormPart(sheet, "chart", "zoom-handle", "", Style.SNormal(), "chart::zoom-handle");
        Program.FormPart(sheet, "chart", "label", "", Style.SNormal(), "chart::label");
        Program.FormPart(sheet, "chart", "value", "", Style.SNormal(), "chart::value");
        Program.FormPart(sheet, "chart", "tooltip", "", Style.SNormal(), "chart::tooltip");
        Program.FormPart(sheet, "chart", "accent", "", Style.SNormal(), "chart::accent");
        Program.FormPart(sheet, "chart", "cell", "", Style.SNormal(), "chart::cell");
        // 表单设计器：画布面/强调/拖拽浮标/属性面板。
        Program.Btn(sheet, "designer", "", Style.SNormal(), "designer");
        Program.FormPart(sheet, "designer", "accent", "", Style.SNormal(), "designer::accent");
        Program.FormPart(sheet, "designer", "accent", "warning", Style.SNormal(), "designer::accent-warning");
        Program.FormPart(sheet, "designer", "badge", "", Style.SNormal(), "designer::badge");
        Program.FormPart(sheet, "designer", "field", "", Style.SNormal(), "designer::field");
        Program.FormPart(sheet, "designer", "panel", "", Style.SNormal(), "designer::panel");
        Program.FormPart(sheet, "designer", "panel", "", Style.SActive(), "designer::panel-active");
        Program.FormPart(sheet, "designer", "shadow", "", Style.SNormal(), "designer::shadow");
        // HMI：状态色族/主色面/面板/滑轨。
        Program.FormPart(sheet, "hmi", "status", "", Style.SNormal(), "hmi::status");
        Program.FormPart(sheet, "hmi", "status", "ok", Style.SNormal(), "hmi::status-ok");
        Program.FormPart(sheet, "hmi", "status", "warning", Style.SNormal(), "hmi::status-warning");
        Program.FormPart(sheet, "hmi", "status", "error", Style.SNormal(), "hmi::status-error");
        Program.FormPart(sheet, "hmi", "status", "off", Style.SNormal(), "hmi::status-off");
        Program.FormPart(sheet, "hmi", "accent", "", Style.SNormal(), "hmi::accent");
        Program.FormPart(sheet, "hmi", "panel", "", Style.SNormal(), "hmi::panel");
        Program.FormPart(sheet, "hmi", "track", "", Style.SNormal(), "hmi::track");
        Program.FormPart(sheet, "hmi", "track", "", hover, "hmi::track-hover");
    }

    /// A5 第一阶段：弹窗、富菜单与外观抽屉的 part/state 规则。
    static StyleSheet A5Sheet() {
        string css = "popup::scrollbar { background: var(--scrollbar); width: 5; }\n"
            + "contextmenu::header { color: var(--text-tertiary); }\n"
            + "contextmenu::item:disabled { color: var(--text-tertiary); }\n"
            + "themedrawer { background: var(--surface-bg); border-left: 1 var(--border-primary); }\n"
            + "themedrawer::edge { background: var(--drawer-edge-shadow); }\n"
            + "themedrawer::title { color: var(--text-primary); }\n"
            + "themedrawer::close { background: var(--bg-secondary); color: var(--text-secondary); }\n"
            + "themedrawer::close:hover { background: var(--bg-hover); color: var(--text-secondary); }\n"
            + "themedrawer::seg { background: var(--bg-secondary); }\n"
            + "themedrawer::seg-item { color: var(--text-secondary); }\n"
            + "themedrawer::seg-item:hover { background: var(--bg-hover); }\n"
            + "themedrawer::seg-item:selected { background: var(--bg-primary); border: 1 var(--primary); color: var(--primary); }\n"
            + "themedrawer::section { color: var(--text-secondary); }\n"
            + "themedrawer::rule { background: var(--border-primary); }\n"
            + "themedrawer::card { background: transparent; border: 1 var(--border-primary); }\n"
            + "themedrawer::card:hover { border-color: var(--border-hover); }\n"
            + "themedrawer::card:selected { border: 2 var(--primary); }\n"
            + "themedrawer::swatch { border: 1 var(--border-primary); }\n"
            + "themedrawer::swatch:hover { border-color: var(--border-hover); }\n"
            + "themedrawer::swatch:selected { border: 2 var(--primary); }\n"
            + "themedrawer::swatch.default { background: var(--bg-active); }\n"
            + "themedrawer::swatch-check { color: var(--text-inverse); }\n"
            + "themedrawer::chip { background: var(--bg-secondary); border: 1 var(--border-primary); color: var(--text-secondary); }\n"
            + "themedrawer::chip:hover { background: var(--bg-hover); border-color: var(--border-hover); }\n"
            + "themedrawer::chip:selected { background: var(--bg-active); border-color: var(--primary); color: var(--primary); }\n"
            + "themedrawer::chip:disabled { color: var(--text-disabled); }\n"
            + "themedrawer::field { background: var(--bg-secondary); border: 1 var(--border-primary); color: var(--text-secondary); }\n"
            + "themedrawer::field:hover { background: var(--bg-hover); }\n"
            + "themedrawer::field:disabled { color: var(--text-disabled); }\n"
            + "themedrawer::row:hover { background: var(--bg-hover); }\n"
            + "themedrawer::label { color: var(--text-primary); }\n"
            + "themedrawer::radio { border: 1 var(--border-secondary); }\n"
            + "themedrawer::radio:selected { background: var(--primary); border: 2 var(--primary); color: var(--primary); }\n"
            + "themedrawer::switch { background: var(--bg-active); }\n"
            + "themedrawer::switch:selected { background: var(--primary); }\n"
            + "themedrawer::knob { background: var(--on-scrim); }\n"
            + "titlebar { background: var(--bg-secondary); color: var(--text-primary); border-bottom: 1 var(--divider); }\n"
            + "titlebar::brand { color: var(--primary); }\n"
            + "titlebar::title { color: var(--text-primary); }\n"
            + "titlebar::glass { background: var(--titlebar-glass-bg); }\n"
            + "titlebar::sheen { background: var(--titlebar-glass-sheen); }\n"
            + "titlebar::cap { color: var(--text-secondary); }\n"
            + "titlebar::cap:hover { background: var(--bg-hover); color: var(--text-primary); }\n"
            + "titlebar::cap:selected { color: var(--primary); }\n"
            + "titlebar::cap.danger:hover { background: var(--caption-close-bg); color: var(--on-scrim); }\n"
            + "titlebar::edge { background: var(--window-glass-edge); }\n"
            + "titlebar::edge-highlight { background: var(--window-glass-highlight); }\n"
            + "windowbg { background: var(--bg-primary); }\n"
            + "windowbg::sheen { background: var(--window-glass-sheen); }\n"
            + "windowbg::glass { background: var(--window-glass-clear); }\n"
            + "windowbg::fade { background: var(--bg-primary); }\n"
            + "windowbg::blob { background: var(--primary); }\n"
            + "windowbg::blob.info { background: var(--info); }\n"
            + "windowbg::blob.success { background: var(--success); }\n"
            + "windowbg::blob.error { background: var(--error); }\n"
            + "windowbg::shape { background: var(--bg-primary); }\n"
            + "windowbg::shape-shadow { background: var(--shadow-color); }\n";
        List<string> names = new List<string>();
        List<string> vals = new List<string>();
        Css.CollectVars(Style.RootFromTheme(Theme.Light()), names, vals);
        return Css.ParseWith(css, names, vals);
    }

