using System;
using Gui;

namespace CssTest;

/// Headless verification of the CSS skin pipeline: Css.Parse (comments,
/// selector lists, :root variables, state suffixes) plus StyleSheet.ApplyBox
/// (colors, gradients, borders, radii, spacing, typography, motion). Prints
/// the resolved StyleBox fields so the parsing math can be diffed against a
/// golden file - no window, no driver.
class Program {
    static StyleSheet Sheet() {
        string css = "/* skin */\n"
            + ":root { --accent: #d92b2b; --radius: 12; }\n"
            + "button, tab.item { background: #202430; color: #e8e8f0;\n"
            + "                   padding: 6 14; radius: var(--radius);\n"
            + "                   border: 2 var(--accent); font-size: 15; }\n"
            + "button.primary { background: linear-gradient(to right, #ffd76a, #e0a020);\n"
            + "                 color: rgb(20, 22, 30); font-weight: bold;\n"
            + "                 box-shadow: 0 4 12 rgba(0, 0, 0, 0.5);\n"
            + "                 transition: 180ms ease-in-out; }\n"
            + "button.primary:hover { background: #ffe08a; opacity: 0.8; }\n"
            + "button.primary:disabled { background: hsl(220, 10%, 30%); }\n"
            + "card { background: transparent; radius: 8 8 20 20;\n"
            + "       border-bottom: 3 navy; margin: 4 8 12 16;\n"
            + "       backdrop-filter: blur(18px); animation: pulse 900ms; }\n"
            + "input:focus { border: 1 #3b82f6; letter-spacing: 2;\n"
            + "              text-align: center; text-overflow: ellipsis; }\n"
            + "option { gap: 7; }\n"
            + "::option { padding-left: 3; }\n"
            + "select::option { padding-right: 4; }\n"
            + ".primary::option { padding-top: 5; }\n"
            + "select.primary::option { padding-bottom: 6; }\n"
            + "#city::option { width: 70; }\n"
            + "select.primary::option:hover { height: 31; }\n"
            + "#city::option:selected { min-width: 80; }\n"
            + "checkbox::box { width: 18; padding-left: 2; }\n"
            + "checkbox::box:hover { height: 19; border: 2 #15803d; }\n"
            + "checkbox::box:checked { background: #16a34a; padding-left: 6; }\n"
            + "slider::track { height: 5; background: #202020; }\n"
            + "slider::fill { height: 3; background: #2563eb; }\n"
            + "slider::thumb { width: 20; height: 20; border: 3 #1d4ed8; }\n"
            + ".success::fill { background: #22c55e; }\n"
            + "progress.success::fill { height: 7; }\n"
            + "progress::label { color: #475569; font-size: 13; }\n";
        return Css.Parse(css);
    }

    static void Box(StyleSheet sheet, string selector) {
        StyleBox b = new StyleBox();
        sheet.ApplyBox(b, selector);
        Console.WriteLine($"--- {selector}");
        Console.WriteLine($"bg {b.bg} to {b.bgTo} dir {b.bgDir} opacity {b.opacity} blur {b.blur}");
        Console.WriteLine($"fg {b.fg} font {b.fontPx} weight {b.fontWeight} align {b.align} spacing {b.letterSpacing} ellipsis {b.ellipsis}");
        Console.WriteLine($"border {b.borderW}/{b.borderColor} bottom {b.borderBottomW}/{b.borderBottomColor}");
        Console.WriteLine($"radius {b.radius} corners {b.radiusTL},{b.radiusTR},{b.radiusBR},{b.radiusBL}");
        Console.WriteLine($"pad {b.padL},{b.padT},{b.padR},{b.padB} margin {b.marL},{b.marT},{b.marR},{b.marB}");
        Console.WriteLine($"shadow {b.shadow} {b.shadowDx},{b.shadowDy} blur {b.shadowBlur} inset {b.shadowInset}");
        Console.WriteLine($"motion {b.transitionMs}ms easing {b.easing} anim {b.anim} {b.animMs}ms");
    }

    static void Part(StyleSheet sheet, int state, string label) {
        StyleBox b = new StyleBox();
        Style.ApplySheet(sheet, b, "option", "primary", "", state);
        Style.ApplyPartSheet(sheet, b, "select", "option", "primary", "city", state);
        Console.WriteLine($"part {label} pad {b.padL},{b.padT},{b.padR},{b.padB} size {b.width},{b.height} min {b.minW} gap {b.gap}");
    }

    static void CheckedPart(StyleSheet sheet, int state, string label) {
        StyleBox b = new StyleBox();
        Style.ApplyPartSheet(sheet, b, "checkbox", "box", "", "", state);
        Console.WriteLine($"checked {label} bg {b.bg} size {b.width},{b.height} pad {b.padL} border {b.borderW}/{b.borderColor}");
    }

    static void RangePart(StyleSheet sheet, string type, string part, string cls) {
        StyleBox b = new StyleBox();
        Style.ApplyPartSheet(sheet, b, type, part, cls, "", Style.SNormal());
        Console.WriteLine($"range {type}.{cls}::{part} bg {b.bg} fg {b.fg} size {b.width},{b.height} font {b.fontPx} border {b.borderW}/{b.borderColor}");
    }

    /// 应用 CSS 通过 ParseWith 认得外部（主题/皮肤）的 :root 变量：
    /// 外部变量参与 var() 展开但不进结果表的 vars；同名时这份 CSS
    /// 自己声明的值胜出。
    static void ExternalVars() {
        List<string> names = new List<string>();
        List<string> vals = new List<string>();
        Css.CollectVars(":root { --text-primary: #101828; --accent: #2563eb;\n"
                        + "        --card-blur: 18; }\n", names, vals);
        string css = ":root { --accent: #d92b2b; }\n"
            + "label { color: var(--text-primary); }\n"
            + "button { background: var(--accent); }\n"
            + "card { backdrop-filter: blur(var(--card-blur)px); }\n"
            + "panel { color: var(--nope); background: #111111; }\n";
        StyleSheet sheet = Css.ParseWith(css, names, vals);
        Console.WriteLine($"theme var seen {names.Count} own accent "
                          + sheet.Var("--accent"));
        string leaked = sheet.Var("--text-primary");
        Console.WriteLine($"leaked text-primary [{leaked}]");
        Program.Box(sheet, "label");
        Program.Box(sheet, "button");
        Program.Box(sheet, "card");
        Program.Box(sheet, "panel");
        StyleSheet plain = Css.Parse(css);
        StyleBox pb = new StyleBox();
        plain.ApplyBox(pb, "label");
        Console.WriteLine($"without theme vars fg {pb.fg}");
    }

    /// 渐变方向：关键字与角度都要落到光栅化支持的四向
    /// （0 下、1 右、2 右下、3 上、4 左下），角度吸附到最近的一向。
    static void GradDirs() {
        string css = "a { background: linear-gradient(to bottom, #111111, #222222); }\n"
            + "b { background: linear-gradient(to right, #111111, #222222); }\n"
            + "c { background: linear-gradient(to bottom right, #111111, #222222); }\n"
            + "d { background: linear-gradient(to top, #111111, #222222); }\n"
            + "e { background: linear-gradient(to bottom left, #111111, #222222); }\n"
            + "f { background: linear-gradient(135deg, #111111, #222222); }\n"
            + "g { background: linear-gradient(210deg, #111111, #222222); }\n"
            + "h { background: linear-gradient(#111111, #333333, #222222); }\n"
            + "i { background: linear-gradient(225deg, rgba(255,43,43,0.85),"
            + " rgba(43,107,255,0.35)); }\n";
        StyleSheet sheet = Css.Parse(css);
        List<string> sels = new List<string>();
        sels.Add("a"); sels.Add("b"); sels.Add("c"); sels.Add("d");
        sels.Add("e"); sels.Add("f"); sels.Add("g"); sels.Add("h");
        sels.Add("i");
        for (int i = 0; i < sels.Count; i = i + 1) {
            StyleBox b = new StyleBox();
            sheet.ApplyBox(b, sels[i]);
            Console.WriteLine($"grad {sels[i]} dir {b.bgDir} bg {b.bg} via {b.bgVia} to {b.bgTo}");
        }
    }

    /// 主题导出的按钮/tab token（Style.RootFromTheme）：按钮的角色色、
    /// ghost/secondary 混色与禁用形状都从这里取值，base.css 只消费
    /// token。名字或算法改了这里就会变，因此金标里钉住它们。
    static void ThemeTokens() {
        StyleSheet sheet = Css.Parse(Style.RootFromTheme(Theme.Light()));
        List<string> names = new List<string>();
        names.Add("--primary"); names.Add("--primary-hover");
        names.Add("--primary-pressed"); names.Add("--error-hover");
        names.Add("--neutral-ghost-hover-bg");
        names.Add("--neutral-ghost-active-bg");
        names.Add("--neutral-soft-bg"); names.Add("--neutral-soft-hover-bg");
        names.Add("--neutral-soft-active-bg");
        names.Add("--primary-soft-bg"); names.Add("--primary-ghost-active-bg");
        names.Add("--disabled-bg"); names.Add("--disabled-border");
        names.Add("--disabled-fg");
        for (int i = 0; i < names.Count; i = i + 1) {
            Console.WriteLine($"token {names[i]} {sheet.Var(names[i])}");
        }
    }

    /// 按钮的角色 × 变体 × 状态：颜色规则已从 Style.ButtonDefaults
    /// 迁到 CSS，所以这里按 base.css 的写法验证级联结果——伪状态
    /// 压过类、同权重按出现顺序、`border: 0 <色>` 清掉单边。
    static StyleSheet ButtonSheet() {
        string css = "button { background: var(--bg-primary); color: var(--text-primary);\n"
            + "         border: 1 var(--border-primary); }\n"
            + "button:hover { background: var(--bg-hover); border-color: var(--border-hover); }\n"
            + "button:active { background: var(--bg-active); border-color: var(--border-hover); }\n"
            + "button:focus { border-color: var(--border-focus); }\n"
            + "button.primary { background: var(--primary); color: var(--text-inverse);\n"
            + "                 border: 0 var(--primary); }\n"
            + "button.primary:hover { background: var(--primary-hover);\n"
            + "                       border-color: var(--primary-hover); }\n"
            + "button.primary:active { background: var(--primary-pressed);\n"
            + "                        border-color: var(--primary-pressed); }\n"
            + "button.ghost { background: transparent; color: var(--text-primary);\n"
            + "               border: 1 var(--text-primary); }\n"
            + "button.ghost:hover { background: var(--neutral-ghost-hover-bg);\n"
            + "                     border-color: var(--text-primary); }\n"
            + "button.ghost.primary { color: var(--primary); border-color: var(--primary); }\n"
            + "button.ghost.primary:hover { background: var(--primary-ghost-hover-bg);\n"
            + "                             border-color: var(--primary); }\n"
            + "button.secondary { background: var(--neutral-soft-bg);\n"
            + "                   color: var(--text-primary); border-width: 0; }\n"
            + "button.secondary.error { background: var(--error-soft-bg); color: var(--error); }\n"
            + "button.secondary.error:hover { background: var(--error-soft-hover-bg); }\n"
            + "button.text { background: transparent; color: var(--text-primary);\n"
            + "              border-width: 0; }\n"
            + "button.text:hover { background: var(--bg-hover); }\n"
            + "button.text:selected { color: var(--primary); }\n"
            + "button.text:selected:hover { color: var(--primary-hover); }\n"
            + "button.outline { background: var(--bg-primary); color: var(--text-primary);\n"
            + "                 border: 1 var(--text-primary); }\n"
            + "button.outline.error { color: var(--error); border: 1 var(--error); }\n"
            + "button:disabled { background: var(--disabled-bg);\n"
            + "                  color: var(--disabled-fg);\n"
            + "                  border: 1 var(--disabled-border); }\n"
            + "floatbutton { border-radius: 9999; }\n";
        List<string> names = new List<string>();
        List<string> vals = new List<string>();
        Css.CollectVars(Style.RootFromTheme(Theme.Light()), names, vals);
        return Css.ParseWith(css, names, vals);
    }

    static void Btn(StyleSheet sheet, string type, string cls, int state,
                    string label) {
        StyleBox b = new StyleBox();
        Style.ApplySheet(sheet, b, type, cls, "", state);
        Console.WriteLine($"btn {label} bg {b.bg} fg {b.fg} border {b.borderW}/"
                          + $"{b.borderColor} bottom {b.borderBottomW} radius {b.radius}");
    }

    static void ButtonStates() {
        StyleSheet sheet = Program.ButtonSheet();
        int hover = Style.SHover();
        int press = Style.SHover() + Style.SActive();
        Program.Btn(sheet, "button", "", Style.SNormal(), "base");
        Program.Btn(sheet, "button", "", hover, "hover");
        Program.Btn(sheet, "button", "", Style.SFocus(), "focus");
        Program.Btn(sheet, "button", "primary", Style.SNormal(), "primary");
        Program.Btn(sheet, "button", "primary", hover, "primary-hover");
        Program.Btn(sheet, "button", "primary", press, "primary-press");
        Program.Btn(sheet, "button", "ghost", hover, "ghost-hover");
        Program.Btn(sheet, "button", "ghost primary", hover, "ghost-primary-hover");
        Program.Btn(sheet, "button", "secondary", Style.SNormal(), "secondary");
        Program.Btn(sheet, "button", "secondary error", hover, "secondary-error-hover");
        Program.Btn(sheet, "button", "text", Style.SSelected(), "text-selected");
        Program.Btn(sheet, "button", "text", Style.SSelected() + hover,
                    "text-selected-hover");
        Program.Btn(sheet, "button", "outline error", Style.SNormal(), "outline-error");
        Program.Btn(sheet, "button", "primary", Style.SDisabled(), "primary-disabled");
        // 浮动按钮借用整套 button 规则（Style.SheetAlias），同时保留
        // 自己的 `floatbutton` 声明——皮肤不必把按钮规则复制一遍。
        Program.Btn(sheet, "floatbutton", "primary", hover, "float-primary-hover");
    }

    /// 组合伪类（`:selected:hover`）与未知伪类：状态个数计入特异性，
    /// 因此“选中且悬停”的规则压过只写 `.cls:selected` 的规则；
    /// 引擎不认识的伪类永不匹配，而不是退化成无状态规则。
    static void MultiState() {
        string css = "row:selected { color: #111111; }\n"
            + "row.pinned:selected { color: #222222; }\n"
            + "row:selected:hover { color: #333333; }\n"
            + "row:nope { color: #444444; }\n"
            + "row:checked:disabled { color: #555555; }\n";
        StyleSheet sheet = Css.Parse(css);
        int sel = Style.SSelected();
        int selHover = Style.SSelected() + Style.SHover();
        Program.Btn(sheet, "row", "pinned", sel, "sel");
        Program.Btn(sheet, "row", "pinned", selHover, "sel-hover");
        Program.Btn(sheet, "row", "", Style.SChecked(), "checked-only");
        Program.Btn(sheet, "row", "", Style.SChecked() + Style.SDisabled(),
                    "checked-disabled");
    }

    /// 单个 tab 的三种条状变体：颜色全在 CSS 里，选中的卡片式
    /// tab 用 `border` 简写清掉基础规则的下划线。
    static void TabStates() {
        string css = "tab { background: transparent; color: var(--text-secondary); }\n"
            + "tab.card { background: var(--bg-secondary); }\n"
            + "tab:hover { background: var(--bg-hover); color: var(--text-primary); }\n"
            + "tab:selected { background: transparent; color: var(--primary);\n"
            + "               border-bottom: 2 var(--primary); }\n"
            + "tab.card:selected { background: var(--bg-primary); color: var(--primary);\n"
            + "                    border: 1 var(--border-primary); }\n"
            + "tab:disabled { color: var(--text-disabled); }\n";
        List<string> names = new List<string>();
        List<string> vals = new List<string>();
        Css.CollectVars(Style.RootFromTheme(Theme.Light()), names, vals);
        StyleSheet sheet = Css.ParseWith(css, names, vals);
        Program.Btn(sheet, "tab", "", Style.SNormal(), "tab");
        Program.Btn(sheet, "tab", "", Style.SHover(), "tab-hover");
        Program.Btn(sheet, "tab", "", Style.SSelected(), "tab-selected");
        Program.Btn(sheet, "tab", "", Style.SSelected() + Style.SHover(),
                    "tab-selected-hover");
        Program.Btn(sheet, "tab", "card", Style.SNormal(), "card");
        Program.Btn(sheet, "tab", "card", Style.SSelected(), "card-selected");
        Program.Btn(sheet, "tab", "", Style.SDisabled(), "tab-disabled");
    }

    static void Main() {
        StyleSheet sheet = Program.Sheet();
        string accent = sheet.Var("--accent");
        string radius = sheet.Var("--radius");
        Console.WriteLine($"empty {sheet.IsEmpty()}");
        Console.WriteLine($"var accent {accent} radius {radius}");
        Program.Box(sheet, "button");
        Program.Box(sheet, "tab.item");
        Program.Box(sheet, "button.primary");
        Program.Box(sheet, "button.primary:hover");
        Program.Box(sheet, "button.primary:disabled");
        Program.Box(sheet, "card");
        Program.Box(sheet, "input:focus");

        Console.WriteLine("--- blend");
        StyleBox from = new StyleBox();
        sheet.ApplyBox(from, "button.primary");
        StyleBox to = new StyleBox();
        sheet.ApplyBox(to, "button.primary:hover");
        StyleBox mid = StyleBox.Blend(from, to, 500);
        Console.WriteLine($"mid bg {mid.bg} opacity {mid.opacity}");

        Console.WriteLine("--- parts");
        Program.Part(sheet, Style.SNormal(), "base");
        Program.Part(sheet, Style.SHover(), "hover");
        Program.Part(sheet, Style.SSelected(), "selected");

        Console.WriteLine("--- checked parts");
        Program.CheckedPart(sheet, Style.SNormal(), "base");
        Program.CheckedPart(sheet, Style.SHover(), "hover");
        Program.CheckedPart(sheet, Style.SChecked(), "checked");
        int checkedHover = Style.SChecked() + Style.SHover();
        Program.CheckedPart(sheet, checkedHover, "checked-hover");
        StyleBox checkedOff = new StyleBox();
        Style.ApplyPartSheet(sheet, checkedOff, "checkbox", "box", "", "",
                             Style.SNormal());
        StyleBox checkedOn = new StyleBox();
        Style.ApplyPartSheet(sheet, checkedOn, "checkbox", "box", "", "",
                             Style.SChecked());
        StyleBox checkedMid = StyleBox.Blend(checkedOff, checkedOn, 500);
        Console.WriteLine($"checked mid pad {checkedMid.padL}");

        Console.WriteLine("--- external vars");
        Program.ExternalVars();

        Console.WriteLine("--- range parts");
        Program.RangePart(sheet, "slider", "track", "");
        Program.RangePart(sheet, "slider", "fill", "");
        Program.RangePart(sheet, "slider", "thumb", "");
        Program.RangePart(sheet, "progress", "fill", "success");
        Program.RangePart(sheet, "progress", "label", "");

        Console.WriteLine("--- gradient dirs");
        Program.GradDirs();

        Console.WriteLine("--- theme tokens");
        Program.ThemeTokens();

        Console.WriteLine("--- button states");
        Program.ButtonStates();

        Console.WriteLine("--- multi state");
        Program.MultiState();

        Console.WriteLine("--- tab states");
        Program.TabStates();
    }
}
