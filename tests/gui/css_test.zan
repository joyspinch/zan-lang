    /// 容器浮层族（A2 批）：镜像 base.css 的 layer/dialog/toast/
    /// notification/popconfirm/photos/popover/tooltip/contextmenu/menu/
    /// scrollbar/splitter/collapse/panel/card 规则。浮层控件只消费
    /// 解析后的 StyleBox，所以这里钉住的就是它们最终画出的颜色。
    static StyleSheet OverlaySheet() {
        string css = "layer { background: var(--bg-primary); color: var(--text-primary);\n"
            + "  border: 1 var(--border-secondary); }\n"
            + "layer::titlebar { background: var(--bg-secondary);\n"
            + "  color: var(--text-primary); accent-color: var(--primary);\n"
            + "  border-bottom: 2 var(--primary); }\n"
            + "layer::cap { color: var(--text-secondary); }\n"
            + "layer::cap:hover { background: var(--bg-hover); color: var(--text-primary); }\n"
            + "layer.danger::cap:hover { background: var(--error); color: var(--on-scrim); }\n"
            + "layer::footer { background: var(--divider); }\n"
            + "layer::mask { background: var(--overlay); }\n"
            + "dialog::overlay { background: var(--overlay); }\n"
            + "dialog::surface { background: var(--bg-primary);\n"
            + "  box-shadow: 2 3 0 var(--shadow-color); }\n"
            + "dialog::icon { color: var(--info); }\n"
            + "dialog.error::icon { color: var(--error); }\n"
            + "dialog::close { color: var(--text-secondary); }\n"
            + "dialog::close:hover { background: var(--bg-hover); }\n"
            + "toast, notification { background: var(--bg-primary);\n"
            + "  color: var(--text-primary); border: 1 var(--border-secondary); }\n"
            + "toast::icon { color: var(--text-secondary); }\n"
            + "toast.success::icon { color: var(--success); }\n"
            + "notification::bar { background: var(--primary); width: 3; }\n"
            + "notification.warning::bar { background: var(--warning); }\n"
            + "popconfirm { background: var(--bg-primary); color: var(--text-primary);\n"
            + "  border: 1 var(--border-secondary); box-shadow: 1 2 0 var(--shadow-color); }\n"
            + "popconfirm::icon { color: var(--warning); }\n"
            + "photos { background: var(--scrim); color: var(--on-scrim); }\n"
            + "photos::chip { background: var(--scrim-chip); color: var(--on-scrim); }\n"
            + "photos::chip:hover { background: var(--scrim-chip-hover); }\n"
            + "popover { background: var(--bg-primary); color: var(--text-primary);\n"
            + "  border: 1 var(--border-secondary); box-shadow: 1 2 0 var(--shadow-color); }\n"
            + "popover::title { color: var(--text-primary); }\n"
            + "popover::body { color: var(--text-secondary); }\n"
            + "tooltip { background: var(--tooltip-bg); color: var(--tooltip-text);\n"
            + "  border: 1 var(--tooltip-border); border-radius: 3;\n"
            + "  box-shadow: 1 3 0 var(--shadow-color); }\n"
            + "tooltip::title { color: var(--on-scrim); }\n"
            + "tooltip::desc { color: var(--tooltip-text-muted); }\n"
            + "tooltip::scrollbar { background: var(--scrim-chip-hover); }\n"
            + "tooltip::scrollbar-track { background: var(--scrim-chip); }\n"
            + "contextmenu { background: var(--bg-secondary); color: var(--text-primary);\n"
            + "  border: 1 var(--border-secondary); box-shadow: 2 2 0 var(--shadow-color); }\n"
            + "contextmenu::item { color: var(--text-primary); }\n"
            + "contextmenu::item:hover { background: var(--bg-hover); }\n"
            + "contextmenu::accel { color: var(--text-tertiary); }\n"
            + "contextmenu::separator { background: var(--divider); }\n"
            + "menu::item { color: var(--text-secondary); }\n"
            + "menu::item:hover { background: var(--bg-hover); color: var(--text-primary); }\n"
            + "menu::item:selected { background: var(--bg-active); color: var(--primary);\n"
            + "  accent-color: var(--primary); }\n"
            + "prompt { background: var(--bg-secondary); color: var(--text-primary);\n"
            + "  border: 1 var(--border-primary); box-shadow: none; }\n"
            + "prompt::caption { color: var(--text-tertiary); }\n"
            + "prompt::field { background: var(--bg-primary); color: var(--text-primary);\n"
            + "  border: 1 var(--border-primary); }\n"
            + "scrollbar { background: var(--bg-tertiary); border-width: 0; }\n"
            + "scrollbar::thumb { background: var(--scrollbar); }\n"
            + "scrollbar::thumb:hover, scrollbar::thumb:active {\n"
            + "  background: var(--scrollbar-hover); }\n"
            + "splitter { background: var(--divider); border-width: 0; }\n"
            + "splitter:hover, splitter:active { background: var(--primary); }\n"
            + "collapse::header { background: var(--bg-primary); color: var(--text-primary); }\n"
            + "collapse::header:hover { background: var(--bg-hover); }\n"
            + "collapse::arrow { color: var(--text-secondary); }\n"
            + "collapse::body { background: var(--bg-secondary); color: var(--text-secondary); }\n"
            + "collapse::divider { background: var(--divider); }\n"
            + "panel::title { color: var(--text-primary); }\n"
            + "panel::divider { background: var(--divider); }\n"
            + "card::title { color: var(--text-primary); }\n"
            + "card::divider { background: var(--divider); }\n";
        List<string> names = new List<string>();
        List<string> vals = new List<string>();
        Css.CollectVars(Style.RootFromTheme(Theme.Light()), names, vals);
        return Css.ParseWith(css, names, vals);
    }

    static void OverlayStates() {
        StyleSheet sheet = Program.OverlaySheet();
        int hover = Style.SHover();
        // 窗口面 / 标题栏 / 标题栏小按钮（含 danger 类）/ 遮罩。
        Program.Btn(sheet, "layer", "", Style.SNormal(), "layer");
        Program.FormPart(sheet, "layer", "titlebar", "", Style.SNormal(), "layer::titlebar");
        Program.FormPart(sheet, "layer", "cap", "", Style.SNormal(), "layer::cap");
        Program.FormPart(sheet, "layer", "cap", "", hover, "layer::cap-hover");
        Program.FormPart(sheet, "layer", "cap", "danger", hover, "layer.danger::cap-hover");
        Program.FormPart(sheet, "layer", "footer", "", Style.SNormal(), "layer::footer");
        Program.FormPart(sheet, "layer", "mask", "", Style.SNormal(), "layer::mask");
        // 模态对话框：遮罩/面板/角色图标/关闭钮。
        Program.FormPart(sheet, "dialog", "overlay", "", Style.SNormal(), "dialog::overlay");
        Program.FormPart(sheet, "dialog", "surface", "", Style.SNormal(), "dialog::surface");
        Program.FormPart(sheet, "dialog", "icon", "", Style.SNormal(), "dialog::icon");
        Program.FormPart(sheet, "dialog", "icon", "error", Style.SNormal(), "dialog.error::icon");
        Program.FormPart(sheet, "dialog", "close", "", hover, "dialog::close-hover");
        // toast / 通知：角色类只重着色图标/侧边条。
        Program.Btn(sheet, "toast", "", Style.SNormal(), "toast");
        Program.FormPart(sheet, "toast", "icon", "success", Style.SNormal(), "toast.success::icon");
        Program.FormPart(sheet, "notification", "bar", "", Style.SNormal(), "notification::bar");
        Program.FormPart(sheet, "notification", "bar", "warning", Style.SNormal(), "notification.warning::bar");
        // popconfirm / photos / popover / tooltip。
        Program.Btn(sheet, "popconfirm", "", Style.SNormal(), "popconfirm");
        Program.FormPart(sheet, "popconfirm", "icon", "", Style.SNormal(), "popconfirm::icon");
        Program.Btn(sheet, "photos", "", Style.SNormal(), "photos");
        Program.FormPart(sheet, "photos", "chip", "", Style.SNormal(), "photos::chip");
        Program.FormPart(sheet, "photos", "chip", "", hover, "photos::chip-hover");
        Program.Btn(sheet, "popover", "", Style.SNormal(), "popover");
        Program.FormPart(sheet, "popover", "title", "", Style.SNormal(), "popover::title");
        Program.FormPart(sheet, "popover", "body", "", Style.SNormal(), "popover::body");
        Program.Btn(sheet, "tooltip", "", Style.SNormal(), "tooltip");
        Program.FormPart(sheet, "tooltip", "title", "", Style.SNormal(), "tooltip::title");
        Program.FormPart(sheet, "tooltip", "desc", "", Style.SNormal(), "tooltip::desc");
        Program.FormPart(sheet, "tooltip", "scrollbar", "", Style.SNormal(), "tooltip::scrollbar");
        Program.FormPart(sheet, "tooltip", "scrollbar-track", "", Style.SNormal(), "tooltip::scrollbar-track");
        // 右键菜单 / 导航菜单 / prompt。
        Program.Btn(sheet, "contextmenu", "", Style.SNormal(), "contextmenu");
        Program.FormPart(sheet, "contextmenu", "item", "", hover, "contextmenu::item-hover");
        Program.FormPart(sheet, "contextmenu", "accel", "", Style.SNormal(), "contextmenu::accel");
        Program.FormPart(sheet, "contextmenu", "separator", "", Style.SNormal(), "contextmenu::separator");
        Program.FormPart(sheet, "menu", "item", "", Style.SNormal(), "menu::item");
        Program.FormPart(sheet, "menu", "item", "", hover, "menu::item-hover");
        Program.FormPart(sheet, "menu", "item", "", Style.SSelected(), "menu::item-selected");
        Program.Btn(sheet, "prompt", "", Style.SNormal(), "prompt");
        Program.FormPart(sheet, "prompt", "caption", "", Style.SNormal(), "prompt::caption");
        Program.FormPart(sheet, "prompt", "field", "", Style.SNormal(), "prompt::field");
        // 滚动条 / 分栏拖条：悬停与拖动共用 hover/active 规则。
        Program.Btn(sheet, "scrollbar", "", Style.SNormal(), "scrollbar");
        Program.FormPart(sheet, "scrollbar", "thumb", "", Style.SNormal(), "scrollbar::thumb");
        Program.FormPart(sheet, "scrollbar", "thumb", "", hover, "scrollbar::thumb-hover");
        Program.FormPart(sheet, "scrollbar", "thumb", "", Style.SActive(), "scrollbar::thumb-active");
        Program.Btn(sheet, "splitter", "", Style.SNormal(), "splitter");
        Program.Btn(sheet, "splitter", "", hover, "splitter-hover");
        Program.Btn(sheet, "splitter", "", Style.SActive(), "splitter-active");
        // collapse / panel / card 的标题与分隔部件。
        Program.FormPart(sheet, "collapse", "header", "", Style.SNormal(), "collapse::header");
        Program.FormPart(sheet, "collapse", "header", "", hover, "collapse::header-hover");
        Program.FormPart(sheet, "collapse", "arrow", "", Style.SNormal(), "collapse::arrow");
        Program.FormPart(sheet, "collapse", "body", "", Style.SNormal(), "collapse::body");
        Program.FormPart(sheet, "collapse", "divider", "", Style.SNormal(), "collapse::divider");
        Program.FormPart(sheet, "panel", "title", "", Style.SNormal(), "panel::title");
        Program.FormPart(sheet, "panel", "divider", "", Style.SNormal(), "panel::divider");
        Program.FormPart(sheet, "card", "title", "", Style.SNormal(), "card::title");
        Program.FormPart(sheet, "card", "divider", "", Style.SNormal(), "card::divider");
        // 菜单行的实际用法：normal↔hover 按悬停进度 Blend。
        StyleBox mn = new StyleBox();
        Style.ApplyPartSheet(sheet, mn, "menu", "item", "", "", Style.SNormal());
        StyleBox mh = new StyleBox();
        Style.ApplyPartSheet(sheet, mh, "menu", "item", "", "", hover);
        StyleBox mm = StyleBox.Blend(mn, mh, 500);
        Console.WriteLine($"overlay menu-item-mid fg {mm.fg}");
    }

    /// Layout / shorthand properties that only exist in CSS text (the
    /// builder APIs spell the same fields differently, so both paths are
    /// pinned separately).
    static void Longhand() {
        string css = "a { display: flex; flex-flow: row; flex-wrap: wrap;\n"
            + "    gap: 8 20; place-content: center space-between;\n"
            + "    box-sizing: border-box; }\n"
            + "b { flex: 1 1 0; align-self: center; aspect-ratio: 16 / 9; }\n"
            + "c { flex: none; }\n"
            + "d { flex: 2 0 40%; align-self: flex-end; }\n"
            + "e { border-radius: 10; border-top-left-radius: 0;\n"
            + "    border-bottom-right-radius: 24; }\n"
            + "f { border-top-right-radius: 6; }\n"
            + "g { position: absolute; inset: 4 8; }\n"
            + "h { inset: 1 2 3 4; }\n"
            + "i { rotate: 45; scale: 1.25; translate: 3 -7; }\n"
            + "j { gap: 12; }\n";
        StyleSheet sheet = Css.Parse(css);
        List<string> sels = new List<string>{ "a", "b", "c", "d", "e",
                                             "f", "g", "h", "i", "j" };
        for (int i = 0; i < sels.Count; i = i + 1) {
            StyleBox x = new StyleBox();
            sheet.ApplyBox(x, sels[i]);
            Console.WriteLine($"{sels[i]} display {x.display} dir {x.flexDir} wrap {x.wrap} justify {x.justify} content {x.alignContent}");
            Console.WriteLine($"  gap {x.gap} row {x.rowGap} col {x.colGap} grow {x.grow} shrink {x.shrink} basis {x.basis} pm {x.basisPm} self {x.alignSelf} aspect {x.aspect}");
            Console.WriteLine($"  radius {x.radius} corners {x.radiusTL},{x.radiusTR},{x.radiusBR},{x.radiusBL}");
            Console.WriteLine($"  pos {x.position} inset {x.posT},{x.posR},{x.posB},{x.posL} rotate {x.rotate} scale {x.scale} translate {x.tx},{x.ty}");
        }
    }

    static void Main() {
        StyleSheet sheet = Program.Sheet();
        string accent = sheet.Var("--accent");
        string radius = sheet.Var("--radius");
        Console.WriteLine($"empty {sheet.IsEmpty()}");
        Console.WriteLine($"var accent {accent} radius {radius}");
        Program.Box(sheet, "button");
        Program.Box(sheet, "tab.item");
        Program.Box(sheet, "button.primary");
        Program.Box(sheet, "button.primary:hover");
        Program.Box(sheet, "button.primary:disabled");
        Program.Box(sheet, "card");
        Program.Box(sheet, "input:focus");

        Console.WriteLine("--- blend");
        StyleBox from = new StyleBox();
        sheet.ApplyBox(from, "button.primary");
        StyleBox to = new StyleBox();
        sheet.ApplyBox(to, "button.primary:hover");
        StyleBox mid = StyleBox.Blend(from, to, 500);
        Console.WriteLine($"mid bg {mid.bg} opacity {mid.opacity}");

        Console.WriteLine("--- parts");
        Program.Part(sheet, Style.SNormal(), "base");
        Program.Part(sheet, Style.SHover(), "hover");
        Program.Part(sheet, Style.SSelected(), "selected");

        Console.WriteLine("--- checked parts");
        Program.CheckedPart(sheet, Style.SNormal(), "base");
        Program.CheckedPart(sheet, Style.SHover(), "hover");
        Program.CheckedPart(sheet, Style.SChecked(), "checked");
        int checkedHover = Style.SChecked() + Style.SHover();
        Program.CheckedPart(sheet, checkedHover, "checked-hover");
        StyleBox checkedOff = new StyleBox();
        Style.ApplyPartSheet(sheet, checkedOff, "checkbox", "box", "", "",
                             Style.SNormal());
        StyleBox checkedOn = new StyleBox();
        Style.ApplyPartSheet(sheet, checkedOn, "checkbox", "box", "", "",
                             Style.SChecked());
        StyleBox checkedMid = StyleBox.Blend(checkedOff, checkedOn, 500);
        Console.WriteLine($"checked mid pad {checkedMid.padL}");

        Console.WriteLine("--- external vars");
        Program.ExternalVars();

        Console.WriteLine("--- range parts");
        Program.RangePart(sheet, "slider", "track", "");
        Program.RangePart(sheet, "slider", "fill", "");
        Program.RangePart(sheet, "slider", "thumb", "");
        Program.RangePart(sheet, "progress", "fill", "success");
        Program.RangePart(sheet, "progress", "label", "");

        Console.WriteLine("--- gradient dirs");
        Program.GradDirs();

        Console.WriteLine("--- theme tokens");
        Program.ThemeTokens();

        Console.WriteLine("--- button states");
        Program.ButtonStates();

        Console.WriteLine("--- multi state");
        Program.MultiState();

        Console.WriteLine("--- tab states");
        Program.TabStates();

        Console.WriteLine("--- form states");
        Program.FormStates();

        Console.WriteLine("--- A3 states");
        Program.A3States();

        Console.WriteLine("--- A4 states");
        Program.A4States();

        Console.WriteLine("--- A5 states");
        Program.A5States();
        Program.A6States();

        Console.WriteLine("--- overlay states");
        Program.OverlayStates();

        Console.WriteLine("--- layout longhands");
        Program.Longhand();
    }
}
