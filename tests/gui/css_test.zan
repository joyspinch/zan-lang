    /// A6-1：小量控件绘制路径的语义颜色规则。
    static StyleSheet A6Sheet() {
        string css = "buttongroup { color: var(--text-primary); border-color: var(--border-primary); }\n"
            + "ellipsis { color: var(--text-primary); }\n"
            + "empty::icon { color: var(--text-tertiary); }\n"
            + "empty::label { color: var(--text-tertiary); }\n"
            + "floatbutton { background: var(--bg-primary); color: var(--text-primary); border: 1 var(--border-primary); box-shadow: 1 2 0 var(--shadow-color); }\n"
            + "rate::star { color: var(--warning); }\n"
            + "rate::empty { color: var(--border-primary); }\n"
            + "statistic::label { color: var(--text-secondary); }\n"
            + "statistic::value { color: var(--text-primary); }\n"
            + "result::icon { background: var(--bg-secondary); color: var(--info); }\n"
            + "result.success::icon { color: var(--success); }\n"
            + "result.warning::icon { color: var(--warning); }\n"
            + "result.error::icon { color: var(--error); }\n"
            + "result::title { color: var(--text-primary); }\n"
            + "result::desc { color: var(--text-secondary); }\n"
            + "codeblock { border: 1 var(--border-primary); }\n"
            + "codeblock::caption { color: var(--text-primary); }\n"
            + "statusbar { background: var(--bg-secondary); color: var(--text-primary); }\n"
            + "toolstrip { background: var(--bg-secondary); color: var(--text-primary); }\n"
            + "graphview::edge { background: var(--divider); }\n"
            + "graphview::edge.done { background: var(--primary); }\n"
            + "graphview::empty { color: var(--text-tertiary); }\n"
            + "logview::text { color: var(--text-primary); }\n"
            + "logview::empty { color: var(--text-disabled); }\n"
            + "layer::load-label { color: var(--text-secondary); }\n"
            + "cef::placeholder { background: var(--bg-secondary); border: 1 var(--border-primary); }\n"
            + "cef::icon { color: var(--text-tertiary); }\n"
            + "cef::label { color: var(--text-secondary); }\n"
            + "webview::placeholder { background: var(--bg-secondary); border: 1 var(--border-primary); }\n"
            + "webview::icon { color: var(--text-tertiary); }\n"
            + "webview::label { color: var(--text-secondary); }\n"
            + "panel::plain { background: var(--bg-secondary); }\n"
            + "state::surface { background: var(--bg-primary); }\n"
            + "state:disabled::surface { background: var(--bg-disabled); }\n"
            + "state:hover::surface { background: var(--bg-hover); }\n"
            + "state:active::surface, state:selected::surface { background: var(--bg-active); }\n"
            + "state::label { color: var(--text-primary); }\n"
            + "state:disabled::label { color: var(--text-disabled); }\n"
            + "state:selected::label { color: var(--primary); }\n"
            + "state::caption { color: var(--text-secondary); }\n"
            + "state:disabled::caption { color: var(--text-disabled); }\n"
            + "state:hover::caption { color: var(--text-primary); }\n"
            + "state:selected::caption { color: var(--primary); }\n"
            + "state::border { border: 1 var(--border-primary); }\n"
            + "state:disabled::border { border-color: var(--border-secondary); }\n"
            + "state:focus::border { border-color: var(--border-focus); }\n"
            + "state:hover::border, state:active::border { border-color: var(--border-hover); }\n"
            + "state::accent { background: var(--primary); }\n"
            + "progress::track { background: var(--bg-tertiary); }\n"
            + "progress::fill { background: var(--primary); }\n"
            + "progress.info::fill { background: var(--info); }\n"
            + "progress.success::fill { background: var(--success); }\n"
            + "progress.warning::fill { background: var(--warning); }\n"
            + "progress.error::fill { background: var(--error); }\n"
            + "progress::label { color: var(--text-secondary); }\n"
            + "progress::ring-label { color: var(--text-primary); }\n"
            + "spin::accent { color: var(--primary); }\n"
            + "spin.info::accent { color: var(--info); }\n"
            + "spin.success::accent { color: var(--success); }\n"
            + "spin.warning::accent { color: var(--warning); }\n"
            + "spin.error::accent { color: var(--error); }\n"
            + "spin::rest { background: var(--bg-tertiary); }\n"
            + "spin::tail { color: var(--text-tertiary); }\n"
            + "spin::ring { color: var(--border-primary); }\n"
            + "styledtext::selection { background: var(--styledtext-selection); }\n"
            + "styledtext::code { background: var(--styledtext-code-bg); }\n"
            + "styledtext::time { color: var(--text-tertiary); }\n"
            + "styledtext::separator { background: var(--border-secondary); }\n"
            + "styledtext::rail.success { background: var(--styledtext-rail-success); }\n"
            + "styledtext::tint.success { background: var(--styledtext-tint-success); }\n"
            + "styledtext::rail.primary { background: var(--styledtext-rail-primary); }\n"
            + "styledtext::tint.primary { background: var(--styledtext-tint-primary); }\n"
            + "styledtext::rail.tool { background: var(--styledtext-rail-tool); }\n"
            + "styledtext::tint.tool { background: var(--styledtext-tint-tool); }\n"
            + "styledtext::rail.error { background: var(--styledtext-rail-error); }\n"
            + "styledtext::tint.error { background: var(--styledtext-tint-error); }\n"
            + "effects::star { color: var(--text-primary); }\n"
            + "effects::particle.a { color: var(--primary); }\n"
            + "effects::particle.b { color: var(--error); }\n"
            + "effects::particle.c { color: var(--info); }\n"
            + "effects::bokeh.a { color: var(--primary); }\n"
            + "effects::bokeh.b { color: var(--warning); }\n"
            + "effects::bokeh.c { color: var(--error); }\n"
            + "effects::mesh.a { color: var(--primary); }\n"
            + "effects::mesh.b { color: var(--info); }\n"
            + "propertygrid::step { background: var(--bg-tertiary); border: 1 var(--border-primary); color: var(--text-primary); }\n"
            + "propertygrid::step:hover { background: var(--bg-hover); }\n"
            + "propertygrid::empty { color: var(--text-tertiary); }\n"
            + "propertygrid::section { color: var(--text-tertiary); }\n"
            + "propertygrid::label { color: var(--text-secondary); }\n"
            + "propertygrid::value { color: var(--text-primary); }\n"
            + "pivottable::surface { background: var(--bg-primary); border: 1 var(--border-primary); }\n"
            + "pivottable::head { background: var(--bg-secondary); }\n"
            + "pivottable::total { background: var(--bg-tertiary); }\n"
            + "pivottable::corner { color: var(--text-secondary); }\n"
            + "pivottable::head-label, pivottable::total-label { color: var(--text-primary); }\n"
            + "pivottable::head-muted, pivottable::body-empty { color: var(--text-tertiary); }\n"
            + "pivottable::body-label { color: var(--text-secondary); }\n"
            + "pivottable::body-value { color: var(--text-primary); }\n"
            + "pivottable::grid { background: var(--divider); }\n"
            + "pivottable::accent { color: var(--primary); }\n"
            + "pivottable::hover { background: var(--bg-hover); }\n"
            + "pivottable::sel { background: var(--primary-soft-bg); }\n"
            + "chatview::head { color: var(--success); }\n"
            + "chatview::head.primary { color: var(--primary); }\n"
            + "chatview::head.error, chatview::head.danger { color: var(--error); }\n"
            + "chatview::head.tool { color: var(--text-tertiary); }\n"
            + "chatview::body { color: var(--text-primary); }\n"
            + "chatview::body.error, chatview::body.danger { color: var(--error); }\n"
            + "chatview::body.tool { color: var(--text-tertiary); }\n"
            + "chatview::muted { color: var(--text-tertiary); }\n"
            + "chatview::code { color: var(--info); }\n"
            + "codeeditor::surface { background: var(--bg-primary); }\n"
            + "codeeditor::gutter { background: var(--bg-secondary); }\n"
            + "codeeditor::divider { background: var(--divider); }\n"
            + "codeeditor::hover { background: var(--bg-hover); }\n"
            + "codeeditor::breakpoint { background: var(--error); }\n"
            + "codeeditor::line-number { color: var(--text-tertiary); }\n"
            + "codeeditor::caret { background: var(--primary); }\n"
            + "codeeditor::text { color: var(--text-primary); }\n"
            + "ribbon::surface { background: var(--bg-secondary); }\n"
            + "ribbon::divider { background: var(--divider); }\n"
            + "ribbon::item { color: var(--text-secondary); }\n"
            + "ribbon::item:hover { background: var(--bg-hover); }\n"
            + "ribbon::item:active { background: var(--bg-active); }\n"
            + "ribbon::item:disabled { color: var(--text-disabled); }\n"
            + "ribbon::accent { color: var(--primary); }\n"
            + "ribbon::accent:hover { color: var(--primary-hover); }\n"
            + "ribbon::muted { color: var(--text-tertiary); }\n"
            + "ribbon::strip { background: var(--bg-tertiary); }\n"
            + "ribbon::tab { color: var(--text-secondary); }\n"
            + "ribbon::tab:hover { background: var(--bg-hover); color: var(--text-primary); }\n"
            + "ribbon::tab:active { background: var(--bg-secondary); color: var(--primary); }\n"
            + "wizard::preview, wizard::list, wizard::template-panel { background: var(--bg-secondary); border: 1 var(--border-secondary); }\n"
            + "wizard::preview-label, wizard::label { color: var(--text-secondary); }\n"
            + "wizard::preview-caption, wizard::description { color: var(--text-tertiary); }\n"
            + "wizard::preview-device, wizard::sketch-surface { background: var(--bg-primary); border: 1 var(--border-primary); }\n"
            + "wizard::sketch-line { color: var(--border-primary); }\n"
            + "wizard::sketch-fill, wizard::category-panel, wizard::target { background: var(--bg-tertiary); }\n"
            + "wizard::sketch-accent, wizard::accent { background: var(--primary); color: var(--primary); }\n"
            + "wizard::sketch-error { background: var(--error); }\n"
            + "wizard::sketch-panel, wizard::bar { background: var(--bg-secondary); }\n"
            + "wizard::title { color: var(--text-primary); }\n"
            + "wizard::divider { background: var(--divider); }\n"
            + "wizard::close { color: var(--text-primary); }\n"
            + "wizard::close:hover { background: var(--error); }\n"
            + "wizard::list-row-icon, wizard::template-row-icon, wizard::category-row { color: var(--text-secondary); }\n"
            + "wizard::list-row-label, wizard::template-row-label { color: var(--text-primary); }\n"
            + "wizard::list-row-icon:active, wizard::list-row-label:active, wizard::template-row-icon:active, wizard::template-row-label:active, wizard::category-row:active { color: var(--primary); }\n"
            + "wizard::list-row:hover, wizard::category-row:hover, wizard::template-row:hover { background: var(--bg-hover); }\n"
            + "wizard::list-row:active, wizard::category-row:active, wizard::template-row:active { background: var(--bg-active); color: var(--primary); }\n"
            + "wizard::target:hover { background: var(--bg-hover); }\n"
            + "wizard::target:active { background: var(--primary); color: var(--bg-primary); }\n"
            + "wizard::notice { color: var(--error); }\n"
            + "filepicker::label { color: var(--text-secondary); }\n"
            + "filepicker::pane { background: var(--bg-secondary); }\n"
            + "filepicker::pane-border { border: 1 var(--border-secondary); }\n"
            + "filepicker::row { color: var(--text-primary); }\n"
            + "filepicker::row:hover { background: var(--bg-hover); }\n"
            + "filepicker::row:selected { background: var(--primary-hover); }\n"
            + "filepicker::icon { color: var(--text-secondary); }\n"
            + "filepicker::folder-icon { color: var(--primary); }\n"
            + "filepicker::empty { color: var(--text-tertiary); }\n"
            + "filepicker::scrollbar { background: var(--bg-tertiary); color: var(--primary); }\n"
            + "filepicker::status { color: var(--text-tertiary); }\n"
            + "filepicker::status.error { color: var(--error); }\n"
            + "filepicker::filter { background: var(--bg-tertiary); color: var(--text-primary); }\n"
            + "filepicker::filter-border { border: 1 var(--border-primary); }\n"
            + "filepicker::filter:hover { background: var(--bg-hover); }\n"
            + "filepicker::filter:active { background: var(--bg-primary); }\n"
            + "filepicker::filter-shadow { box-shadow: 1 2 0 var(--shadow-color); }\n";
        List<string> names = new List<string>();
        List<string> vals = new List<string>();
        Css.CollectVars(Style.RootFromTheme(Theme.Light()), names, vals);
        return Css.ParseWith(css, names, vals);
    }

