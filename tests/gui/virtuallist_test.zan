using System;
using Gui;
using Gui.Widget;

/// Headless verification of VirtualList's two row modes. Template rows must
/// be built lazily — nothing is constructed at SetRows(), rows appear only
/// when a frame renders them — and the string-mode bookkeeping (count,
/// selection text, appended rows) must stay exactly as it was.
class Program {
    static int built;

    static Control Row(int i) {
        built = built + 1;
        Panel p = Panel.Root("row");
        p.With(new Label("r" + Convert.ToString(i)));
        return p;
    }

    static void Main() {
        // ---- string mode: the pre-existing behaviour must not move ----
        VirtualList vs = new VirtualList();
        List<string> rows = new List<string>();
        vs.SetItems(rows);
        Console.WriteLine("empty " + Convert.ToString(vs.Count())
            + " " + Convert.ToString(vs.Selected()));
        rows.Add("alpha");
        rows.Add("beta");
        Console.WriteLine("bound " + Convert.ToString(vs.Count()));
        vs.Add("gamma");
        Console.WriteLine("added " + Convert.ToString(vs.Count())
            + " '" + vs.SelectedText() + "'");

        // ---- template mode: rows are built on demand, not at SetRows ----
        built = 0;
        VirtualList vt = new VirtualList();
        vt.SetRows(1000, i => Program.Row(i));
        Console.WriteLine("template " + Convert.ToString(vt.Count())
            + " built=" + Convert.ToString(built));
        vt.Refresh();
        Console.WriteLine("refresh built=" + Convert.ToString(built));
        Console.WriteLine("selected text '" + vt.SelectedText() + "'");

        // Shrinking the data: nothing is selected yet, but the count and the
        // laziness guarantee must both survive the rebinding.
        vt.SetRows(3, i => Program.Row(i));
        Console.WriteLine("shrunk " + Convert.ToString(vt.Count())
            + " built=" + Convert.ToString(built));

        // Switching back to string rows detaches the template.
        vt.SetItems(rows);
        Console.WriteLine("back to strings " + Convert.ToString(vt.Count())
            + " '" + vt.SelectedText() + "'");
    }
}
