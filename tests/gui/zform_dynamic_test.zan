// WEB_GUI_ROADMAP P8 用例：设计稿的动态原语（<template data-for> / data-if）
// 经 GenForm 合成 partial class（Rows.SetAttr(data-for) / Title.bindIf），
// 宿主挂模型验证行展开、作用域推送、插拔与双向回写。无头直调同步通道。
using System;
using System.Json;
using Gui;
using Gui.Widget;

partial class ZdPanel {
    void OnInit() {
    }
}

class ZformDynamicWin : ChildWindow {
}

class DsnDynProbe {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void Main() {
        fails = 0;
        ZdPanel p = new ZdPanel();
        JsonValue model = JsonValue.Parse(
            "{\"showTitle\":true,\"title\":\"hello\","
            + "\"items\":[{\"name\":\"a\"},{\"name\":\"b\"}]}");
        ZformDynamicWin w = new ZformDynamicWin();
        w.SetRoot(p, model);
        w.Wire();

        // 生成通道落点：模板字段 kind/template + data-for 属性表。
        DsnDynProbe.Eq("tpl kind", p.Rows.Kind(), "template");
        DsnDynProbe.Eq("tpl for", p.Rows.CssAttr("data-for"), "items");

        // 展开断言：panel 子项 = 模板 + 2 行 li + Title 输入框。
        DsnDynProbe.Eq("panel kids", Convert.ToString(p.ChildCount()), "4");
        Control row0 = p.children[1];
        Control row1 = p.children[2];
        Control title = p.children[3];
        DsnDynProbe.Eq("row0 kind", row0.Kind(), "li");
        DsnDynProbe.Eq("row0 name", row0.children[0].GetProp("text"), "a");
        DsnDynProbe.Eq("row1 name", row1.children[0].GetProp("text"), "b");

        // data-if：showTitle=true 可见 + bind 推送。
        DsnDynProbe.Eq("title visible", Convert.ToString(title.visible), "1");
        DsnDynProbe.Eq("title value", title.GetProp("value"), "hello");

        // 插拔：模型翻转 → 再同步。
        model.PathSet("showTitle", "false");
        w.SyncFromModel();
        DsnDynProbe.Eq("title hidden", Convert.ToString(title.visible), "0");

        // 数组收缩 → 重建为 1 行（panel 子项 3）。
        JsonValue items2 = JsonValue.Parse("[{\"name\":\"a\"}]");
        model.PathSetValue("items", items2);
        w.SyncFromModel();
        DsnDynProbe.Eq("panel kids after shrink",
                       Convert.ToString(p.ChildCount()), "3");

        // 行内回写：改克隆 span 的文本 → 模型 items[0].name。
        Control rowq = p.children[1];
        rowq.children[0].SetProp("text", "z");
        w.SyncChangedNode(p);
        JsonValue back = model.Get("items");
        JsonValue back0 = back == null ? null : back.At(0);
        JsonValue backn = back0 == null ? null : back0.Get("name");
        DsnDynProbe.Eq("model items[0].name",
                       backn == null ? "?" : backn.AsString(""), "z");

        // 根级回写。
        title.SetProp("value", "changed");
        w.SyncChangedNode(p);
        JsonValue mt = model.Get("title");
        DsnDynProbe.Eq("model title", mt == null ? "?" : mt.AsString(""), "changed");

        if (fails == 0) { Console.WriteLine("ZFORM_DYNAMIC_OK"); }
    }
}
