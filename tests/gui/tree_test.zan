using System;
using Gui;
using Gui.Widget;

/// 接口数据协议与执行契约。
/// place in the tree, so adding it somewhere else moves it there, and a节点
/// 核心契约与语义定义。
///
/// 接口数据协议与执行契约。
/// 接口数据协议与执行契约。
/// 接口数据协议与执行契约。
/// 接口数据协议与执行契约。
/// 接口数据协议与执行契约。
/// 核心契约与语义定义。
class TreeTest {
    static int fails;

    static void Eq(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got "
            + Convert.ToString(got) + " want " + Convert.ToString(want));
    }

    static void True(string what, bool ok) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    /// 接口数据协议与执行契约。
    /// 接口数据协议与执行契约。
    /// 核心契约与执行状态转移规范。
    static int Depth(Control c, int budget) {
        if (budget <= 0) { return 999; }
        int deepest = 0;
        for (int i = 0; i < c.children.Count; i = i + 1) {
            int d = TreeTest.Depth(c.children[i], budget - 1);
            if (d + 1 > deepest) { deepest = d + 1; }
        }
        return deepest;
    }

    static void Main() {
        fails = 0;

        Panel a = new Panel("a");
        Panel b = new Panel("b");
        Label leaf = new Label("leaf");

        a.Add(leaf);
        TreeTest.Eq("adopted", a.children.Count, 1);
        TreeTest.True("parent is a", leaf.parent == a);

        // 接口数据协议与执行契约。
        b.Add(leaf);
        TreeTest.Eq("old parent released", a.children.Count, 0);
        TreeTest.Eq("new parent adopted", b.children.Count, 1);
        TreeTest.True("parent is b", leaf.parent == b);

        // 接口数据协议与执行契约。
        b.Add(leaf);
        TreeTest.Eq("no duplicate child", b.children.Count, 1);

        // 接口数据协议与执行契约。
        a.Add(b);
        b.Add(a);
        TreeTest.True("ancestor rejected", a.parent == null);
        TreeTest.Eq("cycle not created", b.children.Count, 1);
        a.Add(a);
        TreeTest.Eq("self rejected", a.children.Count, 1);

        // 接口数据协议与执行契约。
        Panel row = new Panel("row");
        Label one = new Label("one");
        Control chained = row.With(one).With(one);
        TreeTest.True("With returns container", chained == row);
        TreeTest.Eq("With no duplicate", row.children.Count, 1);
        row.With(row);
        TreeTest.Eq("With self rejected", row.children.Count, 1);

        // 核心契约与语义定义。
        Panel host = new Panel("host");
        host.InsertAt(0, one);
        TreeTest.Eq("insert moved", row.children.Count, 0);
        TreeTest.Eq("insert adopted", host.children.Count, 1);

        // 接口数据协议与执行契约。
        TreeTest.Eq("depth", TreeTest.Depth(a, 64), 2);

        if (fails == 0) { Console.WriteLine("tree_test: OK"); }
        else {
            Console.WriteLine("tree_test: " + Convert.ToString(fails)
                + " failure(s)");
        }
    }
}
