using System;
using Gui;
using Gui.Widget;
using Gui.Component;

class FactoryLifetimeWatch {
    public weak Control code;
    public weak Control made;
    public weak Control html;
    public weak Control codeClone;
    public weak Control htmlClone;
}

class ControlFactoryEquivalenceTest {
    static List<string> tested;
    static List<FactoryLifetimeWatch> watches;
    static List<string> lifetimeFailures;
    static int changes;

    static void Check(string label, bool ok) {
        if (!ok) { throw new Exception("control factory equivalence: " + label); }
    }

    static Control One(string source) {
        HtmlDoc doc = Html.Parse(source, "", null);
        Check("one HTML root", doc.root != null && doc.root.children.Count == 1);
        return doc.root.children[0];
    }

    static string Tag(string kind) {
        string tag = "zan-";
        for (int i = 0; i < kind.Length; i = i + 1) {
            int ch = (int)kind[i];
            if (i > 0 && ch >= 65 && ch <= 90) { tag = tag + "-"; }
            tag = tag + kind.Substring(i, 1).ToLower();
        }
        return tag;
    }

    static void Mark(Control c) {
        // Element's kind is its native tag, not its factory lookup key.
        if (c is Element) { ((Element)c).InitElement("div", ""); }
        c.SetProp("name", "factory-node");
        c.AddClass("factory-marker");
    }

    static void Same(string label, Control got, Control code) {
        Check(label + " exists", got != null);
        Check(label + " distinct instance", got != code);
        Check(label + " kind", got.Kind() == code.Kind());
        Check(label + " name", got.name == code.name);
        Check(label + " class", got.HasClass("factory-marker"));
    }

    static void Exercise(string kind, Control code, FactoryLifetimeWatch watch) {
        Check(kind + " registered", ControlFactory.Has(kind));
        Check(kind + " once in cases", !tested.Contains(kind));
        tested.Add(kind);
        Mark(code);
        watch.code = code;
        Control made = ControlFactory.Create(kind);
        Check(kind + " factory exists", made != null);
        Mark(made);
        watch.made = made;
        Same(kind + " factory", made, code);
        Control codeClone = Html.Clone(code);
        watch.codeClone = codeClone;
        Same(kind + " code clone", codeClone, code);

        // These tag aliases intentionally name other controls. Do not silently
        // change the HTML language to match factory keys during this refactor.
        if (kind == "Grid" || kind == "Ribbon") { return; }
        string tag = kind == "Element" ? "div" : Tag(kind);
        Control html = One("<" + tag + " id='factory-node' class='factory-marker'></" + tag + ">");
        watch.html = html;
        Same(kind + " HTML", html, code);
        Control htmlClone = Html.Clone(html);
        watch.htmlClone = htmlClone;
        Same(kind + " HTML clone", htmlClone, html);
        htmlClone.SetProp("name", "clone-only");
        Check(kind + " clone mutation isolated", html.name == "factory-node");
    }

    static void Released(string label, Control value) {
        if (value == null) { return; }
        lifetimeFailures.Add(label);
        Console.WriteLine("LIFETIME_FAIL " + label);
    }

    static void Case(string kind, Control code) {
        FactoryLifetimeWatch watch = new FactoryLifetimeWatch();
        Exercise(kind, code, watch);
        // AllKinds checks code after the constructor temporary has released.
        watches.Add(watch);
        Released(kind + " factory", watch.made);
        Released(kind + " HTML", watch.html);
        Released(kind + " code clone", watch.codeClone);
        Released(kind + " HTML clone", watch.htmlClone);
    }

    static void AllKinds() {
        Case("Panel", new Panel());
        Case("Label", new Label());
        Case("Button", new Button());
        Case("Progress", new Progress());
        Case("Input", new Input());
        Case("TextArea", new TextArea());
        Case("Typography", new Typography());
        Case("Element", new Element());
        Case("InputOtp", new InputOtp());
        Case("InputNumber", new InputNumber());
        Case("Switch", new Switch());
        Case("Checkbox", new Checkbox());
        Case("Radio", new Radio());
        Case("RadioButton", new Radio(null, 0, "", true));
        Case("Slider", new Slider());
        Case("SelectBox", new SelectBox());
        Case("Rate", new Rate());
        Case("Pagination", new Pagination());
        Case("Tabs", new Tabs());
        Case("DatePicker", new DatePicker());
        Case("ColorPicker", new ColorPicker());
        Case("VirtualList", new VirtualList());
        Case("SplitPanel", new SplitPanel());
        Case("ToolStrip", new ToolStrip());
        Case("StatusBar", new StatusBar());
        Case("AlertBox", new AlertBox());
        Case("FloatButton", new FloatButton());
        Case("RadioGroup", new RadioGroup());
        Case("CheckboxGroup", new CheckboxGroup());
        Case("ScrollColumn", new ScrollColumn());
        Case("Divider", new Divider());
        Case("Flex", new Flex());
        Case("Grid", new Grid());
        Case("GridItem", new GridItem());
        Case("Image", new Image());
        Case("Watermark", new Watermark());
        Case("Countdown", new Countdown());
        Case("QrCode", new QrCode());
        Case("Upload", new Upload());
        Case("NumberAnimation", new NumberAnimation());
        Case("Marquee", new Marquee());
        Case("DynamicTags", new DynamicTags());
        Case("Calendar", new Calendar());
        Case("Card", new Card());
        Case("Tag", new Tag());
        Case("Badge", new Badge());
        Case("Avatar", new Avatar());
        Case("Statistic", new Statistic());
        Case("Timeline", new Timeline());
        Case("TreeView", new TreeView());
        Case("Collapse", new Collapse());
        Case("Empty", new Empty());
        Case("Result", new Result());
        Case("Skeleton", new Skeleton());
        Case("Spin", new Spin());
        Case("Steps", new Steps());
        Case("Breadcrumb", new Breadcrumb());
        Case("PageHeader", new PageHeader());
        Case("ListView", new ListView<string>());
        Case("Dropdown", new Dropdown<string>());
        Case("Carousel", new Carousel());
        Case("Row", new Row());
        Case("Spacer", new Spacer());
        Case("FormGroup", new FormGroup());
        Case("FormItem", new FormItem());
        Case("Modal", new Modal());
        Case("Drawer", new Drawer());
        Case("Ribbon", new Ribbon());
        Case("BandGrid", new BandGrid());
        Case("GraphView", new GraphView());
        for (int i = 0; i < watches.Count; i = i + 1) {
            Released(tested[i] + " direct constructor", watches[i].code);
        }
        Check("all kind lifetimes release", lifetimeFailures.Count == 0);
        List<string> kinds = ControlFactory.Kinds();
        foreach (string kind in kinds) {
            Check(kind + " registration covered", tested.Contains(kind));
        }
        foreach (string kind in tested) {
            Check(kind + " enumerated", kinds.Contains(kind));
        }
        Console.WriteLine("all registered constructors, HTML and clones agree");
    }

    static void Changed() { changes = changes + 1; }

    static void SelectByInput(Radio radio, bool keyboard) {
        changes = 0;
        radio.Change.Add(Changed);
        radio.model.Set(-1);
        RoutedEventArgs e = new RoutedEventArgs(keyboard ? "KeyDown" : "Click", radio);
        e.keyCode = 32;
        Control.RouteEvent(radio, e);
        Check("radio input selects", radio.IsSelected() && radio.model.Get() == radio.optionValue);
        Check("radio emits one change", changes == 1);
        Control.RouteEvent(radio, new RoutedEventArgs("Click", radio));
        Check("selected radio does not emit twice", changes == 1);
        radio.SyncBinding();
        if (radio.buttonForm) {
            Check("button radio selected style", radio.HasClass("selected"));
        }
    }

    static void RadioForms(FactoryLifetimeWatch watch) {
        Radio code = new Radio(null, 7, "Seven", true);
        Radio made = (Radio)ControlFactory.Create("RadioButton");
        Check("button radio factory type", made != null && made.buttonForm);
        made.SetProp("option", "7");
        made.SetProp("label", "Seven");
        Control htmlControl = One("<zan-radio-button option='7' label='Seven' value='-1'></zan-radio-button>");
        Check("button radio HTML type", htmlControl is Radio);
        Radio html = (Radio)htmlControl;
        Check("button radio HTML form", html.buttonForm && html.Kind() == "RadioButton");
        Check("button radio attributes", html.optionValue == code.optionValue && html.label == code.label);
        SelectByInput(code, false);
        SelectByInput(made, true);
        SelectByInput(html, false);
        Control cloned = Html.Clone(html);
        Check("button radio clone type", cloned is Radio);
        Radio clone = (Radio)cloned;
        Check("button radio clone state", clone.buttonForm && clone.optionValue == 7
            && clone.label == "Seven" && clone.IsSelected());
        SelectByInput(clone, true);
        clone.model.Set(3);
        clone.SyncBinding();
        Check("button radio clone independent", html.IsSelected() && !clone.IsSelected()
            && !clone.HasClass("selected"));
        watch.code = code;
        watch.made = made;
        watch.html = html;
        watch.htmlClone = clone;
    }

    static Control OrphanIndicator(FactoryLifetimeWatch watch) {
        Radio radio = new Radio(5, "Five");
        SelectByInput(radio, true);
        Control indicator = radio.children[0];
        indicator.SyncBinding();
        Check("round radio indicator selected", indicator.HasClass("selected"));
        watch.code = radio;
        return indicator;
    }

    static Control RateClicks(FactoryLifetimeWatch watch) {
        Rate rate = new Rate();
        rate.Change.Add(Changed);
        changes = 0;
        Control star = rate.children[2];
        Control.RouteEvent(star, new RoutedEventArgs("Click", star));
        Check("rate child click selects", rate.Value() == 3 && changes == 1);
        Check("rate child style follows selection", star.HasClass("on"));
        rate.clearable = true;
        Control.RouteEvent(star, new RoutedEventArgs("Click", star));
        Check("rate child click clears", rate.Value() == 0 && changes == 2);
        rate.readOnly = true;
        Control.RouteEvent(star, new RoutedEventArgs("Click", star));
        Check("readonly rate ignores child click", rate.Value() == 0 && changes == 2);
        watch.code = rate;
        return star;
    }

    static void Drain() {
        Action action = Dispatcher.Take();
        while (action != null) { action(); action = Dispatcher.Take(); }
    }

    static Control Part(Control owner, string cls) {
        foreach (Control child in owner.children) {
            if (child.HasClass(cls)) { return child; }
        }
        throw new Exception("missing pagination part: " + cls);
    }

    static void ClickPart(Control part) {
        Control.RouteEvent(part, new RoutedEventArgs("Click", part));
        Drain();
    }

    static Control PaginationClicks(FactoryLifetimeWatch watch) {
        Pagination pagination = new Pagination(30);
        pagination.Change.Add(Changed);
        changes = 0;
        ClickPart(Part(pagination, "pagination-next"));
        Check("pagination next", pagination.CurrentPage() == 2 && changes == 1);
        ClickPart(Part(pagination, "pagination-prev"));
        Check("pagination previous", pagination.CurrentPage() == 1 && changes == 2);
        ClickPart(Part(pagination, "pagination-ellipsis"));
        Check("pagination ellipsis advances", pagination.CurrentPage() > 1 && changes == 3);
        ClickPart(Part(pagination, "pagination-item"));
        Check("pagination numbered page", pagination.CurrentPage() == 1 && changes == 4);
        pagination.Jumper(true);
        Input input = (Input)Part(pagination, "pagination-jumper-input");
        input.SetText("12");
        input.Submit.Raise();
        Check("pagination jumper", pagination.CurrentPage() == 12 && changes == 5);
        pagination.SetPageSizesText("10,20,50");
        pagination.SetOrderText("pager,jumper,sizes");
        ClickPart(Part(pagination, "pagination-sizes-btn"));
        Check("pagination size action", pagination.PageSize() == 20);
        Control next = Part(pagination, "pagination-next");
        watch.code = pagination;
        watch.html = input;
        return next;
    }

    static void FlexExtra(Flex flex, string key, string value) {
        Check("flex extra setter " + key, flex.SetExtra(key, value));
        Check("flex extra getter " + key, flex.GetExtra(key) == value);
        Check("flex property getter " + key, flex.GetProp(key) == value);
    }

    static void FlexProperties() {
        Flex flex = new Flex();
        flex.SetProp("name", "flex-node");
        Check("flex base name", flex.name == "flex-node" && flex.GetProp("name") == "flex-node");
        Check("flex unknown extra declined", !flex.SetExtra("factory-unknown", "true"));
        Check("flex unknown getters empty", flex.GetExtra("factory-unknown") == ""
            && flex.GetProp("factory-unknown") == "");
        flex.SetProp("factory-unknown", "true");
        Check("flex unknown property uses base class fallback", flex.HasClass("factory-unknown"));
        FlexExtra(flex, "direction", "column");
        FlexExtra(flex, "wrap", "true");
        FlexExtra(flex, "justify", "between");
        FlexExtra(flex, "align", "end");
        FlexExtra(flex, "size", "large");
        Control clone = Html.Clone(flex);
        Check("flex property clone exists", clone is Flex && clone.name == "flex-node");
        Check("flex clone direction", clone.GetProp("direction") == "column");
        Check("flex clone wrap", clone.GetProp("wrap") == "true");
        Check("flex clone justify", clone.GetProp("justify") == "between");
        Check("flex clone align", clone.GetProp("align") == "end");
        Check("flex clone size", clone.GetProp("size") == "large");
        Console.WriteLine("flex extra delegation and clone properties agree");
    }

    static void GridExtra(Control control, string key, string value) {
        Check("grid extra setter " + key, control.SetExtra(key, value));
        Check("grid extra getter " + key, control.GetExtra(key) == value);
        Check("grid property getter " + key, control.GetProp(key) == value);
    }

    static void GridBaseProperties(Control control, string name) {
        control.SetProp("name", name);
        Check("grid base name", control.name == name && control.GetProp("name") == name);
        Check("grid unknown extra declined", !control.SetExtra("factory-unknown", "true"));
        Check("grid unknown getters empty", control.GetExtra("factory-unknown") == ""
            && control.GetProp("factory-unknown") == "");
        control.SetProp("factory-unknown", "true");
        Check("grid unknown property uses base class fallback", control.HasClass("factory-unknown"));
    }

    static void GridProperties() {
        Grid grid = new Grid();
        GridBaseProperties(grid, "grid-node");
        GridExtra(grid, "cols", "3");
        Check("grid cols alias reads", grid.GetExtra("columns") == "3");
        GridExtra(grid, "columns", "4");
        Check("grid columns alias writes", grid.GetProp("cols") == "4");
        GridExtra(grid, "minColumn", "80");
        Check("grid minColumn alias reads", grid.GetExtra("min-column") == "80");
        GridExtra(grid, "min-column", "96");
        Check("grid min-column alias writes", grid.GetProp("minColumn") == "96");
        Control clone = Html.Clone(grid);
        Check("grid property clone exists", clone is Grid && clone.name == "grid-node");
        Check("grid clone columns", clone.GetProp("cols") == "4"
            && clone.GetExtra("columns") == "4");
        Check("grid clone minimum column", clone.GetProp("minColumn") == "96"
            && clone.GetExtra("min-column") == "96");
        GridItem item = new GridItem();
        GridBaseProperties(item, "grid-item-node");
        GridExtra(item, "span", "2");
        GridExtra(item, "offset", "1");
        Control itemClone = Html.Clone(item);
        Check("grid item property clone exists", itemClone is GridItem
            && itemClone.name == "grid-item-node");
        Check("grid item clone span", itemClone.GetProp("span") == "2");
        Check("grid item clone offset", itemClone.GetProp("offset") == "1");
        Console.WriteLine("grid and grid item extra delegation and clone properties agree");
    }

    static void CloneMetadata(string kind) {
        Control source = ControlFactory.Create(kind);
        source.SetProp("text", "clone text");
        Check(kind + " metadata text fixture", source.GetProp("text") == "clone text");
        source.name = "metadata-id";
        source.AddClass("factory-metadata");
        source.prefW = 123;
        source.prefH = 45;
        source.bindPath = "model.caption";
        Control clone = Html.Clone(source);
        Check(kind + " clone metadata exists", clone != null && clone != source);
        Check(kind + " clone keeps independent name", clone.name == "metadata-id");
        Check(kind + " clone keeps text", clone.GetProp("text") == "clone text");
        Check(kind + " clone keeps classes", clone.Class == source.Class);
        Check(kind + " clone keeps dimensions", clone.prefW == 123 && clone.prefH == 45);
        Check(kind + " clone keeps binding metadata", clone.bindPath == "model.caption");
        clone.SetProp("text", "changed clone");
        Check(kind + " clone text is isolated", source.GetProp("text") == "clone text"
            && source.name == "metadata-id");
    }

    static void CloneMetadataProperties() {
        CloneMetadata("Marquee");
        CloneMetadata("Label");
        CloneMetadata("Typography");
        CloneMetadata("Tag");
        CloneMetadata("Empty");
        CloneMetadata("Result");
        CloneMetadata("PageHeader");
        Console.WriteLine("clone property replay preserves independent metadata");
    }

    static void GeneratedClone(string kind) {
        Control source = ControlFactory.Create(kind);
        Control copy = Html.Clone(source);
        Check(kind + " generated clone exists", copy != null && copy != source);
        Check(kind + " generated parts copied once", copy.children.Count == source.children.Count);
        for (int i = 0; i < copy.children.Count; i = i + 1) {
            Check(kind + " generated part is independent", copy.children[i] != source.children[i]);
            Check(kind + " generated parent", copy.children[i].parent == copy);
        }
    }

    static Label BusinessLabel(string name) {
        Label label = new Label("business text");
        label.name = name;
        return label;
    }

    static void BusinessCopy(Control source, Control copy, string name) {
        Control original = source.FindByName(name);
        Control child = copy.FindByName(name);
        Check(name + " business clone exists", original != null && child != null && child != original);
        Check(name + " business clone parent", child.parent != null && child.parent != original.parent);
        child.name = "changed-copy";
        Check(name + " business clone independent", original.name == name);
    }

    static void CompositeContent() {
        string[] generated = new string[]{"Radio", "RadioButton", "Rate", "Pagination",
            "InputOtp", "InputNumber", "Switch", "Checkbox", "Slider", "Progress",
            "Divider", "Countdown", "Avatar", "Badge", "Statistic", "FloatButton",
            "Calendar", "DynamicTags", "PageHeader", "Modal", "Drawer", "Tabs"};
        foreach (string kind in generated) { GeneratedClone(kind); }
        Empty empty = new Empty("empty title");
        empty.Extra(BusinessLabel("empty-extra"));
        Empty emptyCopy = (Empty)Html.Clone(empty);
        Check("empty structure copied once", emptyCopy.children.Count == empty.children.Count);
        Check("empty extra target parent", emptyCopy.GetExtra().parent == emptyCopy);
        BusinessCopy(empty, emptyCopy, "empty-extra");
        Result result = new Result();
        result.Title("result title").Extra(BusinessLabel("result-extra"));
        Result resultCopy = (Result)Html.Clone(result);
        Check("result structure copied once", resultCopy.children.Count == result.children.Count);
        Check("result extra target parent", resultCopy.GetExtra().parent == resultCopy);
        BusinessCopy(result, resultCopy, "result-extra");
        Card card = new Card("card title");
        card.HeaderExtra(BusinessLabel("card-header"));
        card.Content(BusinessLabel("card-body"));
        card.Action(BusinessLabel("card-action"));
        Card cardCopy = (Card)Html.Clone(card);
        Check("card structure copied once", cardCopy.children.Count == card.children.Count);
        BusinessCopy(card, cardCopy, "card-header");
        BusinessCopy(card, cardCopy, "card-body");
        BusinessCopy(card, cardCopy, "card-action");
        SplitPanel split = new SplitPanel();
        split.First().Add(BusinessLabel("first-content"));
        split.Second().Add(BusinessLabel("second-content"));
        SplitPanel splitCopy = (SplitPanel)Html.Clone(split);
        Check("split generated panes copied once", splitCopy.children.Count == 2);
        Check("split first content parent", splitCopy.First().children[0].parent == splitCopy.First());
        Check("split second content parent", splitCopy.Second().children[0].parent == splitCopy.Second());
        BusinessCopy(split, splitCopy, "first-content");
        BusinessCopy(split, splitCopy, "second-content");
        AlertBox alert = new AlertBox();
        alert.MountSlot("content", BusinessLabel("alert-content"));
        alert.MountSlot("action", BusinessLabel("alert-action"));
        AlertBox alertCopy = (AlertBox)Html.Clone(alert);
        Check("alert structure copied once", alertCopy.children.Count == alert.children.Count);
        BusinessCopy(alert, alertCopy, "alert-content");
        BusinessCopy(alert, alertCopy, "alert-action");
        FormItem item = new FormItem();
        item.MountSlot("field", BusinessLabel("form-field"));
        item.MountSlot("extra", BusinessLabel("form-extra"));
        FormItem itemCopy = (FormItem)Html.Clone(item);
        Check("form field cloned into slot", itemCopy.GetField() != item.GetField());
        BusinessCopy(item, itemCopy, "form-field");
        BusinessCopy(item, itemCopy, "form-extra");
        Modal modal = new Modal();
        modal.Content(BusinessLabel("modal-content"));
        Modal modalCopy = (Modal)Html.Clone(modal);
        Check("modal internal card copied once", modalCopy.children.Count == 1);
        BusinessCopy(modal, modalCopy, "modal-content");
        Drawer drawer = new Drawer();
        drawer.Content(BusinessLabel("drawer-content"));
        drawer.Action(BusinessLabel("drawer-action"));
        Drawer drawerCopy = (Drawer)Html.Clone(drawer);
        Check("drawer internal panel copied once", drawerCopy.children.Count == 1);
        BusinessCopy(drawer, drawerCopy, "drawer-content");
        BusinessCopy(drawer, drawerCopy, "drawer-action");
        Tabs tabs = new Tabs();
        tabs.Add("first", false);
        tabs.Page(0).Add(BusinessLabel("tab-page"));
        Tabs tabsCopy = (Tabs)Html.Clone(tabs);
        Check("tab model cloned", tabsCopy.tabs.Count == 1 && tabsCopy.tabs[0] != tabs.tabs[0]);
        Check("tab page parent", tabsCopy.Page(0).children[0].parent == tabsCopy.Page(0));
        BusinessCopy(tabs, tabsCopy, "tab-page");
        Console.WriteLine("composite business content clones once with independent parents");
    }

    static Control DynamicTagsClicks(FactoryLifetimeWatch watch) {
        DynamicTags tags = new DynamicTags();
        tags.Change.Add(Changed);
        changes = 0;
        ClickPart(tags.children[0]);
        Check("dynamic tags add starts editor", tags.children[0] is Input);
        ((Input)tags.children[0]).SetText("first");
        tags.FinishEdit(true);
        Check("dynamic tags edit adds item", tags.Count() == 1 && tags.TextAt(0) == "first" && changes == 1);
        Tag tag = (Tag)tags.children[0];
        tag.Close.Raise();
        Check("dynamic tags close removes item", tags.Count() == 0 && changes == 2);
        tags.Add("second");
        DynamicTags copy = (DynamicTags)Html.Clone(tags);
        Check("dynamic tags clone copies model", copy.Count() == 1 && copy.TextAt(0) == "second");
        copy.RemoveAt(0);
        Check("dynamic tags clone model independent", tags.Count() == 1 && copy.Count() == 0);
        watch.code = tags;
        return tags.children[tags.children.Count - 1];
    }

    static Control CalendarClicks(FactoryLifetimeWatch watch) {
        Calendar calendar = new Calendar();
        calendar.SetProp("value", "2026-06-15");
        ClickPart(calendar.prevBtn);
        Check("calendar previous", calendar.viewYear == 2026 && calendar.viewMonth == 5);
        ClickPart(calendar.nextBtn);
        Check("calendar next", calendar.viewMonth == 6);
        ClickPart(calendar.todayBtn);
        Check("calendar today navigation", calendar.viewYear == Calendar.TodayRef().Year()
            && calendar.viewMonth == Calendar.TodayRef().Month());
        ClickPart(calendar.nowBtn);
        Check("calendar picks today", calendar.selected.Equals(Calendar.TodayRef()));
        ClickPart(calendar.clearBtn);
        Check("calendar clears date", calendar.selected == null);
        CalendarCell cell = calendar.cells[10];
        ClickPart(cell);
        Check("calendar cell selects", calendar.selected != null && calendar.selected.Equals(cell.date));
        watch.code = calendar;
        watch.html = cell;
        return cell;
    }

    static void BreadcrumbItems() {
        Breadcrumb breadcrumb = new Breadcrumb();
        breadcrumb.SetProp("items", "Home,Page");
        Check("breadcrumb nonempty items bounded", breadcrumb.items.Count == 2 && breadcrumb.children.Count == 3);
        breadcrumb.SetProp("items", "One,Two,Three");
        Check("breadcrumb replacement does not accumulate", breadcrumb.items.Count == 3
            && breadcrumb.children.Count == 5 && breadcrumb.items[0] == "One");
        Breadcrumb copy = (Breadcrumb)Html.Clone(breadcrumb);
        Check("breadcrumb clone model copied once", copy.items.Count == 3 && copy.children.Count == 5);
        Check("breadcrumb clone item parent", copy.children[0].parent == copy);
        Check("breadcrumb clone item independent", copy.children[0] != breadcrumb.children[0]);
        copy.SetProp("items", "Clone");
        Check("breadcrumb clone model independent", copy.items.Count == 1 && breadcrumb.items.Count == 3);
        breadcrumb.SetProp("items", "");
        Check("breadcrumb empty resets", breadcrumb.items.Count == 0 && breadcrumb.children.Count == 0);
        Breadcrumb embedded = new Breadcrumb();
        embedded.AddItem(new BreadcrumbItem(BusinessLabel("breadcrumb-content")));
        Breadcrumb embeddedCopy = (Breadcrumb)Html.Clone(embedded);
        Check("breadcrumb content copied once", embeddedCopy.children.Count == 1);
        BusinessCopy(embedded, embeddedCopy, "breadcrumb-content");
        Steps steps = new Steps();
        steps.AddStepDesc("first", "detail");
        steps.BuildSteps();
        Steps stepsCopy = (Steps)Html.Clone(steps);
        Check("steps model cloned", stepsCopy.steps.Count == 1 && stepsCopy.steps[0] != steps.steps[0]
            && stepsCopy.steps[0].desc == "detail" && stepsCopy.children.Count == 1);
        Timeline timeline = new Timeline();
        timeline.AddItem("now", "timeline title", "timeline detail");
        timeline.BuildTree();
        Timeline timelineCopy = (Timeline)Html.Clone(timeline);
        Check("timeline model cloned", timelineCopy.items.Count == 1 && timelineCopy.items[0] != timeline.items[0]
            && timelineCopy.children.Count == 1);
        Check("timeline model independent", timelineCopy.items[0].title == "timeline title");
        Console.WriteLine("breadcrumb replacement and composite models stay bounded");
    }

    static UiEvent GraphPanEvents(FactoryLifetimeWatch watch) {
        GraphView graph = new GraphView();
        Check("graph pan default state", !graph.IsPanning());
        App app = App.CreateOffscreen("graph factory physical input", 240, 160);
        graph.UseApp(app);
        app.SetRootControl(graph);
        graph.MeasureTree(app);
        graph.Arrange(10, 10, 200, 120);
        app.ProcessOffscreenInput(2, 15, 20, 0, 0, 0, 0);
        Check("graph mouse down begins pan", graph.IsPanning());
        app.ProcessOffscreenInput(3, 15, 20, 0, 0, 0, 0);
        Check("graph mouse up ends pan", !graph.IsPanning());
        app.SetRootControl(null);
        app.canvas.Destroy();
        watch.code = graph;
        return graph.On.MouseDown;
    }

    static void RetainedChildren() {
        Empty empty = new Empty("title");
        Label extra = BusinessLabel("retained-empty");
        empty.Extra(extra);
        empty.Description("detail");
        empty.RebuildStructure();
        Check("empty retained extra reachable", empty.FindByName("retained-empty") == extra && extra.parent == empty);
        Result result = new Result();
        Label action = BusinessLabel("retained-result");
        result.Extra(action);
        result.Title("title");
        result.RebuildStructure();
        Check("result retained extra reachable", result.FindByName("retained-result") == action && action.parent == result);
        DynamicTags tags = new DynamicTags();
        tags.StartEdit();
        Control editor = tags.children[0];
        tags.RebuildChildren();
        tags.RebuildChildren();
        Check("dynamic tags retained editor reachable", tags.children.Count == 1
            && tags.children[0] == editor && editor.parent == tags);
        Statistic statistic = new Statistic();
        statistic.BuildTree();
        int parts = statistic.children.Count;
        statistic.BuildTree();
        statistic.BuildTree();
        Check("statistic retained parts reachable", parts > 0 && statistic.children.Count == parts);
        foreach (Control child in statistic.children) { Check("statistic retained part parent", child.parent == statistic); }
        Tabs tabs = new Tabs();
        tabs.Add("page", false);
        Panel page = tabs.Page(0);
        Label content = BusinessLabel("retained-page");
        page.Add(content);
        tabs.BuildTree();
        tabs.BuildTree();
        Check("tab retained page root reachable", tabs.FindByName("retained-page") == content);
        Check("tab retained page parent", page.parent == tabs.contentBox && content.parent == page);
        Console.WriteLine("retained composite children keep reachable parent topology");
    }

    static void AuthoredPair(Control root) {
        Control first = root.FindByName("authored-first");
        Control second = root.FindByName("authored-second");
        Check(root.Kind() + " authored pair reachable", first != null && second != null);
        Check(root.Kind() + " authored pair same container", first.parent == second.parent && first.parent != null);
        Check(root.Kind() + " authored pair column layout", first.parent is Panel
            && ((Panel)first.parent).flexFlow == 1 && first.parent.StyleFlexDir() == 1);
        Check(root.Kind() + " authored pair ordered", first.parent.children.Count == 2
            && first.parent.children[0] == first && first.parent.children[1] == second);
    }

    static void AuthoredClone(Control source) {
        AuthoredPair(source);
        Control copy = Html.Clone(source);
        AuthoredPair(copy);
        Control original = source.FindByName("authored-first");
        Control child = copy.FindByName("authored-first");
        Check(source.Kind() + " authored clone deep independent", child != original && child.parent != original.parent);
        child.SetProp("text", "copy only");
        Check(source.Kind() + " authored clone source stable", original.GetProp("text") == "business text");
        source.SetProp("title", "rebuilt source");
        copy.SetProp("title", "rebuilt copy");
        AuthoredPair(source);
        AuthoredPair(copy);
    }

    static void AuthoredChildren() {
        Card card = new Card() { Children = { BusinessLabel("authored-first"), BusinessLabel("authored-second") } };
        Empty empty = new Empty() { Children = { BusinessLabel("authored-first"), BusinessLabel("authored-second") } };
        Result result = new Result() { Children = { BusinessLabel("authored-first"), BusinessLabel("authored-second") } };
        AuthoredClone(card);
        AuthoredClone(empty);
        AuthoredClone(result);
        string[] kinds = new string[]{"Card", "Empty", "Result"};
        foreach (string kind in kinds) {
            Control html = One("<zan-" + kind.ToLower() + "><zan-label text=\"business text\" id=\"authored-first\" />"
                + "<zan-label text=\"business text\" id=\"authored-second\" /></zan-" + kind.ToLower() + ">");
            Check(kind + " HTML authored kind", html.Kind() == kind);
            AuthoredClone(html);
        }
        Console.WriteLine("authored initializer and HTML children preserve order and independent clones");
    }

    static void Aliases() {
        Check("case insensitive factory", ControlFactory.Create("rAdIoBuTtOn") is Radio);
        Check("unknown factory misses", ControlFactory.Create("MissingFactoryKind") == null);
        Check("grid alias unchanged", Html.TagToKind("grid") == "DataGrid"
            && Html.TagToKind("zan-grid") == "DataGrid");
        Check("ribbon alias unchanged", One("<ribbon></ribbon>") is ToolStrip);
        Check("alert alias unchanged", One("<alert></alert>") is AlertBox);
        Check("radio alias unchanged", One("<radio-button></radio-button>") is Radio);
        Console.WriteLine("factory misses, casing and HTML aliases preserved");
    }

    static void Main() {
        // Construction alone must not implicitly install the whole package.
        Button direct = new Button("direct");
        Check("explicit installation", !ControlFactory.Has("Button") && direct.Kind() == "Button");
        ControlBootstrap.Install();
        List<string> kinds = ControlFactory.Kinds();
        int installedCount = kinds.Count;
        ControlBootstrap.Install();
        Check("idempotent install", ControlFactory.Kinds().Count == installedCount);
        Check("optional package boundary", !ControlFactory.Has("DataGrid")
            && !ControlFactory.Has("Transfer") && !ControlFactory.Has("ChartHost"));
        tested = new List<string>();
        watches = new List<FactoryLifetimeWatch>();
        lifetimeFailures = new List<string>();
        AllKinds();
        FlexProperties();
        GridProperties();
        CloneMetadataProperties();
        CompositeContent();
        BreadcrumbItems();
        RetainedChildren();
        AuthoredChildren();
        Aliases();
        FactoryLifetimeWatch watch = new FactoryLifetimeWatch();
        RadioForms(watch);
        Check("button radio forms release", watch.code == null && watch.made == null
            && watch.html == null && watch.htmlClone == null);
        Control orphan = OrphanIndicator(watch);
        Check("indicator does not retain radio", watch.code == null);
        orphan.SyncBinding();
        Check("orphan indicator safely resets", !orphan.HasClass("selected")
            && !orphan.children[0].Visible);
        Console.WriteLine("radio input, clone isolation and weak cleanup agree");
        Control star = RateClicks(watch);
        Check("retained star does not retain rate", watch.code == null);
        Control.RouteEvent(star, new RoutedEventArgs("Click", star));
        Check("orphan star callback safely ignores click", changes == 2);
        Console.WriteLine("rate child clicks and weak cleanup agree");
        Control next = PaginationClicks(watch);
        Check("retained page button does not retain pagination", watch.code == null && watch.html == null);
        ClickPart(next);
        Check("orphan page button ignores click", changes == 5);
        Console.WriteLine("pagination child actions and weak cleanup agree");
        Control addTag = DynamicTagsClicks(watch);
        Check("retained tag button releases owner", watch.code == null);
        ClickPart(addTag);
        Console.WriteLine("dynamic tag actions, model clone and weak cleanup agree");
        Control cell = CalendarClicks(watch);
        Check("retained calendar cell releases owner", watch.code == null);
        ClickPart(cell);
        Console.WriteLine("calendar actions, cell selection and weak cleanup agree");
        UiEvent pan = GraphPanEvents(watch);
        Check("retained graph event releases owner", watch.code == null);
        pan.Raise();
        Console.WriteLine("graph pan events and weak cleanup agree");
        tested = null;
        watches = null;
        lifetimeFailures = null;
        Console.WriteLine("CONTROL_FACTORY_EQUIVALENCE_OK");
    }
}
