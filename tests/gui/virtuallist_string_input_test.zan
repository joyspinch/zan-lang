using System;
using Gui;
using Gui.Widget;

class VirtualStringEvents {
    public int selections;
    public int activations;
    public weak Control sender;
    public bool clearOnSelect;
    public void Selected(Control control) {
        selections = selections + 1;
        sender = control;
        if (clearOnSelect) { ((VirtualList)control).SetItems(new List<string>()); }
    }
    public void Activated(Control control) { activations = activations + 1; sender = control; }
}

class VirtualListStringInputTest {
    static void Check(bool ok, string label) {
        if (!ok) { throw new Exception("VirtualList string input: " + label); }
    }

    static void Click(Form form, Control row) {
        int x = row.bx + 20;
        int y = row.by + row.bh / 2;
        form.ProcessOffscreenInput(2, x, y, 0, 0, 0, 0);
        form.ProcessOffscreenInput(3, x, y, 0, 0, 0, 0);
    }

    static void Main() {
        App sentinel = App.CreateOffscreen("sentinel", 1, 1);
        Form form = Form.CreateOffscreen("Strings", 240, 120);
        App app = form.GetApp();
        app.SetChromeVisible(false);
        VirtualList list = new VirtualList();
        list.SetProp("style", "width:100%;height:100%");
        list.SetRowHeight(24);
        List<string> rows = new List<string>();
        for (int i = 0; i < 1000; i = i + 1) { rows.Add("row " + Convert.ToString(i)); }
        list.SetItems(rows);
        VirtualStringEvents events = new VirtualStringEvents();
        list.BindEvent("Select", events.Selected);
        list.BindEvent("Activate", events.Activated);
        form.Add(list);
        form.ProcessOffscreenInput(1, 0, 0, 0, 0, 0, 0);
        Check(list.ChildCount() > 0 && list.ChildCount() < 10, "only visible string rows are retained");
        Control first = list.ChildAt(0);
        Control second = list.ChildAt(1);
        Check(first is Button && ((Button)first).Label() == "row 0", "string row uses real caption control");
        Click(form, first);
        Click(form, second);
        Check(list.Selected() == 1 && list.SelectedText() == "row 1" && events.selections == 2
            && events.activations == 2 && events.sender == list, "consecutive input works before paint");
        form.CaptureSnapshot();
        form.CaptureSnapshot();
        Check(list.ChildAt(0) == first && list.ChildAt(1) == second
            && events.selections == 2 && events.activations == 2, "paint preserves rows and never replays events");
        rows[1] = "updated";
        form.ProcessOffscreenInput(1, 0, 0, 0, 0, 0, 0);
        Check(((Button)second).Label() == "updated", "shared data edits update prepared caption");
        list.SetScrollTop(app.Scale(24));
        form.ProcessOffscreenInput(1, 0, 0, 0, 0, 0, 0);
        Check(list.ChildAt(0) == second && first.Parent() == null, "scroll preserves overlap and retires departure");
        events.clearOnSelect = true;
        Control next = list.ChildAt(1);
        Click(form, next);
        Check(list.Count() == 0 && list.ChildCount() == 0 && events.selections == 3
            && events.activations == 2, "selection callback replacing data cancels stale activation");
        app.SetRootControl(null);
        app.StopLoop();
        app.canvas.Destroy();
        app.canvas = null;
        sentinel.StopLoop();
        sentinel.canvas.Destroy();
        sentinel.canvas = null;
        Console.WriteLine("VIRTUALLIST_STRING_INPUT_OK");
    }
}
