using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

class SkinCompatRegressionTest {
    static void Check(bool ok, string label) {
        if (!ok) { throw new Exception("SkinCompat: " + label); }
    }

    static int Luma(int argb) {
        int r = (argb >> 16) & 255;
        int g = (argb >> 8) & 255;
        int b = argb & 255;
        return (r * 299 + g * 587 + b * 114) / 1000;
    }

    static void CheckIcons() {
        Check(IconSvgData.IndexOf("bold") >= 0, "tabler.json includes bold icon");
        Check(IconSvgData.IndexOf("italic") >= 0, "tabler.json includes italic icon");
        Check(IconSvgData.IndexOf("underline") >= 0, "tabler.json includes underline icon");
    }

    static void CheckToolStripLiveSwitch(App app) {
        ToolStrip bar = new ToolStrip();
        bar.Add("New", "plus");
        bar.Add("Save", "device-floppy");
        bar.UseApp(app);

        Check(app.UseSkin("liquid"), "load liquid skin");
        bar.MeasureTree(app, 600);
        bar.Arrange(0, 0, 600, 36);
        StyleBox liquidBox = bar.Box(app);
        Check(bar.styleBg == 0, "liquid ToolStrip must not latch CSS bg into styleBg");
        Check(liquidBox.bg != 0 && Luma(liquidBox.bg) > 200, "liquid ToolStrip resolves light glass bg");

        Check(app.UseSkin("starlight"), "switch live liquid -> starlight");
        bar.MeasureTree(app, 600);
        bar.Arrange(0, 0, 600, 36);
        StyleBox starBox = bar.Box(app);
        Check(bar.styleBg == 0, "starlight ToolStrip keeps styleBg clear");
        Check(starBox.bg != 0 && Luma(starBox.bg) < 80,
            "starlight ToolStrip resolves dark nebula bg after live switch from liquid");
        Check(starBox.borderW > 0 && starBox.radius > 0, "starlight ToolStrip resolves framed rounded surface");

        bar.SetTint(0xFF223344);
        bar.MeasureTree(app, 600);
        Check(bar.styleBg == 0xFF223344 && bar.Box(app).bg == 0xFF223344,
            "explicit SetTint overrides ToolStrip bg");
        bar.SetTint(0);
        Check(app.UseSkin("porcelain"), "switch back to porcelain after clearing tint");
        bar.MeasureTree(app, 600);
        Check(bar.styleBg == 0 && Luma(bar.Box(app).bg) > 180,
            "clearing tint restores live CSS skin switching");
    }

    static void CheckRadioCheckboxSurface(App app) {
        Check(app.UseSkin("starlight"), "load starlight for Radio/Checkbox check");
        Radio bordered = new Radio(1, "Bordered");
        bordered.Bordered = true;
        bordered.Value = 1;
        Check(!bordered.wiresOwnEvents, "Radio must not suppress CSS surface painting");

        Checkbox cb = new Checkbox("Check");
        Check(!cb.wiresOwnEvents, "Checkbox must not suppress CSS surface painting");

        RadioGroup group = new RadioGroup();
        group.ButtonStyle = true;
        group.AddOption("Left", 0);
        group.AddOption("Center", 1);
        group.AddOption("Right", 2);
        group.Value = 1;

        Panel root = new Panel();
        root.Add(bordered);
        root.Add(cb);
        root.Add(group);
        root.UseApp(app);
        root.MeasureTree(app, 600);
        root.Arrange(0, 0, 600, 120);

        Check(Style.Has(bordered.Class, "bordered") && Style.Has(bordered.Class, "selected"),
            "bordered selected Radio syncs both bordered and selected classes");
        StyleBox rBox = bordered.Box(app);
        Check(rBox.borderW > 0 && rBox.borderColor == app.theme.primary && rBox.bg != 0,
            "bordered selected Radio resolves primary border and soft bg");

        Check(Style.Has(group.Class, "button"), "RadioGroup.ButtonStyle adds .button class");
        Radio r0 = (Radio)group.ChildAt(0);
        Radio r1 = (Radio)group.ChildAt(1);
        Radio r2 = (Radio)group.ChildAt(2);
        Check(Style.Has(r0.Class, "rb-first") && Style.Has(r2.Class, "rb-last"),
            "RadioGroup button segments mark rb-first and rb-last");
        Check(Style.Has(r1.Class, "selected") && !Style.Has(r0.Class, "selected"),
            "RadioGroup selected segment toggles .selected");
        StyleBox segSel = r1.Box(app);
        Check(segSel.bg != 0 && segSel.borderColor == app.theme.primary,
            "selected RadioButton resolves soft fill and primary border");
    }

    static void CheckBrutalMicroParts(App app) {
        Check(app.UseSkin("brutal"), "load brutal skin");
        Check(app.theme.brutal == 1, "brutal skin activates brutal flag");

        List<string> microClasses = new List<string>{
            "divider-line", "step-connector", "timeline-line", "timeline-line-h",
            "countdown-track", "countdown-fill", "radio-dot", "slider-thumb",
            "tag-close", "ribbon-cmd", "ribbon-tab", "input-number-input",
            "input-number-btn", "calendar-prev", "calendar-next", "sessionlist-action"
        };
        for (int i = 0; i < microClasses.Count; i = i + 1) {
            string cls = microClasses[i];
            StyleBox box = Style.OfRef(app, "control", cls, Style.SNormal());
            Check(box.shadow == 0, "brutal must not synthesize shadow on ." + cls);
        }

        StyleBox skel = Style.OfRef(app, "skeleton", "", Style.SNormal());
        Check(skel.shadow == 0 && skel.BorderWOr(0) < 2,
            "brutal must not synthesize heavy border/shadow on skeleton");

        StyleBox card = Style.OfRef(app, "card", "", Style.SNormal());
        Check(card.shadow != 0 && card.BorderWOr(0) >= 2,
            "brutal keeps signature thick border and hard shadow on card");
    }

    static void CheckPerSideBorderPainting(App app) {
        Canvas c = app.canvas;
        Check(c != null, "offscreen canvas ready for per-side border pixel check");
        int bgClear = 0xFF101820;
        int fill = 0xFF203040;
        int stroke = 0xFFFF3366;

        // Case 1: shorthand borderW=2 + borderLeftW=2 + other sides unset (-1) -> must paint all 4 borders
        c.Clear(bgClear);
        StyleBox firstSeg = new StyleBox();
        firstSeg.bg = fill;
        firstSeg.borderW = 2;
        firstSeg.borderLeftW = 2;
        firstSeg.borderColor = stroke;
        firstSeg.radius = 8;
        firstSeg.Paint(app, 20, 20, 100, 40);
        Check(c.GetPixel(70, 20) == stroke, "per-side border inheritance paints top border");
        Check(c.GetPixel(70, 59) == stroke, "per-side border inheritance paints bottom border");
        Check(c.GetPixel(20, 40) == stroke, "per-side border inheritance paints left border");
        Check(c.GetPixel(119, 40) == stroke, "per-side border inheritance paints right border");
        Check(c.GetPixel(70, 40) == fill, "per-side border inheritance preserves interior fill");

        // Case 2: shorthand borderW=2 + borderLeftW=0 -> must hide ONLY left border, keep top/right/bottom
        c.Clear(bgClear);
        StyleBox joinedSeg = new StyleBox();
        joinedSeg.bg = fill;
        joinedSeg.borderW = 2;
        joinedSeg.borderLeftW = 0;
        joinedSeg.borderColor = stroke;
        joinedSeg.radius = 0;
        joinedSeg.Paint(app, 20, 20, 100, 40);
        Check(c.GetPixel(70, 20) == stroke, "joined segment paints top border");
        Check(c.GetPixel(70, 59) == stroke, "joined segment paints bottom border");
        Check(c.GetPixel(119, 40) == stroke, "joined segment paints right border");
        Check(c.GetPixel(20, 40) == fill, "joined segment hides left border when borderLeftW == 0");
    }

    static void CheckOpacityLayerShadowNotClipped(App app) {
        Check(app.UseSkin("clay"), "load clay for opacity layer shadow check");
        StyleBox lockTag = Style.OfRef(app, "tag", "graphnodelock tiny", Style.SNormal());
        Check(lockTag.shadow == 0 && lockTag.shadow2 == 0 && lockTag.sheen == 0 && lockTag.BorderWOr(0) == 0,
            "clay tag.graphnodelock suppresses inherited tag shadow, sheen, and border");

        Card lockedCard = new Card();
        lockedCard.Class = "graphnode graphnodelocked";
        lockedCard.Add(new Label("Locked node"));
        Panel root = new Panel();
        root.Add(lockedCard);
        app.SetRootControl(root);
        root.UseApp(app);
        root.MeasureTree(app, 400);
        root.Arrange(0, 0, 400, 300);
        lockedCard.Arrange(80, 80, 200, 100);

        Canvas c = app.canvas;
        int clearCol = 0xFFE4E9F2;
        c.Clear(clearCol);
        lockedCard.RenderTree(app);

        // Card bounds are [80..280, 80..180]; clay drop shadow extends ~+7,+9 with blur 20.
        // Pixels just outside bottom and right edges must show shadow falloff instead of clearCol.
        int belowShadow = c.GetPixel(180, 186);
        int rightShadow = c.GetPixel(286, 130);
        Check(belowShadow != clearCol && Luma(belowShadow) < Luma(clearCol),
            "opacity-layer Card paints outer bottom drop shadow beyond (bx, by, bw, bh)");
        Check(rightShadow != clearCol && Luma(rightShadow) < Luma(clearCol),
            "opacity-layer Card paints outer right drop shadow beyond (bx, by, bw, bh)");
        app.SetRootControl(null);
    }

    static void CheckPressedButtonShadowAndDamage(App app) {
        Check(app.UseSkin("clay"), "load clay for pressed button shadow & damage check");
        Button btn = new Button();
        btn.Text = "Copy";
        btn.Class = "small";
        Panel root = new Panel();
        root.Add(btn);
        app.SetRootControl(root);
        root.UseApp(app);
        root.MeasureTree(app, 400);
        root.Arrange(0, 0, 400, 300);
        btn.Arrange(80, 80, 120, 36);

        Canvas c = app.canvas;
        int clearCol = 0xFFE4E9F2;
        int baseLuma = Luma(clearCol);
        app.mouseX = 120;
        app.mouseY = 98;
        app.CapturePointer(btn);
        app.focus.hoveredId = btn.WidgetId();
        app.focus.pressedId = btn.WidgetId();

        c.Clear(clearCol);
        btn.RenderTree(app);

        // Clay button has top-left white highlight (-3 -3 8 #f5ffffff) and bottom-right drop shadow (5 6 13 #3c202c44).
        // Under active scale(0.975) offscreen layer, top highlight must stay brighter than background
        // (no premultiplied darkening) and bottom shadow must extend smoothly outside bounds.
        int topHighlight = c.GetPixel(140, 76);
        int bottomShadow = c.GetPixel(140, 121);
        Check(Luma(topHighlight) > baseLuma,
            "pressed clay button top-left highlight shadow stays brighter than background in scaled layer");
        Check(Luma(bottomShadow) < baseLuma,
            "pressed clay button bottom-right drop shadow extends beyond bounds in scaled layer");

        int padX = btn.ShadowDamagePadX(app);
        int padY = btn.ShadowDamagePadY(app);
        Check(padX >= 15 && padY >= 15,
            "clay button shadow damage pad covers full outer shadow extent (" + padX + "," + padY + ")");

        app.ReleasePointerCapture();
        app.focus.hoveredId = 0;
        app.focus.pressedId = 0;
        app.SetRootControl(null);
    }

    static void CheckAll16Skins(App app) {
        List<string> skins = Skin.BuiltInNames();
        Check(skins.Count == 16, "all 16 built-in skins present");
        Prompt prompt = new Prompt("Rename");
        TextArea ta = new TextArea("Placeholder");
        DatePicker dp = new DatePicker();
        StatusBar sb = new StatusBar();
        sb.AddLeft("Ready");
        ToolStrip ts = new ToolStrip();
        ts.Add("Run", "player-play");
        Tag tag = new Tag("Badge");
        RadioGroup rg = new RadioGroup();
        rg.ButtonStyle = true;
        rg.AddOption("First", 0);
        rg.AddOption("Mid", 1);
        rg.AddOption("Last", 2);
        rg.Value = 0;

        Panel stage = new Panel();
        stage.Add(prompt);
        stage.Add(ta);
        stage.Add(dp);
        stage.Add(sb);
        stage.Add(ts);
        stage.Add(tag);
        stage.Add(rg);
        stage.UseApp(app);

        for (int i = 0; i < skins.Count; i = i + 1) {
            string name = skins[i];
            Check(app.UseSkin(name), "load skin " + name);

            StyleBox numIn = Style.OfRef(app, "input", "input-number-input", Style.SNormal());
            Check(numIn.BorderWOr(0) == 0 && numIn.shadow == 0,
                name + ": input.input-number-input has no nested border or shadow");

            StyleBox numInFocus = Style.OfRef(app, "input", "input-number-input", Style.SFocus());
            Check(numInFocus.BorderWOr(0) == 0 && numInFocus.shadow == 0,
                name + ": focused input.input-number-input has no nested border or shadow");

            StyleBox numPlus = Style.OfRef(app, "button", "medium input-number-btn input-number-plus", Style.SNormal());
            Check(numPlus.shadow == 0 && numPlus.bgTo == 0 && numPlus.sheen == 0 && numPlus.PadLOr(0) == 0
                && (name == "brutal" || numPlus.bg == 0),
                name + ": enabled InputNumber plus button stays flat without button shadow or gradient fill");

            StyleBox tagClose = Style.OfRef(app, "button", "tag-close", Style.SNormal());
            Check(tagClose.BorderWOr(0) == 0 && tagClose.shadow == 0,
                name + ": button.tag-close has no stray border or shadow");

            StyleBox lockTag = Style.OfRef(app, "tag", "graphnodelock tiny", Style.SNormal());
            Check(lockTag.BorderWOr(0) == 0 && lockTag.shadow == 0 && lockTag.shadow2 == 0 && lockTag.sheen == 0,
                name + ": tag.graphnodelock stays flat without inherited border, shadow, or sheen");

            StyleBox ribSmall = Style.OfRef(app, "button", "ribbon-cmd small", Style.SNormal());
            Check(ribSmall.justify == 0, name + ": button.ribbon-cmd.small is left-aligned");
            Check(ribSmall.RadiusOr(0) <= 6, name + ": button.ribbon-cmd.small radius is restrained");

            StyleBox calPrev = Style.OfRef(app, "button", "ghost small calendar-prev", Style.SNormal());
            Check(calPrev.borderColor == 0, name + ": calendar-prev ghost button uses transparent resting border");

            StyleBox sessAct = Style.OfRef(app, "button", "ghost small sessionlist-action", Style.SNormal());
            Check(sessAct.borderColor == 0, name + ": sessionlist-action ghost button uses transparent resting border");

            // Measure & arrange shared widget stage under this skin
            stage.MeasureTree(app, 640);
            prompt.Arrange(0, 0, 320, 140);
            ta.Arrange(0, 0, 260, 100);
            dp.Arrange(0, 0, 220, 32);
            sb.Arrange(0, 0, 400, sb.prefH > 0 ? sb.prefH : 28);
            ts.Arrange(0, 0, 400, ts.prefH > 0 ? ts.prefH : 36);
            tag.Arrange(0, 0, tag.prefW > 0 ? tag.prefW : 80, tag.prefH > 0 ? tag.prefH : 24);
            rg.Arrange(0, 0, 300, 36);

            StyleBox promptBox = prompt.Box(app);
            Control promptTitle = prompt.ChildAt(0);
            Check(promptTitle != null
                && promptTitle.bx >= promptBox.CornerSafePadH(320, 140)
                && promptTitle.by >= promptBox.CornerSafePadV(320, 140),
                name + ": Prompt title clears rounded corners");
            Check(prompt.input.bx >= promptBox.CornerSafePadH(320, 140)
                && prompt.input.bx + prompt.input.bw <= 320 - promptBox.CornerSafePadH(320, 140),
                name + ": Prompt input clears left/right edges");

            Rect taView = ta.ScrollViewport();
            StyleBox taBox = ta.Box(app);
            Check(taView.x >= taBox.CornerSafePadH(260, 100)
                && taView.y >= taBox.CornerSafePadV(260, 100),
                name + ": TextArea viewport clears rounded corners");

            StyleBox dpBox = dp.Box(app);
            int dpSafeH = dpBox.CornerSafePadH(220, 32);
            int dpRightGap = 220 - (dp.trigger.bx + dp.trigger.bw);
            if (dpSafeH > 8) {
                Check(dpRightGap > 0, name + ": rounded DatePicker insets trigger button from right arc");
            }

            StyleBox sbBox = sb.Box(app);
            Check(sb.padL >= sbBox.CornerSafePadH(sb.prefH * 2, sb.prefH),
                name + ": StatusBar padL clears rounded corners");

            StyleBox tsBox = ts.Box(app);
            Check(ts.padL >= tsBox.CornerSafePadH(ts.prefH * 2, ts.prefH),
                name + ": ToolStrip padL clears rounded corners");

            StyleBox tagBox = tag.Box(app);
            int tagH = tagBox.HeightOr(app.theme.heightTiny);
            int tagSafeH = tagBox.CornerSafePadH(tagH * 3, tagH);
            Check(tag.StylePadL() >= tagSafeH && tag.StylePadR() >= tagSafeH,
                name + ": Tag horizontal padding clears corner arc");

            Radio r0 = (Radio)rg.ChildAt(0);
            Radio r1 = (Radio)rg.ChildAt(1);
            StyleBox rb0 = r0.Box(app);
            StyleBox rb1 = r1.Box(app);
            Check(rb0.BorderLeftPx() > 0 && rb0.BorderTopPx() > 0
                && rb0.BorderRightPx() > 0 && rb0.BorderBottomPx() > 0,
                name + ": RadioGroup rb-first retains all 4 borders");
            Check(rb1.BorderLeftPx() == 0 && rb1.BorderTopPx() > 0
                && rb1.BorderRightPx() > 0 && rb1.BorderBottomPx() > 0,
                name + ": RadioGroup joined segment hides only left border");
        }
    }

    static void CheckRoundedCornerGeometry(App app) {
        StyleBox sharp = new StyleBox();
        sharp.radius = 0;
        Check(sharp.EffectiveRadius(200, 32) == 0, "sharp box effective radius is 0");
        Check(sharp.CornerSafePadH(200, 32) == 0 && sharp.CornerSafePadV(200, 32) == 0,
            "sharp box corner safe pads are 0");

        StyleBox rounded = new StyleBox();
        rounded.radius = 16;
        Check(rounded.EffectiveRadius(200, 80) == 16, "rounded box preserves radius under half-height");
        Check(rounded.CornerSafePadH(200, 80) == 12 && rounded.CornerSafePadV(200, 80) == 8,
            "rounded box computes 3/4 H and 1/2 V safe pads");

        StyleBox pill = new StyleBox();
        pill.radius = 999;
        Check(pill.EffectiveRadius(200, 32) == 16, "pill box clamps effective radius to h/2");
        Check(pill.CornerSafePadH(200, 32) == 12, "pill box computes end-cap safe inset");

        // starlight: large-radius Prompt, TextArea, StatusBar, ToolStrip, Transfer, Tag
        Check(app.UseSkin("starlight"), "load starlight for rounded geometry check");
        StyleBox promptStyle = Style.OfRef(app, "prompt", "", Style.SNormal());
        Check(promptStyle.PadLOr(0) >= 12 && promptStyle.PadTOr(0) >= 12,
            "prompt resolves generous outer padding to clear rounded corners");

        Prompt prompt = new Prompt("Rename");
        prompt.UseApp(app);
        prompt.MeasureTree(app, 320);
        prompt.Arrange(0, 0, 320, 140);
        Control promptTitle = prompt.ChildAt(0);
        Check(promptTitle != null && promptTitle.bx >= 12 && promptTitle.by >= 12,
            "prompt title clears starlight top-left arc");
        Check(prompt.input.bx >= 12 && prompt.input.bx + prompt.input.bw <= 320 - 12,
            "prompt input clears starlight left/right edges");

        TextArea ta = new TextArea("Placeholder");
        ta.UseApp(app);
        ta.MeasureTree(app, 260);
        ta.Arrange(0, 0, 260, 100);
        Rect taStarView = ta.ScrollViewport();
        StyleBox taStarStyle = Style.OfRef(app, "textarea", "", Style.SNormal());
        Check(taStarView.x >= taStarStyle.CornerSafePadH(260, 100)
            && taStarView.y >= taStarStyle.CornerSafePadV(260, 100),
            "starlight TextArea viewport clears rounded corners");

        StatusBar sb = new StatusBar();
        sb.AddLeft("Ready");
        sb.UseApp(app);
        sb.MeasureTree(app, 400);
        StyleBox sbStarStyle = Style.OfRef(app, "statusbar", "", Style.SNormal());
        Check(sb.padL >= sbStarStyle.CornerSafePadH(sb.prefH * 2, sb.prefH),
            "starlight StatusBar padL clears rounded corners");

        ToolStrip ts = new ToolStrip();
        ts.Add("Run", "player-play");
        ts.UseApp(app);
        ts.MeasureTree(app, 400);
        StyleBox tsStarStyle = Style.OfRef(app, "toolstrip", "", Style.SNormal());
        Check(ts.padL >= tsStarStyle.CornerSafePadH(ts.prefH * 2, ts.prefH),
            "starlight ToolStrip padL clears rounded corners");

        Tag starTagCtrl = new Tag("Star");
        starTagCtrl.Size = "large";
        starTagCtrl.UseApp(app);
        starTagCtrl.MeasureTree(app, 200);
        StyleBox starTag = starTagCtrl.Box(app);
        int starTagH = starTag.HeightOr(app.theme.heightTiny);
        int starSafeH = starTag.CornerSafePadH(starTagH * 3, starTagH);
        Check(starTag.RadiusOr(0) >= 100 && starSafeH >= 9
            && starTagCtrl.StylePadL() >= starSafeH && starTagCtrl.StylePadR() >= starSafeH,
            "starlight pill large Tag actively upgrades horizontal padding beyond CSS 8px");

        Tag starSmallTag = new Tag("Sm");
        starSmallTag.Size = "small";
        starSmallTag.UseApp(app);
        starSmallTag.MeasureTree(app, 200);
        Check(starSmallTag.StylePadL() >= 7 && starSmallTag.StylePadR() >= 7,
            "starlight pill small Tag actively upgrades horizontal padding beyond CSS 6px");

        StyleBox minusBtn = Style.OfRef(app, "button", "input-number-btn input-number-minus", Style.SNormal());
        StyleBox plusBtn = Style.OfRef(app, "button", "input-number-btn input-number-plus", Style.SNormal());
        Check(minusBtn.radiusTL > 0 && minusBtn.radiusBL > 0 && minusBtn.radiusTR == 0 && minusBtn.radiusBR == 0,
            "InputNumber minus button resolves concentric left corners");
        Check(plusBtn.radiusTR > 0 && plusBtn.radiusBR > 0 && plusBtn.radiusTL == 0 && plusBtn.radiusBL == 0,
            "InputNumber plus button resolves concentric right corners");

        StyleBox editorSurfStar = Style.Part(app, "codeeditor", "surface", "", "", "", Style.SNormal());
        Check(editorSurfStar.RadiusOr(0) > 0, "starlight codeeditor::surface resolves rounded radius");

        // liquid: pill DatePicker trigger inset, SelectBox/Dropdown content inset, Table concentric radii
        Check(app.UseSkin("liquid"), "load liquid for rounded geometry check");
        DatePicker dp = new DatePicker();
        dp.UseApp(app);
        dp.MeasureTree(app, 220);
        dp.Arrange(0, 0, 220, 32);
        int liquidTriggerRightGap = 220 - (dp.trigger.bx + dp.trigger.bw);
        Check(liquidTriggerRightGap > 0, "liquid pill DatePicker insets trigger button from right arc");

        StyleBox liqHdr = Style.OfRef(app, "control", "table-row table-header", Style.SNormal());
        Check(liqHdr.radiusTL == 13 && liqHdr.radiusTR == 13 && liqHdr.radiusBL == 0 && liqHdr.radiusBR == 0,
            "liquid Table header row resolves concentric 13px top corners");

        Card liqSmallCard = new Card();
        liqSmallCard.ClassName = "small";
        Label liqCardLbl = new Label("皮肤：");
        liqSmallCard.Add(liqCardLbl);
        liqSmallCard.UseApp(app);
        liqSmallCard.MeasureTree(app, 360);
        liqSmallCard.Arrange(0, 0, 360, 80);
        StyleBox liqCardBox = liqSmallCard.Box(app);
        Check(liqSmallCard.StylePadL() >= liqCardBox.CornerSafePadH(360, 80)
            && liqSmallCard.StylePadR() >= liqCardBox.CornerSafePadH(360, 80)
            && liqSmallCard.StylePadT() >= liqCardBox.CornerSafePadV(360, 80)
            && liqSmallCard.StylePadB() >= liqCardBox.CornerSafePadV(360, 80),
            "liquid Card.small upgrades H/V padding to clear 20px rounded corners");
        Check(liqCardLbl.bx >= liqCardBox.CornerSafePadH(360, 80)
            && liqCardLbl.by >= liqCardBox.CornerSafePadV(360, 80),
            "liquid Card.small child content clears top-left corner arc");

        Button liqSmallBtn = new Button("液态");
        liqSmallBtn.Size = "small";
        liqSmallBtn.UseApp(app);
        liqSmallBtn.MeasureTree(app, 200);
        StyleBox liqBtnBox = liqSmallBtn.Box(app);
        int liqBtnH = liqBtnBox.HeightOr(app.theme.heightSmall);
        int liqBtnSafeH = liqBtnBox.CornerSafePadH(liqBtnH * 3, liqBtnH);
        Check(liqSmallBtn.StylePadL() >= liqBtnSafeH
            && liqSmallBtn.StylePadR() >= liqBtnSafeH,
            "liquid pill Button.small clears semicircular end-cap arc");
        liqSmallBtn.Arrange(0, 0, liqSmallBtn.prefW, liqBtnH);
        Check(liqSmallBtn.ChildCount() > 0 && liqSmallBtn.ChildAt(0).bx >= liqBtnSafeH,
            "liquid pill Button.small arranged label clears left end-cap arc");

        Panel liqCardPanel = new Panel("card");
        liqCardPanel.ClassName = "card";
        Label liqPanelLbl = new Label("面板");
        liqCardPanel.Add(liqPanelLbl);
        liqCardPanel.UseApp(app);
        liqCardPanel.MeasureTree(app, 320);
        liqCardPanel.Arrange(0, 0, 320, 80);
        StyleBox liqPanelBox = liqCardPanel.Box(app);
        Check(liqPanelLbl.bx >= liqPanelBox.CornerSafePadH(320, 80)
            && liqPanelLbl.by >= liqPanelBox.CornerSafePadV(320, 80),
            "liquid Panel.card child content clears rounded top-left arc");

        // brutal: sharp skin has zero extra corner inset regressions
        Check(app.UseSkin("brutal"), "load brutal for sharp-corner parity check");
        liqSmallCard.MeasureTree(app, 360);
        liqSmallCard.Arrange(0, 0, 360, 80);
        Check(liqSmallCard.StylePadL() == app.theme.paddingSmall
            && liqSmallCard.StylePadT() == app.theme.paddingSmall,
            "brutal sharp Card.small keeps compact 8px padding without corner inflation");
        ta.MeasureTree(app, 260);
        ta.Arrange(0, 0, 260, 100);
        Rect taBrutalView = ta.ScrollViewport();
        Check(taBrutalView.x <= 8 && taBrutalView.y <= 8,
            "brutal TextArea preserves compact sharp-corner padding");

        dp.MeasureTree(app, 220);
        dp.Arrange(0, 0, 220, 32);
        Check(dp.trigger.bx + dp.trigger.bw == 220,
            "brutal sharp DatePicker keeps trigger flush with right edge");

        StyleBox editorSurfBrutal = Style.Part(app, "codeeditor", "surface", "", "", "", Style.SNormal());
        Check(editorSurfBrutal.RadiusOr(0) == 0, "brutal codeeditor::surface remains sharp");
    }

    static void CheckOverlayBoundsAndMenuStateParity(App app) {
        Check(app.UseSkin("porcelain"), "load porcelain for overlay/menu/css isolation checks");

        // 1. Custom TitleBar chrome: Drawer, Modal, and RichMenu must stay within ContentBounds
        bool prevChrome = app.ChromeVisible();
        app.SetChromeVisible(true);
        int topY = app.ContentTop();
        Check(topY > 0, "custom chrome reports positive ContentTop");

        Drawer drawer = new Drawer("Inspector");
        drawer.Placement("right");
        drawer.Width(320);
        drawer.Show();
        app.overlayHost.Push(app, null, drawer, true);
        Check(drawer.by == topY && drawer.bh == app.ClientHeight() - topY,
            "Drawer arranged via OverlayHost stays below TitleBar");
        Check(drawer.drawerBox.by == topY, "Drawer surface does not cover TitleBar");
        drawer.Hide();

        Modal modal = new Modal("Confirm");
        modal.Show();
        app.overlayHost.Push(app, null, modal, true);
        Check(modal.by == topY && modal.bh == app.ClientHeight() - topY,
            "Modal arranged via OverlayHost stays below TitleBar");
        Check(modal.closeBtn.Icon == "close", "Modal closeBtn uses standard close icon");
        modal.Hide();

        RichMenu rm = new RichMenu();
        List<MenuItem> rmItems = new List<MenuItem>();
        rmItems.Add(MenuItem.Item("Copy", "", 1));
        rmItems.Add(MenuItem.Item("Paste", "", 2));
        rm.SetItems(rmItems);
        Check(!RichMenu.HasLeadingColumn(rmItems), "text-only RichMenu omits redundant icon gutter");
        rm.ShowAt(app, 20, 0);
        Check(rm.by >= topY, "RichMenu clamps below custom TitleBar");
        rm.Close();

        app.SetChromeVisible(prevChrome);

        // 2. Dropdown marks selected item for unified selected-state rendering
        Dropdown<string> dd = new Dropdown<string>((string s) => s);
        List<string> ddOpts = new List<string>();
        ddOpts.Add("Alpha");
        ddOpts.Add("Beta");
        dd.Bind(ddOpts);
        dd.SelectIndex(1);
        List<MenuItem> synced = dd.SyncItems(app);
        Check(synced.Count == 2 && !synced[0].selected && synced[1].selected,
            "Dropdown SyncItems propagates selected index to RichMenu items");

        // 3. Unified hover / active / selected states across all menu/dropdown/select/list/tree widgets
        List<string> paritySkins = new List<string>();
        paritySkins.Add("porcelain");
        paritySkins.Add("obsidian");
        paritySkins.Add("clay");
        paritySkins.Add("liquid");
        paritySkins.Add("brutal");
        paritySkins.Add("cyber");
        for (int i = 0; i < paritySkins.Count; i = i + 1) {
            string sk = paritySkins[i];
            Check(app.UseSkin(sk), "load skin for menu state parity: " + sk);

            StyleBox richNorm = Style.PartRef(app, "contextmenu", "item", "", "", "", Style.SNormal());
            Check(richNorm.bg == 0 && richNorm.BorderWOr(0) == 0 && richNorm.shadow == 0,
                "RichMenu normal item does not inherit contextmenu popup surface on " + sk);

            StyleBox ctxHover = Style.OfRef(app, "button", "contextmenu-item row align-center ghost small", Style.SHover());
            StyleBox richHover = Style.PartRef(app, "contextmenu", "item", "", "", "", Style.SHover());
            StyleBox selOptHover = Style.OfRef(app, "button", "select-option align-left", Style.SHover());
            StyleBox cascHover = Style.PartRef(app, "select", "option", "option", "", "", Style.SHover());
            StyleBox navHover = Style.OfRef(app, "button", "menu-item row align-center gap-small", Style.SHover());
            StyleBox listHover = Style.FullRef(app, "listrow", "", "", Style.SHover());
            StyleBox treeHover = Style.PartRef(app, "treeview", "row", "row", "", "", Style.SHover());
            Check(ctxHover.bg == app.theme.bgHover && richHover.bg == app.theme.bgHover
                && selOptHover.bg == app.theme.bgHover && cascHover.bg == app.theme.bgHover
                && navHover.bg == app.theme.bgHover && listHover.bg == app.theme.bgHover
                && treeHover.bg == app.theme.bgHover,
                "hover bg matches theme.bgHover across all menu/select/list/tree widgets on " + sk);

            StyleBox ctxActive = Style.OfRef(app, "button", "contextmenu-item row align-center ghost small", Style.SActive());
            StyleBox richActive = Style.PartRef(app, "contextmenu", "item", "", "", "", Style.SActive());
            StyleBox selOptActive = Style.OfRef(app, "button", "select-option align-left", Style.SActive());
            StyleBox cascActive = Style.PartRef(app, "select", "option", "option", "", "", Style.SActive());
            StyleBox navActive = Style.OfRef(app, "button", "menu-item row align-center gap-small", Style.SActive());
            Check(ctxActive.bg == app.theme.bgActive && richActive.bg == app.theme.bgActive
                && selOptActive.bg == app.theme.bgActive && cascActive.bg == app.theme.bgActive
                && navActive.bg == app.theme.bgActive,
                "active bg matches theme.bgActive across all menu/dropdown/select widgets on " + sk);

            StyleBox richSel = Style.PartRef(app, "contextmenu", "item", "", "", "", Style.SSelected());
            StyleBox selOptSel = Style.OfRef(app, "button", "select-option align-left is-selected", Style.SNormal());
            StyleBox cascSel = Style.PartRef(app, "select", "option", "option", "", "", Style.SSelected());
            StyleBox navSel = Style.OfRef(app, "button", "menu-item row align-center gap-small active", Style.SNormal());
            StyleBox listSel = Style.FullRef(app, "listrow", "", "", Style.SSelected());
            StyleBox treeSel = Style.PartRef(app, "treeview", "row", "row", "", "", Style.SSelected());
            Check(richSel.bg != 0 && richSel.bg == selOptSel.bg && cascSel.bg == selOptSel.bg
                && navSel.bg == selOptSel.bg && listSel.bg == selOptSel.bg && treeSel.bg == selOptSel.bg,
                "selected bg unified across RichMenu/SelectBox/Cascade/Menu/ListView/TreeView on " + sk);
            Check(richSel.fg == app.theme.primary && selOptSel.fg == app.theme.primary
                && cascSel.fg == app.theme.primary && navSel.fg == app.theme.primary,
                "selected fg unified to theme.primary on " + sk);

            // 4. CSS isolation: internal chrome buttons must not be polluted by global skin rules
            StyleBox drClose = Style.OfRef(app, "button", "ghost small drawer-close ui-part-btn", Style.SNormal());
            StyleBox mdClose = Style.OfRef(app, "button", "ghost small modal-close ui-part-btn", Style.SNormal());
            StyleBox phBack = Style.OfRef(app, "button", "pageheader-back ghost ui-part-btn row align-center justify-center", Style.SNormal());
            Check(drClose.radius < 100 && mdClose.radius < 100 && phBack.radius < 100,
                "internal chrome buttons never inherit 999px capsule radius on " + sk);
            Check(drClose.shadow == 0 && mdClose.shadow == 0 && phBack.shadow == 0,
                "internal chrome buttons never inherit brutal/card drop shadows on " + sk);
            Check(drClose.BorderWOr(0) == mdClose.BorderWOr(0) && drClose.bg == mdClose.bg,
                "Drawer and Modal close buttons resolve identical styling on " + sk);
        }

        // 5. Dock tooltip painting must not mutate shared cached StyleBox opacity
        Check(app.UseSkin("porcelain"), "reload porcelain for Dock cache check");
        StyleBox sharedTipBefore = Style.PartRef(app, "dock", "tooltip", "tooltip", "", "", Style.SNormal());
        int origOpacity = sharedTipBefore.opacity;
        StyleBox copiedTip = Style.Part(app, "dock", "tooltip", "tooltip", "", "", Style.SNormal());
        copiedTip.opacity = 123;
        StyleBox sharedTipAfter = Style.PartRef(app, "dock", "tooltip", "tooltip", "", "", Style.SNormal());
        Check(sharedTipAfter.opacity == origOpacity, "Style.Part copy isolates opacity from shared PartRef cache");
    }

    public static void Main() {
        CheckIcons();
        App app = App.CreateOffscreen("Skin compat regression", 800, 600);
        app.SetOffscreenViewport(800, 600, 100);
        CheckToolStripLiveSwitch(app);
        CheckRadioCheckboxSurface(app);
        CheckBrutalMicroParts(app);
        CheckPerSideBorderPainting(app);
        CheckOpacityLayerShadowNotClipped(app);
        CheckPressedButtonShadowAndDamage(app);
        CheckAll16Skins(app);
        CheckRoundedCornerGeometry(app);
        CheckOverlayBoundsAndMenuStateParity(app);
        app.StopLoop();
        app.SetRootControl(null);
        app.canvas.Destroy();
        Console.WriteLine("skin-compat-regression:ok");
    }
}
