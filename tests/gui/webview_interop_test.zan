using System;
using Gui;

delegate int TwoArgFn(nint self, nint a);

class Program {
    static int fails;

    static void Eq(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": "
            + Convert.ToString(got) + " != " + Convert.ToString(want));
    }

    static void EqS(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": '" + got
            + "' != '" + want + "'");
    }

    static string Bytes(nint p, int n) {
        string digits = "0123456789abcdef";
        string outp = "";
        for (int i = 0; i < n; i = i + 1) {
            int b = new Span<byte>(p + i, 1)[0];
            outp = outp + digits.Substring((b >> 4) & 15, 1);
            outp = outp + digits.Substring(b & 15, 1);
        }
        return outp;
    }

    static int Method(nint self, nint a) {
        return new Span<long>(self + 8, 1)[0] + a;
    }

    static void Main() {
        nint g = Com.Guid("9E8F0CF8-E670-4B5E-B2BC-73E061E3184C");
        Console.WriteLine($"guid={Program.Bytes(g, 16)}");
        NativeMemory.Free(g);

        ComVtbl v = ComVtbl.Create(5);
        v.Add(0);
        v.Add(0);
        v.Add(0);
        v.Add(0);
        v.Add((nint)Program.Method);
        nint obj = v.Build();
        v.SetState(40);
        Console.WriteLine($"state={ComVtbl.State(obj)}");
        Console.WriteLine($"slot4={Com.Call1(obj, 4, 2)}");
        Console.WriteLine($"empty={Com.Call1(obj, 1, 0) < 0}");

        string host = WebView2.HostOf("https://user.example.com:8443/a/b?q=1");
        string bare = WebView2.HostOf("example.org");
        Console.WriteLine($"host={host}");
        Console.WriteLine($"bare={bare}");
        Console.WriteLine($"safe={WebView2.IsSafeChar('a')}{WebView2.IsSafeChar('/')}");
        Console.WriteLine($"missing={WebView2.Get(99) == null}");

        // ---- 消息桥 shim 与注入包装（纯字符串构造器） ----------------
        // JS 字面量转义：反斜杠/引号/控制字符不破坏脚本结构。
        Program.EqS("quote plain", WebView2.JsQuote("zan"),
            Program.Q() + "zan" + Program.Q());
        Program.EqS("quote escapes",
            WebView2.JsQuote("a" + Program.Q() + "b" + Program.Bs()),
            Program.Q() + "a" + Program.Bs() + Program.Q() + "b"
                + Program.Bs() + Program.Bs() + Program.Q());

        // 通道 shim：带通道名、chrome.webview 转发和 "名\t正文" 前缀
        // （正文前缀在 JS 源里是 \t 转义序列）。
        string shim = WebView2.ShimScript("zan");
        Program.Eq("shim names channel",
            shim.IndexOf(Program.Q() + "zan" + Program.Q()) >= 0 ? 1 : 0, 1);
        Program.Eq("shim forwards",
            shim.IndexOf("window.chrome.webview.postMessage") >= 0 ? 1 : 0, 1);
        Program.Eq("shim tab prefix",
            shim.IndexOf(Program.Bs() + "t") >= 0 ? 1 : 0, 1);
        Program.Eq("shim json for objects",
            shim.IndexOf("JSON.stringify") >= 0 ? 1 : 0, 1);

        // document-end 仿真：readyState 门包住原脚本。
        string deferred = WebView2.DeferToDomReady("window.x=1;");
        Program.Eq("defer readyState",
            deferred.IndexOf("document.readyState==='loading'") >= 0 ? 1 : 0, 1);
        Program.Eq("defer keeps body",
            deferred.IndexOf("window.x=1;") >= 0 ? 1 : 0, 1);

        // ---- ICoreWebView2_2 的槽位（以 WebView2.h 为准） --------------
        // ICoreWebView2 本体 58 个方法（vtable 槽 3..60，0..2 是 IUnknown），
        // _2 的自有方法从 61 起。这三个槽位曾整体多算 5 位：get_CookieManager
        // 读到 vtable 之外的内存（E_INVALIDARG），"往网页视图里种 Cookie"
        // 这条路从来没通——客户端登录了，后台网页仍落到登录页。
        Program.Eq("slot cookie manager", WebView2.SlotGetCookieManager(), 66);
        Program.Eq("slot add resource resp",
            WebView2.SlotAddWebResourceResponseReceived(), 61);
        Program.Eq("slot remove resource resp",
            WebView2.SlotRemoveWebResourceResponseReceived(), 62);

        // ---- Cookie 排队：原生视图建出来之前不能丢 ----------------------
        // "先把登录态种进网页、再打开页面"的唯一时机就是首屏导航之前，
        // 也就是原生视图还没建出来的时候。SetCookie 以前在这段是静默丢弃
        // （handle==0 直接返回），于是首屏永远没有登录态。
        WebView wv = new WebView();
        wv.SetCookie("http://127.0.0.1:8090/admin/dashboard", "zsession", "tok");
        Program.Eq("cookie queued before create", wv.pendingCookies.Count, 1);
        Program.EqS("cookie queued name", wv.pendingCookies[0].name, "zsession");
        Program.EqS("cookie queued value", wv.pendingCookies[0].value, "tok");
        Program.EqS("cookie queued url", wv.pendingCookies[0].url,
            "http://127.0.0.1:8090/admin/dashboard");
    }

    // 测试字面量助手：源文件里不写裸转义，用码位拼出 "、\。
    static string Q() { return "" + (char)34; }
    static string Bs() { return "" + (char)92; }
}
