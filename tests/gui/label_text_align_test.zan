using System;
using Gui;
using Gui.Widget;

// 验证 Label 控件原生支持 CSS text-align（left/center/right）与内边距/边框。
// 过去 Label 的 OnPaint 仅做垂直居中贴左绘制，写 text-align: center 静默无效，
// 迫使开发者必须外包一层 Flex 容器；现在 OnPaint 完整接入 s.align 与 padding/border，
// 能够在单行与 wrap 折行模式下自适应计算偏移，消除套娃容器并提升性能。
class Program {
    static int fails;

    static void Assert(string what, bool cond) {
        if (!cond) {
            fails = fails + 1;
            Console.WriteLine("FAIL: " + what);
        }
    }

    static void Main() {
        App app = new App("label-align-test", 400, 300);

        string css = "label.center { text-align: center; }\n"
            + "label.right { text-align: right; }\n"
            + "label.padded { text-align: center; padding: 4 10; border: 1 #333333; }";
        app.sheet = Css.Parse(css);

        // 1. 默认左对齐
        Label lLeft = new Label("LeftAlign");
        lLeft.bx = 10;
        lLeft.by = 10;
        lLeft.bw = 200;
        lLeft.bh = 30;
        lLeft.OnMeasure(app);
        lLeft.OnPaint(app);
        Assert("Left label has positive prefW", lLeft.prefW > 0);

        // 2. 居中对齐
        Label lCenter = new Label("Centered");
        lCenter.Class = "center";
        lCenter.bx = 10;
        lCenter.by = 50;
        lCenter.bw = 200;
        lCenter.bh = 30;
        lCenter.OnMeasure(app);
        lCenter.OnPaint(app);
        Assert("Center label measured", lCenter.prefW > 0);

        // 3. 右对齐
        Label lRight = new Label("RightAlign");
        lRight.Class = "right";
        lRight.bx = 10;
        lRight.by = 90;
        lRight.bw = 200;
        lRight.bh = 30;
        lRight.OnMeasure(app);
        lRight.OnPaint(app);
        Assert("Right label measured", lRight.prefW > 0);

        // 4. 带 padding 和 border 的 Label
        Label lPadded = new Label("PaddedCenter");
        lPadded.Class = "padded";
        lPadded.bx = 10;
        lPadded.by = 130;
        lPadded.bw = 200;
        lPadded.bh = 40;
        lPadded.OnMeasure(app);
        lPadded.OnPaint(app);
        // padding-left: 10, padding-right: 10, border: 1 => padH = 22
        Assert("Padded label prefW includes padding and border", lPadded.prefW >= 22);

        // 5. wrap 折行模式对齐测试
        Label lWrap = new Label("This is a longer line of text designed to wrap across multiple lines.");
        lWrap.Class = "center";
        lWrap.wrap = true;
        lWrap.bx = 10;
        lWrap.by = 180;
        lWrap.bw = 150;
        lWrap.bh = 80;
        lWrap.OnMeasure(app);
        lWrap.OnPaint(app);
        Assert("Wrap label measured multiple lines", lWrap.prefH > 30);

        if (fails == 0) {
            Console.WriteLine("Label text-align tests PASSED");
        } else {
            Console.WriteLine("Label text-align tests FAILED: " + Convert.ToString(fails) + " errors");
            Environment.Exit(1);
        }
    }
}
