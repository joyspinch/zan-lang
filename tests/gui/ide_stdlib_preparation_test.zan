using System;
using System.IO;
using Gui;
using Gui.Widget;

// Instrument real template rows without replacing tree input or layout behavior.
class IdeStdlibLayoutWitness : Control {
    public static int measures;
    public static int arranges;
    public IdeStdlibLayoutWitness() : base("stdlib-layout-witness") { this.Prefer(1, 24); }
    public override void OnMeasure(App app) { measures = measures + 1; }
    public override void Arrange(int x, int y, int w, int h) {
        arranges = arranges + 1;
        base.Arrange(x, y, w, h);
    }
}

class IdeStdlibPaintLeaf : Control {
    public weak ZanIDE ide;
    public int paints;
    public IdeStdlibPaintLeaf(ZanIDE ide) : base("stdlib-paint") { this.ide = ide; this.Prefer(100, 40); }
    public override void OnPaint(App app) {
        paints = paints + 1;
        for (int i = 0; i < 3; i = i + 1) {
            ide.stdlibPanel.Render(app, ide.dock.ContentParked("stdlib"), ide.exTree);
        }
    }
}

class IdeStdlibProbeForm : Form {
    public IdeStdlibProbeForm() : base("IDE Stdlib preparation", 800, 600, true) { }
    public void Verify() {
        App app = this.GetApp();
        ZanIDE ide = new ZanIDE(app);
        IdeStdlibPaintLeaf leaf = new IdeStdlibPaintLeaf(ide);
        this.Add(leaf);
        app.UseAppCss(File.ReadAllText("src/ide_zan/assets/ide.css"));
        this.RunScoped(() => {
            IdeStdlibPreparationTest.Check(!app.rootControl.ContainsInputControl(ide.stdlibPanel.Tree),
            "Form replaces the startup input chain");
            IdeStdlibPreparationTest.VerifyInput(app, ide);
            IdeStdlibPreparationTest.VerifyInPlaceExpansion(app, ide);
            IdeStdlibPreparationTest.Check(leaf.paints == 0, "first input and node changes require no Paint");
            IdeStdlibPreparationTest.VerifyPaint(app, ide, leaf);
            IdeStdlibPreparationTest.VerifyLifecycle(app, ide);
        });
        app.StopLoop(); app.canvas.Destroy();
    }
}

class IdeStdlibPreparationTest {
    public static void Check(bool value, string label) { if (!value) { throw new Exception(label); } }
    public static void Prepare(App app) {
        app.ProcessOffscreenInput(1, 400, 560, 0, 0, 0, 0);
        bool ready = false;
        for (int attempt = 0; attempt < 3 && !ready; attempt = attempt + 1) {
            app.BeginFrame(); ready = app.PrepareStandardHostFrame(); app.CancelOffscreenFrame();
        }
        Check(ready, "Stdlib prepares through public input and frame entry points");
    }

    public static void VerifyInput(App app, ZanIDE ide) {
        // The first wheel must restore, bind and lay out the borrowed tree before hit testing.
        app.ProcessOffscreenInput(13, 5, 80, 0, -120, 0, 0);
        TreeView tree = ide.stdlibPanel.Tree;
        Rect rows = tree.ScrollViewport();
        Check(app.rootControl.ContainsInputControl(tree) && tree.bw == 190 && tree.bh == 220
        && rows.y + rows.height <= 260 && tree.scrollExtent > rows.height,
        "first input mounts the real designed tree inside its dock viewport");
        Check(tree.ScrollTop() > 0 && tree.scroll.Get() == tree.ScrollTop(),
        "first body wheel commits and preserves the legacy scroll projection");
        tree.SetScrollTop(0);
        Control target = tree.HitTest(rows.x + 5, rows.y + 5, 0);
        Check(target != null, "real Stdlib scroll body is hit testable");
        RoutedEventArgs edge = new RoutedEventArgs("Wheel", target, rows.x + 5, rows.y + 5);
        edge.delta = 120; target.RouteEvent(edge);
        Check(!edge.handled && tree.ScrollTop() == 0, "boundary wheel remains available to ancestors");
        Input filter = ide.exFilter;
        app.ProcessOffscreenInput(2, filter.bx + 5, filter.by + 5, 0, 0, 0, 0);
        app.ProcessOffscreenInput(3, filter.bx + 5, filter.by + 5, 0, 0, 0, 0);
        app.ProcessOffscreenInput(6, 0, 0, 0, 120, 0, 0);
        Check(filter.IsFocused(app) && filter.GetText() == "x", "Stdlib filter accepts text before Paint");
        Prepare(app);
        Check(tree.RowCount() == 0 && ide.stdlibPanel.Shown().Count == 0,
        "preparation applies the current filter to business rows");
        filter.SetText(""); Prepare(app);
        Check(tree.RowCount() == 41, "clearing the filter restores Stdlib data before Paint");
    }

    public static void VerifyInPlaceExpansion(App app, ZanIDE ide) {
        TreeView tree = ide.stdlibPanel.Tree;
        List<TreeNode> original = ide.exTree;
        int expanded = tree.scrollExtent;
        ide.exTree[0].expanded = false;
        Prepare(app);
        Check(ide.exTree == original && tree.RowCount() == 41 && tree.scrollExtent < expanded
        && tree.scrollExtent <= tree.ScrollViewport().height,
        "same-list collapse updates visible extent during preparation");
        app.ProcessOffscreenInput(13, 5, 80, 0, -120, 0, 0);
        Check(tree.ScrollTop() == 0 && tree.scroll.Get() == 0, "collapsed tree has no stale scroll range");
        ide.exTree[0].expanded = true;
        Prepare(app);
        Check(ide.exTree == original && tree.scrollExtent == expanded,
        "same-list expansion restores the visible extent before Paint");
        app.ProcessOffscreenInput(13, 5, 80, 0, -120, 0, 0);
        Check(tree.ScrollTop() > 0 && tree.scroll.Get() == tree.ScrollTop(),
        "expanded tree wheel uses the restored scroll range");
    }

    public static void VerifyPaint(App app, ZanIDE ide, IdeStdlibPaintLeaf leaf) {
        TreeView tree = ide.stdlibPanel.Tree;
        tree.NodeSlot((node) => { return new IdeStdlibLayoutWitness(); });
        Prepare(app);
        for (int pass = 0; pass < 2; pass = pass + 1) {
            app.BeginFrame(); Check(app.PrepareStandardHostFrame(), "Stdlib frame prepares");
            int filters = ZanIDE.filterCalls;
            int measures = IdeStdlibLayoutWitness.measures;
            int arranges = IdeStdlibLayoutWitness.arranges;
            Control row = tree.RowControl(0);
            Control root = app.rootControl;
            int generation = app.inputRootGeneration;
            Check(row != null && measures > 0 && arranges > 0, "real template rows exercise layout instrumentation");
            int paints = leaf.paints;
            app.frameBody();
            Check(leaf.paints == paints + 1, "prepared frame executes the real Stdlib Paint consumer");
            Check(ZanIDE.filterCalls == filters && tree.RowControl(0) == row
            && IdeStdlibLayoutWitness.measures == measures && IdeStdlibLayoutWitness.arranges == arranges,
            "repeated Stdlib Paint consumes rows without filtering binding measuring or arranging");
            Check(root == app.rootControl && generation == app.inputRootGeneration && app.ContinuePreparedFrame(),
            "Stdlib Paint preserves the prepared input proof");
            app.CancelOffscreenFrame();
        }
    }

    public static void VerifyLifecycle(App app, ZanIDE ide) {
        TreeView tree = ide.stdlibPanel.Tree;
        ide.exFilter.Focus(app); app.CapturePointer(ide.exFilter, true);
        ide.dock.Close("stdlib"); Prepare(app);
        Check(!app.rootControl.ContainsInputControl(tree) && !ide.exFilter.IsFocused(app)
        && app.GetCapturedPointer() == null, "hidden Stdlib retires input focus and capture");
        app.BeginFrame(); Check(app.PrepareStandardHostFrame(), "hidden Stdlib prepares");
        ide.stdlibPanel.Render(app, ide.dock.ContentParked("stdlib"), ide.exTree);
        Check(!app.rootControl.ContainsInputControl(tree) && app.ContinuePreparedFrame(),
        "Paint cannot remount hidden Stdlib");
        app.CancelOffscreenFrame();
        ide.dock.Show("stdlib"); ide.PlaceStdlib(); Prepare(app);
        Check(app.rootControl.ContainsInputControl(tree), "reopened Stdlib mounts before Paint");
        ide.exFilter.Focus(app); app.CapturePointer(ide.exFilter, true);
        ide.closeRequested = true; Prepare(app);
        Check(!app.rootControl.ContainsInputControl(tree) && !ide.exFilter.IsFocused(app)
        && app.GetCapturedPointer() == null, "close preparation retires Stdlib input focus and capture");
        ide.stdlibPanel.RetireHost();
        app.BeginFrame(); Check(app.PrepareStandardHostFrame(), "retired Stdlib no longer participates");
        ide.stdlibPanel.Render(app, new Rect(0, 40, 190, 220), ide.exTree);
        Check(!app.rootControl.ContainsInputControl(tree) && app.ContinuePreparedFrame(),
        "visible Paint cannot revive retired Stdlib");
        app.CancelOffscreenFrame();
    }

    static void Main() {
        App sentinel = App.CreateOffscreen("Stdlib sentinel", 1, 1);
        IdeStdlibProbeForm form = new IdeStdlibProbeForm(); form.Verify();
        sentinel.canvas.Destroy();
        Console.WriteLine("IDE_STDLIB_PREPARATION_OK");
    }
}
