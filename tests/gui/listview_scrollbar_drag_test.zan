using System;
using Gui;
using Gui.Widget;

// Actual retained input: thumb/track/grab margin, final Up, pixel motion and
// sibling insertion must preserve one body-owned capture before any Paint.
class ListViewScrollbarDragTest {
    static int fails;

    static void EqInt(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got "
            + Convert.ToString(got) + " want " + Convert.ToString(want));
    }

    static void Check(bool ok, string what) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Ev(App app, int kind, int x, int y) {
        app.ProcessOffscreenInput(kind, x, y, 0, 0, 0, 0);
    }

    static void Exercise(int dpi) {
        App app = App.CreateOffscreen("listview-drag", 400, 300);
        app.SetOffscreenViewport(400, 300, dpi);
        Control root = new Column();
        List<string> data = new List<string>();
        for (int i = 0; i < 100; i = i + 1) {
            data.Add("row " + Convert.ToString(i));
        }
        ListView<string> list = new ListView<string>(r => new ListItem(r));
        list.Bind(data);
        root.Add(list);
        root.UseApp(app);
        app.SetRootControl(root);
        root.MeasureTree(app);
        root.Arrange(0, 0, app.Scale(400), app.Scale(300));
        list.Arrange(app.Scale(5), app.Scale(7), app.Scale(390), app.Scale(280));
        Control body = list.RowControl(0).parent;
        Rect view = list.ScrollViewport();
        ScrollState metrics = new ScrollState();
        Rect track = metrics.Track(app, view.x, view.y, view.width, view.height, false);
        int contentH = list.ContentHeightForTest(app);
        int thumbH = metrics.ThumbLength(app, view.height, contentH);
        int travel = view.height - thumbH;
        int maximum = contentH - view.height;
        Check(travel > 0 && maximum > 0, "overflow has draggable thumb");
        if (travel <= 0 || maximum <= 0) {
            app.SetRootControl(null); app.canvas.Destroy(); return;
        }
        int startX = track.x + track.width / 2;
        int startY = track.y + thumbH / 2;

        Ev(app, 2, startX, startY);
        Check(app.GetCapturedPointer() == body, "thumb Down captures retained body before Paint");
        EqInt("thumb Down keeps offset", list.scroll.Get(), 0);
        int distance = app.Scale(60);
        int wanted = distance * maximum / travel;
        Ev(app, 1, startX, startY + distance);
        EqInt("drag follows pointer", list.scroll.Get(), wanted);
        // Up may carry a newer position without an intervening Move or Paint.
        distance = app.Scale(70);
        wanted = distance * maximum / travel;
        Ev(app, 3, startX, startY + distance);
        EqInt("Up commits final coordinate", list.scroll.Get(), wanted);
        Check(app.GetCapturedPointer() == null, "Up releases body capture");

        list.SetScrollTop(0);
        int midY = track.y + view.height / 2;
        Ev(app, 2, startX, midY);
        int jumped = (midY - track.y - thumbH / 2) * maximum / travel;
        EqInt("track Down centers thumb", list.scroll.Get(), jumped);
        Ev(app, 3, startX, midY);

        list.SetScrollTop(0);
        int edgeX = track.x - app.Scale(5) + 1;
        Ev(app, 2, edgeX, startY);
        Check(app.GetCapturedPointer() == body, "content-side grab margin captures body");
        Ev(app, 1, edgeX, startY + app.Scale(30));
        EqInt("grab margin follows pointer", list.scroll.Get(), app.Scale(30) * maximum / travel);
        Ev(app, 3, edgeX, startY + app.Scale(30));
        EqInt("grab drag never selects row", list.SelectedIndex(), -1);

        list.SetScrollTop(0);
        Ev(app, 2, startX, startY);
        int stalls = 0;
        for (int k = 1; k <= 40; k = k + 1) {
            Ev(app, 1, startX, startY + k);
            if (list.scroll.Get() != k * maximum / travel) { stalls = stalls + 1; }
        }
        EqInt("pixel-step drag never stalls", stalls, 0);
        Ev(app, 3, startX, startY + 40);

        list.SetScrollTop(0);
        Ev(app, 2, startX, startY);
        Control sibling = new Button("Unrelated");
        stalls = 0;
        for (int k = 1; k <= 20; k = k + 1) {
            if (k == 6) { root.Add(sibling); sibling.Arrange(0, 0, 2, 2); }
            if (k == 14) { root.Remove(sibling); }
            Ev(app, 1, startX, startY + k);
            if (list.scroll.Get() != k * maximum / travel || app.GetCapturedPointer() != body) {
                stalls = stalls + 1;
            }
        }
        EqInt("drag survives unrelated sibling insertion and removal", stalls, 0);
        Ev(app, 3, startX, startY + 20);
        EqInt("sibling changes never select row", list.SelectedIndex(), -1);
        Check(app.GetCapturedPointer() == null, "sibling changes preserve final release");

        int beforePaint = list.scroll.Get();
        app.BeginOffscreenFrame(); list.RenderTree(app); list.RenderTree(app); app.EndOffscreenFrame();
        EqInt("repeated Paint keeps committed offset", list.scroll.Get(), beforePaint);
        EqInt("repeated Paint never selects row", list.SelectedIndex(), -1);
        app.SetRootControl(null);
        app.canvas.Destroy();
    }

    static void Main() {
        for (int dpi = 100; dpi <= 200; dpi = dpi + 50) { Exercise(dpi); }
        Console.WriteLine(fails == 0 ? "LISTVIEWDRAG PASS"
            : "LISTVIEWDRAG FAIL " + Convert.ToString(fails));
    }
}
