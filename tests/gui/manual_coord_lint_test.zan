using System;
using Gui.Core;
using Gui.Widget;

class Program {
    static int Main() {
        Control.ResetLintHits();
        Control.DebugLayoutLint = true;

        // 测试 1：在 Panel.Row 自动流式容器中手写 Place(15, 20)，应当触发“无效坐标”Lint
        Panel row = Panel.Row();
        Button btnAuto = new Button("Auto");
        btnAuto.Place(15, 20); // 手动设置了 mx/my
        row.With(btnAuto);

        row.Arrange(0, 0, 400, 100);

        int hitsAuto = Control.LintHits();
        if (hitsAuto <= 0) {
            Console.WriteLine("FAIL: expected invalid coord lint hit in Panel.Row, got 0");
            return 1;
        }
        Console.WriteLine("PASS: Panel.Row with manual coords triggered lint hits: " + Convert.ToString(hitsAuto));

        // 测试 2：在自由 Manual 停靠容器中手写 Place(10, 10)，不应触发无效坐标
        Control.ResetLintHits();
        Panel manualPanel = new Panel(); // 默认 layout = 0, styleDisplay = 0
        Button btnManual = new Button("Manual");
        btnManual.DockManual(); // dock = 0
        btnManual.Place(10, 10);
        manualPanel.Add(btnManual);

        manualPanel.Arrange(0, 0, 400, 100);

        int hitsManual = Control.LintHits();
        if (hitsManual > 0) {
            Console.WriteLine("FAIL: manual container triggered unexpected lint: " + Convert.ToString(hitsManual));
            return 2;
        }
        Console.WriteLine("PASS: Dock.Manual with manual coords passed without false lint");

        Control.ResetLintHits();
        Control.DebugLayoutLint = false;
        Console.WriteLine("MANUAL_COORD_LINT_ALL_OK");
        return 0;
    }
}
