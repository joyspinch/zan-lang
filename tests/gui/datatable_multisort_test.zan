using System;
using Gui;
using Gui.Widget;

namespace DataTableMultiSortTest;

class Program {
    static DataRow Row(int i) {
        DataRow r = new DataRow();
        r.Push(Convert.ToString(i % 100));
        r.Push(Convert.ToString(i % 1000));
        r.Push(Convert.ToString(i));
        return r;
    }

    static void Main() {
        List<DataRow> rows = new List<DataRow>();
        for (int i = 0; i < 100000; i = i + 1) { rows.Add(Program.Row(i)); }
        List<DataColumn> cols = new List<DataColumn>();
        cols.Add(DataColumn.Numeric("bucket", 80));
        cols.Add(DataColumn.Numeric("score", 80));
        cols.Add(DataColumn.Numeric("id", 80));
        DataSource src = new RowListSource(rows);
        DataTableState st = new DataTableState();
        DataTable.EnsureInit(st, cols, src);
        DataTable.SortBy(st, 0, 1);
        DataTable.AddSort(st, 1, 2);
        DataTable.Recompute(st, cols, src);

        int first = st.order[0];
        int last = st.order[st.order.Count - 1];
        int tenth = st.order[10];
        Console.WriteLine("count=" + Convert.ToString(st.order.Count));
        Console.WriteLine("first=" + src.CellText(first, 0) + ":" + src.CellText(first, 1));
        Console.WriteLine("first+10=" + src.CellText(tenth, 0) + ":" + src.CellText(tenth, 1));
        Console.WriteLine("last=" + src.CellText(last, 0) + ":" + src.CellText(last, 1));
        Console.WriteLine("primary=" + (src.CellNum(first, 0) <= src.CellNum(last, 0)));
        Console.WriteLine("secondary-desc=" + (src.CellNum(first, 1) >= src.CellNum(tenth, 1)));

        bool ordered = true;
        for (int i = 1; i < st.order.Count; i = i + 1) {
            int prev = st.order[i - 1];
            int cur = st.order[i];
            int pb = src.CellNum(prev, 0);
            int cb = src.CellNum(cur, 0);
            int ps = src.CellNum(prev, 1);
            int cs = src.CellNum(cur, 1);
            if (pb > cb || (pb == cb && ps < cs)) { ordered = false; break; }
        }
        Console.WriteLine("ordered=" + ordered);
    }
}
