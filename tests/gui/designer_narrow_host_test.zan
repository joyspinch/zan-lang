using System;
using Gui;
using Gui.Designer;

// 设计器在宿主（IDE）模式下的窄区回归。
//
// 宿主把组件面板与属性面板挂进自己的 dock 时，设计器本体只留功能区 +
// 画布，两栏宽度都归零。编辑区窄到最小画布放不下时，三栏分配那句
// `side * palW / sum` 的分母就是 0 —— 除零把整个 IDE 崩掉（用户把编辑
// 区拖窄即触发，表现为设计器一帧报错、窗口还在但画布不更新）。
//
// 修法是分母为 0 时跳过按比例压缩（两栏本来就是 0，画布照可用宽度
// 铺满）。本用例钉住两件事：窄区不崩、正常宽度照旧能画。
class DesignerNarrowHostTest {
    static void Main() {
        App app = new App("dnarrow", 400, 320);
        app.BeginFrame();

        Designer d = new Designer();
        // 宿主模式：组件面板与属性面板都是零宽（IDE 挂自己的 dock）。
        d.RenderHostPanels(app, new Rect(0, 0, 0, 0), new Rect(0, 0, 0, 0));

        // 窄区：可用宽度小于最小画布宽 —— 此前在这里除零。
        d.Render(app, 0, 0, 120, 200);

        // 正常宽度：宿主模式下的常规布局照旧能画。
        d.Render(app, 0, 0, 900, 600);

        Console.WriteLine("OK");
    }
}
