using System;
using Gui;

namespace TailwindTest;

/// Headless verification of the Tailwind utility-class engine: the spacing
/// scale, sizing (fractions, t-shirt widths, arbitrary values), typography,
/// the default palette (plus slash opacity), borders, radii, shadows, flex
/// layout, motion, gradients and the state variants. Prints the resolved
/// StyleBox fields so the mapping can be diffed against a golden file - no
/// window, no driver.
class Program {
    /// Resolve one class list into a box, in the given state mask.
    static StyleBox Box(string cls, int state) {
        StyleBox b = new StyleBox();
        Tailwind.Apply(b, cls, state);
        return b;
    }

    static void Dump(string cls, int state) {
        StyleBox b = Program.Box(cls, state);
        Console.WriteLine($"--- {cls} @{state}");
        Console.WriteLine($"bg {b.bg} to {b.bgTo} via {b.bgVia} dir {b.bgDir} opacity {b.opacity} blur {b.blur}");
        Console.WriteLine($"fg {b.fg} accent {b.accent} font {b.fontPx} weight {b.fontWeight} line {b.lineHeight} spacing {b.letterSpacing}");
        Console.WriteLine($"align {b.align} valign {b.valign} case {b.textCase} ellipsis {b.ellipsis} nowrap {b.nowrap}");
        Console.WriteLine($"border {b.borderW}/{b.borderColor} sides {b.borderTopW},{b.borderRightW},{b.borderBottomW},{b.borderLeftW} style {b.borderStyle}");
        Console.WriteLine($"side colors {b.borderTopColor},{b.borderRightColor},{b.borderBottomColor},{b.borderLeftColor}");
        Console.WriteLine($"radius {b.radius} corners {b.radiusTL},{b.radiusTR},{b.radiusBR},{b.radiusBL}");
        Console.WriteLine($"pad {b.padL},{b.padT},{b.padR},{b.padB} margin {b.marL},{b.marT},{b.marR},{b.marB}");
        Console.WriteLine($"size {b.width}x{b.height} pm {b.widthPm}x{b.heightPm} min {b.minW},{b.minH} max {b.maxW},{b.maxH} maxpm {b.maxWPm}");
        Console.WriteLine($"gap {b.gap} row {b.rowGap} col {b.colGap} columns {b.columns}");
        Console.WriteLine($"display {b.display} dir {b.flexDir} justify {b.justify} items {b.alignItems} wrap {b.wrap} grow {b.grow} order {b.order}");
        Console.WriteLine($"content {b.alignContent} self {b.alignSelf} shrink {b.shrink} basis {b.basis} pm {b.basisPm} aspect {b.aspect}");
        Console.WriteLine($"position {b.position} inset {b.posT},{b.posR},{b.posB},{b.posL} z {b.zIndex} overflow {b.overflow} visible {b.visible} cursor {b.cursor}");
        Console.WriteLine($"shadow {b.shadow} {b.shadowDx},{b.shadowDy} blur {b.shadowBlur} inset {b.shadowInset}");
        Console.WriteLine($"motion {b.transitionMs}ms easing {b.easing} anim {b.anim} {b.animMs}ms");
        Console.WriteLine($"transform {b.tx},{b.ty} scale {b.scale} rotate {b.rotate}");
    }

    /// One-line probes: only the fields the token is expected to move.
    static void Space(string cls) {
        StyleBox b = Program.Box(cls, 0);
        Console.WriteLine($"{cls} -> pad {b.padL},{b.padT},{b.padR},{b.padB} margin {b.marL},{b.marT},{b.marR},{b.marB} gap {b.gap}/{b.rowGap}/{b.colGap}");
    }

    static void Metric(string cls) {
        StyleBox b = Program.Box(cls, 0);
        Console.WriteLine($"{cls} -> {b.width}x{b.height} pm {b.widthPm}x{b.heightPm} min {b.minW},{b.minH} max {b.maxW},{b.maxH} pm {b.maxWPm},{b.minWPm}");
    }

    static void Paint(string cls) {
        StyleBox b = Program.Box(cls, 0);
        Console.WriteLine($"{cls} -> bg {b.bg} to {b.bgTo} via {b.bgVia} dir {b.bgDir} fg {b.fg} border {b.borderColor} shadow {b.shadow} opacity {b.opacity}");
    }

    static void Font(string cls) {
        StyleBox b = Program.Box(cls, 0);
        Console.WriteLine($"{cls} -> font {b.fontPx} weight {b.fontWeight} line {b.lineHeight} spacing {b.letterSpacing} align {b.align} case {b.textCase} fg {b.fg}");
    }

    static void Shape(string cls) {
        StyleBox b = Program.Box(cls, 0);
        Console.WriteLine($"{cls} -> radius {b.radius} corners {b.radiusTL},{b.radiusTR},{b.radiusBR},{b.radiusBL} border {b.borderW}/{b.borderColor} style {b.borderStyle} sides {b.borderTopW},{b.borderRightW},{b.borderBottomW},{b.borderLeftW} colors {b.borderTopColor},{b.borderRightColor},{b.borderBottomColor},{b.borderLeftColor}");
    }

    static void Misc(string cls) {
        StyleBox b = Program.Box(cls, 0);
        Console.WriteLine($"{cls} -> pos {b.position} inset {b.posT},{b.posR},{b.posB},{b.posL} z {b.zIndex} order {b.order} columns {b.columns} cursor {b.cursor} grow {b.grow}");
        Console.WriteLine($"     motion {b.transitionMs}ms easing {b.easing} anim {b.anim} {b.animMs}ms transform {b.tx},{b.ty} scale {b.scale} rotate {b.rotate} blur {b.blur}");
    }

    /// Flex item tokens: the four fields that decide how one child behaves
    /// inside a flex line.
    static void Item(string cls) {
        StyleBox b = Program.Box(cls, 0);
        Console.WriteLine($"{cls} -> grow {b.grow} shrink {b.shrink} basis {b.basis} pm {b.basisPm} self {b.alignSelf} aspect {b.aspect} content {b.alignContent}");
    }

    /// Whether a token is recognised in the given state (a skin's own
    /// `.primary`, and variants the engine does not model, must not be).
    static void Handled(string tok, int state) {
        bool ok = Tailwind.Token(new StyleBox(), tok, state);
        string verdict = "ignored";
        if (ok) { verdict = "applied"; }
        Console.WriteLine($"{tok} @{state} -> {verdict}");
    }

    static void Main() {
        // A realistic button and card, base and hover.
        Program.Dump("flex items-center justify-center gap-2 px-4 py-2 rounded-lg "
                     + "bg-blue-600 text-white font-semibold shadow-md "
                     + "transition duration-200 ease-out hover:bg-blue-500 "
                     + "hover:-translate-y-1 disabled:opacity-50", 0);
        Program.Dump("flex items-center justify-center gap-2 px-4 py-2 rounded-lg "
                     + "bg-blue-600 text-white font-semibold shadow-md "
                     + "transition duration-200 ease-out hover:bg-blue-500 "
                     + "hover:-translate-y-1 disabled:opacity-50",
                     Style.SHover());
        Program.Dump("flex items-center justify-center gap-2 px-4 py-2 rounded-lg "
                     + "bg-blue-600 text-white font-semibold shadow-md "
                     + "transition duration-200 ease-out hover:bg-blue-500 "
                     + "hover:-translate-y-1 disabled:opacity-50",
                     Style.SDisabled());
        Program.Dump("relative w-full max-w-md min-h-[120px] p-6 rounded-2xl "
                     + "bg-slate-900/80 border border-slate-700 backdrop-blur-lg "
                     + "text-slate-100 overflow-hidden", 0);

        // Spacing scale.
        Console.WriteLine("--- spacing");
        Program.Space("p-4");
        Program.Space("p-0");
        Program.Space("p-px");
        Program.Space("p-1.5");
        Program.Space("px-3 py-1");
        Program.Space("pt-2 pr-3 pb-4 pl-5");
        Program.Space("m-2");
        Program.Space("-mt-3 mb-1");
        Program.Space("mx-2 my-8");
        Program.Space("gap-2");
        Program.Space("gap-x-4 gap-y-1");
        Program.Space("space-x-3 space-y-2");
        Program.Space("p-[10px]");
        Program.Space("mx-auto");

        // Sizing.
        Console.WriteLine("--- sizing");
        Program.Metric("w-64 h-8");
        Program.Metric("w-full h-full");
        Program.Metric("w-1/2");
        Program.Metric("w-1/3 h-2/3");
        Program.Metric("w-auto");
        Program.Metric("size-10");
        Program.Metric("min-w-0 min-h-8");
        Program.Metric("max-w-md max-h-64");
        Program.Metric("max-w-full");
        Program.Metric("w-[240px] h-[38px]");
        Program.Metric("w-px");

        // Typography.
        Console.WriteLine("--- typography");
        Program.Font("text-xs");
        Program.Font("text-sm");
        Program.Font("text-base");
        Program.Font("text-2xl");
        Program.Font("text-[13px]");
        Program.Font("text-center");
        Program.Font("text-right");
        Program.Font("font-bold");
        Program.Font("font-medium");
        Program.Font("leading-6 tracking-wide");
        Program.Font("leading-tight tracking-tighter");
        Program.Font("text-slate-100");
        Program.Font("text-emerald-500");
        Program.Font("text-[#ff8800]");
        Program.Font("uppercase");
        Program.Font("truncate");

        // Palette, gradients, effects.
        Console.WriteLine("--- paint");
        Program.Paint("bg-white");
        Program.Paint("bg-black");
        Program.Paint("bg-transparent");
        Program.Paint("bg-red-500");
        Program.Paint("bg-slate-950");
        Program.Paint("bg-indigo-50");
        Program.Paint("bg-black/40");
        Program.Paint("bg-[#0f172a]");
        Program.Paint("bg-gradient-to-r from-indigo-500 to-pink-500");
        Program.Paint("bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500");
        Program.Paint("shadow");
        Program.Paint("shadow-lg");
        Program.Paint("shadow-inner");
        Program.Paint("shadow-none");
        Program.Paint("shadow-blue-500");
        Program.Paint("opacity-50");
        Program.Paint("accent-emerald-500");

        // Borders and radii.
        Console.WriteLine("--- shape");
        Program.Shape("border");
        Program.Shape("border-2");
        Program.Shape("border-t");
        Program.Shape("border-b-4");
        Program.Shape("border-x-2");
        Program.Shape("border-blue-500");
        Program.Shape("border-t-blue-500");
        Program.Shape("border-dashed");
        Program.Shape("rounded");
        Program.Shape("rounded-none");
        Program.Shape("rounded-md");
        Program.Shape("rounded-full");
        Program.Shape("rounded-t-lg");
        Program.Shape("rounded-bl-xl");
        Program.Shape("rounded-[10px]");

        // Positioning, layering, motion.
        Console.WriteLine("--- misc");
        Program.Misc("absolute top-2 right-4 z-10");
        Program.Misc("relative -top-1 inset-x-0");
        Program.Misc("inset-0");
        Program.Misc("order-2 columns-3 grow");
        Program.Misc("grid grid-cols-4");
        Program.Misc("cursor-pointer");
        Program.Misc("scale-105 rotate-45");
        Program.Misc("-rotate-90 -translate-x-2");
        Program.Misc("animate-spin");
        Program.Misc("transition-none");
        Program.Misc("backdrop-blur-sm");

        // Flex items: the three `flex-*` shorthands differ only in basis and
        // shrink, which is exactly what decides whether a row of them ends up
        // equal-width; `shrink-0` is how a fixed sidebar survives an overflow.
        Console.WriteLine("--- flex items");
        Program.Item("flex-1");
        Program.Item("flex-auto");
        Program.Item("flex-initial");
        Program.Item("flex-none");
        Program.Item("grow shrink-0");
        Program.Item("basis-0");
        Program.Item("basis-1/3");
        Program.Item("basis-full");
        Program.Item("basis-24");
        Program.Item("basis-auto");
        Program.Item("self-center");
        Program.Item("self-end");
        Program.Item("self-stretch");
        Program.Item("aspect-video");
        Program.Item("aspect-square");
        Program.Item("content-between");
        Program.Item("content-stretch");

        // Unknown tokens stay untouched, so skin classes still work.
        Console.WriteLine("--- recognition");
        Program.Handled("primary", 0);
        Program.Handled("md:flex", 0);
        Program.Handled("group-hover:flex", 0);
        Program.Handled("hover:flex", 0);
        Program.Handled("hover:flex", Style.SHover());
        Program.Handled("checked:bg-red-500", Style.SChecked());
        Program.Handled("hover:focus:bg-red-500", Style.SHover());
        Program.Handled("underline", 0);
        Program.Handled("flex", 0);
    }
}
