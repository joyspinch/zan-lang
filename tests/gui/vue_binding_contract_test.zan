using System;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;

class UserDataRow {
    int id;
    string name;
}

partial class VueBindingContract {
    static void OnLoad(Form form) {
    }
}

class VueBindingContractTest {
    static int fails;

    static void Fail(string msg) {
        fails = fails + 1;
        Console.WriteLine("FAIL: " + msg);
    }

    static void AssertEq(string actual, string expect, string desc) {
        if (actual != expect) {
            Fail(desc + " expected '" + expect + "' but got '" + actual + "'");
        }
    }

    static void AssertTrue(bool condition, string desc) {
        if (!condition) {
            Fail(desc + " condition is false");
        }
    }

    static void Main() {
        fails = 0;
        DataTableBootstrap.Install();

        Control root = VueBindingContract.Root();
        AssertTrue(root != null, "VueBindingContract.Root() generated successfully");

        // 1. 验证 z-model、z-show、z-hide 属性正确发射到控件元数据与结构
        AssertEq(VueBindingContract.UserNameInput.bindPath, "user.name", "UserNameInput z-model bound to user.name");
        AssertEq(VueBindingContract.UserNameInput.GetHandler("Change"), "OnNameChange", "UserNameInput @change -> OnNameChange");

        AssertEq(VueBindingContract.RememberMeCheck.bindPath, "user.remember", "RememberMeCheck z-model bound to user.remember");
        AssertEq(VueBindingContract.RememberMeCheck.GetHandler("Change"), "OnRememberChange", "RememberMeCheck @change -> OnRememberChange");

        AssertEq(VueBindingContract.VipBadge.bindIf, "user.isVip", "VipBadge z-show bound to user.isVip");
        AssertEq(VueBindingContract.VipBadge.GetHandler("RightClick"), "OnBadgeContextMenu", "VipBadge @right-click -> OnBadgeContextMenu");
        AssertEq(VueBindingContract.VipBadge.GetHandler("DoubleClick"), "OnBadgeDblClick", "VipBadge @dblclick -> OnBadgeDblClick");

        AssertEq(VueBindingContract.GuestNotice.bindIf, "!user.isVip", "GuestNotice z-hide desugared to !user.isVip");
        AssertEq(VueBindingContract.GuestNotice.GetHandler("RightDoubleClick"), "OnNoticeRightDblClick", "GuestNotice @right-dblclick -> OnNoticeRightDblClick");

        AssertEq(VueBindingContract.ViewTabs.GetHandler("TabChanged"), "OnTabChanged", "ViewTabs @tab-changed -> OnTabChanged");
        AssertEq(VueBindingContract.ProfileTab.GetHandler("Show"), "OnProfileShow", "ProfileTab @show -> OnProfileShow");
        AssertEq(VueBindingContract.SettingsTab.GetHandler("Hide"), "OnSettingsHide", "SettingsTab @hide -> OnSettingsHide");

        AssertEq(VueBindingContract.UserGrid.GetHandler("RowClick"), "OnGridRowClick", "UserGrid @row-click -> OnGridRowClick");
        AssertEq(VueBindingContract.UserGrid.GetHandler("RowDoubleClick"), "OnGridRowDblClick", "UserGrid @row-dblclick -> OnGridRowDblClick");
        AssertEq(VueBindingContract.UserGrid.GetHandler("CellClick"), "OnGridCellClick", "UserGrid @cell-click -> OnGridCellClick");
        AssertEq(VueBindingContract.UserGrid.GetHandler("ColumnClick"), "OnGridColClick", "UserGrid @col-click -> OnGridColClick");

        // 2. 模拟 Form 宿主事件多态路由与分派触发
        Form host = Form.CreateOffscreen("vue_contract", 800, 600);
        int nameChanged = 0;
        int rightClickCount = 0;
        int dblClickCount = 0;
        int rightDblClickCount = 0;
        int tabChangedCount = 0;
        int gridRowClickCount = 0;
        int gridColClickCount = 0;

        host.On("OnNameChange", () => { nameChanged = nameChanged + 1; });
        host.On("OnBadgeContextMenu", () => { rightClickCount = rightClickCount + 1; });
        host.On("OnBadgeDblClick", () => { dblClickCount = dblClickCount + 1; });
        host.On("OnNoticeRightDblClick", () => { rightDblClickCount = rightDblClickCount + 1; });
        host.On("OnTabChanged", () => { tabChangedCount = tabChangedCount + 1; });
        host.On("OnGridRowClick", () => { gridRowClickCount = gridRowClickCount + 1; });
        host.On("OnGridColClick", () => { gridColClickCount = gridColClickCount + 1; });

        VueBindingContract.__WireForm(host);

        // 触发 Input Change 事件
        VueBindingContract.UserNameInput.Change.Raise();
        AssertTrue(nameChanged == 1, "UserNameInput Change event fired and handled");

        // 触发 Panel RightClick 与 DoubleClick 事件
        VueBindingContract.VipBadge.On.RightClick.Raise();
        AssertTrue(rightClickCount == 1, "VipBadge RightClick event fired and handled");
        VueBindingContract.VipBadge.On.DoubleClick.Raise();
        AssertTrue(dblClickCount == 1, "VipBadge DoubleClick event fired and handled");

        // 触发 GuestNotice RightDoubleClick 事件
        VueBindingContract.GuestNotice.On.RightDoubleClick.Raise();
        AssertTrue(rightDblClickCount == 1, "GuestNotice RightDoubleClick event fired and handled");

        // 触发 Tabs TabChanged 事件
        VueBindingContract.ViewTabs.TabChanged.Raise();
        AssertTrue(tabChangedCount == 1, "ViewTabs TabChanged event fired and handled");

        // 触发 DataGrid 行与列表头点击事件
        VueBindingContract.UserGrid.State().RowClick.Raise();
        AssertTrue(gridRowClickCount == 1, "UserGrid RowClick event fired and handled");
        VueBindingContract.UserGrid.State().HeaderClick.Raise();
        AssertTrue(gridColClickCount == 1, "UserGrid HeaderClick event fired and handled");

        // 3. 验证动态 FormBuilder 构建出的结构与静态生成的一致性
        Control dynamicRoot = FormBuilder.Build(JsonValue.Parse(VueBindingContract.__designDoc.ToJson()));
        AssertTrue(dynamicRoot != null, "FormBuilder dynamically builds template");
        Control dynInput = dynamicRoot.Find("UserNameInput");
        AssertTrue(dynInput != null, "Dynamic tree has UserNameInput");
        if (dynInput != null) {
            AssertEq(dynInput.bindPath, "user.name", "Dynamic input retains bindPath");
            AssertEq(dynInput.GetHandler("Change"), "OnNameChange", "Dynamic input retains handler");
        }

        host.GetApp().canvas.Destroy();

        if (fails == 0) {
            Console.WriteLine("VUE_BINDING_CONTRACT_TEST_OK");
        } else {
            Console.WriteLine("VUE_BINDING_CONTRACT_TEST_FAIL (fails=" + Convert.ToString(fails) + ")");
        }
    }
}
