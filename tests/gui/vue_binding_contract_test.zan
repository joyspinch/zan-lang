using System;
using System.IO;
using System.Json;
using System.Web;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;

class UserDataRow {
    int id;
    string name;
}

class VueDocWin : ChildWindow {
}

class VueBindingContractTest {
    static int fails;

    static void Fail(string msg) {
        fails = fails + 1;
        Console.WriteLine("FAIL: " + msg);
    }

    static void AssertEq(string actual, string expect, string desc) {
        if (actual != expect) {
            Fail(desc + " expected '" + expect + "' but got '" + actual + "'");
        }
    }

    static void AssertTrue(bool condition, string desc) {
        if (!condition) {
            Fail(desc + " condition is false");
        }
    }

    static Control Ctl(Control root, string name) {
        Control c = root.Find(name);
        if (c == null) { throw new Exception("missing " + name); }
        return c;
    }

    static void Main() {
        fails = 0;
        DataTableBootstrap.Install();

        string html = File.ReadAllText("tests/gui/vue_binding_contract.html");
        JsonValue document = JsonValue.ParseLenient(DesignerHtml.ToJsonDoc(html));
        Control root = FormBuilder.Build(document);
        AssertTrue(root != null, "FormBuilder builds template");

        // 1. 验证 z-model、z-show、z-hide 属性正确落到控件元数据与结构
        Control userNameInput = Ctl(root, "UserNameInput");
        AssertEq(userNameInput.bindPath, "user.name", "UserNameInput z-model bound to user.name");
        AssertEq(userNameInput.GetHandler("Change"), "OnNameChange", "UserNameInput @change -> OnNameChange");

        Control rememberMeCheck = Ctl(root, "RememberMeCheck");
        AssertEq(rememberMeCheck.bindPath, "user.remember", "RememberMeCheck z-model bound to user.remember");
        AssertEq(rememberMeCheck.GetHandler("Change"), "OnRememberChange", "RememberMeCheck @change -> OnRememberChange");

        Control vipBadge = Ctl(root, "VipBadge");
        AssertEq(vipBadge.bindIf, "user.isVip", "VipBadge z-show bound to user.isVip");
        AssertEq(vipBadge.GetHandler("RightClick"), "OnBadgeContextMenu", "VipBadge @right-click -> OnBadgeContextMenu");
        AssertEq(vipBadge.GetHandler("DoubleClick"), "OnBadgeDblClick", "VipBadge @dblclick -> OnBadgeDblClick");

        Control guestNotice = Ctl(root, "GuestNotice");
        AssertEq(guestNotice.bindIf, "!user.isVip", "GuestNotice z-hide desugared to !user.isVip");
        AssertEq(guestNotice.GetHandler("RightDoubleClick"), "OnNoticeRightDblClick", "GuestNotice @right-dblclick -> OnNoticeRightDblClick");

        Control viewTabs = Ctl(root, "ViewTabs");
        AssertEq(viewTabs.GetHandler("TabChanged"), "OnTabChanged", "ViewTabs @tab-changed -> OnTabChanged");
        AssertEq(Ctl(root, "ProfileTab").GetHandler("Show"), "OnProfileShow", "ProfileTab @show -> OnProfileShow");
        AssertEq(Ctl(root, "SettingsTab").GetHandler("Hide"), "OnSettingsHide", "SettingsTab @hide -> OnSettingsHide");

        Control userGrid = Ctl(root, "UserGrid");
        AssertEq(userGrid.GetHandler("RowClick"), "OnGridRowClick", "UserGrid @row-click -> OnGridRowClick");
        AssertEq(userGrid.GetHandler("RowDoubleClick"), "OnGridRowDblClick", "UserGrid @row-dblclick -> OnGridRowDblClick");
        AssertEq(userGrid.GetHandler("CellClick"), "OnGridCellClick", "UserGrid @cell-click -> OnGridCellClick");
        // 控件事件端到端都叫 HeaderClick（触发走 State().HeaderClick），
        // @col-click 归一到它——生成器时代的 ColumnClick 旧名不再用。
        AssertEq(userGrid.GetHandler("HeaderClick"), "OnGridColClick", "UserGrid @col-click -> OnGridColClick");

        // 2. 宿主事件多态路由与分派触发：Wire() 把控件上的处理名
        // 接到宿主同名 Handle 槽。
        VueDocWin w = new VueDocWin();
        int nameChanged = 0;
        int rightClickCount = 0;
        int dblClickCount = 0;
        int rightDblClickCount = 0;
        int tabChangedCount = 0;
        int gridRowClickCount = 0;
        int gridColClickCount = 0;

        w.Handle("OnNameChange", () => { nameChanged = nameChanged + 1; });
        w.Handle("OnBadgeContextMenu", () => { rightClickCount = rightClickCount + 1; });
        w.Handle("OnBadgeDblClick", () => { dblClickCount = dblClickCount + 1; });
        w.Handle("OnNoticeRightDblClick", () => { rightDblClickCount = rightDblClickCount + 1; });
        w.Handle("OnTabChanged", () => { tabChangedCount = tabChangedCount + 1; });
        w.Handle("OnGridRowClick", () => { gridRowClickCount = gridRowClickCount + 1; });
        w.Handle("OnGridColClick", () => { gridColClickCount = gridColClickCount + 1; });

        w.SetRoot(root, JsonValue.Parse("{}"));
        w.Wire();

        // 触发 Input Change 事件
        ((Input)userNameInput).Change.Raise();
        AssertTrue(nameChanged == 1, "UserNameInput Change event fired and handled");

        // 触发 Panel RightClick 与 DoubleClick 事件
        vipBadge.On.RightClick.Raise();
        AssertTrue(rightClickCount == 1, "VipBadge RightClick event fired and handled");
        vipBadge.On.DoubleClick.Raise();
        AssertTrue(dblClickCount == 1, "VipBadge DoubleClick event fired and handled");

        // 触发 GuestNotice RightDoubleClick 事件
        guestNotice.On.RightDoubleClick.Raise();
        AssertTrue(rightDblClickCount == 1, "GuestNotice RightDoubleClick event fired and handled");

        // 触发 Tabs TabChanged 事件
        ((Tabs)viewTabs).TabChanged.Raise();
        AssertTrue(tabChangedCount == 1, "ViewTabs TabChanged event fired and handled");

        // 触发 DataGrid 行与列表头点击事件
        ((DataGrid<UserDataRow>)userGrid).State().RowClick.Raise();
        AssertTrue(gridRowClickCount == 1, "UserGrid RowClick event fired and handled");
        ((DataGrid<UserDataRow>)userGrid).State().HeaderClick.Raise();
        AssertTrue(gridColClickCount == 1, "UserGrid HeaderClick event fired and handled");

        if (fails == 0) {
            Console.WriteLine("VUE_BINDING_CONTRACT_TEST_OK");
        } else {
            Console.WriteLine("VUE_BINDING_CONTRACT_TEST_FAIL (fails=" + Convert.ToString(fails) + ")");
        }
    }
}
