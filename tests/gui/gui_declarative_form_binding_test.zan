using System;
using Gui;
using Gui.Widget;

class DeclarativeVm {
    public string ListSel = "1";
    public string TreeSel = "0";
    public string SelectSel = "1";
    public string DateVal = "2026-08-15";
    public string SliderVal = "40";
    public string RateVal = "3";
    public string TabVal = "1";
    public string PageVal = "2";
    public bool ModalOpen = true;
    public bool DrawerOpen = true;
    public string BioText = "Hello Zan";
    public string RadioVal = "1";
    public string ChecksVal = "Rust,Zan";
}

class GuiDeclarativeFormBindingTest {
    static int fails = 0;

    static void Check(string desc, bool ok) {
        if (ok) {
            Console.WriteLine("[PASS] " + desc);
        } else {
            Console.WriteLine("[FAIL] " + desc);
            fails = fails + 1;
        }
    }

    static void Main(string[] args) {
        Form win = Form.CreateOffscreen("Form Binding Test", 800, 600);

        // 1. 构建现代响应式表单，配置全局标签左对齐与宽度
        FormGroup form = new FormGroup {
            DefaultLabelPlacement = "left",
            DefaultLabelWidth = 100
        };

        Input nameInput = new Input("请输入用户名");
        nameInput.name = "username";

        Input emailInput = new Input("请输入邮箱");
        emailInput.name = "email";

        Checkbox agreeBox = new Checkbox("我已阅读并同意服务条款");
        agreeBox.name = "agreed";

        // 声明式声明表单项、必填星号与校验规则
        FormItem nameItem = new FormItem("用户名", nameInput) {
            HelpText = "3-16位英文字符或数字"
        };
        nameItem.Required("用户名不能为空");
        nameItem.Rule(FormRule.MinLen(3, "用户名至少3个字符"));

        form.Item(nameItem);

        FormItem emailItem = form.Item("电子邮箱", emailInput);
        emailItem.Required("邮箱不能为空");
        emailItem.Rule(FormRule.Email("邮箱格式不正确"));

        FormItem agreeItem = form.Item("服务条款", agreeBox);
        agreeItem.Rule(FormRule.Checked("必须同意服务条款"));

        win.Add(form);

        // 2. 执行排版测量与快照渲染
        Canvas snapshot = win.CaptureSnapshot();
        Check("snapshot not null", snapshot != null);

        // 3. 验证排版几何：由于 LabelPlacement("left")，右侧输入框应在标签右侧
        Check("Name input placed to the right of label", nameInput.bx > nameItem.label.bx);
        Check("Name item label contains asterisk", nameItem.label.GetText().StartsWith("*"));

        // 4. 校验流程测试：初始空值应校验失败
        Check("Initial validation should fail", !form.Validate());
        Check("Form should have errors", form.ErrorCount() > 0);
        Check("First error message matches", form.FirstError() != "");

        // 5. 填入数据并通过校验
        nameInput.SetText("admin");
        emailInput.SetText("admin@example.com");
        agreeBox.SetChecked(true);

        Check("Validation passes after correct input", form.Validate());
        Check("Error count drops to 0", form.ErrorCount() == 0);

        // 6. 验证字典批量导出映射（GetValues）
        Dictionary<string, string> values = form.GetValues();
        Check("GetValues returns username", values["username"] == "admin");
        Check("GetValues returns email", values["email"] == "admin@example.com");
        Check("GetValues returns agreed", values["agreed"] == "true");

        // 7. 验证字典批量回填映射（SetValues）
        Dictionary<string, string> newValues = new Dictionary<string, string>();
        newValues["username"] = "super_dev";
        newValues["email"] = "dev@zan.org";
        newValues["agreed"] = "false";
        form.SetValues(newValues);

        Check("SetValues updates username", nameInput.GetText() == "super_dev");
        Check("SetValues updates email", emailInput.GetText() == "dev@zan.org");
        Check("SetValues updates agreed", !agreeBox.IsChecked());

        // 8. 验证一键重置（Reset）
        form.Reset();
        Check("Reset clears username", nameInput.GetText() == "");
        Check("Reset clears email", emailInput.GetText() == "");
        Check("Reset clears agreed", !agreeBox.IsChecked());
        Check("Reset clears errors", form.ErrorCount() == 0);

        // 9. 验证 14 个核心交互组件的声明式属性与统一 Control.ValueProperty 双向绑定
        DeclarativeVm vm = new DeclarativeVm();
        ListView<string> lv = new ListView<string> {
            ItemsSource = new List<string> { "Alpha", "Beta", "Gamma" },
            FixedRowHeight = 28,
            IsMultiSelect = false,
            EmptyMessage = "空列表",
            Binding = [
                new PropertyBinding<DeclarativeVm> {
                    TargetProperty = Control.ValueProperty,
                    DataSource = vm,
                    SourceText = (DeclarativeVm m) => m.ListSel,
                    SetSourceText = (DeclarativeVm m, string v) => { m.ListSel = v; },
                    TwoWay = true
                }
            ]
        };
        lv.SyncBinding();
        Check("ListView ValueProperty pull from VM", lv.SelectedIndex() == 1);
        lv.SelectIndex(2);
        lv.SyncBinding();
        Check("ListView ValueProperty push to VM", vm.ListSel == "2");

        List<TreeNode> tnodes = new List<TreeNode>();
        tnodes.Add(TreeNode.Dir("Root", 0, true));
        tnodes.Add(TreeNode.File("Leaf", 1));
        TreeView tv = new TreeView {
            ItemsSource = tnodes,
            FixedRowHeight = 24,
            ShowCheckboxes = true,
            EmptyMessage = "空树",
            Binding = [
                new PropertyBinding<DeclarativeVm> {
                    TargetProperty = Control.ValueProperty,
                    DataSource = vm,
                    SourceText = (DeclarativeVm m) => m.TreeSel,
                    SetSourceText = (DeclarativeVm m, string v) => { m.TreeSel = v; },
                    TwoWay = true
                }
            ]
        };
        tv.SyncBinding();
        Check("TreeView ValueProperty pull from VM", tv.SelectedIndex() == 0);
        tv.SelectIndex(1);
        tv.SyncBinding();
        Check("TreeView ValueProperty push to VM", vm.TreeSel == "1");

        SelectBox sb = new SelectBox {
            OptionsSource = "Dev|QA|Ops",
            Placeholder = "选择角色",
            IsClearable = true,
            IsFilterable = true,
            Binding = [
                new PropertyBinding<DeclarativeVm> {
                    TargetProperty = Control.ValueProperty,
                    DataSource = vm,
                    SourceText = (DeclarativeVm m) => m.SelectSel,
                    SetSourceText = (DeclarativeVm m, string v) => { m.SelectSel = v; },
                    TwoWay = true
                }
            ]
        };
        sb.SyncBinding();
        Check("SelectBox ValueProperty pull from VM", sb.Selected() == 1);
        sb.Choose(2);
        Check("SelectBox ValueProperty push to VM on Choose", vm.SelectSel == "2");

        DatePicker dp = new DatePicker {
            Binding = [
                new PropertyBinding<DeclarativeVm> {
                    TargetProperty = Control.ValueProperty,
                    DataSource = vm,
                    SourceText = (DeclarativeVm m) => m.DateVal,
                    SetSourceText = (DeclarativeVm m, string v) => { m.DateVal = v; },
                    TwoWay = true
                }
            ]
        };
        dp.SyncBinding();
        Check("DatePicker ValueProperty pull from VM", dp.DateText == "2026-08-15");
        dp.PickDate(DateTime.FromDate(2026, 9, 1));
        Check("DatePicker ValueProperty push to VM", vm.DateVal == "2026-09-01");

        Slider sl = new Slider {
            Minimum = 0,
            Maximum = 100,
            Step = 5,
            Binding = [
                new PropertyBinding<DeclarativeVm> {
                    TargetProperty = Control.ValueProperty,
                    DataSource = vm,
                    SourceText = (DeclarativeVm m) => m.SliderVal,
                    SetSourceText = (DeclarativeVm m, string v) => { m.SliderVal = v; },
                    TwoWay = true
                }
            ]
        };
        sl.SyncBinding();
        Check("Slider ValueProperty pull from VM", sl.Low() == 40);
        sl.SetValue(75);
        sl.TriggerEvent("Change");
        Check("Slider ValueProperty push to VM", vm.SliderVal == "75");

        Rate rate = new Rate {
            MaximumStars = 5,
            IsClearable = true,
            Binding = [
                new PropertyBinding<DeclarativeVm> {
                    TargetProperty = Control.ValueProperty,
                    DataSource = vm,
                    SourceText = (DeclarativeVm m) => m.RateVal,
                    SetSourceText = (DeclarativeVm m, string v) => { m.RateVal = v; },
                    TwoWay = true
                }
            ]
        };
        rate.SyncBinding();
        Check("Rate ValueProperty pull from VM", rate.Value.Get() == 3);
        rate.OnStarClick(4);
        Check("Rate ValueProperty push to VM", vm.RateVal == "5");

        Tabs tabs = new Tabs {
            OptionsSource = "General|Security|Advanced",
            TabStyle = 1,
            ClosableAll = true,
            Binding = [
                new PropertyBinding<DeclarativeVm> {
                    TargetProperty = Control.ValueProperty,
                    DataSource = vm,
                    SourceText = (DeclarativeVm m) => m.TabVal,
                    SetSourceText = (DeclarativeVm m, string v) => { m.TabVal = v; },
                    TwoWay = true
                }
            ]
        };
        tabs.SyncBinding();
        Check("Tabs ValueProperty pull from VM", tabs.Active() == 1);
        tabs.Select(2);
        Check("Tabs ValueProperty push to VM", vm.TabVal == "2");

        Pagination pager = new Pagination {
            TotalPageCount = 5,
            ShowQuickJumper = true,
            ShowTotalText = true,
            Binding = [
                new PropertyBinding<DeclarativeVm> {
                    TargetProperty = Control.ValueProperty,
                    DataSource = vm,
                    SourceText = (DeclarativeVm m) => m.PageVal,
                    SetSourceText = (DeclarativeVm m, string v) => { m.PageVal = v; },
                    TwoWay = true
                }
            ]
        };
        pager.SyncBinding();
        Check("Pagination ValueProperty pull from VM", pager.CurrentPage() == 2);
        pager.GoTo(4);
        Check("Pagination ValueProperty push to VM", vm.PageVal == "4");

        Modal modal = new Modal {
            TitleText = "Confirm",
            ModalWidth = 480,
            ShowMask = true,
            Binding = [
                new PropertyBinding<DeclarativeVm> {
                    TargetProperty = Control.ValueProperty,
                    DataSource = vm,
                    SourceProperty = (DeclarativeVm m) => m.ModalOpen,
                    SetSource = (DeclarativeVm m, bool v) => { m.ModalOpen = v; },
                    TwoWay = true
                }
            ]
        };
        modal.SyncBinding();
        Check("Modal ValueProperty pull from VM", modal.IsOpen());
        modal.Hide();
        Check("Modal ValueProperty push to VM", !vm.ModalOpen);

        Drawer drawer = new Drawer {
            TitleText = "Inspector",
            DrawerPlacement = "left",
            DrawerSize = 320,
            Binding = [
                new PropertyBinding<DeclarativeVm> {
                    TargetProperty = Control.ValueProperty,
                    DataSource = vm,
                    SourceProperty = (DeclarativeVm m) => m.DrawerOpen,
                    SetSource = (DeclarativeVm m, bool v) => { m.DrawerOpen = v; },
                    TwoWay = true
                }
            ]
        };
        drawer.SyncBinding();
        Check("Drawer ValueProperty pull from VM", drawer.IsOpen());
        drawer.Hide();
        Check("Drawer ValueProperty push to VM", !vm.DrawerOpen);

        TextArea ta = new TextArea {
            Placeholder = "输入简介",
            IsAutoHeight = true,
            Binding = [
                new PropertyBinding<DeclarativeVm> {
                    TargetProperty = Control.ValueProperty,
                    DataSource = vm,
                    SourceText = (DeclarativeVm m) => m.BioText,
                    SetSourceText = (DeclarativeVm m, string v) => { m.BioText = v; },
                    TwoWay = true
                }
            ]
        };
        ta.SyncBinding();
        Check("TextArea ValueProperty pull from VM", ta.GetText() == "Hello Zan");
        ta.Insert("!");
        Check("TextArea ValueProperty push to VM", vm.BioText == "Hello Zan!");

        RadioGroup rg = new RadioGroup {
            OptionsSource = "Light|Dark|System",
            ButtonStyle = true,
            Binding = [
                new PropertyBinding<DeclarativeVm> {
                    TargetProperty = Control.ValueProperty,
                    DataSource = vm,
                    SourceText = (DeclarativeVm m) => m.RadioVal,
                    SetSourceText = (DeclarativeVm m, string v) => { m.RadioVal = v; },
                    TwoWay = true
                }
            ]
        };
        rg.SyncBinding();
        Check("RadioGroup ValueProperty pull from VM", rg.SelectedValue() == 1);
        rg.SetSelectedValue(2);
        rg.SyncBinding();
        Check("RadioGroup ValueProperty push to VM", vm.RadioVal == "2");

        CheckboxGroup cbg = new CheckboxGroup {
            OptionsSource = "C|Rust|Zan",
            Binding = [
                new PropertyBinding<DeclarativeVm> {
                    TargetProperty = Control.ValueProperty,
                    DataSource = vm,
                    SourceText = (DeclarativeVm m) => m.ChecksVal,
                    SetSourceText = (DeclarativeVm m, string v) => { m.ChecksVal = v; },
                    TwoWay = true
                }
            ]
        };
        cbg.SyncBinding();
        Check("CheckboxGroup ValueProperty pull from VM", !cbg.IsChecked(0) && cbg.IsChecked(1) && cbg.IsChecked(2));
        cbg.SetChecked(0, true);
        cbg.SyncBinding();
        Check("CheckboxGroup ValueProperty push to VM", vm.ChecksVal == "C,Rust,Zan");

        Transfer<string> tr = new Transfer<string> {
            SourceItems = new List<string> { "A", "B" },
            TargetItems = new List<string> { "C" },
            IsSearchable = true,
            EmptyMessage = "暂无"
        };
        Check("Transfer declarative properties", tr.SourceCount() == 2 && tr.TargetCount() == 1 && tr.IsSearchable);

        if (fails == 0) {
            Console.WriteLine("ALL TESTS PASSED: Modern FormItem, FormGroup & Binding verified.");
        } else {
            Console.WriteLine("TOTAL FAILS: " + fails);
            Environment.Exit(1);
        }
    }
}
