using System;
using Gui;
using Gui.Widget;

class GuiDeclarativeFormBindingTest {
    static int fails = 0;

    static void Check(string desc, bool ok) {
        if (ok) {
            Console.WriteLine("[PASS] " + desc);
        } else {
            Console.WriteLine("[FAIL] " + desc);
            fails = fails + 1;
        }
    }

    static void Main(string[] args) {
        Form win = new Form("Form Binding Test", 800, 600);

        // 1. 构建现代响应式表单，配置全局标签左对齐与宽度
        FormGroup form = new FormGroup();
        form.LabelPlacement("left").LabelWidth(100);

        Input nameInput = new Input("请输入用户名");
        nameInput.name = "username";

        Input emailInput = new Input("请输入邮箱");
        emailInput.name = "email";

        Checkbox agreeBox = new Checkbox("我已阅读并同意服务条款");
        agreeBox.name = "agreed";

        // 声明式链式声明表单项、必填星号与校验规则
        FormItem nameItem = FormItem.Create("用户名", nameInput)
            .Required("用户名不能为空")
            .Help("3-16位英文字符或数字")
            .Rule(FormRule.MinLen(3, "用户名至少3个字符"));

        form.Item(nameItem);

        form.Item("电子邮箱", emailInput)
            .Required("邮箱不能为空")
            .Rule(FormRule.Email("邮箱格式不正确"));

        form.Item("服务条款", agreeBox)
            .Rule(FormRule.Checked("必须同意服务条款"));

        win.Add(form);

        // 2. 执行排版测量与快照渲染
        Canvas snapshot = win.CaptureSnapshot();
        Check("snapshot not null", snapshot != null);

        // 3. 验证排版几何：由于 LabelPlacement("left")，右侧输入框应在标签右侧
        Check("Name input placed to the right of label", nameInput.bx > nameItem.label.bx);
        Check("Name item label contains asterisk", nameItem.label.GetText().StartsWith("*"));

        // 4. 校验流程测试：初始空值应校验失败
        Check("Initial validation should fail", !form.Validate());
        Check("Form should have errors", form.ErrorCount() > 0);
        Check("First error message matches", form.FirstError() != "");

        // 5. 填入数据并通过校验
        nameInput.SetText("admin");
        emailInput.SetText("admin@example.com");
        agreeBox.SetChecked(true);

        Check("Validation passes after correct input", form.Validate());
        Check("Error count drops to 0", form.ErrorCount() == 0);

        // 6. 验证字典批量导出映射（GetValues）
        Dictionary<string, string> values = form.GetValues();
        Check("GetValues returns username", values["username"] == "admin");
        Check("GetValues returns email", values["email"] == "admin@example.com");
        Check("GetValues returns agreed", values["agreed"] == "true");

        // 7. 验证字典批量回填映射（SetValues）
        Dictionary<string, string> newValues = new Dictionary<string, string>();
        newValues["username"] = "super_dev";
        newValues["email"] = "dev@zan.org";
        newValues["agreed"] = "false";
        form.SetValues(newValues);

        Check("SetValues updates username", nameInput.GetText() == "super_dev");
        Check("SetValues updates email", emailInput.GetText() == "dev@zan.org");
        Check("SetValues updates agreed", !agreeBox.IsChecked());

        // 8. 验证一键重置（Reset）
        form.Reset();
        Check("Reset clears username", nameInput.GetText() == "");
        Check("Reset clears email", emailInput.GetText() == "");
        Check("Reset clears agreed", !agreeBox.IsChecked());
        Check("Reset clears errors", form.ErrorCount() == 0);

        if (fails == 0) {
            Console.WriteLine("ALL TESTS PASSED: Modern FormItem, FormGroup & Binding verified.");
        } else {
            Console.WriteLine("TOTAL FAILS: " + fails);
            Environment.Exit(1);
        }
    }
}
