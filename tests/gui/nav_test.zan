using System;
using System.Json;
using Gui;
using Gui.Widget;

/// 接口数据协议与执行契约。
/// 接口数据协议与执行契约。
/// 接口数据协议与执行契约。
/// 接口数据协议与执行契约。
/// 接口数据协议与执行契约。
/// 核心契约与执行状态转移规范。
class NavTestPages {
    static Control Home() {
        Panel p = new Panel("home");
        p.Add(new Label("home body"));
        return p;
    }

    static Control Log() {
        Panel p = new Panel("log");
        p.Add(new Label("log body"));
        return p;
    }

    static string homeEnters;

    static void HomeEnter(NavWindow win, JsonValue args) {
        if (homeEnters == null) { homeEnters = "H"; } else { homeEnters = homeEnters + "H"; }
    }
}

class NavTest {
    static int fails;

    static void Ok(string what, bool cond) {
        if (cond) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void Main() {
        fails = 0;

        // 核心契约与执行状态转移规范。
        Nav.DefineTitle("home", "首页", NavTestPages.Home);
        Nav.Define("log", NavTestPages.Log);
        Nav.OnEnter("home", NavTestPages.HomeEnter);
        Ok("route found", Nav.Find("home") != null);
        Ok("route missing", Nav.Find("nope") == null);

        // 接口数据协议与执行契约。
        Nav.DefineTitle("home", "主页", NavTestPages.Home);
        Eq("redefine keeps hook", NavTestPages.homeEnters, null);

        // 接口数据协议与执行契约。
        Tabs tabs = new Tabs(Tabs.Line());
        Nav.Embed(tabs, "home,log");
        Eq("tab count", Convert.ToString(tabs.Count()), "2");
        Eq("tab label from route title", tabs.LabelAt(0), "主页");
        Eq("plain define label", tabs.LabelAt(1), "log");
        Ok("initial page built", tabs.Page(0).ChildCount() == 1);
        Ok("second page stays lazy", tabs.Page(1).ChildCount() == 0);
        Eq("enter hook ran on build", NavTestPages.homeEnters, "H");

        // 接口数据协议与执行契约。
        tabs.Select(1);
        Ok("page built on select", tabs.Page(1).ChildCount() == 1);
        Ok("first page kept alive", tabs.Page(0).ChildCount() == 1);
        tabs.Select(0);
        Ok("kept page reused (no rebuild)", tabs.Page(0).ChildCount() == 1);
        Eq("keepAlive does not re-enter", NavTestPages.homeEnters, "H");

        // 核心契约与语义定义。
        Nav.Define("eph", NavTestPages.Home);
        Nav.SetKeepAlive("eph", false);
        Nav.DefineTitle("tail", "tail", NavTestPages.Log);
        Tabs t2 = new Tabs(Tabs.Line());
        Nav.Embed(t2, "eph,tail");
        Ok("ephemeral built on open", t2.Page(0).ChildCount() == 1);
        t2.Select(1);
        Ok("ephemeral destroyed on leave", t2.Page(0).ChildCount() == 0);
        Ok("neighbor built", t2.Page(1).ChildCount() == 1);
        t2.Select(0);
        Ok("ephemeral rebuilt on re-enter", t2.Page(0).ChildCount() == 1);

        // 核心契约与语义定义。
        Ok("nothing open", Nav.FindOpen("home") == null);
        Ok("back on empty stack is a no-op", !Nav.Back());
        Nav.CloseAll();

        // 接口数据协议与执行契约。
        Tabs t3 = new Tabs(Tabs.Line());
        Nav.Embed(t3, "home,ghost,log");
        Eq("unknown route skipped", Convert.ToString(t3.Count()), "2");

        if (fails == 0) { Console.WriteLine("NAV_OK"); }
    }
}
