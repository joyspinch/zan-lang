using System;
using Gui;
using Gui.Backend;

class ScopedForm : Form {
    public void Enter(Action loop) { this.RunScoped(loop); }
}

class FormLifetimeWatch {
    public weak Form form;
    public weak App app;
}

class FormLifecycleTest {
    static void Check(string label, bool ok) {
        if (!ok) { throw new Exception("Form lifecycle: " + label); }
    }
    static void Create(FormLifetimeWatch watch, bool fail) {
        ScopedForm form = new ScopedForm();
        form.InitForm("scoped form", 64, 64, true);
        App app = form.GetApp();
        watch.form = form;
        watch.app = app;
        App priorApp = App.frameApp;
        Control priorRoot = UiDriver.root;
        bool caught = false;
        bool validated = false;
        try {
            form.Enter(() => {
                Check("scope registers roots", app.rootControl == form && UiDriver.root == form);
                Check("scope registers repaint", App.frameApp == app && app.frameBody != null);
                validated = true;
                if (fail) { throw new Exception("scope failure"); }
            });
        } catch (Exception e) { caught = true; }
        Check("scope assertions passed", validated);
        Check("exception propagates", caught == fail);
        Check("input root and callback released", app.rootControl == null && app.frameBody == null);
        Check("outer context restored", App.frameApp == priorApp && UiDriver.root == priorRoot);
        Check("form retains reusable host", form.GetApp() == app);
        app.canvas.Destroy();
    }
    static void Main() {
        App frame = App.CreateOffscreen("outer context", 8, 8);
        Control outer = new Control();
        UiDriver.SetRoot(outer);
        FormLifetimeWatch watch = new FormLifetimeWatch();
        Create(watch, false);
        Check("normal scope releases form and host", watch.form == null && watch.app == null);
        Create(watch, true);
        Check("exception scope releases form and host", watch.form == null && watch.app == null);
        UiDriver.SetRoot(null);
        frame.canvas.Destroy();
        Console.WriteLine("FORM_LIFECYCLE_OK");
    }
}
