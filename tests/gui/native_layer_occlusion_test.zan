using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;
using Gui.Component.CodeEditor;
using Gui.Component.Chart;

namespace Gui;

class NativeLayerSpy {
    public static string spec101 = "";
    public static string spec102 = "";
    public static string spec103 = "";
    public static string spec104 = "";
    public static string spec105 = "";
    public static string spec106 = "";
    public static string spec107 = "";
    public static string spec108 = "";
    public static string spec109 = "";
    public static string spec110 = "";
    public static int calls101;
    public static int calls102;
    public static int calls103;
    public static int calls104;
    public static int calls105;
    public static int calls106;
    public static int calls107;
    public static int calls108;
    public static int calls109;
    public static int calls110;

    public static void Reset() {
        spec101 = "";
        spec102 = "";
        spec103 = "";
        spec104 = "";
        spec105 = "";
        spec106 = "";
        spec107 = "";
        spec108 = "";
        spec109 = "";
        spec110 = "";
        calls101 = 0;
        calls102 = 0;
        calls103 = 0;
        calls104 = 0;
        calls105 = 0;
        calls106 = 0;
        calls107 = 0;
        calls108 = 0;
        calls109 = 0;
        calls110 = 0;
    }

    public static void ApplyClip(int handle, string spec) {
        if (handle == 101) { spec101 = spec; calls101 = calls101 + 1; }
        else if (handle == 102) { spec102 = spec; calls102 = calls102 + 1; }
        else if (handle == 103) { spec103 = spec; calls103 = calls103 + 1; }
        else if (handle == 104) { spec104 = spec; calls104 = calls104 + 1; }
        else if (handle == 105) { spec105 = spec; calls105 = calls105 + 1; }
        else if (handle == 106) { spec106 = spec; calls106 = calls106 + 1; }
        else if (handle == 107) { spec107 = spec; calls107 = calls107 + 1; }
        else if (handle == 108) { spec108 = spec; calls108 = calls108 + 1; }
        else if (handle == 109) { spec109 = spec; calls109 = calls109 + 1; }
        else if (handle == 110) { spec110 = spec; calls110 = calls110 + 1; }
    }
}

class MockNativeViewControl : Control {
    public int nativeHandle;

    public MockNativeViewControl(int handle) : base("webview") {
        this.nativeHandle = handle;
    }

    public override void OnPaint(App app) {
        if (this.nativeHandle > 0 && this.bw > 0 && this.bh > 0) {
            NativeLayer.Register(app, this.nativeHandle, this.bx, this.by,
                                 this.bw, this.bh, NativeLayerSpy.ApplyClip);
        }
    }
}

class NativeLayerOcclusionTestForm : Form {
    public Panel opaqueHost;
    public Panel transparentWrap;
    public MockNativeViewControl mainView;
    public Panel zSibling;
    public Button hoverBtn;
    public ScrollColumn scrollBox;
    public MockNativeViewControl scrollView;
    public Panel clipBox;
    public MockNativeViewControl overflowView;
    public MockNativeViewControl topNativeView;
    public SelectBox selectBox;
    public Drawer nonMaskDrawer;
    public Modal nonMaskModal;
    public Modal maskModal;

    public NativeLayerOcclusionTestForm() : base("NativeLayer Occlusion", 960, 720, true) {
        this.SetProp("style", "padding:0; gap:0;");

        Panel root = new Panel();
        root.SetProp("style", "position:relative; width:960px; height:680px; background:#1e2430;");

        opaqueHost = new Panel();
        opaqueHost.SetProp("style", "position:absolute; left:20px; top:20px; width:500px; height:360px; background:#ffffff; padding:0;");
        transparentWrap = new Panel();
        transparentWrap.SetProp("style", "background:transparent; width:500px; height:360px; padding:0;");
        mainView = new MockNativeViewControl(101);
        mainView.Prefer(500, 360);
        transparentWrap.Add(mainView);
        opaqueHost.Add(transparentWrap);
        root.Add(opaqueHost);

        zSibling = new Panel();
        zSibling.SetProp("style", "position:absolute; left:420px; top:20px; width:100px; height:360px; background:#334455; z-index:10;");
        zSibling.SetShown(false);
        root.Add(zSibling);

        hoverBtn = new Button("Hover");
        hoverBtn.SetProp("style", "position:absolute; left:20px; top:400px; width:120px; height:36px;");
        root.Add(hoverBtn);

        selectBox = new SelectBox();
        selectBox.OptionsSource = "Alpha,Beta,Gamma";
        selectBox.SetProp("style", "position:absolute; left:160px; top:400px; width:160px; height:36px;");
        root.Add(selectBox);

        scrollBox = new ScrollColumn();
        scrollBox.SetProp("style", "position:absolute; left:560px; top:20px; width:180px; height:120px; background:#222834; padding:0;");
        Panel spacerTop = new Panel();
        spacerTop.SetProp("style", "background:transparent; width:160px; height:60px;");
        scrollView = new MockNativeViewControl(103);
        scrollView.Prefer(160, 140);
        Panel spacerBottom = new Panel();
        spacerBottom.SetProp("style", "background:transparent; width:160px; height:260px;");
        scrollBox.Add(spacerTop);
        scrollBox.Add(scrollView);
        scrollBox.Add(spacerBottom);
        root.Add(scrollBox);

        clipBox = new Panel();
        clipBox.SetProp("style", "position:absolute; left:560px; top:160px; width:160px; height:100px; overflow:hidden; background:#222834; padding:0;");
        overflowView = new MockNativeViewControl(104);
        overflowView.Prefer(220, 160);
        clipBox.Add(overflowView);
        root.Add(clipBox);

        topNativeView = new MockNativeViewControl(0);
        topNativeView.SetProp("style", "position:absolute; left:20px; top:20px; width:120px; height:120px;");
        topNativeView.SetShown(false);
        root.Add(topNativeView);

        nonMaskDrawer = new Drawer("Panel");
        nonMaskDrawer.SetProp("style", "position:absolute; left:0; top:0; width:960px; height:680px;");
        nonMaskDrawer.mask = false;
        nonMaskDrawer.DrawerPlacement = "right";
        nonMaskDrawer.DrawerSize = 500;
        root.Add(nonMaskDrawer);

        nonMaskModal = new Modal("Info");
        nonMaskModal.SetProp("style", "position:absolute; left:0; top:0; width:960px; height:680px;");
        nonMaskModal.mask = false;
        nonMaskModal.ModalWidth = 260;
        nonMaskModal.ModalHeight = 180;
        root.Add(nonMaskModal);

        maskModal = new Modal("Confirm");
        maskModal.SetProp("style", "position:absolute; left:0; top:0; width:960px; height:680px;");
        maskModal.mask = true;
        maskModal.ModalWidth = 260;
        maskModal.ModalHeight = 180;
        root.Add(maskModal);

        this.Add(root);
    }

    static void Check(bool ok, string msg) {
        if (!ok) { throw new Exception("native_layer_occlusion_test: " + msg); }
    }

    static void ParseRects(string spec, List<int> outRects) {
        outRects.Clear();
        if (spec == null || spec == "") { return; }
        List<string> parts = spec.Split(";");
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (parts[i] == "") { continue; }
            List<string> nums = parts[i].Split(",");
            if (nums.Count < 4) { continue; }
            outRects.Add(Convert.ToInt32(nums[0]));
            outRects.Add(Convert.ToInt32(nums[1]));
            outRects.Add(Convert.ToInt32(nums[2]));
            outRects.Add(Convert.ToInt32(nums[3]));
        }
    }

    static bool RectOverlaps(int ax, int ay, int aw, int ah, int bx, int by, int bw, int bh) {
        return ax < bx + bw && ax + aw > bx && ay < by + bh && ay + ah > by;
    }

    static bool SpecOverlapsRect(string spec, int rx, int ry, int rw, int rh) {
        List<int> rects = new List<int>();
        ParseRects(spec, rects);
        for (int i = 0; i + 3 < rects.Count; i = i + 4) {
            if (RectOverlaps(rects[i], rects[i + 1], rects[i + 2], rects[i + 3], rx, ry, rw, rh)) {
                return true;
            }
        }
        return false;
    }

    static int SpecArea(string spec) {
        List<int> rects = new List<int>();
        ParseRects(spec, rects);
        int area = 0;
        for (int i = 0; i + 3 < rects.Count; i = i + 4) {
            area = area + rects[i + 2] * rects[i + 3];
        }
        return area;
    }

    static void Drain(App app) {
        app.DrainPosts();
        while (true) {
            Action action = Dispatcher.Take();
            if (action == null) { return; }
            action();
        }
    }

    public void Exercise() {
        this.RunScoped(this.ExerciseScoped);
    }

    private void ExerciseScoped() {
        App app = this.GetApp();
        app.showChrome = true;
        app.EnableSkins();
        ThemeSettings.Enable(app);
        NativeLayerSpy.Reset();

        // 1. Opaque parent + transparent wrapper do NOT occlude child native view;
        //    overflow:hidden clips 104 to clipBox; ScrollColumn clips 103 to viewport.
        this.CaptureSnapshot();
        Check(NativeLayerSpy.calls101 > 0 && NativeLayerSpy.spec101 != "", "101 visible under opaque parent and transparent wrapper");
        Check(SpecArea(NativeLayerSpy.spec101) == mainView.bw * mainView.bh,
              "101 retains full area when only earlier parent/transparent backgrounds exist");

        Check(NativeLayerSpy.spec104 != "", "104 visible inside overflow:hidden container");
        Check(SpecArea(NativeLayerSpy.spec104) == clipBox.bw * clipBox.bh,
              "104 clipped to overflow:hidden clipBox bounds");

        Rect scrollVp = scrollBox.ScrollViewport();
        Check(NativeLayerSpy.spec103 != "", "103 initially visible in ScrollColumn");
        Check(SpecArea(NativeLayerSpy.spec103) <= scrollVp.width * scrollVp.height,
              "103 clipped to ScrollColumn viewport");
        Check(!SpecOverlapsRect(NativeLayerSpy.spec103, 0, scrollVp.y + scrollVp.height, 960, 720),
              "103 has no visible rect below ScrollColumn viewport");

        // 2. Scroll 103 completely past viewport bottom -> HideUnregistered emits "".
        app.ProcessOffscreenInput(1, scrollBox.bx + 8, scrollBox.by + 8, 0, 0, 0, 0);
        for (int i = 0; i < 12; i = i + 1) {
            app.ProcessOffscreenInput(13, scrollBox.bx + 8, scrollBox.by + 8, 0, -120, 0, 0);
        }
        this.CaptureSnapshot();
        Check(NativeLayerSpy.spec103 == "", "103 hidden when scrolled outside ScrollColumn viewport");
        for (int i = 0; i < 12; i = i + 1) {
            app.ProcessOffscreenInput(13, scrollBox.bx + 8, scrollBox.by + 8, 0, 120, 0, 0);
        }
        this.CaptureSnapshot();
        Check(NativeLayerSpy.spec103 != "", "103 visible again when scrolled back into viewport");

        // 3. Partial damage frame must NOT clip native layers to the dirty strip.
        app.SetPartialFrames(true);
        app.RequestAnimationFrameIn(hoverBtn.bx, hoverBtn.by, hoverBtn.bw, hoverBtn.bh);
        this.CaptureSnapshot();
        Check(SpecArea(NativeLayerSpy.spec101) == mainView.bw * mainView.bh,
              "partial damage frame does not falsely clip 101");
        app.SetPartialFrames(false);

        // 4. Higher z-index opaque sibling occludes overlapped area of 101.
        zSibling.SetShown(true);
        this.CaptureSnapshot();
        Check(!SpecOverlapsRect(NativeLayerSpy.spec101, zSibling.bx, zSibling.by, zSibling.bw, zSibling.bh),
              "higher z-index sibling occludes 101");
        Check(SpecArea(NativeLayerSpy.spec101) == (mainView.bw - zSibling.bw) * mainView.bh,
              "101 keeps unoccluded left strip next to zSibling");
        zSibling.SetShown(false);

        // 5. ThemeDrawer (overlayHost + mask=true) hides 101 behind scrim, then restores on dismiss.
        app.ToggleThemeMenu(0);
        this.CaptureSnapshot();
        Check(app.overlayHost.HasActive(), "ThemeDrawer active in OverlayHost");
        Check(NativeLayerSpy.spec101 == "", "ThemeDrawer with mask hides 101");
        app.overlayHost.Dismiss();
        this.CaptureSnapshot();
        Check(SpecArea(NativeLayerSpy.spec101) == mainView.bw * mainView.bh,
              "101 restored after ThemeDrawer dismiss");

        // 6. Non-mask Drawer occludes only drawerBox, leaving left side visible.
        nonMaskDrawer.Show();
        this.CaptureSnapshot();
        Control drawerSurface = nonMaskDrawer.Box();
        Check(drawerSurface.bw > 0, "nonMaskDrawer surface measured");
        Check(!SpecOverlapsRect(NativeLayerSpy.spec101, drawerSurface.bx, drawerSurface.by, drawerSurface.bw, drawerSurface.bh),
              "nonMaskDrawer surface occludes overlapped portion of 101");
        Check(SpecArea(NativeLayerSpy.spec101) > 0,
              "nonMaskDrawer without mask keeps unoccluded portion of 101 visible");
        nonMaskDrawer.Hide();

        // 7. Non-mask Modal occludes only modalBox; mask Modal occludes full viewport.
        nonMaskModal.Show();
        this.CaptureSnapshot();
        Control modalCard = nonMaskModal.Box();
        Check(!SpecOverlapsRect(NativeLayerSpy.spec101, modalCard.bx, modalCard.by, modalCard.bw, modalCard.bh),
              "nonMaskModal card occludes overlapped portion of 101");
        Check(SpecArea(NativeLayerSpy.spec101) > 0,
              "nonMaskModal keeps unoccluded outer portion of 101 visible");
        nonMaskModal.Hide();

        maskModal.Show();
        this.CaptureSnapshot();
        Check(NativeLayerSpy.spec101 == "", "maskModal hides 101 behind full modal mask");
        maskModal.Hide();

        // 8. ContextMenu opened over 101 via OverlayHost occludes its menu rect.
        ContextMenu ctx = new ContextMenu();
        ctx.AddItem("Inspect", () => { });
        ctx.AddItem("Reload", () => { });
        ctx.ShowAt(app, mainView.bx + 40, mainView.by + 40);
        this.CaptureSnapshot();
        Check(ctx.bw > 0 && ctx.bh > 0, "ContextMenu arranged");
        Check(!SpecOverlapsRect(NativeLayerSpy.spec101, ctx.bx, ctx.by, ctx.bw, ctx.bh),
              "ContextMenu occludes overlapped rect of 101");
        Check(SpecArea(NativeLayerSpy.spec101) > 0, "ContextMenu leaves rest of 101 visible");
        app.overlayHost.Dismiss();

        // 9. SelectBox popup opened via click occludes popup rect of 101.
        app.ProcessOffscreenInput(2, selectBox.bx + 10, selectBox.by + 10, 0, 0, 0, 0);
        app.ProcessOffscreenInput(3, selectBox.bx + 10, selectBox.by + 10, 0, 0, 0, 0);
        Drain(app);
        this.CaptureSnapshot();
        Control selPopup = app.overlayHost.ActiveRoot();
        Check(selPopup != null && selPopup.bw > 0 && selPopup.bh > 0, "SelectBox popup opened");
        Check(!SpecOverlapsRect(NativeLayerSpy.spec101, selPopup.bx, selPopup.by, selPopup.bw, selPopup.bh),
              "SelectBox popup occludes overlapped rect of 101");
        app.overlayHost.Dismiss();

        // 10. LayerWindow occludes 101 behind it, while in-window native view 102 stays visible & clipped!
        LayerState lw = new LayerState("Floating", mainView.bx + 40, mainView.by + 40, 260, 180);
        MockNativeViewControl inWinView = new MockNativeViewControl(102);
        inWinView.Prefer(220, 120);
        lw.view = inWinView;
        lw.Open(app);
        lw.openMs = 0;
        this.CaptureSnapshot();
        Check(!SpecOverlapsRect(NativeLayerSpy.spec101, lw.x, lw.y, lw.w, lw.h),
              "LayerWindow occludes behind-window 101");
        Check(NativeLayerSpy.spec102 != "" && SpecArea(NativeLayerSpy.spec102) > 0,
              "in-window native view 102 is NOT occluded by its own LayerWindow");
        Layer.Close(app, lw);
        this.CaptureSnapshot();
        Check(NativeLayerSpy.spec102 == "", "closing LayerWindow hides unregistered 102");

        // 11. Layer.Msg (Toast) & Layer.Tips (Tooltip) occlude 101.
        Layer.Msg(app, "Saved changes", 1);
        this.CaptureSnapshot();
        int areaWithToast = SpecArea(NativeLayerSpy.spec101);
        Check(areaWithToast < mainView.bw * mainView.bh,
              "Toast in LayerQueue occludes overlapped top area of 101");
        Layer.Context(app).toasts.Clear();

        Layer.Tips(app, mainView.bx + 80, mainView.by + 80, "Browser hint");
        this.CaptureSnapshot();
        Check(SpecArea(NativeLayerSpy.spec101) < mainView.bw * mainView.bh,
              "Tooltip occludes overlapped area of 101");

        // 12. Multiple native layers: later native layer (105/topNativeView) subtracts from earlier (101).
        topNativeView.nativeHandle = 105;
        topNativeView.SetShown(true);
        this.CaptureSnapshot();
        Check(!SpecOverlapsRect(NativeLayerSpy.spec101, topNativeView.bx, topNativeView.by,
                                topNativeView.bw, topNativeView.bh),
              "later native layer subtracts its rect from earlier native layer 101");

        NativeLayer.Forget(101);
        NativeLayer.Forget(102);
        NativeLayer.Forget(103);
        NativeLayer.Forget(104);
        NativeLayer.Forget(105);

        app.StopLoop();
    }
}

class FullWidthOcclusionForm : Form {
    public MockNativeViewControl fullView;
    public Drawer nonMaskDenseDrawer;
    public Panel chipLayer;

    public FullWidthOcclusionForm() : base("FullWidth NativeLayer Occlusion", 960, 720, true) {
        this.SetProp("style", "padding:0; gap:0;");

        Panel root = new Panel();
        root.SetProp("style", "position:relative; width:960px; height:680px; background:#1e2430;");

        fullView = new MockNativeViewControl(107);
        fullView.SetProp("style", "position:absolute; left:0; top:0; width:960px; height:680px;");
        root.Add(fullView);

        chipLayer = new Panel();
        chipLayer.SetProp("style", "position:absolute; left:0; top:0; width:960px; height:680px; background:transparent; z-index:5; display:flex; flex-direction:row; flex-wrap:wrap; gap:8px; padding:12px;");
        for (int i = 0; i < 30; i = i + 1) {
            Button chip = new Button("Chip " + Convert.ToString(i));
            chip.SetProp("style", "width:100px; height:32px;");
            chipLayer.Add(chip);
        }
        chipLayer.SetShown(false);
        root.Add(chipLayer);

        nonMaskDenseDrawer = new Drawer("Dense Panel");
        nonMaskDenseDrawer.SetProp("style", "position:absolute; left:0; top:0; width:960px; height:680px;");
        nonMaskDenseDrawer.mask = false;
        nonMaskDenseDrawer.DrawerPlacement = "right";
        nonMaskDenseDrawer.DrawerSize = 360;
        Panel drawerContent = new Panel();
        drawerContent.SetProp("style", "background:transparent; display:flex; flex-direction:row; flex-wrap:wrap; gap:8px; padding:12px;");
        for (int i = 0; i < 30; i = i + 1) {
            Button item = new Button("Item " + Convert.ToString(i));
            item.SetProp("style", "width:84px; height:30px;");
            drawerContent.Add(item);
        }
        nonMaskDenseDrawer.Add(drawerContent);
        root.Add(nonMaskDenseDrawer);

        this.Add(root);
    }

    static void Check(bool ok, string msg) {
        if (!ok) { throw new Exception("native_layer_occlusion_test: " + msg); }
    }

    static bool SpecOverlapsRect(string spec, int rx, int ry, int rw, int rh) {
        if (spec == null || spec == "") { return false; }
        List<string> parts = spec.Split(";");
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (parts[i] == "") { continue; }
            List<string> nums = parts[i].Split(",");
            if (nums.Count < 4) { continue; }
            int ax = Convert.ToInt32(nums[0]);
            int ay = Convert.ToInt32(nums[1]);
            int aw = Convert.ToInt32(nums[2]);
            int ah = Convert.ToInt32(nums[3]);
            if (ax < rx + rw && ax + aw > rx && ay < ry + rh && ay + ah > ry) { return true; }
        }
        return false;
    }

    static int SpecArea(string spec) {
        if (spec == null || spec == "") { return 0; }
        List<string> parts = spec.Split(";");
        int area = 0;
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (parts[i] == "") { continue; }
            List<string> nums = parts[i].Split(",");
            if (nums.Count < 4) { continue; }
            area = area + Convert.ToInt32(nums[2]) * Convert.ToInt32(nums[3]);
        }
        return area;
    }

    public void Exercise() {
        this.RunScoped(this.ExerciseScoped);
    }

    private void ExerciseScoped() {
        App app = this.GetApp();
        app.showChrome = true;
        app.EnableSkins();
        ThemeSettings.Enable(app);
        NativeLayerSpy.Reset();

        // 14. Full-width native view overlapped by dense ThemeDrawer must be completely occluded.
        app.ToggleThemeMenu(0);
        this.CaptureSnapshot();
        Check(app.overlayHost.HasActive(), "ThemeDrawer active over fullWidth 107");
        Check(NativeLayerSpy.spec107 == "", "ThemeDrawer mask completely occludes full-width 107");
        app.overlayHost.Dismiss();

        // 15. Dense non-mask Drawer over full-width native view must subtract drawerBox first
        //     instead of fragmenting on its 30 interior buttons and leaking the drawer body.
        nonMaskDenseDrawer.Show();
        this.CaptureSnapshot();
        Control box = nonMaskDenseDrawer.Box();
        Check(box.bw > 0 && box.bh > 0, "nonMaskDenseDrawer box arranged");
        Check(!SpecOverlapsRect(NativeLayerSpy.spec107, box.bx, box.by, box.bw, box.bh),
              "nonMaskDenseDrawer surface completely occludes overlapped portion of full-width 107");
        Check(SpecArea(NativeLayerSpy.spec107) == (box.bx - fullView.bx) * fullView.bh,
              "nonMaskDenseDrawer preserves exact unoccluded left strip of 107");
        nonMaskDenseDrawer.Hide();

        // 16. 30 main-tree opaque chips overlapping 107 must not prevent overlay ThemeDrawer from
        //     completely occluding 107 (overlay passes run before main-tree fragmentation).
        chipLayer.SetShown(true);
        app.ToggleThemeMenu(0);
        this.CaptureSnapshot();
        Check(NativeLayerSpy.spec107 == "",
              "ThemeDrawer still occludes 107 when 30 main-tree chips overlap 107 underneath");
        app.overlayHost.Dismiss();
        chipLayer.SetShown(false);

        NativeLayer.Forget(107);
        app.StopLoop();
    }
}

class ComponentOcclusionForm : Form {
    public MockNativeViewControl tableBgView;
    public DataTableControl table;
    public DataTableState tableState;
    public MockNativeViewControl editorBgView;
    public CodeBlock codeBlock;
    public CodeEditor codeEditor;
    public ChartView chartView;
    public MockNativeViewControl chartTipOverlapView;

    public ComponentOcclusionForm() : base("Component NativeLayer Occlusion", 960, 720, true) {
        this.SetProp("style", "padding:0; gap:0;");

        Panel root = new Panel();
        root.SetProp("style", "position:relative; width:960px; height:680px; background:#1e2430;");

        tableBgView = new MockNativeViewControl(108);
        tableBgView.SetProp("style", "position:absolute; left:0; top:0; width:960px; height:220px;");
        root.Add(tableBgView);

        List<DataColumn> cols = new List<DataColumn>();
        cols.Add(DataColumn.Field(DataColumn.Text("Name", 140), "name"));
        cols.Add(DataColumn.Field(DataColumn.Numeric("Qty", 90), "qty"));
        List<DataRow> rows = new List<DataRow>();
        for (int i = 0; i < 6; i = i + 1) {
            DataRow r = new DataRow();
            r.Push("Item" + Convert.ToString(i));
            r.Push(Convert.ToString((i + 1) * 10));
            rows.Add(r);
        }
        DataSource src = new RowListSource(rows);
        tableState = new DataTableState();
        tableState.showRowNum = true;
        table = new DataTableControl(cols, src, tableState);
        table.SetProp("style", "position:absolute; left:20px; top:16px; width:420px; height:160px;");
        root.Add(table);

        editorBgView = new MockNativeViewControl(109);
        editorBgView.SetProp("style", "position:absolute; left:0; top:230px; width:960px; height:220px;");
        root.Add(editorBgView);

        codeBlock = new CodeBlock("Snippet", new List<string>{"int x = 1;", "return x;"});
        codeBlock.SetProp("style", "position:absolute; left:20px; top:240px; width:300px; height:160px;");
        root.Add(codeBlock);

        codeEditor = new CodeEditor();
        codeEditor.SetProp("style", "position:absolute; left:360px; top:240px; width:420px; height:190px;");
        codeEditor.LoadText("Console.Wr");
        codeEditor.curCol = 10;
        root.Add(codeEditor);

        ChartOption opt = ChartOption.FromJson(
            "{\"animation\":false,\"tooltip\":{\"show\":true,\"trigger\":\"axis\"},"
            + "\"xAxis\":{\"type\":\"category\",\"data\":[\"A\",\"B\",\"C\"]},"
            + "\"yAxis\":{\"type\":\"value\",\"min\":0,\"max\":40},"
            + "\"series\":[{\"name\":\"S\",\"type\":\"bar\",\"data\":[10,30,20]}]}");
        chartView = ChartView.Of(opt);
        chartView.SetProp("style", "position:absolute; left:20px; top:460px; width:320px; height:190px;");
        root.Add(chartView);

        // Registered AFTER chartView in main tree: chartView's own background does not
        // occlude this sibling, so only ChartView.FlushTooltips (PresentTails pass) can clip it.
        // Positioned to the right of the hover point (bx + 80) so pointer hits chartView while
        // the tooltip card (bx + 80 + 10 .. +boxW) overlaps 110.
        chartTipOverlapView = new MockNativeViewControl(110);
        chartTipOverlapView.SetProp("style", "position:absolute; left:140px; top:460px; width:200px; height:190px;");
        root.Add(chartTipOverlapView);

        this.Add(root);
    }

    static void Check(bool ok, string msg) {
        if (!ok) { throw new Exception("native_layer_occlusion_test: " + msg); }
    }

    static bool SpecOverlapsRect(string spec, int rx, int ry, int rw, int rh) {
        if (spec == null || spec == "") { return false; }
        List<string> parts = spec.Split(";");
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (parts[i] == "") { continue; }
            List<string> nums = parts[i].Split(",");
            if (nums.Count < 4) { continue; }
            int ax = Convert.ToInt32(nums[0]);
            int ay = Convert.ToInt32(nums[1]);
            int aw = Convert.ToInt32(nums[2]);
            int ah = Convert.ToInt32(nums[3]);
            if (ax < rx + rw && ax + aw > rx && ay < ry + rh && ay + ah > ry) { return true; }
        }
        return false;
    }

    static int SpecArea(string spec) {
        if (spec == null || spec == "") { return 0; }
        List<string> parts = spec.Split(";");
        int area = 0;
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (parts[i] == "") { continue; }
            List<string> nums = parts[i].Split(",");
            if (nums.Count < 4) { continue; }
            area = area + Convert.ToInt32(nums[2]) * Convert.ToInt32(nums[3]);
        }
        return area;
    }

    public void Exercise() {
        this.RunScoped(this.ExerciseScoped);
    }

    private void ExerciseScoped() {
        App app = this.GetApp();
        NativeLayerSpy.Reset();

        // 17. DataTable header dropdown filter popup (kind=1) must occlude its entire
        //     card surface over native view 108, not just its inner inputs/buttons.
        this.CaptureSnapshot();
        tableState.openMenu = 0;
        this.CaptureSnapshot();
        Control filterPopup = app.overlayHost.ActiveRoot();
        Check(filterPopup != null && filterPopup.bw > 200 && filterPopup.bh > 200,
              "DataTable filter popup active");
        Check(!SpecOverlapsRect(NativeLayerSpy.spec108, filterPopup.bx, filterPopup.by,
                                filterPopup.bw, filterPopup.bh),
              "DataTable filter popup completely occludes overlapped area of 108");
        tableState.openMenu = -1;
        app.overlayHost.Dismiss();

        // 18. DataTable chart overlay (kind=5) must occlude 108 over the table overlay rect.
        tableState.chartOpen = true;
        tableState.chartTitle = "Qty";
        tableState.chartMax = 60;
        tableState.chartBars.Clear();
        tableState.chartBars.Add(new ChartBar("A", 20));
        tableState.chartBars.Add(new ChartBar("B", 60));
        this.CaptureSnapshot();
        Control chartPopup = app.overlayHost.ActiveRoot();
        Check(chartPopup != null && chartPopup.bw >= table.bw && chartPopup.bh >= table.bh,
              "DataTable chart overlay active");
        Check(!SpecOverlapsRect(NativeLayerSpy.spec108, table.bx, table.by, table.bw, table.bh),
              "DataTable chart overlay occludes table bounds on 108");
        tableState.chartOpen = false;
        app.overlayHost.Dismiss();

        // 19. CodeBlock, CodeEditor surface, and CodeEditor completion popup emit occluders.
        codeEditor.Focus(app);
        codeEditor.ForceCompletion();
        Check(codeEditor.acActive, "CodeEditor completion popup active");
        this.CaptureSnapshot();
        Check(!SpecOverlapsRect(NativeLayerSpy.spec109, codeBlock.bx, codeBlock.by,
                                codeBlock.bw, codeBlock.bh),
              "CodeBlock occludes overlapped area of 109");
        Check(!SpecOverlapsRect(NativeLayerSpy.spec109, codeEditor.bx, codeEditor.by,
                                codeEditor.bw, codeEditor.bh),
              "CodeEditor occludes overlapped area of 109");
        Check(codeEditor.popW > 0 && codeEditor.popH > 0, "CodeEditor completion popup painted");
        int editorOccCount = 0;
        for (int oi = 0; oi + 3 < app.nativeOccluders.Count; oi = oi + 4) {
            int ox = app.nativeOccluders[oi];
            int oy = app.nativeOccluders[oi + 1];
            int ow = app.nativeOccluders[oi + 2];
            int oh = app.nativeOccluders[oi + 3];
            if (ox == codeEditor.popX && oy == codeEditor.popY
                    && ow == codeEditor.popW && oh == codeEditor.popH) {
                editorOccCount = editorOccCount + 1;
            }
        }
        Check(editorOccCount > 0, "CodeEditor completion popup emits its own occluder");

        // 20. ChartView.FlushTooltips (PresentTails pass) occludes overlapped native view 110.
        app.ProcessOffscreenInput(1, chartView.bx + 80,
                                  chartView.by + chartView.bh / 2, 0, 0, 0, 0);
        this.CaptureSnapshot();
        Check(SpecArea(NativeLayerSpy.spec110) < chartTipOverlapView.bw * chartTipOverlapView.bh,
              "ChartView.FlushTooltips occludes overlapped region of 110");

        NativeLayer.Forget(108);
        NativeLayer.Forget(109);
        NativeLayer.Forget(110);
        codeEditor.DetachAnalysis();
        chartView.Dispose();
        app.StopLoop();
    }
}

class Program {
    static void Check(bool ok, string msg) {
        if (!ok) { throw new Exception("native_layer_occlusion_test: " + msg); }
    }

    static bool SpecOverlapsRect(string spec, int rx, int ry, int rw, int rh) {
        if (spec == null || spec == "") { return false; }
        List<string> parts = spec.Split(";");
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (parts[i] == "") { continue; }
            List<string> nums = parts[i].Split(",");
            if (nums.Count < 4) { continue; }
            int ax = Convert.ToInt32(nums[0]);
            int ay = Convert.ToInt32(nums[1]);
            int aw = Convert.ToInt32(nums[2]);
            int ah = Convert.ToInt32(nums[3]);
            if (ax < rx + rw && ax + aw > rx && ay < ry + rh && ay + ah > ry) { return true; }
        }
        return false;
    }

    static void RunChromeCheck() {
        // 13. Chrome titlebar occludes native view overlapping y < titlebarH.
        App app = App.CreateOffscreen("NativeLayer Chrome", 400, 200);
        app.showChrome = true;
        app.BeginOffscreenFrame();
        if (!app.PrepareStandardHostFrame()) { throw new Exception("chrome check prepare failed"); }
        NativeLayer.Register(app, 106, 0, 0, 400, 200, NativeLayerSpy.ApplyClip);
        app.RenderChrome("NativeLayer Occlusion");
        app.EndOffscreenFrame();
        Check(NativeLayerSpy.spec106 != "", "106 visible below chrome titlebar");
        Check(!SpecOverlapsRect(NativeLayerSpy.spec106, 0, 0, 400, app.titlebarH),
              "Chrome titlebar occludes overlapped top strip of 106");
        NativeLayer.Forget(106);
        app.StopLoop();
        app.canvas.Destroy();
    }

    static void Run() {
        NativeLayerOcclusionTestForm form = new NativeLayerOcclusionTestForm();
        App app = form.GetApp();
        form.Exercise();
        app.SetRootControl(null);
        Layer.Context(app).inputRoot = null;
        Layer.Context(app).windowHost = null;
        Layer.Context(app).zorder = null;
        app.canvas.Destroy();
    }

    static void RunFullWidthDrawerCheck() {
        FullWidthOcclusionForm form = new FullWidthOcclusionForm();
        App app = form.GetApp();
        form.Exercise();
        app.SetRootControl(null);
        Layer.Context(app).inputRoot = null;
        Layer.Context(app).windowHost = null;
        Layer.Context(app).zorder = null;
        app.canvas.Destroy();
    }

    static void RunComponentOcclusionCheck() {
        ComponentOcclusionForm form = new ComponentOcclusionForm();
        App app = form.GetApp();
        form.Exercise();
        app.SetRootControl(null);
        app.DrainPosts();
        while (true) {
            Action action = Dispatcher.Take();
            if (action == null) { break; }
            action();
        }
        Layer.Context(app).inputRoot = null;
        Layer.Context(app).windowHost = null;
        Layer.Context(app).zorder = null;
        app.canvas.Destroy();
    }

    static void Main() {
        App primer = App.CreateOffscreen("NativeLayer occlusion primer", 1, 1);
        primer.StopLoop();
        Run();
        RunChromeCheck();
        RunFullWidthDrawerCheck();
        RunComponentOcclusionCheck();
        Console.WriteLine("native layer occlusion ok");
    }
}
