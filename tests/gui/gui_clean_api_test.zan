using System;
using Gui;
using Gui.Widget;

class GuiCleanApiTest {
    static int fails;

    static void Check(string label, bool ok) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL: " + label);
    }

    static void Main() {
        // 1. 测试窗口与树形上下文自然上溯（消灭手动 UseApp / 手动注入）
        Form win = Form.CreateOffscreen("CleanApiWindow", 640, 480);
        Panel rootPanel = Panel.Column();
        Panel subPanel = Panel.Row();
        Button btn = new Button("ClickMe");

        // 尚未挂树时为 null
        Check("unattached FindForm is null", btn.FindForm() == null);
        Check("unattached FindApp is null", btn.FindApp() == null);

        // 组合挂树
        subPanel.Add(btn);
        rootPanel.Add(subPanel);
        win.Add(rootPanel);

        // 挂树后深层子控件自然拥有宿主，完全符合 C# 控件树直觉
        Check("attached FindForm matches window", btn.FindForm() == win);
        Check("attached FindApp matches window app", btn.FindApp() == win.GetApp());

        // 2. 测试 Tabs.AddPage 干净整洁的面向对象装配（消灭 .Root、消灭手拆 Page 容器）
        Tabs tabs = new Tabs();
        Panel page1Content = Panel.Column();
        Button pageBtn = new Button("Page1Btn");
        page1Content.Add(pageBtn);

        // 直接一行代码添加标签页与内容控件
        tabs.AddPage("监控页", page1Content);
        win.Add(tabs);

        Check("tabs count is 1", tabs.Count() == 1);
        Check("tabs label matches", tabs.LabelAt(0) == "监控页");
        Check("page content attached to form", pageBtn.FindForm() == win);

        // 3. 测试 Form.CaptureSnapshot 极简快照（消灭手动 Viewport / 手动四段式 RenderFrame 管线调用）
        Canvas snapshot = win.CaptureSnapshot();
        Check("snapshot not null", snapshot != null);
        Check("snapshot width", snapshot.Width() >= 640);
        Check("snapshot height", snapshot.Height() >= 480);

        if (fails == 0) {
            Console.WriteLine("CLEAN_API_TEST_OK");
        } else {
            Console.WriteLine("TEST_FAILS=" + Convert.ToString(fails));
            throw new Exception("Clean API test failed with " + Convert.ToString(fails) + " errors.");
        }
    }
}
