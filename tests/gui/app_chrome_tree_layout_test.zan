using System;
using Gui;
using Gui.Widget;

class AppChromeTreeLayoutTest {
    static void Check(bool ok, string label) {
        if (!ok) { throw new Exception(label); }
    }

    static void CheckStrip(App app, int count, int buttonWidth, int height, string label) {
        Control strip = app.chromeTree;
        Check(strip != null && strip is Flex, label + " uses Flex");
        Check(strip.ChildCount() == 5,
        label + " keeps persistent buttons count=" + Convert.ToString(strip.ChildCount()));
        int right = app.canvas.Width() - app.ShapeOffX();
        int next = right - count * buttonWidth;
        Check(strip.bx == next && strip.bw == count * buttonWidth, label + " right aligned");
        int seen = 0;
        for (int i = 0; i < strip.ChildCount(); i = i + 1) {
            Control button = strip.ChildAt(i);
            if (!button.visible) { continue; }
            Check(button.bx == next && button.by == app.ShapeOffY(), label + " stays on caption row");
            Check(button.bw == buttonWidth && button.bh == height, label + " uses device pixels");
            int center = button.bx + button.bw / 2;
            if (center >= app.ShapeOffX() && center < right) {
                Control hit = strip.HitTest(center, button.by + button.bh / 2, 0);
                while (hit != null && hit != button) { hit = hit.parent; }
                Check(hit == button, label + " hit routes through the arranged button");
            }
            next = next + buttonWidth;
            seen = seen + 1;
        }
        Check(seen == count && next == right, label + " visible buttons pack without gaps");
    }

    static void Metrics(App app, int scale, int titleHeight) {
        app.dpiScale = scale;
        app.titlebarH = app.Scale(titleHeight);
        app.captionBtnW = app.Scale(46);
    }

    static void Main() {
        Form form = Form.CreateOffscreen("Chrome layout", 640, 240);
        App app = form.GetApp();
        app.showChrome = true;
        app.showThemeButton = true;
        app.showPinButton = true;
        app.showMinimizeButton = true;
        app.showMaximizeButton = true;
        app.showCloseButton = true;
        Metrics(app, 100, 32);
        Control beforeRoot = app.rootControl;
        form.CaptureSnapshot();
        CheckStrip(app, 5, 46, 32, "default");
        Check(app.rootControl == beforeRoot, "snapshot preserves input root");
        Check(app.chromeTheme.Icon == "palette" && app.chromePin.Icon == "pinned"
        && app.chromeMinimize.Icon == "minus" && app.chromeMaximize.Icon == "square"
        && app.chromeClose.Icon == "close", "caption uses existing glyph keys");
        Console.WriteLine("default five buttons share one row and hit rectangles");

        app.SetChromeButtons(false, false, true, true);
        form.CaptureSnapshot();
        CheckStrip(app, 3, 46, 32, "hidden options");
        Check(!app.chromeTheme.visible && !app.chromePin.visible, "hidden options leave the flow");
        Console.WriteLine("hidden options leave no gaps");

        app.SetChromeButtons(true, true, true, true);
        app.isTopmost = true;
        form.CaptureSnapshot();
        CheckStrip(app, 5, 46, 32, "restored options");
        Check(app.chromePin.Icon == "pinned-off", "topmost uses existing unpin glyph");
        Console.WriteLine("restored options retain order and update pin glyph");

        Metrics(app, 200, 48);
        form.CaptureSnapshot();
        CheckStrip(app, 5, 92, 72, "scaled tall caption");
        Console.WriteLine("200 percent scale uses device pixels and caps strip height");

        Form narrow = Form.CreateOffscreen("Narrow chrome", 120, 160);
        App narrowApp = narrow.GetApp();
        narrowApp.showChrome = true;
        narrowApp.SetChromeButtons(true, true, true, true);
        narrowApp.showCloseButton = true;
        Metrics(narrowApp, 100, 32);
        narrow.CaptureSnapshot();
        CheckStrip(narrowApp, 5, 46, 32, "narrow");
        Check(narrowApp.chromeTheme.bx < narrowApp.ShapeOffX(), "narrow window clips the left side");
        Check(narrowApp.chromeClose.bx >= narrowApp.ShapeOffX(), "narrow window keeps Close reachable");
        Console.WriteLine("narrow window keeps rightmost Close reachable without wrapping");

        narrowApp.SetChildMode(true);
        narrow.CaptureSnapshot();
        CheckStrip(narrowApp, 3, 46, 32, "child window");
        Check(!narrowApp.chromeTheme.visible && !narrowApp.chromePin.visible,
        "child window hides theme and pin");
        Console.WriteLine("child window keeps only minimize maximize and Close");
    }
}
