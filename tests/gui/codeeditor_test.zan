using System;
using Gui;
using Gui.Component.CodeEditor;

namespace CodeEditorTest;

/// 核心契约与语义定义。
/// 核心契约与语义定义。
/// 核心契约与语义定义。
class Program {
    static bool Has(List<string> xs, string v) {
        for (int i = 0; i < xs.Count; i = i + 1) {
            if (xs[i] == v) { return true; }
        }
        return false;
    }

    static void Require(bool value, string message) {
        if (!value) { throw new Exception(message); }
    }

    static void CheckSemanticCompletion() {
        CodeEditor e = new CodeEditor();
        e.documentPath = "completion.zan";
        e.LoadText("abTail");
        e.curCol = 2;
        e.externalCompletion = (string path, int line, int col) => {
            List<CodeCompletionItem> items = new List<CodeCompletionItem>();
            CodeCompletionItem item = new CodeCompletionItem("abDisplay", "M", "", "");
            item.insertText = "actual\nnext";
            item.hasTextEdit = true;
            item.startLine = 0; item.startCol = 0;
            item.endLine = 0; item.endCol = 6;
            items.Add(item);
            return items;
        };
        e.UpdateCompletion();
        Require(e.CompletionItem(0) == "abDisplay", "semantic candidate order");
        int before = e.TextStamp();
        e.AcceptCompletion(true);
        Require(e.GetText() == "actual\nnext", "Tab uses textEdit newText and suffix range");
        Require(e.CurLine() == 1 && e.CurCol() == 4 && e.TextStamp() > before, "completion caret and version");
        e.Undo();
        Require(e.GetText() == "abTail", "completion is one undo action");

        e.UpdateCompletion();
        e.BumpTextVersion();
        e.ApplyKindFilter();
        Require(!e.acActive, "filter must not renew a stale candidate version");
        e.AcceptCompletion(true);
        Require(e.GetText() == "abTail", "stale completion cannot edit text");

        e.externalCompletion = (string path, int line, int col) => {
            e.BumpTextVersion();
            List<CodeCompletionItem> items = new List<CodeCompletionItem>();
            items.Add(new CodeCompletionItem("abLate", "M", "", ""));
            return items;
        };
        e.UpdateCompletion();
        Require(!e.acActive, "provider result is stale after a same-text version change");
        e.externalCompletion = (string path, int line, int col) => {
            e.curCol = col + 1;
            List<CodeCompletionItem> items = new List<CodeCompletionItem>();
            items.Add(new CodeCompletionItem("abMoved", "M", "", ""));
            return items;
        };
        e.UpdateCompletion();
        Require(!e.acActive && e.GetText() == "abTail", "provider result is stale after caret movement");

        string unicode = "中𠮷ab";
        Require(CodeEditor.ByteColumnToUtf16(unicode, 7) == 3
            && CodeEditor.Utf16ColumnToByte(unicode, 3) == 7, "completion UTF-16 positions");

        CodeEditor dot = new CodeEditor();
        dot.documentPath = "dot.zan";
        dot.LoadText("obj.");
        dot.curCol = 4;
        dot.externalCompletion = (string path, int line, int col) => {
            List<CodeCompletionItem> items = new List<CodeCompletionItem>();
            CodeCompletionItem item = new CodeCompletionItem("Run", "M", "", "");
            item.insertText = "Run()";
            items.Add(item);
            return items;
        };
        dot.DotCompletion();
        dot.AcceptCompletion(true);
        Require(dot.GetText() == "obj.Run()", "dot completion retains insertText");
    }

    static void SelectItem(CodeEditor e, string label) {
        int i = 0;
        while (i < e.acItems.Count) {
            if (e.acItems[i] == label) { e.acSel = i; return; }
            i = i + 1;
        }
        throw new Exception("SelectItem: missing " + label);
    }

    /// Tab 无弹窗时的词补全，以及弹窗选中项的行内幽灵预测。
    /// 全部用 Require 断言，不产出新的黄金输出行。
    static void CheckTabCompletionAndGhost() {
        CodeEditor tc = new CodeEditor();
        tc.lines[0] = "    someLongName someLo";
        tc.curLine = 0;
        tc.curCol = tc.lines[0].Length;
        Require(tc.TryCompleteWord(), "Tab completes the word before the caret");
        Require(tc.lines[0] == "    someLongName someLongName",
            "word completion inserts the shared extension");
        Require(tc.curCol == tc.lines[0].Length, "word completion moves the caret");
        Require(!tc.acActive, "word completion does not open the popup");

        CodeEditor tn = new CodeEditor();
        tn.lines[0] = "zzqq";
        tn.curLine = 0;
        tn.curCol = 4;
        Require(!tn.TryCompleteWord(), "no candidate falls back");
        Require(tn.lines[0] == "zzqq", "failed word completion does not edit");

        CodeEditor tm = new CodeEditor();
        tm.lines[0] = "someLongName";
        tm.curLine = 0;
        tm.curCol = 6;
        Require(!tm.TryCompleteWord(), "caret inside a word does not complete");

        CodeEditor g = new CodeEditor();
        g.lines[0] = "fro";
        g.curLine = 0;
        g.curCol = 3;
        g.UpdateCompletion();
        Require(g.acActive, "ghost: popup open");
        SelectItem(g, "from");
        Require(g.GhostExtension() == "m", "ghost extends the typed prefix");

        CodeEditor gs = new CodeEditor();
        gs.lines[0] = "whi";
        gs.curLine = 0;
        gs.curCol = 3;
        gs.UpdateCompletion();
        Require(gs.acActive, "ghost snippet: popup open");
        SelectItem(gs, "while");
        Require(gs.GhostExtension() == "", "snippets have no inline prediction");

        CodeEditor ge = new CodeEditor();
        ge.documentPath = "ghost.zan";
        ge.LoadText("ab");
        ge.curCol = 2;
        ge.externalCompletion = (string path, int line, int col) => {
            List<CodeCompletionItem> items = new List<CodeCompletionItem>();
            CodeCompletionItem item = new CodeCompletionItem("abX", "M", "", "");
            item.insertText = "actual";
            items.Add(item);
            return items;
        };
        ge.UpdateCompletion();
        Require(ge.acActive, "ghost semantic: popup open");
        Require(ge.GhostExtension() == "", "semantic insertText has no inline prediction");
    }

    static void Main() {
        CheckSemanticCompletion();
        CheckTabCompletionAndGhost();
        // 核心契约与执行状态转移规范。
        CodeEditor e = new CodeEditor();
        e.lines[0] = "    fo";
        e.curLine = 0;
        e.curCol = 6;
        e.UpdateCompletion();
        Console.WriteLine(e.acActive);
        Console.WriteLine(Has(e.acItems, "for"));
        Console.WriteLine(Has(e.acItems, "foreach"));

        // 核心契约与语义定义。
        int sel = 0;
        while (sel < e.acItems.Count) {
            if (e.acItems[sel] == "for") { e.acSel = sel; sel = e.acItems.Count; }
            else { sel = sel + 1; }
        }
        e.AcceptCompletion(true);
        Console.WriteLine(e.lines.Count);
        Console.WriteLine(e.lines[0]);
        Console.WriteLine(e.lines[1]);
        Console.WriteLine(e.lines[2]);
        Console.WriteLine(e.curLine);
        Console.WriteLine(e.acActive);

        // 核心契约与语义定义。
        CodeEditor w = new CodeEditor();
        w.lines[0] = "whi";
        w.curLine = 0;
        w.curCol = 3;
        w.UpdateCompletion();
        Console.WriteLine(w.acActive);
        int wi = 0;
        while (wi < w.acItems.Count) {
            if (w.acItems[wi] == "while") { w.acSel = wi; wi = w.acItems.Count; }
            else { wi = wi + 1; }
        }
        w.AcceptCompletion(false);
        Console.WriteLine(w.lines[0]);
        Console.WriteLine(w.curCol);

        // 核心契约与语义定义。
        CodeEditor n = new CodeEditor();
        n.lines[0] = "if";
        n.curLine = 0;
        n.curCol = 2;
        n.UpdateCompletion();
        if (n.acActive) {
            int ni = 0;
            while (ni < n.acItems.Count) {
                if (n.acItems[ni] == "ifelse") { n.acSel = ni; ni = n.acItems.Count; }
                else { ni = ni + 1; }
            }
            n.AcceptCompletion(false);
        }
        Console.WriteLine(n.lines.Count);
        Console.WriteLine(n.lines[0]);

        // 核心契约与语义定义。
        CodeEditor t = new CodeEditor();
        t.lines[0] = "tr";
        t.curLine = 0;
        t.curCol = 2;
        t.UpdateCompletion();
        int ti = 0;
        while (ti < t.acItems.Count) {
            if (t.acItems[ti] == "try") { t.acSel = ti; ti = t.acItems.Count; }
            else { ti = ti + 1; }
        }
        t.AcceptCompletion(true);
        Console.WriteLine(t.lines.Count);
        Console.WriteLine(t.lines[0]);
        Console.WriteLine(t.lines[2]);
        Console.WriteLine(t.curLine);

        // 核心契约与语义定义。
        CodeEditor sc = new CodeEditor();
        List<string> sampleLines = new List<string>();
        for (int i = 0; i < 50; i = i + 1) {
            sampleLines.Add("Line " + Convert.ToString(i));
        }
        sc.SetLines(sampleLines);
        sc.SetScrollLine(10);
        Console.WriteLine(sc.ScrollLine());
        Rect area = new Rect(0, 100, 400, 300);
        sc.BuildRowLayout(area, 20, 0);
        Console.WriteLine(sc.ScrollY());
        Console.WriteLine(sc.visibleRows[0].line);
        Console.WriteLine(sc.visibleRows[0].top);
        sc.SetScrollY(205);
        sc.BuildRowLayout(area, 20, 0);
        Console.WriteLine(sc.visibleRows[0].line);
        Console.WriteLine(sc.visibleRows[0].top);
    }
}
