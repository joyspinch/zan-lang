using System;
using Gui;
using Gui.Widget;

/// 无窗口回归：Slider 的值域数学（step / step="mark" 量化与键盘步进）、
/// 四向几何映射（横向/竖向 × 正/倒转的 ValAt/PxAt 互逆）、范围双柄的
/// 读写与双向绑定、tooltip 模板与 designer 的 marks 往返串。全部是
/// 纯计算，不需要窗口，对着 golden 比。
class Program {
    static void Line(string s) { Console.WriteLine(s); }

    static void Main() {
        // ---- 量化：step ------------------------------------------------
        Slider st = new Slider(0, 100);
        st.step = 3;
        Line($"step 55 -> {st.Quantize(55)}");
        Line($"step 98 -> {st.Quantize(98)}");
        Line($"step -5 -> {st.Quantize(-5)}");
        Line($"step 120 -> {st.Quantize(120)}");

        // ---- 标记刻度：排序 / 覆盖 / 吸附 / 键盘步进 -------------------
        Slider mk = new Slider(0, 100);
        mk.AddMark(37, "37°C");
        mk.AddMark(20, "20°C");
        mk.AddMark(100, "100°C");
        mk.AddMark(0, "0°C");
        Line($"marks count {mk.MarkCount()}");
        Line($"mark0 {mk.MarkValueAt(0)} {mk.MarkLabelAt(0)}");
        Line($"mark3 {mk.MarkValueAt(3)} {mk.MarkLabelAt(3)}");
        mk.AddMark(20, "二十度");
        Line($"replace {mk.MarkValueAt(1)}={mk.MarkLabelAt(1)}");
        mk.stepMark = true;
        Line($"mark 55 -> {mk.Quantize(55)}");
        Line($"mark 98 -> {mk.Quantize(98)}");
        Line($"next 40 -> {mk.StepUpVal(40)}");
        Line($"prev 40 -> {mk.StepDownVal(40)}");
        Line($"next 100 -> {mk.StepUpVal(100)}");
        Line($"prev 0 -> {mk.StepDownVal(0)}");
        mk.stepMark = false;
        mk.step = 0;
        Line($"free 55 -> {mk.Quantize(55)}");

        // ---- 几何：横向 / 竖向 × 正 / 倒转（ValAt 与 PxAt 互逆）-------
        Slider hz = new Slider(0, 100);
        Line($"hz val@110 {hz.ValAt(110, 10, 200)}");
        Line($"hz val@10 {hz.ValAt(10, 10, 200)}");
        Line($"hz px@50 {hz.PxAt(hz.FracOf(50), 10, 200)}");
        hz.reverse = true;
        Line($"hz-rev val@110 {hz.ValAt(110, 10, 200)}");
        Line($"hz-rev val@20 {hz.ValAt(20, 10, 200)}");
        Line($"hz-rev px@90 {hz.PxAt(hz.FracOf(90), 10, 200)}");
        hz.reverse = false;

        Slider vt = new Slider(0, 100);
        vt.vertical = true;
        Line($"vt val@0 {vt.ValAt(0, 0, 200)}");
        Line($"vt val@200 {vt.ValAt(200, 0, 200)}");
        Line($"vt px@25 {vt.PxAt(vt.FracOf(25), 0, 200)}");
        vt.reverse = true;
        Line($"vt-rev val@0 {vt.ValAt(0, 0, 200)}");
        Line($"vt-rev val@200 {vt.ValAt(200, 0, 200)}");
        Line($"vt-rev px@25 {vt.PxAt(vt.FracOf(25), 0, 200)}");

        // ---- 范围双柄：SetRange 交换 / 双向绑定两个方向 ----------------
        Slider rg = new Slider(0, 100);
        rg.range = true;
        rg.SetRange(70, 20);
        Line($"range {rg.Low()} {rg.High()}");
        rg.SetValue(55);
        Line($"range setlo {rg.Low()} {rg.High()}");
        RangeModel rm = new RangeModel();
        rm.lo = 20;
        rm.hi = 70;
        rg.data = rm.lo;
        rg.dataHigh = rm.hi;
        rg.SyncBinding();
        Line($"range bind {rg.Low()} {rg.High()}");
        rg.dataHigh.Set(90);
        rg.SyncBinding();
        Line($"range model->ui {rg.High()}");
        rg.SetRange(80, 40);
        Line($"range writeback {rm.lo} {rm.hi}");

        // ---- 单值模式的 SetValue / 键盘步长 ----------------------------
        Slider sv = new Slider(-12, 12);
        sv.step = 3;
        sv.SetValue(120);
        Line($"single clamp {sv.Value()}");
        Line($"single stepdn {sv.StepDownVal(0)} {sv.StepUpVal(0)}");

        // ---- tooltip 模板（Naive UI format-tooltip）--------------------
        Slider tp = new Slider(0, 100);
        Line($"tip {tp.TipText(50)}");
        tp.tipFormat = "{v}%";
        Line($"tip fmt {tp.TipText(37)}");
        tp.tipFormat = "T={v}C end";
        Line($"tip fmt2 {tp.TipText(5)}");

        // ---- designer marks 往返（GetExtra/SetExtra("marks")）----------
        Slider ds = new Slider(0, 100);
        ds.SetMarksText("100=100°C|20=20°C|37=");
        Line($"spec count {ds.MarkCount()}");
        Line($"spec0 {ds.MarkValueAt(0)} {ds.MarkLabelAt(0)}");
        Line($"spec text {ds.MarksText()}");
        Line($"spec get [{ds.GetExtra("marks")}]");
        Line($"spec unknown [{ds.GetExtra("nope")}]");
        bool setOk = ds.SetExtra("marks", "5=a|6=b");
        Line($"spec set {setOk} {ds.MarkCount()} {ds.GetExtra("marks")}");
    }
}

class RangeModel {
    int lo;
    int hi;
}
