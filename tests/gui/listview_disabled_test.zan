using System;
using Gui;
using Gui.Widget;

// ListView 禁用行（不可选选项）的门控回归：WithSelectable 声明的
// 门和模板行控件自带的 Disabled 都必须把行的**全部**选择途径
// 关死——点选、Ctrl+点选、Shift+范围（范围内禁用行跳过）、右键、
// 程序化 SelectIndex、悬停高亮，缺一道就是「看起来禁用其实能选」。
// 模板列表行 1/3 由门禁用、行 4 由行控件 Disabled 禁用（两条
// 禁用来源都验到）；列模式列表再验一遍门对纯文本行的覆盖。
class ListViewDisabledTest {
    static int fails;
    static App app;
    static ListView<string> list;
    static Rect area;
    static int selects;
    static int activates;
    static int contexts;
    static ListView<string> colList;
    static Rect colArea;

    static void EqInt(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got "
            + Convert.ToString(got) + " want " + Convert.ToString(want));
    }

    static void BumpSelect() { selects = selects + 1; }
    static void BumpActivate() { activates = activates + 1; }
    static void BumpContext() { contexts = contexts + 1; }

    // 行模板：行 4 用控件级 Disabled（门之外的第二条禁用来源）。
    static Control RowFor(string r) {
        ListItem it = new ListItem(r);
        if (r == "row 4") { it.Disabled = true; }
        return it;
    }

    static bool Gate(string r) {
        return r != "row 1" && r != "row 3";
    }

    // 注入一个事件并让它独占一帧（真实输入节奏）。
    static void Ev(int kind, int x, int y, int button, int mods) {
        app.window.InjectEvent(kind, x, y, button, 0, mods);
        app.PumpGuarded();
        app.FrameGuarded(ListViewDisabledTest.Body);
        app.PumpGuarded();
        app.FrameGuarded(ListViewDisabledTest.Body);
    }

    // 一次完整左键点击（移动到位、按下、松开）。
    static void Click(int x, int y, int mods) {
        ListViewDisabledTest.Ev(1, x, y, 0, 0);
        ListViewDisabledTest.Ev(2, x, y, 0, mods);
        ListViewDisabledTest.Ev(3, x, y, 0, mods);
    }

    static void Body() {
        list.RenderInside(app, area);
        colList.RenderInside(app, colArea);
    }

    static void Main() {
        fails = 0;
        selects = 0;
        activates = 0;
        contexts = 0;
        app = new App("listview-disabled", 400, 620);
        app.Show();
        app.RequestAnimationFrame(16);
        List<string> data = new List<string>();
        for (int i = 0; i < 5; i = i + 1) {
            data.Add("row " + Convert.ToString(i));
        }
        list = new ListView<string>(ListViewDisabledTest.RowFor);
        list.Class = "flat";
        list.WithMultiSelect();
        list.WithSelectable(ListViewDisabledTest.Gate);
        list.OnSelect(ListViewDisabledTest.BumpSelect);
        list.OnActivate(ListViewDisabledTest.BumpActivate);
        list.OnContext(ListViewDisabledTest.BumpContext);
        list.Bind(data);
        area = new Rect(0, 0, 390, 250);

        List<string> colData = new List<string>();
        colData.Add("alpha");
        colData.Add("off");
        colData.Add("gamma");
        colList = new ListView<string>(
            new ListColumn<string>("", s => s));
        colList.Class = "flat";
        colList.WithSelectable(s => s != "off");
        colList.Bind(colData);
        colArea = new Rect(0, 320, 390, app.theme.heightLarge * 3);

        // 两拍稳定帧：行控件测量就位后按 ContentHeight/5 均分推行高
        // （全部单行 ListItem 等高，行 i 中心 y = area.y + i*rowH + rowH/2）。
        app.PumpGuarded();
        app.FrameGuarded(ListViewDisabledTest.Body);
        app.PumpGuarded();
        app.FrameGuarded(ListViewDisabledTest.Body);
        int rowH = list.ContentHeightForTest(app) / 5;
        int colH = app.theme.heightLarge;
        int cx = 60;

        // ① 悬停：可选行 hover 落位，禁用行（门禁用的行 1）不出现。
        ListViewDisabledTest.Ev(1, cx, area.y + rowH / 2, 0, 0);
        EqInt("hover on live row", list.hover, 0);
        ListViewDisabledTest.Ev(1, cx, area.y + rowH + rowH / 2, 0, 0);
        EqInt("no hover on gated row", list.hover, 0 - 1);

        // ② 点击禁用行（门）：不选中、不触发 Select。
        ListViewDisabledTest.Click(cx, area.y + rowH + rowH / 2, 0);
        EqInt("gated row click keeps sel", list.sel, 0 - 1);
        EqInt("gated row click silent", selects, 0);

        // ③ 点击可选行：正常选中；点击控件级 Disabled 的行 4：
        // 同一道门拦下（禁用来源不同，语义一致）。
        ListViewDisabledTest.Click(cx, area.y + rowH / 2, 0);
        EqInt("live row click selects", list.sel, 0);
        EqInt("live row click fires Select", selects, 1);
        ListViewDisabledTest.Click(cx, area.y + rowH * 4 + rowH / 2, 0);
        EqInt("control-disabled row click keeps sel", list.sel, 0);
        EqInt("control-disabled row click silent", selects, 1);

        // ④ Ctrl+点击：禁用行进不了多选集合，可选行可以。
        ListViewDisabledTest.Click(cx, area.y + rowH + rowH / 2, 1);
        EqInt("ctrl on gated row not marked", list.SelectionCount(), 1);
        ListViewDisabledTest.Click(cx, area.y + rowH * 2 + rowH / 2, 1);
        EqInt("ctrl on live row marks", list.SelectionCount(), 2);

        // ⑤ Shift+范围：清空后聚焦行 0，扩展到行 2——范围内含
        // 门禁用的行 1，须跳过（若误收，SelectedIndices 里会有 1）。
        // （Shift 点在禁用行上会被行门整体短路，走不到范围分支，
        // 所以端点取可选行、禁用行放范围内部来验。）
        list.ClearSelection();
        list.SelectIndex(0);
        EqInt("refocus selects row 0", list.sel, 0);
        ListViewDisabledTest.Click(cx, area.y + rowH * 2 + rowH / 2, 2);
        EqInt("shift range size", list.SelectedIndices().Count, 2);
        EqInt("shift range skips gated interior", list.IsMarked(1) ? 1 : 0, 0);

        // ⑥ 右键：禁用行不选中也不触发 Context；可选行两者都发生。
        ListViewDisabledTest.Ev(1, cx, area.y + rowH + rowH / 2, 0, 0);
        ListViewDisabledTest.Ev(2, cx, area.y + rowH + rowH / 2, 1, 0);
        ListViewDisabledTest.Ev(3, cx, area.y + rowH + rowH / 2, 1, 0);
        EqInt("right-click gated row silent", contexts, 0);
        EqInt("right-click gated row keeps sel", list.sel, 0);
        ListViewDisabledTest.Ev(1, cx, area.y + rowH * 2 + rowH / 2, 0, 0);
        ListViewDisabledTest.Ev(2, cx, area.y + rowH * 2 + rowH / 2, 1, 0);
        ListViewDisabledTest.Ev(3, cx, area.y + rowH * 2 + rowH / 2, 1, 0);
        EqInt("right-click live row fires Context", contexts, 1);
        EqInt("right-click live row selects", list.sel, 2);

        // ⑦ 程序化 SelectIndex 与鼠标同一道门。
        list.SelectIndex(1);
        EqInt("SelectIndex gated row rejected", list.sel, 2);
        list.SelectIndex(3);
        EqInt("SelectIndex gated row rejected (2)", list.sel, 2);
        list.SelectIndex(4);
        EqInt("SelectIndex control-disabled rejected", list.sel, 2);
        list.SelectIndex(0);
        EqInt("SelectIndex live row moves", list.sel, 0);

        // ⑧ 列模式（纯文本行 + 门）：禁用行点不动，可选行正常。
        ListViewDisabledTest.Click(cx, colArea.y + colH / 2, 0);
        EqInt("column live row selects", colList.sel, 0);
        ListViewDisabledTest.Click(cx, colArea.y + colH + colH / 2, 0);
        EqInt("column gated row keeps sel", colList.sel, 0);
        ListViewDisabledTest.Click(cx, colArea.y + colH * 2 + colH / 2, 0);
        EqInt("column live row 2 selects", colList.sel, 2);
        colList.SelectIndex(1);
        EqInt("column SelectIndex gated rejected", colList.sel, 2);

        Console.WriteLine(fails == 0 ? "LISTVIEWDIS PASS"
            : "LISTVIEWDIS FAIL " + Convert.ToString(fails));
    }
}
