using System;
using Gui;
using Gui.Widget;

namespace DataTableQuerySourceTest;

class DeferredSource : QueryDataSource {
    int fetchCount;

    DeferredSource() {
        this.Setup();
        this.fetchCount = 0;
    }

    override void FetchQuery(QueryDescriptor query,
                              QueryViewport viewport,
                              QueryRequestToken token) {
        this.fetchCount = this.fetchCount + 1;
    }

    int FetchCount() { return this.fetchCount; }
}

class Program {
    static DataRow Cells(string value) {
        DataRow row = new DataRow();
        row.Push(value);
        return row;
    }

    static QueryResult Result(QueryRequestToken token, int at, string value) {
        List<QueryRow> rows = new List<QueryRow>();
        rows.Add(new QueryRow(RowKey.Of("k" + value), 1, Program.Cells(value)));
        return new QueryResult(token.RequestId(), token.Generation(),
            token.QueryText(), token.QueryHash(), token.SchemaVersion(), token.ServerRevision(),
            at, 10, "", rows, 100, true, false, "", "");
    }

    static void Main() {
        DataTableState st = new DataTableState();
        QueryDescriptor query = QueryDescriptor.Of(st, "orders", QueryCapabilities.Page);
        QueryViewport viewport = new QueryViewport(20, 10, "");
        DeferredSource source = new DeferredSource();

        QueryRequestToken first = source.RequestQuery(query, viewport, null);
        QueryRequestToken second = source.RequestQuery(query, viewport, null);
        source.FinishQuery(Program.Result(first, 20, "stale"), first);
        Console.WriteLine("stalePoll=" + source.Poll());
        Console.WriteLine("staleRows=" + Convert.ToString(source.RowCount()));

        source.FinishQuery(Program.Result(second, 20, "current"), second);
        Console.WriteLine("currentPoll=" + source.Poll());
        Console.WriteLine("currentReady=" + source.CellReady(20, 0));
        Console.WriteLine("currentText=" + source.CellText(20, 0));
        if (second == null) { return; }
        QueryRequestToken cached = source.RequestQuery(query, viewport, null);
        Console.WriteLine("cachePoll=" + source.Poll());
        Console.WriteLine("cacheFetches=" + Convert.ToString(source.FetchCount()));
        QueryViewport viewport2 = new QueryViewport(30, 10, "");
        QueryRequestToken page2 = source.RequestQuery(query, viewport2, null);
        source.FinishQuery(Program.Result(page2, 30, "page2"), page2);
        Console.WriteLine("page2Poll=" + source.Poll());
        Console.WriteLine("page2Text=" + source.CellText(30, 0));
        Console.WriteLine("crossPageReady=" + source.CellReady(20, 0));
        Console.WriteLine("crossPageText=" + source.CellText(20, 0));
        QueryRequestToken cachedPage2 = source.RequestQuery(query, viewport2, null);
        Console.WriteLine("page2CachePoll=" + source.Poll());
        Console.WriteLine("page2CacheFetches=" + Convert.ToString(source.FetchCount()));
        DataTable.InvalidateView(st);
        QueryDescriptor viewQuery = QueryDescriptor.Of(st, "orders", QueryCapabilities.Page);
        QueryRequestToken viewHit = source.RequestQuery(viewQuery, viewport, null);
        Console.WriteLine("viewReusePoll=" + source.Poll());
        Console.WriteLine("viewReuseFetches=" + Convert.ToString(source.FetchCount()));
        DataTable.InvalidateQuery(st);
        QueryDescriptor changedQuery = QueryDescriptor.Of(st, "orders", QueryCapabilities.Page);
        QueryRequestToken changed = source.RequestQuery(changedQuery, viewport, null);
        Console.WriteLine("queryMissFetches=" + Convert.ToString(source.FetchCount()));
        source.SetSchema(null, 2);
        QueryRequestToken schemaChanged = source.RequestQuery(changedQuery, viewport, null);
        Console.WriteLine("schemaMissFetches=" + Convert.ToString(source.FetchCount()));
        source.SetServerRevision(1);
        QueryRequestToken serverChanged = source.RequestQuery(changedQuery, viewport, null);
        Console.WriteLine("serverMissFetches=" + Convert.ToString(source.FetchCount()));
        source.FinishQuery(Program.Result(second, 20, "duplicate"), second);
        Console.WriteLine("duplicatePoll=" + source.Poll());
        QueryRequestToken rejected = source.RequestQuery(query, viewport, first);
        Console.WriteLine("cancelledRejected=" + (rejected == null));

        QueryResult empty = QueryResult.Empty(second, viewport);
        Console.WriteLine("emptyViewport=" + (empty == null
            || !empty.MatchesViewport(viewport)));

        DataPageKey key1 = DataPageKey.Of(query, viewport, second);
        DataPageCache cache = new DataPageCache(10);
        Console.WriteLine("put1=" + cache.Put(key1, Program.Result(second, 20, "one"), 6));
        Console.WriteLine("bytes1=" + Convert.ToString(cache.Bytes()));
        QueryRequestToken other = new QueryRequestToken(9, second.Generation(),
            second.QueryText(), second.QueryHash(), second.SchemaVersion(), second.ServerRevision());
        QueryViewport viewport3 = new QueryViewport(30, 10, "");
        DataPageKey key2 = DataPageKey.Of(query, viewport3, other);
        Console.WriteLine("put2=" + cache.Put(key2, Program.Result(other, 30, "two"), 6));
        Console.WriteLine("count=" + Convert.ToString(cache.Count()));
        Console.WriteLine("evicted1=" + (cache.Get(key1) == null));
        Console.WriteLine("hit2=" + (cache.Get(key2) != null));
        cache.SetPinned(key2, true);
        QueryRequestToken third = new QueryRequestToken(10, second.Generation(),
            second.QueryText(), second.QueryHash(), second.SchemaVersion(), second.ServerRevision());
        QueryViewport viewport4 = new QueryViewport(40, 10, "");
        DataPageKey key3 = DataPageKey.Of(query, viewport4, third);
        Console.WriteLine("pinnedReject=" + (!cache.Put(key3, Program.Result(third, 40, "three"), 6)));
        Console.WriteLine("pinnedKeep=" + (cache.Get(key2) != null));
        Console.WriteLine("pinnedBytes=" + Convert.ToString(cache.Bytes()));
    }
}
