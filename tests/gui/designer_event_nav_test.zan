using System;
using Gui;
using Gui.Widget;
using Gui.Designer;

class DesignerEventNavTest {
    static int fails;

    static void Fail(string msg) {
        Console.WriteLine("FAIL: " + msg);
        fails = fails + 1;
    }

    static void AssertTrue(bool condition, string desc) {
        if (!condition) {
            Fail(desc + " condition is false");
        }
    }

    static void AssertEq(string actual, string expected, string desc) {
        if (actual != expected) {
            Fail(desc + " expected '" + expected + "', got '" + actual + "'");
        }
    }

    static void AssertEqInt(int actual, int expected, string desc) {
        if (actual != expected) {
            Fail(desc + " expected " + Convert.ToString(expected) + ", got " + Convert.ToString(actual));
        }
    }

    static void Main() {
        TestDefaultEventName();
        TestSuggestHandler();
        TestOpenCodeBehindHandlerContract();
        TestEventBindingFlow();

        if (fails == 0) {
            Console.WriteLine("DESIGNER_EVENT_NAV_TEST_OK");
        } else {
            Console.WriteLine("DESIGNER_EVENT_NAV_TEST_FAIL (fails=" + Convert.ToString(fails) + ")");
        }
    }

    static void TestDefaultEventName() {
        FormField btn = FormField.New(49, 1);
        btn.kind = "Button";
        AssertEq(Designer.DefaultEventName(btn), "Click", "Button default event is Click");

        FormField inp = FormField.New(0, 2);
        AssertEq(Designer.DefaultEventName(inp), "Change", "Input default event is Change");

        FormField tbl = FormField.New(41, 3);
        AssertEq(Designer.DefaultEventName(tbl), "RowClick", "DataGrid default event is RowClick");

        FormField tree = FormField.New(25, 4);
        AssertEq(Designer.DefaultEventName(tree), "Select", "Tree default event is Select");

        FormField tabs = FormField.New(36, 5);
        AssertEq(Designer.DefaultEventName(tabs), "TabChanged", "Tabs default event is TabChanged");
    }

    static void TestSuggestHandler() {
        FormField btn = FormField.New(49, 1);
        btn.fname = "SubmitBtn";
        AssertEq(Designer.SuggestHandler(btn, "Click"), "OnSubmitBtnClick", "Suggests OnSubmitBtnClick");

        FormField nameInp = FormField.New(0, 2);
        nameInp.fname = "UserName";
        AssertEq(Designer.SuggestHandler(nameInp, "Change"), "OnUserNameChange", "Suggests OnUserNameChange");
    }

    static void TestOpenCodeBehindHandlerContract() {
        Designer d = new Designer();
        d.RequestOpenCodeBehindHandler("OnSubmitBtnClick");
        string req = d.ConsumeOpenCodeBehind();
        AssertEq(req, "handler:OnSubmitBtnClick", "Consumes handler navigation target");

        string empty = d.ConsumeOpenCodeBehind();
        AssertEq(empty, "", "Second consume is empty");
    }

    static void TestEventBindingFlow() {
        FormField btn = FormField.New(49, 1);
        btn.fname = "OkBtn";
        AssertEq(btn.GetHandler("Click"), "", "Initially no handler");

        // 模拟点击新建/定位时自动补齐
        string sug = Designer.SuggestHandler(btn, "Click");
        btn.SetHandler("Click", sug);
        AssertEq(btn.GetHandler("Click"), "OnOkBtnClick", "Handler is bound");

        Designer d = new Designer();
        d.RequestOpenCodeBehindHandler(btn.GetHandler("Click"));
        AssertEq(d.ConsumeOpenCodeBehind(), "handler:OnOkBtnClick", "Dispatches navigation request");
    }
}
