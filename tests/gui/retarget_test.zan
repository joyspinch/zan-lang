using System;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Designer;

/// 无窗口回归：把设计文档改到新画布尺寸时必须只动几何。
///
/// New Project 向导对 sizeable 模板会按选中的设备尺寸重排设计
/// (ZanIDE.RetargetForms)。它以前把 .zform 反序列化到一个只有几何的
/// 模型再序列化回去，于是 kind / placeholder / 绑定 / 事件 / options /
/// 容器 kids 全部丢失——每个控件都退化成默认 Input，脚手架出来的项目
/// 里 `TitleLabel.Text = "Hello!"` 直接编译不过（Input 没有 Text）。
/// 这里钉住：改画布只改 winW/winH 和绝对矩形，其余键原样保留。
class Program {
    static void Line(string s) { Console.WriteLine(s); }

    static string Doc() {
        return "{\"name\":\"App\",\"winW\":480,\"winH\":520,\"labelPos\":0,"
            + "\"fields\":["
            + "{\"kind\":\"Label\",\"label\":\"Welcome\",\"name\":\"TitleLabel\","
            + "\"onClick\":\"OnTitle\",\"options\":[\"a\",\"b\"],"
            + "\"fx\":12,\"fy\":44,\"fw\":1200,\"fh\":34},"
            + "{\"kind\":\"FloatButton\",\"label\":\"OK\",\"name\":\"OkButton\","
            + "\"bind\":\"model.ok\",\"fx\":12,\"fy\":900,\"fw\":100,\"fh\":34},"
            + "{\"kind\":\"Panel\",\"name\":\"Box\",\"fx\":12,\"fy\":200,"
            + "\"fw\":200,\"fh\":80,\"kids\":["
            + "{\"kind\":\"Checkbox\",\"name\":\"Remember\",\"fx\":4,\"fy\":4,"
            + "\"fw\":900,\"fh\":20}]},"
            + "{\"kind\":\"SelectBox\",\"name\":\"Flow\",\"label\":\"Role\"}"
            + "]}";
    }

    static void Dump(JsonValue f, string path) {
        Line(path + " kind=" + f.Str("kind", "<none>")
            + " rect=" + Convert.ToString(f.Int("fx", -1))
            + "," + Convert.ToString(f.Int("fy", -1))
            + "," + Convert.ToString(f.Int("fw", -1))
            + "," + Convert.ToString(f.Int("fh", -1))
            + " hasFx=" + Convert.ToString(f.Has("fx")));
    }

    static void Main() {
        JsonValue d = JsonValue.Parse(Program.Doc());

        // 画布已经是目标尺寸时不改文档。
        Line("noop=" + Convert.ToString(Designer.RetargetDoc(d, 480, 520)));

        Line("changed=" + Convert.ToString(Designer.RetargetDoc(d, 1024, 600)));
        Line("canvas=" + Convert.ToString(d.Int("winW", 0))
            + "x" + Convert.ToString(d.Int("winH", 0)));
        // 未被认领的顶层键必须原样留下。
        Line("labelPos=" + Convert.ToString(d.Int("labelPos", -1))
            + " name=" + d.Str("name", ""));

        JsonValue fs = d.Get("fields");
        if (fs == null) { Line("fields=<lost>"); return; }
        Line("fields=" + Convert.ToString(fs.Count()));

        JsonValue title = fs.At(0);
        Program.Dump(title, "title");
        // 非几何的每字段状态必须存活。
        JsonValue opts = title.Get("options");
        Line("title.onClick=" + title.Str("onClick", "<lost>")
            + " opts=" + Convert.ToString(opts == null ? -1 : opts.Count()));

        JsonValue ok = fs.At(1);
        Program.Dump(ok, "ok");
        Line("ok.bind=" + ok.Str("bind", "<lost>"));

        JsonValue box = fs.At(2);
        Program.Dump(box, "box");
        JsonValue kids = box.Get("kids");
        if (kids == null) { Line("box.kids=<lost>"); return; }
        Program.Dump(kids.At(0), "box.kid");

        // 流式布局字段没有矩形，重排不得给它造一个。
        Program.Dump(fs.At(3), "flow");
    }
}
