using System;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Designer;

// 无窗口回归：把设计文档改到新画布尺寸时必须只动几何。
// // New Project 向导对 sizeable 模板会按选中的设备尺寸重排设计
// (ZanIDE.RetargetForms)。它以前把设计文档反序列化到一个只有几何的
// 模型再序列化回去，于是 kind / placeholder / 绑定 / 事件 / options /
// 容器 kids 全部丢失——每个控件都退化成默认 Input，脚手架出来的项目
// 里 `TitleLabel.Text = "Hello!"` 直接编译不过（Input 没有 Text）。
// 这里钉住：改画布只改 winW/winH 和绝对矩形，其余键原样保留。
class Program {
    static void Line(string s) { Console.WriteLine(s); }

    static string Doc() {
        return "{\n"
            + "  \"name\": \"App\",\n"
            + "  \"winW\": 480,\n"
            + "  \"winH\": 520,\n"
            + "  \"labelPos\": 0,\n"
            + "  \"fields\": [\n"
            + "    {\n"
            + "      \"kind\": \"Label\",\n"
            + "      \"label\": \"Welcome\",\n"
            + "      \"name\": \"TitleLabel\",\n"
            + "      \"onClick\": \"OnTitle\",\n"
            + "      \"options\": [\n"
            + "        \"a\",\n"
            + "        \"b\"\n"
            + "      ],\n"
            + "      \"style\": \"position:absolute;left:12px;top:44px;width:1200px;height:34px\"\n"
            + "    },\n"
            + "    {\n"
            + "      \"kind\": \"FloatButton\",\n"
            + "      \"label\": \"OK\",\n"
            + "      \"name\": \"OkButton\",\n"
            + "      \"bindings\": [\n"
            + "        {\n"
            + "          \"path\": \"model.ok\",\n"
            + "          \"property\": \"\",\n"
            + "          \"twoWay\": true\n"
            + "        }\n"
            + "      ],\n"
            + "      \"style\": \"position:absolute;left:12px;top:900px;width:100px;height:34px\"\n"
            + "    },\n"
            + "    {\n"
            + "      \"kind\": \"Panel\",\n"
            + "      \"name\": \"Box\",\n"
            + "      \"kids\": [\n"
            + "        {\n"
            + "          \"kind\": \"Checkbox\",\n"
            + "          \"name\": \"Remember\",\n"
            + "          \"style\": \"position:absolute;left:4px;top:4px;width:900px;height:20px\"\n"
            + "        }\n"
            + "      ],\n"
            + "      \"style\": \"position:absolute;left:12px;top:200px;width:200px;height:80px\"\n"
            + "    },\n"
            + "    {\n"
            + "      \"kind\": \"SelectBox\",\n"
            + "      \"name\": \"Flow\",\n"
            + "      \"label\": \"Role\"\n"
            + "    }\n"
            + "  ]\n"
            + "}";
    }

    static void Dump(JsonValue f, string path) {
        StyleBox box = new StyleBox();
        StyleSheet sheet = Css.Parse(".field {" + f.Str("style", "") + "}");
        sheet.ApplyBox(box, ".field");
        Line(path + " kind=" + f.Str("kind", "<none>")
            + " rect=" + Convert.ToString(box.posL == StyleBox.Unset() ? -1 : box.posL)
            + "," + Convert.ToString(box.posT == StyleBox.Unset() ? -1 : box.posT)
            + "," + Convert.ToString(box.width)
            + "," + Convert.ToString(box.height)
            + " positioned=" + Convert.ToString(box.position == 2));
    }

    static void Main() {
        JsonValue d = JsonValue.Parse(Program.Doc());

        // 画布已经是目标尺寸时不改文档。
        Line("noop=" + Convert.ToString(Designer.RetargetDoc(d, 480, 520)));

        Line("changed=" + Convert.ToString(Designer.RetargetDoc(d, 1024, 600)));
        Line("canvas=" + Convert.ToString(d.Int("winW", 0))
            + "x" + Convert.ToString(d.Int("winH", 0)));
        // 未被认领的顶层键必须原样留下。
        Line("labelPos=" + Convert.ToString(d.Int("labelPos", -1))
            + " name=" + d.Str("name", ""));

        JsonValue fs = d.Get("fields");
        if (fs == null) { Line("fields=<lost>"); return; }
        Line("fields=" + Convert.ToString(fs.Count()));

        JsonValue title = fs.At(0);
        Program.Dump(title, "title");
        // 非几何的每字段状态必须存活。
        JsonValue opts = title.Get("options");
        Line("title.onClick=" + title.Str("onClick", "<lost>")
            + " opts=" + Convert.ToString(opts == null ? -1 : opts.Count()));

        JsonValue ok = fs.At(1);
        Program.Dump(ok, "ok");
        JsonValue bindings = ok.Get("bindings");
        if (bindings == null || bindings.Count() != 1) { Line("ok.bindings=<lost>"); return; }
        JsonValue binding = bindings.At(0);
        if (binding == null) { Line("ok.bindings=<lost>"); return; }
        Line("ok.bindings=1:" + binding.Str("path", "<lost>")
            + ":" + binding.Str("property", "<lost>")
            + ":" + Convert.ToString(binding.Bool("twoWay", false)));

        JsonValue box = fs.At(2);
        Program.Dump(box, "box");
        JsonValue kids = box.Get("kids");
        if (kids == null) { Line("box.kids=<lost>"); return; }
        Program.Dump(kids.At(0), "box.kid");

        // 流式布局字段没有矩形，重排不得给它造一个。
        Program.Dump(fs.At(3), "flow");
    }
}
