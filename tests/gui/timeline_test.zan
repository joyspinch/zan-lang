using System;
using Gui;
using Gui.Widget;

/// 无窗口回归：Timeline 强化的纯计算面，对着 golden 比。
/// - TimelineItem 构造重载：3/4/5 参的字段落位、pending 默认
/// - SizeClass 映射（tiny/small→small、large→large、medium/脏→""）
/// - Class 形态判定：horizontal / right（含混入多类时的 token 匹配）
/// - ItemsText/SetItemsText 往返（`;` 分段：时间里的冒号不再是
///   分隔符；pending 尾段；缺尾字段回空串）
/// - Of/AddItem/AddItemIcon 行为
/// - Props 键序（size/class）、GetProp/SetProp size 白名单
class Program {
    static void Line(string s) { Console.WriteLine(s); }
    static int fails = 0;

    static void Eq(string label, string got, string want) {
        if (got == want) { Line("ok " + label + " = " + got); }
        else { fails = fails + 1; Line("FAIL " + label + " got [" + got + "] want [" + want + "]"); }
    }

    static void EqB(string label, bool got, bool want) {
        if (got == want) { Line("ok " + label + " = " + Convert.ToString(got)); }
        else { fails = fails + 1; Line("FAIL " + label + " got " + Convert.ToString(got) + " want " + Convert.ToString(want)); }
    }

    static void Main() {
        // ---- TimelineItem 构造 ------------------------------------
        TimelineItem a = new TimelineItem("t", "ti", "d");
        Eq("ctor3 cls", a.cls, "");
        Eq("ctor3 icon", a.icon, "");
        EqB("ctor3 pending", a.pending, false);
        TimelineItem b = new TimelineItem("t", "ti", "d", "success");
        Eq("ctor4 cls", b.cls, "success");
        Eq("ctor4 icon", b.icon, "");
        TimelineItem c = new TimelineItem("t", "ti", "d", "error", "eye");
        Eq("ctor5 icon", c.icon, "eye");
        c.pending = true;
        EqB("ctor5 pending", c.pending, true);

        // ---- SizeClass 映射（Control 静态） ------------------------
        Eq("size small", Control.SizeClass("small"), "small");
        Eq("size tiny", Control.SizeClass("tiny"), "small");
        Eq("size medium", Control.SizeClass("medium"), "");
        Eq("size large", Control.SizeClass("large"), "large");
        Eq("size dirty", Control.SizeClass("huge"), "");

        // ---- 形态判定 ---------------------------------------------
        Timeline tl = new Timeline();
        EqB("plain h", tl.IsHorizontal(), false);
        EqB("plain r", tl.IsRight(), false);
        tl.Class = "horizontal";
        EqB("h on", tl.IsHorizontal(), true);
        EqB("h not right", tl.IsRight(), false);
        tl.Class = "primary right";
        EqB("right in multi", tl.IsRight(), true);
        EqB("multi not h", tl.IsHorizontal(), false);
        // token 匹配而非子串：`upright` 不算 right
        tl.Class = "upright";
        EqB("substring not class", tl.IsRight(), false);

        // ---- items 文本往返 ----------------------------------------
        Timeline rt = new Timeline();
        bool ok = rt.SetExtra("items",
            "09:00;Created;desc;success;eye|12:30;Deploy;;;;pending||x;y");
        EqB("setextra ok", ok, true);
        Eq("roundtrip", rt.GetExtra("items"),
           "09:00;Created;desc;success;eye|12:30;Deploy;;;;pending|x;y;;;");
        // 时间段的冒号原样保留：解析后首条的 time 字段仍是 `09:00`
        Eq("colon in time", rt.items[0].time, "09:00");
        EqB("second pending", rt.items[1].pending, true);
        Eq("second icon empty", rt.items[1].icon, "");
        // 空串清列表
        rt.SetExtra("items", "");
        Eq("clear", rt.GetExtra("items"), "");
        Eq("unknown extra", rt.GetExtra("nope"), "");
        EqB("unknown setextra", rt.SetExtra("nope", "x"), false);

        // ---- 构造入口 ----------------------------------------------
        Timeline of = Timeline.Of(new List<TimelineItem>{ b, c });
        Eq("of items", of.GetExtra("items"),
           "t;ti;d;success;|t;ti;d;error;eye;pending");
        Timeline add = new Timeline();
        add.AddItem("09:00", "Created", "desc");
        add.AddItemIcon("10:00", "Shipped", "", "info", "truck");
        Eq("additem", add.GetExtra("items"),
           "09:00;Created;desc;;|10:00;Shipped;;info;truck");

        // ---- 设计器模型 --------------------------------------------
        Eq("kind", of.Kind(), "Timeline");
        List<PropSpec> ps = of.Props();
        Eq("props count", Convert.ToString(ps.Count), "2");
        Eq("props 0", ps[0].key, "size");
        Eq("props 1", ps[1].key, "class");
        // Size 字段驱动 SizeCls（medium 默认不落片段）
        Timeline sz = new Timeline();
        Eq("size default cls", sz.SizeCls(), "");
        sz.Size = "large";
        Eq("size large cls", sz.SizeCls(), "large");

        if (fails > 0) { Line("FAILURES " + Convert.ToString(fails)); }
        else { Line("timeline_test OK"); }
    }
}
