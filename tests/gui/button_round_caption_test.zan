// 圆形/大圆角按钮的文字回归：Button 的"圆角安全内边距"按 3/4 半径两侧各让一块，
// 定宽圆形按钮（border-radius = 半边长）内容区只剩 1/4 宽，单字图标与两位数字
// 被裁成空白（pin-circle 的 ♪/▷、match3 的圆形关卡节点）。安全留白必须让位给
// 内容：标签拿到的宽度不得小于它的首选宽度，且文字确实画出来。
// golden: ROUND_INLINE_OK / ROUND_CSS_OK / PILL_OK
using System;
using Gui;
using Gui.Widget;

class ButtonRoundCaptionTest {
    static string Run(string tag, int w, int h, int radius, bool inline) {
        App app = App.CreateOffscreen("round caption", 200, 120);
        try {
            string css = "button.node{position:absolute;padding:0;margin:0;justify-content:center;"
                + "align-items:center;font-size:24px;color:#102030;background:#ffd666;border:2px solid #806020}";
            if (!inline) { css = css + "button.node{border-radius:" + Convert.ToString(radius) + "px}"; }
            app.UseAppCss(css);
            Panel root = new Panel("root");
            Button b = new Button("88");
            b.Class = "node";
            if (inline) {
                b.SetProp("style", "left:10px;top:10px;width:" + Convert.ToString(w) + "px;height:"
                    + Convert.ToString(h) + "px;border-radius:" + Convert.ToString(radius) + "px");
            }
            root.Add(b);
            root.UseApp(app);
            root.MeasureTree(app);
            root.Arrange(0, 0, 200, 120);
            b.Arrange(10, 10, w, h);
            app.canvas.Clear(0xffffffff);
            root.RenderTree(app);
            Control cap = null;
            for (int i = 0; i < b.ChildCount(); i = i + 1) {
                if (b.ChildAt(i) is Label) { cap = b.ChildAt(i); }
            }
            if (cap == null) { return tag + "_NO_CAPTION"; }
            if (cap.bw < cap.prefW) {
                return tag + "_SQUEEZED w=" + Convert.ToString(cap.bw) + " pref=" + Convert.ToString(cap.prefW);
            }
            int dark = 0;
            for (int y = 10 + 4; y < 10 + h - 4; y = y + 1) {
                for (int x = 10 + 4; x < 10 + w - 4; x = x + 1) {
                    int p = app.canvas.GetPixel(x, y);
                    if (((p >> 8) & 255) < 100) { dark = dark + 1; }
                }
            }
            if (dark < 30) { return tag + "_BLANK dark=" + Convert.ToString(dark); }
            return tag + "_OK";
        } finally { app.canvas.Destroy(); }
    }

    static void Main() {
        Canvas.SetBackend(RenderBackend.Cpu());
        Console.WriteLine(Run("ROUND_INLINE", 48, 48, 24, true));
        Console.WriteLine(Run("ROUND_CSS", 48, 48, 24, false));
        Console.WriteLine(Run("PILL", 120, 40, 20, true));
    }
}
