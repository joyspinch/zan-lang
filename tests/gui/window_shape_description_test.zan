using System;
using System.Collections.Generic;
using Gui;

class WindowShapeDescriptionTest {
    static void Assert(bool cond, string msg) {
        if (!cond) {
            Console.WriteLine("FAIL: " + msg);
            throw new Exception("Assertion failed: " + msg);
        }
    }

    static void Main() {
        Console.WriteLine("window_shape_description_test:start");

        // 1. 验证 WindowShapeKind 枚举常量定义
        Assert(WindowShapeKind.Default == 0, "WindowShapeKind.Default == 0");
        Assert(WindowShapeKind.RoundedRect == 1, "WindowShapeKind.RoundedRect == 1");
        Assert(WindowShapeKind.Ellipse == 2, "WindowShapeKind.Ellipse == 2");
        Assert(WindowShapeKind.ShadowBand == 3, "WindowShapeKind.ShadowBand == 3");

        // 2. 验证 WindowShapeRegion 原生结构、克隆、平移与规范串导出
        WindowShapeRegion r1 = new WindowShapeRegion(WindowShapeKind.RoundedRect, 10, 20, 300, 200, 16);
        Assert(r1.IsRoundedRect(), "r1.IsRoundedRect()");
        Assert(!r1.IsEllipse(), "!r1.IsEllipse()");
        Assert(!r1.IsShadowBand(), "!r1.IsShadowBand()");
        Assert(r1.ToSpecPart() == "1,10,20,300,200,16", "r1.ToSpecPart()");

        WindowShapeRegion r1Clone = r1.Clone();
        Assert(r1Clone.kind == r1.kind && r1Clone.x == r1.x && r1Clone.width == r1.width, "r1Clone values match");

        WindowShapeRegion r1Shift = r1.Translate(5, -10);
        Assert(r1Shift.x == 15 && r1Shift.y == 10 && r1Shift.width == 300 && r1Shift.radius == 16, "r1Shift values match");

        WindowShapeRegion rEllipse = new WindowShapeRegion(WindowShapeKind.Ellipse, 0, 0, 100, 50, 0);
        Assert(rEllipse.IsEllipse(), "rEllipse.IsEllipse()");

        WindowShapeRegion rBand = new WindowShapeRegion(WindowShapeKind.ShadowBand, 0, 0, 320, 220, 10);
        Assert(rBand.IsShadowBand(), "rBand.IsShadowBand()");

        // 3. 验证 WindowShapeDescription 强类型工厂与几何计算
        WindowShapeDescription emptyDesc = WindowShapeDescription.Empty();
        Assert(emptyDesc.IsEmpty(), "emptyDesc.IsEmpty()");
        Assert(emptyDesc.ToSpec() == "", "emptyDesc.ToSpec() == ''");

        WindowShapeDescription roundDesc = WindowShapeDescription.FromRoundedRect(800, 600, 16);
        Assert(!roundDesc.IsEmpty(), "!roundDesc.IsEmpty()");
        Assert(roundDesc.regions.Count == 1, "roundDesc.regions.Count == 1");
        Assert(roundDesc.GetEffectiveRadius() == 16, "roundDesc.GetEffectiveRadius() == 16");
        Assert(roundDesc.ToSpec() == "1,0,0,800,600,16", "roundDesc.ToSpec()");

        WindowShapeDescription ellipseDesc = WindowShapeDescription.FromEllipse(400, 300);
        Assert(ellipseDesc.regions.Count == 1, "ellipseDesc.regions.Count == 1");
        Assert(ellipseDesc.regions[0].kind == WindowShapeKind.Ellipse, "ellipseDesc region is Ellipse");
        Assert(ellipseDesc.ToSpec() == "2,0,0,400,300,0", "ellipseDesc.ToSpec()");

        // 4. 验证 ParseSpec 兼容解析多区域复合异形
        string multiSpec = "1,0,0,500,400,12;2,100,50,200,150,0";
        WindowShapeDescription parsedMulti = WindowShapeDescription.ParseSpec(multiSpec);
        Assert(parsedMulti.regions.Count == 2, "parsedMulti.regions.Count == 2");
        Assert(parsedMulti.regions[0].kind == WindowShapeKind.RoundedRect && parsedMulti.regions[0].radius == 12, "parsedMulti region 0");
        Assert(parsedMulti.regions[1].kind == WindowShapeKind.Ellipse, "parsedMulti region 1");
        Assert(parsedMulti.ToSpec() == multiSpec, "parsedMulti.ToSpec() roundtrip");

        // 5. 验证 WithShadow 自动计算包围盒与平移对齐
        WindowShapeDescription shadowed = roundDesc.WithShadow(10);
        Assert(shadowed.HasShadowBand(), "shadowed.HasShadowBand()");
        Assert(shadowed.shadow == 10, "shadowed.shadow == 10");
        Assert(shadowed.offsetX == 10, "shadowed.offsetX == 10");
        Assert(shadowed.offsetY == 10, "shadowed.offsetY == 10");
        Assert(shadowed.regions.Count == 2, "shadowed.regions.Count == 2");
        Assert(shadowed.regions[0].kind == WindowShapeKind.ShadowBand, "shadowed.regions[0] is ShadowBand");
        Assert(shadowed.regions[0].width == 820 && shadowed.regions[0].height == 620, "shadowed.regions[0] size");
        Assert(shadowed.regions[1].x == 10 && shadowed.regions[1].y == 10, "shadowed.regions[1] translated");
        Assert(shadowed.GetEffectiveRadius() == 16, "shadowed.GetEffectiveRadius() ignores shadow band");

        // 6. 验证 App 离屏集成与状态完全一致性
        App app = App.CreateOffscreen("WindowShapeDescriptionTest", 800, 600);

        // 使用强类型协议设置
        app.SetWindowShape(roundDesc);
        Assert(app.shapeMode == 1, "app.shapeMode == 1");
        Assert(app.shapeRadius == 16, "app.shapeRadius == 16");
        Assert(app.shapeSpec == "1,0,0,800,600,16", "app.shapeSpec == 1,0,0,800,600,16");
        Assert(app.shapeRegions.Count == 1, "app.shapeRegions.Count == 1");

        // 设置阴影
        app.SetWindowShadow(12);
        Assert(app.shapeShadow == 12, "app.shapeShadow == 12");
        Assert(app.shapeOffX == 12, "app.shapeOffX == 12");
        Assert(app.shapeOffY == 12, "app.shapeOffY == 12");
        Assert(app.HasShadowBand(), "app.HasShadowBand()");
        Assert(app.shapeRegions.Count == 2, "app.shapeRegions.Count == 2 (band + content)");

        // 还原形状
        app.SetWindowShape("");
        Assert(app.shapeMode == 0, "app.shapeMode == 0 after reset");
        Assert(app.shapeRadius == 0, "app.shapeRadius == 0 after reset");
        Assert(app.shapeShadow == 0, "app.shapeShadow == 0 after reset");
        Assert(app.shapeOffX == 0, "app.shapeOffX == 0 after reset");
        Assert(app.shapeOffY == 0, "app.shapeOffY == 0 after reset");
        Assert(app.shapeRegions.Count == 0, "app.shapeRegions.Count == 0 after reset");

        Console.WriteLine("window_shape_description_test:pass");
    }
}
