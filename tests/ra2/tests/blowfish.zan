// Blowfish ECB against published test vectors (Eric Young's vector set).
// Clean-room: keys and plaintexts are constants, no game data is embedded.
using System;
using Ra2.Formats;

namespace T;

class Program {

    // Lowercase hex digit -> value. Vectors below use only [0-9a-f].
    static int HexVal(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        return (c - 97) + 10;
    }

    static int ByteFromHex(string hex, int byteIndex) {
        return (Program.HexVal(hex[byteIndex * 2] & 0xFF) << 4)
             | Program.HexVal(hex[byteIndex * 2 + 1] & 0xFF);
    }

    // Substring is the way to turn an indexed byte back into a string: `str +
    // buf[i]` would append the numeric value, not the character.
    static string Hex(string buf, int len) {
        string digits = "0123456789abcdef";
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < len; i = i + 1) {
            int b = buf[i] & 0xFF;
            sb.Append(digits.Substring((b >> 4) & 0x0F, 1));
            sb.Append(digits.Substring(b & 0x0F, 1));
        }
        return sb.ToString();
    }

    static void Check(string keyHex, string plainHex, int n) {
        byte[] key = new byte[9];
        byte[] blk = new byte[9];
        for (int i = 0; i < 8; i = i + 1) {
            key[i] = (byte)Program.ByteFromHex(keyHex, i);
            blk[i] = (byte)Program.ByteFromHex(plainHex, i);
        }
        Blowfish bf = Blowfish.Create(key, 8);
        bf.EncryptBlock(blk, 0);
        Console.WriteLine("enc" + Convert.ToString(n) + "=" + Program.Hex(blk, 8));
        bf.DecryptBlock(blk, 0);
        Console.WriteLine("dec" + Convert.ToString(n) + "=" + Program.Hex(blk, 8));
    }

    static void Main() {
        Program.Check("0000000000000000", "0000000000000000", 1);
        Program.Check("ffffffffffffffff", "ffffffffffffffff", 2);
        Program.Check("3000000000000000", "1000000000000001", 3);
    }
}
