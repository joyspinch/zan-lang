// PCX decoding -- the format RA2's shell art (menu backdrops, side screens)
// is stored in.
//
// Clean-room: every image below is assembled here from scratch. No game data.
using System;
using System.Collections.Generic;
using Ra2.Formats;

namespace T;

class Program {

    static void PutU16(string b, int at, int v) {
        b[at] = (byte)(v & 0xFF);
        b[at + 1] = (byte)((v >> 8) & 0xFF);
    }

    // A minimal 8-bit RLE PCX. `body` is the already-encoded scanline data.
    static string Build(int w, int h, int bytesPerLine, string body, int bodyLen,
                        bool withPalette, List<int> outLen) {
        int tail = 0;
        if (withPalette) { tail = 769; }
        int total = 128 + bodyLen + tail;
        byte[] b = new byte[total + 1];
        b[0] = (byte)10;      // manufacturer
        b[1] = (byte)5;       // version
        b[2] = (byte)1;       // RLE
        b[3] = (byte)8;       // bits per pixel
        Program.PutU16(b, 4, 0);
        Program.PutU16(b, 6, 0);
        Program.PutU16(b, 8, w - 1);
        Program.PutU16(b, 10, h - 1);
        b[65] = (byte)1;      // planes
        Program.PutU16(b, 66, bytesPerLine);
        int i = 0;
        for (; i < bodyLen; i = i + 1) {
            b[128 + i] = (byte)(body[i] & 0xFF);
        }
        if (withPalette) {
            int t = 128 + bodyLen;
            b[t] = (byte)12;
            // Entry i is (i, 255-i, 128) so each channel is distinguishable.
            i = 0;
            while (i < 256) {
                b[t + 1 + i * 3] = (byte)i;
                b[t + 1 + i * 3 + 1] = (byte)(255 - i);
                b[t + 1 + i * 3 + 2] = (byte)128;
                i = i + 1;
            }
        }
        outLen.Add(total);
        return b;
    }

    static void Row(string b, List<int> at, int v) {
        b[at[0]] = (char)v;
        at[0] = at[0] + 1;
    }

    static void Main() {
        // 4x2, no padding. Row 0 is a run of 3 then a literal; row 1 is four
        // literals. Literals below 0xC0 encode as themselves.
        byte[] body = new byte[64];
        List<int> at = new List<int>();
        at.Add(0);
        Program.Row(body, at, 0xC3); Program.Row(body, at, 7);   // 3x value 7
        Program.Row(body, at, 9);                                 // literal 9
        Program.Row(body, at, 1); Program.Row(body, at, 2);
        Program.Row(body, at, 3); Program.Row(body, at, 4);
        int bodyLen = at[0];

        List<int> len = new List<int>();
        string raw = Program.Build(4, 2, 4, body, bodyLen, true, len);
        PcxImage p = PcxImage.Parse(raw, len[0]);

        Console.WriteLine("valid=" + Convert.ToString(p.IsValid()));
        Console.WriteLine("size=" + Convert.ToString(p.Width()) + "x"
            + Convert.ToString(p.Height()));
        Console.WriteLine("hasPal=" + Convert.ToString(p.HasPalette()));

        for (int y = 0; y < p.Height(); y = y + 1) {
            StringBuilder sb = new StringBuilder();
            sb.Append("row");
            sb.Append(Convert.ToString(y));
            sb.Append("=");
            for (int x = 0; x < p.Width(); x = x + 1) {
                sb.Append(Convert.ToString(p.IndexAt(x, y)));
                sb.Append(",");
            }
            Console.WriteLine(sb.ToString());
        }

        // PCX palettes are 8-bit per channel already, unlike the 6-bit .pal
        // files the terrain uses -- no expansion.
        Console.WriteLine("pal0=" + Convert.ToString(p.R(0)) + ","
            + Convert.ToString(p.G(0)) + "," + Convert.ToString(p.B(0)));
        Console.WriteLine("pal9=" + Convert.ToString(p.R(9)) + ","
            + Convert.ToString(p.G(9)) + "," + Convert.ToString(p.B(9)));
        Console.WriteLine("pal255=" + Convert.ToString(p.R(255)) + ","
            + Convert.ToString(p.G(255)) + "," + Convert.ToString(p.B(255)));

        // Out-of-range reads are 0 rather than a crash.
        Console.WriteLine("oob=" + Convert.ToString(p.IndexAt(9, 9)));
        p.Close();

        // bytesPerLine larger than the width: the padding must be consumed,
        // not written, or every row after the first is skewed.
        byte[] body2 = new byte[64];
        List<int> at2 = new List<int>();
        at2.Add(0);
        // Row 0: 2 visible pixels + 2 padding bytes.
        Program.Row(body2, at2, 5); Program.Row(body2, at2, 6);
        Program.Row(body2, at2, 0); Program.Row(body2, at2, 0);
        // Row 1.
        Program.Row(body2, at2, 8); Program.Row(body2, at2, 9);
        Program.Row(body2, at2, 0); Program.Row(body2, at2, 0);
        List<int> len2 = new List<int>();
        string raw2 = Program.Build(2, 2, 4, body2, at2[0], false, len2);
        PcxImage q = PcxImage.Parse(raw2, len2[0]);
        Console.WriteLine("pad_size=" + Convert.ToString(q.Width()) + "x"
            + Convert.ToString(q.Height())
            + " hasPal=" + Convert.ToString(q.HasPalette()));
        Console.WriteLine("pad_row0=" + Convert.ToString(q.IndexAt(0, 0))
            + "," + Convert.ToString(q.IndexAt(1, 0)));
        Console.WriteLine("pad_row1=" + Convert.ToString(q.IndexAt(0, 1))
            + "," + Convert.ToString(q.IndexAt(1, 1)));
        q.Close();

        // Anything that is not an 8-bit single-plane RLE PCX parses to an
        // invalid image rather than being guessed at.
        byte[] junk = new byte[256];
        junk[0] = (byte)99;
        PcxImage bad = PcxImage.Parse(junk, 256);
        Console.WriteLine("junk_valid=" + Convert.ToString(bad.IsValid()));
        PcxImage tiny = PcxImage.Parse(junk, 8);
        Console.WriteLine("short_valid=" + Convert.ToString(tiny.IsValid()));
    }
}
