// Shell flow: main menu -> skirmish setup -> playing, and back out again.
//
// Pure state, no window and no game data. The wrap-around and the
// no-maps guard are the cases worth pinning: a shell that can enter a game
// with nothing loaded crashes on the first frame.
using System;
using System.Collections.Generic;
using Ra2.Game;

namespace T;

class Program {
    static void Show(string label, Shell s) {
        Console.WriteLine(label + " scene=" + Convert.ToString(s.CurrentScene())
            + " map=" + Convert.ToString(s.MapIndex())
            + " side=" + Side.NameOf(s.SideIndex()));
    }

    static void Main() {
        Shell s = Shell.Create(3);
        Show("start", s);

        // Menu -> setup -> game.
        s.OpenSkirmish();
        Show("setup", s);
        Console.WriteLine("started=" + Convert.ToString(s.StartGame()));
        Show("playing", s);

        // Back steps one screen at a time and stops at the menu.
        s.Back();
        Show("back1", s);
        s.Back();
        Show("back2", s);
        s.Back();
        Show("back3", s);

        // Map selection wraps at both ends.
        s.OpenSkirmish();
        s.SelectMap(1);
        Show("map+1", s);
        s.SelectMap(1);
        s.SelectMap(1);
        Show("map+3", s);
        s.SelectMap(-1);
        Show("map-1", s);
        s.SelectMap(-5);
        Show("map-5", s);

        // Direct selection ignores out-of-range indices rather than clamping,
        // so a stale click cannot silently pick a different map.
        s.SelectMapAt(2);
        Show("at2", s);
        s.SelectMapAt(9);
        Show("at9", s);
        s.SelectMapAt(-1);
        Show("at-1", s);

        // Side toggles both ways.
        s.ToggleSide();
        Show("toggled", s);
        s.SetSide(Side.Allied());
        Show("allied", s);
        s.SetSide(7);
        Show("bogus_side", s);

        // An install with no maps cannot reach the setup screen or a game.
        Shell empty = Shell.Create(0);
        empty.OpenSkirmish();
        Show("empty_open", empty);
        Console.WriteLine("empty_start=" + Convert.ToString(empty.StartGame()));
        empty.SelectMap(1);
        Show("empty_sel", empty);

        Console.WriteLine("quit=" + Convert.ToString(s.WantsQuit()));
        s.Quit();
        Console.WriteLine("quit_after=" + Convert.ToString(s.WantsQuit()));
    }
}
