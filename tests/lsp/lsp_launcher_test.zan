using System;
using System.Net.Sockets;
using System.Threading;

// StartDetachedSafe discovers this test executable naturally. The Python owner
// starts the real server, retaining its process handle even if the client hangs.
class Program {
    static void Main(string[] args) {
        if (args.Length != 2 || args[0] != "--port") { Environment.Exit(2); }
        int ownerPort = Convert.ToInt32(Environment.GetEnvironmentVariable("ZAN_LSP_TEST_OWNER_PORT"));
        string token = Environment.GetEnvironmentVariable("ZAN_LSP_TEST_OWNER_TOKEN");
        nint socket = Socket.CreateTcp();
        if (socket < 0) { Environment.Exit(3); }
        try {
            if (Socket.Connect(socket, "127.0.0.1", ownerPort) != 0) { Environment.Exit(4); }
            string request = token + " " + Convert.ToString(Environment.ProcessId) + " " + args[1] + "\n";
            if (Socket.SendString(socket, request) != request.Length) { Environment.Exit(5); }
            Socket.SetNonBlocking(socket);
            byte[] ack = new byte[1];
            for (int attempt = 0; attempt < 200; attempt = attempt + 1) {
                if (Socket.IsReadable(socket)) {
                    if (Socket.Recv(socket, ack, 1) == 1 && ack[0] == 1) { return; }
                    Environment.Exit(6);
                }
                Thread.Sleep(25);
            }
            Environment.Exit(7);
        } finally { Socket.Close(socket); }
    }
}
