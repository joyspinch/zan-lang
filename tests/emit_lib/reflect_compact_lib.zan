using System;

[Table(Name = "compact_dll_records")]
class CompactDllRecord {
    [Column(Name = "remote_id", IsPrimary = true)]
    public int RemoteId = 71;
    [Required]
    [DefaultValue("remote-default")]
    public string RemoteText;

    public CompactDllRecord() { RemoteText = "remote-default"; }
    public CompactDllRecord(string text) { RemoteText = text; }

    [Description("COMPACT_DLL_METHOD_ATTRIBUTE")]
    public string OnRemote(string suffix) { return RemoteText + suffix; }
    public static int OnStatic() { return 37; }
}

class CompactReflectionLib {
    // The returned descriptor and both member-table pool bases belong to this
    // DLL. The consumer is compiled separately with different local metadata.
    public static TypeInfo GetTypeInfo() { return typeof(CompactDllRecord); }
}
