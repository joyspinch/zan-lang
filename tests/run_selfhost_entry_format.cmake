# Focused host/gen1 differential gate; consumes already-built tools and runtime.
# cmake -DZANC=<zanc> -DGEN1=<gen1> -DCLANG=<clang> -DBUILD_DIR=<build>
#   "-DRT_OBJS=<selfhost diff objects>" "-DSYSLIBS=<platform libraries>"
#   [-DSTDLIB_STAMP=<stamp>] -P tests/run_selfhost_entry_format.cmake
cmake_minimum_required(VERSION 3.20)
foreach(_required ZANC GEN1 CLANG BUILD_DIR RT_OBJS)
  if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
    message(FATAL_ERROR "selfhost_entry_format: ${_required} is required")
  endif()
endforeach()
foreach(_tool ZANC GEN1 CLANG)
  if(NOT EXISTS "${${_tool}}")
    message(FATAL_ERROR "selfhost_entry_format: ${_tool} is missing; build it before running this test")
  endif()
endforeach()
foreach(_obj IN LISTS RT_OBJS)
  if(NOT EXISTS "${_obj}")
    message(FATAL_ERROR "selfhost_entry_format: missing runtime object ${_obj}; build zanrt_selfhost_diff_bundle first")
  endif()
endforeach()
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_cases "${BUILD_DIR}/cases/selfhost_entry_format")
set(_logs "${BUILD_DIR}/test-out/selfhost_entry_format")
file(MAKE_DIRECTORY "${_cases}" "${_logs}")
file(REMOVE "${_logs}/passed.txt")
set(_ext "")
if(WIN32)
  set(_ext .exe)
  set(ENV{PATH} "${BUILD_DIR};$ENV{PATH}")
endif()
set(ENV{ZAN_STDLIB_PATH} "${_root}/stdlib")

# These tools are inputs, not build outputs of the test. Detect replacement
# during the run rather than silently comparing two compiler generations.
set(_inputs "${ZANC}" "${GEN1}" "${CLANG}" "${CMAKE_CURRENT_LIST_FILE}" ${RT_OBJS})
if(STDLIB_STAMP AND EXISTS "${STDLIB_STAMP}")
  list(APPEND _inputs "${STDLIB_STAMP}")
endif()
foreach(_lib IN LISTS SYSLIBS)
  if(EXISTS "${_lib}")
    list(APPEND _inputs "${_lib}")
  endif()
endforeach()
set(_names regress_format_join_bounds entry_void entry_int entry_void_args entry_int_args)
foreach(_name IN LISTS _names)
  if(_name STREQUAL "regress_format_join_bounds")
    set(_base "${_root}/tests/conformance/${_name}")
  else()
    set(_base "${_root}/tests/selfhost/${_name}")
  endif()
  set(_source_${_name} "${_base}.zan")
  set(_gold_${_name} "${_base}.out")
  list(APPEND _inputs "${_base}.zan" "${_base}.out")
  if(_name MATCHES "_args$")
    list(APPEND _inputs "${_base}.empty.out")
  endif()
endforeach()
set(_before)
file(WRITE "${_logs}/inputs.txt" "")
foreach(_input IN LISTS _inputs)
  if(NOT EXISTS "${_input}")
    message(FATAL_ERROR "selfhost_entry_format: missing input ${_input}")
  endif()
  file(SHA256 "${_input}" _hash)
  file(TIMESTAMP "${_input}" _mtime "%Y-%m-%dT%H:%M:%S.%fZ" UTC)
  list(APPEND _before "${_hash}:${_mtime}")
  file(APPEND "${_logs}/inputs.txt" "${_hash} ${_mtime}  ${_input}\n")
endforeach()

function(_stage _name _timeout _expected_rc)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${_root}"
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err
    ENCODING UTF-8 TIMEOUT ${_timeout})
  file(WRITE "${_logs}/${_name}.exit" "${_rc}\n")
  file(WRITE "${_logs}/${_name}.stdout" "${_out}")
  file(WRITE "${_logs}/${_name}.stderr" "${_err}")
  if(NOT "${_rc}" STREQUAL "${_expected_rc}")
    message(FATAL_ERROR "${_name}: expected exit ${_expected_rc}, got ${_rc}; see ${_logs}/${_name}.stdout/.stderr")
  endif()
  set(_stage_out "${_out}" PARENT_SCOPE)
  set(_stage_err "${_err}" PARENT_SCOPE)
endfunction()

function(_normalize _out _text)
  string(REPLACE "\r\n" "\n" _text "${_text}")
  string(REGEX REPLACE "[ \t\r\n]+$" "" _text "${_text}")
  set(${_out} "${_text}" PARENT_SCOPE)
endfunction()

function(_run_pair _name _variant _gold _rc)
  file(READ "${_gold}" _expected)
  _normalize(_expected "${_expected}")
  foreach(_compiler host gen1)
    _stage("${_name}.${_variant}.${_compiler}.run" 5 "${_rc}"
      "${_cases}/${_name}.${_compiler}${_ext}" ${ARGN})
    _normalize(_actual "${_stage_out}")
    if(NOT "${_actual}" STREQUAL "${_expected}" OR NOT "${_stage_err}" STREQUAL "")
      message(FATAL_ERROR "${_name}/${_variant}/${_compiler}: stdout golden or stderr mismatch; see ${_logs}")
    endif()
    if(_compiler STREQUAL "host")
      set(_host "${_actual}")
    elseif(NOT "${_actual}" STREQUAL "${_host}")
      message(FATAL_ERROR "${_name}/${_variant}: host/gen1 stdout differs; see ${_logs}")
    endif()
  endforeach()
  message(STATUS "PASS ${_name}/${_variant}: host/gen1 stdout and exit ${_rc}")
endfunction()

foreach(_name IN LISTS _names)
  set(_src "${_source_${_name}}")
  set(_ll "${_cases}/${_name}.ll")
  set(_host_exe "${_cases}/${_name}.host${_ext}")
  set(_gen_exe "${_cases}/${_name}.gen1${_ext}")
  # Fresh case outputs prevent a compiler that exits 0 without emitting from
  # borrowing an earlier successful result. No compiler or bundle is rebuilt.
  file(REMOVE "${_ll}" "${_host_exe}" "${_gen_exe}")
  _stage("${_name}.host.compile" 60 0 "${ZANC}" "${_src}"
    --auto-stdlib --package-project "${_root}" -o "${_host_exe}")
  if(NOT EXISTS "${_host_exe}")
    message(FATAL_ERROR "${_name}: host reported success without an executable; see ${_logs}")
  endif()
  _stage("${_name}.gen1.emit" 60 0 "${GEN1}" "${_ll}" "${_src}")
  string(ASCII 27 _esc)
  string(REGEX REPLACE "${_esc}\\[[0-9;]*m" "" _emit_log "${_stage_out}\n${_stage_err}")
  if(_emit_log MATCHES "(^|[\r\n])[^\r\n]*error:" OR
     _emit_log MATCHES "[1-9][0-9]* error\\(s\\)" OR NOT EXISTS "${_ll}")
    message(FATAL_ERROR "${_name}: gen1 emit diagnostics or missing IR despite exit 0; see ${_logs}")
  endif()
  file(READ "${_ll}" _ir)
  if(NOT _ir MATCHES "define i32 @main\\(")
    message(FATAL_ERROR "${_name}: gen1 IR has no native entry point; see ${_ll}")
  endif()
  _stage("${_name}.gen1.link" 60 0 "${CLANG}" "${_ll}" ${RT_OBJS} ${SYSLIBS} -o "${_gen_exe}")
  if(NOT EXISTS "${_gen_exe}")
    message(FATAL_ERROR "${_name}: linker reported success without an executable; see ${_logs}")
  endif()
  set(_rc 0)
  if(_name STREQUAL "entry_int" OR _name STREQUAL "entry_int_args")
    set(_rc 37)
  endif()
  if(_name MATCHES "_args$")
    _run_pair("${_name}" nonempty "${_gold_${_name}}" "${_rc}" alpha "beta gamma")
    if(_name STREQUAL "entry_int_args")
      set(_rc 19)
    endif()
    string(REGEX REPLACE "\\.out$" ".empty.out" _empty_gold "${_gold_${_name}}")
    _run_pair("${_name}" empty "${_empty_gold}" "${_rc}")
  else()
    _run_pair("${_name}" noargs "${_gold_${_name}}" "${_rc}")
  endif()
endforeach()
set(_after)
foreach(_input IN LISTS _inputs)
  file(SHA256 "${_input}" _hash)
  file(TIMESTAMP "${_input}" _mtime "%Y-%m-%dT%H:%M:%S.%fZ" UTC)
  list(APPEND _after "${_hash}:${_mtime}")
endforeach()
if(NOT "${_before}" STREQUAL "${_after}")
  message(FATAL_ERROR "selfhost_entry_format: inputs changed during validation; see ${_logs}/inputs.txt")
endif()
file(WRITE "${_logs}/passed.txt" "5 programs, 7 argument variants, 14 executions: host/gen1 golden stdout and explicit exit codes agree; inputs stable.\n")
message(STATUS "selfhost_entry_format: 5 programs, 7 variants passed")
