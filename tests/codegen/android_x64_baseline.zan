using System.Runtime.Intrinsics;

// Constant aggregate initialization used to emit unconditional AVX stores on Android.
class AndroidBaselinePayload {
    public long A = 1;
    public long B = 2;
    public long C = 3;
    public long D = 4;
    public long E = 5;
    public long F = 6;
    public long G = 7;
    public long H = 8;
}

class AndroidBaselineCodegen {
    public static AndroidBaselinePayload Make() {
        return new AndroidBaselinePayload;
    }

    // Exercise both AVX2-specific lowerings with dynamic operands.
    public static int AverageMask(Vector256 left, Vector256 right) {
        return Vector256.ExtractMostSignificantBits(Vector256.Average(left, right));
    }
}
