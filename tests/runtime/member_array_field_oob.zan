// An indexed store into an array held in an object field must be bounds
// checked like a local array: obj.field[i] = v used to store silently out
// of bounds instead of trapping.
class Grids {
    public int[] cells = new int[2];
}

class Program {
    static void Main() {
        Grids g = new Grids();
        g.cells[999] = 1;
        Console.WriteLine(g.cells[0]);
    }
}
