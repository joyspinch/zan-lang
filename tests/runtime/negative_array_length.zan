// negative_array_length.zan -- a negative dim in `new T[n]` must trap with
// the standard report. ZAN_RT_HARD=1 (set by run_runtime_error.cmake) exits
// 70 after the report; production soft mode folds the dim to 0 and yields
// an empty array.
class Program {
    static void Main() {
        int[] a = new int[-5];
        Console.WriteLine(a.Length);
    }
}
