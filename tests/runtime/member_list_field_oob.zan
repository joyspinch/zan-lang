// An indexed store into a List held in a object field must be bounds
// checked like a local List: obj.field[i] = v used to GEP straight into
// the data buffer and corrupt neighbouring heap on an oversized index.
class Boxes {
    public List<int> items = new List<int>();
}

class Program {
    static void Main() {
        Boxes b = new Boxes();
        b.items.Add(1);
        b.items[5] = 2;
        Console.WriteLine(b.items[0]);
    }
}
