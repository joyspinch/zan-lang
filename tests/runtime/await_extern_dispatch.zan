using System;

class Program {
    [DllImport("crt", EntryPoint = "audit_native_int")]
    static extern int NativeInt(int value);
    [DllImport("crt", EntryPoint = "audit_native_handle")]
    static extern nint NativeHandle();
    [DllImport("crt", EntryPoint = "audit_native_void")]
    static extern void NativeVoid();
    [DllImport("crt", EntryPoint = "audit_dispatch_fail_next")]
    static extern void FailNext();
    [DllImport("crt", EntryPoint = "audit_native_calls")]
    static extern int NativeCalls();

    static async void FaultVoid() {
        await NativeVoid();
        Console.WriteLine("unexpected void continuation");
    }

    static async void Run() {
        int catches = 0;
        int finallyRuns = 0;
        FailNext();
        try {
            int bad = await NativeInt(7);
            Console.WriteLine("unexpected int " + bad);
        } catch (InvalidOperationException e) {
            catches = catches + 1;
        } finally {
            finallyRuns = finallyRuns + 1;
        }
        FailNext();
        try {
            nint bad = await NativeHandle();
            if (bad == 0) { Console.WriteLine("unexpected handle"); }
        } catch (InvalidOperationException e) {
            catches = catches + 1;
        }
        FailNext();
        try {
            await FaultVoid();
            Console.WriteLine("unexpected parent continuation");
        } catch (InvalidOperationException e) {
            catches = catches + 1;
        }
        int zero = await NativeInt(0);
        int negative = await NativeInt(-1);
        nint handle = await NativeHandle();
        await NativeVoid();
        Console.WriteLine(catches == 3 && finallyRuns == 1 && zero == 0
            && negative == -1 && handle == (nint)4294967297L && NativeCalls() == 4);
    }

    static void Main() {
        await Run();
    }
}
