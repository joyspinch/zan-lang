using System;
using System.Net.Sockets;

class Program {
    [DllImport("crt", EntryPoint = "audit_dispatch_fail_next")]
    static extern void FailNext();
    [DllImport("crt", EntryPoint = "audit_dispatch_failure_pending")]
    static extern int FailurePending();

    static async void Run() {
        byte[] records = new byte[32];
        records[0] = 71;
        FailNext();
        int count = await Socket.ResolveAllAsync("127.0.0.1", 80, records);
        bool resolveFailed = count == 0 && records[0] == 71 && FailurePending() == 0;

        FailNext();
        int connected = await Socket.ConnectSockAddrAsync((nint)(-1), records, 16, 1);
        Console.WriteLine(resolveFailed && connected == -1 && FailurePending() == 0);
    }

    static void Main() {
        await Run();
    }
}
