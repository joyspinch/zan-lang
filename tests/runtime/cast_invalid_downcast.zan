// B-ID163③：`(T)x` 引用下转失败在 try 外未捕获——未处理
// InvalidCastException 终止进程（exit 1，打印诊断文案）。
// 旧实现走 A509 软失败：stderr 一次后拿 null 继续跑（静默默认值缺陷）。
// try 内可 catch 的正测在 conformance/cast_invalid_catch.zan。
using System;

class Animal { public string Name; }
class Dog : Animal { public int Bark; }

class Program {
    static int Main() {
        Animal a = new Animal();
        a.Name = "generic";
        Dog d = (Dog)a;
        Console.WriteLine(d.Bark);
        return 0;
    }
}
