// 核心契约与语义定义。
// 核心契约与语义定义。
class Program {
    static int Wrap(int a, int b) {
        return checked(a + b);   // overflow site: INT_MAX + 1
    }
    static void Main() {
        int x = 2147483647;
        int y = Wrap(x, 1);      // traps inside Wrap (not inlined away)
        Console.WriteLine(y);
    }
}
