// checked_overflow.zan -- checked integer arithmetic must trap on overflow.
// ZAN_RT_HARD=1 (set by run_runtime_error.cmake) exits 70 after the report.
class Program {
    static int Wrap(int a, int b) {
        return checked(a + b);   // overflow site: INT_MAX + 1
    }
    static void Main() {
        int x = 2147483647;
        int y = Wrap(x, 1);      // traps inside Wrap (not inlined away)
        Console.WriteLine(y);
    }
}
