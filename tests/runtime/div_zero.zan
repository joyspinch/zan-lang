// div_zero.zan -- division/modulo by zero must trap with the standard
// report. ZAN_RT_HARD=1 (set by run_runtime_error.cmake) exits 70 after the
// report; production soft mode folds the divisor to 1 and keeps running.
class Program {
    static void Main() {
        int a = 5;
        int b = a / 0;
        Console.WriteLine(b);
    }
}
