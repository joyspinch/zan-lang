// IDE 各平台证书设置与发布签名环境变量装配回归用例
using System;
using System.IO;
using System.Collections.Generic;

partial class ZanIDE {
    static Dictionary<string, string> testProjFields = new Dictionary<string, string>();

    public static string ProjField(string root, string key) {
        if (ZanIDE.testProjFields != null && ZanIDE.testProjFields.ContainsKey(key)) {
            return ZanIDE.testProjFields[key];
        }
        return "";
    }

    public static void SetProjField(string root, string key, string val) {
        if (ZanIDE.testProjFields == null) {
            ZanIDE.testProjFields = new Dictionary<string, string>();
        }
        ZanIDE.testProjFields[key] = val;
    }

    public static string ToWinPath(string p) {
        if (p == null) { return ""; }
        return p.Replace("/", "\\");
    }

    public static string T(string en, string zh) {
        return zh;
    }
}

class SigningConfigTest {
    static int bad = 0;

    static void Check(string what, bool ok) {
        if (!ok) {
            Console.WriteLine("FAIL " + what);
            SigningConfigTest.bad = SigningConfigTest.bad + 1;
        }
    }

    static void Main() {
        string root = "_scratch/test_signing_proj";
        List<string> log = new List<string>();

        // ---- 1. 默认未配置状态：默认无证书 / Debug 签名，不中断构建 ----
        string aSummary0 = ZanIDE.SigningSummary(root, "android");
        Check("android-summary-default", aSummary0.IndexOf("Debug") >= 0);
        string aEnv0 = ZanIDE.SigningEnvPrefix(root, "android", log);
        Check("android-env-empty", aEnv0 == "");

        string iosSummary0 = ZanIDE.SigningSummary(root, "ios");
        Check("ios-summary-default", iosSummary0.IndexOf("未签名") >= 0);
        string iosEnv0 = ZanIDE.SigningEnvPrefix(root, "ios", log);
        Check("ios-env-empty", iosEnv0 == "");

        string ohosSummary0 = ZanIDE.SigningSummary(root, "ohos");
        Check("ohos-summary-default", ohosSummary0.IndexOf("未签名") >= 0);
        string ohosEnv0 = ZanIDE.SigningEnvPrefix(root, "ohos", log);
        Check("ohos-env-empty", ohosEnv0 == "");

        string winSummary0 = ZanIDE.SigningSummary(root, "windows");
        Check("win-summary-default", winSummary0.IndexOf("未设置") >= 0);

        // ---- 2. 配置 Android 商用证书后一键签署装配 ----
        ZanIDE.SetSigningConfig(root, "android", "certs/release.keystore", null, "123456", "my_alias");
        string aSummary1 = ZanIDE.SigningSummary(root, "android");
        Check("android-summary-configured", aSummary1.IndexOf("[OK]") >= 0 && aSummary1.IndexOf("release.keystore") >= 0 && aSummary1.IndexOf("my_alias") >= 0);
        string aEnv1 = ZanIDE.SigningEnvPrefix(root, "android", log);
        Check("android-env-keystore", aEnv1.IndexOf("ZAN_ANDROID_KEYSTORE") >= 0);
        Check("android-env-pass", aEnv1.IndexOf("ZAN_ANDROID_KEYSTORE_PASS") >= 0);
        Check("android-env-alias", aEnv1.IndexOf("ZAN_ANDROID_KEY_ALIAS") >= 0);

        // ---- 3. 配置 iOS 开发者证书与描述文件 ----
        ZanIDE.SetSigningConfig(root, "ios", "Apple Distribution: Corp (XYZ)", "certs/app.mobileprovision", null, null);
        string iosSummary1 = ZanIDE.SigningSummary(root, "ios");
        Check("ios-summary-configured", iosSummary1.IndexOf("[OK]") >= 0 && iosSummary1.IndexOf("Apple Distribution") >= 0 && iosSummary1.IndexOf("app.mobileprovision") >= 0);
        string iosEnv1 = ZanIDE.SigningEnvPrefix(root, "ios", log);
        Check("ios-env-cert", iosEnv1.IndexOf("ZAN_IOS_CERT") >= 0);
        Check("ios-env-profile", iosEnv1.IndexOf("ZAN_IOS_PROFILE") >= 0);

        // ---- 4. 配置 HarmonyOS (鸿蒙) 证书与 Profile ----
        ZanIDE.SetSigningConfig(root, "ohos", "certs/app.cer", "certs/app.p7b", "ohos_pass", "ohos_alias");
        string ohosSummary1 = ZanIDE.SigningSummary(root, "ohos");
        Check("ohos-summary-configured", ohosSummary1.IndexOf("[OK]") >= 0 && ohosSummary1.IndexOf("app.cer") >= 0 && ohosSummary1.IndexOf("app.p7b") >= 0);
        string ohosEnv1 = ZanIDE.SigningEnvPrefix(root, "ohos", log);
        Check("ohos-env-cert", ohosEnv1.IndexOf("ZAN_OHOS_CERT") >= 0);
        Check("ohos-env-profile", ohosEnv1.IndexOf("ZAN_OHOS_PROFILE") >= 0);

        // ---- 5. 配置 Windows Authenticode 证书 ----
        ZanIDE.SetSigningConfig(root, "windows", "certs/app.pfx", null, "pfx_pass", null);
        string winSummary1 = ZanIDE.SigningSummary(root, "windows");
        Check("win-summary-configured", winSummary1.IndexOf("[OK]") >= 0 && winSummary1.IndexOf("app.pfx") >= 0);

        Console.WriteLine("ide-signing-config-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
        Environment.Exit(bad == 0 ? 0 : 1);
    }
}
