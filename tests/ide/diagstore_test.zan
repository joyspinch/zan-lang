using System;
using System.IO;

/// 本地诊断聚合的无窗口回归：解析、去重计数、脱敏（路径/密钥/邮箱/连接串）、
/// JSONL 落盘与读回、报告生成、以及「不同意带日志时 payload 里不能有事件」。
class Program {
    static void Line(string s) { Console.WriteLine(s); }

    static void Main() {
        string dir = "_scratch/diagstore_t";
        if (File.Exists(dir + "/events.jsonl")) {
            try { File.Delete(dir + "/events.jsonl"); }
            catch (Exception e) { int i = 0; }
        }
        DiagStore.Open(dir);
        Line("empty=" + Convert.ToString(DiagStore.Count()));

        // 编译器输出：认出 file:line:col，认不出位置的错误行也要收
        List<string> log = new List<string>();
        log.Add("[zanc] compiling src/app.zan");
        log.Add("src/app.zan:12:65: error: undeclared identifier 'snapx'");
        log.Add("stdlib/Gui/List.zan:88: warning: unused local 'h'");
        log.Add("error: code generation failed");
        int n = DiagStore.IngestBuildLog(log, 1000);
        Line("ingested=" + Convert.ToString(n) + " count="
            + Convert.ToString(DiagStore.Count()));
        DiagEvent e0 = DiagStore.All()[0];
        Line("e0 file=" + e0.file + " line=" + Convert.ToString(e0.line)
            + " col=" + Convert.ToString(e0.col) + " msg=" + e0.message);
        Line("e0 ctx=" + Convert.ToString(e0.context.Count));
        DiagEvent e2 = DiagStore.All()[2];
        Line("e2 file=[" + e2.file + "] sev=" + e2.severity + " msg=" + e2.message);

        // 同一条重复只加计数，不刷屏
        DiagStore.IngestBuildLog(log, 1100);
        Line("dedup count=" + Convert.ToString(DiagStore.Count())
            + " n0=" + Convert.ToString(DiagStore.All()[0].count));

        // 运行失败：非零退出与崩溃分级
        DiagStore.IngestRun("build/app.exe", 1, "assert failed", 1200);
        DiagStore.IngestRun("build/app.exe", 0 - 1073741819, "", 1300);
        DiagStore.IngestRun("build/app.exe", 0, "clean", 1400);
        Line("run count=" + Convert.ToString(DiagStore.Count())
            + " sev=" + DiagStore.All()[DiagStore.Count() - 1].severity);

        // 脱敏：绝对路径、口令、令牌、Bearer、邮箱
        Line(DiagStore.Redact("open d:\\project\\zan-lang\\src\\app.zan failed"));
        Line(DiagStore.Redact("/home/moore/keys/id_rsa missing"));
        Line(DiagStore.Redact("Server=db1;Password=hunter2;Uid=root"));
        Line(DiagStore.Redact("Authorization: Bearer abc123def"));
        Line(DiagStore.Redact("api_key=sk-1234567890 token: t-9"));
        Line(DiagStore.Redact("mail moore@example.com about it"));
        Line(DiagStore.Redact("keep C:relative and 1:2 intact"));

        // UI 层异常并进同一个列表
        List<string> ui = new List<string>();
        ui.Add("frame: null reference in ThemeCard.Render");
        DiagStore.IngestUiErrors(ui, 1500);
        Line("ui count=" + Convert.ToString(DiagStore.Count()));

        // 落盘 + 读回：计数与位置都要还原
        int before = DiagStore.Count();
        DiagStore.Open(dir);
        Line("reload count=" + Convert.ToString(DiagStore.Count())
            + " same=" + Convert.ToString(DiagStore.Count() == before));
        DiagEvent r0 = DiagStore.All()[0];
        Line("reload e0 file=" + r0.file + " line=" + Convert.ToString(r0.line)
            + " count=" + Convert.ToString(r0.count));

        // 坏行不能让读取整体失败
        File.AppendAllText(dir + "/events.jsonl", "{not json\n");
        DiagStore.Open(dir);
        Line("after-bad count=" + Convert.ToString(DiagStore.Count()));

        // 报告：可粘贴文本，用户描述也走脱敏
        string rep = DiagStore.Report("我在 d:\\project\\x 里点了运行", "ZanIDE/0.2.1", 2);
        List<string> rl = new List<string>();
        string cur = "";
        for (int i = 0; i < rep.Length; i = i + 1) {
            string ch = rep.Substring(i, 1);
            if (ch == "\n") { rl.Add(cur); cur = ""; } else { cur = cur + ch; }
        }
        if (cur != "") { rl.Add(cur); }
        for (int i = 0; i < rl.Count; i = i + 1) {
            if (rl[i] != "") { Line("R| " + rl[i]); }
        }

        // 不同意带日志 => payload 里一条事件都不许有
        string noLogs = DiagStore.PayloadJson("坏了", "ZanIDE/0.2.1", false);
        string withLogs = DiagStore.PayloadJson("坏了", "ZanIDE/0.2.1", true);
        Line("payload-nologs-has-events="
            + Convert.ToString(DiagStore.Has(noLogs, "snapx")));
        Line("payload-logs-has-events="
            + Convert.ToString(DiagStore.Has(withLogs, "snapx")));

        DiagStore.Clear();
        Line("cleared=" + Convert.ToString(DiagStore.Count())
            + " file=" + Convert.ToString(File.Exists(dir + "/events.jsonl")));
    }
}
