using System;

partial class ZanIDE {
    static bool strictMemory;
    static bool denyWarnings;
    static bool windowed;
    static bool library;

    static bool ProjStrictMemory(string root) { return strictMemory; }
    static bool ProjDenyWarnings(string root) { return denyWarnings; }
    static bool IsLibraryProject(string root) { return library; }
    static bool IsWindowedTarget(string root, string path) { return windowed; }
    static string ZancCmd() { return "zanc"; }
    static string IconArg(string root) { return " --icon icon.ico"; }
}

class CompileModeTest {
    static int failures;

    static void Check(string actual, string expected) {
        if (actual != expected) {
            failures = failures + 1;
            Console.WriteLine("expected: " + expected);
            Console.WriteLine("actual:   " + actual);
        }
    }

    static int Main() {
        string diagnostic = " -g --arc-guard --check-leaks --strict-runtime";
        string deployedDebug = " -g --no-arc-guard --no-check-leaks";
        string tail = " inputs -o \"app.exe\" --icon icon.ico";
        for (int i = 0; i < 2; i = i + 1) {
            ZanIDE.strictMemory = i == 1;
            Check(ZanIDE.CompileToExe("root", "main.zan", "inputs", "", "app.exe", false, true),
                "zanc" + diagnostic + tail);
            string normal = "";
            if (ZanIDE.strictMemory) { normal = diagnostic; }
            Check(ZanIDE.CompileToExe("root", "main.zan", "inputs", "", "app.exe", false, false),
                "zanc" + normal + tail);
            for (int j = 0; j < 2; j = j + 1) {
                bool debug = j == 1;
                string deployment = " --publish";
                if (debug) { deployment = deployedDebug; }
                Check(ZanIDE.CompileToExe("root", "main.zan", "inputs", "", "app.exe", true, debug),
                    "zanc" + deployment + tail);
                Check(ZanIDE.CompileToExeSingleFile("root", "main.zan", "inputs", "", "app.exe", true, debug),
                    "zanc" + deployment + tail + " --link-mode static");
                Check(ZanIDE.CompileToExeCross("root", "main.zan", "inputs", "app.exe", "win-arm64", debug),
                    "zanc" + deployment + " --target win-arm64 --link-mode static" + tail);
                Check(IdeCompileMode.Flags(true, debug, ZanIDE.strictMemory), deployment);
            }
        }
        ZanIDE.denyWarnings = true;
        ZanIDE.windowed = true;
        Check(ZanIDE.CompileToExe("root", "main.zan", "inputs", "", "app.exe", false, true),
            "zanc" + diagnostic + " --deny-warnings inputs -o \"app.exe\" --subsystem windows --icon icon.ico");
        ZanIDE.library = true;
        Check(ZanIDE.CompileToExe("root", "main.zan", "inputs", "", "app.dll", true, true),
            "zanc" + deployedDebug + " --deny-warnings inputs -o \"app.dll\"");
        if (failures != 0) { return 1; }
        Console.WriteLine("IDE compile modes: ok");
        return 0;
    }
}
