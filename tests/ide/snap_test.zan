using System;
using Gui;
using Gui.Widget;
using Gui.Designer;

/// 自由布局磁吸的无窗口几何回归。
///
/// 吸附本身是纯整数几何（候选线 + 三锚点 + 阈值），所以在这里全量验证：贴画布
/// 边、水平/垂直居中、和另一个控件左对齐/右对齐/中线对齐、阈值之外不吸、以及
/// 「没命中就不画参考线」。真实窗口里剩下的只有指针坐标换算和画线。
class Program {
    static void Line(string s) { Console.WriteLine(s); }

    static FormField Box(int x, int y, int w, int h) {
        FormField f = new FormField(2);
        f.fx = x;
        f.fy = y;
        f.fw = w;
        f.fh = h;
        return f;
    }

    /// "adj/guide" —— 校正后的起点与参考线（-1 = 未命中）。
    static string Snap(int start, int size, List<int> lines, int tol) {
        List<int> r = Designer.SnapAxis(start, size, lines, tol);
        return Convert.ToString(r[0]) + "/" + Convert.ToString(r[1]);
    }

    static void Main() {
        // 画布 480x520，里面已有一个 (100,60,120,40) 的控件。
        List<FormField> sibs = new List<FormField>();
        FormField other = Box(100, 60, 120, 40);
        sibs.Add(other);
        FormField moving = Box(0, 0, 80, 30);
        sibs.Add(moving);

        List<int> xs = Designer.FreeSnapLines(true, sibs, moving, 480);
        List<int> ys = Designer.FreeSnapLines(false, sibs, moving, 520);
        Line("xlines=" + Convert.ToString(xs.Count)
            + " ylines=" + Convert.ToString(ys.Count));

        // 贴画布左边：左锚点落在 0 上。
        Line("canvas-left " + Program.Snap(3, 80, xs, 6));
        // 贴画布右边：右锚点吸到 480，左边被推到 400。
        Line("canvas-right " + Program.Snap(398, 80, xs, 6));
        // 水平居中：中锚点吸到 240，左边 200。
        Line("canvas-hcenter " + Program.Snap(198, 80, xs, 6));
        // 垂直居中：中锚点吸到 260，顶边 245。
        Line("canvas-vcenter " + Program.Snap(243, 30, ys, 6));

        // 和邻居左对齐（邻居 fx=100）。
        Line("peer-left " + Program.Snap(97, 80, xs, 6));
        // 右边贴邻居左边（100）：左边 = 100-80 = 20。
        Line("peer-left-edge " + Program.Snap(23, 80, xs, 6));
        // 左边贴邻居右边（220）。
        Line("peer-right-edge " + Program.Snap(222, 80, xs, 6));
        // 中线对齐邻居中线（160）：左边 = 160-40 = 120。
        Line("peer-hmid " + Program.Snap(118, 80, xs, 6));
        // 顶边对齐邻居顶边（60）。
        Line("peer-top " + Program.Snap(62, 30, ys, 6));
        // 底边贴邻居底边（100）：顶边 = 70。
        Line("peer-bottom " + Program.Snap(68, 30, ys, 6));

        // 阈值之外：原值返回，参考线 -1（拖到哪就是哪，不许悄悄挪位）。
        Line("far " + Program.Snap(300, 80, xs, 6));
        // 恰好在阈值上仍算命中（tol 是包含的）。
        Line("edge-of-tol " + Program.Snap(106, 80, xs, 6));

        // 自己不参与候选：只有画布三条线，所以远处不吸。
        List<FormField> only = new List<FormField>();
        only.Add(moving);
        List<int> solo = Designer.FreeSnapLines(true, only, moving, 480);
        Line("solo=" + Convert.ToString(solo.Count)
            + " " + Program.Snap(300, 80, solo, 6));

        // 阈值随缩放走：放大后同样的设计像素差不再吸（tol 变小）。
        Line("tol1 " + Program.Snap(103, 80, xs, 1));
    }
}
