// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。
class Program {
    static async int Work(int x) {
        int a = x + 1;
        await Task.Delay(20);
        int b = a + 1;
        await Task.Delay(20);
        return a + b;
    }
    static void Main() {
        int v = await Work(10);
        Console.WriteLine(v);
    }
}
