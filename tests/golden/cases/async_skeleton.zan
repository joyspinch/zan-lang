// 核心契约与语义定义。
class Program {
    static async int ComputeAsync(int x) {
        int result = x * 2;
        return result;
    }

    static async int ChainAsync(int a, int b) {
        return a + b;
    }

    static int Main() {
        return 0;
    }
}

class Counter {
    int n;
    async int NextAsync() {
        return n + 1;
    }
}
