module WechatMpTest;

import WechatMp;
import System.Console;

public class WechatMpTest {
    public static void TestBasicUsage() {
        var mp = new WechatMp("app1", "secret1");
        var token = mp.GetAccessTokenAsync().Wait();
        Assert(token.Length > 0);

        mp.SendTextMessageAsync("user1", "Hello from Zan WechatMp!").Wait();
        Console.WriteLine("WechatMp basic test passed");
    }

    public static void Run() {
        TestBasicUsage();
    }
}