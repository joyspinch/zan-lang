// 核心契约与语义定义。
using System;
using System.IO;

class Program {
    static void Main() {
        try {
            File.WriteAllText("wasm32_file_read_in_try.txt", "hello wasm");
            string s = File.ReadAllText("wasm32_file_read_in_try.txt");
            Console.WriteLine(s);
        } catch (Exception e) {
            Console.WriteLine("caught: " + e.Message);
        }
        Console.WriteLine("done");
    }
}
