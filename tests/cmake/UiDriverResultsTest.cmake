cmake_minimum_required(VERSION 3.16)
include("${CMAKE_CURRENT_LIST_DIR}/UiDriverResults.cmake")
if(NOT DEFINED BINARY_DIR)
  message(FATAL_ERROR "BINARY_DIR required")
endif()
file(MAKE_DIRECTORY "${BINARY_DIR}")
function(Check NAME TEXT EXPECTED)
  set(_path "${BINARY_DIR}/${NAME}.txt")
  file(WRITE "${_path}" "${TEXT}")
  UiDriverResultsCheck("${_path}" _error)
  if(EXPECTED AND NOT _error STREQUAL "")
    message(FATAL_ERROR "${NAME}: rejected: ${_error}")
  elseif(NOT EXPECTED AND _error STREQUAL "")
    message(FATAL_ERROR "${NAME}: incorrectly accepted")
  endif()
endfunction()
Check(valid "quit\nDONE pass=0 fail=0 command_errors=0\n" TRUE)
Check(assert_pass "ASSERT PASS  probe x equals y\nquit\nDONE pass=1 fail=0 command_errors=0\n" TRUE)
Check(crlf "quit\r\nDONE pass=2 fail=0 command_errors=0\r\n" TRUE)
Check(semicolon "log a;b\nquit\nDONE pass=0 fail=0 command_errors=0\n" TRUE)
Check(legacy "unfreeze: expected clock\nquit\nDONE pass=0 fail=0\n" FALSE)
Check(command_record "COMMAND ERROR line=1 unknown\nquit\nDONE pass=0 fail=0 command_errors=0\n" FALSE)
Check(assert_record "ASSERT FAIL probe x\nquit\nDONE pass=0 fail=0 command_errors=0\n" FALSE)
Check(command_count "quit\nDONE pass=0 fail=0 command_errors=1\n" FALSE)
Check(assert_count "quit\nDONE pass=0 fail=1 command_errors=0\n" FALSE)
Check(duplicate "quit\nDONE pass=0 fail=0 command_errors=0\nDONE pass=0 fail=0 command_errors=0\n" FALSE)
Check(after_done "quit\nDONE pass=0 fail=0 command_errors=0\nlog late\n" FALSE)
Check(fake_quit "log quit\nDONE pass=0 fail=0 command_errors=0\n" FALSE)
Check(no_done "quit\n" FALSE)
Check(bad_count "quit\nDONE pass=0 fail=x command_errors=0\n" FALSE)
if(DEFINED RUNTIME_DIR)
  UiDriverResultsCheck("${RUNTIME_DIR}/valid/results.log" _positive)
  if(NOT _positive STREQUAL "")
    message(FATAL_ERROR "actual positive session rejected: ${_positive}")
  endif()
  foreach(_name rejected assertion exception)
    UiDriverResultsCheck("${RUNTIME_DIR}/${_name}/results.log" _negative)
    if(_negative STREQUAL "")
      message(FATAL_ERROR "actual negative session ${_name} accepted")
    endif()
  endforeach()
endif()
message(STATUS "UIDRIVER_RESULTS_TEST_OK")
