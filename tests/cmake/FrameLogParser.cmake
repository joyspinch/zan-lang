cmake_minimum_required(VERSION 3.16)

# Pure parser: reads a profiler log; never launches an IDE or evaluates a budget.
# Legacy: frames=30 ... slow16=N surface=WxH, then adjacent raster/frame.
# Inline: frames=30 ... slow=N ... style=A/Bmiss surface=WxH on one line.
# Both slow names mean count(endMs - perfBeginMs > 16ms), not >16.7ms.
# surface is the complete canvas in device pixels, including app chrome.
# Inline logs without explicit surface are incomplete and must fail.

function(FrameLogToken LINE KEY OUT)
  string(REGEX MATCHALL "(^|[ \t])${KEY}=[^ \t]+" _matches "${LINE}")
  list(LENGTH _matches _count)
  if(NOT _count EQUAL 1)
    message(FATAL_ERROR "FRAME_LOG_INVALID: expected exactly one ${KEY} field")
  endif()
  list(GET _matches 0 _token)
  string(REGEX REPLACE "^[ \t]*${KEY}=" "" _value "${_token}")
  set(${OUT} "${_value}" PARENT_SCOPE)
endfunction()

function(FrameLogNumber LINE KEY OUT)
  FrameLogToken("${LINE}" "${KEY}" _value)
  if(NOT _value MATCHES "^[0-9]+(\\.[0-9]+)?$")
    message(FATAL_ERROR "FRAME_LOG_INVALID: nonnegative number required for ${KEY}")
  endif()
  set(${OUT} "${_value}" PARENT_SCOPE)
endfunction()

function(FrameLogInteger LINE KEY OUT)
  FrameLogToken("${LINE}" "${KEY}" _value)
  if(NOT _value MATCHES "^[0-9]+$")
    message(FATAL_ERROR "FRAME_LOG_INVALID: nonnegative integer required for ${KEY}")
  endif()
  set(${OUT} "${_value}" PARENT_SCOPE)
endfunction()

function(FrameLogSurface LINE OUT)
  FrameLogToken("${LINE}" "surface" _value)
  if(NOT _value MATCHES "^([1-9][0-9]*)x([1-9][0-9]*)$")
    message(FATAL_ERROR "FRAME_LOG_INVALID: positive device-pixel surface required")
  endif()
  set(${OUT} "${_value}" PARENT_SCOPE)
endfunction()

function(FrameLogStyle LINE PREFIX)
  FrameLogToken("${LINE}" "style" _value)
  if(NOT _value MATCHES "^([0-9]+)/([0-9]+)miss$")
    message(FATAL_ERROR "FRAME_LOG_INVALID: style requires resolves/misses")
  endif()
  set(${PREFIX}_RESOLVE "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${PREFIX}_MISS "${CMAKE_MATCH_2}" PARENT_SCOPE)
endfunction()

function(FrameLogClock LINE PREFIX)
  FrameLogToken("${LINE}" "clock" _clock)
  if(NOT _clock STREQUAL "raw-ms")
    message(FATAL_ERROR "FRAME_LOG_INVALID: clock=raw-ms required for performance timing")
  endif()
  set(${PREFIX} "${_clock}" PARENT_SCOPE)
endfunction()

function(FrameLogRaster LINE PREFIX)
  # RasterLine omits a primitive only when both calls and kpx are zero.
  # Absence of that primitive therefore means zero, not a missing timing field.
  foreach(_key fill blend restore round grad glyph snap radial blur blurhit img bsimd bscalar)
    string(REGEX MATCHALL "(^|[ \t])${_key}=[^ \t]+" _matches "${LINE}")
    list(LENGTH _matches _count)
    if(_count GREATER 1)
      message(FATAL_ERROR "FRAME_LOG_INVALID: duplicate raster field ${_key}")
    endif()
    set(_kpx 0)
    if(_count EQUAL 1)
      FrameLogToken("${LINE}" "${_key}" _value)
      if(NOT _value MATCHES "^[0-9]+/([0-9]+)kpx$")
        message(FATAL_ERROR "FRAME_LOG_INVALID: raster ${_key} requires nonnegative calls/kpx")
      endif()
      set(_kpx "${CMAKE_MATCH_1}")
    endif()
    set(_px_${_key} "${_kpx}")
    set(${PREFIX}_${_key}_KPX "${_kpx}" PARENT_SCOPE)
  endforeach()
  math(EXPR _total "${_px_fill}+${_px_blend}+${_px_restore}+${_px_round}+${_px_grad}+${_px_glyph}+${_px_snap}")
  set(${PREFIX}_TOTAL_KPX "${_total}" PARENT_SCOPE)
  FrameLogStyle("${LINE}" _style)
  set(${PREFIX}_STYLE_RESOLVE "${_style_RESOLVE}" PARENT_SCOPE)
  set(${PREFIX}_STYLE_MISS "${_style_MISS}" PARENT_SCOPE)
endfunction()

function(FrameLogParse PATH PREFIX)
  file(READ "${PATH}" _text)
  string(REPLACE "\r\n" "\n" _text "${_text}")
  if(_text MATCHES ";")
    message(FATAL_ERROR "FRAME_LOG_INVALID: semicolon unsupported in profiler text")
  endif()
  string(REPLACE "\n" ";" _lines "${_text}")
  set(_first_count 0)
  set(_batch_count 0)
  set(_pending FALSE)
  set(_formats "")
  foreach(_line IN LISTS _lines)
    if(_pending)
      if(NOT _line MATCHES "^[ \t]+raster/frame ")
        message(FATAL_ERROR "FRAME_LOG_INVALID: legacy batch requires immediately following raster/frame")
      endif()
      FrameLogRaster("${_line}" "${PREFIX}_BATCH_${_batch_count}")
      foreach(_key fill blend restore round grad glyph snap radial blur blurhit img bsimd bscalar)
        set(${PREFIX}_BATCH_${_batch_count}_${_key}_KPX "${${PREFIX}_BATCH_${_batch_count}_${_key}_KPX}" PARENT_SCOPE)
      endforeach()
      foreach(_key TOTAL_KPX STYLE_RESOLVE STYLE_MISS)
        set(${PREFIX}_BATCH_${_batch_count}_${_key} "${${PREFIX}_BATCH_${_batch_count}_${_key}}" PARENT_SCOPE)
      endforeach()
      set(_pending FALSE)
      math(EXPR _batch_count "${_batch_count}+1")
      continue()
    endif()
    if(_line MATCHES "^[ \t]*raster/frame")
      message(FATAL_ERROR "FRAME_LOG_INVALID: orphan raster/frame line")
    endif()
    if(_line MATCHES "^firstframe ")
      if(_first_count GREATER 0 OR _batch_count GREATER 0)
        message(FATAL_ERROR "FRAME_LOG_INVALID: firstframe duplicated or out of order")
      endif()
      math(EXPR _first_count "${_first_count}+1")
      foreach(_key whole_ms tree_ms)
        FrameLogNumber("${_line}" "${_key}" _value)
        set(${PREFIX}_FIRST_${_key} "${_value}" PARENT_SCOPE)
      endforeach()
      FrameLogToken("${_line}" "blend" _blend)
      if(NOT _blend MATCHES "^([0-9]+)kpx$")
        message(FATAL_ERROR "FRAME_LOG_INVALID: firstframe blend requires cumulative peek kpx")
      endif()
      set(${PREFIX}_FIRST_BLEND_KPX "${CMAKE_MATCH_1}" PARENT_SCOPE)
      FrameLogStyle("${_line}" _style)
      set(${PREFIX}_FIRST_STYLE_MISS "${_style_MISS}" PARENT_SCOPE)
      FrameLogClock("${_line}" _clock)
      set(${PREFIX}_FIRST_CLOCK "${_clock}" PARENT_SCOPE)
      FrameLogSurface("${_line}" _surface)
      set(${PREFIX}_FIRST_SURFACE "${_surface}" PARENT_SCOPE)
    elseif(_line MATCHES "^frames=")
      if(NOT _first_count EQUAL 1)
        message(FATAL_ERROR "FRAME_LOG_INVALID: batch before firstframe")
      endif()
      FrameLogInteger("${_line}" "frames" _frames)
      if(NOT _frames EQUAL 30)
        message(FATAL_ERROR "FRAME_LOG_INVALID: only complete frames=30 batches supported")
      endif()
      FrameLogSurface("${_line}" _surface)
      set(${PREFIX}_BATCH_${_batch_count}_SURFACE "${_surface}" PARENT_SCOPE)
      FrameLogClock("${_line}" _clock)
      set(${PREFIX}_BATCH_${_batch_count}_CLOCK "${_clock}" PARENT_SCOPE)
      foreach(_key render_ms worst_ms tree_ms part_render_ms)
        FrameLogNumber("${_line}" "${_key}" _value)
        set(${PREFIX}_BATCH_${_batch_count}_${_key} "${_value}" PARENT_SCOPE)
      endforeach()
      FrameLogInteger("${_line}" "partial" _partial)
      if(_partial GREATER 30)
        message(FATAL_ERROR "FRAME_LOG_INVALID: partial exceeds frames")
      endif()
      FrameLogInteger("${_line}" "full" _full)
      math(EXPR _sum "${_full}+${_partial}")
      if(NOT _sum EQUAL 30)
        message(FATAL_ERROR "FRAME_LOG_INVALID: full plus partial must equal frames")
      endif()
      set(${PREFIX}_BATCH_${_batch_count}_PARTIAL "${_partial}" PARENT_SCOPE)
      if(_line MATCHES "(^|[ \t])style=")
        set(_format inline)
        set(_slow_key slow)
        set(_forbidden slow16)
      else()
        set(_format legacy)
        set(_slow_key slow16)
        set(_forbidden slow)
      endif()
      if(_line MATCHES "(^|[ \t])${_forbidden}=")
        message(FATAL_ERROR "FRAME_LOG_INVALID: mixed slow field formats")
      endif()
      FrameLogInteger("${_line}" "${_slow_key}" _slow)
      if(_slow GREATER 30)
        message(FATAL_ERROR "FRAME_LOG_INVALID: slow count exceeds frames")
      endif()
      set(${PREFIX}_BATCH_${_batch_count}_SLOW_GT16 "${_slow}" PARENT_SCOPE)
      list(APPEND _formats "${_format}")
      if(_format STREQUAL inline)
        FrameLogRaster("${_line}" "${PREFIX}_BATCH_${_batch_count}")
        foreach(_key fill blend restore round grad glyph snap radial blur blurhit img bsimd bscalar)
          set(${PREFIX}_BATCH_${_batch_count}_${_key}_KPX "${${PREFIX}_BATCH_${_batch_count}_${_key}_KPX}" PARENT_SCOPE)
        endforeach()
        foreach(_key TOTAL_KPX STYLE_RESOLVE STYLE_MISS)
          set(${PREFIX}_BATCH_${_batch_count}_${_key} "${${PREFIX}_BATCH_${_batch_count}_${_key}}" PARENT_SCOPE)
        endforeach()
        math(EXPR _batch_count "${_batch_count}+1")
      else()
        set(_pending TRUE)
      endif()
    endif()
  endforeach()
  if(_pending)
    message(FATAL_ERROR "FRAME_LOG_INVALID: truncated legacy raster line")
  endif()
  if(NOT _first_count EQUAL 1 OR _batch_count LESS 1)
    message(FATAL_ERROR "FRAME_LOG_INVALID: firstframe and complete batches required")
  endif()
  set(${PREFIX}_BATCH_COUNT "${_batch_count}" PARENT_SCOPE)
  set(${PREFIX}_FORMATS "${_formats}" PARENT_SCOPE)
endfunction()
