cmake_minimum_required(VERSION 3.16)

# Results are a line protocol. Only a unique, final structured DONE with zero
# assertion and command errors can certify successful command execution.
function(UiDriverResultsCheck PATH OUT_ERROR)
  set(_error "")
  if(NOT EXISTS "${PATH}")
    set(${OUT_ERROR} "results file missing" PARENT_SCOPE)
    return()
  endif()
  file(READ "${PATH}" _text)
  string(REPLACE "\r\n" "\n" _text "${_text}")
  string(REPLACE ";" "\\;" _text "${_text}")
  string(REPLACE "\n" ";" _lines "${_text}")
  set(_done 0)
  set(_quit 0)
  foreach(_line IN LISTS _lines)
    string(STRIP "${_line}" _trimmed)
    if(_trimmed STREQUAL "")
      continue()
    endif()
    if(_done GREATER 0)
      set(_error "content after terminal DONE")
      break()
    endif()
    if(_line MATCHES "^COMMAND ERROR([ \t]|$)" OR _line MATCHES "^ASSERT FAIL([ \t]|$)")
      set(_error "command or assertion failure record")
      break()
    endif()
    if(_line STREQUAL "quit")
      math(EXPR _quit "${_quit} + 1")
    endif()
    if(_line MATCHES "^DONE([ \t]|$)")
      if(NOT _line MATCHES "^DONE pass=([0-9]+) fail=([0-9]+) command_errors=([0-9]+)$")
        set(_error "malformed DONE or missing command_errors")
        break()
      endif()
      if(NOT CMAKE_MATCH_2 STREQUAL "0" OR NOT CMAKE_MATCH_3 STREQUAL "0")
        set(_error "nonzero assertion or command errors")
        break()
      endif()
      math(EXPR _done "${_done} + 1")
    endif()
  endforeach()
  if(_error STREQUAL "" AND NOT _done EQUAL 1)
    set(_error "exactly one terminal DONE required")
  endif()
  if(_error STREQUAL "" AND NOT _quit EQUAL 1)
    set(_error "exactly one quit record required")
  endif()
  set(${OUT_ERROR} "${_error}" PARENT_SCOPE)
endfunction()

function(UiDriverResultsRequireSuccess PATH)
  UiDriverResultsCheck("${PATH}" _error)
  if(NOT _error STREQUAL "")
    message(FATAL_ERROR "UIDRIVER_RESULTS_INVALID: ${_error}")
  endif()
endfunction()
