cmake_minimum_required(VERSION 3.16)
include("${CMAKE_CURRENT_LIST_DIR}/FrameLogParser.cmake")
if(NOT DEFINED LOG)
  message(FATAL_ERROR "LOG required")
endif()
FrameLogParse("${LOG}" RESULT)
if(DEFINED EXPECTATIONS)
  include("${EXPECTATIONS}")
  foreach(_field IN LISTS EXPECT_FIELDS)
    if(NOT DEFINED RESULT_${_field})
      message(FATAL_ERROR "missing parsed field: ${_field}")
    endif()
    # String equality deliberately preserves the exact decimal text; numeric
    # EQUAL can truncate fractional values and cannot establish decimal fidelity.
    if(NOT "${RESULT_${_field}}" STREQUAL "${EXPECT_${_field}}")
      message(FATAL_ERROR "field ${_field}: got '${RESULT_${_field}}' expected '${EXPECT_${_field}}'")
    endif()
  endforeach()
endif()
message("FRAME_LOG_PARSE_OK batches=${RESULT_BATCH_COUNT} formats=${RESULT_FORMATS}")
