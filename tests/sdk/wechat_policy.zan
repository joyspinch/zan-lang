using System;
using System.Net.External;
using Sdk.Wechat;
using Sdk.Wechat.Work;
using Sdk.Wechat.TenPay;

class Program {
    static void Check(string name, bool ok) {
        Console.WriteLine(name + ":" + (ok ? "ok" : "bad"));
    }

    static void Main() {
        ExternalCallPolicy bounded = ExternalCallPolicy.Default()
            .ResponseLimit(4096).StreamLimit(8192).AllowLocalHttp();

        WechatClient mp = new WechatClient("app", "secret");
        Check("mp-default", mp.CallPolicy() != null);
        mp.SetCallPolicy(bounded);
        Check("mp-policy", mp.CallPolicy().MaxBodyBytes() == 4096
            && mp.CallPolicy().LocalHttpOnly());
        mp.SetCallPolicy(null);
        Check("mp-null-default", mp.CallPolicy() != null
            && !mp.CallPolicy().LocalHttpOnly());

        WechatWorkClient work = new WechatWorkClient("corp", "secret");
        work.SetCallPolicy(bounded);
        Check("work-policy", work.CallPolicy().MaxBodyBytes() == 4096
            && work.CallPolicy().LocalHttpOnly());

        WechatPayV2Config v2cfg = new WechatPayV2Config("app", "mch", "key");
        WechatPayV2Client v2 = new WechatPayV2Client(v2cfg);
        v2.SetCallPolicy(bounded);
        Check("v2-policy", v2.CallPolicy().MaxBodyBytes() == 4096
            && v2.CallPolicy().LocalHttpOnly());

        WechatPayLegacyMpConfig legacyCfg =
            new WechatPayLegacyMpConfig("app", "secret");
        WechatPayLegacyMpClient legacy =
            new WechatPayLegacyMpClient(legacyCfg);
        legacy.SetCallPolicy(bounded);
        Check("legacy-policy", legacy.CallPolicy().MaxBodyBytes() == 4096
            && legacy.CallPolicy().LocalHttpOnly());

        Check("remote-http-deny", !ExternalTargetPolicy.IsClientAllowed(
            "example.com", 80, false, bounded.AllowsLoopback(),
            bounded.AllowsHttp(), bounded.LocalHttpOnly()));
    }
}
