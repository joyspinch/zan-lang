// S4（docs/ZAN_STANDARD.md §1）：zanc --summary 的契约夹具。
// 只列公开面：private/internal 成员与 internal 类型不出现；属性降解出的
// get_/set_ 访问器不重复列出；文档取声明上方注释块的第一句；方法带 S2 效果列
// （可能抛出的异常类型上界、用到的能力），经调用传递（Check → Validate）。
using System;
using System.IO;
using System.Collections.Generic;

namespace Shop;

/// <summary>A priced line in an order. Second sentence is dropped.</summary>
public class OrderLine {
    // Unit price in cents.
    public long Price;
    private int secret;
    public int Qty { get; set; }
    // Builds a line. Validation happens in Add.
    public OrderLine(long price, int qty) { Price = price; Qty = qty; }
    // Total in cents。后面这句不要。
    public long Total() { return Price * Qty; }
    internal void Audit() { }
    // Rejects negative quantities.
    public void Validate() { if (Qty < 0) { throw new ArgumentException("qty"); } }
    public void Check() { Validate(); }
    // Reads a price list.
    public static string LoadPrices(string path) { return File.ReadAllText(path); }
}

// Ordered collection of lines.
[Serializable]
public class Cart<T> : IDisposable {
    List<T> items = new List<T>();
    public void Add(T item) { items.Add(item); }
    public static Cart<T> Empty() { return new Cart<T>(); }
    public U Map<U>(Func<T, U> f) { return f(items[0]); }
    public void Dispose() { }
}

public interface IPricing {
    // Price for a quantity.
    long PriceFor(int qty);
}

public enum Tier {
    Basic,
    // The paid tier.
    Pro,
}

internal class Hidden {
    public void NotListed() { }
}
