// zan-check replay 步的夹具：一个确定性小仿真，replays/ 下有录好的回放，
// 并带机器人（static int Bot）供模糊测试。
using System;
using Game.Foundation;

public class CoinSim : IReplaySim {
    public int coins;
    public int taken;
    DeterministicRandom rng;

    public void Reset(long seed) {
        coins = 50;
        taken = 0;
        rng = new DeterministicRandom(seed);
    }

    // 输入 1：拿走 1..3 枚（随机）；2：放回 1 枚
    public void Step(int frame, int input) {
        if (input == 1 && coins > 0) {
            int n = 1 + rng.NextBelow(3);
            if (n > coins) { n = coins; }
            coins = coins - n;
            taken = taken + n;
        } else if (input == 2 && taken > 0) {
            coins = coins + 1;
            taken = taken - 1;
        }
    }

    public int StateChecksum() {
        return new StateHasher().Int(coins).Int(taken).Long(rng.State()).Value();
    }

    [Invariant]
    public bool Conserved() { return coins + taken == 50 && coins >= 0; }

    public static int Bot(DeterministicRandom rng, int frame) { return rng.NextBelow(3); }

    public static void Main() { Console.WriteLine("coins"); }
}
