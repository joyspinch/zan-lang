using Gui;
using System;
using System.IO;
using System.Json;
using System.Text;

// P6 oracle 驱动（scroll.json 的 Zan 侧）：与 html_driver 同款——
// css+body+selectors 单一来源，body 交 Html 建树（运行时路径），
// scrollTop/scrollLeft 键（扁平 [id, v, ...]）对每个 id
// SetScrollTop/SetScrollLeft 后测量排布，按 selectors 序输出
// `#id x,y wxh`。Chrome 侧由 web_oracle.py 注入解析期脚本设
// scrollTop/scrollLeft + --hide-scrollbars（Zan 的滚动条是覆盖式，
// 不占布局宽，两边对齐）。
class Program {
    static void Main() {
        Html.Install(); // App 编译图不背 HTML 声明层,用 LoadHtml 的宿主先装。
        string json = File.ReadAllText("tests/weboracle/scroll.json");
        JsonValue j = JsonValue.Parse(json);
        string css = j.Str("css", "");
        string body = j.Str("body", "");

        App app = new App("oracle-scroll", 360, 500);
        app.UseCss(css);
        Control root = app.LoadHtmlWith(body, null, "");
        if (root == null) { Console.WriteLine("FAIL: html loader missing"); return; }

        // 程序性滚动（Chrome 侧解析期脚本等价）：排布前设，Arrange
        // 期按内容延伸钳制并平移子树。双轴各一份数据（P6 横滚后
        // scrollLeft 与 scrollTop 同语义）。
        JsonValue st = j.Get("scrollTop");
        if (st != null && st.IsArray()) {
            for (int i = 0; i + 1 < st.Count(); i = i + 2) {
                string id = st.At(i).AsString("");
                int v = st.At(i + 1).AsInt(0);
                Control hit = Program.Find(root, id);
                if (hit != null) { hit.SetScrollTop(v); }
            }
        }
        JsonValue sl = j.Get("scrollLeft");
        if (sl != null && sl.IsArray()) {
            for (int i = 0; i + 1 < sl.Count(); i = i + 2) {
                string id = sl.At(i).AsString("");
                int v = sl.At(i + 1).AsInt(0);
                Control hit = Program.Find(root, id);
                if (hit != null) { hit.SetScrollLeft(v); }
            }
        }

        root.HintWrapWidth(320);
        root.MeasureTree(app);
        root.Arrange(0, 0, 320, root.prefH);
        JsonValue sels = j.Get("selectors");
        if (sels == null) { return; }
        for (int i = 0; i < sels.Count(); i = i + 1) {
            string sel = sels.At(i).AsString("");
            string id = sel.StartsWith("#") ? sel.Substring(1) : sel;
            Control hit = Program.Find(root, id);
            if (hit == null) { continue; }
            Console.WriteLine("#" + id + " " + hit.bx + "," + hit.by
                              + " " + hit.bw + "x" + hit.bh);
        }
    }

    static Control Find(Control c, string id) {
        if (c.name == id) { return c; }
        for (int i = 0; i < c.children.Count; i = i + 1) {
            Control hit = Program.Find(c.children[i], id);
            if (hit != null) { return hit; }
        }
        return null;
    }
}
