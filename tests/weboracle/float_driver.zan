using Gui;

/// P3 oracle 驱动（float.json 的 Zan 侧）：树形与 JSON body 一致，
/// 输出与 selectors 同序的 `sel x,y wxh` 行，供
/// `python scripts/web_oracle.py tests/weboracle/float.json
///  --compare <本程序输出>` 逐盒对比。覆盖：左右 float 贴边/并排、
/// 放不下下坠、行盒整行绕排下坠、clear、BFC 收编。
class Program {
    static void Main() {
        App app = new App("oracle-float", 320, 400);
        app.UseCss(
            "* { box-sizing: border-box; }\n"
            + "body { margin: 0; font-family: \"Segoe UI\";"
            + " font-size: 14px; }\n"
            + "#wrap { width: 240px; padding: 1px; }\n"
            + "#f1 { float: left; width: 80px; height: 60px; }\n"
            + "#f2 { float: left; width: 80px; height: 40px; }\n"
            + "#f3 { float: left; width: 200px; height: 40px; }\n"
            + "#f4 { float: right; width: 60px; height: 40px; }\n"
            + "#words { font-size: 14px; }\n"
            + ".w { display: inline-block; width: 40px; height: 20px;"
            + " margin-right: 10px; }\n"
            + "#f5 { float: left; width: 100px; height: 50px; }\n"
            + "#clr2 { clear: both; height: 20px; }\n"
            + "#root2 { display: flow-root; }\n"
            + "#rf { float: left; width: 50px; height: 70px; }\n");

        Element bodyF = new Element();
        bodyF.InitElement("body", "body");
        Element wrap = new Element();
        wrap.InitElement("div", "wrap");
        Element f1 = new Element();
        f1.InitElement("div", "f1");
        Element f2 = new Element();
        f2.InitElement("div", "f2");
        Element f3 = new Element();
        f3.InitElement("div", "f3");
        Element f4 = new Element();
        f4.InitElement("div", "f4");
        Element words = new Element();
        words.InitElement("div", "words");
        Element w1 = new Element();
        w1.InitElement("span", "w1");
        w1.AddClass("w");
        Element w2 = new Element();
        w2.InitElement("span", "w2");
        w2.AddClass("w");
        Element w3 = new Element();
        w3.InitElement("span", "w3");
        w3.AddClass("w");
        Element w4 = new Element();
        w4.InitElement("span", "w4");
        w4.AddClass("w");
        Element w5 = new Element();
        w5.InitElement("span", "w5");
        w5.AddClass("w");
        Element w6 = new Element();
        w6.InitElement("span", "w6");
        w6.AddClass("w");
        Element cbox = new Element();
        cbox.InitElement("div", "cbox");
        Element f5 = new Element();
        f5.InitElement("div", "f5");
        Element clr2 = new Element();
        clr2.InitElement("div", "clr2");
        Element root2 = new Element();
        root2.InitElement("div", "root2");
        Element rf = new Element();
        rf.InitElement("div", "rf");
        words.Add(w1);
        words.Add(w2);
        words.Add(w3);
        words.Add(w4);
        words.Add(w5);
        words.Add(w6);
        cbox.Add(f5);
        cbox.Add(clr2);
        root2.Add(rf);
        wrap.Add(f1);
        wrap.Add(f2);
        wrap.Add(f3);
        wrap.Add(f4);
        wrap.Add(words);
        wrap.Add(cbox);
        wrap.Add(root2);
        bodyF.Add(wrap);

        // 单帧驱动没有"上一帧宽度"可收敛，按 P2 inline 驱动同款把
        // 断行宽直接钉给 wrap（Chrome 里块宽由样式表即刻可知）。
        wrap.HintWrapWidth(240);
        bodyF.MeasureTree(app);
        int escT = 0;
        StyleBox sbR = bodyF.computedStyle;
        if (sbR != null && sbR.display == 3 && !bodyF.FlowSepT()) {
            escT = bodyF.FlowMarT(bodyF);
            if (escT < 0) { escT = 0; }
        }
        bodyF.Arrange(0, escT, 320, 400);
        Console.WriteLine($"#wrap {wrap.bx},{wrap.by} {wrap.bw}x{wrap.bh}");
        Console.WriteLine($"#f1 {f1.bx},{f1.by} {f1.bw}x{f1.bh}");
        Console.WriteLine($"#f2 {f2.bx},{f2.by} {f2.bw}x{f2.bh}");
        Console.WriteLine($"#f3 {f3.bx},{f3.by} {f3.bw}x{f3.bh}");
        Console.WriteLine($"#f4 {f4.bx},{f4.by} {f4.bw}x{f4.bh}");
        Console.WriteLine($"#words {words.bx},{words.by} {words.bw}x{words.bh}");
        Console.WriteLine($"#w1 {w1.bx},{w1.by} {w1.bw}x{w1.bh}");
        Console.WriteLine($"#w2 {w2.bx},{w2.by} {w2.bw}x{w2.bh}");
        Console.WriteLine($"#w3 {w3.bx},{w3.by} {w3.bw}x{w3.bh}");
        Console.WriteLine($"#w4 {w4.bx},{w4.by} {w4.bw}x{w4.bh}");
        Console.WriteLine($"#w5 {w5.bx},{w5.by} {w5.bw}x{w5.bh}");
        Console.WriteLine($"#w6 {w6.bx},{w6.by} {w6.bw}x{w6.bh}");
        Console.WriteLine($"#cbox {cbox.bx},{cbox.by} {cbox.bw}x{cbox.bh}");
        Console.WriteLine($"#f5 {f5.bx},{f5.by} {f5.bw}x{f5.bh}");
        Console.WriteLine($"#clr2 {clr2.bx},{clr2.by} {clr2.bw}x{clr2.bh}");
        Console.WriteLine($"#root2 {root2.bx},{root2.by} {root2.bw}x{root2.bh}");
        Console.WriteLine($"#rf {rf.bx},{rf.by} {rf.bw}x{rf.bh}");
    }
}
