using Gui;

/// P1 oracle 驱动（collapse.json 的 Zan 侧）：树形与 JSON body 一致，
/// Arrange 前按 RenderInside 的视口模型落地根塌陷链，输出与
/// selectors 同序的 `sel x,y wxh` 行，供
/// 核心契约与语义定义。
///  --compare <本程序输出>` 逐盒对比。
class Program {
    static void Main() {
        App app = new App("oracle-collapse", 320, 280);
        app.UseCss(
            "* { box-sizing: border-box; }\n"
            + "#wrap { width: 200px; padding: 1px; }\n"
            + ".s1 { height: 30px; margin: 20px 0; }\n"
            + ".hole { height: 0px; margin: 15px 0; }\n"
            + ".s2 { height: 40px; margin-top: 10px; }\n"
            + ".center { width: 60px; height: 20px; margin: 0 auto; }\n"
            + ".push { width: 50px; height: 20px; margin-left: auto; }\n"
            + ".txt { line-height: 20px; }\n"
            + ".bfcbox { display: flow-root; }\n"
            + ".m { height: 0px; margin: 25px 0; }\n");

        Element wrap = new Element();
        wrap.InitElement("div", "wrap");
        Element s1 = new Element();
        s1.InitElement("div", "e1");
        s1.AddClass("s1");
        Element hole = new Element();
        hole.InitElement("div", "e2");
        hole.AddClass("hole");
        Element s2 = new Element();
        s2.InitElement("div", "e3");
        s2.AddClass("s2");
        Element center = new Element();
        center.InitElement("div", "e4");
        center.AddClass("center");
        Element push = new Element();
        push.InitElement("div", "e5");
        push.AddClass("push");
        Element txt = new Element();
        txt.InitElement("div", "e6");
        txt.AddClass("txt");
        txt.SetText("hi");
        Element bfcbox = new Element();
        bfcbox.InitElement("div", "e7");
        bfcbox.AddClass("bfcbox");
        Element m = new Element();
        m.InitElement("div", "e8");
        m.AddClass("m");
        bfcbox.Add(m);
        wrap.Add(s1);
        wrap.Add(hole);
        wrap.Add(s2);
        wrap.Add(center);
        wrap.Add(push);
        wrap.Add(txt);
        wrap.Add(bfcbox);

        wrap.MeasureTree(app);
        int escT = 0;
        StyleBox sbR = wrap.computedStyle;
        if (sbR != null && sbR.display == 3 && !wrap.FlowSepT()) {
            escT = wrap.FlowMarT(wrap);
            if (escT < 0) { escT = 0; }
        }
        wrap.Arrange(0, escT, 200, 400);
        Console.WriteLine($".s1 {s1.bx},{s1.by} {s1.bw}x{s1.bh}");
        Console.WriteLine($".hole {hole.bx},{hole.by} {hole.bw}x{hole.bh}");
        Console.WriteLine($".s2 {s2.bx},{s2.by} {s2.bw}x{s2.bh}");
        Console.WriteLine($".center {center.bx},{center.by} {center.bw}x{center.bh}");
        Console.WriteLine($".push {push.bx},{push.by} {push.bw}x{push.bh}");
        Console.WriteLine($".txt {txt.bx},{txt.by} {txt.bw}x{txt.bh}");
        Console.WriteLine($".bfcbox {bfcbox.bx},{bfcbox.by} {bfcbox.bw}x{bfcbox.bh}");
        Console.WriteLine($".m {m.bx},{m.by} {m.bw}x{m.bh}");
    }
}
