using Gui;

/// P4 oracle 驱动（grid.json 的 Zan 侧）：树形与 JSON body 一致，
/// 输出与 selectors 同序的 `sel x,y wxh` 行，供
/// `python scripts/web_oracle.py tests/weboracle/grid.json
///  --compare <本程序输出>` 逐盒对比。覆盖：px/1fr/minmax 轨道、
/// repeat 展开、显式+隐式行（grid-auto-rows）、gap 双轴、span 2、
/// grid-line 显式放置、auto 列的 stretch 均分。
class Program {
    static void Main() {
        App app = new App("oracle-grid", 360, 400);
        app.UseCss(
            "* { box-sizing: border-box; }\n"
            + "body { margin: 0; }\n"
            + "#page { width: 320px; }\n"
            + "#g1 { display: grid; width: 300px;"
            + " grid-template-columns: 100px 1fr;"
            + " grid-template-rows: 20px; grid-auto-rows: 30px;"
            + " gap: 10px; }\n"
            + "#a { width: 40px; height: 20px; }\n"
            + "#b { width: 40px; height: 20px; }\n"
            + "#g2 { display: grid; width: 320px;"
            + " grid-template-columns: repeat(3, 1fr);"
            + " grid-auto-rows: 25px; gap: 5px 10px; }\n"
            + "#g { grid-column: span 2; }\n"
            + "#g3 { display: grid; width: 260px;"
            + " grid-template-columns: minmax(60px, 1fr) 80px;"
            + " grid-template-rows: 20px; row-gap: 4px; }\n"
            + "#i { grid-column: 1; grid-row: 2; height: 20px; }\n"
            + "#j { height: 20px; }\n"
            + "#k { height: 20px; }\n"
            + "#l { grid-column: 2; grid-row: 2; height: 20px; }\n"
            + "#g4 { display: grid; width: 200px;"
            + " grid-template-columns: auto auto;"
            + " grid-auto-rows: 18px; }\n"
            + "#m { width: 40px; height: 18px; }\n"
            + "#n { width: 30px; height: 18px; }\n");

        Element page = new Element();
        page.InitElement("div", "page");
        Element g1 = new Element();
        g1.InitElement("div", "g1");
        Element a = new Element();
        a.InitElement("div", "a");
        Element b = new Element();
        b.InitElement("div", "b");
        Element c = new Element();
        c.InitElement("div", "c");
        Element g2 = new Element();
        g2.InitElement("div", "g2");
        Element d = new Element();
        d.InitElement("div", "d");
        Element e = new Element();
        e.InitElement("div", "e");
        Element f = new Element();
        f.InitElement("div", "f");
        Element g = new Element();
        g.InitElement("div", "g");
        Element h = new Element();
        h.InitElement("div", "h");
        Element g3 = new Element();
        g3.InitElement("div", "g3");
        Element i = new Element();
        i.InitElement("div", "i");
        Element j = new Element();
        j.InitElement("div", "j");
        Element k = new Element();
        k.InitElement("div", "k");
        Element l = new Element();
        l.InitElement("div", "l");
        Element g4 = new Element();
        g4.InitElement("div", "g4");
        Element m = new Element();
        m.InitElement("div", "m");
        Element n = new Element();
        n.InitElement("div", "n");
        g1.Add(a);
        g1.Add(b);
        g1.Add(c);
        g2.Add(d);
        g2.Add(e);
        g2.Add(f);
        g2.Add(g);
        g2.Add(h);
        g3.Add(i);
        g3.Add(j);
        g3.Add(k);
        g3.Add(l);
        g4.Add(m);
        g4.Add(n);
        page.Add(g1);
        page.Add(g2);
        page.Add(g3);
        page.Add(g4);

        page.HintWrapWidth(320);
        page.MeasureTree(app);
        page.Arrange(0, 0, 320, page.prefH);
        Console.WriteLine($"#page {page.bx},{page.by} {page.bw}x{page.bh}");
        Console.WriteLine($"#g1 {g1.bx},{g1.by} {g1.bw}x{g1.bh}");
        Console.WriteLine($"#a {a.bx},{a.by} {a.bw}x{a.bh}");
        Console.WriteLine($"#b {b.bx},{b.by} {b.bw}x{b.bh}");
        Console.WriteLine($"#c {c.bx},{c.by} {c.bw}x{c.bh}");
        Console.WriteLine($"#g2 {g2.bx},{g2.by} {g2.bw}x{g2.bh}");
        Console.WriteLine($"#d {d.bx},{d.by} {d.bw}x{d.bh}");
        Console.WriteLine($"#e {e.bx},{e.by} {e.bw}x{e.bh}");
        Console.WriteLine($"#f {f.bx},{f.by} {f.bw}x{f.bh}");
        Console.WriteLine($"#g {g.bx},{g.by} {g.bw}x{g.bh}");
        Console.WriteLine($"#h {h.bx},{h.by} {h.bw}x{h.bh}");
        Console.WriteLine($"#g3 {g3.bx},{g3.by} {g3.bw}x{g3.bh}");
        Console.WriteLine($"#i {i.bx},{i.by} {i.bw}x{i.bh}");
        Console.WriteLine($"#j {j.bx},{j.by} {j.bw}x{j.bh}");
        Console.WriteLine($"#k {k.bx},{k.by} {k.bw}x{k.bh}");
        Console.WriteLine($"#l {l.bx},{l.by} {l.bw}x{l.bh}");
        Console.WriteLine($"#g4 {g4.bx},{g4.by} {g4.bw}x{g4.bh}");
        Console.WriteLine($"#m {m.bx},{m.by} {m.bw}x{m.bh}");
        Console.WriteLine($"#n {n.bx},{n.by} {n.bw}x{n.bh}");
    }
}
