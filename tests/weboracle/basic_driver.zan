using Gui;

/// P0/P1 oracle 驱动（basic.json 的 Zan 侧）：树形与 JSON body 一致
/// （body 包裹两棵树），Arrange 前按 RenderInside 的视口模型落地根
/// 塌陷链（Chrome 里塌出 body 的链变成 html 外边距把内容推下来），
/// 输出与 selectors 同序的 `sel x,y wxh` 行，供
/// `python scripts/web_oracle.py tests/weboracle/basic.json
///  --compare <本程序输出>` 逐盒对比。
class Program {
    static void Main() {
        App app = new App("oracle-basic", 320, 280);
        app.UseCss(
            "* { box-sizing: border-box; }\n"
            + "body { margin: 0; }\n"
            + "#root { width: 200px; height: 150px; }\n"
            + ".a { width: 100%; height: 40px; margin: 10px 0; }\n"
            + ".b { width: 50px; height: 30px; margin-left: 20px; }\n"
            + ".c { border: 5px solid #000; padding: 10px;"
            + " width: 60px; height: 20px; }\n"
            + ".d { height: 25px; }\n"
            + "#ccroot { width: 300px; height: 60px; }\n"
            + ".ccbox { box-sizing: content-box; border: 5px solid #000;"
            + " padding: 10px; width: 60px; height: 20px; }\n");

        Element bodyF = new Element();
        bodyF.InitElement("body", "body");
        Element root = new Element();
        root.InitElement("div", "root");
        Element a = new Element();
        a.InitElement("div", "ea");
        a.AddClass("a");
        Element b = new Element();
        b.InitElement("div", "eb");
        b.AddClass("b");
        Element c = new Element();
        c.InitElement("div", "ec");
        c.AddClass("c");
        Element d = new Element();
        d.InitElement("div", "ed");
        d.AddClass("d");
        root.Add(a);
        root.Add(b);
        root.Add(c);
        root.Add(d);
        Element ccroot = new Element();
        ccroot.InitElement("div", "ccroot");
        Element ccbox = new Element();
        ccbox.InitElement("div", "ecc");
        ccbox.AddClass("ccbox");
        ccroot.Add(ccbox);
        bodyF.Add(root);
        bodyF.Add(ccroot);

        bodyF.MeasureTree(app);
        int escT = 0;
        StyleBox sbR = bodyF.computedStyle;
        if (sbR != null && sbR.display == 3 && !bodyF.FlowSepT()) {
            escT = bodyF.FlowMarT(bodyF);
            if (escT < 0) { escT = 0; }
        }
        bodyF.Arrange(0, escT, 320, 400);
        Console.WriteLine($"#root {root.bx},{root.by} {root.bw}x{root.bh}");
        Console.WriteLine($".a {a.bx},{a.by} {a.bw}x{a.bh}");
        Console.WriteLine($".b {b.bx},{b.by} {b.bw}x{b.bh}");
        Console.WriteLine($".c {c.bx},{c.by} {c.bw}x{c.bh}");
        Console.WriteLine($".d {d.bx},{d.by} {d.bw}x{d.bh}");
        Console.WriteLine($"#ccroot {ccroot.bx},{ccroot.by} {ccroot.bw}x{ccroot.bh}");
        Console.WriteLine($".ccbox {ccbox.bx},{ccbox.by} {ccbox.bw}x{ccbox.bh}");
    }
}
