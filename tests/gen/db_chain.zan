// 接口数据协议与执行契约。
// 核心契约与语义定义。
// 接口数据协议与执行契约。
using System;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.IO;

[Table(Name = "t_ord")]
class Order {
    [Column(IsIdentity = true)]
    long id;
    string region;
    long amount;
    string note;
}

class Ctx {
    SqliteConnection db;

    static Ctx Open(string path) {
        Ctx c = new Ctx();
        c.db = SqliteConnection.Open(path);
        c.db.Execute("CREATE TABLE t_ord (id INTEGER PRIMARY KEY, region TEXT, amount INTEGER, note TEXT)");
        c.db.Execute("INSERT INTO t_ord VALUES (1, 'EA', 10, 'a'), (2, 'WE', 20, 'b'), (3, 'EA', 300, 'c')");
        return c;
    }

    SqliteConnection __Conn() { return this.db; }
}

class Program {
    static void Main() {
        string path = "gen_db_chain.tmp.db";
        File.Delete(path);
        Ctx ctx = Ctx.Open(path);
        SqliteConnection db = ctx.db;

        // 接口数据协议与执行契约。
        long sum = db.Select<Order>().Where(o => o.amount > 15).Sum(o => o.amount);
        Console.WriteLine("sum: " + Convert.ToString(sum));

        // 接口数据协议与执行契约。
        DbValues patch = new DbValues().Set("region", "WW");
        int upd = db.Update<Order>().SetDict(patch).Where(a => a.id == 1).ExecuteAffrows();
        Console.WriteLine("upd: " + Convert.ToString(upd));

        // 接口数据协议与执行契约。
        int cnt = ctx.Order.Where(o => o.region.Eq("EA")).Count();
        Console.WriteLine("cnt: " + Convert.ToString(cnt));

        db.Close();
        File.Delete(path);
    }
}
