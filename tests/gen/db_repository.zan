// Generator regression: an entity accessor's domain method must dispatch to
// the hand-written <Entity>Dao while preserving the receiver connection.
using System;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.IO;

[Table(Name = "t_repo_user")]
class User {
    [Column(IsIdentity = true)]
    int id;
    string name;
}

class UserDao {
    IDbConnection db;

    UserDao(IDbConnection db) {
        this.db = db;
    }

    async User ById(int id) {
        return await this.db.Select<User>()
            .Where(a => a.id == id)
            .FirstAsync();
    }
}

class RepoCtx {
    SqliteConnection db;

    static RepoCtx Open(string path) {
        RepoCtx c = new RepoCtx();
        c.db = SqliteConnection.Open(path);
        c.db.Execute("CREATE TABLE t_repo_user (id INTEGER PRIMARY KEY, name TEXT)");
        c.db.Execute("INSERT INTO t_repo_user VALUES (1, 'alice')");
        return c;
    }

    SqliteConnection __Conn() { return this.db; }
}

class Program {
    static async void Main() {
        string path = "gen_db_repository.tmp.db";
        File.Delete(path);
        RepoCtx ctx = RepoCtx.Open(path);
        User u = await ctx.User.ById(1);
        Console.WriteLine(u == null ? "missing" : u.name);
        ctx.db.Close();
        File.Delete(path);
    }
}
