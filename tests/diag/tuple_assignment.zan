// Regression (B3): assigning to a tuple literal has no lowering — the write
// would land in a discarded temp. It must be a compile error that points at
// deconstruction instead of silently dropping the assignment.
using System;

class Program {
    static void Main() {
        int a = 1;
        int b = 2;
        (a, b) = (10, 20);
        Console.WriteLine(a + b);
    }
}
