// `internal` draws the module line at the first two namespace segments
// ("Acc.Inner" -> module "Acc.Inner" here): the helper file declares Core
// with an internal member, this file lives in a sibling namespace and tries
// to call it. Same-module callers keep access; this cross-module caller
// must be rejected.
using Acc.Inner;

namespace Acc.Other;

class Abuser {
    static int Steal() { return Core.Tag(); }
}

class Program {
    static void Main() {
    }
}
