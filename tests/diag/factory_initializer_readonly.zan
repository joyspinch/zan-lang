// Regression (A89): the same factory-continuation initializer must reject a
// write to a getter-only property, the way `new T { Prop = v }` already does.
class Maker {
    public int tag;
    public int ReadOnly { get; }
    static Maker New() { return new Maker(); }
}

class Program {
    static void Main() {
        Maker a = Maker.New() { ReadOnly = 1 };
        Console.WriteLine(a.tag);
    }
}
