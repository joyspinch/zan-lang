using System;

// A449：显式装箱值类型到 object。
//
// 缺陷：checker 对「强转到 object」无条件放行，irgen 于是把整数值直接
// IntToPtr 成对象指针——程序当场 access violation（0xC0000005），连一行
// 打印都做不到，退出时 ARC 还要再回收一次这个假对象。
// Zan 没有装箱设施：值类型装不进 object，编译期就该拦下来。
public class Probe {
    public static void Main() {
        int v = 42;
        object boxed = (object)v;
        Console.WriteLine("unreachable");
    }
}
