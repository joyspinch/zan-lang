// `string[] a = s.Split(",")` used to compile silently. A call on a built-in
// receiver (string/List/Dictionary/StringBuilder) has no symbol, so the checker
// typed the whole call TYPE_ERROR -- which every assignability rule accepts.
// irgen then keyed correctly off the expression's real type (List) and stored
// the List pointer into an array slot, so `.Length` read the List's own
// allocation header and element reads dereferenced a List struct as a buffer.
// Split is documented as returning List<string>; the array target must be an
// error at the source instead of a heap corruption at run time.
using System;

class SplitIntoArray {
    static void Main() {
        string[] ks = "a,b,c".Split(",");
        Console.WriteLine(Convert.ToString(ks.Length));
    }
}
