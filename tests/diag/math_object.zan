using System;

// Math.* 的实参必须是数值。类实例不是数值：编译器此前把对象指针直接
// 喂给 sitofp（指针转 double），生成 LLVM 校验失败的非法 IR
// （"LLVM verification failed"），而且错误信息对用户毫无意义。
class Box {
    string text;
    int n;
}

class Program {
    static void Main() {
        Box b = new Box();
        b.text = "hello";
        b.n = 42;
        double r = Math.Sqrt(b);
        Console.WriteLine(r);
    }
}
