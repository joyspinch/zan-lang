using System;

namespace DiagEnumMember;

/// Accessing a member that a enum type does not declare used to compile
/// silently: irgen folded the access to the constant 0, masking stale
/// references after a member was removed or renamed. It must be a compile
/// error, matching C# semantics.
enum Kind {
    A, B
}

class Program {
    static void Main() {
        Kind k = Kind.NoSuchMember;
        Console.WriteLine(Convert.ToString((int)k));
    }
}
