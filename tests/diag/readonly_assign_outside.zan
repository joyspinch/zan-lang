// Same rule seen through a receiver whose type is only known once locals are
// typed: `c.total = 6` from another type must not compile.
using System;

class Counter {
    public readonly int total;
    public Counter(int v) { total = v; }
}

class Program {
    static void Main() {
        Counter c = new Counter(1);
        c.total = 6;
        Console.WriteLine(Convert.ToString(c.total));
    }
}
