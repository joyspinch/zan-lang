// A missing static factory at the head of a method chain must be a compile
// error: the outer call resolves nothing, so it never emitted its receiver and
// the chain silently lowered to a constant that crashed at runtime.
using System;

namespace Diag;

class Fluent {
    int n;
    Fluent More() { this.n = this.n + 1; return this; }
    int Value() { return this.n; }
}

class Program {
    static void Main() {
        Fluent f = Fluent.Create().More();
        Console.WriteLine(Convert.ToString(f.Value()));
    }
}
