using System;

// 本文件没有导入 Shapes.One / Shapes.Two，但同一次编译里的其它文件导入
// 了它们。裸名 Badge 在两个命名空间都存在，必须报"解析不了"，而不是悄悄
// 绑到其中一个——修复前编译器把全工程的 using 合并进同一个 compilation
// unit，本文件会继承别的文件的导入（A438）。
class Program {
    static int Main() {
        Console.WriteLine(Badge.Level().ToString());
        return 0;
    }
}
