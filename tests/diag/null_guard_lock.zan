// Compile one variant at a time with -D<case>. A lock must neither hide a
// nullable return nor let a later guard excuse an earlier member access.
class Cfg {
    public string Name;
}

class Store {
    Cfg Find() { return null; }

    Cfg FindLocked(object sync) {
        lock (sync) { return null; }
    }
}

class Program {
    static void Main() {
        Store wire = new Store();
        object sync = new object();
#if unguarded
        lock (sync) {
            Cfg id = wire.Find();
            string name = id.Name;
        }
#endif
#if after_use
        lock (sync) {
            Cfg id = wire.Find();
            string name = id.Name;
            if (id == null) { return; }
        }
#endif
#if later_body
        Cfg id = wire.Find();
        string name = id.Name;
        lock (sync) {
            if (id == null) { return; }
        }
#endif
#if later_header
        Cfg id = wire.Find();
        string name = id.Name;
        lock (id != null ? sync : new object()) { }
#endif
#if locked_result
        Cfg id = wire.FindLocked(sync);
        string name = id.Name;
#endif
#if locked_direct
        string name = wire.FindLocked(sync).Name;
#endif
    }
}
