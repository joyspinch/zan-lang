using System;

class Base {
    virtual async void Tick() { }
}

class Derived : Base {
    /* virtual 在派生类里是新开槽位（隐藏基类实现），不是覆盖：经基类静态
       类型引用的派发永远落在基类槽位，这里的实现不会执行。曾经这个形状
       让框架清理钩子（归还连接池租约）静默失效、站点假死。--deny-warnings
       下此声明必须触发 "hides an inherited virtual" 并使编译失败。 */
    virtual async void Tick() { }
}

class Program {
    static void Main() {
        Base h = new Derived();
        Console.WriteLine("never reached");
    }
}
