using System;

// ref/out 实参宽度（E3106，P3）：引用传递不发生转换——int 变量传
// ref long 形参按 8 字节槽写 4 字节局部（邻接内存静默受损）；普通值
// 收 ref 形参同样静默跑错（实参发射期望地址形态）。两种形态都必须
// 编译期拒绝。
class RefOutWidthMismatch {
    static void TakeRef(ref long v) { v = v + 1; }
    static void TakeOut(out int v) { v = 42; }

    static void Main() {
        int narrow = 7;
        TakeRef(ref narrow);
        long wide = 3;
        TakeOut(out wide);
        long l = 3;
        TakeRef(l);
    }
}
