// Regression: a static field reached through a value receiver used to lower to
// the constant 0, so `h.other == null` compared an int against a pointer --
// invalid IR that sent LLVM's constant folder into unbounded recursion (zanc
// segfault), and in the cases that did compile it dereferenced the zero.
namespace Diag;

class Holder {
    static Holder other;
    int inst;
    Holder() { inst = 1; }
    static Holder Make() { Holder h = new Holder(); Holder.other = h; return h; }
}

class Program {
    static void Main() {
        Holder h = Holder.Make();
        Console.WriteLine(Convert.ToString(h.other == null));
    }
}
