// 核心契约与语义定义。
namespace Diag;

class Holder {
    static Holder other;
    int inst;
    Holder() { inst = 1; }
    static Holder Make() { Holder h = new Holder(); Holder.other = h; return h; }
}

class Program {
    static void Main() {
        Holder h = Holder.Make();
        Console.WriteLine(Convert.ToString(h.other == null));
    }
}
