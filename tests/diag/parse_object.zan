using System;

// 文本解析型内建（int.Parse / double.Parse / long.Parse ...）只接受字符串。
// 传类实例此前会拿对象的字节当文本解析，静默得到 0 或垃圾值。
class Box {
    string text;
    int n;
}

class Program {
    static void Main() {
        Box b = new Box();
        b.text = "hello";
        b.n = 42;
        int r = int.Parse(b);
        Console.WriteLine(r);
    }
}
