using System;

class SelectedReceiver {
    public int Read(int value) { return value; }
    public static int Read(string value) { return 0; }
    public static int StaticOnly(int value) { return value; }
    public static void Main() {
        Func<int, int> typeNeedsInstance = SelectedReceiver.Read;
