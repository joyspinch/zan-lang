// A382③：#pragma warning disable/restore 区间抑制。
// disable 0003 之后 #warning 被静默；restore 0003 之后恢复打印；
// 恢复后仍然存在的告警 + 末尾语法错误让编译失败，供 run_compile_error 断言。
#pragma warning disable 0003
#warning this one is silenced
#pragma warning restore 0003
#warning this one must show up
class P {
    static int Main() {
        return 0
    }
}
