using System;

// TryParse 家族与 Parse 一样只接受字符串；传类实例此前静默失败。
class Box {
    string text;
    int n;
}

class Program {
    static void Main() {
        Box b = new Box();
        b.text = "hello";
        b.n = 42;
        int r = 0;
        bool ok = int.TryParse(b, out r);
        Console.WriteLine(ok);
    }
}
