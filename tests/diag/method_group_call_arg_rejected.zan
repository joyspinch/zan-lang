// 方法组当非委托重载实参（B-ID151）：重载解析无委托候选时必须报 E2039，
// 绝不能退回第一个同名方法把裸函数指针当值实参传下去（曾导致运行期乱码）。
using System;

class Counter {
    int n;
    public int Value() { return this.n; }
}

class MgCallArg {
    static void Main() {
        Counter c = new Counter();
        string s = Convert.ToString(c.Value);
    }
}
