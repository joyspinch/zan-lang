// wasm32 has no C ABI classification for aggregates crossing an extern
// boundary. Declaring one is fine (stdlib SIMD headers get pulled into
// compiles that never call them); a real CALL must be rejected instead of
// silently lowering through the wrong ABI.
struct V {
    public long A;
    public long B;
}
class WasmStructExternCall {
    [DllImport("crt")]
    static extern V Load(nint p);
    static int Main() {
        V v = Load(0);
        return v.A;
    }
}
