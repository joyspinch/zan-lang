// An async method's result crosses the coroutine frame's
// fixed 64-bit result slot, whose encoding covers scalars and pointers only.
// A struct return used to be reduced to 0 on the way in and reinterpreted as
// an i64 on the way out, so every field read back as 0/garbage with no
// diagnostic. The declaration must be rejected instead.
struct Pt {
    public int X;
    public int Y;
}

class AsyncAggregateReturn {
    static async Pt MakeAsync() {
        Pt p;
        p.X = 34;
        p.Y = 7;
        return p;
    }

    static void Main() {
        Pt p = await MakeAsync();
        System.Console.WriteLine(p.X);
    }
}
