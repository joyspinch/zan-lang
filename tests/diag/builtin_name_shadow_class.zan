// A551: 用户类型与内建类型名同名（Dict/List/Span/Task/基础类型等在
// resolve_type 里硬编码短路）会被静默顶掉——成员解析落空后报的是
// "has no member"，把人引向完全无关的方向。必须在声明处直接报重名。
class Dict<K, V> {
    K k;
    public Dict(K kk) { k = kk; }
    public K GetK() { return k; }
}

class Program {
    static void Main() {
        Dict<string, int> d = new Dict<string, int>("k");
        Console.WriteLine(d.GetK());
    }
}
