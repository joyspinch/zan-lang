class RenderTheme {
    int accent;
    RenderTheme(int a) { this.accent = a; }
}

class RenderApp {
    int frames;
    RenderApp(int f) { this.frames = f; }
}

class UnrelatedArgumentType {
    static void Paint(RenderApp app) { }

    static void Main() {
        RenderTheme theme = new RenderTheme(1);
        UnrelatedArgumentType.Paint(theme);
    }
}
