using System;

/// Regression (audit H8): `new int[2] { 1, 2, 3 }` writes every initializer
/// element sequentially with no runtime bound, so an element count that does
/// not match the dimension product overflows the allocation. It must be a
/// compile error, not a heap overwrite in the built program.
class Program {
    static void Main() {
        int[] a = new int[2] { 1, 2, 3 };
        Console.WriteLine(a.Length);
    }
}
