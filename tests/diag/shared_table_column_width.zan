// A shared table's schema is fixed when the mapping is created, so a column
// wider than the runtime can represent is a declaration that cannot be
// honoured: it must fail here rather than at the Create() nobody checks.
using System.Threading;

class Program {
    static void Main() {
        SharedTable t = new SharedTable("zan_diag_shared_table", 16);
        t.ColumnString("acts", 131072);
        Console.WriteLine(t.Create());
    }
}
