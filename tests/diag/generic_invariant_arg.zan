// D6 negative regression: generic type arguments are invariant. A method
// taking List<Box> must reject a List<int> argument at compile time — both
// erase to the same object pointer in IR, so the old behaviour let the bare
// ints be dereferenced as Box* at run time (the A45 crash). Same-class
// containers with different concrete type arguments are a compile error.
class Box { int x; }
class P {
    static void Take(List<Box> b) { }
    static void Main() {
        List<int> v = new List<int>();
        v.Add(1);
        P.Take(v);
    }
}
