// Regression: a name may denote storage or code, never both. The .zform
// generated partial of a design declared `static Panel PresetRow;` while the
// hand-written partial declared `static Control PresetRow(AiPreset)`; the
// method silently lost to the field, so `Class.PresetRow` used as a delegate
// loaded the Panel and calling it jumped into the heap (0xC0000005, execute).
namespace Diag;

partial class Design {
    static int Row;
}

partial class Design {
    static int Row() { return 1; }

    static void Main() {
        Console.WriteLine(Convert.ToString(Design.Row()));
    }
}
