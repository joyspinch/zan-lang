using System;

// --deny-warnings must reject all four assignments with E2009 and the
// existing "closure captures 'this' while assigned to a member" message.
class MethodGroupThisCycle {
    Action Callback;

    void Handle() { }

    void Setup() {
        this.Callback = this.Handle;
        Callback = Handle;
        this.Callback = Handle;
        Callback = this.Handle;
    }
}

class MethodGroupThisCycleTest {
    static void Main() { }
}
