using System;

// 把 Binding<T> 字段当 T 比较：单侧 Binding 的 ==/!= 会落到 object==object
// 的引用比较，恒为 false（live 绑定每次取值都是新对象语义）。必须在类型
// 检查阶段拒绝并指引 .Get()，不许静默给出恒 false 的结果（A543）。
class Model {
    public string name;
}

class Program {
    static void Main() {
        Model m = new Model();
        m.name = "冰冰";
        Binding<string> b = m.name;
        if (b == "冰冰") { Console.WriteLine("never"); }
        if (b != "冰冰") { Console.WriteLine("always"); }
    }
}
