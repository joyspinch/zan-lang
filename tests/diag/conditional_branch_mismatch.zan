// D1 negative regression: the checker typed `cond ? new A() : 123` as the
// then branch alone, and irgen then failed with a sourceless LLVM
// verification error ("PHI node operands are not the same type as the
// result!") when the ternary PHI merged an object pointer with an integer.
// A conditional whose branches share no common type (identical, implicitly
// convertible, or a common base class) must be a compile error naming the
// expression's source location.
class A {}
class P {
    static void Main() {
        bool b = true;
        A x = b ? new A() : 123;
        Console.WriteLine(x == null);
    }
}
