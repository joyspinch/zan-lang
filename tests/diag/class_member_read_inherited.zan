// Companion to class_member_read.zan: the lookup walks the base chain, so a
// member declared on a base class must still read clean, and only a name that
// exists nowhere in the chain is an error.
class Node {
    int id;
}

class Leaf : Node {
    string label;
}

class Program {
    static void Main() {
        Leaf leaf = new Leaf();
        leaf.id = 7;
        leaf.label = "leaf";
        Console.WriteLine(leaf.id);
        Console.WriteLine(leaf.depth);
    }
}
