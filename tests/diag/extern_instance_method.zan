using System;
using System.Runtime.InteropServices;

namespace DiagExternInstance;

/// An instance `extern` method (missing `static`) used to pass the checker and
/// die inside LLVM verification ("Incorrect number of arguments passed to
/// called function") with no usable diagnostic. The checker now rejects it at
/// the declaration: a native function has no receiver.
class Native {
    [DllImport("crt")]
    extern long strlen(string s);
}

class Program {
    static void Main() {
        Native n = new Native();
        Console.WriteLine(Convert.ToString(n.strlen("hi")));
    }
}
