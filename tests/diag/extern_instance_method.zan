using System;
using System.Runtime.InteropServices;

namespace DiagExternInstance;

// 核心契约与语义定义。
class Native {
    [DllImport("crt")]
    extern long strlen(string s);
}

class Program {
    static void Main() {
        Native n = new Native();
        Console.WriteLine(Convert.ToString(n.strlen("hi")));
    }
}
