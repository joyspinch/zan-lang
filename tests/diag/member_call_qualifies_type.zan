// Call-position face of the same trap: the checker stays silent for a
// member-access callee (in_call_callee), so a bare identifier that fell
// through to a unique imported type is diagnosed by irgen -- which used to
// print the simple name only. The qualified type is the tell that the
// receiver resolved to the imported class, not to a form field.
using Shapes;

namespace App {
    class Program {
        static void Main() {
            Menu.Show();
        }
    }
}
