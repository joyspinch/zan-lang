using System;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.IO;

/// A numeric column compared to a string literal must fail at compile time.
/// dbgen used to lower `p.num == "abc"` to a bound string parameter, silently
/// comparing the int column as text at runtime instead of rejecting the query.
[Table(Name = "t_ty")]
class TyRow {
    [Column(IsIdentity = true)]
    int id;
    [Column(Name = "name", StringLength = 32)]
    string name;
    int num;
    double ratio;
}

class Program {
    static void Main() {
        string path = "diag_orm_int_string.tmp.db";
        File.Delete(path);
        SqliteConnection db = SqliteConnection.Open(path);
        db.SyncStructure<TyRow>();
        Console.WriteLine(Convert.ToString(
            db.Select<TyRow>().Where(t => t.num == "abc").Count()));
        db.Close();
        File.Delete(path);
    }
}
