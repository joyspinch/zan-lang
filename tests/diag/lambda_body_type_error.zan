// lambda 体里的类型错误必须被类型检查抓到。
//
// 改前：`AST_LAMBDA` 分支把 lambda 体当**表达式**交给 `check_expr`，而块体
// lambda 的体是语句块（`AST_BLOCK`）→ `check_expr` 的 `default:` 分支直接
// 返回，**整块 lambda 体的语句从来没进过类型检查**。于是
// `int x = "hello"` 编译期一个字都不说，运行期把字符串指针当 int 读出来
// （实测返回 -1065074624）。
using System;

class Program {
    public delegate int Fn();

    static void Main() {
        Fn f = () => {
            int x = "hello";
            return x;
        };
        Console.WriteLine("f=" + Convert.ToString(f()));
    }
}
