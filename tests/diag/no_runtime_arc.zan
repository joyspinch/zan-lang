// 核心契约与语义定义。
// 核心契约与执行状态转移规范。

class Program {
    static string Managed(string a, string b) {
        string x = a;
        string y = b;
        x = y;
        return x;
    }

    [NoRuntime]
    static string Bare(string a, string b) {
        string x = a;
        string y = b;
        x = y;
        return x;
    }

    static void Main() {
    }
}
