// Two identical string-shuffling bodies: one managed, one [NoRuntime]. The
// managed one must retain/release; the [NoRuntime] one must contain no ARC
// call at all, because the runtime it would call may not exist where such a
// method runs.

class Program {
    static string Managed(string a, string b) {
        string x = a;
        string y = b;
        x = y;
        return x;
    }

    [NoRuntime]
    static string Bare(string a, string b) {
        string x = a;
        string y = b;
        x = y;
        return x;
    }

    static void Main() {
    }
}
