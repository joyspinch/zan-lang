
class Program {
    static string Managed(string a, string b) {
        string x = a;
        string y = b;
        x = y;
        return x;
    }

    [NoRuntime]
    static string Bare(string a, string b) {
        string x = a;
        string y = b;
        x = y;
        return x;
    }

    static void Main() {
    }
}
