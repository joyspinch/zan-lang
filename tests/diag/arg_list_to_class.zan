// A generic container (List<Cat>) passed to a value parameter (Cat) used to
// compile silently: checker_arg_type_mismatch skipped every type with a type
// argument, irgen only re-checks same-container variance, and the runtime
// stored the List pointer in a ChartSeries slot -- a null/AV crash at first
// use (the gallery's funnel_pair demo `ChartOption.Single(fd)` crash).
using System;

class Cat {
    int legs;
    Cat(int l) { legs = l; }
    int Legs() { return legs; }
}

class Box {
    static int Count(Cat c) { return c.Legs(); }
    static void Main() {
        List<Cat> list = new List<Cat>();
        list.Add(new Cat(7));
        Console.WriteLine(Convert.ToString(Box.Count(list)));
    }
}
