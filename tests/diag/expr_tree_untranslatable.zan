// B-ID65 fail-closed 负向钉：树 lambda 捕获外层局部变量不可译，
// 必须在编译期报 E3103——静默降级会把 ORM 谓词悄悄变成无条件
// 全表扫（旧访问者对未知形状落 `1=1`），这是本钉要堵的审计洞。
using System;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.Linq;

[Table("diag_et_users")]
class De {
    [Column(IsIdentity = true)]
    public int id;

    public int age;
}

class Program {
    static void Main() {
        SqliteConnection db = SqliteConnection.Open("_scratch/diag_expr_tree.db");
        int limit = 18;
        int n = db.Select<De>().Where((ExprNode x) => x.age > limit).Count();
        Console.WriteLine(Convert.ToString(n));
        db.Close();
    }
}
