// A463: a member access on a nullable must name the nullable -- the whole
// point of the diagnostic is "this is `bool?`, not `bool`", so dropping the
// '?' turns the message into a statement about a type the user never wrote.
using System;

class Program {
    static void Main() {
        bool? b = null;
        int v = b.ToString();
        Console.WriteLine(v);
    }
}
