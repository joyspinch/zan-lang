using System;

/// Regression (audit H4): a named argument that lands past a defaulted
/// parameter used to punch a NULL into the call's rewritten argument list --
/// zanc itself crashed with zero diagnostics, and the params-array variant
/// silently produced a binary that dereferenced NULL at runtime. The
/// rebind must be rejected with a diagnostic instead of corrupting the AST.
class Util {
    static void Mix(int a, int b = 2, string s = "y") {
        Console.WriteLine("a={0} b={1} s={2}", a, b, s);
    }

    static void Main() {
        Mix(b: 7);
    }
}
