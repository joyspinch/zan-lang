// A463: the diagnostic must name the type the user actually wrote.
// `int?` is not `int` -- saying 'int' sends the reader to the wrong line.
// The host renders the type's shape (`T?` / `T[]` / `List<T>`) in every
// diagnostic, so the name in the message is the name in the source.
using System;

class Program {
    static void Main() {
        int? n = 5;
        int x = n;
        Console.WriteLine(x);
    }
}
