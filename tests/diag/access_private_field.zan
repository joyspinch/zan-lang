namespace Access;

class Vault {
    private int secret = 42;

    int Reveal() { return this.secret; }   // in-type access stays legal
}

class Program {
    static void Main() {
        Vault v = new Vault();
        Console.WriteLine(Convert.ToString(v.secret));
    }
}
