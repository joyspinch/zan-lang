// Access control (audit follow-up): `private` used to be parsed, stored in
// metadata and then ignored by the checker, so a field marked private was as
// reachable as a public one. A private member may only be touched from the
// declaring type's own bodies.
namespace Access;

class Vault {
    private int secret = 42;

    int Reveal() { return this.secret; }   // in-type access stays legal
}

class Program {
    static void Main() {
        Vault v = new Vault();
        Console.WriteLine(Convert.ToString(v.secret));
    }
}
