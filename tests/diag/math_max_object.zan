using System;

// Math.Max/Min 是双参特判，必须逐个参数判类型：一个类实例 + 一个整数
// 此前会一路混过去，把对象指针送进数值比较分支。
class Box {
    string text;
    int n;
}

class Program {
    static void Main() {
        Box b = new Box();
        b.text = "hello";
        b.n = 42;
        int r = Math.Max(b, 1);
        Console.WriteLine(r);
    }
}
