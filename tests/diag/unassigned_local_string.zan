class Program {
    static void Main() {
        string plain;
        Console.WriteLine(Convert.ToString(plain == ""));

        for (int i = 0; i < 2; i = i + 1) {
            string inLoop;
            if (i == 1) { inLoop = "second"; }
            Console.WriteLine(Convert.ToString(i) + "[" + inLoop + "]");
        }

        string joined;
        joined = joined + "tail";
        Console.WriteLine(joined);
    }
}
