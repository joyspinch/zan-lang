// A declared-but-unassigned string local used to be readable: the slot starts
// empty (irgen still initialises it that way, so a stray read can never
// dereference null), but reading a variable no path has written is a bug the
// compiler now names instead of papering over -- including inside a loop body,
// where the assignment happens on some iterations only.
class Program {
    static void Main() {
        string plain;
        Console.WriteLine(Convert.ToString(plain == ""));

        for (int i = 0; i < 2; i = i + 1) {
            string inLoop;
            if (i == 1) { inLoop = "second"; }
            Console.WriteLine(Convert.ToString(i) + "[" + inLoop + "]");
        }

        string joined;
        joined = joined + "tail";
        Console.WriteLine(joined);
    }
}
