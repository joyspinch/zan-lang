using System;

// `int F() { return S(); }` with `static string S()` is a type error. The
// checker used to type every uniquely-resolved member call as type_error, so
// the return never got checked, compiled clean, and irgen truncated the 64-bit
// string pointer into the i32 return slot (the Switch demo's segfault). The
// call result is now typed by the declared return type, so this must be
// rejected at the return statement.
class Program {
    static string Name() { return "on"; }

    static int Broken() {
        return Program.Name();
    }

    static void Main() {
    }
}
