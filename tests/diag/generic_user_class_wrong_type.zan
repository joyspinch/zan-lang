using System;
using System.Collections.Generic;

// 用户定义的泛型类，形参类型也要按**类型实参**替换后检查。
//
// 此前 `Box<T>.Set(T v)` 的形参类型是类型参数 T，而 checker 对
// "含类型参数的形参"一律放行——于是 `Box<int>.Set("字符串")` 编译通过。
//
// 根因在 call_arg_signature：它看到接收者的 type_arg_count 非零就直接
// 返回 NULL（怕泛型形参 T 匹配不上），整条实参类型检查被跳过。
class Box<T> {
    public T value;
    public void Set(T v) { this.value = v; }
}

class Program {
    static void Main() {
        Box<int> b = new Box<int>();
        b.Set(42);
        b.Set("这不是 int");
        Console.WriteLine(b.value);
    }
}
