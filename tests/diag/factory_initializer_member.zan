// Regression (A89): an object initializer continued from a factory call
// (`Maker.New() { ... }`) names its members without a receiver scope, so the
// checker must resolve them against the call's result type exactly like the
// `new T { ... }` shape. Before the fix every entry was dropped on the floor:
// an unknown member compiled clean and a getter-only property was silently
// ignored instead of "has no setter".
class Maker {
    public int tag;
    public int ReadOnly { get; }
    static Maker New() { return new Maker(); }
}

class Program {
    static void Main() {
        Maker a = Maker.New() { nosuch = 1 };
        Console.WriteLine(a.tag);
    }
}
