// An `init` accessor (`{ get; init; }`) is a setter that may only run while
// the object is being initialized: from an object initializer or a
// constructor of the declaring type. A plain write after construction must be
// a compile error, not a silent store into the backing slot.
class Point {
    public int X { get; init; }
}
class Program {
    static void Main() {
        Point p = new Point { X = 5 };
        p.X = 9;
        Console.WriteLine(p.X);
    }
}
