// S20（docs/ZAN_STANDARD.md §5）：窗体标记参与编译——TypoForm.html 里写错的处理器名
// （E2112）、绑定路径（E2113，含下钻到用户类的第二段）与挂载字段（E2114）在编译期
// 报在 .html 的属性值上，带拼写最近成员的补丁。夹具里同时放了不该报的写法：
// 注释里的属性、路由动作、带参调用、模板行内绑定、非标识符路径、
// 以字符串登记的处理器、非窗体类的同名标记、自定义 ViewModel 的子窗绑定。
using System;
using Gui;

public class Address { public string city = ""; }

partial class TypoForm : Form {
    string user = "";
    bool showError = false;
    Address addr = new Address();
    Control slot;
    void OnLogin() { }
    void OnReset(string arg) { }
    // 以名字登记的处理器（binder.Handle(ReloadHandler, ...)）：运行期 AutoWire 先认它
    const string ReloadHandler = "Reload";
    public static void Main() { Console.WriteLine("ok"); }
}

// 不是窗体：同名标记不按窗体检查
class PlainView : Control { }

// 子窗自定义了 ViewModel()：bind 的模型不是窗体本身，路径不查（处理器仍查）
class PanelWindow : ChildWindow {
    object model = null;
    protected override object ViewModel() { return this.model; }
    void OnOk() { }
}
