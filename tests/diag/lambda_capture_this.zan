// A33-1: a lambda that references `this` must be a compile error, not a
// silent crash. Lambdas are non-capturing; `this` used to lower to null and
// crashed on the first field access (0xC0000005).
delegate void Action();
class Widget {
    public int count;
    public Action Make() {
        return () => { this.count = 1; };
    }
}
