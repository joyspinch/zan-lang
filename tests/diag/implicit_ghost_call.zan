// A43-A15: an unqualified (implicit-this) call to a member that does not
// exist anywhere in the class chain used to fall through every resolution
// path and silently lower to an empty/zero result -- the QueryBuilder
// BuildSelect incident, where every generated SELECT came back "".
namespace Diag;
class Ghost {
    string UseIt() {
        return MissingHelper("a", true);
    }
}
