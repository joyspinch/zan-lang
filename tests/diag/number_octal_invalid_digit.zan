// `0o8` used to lex as octal `0` followed by decimal `8`, leaving the parser
// to report a meaningless "expected ';', got 'INT_LIT'" pointing past the
// literal. The lexer must reject the whole literal with an octal-specific
// diagnostic.
using System;
class Prog {
    static void Main() {
        int a = 0o8;
        Console.WriteLine(Convert.ToString(a));
    }
}
