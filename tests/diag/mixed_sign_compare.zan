// Mixed signed/unsigned integral comparison must be a compile error (C#
// rules): the numeric promotion lets ulong win, which silently reinterprets
// the signed operand as unsigned -- `long x = -1; ulong y = 1; x > y` would
// compare true. Neither operand implicitly converts to the other, so C#
// rejects the operator outright; a non-negative constant on the
// signed side stays legal (implicit constant conversion).
using System;

class Program {
    static void Main() {
        long x = -1;
        ulong y = 1;
        Console.WriteLine((x > y).ToString());
    }
}
