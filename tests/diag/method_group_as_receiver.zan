// Regression: accessing a member off an uninvoked method (method group) like
// `DateTime.Now.Ticks` or `w.GetWorker.Name` was once silently accepted and
// evaluated to constant 0 instead of diagnosing the uncalled method.
using System;

namespace Diag;

class Worker {
    public Worker GetWorker() { return this; }
}

class Program {
    static void Main() {
        Worker w = new Worker();
        long x = w.GetWorker.Name;
    }
}
