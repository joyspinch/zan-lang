using System;

// Convert.ToInt32/ToInt64/ToInt/ToDouble 的实参必须有字符串或数值形态。
// 类实例此前会被当成 C 字符串文本去解析（strtoll / zan_rt_dbl_parse 读
// 对象首字节），静默返回 0 —— 用户看不出自己的类型根本不支持转换。
class Box {
    string text;
    int n;
}

class Program {
    static void Main() {
        Box b = new Box();
        b.text = "hello";
        b.n = 42;
        int r = Convert.ToInt32(b);
        Console.WriteLine(r);
    }
}
