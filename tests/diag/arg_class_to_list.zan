// The mirror direction: a plain class reaching a concrete generic parameter
// (Cat into List<Cat>) is the same carrier mismatch and must also be
// rejected, not silently reinterpreted (it read List.Count through a Cat
// pointer). Binding<T> <- T and generic-instantiation-site checks stay
// unaffected.
using System;

class Cat {
    int legs;
    Cat(int l) { legs = l; }
}

class Box {
    static int TakeList(List<Cat> l) { return l.Count; }
    static void Main() {
        Cat c = new Cat(7);
        Console.WriteLine(Convert.ToString(Box.TakeList(c)));
    }
}
