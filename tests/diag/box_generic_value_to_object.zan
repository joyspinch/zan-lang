using System;

// A449：泛型方法里的装箱——checker 阶段类型参数还看不出来，
// 只能在特化（irgen）阶段拦。
//
// 缺陷：`public static object Box<T>(T x) { return (object)x; }` 编译期
// 放行（目标类型是 object，来源是类型参数 → checker 直接 return true），
// 泛型体被特化成 Box<int> 之后 int 值被 IntToPtr 成对象指针，运行期
// 拿到野指针。
public class Probe {
    public static object Box<T>(T x) {
        return (object)x;
    }

    public static void Main() {
        // 泛型方法体在特化时才发射：必须真的调用一次，特化版才会被生成
        object o = Probe.Box<int>(42);
        Console.WriteLine("unreachable");
    }
}
