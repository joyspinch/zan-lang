using System;

// --deny-warnings must reject both returns with E2072 and the existing
// "returned closure captures 'this' and escapes method scope" message.
class MethodGroupThisReturn {
    void Handle() { }

    Action Explicit() {
        return this.Handle;
    }

    Action Implicit() {
        return Handle;
    }
}

class MethodGroupThisReturnTest {
    static void Main() { }
}
