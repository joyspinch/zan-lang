// Regression: a member the builtin collections do not have (`list.Length`)
// used to lower to the string fallback -- strlen over the List's own storage
// -- and answer a number instead of failing. Diagnose it like any other
// missing member.
using System;
using System.Collections.Generic;

namespace Diag;

class Program {
    static int Main() {
        List<int> l = new List<int>();
        l.Add(1);
        return l.Length;
    }
}
