// Assigning through a name nothing declares must fail the build. A static
// factory rewritten as a constructor used to leave `app.field = ...` behind:
// the store was dropped without a word, so the object came out half
// initialised. The read side of the same name was already an error.
using System;

class Box {
    int v;

    Box() {
        box.v = 7;
    }
}

class Program {
    static void Main() {
        Box b = new Box();
        Console.WriteLine(Convert.ToString(b.v));
    }
}
