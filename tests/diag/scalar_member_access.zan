// 核心契约与语义定义。
class Record {
    string path;
}

class Program {
    static void Main() {
        List<Record> tabs = new List<Record>();
        Record tab = new Record();
        tab.path = "@docs";
        tabs.Add(tab);
        string p = tabs[0].path.path;
        Console.WriteLine(p);
    }
}
