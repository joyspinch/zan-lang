// Regression: a member access on a builtin scalar type must be a compile
// error. `tab.path` is a string, so `tab.path.path` used to fall through to
// irgen, silently lower to the constant 0, and crash with 0xC0000005 when the
// zero was used as a pointer — this was the IDE's help-page close crash
// (`tabs[i].path.path` in ZanIDE.Docs.zan).
class Record {
    string path;
}

class Program {
    static void Main() {
        List<Record> tabs = new List<Record>();
        Record tab = new Record();
        tab.path = "@docs";
        tabs.Add(tab);
        string p = tabs[0].path.path;
        Console.WriteLine(p);
    }
}
