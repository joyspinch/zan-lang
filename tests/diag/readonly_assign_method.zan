// A readonly field may only be assigned from a constructor of its declaring
// type. Assigning it from an ordinary method used to compile and mutate it.
using System;

class Counter {
    public readonly int total;
    public Counter(int v) { total = v; }
    public void Bump(int v) { total = v; }
}

class Program {
    static void Main() { Console.WriteLine(Convert.ToString(new Counter(1).total)); }
}
