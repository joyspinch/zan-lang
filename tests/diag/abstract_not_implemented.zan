namespace Diag;

// 具体类必须实现继承来的抽象方法：漏实现要在编译期报错，
// 而不是等运行期撞上「未被覆盖」的致命桩。
public abstract class Shape {
    public abstract double Area();
}

public class Broken : Shape {
    // 没有实现 Area()
}

class Program {
    static void Main() {
        Shape s = new Broken();
        Console.WriteLine(Convert.ToString(s.Area()));
    }
}
