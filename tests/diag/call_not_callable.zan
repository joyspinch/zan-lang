// The code generator's call emitter is a chain of lowerings, each claiming the
// shapes it recognises. Anything no lowering claimed used to fall off the end
// and become the constant 0 with no diagnostic: the call never happened, and
// the expression silently read as zero. Here `count(5)` applies a non-callable
// local, so nothing claims it -- this compiled clean and printed 0.
using System;

class CallNotCallable {
    static void Main() {
        int count = 1;
        Console.WriteLine(count(5));
    }
}
