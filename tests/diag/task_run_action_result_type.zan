// 把「没有结果」的任务句柄当 Task<T> 用，必须在编译期被拒绝：
//
//   Task.Run(lambda/Action) 产生的是 action 帧：没有结果，由完成路径自行释放。
//   把它声明成 Task<T> 再读 .Result/.Wait()，会让同一帧被释放两次
//   （完成路径 reap 一次 + 用户侧 reap 一次），运行期 double free 直接 abort。
//   现在检查器按实参形态定型，这种写法在编译期就报错。
using System;

class Program {
    static void Main() {
        Task<int> t = Task.Run(() => { Console.WriteLine("action-ran"); });
        Console.WriteLine(t.Result);
    }
}
