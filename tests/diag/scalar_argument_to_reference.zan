// A scalar has no object header, and there is no boxing: handing one to a
// reference parameter used to lower as `inttoptr`, and the next `is` or member
// access on that slot read `ptr - 8` and faulted far from the call. `object o =
// 42;` was already an error at assignment; the argument path was the gap.
class ScalarArgumentToReference {
    static void Store(object slot) { }

    static void Main() {
        ScalarArgumentToReference.Store(42);
    }
}
