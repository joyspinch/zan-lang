// 核心契约与语义定义。
class P {
    static bool Try(string s, out int v) {
        if (s == "") { return false; }
        v = s.Length;
        return true;
    }
    static void Main() {
        int got;
        Console.WriteLine(P.Try("ab", out got));
        Console.WriteLine(got);
    }
}
