// An `out` parameter is a promise to the caller that the slot is written
// before the method returns; the early return here leaves `v` untouched, so
// the caller reads an uninitialised value. Definite assignment has to reject
// the return, not the call site.
class P {
    static bool Try(string s, out int v) {
        if (s == "") { return false; }
        v = s.Length;
        return true;
    }
    static void Main() {
        int got;
        Console.WriteLine(P.Try("ab", out got));
        Console.WriteLine(got);
    }
}
