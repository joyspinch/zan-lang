    static void WrongSet(object target, int value) { }
    static void Main() {
        Binding<string> binding = new Binding<string>();
        binding.setter = GenericDelegateFieldAssignmentMismatch.WrongSet;
        binding.getter = GenericDelegateFieldAssignmentMismatch.WrongGet;
    }
