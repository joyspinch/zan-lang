// `protected` members are visible to the declaring type and to bodies of
// types derived from it -- not to unrelated classes holding an instance,
// which is what this case attempts through a plain field read.
namespace Access2;

class Base {
    protected int shield = 1;
}

class Child : Base {
    int ReadGuard() { return this.shield; }   // derived access stays legal
}

class Impostor {
    int Peek(Base b) { return b.shield; }
}

class Program {
    static void Main() {
    }
}
