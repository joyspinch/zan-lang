// D2 negative regression: a return value and an assignment RHS were checked
// for syntax only, never compared against the declared target type, so
// `string F() { return 123; }` compiled and then dereferenced the 123 as a
// string pointer at runtime (segfault). A value with no implicit conversion
// to the declared return type or assignment target is a compile error naming
// the source location.
class A {
    int count;
    static string MakeString() {
        return 123;          // int into a string return -> error
    }
    void Set(int v) {
        this.count = "abc";  // string into an int field -> error
    }
    static void Main() {
        Console.WriteLine(A.MakeString().Length);
    }
}
