using System;

/// A class that declares constructors has no implicit parameterless one, so
/// `new Box()` has no constructor to run: the object would come back
/// zero-filled (`items` null) and fault on the first use. The arity mismatch
/// must be a compile error, not a crash far from the `new`.
class Box {
    List<int> items;

    Box(string name) {
        items = new List<int>();
    }
}

class CtorMissingParameterless {
    static void Main() {
        Box b = new Box();
        Console.WriteLine("unreachable");
    }
}
