using System;

/// An object initializer stands in for the missing parameterless constructor
/// only when it writes every member: the fields it skips stay zero-filled,
/// which is the half-built instance the diagnostic exists to prevent. Here
/// `items` is left null, so `new Box { name = "b" }` must still fail.
class Box {
    string name;
    List<int> items;

    Box(string n) {
        name = n;
        items = new List<int>();
    }
}

class CtorInitializerPartial {
    static void Main() {
        Box b = new Box { name = "b" };
        Console.WriteLine("unreachable");
    }
}
