class Box {
    string name;
    List<int> items;

    Box(string n) {
        name = n;
        items = new List<int>();
    }
}

class CtorInitializerPartial {
    static void Main() {
        Box b = new Box { name = "b" };
        Console.WriteLine("unreachable");
