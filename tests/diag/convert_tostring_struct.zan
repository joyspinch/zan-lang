using System;

// Convert.ToString 落到结构体上时，编译器此前把它塞进整数格式化分支，
// 生成 `%struct.Pt` 传给 i64 形参的调用——LLVM 校验直接失败
// ("Call parameter type does not match function signature")。
struct Pt {
    int x;
    int y;
}

class Program {
    static void Main() {
        Pt p = new Pt();
        p.x = 1;
        p.y = 2;
        Console.WriteLine("struct:" + Convert.ToString(p));
    }
}
