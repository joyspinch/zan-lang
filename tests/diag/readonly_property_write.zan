// 核心契约与语义定义。
class A {
    public int ReadOnly { get; }
    public int Rw { get; set; }
}
class P {
    static void Main() {
        A a = new A();
        a.ReadOnly = 1;             // no setter
        a.ReadOnly += 1;            // no setter (compound)
        a.ReadOnly++;               // no setter (increment)
        A b = new A { ReadOnly = 2 }; // no setter (object initializer)
        a.Rw = 3;                   // legal: automatic setter
        Console.WriteLine(a.Rw);
    }
}
