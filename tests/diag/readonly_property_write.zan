// Regression (B5): a getter-only property (`{ get; }`) has no setter to
// dispatch a write to. Assigning through it (`obj.Prop = v`), bare-name,
// compound-assign (`+=`), increment (`++`) and object-initializer writes must
// be compile errors instead of silently writing the property's backing slot
// (which a custom getter would never read back).
class A {
    public int ReadOnly { get; }
    public int Rw { get; set; }
}
class P {
    static void Main() {
        A a = new A();
        a.ReadOnly = 1;             // no setter
        a.ReadOnly += 1;            // no setter (compound)
        a.ReadOnly++;               // no setter (increment)
        A b = new A { ReadOnly = 2 }; // no setter (object initializer)
        a.Rw = 3;                   // legal: automatic setter
        Console.WriteLine(a.Rw);
    }
}
