class Program {
    static void Main() {
        List<string> values = new List<string> { "a", "b" };
        List<int> numbers = new List<int> { 1, 2 };

        string.Join(null, values);
        String.Join(", ", values);

        string.Join(", ", values.ToArray());
        String.Join(", ", values.ToArray());
        string.Join(", ", numbers);
        String.Join(1, values);
    }
}
