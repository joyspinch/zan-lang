// A float literal with an exponent but no exponent digits (`1e`, `1e+`,
// `1e-`) used to lex as FLOAT_LIT with the mantissa's value (strtod parses
// the prefix), so `double a = 1e;` compiled and ran with the value 1.0.
// The lexer must reject it: the number the program gets is not the number
// that was written.
using System;
class Prog {
    static void Main() {
        double a = 1e;
        Console.WriteLine(Convert.ToString(a));
    }
}
