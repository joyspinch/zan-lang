// A hex/binary/octal literal above ulong.MaxValue is not representable:
// strtoull clamped it to ulong.MaxValue with ERANGE and no diagnostic fired,
// so the literal silently became a DIFFERENT number (a 65-bit literal read
// back as -1). All three radix paths must reject it, matching the decimal
// path's existing "too large for 'ulong'" diagnostic.
class Program {
    static void Main() {
        ulong h = 0x1FFFFFFFFFFFFFFFF;
        ulong b = 0b11111111111111111111111111111111111111111111111111111111111111111;
        ulong o = 0o377777777777777777777777777777;
    }
}
