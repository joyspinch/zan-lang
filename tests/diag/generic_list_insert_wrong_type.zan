using System;
using System.Collections.Generic;

// List<T> 的**其它成员**也要按类型实参检查——不只是 Add。
//
// `Insert(int index, T item)` 的第二个形参是 T，`Contains(T item)` /
// `IndexOf(T item)` 的形参也是 T。这些此前一样放行：往 List<int> 里
// Contains 一个字符串，编译通过、运行期拿垃圾指针去比。
class Program {
    static void Main() {
        List<int> numbers = new List<int>();
        numbers.Add(42);
        numbers.Insert(0, "这不是 int");
        Console.WriteLine(numbers.Contains("这不是 int"));
    }
}
