// 类型参数不能实例化：`new T()` 没有可用的构造入口，宿主侧只会造出
// 一个 null 引用——运行期第一次成员访问就崩进程（0xC0000005）。
// 数组形态 `new T[n]` 不在此列：元素类型在实例化时被替换，是合法的。
using System;

class Maker<T> {
    public T Make() {
        T t = new T();
        return t;
    }
}

class Program {
    static void Main() {
        Maker<int> mk = new Maker<int>();
        Console.WriteLine(mk.Make());
    }
}
