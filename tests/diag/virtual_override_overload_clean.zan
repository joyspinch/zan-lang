using System;

class Base {
    virtual async void Tick() { }
    virtual int Calc(int a) { return a; }
}

class Derived : Base {
    /* override 填充基类槽位；同名不同参数个数是合法重载（自己的新槽位）
       ——两者都不应触发 hidden-virtual 警告，--deny-warnings 下必须照常
       编译运行，锁定该诊断不误报。 */
    override async void Tick() { }
    override int Calc(int a) { return a + 1; }
    virtual void Tick(int a, int b) { }
}

class Program {
    static void Main() {
        Base h = new Derived();
        Console.WriteLine("override and overloads compile clean");
    }
}
