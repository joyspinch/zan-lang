using System;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.IO;

/// 核心契约与语义定义。
/// 核心契约与语义定义。
/// 核心契约与执行状态转移规范。
[Table(Name = "t_ty")]
class TyRow {
    [Column(IsIdentity = true)]
    int id;
    [Column(Name = "name", StringLength = 32)]
    string name;
    int num;
    double ratio;
}

class Program {
    static void Main() {
        string path = "diag_orm_set_string_int.tmp.db";
        File.Delete(path);
        SqliteConnection db = SqliteConnection.Open(path);
        db.SyncStructure<TyRow>();
        db.Update<TyRow>().Set(t => t.num, "abc").Where(t => t.id == 1)
            .ExecuteAffrows();
        db.Close();
        File.Delete(path);
    }
}
