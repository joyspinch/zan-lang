// `await Socket.ReadReady(...)` 出现在非 async 方法里 → 编译期报错。
//
// 判据（写在 src/compiler/checker.c 的 AST_AWAIT_EXPR 分支）：
// `await` 能不能放在非 async 方法里，看的是"**这个 await 目标需不需要真挂起**"，
// 不是"外层方法是不是 async"。
//
// Socket.ReadReady 要把恢复函数挂到协程帧的状态槽上——非 async 方法里没有
// 帧，无路可走，所以必须报错（诊断由 irgen 在降级处发出，判据与名单都在那边）。
//
// 与 await_gate_park_outside_async.zan 是同一族的不同目标：Gate.Park 走事件
// 门，Socket.* 走 IO 就绪，两条路径各自要挂到帧上。
//
// 另一半边界（不该报错时别报）由 conformance 的 async_sync_await_in_co
// 钉住：非 async 方法里 await 一个普通值 / 一个 async 调用 / Task.Delay
// 都是合法的。
using System;

class Program {
    static void ReadReadyOutsideAsync(int fd) {
        await Socket.ReadReady(fd);
    }

    static void Main() {
    }
}
