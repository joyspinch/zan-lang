// `await` 落在 async 方法的 lambda 体内：lambda 不是协程，没有自己的帧可挂。
//
// 改前宿主直接发出非法 IR——lambda 体里的 await 挂到**外层协程**的块上
// （跨函数的 br），LLVM 校验报 "Referring to a basic block in another
// function"，最后只吐一句 "code generation failed"，看不出是哪个 await 的
// 问题。现在给编译期诊断。
//
// 边界：同步方法里的同样写法是合法的（没有外层协程，根驱动等得到）。
using System;

class Program {
    public delegate void F(int n);

    static async int Work(int n) {
        await Task.Delay(1);
        return n * 2;
    }

    static async void Main() {
        F f = (int n) => {
            int v = await Program.Work(n);
            Console.WriteLine("v=" + Convert.ToString(v));
        };
        f(21);
    }
}
