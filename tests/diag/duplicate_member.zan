// A43-A16: two methods with the same name AND the same parameter types used
// to compile silently, with every lookup resolving to whichever came first
// -- a semantics swap with zero diagnostics (HttpContext.Param incident).
// Legal overloads differ in parameter types and must keep compiling.
namespace Diag;
class Dup {
    int Val() { return 1; }
    int Val() { return 2; }
}
