interface IDbConnection {
    void Open();
}

class DbContext {
}

class CategoryDao {
    IDbConnection conn;
    public CategoryDao(IDbConnection conn) {
        this.conn = conn;
    }
    public void Run() {
        this.conn.Open();
    }
}

class Program {
    static void Main() {
        DbContext db = new DbContext();
        CategoryDao dao = new CategoryDao(db);
    }
}
