// Regression: `string + <class reference>` used to pass the checker, and
// irgen's concat lowering then strlen'd the object's raw bytes as the
// operand text -- the mojibake the snake over screen rendered as
// "得分 9?f?|?m?c". Only types the lowering can format (strings, numerics,
// char/enum/bool) may concatenate or interpolate; reference types must be
// converted explicitly (e.g. read the field).
class Score {
    public int value;
}
class App {
    static int Main() {
        Score s = new Score();
        string t = "得分 " + s;
        return t.Length;
    }
}
