// The null-receiver check used to accept a guard ANYWHERE in the method body
// -- `c = F(); use(c.Name); if (c == null) ...` read as guarded while the test
// sat after the access it was supposed to guard. Only a test that starts
// before the offending access counts now.
using System;

class Cfg {
    public string Name;
}

class Store {
    public Cfg Find(string k) {
        if (k == "hit") { return new Cfg(); }
        return null;
    }
}

class Program {
    static void Main() {
        Store s = new Store();
        Cfg c = s.Find("miss");
        Console.WriteLine(c.Name);
        if (c == null) { return; }
    }
}
