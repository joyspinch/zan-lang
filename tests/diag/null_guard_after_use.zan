// 核心契约与语义定义。
using System;

class Cfg {
    public string Name;
}

class Store {
    public Cfg Find(string k) {
        if (k == "hit") { return new Cfg(); }
        return null;
    }
}

class Program {
    static void Main() {
        Store s = new Store();
        Cfg c = s.Find("miss");
        Console.WriteLine(c.Name);
        if (c == null) { return; }
    }
}
