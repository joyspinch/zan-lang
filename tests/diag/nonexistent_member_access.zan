// Regression: accessing a nonexistent member on a class or struct (e.g.
// `DateTime.Now().Ticks` or `t.NonExistent.Value`) was once silently accepted
// by the type checker returning type_error and irgen falling through to constant 0.
using System;

namespace Diag;

class Thing {}

class Program {
    static void Main() {
        Thing t = new Thing();
        long x = t.NonExistent.Value;
    }
}
