// S1（docs/ZAN_STANDARD.md §1）：--diag=json 的缺分号用例。
// 第 8 行少一个 ';'：诊断报在第 9 行的 'int' 上（E0032，第 9 列），
// fix-it 在第 8 行 '1' 之后（第 18 列）插入 ';'。
using System;
namespace DiagJson;
class Program {
    static void Main(string[] args) {
        int x = 1
        int y = x + 1;
        Console.WriteLine(y);
    }
}
