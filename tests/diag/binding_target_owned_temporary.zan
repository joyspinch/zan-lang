using System;

class BindingTemporaryOwner { public int Value; }
class BindingTargetOwnedTemporary {
    static BindingTemporaryOwner Make() { return new BindingTemporaryOwner(); }
    static void Main() {
        Binding<int> binding = new Binding<int>();
        binding.target = new BindingTemporaryOwner();
        binding.target = BindingTargetOwnedTemporary.Make();
        Binding<int> initialized = new Binding<int> { target = new BindingTemporaryOwner() };
    }
}
