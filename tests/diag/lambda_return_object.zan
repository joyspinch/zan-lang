using System;
using System.Collections.Generic;

// A449：lambda 返回类型与委托返回类型不兼容。
//
// 缺陷：checker 的 lambda 分支直接返回 type_error，而 type_error 在可赋值
// 判定里被当作「什么都行」，于是 `(Order o) => o.id` 赋给
// `FuncT<Order, object>` 一声不吭地通过。运行期把 int 值当对象指针返回，
// 调用方拿到非 null 的野指针，进程退出时 ARC 回收这个假对象再崩一次。
public class Probe {
    public static void Main() {
        FuncT<Order, object> f = (Order o) => o.id;
        Console.WriteLine("unreachable");
    }
}

class Order { public int id; public Order(int id) { this.id = id; } }
