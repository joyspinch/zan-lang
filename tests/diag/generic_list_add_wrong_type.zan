using System;
using System.Collections.Generic;

// List<T> 的**类型实参**必须真的被检查。
//
// 此前 `List<T>.Add(T item)` 的形参类型是类型参数 T，而 checker 对
// "含类型参数的形参"一律放行——于是 `List<int>.Add("字符串")` 编译通过，
// 运行时把字符串指针存进 int 列表，读出来是垃圾指针（静默损坏，不是崩）。
//
// 内建 List 没有 sym（成员签名在 builtin_api.c 的表里），所以
// call_arg_signature 拿不到签名，整条实参类型检查从没被走过。
class Program {
    static void Main() {
        List<int> numbers = new List<int>();
        numbers.Add(42);
        numbers.Add("这不是 int");
        Console.WriteLine(numbers.Count);
    }
}
