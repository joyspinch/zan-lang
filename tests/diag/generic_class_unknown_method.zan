using System;

// 泛型类体内的成员存在性检查不能被整类放行。
//
// 曾经 checker 只要发现"所在类是泛型类"就跳过调用位置的成员存在性检查
// （checker_call_is_runtime_dispatched 的豁免），于是泛型类里调一个谁都没
// 有的方法照样编得过，一路跑到运行期才炸。豁免的正当理由只有一个：
// ORM 泛型基类里的 `db.Select<T>()` 成员集编译期判不出来（GenDb 改写要等
// 具体实体类），所以豁免的判据必须是"这个调用还带着类型形参"。
//
// 这里三个接收者都是成员集完全已知的具体类型，调用不存在的方法必须当场
// 报出来。接收者是类型形参本身（T）的那种不在此列——成员集判不出来，
// 那是另一条既有路径。
namespace Diag;

interface IShape {
    int Area();
}

class Helper {
    public int Value() { return 1; }
}

class Box<T> {
    public IShape shape;
    public Helper helper;

    // 接口接收者：IShape 没有 NoSuchMethod
    public int UseIface() {
        return this.shape.NoSuchMethod();
    }

    // 类接收者：Helper 没有 NoSuchMethod
    public int UseClass() {
        return this.helper.NoSuchMethod();
    }

    // 自身接收者：Box 没有 NoSuchMethod
    public int UseSelf() {
        return this.NoSuchMethod();
    }
}

class Program {
    static void Main() {
        Console.WriteLine("unreachable");
    }
}
