using System;
using System.Collections.Generic;

// Dictionary<K,V> 的**两个**类型实参都要被检查。
//
// 此前 `Dict.Add(K key, V value)` 的形参类型是 K 和 V，checker 一律放行
// ——于是 `Add("k", "不是 int")` 编译通过，运行时把字符串存进了 int 槽位。
class Program {
    static void Main() {
        Dictionary<string, int> counts = new Dictionary<string, int>();
        counts.Add("答案", 42);
        counts.Add("答案", "这不是 int");
        Console.WriteLine(counts.Count);
    }
}
