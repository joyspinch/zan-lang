// D3 negative regression: an unknown type used in a `where` constraint was
// silently ignored during generic instantiation, so the resulting code
// compiled as if no constraint existed. The checker must reject the
// instantiation with an unknown-constraint error naming the source location.
class Box<T> where T : NoSuchConstraint {}
class P {
    static void Main() {
        Box<int> b = new Box<int>();
    }
}
