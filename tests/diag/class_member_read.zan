// Regression: reading a member a class does not declare must be a compile
// error. The assignment side (`item.text = "x"`) was already diagnosed, but
// the read side fell through to irgen, silently lowered to the constant 0,
// and either produced a wrong number or crashed at runtime when the zero was
// used as a pointer — a field renamed from `text` to `message` left every
// reader compiling clean.
class Diagnostic {
    string message;
}

class Program {
    static void Main() {
        Diagnostic item = new Diagnostic();
        item.message = "boom";
        Console.WriteLine(item.text);
    }
}
