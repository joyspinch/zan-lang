// Definite assignment: a local read on a path that never wrote it holds
// whatever the stack slot happened to contain -- the class of bug that reads
// as "the program just closed" (a null control, a count nobody set). Only the
// `if` arm assigns `total`, so the read after it must be a compile error, the
// way C# reports CS0165.
class P {
    static void Main() {
        int total;
        if (Environment.TickCount > 0) { total = 1; }
        Console.WriteLine(total);
    }
}
