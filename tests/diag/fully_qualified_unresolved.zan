// Regression (H): a fully-qualified call `Foo.Bar.Baz.Quux(...)` whose whole
// name path is unresolved used to lower silently to a 0/null result -- a
// string method would return "(null)", a void call would be a no-op -- with
// no diagnostic anywhere. The per-call "unresolved call" check only looked at
// a single dotted segment (X.Method), so a deeper path slipped through. This
// must now be a hard compile error naming the broken path.
class P {
    static void Main() {
        Foo.Bar.Baz.Quux("hello");
        Console.WriteLine("after");
    }
}
