// A private constructor makes the class constructible only from its own
// bodies (the classic non-instantiable / factory-held singleton shape).
// `new Safe()` from outside must fail to check instead of silently building
// the object anyway.
namespace Access3;

class Safe {
    private Safe() {}
    static Safe Open() { return new Safe(); }
}

class Program {
    static void Main() {
        Safe s = new Safe();
        Console.WriteLine(Convert.ToString(s != null));
    }
}
