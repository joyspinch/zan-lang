// Regression: reading a member off an unresolved method call
// (`t.Describe().Name`) fell through to the member fallback's constant 0 -- a
// missing method answered a number instead of failing the build, while the
// unchained form was diagnosed. Report the missing method either way.
// (`GetType()` used to stand in for the missing method; it is real reflection
// now, so this uses a method the class really does not declare.)
using System;

namespace Diag;

class Thing { public int a; }

class Program {
    static void Main() {
        Thing t = new Thing();
        Console.WriteLine(t.Describe().Name);
    }
}
