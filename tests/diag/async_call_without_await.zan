namespace Diag;

// async 调用的静态类型是结果类型，但不 await 时产出的是协程帧：当值用
// （赋值、运算、实参、return、条件）读到的是截断的帧指针——静默错值，
// 曾让 server-collab 的 `!this.Can(...)` 权限判断恒为假（E2116）。
// 语句级调用（脱钩执行）与 Task.Spawn/Task.Run 实参不在此列。
class Program {
    static async int Count(int i) {
        await Task.Delay(0);
        return i;
    }

    static async bool Allowed() {
        await Task.Delay(0);
        return false;
    }

    static void Main() {
        Count(1);
        Task.Spawn(Program.Count(2));
        int ok = await Count(3);
        int bad = Count(4);
        if (!Allowed()) {
            Console.WriteLine("denied");
        }
        Console.WriteLine(Convert.ToString(ok + bad));
    }
}
