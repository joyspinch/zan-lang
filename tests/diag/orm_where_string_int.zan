using System;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.IO;

/// A string column compared to an int literal must fail at compile time.
/// dbgen used to lower `p.name == 123` to a bound int parameter, silently
/// producing a type-coerced comparison at runtime instead of rejecting it.
[Table(Name = "t_ty")]
class TyRow {
    [Column(IsIdentity = true)]
    int id;
    [Column(Name = "name", StringLength = 32)]
    string name;
    int num;
    double ratio;
}

class Program {
    static void Main() {
        string path = "diag_orm_string_int.tmp.db";
        File.Delete(path);
        SqliteConnection db = SqliteConnection.Open(path);
        db.SyncStructure<TyRow>();
        Console.WriteLine(Convert.ToString(
            db.Select<TyRow>().Where(t => t.name == 123).Count()));
        db.Close();
        File.Delete(path);
    }
}
