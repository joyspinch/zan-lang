// 一元 `-` 的操作数必须是数值（或类/结构体上的重载路径）。字符串既不是
// 数值也没有重载：此前这里只回了一个**不发诊断**的 type_error 哨兵，
// 错误一路漏进 irgen —— 对字符串指针做整数减法，LLVM 校验失败
// ("Integer arithmetic operators only work with integral types")。
using System;

class Program {
    static void Main() {
        string s = "x";
        Console.WriteLine(-s);
    }
}
