using System;
using System.Text;

class P {
    static void Main() {
        // "System.Whatever" 这个命名空间不存在：限定名写错必须报"未解析"，
        // 不能按最后一段绑到 using 引进的 Encoding 上（静默错绑 → 返回类型
        // 对不上 → 运行期踩内存 0xC0000005）。
        int v = System.Whatever.Encoding.GetByteCount("hi");
        Console.WriteLine("after:" + Convert.ToString(v));
    }
}
