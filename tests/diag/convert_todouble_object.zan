using System;

// Convert.ToDouble 与 ToInt32 共用「文本或数值」类型白名单，但走的是另一条
// 诊断分支（zan_rt_dbl_parse）；类实例此前被当成 C 字符串文本去解析。
class Box {
    string text;
    int n;
}

class Program {
    static void Main() {
        Box b = new Box();
        b.text = "hello";
        b.n = 42;
        double r = Convert.ToDouble(b);
        Console.WriteLine(r);
    }
}
