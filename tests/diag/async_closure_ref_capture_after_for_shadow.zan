using System;

delegate int Read();

class Program {
    static async int Capture(ref int value) {
        for (int value = 0; value < 1; value = value + 1) { }
        // The loop-local is out of scope; this captures the ref parameter.
        Read read = () => value;
        await Task.Delay(1);
        return read();
    }

    static void Main() { }
}
