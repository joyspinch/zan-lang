using System;

// Convert.ToString 只能转真正有字符串形态的值。类实例不是 C 字符串：
// 编译器此前拿 strlen 去量对象指针，越界读进程内存（把对象头里的指针
// 字节当成文本一路扫下去），打印出进程映像里的符号名并把程序带崩。
class Box {
    string text;
    int n;
}

class Program {
    static void Main() {
        Box b = new Box();
        b.text = "hello";
        b.n = 42;
        string s = Convert.ToString(b);
        Console.WriteLine(s);
    }
}
