// Decimal literal in [2^31, 2^32] no longer wraps two's-complement
// when written into an int slot -- it narrows with a CS0031-style error,
// like C#. The hex spelling stays the bit-pattern idiom
// (conformance_int_literal_range pins the wrap in every context);
// the explicit cast is the opt-in.
class Program {
    static void Main() {
        int b = 4294967295;
    }
}
