using System;
using System.Web;
using Zan.Web;

[Route("/verbs")]
class VerbProbeController : Controller {
    [HttpPut]
    public void Replace() { this.Ctx().Text("PUT action"); }
    [HttpPatch]
    public void Update() { this.Ctx().Text("PATCH action"); }
    [HttpDelete]
    public void Remove() { this.Ctx().Text("DELETE action"); }
    [HttpPost]
    public void Create() { this.Ctx().Text("POST action"); }
}

class Program {
    static int failures;
    static void Check(bool ok, string label) {
        if (!ok) { Program.failures = Program.failures + 1; Console.WriteLine("FAIL " + label); }
    }
    static HttpContext Ctx(string verb, string path) {
        HttpRequest req = HttpRequest.Parse(verb + " " + path + " HTTP/1.1\r\nHost: test\r\n\r\n");
        return new HttpContext(req, "127.0.0.1");
    }
    static async void Action(WebApp app, string verb, string path, string expected) {
        HttpContext ctx = Program.Ctx(verb, path);
        Route hit = app.Router().Match(ctx);
        Program.Check(hit != null && hit.Method() == verb, verb + " attribute registered verb-only action");
        if (hit != null) {
            ctx.SetRoute(hit.Action(), hit.Pattern(), hit.Idx());
            HttpHandler handler = hit.Handler();
            await handler(ctx);
            Program.Check(ctx.BuildResponse(false).Contains(expected), verb + " action dispatches");
        }
        if (verb != "POST") {
            HttpContext wrong = Program.Ctx("POST", path);
            Program.Check(app.Router().Match(wrong) == null, verb + " is not aliased to POST");
        }
    }
    static async void Main() {
        WebApp app = new WebApp("127.0.0.1", 0);
        __AttrRoutes.Register(app);
        await Program.Action(app, "PUT", "/verbs/replace", "PUT action");
        await Program.Action(app, "PATCH", "/verbs/update", "PATCH action");
        await Program.Action(app, "DELETE", "/verbs/remove", "DELETE action");
        await Program.Action(app, "POST", "/verbs/create", "POST action");
        Console.WriteLine("failures=" + Convert.ToString(Program.failures));
        if (Program.failures != 0) { throw new Exception("attribute verb regression"); }
    }
}
