using System;
using System.Net.External;

class Program {
    static void Check(string name, bool value) {
        Console.WriteLine(name + ":" + (value ? "ok" : "bad"));
    }

    static void CheckTarget(string name, string url, bool want) {
        ExternalTarget t = ExternalTarget.Parse(url);
        Program.Check(name, (t != null) == want);
    }

    static void Main() {
        Program.CheckTarget("https", "https://example.com/a?b=1", true);
        Program.CheckTarget("http-parse", "http://example.com/a", true);
        Program.Check("http-default-deny", !ExternalTargetPolicy.IsAllowed(
            "http://example.com/a"));
        Program.CheckTarget("userinfo", "https://user@example.com/a", false);
        Program.CheckTarget("fragment", "https://example.com/a#frag", false);
        Program.CheckTarget("encoded", "https://example.com/%2f", false);
        Program.CheckTarget("port", "https://example.com:8443/a", true);
        Program.CheckTarget("empty-port", "https://example.com:/a", false);
        Program.CheckTarget("bad-port", "https://example.com:65536/a", false);
        Program.CheckTarget("ipv6", "https://[2001:db8::1]/a", true);
        Program.CheckTarget("ipv6-port", "https://[2001:db8::1]:8443/a", true);
        Program.CheckTarget("ipv6-bad", "https://[2001:db8::1", false);
        Program.Check("loopback-deny", !ExternalTargetPolicy.IsAllowed(
            "https://127.0.0.1:443/a"));
        Program.Check("loopback-local", ExternalTargetPolicy.IsLocalAllowed(
            "http://127.0.0.1:8080/a"));
        Program.Check("private-deny", !ExternalTargetPolicy.IsAllowed(
            "https://192.168.1.2/a"));
        Program.Check("suffix-deny", !ExternalTargetPolicy.AllowExact(
            "https://api.example.com.evil.test/v1",
            "https://api.example.com/v1"));
        Program.Check("post-no-key", !ExternalCallPolicy.Default()
            .RetryNetwork(true).RetryAttempts(2).CanRetry("POST", false, 503));
        Program.Check("post-key", ExternalCallPolicy.Default()
            .RetryNetwork(true).RetryAttempts(2).Idempotent("request-1")
            .CanRetry("POST", false, 503));
    }
}
