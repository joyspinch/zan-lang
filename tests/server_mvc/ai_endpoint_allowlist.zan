using System;
using Zan.Web.Ai;
using Zan.Web.Core;

class Program {
    static void CheckEndpoint(string url, string host, int port, string path, bool tls) {
        AiEndpoint endpoint = AiEndpoint.Parse(url);
        if (endpoint == null || endpoint.Host() != host || endpoint.Port() != port
        || endpoint.Path() != path || endpoint.Tls() != tls || endpoint.Canonical() != url
        || endpoint.Local() != !tls) {
            throw new Exception("Unexpected AI endpoint: " + url);
        }
    }

    static void Main() {
        CheckEndpoint("https://api.openai.com/v1", "api.openai.com", 443, "/v1", true);
        CheckEndpoint("https://dashscope.aliyuncs.com/compatible-mode/v1",
        "dashscope.aliyuncs.com", 443, "/compatible-mode/v1", true);
        CheckEndpoint("http://127.0.0.1:11434/v1", "127.0.0.1", 11434, "/v1", false);
        if (AiEndpoint.Parse("HTTP://127.0.0.1:11434/v1") != null
        || AiEndpoint.Parse("https://API.OPENAI.COM/v1") != null
        || AiEndpoint.Parse("https://api.openai.com:443/v1") != null
        || AiEndpoint.Parse("https://api.openai.com/v1/") != null
        || AiEndpoint.Parse(null) != null) {
            throw new Exception("Unexpected AI endpoint spelling accepted");
        }

        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://api.deepseek.com/v1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://api.openai.com/v1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://dashscope.aliyuncs.com/compatible-mode/v1")
            ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://open.bigmodel.cn/api/paas/v4") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://api.moonshot.cn/v1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "http://127.0.0.1:11434/v1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://api.openai.com.evil.example/v1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://api.openai.com/v1/") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://api.openai.com:8443/v1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://api.openai.com/v1?redirect=http://127.0.0.1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://API.OPENAI.COM/v1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsLocal(
            "http://127.0.0.1:11434/v1") ? "local" : "remote");
        Console.WriteLine(AiEndpointPolicy.IsLocal(
            "http://localhost:11434/v1") ? "local" : "remote");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(null) ? "allow" : "deny");
    }
}
