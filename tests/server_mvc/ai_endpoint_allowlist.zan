using System;
using ZanWeb;

class Program {
    static void Main() {
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://api.deepseek.com/v1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://api.openai.com/v1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://dashscope.aliyuncs.com/compatible-mode/v1")
            ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://open.bigmodel.cn/api/paas/v4") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://api.moonshot.cn/v1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "http://127.0.0.1:11434/v1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://api.openai.com.evil.example/v1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://api.openai.com/v1/") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://api.openai.com:8443/v1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://api.openai.com/v1?redirect=http://127.0.0.1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(
            "https://API.OPENAI.COM/v1") ? "allow" : "deny");
        Console.WriteLine(AiEndpointPolicy.IsLocal(
            "http://127.0.0.1:11434/v1") ? "local" : "remote");
        Console.WriteLine(AiEndpointPolicy.IsLocal(
            "http://localhost:11434/v1") ? "local" : "remote");
        Console.WriteLine(AiEndpointPolicy.IsAllowed(null) ? "allow" : "deny");
    }
}
