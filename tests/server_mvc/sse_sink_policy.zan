using System;
using System.Net.Http.Client;

class Program {
    static async int Run() {
        SseSink sink = SseSink.ToMemory();
        sink.Begin();
        sink.SetMaxBytes(4);
        Console.WriteLine(sink.TryWrite("abc") ? "write:ok" : "write:bad");
        Console.WriteLine(sink.TryWrite("de") ? "overflow:bad" : "overflow:ok");
        Console.WriteLine(sink.Overflowed() ? "state:ok" : "state:bad");
        sink.Write("ignored");
        Console.WriteLine(sink.Total() == 3 ? "drop:ok" : "drop:bad");
        SseDelivery d = await sink.TakeCo(1);
        Console.WriteLine(d.finished ? "finish:ok" : "finish:bad");
        sink.Dispose();

        SseSink cancel = SseSink.ToMemory();
        cancel.Begin();
        cancel.Abort();
        cancel.Abort();
        cancel.Write("ignored");
        Console.WriteLine(cancel.Aborted() && cancel.Total() == 0
            ? "abort:ok" : "abort:bad");
        SseDelivery c = await cancel.TakeCo(1);
        Console.WriteLine(c.finished ? "cancel-finish:ok" : "cancel-finish:bad");
        cancel.Dispose();
        return 0;
    }

    static async void Main() {
        int _rc = await Program.Run();
    }
}
