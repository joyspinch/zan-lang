using System;
using System.Net.External;

class Program {
    static void Check(string name, bool value) {
        Console.WriteLine(name + ":" + (value ? "ok" : "bad"));
    }

    static void Main() {
        ExternalCallPolicy remote = ExternalCallPolicy.Default()
            .ResponseLimit(4096).StreamLimit(8192);
        Check("body-min", remote.MaxBodyBytes() == 4096);
        Check("remote-http-deny", !ExternalTargetPolicy.IsClientAllowed(
            "example.com", 80, false, remote.AllowsLoopback(),
            remote.AllowsHttp(), remote.LocalHttpOnly()));
        ExternalCallPolicy local = ExternalCallPolicy.Default().AllowLocalHttp();
        Check("local-http-literal", ExternalTargetPolicy.IsClientAllowed(
            "127.0.0.1", 8080, false, local.AllowsLoopback(),
            local.AllowsHttp(), local.LocalHttpOnly()));
        Check("local-http-name-deny", !ExternalTargetPolicy.IsClientAllowed(
            "localhost", 8080, false, local.AllowsLoopback(),
            local.AllowsHttp(), local.LocalHttpOnly()));
        Check("local-http-public-deny", !ExternalTargetPolicy.IsClientAllowed(
            "example.com", 8080, false, local.AllowsLoopback(),
            local.AllowsHttp(), local.LocalHttpOnly()));
        Check("local-https-public", ExternalTargetPolicy.IsClientAllowed(
            "example.com", 443, true, local.AllowsLoopback(),
            local.AllowsHttp(), local.LocalHttpOnly()));
    }
}
