using System;
using System.Data;
using System.Json;
using System.Web;
using Zan.Web.Core;
using Zan.Web.Health;
using Zan.Web;

class ApiProbe : ApiController {
    void Success() { this.Ok("{\"answer\":42}"); }
    void Reject() { this.Fail(401, "bad \"input\" \\ path"); }
    void Broken() { this.ServerError(""); }
}

/* 授权声明覆盖矩阵：路由标志是 HTTP 门、菜单与文档共同使用的安全契约。 */
[Route("/authorization/public")]
[Custom(Authorization = CustomAuthorization.None)]
class PublicDefaultController : Controller {
    [HttpGet]
    [Custom(Authorization = CustomAuthorization.Login, IsMenu = true)]
    public void Index() { this.Ctx().Text("login"); }
    [HttpGet]
    [Custom(Authorization = CustomAuthorization.ApiAuth, IsMenu = true)]
    public void Api() { this.Ctx().Text("api"); }
    [HttpGet]
    [Custom(Authorization = CustomAuthorization.Grant, IsMenu = true)]
    public void Granted() { this.Ctx().Text("grant"); }
    [HttpGet]
    [Custom(Authorization = CustomAuthorization.Auth, IsMenu = true)]
    public void Optional() { this.Ctx().Text("optional"); }
    [HttpGet]
    [Custom(Authorization = CustomAuthorization.Unknown, IsMenu = true)]
    public void Unknown() { this.Ctx().Text("unknown"); }
    [HttpGet]
    [Custom(IsMenu = true)]
    public void Inherit() { this.Ctx().Text("public"); }
}

[Route("/authorization/grant")]
[Custom(Authorization = CustomAuthorization.Grant)]
class GrantDefaultController : Controller {
    [HttpGet]
    [Custom(Authorization = CustomAuthorization.Login, IsMenu = true)]
    public void Index() { this.Ctx().Text("login"); }
    [HttpGet]
    [Custom(Authorization = CustomAuthorization.None, IsMenu = true)]
    public void Public() { this.Ctx().Text("public"); }
    [HttpGet]
    [Custom(Authorization = CustomAuthorization.Auth, IsMenu = true)]
    public void Optional() { this.Ctx().Text("optional"); }
    [HttpGet]
    [Custom(IsMenu = true)]
    public void Inherit() { this.Ctx().Text("grant"); }
}

[Route("/authorization/login")]
[Custom(Authorization = CustomAuthorization.Login)]
class LoginDefaultController : Controller {
    [HttpGet]
    [Custom(Authorization = CustomAuthorization.None)]
    public void Public() { this.Ctx().Text("public"); }
    [HttpGet]
    [Custom(Authorization = CustomAuthorization.ApiAuth)]
    public void Api() { this.Ctx().Text("api"); }
    [HttpGet]
    [Custom(IsMenu = true)]
    public void Inherit() { this.Ctx().Text("login"); }
}

[Route("/authorization/optional")]
[Custom(Authorization = CustomAuthorization.Auth)]
class OptionalDefaultController : Controller {
    [HttpGet]
    public void Index() { this.Ctx().Text("optional"); }
    [HttpGet]
    [Custom(Authorization = CustomAuthorization.Login)]
    public void Protected() { this.Ctx().Text("login"); }
    [HttpGet]
    [Custom(Authorization = CustomAuthorization.ApiAuth)]
    public void Api() { this.Ctx().Text("api"); }
}

[Route("/authorization/default")]
class UndeclaredDefaultController : Controller {
    [HttpGet]
    public void Index() { this.Ctx().Text("default login"); }
    [HttpGet]
    [Custom(Authorization = CustomAuthorization.None)]
    public void Public() { this.Ctx().Text("public"); }
    [HttpGet]
    [Description("Authorization=NoneX")]
    public void UnrelatedText() { this.Ctx().Text("default login"); }
}

class ProbeConnection : IDbConnection {
    bool live = true;
    DbResult Query(string sql) { throw new Exception("SECRET: db credentials"); }
    DbResult Query(string sql, DbParams p) { throw new Exception("SECRET: db credentials"); }
    int Execute(string sql) { return 0; }
    int Execute(string sql, DbParams p) { return 0; }
    string ExecuteScalar(string sql) { return ""; }
    string ExecuteScalar(string sql, DbParams p) { return ""; }
    async DbResult QueryAsync(string sql) { throw new Exception("SECRET: db credentials"); }
    async DbResult QueryAsync(string sql, DbParams p) { throw new Exception("SECRET: db credentials"); }
    async int ExecuteAsync(string sql) { return 0; }
    async int ExecuteAsync(string sql, DbParams p) { return 0; }
    async string ExecuteScalarAsync(string sql) { return ""; }
    async string ExecuteScalarAsync(string sql, DbParams p) { return ""; }
    void BeginTransaction() { }
    void Commit() { }
    void Rollback() { }
    async bool BeginTransactionAsync() { return true; }
    async bool CommitAsync() { return true; }
    async bool RollbackAsync() { return true; }
    bool IsConnected() { return this.live; }
    void Close() { this.live = false; }
    void Dispose() { this.Close(); }
    int GetProvider() { return DbProvider.SQLite; }
}

class ProbeConnector : IDbConnector {
    async IDbConnection ConnectAsync() { return new ProbeConnection(); }
    int GetProvider() { return DbProvider.SQLite; }
}

class Program {
    static int failures;
    static void Check(bool ok, string label) {
        if (!ok) { Program.failures = Program.failures + 1; Console.WriteLine("FAIL " + label); }
    }
    static HttpContext Ctx(string target, string header) {
        HttpRequest req = HttpRequest.Parse("GET " + target + " HTTP/1.1\r\nHost: test\r\n"
            + header + "\r\n");
        return new HttpContext(req, "127.0.0.1");
    }
    static JsonValue Body(HttpContext ctx) {
        string response = ctx.BuildResponse(false);
        int split = response.IndexOf("\r\n\r\n");
        if (split < 0) { return null; }
        return JsonValue.ParseLenient(response.Substring(split + 4));
    }

    static async void DispatchHealthIndex(HttpContext ctx) {
        HealthController c = new HealthController();
        c.Bind(ctx);
        if (await c.BeforeAsync()) {
            await c.Index();
        }
        await c.AfterAsync();
    }

    static async void DispatchHealthReady(HttpContext ctx) {
        HealthController c = new HealthController();
        c.Bind(ctx);
        if (await c.BeforeAsync()) {
            await c.Ready();
        }
        await c.AfterAsync();
    }

    static void Flags(WebApp app, string path, bool login, bool auth) {
        HttpContext ctx = Program.Ctx(path, "");
        Route route = app.Router().Match(ctx);
        Program.Check(route != null, "authorization route exists " + path);
        if (route != null) {
            Program.Check(route.NeedsLogin() == login && route.NeedsAuth() == auth,
                "authorization flags " + path);
        }
    }

    static bool MenuHas(List<MenuNode> nodes, string path) {
        for (int i = 0; i < nodes.Count; i = i + 1) {
            if (nodes[i].Path() == path) { return true; }
        }
        return false;
    }

    static async bool Deny(string uid, string action) { return false; }

    static async void AuthorizationOverrides(WebApp app) {
        Program.Flags(app, "/authorization/public", true, false);
        Program.Flags(app, "/authorization/public/index", true, false);
        Program.Flags(app, "/authorization/public/api", true, true);
        Program.Flags(app, "/authorization/public/granted", true, true);
        Program.Flags(app, "/authorization/public/optional", false, false);
        Program.Flags(app, "/authorization/public/unknown", true, false);
        Program.Flags(app, "/authorization/public/inherit", false, false);
        Program.Flags(app, "/authorization/grant", true, false);
        Program.Flags(app, "/authorization/grant/index", true, false);
        Program.Flags(app, "/authorization/grant/public", false, false);
        Program.Flags(app, "/authorization/grant/optional", false, false);
        Program.Flags(app, "/authorization/grant/inherit", true, true);
        Program.Flags(app, "/authorization/login/public", false, false);
        Program.Flags(app, "/authorization/login/api", true, true);
        Program.Flags(app, "/authorization/login/inherit", true, false);
        Program.Flags(app, "/authorization/optional", false, false);
        Program.Flags(app, "/authorization/optional/index", false, false);
        Program.Flags(app, "/authorization/optional/protected", true, false);
        Program.Flags(app, "/authorization/optional/api", true, true);
        Program.Flags(app, "/authorization/default", true, false);
        Program.Flags(app, "/authorization/default/index", true, false);
        Program.Flags(app, "/authorization/default/public", false, false);
        Program.Flags(app, "/authorization/default/unrelatedtext", true, false);

        app.PermissionResolver(Program.Deny);
        List<MenuNode> anonymous = await MenuBuilder.ForUser(app, "", "");
        Program.Check(!Program.MenuHas(anonymous, "/authorization/public")
            && !Program.MenuHas(anonymous, "/authorization/public/api")
            && !Program.MenuHas(anonymous, "/authorization/public/granted")
            && !Program.MenuHas(anonymous, "/authorization/public/unknown"),
            "class None cannot expose protected action menus to anonymous users");
        Program.Check(Program.MenuHas(anonymous, "/authorization/public/inherit")
            && Program.MenuHas(anonymous, "/authorization/public/optional")
            && Program.MenuHas(anonymous, "/authorization/grant/public")
            && Program.MenuHas(anonymous, "/authorization/grant/optional"),
            "explicit public and optional actions stay available anonymously");
        List<MenuNode> denied = await MenuBuilder.ForUser(app, "42", "");
        Program.Check(Program.MenuHas(denied, "/authorization/public")
            && Program.MenuHas(denied, "/authorization/grant")
            && !Program.MenuHas(denied, "/authorization/public/api")
            && !Program.MenuHas(denied, "/authorization/public/granted")
            && !Program.MenuHas(denied, "/authorization/grant/inherit"),
            "Login overrides require identity without grant while protected actions remain denied");
    }

    static async void Main() {
        string trace = "tr-\"quoted\\path";
        string header = "X-Request-Id: " + trace + "\r\n";
        HttpContext success = Program.Ctx("/api/probe", header);
        ApiProbe api = new ApiProbe();
        api.Bind(success);
        api.Success();
        JsonValue ok = Program.Body(success);
        JsonValue data = ok != null ? ok.Get("data") : null;
        Program.Check(ok != null && ok.Int("code", -1) == 0 && ok.Str("traceId", "") == trace
            && data != null && data.Int("answer", -1) == 42,
            "success envelope escapes trace as valid JSON");
        HttpContext failure = Program.Ctx("/api/probe", header);
        api = new ApiProbe(); api.Bind(failure); api.Reject();
        JsonValue bad = Program.Body(failure);
        Program.Check(bad != null && bad.Int("code", -1) == 401
            && bad.Str("traceId", "") == trace && bad.Str("msg", "") == "bad \"input\" \\ path",
            "failure envelope escapes trace and message");
        HttpContext error = Program.Ctx("/api/probe", header);
        api = new ApiProbe(); api.Bind(error); api.Broken();
        JsonValue internalError = Program.Body(error);
        Program.Check(error.BuildResponse(false).Contains("500 Internal Server Error")
            && internalError != null && internalError.Int("code", -1) == 500
            && internalError.Str("traceId", "") == trace,
            "server error returns JSON trace without internal detail");
        HttpContext noTrace = Program.Ctx("/api/probe", "");
        api = new ApiProbe(); api.Bind(noTrace); api.Success();
        JsonValue plain = Program.Body(noTrace);
        Program.Check(plain != null && plain.Get("traceId") == null
            && plain.Int("code", -1) == 0, "trace omitted when header absent");
        AppServices.Use(null);
        HttpContext unavailable = Program.Ctx("/health?deep=1", "");
        await Program.DispatchHealthIndex(unavailable);
        JsonValue unavailableBody = Program.Body(unavailable);
        Program.Check(unavailable.BuildResponse(false).Contains("503 Service Unavailable")
            && unavailableBody != null && unavailableBody.Str("status", "") == "down"
            && unavailableBody.Str("db", "") == "pool not ready"
            && !unavailable.BuildResponse(false).Contains("\"status\":\"ok\""),
            "deep health reports unavailable pool as down");

        DbPool pool = new DbPool(new ProbeConnector(), 1);
        AppServices.Use(new AppServices(DbContext.Of(pool, null), null));
        HttpContext deep = Program.Ctx("/health?deep=1", "");
        await Program.DispatchHealthIndex(deep);
        JsonValue deepBody = Program.Body(deep);
        Program.Check(deep.BuildResponse(false).Contains("503 Service Unavailable")
            && deepBody != null && deepBody.Str("status", "") == "down"
            && deepBody.Str("db", "") == "unreachable"
            && !deep.BuildResponse(false).Contains("SECRET")
            && !deep.BuildResponse(false).Contains("\"status\":\"ok\""),
            "deep health redacts driver message");
        HttpContext ready = Program.Ctx("/healthz/ready", "");
        await Program.DispatchHealthReady(ready);
        JsonValue readyBody = Program.Body(ready);
        Program.Check(ready.BuildResponse(false).Contains("503 Service Unavailable")
            && readyBody != null && readyBody.Str("status", "") == "down"
            && readyBody.Str("db", "") == "unreachable"
            && !ready.BuildResponse(false).Contains("SECRET"), "readiness redacts driver message");
        pool.Close();
        AppServices.Use(null);

        WebApp app = new WebApp("127.0.0.1", 0);
        __AttrRoutes.RegisterFramework(app);
        __AttrRoutes.Register(app);
        await Program.AuthorizationOverrides(app);
        List<Route> routes = app.Router().All();
        bool hasSum = false;
        bool hasDisable = false;
        bool hasSqlDetail = false;
        bool sqlDetailProtected = false;
        bool bareDataMenu = false;
        for (int i = 0; i < routes.Count; i = i + 1) {
            Route r = routes[i];
            if (r.Pattern() == "/admin/dev/txprobe/sum") { hasSum = true; }
            if (r.Pattern() == "/admin/dev/txprobe/disable"
                || r.Action() == typeof(Zan.Web.Admin.Dev.TxProbeController).FullName + ".Disable") { hasDisable = true; }
            if (r.Pattern() == "/admin/monitor/data" && r.InMenu()) { bareDataMenu = true; }
            if (r.Pattern() == "/admin/monitor/sql/detail") {
                hasSqlDetail = true;
                sqlDetailProtected = r.NeedsAuth() && !r.InMenu();
            }
        }
        Program.Check(hasSum && !hasDisable, "only harmless TxProbe route generated");
        Program.Check(!bareDataMenu, "data manager requires a table-specific menu link");
        Program.Check(hasSqlDetail && sqlDetailProtected,
            "SQL detail route requires grant and stays out of menu");
        ViewData hostile = new ViewData();
        hostile.Set("sql", "<script>\"&</script>");
        string escaped = View.RenderStr("<td title=\"{{sql}}\">{{sql}}</td>", hostile, null);
        Program.Check(escaped.Contains("&lt;script&gt;&quot;&amp;&lt;/script&gt;")
            && !escaped.Contains("<script>"), "monitor SQL text escapes in HTML");
        Console.WriteLine("failures=" + Convert.ToString(Program.failures));
        if (Program.failures != 0) { throw new Exception("route security regression"); }
    }
}
