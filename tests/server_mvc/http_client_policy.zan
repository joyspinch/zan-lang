using System;
using System.Net.External;
using System.Net.Http;
using System.Net.Http.Client;

class Program {
    static async int Run() {
        HttpClient client = new HttpClient("127.0.0.1", 1);
        client.SetCallPolicy(ExternalCallPolicy.Default().RequestLimit(4));
        try {
            string _body = await client.PostAsync("/never", "12345");
            Console.WriteLine("request-limit:bad");
        } catch (HttpRequestException e) {
            Console.WriteLine(e.Message.Contains("request body exceeds")
                ? "request-limit:ok" : "request-limit:bad");
        }
        Console.WriteLine(!ExternalTargetPolicy.IsLocalAllowed(
            "http://example.com/a") ? "local-public-deny:ok"
            : "local-public-deny:bad");
        return 0;
    }

    static async void Main() {
        int _rc = await Program.Run();
    }
}
