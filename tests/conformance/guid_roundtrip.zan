// 核心契约与语义定义。
// 核心契约与语义定义。
using System;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        string id = Guid.New();
        if (id.Length != 36) { bad = bad + 1; }
        if (id == "") { bad = bad + 1; }
        // 核心契约与执行状态转移规范。
        if (id.Substring(14, 1) != "4") { bad = bad + 1; }
        // 核心契约与执行状态转移规范。
        string variant = id.Substring(19, 1).ToLower();
        if (variant != "8" && variant != "9" && variant != "a" && variant != "b") { bad = bad + 1; }
        // 核心契约与执行状态转移规范。
        Guid g = Guid.Parse(id);
        if (g == null) { bad = bad + 1; }
        else {
            if (Guid.ToString(g) != id) { bad = bad + 1; }
        }
        // 核心契约与语义定义。
        if (Guid.New() == id) { bad = bad + 1; }
        // 核心契约与执行状态转移规范。
        if (Guid.Parse("not-a-guid") != null) { bad = bad + 1; }
        if (Guid.Parse(id.Substring(0, 35)) != null) { bad = bad + 1; }
        if (Guid.Parse(id.Substring(0, 8) + "x" + id.Substring(9, 27)) != null) { bad = bad + 1; }
        Console.WriteLine("guid-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
