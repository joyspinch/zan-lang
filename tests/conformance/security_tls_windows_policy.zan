using System;
using System.Net.Tls;
using System.Security.Cryptography;

class Program {
    #if WINDOWS
    [DllImport("crt", EntryPoint = "zan_io_crypto_windows_ssl_policy")]
    static extern int WindowsSslPolicy(nint certs, int totalLen, int count, nint host, int hostLen);
    #endif

    // Fixed locally issued, RSA-SHA256 test CA and TLS server leaf (2026-2036).
    // Neither certificate is installed in a system trust store.
    static string Root = "";
    static string Leaf = "";
    static int failures = 0;
    static void Check(bool pass, string label) {
        if (pass) { Console.WriteLine("ok " + label); }
        else { Console.WriteLine("FAIL " + label); failures = failures + 1; }
    }
    static X509Certificate Decode(string text) {
        List<int> length = new List<int>(); length.Add(0);
        byte[] der = Base64.Decode(text, length);
        return der == null ? null : X509Certificate.ParseForTls(der, length[0]);
    }
    static byte[] Pack(X509Certificate leaf, X509Certificate root) {
        byte[] a = leaf.RawDer(); byte[] b = root.RawDer();
        int an = leaf.RawDerLen(); int bn = root.RawDerLen();
        byte[] packed = new byte[8 + an + bn];
        packed[0] = (byte)(an & 255); packed[1] = (byte)((an >> 8) & 255);
        packed[2] = (byte)((an >> 16) & 255); packed[3] = (byte)((an >> 24) & 255);
        NativeMemory.Copy((nint)packed + 4, a, an);
        int off = 4 + an;
        packed[off] = (byte)(bn & 255); packed[off + 1] = (byte)((bn >> 8) & 255);
        packed[off + 2] = (byte)((bn >> 16) & 255); packed[off + 3] = (byte)((bn >> 24) & 255);
        NativeMemory.Copy((nint)packed + (nint)(off + 4), b, bn);
        return packed;
    }
    static TlsEngine Client(X509Certificate leaf, X509Certificate root, bool custom, string host) {
        List<X509Certificate> anchors = null;
        if (custom) { anchors = new List<X509Certificate>(); anchors.Add(root); }
        TlsEngine engine = new TlsEngine(host, false, true, null, false, null, anchors, false, "", "");
        engine.peerCert = leaf; engine.peerChain.Add(leaf); engine.peerChain.Add(root);
        return engine;
    }
    static void Main() {
        #if WINDOWS
        X509Certificate root = Decode(Root); X509Certificate leaf = Decode(Leaf);
        Check(root != null && leaf != null, "local DER fixture parses");
        if (root == null || leaf == null) { Console.WriteLine("failures=" + Convert.ToString(failures)); return; }
        byte[] chain = Pack(leaf, root);
        Check(chain.Length == 8 + leaf.RawDerLen() + root.RawDerLen(), "packed chain length");
        byte[] leafCopy = new byte[leaf.RawDerLen()]; byte[] rootCopy = new byte[root.RawDerLen()];
        NativeMemory.Copy(leafCopy, (nint)chain + 4, leafCopy.Length);
        NativeMemory.Copy(rootCopy, (nint)chain + (nint)(8 + leafCopy.Length), rootCopy.Length);
        Check(X509Certificate.ParseForTls(leafCopy, leafCopy.Length) != null
            && X509Certificate.ParseForTls(rootCopy, rootCopy.Length) != null, "packed certificate DER intact");
        string good = "secure.example"; string wrong = "other.example";
        Check(WindowsSslPolicy((nint)chain, chain.Length, 2, (nint)good, good.Length) == 0,
            "peer-supplied root is not OS trusted");
        Check(WindowsSslPolicy((nint)chain, chain.Length, 2, (nint)wrong, wrong.Length) == 0,
            "OS SSL policy rejects wrong host");
        Check(WindowsSslPolicy((nint)chain, chain.Length - 1, 2, (nint)good, good.Length) == 0,
            "truncated DER list rejected");
        Check(WindowsSslPolicy((nint)chain, chain.Length, 2, (nint)good, 0) == 0,
            "empty hostname rejected");
        Check(Client(leaf, root, true, good).VerifyCertificate() == 0,
            "explicit signed CA accepted separately");
        Check(Client(leaf, root, false, good).VerifyCertificate() < 0,
            "peer-provided root does not anchor TLS");
        Check(Client(leaf, root, true, wrong).VerifyCertificate() < 0,
            "explicit CA cannot bypass wrong hostname");
        #endif
        Console.WriteLine("failures=" + Convert.ToString(failures));
    }
}
