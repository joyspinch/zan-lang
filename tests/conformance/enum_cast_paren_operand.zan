// Conformance: `(EnumType)(expression)` parses as a cast, not a call.
// paren_is_named_cast documented a nested-parenthesis operand as a legal
// cast shape but omitted TK_LPAREN, so computed operands fell through to
// call parsing and name resolution reported "has no member '<Type>'".
using System;

enum Shade { Dark = 1, Mid = 2, Light = 4 }

class Program {
    static int Value(Shade shade) { return (int)shade; }
    static void Main() {
        int i = 2;
        Shade direct = (Shade)i;
        Shade computed = (Shade)(i + 2);
        Shade nested = (Shade)((i - 1) * 2);
        Shade argument = (Shade)(i % 2 + 2);
        Console.WriteLine(Value(direct).ToString());
        Console.WriteLine(Value(computed).ToString());
        Console.WriteLine(Value(nested).ToString());
        Console.WriteLine(Value(argument).ToString());
    }
}
