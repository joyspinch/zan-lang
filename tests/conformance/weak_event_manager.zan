using System;

class Subscriber {
    public string name;
    public int receivedCount;

    public Subscriber(string name) {
        this.name = name;
        this.receivedCount = 0;
    }

    public void OnEvent(string msg) {
        this.receivedCount = this.receivedCount + 1;
        Console.WriteLine(this.name + " received: " + msg);
    }
}

class Program {
    static void DispatchToSub(Subscriber s, string msg) {
        s.OnEvent(msg);
    }

    static void Main() {
        Console.WriteLine("[1] Testing WeakEventManager subscription & dispatch...");
        WeakEventManager<Subscriber, string> manager = new WeakEventManager<Subscriber, string>();

        Subscriber sub1 = new Subscriber("Sub1");
        Subscriber sub2 = new Subscriber("Sub2");

        manager.AddHandler(sub1, DispatchToSub);
        manager.AddHandler(sub2, DispatchToSub);

        Console.WriteLine("Active subscribers before raise: " + Convert.ToString(manager.Count));
        manager.Raise("Event 1: Hello Zan");

        if (sub1.receivedCount == 1 && sub2.receivedCount == 1) {
            Console.WriteLine("PASS: both subscribers received event");
        } else {
            Console.WriteLine("FAIL: receivedCount mismatch");
        }

        Console.WriteLine("[2] Testing WeakReference state after subscription...");
        Console.WriteLine("Active subscribers: " + Convert.ToString(manager.Count));

        Console.WriteLine("OK: all weak event manager checks passed!");
    }
}
