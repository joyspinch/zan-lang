using System;
using System.Collections.Generic;
using Game.Arpg;

namespace T;

class Program {
    static void Main() {
        ArpgTween tw = new ArpgTween()
            .Add(ArpgTweenStep.To("地图按钮", 300, ArpgEasing.BackOut).Set("y", -100.0).Set("x", 100.0))
            .Add(ArpgTweenStep.Wait(200))
            .Add(ArpgTweenStep.By("地图按钮", 300, ArpgEasing.QuadInOut).Set("y", 100.0))
            .Add(ArpgTweenStep.Call("完成回调"));

        Console.WriteLine("steps=" + Convert.ToString(tw.StepCount()));
        Console.WriteLine("total=" + Convert.ToString(tw.TotalDuration()));

        ArpgTweenStep s0 = tw.StepAt(0);
        Console.WriteLine("s0op=" + s0.Op());
        Console.WriteLine("s0dur=" + Convert.ToString(s0.Duration()));
        Console.WriteLine("s0props=" + Convert.ToString(s0.PropCount()));

        ArpgTweenStep s1 = tw.StepAt(1);
        Console.WriteLine("s1op=" + s1.Op());

        ArpgTweenStep s2 = tw.StepAt(2);
        Console.WriteLine("s2op=" + s2.Op());

        ArpgTweenStep s3 = tw.StepAt(3);
        Console.WriteLine("s3op=" + s3.Op());

        int easeCount = 0;
        ArpgEasing e = ArpgEasing.BounceInOut;
        if (e == ArpgEasing.BounceInOut) { easeCount = 31; }
        Console.WriteLine("easeLast=" + Convert.ToString(easeCount));
    }
}
