using System;

class Program {
    static void TestNullableInt() {
        int? a = 100;
        int? b = null;

        if (a.HasValue) {
            Console.WriteLine(a.Value);
        }
        if (!b.HasValue) {
            Console.WriteLine("b is null");
        }

        int valA = a ?? 0;
        int valB = b ?? -1;
        Console.WriteLine(valA);
        Console.WriteLine(valB);
    }

    static void TestNullableDouble() {
        double? d1 = 3.14;
        double? d2 = null;

        Console.WriteLine(d1.HasValue ? "d1 has value" : "d1 null");
        Console.WriteLine(d2.HasValue ? "d2 has value" : "d2 null");
    }

    static void Main() {
        TestNullableInt();
        TestNullableDouble();
        Console.WriteLine("ALL NULLABLE TESTS PASSED");
    }
}
