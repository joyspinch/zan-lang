using System;
using System.Collections.Generic;

// A nested type is a legal array element type.
//
// The parser wraps the element type in a synthetic AST_TYPE_REF (the element
// node itself hangs off `array_element`). The name-resolution pass used to
// rewrite only the wrapper's name and never descend into the element, so a
// qualified element type kept its dotted spelling -- "Outer.Inner" -- and the
// binder's scope lookup could not find it: "undefined type 'Outer.Inner'".
public class Outer {
    public class Inner {
        public int v;
        public Inner() { this.v = 0; }
    }
}

class Program {
    static void Main() {
        // a one-dimensional array of the nested type
        Outer.Inner[] a = new Outer.Inner[3];
        a[0] = new Outer.Inner();
        a[0].v = 42;
        Console.WriteLine("a0=" + a[0].v);
        Console.WriteLine("alen=" + a.Length);

        // a two-dimensional array of the nested type
        Outer.Inner[][] g = new Outer.Inner[2][];
        g[0] = new Outer.Inner[2];
        g[0][1] = new Outer.Inner();
        g[0][1].v = 7;
        Console.WriteLine("g01=" + g[0][1].v);

        // the same nested type in a generic argument and in a plain slot
        List<Outer.Inner> l = new List<Outer.Inner>();
        l.Add(new Outer.Inner());
        Outer.Inner one = l[0];
        Console.WriteLine("one=" + one.v);
    }
}
