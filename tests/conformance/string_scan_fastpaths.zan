using System;
using System.Collections.Generic;

// 长度驱动的 Split / Replace / IndexOf(char) / int.Parse 快路径：
// 单字节与多字节分隔符、重叠匹配、短/长区间（逐字节扫与 libc memchr 两条路）、
// 非 ASCII 字符分隔符、等长/变长/无命中替换、十进制解析的快慢路径边界。
class Program {
    static void Dump(string tag, List<string> parts) {
        string acc = tag + " n=" + parts.Count.ToString() + ":";
        for (int i = 0; i < parts.Count; i++) {
            acc = acc + " [" + parts[i] + "/" + parts[i].Length.ToString() + "]";
        }
        Console.WriteLine(acc);
    }

    static void ParseOne(string s) {
        try {
            long v = long.Parse(s);
            Console.WriteLine("long.Parse(" + s + ")=" + v.ToString());
        } catch (Exception e) {
            Console.WriteLine("long.Parse(" + s + ") threw " + e.GetType().Name);
        }
        try {
            int v = int.Parse(s);
            Console.WriteLine("int.Parse(" + s + ")=" + v.ToString());
        } catch (Exception e) {
            Console.WriteLine("int.Parse(" + s + ") threw " + e.GetType().Name);
        }
    }

    static void Main() {
        Dump("char", "alpha,beta,,gamma,".Split(','));
        Dump("str1", "alpha,beta,,gamma,".Split(","));
        Dump("rm", "alpha,beta,,gamma,".Split(',', StringSplitOptions.RemoveEmptyEntries));
        Dump("multi", "a::b:::c::".Split("::"));
        Dump("overlap", "aaaaa".Split("aa"));
        Dump("nosep", "plain".Split(';'));
        Dump("empty", "".Split(','));
        Dump("emptyrm", "".Split(',', StringSplitOptions.RemoveEmptyEntries));
        Dump("longsep", "ab".Split("abc"));
        Dump("utf8", "一·二·三".Split('·'));
        Dump("cjk", "甲乙丙乙丁".Split('乙'));
        string sep = ",";
        Dump("var", "x,y".Split(sep));
        char c = '|';
        Dump("charvar", "p|q|r".Split(c));
        string longLine = "0123456789012345678901234567890123456789,tail,0123456789abcdefghij0123456789abcdefghij";
        Dump("long", longLine.Split(','));

        string s = "banana bandana";
        Console.WriteLine("eq=" + s.Replace("an", "AN") + "/" + s.Replace("an", "AN").Length.ToString());
        Console.WriteLine("grow=" + s.Replace("a", "<a>") + "/" + s.Replace("a", "<a>").Length.ToString());
        Console.WriteLine("shrink=" + s.Replace("ana", "_") + "/" + s.Replace("ana", "_").Length.ToString());
        Console.WriteLine("none=" + s.Replace("xyz", "Q") + "/" + s.Replace("xyz", "Q").Length.ToString());
        Console.WriteLine("del=" + s.Replace(" ", "") + "/" + s.Replace(" ", "").Length.ToString());
        Console.WriteLine("chars=" + s.Replace('a', 'o'));
        Console.WriteLine("utf8=" + "a·b·c".Replace('·', '-') + "/" + "a·b·c".Replace('·', '-').Length.ToString());
        Console.WriteLine("whole=" + "abc".Replace("abc", "xyz12"));
        Console.WriteLine("lastlong=" + "0123456789012345678901234567890123456789x".Replace("x", "!"));

        string word = "mississippi";
        Console.WriteLine("idx s=" + word.IndexOf('s').ToString() + " p=" + word.IndexOf('p').ToString()
            + " z=" + word.IndexOf('z').ToString() + " from5=" + word.IndexOf('s', 5).ToString());
        string longWord = "abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz#";
        Console.WriteLine("idx long=" + longWord.IndexOf('#').ToString() + " miss=" + longWord.IndexOf('!').ToString());

        Console.WriteLine("trim=[" + "  pad  ".Trim() + "]/" + "  pad  ".Trim().Length.ToString());
        Console.WriteLine("upper=" + "MiXed".ToUpper() + "/" + "MiXed".ToUpper().Length.ToString());

        ParseOne("0");
        ParseOne("-0");
        ParseOne("12345");
        ParseOne("-2147483648");
        ParseOne("2147483648");
        ParseOne("123456789012345678");
        ParseOne("-123456789012345678");
        ParseOne("1234567890123456789");
        ParseOne("9223372036854775807");
        ParseOne("-9223372036854775808");
        ParseOne("9223372036854775808");
        ParseOne("99999999999999999999");
        ParseOne(" 42");
        ParseOne("+42");
        ParseOne("42x");
        ParseOne("-");
        ParseOne("");
        ParseOne("abc");
        long total = 0;
        for (int i = 0; i < 1000; i++) {
            string t = Convert.ToString(i * 7919 - 3000000);
            total += int.Parse(t) + t.Length;
        }
        Console.WriteLine("roundtrip=" + total.ToString());
    }
}
