using System;

class Base {
    public string tag = BTag();
    static string BTag() { Console.WriteLine("b-init"); return "b-field"; }
    public Base() { Console.WriteLine("base-ctor tag=" + tag); tag = tag + ":B"; }
    public Base(string s) { Console.WriteLine("base-ctor(" + s + ") tag=" + tag); tag = tag + ":B" + s; }
}

class Derived : Base {
    public string dtag = DTag();
    static string DTag() { Console.WriteLine("d-init"); return "d-field"; }
    public Derived() { Console.WriteLine("derived-ctor dtag=" + dtag + " tag=" + tag); }
    public Derived(string s) : base(s) { Console.WriteLine("derived-ctor(s)"); }
}

class Program {
    static void Main() {
        Console.WriteLine("-- no-arg --");
        Derived d = new Derived();
        Console.WriteLine("-- base-arg --");
        Derived e = new Derived("x");
        Console.WriteLine("tags=" + d.tag + "|" + d.dtag + "|" + e.tag);
    }
}
