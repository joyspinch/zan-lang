using System;
using System.Json;
using Sdk.Wechat;

namespace WechatSdkTest;

/// Offline conformance for the WeChat MP SDK core: CheckSignature, response
/// envelope / errcode handling, client construction. No network involved.
class Program {
    static void TestSignature() {
        // token=weixin, timestamp=1234567890, nonce=nonce
        // sorted join = "1234567890nonceweixin"
        // sha1 = c87323fc8da5707932971d7c0e3fe3f493c95422
        string sig = CheckSignature.GetSignature("1234567890", "nonce", "weixin");
        Console.WriteLine("sig=" + sig);
        Console.WriteLine("sigOk=" + Convert.ToString(
            CheckSignature.Check("c87323fc8da5707932971d7c0e3fe3f493c95422",
                                 "1234567890", "nonce", "weixin")));
        Console.WriteLine("sigBad=" + Convert.ToString(
            CheckSignature.Check("deadbeef", "1234567890", "nonce", "weixin")));

        // Insertion order of the three strings must not matter: sorting is required.
        string a = CheckSignature.GetSignature("nonce", "token", "1417509300");
        string b = CheckSignature.GetSignature("1417509300", "nonce", "token");
        Console.WriteLine("orderStable=" + Convert.ToString(a == b));
        Console.WriteLine("sig2=" + a);
    }

    static void TestTokenResponse() {
        string body = "{\"access_token\":\"TOKEN_ABC\",\"expires_in\":7200}";
        WechatResponse resp = WechatResponse.Parse(body);
        Console.WriteLine("token=" + resp.Str("access_token", ""));
        Console.WriteLine("expires=" + Convert.ToString(resp.Int("expires_in", 0)));
    }

    static void TestSuccessWithErrcodeZero() {
        string body = "{\"errcode\":0,\"errmsg\":\"ok\",\"msgid\":12345}";
        WechatResponse resp = WechatResponse.Parse(body);
        Console.WriteLine("msgid=" + Convert.ToString(resp.Int("msgid", 0)));
        Console.WriteLine("errmsg=" + resp.Str("errmsg", ""));
    }

    static void TestApiError() {
        string body = "{\"errcode\":40013,\"errmsg\":\"invalid appid\"}";
        try {
            WechatResponse resp = WechatResponse.Parse(body);
            Console.WriteLine("apiError=NOT THROWN");
        } catch (WechatException e) {
            Console.WriteLine("apiError code=" + e.Code);
            Console.WriteLine("apiError raw=" + Convert.ToString(e.Body.Length > 0));
        }
    }

    static void TestMalformed() {
        string body = "<html>bad gateway</html>";
        try {
            WechatResponse resp = WechatResponse.Parse(body);
            Console.WriteLine("malformed=NOT THROWN");
        } catch (WechatException e) {
            Console.WriteLine("malformed code=" + e.Code);
        }
    }

    static void TestSendTextBody() {
        // Mirror the JSON body WechatClient.SendTextAsync builds, without network.
        JsonValue text = JsonValue.NewObject();
        text.Put("content", JsonValue.NewStr("hello \"world\""));
        JsonValue body = JsonValue.NewObject();
        body.Put("touser", JsonValue.NewStr("OPENID"));
        body.Put("msgtype", JsonValue.NewStr("text"));
        body.Put("text", text);
        Console.WriteLine("sendBody=" + body.ToJson());
    }

    static void TestClientBuilt() {
        WechatClient client = new WechatClient("app", "secret");
        client.Timeout(5000).Server("api.weixin.qq.com", 443);
        client.SetAccessToken("cached-token", 7200);
        Console.WriteLine("clientBuilt=ok");
    }

    static void Main() {
        TestSignature();
        TestTokenResponse();
        TestSuccessWithErrcodeZero();
        TestApiError();
        TestMalformed();
        TestSendTextBody();
        TestClientBuilt();
    }
}
