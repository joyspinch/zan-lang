using System;

namespace Conf;

class Prog {
    [DllImport("zan_gui", EntryPoint = "zan_gui_create_surface")]
    static extern int CreateSurface(int w, int h);

    [DllImport("zan_gui", EntryPoint = "zan_gui_destroy_surface")]
    static extern int DestroySurface(int id);

    [DllImport("zan_gui", EntryPoint = "zan_gui_clear")]
    static extern void Clear(int surface, int color);

    [DllImport("zan_gui", EntryPoint = "zan_gui_fill_rect")]
    static extern void FillRect(int surface, int x, int y, int w, int h, int color);

    [DllImport("zan_game", EntryPoint = "zan_game_bake_sprite")]
    static extern int BakeSprite(string key, int surface, int x, int y, int w, int h);

    [DllImport("zan_game", EntryPoint = "zan_game_sprite_handle")]
    static extern int SpriteHandle(string key);

    [DllImport("zan_image", EntryPoint = "zan_image_get")]
    static extern nint ImageView(string path);

    [DllImport("zan_gui", EntryPoint = "zan_gui_blit_pixels")]
    static extern void BlitPixels(int surface, nint bitmap, int dx, int dy, int dw, int dh, int sx, int sy, int sw, int sh);

    [DllImport("zan_game", EntryPoint = "zan_game_sprite_batch")]
    static extern void SpriteBatch(int surface, int handle, nint quads, int count);

    [DllImport("zan_gui", EntryPoint = "zan_gui_get_pixels")]
    static extern nint GetPixels(int surface);

    static void Main() {
        int s1 = Prog.CreateSurface(64, 64);
        Prog.Clear(s1, 0);
        Prog.FillRect(s1, 0, 0, 32, 32, 0xFF00FF00); // 0xAARRGGBB opaque green
        int h1 = Prog.BakeSprite("test_box", s1, 0, 0, 32, 32);
        Console.WriteLine("handle: " + Convert.ToString(h1 > 0 ? 1 : 0));

        // 核心契约与语义定义。
        int s2 = Prog.CreateSurface(64, 64);
        Prog.Clear(s2, 0);
        Prog.BlitPixels(s2, Prog.ImageView("mem:test_box"), 10, 10, 32, 32, 0, 0, 0, 0);

        nint pix2 = Prog.GetPixels(s2);
        Span<int> span2 = new Span<int>(pix2, 64 * 64);
        int val2 = span2[10 * 64 + 10];
        Console.WriteLine("blit_pix_match: " + Convert.ToString((val2 & 0x00FFFFFF) == 0x00FF00 ? 1 : 0));
        Console.WriteLine("blit_bg_clean: " + Convert.ToString(span2[0] == 0 ? 1 : 0));

        // 核心契约与语义定义。
        int s3 = Prog.CreateSurface(64, 64);
        Prog.Clear(s3, 0);

        nint qbuf = NativeMemory.Alloc(40);
        Span<float> qspan = new Span<float>(qbuf, 10);
        qspan[0] = 5.0f; // dx
        qspan[1] = 5.0f; // dy
        qspan[2] = 32.0f; // dw
        qspan[3] = 32.0f; // dh
        qspan[4] = 0.0f; // sx
        qspan[5] = 0.0f; // sy
        qspan[6] = 32.0f; // sw
        qspan[7] = 32.0f; // sh
        new Span<int>(qbuf + 32, 1)[0] = -1;
        qspan[9] = 0.0f;

        Prog.SpriteBatch(s3, h1, qbuf, 1);
        NativeMemory.Free(qbuf);

        nint pix3 = Prog.GetPixels(s3);
        Span<int> span3 = new Span<int>(pix3, 64 * 64);
        int val3 = span3[5 * 64 + 5];
        Console.WriteLine("batch_pix_match: " + Convert.ToString((val3 & 0x00FFFFFF) == 0x00FF00 ? 1 : 0));
        Console.WriteLine("batch_bg_clean: " + Convert.ToString(span3[0] == 0 ? 1 : 0));

        Prog.DestroySurface(s1);
        Prog.DestroySurface(s2);
        Prog.DestroySurface(s3);
        Console.WriteLine("done");
    }
}
