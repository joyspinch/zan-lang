using System;

// 解析失败异常分流（C# 口径）：格式错抛 FormatException，数值越界抛
// OverflowException——曾共用一条带 "(or out of range)" 的消息，被 guard
// 关键词匹配整体误判成 IndexOutOfRangeException；long.Parse 曾按 INT32
// 边界判越界，合法值 3000000000 / MaxValue 被误杀。int.TryParse 不抛只回
// false；StringView.ToInt32/ToInt64 显式默认值路径覆盖 MinValue/溢出边界。
class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            failures = failures + 1;
            Console.WriteLine("FAIL " + name);
        }
    }

    static void Main() {
        try {
            int.Parse("abc");
            Check(false, "int.Parse format throws FormatException");
        } catch (FormatException) {
            Check(true, "int.Parse format throws FormatException");
        }

        try {
            int.Parse("99999999999");
            Check(false, "int.Parse overflow throws OverflowException");
        } catch (OverflowException) {
            Check(true, "int.Parse overflow throws OverflowException");
        }

        try {
            int v = int.Parse("-2147483648");
            Check(v == -2147483648, "int.Parse MinValue parses");
        } catch (Exception) {
            Check(false, "int.Parse MinValue parses");
        }

        try {
            long v = long.Parse("3000000000");
            Check(v == 3000000000L, "long.Parse mid-range value parses");
        } catch (Exception) {
            Check(false, "long.Parse mid-range value parses");
        }

        try {
            long v = long.Parse("9223372036854775807");
            Check(v == 9223372036854775807L, "long.Parse MaxValue parses");
        } catch (Exception) {
            Check(false, "long.Parse MaxValue parses");
        }

        try {
            long.Parse("99999999999999999999");
            Check(false, "long.Parse overflow throws OverflowException");
        } catch (OverflowException) {
            Check(true, "long.Parse overflow throws OverflowException");
        }

        try {
            long.Parse("xyz");
            Check(false, "long.Parse format throws FormatException");
        } catch (FormatException) {
            Check(true, "long.Parse format throws FormatException");
        }

        try {
            double.Parse("xx");
            Check(false, "double.Parse format throws FormatException");
        } catch (FormatException) {
            Check(true, "double.Parse format throws FormatException");
        }

        try {
            Convert.ToInt32("12abc");
            Check(false, "Convert.ToInt32 format throws FormatException");
        } catch (FormatException) {
            Check(true, "Convert.ToInt32 format throws FormatException");
        }

        try {
            Convert.ToInt32(3000000000L);
            Check(false, "Convert.ToInt32(long) overflow throws OverflowException");
        } catch (OverflowException) {
            Check(true, "Convert.ToInt32(long) overflow throws OverflowException");
        }

        try {
            Convert.ToInt64("99999999999999999999");
            Check(false, "Convert.ToInt64 overflow throws OverflowException");
        } catch (OverflowException) {
            Check(true, "Convert.ToInt64 overflow throws OverflowException");
        }

        try {
            Convert.ToDouble("1.2.3");
            Check(false, "Convert.ToDouble format throws FormatException");
        } catch (FormatException) {
            Check(true, "Convert.ToDouble format throws FormatException");
        }

        int okv = 0;
        bool ok1 = int.TryParse("123", out okv);
        Check(ok1 && okv == 123, "int.TryParse accepts 123");
        bool ok2 = int.TryParse("abc", out okv);
        Check(!ok2 && okv == 0, "int.TryParse rejects abc");

        StringView sv = StringView.FromString("-2147483648");
        Check(sv.ToInt32(0) == -2147483648, "StringView.ToInt32 MinValue");
        StringView sv2 = StringView.FromString("2147483647");
        Check(sv2.ToInt32(0) == 2147483647, "StringView.ToInt32 MaxValue");
        StringView sv3 = StringView.FromString("2147483648");
        Check(sv3.ToInt32(-1) == -1, "StringView.ToInt32 overflow to dflt");
        StringView sv4 = StringView.FromString("-9223372036854775808");
        Check(sv4.ToInt64(0L) == -9223372036854775807L - 1L, "StringView.ToInt64 MinValue");
        StringView sv5 = StringView.FromString("9223372036854775807");
        Check(sv5.ToInt64(0L) == 9223372036854775807L, "StringView.ToInt64 MaxValue");
        StringView sv6 = StringView.FromString("99999999999999999999");
        Check(sv6.ToInt64(-5L) == -5L, "StringView.ToInt64 overflow to dflt");
        StringView sv7 = StringView.FromString("12x");
        Check(sv7.ToInt32(-1) == -1, "StringView.ToInt32 bad format to dflt");

        Console.WriteLine("failures=" + failures);
    }
}
