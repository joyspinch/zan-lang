using System;
using System.IO;

class Program {
    static void Main() {
        string tmpFile = "test_filestream_lifecycle.tmp.txt";
        if (File.Exists(tmpFile)) {
            File.Delete(tmpFile);
        }

        // 1. 写入数据
        FileStream fsWrite = FileStream.OpenWrite(tmpFile);
        fsWrite.Write("Hello, Zan Industrial Stream!");
        fsWrite.Flush();
        Console.WriteLine("written_len=" + Convert.ToString(fsWrite.Length()));
        fsWrite.Close();
        Console.WriteLine("write_closed=" + (fsWrite.IsClosed() ? "true" : "false"));

        // 2. 读取并以 Stream 多态使用
        Stream s = FileStream.OpenRead(tmpFile);
        Console.WriteLine("can_read=" + (s.CanRead() ? "true" : "false"));
        Console.WriteLine("can_seek=" + (s.CanSeek() ? "true" : "false"));
        string content = s.ReadToEnd();
        Console.WriteLine("content=" + content);

        // 3. 多态转为 IDisposable 并安全 Dispose
        IDisposable disp = s;
        disp.Dispose();
        Console.WriteLine("stream_disposed");

        if (File.Exists(tmpFile)) {
            File.Delete(tmpFile);
        }
        Console.WriteLine("ok");
    }
}
