// Same-arity overloads must be typed by the argument that irgen dispatches.
// An arity-only checker picks Register(callback)->Overloaded for the string
// call below, rejecting the valid async string return. Exercise bare/this and
// ordinary instance calls, including overloads declared in either order.
using System;

async delegate string MessageHandler(string message);

class Overloaded {
    Overloaded OnMessage(MessageHandler cb) { return this; }
    async string OnMessage(string message) { return message; }

    async string Bare(string message) { return await OnMessage(message); }
    async string Explicit(string message) { return await this.OnMessage(message); }
}

class ReverseOrder {
    string Get(string s) { return s; }
    int Get(int n) { return n; }
    string Bare(string s) { return Get(s); }
    int Explicit(int n) { return this.Get(n); }
}

class Program {
    static async void Main() {
        Overloaded w = new Overloaded();
        Console.WriteLine(await w.Bare("bare"));
        Console.WriteLine(await w.Explicit("explicit"));
        Console.WriteLine(await w.OnMessage("instance"));
        ReverseOrder r = new ReverseOrder();
        Console.WriteLine(r.Bare("text"));
        Console.WriteLine(r.Explicit(42));
        // Assert both directions: string selects string, int selects int.
        Console.WriteLine(r.Get("selected-string"));
        Console.WriteLine(r.Get(7));
    }
}
