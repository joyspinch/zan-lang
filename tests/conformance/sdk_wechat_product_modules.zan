    static async void CompileSurface(WechatWorkClient work,
                                     WechatWxOpenClient wxOpen,
                                     WechatOpenClient open) {
        WechatWorkAppApi app = new WechatWorkAppApi(work);
        WechatResponse a = await app.GetAppInfoAsync("agentid=1");
        WechatWorkChatApi chat = new WechatWorkChatApi(work);
        WechatResponse b = await chat.CreateChatAsync("", "{}");
        WechatWxOpenDataCubeApi cube = new WechatWxOpenDataCubeApi(wxOpen);
        WechatResponse c = await cube.GetWeAnalysisAppidDailySummaryTrendAsync("", "{}");
        WechatOpenComponentApi component = new WechatOpenComponentApi(open);
        WechatResponse d = await component.GetComponentAccessTokenAsync("", "{}");
        WechatOpenQRConnectApi qr = new WechatOpenQRConnectApi(open);
        WechatResponse e = await qr.GetAccessTokenAsync("appid=x&secret=y&code=z");
    }

