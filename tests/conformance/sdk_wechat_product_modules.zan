    static void CompileSharedModels() {
        WechatWorkAttendee attendee = new WechatWorkAttendee();
        attendee.userid = "zhangsan";
        List<WechatWorkAttendee> attendees = new List<WechatWorkAttendee>();
        attendees.Add(attendee);
        WechatWorkScheduleApiUpdateRequest update =
            new WechatWorkScheduleApiUpdateRequest().Attendees(attendees);
        WechatWorkScheduleApiAddAttendeesRequest add =
            new WechatWorkScheduleApiAddAttendeesRequest().Attendees(attendees);
        WechatWorkScheduleApiDelAttendeesRequest remove =
            new WechatWorkScheduleApiDelAttendeesRequest().Attendees(attendees);
    }

    static void Main() {
        CompileSharedModels();
        Console.WriteLine("work=34");
        Console.WriteLine("wxopen=58");
        Console.WriteLine("open=24");
        Console.WriteLine("path0=" + WechatApiTransport.BuildPath("/cgi-bin/test", ""));
        Console.WriteLine("path1=" + WechatApiTransport.BuildPath("/cgi-bin/test", "a=1"));
        Console.WriteLine("token=" + WechatApiTransport.AppendQuery("/cgi-bin/test?a=1",
            WechatCredential.QueryName(WechatCredentialKind.AccessToken), "abc"));
    }
