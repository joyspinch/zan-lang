using System;

class LocalItem {
    public string Text;
    public LocalItem(string text) { Text = text; }
}

struct LocalRecord {
    public string Text;
    public LocalItem Item;
    public int[] Numbers;
    public long Stamp;
}

class StructLocalInit {
    static void Check(bool ok) {
        if (!ok) { throw new Exception("struct local initialization"); }
    }

    static LocalRecord Make(int number) {
        LocalRecord result;
        result.Text = "first-" + Convert.ToString(number);
        result.Item = new LocalItem("item-" + Convert.ToString(number));
        result.Numbers = new int[] { number, number + 1 };
        result.Stamp = 1234567890123L + number;
        result.Text = "final-" + Convert.ToString(number);
        return result;
    }

    static void Inspect(LocalRecord value, int number) {
        Check(value.Text == "final-" + Convert.ToString(number));
        Check(value.Item.Text == "item-" + Convert.ToString(number));
        Check(value.Numbers[0] == number);
        Check(value.Numbers[1] == number + 1);
        Check(value.Stamp == 1234567890123L + number);
    }

    static void Empty() {
        LocalRecord unused;
    }

    static void Main() {
        for (int i = 0; i < 32; i++) {
            Empty();
            LocalRecord value = Make(i);
            Inspect(value, i);
            Inspect(value, i);
            Check(value.Text == "final-" + Convert.ToString(i));
            Check(value.Item.Text == "item-" + Convert.ToString(i));
            Check(value.Numbers[1] == i + 1);
        }
        Console.WriteLine("struct local initialization ok");
    }
}
