using System;

class Program {
    public static void Main() {
        int[] empty = Array.Empty<int>();
        Console.WriteLine("empty=" + empty.Length.ToString());

        int[] a = new int[5];
        a[0] = 50; a[1] = 20; a[2] = 40; a[3] = 10; a[4] = 30;

        int[] b = new int[5];
        Array.Copy<int>(a, b, 5);
        Console.WriteLine("copy0=" + b[0].ToString() + " copy1=" + b[1].ToString());

        Array.Reverse<int>(b);
        Console.WriteLine("rev0=" + b[0].ToString() + " rev1=" + b[1].ToString());

        Array.Sort(a);
        Console.WriteLine("sort=" + a[0].ToString() + " " + a[1].ToString() + " " + a[2].ToString() + " " + a[3].ToString() + " " + a[4].ToString());

        int idx = Array.IndexOf<int>(a, 40);
        Console.WriteLine("idx40=" + idx.ToString());
        int notFound = Array.IndexOf<int>(a, 999);
        Console.WriteLine("idx999=" + notFound.ToString());

        byte[] bsrc = new byte[3]; bsrc[0] = (byte)1; bsrc[1] = (byte)2; bsrc[2] = (byte)3;
        byte[] bdst = new byte[3];
        Array.Copy(bsrc, bdst, 3);
        Console.WriteLine("bcopy=" + ((int)bdst[0]).ToString() + "," + ((int)bdst[1]).ToString() + "," + ((int)bdst[2]).ToString());
    }
}
