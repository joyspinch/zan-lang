using System;

class Counter { public int N; }

class Program {
    static int Main() {
        int fails = 0;

        // plain locals: prefix and postfix both change the value exactly once
        int x = 5;
        x++;
        if (x != 6) { fails = fails + 1; }
        x--;
        if (x != 5) { fails = fails + 1; }
        ++x;
        if (x != 6) { fails = fails + 1; }
        --x;
        if (x != 5) { fails = fails + 1; }

        // postfix yields the value before the change
        int y = 10;
        int old = y++;
        if (old != 10) { fails = fails + 1; }
        if (y != 11) { fails = fails + 1; }
        old = y--;
        if (old != 11) { fails = fails + 1; }
        if (y != 10) { fails = fails + 1; }

        // field inc/dec
        Counter cnt = new Counter();
        cnt.N++;
        ++cnt.N;
        if (cnt.N != 2) { fails = fails + 1; }
        cnt.N--;
        if (cnt.N != 1) { fails = fails + 1; }

        // array element inc/dec
        int[] arr = new int[3];
        arr[1]++;
        arr[1]++;
        if (arr[1] != 2) { fails = fails + 1; }
        arr[1]--;
        if (arr[1] != 1) { fails = fails + 1; }
        int oldv = arr[1]++;
        if (oldv != 1) { fails = fails + 1; }
        if (arr[1] != 2) { fails = fails + 1; }

        if (fails == 0) { Console.WriteLine("OK"); return 0; }
        Console.WriteLine("FAIL " + Convert.ToString(fails));
        return 1;
    }
}
