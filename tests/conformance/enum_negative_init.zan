// Conformance: explicit enum initializers fold to their written values.
// A negative member (`Red = -5`) is a unary-minus node in the AST, a
// computed one (`Blue = Red + 10`) names a sibling member; before B-ID60
// the binder only recognized AST_INT_LITERAL, so both silently fell back
// to the running counter (Red compiled to 0, Green to 1). The binder now
// folds once into AST_INT_LITERAL (irgen emitter + reflection tables all
// key on that shape), range-checks against int, and the member-access
// fold counts its running counter in int64 so a member at INT32_MAX
// wraps like two's complement instead of overflowing the compiler.
using System;
namespace Conformance;
enum Color { Red = -5, Green, Blue = Red + 10 }
enum Big { Max = 2147483647, Wrap }
class Program {
    static void Main() {
        Console.WriteLine("r=" + ((int)Color.Red).ToString());
        Console.WriteLine("g=" + ((int)Color.Green).ToString());
        Console.WriteLine("b=" + ((int)Color.Blue).ToString());
        Console.WriteLine("m=" + ((int)Big.Max).ToString());
        Console.WriteLine("w=" + ((int)Big.Wrap).ToString());
    }
}
