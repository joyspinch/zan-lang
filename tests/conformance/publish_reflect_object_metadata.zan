using System;
using System.Json;

// Plain DTOs deliberately mix explicit and default-public fields and have no
// attributes, interfaces or virtual methods.
class PublishReflectChild {
    int Code;
    public string Name;
    bool Enabled;
    private int Secret = 31;
}

class PublishReflectDto {
    public int Id;
    string Title;
    bool Active;
    PublishReflectChild Child;
}

class Program {
    static void Check(bool condition, string message) {
        if (!condition) { throw new Exception(message); }
    }

    static void Main() {
        PublishReflectChild child = new PublishReflectChild();
        child.Code = -23;
        child.Name = "nested-value";
        child.Enabled = false;
        PublishReflectDto dto = new PublishReflectDto();
        dto.Id = 417;
        dto.Title = "plain-dto";
        dto.Active = true;
        dto.Child = child;

        object target = dto;
        Check(target.GetFieldInt("Id") == 417, "object integer field");
        Check(target.GetFieldString("Title") == "plain-dto", "object string field");
        Check(target.GetFieldBool("Active"), "object boolean field");
        object nested = target.GetFieldObject("Child");
        Check(nested == child, "object nested DTO identity");
        Check(nested != null, "object nested DTO survives");
        Check(nested.GetFieldInt("Code") == -23, "nested integer field");
        Check(nested.GetFieldString("Name") == "nested-value", "nested string field");
        Check(nested.HasField("Enabled"), "nested boolean metadata survives");
        Check(!nested.GetFieldBool("Enabled"), "nested boolean field");
        Check(nested.GetFieldInt("Secret") == 31, "private field reflection parity");
        Console.WriteLine("object reflection OK");

        JsonValue json = JsonValue.Parse(Json.Serialize<PublishReflectDto>(dto));
        Check(json != null, "JSON root survives");
        Check(json.Count() == 4, "JSON root field count");
        Check(json.Int("Id", 0) == 417, "JSON integer field");
        Check(json.Str("Title", "") == "plain-dto", "JSON string field");
        Check(json.Bool("Active", false), "JSON boolean field");
        JsonValue nestedJson = json.Get("Child");
        Check(nestedJson != null, "JSON nested DTO survives");
        Check(nestedJson.Count() == 4, "JSON nested field count");
        Check(nestedJson.Int("Secret", 0) == 31, "JSON private field parity");
        Check(nestedJson.Int("Code", 0) == -23, "JSON nested integer field");
        Check(nestedJson.Str("Name", "") == "nested-value", "JSON nested string field");
        Check(!nestedJson.Bool("Enabled", true), "JSON nested false boolean field");
        Console.WriteLine("JSON serialization OK");
    }
}
