using System;
using System.Collections.Generic;

class Program {
    static void Require(bool ok, string message) {
        if (!ok) { throw new Exception(message); }
    }

    static string Key(int n) { return ("ignore:key-" + n).Substring(7); }

    static Dictionary<string, int> Make() {
        Dictionary<string, int> result = new Dictionary<string, int>();
        int i = 0;
        while (i < 32) {
            // The dictionary must own this temporary after the statement ends.
            result[Key(i)] = i;
            i = i + 1;
        }
        return result;
    }

    static List<string> DetachedKeys() {
        Dictionary<string, int> local = Make();
        return local.Keys;
    }

    static void Main() {
        Dictionary<string, int> symbols = Make();
        int i = 0;
        while (i < 32) {
            Require(symbols.ContainsKey(Key(i)), "temporary key survives insertion");
            Require(symbols[Key(i)] == i, "temporary key lookup");
            symbols[Key(i)] = i + 100;
            i = i + 1;
        }
        Require(symbols.Count == 32, "equal temporary key updates existing entry");
        List<string> snapshot = symbols.Keys;
        Require(symbols.Remove(Key(0)), "remove owned key");
        Require(!symbols.ContainsKey(Key(0)) && symbols[Key(1)] == 101,
        "remove preserves remaining keys");
        symbols.Clear();
        Require(symbols.Count == 0, "clear releases dictionary entries");
        Require(snapshot.Count == 32 && snapshot[0] == Key(0) && snapshot[31] == Key(31),
        "keys snapshot survives remove and clear");
        List<string> detached = DetachedKeys();
        Require(detached[0] == Key(0) && detached[31] == Key(31),
        "keys snapshot survives dictionary destruction");
        symbols[Key(40)] = 40;
        Require(symbols.Count == 1 && symbols[Key(40)] == 40, "reuse after clear");

        Dictionary<int, int> raw = new Dictionary<int, int>();
        raw[1] = 7;
        raw[-3] = 9;
        List<int> rawKeys = raw.Keys;
        Require(raw.Remove(1), "remove integer key");
        raw.Clear();
        Require(rawKeys.Count == 2 && rawKeys[0] == 1 && rawKeys[1] == -3,
        "integer keys remain opaque values");
        Console.WriteLine("temporary dictionary keys PASS");
    }
}
