class Program {
    [DllImport("crt", Variadic = true)]
    static extern int printf(string fmt);

    static void Main() {
        printf("plain\n");
        printf("n=%d s=%s n=%d\n", 7, "mid", 42);
        printf("exact-arity\n");
        // 核心契约与语义定义。
        string t = Convert.ToString(84);
        printf("v=%s!\n", t);
        printf("mix %d %s %d %s\n", 1, "two", 3, "four");
        // 核心契约与语义定义。
        printf("d=%.1f\n", 2.5);
        // 核心契约与语义定义。
        int w = printf("chars\n");
        Console.WriteLine(w > 0);
    }
}
