using System;

/// [DllImport(..., Variadic = true)] (A2-3): the declared parameters are the
/// fixed prefix of a C varargs callee; a call may pass more arguments, which
/// land in the ... tail with the C default promotions applied (bool -> 0/1,
/// float -> double, narrow ints widen to int; Zan int (i64) and pointers pass
/// unchanged).
class Program {
    [DllImport("crt", Variadic = true)]
    static extern int printf(string fmt);

    static void Main() {
        printf("plain\n");
        printf("n=%d s=%s n=%d\n", 7, "mid", 42);
        printf("exact-arity\n");
        // tail string from a runtime value, not a literal
        string t = Convert.ToString(84);
        printf("v=%s!\n", t);
        printf("mix %d %s %d %s\n", 1, "two", 3, "four");
        // a double tail passes through unchanged and prints as in C
        printf("d=%.1f\n", 2.5);
        // printf returns the number of characters written
        int w = printf("chars\n");
        Console.WriteLine(w > 0);
    }
}
