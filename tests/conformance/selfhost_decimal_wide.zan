using System;
using System.Collections.Generic;

class DecimalWideHolder {
    public decimal Value;
    public static decimal Saved;
}

class SelfhostDecimalWide {
    static decimal Echo(decimal value) { return value; }
    static void Bump(ref decimal value) { value += 0.1m; }
    static async Task<decimal> AcrossAwait(decimal value) {
        decimal saved = value;
        await Task.Yield();
        return saved + 0.1m;
    }
    static async Task Run() {
        decimal wide = 9007199254740993m;
        decimal result = await AcrossAwait(wide);
        Console.WriteLine(result == wide + 0.1m);
    }
    static void Main() {
        decimal exact = 9007199254740993m;
        Console.WriteLine(Echo(exact) - 9007199254740992m == 1m);
        decimal value = 0.2m;
        Bump(ref value);
        Console.WriteLine(value == 0.3m);
        DecimalWideHolder holder = new DecimalWideHolder();
        holder.Value = exact;
        DecimalWideHolder.Saved = holder.Value;
        Console.WriteLine(DecimalWideHolder.Saved == exact);
        decimal[] items = new decimal[] { exact, 0.2m };
        Bump(ref items[1]);
        Console.WriteLine(items[0] == exact && items[1] == 0.3m);
        decimal[,] matrix = new decimal[2,2];
        matrix[1,1] = exact;
        Console.WriteLine(matrix[1,1] == exact);
        decimal total = 0m;
        foreach (decimal item in items) { total += item; }
        Console.WriteLine(total == exact + 0.3m);
        List<decimal> list = new List<decimal>();
        list.Add(exact);
        list.Add(0.3m);
        Console.WriteLine(list[0] == exact && list.Contains(0.3m));
        list[0] = 0.1m;
        decimal[] copied = list.ToArray();
        list.Clear();
        Console.WriteLine(copied[0] == 0.1m && copied[1] == 0.3m);
        Dictionary<string, decimal> dict = new Dictionary<string, decimal>();
        dict["value"] = exact;
        Console.WriteLine(dict["value"] == exact);
        decimal? optional = exact;
        Console.WriteLine(optional == exact);
        Console.WriteLine(Decimal.Parse("0.1") + Decimal.Parse("0.2") == 0.3m);
        Console.WriteLine(Decimal.Round(2.5m) == 2m);
        Console.WriteLine(exact.ToString() == "9007199254740993");
        await Run();
        Task<decimal> firstTask = Task.Run(AcrossAwait(exact));
        decimal firstResult = firstTask.Result;
        Console.WriteLine(firstResult == exact + 0.1m);
        Task<decimal> secondTask = Task.Run(AcrossAwait(-exact));
        decimal secondResult = secondTask.Result;
        Console.WriteLine(secondResult == -exact + 0.1m);
        Console.WriteLine(firstResult - 0.1m == exact);
    }
}
