using System;
using System.Collections.Generic;
using Game.Arcade2D;
using Game.Tilemap;

class MainClass {
    static void Main() {
        TileLayer layer = new TileLayer("collision", 10, 6, 16);

        // 构造 4x3 平台 (列 2..5, 行 1..3 为图块 1)
        int r = 1;
        while (r <= 3) {
            int c = 2;
            while (c <= 5) {
                layer.SetTile(c, r, 1);
                c = c + 1;
            }
            r = r + 1;
        }

        // 行 1 右侧放图块 2 (列 7..8)
        layer.SetTile(7, 1, 2);
        layer.SetTile(8, 1, 2);

        // 行 4 放连续区间图块 10, 11, 12 (列 1..3)
        layer.SetTile(1, 4, 10);
        layer.SetTile(2, 4, 11);
        layer.SetTile(3, 4, 12);

        // 1. 1D 行合并与 2D 贪心合并
        List<Rect2> c1 = layer.ExtractColliders(1);
        Console.WriteLine("single_1D=" + c1.Count.ToString());

        List<Rect2> c2D = layer.ExtractCollidersOptimized2D(1);
        Console.WriteLine("single_2D=" + c2D.Count.ToString());
        if (c2D.Count > 0) {
            Rect2 b = c2D[0];
            Console.WriteLine("box_pos=" + ((int)b.X()).ToString() + "," + ((int)b.Y()).ToString() + "," + ((int)b.Width()).ToString() + "," + ((int)b.Height()).ToString());
        }

        // 2. 多 ID 匹配提取
        List<int> ids = new List<int>();
        ids.Add(1);
        ids.Add(2);
        List<Rect2> cMatch = layer.ExtractCollidersMatching(ids);
        Console.WriteLine("match_1D=" + cMatch.Count.ToString());

        List<Rect2> cMatch2D = layer.ExtractCollidersMatchingOptimized2D(ids);
        Console.WriteLine("match_2D=" + cMatch2D.Count.ToString());

        // 3. 区间匹配提取
        List<Rect2> cRange = layer.ExtractCollidersRange(10, 15);
        Console.WriteLine("range_1D=" + cRange.Count.ToString());
        if (cRange.Count > 0) {
            Rect2 rb = cRange[0];
            Console.WriteLine("range_box=" + ((int)rb.X()).ToString() + "," + ((int)rb.Y()).ToString() + "," + ((int)rb.Width()).ToString() + "," + ((int)rb.Height()).ToString());
        }

        Console.WriteLine("PASS");
    }
}
