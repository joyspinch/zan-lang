// A thrown string must carry a +1 reference in the exception globals like a
// class throw does: the pre-longjmp unwind releases every registered local
// slot, so an unowned string used to be freed while __zan_eh_exc still
// pointed at it (and a thrown call result leaked its temporary outright).
// The catch-all cannot bind the message; the assertions are that handlers
// run, ordering holds, and --check-leaks stays clean for this program.
using System;

class ThrowStringOwned {
    static string MakeMsg() {
        return "computed-message";
    }

    static void Main() {
        // a borrowed local thrown across an unwind
        try {
            string msg = "borrowed-message";
            throw msg;
        } catch {
            Console.WriteLine("A:caught");
        }

        // a call result carries its own +1 into the throw
        try {
            throw MakeMsg();
        } catch {
            Console.WriteLine("B:caught");
        }

        // the in-flight +1 stays balanced through two handlers
        try {
            try {
                throw "rethrow-me";
            } catch {
                throw;
            }
        } catch {
            Console.WriteLine("C:rethrown");
        }
        return 0;
    }
}
