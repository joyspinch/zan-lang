// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
using System;

class ThrowStringOwned {
    static string MakeMsg() {
        return "computed-message";
    }

    static void Main() {
        // 核心契约与语义定义。
        try {
            string msg = "borrowed-message";
            throw msg;
        } catch {
            Console.WriteLine("A:caught");
        }

        // 接口数据协议与执行契约。
        try {
            throw MakeMsg();
        } catch {
            Console.WriteLine("B:caught");
        }

        // 接口数据协议与执行契约。
        try {
            try {
                throw "rethrow-me";
            } catch {
                throw;
            }
        } catch {
            Console.WriteLine("C:rethrown");
        }
        return 0;
    }
}
