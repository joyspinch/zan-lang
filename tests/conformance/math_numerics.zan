using System;
using System.Collections.Generic;
using System.Numerics;

namespace ConformanceTests;

// 数值层（System.Numerics 扩展：MathUtil / Quaternion / Noise / RandomExt / Spline）
// 的行为判定。全部断言必须确定：随机相关用同种子复现，浮点用容差比较。
class Program {
    static int failures = 0;

    static void Check(bool ok, string name) {
        if (!ok) {
            failures = failures + 1;
            Console.WriteLine("FAIL: " + name);
        }
    }

    static bool Near(double a, double b, double tol) {
        double d = a - b;
        if (d < 0.0) { d = -d; }
        return d <= tol;
    }

    static bool NearF(float a, float b, float tol) {
        float d = a - b;
        if (d < 0.0f) { d = -d; }
        return d <= tol;
    }

    static void Main() {
        TestMathUtil();
        TestQuaternion();
        TestNoise();
        TestRandomExt();
        TestSpline();
        if (failures == 0) {
            Console.WriteLine("ALL MATH NUMERICS TESTS PASSED");
        }
    }

    static void TestMathUtil() {
        int before = failures;

        Check(MathUtil.Clamp(5.0, 0.0, 1.0) == 1.0, "Clamp high");
        Check(MathUtil.Clamp(-5.0, 0.0, 1.0) == 0.0, "Clamp low");
        Check(MathUtil.Clamp(0.5, 0.0, 1.0) == 0.5, "Clamp mid");
        Check(MathUtil.ClampInt(7, 0, 3) == 3, "ClampInt");
        Check(MathUtil.Clamp01(-1.0) == 0.0, "Clamp01 low");
        Check(MathUtil.Clamp01(2.0) == 1.0, "Clamp01 high");

        Check(MathUtil.Lerp(0.0, 10.0, 0.25) == 2.5, "Lerp");
        Check(MathUtil.Lerp(0.0, 10.0, 2.0) == 10.0, "Lerp clamps t");
        Check(MathUtil.LerpUnclamped(0.0, 10.0, 2.0) == 20.0, "LerpUnclamped");
        Check(MathUtil.InverseLerp(0.0, 10.0, 2.5) == 0.25, "InverseLerp");
        Check(MathUtil.InverseLerp(3.0, 3.0, 9.0) == 0.0, "InverseLerp degenerate");
        Check(MathUtil.Remap(5.0, 0.0, 10.0, 100.0, 200.0) == 150.0, "Remap");

        Check(MathUtil.SmoothStep(0.0, 1.0, 0.0) == 0.0, "SmoothStep at from");
        Check(MathUtil.SmoothStep(0.0, 1.0, 0.5) == 0.5, "SmoothStep mid");
        Check(MathUtil.SmoothStep(0.0, 1.0, 1.0) == 1.0, "SmoothStep at to");
        Check(MathUtil.SmoothStep(0.0, 1.0, 2.0) == 1.0, "SmoothStep clamps");
        Check(MathUtil.SmootherStep(0.0, 1.0, 0.5) == 0.5, "SmootherStep mid");

        Check(MathUtil.Sign(-2.0) == -1.0, "Sign negative");
        Check(MathUtil.Sign(0.0) == 0.0, "Sign zero");
        Check(MathUtil.Sign(3.0) == 1.0, "Sign positive");

        Check(MathUtil.Approximately(1.0, 1.0 + 1e-12), "Approximately close");
        Check(!MathUtil.Approximately(1.0, 1.1), "Approximately far");

        Check(MathUtil.Wrap(370.0, 0.0, 360.0) == 10.0, "Wrap forward");
        Check(MathUtil.Wrap(-10.0, 0.0, 360.0) == 350.0, "Wrap backward");
        Check(MathUtil.Wrap(10.0, 0.0, 360.0) == 10.0, "Wrap inside");
        Check(MathUtil.PingPong(1.5, 1.0) == 0.5, "PingPong down");
        Check(MathUtil.PingPong(2.5, 1.0) == 0.5, "PingPong up");

        Check(MathUtil.MoveTowards(0.0, 10.0, 3.0) == 3.0, "MoveTowards step");
        Check(MathUtil.MoveTowards(0.0, 10.0, 30.0) == 10.0, "MoveTowards reach");
        Check(MathUtil.DeltaAngle(350.0, 10.0) == 20.0, "DeltaAngle wrap");
        Check(MathUtil.DeltaAngle(10.0, 350.0) == -20.0, "DeltaAngle wrap back");
        Check(MathUtil.LerpAngle(350.0, 10.0, 0.5) == 360.0, "LerpAngle shortest arc");

        Check(MathUtil.DegreesToRadians(180.0) == MathUtil.Pi, "DegreesToRadians");
        Check(MathUtil.RadiansToDegrees(MathUtil.Pi) == 180.0, "RadiansToDegrees");
        Check(MathUtil.Step(0.5, 0.6) == 1.0, "Step above");
        Check(MathUtil.Step(0.5, 0.4) == 0.0, "Step below");
        Check(MathUtil.Hermite(0.5, 0.0, 0.0, 1.0, 0.0) == 0.5, "Hermite");
        Check(MathUtil.RoundTo(1.234, 0.25) == 1.25, "RoundTo");

        Check(MathUtil.Log(1.0) == 0.0, "Log one");
        Check(Near(MathUtil.Log(2.0), 0.6931471805599453, 1e-15), "Log two");
        Check(Near(MathUtil.Log(MathUtil.E), 1.0, 1e-14), "Log e");
        Check(Near(MathUtil.Log(1000.0), 6.907755278982137, 1e-13), "Log thousand");
        Check(MathUtil.Exp(0.0) == 1.0, "Exp zero");
        Check(Near(MathUtil.Exp(1.0), 2.718281828459045, 1e-14), "Exp one");
        Check(Near(MathUtil.Exp(-3.0), 0.0497870683678639, 1e-16), "Exp minus three");
        Check(Near(MathUtil.Exp(10.0), 22026.465794806718, 1e-8), "Exp ten");

        if (failures == before) {
            Console.WriteLine("OK: MathUtil");
        }
    }

    static void TestQuaternion() {
        int before = failures;

        Quaternion id = Quaternion.Identity;
        Check(id.X == 0.0f && id.Y == 0.0f && id.Z == 0.0f && id.W == 1.0f, "Identity");

        float half = (float)(MathUtil.Pi / 2.0);
        Quaternion qy = Quaternion.FromAxisAngle(new Vector3(0.0f, 1.0f, 0.0f), half);
        Vector3 rotated = Quaternion.Rotate(new Vector3(0.0f, 0.0f, 1.0f), qy);
        Check(NearF(rotated.X, 1.0f, 1e-5f), "Rotate 90deg Y");
        Check(NearF(rotated.Y, 0.0f, 1e-5f), "Rotate 90deg Y keeps y");
        Check(NearF(rotated.Z, 0.0f, 1e-5f), "Rotate 90deg Y keeps z");

        Vector3 byMatrix = Matrix4x4.Transform(new Vector3(0.0f, 0.0f, 1.0f), qy.ToMatrix());
        Check(NearF(byMatrix.X, rotated.X, 1e-5f), "ToMatrix matches Rotate");
        Check(NearF(byMatrix.Z, rotated.Z, 1e-5f), "ToMatrix matches Rotate z");

        Quaternion qz = Quaternion.FromAxisAngle(new Vector3(0.0f, 0.0f, 1.0f), half);
        Vector3 rz = Quaternion.Rotate(new Vector3(1.0f, 0.0f, 0.0f), qz);
        Check(NearF(rz.Y, 1.0f, 1e-5f), "Rotate 90deg Z");

        Quaternion euler = Quaternion.FromEulerDegrees(30.0f, 45.0f, 60.0f);
        Vector3 back = euler.ToEulerDegrees();
        Check(NearF(back.X, 30.0f, 1e-3f), "Euler round trip pitch");
        Check(NearF(back.Y, 45.0f, 1e-3f), "Euler round trip yaw");
        Check(NearF(back.Z, 60.0f, 1e-3f), "Euler round trip roll");

        Quaternion mid = Quaternion.Slerp(Quaternion.Identity, qy, 0.5f);
        Vector3 midRotated = Quaternion.Rotate(new Vector3(0.0f, 0.0f, 1.0f), mid);
        Check(NearF(midRotated.X, 0.7071068f, 1e-4f), "Slerp midpoint");
        Check(NearF(midRotated.Z, 0.7071068f, 1e-4f), "Slerp midpoint z");

        Check(Near(Quaternion.Angle(Quaternion.Identity, qy), 90.0, 1e-3), "Angle 90deg");
        Check(NearF(Quaternion.Length(Quaternion.Normalize(qy)), 1.0f, 1e-5f), "Normalize length");

        Quaternion inv = Quaternion.Inverse(qy);
        Vector3 restored = Quaternion.Rotate(Quaternion.Rotate(new Vector3(1.0f, 2.0f, 3.0f), qy), inv);
        Check(NearF(restored.X, 1.0f, 1e-4f), "Inverse round trip x");
        Check(NearF(restored.Y, 2.0f, 1e-4f), "Inverse round trip y");
        Check(NearF(restored.Z, 3.0f, 1e-4f), "Inverse round trip z");

        Quaternion look = Quaternion.LookRotation(new Vector3(0.0f, 0.0f, 1.0f),
                                                 new Vector3(0.0f, 1.0f, 0.0f));
        Vector3 lookF = Quaternion.Rotate(new Vector3(0.0f, 0.0f, 1.0f), look);
        Vector3 lookU = Quaternion.Rotate(new Vector3(0.0f, 1.0f, 0.0f), look);
        Check(NearF(lookF.X, 0.0f, 1e-5f) && NearF(lookF.Y, 0.0f, 1e-5f) &&
              NearF(lookF.Z, 1.0f, 1e-5f), "LookRotation forward");
        Check(NearF(lookU.X, 0.0f, 1e-5f) && NearF(lookU.Y, 1.0f, 1e-5f) &&
              NearF(lookU.Z, 0.0f, 1e-5f), "LookRotation up");

        if (failures == before) {
            Console.WriteLine("OK: Quaternion");
        }
    }

    static void TestNoise() {
        int before = failures;

        Noise a = new Noise(42);
        Noise b = new Noise(42);
        Noise c = new Noise(43);
        Check(a.Perlin2D(1.5, 2.5) == b.Perlin2D(1.5, 2.5), "Same seed reproduces");
        Check(a.Perlin2D(1.5, 2.5) != c.Perlin2D(1.5, 2.5), "Different seed differs");
        Check(a.Value2D(0.3, 0.7) == b.Value2D(0.3, 0.7), "Value noise reproduces");
        Check(a.Perlin3D(0.3, 0.7, 1.1) == b.Perlin3D(0.3, 0.7, 1.1), "Perlin3 reproduces");

        bool inRange = true;
        for (int i = 0; i < 512; i++) {
            double x = (double)i * 0.137;
            double p = a.Perlin2D(x, x * 0.7);
            double v = a.Value2D(x, x * 0.7);
            double f = a.Fbm2D(x, x * 0.7, 4, 0.5, 2.0);
            double r = a.Ridged2D(x, x * 0.7, 4, 0.5, 2.0);
            if (p < -1.0 || p > 1.0) { inRange = false; }
            if (v < -1.0 || v > 1.0) { inRange = false; }
            if (f < -1.0 || f > 1.0) { inRange = false; }
            if (r < 0.0 || r > 1.0) { inRange = false; }
        }
        Check(inRange, "Noise stays in range");

        bool inRange3 = true;
        for (int i = 0; i < 256; i++) {
            double x = (double)i * 0.311;
            double p = a.Perlin3D(x, x * 0.5, x * 0.25);
            if (p < -1.0 || p > 1.0) { inRange3 = false; }
        }
        Check(inRange3, "Perlin3 stays in range");

        if (failures == before) {
            Console.WriteLine("OK: Noise");
        }
    }

    static void TestRandomExt() {
        int before = failures;

        RandomExt r1 = RandomExt.Seeded(12345);
        RandomExt r2 = RandomExt.Seeded(12345);
        bool same = true;
        for (int i = 0; i < 8; i++) {
            if (r1.NextDouble() != r2.NextDouble()) { same = false; }
        }
        Check(same, "Same seed reproduces sequence");

        RandomExt r3 = RandomExt.Seeded(7);
        double sum = 0.0;
        bool inUnit = true;
        for (int i = 0; i < 20000; i++) {
            double d = r3.NextDouble();
            sum = sum + d;
            if (d < 0.0 || d >= 1.0) { inUnit = false; }
        }
        Check(inUnit, "NextDouble in [0,1)");
        Check(Near(sum / 20000.0, 0.5, 0.02), "NextDouble mean is 0.5");

        RandomExt r4 = RandomExt.Seeded(99);
        bool inRange = true;
        for (int i = 0; i < 2000; i++) {
            int v = r4.NextInt(3, 9);
            if (v < 3 || v >= 9) { inRange = false; }
        }
        Check(inRange, "NextInt in range");

        RandomExt r5 = RandomExt.Seeded(5);
        double nsum = 0.0;
        for (int i = 0; i < 20000; i++) {
            nsum = nsum + r5.NextNormal(10.0, 2.0);
        }
        Check(Near(nsum / 20000.0, 10.0, 0.1), "NextNormal mean");

        List<string> names = new List<string>();
        names.Add("a");
        names.Add("b");
        names.Add("c");
        RandomExt r6 = RandomExt.Seeded(31);
        bool pickedKnown = true;
        for (int i = 0; i < 100; i++) {
            string s = r6.Pick<string>(names);
            if (s != "a" && s != "b" && s != "c") { pickedKnown = false; }
        }
        Check(pickedKnown, "Pick returns a member");

        List<double> weights = new List<double>();
        weights.Add(0.0);
        weights.Add(1.0);
        weights.Add(0.0);
        RandomExt r7 = RandomExt.Seeded(17);
        int zeroHits = 0;
        for (int i = 0; i < 200; i++) {
            if (r7.WeightedPick<string>(names, weights) == "a") { zeroHits = zeroHits + 1; }
        }
        Check(zeroHits == 0, "WeightedPick skips zero weight");

        RandomExt r8 = RandomExt.Seeded(77);
        List<int> deck = new List<int>();
        for (int i = 0; i < 8; i++) { deck.Add(i); }
        r8.Shuffle<int>(deck);
        bool sameSet = deck.Count == 8;
        for (int i = 0; i < 8; i++) {
            if (deck[i] < 0 || deck[i] > 7) { sameSet = false; }
        }
        Check(sameSet, "Shuffle keeps the multiset");

        if (failures == before) {
            Console.WriteLine("OK: RandomExt");
        }
    }

    static void TestSpline() {
        int before = failures;

        List<Vector3> cps = new List<Vector3>();
        cps.Add(new Vector3(0.0f, 0.0f, 0.0f));
        cps.Add(new Vector3(1.0f, 2.0f, 0.0f));
        cps.Add(new Vector3(2.0f, 0.0f, 0.0f));
        cps.Add(new Vector3(3.0f, 3.0f, 0.0f));
        Spline spline = new Spline(cps);

        Vector3 head = spline.Evaluate(0.0f);
        Vector3 tail = spline.Evaluate(1.0f);
        Check(NearF(head.X, 0.0f, 1e-5f) && NearF(head.Y, 0.0f, 1e-5f), "Spline starts at first point");
        Check(NearF(tail.X, 3.0f, 1e-5f) && NearF(tail.Y, 3.0f, 1e-5f), "Spline ends at last point");

        bool through = true;
        for (int i = 0; i < cps.Count; i++) {
            float t = (float)i / (float)(cps.Count - 1);
            Vector3 p = spline.Evaluate(t);
            Vector3 c = cps[i];
            if (!NearF(p.X, c.X, 1e-4f) || !NearF(p.Y, c.Y, 1e-4f)) { through = false; }
        }
        Check(through, "Catmull-Rom passes through control points");

        Check(spline.ApproximateLength(256) > 0.0f, "Spline length is positive");

        List<Vector3> resampled = spline.Resample(9);
        Check(resampled.Count == 9, "Resample count");
        Check(NearF(resampled[0].X, 0.0f, 1e-3f), "Resample starts at head");
        Check(NearF(resampled[8].X, 3.0f, 1e-3f), "Resample ends at tail");

        Vector3 bezHead = spline.EvaluateBezier(0.0f);
        Vector3 bezTail = spline.EvaluateBezier(1.0f);
        Check(NearF(bezHead.X, 0.0f, 1e-4f), "Bezier head");
        Check(NearF(bezTail.X, 3.0f, 1e-4f), "Bezier tail");

        List<Vector3> tangents = new List<Vector3>();
        for (int i = 0; i < cps.Count; i++) {
            tangents.Add(new Vector3(1.0f, 0.0f, 0.0f));
        }
        Vector3 hermiteHead = spline.EvaluateHermite(0.0f, tangents);
        Check(NearF(hermiteHead.X, 0.0f, 1e-4f) && NearF(hermiteHead.Y, 0.0f, 1e-4f),
              "Hermite starts at first point");

        if (failures == before) {
            Console.WriteLine("OK: Spline");
        }
    }
}
