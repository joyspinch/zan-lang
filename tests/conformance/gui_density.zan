using System;
using Gui;

/// Headless checks for the density (大中小) ladder: the Theme permille
/// table and name round-trips, the snapshot-baseline rescale (medium ==
/// baseline, small/large shrink/grow with readable floors, exact restore),
/// the skin `--density` token parse (plain/quoted/alias/absent), and the
/// App-level wiring (SetDensity mutates theme metrics and keeps them stable
/// across a re-applied theme). Everything here is pure computation: no
/// window is created and no frame is rendered.
class GuiDensityTest {
    static void Main() {
        Theme t = Theme.Light();
        Console.WriteLine("dflt " + t.heightMedium + "/" + t.fontSizeMedium
            + "/" + t.paddingSmall + "/" + t.gapMedium);

        // ---- 1. permille table + display names + name -> level ----------
        Console.WriteLine(Theme.DensityPermille(0) + " " + Theme.DensityPermille(1)
            + " " + Theme.DensityPermille(2));
        Console.WriteLine(Theme.DensityName(0) + " " + Theme.DensityName(1)
            + " " + Theme.DensityName(2));
        Console.WriteLine(Theme.DensityOf("SMALL") + " " + Theme.DensityOf("large")
            + " " + Theme.DensityOf("compact") + " " + Theme.DensityOf("bogus"));

        // ---- 2. snapshot-baseline rescale -------------------------------
        List<int> bm = t.SnapshotMetrics();
        t.ApplyDensityScaled(bm, 1);
        Console.WriteLine("mid " + t.heightMedium + "/" + t.fontSizeMedium);
        t.ApplyDensityScaled(bm, 0);
        Console.WriteLine("small " + t.heightMedium + "/" + t.fontSizeMedium
            + "/" + t.heightTiny + "/" + t.fontSizeTiny + "/" + t.borderWidth);
        t.ApplyDensityScaled(bm, 2);
        Console.WriteLine("large " + t.heightMedium + "/" + t.fontSizeMedium
            + "/" + t.paddingLarge + "/" + t.iconSizeMedium);
        t.ApplyDensityScaled(bm, 1);
        Console.WriteLine("restored " + t.heightMedium + "/" + t.fontSizeMedium
            + "/" + t.paddingSmall);

        // ---- 3. skin --density token ------------------------------------
        StyleSheet withTok = StyleSheet.FromCss(
            ":root { --base: light; --density: small; --primary: #d92b2b; }");
        Console.WriteLine("skin " + Skin.DensityOf(withTok)
            + " " + withTok.Var("--density"));
        StyleSheet noTok = StyleSheet.FromCss(":root { --base: dark; }");
        Console.WriteLine("absent " + Skin.DensityOf(noTok));
        StyleSheet quoted = StyleSheet.FromCss(":root { --density: \"Large\"; }");
        Console.WriteLine("quoted " + Skin.DensityOf(quoted));
        StyleSheet alias = StyleSheet.FromCss(":root { --density: compact; }");
        Console.WriteLine("alias " + Skin.DensityOf(alias));

        // ---- 4. App-level wiring -----------------------------------------
        App app = App.CreateDark("density", 320, 200);
        Console.WriteLine("app " + app.Density() + " " + app.DensityLabel()
            + " " + app.theme.heightMedium + "/" + app.theme.fontSizeMedium);
        app.SetDensity(0);
        Console.WriteLine("small " + app.Density() + " " + app.DensityLabel()
            + " " + app.theme.heightMedium + "/" + app.theme.fontSizeMedium
            + "/" + app.theme.paddingSmall);
        app.SetDensity(2);
        Console.WriteLine("large " + app.Density() + " " + app.DensityLabel()
            + " " + app.theme.heightMedium + "/" + app.theme.fontSizeMedium
            + "/" + app.theme.paddingLarge);
        app.SetDensity(1);
        Console.WriteLine("back " + app.Density() + " "
            + app.theme.heightMedium + "/" + app.theme.fontSizeMedium);
        // re-applied theme keeps the chosen density (baseline resnapshots)
        app.ApplyTheme(Theme.Light(), false);
        Console.WriteLine("reapplied " + app.Density() + " "
            + app.theme.heightMedium + "/" + app.theme.fontSizeMedium);
        app.SetDensity(0);
        app.ApplyTheme(Theme.Dark(), true);
        Console.WriteLine("keepsmall " + app.Density() + " "
            + app.theme.heightMedium + "/" + app.theme.fontSizeMedium);
    }
}
