using System;
using System.Threading;

namespace Conf;

// 测试断言与状态转移验证。
// 测试断言与状态转移验证。
// 测试断言与状态转移验证。
// 测试断言与状态转移验证。
// 测试断言与状态转移验证。
// 核心契约与语义定义。
class Job {
    public int n;
    public Job(int x) { n = x; }
    public void Run() { Prog.counter.Add(this.n); }
}

class Prog {
    static AtomicInt counter;

    static void Work() {
        Prog.counter.Add(3);
    }

    static void Main() {
        Prog.counter = new AtomicInt(0);

        for (int i = 0; i < 4; i = i + 1) {
            Thread.Start(Prog.Work);
        }
        Thread.Start(new Job(7).Run);
        Thread.Start(() => { Prog.counter.Add(100); });
        int bonus = 40;
        Thread.Start(() => { Prog.counter.Add(bonus); });

        // 核心契约与语义定义。
        // 测试断言与状态转移验证。
        // 测试断言与状态转移验证。
        // 测试断言与状态转移验证。
        // 测试断言与状态转移验证。
        while (Prog.counter.Load() < 159) {
            Thread.Sleep(1);
        }
        Thread.Sleep(50);
        Console.WriteLine(Convert.ToString(Prog.counter.Load()));
    }
}
