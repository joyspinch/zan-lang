using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.WebDav;
using System.Threading;

class Program {
    static int PORT = 54392;

    static async HttpResponse Handle(HttpRequest req) {
        if (req.method == "PROPFIND") {
            Console.WriteLine("PROPFIND path=" + req.path
                + " body=" + Convert.ToString(req.body == WebDavClient.BuildPropFindXml())
                + " Depth=" + req.GetHeader("Depth"));
            string xml = "<?xml version=\"1.0\"?><d:multistatus xmlns:d=\"DAV:\">"
                + "<d:response><d:href>/dav/item.txt</d:href><d:propstat><d:prop>"
                + "<d:resourcetype/><d:getcontentlength>7</d:getcontentlength>"
                + "<d:getcontenttype>text/plain</d:getcontenttype><d:getetag>\"e2e\"</d:getetag>"
                + "</d:prop><d:status>HTTP/1.1 200 OK</d:status></d:propstat></d:response>"
                + "</d:multistatus>";
            return HttpResponse.WithStatus(207, "Multi-Status", xml)
                .SetContentType("application/xml");
        }
        if (req.method == "MKCOL") {
            Console.WriteLine("MKCOL path=" + req.path
                + " body=" + Convert.ToString(req.body.Length == 0));
            return HttpResponse.WithStatus(201, "Created", "");
        }
        if (req.method == "GET") {
            Console.WriteLine("GET path=" + req.path
                + " body=" + Convert.ToString(req.body.Length == 0));
            return HttpResponse.Text("get-body");
        }
        if (req.method == "PUT") {
            Console.WriteLine("PUT path=" + req.path + " body=" + req.body);
            return HttpResponse.WithStatus(204, "No Content", "");
        }
        if (req.method == "DELETE") {
            Console.WriteLine("DELETE path=" + req.path
                + " body=" + Convert.ToString(req.body.Length == 0));
            return HttpResponse.WithStatus(204, "No Content", "");
        }
        if (req.method == "COPY") {
            Console.WriteLine("COPY path=" + req.path
                + " body=" + Convert.ToString(req.body.Length == 0)
                + " Destination=" + req.GetHeader("Destination")
                + " Overwrite=" + req.GetHeader("Overwrite"));
            return HttpResponse.WithStatus(201, "Created", "");
        }
        if (req.method == "MOVE") {
            Console.WriteLine("MOVE path=" + req.path
                + " body=" + Convert.ToString(req.body.Length == 0)
                + " Destination=" + req.GetHeader("Destination")
                + " Overwrite=" + req.GetHeader("Overwrite"));
            return HttpResponse.WithStatus(201, "Created", "");
        }
        return HttpResponse.NotFound();
    }

    static async int Run() {
        Socket.Initialize();
        HttpServer server = HttpServer.Create("127.0.0.1", PORT);
        server.OnRequest(Handle);
        Task.Spawn(server.Start());
        await Task.Delay(50);

        WebDavClient client = WebDavClient.Create("127.0.0.1", PORT);
        List<WebDavResource> resources = await client.PropFindAsync("/dav/", "1");
        Console.WriteLine("propfind=" + Convert.ToString(resources.Count)
            + ":" + resources[0].href + ":" + Convert.ToString(resources[0].status));

        HttpResponse mkcol = await client.MkColAsync("/dav/new/");
        Console.WriteLine("mkcol=" + Convert.ToString(mkcol.statusCode));
        mkcol.Dispose();
        mkcol = null;
        HttpResponse getResponse = await client.GetAsync("/dav/item.txt");
        Console.WriteLine("get=" + Convert.ToString(getResponse.statusCode) + ":" + getResponse.body);
        getResponse.Dispose();
        getResponse = null;
        HttpResponse put = await client.PutAsync("/dav/item.txt", "put-body");
        Console.WriteLine("put=" + Convert.ToString(put.statusCode));
        put.Dispose();
        put = null;
        HttpResponse deleted = await client.DeleteAsync("/dav/item.txt");
        Console.WriteLine("delete=" + Convert.ToString(deleted.statusCode));
        deleted.Dispose();
        deleted = null;
        HttpResponse copied = await client.CopyAsync("/dav/source.txt", "/dav/copy.txt", false);
        Console.WriteLine("copy=" + Convert.ToString(copied.statusCode));
        copied.Dispose();
        copied = null;
        HttpResponse moved = await client.MoveAsync("/dav/copy.txt",
            "http://127.0.0.1:54392/dav/moved.txt", true);
        Console.WriteLine("move=" + Convert.ToString(moved.statusCode));
        moved.Dispose();
        moved = null;

        server.Stop();
        return 0;
    }

    static async void Main() {
        int _rc = await Run();
    }
}
