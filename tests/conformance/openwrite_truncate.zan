using System;
using System.IO;

/// FileStream.OpenWrite is documented as "create or truncate", so opening an
/// existing file with more content than the new one must leave exactly the
/// new bytes, not a tail of the old data. The old implementation opened with
/// "r+b" and only fell back to "w+b" when the file did not exist, so a short
/// rewrite left the remainder of the previous contents in place.
class Program {
    static int bad;

    static void Check(bool ok, string label) {
        if (!ok) { Console.WriteLine("FAIL " + label); bad = bad + 1; }
    }

    static nint Buf(string s) {
        nint b = NativeMemory.Alloc(s.Length);
        NativeMemory.PutString(b, 0, s, s.Length);
        return b;
    }

    static void WriteAll(FileStream fs, string s) {
        nint b = Buf(s);
        fs.WriteFrom(b, s.Length);
        NativeMemory.Free(b);
    }

    static void Main() {
        // 用例写相对路径 _scratch/，而 ctest 的工作目录是 build/：目录不存在时
        // 写入会抛异常（干净克隆上必然如此，之前只是碰巧有这个目录）。
        Directory.CreateDirectory("_scratch");
        string path = "_scratch/ow_trunc.tmp";

        // Shorter rewrite: the file must contain only the new text.
        File.WriteAllText(path, "0123456789");
        FileStream fs = FileStream.OpenWrite(path);
        WriteAll(fs, "X");
        fs.Close();
        Check(File.ReadAllText(path) == "X", "short rewrite truncates");

        // Rewriting over an existing file that is itself overwritten fully.
        File.WriteAllText(path, "abc");
        FileStream fs2 = FileStream.OpenWrite(path);
        WriteAll(fs2, "abcdef");
        fs2.Close();
        Check(File.ReadAllText(path) == "abcdef", "full rewrite");

        // New file: OpenWrite creates it.
        string fresh = "_scratch/ow_fresh.tmp";
        File.Delete(fresh);
        FileStream fs3 = FileStream.OpenWrite(fresh);
        WriteAll(fs3, "new");
        fs3.Close();
        Check(File.ReadAllText(fresh) == "new", "creates missing file");
        File.Delete(fresh);

        File.Delete(path);
        Console.WriteLine("openwrite-truncate-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
