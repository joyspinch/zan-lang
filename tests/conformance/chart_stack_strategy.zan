// A9: 系列 stackStrategy（ECharts processor/dataStack.ts:112-165）。
//
// 此前 ChartSeries 根本没有 stackStrategy 字段（grep 全 Chart 目录 0 命中），
// 堆叠一律按"正负双累加器"——等价于 stackStrategy:'all' 的粗略版。官方
// 缺省是 **'samesign'**（只同号累加），两者在混号数据上分岔：
//   [10,-8,0] samesign → 10,-8,-8（0 跟随负链），旧双累加器 → 10,-8,10。
// 本用例断言移植后的 ChartView.StackResults 纯函数，逐条对齐 ECharts 6.1
// SSR oracle（_scratch/a9full.expected，235 行全策略随机混号数据，本引擎
// 与官方**逐行相同**），以及解析/克隆/分组三条接线。
//
// 语义要点（源码逐条）：
//   ①sum 从**本系列自己的原始值**起算（`let sum = targetData.get(
//      stackedDimension, dataIndex)`）；
//   ②从本系列往前扫前驱 j = idx-1 .. 0，取**第一个**满足策略条件的
//      前驱的**结果值**（`stackInfo.data.getByRawIndex(stackResult
//      Dimension, ...)`——是链上前驱的结果，不是原始值）累加后
//      **单次 break**（不是全累加）；
//   ③策略条件：all → 恒真；positive → val > 0；negative → val < 0；
// 核心契约与语义定义。
//   ④无合格前驱 ⇒ 结果就是自身值。
// 策略是**逐系列**的（`targetStackInfo.seriesModel.get('stackStrategy')`），
// 链上每个前驱用**它自己**的策略判定——故 StackResults 收 strategies 列表。
using System;
using Gui.Component.Chart;

namespace Conf;

class Program {
    /// 逐系列策略跑一遍链，输出空格分隔的结果（整数数据）。
    static string Run(List<int> raw, List<int> strategies) {
        List<double> rv = new List<double>();
        for (int i = 0; i < raw.Count; i = i + 1) { rv.Add((double)raw[i]); }
        List<double> into = new List<double>();
        ChartView.StackResults(rv, strategies, into);
        string s = "";
        for (int i = 0; i < into.Count; i = i + 1) {
            if (i > 0) { s = s + " "; }
            s = s + Convert.ToString((int)into[i]);
        }
        return s;
    }

    static List<int> Rep(int v, int n) {
        List<int> l = new List<int>();
        for (int i = 0; i < n; i = i + 1) { l.Add(v); }
        return l;
    }

    static List<int> Data(List<int> v) { return v; }

    /// 建一组同 stackName 的柱系列（数值取自 v）。
    static List<ChartSeries> Stack(List<int> v, string stackName, int strategy) {
        List<ChartSeries> outl = new List<ChartSeries>();
        for (int i = 0; i < v.Count; i = i + 1) {
            List<int> one = new List<int>();
            one.Add(v[i]);
            ChartSeries s = ChartSeries.Bar("s" + Convert.ToString(i), one);
            s.stackName = stackName;
            s.stackStrategy = strategy;
            outl.Add(s);
        }
        return outl;
    }

    /// 各策略在某向量上的结果（oracle 行）。
    static void Row(string tag, List<int> v) {
        Console.WriteLine("ss-" + tag + "|default|" + Program.Run(v, Program.Rep(0, v.Count)));
        Console.WriteLine("ss-" + tag + "|all|" + Program.Run(v, Program.Rep(1, v.Count)));
        Console.WriteLine("ss-" + tag + "|positive|" + Program.Run(v, Program.Rep(2, v.Count)));
        Console.WriteLine("ss-" + tag + "|negative|" + Program.Run(v, Program.Rep(3, v.Count)));
    }

    static void Main() {
        // ①四种策略 × 五个向量，逐行对齐 oracle。
        //    [10,-8,0]：0 跟负链。
        Program.Row("a", Program.Data(new List<int>{-3, 6, -6, 2}));
        Program.Row("b", Program.Data(new List<int>{7, -8, -1, 5, -3}));
        Program.Row("c", Program.Data(new List<int>{10, -8, 0}));
        Program.Row("d", Program.Data(new List<int>{-4, 1, 7, 4, -8}));
        Program.Row("e", Program.Data(new List<int>{5, 0, -8}));

        // ②逐系列策略：链上每个前驱按**它自己**的策略判定。
        //    前驱 s0 用 'positive'（值 -4 不合格 → 跳过），s1 用缺省
        //    samesign（sum=-4<=0 且 val=-1<0 → 累加）。s2 自身 = 7。
        List<int> mix = new List<int>{-4, -1, 7};
        List<int> mixSt = new List<int>{2, 0, 0};
        Console.WriteLine("mixed|" + Program.Run(mix, mixSt));

        // ③解析：stackStrategy 字符串 → 枚举码；未知/缺省 → 0。
        ChartOption o = ChartOption.FromJson("{\"xAxis\":{\"type\":\"category\",\"data\":[\"a\"]},\"yAxis\":{},\"series\":[{\"type\":\"bar\",\"stack\":\"g\",\"stackStrategy\":\"all\",\"data\":[1]},{\"type\":\"bar\",\"stack\":\"g\",\"stackStrategy\":\"positive\",\"data\":[1]},{\"type\":\"bar\",\"stack\":\"g\",\"stackStrategy\":\"negative\",\"data\":[1]},{\"type\":\"bar\",\"stack\":\"g\",\"data\":[1]},{\"type\":\"bar\",\"stack\":\"g\",\"stackStrategy\":\"samesign\",\"data\":[1]}]}");
        string ps = "";
        for (int i = 0; i < o.series.Count; i = i + 1) {
            if (i > 0) { ps = ps + ","; }
            ps = ps + Convert.ToString(o.series[i].stackStrategy);
        }
        Console.WriteLine("parse|" + ps);

        // ④Clone 携带。
        ChartSeries src = ChartSeries.Bar("s", new List<int>{1, 2});
        src.stackStrategy = 3;
        ChartSeries cp = ChartSeries.Clone(src);
        Console.WriteLine("clone|" + Convert.ToString(cp.stackStrategy));

        // ⑤分组接线：同 stackName 成一组，StackTopAt 取链末值、
        //    StackBaseAt = 链末 − 自身。
        //    g1 = [-3,6,-6,2] 四条各一值（缺省 samesign）→ 链 -3,6,-9,8。
        List<ChartSeries> g = Program.Stack(new List<int>{-3, 6, -6, 2}, "g1", 0);
        Console.WriteLine("top0|" + Convert.ToString((int)ChartView.StackTopAt(g, 0, 0))
            + "," + Convert.ToString((int)ChartView.StackTopAt(g, 1, 0))
            + "," + Convert.ToString((int)ChartView.StackTopAt(g, 2, 0))
            + "," + Convert.ToString((int)ChartView.StackTopAt(g, 3, 0)));
        Console.WriteLine("base3|" + Convert.ToString((int)ChartView.StackBaseAt(g, 3, 0)));

        // ⑥窗口组顶（轴量程用）：链 [-3,6,-9,8] 的正侧最大 8、
        //    负侧最小 -9（原始值单位，调用方直接喂 NiceMax/NiceMin）。
        Console.WriteLine("winMax|" + Convert.ToString(Chart.MaxBarStackGroupsW(g, 1, 0)));
        Console.WriteLine("winMin|" + Convert.ToString(Chart.MinBarStackGroupsW(g, 1, 0)));

        // ⑦极坐标组顶同源：同一组数据的 PolarStackTops 末行 = 组顶。
        List<string> ids = new List<string>();
        for (int i = 0; i < g.Count; i = i + 1) { ids.Add("g1"); }
        List<List<double>> tops = ChartView.PolarStackTops(g, ids, 1);
        Console.WriteLine("polar|" + Convert.ToString((int)tops[3][0]));

        // ⑧未声明 stack 的系列**不进任何堆叠组**（ECharts dataStack.ts:44
        //    的 `if (stack)`）：既不被前面的系列累加，也不作为前驱被
        //    后面读。空 stackName 只对列布局（并排柱分组）有意义。
        //    此前把它们当成"同名空组"互相累加，area-rainfall 之类
        //    多系列非堆叠图上量程/基线整体偏移。
        List<ChartSeries> free = new List<ChartSeries>();
        free.Add(ChartSeries.Bar("a", new List<int>{5}));
        free.Add(ChartSeries.Bar("b", new List<int>{7}));
        free.Add(ChartSeries.Bar("c", new List<int>{9}));
        Console.WriteLine("free|" + Convert.ToString((int)ChartView.StackTopAt(free, 0, 0))
            + "," + Convert.ToString((int)ChartView.StackTopAt(free, 1, 0))
            + "," + Convert.ToString((int)ChartView.StackTopAt(free, 2, 0))
            + "|base=" + Convert.ToString((int)ChartView.StackBaseAt(free, 2, 0)));

        Console.WriteLine("chart_stack_strategy_test: OK");
    }
}
