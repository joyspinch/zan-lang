using System;
using System.Collections.Generic;
using System.Windows;

namespace Conf;

class DesktopCompanionDockNeedsDigestTest {
    static void Main() {
        // 1. 多屏工作区贴边吸附 + 自动藏匿仅露 12px 探头 + 悬停弹出
        // 模拟副屏工作区 x=[1920..3840), y=[0..1040)
        CompanionEdgeDocker docker = new CompanionEdgeDocker(1920, 0, 1920, 1040, 24, 12, 1.5f);
        int sx;
        int sy;
        // 窗口宽 200 拖到距右边缘 10px 处 -> 磁吸贴右边 x = 3840 - 200 = 3640
        DockEdge edge = docker.EvaluateSnap(3630, 300, 200, 200, out sx, out sy);
        int tx;
        int ty;
        bool hidEarly = docker.TickAutoHide(1.0f, false, sx, sy, 200, 200, out tx, out ty);
        bool hidNow = docker.TickAutoHide(0.6f, false, sx, sy, 200, 200, out tx, out ty);
        int collapsedX = tx; // 3840 - 12 = 3828（仅露 12px 探头）
        bool hoverRestore = !docker.TickAutoHide(0.1f, true, sx, sy, 200, 200, out tx, out ty);
        bool dockOk = edge == DockEdge.Right && sx == 3640 && sy == 300
            && !hidEarly && hidNow && collapsedX == 3828
            && hoverRestore && tx == 3640 && !docker.IsCollapsed;
        Console.WriteLine("companion-edge-docker-peek: " + Convert.ToString(dockOk ? 1 : 0));

        // 2. 虚拟桌宠四维需求衰减、状态推导与交互养成
        CompanionNeedsSimulator pet = new CompanionNeedsSimulator();
        bool startHappy = pet.EvaluateMoodState() == CompanionMoodState.Happy;
        pet.AdvanceHours(6.0f); // Hunger 85 - 72 = 13 (<25 -> Hungry!)
        bool isHungry = pet.EvaluateMoodState() == CompanionMoodState.Hungry;
        pet.Feed(80.0f);        // Hunger -> 93
        pet.Rest(50.0f);        // Energy -> 87
        pet.Clean(30.0f);       // Hygiene -> 91
        pet.Play(35.0f);        // Mood 升至 >= 75，同时轻微消耗 Energy/Hygiene
        bool backHappy = pet.EvaluateMoodState() == CompanionMoodState.Happy;
        bool needsOk = startHappy && isHungry && backHappy
            && pet.Hunger >= 90.0f && pet.Energy >= 75.0f && pet.Mood >= 75.0f;
        Console.WriteLine("companion-needs-tamagotchi: " + Convert.ToString(needsOk ? 1 : 0));

        // 3. 免打扰通知折叠摘要与紧急穿透
        CompanionNotificationDigest digest = new CompanionNotificationDigest();
        digest.DoNotDisturb = true;
        bool a1; bool a2; bool a3; bool aUrgent;
        digest.Ingest("GitHub", "PR #1 opened", 0, out a1);
        digest.Ingest("GitHub", "PR #1 approved", 1, out a2);
        digest.Ingest("Slack", "Lunch?", 0, out a3);
        digest.Ingest("PagerDuty", "Prod DB down", 2, out aUrgent); // >=2 穿透免打扰立即提醒

        int totalDef = digest.TotalDeferredEvents();
        List<NotificationDigestItem> items = digest.FlushDigest();
        bool foundGh = false;
        for (int i = 0; i < items.Count; i = i + 1) {
            if (items[i].Source == "GitHub" && items[i].Count == 2
                && items[i].LatestMessage == "PR #1 approved" && items[i].MaxPriority == 1) {
                foundGh = true;
            }
        }
        bool digestOk = !a1 && !a2 && !a3 && aUrgent
            && totalDef == 3 && items.Count == 2 && foundGh
            && digest.DeferredSourceCount == 0;
        Console.WriteLine("companion-dnd-notification-digest: " + Convert.ToString(digestOk ? 1 : 0));
    }
}
