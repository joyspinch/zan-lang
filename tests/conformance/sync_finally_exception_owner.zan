using System;

class Original : Exception {
    string payload;
    int[] values;
    Original(int id) : base("original:" + id) {
        payload = "payload:" + id;
        values = new int[2];
        values[0] = id;
    }
}

class Program {
    static void Fail(int id) { throw new ArgumentException("replacement:" + id); }

    static void Replace(int mode) {
        try {
            throw new Original(mode);
        } finally {
            if (mode == 1) throw new ArgumentException("replacement:" + mode);
            if (mode == 2) Fail(mode);
            if (mode == 3) {
                try { throw new Original(30); }
                finally { Fail(mode); }
            }
            if (mode == 4) {
                try { Fail(mode); }
                catch (ArgumentException) { throw; }
            }
        }
    }

    static string ReturnValue() {
        try { throw new Original(5); }
        finally { return "returned:" + 5; }
    }

    static void ReturnVoid() {
        try { throw new Original(6); }
        finally { return; }
    }

    static void Transfers() {
        for (int i = 0; i < 2; i++) {
            try { throw new Original(7); }
            finally { continue; }
        }
        Console.WriteLine("continue");
        while (true) {
            try { throw new Original(8); }
            finally { break; }
        }
        Console.WriteLine("break");
        try { throw new Original(9); }
        finally { goto finished; }
        finished:
        Console.WriteLine("goto");
    }

    static void Preserve(int mode) {
        try { throw new Original(10 + mode); }
        finally {
            // These transfers stay inside the finally, so its owner survives.
            for (int i = 0; i < 2; i++) {
                if (i == 0) continue;
                break;
            }
            goto inside;
            inside:
            if (mode == 0) {
                try { Fail(10); }
                catch (ArgumentException ex) { Console.WriteLine(ex.Message); }
            } else {
                try { throw new Original(20); }
                catch (Original ex) { Console.WriteLine(ex.Message); }
                finally { Console.WriteLine("nested normal"); }
            }
        }
    }

    static void SameFrame() {
        try {
            try { throw new Original(12); }
            finally { Fail(12); }
        } catch (ArgumentException ex) {
            Console.WriteLine(ex.Message);
        }
    }

    static void NestedReturn() {
        try { throw new Original(13); }
        finally {
            try { throw new Original(14); }
            finally { return; }
        }
    }

    static void OuterFinally() {
        try {
            try { throw new Original(15); }
            finally { Console.WriteLine("inner normal"); }
        } finally { Fail(15); }
    }

    static void ThrowOriginal(int id) { throw new Original(id); }

    static void NativeEntry() {
        try { ThrowOriginal(16); }
        finally { Fail(16); }
    }

    static void SameObject() {
        Original shared = new Original(17);
        try {
            try { throw shared; }
            finally { throw shared; }
        } catch (Original ex) {
            Console.WriteLine(ex.Message);
            Console.WriteLine(shared.Message);
        }
    }

    static void Main() {
        for (int mode = 1; mode <= 4; mode++) {
            try { Replace(mode); }
            catch (ArgumentException ex) { Console.WriteLine(ex.Message); }
            catch (Original) { Console.WriteLine("wrong original"); }
        }
        Console.WriteLine(ReturnValue());
        ReturnVoid();
        Console.WriteLine("void");
        Transfers();
        for (int mode = 0; mode < 2; mode++) {
            try { Preserve(mode); }
            catch (Original ex) { Console.WriteLine(ex.Message); }
            catch (ArgumentException) { Console.WriteLine("wrong replacement"); }
        }
        SameFrame();
        NestedReturn();
        Console.WriteLine("nested return");
        try { OuterFinally(); }
        catch (ArgumentException ex) { Console.WriteLine(ex.Message); }
        try { NativeEntry(); }
        catch (ArgumentException ex) { Console.WriteLine(ex.Message); }
        SameObject();
        Console.WriteLine("done");
    }
}
