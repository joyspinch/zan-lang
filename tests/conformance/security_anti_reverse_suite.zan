using System;
using System.Security;

class Program {
    static void Main() {
        // 1. 测试 Mba 算术混淆与恒等式
        long a = 123456789L;
        long b = 987654321L;

        bool eq1 = Mba.Eq(a, b);
        bool eq2 = Mba.Eq(a, 123456789L);
        bool neq1 = Mba.Neq(a, b);
        bool neq2 = Mba.Neq(a, 123456789L);

        Console.WriteLine("mba_eq_diff=" + (eq1 ? "true" : "false"));
        Console.WriteLine("mba_eq_same=" + (eq2 ? "true" : "false"));
        Console.WriteLine("mba_neq_diff=" + (neq1 ? "true" : "false"));
        Console.WriteLine("mba_neq_same=" + (neq2 ? "true" : "false"));

        long addVal = Mba.Add(100L, 250L);
        long subVal = Mba.Sub(500L, 120L);
        long xorVal = Mba.Xor(0xF0F0L, 0x0F0FL);
        Console.WriteLine("mba_add=" + addVal.ToString());
        Console.WriteLine("mba_sub=" + subVal.ToString());
        Console.WriteLine("mba_xor=" + xorVal.ToString());

        // 2. 测试数学不透明谓词
        bool opT1 = Mba.OpaqueTrue(42);
        bool opT2 = Mba.OpaqueTrue(999);
        bool opF1 = Mba.OpaqueFalse(42);
        bool opF2 = Mba.OpaqueFalse(999);
        Console.WriteLine("op_t=" + (opT1 && opT2 ? "true" : "false"));
        Console.WriteLine("op_f=" + (!opF1 && !opF2 ? "false" : "true"));

        // 3. 测试状态污染守卫 (StatePoisoner)
        // 正常全通过路径
        StatePoisoner spClean = StatePoisoner.Create(0x1337BEEFL);
        spClean.Absorb(true, 101L);
        spClean.Absorb(true, 202L);
        spClean.Absorb(true, 303L);
        long factorClean = spClean.ResolveFactor();

        long businessData = 888888L;
        long transformedClean = spClean.Transform(businessData);
        long recoveredClean = spClean.Transform(transformedClean); // 两次异或还原
        Console.WriteLine("recovered_clean=" + recoveredClean.ToString());

        // 模拟被逆向者篡改（第 2 步未通过或被注入了非法状态）
        StatePoisoner spPoisoned = StatePoisoner.Create(0x1337BEEFL);
        spPoisoned.Absorb(true, 101L);
        spPoisoned.Absorb(false, 202L); // 校验失败但被逆向者强制忽略
        spPoisoned.Absorb(true, 303L);
        long factorPoisoned = spPoisoned.ResolveFactor();

        bool isPoisSame = Mba.Eq(factorClean, factorPoisoned);
        Console.WriteLine("factor_tampered_diff=" + (isPoisSame ? "identical" : "poisoned"));

        // 4. 测试语义诱饵机 (HoneyTrap)
        string testUser = "EnterpriseZanClient";
        // 诱饵校验
        bool validFakeToken = HoneyTrap.VerifyRegistrationToken(testUser, "ZN-InvalidTokenFormat");
        Console.WriteLine("honey_trap_invalid=" + (validFakeToken ? "true" : "false"));
    }
}
