using System;
using System.Text;

// StringBuilder.Append(char) inside nested loops: its char temp used to be a
// mid-function alloca, so every append grew the stack until 5 x 300k appends
// overflowed the 8 MB main stack. Fixed-size compiler temps now live in the
// entry block.
class Program {
    static void Main() {
        long total = 0;
        for (int r = 0; r < 5; r++) {
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < 300000; i++) { sb.Append('x'); sb.Append('\n'); }
            total += sb.ToString().Length;
        }
        Console.WriteLine(total);
    }
}
