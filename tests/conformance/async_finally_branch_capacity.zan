using System;

class RootBranchError : Exception {
    public RootBranchError() : base("root") { }
}
class ExitBranchError : Exception {
    public ExitBranchError() : base("exit") { }
}
struct BranchRecord { public string Text; public long Stamp; }

class FinallyBranchCapacity {
    static int visits;
    static void Check(bool value) {
        if (!value) { throw new Exception("finally branch capacity"); }
    }
    static string Text(int value) {
        visits = visits + 1;
        return "branch-" + Convert.ToString(value);
    }
    static BranchRecord Record(int value) {
        BranchRecord result;
        result.Text = Text(value);
        result.Stamp = 9000000000L + value;
        return result;
    }
    static async string Strings() {
        try { throw new RootBranchError(); }
        catch (RootBranchError error) {
            try { return Text(1); }
            finally {
                try { return Text(2); }
                finally { throw new ExitBranchError(); }
            }
        } finally {
            try { return Text(3); }
            finally {
                try { return Text(4); }
                finally { await Task.Yield(); }
            }
        }
    }
    static async Task<BranchRecord> Records() {
        try { throw new RootBranchError(); }
        catch (RootBranchError error) {
            try { return Record(1); }
            finally {
                try { return Record(2); }
                finally { throw new ExitBranchError(); }
            }
        } finally {
            try { return Record(3); }
            finally {
                try { return Record(4); }
                finally { await Task.Yield(); }
            }
        }
    }
    static async void Main() {
        Check(await Strings() == "branch-4");
        BranchRecord result = await Records();
        await Task.Yield();
        Check(result.Text == "branch-4" && result.Stamp == 9000000004L);
        Check(visits == 8);
        Console.WriteLine("finally branch capacity ok");
    }
}
