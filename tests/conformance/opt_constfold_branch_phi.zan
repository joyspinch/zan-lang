// A595: -O1 及以上时，early-cse 会把短路条件的分支化成常量，constfold 折叠
// 该分支后若不清理死边后继块里 PHI 的 incoming 条目，模块非法、整条优化
// 管线被静默跳过，后端在非法 IR 上把字符串长度探测错判成 null（长度归 0，
// 短路判断与逐字符扫描全线失真）。本用例在注册处以 -O1 编译，钉住
// "折叠常量分支之后字符串操作仍然正确"。
using System;

class OptConstFoldPhi {
    static string Wrap(string p) {
        if (p == null || p.Length == 0) { return p; }
        return "\"" + p + "\"";
    }

    static int ScanSlashes(string path) {
        int slashes = 0;
        for (int i = 0; i < path.Length; i = i + 1) {
            int c = path[i] & 255;
            if (c == 47) { slashes = slashes + 1; }
        }
        return slashes;
    }

    static int Main() {
        string q = Wrap("C:/Program Files/Mozilla Firefox/firefox.exe");
        Console.WriteLine(q);
        if (q != "\"C:/Program Files/Mozilla Firefox/firefox.exe\"") {
            Console.WriteLine("FAIL wrap");
            return 1;
        }
        string empty = Wrap("");
        if (empty != "") { Console.WriteLine("FAIL empty"); return 2; }
        Console.WriteLine("empty-ok");
        string nul = Wrap(null);
        if (nul != null) { Console.WriteLine("FAIL null"); return 3; }
        Console.WriteLine("null-ok");
        int slashes = ScanSlashes("C:/Users/test/app");
        Console.WriteLine(slashes);
        if (slashes != 3) { Console.WriteLine("FAIL scan"); return 4; }
        Console.WriteLine("OPT CONSTFOLD PHI OK");
        return 0;
    }
}
