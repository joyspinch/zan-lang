using System;

class Config {
    public readonly string name;
    public readonly int port;
    public readonly int limit = 10;
    public int hits;

    public Config(string n, int p) {
        name = n;
        this.port = p;
    }

    public int Describe() { return name.Length + port + limit; }
}

class Program {
    static void Main() {
        Config c = new Config("api", 80);
        Console.WriteLine(c.name);
        Console.WriteLine(Convert.ToString(c.port));
        Console.WriteLine(Convert.ToString(c.limit));
        Console.WriteLine(Convert.ToString(c.Describe()));
        c.hits = 2;
        Console.WriteLine(Convert.ToString(c.hits));
    }
}
