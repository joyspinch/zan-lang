// String.CompareOrdinal / string.CompareTo answer the SIGN of the ordinal
// comparison (-1 / 0 / 1) on every platform. The intrinsic lowers to libc
// strcmp, whose magnitude is the platform's (Apple libc: the byte
// difference, MSVCRT: +-1); only a constant-folded call used to hide it.
// The operands are built at run time so nothing folds.
using System;

public class Program {
    static string Make(string head, int n) {
        string s = head;
        for (int i = 0; i < n; i = i + 1) { s = s + "a"; }
        return s;
    }
    public static void Main() {
        string mango = Make("mango", 0);
        string apple = Make("apple", 0);
        string zz = Make("z", 3);
        Console.WriteLine(mango.CompareTo(apple));
        Console.WriteLine(apple.CompareTo(mango));
        Console.WriteLine(String.CompareOrdinal(zz, Make("z", 3)));
        Console.WriteLine(String.CompareOrdinal(Make("a", 0), zz));
        Console.WriteLine(String.CompareOrdinal(zz, Make("a", 0)));
        Console.WriteLine(String.CompareOrdinal(Make("z", 1), Make("z", 2)));
    }
}
