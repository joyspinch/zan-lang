// 核心契约与语义定义。
using System;

class Cfg {
    public string K;
    public string N;
}

class Store {
    public Cfg Find(string k) {
        if (k == "hit") {
            Cfg c = new Cfg();
            c.K = "id";
            c.N = "cfg";
            return c;
        }
        return null;
    }
}

class Program {
    static string Chain(Store s) {
        Cfg a = s.Find("hit");
        if (a == null || a.K != "id" ||
            a.N != "cfg") {
            return "none";
        }
        return a.N;
    }

    static void Main() {
        Console.WriteLine(Chain(new Store()));
        Console.WriteLine("GUARD-CHAIN3-OK");
    }
}
