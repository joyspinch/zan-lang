// Conformance: the null-guard scan's loc prune is only sound on statements.
// Expression nodes are stamped with their operator token (parse_binary), so
// in a three-operand chain `a == null || a.X ... || a.Y ...` the outer node's
// loc sits AFTER the first guarded access; pruning that subtree un-guards the
// whole chain (this broke the GenDb generator build tree-wide). The chain
// must keep compiling and run.
using System;

class Cfg {
    public string K;
    public string N;
}

class Store {
    public Cfg Find(string k) {
        if (k == "hit") {
            Cfg c = new Cfg();
            c.K = "id";
            c.N = "cfg";
            return c;
        }
        return null;
    }
}

class Program {
    static string Chain(Store s) {
        Cfg a = s.Find("hit");
        if (a == null || a.K != "id" ||
            a.N != "cfg") {
            return "none";
        }
        return a.N;
    }

    static void Main() {
        Console.WriteLine(Chain(new Store()));
        Console.WriteLine("GUARD-CHAIN3-OK");
    }
}
