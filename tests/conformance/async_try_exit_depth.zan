using System;

/* 底层系统交互与数据协议契约 */

class Program {
    static async int Bump(int i) {
        await Task.Delay(0);
        return i + 1;
    }

    static async int Ret(int i) {
        try { return await Bump(i); } catch (Exception e) { return -1; }
    }

    static async int Nested(int i) {
        try {
            try { return await Bump(i); } catch (Exception e) { return -2; }
        } catch (Exception e2) { return -3; }
    }

    static async int Fin(int i) {
        try { return await Bump(i); } finally { }
    }

    /* 底层系统交互与数据协议契约 */
    static async int Caught(int i) {
        try {
            if (i % 500 == 0) { throw new Exception("boom"); }
            return await Bump(i);
        } catch (Exception e) { return 0; }
    }

    static async void Main() {
        int i = 0;
        int a = 0;
        int b = 0;
        int c = 0;
        int d = 0;
        while (i < 6000) {
            a = a + await Ret(i);
            b = b + await Nested(i);
            c = c + await Fin(i);
            d = d + await Caught(i);
            i = i + 1;
        }
        Console.WriteLine("ret " + Convert.ToString(a));
        Console.WriteLine("nested " + Convert.ToString(b));
        Console.WriteLine("finally " + Convert.ToString(c));
        Console.WriteLine("caught " + Convert.ToString(d));
    }
}
