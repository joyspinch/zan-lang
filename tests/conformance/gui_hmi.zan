using System;
using Gui;
using Gui.Hmi;

/// Headless checks for the industrial (HMI/SCADA) model types: process tags
/// scale and alarm on their limits, the alarm buffer acknowledges and purges,
/// the trend ring buffer keeps the newest samples, and the equipment panel
/// addresses its cards by device name.
class GuiHmiTest {
    static void Main() {
        TagTable io = new TagTable();
        IoTag pv = io.Add("TIC101.PV", "C", 10);
        pv.Range(0, 3000).Limits(500, 2500);

        pv.SetRaw(1234);
        Console.WriteLine(pv.Text() + " " + pv.TextWithUnit());
        Console.WriteLine(Convert.ToString(pv.Percent()) + " "
                          + Convert.ToString(pv.Alarm()));
        pv.SetRaw(2600);
        Console.WriteLine(Convert.ToString(pv.Alarm()));
        pv.SetRaw(400);
        Console.WriteLine(Convert.ToString(pv.Alarm()));
        pv.SetBad();
        Console.WriteLine(Convert.ToString(pv.IsGood()));
        pv.SetRaw(1000);
        Console.WriteLine(Convert.ToString(pv.IsGood()) + " "
                          + Convert.ToString(pv.Alarm()));

        AlarmBuffer buf = new AlarmBuffer();
        buf.Raise("TIC101.PV", "high limit", 2);
        buf.Raise("LIC102.PV", "low limit", 1);
        Console.WriteLine(Convert.ToString(buf.Count()) + " "
                          + Convert.ToString(buf.UnackedCount()));
        Console.WriteLine(buf.Newest().Message());
        buf.AckAll();
        Console.WriteLine(Convert.ToString(buf.UnackedCount()));
        buf.Purge();
        Console.WriteLine(Convert.ToString(buf.Count()));

        TrendPen pen = new TrendPen("PV", pv, 255, 8);
        for (int i = 0; i < 5; i = i + 1) {
            pen.Push(i * 100);
        }
        Console.WriteLine(Convert.ToString(pen.Count()) + " "
                          + Convert.ToString(pen.At(0)) + " "
                          + Convert.ToString(pen.At(pen.Count() - 1)));

        EquipPanel wall = new EquipPanel();
        wall.SetItemsText("Pump 1|Pump 2|Fan");
        wall.AddDevice("Mixer").Row("PV", pv);
        wall.Set("Fan", 3);
        wall.Set("Nope", 1);
        Console.WriteLine(Convert.ToString(wall.Count()) + " "
                          + Convert.ToString(wall.Of("Fan").State().Get()) + " "
                          + Convert.ToString(wall.Of("Nope") == null) + " "
                          + Convert.ToString(wall.At(3).RowCount()));
        Console.WriteLine(DeviceCard.TextOf(1) + " " + DeviceCard.TextOf(3));
    }
}
