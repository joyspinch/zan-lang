using System;
using Game.Net;

class Program {
    static int Main() {
        // 1. 高光剪辑书签自动合并重叠窗口
        NetHighlightClipBookmarker bm = new NetHighlightClipBookmarker(3000L, 2000L);
        bm.MarkMoment(10000L, 50); // [7000..12000]
        bm.MarkMoment(13000L, 70); // [10000..15000] -> 与前者重叠，合并为 [7000..15000], score=120
        bm.MarkMoment(30000L, 40); // [27000..32000] -> 独立新片段
        HighlightClipWindow c0 = bm.ClipAt(0);
        HighlightClipWindow c1 = bm.ClipAt(1);
        bool bmOk = bm.ClipCount() == 2 && c0 != null && c1 != null
            && c0.StartMs == 7000L && c0.EndMs == 15000L && c0.PeakScore == 120
            && c1.StartMs == 27000L && c1.EndMs == 32000L;
        Console.WriteLine("highlight_clip_ok=" + (bmOk ? "1" : "0"));

        // 2. 抽卡软/硬保底与大小保底校验
        NetGachaPityCounter pity = new NetGachaPityCounter(0.01f, 70, 80, 0.08f);
        float r1 = pity.NextPullTopRate(); // 0.01
        for (int i = 0; i < 69; i = i + 1) { pity.RecordPullResult(false, false); }
        float rSoft = pity.NextPullTopRate(); // 第 70 抽进入软保底 -> 0.09
        for (int i = 0; i < 10; i = i + 1) { pity.RecordPullResult(false, false); }
        float rHard = pity.NextPullTopRate(); // 第 80 抽硬保底 -> 1.0
        bool lost5050 = !pity.RecordPullResult(true, false); // 歪了 -> 计数清零且开启大保底
        bool guaranteedNext = pity.GuaranteedFeatured && pity.PullsSinceTop == 0;
        bool wonFeatured = pity.RecordPullResult(true, false); // 大保底必出当期 UP
        bool pityOk = r1 > 0.009f && r1 < 0.011f && rSoft > 0.085f && rHard >= 0.999f
            && lost5050 && guaranteedNext && wonFeatured && !pity.GuaranteedFeatured;
        Console.WriteLine("gacha_pity_ok=" + (pityOk ? "1" : "0"));

        // 3. 零停机专用服优雅排空控制器
        NetServerGracefulDrain drain = new NetServerGracefulDrain();
        bool a1 = drain.TryAllocateMatch();
        bool a2 = drain.TryAllocateMatch();
        drain.BeginDrain(1000L, 60000L);
        bool rejectNew = !drain.TryAllocateMatch();
        bool stillDraining = drain.Phase == ServerDrainPhase.Draining;
        drain.NotifyMatchEnded(5000L);
        bool notReadyYet = !drain.CheckShutdownReady(6000L);
        drain.NotifyMatchEnded(7000L);
        bool readyNow = drain.Phase == ServerDrainPhase.ReadyToShutdown;
        Console.WriteLine("server_drain_ok=" + ((a1 && a2 && rejectNew && stillDraining && notReadyYet && readyNow) ? "1" : "0"));
        return 0;
    }
}
