// A lambda returns ITS OWN value, not the enclosing method's: a block-bodied
// lambda with a value return inside a void method is legal -- the C host
// compiles and runs it.
//
// The self-hosted checker used to police the lambda body against the
// *enclosing method's* return type and reported "cannot return a value from
// a void method" -- a false positive on a program the host accepts.
using System;

class Program {
    static void Main() {
        Func<int> f = delegate () { return 5; };
        Console.WriteLine(f());
        Action a = delegate () { Console.WriteLine("action"); };
        a();
    }
}
