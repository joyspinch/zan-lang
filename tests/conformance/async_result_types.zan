// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 核心契约与执行状态转移规范。
using System;

class Point {
    int x;
    static Point Of(int x) { Point p = new Point(); p.x = x; return p; }
}

class Program {
    static async int NegInt() {
        await Task.Delay(1);
        return -123456789;
    }

    static async long BigLong() {
        await Task.Delay(1);
        return 4294967296;
    }

    static async uint BigUint() {
        await Task.Delay(1);
        return 4294967295;
    }

    static async byte SmallByte() {
        await Task.Delay(1);
        return 250;
    }

    static async short NegShort() {
        await Task.Delay(1);
        return -32768;
    }

    static async bool Flag() {
        await Task.Delay(1);
        return true;
    }

    static async double Half() {
        await Task.Delay(1);
        return 0.5;
    }

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    static async double WholeFromInt() {
        await Task.Delay(1);
        return 3;
    }

    static async string Text() {
        await Task.Delay(1);
        return "zan";
    }

    static async Point Boxed() {
        await Task.Delay(1);
        return Point.Of(9);
    }

    static async int Run() {
        Console.WriteLine("negint=" + Convert.ToString(await Program.NegInt()));
        Console.WriteLine("biglong=" + Convert.ToString(await Program.BigLong()));
        Console.WriteLine("biguint=" + Convert.ToString(await Program.BigUint()));
        Console.WriteLine("byte=" + Convert.ToString(await Program.SmallByte()));
        Console.WriteLine("short=" + Convert.ToString(await Program.NegShort()));
        Console.WriteLine("flag=" + Convert.ToString(await Program.Flag()));
        Console.WriteLine("half=" + Convert.ToString(await Program.Half()));
        Console.WriteLine("whole=" + Convert.ToString(await Program.WholeFromInt()));
        // 接口数据协议与执行契约。
        var t = await Program.Text();
        var p = await Program.Boxed();
        var d = await Program.Half();
        Console.WriteLine("text=" + t);
        Console.WriteLine("point=" + Convert.ToString(p.x));
        Console.WriteLine("sum=" + Convert.ToString(d + 0.25));
        return await Program.NegInt() + 123456790;
    }

    static async void Main() {
        Console.WriteLine("run=" + Convert.ToString(await Program.Run()));
    }
}
