using System;
using System.Numerics;

struct FixedNum : INumber<FixedNum> {
    public int Raw;

    public FixedNum(int raw) {
        this.Raw = raw;
    }

    public static FixedNum Zero => new FixedNum(0);
    public static FixedNum One => new FixedNum(10);

    public static FixedNum operator +(FixedNum a, FixedNum b) => new FixedNum(a.Raw + b.Raw);
    public static FixedNum operator -(FixedNum a, FixedNum b) => new FixedNum(a.Raw - b.Raw);
    public static FixedNum operator *(FixedNum a, FixedNum b) => new FixedNum((a.Raw * b.Raw) / 10);
    public static FixedNum operator /(FixedNum a, FixedNum b) => new FixedNum((a.Raw * 10) / b.Raw);
    public static FixedNum operator -(FixedNum a) => new FixedNum(-a.Raw);
    public static bool operator ==(FixedNum a, FixedNum b) => a.Raw == b.Raw;
    public static bool operator !=(FixedNum a, FixedNum b) => a.Raw != b.Raw;
    public static bool operator <(FixedNum a, FixedNum b) => a.Raw < b.Raw;
    public static bool operator >(FixedNum a, FixedNum b) => a.Raw > b.Raw;
    public static bool operator <=(FixedNum a, FixedNum b) => a.Raw <= b.Raw;
    public static bool operator >=(FixedNum a, FixedNum b) => a.Raw >= b.Raw;
}

interface IMonoid<TSelf> {
    static abstract TSelf Identity { get; }
    static abstract TSelf Combine(TSelf a, TSelf b);
}

struct AddMonoid : IMonoid<AddMonoid> {
    public int Value;
    public AddMonoid(int v) { this.Value = v; }
    public static AddMonoid Identity => new AddMonoid(0);
    public static AddMonoid Combine(AddMonoid a, AddMonoid b) => new AddMonoid(a.Value + b.Value);
}

class StrMonoid : IMonoid<StrMonoid> {
    public string Text;
    public StrMonoid(string t) { this.Text = t; }
    public static StrMonoid Identity => new StrMonoid("");
    public static StrMonoid Combine(StrMonoid a, StrMonoid b) {
        if (a.Text.Length == 0) return new StrMonoid(b.Text);
        if (b.Text.Length == 0) return new StrMonoid(a.Text);
        return new StrMonoid(a.Text + "-" + b.Text);
    }
}

interface IBox {
    type Item;
    Item Unbox();
}

struct IntBox : IBox {
    type Item = int;
    public int Val;
    public IntBox(int v) { this.Val = v; }
    public int Unbox() => this.Val;
}

class StrBox : IBox {
    type Item = string;
    public string Val;
    public StrBox(string v) { this.Val = v; }
    public string Unbox() => this.Val;
}

class Program {
    static T Sum<T>(Span<T> data) where T : INumber<T> {
        T acc = T.Zero;
        for (int i = 0; i < data.Length; i++) {
            acc = acc + data[i];
        }
        return acc;
    }

    static T Product<T>(Span<T> data) where T : INumber<T> {
        T acc = T.One;
        for (int i = 0; i < data.Length; i++) {
            acc = acc * data[i];
        }
        return acc;
    }

    static T NegDiff<T>(T a, T b) where T : INumber<T> {
        return -(a - b);
    }

    static T Fold<T>(T[] items) where T : IMonoid<T> {
        T acc = T.Identity;
        for (int i = 0; i < items.Length; i++) {
            acc = T.Combine(acc, items[i]);
        }
        return acc;
    }

    static T.Item Extract<T>(T box) where T : IBox {
        T.Item v = box.Unbox();
        return v;
    }

    static void Main() {
        int[] ia = new int[] { 1, 2, 3, 4, 5 };
        int isum = Sum<int>(ia.AsSpan());
        int iprod = Product<int>(ia.AsSpan());
        int ineg = NegDiff<int>(10, 3);
        Console.WriteLine($"int:{isum},{iprod},{ineg}");

        double[] da = new double[] { 1.5, 2.5, 3.0 };
        double dsum = Sum<double>(da.AsSpan());
        double dprod = Product<double>(da.AsSpan());
        Console.WriteLine($"double:{(int)(dsum * 10.0)},{(int)(dprod * 100.0)}");

        float[] fa = new float[] { 2.0f, 3.0f, 4.0f };
        float fsum = Sum<float>(fa.AsSpan());
        float fprod = Product<float>(fa.AsSpan());
        Console.WriteLine($"float:{(int)fsum},{(int)fprod}");

        FixedNum[] xa = new FixedNum[] { new FixedNum(15), new FixedNum(20), new FixedNum(25) };
        FixedNum xsum = Sum<FixedNum>(xa.AsSpan());
        FixedNum xprod = Product<FixedNum>(xa.AsSpan());
        FixedNum xneg = NegDiff<FixedNum>(new FixedNum(30), new FixedNum(12));
        Console.WriteLine($"fixed:{xsum.Raw},{xprod.Raw},{xneg.Raw}");

        AddMonoid[] am = new AddMonoid[] { new AddMonoid(10), new AddMonoid(20), new AddMonoid(12) };
        AddMonoid ar = Fold<AddMonoid>(am);
        StrMonoid[] sm = new StrMonoid[] { new StrMonoid("a"), new StrMonoid("b"), new StrMonoid("c") };
        StrMonoid sr = Fold<StrMonoid>(sm);
        Console.WriteLine($"monoid:{ar.Value},{sr.Text}");

        IntBox ib = new IntBox(99);
        IntBox.Item iv = Extract<IntBox>(ib);
        StrBox sb = new StrBox("assoc_" + "ok");
        StrBox.Item sv = Extract<StrBox>(sb);
        Console.WriteLine($"assoc:{iv},{sv}");
    }
}
