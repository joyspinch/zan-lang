// EnumType.Member chained calls and the compiler-lowered EnumType.TryParse:
// a static member constant used as a call receiver infers the enum's own
// type, ToString names the matching member (numeric fallback otherwise), and
// TryParse probes the declaration-order name table case-sensitively, storing
// the member constant through the out slot (default(T) on a miss).
using System;
namespace Conformance;
enum Color { Red, Green = 10, Blue }
class Program {
    static void Main() {
        Console.WriteLine(Color.Green.ToString());
        Console.WriteLine(Color.Red.ToString());
        Console.WriteLine(((Color)42).ToString());
        Color c = Color.Red;
        bool ok1 = Color.TryParse("Blue", out c);
        Console.WriteLine(ok1);
        Console.WriteLine(c.ToString());
        bool ok2 = Color.TryParse("nope", out c);
        Console.WriteLine(ok2);
        Console.WriteLine(c.ToString());
        Console.WriteLine(!ok2);
    }
}
