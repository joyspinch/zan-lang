// Conformance: a qualified mention alone (`Gui.App`, no unqualified mention of
// `App` anywhere in the program) must still pull the stdlib file in. The
// shadow carve-out in the demand-driven pull-in only excuses an *unqualified*
// mention of a name the program declares itself; it must not swallow the
// qualified spelling, which names the stdlib type on purpose.
//
// This is the no-shadow twin of pullin_qualified_escape: there the program
// declares its own `class App` and the qualified mention must still escape to
// the stdlib type; here it declares no such class and the qualified mention is
// the only reason `Gui/App.zan` is needed at all. The seed's dot chain
// must not be cleared on the identifier that started it.
using System;
using Gui;

class Program {
    static int Main() {
        Console.WriteLine(Gui.App.ISqrt(9));
        return 0;
    }
}
