using System;

class Container<T> {
    public static bool IsNull(T val) {
        return val == null;
    }
    public static bool IsNotNull(T val) {
        return val != null;
    }
}

class Item {
    public int id;
}

class Program {
    static void Main() {
        Item item = new Item { id = 1 };
        Console.WriteLine(Container<Item>.IsNull(item));
        Console.WriteLine(Container<Item>.IsNull(null));
        Console.WriteLine(Container<Item>.IsNotNull(item));
        Console.WriteLine(Container<Item>.IsNotNull(null));
        Console.WriteLine(Container<string>.IsNull("hello"));
        Console.WriteLine(Container<string>.IsNull(null));
    }
}
