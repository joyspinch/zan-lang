// A509 收口用例：失败下转的类型安全守卫（软运行时返回安全值 null，防止内存混淆）
// C# .NET 8 语义：类型不匹配抛 InvalidCastException。
// Zan 软运行时口径：打 stderr 软诊断（带位置信息与 InvalidCastException 说明），
// 表达式结果回退为安全值 null，程序不发生类型混淆继续向下执行。
using System;

class User {
    public string name;
    public User(string n) { name = n; }
}

class Program {
    public static void Main() {
        // 1. 错误下转：User 实例下转为 string
        object bad1 = new User("alice");
        string s1 = (string)bad1;
        Console.WriteLine("bad1_null=" + (s1 == null ? "1" : "0"));

        // 2. 错误下转：string 实例下转为 User
        object bad2 = "bob";
        User u2 = (User)bad2;
        Console.WriteLine("bad2_null=" + (u2 == null ? "1" : "0"));

        // 3. 正确下转：User 实例下转为 User
        object good1 = new User("charlie");
        User u3 = (User)good1;
        Console.WriteLine("good1=" + (u3 != null ? u3.name : "null"));

        // 4. 正确下转：string 实例下转为 string
        object good2 = "david";
        string s4 = (string)good2;
        Console.WriteLine("good2=" + s4);
    }
}
