// A509 收口用例：失败下转的类型安全守卫（防止内存混淆）。
// B-ID163③ 起与 C# .NET 8 同语义：类型不匹配抛 InvalidCastException——try 内
// 可 catch，目标变量保持原值、不会拿到被混淆的指针；try 外未捕获则终止进程
// （runtime_cast_invalid_downcast 覆盖那条路径）。旧 A509 软失败口径
// （stderr 一次 + 结果回退 null 继续跑）已废止。
using System;

class User {
    public string name;
    public User(string n) { name = n; }
}

class Program {
    public static void Main() {
        // 1. 错误下转：User 实例下转为 string
        object bad1 = new User("alice");
        string s1 = null;
        try {
            s1 = (string)bad1;
            Console.WriteLine("bad1 no-throw");
        } catch (InvalidCastException) {
            Console.WriteLine("bad1 InvalidCastException");
        }
        Console.WriteLine("bad1_null=" + (s1 == null ? "1" : "0"));

        // 2. 错误下转：string 实例下转为 User
        object bad2 = "bob";
        User u2 = null;
        try {
            u2 = (User)bad2;
            Console.WriteLine("bad2 no-throw");
        } catch (InvalidCastException) {
            Console.WriteLine("bad2 InvalidCastException");
        }
        Console.WriteLine("bad2_null=" + (u2 == null ? "1" : "0"));

        // 3. 正确下转：User 实例下转为 User
        object good1 = new User("charlie");
        User u3 = (User)good1;
        Console.WriteLine("good1=" + (u3 != null ? u3.name : "null"));

        // 4. 正确下转：string 实例下转为 string
        object good2 = "david";
        string s4 = (string)good2;
        Console.WriteLine("good2=" + s4);

        // 5. null 可转为任意引用类型
        object none = null;
        User u5 = (User)none;
        Console.WriteLine("null_cast=" + (u5 == null ? "1" : "0"));
    }
}
