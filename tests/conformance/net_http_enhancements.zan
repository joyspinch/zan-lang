using System;
using System.Net.Http;
using System.Net.Http.Client;

class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            Program.failures = Program.failures + 1;
        }
    }

    static void Main() {
        // 1. 测试 HttpRequest 查询参数解析与零分配检查
        string rawReq = "GET /api/v1/users?page=2&size=20&filter=active&flag HTTP/1.1\r\n"
                      + "Host: example.com\r\n"
                      + "Authorization: Bearer token123\r\n"
                      + "Content-Type: application/x-www-form-urlencoded\r\n"
                      + "Content-Length: 29\r\n\r\n"
                      + "user=alice&action=login&admin";

        HttpRequest req = HttpRequest.Parse(rawReq, rawReq.Length);
        Check(req.method == "GET", "req method is GET");
        Check(req.path == "/api/v1/users", "req path parsed");
        Check(req.queryString == "page=2&size=20&filter=active&flag", "req query string parsed");
        Check(req.HasHeader("Host"), "has header Host");
        Check(req.HasHeader("Authorization"), "has header Authorization");
        Check(!req.HasHeader("X-Non-Existent"), "not has header X-Non-Existent");
        Check(req.GetHeader("Authorization") == "Bearer token123", "get header Authorization");

        // 查询参数
        Check(req.HasQueryParam("page"), "has query param page");
        Check(req.GetQueryParam("page") == "2", "get query param page");
        Check(req.HasQueryParam("size"), "has query param size");
        Check(req.GetQueryParam("size") == "20", "get query param size");
        Check(req.HasQueryParam("filter"), "has query param filter");
        Check(req.GetQueryParam("filter") == "active", "get query param filter");
        Check(req.HasQueryParam("flag"), "has valueless query param flag");
        Check(req.GetQueryParam("flag") == "", "get valueless query param flag");
        Check(!req.HasQueryParam("sort"), "not has query param sort");

        // 表单字段
        Check(req.HasFormField("user"), "has form field user");
        Check(req.GetFormField("user") == "alice", "get form field user");
        Check(req.HasFormField("action"), "has form field action");
        Check(req.GetFormField("action") == "login", "get form field action");
        Check(req.HasFormField("admin"), "has valueless form field admin");
        Check(req.GetFormField("admin") == "", "get valueless form field admin");
        Check(!req.HasFormField("password"), "not has form field password");

        // 2. 测试 HttpRouter PATCH/OPTIONS/HEAD 等路由能力
        HttpRouter router = new HttpRouter();
        router.Get("/items", "get_items");
        router.Post("/items", "post_items");
        router.Patch("/items", "patch_items");
        router.Delete("/items", "delete_items");

        HttpRequest matchReq = HttpRequest.Parse("PATCH /items HTTP/1.1\r\nHost: test\r\n\r\n", 40);
        HttpResponse resp = router.Match(matchReq);
        Check(resp.statusCode == 200, "router patch matched status 200");
        Check(resp.body == "patch_items", "router patch body matched");

        if (Program.failures == 0) {
            Console.WriteLine("ok net http enhancements suite passed");
        }
    }
}
