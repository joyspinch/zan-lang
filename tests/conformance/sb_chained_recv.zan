using System;
using System.Text;

class Probe {
    static StringBuilder Make() {
        StringBuilder sb = new StringBuilder();
        sb.Append("x");
        return sb;
    }

    static string ViaReturn() {
        return Probe.Make().ToString();
    }

    static void Main() {
        Console.WriteLine(Probe.ViaReturn());
        Probe.Make().Append("y");
        Console.WriteLine(Probe.Make().ToString());
        Console.WriteLine(Probe.Make().ToString().Length);
        string s = Probe.Make().ToString();
        Console.WriteLine(s);
        Probe.Make().Clear();
        StringBuilder b = new StringBuilder();
        b.Append("hello");
        b.Clear();
        b.Append("world");
        Console.WriteLine(b.ToString());
    }
}
