// A355: a chained owned receiver (`Make().Method()`) leaked its +1. The
// StringBuilder Append/AppendLine/ToString intrinsics evaluate the receiver
// expression directly and never released an owned one (and Append's void
// result meant the statement-level discard release never fired either) --
// every empty-body HttpResponse.BuildHeaders() leaked one StringBuilder per
// request. All four consumption shapes must balance under --check-leaks:
// return position, discarded statement, argument position, local position.
using System;
using System.Text;

class Probe {
    static StringBuilder Make() {
        StringBuilder sb = new StringBuilder();
        sb.Append("x");
        return sb;
    }

    static string ViaReturn() {
        return Probe.Make().ToString();
    }

    static void Main() {
        Console.WriteLine(Probe.ViaReturn());
        Probe.Make().Append("y");
        Console.WriteLine(Probe.Make().ToString());
        Console.WriteLine(Probe.Make().ToString().Length);
        string s = Probe.Make().ToString();
        Console.WriteLine(s);
    }
}
