using System;
using System.Net.Sockets;
using System.Threading;

class Program {
    static int PORT = 20528;
    static string serverRecv = "";
    static bool serverDone = false;

    static async void ServerTask(UdpClient server) {
        string msg = await server.RecvFromAsync(512);
        Program.serverRecv = msg;
        await server.SendToAsync("UDP_PONG", "127.0.0.1", 20529);
        Program.serverDone = true;
    }

    static async int Run() {
        Socket.Initialize();
        UdpClient server = UdpClient.Bind("127.0.0.1", PORT);
        if (server == null) {
            Console.WriteLine("server_bind_failed");
            return 1;
        }
        Console.WriteLine("server_bound=" + (server.IsBound() ? "true" : "false"));

        Task.Spawn(ServerTask(server));
        await Task.Delay(20);

        UdpClient client = UdpClient.Bind("127.0.0.1", 20529);
        if (client == null) {
            Console.WriteLine("client_bind_failed");
            server.Dispose();
            return 1;
        }
        Console.WriteLine("client_bound=" + (client.IsBound() ? "true" : "false"));

        await client.SendToAsync("UDP_PING", "127.0.0.1", PORT);
        string clientRecv = await client.RecvFromAsync(512);
        Console.WriteLine("client_recv=" + clientRecv);

        while (!Program.serverDone) {
            await Task.Delay(10);
        }
        Console.WriteLine("server_recv=" + Program.serverRecv);

        // 验证多态 IDisposable
        IDisposable dispClient = client;
        dispClient.Dispose();
        Console.WriteLine("client_disposed=" + (client.IsBound() ? "false" : "true"));

        IDisposable dispServer = server;
        dispServer.Dispose();
        Console.WriteLine("server_disposed=" + (server.IsBound() ? "false" : "true"));

        Socket.Cleanup();
        Console.WriteLine("udp_lifecycle_ok=1");
        return 0;
    }

    static async void Main() {
        await Program.Run();
    }
}
