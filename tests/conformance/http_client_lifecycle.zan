using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Http.Client;
using System.Threading;

namespace Conf;

class Program {
    static async int Run() {
        Socket.Initialize();

        // 1. 验证 HttpClient 导出为 public 且实现 IDisposable
        HttpClient client = new HttpClient("127.0.0.1", 9999);
        client.SetTimeout(5000);
        client.SetTraceParent("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01");
        Console.WriteLine("trace=" + client.TraceParent());

        // 2. 验证连接池配置与属性获取
        client.SetConnectionPool(20, 10, 45000, 120000);
        HttpConnectionPool pool = client.ConnectionPool();
        Console.WriteLine("pool_max=" + Convert.ToString(pool.MaxConnections()));
        Console.WriteLine("pool_max_idle=" + Convert.ToString(pool.MaxIdleConnections()));
        Console.WriteLine("pool_active=" + Convert.ToString(pool.ActiveCount()));
        Console.WriteLine("pool_idle=" + Convert.ToString(pool.IdleCount()));

        // 3. 验证 IDisposable 多态转换与 Dispose
        IDisposable dispPool = pool;
        dispPool.Dispose();
        Console.WriteLine("pool_disposed");

        IDisposable dispClient = client;
        dispClient.Dispose();
        Console.WriteLine("client_disposed");

        Socket.Cleanup();
        Console.WriteLine("ok");
        return 0;
    }

    static async void Main() {
        await Program.Run();
    }
}
