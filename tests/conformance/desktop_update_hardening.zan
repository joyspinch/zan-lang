using System;
using System.Collections.Generic;
using System.Drawing;
using System.Automation;
using System.Windows.Clipboard;
using Zan.AppUpdate;

class Program {
    static void Main() {
        Console.WriteLine("=== DESKTOP & APPUPDATE HARDENING TEST ===");

        // 1. System.Drawing Primitives
        Console.WriteLine("-- 1. Drawing Primitives --");
        Color c = Color.FromARGB(200, 255, 128, 0);
        Console.WriteLine("Color ARGB: " + Convert.ToString(c.a) + "," + Convert.ToString(c.r) + "," + Convert.ToString(c.g) + "," + Convert.ToString(c.b));
        Point pt = new Point(100, 200);
        Console.WriteLine("Point: " + Convert.ToString(pt.x) + "," + Convert.ToString(pt.y));
        Size sz = new Size(800, 600);
        Console.WriteLine("Size: " + Convert.ToString(sz.width) + "x" + Convert.ToString(sz.height));
        Rectangle rect = new Rectangle(50, 50, 200, 150);
        Console.WriteLine("Rect right: " + Convert.ToString(rect.Right()));
        Console.WriteLine("Rect bottom: " + Convert.ToString(rect.Bottom()));
        Console.WriteLine("Rect contains (100, 100): " + Convert.ToString(rect.Contains(100, 100)));

        ImageBuffer img = new ImageBuffer(64, 64);
        img.Clear(0xFF00FF00);
        ImageBuffer crop = img.Crop(0, 0, 32, 32);
        Console.WriteLine("Crop size: " + Convert.ToString(crop.Width) + "x" + Convert.ToString(crop.Height));
        crop.Dispose();
        img.Dispose();

        // 2. System.Automation Primitives
        Console.WriteLine("-- 2. Automation Primitives --");
        WindowRect wRect = new WindowRect(0, 0, 1024, 768);
        Console.WriteLine("WindowRect right: " + Convert.ToString(wRect.Right()));
        WindowPoint wPt = new WindowPoint(500, 300);
        Console.WriteLine("WindowPoint: " + Convert.ToString(wPt.x) + "," + Convert.ToString(wPt.y));
        WindowThreadInfo threadInfo = new WindowThreadInfo(1234, 5678);
        Console.WriteLine("ThreadInfo tid: " + Convert.ToString(threadInfo.tid) + " pid: " + Convert.ToString(threadInfo.pid));

        // 3. System.Windows.Clipboard Check
        Console.WriteLine("-- 3. Clipboard Check --");
        Console.WriteLine("Clipboard HasText callable: " + Convert.ToString(Clipboard.HasText() || !Clipboard.HasText()));

        // 4. Zan.AppUpdate Manifest & Models
        Console.WriteLine("-- 4. AppUpdate Manifest --");
        UpdateManifest manifest = new UpdateManifest();
        manifest.appName = "ZanEnterpriseApp";
        manifest.version = "2.1.0";
        manifest.files.Add(UpdateFileEntry.Create("bin/app.exe", 1048576, "d41d8cd98f00b204e9800998ecf8427e", true));
        Console.WriteLine("Manifest appName: " + manifest.appName);
        Console.WriteLine("Manifest version: " + manifest.version);
        Console.WriteLine("Manifest files count: " + Convert.ToString(manifest.files.Count));

        IntegrityReport report = new IntegrityReport();
        Console.WriteLine("IntegrityReport isClean: " + Convert.ToString(report.isClean));
        Console.WriteLine("FileIntegrityStatus Ok: " + Convert.ToString(FileIntegrityStatus.Ok));

        Console.WriteLine("ALL DESKTOP & APPUPDATE HARDENING CHECKS PASSED!");
    }
}
