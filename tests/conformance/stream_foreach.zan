using System;
using System.Linq;

class Program {
    static void Main() {
        List<int> numbers = new List<int>();
        for (int i = 1; i <= 10; i = i + 1) {
            numbers.Add(i);
        }

        Console.WriteLine("--- Test 1 ---");
        foreach (var x in numbers.AsStream().Where(n => n % 2 == 0).Take(3)) {
            Console.WriteLine(x);
        }

        Console.WriteLine("--- Test 2 ---");
        List<int> dupes = new List<int>();
        dupes.Add(1);
        dupes.Add(2);
        dupes.Add(2);
        dupes.Add(3);
        dupes.Add(4);
        dupes.Add(4);
        dupes.Add(5);
        foreach (var x in dupes.AsStream().Distinct().Skip(2)) {
            Console.WriteLine(x);
        }
    }
}
