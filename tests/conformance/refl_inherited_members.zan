// 反射继承成员（B-ID163）：方法表此前只收本类声明——派生类实例对
// 基类方法 HasMethod/Invoke 全 miss（基类批量架构 html @click 处理
// 器声明在基类即全灭）；字段表本来就含继承条目。本用例钉住：
// 1) 基类字段 HasField/Get/Set 照常可见；
// 2) 基类零参与带参方法 HasMethod 命中、Invoke 走基类实现 thunk；
// 3) 虚方法覆写后 Invoke/直调都命中最派生实现（名字遮蔽不破坏分派）。
using System;

class ReflBase {
    public string tag = "base-tag";
    public int hits = 0;

    public void BaseZero() { this.hits = this.hits + 1; }

    public virtual string Who() { return "base"; }

    public string BaseWithArg(int n) { return "arg" + Convert.ToString(n); }
}

class ReflDerived : ReflBase {
    public string own = "derived-own";

    override string Who() { return "derived"; }

    public void OwnZero() { this.hits = this.hits + 10; }
}

class CaseMain {
    static int Main() {
        ReflDerived d = new ReflDerived();
        int bad = 0;

        if (!d.HasField("own")) { Console.WriteLine("FAIL own field"); bad = bad + 1; }
        if (!d.HasField("tag")) { Console.WriteLine("FAIL base field"); bad = bad + 1; }
        if (d.GetFieldString("tag") != "base-tag") { Console.WriteLine("FAIL base get"); bad = bad + 1; }
        d.SetFieldString("tag", "mutated");
        if (d.tag != "mutated") { Console.WriteLine("FAIL base set"); bad = bad + 1; }

        if (!d.HasMethod("OwnZero")) { Console.WriteLine("FAIL own method"); bad = bad + 1; }
        if (!d.HasMethod("BaseZero")) { Console.WriteLine("FAIL base method"); bad = bad + 1; }
        if (!d.HasMethod("BaseWithArg")) { Console.WriteLine("FAIL base arg method"); bad = bad + 1; }

        d.Invoke("BaseZero");
        if (d.hits != 1) { Console.WriteLine("FAIL base invoke"); bad = bad + 1; }
        if (d.InvokeString("Who") != "derived") { Console.WriteLine("FAIL virtual invoke"); bad = bad + 1; }
        if (d.Who() != "derived") { Console.WriteLine("FAIL virtual direct"); bad = bad + 1; }

        if (bad == 0) {
            Console.WriteLine("REFL_INHERITED_OK");
            return 0;
        }
        return 1;
    }
}
