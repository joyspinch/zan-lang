using System;
using System.Data;
using System.Diagnostics;
using System.Threading;

class FakeConnection : IDbConnection {
    int id;
    bool alive;

    FakeConnection(int id) {
        this.id = id;
        this.alive = true;
    }

    DbResult Query(string sql) {
        DbResult r = new DbResult();
        r.SetColumnCount(1);
        r.AddColumnName("id");
        List<string> row = new List<string>();
        row.Add(Convert.ToString(this.id));
        r.AddRow(row);
        return r;
    }

    DbResult Query(string sql, DbParams prms) { return this.Query(sql); }
    int Execute(string sql) { return 1; }
    int Execute(string sql, DbParams prms) { return this.Execute(sql); }
    string ExecuteScalar(string sql) { return Convert.ToString(this.id); }
    string ExecuteScalar(string sql, DbParams prms) { return this.ExecuteScalar(sql); }
    async DbResult QueryAsync(string sql) { return this.Query(sql); }
    async DbResult QueryAsync(string sql, DbParams prms) { return this.Query(sql, prms); }
    async int ExecuteAsync(string sql) { return this.Execute(sql); }
    async int ExecuteAsync(string sql, DbParams prms) { return this.Execute(sql, prms); }
    async string ExecuteScalarAsync(string sql) { return this.ExecuteScalar(sql); }
    async string ExecuteScalarAsync(string sql, DbParams prms) { return this.ExecuteScalar(sql, prms); }
    void BeginTransaction() { }
    void Commit() { }
    void Rollback() { }
    async bool BeginTransactionAsync() { return true; }
    async bool CommitAsync() { return true; }
    async bool RollbackAsync() { return true; }
    bool IsConnected() { return this.alive; }
    void Close() { this.alive = false; }
    void Dispose() { this.Close(); }
    int GetProvider() { return DbProvider.SQLite; }
}

class FakeConnector : IDbConnector {
    int opened;

    FakeConnector() {
        this.opened = 0;
    }

    int Opened() { return this.opened; }

    async IDbConnection ConnectAsync() {
        await Task.Delay(1);
        this.opened = this.opened + 1;
        return new FakeConnection(this.opened);
    }

    int GetProvider() { return DbProvider.SQLite; }
}

class Check {
    static int passed = 0;
    static int failed = 0;

    static void Eq(int got, int want, string what) {
        if (got == want) {
            Check.passed = Check.passed + 1;
        } else {
            Check.failed = Check.failed + 1;
            Console.WriteLine("FAIL " + what + ": got " + Convert.ToString(got)
                + ", want " + Convert.ToString(want));
        }
    }

    static void EqStr(string got, string want, string what) {
        if (got == want) {
            Check.passed = Check.passed + 1;
        } else {
            Check.failed = Check.failed + 1;
            Console.WriteLine("FAIL " + what + ": got " + got + ", want " + want);
        }
    }

    static void True(bool cond, string what) {
        if (cond) {
            Check.passed = Check.passed + 1;
        } else {
            Check.failed = Check.failed + 1;
            Console.WriteLine("FAIL " + what);
        }
    }
}

class BorrowResult {
    string value = "";
    bool completed;

    public void Complete(string value) {
        lock (this) {
            this.value = value;
            this.completed = true;
        }
    }

    // Observe completion independently of the timed Gate used by the pool.
    public async bool WaitUntilComplete(int timeoutMs) {
        long deadline = ServerMetrics.MonoMillis() + timeoutMs;
        while (!this.IsComplete() && ServerMetrics.MonoMillis() < deadline) {
            await Task.Delay(1);
        }
        return this.IsComplete();
    }

    public bool IsComplete() {
        lock (this) { return this.completed; }
    }

    public string GetValue() {
        lock (this) { return this.value; }
    }
}

class Program {
    static async void RecordBorrow(DbPool pool, BorrowResult result) {
        IDbConnection c = await pool.AcquireAsync();
        if (c == null) {
            result.Complete("null");
        } else {
            string value = c.ExecuteScalar("SELECT 1");
            pool.Release(c);
            result.Complete(value);
        }
    }

    static async void Recovery() {
        FakeConnector f = new FakeConnector();
        DbPool pool = new DbPool(f, 1);
        IDbConnection held = await pool.AcquireAsync();
        Check.Eq(f.Opened(), 1, "one connection opened");

        BorrowResult result = new BorrowResult();
        Task.Spawn(Program.RecordBorrow(pool, result));
        long admissionDeadline = ServerMetrics.MonoMillis() + 500;
        while (pool.WaitingCount() == 0 && !result.IsComplete()
               && ServerMetrics.MonoMillis() < admissionDeadline) {
            await Task.Delay(1);
        }
        Check.True(!result.IsComplete(), "waiter parked while saturated");
        Check.Eq(pool.WaitingCount(), 1, "one waiter on the gate");

        pool.Release(held);
        await result.WaitUntilComplete(500);
        Check.True(result.IsComplete() && result.GetValue() == "1", "release woke the waiter");
        Check.Eq(pool.WaitingCount(), 0, "gate drained cleanly");
        pool.Close();
    }

    static async void ExhaustionFastFails() {
        int saveWaits = PoolWait.MaxGateWaits;
        int saveFuse = PoolWait.GateWaitMs;
        int saveStep = PoolWait.PollStepMs;
        int saveBudget = PoolWait.PollBudgetMs;
        PoolWait.MaxGateWaits = 2;
        PoolWait.GateWaitMs = 20;
        PoolWait.PollStepMs = 5;
        PoolWait.PollBudgetMs = 25;

        FakeConnector f = new FakeConnector();
        DbPool pool = new DbPool(f, 1);
        IDbConnection held = await pool.AcquireAsync();

        BorrowResult first = new BorrowResult();
        BorrowResult second = new BorrowResult();
        long t0 = ServerMetrics.MonoMillis();
        Task.Spawn(Program.RecordBorrow(pool, first));
        Task.Spawn(Program.RecordBorrow(pool, second));
        await first.WaitUntilComplete(500);
        await second.WaitUntilComplete(500);
        long dt = ServerMetrics.MonoMillis() - t0;

        PoolWait.MaxGateWaits = saveWaits;
        PoolWait.GateWaitMs = saveFuse;
        PoolWait.PollStepMs = saveStep;
        PoolWait.PollBudgetMs = saveBudget;

        Check.True(first.IsComplete() && second.IsComplete(), "both borrowers gave up in bounded time");
        Check.EqStr(first.GetValue(), "null", "first borrower fast-failed");
        Check.EqStr(second.GetValue(), "null", "second borrower fast-failed");
        Check.Eq(pool.WaitingCount(), 0, "no waiter left behind on the gate");
        Check.True(dt < 30000, "exhaustion resolved quickly");

        pool.Release(held);
        IDbConnection again = await pool.AcquireAsync();
        Check.True(again != null, "healthy acquire after policy restored");
        if (again != null) { pool.Release(again); }
        pool.Close();
    }

    static async void RunAll() {
        await Program.Recovery();
        await Program.ExhaustionFastFails();
    }

    static void Main() {
        await Program.RunAll();
        Console.WriteLine("pass: " + Convert.ToString(Check.passed));
        Console.WriteLine("fail: " + Convert.ToString(Check.failed));
    }
}
