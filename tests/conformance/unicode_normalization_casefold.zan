using System;
using System.Text;

class Program {
    static void Main() {
        // 1. ASCII 快速路径
        string ascii = "Hello, World 123!";
        Console.WriteLine("ascii.IsNormalized: " + ascii.IsNormalized());
        Console.WriteLine("ascii.Normalize: " + ascii.Normalize());
        Console.WriteLine("ascii.CaseFold: " + ascii.CaseFold());

        // 2. 欧洲重音符：预组合（NFC）与分解组合符（NFD）
        string precomposed = "Müller";
        string decomposed = "Mu\u0308ller";
        Console.WriteLine("raw equal: " + (precomposed == decomposed));
        Console.WriteLine("decomposed to NFC: " + decomposed.Normalize(NormalizationForm.FormC));
        Console.WriteLine("decomposed NFC match: " + (decomposed.Normalize(NormalizationForm.FormC) == precomposed));
        Console.WriteLine("precomposed to NFD match: " + (precomposed.Normalize(NormalizationForm.FormD) == decomposed));
        Console.WriteLine("precomposed.IsNormalized(FormC): " + precomposed.IsNormalized(NormalizationForm.FormC));
        Console.WriteLine("decomposed.IsNormalized(FormC): " + decomposed.IsNormalized(NormalizationForm.FormC));
        Console.WriteLine("decomposed.IsNormalized(FormD): " + decomposed.IsNormalized(NormalizationForm.FormD));
        Console.WriteLine("EqualsNormalized: " + precomposed.EqualsNormalized(decomposed));

        // 3. 组合类（CCC）规范重排序：多重变音符号稳定性
        // 's' (U+0073) + dot below (U+0323, CCC=220) + dot above (U+0307, CCC=230)
        // 颠倒输入顺序: 's' + dot above + dot below
        string s_order1 = "s\u0323\u0307";
        string s_order2 = "s\u0307\u0323";
        string s_nfc1 = s_order1.Normalize(NormalizationForm.FormC);
        string s_nfc2 = s_order2.Normalize(NormalizationForm.FormC);
        Console.WriteLine("ccc sort nfc match: " + (s_nfc1 == s_nfc2));
        Console.WriteLine("ccc sort equals normalized: " + s_order1.EqualsNormalized(s_order2));

        // 4. 韩文音节（Hangul Syllables U+AC00..U+D7A3）算法分解与合成
        string hangul = "한글";
        string hangulD = hangul.Normalize(NormalizationForm.FormD);
        string hangulC = hangulD.Normalize(NormalizationForm.FormC);
        Console.WriteLine("hangul roundtrip: " + (hangulC == hangul));
        Console.WriteLine("hangul D diff: " + (hangulD != hangul));

        // 5. 国际化全大小写折叠（Full Case Folding）
        string de1 = "groß";
        string de2 = "GROSS";
        Console.WriteLine("de1 folded: " + de1.CaseFold());
        Console.WriteLine("de2 folded: " + de2.CaseFold());
        Console.WriteLine("de equals Ordinal: " + de1.Equals(de2, StringComparison.Ordinal));
        Console.WriteLine("de equals OrdinalIgnoreCase: " + de1.Equals(de2, StringComparison.OrdinalIgnoreCase));
        Console.WriteLine("de equals InvariantCultureIgnoreCase: " + de1.Equals(de2, StringComparison.InvariantCultureIgnoreCase));

        // 6. Unicode 1:N 扩张大写
        Console.WriteLine("de1 ToUpper: " + UnicodeCase.ToUpper(de1));

        // 7. 鉴权安全场景：组合符变形防仿冒比对
        string username = "Müller";
        string loginInputDecomposed = "Mu\u0308LLER"; // 分解组合码点 + 大写
        Console.WriteLine("auth bypass blocked by exact: " + (username == loginInputDecomposed));
        Console.WriteLine("auth match by normalized ignore case: " + username.EqualsNormalized(loginInputDecomposed, true));
    }
}
