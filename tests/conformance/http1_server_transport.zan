    static void Check(bool valid, string name) {
        Console.WriteLine((valid ? "ok " : "FAIL ") + name);
        if (!valid) { failures = failures + 1; }
    }

    static int Spools() { return Directory.GetFiles(directory, "upload_*.bin").Count; }
    static byte Pattern(int i) { return (byte)((i * 17) % 256); }

    static bool Before(HttpContext ctx) {
        beforeCalls = beforeCalls + 1;
        return Csrf.OriginGuard(ctx);
    }

    static async string Authenticate(string token) { return token; }
    static async bool Permit(string uid, string action) { return uid == "admin"; }

    static async void Upload(HttpContext ctx) {
        uploads = uploads + 1;
        int expected = ctx.Path() == "/take" ? 7 : 40001;
        string path = ctx.UploadPath();
        bool valid = ctx.ClientSock() == 0 && ctx.Conn() == null && ctx.Tls() != null
            && ctx.UploadSize() == expected && path.Length > 0 && File.Exists(path);
        if (valid) {
            byte[] actual = File.ReadAllBytes(path);
            valid = actual.Length == expected;
            for (int i = 0; i < expected && valid; i = i + 1) {
                if (actual[i] != Pattern(i)) { valid = false; }
            }
        }
        if (ctx.Path() == "/take") { retained = ctx.TakeUpload(); }
        ctx.Text(valid ? "spool-ok" : "spool-bad");
    }

    static async void Next(HttpContext ctx) { ctx.Text("pipeline-ok"); }

    static async void AcceptWeb(WebApp app) {
        while (webRunning) {
            nint sock = await webListener.AcceptAsync();
            if (sock >= 0) { Task.Spawn(app.HandleTlsConnection(sock)); }
        }
    }

    static async TlsStream Upgrade(TcpClient client) {
        TlsContext config = TlsContext.CreateClient();
        config.DisableVerify();
        config.alpnProtocols.Add("http/1.1");
        nint sock = client.Sock();
        return await TlsStream.ConnectAsync(config, sock, "wrong.example", 3000);
    }

    static async string Drain(TcpClient client, TlsStream tls) {
        StringBuilder reply = new StringBuilder();
        while (true) {
            string part = "";
            if (tls != null) { part = await tls.RecvAsync(4096, 3000); }
            else { part = await client.RecvAsync(4096, 3000); }
            if (part.Length == 0) { break; }
            reply.Append(part);
        }
        return reply.ToString();
    }

    static string UploadHead(string route, string extraHeaders, int length) {
        return "POST " + route + " HTTP/1.1\r\nHost: local.test\r\nContent-Length: "
            + Convert.ToString(length) + "\r\n" + extraHeaders + "\r\n";
    }

    static async string UploadExchange(string head, int count, bool pipeline, bool fragmented) {
        TcpClient client = await TcpClient.ConnectAsync("127.0.0.1", webPort, 3000);
        if (client == null) { return ""; }
        TlsStream tls = await Upgrade(client);
        if (tls == null) { client.Close(); return ""; }
        try {
            string next = pipeline ? "GET /next HTTP/1.1\r\nHost: local.test\r\nConnection: close\r\n\r\n" : "";
            int headLen = head.Length;
            int nextLen = next.Length;
            byte[] wire = new byte[headLen + count + nextLen];
            for (int i = 0; i < headLen; i = i + 1) { wire[i] = (byte)head[i]; }
            for (int i = 0; i < count; i = i + 1) { wire[headLen + i] = Pattern(i); }
            for (int i = 0; i < nextLen; i = i + 1) { wire[headLen + count + i] = (byte)next[i]; }
            if (fragmented) {
                int first = headLen + 3;
                int sent = await tls.SendBytesAsync(wire, 0, first);
                if (sent != first) { return ""; }
                int rest = wire.Length - first;
                int tailSent = await tls.SendBytesAsync(wire, first, rest);
                if (tailSent != rest) { return ""; }
            } else {
                int sent = await tls.SendBytesAsync(wire);
                if (sent != wire.Length) { return ""; }
            }
            return await Drain(client, tls);
        } finally {
            tls.Close();
            client.Close();
        }
    }

    static async bool WaitForSpools(int count) {
        for (int i = 0; i < 200; i = i + 1) {
            if (Spools() == count) { return true; }
            await Task.Delay(10);
        }
        return false;
    }

    static async void CheckWeb(string cert, string key) {
        WebApp app = new WebApp("127.0.0.1", webPort);
        app.UseHttps(cert, key).MaxBody(4).MaxUpload(65536).Timeout(4000).UploadDir(directory);
        app.AuthResolver(Authenticate);
        app.PermissionResolver(Permit);
        app.Before(Before);
        app.Post("/upload", Upload).Upload().Auth();
        app.Post("/take", Upload).Upload().Auth();
        app.Get("/next", Next);
        webListener = new TcpListener("127.0.0.1", webPort);
        webListener.Start();
        Task.Spawn(AcceptWeb(app));

        string admin = "Authorization: Bearer admin\r\n";
        string noAuth = await UploadExchange(UploadHead("/upload", "", 40001), 0, false, false);
        Check(noAuth.Contains("401 Unauthorized") && noAuth.Contains("Connection: close"), "TLS auth rejects before upload body");
        string noPermission = await UploadExchange(UploadHead("/upload", "Authorization: Bearer user\r\n", 40001), 0, false, false);
        Check(noPermission.Contains("403 Forbidden"), "TLS permission rejects before upload body");
        string csrf = await UploadExchange(UploadHead("/upload", admin + "Origin: https://cross-site.test\r\n", 40001), 0, false, false);
        Check(csrf.Contains("403 Forbidden"), "TLS before hook rejects before upload body");
        string tooBig = await UploadExchange(UploadHead("/upload", admin, 65537), 0, false, false);
        Check(tooBig.Contains("413 Payload Too Large") && Spools() == 0 && uploads == 0, "TLS upload limit opens no spool");

        int before = beforeCalls;
        string result = await UploadExchange(UploadHead("/upload", admin, 40001), 40001, true, true);
        Check(result.Contains("spool-ok") && result.Contains("pipeline-ok") && uploads == 1,
            "fragmented binary TLS upload preserves pipelined request");
        bool clean = await WaitForSpools(0);
        Check(beforeCalls == before + 2 && clean, "TLS upload hooks run once and unclaimed spool is deleted");
        string taken = await UploadExchange(UploadHead("/take", admin, 7), 7, true, false);
        Check(taken.Contains("spool-ok") && taken.Contains("pipeline-ok") && retained.Length > 0
            && File.Exists(retained) && Spools() == 1, "TLS TakeUpload retains complete spool and buffered tail");
        if (retained.Length > 0 && File.Exists(retained)) { File.Delete(retained); }

        TcpClient partial = await TcpClient.ConnectAsync("127.0.0.1", webPort, 3000);
        bool partialCreated = false;
        if (partial != null) {
            TlsStream stream = await Upgrade(partial);
            if (stream != null) {
                string prefix = UploadHead("/upload", admin, 40001) + "part";
                int sent = await stream.SendStringAsync(prefix);
                if (sent == prefix.Length) { partialCreated = await WaitForSpools(1); }
                stream.Close();
            }
            partial.Close();
        }
        bool removed = await WaitForSpools(0);
        Check(partialCreated && removed && uploads == 2, "TLS disconnect deletes observed partial spool without dispatch");
        webRunning = false;
        webListener.Stop();
        for (int i = 0; i < 20; i = i + 1) { await Task.Delay(10); }
        app.Dispose();
    }

    static async HttpResponse LowLevel(HttpRequest req) {
        if (req.path == "/throw") { throw new Exception("server-private-marker"); }
        if (req.path == "/head") { return HttpResponse.Text("head-must-not-send"); }
        if (req.path == "/no-content") { return HttpResponse.WithStatus(204, "No Content", "status-must-not-send"); }
        if (req.path == "/chunk") { return HttpResponse.Ok("").SetChunked(); }
        return HttpResponse.Text("sentinel-must-not-send");
    }

    static async string CheckSession(int port, bool secure) {
        TcpClient client = await TcpClient.ConnectAsync("127.0.0.1", port, 3000);
        if (client == null) { return ""; }
        TlsStream stream = null;
        if (secure) {
            stream = await Upgrade(client);
            if (stream == null) { client.Close(); return ""; }
        }
        try {
            string pipeline = "HEAD /head HTTP/1.1\r\nHost: local.test\r\n\r\n"
                + "GET /no-content HTTP/1.1\r\nHost: local.test\r\n\r\n"
                + "GET /chunk HTTP/1.1\r\nHost: local.test\r\n\r\n"
                + "GET /throw HTTP/1.1\r\nHost: local.test\r\n\r\n"
                + "GET /sentinel HTTP/1.1\r\nHost: local.test\r\nConnection: close\r\n\r\n";
            if (stream != null) { int sent = await stream.SendStringAsync(pipeline); }
            else { int sent = await client.SendAsync(pipeline); }
            return await Drain(client, stream);
        } finally {
            if (stream != null) { stream.Close(); }
            client.Close();
        }
    }

    static async int Run() {
        Socket.Initialize();
        directory = Path.Combine(Path.GetTempPath(), "zan_http1_server_" + Guid.New());
        Directory.CreateDirectoryRecursive(directory);
        string cert = Path.Combine(directory, "server.pem");
        string key = Path.Combine(directory, "server.key");
        File.WriteAllText(cert, SERVER_CERT);
        File.WriteAllText(key, SERVER_KEY);
        await CheckWeb(cert, key);

        HttpServer plain = new HttpServer("127.0.0.1", plainPort);
        plain.OnRequest(LowLevel);
        HttpsServer secure = HttpsServer.Create("127.0.0.1", securePort, cert, key);
        if (secure != null) {
            secure.OnRequest(LowLevel);
            Task.Spawn(plain.Start());
            Task.Spawn(secure.Start());
            await Task.Delay(100);
            string tcp = await CheckSession(plainPort, false);
            string tls = await CheckSession(securePort, true);
            Check(tcp.Length > 0 && tcp == tls, "TCP and TLS low-level HTTP/1 responses match");
            Check(tls.Contains("HTTP/1.1 200 OK") && tls.Contains("HTTP/1.1 204 No Content")
                && !tls.Contains("head-must-not-send") && !tls.Contains("status-must-not-send")
                && tls.Contains("Transfer-Encoding: chunked") && tls.Contains("\r\n\r\n0\r\n\r\nHTTP/1.1 500"),
                "HTTP/1 response writer omits forbidden bodies and terminates empty chunking");
            Check(tls.Contains("500 Internal Server Error") && tls.Contains("Connection: close")
                && tls.EndsWith("<p>internal error</p>") && !tls.Contains("server-private-marker")
                && !tls.Contains("sentinel-must-not-send"), "handler exception sends generic 500 and closes pipeline");
            plain.Stop();
            secure.Stop();
            for (int i = 0; i < 20; i = i + 1) { await Task.Delay(10); }
        } else {
            Check(false, "TLS fixture server created");
        }
        List<string> files = Directory.GetFiles(directory);
        for (int i = 0; i < files.Count; i = i + 1) { File.Delete(files[i]); }
        Directory.Delete(directory);
        Console.WriteLine("failures=" + Convert.ToString(failures));
        return failures;
    }

    static int Main() { return await Run(); }
}
