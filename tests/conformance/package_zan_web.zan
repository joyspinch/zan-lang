using System;
using System.Collections.Generic;
using System.Json;
using Zan.Web.Cache;
using Zan.Web.Core;
using Zan.Web.Protocol;
using Zan.Web.Modules.System.Model;
using Zan.Web.Modules.System.Dao;
using Zan.Web.Modules.System.Service;
using Zan.Web.Modules.System.Controller;
using Zan.Web.Modules.Monitor;
using Zan.Web.Modules.Monitor.Model;
using Zan.Web.Modules.Monitor.Dao;
using Zan.Web.Modules.Monitor.Controller;
using Zan.Web.Modules.Dev;
using Zan.Web.Modules.Dev.Model;
using Zan.Web.Modules.Dev.Dao;
using Zan.Web.Modules.Dev.Controller;
using System.Data.Sqlite;
using System.Data.Orm;
using Zan.Web.Seed;

class Program {
    static async int Main() {
        // 1. Cache
        Cache.Set("k1", "v1", 60);
        string v = Cache.Get("k1");
        if (v != "v1") {
            Console.WriteLine("FAIL: cache read");
            return 1;
        }

        // 2. I18n
        string zh = I18n.T("zh-CN", "common.success", "成功");
        if (zh != "成功") {
            Console.WriteLine("FAIL: i18n");
            return 2;
        }

        // 3. System Models & Daos
        SysUser u = new SysUser();
        u.id = 1;
        u.username = "admin";
        u.salt = "123456";
        u.password = SysUserDao.HashPassword("123456", u.salt);
        if (!SysUserDao.VerifyPassword("123456", u.salt, u.password)) {
            Console.WriteLine("FAIL: password verify");
            return 3;
        }

        SysDictType dt = new SysDictType();
        dt.code = "gender";
        dt.name = "性别";

        SysDictItem di = new SysDictItem();
        di.typeCode = "gender";
        di.label = "男";
        di.value = "1";

        SysConfig cfg = new SysConfig();
        cfg.key = "site_title";
        cfg.value = "Zan Web System";

        SysLog log = new SysLog();
        log.username = "admin";
        log.action = "login";

        // 4. Auth & Route Tree
        SysMenu m1 = new SysMenu();
        m1.id = 1;
        m1.node = "system";
        m1.title = "系统管理";
        m1.path = "/system";
        m1.rank = 1;
        m1.status = 1;

        SysMenu m2 = new SysMenu();
        m2.id = 2;
        m2.node = "user";
        m2.parentNode = "system";
        m2.title = "用户管理";
        m2.path = "/system/user";
        m2.rank = 1;
        m2.status = 1;

        List<SysMenu> menus = new List<SysMenu>();
        menus.Add(m1);
        menus.Add(m2);

        List<RouteNode> tree = AuthManager.BuildRouteNodes(menus);
        if (tree.Count != 1 || tree[0].children.Count != 1) {
            Console.WriteLine("FAIL: menu tree hierarchy");
            return 4;
        }

        // 5. Monitor
        ServerStats.Record("/api/user/list", "GET", 10, 200, "127.0.0.1");
        string sum = ServerStats.GetSummaryJson();
        if (sum.Length == 0 || !sum.Contains("\"totalRequests\":1")) {
            Console.WriteLine("FAIL: server stats record");
            return 5;
        }

        ServerStats.RecordQuery("SELECT * FROM sys_user WHERE id = '1'", 250000);
        string slowQJson = ServerStats.GetSlowQueriesJson();
        JsonValue slowQArr = JsonValue.Parse(slowQJson);
        if (slowQArr == null || slowQArr.Count() != 1) {
            Console.WriteLine("FAIL: slow query record json");
            return 51;
        }

        // 6. Dev CodeGenerator & TableConfig
        TableConfig tc = new TableConfig();
        tc.conf.pageSize = 50;
        tc.columns.Add(new TableColumn("id", "ID", 80));
        tc.columns.Add(new TableColumn("name", "Name", 150));
        string tcJson = tc.ToJson();
        JsonValue parsedTc = JsonValue.Parse(tcJson);
        JsonValue confNode = parsedTc?.Get("Conf");
        JsonValue pageNode = confNode?.Get("pageSize");
        JsonValue colsNode = parsedTc?.Get("Columns");
        if (parsedTc == null || pageNode == null || pageNode.AsInt(0) != 50 || colsNode == null || colsNode.Count() != 2) {
            Console.WriteLine("FAIL: table config json");
            return 6;
        }

        SysCurd curd = new SysCurd();
        curd.tableName = "order_item";
        curd.title = "订单条目";
        string modelCode = CodeGenerator.GenerateModel(curd, tc);
        if (!modelCode.Contains("class OrderItem") || !modelCode.Contains("[Table(Name = \"order_item\")]")) {
            Console.WriteLine("FAIL: code generator");
            return 7;
        }

        // 7. Scoped Controller & DAO instance verification
        SysUserController userCtrl = new SysUserController();
        SysConfigDao cfgDao = new SysConfigDao(null);
        SysUserDao userDao = new SysUserDao(null);
        if (userCtrl == null || cfgDao == null || userDao == null) {
            Console.WriteLine("FAIL: controller/dao scoped init");
            return 8;
        }

        // 8. Department Model, DAO & Controller
        SysDepartment dept = new SysDepartment();
        dept.id = 1;
        dept.name = "研发中心";
        dept.code = "DEV";
        SysDeptController deptCtrl = new SysDeptController();
        SysDepartmentDao deptDao = new SysDepartmentDao(null);
        if (dept.name != "研发中心" || deptCtrl == null || deptDao == null) {
            Console.WriteLine("FAIL: department components");
            return 9;
        }

        // 9. DataScope multi-tier data permissions
        DataScope allScope = DataScope.Everything(100);
        if (!allScope.Any() || !allScope.Covers(999, 888)) {
            Console.WriteLine("FAIL: DataScope Everything");
            return 10;
        }
        DataScope selfScope = new DataScope();
        selfScope.userId = 42;
        selfScope.mode = DataScope.Self;
        if (!selfScope.Mine() || !selfScope.Covers(42, 1) || selfScope.Covers(43, 1)) {
            Console.WriteLine("FAIL: DataScope Self");
            return 11;
        }

        // 10. Metric Time-Series
        string seriesJson = ServerStats.GetSeriesJson();
        if (seriesJson.Length == 0 || !seriesJson.StartsWith("[")) {
            Console.WriteLine("FAIL: series json format");
            return 12;
        }

        // 11. WebBoot & SysSeed symbols verification
        WebBoot.SetSlowThreshold(500);
        WebBoot.SetCors(true, "http://localhost:3000");

        SqliteConnection memDb = SqliteConnection.Open(":memory:");
        bool seedOk = await SysSeed.SeedAll(memDb);
        if (!seedOk) {
            Console.WriteLine("FAIL: SysSeed.SeedAll");
            return 13;
        }
        long userCount = await memDb.Select<SysUser>().CountAsync();
        if (userCount != 1) {
            Console.WriteLine("FAIL: SysSeed userCount != 1");
            return 14;
        }
        memDb.Close();

        // 12. Dynamic Menu Discovery & Synchronization from Route Attributes
        WebApp dummyApp = new WebApp("127.0.0.1", 9999);
        dummyApp.router.Add("GET", "/api/system/user/page", null).Menu().Title("用户管理");
        dummyApp.router.Add("GET", "/api/monitor/stat/summary", null).Menu().Title("运行监控");
        List<RouteNode> dynamicRoutes = SysMenuSync.BuildFromRouter(dummyApp, 1);
        if (dynamicRoutes == null || dynamicRoutes.Count != 2) {
            Console.WriteLine("FAIL: SysMenuSync.BuildFromRouter count != 2");
            return 15;
        }

        SqliteConnection memDb2 = SqliteConnection.Open(":memory:");
        await SysSeed.InitTables(memDb2);
        bool syncOk = await SysMenuSync.SyncFromRouter(memDb2, dummyApp, 1);
        if (!syncOk) {
            Console.WriteLine("FAIL: SysMenuSync.SyncFromRouter");
            return 16;
        }
        long menuCount = await memDb2.Select<SysMenu>().CountAsync();
        if (menuCount < 4) { // 2 groups (system, monitor) + 2 children (user, stat)
            Console.WriteLine("FAIL: SysMenuSync.SyncFromRouter count < 4");
            return 17;
        }
        memDb2.Close();

        // 13. Static Admin Directory Resolution
        string adminDir = WebBoot.ResolveAdminDir();
        if (adminDir.Length == 0 || !File.Exists(adminDir + "/index.html")) {
            Console.WriteLine("FAIL: WebBoot.ResolveAdminDir");
            return 18;
        }

        // 14. SysDocsController, SysJob, SysMediaFile & Auto Route Discovery
        SysDocsController docsCtrl = new SysDocsController();
        if (docsCtrl == null) {
            Console.WriteLine("FAIL: SysDocsController");
            return 19;
        }

        SqliteConnection memDb3 = SqliteConnection.Open(":memory:");
        await SysSeed.InitTables(memDb3);

        SysJobDao jobDao = new SysJobDao(memDb3);
        SysJob job = new SysJob();
        job.name = "清理过期会话";
        job.kind = "clean_session";
        job.intervalSec = 300;
        await jobDao.Insert(job);
        List<SysJob> jobs = await jobDao.All();
        if (jobs.Count != 1 || jobs[0].name != "清理过期会话") {
            Console.WriteLine("FAIL: SysJobDao insert/all");
            return 20;
        }

        SysMediaFileDao mediaDao = new SysMediaFileDao(memDb3);
        SysMediaFile mf = new SysMediaFile();
        mf.name = "avatar.png";
        mf.path = "/uploads/avatar.png";
        mf.ext = "png";
        mf.size = 10240;
        await mediaDao.Insert(mf);
        List<SysMediaFile> medias = await mediaDao.Page(1, 10);
        if (medias.Count != 1 || medias[0].ext != "png") {
            Console.WriteLine("FAIL: SysMediaFileDao insert/page");
            return 21;
        }
        memDb3.Close();

        // 15. Verify __AttrRoutes and ApiDocs spec generation
        WebApp autoApp = new WebApp("127.0.0.1", 8888);
        __AttrRoutes.Register(autoApp);
        ApiDocs.Mount(autoApp, "/api/docs");
        List<Route> allAppRoutes = autoApp.router.All();
        if (allAppRoutes.Count < 10) {
            Console.WriteLine("FAIL: __AttrRoutes registration count < 10");
            return 22;
        }
        string openApiJson = ApiDocs.SpecJson(autoApp);
        if (!openApiJson.Contains("\"openapi\":\"3.0.3\"")) {
            Console.WriteLine("FAIL: ApiDocs.SpecJson openapi 3.0.3");
            return 23;
        }

        Console.WriteLine("Zan.Web modular framework tests passed!");
        return 0;
    }
}
