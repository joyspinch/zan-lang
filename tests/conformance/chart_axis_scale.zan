using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

/// 轴缩放的可观察行为：堆叠分组（共享 stackName 的系列堆叠、
/// 未分组系列自成一组）经窗口化 MaxStackW / MaxStackAllW 的
/// 精确结果；MaxOfWindow 窗口最大值；WindowLabels 标签切片；
/// Time/Log 轴类型占位（阶段六实现真实映射）。
class Program {
    static void Main() {
        // 三条系列：A/B 共享 stackName "g1" 堆叠成一组，
        // C 无 stackName 自成一组。
        ChartSeries a = ChartSeries.Bar("A", new List<int>{2, 5});
        ChartSeries b = ChartSeries.Bar("B", new List<int>{3, 4});
        a.stackName = "g1";
        b.stackName = "g1";
        ChartSeries c = ChartSeries.Bar("C", new List<int>{9, 1});
        List<ChartSeries> series = new List<ChartSeries>{a, b, c};

        // 窗口 [0,1]：组 g1 类0=5 类1=9；组 "" 类0=9 类1=1 -> 9。
        Console.WriteLine("stackMax:" + Convert.ToString(Chart.MaxStackW(series, 2, 0)));
        // 窗口 [1,1]：组 g1=9、组 ""=1 -> 9。
        Console.WriteLine("winStack:" + Convert.ToString(Chart.MaxStackW(series, 1, 1)));
        // MaxOfWindow：窗口 [0,0] -> max(2,3,9)=9；[1,1] -> max(5,4,1)=5。
        Console.WriteLine("ofWin:" + Convert.ToString(Chart.MaxOfWindow(series, 0, 0))
            + ":" + Convert.ToString(Chart.MaxOfWindow(series, 1, 1)));
        // MaxStackAllW：全部可见系列叠加，类0=14 类1=10 -> 14。
        Console.WriteLine("allW:" + Convert.ToString(Chart.MaxStackAllW(series, 2, 0)));
        // 隐藏系列被 MaxStackAllW 跳过。
        c.hidden = true;
        Console.WriteLine("hiddenW:" + Convert.ToString(Chart.MaxStackAllW(series, 2, 0)));

        // WindowLabels：窗口 [1,2] 切片 {b, c}。
        List<string> labels = new List<string>{"a", "b", "c", "d"};
        List<string> wl = Chart.WindowLabels(labels, 1, 2);
        Console.WriteLine("labels:" + Convert.ToString(wl.Count)
            + ":" + wl[0] + ":" + wl[1]);

        // ---- 阶段六：Time / Log 轴 ----

        // Log10：floor log10，仅正值。
        Console.WriteLine("log10:" + Convert.ToString(Chart.Log10(1)) + ":"
            + Convert.ToString(Chart.Log10(9)) + ":" + Convert.ToString(Chart.Log10(10))
            + ":" + Convert.ToString(Chart.Log10(99)) + ":" + Convert.ToString(Chart.Log10(100))
            + ":" + Convert.ToString(Chart.Log10(1000)));
        // LogTicks：边界 + 中间的 10 的幂。
        List<int> lt = Chart.LogTicks(1, 1000);
        List<int> lt2 = Chart.LogTicks(3, 400);
        Console.WriteLine("logTicks:" + Convert.ToString(lt.Count) + ":"
            + Convert.ToString(lt[0]) + ":" + Convert.ToString(lt[1]) + ":"
            + Convert.ToString(lt[2]) + ":" + Convert.ToString(lt[3]) + ":"
            + Convert.ToString(lt2.Count) + ":" + Convert.ToString(lt2[0]) + ":"
            + Convert.ToString(lt2[1]) + ":" + Convert.ToString(lt2[2]) + ":"
            + Convert.ToString(lt2[3]));
        // TimeLabel：确定性短日期（t = 0 → 1970-01-01）。
        Console.WriteLine("timeLbl:" + Chart.TimeLabel(0) + ":" + Chart.TimeLabel(31)
            + ":" + Chart.TimeLabel(365));
        // TimeTicks：{1,2,5}×10^n 阶梯，末点补 t1。
        List<int> tt = Chart.TimeTicks(0, 100, 6);
        List<int> tt2 = Chart.TimeTicks(0, 20, 5);
        Console.WriteLine("timeTicks:" + Convert.ToString(tt.Count) + ":"
            + Convert.ToString(tt[0]) + ":" + Convert.ToString(tt[1]) + ":"
            + Convert.ToString(tt[2]) + ":" + Convert.ToString(tt[3]) + ":"
            + Convert.ToString(tt[4]) + ":" + Convert.ToString(tt2.Count) + ":"
            + Convert.ToString(tt2[0]) + ":" + Convert.ToString(tt2[2]) + ":"
            + Convert.ToString(tt2[4]));
        // ChartFrame：时间 X / 对数 Y / 独立右轴翻转。
        ChartFrame f = new ChartFrame();
        f.plotX = 10; f.plotW = 200;
        f.plotY = 0; f.plotH = 100;
        f.timeMin = 0; f.timeMax = 100;
        f.leftMin = 1; f.leftMax = 1000;
        f.rightMin = 0; f.rightMax = 10;
        f.rightReversed = true;
        Console.WriteLine("xOfTime:" + Convert.ToString(f.XOfTime(0)) + ":"
            + Convert.ToString(f.XOfTime(50)) + ":" + Convert.ToString(f.XOfTime(100)));
        Console.WriteLine("yOfLog:" + Convert.ToString(f.YOfLog(1, 0)) + ":"
            + Convert.ToString(f.YOfLog(10, 0)) + ":" + Convert.ToString(f.YOfLog(100, 0))
            + ":" + Convert.ToString(f.YOfLog(1000, 0)) + ":" + Convert.ToString(f.YOfLog(0, 0)));
        Console.WriteLine("yOfRev:" + Convert.ToString(f.YOf(5, 1)) + ":"
            + Convert.ToString(f.YOf(0, 1)) + ":" + Convert.ToString(f.YOf(10, 1)));
        // FormatFixed：固定小数位（四舍五入）。
        Console.WriteLine("fmt:" + Chart.FormatFixed(33.333, 2) + ":"
            + Chart.FormatFixed(12.5, 1) + ":" + Chart.FormatFixed(3.0, 0) + ":"
            + Chart.FormatFixed(0.045, 2));

        // Time/Log 轴类型标记（默认刻度仍为 5）。
        ChartAxis timeAxis = ChartAxis.Time();
        ChartAxis logAxis = ChartAxis.Value();
        logAxis.type = ChartAxisType.Log;
        Console.WriteLine("axes:" + Convert.ToString(timeAxis.type)
            + ":" + Convert.ToString(logAxis.type)
            + ":" + Convert.ToString(logAxis.ticks));

        // 旋风条：负值下界、零轴映射到 plot 中点。
        Console.WriteLine("niceSigned:" + Convert.ToString(Chart.NiceMin(0 - 42))
            + ":" + Convert.ToString(Chart.NiceMax(40)));
        Console.WriteLine("valueX:"
            + Convert.ToString(Chart.ValueX(0, 100, 0 - 50, 50, 0)) + ":"
            + Convert.ToString(Chart.ValueX(0, 100, 0 - 50, 50, 25)) + ":"
            + Convert.ToString(Chart.ValueX(0, 100, 0 - 50, 50, 0 - 25)));
        Console.WriteLine("valueY:"
            + Convert.ToString(Chart.ValueY(0, 100, 40, 100, 40)) + ":"
            + Convert.ToString(Chart.ValueY(0, 100, 40, 100, 70)) + ":"
            + Convert.ToString(Chart.ValueY(0, 100, 40, 100, 100)));
        List<ChartSeries> tornado = new List<ChartSeries>{
            ChartSeries.HBar("m", new List<int>{ 0 - 15, 0 - 42 }),
            ChartSeries.HBar("f", new List<int>{ 12, 40 })
        };
        Console.WriteLine("minOf:" + Convert.ToString(Chart.MinOf(tornado)));
    }
}
