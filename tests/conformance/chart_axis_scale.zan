using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

/// 轴缩放的可观察行为：堆叠分组（共享 stackName 的系列堆叠、
/// 未分组系列自成一组）经窗口化 MaxStackW / MaxStackAllW 的
/// 精确结果；MaxOfWindow 窗口最大值；WindowLabels 标签切片；
/// Time/Log 轴类型占位（阶段六实现真实映射）。
class Program {
    static void Main() {
        // 三条系列：A/B 共享 stackName "g1" 堆叠成一组，
        // C 无 stackName 自成一组。
        ChartSeries a = ChartSeries.Bar("A", new List<int>{2, 5});
        ChartSeries b = ChartSeries.Bar("B", new List<int>{3, 4});
        a.stackName = "g1";
        b.stackName = "g1";
        ChartSeries c = ChartSeries.Bar("C", new List<int>{9, 1});
        List<ChartSeries> series = new List<ChartSeries>{a, b, c};

        // 窗口 [0,1]：组 g1 类0=5 类1=9；组 "" 类0=9 类1=1 -> 9。
        Console.WriteLine("stackMax:" + Convert.ToString(Chart.MaxStackW(series, 2, 0)));
        // 窗口 [1,1]：组 g1=9、组 ""=1 -> 9。
        Console.WriteLine("winStack:" + Convert.ToString(Chart.MaxStackW(series, 1, 1)));
        // MaxOfWindow：窗口 [0,0] -> max(2,3,9)=9；[1,1] -> max(5,4,1)=5。
        Console.WriteLine("ofWin:" + Convert.ToString(Chart.MaxOfWindow(series, 0, 0))
            + ":" + Convert.ToString(Chart.MaxOfWindow(series, 1, 1)));
        // MaxStackAllW：全部可见系列叠加，类0=14 类1=10 -> 14。
        Console.WriteLine("allW:" + Convert.ToString(Chart.MaxStackAllW(series, 2, 0)));
        // 隐藏系列被 MaxStackAllW 跳过。
        c.hidden = true;
        Console.WriteLine("hiddenW:" + Convert.ToString(Chart.MaxStackAllW(series, 2, 0)));

        // WindowLabels：窗口 [1,2] 切片 {b, c}。
        List<string> labels = new List<string>{"a", "b", "c", "d"};
        List<string> wl = Chart.WindowLabels(labels, 1, 2);
        Console.WriteLine("labels:" + Convert.ToString(wl.Count)
            + ":" + wl[0] + ":" + wl[1]);

        // Time/Log 轴占位：类型标记 + 默认刻度（阶段六实现映射）。
        ChartAxis timeAxis = ChartAxis.Time();
        ChartAxis logAxis = ChartAxis.Value();
        logAxis.type = ChartAxisType.Log;
        Console.WriteLine("axes:" + Convert.ToString(timeAxis.type)
            + ":" + Convert.ToString(logAxis.type)
            + ":" + Convert.ToString(logAxis.ticks));
    }
}
