using System;
namespace Conf;

// 回归(D16):语言没有 >>> 无符号右移。补 C# 语义:无论如何操作数的
// 有号性,一律逻辑右移(高位补零)。A510 收窄口径后:位移按**左操作数的
// 声明宽度**做真位移——int 操作数 trunc i32 → lshr i32 → zext(32 位
// 逻辑结果),long 操作数 lshr i64。uint/ulong 槽零扩展,与 C# 完全一致。
// 同批:>>>= 复合赋值(同宽度口径)。
class Program {
    static void Main() {
        int neg = -16;
        Console.WriteLine(neg >> 2);       // -4(算术)
        Console.WriteLine(neg >>> 2);      // 1073741820(32 位逻辑)
        long ln = -9223372036854775807L;
        Console.WriteLine(ln >>> 60);      // 8(64 位)
        int m1 = -1;
        Console.WriteLine(m1 >>> 28);      // 15(32 位逻辑)
        uint u = 0x80000000u;
        Console.WriteLine(u >>> 4);        // 134217728
        Console.WriteLine(u >>> 31);       // 1
        byte b = 0xFF;
        Console.WriteLine(b >>> 4);        // 15
        // 32 位图案的逻辑结果(int 槽先掩 32 位)
        Console.WriteLine((((long)m1) & 0xFFFFFFFFL) >>> 28);   // 15
        // 复合赋值
        int x = -16;
        x >>>= 2;
        Console.WriteLine(x);              // 1073741820(32 位逻辑)
        Console.WriteLine("end");
    }
}
