using System;
using System.IO;

public class Program {
    static int Main() {
        string ps1 = "scripts/gate_templates.ps1";
        string py = "scripts/test_all_templates.py";

        if (!File.Exists(ps1)) {
            Console.WriteLine($"FAIL: {ps1} does not exist");
            return 1;
        }

        if (!File.Exists(py)) {
            Console.WriteLine($"FAIL: {py} does not exist");
            return 1;
        }

        string pyContent = File.ReadAllText(py);
        if (!pyContent.Contains("gate_templates.ps1")) {
            Console.WriteLine("FAIL: test_all_templates.py does not reference gate_templates.ps1");
            return 1;
        }

        Console.WriteLine("gate-templates-dispatch-ok: 1");
        return 0;
    }
}
