// 核心契约与语义定义。
// 核心契约与语义定义。
using System;

class Program {
    static int Relay(int n) {
        try {
            if (n == 0)
                throw new Exception("bottom");
            return Relay(n - 1) + 1;
        } catch (Exception e) {
            if (n == 20)
                throw new Exception("relayed at 20");
            throw;
        }
    }

    // 核心契约与语义定义。
    static int Nested() {
        int hits = 0;
        try { try { try { try { try {
        try { try { try { try { try {
        try { try { try { try { try {
        try { try { try { try { try {
            throw new Exception("deepest");
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; }
        return hits;
    }

    static void Main() {
        try {
            int r = Relay(40);
            Console.WriteLine("no throw " + Convert.ToString(r));
        } catch (Exception e) {
            Console.WriteLine("caught " + e.Message);
        }
        Console.WriteLine("nested " + Convert.ToString(Nested()));
        // 核心契约与语义定义。
        try {
            throw new Exception("shallow");
        } catch (Exception e2) {
            Console.WriteLine("caught " + e2.Message);
        }
        // 核心契约与语义定义。
        try {
            int r2 = Relay(40);
            Console.WriteLine("no throw " + Convert.ToString(r2));
        } catch (Exception e3) {
            Console.WriteLine("caught " + e3.Message);
        }
        Console.WriteLine("done");
    }
}
