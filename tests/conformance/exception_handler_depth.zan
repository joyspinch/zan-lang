// The handler stack's depth is *runtime* try nesting, so a recursive function
// with a try/catch has no static bound: 40 levels of catch-and-rethrow, plus 20
// statically nested trys in one frame, both exceed the old fixed 16 slots (which
// were armed without a bound check, writing a jmp_buf past the end of the
// global). Each level's handler must still be the one that catches.
using System;

class Program {
    static int Relay(int n) {
        try {
            if (n == 0)
                throw new Exception("bottom");
            return Relay(n - 1) + 1;
        } catch (Exception e) {
            if (n == 20)
                throw new Exception("relayed at 20");
            throw;
        }
    }

    // the innermost throw has to walk out through every armed handler
    static int Nested() {
        int hits = 0;
        try { try { try { try { try {
        try { try { try { try { try {
        try { try { try { try { try {
        try { try { try { try { try {
            throw new Exception("deepest");
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; throw; }
        } catch (Exception e) { hits = hits + 1; }
        return hits;
    }

    static void Main() {
        try {
            int r = Relay(40);
            Console.WriteLine("no throw " + Convert.ToString(r));
        } catch (Exception e) {
            Console.WriteLine("caught " + e.Message);
        }
        Console.WriteLine("nested " + Convert.ToString(Nested()));
        // the stack is back where it started, so a shallow throw still works
        try {
            throw new Exception("shallow");
        } catch (Exception e2) {
            Console.WriteLine("caught " + e2.Message);
        }
        // and a second deep run reuses the grown stack
        try {
            int r2 = Relay(40);
            Console.WriteLine("no throw " + Convert.ToString(r2));
        } catch (Exception e3) {
            Console.WriteLine("caught " + e3.Message);
        }
        Console.WriteLine("done");
    }
}
