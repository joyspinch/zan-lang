using System;

// 核心契约与语义定义。
class Program {
    static string Wrap(char c) { return "<" + c + ">"; }

    static void Main() {
        string s = "mm:ss";
        Console.WriteLine(s[0]);
        Console.WriteLine("x=" + s[0]);
        Console.WriteLine(s[2] + "=x");
        Console.WriteLine(Wrap(s[3]));
        Console.WriteLine($"i({s[0]})");
        Console.WriteLine(String.Format("f={0}!", s[0]));
        string r = "";
        for (int i = 0; i < s.Length; i = i + 1) { r = r + s[i]; }
        Console.WriteLine(r == s ? "roundtrip" : "BROKEN");
        Console.WriteLine((int)s[0]);
    }
}
