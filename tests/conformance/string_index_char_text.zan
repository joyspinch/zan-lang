using System;

// `string[i]` yields the byte at offset i as a `char` (the checker types it
// char; irgen's inference must agree). Its static type has to survive into
// the text conversions: concatenating, printing or interpolating one formats
// the CHARACTER, while an explicit (int) cast still yields the byte's code.
// irgen used to lose the type on the index node and print "109" for 'm'.
class Program {
    static string Wrap(char c) { return "<" + c + ">"; }

    static void Main() {
        string s = "mm:ss";
        Console.WriteLine(s[0]);
        Console.WriteLine("x=" + s[0]);
        Console.WriteLine(s[2] + "=x");
        Console.WriteLine(Wrap(s[3]));
        Console.WriteLine($"i({s[0]})");
        Console.WriteLine(String.Format("f={0}!", s[0]));
        string r = "";
        for (int i = 0; i < s.Length; i = i + 1) { r = r + s[i]; }
        Console.WriteLine(r == s ? "roundtrip" : "BROKEN");
        Console.WriteLine((int)s[0]);
    }
}
