using System;
using System.Threading;

class Program {
    static void Main() {
        nint sem = Semaphore.Create(1, 2);
        Console.WriteLine(sem != 0);
        Console.WriteLine(Semaphore.WaitFor(sem, 0));
        Console.WriteLine(Semaphore.WaitFor(sem, 0));
        Console.WriteLine(Semaphore.WaitFor(sem, 5));
        Semaphore.Release(sem);
        Console.WriteLine(Semaphore.WaitFor(sem, 50));
        Semaphore.Release(sem);
        Semaphore.Wait(sem);
        Console.WriteLine(Semaphore.WaitFor(sem, 0));
        Semaphore.Destroy(sem);

        SemaphoreSlim gate = new SemaphoreSlim(1);
        Console.WriteLine(gate.WaitFor(0));
        Console.WriteLine(gate.WaitFor(0));
        gate.Release();
        Console.WriteLine(gate.WaitFor(0));
        gate.Release();
        gate.Dispose();
        gate.Dispose();

        BlockingQueue<string> queue = new BlockingQueue<string>("", 1);
        Console.WriteLine(queue.Enqueue("portable"));
        Console.WriteLine(queue.Dequeue());
        queue.Complete();
        Console.WriteLine(queue.Dequeue() == "");
        queue.Dispose();
        queue.Dispose();
    }
}
