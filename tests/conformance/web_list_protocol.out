GET /api/list/index
  page int required=0 default=1 desc=页码，从 1 开始
  limit int required=0 default=20 desc=每页条数
  order string required=0 default=id desc=排序字段
  dir string required=0 default=desc desc=排序方向：desc 或 asc
  kw string required=0 default=- desc=搜索关键词
GET /api/list/search
  kw string required=1 default=- desc=关键词
  page int required=0 default=1 desc=页码，从 1 开始
  limit int required=0 default=50 desc=每页条数
  order string required=0 default=title desc=排序字段
  dir string required=0 default=desc desc=排序方向：desc 或 asc
