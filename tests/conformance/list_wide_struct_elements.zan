using System;
using System.Collections.Generic;

struct P3 { public int x; public int y; public int z; }
struct Big { public long a; public long b; public long c; public long d; }

class Program {
    static void Main() {
        // two-word elements: each must keep its own slots
        List<P3> pts = new List<P3>();
        int i = 0;
        while (i < 10) {
            P3 p; p.x = i; p.y = i * 10; p.z = i * 100;
            pts.Add(p);
            i = i + 1;
        }
        Console.WriteLine(Convert.ToString(pts.Count));
        Console.WriteLine(Convert.ToString(pts[0].x + pts[0].y + pts[0].z));
        Console.WriteLine(Convert.ToString(pts[9].x + pts[9].y + pts[9].z));

        int sum = 0;
        foreach (P3 e in pts) { sum = sum + e.z; }
        Console.WriteLine(Convert.ToString(sum));

        // indexed assignment replaces the whole element
        P3 q; q.x = 1; q.y = 2; q.z = 3;
        pts[4] = q;
        Console.WriteLine(Convert.ToString(pts[4].x + pts[4].y + pts[4].z));
        Console.WriteLine(Convert.ToString(pts[5].z));

        // removal shifts whole elements
        pts.RemoveAt(0);
        Console.WriteLine(Convert.ToString(pts.Count));
        Console.WriteLine(Convert.ToString(pts[0].z));
        Console.WriteLine(Convert.ToString(pts[8].z));

        pts.Clear();
        Console.WriteLine(Convert.ToString(pts.Count));

        // four-word elements
        List<Big> bs = new List<Big>();
        int j = 0;
        while (j < 5) {
            Big b; b.a = j; b.b = j + 1; b.c = j + 2; b.d = j + 3;
            bs.Add(b);
            j = j + 1;
        }
        long total = 0;
        foreach (Big b2 in bs) { total = total + b2.a + b2.b + b2.c + b2.d; }
        Console.WriteLine(Convert.ToString(total));
        Console.WriteLine(Convert.ToString(bs[4].d));
    }
}
