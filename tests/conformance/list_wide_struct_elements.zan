using System;
using System.Collections.Generic;

struct P3 { public int x; public int y; public int z; }
struct Big { public long a; public long b; public long c; public long d; }
struct Key3 {
    public int id;
    public int ignored;
    public int tag;
    public static bool operator ==(Key3 a, Key3 b) {
        return a.id == b.id && a.tag == b.tag;
    }
}

class Program {
    static void Main() {
        // two-word elements: each must keep its own slots
        List<P3> pts = new List<P3>();
        int i = 0;
        while (i < 10) {
            P3 p; p.x = i; p.y = i * 10; p.z = i * 100;
            pts.Add(p);
            i = i + 1;
        }
        Console.WriteLine(Convert.ToString(pts.Count));
        Console.WriteLine(Convert.ToString(pts[0].x + pts[0].y + pts[0].z));
        Console.WriteLine(Convert.ToString(pts[9].x + pts[9].y + pts[9].z));

        int sum = 0;
        foreach (P3 e in pts) { sum = sum + e.z; }
        Console.WriteLine(Convert.ToString(sum));

        // indexed assignment replaces the whole element
        P3 q; q.x = 1; q.y = 2; q.z = 3;
        pts[4] = q;
        Console.WriteLine(Convert.ToString(pts[4].x + pts[4].y + pts[4].z));
        Console.WriteLine(Convert.ToString(pts[5].z));

        // removal shifts whole elements
        pts.RemoveAt(0);
        Console.WriteLine(Convert.ToString(pts.Count));
        Console.WriteLine(Convert.ToString(pts[0].z));
        Console.WriteLine(Convert.ToString(pts[8].z));

        pts.Clear();
        Console.WriteLine(Convert.ToString(pts.Count));

        // four-word elements
        List<Big> bs = new List<Big>();
        int j = 0;
        while (j < 5) {
            Big b; b.a = j; b.b = j + 1; b.c = j + 2; b.d = j + 3;
            bs.Add(b);
            j = j + 1;
        }
        long total = 0;
        foreach (Big b2 in bs) { total = total + b2.a + b2.b + b2.c + b2.d; }
        Console.WriteLine(Convert.ToString(total));
        Console.WriteLine(Convert.ToString(bs[4].d));

        List<P3> more = new List<P3>();
        P3 m0; m0.x = 10; m0.y = 20; m0.z = 30;
        P3 m1; m1.x = 11; m1.y = 21; m1.z = 31;
        more.Add(m0);
        more.Add(m1);
        more.AddRange(more);
        Console.WriteLine(Convert.ToString(more.Count));
        Console.WriteLine(Convert.ToString(more[2].x + more[3].z));
        P3 mid; mid.x = 7; mid.y = 8; mid.z = 9;
        more.Insert(1, mid);
        Console.WriteLine(Convert.ToString(more.Count));
        Console.WriteLine(Convert.ToString(more[1].x + more[2].x));
        more.Reverse();
        Console.WriteLine(Convert.ToString(more[0].x + more[4].z));
        Console.WriteLine(Convert.ToString(more.IndexOf(mid)));
        Console.WriteLine(more.Contains(m1));

        Big bx; bx.a = 40; bx.b = 41; bx.c = 42; bx.d = 43;
        bs.Insert(2, bx);
        bs.Reverse();
        Console.WriteLine(Convert.ToString(bs[3].a + bs[3].d));
        Console.WriteLine(Convert.ToString(bs.IndexOf(bx)));
        Console.WriteLine(bs.Contains(bx));

        List<Key3> keys = new List<Key3>();
        Key3 k0; k0.id = 5; k0.ignored = 100; k0.tag = 9;
        Key3 probe; probe.id = 5; probe.ignored = 999; probe.tag = 9;
        keys.Add(k0);
        Console.WriteLine(Convert.ToString(keys.IndexOf(probe)));
        Console.WriteLine(keys.Contains(probe));
    }
}
