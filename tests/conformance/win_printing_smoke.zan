// Windows printing smoke test. This test only queries spooler metadata; it must
// never create a print job or call RawPrinter.Send.
using System;
using System.Drawing.Printing;

namespace Conf;

class Prog {
    static int bad = 0;

    static void Check(bool cond) {
        if (!cond) { bad = bad + 1; }
    }

    static void Main() {
        List<string> printers = PrinterSettings.InstalledPrinters();
        string defaultPrinter = PrinterSettings.DefaultPrinterName();
        Check(printers != null);
        Check(defaultPrinter != null);

        int i = 0;
        while (i < printers.Count) {
            Check(printers[i] != null && printers[i].Length > 0);
            i = i + 1;
        }

        // RawPrinter.Send is intentionally not called: even an empty RAW job
        // would contact the spooler and violate this smoke test's no-print rule.

        Console.WriteLine("win-printing-ok: "
            + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
