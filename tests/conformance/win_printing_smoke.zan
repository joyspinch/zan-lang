// 核心契约与语义定义。
// 核心契约与语义定义。
using System;
using System.Drawing.Printing;

namespace Conf;

class Prog {
    static int bad = 0;

    static void Check(bool cond) {
        if (!cond) { bad = bad + 1; }
    }

    static void Main() {
        List<string> printers = PrinterSettings.InstalledPrinters();
        string defaultPrinter = PrinterSettings.DefaultPrinterName();
        Check(printers != null);
        Check(defaultPrinter != null);

        for (int i = 0; i < printers.Count; i = i + 1) {
            Check(printers[i] != null && printers[i].Length > 0);
        }

        // 核心契约与语义定义。
        // 核心契约与语义定义。

        Console.WriteLine("win-printing-ok: "
            + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
