using System;
using System.Collections.Generic;

// B-ID99 钉子：泛型基类方法体特化（clone_ast_subst）必须对 lambda/元组/插值/
// 集合初始化器/switch 表达式/lock/checked/元组解构/查询各自深克隆列表，
// 三个派生特化互不串写，类型实参正确代入。
class Box<T> {
    public string Describe(T v) {
        Func<string, string> wrap = (string s) => $"[{s}:{v.ToString()}]";
        var pair = (v, "tag");
        var parts = new List<string> { wrap("a"), pair.Item2, $"n={pair.Item1.ToString()}" };
        string mode = "x" switch { "x" => "ex", _ => "other" };
        lock (parts) {
            checked { parts.Add(mode); }
        }
        var (a, b) = (1, 2);
        parts.Add($"{a}{b}");
        var q = from s in parts where s.Length > 1 select s;
        string acc = "";
        foreach (var s in q) acc += s + "|";
        return acc;
    }
}
class IntBox : Box<int> {}
class StrBox : Box<string> {}
class LongBox : Box<long> {}

class Program {
    static void Main() {
        Console.WriteLine(new IntBox().Describe(7));
        Console.WriteLine(new StrBox().Describe("z"));
        Console.WriteLine(new LongBox().Describe(9L));
    }
}
