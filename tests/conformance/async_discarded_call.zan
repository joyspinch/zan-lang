// Conformance: a discarded async call (`Foo();` with no await and no
// Task.Spawn) must run as a detached coroutine and free its frame. It used to
// allocate a frame the ramp handed back, drop the handle and stop there: the
// body never ran and the frame leaked once per call.
using System;
using System.Threading;

class Program {
    static int steps = 0;

    static async void Bump(int n) {
        Program.steps = Program.steps + n;
        await Task.Delay(1);
        Program.steps = Program.steps + n;
    }

    static async int Run() {
        Program.Bump(1);            // runs before the first suspension
        Program.Bump(10);
        await Task.Delay(30);       // let both halves of both bodies finish
        Console.WriteLine("steps=" + Convert.ToString(Program.steps));
        return 0;
    }

    static int Main() {
        return await Program.Run();
    }
}
