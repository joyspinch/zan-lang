// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
using System;
using System.Threading;

class Program {
    static int steps = 0;

    static async void Bump(int n) {
        Program.steps = Program.steps + n;
        await Task.Delay(1);
        Program.steps = Program.steps + n;
    }

    static async int Run() {
        Program.Bump(1);            // runs before the first suspension
        Program.Bump(10);
        await Task.Delay(30);       // let both halves of both bodies finish
        Console.WriteLine("steps=" + Convert.ToString(Program.steps));
        return 0;
    }

    static int Main() {
        return await Program.Run();
    }
}
