// A535 判定器：连接池归还清理通道（P2-29 的异步驱动半边）。
// 异步单类驱动（协程化 MySQL/SqlServer/Firebird）的同步 Rollback() 抛
// Sync()，同步 Release 无法回滚残留事务——机制改为池级协程清理通道：
// 归还时事务未收尾的连接不直接入池，挂 Task.Spawn 清理协程，ROLLBACK
// 落地后才回池。本用例用假异步连接按与 MySqlPool.Release 同构的形状
// 钉住机制不变量：借出 BEGIN 不提交直接归还，二借必须等回滚落地，
// 拿到即已回滚、事务标志已清；干净归还直通、不触发回滚。
using System;
using System.Data;
using System.Threading;

class FakeAsyncConnection : IDbConnection {
    public bool inTxn;
    public int rollbackCount;
    bool connected;

    DbResult Empty() {
        DbResult r = new DbResult();
        r.SetColumnCount(0);
        return r;
    }

    public DbResult Query(string sql) { return this.Empty(); }
    public DbResult Query(string sql, DbParams prms) { return this.Empty(); }
    public int Execute(string sql) { return 0; }
    public int Execute(string sql, DbParams prms) { return 0; }
    public string ExecuteScalar(string sql) { return ""; }
    public string ExecuteScalar(string sql, DbParams prms) { return ""; }
    public async DbResult QueryAsync(string sql) { return this.Empty(); }
    public async DbResult QueryAsync(string sql, DbParams prms) { return this.Empty(); }
    public async int ExecuteAsync(string sql) { return 0; }
    public async int ExecuteAsync(string sql, DbParams prms) { return 0; }
    public async string ExecuteScalarAsync(string sql) { return ""; }
    public async string ExecuteScalarAsync(string sql, DbParams prms) { return ""; }

    public void BeginTransaction() { this.inTxn = true; }
    public void Commit() { this.inTxn = false; }
    public void Rollback() { this.inTxn = false; }

    public async bool BeginTransactionAsync() {
        await Task.Delay(1);
        this.inTxn = true;
        return true;
    }

    public async bool CommitAsync() {
        await Task.Delay(1);
        this.inTxn = false;
        return true;
    }

    public async bool RollbackAsync() {
        // 模拟真实回滚的 IO 延迟：二借若不等清理落地就会看到旧状态
        await Task.Delay(2);
        this.rollbackCount = this.rollbackCount + 1;
        this.inTxn = false;
        return true;
    }

    public bool IsConnected() { return this.connected; }
    public int closeCount;
    public void Close() { this.connected = false; this.closeCount = this.closeCount + 1; }
    public void Dispose() { this.Close(); }
    public int GetProvider() { return 0; }
}

// 与 MySqlPool.Release/Cleanup 同构的机制载体（typed pool 样板）。
class FakeAsyncPool {
    PoolCore<FakeAsyncConnection> core;
    public Gate opening;
    public Gate finishOpen;
    public bool throwOnOpen;
    public int openAttempts;
    public int failureReports;
    public string failureMessage;
    public FakeAsyncConnection lastOpened;

    public FakeAsyncPool(int maxSize) {
        this.core = new PoolCore<FakeAsyncConnection>(maxSize);
    }

    public async FakeAsyncConnection AcquireAsync() {
        PoolOpenAsync<FakeAsyncConnection> open = this.OpenOne;
        Predicate<FakeAsyncConnection> connected = FakeAsyncPool.IsUsable;
        Action<FakeAsyncConnection> close = FakeAsyncPool.CloseConnection;
        PoolOpenFailure<FakeAsyncConnection> failed = this.ReportFailure;
        return await this.core.AcquireAsync(open, connected, close, failed);
    }

    public FakeAsyncConnection TryAcquire() {
        Predicate<FakeAsyncConnection> connected = FakeAsyncPool.IsUsable;
        Action<FakeAsyncConnection> close = FakeAsyncPool.CloseConnection;
        return this.core.TryAcquireIdle(connected, close);
    }

    private async FakeAsyncConnection OpenOne() {
        this.openAttempts = this.openAttempts + 1;
        if (this.opening != null) {
            this.opening.Signal();
            await this.finishOpen.Wait();
        } else {
            await Task.Delay(1);
        }
        if (this.throwOnOpen) { throw new InvalidOperationException("fake open error"); }
        FakeAsyncConnection c = new FakeAsyncConnection();
        c.connected = true;
        this.lastOpened = c;
        return c;
    }

    static bool IsUsable(FakeAsyncConnection c) { return c.IsConnected(); }
    static void CloseConnection(FakeAsyncConnection c) { c.Close(); }

    private void ReportFailure(FakeAsyncConnection c, Exception error) {
        this.failureReports = this.failureReports + 1;
        this.failureMessage = error != null ? error.Message : "no error";
    }

    public void Release(FakeAsyncConnection c) {
        if (c == null) { return; }
        if (this.core.IsClosed() || !c.IsConnected()) {
            c.Close();
            this.core.Drop(c);
            return;
        }
        if (c.inTxn) {
            Task.Spawn(this.Cleanup(c));
            return;
        }
        if (!this.core.Pool(c)) { c.Close(); }
    }

    private async bool Cleanup(FakeAsyncConnection c) {
        try {
            await c.RollbackAsync();
        } catch (Exception) {
        }
        c.inTxn = false;
        if (this.core.IsClosed() || !c.IsConnected()) {
            c.Close();
            this.core.Drop(c);
            return true;
        }
        if (!this.core.Pool(c)) { c.Close(); }
        return true;
    }

    public int IdleCount() { return this.core.IdleCount(); }
    public int LiveCount() { return this.core.LiveCount(); }

    public void Close() {
        this.core.MarkClosed();
        FakeAsyncConnection c = this.core.TakeClosing();
        while (c != null) {
            c.Close();
            this.core.Drop(c);
            c = this.core.TakeClosing();
        }
        this.core.WakeAll();
    }
}

public class PoolAsyncResetCase {
    static int bad = 0;

    static void Chk(string label, bool ok) {
        if (!ok) {
            bad = bad + 1;
            Console.WriteLine("FAIL " + label);
        }
    }

    static async int AcquireThenSignal(FakeAsyncPool pool, Gate done) {
        FakeAsyncConnection c = await pool.AcquireAsync();
        Chk("close wins in-flight open", c == null);
        done.Signal();
        return 0;
    }

    static async int CloseDuringOpen() {
        FakeAsyncPool pool = new FakeAsyncPool(1);
        pool.opening = new Gate();
        pool.finishOpen = new Gate();
        Gate done = new Gate();
        Task.Spawn(PoolAsyncResetCase.AcquireThenSignal(pool, done));
        Chk("open reached suspension", await pool.opening.Wait(1000));
        Chk("in-flight open owns the only slot", pool.LiveCount() == 1);
        Chk("try acquire ignores in-flight open", pool.TryAcquire() == null && pool.openAttempts == 1);
        pool.Close();
        pool.finishOpen.Signal();
        Chk("closed acquire completed", await done.Wait(1000));
        FakeAsyncConnection c = pool.lastOpened;
        Chk("late connection closed once", c != null && c.closeCount == 1);
        Chk("no slots after late open", pool.LiveCount() == 0 && pool.IdleCount() == 0);
        return 0;
    }

    static async int FailedOpenAndIdle() {
        FakeAsyncPool pool = new FakeAsyncPool(1);
        Chk("try acquire never opens an empty pool", pool.TryAcquire() == null && pool.openAttempts == 0);
        pool.throwOnOpen = true;
        FakeAsyncConnection c = await pool.AcquireAsync();
        Chk("throwing open releases its slot", c == null && pool.LiveCount() == 0);
        Chk("first failure keeps the exception message", pool.failureReports == 1 && pool.failureMessage == "fake open error");
        for (int i = 0; i < 64; i = i + 1) { c = await pool.AcquireAsync(); }
        Chk("one retry per 64 calls and no duplicate diagnostic", c == null && pool.openAttempts == 2 && pool.failureReports == 1);
        pool.throwOnOpen = false;
        for (int i = 0; i < 64; i = i + 1) { c = await pool.AcquireAsync(); }
        Chk("retry succeeds after recovery", c != null && pool.openAttempts == 3);
        if (c != null) {
            pool.Release(c);
            c.connected = false;
            Chk("try acquire evicts dead idle without opening", pool.TryAcquire() == null
                && c.closeCount == 1 && pool.LiveCount() == 0 && pool.openAttempts == 3);
        }
        pool.throwOnOpen = true;
        c = await pool.AcquireAsync();
        Chk("successful retry resets the failure episode", c == null && pool.openAttempts == 4
            && pool.failureReports == 2 && pool.LiveCount() == 0);
        pool.Close();
        return 0;
    }

    static async int Run() {
        FakeAsyncPool pool = new FakeAsyncPool(1);

        // 一借：开事务（未收尾写），不提交直接归还——连接挂清理协程
        FakeAsyncConnection c1 = await pool.AcquireAsync();
        Chk("acquire one", c1 != null);
        await c1.BeginTransactionAsync();
        Chk("in txn", c1.inTxn);
        pool.Release(c1);

        // 二借：容量 1 且连接未回池，本调用必须等清理协程把 ROLLBACK
        // 落地并回池后才能拿到——拿到即已回滚、事务标志已清
        FakeAsyncConnection c2 = await pool.AcquireAsync();
        Chk("second acquire after cleanup", c2 != null);
        Chk("same connection reused", c2 == c1);
        Chk("rollback ran once", c2.rollbackCount == 1);
        Chk("txn flag cleared", !c2.inTxn);

        // 干净归还直通：不开事务，归还后立即可取，回滚计数不变
        pool.Release(c2);
        FakeAsyncConnection c3 = await pool.AcquireAsync();
        Chk("clean return direct", c3 == c2 && c3.rollbackCount == 1);
        pool.Release(c3);
        pool.Close();

        await PoolAsyncResetCase.CloseDuringOpen();
        await PoolAsyncResetCase.FailedOpenAndIdle();
        Console.WriteLine("pool-async-reset-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
        return 0;
    }

    static void Main() {
        int r = await PoolAsyncResetCase.Run();
    }
}
