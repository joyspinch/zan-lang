using System;
using Sdk.Wechat;

namespace WechatCryptTest;

/// Official Tencent sample vector for WXBizMsgCrypt + message XML round-trip.
/// No network.
class Program {
    static void TestOfficialDecrypt() {
        // From Senparc.Weixin/Tencent/Sample.cs (also Tencent's own demo).
        string token = "QDG6eK";
        string appId = "wx5823bf96d3bd56c7";
        string aesKey = "jWmYm7qr5nMoAUwZRjGtBxmz3KA1tkAj3ykkR6q2B2C";
        string sig = "477715d11cdb4164915debcba66cb864d751f3e6";
        string ts = "1409659813";
        string nonce = "1372623149";
        string enc = "";
        string post = "<xml><ToUserName><![CDATA[wx5823bf96d3bd56c7]]></ToUserName><Encrypt><![CDATA["
            + enc + "]]></Encrypt></xml>";

        // 4-arg signature must match.
        string got = WXBizMsgCrypt.MsgSignature(token, ts, nonce, enc);
        Console.WriteLine("msgSig=" + got);
        Console.WriteLine("msgSigOk=" + Convert.ToString(got == sig));

        WXBizMsgCrypt crypt = new WXBizMsgCrypt(token, aesKey, appId);
        string plain = crypt.DecryptMsg(sig, ts, nonce, post);
        Console.WriteLine("hasHello=" + Convert.ToString(
            XmlUtil.GetTag(plain, "Content") == "hello"));
        Console.WriteLine("fromUser=" + XmlUtil.GetTag(plain, "FromUserName"));
        Console.WriteLine("msgType=" + XmlUtil.GetTag(plain, "MsgType"));

        WechatRequestMessage req = WechatRequestMessage.Parse(plain);
        Console.WriteLine("parsedText=" + Convert.ToString(req.IsText()));
        Console.WriteLine("parsedContent=" + req.Content);
    }

    static void TestEncryptRoundTrip() {
        string token = "QDG6eK";
        string appId = "wx5823bf96d3bd56c7";
        string aesKey = "jWmYm7qr5nMoAUwZRjGtBxmz3KA1tkAj3ykkR6q2B2C";
        WXBizMsgCrypt crypt = new WXBizMsgCrypt(token, aesKey, appId);

        string reply = WechatReply.Text("user-open-id", appId, "ping 中文");
        string ts = "1409659813";
        string nonce = "1372623149";
        string encXml = crypt.EncryptMsg(reply, ts, nonce);

        string enc = XmlUtil.GetTag(encXml, "Encrypt");
        string sig = XmlUtil.GetTag(encXml, "MsgSignature");
        Console.WriteLine("encLen=" + Convert.ToString(enc.Length > 0));
        Console.WriteLine("sigLen=" + Convert.ToString(sig.Length == 40));

        // Wrap as a push so DecryptMsg can find <Encrypt>.
        string push = "<xml><ToUserName><![CDATA[" + appId
            + "]]></ToUserName><Encrypt><![CDATA[" + enc + "]]></Encrypt></xml>";
        string plain = crypt.DecryptMsg(sig, ts, nonce, push);
        Console.WriteLine("roundContent=" + XmlUtil.GetTag(plain, "Content"));
        Console.WriteLine("roundTo=" + XmlUtil.GetTag(plain, "ToUserName"));
    }

    static void TestBadSignature() {
        string token = "QDG6eK";
        string appId = "wx5823bf96d3bd56c7";
        string aesKey = "jWmYm7qr5nMoAUwZRjGtBxmz3KA1tkAj3ykkR6q2B2C";
        WXBizMsgCrypt crypt = new WXBizMsgCrypt(token, aesKey, appId);
        string enc = "";
        string post = "<xml><Encrypt><![CDATA[" + enc + "]]></Encrypt></xml>";
        try {
            string plain = crypt.DecryptMsg("deadbeef", "1409659813", "1372623149", post);
            Console.WriteLine("badSig=NOT THROWN");
        } catch (WechatException e) {
            Console.WriteLine("badSig code=" + e.Code);
        }
    }

    static void TestReplyXml() {
        string xml = WechatReply.Text("to", "from", "hi");
        Console.WriteLine("replyType=" + XmlUtil.GetTag(xml, "MsgType"));
        Console.WriteLine("replyContent=" + XmlUtil.GetTag(xml, "Content"));
        Console.WriteLine("replyTo=" + XmlUtil.GetTag(xml, "ToUserName"));

        string item = WechatReply.NewsItem("t", "d", "http://p", "http://u");
        string news = WechatReply.News("to", "from", 1, item);
        Console.WriteLine("newsCount=" + XmlUtil.GetTag(news, "ArticleCount"));
        Console.WriteLine("newsTitle=" + XmlUtil.GetTag(news, "Title"));
    }

    static void TestOAuthUrl() {
        WechatClient c = new WechatClient("appid1", "secret1");
        string url = c.BuildOAuthUrl("https://example.com/cb", "snsapi_userinfo", "st");
        Console.WriteLine("oauthPrefix=" + Convert.ToString(
            url.StartsWith("https://open.weixin.qq.com/connect/oauth2/authorize")));
        Console.WriteLine("oauthScope=" + Convert.ToString(
            url.IndexOf("snsapi_userinfo") >= 0));
    }

    static void Main() {
        TestOfficialDecrypt();
        TestEncryptRoundTrip();
        TestBadSignature();
        TestReplyXml();
        TestOAuthUrl();
    }
}
