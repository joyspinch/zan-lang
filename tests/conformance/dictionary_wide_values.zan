using System;
using System.Collections.Generic;

struct P3 { public int x; public int y; public int z; }
struct Big { public long a; public long b; public long c; public long d; }
struct Named { public string text; public int id; public int tag; }

class Program {
    static P3 Point(int n) {
        P3 p;
        p.x = n;
        p.y = n + 100;
        p.z = n + 1000;
        return p;
    }

    static Big Wide(long n) {
        Big b;
        b.a = n;
        b.b = n + 1;
        b.c = n + 2;
        b.d = n + 3;
        return b;
    }

    static Named Name(int n) {
        Named v;
        v.text = "item-" + Convert.ToString(n);
        v.id = n;
        v.tag = n * 10;
        return v;
    }

    static void Main() {
        Dictionary<int, P3> d = new Dictionary<int, P3>();
        int i = 0;
        while (i < 20) {
            d.Add(i, Point(i));
            i = i + 1;
        }
        Console.WriteLine(Convert.ToString(d.Count));
        Console.WriteLine(Convert.ToString(d[0].x + d[0].y + d[0].z));
        Console.WriteLine(Convert.ToString(d[19].x + d[19].y + d[19].z));

        d[5] = Point(50);
        Console.WriteLine(Convert.ToString(d.Count));
        Console.WriteLine(Convert.ToString(d[5].x + d[5].y + d[5].z));

        List<P3> values = d.Values;
        Console.WriteLine(Convert.ToString(values.Count));
        Console.WriteLine(Convert.ToString(values[5].x + values[5].y + values[5].z));

        d.Remove(3);
        Console.WriteLine(Convert.ToString(d.Count));
        Console.WriteLine(Convert.ToString(d[4].x + d[4].y + d[4].z));
        List<P3> shifted = d.Values;
        Console.WriteLine(Convert.ToString(shifted[3].x + shifted[3].y + shifted[3].z));
        Console.WriteLine(Convert.ToString(shifted[18].x + shifted[18].y + shifted[18].z));

        d.Clear();
        Console.WriteLine(Convert.ToString(d.Count));
        d.Add(7, Point(70));
        Console.WriteLine(Convert.ToString(d[7].x + d[7].y + d[7].z));

        Dictionary<string, Big> init = new Dictionary<string, Big>() {
            { "a", Wide(100) },
            { "b", Wide(200) }
        };
        Console.WriteLine(Convert.ToString(init.Count));
        Console.WriteLine(Convert.ToString(init["a"].a + init["a"].b + init["a"].c + init["a"].d));
        init["b"] = Wide(300);
        Console.WriteLine(Convert.ToString(init["b"].a + init["b"].b + init["b"].c + init["b"].d));

        Dictionary<int, Named> owned = new Dictionary<int, Named>();
        owned.Add(1, Name(1));
        owned[1] = Name(2);
        owned.Add(2, Name(3));
        List<Named> names = owned.Values;
        owned.Remove(1);
        owned.Clear();
        Console.WriteLine(names[0].text);
        Console.WriteLine(names[1].text);
        Console.WriteLine(Convert.ToString(names[0].id));
        Console.WriteLine(Convert.ToString(names[0].tag));
        Console.WriteLine(Convert.ToString(names[1].id));
        Console.WriteLine(Convert.ToString(names[1].tag));

        List<Named> direct = new List<Named>();
        direct.Add(Name(4));
        direct.Add(Name(5));
        direct.RemoveAt(0);
        Console.WriteLine(direct[0].text);
        Console.WriteLine(Convert.ToString(direct[0].tag));
        direct.Clear();
        Console.WriteLine(Convert.ToString(direct.Count));
        Console.WriteLine("done");
    }
}
