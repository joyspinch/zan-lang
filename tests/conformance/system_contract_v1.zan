using System;
using System.IO;
using System.Media;

class Program {
    static int Main() {
        string testFile = "_scratch/test_contract_demo.txt";

        // 1. StreamReader / StreamWriter IDisposable & using 验证
        using (StreamWriter sw = new StreamWriter(testFile)) {
            sw.WriteLine("contract line 1");
            sw.WriteLine("contract line 2");
        }

        string readBack = "";
        using (StreamReader sr = new StreamReader(testFile)) {
            readBack = sr.ReadLine();
        }

        if (readBack != "contract line 1") {
            Console.WriteLine("FAIL: readBack mismatch");
            return 1;
        }

        // 2. Path 核心算法收敛验证
        bool match = Path.IsMatch("*.txt", "hello.txt");
        bool under = Path.IsUnder("a/b", "a/b/c/d.txt");
        string clean = Path.Clean("a/b/../c/./d.txt");
        if (!match || !under || clean != "a/c/d.txt") {
            Console.WriteLine("FAIL: Path methods mismatch");
            return 2;
        }

        // 3. PathEx 向后兼容 shim 验证
        bool matchEx = PathEx.IsMatch("*.txt", "world.txt");
        if (!matchEx) {
            Console.WriteLine("FAIL: PathEx mismatch");
            return 3;
        }

        // 4. File 现代文件时间与 MIME 验证
        File.SetLastWriteTime(testFile, 1700000000);
        long mtime = FileInfo.GetLastWriteTime(testFile);
        if (mtime != 1700000000) {
            Console.WriteLine("FAIL: mtime mismatch");
            return 4;
        }

        string mime = File.GetMimeType("test.json");
        if (mime != "application/json") {
            Console.WriteLine("FAIL: mime mismatch");
            return 5;
        }

        // 5. System.Media.Audio 与 System.Audio 兼容性验证
        string drv = Audio.DriverName();
        string drvMedia = System.Media.Audio.DriverName();
        if (drv != drvMedia) {
            Console.WriteLine("FAIL: Audio driver mismatch");
            return 6;
        }

        File.Delete(testFile);
        Console.WriteLine("system-contract-v1-ok: 1");
        return 0;
    }
}
