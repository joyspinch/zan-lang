--- recognition
primary @0 -> ignored
md:flex @0 -> ignored
group-hover:flex @0 -> ignored
hover:flex @0 -> ignored
hover:flex @1 -> applied
checked:bg-red-500 @32 -> applied
hover:focus:bg-red-500 @1 -> ignored
underline @0 -> ignored
flex @0 -> applied
