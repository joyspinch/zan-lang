--- spacing
p-4 -> pad 16,16,16,16 margin 0,0,0,0 gap -1/-1/-1
p-0 -> pad 0,0,0,0 margin 0,0,0,0 gap -1/-1/-1
p-px -> pad 1,1,1,1 margin 0,0,0,0 gap -1/-1/-1
p-1.5 -> pad 6,6,6,6 margin 0,0,0,0 gap -1/-1/-1
px-3 py-1 -> pad 12,4,12,4 margin 0,0,0,0 gap -1/-1/-1
pt-2 pr-3 pb-4 pl-5 -> pad 20,8,12,16 margin 0,0,0,0 gap -1/-1/-1
m-2 -> pad -1,-1,-1,-1 margin 8,8,8,8 gap -1/-1/-1
-mt-3 mb-1 -> pad -1,-1,-1,-1 margin 0,-12,0,4 gap -1/-1/-1
mx-2 my-8 -> pad -1,-1,-1,-1 margin 8,32,8,32 gap -1/-1/-1
gap-2 -> pad -1,-1,-1,-1 margin 0,0,0,0 gap 8/-1/-1
gap-x-4 gap-y-1 -> pad -1,-1,-1,-1 margin 0,0,0,0 gap -1/4/16
space-x-3 space-y-2 -> pad -1,-1,-1,-1 margin 0,0,0,0 gap -1/8/12
p-[10px] -> pad 10,10,10,10 margin 0,0,0,0 gap -1/-1/-1
mx-auto -> pad -1,-1,-1,-1 margin 0,0,0,0 gap -1/-1/-1
--- sizing
w-64 h-8 -> 256x32 pm -1x-1 min -1,-1 max -1,-1 pm -1,-1
w-full h-full -> -1x-1 pm 1000x1000 min -1,-1 max -1,-1 pm -1,-1
w-1/2 -> -1x-1 pm 500x-1 min -1,-1 max -1,-1 pm -1,-1
w-1/3 h-2/3 -> -1x-1 pm 330x660 min -1,-1 max -1,-1 pm -1,-1
w-auto -> -1x-1 pm -1x-1 min -1,-1 max -1,-1 pm -1,-1
size-10 -> 40x40 pm -1x-1 min -1,-1 max -1,-1 pm -1,-1
min-w-0 min-h-8 -> -1x-1 pm -1x-1 min 0,32 max -1,-1 pm -1,-1
max-w-md max-h-64 -> -1x-1 pm -1x-1 min -1,-1 max 448,256 pm -1,-1
max-w-full -> -1x-1 pm -1x-1 min -1,-1 max -1,-1 pm 1000,-1
w-[240px] h-[38px] -> 240x38 pm -1x-1 min -1,-1 max -1,-1 pm -1,-1
w-px -> 1x-1 pm -1x-1 min -1,-1 max -1,-1 pm -1,-1
--- typography
text-xs -> font 12 weight 0 line 0 spacing 0 align -1 case 0 fg 0
text-sm -> font 14 weight 0 line 0 spacing 0 align -1 case 0 fg 0
text-base -> font 16 weight 0 line 0 spacing 0 align -1 case 0 fg 0
text-2xl -> font 24 weight 0 line 0 spacing 0 align -1 case 0 fg 0
text-[13px] -> font 13 weight 0 line 0 spacing 0 align -1 case 0 fg 0
text-center -> font 0 weight 0 line 0 spacing 0 align 1 case 0 fg 0
text-right -> font 0 weight 0 line 0 spacing 0 align 2 case 0 fg 0
font-bold -> font 0 weight 700 line 0 spacing 0 align -1 case 0 fg 0
font-medium -> font 0 weight 500 line 0 spacing 0 align -1 case 0 fg 0
leading-6 tracking-wide -> font 0 weight 0 line 24 spacing 1 align -1 case 0 fg 0
leading-tight tracking-tighter -> font 0 weight 0 line 20 spacing -2 align -1 case 0 fg 0
text-slate-100 -> font 0 weight 0 line 0 spacing 0 align -1 case 0 fg -920071
text-emerald-500 -> font 0 weight 0 line 0 spacing 0 align -1 case 0 fg -15681151
text-[#ff8800] -> font 0 weight 0 line 0 spacing 0 align -1 case 0 fg -30720
uppercase -> font 0 weight 0 line 0 spacing 0 align -1 case 1 fg 0
truncate -> font 0 weight 0 line 0 spacing 0 align -1 case 0 fg 0
