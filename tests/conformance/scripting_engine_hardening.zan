using System;
using System.Scripting;

class Program {
    static int ZanAdd(nint L) {
        double a = Lua.ArgDouble(L, 1);
        double b = Lua.ArgDouble(L, 2);
        return Lua.ReturnDouble(L, a + b);
    }

    static void Main() {
        if (!Lua.IsAvailable()) {
            Console.WriteLine("scripting_available=0");
            Console.WriteLine("scripting_hardening_ok");
            return;
        }

        Console.WriteLine("scripting_available=1");
        Lua.Initialize();
        Console.WriteLine("scripting_initialized=" + Lua.IsInitialized());

        // 1. Basic execution & Eval
        Lua.Exec("base_val = 100\nfunction calc(x) return x * 2 + base_val end");
        LuaValue val = Lua.Eval("calc(50)");
        Console.WriteLine("eval_calc=" + val.ToLong());
        val.Dispose();

        // 2. Data Marshaling & Tables
        LuaValue dict = Lua.Eval("{ host = 'localhost', port = 9000, enabled = true }");
        Console.WriteLine("table_host=" + dict.Get("host").ToStr());
        Console.WriteLine("table_port=" + dict.Get("port").ToLong());
        Console.WriteLine("table_enabled=" + dict.Get("enabled").ToBool());

        dict.Set("host", Lua.FromStr("127.0.0.1"));
        Console.WriteLine("updated_host=" + dict.Get("host").ToStr());
        dict.Dispose();

        // 3. Register Zan Native Callback to Lua
        bool regOk = Lua.RegisterFunction("zan_add", ZanAdd);
        Console.WriteLine("reg_ok=" + regOk);
        double addRes = Lua.CallD("zan_add", 12.5, 37.5);
        Console.WriteLine("add_res=" + addRes);

        // 4. Sandbox verification
        Lua.Sandbox();
        Lua.Exec("math_sqrt = math.sqrt(16)");
        Console.WriteLine("sandbox_math=" + Lua.Eval("math_sqrt").ToDouble());

        // 5. Array conversions
        List<string> list = new List<string>();
        list.Add("one");
        list.Add("two");
        list.Add("three");
        LuaValue arr = Lua.FromListStr(list);
        Console.WriteLine("arr_len=" + arr.Length());
        Console.WriteLine("arr_second=" + arr.At(2L).ToStr());
        arr.Dispose();

        // 6. Cleanup
        Lua.Finalize();
        Console.WriteLine("scripting_finalized=" + !Lua.IsInitialized());

        Console.WriteLine("scripting_hardening_ok");
    }
}
