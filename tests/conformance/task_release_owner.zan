using System;
using System.Threading;

class TaskReleaseValue {
    public int value = 73;
}
class TaskReleaseOwner {
    static WeakReference<TaskReleaseValue> watch;
    static async TaskReleaseValue Produce() {
        await Task.Yield();
        TaskReleaseValue value = new TaskReleaseValue();
        watch = new WeakReference<TaskReleaseValue>(value);
        return value;
    }
    static async int Fail() {
        await Task.Yield();
        throw new Exception("discarded task failure");
    }
    static void Main() {
        Task<TaskReleaseValue> task = Task.Run(Produce());
        task.Wait();
        task.Wait();
        Console.WriteLine(watch.IsAlive);
        long handle = task;
        Task.Release(handle);
        Console.WriteLine(!watch.IsAlive);
        Console.WriteLine(Task.IsDone(handle) != 0);
        Task.Cancel(handle);
        Task.Release(handle);
        Console.WriteLine(Task.IsDone(handle) != 0);

        Task<TaskReleaseValue> consumed = Task.Run(Produce());
        TaskReleaseValue result = consumed.Result;
        Console.WriteLine(result.value == 73);
        Task.Release(consumed);
        Console.WriteLine(watch.IsAlive);
        result = null;
        Console.WriteLine(!watch.IsAlive);

        long failed = Task.Run(Fail());
        Task.Release(failed);
        Console.WriteLine(Task.IsDone(failed) != 0);
        long action = Task.Run(() => { });
        Task.Release(action);
        Console.WriteLine(Task.IsDone(action) != 0);
    }
}
