using System;
namespace P;
class Program {
    static string Pick(string src, bool b) {
        return "[pre" + (b ? "lit" : src);
    }

    static void Main() {
        string s = "ABCDEFGH" + "IJKLMNOP";
        string r = Program.Pick(s, false);
        Console.WriteLine(r);

        string squatter = "QQQQQQQQ" + "QQQQQQQQ";
        Console.WriteLine(squatter);

        Console.WriteLine(s);            // over-release => QQQQQQQQ... / crash
        Console.WriteLine(Convert.ToString(s.Length));
        Console.WriteLine(Program.Pick(s, true));
        Console.WriteLine(s);
    }
}
