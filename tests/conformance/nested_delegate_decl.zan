using System;

namespace Conf;

// 核心契约与语义定义。
class Registry {
    public delegate bool Matcher<T>(T item);
    delegate void Sink(string msg);

    static Sink log;
    static bool LongStrings(string s) { return s.Length > 3; }
    static void Print(string msg) { Console.WriteLine(msg); }

    public static Matcher<string> DefaultMatcher() {
        return LongStrings;
    }

    static void Main() {
        Sink s = Print;
        s("sink-ok");

        Registry.log = Print;
        Registry.log("field-ok");

        Matcher<string> m = LongStrings;
        Console.WriteLine(Convert.ToString(m("abcd")));
        Console.WriteLine(Convert.ToString(m("ab")));

        Outer.Filter<string> q = Outer.Get();
        Console.WriteLine(Convert.ToString(q("wxyz")) + Convert.ToString(q("no")));
    }
}

class Outer {
    public delegate bool Filter<T>(T item);
    static bool NonEmpty(string s) { return s.Length > 0; }
    public static Filter<string> Get() {
        return NonEmpty;
    }
}
