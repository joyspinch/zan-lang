using System;

class Target {
    public int Value;
    public string Greet() { return "hello"; }
}

class Program {
    static void Main() {
        // 1. DivideByZeroException
        try {
            int a = 10, b = 0;
            int c = a / b;
            Console.WriteLine("div zero fail: " + c);
        } catch (DivideByZeroException e) {
            Console.WriteLine("caught div zero: " + e.Message);
        }

        // 2. IndexOutOfRangeException
        try {
            int[] arr = new int[3];
            int x = arr[10];
            Console.WriteLine("oob fail: " + x);
        } catch (IndexOutOfRangeException e) {
            Console.WriteLine("caught oob: " + e.Message);
        }

        // 3. NullReferenceException on method call
        try {
            Target t = null;
            string s = t.Greet();
            Console.WriteLine("null method fail: " + s);
        } catch (NullReferenceException e) {
            Console.WriteLine("caught null call: " + e.Message);
        }

        // 4. NullReferenceException on field access
        try {
            Target t = null;
            int v = t.Value;
            Console.WriteLine("null field fail: " + v);
        } catch (NullReferenceException e) {
            Console.WriteLine("caught null field: " + e.Message);
        }

        Console.WriteLine("all checks passed");
    }
}
