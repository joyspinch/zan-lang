using System;
using System.Collections.Generic;
using Game.Tactics;
using Game.Net;
using Game.Foundation;

class GameAdvancedSystemsSuite {
    static void Assert(bool cond, string msg) {
        if (!cond) {
            Console.WriteLine("[FAIL] " + msg);
            Environment.Exit(1);
        }
    }

    static void TestRvoAvoidance() {
        Console.WriteLine("[1/3] 验证 RTS 万人微观推挤与 RVO2 互斥避障算法...");
        RvoSimulator sim = RvoSimulator.Create(32, 48);

        // 创建两个沿 X 轴迎面正冲的单位，Y 轴完全重合为 100.0
        int a1 = sim.AddAgent(100.0, 100.0, 15.0, 100.0);
        int a2 = sim.AddAgent(200.0, 100.0, 15.0, 100.0);
        Assert(sim.AgentCount == 2, "Agent count should be 2");

        sim.SetPrefVelocity(a1, 80.0, 0.0);
        sim.SetPrefVelocity(a2, -80.0, 0.0);

        // 步进 1.0 秒模拟迎面对决
        for (int i = 0; i < 20; i = i + 1) {
            sim.Step(0.05);
        }

        double y1 = sim.GetY(a1);
        double y2 = sim.GetY(a2);
        double x1 = sim.GetX(a1);
        double x2 = sim.GetX(a2);

        // 双方应该沿 Y 轴侧向避让滑开，且 X 轴互相推进穿过对方
        Assert(Math.Abs(y1 - 100.0) > 5.0, "Agent 1 should deviate on Y to avoid collision");
        Assert(Math.Abs(y2 - 100.0) > 5.0, "Agent 2 should deviate on Y to avoid collision");
        Assert(x1 > 150.0 && x2 < 150.0, "Agents should have crossed each other on X");

        // 验证距离绝不小于两单位半径和 (15 + 15 = 30)
        double dx = x1 - x2;
        double dy = y1 - y2;
        double dist = Math.Sqrt(dx * dx + dy * dy);
        Assert(dist >= 28.0, "Agents should not penetrate each other");
        Console.WriteLine("[PASS] TestRvoAvoidance");
    }

    static void TestReplaySystem() {
        Console.WriteLine("[2/3] 验证确定性战局录像回放与快进控制...");
        ReplayRecorder recorder = ReplayRecorder.Create(888888, 2, "BloodBath");
        Assert(recorder.IsRecording, "Recorder should be active");

        // 记录 8 个逻辑帧
        for (int f = 1; f <= 8; f = f + 1) {
            FrameBucket bucket = FrameBucket.Create(f, 2);
            bucket.AddCommand(PlayerCommand.Create(1, 10, (double)(f * 20), 100.0, 0, 0));
            recorder.RecordFrame(f, bucket);
        }
        recorder.Stop();
        Assert(!recorder.IsRecording, "Recorder should be stopped");
        Assert(recorder.FrameCount == 8, "Recorded frame count should be 8");

        // 构造回放播放器并以 4 倍速回放
        ReplayPlayer player = ReplayPlayer.Create(recorder.Header, recorder.GetFrames(), 20.0);
        player.Play();
        player.SpeedMultiplier = 4.0;

        int executedCount = 0;
        int lastFrame = 0;
        // 在 20Hz 下，1 帧 = 0.05s。4倍速下 0.1s 相当于 0.4s 逻辑时间（8 帧全跑完）
        player.Update(0.12, (int fIdx, List<PlayerCommand> cmds) => {
            executedCount = executedCount + 1;
            lastFrame = fIdx;
            Assert(cmds.Count == 1, "Command count should match");
        });

        Assert(executedCount == 8, "All 8 frames should be executed under 4x speed");
        Assert(lastFrame == 8, "Last executed frame should be 8");
        Assert(player.IsFinished, "Replay should be marked finished");
        Console.WriteLine("[PASS] TestReplaySystem");
    }

    static void TestSpatialAudio2D() {
        Console.WriteLine("[3/3] 验证 2.5D 空间立体声衰减与声相偏转...");
        SpatialAudio2D audio = SpatialAudio2D.Create(null, 640.0, 100.0, 1000.0);
        audio.SetListenerPosition(500.0, 400.0);

        double pan;
        double gain;

        // 1. 中心无衰减测试
        audio.CalculateSpatial(500.0, 400.0, 1.0, out pan, out gain);
        Assert(pan == 0.0, "Center pan should be 0.0");
        Assert(gain == 1.0, "Center gain should be 1.0");

        // 2. 屏幕右侧声相偏转 (dx = +320px -> pan = +0.5)
        audio.CalculateSpatial(820.0, 400.0, 1.0, out pan, out gain);
        Assert(Math.Abs(pan - 0.5) < 0.01, "Right side pan should be ~0.5");
        Assert(gain < 1.0 && gain > 0.0, "Gain should attenuate with distance");

        // 3. 超远距离静音裁剪 (dx = +2000px)
        audio.CalculateSpatial(2500.0, 400.0, 1.0, out pan, out gain);
        Assert(gain == 0.0, "Far distance sound should be completely muted to save CPU");
        Console.WriteLine("[PASS] TestSpatialAudio2D");
    }

    static void Main() {
        Console.WriteLine("=== 开始验证高级运动学、录像回放与空间音频套件 ===");
        TestRvoAvoidance();
        TestReplaySystem();
        TestSpatialAudio2D();
        Console.WriteLine("ADVANCED_SYSTEMS_ALL_PASSED");
    }
}
