using System;

class DecimalInstanceToString {
    static int calls;

    static decimal Next() {
        calls++;
        return 9007199254740993m;
    }

    static void Main() {
        decimal large = 9007199254740993m;
        decimal maximum = 79228162514264337593543950335m;
        decimal tiny = 0.0000000000000000000000000001m;
        decimal negative = -9007199254740993m;
        decimal zero = 0m;
        Console.WriteLine(large.ToString() == "9007199254740993");
        Console.WriteLine(maximum.ToString() == "79228162514264337593543950335");
        Console.WriteLine(tiny.ToString() == "0.0000000000000000000000000001");
        Console.WriteLine(negative.ToString() == "-9007199254740993");
        Console.WriteLine(zero.ToString() == "0");
        string rendered = Next().ToString();
        Console.WriteLine(rendered == "9007199254740993");
        Console.WriteLine(rendered.Length == 16);
        Console.WriteLine(calls == 1);
    }
}
