using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Conf;

/// 对象初始化器的两个后缀形态：
/// ① 构造泛型类型后缀 `List<int> { a, b }`（元素逐个 Add，
///    与 `new List<int>() { ... }` 同义）；
/// ② 工厂调用延续 `Panel.Row() { Children = { ... } }`（大括号
///    继续刚解析的调用，成员写作用在返回的对象上，`Children`
///    走 getter-only 属性的完整 With 收养语义）。
/// 对照组：`new Panel() { ... }` 构造器形式。
class Program {
    static void Main() {
        // 1) 后缀泛型类型初始化器
        List<int> xs = List<int> { 10, 20, 30 };
        Console.WriteLine(xs.Count);
        Console.WriteLine(xs[0]);
        Console.WriteLine(xs[2]);

        List<string> names = List<string> { "a", "b" };
        Console.WriteLine(names.Count);
        Console.WriteLine(names[1]);

        // 2) 工厂调用延续初始化器（GUI 静态工厂 + Children 集合）
        Panel row = Panel.Row() {
            Children = { new Label(), new Label() },
        };
        Panel row2 = Panel.Row();
        row2.With(new Label()).With(new Label());
        Console.WriteLine(row.ChildCount());
        Console.WriteLine(row2.ChildCount());

        // 3) 对照：构造器形式照常工作
        Panel col = new Panel() { Children = { new Label() } };
        Console.WriteLine(col.ChildCount());
    }
}
