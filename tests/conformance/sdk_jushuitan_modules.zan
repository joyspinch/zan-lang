using System;
using Sdk.Jushuitan;
using Sdk.Jushuitan.Api.Basic;
using Sdk.Jushuitan.Api.Product;
using Sdk.Jushuitan.Api.Inventory;
using Sdk.Jushuitan.Api.Order;
using Sdk.Jushuitan.Api.Logistics;
using Sdk.Jushuitan.Api.Purchase;
using Sdk.Jushuitan.Api.Inbound;
using Sdk.Jushuitan.Api.Outbound;
using Sdk.Jushuitan.Api.AfterSales;
using Sdk.Jushuitan.Api.OtherStockMovement;
using Sdk.Jushuitan.Api.Transfer;
using Sdk.Jushuitan.Api.CrossBorder;
using Sdk.Jushuitan.Api.Jucaikuai;
using Sdk.Jushuitan.Api.WorkOrder;
using Sdk.Jushuitan.Api.Finance;
using Sdk.Jushuitan.Api.PickingWave;
using Sdk.Jushuitan.Api.Invoice;
using Sdk.Jushuitan.Api.CloudWarehouse;
using Sdk.Jushuitan.Api.Shengsuan;
using Sdk.Jushuitan.Api.Wms;

class Program {
    static void Main() {
        JushuitanClient client = new JushuitanClient("k", "s").SetAccessToken("t");

        BasicApi basicApi = new BasicApi(client);
        ProductApi productApi = new ProductApi(client);
        InventoryApi inventoryApi = new InventoryApi(client);
        OrderApi orderApi = new OrderApi(client);
        LogisticsApi logisticsApi = new LogisticsApi(client);
        PurchaseApi purchaseApi = new PurchaseApi(client);
        InboundApi inboundApi = new InboundApi(client);
        OutboundApi outboundApi = new OutboundApi(client);
        AfterSalesApi afterSalesApi = new AfterSalesApi(client);
        OtherStockMovementApi otherStockApi = new OtherStockMovementApi(client);
        TransferApi transferApi = new TransferApi(client);
        CrossBorderApi crossBorderApi = new CrossBorderApi(client);
        JucaikuaiApi jucaikuaiApi = new JucaikuaiApi(client);
        WorkOrderApi workOrderApi = new WorkOrderApi(client);
        FinanceApi financeApi = new FinanceApi(client);
        PickingWaveApi pickingWaveApi = new PickingWaveApi(client);
        InvoiceApi invoiceApi = new InvoiceApi(client);
        CloudWarehouseApi cloudWarehouseApi = new CloudWarehouseApi(client);
        ShengsuanApi shengsuanApi = new ShengsuanApi(client);
        WmsApi wmsApi = new WmsApi(client);

        QueryShopsRequest shopsReq = new QueryShopsRequest().PageIndex(1).PageSize(20);
        shopsReq.Validate();
        QueryOrdersRequest ordersReq = new QueryOrdersRequest().PageIndex(1).PageSize(10);
        ordersReq.Validate();
        BatchRegisterExpressShipmentsRequest regReq = new BatchRegisterExpressShipmentsRequest()
            .AddItem(new BatchRegisterExpressShipmentsItemParam().LId("L1").LName("顺丰"));
        regReq.Validate();

        if (basicApi == null || productApi == null || inventoryApi == null || orderApi == null
            || logisticsApi == null || purchaseApi == null || inboundApi == null || outboundApi == null
            || afterSalesApi == null || otherStockApi == null || transferApi == null || crossBorderApi == null
            || jucaikuaiApi == null || workOrderApi == null || financeApi == null || pickingWaveApi == null
            || invoiceApi == null || cloudWarehouseApi == null || shengsuanApi == null || wmsApi == null) {
            Console.WriteLine("api=null");
            return;
        }

        Console.WriteLine("jushuitan-modules=20");
        Console.WriteLine("reg=" + regReq.ToJson());
    }
}
