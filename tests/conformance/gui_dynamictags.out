defaults closable=true kind=DynamicTags
empty 0 [] canAdd=true
seeded 3 [调查中 已发布 已归档] canAdd=true changes=0
options '调查中|已发布|已归档'
edited 3 [调查中 已归档 新标签] canAdd=true changes=2
bogus 3 [调查中 已归档 新标签] canAdd=true changes=2
maxed 2 [a b] canAdd=false
overMax 3 [a b c] canAdd=false
atLimit 2 [b c] canAdd=false
reopened 1 [c] canAdd=true
setOptions true 3 [one two three] canAdd=true
setOptions emptySegs true 2 [x y] canAdd=true
roundTrip 'x|y'
unknownKey false extra=''
cleared 2 [x y] canAdd=true options='x|y'
