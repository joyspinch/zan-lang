defaults closable=1 kind=DynamicTags
empty 0 [] canAdd=1
seeded 3 [调查中 已发布 已归档] canAdd=1 changes=0
options '调查中|已发布|已归档'
edited 3 [调查中 已归档 新标签] canAdd=1 changes=2
bogus 3 [调查中 已归档 新标签] canAdd=1 changes=2
maxed 2 [a b] canAdd=0
overMax 3 [a b c] canAdd=0
atLimit 2 [b c] canAdd=0
reopened 1 [c] canAdd=1
setOptions 1 3 [one two three] canAdd=1
setOptions emptySegs 1 2 [x y] canAdd=1
roundTrip 'x|y'
unknownKey 0 extra=''
cleared 2 [x y] canAdd=1 options='x|y'
