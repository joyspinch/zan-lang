// Relational operator overloading (A43-A13): `operator <` / `>` / `<=` / `>=`
// on a user class used to be rejected by the checker (`cannot compare 'V' and
// 'V' with a relational operator`), while the arithmetic operators and `==`
// already lowered to their op_* methods. The relational branch now recognizes
// op_lt/op_gt/op_le/op_ge on the left operand's class and lets irgen dispatch.
class V {
    public int n = 0;
    public static V operator +(V a, int b) { V r = new V(); r.n = a.n + b; return r; }
    public static bool operator ==(V a, V b) { return a.n == b.n; }
    public static bool operator <(V a, V b) { return a.n < b.n; }
    public static bool operator >(V a, V b) { return a.n > b.n; }
    public static bool operator <=(V a, V b) { return a.n <= b.n; }
    public static bool operator >=(V a, V b) { return a.n >= b.n; }
}
class P {
    static void Main() {
        V a = new V(); a.n = 5;
        V b = new V(); b.n = 8;
        Console.WriteLine(a < b);       // True
        Console.WriteLine(a > b);       // False
        Console.WriteLine(a <= b);      // True
        Console.WriteLine(a >= b);      // False
        Console.WriteLine(a == b);      // False
        V c = new V(); c.n = 5;
        Console.WriteLine(a == c);      // True
        Console.WriteLine(a != b);      // True
        Console.WriteLine(a != c);      // False
        V d = new V(); d.n = 3;
        d += 5;                          // arithmetic still dispatches
        Console.WriteLine(d.n);          // 8
        Console.WriteLine(d > a);        // True (8 > 5)
        Console.WriteLine(d <= b);       // True (8 <= 8)
    }
}
