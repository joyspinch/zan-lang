using System;

public delegate int CallOwnerRead(int ignored);
class CallOwnerSlot {
    public CallOwnerRead read;
}
class CallOwnerReceiver {
    public int value;
    public int Clear(CallOwnerClearSlot slot, WeakReference<CallOwnerReceiver> observer) {
        slot.read = null;
        Console.WriteLine(observer.IsAlive);
        return value;
    }
    public int Read(int ignored) { return value; }
}
public delegate int CallOwnerClear(CallOwnerClearSlot slot, WeakReference<CallOwnerReceiver> observer);
class CallOwnerClearSlot {
    public CallOwnerClear read;
}
class CallOwnerBindingModel {
    public int value;
}
class SelfhostDelegateCallOwner {
    static int Replace(CallOwnerSlot slot, WeakReference<CallOwnerReceiver> observer) {
        slot.read = null;
        Console.WriteLine(observer.IsAlive);
        return 0;
    }
    static void CheckArgumentLifetime() {
        CallOwnerReceiver receiver = new CallOwnerReceiver();
        receiver.value = 47;
        WeakReference<CallOwnerReceiver> observer = new WeakReference<CallOwnerReceiver>(receiver);
        CallOwnerSlot slot = new CallOwnerSlot();
        slot.read = receiver.Read;
        receiver = null;
        // Argument evaluation removes the last field owner of this callee.
        Console.WriteLine(slot.read(Replace(slot, observer)));
        Console.WriteLine(observer.IsAlive);
    }
    static void CheckCallbackLifetime() {
        CallOwnerReceiver receiver = new CallOwnerReceiver();
        receiver.value = 48;
        WeakReference<CallOwnerReceiver> observer = new WeakReference<CallOwnerReceiver>(receiver);
        CallOwnerClearSlot slot = new CallOwnerClearSlot();
        slot.read = receiver.Clear;
        receiver = null;
        Console.WriteLine(slot.read(slot, observer));
        receiver = null;
        Console.WriteLine(observer.IsAlive);
    }
    static void CheckBinding() {
        CallOwnerBindingModel model = new CallOwnerBindingModel();
        model.value = 49;
        Binding<int> binding = model.value;
        binding.Set(binding.Get() + 1);
        Console.WriteLine(model.value);
        binding = null;
    }
    static void Main() {
        CheckArgumentLifetime();
        CheckCallbackLifetime();
        CheckBinding();
    }
}
