using System;
using System.Platform;

class Program {
    static void Main() {
        // 1. Direct Pal.Text probe
        IPlatformTextMarshaler tm = Pal.Text;
        Console.WriteLine("pal_text_not_null=" + (tm != null));

        // 2. Wide facade
        Console.WriteLine("wide_charsize_match=" + (Wide.CharSize() == tm.CharSize()));

        // Null string
        nint wnull = Wide.Of(null);
        Console.WriteLine("wnull=" + (wnull == 0));
        Console.WriteLine("read_zero=" + (Wide.Read(0) == ""));
        Console.WriteLine("len_zero=" + (Wide.Length(0) == 0));

        // Empty string
        nint wempty = Wide.Of("");
        Console.WriteLine("len_empty=" + (Wide.Length(wempty) == 0));
        Console.WriteLine("read_empty=" + (Wide.Read(wempty) == ""));
        Wide.Free(wempty);

        // ASCII string
        string ascii = "Hello Zan PAL Wide!";
        nint wascii = Wide.Of(ascii);
        Console.WriteLine("len_ascii=" + (Wide.Length(wascii) == ascii.Length));
        Console.WriteLine("read_ascii=" + (Wide.Read(wascii) == ascii));
        Wide.Free(wascii);

        // Multilingual CJK and Unicode emoji
        string cjk = "中文字符串与Emoji 🦆测试";
        nint wcjk = Wide.Of(cjk);
        string back = Wide.Read(wcjk);
        Console.WriteLine("cjk_roundtrip=" + (back == cjk));
        Wide.Free(wcjk);

        Console.WriteLine("PAL_WIDE_TEXT_SMOKE: PASS");
    }
}
