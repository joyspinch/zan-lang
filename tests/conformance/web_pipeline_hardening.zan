using System;
using System.Collections.Generic;
using System.Net.Http;
using System.Web;

class Program {
    static async bool PingHandler(HttpContext ctx) {
        ctx.Text("pong");
        return true;
    }

    static void Main() {
        // 1. HttpRequest & HttpResponse API and lifecycle
        string rawReq = HttpRequest.BuildGet("/api/users?page=2&limit=50", "example.com");
        HttpRequest req = HttpRequest.Parse(rawReq);
        Console.WriteLine("req_method=" + req.method);
        Console.WriteLine("req_path=" + req.path);
        Console.WriteLine("req_host=" + req.GetHeader("Host"));
        Console.WriteLine("req_page=" + req.GetQueryParam("page"));

        HttpResponse res = HttpResponse.Json("{\"status\":\"ok\"}");
        res.SetHeader("X-Custom", "TestVal");
        Console.WriteLine("res_status=" + Convert.ToString(res.statusCode));
        Console.WriteLine("res_header=" + res.GetHeader("X-Custom"));
        Console.WriteLine("res_body=" + res.body);
        res.Dispose();
        Console.WriteLine("res_disposed=true");

        // 2. Validator test
        Validator val = new Validator();
        val.Require("hello", "title");
        val.MinLen("secure_pass", 6, "password");
        val.MaxLen("short", 10, "tag");
        val.IsInt("12345", "code");
        val.OneOf("active", "active,inactive,pending", "status");
        Console.WriteLine("val_ok=" + (val.Ok() ? "true" : "false"));
        Console.WriteLine("val_filename=" + Validator.SafeFileName("../../secret.txt"));
        Console.WriteLine("val_ext=" + (Validator.ExtAllowed("doc.pdf", "pdf,png,jpg") ? "true" : "false"));

        // 3. Filter test
        Console.WriteLine("filter_clean=" + Filter.Clean("  \t sanitized \r\n  "));
        Console.WriteLine("filter_html=" + Filter.Html("<script>alert('xss')</script>"));
        Console.WriteLine("filter_int=" + Convert.ToString(Filter.ToInt("42", 0)));
        Console.WriteLine("filter_long=" + Convert.ToString(Filter.ToLong("9876543210", 0)));
        Console.WriteLine("filter_bool=" + (Filter.ToBool("true", false) ? "true" : "false"));

        // 4. Csrf utilities
        Console.WriteLine("csrf_equal=" + (Csrf.ConstantTimeEquals("token123", "token123") ? "true" : "false"));
        Console.WriteLine("csrf_unequal=" + (Csrf.ConstantTimeEquals("token123", "token456") ? "true" : "false"));
        Console.WriteLine("csrf_auth=" + (Csrf.SameAuthority("https://example.com:443", "example.com") ? "true" : "false"));

        // 5. RobotsTxt
        RobotsTxt rob = RobotsTxt.Create();
        rob.Disallow("/admin");
        rob.Allow("/public");
        string robTxt = rob.ToText();
        Console.WriteLine("robots_has_admin=" + (robTxt.IndexOf("Disallow: /admin") >= 0 ? "true" : "false"));
        Console.WriteLine("robots_has_llms=" + (robTxt.IndexOf("llms.txt:") >= 0 ? "true" : "false"));

        // 6. Sitemap
        Sitemap sm = Sitemap.Create();
        sm.Add("https://example.com/home", "2026-10-17", "daily", "1.0");
        string smXml = sm.ToXml();
        Console.WriteLine("sitemap_has_home=" + (smXml.IndexOf("<loc>https://example.com/home</loc>") >= 0 ? "true" : "false"));

        // 7. LlmsTxt
        LlmsTxt llms = LlmsTxt.Create("Documentation Hub", "API reference for LLMs");
        llms.AddLink("Core", "Getting Started", "/docs/start", "Quickstart tutorial");
        string llmsMd = llms.ToMarkdown();
        Console.WriteLine("llms_has_title=" + (llmsMd.IndexOf("# Documentation Hub") >= 0 ? "true" : "false"));
        Console.WriteLine("llms_has_link=" + (llmsMd.IndexOf("Getting Started") >= 0 ? "true" : "false"));

        // 8. GeoSchema & GeoMeta
        GeoSchema schema = GeoSchema.Article("Zan Web Architecture", "High performance web subsystem", "Zan Team", "2026-10-17");
        string schemaJson = schema.ToJson();
        Console.WriteLine("schema_type=" + (schemaJson.IndexOf("\"@type\": \"TechArticle\"") >= 0 ? "true" : "false"));

        GeoMeta meta = GeoMeta.Create();
        meta.SetTitle("Zan Home").SetCanonical("https://example.com").AddSchema(schema);
        string head = meta.RenderHead();
        Console.WriteLine("head_has_canon=" + (head.IndexOf("rel=\"canonical\"") >= 0 ? "true" : "false"));

        // 9. WebApp pipeline & IDisposable
        WebApp app = new WebApp("127.0.0.1", 8080);
        app.Get("/ping", PingHandler);
        Console.WriteLine("app_routes_count=" + Convert.ToString(app.router.All().Count));
        app.Dispose();
        Console.WriteLine("app_disposed=true");
    }
}
