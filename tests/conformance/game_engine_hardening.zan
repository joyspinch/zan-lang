using System;
using System.Collections.Generic;
using Game.Arcade2D;
using Game.Board;
using Game.Cards;
using Game.Core;
using Game.Foundation;
using Game.Kit;
using Game.Idle;
using Game.Tactics;
using Game.Arpg;

namespace Tests.GameEngineHardening;

class Program {
    static void Main() {
        Console.WriteLine("=== Testing Game Engine Hardening ===");

        // 1. Arcade2D & Math
        Vector2 v = new Vector2(10.0, 20.0);
        v.Add(5.0, 5.0);
        Console.WriteLine("v=(" + Convert.ToString((int)v.X()) + "," + Convert.ToString((int)v.Y()) + ")");

        Rect2 r1 = new Rect2(0.0, 0.0, 10.0, 10.0);
        Rect2 r2 = new Rect2(5.0, 5.0, 10.0, 10.0);
        Console.WriteLine("rect_overlap=" + Convert.ToString(Collision2D.Rects(r1, r2)));

        Circle2 c1 = new Circle2(0.0, 0.0, 5.0);
        Circle2 c2 = new Circle2(8.0, 0.0, 5.0);
        Console.WriteLine("circle_overlap=" + Convert.ToString(Collision2D.Circles(c1, c2)));

        ArcadeWorld world = new ArcadeWorld();
        ArcadeEntity hero = world.Spawn(1, 1, 0.0, 0.0, 16.0, 16.0);
        hero.SetHealth(100);
        Console.WriteLine("hero_hp=" + Convert.ToString(hero.hp));

        // 2. SpriteBatch & Resource Lifecycle
        SpriteBatch batch = new SpriteBatch(64);
        batch.Begin(null);
        batch.DrawRect(10, 10, 32, 32, 0xFF00FF00);
        batch.DrawBall(50, 50, 10, 255, 0, 0, 255);
        batch.DrawGlow(100, 100, 20, 0, 0, 255, 128);
        Console.WriteLine("batch_count=" + Convert.ToString(batch.ItemCount()));
        batch.End();
        batch.Dispose();
        Console.WriteLine("batch_disposed=true");

        // 3. Board & Pathfinder
        GridPoint gp = GridPoint.At(3, 4);
        Console.WriteLine("gp=(" + Convert.ToString(gp.X()) + "," + Convert.ToString(gp.Y()) + ")");
        GridBoard board = new GridBoard(8, 8, 0);
        board.Set(3, 4, 1);
        Console.WriteLine("board_cell=" + Convert.ToString(board.Get(3, 4)));

        // 4. Cards & ActionQueue
        CardDefinition def = new CardDefinition("strike", "Strike", 1, "attack");
        CardDeck deck = new CardDeck(100);
        CardInstance card = deck.Add(def);
        if (card != null) {
            Console.WriteLine("card=" + card.Definition().Id() + ":cost=" + Convert.ToString(card.Definition().Cost()));
        }
        Console.WriteLine("deck_draw_count=" + Convert.ToString(deck.DrawPile().Count()));

        // 5. Core & Clocks
        GameClock clock = GameClock.Create60Hz();
        Console.WriteLine("clock_valid=" + Convert.ToString(clock.FixedDeltaTime > 0.01));

        // 6. Foundation & RNG
        DeterministicRandom rng = new DeterministicRandom(12345);
        int randVal = rng.NextBelow(100);
        Console.WriteLine("rng_valid=" + Convert.ToString(randVal >= 0 && randVal < 100));

        // 7. Idle & BigNum & Wallet
        string formatted = BigNum.Short(1234567L);
        Console.WriteLine("bignum_short=" + formatted);

        Wallet wallet = new Wallet();
        wallet.Define("gold", 10000);
        wallet.Add("gold", 250);
        Console.WriteLine("wallet_bal=" + Convert.ToString((int)wallet.Amount("gold")));

        // 8. Tactics
        Tower tower = new Tower(1, 1, 10.0, 10.0, 50.0, 1.0, 15.0, 100);
        Console.WriteLine("tower_dmg=" + Convert.ToString((int)tower.damage));

        // 9. Arpg Menu & Lifecycle
        ArpgMenu menu = new ArpgMenu("main_menu");
        menu.AddItem(new ArpgMenuItem("start", "Start Game", "payload_start"));
        menu.AddItem(new ArpgMenuItem("options", "Options", "payload_options"));
        Console.WriteLine("menu_items=" + Convert.ToString(menu.ItemCount()));
        menu.Dispose();
        Console.WriteLine("menu_disposed=true");

        ArpgMusic music = new ArpgMusic("bgm.ogg");
        music.Play();
        Console.WriteLine("music_state=" + Convert.ToString((int)music.State()));
        music.Dispose();
        Console.WriteLine("music_disposed=true");

        Console.WriteLine("=== Game Engine Hardening Verified ===");
    }
}
