// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
using System;
using System.Net.Http.Client;

class Program {
    static void Main() {
        // 接口数据协议与执行契约。
        // 接口数据协议与执行契约。
        CookieJar jar = new CookieJar();
        jar.SetCookie("www.example.com", "/", "a=1; Domain=example.com");
        Console.WriteLine("parentScope=" + Convert.ToString(jar.Count()));
        jar.SetCookie("example.com", "/", "a=1; Domain=example.com");
        Console.WriteLine("exactHost=" + jar.HeaderValue("example.com", "/", false));
        Console.WriteLine("childScope=" + jar.HeaderValue("www.example.com", "/", false));

        // 接口数据协议与执行契约。
        CookieJar j2 = new CookieJar();
        j2.SetCookie("attacker.com", "/", "sid=evil; Domain=example.com");
        Console.WriteLine("crossDomain=" + Convert.ToString(j2.Count()));
        Console.WriteLine("crossReplay=" + j2.HeaderValue("www.example.com", "/", false));

        // 接口数据协议与执行契约。
        CookieJar j3 = new CookieJar();
        j3.SetCookie("bank.com.evil.com", "/", "sid=evil; Domain=bank.com");
        Console.WriteLine("suffixConfusion=" + Convert.ToString(j3.Count()));

        // 接口数据协议与执行契约。
        CookieJar j4 = new CookieJar();
        j4.SetCookie("example.com", "/", "t=1; Domain=com");
        Console.WriteLine("tld=" + Convert.ToString(j4.Count()));

        CookieJar j7 = new CookieJar();
        j7.SetCookie("evil.co.uk", "/", "sid=evil; Domain=co.uk");
        Console.WriteLine("pslParent=" + Convert.ToString(j7.Count()));
        j7.SetCookie("co.uk", "/", "sid=evil; Domain=co.uk");
        Console.WriteLine("pslExact=" + j7.HeaderValue("co.uk", "/", false));
        Console.WriteLine("pslOther=" + j7.HeaderValue("bank.co.uk", "/", false));
        CookieJar j8 = new CookieJar();
        j8.SetCookie("evil.co.uk", "/", "sid=evil");
        Console.WriteLine("pslHostOnly=" + j8.HeaderValue("bank.co.uk", "/", false));

        // 核心契约与语义定义。
        CookieJar j5 = new CookieJar();
        j5.SetCookie("10.0.0.1", "/", "i=1; Domain=10.0.0.1");
        Console.WriteLine("ip=" + Convert.ToString(j5.Count()));

        // 接口数据协议与执行契约。
        CookieJar j6 = new CookieJar();
        j6.SetCookie("shop.example.com", "/", "host=1");
        Console.WriteLine("hostOnly=" + j6.HeaderValue("shop.example.com", "/", false)
            + " near=" + Convert.ToString(j6.HeaderValue("other.example.com", "/", false).Length));
    }
}
