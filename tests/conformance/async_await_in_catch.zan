using System;

/* await inside a catch block: the caught exception and its ownership flag are
 * frame-resident, so the catch epilogue still sees them after the suspension
 * that the await introduces. */
class Program {
    static void Boom(int i) { throw new Exception("boom" + Convert.ToString(i)); }

    static async int Bump(int x) {
        await Task.Delay(1);
        return x + 1;
    }

    static async int Run() {
        int total = 0;
        for (int i = 0; i < 3; i = i + 1) {
            try {
                Boom(i);
            } catch (Exception e) {
                Console.WriteLine("caught " + e.Message);
                total = await Bump(total);
            }
        }
        try {
            Boom(9);
        } catch (Exception e) {
            total = await Bump(total);
            Console.WriteLine("late " + e.Message);
        }
        return total;
    }

    static async void Main() {
        Console.WriteLine("total=" + Convert.ToString(await Run()));
    }
}
