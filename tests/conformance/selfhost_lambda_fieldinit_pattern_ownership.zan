using System;
using System.Collections.Generic;
using System.Threading.Tasks;

namespace SelfhostLambdaFieldInitPatternOwnership;

class Box {
    public int Val;
    public string Name;
    public Box(int v) { this.Val = v; this.Name = "b_" + v.ToString(); }
    public int ThrowIntProp {
        get { throw new Exception("int_get_boom"); }
        set { throw new Exception("int_set_boom"); }
    }
}

class BadFieldObj {
    public Box Keep = new Box(1);
    public int Bad = new Box(2).ThrowIntProp;
}

class BaseBoom {
    public Box BaseB;
    public BaseBoom(Box b) {
        this.BaseB = b;
        throw new Exception("base_boom");
    }
}

class DerivedBoom : BaseBoom {
    public Box DerB = new Box(1);
    public DerivedBoom() : base(new Box(2)) { }
}

class ThisBoom {
    public Box B;
    public ThisBoom(Box b) {
        this.B = b;
        throw new Exception("this_boom");
    }
    public ThisBoom() : this(new Box(3)) { }
}

class InitObj {
    public Box A;
    public List<Box> Items = new List<Box>();
    public Box ThrowProp {
        get { return this.A; }
        set { throw new Exception("prop_set_boom"); }
    }
}

class StaticInitHolder {
    public static Box Good = new Box(7);
    public static string Tag = "st_" + new Box(3).Name;
}

class Program {
    static Box MakeBox(int v) { return new Box(v); }
    static object MakeObjBox(int v) { return new Box(v); }
    static string MakeStr(int v) { return "s_" + v.ToString(); }
    static InitObj MakeInitObj() { return new InitObj(); }
    static Box BoomBox() { throw new Exception("boom_box"); }
    static int BoomInt() { throw new Exception("boom_int"); }

    static int InvokeWithBox(Box b, Func<int> f) {
        return b.Val + f();
    }

    static int TakeParams(params Box[] items) {
        int s = 0;
        for (int i = 0; i < items.Length; i = i + 1) { s = s + items[i].Val; }
        return s;
    }

    static async Task<Box> AsyncBoxTask(int v) {
        await Task.Delay(1);
        return new Box(v);
    }

    static async Task<Box> AsyncBoomBoxTask() {
        await Task.Delay(1);
        throw new Exception("async_boom");
    }

    static int TestLambdas() {
        int acc = 0;
        Func<int> f1 = () => MakeBox(1).ThrowIntProp;
        try { acc = acc + f1(); } catch (Exception e) { acc = acc + e.Message.Length; }

        Action a1 = () => { int x = MakeBox(1).ThrowIntProp; };
        try { a1(); } catch (Exception e) { acc = acc + e.Message.Length; }

        try {
            acc = acc + InvokeWithBox(MakeBox(3), () => MakeBox(4).ThrowIntProp);
        } catch (Exception e) { acc = acc + e.Message.Length; }

        acc = acc + InvokeWithBox(MakeBox(3), () => MakeBox(4).Val + MakeBox(5).Name.Length);
        return acc;
    }

    static int TestFieldAndCtorThrows() {
        int acc = StaticInitHolder.Good.Val + StaticInitHolder.Tag.Length;
        try {
            BadFieldObj o = new BadFieldObj();
            acc = acc + o.Keep.Val;
        } catch (Exception e) { acc = acc + e.Message.Length; }
        try {
            DerivedBoom o = new DerivedBoom();
            acc = acc + o.DerB.Val;
        } catch (Exception e) { acc = acc + e.Message.Length; }
        try {
            ThisBoom o = new ThisBoom();
            acc = acc + o.B.Val;
        } catch (Exception e) { acc = acc + e.Message.Length; }
        return acc;
    }

    static int TestInitializersAndParams() {
        int acc = 0;
        try {
            InitObj o = new InitObj { A = MakeBox(1), ThrowProp = MakeBox(2) };
            acc = acc + o.A.Val;
        } catch (Exception e) { acc = acc + e.Message.Length; }
        try {
            InitObj o = new InitObj { Items = { MakeBox(1), BoomBox() } };
            acc = acc + o.Items.Count;
        } catch (Exception e) { acc = acc + e.Message.Length; }
        try {
            InitObj o = MakeInitObj() { A = MakeBox(1), ThrowProp = MakeBox(2) };
            acc = acc + o.A.Val;
        } catch (Exception e) { acc = acc + e.Message.Length; }
        try {
            Box[] arr = new Box[] { MakeBox(1), BoomBox() };
            acc = acc + arr.Length;
        } catch (Exception e) { acc = acc + e.Message.Length; }
        try {
            List<Box> ls = new List<Box> { MakeBox(1), BoomBox() };
            acc = acc + ls.Count;
        } catch (Exception e) { acc = acc + e.Message.Length; }
        try {
            Dictionary<string, Box> d = new Dictionary<string, Box> { { MakeStr(1), BoomBox() } };
            acc = acc + d.Count;
        } catch (Exception e) { acc = acc + e.Message.Length; }
        try {
            acc = acc + TakeParams(MakeBox(1), BoomBox());
        } catch (Exception e) { acc = acc + e.Message.Length; }
        return acc;
    }

    static async Task<int> TestAsyncSwitchPatterns() {
        int acc = 0;
        try {
            Box r = MakeObjBox(5) switch {
                Box b when b.Val == BoomInt() => MakeBox(1),
                _ => MakeBox(2)
            };
            await Task.Delay(1);
            acc = acc + r.Val;
        } catch (Exception e) {
            await Task.Delay(1);
            acc = acc + e.Message.Length;
        }
        try {
            Box r = MakeObjBox(5) switch {
                Box b => BoomBox(),
                _ => MakeBox(2)
            };
            await Task.Delay(1);
            acc = acc + r.Val;
        } catch (Exception e) {
            await Task.Delay(1);
            acc = acc + e.Message.Length;
        }
        Box ok = MakeObjBox(5) switch {
            Box b when b.Val == 99 => MakeBox(1),
            Box b => MakeBox(b.Val + 1),
            _ => MakeBox(2)
        };
        await Task.Delay(1);
        acc = acc + ok.Val + ok.Name.Length;
        return acc;
    }

    static async Task<int> TestWhenAllThrow() {
        try {
            List<long> hs = new List<long>();
            hs.Add(Task.Spawn(AsyncBoxTask(1)));
            hs.Add(Task.Spawn(AsyncBoomBoxTask()));
            await Task.WhenAll(hs);
            return 1;
        } catch (Exception e) {
            await Task.Delay(1);
            return e.Message.Length;
        }
    }

    static int TestNullStringHash() {
        string ns = null;
        return ns.GetHashCode();
    }

    static void Main() {
        Console.WriteLine("lambdas=" + TestLambdas().ToString());
        Console.WriteLine("fieldCtor=" + TestFieldAndCtorThrows().ToString());
        Console.WriteLine("inits=" + TestInitializersAndParams().ToString());
        Console.WriteLine("asyncSwitchPat=" + (await TestAsyncSwitchPatterns()).ToString());
        Console.WriteLine("whenAll=" + (await TestWhenAllThrow()).ToString());
        Console.WriteLine("nullHash=" + TestNullStringHash().ToString());
    }
}
