using System;
using System.Net.Sockets;
using System.Threading;

class Program {
    static int PORT = 19527;
    static string receivedMessage = "";
    static bool serverDone = false;

    static async void ServerTask(TcpListener listener) {
        TcpClient client = await listener.AcceptTcpClientAsync();
        if (client != null) {
            string msg = await client.RecvAsync(1024);
            Program.receivedMessage = msg;
            await client.SendAsync("PONG");
            client.Dispose();
        }
        Program.serverDone = true;
    }

    static async int Run() {
        Socket.Initialize();
        TcpListener listener = new TcpListener("127.0.0.1", PORT);
        listener.Start();

        Task.Spawn(ServerTask(listener));
        await Task.Delay(20);

        TcpClient client = await TcpClient.ConnectAsync("127.0.0.1", PORT);
        if (client != null) {
            await client.SendAsync("PING");
            string resp = await client.RecvAsync(1024);
            Console.WriteLine("client_recv=" + resp);
            client.Dispose();
        }

        while (!Program.serverDone) {
            await Task.Delay(10);
        }

        Console.WriteLine("server_recv=" + Program.receivedMessage);
        listener.Dispose();
        Socket.Cleanup();
        return 0;
    }

    static async void Main() {
        await Program.Run();
        Console.WriteLine("ok");
    }
}
