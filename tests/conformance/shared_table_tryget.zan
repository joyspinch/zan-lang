using System;
using System.Threading;

// SharedTable.TryGetInt/TryGetIntAt：命中回 true 并写出；键/列缺失
// 回 false 且 value=0；0 值本身命中时回 true（与 GetInt 的 0 歧义
// 区分开）。
class Program {
    static void Main() {
        string name = "zan_conformance_tryget";
        SharedTable stale = SharedTable.Open(name);
        if (stale.IsOpen()) {
            stale.Destroy();
        }

        SharedTable table = new SharedTable(name, 8);
        table.ColumnInt("n");
        if (!table.Create()) {
            Console.WriteLine("create: 0");
            return;
        }
        Console.WriteLine("create: 1");

        table.SetInt("row", "n", 42);
        long v;
        bool ok = table.TryGetInt("row", "n", out v);
        Console.WriteLine("hit: " + Convert.ToString(ok ? 1 : 0) + " v=" + Convert.ToString(v));

        // 键不存在
        long miss;
        bool okMiss = table.TryGetInt("no-such-key", "n", out miss);
        Console.WriteLine("miss-key: " + Convert.ToString(okMiss ? 1 : 0) + " v=" + Convert.ToString(miss));

        // 列不存在
        bool okCol = table.TryGetInt("row", "no-such-col", out miss);
        Console.WriteLine("miss-col: " + Convert.ToString(okCol ? 1 : 0));

        // 值恰好是 0：与 GetInt 的歧义区分
        table.SetInt("zero", "n", 0);
        long z;
        bool okZero = table.TryGetInt("zero", "n", out z);
        Console.WriteLine("zero: " + Convert.ToString(okZero ? 1 : 0) + " v=" + Convert.ToString(z));

        // 负值往返
        table.SetInt("neg", "n", -7);
        long n;
        table.TryGetInt("neg", "n", out n);
        Console.WriteLine("neg: " + Convert.ToString(n));

        // 按哈希变体
        long hash = SharedTable.Hash("row");
        table.SetIntAt(hash, "n", 99);
        long ha;
        bool okAt = table.TryGetIntAt(hash, "n", out ha);
        Console.WriteLine("at: " + Convert.ToString(okAt ? 1 : 0) + " v=" + Convert.ToString(ha));
        long missAt;
        bool okAtMiss = table.TryGetIntAt(SharedTable.Hash("ghost"), "n", out missAt);
        Console.WriteLine("at-miss: " + Convert.ToString(okAtMiss ? 1 : 0));

        // GetInt 与 TryGetIntAt 同源（"row" 行此时已被 SetIntAt 写成 99）
        Console.WriteLine("consistent: " + Convert.ToString(table.GetInt("row", "n") == ha ? 1 : 0));

        table.Dispose();
        SharedTable.Open(name).Destroy();
    }
}
