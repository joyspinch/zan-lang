// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
using System;
using System.Threading;

class Prog {
    static BlockingQueue<string> q;
    static AtomicInt woke;   // 0 = dequeue still blocked, 1 = woken with empty
    static BlockingQueue<string> bq;

    static void Canceller() {
        Thread.Sleep(50);
        Prog.q.Cancel();
    }

    static void BqCanceller() {
        Thread.Sleep(50);
        Prog.bq.Cancel();
    }

    static void Main() {
        // 接口数据协议与执行契约。
        BlockingQueue<string> fq = new BlockingQueue<string>("", 0);
        fq.Enqueue("a");
        fq.Enqueue("b");
        fq.CompleteWithFault("disk full");
        string a = fq.Dequeue();
        string b = fq.Dequeue();
        string e = fq.Dequeue();
        Console.WriteLine("drained: " + a + b + "|" + e);
        Console.WriteLine("fault: " + fq.GetFault());
        Console.WriteLine("closed: " + Convert.ToString(fq.IsCompleted() ? 1 : 0));
        Console.WriteLine("enq-after: " + Convert.ToString(fq.Enqueue("x") ? 1 : 0));
        fq.Dispose();

        // 核心契约与语义定义。
        Prog.q = new BlockingQueue<string>("", 0);
        Prog.woke = new AtomicInt(0);
        Thread.Start(Prog.Canceller);
        string v = Prog.q.Dequeue();   // parks until the canceller wakes it
        Prog.woke.Store(v == "" ? 1 : 0);
        while (Prog.woke.Load() == 0) { Thread.Sleep(1); }
        Console.WriteLine("cancel-wake: " + Convert.ToString(Prog.q.IsCanceled() ? 1 : 0));
        Console.WriteLine("cancel-fault: [" + Prog.q.GetFault() + "]");
        Prog.q.Dispose();

        // 核心契约与语义定义。
        BlockingQueue<string> dq = new BlockingQueue<string>("", 0);
        dq.Enqueue("keep?");
        dq.Cancel();
        string gone = dq.Dequeue();
        Console.WriteLine("dropped: [" + gone + "]");
        Console.WriteLine("cancel-completed: " + Convert.ToString(dq.IsCompleted() ? 1 : 0));
        dq.Dispose();

        // 接口数据协议与执行契约。
        Prog.bq = new BlockingQueue<string>("", 1);
        Prog.bq.Enqueue("full");
        Thread.Start(Prog.BqCanceller);
        bool enq = Prog.bq.Enqueue("blocked");   // false once cancel wakes it
        Console.WriteLine("bounded-enq: " + Convert.ToString(enq ? 1 : 0));
        Prog.bq.Dispose();
    }
}
