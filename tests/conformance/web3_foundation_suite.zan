using System;
using System.Security.Cryptography;
using Zan.Web3.Cryptography;
using Zan.Web3.Types;
using Zan.Web3.Encoding;
using Zan.Web3.Rpc;

class Program {
    static void Main() {
        // 1. Keccak-256
        string emptyKeccak = Keccak256.HashHex("");
        Console.WriteLine("keccak empty: " + (emptyKeccak == "c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470").ToString());

        // 2. Secp256k1 公钥派生与地址生成 (私钥 d = 1)
        byte[] priv1 = new byte[32];
        priv1[31] = 1;
        byte[] pubRaw = Secp256k1.GetPublicKeyRaw(priv1);
        Console.WriteLine("secp256k1 valid pub: " + Secp256k1.VerifyPublicKey(pubRaw).ToString());

        Address addr1 = Address.FromPrivateKey(priv1);
        Console.WriteLine("addr1 lower: " + (addr1.ToLowerHex() == "0x7e5f4552091a69125d5dfcb7b8c2659029395bdf").ToString());

        // 3. EIP-55 校验和地址
        string testEip55 = "0x5aaeb6053f3e94c9b9a09f33669435e7ef1beaed";
        Address addrEip = Address.Parse(testEip55);
        string checksum = addrEip.ToChecksumAddress();
        Console.WriteLine("eip55 checksum: " + (checksum == "0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed").ToString());
        Console.WriteLine("eip55 valid: " + Address.IsValidChecksum("0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed").ToString());

        // 4. RLP 编码
        byte[] rlpEmpty = Rlp.Encode(RlpItem.FromString(""));
        Console.WriteLine("rlp empty: " + (Hex.Encode(rlpEmpty, rlpEmpty.Length) == "80").ToString());

        byte[] rlpDog = Rlp.Encode(RlpItem.FromString("dog"));
        Console.WriteLine("rlp dog: " + (Hex.Encode(rlpDog, rlpDog.Length) == "83646f67").ToString());

        List<RlpItem> list = new List<RlpItem>();
        list.Add(RlpItem.FromString("cat"));
        list.Add(RlpItem.FromString("dog"));
        byte[] rlpList = Rlp.Encode(RlpItem.FromList(list));
        Console.WriteLine("rlp list: " + (Hex.Encode(rlpList, rlpList.Length) == "c88363617483646f67").ToString());

        // 5. ABI 函数选择器与调用构造
        string selTransfer = Abi.GetFunctionSelectorHex("transfer(address,uint256)");
        Console.WriteLine("abi transfer selector: " + (selTransfer == "a9059cbb").ToString());

        string selBalanceOf = Abi.GetFunctionSelectorHex("balanceOf(address)");
        Console.WriteLine("abi balanceOf selector: " + (selBalanceOf == "70a08231").ToString());

        string selTotalSupply = Abi.GetFunctionSelectorHex("totalSupply()");
        Console.WriteLine("abi totalSupply selector: " + (selTotalSupply == "18160ddd").ToString());

        Address vitalik = Address.Parse("0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045");
        byte[] calldata = Abi.EncodeErc20BalanceOf(vitalik);
        Console.WriteLine("calldata len: " + calldata.Length.ToString());

        // 6. JSON-RPC 构造
        string rpcBlock = JsonRpcBuilder.BlockNumber(1);
        Console.WriteLine("rpc block: " + (rpcBlock == "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_blockNumber\",\"params\":[]}").ToString());

        string rpcBal = JsonRpcBuilder.GetBalance(vitalik, "latest", 2);
        Console.WriteLine("rpc balance: " + (rpcBal == "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"eth_getBalance\",\"params\":[\"0xd8da6bf26964af9d7eed9e03e53415d37aa96045\",\"latest\"]}").ToString());

        Console.WriteLine("ALL WEB3 SUITE TESTS PASSED");
    }
}
