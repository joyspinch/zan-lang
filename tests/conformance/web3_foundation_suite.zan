using System;
using System.Security.Cryptography;
using Zan.Web3.Types;
using Zan.Web3.Encoding;
using Zan.Web3.Rpc;

class Program {
    static void Main() {
        // 1. Account 构建与地址派生 (私钥 d = 1)
        byte[] priv1 = new byte[32];
        priv1[31] = 1;
        Account account = Account.FromPrivateKey(priv1);
        Console.WriteLine("account addr: " + (account.Address.ToLowerHex() == "0x7e5f4552091a69125d5dfcb7b8c2659029395bdf").ToString());

        // 2. EIP-55 校验和格式化与检查
        string testEip55 = "0x5aaeb6053f3e94c9b9a09f33669435e7ef1beaed";
        Address addrEip = Address.Parse(testEip55);
        Console.WriteLine("eip55 checksum: " + (addrEip.ToChecksumAddress() == "0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed").ToString());
        Console.WriteLine("eip55 valid: " + Address.IsValidChecksum("0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed").ToString());

        // 3. 以太坊个人消息签名与验签 (EIP-191 Personal Sign)
        string testMsg = "Hello Zan Web3!";
        string sigHex = account.SignMessage(testMsg);
        if (sigHex != null) {
            Console.WriteLine("personal sig len: " + sigHex.Length.ToString());
            bool verifyOk = Account.VerifyMessage(testMsg, sigHex, account.Address);
            Console.WriteLine("personal verify ok: " + verifyOk.ToString());
        }

        // 4. ecrecover 底层原语直接调用验证
        byte[] rawHash = Keccak256.Hash("direct_hash_for_ecrecover");
        Secp256k1Signature rawSig = Secp256k1.Sign(rawHash, priv1);
        Address recovered = Address.Recover(rawHash, rawSig);
        if (recovered != null) {
            Console.WriteLine("ecrecover ok: " + account.Address.Equals(recovered).ToString());
        }

        // 5. EIP-1559 现代动态费用交易离线签名
        Transaction tx = new Transaction();
        tx.ChainId = 1; // Ethereum Mainnet
        tx.Nonce = 5;
        tx.GasLimit = 21000;
        tx.To = Address.Parse("0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045");
        tx.Value = EtherUnit.FromGwei(100000000); // 0.1 ETH
        tx.MaxPriorityFeePerGas = EtherUnit.FromGwei(2);
        tx.MaxFeePerGas = EtherUnit.FromGwei(30);

        string rawTxHex = account.SignTransaction(tx);
        if (rawTxHex != null) {
            Console.WriteLine("raw tx starts with 0x02: " + rawTxHex.StartsWith("0x02").ToString());
            Console.WriteLine("raw tx len > 100: " + (rawTxHex.Length > 100).ToString());
        }

        // 6. ABI 解码器验证 (智能合约返回值反序列化)
        byte[] encodedUint = Abi.EncodeUint256(1000);
        BigInt decodedUint = Abi.DecodeUint256(encodedUint, 0);
        Console.WriteLine("abi decode uint256: " + (decodedUint.limb(0) == 1000).ToString());

        byte[] encodedBool = Abi.EncodeBool(true);
        Console.WriteLine("abi decode bool: " + Abi.DecodeBool(encodedBool, 0).ToString());

        Address expectedContract = Address.Parse("0x1f9840a85d5aF5bf1D1762F925BDADdC4201F984");
        byte[] encodedAddr = Abi.EncodeAddress(expectedContract);
        Address decodedAddr = Abi.DecodeAddress(encodedAddr, 0);
        Console.WriteLine("abi decode addr: " + expectedContract.Equals(decodedAddr).ToString());

        // 7. EIP-712 结构化数据签名与校验 (DeFi Permit/授权规范)
        Eip712Domain domain = new Eip712Domain("Uniswap V2", "1", 1, expectedContract);
        byte[] dummyStructHash = Keccak256.Hash("Permit(address owner,address spender,uint256 value)");
        string typedSigHex = account.SignTypedData(domain, dummyStructHash);
        bool typedVerifyOk = Account.VerifyTypedData(domain, dummyStructHash, typedSigHex, account.Address);
        Console.WriteLine("eip712 verify ok: " + typedVerifyOk.ToString());

        // 8. BIP-39 助记词生成与钱包账户派生
        string mnemonic = Mnemonic.GenerateMnemonic();
        List<string> words = mnemonic.Split(' ');
        Console.WriteLine("mnemonic 12 words: " + (words.Count == 12).ToString());

        Account hdAccount = Account.FromMnemonic(mnemonic, "");
        if (hdAccount != null) {
            Console.WriteLine("hd wallet valid addr: " + (!hdAccount.Address.Equals(Address.Zero)).ToString());
        }

        // 9. RLP 编码与 JSON-RPC
        byte[] rlpDog = Rlp.Encode(RlpItem.FromString("dog"));
        Console.WriteLine("rlp dog: " + (Hex.Encode(rlpDog, rlpDog.Length) == "83646f67").ToString());

        string rpcBlock = JsonRpcBuilder.BlockNumber(1);
        Console.WriteLine("rpc block: " + (rpcBlock == "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_blockNumber\",\"params\":[]}").ToString());

        // 10. Web3Client 与 JSON-RPC 高阶调用
        MockRpcTransport mockTransport = new MockRpcTransport();
        mockTransport.MockResponse = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\"0x10\"}";
        Web3Client client = new Web3Client("https://eth.llamarpc.com:443", mockTransport);
        long blockNum = client.GetBlockNumber();
        Console.WriteLine("client get block: " + (blockNum == 16).ToString());

        // 11. 链上事件日志模型与 EventLogDecoder
        Address sender = Address.Parse("0x1111111111111111111111111111111111111111");
        Address receiver = Address.Parse("0x2222222222222222222222222222222222222222");
        EventLog log = new EventLog();
        log.Address = expectedContract;
        log.Topics.Add(EventLogDecoder.Erc20TransferTopic0);
        log.Topics.Add("0x0000000000000000000000001111111111111111111111111111111111111111");
        log.Topics.Add("0x0000000000000000000000002222222222222222222222222222222222222222");
        log.Data = Abi.EncodeUint256(5000000);

        Erc20TransferEvent transferEvt = EventLogDecoder.DecodeTransfer(log);
        if (transferEvt != null) {
            Console.WriteLine("event decode transfer from: " + sender.Equals(transferEvt.From).ToString());
            Console.WriteLine("event decode transfer to: " + receiver.Equals(transferEvt.To).ToString());
            Console.WriteLine("event decode transfer val: " + (transferEvt.Value.limb(0) == 5000000).ToString());
        }

        // 12. Keystore V3 密码学密文持久化与解密恢复
        string pass = "ZanWeb3StrongSecret@2026";
        string keystoreJson = KeystoreV3.Encrypt(account, pass, 2048);
        if (keystoreJson != null) {
            Console.WriteLine("keystore json contains version 3: " + (keystoreJson.IndexOf("\"version\": 3") >= 0).ToString());
            Account decryptedAcc = KeystoreV3.Decrypt(keystoreJson, pass);
            if (decryptedAcc != null) {
                Console.WriteLine("keystore decrypt matches: " + account.Address.Equals(decryptedAcc.Address).ToString());
            }

            // 错误口令解密拦截
            Account badAcc = KeystoreV3.Decrypt(keystoreJson, "WrongPassword123");
            Console.WriteLine("keystore bad pass rejected: " + (badAcc == null).ToString());
        }

        // 13. BIP-32 / BIP-44 分层确定性 HD 钱包多子账户派生
        Account acc0 = Account.FromMnemonic(mnemonic, "", 0);
        Account acc1 = Account.FromMnemonic(mnemonic, "", 1);
        if (acc0 != null && acc1 != null) {
            Console.WriteLine("hd acc0 valid: " + (!acc0.Address.Equals(Address.Zero)).ToString());
            Console.WriteLine("hd acc1 valid: " + (!acc1.Address.Equals(Address.Zero)).ToString());
            Console.WriteLine("hd acc0 != acc1: " + (!acc0.Address.Equals(acc1.Address)).ToString());
        }

        Console.WriteLine("ALL ADVANCED WEB3 INFRASTRUCTURE TESTS PASSED");
    }
}
