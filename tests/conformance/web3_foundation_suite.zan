using System;
using System.Security.Cryptography;
using Zan.Web3.Types;
using Zan.Web3.Encoding;
using Zan.Web3.Rpc;
using Zan.Web3.Chains;
using Zan.Web3.Contracts;
using Zan.Web3.Dex;
using Zan.Web3.AccountAbstraction;

class Program {
    static void Main() {
        // 1. Account 构建与地址派生 (私钥 d = 1)
        byte[] priv1 = new byte[32];
        priv1[31] = 1;
        Account account = Account.FromPrivateKey(priv1);
        Console.WriteLine("account addr: " + (account.Address.ToLowerHex() == "0x7e5f4552091a69125d5dfcb7b8c2659029395bdf").ToString());

        // 2. EIP-55 校验和格式化与检查
        string testEip55 = "0x5aaeb6053f3e94c9b9a09f33669435e7ef1beaed";
        Address addrEip = Address.Parse(testEip55);
        Console.WriteLine("eip55 checksum: " + (addrEip.ToChecksumAddress() == "0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed").ToString());
        Console.WriteLine("eip55 valid: " + Address.IsValidChecksum("0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed").ToString());

        // 3. 以太坊个人消息签名与验签 (EIP-191 Personal Sign)
        string testMsg = "Hello Zan Web3!";
        string sigHex = account.SignMessage(testMsg);
        if (sigHex != null) {
            Console.WriteLine("personal sig len: " + sigHex.Length.ToString());
            bool verifyOk = Account.VerifyMessage(testMsg, sigHex, account.Address);
            Console.WriteLine("personal verify ok: " + verifyOk.ToString());
        }

        // 4. ecrecover 底层原语直接调用验证
        byte[] rawHash = Keccak256.Hash("direct_hash_for_ecrecover");
        Secp256k1Signature rawSig = Secp256k1.Sign(rawHash, priv1);
        Address recovered = Address.Recover(rawHash, rawSig);
        if (recovered != null) {
            Console.WriteLine("ecrecover ok: " + account.Address.Equals(recovered).ToString());
        }

        // 5. EIP-1559 现代动态费用交易离线签名
        Transaction tx = new Transaction();
        tx.ChainId = 1; // Ethereum Mainnet
        tx.Nonce = 5;
        tx.GasLimit = 21000;
        tx.To = Address.Parse("0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045");
        tx.Value = EtherUnit.FromGwei(100000000); // 0.1 ETH
        tx.MaxPriorityFeePerGas = EtherUnit.FromGwei(2);
        tx.MaxFeePerGas = EtherUnit.FromGwei(30);

        string rawTxHex = account.SignTransaction(tx);
        if (rawTxHex != null) {
            Console.WriteLine("raw tx starts with 0x02: " + rawTxHex.StartsWith("0x02").ToString());
            Console.WriteLine("raw tx len > 100: " + (rawTxHex.Length > 100).ToString());
        }

        // 6. ABI 解码器验证 (智能合约返回值反序列化)
        byte[] encodedUint = Abi.EncodeUint256(1000);
        BigInt decodedUint = Abi.DecodeUint256(encodedUint, 0);
        Console.WriteLine("abi decode uint256: " + (decodedUint.limb(0) == 1000).ToString());

        byte[] encodedBool = Abi.EncodeBool(true);
        Console.WriteLine("abi decode bool: " + Abi.DecodeBool(encodedBool, 0).ToString());

        Address expectedContract = Address.Parse("0x1f9840a85d5aF5bf1D1762F925BDADdC4201F984");
        byte[] encodedAddr = Abi.EncodeAddress(expectedContract);
        Address decodedAddr = Abi.DecodeAddress(encodedAddr, 0);
        Console.WriteLine("abi decode addr: " + expectedContract.Equals(decodedAddr).ToString());

        // 7. EIP-712 结构化数据签名与校验 (DeFi Permit/授权规范)
        Eip712Domain domain = new Eip712Domain("Uniswap V2", "1", 1, expectedContract);
        byte[] dummyStructHash = Keccak256.Hash("Permit(address owner,address spender,uint256 value)");
        string typedSigHex = account.SignTypedData(domain, dummyStructHash);
        bool typedVerifyOk = Account.VerifyTypedData(domain, dummyStructHash, typedSigHex, account.Address);
        Console.WriteLine("eip712 verify ok: " + typedVerifyOk.ToString());

        // 8. BIP-39 助记词生成与钱包账户派生
        string mnemonic = Mnemonic.GenerateMnemonic();
        List<string> words = mnemonic.Split(' ');
        Console.WriteLine("mnemonic 12 words: " + (words.Count == 12).ToString());

        Account hdAccount = Account.FromMnemonic(mnemonic, "");
        if (hdAccount != null) {
            Console.WriteLine("hd wallet valid addr: " + (!hdAccount.Address.Equals(Address.Zero)).ToString());
        }

        // 9. RLP 编码与 JSON-RPC
        byte[] rlpDog = Rlp.Encode(RlpItem.FromString("dog"));
        Console.WriteLine("rlp dog: " + (Hex.Encode(rlpDog, rlpDog.Length) == "83646f67").ToString());

        string rpcBlock = JsonRpcBuilder.BlockNumber(1);
        Console.WriteLine("rpc block: " + (rpcBlock == "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_blockNumber\",\"params\":[]}").ToString());

        // 10. Web3Client 与 JSON-RPC 高阶调用
        MockRpcTransport mockTransport = new MockRpcTransport();
        mockTransport.MockResponse = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\"0x10\"}";
        Web3Client client = new Web3Client("https://eth.llamarpc.com:443", mockTransport);
        long blockNum = client.GetBlockNumber();
        Console.WriteLine("client get block: " + (blockNum == 16).ToString());

        // 11. 链上事件日志模型与 EventLogDecoder
        Address sender = Address.Parse("0x1111111111111111111111111111111111111111");
        Address receiver = Address.Parse("0x2222222222222222222222222222222222222222");
        EventLog log = new EventLog();
        log.Address = expectedContract;
        log.Topics.Add(EventLogDecoder.Erc20TransferTopic0);
        log.Topics.Add("0x0000000000000000000000001111111111111111111111111111111111111111");
        log.Topics.Add("0x0000000000000000000000002222222222222222222222222222222222222222");
        log.Data = Abi.EncodeUint256(5000000);

        Erc20TransferEvent transferEvt = EventLogDecoder.DecodeTransfer(log);
        if (transferEvt != null) {
            Console.WriteLine("event decode transfer from: " + sender.Equals(transferEvt.From).ToString());
            Console.WriteLine("event decode transfer to: " + receiver.Equals(transferEvt.To).ToString());
            Console.WriteLine("event decode transfer val: " + (transferEvt.Value.limb(0) == 5000000).ToString());
        }

        // 12. Keystore V3 密码学密文持久化与解密恢复
        string pass = "ZanWeb3StrongSecret@2026";
        string keystoreJson = KeystoreV3.Encrypt(account, pass, 2048);
        if (keystoreJson != null) {
            Console.WriteLine("keystore json contains version 3: " + (keystoreJson.IndexOf("\"version\": 3") >= 0).ToString());
            Account decryptedAcc = KeystoreV3.Decrypt(keystoreJson, pass);
            if (decryptedAcc != null) {
                Console.WriteLine("keystore decrypt matches: " + account.Address.Equals(decryptedAcc.Address).ToString());
            }

            // 错误口令解密拦截
            Account badAcc = KeystoreV3.Decrypt(keystoreJson, "WrongPassword123");
            Console.WriteLine("keystore bad pass rejected: " + (badAcc == null).ToString());
        }

        // 13. BIP-32 / BIP-44 分层确定性 HD 钱包多子账户派生
        Account acc0 = Account.FromMnemonic(mnemonic, "", 0);
        Account acc1 = Account.FromMnemonic(mnemonic, "", 1);
        if (acc0 != null && acc1 != null) {
            Console.WriteLine("hd acc0 valid: " + (!acc0.Address.Equals(Address.Zero)).ToString());
            Console.WriteLine("hd acc1 valid: " + (!acc1.Address.Equals(Address.Zero)).ToString());
            Console.WriteLine("hd acc0 != acc1: " + (!acc0.Address.Equals(acc1.Address)).ToString());
        }

        // 14. 多链网络配置库 (Chain Presets)
        Console.WriteLine("chain mainnet id: " + (Chain.Mainnet.ChainId == 1).ToString());
        Console.WriteLine("chain arb id: " + (Chain.Arbitrum.ChainId == 42161).ToString());
        Console.WriteLine("chain polygon name: " + (Chain.FromId(137).Name == "Polygon PoS").ToString());
        Console.WriteLine("chain tx url: " + (Chain.Mainnet.GetTxUrl("0x123") == "https://etherscan.io/tx/0x123").ToString());

        // 15. 智能合约门面 (Contract) 与强类型 ERC-20 代币包装器 (Erc20Token)
        MockRpcTransport tokenMock = new MockRpcTransport();
        // 模拟返回 32 字节 uint256 余额 = 8888
        byte[] mockBalSlot = Abi.EncodeUint256(8888);
        string mockBalHex = "0x" + Hex.Encode(mockBalSlot, 32);
        tokenMock.MockResponse = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\"" + mockBalHex + "\"}";

        Web3Client tokenClient = new Web3Client("http://127.0.0.1:8545", tokenMock);
        Erc20Token usdcToken = new Erc20Token(expectedContract, tokenClient, 1);
        BigInt usdcBalance = usdcToken.BalanceOf(account.Address);
        Console.WriteLine("erc20 token balance: " + (usdcBalance.limb(0) == 8888).ToString());

        // 模拟转账交易广播
        tokenMock.MockResponse = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\"0x9876543210abcdef9876543210abcdef9876543210abcdef9876543210abcdef\"}";
        string txHash = usdcToken.Transfer(account, receiver, 1000);
        Console.WriteLine("erc20 token transfer tx: " + (txHash == "0x9876543210abcdef9876543210abcdef9876543210abcdef9876543210abcdef").ToString());

        // 16. ERC-721 NFT 智能合约包装器 (Erc721Token)
        Erc721Token nft = new Erc721Token(expectedContract, tokenClient, 1);
        tokenMock.MockResponse = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\"0x0000000000000000000000001111111111111111111111111111111111111111\"}";
        Address nftOwner = nft.OwnerOf(1);
        Console.WriteLine("erc721 owner of: " + sender.Equals(nftOwner).ToString());

        // 17. ERC-1155 多代币智能合约包装器 (Erc1155Token)
        Erc1155Token multiToken = new Erc1155Token(expectedContract, tokenClient, 1);
        byte[] mockBal1155 = Abi.EncodeUint256(50);
        tokenMock.MockResponse = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\"0x" + Hex.Encode(mockBal1155, 32) + "\"}";
        BigInt multiBal = multiToken.BalanceOf(account.Address, 42);
        Console.WriteLine("erc1155 balance of: " + (multiBal.limb(0) == 50).ToString());

        // 18. Uniswap V2 现代 DEX 路由 (UniswapV2Router)
        UniswapV2Router router = UniswapV2Router.CreateDefault(tokenClient, 1);
        Console.WriteLine("dex router addr ok: " + (router.Contract.ContractAddress.ToLowerHex() == "0x7a250d5630b4cf539739df2c5dacb4c659f2488d").ToString());

        byte[] routerResp = new byte[128];
        byte[] off32 = Abi.EncodeUint256(32);
        byte[] len2 = Abi.EncodeUint256(2);
        byte[] amt0 = Abi.EncodeUint256(1000);
        byte[] amt1 = Abi.EncodeUint256(3000);
        for (int i = 0; i < 32; i = i + 1) { routerResp[i] = off32[i]; }
        for (int i = 0; i < 32; i = i + 1) { routerResp[32 + i] = len2[i]; }
        for (int i = 0; i < 32; i = i + 1) { routerResp[64 + i] = amt0[i]; }
        for (int i = 0; i < 32; i = i + 1) { routerResp[96 + i] = amt1[i]; }
        tokenMock.MockResponse = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\"0x" + Hex.Encode(routerResp, 128) + "\"}";

        List<Address> swapPath = new List<Address>();
        swapPath.Add(sender);
        swapPath.Add(receiver);
        List<BigInt> amounts = router.GetAmountsOut(Abi.DecodeUint256(amt0, 0), swapPath);
        Console.WriteLine("dex amounts count: " + (amounts.Count == 2).ToString());
        if (amounts.Count >= 2) {
            Console.WriteLine("dex amounts out: " + (amounts[1].limb(0) == 3000).ToString());
        }

        // 19. EIP-4337 现代账户抽象 (Account Abstraction) 与 UserOp 打包签名
        UserOperation userOp = new UserOperation();
        userOp.Sender = account.Address;
        userOp.Nonce = Abi.DecodeUint256(Abi.EncodeUint256(1), 0);
        userOp.CallData = Abi.EncodeErc20Transfer(receiver, Abi.DecodeUint256(Abi.EncodeUint256(100), 0));
        Address entryPoint = Address.Parse(UserOperation.DefaultEntryPoint);
        byte[] opHash = userOp.GetUserOpHash(entryPoint, 1);
        Console.WriteLine("userop hash len: " + (opHash.Length == 32).ToString());

        string opSigHex = userOp.Sign(account, entryPoint, 1);
        Console.WriteLine("userop sig len: " + (userOp.Signature.Length == 65).ToString());

        // 20. EIP-2612 ERC-20 链下免 Gas 授权 (Permit)
        PermitSignature permitSig = Erc20Permit.SignPermit(
            account,
            "USD Coin",
            expectedContract,
            1,
            receiver,
            Abi.DecodeUint256(Abi.EncodeUint256(500), 0),
            BigInt.zero(),
            1893456000
        );
        if (permitSig != null) {
            bool vValid = permitSig.V == 27 || permitSig.V == 28;
            Console.WriteLine("permit v valid: " + vValid.ToString());
            Console.WriteLine("permit rs len: " + (permitSig.R.Length == 32 && permitSig.S.Length == 32).ToString());

            byte[] permitCalldata = Erc20Permit.EncodePermitCalldata(
                account.Address,
                receiver,
                Abi.DecodeUint256(Abi.EncodeUint256(500), 0),
                1893456000,
                permitSig
            );
            Console.WriteLine("permit calldata len: " + (permitCalldata.Length == 228).ToString());
        }

        // 21. EIP-155 Legacy 传统交易离线签名 (BSC / 老链 Type-0 交易)
        Transaction legacyTx = new Transaction();
        legacyTx.IsLegacy = true;
        legacyTx.ChainId = 56; // BNB Smart Chain
        legacyTx.Nonce = 10;
        legacyTx.GasLimit = 21000;
        legacyTx.GasPrice = EtherUnit.FromGwei(5);
        legacyTx.To = receiver;
        legacyTx.Value = EtherUnit.FromGwei(100000);
        string legacyRaw = account.SignTransaction(legacyTx);
        if (legacyRaw != null) {
            Console.WriteLine("legacy tx not 0x02: " + (!legacyRaw.StartsWith("0x02")).ToString());
            Console.WriteLine("legacy tx is rlp: " + legacyRaw.StartsWith("0xf8").ToString());
        }

        // 22. 生产级 JSON-RPC 错误穿透机制 (Revert 拦截)
        tokenMock.MockResponse = "{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":{\"code\":-32000,\"message\":\"execution reverted: ERC20: transfer amount exceeds balance\"}}";
        string errCallRes = tokenClient.SendRpc("eth_call", "[]");
        Console.WriteLine("rpc error penetrated: " + (tokenClient.LastError == "execution reverted: ERC20: transfer amount exceeds balance").ToString());

        // 23. 交易确认回执解析 (TransactionReceipt)
        tokenMock.MockResponse = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"blockNumber\":\"0x12a\",\"status\":\"0x1\",\"gasUsed\":\"0x5208\"}}";
        TransactionReceipt receipt = tokenClient.GetTransactionReceipt("0xabcdef1234567890");
        if (receipt != null) {
            Console.WriteLine("receipt status ok: " + (receipt.Status == 1).ToString());
            Console.WriteLine("receipt block ok: " + (receipt.BlockNumber == 298).ToString());
            Console.WriteLine("receipt gas ok: " + (receipt.GasUsed == 21000).ToString());
        }

        Console.WriteLine("ALL ADVANCED WEB3 INFRASTRUCTURE TESTS PASSED");
    }
}
