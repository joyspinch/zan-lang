using System;
using System.Security.Cryptography;
using Zan.Web3.Types;
using Zan.Web3.Encoding;
using Zan.Web3.Rpc;

class Program {
    static void Main() {
        // 1. Account 构建与地址派生 (私钥 d = 1)
        byte[] priv1 = new byte[32];
        priv1[31] = 1;
        Account account = Account.FromPrivateKey(priv1);
        Console.WriteLine("account addr: " + (account.Address.ToLowerHex() == "0x7e5f4552091a69125d5dfcb7b8c2659029395bdf").ToString());

        // 2. EIP-55 校验和格式化与检查
        string testEip55 = "0x5aaeb6053f3e94c9b9a09f33669435e7ef1beaed";
        Address addrEip = Address.Parse(testEip55);
        Console.WriteLine("eip55 checksum: " + (addrEip.ToChecksumAddress() == "0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed").ToString());
        Console.WriteLine("eip55 valid: " + Address.IsValidChecksum("0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed").ToString());

        // 3. 以太坊个人消息签名与验签 (EIP-191 Personal Sign)
        string testMsg = "Hello Zan Web3!";
        string sigHex = account.SignMessage(testMsg);
        if (sigHex != null) {
            Console.WriteLine("personal sig len: " + sigHex.Length.ToString());
            bool verifyOk = Account.VerifyMessage(testMsg, sigHex, account.Address);
            Console.WriteLine("personal verify ok: " + verifyOk.ToString());
        }

        // 4. ecrecover 底层原语直接调用验证
        byte[] rawHash = Keccak256.Hash("direct_hash_for_ecrecover");
        Secp256k1Signature rawSig = Secp256k1.Sign(rawHash, priv1);
        Address recovered = Address.Recover(rawHash, rawSig);
        if (recovered != null) {
            Console.WriteLine("ecrecover ok: " + account.Address.Equals(recovered).ToString());
        }

        // 5. EIP-1559 现代动态费用交易离线签名
        Transaction tx = new Transaction();
        tx.ChainId = 1; // Ethereum Mainnet
        tx.Nonce = 5;
        tx.GasLimit = 21000;
        tx.To = Address.Parse("0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045");
        tx.Value = EtherUnit.FromGwei(100000000); // 0.1 ETH
        tx.MaxPriorityFeePerGas = EtherUnit.FromGwei(2);
        tx.MaxFeePerGas = EtherUnit.FromGwei(30);

        string rawTxHex = account.SignTransaction(tx);
        if (rawTxHex != null) {
            Console.WriteLine("raw tx starts with 0x02: " + rawTxHex.StartsWith("0x02").ToString());
            Console.WriteLine("raw tx len > 100: " + (rawTxHex.Length > 100).ToString());
        }

        // 6. RLP 编码基础
        byte[] rlpDog = Rlp.Encode(RlpItem.FromString("dog"));
        Console.WriteLine("rlp dog: " + (Hex.Encode(rlpDog, rlpDog.Length) == "83646f67").ToString());

        List<RlpItem> list = new List<RlpItem>();
        list.Add(RlpItem.FromString("cat"));
        list.Add(RlpItem.FromString("dog"));
        byte[] rlpList = Rlp.Encode(RlpItem.FromList(list));
        Console.WriteLine("rlp list: " + (Hex.Encode(rlpList, rlpList.Length) == "c88363617483646f67").ToString());

        // 7. ABI 函数选择器
        string selTransfer = Abi.GetFunctionSelectorHex("transfer(address,uint256)");
        Console.WriteLine("abi transfer selector: " + (selTransfer == "a9059cbb").ToString());

        // 8. JSON-RPC 请求报文
        string rpcBlock = JsonRpcBuilder.BlockNumber(1);
        Console.WriteLine("rpc block: " + (rpcBlock == "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_blockNumber\",\"params\":[]}").ToString());

        Console.WriteLine("ALL WEB3 PROTOCOL TESTS PASSED");
    }
}
