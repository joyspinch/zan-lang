// JsonValue.Set 的键索引：大对象上循环 Set 必须是 O(n) 而不是 O(n²)。
// 历史版本 Set 在 keyIndex==null 时线性扫描，"循环 Set 建 N 键"退化成
// O(n²)——TomlParser 逐表 Set 曾把 100k 表配置解析挂到分钟级（P2-27）。
// 本用例 60k 键：旧实现分钟级（必超时），新实现亚秒级完成。
using System;
using System.Json;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        JsonValue v = JsonValue.NewObject();
        for (int i = 0; i < 60000; i = i + 1) {
            v.Set("key_" + Convert.ToString(i), JsonValue.NewInt(i));
        }
        if (v.Count() != 60000) { bad = bad + 1; }
        // 首键胜语义：Set 已在册键替换首现值；Get 走索引路径一致。
        v.Set("key_0", JsonValue.NewStr("replaced"));
        JsonValue g = v.Get("key_0");
        if (g == null || !g.IsString() || g.AsString("") != "replaced") { bad = bad + 1; }
        JsonValue mid = v.Get("key_59999");
        if (mid == null || mid.AsInt(-1) != 59999) { bad = bad + 1; }
        // 不存在键仍返回 null。
        if (v.Get("nope") != null) { bad = bad + 1; }
        // 小对象（<=8 键）保持线性路径：语义不变。
        JsonValue small = JsonValue.NewObject();
        small.Set("a", JsonValue.NewInt(1));
        small.Set("b", JsonValue.NewInt(2));
        small.Set("a", JsonValue.NewInt(3));
        if (small.Count() != 2) { bad = bad + 1; }
        JsonValue sa = small.Get("a");
        if (sa == null || sa.AsInt(0) != 3) { bad = bad + 1; }
        Console.WriteLine("json-set-scale-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
