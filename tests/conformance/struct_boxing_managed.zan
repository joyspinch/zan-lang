// A556-3：托管字段结构体装箱。Holder 含 string / List<int> / 嵌套 struct
// 字段：装箱时按来源 owned 性决定字段级 retain（构造临时转移、既有变量
// retain）；箱的释放函数按字段 walk 释放（嵌套结构体下钻，与栈上结构体
// 同一 emit_collection_value_release 协议）；拆箱是 C# 同款拷贝语义——
// 目的捕获协议 retain，箱保有自己的份，箱先死拷贝仍可用；错型拆箱在
// try 里走 throw 路径，捕获后 EH 状态完好、原有箱继续可用。
using System;
using System.Collections.Generic;

public struct Inner {
    public string Tag;
}

public struct Holder {
    public string Name;
    public List<int> Nums;
    public Inner In;
    public Holder(string name, int n) {
        Name = name;
        Nums = new List<int>();
        Nums.Add(n);
        In = new Inner();
        In.Tag = name + "!";
    }
    public int Total() {
        int t = 0;
        for (int i = 0; i < Nums.Count; i++) t += Nums[i];
        return t + Name.Length + In.Tag.Length;
    }
}

class Program {
    static int ReadTotal(object o) {
        Holder h = (Holder)o;
        return h.Total();
    }

    static void Main() {
        // 构造临时直接装箱（owned 来源，字段所有权转移）
        object a = (object)new Holder("abc", 5);
        Console.WriteLine(a is Holder);
        Console.WriteLine(ReadTotal(a));
        Console.WriteLine(ReadTotal(a));

        // 既有变量装箱（retain 协议），随后变量覆写不影响箱
        Holder h = new Holder("de", 7);
        object b = (object)h;
        h = new Holder("z", 1);
        Console.WriteLine(b is Holder);
        Console.WriteLine(ReadTotal(b));

        // 拆箱两份独立拷贝
        Holder c1 = (Holder)a;
        Holder c2 = (Holder)a;
        Console.WriteLine(c1.Total());
        Console.WriteLine(c2.Total());

        // 错型拆箱：try 里走 throw 路径；捕获后 EH 完好
        int caught = 0;
        try {
            object nope = "nope";
            Holder bad = (Holder)nope;
        } catch (Exception e) {
            caught = 1;
        }
        Console.WriteLine(caught);
        Console.WriteLine(ReadTotal(a));
        Console.WriteLine("managed-boxing-ok: 1");
    }
}
