// CefBrowser 组件的离线部分：URL 归一化与 data:/JSON 转义、CefBrowserBox 的
// 设计模型（Kind/属性/事件）、CefHost 的就绪标记与 profile 目录推导。
// 真正的浏览器行为需要下载 CEF 运行时，不在冒烟范围内。
using System;
using Gui;
using Gui.Component.CefBrowser;

class Program {
    static int bad;

    static void Eq(string got, string want, string label) {
        if (got != want) {
            Console.WriteLine("FAIL " + label + ": got '" + got
                + "' want '" + want + "'");
            bad = bad + 1;
        }
    }

    static void Check(bool ok, string label) {
        if (!ok) { Console.WriteLine("FAIL " + label); bad = bad + 1; }
    }

    static void Normalize() {
        Eq(CefBrowser.Normalize("https://example.com"), "https://example.com",
            "normalize keeps scheme");
        Eq(CefBrowser.Normalize("example.com/a?b=1"),
            "https://example.com/a?b=1", "normalize bare host");
        Eq(CefBrowser.Normalize("data:text/html,<h1>x</h1>"),
            "data:text/html,<h1>x</h1>", "normalize keeps data:");
        Eq(CefBrowser.Normalize("about:blank"), "about:blank",
            "normalize keeps about:");
        Eq(CefBrowser.Normalize("file:///tmp/a.html"), "file:///tmp/a.html",
            "normalize keeps file:");
        Eq(CefBrowser.Normalize(""), "", "normalize empty");
    }

    static void Escaping() {
        // data: URL 里 '#' 会被当片段、'&'/'?' 会被当查询，必须转义。
        Eq(CefBrowser.UrlEscape("<p>a & b #c?d</p>"),
            "<p>a%20%26%20b%20%23c%3Fd</p>", "data url escape");
        Eq(CefBrowser.JsonString("a\"b\\c\nd\te"),
            "\"a\\\"b\\\\c\\nd\\te\"", "json string escape");
        // 控制字符按 JSON 规范走 \u00XX，而不是被静默改成空格。
        // 之前把 c < 32 一律 Append(' ') 会让 0x01-0x1F 丢失。
        // （NUL 不测：Zan 字符串按 C 字符串模型，NUL 是终止符进不了串。）
        Eq(CefBrowser.JsonString("a" + (char)1 + "b" + (char)27 + "c"),
            "\"a\\u0001b\\u001bc\"", "json control char escape");
    }

    static void BoxModel() {
        CefBrowserBox box = new CefBrowserBox();
        Eq(box.Kind(), "CefBrowserBox", "box kind");
        Eq(box.StartUrl(), "", "box start url default");
        box.SetStartUrl("https://example.com");
        Eq(box.StartUrl(), "https://example.com", "box start url set");

        List<PropSpec> ps = box.Props();
        Check(ps.Count == 1, "box exposes one property");
        Eq(ps[0].key, "url", "box property name");
        Eq(ps[0].Read(), "https://example.com", "box property value");
        // 设计器/.zform 里写 placeholder 也要落到起始地址。
        ps[0].Write("https://zan.example");
        Eq(box.StartUrl(), "https://zan.example", "box property writes back");

        List<string> evts = box.Events();
        Check(Program.Has(evts, "NavStart"), "box event NavStart");
        Check(Program.Has(evts, "NavComplete"), "box event NavComplete");
        Check(Program.Has(evts, "TitleChanged"), "box event TitleChanged");
        Check(Program.Has(evts, "LoadingChanged"), "box event LoadingChanged");

        // 没有 CEF 运行时时一切都是安全的空操作，而不是崩溃：控件可以放进
        // 设计器/表单里，运行时缺失只体现为占位符。
        box.Back();
        box.Forward();
        box.Reload();
        box.Stop();
        box.Hide();
        Check(!box.CanGoBack(), "no runtime: cannot go back");
        Check(!box.CanGoForward(), "no runtime: cannot go forward");
        Check(!box.IsLoading(), "no runtime: not loading");
        Check(box.LastStatus() == 0, "no runtime: no status");
        Eq(box.CurrentUrl(), "", "no runtime: empty url");
        Eq(box.CurrentTitle(), "", "no runtime: empty title");
    }

    static bool Has(List<string> xs, string want) {
        for (int i = 0; i < xs.Count; i = i + 1) {
            if (xs[i] == want) { return true; }
        }
        return false;
    }

    static void Factory() {
        // 控件树里的 CEF 浏览器：设计器面板与 JSON 反序列化都要认识它。
        Control c = ControlFactory.Create("CefBrowserBox");
        Check(c != null, "factory creates CefBrowserBox");
        if (c != null) { Eq(c.Kind(), "CefBrowserBox", "factory kind"); }
        Check(Program.Has(ControlFactory.Kinds(), "CefBrowserBox"),
            "designer lists CefBrowserBox");
    }

    static void HostPaths() {
        Eq(CefHost.ReadyMarker(), ".zan-cef-ready", "ready marker name");
        Eq(CefRuntime.ReadyMarker(), CefHost.ReadyMarker(),
            "runtime and host agree on the marker");
        Eq(CefHost.MarkerVersion("/nonexistent/cef-runtime"), "",
            "missing marker reads empty");
        Eq(CefHost.ParentDir("/home/u/.cache/zan/cef/linux64-151.3.18"),
            "/home/u/.cache/zan/cef", "parent dir posix");
        Eq(CefHost.ParentDir("C:/Users/u/AppData/Local/Zan/cef/win-151"),
            "C:/Users/u/AppData/Local/Zan/cef", "parent dir windows");
        Eq(CefHost.ParentDir("nodir"), ".", "parent dir of bare name");
        // 版本策略：旧 Windows 钉在 109，其他钉在当前分支（driver 的头文件
        // 版本），不能是「最新 stable」——那会和 driver 的结构体布局脱钩。
        Check(CefRuntime.LegacyBranch() == "109.", "legacy branch pinned");
        Check(CefRuntime.CurrentBranch() != "", "current branch pinned");
        Eq(CefRuntime.VersionPrefix(),
            CefRuntime.LegacyWindows() ? CefRuntime.LegacyBranch()
                                       : CefRuntime.CurrentBranch(),
            "version prefix follows the platform");
    }

    static void DriverChoice() {
        // driver 变体按运行时版本挑：109 运行时配 zan_cef109，其余配 zan_cef。
        List<string> legacy = CefBackend.Candidates("109.1.18+gf1c41e4");
        List<string> cur = CefBackend.Candidates("151.3.18+gbeff58d");
        Check(legacy.Count > 0 && cur.Count > 0, "candidates non-empty");
        Check(Program.EndsWithAny(legacy, "zan_cef109"),
            "109 runtime picks the legacy driver");
        Check(!Program.EndsWithAny(cur, "zan_cef109"),
            "current runtime avoids the legacy driver");
    }

    static bool EndsWithAny(List<string> xs, string stem) {
        for (int i = 0; i < xs.Count; i = i + 1) {
            if (xs[i].Contains(stem)) { return true; }
        }
        return false;
    }

    static void Options() {
        // 代码级配置：显式设过的字段盖掉环境变量，空字符串 = 没设。
        CefOptions o = new CefOptions();
        o.runtimeDir = "D:/app/cef";
        o.profileDir = "D:/app/data/web";
        o.driverPath = "D:/app/bin";
        o.cacheRoot = "D:/app/cache";
        o.locale = "zh-CN";
        o.helperPath = "D:/app/bin/helper.exe";
        o.switches = "disable-gpu";
        CefOptions.Use(o);
        Eq(CefOptions.RuntimeDir(), "D:/app/cef", "options runtime dir");
        Eq(CefOptions.ProfileDir(), "D:/app/data/web", "options profile dir");
        Eq(CefOptions.CacheRoot(), "D:/app/cache", "options cache root");
        Eq(CefOptions.Locale(), "zh-CN", "options locale");
        Eq(CefOptions.HelperPath(), "D:/app/bin/helper.exe",
            "options helper path");
        Eq(CefHost.Switches(), "disable-gpu", "options switches reach the host");
        // profile 目录不再跟着运行时目录跑，driver 按配置目录找。
        Eq(CefHost.ProfileDir("/opt/cef/linux64-151"), "D:/app/data/web",
            "configured profile wins over the runtime-adjacent default");
        Check(Program.EndsWithAny(CefBackend.Candidates("151.3.18"),
                                  "D:/app/bin"),
            "configured driver directory is searched first");
        // 开关值里带逗号时整串改用分号分隔，否则 disable-features=A,B 会被
        // 拆成两个开关；disableDirectComposition 展开成真正的开关。
        o.switches = "disable-features=A,B;use-angle=d3d11";
        o.disableDirectComposition = true;
        Eq(CefHost.Switches(),
            "disable-features=A,B;use-angle=d3d11;disable-direct-composition",
            "semicolon list keeps comma-separated switch values intact");
        o.switches = "";
        Eq(CefHost.Switches(), "disable-direct-composition",
            "dcomp flag alone still reaches the command line");
        o.disableDirectComposition = false;
        o.switches = "disable-gpu";
        // 换回一份空配置 = 纯环境变量/默认行为。
        CefOptions.Use(new CefOptions());
        Eq(CefOptions.RuntimeDir(), "", "empty options fall back");
        // 没配 profile 时按槽位分配：<缓存>/Zan/Cache/profile1、profile2…
        // （占哪个槽位要真的去锁目录，那部分在 gui_cef_profile 里验）。
        Eq(CefHost.ProfileRoot("/x/Zan/cef/linux64-151"), "/x/Zan/Cache/profile",
            "profile slots live next to the runtime root, not inside it");
    }

    static void CdpRouting() {
        // CDP 消息分派只能认最外层的 method/id：params 里同名的键
        // （事件体里就带着 "method"/"id"）不能把路由带跑。
        string evt = "{\"method\":\"Network.responseReceived\",\"params\":"
            + "{\"requestId\":\"7.1\",\"method\":\"Runtime.evaluate\","
            + "\"id\":99,\"response\":{\"status\":200}}}";
        Eq(CefCdp.Field(evt, "method"), "Network.responseReceived",
            "top-level method");
        Check(CefCdp.IntField(evt, "id") == 0, "nested id is not a reply id");
        string reply = "{\"id\":42,\"result\":{\"cookies\":[{\"name\":\"a\"}]}}";
        Check(CefCdp.IntField(reply, "id") == 42, "reply id");
        Eq(CefCdp.Field(reply, "method"), "", "reply has no method");
        Eq(CefCdp.Raw(reply, "result"),
            "{\"cookies\":[{\"name\":\"a\"}]}", "reply result payload");
        // 键名里带转义的引号不能把扫描弄丢。
        string tricky = "{\"a\\\"b\":1,\"method\":\"Page.loadEventFired\"}";
        Eq(CefCdp.Field(tricky, "method"), "Page.loadEventFired",
            "escaped quote in a key");
        // Cookie 参数拼装：domain/path 形式与 url 形式。
        Eq(CefCookies.Param("t", "v", ".example.com", "/", true, "", 0 - 1),
            "{\"name\":\"t\",\"value\":\"v\",\"domain\":\".example.com\","
            + "\"path\":\"/\",\"secure\":true}", "cookie param domain form");
        Eq(CefCookies.Param("t", "v", "", "", false,
                            "https://example.com/", 1700000000),
            "{\"name\":\"t\",\"value\":\"v\",\"url\":\"https://example.com/\","
            + "\"expires\":1700000000}", "cookie param url form");
    }

    static void Fingerprint() {
        // DPR 拼的是 JSON 字面量，不能跟着地区变成逗号。
        Eq(CefFingerprint.Ratio(100), "1", "dpr 1.0");
        Eq(CefFingerprint.Ratio(150), "1.5", "dpr 1.5");
        Eq(CefFingerprint.Ratio(225), "2.25", "dpr 2.25");
        Eq(CefFingerprint.Ratio(205), "2.05", "dpr keeps the leading zero");
        Eq(CefFingerprint.Major("151.0.7922.138"), "151", "chrome major");
        Eq(CefFingerprint.Major("151"), "151", "major without dots");

        // 一份什么都没填的指纹不该注入任何脚本。
        CefFingerprint fp = new CefFingerprint(null);
        Eq(fp.Script(), "", "empty fingerprint injects nothing");

        // 补丁脚本按字段按需拼：只填了 WebGL 就只有 WebGL 那段。
        fp.webglVendor = "Google Inc. (NVIDIA)";
        fp.webglRenderer = "ANGLE (NVIDIA)";
        string js = fp.Script();
        Check(js.StartsWith("(function(){") && js.EndsWith("})();"),
            "injected script is self-contained");
        Check(js.Contains("37445") && js.Contains("7936"),
            "both unmasked and standard WebGL parameters are patched");
        Check(!js.Contains("languages") && !js.Contains("toDataURL"),
            "unset fields inject nothing");

        fp.canvasNoise = 2;
        fp.locale = "zh-CN";
        fp.hideWebdriver = true;
        js = fp.Script();
        Check(js.Contains("toDataURL") && js.Contains("getImageData"),
            "canvas noise patches both readback paths");
        Check(js.Contains("'languages'") && js.Contains("[\"zh-CN\"]"),
            "languages fall back to the locale");
        Check(js.Contains("'webdriver'"), "webdriver is hidden");

        // Client Hints 品牌列表要带 Chromium 与 Not.A/Brand，只报一个
        // 品牌反而扎眼；fullVersion 缺省跟主版本号。
        fp.brand = "Google Chrome";
        fp.brandVersion = "151";
        fp.platform = "Windows";
        fp.platformVersion = "15.0.0";
        string meta = fp.Metadata();
        Check(meta.Contains("\"Not.A/Brand\"") && meta.Contains("\"Chromium\"")
              && meta.Contains("\"Google Chrome\""), "brand list");
        Check(meta.Contains("\"fullVersion\":\"151\""),
            "fullVersion falls back to the major version");
        Check(meta.Contains("\"architecture\":\"x86\""),
            "architecture defaults to x86");
        Check(meta.Contains("\"mobile\":false"), "desktop mobile flag");

        // 预设拿的是 Chromium 的版本号，不是 CEF 的。
        CefFingerprint win = new CefFingerprint(null);
        win.UseWindowsChrome("151.0.7922.138");
        Check(win.userAgent.Contains("Chrome/151.0.0.0")
              && win.userAgent.Contains("Windows NT 10.0; Win64; x64"),
            "windows chrome preset UA");
        Eq(win.brandVersion, "151", "preset brand major");
        Eq(win.brandFullVersion, "151.0.7922.138", "preset brand full version");
    }

    static int Main() {
        bad = 0;
        Normalize();
        Escaping();
        BoxModel();
        Factory();
        HostPaths();
        DriverChoice();
        Options();
        CdpRouting();
        Fingerprint();
        if (bad == 0) { Console.WriteLine("cef browser model ok"); }
        return bad == 0 ? 0 : 1;
    }
}
