using System;

enum Status {
    Pending,
    Active,
    Completed
}

class Program {
    static string CheckStatus(Status s) {
        // 全部枚举成员覆盖，穷尽且无警告
        return s switch {
            Status.Pending => "pending",
            Status.Active => "active",
            Status.Completed => "completed"
        };
    }

    static string MatchValue(int x) {
        return x switch {
            1 => "one",
            2 => "two",
            _ => "other"
        };
    }

    static void Main() {
        Console.WriteLine(CheckStatus(Status.Pending));
        Console.WriteLine(CheckStatus(Status.Active));
        Console.WriteLine(CheckStatus(Status.Completed));
        Console.WriteLine(MatchValue(1));
        Console.WriteLine(MatchValue(2));
        Console.WriteLine(MatchValue(99));
        Console.WriteLine("ALL SWITCH TESTS PASSED");
    }
}
