using System;
using System.IO;

class Program {
    static void Check(string name, bool ok) {
        Console.WriteLine(name + "=" + Convert.ToString(ok ? 1 : 0));
    }

    static void Restore(string name, string value) {
        Environment.SetEnvironmentVariable(name, value == "" ? null : value);
    }

    static void Main() {
        #if WINDOWS
        string homeKey = "USERPROFILE";
        string savedApp = Environment.GetEnvironmentVariable("APPDATA");
        string savedLocal = Environment.GetEnvironmentVariable("LOCALAPPDATA");
        #else
        string homeKey = "HOME";
        #endif
        string savedHome = Environment.GetEnvironmentVariable(homeKey);
        string savedConfig = Environment.GetEnvironmentVariable("XDG_CONFIG_HOME");
        string savedData = Environment.GetEnvironmentVariable("XDG_DATA_HOME");
        string home = Path.GetFullPath("_scratch/zan_目录_"
            + Convert.ToString(Environment.ProcessId));
        string cfg = Path.Combine(home, "设置");
        try {
            Environment.SetEnvironmentVariable(homeKey, home);
            Check("home-unicode", KnownFolders.Home() == home);
            #if WINDOWS
            Check("appdata-default", KnownFolders.AppData() == savedApp
                && KnownFolders.LocalAppData() == savedLocal);
            Environment.SetEnvironmentVariable("APPDATA", cfg);
            Environment.SetEnvironmentVariable("LOCALAPPDATA", home + "\\数据");
            Check("appdata-override", KnownFolders.AppData() == cfg
                && KnownFolders.LocalAppData() == home + "\\数据");
            Check("userdirs", KnownFolders.Desktop() == Path.Combine(home, "Desktop")
                && KnownFolders.Documents() == Path.Combine(home, "Documents")
                && KnownFolders.Downloads() == Path.Combine(home, "Downloads"));
            #elif MACOS
            string support = Path.Combine(home, "Library/Application Support");
            Check("appdata-default", KnownFolders.AppData() == support
                && KnownFolders.LocalAppData() == support);
            Environment.SetEnvironmentVariable("XDG_CONFIG_HOME", cfg);
            Environment.SetEnvironmentVariable("XDG_DATA_HOME", cfg);
            Check("appdata-override", KnownFolders.AppData() == support
                && KnownFolders.LocalAppData() == support);
            Check("userdirs", KnownFolders.Desktop() == Path.Combine(home, "Desktop")
                && KnownFolders.Documents() == Path.Combine(home, "Documents")
                && KnownFolders.Downloads() == Path.Combine(home, "Downloads"));
            #else
            Environment.SetEnvironmentVariable("XDG_CONFIG_HOME", null);
            Environment.SetEnvironmentVariable("XDG_DATA_HOME", null);
            Check("appdata-default", KnownFolders.AppData() == Path.Combine(home, ".config")
                && KnownFolders.LocalAppData() == Path.Combine(home, ".local/share"));
            Environment.SetEnvironmentVariable("XDG_CONFIG_HOME", cfg);
            Environment.SetEnvironmentVariable("XDG_DATA_HOME", home + "/数据");
            bool baseOverride = KnownFolders.AppData() == cfg
                && KnownFolders.LocalAppData() == home + "/数据";
            Environment.SetEnvironmentVariable("XDG_CONFIG_HOME", "relative/config");
            Environment.SetEnvironmentVariable("XDG_DATA_HOME", "relative/data");
            Check("appdata-override", baseOverride
                && KnownFolders.AppData() == Path.Combine(home, ".config")
                && KnownFolders.LocalAppData() == Path.Combine(home, ".local/share"));
            Environment.SetEnvironmentVariable("XDG_CONFIG_HOME", cfg);
            #if LINUX
            Directory.CreateDirectoryRecursive(cfg);
            string file = Path.Combine(cfg, "user-dirs.dirs");
            File.WriteAllText(file, "# fixture\r\n"
                + " XDG_DESKTOP_DIR = \"$HOME/桌 面\" # redirected\r\n"
                + "XDG_DOCUMENTS_DIR=\"" + home + "/文档\"\r\n"
                + "XDG_DOWNLOAD_DIR=\"$HOME\"\r\n");
            bool redirected = KnownFolders.Desktop() == home + "/桌 面"
                && KnownFolders.Documents() == home + "/文档" && KnownFolders.Downloads() == home;
            File.WriteAllText(file, "XDG_DESKTOP_DIR=\"$HOME/带\\\"引号\\\\反斜杠\"\n"
                + "XDG_DOCUMENTS_DIR=\"relative/path\"\n"
                + "XDG_DOWNLOAD_DIR=\"$(touch should_not_execute)\"\n");
            bool escaped = KnownFolders.Desktop() == home + "/带\"引号\\反斜杠";
            bool invalid = KnownFolders.Documents() == Path.Combine(home, "Documents")
                && KnownFolders.Downloads() == Path.Combine(home, "Downloads");
            File.Delete(file);
            Check("userdirs", redirected && escaped && invalid
                && KnownFolders.Desktop() == Path.Combine(home, "Desktop"));
            #else
            Check("userdirs", KnownFolders.Desktop() == Path.Combine(home, "Desktop")
                && KnownFolders.Documents() == Path.Combine(home, "Documents")
                && KnownFolders.Downloads() == Path.Combine(home, "Downloads"));
            #endif
            #endif
        } finally {
            Restore(homeKey, savedHome);
            Restore("XDG_CONFIG_HOME", savedConfig);
            Restore("XDG_DATA_HOME", savedData);
            #if WINDOWS
            Restore("APPDATA", savedApp);
            Restore("LOCALAPPDATA", savedLocal);
            #endif
            #if LINUX
            Directory.DeleteRecursive(home);
            #endif
        }
    }
}
