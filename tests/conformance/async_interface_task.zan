// 接口上的 async 标记：宿主把"没有方法体的 Task 返回类型"也当成 async
// 方法（解析期补 async 标记），所以经接口调用拿到的是协程帧，await 拿到
// 的是结果。自举的解析器补同样的标记，IR 后端的虚调用也要把协程调用
// 标成 async 调用，否则 await 会拒绝这个操作数。
using System;

interface ICalc {
    Task<int> GetAsync();
}

class Impl : ICalc {
    public async Task<int> GetAsync() {
        await Task.Delay(1);
        return 7;
    }
}

class Program {
    static void Main() {
        ICalc c = new Impl();
        int v = await c.GetAsync();
        Console.WriteLine("v=" + v);
    }
}
