using System;
using System.Web;
using Zan.Web;

/* 隐式控制器发现按**来源**判定，不按命名空间。

   模板/示例项目统一使用 Zan.Web.* 命名空间（与框架同一套命名规范），
   所以"命名空间以 Zan.Web 开头"不能当作"这是框架包自带控制器"的证据：
   按命名空间跳过会把项目自己的控制器全部吞掉，__AttrRoutes.Register
   最终只登记到几条静态路由，所有业务接口 404。

   正确口径：
     - 用户项目文件（本文件）里的控制器 → 必须被发现；
     - packages/ 里的 Zan.Mvc 框架控制器 → 必须不被发现（归 Boot /
       显式RegisterFramework 管）。
   本文件同时钉住这两个方向。 */

namespace Zan.Web.Conf;

class OriginToolController : AppController {
    [HttpGet]
    [Route("/origin-tool")]
    void Index() { this.Text("tool"); }
}

class Program {
    static Route Match(WebApp app, string path) {
        HttpRequest request =
            HttpRequest.Parse("GET " + path + " HTTP/1.1\r\nHost: test\r\n\r\n");
        HttpContext ctx = new HttpContext(request, "127.0.0.1");
        return app.Router().Match(ctx);
    }

    static void Main() {
        WebApp app = new WebApp("127.0.0.1", 0);
        __AttrRoutes.Register(app);
        /* 项目控制器：命名空间是 Zan.Web.Conf，仍应被隐式发现。 */
        Console.WriteLine(Program.Match(app, "/origin-tool") != null
            ? "project=found" : "project=missing");
        /* 框架包控制器（Zan.Web.Account.LoginController 的 /login）：
         * 不在隐式发现范围，只有 Boot/RegisterFramework 能登记它。 */
        Console.WriteLine(Program.Match(app, "/login") != null
            ? "framework=leaked" : "framework=skipped");
    }
}
