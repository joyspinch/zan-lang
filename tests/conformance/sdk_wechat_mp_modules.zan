    static void CompileSharedModels() {
        WechatMpCell cell = new WechatMpCell();
        cell.title = "shared";
        cell.url = "pages/index";
        WechatMpCardApiAddGiftCardPageRequest add =
            new WechatMpCardApiAddGiftCardPageRequest().Cell1(cell).Cell2(cell);
        WechatMpCardApiUpdateGiftCardPageRequest update =
            new WechatMpCardApiUpdateGiftCardPageRequest().Cell1(cell).Cell2(cell);
    }

    static void Main() {
        CompileSharedModels();
        Console.WriteLine("modules=37");
        Console.WriteLine("path0=" + WechatMpRequest.BuildPath("/cgi-bin/test", ""));
        Console.WriteLine("path1=" + WechatMpRequest.BuildPath("/cgi-bin/test", "a=1"));
        Console.WriteLine("path2=" + WechatMpRequest.BuildPath("/cgi-bin/test", "?a=1"));
    }
