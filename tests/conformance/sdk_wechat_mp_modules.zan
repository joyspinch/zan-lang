using System;
using Sdk.Wechat;
using Sdk.Wechat.Mp;

class Program {
    // Compile-only surface check: validates GET/POST methods across generated modules
    // without contacting the WeChat gateway.
    static async void CompileSurface(WechatClient client) {
        WechatMpAnalysisApi analysis = new WechatMpAnalysisApi(client);
        WechatResponse a = await analysis.GetArticleSummaryAsync("", "{}");
        WechatMpAutoReplyApi autoReply = new WechatMpAutoReplyApi(client);
        WechatResponse b = await autoReply.GetCurrentAutoreplyInfoAsync("");
        WechatMpMedicalAssistantApi medical = new WechatMpMedicalAssistantApi(client);
        WechatResponse c = await medical.SendChannelMessageAsync("", "{}");
        WechatMpSemanticApi semantic = new WechatMpSemanticApi(client);
        WechatResponse d = await semantic.SemanticSendAsync("", "{}");
        WechatMpNewTmplApi tmpl = new WechatMpNewTmplApi(client);
        WechatResponse e = await tmpl.GetPubTemplateTitlesAsync("");
    }

    static void Main() {
