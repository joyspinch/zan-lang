    // -------------------------------------------------------------
    // Test 1: HttpServer SetMaxConnectionsPerIp
    // -------------------------------------------------------------
    static async HttpResponse DummyHandler(HttpRequest req) {
        return HttpResponse.Ok("dummy_ok");
    }

    static async Task<bool> TestMaxConnectionsPerIp() {
        HttpServer server = new HttpServer("127.0.0.1", PORT_HTTP);
        server.SetMaxConnectionsPerIp(2);
        server.OnRequest(DummyHandler);
        Task.Spawn(server.Start());
        await Task.Delay(30);

        // 第 1 个连接与第 2 个连接应正常允许
        TcpClient c1 = await TcpClient.ConnectAsync("127.0.0.1", PORT_HTTP);
        TcpClient c2 = await TcpClient.ConnectAsync("127.0.0.1", PORT_HTTP);
        if (c1 == null || c2 == null) {
            if (c1 != null) { c1.Dispose(); }
            if (c2 != null) { c2.Dispose(); }
            server.Stop();
            return false;
        }

        // 发送微量心跳保持在途
        await c1.SendAsync("GET /ping HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n");
        string r1 = await c1.RecvAsync(1024);
        bool c1Ok = (r1 != null && r1.IndexOf("200 OK") >= 0);

        // 第 3 个连接来自同一 IP，应当被拒绝（收到 503 或连接被重置）
        TcpClient c3 = await TcpClient.ConnectAsync("127.0.0.1", PORT_HTTP);
        bool rejected = false;
        if (c3 == null) {
            rejected = true;
        } else {
            await c3.SendAsync("GET /flood HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n");
            string r3 = await c3.RecvAsync(1024);
            if (r3 == null || r3.Length == 0 || r3.IndexOf("503") >= 0) {
                rejected = true;
            }
            c3.Dispose();
        }

        // 释放 c1 连接
        c1.Dispose();
        for (int i = 0; i < 5; i = i + 1) { await Task.Delay(10); }

        // 槽位释放后，新连接 c4 应该能成功连接
        TcpClient c4 = await TcpClient.ConnectAsync("127.0.0.1", PORT_HTTP);
        bool c4Ok = false;
        if (c4 != null) {
            await c4.SendAsync("GET /after HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n");
            string r4 = await c4.RecvAsync(1024);
            c4Ok = (r4 != null && r4.IndexOf("200 OK") >= 0);
            c4.Dispose();
        }

        c2.Dispose();
        server.Stop();
        for (int i = 0; i < 20; i = i + 1) { await Task.Delay(10); }

        return c1Ok && rejected && c4Ok;
    }

    // -------------------------------------------------------------
    // Test 2: Slowloris / MaxHeaderBytes 431 Defense
    // -------------------------------------------------------------
    static async Task<bool> TestMaxHeaderBytesLimit() {
        HttpServer server = new HttpServer("127.0.0.1", PORT_HTTP);
        server.SetMaxHeaderBytes(512);
        server.OnRequest(DummyHandler);
        Task.Spawn(server.Start());
        await Task.Delay(30);

        TcpClient client = await TcpClient.ConnectAsync("127.0.0.1", PORT_HTTP);
        if (client == null) {
            server.Stop();
            return false;
        }

        // 发送超过 512 字节且没有结尾空行的长请求头垃圾数据
        string junk = "GET /attack HTTP/1.1\r\nHost: 127.0.0.1\r\nX-Padding: "
            + "012345678901234567890123456789012345678901234567890123456789"
            + "012345678901234567890123456789012345678901234567890123456789"
            + "012345678901234567890123456789012345678901234567890123456789"
            + "012345678901234567890123456789012345678901234567890123456789"
            + "012345678901234567890123456789012345678901234567890123456789"
            + "012345678901234567890123456789012345678901234567890123456789"
            + "012345678901234567890123456789012345678901234567890123456789"
            + "012345678901234567890123456789012345678901234567890123456789\r\n";

        await client.SendAsync(junk);
        string resp = await client.RecvAsync(1024);
        bool got431 = (resp != null && resp.IndexOf("431") >= 0);

        client.Dispose();
        server.Stop();
        for (int i = 0; i < 20; i = i + 1) { await Task.Delay(10); }

        return got431;
    }

    // -------------------------------------------------------------
    // Test 3: HTTPS -> HTTP Downgrade Redirect Rejection
    // -------------------------------------------------------------
    static async HttpResponse HttpsRedirectHandler(HttpRequest req) {
        if (req.path == "/downgrade") {
            HttpResponse r = HttpResponse.WithStatus(302, "Found", "");
            r.SetHeader("Location", "http://127.0.0.1:19551/insecure");
            return r;
        }
        return HttpResponse.Ok("https_ok");
    }

    static async Task<bool> TestDowngradeRedirectRejection() {
        Directory.CreateDirectory("_scratch");
        string certPath = "_scratch/https_sec_cert.pem";
        string keyPath = "_scratch/https_sec_key.pem";
        File.WriteAllText(certPath, Program.SERVER_CERT);
        File.WriteAllText(keyPath, Program.SERVER_KEY);

        HttpsServer server = HttpsServer.Create("127.0.0.1", PORT_HTTPS, certPath, keyPath);
        if (server == null) { return false; }
        server.OnRequest(HttpsRedirectHandler);
        Task.Spawn(server.Start());
        await Task.Delay(50);

        HttpClient client = HttpClient.CreateHttps("127.0.0.1", PORT_HTTPS);
        client.DisableTlsVerify();
        client.SetTimeout(5000);
        client.SetCallPolicy(ExternalCallPolicy.Default().AllowLocalHttp().Redirects(2));

        bool caughtExpected = false;
        try {
            HttpResponse resp = await client.SendAsync("GET", "/downgrade", "");
        } catch (HttpRequestException ex) {
            if (ex.Message != null && ex.Message.IndexOf("insecure redirect: HTTPS to HTTP downgrade forbidden") >= 0) {
                caughtExpected = true;
            }
        }

        client.Close();
        server.Stop();
        for (int i = 0; i < 20; i = i + 1) { await Task.Delay(10); }

        return caughtExpected;
    }

    // -------------------------------------------------------------
    // Driver
    // -------------------------------------------------------------
    static async Task<int> RunAll() {
        Socket.Initialize();

        Console.WriteLine("=== NET SECURITY HARDENING & FLOOD DEFENSE SUITE ===");

        bool t1 = await TestMaxConnectionsPerIp();
        Console.WriteLine("test_per_ip_connection_limit=" + (t1 ? "1" : "0"));

        bool t2 = await TestMaxHeaderBytesLimit();
        Console.WriteLine("test_max_header_bytes_431=" + (t2 ? "1" : "0"));

        bool t3 = await TestDowngradeRedirectRejection();
        Console.WriteLine("test_downgrade_redirect_rejection=" + (t3 ? "1" : "0"));

        bool allOk = t1 && t2 && t3;
        Console.WriteLine("all_security_defenses_ok=" + (allOk ? "1" : "0"));

        Socket.Cleanup();
        return allOk ? 0 : 1;
    }

    static async void Main() {
        int code = await Program.RunAll();
    }
}
