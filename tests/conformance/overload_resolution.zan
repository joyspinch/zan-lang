// 测试断言与状态转移验证。
using System;

class Box {
    int seed;

    Box() { this.seed = 0; }

    static Box Make(int seed) {
        Box b = new Box();
        b.seed = seed;
        return b;
    }

    // 核心契约与执行状态转移规范。
    int Combine() { return this.seed; }
    int Combine(int a) { return this.seed + a; }
    int Combine(int a, int b) { return this.seed + a * 10 + b * 100; }

    // 测试断言与状态转移验证。
    static int Sum(int a) { return a; }
    static int Sum(int a, int b, int c) { return a + b + c; }
}

// 测试断言与状态转移验证。
class Wide { }

class Tall { }

class Cells {
    // 测试断言与状态转移验证。
    static Wide Cell(int a) { return new Wide(); }
    static Tall Cell(int a, int b) { return new Tall(); }
    static Tall Cell(int a, int b, int c) { return new Tall(); }

    // 核心契约与语义定义。
    static Wide Tail(int a) { return new Wide(); }
    static Tall Tail(int a, int b, params int[] rest) { return new Tall(); }

    public static string Check() {
        Wide w1 = Cell(1);
        Tall t2 = Cell(1, 2);
        Tall t3 = Cell(1, 2, 3);
        Wide w2 = Tail(1);
        Tall t4 = Tail(1, 2, 3, 4);
        return "Cell " + Convert.ToString(w1 != null && t2 != null && t3 != null)
            + " Tail " + Convert.ToString(w2 != null && t4 != null);
    }
}

// 测试断言与状态转移验证。
class Base {
    public static string Widen(int a) { return "base-one"; }
}

class Derived : Base {
    public static int Widen(int a, int b) { return a + b; }

    public static string Check() { return Widen(1); }
}

class Program {
    static void Main() {
        Box box = Box.Make(1);
        Console.WriteLine(box.Combine());          // 1
        Console.WriteLine(box.Combine(2));         // 3
        Console.WriteLine(box.Combine(2, 3));      // 1 + 20 + 300 = 321
        Console.WriteLine(Box.Sum(7));             // 7
        Console.WriteLine(Box.Sum(7, 8, 9));       // 24
        Console.WriteLine(Cells.Check());
        Console.WriteLine(Derived.Check());
    }
}
