using System;

// B-ID98 钉子：monitor 块分配失败 → zan_rt_fatal，不得未持锁裸奔回返回。
// 由 run_oom_case.cmake 设 ZAN_OOM_INJECT_SITE=sync.monitor_block 触发：
// 预期进程非零退出、stderr 含 "fatal (oom): sync: monitor block alloc
// failed"、stdout 为空（缓冲未刷，abort 前无输出落盘）。
class Program {
    static object gate = new object();

    static void Main() {
        lock (gate) {
            Console.WriteLine("in-lock");
        }
    }
}
