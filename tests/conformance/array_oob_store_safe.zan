using System;

class Foo {
    public int[] fa = new int[3];
    public int[,] fm = new int[3, 3];

    public void TestField() {
        fa[0] = 33;
        fa[9] = 99;
        Console.WriteLine("field 1d: " + fa[0]);

        fm[0, 0] = 44;
        fm[9, 9] = 99;
        Console.WriteLine("field 2d: " + fm[0, 0]);
    }
}

class Program {
    static void Main() {
        int[] a = new int[3];
        a[0] = 11;
        a[9] = 99;
        a[-1] = 99;
        Console.WriteLine("local 1d: " + a[0]);

        int[,] m = new int[3, 3];
        m[0, 0] = 22;
        m[9, 9] = 99;
        m[-1, 0] = 99;
        m[0, -1] = 99;
        Console.WriteLine("local 2d: " + m[0, 0]);

        var f = new Foo();
        f.TestField();

        a[9]++;
        a[-1]++;
        Console.WriteLine("inc 1d: " + a[0]);

        m[9, 9]++;
        m[-1, 0]++;
        Console.WriteLine("inc 2d: " + m[0, 0]);

        a[9] += 5;
        Console.WriteLine("compound 1d: " + a[0]);

        m[9, 9] += 5;
        Console.WriteLine("compound 2d: " + m[0, 0]);

        Console.WriteLine("done");
    }
}
