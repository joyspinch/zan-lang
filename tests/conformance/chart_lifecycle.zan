using System;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static void Main() {
        ChartOption option = ChartOption.Of("Live", new List<string>{"A", "B"}, new List<ChartSeries>{
            ChartSeries.Line("CPU", new List<int>{10, 20})
        });
        ChartController model = ChartController.Of(option);
        Console.WriteLine("initial:" + model.Status() + ":"
            + Convert.ToString(model.Version()) + ":"
            + Convert.ToString(!model.IsDisposed()));

        ChartOption snapshot = model.GetOption();
        snapshot.series[0].data[0].number = 99.0;
        Console.WriteLine("snapshot:" + Convert.ToString(model.Option().series[0].Number(0))
            + ":" + Convert.ToString(snapshot.series[0].Number(0)));

        model.AppendValues(0, new List<int>{30});
        Console.WriteLine("append:" + Convert.ToString(model.Version()) + ":"
            + Convert.ToString(model.Option().series[0].Count()));
        model.ShowLoading("fetching");
        Console.WriteLine("loading:" + model.Status() + ":" + model.StatusMessage());
        model.HideLoading();
        model.SetEmptyMessage("No rows");
        Console.WriteLine("empty:" + model.Status() + ":" + model.StatusMessage());
        model.SetErrorMessage("Offline");
        Console.WriteLine("error:" + model.Status() + ":" + model.StatusMessage());

        model.Restore();
        Console.WriteLine("restore:" + model.Status() + ":"
            + model.Option().title + ":"
            + Convert.ToString(model.Option().series[0].Count()) + ":"
            + Convert.ToString(model.Option().series[0].Value(0)));
        model.Clear();
        Console.WriteLine("clear:" + model.Status() + ":"
            + Convert.ToString(model.Option().series[0].Count()));
        model.Restore();
        model.SetOption(ChartOption.Bar("Next", new List<string>{"X"}));
        model.Clear();
        model.Restore();
        Console.WriteLine("baseline:" + model.Option().title + ":"
            + Convert.ToString(model.Option().series.Count));

        int before = model.Version();
        model.Dispose();
        model.AppendValues(0, new List<int>{7});
        model.ShowLoading("ignored");
        Console.WriteLine("dispose:" + model.Status() + ":"
            + Convert.ToString(model.IsDisposed()) + ":"
            + Convert.ToString(model.Version() == before + 1) + ":"
            + Convert.ToString(model.GetOption() == null));
    }
}
