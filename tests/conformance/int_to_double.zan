// Conformance: an integer meeting a floating-point destination is converted
// (C# implicit numeric conversion), not reinterpreted. Every path below used to
// store/pass the integer bit pattern -- `double b = 1;` read back as
// 4.94066e-324 and compared unequal to 1.0 -- or failed LLVM verification
// (a `double` parameter, `return 2;` from a `double` method, `2 * d`).
using System;

class Holder {
    public double v;
    public Holder(double x) { v = x; }
}

class Program {
    static double Take(double v) { return v; }
    static double Two() { return 2; }

    static void Main() {
        double b = 1;
        Console.WriteLine(Convert.ToString(b));            // 1
        if (b == 1.0) { Console.WriteLine("eq"); }         // eq

        float f = 1;
        Console.WriteLine(Convert.ToString(f));            // 1

        Console.WriteLine(Convert.ToString(Program.Take(2)));   // 2
        Console.WriteLine(Convert.ToString(Program.Two()));     // 2

        // mixed arithmetic computes in floating point either way round
        double d = 2.5;
        Console.WriteLine(Convert.ToString(d * 2));         // 5
        Console.WriteLine(Convert.ToString(2 * d));         // 5
        Console.WriteLine(Convert.ToString(d + 1));         // 3.5

        // field, constructor argument
        Holder h = new Holder(4);
        h.v = 3;
        Console.WriteLine(Convert.ToString(h.v));           // 3

        // collection element slots
        List<double> l = new List<double>();
        l.Add(1);
        Console.WriteLine(Convert.ToString(l[0] + 0.5));    // 1.5

        Dictionary<string, double> m = new Dictionary<string, double>();
        m["a"] = 1;
        Console.WriteLine(Convert.ToString(m["a"] + 0.5));  // 1.5

        double[] arr = new double[2];
        arr[0] = 2;
        Console.WriteLine(Convert.ToString(arr[0] + 0.5));  // 2.5

        decimal dec = 1;
        Console.WriteLine(Convert.ToString(dec));           // 1
    }
}
