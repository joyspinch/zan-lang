// 核心契约与语义定义。
// 核心契约与执行状态转移规范。
using System;
using System.Collections.Generic;

class Program {
    static void Main() {
        // 核心契约与语义定义。
        int Add(int a, int b) {
            return a + b;
        }
        Console.WriteLine(Add(19, 23));

        // 核心契约与执行状态转移规范。
        int Twice(int x) => x * 2;
        Console.WriteLine(Twice(21));

        // 核心契约与语义定义。
        Console.WriteLine(Sub(10, 4));
        int Sub(int a, int b) {
            return a - b;
        }

        // recursion
        int Fact(int n) {
            if (n <= 1) return 1;
            return n * Fact(n - 1);
        }
        Console.WriteLine(Fact(5));

        // 核心契约与执行状态转移规范。
        void Greet(string who) {
            Console.WriteLine("hi " + who);
        }
        Greet("bob");

        // 核心契约与执行状态转移规范。
        List<int> MakeList() {
            List<int> l = new List<int>();
            l.Add(1);
            l.Add(2);
            return l;
        }
        List<int> ml = MakeList();
        Console.WriteLine(ml.Count);

        // 核心契约与语义定义。
        T Identity<T>(T x) {
            return x;
        }
        Console.WriteLine(Identity<string>("id"));
        Console.WriteLine(Identity<int>(9));

        // 核心契约与语义定义。
        Console.WriteLine(Identity(42));
        Console.WriteLine(Identity("inf"));

        // 核心契约与执行状态转移规范。
        int[] Range() {
            int[] r = new int[3];
            r[0] = 7;
            r[1] = 8;
            r[2] = 9;
            return r;
        }
        int[] rr = Range();
        Console.WriteLine(rr[0] + rr[1] + rr[2]);

        Console.WriteLine("done");
    }
}
