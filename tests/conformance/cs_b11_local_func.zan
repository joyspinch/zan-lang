// cs_b11_local_func.zan -- C#-compat: local functions declared inside a
// method body are hoisted to the enclosing type as private static methods,
// so bare `Name(args)` calls inside the method resolve to them. Covers the
// keyword and identifier return types, expression bodies, recursion, forward
// calls, generic return types (`List<int>`), generic local functions
// (`T Identity<T>(T x)`) with both explicit and inferred type arguments, and
// array return types.
using System;
using System.Collections.Generic;

class Program {
    static void Main() {
        // keyword return type, block body
        int Add(int a, int b) {
            return a + b;
        }
        Console.WriteLine(Add(19, 23));

        // expression body
        int Twice(int x) => x * 2;
        Console.WriteLine(Twice(21));

        // forward call (hoisting makes the later definition visible)
        Console.WriteLine(Sub(10, 4));
        int Sub(int a, int b) {
            return a - b;
        }

        // recursion
        int Fact(int n) {
            if (n <= 1) return 1;
            return n * Fact(n - 1);
        }
        Console.WriteLine(Fact(5));

        // void local function
        void Greet(string who) {
            Console.WriteLine("hi " + who);
        }
        Greet("bob");

        // generic return type
        List<int> MakeList() {
            List<int> l = new List<int>();
            l.Add(1);
            l.Add(2);
            return l;
        }
        List<int> ml = MakeList();
        Console.WriteLine(ml.Count);

        // generic local function, explicit type args
        T Identity<T>(T x) {
            return x;
        }
        Console.WriteLine(Identity<string>("id"));
        Console.WriteLine(Identity<int>(9));

        // generic local function, inferred type args
        Console.WriteLine(Identity(42));
        Console.WriteLine(Identity("inf"));

        // array return type
        int[] Range() {
            int[] r = new int[3];
            r[0] = 7;
            r[1] = 8;
            r[2] = 9;
            return r;
        }
        int[] rr = Range();
        Console.WriteLine(rr[0] + rr[1] + rr[2]);

        Console.WriteLine("done");
    }
}
