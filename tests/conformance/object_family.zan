// A558：System.Object 方法族——ToString/Equals/GetHashCode 在 object/类/接口
// 接收者上的分派（身份 tag 候选链，同接口分派架构）。附带 A556-4 回归：
// `object x = new Struct{...}` 声明初始化必须装箱（栈临时不得逃进 object 槽）。
using System;
class Q {
    override string ToString() { return "Q!"; }
}
class Plain { }
class B {
    public override string ToString() { return "Bb"; }
}
class D : B { }
class P {
    int x;
    P(int v) { x = v; }
    override bool Equals(object other) {
        P o = other as P;
        if (o == null) { return false; }
        return o.x == this.x;
    }
}
struct Sn {
    public int V;
    public string ToString() { return "Sn" + V; }
}
struct Bare {
    public int V;
}
class Program {
    static int Main() {
        object a = new Q();
        Console.WriteLine(a.ToString());
        object p = new Plain();
        Console.WriteLine(p.ToString());
        object d = new D();
        Console.WriteLine(d.ToString());
        // A556-4：声明初始化直连装箱（带字段初始化式 / 纯构造两种形态）
        object sn = new Sn { V = 7 };
        Console.WriteLine(sn.ToString());
        Console.WriteLine(sn is Sn ? 1 : 0);
        object bare = new Bare { V = 3 };
        Console.WriteLine(bare.ToString());
        object sn2 = new Sn();
        Console.WriteLine(((Sn)sn2).V);
        object s = "hi";
        Console.WriteLine(s.ToString());
        Console.WriteLine(s.Equals("hi"));
        Console.WriteLine(s.Equals("ho"));
        Console.WriteLine(s.Equals(a));
        object q2 = new Q();
        Console.WriteLine(a.Equals(q2));
        Console.WriteLine(a.Equals(a));
        P p1 = new P(5);
        P p2 = new P(5);
        P p3 = new P(6);
        Console.WriteLine(p1.Equals(p2));
        Console.WriteLine(p1.Equals(p3));
        object p1o = p1;
        Console.WriteLine(p1o.Equals(p2));
        int h = a.GetHashCode();
        Console.WriteLine(h == a.GetHashCode());
        int h2 = q2.GetHashCode();
        Console.WriteLine(h == h2);
        return 0;
    }
}
