using System;
using System.Collections.Generic;
using System.Data;
using System.Globalization;
using System.Linq;
using System.Resources;
using System.Xml;

class Program {
    static void Main() {
        Console.WriteLine("=== ENTERPRISE ECOSYSTEM HARDENING TEST ===");

        // 1. DataFrame: AddColumn, AddStrRow, GroupBy, Aggregate
        Console.WriteLine("-- 1. DataFrame Pipeline --");
        DataFrame df = DataFrame.New();
        df.AddColumn("dept", ColKind.Str);
        df.AddColumn("salary", ColKind.Float);
        df.AddColumn("level", ColKind.Int);

        df.AddStrRow("Engineering", "15000.5", "5");
        df.AddStrRow("Engineering", "18000.0", "6");
        df.AddStrRow("Product", "12000.0", "4");

        Console.WriteLine("DataFrame rows: " + Convert.ToString(df.Rows()));
        Console.WriteLine("DataFrame colCount: " + Convert.ToString(df.ColCount()));
        List<RowGroup> groups = df.GroupBy("dept");
        Console.WriteLine("DataFrame groups: " + Convert.ToString(groups.Count));

        // 2. Globalization: Lunar & Lang
        Console.WriteLine("-- 2. Globalization --");
        LunarDate lunar = Lunar.FromSolar(2026, 2, 17);
        Console.WriteLine("Lunar YearGanZhi: " + lunar.YearGanZhi());
        Console.WriteLine("Lunar Zodiac: " + lunar.Zodiac());

        Lang.Set("zh");
        Console.WriteLine("Lang Code: " + Lang.Code());

        // 3. Linq: Stream Pipeline
        Console.WriteLine("-- 3. Linq Stream --");
        List<int> numbers = new List<int>();
        for (int i = 1; i <= 20; i = i + 1) { numbers.Add(i); }
        List<int> evens = numbers.AsStream()
            .Where((int x) => x % 2 == 0)
            .Skip(2)
            .Take(3)
            .ToList();
        Console.WriteLine("Linq Stream count: " + Convert.ToString(evens.Count));
        Console.WriteLine("Linq Stream item 0: " + Convert.ToString(evens[0]));

        // 4. Xml: XmlDocument Parse, Elements, Attributes, InnerText
        Console.WriteLine("-- 4. Xml Document --");
        string xmlText = "<order id=\"ORD-2026\"><item sku=\"SKU-01\">Keyboard</item><total currency=\"USD\">129.99</total></order>";
        XmlDocument doc = XmlDocument.Parse(xmlText);
        XmlNode root = doc.RootElement();
        if (root != null) {
            Console.WriteLine("Xml Root: " + root.name);
            Console.WriteLine("Xml Attr id: " + root.Attr("id"));
            XmlNode item = root.Element("item");
            if (item != null) {
                Console.WriteLine("Xml Item text: " + item.InnerText());
            }
        }

        // 5. Resources: MixKey & PackIndexEntry
        Console.WriteLine("-- 5. Resources --");
        byte[] mixed = ResourcePack.MixKey("ABCD", "1234", 4);
        Console.WriteLine("Resources MixKey len: " + Convert.ToString(mixed.Length - 1));
    }
}
