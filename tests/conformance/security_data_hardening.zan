using System;
using System.Collections.Generic;
using System.Json;
using System.Security;
using System.Security.Cryptography;
using System.Toml;
using System.Yaml;
using System.MsgPack;

class Program {
    static void Main() {
        Console.WriteLine("=== SECURITY, TOML, YAML & MSGPACK HARDENING TEST ===");

        // 1. AntiReverse: Mba, StatePoisoner, HoneyTrap
        Console.WriteLine("-- 1. AntiReverse Tools --");
        long a = 12345;
        long b = 12345;
        Console.WriteLine("Mba Eq: " + Convert.ToString(Mba.Eq(a, b)));
        Console.WriteLine("Mba Add: " + Convert.ToString(Mba.Add(100, 250)));
        Console.WriteLine("Mba Sub: " + Convert.ToString(Mba.Sub(500, 200)));
        Console.WriteLine("Mba OpaqueTrue(42): " + Convert.ToString(Mba.OpaqueTrue(42)));

        StatePoisoner sp = StatePoisoner.Create(999999);
        sp.Absorb(true, 101);
        sp.Absorb(true, 102);
        long factor = sp.ResolveFactor();
        Console.WriteLine("StatePoisoner factor valid: " + Convert.ToString(factor != 0));

        bool trap = HoneyTrap.VerifyRegistrationToken("admin", "ZN-123456");
        Console.WriteLine("HoneyTrap callable: " + Convert.ToString(trap || !trap));

        // 2. Cryptography: AesGcm
        Console.WriteLine("-- 2. AesGcm --");
        string key = "0123456789abcdef0123456789abcdef"; // 32 bytes (256-bit)
        string iv = "123456789012"; // 12 bytes
        string aad = "header_meta";
        string pt = "EnterprisePayload2026";
        byte[] tagBuf = new byte[16];
        string tagStr = tagBuf;
        byte[] ct = AesGcm.Encrypt(key, 32, iv, aad, aad.Length, pt, pt.Length, tagStr);
        if (ct != null) {
            Console.WriteLine("AesGcm ct length: " + Convert.ToString(ct.Length));
            List<int> ok = new List<int>();
            ok.Add(0);
            string ctStr = ct;
            byte[] decrypted = AesGcm.Decrypt(key, 32, iv, aad, aad.Length, ctStr, ct.Length, tagStr, ok);
            Console.WriteLine("AesGcm decrypt ok: " + Convert.ToString(ok[0] == -1));
            string decText = decrypted;
            Console.WriteLine("AesGcm decrypted: " + decText);
        }

        // 3. System.Toml
        Console.WriteLine("-- 3. Toml --");
        string tomlText = "title = \"Zan Config\"\r\n[server]\r\nport = 8080\r\nenabled = true\r\n";
        JsonValue tomlVal = Toml.Parse(tomlText);
        if (tomlVal != null) {
            JsonValue titleVal = tomlVal.Get("title");
            if (titleVal != null) {
                Console.WriteLine("Toml title: " + titleVal.strVal);
            }
            JsonValue srvVal = tomlVal.Get("server");
            if (srvVal != null) {
                JsonValue portVal = srvVal.Get("port");
                if (portVal != null) {
                    Console.WriteLine("Toml server.port: " + Convert.ToString((int)portVal.numI));
                }
            }
        }

        // 4. System.Yaml
        Console.WriteLine("-- 4. Yaml --");
        string yamlText = "name: ZanApp\nversion: 1.0.0\nflags:\n  - fast\n  - safe\n";
        JsonValue yamlVal = Yaml.Parse(yamlText);
        if (yamlVal != null) {
            JsonValue nameVal = yamlVal.Get("name");
            if (nameVal != null) {
                Console.WriteLine("Yaml name: " + nameVal.strVal);
            }
            JsonValue verVal = yamlVal.Get("version");
            if (verVal != null) {
                Console.WriteLine("Yaml version: " + verVal.strVal);
            }
        }

        // 5. System.MsgPack
        Console.WriteLine("-- 5. MsgPack --");
        JsonValue packObj = JsonValue.NewObject();
        packObj.Put("id", JsonValue.NewInt(10086));
        packObj.Put("status", JsonValue.NewStr("ACTIVE"));
        byte[] packed = MsgPack.Pack(packObj);
        Console.WriteLine("MsgPack bytes length: " + Convert.ToString(packed.Length));
        JsonValue unpacked = MsgPack.Unpack(packed);
        if (unpacked != null) {
            JsonValue idVal = unpacked.Get("id");
            if (idVal != null) {
                Console.WriteLine("MsgPack unpacked id: " + Convert.ToString((int)idVal.numI));
            }
            JsonValue stVal = unpacked.Get("status");
            if (stVal != null) {
                Console.WriteLine("MsgPack unpacked status: " + stVal.strVal);
            }
        }

        Console.WriteLine("ALL SECURITY, TOML, YAML & MSGPACK HARDENING CHECKS PASSED!");
    }
}
