using System;

class CtorDemandIndirectTarget {
    // On* remains callable under publish reflection policy.
    public void OnFail(string value) { throw new Exception(value); }
}

class CtorDemandIndirectThrowingCtor {
    public CtorDemandIndirectThrowingCtor(string value) { throw new Exception(value); }
}

class Program {
    static void Require(bool value, string message) {
        if (!value) throw new Exception(message);
    }

    static void ThrowDelegate(string value) { throw new Exception(value); }
    static void RelayDelegate(Action<string> callback, string value) { callback(value); }
    static void RelayReflection(object target, string value) { target.Invoke("OnFail", value); }
    static object RelayConstructor(TypeInfo type, string value) { return type.CreateInstance(value); }

    static void Main() {
        object target = new CtorDemandIndirectTarget();
        bool caught = false;
        try { RelayReflection(target, "literal"); }
        catch (Exception ex) { caught = true; }
        Require(caught, "reflection indirect unwind reaches local catch");
        caught = false;
        try { RelayReflection(target, "fresh-" + 19); }
        catch (Exception ex) { caught = true; }
        Require(caught, "reflection fresh argument unwind cleanup");
        Console.WriteLine("reflection PASS");

        Action<string> callback = ThrowDelegate;
        caught = false;
        try { RelayDelegate(callback, "delegate-" + 23); }
        catch (Exception ex) { caught = true; }
        Require(caught, "delegate relay preserves unwind edge");
        Console.WriteLine("delegate PASS");

        caught = false;
        try { RelayConstructor(typeof(CtorDemandIndirectThrowingCtor), "ctor-" + 29); }
        catch (Exception ex) { caught = true; }
        Require(caught, "constructor indirect unwind reaches local catch");
        Console.WriteLine("constructor PASS");
    }
}
