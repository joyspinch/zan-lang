using System;
using System.Linq;

class Program {
    static void Main() {
        List<int> numbers = new List<int>();
        for (int i = 1; i <= 5; i = i + 1) {
            numbers.Add(i);
        }

        Stream<int> stream = numbers.AsStream();

        // 1. Last / LastOrDefault
        Console.WriteLine("Last: " + Convert.ToString(stream.Last()));
        Console.WriteLine("LastOrDefault: " + Convert.ToString(stream.LastOrDefault(-1)));

        List<int> emptyList = new List<int>();
        Console.WriteLine("Empty LastOrDefault: " + Convert.ToString(emptyList.AsStream().LastOrDefault(99)));

        // 2. ElementAt / ElementAtOrDefault
        Console.WriteLine("ElementAt(2): " + Convert.ToString(stream.ElementAt(2)));
        Console.WriteLine("ElementAtOrDefault(10): " + Convert.ToString(stream.ElementAtOrDefault(10, 404)));

        // 3. Contains
        Console.WriteLine("Contains(3): " + Convert.ToString(stream.Contains(3)));
        Console.WriteLine("Contains(9): " + Convert.ToString(stream.Contains(9)));

        // 4. Append
        Stream<int> appended = stream.Append(100);
        Console.WriteLine("Appended Last: " + Convert.ToString(appended.Last()));

        // 5. Prepend
        Stream<int> prepended = stream.Prepend(200);
        Console.WriteLine("Prepended First: " + Convert.ToString(prepended.First()));

        // 6. Concat
        List<int> extra = new List<int>();
        extra.Add(301);
        extra.Add(302);
        Stream<int> combined = stream.Concat(extra.AsStream());
        Console.WriteLine("Combined Count: " + Convert.ToString(combined.Count()));
        Console.WriteLine("Combined Last: " + Convert.ToString(combined.Last()));
    }
}
