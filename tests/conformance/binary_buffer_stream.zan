using System;
using System.Buffers.Binary;

class Program {
    static void Main() {
        BinaryBufferWriter w = new BinaryBufferWriter(32);

        // 1. 占位报文头
        w.WriteInt32BE(0);

        // 2. 标量大端
        w.WriteInt8(-42);
        w.WriteUInt8(200);
        w.WriteInt16BE(-12345);
        w.WriteUInt16BE(54321);
        w.WriteInt32BE(0x12345678);
        w.WriteUInt32BE(3000000000L);
        w.WriteInt64BE(0x0102030405060708L);

        // 3. 标量小端
        w.WriteInt16LE(-12345);
        w.WriteUInt16LE(54321);
        w.WriteInt32LE(0x12345678);
        w.WriteUInt32LE(3000000000L);
        w.WriteInt64LE(0x0102030405060708L);

        // 4. Varint (Zigzag)
        w.WriteVarint32(0, true);
        w.WriteVarint32(-1, true);
        w.WriteVarint32(1, true);
        w.WriteVarint32(2147483647, true);
        w.WriteVarint32(-2147483648, true);

        w.WriteVarint64(0L, true);
        w.WriteVarint64(-999999999999L, true);
        w.WriteVarint64(999999999999L, true);

        // 5. 字符串与原始字节
        w.WriteStringUtf8("Hello, Zan Binary Buffer!");
        byte[] rawBytes = new byte[4];
        rawBytes[0] = (byte)10; rawBytes[1] = (byte)20; rawBytes[2] = (byte)30; rawBytes[3] = (byte)40;
        w.WriteBytes(rawBytes);

        // 6. 位压缩 (Bit packing MSB & LSB)
        w.WriteBit(true);
        w.WriteBit(false);
        w.WriteBit(true);
        w.WriteBit(true);
        w.WriteBit(false);
        w.WriteBit(false);
        w.WriteBit(false);
        w.WriteBit(true);
        w.FlushBits();

        w.WriteBitLSB(true);
        w.WriteBitLSB(false);
        w.WriteBitLSB(true);
        w.WriteBitLSB(true);
        w.WriteBitLSB(false);
        w.WriteBitLSB(false);
        w.WriteBitLSB(false);
        w.WriteBitLSB(true);
        w.FlushBitsLSB();

        // 7. 回填报文长度
        int payloadLen = w.Length() - 4;
        w.PatchInt32BE(0, payloadLen);

        byte[] payload = w.ToArray();

        // ---- 解码验证 ----
        BinaryBufferReader r = new BinaryBufferReader(payload);

        int hdrLen = r.ReadInt32BE();
        Console.WriteLine("hdrLen=" + hdrLen + " (match=" + (hdrLen == payloadLen) + ")");

        int v_i8 = r.ReadInt8();
        int v_u8 = r.ReadUInt8();
        int v_i16be = r.ReadInt16BE();
        int v_u16be = r.ReadUInt16BE();
        int v_i32be = r.ReadInt32BE();
        long v_u32be = r.ReadUInt32BE();
        long v_i64be = r.ReadInt64BE();
        Console.WriteLine("v_i8=" + v_i8);
        Console.WriteLine("v_u8=" + v_u8);
        Console.WriteLine("v_i16be=" + v_i16be);
        Console.WriteLine("v_u16be=" + v_u16be);
        Console.WriteLine("v_i32be=0x" + v_i32be);
        Console.WriteLine("v_u32be=" + v_u32be);
        Console.WriteLine("v_i64be=0x" + v_i64be);

        int v_i16le = r.ReadInt16LE();
        int v_u16le = r.ReadUInt16LE();
        int v_i32le = r.ReadInt32LE();
        long v_u32le = r.ReadUInt32LE();
        long v_i64le = r.ReadInt64LE();
        Console.WriteLine("v_i16le=" + v_i16le);
        Console.WriteLine("v_u16le=" + v_u16le);
        Console.WriteLine("v_i32le=0x" + v_i32le);
        Console.WriteLine("v_u32le=" + v_u32le);
        Console.WriteLine("v_i64le=0x" + v_i64le);

        int vi1 = r.ReadVarint32(true);
        int vi2 = r.ReadVarint32(true);
        int vi3 = r.ReadVarint32(true);
        int vi4 = r.ReadVarint32(true);
        int vi5 = r.ReadVarint32(true);
        Console.WriteLine("varint32: " + vi1 + ", " + vi2 + ", " + vi3 + ", " + vi4 + ", " + vi5);

        long vl1 = r.ReadVarint64(true);
        long vl2 = r.ReadVarint64(true);
        long vl3 = r.ReadVarint64(true);
        Console.WriteLine("varint64: " + vl1 + ", " + vl2 + ", " + vl3);

        string str = r.ReadStringUtf8(25);
        Console.WriteLine("str=" + str);

        byte[] gotBytes = r.ReadBytes(4);
        Console.WriteLine("bytes=" + gotBytes[0] + "," + gotBytes[1] + "," + gotBytes[2] + "," + gotBytes[3]);

        bool b1 = r.ReadBit();
        bool b2 = r.ReadBit();
        bool b3 = r.ReadBit();
        bool b4 = r.ReadBit();
        bool b5 = r.ReadBit();
        bool b6 = r.ReadBit();
        bool b7 = r.ReadBit();
        bool b8 = r.ReadBit();
        Console.WriteLine("bits_msb: " + b1 + "," + b2 + "," + b3 + "," + b4 + "," + b5 + "," + b6 + "," + b7 + "," + b8);

        bool lb1 = r.ReadBitLSB();
        bool lb2 = r.ReadBitLSB();
        bool lb3 = r.ReadBitLSB();
        bool lb4 = r.ReadBitLSB();
        bool lb5 = r.ReadBitLSB();
        bool lb6 = r.ReadBitLSB();
        bool lb7 = r.ReadBitLSB();
        bool lb8 = r.ReadBitLSB();
        Console.WriteLine("bits_lsb: " + lb1 + "," + lb2 + "," + lb3 + "," + lb4 + "," + lb5 + "," + lb6 + "," + lb7 + "," + lb8);

        Console.WriteLine("remaining=" + r.Remaining());
        Console.WriteLine("PASS: BinaryBufferReader and BinaryBufferWriter roundtrip ok");
    }
}
