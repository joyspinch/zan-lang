using System;

/* One async body with more open catch handlers than the old fixed frame limit
 * (8): the per-handler slots are sized from the body's try count, so handler 9
 * and up keep their caught exception across an await just like the first ones.
 * Both shapes matter -- sequential tries (many ids, one armed at a time) and
 * deeply nested tries (many armed at once, re-armed on every resume). */
class Boom : Exception {
    public int code;
    public Boom(int c) : base("boom" + Convert.ToString(c)) { this.code = c; }
}

class Program {
    static async int Bump(int x) {
        await Task.Delay(1);
        return x + 1;
    }

    /* 12 sequential try/catch regions, each awaiting inside the handler before
     * reading the caught exception again: the message printed after the
     * suspension must still be this handler's own. */
    static async string Sequential() {
        string acc = "";
        int n = 0;
        try { throw new Boom(1); } catch (Boom b) { n = await Bump(n); acc = acc + b.Message; }
        try { throw new Boom(2); } catch (Boom b) { n = await Bump(n); acc = acc + b.Message; }
        try { throw new Boom(3); } catch (Boom b) { n = await Bump(n); acc = acc + b.Message; }
        try { throw new Boom(4); } catch (Boom b) { n = await Bump(n); acc = acc + b.Message; }
        try { throw new Boom(5); } catch (Boom b) { n = await Bump(n); acc = acc + b.Message; }
        try { throw new Boom(6); } catch (Boom b) { n = await Bump(n); acc = acc + b.Message; }
        try { throw new Boom(7); } catch (Boom b) { n = await Bump(n); acc = acc + b.Message; }
        try { throw new Boom(8); } catch (Boom b) { n = await Bump(n); acc = acc + b.Message; }
        try { throw new Boom(9); } catch (Boom b) { n = await Bump(n); acc = acc + b.Message; }
        try { throw new Boom(10); } catch (Boom b) { n = await Bump(n); acc = acc + b.Message; }
        try { throw new Boom(11); } catch (Boom b) { n = await Bump(n); acc = acc + b.Message; }
        try { throw new Boom(12); } catch (Boom b) { n = await Bump(n); acc = acc + b.Message; }
        return Convert.ToString(n) + " " + acc;
    }

    /* 11 nested tries, all armed at once. The innermost throws and each level
     * rethrows after an await, so every level's handler is re-armed on every
     * resume and must land on its own catch. */
    static async int Nested() {
        int hops = 0;
        try {
            try {
                try {
                    try {
                        try {
                            try {
                                try {
                                    try {
                                        try {
                                            try {
                                                try {
                                                    throw new Boom(100);
                                                } catch (Boom b) { hops = await Bump(hops); throw; }
                                            } catch (Boom b) { hops = await Bump(hops); throw; }
                                        } catch (Boom b) { hops = await Bump(hops); throw; }
                                    } catch (Boom b) { hops = await Bump(hops); throw; }
                                } catch (Boom b) { hops = await Bump(hops); throw; }
                            } catch (Boom b) { hops = await Bump(hops); throw; }
                        } catch (Boom b) { hops = await Bump(hops); throw; }
                    } catch (Boom b) { hops = await Bump(hops); throw; }
                } catch (Boom b) { hops = await Bump(hops); throw; }
            } catch (Boom b) { hops = await Bump(hops); throw; }
        } catch (Boom b) {
            hops = await Bump(hops);
            /* the dynamic type and payload survived 11 rethrows across 11 awaits */
            return hops * 1000 + b.code;
        }
        return -1;
    }

    static async void Main() {
        Console.WriteLine(await Program.Sequential());
        Console.WriteLine(Convert.ToString(await Program.Nested()));
    }
}
