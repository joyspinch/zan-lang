using System;
using Gui;
using Game.Graphics;

namespace Conf;

// 多级泛光 Bloom3D：亮块周围的暗像素被照亮（光晕），随距离衰减（远处只剩极弱的大范围辉光），低于阈值的灰块不发光。
class GameBloomTest {
    [DllImport("zan_gui")]
    private static extern int zan_gui_read_pixel(int surfaceId, int x, int y);
    private static int Lum(int c) { return (((c >> 16) & 255) + ((c >> 8) & 255) + (c & 255)) / 3; }

    static void Main() {
        Canvas.SetBackend(1);
        Canvas cv = new Canvas(256, 128);
        cv.Clear(unchecked((int)0xFF000000));
        cv.FillRect(40, 54, 20, 20, unchecked((int)0xFFFFFFFF));    // 亮块
        cv.FillRect(180, 54, 20, 20, unchecked((int)0xFF505050));   // 暗灰块（低于阈值）
        int nearBefore = Lum(zan_gui_read_pixel(cv.SurfaceId(), 66, 64));
        int farBefore = Lum(zan_gui_read_pixel(cv.SurfaceId(), 128, 10));
        int grayNearBefore = Lum(zan_gui_read_pixel(cv.SurfaceId(), 206, 64));
        int done = cv.Bloom3D(0.7f, 0.2f, 1.0f, 1.0f);
        int nearAfter = Lum(zan_gui_read_pixel(cv.SurfaceId(), 66, 64));
        int farAfter = Lum(zan_gui_read_pixel(cv.SurfaceId(), 128, 10));
        int grayNearAfter = Lum(zan_gui_read_pixel(cv.SurfaceId(), 206, 64));
        int coreAfter = Lum(zan_gui_read_pixel(cv.SurfaceId(), 50, 64));
        Console.WriteLine("bloom-ran: " + (done == 1 ? "1" : "0"));
        Console.WriteLine("bloom-halo-around-bright: " + (nearAfter > nearBefore + 10 ? "1" : "0"));
        Console.WriteLine("bloom-falls-off-with-distance: " + ((farAfter - farBefore) <= 15 && (nearAfter - nearBefore) > (farAfter - farBefore) + 40 ? "1" : "0"));
        Console.WriteLine("bloom-below-threshold-no-glow: " + (Math.Abs(grayNearAfter - grayNearBefore) <= 3 ? "1" : "0"));
        Console.WriteLine("bloom-core-stays-bright: " + (coreAfter >= 250 ? "1" : "0"));
    }
}
