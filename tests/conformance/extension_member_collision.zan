using System;

interface IExecutor {
    RawResult Query(string sql);
}
interface IOverloadedExecutor {
    RawResult Query(string sql);
    RawResult Query(string sql, int parameter);
}
class RawResult {
    public int Value() { return 7; }
}
class Executor : IExecutor, IOverloadedExecutor {
    public RawResult Query(string sql) { return new RawResult(); }
    public RawResult Query(string sql, int parameter) { return new RawResult(); }
}
class Entity {}
class TypedQuery<T> {
    public int Count() { return 42; }
}
class Extensions {
    public static TypedQuery<T> Query<T>(this IExecutor executor) {
        return new TypedQuery<T>();
    }
    public static TypedQuery<T> Query<T>(this IOverloadedExecutor executor) {
        return new TypedQuery<T>();
    }
}
class Program {
    static void Main() {
        IExecutor executor = new Executor();
        TypedQuery<Entity> query = executor.Query<Entity>();
        Console.WriteLine(query.Count());
        Console.WriteLine(executor.Query("sql").Value());
        IOverloadedExecutor overloaded = new Executor();
        TypedQuery<Entity> other = overloaded.Query<Entity>();
        Console.WriteLine(other.Count());
        Console.WriteLine(overloaded.Query("sql", 1).Value());
    }
}
