using System;

// Retain/release pairs that only meet after inlining (late ARC pass):
// a getter returning a retained field used as a temporary, the same value
// held in a local, a null receiver on the soft-guard path, and an
// exception thrown while the object is held. Run with the leak check.
class Box {
    public long v;
    public Box(long x) { v = x; }
    public long Get() { return v; }
    public long GetOrThrow(long i) {
        if (i == 7) { throw new Exception("seven"); }
        return v;
    }
}

class Program {
    static Box cache = new Box(3);
    static Box none = null;
    static Box Make(long i) { return cache; }
    static Box MakeNull(long i) { return none; }

    static void Main() {
        long a = 0;
        for (long i = 0; i < 1000; i++) { a = a + Make(i).Get(); }
        Console.WriteLine(a);

        long b = 0;
        for (long i = 0; i < 1000; i++) { Box x = Make(i); b = b + x.Get(); }
        Console.WriteLine(b);

        int caught = 0;
        for (long i = 0; i < 10; i++) {
            try { a = a + Make(i).GetOrThrow(i); } catch (Exception e) { caught = caught + 1; }
        }
        Console.WriteLine(caught);

        int nulls = 0;
        try { a = a + MakeNull(0).Get(); } catch (Exception e) { nulls = nulls + 1; }
        Console.WriteLine(nulls);

        cache = new Box(5);
        Console.WriteLine(Make(0).Get());
    }
}
