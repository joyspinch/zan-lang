// Conformance: a delay at the edge of int64 must not wake early.
//
// `entry->due_ms = now_ms + delay_ms` used to be a plain int64 add: with
// `Task.Delay(long.MaxValue)` the addition overflows (UB) and wraps
// negative, so a due check of `due_ms <= now` would fire immediately.
// Per TASKS.md A271 the immediate-wake symptom was never actually
// observable on the shipped paths, but the arithmetic was still UB; the
// deadline computation now saturates to LLONG_MAX instead, and every
// scheduler/io wait that converts the resulting deadline into a
// DWORD/long Sleep argument clamps it (a modulo-2^32 truncation would
// park for a small bogus residue or wake early).
//
// The race pins the contract end to end: WhenAny must report the 150 ms
// task (index 1), and the huge task's body must still be unrun when the
// race is decided. The program then simply returns -- the huge task stays
// parked on its never-due delay while the process exits, which is the
// documented "sleep forever" reading of that delay. (Waiting on it is
// impossible by definition; a cancelled frame parked on a delay only
// re-steps when the delay fires, so draining it via CancelAll+WhenAll
// here would hang the test by construction.)
using System;

class Prog {
    static int wokeEarly;

    static async int HugeDelay() {
        await Task.Delay(9223372036854775807);
        Prog.wokeEarly = 1;
        return 1;
    }

    static async int SmallDelay() {
        await Task.Delay(150);
        return 2;
    }

    static async int Run() {
        List<long> race = new List<long>();
        race.Add(Task.Spawn(Prog.HugeDelay()));
        race.Add(Task.Spawn(Prog.SmallDelay()));
        int first = await Task.WhenAny(race);
        Console.WriteLine("winner=" + Convert.ToString(first));
        Console.WriteLine("wokeEarly=" + Convert.ToString(Prog.wokeEarly));
        return 0;
    }

    static void Main() {
        int r = await Prog.Run();
    }
}
