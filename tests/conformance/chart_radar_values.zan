// 雷达数据项值数组物化（官方语义）：radar 系列的每个 data 项是一条
// 独立多边形——对象项 {value:[每轴值], name} 或裸数组 [v0,v1,...]。
// 旧标量车道 Double("value") 对数组取 0，整图塌成圆心一个点（radar
// 主力 demo 即坏）。断言：
// ①对象项物化：1 系列×2 项 → 2 系列，系列名=数据项名（图例语义）；
// ②值 ×1000 定点（radarScaled），显式 radarMax 同步放大——渲染公式
//   val×g×r/(maxV×1000) 在 milli/milli 下约掉 g，0.46 小数不丢；
// ③radar.indicator[].name 进 radarNames，ECharts2 text 字段回退；
// ④裸数组项（radar-aqi 形态）：未命名项继承系列名（图例"同名系列
//   随主项一起开关"成立）；
// ⑤逐项 symbol/symbolSize 覆写落到物化系列（radar-custom）；
// ⑥Clone 全量携带 radarNames/radarScaled/物化系列；
// ⑦纯标量数据（旧格式）不触发物化、不置 radarScaled；
// ⑧radar 数组形态（ECharts5 多雷达，radar-multiple）：条目进
//   o.polars（center/radius/indicator），series.radarIndex 绑定
//   polarIndex，首条目回填 radarMax/radarNames，物化时
//   polars[].indicatorMax 同步 ×1000。
using System;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static void Main() {
        ChartOption o = ChartOption.FromJson("{\"radar\":{\"indicator\":[{\"name\":\"A\",\"max\":6500},{\"name\":\"B\",\"max\":16000}]},\"series\":[{\"type\":\"radar\",\"name\":\"Budget\",\"data\":[{\"value\":[4200,3000],\"name\":\"Allocated\"},{\"value\":[5000.5,12000],\"name\":\"Spending\"}]}]}");
        Console.WriteLine("split:" + Convert.ToString(o.series.Count) + ":"
            + Convert.ToString(o.series[0].name) + ":"
            + Convert.ToString(o.series[1].name));
        Console.WriteLine("scaled:" + Convert.ToString(o.radarScaled)
            + ":" + Convert.ToString(o.radarMax[0]) + ":"
            + Convert.ToString(o.series[0].Value(0)));
        Console.WriteLine("frac:" + Chart.FracText(o.series[1].Value(0)));
        Console.WriteLine("names:" + Convert.ToString(o.radarNames.Count)
            + ":" + o.radarNames[0] + ":" + o.radarNames[1]);

        ChartOption o2 = ChartOption.FromJson("{\"radar\":{\"indicator\":[{\"text\":\"T1\",\"max\":100},{\"text\":\"T2\",\"max\":100}]},\"series\":[{\"type\":\"radar\",\"name\":\"City\",\"data\":[[50,60],[70,30],[20,90]]}]}");
        Console.WriteLine("raw:" + Convert.ToString(o2.series.Count) + ":"
            + Convert.ToString(o2.series[2].name) + ":"
            + Convert.ToString(o2.series[2].Value(1)));
        Console.WriteLine("textfb:" + o2.radarNames[0] + ":"
            + Convert.ToString(o2.radarMax[0]));

        ChartOption o3 = ChartOption.FromJson("{\"radar\":{\"indicator\":[{\"name\":\"X\",\"max\":10}]},\"series\":[{\"type\":\"radar\",\"name\":\"S\",\"data\":[{\"value\":[8],\"symbol\":\"rect\",\"symbolSize\":12}]}]}");
        Console.WriteLine("itemovr:" + Convert.ToString(o3.series[0].symbol)
            + ":" + Convert.ToString(o3.series[0].symbolSize) + ":"
            + Convert.ToString(o3.series[0].Value(0)));

        ChartOption oc = ChartOption.Clone(o);
        if (oc == null) { return; }
        Console.WriteLine("clone:" + Convert.ToString(oc.radarScaled) + ":"
            + Convert.ToString(oc.radarNames.Count) + ":"
            + Convert.ToString(oc.series.Count));

        ChartOption o4 = ChartOption.FromJson("{\"series\":[{\"type\":\"radar\",\"name\":\"Plain\",\"data\":[1,2,3]}]}");
        Console.WriteLine("scalar:" + Convert.ToString(o4.series.Count) + ":"
            + Convert.ToString(o4.series[0].name) + ":"
            + Convert.ToString(o4.radarScaled));

        ChartOption o5 = ChartOption.FromJson("{\"radar\":[{\"indicator\":[{\"text\":\"Brand\",\"max\":100}],\"center\":[\"25%\",\"40%\"],\"radius\":80},{\"indicator\":[{\"name\":\"Look\",\"max\":50}],\"center\":[\"75%\",\"40%\"]}],\"series\":[{\"type\":\"radar\",\"data\":[{\"value\":[60],\"name\":\"A\"}]},{\"type\":\"radar\",\"radarIndex\":1,\"data\":[{\"value\":[40],\"name\":\"B\"}]}]}");
        Console.WriteLine("multi:" + Convert.ToString(o5.polars.Count)
            + ":" + o5.polars[0].indicatorText[0] + ":"
            + Convert.ToString(o5.series[1].polarIndex));
        Console.WriteLine("multimax:" + Convert.ToString(o5.radarMax[0]) + ":"
            + o5.radarNames[0] + ":" + Convert.ToString(o5.series[1].Value(0))
            + ":" + Convert.ToString(o5.polars[1].indicatorMax[0]));
    }
}
