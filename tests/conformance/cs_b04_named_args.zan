// A43-B4: C# named arguments `F(b: 2, x: 10)` -- arguments may appear in any
// order, bound by parameter name. Covers static/instance methods, default
// parameters, and constructors.
class Calc {
    public int baseVal;
    public Calc(int baseVal) { this.baseVal = baseVal; }
    public int Mul(int a, int b = 2) => a * b * baseVal;
    public static int Add(int x, int y) => x + y;
}

class Program {
    static int Div(int x, int y) => x / y;
    static void Greet(string name, string punct) {
        Console.WriteLine(name + punct);
    }
    static void Main() {
        Console.WriteLine(Div(y: 2, x: 10));    // 10/2 = 5
        Console.WriteLine(Div(10, y: 2));       // mixed positional + named
        Greet(punct: "!", name: "hi");          // all named, reversed
        Calc c = new Calc(3);
        Console.WriteLine(c.Mul(b: 5, a: 2));   // 2*5*3 = 30
        Console.WriteLine(c.Mul(4));            // default b: 4*2*3 = 24
        Console.WriteLine(Calc.Add(y: 100, x: 1));
        Calc d = new Calc(baseVal: 4);          // named ctor arg
        Console.WriteLine(d.Mul(3));            // 3*2*4 = 24
    }
}
