using System;

class Program {
    static readonly [256]float SrgbToLinear = comptime(BuildSrgbLut());
    static readonly [8]int Squares = comptime(BuildSquares<8>());

    static const int Fib(int n) {
        if (n <= 1) return n;
        return Fib(n - 1) + Fib(n - 2);
    }

    static const [256]float BuildSrgbLut() {
        [256]float lut = new InlineArray<256, float>();
        for (int i = 0; i < 256; i++) {
            double s = (double)i / 255.0;
            double lin = s <= 0.04045 ? (s / 12.92) : Math.Pow((s + 0.055) / 1.055, 2.4);
            lut[i] = (float)lin;
        }
        return lut;
    }

    static const [N]int BuildSquares<const int N>() {
        [N]int tbl = new InlineArray<N, int>();
        for (int i = 0; i < N; i++) {
            tbl[i] = (i + 1) * (i + 1);
        }
        return tbl;
    }

    static void Main() {
        int cfib = comptime(Fib(10));
        int rt_n = 7;
        int rfib = Fib(rt_n);
        int expr = comptime((1 << 8) + 3 * 14);
        Console.WriteLine($"fib:{cfib},{rfib},expr:{expr}");

        // Sample .rodata sRGB LUT (0 -> 0, 128 -> ~0.21586, 255 -> 1.0)
        int s0 = (int)(SrgbToLinear[0] * 1000.0f);
        int s128 = (int)(SrgbToLinear[128] * 1000.0f);
        int s255 = (int)(SrgbToLinear[255] * 1000.0f);
        Console.WriteLine($"srgb:{s0},{s128},{s255}");

        // Sample const-generic .rodata table
        Console.WriteLine($"sq:{Squares[0]},{Squares[3]},{Squares[7]}");
    }
}
