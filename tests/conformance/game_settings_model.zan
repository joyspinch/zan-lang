using System;
using System.Collections.Generic;
using System.IO;
using Game.Foundation;

namespace Tests.GameSettingsModel;

// 设置面板逻辑层的契约测试：
//   声明 → 档位行（布尔两档 / 整数按范围枚举 / 枚举项照搬 / 文本项不成行）；
//   选档 → 写回 + 存盘；非法下标与越界值一律被拒；
//   恢复默认 → 行上的当前档同步回默认值；存盘读回。
class Program {
    static void Main() {
        string dir = "game_settings_model_test";
        Directory.CreateDirectory(dir);
        string cfg = dir + "/settings.json";
        if (File.Exists(cfg)) { File.Delete(cfg); }

        GameSettings s = new GameSettings().At(cfg);
        s.AddBool("sound", "音效", true);
        s.AddInt("depth", "难度", 2, 1, 4, 1);
        s.AddIntChoice("delay", "思考延迟", 500,
            new List<int> { 200, 500, 900 });
        s.AddOption("mode", "模式", "easy",
            new List<string> { "easy", "normal", "hard" });
        s.AddText("name", "昵称", "玩家");

        SettingsModel m = new SettingsModel(s);
        SettingRow rBool = m.RowAt(0);
        SettingRow rInt = m.RowAt(1);
        SettingRow rDelay = m.RowAt(2);
        SettingRow rOpt = m.RowAt(3);
        Console.WriteLine("rows=" + Convert.ToString(m.Count()));
        Console.WriteLine("bool=" + rBool.CurrentLabel()
            + "," + Convert.ToString(rBool.Current));
        Console.WriteLine("int=" + rInt.CurrentLabel()
            + "," + Convert.ToString(rInt.Current));
        // 离散整数档位：声明的三档就是全部候选
        Console.WriteLine("delay=" + rDelay.CurrentLabel()
            + "," + Convert.ToString(rDelay.Current)
            + "," + Convert.ToString(rDelay.ChoiceCount()));
        Console.WriteLine("opt=" + rOpt.CurrentLabel()
            + "," + Convert.ToString(rOpt.Current));

        // 选第三档难度 → 写回并存盘
        Console.WriteLine("select=" + Convert.ToString(m.Select(1, 2) ? 1 : 0));
        Console.WriteLine("after=" + rInt.CurrentLabel()
            + "," + Convert.ToString(rInt.Current));

        // 非法下标 / 越界行号都不该改状态
        Console.WriteLine("invalid=" + Convert.ToString(m.Select(1, 9) ? 1 : 0)
            + "," + Convert.ToString(m.Select(99, 0) ? 1 : 0));

        // 按键 + 值写回
        Console.WriteLine("byKey=" + Convert.ToString(m.SelectValue("mode", "hard") ? 1 : 0)
            + "," + rOpt.CurrentLabel());

        // 越界值写不进去
        Console.WriteLine("guard=" + Convert.ToString(s.SetValue("depth", "99") ? 1 : 0));

        // 离散整数档位只认声明过的那几档
        Console.WriteLine("guardChoice=" + Convert.ToString(s.SetValue("delay", "300") ? 1 : 0)
            + "," + Convert.ToString(s.SetValue("delay", "900") ? 1 : 0));

        // 恢复默认：行上的当前档同步回来
        m.ResetAll();
        Console.WriteLine("reset=" + rInt.CurrentLabel()
            + "," + rOpt.CurrentLabel()
            + "," + Convert.ToString(s.GetBool("sound") ? 1 : 0));

        // 存盘读回
        GameSettings s2 = new GameSettings().At(cfg);
        s2.AddBool("sound", "音效", true);
        s2.AddInt("depth", "难度", 2, 1, 4, 1);
        s2.AddOption("mode", "模式", "easy",
            new List<string> { "easy", "normal", "hard" });
        s2.Load();
        Console.WriteLine("reloaded=" + Convert.ToString(s2.GetInt("depth"))
            + "," + s2.GetText("mode"));
    }
}
