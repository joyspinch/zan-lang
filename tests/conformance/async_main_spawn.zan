// A coroutine spawned from an `async Main` must run: async Main is driven on
// the scheduler (ramp + sched_run), not inlined at the root where `await
// Task.Delay` lowers to a bare sleep that never services the ready queue.
using System;

class AsyncMainSpawn {
    static bool up = false;

    static async void Side() {
        await Task.Delay(20);
        up = true;
    }

    static async int Main() {
        Task.Spawn(AsyncMainSpawn.Side());
        int spins = 0;
        while (!up && spins < 200) {
            await Task.Delay(10);
            spins = spins + 1;
        }
        Console.WriteLine("spawned ran: " + Convert.ToString(up));
        return 0;
    }
}
