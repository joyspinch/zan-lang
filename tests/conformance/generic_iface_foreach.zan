using System;
using System.Collections.Generic;
class StrEnum : IEnumerator<string> {
    string[] items; int pos;
    public StrEnum(string[] src) { items = src; pos = -1; }
    public bool MoveNext() {
        if (pos + 1 >= items.Length) { return false; }
        pos = pos + 1;
        return true;
    }
    public string Current() { return items[pos]; }
}
class Words : IEnumerable<string> {
    string[] items;
    public Words(string[] src) { items = src; }
    public IEnumerator<string> GetEnumerator() { return new StrEnum(items); }
}
class Box<T> : IEnumerable<T> {
    T[] items;
    public Box(T[] src) { items = src; }
    public IEnumerator<T> GetEnumerator() { return new BoxEnum<T>(items); }
}
class BoxEnum<T> : IEnumerator<T> {
    T[] items; int pos;
    public BoxEnum(T[] src) { items = src; pos = -1; }
    public bool MoveNext() {
        if (pos + 1 >= items.Length) { return false; }
        pos = pos + 1;
        return true;
    }
    public T Current() { return items[pos]; }
}
class Z9 {
    static int Main() {
        Words w = new Words(new string[] { "a", "bb", "ccc" });
        int chars = 0;
        foreach (string s in w) { chars = chars + s.Length; }
        Console.WriteLine("chars=" + chars);
        Box<int> b = new Box<int>(new int[] { 5, 6, 7 });
        int bi = 0;
        foreach (int x in b) { bi = bi * 10 + x; }
        Console.WriteLine("bi=" + bi);
        return chars == 6 && bi == 567 ? 0 : 1;
    }
}
