using System;

struct Item {
    public string Name;
    public void Set(string v) {
        Name = v;
    }
}

struct Outer {
    public Item Inner;
    public long N;
}

class Rec {
    static Item Make(string n) {
        Item it;
        it.Name = n;
        return it;
    }

    static string Take(Item it) {
        return it.Name;
    }

    static void Bump(Item it) {
        it.Name = it.Name + "!";
    }

    static void Main() {
        // field write into an owning struct local; no leak, value survives
        Item a;
        a.Name = "x" + Convert.ToString(1);
        Console.WriteLine(a.Name);
        // by-value param: the callee copy cannot disturb the caller
        Console.WriteLine(Take(a));
        Bump(a);
        Console.WriteLine(a.Name);
        // struct return: the receiver owns the returned fields
        Item b = Make("mk" + Convert.ToString(2));
        Console.WriteLine(b.Name);
        // whole-struct assignment: both stay valid, no double release
        Item c;
        c = b;
        Console.WriteLine(c.Name);
        // instance-method field write through the borrowed receiver
        a.Set("sf" + Convert.ToString(3));
        Console.WriteLine(a.Name);
        // object initializer field write
        Item d = new Item { Name = "oi" + Convert.ToString(4) };
        Console.WriteLine(d.Name);
        // nested struct with an rc field, whole-struct store
        Outer o;
        o.Inner = a;
        o.N = 7;
        Console.WriteLine(o.Inner.Name + Convert.ToString(o.N));
        // overwriting a field releases the old occupant exactly once
        a.Name = "second";
        Console.WriteLine(a.Name);
        Console.WriteLine("A341-DONE");
    }
}
