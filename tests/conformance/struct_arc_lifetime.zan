using System;

struct Item {
    public string Name;
    public void Set(string v) {
        Name = v;
    }
}

struct Outer {
    public Item Inner;
    public long N;
}

class Rec {
    static Item Make(string n) {
        Item it;
        it.Name = n;
        return it;
    }

    static string Take(Item it) {
        return it.Name;
    }

    static void Bump(Item it) {
        it.Name = it.Name + "!";
    }

    static void Main() {
        Item a;
        a.Name = "x" + Convert.ToString(1);
        Console.WriteLine(a.Name);
        Console.WriteLine(Take(a));
        Bump(a);
        Console.WriteLine(a.Name);
        Item b = Make("mk" + Convert.ToString(2));
        Console.WriteLine(b.Name);
        Item c;
        c = b;
        Console.WriteLine(c.Name);
        a.Set("sf" + Convert.ToString(3));
        Console.WriteLine(a.Name);
        Item d = new Item { Name = "oi" + Convert.ToString(4) };
        Console.WriteLine(d.Name);
        Outer o;
        o.Inner = a;
        o.N = 7;
        Console.WriteLine(o.Inner.Name + Convert.ToString(o.N));
        a.Name = "second";
        Console.WriteLine(a.Name);
        Console.WriteLine("A341-DONE");
    }
}
