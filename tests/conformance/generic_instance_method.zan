// 核心契约与语义定义。
//
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
using System;
using System.Collections.Generic;

class Conn {
    public int id;
    public string Name() { return "conn"; }
}

class Other {
    public int id;
    public string Name() { return "other"; }
}

class Pool {
    public int tag;
    public List<string> log;

    public Pool() { this.log = new List<string>(); }

    public string Describe<T>(T c) {
        this.log.Add(c.Name());
        return Convert.ToString(this.tag) + ":" + c.Name();
    }

    public int IdOf<T>(T c) { return c.id + this.tag; }

    // 接口数据协议与执行契约。
    public string Both<T>(T c) {
        return this.Describe<T>(c) + "/" + Convert.ToString(this.IdOf<T>(c));
    }

    // 接口数据协议与执行契约。
    public string Unqualified<T>(T c) { return Describe<T>(c); }

    public Pool Self() { return this; }
}

class Program {
    static void Main() {
        Pool p = new Pool();
        p.tag = 7;
        Conn c = new Conn();
        c.id = 3;
        Other o = new Other();
        o.id = 100;

        Console.WriteLine(p.Describe<Conn>(c));
        Console.WriteLine(p.Describe<Other>(o));
        Console.WriteLine(Convert.ToString(p.IdOf<Conn>(c)));
        Console.WriteLine(p.Both<Other>(o));
        Console.WriteLine(p.Unqualified<Conn>(c));
        // 核心契约与语义定义。
        Console.WriteLine(p.Self().Describe<Conn>(c));
        Console.WriteLine("log=" + Convert.ToString(p.log.Count));
    }
}
