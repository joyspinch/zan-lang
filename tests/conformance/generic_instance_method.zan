// Conformance: monomorphization of *instance* generic methods (A7-1).
//
// A generic method whose body reaches into its own type parameter has no
// erased form; until now only static ones were specialized and an instance one
// was rejected outright. The specialized copy now takes `this` as its first
// parameter, so the receiver (a local, an expression, or the implicit `this`
// of an unqualified call) is passed through like any other argument.
using System;
using System.Collections.Generic;

class Conn {
    public int id;
    public string Name() { return "conn"; }
}

class Other {
    public int id;
    public string Name() { return "other"; }
}

class Pool {
    public int tag;
    public List<string> log;

    public Pool() { this.log = new List<string>(); }

    public string Describe<T>(T c) {
        this.log.Add(c.Name());
        return Convert.ToString(this.tag) + ":" + c.Name();
    }

    public int IdOf<T>(T c) { return c.id + this.tag; }

    // forwards its own type parameter to another template
    public string Both<T>(T c) {
        return this.Describe<T>(c) + "/" + Convert.ToString(this.IdOf<T>(c));
    }

    // unqualified call: the receiver is the implicit `this`
    public string Unqualified<T>(T c) { return Describe<T>(c); }

    public Pool Self() { return this; }
}

class Program {
    static void Main() {
        Pool p = new Pool();
        p.tag = 7;
        Conn c = new Conn();
        c.id = 3;
        Other o = new Other();
        o.id = 100;

        Console.WriteLine(p.Describe<Conn>(c));
        Console.WriteLine(p.Describe<Other>(o));
        Console.WriteLine(Convert.ToString(p.IdOf<Conn>(c)));
        Console.WriteLine(p.Both<Other>(o));
        Console.WriteLine(p.Unqualified<Conn>(c));
        // receiver is an arbitrary expression, not a local
        Console.WriteLine(p.Self().Describe<Conn>(c));
        Console.WriteLine("log=" + Convert.ToString(p.log.Count));
    }
}
