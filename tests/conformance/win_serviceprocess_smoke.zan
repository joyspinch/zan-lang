// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。
using System;
using System.ServiceProcess;

namespace Conf;

class Prog {
    static int bad = 0;

    static void Check(bool cond) {
        if (!cond) { bad = bad + 1; }
    }

    static void Main() {
        List<ServiceInfo> all = ServiceProcess.List();
        // 核心契约与语义定义。
        Check(all.Count > 0);
        // 核心契约与语义定义。
        bool sawRunning = false;
        int i = 0;
        for (; i < all.Count; i = i + 1) {
            if (all[i].state == 4) { sawRunning = true; }
        }
        Check(sawRunning);
        // 核心契约与语义定义。
        i = 0;
        while (i < all.Count) {
            Check(all[i].name.Length > 0);
            Check(all[i].state >= 1 && all[i].state <= 7);
            i = i + 1;
        }
        // 核心契约与语义定义。
        string probe = all[0].name;
        ServiceInfo g = ServiceProcess.Get(probe);
        Check(g != null && g.name == probe);
        // 核心契约与语义定义。
        Check(ServiceProcess.Get("ZanNoSuchService_42") == null);
        // 核心契约与语义定义。
        Check(ServiceProcess.StateName(1) == "Stopped");
        Check(ServiceProcess.StateName(4) == "Running");
        Console.WriteLine("win-serviceprocess-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
