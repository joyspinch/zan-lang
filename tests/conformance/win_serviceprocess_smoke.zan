// ServiceProcess smoke test: enumeration must return services, Get() must
// find a real service by name and return null for a missing one, and the
// state mapping must be stable. Read-only: never starts/stops/deletes.
using System;
using System.ServiceProcess;

namespace Conf;

class Prog {
    static int bad = 0;

    static void Check(bool cond) {
        if (!cond) { bad = bad + 1; }
    }

    static void Main() {
        List<ServiceInfo> all = ServiceProcess.List();
        // A real Windows box always has services.
        Check(all.Count > 0);
        // At least one is running (system services are up).
        bool sawRunning = false;
        int i = 0;
        for (; i < all.Count; i = i + 1) {
            if (all[i].state == 4) { sawRunning = true; }
        }
        Check(sawRunning);
        // Every entry has a non-empty name and a valid state code.
        i = 0;
        while (i < all.Count) {
            Check(all[i].name.Length > 0);
            Check(all[i].state >= 1 && all[i].state <= 7);
            i = i + 1;
        }
        // Get() by exact name must round-trip.
        string probe = all[0].name;
        ServiceInfo g = ServiceProcess.Get(probe);
        Check(g != null && g.name == probe);
        // Get() on a missing service returns null.
        Check(ServiceProcess.Get("ZanNoSuchService_42") == null);
        // State names are stable.
        Check(ServiceProcess.StateName(1) == "Stopped");
        Check(ServiceProcess.StateName(4) == "Running");
        Console.WriteLine("win-serviceprocess-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
