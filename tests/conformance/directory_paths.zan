// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
using System;
using System.IO;
namespace Conf;

class Program {
    static string Basenames(List<string> paths) {
        string s = "";
        for (int i = 0; i < paths.Count; i = i + 1) {
            if (i > 0) { s = s + "|"; }
            s = s + Path.GetFileName(paths[i]);
        }
        return s;
    }

    static void Main() {
        string root = "_d22probe";
        Directory.DeleteRecursive(root);
        Directory.CreateDirectoryRecursive(root + "/sub");
        File.WriteAllText(root + "/a.txt", "1");
        File.WriteAllText(root + "/b.txt", "2");
        File.WriteAllText(root + "/sub/c.txt", "3");

        // 接口数据协议与执行契约。
        List<string> files = Directory.GetPaths(root);
        Console.WriteLine("files=" + Convert.ToString(files.Count));
        Console.WriteLine("allPrefixed=" + (Basenames(files) == "a.txt|b.txt").ToString());
        bool allFull = true;
        for (int i = 0; i < files.Count; i = i + 1) {
            if (!files[i].StartsWith(root + "/")) { allFull = false; }
        }
        Console.WriteLine("allFull=" + allFull.ToString());

        // directories
        List<string> dirs = Directory.GetDirectoryPaths(root);
        Console.WriteLine("dirs=" + Convert.ToString(dirs.Count));
        Console.WriteLine("dirFull=" + (dirs[0] == root + "/sub").ToString());

        // 核心契约与语义定义。
        Console.WriteLine((File.ReadAllText(files[0]) == "1").ToString());

        // 接口数据协议与执行契约。
        List<string> bare = Directory.GetFiles(root);
        Console.WriteLine("bare=" + (bare[0] == "a.txt" || bare[1] == "a.txt").ToString());
        List<string> bareDirs = Directory.GetDirectories(root);
        Console.WriteLine("bareDir=" + (bareDirs[0] == "sub").ToString());

        // 核心契约与语义定义。
        Console.WriteLine("missing=" + Convert.ToString(Directory.GetPaths(root + "/nope").Count));
        Console.WriteLine("missingD=" + Convert.ToString(Directory.GetDirectoryPaths(root + "/nope").Count));

        Directory.DeleteRecursive(root);
        Console.WriteLine("cleaned=" + (!Directory.Exists(root)).ToString());
    }
}
