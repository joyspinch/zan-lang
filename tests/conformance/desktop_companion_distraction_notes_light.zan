using System;
using System.Collections.Generic;
using System.Windows;

class Program {
    static int Main() {
        // 1. 专注中断归因与纯度评分器
        CompanionPomodoroDistractionLog log = new CompanionPomodoroDistractionLog(1000);
        log.RecordInterruption("chat_ping", true, 50);
        log.RecordInterruption("daydream", false, 50);
        int ext = log.ExternalCount();
        int intr = log.InternalCount();
        int score = log.FocusIntegrityScore(); // 100 - 10(时长) - 8(2次切换) = 82
        bool logOk = ext == 1 && intr == 1 && score == 82;
        Console.WriteLine("distraction_log_ok=" + (logOk ? "1" : "0"));

        // 2. 桌面便签置顶排序与一键归档已完成条目
        CompanionDesktopNotePinboard board = new CompanionDesktopNotePinboard();
        int n1 = board.AddNote("buy coffee");
        int n2 = board.AddNote("ship release");
        int n3 = board.AddNote("reply email");
        board.SetPinned(n2, true);
        List<int> ord = board.OrderedActiveNoteIds(); // [n2, n1, n3]
        board.MarkCompleted(n1, true);
        int archived = board.ArchiveCompletedNotes();
        bool boardOk = ord.Count == 3 && ord[0] == n2 && ord[1] == n1 && ord[2] == n3
            && archived == 1 && board.ActiveCount() == 2 && board.ArchivedCount() == 1;
        Console.WriteLine("note_pinboard_ok=" + (boardOk ? "1" : "0"));

        // 3. 昼夜节律亮度与色温平滑调度器
        CompanionAmbientLightSchedule sched = new CompanionAmbientLightSchedule(1080, 1200, 360, 1.0f, 0.40f);
        float dayB = sched.BrightnessAt(720);     // 12:00 -> 1.0
        float duskB = sched.BrightnessAt(1140);   // 19:00 半黄昏 -> 0.70
        float nightB = sched.BrightnessAt(120);   // 02:00 深夜 -> 0.40
        int dayK = sched.ColorKelvinAt(720);      // 6500K
        int nightK = sched.ColorKelvinAt(120);    // 2900K
        bool schedOk = dayB > 0.99f && duskB > 0.69f && duskB < 0.71f
            && nightB > 0.39f && nightB < 0.41f
            && dayK == 6500 && nightK == 2900;
        Console.WriteLine("ambient_schedule_ok=" + (schedOk ? "1" : "0"));
        return 0;
    }
}
