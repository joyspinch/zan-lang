    static async void CompileManual(WechatPayV2Client v2) {
        WechatPayLegacyRedPackApi red = new WechatPayLegacyRedPackApi(v2);
        WechatPayLegacyProfitSharingApi profit = new WechatPayLegacyProfitSharingApi(v2);
        WechatPayV2Request request = new WechatPayV2Request();
        WechatRawResponse a = await red.SendNormalRedPackAsync(request);
        WechatRawResponse b = await red.SendGroupRedPackAsync(request);
        WechatRawResponse c = await red.SearchRedPackAsync(request);
        WechatRawResponse d = await red.SendMiniAppRedPackAsync(request);
        WechatRawResponse e = await red.SendNormalRedPackViaProviderAsync(request);
        WechatRawResponse f = await red.HbPreOrderAsync(request);
        WechatRawResponse g = await red.SendWorkRedPackAsync(request);
        WechatRawResponse h = await red.QueryWorkRedPackAsync(request);
        WechatRawResponse i = await profit.ProfitSharingAsync(request);
        WechatRawResponse j = await profit.MultiProfitSharingAsync(request);
        WechatRawResponse k = await profit.ProfitSharingFinishAsync(request);
        WechatRawResponse l = await profit.ProfitSharingAddReceiverAsync(request);
        WechatRawResponse n = await profit.ProfitSharingRemoveReceiverAsync(request);
        WechatRawResponse o = await profit.ProfitSharingQueryAsync(request);
    }

    static void Main() {
        WechatPayV2Config v2cfg = new WechatPayV2Config("wx", "mch", "key");
        v2cfg.SetAppSecret("secret").SetNotifyUrls("pay", "mini")
             .SetServiceProviderCredentials("sub-app", "sub-secret", "sub-mch");
        WechatPayV2Request request = new WechatPayV2Request();
        request.Set("appid", "wx").Set("body", "test")
               .Set("mch_id", "mch").Set("nonce_str", "abc");
        Console.WriteLine("v2-md5=" + request.Sign("key", "MD5"));
        Console.WriteLine("v2-hmac=" + request.Sign("key", "HMAC-SHA256"));

        WechatPayV3Config v3cfg = new WechatPayV3Config("wx", "mch", "serial",
            PrivatePem(), "0123456789abcdef0123456789abcdef");
        v3cfg.SetAppSecret("secret").SetLegacyMerchantKey("legacy-key")
             .SetNotifyUrls("pay-notify", "mini-notify")
             .SetServiceProviderCredentials("sub-app", "sub-secret", "sub-mch")
             .SetPlatformPublicKey("platform-1", CertificatePem());
        WechatPayV3Client v3 = new WechatPayV3Client(v3cfg);
        Console.WriteLine("config=" + Convert.ToString(v3cfg.SubAppSecret == "sub-secret"));
        Console.WriteLine("platform=" + Convert.ToString(v3.HasPlatformPublicKey("platform-1")));
        string auth = v3.BuildAuthorization("GET", "/v3/certificates", "",
            1700000000, "nonce");
        Console.WriteLine("auth=" + Convert.ToString(auth.StartsWith("WECHATPAY2-SHA256-RSA2048")));

        WechatPayNotification notice = WechatPayNotification.Parse(
            "{\"id\":\"notice-1\",\"event_type\":\"TRANSACTION.SUCCESS\","
            + "\"resource\":{\"algorithm\":\"AEAD_AES_256_GCM\",\"ciphertext\":\"\","
            + "\"nonce\":\"\",\"associated_data\":\"\"}}");
        Console.WriteLine("notice=" + notice.Id + "/" + notice.EventType);

        string nativeUrl = WechatPayLegacyUtilities.NativePay("wx", "1", "mch",
            "n", "p", "s");
        Console.WriteLine("native=" + Convert.ToString(nativeUrl.StartsWith("weixin://wxpay/")));
        string jsSign = WechatPayLegacyUtilities.GetJsPaySign("wx", "1", "n",
            "prepay_id=x", "key", "MD5");
        Console.WriteLine("js-sign=" + Convert.ToString(jsSign.Length == 32));
        string repayment = WechatPaySpecialBuilders.CreateVehicleParkingRepaymentPath(
            "wx", "mch", "openid", "nonce");
        Console.WriteLine("parking=" + Convert.ToString(repayment.StartsWith("pages/invest_list/")));
        string medical = WechatPaySpecialBuilders.CreateMedicalInsurancePayPackage(
            v3, "mix", "prepay", "wx", true);
        Console.WriteLine("medical=" + Convert.ToString(medical.Length > 40));

        WechatPayConfigRegistry registry = new WechatPayConfigRegistry();
        registry.AddV2("v2", v2cfg).AddV3("v3", v3cfg);
        Console.WriteLine("registry=" + Convert.ToString(registry.GetV3("v3") != null));
        Console.WriteLine("generated=45");
    }
}
