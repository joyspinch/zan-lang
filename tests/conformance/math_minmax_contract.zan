using System;

class MathMinMaxContract {
    static string Pick(int value) { return "int"; }
    static string Pick(long value) { return "long"; }
    static string Pick(double value) { return "double"; }

    static int ReturnInt(int a, int b) { return Math.Min(a, b); }
    static long ReturnLong(int a, long b) { return Math.Max(a, b); }
    static double ReturnDouble(long a, double b) { return Math.Min(a, b); }
    static int OnlyInt(int value) { return value; }
    static long OnlyLong(long value) { return value; }

    static void Main() {
        int a = 7;
        int b = -9;
        int imin = Math.Min(a, b);
        int imax = Math.Max(a, b);
        int literal = Math.Max(-9, 7);
        if (imin != -9 || imax != 7 || literal != 7) {
            throw new Exception("int values");
        }
        Console.WriteLine("int values ok");
        Console.WriteLine("int variable " + Pick(Math.Min(a, b)));
        Console.WriteLine("int literal " + Pick(Math.Max(1, 2)));
        var inferredInt = Math.Min(7, -9);
        Console.WriteLine("int inferred " + Pick(inferredInt));
        Console.WriteLine("int nested " + Pick(Math.Max(Math.Min(a, b), 0)));
        Console.WriteLine("int chain " + Math.Min(a, b).ToString());
        Console.WriteLine("int return " + ReturnInt(a, b));
        Console.WriteLine("int downstream " + OnlyInt(Math.Max(a, b)));

        long low = 9007199254740993L;
        long high = 9007199254740995L;
        long lmin = Math.Min(low, high);
        long lmax = Math.Max(low, high);
        if (lmin != low || lmax != high || Math.Min(high, low) != low ||
            Math.Max(high, low) != high ||
            Math.Max(9007199254740993L, 9007199254740995L) != high ||
            Math.Min(9007199254740993L, 9007199254740995L) != low ||
            Math.Min(-9007199254740995L, -9007199254740993L) != -high) {
            throw new Exception("long precision");
        }
        Console.WriteLine("long precision ok");
        Console.WriteLine("long variable " + Pick(Math.Max(low, high)));
        Console.WriteLine("long literal " + Pick(Math.Min(1L, 2L)));
        Console.WriteLine("mixed integer " + Pick(Math.Max(a, high)));
        Console.WriteLine("mixed integer reverse " + Pick(Math.Min(high, a)));
        var inferredLong = Math.Max(a, high);
        Console.WriteLine("long inferred " + Pick(inferredLong));
        Console.WriteLine("long nested " + Pick(Math.Min(Math.Max(a, high), low)));
        if (ReturnLong(a, high) != high || OnlyLong(Math.Max(a, high)) != high) {
            throw new Exception("long downstream precision");
        }
        Console.WriteLine("long return and downstream ok");

        double d = 1.5;
        float f = 2.5f;
        double mixed = Math.Max(a, d);
        double reverse = Math.Min(d, a);
        double floatPair = Math.Max(f, 1.0f);
        if (mixed != 7.0 || reverse != 1.5 || floatPair != 2.5 ||
            ReturnDouble(high, d) != 1.5) {
            throw new Exception("mixed floating values");
        }
        Console.WriteLine("mixed floating values ok");
        Console.WriteLine("double variable " + Pick(Math.Max(a, d)));
        Console.WriteLine("double literal " + Pick(Math.Min(2, 1.5)));
        Console.WriteLine("long double " + Pick(Math.Max(high, d)));
        Console.WriteLine("float pair " + Pick(Math.Min(f, 1.0f)));
        var inferredDouble = Math.Min(a, d);
        Console.WriteLine("double inferred " + Pick(inferredDouble));
        Console.WriteLine("double nested " + Pick(Math.Min(Math.Max(a, d), 3.0)));
    }
}
