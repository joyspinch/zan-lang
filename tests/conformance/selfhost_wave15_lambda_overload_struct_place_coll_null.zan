using System;
using System.Collections.Generic;
using System.Text;

delegate int IntSel(short x);
delegate string StrSel(short x);

struct W15Inner {
    public long Value;
}

struct W15Outer {
    public W15Inner Inner;
}

class W15Box {
    public W15Outer Outer;
}

class Program {
    static string Pick(short v, StrSel f) { return "str:" + f(v); }
    static string Pick(short v, IntSel f) { return "int:" + f(v); }

    static string PickFunc(short v, Func<short, string> f) { return "fstr:" + f(v); }
    static string PickFunc(short v, Func<short, int> f) { return "fint:" + f(v); }

    static void SetRef(ref long slot, long next) { slot = next; }

    static void Main() {
        // 1. Numeric lambda return-type overload scoring (short -> int over string)
        Console.WriteLine(Pick(7, (short x) => x));
        Console.WriteLine(Pick(7, (short x) => "ok"));
        Console.WriteLine(PickFunc(9, (short x) => x));
        Console.WriteLine(PickFunc(9, (short x) => "ok"));

        // 2. Collection & StringBuilder null-receiver guards inside & outside try
        List<int> nl = null;
        Dictionary<string, int> nd = null;
        StringBuilder nsb = null;
        int collCaught = 0;
        try { int c = nl.Count; } catch (Exception) { collCaught = collCaught + 1; }
        try { int c = nd.Count; } catch (Exception) { collCaught = collCaught + 1; }
        try { var k = nd.Keys; } catch (Exception) { collCaught = collCaught + 1; }
        try { var v = nd.Values; } catch (Exception) { collCaught = collCaught + 1; }
        try { int l = nsb.Length; } catch (Exception) { collCaught = collCaught + 1; }
        Console.WriteLine("coll_try=" + collCaught);
        Console.WriteLine("coll_soft=" + nl.Count + "," + nd.Count + "," + nsb.Length);

        // 3. Nested struct place on null class/array inside try -> NullReferenceException
        W15Box nullBox = null;
        int caught = 0;
        try {
            nullBox.Outer.Inner.Value = 11;
        } catch (Exception) {
            caught = caught + 1;
        }
        try {
            SetRef(ref nullBox.Outer.Inner.Value, 13);
        } catch (Exception) {
            caught = caught + 1;
        }
        W15Outer[] nullArr = null;
        try {
            nullArr[0].Inner.Value = 17;
        } catch (Exception) {
            caught = caught + 1;
        }
        Console.WriteLine("struct_try=" + caught);

        // Outside try: repeated null-box nested struct stores + ref + read must not crash
        nullBox.Outer.Inner.Value = 31;
        SetRef(ref nullBox.Outer.Inner.Value, 37);
        Console.WriteLine("struct_soft=" + (nullBox.Outer.Inner.Value == 37));

        // 4. string methods with null receiver (Contains / IndexOf) + normal paths
        string ns = null;
        string s = "alpha,beta";
        Console.WriteLine("str_contains=" + ns.Contains("a") + "," + ns.Contains("") + "," + s.Contains("beta"));
        Console.WriteLine("str_index=" + ns.IndexOf("a") + "," + s.IndexOf("beta"));
    }
}
