// A381: params 与可选实参的组合——params 尾参之前的可选形参在调用缺省时
// 填默认值，params 数组收剩余实参（0 个收空数组）。此前 fill_default_args
// 对 params 方法整体跳过、method_accepts_arity 把 params 当固定 arity，
// "int a, int b = 10, params int[] rest" 以 1 个实参调用直接解析失败。
class Comb {
    public static int P2(int a, int b = 10, params int[] rest) {
        int s = a * 100 + b;
        for (int i = 0; i < rest.Length; i++) { s = s + rest[i]; }
        return s;
    }

    public static int P1(int a, params int[] rest) {
        int s = a;
        for (int i = 0; i < rest.Length; i++) { s = s + rest[i]; }
        return s;
    }

    public static int P0(params int[] rest) { return rest.Length; }
}

class Program {
    static void Main() {
        Console.WriteLine(Comb.P2(1));          // b 默认 10，params 空数组
        Console.WriteLine(Comb.P2(1, 2));       // b 显式 2，params 空数组
        Console.WriteLine(Comb.P2(1, 2, 3, 4)); // b=2，params=[3,4]
        Console.WriteLine(Comb.P1(1));          // params 空数组
        Console.WriteLine(Comb.P1(1, 2, 3));    // params=[2,3]
        Console.WriteLine(Comb.P0());           // params 空数组
        Console.WriteLine(Comb.P0(9, 8));       // params=[9,8]
    }
}
