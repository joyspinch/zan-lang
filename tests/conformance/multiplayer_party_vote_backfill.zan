using System;
using Game.Net;

class Program {
    static int Main() {
        // 1. 小队房主权限与自动迁移
        NetPartyLeaderDelegator party = new NetPartyLeaderDelegator(10, 3);
        bool j1 = party.Join(20);
        bool j2 = party.Join(30);
        bool jFull = !party.Join(40); // 满员拒绝
        bool nonLeaderKick = !party.Kick(20, 30); // 非房主踢人拒绝
        bool leaderKick = party.Kick(10, 30); // 房主踢人成功
        party.Leave(10); // 房主掉线 -> 自动迁移给 20
        bool partyOk = j1 && j2 && jFull && nonLeaderKick && leaderKick
            && party.LeaderId == 20 && party.MemberCount() == 1;
        Console.WriteLine("party_leader_ok=" + (partyOk ? "1" : "0"));

        // 2. 提前投降投票机：最小时间锁、数学提前判负、冷却后重投并提前判胜
        NetSurrenderVoteBox vote = new NetSurrenderVoteBox(5, 4, 180000L, 60000L);
        bool earlyBlocked = !vote.StartVote(1, 60000L);
        bool started = vote.StartVote(1, 200000L);
        bool dupBlocked = !vote.CastVote(1, true, 201000L);
        vote.CastVote(2, false, 202000L);
        vote.CastVote(3, false, 203000L); // 2 反对 -> 最多 3 赞成 < 4，立即判负并进 60s 冷却
        bool failedEarly = vote.State == VoteResolution.Failed;
        bool cooldownBlocked = !vote.StartVote(4, 240000L);

        // 冷却结束后重新发起，4 票赞成立即通过
        bool restarted = vote.StartVote(1, 270000L);
        vote.CastVote(2, true, 271000L);
        vote.CastVote(3, true, 272000L);
        vote.CastVote(4, true, 273000L);
        bool passedEarly = vote.State == VoteResolution.Passed;

        bool voteOk = earlyBlocked && started && dupBlocked && failedEarly
            && cooldownBlocked && restarted && passedEarly;
        Console.WriteLine("surrender_vote_ok=" + (voteOk ? "1" : "0"));

        // 3. 残局热补位匹配队列：MMR 容差、人数匹配与满员自动移出
        NetMatchmakingBackfillQueue bf = new NetMatchmakingBackfillQueue(200);
        bf.RegisterOpenLobby(501, 1, 1500);
        bf.RegisterOpenLobby(502, 2, 1600);
        int missMmr = bf.TryAssignBackfill(1, 2200); // 超出 MMR 差值 -> -1
        int duoMatch = bf.TryAssignBackfill(2, 1550); // 501 只有 1 席，命中 502 且 502 满员移出
        int soloMatch = bf.TryAssignBackfill(1, 1450); // 命中 501 且 501 满员移出
        bool bfOk = missMmr == -1 && duoMatch == 502 && soloMatch == 501 && bf.OpenLobbyCount() == 0;
        Console.WriteLine("backfill_queue_ok=" + (bfOk ? "1" : "0"));
        return 0;
    }
}
