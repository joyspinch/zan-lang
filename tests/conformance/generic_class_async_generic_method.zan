// 核心契约与语义定义。
// 接口数据协议与执行契约。
using System;

class Item {
    public int id;
    public Item(int id) { this.id = id; }
    public string Show() { return "Item(" + id + ")"; }
}

class Pool<T> {
    public T item;
    public Pool(T v) { this.item = v; }

    // 接口数据协议与执行契约。
    public async T Get<U>(U tagv) { return item; }

    // 核心契约与语义定义。
    public async string Wrap<U>(U x) {
        T keep = item;
        U tail = x;
        await Task.Delay(1);
        return keep.ToString() + "/" + tail.ToString();
    }

    // 接口数据协议与执行契约。
    public async T Hold<U>(U x) {
        T keep = item;
        await Task.Delay(1);
        return keep;
    }

    // 接口数据协议与执行契约。
    public async string Chain<U>(U x) { return await Wrap<U>(x); }

    public async string Caught<U>(U x) {
        try {
            await Task.Delay(1);
            throw new Exception("bad " + x.ToString());
        } catch (Exception e) {
            return "caught " + e.Message + " over " + item.ToString();
        }
    }
}

class Program {
    static async void Main() {
        Pool<string> ps = new Pool<string>("hello");
        Pool<int> pi = new Pool<int>(4);
        Pool<Item> po = new Pool<Item>(new Item(11));

        Console.WriteLine(await ps.Get<int>(1));
        Console.WriteLine(await pi.Get<string>("k"));
        Item it = await po.Get<int>(2);
        Console.WriteLine(it.Show());

        Console.WriteLine(await ps.Wrap<int>(2));
        Console.WriteLine(await pi.Wrap<string>("y"));

        Console.WriteLine(await ps.Hold<int>(0));
        Console.WriteLine(await pi.Hold<string>("z"));
        Item held = await po.Hold<int>(0);
        Console.WriteLine(held.Show());

        Console.WriteLine(await ps.Chain<string>("tail"));
        Console.WriteLine(await pi.Chain<int>(6));

        Console.WriteLine(await ps.Caught<int>(3));
        Console.WriteLine("done");
    }
}
