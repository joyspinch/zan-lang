using System;
using System.Json;
using Sdk.Taobao;
using Sdk.Taobao.Api.Channel;
using Sdk.Taobao.Api.Fenxiao;
using Sdk.Taobao.Api.FenxiaoDealer;
using Sdk.Taobao.Api.Fuwu;
using Sdk.Taobao.Api.Inventory;
using Sdk.Taobao.Api.Item;
using Sdk.Taobao.Api.Miniapp;
using Sdk.Taobao.Api.Promotion;
using Sdk.Taobao.Api.Refund;
using Sdk.Taobao.Api.Shop;
using Sdk.Taobao.Api.Subuser;
using Sdk.Taobao.Api.Tmc;
using Sdk.Taobao.Api.UniversalbpAccount;
using Sdk.Taobao.Api.UniversalbpAdgroup;
using Sdk.Taobao.Api.UniversalbpCampaign;
using Sdk.Taobao.Api.UniversalbpCreative;
using Sdk.Taobao.Api.UniversalbpKeyword;
using Sdk.Taobao.Api.UniversalbpReport;

class Program {
    static void Main() {
        TaobaoClient client = new TaobaoClient("k", "s").SetSession("sess");

        ChannelApi channelApi = new ChannelApi(client);
        FenxiaoApi fenxiaoApi = new FenxiaoApi(client);
        FenxiaoDealerApi fenxiaoDealerApi = new FenxiaoDealerApi(client);
        FuwuApi fuwuApi = new FuwuApi(client);
        InventoryApi inventoryApi = new InventoryApi(client);
        ItemApi itemApi = new ItemApi(client);
        MiniappApi miniappApi = new MiniappApi(client);
        PromotionApi promotionApi = new PromotionApi(client);
        RefundApi refundApi = new RefundApi(client);
        ShopApi shopApi = new ShopApi(client);
        SubuserApi subuserApi = new SubuserApi(client);
        TmcApi tmcApi = new TmcApi(client);
        UniversalbpAccountApi ubpAccApi = new UniversalbpAccountApi(client);
        UniversalbpAdgroupApi ubpAdgApi = new UniversalbpAdgroupApi(client);
        UniversalbpCampaignApi ubpCmpApi = new UniversalbpCampaignApi(client);
        UniversalbpCreativeApi ubpCrtApi = new UniversalbpCreativeApi(client);
        UniversalbpKeywordApi ubpKwdApi = new UniversalbpKeywordApi(client);
        UniversalbpReportApi ubpRptApi = new UniversalbpReportApi(client);

        // 1. Overlapping API (Topsdk primary): taobao.appstore.subscribe.get
        TaobaoAppstoreSubscribeGetRequest subReq = new TaobaoAppstoreSubscribeGetRequest()
            .Nick("tb_nick")
            .LeaseId(1001L);
        subReq.Validate();

        // 2. net-auto-only API with shared domain struct: taobao.fuwu.purchase.order.confirm
        TaobaoFuwuPurchaseOrderConfirmRequest confReq = new TaobaoFuwuPurchaseOrderConfirmRequest()
            .ParamOrderConfirmQueryDTO(new OrderConfirmQueryDtoParam().AppKey("k").ItemCode("item1"));
        confReq.Validate();

        // 3. Universalbp struct request: taobao.universalbp.account.get.balance
        TaobaoUniversalbpAccountGetBalanceRequest balReq = new TaobaoUniversalbpAccountGetBalanceRequest()
            .TopServiceContext(new TaobaoUniversalbpAccountGetBalanceTopServiceContextParam().BizCode("onebp"));
        balReq.Validate();

        if (channelApi == null || fenxiaoApi == null || fenxiaoDealerApi == null || fuwuApi == null
            || inventoryApi == null || itemApi == null || miniappApi == null || promotionApi == null
            || refundApi == null || shopApi == null || subuserApi == null || tmcApi == null
            || ubpAccApi == null || ubpAdgApi == null || ubpCmpApi == null || ubpCrtApi == null
            || ubpKwdApi == null || ubpRptApi == null) {
            Console.WriteLine("api=null");
            return;
        }

        Console.WriteLine("taobao-modules=18");
    }
}
