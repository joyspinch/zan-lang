using System;
using System.Json;

namespace Conf;

class Program {
    static void Main() {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("code", 0);
        w.WriteProperty("msg", "ok");
        w.WriteProperty("active", true);
        w.WriteNullProperty("extra");
        w.WritePropertyName("data");
        w.WriteStartObject();
        w.WriteProperty("id", 1001);
        w.WriteProperty("name", "Alice \"The Engineer\"\n\t");
        w.WritePropertyName("tags");
        w.WriteStartArray();
        w.WriteString("admin");
        w.WriteString("dev");
        w.WriteEndArray();
        w.WriteEndObject();
        w.WriteRawProperty("meta", "{\"version\":1}");
        w.WriteEndObject();

        string json = w.ToJson();
        Console.WriteLine(json);

        // 使用 JsonDoc 验证解析往返
        JsonDoc doc = JsonDoc.Parse(json);
        Console.WriteLine(Convert.ToString(doc.PathInt("code", -1)));
        Console.WriteLine(doc.PathStr("msg", ""));
        Console.WriteLine(Convert.ToString(doc.PathBool("active", false)));
        Console.WriteLine(Convert.ToString(doc.PathInt("data.id", 0)));
        Console.WriteLine(doc.PathStr("data.name", ""));
        Console.WriteLine(doc.PathStr("data.tags[0]", ""));
        Console.WriteLine(doc.PathStr("data.tags[1]", ""));
        Console.WriteLine(Convert.ToString(doc.PathInt("meta.version", 0)));

        // 测试复用与重置 (Reset)
        w.Reset();
        w.WriteStartArray();
        w.WriteInt(10);
        w.WriteInt(20);
        w.WriteInt(30);
        w.WriteEndArray();
        Console.WriteLine(w.ToJson());
    }
}
