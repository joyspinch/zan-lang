using System;
using System.Threading;

class Program {
    static void Main() {
        int val = 0;
        Task t = Task.Run(delegate () {
            Thread.Sleep(50);
            val = 42;
        });

        // The task runs in the background worker pool
        t.Wait();
        Console.WriteLine("val=" + val);
        Console.WriteLine("done=" + t.IsCompleted);

        // Multiple tasks
        int c1 = 0;
        int c2 = 0;
        Task t1 = Task.Run(delegate () {
            Thread.Sleep(30);
            c1 = 100;
        });
        Task t2 = Task.Run(delegate () {
            Thread.Sleep(30);
            c2 = 200;
        });
        t1.Wait();
        t2.Wait();
        Console.WriteLine("c1=" + c1 + " c2=" + c2);

        Console.WriteLine("task-bg-ok: 1");
    }
}
