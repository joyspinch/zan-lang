using System;

class Program {
    static void Main() {
        char a = 'A';
        string sa = a.ToString();
        Console.WriteLine("sa=" + sa);
        Console.WriteLine("len=" + sa.Length.ToString());

        char z = 'z';
        string sz = z.ToString();
        Console.WriteLine("sz=" + sz);

        char zero = '0';
        string s0 = zero.ToString();
        Console.WriteLine("s0=" + s0);
    }
}
