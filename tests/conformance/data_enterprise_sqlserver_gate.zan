using System;
using System.Data;
using System.Data.SqlServer;

class Program {
    static async void Main() {
        SqlServerConnection c = new SqlServerConnection();
        bool rejected = false;
        try { await c.QueryAsync("SELECT 1"); } catch (DbException) { rejected = true; }
        if (!rejected) { throw new Exception("disconnected query reported success"); }
        rejected = false;
        try { await c.ExecuteAsync("SELECT ?", new DbParams().AddInt(1)); }
        catch (DbException) { rejected = true; }
        if (!rejected) { throw new Exception("disconnected execute reported success"); }
        rejected = false;
        try { await c.BeginTransactionAsync(); } catch (DbException) { rejected = true; }
        if (!rejected || c.inTxn) { throw new Exception("failed BEGIN recorded transaction"); }
        c.Close();
        rejected = false;
        try { await c.ExecuteAsync("SELECT 1"); } catch (DbException) { rejected = true; }
        if (!rejected) { throw new Exception("closed command reported success"); }
        c.Dispose();
        Console.WriteLine("SQL Server command failures release gate and propagate");
    }
}
