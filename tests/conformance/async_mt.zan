// 核心契约与语义定义。
// 核心契约与执行状态转移规范。
using System;
using System.Net.Sockets;

class Program {
    static async int Echo() {
        Socket.Initialize();

        nint listener = Socket.CreateTcp();
        Socket.SetReuseAddr(listener);
        Socket.Bind(listener, "127.0.0.1", 44500);
        Socket.Listen(listener, 8);
        Socket.SetNonBlocking(listener);

        nint client = Socket.CreateTcp();
        Socket.SetNonBlocking(client);
        // 核心契约与语义定义。
        int rc = await Socket.ConnectAsync(client, "localhost", 44500);

        nint server = await Socket.AcceptAsync(listener);
        Socket.SetNonBlocking(server);

        await Task.Delay(20);   // timer path inside the worker pool

        int sent = await Socket.SendStringAsync(client, "PING");
        string req = await Socket.RecvAsync(server, 64);
        int echoed = await Socket.SendStringAsync(server, req);
        string reply = await Socket.RecvAsync(client, 64);

        // 核心契约与语义定义。
        int ip = await Socket.ResolveAsync("localhost");
        int sync = Socket.ResolveIpv4("localhost");

        if (reply == "PING" && ip == sync && ip != 0 && rc == 0) {
            Console.WriteLine("OK");
        } else {
            Console.WriteLine("FAIL reply=" + reply + " rc=" + rc +
                              " ip=" + ip + " sync=" + sync);
        }

        Socket.Close(client);
        Socket.Close(server);
        Socket.Close(listener);
        Socket.Cleanup();
        return 0;
    }

    static void Main() {
        int r = await Echo();
    }
}
