using System;

class Lazy {
    public static int stamp = Init("field");
    public static int late;
    static int Init(string w) {
        Console.WriteLine("static-init:" + w);
        return 5;
    }
    static Lazy() {
        Console.WriteLine("static-ctor");
        late = stamp * 2;
    }
}

class Unused {
    public static int ghost = 77;
    static Unused() {
        Console.WriteLine("unused-ctor-RAN");
    }
}

class Other {
    public static int v = 1;
}

class Program {
    static void Main() {
        Console.WriteLine("main-start");
        Console.WriteLine("other=" + Convert.ToString(Other.v));
        Console.WriteLine("touch");
        Console.WriteLine("stamp=" + Convert.ToString(Lazy.stamp));
        Console.WriteLine("late=" + Convert.ToString(Lazy.late));
        Console.WriteLine("end");
    }
}
