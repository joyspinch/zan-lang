using System;

class Program {
    static int Main() {
        // 1. int.TryParse
        int iv;
        bool r1 = int.TryParse("12345", out iv);
        Console.WriteLine(r1 ? "int:ok:" + iv.ToString() : "int:fail");

        bool r2 = int.TryParse("-9876", out iv);
        Console.WriteLine(r2 ? "int_neg:ok:" + iv.ToString() : "int_neg:fail");

        bool r3 = int.TryParse("123abc", out iv);
        Console.WriteLine(r3 ? "int_bad:ok" : "int_bad:fail:" + iv.ToString());

        bool r4 = int.TryParse(null, out iv);
        Console.WriteLine(r4 ? "int_null:ok" : "int_null:fail:" + iv.ToString());

        bool r5 = int.TryParse("99999999999", out iv);
        Console.WriteLine(r5 ? "int_over:ok" : "int_over:fail:" + iv.ToString());

        // 2. long.TryParse
        long lv;
        bool rl1 = long.TryParse("9223372036854775807", out lv);
        Console.WriteLine(rl1 ? "long:ok:" + lv.ToString() : "long:fail");

        bool rl2 = long.TryParse("-9223372036854775808", out lv);
        Console.WriteLine(rl2 ? "long_neg:ok:" + lv.ToString() : "long_neg:fail");

        bool rl3 = long.TryParse("999999999999999999999999", out lv);
        Console.WriteLine(rl3 ? "long_over:ok" : "long_over:fail:" + lv.ToString());

        // 3. double.TryParse
        double dv;
        bool rd1 = double.TryParse("3.14159", out dv);
        Console.WriteLine(rd1 ? "dbl:ok" : "dbl:fail");

        bool rd2 = double.TryParse("invalid", out dv);
        Console.WriteLine(rd2 ? "dbl_bad:ok" : "dbl_bad:fail:" + dv.ToString());

        bool rd3 = double.TryParse(null, out dv);
        Console.WriteLine(rd3 ? "dbl_null:ok" : "dbl_null:fail:" + dv.ToString());

        // 4. bool.TryParse
        bool bv;
        bool rb1 = bool.TryParse("True", out bv);
        Console.WriteLine(rb1 && bv ? "bool_true:ok" : "bool_true:fail");

        bool rb2 = bool.TryParse("FALSE", out bv);
        Console.WriteLine(rb2 && !bv ? "bool_false:ok" : "bool_false:fail");

        bool rb3 = bool.TryParse("notabool", out bv);
        Console.WriteLine(rb3 ? "bool_bad:ok" : "bool_bad:fail");

        bool rb4 = bool.TryParse(null, out bv);
        Console.WriteLine(rb4 ? "bool_null:ok" : "bool_null:fail");

        // 5. StringExtensions
        Console.WriteLine("ext_int:" + "42".ToInt32(99).ToString());
        Console.WriteLine("ext_int_fb:" + "invalid".ToInt32(99).ToString());
        string nullStr = null;
        Console.WriteLine("ext_int_null:" + nullStr.ToInt32(99).ToString());
        Console.WriteLine("ext_long:" + "1234567890123".ToInt64(0L).ToString());
        Console.WriteLine("ext_long_fb:" + "bad_long".ToInt64(888L).ToString());

        return 0;
    }
}
