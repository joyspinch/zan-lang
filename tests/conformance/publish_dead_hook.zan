using System;

// The hook owner is neither instantiated nor reflected. On* spelling alone
// must not keep either body or the allocation graph reachable in publish mode.
class PublishDeadHookOwner {
    public void OnPaint() {
        Console.WriteLine("PUBLISH_DEAD_HOOK_ONPAINT_MUST_BE_DEAD");
    }

    public void OnUnusedAllocate() {
        Console.WriteLine("PUBLISH_DEAD_HOOK_ONUNUSED_MUST_BE_DEAD");
        PublishDeadHookPayload payload = new PublishDeadHookPayload();
    }
}

class PublishDeadHookPayload {
    public PublishDeadHookPayload() {
        Console.WriteLine("PUBLISH_DEAD_HOOK_PAYLOAD_MUST_BE_DEAD");
    }
}

class Program {
    static int Main() {
        Console.WriteLine("publish dead hook PASS");
        return 0;
    }
}
