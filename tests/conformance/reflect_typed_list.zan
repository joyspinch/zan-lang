using System;
using System.Collections.Generic;

enum TypedListState { Below = -7, Ready = 9 }

class TypedListRow {
    public string Name;
    public List<TypedListRow> Children;
}

struct TypedListPair {
    public long Left;
    public long Right;
    public TypedListPair(long left, long right) {
        Left = left;
        Right = right;
    }
    public long Sum() { return Left + Right; }
}

[StructLayout(LayoutKind.Explicit)]
struct TypedListExplicit {
    [FieldOffset(0)] public long Raw;
}

struct TypedBoxedArc {
    public TypedListRow Row;
    public decimal Price;
    public TypedBoxedArc(TypedListRow row, decimal price) {
        Row = row;
        Price = price;
    }
}

class ValueReflectionHolder {
    public static decimal StaticPrice = (decimal)12.5;
    public static TypedListPair StaticPair = new TypedListPair(10L, 20L);
    public static int? StaticOpt = 42;

    public TypedListPair Pair = new TypedListPair(1L, 2L);
    public decimal Amount = (decimal)3.25;
    public int? OptInt = null;
    public decimal? OptDec = (decimal)7.5;
    public TypedListPair? OptPair = null;
    public TypedBoxedArc ArcStruct;

    public decimal PropAmount {
        get { return Amount; }
        set { Amount = value; }
    }
    public TypedListPair PropPair {
        get { return Pair; }
        set { Pair = value; }
    }
    public int? PropOpt {
        get { return OptInt; }
        set { OptInt = value; }
    }

    public decimal Scale(decimal factor, int? bias) {
        int b = bias != null ? (int)bias : 0;
        return Amount * factor + (decimal)b;
    }
    public TypedListPair MakePair(long a, long b) {
        return new TypedListPair(a, b);
    }
    public TypedListPair? MaybePair(bool make) {
        if (!make) return null;
        return new TypedListPair(100L, 200L);
    }
    public static decimal StaticDouble(decimal x) {
        return x + StaticPrice;
    }
}

class TypedListFieldChild {
    public List<int> Values = new List<int>();
}

class TypedListFieldOwner {
    public List<List<int>> Items = new List<List<int>>();
    public TypedListFieldChild Child = new TypedListFieldChild();
}

class TypedListThrowingCtor {
    public TypedListThrowingCtor(string text) { throw new Exception(text); }
}

class TypedListCalls {
    public string Name;
    public TypedListCalls(string name) { Name = name; }
    public int Length(string text) { return text.Length; }
    public int Both(string left, string right) { return left.Length + right.Length; }
    public void Fail(string text) { throw new Exception(text); }
}

class Program {
    static void Require(bool value, string message) {
        if (!value) throw new Exception(message);
    }

    static void AddScoped(object list, WeakReference<TypedListRow> observer) {
        TypedListRow row = observer.Target;
        Require(list.Invoke("Add", row), "reference Add");
    }

    static void References() {
        TypeInfo ti = typeof(List<TypedListRow>);
        Require(ti.ConstructorCount == 1, "closed List constructor metadata");
        object list = ti.CreateInstance();
        Require(list is List<TypedListRow>, "constructor closed identity");
        Require(!(list is List<object>), "generic identity remains invariant");
        Require((list as List<TypedListRow>) != null && (list as List<object>) == null,
            "as uses closed List identity");
        switch (list) {
            case List<object> wrongList:
                Require(false, "switch must reject a different List element type");
                break;
            case List<TypedListRow> matchedList:
                Require(matchedList.Count == 0, "switch binds matching List");
                break;
            default:
                Require(false, "switch must match the closed List");
                break;
        }
        Require(list.HasMethod("Add"), "Add metadata");
        Require(ti.GetMethodParamType(3, 0) == "TypedListRow", "Add parameter metadata");
        TypedListRow row = new TypedListRow();
        row.Name = "row-" + 17;
        WeakReference<TypedListRow> observer = new WeakReference<TypedListRow>(row);
        AddScoped(list, observer);
        row = null;
        Require(observer.IsAlive, "Add retains borrowed reference after scope");
        Require(list.Invoke("Add", (object)null), "null occupies an element");
        List<TypedListRow> rows = (List<TypedListRow>)list;
        Require(rows.Count == 2 && rows[0].Name == "row-17" && rows[1] == null,
            "typed entity/null readback");
        object held = list.InvokeObject("Get", 0);
        Require(list.InvokeObject("At", 1) == null, "At null");
        Require(list.InvokeObject("Get", -1) == null && list.InvokeObject("Get", 2) == null,
            "Get bounds");
        bool rejected = false;
        try {
            List<object> wrong = (List<object>)list;
        } catch (InvalidCastException ex) {
            rejected = true;
        }
        Require(rejected, "wrong generic cast is rejected");
        rows = null;
        list = null;
        Require(observer.IsAlive && held.GetFieldString("Name") == "row-17", "Get owns returned reference");
        held = null;
        Require(!observer.IsAlive, "list and returned reference release entity");
        Console.WriteLine("references PASS");
    }

    static void Nested() {
        object nested = typeof(List<List<TypedListRow>>).CreateInstance();
        object child = typeof(List<TypedListRow>).CreateInstance();
        TypedListRow row = new TypedListRow();
        row.Name = "nested";
        Require(child.Invoke("Add", row), "nested entity");
        Require(nested.Invoke("Add", child) && nested.Invoke("Add", (object)null), "nested Add");
        child = null;
        List<List<TypedListRow>> groups = (List<List<TypedListRow>>)nested;
        Require(groups.Count == 2 && groups[0][0].Name == "nested" && groups[1] == null,
            "nested typed readback");
        object fetched = nested.InvokeObject("At", 0);
        Require(fetched is List<TypedListRow>, "nested Get closed identity");
        Console.WriteLine("nested PASS");
    }

    static void Scalars() {
        object ints = typeof(List<int>).CreateInstance();
        int i = 0;
        while (i < 25) {
            Require(ints.Invoke("Add", i - 12), "int growth Add");
            i++;
        }
        List<int> values = (List<int>)ints;
        Require(values.Count == 25 && values[0] == -12 && values[24] == 12,
            "int growth typed readback");
        Require(ints.InvokeInt("Get", 0) == -12 && ints.InvokeInt("At", 24) == 12, "int reflection");
        object longs = typeof(List<long>).CreateInstance();
        Require(longs.Invoke("Add", -5000000000L), "long Add");
        List<long> wide = (List<long>)longs;
        Require(wide[0] == -5000000000L && longs.InvokeLong("Get", 0) == -5000000000L, "long readback");
        object bytes = typeof(List<byte>).CreateInstance();
        object sbytes = typeof(List<sbyte>).CreateInstance();
        object shorts = typeof(List<short>).CreateInstance();
        object ushorts = typeof(List<ushort>).CreateInstance();
        Require(bytes.Invoke("Add", (byte)250) && sbytes.Invoke("Add", (sbyte)-120) &&
            shorts.Invoke("Add", (short)-30000) && ushorts.Invoke("Add", (ushort)60000), "narrow Add");
        List<byte> bv = (List<byte>)bytes;
        List<sbyte> sbv = (List<sbyte>)sbytes;
        List<short> sv = (List<short>)shorts;
        List<ushort> usv = (List<ushort>)ushorts;
        Require(bv[0] == 250 && sbv[0] == -120 && sv[0] == -30000 && usv[0] == 60000,
            "narrow typed readback");
        Require(bytes.InvokeInt("Get", 0) == 250 && sbytes.InvokeInt("Get", 0) == -120 &&
            shorts.InvokeInt("At", 0) == -30000 && ushorts.InvokeInt("At", 0) == 60000,
            "narrow reflection signedness");
        object bools = typeof(List<bool>).CreateInstance();
        Require(bools.Invoke("Add", true) && bools.Invoke("Add", false), "bool Add");
        List<bool> flags = (List<bool>)bools;
        Require(flags[0] && !flags[1] && bools.InvokeInt("Get", 0) == 1 && bools.InvokeInt("At", 1) == 0,
            "bool readback");
        object enums = typeof(List<TypedListState>).CreateInstance();
        Require(enums.Invoke("Add", TypedListState.Below), "enum Add");
        Require(enums is List<TypedListState> && !(enums is List<int>), "enum closed identity");
        List<TypedListState> states = (List<TypedListState>)enums;
        Require(states[0] == TypedListState.Below && enums.InvokeInt("Get", 0) == -7, "enum readback");
        Console.WriteLine("scalars PASS");
    }

    static void FloatingPoint() {
        object floats = typeof(List<float>).CreateInstance();
        object doubles = typeof(List<double>).CreateInstance();
        Require(floats.Invoke("Add", (float)-1.25) && floats.Invoke("Add", (float)0.0), "float Add");
        Require(doubles.Invoke("Add", 3.141592653589793), "double Add");
        List<float> fv = (List<float>)floats;
        List<double> dv = (List<double>)doubles;
        Require(fv[0] == (float)-1.25 && fv[1] == (float)0.0 && dv[0] == 3.141592653589793,
            "floating typed readback");
        Require(floats.InvokeDouble("Get", 0) == -1.25 && floats.InvokeDouble("At", 1) == 0.0 &&
            doubles.InvokeDouble("At", 0) == 3.141592653589793, "floating reflection conversion");
        object strings = typeof(List<string>).CreateInstance();
        Require(strings.Invoke("Add", "text-" + 23), "temporary string Add");
        Require(strings.InvokeString("Get", 0) == "text-23", "string readback");
        Console.WriteLine("floating PASS");
    }

    static void AggregateBoundary() {
        object list = typeof(List<TypedListPair>).CreateInstance();
        Require(list is List<TypedListPair>, "boxed struct constructor identity");
        Require(list.HasMethod("Add") && list.HasMethod("Get"), "aggregate metadata");
        Require(list.Invoke("Add", new TypedListPair(7L, 11L)), "boxed struct List Add");
        object fetched = list.InvokeObject("Get", 0);
        Require(fetched is TypedListPair, "boxed struct List Get identity");
        TypedListPair gp = (TypedListPair)fetched;
        Require(gp.Left == 7L && gp.Right == 11L, "boxed struct List Get payload");
        List<TypedListPair> pairs = (List<TypedListPair>)list;
        Require(pairs.Count == 1 && pairs[0].Left == 7L && pairs[0].Right == 11L,
            "boxed struct List typed readback");

        object expList = typeof(List<TypedListExplicit>).CreateInstance();
        Require(expList is List<TypedListExplicit>, "explicit struct constructor identity");
        Require(!expList.Invoke("Add", (object)null), "explicit layout Add is unavailable");
        Require(!expList.Invoke("Get", 0), "explicit layout Get is unavailable");
        List<TypedListExplicit> exps = (List<TypedListExplicit>)expList;
        Require(exps.Count == 0, "unsupported reflection does not mutate collection");
        Console.WriteLine("aggregate PASS");
    }

    static void ValueTypeReflection() {
        object boxed = typeof(TypedListPair).CreateInstance(3L, 4L);
        Require(boxed is TypedListPair, "struct CreateInstance identity");
        Require(boxed.GetFieldLong("Left") == 3L && boxed.GetFieldLong("Right") == 4L,
            "boxed struct GetFieldLong");
        Require(boxed.InvokeLong("Sum") == 7L, "boxed struct InvokeLong");
        Require(boxed.SetFieldLong("Left", 15L) && boxed.GetFieldLong("Left") == 15L,
            "boxed struct SetFieldLong");
        TypedListPair unboxed = (TypedListPair)boxed;
        Require(unboxed.Left == 15L && unboxed.Right == 4L, "struct unboxing");

        ValueReflectionHolder holder = new ValueReflectionHolder();
        object h = holder;
        Require(h.GetFieldDouble("Amount") == 3.25, "decimal GetFieldDouble");
        Require(h.SetFieldObject("Amount", (decimal)9.5) && holder.Amount == (decimal)9.5,
            "decimal SetFieldObject");
        Require(h.GetFieldDouble("PropAmount") == 9.5, "decimal property getter");
        Require(h.SetFieldObject("PropAmount", (decimal)4.5) && holder.Amount == (decimal)4.5,
            "decimal property setter");
        Require(h.InvokeDouble("Scale", (decimal)2.0, (int?)3) == 12.0,
            "decimal + Nullable<int> InvokeDouble");
        Require(h.InvokeDouble("Scale", (decimal)2.0, (int?)null) == 9.0,
            "decimal + null Nullable<int> InvokeDouble");

        Require(h.SetFieldObject("Pair", new TypedListPair(5L, 6L)) &&
            holder.Pair.Left == 5L && holder.Pair.Right == 6L,
            "struct SetFieldObject");
        object pf = h.GetFieldObject("Pair");
        Require(pf is TypedListPair && ((TypedListPair)pf).Right == 6L, "struct GetFieldObject");
        Require(h.SetFieldObject("PropPair", new TypedListPair(8L, 9L)) &&
            holder.Pair.Left == 8L, "struct property setter");
        object ppf = h.GetFieldObject("PropPair");
        Require(ppf is TypedListPair && ((TypedListPair)ppf).Right == 9L,
            "struct property getter");

        Require(h.GetFieldInt("OptInt") == 0, "null Nullable<int> GetFieldInt");
        Require(h.SetFieldInt("OptInt", 77) && holder.OptInt == 77 &&
            h.GetFieldInt("OptInt") == 77, "Nullable<int> SetFieldInt/GetFieldInt");
        Require(h.SetFieldObject("OptInt", (object)null) && holder.OptInt == null,
            "Nullable<int> SetFieldObject(null)");
        Require(h.SetFieldObject("PropOpt", (int?)99) && holder.OptInt == 99 &&
            h.GetFieldInt("PropOpt") == 99, "Nullable<int> property");
        Require(h.GetFieldDouble("OptDec") == 7.5 &&
            h.SetFieldDouble("OptDec", 1.5) && holder.OptDec == (decimal)1.5,
            "Nullable<decimal> Get/Set");
        Require(h.GetFieldObject("OptPair") == null &&
            h.SetFieldObject("OptPair", (TypedListPair?)new TypedListPair(21L, 22L)) &&
            holder.OptPair != null && ((TypedListPair)holder.OptPair).Left == 21L,
            "Nullable<Struct> Set/Get");
        object opf = h.GetFieldObject("OptPair");
        Require(opf is TypedListPair && ((TypedListPair)opf).Right == 22L,
            "Nullable<Struct> GetFieldObject");

        object made = h.InvokeObject("MakePair", 33L, 44L);
        Require(made is TypedListPair && ((TypedListPair)made).Left == 33L, "struct return InvokeObject");
        Require(h.InvokeVoid("MakePair", 1L, 2L), "discarded struct return InvokeVoid");
        Require(h.InvokeObject("MaybePair", false) == null, "null Nullable<Struct> return");
        object maybe = h.InvokeObject("MaybePair", true);
        Require(maybe is TypedListPair && ((TypedListPair)maybe).Right == 200L,
            "some Nullable<Struct> return");
        Require(h.InvokeVoid("MaybePair", true), "discarded Nullable<Struct> return");

        TypeInfo hti = typeof(ValueReflectionHolder);
        Require(hti.GetStaticFieldDouble("StaticPrice") == 12.5, "static decimal get");
        Require(hti.SetStaticFieldDouble("StaticPrice", 2.5) &&
            ValueReflectionHolder.StaticPrice == (decimal)2.5, "static decimal set");
        Require(hti.InvokeStaticDouble("StaticDouble", (decimal)3.0) == 5.5,
            "static decimal InvokeStaticDouble");
        Require(hti.GetStaticFieldInt("StaticOpt") == 42 &&
            hti.SetStaticFieldObject("StaticOpt", (object)null) &&
            ValueReflectionHolder.StaticOpt == null, "static Nullable<int> get/set");
        object sp = hti.GetStaticFieldObject("StaticPair");
        Require(sp is TypedListPair && ((TypedListPair)sp).Left == 10L &&
            hti.SetStaticFieldObject("StaticPair", new TypedListPair(50L, 60L)) &&
            ValueReflectionHolder.StaticPair.Right == 60L, "static struct get/set");

        object declist = typeof(List<decimal>).CreateInstance();
        Require(declist.Invoke("Add", (decimal)1.25) && declist.Invoke("Add", (decimal)2.75),
            "List<decimal> Add");
        Require(declist.InvokeDouble("Get", 0) == 1.25 && declist.InvokeDouble("At", 1) == 2.75,
            "List<decimal> Get/At");

        object optlist = typeof(List<int?>).CreateInstance();
        Require(optlist.Invoke("Add", (int?)19) && optlist.Invoke("Add", (object)null),
            "List<int?> Add");
        Require(optlist.InvokeInt("Get", 0) == 19 && optlist.InvokeInt("At", 1) == 0,
            "List<int?> Get/At");

        object nplist = typeof(List<TypedListPair?>).CreateInstance();
        Require(nplist.Invoke("Add", (TypedListPair?)new TypedListPair(2L, 3L)) &&
            nplist.Invoke("Add", (object)null), "List<TypedListPair?> Add");
        Require(((TypedListPair)nplist.InvokeObject("Get", 0)).Right == 3L &&
            nplist.InvokeObject("At", 1) == null, "List<TypedListPair?> Get/At");

        TypedListRow arcRow = new TypedListRow();
        arcRow.Name = "boxed-arc-" + 5;
        WeakReference<TypedListRow> arcWitness = new WeakReference<TypedListRow>(arcRow);
        object arcBox = typeof(TypedBoxedArc).CreateInstance(arcRow, (decimal)6.5);
        Require(h.SetFieldObject("ArcStruct", arcBox), "ARC struct SetFieldObject");
        arcRow = null;
        arcBox = null;
        Require(arcWitness.IsAlive, "ARC struct field retains RC payload");
        Require(h.SetFieldObject("ArcStruct", new TypedBoxedArc(null, (decimal)0)),
            "ARC struct overwrite releases old RC payload");
        Require(!arcWitness.IsAlive, "overwritten ARC struct releases witness");

        Console.WriteLine("value reflection PASS");
    }

    static T NullLocal<T>() {
        object value = null;
        return (T)value;
    }

    static T NullArgument<T>(object value) { return (T)value; }

    static void NullCasts() {
        object value = null;
        List<int> ints = (List<int>)value;
        TypedListRow row = (TypedListRow)value;
        Require(ints == null && row == null, "null reference casts");
        Require(NullLocal<List<TypedListRow>>() == null &&
            NullArgument<List<TypedListRow>>(value) == null, "generic null casts");
        Require(!(value is List<int>) && !(value is TypedListRow), "null is T remains false");
        Console.WriteLine("null casts PASS");
    }

    static string FailArgument() { throw new Exception("argument"); }

    static void OwnedArguments() {
        object target = typeof(TypedListCalls).CreateInstance("ctor-" + 31);
        Require(target.GetFieldString("Name") == "ctor-31", "temporary ctor argument");
        Require(target.InvokeInt("Length", "invoke-" + 27) == 9, "temporary returning Invoke argument");
        Require(!target.Invoke("Missing", "miss-" + 19), "missing Invoke temporary cleanup");
        bool caught = false;
        try {
            target.InvokeInt("Both", "first-" + 19, FailArgument());
        } catch (Exception ex) {
            caught = true;
        }
        Require(caught, "later argument evaluation unwinds earlier temporary");
        caught = false;
        try { target.Invoke("Fail", "literal"); }
        catch (Exception ex) { caught = true; }
        Require(caught, "reflective callee exception reaches caller catch");
        caught = false;
        try { target.Invoke("Fail", "throw-" + 19); }
        catch (Exception ex) { caught = true; }
        Require(caught, "throwing reflective callee unwinds fresh argument");
        caught = false;
        try { typeof(TypedListThrowingCtor).CreateInstance("ctor-throw-" + 19); }
        catch (Exception ex) { caught = true; }
        Require(caught, "reflective constructor exception reaches caller catch");
        Console.WriteLine("owned arguments PASS");
    }

    static void FieldInitializers() {
        object value = typeof(TypedListFieldOwner).CreateInstance();
        TypedListFieldOwner owner = (TypedListFieldOwner)value;
        object list = owner.Items;
        Require(list is List<List<int>> && list.HasMethod("Add"), "late initialized List metadata");
        Require(list.Invoke("Add", owner.Child.Values), "late initialized nested Add");
        Require(owner.Items.Count == 1, "late initialized List count");
        owner.Child.Values.Add(42);
        Require(owner.Items[0][0] == 42, "late initialized typed content");
        Console.WriteLine("field initializers PASS");
    }

    static void BuiltinProducers() {
        Dictionary<string, TypedListRow> dict = new Dictionary<string, TypedListRow>();
        object keys = dict.Keys;
        Require(keys is List<string> && !(keys is List<object>), "empty key snapshot identity");
        Require(keys.Invoke("Add", "key-" + 7) && keys.InvokeString("Get", 0) == "key-7",
            "empty key snapshot owns appended keys");
        TypedListRow row = new TypedListRow();
        row.Name = "dictionary-" + 8;
        WeakReference<TypedListRow> witness = new WeakReference<TypedListRow>(row);
        dict["row"] = row;
        object values = dict.Values;
        row = null;
        dict.Clear();
        List<TypedListRow> snapshot = values as List<TypedListRow>;
        Require(snapshot != null && witness.IsAlive && snapshot[0].Name == "dictionary-8",
            "value snapshot owns its closed element type");
        snapshot = null;
        values = null;
        Require(!witness.IsAlive, "value snapshot releases its entries");
        object split = "a,b".Split(",");
        Require(split is List<string> && split.InvokeString("Get", 1) == "b", "Split closed identity");
    }

    static void ArrayRanks() {
        object vectors = new List<int[]>();
        object matrices = new List<int[,]>();
        Require(vectors is List<int[]> && !(vectors is List<int[,]>), "vector List identity");
        Require(matrices is List<int[,]> && !(matrices is List<int[]>), "rectangular List identity");
        Require((vectors as List<int[,]>) == null && (matrices as List<int[,]>) != null,
            "List as checks the element rank");

        TypeInfo matrixList = typeof(List<int[,]>);
        Require(matrixList.Name == "List<int[,]>", "rectangular List display name");
        Require(matrixList.TypeArgCount == 1 && matrixList.GetTypeArg(0).IsArray,
            "rank commas stay within one type argument");
        Require(matrixList.GetTypeArg(0).Name == "int[,]" && matrixList.ElementType.ElementType.Name == "int",
            "rectangular List argument and element metadata");

        object nested = new List<List<int[,][]>>();
        Require(nested is List<List<int[,][]>> && !(nested is List<List<int[][,]>>), "nested rank order identity");
        Require(typeof(int[,][]).Name == "int[][,]" && typeof(int[,][]).ElementType.Name == "int[]",
            "rectangular outer group");
        Require(typeof(int[][,]).Name == "int[,][]" && typeof(int[][,]).ElementType.Name == "int[,]",
            "vector outer group");

        TypeInfo listArray = typeof(List<int>[,]);
        Require(listArray.IsArray && listArray.TypeArgCount == 0 && listArray.ElementType.GetTypeArg(0).Name == "int",
            "generic arguments belong to the array element");
    }

    static void Main() {
        ArrayRanks();
        BuiltinProducers();
        NullCasts();
        FieldInitializers();
        OwnedArguments();
        References();
        Nested();
        Scalars();
        FloatingPoint();
        AggregateBoundary();
        ValueTypeReflection();
    }
}
