using System;

class RoutedEventArgs { }

class CallReceiverState {
    public int Created;
    public int Invoked;
}

class CallReceiverAction {
    public CallReceiverState State;
    public CallReceiverAction(CallReceiverState state) { State = state; }
    public void Run() { State.Invoked = State.Invoked + 1; }
}

class CallReceiverWitness {
    public weak CallReceiverAction Receiver;
}

class CallReceiverBase {
    public int Subscriptions;
    public int EventCalls;
    public Action Handler;

    public CallReceiverBase OnClick(Action action) {
        BindEvent(action);
        return this;
    }
    public virtual void BindEvent(Action action) {
        Subscriptions = Subscriptions + 1;
        Handler = action;
    }
    public virtual void OnClick(RoutedEventArgs args) { EventCalls = EventCalls + 1; }
    public void Fire() { Handler(); }
    public void Clear() { Handler = null; }
}

class CallReceiverButton : CallReceiverBase {
    public override void OnClick(RoutedEventArgs args) {
        EventCalls = EventCalls + 1;
    }
}

class CallReceiverBox<T> {
    public int Calls;
    public T Echo(T value) { Calls = Calls + 1; return value; }
}

class CallReceiverMethodGroupTest {
    static void Check(bool ok, string label) {
        if (!ok) { throw new Exception(label); }
    }
    static CallReceiverAction NewAction(CallReceiverState state, CallReceiverWitness witness) {
        CallReceiverAction receiver = new CallReceiverAction(state);
        state.Created = state.Created + 1;
        witness.Receiver = receiver;
        return receiver;
    }
    // Separate scopes leave the bound delegate as the only receiver owner.
    static void Direct(CallReceiverButton target, CallReceiverState state, CallReceiverWitness witness) {
        target.OnClick(NewAction(state, witness).Run);
    }
    static void Generic(CallReceiverButton target, CallReceiverState state, CallReceiverWitness witness,
                        CallReceiverBox<CallReceiverAction> box) {
        target.OnClick(box.Echo(NewAction(state, witness)).Run);
    }
    static void Explicit(CallReceiverButton target, CallReceiverState state, CallReceiverWitness witness) {
        target.BindEvent(NewAction(state, witness).Run);
    }
    static void Verify(CallReceiverButton target, CallReceiverState state,
                       CallReceiverWitness witness, string label) {
        Check(target.Subscriptions == 1 && target.EventCalls == 0, label + " Action overload selected");
        Check(state.Created == 1, label + " receiver evaluated once");
        Check(witness.Receiver != null, label + " delegate retains temporary receiver");
        target.Fire();
        target.Fire();
        Check(state.Invoked == 2, label + " bound action invoked exactly twice");
        target.OnClick(new RoutedEventArgs());
        Check(target.EventCalls == 1 && target.Subscriptions == 1, label + " event overload preserved");
        target.Clear();
        Check(witness.Receiver == null, label + " receiver released after delegate cleared");
    }
    static void Main() {
        CallReceiverButton direct = new CallReceiverButton();
        CallReceiverState directState = new CallReceiverState();
        CallReceiverWitness directWitness = new CallReceiverWitness();
        Direct(direct, directState, directWitness);
        Verify(direct, directState, directWitness, "direct");
        Console.WriteLine("DIRECT_CALL_RECEIVER_OK");

        CallReceiverButton generic = new CallReceiverButton();
        CallReceiverState genericState = new CallReceiverState();
        CallReceiverWitness genericWitness = new CallReceiverWitness();
        CallReceiverBox<CallReceiverAction> box = new CallReceiverBox<CallReceiverAction>();
        Generic(generic, genericState, genericWitness, box);
        Check(box.Calls == 1, "generic wrapper evaluated once");
        Verify(generic, genericState, genericWitness, "generic");
        Console.WriteLine("GENERIC_CALL_RECEIVER_OK");

        CallReceiverButton explicitTarget = new CallReceiverButton();
        CallReceiverState explicitState = new CallReceiverState();
        CallReceiverWitness explicitWitness = new CallReceiverWitness();
        Explicit(explicitTarget, explicitState, explicitWitness);
        Verify(explicitTarget, explicitState, explicitWitness, "explicit");
        Console.WriteLine("EXPLICIT_BIND_CONTROL_OK");
    }
}
