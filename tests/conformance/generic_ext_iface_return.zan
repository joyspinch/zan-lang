using System;

namespace TestGenericExtIfaceReturn;

public interface IExec {
    int Tag();
}

public class SqlExec : IExec {
    public int id;
    public SqlExec(int id) { this.id = id; }
    public int Tag() { return this.id; }
}

public class Item {
    public string name;
    public Item(string name) { this.name = name; }
}

public class Helper<T> {
    public int tag;
    public Helper(int tag) { this.tag = tag; }
    public int Score() { return this.tag + 10; }
}

public class Query<T> {
    public IExec exec;
    public string filter;
    public Query(IExec exec) {
        this.exec = exec;
        this.filter = "";
    }
    public Query<T> Where(string f) {
        this.filter = f;
        return this;
    }
    public int Run() {
        Helper<T> h = new Helper<T>(this.exec.Tag());
        return h.Score() + this.filter.Length;
    }
}

public class ExecExt {
    public static Query<T> MakeQuery<T>(this IExec exec) {
        return new Query<T>(exec);
    }
}

class Program {
    static void Main() {
        // Query<Item> is ONLY referenced through an interface extension method called on a
        // concrete class implementing IExec, with NO explicit Query<Item> local declaration.
        SqlExec conn = new SqlExec(32);
        int score = conn.MakeQuery<Item>().Where("abc").Run();
        Console.WriteLine("score=" + Convert.ToString(score));
    }
}
