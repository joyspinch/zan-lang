using System;

namespace Shop {
    public class Item {
        public int price;
        public static bool ok = true;
        public Item() { this.price = 7; }
    }
}

// A statement-initial ternary is an EXPRESSION, not a declaration. The
// declaration lookahead used to read `flag ? a : b` as "type `flag?`, name
// `a`" -- the self-hosted compiler could not parse it at all.
class Program {
    static void Main() {
        bool flag = true;
        int n = 0;
        flag ? (n = 1) : (n = 2);
        Console.WriteLine("n=" + n);
        Shop.Item.ok ? (n = 3) : (n = 4);
        Console.WriteLine("m=" + n);
    }
}
