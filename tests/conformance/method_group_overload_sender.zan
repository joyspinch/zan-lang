using System;

namespace Conf;

// B-ID48：裸方法组 + 委托重载——必须按签名兼容性选重载。
// 修复前 `On("x", Handle)` 退化成"第一个同名重载"绑到 Zero()，
// Fire 期以零参调用 Handle(Control)，形参读到寄存器残渣。
delegate void Zero();
delegate void Sender(Ctl c);

class Ctl {
    string name;
    Ctl(string n) { name = n; }
    string Name() { return name; }
}

class Host {
    Zero zslot;
    Sender sslot;
    void On(string n, Zero h) { zslot = h; }
    void On(string n, Sender h) { sslot = h; }
    void Fire(Ctl c) {
        if (zslot != null) { zslot(); }
        if (sslot != null) { sslot(c); }
    }
    bool SenderBound() { return sslot != null; }
}

class Prog {
    static string got;

    static void Handle(Ctl c) { Prog.got = c.Name(); }

    static void Main() {
        Host h = new Host();
        h.On("x", Handle);
        if (!h.SenderBound()) {
            Console.WriteLine("misbound");
            return;
        }
        h.Fire(new Ctl("ok-name"));
        Console.WriteLine(Prog.got);
    }
}
