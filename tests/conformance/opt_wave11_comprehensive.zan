using System;
using System.Collections.Generic;

interface IVal {
    int Get();
}

class BaseA : IVal {
    public int X;
    public BaseA(int x) { this.X = x; }
    public virtual int Get() { return this.X; }
}

class SubB : BaseA {
    public SubB(int x) : base(x) { }
    public override int Get() { return this.X * 10; }
}

struct Pair {
    public int A;
    public int B;
}

struct Pair2 {
    public int X;
    public int Y;
}

class GenBox<T> {
    public T Val;
    public GenBox(T v) { this.Val = v; }
}

class Program {
    static int Passed = 0;
    static int Failed = 0;

    static void Check(bool cond, string label) {
        if (cond) {
            Passed = Passed + 1;
        } else {
            Failed = Failed + 1;
            Console.WriteLine($"FAIL: {label}");
        }
    }

    static void TestBoundsChecks() {
        var arr = new int[4];
        for (int i = 0; i < 4; i++) arr[i] = i * 10;
        arr[0]++;
        ++arr[3];
        Check(arr[0] == 1 && arr[3] == 31, "arr incdec");

        bool oobNeg = false;
        try { int x = arr[-1]; } catch (Exception) { oobNeg = true; }
        Check(oobNeg, "arr oob neg");

        bool oobHi = false;
        try { int x = arr[4]; } catch (Exception) { oobHi = true; }
        Check(oobHi, "arr oob hi");

        var sp = arr.AsSpan();
        sp[1] = 77;
        Check(sp[1] == 77 && arr[1] == 77, "span rw");
        bool spOob = false;
        try { int x = sp[-1]; } catch (Exception) { spOob = true; }
        Check(spOob, "span oob neg");

        var mat = new int[2, 3];
        mat[1, 2] = 99;
        Check(mat[1, 2] == 99, "mdarray rw");
        bool mdOob = false;
        try { int x = mat[2, 0]; } catch (Exception) { mdOob = true; }
        Check(mdOob, "mdarray oob");
    }

    static void TestCastAndUnbox() {
        IVal a = new BaseA(3);
        IVal b = new SubB(4);
        Check(a.Get() == 3 && b.Get() == 40, "iface dispatch");
        Check((a is BaseA) && !(a is SubB), "is BaseA");
        Check((b is BaseA) && (b is SubB), "is SubB inheritance");
        Check((a is object) && !(a is string), "is object/string");

        object ns = null;
        Check(!(ns is BaseA) && !(ns is Pair) && !(ns is object), "null is T");

        object strObj = "hello";
        Check((strObj is string) && (strObj is object) && !(strObj is BaseA), "string is");

        object bp = new Pair { A = 7, B = 8 };
        Check((bp is Pair) && !(bp is Pair2) && !(bp is BaseA), "struct is");
        Pair up = (Pair)bp;
        Check(up.A == 7 && up.B == 8, "struct unbox");

        object bi = new GenBox<int>(123);
        object bs = new GenBox<string>("ok");
        Check((bi is GenBox<int>) && !(bi is BaseA), "generic class int is");
        Check((bs is GenBox<string>) && !(bs is BaseA), "generic class string is");
        GenBox<int> ui = (GenBox<int>)bi;
        GenBox<string> us = (GenBox<string>)bs;
        Check(ui.Val == 123 && us.Val == "ok", "generic class cast");
    }

    static void TestParseAndChar() {
        Check(int.Parse("0") == 0, "parse 0");
        Check(int.Parse("-0") == 0 && int.Parse("+0") == 0, "parse signed 0");
        Check(int.Parse(" \t\n\r 42") == 42, "parse leading ws");
        Check(int.Parse("+2147483647") == 2147483647, "parse int max");
        Check(int.Parse("-2147483648") == -2147483648, "parse int min");
        Check(long.Parse("9223372036854775807") == 9223372036854775807, "parse long max");
        Check(long.Parse("-9223372036854775808") == -9223372036854775807 - 1, "parse long min");
        Check(Convert.ToInt32("-99") == -99 && Convert.ToInt64("1234567890123") == 1234567890123, "convert to int");

        bool fmt1 = false;
        try { int.Parse(""); } catch (FormatException) { fmt1 = true; }
        Check(fmt1, "parse empty fmt");

        bool fmt2 = false;
        try { int.Parse("  + "); } catch (FormatException) { fmt2 = true; }
        Check(fmt2, "parse sign only fmt");

        bool fmt3 = false;
        try { int.Parse("9999999999999999999999abc"); } catch (FormatException) { fmt3 = true; }
        Check(fmt3, "parse fmt priority over overflow");

        bool ovf1 = false;
        try { int.Parse("2147483648"); } catch (OverflowException) { ovf1 = true; }
        Check(ovf1, "parse int max+1 ovf");

        bool ovf2 = false;
        try { int.Parse("-2147483649"); } catch (OverflowException) { ovf2 = true; }
        Check(ovf2, "parse int min-1 ovf");

        bool ovf3 = false;
        try { long.Parse("9223372036854775808"); } catch (OverflowException) { ovf3 = true; }
        Check(ovf3, "parse long max+1 ovf");

        bool ovf4 = false;
        try { long.Parse("-9223372036854775809"); } catch (OverflowException) { ovf4 = true; }
        Check(ovf4, "parse long min-1 ovf");

        int iv = 99;
        Check(int.TryParse("-1234", out iv) && iv == -1234, "tryparse int ok");
        Check(!int.TryParse("2147483648", out iv) && iv == 0, "tryparse int ovf");
        Check(!int.TryParse("12x", out iv) && iv == 0, "tryparse int bad");
        long lv = 99;
        Check(long.TryParse("9223372036854775807", out lv) && lv == 9223372036854775807, "tryparse long ok");
        Check(!long.TryParse("9223372036854775808", out lv) && lv == 0, "tryparse long ovf");

        Check(char.IsDigit('5') && !char.IsDigit('a'), "char IsDigit");
        Check(char.IsLetter('Z') && char.IsLetter('m') && !char.IsLetter('9'), "char IsLetter");
        Check(char.IsLetterOrDigit('7') && char.IsLetterOrDigit('k') && !char.IsLetterOrDigit('_'), "char IsLetterOrDigit");
        Check(char.IsWhiteSpace(' ') && char.IsWhiteSpace('\t') && char.IsWhiteSpace('\n') && !char.IsWhiteSpace('x'), "char IsWhiteSpace");
        Check(char.IsUpper('A') && !char.IsUpper('a') && char.IsLower('z') && !char.IsLower('Z'), "char IsUpper/Lower");
        Check(char.ToUpper('a') == 'A' && char.ToUpper('Z') == 'Z' && char.ToLower('Q') == 'q', "char ToUpper/Lower ascii");
        Check(char.ToUpper('é') == 'É' && char.ToLower('É') == 'é', "char ToUpper/Lower unicode");

        // Regression test: long += char.ToUpper(c) must do integer addition, not string concat
        long csum = 0;
        csum += char.ToUpper('a');
        csum += char.ToLower('B');
        Check(csum == 65 + 98, "long += char.ToUpper arithmetic");
    }

    static void TestStrings() {
        var empty = new List<string>();
        Check(string.Join(",", empty) == "", "join empty");
        var one = new List<string>();
        one.Add("solo");
        Check(string.Join(",", one) == "solo", "join single");
        var many = new List<string>();
        many.Add("a"); many.Add(""); many.Add("bc");
        Check(string.Join("-", many) == "a--bc", "join multi");
        Check(string.Join("", many) == "abc", "join empty sep");

        string clean = "already";
        Check(clean.Trim() == "already", "trim noop");
        Check("   \t\r\n  ".Trim() == "", "trim all ws");
        Check("  hi there \n ".Trim() == "hi there", "trim both");
        Check("".ToUpper() == "" && "".ToLower() == "", "case empty");
        Check("Abc123!".ToUpper() == "ABC123!" && "Abc123!".ToLower() == "abc123!", "case ascii");
        Check("café".ToUpper() == "CAFé" && "CAFé".ToLower() == "café", "case preserves non-ascii utf8");

        string s = "hello,world";
        Check(s.StartsWith("hello") && !s.StartsWith("world") && !s.StartsWith("hello,world!"), "StartsWith");
        Check(s.EndsWith("world") && !s.EndsWith("hello") && !s.EndsWith("!hello,world"), "EndsWith");
        Check(s.Contains(",") && s.Contains("lo,w") && !s.Contains("xyz") && s.Contains(""), "Contains");
        Check(s.IndexOf(",") == 5 && s.IndexOf("world", 3) == 6 && s.IndexOf("hello", 1) == -1, "IndexOf");
        Check(s.IndexOf("a", -5) == -1 && s.IndexOf("a", 999) == -1, "IndexOf oob safe");
        Check(s.Equals("hello,world") && !s.Equals("hello"), "Equals");
        Check(s.Substring(6) == "world" && s.Substring(0, 5) == "hello", "Substring");

        // Shared and unique string ARC release stress
        var hold = new string[16];
        for (int i = 0; i < 64; i++) {
            string tmp = $"s-{i}-data";
            string shared = tmp;
            hold[i & 15] = shared;
        }
        Check(hold[15] == "s-63-data", "string arc release");
    }

    static void TestCollections() {
        var li = new List<int>();
        for (int i = 0; i < 100; i++) li.Add(i);
        li.AddRange(li); // self-append aliasing safety
        Check(li.Count == 200 && li[0] == 0 && li[100] == 0 && li[199] == 99, "List self AddRange");
        var arr = li.ToArray();
        Check(arr.Length == 200 && arr[150] == 50, "List<int> ToArray");
        li.Clear();
        Check(li.Count == 0 && li.ToArray().Length == 0, "List<int> Clear+empty ToArray");
        li.AddRange(arr);
        Check(li.Count == 200 && li[199] == 99, "List<int> AddRange array");

        var ls = new List<string>();
        ls.Add($"x{1}"); ls.Add($"y{2}");
        var ls2 = new List<string>();
        ls2.AddRange(ls);
        var sarr = ls2.ToArray();
        Check(sarr.Length == 2 && sarr[0] == "x1" && sarr[1] == "y2", "List<string> AddRange+ToArray");
        ls.Clear();
        Check(ls.Count == 0, "List<string> Clear");

        // Dict Clear reuse + tail Remove + non-tail Remove + tomb rebuild + Keys/Values
        var d = new Dictionary<int, int>();
        for (int r = 0; r < 3; r++) {
            d.Clear();
            for (int i = 0; i < 64; i++) d[i] = i * 2;
            // tail removes
            for (int i = 63; i >= 48; i--) {
                Check(d.Remove(i), "dict tail remove");
            }
            // middle (non-tail) removes
            Check(d.Remove(0) && d.Remove(10) && d.Remove(25) && !d.Remove(999), "dict mid remove");
            int got = 0;
            Check(d.TryGetValue(47, out got) && got == 94, "dict TryGetValue after remove");
            Check(!d.TryGetValue(63, out got) && !d.TryGetValue(10, out got), "dict removed absent");
            var ks = d.Keys;
            var vs = d.Values;
            Check(ks.Count == 45 && vs.Count == 45 && ks[0] == 1 && vs[0] == 2, "dict Keys/Values");
        }

        // Dict<string, string> RC + tail & mid remove
        var ds = new Dictionary<string, string>();
        for (int i = 0; i < 32; i++) ds[$"k{i}"] = $"v{i}";
        Check(ds.Remove("k31") && ds.Remove("k5") && !ds.Remove("k5"), "dict<str> remove");
        string sv = "";
        Check(ds.TryGetValue("k30", out sv) && sv == "v30", "dict<str> lookup");
        ds.Clear();
        ds["after"] = "ok";
        Check(ds.Count == 1 && ds["after"] == "ok", "dict<str> clear+refill");

        // HashSet tombstone remove + re-add + Compact
        var hs = new HashSet<int>();
        for (int i = 0; i < 40; i++) Check(hs.Add(i), "hs add");
        Check(!hs.Add(10), "hs dup");
        for (int i = 0; i < 30; i++) Check(hs.Remove(i), "hs remove triggers compact");
        Check(hs.Count() == 10 && !hs.Contains(5) && hs.Contains(35), "hs after compact");
        Check(hs.Add(5) && hs.Contains(5) && hs.Count() == 11, "hs re-add");
        hs.Clear();
        Check(hs.IsEmpty() && hs.Add(7) && hs.Count() == 1, "hs clear+reuse");

        // Queue wraparound + Clear
        var q = new Queue<int>();
        for (int i = 0; i < 20; i++) q.Enqueue(i);
        int qsum = 0;
        for (int i = 0; i < 15; i++) qsum += q.Dequeue();
        for (int i = 20; i < 30; i++) q.Enqueue(i);
        Check(q.Count() == 15 && q.Peek() == 15 && qsum == 105, "queue wrap");
        q.Clear();
        Check(q.IsEmpty(), "queue clear");
        var q2 = new Queue<string>(16);
        q2.Enqueue("first"); q2.Enqueue("second");
        Check(q2.Dequeue() == "first" && q2.Count() == 1, "queue<string> cap ctor");
        q2.Clear();
        Check(q2.IsEmpty(), "queue<string> clear");
    }

    static void Main() {
        TestBoundsChecks();
        TestCastAndUnbox();
        TestParseAndChar();
        TestStrings();
        TestCollections();
        Console.WriteLine($"passed={Passed} failed={Failed}");
    }
}
