using System;
using System.Data;
using System.Net.Sockets;

class MockConnection : IDbConnection {
    public bool isDisposed;
    public MockConnection() { this.isDisposed = false; }
    public bool IsConnected() { return !this.isDisposed; }
    public void Close() { this.isDisposed = true; }
    public void Dispose() { this.Close(); }
    public void BeginTransaction() {}
    public void Commit() {}
    public void Rollback() {}
    public async bool BeginTransactionAsync() { return true; }
    public async bool CommitAsync() { return true; }
    public async bool RollbackAsync() { return true; }
    public DbResult Query(string sql) { return new DbResult(); }
    public DbResult Query(string sql, DbParams p) { return new DbResult(); }
    public int Execute(string sql) { return 0; }
    public int Execute(string sql, DbParams p) { return 0; }
    public async DbResult QueryAsync(string sql) { return new DbResult(); }
    public async DbResult QueryAsync(string sql, DbParams p) { return new DbResult(); }
    public async int ExecuteAsync(string sql) { return 0; }
    public async int ExecuteAsync(string sql, DbParams p) { return 0; }
    public string ExecuteScalar(string sql) { return ""; }
    public string ExecuteScalar(string sql, DbParams prms) { return ""; }
    public int GetProvider() { return 0; }
    public async string ExecuteScalarAsync(string sql) { return ""; }
    public async string ExecuteScalarAsync(string sql, DbParams prms) { return ""; }
}

class Program {
    static int Main() {
        // 1. DateTime 毫秒测试
        DateTime dt1 = DateTime.FromUnixMilliseconds(1710000000123L);
        if (dt1.Millisecond() != 123) { return 1; }
        if (dt1.ToUnixMilliseconds() != 1710000000123L) { return 2; }
        if (dt1.Year() != 2024 || dt1.Month() != 3 || dt1.Day() != 9) { return 3; }

        DateTime dt2 = dt1.AddMilliseconds(500L);
        if (dt2.Millisecond() != 623) { return 4; }

        TimeSpan diff = dt2.Subtract(dt1);
        if (diff.TotalMilliseconds() != 500L) { return 5; }

        string withMs = dt1.ToStringWithMillis();
        if (!withMs.EndsWith(".123")) { return 6; }

        DateTime now = DateTime.UtcNow();
        int curMs = now.Millisecond();
        if (curMs < 0 || curMs > 999) { return 7; }

        // 2. IDisposable 测试 (using 自动释放)
        MockConnection mock = new MockConnection();
        using (IDbConnection conn = mock) {
            if (!conn.IsConnected()) { return 8; }
        }
        if (!mock.isDisposed) { return 9; }

        // 3. Exception 根因链测试
        Exception rootCause = new Exception("network unreachable");
        Exception dbEx = new Exception("database connection failed", rootCause);
        if (dbEx.InnerException == null) { return 10; }
        if (dbEx.InnerException.Message != "network unreachable") { return 11; }
        string fullMsg = dbEx.ToString();
        if (!fullMsg.Contains("database connection failed") || !fullMsg.Contains("network unreachable")) {
            return 12;
        }

        // 4. 标准派生异常测试
        bool caughtNull = false;
        try {
            throw new ArgumentNullException("userId");
        } catch (ArgumentException ex) {
            caughtNull = true;
        }
        if (!caughtNull) { return 13; }

        bool caughtDisposed = false;
        try {
            throw new ObjectDisposedException("StreamReader");
        } catch (InvalidOperationException ex) {
            caughtDisposed = true;
        }
        if (!caughtDisposed) { return 14; }

        Console.WriteLine("system-contract-v3-ok: 1");
        return 0;
    }
}
