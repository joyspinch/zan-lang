// C# embedded statements: if / else / while / for / foreach / do accept a
// single statement body without braces.
using System;

class Node {
    int id;
    Node(int v) { this.id = v; }
    int Id() { return this.id; }
}

class Program {
    static void P(string label, int v) { Console.WriteLine(label + "=" + v); }

    static async int Bump(int v) {
        await Task.Delay(1);
        return v + 1;
    }

    static async void Main() {
        int v = 1;

        // if with and without a matching else
        if (v == 1) P("if", 2);
        if (v == 9) P("never", 999);
        if (v == 1) v = 3; else v = 4;
        P("ifelse", v);

        // else binds to the nearest if
        if (v == 3)
            if (v > 10) P("innerThen", 1);
            else P("innerElse", 2);

        // while / do-while
        v = 0;
        while (v < 5) v = v + 1;
        P("while", v);
        v = 0;
        do v = v + 2; while (v < 6);
        P("dowhile", v);

        // for, including continue/else inside a braceless body
        for (int i = 0; i < 3; i = i + 1) P("for", 100 + i);
        v = 0;
        for (int i = 0; i < 6; i = i + 1)
            if (i == 2) continue; else v = v + i;
        P("forcont", v);

        // foreach, including break inside a braceless body
        List<int> xs = new List<int>();
        xs.Add(7);
        xs.Add(8);
        xs.Add(9);
        foreach (int x in xs) P("each", x);
        v = 0;
        foreach (int x in xs)
            if (x == 9) break; else v = v + x;
        P("eachbreak", v);

        // a braceless body is a scope of its own: holders declared in it are
        // released normally
        for (int i = 0; i < 3; i = i + 1)
            P("node", new Node(i + 40).Id());

        // await inside a braceless body
        v = 0;
        while (v < 3) v = await Bump(v);
        P("awaitwhile", v);
        if (v == 3) v = await Bump(v);
        P("awaitif", v);
        foreach (int x in xs)
            if (x == 7) v = await Bump(v);
        P("awaiteach", v);

        // braceless body of a loop that throws still unwinds cleanly
        v = 0;
        try {
            foreach (int x in xs)
                if (x == 8) throw new Exception("stop");
        } catch (Exception e) {
            Console.WriteLine("caught " + e.Message);
        }
        P("done", v);
    }
}
