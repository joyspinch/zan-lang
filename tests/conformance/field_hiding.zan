/* C#-style field hiding: a derived field that repeats a base field's name gets
 * its own slot. Base methods keep reading and writing the base field (and every
 * base field that follows it in the layout), while the derived class sees its
 * own declaration -- including when the two have different types. */

class Node {
    public string tag;
    public int rank;

    public Node() {
        tag = "base-tag";
        rank = 7;
    }

    public string BaseTag() { return tag; }
    public int BaseRank() { return rank; }
    public void SetBaseTag(string v) { tag = v; }
}

class Leaf : Node {
    public int tag;      /* hides Node.tag, and changes its type */
    public string extra;

    public Leaf() {
        tag = 42;
        extra = "leaf";
    }

    public int LeafTag() { return tag; }
    public void SetLeafTag(int v) { tag = v; }
}

class Program {
    static void Main() {
        Leaf l = new Leaf();
        Console.WriteLine(l.BaseTag());
        Console.WriteLine(Convert.ToString(l.LeafTag()));
        Console.WriteLine(Convert.ToString(l.BaseRank()));
        Console.WriteLine(l.extra);

        l.SetBaseTag("changed");
        l.SetLeafTag(99);
        Console.WriteLine(l.BaseTag());
        Console.WriteLine(Convert.ToString(l.LeafTag()));
        Console.WriteLine(Convert.ToString(l.BaseRank()));

        /* Through a base-typed reference the base declaration is the one in
         * scope, so the hidden field is still reachable. */
        Node n = l;
        Console.WriteLine(n.tag);
        Console.WriteLine(Convert.ToString(l.tag));
    }
}
