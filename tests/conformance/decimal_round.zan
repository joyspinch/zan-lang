using System;

// Decimal.Round 银行家舍入（MidpointRounding.ToEven，.NET Decimal.Round
// 默认口径）：恰 0.5 舍到偶数；decimals 重载在第 N 位同样 ToEven。
class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            failures = failures + 1;
            Console.WriteLine("FAIL " + name);
        }
    }

    static void Main() {
        // 中点：舍到偶数
        Check(Decimal.Round(2.5m) == 2m, "2.5 -> 2 (to even)");
        Check(Decimal.Round(3.5m) == 4m, "3.5 -> 4 (to even)");
        Check(Decimal.Round(-2.5m) == -2m, "-2.5 -> -2 (to even)");
        Check(Decimal.Round(0.5m) == 0m, "0.5 -> 0 (to even)");
        Check(Decimal.Round(-0.5m) == 0m, "-0.5 -> 0 (to even)");

        // 非中点：最近
        Check(Decimal.Round(1.4m) == 1m, "1.4 -> 1");
        Check(Decimal.Round(1.6m) == 2m, "1.6 -> 2");
        Check(Decimal.Round(-1.4m) == -1m, "-1.4 -> -1");
        Check(Decimal.Round(-1.6m) == -2m, "-1.6 -> -2");
        Check(Decimal.Round(-1.5m) == -2m, "-1.5 -> -2 (to even)");

        // 整数原样
        Check(Decimal.Round(3m) == 3m, "integer passthrough");

        // decimals 重载：第 N 位 ToEven
        Check(Decimal.Round(1.234m, 2) == 1.23m, "1.234 @2 -> 1.23");
        Check(Decimal.Round(1.235m, 2) == 1.24m, "1.235 @2 -> 1.24 (midpoint to even)");
        Check(Decimal.Round(1.236m, 2) == 1.24m, "1.236 @2 -> 1.24");
        Check(Decimal.Round(2.345m, 2) == 2.34m, "2.345 @2 -> 2.34 (midpoint to even)");
        Check(Decimal.Round(-1.235m, 2) == -1.24m, "-1.235 @2 -> -1.24");
        Check(Decimal.Round(1.2m, 0) == 1m, "decimals=0 rounds to int");
        Check(Decimal.Round(1.234m, 5) == 1.234m, "decimals beyond scale passthrough");

        Console.WriteLine("failures=" + failures);
    }
}
