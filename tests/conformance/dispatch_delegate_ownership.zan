using System;
using Gui;

// 接口数据协议与执行契约。
// List<Action>).

class Counter {
    int hits;
    string tag;

    Counter(string tag) {
        this.hits = 0;
        this.tag = tag;
    }

    void Bump() { hits = hits + 1; }
}

class Program {
    static void Main() {
        Counter c = new Counter("recent");
        UiEvent ev = new UiEvent();
        // 接口数据协议与执行契约。
        ev.Add(() => { c.Bump(); });

        for (int i = 0; i < 200; i = i + 1) {
            ev.Post();
            // 接口数据协议与执行契约。
            // 核心契约与语义定义。
            string junk = "junk" + i;
            if (junk == "") { Console.WriteLine("unreachable"); }
            Action h = Dispatcher.Take();
            while (h != null) {
                h();
                h = Dispatcher.Take();
            }
            // 接口数据协议与执行契约。
            ev.Raise();
        }

        Console.WriteLine(ev.Count());
        Console.WriteLine(c.hits);
        Console.WriteLine(c.tag);

        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        ev.Post();
        Dispatcher.Clear();
        ev.Raise();
        Console.WriteLine(c.hits);
    }
}
