// conformance test: empty Dictionary<K,V> lazy buffer allocation
using System;
using System.Collections.Generic;

class Program {
    static int Main() {
        Dictionary<string, int> dict = new Dictionary<string, int>();
        if (dict.Count != 0) { return 1; }
        if (dict.ContainsKey("hello")) { return 2; }
        dict.Clear();
        if (dict.Count != 0) { return 3; }
        dict["a"] = 100;
        dict["b"] = 200;
        if (dict.Count != 2 || dict["a"] != 100 || dict["b"] != 200) { return 4; }
        Console.WriteLine("dict_lazy_init: PASS");
        return 0;
    }
}
