using System;

class RefOwner {
    int value;
    string text;
}

class Program {
    static async void Update(ref int value, ref string text) {
        value = value + 2;
        text = text + "-before";
        await Task.Yield();
        value = value + 3;
        text = text + "-after";
        await Task.Delay(1);
        value = value + 4;
    }

    static async void Main() {
        int value = 5;
        string text = "local";
        await Program.Update(ref value, ref text);
        Console.WriteLine("local=" + Convert.ToString(value) + ":" + text);
        RefOwner owner = new RefOwner();
        owner.value = 10;
        owner.text = "field";
        await Program.Update(ref owner.value, ref owner.text);
        Console.WriteLine("field=" + Convert.ToString(owner.value) + ":" + owner.text);
    }
}
