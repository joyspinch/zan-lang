// B-ID186 Wave 9: async local declarations (plain, conditional, boxed-captured,
// and `await` declaration/return sinks) must apply NarrowToDeclared to match
// synchronous slots and the C host (closing cron_jobs_CASTW).
using System;
using System.Threading;

class Program {
    static long Big() { return 1792488600000; }
    static async long BigAsync() {
        await Task.Delay(1);
        return 1792488600000;
    }

    static int SyncReturnAwait() {
        return await BigAsync();
    }

    static async int RunAsync(bool flag) {
        long target = Big();

        // 1. Direct async frame local narrowing
        int a = Big();
        Console.WriteLine("direct.eq=" + (a == target).ToString().ToLower() + " val=" + a);

        // 2. Conditional ternary async frame local narrowing (cron_jobs_CASTW shape)
        int b = flag ? Big() : -1;
        Console.WriteLine("cond.eq=" + (b == target).ToString().ToLower() + " val=" + b);

        // 3. Narrow byte/ushort/float async frame locals
        byte by = Big();
        ushort us = Big();
        float f = 1.0 / 3.0;
        Console.WriteLine("narrow.byte=" + by + " ushort=" + us + " f32_lt_f64=" + ((double)f != (1.0 / 3.0)).ToString().ToLower());

        // 4. Boxed captured async local narrowing
        int cap = Big();
        Func<int> reader = () => cap;
        Console.WriteLine("boxed.eq=" + (reader() == target).ToString().ToLower() + " val=" + reader());

        // 5. `int aw = await BigAsync();` narrowing
        int aw = await BigAsync();
        Console.WriteLine("await.var.eq=" + (aw == target).ToString().ToLower() + " val=" + aw);
        return aw;
    }

    static async void Main() {
        await RunAsync(true);
        int sr = SyncReturnAwait();
        Console.WriteLine("await.ret.eq=" + (sr == Big()).ToString().ToLower() + " val=" + sr);
    }
}
