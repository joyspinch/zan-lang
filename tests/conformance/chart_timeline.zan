using System;
using System.Json;
using Gui;
using Gui.Component.Chart;

namespace Conf;

// ChartTimeline（ECharts 2.2.7 timeline 子系统）的纯 seam：
// 帧号钳制、自动播放节拍推进、帧合并（base 外壳 + 逐帧数据）、
// 帧标签回退。全部无 App 依赖，确定性。
class Program {
    static ChartOption Frame(string title, string name, List<int> vals) {
        ChartOption o = ChartOption.Of(title, new List<string>{"A", "B"},
            new List<ChartSeries>{ ChartSeries.Bar(name, vals) });
        o.showTooltip = false;
        return o;
    }

    static string B(bool v) {
        if (v) { return "1"; }
        return "0";
    }

    static void Main() {
        // ---- Clamp：负值回 0、越界回尾帧、空序列恒 0 ----
        Console.WriteLine("clamp:" + Convert.ToString(ChartTimeline.Clamp(0 - 3, 4))
            + ":" + Convert.ToString(ChartTimeline.Clamp(2, 4))
            + ":" + Convert.ToString(ChartTimeline.Clamp(9, 4))
            + ":" + Convert.ToString(ChartTimeline.Clamp(5, 0)));

        // ---- StepPlay：节拍未到不动，到拍循环推进，间隔非法不动 ----
        Console.WriteLine("play:" + Convert.ToString(ChartTimeline.StepPlay(0, 4, 1000, 1500, 800))
            + ":" + Convert.ToString(ChartTimeline.StepPlay(0, 4, 1000, 1800, 800))
            + ":" + Convert.ToString(ChartTimeline.StepPlay(3, 4, 0, 99999, 500))
            + ":" + Convert.ToString(ChartTimeline.StepPlay(2, 4, 0, 99999, 0))
            + ":" + Convert.ToString(ChartTimeline.StepPlay(2, 4, 0 - 1, 99999, 500)));

        // ---- Merge：base 外壳保留，同名系列逐帧换数据，异名追加 ----
        ChartOption baseOpt = ChartOption.Of("Base", new List<string>{"A", "B", "C"},
            new List<ChartSeries>{
                ChartSeries.Bar("S", new List<int>{ 1, 2, 3 }),
                ChartSeries.Line("L", new List<int>{ 5, 5, 5 }) });
        ChartOption f1 = Frame("2011", "S", new List<int>{ 40, 30, 20 });
        ChartOption merged = ChartTimeline.Merge(baseOpt, f1);
        Console.WriteLine("mTitle:" + merged.title
            + ":" + Convert.ToString(merged.series.Count));
        Console.WriteLine("mData:" + Convert.ToString(merged.series[0].data[0].val)
            + ":" + Convert.ToString(merged.series[0].data[2].val));
        Console.WriteLine("mKeep:" + Convert.ToString(merged.series[1].data[1].val)
            + ":" + Convert.ToString(merged.xAxes[0].categories[2]));
        Console.WriteLine("baseUntouched:" + Convert.ToString(baseOpt.series[0].data[0].val)
            + ":" + baseOpt.title);
        merged.series[0].data[0].val = 999;
        merged.xAxes[0].categories[0] = "Z";
        Console.WriteLine("deepInputs:" + Convert.ToString(baseOpt.series[0].data[0].val)
            + ":" + baseOpt.xAxes[0].categories[0]
            + ":" + Convert.ToString(f1.series[0].data[0].val)
            + ":" + Convert.ToString(merged.series[0].data[0].val)
            + ":" + merged.xAxes[0].categories[0]);

        // 无同名系列 -> 追加到尾部。
        ChartOption f2 = ChartOption.Of("", new List<string>{"A"},
            new List<ChartSeries>{ ChartSeries.Line("Extra", new List<int>{ 7 }) });
        ChartOption merged2 = ChartTimeline.Merge(baseOpt, f2);
        Console.WriteLine("mAppend:" + Convert.ToString(merged2.series.Count)
            + ":" + merged2.series[2].name
            + ":" + Convert.ToString(merged2.series[2].data[0].val));

        // 帧为 null -> 值相同但返回独立快照，不污染 base。
        ChartOption merged3 = ChartTimeline.Merge(baseOpt, null);
        Console.WriteLine("mNull:" + Convert.ToString(merged3 != baseOpt)
            + ":" + merged3.title + ":" + Convert.ToString(merged3.series.Count));

        // GaugeOption 的嵌套对象也必须与 Clone 输入隔离。
        ChartSeries gauge = ChartSeries.Gauge("G", 60);
        gauge.GaugeText(1, 2, 3, 4, "%");
        gauge.GaugeColors(10, 11, 40, 22, 70, 33, 100, 44);
        ChartOption gaugeOpt = ChartOption.Single(gauge);
        ChartOption gaugeClone = ChartOption.Clone(gaugeOpt);
        if (gaugeClone == null) {
            Console.WriteLine("gaugeInputs:clone-null");
        } else {
            gaugeClone.series[0].gauge.center.x.amount = 99;
            gaugeClone.series[0].gauge.title.textStyle.fontSize = 42;
            gaugeClone.series[0].gauge.axisLine.colors[0].color = 77;
            Console.WriteLine("gaugeInputs:" + Convert.ToString(gauge.gauge.center.x.amount)
                + ":" + Convert.ToString(gauge.gauge.title.textStyle.fontSize)
                + ":" + Convert.ToString(gauge.gauge.axisLine.colors[0].color)
                + ":" + Convert.ToString(gaugeClone.series[0].gauge.center.x.amount)
                + ":" + Convert.ToString(gaugeClone.series[0].gauge.title.textStyle.fontSize)
                + ":" + Convert.ToString(gaugeClone.series[0].gauge.axisLine.colors[0].color));
        }

        // ---- 帧标签回退：labels[i] → frames[i].title → 序号 ----
        ChartTimeline tl = ChartTimeline.Of()
            .Frame(Frame("2011", "S", new List<int>{ 1, 1 }))
            .Frame(Frame("2012", "S", new List<int>{ 2, 2 }))
            .Frame(Frame("2013", "S", new List<int>{ 3, 3 }));
        Console.WriteLine("lbl:" + tl.LabelAt(0) + ":" + tl.LabelAt(2)
            + ":" + Convert.ToString(tl.FrameCount()));
        List<string> ls = new List<string>{ "", "甲", "丙" };
        ChartTimeline tl2 = ChartTimeline.Of()
            .Frame(Frame("2011", "S", new List<int>{ 1 }))
            .Frame(Frame("2012", "S", new List<int>{ 2 }))
            .Frame(Frame("2013", "S", new List<int>{ 3 }))
            .Labels(ls);
        Console.WriteLine("lbl2:" + tl2.LabelAt(0) + ":" + tl2.LabelAt(1)
            + ":" + tl2.LabelAt(2));
        ChartOption f1v = tl.FrameAt(1);
        ChartOption f5v = tl.FrameAt(5);
        int f1val = 0 - 1;
        if (f1v != null) { f1val = f1v.series[0].data[0].val; }
        Console.WriteLine("fAt:" + Convert.ToString(f1val)
            + ":" + Convert.ToString(f5v == null));

        // ---- JSON 解析：timeline.data[] 标签 + autoPlay/playInterval + options[] 帧序列 ----
        ChartOption jbase = ChartOption.FromJson(
            "{\"title\":\"Base\",\"xAxis\":{\"type\":\"category\",\"data\":[\"A\",\"B\"]},"
            + "\"timeline\":{\"data\":[\"2011\",\"2012\",\"2013\"],\"autoPlay\":true,\"playInterval\":800},"
            + "\"options\":[{\"series\":[{\"type\":\"bar\",\"name\":\"S\",\"data\":[10,20]}]},"
            + "{\"series\":[{\"type\":\"bar\",\"name\":\"S\",\"data\":[30,40]}]}]}");
        ChartTimeline jt = ChartTimeline.FromJsonValue(
            JsonValue.ParseLenient("{\"data\":[\"2011\",\"2012\",\"2013\"],\"autoPlay\":true,\"playInterval\":800}"),
            JsonValue.ParseLenient("[{\"series\":[{\"type\":\"bar\",\"name\":\"S\",\"data\":[10,20]}]},{\"series\":[{\"type\":\"bar\",\"name\":\"S\",\"data\":[30,40]}]}]"));
        Console.WriteLine("json:" + Convert.ToString(jt.FrameCount())
            + ":" + jt.LabelAt(0) + ":" + jt.LabelAt(2)
            + ":" + Convert.ToString(jt.intervalMs));
        ChartOption jf0 = jt.FrameAt(0);
        int jf0v = 0 - 1;
        if (jf0 != null) { jf0v = jf0.series[0].data[1].val; }
        Console.WriteLine("jsonFrame:" + Convert.ToString(jf0v)
            + ":" + Convert.ToString(jf0.series[0].data[1].numberSet));

        // baseOption 顶层含 timeline 节点时 FromJson 仍按普通
        // option 解析外壳（轴/标题），timeline 帧由 ChartTimeline
        // 从同一文档的 nodes 摘出——两层解析互不干扰。
        Console.WriteLine("jsonBase:" + jbase.title
            + ":" + jbase.xAxes[0].categories[1]
            + ":" + Convert.ToString(jbase.series.Count));

        // 节点缺失 / null 容忍：空时间轴、无 options、无 autoPlay。
        ChartTimeline jt0 = ChartTimeline.FromJsonValue(null, null);
        Console.WriteLine("jsonEmpty:" + Convert.ToString(jt0.FrameCount())
            + ":" + Convert.ToString(jt0.intervalMs));
        ChartTimeline jt1 = ChartTimeline.FromJsonValue(
            JsonValue.ParseLenient("{\"data\":[\"x\"]}"), null);
        Console.WriteLine("jsonNoOpts:" + Convert.ToString(jt1.FrameCount())
            + ":" + jt1.LabelAt(0));

        // ---- 交互键段：7600000 与其他组件段错开，按 wid 线性排布 ----
        Console.WriteLine("keys:" + Convert.ToString(ChartTimeline.TlIdxKey(3))
            + ":" + Convert.ToString(ChartTimeline.TlPlayKey(3))
            + ":" + Convert.ToString(ChartTimeline.TlHitDot(3, 2))
            + ":" + Convert.ToString(ChartTimeline.TlIdxKey(4) - ChartTimeline.TlIdxKey(3)));
    }
}
