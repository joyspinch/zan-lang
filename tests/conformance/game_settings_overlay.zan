using System;
using System.Collections.Generic;
using System.IO;
using Game.Foundation;
using Game.Foundation.Gui;

namespace Tests.GameSettingsOverlay;

// 通用设置浮层的契约测试：档位行 → 按钮组（一行几个档就几个按钮）、
// 当前档高亮（class 驱动）、选档后高亮跟着走、落盘读回、开关显隐。
class Program {
    static void Main() {
        string dir = "game_settings_overlay_test";
        Directory.CreateDirectory(dir);
        string cfg = dir + "/settings.json";
        if (File.Exists(cfg)) { File.Delete(cfg); }

        GameSettings s = new GameSettings().At(cfg);
        s.AddBool("sound", "音效", true);
        s.AddOption("difficulty", "难度", "normal",
            new List<string> { "easy", "normal", "hard" });
        s.Load();

        SettingsModel m = new SettingsModel(s);
        SettingsOverlay ov = new SettingsOverlay(m);
        Gui.Control root = ov.Root();
        Console.WriteLine("root=" + Convert.ToString(root != null ? 1 : 0));
        // 布尔两档 + 枚举三档 = 5 个档位按钮
        Console.WriteLine("buttons=" + Convert.ToString(ov.ButtonCount()));
        // 初始高亮：布尔行第 0 档（开）、难度行第 1 档（normal）
        Console.WriteLine("b0=" + ov.ButtonClassAt(0));
        Console.WriteLine("b1=" + ov.ButtonClassAt(1));
        Console.WriteLine("b3=" + ov.ButtonClassAt(3));
        Console.WriteLine("b4=" + ov.ButtonClassAt(4));

        // 选难度第三档 → 高亮跟着走
        m.Select(1, 2);
        ov.Refresh();
        Console.WriteLine("after2=" + ov.ButtonClassAt(3));
        Console.WriteLine("after4=" + ov.ButtonClassAt(4));

        // 选档已落盘：新实例读回
        GameSettings s2 = new GameSettings().At(cfg);
        s2.AddBool("sound", "音效", true);
        s2.AddOption("difficulty", "难度", "normal",
            new List<string> { "easy", "normal", "hard" });
        s2.Load();
        Console.WriteLine("reloaded=" + s2.GetText("difficulty"));

        // 开关：关闭时整层不可见
        Console.WriteLine("closed=" + Convert.ToString(ov.IsOpen() ? 1 : 0));
        ov.Toggle();
        Console.WriteLine("opened=" + Convert.ToString(ov.IsOpen() ? 1 : 0));
        ov.Toggle();
        Console.WriteLine("closed2=" + Convert.ToString(ov.IsOpen() ? 1 : 0));
    }
}
