using System;
using System.Data;
using System.Data.SqlServer;
using System.Data.Firebird;
using System.Data.ZanDb;
using System.Json;

namespace Conf;

class Program {
    static int Main() {
        // 1. Verify SqlServerConnection implements IDbConnection
        IDbConnection sqlConn = new SqlServerConnection();
        if (sqlConn == null) { return 1; }
        if (sqlConn.GetProvider() != DbProvider.SqlServer) { return 2; }
        if (sqlConn.IsConnected()) { return 3; }

        // 2. Verify FirebirdConnection implements IDbConnection
        IDbConnection fbConn = new FirebirdConnection();
        if (fbConn == null) { return 4; }
        if (fbConn.GetProvider() != DbProvider.Firebird) { return 5; }
        if (fbConn.IsConnected()) { return 6; }

        // 3. Verify ZanDbRequestException public export
        ZanDbRequestException ex = new ZanDbRequestException("code_test", "error message");
        if (ex.code != "code_test" || ex.Message != "error message") { return 7; }

        // 4. Verify VectorIndex public export
        VectorIndexOptions opt = new VectorIndexOptions(3);
        VectorIndex idx = new VectorIndex(opt);
        if (idx.Count() != 0) { return 8; }

        float[] v1 = new float[3];
        v1[0] = 1.0f; v1[1] = 0.0f; v1[2] = 0.0f;
        idx.Add(1, v1);
        if (idx.Count() != 1) { return 9; }

        float[] v2 = new float[3];
        v2[0] = 0.0f; v2[1] = 1.0f; v2[2] = 0.0f;
        idx.Add(2, v2);
        if (idx.Count() != 2) { return 10; }

        float[] query = new float[3];
        query[0] = 0.9f; query[1] = 0.1f; query[2] = 0.0f;
        List<VectorHit> hits = idx.Search(query, 2, 16);
        if (hits.Count != 2) { return 11; }
        if (hits[0].id != 1) { return 12; }

        bool removed = idx.Remove(1);
        if (!removed || idx.Count() != 1) { return 13; }

        Console.WriteLine("DATA_HARDENING_OK");
        return 0;
    }
}
