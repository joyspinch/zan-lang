// Conformance: CheckboxGroup 的聚合 API —— IsChecked(index) /
// SetChecked(index, bool) / CheckedCount() / SetAllChecked(bool)，以及
// 组级 Change 事件（任一子复选框被切换时联动触发，在 MakeItem
// 中接线）。越界索引读 false / 静默无操作。
using System;
using Gui;
using Gui.Widget;

class CheckboxGroupTest {
    static int fired = 0;

    static string Tf(bool b) {
        if (b) { return "true"; }
        return "false";
    }

    static void Main() {
        CheckboxGroup g = new CheckboxGroup();
        g.SetOptionsText("A|B|C");
        g.OnChange(() => { fired = fired + 1; });

        Console.WriteLine(g.CheckedCount());      // 0
        g.SetChecked(1, true);
        Console.WriteLine(Tf(g.IsChecked(1)));    // true
        Console.WriteLine(Tf(g.IsChecked(0)));    // false
        Console.WriteLine(Tf(g.IsChecked(9)));    // false（越界）
        Console.WriteLine(g.CheckedCount());      // 1
        g.SetAllChecked(true);
        Console.WriteLine(g.CheckedCount());      // 3
        g.SetAllChecked(false);
        Console.WriteLine(g.CheckedCount());      // 0

        // 子复选框的用户切换（Change.Raise）应联动触发组级 OnChange。
        Checkbox item = (Checkbox)g.children[1];
        item.Change.Raise();
        Console.WriteLine(fired);                 // 1

        // .zform 路径：FormBuilder.Build 通过 SetProp("options") 创建子项，
        // 组级 API 对表单构建的组同样生效。
        JsonValue field = JsonValue.NewObject();
        field.Put("kind", JsonValue.NewStr("CheckboxGroup"));
        field.Put("name", JsonValue.NewStr("RememberCheck"));
        JsonValue opts = JsonValue.NewArray();
        opts.Append(JsonValue.NewStr("A"));
        opts.Append(JsonValue.NewStr("B"));
        opts.Append(JsonValue.NewStr("C"));
        field.Put("options", opts);
        JsonValue root = JsonValue.NewObject();
        JsonValue fields = JsonValue.NewArray();
        fields.Append(field);
        root.Put("fields", fields);
        Control host = FormBuilder.Build(root);
        CheckboxGroup g2 = (CheckboxGroup)host.children[0].children[0];
        Console.WriteLine(g2.children.Count);     // 3
        Console.WriteLine(g2.CheckedCount());     // 0
        g2.SetChecked(2, true);
        Console.WriteLine(Tf(g2.IsChecked(2)));   // true
    }
}
