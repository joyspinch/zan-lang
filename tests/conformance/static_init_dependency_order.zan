using System;

// B-ID92：静态初始化不得盲从声明序。A 声明在 B 之前，却依赖 B 的静态字段
// 与 B 的静态构造函数产出的状态；旧序先跑 A 的初始化器，读到 0 / null。
class A {
    public static int FromB = B.Seed * 2;          // 依赖 B 字段初始化器
    public static string Tag = B.Name + "!";       // 依赖 B 的 cctor
    public static int Chain = C.Value + 1;         // 依赖 C（C 又依赖 B）
}

class B {
    public static int Seed = 21;
    public static string Name;
    static B() { Name = "from-cctor"; }
}

class C {
    public static int Value = B.Seed + 100;
}

// 同一类型内：字段初始化器先于 cctor 体（C# 口径）
class D {
    public static int X = 5;
    public static int Y;
    static D() { Y = X * 10; }
}

class Program {
    static void Main() {
        Console.WriteLine("A.FromB=" + A.FromB);
        Console.WriteLine("A.Tag=" + A.Tag);
        Console.WriteLine("A.Chain=" + A.Chain);
        Console.WriteLine("D.Y=" + D.Y);
    }
}
