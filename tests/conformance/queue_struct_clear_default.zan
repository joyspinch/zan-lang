using System;
using System.Collections.Generic;

struct Point2D {
    public int x;
    public int y;
}

class Program {
    static int bad = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            bad = bad + 1;
            Console.WriteLine("FAIL " + name);
        }
    }

    static void Main() {
        // 1. 值类型结构体 Queue<Point2D> Clear 必须将底层槽位全部归零，绝不残留脏数据
        Queue<Point2D> q = new Queue<Point2D>();
        Point2D p1; p1.x = 11; p1.y = 22;
        Point2D p2; p2.x = 33; p2.y = 44;
        q.Enqueue(p1);
        q.Enqueue(p2);
        Check(q.Count() == 2, "count is 2");

        // Dequeue 出队项被置为零值
        Point2D deq = q.Dequeue();
        Check(deq.x == 11 && deq.y == 22, "dequeue value");
        Point2D oldSlot = q.elements[0];
        Check(oldSlot.x == 0 && oldSlot.y == 0, "dequeued slot zeroed");

        // Clear 清空全部槽位零值
        q.Clear();
        Check(q.Count() == 0, "count after clear is 0");
        Point2D slot1 = q.elements[1];
        Check(slot1.x == 0 && slot1.y == 0, "cleared slot 1 zeroed");

        // 空队列 TryDequeue / TryPeek 赋默认零值
        Point2D outPt;
        bool hasDeq = q.TryDequeue(out outPt);
        Check(!hasDeq, "empty trydequeue false");
        Check(outPt.x == 0 && outPt.y == 0, "empty trydequeue out zeroed");

        // 2. 基元值类型 Queue<int>
        Queue<int> qi = new Queue<int>();
        qi.Enqueue(999);
        qi.Clear();
        Check(qi.elements[0] == 0, "queue int slot zeroed");

        // 3. Array.Clear<Point2D>
        Point2D[] pts = new Point2D[3];
        pts[0].x = 1; pts[0].y = 2;
        pts[1].x = 3; pts[1].y = 4;
        pts[2].x = 5; pts[2].y = 6;
        Array.Clear<Point2D>(pts, 0, 2);
        Check(pts[0].x == 0 && pts[0].y == 0, "array clear slot 0 zeroed");
        Check(pts[1].x == 0 && pts[1].y == 0, "array clear slot 1 zeroed");
        Check(pts[2].x == 5 && pts[2].y == 6, "array clear untouched slot 2");

        if (bad > 0) {
            Console.WriteLine("FAIL: " + Convert.ToString(bad));
        } else {
            Console.WriteLine("all pass");
        }
    }
}
