using System;

class Program {
    static void Saxpy<const int W>(noalias Span<float> dst, noalias ReadOnlySpan<float> x,
                                   noalias ReadOnlySpan<float> y, float a) {
        Vec<W, float> va = Vec<W, float>.Splat(a);
        for (int i = 0; i + W <= dst.Length; i = i + W) {
            Vec<W, float> vx = Vec<W, float>.Load(x, i);
            Vec<W, float> vy = Vec<W, float>.Load(y, i);
            Vec<W, float> vr = Vec<W, float>.Fma(va, vx, vy);
            vr.Store(dst, i);
        }
    }

    static void Main() {
        // 1. Vec<4, float> ops + reductions + FMA + Clamp + Sqrt
        Vec<4, float> a = Vec<4, float>.Splat(2.0f);
        a[0] = 1.0f;
        a[1] = 4.0f;
        a[2] = 9.0f;
        a[3] = 16.0f;
        Vec<4, float> s = Vec<4, float>.Sqrt(a);
        Console.WriteLine($"sqrt:{(int)s[0]},{(int)s[1]},{(int)s[2]},{(int)s[3]},sum:{(int)s.Sum()}");

        Vec<4, float> b = Vec<4, float>.Splat(3.0f);
        Vec<4, float> c = a + b;
        Console.WriteLine($"dot:{(int)s.Dot(b)},hmin:{(int)c.HMin()},hmax:{(int)c.HMax()}");

        // 2. Vec<8, float> const-generic Saxpy kernel over stack [8]float InlineArrays
        [8]float xs = new InlineArray<8, float>();
        [8]float ys = new InlineArray<8, float>();
        [8]float ds = new InlineArray<8, float>();
        for (int i = 0; i < 8; i++) {
            xs[i] = (float)(i + 1);
            ys[i] = 10.0f;
        }
        Saxpy<8>(ds.AsSpan(), xs.AsReadOnlySpan(), ys.AsReadOnlySpan(), 2.0f);
        Console.WriteLine($"saxpy:{(int)ds[0]},{(int)ds[3]},{(int)ds[7]}");

        // 3. Vec<4, int> bitwise & lane ops
        Vec<4, int> vi = Vec<4, int>.Splat(1);
        vi = vi.WithLane(1, 2).WithLane(2, 4).WithLane(3, 8);
        Vec<4, int> sh = vi << 1;
        Vec<4, int> cl = Vec<4, int>.Clamp(sh, Vec<4, int>.Splat(3), Vec<4, int>.Splat(10));
        Console.WriteLine($"ivec:{cl[0]},{cl[1]},{cl[2]},{cl[3]},sum:{cl.Sum()}");

        // 4. Precision-preserving Math & native f32 MathF
        float fa = -3.5f;
        float fb = 2.0f;
        float f_abs = Math.Abs(fa);
        float f_min = Math.Min(fa, fb);
        float f_max = Math.Max(fa, fb);
        float f_cl = Math.Clamp(5.5f, 0.0f, 4.0f);
        float f_fma = Math.FusedMultiplyAdd(2.0f, 3.0f, 1.5f);
        int i_cl = Math.Clamp(150, 0, 100);
        float mf_sq = MathF.Sqrt(25.0f);
        float mf_fl = MathF.Floor(3.9f);
        float mf_ce = MathF.Ceiling(3.1f);
        Console.WriteLine($"mathf:{(int)(f_abs * 10.0f)},{(int)(f_min * 10.0f)},{(int)(f_max * 10.0f)},{(int)f_cl},{(int)(f_fma * 10.0f)},{i_cl},{(int)mf_sq},{(int)mf_fl},{(int)mf_ce}");
    }
}
