using System;

struct Inner {
    long value;
}

struct Outer {
    Inner inner;
}

class Box {
    Outer outer;
}

class Program {
    static Outer global;
    static int calls;

    static int Index() {
        calls = calls + 1;
        return 1;
    }

    static void Set(ref long value, long next) {
        value = next;
    }

    static void Check(bool ok) {
        if (!ok) { throw new Exception("nested struct place"); }
    }

    static void Main() {
        Outer local;
        local.inner.value = 1234567890123L;
        Check(local.inner.value == 1234567890123L);
        Set(ref local.inner.value, 17);
        Check(local.inner.value == 17);
        Outer[] values = new Outer[2];
        values[Index()].inner.value = 23;
        Check(values[1].inner.value == 23 && calls == 1);
        Set(ref values[Index()].inner.value, 29);
        Check(values[1].inner.value == 29 && calls == 2);
        Box box = new Box();
        box.outer.inner.value = 31;
        Set(ref box.outer.inner.value, 37);
        Check(box.outer.inner.value == 37);
        global.inner.value = 41;
        Set(ref global.inner.value, 43);
        Check(global.inner.value == 43);
        Console.WriteLine("nested struct place ok");
    }
}
