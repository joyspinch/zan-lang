// TaskScheduler smoke test: enumeration returns tasks, Get/Exists round-trip
// on a real task and reject a missing one, and a create -> get -> delete
// cycle works. The created task is ONCE at a far-future time, named with the
// PID to avoid collisions, and always deleted in the same run.
using System;
using System.Management;

namespace Conf;

class Prog {
    static int bad = 0;

    static void Check(bool cond) {
        if (!cond) { bad = bad + 1; }
    }

    static void Main() {
        List<TaskInfo> all = TaskScheduler.List();
        Check(all.Count > 0);
        // Entries are non-empty names.
        int i = 0;
        while (i < all.Count) {
            Check(all[i].name.Length > 0);
            i = i + 1;
        }
        // Get() round-trips the first entry.
        TaskInfo g = TaskScheduler.Get(all[0].name);
        Check(g != null && g.name.Length > 0);
        // A missing task is rejected.
        Check(TaskScheduler.Get("ZanNoSuchTask_42") == null);
        Check(!TaskScheduler.Exists("ZanNoSuchTask_42"));

        // Create -> Get -> Delete cycle (user-level ONCE task, unique name).
        string name = "ZanConf_" + Convert.ToString(ProcessList.SelfPid());
        Check(TaskScheduler.Create(name, "cmd.exe /c echo zan", "ONCE", "23:59"));
        Check(TaskScheduler.Exists(name));
        TaskInfo created = TaskScheduler.Get(name);
        Check(created != null && created.command == "cmd.exe /c echo zan");
        Check(TaskScheduler.Delete(name));
        Check(!TaskScheduler.Exists(name));
        Console.WriteLine("win-taskscheduler-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
