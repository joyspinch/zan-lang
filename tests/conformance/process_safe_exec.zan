using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Threading;

class Program {
    static async Task<int> RunAsyncTest() {
        List<string> args = new List<string>();
        args.Add("/c");
        args.Add("echo async_capture_ok");
        ProcessResult r = await Process.CaptureSafeAsync("cmd.exe", args);
        bool hasEcho = false;
        for (int i = 0; i < r.lines.Count; i = i + 1) {
            if (r.lines[i] == "async_capture_ok") {
                hasEcho = true;
            }
        }
        return hasEcho ? 1 : 0;
    }

    static void Main() {
        // Test RunSafe with arguments
        List<string> args = new List<string>();
        args.Add("/c");
        args.Add("echo safe_exec_ok");

        ProcessResult r = Process.CaptureSafe("cmd.exe", args);
        Console.WriteLine("exit=" + r.exitCode);
        bool hasEcho = false;
        for (int i = 0; i < r.lines.Count; i = i + 1) {
            if (r.lines[i] == "safe_exec_ok") {
                hasEcho = true;
            }
        }
        Console.WriteLine("hasEcho=" + hasEcho);

        int asyncOk = await RunAsyncTest();
        Console.WriteLine("asyncOk=" + asyncOk);

        Console.WriteLine("process-safe-ok: 1");
    }
}
