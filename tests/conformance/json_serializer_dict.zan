using System;
using System.Collections.Generic;
using System.Json;

namespace ConformanceTests;

class Person {
    public string name;
    public int age;
    public bool active;
}

class ConfigModel {
    public string appName;
    public Dict<string, string> tags;
    public List<int> ports;
}

class Program {
    static void Main() {
        TestPocoRoundtrip();
        TestDictStringRoundtrip();
        TestDictIntRoundtrip();
        TestDictDoubleRoundtrip();
        TestCompositeModelRoundtrip();
        Console.WriteLine("OK: ALL DICT AND POCO TESTS PASSED");
    }

    static void TestPocoRoundtrip() {
        Person p = new Person();
        p.name = "Alice";
        p.age = 30;
        p.active = true;

        string json = Json.Serialize<Person>(p);
        Person p2 = Json.Deserialize<Person>(json);
        if (p2 == null || p2.name != "Alice" || p2.age != 30 || !p2.active) {
            Console.WriteLine("FAIL: TestPocoRoundtrip");
            return;
        }
        Console.WriteLine("OK: TestPocoRoundtrip");
    }

    static void TestDictStringRoundtrip() {
        Dict<string, string> d = new Dict<string, string>();
        d.Add("env", "prod");
        d.Add("region", "ap-east");

        string json = Json.Serialize<Dict<string, string>>(d);
        Dict<string, string> d2 = Json.Deserialize<Dict<string, string>>(json);
        if (d2 == null || d2.Count != 2 || d2["env"] != "prod" || d2["region"] != "ap-east") {
            Console.WriteLine("FAIL: TestDictStringRoundtrip");
            return;
        }
        Console.WriteLine("OK: TestDictStringRoundtrip");
    }

    static void TestDictIntRoundtrip() {
        Dict<string, int> d = new Dict<string, int>();
        d.Add("itemA", 10);
        d.Add("itemB", 20);

        string json = Json.Serialize<Dict<string, int>>(d);
        Dict<string, int> d2 = Json.Deserialize<Dict<string, int>>(json);
        if (d2 == null || d2.Count != 2 || d2["itemA"] != 10 || d2["itemB"] != 20) {
            Console.WriteLine("FAIL: TestDictIntRoundtrip");
            return;
        }
        Console.WriteLine("OK: TestDictIntRoundtrip");
    }

    static void TestDictDoubleRoundtrip() {
        Dict<string, double> d = new Dict<string, double>();
        d.Add("pi", 3.14);
        d.Add("rate", 0.05);

        string json = Json.Serialize<Dict<string, double>>(d);
        Dict<string, double> d2 = Json.Deserialize<Dict<string, double>>(json);
        if (d2 == null || d2.Count != 2 || d2["pi"] < 3.13 || d2["rate"] > 0.06) {
            Console.WriteLine("FAIL: TestDictDoubleRoundtrip");
            return;
        }
        Console.WriteLine("OK: TestDictDoubleRoundtrip");
    }

    static void TestCompositeModelRoundtrip() {
        ConfigModel cfg = new ConfigModel();
        cfg.appName = "Gateway";
        cfg.tags = new Dict<string, string>();
        cfg.tags.Add("cluster", "k8s");
        cfg.tags.Add("tier", "frontend");
        cfg.ports = new List<int>();
        cfg.ports.Add(80);
        cfg.ports.Add(443);

        string json = Json.Serialize<ConfigModel>(cfg);
        ConfigModel cfg2 = Json.Deserialize<ConfigModel>(json);
        if (cfg2 == null || cfg2.appName != "Gateway" || cfg2.tags == null || cfg2.tags["cluster"] != "k8s" || cfg2.ports == null || cfg2.ports.Count != 2 || cfg2.ports[1] != 443) {
            Console.WriteLine("FAIL: TestCompositeModelRoundtrip");
            return;
        }
        Console.WriteLine("OK: TestCompositeModelRoundtrip");
    }
}
