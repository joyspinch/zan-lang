using System;
using System.IO;

class Program {
    static int Fail() { throw new IOException("expected"); }

    static void Accept(string text, int ignored) {
        throw new Exception("later argument must throw first");
    }

    static string EmptySlice(string text, int length) {
        return text.Substring(0, length);
    }

    static string EmptyTail(string text, int start) {
        return text.Substring(start);
    }

    static void CheckEmptyOwner(string text) {
        // EH stores string kinds in the low three pointer bits. Empty results
        // need the same aligned ARC header as every other Substring result.
        if (((long)(nint)text & 7L) != 0L ||
            Marshal.ReadInt64((nint)text, -8) != 0x5A414E5300000000L) {
            throw new Exception("empty Substring lacks an ARC string header");
        }
    }

    static void Main() {
        CheckEmptyOwner(EmptySlice("payload", 0));
        CheckEmptyOwner(EmptyTail("payload", 7));
        CheckEmptyOwner(EmptyTail("", 0));
        int caught = 0;
        for (int i = 0; i < 8; i = i + 1) {
            try { Accept(EmptySlice("payload", 0), Fail()); }
            catch (IOException ex) { caught = caught + 1; }
            try { Accept(EmptyTail("payload", 7), Fail()); }
            catch (IOException ex) { caught = caught + 1; }
            try { Accept(EmptyTail("", 0), Fail()); }
            catch (IOException ex) { caught = caught + 1; }
            string empty = EmptySlice("payload", 0);
            if (empty.Length != 0 || empty != "") {
                throw new Exception("empty slice changed");
            }
            empty = EmptyTail("payload", 7);
            if (empty.Length != 0 || empty != "") {
                throw new Exception("empty tail changed");
            }
        }
        if (caught != 24) { throw new Exception("missing catch"); }
        Console.WriteLine("PASS substring_empty_exception_owner");
    }
}
