using System;
using System.Runtime.InteropServices;

[StructLayout(LayoutKind.Sequential, Pack = 1)]
public struct ColorRgb {
    public byte R;
    public byte G;
    public byte B;
}

public class CExports {
    [Export]
    public static int zan_c_mul_add(int a, int b, int c) {
        return a * b + c;
    }

    [Export("zan_c_invert_rgb")]
    public static void InvertRgb(ref ColorRgb c) {
        c.R = (byte)(255 - c.R);
        c.G = (byte)(255 - c.G);
        c.B = (byte)(255 - c.B);
    }

    [UnmanagedCallersOnly(EntryPoint = "zan_c_atomic_inc")]
    public static int AtomicInc(ref int slot, int delta) {
        return Atomic.FetchAdd(ref slot, delta, MemoryOrder.AcqRel);
    }
}

public class Program {
    public static void Main() {
        static_assert(sizeof(ColorRgb) == 3, "packed RGB must be 3 bytes");
        static_assert(alignof(ColorRgb) == 1, "packed RGB alignment must be 1");

        int m = CExports.zan_c_mul_add(6, 7, 100);
        ColorRgb rgb = new ColorRgb();
        rgb.R = 10;
        rgb.G = 55;
        rgb.B = 200;
        CExports.InvertRgb(ref rgb);

        int counter = 40;
        int prev = CExports.AtomicInc(ref counter, 2);

        Console.WriteLine($"mul={m}");
        Console.WriteLine($"rgb={rgb.R},{rgb.G},{rgb.B}");
        Console.WriteLine($"atomic={prev}->{counter}");
    }
}
