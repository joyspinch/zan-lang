using System;

class InvokeDemandDynamicTarget {
    public int Value;
    public void OnDynamic() { Value = Value + 31; }
    public void OnRetainedByUnknown() {
        Console.WriteLine("INVOKE_UNKNOWN_UNUSED_BODY_MUST_STAY");
    }
}

class Program {
    static void Require(bool condition, string message) {
        if (!condition) throw new Exception(message);
    }

    static string SelectName(bool selected) {
        if (selected) return "OnDynamic";
        return "OnRetainedByUnknown";
    }

    static bool CallByName(object target, string name) { return target.Invoke(name); }

    static void Main() {
        InvokeDemandDynamicTarget instance = new InvokeDemandDynamicTarget();
        object target = instance;
        Require(target.HasMethod("OnDynamic") && target.HasMethod("OnRetainedByUnknown"), "dynamic metadata");
        Require(CallByName(target, SelectName(true)), "computed hook invocation");
        Require(instance.Value == 31, "dynamic hook body");
        Console.WriteLine("dynamic PASS");
    }
}
