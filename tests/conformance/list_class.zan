using System;
using System.Collections;
namespace P;
class Node {
    public int v;
    public Node next;
    public Node(int x) { v = x; }
}
class Bag {
    public List<Node> items;
    public Bag() { items = new List<Node>(); }
    public void Put(int x) { items.Add(new Node(x)); }
    public int Total() {
        int s = 0;
        for (int i = 0; i < items.Count; i = i + 1) { s = s + items[i].v; }
        return s;
    }
}
class Program {
    static void Main() {
        Bag b = new Bag();
        // Insert permits index == Count, including an empty list.
        List<Node> inserted = new List<Node>();
        inserted.Insert(0, new Node(7));
        inserted.Insert(inserted.Count, new Node(9));
        inserted.Insert(1, new Node(8));
        Console.WriteLine(inserted.Count);
        Console.WriteLine(inserted[0].v + inserted[1].v + inserted[2].v);
        b.Put(10);
        b.Put(20);
        b.Put(12);
        Console.WriteLine(b.items.Count);
        Console.WriteLine(b.Total());
        b.items[0].v = 100;
        Console.WriteLine(b.Total());
    }
}
