using System;

// 反射调用丢弃返回值时须释放引用型返回值：thunk 以 +1 交回字符串/对象，
// 只有 InvokeObject 与「确为字符串」的 InvokeString 把所有权交给调用方。
// 曾经 Invoke 调 fluent 方法（返回 this）每次泄漏一个引用；InvokeString
// 调返回对象的方法、InvokeInt 调返回字符串的方法同样泄漏。
// 本用例在 --check-leaks/--arc-guard 下运行：零泄漏、零过度释放。
public class Box { public string tag = ""; }

public class Fluent {
    public string title = "";
    public int calls;
    public Fluent Title(string t) { title = t; calls = calls + 1; return this; }
    public Box Make(string t) { Box b = new Box(); b.tag = t; return b; }
    public string Label() { return "label-" + title; }
    public int Count() { return calls; }
}

class Program {
    static void Main() {
        Fluent f = new Fluent();
        for (int i = 0; i < 3; i = i + 1) {
            bool ok = f.Invoke("Title", "t" + Convert.ToString(i));
            if (!ok) { Console.WriteLine("Invoke failed"); }
        }
        Console.WriteLine("fluent calls=" + Convert.ToString(f.calls) + " title=" + f.title);
        bool made = f.Invoke("Make", "dropped");
        Console.WriteLine("object discarded=" + (made ? "1" : "0"));
        string wrong = f.InvokeString("Make", "not-a-string");
        Console.WriteLine("object via InvokeString=[" + wrong + "]");
        // 数值形状对引用型返回交出地址（既有契约，见 reflect_invoke_numeric_result）；
        // 这里只验证字符串返回值被释放、不泄漏。
        long addr = f.InvokeLong("Label");
        Console.WriteLine("string via InvokeLong nonzero=" + (addr != 0 ? "1" : "0"));
        string label = f.InvokeString("Label");
        Console.WriteLine("string kept=" + label);
        object kept = f.InvokeObject("Make", "kept");
        Console.WriteLine("object kept=" + ((Box)kept).tag);
        Console.WriteLine("count=" + Convert.ToString(f.InvokeInt("Count")));
    }
}
