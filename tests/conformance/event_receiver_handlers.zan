using System;

delegate void H(int v);

class Src {
    public event H E;
    public void Fire(int v) { E(v); }
    public int Handlers() { if (E == null) { return 0; } return E.Count(); }
}

class Listener {
    public int Sum;
    public void OnE(int v) { Sum = Sum + v; }
}

class Program {
    static int slog;
    static void Static_OnE(int v) { slog = slog + v; }

    static void Main() {
        Src a = new Src();
        a.Fire(7);
        Console.WriteLine(Convert.ToString(a.Handlers()));

        Listener l = new Listener();
        int k = 100;
        a.E += l.OnE;
        a.E += Static_OnE;
        a.E += (v) => { Console.WriteLine("lam " + Convert.ToString(v + k)); };
        a.Fire(3);
        Console.WriteLine(Convert.ToString(l.Sum));
        Console.WriteLine(Convert.ToString(slog));
        Console.WriteLine(Convert.ToString(a.Handlers()));

        a.E -= l.OnE;
        a.Fire(5);
        Console.WriteLine(Convert.ToString(l.Sum));
        Console.WriteLine(Convert.ToString(slog));

        a.E -= Static_OnE;
        a.Fire(9);
        Console.WriteLine(Convert.ToString(slog));
        Console.WriteLine(Convert.ToString(a.Handlers()));
    }
}
