using System;
using System.Text.RegularExpressions;

class Program {
    static void Main() {
        // captures, index and one-shot helpers
        Regex kv = Regex.Compile("(\\w+)=(\\d+)");
        Match m = kv.Find("port=8080 x");
        Console.WriteLine("value=" + m.Value());
        Console.WriteLine("index=" + m.Index() + " length=" + m.Length());
        Console.WriteLine("groups=" + m.GroupCount() + ":" + m.Group(1) + "," + m.Group(2));
        Console.WriteLine("count=" + kv.Count("a=1 b=22 c=333"));
        Console.WriteLine("replace=" + kv.Replace("a=1 b=22", "$2:$1"));
        Console.WriteLine("replace_first=" + Regex.Compile("a").ReplaceFirst("aaa", "b"));
        Console.WriteLine("dollar=" + Regex.Compile("(a)").Replace("a", "[$$$1]"));

        // alternation, groups, backreferences
        Console.WriteLine("alt=" + Regex.Compile("^(cat|dog|bird)$").Find("dog").Group(1));
        Console.WriteLine("nested=" + Regex.Compile("((a)(b))c").Find("abc").Group(1)
            + Regex.Compile("((a)(b))c").Find("abc").Group(2)
            + Regex.Compile("((a)(b))c").Find("abc").Group(3));
        Console.WriteLine("noncapturing=" + Regex.Compile("(?:ab)+(c)").Find("ababc").GroupCount());
        Console.WriteLine("backref=" + Regex.Compile("(ab)\\1").IsMatch("abab"));
        Console.WriteLine("group_absent=" + Regex.Compile("(a)|(b)").Find("b").GroupSuccess(1)
            + ":" + Regex.Compile("(a)|(b)").Find("b").Group(2));

        // quantifiers, greedy and lazy
        Console.WriteLine("greedy=" + Regex.Compile("a.*b").Find("axbxb").Value());
        Console.WriteLine("lazy=" + Regex.Compile("<(.+?)>").Find("<a><b>").Group(1));
        Console.WriteLine("star=" + Regex.Compile("^ab*c$").IsMatch("ac"));
        Console.WriteLine("plus=" + Regex.Compile("^\\d+$").IsMatch("12345")
            + Regex.Compile("^\\d+$").IsMatch(""));
        Console.WriteLine("exact=" + Regex.Compile("^a{3}$").IsMatch("aaa")
            + Regex.Compile("^a{3}$").IsMatch("aa"));
        Console.WriteLine("range=" + Regex.Compile("^a{2,3}$").IsMatch("aaa")
            + Regex.Compile("^a{2,3}$").IsMatch("a"));
        Console.WriteLine("open_range=" + Regex.Compile("^a{2,}$").IsMatch("aaaa")
            + Regex.Compile("^a{2,}$").IsMatch("a"));
        Console.WriteLine("group_star=" + Regex.Compile("^(ab|cd)*$").IsMatch("abcdab"));

        // classes, shorthands, anchors and boundaries
        Console.WriteLine("class=" + Regex.Compile("[^a-c]+").Find("abcXYZ").Value());
        Console.WriteLine("class_escape=" + Regex.Compile("^[\\d\\-]+$").IsMatch("12-34"));
        Console.WriteLine("dot_stops_at_newline=" + Regex.Compile("a.b").IsMatch("a\nb"));
        // `^ $` are string anchors unless (?m) asks for line anchors, as in
        // .NET; the old engine matched line boundaries unconditionally.
        Console.WriteLine("line_anchors=" + Regex.Compile("^b$").IsMatch("a\nb\nc")
            + Regex.Compile("(?m)^b$").IsMatch("a\nb\nc"));
        Console.WriteLine("word_boundary=" + Regex.Compile("\\bcat\\b").IsMatch("a cat here")
            + Regex.Compile("\\bcat\\b").IsMatch("concat"));
        Console.WriteLine("non_boundary=" + Regex.Compile("\\Bcat").IsMatch("concat"));

        // case-insensitive matching folds literals and classes
        Console.WriteLine("ignore_case=" + Regex.CompileOptions("hello", true).IsMatch("HeLLo")
            + Regex.CompileOptions("^[a-z]+$", true).IsMatch("AbC"));

        // splitting, empty matches and escaping
        List<string> parts = Regex.Compile("\\s*,\\s*").Split("a , b,c");
        Console.WriteLine("split=" + parts.Count + ":" + parts[0] + "|" + parts[1] + "|" + parts[2]);
        Console.WriteLine("split_no_match=" + Regex.Compile("z").Split("abc").Count);
        Console.WriteLine("empty_matches=" + Regex.Compile("x*").Matches("abc").Count);
        Console.WriteLine("escape=" + Regex.Compile(Regex.Escape("a.b")).IsMatch("a.b")
            + Regex.Compile(Regex.Escape("a.b")).IsMatch("axb"));

        // a pathological pattern gives up instead of hanging -- and says so,
        // rather than reporting the timeout as "no match"
        try {
            Regex.Compile("^(a+)+b$").IsMatch("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
            Console.WriteLine("budget=silent");
        } catch (RegexBudgetException e) {
            Console.WriteLine("budget=reported");
        }

        // a malformed pattern is reported rather than half-compiled
        Console.WriteLine("malformed=" + (Regex.Validate("(a").Length > 0)
            + Regex.Validate("a+").Length);
        Console.WriteLine("no_match=" + Regex.Compile("q+").Find("abc").Success());
    }
}
