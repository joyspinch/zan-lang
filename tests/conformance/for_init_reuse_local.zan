using System;
namespace Conf;
class Program {
    static void Main() {
        // 核心契约与语义定义。
        int r;
        int n = 0;
        for (r = 0; r < 3; r = r + 1) {
            n = n + 10;
        }
        Console.WriteLine(n);
        Console.WriteLine(r);
        // 核心契约与语义定义。
        int m = 0;
        for (int i = 0; i < 4; i = i + 1) {
            m = m + 1;
        }
        Console.WriteLine(m);
        // 核心契约与语义定义。
        int k;
        int total = 0;
        for (k = 0; k < 2; k = k + 1) { total = total + 1; }
        for (k = 5; k > 3; k = k - 1) { total = total + 100; }
        Console.WriteLine(total);
    }
}
