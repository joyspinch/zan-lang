using System;
using System.IO;
using System.Net.Http;
using System.Web;

class StaticProbeStream : Stream {
    long declared;
    int actual;
    int pos;
    int reads;
    int largestRead;
    StaticProbeStream(long declared, int actual) {
        this.declared = declared;
        this.actual = actual;
    }
    override long Length() { return this.declared; }
    override long Seek(long offset, int origin) { this.pos = (int)offset; return offset; }
    override int ReadInto(nint buf, int count) {
        this.reads = this.reads + 1;
        if (count > this.largestRead) { this.largestRead = count; }
        int n = this.actual - this.pos;
        if (n > count) { n = count; }
        if (n > 2) { n = 2; } // Force partial reads.
        Span<byte> dst = new Span<byte>(buf, count);
        for (int i = 0; i < n; i = i + 1) {
            dst[i] = (byte)((this.pos + i) % 256);
        }
        this.pos = this.pos + n;
        return n;
    }
}

class Program {
    static int bad = 0;
    static void Check(bool ok, string label) {
        if (!ok) { Console.WriteLine("FAIL " + label); Program.bad = Program.bad + 1; }
    }
    static HttpContext Ctx(string method, string path) {
        return new HttpContext(HttpRequest.Parse(method + " " + path
            + " HTTP/1.1\r\nHost: test\r\n\r\n"), "127.0.0.1");
    }
    static HttpContext Get(string name) {
        HttpContext ctx = Program.Ctx("GET", "/static/" + name);
        Program.Check(!StaticFiles.Serve(ctx), "claimed " + name);
        return ctx;
    }
    static void Main() {
        Directory.CreateDirectory("_scratch");
        string root = "_scratch/static-files-bounded";
        Directory.CreateDirectory(root);
        WebApp app = new WebApp("127.0.0.1", 0);
        StaticFiles.Mount(app, "/static", root);
        StaticFiles.MaxAge(17);
        byte[] bytes = new byte[4];
        bytes[0] = 137; bytes[1] = 0; bytes[2] = 255; bytes[3] = 42;
        File.WriteAllBytes(root + "/image.PNG", bytes);
        HttpContext first = Program.Get("image.PNG");
        Program.Check(first.GetStatus() == 200 && first.BodyLength() == 4
            && first.BodyBytes()[1] == 0 && first.BodyBytes()[2] == 255, "binary intact");
        Program.Check(first.ContentType() == "image/png"
            && first.RoutePattern() == "/static/image.PNG", "type and metrics");
        Program.Check(first.BuildResponse(true).Contains("Cache-Control: public, max-age=17"), "browser cache");
        HttpContext head = Program.Ctx("HEAD", "/static/image.PNG");
        StaticFiles.Serve(head);
        Program.Check(head.GetStatus() == 200 && head.BodyLength() == 4
            && head.BodyBytes().Length == 0
            && head.BuildResponse(true).Contains("Content-Length: 4\r\n"), "HEAD without body");
        File.WriteAllText(root + "/image.PNG", "new");
        HttpContext changed = Program.Get("image.PNG");
        Program.Check(changed.BodyLength() == 3 && changed.BodyBytes()[0] == 110, "no stale cache");
        Program.Check(first.BodyBytes()[0] == 137, "independent live response");
        File.Delete(root + "/image.PNG");
        Program.Check(Program.Get("image.PNG").GetStatus() == 404, "deleted file not cached");
        File.WriteAllText(root + "/empty", "");
        HttpContext empty = Program.Get("empty");
        Program.Check(empty.GetStatus() == 200 && empty.BodyLength() == 0 && empty.IsBinary(), "empty file");
        File.Delete(root + "/empty");
        for (int i = 0; i < 140; i = i + 1) {
            string name = "item" + Convert.ToString(i) + ".txt";
            File.WriteAllText(root + "/" + name, "x");
            Program.Check(Program.Get(name).BodyLength() == 1, "many files");
            File.Delete(root + "/" + name);
            Program.Check(Program.Get(name).GetStatus() == 404, "no retained asset");
        }
        byte[] limit = new byte[StaticFiles.MaxFileBytes];
        limit[StaticFiles.MaxFileBytes - 1] = 91;
        File.WriteAllBytes(root + "/limit.bin", limit);
        HttpContext exact = Program.Get("limit.bin");
        Program.Check(exact.GetStatus() == 200 && exact.BodyLength() == StaticFiles.MaxFileBytes
            && exact.BodyBytes()[StaticFiles.MaxFileBytes - 1] == 91, "exact limit");
        File.AppendAllText(root + "/limit.bin", "x");
        HttpContext large = Program.Get("limit.bin");
        Program.Check(large.GetStatus() == 413 && !large.IsBinary()
            && large.RoutePattern() == "", "over limit and no cached bypass");
        HttpContext largeHead = Program.Ctx("HEAD", "/static/limit.bin");
        StaticFiles.Serve(largeHead);
        Program.Check(largeHead.GetStatus() == 413 && !largeHead.IsBinary(), "large HEAD rejected");
        File.Delete(root + "/limit.bin");
        HttpContext missing = Program.Get("missing");
        Program.Check(missing.GetStatus() == 404 && missing.RoutePattern() == "", "missing file");
        Program.Check(Program.Get("../secret").GetStatus() == 404, "traversal");
        Program.Check(Program.Get("sub/").GetStatus() == 404, "directory path");
        Program.Check(StaticFiles.Serve(Program.Ctx("POST", "/static/x")), "method passthrough");
        Program.Check(StaticFiles.Serve(Program.Ctx("GET", "/other/x")), "mount passthrough");

        StaticProbeStream huge = new StaticProbeStream(4294967297, 0);
        HttpContext hugeCtx = Program.Ctx("GET", "/static/huge");
        StaticFiles.ServeStream(hugeCtx, "huge", huge);
        Program.Check(hugeCtx.GetStatus() == 413 && huge.reads == 0, "64-bit size before read");
        StaticProbeStream partial = new StaticProbeStream(5, 5);
        HttpContext partialCtx = Program.Ctx("GET", "/static/partial");
        StaticFiles.ServeStream(partialCtx, "partial", partial);
        Program.Check(partialCtx.GetStatus() == 200 && partialCtx.BodyLength() == 5
            && partialCtx.BodyBytes()[0] == 0 && partialCtx.BodyBytes()[4] == 4, "partial reads");
        StaticProbeStream growth = new StaticProbeStream(3, 100);
        HttpContext growthCtx = Program.Ctx("GET", "/static/growth");
        StaticFiles.ServeStream(growthCtx, "growth", growth);
        Program.Check(growthCtx.GetStatus() == 503 && !growthCtx.IsBinary()
            && growth.pos == 4 && growth.largestRead == 3, "growth bounded and rejected");
        StaticProbeStream shortFile = new StaticProbeStream(5, 2);
        HttpContext shortCtx = Program.Ctx("GET", "/static/short");
        StaticFiles.ServeStream(shortCtx, "short", shortFile);
        Program.Check(shortCtx.GetStatus() == 503 && !shortCtx.IsBinary(), "short read rejected");
        StaticProbeStream noRead = new StaticProbeStream(StaticFiles.MaxFileBytes, 0);
        HttpContext noReadCtx = Program.Ctx("HEAD", "/static/head");
        StaticFiles.ServeStream(noReadCtx, "head", noRead);
        Program.Check(noReadCtx.GetStatus() == 200 && noRead.reads == 0
            && noReadCtx.BodyLength() == StaticFiles.MaxFileBytes
            && noReadCtx.BodyBytes().Length == 0, "HEAD never reads");
        Directory.Delete(root);
        if (File.EmbedExists("assets/blob.bin")) {
            StaticFiles.Mount(new WebApp("127.0.0.1", 0), "/static", "assets");
            HttpContext embedded = Program.Get("blob.bin");
            Program.Check(embedded.GetStatus() == 200 && embedded.BodyLength() == 25
                && embedded.BodyBytes()[20] == 0 && embedded.BodyBytes()[23] == 255,
                "embedded binary");
            HttpContext embeddedHead = Program.Ctx("HEAD", "/static/blob.bin");
            StaticFiles.Serve(embeddedHead);
            Program.Check(embeddedHead.GetStatus() == 200 && embeddedHead.BodyLength() == 25
                && embeddedHead.BodyBytes().Length == 0, "embedded HEAD");
        }
        Console.WriteLine("static-files-bounded-ok: " + Convert.ToString(Program.bad == 0 ? 1 : 0));
    }
}
