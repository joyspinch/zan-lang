using System;

/* A parameter written over the class's own type parameters keeps its shape for
 * overload resolution: inside `Box<T>`, `Add(Item<T>)` must win over the
 * inherited `Node.Add(Node)` for an `Item<T>` argument. Ranking by type family
 * alone made the base overload look better (both sides reference types), so the
 * item was appended to the node's child list — and the next walk over that list
 * read an Item as a Node. */
class Node {
    List<Node> kids;

    public Node() { this.kids = new List<Node>(); }

    public Node Add(Node c) {
        kids.Add(c);
        return c;
    }

    public int KidCount() { return kids.Count; }
}

class Item<T> {
    public T val;
    public Item(T v) { this.val = v; }
}

class Box<T> : Node {
    List<Item<T>> items;

    public Box() { this.items = new List<Item<T>>(); }

    public Item<T> Add(Item<T> it) {
        items.Add(it);
        return it;
    }

    public Item<T> Make(T v) {
        Item<T> it = new Item<T>(v);
        return this.Add(it);
    }

    public int ItemCount() { return items.Count; }

    public string First() { return Convert.ToString(items[0].val); }
}

class Program {
    static void Main() {
        Box<string> b = new Box<string>();
        b.Make("one");
        b.Make("two");
        Console.WriteLine(Convert.ToString(b.ItemCount()) + " "
            + Convert.ToString(b.KidCount()) + " " + b.First());

        /* The inherited overload is still reachable with a Node argument. */
        b.Add(new Node());
        Console.WriteLine(Convert.ToString(b.ItemCount()) + " "
            + Convert.ToString(b.KidCount()));
    }
}
