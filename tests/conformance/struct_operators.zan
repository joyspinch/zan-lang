using System;

/* Value-struct equality and operator overloading, plus `const` members.
 * `==` on two structs used to emit an illegal integer compare, an operator
 * body on a struct did integer arithmetic on the aggregate, and `const`
 * failed to parse. */
struct Point {
    int x;
    int y;

    static Point Of(int a, int b) {
        Point p = new Point();
        p.x = a;
        p.y = b;
        return p;
    }

    public static Point operator +(Point a, Point b) {
        return Point.Of(a.x + b.x, a.y + b.y);
    }

    int X() { return x; }
    int Y() { return y; }
}

class Program {
    const int Scale = 10;

    static void Main() {
        Point a = Point.Of(1, 2);
        Point b = Point.Of(1, 2);
        Point c = Point.Of(3, 4);

        Console.WriteLine(a == b);
        Console.WriteLine(a == c);
        Console.WriteLine(a != b);
        Console.WriteLine(a != c);

        Point sum = a + c;
        Console.WriteLine(sum.X());
        Console.WriteLine(sum.Y());

        const int Local = 7;
        Console.WriteLine(Program.Scale + Local);
    }
}
