using System;
using System.Threading;

// `field.M()` on a static field or a field of `this`: a leaf callee (fields,
// primitives, runtime atomics only) needs no receiver pin; a callee that can
// replace the field while it runs must still keep the receiver alive.
class Counter {
    public long n;
    public void Bump() { n = n + 1; }
    public long Swap() { Program.shared = new Counter(); n = n + 10; return n; }
}
class Holder {
    public Counter c = new Counter();
    public long Run() { for (int i = 0; i < 1000; i++) c.Bump(); return c.n; }
}
class Program {
    public static Counter shared = new Counter();
    static AtomicInt total;
    static void Main() {
        total = new AtomicInt(0);
        for (int i = 0; i < 100000; i++) total.Add(1);
        Console.WriteLine(total.Load());
        for (int i = 0; i < 5; i++) shared.Bump();
        Console.WriteLine(shared.n);
        Console.WriteLine(shared.Swap());
        Console.WriteLine(shared.n);
        Console.WriteLine(new Holder().Run());
        shared = null;
    }
}
