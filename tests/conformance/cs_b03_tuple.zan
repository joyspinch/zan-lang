// cs_b03_tuple.zan -- C#-compat: tuples and deconstruction.
// `(a, b, ...)` literals lower to a synthesized anonymous struct with Item1..N
// fields; `var (x, y) = rhs` deconstructs by field, and tuple types can be
// spelled explicitly (`(int, int) t`), returned from methods, and read through
// `.ItemN` member access.
using System;

class Program {
    static (int, int) GetPair() {
        return (3, 7);
    }

    static (int, string) MakeNamed() {
        return (42, "answer");
    }

    static void Main() {
        // tuple literal + member access
        var t = (1, "hello");
        Console.WriteLine(t.Item1);
        Console.WriteLine(t.Item2);

        // var deconstruction
        var (a, b) = (10, 20);
        Console.WriteLine(a + b);

        // typed deconstruction (statement form)
        (int x, int y) = (5, 6);
        Console.WriteLine(x * y);

        // tuple returned from a method, deconstructed
        var (m, n) = GetPair();
        Console.WriteLine(m - n);

        // member access on a call result
        Console.WriteLine(GetPair().Item2);

        // explicit tuple type declaration
        (int, int) pt = (1, 2);
        Console.WriteLine(pt.Item1 + pt.Item2);

        // string element
        var (num, word) = MakeNamed();
        Console.WriteLine(num);
        Console.WriteLine(word);

        // tuple in a larger expression
        int v = true ? (100, 200).Item1 : 0;
        Console.WriteLine(v);
    }
}
