using System;

// B-ID63 顺带修复的回归钉：泛型（擦除槽）返回类型的 `return null` 曾把
// ARC 保留打在 Coerce 之后的 i64 0 上，发出非法 IR（icmp eq i8* 0, null）。
// 保留必须打在 Coerce 前的值上，字面 null 不保留。
class Box<E> {
    public E Get(long id) {
        return null;
    }
}

class Item {
    public string tag = "kept";
}

class Program {
    static void Main() {
        Box<Item> b = new Box<Item>();
        Item a = b.Get(1);
        Console.WriteLine("get: " + (a == null));
        Item v = new Item();
        Console.WriteLine("cmp: " + (v == null));
    }
}
