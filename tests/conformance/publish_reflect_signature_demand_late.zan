using System;
using System.Json;

class SignatureLateParameter { }
class SignatureLateReturn { }
class SignatureLateFieldType { }

class SignatureLateTarget {
    [Column("SIGNATURE_LATE_FIELD_ALIAS_STAYS")]
    [DefaultValue("SIGNATURE_LATE_FIELD_DEFAULT_STAYS")]
    [Description("SIGNATURE_LATE_FIELD_ATTR_STAYS")]
    public SignatureLateFieldType Field;

    public SignatureLateTarget() { }
    public SignatureLateTarget(SignatureLateParameter parameter) { }

    [Description("SIGNATURE_LATE_ATTR_MUST_STAY")]
    public SignatureLateReturn Describe(SignatureLateParameter parameter) { return null; }

    public void OnQuery() {
        TypeInfo type = typeof(SignatureLateTarget);
        bool found = false;
        for (int i = 0; i < type.MethodCount; i++) {
            if (type.GetMethodName(i) != "Describe") continue;
            found = true;
            Require(type.GetMethodReturnType(i) == "SignatureLateReturn", "return type");
            Require(type.GetMethodParamType(i, 0) == "SignatureLateParameter", "parameter type");
            Require(type.GetMethodCustomAttributes(i).Contains("SIGNATURE_LATE_ATTR_MUST_STAY"), "method attributes");
        }
        Require(found, "method enumeration");
        Require(type.ConstructorCount == 2, "constructor count");
        Require(type.GetCtorParamCount(1) == 1, "constructor parameter count");
        Require(type.GetCtorParamType(1, 0) == "SignatureLateParameter", "constructor parameter type");
        Require(type.GetFieldName(0) == "Field", "field name");
        Require(type.GetFieldType(0) == "SignatureLateFieldType", "field type name");
        Require(type.GetFieldTypeInfo(0).Name == "SignatureLateFieldType", "field TypeInfo");
        Require(FieldMapping.Read(type, 0).Name == "SIGNATURE_LATE_FIELD_ALIAS_STAYS", "field alias");
        Require(FieldMapping.Read(type, 0).DefaultValue == "SIGNATURE_LATE_FIELD_DEFAULT_STAYS", "field default");
        Require(type.GetFieldAttrs(0).Contains("SIGNATURE_LATE_FIELD_ATTR_STAYS"), "field attributes");
        Console.WriteLine("late signatures PASS");
    }

    static void Require(bool condition, string message) {
        if (!condition) throw new Exception(message);
    }
}

class Program {
    static void Main() {
        object target = new SignatureLateTarget();
        if (!target.Invoke("OnQuery")) throw new Exception("query hook missing");
        Console.WriteLine("signature demand PASS");
    }
}
