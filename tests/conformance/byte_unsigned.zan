using System;

class Program {
    static int Sum(byte[] data) {
        int total = 0;
        for (int i = 0; i < 3; i = i + 1) {
            total = total + (int)data[i];
        }
        return total;
    }

    static int ByteAt(byte[] data, int i) {
        return data[i];
    }

    static int SpanByteAt(nint p, int i) {
        return new Span<byte>(p + i, 1)[0];
    }

    static void Main() {
        byte b = 255;
        Console.WriteLine(b);
        Console.WriteLine((int)b);
        Console.WriteLine(b + 1);

        byte[] buf = new byte[3];
        buf[0] = 1;
        buf[1] = 200;
        buf[2] = 255;
        Console.WriteLine(buf[1]);
        Console.WriteLine(Program.Sum(buf));

        byte low = 0;
        Console.WriteLine(low);

        sbyte s = -1;
        Console.WriteLine(s);
        ushort u = 65535;
        Console.WriteLine(u);

        Console.WriteLine(Program.ByteAt(buf, 2));
        nint raw = NativeMemory.Alloc(4);
        NativeMemory.PutString(raw, 0, "中", 3);
        Console.WriteLine(Program.SpanByteAt(raw, 0));
        NativeMemory.Free(raw);

        // 无符号窄整型 → 浮点转换（B-ID149 回归钉）：装载值必须
        // 零拓宽后进 SIToFP，255 曾被符号扩展成 -1.0。
        double bd = (double)buf[2];
        float bf = (float)buf[1];
        Console.WriteLine(bd);
        Console.WriteLine(bf);
        Console.WriteLine(buf[2] * 1.0);
        char cx = (char)65535;
        Console.WriteLine((double)cx);
        sbyte sn = (sbyte)-1;
        Console.WriteLine((double)sn);
        byte[] more = new byte[2];
        more[0] = 255;
        more[1] = 127;
        double total = 0;
        for (int i = 0; i < 2; i = i + 1) {
            total = total + (double)more[i];
        }
        Console.WriteLine(total);
    }
}
