using System;

/* `byte` is an unsigned 8-bit value, as in C#: widening it anywhere (a print,
 * a cast, arithmetic, an array element) must zero-extend. */
class Program {
    static int Sum(byte[] data) {
        int total = 0;
        for (int i = 0; i < 3; i = i + 1) {
            total = total + (int)data[i];
        }
        return total;
    }

    /* `return` widens to the declared type too: returning a byte from an
     * `int` method sign-extended it, so a Span<byte> read of 0xE4 came back
     * as -28 and every non-ASCII byte looked negative to the caller. */
    static int ByteAt(byte[] data, int i) {
        return data[i];
    }

    static int SpanByteAt(nint p, int i) {
        return new Span<byte>(p + i, 1)[0];
    }

    static void Main() {
        byte b = 255;
        Console.WriteLine(b);
        Console.WriteLine((int)b);
        Console.WriteLine(b + 1);

        byte[] buf = new byte[3];
        buf[0] = 1;
        buf[1] = 200;
        buf[2] = 255;
        Console.WriteLine(buf[1]);
        Console.WriteLine(Program.Sum(buf));

        byte low = 0;
        Console.WriteLine(low);

        sbyte s = -1;
        Console.WriteLine(s);
        ushort u = 65535;
        Console.WriteLine(u);

        Console.WriteLine(Program.ByteAt(buf, 2));
        nint raw = NativeMemory.Alloc(4);
        NativeMemory.PutString(raw, 0, "中", 3);
        Console.WriteLine(Program.SpanByteAt(raw, 0));
        NativeMemory.Free(raw);
    }
}
