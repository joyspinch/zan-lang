using System;

class StaticDemandReflectLeaf {
    public static int Value = 17;
    static StaticDemandReflectLeaf() { Value = Value + 1; }
}
class StaticDemandReflectHelper {
    public static int Read() { return StaticDemandReflectLeaf.Value; }
}
class StaticDemandReflectOwner {
    public static int Seed = StaticDemandReflectHelper.Read() * 2;
    public static string Label = "reflected" + "-static";
    static StaticDemandReflectOwner() { Seed = Seed + 1; }
    // The implicit reflected constructor is discovered after Main's initial
    // codegen and consumes startup state through an instance initializer.
    public int Captured = Seed;
}
class StaticDemandReflectExplicit {
    public static int Value = 50;
    static StaticDemandReflectExplicit() { Value = Value + 1; }
    public int Captured;
    public StaticDemandReflectExplicit() { Captured = Value; }
}
// This type is declared before its dependencies. The init graph must retain
// indirect reflection edges as well as discover the types themselves.
class StaticDemandReflectInitRoot {
    public static int Value = Read();
    static int Read() {
        StaticDemandReflectProperty prop = new StaticDemandReflectProperty();
        prop.SetFieldInt("Input", 2);
        return prop.GetFieldInt("Signal") + prop.Captured + prop.InvokeInt("OnSignal");
    }
}
class StaticDemandReflectInvokeState {
    public static int Value = 80;
    static StaticDemandReflectInvokeState() { Value = Value + 1; }
}
class StaticDemandReflectPropertyState {
    public static int Value = 60;
    static StaticDemandReflectPropertyState() { Value = Value + 1; }
}
class StaticDemandReflectSetterState {
    public static int Value = 70;
    static StaticDemandReflectSetterState() { Value = Value + 1; }
}
class StaticDemandReflectProperty {
    public int Captured;
    public int Signal { get { return StaticDemandReflectPropertyState.Value; } }
    public int Input { set { Captured = StaticDemandReflectSetterState.Value + value; } }
    public int OnSignal() { return StaticDemandReflectInvokeState.Value; }
}
class StaticDemandReflectNever {
    public static int Value = Start();
    static int Start() {
        Console.WriteLine("STATIC_DEMAND_REFLECT_NEVER");
        return 9;
    }
}
class Program {
    static object Factory(TypeInfo type) { return type.CreateInstance(); }
    static void Require(bool ok, string message) {
        if (!ok) throw new Exception(message);
    }
    static void Main() {
        Console.WriteLine("static reflect begin");
        Require(StaticDemandReflectInitRoot.Value == 215,
        "initializer reflection getter setter and Invoke dependencies precede their consumer");
        object created = Factory(typeof(StaticDemandReflectOwner));
        Require(created is StaticDemandReflectOwner, "implicit reflected constructor identity");
        StaticDemandReflectOwner owner = (StaticDemandReflectOwner)created;
        Require(owner.Captured == 37 && StaticDemandReflectOwner.Seed == 37,
        "late implicit reflected constructor gets initialized static state");
        Require(StaticDemandReflectOwner.Label == "reflected-static", "late managed static storage");
        object explicitCreated = Factory(typeof(StaticDemandReflectExplicit));
        StaticDemandReflectExplicit explicitOwner = (StaticDemandReflectExplicit)explicitCreated;
        Require(explicitOwner.Captured == 51, "explicit reflected constructor activates owner");
        StaticDemandReflectProperty prop = new StaticDemandReflectProperty();
        Require(prop.GetFieldInt("Signal") == 61, "reflected getter initializes its static dependency");
        Require(prop.SetFieldInt("Input", 2), "reflected setter exists");
        Require(prop.Captured == 73, "reflected setter initializes its static dependency");
        Console.WriteLine("static reflect PASS");
    }
}
