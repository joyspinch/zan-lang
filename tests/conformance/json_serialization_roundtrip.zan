using System;
using System.Json;

namespace ConformanceTests;

class Program {
    static void Main() {
        TestObjectAndArrayManipulation();
        TestPathAccess();
        TestSerializationRoundtrip();
        TestJsonDocTape();
        TestJsonSerializerFacade();
        TestExceptionHandling();
        Console.WriteLine("ALL JSON TESTS PASSED");
    }

    static void TestObjectAndArrayManipulation() {
        JsonValue obj = JsonValue.NewObject();
        obj.PutStr("strKey", "hello world");
        obj.PutInt("intKey", 12345);
        obj.PutDouble("doubleKey", 3.14159);
        obj.PutBool("boolKey", true);
        obj.PutNull("nullKey");

        if (!obj.Has("strKey") || obj.Str("strKey", "") != "hello world") {
            Console.WriteLine("FAIL: obj strKey");
        }
        if (!obj.Has("intKey") || obj.Int("intKey", 0) != 12345) {
            Console.WriteLine("FAIL: obj intKey");
        }
        if (!obj.Has("doubleKey") || obj.Double("doubleKey", 0.0) < 3.14) {
            Console.WriteLine("FAIL: obj doubleKey");
        }
        if (!obj.Has("boolKey") || !obj.Bool("boolKey", false)) {
            Console.WriteLine("FAIL: obj boolKey");
        }
        if (!obj.Has("nullKey")) {
            Console.WriteLine("FAIL: obj nullKey");
        }

        obj.Set("intKey", JsonValue.NewInt(9999));
        if (obj.Int("intKey", 0) != 9999) {
            Console.WriteLine("FAIL: obj set intKey");
        }

        bool rem = obj.Remove("nullKey");
        if (!rem || obj.Has("nullKey")) {
            Console.WriteLine("FAIL: obj remove");
        }

        JsonValue arr = JsonValue.NewArray();
        arr.AppendStr("item0");
        arr.AppendInt(100);
        arr.AppendDouble(200.5);
        arr.AppendBool(false);

        if (arr.Count() != 4) {
            Console.WriteLine("FAIL: arr count");
        }
        if (arr.At(0).AsString("") != "item0") {
            Console.WriteLine("FAIL: arr at 0");
        }
        if (arr.At(1).AsInt(0) != 100) {
            Console.WriteLine("FAIL: arr at 1");
        }

        arr.SetAt(0, JsonValue.NewStr("updated0"));
        if (arr.At(0).AsString("") != "updated0") {
            Console.WriteLine("FAIL: arr setAt 0");
        }

        Console.WriteLine("OK: ObjectAndArrayManipulation");
    }

    static void TestPathAccess() {
        JsonValue root = JsonValue.NewObject();
        root.PathSet("user.profile.name", "Alice");
        root.PathSetValue("user.profile.age", JsonValue.NewInt(30));
        root.PathSetValue("user.active", JsonValue.NewBool(true));

        if (root.PathStr("user.profile.name", "") != "Alice") {
            Console.WriteLine("FAIL: PathStr");
        }
        if (root.PathInt("user.profile.age", 0) != 30) {
            Console.WriteLine("FAIL: PathInt");
        }
        JsonValue activeVal = root.PathGet("user.active");
        if (activeVal == null || !activeVal.AsBool(false)) {
            Console.WriteLine("FAIL: PathGet active");
        }

        Console.WriteLine("OK: PathAccess");
    }

    static void TestSerializationRoundtrip() {
        string original = "{\"alpha\":\"one\",\"beta\":[1,2,3],\"gamma\":{\"nested\":true}}";
        JsonValue val = JsonValue.Parse(original);
        if (val == null || !val.IsObject()) {
            Console.WriteLine("FAIL: Parse");
            return;
        }

        if (val.Str("alpha", "") != "one") {
            Console.WriteLine("FAIL: alpha");
        }
        JsonValue beta = val.Get("beta");
        if (beta == null || beta.Count() != 3 || beta.At(1).AsInt(0) != 2) {
            Console.WriteLine("FAIL: beta array");
        }

        string compact = val.ToJson();
        JsonValue roundtrip = JsonValue.Parse(compact);
        if (roundtrip == null || roundtrip.Str("alpha", "") != "one") {
            Console.WriteLine("FAIL: roundtrip");
        }

        string pretty = val.PrettyToJson();
        if (pretty.Length <= compact.Length) {
            Console.WriteLine("FAIL: pretty length");
        }

        Console.WriteLine("OK: SerializationRoundtrip");
    }

    static void TestJsonDocTape() {
        string json = "{\"id\":101,\"title\":\"TapeTest\",\"items\":[\"a\",\"b\"]}";
        JsonDoc doc = JsonDoc.Parse(json);
        if (doc.KindAt(doc.root) != 5) {
            Console.WriteLine("FAIL: JsonDoc root kind");
        }

        int idSlot = doc.Get(doc.root, "id");
        if (idSlot < 0 || doc.IntAt(idSlot, 0) != 101) {
            Console.WriteLine("FAIL: JsonDoc IntAt id");
        }

        int titleSlot = doc.Get(doc.root, "title");
        if (titleSlot < 0 || doc.StrAt(titleSlot, "") != "TapeTest") {
            Console.WriteLine("FAIL: JsonDoc StrAt title");
        }

        int itemsSlot = doc.Get(doc.root, "items");
        if (itemsSlot < 0 || doc.KindAt(itemsSlot) != 4 || doc.Count(itemsSlot) != 2) {
            Console.WriteLine("FAIL: JsonDoc items");
        }

        string reconstructed = doc.ToJson();
        if (reconstructed.Length == 0) {
            Console.WriteLine("FAIL: doc ToJson");
        }

        Console.WriteLine("OK: JsonDocTape");
    }

    static void TestJsonSerializerFacade() {
        JsonValue v = JsonValue.NewObject();
        v.PutStr("msg", "hello serializer");
        v.PutInt("code", 200);

        string json = JsonSerializer.Serialize(v);
        JsonValue parsed = JsonSerializer.Deserialize(json);
        if (parsed.Str("msg", "") != "hello serializer" || parsed.Int("code", 0) != 200) {
            Console.WriteLine("FAIL: JsonSerializer roundtrip");
        }

        JsonDoc doc = JsonSerializer.DeserializeDoc(json);
        int codeSlot = doc.Get(doc.root, "code");
        if (doc.IntAt(codeSlot, 0) != 200) {
            Console.WriteLine("FAIL: JsonSerializer doc");
        }

        Console.WriteLine("OK: JsonSerializerFacade");
    }

    static void TestExceptionHandling() {
        bool caught = false;
        try {
            JsonValue.Parse("{ invalid json ... }");
        } catch (JsonException ex) {
            caught = true;
        }
        if (!caught) {
            Console.WriteLine("FAIL: expected JsonException");
        }

        JsonValue lenient = JsonValue.ParseLenient("{ invalid json ... }");
        if (lenient == null) {
            Console.WriteLine("FAIL: ParseLenient returned null");
        }

        Console.WriteLine("OK: ExceptionHandling");
    }
}
