using System;

class CompactSharingBase {
    public int CompactSharedValue = 17;
    public int OnShared(int value) { return CompactSharedValue + value; }
    public int OnSecond(int value) { return CompactSharedValue * value; }
}
class CompactSharingA : CompactSharingBase { }
class CompactSharingB : CompactSharingBase { }
class CompactSharingC : CompactSharingBase { }
class CompactSharingD : CompactSharingBase { }
class CompactSharingE : CompactSharingBase { }
class CompactSharingF : CompactSharingBase { }
class CompactSharingG : CompactSharingBase { }
class CompactSharingH : CompactSharingBase { }

// These mutually recursive descriptors have no emitted/exported root. Merely
// constructing a shared pool must not make their field or hook payloads live.
class CompactSharingDeadA {
    public CompactSharingDeadB COMPACT_DEAD_FIELD_MUST_BE_ABSENT;
    public void OnDead() { Console.WriteLine("COMPACT_DEAD_HOOK_MUST_BE_ABSENT"); }
}
class CompactSharingDeadB { public CompactSharingDeadA Back; }

class Program {
    static int Check(object target) {
        TypeInfo type = target.GetType();
        if (!type.HasField("CompactSharedValue") || !type.HasMethod("OnShared") ||
        type.GetFieldName(0) != "CompactSharedValue") throw new Exception("shared discovery");
        int method = -1;
        for (int i = 0; i < type.MethodCount; i++) {
            if (type.GetMethodName(i) == "OnShared") method = i;
        }
        if (type.GetMethodReturnType(method) != "int" || type.GetMethodParamType(method, 0) != "int")
        throw new Exception("shared signature");
        return target.InvokeInt("OnShared", 5) + target.InvokeInt("OnSecond", 2);
    }

    static TypeInfo DeadType() { return typeof(CompactSharingDeadA); }

    static void Main() {
        int total = Check(new CompactSharingA()) + Check(new CompactSharingB()) +
        Check(new CompactSharingC()) + Check(new CompactSharingD()) +
        Check(new CompactSharingE()) + Check(new CompactSharingF()) +
        Check(new CompactSharingG()) + Check(new CompactSharingH());
        if (total != 448) throw new Exception("shared invocation");
        Console.WriteLine("compact sharing PASS");
    }
}
