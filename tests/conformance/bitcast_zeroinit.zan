using System;
using System.Runtime.InteropServices;

[StructLayout(LayoutKind.Sequential, Pack = 1)]
public struct Rgba8 {
    public byte R;
    public byte G;
    public byte B;
    public byte A;
}

public struct WorkPacket {
    public int Id;
    public long Stamp;
    public [4]int Lanes;
}

public class Program {
    public static void Main() {
        // 1. Scalar BitCast: float <-> int (IEEE-754 1.0f == 0x3F800000)
        int fbits = NativeMemory.BitCast<float, int>(1.0f);
        float fback = NativeMemory.BitCast<int, float>(fbits);

        // 2. Struct <-> uint zero-copy BitCast (little-endian: A<<24 | B<<16 | G<<8 | R)
        Rgba8 px = new Rgba8();
        px.R = 0x11;
        px.G = 0x22;
        px.B = 0x33;
        px.A = 0x44;
        uint packed = NativeMemory.BitCast<Rgba8, uint>(px);
        Rgba8 unpacked = NativeMemory.BitCast<uint, Rgba8>(packed);

        // 3. Inline array [4]byte <-> uint BitCast
        [4]byte raw = new InlineArray<4, byte>();
        raw[0] = 0x78;
        raw[1] = 0x56;
        raw[2] = 0x34;
        raw[3] = 0x12;
        uint magic = NativeMemory.BitCast<[4]byte, uint>(raw);

        // 4. ZeroInit on struct with nested inline array
        WorkPacket pkt = new WorkPacket();
        pkt.Id = 99;
        pkt.Stamp = 123456;
        pkt.Lanes[0] = 7;
        pkt.Lanes[3] = 88;
        NativeMemory.ZeroInit(ref pkt);

        Console.WriteLine($"fbits={fbits},fback={(int)fback}");
        Console.WriteLine($"packed={packed == 0x44332211u},unpacked={unpacked.R},{unpacked.G},{unpacked.B},{unpacked.A}");
        Console.WriteLine($"arrMagic={magic == 0x12345678u}");
        Console.WriteLine($"zero={pkt.Id},{pkt.Stamp},{pkt.Lanes[0]},{pkt.Lanes[3]}");
    }
}
