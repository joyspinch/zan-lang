// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。
using System;
using System.Diagnostics;

namespace Conf;

class Prog {
    static int bad = 0;

    static void Check(bool cond) {
        if (!cond) { bad = bad + 1; }
    }

    static string BaseName(string path) {
        int bs = -1;
        int fs = -1;
        for (int i = 0; i < path.Length; i = i + 1) {
            string ch = path.Substring(i, 1);
            if (ch == "\\") { bs = i; }
            if (ch == "/") { fs = i; }
        }
        int at = bs;
        if (fs > at) { at = fs; }
        if (at < 0) { return path; }
        return path.Substring(at + 1, path.Length - at - 1);
    }

    static void Main() {
        // 核心契约与语义定义。
        Check(Privileges.IsAdmin() == true || Privileges.IsAdmin() == false);
        Check(Privileges.UserName() != "");
        Check(Privileges.UserSid() != "");

        // 核心契约与执行状态转移规范。
        int self = ProcessList.SelfPid();
        Check(self > 0);
        Check(ProcessControl.IsRunning(self));
        int prio = ProcessControl.GetPriority(self);
        Check(prio >= 0 && prio <= 5);
        Check(ProcessControl.SetPriority(self, prio));
        // 核心契约与语义定义。
        Check(ProcessControl.GetExitCode(self) == -1);

        // 核心契约与语义定义。
        // 核心契约与语义定义。
        ProcessEntry me = ProcessList.ByPid(self);
        Check(me != null);
        if (me != null && me.exePath != "") {
            string baseName = BaseName(me.exePath);
            if (baseName.Length > 4 &&
                baseName.Substring(baseName.Length - 4, 4) == ".exe") {
                baseName = baseName.Substring(0, baseName.Length - 4);
            }
            bool found = false;
            List<ProcessEntry> hits = ProcessList.ByName(baseName);
            for (int i = 0; i < hits.Count; i = i + 1) {
                if (hits[i].pid == self) { found = true; }
            }
            Check(found);
        }

        Console.WriteLine("procctl-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
