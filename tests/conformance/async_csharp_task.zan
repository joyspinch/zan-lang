using System;
using System.Threading;

// 核心契约与语义定义。

interface IService {
    Task<int> ComputeAsync(int a, int b);
    Task SignalAsync(string name);
}

class Service : IService {
    public async Task<int> ComputeAsync(int a, int b) {
        await Task.Delay(1);
        return a + b;
    }

    public async Task SignalAsync(string name) {
        await Task.Delay(1);
        Console.WriteLine("signal: " + name);
    }
}

class Program {
    static async ValueTask<int> MultipliedAsync(int x) {
        await Task.Delay(1);
        return x * 3;
    }

    static void Main() {
        IService svc = new Service();
        int sum = await svc.ComputeAsync(15, 27);
        Console.WriteLine("sum: " + Convert.ToString(sum));
        await svc.SignalAsync("ready");

        int mult = await MultipliedAsync(10);
        Console.WriteLine("mult: " + Convert.ToString(mult));
    }
}
