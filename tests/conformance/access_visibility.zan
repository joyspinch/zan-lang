// Positive face of declared access control: the four visibility levels in
// combination, exercised exactly where they are *supposed* to work --
// private inside the declaring type, protected through a derived type,
// internal across types of one module, public everywhere. Unmarked members
// stay fully public: the entire pre-enforcement corpus depends on that.
using System;

namespace AccessOk;

class Base {
    private int seed = 5;
    protected int guard = 9;
    internal string tag = "in";
    public int open = 1;

    int Sum() { return this.seed + this.guard; }

    static Base Make() { return new Base(); }   // private ctor, in-type call
}

class Child : Base {
    int ReadGuard() { return this.guard; }
    int SumInherited() {
        // this.seed stays invisible from the derived body (private); only
        // the protected member participates here.
        return this.guard + 1;
    }
}

class Sibling {
    int TouchTag(Base b) {
        return Convert.ToInt(b.tag) + b.open;   // internal same-module + public
    }
}

class Program {
    static void Main() {
        Base b = Base.Make();
        Child c = new Child();
        Sibling s = new Sibling();

        Console.WriteLine(Convert.ToString(b.open));
        Console.WriteLine(Convert.ToString(c.ReadGuard()));
        Console.WriteLine(Convert.ToString(s.TouchTag(b)));
        Console.WriteLine(Convert.ToString(c.SumInherited()));
    }
}
