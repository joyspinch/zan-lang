using System;
using System.Collections.Generic;
using System.Json;
using System.Net.Http;
using System.Text;
using System.Web;
using Sdk.Taobao;
using Sdk.Jushuitan;
using Sdk.Jushuitan.Messages;

class OptWave35Core {
    static void TestTextTable() {
        Console.WriteLine("=== TEXT_TABLE ===");
        List<string> hdr = new List<string>();
        hdr.Add("Name");
        hdr.Add("Count");
        hdr.Add("Note");
        TextTable t = new TextTable(hdr);
        List<string> r1 = new List<string>();
        r1.Add("a");
        r1.Add("1");
        r1.Add("ok");
        t.AddRow(r1);
        List<string> r2 = new List<string>();
        r2.Add("longer");
        t.AddRow(r2);
        List<string> r3 = new List<string>();
        r3.Add("x");
        r3.Add("42");
        r3.Add("z");
        r3.Add("ignored");
        t.AddRow(r3);
        Console.WriteLine(t.Render());
        int[] narrow = new int[2];
        narrow[0] = 2;
        narrow[1] = 4;
        Console.WriteLine("b=" + TextTable.Border(narrow));
        Console.WriteLine("l=" + TextTable.Line(r2, narrow));
    }

    static void TestValidator() {
        Console.WriteLine("=== VALIDATOR ===");
        Validator v = new Validator();
        v.OneOf("a", "a,b,c", "f1")
         .OneOf("c", "a,b,c", "f2")
         .OneOf("", "a,b,c", "f3")
         .OneOf("d", "a,b,c", "f4")
         .OneOf("a,b", "a,b,c", "f5")
         .Require("", "req")
         .IsInt("-123", "i1")
         .IsInt("-", "i2")
         .IsInt("1a", "i3");
        Console.WriteLine("ok=" + (v.Ok() ? "1" : "0") + " ej=" + v.ErrorsJson());
        Validator vOk = new Validator();
        Console.WriteLine("empty=" + vOk.ErrorsJson());
        Validator vEsc = new Validator();
        vEsc.Require("", "a\"b\\c\n");
        Console.WriteLine("esc=" + vEsc.ErrorsJson());
        Console.WriteLine("ext="
            + (Validator.ExtAllowed("a.png", "png,jpg") ? "1" : "0")
            + (Validator.ExtAllowed("a.b.jpg", "png,jpg") ? "1" : "0")
            + (Validator.ExtAllowed("a.gif", "png,jpg") ? "1" : "0")
            + (Validator.ExtAllowed("nodot", "png,jpg") ? "1" : "0")
            + (Validator.ExtAllowed("trail.", "png,jpg") ? "1" : "0")
            + (Validator.ExtAllowed("a.png,jpg", "png,jpg") ? "1" : "0"));
        Console.WriteLine("sf="
            + Validator.SafeFileName("clean_1-2.txt") + "|"
            + Validator.SafeFileName("/dir/sub/ok.pdf") + "|"
            + Validator.SafeFileName("C:\\x\\..bad..name (1).JPG") + "|"
            + Validator.SafeFileName("...") + "|"
            + Validator.SafeFileName(""));
    }

    static void TestCsrf() {
        Console.WriteLine("=== CSRF ===");
        string s = ""
            + (Csrf.SameAuthority("https://Shop.Example.COM:443", "shop.example.com") ? "1" : "0")
            + (Csrf.SameAuthority("http://API.LOCAL:80", "api.local") ? "1" : "0")
            + (Csrf.SameAuthority("https://a.com:8443", "a.com:8443") ? "1" : "0")
            + (Csrf.SameAuthority("https://a.com:80", "a.com") ? "1" : "0")
            + (Csrf.SameAuthority("ftp://a.com", "a.com") ? "1" : "0")
            + (Csrf.SameAuthority("a.com:80", "A.COM") ? "1" : "0")
            + (Csrf.SameAuthorityForScheme("http://a.com", "a.com", true) ? "1" : "0")
            + (Csrf.SameAuthorityForScheme("HTTPS://A.COM", "a.com:443", true) ? "1" : "0")
            + (Csrf.SameAuthorityForScheme("a.com", "a.com", true) ? "1" : "0")
            + (Csrf.MatchesPrefix("/api/hook/1", "/api/hook") ? "1" : "0")
            + (Csrf.MatchesPrefix("/api/hook", "/api/hook") ? "1" : "0")
            + (Csrf.MatchesPrefix("/api/hook-x", "/api/hook") ? "1" : "0")
            + (Csrf.MatchesPrefix("/api/x", "/api/") ? "1" : "0")
            + (Csrf.ConstantTimeEquals("abcd", "abcd") ? "1" : "0")
            + (Csrf.ConstantTimeEquals("abcd", "abce") ? "1" : "0")
            + (Csrf.ConstantTimeEquals("abcd", "abc") ? "1" : "0");
        Console.WriteLine("flags=" + s + " trim="
            + Csrf.TrimDefaultPort("x.com:443", true) + "|"
            + Csrf.TrimDefaultPort("x.com:80", false) + "|"
            + Csrf.TrimDefaultPort("x.com:8080", true));
    }

    static void TestStaticFiles() {
        Console.WriteLine("=== STATIC_FILES ===");
        Console.WriteLine("rel="
            + StaticFiles.RelativeTo("/static/js/app.js", "/static") + "|"
            + (StaticFiles.RelativeTo("/static-x/a.js", "/static") == null ? "NULL" : "BAD") + "|"
            + (StaticFiles.RelativeTo("/static", "/static") == null ? "NULL" : "BAD") + "|"
            + StaticFiles.RelativeTo("/app.js", "/"));
        Console.WriteLine("safe="
            + (StaticFiles.IsSafe("a/b-1_2.js") ? "1" : "0")
            + (StaticFiles.IsSafe("../a.js") ? "1" : "0")
            + (StaticFiles.IsSafe("a/.env") ? "1" : "0")
            + (StaticFiles.IsSafe("a//b.js") ? "1" : "0")
            + (StaticFiles.IsSafe("a/") ? "1" : "0"));
        Console.WriteLine("ext="
            + StaticFiles.Extension("a/b.JS") + "|"
            + StaticFiles.Extension("a/b.woff2") + "|"
            + StaticFiles.Extension("a.d/noext") + "|"
            + StaticFiles.Extension("a."));
        Console.WriteLine("ct1="
            + StaticFiles.ContentType("a/x.JS") + "|"
            + StaticFiles.ContentType("a/x.CSS") + "|"
            + StaticFiles.ContentType("a/x.woff2") + "|"
            + StaticFiles.ContentType("a/x.unknown"));
        StaticFiles.RegisterMime(".wasm", "application/wasm");
        Console.WriteLine("ct2="
            + StaticFiles.ContentType("a/mod.WASM") + "|"
            + StaticFiles.ContentType("a/x.png"));
    }

    static void TestTaobao() {
        Console.WriteLine("=== TAOBAO ===");
        Dictionary<string, string> p = new Dictionary<string, string>();
        p.Add("b", "val 2");
        p.Add("a", "val+1/x");
        p.Add("empty", "");
        p.Add("sign", "SKIP");
        string sSha = TaobaoSign.ComputeWithBody(p, "{\"k\":1}", "sec123", "HMAC-SHA256");
        string sHmac = TaobaoSign.Compute(p, "sec123", "hmac");
        string sMd5 = TaobaoSign.Compute(p, "sec123", "MD5");
        Console.WriteLine("sha=" + sSha);
        Console.WriteLine("hmac=" + sHmac);
        Console.WriteLine("md5=" + sMd5);
        Console.WriteLine("form=" + TaobaoSign.FormEncode(p));
        Console.WriteLine("url=" + TaobaoSign.BuildUrlWithQuery("https://gw.test/r?x=1", p));

        List<long> ls = new List<long>();
        ls.Add(0L);
        ls.Add(42L);
        ls.Add(-9223372036854775807L - 1L);
        ls.Add(9223372036854775807L);
        List<bool> bs = new List<bool>();
        bs.Add(true);
        bs.Add(false);
        bs.Add(true);
        JsonValue jv = JsonSerializer.Deserialize("{\"l\":\"-9223372036854775808\",\"ovf\":\"9223372036854775808\",\"i\":\" -7 \",\"io\":\"3000000000\",\"b1\":\" TRUE \",\"b2\":\"0\"}");
        Console.WriteLine("jl=" + TaobaoJson.JoinLongList(ls));
        Console.WriteLine("jb=" + TaobaoJson.JoinBoolList(bs));
        Console.WriteLine("jg="
            + Convert.ToString(TaobaoJson.GetLong(jv, "l", -1L)) + ","
            + Convert.ToString(TaobaoJson.GetLong(jv, "ovf", -1L)) + ","
            + Convert.ToString(TaobaoJson.GetInt(jv, "i", -1)) + ","
            + Convert.ToString(TaobaoJson.GetInt(jv, "io", -1)) + ","
            + (TaobaoJson.GetBool(jv, "b1", false) ? "1" : "0") + ","
            + (TaobaoJson.GetBool(jv, "b2", true) ? "1" : "0"));
    }

    static void TestJushuitan() {
        Console.WriteLine("=== JUSHUITAN ===");
        string ak = "app1";
        string sec = "sec1";
        string biz = "{\"o_id\":99,\"note\":\"a b+c\"}";
        Dictionary<string, string> f = new Dictionary<string, string>();
        f.Add("app_key", ak);
        f.Add("action_code", JushuitanMessageCallback.Shipment);
        f.Add("timestamp", "1764300000");
        f.Add("version", "2");
        f.Add("charset", "UTF-8");
        f.Add("biz", biz);
        string sig = JushuitanSign.Compute(f, sec);
        f.Add("sign", sig);
        string body = JushuitanSign.FormEncode(f);
        Console.WriteLine("sig=" + sig + " ver=" + (JushuitanSign.Verify(f, sec) ? "1" : "0"));
        HttpRequest req = new HttpRequest();
        req.method = "POST";
        req.path = "/cb";
        req.contentType = "  Application/X-WWW-Form-Urlencoded ; charset=utf-8";
        req.body = body;
        JushuitanMessage msg = JushuitanMessageCallback.Parse(req, ak, sec);
        Console.WriteLine("msg=" + msg.AppKey + "|" + msg.ActionCode + "|" + msg.RawPayloadJson);
        Console.WriteLine("resp=" + JushuitanMessageCallback.SuccessResponse() + "|" + JushuitanMessageCallback.FailureResponse());

        // 校验异常优先级：非法 % 转义优先于缺少等号，且能识别编码不同的重复键
        HttpRequest badPct = new HttpRequest();
        badPct.method = "POST";
        badPct.contentType = "application/x-www-form-urlencoded";
        badPct.body = "noeq&a=%ZZ";
        string e1 = "";
        try { JushuitanMessageCallback.Parse(badPct, ak, sec); }
        catch (JushuitanException ex) { e1 = ex.Message; }

        HttpRequest dup = new HttpRequest();
        dup.method = "POST";
        dup.contentType = "application/x-www-form-urlencoded";
        dup.body = "app_key=1&%61pp_key=2";
        string e2 = "";
        try { JushuitanMessageCallback.Parse(dup, ak, sec); }
        catch (JushuitanException ex) { e2 = ex.Message; }
        Console.WriteLine("err=" + e1 + "|" + e2);
    }

    static void Main() {
        OptWave35Core.TestTextTable();
        OptWave35Core.TestValidator();
        OptWave35Core.TestCsrf();
        OptWave35Core.TestStaticFiles();
        OptWave35Core.TestTaobao();
        OptWave35Core.TestJushuitan();
    }
}
