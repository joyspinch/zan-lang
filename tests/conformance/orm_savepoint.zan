// ORM **事务保存点**（savepoint）——在一条事务里划出可回滚的子段。
//
// 覆盖：
// - **回滚到保存点**：该点之后的写入撤销，而保存点之前的写入仍然保留；
//   事务本身还活着（可以继续写、继续提交）。
// - **回滚后保存点仍然活着**（SQL 语义）：还能再回滚一次。
// - **释放**：释放之后不能再回滚到它（抛错，并点名是哪个保存点）。
// - **同名重复建立** → 抛错（不静默覆盖）。
// - **名字必须是合法标识符**：名字会直接进 SQL 文本，含引号/空格/分号/
//   以数字开头的一律拒绝（注入防护）。
// - **事务结束后**再操作保存点 → 抛错（而不是发一句必然失败的 SQL）。
// - **异步版**与同步版等价。
// - **TransactionScope** 转发可用。
// - **方言**：各家保存点语句不同（SQL Server 是 SAVE TRANSACTION，
//   Oracle 家族没有 RELEASE），不支持事务的后端直接抛错。
using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.IO;

class Program {
    static int failures = 0;

    static void Ok(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            Program.failures = Program.failures + 1;
        }
    }

    // 取第一行第一列的整数。
    static int ScalarInt(IDbExecutor ex, string sql) {
        DbResult r = ex.Query(sql);
        if (r.RowCount() == 0) { return -1; }
        return r.GetInt(0, 0);
    }

    static void Main() {
        string path = "orm_savepoint.tmp.db";
        File.Delete(path);
        SqliteConnection db = SqliteConnection.Open(path);
        db.Execute("CREATE TABLE acct (id INTEGER PRIMARY KEY, name TEXT, bal INTEGER)");
        db.Execute("INSERT INTO acct VALUES (1, 'a', 100)");

        IZanSql fsql = ZanSql.FromConnection(db);

        // ---- 1. 回滚到保存点：之后的写入撤销，之前的写入保留，事务还活着 ----
        {
            IUnitOfWork uow = fsql.CreateUnitOfWork();
            uow.Execute("UPDATE acct SET bal = 50 WHERE id = 1");
            uow.CreateSavepoint("sp1");
            uow.Execute("UPDATE acct SET bal = 0 WHERE id = 1");
            uow.Execute("INSERT INTO acct VALUES (2, 'b', 7)");
            Ok(ScalarInt(uow, "SELECT bal FROM acct WHERE id = 1") == 0,
                "保存点之后的写入在事务内可见");
            Ok(ScalarInt(uow, "SELECT COUNT(*) FROM acct") == 2,
                "保存点之后的新行在事务内可见");

            uow.RollbackToSavepoint("sp1");
            Ok(ScalarInt(uow, "SELECT bal FROM acct WHERE id = 1") == 50,
                "回滚到保存点后余额回到保存点时的值");
            Ok(ScalarInt(uow, "SELECT COUNT(*) FROM acct") == 1,
                "回滚到保存点后新行消失");

            // 事务还活着：继续写并提交。
            uow.Execute("UPDATE acct SET bal = 60 WHERE id = 1");
            uow.Commit();
            uow.Dispose();
            Ok(ScalarInt(db, "SELECT bal FROM acct WHERE id = 1") == 60,
                "回滚之后事务仍可继续写并提交");
            Ok(ScalarInt(db, "SELECT COUNT(*) FROM acct") == 1,
                "提交后只有保存点之前的写入");
        }

        // ---- 2. 回滚之后保存点仍然活着（可以再回滚一次）----
        {
            IUnitOfWork uow = fsql.CreateUnitOfWork();
            uow.CreateSavepoint("sp2");
            uow.Execute("UPDATE acct SET bal = 10 WHERE id = 1");
            uow.RollbackToSavepoint("sp2");
            Ok(ScalarInt(uow, "SELECT bal FROM acct WHERE id = 1") == 60,
                "第一次回滚生效");
            uow.Execute("UPDATE acct SET bal = 20 WHERE id = 1");
            uow.RollbackToSavepoint("sp2");
            Ok(ScalarInt(uow, "SELECT bal FROM acct WHERE id = 1") == 60,
                "回滚后保存点仍然活着，可以再回滚一次");
            uow.Rollback();
            uow.Dispose();
            Ok(ScalarInt(db, "SELECT bal FROM acct WHERE id = 1") == 60,
                "整体回滚后回到提交时的值");
        }

        // ---- 3. 释放之后不能再回滚到它 ----
        {
            IUnitOfWork uow = fsql.CreateUnitOfWork();
            uow.CreateSavepoint("sp3");
            uow.ReleaseSavepoint("sp3");
            string msg = "";
            bool threw = false;
            try {
                uow.RollbackToSavepoint("sp3");
            } catch (Exception e) {
                threw = true;
                msg = e.Message;
            }
            Ok(threw, "释放后回滚抛错");
            Ok(msg.IndexOf("sp3") >= 0, "错误消息点名是哪个保存点");
            Console.WriteLine("released: " + msg);
            uow.Rollback();
            uow.Dispose();
        }

        // ---- 4. 同名重复建立 → 抛错 ----
        {
            IUnitOfWork uow = fsql.CreateUnitOfWork();
            uow.CreateSavepoint("sp4");
            string msg = "";
            bool threw = false;
            try {
                uow.CreateSavepoint("sp4");
            } catch (Exception e) {
                threw = true;
                msg = e.Message;
            }
            Ok(threw, "同名保存点重复建立抛错");
            Console.WriteLine("dup: " + msg);
            uow.Rollback();
            uow.Dispose();
        }

        // ---- 5. 名字必须是合法标识符（名字会直接进 SQL 文本）----
        {
            IUnitOfWork uow = fsql.CreateUnitOfWork();
            string[] bad = new string[] { "a b", "a;b", "a'b", "1st", "", "a-b" };
            int rejected = 0;
            for (int i = 0; i < bad.Length; i = i + 1) {
                try {
                    uow.CreateSavepoint(bad[i]);
                } catch (Exception _e) {
                    rejected = rejected + 1;
                }
            }
            Ok(rejected == bad.Length, "非法保存点名一律被拒");
            // 合法的名字能用
            bool okName = true;
            try {
                uow.CreateSavepoint("_sp_5");
            } catch (Exception _e) {
                okName = false;
            }
            Ok(okName, "下划线开头的名字可用");
            uow.Rollback();
            uow.Dispose();
        }

        // ---- 6. 事务结束后不能再操作保存点 ----
        {
            IUnitOfWork uow = fsql.CreateUnitOfWork();
            uow.Commit();
            string msg = "";
            bool threw = false;
            try {
                uow.CreateSavepoint("sp6");
            } catch (Exception e) {
                threw = true;
                msg = e.Message;
            }
            Ok(threw, "提交后建立保存点抛错");
            Console.WriteLine("after-commit: " + msg);
            uow.Dispose();
        }

        // ---- 7. 异步版与同步版等价 ----
        {
            IUnitOfWork uow = await fsql.CreateUnitOfWorkAsync();
            await uow.CreateSavepointAsync("sp7");
            uow.Execute("UPDATE acct SET bal = 999 WHERE id = 1");
            await uow.RollbackToSavepointAsync("sp7");
            Ok(ScalarInt(uow, "SELECT bal FROM acct WHERE id = 1") == 60,
                "异步回滚到保存点生效");
            await uow.ReleaseSavepointAsync("sp7");
            await uow.CommitAsync();
            uow.Dispose();
            Ok(ScalarInt(db, "SELECT bal FROM acct WHERE id = 1") == 60,
                "异步提交后值不变");
        }

        // ---- 8. TransactionScope 转发 ----
        {
            TransactionScope scope = TransactionScope.Create(fsql);
            scope.CreateSavepoint("sp8");
            scope.uow.Execute("UPDATE acct SET bal = 777 WHERE id = 1");
            scope.RollbackToSavepoint("sp8");
            Ok(ScalarInt(scope.uow, "SELECT bal FROM acct WHERE id = 1") == 60,
                "TransactionScope 的保存点转发生效");
            scope.Complete();
            scope.Dispose();
            Ok(ScalarInt(db, "SELECT bal FROM acct WHERE id = 1") == 60,
                "作用域提交后值不变");
        }

        // ---- 9. 方言：各家的保存点语句不同 ----
        {
            Ok(Savepoint.CreateSql(DbProvider.SQLite, "s") == "SAVEPOINT s",
                "标准族用 SAVEPOINT");
            Ok(Savepoint.RollbackSql(DbProvider.SQLite, "s")
                == "ROLLBACK TO SAVEPOINT s", "标准族用 ROLLBACK TO SAVEPOINT");
            Ok(Savepoint.ReleaseSql(DbProvider.SQLite, "s")
                == "RELEASE SAVEPOINT s", "标准族用 RELEASE SAVEPOINT");
            Ok(Savepoint.CreateSql(DbProvider.SqlServer, "s")
                == "SAVE TRANSACTION s", "SQL Server 用 SAVE TRANSACTION");
            Ok(Savepoint.RollbackSql(DbProvider.SqlServer, "s")
                == "ROLLBACK TRANSACTION s", "SQL Server 用 ROLLBACK TRANSACTION");
            Ok(Savepoint.ReleaseSql(DbProvider.SqlServer, "s").Length == 0,
                "SQL Server 没有释放语句");
            Ok(Savepoint.ReleaseSql(DbProvider.Oracle, "s").Length == 0,
                "Oracle 家族没有释放语句");
            Ok(Savepoint.CreateSql(DbProvider.Oracle, "s") == "SAVEPOINT s",
                "Oracle 家族用 SAVEPOINT");
            string msg = "";
            bool threw = false;
            try {
                Savepoint.CreateSql(DbProvider.ClickHouse, "s");
            } catch (Exception e) {
                threw = true;
                msg = e.Message;
            }
            Ok(threw, "不支持事务的后端直接抛错");
            Console.WriteLine("unsupported: " + msg);
        }

        // ---- 10. 名字长度边界 ----
        {
            string long63 = "";
            for (int i = 0; i < 63; i = i + 1) { long63 = long63 + "a"; }
            bool ok63 = true;
            try {
                Savepoint.Name(long63);
            } catch (Exception _e) {
                ok63 = false;
            }
            Ok(ok63, "63 字符的名字可用");
            string long64 = long63 + "a";
            bool threw = false;
            try {
                Savepoint.Name(long64);
            } catch (Exception _e) {
                threw = true;
            }
            Ok(threw, "64 字符的名字被拒");
        }

        db.Close();
        File.Delete(path);
        Console.WriteLine("failures=" + Convert.ToString(Program.failures));
    }
}
