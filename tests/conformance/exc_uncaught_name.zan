// 回归(D14):未捕获的类异常此前只打印 "Unhandled exception (class object)",
// 看不出异常类别(审计里误判为"穿透 catch 的野异常"——catch (Exception)
// 实际都能接住;问题只在未捕获报告不具名)。现在未捕获报告通过 tid-name
// 注册表(沿基类链地址匹配)解析真实类名,stderr 打印
// 核心契约与执行状态转移规范。
// 本用例走 catch (Exception) 路径验证行为不变;未具名改进由
// leakcheck/arcguard 孪生与人工 stderr 检查覆盖。
using System;
namespace Conf;

class Program {
    static void Main() {
        try {
            throw new InvalidOperationException("caught-one");
        } catch (Exception e) {
            Console.WriteLine("caught: " + e.Message);
        }
        // 派生类 catch 经基类链命中
        try {
            throw new FileNotFoundException("derived");
        } catch (IOException e) {
            Console.WriteLine("io: " + e.Message);
        }
        Console.WriteLine("done");
    }
}
