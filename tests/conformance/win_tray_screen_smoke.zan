// TrayIcon + Screen smoke test: icon lifecycle must succeed without a UI,
// and screen metrics/capture must return sane values. The tray icon is
// added, modified, ballooned and removed -- nothing is clicked, so the test
// is safe to run unattended. Windows only.
using System;
using System.IO;
using System.Windows;

namespace Conf;

class Prog {
    static int bad = 0;

    static void Check(bool cond) {
        if (!cond) { bad = bad + 1; }
    }

    static void Main() {
        // Screen metrics.
        Check(Screen.ScreenWidth() > 0);
        Check(Screen.ScreenHeight() > 0);
        Check(Screen.Dpi() >= 96);
        // Capture 16x16 -> 16*16*4 bytes.
        byte[] px = Screen.CapturePixels(0, 0, 16, 16);
        Check(px != null && px.Length == 1024);
        // Pixel color has alpha 0xFF (capture is opaque). The RGB value
        // itself is arbitrary (any color is valid), so only check the alpha.
        int c = Screen.GetPixel(0, 0);
        Check((c & 0xFF000000) == 0xFF000000);
        // Save a tiny BMP and check the header.
        string path = Path.GetTempPath() + "zan_scr_" +
                      Convert.ToString(ProcessList.SelfPid()) + ".bmp";
        Check(Screen.CaptureToBmp(path, 0, 0, 8, 8));
        if (File.Exists(path)) {
            byte[] hdr = new byte[30];
            // No public ReadAllBytes; fopen/fread via File.Copy into a buffer
            // is overkill -- just verify the file is non-trivial in size.
            Check(File.GetSize(path) >= 54 + 8 * 8 * 4);
            File.Delete(path);
        }

        // Tray icon lifecycle.
        Check(TrayIcon.Add("", "zan tray", Prog.OnTray));
        Check(TrayIcon.SetTooltip("zan tray v2"));
        Check(TrayIcon.ShowBalloon("Test", "tray balloon", 1, 500));
        // Right-click menu model: set, replace (toggled check) and clear.
        // Nothing is clicked, so the menu is never popped up here.
        List<TrayMenuItem> menu = new List<TrayMenuItem>();
        menu.Add(new TrayMenuItem(1, "Show"));
        menu.Add(TrayMenuItem.Separator());
        menu.Add(new TrayMenuItem(2, "Autostart").Check(true));
        menu.Add(new TrayMenuItem(3, "Busy").Disabled());
        menu.Add(new TrayMenuItem(4, "Exit"));
        TrayIcon.SetMenu(menu, Prog.OnMenu);
        TrayIcon.SetMenu(menu, Prog.OnMenu);
        TrayIcon.ClearMenu();
        TrayIcon.Remove();
        Console.WriteLine("win-tray-screen-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }

    static void OnMenu(int id) {
        // No clicks in this test; callback must never fire.
        bad = bad + 1;
    }

    static void OnTray(int action) {
        // No clicks in this test; callback must never fire.
        bad = bad + 1;
    }
}
