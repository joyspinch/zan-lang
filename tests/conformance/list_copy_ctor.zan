using System;
namespace P;
class Item {
    public int v;
    public Item(int x) { v = x; }
}
class Program {
    static List<int> MakeSrc() {
        List<int> l = new List<int>();
        l.Add(3); l.Add(1); l.Add(4); l.Add(1); l.Add(5);
        return l;
    }
    static void Main() {
        // value elements: the copy is independent of its source
        List<int> src = MakeSrc();
        List<int> cp = new List<int>(src);
        cp[0] = 100;
        cp.Add(9);
        Console.WriteLine(src.Count);
        Console.WriteLine(cp.Count);
        Console.WriteLine(src[0]);
        Console.WriteLine(cp[0]);
        int s = 0;
        for (int i = 0; i < cp.Count; i = i + 1) { s = s + cp[i]; }
        Console.WriteLine(s);

        // RC elements (string): copied slots stay readable
        List<string> names = new List<string>();
        names.Add("alpha"); names.Add("beta");
        List<string> names2 = new List<string>(names);
        names.Add("gamma");
        Console.WriteLine(names2.Count);
        Console.WriteLine(names2[1]);

        // class elements: shallow copy shares the instances
        List<Item> items = new List<Item>();
        items.Add(new Item(7));
        List<Item> items2 = new List<Item>(items);
        items2[0].v = 70;
        Console.WriteLine(items[0].v);
        Console.WriteLine(items2.Count);

        // copying an empty list
        List<int> empty = new List<int>();
        List<int> empty2 = new List<int>(empty);
        Console.WriteLine(empty2.Count);
    }
}
