// 测试断言与状态转移验证。
// 测试断言与状态转移验证。
// 测试断言与状态转移验证。
// 测试断言与状态转移验证。
// 测试断言与状态转移验证。
using System;
using System.Scripting;

namespace Conf;

class Prog {
    static int ZanMul(nint L) {
        double a = Lua.ArgDouble(L, 1);
        double b = Lua.ArgDouble(L, 2);
        return Lua.ReturnDouble(L, a * b);
    }

    static void Main() {
        if (!Lua.IsAvailable()) {
            // 测试断言与状态转移验证。
            Console.WriteLine("lua-ok: 1");
            return;
        }
        int bad = 0;

        Lua.Initialize();

        // 核心契约与语义定义。
        Lua.Exec("answer = 6 * 7");
        if (Lua.Eval("answer").ToLong() != 42L) { bad = bad + 1; }
        if (Lua.GetGlobal("answer").ToLong() != 42L) { bad = bad + 1; }

        // 接口数据协议与执行契约。
        if (Lua.CallD("math.floor", 22.3) != 22.0) { bad = bad + 1; }
        if (Lua.CallL("math.max", 3L, 7L, 5L) != 7L) { bad = bad + 1; }
        if (Lua.CallS("string.upper", "zan") != "ZAN") { bad = bad + 1; }

        // 测试断言与状态转移验证。
        Lua.Exec("function greet(name)\n  return '你好, ' .. name .. '!'\nend\n");
        LuaValue greet = Lua.GetGlobal("greet");
        if (greet.Call(Lua.FromStr("Zan")).ToStr() != "你好, Zan!") { bad = bad + 1; }
        if (greet("Zan").ToStr() != "你好, Zan!") { bad = bad + 1; }
        if (Lua.CallS("greet", "Zan") != "你好, Zan!") { bad = bad + 1; }

        // 核心契约与语义定义。
        long big = 1234567890123L;
        if (Lua.FromLong(big).ToLong() != big) { bad = bad + 1; }
        if (Lua.FromDouble(3.25).ToDouble() != 3.25) { bad = bad + 1; }
        if (Lua.FromStr("中文往返").ToStr() != "中文往返") { bad = bad + 1; }
        if (!Lua.FromBool(true).ToBool()) { bad = bad + 1; }
        if (Lua.FromBool(false).ToBool()) { bad = bad + 1; }
        if (!Lua.Nil().IsNil()) { bad = bad + 1; }

        // 测试断言与状态转移验证。
        LuaValue squares = Lua.Eval("{1, 4, 9}");
        if (!squares.IsTable()) { bad = bad + 1; }
        if (squares.Length() != 3L) { bad = bad + 1; }
        if (squares[2].ToLong() != 4L) { bad = bad + 1; }
        squares[3] = Lua.FromLong(99L);
        if (squares[3].ToLong() != 99L) { bad = bad + 1; }
        List<double> ds = Lua.Eval("{0, 1, 4, 9}").ToListDouble();
        if (ds.Count != 4 || ds[3] != 9.0) { bad = bad + 1; }
        List<string> names = new List<string>();
        names.Add("alice");
        names.Add("bob");
        Lua.Exec("function upper_all(t)\n  local r = {}\n  for i, s in ipairs(t) do r[i] = string.upper(s) end\n  return r\nend\n");
        List<string> up = Lua.Call("upper_all", Lua.FromListStr(names)).ToListStr();
        if (up.Count != 2 || up[0] != "ALICE") { bad = bad + 1; }
        List<double> nums = new List<double>();
        nums.Add(1.5);
        nums.Add(2.5);
        if (Lua.Call("table.concat", Lua.FromListDouble(nums)).ToStr() != "1.52.5") {
            bad = bad + 1;
        }

        // 测试断言与状态转移验证。
        LuaValue person = Lua.Eval("{name = 'Zan', lang = 'Lua'}");
        if (person["name"].ToStr() != "Zan") { bad = bad + 1; }
        person["lang"] = "Zan";
        if (person.Get("lang").ToStr() != "Zan") { bad = bad + 1; }
        Dictionary<string, LuaValue> pd = person.ToDict();
        if (pd["name"].ToStr() != "Zan") { bad = bad + 1; }
        if (pd.Count != 2) { bad = bad + 1; }
        Dictionary<string, string> cfg = new Dictionary<string, string>();
        cfg["mode"] = "fast";
        cfg["debug"] = "off";
        Lua.Exec("function read_mode(d)\n  return d.mode .. '/' .. d.debug\nend\n");
        if (Lua.Call("read_mode", Lua.FromDictStr(cfg)).ToStr() != "fast/off") {
            bad = bad + 1;
        }

        // 接口数据协议与执行契约。
        Lua.SetGlobal("injected", Lua.FromLong(7L));
        if (Lua.Eval("injected * 6").ToLong() != 42L) { bad = bad + 1; }

        // 核心契约与执行状态转移规范。
        if (!Lua.RegisterFunction("zan_mul", ZanMul)) { bad = bad + 1; }
        if (Lua.Eval("zan_mul(3, 4)").ToDouble() != 12.0) { bad = bad + 1; }
        Lua.Exec("assert(zan_mul(3, 4) == 12.0)");

        // 测试断言与状态转移验证。
        bool threw = false;
        try {
            Lua.Exec("error('boom')");
        } catch (InvalidOperationException) {
            threw = true;
        }
        if (!threw) { bad = bad + 1; }
        threw = false;
        try {
            Lua.Exec("this is not lua");
        } catch (InvalidOperationException) {
            threw = true;
        }
        if (!threw) { bad = bad + 1; }

        // 测试断言与状态转移验证。
        if (Lua.Top() != 0) { bad = bad + 1; }

        // 接口数据协议与执行契约。
        Lua.Sandbox();
        if (!Lua.Eval("os.execute").IsNil()) { bad = bad + 1; }
        if (!Lua.Eval("os.remove").IsNil()) { bad = bad + 1; }
        if (!Lua.Eval("os.rename").IsNil()) { bad = bad + 1; }
        if (!Lua.Eval("os.exit").IsNil()) { bad = bad + 1; }
        if (!Lua.Eval("io").IsNil()) { bad = bad + 1; }
        if (!Lua.Eval("dofile").IsNil()) { bad = bad + 1; }
        if (!Lua.Eval("loadfile").IsNil()) { bad = bad + 1; }
        if (!Lua.Eval("require").IsNil()) { bad = bad + 1; }
        if (!Lua.Eval("package").IsNil()) { bad = bad + 1; }
        // 接口数据协议与执行契约。
        if (Lua.Eval("math.floor(22.3)").ToLong() != 22L) { bad = bad + 1; }
        if (Lua.Eval("string.upper('zan')").ToStr() != "ZAN") { bad = bad + 1; }
        if (Lua.Eval("os.time").IsNil()) { bad = bad + 1; }
        // 核心契约与语义定义。
        threw = false;
        try {
            Lua.Exec("os.execute('echo pwned')");
        } catch (InvalidOperationException) {
            threw = true;
        }
        if (!threw) { bad = bad + 1; }
        if (Lua.Top() != 0) { bad = bad + 1; }

        Lua.Finalize();
        Console.WriteLine("lua-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
