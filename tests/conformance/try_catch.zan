class Probe {
    static string Thrower(int n) {
        if (n == 0) {
            throw "zero";
        }
        return "ok" + n;
    }
    static int Inner() {
        try {
            string s = Probe.Thrower(0);
            Console.WriteLine(s);
            return 1;
        } catch (string e) {
            Console.WriteLine("inner caught " + e);
            return 2;
        }
    }
    static int Outer() {
        try {
            return Probe.Inner();
        } catch {
            return 3;
        }
    }
    static int Main() {
        Console.WriteLine("r=" + Probe.Outer());
        try {
            try {
                throw "deep";
            } finally {
                Console.WriteLine("fin1");
            }
        } catch (string e) {
            Console.WriteLine("outer caught " + e);
        }
        try {
            Console.WriteLine("after=" + Probe.Thrower(7));
        } catch {
            Console.WriteLine("not reached");
        }
        return 0;
    }
}
