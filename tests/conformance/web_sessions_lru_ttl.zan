using System;
using System.Web;

class Program {
    static int bad = 0;

    static void Eq(string what, string got, string want) {
        if (got == want) {
            Console.WriteLine("ok " + what);
        } else {
            Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
            Program.bad = Program.bad + 1;
        }
    }

    static void Main() {
        // 1. 容量 3，TTL 100 秒
        Sessions s = new Sessions(3, 100);
        string t1 = s.Issue("user_1", 1000);
        string t2 = s.Issue("user_2", 1000);
        string t3 = s.Issue("user_3", 1000);

        Program.Eq("initial count", Convert.ToString(s.Count()), "3");
        Program.Eq("get user 1", s.UserOf(t1, 1010), "user_1");
        Program.Eq("get user 2", s.UserOf(t2, 1010), "user_2");
        Program.Eq("get user 3", s.UserOf(t3, 1010), "user_3");

        // 2. LRU 淘汰：t1 和 t3 最近访问过，t2 最旧；追加 t4 应当只淘汰 t2，绝不暴力清空全仓
        s.UserOf(t1, 1020); // 顺序: t1 -> t3 -> t2
        string t4 = s.Issue("user_4", 1025); // t2 应被淘汰
        Program.Eq("count after evict", Convert.ToString(s.Count()), "3");
        Program.Eq("t1 retained", s.UserOf(t1, 1025), "user_1");
        Program.Eq("t2 evicted", s.UserOf(t2, 1025), "");
        Program.Eq("t3 retained", s.UserOf(t3, 1025), "user_3");
        Program.Eq("t4 retained", s.UserOf(t4, 1025), "user_4");

        // 3. TTL 过期：t1 发放于 1000, TTL 100 -> expiresAt 1100；在 1101 查询应失效并被惰性清理
        Program.Eq("t1 expired", s.UserOf(t1, 1105), "");
        Program.Eq("count after lazy expire", Convert.ToString(s.Count()), "2");

        // 4. 单项删除 Remove
        bool removed = s.Remove(t3);
        Program.Eq("remove t3", removed ? "true" : "false", "true");
        Program.Eq("t3 gone", s.UserOf(t3, 1025), "");
        Program.Eq("count after remove", Convert.ToString(s.Count()), "1");

        // 5. Clear 全量清空
        s.Clear();
        Program.Eq("count after clear", Convert.ToString(s.Count()), "0");
        Program.Eq("t4 gone after clear", s.UserOf(t4, 1025), "");

        if (Program.bad > 0) {
            Console.WriteLine("FAIL: " + Convert.ToString(Program.bad));
        } else {
            Console.WriteLine("all pass");
        }
    }
}
