using System;
using System.Collections.Generic;

/// A314 回归：`dict.Keys[i]` / `dict.Values[i]` 链式下标曾整表达式折叠成
/// 常量 0——emit_expr_index 的成员分支只认声明的字段
/// （member_access_field_type），Dict.Keys/Values 是合成视图不是字段，
/// arr_ptr 为 NULL 落进兜底。修复后成员分支回落 infer_expr_type，
/// 合成视图（含方法返回值的链）与普通字段链一致。
class Factory {
    public Dict<string, int> Make() {
        Dict<string, int> m = new Dict<string, int>();
        m.Add("inner", 7);
        return m;
    }
}

class Holder {
    public List<string> names;
}

class Program {
    static void Main() {
        Dict<string, int> d = new Dict<string, int>();
        d.Add("alpha", 11);
        d.Add("beta", 22);

        // 视图链下标（曾折叠成 0）
        Console.WriteLine(d.Keys[0]);
        Console.WriteLine(d.Keys[1]);
        Console.WriteLine(d.Values[1]);
        string s = d.Keys[0];
        Console.WriteLine(s);
        Console.WriteLine("head-" + d.Keys[1]);

        // Count 链一直是好的（回归确认）
        Console.WriteLine(d.Keys.Count);

        // 方法返回值的链：call->member->index（曾走 field-only 路径）
        Factory f = new Factory();
        Console.WriteLine(f.Make().Keys[0]);
        Console.WriteLine(f.Make().Values[0]);

        // 普通字段链不受影响
        Holder h = new Holder();
        h.names = new List<string>();
        h.names.Add("held");
        Console.WriteLine(h.names[0]);
    }
}
