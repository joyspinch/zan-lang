using System;

enum Color { Red, Blue }
class Base { public int v; public Base() { v = 1; } }
class Derived : Base { public Derived() { v = 2; } }

class Program {
    static int Main() {
        char c1 = 'a';
        char c2 = 'b';
        Console.WriteLine("sum=" + Convert.ToString((int)(char)(c1 + c2)));
        Console.WriteLine("i=" + Convert.ToString((int)3.9));
        Console.WriteLine("d=" + Convert.ToString((double)7));
        Console.WriteLine("bt=" + Convert.ToString((byte)300));
        Console.WriteLine("ci=" + Convert.ToString((int)Color.Blue));
        Console.WriteLine("col=" + Convert.ToString((Color)1 == Color.Blue));
        Base b = new Derived();
        Console.WriteLine("down=" + Convert.ToString(((Derived)b).v));
        object o = b;
        Console.WriteLine("unbox=" + Convert.ToString(((Base)o).v));
        return 0;
    }
}
