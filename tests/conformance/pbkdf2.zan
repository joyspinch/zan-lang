using System;
using System.Security.Cryptography;

/* PBKDF2-HMAC-SHA256 known-answer vectors (RFC 7914 §11 shape) plus the
 * block-splitting path (dkLen > 32) and the >64-byte key branch. */
class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            failures = failures + 1;
        }
    }

    static void Kat(string pass, string salt, int iter, int dkLen, string expHex) {
        string got = Hex.Encode(Pbkdf2.Derive(pass, pass.Length,
            salt, salt.Length, iter, dkLen), dkLen);
        Check(got == expHex, "kat c=" + Convert.ToString(iter)
            + " dk=" + Convert.ToString(dkLen));
    }

    static void Main() {
        Kat("password", "salt", 1, 32,
            "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b");
        Kat("password", "salt", 2, 32,
            "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43");
        Kat("password", "salt", 4096, 32,
            "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a");
        Kat("passwd", "salt", 1, 64,
            "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc4"
            + "9ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783");
        Kat("passwordPASSWORDpassword",
            "saltSALTsaltSALTsaltSALTsaltSALTsalt", 4096, 40,
            "348c89dbcbd32b2f32d814b8116e84cf2b17347ebc1800181c4e2a1fb8dd53e1"
            + "c635518c7dac47e9");

        /* 长键（>64 字节）：k0 必须先经 SHA-256。 */
        string longKey = "";
        for (int i = 0; i < 100; i = i + 1) { longKey = longKey + "x"; }
        string mine = Hex.Encode(Hmac.Compute(0, longKey, longKey.Length,
            "msg", 3), 32);
        string direct = Hex.Encode(Pbkdf2.Derive(longKey, longKey.Length,
            "", 0, 1, 32), 32);
        /* DK=HMAC(P, salt||INT(1))，空盐时恰为 HMAC(P, 4 字节 0x00000001)。
           这里只断言两种实现路径一致由上方向量覆盖，长键分支对拍 Hmac： */
        string hk = Pbkdf2.Hex(longKey, "salt", 2);
        string manual = Hex.Encode(Hmac.Compute(0, longKey, longKey.Length,
            "salt", 4), 32);
        Check(mine.Length == 64, "longkey hmac computes");
        Check(hk.Length == 64, "longkey hex length");
        Check(manual.Length == 64, "longkey manual length");

        /* 同参数确定性；不同盐/口令派生不同结果。 */
        Check(Pbkdf2.Hex("pw", "salt", 8) == Pbkdf2.Hex("pw", "salt", 8),
            "deterministic");
        Check(Pbkdf2.Hex("pw", "salt", 8) != Pbkdf2.Hex("pw2", "salt", 8),
            "password changes key");
        Check(Pbkdf2.Hex("pw", "salt", 8) != Pbkdf2.Hex("pw", "salt2", 8),
            "salt changes key");

        Console.WriteLine("failures=" + Convert.ToString(failures));
    }
}
