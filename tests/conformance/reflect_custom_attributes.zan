using System;

[Table(Name = "sys_user")]
[Custom(Auth = "Admin", Cache = true)]
class User {
    [Column(Name = "user_id", IsPrimary = true, IsIdentity = true, StringLength = 64)]
    public long id;

    [Column("user_name", StringLength = 128)]
    [Required]
    public string username;

    [Column(Ignore = true)]
    [NotMapped]
    public string passwordHash;

    [DefaultValue("active")]
    public string status;

    [Column(Name = "user_role", StringLength = 32)]
    public string role { get; set; }

    [Route("/api/users")]
    [HttpGet]
    [Description("Get all users")]
    public void ListUsers() {
    }
}

class Program {
    static void Main() {
        TypeInfo ti = typeof(User);

        // 1. 类级特性与表名验证
        Console.WriteLine("Table: " + ti.TableName);
        Console.WriteLine("ClassAttrs: " + ti.GetCustomAttributes());

        // 2. 字段级特性与元数据位表验证
        Console.WriteLine("FieldCount: " + Convert.ToString(ti.FieldCount));
        for (int i = 0; i < ti.FieldCount; i++) {
            string fn = ti.GetFieldName(i);
            string cn = ti.GetFieldCustomName(i);
            bool pk = ti.IsFieldPk(i);
            bool ident = ti.IsFieldIdentity(i);
            bool ign = ti.IsFieldIgnored(i);
            bool req = ti.IsFieldRequired(i);
            string df = ti.GetFieldDefault(i);
            string attrs = ti.GetFieldCustomAttributes(i);

            Console.WriteLine("Field[" + Convert.ToString(i) + "]: " + fn +
                " CustomName=" + (cn != null ? cn : "") +
                " Pk=" + Convert.ToString(pk) +
                " Identity=" + Convert.ToString(ident) +
                " Ignored=" + Convert.ToString(ign) +
                " Required=" + Convert.ToString(req) +
                " Default=" + (df != null ? df : ""));
            Console.WriteLine("  Attrs: " + (attrs != null ? attrs : ""));
        }

        // 3. 方法级特性验证
        for (int m = 0; m < ti.MethodCount; m++) {
            string mn = ti.GetMethodName(m);
            if (mn == "ListUsers") {
                string mattrs = ti.GetMethodCustomAttributes(m);
                Console.WriteLine("Method ListUsers Attrs: " + (mattrs != null ? mattrs : ""));
            }
        }
    }
}
