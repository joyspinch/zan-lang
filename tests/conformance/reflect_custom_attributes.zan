using System;
using System.Json;
using System.Data.Orm;
using System.Reflection;

[Marker("true", Flag = true, Text = "A;:雪\n\\u0041")]
[Marker]
class AttributeFixture {
    [Marker("field;:=\\")]
    public int Value;

    public void Plain() { }

    [Marker("true", Flag = true, Text = "A;:雪\n\\u0041")]
    [Marker]
    public void Annotated() { }

    [Marker(Value = (Flags.One | Scope.Flags.Two) | Flags.Three, Other = Flags.One + Flags.Two)]
    public void Symbolic() { }
}

[Table(Name = "sys_user")]
[Custom(Auth = "Admin", Cache = true)]
class User {
    [Column(Name = "user_id", IsPrimary = true, IsIdentity = true, StringLength = 64)]
    public long id;

    [Column("user_name", StringLength = 128)]
    [Required]
    public string username;

    [Column(Ignore = true)]
    [NotMapped]
    public string passwordHash;

    [DefaultValue("active")]
    public string status;

    [Column(Name = "user_role", StringLength = 32)]
    public string role { get; set; }

    [Route("/api/users")]
    [HttpGet]
    [Description("Get all users")]
    public void ListUsers() {
    }
}

class Program {
    static void CheckAttributeData() {
        TypeInfo type = typeof(AttributeFixture);
        AttributeReader attributes = new AttributeReader(type.GetDeclaredAttributeData());
        if (!attributes.MoveNext() || attributes.Name != "Marker"
            || !attributes.MoveNextArgument() || attributes.ArgumentName != ""
            || attributes.ArgumentKind != 'S' || attributes.ArgumentValue != "true"
            || !attributes.MoveNextArgument() || attributes.ArgumentName != "Flag"
            || attributes.ArgumentKind != 'B' || attributes.ArgumentValue != "true"
            || !attributes.MoveNextArgument() || attributes.ArgumentName != "Text"
            || attributes.ArgumentKind != 'S' || attributes.ArgumentValue != "A;:雪\n\\u0041"
            || attributes.MoveNextArgument()
            || !attributes.MoveNext() || attributes.Name != "Marker"
            || attributes.MoveNextArgument() || attributes.MoveNext()) {
            throw new Exception("Type attribute kinds or declaration order changed");
        }
        int annotated = -1;
        int plain = -1;
        int symbolic = -1;
        for (int i = 0; i < type.MethodCount; i++) {
            string name = type.GetMethodName(i);
            if (name == "Annotated") annotated = i;
            if (name == "Plain") plain = i;
            if (name == "Symbolic") symbolic = i;
        }
        if (annotated < 0 || plain < 0
            || type.GetMethodAttributeData(annotated) != type.GetDeclaredAttributeData()
            || type.GetMethodAttributeData(plain) != ""
            || type.GetMethodAttributeData(-1) != "" || type.GetMethodAttributeData(type.MethodCount) != "") {
            throw new Exception("Method attribute data or index bounds changed");
        }
        AttributeReader symbols = new AttributeReader(type.GetMethodAttributeData(symbolic));
        if (!symbols.MoveNext() || symbols.Name != "Marker" || !symbols.MoveNextArgument()
            || symbols.ArgumentName != "Value" || symbols.ArgumentKind != 'E'
            || symbols.ArgumentValue != "Flags.One|Scope.Flags.Two|Flags.Three"
            || !symbols.MoveNextArgument() || symbols.ArgumentName != "Other"
            || symbols.ArgumentKind != 'X' || symbols.ArgumentValue != "" || symbols.MoveNextArgument()) {
            throw new Exception("Method attribute symbolic expressions changed");
        }
        AttributeReader field = new AttributeReader(type.GetFieldAttributeData(0));
        if (!field.MoveNext() || field.Name != "Marker" || !field.MoveNextArgument()
            || field.ArgumentValue != "field;:=\\" || field.MoveNextArgument() || field.MoveNext()
            || type.GetFieldAttributeData(-1) != "" || type.GetFieldAttributeData(type.FieldCount) != "") {
            throw new Exception("Field attribute data or index bounds changed");
        }
    }

    static void Main() {
        CheckAttributeData();
        TypeInfo ti = typeof(User);

        // 1. 类级特性与表名验证
        Console.WriteLine("Table: " + Meta.TableName(ti));
        Console.WriteLine("ClassAttrs: " + ti.GetCustomAttributes());

        // 2. 字段级特性与元数据位表验证
        Console.WriteLine("FieldCount: " + Convert.ToString(ti.FieldCount));
        for (int i = 0; i < ti.FieldCount; i++) {
            string fn = ti.GetFieldName(i);
            FieldMapping mapping = FieldMapping.Read(ti, i);
            string cn = mapping.Name;
            bool pk = mapping.Primary;
            bool ident = mapping.Identity;
            bool ign = mapping.Ignored;
            bool req = mapping.Required;
            string df = mapping.DefaultValue;
            string attrs = ti.GetFieldCustomAttributes(i);

            Console.WriteLine("Field[" + Convert.ToString(i) + "]: " + fn +
                " CustomName=" + (cn != null ? cn : "") +
                " Pk=" + Convert.ToString(pk) +
                " Identity=" + Convert.ToString(ident) +
                " Ignored=" + Convert.ToString(ign) +
                " Required=" + Convert.ToString(req) +
                " Default=" + (df != null ? df : ""));
            Console.WriteLine("  Attrs: " + (attrs != null ? attrs : ""));
        }

        // 3. 方法级特性验证
        for (int m = 0; m < ti.MethodCount; m++) {
            string mn = ti.GetMethodName(m);
            if (mn == "ListUsers") {
                string mattrs = ti.GetMethodCustomAttributes(m);
                Console.WriteLine("Method ListUsers Attrs: " + (mattrs != null ? mattrs : ""));
            }
        }
    }
}
