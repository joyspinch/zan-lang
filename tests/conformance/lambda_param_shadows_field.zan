using System;

// A lambda parameter shadows a field of the same name in the enclosing class.
//
// The parameter of an untyped lambda (`count => ...`) has no type where the
// checker sees it -- the delegate type fixes it at the use site -- so the
// checker has to put the parameter into scope anyway. Otherwise the name
// resolves to the class field (an int here) and the body is checked against
// the wrong type: "type 'int' has no member 'Length'".
class Program {
    int count = 3;
    delegate string Op(string a);

    void Run() {
        Op op = count => count.Length.ToString();
        Console.WriteLine("out=" + op("v"));
    }

    static void Main() {
        new Program().Run();
    }
}
