using System;

namespace Alpha;

class Log {
    class Nested {
        class Deep {
            string Text() { return Log.Line("nested"); }
        }
        string Text() { Deep d = new Deep(); return d.Text(); }
    }
    static string NestedLine() { Nested n = new Nested(); return n.Text(); }
    static string Line(string s) { return "alpha: " + s; }
}

class Tag {
    string text;

    static Tag Of(string s) {
        Tag t = new Tag();
        t.text = s;
        return t;
    }

    string Text() { return "alpha tag " + text; }
}
