using System;
using Alpha;

namespace NsDupMain;

/// Two namespaces declare a `Log` and a `Tag` (see alpha.zan / beta.zan), so
/// nsresolve renames both declarations. A type also appears in expression
/// position as the receiver of a static call, which has to follow the rename --
/// and a parameter that happens to carry a type's name must not.
class Program {
    /// The parameter shadows `Alpha.Log`: here `Log` is the value.
    static string Use(Tag Log) { return Log.Text(); }

    static void Main() {
        Console.WriteLine(Log.Line("main"));
        Console.WriteLine(Beta.Log.Line("qualified"));
        Console.WriteLine(Use(Tag.Of("shadowed")));
        Console.WriteLine(Beta.Tag.Of("other").Text());
    }
}
