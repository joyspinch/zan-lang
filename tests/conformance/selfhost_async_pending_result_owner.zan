using System;

class PendingPayload {
    public int value;
    public PendingPayload(int n) { value = n; }
}
class SelfhostAsyncPendingResultOwner {
    static long cancelHandle;

    static async PendingPayload Normal(PendingPayload payload) {
        try { return payload; }
        finally { await Task.Yield(); }
    }
    static async PendingPayload Caught(PendingPayload payload) {
        try { return payload; }
        finally {
            await Task.Yield();
            try { throw new Exception("caught"); }
            catch (Exception e) { Console.WriteLine(e.Message); }
        }
    }
    static async PendingPayload Aborted(PendingPayload payload) {
        try { return payload; }
        finally {
            await Task.Yield();
            throw new Exception("aborted");
        }
    }
    static async PendingPayload Cancelled(PendingPayload payload) {
        try { return payload; }
        finally {
            await Task.Yield();
            Task.Cancel(SelfhostAsyncPendingResultOwner.cancelHandle);
            await Task.Yield();
            Console.WriteLine("unreachable");
        }
    }
    static async void Main() {
        PendingPayload normal = new PendingPayload(41);
        WeakReference<PendingPayload> normalObserver = new WeakReference<PendingPayload>(normal);
        PendingPayload returned = await Normal(normal);
        normal = null;
        Console.WriteLine(returned.value);
        Console.WriteLine(normalObserver.IsAlive);
        returned = null;
        Console.WriteLine(normalObserver.IsAlive);

        PendingPayload caught = new PendingPayload(42);
        WeakReference<PendingPayload> caughtObserver = new WeakReference<PendingPayload>(caught);
        PendingPayload caughtResult = await Caught(caught);
        caught = null;
        Console.WriteLine(caughtResult.value);
        caughtResult = null;
        Console.WriteLine(caughtObserver.IsAlive);

        PendingPayload aborted = new PendingPayload(43);
        WeakReference<PendingPayload> abortedObserver = new WeakReference<PendingPayload>(aborted);
        try { PendingPayload ignored = await Aborted(aborted); }
        catch (Exception e) { Console.WriteLine(e.Message); }
        aborted = null;
        Console.WriteLine(abortedObserver.IsAlive);

        PendingPayload cancelled = new PendingPayload(44);
        WeakReference<PendingPayload> cancelledObserver = new WeakReference<PendingPayload>(cancelled);
        SelfhostAsyncPendingResultOwner.cancelHandle = Task.Spawn(Cancelled(cancelled));
        cancelled = null;
        await Task.Delay(20);
        Console.WriteLine(cancelledObserver.IsAlive);
        Console.WriteLine("pending result owner ok");
    }
}
