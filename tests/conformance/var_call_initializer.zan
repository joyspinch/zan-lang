using System;

/* 底层系统交互与数据协议契约 */
class Point {
    public int X;
    public int Y;
}

class Maker {
    Point At(int x, int y) {
        Point p = new Point();
        p.X = x;
        p.Y = y;
        return p;
    }

    List<int> Evens(int n) {
        List<int> xs = new List<int>();
        for (int i = 0; i < n; i = i + 2) xs.Add(i);
        return xs;
    }

    public int Run() {
        var p = At(3, 4);          /* 核心系统底层抽象与内存语义契约 */
        int len = p.X + p.Y;       /* 核心系统底层抽象与内存语义契约 */
        var xs = Evens(6);         /* List<int> from a call */
        int sum = 0;
        foreach (int v in xs) sum = sum + v;   /* 核心系统底层抽象与内存语义契约 */
        var arr = Nums();          /* 核心系统底层抽象与内存语义契约 */
        sum = sum + arr[1] + arr.Length;
        /* len*100 + (0+2+4) + 20 + 2 = 700 + 6 + 22 = 728 */
        return len * 100 + sum;
    }

    int[] Nums() {
        int[] a = new int[2];
        a[0] = 10;
        a[1] = 20;
        return a;
    }
}

class Program {
    static void Main() {
        var m = new Maker();
        Console.WriteLine(m.Run());
        var s = Pick();            /* 核心系统底层抽象与内存语义契约 */
        Console.WriteLine(s.Length);
    }

    static string Pick() { return "abcd"; }
}
