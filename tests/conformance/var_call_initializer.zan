using System;

/* var inference from a method-call initializer: the local's static type must
 * come from the callee's declared return type, not from the LLVM value kind
 * (every class instance is a pointer, which the old fallback typed `string` --
 * member access died with "'string' has no member" and `.Length` read the
 * object header via strlen). Covers class instances, List<T>, arrays and
 * scope-exit release through the correctly-typed local. */
class Point {
    public int X;
    public int Y;
}

class Maker {
    Point At(int x, int y) {
        Point p = new Point();
        p.X = x;
        p.Y = y;
        return p;
    }

    List<int> Evens(int n) {
        List<int> xs = new List<int>();
        for (int i = 0; i < n; i = i + 2) xs.Add(i);
        return xs;
    }

    public int Run() {
        var p = At(3, 4);          /* class instance from a private call */
        int len = p.X + p.Y;       /* member access on the inferred class */
        var xs = Evens(6);         /* List<int> from a call */
        int sum = 0;
        foreach (int v in xs) sum = sum + v;   /* iteration over the var */
        var arr = Nums();          /* array from a call */
        sum = sum + arr[1] + arr.Length;
        /* len*100 + (0+2+4) + 20 + 2 = 700 + 6 + 22 = 728 */
        return len * 100 + sum;
    }

    int[] Nums() {
        int[] a = new int[2];
        a[0] = 10;
        a[1] = 20;
        return a;
    }
}

class Program {
    static void Main() {
        var m = new Maker();
        Console.WriteLine(m.Run());
        var s = Pick();            /* string from a call still works */
        Console.WriteLine(s.Length);
    }

    static string Pick() { return "abcd"; }
}
