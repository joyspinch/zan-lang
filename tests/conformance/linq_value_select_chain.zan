using System;
using System.Collections.Generic;
using System.Linq;

class Program {
    static int Main() {
        List<int> source = new List<int>();
        source.Add(2);
        source.Add(5);
        ValueEnumerable<int> values = new ValueEnumerable<int>(source);
        ValueSelectIterator<int, string> first = values.Select<string>((int value) => value.ToString());
        ValueSelectIterator<int, int> second = first.Select<int>((string value) => value.Length);
        List<int> result = second.ToList();
        bool ok = result.Count == 2 && result[0] == 1 && result[1] == 1;
        Console.WriteLine(ok ? "projection chain preserves source type" : "FAIL projection chain");
        return ok ? 0 : 1;
    }
}
