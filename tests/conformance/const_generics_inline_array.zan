using System;

struct FixedBuf<const int N, T> {
    public InlineArray<N, T> Data;
    public int Size() {
        return N;
    }
}

class Program {
    static int SumConst<const int N>(Span<int> s) {
        int acc = 0;
        for (int i = 0; i < N; i++) {
            acc = acc + s[i];
        }
        return acc;
    }

    static int SumInline<const int N>(ref InlineArray<N, int> a) {
        int acc = 0;
        for (int i = 0; i < a.Length; i++) {
            acc = acc + a[i];
        }
        return acc;
    }

    static void ScaleSpan(noalias Span<int> dst, noalias ReadOnlySpan<int> src, int factor) {
        for (int i = 0; i < dst.Length; i++) {
            dst[i] = src[i] * factor;
        }
    }

    static void Main() {
        // 1. Shorthand [N]T stack-allocated value array (zero heap, zero ARC)
        [8]int a = new InlineArray<8, int>();
        for (int i = 0; i < a.Length; i++) {
            a[i] = i + 1;
        }
        Console.WriteLine($"len:{a.Length},sum:{SumInline<8>(ref a)}");

        // 2. Zero-copy AsSpan / AsReadOnlySpan interop with noalias Span<T>
        [8]int b = new InlineArray<8, int>();
        ScaleSpan(b.AsSpan(), a.AsReadOnlySpan(), 3);
        Console.WriteLine($"scaled:{b[0]},{b[3]},{b[7]}");

        // 3. Generic method with <const int N> expression usage
        Console.WriteLine($"const4:{SumConst<4>(b.AsSpan())},const8:{SumConst<8>(b.AsSpan())}");

        // 4. Generic struct with <const int N, T> containing InlineArray<N, T>
        FixedBuf<4, int> f4 = new FixedBuf<4, int>();
        f4.Data[0] = 10;
        f4.Data[1] = 20;
        f4.Data[2] = 30;
        f4.Data[3] = 40;

        FixedBuf<6, int> f6 = new FixedBuf<6, int>();
        for (int i = 0; i < f6.Size(); i++) {
            f6.Data[i] = (i + 1) * 5;
        }
        Console.WriteLine($"f4:{f4.Size()},{f4.Data[0]},{f4.Data[3]}");
        Console.WriteLine($"f6:{f6.Size()},{f6.Data[0]},{f6.Data[5]}");
    }
}
