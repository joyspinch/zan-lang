using System;
using Game.Foundation;

namespace Tests.GameTween;

class Program {
    static void Main() {
        // 1. Easing 基础求值验证
        double linear = Easing.Evaluate(EaseType.Linear, 0.5);
        double quadIn = Easing.Evaluate(EaseType.QuadIn, 0.5);
        double quadOut = Easing.Evaluate(EaseType.QuadOut, 0.5);
        double bounceOutHalf = Easing.Evaluate(EaseType.BounceOut, 0.5);

        Console.WriteLine("linear=" + Convert.ToString((int)(linear * 100.0)));
        Console.WriteLine("quadIn=" + Convert.ToString((int)(quadIn * 100.0)));
        Console.WriteLine("quadOut=" + Convert.ToString((int)(quadOut * 100.0)));
        Console.WriteLine("bounceOut=" + Convert.ToString((int)(bounceOutHalf * 100.0)));

        // 2. 补间实例生命周期与延迟
        Tween t = new Tween(100.0, 200.0, 1000, EaseType.Linear);
        t.SetDelay(200);

        // 未过 delay
        t.Update(100);
        Console.WriteLine("val_delay=" + Convert.ToString((int)t.Value()) + ",done=" + Convert.ToString(t.IsFinished()));

        // 步入动画中段 (100+300=400ms，有效时间 200ms/1000ms = 0.2)
        t.Update(300);
        Console.WriteLine("val_active=" + Convert.ToString((int)t.Value()) + ",prog=" + Convert.ToString((int)(t.Progress() * 100.0)));

        // 推进至完成 (过剩余 800ms)
        t.Update(900);
        Console.WriteLine("val_done=" + Convert.ToString((int)t.Value()) + ",done=" + Convert.ToString(t.IsFinished()));

        // 3. TweenGroup 批量推进与自动移除
        TweenGroup group = new TweenGroup();
        Tween t1 = group.To(0.0, 50.0, 100, EaseType.Linear);
        Tween t2 = group.To(0.0, 100.0, 300, EaseType.Linear);
        Console.WriteLine("group_count=" + Convert.ToString(group.Count()));

        // 步进 150ms，t1 完成应被自动清理，t2 仍在活跃
        group.Update(150);
        Console.WriteLine("group_after_step=" + Convert.ToString(group.Count()) + ",t2_val=" + Convert.ToString((int)t2.Value()));

        // 步进至全部完成
        group.Update(200);
        Console.WriteLine("group_finished=" + Convert.ToString(group.Count()));
    }
}
