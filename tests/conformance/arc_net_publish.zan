// A52-5: --publish carries an over-release net. The release path's existing
// rc<=0 comparison reports once through the fail-soft note and CONTINUES --
// an over-release only leaks (the count never reaches zero, so nothing is
// freed), so the net must never abort or exit(70); it just announces the bug.
//
// The firing case cannot be written from safe Zan code (that is the point of
// the net), so the runtime firing behavior is pinned by the hand-run
// injection probe recorded in TASKS.md (A52-5), and this case pins the two
// things the net must not do on a correct program: change the exit status,
// or fire at all. The borrowed-extern buffer below even carries bytes that
// read as refcount 1 -- if a rebuild starts releasing borrowed externs, the
// slot is positive and stays silent by design; the real hazard (slot reads
// 0) is what the net catches, and the negative control here proves correct
// programs -- including extern-heavy ones -- stay clean.
using System;
using System.NativeMemory;
namespace P;
class Program {
    static void Main() {
        nint p = NativeMemory.Alloc(32);
        NativeMemory.Fill(p, 1, 8);       // reads as refcount 1, positive
        string s = NativeMemory.GetString(p, 0, 8);
        Console.WriteLine("borrow=" + s.Length);
        NativeMemory.Free(p);

        // Correct ARC traffic around it: owned strings, scoped releases.
        string a = "AA" + "BB";
        string b = "CC" + "DD";
        Console.WriteLine(a);
        Console.WriteLine(b);
        Console.WriteLine("arc-net-done");
    }
}
