// 接口数据协议与执行契约。
using System;
using System.NativeMemory;
namespace P;
class Program {
    static void Main() {
        nint p = NativeMemory.Alloc(32);
        NativeMemory.Fill(p, 1, 8);       // reads as refcount 1, positive
        string s = NativeMemory.GetString(p, 0, 8);
        Console.WriteLine("borrow=" + s.Length);
        NativeMemory.Free(p);

        // 接口数据协议与执行契约。
        string a = "AA" + "BB";
        string b = "CC" + "DD";
        Console.WriteLine(a);
        Console.WriteLine(b);
        Console.WriteLine("arc-net-done");
    }
}
