using System;
using System.Collections.Generic;
class NumEnum : IEnumerator<int> {
    int lo; int hi; int pos;
    public NumEnum(int lo, int hi) { this.lo = lo; this.hi = hi; pos = lo - 1; }
    public bool MoveNext() {
        if (pos + 1 >= hi) { return false; }
        pos = pos + 1;
        return true;
    }
    public int Current() { return pos; }
}
class Range : IEnumerable<int> {
    int lo; int hi;
    public Range(int lo, int hi) { this.lo = lo; this.hi = hi; }
    public IEnumerator<int> GetEnumerator() { return new NumEnum(lo, hi); }
}
class StrEnum : IEnumerator<string> {
    string[] items; int pos;
    public StrEnum(string[] src) { items = src; pos = -1; }
    public StrEnum() { items = new string[0]; pos = -1; }
    public bool MoveNext() {
        if (pos + 1 >= items.Length) { return false; }
        pos = pos + 1;
        return true;
    }
    public string Current() { return items[pos]; }
}
class Words : IEnumerable<string> {
    string[] items;
    public Words(string[] src) { items = src; }
    public IEnumerator<string> GetEnumerator() { return new StrEnum(items); }
}
class Z9 {
    static int Main() {
        // foreach 驱动接口形态枚举器：GetEnumerator 返回 IEnumerator<T>，
        // MoveNext/Current 经接口 tag 分发多态调用（A381 第一步）。
        Range r = new Range(1, 6);
        int s = 0;
        foreach (int x in r) { s = s + x; }
        Console.WriteLine("sum=" + s);
        int pulled = 0;
        foreach (int x in r) {
            pulled = pulled + 1;
            if (pulled == 3) { break; }
        }
        Console.WriteLine("pulled=" + pulled);
        Words w = new Words(new string[] { "a", "bb", "ccc" });
        int chars = 0;
        foreach (string t in w) { chars = chars + t.Length; }
        Console.WriteLine("chars=" + chars);
        return s == 15 && pulled == 3 && chars == 6 ? 0 : 1;
    }
}
