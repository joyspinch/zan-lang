using System;
using System.Collections.Generic;

/* A43-B22② 落地配套：stdlib IEnumerable<T>/IEnumerator<T> 接口对。
 * 实现类把 GetEnumerator 的具体枚举器经泛型接口引用转换上交
 * （IEnumerable<int> <- Range），GetEnumerator 的返回类型
 * IEnumerator<int> 在接口分发处按使用点实参替换（B22② 的 irgen
 * 签名替换），随后 MoveNext/Current 经第二层接口多态调用。 */
class RangeEnumerator : IEnumerator<int> {
    int i;
    int n;
    public RangeEnumerator(int n) { this.n = n; this.i = -1; }
    public bool MoveNext() { i = i + 1; return i < n; }
    public int Current() { return i * 10; }
}

class Range : IEnumerable<int> {
    int n;
    public Range(int n) { this.n = n; }
    public RangeEnumerator GetEnumerator() { return new RangeEnumerator(n); }
}

class Program {
    static int SumByHand(IEnumerable<int> seq) {
        IEnumerator<int> e = seq.GetEnumerator();
        int t = 0;
        while (e.MoveNext()) { t = t + e.Current(); }
        return t;
    }
    static void Main() {
        IEnumerable<int> seq = new Range(4);
        Console.WriteLine("sum " + Convert.ToString(SumByHand(seq)));
        Range r = new Range(3);
        Console.WriteLine("sum2 " + Convert.ToString(SumByHand(r)));
    }
}
