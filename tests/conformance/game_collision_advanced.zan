using System;
using Game.Arcade2D;

namespace Tests.GameCollisionAdvanced;

class Program {
    static void Main() {
        // 1. 射线检测 AABB 矩形
        Rect2 box = new Rect2(100.0, 50.0, 40.0, 40.0);
        // 从左侧 (0, 70) 向右发射水平射线 (dx=1, dy=0)
        RaycastHit2D hit1 = AdvancedCollision2D.RaycastRect(0.0, 70.0, 1.0, 0.0, 200.0, box);
        Console.WriteLine(
            "ray_box=" + Convert.ToString(hit1.Hit())
            + ",dist=" + Convert.ToString((int)hit1.Distance())
            + ",px=" + Convert.ToString((int)hit1.PointX())
            + ",nx=" + Convert.ToString((int)hit1.NormalX()));

        // 未击中射线测试 (朝上方)
        RaycastHit2D hitMiss = AdvancedCollision2D.RaycastRect(0.0, 70.0, 0.0, -1.0, 200.0, box);
        Console.WriteLine("ray_miss=" + Convert.ToString(hitMiss.Hit()));

        // 2. 射线检测圆形
        Circle2 circle = new Circle2(50.0, 50.0, 20.0);
        // 从 (0, 50) 水平向右击中圆左侧
        RaycastHit2D hitCircle = AdvancedCollision2D.RaycastCircle(0.0, 50.0, 1.0, 0.0, 100.0, circle);
        Console.WriteLine(
            "ray_circle=" + Convert.ToString(hitCircle.Hit())
            + ",dist=" + Convert.ToString((int)hitCircle.Distance())
            + ",px=" + Convert.ToString((int)hitCircle.PointX())
            + ",nx=" + Convert.ToString((int)hitCircle.NormalX()));

        // 3. 线段相交测试
        // 线段 A: (0, 0) -> (10, 10), 线段 B: (0, 10) -> (10, 0)，交点应为 (5, 5)
        Vector2 inter = AdvancedCollision2D.FindSegmentIntersection(0.0, 0.0, 10.0, 10.0, 0.0, 10.0, 10.0, 0.0);
        if (inter != null) {
            Console.WriteLine("segment_inter=" + Convert.ToString((int)inter.X()) + "," + Convert.ToString((int)inter.Y()));
        } else {
            Console.WriteLine("segment_inter=null");
        }

        // 平行线不相交
        Vector2 parallel = AdvancedCollision2D.FindSegmentIntersection(0.0, 0.0, 10.0, 0.0, 0.0, 5.0, 10.0, 5.0);
        Console.WriteLine("segment_parallel=" + Convert.ToString(parallel != null));

        // 4. 圆与线段/胶囊体判定
        // 线段在 Y=0, X 从 0 到 100
        Circle2 closeCircle = new Circle2(50.0, 10.0, 15.0); // 距离 10，半径 15，相碰
        Circle2 farCircle = new Circle2(50.0, 30.0, 15.0);   // 距离 30，半径 15，不碰
        Console.WriteLine("circle_segment_hit=" + Convert.ToString(AdvancedCollision2D.CircleVsSegment(closeCircle, 0.0, 0.0, 100.0, 0.0)));
        Console.WriteLine("circle_segment_far=" + Convert.ToString(AdvancedCollision2D.CircleVsSegment(farCircle, 0.0, 0.0, 100.0, 0.0)));

        // 5. 碰撞流形与推开法线（MTD / Penetration）
        // 矩形 A: (0, 0, 20, 20), 矩形 B: (15, 0, 20, 20) -> 重叠宽度 5，水平推开
        Rect2 rectA = new Rect2(0.0, 0.0, 20.0, 20.0);
        Rect2 rectB = new Rect2(15.0, 0.0, 20.0, 20.0);
        CollisionManifold manifold = AdvancedCollision2D.RectManifold(rectA, rectB);
        Console.WriteLine(
            "manifold=" + Convert.ToString(manifold.Collided())
            + ",depth=" + Convert.ToString((int)manifold.Depth())
            + ",nx=" + Convert.ToString((int)manifold.NormalX())
            + ",ny=" + Convert.ToString((int)manifold.NormalY()));
    }
}
