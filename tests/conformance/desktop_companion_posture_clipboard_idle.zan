using System;
using System.Collections.Generic;
using System.Windows;

class Program {
    static int Main() {
        // 1. 久坐坐姿保护守卫（过滤短暂低头 + 防骚扰冷却）
        CompanionPostureGuard guard = new CompanionPostureGuard(10.0f, 60.0f);
        bool brief1 = guard.StepFrame(6.0f, true);
        bool resetOk = !guard.StepFrame(1.0f, false) && guard.ContinuousSlouchSec == 0.0f;
        bool trigger1 = guard.StepFrame(10.0f, true); // 满 10s 触发
        bool suppressedCooldown = !guard.StepFrame(15.0f, true); // 冷却期内不重复打扰
        guard.StepFrame(50.0f, false); // 走完剩余冷却
        bool trigger2 = guard.StepFrame(10.0f, true);
        bool postureOk = !brief1 && resetOk && trigger1 && suppressedCooldown && trigger2 && guard.NudgeCount == 2;
        Console.WriteLine("posture_guard_ok=" + (postureOk ? "1" : "0"));

        // 2. 剪贴板历史保险库（去重置顶 + 置顶免疫淘汰 + 子串检索）
        CompanionClipboardHistoryVault vault = new CompanionClipboardHistoryVault(3);
        vault.PushSnippet("alpha_key");
        vault.SetPinned("alpha_key", true);
        vault.PushSnippet("beta_note");
        vault.PushSnippet("gamma_url");
        vault.PushSnippet("delta_log"); // 超出容量 3，淘汰最旧未置顶 beta_note，保留置顶 alpha_key
        vault.PushSnippet("gamma_url"); // 去重置顶
        List<string> hits = vault.Search("alpha");
        bool vaultOk = vault.Count() == 3
            && vault.EntryAt(0) == "gamma_url"
            && vault.EntryAt(1) == "delta_log"
            && vault.EntryAt(2) == "alpha_key"
            && hits.Count == 1 && hits[0] == "alpha_key";
        Console.WriteLine("clipboard_vault_ok=" + (vaultOk ? "1" : "0"));

        // 3. 多级空闲休眠降帧状态机与瞬醒
        CompanionIdleSleepMachine idle = new CompanionIdleSleepMachine(30.0f, 120.0f, 300.0f);
        int fpsAwake = idle.TargetFps();
        idle.AdvanceIdle(45.0f);
        int fpsDrowsy = idle.TargetFps();
        idle.AdvanceIdle(100.0f);
        int fpsSleep = idle.TargetFps();
        idle.AdvanceIdle(200.0f);
        int fpsHibernate = idle.TargetFps();
        idle.NotifyUserInput();
        bool idleOk = fpsAwake == 60 && fpsDrowsy == 30 && fpsSleep == 12 && fpsHibernate == 2
            && idle.Stage == IdleSleepStage.Awake && idle.TargetFps() == 60;
        Console.WriteLine("idle_sleep_ok=" + (idleOk ? "1" : "0"));
        return 0;
    }
}
