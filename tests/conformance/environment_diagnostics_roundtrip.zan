using System;
using System.IO;

namespace ConformanceTests;

class Program {
    static void Main() {
        TestStopwatch();
        TestEnvironment();
        TestRuntimeInformation();
        TestOperatingSystem();
        TestDirectoryBasics();
        Console.WriteLine("ALL ENVIRONMENT AND DIAGNOSTICS TESTS PASSED");
    }

    static void TestStopwatch() {
        Stopwatch sw = new Stopwatch();
        if (sw.IsRunning()) {
            Console.WriteLine("FAIL: stopwatch initially running");
        }

        sw.Start();
        if (!sw.IsRunning()) {
            Console.WriteLine("FAIL: stopwatch not running after Start");
        }

        long f = Stopwatch.Frequency();
        if (f <= 0) {
            Console.WriteLine("FAIL: frequency invalid");
        }

        long t1 = Stopwatch.NowTicks();
        long t2 = Stopwatch.GetTimestamp();
        if (t2 < t1) {
            Console.WriteLine("FAIL: timestamp monotonic");
        }

        long ms = Stopwatch.GetMilliseconds();
        long us = Stopwatch.GetMicroseconds();
        if (ms <= 0 || us <= 0) {
            Console.WriteLine("FAIL: mono scaled time");
        }

        sw.Stop();
        if (sw.IsRunning()) {
            Console.WriteLine("FAIL: stopwatch still running after Stop");
        }

        double elapsedMs = sw.ElapsedMilliseconds();
        double elapsedSec = sw.ElapsedSeconds();
        if (elapsedMs < 0.0 || elapsedSec < 0.0) {
            Console.WriteLine("FAIL: elapsed time negative");
        }

        sw.Restart();
        if (!sw.IsRunning()) {
            Console.WriteLine("FAIL: stopwatch not running after Restart");
        }
        sw.Reset();
        if (sw.IsRunning() || sw.ElapsedTicks() != 0) {
            Console.WriteLine("FAIL: stopwatch not reset");
        }

        Stopwatch swNew = Stopwatch.StartNew();
        if (!swNew.IsRunning()) {
            Console.WriteLine("FAIL: StartNew not running");
        }
        swNew.Stop();

        Console.WriteLine("OK: Stopwatch");
    }

    static void TestEnvironment() {
        int pid = Environment.ProcessId;
        if (pid <= 0) {
            Console.WriteLine("FAIL: Environment.ProcessId");
        }

        string exe = Environment.ProcessPath;
        if (exe == null || exe.Length == 0) {
            Console.WriteLine("FAIL: Environment.ProcessPath");
        }

        string nl = Environment.NewLine;
        if (nl != "\r\n" && nl != "\n") {
            Console.WriteLine("FAIL: Environment.NewLine");
        }

        string curDir = Environment.CurrentDirectory;
        if (curDir == null || curDir.Length == 0) {
            Console.WriteLine("FAIL: Environment.CurrentDirectory");
        }

        int cpus = Environment.ProcessorCount;
        if (cpus <= 0) {
            Console.WriteLine("FAIL: Environment.ProcessorCount");
        }

        bool is64 = Environment.Is64BitProcess;
        if (!is64) {
            // Most modern platforms tested are 64-bit
        }

        long ticks = Environment.TickCount64;
        if (ticks <= 0) {
            Console.WriteLine("FAIL: Environment.TickCount64");
        }

        Environment.SetEnvironmentVariable("ZAN_ENV_TEST_KEY", "ZanLangValue123");
        string readVal = Environment.GetEnvironmentVariable("ZAN_ENV_TEST_KEY");
        if (readVal != "ZanLangValue123") {
            Console.WriteLine("FAIL: Environment Get/SetEnvironmentVariable");
        }

        Console.WriteLine("OK: Environment");
    }

    static void TestRuntimeInformation() {
        string framework = RuntimeInformation.FrameworkDescription;
        if (framework != "Zan 0.2") {
            Console.WriteLine("FAIL: RuntimeInformation.FrameworkDescription");
        }

        string osDesc = RuntimeInformation.OSDescription;
        if (osDesc == null || osDesc.Length == 0) {
            Console.WriteLine("FAIL: RuntimeInformation.OSDescription");
        }

        string procArch = RuntimeInformation.ProcessArchitecture;
        if (procArch == null || procArch.Length == 0) {
            Console.WriteLine("FAIL: RuntimeInformation.ProcessArchitecture");
        }

        string osArch = RuntimeInformation.OSArchitecture;
        if (osArch != procArch) {
            Console.WriteLine("FAIL: RuntimeInformation.OSArchitecture");
        }

        string rid = RuntimeInformation.RuntimeIdentifier;
        if (rid == null || rid.Length == 0) {
            Console.WriteLine("FAIL: RuntimeInformation.RuntimeIdentifier");
        }

        if (!RuntimeInformation.IsOSPlatform(osDesc)) {
            Console.WriteLine("FAIL: RuntimeInformation.IsOSPlatform");
        }

        Console.WriteLine("OK: RuntimeInformation");
    }

    static void TestOperatingSystem() {
        string platform = OperatingSystem.Platform;
        if (platform == null || platform.Length == 0) {
            Console.WriteLine("FAIL: OperatingSystem.Platform");
        }

        bool match = OperatingSystem.IsWindows() || OperatingSystem.IsLinux() ||
                     OperatingSystem.IsMacOS() || OperatingSystem.IsIos() ||
                     OperatingSystem.IsAndroid() || OperatingSystem.IsOhos() ||
                     OperatingSystem.IsWasi();
        if (!match) {
            Console.WriteLine("FAIL: OperatingSystem predicate match");
        }

        Console.WriteLine("OK: OperatingSystem");
    }

    static void TestDirectoryBasics() {
        string cur = Directory.GetCurrentDirectory();
        if (cur == null || cur.Length == 0) {
            Console.WriteLine("FAIL: Directory.GetCurrentDirectory");
        }

        bool curExists = Directory.Exists(cur);
        if (!curExists) {
            Console.WriteLine("FAIL: Directory.Exists cur");
        }

        List<string> roots = Directory.GetRootsUtf8();
        if (roots == null || roots.Count == 0) {
            Console.WriteLine("FAIL: Directory.GetRootsUtf8");
        }

        Console.WriteLine("OK: DirectoryBasics");
    }
}
