using System;

class DeepNestingLimits {
    static void Main() {
        int x = 0;
        try {
            try {
                try {
                    try {
                        try {
                            try {
                                try {
                                    try {
                                        try {
                                            try {
                                                try {
                                                    try {
                                                        try {
                                                            try {
                                                                try {
                                                                    try {
                                                                        try {
                                                                            try {
                                                                                try {
                                                                                    try {
                                                                                        x = 42;
                                                                                    } finally { x++; }
                                                                                } finally { x++; }
                                                                            } finally { x++; }
                                                                        } finally { x++; }
                                                                    } finally { x++; }
                                                                } finally { x++; }
                                                            } finally { x++; }
                                                        } finally { x++; }
                                                    } finally { x++; }
                                                } finally { x++; }
                                            } finally { x++; }
                                        } finally { x++; }
                                    } finally { x++; }
                                } finally { x++; }
                            } finally { x++; }
                        } finally { x++; }
                    } finally { x++; }
                } finally { x++; }
            } finally { x++; }
        } finally { x++; }
        Console.WriteLine(x);
    }
}
