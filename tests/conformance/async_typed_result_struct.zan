using System;

// B-ID64：Task<聚合> 跨多级 await 链——RVAL 类型化返回值字段的回归钉。
// 结构体 >4 字（含 double），经两级中间帧传递，结果跨挂起点存活。

struct Big {
    long a;
    long b;
    long c;
    long d;
    double e;
    double f;
    int g;
    int h;
}

class Program {
    static async Task<Big> MakeBigAsync(long seed) {
        await Task.Delay(1);
        Big v;
        v.a = seed;
        v.b = seed * 2;
        v.c = seed * 3;
        v.d = seed * 4;
        v.e = 1.5;
        v.f = 2.5;
        v.g = 7;
        v.h = 8;
        return v;
    }

    static async Task<Big> MidAsync(long seed) {
        Big first = await Program.MakeBigAsync(seed);
        await Task.Delay(1);
        Big second = await Program.MakeBigAsync(first.a + 1);
        Big third = await Program.MakeBigAsync(second.b + 1);
        return third;
    }

    static async Task<Big> TopAsync(long seed) {
        Big m = await Program.MidAsync(seed);
        await Task.Delay(1);
        Big n = await Program.MakeBigAsync(m.c);
        return n;
    }

    static async void Main() {
        Big r = await Program.TopAsync(10);
        Console.WriteLine("r=" + Convert.ToString(r.a) + "," + Convert.ToString(r.b)
            + "," + Convert.ToString(r.c) + "," + Convert.ToString(r.d));
        Console.WriteLine("rf=" + Convert.ToString(r.e) + "/" + Convert.ToString(r.f));
        Console.WriteLine("ri=" + Convert.ToString(r.g) + "," + Convert.ToString(r.h));
    }
}
