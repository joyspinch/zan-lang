using System;

class CleanupOriginal : Exception {
    public CleanupOriginal() : base("original") { }
}

class CleanupReplacement : Exception {
    public CleanupReplacement() : base("replacement") { }
}

class Program {
    static void Fail() { throw new CleanupReplacement(); }

    static int SuppressTry() {
        try { throw new CleanupOriginal(); }
        finally { return 7; }
    }

    static int SuppressCatch() {
        try { throw new CleanupOriginal(); }
        catch (CleanupOriginal) { Fail(); }
        finally { return 8; }
    }

    static void Main() {
        // A callee escaping catch must run its sibling finally, not a sibling catch.
        try {
            try { throw new CleanupOriginal(); }
            catch (CleanupOriginal) { Fail(); }
            catch (CleanupReplacement) { Console.WriteLine("wrong sibling catch"); }
            finally { Console.WriteLine("callee finally"); }
        } catch (CleanupReplacement e) { Console.WriteLine(e.Message); }

        // An explicit replacement follows the same cleanup-only entry.
        try {
            try { throw new CleanupOriginal(); }
            catch (CleanupOriginal) { throw new CleanupReplacement(); }
            catch (CleanupReplacement) { Console.WriteLine("wrong sibling catch"); }
            finally { Console.WriteLine("replacement finally"); }
        } catch (CleanupReplacement e) { Console.WriteLine(e.Message); }

        // Rethrow across a finally that handles another exception runs it once.
        try {
            try {
                try { throw new CleanupOriginal(); }
                catch (CleanupOriginal) { throw; }
            } finally {
                try { Fail(); } catch (CleanupReplacement) { }
                Console.WriteLine("rethrow finally");
            }
        } catch (CleanupOriginal e) { Console.WriteLine(e.Message); }

        // Unmatched catches must not skip intervening finally-only regions.
        try {
            try {
                try { Fail(); }
                catch (CleanupOriginal) { Console.WriteLine("wrong original"); }
                finally { Console.WriteLine("unmatched inner"); }
            } finally { Console.WriteLine("unmatched outer"); }
        } catch (CleanupReplacement e) { Console.WriteLine(e.Message); }

        // A new exception from catch's finally replaces the pending exception.
        try {
            try { throw new CleanupOriginal(); }
            catch (CleanupOriginal) { Fail(); }
            finally { throw new CleanupOriginal(); }
        } catch (CleanupOriginal e) { Console.WriteLine("finally " + e.Message); }

        // Catch without a sibling finally still unwinds to the enclosing try.
        try {
            try { throw new CleanupOriginal(); }
            catch (CleanupOriginal) { Fail(); }
        } catch (CleanupReplacement e) { Console.WriteLine("plain " + e.Message); }

        // A finally can suppress an exception without any enclosing catch.
        Console.WriteLine(SuppressTry());
        Console.WriteLine(SuppressCatch());
    }
}
