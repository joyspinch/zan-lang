// B-ID78: ARC 深层对象树级联析构栈溢出防护（迭代式延迟释放队列）
// 5000 层深链表级联释放不耗尽线程栈，延迟释放队列迭代排空，零泄漏。
using System;

class DeepNode {
    public DeepNode next;
    public int val;
    public DeepNode(DeepNode n, int v) {
        this.next = n;
        this.val = v;
    }
}

public static class Program {
    public static int Main() {
        DeepNode head = null;
        int i = 0;
        while (i < 5000) {
            head = new DeepNode(head, i);
            i = i + 1;
        }
        head = null;
        Console.WriteLine("survived");
        return 0;
    }
}
