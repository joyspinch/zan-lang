using System;
using System.Numerics;
using Gui;
using Game.Render3D;
using Game.Assets;

public class Program {
    private static void Check(string label, bool condition) {
        if (condition) {
            Console.WriteLine("[PASS] " + label);
        } else {
            Console.WriteLine("[FAIL] " + label);
        }
    }

    private static void TestPrimitives() {
        // 1. 测试立方体
        Mesh3D cube = Primitives3D.CreateCube(2.0f, 2.0f, 2.0f);
        // 6 个面 * 4 顶点 = 24 顶点；6 个面 * 2 三角形 * 3 索引 = 36 索引
        Check("Prim_CubeVertices", cube.VertexCount() == 24);
        Check("Prim_CubeIndices", cube.IndexCount() == 36);

        // 2. 测试网格平面 (2x2 分段)
        Mesh3D plane = Primitives3D.CreatePlane(10.0f, 10.0f, 2, 2);
        // 3x3 顶点 = 9 顶点；4 个格子 * 2 三角形 * 3 = 24 索引
        Check("Prim_PlaneVertices", plane.VertexCount() == 9);
        Check("Prim_PlaneIndices", plane.IndexCount() == 24);

        // 3. 测试球体
        Mesh3D sphere = Primitives3D.CreateSphere(1.0f, 8, 8);
        Check("Prim_SphereValid", sphere.VertexCount() > 0 && sphere.IndexCount() > 0);
    }

    private static void TestObjLoader() {
        // 模拟一个简单金字塔或四棱锥 OBJ
        string fakeObj = "# Test OBJ\n" +
                         "v 0.0 1.0 0.0\n" +
                         "v -1.0 0.0 1.0\n" +
                         "v 1.0 0.0 1.0\n" +
                         "v 1.0 0.0 -1.0\n" +
                         "v -1.0 0.0 -1.0\n" +
                         "vn 0.0 1.0 0.0\n" +
                         "vt 0.5 0.5\n" +
                         "f 1/1/1 2/1/1 3/1/1\n" +
                         "f 2/1/1 3/1/1 4/1/1 5/1/1\n"; // 四边形底面

        Mesh3D parsed = ObjLoader.LoadFromText(fakeObj);
        // 三角形面 1 个 (3 顶点) + 四边形切成 2 个三角形 (4 顶点剖分为 2 个三角形，生成 2*3=6 索引)
        // 共 3 + 6 = 9 个索引
        Check("Obj_ParsedIndices", parsed.IndexCount() == 9);
    }

    private static void TestCameraControllers() {
        FpsController3D fps = new FpsController3D();
        fps.Position = new Vector3(0.0f, 2.0f, 10.0f);

        // 模拟鼠标上滑超过 90 度，验证最大俯仰角锁定在 ±1.5533 弧度以内
        fps.OnMouseMove(0.0f, -1000.0f);
        Check("Camera_PitchClamped", fps.Pitch <= 1.5534f && fps.Pitch > 1.5f);

        // 步进移动
        fps.UpdateInput(true, false, false, false, false, false, 0.1f);
        // 向前移动，Z 轴应变小（走向负 Z）
        Check("Camera_WalkForward", fps.Position.Z < 10.0f);

        Camera3D cam = new Camera3D();
        fps.SyncToCamera(cam);
        Check("Camera_Sync", cam.Position.Z == fps.Position.Z);
    }

    private static void TestRaycast() {
        // 从 (0, 0, 10) 发射一条指向负 Z 方向的射线
        Ray3D ray = new Ray3D(new Vector3(0.0f, 0.0f, 10.0f), new Vector3(0.0f, 0.0f, -1.0f));

        // 1. 与位于 (0, 0, 0) 半径为 2.0 的球体相交
        float sphereHit = 0.0f;
        bool hitSphere = Raycast3D.IntersectSphere(ray, Vector3.Zero, 2.0f, out sphereHit);
        // 距离应为 10.0 - 2.0 = 8.0
        Check("Ray_SphereHit", hitSphere && Math.Abs(sphereHit - 8.0f) < 0.01f);

        // 2. 与位于原点附近的 AABB (-1, -1, -1) ~ (1, 1, 1) 相交
        float aabbHit = 0.0f;
        bool hitAabb = Raycast3D.IntersectAabb(ray, new Vector3(-1.0f, -1.0f, -1.0f), new Vector3(1.0f, 1.0f, 1.0f), out aabbHit);
        // 距离应为 10.0 - 1.0 = 9.0
        Check("Ray_AabbHit", hitAabb && Math.Abs(aabbHit - 9.0f) < 0.01f);

        // 3. 与 Y=0 平面相交（射线起点 Y=0 时不垂直，改变射线带仰俯角度测试平面）
        Ray3D downRay = new Ray3D(new Vector3(0.0f, 10.0f, 0.0f), new Vector3(0.0f, -1.0f, 0.0f));
        float planeHit = 0.0f;
        bool hitPlane = Raycast3D.IntersectPlane(downRay, Vector3.Zero, new Vector3(0.0f, 1.0f, 0.0f), out planeHit);
        // 从高度 10 直射向 Y=0 平面，hitDist 应等于 10.0
        Check("Ray_PlaneHit", hitPlane && Math.Abs(planeHit - 10.0f) < 0.01f);
    }

    public static void Main() {
        TestPrimitives();
        TestObjLoader();
        TestCameraControllers();
        TestRaycast();
        Console.WriteLine("ALL 3D CORE SYSTEMS PASSED.");
    }
}
