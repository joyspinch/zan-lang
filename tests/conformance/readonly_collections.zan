using System;
using System.Collections.Generic;
using System.Collections.ObjectModel;

namespace Conf;

class Program {
    static void Main() {
        // 1. List.AsReadOnly 与 ReadOnlyCollection / IReadOnlyList / IReadOnlyCollection 契约
        List<int> numbers = new List<int>();
        numbers.Add(10);
        numbers.Add(20);
        numbers.Add(30);

        ReadOnlyCollection<int> roWrap = numbers.AsReadOnly();
        IReadOnlyList<int> roList = roWrap;
        IReadOnlyCollection<int> roColl = roList;

        Console.WriteLine("roList.Count=" + Convert.ToString(roList.Count()));
        Console.WriteLine("roList[1]=" + Convert.ToString(roList.Get(1)));
        Console.WriteLine("roWrap.Contains(20)=" + Convert.ToString(roWrap.Contains(20)));
        Console.WriteLine("roWrap.IndexOf(30)=" + Convert.ToString(roWrap.IndexOf(30)));

        // 2. foreach 经只读接口多态迭代
        int sum = 0;
        foreach (int x in roList) {
            sum = sum + x;
        }
        Console.WriteLine("roList.sum=" + Convert.ToString(sum));

        int collSum = 0;
        foreach (int x in roColl) {
            collSum = collSum + x;
        }
        Console.WriteLine("roColl.sum=" + Convert.ToString(collSum));

        // 3. 动态反映底层可变集合变动（只读视图特性）
        numbers.Add(40);
        Console.WriteLine("afterAdd.Count=" + Convert.ToString(roList.Count()));
        Console.WriteLine("afterAdd[3]=" + Convert.ToString(roList.Get(3)));

        // 4. Dictionary.AsReadOnly 与 ReadOnlyDictionary / IReadOnlyDictionary 契约
        Dictionary<string, int> dict = new Dictionary<string, int>();
        dict.Add("apple", 5);
        dict.Add("banana", 8);

        ReadOnlyDictionary<string, int> roDictWrap = dict.AsReadOnly();
        IReadOnlyDictionary<string, int> roDict = roDictWrap;

        Console.WriteLine("roDict.Count=" + Convert.ToString(roDict.Count()));
        Console.WriteLine("roDict.ContainsKey(apple)=" + Convert.ToString(roDict.ContainsKey("apple")));
        Console.WriteLine("roDict.ContainsKey(orange)=" + Convert.ToString(roDict.ContainsKey("orange")));
        Console.WriteLine("roDict.Get(banana)=" + Convert.ToString(roDict.Get("banana")));

        int val = 0;
        bool hasVal = roDict.TryGetValue("banana", out val);
        Console.WriteLine("roDict.TryGetValue=" + Convert.ToString(hasVal) + "," + Convert.ToString(val));

        // 5. ReadOnlySpan 切片视图
        int[] arr = new int[4];
        arr[0] = 100;
        arr[1] = 200;
        arr[2] = 300;
        arr[3] = 400;

        ReadOnlySpan<int> sp = arr.AsReadOnlySpan();
        Console.WriteLine("sp.Length=" + Convert.ToString(sp.Length));
        Console.WriteLine("sp[0]=" + Convert.ToString(sp[0]));

        ReadOnlySpan<int> mid = sp.Slice(1, 2);
        Console.WriteLine("mid.Length=" + Convert.ToString(mid.Length));
        Console.WriteLine("mid[0]=" + Convert.ToString(mid[0]));
        Console.WriteLine("mid[1]=" + Convert.ToString(mid[1]));

        ReadOnlySpan<int> arrSpan = arr.AsReadOnlySpan(2, 2);
        Console.WriteLine("arrSpan.Length=" + Convert.ToString(arrSpan.Length));
        Console.WriteLine("arrSpan[0]=" + Convert.ToString(arrSpan[0]));
        Console.WriteLine("arrSpan[1]=" + Convert.ToString(arrSpan[1]));

        string s = "HelloZan";
        ReadOnlySpan<char> sSpan = s.AsReadOnlySpan(5, 3);
        Console.WriteLine("sSpan.Length=" + Convert.ToString(sSpan.Length));
        Console.WriteLine("sSpan[0]=" + Convert.ToString(sSpan[0]));

        Console.WriteLine("readonly-collections-ok");
    }
}
