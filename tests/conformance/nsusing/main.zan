using System;
using Alpha;

// Alpha 与 Beta 各有一个同名类 Badge。这个文件只导入 Alpha，
// 裸名 Badge 必须解析到 Alpha.Badge（Beta.Badge 只有靠"别的文件的
// using 漏进来"才会被选中——那正是 A438 修掉的洞）。
class Program {
    static int Main() {
        Console.WriteLine("level=" + Badge.Level().ToString());
        Console.WriteLine("OK");
        return 0;
    }
}
