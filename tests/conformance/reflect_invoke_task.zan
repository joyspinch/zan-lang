using System;
using System.Threading;

// M1：async 方法的反射调用——thunk 必须补齐 spawn 义务（track/ready），
// 否则帧永远不会被调度，任务静默不执行。
class Job {
    public int Done;

    public async long Run(int v) {
        Done = v * 2;
        return v;
    }

    public async void Touch() {
        Done = Done + 100;
    }
}

class Program {
    static void Check(bool condition, string message) {
        if (!condition) { throw new Exception(message); }
    }

    static async int Probe(Job job) {
        long h = job.InvokeTask("Run", 21);
        Check(h != 0, "InvokeTask returned a task token");

        long h2 = job.InvokeTask("Touch");
        Check(h2 != 0, "InvokeTask handled async void");

        int spins = 0;
        while ((Task.IsDone(h) == 0 || Task.IsDone(h2) == 0) && spins < 5000) {
            await Task.Delay(1);
            spins = spins + 1;
        }
        Check(Task.IsDone(h) != 0, "reflected task completed");
        Check(Task.IsDone(h2) != 0, "reflected async void completed");
        return job.Done;
    }

    static void Main() {
        Job job = new Job();
        int done = await Probe(job);
        Console.WriteLine(done);
        Console.WriteLine("reflect invoke task passed");
    }
}
