using System;

class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            failures = failures + 1;
        }
    }

    static int Main() {
        string h = "AB\0CD";

        // exact length semantics: the managed string keeps every byte
        Check(h.Length == 5, "length is exact");
        Check(h[3] == (byte)'C', "index is exact");
        Check((h + "X").Length == 6, "concat is exact");
        Check(h.Substring(2, 2).Length == 2, "substring with a count is exact");
        Check(h.Substring(2).Length == 3, "substring without a count is exact");
        Check(h == "AB\0CD", "equality is exact");
        Check(h != "AB", "equality sees the embedded NUL");

        // the search and transform methods stop at the first NUL, like the
        // C host does
        Check(h.Trim().Length == 2, "trim stops at the first NUL");
        Check(h.ToUpper().Length == 2, "ToUpper stops at the first NUL");
        Check(h.ToLower().Length == 2, "ToLower stops at the first NUL");
        Check(h.Replace("A", "Z").Length == 2, "replace stops at the first NUL");
        Check(h.Split("C").Count == 1, "split stops at the first NUL");
        Check(h.ToString().Length == 2, "ToString stops at the first NUL");
        Check(h.Contains("AB"), "Contains sees the truncated receiver");
        Check(h.IndexOf("AB") == 0, "IndexOf sees the truncated receiver");
        Check(h.IndexOf("CD") == -1, "IndexOf does not see past the NUL");
        Check(h.LastIndexOf("C") == -1, "LastIndexOf does not see past the NUL");
        Check(h.LastIndexOf("") == 2, "LastIndexOf of the empty pattern is the C length");
        Check(h.StartsWith("AB"), "StartsWith sees the truncated receiver");
        Check(!h.EndsWith("CD"), "EndsWith does not see past the NUL");

        // a string without an embedded NUL is unaffected
        Check("  hi  ".Trim().Length == 2, "trim on a plain string");
        Check("abc".ToUpper() == "ABC", "ToUpper on a plain string");
        Check("a,b,c".Split(",").Count == 3, "split on a plain string");
        Check("abcabc".LastIndexOf("b") == 4, "LastIndexOf on a plain string");
        Check("abc".EndsWith("bc"), "EndsWith on a plain string");
        Check("abc".Replace("b", "X") == "aXc", "replace on a plain string");

        Console.WriteLine(failures == 0 ? "ok" : "failures=" + Convert.ToString(failures));
        return failures == 0 ? 0 : 1;
    }
}
