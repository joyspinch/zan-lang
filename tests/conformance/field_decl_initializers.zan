using System;
using System.Collections.Generic;

class InitTrace {
    static int next = 0;

    static int Tick(int n) {
        next = next + 1;
        Console.WriteLine("tick=" + Convert.ToString(n));
        return n;
    }

    static int Count() { return next; }
}

class InitBase {
    public int a = InitTrace.Tick(1);
}

class InitChain : InitBase {
    public int b = InitTrace.Tick(2);
    public string text = "seed";

    public InitChain() : this(9) {
        Console.WriteLine("outer");
    }

    public InitChain(int n) {
        b = b + n;
        Console.WriteLine("inner");
    }
}

class PlainDefaults {
    public int n = InitTrace.Tick(3);
    public string text = "plain";
}

struct PairDefaults {
    public int x = InitTrace.Tick(4);
    public int y = 5;
}

class GenericDefaults<T> {
    public T item;
    public List<T> values = new List<T>();
    public string label = "box";

    public GenericDefaults(T initial) {
        item = initial;
        values.Add(initial);
    }
}

class Program {
    static nint Native() { return (nint)6; }
    static int casted = (int)Native();

    static GenericDefaults<int> MakeGeneric() {
        return new GenericDefaults<int>(7);
    }

    static void Main() {
        InitChain chain = new InitChain();
        PlainDefaults plain = new PlainDefaults();
        PairDefaults pair = new PairDefaults();
        GenericDefaults<int> generic = MakeGeneric();

        Console.WriteLine(Convert.ToString(chain.a) + "," +
            Convert.ToString(chain.b) + "," + chain.text);
        Console.WriteLine(Convert.ToString(plain.n) + "," + plain.text);
        Console.WriteLine(Convert.ToString(pair.x) + "," + Convert.ToString(pair.y));
        Console.WriteLine(Convert.ToString(generic.item) + "," +
            Convert.ToString(generic.values[0]) + "," + generic.label);
        Console.WriteLine("count=" + Convert.ToString(InitTrace.Count()) +
            ",cast=" + Convert.ToString(casted));
    }
}
