using System;
using System.Threading;

class Program {
    static int callbackFired = 0;

    static void OnCancel() {
        Program.callbackFired = Program.callbackFired + 1;
    }

    static async int Run() {
        // 1. 验证 CancellationTokenSource 实现 IDisposable
        CancellationTokenSource cts = new CancellationTokenSource();
        CancellationToken token = cts.Token;
        Console.WriteLine("is_canceled_init=" + (token.IsCancellationRequested ? "true" : "false"));

        // 2. 注册回调并验证 Registration 实现 IDisposable
        CancellationTokenRegistration reg = token.Register(Program.OnCancel);
        IDisposable dispReg = reg;
        Console.WriteLine("reg_is_disposable=true");

        // 3. 触发取消
        cts.Cancel();
        Console.WriteLine("is_canceled_after=" + (token.IsCancellationRequested ? "true" : "false"));
        Console.WriteLine("callback_count=" + Convert.ToString(Program.callbackFired));

        // 4. 多态 Dispose
        IDisposable dispCts = cts;
        dispCts.Dispose();
        Console.WriteLine("cts_disposed");

        IDisposable dispToken = token;
        dispToken.Dispose();
        Console.WriteLine("token_disposed");

        dispReg.Dispose();
        Console.WriteLine("reg_disposed");

        Console.WriteLine("ok");
        return 0;
    }

    static async void Main() {
        await Program.Run();
    }
}
