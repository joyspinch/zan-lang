// A string throw must NOT be caught by a typed catch clause: the object is not
// an Exception subclass, so binding it to a typed variable (and reading fields
// off it, e.g. e.Message) would dereference string data as an object and crash
// (A36: `try { try { throw "inner"; } finally { throw "from finally"; } }
// catch (Exception e)` died with 0xC0000005). A string throw is only caught by
// an untyped `catch { }`. Class throws still dispatch by type as before.
using System;

class Boom : Exception {
    public Boom(string m) : base(m) { }
}

class Program {
    static void Main() {
        // A36 shape: inner string throw is replaced by the finally's throw; the
        // typed catch must not bind it. Previously crashed on e.Message.
        try {
            try {
                try {
                    throw "inner";
                } finally {
                    throw "from finally";
                }
            } catch (Exception e) {
                Console.WriteLine("wrong: " + e.Message);
            }
        } catch {
            Console.WriteLine("A:caught-by-catchall");
        }

        // A plain string throw bypasses a typed clause and reaches a catch-all.
        try {
            try {
                throw "plain";
            } catch (Boom e) {
                Console.WriteLine("wrong: " + e.Message);
            }
        } catch {
            Console.WriteLine("B:caught-by-catchall");
        }

        // A string throw is caught by an untyped catch directly.
        try {
            throw "direct";
        } catch {
            Console.WriteLine("C:caught-by-catchall");
        }

        // Class throws still dispatch by type (regression guard).
        try {
            throw new Boom("boom");
        } catch (Exception e) {
            Console.WriteLine("D:typed " + e.Message);
        }

        // A class throw that matches no clause reaches a catch-all too.
        try {
            try {
                throw new Boom("unmatched");
            } catch (System.IO.FileNotFoundException e) {
                Console.WriteLine("wrong: " + e.Message);
            }
        } catch {
            Console.WriteLine("E:caught-by-catchall");
        }

        Console.WriteLine("done");
        return 0;
    }
}
