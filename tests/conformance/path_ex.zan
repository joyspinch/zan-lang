// PathEx test: glob matching (* ? **), Clean (./.. resolution), relative
// path computation, IsUnder prefix checks.
using System;
using System.IO;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        // Glob: single segment star.
        if (!PathEx.IsMatch("*.zan", "a.zan")) { bad = bad + 1; }
        if (PathEx.IsMatch("*.zan", "a.txt")) { bad = bad + 1; }
        if (PathEx.IsMatch("*.zan", "a/b.zan")) { bad = bad + 1; }   // * does not cross /
        // Question mark.
        if (!PathEx.IsMatch("file?.txt", "file1.txt")) { bad = bad + 1; }
        if (PathEx.IsMatch("file?.txt", "file12.txt")) { bad = bad + 1; }
        // ** crosses segments.
        if (!PathEx.IsMatch("src/**/*.zan", "src/a/b/c.zan")) { bad = bad + 1; }
        if (!PathEx.IsMatch("src/**/*.zan", "src/c.zan")) { bad = bad + 1; }   // ** can be empty
        if (PathEx.IsMatch("src/**/*.zan", "src/a/b/c.txt")) { bad = bad + 1; }
        if (!PathEx.IsMatch("**", "a/b/c")) { bad = bad + 1; }
        // Backslash patterns work too.
        if (!PathEx.IsMatch("src\\**\\*.zan", "src\\a\\b.zan")) { bad = bad + 1; }
        // Clean.
        string c1 = PathEx.Clean("a/./b/../c");
        if (c1 != "a/c") { bad = bad + 1; }
        string c2 = PathEx.Clean("a/b/../../c");
        if (c2 != "c") { bad = bad + 1; }
        string c3 = PathEx.Clean("../a/../b");
        if (c3 != "../b") { bad = bad + 1; }
        // Relative path.
        string r1 = PathEx.GetRelativePath("a/b", "a/b/c/d.txt");
        if (r1 != "c/d.txt") { bad = bad + 1; }
        string r2 = PathEx.GetRelativePath("a/b", "a/x/y.txt");
        if (r2 != "../x/y.txt") { bad = bad + 1; }
        string r3 = PathEx.GetRelativePath("a", "a");
        if (r3 != ".") { bad = bad + 1; }
        // IsUnder.
        if (!PathEx.IsUnder("a/b", "a/b/c")) { bad = bad + 1; }
        if (!PathEx.IsUnder("a/b", "a/b")) { bad = bad + 1; }
        if (PathEx.IsUnder("a/b", "a/bc")) { bad = bad + 1; }
        Console.WriteLine("pathex-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
