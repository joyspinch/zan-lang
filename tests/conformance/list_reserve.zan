using System;
using System.Collections.Generic;

// List<T>.Reserve makes room up front; it must never lose the elements the
// list already holds, and it must be a no-op when the capacity is enough.
class Program {
    static void Main() {
        List<int> xs = new List<int>();
        xs.Add(1);
        xs.Add(2);
        xs.Reserve(100);
        xs.Add(3);
        Console.WriteLine("count=" + Convert.ToString(xs.Count));
        Console.WriteLine("v=" + Convert.ToString(xs[0]) + "," + Convert.ToString(xs[1]) + "," + Convert.ToString(xs[2]));

        List<string> ss = new List<string>();
        ss.Reserve(4);
        ss.Add("a");
        ss.Add("b");
        Console.WriteLine("s=" + Convert.ToString(ss.Count) + ":" + Convert.ToString(ss[0]) + Convert.ToString(ss[1]));

        // reserve below the current need must keep every element
        List<int> ys = new List<int>();
        ys.Add(7);
        ys.Reserve(1);
        ys.Add(8);
        Console.WriteLine("y=" + Convert.ToString(ys.Count) + ":" + Convert.ToString(ys[0]) + "," + Convert.ToString(ys[1]));

        // reserve on an empty list
        List<int> zs = new List<int>();
        zs.Reserve(16);
        zs.Add(5);
        Console.WriteLine("z=" + Convert.ToString(zs.Count) + ":" + Convert.ToString(zs[0]));
    }
}
