// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。
using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Text;
using Sdk.Jd;
using Sdk.Jd.Api.Ware;
using Sdk.Jd.Api.Area;

class Program {
    static int PORT = 9514;
    static string SECRET = "gen-secret";
    static string lastParamJson = "";
    static string lastMethod = "";

    static List<string> formKeys;
    static List<string> formVals;

    static void ParseForm(string body) {
        formKeys = new List<string>();
        formVals = new List<string>();
        List<string> pairs = body.Split("&");
        for (int i = 0; i < pairs.Count; i = i + 1) {
            string p = pairs[i];
            int eq = p.IndexOf("=");
            if (eq > 0) {
                formKeys.Add(Encoding.UrlDecode(p.Substring(0, eq)));
                formVals.Add(Encoding.UrlDecode(p.Substring(eq + 1)));
            }
        }
    }

    static string FormGet(string key) {
        for (int i = 0; i < formKeys.Count; i = i + 1) {
            if (formKeys[i] == key) { return formVals[i]; }
        }
        return "";
    }

    static async HttpResponse Handle(HttpRequest req) {
        ParseForm(req.body);
        lastMethod = FormGet("method");
        lastParamJson = FormGet("360buy_param_json");

        if (lastMethod == "jingdong.area.province.get") {
            return HttpResponse.Json("{\"jingdong_area_province_get_responce\":{\"province_areas\":[{\"id\":1,\"name\":\"Beijing\",\"cod\":true},{\"id\":2,\"name\":\"Shanghai\",\"cod\":false}],\"success\":true}}");
        }
        return HttpResponse.Json("{\"jingdong_ware_read_searchWare4Valid_responce\":{\"page\":{\"data\":[\"w1\",\"w2\"],\"pageNo\":2,\"pageSize\":50,\"totalItem\":4294967296}}}");
    }

    static async int Run() {
        Socket.Initialize();
        HttpServer server = new HttpServer("127.0.0.1", PORT);
        server.OnRequest(Handle);
        Task.Spawn(server.Start());
        await Task.Delay(50);

        JdClient client = new JdClient("gen-key", SECRET);
        client.Server("127.0.0.1", PORT, "/routerjson", false);

        // 核心契约与语义定义。
        // 核心契约与语义定义。
        WareReadSearchWare4ValidRequest ware = new WareReadSearchWare4ValidRequest();
        ware.SearchKey("pen").PageNo(2).PageSize(50).CategoryId(4294967296);

        JdWareApi wareApi = new JdWareApi(client);
        WareReadSearchWare4ValidResponse w =
            await wareApi.ReadSearchWare4ValidAsync(ware);
        Console.WriteLine("method=" + lastMethod);
        Console.WriteLine("params=" + lastParamJson);

        Console.WriteLine("pageNo=" + Convert.ToString(w.page.pageNo));
        Console.WriteLine("pageSize=" + Convert.ToString(w.page.pageSize));
        Console.WriteLine("totalItem=" + Convert.ToString(w.page.totalItem));
        Console.WriteLine("data=" + Convert.ToString(w.page.data.Count) + ":" + w.page.data[0]);

        // 核心契约与语义定义。
        AreaProvinceGetRequest area = new AreaProvinceGetRequest();
        JdAreaApi areaApi = new JdAreaApi(client);
        AreaProvinceGetResponse a = await areaApi.ProvinceGetAsync(area);
        Console.WriteLine("areaMethod=" + lastMethod);
        Console.WriteLine("areaParams=" + lastParamJson);

        Console.WriteLine("provinces=" + Convert.ToString(a.province_areas.Count));
        Console.WriteLine("first=" + a.province_areas[0].name
            + " id=" + Convert.ToString(a.province_areas[0].id)
            + " cod=" + Convert.ToString(a.province_areas[0].cod));
        Console.WriteLine("success=" + Convert.ToString(a.success));

        server.Stop();
        return 0;
    }

    static async void Main() {
        int _rc = await Run();
    }
}
