using System;

class ServiceWindow {
    public int loaded = 0;
    public int inited = 0;
    public int customHook = 0;

    public void OnLoad() {
        this.loaded = this.loaded + 1;
    }

    public int OnInit(int step) {
        this.inited = this.inited + step;
        return this.inited;
    }

    public void OnCustomEvent() {
        this.customHook = this.customHook + 10;
    }
}

class Program {
    static int Main() {
        ServiceWindow win = new ServiceWindow();
        Console.WriteLine("has_onload=" + win.HasMethod("OnLoad"));
        Console.WriteLine("has_oninit=" + win.HasMethod("OnInit"));
        Console.WriteLine("has_oncustom=" + win.HasMethod("OnCustomEvent"));

        win.Invoke("OnLoad");
        Console.WriteLine("loaded=" + win.loaded);

        int initRet = win.InvokeInt("OnInit", 42);
        Console.WriteLine("inited=" + win.inited + ",ret=" + initRet);

        win.Invoke("OnCustomEvent");
        Console.WriteLine("custom=" + win.customHook);

        Console.WriteLine("OK");
        return 0;
    }
}
