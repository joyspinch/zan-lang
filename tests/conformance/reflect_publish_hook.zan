using System;

class ServiceWindow {
    public int loaded = 0;
    public int inited = 0;
    public int customHook = 0;

    public void OnLoad() {
        this.loaded = this.loaded + 1;
    }

    public int OnInit(int step) {
        this.inited = this.inited + step;
        return this.inited;
    }

    public void OnCustomEvent() {
        this.customHook = this.customHook + 10;
    }
}

// Only the derived owner is instantiated or reflected: the nonvirtual base
// hook must survive even when its name is outside the scanner hook list.
class InheritedHookBase {
    public int inheritedCustomHook = 0;

    public void OnCustomEvent() {
        this.inheritedCustomHook = this.inheritedCustomHook + 17;
    }
}

class InheritedHookWindow : InheritedHookBase {
}

class Program {
    static int Main() {
        ServiceWindow win = new ServiceWindow();
        Console.WriteLine("has_onload=" + win.HasMethod("OnLoad"));
        Console.WriteLine("has_oninit=" + win.HasMethod("OnInit"));
        Console.WriteLine("has_oncustom=" + win.HasMethod("OnCustomEvent"));

        win.Invoke("OnLoad");
        Console.WriteLine("loaded=" + win.loaded);

        int initRet = win.InvokeInt("OnInit", 42);
        Console.WriteLine("inited=" + win.inited + ",ret=" + initRet);

        win.Invoke("OnCustomEvent");
        Console.WriteLine("custom=" + win.customHook);

        TypeInfo inheritedType = typeof(InheritedHookWindow);
        Console.WriteLine("derived_has_oncustom=" + inheritedType.HasMethod("OnCustomEvent"));
        InheritedHookWindow inherited = new InheritedHookWindow();
        inherited.Invoke("OnCustomEvent");
        Console.WriteLine("inherited_custom=" + inherited.inheritedCustomHook);

        Console.WriteLine("OK");
        return 0;
    }
}
