using System;
using System.Numerics;

// 回归钉子：三元条件表达式混用 `new Struct(...)`（栈槽指针）与结构体函数返回值/局部变量/default（按值结构体）时，
// 两臂必须在汇入 merge 块 PHI 前统一收敛为按值结构体，不得触发 E3090 PHI 操作数类型不匹配。
public struct Pair2 {
    public int A;
    public int B;

    public Pair2(int a, int b) {
        this.A = a;
        this.B = b;
    }
}

public class TernaryStructCtorCallTest {
    private static Pair2 MakePair(int a, int b) {
        return new Pair2(a, b);
    }

    private static Vector3 PickNormal(bool useCtor, Vector3 fallbackDir) {
        return useCtor ? new Vector3(1.0f, 2.0f, 3.0f) : Vector3.Negate(fallbackDir);
    }

    private static Vector3 PickNormalReversed(bool useCall, Vector3 fallbackDir) {
        return useCall ? Vector3.Negate(fallbackDir) : new Vector3(4.0f, 5.0f, 6.0f);
    }

    public static void Main() {
        Vector3 n1 = PickNormal(true, new Vector3(0.0f, 1.0f, 0.0f));
        Vector3 n2 = PickNormal(false, new Vector3(0.0f, 1.0f, 0.0f));
        Vector3 n3 = PickNormalReversed(true, new Vector3(0.0f, 0.0f, 2.0f));
        Vector3 n4 = PickNormalReversed(false, new Vector3(0.0f, 0.0f, 2.0f));

        Pair2 localP = new Pair2(7, 8);
        bool pickCtor = false;
        Pair2 p1 = pickCtor ? new Pair2(1, 2) : MakePair(9, 10);
        Pair2 p2 = (!pickCtor) ? new Pair2(11, 12) : localP;

        Console.WriteLine(((int)n1.Z).ToString() + "," + ((int)n2.Y).ToString() + "," + ((int)n3.Z).ToString() + "," + ((int)n4.X).ToString());
        Console.WriteLine(p1.A.ToString() + "," + p1.B.ToString() + "," + p2.A.ToString() + "," + p2.B.ToString());
    }
}
