using System;

/* `var` locals of an async method are frame-resident like explicitly typed
 * ones: their value must survive a suspension. */
class Program {
    static async int Bump(int x) {
        await Task.Delay(1);
        return x + 1;
    }

    static async int Run() {
        var text = "abc";
        var n = 5;
        var d = 1.5;
        var flag = true;
        var r = await Bump(n);
        var joined = text + Convert.ToString(n);
        await Task.Delay(1);
        Console.WriteLine("text=" + text);
        Console.WriteLine("n=" + Convert.ToString(n));
        Console.WriteLine("d=" + Convert.ToString(d));
        Console.WriteLine("joined=" + joined);
        if (flag) { Console.WriteLine("flag ok"); }
        return r;
    }

    static async void Main() {
        Console.WriteLine("r=" + Convert.ToString(await Run()));
    }
}
