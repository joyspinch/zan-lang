using System;
using Sdk.Wechat;
using Sdk.Wechat.Work;
using Sdk.Wechat.WxOpen;
using Sdk.Wechat.Open;

class Program {
    static async void CompileWork(WechatWorkClient work) {
        WechatWorkMediaSpecialApi media = new WechatWorkMediaSpecialApi(work);
        WechatResponse a = await media.UploadAsync("image", "a.bin",
            "application/octet-stream", "abc");
        WechatRawResponse b = await media.GetAsync("id");
        WechatResponse c = await media.AddMaterialAsync("image", 1, "a.bin",
            "application/octet-stream", "abc");
        WechatRawResponse d = await media.GetForeverMaterialAsync(1, "id");
        WechatResponse e = await media.UploadimgMediaAsync("a.png", "image/png", "abc");
        WechatResponse f = await media.UploadAttachmentAsync("image", "1", "a.png",
            "image/png", "abc");
        WechatWorkWebhookSpecialApi hook = new WechatWorkWebhookSpecialApi(work);
        WechatResponse g = await hook.UploadMediaAsync("key", "a", "text/plain", "x");

        WechatWorkSmartRobotClient robot = new WechatWorkSmartRobotClient();
        robot.Endpoint("localhost", 443, "/");
        await robot.ConnectAndSubscribeAsync("bot", "secret");
        string msg = await robot.ReceiveAsync();
        await robot.RespondWelcomeAsync("id", "{}");
        await robot.RespondAsync("id", "{}");
        await robot.UpdateResponseAsync("id", "{}");
        await robot.SendMessageAsync("id", "{}");
        await robot.SendPingAsync("id");
        await robot.SendCommandAsync("ping", "id", "{}");
        await robot.CloseAsync();
    }

    static async void CompileWxOpen(WechatWxOpenClient wx) {
        WechatWxOpenSpecialApi api = new WechatWxOpenSpecialApi(wx);
        WechatWxOpenSpecialSendTextRequest send = new WechatWxOpenSpecialSendTextRequest();
        send.OpenId("openid").Content("hello").BusinessId("business");
        WechatWxOpenSpecialOperationResponse a0 = await api.SendTextAsync(send);
        WechatWxOpenSpecialTypingRequest typing = new WechatWxOpenSpecialTypingRequest();
        typing.OpenId("openid").Command("Typing").BusinessId("business");
        WechatWxOpenSpecialOperationResponse a1 = await api.GetTypingStatusAsync(typing);
        WechatResponse a2 = await api.AiCropAsync("https://x", "1:1");
        WechatResponse a3 = await api.AiCropByFileAsync("1:1", "a.png", "image/png", "x");
        WechatResponse a4 = await api.QrCodeAsync("https://x");
        WechatResponse a5 = await api.QrCodeByFileAsync("a.png", "image/png", "x");
        WechatResponse a6 = await api.SuperResolutionAsync("https://x");
        WechatResponse a7 = await api.SuperResolutionByFileAsync("a.png", "image/png", "x");
        WechatResponse a8 = await api.DrivingLicenseAsync("https://x");
        WechatResponse a9 = await api.DrivingLicenseByFileAsync("a.png", "image/png", "x");
        WechatWxOpenSpecialBillRequest bill = new WechatWxOpenSpecialBillRequest();
        bill.Date("20260728").Type("ALL");
        WechatRawResponse a10 = await api.GetBillAsync(bill);
        WechatResponse a11 = await api.SingleFileUploadAsync("name", "video", "a.mp4",
            "video/mp4", "x", "image", "cover.png", "image/png", "y", "ctx");
        WechatResponse a12 = await api.UploadPartAsync("upload", 1, 1, "a.bin",
            "application/octet-stream", "x");
        WechatRawResponse a13 = await api.GetFeedbackMediaAsync(1, "media");
        WechatWxOpenSpecialWxaCodeRequest code = new WechatWxOpenSpecialWxaCodeRequest();
        code.Path("pages/index").Width(430).IsHyaline(false);
        WechatRawResponse a14 = await api.GetWxaCodeAsync(code);
        WechatWxOpenSpecialWxaCodeUnlimitRequest unlimited = new WechatWxOpenSpecialWxaCodeUnlimitRequest();
        unlimited.Scene("id=1").Page("pages/index").Width(430).CheckPath(true);
        WechatRawResponse a15 = await api.GetWxaCodeUnlimitAsync(unlimited);
        WechatWxOpenSpecialQrCodeRequest qr = new WechatWxOpenSpecialQrCodeRequest();
        qr.Path("pages/index").Width(430);
        WechatRawResponse a16 = await api.CreateWxQrCodeAsync(qr);
        WechatResponse a17 = await api.ImgSecCheckAsync("a.png", "image/png", "x");
    }

    static async void CompileOpen(WechatOpenClient open) {
        WechatOpenSpecialApi api = new WechatOpenSpecialApi(open);
        WechatResponse a0 = await api.UploadPrivacyExtFileAsync("a", "text/plain", "x");
        WechatOpenSpecialQrCodeRequest qr = new WechatOpenSpecialQrCodeRequest();
        qr.Path("pages/index");
        WechatRawResponse a1 = await api.GetQRCodeAsync(qr);
        WechatResponse a2 = await api.UploadMediaAsync("a", "text/plain", "x");
        WechatResponse a3 = await api.UploadIcpMediaAsync("1", "field", 1,
            "a", "text/plain", "x");
        WechatRawResponse a4 = await api.GetIcpMediaAsync("id");
        WechatResponse a5 = await api.UploadAuthMaterialAsync("a", "text/plain", "x");
        WechatResponse a6 = await api.UploadWxaMediaAsync("a", "text/plain", "x");
        WechatOpenSpecialLibraryListRequest listReq = new WechatOpenSpecialLibraryListRequest();
        listReq.Offset(0).Count(10);
        WechatOpenSpecialLibraryListResponse a7 = await api.LibraryListAsync(listReq);
        WechatOpenSpecialLibraryGetRequest getReq = new WechatOpenSpecialLibraryGetRequest();
        getReq.Id("AT0001");
        WechatOpenSpecialLibraryGetResponse a8 = await api.LibraryGetAsync(getReq);
        WechatOpenSpecialTemplateAddRequest addReq = new WechatOpenSpecialTemplateAddRequest();
        List<int> keywordIds = new List<int>(); keywordIds.Add(1);
        addReq.Id("AT0001").KeywordIdList(keywordIds);
        WechatOpenSpecialTemplateAddResponse a9 = await api.AddAsync(addReq);
        WechatOpenSpecialTemplateListRequest templateList = new WechatOpenSpecialTemplateListRequest();
        templateList.Offset(0).Count(10);
        WechatOpenSpecialTemplateListResponse a10 = await api.ListAsync(templateList);
        WechatOpenSpecialTemplateDeleteRequest deleteReq = new WechatOpenSpecialTemplateDeleteRequest();
        deleteReq.TemplateId("template");
        WechatOpenSpecialOperationResponse a11 = await api.DelAsync(deleteReq);
    }

    static void Main() {
        WechatWorkClient work = new WechatWorkClient("corp", "secret");
        WechatWxOpenClient wx = new WechatWxOpenClient("app", "secret");
        WechatOpenClient open = new WechatOpenClient();
        WechatWorkMediaSpecialApi a = new WechatWorkMediaSpecialApi(work);
        WechatWorkWebhookSpecialApi b = new WechatWorkWebhookSpecialApi(work);
        WechatWorkSmartRobotClient c = new WechatWorkSmartRobotClient();
        WechatWxOpenSpecialApi d = new WechatWxOpenSpecialApi(wx);
        WechatOpenSpecialApi e = new WechatOpenSpecialApi(open);
        Console.WriteLine("http-special=37");
        Console.WriteLine("smart-robot-wss=1");
    }
}
