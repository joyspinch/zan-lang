using System;

// A byte[] handed to an extern's `string` parameter is the RAW buffer: the C
// side writes into it (a handle, a length, a pointer -- the sqlite3 driver's
// `sqlite3_open(filename, ppDb)` fills the 8-byte out-parameter that way).
// The host gives the callee the array's own pointer -- its argument coercion
// only bitcasts the pointer types, it never copies
// (src/compiler/irgen_arc.c: coerce_args_to_params). A backend that packs
// the bytes into a fresh managed string instead hands the C side a throwaway
// copy: whatever the callee writes lands in the copy (over its header), the
// program's own buffer stays empty, and the corrupted copy takes the program
// down with an access violation.
class Program {
    [DllImport("crt")]
    static extern void memset(string p, int c, int n);

    static void Main() {
        byte[] buf = new byte[8];
        memset(buf, 65, 8);
        int bad = 0;
        if (buf[0] != 65) { bad = bad + 1; }
        if (buf[3] != 65) { bad = bad + 1; }
        if (buf[7] != 65) { bad = bad + 1; }
        Console.WriteLine("extern-raw-buffer: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
