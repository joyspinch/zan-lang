using System;
using System.Collections.Generic;
using System.Data.Redis;
using System.IO;
using System.Net.Sockets;
using System.Net.Tls;

// Redis client's TLS path. Redis's TLS listener encrypts from the
// first byte (no negotiation), so ConnectSecureAsync wraps the socket right
// after TCP connect and every command -- above all AUTH -- then travels inside
// the tunnel. A live TLS redis-server is not available in CI, so this program
// is both ends: a fake RESP server behind TlsStream.AcceptAsync that parses
// real RESP arrays and scripts AUTH/PING/SET/GET, plus a client proving
//   * the round trip works over TLS and the password verifiably traversed the
//     tunnel (the server only sees it after the TLS upgrade),
//   * a self-signed server is rejected while certificate verification is on
//     (the default), with ConnectSecureAsync returning null.

// ---------------------------------------------------------------- server ----

/// <summary>Buffered reader over a TlsStream: RecvAsync returns arbitrary
/// record-sized chunks, while RESP needs exact line framing.</summary>
class TlsLines {
    TlsStream ts;
    byte[] buf;
    int len;   // valid bytes in buf
    int pos;   // consumed prefix

    TlsLines(TlsStream ts) {
        this.ts = ts;
        this.buf = new byte[32769];
        this.len = 0;
        this.pos = 0;
    }

    async bool Fill(int need) {
        while (this.len - this.pos < need) {
            string chunk = await this.ts.RecvAsync(16384);
            int cl = chunk.Length;
            if (cl <= 0) { return false; }
            if (this.pos > 0 && this.len + cl + 1 > this.buf.Length) {
                int rem = this.len - this.pos;
                for (int i = 0; i < rem; i = i + 1) { this.buf[i] = this.buf[this.pos + i]; }
                this.len = rem;
                this.pos = 0;
            }
            int k = 0;
            while (k < cl) {
                this.buf[this.len] = (byte)(chunk[k] & 255);
                this.len = this.len + 1;
                k = k + 1;
            }
        }
        return true;
    }

    /// <summary>One CRLF-terminated line without the terminator; null on
    /// peer close.</summary>
    async string ReadLine() {
        int scanFrom = this.pos;
        while (true) {
            int scan = scanFrom;
            while (scan + 1 < this.len) {
                if (this.buf[scan] == 13 && this.buf[scan + 1] == 10) {
                    string line = this.buf.ToStr(this.pos, scan - this.pos);
                    this.pos = scan + 2;
                    return line;
                }
                scan = scan + 1;
            }
            int oldLen = this.len;
            int have = this.len - this.pos;
            bool ok = await this.Fill(have + 1);
            if (!ok) { return null; }
            scanFrom = oldLen - 1;
            if (scanFrom < this.pos) { scanFrom = this.pos; }
        }
    }
}

class FakeRedis {
    int port;
    TlsContext serverTls;
    TcpListener listener;

    // ---- observations the client-side assertions read back ----
    string sawAuth = "";     // AUTH password, only visible inside the tunnel
    int commands;            // RESP arrays served

    FakeRedis(int port, TlsContext serverTls) {
        this.port = port;
        this.serverTls = serverTls;
        this.listener = null;
        this.sawAuth = "";
        this.commands = 0;
    }

    void Stop() {
        if (this.listener != null) { this.listener.Stop(); }
    }

    async void Serve() {
        this.listener = new TcpListener("127.0.0.1", this.port);
        this.listener.Start();
        while (true) {
            nint client = await this.listener.AcceptAsync();
            if (client < 0) { return; }
            Task.Spawn(this.Session(client));
        }
    }

    async void Session(nint sock) {
        TlsStream ts = await TlsStream.AcceptAsync(this.serverTls, sock);
        if (ts == null) {
            // Expected when the client aborts on certificate verification.
            Socket.Close(sock);
            return;
        }
        TlsLines r = new TlsLines(ts);
        string storeKey = "";
        string storeVal = "";
        while (true) {
            string head = await r.ReadLine();
            if (head == null) { break; }
            if (head.Length < 1 || (int)head[0] != 42) { break; }    // '*'
            int n = Convert.ToInt(head.Substring(1));
            List<string> args = new List<string>();
            bool bad = false;
            for (int i = 0; i < n; i = i + 1) {
                string h = await r.ReadLine();
                if (h == null || h.Length < 1 || (int)h[0] != 36) { bad = true; break; }   // '$'
                int blen = Convert.ToInt(h.Substring(1));
                string payload = await r.ReadLine();     // bulk payload (ASCII test data)
                if (payload == null || payload.Length != blen) { bad = true; break; }
                args.Add(payload);
            }
            if (bad) { break; }
            this.commands = this.commands + 1;
            string cmd = args[0].ToUpper();
            if (cmd == "AUTH") {
                this.sawAuth = args[1];
                int _a = await ts.SendAsync("+OK\r\n", 5);
            } else if (cmd == "PING") {
                int _p = await ts.SendAsync("+PONG\r\n", 7);
            } else if (cmd == "SET") {
                storeKey = args[1];
                storeVal = args[2];
                int _s = await ts.SendAsync("+OK\r\n", 5);
            } else if (cmd == "GET") {
                if (storeKey == args[1]) {
                    string body = "$" + Convert.ToString(storeVal.Length)
                        + "\r\n" + storeVal + "\r\n";
                    int _g = await ts.SendAsync(body, body.Length);
                } else {
                    int _g = await ts.SendAsync("$-1\r\n", 5);
                }
            } else {
                int _e = await ts.SendAsync("-ERR unknown command\r\n", 20);
            }
        }
        ts.Close();
        Socket.Close(sock);
    }
}

// ---------------------------------------------------------------- client ----

class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            Program.failures = Program.failures + 1;
        }
    }

    static async int Run() {
        Socket.Initialize();
        // 写出 PEM 文件到 _scratch/（git-ignored）：写当前目录会在仓库根
        // 残留 .pem（用例中途失败时不清理）。
        Directory.CreateDirectory("_scratch");
        File.WriteAllText("_scratch/redis_tls_server_cert.pem", SERVER_CERT);
        File.WriteAllText("_scratch/redis_tls_server_key.pem", SERVER_KEY);
        TlsContext serverTls = TlsContext.CreateServer(
            "_scratch/redis_tls_server_cert.pem", "_scratch/redis_tls_server_key.pem");
        Check(serverTls != null, "server ctx created");
        if (serverTls == null) {
            Console.WriteLine("failures=" + Convert.ToString(Program.failures));
            return 0;
        }

        FakeRedis server = new FakeRedis(9521, serverTls);
        Task.Spawn(server.Serve());
        await Task.Delay(80);

        // 场景 1：正路径——AUTH/SET/GET 全部走加密信道。
        RedisClient.SetTlsVerify(false);
        RedisClient r = await RedisClient.ConnectSecureAsync("127.0.0.1", 9521, 5000);
        Check(r != null, "secure connect");
        bool auth = await r.AuthAsync("s3cret");
        Check(auth, "AUTH ok over TLS");
        Check(server.sawAuth == "s3cret", "password arrived inside the tunnel");
        Check(server.commands >= 1, "server parsed RESP arrays over TLS");
        bool pong = await r.PingAsync();
        Check(pong, "PING/PONG over TLS");
        bool setOk = await r.SetAsync("name", "Alice");
        Check(setOk, "SET over TLS");
        string v = await r.GetAsync("name");
        Check(v == "Alice", "GET roundtrip over TLS");
        r.Close();

        // 场景 2：默认校验开启 + 自签证书 → ConnectSecureAsync 返回 null。
        RedisClient.SetTlsVerify(true);
        RedisClient strict = await RedisClient.ConnectSecureAsync("127.0.0.1", 9521, 5000);
        Check(strict == null, "self-signed rejected while verifying");

        server.Stop();
        serverTls.Free();
        Socket.Cleanup();
        Console.WriteLine("failures=" + Convert.ToString(Program.failures));
        // 停服后留几个泵转：accept 协程以 -1 复位并退出，退出时的
        // 泄漏探测才不会把服务端对象链记为仍可达。
        for (int i = 0; i < 20; i = i + 1) { await Task.Delay(10); }
        return 0;
    }

    static void Main() {
        int r = await Run();
    }

