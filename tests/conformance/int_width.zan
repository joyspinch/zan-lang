using System;
using System.Collections;
namespace P;
class Program {
    static void Main() {
        string s = "hello";
        int n = s.Length;            // i64 length -> int
        long big = 1000000000;
        long sum = big + n;          // long + int
        Console.WriteLine(n);
        Console.WriteLine(sum);

        List<int> xs = new List<int>();
        xs.Add(7);
        xs.Add(8);
        xs.Add(9);
        int acc = 0;
        for (int i = 0; i < xs.Count; i = i + 1) { acc = acc + xs[i]; }
        Console.WriteLine(acc);

        int c = (int)'A';
        Console.WriteLine(c);

        long L = 300;
        int t = (int)L + 5;
        Console.WriteLine(t);
    }
}
