// A conditional whose arms are a struct-valued property read (`Vector3.Zero`)
// and a struct constructor (`new Vector3(...)`) must merge both as one struct
// value: the constructor arm yields a stack slot, the property arm a value,
// and an unreconciled phi failed LLVM verification with E3090.
using System;
using System.Numerics;

public struct Pt {
    public int X;
    public int Y;
    public Pt(int x, int y) { X = x; Y = y; }
    public static Pt Origin { get { return new Pt(0, 0); } }
}

public class Holder {
    public Vector3 V;
    public Pt P;
}

public class App {
    static int calls = 0;
    static bool Flip() { calls++; return (calls % 2) == 1; }

    static Vector3 Pick(bool f) {
        return f ? Vector3.Zero : new Vector3(1.0f, 2.0f, 3.0f);
    }

    static float SumY(Vector3 v) { return v.Y; }

    public static void Main() {
        Holder h = new Holder();
        for (int i = 0; i < 2; i++) {
            bool f = Flip();
            h.V = f ? Vector3.Zero : new Vector3(1.0f, 2.0f, 3.0f);
            Console.WriteLine("field " + Convert.ToString(h.V.Y));
            Vector3 l = f ? new Vector3(4.0f, 5.0f, 6.0f) : Vector3.One;
            Console.WriteLine("local " + Convert.ToString(l.Z));
            Console.WriteLine("ret " + Convert.ToString(Pick(f).X));
            Console.WriteLine("arg " + Convert.ToString(SumY(f ? Vector3.UnitY : new Vector3(7.0f, 8.0f, 9.0f))));
            h.P = f ? Pt.Origin : new Pt(3, 4);
            Console.WriteLine("user " + h.P.X + "," + h.P.Y);
            Pt q = f ? new Pt(5, 6) : Pt.Origin;
            q.X = q.X + 10;
            Console.WriteLine("copy " + q.X + "," + q.Y);
        }
        Console.WriteLine("OK");
    }
}
