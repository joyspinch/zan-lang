using System;
using System.Data;
using System.Data.Sqlite;

// 核心契约与语义定义。
class Program {
    static int pass = 0;
    static int fail = 0;

    static void Check(string name, bool ok) {
        if (ok) { pass = pass + 1; }
        else { fail = fail + 1; Console.WriteLine("FAIL " + name); }
    }

    static void Main() {
        SqliteConnection db = SqliteConnection.Open(":memory:");
        db.Execute("CREATE TABLE t (id INTEGER PRIMARY KEY, n INTEGER, s TEXT, r REAL)");
        db.Execute("INSERT INTO t VALUES (1, 42, 'hello', 2.5)");
        db.Execute("INSERT INTO t VALUES (2, -7, '', -0.5)");
        db.Execute("INSERT INTO t VALUES (3, NULL, NULL, NULL)");
        db.Execute("INSERT INTO t VALUES (4, 9007199254740993, 'x', 1.0)");

        DbResult res = db.Query("SELECT id, n, s, r FROM t ORDER BY id");
        Check("rows", res.RowCount() == 4);

        // 核心契约与语义定义。
        Check("int-getint", res.GetInt(0, 1) == 42);
        Check("int-getlong", res.GetLong(0, 1) == 42);
        Check("int-getstring", res.GetString(0, 1) == "42");
        Check("int-getdouble", res.GetDouble(0, 1) == 42.0);
        Check("int-getbool-true", res.GetBool(0, 0));
        Check("int-getbool-42-false", !res.GetBool(0, 1));
        Check("int-notnull", !res.IsNull(0, 1));
        Check("int-byname", res.GetByName(0, "n") == "42");

        // 核心契约与语义定义。
        Check("neg-getint", res.GetInt(1, 1) == -7);
        Check("neg-getstring", res.GetString(1, 1) == "-7");
        Check("bool-two-false", !res.GetBool(1, 0) && !res.GetBool(1, 1));
        Check("empty-text", res.GetString(1, 2) == "" && !res.IsNull(1, 2));

        // 核心契约与语义定义。
        Check("null-isnull", res.IsNull(2, 1) && res.IsNull(2, 2) && res.IsNull(2, 3));
        Check("null-getint", res.GetInt(2, 1) == 0);
        Check("null-getstring", res.GetString(2, 1) == "");
        Check("null-getbool", !res.GetBool(2, 1));

        // 核心契约与语义定义。
        Check("bigint", res.GetLong(3, 1) == 9007199254740993L);
        Check("bigint-string", res.GetString(3, 1) == "9007199254740993");

        // 核心契约与语义定义。
        Check("real-getdouble", res.GetDouble(0, 3) == 2.5);
        Check("real-getstring", res.GetString(0, 3) == "2.5");
        Check("real-neg", res.GetDouble(1, 3) == -0.5);
        Check("real-null", res.IsNull(2, 3));

        // 核心契约与语义定义。
        DbRow row = res.RowAt(3);
        if (row == null) {
            Check("rowat-null", false);
        } else {
            Check("rowat-long", row.GetLong(1) == 9007199254740993L);
            Check("rowat-string", row.GetString(2) == "x");
            Check("rowat-count", row.Count() == 4);
        }

        // 核心契约与语义定义。
        List<string> r4 = res.GetRow(3);
        Check("getrow-stringify", r4[1] == "9007199254740993" && r4[0] == "4");

        // 核心契约与语义定义。
        db.Execute("CREATE TABLE u (v TEXT)");
        db.Execute("INSERT INTO u VALUES ('99')");
        DbResult ru = db.Query("SELECT v FROM u");
        Check("text-int-parse", ru.GetInt(0, 0) == 99 && ru.GetLong(0, 0) == 99);

        Console.WriteLine("pass: " + pass);
        Console.WriteLine("fail: " + fail);
    }
}
