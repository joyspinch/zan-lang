// A64c: an owned argument temporary must survive a throwing callee.
// `new Widget()` (arg 2 of Take) leaks its +1 if nobody registers it with
// the EH unwinder: the longjmp skips the success-path release below the
// call. Covers the non-generic instance/static call paths (previously only
// the generic-spec path registered argument temps). Multi-arg so an
// unbalanced pop (stealing another frame's registration) also trips it.
using System;

class Widget {
    int v;
    Widget(int v) { this.v = v; }
}

class Prog {
    static int Boom(Widget w, Widget w2) {
        throw new Exception("boom");
        return 0;
    }
    static void Main() {
        try {
            Boom(new Widget(1), new Widget(2));
        } catch (Exception e) {
            Console.WriteLine("caught");
        }
        Console.WriteLine("done");
    }
}
