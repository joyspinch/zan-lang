using System;
using System.IO;

// B-ID113：重定向 stdout 二进制模式——Console.Write 嵌 \n 原样 LF
//（C# 语义；曾走 CRT 文本模式被翻译成 CRLF），Console.WriteLine 显式
// NewLine。重定向输出与程序内写文件字节一致（WriteAllText 是 "wb" 原始字节）。
class Program {
    static void Main() {
        Console.Write("a\nb\n");
        string path = "_stdio_pin.tmp";
        File.WriteAllText(path, "a\nb\n");
        byte[] raw = File.ReadAllBytes(path);
        Console.WriteLine("len: " + Convert.ToString(raw.Length));
        Console.WriteLine("lf-raw: " + Convert.ToString(
            (raw[0] == 97 && raw[1] == 10 && raw[2] == 98 && raw[3] == 10) ? 1 : 0));
        File.Delete(path);
        Console.WriteLine("end");
    }
}
