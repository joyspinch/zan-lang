// 核心契约与语义定义。
using System;

class Program {
    static int Main() {
        string s = "mango";
        Console.WriteLine(s.CompareTo("mango"));
        Console.WriteLine(s.CompareTo("apple"));

        // 数值转换扩展（stdlib StringExtensions）：委托 Convert 的
        // strtoll/strtod 语义——非法输入得 0，不抛异常；null 守卫在
        // 扩展层补齐（静态 Convert.ToInt32 没有）。
        Console.WriteLine("42".ToInt32());
        Console.WriteLine("-17".ToInt32());
        Console.WriteLine("  5".Trim().ToInt32());
        Console.WriteLine("abc".ToInt32());
        Console.WriteLine("2147483647000".ToInt64());
        Console.WriteLine("3.5".ToDouble() > 3.4 ? 1 : 0);
        string nul = null;
        Console.WriteLine(nul.ToInt32());
        return 0;
    }
}
