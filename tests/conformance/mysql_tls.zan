    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            Program.failures = Program.failures + 1;
        }
    }

    static async int Run() {
        Socket.Initialize();
        // 写出 PEM 文件到 _scratch/（git-ignored）：写当前目录会在仓库根
        // 残留 .pem（用例中途失败时不清理）。
        Directory.CreateDirectory("_scratch");
        File.WriteAllText("_scratch/mysql_tls_server_cert.pem", SERVER_CERT);
        File.WriteAllText("_scratch/mysql_tls_server_key.pem", SERVER_KEY);
        TlsContext serverTls = TlsContext.CreateServer(
            "_scratch/mysql_tls_server_cert.pem", "_scratch/mysql_tls_server_key.pem");
        Check(serverTls != null, "server ctx created");
        if (serverTls == null) {
            Console.WriteLine("failures=" + Convert.ToString(Program.failures));
            return 0;
        }

        FakeMySqlTls secure = new FakeMySqlTls(43307, true, serverTls);
        FakeMySqlTls plain = new FakeMySqlTls(43308, false, null);
        Task.Spawn(secure.Serve());
        Task.Spawn(plain.Serve());
        await Task.Delay(80);

        // 场景 1：正路径——SSLRequest 后整条信道换 TLS，查询原样可用。
        MySqlConnection.SetTlsVerify(false);
        MySqlConnection db = await MySqlConnection.OpenSecureParamsAsync(
            "127.0.0.1", 43307, "app", "u", "p");
        Check(db.IsConnected(), "secure connect");
        Check(secure.sawSslRequest, "SSLRequest arrived");
        Check(secure.sslRequestSeq == 1, "SSLRequest used sequence 1");
        Check(secure.sslRequestHasBit, "SSLRequest set CLIENT_SSL");
        Check(secure.loginSeq == 2, "handshake response entered TLS at seq 2");
        DbResult r = await db.QueryAsync("select 7 as n");
        Check(r.RowCount() == 1, "one row over TLS");
        Check(r.GetString(0, 0) == "7", "row value survived the tunnel");
        Check(secure.queries == 1, "server served one query");
        db.Close();

        // 场景 2：默认校验开启 + 自签证书 → 握手必须失败（不静默放行）。
        MySqlConnection.SetTlsVerify(true);
        MySqlConnection strict = await MySqlConnection.OpenSecureParamsAsync(
            "127.0.0.1", 43307, "app", "u", "p");
        Check(!strict.IsConnected(), "self-signed rejected while verifying");
        Check(strict.GetError().IndexOf("TLS") >= 0, "verify failure mentions TLS");
        strict.Close();

        // 场景 3：服务器不报 CLIENT_SSL → 显式失败，绝不明文登录。
        MySqlConnection.SetTlsVerify(false);
        MySqlConnection plainDb = await MySqlConnection.OpenSecureParamsAsync(
            "127.0.0.1", 43308, "app", "u", "p");
        Check(!plainDb.IsConnected(), "no-TLS server refused");
        Check(plainDb.GetError().IndexOf("TLS") >= 0, "refusal mentions TLS");
        Check(!plain.sawDowngrade, "no plaintext handshake response sent");
        plainDb.Close();

        secure.Stop();
        plain.Stop();
        serverTls.Free();
        Socket.Cleanup();
        Console.WriteLine("failures=" + Convert.ToString(Program.failures));
        // 停服后留几个泵转：accept 协程以 -1 复位并退出，退出时的
        // 泄漏探测才不会把服务端对象链记为仍可达。
        for (int i = 0; i < 20; i = i + 1) { await Task.Delay(10); }
        return 0;
    }

    static void Main() {
        int r = await Run();
    }
}

