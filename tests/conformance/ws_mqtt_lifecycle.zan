using System;
using System.Net.WebSocket;
using System.Net.Mqtt;

class Program {
    static void Main() {
        // 1. 验证 WebSocketClient 实现 IDisposable
        WebSocketClient ws = new WebSocketClient();
        Console.WriteLine("ws_connected=" + (ws.IsConnected() ? "true" : "false"));
        IDisposable dispWs = ws;
        dispWs.Dispose();
        Console.WriteLine("ws_disposed=true");

        // 2. 验证 MqttClient 实现 IDisposable
        MqttClient mqtt = new MqttClient();
        Console.WriteLine("mqtt_connected=" + (mqtt.IsConnected() ? "true" : "false"));
        IDisposable dispMqtt = mqtt;
        dispMqtt.Dispose();
        Console.WriteLine("mqtt_disposed=true");

        Console.WriteLine("ws_mqtt_lifecycle_ok=1");
    }
}
