using System;

class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            failures = failures + 1;
            Console.WriteLine("FAIL " + name);
        }
    }

    static void Main() {
        // 1. 无参构造在高频连续调用下必须消除秒级 time(0) 相同种子碰撞
        Random r1 = new Random();
        Random r2 = new Random();
        Random r3 = new Random();
        Random r4 = new Random();

        Check(r1.state != r2.state, "r1 != r2 state");
        Check(r2.state != r3.state, "r2 != r3 state");
        Check(r3.state != r4.state, "r3 != r4 state");

        // 2. 产生的首个随机数不全等
        bool anyDiff = (r1.Next() != r2.Next()) || (r2.Next() != r3.Next());
        Check(anyDiff, "consecutive random outputs differ");

        // 3. 显式构造函数 new Random(seed) 与 Seeded(seed) 保持复现一致性
        Random s1 = new Random(123456789L);
        Random s2 = Random.Seeded(123456789L);
        bool match = true;
        for (int i = 0; i < 20; i = i + 1) {
            if (s1.Next() != s2.Next()) { match = false; }
        }
        Check(match, "explicit constructor matches Seeded factory");

        if (failures > 0) {
            Console.WriteLine("FAIL: " + Convert.ToString(failures));
        } else {
            Console.WriteLine("all pass");
        }
    }
}
