// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。
using System.Text;
namespace Conf;

class Program {
    static string BytesToHexDump(byte[] b, int off, int len) {
        string s = "";
        for (int i = 0; i < len; i = i + 1) {
            if (i > 0) { s = s + " "; }
            s = s + ((int)b[off + i]).ToString();
        }
        return s;
    }

    static void Main() {
        // 核心契约与语义定义。
        string text = "aé中";
        byte[] enc = Encoding.UTF8.GetBytes(text);
        Console.WriteLine("len=" + enc.Length.ToString());          // 1+2+3 = 6
        Console.WriteLine("bytes=" + BytesToHexDump(enc, 0, enc.Length));
        string dec = Encoding.UTF8.GetString(enc);
        Console.WriteLine("roundtrip=" + (dec == text).ToString());
        Console.WriteLine("declen=" + dec.Length.ToString());

        // 核心契约与执行状态转移规范。
        byte[] n1 = Encoding.UTF8.GetBytes(null);
        Console.WriteLine("nullbytes=" + n1.Length.ToString());
        Console.WriteLine("nullstr=" + (Encoding.UTF8.GetString(null) == "").ToString());

        // 核心契约与语义定义。
        // 核心契约与语义定义。
        // 核心契约与语义定义。
        byte[] bad = new byte[5];
        bad[0] = 65; bad[1] = 0xC3; bad[2] = 40; bad[3] = 0xE4; bad[4] = 65;
        string fixed1 = Encoding.UTF8.GetString(bad);
        Console.WriteLine("fixlen=" + fixed1.Length.ToString());
        Console.WriteLine("fixbytes=" + BytesToHexDump(fixed1.ToBytes(), 0, fixed1.ToBytes().Length));
        // expect: 65 239 191 189 40 239 191 189 65  (A, U+FFFD, '(', U+FFFD, A)

        // 核心契约与语义定义。
        byte[] ovl = new byte[2];
        ovl[0] = 0xC0; ovl[1] = 0x80;
        string fixed2 = Encoding.UTF8.GetString(ovl);
        Console.WriteLine("ovllen=" + fixed2.Length.ToString());
        Console.WriteLine("ovlbytes=" + BytesToHexDump(fixed2.ToBytes(), 0, fixed2.ToBytes().Length));

        // 核心契约与执行状态转移规范。
        byte[] lone = new byte[3];
        lone[0] = 72; lone[1] = 0x80; lone[2] = 105;
        string fixed3 = Encoding.UTF8.GetString(lone);
        Console.WriteLine("lonelen=" + fixed3.Length.ToString());
        Console.WriteLine("lonebytes=" + BytesToHexDump(fixed3.ToBytes(), 0, fixed3.ToBytes().Length));

        // 核心契约与语义定义。
        // 系统底层交互与数据流转契约
        // 核心契约与语义定义。
        string w1 = Encoding.UTF8.GetString(enc, 1, 3);
        Console.WriteLine("w1len=" + w1.Length.ToString());
        Console.WriteLine("w1bytes=" + BytesToHexDump(w1.ToBytes(), 0, w1.ToBytes().Length));
        // 系统底层交互与数据流转契约
        string w2 = Encoding.UTF8.GetString(enc, 3, 99);
        Console.WriteLine("w2=" + (w2 == "中").ToString());
        // 核心契约与执行状态转移规范。
        string w3 = Encoding.UTF8.GetString(enc, 99, 5);
        Console.WriteLine("w3=" + (w3 == "").ToString());
        // 核心契约与语义定义。
        string w4 = Encoding.UTF8.GetString(enc, -2, -1);
        Console.WriteLine("w4=" + (w4 == "").ToString());

        // 核心契约与语义定义。
        byte[] all = Encoding.UTF8.GetBytes("héllo世界");
        string back = Encoding.UTF8.GetString(all);
        Console.WriteLine("big=" + (back == "héllo世界").ToString());
    }
}
