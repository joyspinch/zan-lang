// <auto-generated>
// 由 System.Mapping.GenMapping 生成——重新生成会覆盖，勿手改。
// 源类型：Order    目标类型：OrderDto

using System;
using System.Collections.Generic;
using Shop.Domain;
using Shop.Api;

namespace Shop.Map;

public static class OrderMapper {
    // 把 Order 映射成 OrderDto（显式字段拷贝，无反射）。
    public static OrderDto Map(Order src) {
        OrderDto dst = new OrderDto();
        dst.code = src.code;
        dst.amount = src.amount;
        dst.customerName = src.customer.name;
        dst.customerEmail = src.customer.email;
        return dst;
    }

    // 列表映射：逐个元素走 Map。
    public static List<OrderDto> MapList(List<Order> src) {
        List<OrderDto> outv = new List<OrderDto>();
        for (int i = 0; i < src.Count; i = i + 1) {
            outv.Add(Map(src[i]));
        }
        return outv;
    }
}
