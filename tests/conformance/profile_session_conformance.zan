using System;
using System.Diagnostics;

class Program {
    static void SimulateWork(int iterations) {
        long sum = 0;
        for (int i = 0; i < iterations; i = i + 1) {
            sum = sum + i;
        }
    }

    static void Main() {
        Console.WriteLine("[1] Testing ProfileSession Start & Scopes...");
        ProfileSession session = ProfileSession.Start("Database-Benchmark");

        for (int i = 0; i < 5; i = i + 1) {
            using (ProfileScopeGuard guard = session.Scope("QueryUser")) {
                SimulateWork(1000);
            }
        }

        for (int i = 0; i < 3; i = i + 1) {
            using (ProfileScopeGuard guard = session.Scope("UpdateProfile")) {
                SimulateWork(2000);
            }
        }

        Console.WriteLine("[2] Verifying recorded metrics...");
        ProfileMetric qm = session.GetMetric("QueryUser");
        if (qm != null) {
            Console.WriteLine("QueryUser callCount: " + Convert.ToString(qm.callCount));
            Console.WriteLine("QueryUser has elapsed time: " + (qm.totalMicroseconds >= 0 ? "true" : "false"));
        } else {
            Console.WriteLine("FAIL: QueryUser metric missing");
        }

        ProfileMetric um = session.GetMetric("UpdateProfile");
        if (um != null) {
            Console.WriteLine("UpdateProfile callCount: " + Convert.ToString(um.callCount));
            Console.WriteLine("UpdateProfile has elapsed time: " + (um.totalMicroseconds >= 0 ? "true" : "false"));
        } else {
            Console.WriteLine("FAIL: UpdateProfile metric missing");
        }

        Console.WriteLine("[3] Generating profile summary...");
        string summary = session.GenerateSummary();
        Console.WriteLine("Summary contains session name: " + (summary.Contains("Database-Benchmark") ? "true" : "false"));
        Console.WriteLine("Summary contains QueryUser: " + (summary.Contains("QueryUser") ? "true" : "false"));
        Console.WriteLine("Summary contains UpdateProfile: " + (summary.Contains("UpdateProfile") ? "true" : "false"));

        Console.WriteLine("OK: all profile session checks passed!");
    }
}
