using System;
using System.Data;
using System.Data.Sqlite;
using System.IO;

class Program {
    static async int Run() {
        string dbFile = "test_dbpool_lifecycle.tmp.db";
        File.Delete(dbFile);

        // 1. 验证 SqlitePool 构造、借出与归还
        SqlitePool pool = new SqlitePool(dbFile, 3);
        Console.WriteLine("init_idle=" + Convert.ToString(pool.IdleCount()));
        Console.WriteLine("init_live=" + Convert.ToString(pool.LiveCount()));

        SqliteConnection conn1 = await pool.AcquireAsync();
        Console.WriteLine("conn1_ok=" + (conn1 != null && conn1.IsConnected() ? "true" : "false"));
        Console.WriteLine("after_acq1_live=" + Convert.ToString(pool.LiveCount()));

        // 归还连接
        pool.Release(conn1);
        Console.WriteLine("after_rel_idle=" + Convert.ToString(pool.IdleCount()));

        // 2. 验证 IDisposable 多态转换与 Dispose 行为
        IDisposable disp = pool;
        disp.Dispose();
        Console.WriteLine("pool_disposed");

        // 3. 关闭后再次借出应返回 null
        SqliteConnection connAfterClose = await pool.AcquireAsync();
        Console.WriteLine("after_close_acq=" + (connAfterClose == null ? "null" : "not_null"));

        File.Delete(dbFile);
        Console.WriteLine("ok");
        return 0;
    }

    static async void Main() {
        await Program.Run();
    }
}
