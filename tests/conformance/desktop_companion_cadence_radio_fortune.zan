using System;
using System.Windows;

class Program {
    static int Main() {
        // 1. 隐私优先打字节奏活力计（滑窗 KPM 分级）
        CompanionTypingCadenceMeter meter = new CompanionTypingCadenceMeter(10000L); // 10 秒窗
        bool idleOk = meter.EvaluateTier(1000L) == TypingCadenceTier.Idle;

        // 10 秒内 10 次 -> 60 KPM -> Steady
        for (int i = 0; i < 10; i = i + 1) {
            meter.RecordPulse(2000L + (long)i * 200L);
        }
        bool steadyOk = meter.PulsesPerMinute(4000L) == 60
            && meter.EvaluateTier(4000L) == TypingCadenceTier.Steady;

        // 再加 25 次（共 35 次） -> 210 KPM -> FlowState
        for (int i = 0; i < 25; i = i + 1) {
            meter.RecordPulse(5000L + (long)i * 100L);
        }
        bool flowOk = meter.EvaluateTier(8000L) == TypingCadenceTier.FlowState;

        // 再加 15 次（共 50 次） -> 300 KPM -> Overdrive
        for (int i = 0; i < 15; i = i + 1) {
            meter.RecordPulse(8100L + (long)i * 50L);
        }
        bool overdriveOk = meter.EvaluateTier(9000L) == TypingCadenceTier.Overdrive;

        // 30 秒后滑窗全过期 -> 回到 Idle
        bool expireOk = meter.EvaluateTier(30000L) == TypingCadenceTier.Idle;
        Console.WriteLine("cadence_meter_ok=" + ((idleOk && steadyOk && flowOk && overdriveOk && expireOk) ? "1" : "0"));

        // 2. Lo-Fi 电台播放台：轮切、静音保留音量、睡眠定时自动停播
        CompanionLoFiRadioDeck deck = new CompanionLoFiRadioDeck();
        deck.AddStation("rain_lofi", "Rainy Study Beats");
        deck.AddStation("synth_night", "Midnight Synthwave");
        deck.NextStation();
        RadioStationChannel cur = deck.CurrentStation();
        bool stationOk = cur != null && cur.StationId == "synth_night";

        deck.VolumePercent = 65;
        deck.StartWithSleepTimer(120);
        int volPlaying = deck.EffectiveVolume();
        deck.ToggleMute();
        int volMuted = deck.EffectiveVolume();
        deck.ToggleMute();
        int volRestored = deck.EffectiveVolume();
        deck.StepSeconds(120);
        bool sleepStopped = !deck.Playing && deck.SleepTimerRemainingSec == 0 && deck.EffectiveVolume() == 0;

        bool radioOk = stationOk && volPlaying == 65 && volMuted == 0 && volRestored == 65 && sleepStopped;
        Console.WriteLine("lofi_radio_ok=" + (radioOk ? "1" : "0"));

        // 3. 每日一签抽卡器：同日锁定不重抽 + 跨日收集图鉴
        CompanionDailyFortuneCard fortune = new CompanionDailyFortuneCard();
        fortune.AddFortuneText("Code compiles on first try");
        fortune.AddFortuneText("Zero leaks today");
        fortune.AddFortuneText("Deep focus unlocked");
        fortune.AddFortuneText("Smooth deploy ahead");

        FortuneCardRecord d1a = fortune.DrawForDay(20261128);
        FortuneCardRecord d1b = fortune.DrawForDay(20261128);
        FortuneCardRecord d2 = fortune.DrawForDay(20261129);
        FortuneCardRecord d3 = fortune.DrawForDay(20261130);
        FortuneCardRecord d4 = fortune.DrawForDay(20261201);

        bool sameDayLocked = d1a != null && d1b != null && d1a.CardId == d1b.CardId && d1a.Text == d1b.Text;
        bool multiDayOk = d2 != null && d3 != null && d4 != null && fortune.UniqueCollectedCount() >= 2;
        Console.WriteLine("daily_fortune_ok=" + ((sameDayLocked && multiDayOk) ? "1" : "0"));
        return 0;
    }
}
