// Conformance: `foreach` over an array or a string with an await in the body.
//
// Unlike a List (whose count is re-read from the object each iteration), an
// array's length and a string's length were computed once in the loop
// pre-header and kept in a register. An await splits the loop across resume
// invocations, so that register neither dominates the loop condition nor
// survives the suspension -- the module failed LLVM verification.
using System;

class Program {
    static async int Bump(int x) {
        await Task.Delay(1);
        return x + 1;
    }

    static async int Run() {
        int[] xs = new int[3];
        xs[0] = 1;
        xs[1] = 2;
        xs[2] = 5;
        int sum = 0;
        foreach (int x in xs) {
            sum = sum + await Program.Bump(x);
        }
        Console.WriteLine("array=" + Convert.ToString(sum));

        int chars = 0;
        foreach (char c in "hello") {
            chars = chars + await Program.Bump(0);
        }
        Console.WriteLine("string=" + Convert.ToString(chars));

        // nested: the inner array loop restarts on every outer element
        int nested = 0;
        foreach (int x in xs) {
            foreach (int y in xs) {
                if (y == 2) { continue; }
                nested = nested + await Program.Bump(y);
            }
        }
        Console.WriteLine("nested=" + Convert.ToString(nested));
        return sum;
    }

    static async void Main() {
        await Program.Run();
    }
}
