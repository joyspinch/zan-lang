using System;

class Program {
    static int g_trace = 0;

    [Init(100)]
    [NoAlloc]
    static void EarlyInit() {
        g_trace = g_trace * 10 + 1;
    }

    [Init(200)]
    [NoAlloc]
    static void LateInit() {
        g_trace = g_trace * 10 + 2;
    }

    [Fini(200)]
    static void OnShutdown() {
        Console.WriteLine("fini=ok");
    }

    [Export("base_compute")]
    [Hot]
    [NoAlloc]
    static int BaseCompute(int x, int y) {
        return x * 10 + y;
    }

    [Export("alias_compute")]
    [Alias("base_compute")]
    static int AliasCompute(int x, int y) {}

    [Export("weak_alias_compute")]
    [Weak]
    [Alias("base_compute")]
    static int WeakAliasCompute(int x, int y) {}

    [Export("fatal_halt")]
    [Cold]
    [NoReturn]
    [NoAlloc]
    static void FatalHalt() {
        Hint.Trap();
        Hint.Unreachable();
    }

    static int Main() {
        int a = AliasCompute(4, 2);
        int b = WeakAliasCompute(7, 5);
        int same = (NativeMemory.FunctionPointer(BaseCompute) ==
                    NativeMemory.FunctionPointer(AliasCompute)) ? 1 : 0;
        Console.WriteLine($"init={g_trace} a={a} b={b} same={same}");
        return 0;
    }
}
