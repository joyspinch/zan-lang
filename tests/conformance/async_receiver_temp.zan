// 接口数据协议与执行契约。
// 核心契约与语义定义。
using System;

class Leaf {
    int v;
    string tag;
    Leaf(int v, string tag) { this.v = v; this.tag = tag; }
    Leaf Scale(int k) { return new Leaf(this.v * k, this.tag); }
    async long SumAsync(long extra) { return (long)this.v + extra; }
    async string TagAsync() { return this.tag + ":" + Convert.ToString(this.v); }
}

class Box {
    Leaf leaf;
    Box(Leaf leaf) { this.leaf = leaf; }
    Leaf Get() { return this.leaf; }

    static Leaf Make(int v) { return new Leaf(v, "leaf"); }

    // 接口数据协议与执行契约。
    static async long ChainAsync() {
        long a = await Box.Make(3).SumAsync(1);
        long b = await Box.Make(5).Scale(2).SumAsync(0);
        return a + b;
    }
}

class Program {
    static void Main() {
        // 核心契约与语义定义。
        Console.WriteLine(Convert.ToString(await Box.Make(7).SumAsync(1)));
        Console.WriteLine(await Box.Make(4).Scale(3).TagAsync());
        // 接口数据协议与执行契约。
        Leaf keep = Box.Make(2);
        Console.WriteLine(Convert.ToString(await keep.SumAsync(10)));
        Box b = new Box(keep);
        Console.WriteLine(Convert.ToString(await b.Get().SumAsync(20)));
        Console.WriteLine(Convert.ToString(await Box.ChainAsync()));
        // 接口数据协议与执行契约。
        Console.WriteLine(Convert.ToString(await keep.SumAsync(0)));
    }
}
