// Chained calls on built-in properties: string.Length, List.Count,
// Dictionary.Count, StringBuilder.Length and array.Length have no field
// symbol, so type inference used to answer NULL for them and every lowering
// keyed on the receiver's static type declined -- `xs.Count.ToString()`
// silently produced "0". A user-declared property is included as the control.
class Holder {
    public int N { get { return 42; } }
    public string S { get { return "str"; } }
}
class P {
    static void Main() {
        List<int> xs = new List<int>();
        xs.Add(1);
        xs.Add(5);
        int c = xs.Count;
        Console.WriteLine(c.ToString());                // 2
        Console.WriteLine(xs.Count.ToString());         // 2
        Console.WriteLine("n=" + xs.Count.ToString());  // n=2
        string s = "hello";
        Console.WriteLine(s.Length.ToString());         // 5
        Dictionary<string, int> d = new Dictionary<string, int>();
        d.Add("a", 1);
        d.Add("b", 2);
        d.Add("c", 3);
        Console.WriteLine(d.Count.ToString());          // 3
        StringBuilder sb = new StringBuilder();
        sb.Append("abcd");
        Console.WriteLine(sb.Length.ToString());        // 4
        int[] arr = new int[7];
        Console.WriteLine(arr.Length.ToString());       // 7
        Holder h = new Holder();
        Console.WriteLine(h.N.ToString());              // 42
        Console.WriteLine(h.S.Length.ToString());       // 3
    }
}
