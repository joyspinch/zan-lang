using System;

class SlotDemandBase {
    public virtual int Active() { return 20; }
    public virtual int Late() { return 10; }
    public virtual int Relay(SlotDemandBase value) { return value.Active(); }
    public virtual void Unused() {
        Console.WriteLine("VSLOT_BASE_UNUSED_MUST_BE_DEAD");
    }
}

class SlotDemandChild : SlotDemandBase {
    public override int Active() { return 22; }
    public override int Late() { return 30; }
    public override int Relay(SlotDemandBase value) { return value.Late(); }
    public override void Unused() {
        Console.WriteLine("VSLOT_CHILD_UNUSED_MUST_BE_DEAD");
    }
}

class Program {
    static int Read(SlotDemandBase receiver, SlotDemandBase value) {
        return receiver.Relay(value);
    }

    static void DeadDispatch(SlotDemandBase value) { value.Unused(); }

    static void Main() {
        SlotDemandBase first = new SlotDemandBase();
        SlotDemandBase second = new SlotDemandChild();
        if (Read(first, first) != 20 || Read(first, second) != 22 ||
        Read(second, first) != 10 || Read(second, second) != 30) {
            throw new Exception("late virtual slot demand");
        }
        Console.WriteLine("virtual slot demand PASS");
    }
}
