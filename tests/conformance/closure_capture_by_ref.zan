using System;

// A closure captures an enclosing local by reference (C# semantics): a write
// to that local after the closure was created is visible inside the closure.
// A local that is never written afterwards is captured by value, which reads
// the same.
class Program {
    static void Main(string[] args) {
        int x = 1;
        Func<int> f = () => x;
        x = 2;
        Console.WriteLine(Convert.ToString(f()));

        int y = 10;
        Func<int> g = () => y;
        Console.WriteLine(Convert.ToString(g()));
    }
}
