using System;
using System.Collections.Generic;

// A closure captures an enclosing local by reference (C# semantics): a write
// to that local after the closure was created is visible inside the closure,
// and a write from inside the closure is visible outside. A local that is
// never written afterwards is captured by value, which reads the same.
class Program {
    static void Main(string[] args) {
        int x = 1;
        Func<int> f = () => x;
        x = 2;
        Console.WriteLine(Convert.ToString(f()));

        int y = 10;
        Func<int> g = () => y;
        Console.WriteLine(Convert.ToString(g()));

        // a write from inside the closure is visible outside
        int a = 1;
        Action setA = () => { a = 5; };
        setA();
        Console.WriteLine(Convert.ToString(a));

        // a captured parameter
        Console.WriteLine(Convert.ToString(Make()));

        // a captured reference-type local
        var list = new List<int>();
        list.Add(1);
        Func<int> cnt = () => list.Count;
        list.Add(2);
        Console.WriteLine(Convert.ToString(cnt()));

        // a local declared in an inner block
        {
            int c = 7;
            Func<int> h = () => c;
            Console.WriteLine(Convert.ToString(h()));
        }

        // By-value parameters still share one cell across sibling closures.
        Console.WriteLine(Convert.ToString(SharedParameter(3)));

        // A ref parameter may be used by its own method. Same-name lambda
        // parameters/locals bind to their own storage, not the ref parameter.
        int value = 7;
        Console.WriteLine(Convert.ToString(ShadowedParameter(ref value)));
        Console.WriteLine(Convert.ToString(value));
    }

    static int SharedParameter(int value) {
        Func<int> read = () => value;
        Action write = () => { value = value + 1; };
        value = 9;
        write();
        return read();
    }

    static int ShadowedParameter(ref int value) {
        Func<int, int> parameter = (int value) => value + 1;
        Func<int> local = () => {
            int value = 20;
            Func<int> nested = () => value;
            value = 21;
            return nested();
        };
        value = value + 1;
        return parameter(10) + local();
    }

    static int Make() {
        int p = 3;
        Func<int> k = () => p;
        p = 4;
        return k();
    }
}
