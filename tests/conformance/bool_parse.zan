using System;

// bool.Parse 内建：true/false 的大小写任意变体；其余（含 null/空白/
// 空串）在 try 内按 FormatException 分流（guard "not a valid" 路由）。
class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            failures = failures + 1;
            Console.WriteLine("FAIL " + name);
        }
    }

    static bool ThrowsFE(string s) {
        try {
            bool.Parse(s);
        } catch (FormatException) {
            return true;
        }
        return false;
    }

    static void Main() {
        Check(bool.Parse("true"), "true");
        Check(bool.Parse("True"), "True");
        Check(bool.Parse("TRUE"), "TRUE");
        Check(bool.Parse("tRUE"), "tRUE");
        Check(!bool.Parse("false"), "false");
        Check(!bool.Parse("False"), "False");
        Check(!bool.Parse("FALSE"), "FALSE");

        Check(ThrowsFE("yes"), "yes throws FormatException");
        Check(ThrowsFE("0"), "0 throws FormatException");
        Check(ThrowsFE(""), "empty throws FormatException");
        Check(ThrowsFE(" true"), "leading space throws (C# 口径)");
        bool threwNull = false;
        try {
            bool.Parse(null);
        } catch (Exception) {
            threwNull = true;
        }
        Check(threwNull, "null throws (parse guard，int.Parse 同款)");

        // 与 int.Parse 混排：内建分派互不干扰
        Check(int.Parse("42") == 42, "int.Parse still works");
        Check(long.Parse("9223372036854775807") > 0, "long.Parse still works");

        Console.WriteLine("failures=" + failures);
    }
}
