// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 核心契约与语义定义。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
using System;
using System.Json;
using System.Text;

class Program {
    static int bad;

    static void Check(bool ok, string label) {
        if (!ok) { Console.WriteLine("FAIL " + label); bad = bad + 1; }
    }

    static string Nested(int n) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < n; i = i + 1) { sb.Append("["); }
        sb.Append("1");
        for (int i = 0; i < n; i = i + 1) { sb.Append("]"); }
        return sb.ToString();
    }

    /// 组装 n 层 {"a": {"a": ... {"leaf":1} ...}}} 的值树。
    static JsonValue DeepTree(int n) {
        JsonValue root = JsonValue.NewObject();
        JsonValue cur = root;
        for (int i = 0; i < n; i = i + 1) {
            JsonValue next = JsonValue.NewObject();
            cur.Put("a", next);
            cur = next;
        }
        cur.Put("leaf", JsonValue.NewNum("1"));
        return root;
    }

    static void Main() {
        // 接口数据协议与执行契约。
        JsonValue doc = JsonValue.Parse("{\"a\": [1, 2, {\"b\": \"x\"}]}");
        Check(doc.Int("a", 0) != 0 || doc.Count() == 1, "normal parse");
        JsonValue a = doc.Get("a");
        Check(a != null && a.At(2).Str("b", "") == "x", "nested access");
        Check(doc.ToJson() == "{\"a\":[1,2,{\"b\":\"x\"}]}", "normal ToJson");

        // 核心契约与语义定义。
        JsonValue deep = JsonValue.Parse(Nested(100));
        Check(deep.IsArray(), "depth 100 ok");
        Check(DeepTree(100).ToJson().Length == 610, "serialize depth 100 ok");

        // 接口数据协议与执行契约。
        bool threw = false;
        try {
            JsonValue v = JsonValue.Parse(Nested(2000));
        } catch (JsonException e) {
            threw = true;
        }
        Check(threw, "depth 2000 rejected");

        JsonValue lenient = JsonValue.ParseLenient(Nested(2000));
        Check(lenient != null && lenient.IsArray(), "lenient depth 2000");

        // 核心契约与语义定义。
        StringBuilder ob = new StringBuilder();
        int n = 2000;
        for (int i = 0; i < n; i = i + 1) { ob.Append("{\"k\":"); }
        ob.Append("1");
        for (int i = 0; i < n; i = i + 1) { ob.Append("}"); }
        bool threw2 = false;
        try {
            JsonValue v = JsonValue.Parse(ob.ToString());
        } catch (JsonException e) {
            threw2 = true;
        }
        Check(threw2, "object depth 2000 rejected");

        // 接口数据协议与执行契约。
        // 接口数据协议与执行契约。
        // 接口数据协议与执行契约。
        bool threw3 = false;
        try {
            string s = DeepTree(2000).ToJson();
        } catch (JsonException e) {
            threw3 = true;
        }
        Check(threw3, "ToJson depth 2000 rejected");

        bool threw4 = false;
        try {
            string s = DeepTree(2000).PrettyToJson();
        } catch (JsonException e) {
            threw4 = true;
        }
        Check(threw4, "PrettyToJson depth 2000 rejected");

        // 接口数据协议与执行契约。
        JsonValue lenientDeep = JsonValue.ParseLenient(Nested(5000));
        if (lenientDeep != null) {
            bool threw5 = false;
            try {
                string s = lenientDeep.ToJson();
            } catch (JsonException e) {
                threw5 = true;
            }
            Check(threw5, "lenient tree ToJson bounded");
        }

        Console.WriteLine("json-depth-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
