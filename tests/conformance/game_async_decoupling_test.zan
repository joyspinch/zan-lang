using System;
using System.Threading;
using System.Threading.Tasks;
using Game.Core;
using Game.Foundation;

namespace T;

class Program {
    static void Assert(string name, bool cond) {
        if (!cond) {
            Console.WriteLine("FAIL: " + name);
            Environment.Exit(1);
        }
        Console.WriteLine("PASS: " + name);
    }

    static async int AsyncCompute(int val) {
        return val * 2;
    }

    static void Main() {
        Console.WriteLine("=== Testing Game Tick & Async Decoupling ===");

        // 1. 验证确定性独立固定步长时钟 (FixedStepClock) 不依赖任何绘制/帧 Present
        FixedStepClock clock = new FixedStepClock(16, 5);
        int steps1 = clock.Advance(32);
        Assert("clock advanced 2 steps", steps1 == 2);
        Assert("has step true", clock.HasStep());

        int consumed = 0;
        while (clock.HasStep()) {
            int dt = clock.ConsumeStep();
            if (dt == 16) { consumed = consumed + 1; }
        }
        Assert("consumed 2 fixed steps", consumed == 2);
        Assert("has step false", !clock.HasStep());

        // 2. 验证异步 await 不依赖渲染帧泵送，直接协同调度完成
        int res = await AsyncCompute(21);
        Assert("async compute completed independently", res == 42);

        Console.WriteLine("GAME_ASYNC_DECOUPLING_OK");
    }
}
