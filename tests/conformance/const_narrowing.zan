// C# implicit constant expression conversion: a constant that fits the
// destination needs no cast, a value that only fits at runtime does.
class Program {
    static byte MaxByte = 255;
    static sbyte MinSbyte = -128;

    static void Main() {
        byte a = 200;
        byte b = 1 + 2;
        byte c = 1 << 7;
        sbyte d = -128;
        short e = -32768;
        ushort f = 65535;
        uint g = 4294967295;
        long h = 1;
        int i = (int)h;

        Console.WriteLine(a);
        Console.WriteLine(b);
        Console.WriteLine(c);
        Console.WriteLine(d);
        Console.WriteLine(e);
        Console.WriteLine(f);
        Console.WriteLine(g);
        Console.WriteLine(i);
        Console.WriteLine(Program.MaxByte);
        Console.WriteLine(Program.MinSbyte);

        byte[] bytes = new byte[] { 0, 128, 255 };
        int sum = 0;
        foreach (byte v in bytes) { sum = sum + (int)v; }
        Console.WriteLine(sum);
    }
}
