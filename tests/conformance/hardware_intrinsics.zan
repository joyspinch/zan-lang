using System;
using System.IO;
using System.Numerics;
using System.Runtime.Intrinsics;
using System.Security.Cryptography;

class Program {
    static void Main() {
        // PopCount
        Console.WriteLine(BitOperations.PopCount(0));
        Console.WriteLine(BitOperations.PopCount(7));
        Console.WriteLine(BitOperations.PopCount(-1));
        long v64 = 0x123456789ABCDEF0;
        Console.WriteLine(BitOperations.PopCount(v64));

        // LeadingZeroCount
        Console.WriteLine(BitOperations.LeadingZeroCount(0));
        Console.WriteLine(BitOperations.LeadingZeroCount(1));
        Console.WriteLine(BitOperations.LeadingZeroCount(-2147483648));
        Console.WriteLine(BitOperations.LeadingZeroCount(0L));
        Console.WriteLine(BitOperations.LeadingZeroCount(1L));

        // TrailingZeroCount
        Console.WriteLine(BitOperations.TrailingZeroCount(0));
        Console.WriteLine(BitOperations.TrailingZeroCount(1));
        Console.WriteLine(BitOperations.TrailingZeroCount(8));
        Console.WriteLine(BitOperations.TrailingZeroCount(0L));
        Console.WriteLine(BitOperations.TrailingZeroCount(16L));

        // RotateLeft / RotateRight
        Console.WriteLine(BitOperations.RotateLeft(1, 1));
        Console.WriteLine(BitOperations.RotateRight(2, 1));
        long r64 = BitOperations.RotateLeft(1L, 4);
        Console.WriteLine(r64);
        Console.WriteLine(BitOperations.RotateRight(r64, 4));

        // ReverseEndianness
        int be = BitOperations.ReverseEndianness(0x12345678);
        Console.WriteLine(be == 0x78563412 ? "bswap32_ok" : "bswap32_fail");
        long be64 = BitOperations.ReverseEndianness(0x0123456789ABCDEFL);
        Console.WriteLine(be64 == -1167088121787636991L ? "bswap64_ok" : "bswap64_fail");

        // Log2
        Console.WriteLine(BitOperations.Log2(1));
        Console.WriteLine(BitOperations.Log2(2));
        Console.WriteLine(BitOperations.Log2(1024));
        Console.WriteLine(BitOperations.Log2(1025));

        // IsPow2
        Console.WriteLine(BitOperations.IsPow2(0) ? "1" : "0");
        Console.WriteLine(BitOperations.IsPow2(1) ? "1" : "0");
        Console.WriteLine(BitOperations.IsPow2(16) ? "1" : "0");
        Console.WriteLine(BitOperations.IsPow2(18) ? "1" : "0");

        // RoundUpToPowerOf2
        Console.WriteLine(BitOperations.RoundUpToPowerOf2(5));
        Console.WriteLine(BitOperations.RoundUpToPowerOf2(16));

        // 核心契约与语义定义。
        bool hasPopcnt = Cpu.HasPopcnt;
        bool hasSse42 = Cpu.HasSse42;
        Console.WriteLine("cpu_probed");

        // 核心契约与执行状态转移规范。
        byte[] testBytes = new byte[9];
        testBytes[0] = (byte)49;
        testBytes[1] = (byte)50;
        testBytes[2] = (byte)51;
        testBytes[3] = (byte)52;
        testBytes[4] = (byte)53;
        testBytes[5] = (byte)54;
        testBytes[6] = (byte)55;
        testBytes[7] = (byte)56;
        testBytes[8] = (byte)57;

        int crcZan = Crc32C.Compute(testBytes);
        nint mem = NativeMemory.Alloc(9);
        NativeMemory.PutString(mem, 0, "123456789", 9);
        int crcNm = (int)NativeMemory.Crc32C(mem, 9);
        NativeMemory.Free(mem);

        Console.WriteLine((crcZan == -486108541 && crcNm == -486108541) ? "crc32c_ok" : "crc32c_fail");

        // Bits
        Console.WriteLine(Bits.Rotl32(1, 4));
        Console.WriteLine(Bits.Rotr32(16, 4));
        Console.WriteLine(Bits.Rotr64(16L, 4));
    }
}
