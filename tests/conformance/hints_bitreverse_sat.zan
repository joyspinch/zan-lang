using System;
using System.Numerics;

struct Pair {
    public int A;
    public int B;
}

class Program {
    [NoAlloc]
    static int SafeDivByPow2(int x) {
        Hint.Assume(x >= 0);
        if (x < 0) {
            Hint.Unreachable();
        }
        return x / 4;
    }

    [NoAlloc]
    static void MaybeTrap(bool trigger) {
        if (Hint.Unlikely(trigger)) {
            Hint.Trap();
        }
    }

    [NoAlloc]
    static long RunKernel() {
        MaybeTrap(false);
        int q = SafeDivByPow2(Hint.BlackBox<int>(48)); // 12
        double d = Hint.BlackBox(3.5);
        Pair p = new Pair();
        p.A = 7;
        p.B = 9;
        Pair pb = Hint.BlackBox(p);

        uint br32 = BitOperations.BitReverse(0x80000001u); // 0x80000001u
        uint br32b = BitOperations.BitReverse(0xF0000000u); // 0x0000000Fu = 15
        ulong br64 = BitOperations.BitReverse(0x8000000000000000ul); // 1ul

        int sa_ov = BitOperations.SaturatingAdd(2147483640, 100);   // 2147483647
        int sa_un = BitOperations.SaturatingAdd(-2147483640, -100); // -2147483648
        uint ua_ov = BitOperations.SaturatingAdd(4294967290u, 100u); // 4294967295u
        uint us_un = BitOperations.SaturatingSub(5u, 100u);          // 0u
        long ls_ov = BitOperations.SaturatingAdd(9223372036854775800L, 100L);
        ulong lus_un = BitOperations.SaturatingSub(10ul, 999ul);

        int ok = (q == 12 && d == 3.5 && pb.A == 7 && pb.B == 9 &&
                  br32 == 0x80000001u && br32b == 15u && br64 == 1ul &&
                  sa_ov == 2147483647 && sa_un == -2147483648 &&
                  ua_ov == 4294967295u && us_un == 0u &&
                  ls_ov == 9223372036854775807L && lus_un == 0ul) ? 1 : 0;
        return (long)ok * 1000L + (long)q + (long)br32b;
    }

    static int Main() {
        long r = RunKernel();
        Console.WriteLine($"r={r}");
        return 0;
    }
}
