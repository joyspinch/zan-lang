// A412 回归锁：字符串字面量（immortal 静态对象）存进 object 槽时，
// 通用引用计数必须识别哨兵计数并跳过——不能把静态对象当堆对象去加/减计数。
// 静态对象在只读段，写它的计数头就是访问冲突（0xC0000005）。
// 反向也要锁：堆上字符串与类实例走 object 槽时仍按正常引用计数。
using System;

class Box {
    public int V;
}

class Program {
    static int Main() {
        int fails = 0;

        // ① 字面量存进 object 槽：is / 强制转换都正常，程序不崩。
        object o = "lit";
        if (o is string s) {
            if (s != "lit") { fails++; Console.WriteLine("F1 " + s); }
        } else {
            fails++; Console.WriteLine("F1b");
        }
        object boxed = (object)"cast";
        if ((string)boxed != "cast") { fails++; Console.WriteLine("F2"); }

        // ② 反复存入/取出：哨兵判定要稳定，不是只第一次侥幸不写。
        for (int i = 0; i < 3; i = i + 1) {
            object t = "loop";
            if ((string)t != "loop") { fails++; Console.WriteLine("F3 " + Convert.ToString(i)); }
        }

        // ③ 堆上的字符串（拼接产生）进 object 槽：仍是正常引用计数对象。
        string cat = "a" + "b";
        object h = cat;
        if ((string)h != "ab") { fails++; Console.WriteLine("F4"); }

        // ④ 类实例进 object 槽：类型测试与字段访问不受影响。
        Box bx = new Box();
        bx.V = 7;
        object ob = bx;
        if (ob is Box bb) {
            if (bb.V != 7) { fails++; Console.WriteLine("F5 " + Convert.ToString(bb.V)); }
        } else {
            fails++; Console.WriteLine("F5b");
        }

        Console.WriteLine("failures=" + Convert.ToString(fails));
        return fails;
    }
}
