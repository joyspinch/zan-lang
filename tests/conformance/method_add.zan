// 核心契约与语义定义。
using System;

namespace Conf;

class Counter {
    public int total;
    public void Add(int x) { total = total + x; }
}

class Program {
    static void Main() {
        var c = new Counter();
        c.total = 0;
        c.Add(10);
        c.Add(32);
        Console.WriteLine(c.total);

        var xs = new List<int>();
        xs.Add(5);
        xs.Add(7);
        Console.WriteLine(xs.Count);
        Console.WriteLine(xs[0] + xs[1]);
    }
}
