// Conformance: a qualified mention (`Gui.App`) must still reach the stdlib
// type even when the user program shadows the simple name with its own
// `class App` -- the pull-in's shadow carve-out only covers unqualified use.
//
// The assertion must be able to TELL THE TWO APART. An earlier version only
// wrote `Gui.App a = null; Console.WriteLine(a == null);` -- `a == null` is
// true for a null of any reference type, so a build that silently rebound
// `Gui.App` to the user's `class App` printed the same `true` and the case
// passed while the escape was broken. Calling a stdlib-only member is
// discriminating: `Gui.App.ISqrt` exists on the stdlib class and cannot exist
// on the user's, so a misbinding fails to compile instead of printing `true`.
using System;
using Gui;

class App {
    static string Tag() => "user-app";

    static int Main() {
        // The user's own App, reached by the bare (shadowed) name.
        Console.WriteLine(App.Tag());
        // The stdlib App, reached only through the qualified escape.
        Console.WriteLine(Gui.App.ISqrt(9));
        return 0;
    }
}
