using System;
using System.IO;
using System.Buffers;

namespace Conf;

class Prog {
    static void Main() {
        // 1. ArrayPool 租借、清空与归还复用
        ArrayPool pool = ArrayPool.Shared;
        byte[] buf = pool.Rent(100);
        Console.WriteLine("rented-len-ge-100: " + (buf.Length >= 100 ? "1" : "0"));
        Console.WriteLine("rented-len: " + Convert.ToString(buf.Length));
        buf[0] = (byte)77;
        pool.Return(buf, true);

        byte[] buf2 = pool.Rent(100);
        Console.WriteLine("re-rented-cleared: " + (((int)buf2[0]) == 0 ? "1" : "0"));
        pool.Return(buf2, false);

        // 2. MemoryStream 构造与写入
        MemoryStream ms = new MemoryStream();
        Console.WriteLine("ms-can-read: " + (ms.CanRead() ? "1" : "0"));
        Console.WriteLine("ms-can-write: " + (ms.CanWrite() ? "1" : "0"));
        Console.WriteLine("ms-can-seek: " + (ms.CanSeek() ? "1" : "0"));

        byte[] payload = new byte[5];
        payload[0] = (byte)72; // H
        payload[1] = (byte)69; // E
        payload[2] = (byte)76; // L
        payload[3] = (byte)76; // L
        payload[4] = (byte)79; // O
        ms.WriteBytes(payload, 0, 5);

        Console.WriteLine("ms-len: " + Convert.ToString(ms.Length()));
        Console.WriteLine("ms-pos: " + Convert.ToString(ms.Position()));
        Console.WriteLine("ms-str: " + ms.ToStr());

        // 3. Seek 回到起始并读取
        ms.Seek(0, 0);
        Console.WriteLine("ms-seek-0: " + Convert.ToString(ms.Position()));

        byte[] readBack = new byte[5];
        int bytesRead = ms.ReadBytes(readBack, 0, 5);
        Console.WriteLine("ms-read-count: " + Convert.ToString(bytesRead));
        Console.WriteLine("ms-r0: " + Convert.ToString((int)readBack[0]));
        Console.WriteLine("ms-r4: " + Convert.ToString((int)readBack[4]));

        // 4. ToArray 导出
        byte[] all = ms.ToArray();
        Console.WriteLine("ms-to-array-len: " + Convert.ToString(all.Length));

        ms.Close();
        Console.WriteLine("ms-closed-can-read: " + (ms.CanRead() ? "1" : "0"));

        Console.WriteLine("p8-all-passed: 1");
    }
}
