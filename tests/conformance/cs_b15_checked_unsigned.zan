// C#-compat: checked/unchecked on unsigned arithmetic. `checked` traps ulong
// add/sub wrap and uint add/sub/mul outside the uint32 range (B-ID113);
// `unchecked` pins the wrapping semantics; uint/uint division is unsigned.
class Program {
    static void Main() {
        ulong u = 18446744073709551615;
        ulong z = 0;
        ulong r1 = checked(u + 1);      // trap, wraps to 0
        Console.WriteLine(r1);
        ulong r2 = checked(z - 1);      // trap, wraps to MaxValue
        Console.WriteLine(r2);
        ulong r3 = unchecked(u + 1);    // silent wrap, 0
        Console.WriteLine(r3);
        uint m = 4294967295;
        uint r4 = checked(m + 1);       // trap, wraps to 0
        Console.WriteLine(r4);
        uint r5 = checked(m - 1);       // in-range, silent
        Console.WriteLine(r5);
        uint r6 = checked(m * 2);       // trap, wraps to 4294967294
        Console.WriteLine(r6);
        uint r7 = unchecked(m + 1);     // silent wrap, 0
        Console.WriteLine(r7);
        uint a = 3221225472;
        Console.WriteLine(a / 4);       // unsigned division
        int x = 2147483647;
        int s1 = checked(x + 1);        // signed trap unchanged
        Console.WriteLine(s1);
        Console.WriteLine(checked(1 + 2));
    }
}
