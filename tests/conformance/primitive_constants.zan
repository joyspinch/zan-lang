using System;

/* Compiler-lowered constants on the primitive types (`int.MaxValue`,
 * `double.NaN`, ...). These used to lower to 0 -- the builtin scalar types
 * have no class symbol to hang a static field off, so member access on them
 * fell through to a silent zero (and the checker's scalar-receiver guard even
 * rejected them as typos). */
class Program {
    static void Main() {
        Console.WriteLine(int.MaxValue);
        Console.WriteLine(int.MinValue);
        Console.WriteLine(uint.MaxValue);
        Console.WriteLine(long.MaxValue);
        Console.WriteLine(long.MinValue);
        Console.WriteLine(ulong.MaxValue);
        Console.WriteLine(short.MaxValue);
        Console.WriteLine(byte.MaxValue);
        Console.WriteLine(sbyte.MinValue);
        Console.WriteLine(char.MaxValue);
        Console.WriteLine(double.MaxValue);
        Console.WriteLine(double.MinValue);
        Console.WriteLine(double.NaN);
        Console.WriteLine(double.PositiveInfinity);
        Console.WriteLine(double.NegativeInfinity);
        Console.WriteLine(float.Epsilon);
    }
}
