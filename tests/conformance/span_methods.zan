// Conformance test for array/string/span AsSpan and Slice operations in both compilers.
using System;

class Program {
    static int Main() {
        byte[] b = new byte[8];
        Span<byte> sp = b.AsSpan();
        sp[0] = 42;
        sp[1] = 99;
        Console.WriteLine(b[0] + " " + b[1]);
        Span<byte> sl = sp.Slice(1, 2);
        Console.WriteLine(sl[0]);
        string s = "hello";
        ReadOnlySpan<char> r = s.AsSpan(1, 3);
        Console.WriteLine(r[0]);
        ReadOnlySpan<char> rsl = r.Slice(1, 2);
        Console.WriteLine(rsl[0]);
        return 0;
    }
}
