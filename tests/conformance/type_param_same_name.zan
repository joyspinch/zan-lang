using System;

// A453：类型参数按名字等价，保留 binder 根作用域的 fallback 注册。
// 声明的类/方法类型参数必须遮蔽同名普通类型，方法类型参数遮蔽类参数。
// 开放签名和方法体保留声明绑定，再按接收者/方法实参具体化；不能在调用者
// 的根作用域重新把 T 绑定成普通 class T，也不能按类型参数对象身份比较。

// Unrelated concrete types must not replace declaration type parameters when
// checker resolves constructor parameters, returns, or method-body type refs.
class T { }
class U { }

class OpenList<T> {
    List<T> items;
    public OpenList(List<T> items) { this.items = items; }
    public List<T> Echo() {
        List<T> local = this.items;
        return local;
    }
    public List<U> Method<U>(List<U> items) {
        List<U> local = items;
        return local;
    }
    public List<T> Shadow<T>(List<T> items) {
        List<T> local = items;
        return local;
    }
}

class HolderA<T> {
    T val;
    public HolderA(T v) { val = v; }
    public T Get() { return val; }
}

class HolderB<T> {
    T[] items = new T[2];
    public T At(int i) { return items[i]; }
    public void Set(int i, T v) { items[i] = v; }
}

class Store<U> {
    protected U item;
    public void Put(U v) { item = v; }
    public U Take() { return item; }
}

class MyList<T> : Store<T> {
    public void Seed(T v) { Put(v); }
}

class Box<T> {
    T field;
    public Box(T v) { field = v; }
    // 方法级 T 与类级 T 同名：方法自己的实参定型，不被类级顶掉
    public T Same<T>(T x) { return x; }
    // 方法级 T 出现在返回类型的泛型实参位置
    public List<T> Wrap<T>(T x) {
        List<T> l = new List<T>();
        l.Add(x);
        return l;
    }
    public T Field() { return field; }
}

class Dual {
    public T Pick<T>(T x) { return x; }
    public T Pick2<T>(T x, T y) { return y; }
    // 同类第二个方法级 T：与第一个方法共享按名字的解析槽位
    public T Echo<T>(T x) { return x; }
}

class Program {
    static void Main() {
        HolderA<string> a = new HolderA<string>("hi");
        Console.WriteLine(a.Get());
        HolderB<int> b = new HolderB<int>();
        b.Set(0, 41);
        b.Set(1, 42);
        Console.WriteLine(b.At(0) + b.At(1));

        MyList<string> l = new MyList<string>();
        l.Seed("seeded");
        Console.WriteLine(l.Take());

        Box<string> box = new Box<string>("F");
        Console.WriteLine(box.Same<int>(7));
        Console.WriteLine(box.Same<string>("s"));
        List<int> w = box.Wrap<int>(9);
        Console.WriteLine(w.Count);
        Console.WriteLine(box.Field());

        List<string> names = new List<string>();
        names.Add("scope");
        OpenList<string> scoped = new OpenList<string>(names);
        List<string> echoed = scoped.Echo();
        List<int> method = scoped.Method<int>(w);
        List<int> shadowed = scoped.Shadow<int>(w);
        if (echoed[0] != "scope" || method[0] != 9 || shadowed[0] != 9) {
            throw new Exception("generic type parameter scope collision");
        }

        Dual d = new Dual();
        Console.WriteLine(d.Pick<string>("a"));
        Console.WriteLine(d.Pick2<int>(3, 4));
        Console.WriteLine(d.Echo<double>(2.5));
        Console.WriteLine(d.Echo<string>("z"));
    }
}
