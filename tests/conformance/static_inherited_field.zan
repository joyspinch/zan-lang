// 验证通过派生类访问继承的静态字段与属性时，统一定位到声明类的唯一定义存储
using System;

class Base {
    public static string Tag = "base_tag";
    public static int Counter = 10;
    public static string AutoProp { get; set; } = "base_prop";

    private static int _secret = 5;
    public static int CustomProp {
        get { return _secret * 2; }
        set { _secret = value; }
    }
}

class Derived : Base {
    public static void ModifyStatic() {
        Tag = "from_derived_stat";
        Counter = 20;
        AutoProp = "prop_from_derived_stat";
        CustomProp = 15;
    }

    public void ModifyInstance() {
        Tag = "from_derived_inst";
        Counter = 30;
        AutoProp = "prop_from_derived_inst";
        CustomProp = 25;
    }

    public void AssertInstance(string expectedTag, int expectedCounter, string expectedProp, int expectedCustom) {
        if (Tag != expectedTag) throw new Exception("Tag mismatch: " + Tag);
        if (Counter != expectedCounter) throw new Exception("Counter mismatch: " + Counter);
        if (AutoProp != expectedProp) throw new Exception("AutoProp mismatch: " + AutoProp);
        if (CustomProp != expectedCustom) throw new Exception("CustomProp mismatch: " + CustomProp);
    }

    public static void AssertStatic(string expectedTag, int expectedCounter, string expectedProp, int expectedCustom) {
        if (Tag != expectedTag) throw new Exception("Tag mismatch: " + Tag);
        if (Counter != expectedCounter) throw new Exception("Counter mismatch: " + Counter);
        if (AutoProp != expectedProp) throw new Exception("AutoProp mismatch: " + AutoProp);
        if (CustomProp != expectedCustom) throw new Exception("CustomProp mismatch: " + CustomProp);
    }
}

class GrandChild : Derived {
    public static void AssertGrandChild(string expectedTag, int expectedCounter, string expectedProp, int expectedCustom) {
        if (Tag != expectedTag) throw new Exception("GrandChild Tag mismatch: " + Tag);
        if (Counter != expectedCounter) throw new Exception("GrandChild Counter mismatch: " + Counter);
        if (AutoProp != expectedProp) throw new Exception("GrandChild AutoProp mismatch: " + AutoProp);
        if (CustomProp != expectedCustom) throw new Exception("GrandChild CustomProp mismatch: " + CustomProp);
    }
}

class Program {
    static void Main() {
        // 核心契约与语义定义。
        Derived.AssertStatic("base_tag", 10, "base_prop", 10);
        if (Derived.Tag != "base_tag") throw new Exception("Derived.Tag qualified mismatch");
        if (Derived.AutoProp != "base_prop") throw new Exception("Derived.AutoProp qualified mismatch");
        if (Derived.CustomProp != 10) throw new Exception("Derived.CustomProp qualified mismatch");

        // 核心契约与语义定义。
        Derived.ModifyStatic();
        Derived.AssertStatic("from_derived_stat", 20, "prop_from_derived_stat", 30);
        if (Base.Tag != "from_derived_stat") throw new Exception("Base.Tag after stat mismatch");

        // 核心契约与语义定义。
        var d = new Derived();
        d.ModifyInstance();
        d.AssertInstance("from_derived_inst", 30, "prop_from_derived_inst", 50);
        if (Base.Tag != "from_derived_inst") throw new Exception("Base.Tag after inst mismatch");

        // 核心契约与执行状态转移规范。
        GrandChild.AssertGrandChild("from_derived_inst", 30, "prop_from_derived_inst", 50);

        // 核心契约与语义定义。
        Derived.Tag = "from_dot_derived";
        Derived.AutoProp = "prop_from_dot";
        Derived.CustomProp = 40;
        if (Base.Tag != "from_dot_derived") throw new Exception("Base.Tag after dot mismatch");
        if (Base.AutoProp != "prop_from_dot") throw new Exception("Base.AutoProp after dot mismatch");
        if (Base.CustomProp != 80) throw new Exception("Base.CustomProp after dot mismatch");

        Console.WriteLine("OK");
    }
}
