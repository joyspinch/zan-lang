// 工具调用（Tool calling）——模型与工具之间的往返。
//
// 覆盖：
// - **模型直接给答案**：不调工具，一轮结束。
// - **模型请求调工具**：执行工具 → 结果**按调用 id 原样带回** → 再问
//   一次 → 拿到最终答案。
// - **一轮多个工具调用**：三个都要执行、三个都要回传（不能只处理第
//   一个）。
// - **工具失败要回给模型**，不是抛异常：模型看到错误能自己纠正。
// - **不存在的工具** → 回错误结果，不是崩。
// - **坏参数 JSON** → 回错误结果。
// - **循环上限**：模型反复调工具时停下（不能无限烧钱），把已得结果交
//   给调用方。
// - **工具声明要发给服务方**（模型不知道你的函数，得告诉它）。
// - **事件**：每一步都能看见（调了什么、返回了什么、是不是错的）。
//
// 用例**在本进程内起一个真的 HTTP 服务**当假 AI 端点，用**脚本化**的
// 行为驱动整个循环。
using System;
using System.Ai;
using System.IO;
using System.Json;
using System.Net.Http;

namespace Conf;

class Prog {
    // 假端点的端口。
    static int PORT = 19895;

    // 第几次请求（用来脚本化模型的反应）。
    static int callIndex;

    // 模型这次要调的工具（名字 → 参数）。
    static List<List<AiToolCall>> script;

    // 模型这次直接说的话（不调工具时）。
    static string scriptText;

    // 收到的请求里带了几条消息（用来验历史被带上了）。
    static int lastMessageCount;

    // 收到的 tools 声明条数。
    static int lastToolCount;

    // 收到的最后一条 tool 消息的 tool_call_id。
    static string lastToolCallId;

    // 收到的最后一条 tool 消息的内容。
    static string lastToolContent;

    static int Main() {
        try {
            return Prog.Run();
        } catch (Exception e) {
            Console.WriteLine("threw: " + e.ToString());
            return 1;
        }
    }

    // 假端点。
    static async HttpResponse Handle(HttpRequest req) {
        HttpResponse res = new HttpResponse();
        res.statusCode = 200;
        res.statusText = "OK";
        res.contentType = "application/json";
        res.keepAlive = true;
        if (req.path.IndexOf("/embeddings") >= 0) {
            res.body = Prog.EmbedBody();
            return res;
        }
        res.body = Prog.ChatBody(req.body);
        return res;
    }

    static string EmbedBody() {
        return "{\"data\":[{\"index\":0,\"embedding\":[1.0,0.0]}],"
            + "\"usage\":{\"prompt_tokens\":1,\"total_tokens\":1}}";
    }

    // 脚本化的补全响应。
    static string ChatBody(string body) {
        JsonValue root = JsonValue.Parse(body);
        JsonValue msgs = root.Get("messages");
        int n = msgs == null ? 0 : msgs.Count();
        Prog.lastMessageCount = n;
        JsonValue tools = root.Get("tools");
        Prog.lastToolCount = 0;
        if (tools != null && tools.IsArray()) { Prog.lastToolCount = tools.Count(); }
        // 找最后一条 tool 消息（验结果被带回去了）。
        Prog.lastToolCallId = "";
        Prog.lastToolContent = "";
        for (int i = 0; i < n; i = i + 1) {
            JsonValue m = msgs.At(i);
            if (m.Str("role", "") == "tool") {
                Prog.lastToolCallId = m.Str("tool_call_id", "");
                Prog.lastToolContent = m.Str("content", "");
            }
        }

        int idx = Prog.callIndex;
        Prog.callIndex = Prog.callIndex + 1;
        if (idx < Prog.script.Count) {
            // 这一轮要调工具。
            StringBuilder sb = new StringBuilder();
            sb.Append("{\"choices\":[{\"finish_reason\":\"tool_calls\",\"message\":{");
            sb.Append("\"role\":\"assistant\",\"content\":null,\"tool_calls\":[");
            for (int i = 0; i < Prog.script[idx].Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                AiToolCall c = Prog.script[idx][i];
                sb.Append("{\"id\":\"");
                sb.Append(c.id);
                sb.Append("\",\"type\":\"function\",\"function\":{\"name\":\"");
                sb.Append(c.name);
                sb.Append("\",\"arguments\":\"");
                sb.Append(Prog.Escape(c.arguments));
                sb.Append("\"}}");
            }
            sb.Append("]}}]}");
            return sb.ToString();
        }
        // 最后一轮：直接给答案。
        return "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{"
            + "\"role\":\"assistant\",\"content\":\""
            + Prog.Escape(Prog.scriptText) + "\"}}]}";
    }

    static string Escape(string s) {
        if (s == null) { return ""; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.Length; i = i + 1) {
            string c = s.Substring(i, 1);
            if (c == "\\") { sb.Append("\\\\"); }
            else if (c == "\"") { sb.Append("\\\""); }
            else if (c == "\n") { sb.Append("\\n"); }
            else if (c == "\r") { sb.Append("\\r"); }
            else { sb.Append(c); }
        }
        return sb.ToString();
    }

    // 把一条调用包成"一轮"（一轮 = 一组调用）。
    static List<AiToolCall> One(AiToolCall call) {
        List<AiToolCall> one = new List<AiToolCall>();
        one.Add(call);
        return one;
    }

    // 造一条"模型要调的工具"脚本。
    static AiToolCall Call(string id, string name, string args) {
        return new AiToolCall(id, name, args);
    }

    static AiClient MakeClient() {
        AiConfig cfg = new AiConfig("http://127.0.0.1:" + Convert.ToString(Prog.PORT),
            "fake-key", "fake-model");
        cfg.connectTimeoutMs = 3000;
        cfg.readTimeoutMs = 5000;
        cfg.totalTimeoutMs = 8000;
        cfg.maxAttempts = 1;
        return new AiClient(cfg);
    }

    // 造一个声明了"查订单"工具的注册表。
    static ToolRegistry MakeRegistry() {
        ToolRegistry reg = new ToolRegistry();
        JsonValue params = JsonValue.NewObject();
        params.PutStr("type", "object");
        JsonValue props = JsonValue.NewObject();
        JsonValue orderId = JsonValue.NewObject();
        orderId.PutStr("type", "string");
        orderId.PutStr("description", "订单号");
        props.Put("order_id", orderId);
        params.Put("properties", props);
        JsonValue required = JsonValue.NewArray();
        required.AppendStr("order_id");
        params.Put("required", required);

        AiTool tool = new AiTool("查订单", "按订单号查订单状态与物流进度", params);
        // Zan 没有 lambda——委托要指向一个具名方法。
        reg.Register(tool, ToolEventLog.LookupOrder);

        // **同步**工具：大多数工具不碰 IO，不该被迫写成 async。
        // 同步实现走另一个注册入口（同名重载会先选中异步那版）。
        JsonValue sprops = JsonValue.NewObject();
        JsonValue city = JsonValue.NewObject();
        city.PutStr("type", "string");
        city.PutStr("description", "城市名");
        sprops.Put("city", city);
        JsonValue sparams = JsonValue.NewObject();
        sparams.PutStr("type", "object");
        sparams.Put("properties", sprops);
        AiTool syncTool = new AiTool("查天气2", "按城市查当前天气", sparams);
        reg.RegisterSync(syncTool, ToolEventLog.LookupWeather);
        return reg;
    }

    static int Run() {
        int bad = 0;
        Directory.CreateDirectory("_scratch");

        HttpServer ai = new HttpServer("127.0.0.1", PORT);
        ai.OnRequest(Prog.Handle);
        Task.Spawn(ai.Start());
        await Task.Delay(100);

        // ---- 1. 模型直接给答案（不调工具）----
        {
            AiClient client = Prog.MakeClient();
            ToolEventLog.calls = 0;
            ToolEventLog.lastOrderId = "";
            ToolRegistry reg = Prog.MakeRegistry();
            ToolAgent agent = new ToolAgent(client, reg);
            List<AiMessage> msgs = new List<AiMessage>();
            msgs.Add(AiMessage.User("你好"));
            Prog.callIndex = 0;
            Prog.script = new List<List<AiToolCall>>();
            Prog.scriptText = "你好，有什么可以帮您";
            List<AiMessage> outp = await agent.Run(msgs);
            if (outp == null) { bad = bad + 1; }
            else {
                if (outp.Count != 2) {
                    Console.WriteLine("t1 count=" + Convert.ToString(outp.Count));
                    bad = bad + 1;
                }
                if (outp.Count > 1 && outp[1].content != "你好，有什么可以帮您") { bad = bad + 1; }
                if (ToolEventLog.calls != 0) { bad = bad + 1; }
                if (agent.Events().Count != 1) { bad = bad + 1; }
                if (agent.Events()[0].kind != "final") { bad = bad + 1; }
            }
            // 工具声明要发给服务方（模型不知道你的函数）。
            if (Prog.lastToolCount != 2) {
                Console.WriteLine("tools sent=" + Convert.ToString(Prog.lastToolCount));
                bad = bad + 1;
            }
            client.Close();
        }

        // ---- 2. 模型请求调工具：执行 → 回传 id → 再问 → 拿答案 ----
        {
            AiClient client = Prog.MakeClient();
            ToolEventLog.calls = 0;
            ToolEventLog.lastOrderId = "";
            ToolRegistry reg = Prog.MakeRegistry();
            ToolAgent agent = new ToolAgent(client, reg);
            List<AiMessage> msgs = new List<AiMessage>();
            msgs.Add(AiMessage.User("查一下订单 A100"));
            Prog.callIndex = 0;
            Prog.script = new List<List<AiToolCall>>();
            // 第一轮：调工具；第二轮：给答案。
            Prog.script.Add(Prog.One(Prog.Call("call_1", "查订单", "{\"order_id\":\"A100\"}")));
            Prog.scriptText = "订单 A100 正在派送中";
            List<AiMessage> outp = await agent.Run(msgs);
            if (outp == null) { bad = bad + 1; }
            else {
                // 消息序列：user → assistant(带 tool_calls) → tool → assistant。
                if (outp.Count != 4) {
                    Console.WriteLine("msgs=" + Convert.ToString(outp.Count));
                    bad = bad + 1;
                }
                if (outp[1].toolCalls.Count != 1) { bad = bad + 1; }
                if (outp[1].toolCalls[0].id != "call_1") { bad = bad + 1; }
                if (!outp[2].IsTool()) { bad = bad + 1; }
                // **id 原样带回**。
                if (outp[2].toolCallId != "call_1") {
                    Console.WriteLine("call id=" + outp[2].toolCallId);
                    bad = bad + 1;
                }
                if (outp[3].content != "订单 A100 正在派送中") { bad = bad + 1; }
                // 工具确实被执行了，且参数被正确传进去。
                if (ToolEventLog.calls != 1) { bad = bad + 1; }
                if (ToolEventLog.lastOrderId != "A100") {
                    Console.WriteLine("order=" + ToolEventLog.lastOrderId);
                    bad = bad + 1;
                }
                // 服务方在第二轮收到了 tool 消息。
                if (Prog.lastToolCallId != "call_1") { bad = bad + 1; }
                Console.WriteLine("tool loop msgs=" + Convert.ToString(outp.Count)
                    + " callid=" + Prog.lastToolCallId);
            }
            // 事件：一条 tool + 一条 final。
            if (agent.Events().Count != 2) { bad = bad + 1; }
            if (agent.Events()[0].kind != "tool") { bad = bad + 1; }
            if (agent.Events()[0].name != "查订单") { bad = bad + 1; }
            if (agent.Events()[1].kind != "final") { bad = bad + 1; }
            client.Close();
        }

        // ---- 2b. **同步**工具：不碰 IO 的工具不该被迫写成 async ----
        {
            AiClient client = Prog.MakeClient();
            ToolEventLog.calls = 0;
            ToolEventLog.lastCity = "";
            ToolRegistry reg = Prog.MakeRegistry();
            ToolAgent agent = new ToolAgent(client, reg);
            List<AiMessage> msgs = new List<AiMessage>();
            msgs.Add(AiMessage.User("北京天气怎么样"));
            Prog.callIndex = 0;
            Prog.script = new List<List<AiToolCall>>();
            Prog.script.Add(Prog.One(Prog.Call("w1", "查天气2", "{\"city\":\"北京\"}")));
            Prog.scriptText = "北京 晴，25 度";
            List<AiMessage> outp = await agent.Run(msgs);
            if (outp == null) { bad = bad + 1; }
            else {
                // 同步工具的结果照样按 id 回传。
                if (outp[2].toolCallId != "w1") { bad = bad + 1; }
                if (outp[3].content != "北京 晴，25 度") { bad = bad + 1; }
                // 同步实现真的跑到了。
                if (ToolEventLog.calls != 1) { bad = bad + 1; }
                if (ToolEventLog.lastCity != "北京") {
                    Console.WriteLine("city=" + ToolEventLog.lastCity);
                    bad = bad + 1;
                }
                Console.WriteLine("sync tool city=" + ToolEventLog.lastCity);
            }
            client.Close();
        }

        // ---- 3. 一轮多个工具调用：三个都要执行、三个都要回传 ----
        {
            AiClient client = Prog.MakeClient();
            ToolEventLog.calls = 0;
            ToolEventLog.lastOrderId = "";
            ToolRegistry reg = Prog.MakeRegistry();
            ToolAgent agent = new ToolAgent(client, reg);
            List<AiMessage> msgs = new List<AiMessage>();
            msgs.Add(AiMessage.User("查三个订单"));
            Prog.callIndex = 0;
            Prog.script = new List<List<AiToolCall>>();
            List<AiToolCall> many = new List<AiToolCall>();
            many.Add(Prog.Call("c1", "查订单", "{\"order_id\":\"A1\"}"));
            many.Add(Prog.Call("c2", "查订单", "{\"order_id\":\"A2\"}"));
            many.Add(Prog.Call("c3", "查订单", "{\"order_id\":\"A3\"}"));
            Prog.script.Add(many);
            Prog.scriptText = "三个订单都查完了";
            List<AiMessage> outp = await agent.Run(msgs);
            if (outp == null) { bad = bad + 1; }
            else {
                // user → assistant → 3 个 tool → assistant = 6 条。
                if (outp.Count != 6) {
                    Console.WriteLine("many msgs=" + Convert.ToString(outp.Count));
                    bad = bad + 1;
                }
                if (outp[1].toolCalls.Count != 3) { bad = bad + 1; }
                // 三个 tool 消息，id 分别是 c1/c2/c3。
                if (outp[2].toolCallId != "c1") { bad = bad + 1; }
                if (outp[3].toolCallId != "c2") { bad = bad + 1; }
                if (outp[4].toolCallId != "c3") { bad = bad + 1; }
                if (ToolEventLog.calls != 3) { bad = bad + 1; }
                Console.WriteLine("many tools=" + Convert.ToString(ToolEventLog.calls));
            }
            client.Close();
        }

        // ---- 4. 工具失败要回给模型，不是抛异常 ----
        {
            AiClient client = Prog.MakeClient();
            ToolRegistry reg = new ToolRegistry();
            JsonValue params = JsonValue.NewObject();
            params.PutStr("type", "object");
            reg.Register(new AiTool("会炸的工具", "总是失败", params),
                FailingFn);
            ToolAgent agent = new ToolAgent(client, reg);
            List<AiMessage> msgs = new List<AiMessage>();
            msgs.Add(AiMessage.User("调它"));
            Prog.callIndex = 0;
            Prog.script = new List<List<AiToolCall>>();
            Prog.script.Add(Prog.One(Prog.Call("c1", "会炸的工具", "{}")));
            Prog.scriptText = "那个工具失败了";
            List<AiMessage> outp = await agent.Run(msgs);
            if (outp == null) {
                // 工具失败**不该**让对话失败。
                Console.WriteLine("tool failure killed the loop: " + agent.lastError);
                bad = bad + 1;
            } else {
                if (outp.Count != 4) { bad = bad + 1; }
                // 错误结果回给了模型。
                if (outp[2].content.IndexOf("失败") < 0) {
                    Console.WriteLine("err content=" + outp[2].content);
                    bad = bad + 1;
                }
                // 事件里标出是错的。
                if (!agent.Events()[0].isError) { bad = bad + 1; }
            }
            client.Close();
        }

        // ---- 5. 不存在的工具 → 回错误结果，不是崩 ----
        {
            AiClient client = Prog.MakeClient();
            ToolEventLog.calls = 0;
            ToolEventLog.lastOrderId = "";
            ToolRegistry reg = Prog.MakeRegistry();
            ToolAgent agent = new ToolAgent(client, reg);
            List<AiMessage> msgs = new List<AiMessage>();
            msgs.Add(AiMessage.User("调一个不存在的"));
            Prog.callIndex = 0;
            Prog.script = new List<List<AiToolCall>>();
            Prog.script.Add(Prog.One(Prog.Call("c1", "查天气", "{}")));
            Prog.scriptText = "没有这个工具";
            List<AiMessage> outp = await agent.Run(msgs);
            if (outp == null) { bad = bad + 1; }
            else {
                if (outp.Count != 4) { bad = bad + 1; }
                if (outp[2].content.IndexOf("没有这个工具") < 0) { bad = bad + 1; }
                if (!agent.Events()[0].isError) { bad = bad + 1; }
            }
            client.Close();
        }

        // ---- 6. 坏参数 JSON → 回错误结果 ----
        {
            AiClient client = Prog.MakeClient();
            ToolEventLog.calls = 0;
            ToolEventLog.lastOrderId = "";
            ToolRegistry reg = Prog.MakeRegistry();
            ToolAgent agent = new ToolAgent(client, reg);
            List<AiMessage> msgs = new List<AiMessage>();
            msgs.Add(AiMessage.User("参数坏了"));
            Prog.callIndex = 0;
            Prog.script = new List<List<AiToolCall>>();
            Prog.script.Add(Prog.One(Prog.Call("c1", "查订单", "{不是 JSON")));
            Prog.scriptText = "参数坏了";
            List<AiMessage> outp = await agent.Run(msgs);
            if (outp == null) { bad = bad + 1; }
            else {
                if (outp.Count != 4) { bad = bad + 1; }
                if (!agent.Events()[0].isError) { bad = bad + 1; }
            }
            client.Close();
        }

        // ---- 7. 循环上限：反复调工具时停下 ----
        {
            AiClient client = Prog.MakeClient();
            ToolEventLog.calls = 0;
            ToolEventLog.lastOrderId = "";
            ToolRegistry reg = Prog.MakeRegistry();
            reg.SetMaxCalls(3);
            ToolAgent agent = new ToolAgent(client, reg);
            List<AiMessage> msgs = new List<AiMessage>();
            msgs.Add(AiMessage.User("一直调"));
            Prog.callIndex = 0;
            Prog.script = new List<List<AiToolCall>>();
            // 脚本里连着 10 轮都调工具（模拟死循环）。
            for (int i = 0; i < 10; i = i + 1) {
                List<AiToolCall> one = new List<AiToolCall>();
                one.Add(Prog.Call("c" + Convert.ToString(i), "查订单",
                    "{\"order_id\":\"A\"}"));
                Prog.script.Add(one);
            }
            Prog.scriptText = "永远说不完";
            List<AiMessage> outp = await agent.Run(msgs);
            if (outp == null) { bad = bad + 1; }
            else {
                // 工具只被调了 3 次（上限）。
                if (ToolEventLog.calls != 3) {
                    Console.WriteLine("limit calls=" + Convert.ToString(ToolEventLog.calls));
                    bad = bad + 1;
                }
                if (agent.lastError.Length == 0) { bad = bad + 1; }
                // 事件最后一条是 limit。
                bool sawLimit = false;
                List<ToolEvent> evs = agent.Events();
                for (int i = 0; i < evs.Count; i = i + 1) {
                    if (evs[i].kind == "limit") { sawLimit = true; }
                }
                if (!sawLimit) { bad = bad + 1; }
                Console.WriteLine("limit calls=" + Convert.ToString(ToolEventLog.calls));
            }
            client.Close();
        }

        // ---- 7b. **结果版**工具：实现自己给出结果（失败带具体原因）----
        //
        // 前两版实现只能回字符串，"失败"只能用 null 表示，于是注册表只能
        // 给一句"工具执行失败：<名字>"的**泛化文案**——实现自己知道的
        // 具体原因（缺哪个参数）就丢了。模型看不到原因就只会编一个答案。
        {
            ToolRegistry reg = new ToolRegistry();
            JsonValue params = JsonValue.NewObject();
            params.PutStr("type", "object");
            reg.RegisterResult(new AiTool("查订单2", "带具体原因地失败", params),
                ResultFn);
            AiToolResult r = await reg.Call(new AiToolCall("c1", "查订单2", "{}"));
            string rid = "";
            string rerr = "";
            if (r == null) { bad = bad + 1; }
            else {
                // 标成错误，内容是**具体原因**（不是泛化文案）。
                if (!r.isError) { bad = bad + 1; }
                if (r.content != "缺少参数 order_id") { bad = bad + 1; }
                // 调用 id 由注册表补上（实现不知道调用 id）。
                if (r.id != "c1") { bad = bad + 1; }
                rid = r.id;
                rerr = reg.lastError;
                if (rerr != "缺少参数 order_id") { bad = bad + 1; }
            }
            // 成功的那一版：内容原样带回。
            reg.RegisterResult(new AiTool("查订单3", "成功", params), ResultFnOk);
            AiToolResult ok = await reg.Call(new AiToolCall("c2", "查订单3", "{}"));
            string oid = "";
            if (ok == null) { bad = bad + 1; }
            else {
                if (ok.isError) { bad = bad + 1; }
                if (ok.content != "订单 A100 正在派送中") { bad = bad + 1; }
                if (ok.id != "c2") { bad = bad + 1; }
                oid = ok.id;
            }
            Console.WriteLine("result tool id=" + rid + " err=" + rerr
                + " okid=" + oid);
        }

        // ---- 8. 解析：按 index 归位 + finish_reason 不保证有 ----
        {
            string raw = "{\"choices\":[{\"finish_reason\":\"tool_calls\","
                + "\"message\":{\"role\":\"assistant\",\"content\":null,"
                + "\"tool_calls\":["
                + "{\"id\":\"b\",\"type\":\"function\",\"function\":{\"name\":\"f2\","
                + "\"arguments\":\"{\\\"x\\\":2}\"}},"
                + "{\"id\":\"a\",\"type\":\"function\",\"function\":{\"name\":\"f1\","
                + "\"arguments\":\"{\\\"x\\\":1}\"}}]}}]}";
            AiToolTurn turn = AiClient.ParseToolTurn(raw);
            if (turn == null) { bad = bad + 1; }
            else {
                if (turn.toolCalls.Count != 2) { bad = bad + 1; }
                if (turn.toolCalls[0].name != "f2") { bad = bad + 1; }
                if (turn.toolCalls[1].name != "f1") { bad = bad + 1; }
                if (!turn.WantsTools()) { bad = bad + 1; }
                if (turn.finishReason != "tool_calls") { bad = bad + 1; }
            }
            // 没有 finish_reason 也要能判出"要调工具"（不能只看它）。
            string raw2 = "{\"choices\":[{\"message\":{\"role\":\"assistant\","
                + "\"tool_calls\":[{\"id\":\"a\",\"type\":\"function\","
                + "\"function\":{\"name\":\"f\",\"arguments\":\"{}\"}}]}}]}";
            AiToolTurn turn2 = AiClient.ParseToolTurn(raw2);
            if (turn2 == null) { bad = bad + 1; }
            else {
                if (!turn2.WantsTools()) { bad = bad + 1; }
                if (turn2.finishReason.Length != 0) { bad = bad + 1; }
            }
            // 坏 JSON → null。
            if (AiClient.ParseToolTurn("{不是 JSON") != null) { bad = bad + 1; }
        }

        ai.Stop();
        for (int w = 0; w < 20; w = w + 1) { await Task.Delay(10); }

        Console.WriteLine("ai-tools-ok: " + (bad == 0 ? 1 : 0));
        return bad == 0 ? 0 : 1;
    }

    // 一个总失败的工具实现。
    static async string FailingFn(JsonValue args) {
        return null;
    }

    // **结果版**实现：自己给出结果（带具体失败原因）。
    static async AiToolResult ResultFn(JsonValue args) {
        return AiToolResult.Error("", "缺少参数 order_id");
    }

    // **结果版**实现：成功。
    static async AiToolResult ResultFnOk(JsonValue args) {
        return AiToolResult.Ok("", "订单 A100 正在派送中");
    }
}

// 记录工具被调了几次、参数是什么。
class ToolEventLog {
    // 当前这次查询的订单号（静态——Zan 的委托要指向静态方法，
    // 没有闭包可用）。
    public static string lastOrderId;
    public static string lastCity;

    // 被调了几次。
    public static int calls;

    public ToolEventLog() {
        this.lastOrderId = "";
        this.calls = 0;
    }

    // **同步**工具的实现（不碰 IO）。
    public static string LookupWeather(JsonValue args) {
        ToolEventLog.calls = ToolEventLog.calls + 1;
        JsonValue c = args.Get("city");
        ToolEventLog.lastCity = c == null ? "" : c.AsString("");
        return ToolEventLog.lastCity + " 晴，25 度";
    }

    // "查订单"的实现（具名静态方法——Zan 没有 lambda）。
    public static async string LookupOrder(JsonValue args) {
        ToolEventLog.calls = ToolEventLog.calls + 1;
        JsonValue id = args.Get("order_id");
        ToolEventLog.lastOrderId = id == null ? "" : id.AsString("");
        return "订单 " + ToolEventLog.lastOrderId + " 正在派送中";
    }
}
