// A528：结构体构造函数写字段后抛异常，字段持有的引用必须被释放。
// 修复前：--check-leaks 报「2 object(s) leaked [List<int>]」——结构体没有
// 析构，类路径的"对象释放级联释放字段"在结构体上不存在；字段写入也未
// 注册进 EH 临时栈，展开器无从释放。修复后：emit_rc_store_field 的
// ctor 分支把字段槽推上 EH 临时栈（构造入口裸武装标记；正常返回由
// disarm 免释放回退移交所有权，抛出走 unwind 按字段类型释放）。
using System;
using System.Collections.Generic;

struct PairLate {
    List<int> first;
    List<int> second;
    PairLate(List<int> a, List<int> b, bool explode) {
        this.first = a;
        this.second = b;
        if (explode) { throw new Exception("boom"); }
    }
    int Total() {
        return first.Count + second.Count;
    }
}

class Prog {
    static List<int> Make() {
        List<int> l = new List<int>();
        l.Add(1);
        l.Add(2);
        return l;
    }

    static void Main() {
        int caught = 0;
        try {
            PairLate p = new PairLate(Make(), Make(), true);
        } catch (Exception e) {
            caught = 1;
        }
        Console.WriteLine("caught=" + Convert.ToString(caught));

        // 正常路径：构造完成后字段所有权移交调用方，数据可用
        PairLate q = new PairLate(Make(), Make(), false);
        Console.WriteLine("total=" + Convert.ToString(q.Total()));
        Console.WriteLine("arc-throw-struct-field-ok: 1");
    }
}
