// 核心契约与语义定义。
// 核心契约与执行状态转移规范。
using System;

class Box<T> {
    public T Value;
    public Box(T v) { Value = v; }
}

class Program {
    static Box<Box<int>> Make2() {
        return new Box<Box<int>>(new Box<int>(41));
    }
    static Box<Box<Box<int>>> Make3() {
        return new Box<Box<Box<int>>>(new Box<Box<int>>(new Box<int>(7)));
    }
    static Box<Box<Box<Box<int>>>> Make4() {
        return new Box<Box<Box<Box<int>>>>(
            new Box<Box<Box<int>>>(new Box<Box<int>>(new Box<int>(99))));
    }
    static T Unbox3<T>(Box<Box<Box<T>>> b) {
        return b.Value.Value.Value;
    }
    static int Main() {
        Console.WriteLine(Make2().Value.Value);
        Console.WriteLine(Make3().Value.Value.Value);
        Console.WriteLine(Make4().Value.Value.Value.Value);
        Box<Box<Box<string>>> bs = new Box<Box<Box<string>>>(
            new Box<Box<string>>(new Box<string>("deep")));
        Console.WriteLine(Unbox3(bs));
        int a = 64;
        Console.WriteLine((a >>> 3).ToString());
        return 0;
    }
}
