// System.ML.Ort smoke test: pure-Zan ONNX Runtime inference through the
// versioned C API function table (no C shim, no link-time dependency).
// The harness compares stdout against a single golden file and has no skip
// concept, so when no onnxruntime library is loadable this prints the same
// ort-ok: 1 line without asserting anything (an environment skip, mirroring
// lua_embed_smoke). When the runtime IS present it loads a 172-byte
// MatMul model (x[2,3] · w[3,2] = [[22,28],[49,64]]) embedded as base64 and
// asserts: session input/output names are discovered from the model, the
// float32 input round-trips through native memory, Run returns the exact
// shape and values, a second Run on the same session is stable, malformed
// tensor shapes and wrong input counts surface as Zan exceptions, and the
// process-level Env is released by Shutdown.
using System;
using System.ML;

namespace Conf;

class Prog {
    static void Main() {
        if (!Ort.IsAvailable()) {
            // No ONNX Runtime on this machine: skip silently (see header).
            Console.WriteLine("ort-ok: 1");
            return;
        }
        int bad = 0;

        // tensor factories
        float[] x = new float[6];
        x[0] = 1.0f; x[1] = 2.0f; x[2] = 3.0f;
        x[3] = 4.0f; x[4] = 5.0f; x[5] = 6.0f;
        OrtTensor m = OrtTensor.Matrix(2, 3, x);
        if (m.Rank() != 2 || m.Shape()[0] != 2L || m.Shape()[1] != 3L) { bad = bad + 1; }
        if (m.ElementCount() != 6L) { bad = bad + 1; }
        if (OrtTensor.Vector(x).Rank() != 1) { bad = bad + 1; }
        if (OrtTensor.Scalar(2.5f).ElementCount() != 1L) { bad = bad + 1; }
        bool threw = false;
        try {
            long[] wrong = new long[2];
            wrong[0] = 4; wrong[1] = 4;
            OrtTensor.Of(x, wrong);
        } catch (InvalidOperationException) {
            threw = true;
        }
        if (!threw) { bad = bad + 1; }

        // 172-byte MatMul model (built with onnx helper, opset 13, IR v13)
        string modelB64 = "CA0SCXphbi1zbW9rZTpqChEKAXgKAXcSAXkiBk1hdE11bBIGemFuX21tKiMIAwgCEAEiGAAAgD8AAABAAABAQAAAgEAAAKBAAADAQEIBd1oTCgF4Eg4KDAgBEggKAggCCgIIA2ITCgF5Eg4KDAgBEggKAggCCgIIAkIECgAQDQ==";
        byte[] model = Convert.FromBase64String(modelB64);
        OrtSession s = model == null ? null : Ort.LoadSession(model);

        // names discovered from the model, not supplied by the caller
        string[] inNames = s.InputNames();
        if (inNames.Length != 1 || inNames[0] != "x") { bad = bad + 1; }
        string[] outNames = s.OutputNames();
        if (outNames.Length != 1 || outNames[0] != "y") { bad = bad + 1; }

        // wrong input count is a Zan exception, not a crash
        threw = false;
        try {
            OrtTensor[] none = new OrtTensor[0];
            s.Run(none);
        } catch (InvalidOperationException) {
            threw = true;
        }
        if (!threw) { bad = bad + 1; }

        // inference: [[1,2,3],[4,5,6]] · w = [[22,28],[49,64]], twice
        float[] rf = new float[4];
        rf[0] = 22.0f; rf[1] = 28.0f; rf[2] = 49.0f; rf[3] = 64.0f;
        for (int round = 0; round < 2; round = round + 1) {
            OrtTensor y = s.Run1(OrtTensor.Matrix(2, 3, x));
            if (y.Rank() != 2 || y.Shape()[0] != 2L || y.Shape()[1] != 2L) {
                bad = bad + 1;
            }
            float[] yd = y.Data();
            if (yd.Length != 4) { bad = bad + 1; }
            for (int i = 0; i < 4; i = i + 1) {
                if (Math.Abs(yd[i] - rf[i]) > 1e-4f) { bad = bad + 1; }
            }
        }

        if (Ort.RuntimeVersion().Length == 0) { bad = bad + 1; }

        s.Close();
        Ort.Shutdown();
        Console.WriteLine("ort-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
