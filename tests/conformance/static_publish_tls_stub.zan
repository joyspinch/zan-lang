// Conformance: a Windows static publish stubs DllImport libraries whose
// archives are not staged, instead of failing the link.
//
// Background: gui_gallery pulls TlsStream into its image through
// Image.url's https branch but never opens an https connection (its catalog
// demo talks to a local http://127.0.0.1 server). A single-file
// (--link-mode static --publish) build nevertheless demanded -lssl
// -lcrypto and dragged ~5.5 MB of OpenSSL into the exe. zanc now stubs
// every import of a DllImport library that resolves to neither a static
// archive nor a shared DLL (Windows static publish only) and drops the
// -l from the link line; the stubbed calls fail at run time by returning
// -1/0, so TlsContext.CreateClient() yields a context the program can
// detect and degrade on.
//
// The behavior this case pins: a static publish WITHOUT ssl/crypto
// archives still compiles, runs, and observes the stubbed Tls surface
// returning failure values (ctx == null here). The real-link path is
// covered by tls_hostname / https_binary_body (shared drivers) and by
// publishing with the Tls static archives staged.
using System;
using System.Net.Tls;

class Program {
    static void Main() {
        TlsContext ctx = TlsContext.CreateClient();
        // Stubbed SSL_CTX_new returns null/0: no TLS available, but the
        // program must keep running and be able to detect it.
        Console.WriteLine("ctx_null=" + (ctx == null ? 1 : 0));
        Console.WriteLine("OK");
    }
}
