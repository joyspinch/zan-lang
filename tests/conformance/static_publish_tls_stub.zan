using System;

class Program {
    [DllImport("dummy_ssl")]
    static extern nint SSL_CTX_new(nint method);

    static void Main() {
        nint ctx = SSL_CTX_new(0);
        // 测试断言与状态转移验证。
        // 核心契约与语义定义。
        Console.WriteLine("ctx_null=" + (ctx == 0 ? 1 : 0));
        Console.WriteLine("OK");
    }
}
