using System;
using System.Threading;

// B-ID98 钉子：timer_delay 入队分配失败 → 等待协程立即恢复，不悬挂。
// 注入 timer.delay_entry:2（两段 delay 的入队分配都失败）：若恢复口径
// 失效，程序挂死到 ctest 超时；恢复口径正确则两段 delay 立即返回。
class Program {
    static async Task<int> Run() {
        await Task.Delay(60000);
        Console.WriteLine("first-resumed-immediately");
        await Task.Delay(60000);
        Console.WriteLine("second-resumed-immediately");
        return 7;
    }

    static void Main() {
        int r = await Run();
        Console.WriteLine("done: " + r.ToString());
    }
}
