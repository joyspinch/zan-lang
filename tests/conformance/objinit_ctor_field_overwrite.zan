using System;

namespace Conf;

/// 对象初始化器覆盖构造器已写入的 RC 字段时必须释放旧值：
/// `new Card { title = "x" }` 此前会漏掉构造器包进 title 的空
/// Binding 盒（每次构造漏一个，leakcheck 孪生档把关）。
/// 同时钉住语义：初始化器的值胜过构造器的值，无初始化器时
/// 构造器的值保留，构造后的普通赋值照常生效。
class Card {
    Binding<string> title;
    string tag;
    int rank;

    void InitCard(string seed) {
        title = seed;
        tag = seed;
        rank = 7;
    }

    Card() { InitCard("seed"); }
}

class Program {
    static void Main() {
        Card a = new Card { title = "x", tag = "t", rank = 1 };
        Console.WriteLine(a.title.Get());
        Console.WriteLine(a.tag);
        Console.WriteLine(Convert.ToString(a.rank));

        Card b = new Card();
        Console.WriteLine(b.title.Get());
        Console.WriteLine(b.tag);
        Console.WriteLine(Convert.ToString(b.rank));

        a.title = "y";
        Console.WriteLine(a.title.Get());
    }
}
