using System;

delegate int Compute();

class Program {
    static int visits;

    static async int Run() {
        try {
            Compute fn = () => {
                return 40 + 2;
            };
            return fn();
        } finally {
            visits = visits + 1;
        }
    }

    static async void Main() {
        int r = await Run();
        Console.WriteLine(Convert.ToString(r) + ":" + Convert.ToString(visits));
    }
}
