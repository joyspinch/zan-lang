using System;
using Alpha;

// A class at global scope colliding with Alpha.App: a reference to `App` in
// expression position must resolve to this declaration, not to the imported
// Alpha.App (a global-scope declaration's own namespace is the global one,
// and it wins over an import just like a namespaced one wins in its own ns).
class App {
    public static string OnLoad() { return "mine-app"; }
}

class Program {
    static void Main() {
        Console.WriteLine(Split.A());
        Console.WriteLine(Split.B());
        Console.WriteLine(App.OnLoad());
    }
}
