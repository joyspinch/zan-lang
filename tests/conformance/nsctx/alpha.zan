// Namespace Alpha owns a `Amb` and an `App`. Both simple names also exist
// elsewhere (Beta.Amb, and a global App in main.zan), so nsresolve renames
// every declaration of them.
using System;

namespace Alpha;

class Amb {
    public static string Mark() { return "alpha"; }
}

class App {
    public static string OnLoad() { return "alpha-app"; }
}
