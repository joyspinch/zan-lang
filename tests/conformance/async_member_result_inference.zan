using System;

class RoleProbe {
    static async bool Replace(bool suspend) {
        if (suspend) { await Task.Delay(1); }
        return true;
    }
    static async bool Set(bool suspend) {
        bool applied = false;
        try {
            applied = await RoleProbe.Replace(suspend);
            if (!applied) { return false; }
            return true;
        } finally {
            await Task.Delay(1);
            if (!applied) { throw new Exception("bool result was lost"); }
        }
    }
    static async int Trim() { await Task.Yield(); return 42; }
    async bool ToUpper() { await Task.Yield(); return true; }
    static async bool ToString(int value) { await Task.Yield(); return value == 7; }
}

class Program {
    static async void Main() {
        bool immediate = await RoleProbe.Set(false);
        bool suspended = await RoleProbe.Set(true);
        if (!immediate || !suspended) { throw new Exception("Replace returned false"); }
        Console.WriteLine("PASS await user Replace bool result");
        int trimmed = await RoleProbe.Trim();
        RoleProbe role = new RoleProbe();
        bool upper = await role.ToUpper();
        bool named = await RoleProbe.ToString(7);
        if (trimmed != 42 || !upper || !named) { throw new Exception("user member result type lost"); }
        string text = " a ".Trim().Replace("a", "b").ToUpper().ToLower();
        if (text != "b" || trimmed.ToString() != "42") { throw new Exception("string/scalar builtins changed"); }
        Console.WriteLine("PASS declared results and string builtins");
    }
}
