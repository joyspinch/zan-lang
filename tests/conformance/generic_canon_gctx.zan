using System;
using System.Collections.Generic;
using System.Threading.Tasks;

interface IBox<T> {
    string Kind();
    T Echo(T v);
}

class Animal {
    public string Tag;
    public Animal() { Tag = "Animal"; }
    public virtual string Speak() => "animal";
}

class Dog : Animal {
    public string Name;
    public Dog() { Name = "Rex"; Tag = "Dog"; }
    public override string Speak() => "woof:" + Name;
}

class Cat : Animal {
    public string Color;
    public Cat() { Color = "Black"; Tag = "Cat"; }
    public override string Speak() => "meow:" + Color;
}

class ImplicitInit {
    public string Label = "implicit-ok";
}

class Inner<U> {
    public string TypeName() => typeof(U).Name;
    public bool Check(object x) => x is U;
}

class Box<T> : IBox<T> {
    public static int Counter = InitCounter();
    public static T Cached;
    public static int Prop {
        get { return Counter + 100; }
        set { Counter = value; }
    }

    static int InitCounter() => 7;

    public T Value;
    public Inner<T> Sub;
    public Inner<List<T>> ListSub;

    public Box(T v) {
        Value = v;
        Sub = new Inner<T>();
        ListSub = new Inner<List<T>>();
    }

    public virtual string Kind() => typeof(T).Name;
    public virtual T Echo(T v) => v;

    public bool IsMatch(object x) => x is T;
    public bool IsNotMatch(object x) => x is not T;

    public string PatternMatch(object x) {
        if (x is T t) {
            return "pat:" + (t != null ? "ok" : "null");
        }
        return "pat:miss";
    }

    public string SwitchMatch(object x) {
        switch (x) {
            case T t:
                return "sw:" + (t != null ? "ok" : "null");
            default:
                return "sw:miss";
        }
    }

    public T AsCast(object x) => x as T;

    public string HardCast(object x) {
        try {
            T casted = (T)x;
            return casted != null ? "cast:ok" : "cast:null";
        } catch {
            return "cast:throw";
        }
    }

    public string NestedInfo() => Sub.TypeName() + "|" + ListSub.TypeName();

    public string LambdaType(int seed) {
        Func<string> fn = () => typeof(T).Name + "#" + seed.ToString();
        return fn();
    }

    public Func<string> StaticGroup() => StaticType;
    public static string StaticType() => "static:" + typeof(T).Name;

    public string CallInstanceGroup() {
        Func<string> fn = Kind;
        return fn();
    }

    public async Task<string> AsyncInspect(T item) {
        await Task.Delay(1);
        var echoed = Echo(item);
        return typeof(T).Name + ":" + (echoed is T ? "yes" : "no");
    }

    public async Task<T> AsyncEcho(T item) {
        await Task.Delay(1);
        return item;
    }
}

class Creator<T> where T : new() {
    public T Make() => new T();
    public string MakeAndDescribe() {
        var o = new T();
        return typeof(T).Name + ":" + (o is T ? "ok" : "bad");
    }
}

class AnimalCreator<T> where T : Animal, new() {
    public string MakeSpeak() {
        var a = new T();
        return a.Speak() + "|" + a.Tag;
    }
}

class Helper {
    public static string Show<U>(object x) => typeof(U).Name + ":" + (x is U ? "1" : "0");
    public static Func<string> CaptureMethod<U>() {
        return () => typeof(U).Name;
    }
}

class Program {
    static async Task RunAsync() {
        var bd = new Box<Dog>(new Dog());
        var bc = new Box<Cat>(new Cat());
        var bs = new Box<string>("hi");
        var bo = new Box<object>(new object());
        var bl = new Box<List<Dog>>(new List<Dog>());
        var bi = new Box<int>(42);

        Console.WriteLine("kinds=" + bd.Kind() + "," + bc.Kind() + "," + bs.Kind() + "," + bo.Kind() + "," + bl.Kind() + "," + bi.Kind());

        var d = new Dog();
        var c = new Cat();
        var ld = new List<Dog>();
        Console.WriteLine("is=" + bd.IsMatch(d).ToString() + "," + bd.IsMatch(c).ToString() + "," + bd.IsNotMatch(c).ToString() + "," + bs.IsMatch("x").ToString() + "," + bs.IsMatch(d).ToString() + "," + bo.IsMatch("x").ToString() + "," + bo.IsMatch(ld).ToString() + "," + bl.IsMatch(ld).ToString() + "," + bl.IsMatch(new List<Cat>()).ToString());

        Console.WriteLine("pat=" + bd.PatternMatch(d) + "," + bd.PatternMatch(c) + "," + bd.SwitchMatch(d) + "," + bd.SwitchMatch(c));
        Console.WriteLine("as=" + (bd.AsCast(d) != null).ToString() + "," + (bd.AsCast(c) != null).ToString() + "," + (bo.AsCast("abc") != null).ToString());
        Console.WriteLine("cast=" + bd.HardCast(d) + "," + bd.HardCast(c) + "," + bd.HardCast(null));

        Console.WriteLine("nested=" + bd.NestedInfo() + ";" + bc.NestedInfo());

        Box<Dog>.Counter = 11;
        Box<Cat>.Counter = 22;
        Box<Dog>.Cached = d;
        Box<Cat>.Cached = c;
        Console.WriteLine("static=" + Box<Dog>.Counter.ToString() + "," + Box<Cat>.Counter.ToString() + "," + Box<string>.Counter.ToString() + "," + Box<Dog>.Prop.ToString() + "," + Box<Cat>.Prop.ToString());
        Console.WriteLine("cached=" + Box<Dog>.Cached.Name + "," + Box<Cat>.Cached.Color);

        IBox<Dog> ibd = bd;
        IBox<Cat> ibc = bc;
        Console.WriteLine("ifc=" + ibd.Kind() + "," + ibc.Kind() + "," + ibd.Echo(d).Name);

        Console.WriteLine("lam=" + bd.LambdaType(1) + "," + bc.LambdaType(2));
        var sgD = bd.StaticGroup();
        var sgC = bc.StaticGroup();
        Console.WriteLine("mg=" + sgD() + "," + sgC());
        Console.WriteLine("img=" + bd.CallInstanceGroup());

        var cd = new Creator<Dog>();
        var ci = new Creator<ImplicitInit>();
        var ci2 = new Creator<Inner<Dog>>();
        Console.WriteLine("newt=" + cd.MakeAndDescribe() + "," + ci.Make().Label + "," + ci2.Make().TypeName());

        var ac = new AnimalCreator<Dog>();
        Console.WriteLine("anewt=" + ac.MakeSpeak());

        Console.WriteLine("mth=" + Helper.Show<Dog>(d) + "," + Helper.Show<Dog>(c) + "," + Helper.Show<List<Dog>>(ld));
        var cm = Helper.CaptureMethod<Cat>();
        Console.WriteLine("mthlam=" + cm());

        string a1 = await bd.AsyncInspect(d);
        string a2 = await bc.AsyncInspect(c);
        Dog a3 = await bd.AsyncEcho(d);
        Console.WriteLine("async=" + a1 + "," + a2 + "," + a3.Name);
    }

    static async Task Main() {
        await RunAsync();
    }
}
