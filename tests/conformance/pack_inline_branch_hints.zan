using System;

namespace PackInlineHintTest;

[StructLayout(LayoutKind.Sequential, Pack = 1)]
public struct BmpHeader {
    public ushort sig;
    public uint fileSize;
    public ushort r1;
    public ushort r2;
    public uint pixelOffset;
}

[StructLayout(LayoutKind.Sequential, Pack = 2)]
public struct Pack2Rec {
    public byte tag;
    public int value;
    public byte tail;
}

[StructLayout(LayoutKind.Explicit, Pack = 1)]
public struct ExplicitPack1 {
    [FieldOffset(0)]
    public byte kind;
    [FieldOffset(1)]
    public int payload;
}

public class Program {
    [Inline(Always)]
    static int FastAdd(int a, int b) {
        return a + b;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    static int FastMul(int a, int b) {
        return a * b;
    }

    [Inline(Never)]
    static int NeverInlined(int x) {
        return x * 3 + 1;
    }

    [Cold]
    static int ColdPath(int x) {
        return -x - 100;
    }

    static int BranchSum(int n) {
        int acc = 0;
        for (int i = 0; i < n; i = i + 1) {
            if (likely(i < n - 1)) {
                acc = FastAdd(acc, i);
            } else if (Hint.Unlikely(i == n - 1)) {
                acc = FastAdd(acc, NeverInlined(i));
            }
            if (unlikely(i < 0)) {
                acc = ColdPath(acc);
            }
            if (Hint.Likely(acc >= 0)) {
                acc = acc + 1;
            }
        }
        return acc;
    }

    public static void Main() {
        Console.WriteLine($"sz_bmp={Marshal.SizeOf<BmpHeader>()}");
        Console.WriteLine($"sz_p2={Marshal.SizeOf<Pack2Rec>()}");
        Console.WriteLine($"sz_ep1={Marshal.SizeOf<ExplicitPack1>()}");

        BmpHeader h = new BmpHeader();
        h.sig = 19778;
        h.fileSize = 1048576;
        h.r1 = 1;
        h.r2 = 2;
        h.pixelOffset = 54;
        Console.WriteLine($"bmp={h.sig},{h.fileSize},{h.r1},{h.r2},{h.pixelOffset}");

        Pack2Rec p2 = new Pack2Rec();
        p2.tag = 7;
        p2.value = 123456;
        p2.tail = 9;
        Console.WriteLine($"p2={p2.tag},{p2.value},{p2.tail}");

        ExplicitPack1 ep = new ExplicitPack1();
        ep.kind = 42;
        ep.payload = 987654;
        Console.WriteLine($"ep1={ep.kind},{ep.payload}");

        int s = BranchSum(10);
        int m = FastMul(6, 7);
        Console.WriteLine($"sum={s},mul={m}");
    }
}
