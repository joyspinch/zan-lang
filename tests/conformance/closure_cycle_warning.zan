using System;

class Handler {
    Action cb;
}

class Widget {
    Action onClick;
    Handler handler;

    void Setup() {
        // 核心契约与语义定义。
        this.onClick = () => {
            this.Close();
        };

        // 核心契约与语义定义。
        onClick = () => {
            Close();
        };

        // 核心契约与执行状态转移规范。
        this.handler = new Handler();
        this.handler.cb = () => {
            this.Close();
        };

        // 核心契约与语义定义。
        this.handler = new Handler {
            cb = () => {
                this.Close();
            }
        };
    }

    void Close() {
    }
}

class Program {
    static void Main() {
        Widget w = new Widget();
        w.Setup();
        Console.WriteLine("cycle warning verified");
    }
}
