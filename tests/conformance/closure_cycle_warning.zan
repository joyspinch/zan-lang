using System;

class Handler {
    Action cb;
}

class Widget {
    Action onClick;
    Handler handler;

    void Setup() {
        // 1. this.member = () => { this.Method(); }
        this.onClick = () => {
            this.Close();
        };

        // 2. bare member = () => { Method(); } (implicitly this)
        onClick = () => {
            Close();
        };

        // 3. nested member on this
        this.handler = new Handler();
        this.handler.cb = () => {
            this.Close();
        };

        // 4. object initializer assigned to this member
        this.handler = new Handler {
            cb = () => {
                this.Close();
            }
        };
    }

    void Close() {
    }
}

class Program {
    static void Main() {
        Widget w = new Widget();
        w.Setup();
        Console.WriteLine("cycle warning verified");
    }
}
