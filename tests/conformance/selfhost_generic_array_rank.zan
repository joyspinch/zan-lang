using System;

class GenericArrayFactory<T> {
    public T[,] MakeMatrix() {
        return new T[2,3];
    }

    public T[][] MakeRows() {
        return new T[2][];
    }
}

class Program {
    static void Main() {
        GenericArrayFactory<int> factory = new GenericArrayFactory<int>();
        int[,] matrix = factory.MakeMatrix();
        matrix[1,2] = 17;
        Console.WriteLine(matrix.GetLength(1) == 3 && matrix[1,2] == 17);

        int[][] rows = factory.MakeRows();
        rows[1] = new int[] { 23 };
        Console.WriteLine(rows[0] == null && rows[1][0] == 23);
    }
}
