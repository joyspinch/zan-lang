using System;

class Program {
    [Export("g_hidden_acc")]
    [Visibility("hidden")]
    static long g_acc = 0L;

    [Export("sysv_fn_target")]
    [Visibility("hidden")]
    [CallingConvention("sysv64")]
    [NoAlloc]
    static long SysvTarget(long a, long b, long c, long d, long e, long f) {
        return a + b * 2L + c * 3L + d * 4L + e * 5L + f * 6L;
    }

    [Export("sysv_void_target")]
    [Visibility("hidden")]
    [CallingConvention("sysv64")]
    [NoAlloc]
    static void SysvVoidTarget(long delta) {
        g_acc += delta;
    }

    [Export("win64_fn_target")]
    [Visibility("default")]
    [CallingConvention("win64")]
    [NoAlloc]
    static int Win64Target(int x, int y) {
        return x * 100 + y;
    }

    static int Main() {
        nint fpSysv = NativeMemory.FunctionPointer(SysvTarget);
        nint fpVoid = NativeMemory.FunctionPointer(SysvVoidTarget);
        nint fpWin64 = NativeMemory.FunctionPointer(Win64Target);

        long s = NativeMemory.InvokeWithCC<long>("sysv64", fpSysv, 1L, 2L, 3L, 4L, 5L, 6L); // 91
        NativeMemory.InvokeVoidWithCC("sysv64", fpVoid, 33L);
        NativeMemory.InvokeVoidWithCC("sysv64", fpVoid, 9L);
        int w = NativeMemory.InvokeWithCC<int>("win64", fpWin64, 7, 5); // 705

        Console.WriteLine($"s={s} acc={g_acc} w={w}");
        return 0;
    }
}
