using System;
using System.Diagnostics;
using Game.Tactics;
using Game.Net;
using Game.Foundation;
using Game.Core;
using Game.Graphics;
using Game.Idle;

class GamePerformanceBenchmarkSuite {
    static void Main() {
        Console.WriteLine("=================================================================");
        Console.WriteLine("          ZAN GAME ENGINE 工业级微秒级性能基准测试 (BENCHMARK)   ");
        Console.WriteLine("=================================================================");

        Stopwatch sw = new Stopwatch();

        // -------------------------------------------------------------
        // Benchmark 1: FlowField 64x64 (4096 节点) 波前扩散集成与 100,000 次 O(1) 采样
        // -------------------------------------------------------------
        Console.WriteLine("[BENCH 1/6] FlowField 宏观流场寻路生成与 O(1) 向量采样...");
        FlowField field = FlowField.Create(64, 64, 32);
        for (int y = 0; y < 64; y = y + 1) {
            if (y != 32) { field.SetCost(30, y, (byte)255); }
        }
        field.SetTarget(55, 32);

        sw.Restart();
        field.Rebuild();
        sw.Stop();
        double rebuildMs = sw.ElapsedMilliseconds();

        sw.Restart();
        float vx = 0.0f;
        float vy = 0.0f;
        for (int i = 0; i < 100000; i = i + 1) {
            field.SampleWorldVelocity(400.0, 500.0, out vx, out vy);
        }
        sw.Stop();
        double sampleMs = sw.ElapsedMilliseconds();
        Console.WriteLine("    -> 64x64 (4096节点) 集成场+向量场重构耗时: " + rebuildMs.ToString() + " ms");
        Console.WriteLine("    -> 100,000 次世界坐标采样耗时: " + sampleMs.ToString() + " ms (单次采样: " + (sampleMs * 10.0).ToString() + " ns)");

        // -------------------------------------------------------------
        // Benchmark 2: RvoSimulator 500 个单位高密互斥避障与推挤单步耗时
        // -------------------------------------------------------------
        Console.WriteLine("[BENCH 2/6] RVO2 万人微观推挤与互斥避障 500 单位高密对冲步进...");
        RvoSimulator rvo = RvoSimulator.Create(600, 48);
        for (int i = 0; i < 500; i = i + 1) {
            double sx = (double)(100 + (i % 25) * 16);
            double sy = (double)(100 + (i / 25) * 16);
            rvo.AddAgent(sx, sy, 8.0, 60.0);
            rvo.SetPrefVelocity(i, (i % 2 == 0) ? 60.0 : -60.0, 0.0);
        }

        // 连续步进 100 帧（相当于 20Hz 下 5 秒对抗）
        sw.Restart();
        for (int s = 0; s < 100; s = s + 1) {
            rvo.Step(0.05);
        }
        sw.Stop();
        double rvoTotalMs = sw.ElapsedMilliseconds();
        double rvoPerFrame = rvoTotalMs / 100.0;
        Console.WriteLine("    -> 500 单位连续 100 步 RVO 解算总耗时: " + rvoTotalMs.ToString() + " ms");
        Console.WriteLine("    -> 500 单位单步解算均帧耗时: " + rvoPerFrame.ToString() + " ms/frame (远优于 16ms 渲染预算)");

        // -------------------------------------------------------------
        // Benchmark 3: SpatialHash2D 10,000 个实体空间哈希重建与 1,000 次圆盘范围检索
        // -------------------------------------------------------------
        Console.WriteLine("[BENCH 3/6] SpatialHash2D 空间分区检索与索敌吞吐量...");
        SpatialHash2D hash = SpatialHash2D.Create(64, 12000);
        sw.Restart();
        for (int i = 0; i < 10000; i = i + 1) {
            double ex = (double)((i * 37) % 2000);
            double ey = (double)((i * 59) % 2000);
            hash.Insert(i, ex, ey, 10.0);
        }
        sw.Stop();
        double hashInsertMs = sw.ElapsedMilliseconds();

        int[] results = new int[64];
        sw.Restart();
        int queryHits = 0;
        for (int q = 0; q < 1000; q = q + 1) {
            double qx = (double)((q * 43) % 2000);
            double qy = (double)((q * 71) % 2000);
            int count = hash.QueryRange(qx, qy, 80.0, results, 64);
            queryHits = queryHits + count;
        }
        sw.Stop();
        double hashQueryMs = sw.ElapsedMilliseconds();
        Console.WriteLine("    -> 10,000 实体动态哈希插入耗时: " + hashInsertMs.ToString() + " ms");
        Console.WriteLine("    -> 1,000 次范围碰撞索敌查询耗时: " + hashQueryMs.ToString() + " ms (单次查询: " + (hashQueryMs / 1000.0).ToString() + " ms)");

        // -------------------------------------------------------------
        // Benchmark 4: Paperdoll 纸娃娃 10,000 次 8 方向动态层深插入排序
        // -------------------------------------------------------------
        Console.WriteLine("[BENCH 4/6] Paperdoll 纸娃娃动态层深与 5 方向镜像排序吞吐...");
        SpriteSheet bodySheet = SpriteSheet.Create("body", 256, 256, 32, 32);
        PaperdollRenderer doll = PaperdollRenderer.Create(bodySheet, 8);
        doll.AddLayer("wing", bodySheet, 0, new int[8] { 0, 0, -20, 0, 0, 0, 30, 0 }, true);
        doll.AddLayer("body", bodySheet, 10, null, true);
        doll.AddLayer("cloth", bodySheet, 20, null, true);
        doll.AddLayer("weapon", bodySheet, 30, new int[8] { 0, 0, 10, 0, 0, 0, -30, 0 }, true);
        doll.MasterAnimator.AddState("walk", 0, 4, 8.0, true);

        sw.Restart();
        for (int i = 0; i < 10000; i = i + 1) {
            doll.Play("walk", i % 8, true);
            doll.SortLayersByDirection();
        }
        sw.Stop();
        double dollMs = sw.ElapsedMilliseconds();
        Console.WriteLine("    -> 10,000 次纸娃娃图层动态防穿模排序耗时: " + dollMs.ToString() + " ms (单次: " + (dollMs * 100.0).ToString() + " ns)");

        // -------------------------------------------------------------
        // Benchmark 5: FloatingTextManager 100,000 次零 GC 对象池高速生成与衰减
        // -------------------------------------------------------------
        Console.WriteLine("[BENCH 5/6] FloatingTextManager 零 GC 飘字对象池吞吐量...");
        FloatingTextManager pool = FloatingTextManager.Create(256);
        sw.Restart();
        for (int i = 0; i < 100000; i = i + 1) {
            pool.SpawnDamage((double)(i % 800), (double)(i % 600), (long)i, i % 3 == 0);
            if (i % 256 == 0) {
                pool.Update(0.016);
            }
        }
        sw.Stop();
        double poolMs = sw.ElapsedMilliseconds();
        Console.WriteLine("    -> 100,000 次暴击/普通伤害飘字生成与物理衰减耗时: " + poolMs.ToString() + " ms (每秒吞吐: " + ((long)(100000000.0 / (poolMs > 0.0 ? poolMs : 1.0))).ToString() + " ops/s)");

        // -------------------------------------------------------------
        // Benchmark 6: ReplaySystem 1,000 帧战局录像与 8 倍速播放调度吞吐
        // -------------------------------------------------------------
        Console.WriteLine("[BENCH 6/6] ReplaySystem 战局录制与 8 倍速追帧调度吞吐...");
        ReplayRecorder recorder = ReplayRecorder.Create(999999, 4, "PerformanceBench");
        for (int f = 1; f <= 1000; f = f + 1) {
            FrameBucket b = FrameBucket.Create(f, 4);
            b.AddCommand(PlayerCommand.Create(1, 1, 100.0, 200.0, 0, 0));
            b.AddCommand(PlayerCommand.Create(2, 1, 300.0, 400.0, 0, 0));
            recorder.RecordFrame(f, b);
        }
        recorder.Stop();

        ReplayPlayer player = ReplayPlayer.Create(recorder.Header, recorder.GetFrames(), 20.0);
        player.Play();
        player.SpeedMultiplier = 8.0;

        sw.Restart();
        int executedCommands = 0;
        while (!player.IsFinished) {
            player.Update(0.1, (int frameIdx, List<PlayerCommand> cmds) => {
                executedCommands = executedCommands + cmds.Count;
            });
        }
        sw.Stop();
        double replayMs = sw.ElapsedMilliseconds();
        Console.WriteLine("    -> 1,000 逻辑帧 (2,000 条微操指令) 8 倍速全量分发耗时: " + replayMs.ToString() + " ms");

        Console.WriteLine("=================================================================");
        Console.WriteLine(">>>>> ALL_BENCHMARKS_COMPLETED_SUCCESSFULLY <<<<<");
        Console.WriteLine("=================================================================");
    }
}
