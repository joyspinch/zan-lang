using System;
using System.Collections.Generic;
using System.Drawing;
using System.Drawing.Printing;
using System.Automation;
using System.Input;
using System.Management;
using System.Media;
using System.Windows;
using System.Windows.Clipboard;
using Zan.AppUpdate;

class Program {
    static void Main() {
        Console.WriteLine("=== Desktop & AppUpdate Hardening Test ===");

        // 1. System.Drawing: Point, Size, Rectangle, Color, ImageBuffer
        Point pt = new Point(10, 20);
        Size sz = new Size(100, 200);
        Rectangle rect = new Rectangle(10, 20, 100, 200);
        Color c = Color.FromARGB(255, 128, 64, 32);
        Console.WriteLine("Drawing Geometry: pt=" + Convert.ToString(pt.x) + "," + Convert.ToString(pt.y) +
                          " sz=" + Convert.ToString(sz.width) + "x" + Convert.ToString(sz.height) +
                          " rect=" + Convert.ToString(rect.Contains(50, 50)));
        Console.WriteLine("Color ARGB: " + Convert.ToString(c.a) + "," + Convert.ToString(c.r) + "," +
                          Convert.ToString(c.g) + "," + Convert.ToString(c.b));

        ImageBuffer buf = new ImageBuffer(4, 4);
        buf.Clear(0xFF00FF00);
        Console.WriteLine("ImageBuffer size: " + Convert.ToString(buf.Width) + "x" + Convert.ToString(buf.Height));
        buf.Dispose();

        // 2. System.Automation: Models, UiElement, Window
        WindowPoint wpt = new WindowPoint(5, 15);
        WindowRect wrect = new WindowRect(0, 0, 800, 600);
        WindowThreadInfo wtinfo = new WindowThreadInfo(1234, 5678);
        Console.WriteLine("Automation Models: pt=" + Convert.ToString(wpt.x) + "," + Convert.ToString(wpt.y) +
                          " rect=" + Convert.ToString(wrect.width) + "x" + Convert.ToString(wrect.height) +
                          " tid=" + Convert.ToString(wtinfo.tid) + " pid=" + Convert.ToString(wtinfo.pid));

        UiElement elem = new UiElement((nint)0, 0);
        Console.WriteLine("UiElement IsValid: " + Convert.ToString(elem.IsValid()));
        Console.WriteLine("UiElement RoleTitleBar: " + Convert.ToString(UiElement.RoleTitleBar() == 0x1));
        elem.Dispose();

        nint dummyHwnd = (nint)0;
        Console.WriteLine("Window IsWindow(0): " + Convert.ToString(Window.IsWindow(dummyHwnd)));

        // 3. System.Input: Constants & Primitives
        Console.WriteLine("Input Constants: Mouse.Left=" + Convert.ToString(Mouse.Left()) +
                          " Mouse.Right=" + Convert.ToString(Mouse.Right()) +
                          " Keyboard.Ctrl=" + Convert.ToString(Keyboard.Ctrl()) +
                          " Hotkey.ModAlt=" + Convert.ToString(Hotkey.ModAlt()) +
                          " ToolNone=" + Convert.ToString(InputTool.None()));

        // 4. System.Management: Models & Subsystems
        Console.WriteLine("System.Management Cpu: LogicalCores>0=" + Convert.ToString(Cpu.LogicalCores() > 0));
        bool iddOk = Device.HasIndirectDisplayAdapter() || !Device.HasIndirectDisplayAdapter();
        Console.WriteLine("System.Management Device: HasIdd callable=" + Convert.ToString(iddOk));
        bool displayOk = Display.ScreenWidth() >= 0 && Display.ScreenHeight() >= 0;
        Console.WriteLine("System.Management Display: Screen callable=" + Convert.ToString(displayOk));

        MemoryStatus mem = Memory.GetStatus();
        Console.WriteLine("System.Management Memory: totalPhys>0=" + Convert.ToString(mem.totalPhys > 0) +
                          " usage=" + Convert.ToString(mem.usagePercent >= 0 && mem.usagePercent <= 100));

        PowerStatus power = Power.GetStatus();
        Console.WriteLine("System.Management Power: batteryPercent callable=" + Convert.ToString(power.batteryPercent >= -1));

        Console.WriteLine("System.Management Registry Constants: Hkcu=" + Convert.ToString(Registry.Hkcu() != 0) +
                          " TypeSz=" + Convert.ToString(Registry.TypeSz() == 1) +
                          " TypeDword=" + Convert.ToString(Registry.TypeDword() == 4));

        DiskUsage rootDisk = Storage.Root();
        Console.WriteLine("System.Management Storage: rootDisk total>0=" + Convert.ToString(rootDisk.totalBytes > 0) +
                          " pct=" + Convert.ToString(rootDisk.UsagePercent() >= 0 && rootDisk.UsagePercent() <= 100));

        Console.WriteLine("System.Management SystemInfo: osName=" + Convert.ToString(SystemInfo.OsName().Length > 0) +
                          " uptime>=0=" + Convert.ToString(SystemInfo.UptimeSeconds() >= 0));

        Console.WriteLine("System.Management TaskScheduler: ValidName=" + Convert.ToString(TaskScheduler.ValidName("TestTask")) +
                          " ValidTrigger=" + Convert.ToString(TaskScheduler.ValidTrigger("DAILY")) +
                          " ValidTime=" + Convert.ToString(TaskScheduler.ValidTime("12:30")));

        // 5. System.Media: Audio & AudioClip lifecycle
        Console.WriteLine("System.Media Audio: IsOpen=" + Convert.ToString(Audio.IsOpen() ? 1 : 0));
        AudioClip clip = new AudioClip();
        Console.WriteLine("System.Media AudioClip IsValid: " + Convert.ToString(clip.IsValid()));
        clip.Dispose();

        AudioVoice voice = AudioVoice.Of(0);
        Console.WriteLine("System.Media AudioVoice IsValid: " + Convert.ToString(voice.IsValid()));

        // 6. System.Windows: Clipboard, MessageBox, TrayMenuItem, Screen
        Console.WriteLine("Windows Clipboard Format: Text=" + Convert.ToString(ClipFormat.Text()) +
                          " UnicodeText=" + Convert.ToString(ClipFormat.UnicodeText()) +
                          " Hdrop=" + Convert.ToString(ClipFormat.Hdrop()));

        Console.WriteLine("Windows MessageBox Constants: Ok=" + Convert.ToString(MessageBox.Ok()) +
                          " Cancel=" + Convert.ToString(MessageBox.Cancel()) +
                          " Yes=" + Convert.ToString(MessageBox.Yes()) +
                          " No=" + Convert.ToString(MessageBox.No()));

        TrayMenuItem item = new TrayMenuItem(101, "Open");
        item.Check(true).Disabled();
        Console.WriteLine("TrayMenuItem: id=" + Convert.ToString(item.id) +
                          " text=" + item.text +
                          " checked=" + Convert.ToString(item.checkMark) +
                          " disabled=" + Convert.ToString(item.disabled));

        TrayMenuItem sep = TrayMenuItem.Separator();
        Console.WriteLine("TrayMenuItem Sep: isSep=" + Convert.ToString(sep.separator));

        bool screenOk = Screen.ScreenWidth() >= 0 && Screen.ScreenHeight() >= 0 && Screen.Dpi() >= 0;
        Console.WriteLine("Screen Metrics callable: " + Convert.ToString(screenOk));

        // 7. Zan.AppUpdate: Models, Manifest, Progress & Engine
        Console.WriteLine("AppUpdate Status: Ok=" + FileIntegrityStatus.StatusText(FileIntegrityStatus.Ok) +
                          " Missing=" + FileIntegrityStatus.StatusText(FileIntegrityStatus.Missing) +
                          " Tampered=" + FileIntegrityStatus.StatusText(FileIntegrityStatus.Tampered));

        Console.WriteLine("AppUpdate Phase: Checking=" + UpdatePhase.PhaseName(UpdatePhase.Checking) +
                          " Downloading=" + UpdatePhase.PhaseName(UpdatePhase.Downloading) +
                          " Verifying=" + UpdatePhase.PhaseName(UpdatePhase.Verifying) +
                          " Extracting=" + UpdatePhase.PhaseName(UpdatePhase.Extracting) +
                          " SelfHealing=" + UpdatePhase.PhaseName(UpdatePhase.SelfHealing));

        UpdateProgressInfo prog = UpdateProgressInfo.Progress(UpdatePhase.Downloading, 75, 7500, 10000, "app.bin", "downloading");
        Console.WriteLine("AppUpdate Progress: phase=" + Convert.ToString(prog.phase) + " pct=" + Convert.ToString(prog.percent) + "%");

        UpdateFileEntry fe = UpdateFileEntry.Create("bin\\app.exe", 1024, "d41d8cd98f00b204e9800998ecf8427e", true);
        Console.WriteLine("UpdateFileEntry normalized: " + fe.path + " safe=" + Convert.ToString(UpdateFileEntry.SafeRelPath(fe.path)));

        UpdateManifest manifest = new UpdateManifest();
        manifest.appName = "ZanStudio";
        manifest.version = "2.0.0";
        manifest.changelog = "Hardened release";
        manifest.AddFile(fe);
        string json = manifest.ToJson();
        bool jsonOk = json.IndexOf("ZanStudio") >= 0 && json.IndexOf("2.0.0") >= 0;
        Console.WriteLine("UpdateManifest Json: ok=" + Convert.ToString(jsonOk));

        IntegrityReport report = new IntegrityReport();
        report.totalChecked = 1;
        report.okCount = 1;
        Console.WriteLine("IntegrityReport isClean: " + Convert.ToString(report.isClean));

        bool hasNew = AppUpdater.HasNewVersion("1.0.0", "1.1.0");
        bool notNew = AppUpdater.HasNewVersion("2.0.0", "1.9.9");
        Console.WriteLine("AppUpdater Version Compare: 1.0.0 < 1.1.0 -> " + Convert.ToString(hasNew) +
                          ", 2.0.0 < 1.9.9 -> " + Convert.ToString(notNew));

        Console.WriteLine("=== All Desktop & AppUpdate Hardening Checks Passed ===");
    }
}
