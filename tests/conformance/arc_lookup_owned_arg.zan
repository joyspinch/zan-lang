// ARC 临时实参：集合查找内建（Contains/IndexOf/Dict.Remove/
// ContainsKey/TryGetValue/d[key] 读）消费「调用结果作实参」时必须释放
// 那份 +1——实参是局部变量时由帧收尾释放，看不出来；一旦写成内联
// 调用（唯一的持有者就是本次表达式），旧版代码生成无人释放，每次
// 执行泄漏一个引用。回归背景：HttpClient 重定向防环的
// visited.Contains(target.Canonical()) 每跳漏一条 URL 串，
// http_bytes_redirect/http_client_redirect 的泄漏探测因此常红。
// --check-leaks 孪生（leakcheck_arc_lookup_owned_arg）钉住「零泄漏」。
using System;
using System.Collections.Generic;

class Prog {
    static string Key(int i) {
        return "key" + Convert.ToString(i);
    }

    static async int Run() {
        List<string> xs = new List<string>();
        xs.Add(Prog.Key(1));
        int at = xs.IndexOf(Prog.Key(2));
        bool has = xs.Contains(Prog.Key(1));

        Dict<string, int> d = new Dict<string, int>();
        d[Prog.Key(5)] = 5;
        d[Prog.Key(6)] = 6;
        int got = d[Prog.Key(5)];
        bool ck = d.ContainsKey(Prog.Key(6));
        int tv = 0 - 1;
        bool ok = d.TryGetValue(Prog.Key(6), ref tv);
        bool rm = d.Remove(Prog.Key(5));
        // 全部答案核对：at 是「找不到」的 -1，其余为命中。
        Console.WriteLine("at=" + at + " has=" + has + " got=" + got
            + " ck=" + ck + " tv=" + tv + " ok=" + ok + " rm=" + rm
            + " n=" + d.Count);
        return 0;
    }

    static async void Main() {
        int _rc = await Prog.Run();
    }
}
