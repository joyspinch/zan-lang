using System;
using System.Collections.Generic;
using System.Threading;

class Program {
    static int ticksA;
    static int ticksB;

    static void OnTickA() {
        Program.ticksA = Program.ticksA + 1;
    }

    static void OnTickB() {
        Program.ticksB = Program.ticksB + 1;
    }

    static async void Main() {
        Program.ticksA = 0;
        Program.ticksB = 0;

        Timer tA = new Timer(10, Program.OnTickA);
        Timer tB = new Timer(15, Program.OnTickB);

        tA.Start();
        tB.Start();

        // 验证运行状态
        if (!tA.IsRunning() || !tB.IsRunning()) {
            Console.WriteLine("FAIL: timers not marked running");
            return;
        }

        // 运行 60 毫秒
        await Task.Delay(60);

        tA.Stop();
        tB.Stop();

        if (tA.IsRunning() || tB.IsRunning()) {
            Console.WriteLine("FAIL: timers still running after Stop");
            return;
        }

        if (Program.ticksA <= 0 || Program.ticksB <= 0) {
            Console.WriteLine("FAIL: ticks not triggered");
            return;
        }

        Console.WriteLine("PASS: timer multi-instance concurrency ok");
    }
}
