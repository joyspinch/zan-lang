using System;
using Gui;
using Gui.Widget;

/// Regression guard (stdlib side): Gui/Html.zan builds its tag ->
/// control mapping with bare widget names, so it must import Gui.Widget
/// itself. Before the import, resolution relied on the binder's global
/// unique-simple-name fallback, which dies the moment a user project
/// declares a global class of the same name (e.g. `class TextArea`):
/// Html.Parse failed with "undefined type 'TextArea'".
/// With the import the mapping pins the stdlib types regardless of the
/// user's shadow classes, and the built tree still holds real widgets.
class TextArea {
    static string Tag() => "user-textarea";
}

class Image {
    static string Tag() => "user-image";
}

class Program {
    static int fails;

    static void Eq(string what, bool got, bool want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got " + got
                          + " want " + want);
    }

    static int Main() {
        Console.WriteLine(TextArea.Tag());
        Console.WriteLine(Image.Tag());

        HtmlDoc doc = Html.Parse(
            "<textarea id=\"ta\">hi</textarea>"
            + "<img id=\"pic\" src=\"a.png\" alt=\"p\"/>"
            + "<button id=\"btn\">Go</button>", "", new HtmlHandlers());
        if (doc == null || doc.root == null) {
            Console.WriteLine("FAIL no parse root");
            return 1;
        }
        // The mapped controls are the stdlib widgets, not the user's
        // shadow classes: a user `class TextArea` has neither the widget's
        // Kind() nor its text protocol, so the kind checks below pin the
        // real types (the shadow classes can't masquerade as widgets).
        Control ta = doc.root.Find("ta");
        Control pic = doc.root.Find("pic");
        Control btn = doc.root.Find("btn");
        Eq("textarea mapped to stdlib widget",
           ta != null && ta.Kind() == "TextArea", true);
        Eq("image mapped to stdlib widget",
           pic != null && pic.Kind() == "Image", true);
        Eq("button mapped to stdlib widget",
           btn != null && btn.Kind() == "Button", true);

        if (fails == 0) { Console.WriteLine("HTML_WIDGET_SHADOW_OK"); }
        return fails == 0 ? 0 : 1;
    }
}
