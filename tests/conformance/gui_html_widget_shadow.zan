using System;
using Gui;
using Gui.Widget;

// 核心契约与语义定义。
class TextArea {
    static string Tag() => "user-textarea";
}

class Image {
    static string Tag() => "user-image";
}

class Program {
    static int fails;

    static void Eq(string what, bool got, bool want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got " + got
                          + " want " + want);
    }

    static int Main() {
        Console.WriteLine(TextArea.Tag());
        Console.WriteLine(Image.Tag());

        HtmlDoc doc = Html.Parse(
            "<textarea id=\"ta\">hi</textarea>"
            + "<img id=\"pic\" src=\"a.png\" alt=\"p\"/>"
            + "<button id=\"btn\">Go</button>", "", new HtmlHandlers());
        if (doc == null || doc.root == null) {
            Console.WriteLine("FAIL no parse root");
            return 1;
        }
        // 核心契约与语义定义。
        Control ta = doc.root.Find("ta");
        Control pic = doc.root.Find("pic");
        Control btn = doc.root.Find("btn");
        Eq("textarea mapped to stdlib widget",
           ta != null && ta.Kind() == "TextArea", true);
        Eq("image mapped to stdlib widget",
           pic != null && pic.Kind() == "Image", true);
        Eq("button mapped to stdlib widget",
           btn != null && btn.Kind() == "Button", true);

        if (fails == 0) { Console.WriteLine("HTML_WIDGET_SHADOW_OK"); }
        return fails == 0 ? 0 : 1;
    }
}
