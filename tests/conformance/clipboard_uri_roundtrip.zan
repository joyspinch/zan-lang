// 核心契约与语义定义。
using System;
using System.Windows.Clipboard;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        string path = "/tmp/测试 dir/a%#'&\n.txt";
        string uri = Clipboard.FileUri(path);
        if (uri != "file:///tmp/%e6%b5%8b%e8%af%95%20dir/a%25%23%27%26%0a.txt") { bad = bad + 1; }
        if (Clipboard.PathFromUri(uri) != path) { bad = bad + 1; }
        #if !WINDOWS
        string backslashPath = "/tmp/a\\b.txt";
        string backslashUri = Clipboard.FileUri(backslashPath);
        if (backslashUri != "file:///tmp/a%5cb.txt"
            || Clipboard.PathFromUri(backslashUri) != backslashPath) { bad = bad + 1; }
        #endif
        if (Clipboard.PathFromUri("file:///tmp/%E6%B5%8B%E8%AF%95") != "/tmp/测试") { bad = bad + 1; }
        if (Clipboard.PathFromUri("file://localhost/tmp/a%20b") != "/tmp/a b") { bad = bad + 1; }
        if (Clipboard.PathFromUri("file://remote.example/tmp/a") != "") { bad = bad + 1; }
        if (Clipboard.PathFromUri("https://example.com/tmp/a") != "") { bad = bad + 1; }
        if (Clipboard.PathFromUri("file:///tmp/literal%") != "/tmp/literal%") { bad = bad + 1; }
        Console.WriteLine("clip-uri-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
