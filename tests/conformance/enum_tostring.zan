// 核心契约与语义定义。
// 核心契约与执行状态转移规范。
using System;

namespace P;

enum Color {
    Red,
    Green = 10,
    Olive = 10,
    Blue,
}

class Program {
    static Color Pick(int n) {
        return (Color)n;
    }

    static void Main() {
        Color c = Color.Green;
        Console.WriteLine(c.ToString());
        Console.WriteLine(Pick(0).ToString());
        Console.WriteLine(Pick(11).ToString());
        Console.WriteLine(Pick(10).ToString());
        Console.WriteLine(Pick(42).ToString());
    }
}
