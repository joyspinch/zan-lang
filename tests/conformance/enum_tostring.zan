// enum.ToString() must yield the member name (C# semantics), not the number:
// the running counter starts at 0, an explicit `= n` resets it, an unmatched
// value formats as its number, and the earliest declared member wins a
// duplicated value.
using System;

namespace P;

enum Color {
    Red,
    Green = 10,
    Olive = 10,
    Blue,
}

class Program {
    static Color Pick(int n) {
        return (Color)n;
    }

    static void Main() {
        Color c = Color.Green;
        Console.WriteLine(c.ToString());
        Console.WriteLine(Pick(0).ToString());
        Console.WriteLine(Pick(11).ToString());
        Console.WriteLine(Pick(10).ToString());
        Console.WriteLine(Pick(42).ToString());
    }
}
