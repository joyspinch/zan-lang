// Shape (top -> bottom):
// -> throw
using System;

class Boom : Exception {
    Boom(string m) { Message = m; }
}

class Bag {
    string tag;
    List<string> rows;

    static Bag Of(string tag) {
        Bag b = new Bag();
        b.tag = tag;
        b.rows = new List<string>();
        b.rows.Add(tag);
        return b;
    }
}

class Mixed {
    static void SyncInner(bool bad) {
        Bag inner = Bag.Of("inner");
        if (bad) { throw new Boom("inner failed"); }
        Console.WriteLine("inner ok " + inner.tag);
    }

    static void SyncOuter(bool bad) {
        Bag outer = Bag.Of("outer");
        Mixed.SyncInner(bad);
        Console.WriteLine("outer ok " + outer.tag);
    }

    static async Bag Fetch(string tag) {
        await Task.Delay(1);
        return Bag.Of(tag);
    }

    static async int Mid(bool bad) {
        Bag mid = await Mixed.Fetch("mid");
        Mixed.SyncOuter(bad);
        return mid.rows.Count;
    }

    static async string Top(bool bad) {
        string note = "start";
        Bag held = await Mixed.Fetch("held");
        try {
            note = "before";
            int n = await Mixed.Mid(bad);
            note = "n=" + n;
        } catch (Boom e) {
            return held.tag + "/" + note + "/" + e.Message;
        }
        return held.tag + "/" + note;
    }

    static async string Driven(bool bad) {
        Bag drv = Bag.Of("drv");
        try {
            int n = await Mixed.Mid(bad);
            return drv.tag + "/n=" + n;
        } catch (Boom e) {
            return drv.tag + "/" + e.Message;
        }
    }

    static async int Main() {
        Console.WriteLine(await Mixed.Top(false));
        Console.WriteLine(await Mixed.Top(true));
        Console.WriteLine(await Mixed.Driven(false));
        Console.WriteLine(await Mixed.Driven(true));
        for (int i = 0; i < 3; i = i + 1) {
            Console.WriteLine(await Mixed.Top(true));
        }
        return 0;
    }
}
