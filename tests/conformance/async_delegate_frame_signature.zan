using System;

delegate string ReadText();
delegate double Scale(double input);
delegate Item ReadItem();

class Item {
    int value;
}

class Holder {
    ReadText text;
    Scale scale;
    ReadItem item;
}

class Program {
    static void Check(bool ok) {
        if (!ok) { throw new Exception("async delegate signature"); }
    }

    static async Holder Make() {
        string text = "root" + "-value";
        double factor = 1.5;
        Item item = new Item();
        item.value = 17;
        ReadText read = () => text;
        Scale scale = input => input * factor;
        ReadItem readItem = () => item;
        await Task.Yield();
        Check(read() == "root-value" && scale(2.5) == 3.75);
        Item first = readItem();
        Check(first.value == 17);
        for (int i = 0; i < 3; i = i + 1) {
            string text = "loop-" + Convert.ToString(i);
            await Task.Yield();
            Check(text == "loop-" + Convert.ToString(i));
        }
        await Task.Delay(1);
        Check(read() == "root-value" && text == "root-value");
        Check(readItem().value == 17 && scale(3.0) == 4.5);
        Holder result = new Holder();
        result.text = read;
        result.scale = scale;
        result.item = readItem;
        return result;
    }

    static async void Main() {
        Holder holder = await Make();
        await Task.Yield();
        Check(holder.text() == "root-value");
        Check(holder.scale(4.0) == 6.0 && holder.item().value == 17);
        Console.WriteLine("async delegates ok");
    }
}
