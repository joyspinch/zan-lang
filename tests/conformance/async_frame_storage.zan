using System;
using System.Collections.Generic;

// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
delegate int SlotRead();
delegate string SlotText();
delegate void SlotChange();

class SlotObject {
    int value;
    static SlotObject Make(int value) {
        SlotObject item = new SlotObject();
        item.value = value;
        return item;
    }
}

class SlotCounter {
    int total;
    SlotRead peek;

    async int Exercise(int start, string prefix, SlotObject input, int[] values) {
        int value = start;
        long wide = 5000000000;
        double fraction = 1.25;
        bool flag = true;
        string text = prefix + "-local";
        SlotObject current = input;
        int[] numbers = values;
        string[] words = new string[2];
        words[0] = text;
        words[1] = "tail";
        SlotObject[] objects = new SlotObject[2];
        objects[0] = current;
        objects[1] = SlotObject.Make(20);
        SlotRead read = () => value + current.value + numbers[1];
        SlotText readText = () => text;
        SlotChange change = () => {
            value = value + 3;
            text = text + "!";
            current.value = current.value + 2;
            numbers[1] = numbers[1] + 1;
        };
        await Task.Yield();
        Program.Check(value == 5 && wide == 5000000000 && fraction == 1.25
            && flag && this.total == 40, "scalar/this");
        change();
        await Task.Delay(1);
        Program.Check(read() == 25 && readText() == "root-local!", "capture");
        for (int i = 0; i < 3; i = i + 1) {
            string text = prefix + "-loop-" + Convert.ToString(i);
            await Task.Yield();
            Program.Check(text == "root-loop-" + Convert.ToString(i), "shadow");
            value = value + 1;
        }
        this.total = this.total + value;
        this.peek = read;
        words[1] = text;
        objects[1].value = objects[1].value + numbers[1];
        await Task.Yield();
        Program.Check(start == 5 && prefix == "root" && wide == 5000000000
            && fraction == 1.25 && flag && this.total == 51, "parameters");
        Program.Check(read() == 28 && readText() == "root-local!", "capture/loop");
        Program.Check(words[0] == "root-local" && words[1] == "root-local!"
            && objects[0].value == 12 && objects[1].value == 25
            && numbers[1] == 5, "reference arrays");
        return this.total;
    }

    async int Exit(bool fail) {
        int count = this.total;
        string label = "exit-" + Convert.ToString(count);
        SlotObject held = SlotObject.Make(9);
        try {
            await Task.Yield();
            if (fail) { throw new Exception(label); }
            return count + held.value;
        } catch (Exception e) {
            // 接口数据协议与执行契约。
            string message = e.Message;
            await Task.Delay(1);
            Program.Check(e.Message == message && message == label
                && held.value == 9 && count == this.total, "catch locals");
            Console.WriteLine("caught=" + message);
            return held.value + 1;
        } finally {
            await Task.Yield();
            Program.Check(label == "exit-" + Convert.ToString(count)
                && held.value == 9, "finally locals");
            held.value = held.value + 1;
            this.total = this.total + held.value;
            Console.WriteLine("finally=" + label);
        }
    }

    async int CancelAt(int phase, SlotObject survivor, int[] external) {
        string text = "cancel-" + Convert.ToString(survivor.value);
        string[] labels = new string[1];
        labels[0] = text;
        SlotObject[] owned = new SlotObject[2];
        owned[0] = survivor;
        owned[1] = SlotObject.Make(99);
        SlotObject local = owned[1];
        SlotRead read = () => local.value + external[0] + this.total;
        await Task.Yield();
        Program.Check(read() == 173 && labels[0] == "cancel-12"
            && owned[0].value == 12, "cancel captures");
        Program.cancelChecks = Program.cancelChecks + 1;
        if (phase == 1) { Task.Cancel(Program.cancelHandle); }
        await Task.Delay(1);
        Program.cancelChecks = Program.cancelChecks + 1;
        if (phase == 2) { Task.Cancel(Program.cancelHandle); }
        await Task.Yield();
        Program.cancelAfter = Program.cancelAfter + 1;
        // 接口数据协议与执行契约。
        SlotObject late = SlotObject.Make(1000);
        return late.value + read();
    }
}

class Program {
    static long cancelHandle;
    static int cancelChecks;
    static int cancelAfter;

    static void Check(bool ok, string label) {
        if (!ok) {
            Console.WriteLine("failed=" + label);
            throw new Exception("frame storage: " + label);
        }
    }

    static async int Number(int value) {
        await Task.Yield();
        return value;
    }
    static async string Text(string value) {
        await Task.Delay(1);
        return value;
    }
    static async SlotObject Object(int value) {
        await Task.Yield();
        return SlotObject.Make(value);
    }
    static async int[] Numbers(int value) {
        int[] result = new int[1];
        result[0] = value;
        await Task.Yield();
        return result;
    }

    static async int Expressions() {
        // 接口数据协议与执行契约。
        int pair = await Program.Number(2) * 10 + await Program.Number(3);
        string text = await Program.Text("left") + ":" + await Program.Text("right");
        int fields = (await Program.Object(7)).value * 10 + (await Program.Object(8)).value;
        int element = (await Program.Numbers(4))[0] + await Program.Number(6);
        Program.Check(pair == 23 && text == "left:right"
            && fields == 78 && element == 10, "ANF temporaries");
        return pair + fields + element;
    }

    static async void Main() {
        SlotCounter counter = new SlotCounter();
        counter.total = 40;
        SlotObject survivor = SlotObject.Make(10);
        int[] values = new int[2];
        values[0] = 3;
        values[1] = 4;
        Console.WriteLine("locals=" + Convert.ToString(await counter.Exercise(5, "root", survivor, values)));
        // 接口数据协议与执行契约。
        Program.Check(counter.peek() == 28, "escaped capture");
        values[1] = values[1] + 1;
        await Task.Yield();
        Program.Check(counter.peek() == 29, "escaped capture aliases");
        values[1] = values[1] - 1;
        Console.WriteLine("anf=" + Convert.ToString(await Program.Expressions()));
        Console.WriteLine("return=" + Convert.ToString(await counter.Exit(false)));
        Console.WriteLine("catch=" + Convert.ToString(await counter.Exit(true)));
        for (int phase = 1; phase <= 2; phase = phase + 1) {
            Program.cancelHandle = Task.Spawn(counter.CancelAt(phase, survivor, values));
            List<long> handles = new List<long>();
            handles.Add(Program.cancelHandle);
            int joined = await Task.WhenAll(handles);
            Program.Check(joined == 1 && Task.IsDone(Program.cancelHandle) != 0, "cancel completed");
            Program.Check(survivor.value == 12 && values[0] == 3
                && values[1] == 5 && counter.total == 71, "cancel surviving owners");
        }
        Program.Check(Program.cancelChecks == 3 && Program.cancelAfter == 0, "cancel boundary");
        Console.WriteLine("cancel=" + Convert.ToString(Program.cancelChecks)
            + ":" + Convert.ToString(Program.cancelAfter) + ":" + Convert.ToString(counter.total));
        Console.WriteLine("done");
    }
}
