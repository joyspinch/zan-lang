using System;
using System.IO;

public class Program {
    static int Main() {
        string mcpFile = "tools/mcp_server/McpServer.zan";
        if (!File.Exists(mcpFile)) {
            Console.WriteLine($"FAIL: {mcpFile} does not exist");
            return 1;
        }

        string text = File.ReadAllText(mcpFile);
        if (text.Contains("tools/repomap/RepoMap.zan")) {
            Console.WriteLine("FAIL: McpServer.zan still contains deprecated single-file command: tools/repomap/RepoMap.zan");
            return 1;
        }

        if (!text.Contains("scripts/build_repomap.ps1")) {
            Console.WriteLine("FAIL: McpServer.zan does not contain scripts/build_repomap.ps1");
            return 1;
        }

        Console.WriteLine("mcp-repomap-msg-ok: 1");
        return 0;
    }
}
