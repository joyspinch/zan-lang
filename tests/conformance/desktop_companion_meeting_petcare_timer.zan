using System;
using System.Windows;

class Program {
    static int Main() {
        // 1. 日历会议与投屏免打扰守卫
        CompanionMeetingDndGuard dnd = new CompanionMeetingDndGuard(5);
        dnd.AddMeeting(600, 660); // 10:00..11:00，会前 5 分钟开始静默
        bool freeBefore = !dnd.ShouldSuppressAlerts(590);
        bool preBufferDnd = dnd.ShouldSuppressAlerts(596);
        bool inMeetingDnd = dnd.ShouldSuppressAlerts(620);
        bool freeAfter = !dnd.ShouldSuppressAlerts(660);
        dnd.ScreenSharingActive = true;
        bool shareDnd = dnd.ShouldSuppressAlerts(700);
        Console.WriteLine("meeting_dnd_ok=" + ((freeBefore && preBufferDnd && inMeetingDnd && freeAfter && shareDnd) ? "1" : "0"));

        // 2. 桌面宠物饱食/精力/情绪养成循环
        CompanionPetMealAndEnergy pet = new CompanionPetMealAndEnergy(10.0f);
        pet.StepMinutes(100.0f); // Hunger 80-60=20 (<30), Energy 85-40=45
        bool needHungry = pet.PrimaryNeedCue() == "hungry";
        bool feed1 = pet.TryFeed(50.0f); // Hunger -> 70
        bool blockedOverfeed = !pet.TryFeed(20.0f); // 冷却期内禁止暴食
        pet.StepMinutes(10.0f);
        bool needHappy = pet.PrimaryNeedCue() == "happy";
        Console.WriteLine("pet_care_ok=" + ((needHungry && feed1 && blockedOverfeed && needHappy) ? "1" : "0"));

        // 3. 快捷多预设倒计时器
        CompanionQuickTimerPresets timer = new CompanionQuickTimerPresets();
        timer.RegisterPreset("tea_steep", 180);
        bool started = timer.StartPreset("tea_steep");
        bool midNotDone = !timer.TickSeconds(90);
        int pctHalf = timer.ProgressPercent(); // 50
        timer.Paused = true;
        bool pausedNoTick = !timer.TickSeconds(90);
        timer.Paused = false;
        bool finished = timer.TickSeconds(90);
        bool timerOk = started && midNotDone && pctHalf == 50 && pausedNoTick && finished && timer.CompletedFlag;
        Console.WriteLine("quick_timer_ok=" + (timerOk ? "1" : "0"));
        return 0;
    }
}
