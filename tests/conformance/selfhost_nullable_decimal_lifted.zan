using System;

class SelfhostNullableDecimalLifted {
    static int trace;
    static int leftCalls;
    static int rightCalls;
    static int indexCalls;
    static decimal? Left(bool empty) {
        trace = trace * 10 + 1; leftCalls++;
        if (empty) { return null; }
        return 9007199254740993m;
    }
    static decimal? Right(bool empty) {
        trace = trace * 10 + 2; rightCalls++;
        if (empty) { return null; }
        return 0.1m;
    }
    static int Index() { indexCalls++; return 0; }
    static void Order(bool leftEmpty, bool rightEmpty) {
        trace = 0; leftCalls = 0; rightCalls = 0;
        decimal? value = Left(leftEmpty) + Right(rightEmpty);
        Console.WriteLine(trace == 12 && leftCalls == 1 && rightCalls == 1);
        if (leftEmpty || rightEmpty) { Console.WriteLine(value == null); }
        else { Console.WriteLine(value == 9007199254740993.1m); }
    }
    static void Main() {
        Order(false, false); Order(true, false);
        Order(false, true); Order(true, true);
        decimal? wide = 9007199254740993m;
        decimal? tenth = 0.1m;
        decimal? absent = null;
        decimal? two = 2m;
        decimal? three = 3m;
        Console.WriteLine(wide + tenth == 9007199254740993.1m);
        Console.WriteLine(wide - tenth == 9007199254740992.9m);
        Console.WriteLine(wide * two == 18014398509481986m);
        Console.WriteLine(wide / three == 3002399751580331m);
        Console.WriteLine(wide % two == 1m);
        Console.WriteLine(wide + 1 == 9007199254740994m);
        Console.WriteLine(1 + wide == 9007199254740994m);
        Console.WriteLine(9007199254740994m - wide == 1m);
        Console.WriteLine(2m * wide == 18014398509481986m);
        Console.WriteLine(18014398509481986m / wide == 2m);
        Console.WriteLine(9007199254740994m % wide == 1m);
        Console.WriteLine(absent + tenth == null);
        Console.WriteLine(tenth - absent == null);
        Console.WriteLine(absent * two == null);
        Console.WriteLine(absent / 0 == null);
        Console.WriteLine(absent % 0 == null);
        Console.WriteLine(1 + absent == null);
        Console.WriteLine(1m - absent == null);
        Console.WriteLine(2m * absent == null);
        Console.WriteLine(1m / absent == null);
        Console.WriteLine(1m % absent == null);
        decimal? small = 0.0000000000000000000000000001m;
        Console.WriteLine(small + small == 0.0000000000000000000000000002m);
        Console.WriteLine(tenth + 0.2m == 0.3m);
        decimal? scaled = 1.00m;
        decimal? unit = 1m;
        Console.WriteLine(scaled == unit);
        Console.WriteLine(!(scaled != unit));
        Console.WriteLine(scaled <= unit && scaled >= unit);
        Console.WriteLine(!(absent < unit) && !(absent > unit));
        Console.WriteLine(!(absent <= unit) && !(absent >= unit));
        decimal? otherAbsent = null;
        Console.WriteLine(absent == otherAbsent && !(absent != otherAbsent));
        Console.WriteLine(absent != unit && !(absent == unit));
        Console.WriteLine(unit == 1 && 1 == unit);
        decimal? compound = wide;
        compound += tenth; Console.WriteLine(compound == 9007199254740993.1m);
        compound -= tenth; Console.WriteLine(compound == wide);
        compound *= two; Console.WriteLine(compound == 18014398509481986m);
        compound /= three; Console.WriteLine(compound == 6004799503160662m);
        compound %= two; Console.WriteLine(compound == 0m);
        compound = null;
        compound += tenth; Console.WriteLine(compound == null);
        compound -= tenth; Console.WriteLine(compound == null);
        compound *= two; Console.WriteLine(compound == null);
        compound /= 0; Console.WriteLine(compound == null);
        compound %= 0; Console.WriteLine(compound == null);
        trace = 0; rightCalls = 0;
        compound += Right(false);
        Console.WriteLine(compound == null && trace == 2 && rightCalls == 1);
        decimal? inc = wide;
        decimal? old = inc++;
        Console.WriteLine(old == wide && inc == 9007199254740994m);
        decimal? current = ++inc;
        Console.WriteLine(current == 9007199254740995m && inc == current);
        old = inc--;
        Console.WriteLine(old == 9007199254740995m && inc == 9007199254740994m);
        current = --inc;
        Console.WriteLine(current == wide && inc == wide);
        Console.WriteLine(-wide == -9007199254740993m && +wide == wide);
        Console.WriteLine(-absent == null && +absent == null);
        old = absent++; current = ++absent;
        Console.WriteLine(old == null && current == null && absent == null);
        old = absent--; current = --absent;
        Console.WriteLine(old == null && current == null && absent == null);
        decimal?[] slots = new decimal?[] { wide };
        indexCalls = 0;
        slots[Index()] += tenth;
        Console.WriteLine(indexCalls == 1 && slots[0] == 9007199254740993.1m);
        indexCalls = 0;
        old = slots[Index()]++;
        Console.WriteLine(indexCalls == 1 && old == 9007199254740993.1m && slots[0] == 9007199254740994.1m);
    }
}
