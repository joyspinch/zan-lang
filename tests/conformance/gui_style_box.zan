using System;
using Gui;

// 控件样式解析的统一入口（Control.Box / BoxState）。
//
// 契约：
//  1) Box(app) 解析出的盒子与"自己拼 Style.Full(type, Class, name)"
//     的老路径一致——统一入口不是换一种算法，是换一条路。
//  2) 控件上显式设的背景（Bg()）在统一入口下生效：老路径直接调
//     Style.Of 时读不到控件自己的样式设置器。
//  3) 解析用的类进缓存键：同一控件用同一个类型、两个不同类各解析
//     一次，第二次不能拿到第一次的盒子。
class StyleBoxTest {
    static int fails;

    static void Chk(bool ok, string what) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Main() {
        App app = App.CreateOffscreen("style box", 320, 240);

        Button b = new Button { Text = "OK" };
        b.name = "box-probe";

        // 1) 与老路径等价。
        StyleBox viaBox = b.Box(app);
        StyleBox viaOld = Style.Full(app, b.StyleType(), b.Class, b.name,
                                     Style.SNormal());
        Console.WriteLine("height " + viaBox.height + " pad " + viaBox.padL
            + " radius " + viaBox.radius);
        Chk(viaBox.height == viaOld.height, "box height matches the old path");
        Chk(viaBox.padL == viaOld.padL, "box padding matches the old path");
        Chk(viaBox.padR == viaOld.padR, "box right padding matches");
        Chk(viaBox.radius == viaOld.radius, "box radius matches the old path");
        Chk(viaBox.bg == viaOld.bg, "box background matches the old path");

        // 2) 控件自己的样式设置器在统一入口下生效。
        b.Bg(0xFF112233);
        StyleBox inl = b.Box(app);
        Console.WriteLine("inline bg " + inl.bg);
        Chk(inl.bg == 0xFF112233, "inline background applies");
        b.Bg(0);

        // 3) 解析用的类进缓存键。
        StyleBox p = b.ResolveStyleCached(app, "button", "primary",
                                          Style.SNormal());
        StyleBox e = b.ResolveStyleCached(app, "button", "error",
                                          Style.SNormal());
        Console.WriteLine("primary bg " + p.bg + " error bg " + e.bg);
        Chk(p.bg != e.bg, "the resolved class is part of the cache key");

        if (fails == 0) {
            Console.WriteLine("gui style box OK");
        } else {
            Console.WriteLine("gui style box FAILS " + fails);
        }
    }
}
