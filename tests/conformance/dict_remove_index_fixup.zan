// Dict 删除就地修正索引（墓碑 + 下标前移）对拍：随机增删查与插入序对照模型。
// 覆盖：删除后立即查找/插入、墓碑累积触发整表重建、整数与字符串键、删尾/删头/删中。
using System;
using System.Collections.Generic;
namespace Conf;
class Program {
    static long seed = 12345;
    static int Next(int n) {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        return (int)(seed % n);
    }
    static bool CheckInt(Dict<int, int> d, List<int> ks, List<int> vs) {
        if (d.Count != ks.Count) { return false; }
        int i = 0;
        foreach (int k in d.Keys) {
            if (k != ks[i] || d[k] != vs[i]) { return false; }
            i = i + 1;
        }
        for (int j = 0; j < ks.Count; j = j + 1) {
            if (!d.ContainsKey(ks[j]) || d[ks[j]] != vs[j]) { return false; }
        }
        return true;
    }
    static void Main() {
        Dict<int, int> d = new Dict<int, int>();
        List<int> ks = new List<int>();
        List<int> vs = new List<int>();
        bool ok = true;
        for (int step = 0; step < 20000; step = step + 1) {
            int op = Next(10);
            int k = Next(300);
            int at = ks.IndexOf(k);
            if (op < 4) {
                bool rm = d.Remove(k);
                if (rm != (at >= 0)) { ok = false; }
                if (at >= 0) { ks.RemoveAt(at); vs.RemoveAt(at); }
            } else if (op < 8) {
                d[k] = step;
                if (at >= 0) { vs[at] = step; } else { ks.Add(k); vs.Add(step); }
            } else {
                if (d.ContainsKey(k) != (at >= 0)) { ok = false; }
            }
            if (step % 997 == 0 && !CheckInt(d, ks, vs)) { ok = false; }
        }
        Console.WriteLine("int model: " + (ok && CheckInt(d, ks, vs)));

        // 删光再填：墓碑满载后必须整表重建，查找不能死循环
        Dict<int, int> t = new Dict<int, int>();
        for (int r = 0; r < 50; r = r + 1) {
            for (int i = 0; i < 100; i = i + 1) { t[r * 1000 + i] = i; }
            for (int i = 0; i < 100; i = i + 1) { t.Remove(r * 1000 + i); }
        }
        Console.WriteLine("drain count: " + t.Count + " miss: " + t.ContainsKey(49099));

        Dict<string, int> s = new Dict<string, int>();
        for (int i = 0; i < 200; i = i + 1) { s["k" + i] = i; }
        for (int i = 0; i < 200; i = i + 2) { s.Remove("k" + i); }
        s.Remove("k199");
        s["k0"] = 1000;
        long sum = 0;
        string order = "";
        int n = 0;
        foreach (string k in s.Keys) {
            sum = sum + s[k];
            if (n < 3) { order = order + k + ","; }
            n = n + 1;
        }
        Console.WriteLine("str count: " + s.Count + " sum: " + sum + " head: " + order);
        Console.WriteLine("str lookups: " + s.ContainsKey("k1") + " " + s.ContainsKey("k2") + " " + s["k197"]);
    }
}
