using System;

class OriginalError : Exception {
    public OriginalError(string text) : base(text) { }
}

class NestedError : Exception {
    public NestedError(string text) : base(text) { }
}

class OwnedObject {
    public string Text;
    public int Value;
    public OwnedObject(string text, int value) { Text = text; Value = value; }
}

struct OwnedRecord {
    public string Text;
    public OwnedObject Item;
    public int[] Numbers;
    public long Stamp;
}

class PendingOwners {
    static int texts;
    static int objects;
    static int records;
    static int inner;
    static int outer;
    static int caught;
    static int replaced;
    static int originals;
    static int child;
    static int childResumed;
    static int sync;
    static int direct;
    static int exceptionInner;
    static int exceptionOuter;
    static int exceptionCaught;
    static int survived;

    static void Check(bool ok) {
        if (!ok) { throw new Exception("finally pending owners"); }
    }

    // 测试断言与状态转移验证。
    static string MakeText(string role, int value) {
        texts = texts + 1;
        return role + "-" + Convert.ToString(value);
    }

    static OwnedObject MakeObject(string role, int value) {
        objects = objects + 1;
        return new OwnedObject(MakeText(role, value), value);
    }

    static OwnedRecord MakeRecord(string role, int value) {
        records = records + 1;
        OwnedRecord result;
        result.Text = MakeText(role, value);
        result.Item = MakeObject(role + "-item", value + 100);
        result.Numbers = new int[] { value, value + 1 };
        result.Stamp = 1234567890123L + value;
        return result;
    }

    static async int ChildThrow(int mode) {
        child = child + 1;
        if (mode == 1) {
            await Task.Yield();
            childResumed = childResumed + 1;
        }
        throw new NestedError("B-" + Convert.ToString(mode));
    }

    static void SyncThrow(int mode) {
        sync = sync + 1;
        throw new NestedError("B-" + Convert.ToString(mode));
    }

    // 测试断言与状态转移验证。
    static async string Strings(int mode, bool originalThrow) {
        try {
            if (originalThrow) {
                originals = originals + 1;
                throw new OriginalError("A-" + Convert.ToString(mode));
            }
            return MakeText("R", mode);
        } finally {
            await Task.Yield();
            try {
                try {
                    return MakeText("S", mode);
                } finally {
                    await Task.Yield();
                    inner = inner + 1;
                    if (mode < 2) { await ChildThrow(mode); Check(false); }
                    if (mode == 2) { SyncThrow(mode); Check(false); }
                    if (mode == 3) {
                        direct = direct + 1;
                        throw new NestedError("B-" + Convert.ToString(mode));
                    }
                    replaced = replaced + 1;
                }
            } catch (NestedError error) {
                // 测试断言与状态转移验证。
                Check(error.Message == "B-" + Convert.ToString(mode));
                caught = caught + 1;
                await Task.Yield();
            }
            await Task.Yield();
            outer = outer + 1;
        }
    }

    static async OwnedObject Objects(int mode, bool originalThrow) {
        try {
            if (originalThrow) {
                originals = originals + 1;
                throw new OriginalError("A-" + Convert.ToString(mode));
            }
            return MakeObject("R", mode);
        } finally {
            await Task.Yield();
            try {
                try {
                    return MakeObject("S", mode);
                } finally {
                    await Task.Yield();
                    inner = inner + 1;
                    if (mode < 2) { await ChildThrow(mode); Check(false); }
                    if (mode == 2) { SyncThrow(mode); Check(false); }
                    if (mode == 3) {
                        direct = direct + 1;
                        throw new NestedError("B-" + Convert.ToString(mode));
                    }
                    replaced = replaced + 1;
                }
            } catch (NestedError error) {
                // 测试断言与状态转移验证。
                Check(error.Message == "B-" + Convert.ToString(mode));
                caught = caught + 1;
                await Task.Yield();
            }
            await Task.Yield();
            outer = outer + 1;
        }
    }

    static async Task<OwnedRecord> Records(int mode, bool originalThrow) {
        try {
            if (originalThrow) {
                originals = originals + 1;
                throw new OriginalError("A-" + Convert.ToString(mode));
            }
            return MakeRecord("R", mode);
        } finally {
            await Task.Yield();
            try {
                try {
                    return MakeRecord("S", mode);
                } finally {
                    await Task.Yield();
                    inner = inner + 1;
                    if (mode < 2) { await ChildThrow(mode); Check(false); }
                    if (mode == 2) { SyncThrow(mode); Check(false); }
                    if (mode == 3) {
                        direct = direct + 1;
                        throw new NestedError("B-" + Convert.ToString(mode));
                    }
                    replaced = replaced + 1;
                }
            } catch (NestedError error) {
                // 测试断言与状态转移验证。
                Check(error.Message == "B-" + Convert.ToString(mode));
                caught = caught + 1;
                await Task.Yield();
            }
            await Task.Yield();
            outer = outer + 1;
        }
    }

    static void CheckRecord(OwnedRecord value, string role, int number) {
        Check(value.Text == role + "-" + Convert.ToString(number));
        Check(value.Item.Text == role + "-item-" + Convert.ToString(number + 100));
        Check(value.Item.Value == number + 100);
        Check(value.Numbers[0] == number && value.Numbers[1] == number + 1);
        Check(value.Stamp == 1234567890123L + number);
    }

    static async int PreserveException(int mode) {
        try {
            originals = originals + 1;
            throw new OriginalError("A-" + Convert.ToString(mode));
        } finally {
            await Task.Yield();
            try {
                try {
                    if (mode < 2) { await ChildThrow(mode); Check(false); }
                    if (mode == 2) { SyncThrow(mode); Check(false); }
                    direct = direct + 1;
                    throw new NestedError("B-" + Convert.ToString(mode));
                } finally {
                    // 测试断言与状态转移验证。
                    await Task.Yield();
                    exceptionInner = exceptionInner + 1;
                }
            } catch (NestedError error) {
                // 核心契约与语义定义。
                Check(error.Message == "B-" + Convert.ToString(mode));
                exceptionCaught = exceptionCaught + 1;
                await Task.Yield();
            }
            await Task.Yield();
            exceptionOuter = exceptionOuter + 1;
        }
    }

    static async void Main() {
        for (int mode = 0; mode < 4; mode = mode + 1) {
            string text = await Strings(mode, false);
            OwnedObject item = await Objects(mode, false);
            OwnedRecord record = await Records(mode, false);
            await Task.Yield();
            Check(text == "R-" + Convert.ToString(mode));
            Check(item.Text == "R-" + Convert.ToString(mode) && item.Value == mode);
            CheckRecord(record, "R", mode);
        }
        Check(inner == 12 && outer == 12 && caught == 12 && replaced == 0);
        Check(texts == 32 && objects == 16 && records == 8);
        Check(child == 6 && childResumed == 3 && sync == 3 && direct == 3);

        for (int pass = 0; pass < 2; pass = pass + 1) {
            bool originalThrow = pass == 1;
            string text = await Strings(4, originalThrow);
            OwnedObject item = await Objects(4, originalThrow);
            OwnedRecord record = await Records(4, originalThrow);
            await Task.Yield();
            Check(text == "S-4");
            Check(item.Text == "S-4" && item.Value == 4);
            CheckRecord(record, "S", 4);
        }
        Check(inner == 18 && outer == 12 && caught == 12 && replaced == 6);
        Check(texts == 44 && objects == 22 && records == 11 && originals == 3);

        for (int mode = 0; mode < 4; mode = mode + 1) {
            try {
                await PreserveException(mode);
                Check(false);
            } catch (OriginalError error) {
                // 测试断言与状态转移验证。
                Check(error.Message == "A-" + Convert.ToString(mode));
                survived = survived + 1;
                await Task.Yield();
            }
        }
        Check(exceptionInner == 4 && exceptionOuter == 4 && exceptionCaught == 4);
        Check(survived == 4 && originals == 7);
        Check(child == 8 && childResumed == 4 && sync == 4 && direct == 4);
        Check(inner == 18 && outer == 12 && caught == 12 && replaced == 6);
        Check(texts == 44 && objects == 22 && records == 11);
        Console.WriteLine("finally pending owners ok");
    }
}
