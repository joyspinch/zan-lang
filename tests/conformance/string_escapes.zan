// 词法器字符串转义：\x（贪婪 1-4 位 hex，复刻 C# \x26amp 陷阱）与 \u（固定
// 4 位 hex）在普通字符串、插值段、char 三条路径都按 C# 语义解码为 UTF-8；
// 代理区独立出现即编译错误（错误路径由编译器诊断覆盖，此处不触发）。
// 注意：本文件的期望输出按字节写（\x26 = &），贪婪陷阱用 Length 断言。
using System;

class Program {
    static int bad = 0;

    static void Eq(string what, string got, string want) {
        if (got == want) {
            Console.WriteLine("ok " + what);
        } else {
            Console.WriteLine("FAIL " + what + ": got '" + got
                              + "' want '" + want + "'");
            Program.bad = Program.bad + 1;
        }
    }

    static void Main() {
        // 普通字符串：\u 固定 4 位；\x 贪婪 1-4 位。
        Program.Eq("u-basic", "\u4e2d\u6587", "中文");
        Program.Eq("x26", "\x26", "&");
        Program.Eq("x41", "\x41", "A");
        Program.Eq("x1", "\xA", "\n");

        // 贪婪陷阱：\x4Aump 只吃 4A（u 非 hex）→ "Jump"；
        // \x26amp 吃 26a（a 是 hex，0x26A 星体外平面码点）+ "mp" → 长度 4；
        // \xEA6ab 吃满 4 位（0xEA6A，U+EA6A 私用区，3 字节 UTF-8）+ "b" → 长度 4。
        Program.Eq("x-greedy-doc", "\x4Aump", "Jump");
        Program.Eq("x-greedy-trap", Convert.ToString("\x26amp".Length), "4");
        Program.Eq("x-greedy-4", Convert.ToString("\xEA6ab".Length), "4");

        // 插值段内的转义。
        string name = "\u4e2d";
        Program.Eq("interp-escape", $"a\x41{name}b", "aA中b");

        // char 路径（单字节码点）。
        char c = '\x41';
        Program.Eq("char-x", Convert.ToString(c), "A");

        if (Program.bad > 0) {
            Console.WriteLine("fail " + Convert.ToString(Program.bad));
        } else {
            Console.WriteLine("all pass");
        }
    }
}
