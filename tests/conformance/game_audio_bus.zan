using System;
using Game.Foundation;

namespace Tests.GameAudioBus;

class Program {
    static void Main() {
        AudioBus bus = new AudioBus();

        // 1. 默认层级音量测试
        // Master=1.0, Sfx=1.0, Local=0.5 -> 0.5
        double eff1 = bus.EffectiveGain(AudioChannel.Sfx, 0.5);
        Console.WriteLine("sfx_eff1=" + Convert.ToString((int)(eff1 * 100.0)));

        // 调整 Master=0.5, Sfx=0.8, Local=1.0 -> 0.5 * 0.8 * 1.0 = 0.4
        bus.SetMasterVolume(0.5);
        bus.SetSfxVolume(0.8);
        double eff2 = bus.EffectiveGain(AudioChannel.Sfx, 1.0);
        Console.WriteLine("sfx_eff2=" + Convert.ToString((int)(eff2 * 100.0)));

        // 2. 静音测试
        bus.SetSfxMuted(true);
        Console.WriteLine("sfx_muted=" + Convert.ToString(bus.IsSfxMuted()));
        double effMute = bus.EffectiveGain(AudioChannel.Sfx, 1.0);
        Console.WriteLine("sfx_eff_mute=" + Convert.ToString((int)(effMute * 100.0)));
        bus.SetSfxMuted(false);

        // 3. BGM 淡出测试
        // 初始 BgmVolume = 1.0, Master = 1.0
        bus.SetMasterVolume(1.0);
        bus.SetBgmVolume(1.0);
        // 淡出到 0.0，用时 1000ms
        bus.FadeOutBgm(1000);
        Console.WriteLine("fading_start=" + Convert.ToString(bus.IsBgmFading()));

        // 步进 500ms，音量应为 0.5 左右
        bus.Update(500);
        Console.WriteLine("bgm_half=" + Convert.ToString((int)(bus.BgmVolume() * 100.0)));

        // 步进 500ms 完成淡出
        bus.Update(500);
        Console.WriteLine("bgm_done=" + Convert.ToString((int)(bus.BgmVolume() * 100.0)));
        Console.WriteLine("fading_end=" + Convert.ToString(bus.IsBgmFading()));

        // 4. 防爆音限频测试
        // 首次播放，允许
        bool sfx1 = bus.CanPlaySfx("explosion", 200);
        Console.WriteLine("can_play_1=" + Convert.ToString(sfx1));

        // 步进 50ms (未满 200ms)，拒绝
        bus.Update(50);
        bool sfx2 = bus.CanPlaySfx("explosion", 200);
        Console.WriteLine("can_play_2=" + Convert.ToString(sfx2));

        // 再步进 160ms (累计 210ms)，允许
        bus.Update(160);
        bool sfx3 = bus.CanPlaySfx("explosion", 200);
        Console.WriteLine("can_play_3=" + Convert.ToString(sfx3));
    }
}
