using System;
using System.Json;

namespace Conf;

class Prog {
    static void CheckReaderNumbers() {
        string[] tokens = new string[] {
            "0", "-0", "001", "-7", "999999999999999999", "-999999999999999999",
            "9223372036854775807", "-9223372036854775808", "-0.0", "1E+2", "-.5",
            "+123", "12+34", "-1-2", "1e", "-", "e", "?", ""
        };
        int[] ends = new int[] { 1, 2, 3, 2, 18, 19, 19, 20, 4, 4, 3, 4, 5, 4, 2, 1, 1, 0, 0 };
        for (int i = 0; i < tokens.Length; i++) {
            string source = "[" + tokens[i] + "]";
            JsonReader reader = JsonReader.Of(source);
            reader.pos = 1;
            JsonValue actual = reader.ReadNumber();
            JsonValue expected = JsonValue.ParseNumberToken(source, 1, 1 + ends[i]);
            if (reader.pos != 1 + ends[i] || actual.numIsInt != expected.numIsInt
            || actual.numI != expected.numI || actual.numRaw != expected.numRaw
            || NativeMemory.AsI64(actual.numD) != NativeMemory.AsI64(expected.numD)) {
                throw new Exception("Lenient numeric token changed: " + tokens[i]);
            }
        }

        JsonReader strict = JsonReader.OfStrict("[-999999999999999999,12+34]");
        JsonValue partial = strict.ReadValue();
        if (!strict.Failed() || strict.errPos != 26 || partial.Count() != 1
        || partial.At(0).AsLong(0L) != -999999999999999999L) {
            throw new Exception("Strict reader changed its numeric error or partial array");
        }
    }

    static void CheckArrayNumbers() {
        JsonValue ordinary = JsonValue.Parse("[2,3,4,5,6,7,8,9007199254740993]");
        JsonValue item = ordinary.At(7);
        if (item != ordinary.At(7) || item != ordinary.items[7]
        || item.AsLong(0L) != 9007199254740993L) {
            throw new Exception("Integer array lost exact values or stable nodes");
        }
        item.numI = 9007199254740995L;
        if (ordinary.At(7).AsLong(0L) != 9007199254740995L) {
            throw new Exception("Integer array node mutation no longer reaches the array");
        }

        string wide = "[9223372036854775807,-9223372036854775808,123456789012345678901,"
        + "-123456789012345678901,1000000000000000000,1000000000000000001,"
        + "1000000000000000002,1000000000000000003]";
        JsonValue integers = JsonValue.Parse(wide);
        if (integers.Count() != 8 || integers.numArr != null || integers.ToJson() != wide
        || integers.At(1).AsLong(0L) != -9223372036854775807L - 1L || !integers.At(2).IsInt()) {
            throw new Exception("Long integer array lost its original tokens");
        }

        string mixed = "[1.25,2e-2,3.5,4.125,5.5,6.5,7.5,9223372036854775807]";
        if (JsonValue.Parse(mixed).ToJson() != mixed) {
            throw new Exception("Floating array compacted a long integer token");
        }
        JsonValue floats = JsonValue.Parse("[1.25,2e-2,3.5,4.125,5.5,6.5,7.5,0.1250000000000000000]");
        if (floats.numArr == null || floats.Count() != 8 || floats.At(7).AsDouble(0.0) != 0.125) {
            throw new Exception("Floating array lost compact storage");
        }
    }

    static void Main() {
        Prog.CheckReaderNumbers();
        Prog.CheckArrayNumbers();
        int bad = 0;
        JsonValue v = JsonValue.Parse(
            "{\"a\":3.14159,\"b\":0.1,\"c\":1e-3,\"d\":1.25e3,"
            + "\"e\":-7.5,\"f\":6.02e23,\"g\":0.30000000000000004}");
        if (v.Double("a", 0) != 3.14159) { bad = bad + 1; }
        if (v.Double("b", 0) != 0.1) { bad = bad + 1; }
        if (v.Double("c", 0) != 0.001) { bad = bad + 1; }
        if (v.Double("d", 0) != 1250.0) { bad = bad + 1; }
        if (v.Double("e", 0) != -7.5) { bad = bad + 1; }
        if (v.Double("f", 0) != 6.02e23) { bad = bad + 1; }
        if (v.Double("g", 0) != 0.30000000000000004) { bad = bad + 1; }
        // 18 位整数仍走整数快路径（无 . e）。
        JsonValue big = JsonValue.Parse("123456789012345678");
        if (!big.IsNumber()) { bad = bad + 1; }
        else if (big.AsLong(0) != 123456789012345678
            && big.AsLong(0) != 123456789012345680) { bad = bad + 1; }
        // 序列化往返：文本 → 树 → 文本 → 树 幂等。
        string j1 = v.ToJson();
        JsonValue re = JsonValue.Parse(j1);
        if (re.ToJson() != j1) { bad = bad + 1; }
        // 字符串直转同源。
        if (JsonValue.DoubleOf("2.675") != 2.675) { bad = bad + 1; }
        if (JsonValue.DoubleOf("-0.5") != -0.5) { bad = bad + 1; }
        if (JsonValue.DoubleOf("1e22") != 1e22) { bad = bad + 1; }
        if (JsonValue.DoubleOf("1e-22") != 1e-22) { bad = bad + 1; }
        // 超大指数 (FloatDoS) 钳制测试：验证极速返回而不陷入数百万次循环
        if (JsonValue.DoubleOf("1e99999999") != JsonValue.DoubleOf("1e400")) { bad = bad + 1; }
        if (JsonValue.DoubleOf("1e-99999999") != 0.0) { bad = bad + 1; }
        JsonDoc tapeHugeExp = JsonDoc.Parse("{\"hi\":1e99999999,\"lo\":1e-99999999}");
        if (tapeHugeExp.DoubleAt(1, 0.0) != JsonValue.DoubleOf("1e400")) { bad = bad + 1; }
        if (tapeHugeExp.DoubleAt(2, 1.0) != 0.0) { bad = bad + 1; }
        // -0.0 负零符号位保留
        long signBit = -0x8000000000000000;
        JsonValue nz = JsonValue.Parse("{\"z\":-0.0}");
        if (NativeMemory.AsI64(nz.Double("z", 1.0)) != signBit) { bad = bad + 1; }
        if (NativeMemory.AsI64(JsonValue.DoubleOf("-0.0")) != signBit) { bad = bad + 1; }
        JsonDoc tapeNz = JsonDoc.Parse("{\"z\":-0.0}");
        if (NativeMemory.AsI64(tapeNz.DoubleAt(1, 1.0)) != signBit) { bad = bad + 1; }
        Console.WriteLine("json-num-precision-ok: "
            + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
