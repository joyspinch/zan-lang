// 核心契约与语义定义。
using System;
using System.Json;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        JsonValue v = JsonValue.Parse(
            "{\"a\":3.14159,\"b\":0.1,\"c\":1e-3,\"d\":1.25e3,"
            + "\"e\":-7.5,\"f\":6.02e23,\"g\":0.30000000000000004}");
        if (v.Double("a", 0) != 3.14159) { bad = bad + 1; }
        if (v.Double("b", 0) != 0.1) { bad = bad + 1; }
        if (v.Double("c", 0) != 0.001) { bad = bad + 1; }
        if (v.Double("d", 0) != 1250.0) { bad = bad + 1; }
        if (v.Double("e", 0) != -7.5) { bad = bad + 1; }
        if (v.Double("f", 0) != 6.02e23) { bad = bad + 1; }
        if (v.Double("g", 0) != 0.30000000000000004) { bad = bad + 1; }
        // 18 位整数仍走整数快路径（无 . e）。
        JsonValue big = JsonValue.Parse("123456789012345678");
        if (!big.IsNumber()) { bad = bad + 1; }
        else if (big.AsLong(0) != 123456789012345678
            && big.AsLong(0) != 123456789012345680) { bad = bad + 1; }
        // 序列化往返：文本 → 树 → 文本 → 树 幂等。
        string j1 = v.ToJson();
        JsonValue re = JsonValue.Parse(j1);
        if (re.ToJson() != j1) { bad = bad + 1; }
        // 字符串直转同源。
        if (JsonValue.DoubleOf("2.675") != 2.675) { bad = bad + 1; }
        if (JsonValue.DoubleOf("-0.5") != -0.5) { bad = bad + 1; }
        if (JsonValue.DoubleOf("1e22") != 1e22) { bad = bad + 1; }
        if (JsonValue.DoubleOf("1e-22") != 1e-22) { bad = bad + 1; }
        // 超大指数 (FloatDoS) 钳制测试：验证极速返回而不陷入数百万次循环
        if (JsonValue.DoubleOf("1e99999999") != JsonValue.DoubleOf("1e400")) { bad = bad + 1; }
        if (JsonValue.DoubleOf("1e-99999999") != 0.0) { bad = bad + 1; }
        JsonDoc tapeHugeExp = JsonDoc.Parse("{\"hi\":1e99999999,\"lo\":1e-99999999}");
        if (tapeHugeExp.DoubleAt(1, 0.0) != JsonValue.DoubleOf("1e400")) { bad = bad + 1; }
        if (tapeHugeExp.DoubleAt(2, 1.0) != 0.0) { bad = bad + 1; }
        // -0.0 负零符号位保留
        long signBit = -0x8000000000000000;
        JsonValue nz = JsonValue.Parse("{\"z\":-0.0}");
        if (NativeMemory.AsI64(nz.Double("z", 1.0)) != signBit) { bad = bad + 1; }
        if (NativeMemory.AsI64(JsonValue.DoubleOf("-0.0")) != signBit) { bad = bad + 1; }
        JsonDoc tapeNz = JsonDoc.Parse("{\"z\":-0.0}");
        if (NativeMemory.AsI64(tapeNz.DoubleAt(1, 1.0)) != signBit) { bad = bad + 1; }
        Console.WriteLine("json-num-precision-ok: "
            + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
