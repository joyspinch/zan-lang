using System;
using System.Collections.Generic;
using System.IO;
using Game.Foundation;

namespace Tests.GameSfxBank;

// 音效库的契约测试：加载（磁盘优先 + 内嵌兜底）、按名播放、限频、
// 没有音频设备时不崩。
//
// 判据不依赖"这台机器有声卡"：有声卡时设备可用，没声卡时整个库静默
// 失效——两种情况都必须跑完、不抛异常。
class Program {
    static void Main() {
        AudioBus bus = new AudioBus();
        SfxBank bank = new SfxBank(bus);

        // 设备可用性只探测，不断言、不打印：这台机器有没有声卡是环境事实，
        // 打印出来会让金标准在无声卡的机器上永远不匹配。判据是"探测本身
        // 不抛异常，两种环境都要跑完"。
        bool probe = bank.Available();
        Console.WriteLine("device_probe_ok=1");

        // 加载一个不存在的音效：跳过、不抛异常、库里没有。
        string[] missing = new string[] { "definitely_missing_sfx" };
        bank.LoadAll("assets/sfx", missing);
        Console.WriteLine("missing_loaded=" + Convert.ToString(bank.Count()));
        Console.WriteLine("has_missing=" + (bank.Has("definitely_missing_sfx") ? "yes" : "no"));

        // 播放不存在的音效：空操作，不抛异常。
        bank.Play("definitely_missing_sfx");
        Console.WriteLine("play_missing_ok=1");

        // 播放已加载的名字（同名重复调用走限频）：不抛异常。
        bank.Play("definitely_missing_sfx", 0.5, 0);
        Console.WriteLine("play_missing_gain_ok=1");

        // 空名字：空操作。
        bank.Play("");
        Console.WriteLine("play_empty_ok=1");

        // 释放：可重复调用。
        bank.Dispose();
        bank.Dispose();
        Console.WriteLine("dispose_ok=1");

        // 总线静音后播放：静音开关生效不报错。
        bus.SetSfxMuted(true);
        bank.Play("definitely_missing_sfx");
        bus.SetSfxMuted(false);
        Console.WriteLine("muted_ok=1");
    }
}
