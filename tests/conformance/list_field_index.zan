// 核心契约与语义定义。
using System;

class Bag {
    List<string> items;

    Bag() { this.items = new List<string>(); }

    void Add(string s) { this.items.Add(s); }

    string Join() {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < this.items.Count; i = i + 1) {
            sb.Append(this.items[i]);              // append string element
            if (this.items[i] == "x") {            // compare string element
                sb.Append("!");
            }
        }
        return sb.ToString();
    }
}

class Program {
    static void Main() {
        Bag bag = new Bag();
        bag.Add("a");
        bag.Add("x");
        bag.Add("b");
        Console.WriteLine(bag.Join());             // ax!b
    }
}
