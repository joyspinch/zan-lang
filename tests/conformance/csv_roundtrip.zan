// Zan.Csv package test: the unified CSV reader/writer (formerly duplicated
// across System.Text and System.Data). Locks UTF-8 BOM stripping, CRLF/LF/CR
// record separators, no-trailing-newline flush, lenient mid-field quotes,
// ParseRow, ragged Column padding and the TSV writer round-trip.
using System;
using System.Csv;
using System.Text;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        // BOM + CRLF records + quoted fields (comma, doubled quote), and a
        // final record without trailing newline.
        string bom = Encoding.Utf8FromCodePoint(65279);
        CsvTable t = Csv.Parse(bom + "name,note\r\nada,\"has, comma\"\r\nbob,\"say \"\"hi\"\"\"");
        if (t.Header()[0] != "name" || t.Header()[1] != "note") { bad = bad + 1; }
        if (t.RowCount() != 2) { bad = bad + 1; }
        if (t.Rows()[0][0] != "ada" || t.Rows()[0][1] != "has, comma") { bad = bad + 1; }
        if (t.Rows()[1][0] != "bob" || t.Rows()[1][1] != "say \"hi\"") { bad = bad + 1; }
        List<string> notes = t.Column("note");
        if (notes == null) { bad = bad + 1; }
        else if (notes.Count != 2 || notes[0] != "has, comma" || notes[1] != "say \"hi\"") { bad = bad + 1; }
        if (t.Column("missing") != null) { bad = bad + 1; }

        // Lone-CR records and a mid-field quote kept literal (lenient parse).
        CsvTable cr = Csv.Parse("a,b\rc\"d,e\r\nf,g");
        if (cr.Header()[0] != "a" || cr.Header()[1] != "b") { bad = bad + 1; }
        if (cr.RowCount() != 2) { bad = bad + 1; }
        if (cr.Rows()[0][0] != "c\"d" || cr.Rows()[0][1] != "e") { bad = bad + 1; }
        if (cr.Rows()[1][0] != "f" || cr.Rows()[1][1] != "g") { bad = bad + 1; }

        // Ragged rows: Column pads short rows with empty cells.
        CsvTable rag = Csv.Parse("h1,h2\nonlyone\nx,y");
        List<string> c2 = rag.Column("h2");
        if (c2 == null) { bad = bad + 1; }
        else if (c2.Count != 2 || c2[0] != "" || c2[1] != "y") { bad = bad + 1; }

        // ParseRow: single-record text has no header concept.
        List<string> row = Csv.ParseRow("1,\"a,b\",3");
        if (row.Count != 3 || row[0] != "1" || row[1] != "a,b" || row[2] != "3") { bad = bad + 1; }
        if (Csv.ParseRow(null).Count != 0) { bad = bad + 1; }

        // TSV round-trip through the Sep writer/parser pair.
        List<List<string>> rows = new List<List<string>>();
        List<string> r0 = new List<string>();
        r0.Add("id"); r0.Add("text");
        rows.Add(r0);
        List<string> r1 = new List<string>();
        r1.Add("7"); r1.Add("tab\tinside");
        rows.Add(r1);
        string tsv = Csv.SerializeSep(rows, "\t");
        if (tsv != "id\ttext\n7\t\"tab\tinside\"\n") { bad = bad + 1; }
        CsvTable back = Csv.ParseSep(tsv, "\t");
        if (back.RowCount() != 1 || back.Rows()[0][1] != "tab\tinside") { bad = bad + 1; }

        // RowToText: minimal quoting, quote doubling, no trailing newline.
        List<string> line = new List<string>();
        line.Add("plain"); line.Add("q\"x");
        if (Csv.RowToText(line) != "plain,\"q\"\"x\"") { bad = bad + 1; }
        if (Csv.Escape(null) != "") { bad = bad + 1; }

        // Degenerate inputs.
        if (Csv.Parse("").RowCount() != 0 || Csv.Parse("").Header().Count != 0) { bad = bad + 1; }
        // Separator that would break the grammar (a quote) falls back to comma.
        CsvTable q = Csv.ParseSep("a,b", "\"");
        if (q.Header()[0] != "a" || q.Header()[1] != "b") { bad = bad + 1; }
        Console.WriteLine("csv-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
