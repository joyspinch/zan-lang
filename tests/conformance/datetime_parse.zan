using System;
namespace Conf;

// DateTime.TryParse/Parse（ISO-8601）：日期、T/空格分隔、秒、小数
// 毫秒、Z/±HH:MM/±HHMM 偏移；无时区按 UTC；非法形态/取值回 false
// 且 result=null；Parse 非法抛 FormatException。
class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            failures = failures + 1;
            Console.WriteLine("FAIL " + name);
        }
    }

    static bool TryOk(string s) {
        DateTime r;
        bool ok = DateTime.TryParse(s, out r);
        return ok && r != null;
    }

    static void Main() {
        // 纯日期 → 当天零点 UTC
        DateTime a;
        Check(DateTime.TryParse("2024-01-02", out a), "date parses");
        Check(a.year == 2024 && a.month == 1 && a.day == 2
            && a.hour == 0 && a.minute == 0 && a.second == 0, "date fields");
        Check(a.epoch == DateTime.DaysFromCivil(2024, 1, 2) * 86400, "date epoch");

        // T 分隔 + Z
        DateTime b;
        Check(DateTime.TryParse("2024-01-02T03:04:05Z", out b), "T+Z parses");
        Check(b.epoch == a.epoch + 3 * 3600 + 4 * 60 + 5, "time epoch");
        Check(b.hour == 3 && b.minute == 4 && b.second == 5, "time fields");

        // 空格分隔、无秒
        Check(TryOk("2024-01-02 03:04"), "space sep, no seconds");
        DateTime c;
        DateTime.TryParse("2024-01-02 03:04", out c);
        Check(c.epoch == a.epoch + 3 * 3600 + 4 * 60 && c.second == 0, "no seconds epoch");

        // 小数毫秒：1/2/3 位补齐，超 3 位截断
        DateTime d;
        DateTime.TryParse("2024-01-02T03:04:05.5Z", out d);
        Check(d.millisecond == 500, "frac 1 digit -> 500ms");
        DateTime.TryParse("2024-01-02T03:04:05.12Z", out d);
        Check(d.millisecond == 120, "frac 2 digits -> 120ms");
        DateTime.TryParse("2024-01-02T03:04:05.123Z", out d);
        Check(d.millisecond == 123, "frac 3 digits -> 123ms");
        DateTime.TryParse("2024-01-02T03:04:05.1234Z", out d);
        Check(d.millisecond == 123, "frac 4 digits truncated");
        Check(d.epochMs == a.epochMs + 3 * 3600000 + 240000 + 5123, "ms in epochMs");

        // 偏移：+08:00 表示快 8 小时，从时刻减掉
        DateTime e;
        DateTime.TryParse("2024-01-02T10:30:00+08:00", out e);
        Check(e.epoch == a.epoch + 2 * 3600 + 1800, "offset +08:00");
        DateTime f;
        DateTime.TryParse("2024-01-02T21:30:00-05:30", out f);
        Check(f.epoch == a.epoch + 21 * 3600 + 1800 + 5 * 3600 + 30 * 60, "offset -05:30");
        DateTime g;
        DateTime.TryParse("2024-01-02T10:30:00+0800", out g);
        Check(g.epoch == e.epoch, "compact +0800");
        DateTime h;
        DateTime.TryParse("2024-01-02t03:04:05z", out h);
        Check(h.epoch == b.epoch, "lowercase t/z");

        // 闰年
        Check(TryOk("2024-02-29"), "leap year ok");
        DateTime t;
        Check(!DateTime.TryParse("2023-02-29", out t) && t == null, "non-leap rejected, out null");

        // 非法形态/取值
        Check(!DateTime.TryParse(null, out t), "null rejected");
        Check(!DateTime.TryParse("", out t), "empty rejected");
        Check(!DateTime.TryParse("2024-13-01", out t), "month 13 rejected");
        Check(!DateTime.TryParse("2024-00-10", out t), "month 0 rejected");
        Check(!DateTime.TryParse("2024-01-00", out t), "day 0 rejected");
        Check(!DateTime.TryParse("2024-01-02T24:00", out t), "hour 24 rejected");
        Check(!DateTime.TryParse("2024-01-02T03:60", out t), "minute 60 rejected");
        Check(!DateTime.TryParse("2024-01-02T03:04:60", out t), "second 60 rejected");
        Check(!DateTime.TryParse("2024-1-2", out t), "short fields rejected");
        Check(!DateTime.TryParse("2024-01-02X", out t), "bad separator rejected");
        Check(!DateTime.TryParse("2024-01-02T03:04Zx", out t), "trailing junk rejected");
        Check(!DateTime.TryParse("2024-01-02T03:04:05.+08:00", out t), "empty frac rejected");
        Check(!DateTime.TryParse("2024-01-02T03:04:05+99:00", out t), "offset hour 99 rejected");

        // Parse 抛 FormatException
        bool threw = false;
        try {
            DateTime.Parse("2024-13-01");
        } catch (FormatException) {
            threw = true;
        }
        Check(threw, "Parse throws FormatException");
        Check(DateTime.Parse("2024-01-02T03:04:05Z").epoch == b.epoch, "Parse happy path");

        Console.WriteLine("failures=" + failures);
    }
}
