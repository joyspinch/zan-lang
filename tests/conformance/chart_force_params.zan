using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

/// graph.force 的 ECharts 5 键：repulsion（缺省 [0,50] 均值口径，
/// % 于缺省力；100 = 旧行为逐位一致）与 edgeLength（px 边静长；
/// 未声明时 0 走 rad/2 旧行为）。解析/克隆/缓存指纹/布局四路钉住。
class Program {
    static long NodeDist(ForceLayout l, string a, string b) {
        ForceNode na = null; ForceNode nb = null;
        for (int i = 0; i < l.nodes.Count; i = i + 1) {
            if (l.nodes[i].name == a) { na = l.nodes[i]; }
            if (l.nodes[i].name == b) { nb = l.nodes[i]; }
        }
        int dx = nb.x - na.x; int dy = nb.y - na.y;
        return (long)(dx * dx + dy * dy);
    }

    static void Main() {
        ChartOption o = ChartOption.FromJson(File.ReadAllText(
            "examples/gui_charts/options/graph-force.json"));
        Console.WriteLine("parse:" + Convert.ToString(o.series[0].forceRepulsion)
            + ":" + Convert.ToString(o.series[0].forceEdgeLength)
            + ":" + o.series[0].graphLayout);

        List<ChartLink> links = new List<ChartLink>();
        links.Add(ChartLink.Of("a", "b", 1));
        links.Add(ChartLink.Of("b", "c", 1));
        links.Add(ChartLink.Of("c", "a", 1));
        ForceLayout d1 = ForceLayout.OfK(links, 80, 400, 300, 100, 100, 100, 0);
        ForceLayout d2 = ForceLayout.OfK(links, 80, 400, 300, 100, 100, 100, 150);
        ForceLayout d3 = ForceLayout.OfK(links, 80, 400, 300, 100, 100, 200, 0);
        Console.WriteLine("iters:" + Convert.ToString(d1.iterations)
            + ":" + Convert.ToString(d2.iterations)
            + ":" + Convert.ToString(d3.iterations));
        // edgeLength=150 的静长边 → a-b 距离应大于缺省布局。
        long dDef = NodeDist(d1, "a", "b");
        long dEdge = NodeDist(d2, "a", "b");
        long dRep = NodeDist(d3, "a", "b");
        Console.WriteLine("edgeLonger:" + Convert.ToString(dEdge > dDef));
        Console.WriteLine("repDiffers:" + Convert.ToString(dRep != dDef));
        // 克隆保真
        ChartSeries c0 = ChartSeries.Clone(o.series[0]);
        Console.WriteLine("clone:" + Convert.ToString(c0.forceRepulsion)
            + ":" + Convert.ToString(c0.forceEdgeLength));
    }
}
