using System;
using System.Net;
using System.Net.External;
using System.Net.Http.Client;
using System.Net.Http.Download;
using System.Net.Http.Proxy;
using System.IO.Compression;
using System.Knowledge;
using System.Text;

namespace Conf;

class Program {
    static int Main() {
        // 1. ExternalCallPolicy
        ExternalCallPolicy policy = ExternalCallPolicy.Default()
            .ConnectTimeout(5000)
            .WriteTimeout(5000)
            .ReadTimeout(15000)
            .IdleTimeout(15000)
            .TotalTimeout(30000)
            .RetryNetwork(true)
            .RetryAttempts(2)
            .AllowLocalHttp()
            .Idempotent("test-key");
        if (policy.ConnectTimeoutMs() != 5000) { return 1; }
        if (!policy.AllowsHttp() || !policy.AllowsLoopback()) { return 2; }
        if (!policy.IsIdempotent() || policy.IdempotencyKey() != "test-key") { return 3; }
        if (!policy.CanRetry("GET", false, 503)) { return 4; }

        // 2. ExternalTarget & ExternalTargetPolicy
        ExternalTarget target = ExternalTarget.Parse("https://api.example.com:8443/v1/resource?id=123");
        if (target == null) { return 5; }
        if (target.Scheme() != "https") { return 6; }
        if (target.Host() != "api.example.com") { return 7; }
        if (target.Port() != 8443) { return 8; }
        if (target.Path() != "/v1/resource") { return 9; }
        if (target.Query() != "?id=123") { return 10; }
        if (!target.IsTls()) { return 11; }
        if (!ExternalTargetPolicy.IsAllowed("https://api.example.com/status")) { return 12; }
        if (ExternalTargetPolicy.IsAllowed("http://api.example.com/status")) { return 13; } // http denied by default

        // 3. Cookie & CookieJar
        CookieJar jar = new CookieJar();
        jar.SetCookie("example.com", "/api/test", "session=xyz123; Path=/api; Secure");
        if (jar.Count() != 1) { return 14; }
        if (jar.Get("session") != "xyz123") { return 15; }
        string hdr = jar.HeaderValue("example.com", "/api/test", true);
        if (hdr != "session=xyz123") { return 16; }

        // 4. PingStatus
        PingStatus ps = PingStatus.Success;
        if (ps != PingStatus.Success) { return 17; }

        // 5. DownloadStage & DownloadItem
        if (DownloadStage.Done != 4) { return 18; }
        if (DownloadStage.Text(DownloadStage.Extract) != "正在解压安装") { return 19; }
        DownloadItem item = DownloadItem.FromUrl("https://download.example.com/package.tar.bz2", "_scratch/pkg.tar.bz2");
        if (item == null) { return 20; }
        item.WithSha1("da39a3ee5e6b4b0d3255bfef95601890afd80709").WithSize(1024);
        if (item.Name() != "package.tar.bz2") { return 21; }

        // 6. ServerBanner
        ServerBanner banner = new ServerBanner("Zan Worker Server", "Core Services");
        banner.Mode("single process")
            .Info("version", "1.0.0")
            .Service("http", "0.0.0.0:8080", "1", "[OK]");
        if (ServerBanner.Width() != 76) { return 22; }

        // 7. BZip2Decoder
        BZip2Decoder decoder = new BZip2Decoder();
        if (decoder == null) { return 23; }

        // 8. GalleryResult
        GalleryResult gr = new GalleryResult();
        if (gr.entries != 0) { return 24; }

        // 9. Bm25 models
        Bm25Candidate cand = new Bm25Candidate(42, 100L);
        if (cand.id != 42 || cand.order != 100L) { return 25; }
        Bm25Term term = new Bm25Term("zan");
        if (term.text != "zan") { return 26; }
        Bm25Posting posting = new Bm25Posting(42, term);
        if (posting.id != 42) { return 27; }

        Console.WriteLine("NET_SECURITY_HARDENING_OK");
        return 0;
    }
}
