// B8: jagged and multidimensional arrays — `int[][]`, `int[,]`, `int[,,]`,
// `int[][,]` types, `new int[3][]`, `new int[2,3]`, multi-index `m[i,j]`,
// `.Length` (total element count), `GetLength(dim)`, row-major element
// initializers, and method return values.
using System;

class Prog {
    static int[,] Make() {
        int[,] r = new int[2,2];
        r[1,0] = 77;
        return r;
    }

    static void Main() {
        int bad = 0;

        // jagged: outer buffer of row pointers, rows allocated individually
        int[][] j = new int[3][];
        j[0] = new int[2];
        j[1] = new int[3];
        j[0][1] = 42;
        j[1][2] = 7;
        if (j.Length != 3) bad++;
        if (j[0].Length != 2) bad++;
        if (j[0][1] != 42) bad++;
        if (j[1][2] != 7) bad++;

        // rectangular 2-D: row-major indexing, Length = rows * cols
        int[,] m = new int[2,3];
        m[1,2] = 99;
        m[0,1] = 5;
        if (m.Length != 6) bad++;
        if (m.GetLength(0) != 2) bad++;
        if (m.GetLength(1) != 3) bad++;
        if (m[1,2] != 99) bad++;
        if (m[0,1] != 5) bad++;
        m[0,0]++;
        if (m[0,0] != 1) bad++;

        // 3-D
        int[,,] t = new int[2,3,4];
        t[1,2,3] = 123;
        if (t.Length != 24) bad++;
        if (t.GetLength(2) != 4) bad++;
        if (t[1,2,3] != 123) bad++;

        // jagged of rectangular: int[][,]
        int[][,] mix = new int[2][,];
        mix[0] = new int[2,2];
        mix[0][1,1] = 8;
        if (mix[0][1,1] != 8) bad++;

        // sized allocation with a row-major element initializer
        int[,] f = new int[2,2] { {1,2}, {3,4} };
        if (f[0,0] != 1 || f[0,1] != 2 || f[1,0] != 3 || f[1,1] != 4) bad++;

        // jagged element initializer
        int[][] ji = new int[][] { new int[] {1,2}, new int[] {3,4,5} };
        if (ji[1][2] != 5) bad++;

        // method returning a rectangular array
        if (Make()[1,0] != 77) bad++;

        Console.WriteLine("arrays-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
