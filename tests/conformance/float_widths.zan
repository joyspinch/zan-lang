using System;

/// `float` is 32-bit storage while literals and arithmetic are double, so every
/// slot a float lands in has to round on the way in and widen on the way out:
/// locals, fields, value structs, arrays and collections, arguments, returns.
struct Vec2 { float x; float y; }

class Program {
    static float Scale(float v, float by) { return v * by; }
    static double Widen(float v) { return v + 0.5; }

    static void Main() {
        Console.WriteLine("=== locals ===");
        float a = 1.5;
        float b = 0.25;
        Console.WriteLine(a);
        Console.WriteLine(b);
        Console.WriteLine(a + b);
        Console.WriteLine(a * b);
        Console.WriteLine(a > b);

        Console.WriteLine("=== fields ===");
        Vec2 v = new Vec2();
        v.x = 3.5;
        v.y = 0.125;
        Console.WriteLine(v.x);
        Console.WriteLine(v.y);
        Console.WriteLine(v.x + v.y);

        Console.WriteLine("=== value struct copy ===");
        Vec2 w = v;
        w.x = 10.25;
        Console.WriteLine(v.x);
        Console.WriteLine(w.x);

        Console.WriteLine("=== call boundary ===");
        Console.WriteLine(Scale(a, 4.0));
        Console.WriteLine(Widen(a));

        Console.WriteLine("=== arrays ===");
        float[] arr = new float[3];
        arr[0] = 0.5;
        arr[1] = 1.25;
        arr[2] = arr[0] + arr[1];
        Console.WriteLine(arr[0]);
        Console.WriteLine(arr[1]);
        Console.WriteLine(arr[2]);

        Console.WriteLine("=== casts ===");
        double d = 2.75;
        float f = (float)d;
        Console.WriteLine(f);
        Console.WriteLine((int)f);
        Console.WriteLine((double)f);
    }
}
