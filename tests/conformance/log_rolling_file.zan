using System;
using System.IO;
using System.Diagnostics;
namespace Conf;

// System.Diagnostics.Log: level filtering, pattern-expanded file names and
// size-based rolling. A background service writes nowhere else, so a dropped
// or unrolled log means an outage with no evidence.
class Prog {
    static void Main() {
        string dir = Path.GetTempPath() + "zan_log_test_"
            + Convert.ToString(ProcessHost.Pid());
        Log.Configure(dir, "app-{yyyy}{MM}{dd}-w{wid}.log", Log.DEBUG);
        Log.EchoToConsole(false);
        Log.MaxFileSize(120);

        Log.Trace("dropped: below the configured level");
        Log.Debug("kept");
        for (int i = 0; i < 8; i = i + 1) {
            Log.Error("boom " + Convert.ToString(i));
        }

        string path = Log.CurrentPath();
        DateTime t = DateTime.Now();
        string want = dir + Path.Separator() + "app-"
            + Convert.ToString(t.Year()) + DateTime.Pad2(t.Month())
            + DateTime.Pad2(t.Day()) + "-w0.log";
        Console.WriteLine(path == want);

        // Rolled at least once, and the level filter dropped the trace line.
        Console.WriteLine(File.Exists(path + ".1"));
        string all = File.ReadAllText(path + ".1") + File.ReadAllText(path);
        Console.WriteLine(all.Contains("dropped"));
        Console.WriteLine(all.Contains("[DEBUG] 0 kept"));
        Console.WriteLine(all.Contains("[ERROR] 0 boom 7"));

        File.Delete(path);
        File.Delete(path + ".1");
        Directory.Delete(dir);
    }
}
