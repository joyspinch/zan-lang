using System;
using System.Security.Cryptography;

/* RFC 4226 Appendix D and RFC 6238 Appendix B known-answer vectors. */
class Program {
    static void Main() {
        string hotpKey = "12345678901234567890";
        for (int counter = 0; counter < 10; counter = counter + 1) {
            Console.WriteLine(Otp.Hotp(hotpKey, hotpKey.Length, counter, 6, Otp.SHA1));
        }

        string sha1Key = "12345678901234567890";
        string sha256Key = "12345678901234567890123456789012";
        string sha512Key = "1234567890123456789012345678901234567890123456789012345678901234";
        List<long> times = new List<long>();
        times.Add(59); times.Add(1111111109); times.Add(1111111111);
        times.Add(1234567890); times.Add(2000000000); times.Add(20000000000);
        for (int i = 0; i < times.Count; i = i + 1) {
            long time = times[i];
            string sha1 = Otp.Totp(sha1Key, sha1Key.Length, time, 30, 8, Otp.SHA1);
            string sha256 = Otp.Totp(sha256Key, sha256Key.Length, time, 30, 8, Otp.SHA256);
            string sha512 = Otp.Totp(sha512Key, sha512Key.Length, time, 30, 8, Otp.SHA512);
            Console.WriteLine(sha1 + " " + sha256 + " " + sha512);
        }

        Console.WriteLine(Otp.Hotp(hotpKey, hotpKey.Length, 0, 7, Otp.SHA1));
        Console.WriteLine(Otp.Totp(sha1Key, sha1Key.Length, 59, 60, 6, Otp.SHA1));
        Console.WriteLine(Otp.VerifyHotp(hotpKey, hotpKey.Length, 3, 6, Otp.SHA1, "254676", 1));
        Console.WriteLine(Otp.VerifyHotp(hotpKey, hotpKey.Length, 3, 6, Otp.SHA1, "287082", 1));
        Console.WriteLine(Otp.VerifyTotp(sha1Key, sha1Key.Length, 60, 30, 8, Otp.SHA1, "94287082", 1));
        Console.WriteLine(Otp.VerifyTotp(sha1Key, sha1Key.Length, 90, 30, 8, Otp.SHA1, "94287082", 0));

        bool rejected = false;
        try { string result = Otp.Hotp(null, 0, 0, 6, Otp.SHA1); }
        catch (ArgumentException) { rejected = true; }
        Console.WriteLine(rejected);

        rejected = false;
        try { string result = Otp.Hotp(hotpKey, -1, 0, 6, Otp.SHA1); }
        catch (ArgumentException) { rejected = true; }
        Console.WriteLine(rejected);

        rejected = false;
        try { string result = Otp.Hotp(hotpKey, hotpKey.Length + 1, 0, 6, Otp.SHA1); }
        catch (ArgumentException) { rejected = true; }
        Console.WriteLine(rejected);
        Console.WriteLine(Otp.Hotp(hotpKey, 0, 0, 6, Otp.SHA1).Length == 6);

        rejected = false;
        try { string result = Otp.Totp(null, 0, 59, 30, 6, Otp.SHA1); }
        catch (ArgumentException) { rejected = true; }
        Console.WriteLine(rejected);

        rejected = false;
        try { bool result = Otp.VerifyHotp(null, 0, 0, 6, Otp.SHA1, "755224", 0); }
        catch (ArgumentException) { rejected = true; }
        Console.WriteLine(rejected);

        rejected = false;
        try { bool result = Otp.VerifyTotp(null, 0, 59, 30, 8, Otp.SHA1, "94287082", 0); }
        catch (ArgumentException) { rejected = true; }
        Console.WriteLine(rejected);

        rejected = false;
        try { bool result = Otp.VerifyHotp(hotpKey, hotpKey.Length, 0, 6, Otp.SHA1, null, 0); }
        catch (ArgumentException) { rejected = true; }
        Console.WriteLine(rejected);

        rejected = false;
        try { bool result = Otp.VerifyHotp(hotpKey, hotpKey.Length, 0, 6, Otp.SHA1, "75522", 0); }
        catch (ArgumentException) { rejected = true; }
        Console.WriteLine(rejected);

        rejected = false;
        try { bool result = Otp.VerifyTotp(sha1Key, sha1Key.Length, 59, 30, 8, Otp.SHA1, "9428708x", 0); }
        catch (ArgumentException) { rejected = true; }
        Console.WriteLine(rejected);

        rejected = false;
        try { bool result = Otp.VerifyHotp(hotpKey, hotpKey.Length, 0, 6, Otp.SHA1, "755224", -1); }
        catch (ArgumentException) { rejected = true; }
        Console.WriteLine(rejected);

        rejected = false;
        try { bool result = Otp.VerifyHotp(hotpKey, hotpKey.Length, 0, 6, Otp.SHA1, "755224", 1001); }
        catch (ArgumentException) { rejected = true; }
        Console.WriteLine(rejected);

        rejected = false;
        try { bool result = Otp.VerifyTotp(sha1Key, sha1Key.Length, 59, 30, 8, Otp.SHA1, "94287082", 1001); }
        catch (ArgumentException) { rejected = true; }
        Console.WriteLine(rejected);

        rejected = false;
        try { bool result = Otp.VerifyHotp(hotpKey, hotpKey.Length, 9223372036854775807, 6, Otp.SHA1, "755224", 1); }
        catch (ArgumentException) { rejected = true; }
        Console.WriteLine(rejected);

        rejected = false;
        try { bool result = Otp.VerifyTotp(sha1Key, sha1Key.Length, 9223372036854775807, 1, 8, Otp.SHA1, "94287082", 1); }
        catch (ArgumentException) { rejected = true; }
        Console.WriteLine(rejected);

        rejected = false;
        try { bool result = Otp.VerifyTotp(sha1Key, sha1Key.Length, -9223372036854775807 - 1, 1, 8, Otp.SHA1, "94287082", 1); }
        catch (ArgumentException) { rejected = true; }
        Console.WriteLine(rejected);
    }
}
