using System;
using Zan.Web;

namespace RouteRegression.Api_Index;

class Index : AppController {
    [HttpGet]
    [Route("/identity-metrics")]
    public async void Index() {
        await Task.Delay(1);
        ViewData data = new ViewData();
        data.Set("message", "api-metrics-awaited");
        this.View(data);
    }

    [HttpGet]
    public void Ping() { this.Ctx().Text("api convention"); }
}
