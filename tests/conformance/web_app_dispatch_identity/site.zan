using System;
using Zan.Web;

namespace Zan.Web.Index;

/* Same source class and action names as api.zan. Reflection rewrites this
   identity, while the template path still uses Index/Index.Index.html. */
class Index : AppController {
    [HttpGet]
    [Route("/")]
    public async void Index() {
        await Task.Delay(1);
        ViewData data = new ViewData();
        data.Set("message", "site-home-awaited");
        this.View(data);
    }

    [HttpGet]
    public void Ping() { this.Ctx().Text("site convention"); }
}
