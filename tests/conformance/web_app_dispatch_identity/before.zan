using System;
using Zan.Web;

namespace Zan.Web.Identity;

class BeforeController : AppController {
    public override async bool OnBeforeAsync() {
        await Task.Delay(1);
        ViewData data = new ViewData();
        data.Set("message", "before-view-awaited");
        this.View(data);
        return false;
    }

    [HttpGet]
    [Route("/identity-before")]
    public void Index() { throw new Exception("before hook must stop action"); }
}
