// A class with nested by-value structs and EH must survive shard harvesting.
using System;

public struct ShardFieldPoint {
    public int X;
    public int Y;

    public ShardFieldPoint(int x, int y) {
        this.X = x;
        this.Y = y;
    }
}

public struct ShardFieldPose {
    public ShardFieldPoint Origin;
    public int Weight;

    public ShardFieldPose(ShardFieldPoint origin, int weight) {
        this.Origin = origin;
        this.Weight = weight;
    }
}

public class ShardFieldController {
    public ShardFieldPose Pose;
    public ShardFieldPoint Other;
    public int Tail;

    public ShardFieldController(ShardFieldPose pose, ShardFieldPoint other, int tail) {
        this.Pose = pose;
        this.Other = other;
        this.Tail = tail;
    }

    public void Replace(ShardFieldPose pose) {
        this.Pose = pose;
    }

    public int Score() {
        return this.Pose.Origin.X * this.Pose.Weight + this.Pose.Origin.Y
            + this.Other.X + this.Other.Y + this.Tail;
    }

    public int CatchScore() {
        try {
            if (this.Tail > 0) {
                throw new Exception("personality");
            }
            return 0;
        } catch (Exception e) {
            return this.Score();
        }
    }
}

public class Program {
    public static void Main() {
        ShardFieldController controller = new ShardFieldController(
            new ShardFieldPose(new ShardFieldPoint(3, 7), 2),
            new ShardFieldPoint(11, 13), 5);
        Console.WriteLine(controller.Score());
        Console.WriteLine(controller.CatchScore());
        controller.Replace(new ShardFieldPose(new ShardFieldPoint(5, 17), 4));
        Console.WriteLine(controller.Score());
        Console.WriteLine(controller.CatchScore());
    }
}
