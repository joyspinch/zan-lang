using System;

class NumericLiteralMemberTest {
    static void Check(bool ok, string label) {
        if (!ok) { throw new Exception(label); }
    }
    static void Main() {
        Check(9.ToString() == "9", "integer literal member");
        Check(19.ToString() == "19", "multi-digit literal member");
        Check(0x10.ToString() == "16", "hex literal member");
        Check(9L.ToString() == "9", "long suffix member");
        Check(9U.ToString() == "9", "unsigned suffix member");
        Check(9UL.ToString() == "9", "unsigned long suffix member");
        double trailing = 9.;
        double fraction = 9.5;
        double exponent = 9e2;
        double dotExponent = 9.e2;
        double signedExponent = 9.e+2;
        float suffix = 9.f;
        decimal dec = 9.m;
        Check(trailing == 9.0 && fraction == 9.5, "trailing dot and fraction");
        Check(exponent == 900.0 && dotExponent == 900.0 && signedExponent == 900.0, "exponent boundaries");
        Check(suffix == 9.0f && dec == 9m, "existing floating and decimal suffixes");
        Console.WriteLine("NUMERIC_LITERAL_MEMBER_OK");
    }
}
