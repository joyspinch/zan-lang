using System;
namespace Conf;
class Program {
    static void Main() {
        int[] a = new int[5];
        for (int i = 0; i < 5; i = i + 1) { a[i] = i * 10; }
        Span<int> s = a.AsSpan();
        Console.WriteLine(s.Length);
        s[2] = 999;
        Console.WriteLine(a[2]);
        int sum = 0;
        for (int i = 0; i < s.Length; i = i + 1) { sum = sum + s[i]; }
        Console.WriteLine(sum);
        Span<int> mid = s.Slice(1, 3);
        Console.WriteLine(mid.Length);
        Console.WriteLine(mid[0]);
        byte[] b = new byte[4];
        Span<byte> bs = b.AsSpan();
        bs[0] = 200;
        Console.WriteLine(b[0]);
        long[] q = new long[3];
        Span<long> ls = q.AsSpan();
        ls[1] = 9000000000;
        Console.WriteLine(q[1]);
    }
}
