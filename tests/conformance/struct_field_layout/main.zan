using System;
using LayoutProbe;

// 跨文件结构体字段的布局回归用例。
//
// types.zan 声明结构体 Pair，本文件（后编译）把它当字段用。编译器曾经
// 在"引用方的结构体类型还没注册"时把字段类型降级成 i8*——字段布局随即
// 错位，结构体字段读到的��后面的字段值（静默内存损坏，不报任何错）。
public class Holder {
    // 结构体字段：必须按值布局（16 字节）。
    public Pair pair;
    // 紧跟其后的普通字段：布局错位时它会被读坏。
    public double tail;

    public Holder(Pair pair, double tail) {
        this.pair = pair;
        this.tail = tail;
    }
}

public class Program {
    public static void Main() {
        Holder holder = new Holder(new Pair(3.0, 7.0), 42.0);
        bool ok = holder.pair.x == 3.0 && holder.pair.y == 7.0 && holder.tail == 42.0;
        if (ok) {
            Console.WriteLine("STRUCT FIELD LAYOUT OK");
        } else {
            Console.WriteLine("STRUCT FIELD LAYOUT BROKEN: "
                + holder.pair.x.ToString() + "," + holder.pair.y.ToString()
                + "," + holder.tail.ToString());
        }
    }
}
