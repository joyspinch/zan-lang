using System;
using System.IO;
using System.Net.External;
using System.Net.Http;
using System.Net.Http.Client;
using System.Net.Https;
using System.Net.Sockets;
using System.Net.Tls;
using System.Security.Cryptography;
using System.Threading;

class Program {
    static int failures = 0;
    static int PORT_RAW = 19711;
    static int PORT_HTTPS = 19712;
    static int serverAccepted = 0;

    static void Check(bool ok, string name) {
        Console.WriteLine((ok ? "ok " : "FAIL ") + name);
        if (!ok) { failures = failures + 1; }
    }

    static string SRV_CA_CERT_B64 = "";
    static string SRV_CERT_B64 = "";
    static string SRV_KEY_B64 = "";
    static string SRV_PIN = "yfhw0i0ZlnTwW+M408wk7pFROB7w6S8CnZpZuwkcvjI=";
    static string CLI_CA_CERT_B64 = "";
    static string CLI_RSA_CERT_B64 = "";
    static string CLI_RSA_KEY_B64 = "";
    static string CLI_EC_CERT_B64 = "";
    static string CLI_EC_KEY_B64 = "MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgeZlvuIKkb20OrG1RMuTJE8GTxv2kNCbXqc/sqHyAVCShRANCAATTojgDOnP2zHj034/DSgnL42BtdwZnWYHOJV9AoI3rAraPY03EvJFueNxWVf0Otrmlk0kD/kPgLtGRAoNf8Mzc";
    static string CLI_INT_CERT_B64 = "";
    static string CLI_LEAF_CERT_B64 = "";
    static string CLI_LEAF_KEY_B64 = "";
    static string CLI_SRVONLY_CERT_B64 = "";
    static string CLI_SRVONLY_KEY_B64 = "";
    static string CLI_UNTRUSTED_CERT_B64 = "";
    static string CLI_UNTRUSTED_KEY_B64 = "";
    static string CLI_EXP_CERT_B64 = "";
    static string CLI_EXP_KEY_B64 = "";

    static string WrapPem(string label, string b64) {
        string out1 = "-----BEGIN " + label + "-----\n";
        int pos = 0;
        while (pos < b64.Length) {
            int take = 64;
            if (pos + take > b64.Length) { take = b64.Length - pos; }
            out1 = out1 + b64.Substring(pos, take) + "\n";
            pos = pos + take;
        }
        return out1 + "-----END " + label + "-----\n";
    }

    static string PemCert(string b64) { return WrapPem("CERTIFICATE", b64); }
    static string PemKey(string b64) { return WrapPem("PRIVATE KEY", b64); }

    static void WriteFixtures() {
        Directory.CreateDirectory("_scratch");
        File.WriteAllText("_scratch/mtls_srv_ca.pem", PemCert(SRV_CA_CERT_B64));
        File.WriteAllText("_scratch/mtls_srv_cert.pem", PemCert(SRV_CERT_B64));
        File.WriteAllText("_scratch/mtls_srv_key.pem", PemKey(SRV_KEY_B64));
        File.WriteAllText("_scratch/mtls_cli_ca.pem", PemCert(CLI_CA_CERT_B64));
        File.WriteAllText("_scratch/mtls_cli_rsa.pem", PemCert(CLI_RSA_CERT_B64));
        File.WriteAllText("_scratch/mtls_cli_rsa.key", PemKey(CLI_RSA_KEY_B64));
        File.WriteAllText("_scratch/mtls_cli_ec.pem", PemCert(CLI_EC_CERT_B64));
        File.WriteAllText("_scratch/mtls_cli_ec.key", PemKey(CLI_EC_KEY_B64));
        File.WriteAllText("_scratch/mtls_cli_chain.pem",
            PemCert(CLI_LEAF_CERT_B64) + PemCert(CLI_INT_CERT_B64));
        File.WriteAllText("_scratch/mtls_cli_chain.key", PemKey(CLI_LEAF_KEY_B64));
        File.WriteAllText("_scratch/mtls_cli_srvonly.pem", PemCert(CLI_SRVONLY_CERT_B64));
        File.WriteAllText("_scratch/mtls_cli_srvonly.key", PemKey(CLI_SRVONLY_KEY_B64));
        File.WriteAllText("_scratch/mtls_cli_untrusted.pem", PemCert(CLI_UNTRUSTED_CERT_B64));
        File.WriteAllText("_scratch/mtls_cli_untrusted.key", PemKey(CLI_UNTRUSTED_KEY_B64));
        File.WriteAllText("_scratch/mtls_cli_exp.pem", PemCert(CLI_EXP_CERT_B64));
        File.WriteAllText("_scratch/mtls_cli_exp.key", PemKey(CLI_EXP_KEY_B64));
    }

    static bool ExpectArgError(string certFile, string keyFile) {
        try {
            TlsContext unused = TlsContext.CreateClientWithCertificate(certFile, keyFile);
            return false;
        } catch (ArgumentException e) {
            return true;
        }
    }

    static void TestPolicyAndCredentials() {
        TlsContext serverProbe = TlsContext.CreateClient();
        Check(!serverProbe.AddTrustedCert("_scratch/mtls_cli_ca.pem"),
            "clientAuth-only CA rejected as server trust anchor");
        serverProbe.Free();

        Check(ExpectArgError("_scratch/mtls_cli_rsa.pem", "_scratch/mtls_cli_ec.key"),
            "mismatched RSA cert with EC key rejected");
        Check(ExpectArgError("_scratch/mtls_cli_rsa.pem", "_scratch/mtls_srv_key.pem"),
            "mismatched RSA cert with wrong RSA key rejected");
        Check(ExpectArgError("_scratch/mtls_cli_srvonly.pem", "_scratch/mtls_cli_srvonly.key"),
            "serverAuth-only leaf rejected for client credentials");
        Check(ExpectArgError("_scratch/mtls_cli_exp.pem", "_scratch/mtls_cli_exp.key"),
            "expired client cert rejected for client credentials");
    }

    static async void RawMtlsServer(TlsContext tls, int count) {
        TcpListener l = new TcpListener("127.0.0.1", PORT_RAW);
        l.Start();
        for (int n = 0; n < count; n = n + 1) {
            nint sock = await l.AcceptAsync();
            if (sock < 0) { break; }
            TlsStream s = await TlsStream.AcceptAsync(tls, sock, 5000);
            if (s != null) {
                serverAccepted = serverAccepted + 1;
                string req = await s.RecvAsync(128);
                if (req.Length > 0) {
                    await s.SendStringAsync("ok:" + req);
                }
                s.Close();
            }
            Socket.Close(sock);
        }
        l.Stop();
    }

    static async bool TryRawClient(bool tls13, string certFile, string keyFile,
                                   string msg, int expectedVersion) {
        TlsContext ctx = certFile.Length > 0
            ? TlsContext.CreateClientWithCertificate(certFile, keyFile)
            : TlsContext.CreateClient();
        if (!tls13) { ctx.DisableTls13(); }
        ctx.AddTrustedCert("_scratch/mtls_srv_ca.pem");
        nint sock = Socket.CreateTcp();
        Socket.SetNonBlocking(sock);
        try {
            int rc = await Socket.ConnectAsync(sock, "127.0.0.1", PORT_RAW, 5000);
            if (rc != 0) { return false; }
            TlsStream s = await TlsStream.ConnectAsync(ctx, sock, "127.0.0.1", 5000);
            if (s == null) { return false; }
            int ver = s.engine.NegotiatedVersion();
            await s.SendStringAsync(msg);
            string resp = await s.RecvAsync(128);
            s.Close();
            return ver == expectedVersion && resp == ("ok:" + msg);
        } finally {
            Socket.Close(sock);
            ctx.Free();
        }
    }

    static async void TestRawMtlsMatrix() {
        TlsContext serverTls = TlsContext.CreateServer(
            "_scratch/mtls_srv_cert.pem", "_scratch/mtls_srv_key.pem");
        Check(serverTls != null && serverTls.RequireClientCertificate("_scratch/mtls_cli_ca.pem"),
            "server RequireClientCertificate accepts clientAuth CA");
        Task.Spawn(RawMtlsServer(serverTls, 9));
        await Task.Delay(80);

        bool r13 = await TryRawClient(true, "_scratch/mtls_cli_rsa.pem",
            "_scratch/mtls_cli_rsa.key", "rsa13", TlsRecord.VersionTls13);
        Check(r13, "TLS 1.3 mTLS RSA client succeeds");

        bool e13 = await TryRawClient(true, "_scratch/mtls_cli_ec.pem",
            "_scratch/mtls_cli_ec.key", "ec13", TlsRecord.VersionTls13);
        Check(e13, "TLS 1.3 mTLS EC client succeeds");

        bool c13 = await TryRawClient(true, "_scratch/mtls_cli_chain.pem",
            "_scratch/mtls_cli_chain.key", "chain13", TlsRecord.VersionTls13);
        Check(c13, "TLS 1.3 mTLS 2-cert chain succeeds");

        bool r12 = await TryRawClient(false, "_scratch/mtls_cli_rsa.pem",
            "_scratch/mtls_cli_rsa.key", "rsa12", TlsRecord.VersionTls12);
        Check(r12, "TLS 1.2 mTLS RSA client succeeds");

        bool e12 = await TryRawClient(false, "_scratch/mtls_cli_ec.pem",
            "_scratch/mtls_cli_ec.key", "ec12", TlsRecord.VersionTls12);
        Check(e12, "TLS 1.2 mTLS EC client succeeds");

        bool noCert13 = await TryRawClient(true, "", "", "nocert13", TlsRecord.VersionTls13);
        Check(!noCert13, "TLS 1.3 mTLS rejects missing client cert");

        bool noCert12 = await TryRawClient(false, "", "", "nocert12", TlsRecord.VersionTls12);
        Check(!noCert12, "TLS 1.2 mTLS rejects missing client cert");

        bool bad13 = await TryRawClient(true, "_scratch/mtls_cli_untrusted.pem",
            "_scratch/mtls_cli_untrusted.key", "bad13", TlsRecord.VersionTls13);
        Check(!bad13, "TLS 1.3 mTLS rejects untrusted client cert");

        bool bad12 = await TryRawClient(false, "_scratch/mtls_cli_untrusted.pem",
            "_scratch/mtls_cli_untrusted.key", "bad12", TlsRecord.VersionTls12);
        Check(!bad12, "TLS 1.2 mTLS rejects untrusted client cert");

        await Task.Delay(80);
        Check(serverAccepted == 5, "server accepted exactly 5 valid mTLS connections");
        serverTls.Free();
    }

    static bool AllowPinnedUnknownCa(long verifyResult, string certText) {
        return verifyResult == 19;
    }

    static async HttpResponse HandleHttps(HttpRequest req) {
        return HttpResponse.Text("mtls-ok:" + req.path);
    }

    static async void TestHttpsServerMtls() {
        HttpsServer server = HttpsServer.Create("127.0.0.1", PORT_HTTPS,
            "_scratch/mtls_srv_cert.pem", "_scratch/mtls_srv_key.pem");
        server.RequireClientCertificate("_scratch/mtls_cli_ca.pem");
        server.SetTimeout(5000);
        server.OnRequest(Program.HandleHttps);
        Task.Spawn(server.Start());
        await Task.Delay(80);
        try {
            ExternalCallPolicy policy = ExternalCallPolicy.Default().AllowLoopback();

            using (HttpClient cRsa = new HttpClient("127.0.0.1", PORT_HTTPS)) {
                cRsa.UseTls();
                cRsa.SetCallPolicy(policy);
                cRsa.PinPublicKey(SRV_PIN);
                cRsa.SetCertPolicy(Program.AllowPinnedUnknownCa);
                cRsa.SetClientCertificate("_scratch/mtls_cli_rsa.pem", "_scratch/mtls_cli_rsa.key");
                using (HttpResponse resp = await cRsa.SendAsync("GET", "/rsa", "")) {
                    Check(resp.statusCode == 200 && resp.body == "mtls-ok:/rsa",
                        "HttpsServer + HttpClient RSA mTLS succeeds");
                }
            }

            using (HttpClient cEc = new HttpClient("127.0.0.1", PORT_HTTPS)) {
                cEc.UseTls();
                cEc.SetCallPolicy(policy);
                cEc.PinPublicKey(SRV_PIN);
                cEc.SetCertPolicy(Program.AllowPinnedUnknownCa);
                cEc.SetClientCertificate("_scratch/mtls_cli_ec.pem", "_scratch/mtls_cli_ec.key");
                using (HttpResponse resp = await cEc.SendAsync("GET", "/ec", "")) {
                    Check(resp.statusCode == 200 && resp.body == "mtls-ok:/ec",
                        "HttpsServer + HttpClient EC mTLS succeeds");
                }
            }

            bool noCertDenied = false;
            using (HttpClient cNo = new HttpClient("127.0.0.1", PORT_HTTPS)) {
                cNo.UseTls();
                cNo.SetCallPolicy(policy);
                cNo.PinPublicKey(SRV_PIN);
                cNo.SetCertPolicy(Program.AllowPinnedUnknownCa);
                try {
                    using (HttpResponse unused = await cNo.SendAsync("GET", "/none", "")) { }
                } catch (HttpRequestException e) {
                    noCertDenied = true;
                }
            }
            Check(noCertDenied, "HttpsServer rejects HttpClient without client cert");

            bool untrustedDenied = false;
            using (HttpClient cBad = new HttpClient("127.0.0.1", PORT_HTTPS)) {
                cBad.UseTls();
                cBad.SetCallPolicy(policy);
                cBad.PinPublicKey(SRV_PIN);
                cBad.SetCertPolicy(Program.AllowPinnedUnknownCa);
                cBad.SetClientCertificate("_scratch/mtls_cli_untrusted.pem",
                    "_scratch/mtls_cli_untrusted.key");
                try {
                    using (HttpResponse unused = await cBad.SendAsync("GET", "/bad", "")) { }
                } catch (HttpRequestException e) {
                    untrustedDenied = true;
                }
            }
            Check(untrustedDenied, "HttpsServer rejects HttpClient with untrusted client cert");
        } finally {
            server.Stop();
            await Task.Delay(80);
        }
    }

    static async int Run() {
        Socket.Initialize();
        WriteFixtures();
        TestPolicyAndCredentials();
        await TestRawMtlsMatrix();
        await TestHttpsServerMtls();
        Socket.Cleanup();
        Console.WriteLine("failures=" + Convert.ToString(failures));
        return failures;
    }

    static void Main() {
        int result = await Program.Run();
        if (result != 0) { Environment.Exit(1); }
    }
}
