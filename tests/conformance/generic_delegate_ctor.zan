using System;

namespace GenericDelegateCtor;

delegate string TextOf<T>(T item);
delegate Box RowOf<T>(T item);

class Box {
    string tag;
    Box(string t) { tag = t; }
}

class Item {
    string name;
    Item(string n) { name = n; }
}

/// A generic class whose constructor takes a delegate spelled in its own type
/// parameter, in both overloads a caller can pick from.
class Bag<T> {
    List<T> src;
    TextOf<T> text;
    RowOf<T> row;

    Bag(List<string> titles) { src = new List<T>(); }
    Bag(TextOf<T> f) { src = new List<T>(); text = f; }
    Bag(RowOf<T> f) { src = new List<T>(); row = f; }

    void Add(T v) { src.Add(v); }
    string TextAt(int i) { return text(src[i]); }
    /// The delegate's result is the receiver of a member access, so its static
    /// type has to come from the delegate's return type.
    string TagAt(int i) { return row(src[i]).tag; }
}

class Program {
    static Box Wrap(string s) { return new Box("[" + s + "]"); }

    static void Main() {
        Bag<Item> byText = new Bag<Item>(i => i.name);
        byText.Add(new Item("alpha"));
        Console.WriteLine(byText.TextAt(0));

        Bag<Item> byRow = new Bag<Item>(i => Wrap(i.name));
        byRow.Add(new Item("beta"));
        Console.WriteLine(byRow.TagAt(0));

        List<string> titles = new List<string>();
        titles.Add("head");
        Bag<Item> byList = new Bag<Item>(titles);
        Console.WriteLine("list ctor picked");
    }
}
