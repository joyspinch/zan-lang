using System;

delegate int TargetReadA(int value);
delegate int TargetReadB(int value);
delegate void TargetArraySink<T>(T[] value);
delegate void TargetRecursive(TargetRecursive next);

class TargetContextMethods {
    public static int Taken;
    public static int Read(string value) { return -100; }
    public static int Read(int value) { return value + 10; }
    public static int Other(string value) { return -200; }
    public static int Other(int value) { return value + 20; }
    public static bool Pick(bool value) { return value; }
    public static void Take(TargetReadA read) { Taken = read(7); }
    public static void TakeRank(int[][,] value) { }
    public static void Recur(TargetRecursive next) { Taken = Taken + 1; }
}

class TargetContextFields {
    public Func<int, int> Read = TargetContextMethods.Read;
    public TargetReadA Named = TargetContextMethods.Other;
}

class TargetContextVirtualBase<T> {
    public virtual T Echo(T value) { return value; }
}

class TargetContextVirtualChild : TargetContextVirtualBase<double> {
    public override double Echo(double value) { return value + 1.0; }
}

class MethodGroupTargetContextsTest {
    static void Check(bool ok, string name) { if (!ok) throw new Exception(name); }
    static void Main() {
        TargetContextFields initialized = new TargetContextFields();
        Check(initialized.Read(1) == 11, "delegate field initializer");
        Check(initialized.Named(2) == 22, "named delegate field initializer");
        TargetContextFields replaced = new TargetContextFields {
            Read = TargetContextMethods.Other,
            Named = TargetContextMethods.Read
        };
        Check(replaced.Read(3) == 23, "object initializer delegate target");
        Check(replaced.Named(4) == 14, "object initializer named target");
        Func<int, int> left = TargetContextMethods.Pick(true)
        ? TargetContextMethods.Read : TargetContextMethods.Other;
        Func<int, int> right = TargetContextMethods.Pick(false)
        ? TargetContextMethods.Read : TargetContextMethods.Other;
        Check(left(5) == 15, "conditional true arm target");
        Check(right(6) == 26, "conditional false arm target");
        TargetReadB named = TargetContextMethods.Read;
        Action<TargetReadB> take = TargetContextMethods.Take;
        take(named);
        Check(TargetContextMethods.Taken == 17, "structurally compatible named delegate parameter");
        TargetRecursive recursive = TargetContextMethods.Recur;
        recursive(null);
        Check(TargetContextMethods.Taken == 18, "recursive delegate signature identity");
        TargetArraySink<int[,]> ranked = TargetContextMethods.TakeRank;
        Check(ranked != null, "generic delegate composes array ranks");
        TargetContextVirtualBase<double> receiver = new TargetContextVirtualChild();
        Check(receiver.Echo(2.0) == 3.0, "closed generic virtual direct call");
        Func<double, double> virtualRead = receiver.Echo;
        Check(virtualRead(2.0) == 3.0, "closed generic virtual method group");
        Console.WriteLine("METHOD_GROUP_TARGET_CONTEXTS_OK");
    }
}
