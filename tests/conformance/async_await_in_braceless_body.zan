// 核心契约与语义定义。
// 核心契约与语义定义。
using System;

class Program {
    static async int Echo(int v) {
        await Task.Delay(1);
        return v;
    }

    static async int TryInIf(bool c) {
        int r = 0;
        if (c)
            try {
                r = await Program.Echo(3);
            } catch (Exception e) {
                r = -1;
            }
        return r;
    }

    static async int SwitchInIf(int k) {
        int r = 0;
        if (k > 0)
            switch (k) {
                case 1:
                    r = await Program.Echo(10);
                    break;
                default:
                    r = await Program.Echo(20);
                    break;
            }
        return r;
    }

    static async int TryInWhile() {
        int i = 0;
        int sum = 0;
        while (i < 3)
            try {
                sum = sum + await Program.Echo(i);
                i = i + 1;
            } finally {
                sum = sum + 100;
            }
        return sum;
    }

    static async int SwitchInForeach() {
        int[] xs = new int[3];
        xs[0] = 1;
        xs[1] = 2;
        xs[2] = 5;
        int sum = 0;
        foreach (int x in xs)
            switch (x) {
                case 1:
                    sum = sum + await Program.Echo(1);
                    break;
                default:
                    sum = sum + await Program.Echo(x * 10);
                    break;
            }
        return sum;
    }

    static async void Main() {
        Console.WriteLine("try_if=" + Convert.ToString(await Program.TryInIf(true)));
        Console.WriteLine("try_if_skip=" + Convert.ToString(await Program.TryInIf(false)));
        Console.WriteLine("switch_if=" + Convert.ToString(await Program.SwitchInIf(1)));
        Console.WriteLine("switch_if_default=" + Convert.ToString(await Program.SwitchInIf(2)));
        Console.WriteLine("try_while=" + Convert.ToString(await Program.TryInWhile()));
        Console.WriteLine("switch_foreach=" + Convert.ToString(await Program.SwitchInForeach()));
    }
}
