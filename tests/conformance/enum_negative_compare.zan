using System;

namespace Conformance;

enum NegStatus {
    Unknown = -1,
    Offline = -2,
    Ok = 0
}

class Program {
    static NegStatus FromRaw(int v) {
        return (NegStatus)v;
    }

    static string SwitchLabel(NegStatus s) {
        switch (s) {
            case NegStatus.Unknown: return "sw_unk";
            case NegStatus.Offline: return "sw_off";
            case NegStatus.Ok: return "sw_ok";
            default: return "sw_other";
        }
    }

    static void Main() {
        NegStatus u = FromRaw(-1);
        NegStatus o = FromRaw(-2);
        Console.WriteLine("eq_unk=" + (u == NegStatus.Unknown ? "1" : "0"));
        Console.WriteLine("neq_unk=" + (u != NegStatus.Unknown ? "1" : "0"));
        Console.WriteLine("eq_off=" + (o == NegStatus.Offline ? "1" : "0"));
        Console.WriteLine("neq_ok=" + (u != NegStatus.Ok ? "1" : "0"));
        Console.WriteLine("sw_u=" + SwitchLabel(u));
        Console.WriteLine("sw_o=" + SwitchLabel(o));
        Console.WriteLine("raw_u=" + ((int)NegStatus.Unknown).ToString());
    }
}
