// 接口数据协议与执行契约。
using System;

class Math {
    // 接口数据协议与执行契约。
    static double Sqrt(double x) { return x + 1000.0; }
    static double Sin(double x) { return x + 2000.0; }
    static int Abs(int x) { return x + 3000; }
    static int Max(int a, int b) { return 4000; }
    static int Min(int a, int b) { return 5000; }
    static double Pow(double a, double b) { return a + b + 6000.0; }
    static double Floor(double x) { return x + 7000.0; }
    static double Ceiling(double x) { return x + 8000.0; }
    static double Round(double x) { return x + 9000.0; }
}

class Convert {
    static double ToDouble(string s) { return 11000.0; }
    static int ToInt32(string s) { return 12000; }
}

class Environment {
    static long ArgCount() { return 13000; }
    static string ArgAt(long i) { return "argv" + i; }
    static string ExeDir() { return "exedir"; }
}

class BuiltinShadowing {
    static void Main() {
        Console.WriteLine("sqrt " + (long)Math.Sqrt(1.0));
        Console.WriteLine("sin " + (long)Math.Sin(1.0));
        Console.WriteLine("abs " + Math.Abs(-7));
        Console.WriteLine("max " + Math.Max(1, 2));
        Console.WriteLine("min " + Math.Min(1, 2));
        Console.WriteLine("pow " + (long)Math.Pow(1.0, 2.0));
        Console.WriteLine("floor " + (long)Math.Floor(1.5));
        Console.WriteLine("ceiling " + (long)Math.Ceiling(1.5));
        Console.WriteLine("round " + (long)Math.Round(1.5));
        Console.WriteLine("todouble " + (long)Convert.ToDouble("3"));
        Console.WriteLine("toint32 " + Convert.ToInt32("3"));
        Console.WriteLine("argcount " + Environment.ArgCount());
        Console.WriteLine("argat " + Environment.ArgAt(1));
        Console.WriteLine("exedir " + Environment.ExeDir());
    }
}
