using System;

// A delegate call whose argument is another delegate call: the arguments are
// evaluated before the closure/bare split, so no call nests inside the other
// arm of a branch (that shape crashed the X86 instruction selector).
class Program {
    static void Main() {
        Func<int, int> g = (int x) => x + 1;
        Func<int, int> f = (int x) => g(x);
        Func<int, int> h = (int x) => f(g(x));
        Console.WriteLine("f=" + Convert.ToString(f(3)));
        Console.WriteLine("h=" + Convert.ToString(h(3)));
    }
}
