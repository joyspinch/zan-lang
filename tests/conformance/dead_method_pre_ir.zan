using System;

namespace DeadMethodPreIr;

delegate int Callback();

class Base {
    public virtual int Value() { return 10; }
}

class Child : Base {
    public override int Value() { return 23; }
}

class Item {
    public int number;
    public Item(int n) { number = n; }
    public int Read() { return number; }
}

class Boot {
    static int seed = 4;
    static Boot() { seed = seed + 3; }
    public static int Value() { return seed; }
}

class Generic {
    public static T Identity<T>(T value) { return value; }
}

class Methods {
    public static int ViaDelegate() { return 31; }
    public static int ViaCall() { return Helper(); }
    static int Helper() { return 7; }
    static int NeverCalled() { return 900; }
    // 核心契约与语义定义。
    static int Unused00(int n) { if (n > 0) return ViaCall() + n; return -1; }
    static int Unused01(int n) { if (n > 1) return ViaCall() + n; return -2; }
    static int Unused02(int n) { if (n > 2) return ViaCall() + n; return -3; }
    static int Unused03(int n) { if (n > 3) return ViaCall() + n; return -4; }
    static int Unused04(int n) { if (n > 4) return ViaCall() + n; return -5; }
    static int Unused05(int n) { if (n > 5) return ViaCall() + n; return -6; }
    static int Unused06(int n) { if (n > 6) return ViaCall() + n; return -7; }
    static int Unused07(int n) { if (n > 7) return ViaCall() + n; return -8; }
    static int Unused08(int n) { if (n > 8) return ViaCall() + n; return -9; }
    static int Unused09(int n) { if (n > 9) return ViaCall() + n; return -10; }
    static int Unused10(int n) { if (n > 10) return ViaCall() + n; return -11; }
    static int Unused11(int n) { if (n > 11) return ViaCall() + n; return -12; }
    static int Unused12(int n) { if (n > 12) return ViaCall() + n; return -13; }
    static int Unused13(int n) { if (n > 13) return ViaCall() + n; return -14; }
    static int Unused14(int n) { if (n > 14) return ViaCall() + n; return -15; }
    static int Unused15(int n) { if (n > 15) return ViaCall() + n; return -16; }
    static int Unused16(int n) { if (n > 16) return ViaCall() + n; return -17; }
    static int Unused17(int n) { if (n > 17) return ViaCall() + n; return -18; }
    static int Unused18(int n) { if (n > 18) return ViaCall() + n; return -19; }
    static int Unused19(int n) { if (n > 19) return ViaCall() + n; return -20; }
    static int Unused20(int n) { if (n > 20) return ViaCall() + n; return -21; }
    static int Unused21(int n) { if (n > 21) return ViaCall() + n; return -22; }
    static int Unused22(int n) { if (n > 22) return ViaCall() + n; return -23; }
    static int Unused23(int n) { if (n > 23) return ViaCall() + n; return -24; }
    static int Unused24(int n) { if (n > 24) return ViaCall() + n; return -25; }
    static int Unused25(int n) { if (n > 25) return ViaCall() + n; return -26; }
    static int Unused26(int n) { if (n > 26) return ViaCall() + n; return -27; }
    static int Unused27(int n) { if (n > 27) return ViaCall() + n; return -28; }
    static int Unused28(int n) { if (n > 28) return ViaCall() + n; return -29; }
    static int Unused29(int n) { if (n > 29) return ViaCall() + n; return -30; }
    static int Unused30(int n) { if (n > 30) return ViaCall() + n; return -31; }
    static int Unused31(int n) { if (n > 31) return ViaCall() + n; return -32; }
}

class Program {
    static void Main() {
        Item item = new Item(8);
        Console.WriteLine(item.Read());
        Base baseItem = new Child();
        Console.WriteLine(baseItem.Value());
        Callback cb = Methods.ViaDelegate;
        Console.WriteLine(cb());
        Console.WriteLine(Methods.ViaCall());
        Console.WriteLine(Boot.Value());
        Console.WriteLine(Generic.Identity<int>(12));
    }
}
