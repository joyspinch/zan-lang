// cs_b10_interp_format.zan -- C#-compat: `{v:D4}` format specifiers inside
// interpolated strings. A top-level `:` in a $"..." hole is the format
// separator (ternaries must be parenthesized, as in C#).
using System;

class Program {
    static void Main() {
        int v = 42;
        Console.WriteLine($"d4={v:D4}");
        Console.WriteLine($"x2={255:X2}");
        Console.WriteLine($"x0={v:X}");
        Console.WriteLine($"d0={v:D0}");
        double f = 3.14159;
        Console.WriteLine($"f2={f:F2}");
        Console.WriteLine($"f1={f:F1}");
        Console.WriteLine($"g3={f:G3}");
        Console.WriteLine($"e2={f:E2}");
        Console.WriteLine($"custom={f:0.00}");
        Console.WriteLine($"pad={v:00000}");
        int n = 7;
        Console.WriteLine($"intf={n:F2}");
        Console.WriteLine($"plain={v}");
        // multiple holes, one with a format
        Console.WriteLine($"mix={v:X} and {f:F1}!");
        // parens keep a ternary's colon out of the format position (C# rule)
        int a = 1;
        Console.WriteLine($"t={ (a > v ? a : v) }");
        Console.WriteLine("done");
    }
}
