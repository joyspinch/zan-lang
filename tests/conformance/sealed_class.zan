// 核心契约与语义定义。
using System;

sealed class Point {
    public int X;
    public int Y;
    public static int OriginCount;
    public int Sum() { return X + Y; }
}

class Widget {
    public virtual string Name() { return "widget"; }
}

class Gadget : Widget {
    public override string Name() { return "gadget"; }
}

class Program {
    static void Main() {
        Point p = new Point();
        p.X = 5;
        p.Y = 6;
        Point.OriginCount = 7;
        Console.WriteLine(Convert.ToString(p.Sum()));
        Console.WriteLine(Convert.ToString(Point.OriginCount));
        Widget w = new Gadget();
        Console.WriteLine(w.Name());
        Console.WriteLine("SEALED-OK");
    }
}
