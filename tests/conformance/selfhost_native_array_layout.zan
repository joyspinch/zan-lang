using System;
using System.Collections.Generic;
using System.Runtime.Intrinsics;

struct NativeArrayPair {
    public long Left;
    public long Right;
}

class Program {
    static int[] StaticValues = new int[] { 17, -23, 31 };

    static void Add(ref int value, int delta) { value = value + delta; }
    static void Set(out byte value) { value = 231; }
    static void Replace(ref NativeArrayPair value, NativeArrayPair replacement) { value = replacement; }
    static T[] Identity<T>(T[] values) { return values; }

    static int Main() {
        int[] ints = Identity<int>(StaticValues);
        Span<int> intView = new Span<int>((nint)ints, ints.Length);
        if (intView[0] != 17 || intView[1] != -23 || intView[2] != 31) { return 1; }
        Add(ref ints[1], 3);
        if (intView[1] != -20 || ints[2] != 31) { return 2; }
        int[,] matrix = new int[2, 2];
        Add(ref matrix[1, 1], -19);
        if (matrix[1, 0] != 0 || matrix[1, 1] != -19) { return 3; }
        byte[] bytes = new byte[] { 12, 25, 37 };
        Set(out bytes[1]);
        if (bytes[0] != 12 || bytes[1] != 231 || bytes[2] != 37) { return 4; }

        NativeArrayPair pair = new NativeArrayPair();
        pair.Left = 31;
        pair.Right = 47;
        NativeArrayPair[] pairs = new NativeArrayPair[] { pair, pair };
        Span<long> words = new Span<long>((nint)pairs, 4);
        if (words[0] != 31 || words[1] != 47 || words[2] != 31 || words[3] != 47) { return 5; }
        NativeArrayPair copy = pairs[0];
        copy.Right = 71;
        if (pairs[0].Right != 47) { return 6; }
        Replace(ref pairs[1], copy);
        pairs[0].Left = 53;
        if (words[0] != 53 || words[1] != 47 || words[3] != 71) { return 7; }
        long sum = 0;
        foreach (NativeArrayPair item in pairs) { sum = sum + item.Right; }
        if (sum != 118) { return 8; }
        List<NativeArrayPair> list = new List<NativeArrayPair>();
        list.Add(copy);
        NativeArrayPair[] fromList = list.ToArray();
        if (fromList[0].Right != 71) { return 9; }

        float[] floats = new float[] { 0.0f, 1.25f, 2.5f, 3.75f, 5.0f };
        float[] target = new float[5];
        Vector128.Store(target, 1, Vector128.Load(floats, 1));
        Span<float> floatView = new Span<float>((nint)target, target.Length);
        if (floatView[0] != 0.0f || floatView[1] != 1.25f || floatView[4] != 5.0f) { return 10; }
        Console.WriteLine("native array layout ok");
        return 0;
    }
}
