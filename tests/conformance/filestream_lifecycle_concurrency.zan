using System;
using System.IO;

class Program {
    static void Main() {
        string testPath = "_scratch/test_filestream_destructor.txt";

        // 阶段 1: 写入测试文件并关闭
        FileStream writer = FileStream.OpenWrite(testPath);
        writer.Write("hello stream destructor");
        writer.Close();

        // 阶段 2: 打开读取，不手动调用 Close，验证其属性与方法
        FileStream reader = FileStream.OpenRead(testPath);
        string text = reader.ReadToEnd();
        if (text != "hello stream destructor") {
            Console.WriteLine("FAIL: ReadToEnd content mismatch: " + text);
            return;
        }

        // 阶段 3: 显式调用 Dispose
        reader.Dispose();
        if (!reader.IsClosed()) {
            Console.WriteLine("FAIL: reader not marked closed after Dispose");
            return;
        }

        File.Delete(testPath);
        Console.WriteLine("PASS: filestream lifecycle and destructor ok");
    }
}
