using System;
using System.Threading;

class TaskActionOwnerReceiver {
    public int value = 61;
    public void Run(int ignored) { Console.WriteLine("wrong overload"); }
    public void Run() {
        Console.WriteLine(TaskActionOwner.observer.IsAlive);
        Console.WriteLine(value);
    }
    public void RunCaught() {
        try { throw new Exception("inside action"); }
        catch (Exception e) {
            Console.WriteLine(TaskActionOwner.observer.IsAlive);
            Console.WriteLine(value + 1);
        }
    }
    public void CancelCandidate() { TaskActionOwner.calls = TaskActionOwner.calls + 1; }
}
class TaskActionOwner {
    public static WeakReference<TaskActionOwnerReceiver> observer;
    public static int calls;
    static Task Queue(int mode) {
        TaskActionOwnerReceiver receiver = new TaskActionOwnerReceiver();
        observer = new WeakReference<TaskActionOwnerReceiver>(receiver);
        if (mode == 0) { return Task.Run(receiver.Run); }
        if (mode == 1) { return Task.Run(receiver.RunCaught); }
        return Task.Run(receiver.CancelCandidate);
    }
    static void Check(int mode) {
        Task task = Queue(mode);
        task.Wait();
        Console.WriteLine(observer.IsAlive);
    }
    static void Main() {
        Check(0);
        Check(1);
        calls = 0;
        Task cancelled = Queue(2);
        Task.Cancel(cancelled);
        cancelled.Wait();
        Console.WriteLine(observer.IsAlive);
        Console.WriteLine(calls >= 0 && calls <= 1);
    }
}
