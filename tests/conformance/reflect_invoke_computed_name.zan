// 封闭世界（普通与发布构建）下按计算名 Invoke：名字只能来自程序里的字符串
// 字面量（或设计稿/框架钩子），只有这些方法保留按名调用能力。本用例钉住：
// 1) 字面名 Invoke 普通公开方法可调（此前发布静默返回 0）；
// 2) 名字经变量/数组/方法返回值流转后仍可调；
// 3) 不带 public 的 override 按名调用命中派生实现（此前跑基类）。
using System;

class Calc {
    public int total = 0;
    public int Add(int a, int b) { return a + b; }
    public string Greet() { return "hi"; }
    public void Bump(int n) { this.total = this.total + n; }
    public virtual string Who() { return "base"; }
}

class LoudCalc : Calc {
    override string Who() { return "loud"; }
}

class Program {
    static string Pick(int i) {
        string[] names = new string[] { "Greet", "Who" };
        return names[i];
    }

    static int Main() {
        LoudCalc c = new LoudCalc();
        Console.WriteLine(c.InvokeInt("Add", 2, 3));
        string m = Program.Pick(0);
        Console.WriteLine(c.InvokeString(m));
        Console.WriteLine(c.InvokeString(Program.Pick(1)));
        string bump = "Bump";
        c.Invoke(bump, 7);
        Console.WriteLine(c.total);
        return 0;
    }
}
