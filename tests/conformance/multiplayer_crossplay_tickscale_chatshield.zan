using System;
using Game.Net;

class Program {
    static int Main() {
        // 1. 跨平台与输入设备匹配隔离过滤器
        NetCrossplayMatchFilter cp = new NetCrossplayMatchFilter(true);
        bool blockedNoOpt = !cp.CanMatchTogether(CrossplayPlatformKind.PcDesktop, true, false,
            CrossplayPlatformKind.Console, false, true, false);
        bool allowedCasual = cp.CanMatchTogether(CrossplayPlatformKind.PcDesktop, true, false,
            CrossplayPlatformKind.Console, true, true, false);
        bool blockedRankedInput = !cp.CanMatchTogether(CrossplayPlatformKind.PcDesktop, true, false,
            CrossplayPlatformKind.Console, true, true, true);
        bool allowedRankedSame = cp.CanMatchTogether(CrossplayPlatformKind.PcDesktop, true, true,
            CrossplayPlatformKind.Console, true, true, true);
        Console.WriteLine("crossplay_filter_ok=" + ((blockedNoOpt && allowedCasual && blockedRankedInput && allowedRankedSame) ? "1" : "0"));

        // 2. 服务端动态仿真降频防雪崩调控器
        NetServerTickRateScaler scaler = new NetServerTickRateScaler(128, 85.0f, 55.0f, 2, 2);
        int hz1 = scaler.SampleCpuUtilization(92.0f); // 1 次过载暂不降 -> 128
        int hz2 = scaler.SampleCpuUtilization(95.0f); // 连续 2 次过载 -> 降频 64
        int hz3 = scaler.SampleCpuUtilization(40.0f); // 1 次回落暂不升 -> 64
        int hz4 = scaler.SampleCpuUtilization(42.0f); // 连续 2 次回落 -> 恢复 128
        bool scalerOk = hz1 == 128 && hz2 == 64 && hz3 == 64 && hz4 == 128;
        Console.WriteLine("tick_scaler_ok=" + (scalerOk ? "1" : "0"));

        // 3. 聊天防刷屏与指数级禁言盾
        NetChatFloodMuteShield shield = new NetChatFloodMuteShield(5000L, 3, 10000L);
        bool m1 = shield.TrySendMessage(1000L, "glhf");
        bool m2 = shield.TrySendMessage(1500L, "push A");
        bool m3 = shield.TrySendMessage(2000L, "smoke mid");
        bool m4Flood = !shield.TrySendMessage(2500L, "extra"); // 第 4 条触发 1 级禁言（10s -> 12500L）
        bool stillMuted = !shield.TrySendMessage(8000L, "hello");
        bool afterMute = shield.TrySendMessage(13000L, "back");
        bool shieldOk = m1 && m2 && m3 && m4Flood && stillMuted && afterMute && shield.OffenseCount == 1;
        Console.WriteLine("chat_shield_ok=" + (shieldOk ? "1" : "0"));
        return 0;
    }
}
