using System;

// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。
class Program {
    static char Ret() { return 'r'; }
    static string Wrap(char c) { return "<" + c + ">"; }

    static void Main() {
        char a = 'A';
        Console.WriteLine(a);
        Console.WriteLine(Ret());
        Console.WriteLine((char)(a + 2));
        Console.Write(a);
        Console.Write('!');
        Console.WriteLine("");

        Console.WriteLine("x=" + a);
        Console.WriteLine(a + "=x");
        Console.WriteLine("[" + a + a + "]");
        Console.WriteLine(Wrap('q'));
        Console.WriteLine($"i({a})");
        Console.WriteLine(String.Format("f={0}!", a));

        // 核心契约与语义定义。
        char eur = (char)0x20AC;
        Console.WriteLine(eur);
        Console.WriteLine("e=" + eur);
        char n = (char)0x00F1;
        Console.WriteLine("n=" + n);

        // 核心契约与语义定义。
        Console.WriteLine((int)a);
        int code = a;
        Console.WriteLine(code);
        Console.WriteLine("c=" + (int)a);

        // 核心契约与语义定义。
        ulong max = 18446744073709551615;
        ulong big = 10000000000000000000;
        Console.WriteLine(max);
        Console.WriteLine(big);
        Console.WriteLine(max - big);
        long lmax = 9223372036854775807;
        Console.WriteLine(lmax);
        ulong hex = 0xFFFFFFFFFFFFFFFF;
        Console.WriteLine(hex);
    }
}
