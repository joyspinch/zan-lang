using System;

/// <summary>
/// 数组字面量的 ARC 所有权用例：new T[]{...} / new T[n]{...} 的
/// 元素若为引用计数类型（字符串、嵌套数组），存入时必须 retain——
/// 否则产出方（局部变量/临时量）释放后，数组持有悬垂指针，堆
/// 复用会把元素改写成别的字符串。循环中反复创建以放大复现窗口。
/// 输出确定性，与 arr_lit_rc.out 比对。
/// </summary>
class ArrLitRcTest {
    static string Key(int i) {
        return "k" + Convert.ToString(i).PadLeft(3, "0");
    }

    /// 字面量经函数边界：参数字符串的引用由调用方管理，
    /// 返回的数组必须自己持有元素。
    static string[] Pair(string k2, string v2) {
        return new string[] { k2, v2 };
    }

    /// 定宽字面量 + null 元素。
    static string[] PairWithNull(string k2) {
        return new string[2] { k2, null };
    }

    static bool Check(List<string[]> rows, int n) {
        if (rows.Count != n) { return false; }
        for (int j = 0; j < n; j = j + 1) {
            if (rows[j][0] != Key(j)) { return false; }
            if (rows[j][1] != "v" + Convert.ToString(100 + j)) { return false; }
        }
        return true;
    }

    static int checks = 0;

    static void Ok(bool cond, string what) {
        checks = checks + 1;
        Console.WriteLine((cond ? "ok " : "FAIL ") + Convert.ToString(checks)
            + " - " + what);
    }

    static void Main() {
        // 1) 函数边界 + 循环：最先暴露悬垂的形态。
        List<string[]> a = new List<string[]>();
        for (int i = 0; i < 8; i = i + 1) {
            a.Add(ArrLitRcTest.Pair(Key(i), "v" + Convert.ToString(100 + i)));
        }
        Ok(ArrLitRcTest.Check(a, 8), "literal via fn boundary");

        // 2) 循环内联字面量，元素是局部变量/拼接临时。
        List<string[]> b = new List<string[]>();
        for (int i = 0; i < 8; i = i + 1) {
            string k2 = Key(i);
            string v2 = "v" + Convert.ToString(100 + i);
            b.Add(new string[] { k2, v2 });
        }
        Ok(ArrLitRcTest.Check(b, 8), "literal inline in loop");

        // 3) 定宽字面量，null 混排。
        List<string[]> c = new List<string[]>();
        for (int i = 0; i < 8; i = i + 1) {
            c.Add(ArrLitRcTest.PairWithNull(Key(i)));
        }
        bool cOk = c.Count == 8;
        for (int j = 0; j < c.Count; j = j + 1) {
            if (c[j][0] != Key(j) || c[j][1] != null) { cOk = false; }
        }
        Ok(cOk, "sized literal with null element");

        // 4) 嵌套数组元素（数组也是引用计数类型）。
        List<string[][]> d = new List<string[][]>();
        for (int i = 0; i < 4; i = i + 1) {
            string[] row = new string[] { Key(i), "v" + Convert.ToString(100 + i) };
            d.Add(new string[][] { row, row });
        }
        bool dOk = d.Count == 4;
        for (int j = 0; j < d.Count; j = j + 1) {
            if (d[j][0][0] != Key(j) || d[j][1][1] != "v" + Convert.ToString(100 + j)) {
                dOk = false;
            }
        }
        Ok(dOk, "nested array elements");

        Console.WriteLine("done " + Convert.ToString(checks) + " checks");
    }
}
