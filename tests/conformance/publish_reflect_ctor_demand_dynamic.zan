using System;
using System.Collections.Generic;

class CtorDemandDynamicBase {
    public int Value;
    public CtorDemandDynamicBase() { Value = 11; }
}

class CtorDemandDynamicDerived : CtorDemandDynamicBase {
    public CtorDemandDynamicDerived() { Value = 29; }
}

// This class is discovered only through a field, element or type argument.
class CtorDemandDynamicChild {
    public int Value;
    public CtorDemandDynamicChild(int value) { Value = value; }
}

class CtorDemandDynamicFields {
    public CtorDemandDynamicChild Child;
}

class Program {
    static void Require(bool value, string message) {
        if (!value) throw new Exception(message);
    }

    static TypeInfo Select(TypeInfo left, TypeInfo right, bool first) {
        if (first) return left;
        return right;
    }

    static object Make(TypeInfo type, int value) { return type.CreateInstance(value); }

    static void Main() {
        CtorDemandDynamicBase existing = new CtorDemandDynamicDerived();
        TypeInfo runtimeType = existing.GetType();
        object dynamicCopy = runtimeType.CreateInstance();
        Require(dynamicCopy is CtorDemandDynamicDerived, "dynamic GetType constructor identity");
        Require(dynamicCopy.GetFieldInt("Value") == 29, "dynamic constructor body");

        TypeInfo selected = Select(typeof(CtorDemandDynamicBase), runtimeType, true);
        object selectedCopy = selected.CreateInstance();
        Require(selectedCopy is CtorDemandDynamicBase &&
            !(selectedCopy is CtorDemandDynamicDerived), "unknown TypeInfo parameter fallback");
        Require(selectedCopy.GetFieldInt("Value") == 11, "selected constructor body");

        TypeInfo fieldType = typeof(CtorDemandDynamicFields).GetFieldTypeInfo(0);
        object fieldCopy = Make(fieldType, 37);
        Require(fieldCopy is CtorDemandDynamicChild && fieldCopy.GetFieldInt("Value") == 37,
            "field TypeInfo callable constructor");

        TypeInfo listType = typeof(List<CtorDemandDynamicChild>);
        object elementCopy = Make(listType.ElementType, 41);
        object argumentCopy = Make(listType.GetTypeArg(0), 43);
        Require(elementCopy.GetFieldInt("Value") == 41, "element TypeInfo callable constructor");
        Require(argumentCopy.GetFieldInt("Value") == 43, "generic argument callable constructor");
        object list = Select(listType, runtimeType, true).CreateInstance();
        Require(list is List<CtorDemandDynamicChild>, "late builtin List constructor identity");
        Require(list.Invoke("Add", elementCopy), "reflected List Add");
        List<CtorDemandDynamicChild> typed = (List<CtorDemandDynamicChild>)list;
        Require(typed.Count == 1 && typed[0].Value == 41, "reflected List typed readback");
        Console.WriteLine("dynamic PASS");
    }
}
