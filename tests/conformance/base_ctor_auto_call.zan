using System;

class BaseEntity {
    public string tag;
    public int baseVal;

    public BaseEntity() {
        this.tag = "base_tag_initialized";
        this.baseVal = 42;
    }
}

// 场景 1：派生类自身未声明构造函数，隐式链接基类无参构造
class SubEntityNoCtor : BaseEntity {
    public string extra = "sub_field";
}

// 场景 2：多层继承，中间类与叶子类均未声明构造函数
class MiddleEntityNoCtor : BaseEntity {
    public int mid = 100;
}

class LeafEntityNoCtor : MiddleEntityNoCtor {
    public int leaf = 200;
}

// 场景 3：派生类显式声明构造函数，但省略 : base()，隐式链接基类无参构造
class ExplicitSubEntity : BaseEntity {
    public string selfMsg;

    public ExplicitSubEntity() {
        this.selfMsg = "self_initialized";
    }
}

class Program {
    static int Main() {
        SubEntityNoCtor s1 = new SubEntityNoCtor();
        Console.WriteLine(s1.tag);
        Console.WriteLine(s1.baseVal);
        Console.WriteLine(s1.extra);

        LeafEntityNoCtor s2 = new LeafEntityNoCtor();
        Console.WriteLine(s2.tag);
        Console.WriteLine(s2.baseVal);
        Console.WriteLine(s2.mid);
        Console.WriteLine(s2.leaf);

        ExplicitSubEntity s3 = new ExplicitSubEntity();
        Console.WriteLine(s3.tag);
        Console.WriteLine(s3.baseVal);
        Console.WriteLine(s3.selfMsg);

        return 0;
    }
}
