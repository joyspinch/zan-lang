using System;

class Box {
    public int v;
    public Box(int v) { this.v = v; }
    public string Show() { return "Box(" + v + ")"; }
}

class Pool<T> {
    public T item;

    public void Set(T x) { item = x; }
    public T Get() { return item; }

    public U Echo<U>(U x) { return x; }
    public U Forward<U>(U x) { return this.Echo<U>(x); }
    public string Pair<U>(U x) { return item + "/" + x; }
    public string PairThis<U>(U x) { return this.item + "/" + x; }
    public int CountOf<U>(U[] xs) { return xs.Length; }
    public string Describe<U>(U x) { return this.item.ToString() + ":" + x.ToString(); }
}

class Program {
    static void Main() {
        Pool<string> ps = new Pool<string>();
        ps.Set("hello");
        Console.WriteLine(ps.Get());
        Console.WriteLine(ps.Echo<int>(7));
        Console.WriteLine(ps.Echo<string>("str"));
        Console.WriteLine(ps.Echo<double>(1.5));
        Console.WriteLine(ps.Pair<int>(3));
        Console.WriteLine(ps.PairThis<int>(4));
        Console.WriteLine(ps.Forward<int>(9));
        Console.WriteLine(ps.Describe<int>(5));

        Pool<int> pi = new Pool<int>();
        pi.Set(42);
        Console.WriteLine(pi.Get());
        Console.WriteLine(pi.Echo<string>("x"));
        Console.WriteLine(pi.Pair<string>("y"));
        Console.WriteLine(pi.Forward<double>(2.25));

        Pool<Box> pb = new Pool<Box>();
        pb.Set(new Box(5));
        Console.WriteLine(pb.Get().Show());
        Box b = pb.Echo<Box>(new Box(6));
        Console.WriteLine(b.Show());
        Box c = pb.Forward<Box>(new Box(7));
        Console.WriteLine(c.Show());

        int[] nums = new int[3];
        Console.WriteLine(ps.CountOf<int>(nums));
        Console.WriteLine("end");
    }
}
