using System;

class ArrProbe {
    static void Main() {
        int[] a = new int[] { 10, 20, 30 };
        // try 外越界读
        int x = a[10];
        Console.WriteLine("out oob=" + x);
        // 负索引
        int y = a[-1];
        Console.WriteLine("out neg=" + y);
        // try 内越界:IndexOutOfRangeException?
        try {
            int z = a[10];
            Console.WriteLine("in oob no-throw");
        } catch (IndexOutOfRangeException) {
            Console.WriteLine("in oob IndexOutOfRangeException");
        } catch (Exception e) {
            Console.WriteLine("in oob " + e.GetType().Name);
        }
        // null 数组索引:NRE?
        int[] t = null;
        try {
            int w = t[0];
            Console.WriteLine("in null no-throw");
        } catch (NullReferenceException) {
            Console.WriteLine("in null NullReferenceException");
        } catch (Exception e) {
            Console.WriteLine("in null " + e.GetType().Name);
        }
        // try 外 null 读 + null Length：soft 报告后落 scratch 页/零页继续跑
        // （0 号元素 = 0，Length = 宿主 scratch 哨兵 1<<62）。diff 门
        // null_string_index 暴露的缺口正是这条路径此前未被用例覆盖。
        int[] t2 = null;
        Console.WriteLine(t2[0]);
        Console.WriteLine(t2.Length);
        // 域内回归
        Console.WriteLine("norm " + a[0] + " " + a[1] + " " + a[2]);
    }
}
