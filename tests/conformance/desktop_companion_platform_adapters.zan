using System;
using System.Windows;

class Program {
    static int Main() {
        // 1. 宿主单点工厂装配（零业务层 if）
        ICompanionPlatformAdapter host = CompanionPlatformRegistry.Current();
        bool hostOk = host.OsName().Length > 0 && host.FormatShortcut("Space").Length > 5;
        Console.WriteLine("host_adapter_ok=" + (hostOk ? "1" : "0"));

        // 2. 四平台独立文件实现类经同一接口统一多态调用
        ICompanionPlatformAdapter win = new WindowsCompanionPlatform();
        ICompanionPlatformAdapter mac = new MacOsCompanionPlatform();
        ICompanionPlatformAdapter lin = new LinuxCompanionPlatform();
        ICompanionPlatformAdapter ohos = new HarmonyOsCompanionPlatform();
        bool shortcutsOk = win.FormatShortcut("K") == "Ctrl+K"
            && mac.FormatShortcut("K") == "Cmd+K"
            && lin.FormatShortcut("K") == "Ctrl+K"
            && ohos.FormatShortcut("K") == "Ctrl+K";
        bool storageOk = win.ResolveStorageDir("Pet", "saves") == "%APPDATA%/Pet/saves"
            && mac.ResolveStorageDir("Pet", "cache") == "~/Library/Caches/Pet"
            && lin.ResolveStorageDir("Pet", "logs") == "$XDG_STATE_HOME/Pet/logs"
            && ohos.ResolveStorageDir("Pet", "saves") == "/data/storage/el2/base/files/Pet/saves";
        bool traitsOk = win.TrayInteraction() == "TrayLeftClick"
            && mac.TopBarInsetPx() == 24 && mac.BottomBarInsetPx() == 64
            && lin.AutostartMechanism() == "XdgAutostartDesktop" && !lin.SupportsBackdropBlur()
            && ohos.TrayInteraction() == "DockBadgeCard" && ohos.SupportsBackdropBlur();
        Console.WriteLine("per_os_adapters_ok=" + ((shortcutsOk && storageOk && traitsOk) ? "1" : "0"));
        return 0;
    }
}
