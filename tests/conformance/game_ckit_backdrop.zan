using System;
using System.IO;
using Gui;
using Game.Kit;

// Game.Kit.CKitBackdrop 的契约：视差背景的 cover 取景（裁源，不拼接）。
//
// 背景：`df6d0a642` 那次"共享美术层"把**怎么用**写进了模板与技能——
// templates/game/platformer 直接调 `CKitBackdrop.Draw`，game-dev 技能里
// 也写着 `CDraw.BlitImageSrc / CKitBackdrop.Draw`——却没把**用什么**写进
// 包：Game.Kit.CKitBackdrop 从未在 packages/ 里出现过
// （`git log --all -S 'CKitBackdrop' -- packages/` 是空输出）。于是
// platformer 模板编译不过：
//   unresolved call 'CKitBackdrop.Draw': 'CKitBackdrop' is not a known
//   variable, type, or namespace
// 同一批提交带出的 `CDraw.BlitImageSrc` 是同一种缺口（另一个用例钉）。
//
// 判据（分两层）：
//   1. SourceRect 是纯函数，算的是**源图像素**的取景矩形——逐值钉住；
//   2. Draw 真的把这块源矩形贴到目标矩形——用像素钉。
//
// 取景语义（技能里的原话："背景图放大到比视口宽（cover）后按相机偏移裁源
// 取景，越界偏移夹取，取景永远落在图内"）：
//   - 源图按 coverPercent 放大，pct=125 = 放大到 125%；
//   - 视口窗口折算回源图像素：sw = dw*100/pct；
//   - 相机偏移同样折算回源图像素，再夹取到 [0, iw-sw]。
//
// 夹具：4x4 PNG，四象限各一色（红/绿/蓝/黄），内嵌为 "ckitfx/src.png"
// （见 CMakeLists 的 --embed 分支）。盘上没有这个路径，走 File.ReadAllBytes
// 的内嵌兜底——File.Exists 也带内嵌兜底，所以"素材缺失就跳过"那条守卫
// 不会把内嵌夹具误判成缺失。
class Program {
    static int fails;

    static void Eq(string what, int got, int want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got " + Convert.ToString(got)
            + " want " + Convert.ToString(want));
    }

    static void Ok(bool cond, string what) {
        if (cond) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    // 取像素的 RGB（0xRRGGBB）。
    static int Px(Canvas c, int x, int y) {
        return c.GetPixel(x, y) & 0x00FFFFFF;
    }

    static void Main() {
        fails = 0;

        App app = new App("ckit-backdrop", 64, 64);
        app.BeginFrame();
        Canvas c = app.canvas;
        if (c == null || c.Width() <= 0 || c.Height() <= 0) {
            // 没有可用表面（无显示环境）：按 harness 的 SKIP 约定退出。
            Console.WriteLine("SKIP: no GUI surface in this session");
            return;
        }

        string src = "ckitfx/src.png";
        CDraw.Origin(0, 0);   // 逻辑原点归零、视口 1:1（默认态）

        // ---- 1. SourceRect：纯函数，逐值钉住 ----
        int sx; int sy; int sw; int sh;

        // 1:1 取景（pct=100）：视口多大就取源图像素多大。
        CKitBackdrop.SourceRect(100, 50, 80, 40, 100, 0, 0, out sx, out sy, out sw, out sh);
        Eq("pct100 sx", sx, 0);
        Eq("pct100 sy", sy, 0);
        Eq("pct100 sw", sw, 80);
        Eq("pct100 sh", sh, 40);

        // cover 放大到 125%：视口 80x40 在放大后的图上只看到 64x32 源像素。
        CKitBackdrop.SourceRect(100, 50, 80, 40, 125, 0, 0, out sx, out sy, out sw, out sh);
        Eq("pct125 sx", sx, 0);
        Eq("pct125 sy", sy, 0);
        Eq("pct125 sw", sw, 64);
        Eq("pct125 sh", sh, 32);

        // 偏移按同一个倍率折算回源图像素，并夹取到图内：
        // offsetX=100 → 源像素 80，但图只有 100 宽、窗口 64，maxX=36 → 夹到 36。
        CKitBackdrop.SourceRect(100, 50, 80, 40, 125, 100, 0, out sx, out sy, out sw, out sh);
        Eq("clamp sx", sx, 36);
        Eq("clamp sy", sy, 0);
        Eq("clamp sw", sw, 64);
        Eq("clamp sh", sh, 32);

        // 负偏移夹到 0（不越出左/上边）。
        CKitBackdrop.SourceRect(100, 50, 80, 40, 125, -100, -100, out sx, out sy, out sw, out sh);
        Eq("neg sx", sx, 0);
        Eq("neg sy", sy, 0);

        // 纵向同理：offsetY=100 → 源像素 80，maxY = 50-32 = 18 → 夹到 18。
        CKitBackdrop.SourceRect(100, 50, 80, 40, 125, 0, 100, out sx, out sy, out sw, out sh);
        Eq("clamp sy2", sy, 18);

        // 视口比整幅源图还大：窗口夹到源图尺寸（不越界采样）。
        CKitBackdrop.SourceRect(40, 20, 200, 100, 100, 0, 0, out sx, out sy, out sw, out sh);
        Eq("big sw", sw, 40);
        Eq("big sh", sh, 20);
        Eq("big sx", sx, 0);
        Eq("big sy", sy, 0);

        // 非法输入：源图或视口尺寸为 0 → 取景为空（调用方据此跳过绘制）。
        CKitBackdrop.SourceRect(0, 50, 80, 40, 125, 0, 0, out sx, out sy, out sw, out sh);
        Eq("degenerate sw", sw, 0);
        Eq("degenerate sh", sh, 0);

        // ---- 2. Draw：真的把取景贴到目标矩形（像素级） ----
        // 夹具 4x4：左上红 / 右上绿 / 左下蓝 / 右下黄（象限各 2x2）。
        // 目标 4x4 + pct=200 → 窗口 = 4*100/200 = 2 个源像素，于是偏移
        // 能把取景挪到别的象限（maxX = 4-2 = 2，可挪 0..2）。
        c.FillRect(0, 0, 64, 64, 0xFF101010);
        CKitBackdrop.Draw(c, src, 0, 0, 4, 4, 0, 0, 200);        // 源左上 → 红
        CKitBackdrop.Draw(c, src, 8, 0, 4, 4, 4, 0, 200);        // 源右上 → 绿
        CKitBackdrop.Draw(c, src, 0, 8, 4, 4, 0, 4, 200);        // 源左下 → 蓝
        CKitBackdrop.Draw(c, src, 8, 8, 4, 4, 4, 4, 200);        // 源右下 → 黄
        Eq("draw tl", Px(c, 1, 1), 0xFF0000);
        Eq("draw tr", Px(c, 9, 1), 0x00FF00);
        Eq("draw bl", Px(c, 1, 9), 0x0000FF);
        Eq("draw br", Px(c, 9, 9), 0xFFFF00);
        // 目标矩形之外仍是底色：说明没溢出到邻块。
        Eq("draw untouched", Px(c, 40, 40), 0x101010);

        // 偏移越界必须夹取，不能采到图外（否则是越界采样，颜色会串）。
        CKitBackdrop.Draw(c, src, 16, 0, 4, 4, 999, 999, 200);
        Eq("draw clamped", Px(c, 17, 1), 0xFFFF00);

        // ---- 3. 素材缺失：跳过，不抛异常（矢量兜底由调用方负责） ----
        CKitBackdrop.Draw(c, "ckitfx/definitely-missing.png", 32, 32, 4, 4, 0, 0, 200);
        Eq("missing asset leaves canvas", Px(c, 33, 33), 0x101010);

        if (fails == 0) { Console.WriteLine("ckit-backdrop-ok"); }
    }
}
