using System;
using System.Diagnostics;

class Program {
    static void Main() {
        Console.WriteLine("[1] Testing Activity tracing and hierarchy...");
        Activity root = Activity.Start("RootOperation");
        root.SetTag("env", "test");
        root.SetTag("service", "zan-benchmark");

        Activity child = Activity.Start("DatabaseQuery");
        child.SetTag("query", "SELECT * FROM users");
        child.Stop();

        root.Stop();

        Console.WriteLine("Root traceId length: " + Convert.ToString(root.traceId.Length));
        Console.WriteLine("Child parentSpanId valid: " + (child.parentSpanId.Length > 0 ? "true" : "false"));
        Console.WriteLine("Child matches Root spanId: " + (child.parentSpanId == root.spanId ? "true" : "false"));

        Console.WriteLine("[2] Testing TraceExporter to Perfetto / Chrome tracing format...");
        TraceExporter exporter = new TraceExporter();
        exporter.AddActivity(root);
        exporter.AddActivity(child);

        string json = exporter.ToPerfettoJson();
        Console.WriteLine("Has traceEvents: " + (json.IndexOf("\"traceEvents\":") >= 0 ? "true" : "false"));
        Console.WriteLine("Has RootOperation: " + (json.IndexOf("RootOperation") >= 0 ? "true" : "false"));
        Console.WriteLine("Has DatabaseQuery: " + (json.IndexOf("DatabaseQuery") >= 0 ? "true" : "false"));
        Console.WriteLine("Has traceId: " + (json.IndexOf("traceId") >= 0 ? "true" : "false"));

        Console.WriteLine("OK: all trace exporter checks passed!");
    }
}
