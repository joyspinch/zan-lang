class Calc {
    public static int Sum(params int[] xs) {
        int t = 0;
        for (int i = 0; i < xs.Length; i = i + 1) { t = t + xs[i]; }
        return t;
    }
    public static string Join(string sep, params string[] parts) {
        string r = "";
        for (int i = 0; i < parts.Length; i = i + 1) {
            if (i > 0) { r = r + sep; }
            r = r + parts[i];
        }
        return r;
    }
    public int Mul(params int[] xs) {
        int t = 1;
        for (int i = 0; i < xs.Length; i = i + 1) { t = t * xs[i]; }
        return t;
    }
    // the bundle is an array like C#'s, so it hands on to any int[] parameter
    public static int Forward(params int[] xs) { return Calc.Sum(xs); }
}
class Program {
    static void Main() {
        Console.WriteLine(Calc.Sum(1, 2, 3, 4));
        Console.WriteLine(Calc.Sum());
        Console.WriteLine(Calc.Join("-", "a", "b", "c"));
        Calc c = new Calc();
        Console.WriteLine(c.Mul(2, 3, 4));
        int[] pre = new int[] { 5, 6 };
        Console.WriteLine(Calc.Sum(pre));
        Console.WriteLine(Calc.Forward(7, 8));
    }
}
