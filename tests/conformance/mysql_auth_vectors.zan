using System;
using System.Data.MySql;
using System.Security.Cryptography;

class Program {
    static void Main() {
        string nonce = "12345678901234567890";
        byte[] native = MySqlConnection.scrambleNative("secret", nonce);
        byte[] caching = MySqlConnection.scramble41("secret", nonce);
        Console.WriteLine(Hex.Encode(native, 20));
        Console.WriteLine(Hex.Encode(caching, 32));
    }
}
