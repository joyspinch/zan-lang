using System;
using System.IO;

class Node {
    public Node next;
    public int id;
    public Node(int id) {
        this.id = id;
    }
}

class Holder {
    public weak Node target;
}

class Program {
    // 1. 自环 A -> A
    static void SetupSelfCycle(Holder h) {
        Node a = new Node(101);
        a.next = a;
        h.target = a;
    }

    // 2. 双节点环 A <-> B
    static void SetupPairCycle(Holder h) {
        Node a = new Node(201);
        Node b = new Node(202);
        a.next = b;
        b.next = a;
        h.target = a;
    }

    // 3. 多节点环 A -> B -> C -> A
    static void SetupTriCycle(Holder h) {
        Node a = new Node(301);
        Node b = new Node(302);
        Node c = new Node(303);
        a.next = b;
        b.next = c;
        c.next = a;
        h.target = a;
    }

    static void Main() {
        // 初始无环
        long c0 = GC.DetectCycles();
        Console.WriteLine("baseline cycles: " + c0);

        // 验证 1：活根引用的环不应被误判为孤儿泄漏环
        Node liveRootA = new Node(1);
        Node liveRootB = new Node(2);
        liveRootA.next = liveRootB;
        liveRootB.next = liveRootA;
        long liveCycles = GC.DetectCycles();
        Console.WriteLine("live reachable cycle: " + (liveCycles == 0));
        liveRootA.next = null; // 解除活根环

        // 验证 2：孤立自环 A -> A
        Holder hSelf = new Holder();
        SetupSelfCycle(hSelf);
        long selfCycles = GC.DetectCycles();
        Console.WriteLine("orphan self cycle: " + (selfCycles == 1));
        if (hSelf.target != null) {
            hSelf.target.next = null;
        }
        Console.WriteLine("after self cycle break: " + (GC.DetectCycles() == 0));

        // 验证 3：孤立双节点环 A <-> B
        Holder hPair = new Holder();
        SetupPairCycle(hPair);
        long pairCycles = GC.DetectCycles();
        Console.WriteLine("orphan pair cycle: " + (pairCycles == 2));
        if (hPair.target != null) {
            hPair.target.next = null;
        }
        Console.WriteLine("after pair cycle break: " + (GC.DetectCycles() == 0));

        // 验证 4：孤立三节点环 A -> B -> C -> A
        Holder hTri = new Holder();
        SetupTriCycle(hTri);
        long triCycles = GC.DetectCycles();
        Console.WriteLine("orphan tri cycle: " + (triCycles == 3));
        if (hTri.target != null) {
            hTri.target.next = null;
        }
        Console.WriteLine("after tri cycle break: " + (GC.DetectCycles() == 0));

        // 验证 5：堆快照导出
        string snapPath = "build/cases/gc_cycle_detector_snap.txt";
        long snapObjects = GC.WriteHeapSnapshot(snapPath);
        bool snapExists = File.Exists(snapPath);
        Console.WriteLine("snapshot objects: " + (snapObjects > 0));
        Console.WriteLine("snapshot file exists: " + snapExists);
        if (snapExists) {
            string text = File.ReadAllText(snapPath);
            Console.WriteLine("snapshot header: " + (text != null && text.Contains("# Zan Heap Snapshot")));
            File.Delete(snapPath);
        }

        Console.WriteLine("gc cycle detector: all ok");
    }
}
