using System;

class Bare {
    // A bare `return;` in a non-void method returns the ZERO of the result
    // type -- the C host does that (src/compiler/irgen_stmt.c:1739).
    static int Zero() { return; }
}

class Program {
    static void Main() {
        // Convert.ToInt32 parses the text with strtoll (base 10)
        Console.WriteLine(Convert.ToInt32("123"));
        Console.WriteLine(Convert.ToInt32("-7"));
        // An integer keeps its value: the 32-bit narrowing happens where the
        // value enters a typed location (an int slot), not in the call.
        long big = 4294967296 + 5;
        Console.WriteLine(Convert.ToInt32(big));
        int narrowed = Convert.ToInt32(big);
        Console.WriteLine(narrowed);
        // A float truncates towards zero
        Console.WriteLine(Convert.ToInt32(3.9));
        Console.WriteLine(Convert.ToInt32(-3.9));
        // ToInt64 keeps the whole range
        Console.WriteLine(Convert.ToInt64("456"));
        Console.WriteLine(Convert.ToInt64(4294967296 + 5));
        // int.Parse goes through the same parse
        Console.WriteLine(int.Parse("77"));
        Console.WriteLine(Bare.Zero());
    }
}
