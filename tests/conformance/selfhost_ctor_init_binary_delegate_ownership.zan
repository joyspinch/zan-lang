using System;
using System.Collections.Generic;

namespace SelfhostCtorInitBinaryDelegateOwnership;

class Box {
    public int Val;
    public string Name;
    public List<Box> Items;
    public Box(int v) {
        this.Val = v;
        this.Name = "b_" + v.ToString();
        this.Items = new List<Box>();
    }
    public static Box operator +(Box a, Box b) {
        if (b.Val < 0) { throw new Exception("op_add_boom"); }
        return new Box(a.Val + b.Val);
    }
    public static Box operator -(Box a) {
        if (a.Val < 0) { throw new Exception("op_neg_boom"); }
        return new Box(-a.Val);
    }
    public static Box operator ++(Box a) {
        return new Box(a.Val + 1);
    }
}

class Program {
    static Box MakeBox(int v) { return new Box(v); }
    static Box BoomBox() { throw new Exception("boom_box"); }
    static Func<Box, int> MakeClosure(Box captured) {
        return (Box arg) => {
            if (arg.Val < 0) { throw new Exception("fn_boom_" + captured.Name); }
            return captured.Val + arg.Val;
        };
    }

    static int TestParameterizedCtorInit() {
        int acc = 0;
        Box b1 = new Box(42) { Name = MakeBox(1).Name };
        acc = acc + b1.Val + b1.Name.Length;
        Box b2 = new Box(10) { Name = MakeBox(2).Name, Items = { MakeBox(3), MakeBox(4) } };
        acc = acc + b2.Val + b2.Items.Count + b2.Items[0].Val + b2.Items[1].Val;
        try {
            Box b3 = new Box(1) { Name = MakeBox(2).Name, Items = { MakeBox(3), BoomBox() } };
            acc = acc + b3.Val;
        } catch (Exception e) {
            acc = acc + e.Message.Length;
        }
        return acc;
    }

    static int TestBinaryAndCheckedExprStmt() {
        int acc = 0;
        int z = 0;
        int mx = 2147483647;
        try {
            MakeBox(1) + MakeBox(-2);
        } catch (Exception e) {
            acc = acc + e.Message.Length;
        }
        try {
            -MakeBox(-5);
        } catch (Exception e) {
            acc = acc + e.Message.Length;
        }
        try {
            MakeBox(1).Val / z;
        } catch (Exception e) {
            acc = acc + (e.Message.Length > 0 ? 1 : 0);
        }
        try {
            checked(MakeBox(1).Val + mx);
        } catch (Exception e) {
            acc = acc + (e.Message.Length > 0 ? 1 : 0);
        }
        try {
            checked((byte)MakeBox(300).Val);
        } catch (Exception e) {
            acc = acc + (e.Message.Length > 0 ? 1 : 0);
        }
        return acc;
    }

    static int TestDelegateCallAndPostfixOwnership() {
        int acc = 0;
        acc = acc + MakeClosure(MakeBox(3))(MakeBox(4));
        try {
            MakeClosure(MakeBox(1))(BoomBox());
        } catch (Exception e) {
            acc = acc + e.Message.Length;
        }
        try {
            MakeClosure(MakeBox(2))(MakeBox(-3));
        } catch (Exception e) {
            acc = acc + e.Message.Length;
        }
        Func<Box, int> fn = MakeClosure(MakeBox(5));
        acc = acc + fn(MakeBox(6));
        try {
            fn(BoomBox());
        } catch (Exception e) {
            acc = acc + e.Message.Length;
        }
        Box lv = MakeBox(10);
        Box oldLv = lv++;
        acc = acc + oldLv.Val + lv.Val;
        return acc;
    }

    static void Main() {
        Console.WriteLine("ctor_init=" + TestParameterizedCtorInit().ToString());
        Console.WriteLine("binary_stmt=" + TestBinaryAndCheckedExprStmt().ToString());
        Console.WriteLine("delegate_postfix=" + TestDelegateCallAndPostfixOwnership().ToString());
    }
}
