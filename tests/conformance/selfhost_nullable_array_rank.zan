using System;

class SelfhostNullableArrayRank {
    static int?[] EchoOne(int?[] values) { return values; }
    static int?[,] EchoRect(int?[,] values) { return values; }

    static void Main() {
        int?[] values = new int?[3];
        values[0] = 11;
        values[1] = null;
        values[2] = 29;
        int?[] alias = EchoOne(values);
        Console.WriteLine(alias.Length);
        Console.WriteLine(alias[0].Value);
        Console.WriteLine(alias[1].HasValue ? 1 : 0);
        Console.WriteLine(alias[2].Value);
        alias[1] = 17;
        Console.WriteLine(values[1].Value);
        alias[0] = null;
        Console.WriteLine(values[0].HasValue ? 1 : 0);
        values = null;
        Console.WriteLine(alias[1].Value);
        Console.WriteLine(alias[2].Value);

        int?[,] rect = new int?[2,3];
        rect[0,0] = 31;
        rect[0,1] = null;
        rect[0,2] = 47;
        rect[1,0] = 53;
        rect[1,1] = 61;
        rect[1,2] = 73;
        int?[,] rectAlias = EchoRect(rect);
        Console.WriteLine(rectAlias[0,0].Value);
        Console.WriteLine(rectAlias[0,1].HasValue ? 1 : 0);
        Console.WriteLine(rectAlias[0,2].Value);
        Console.WriteLine(rectAlias[1,0].Value);
        rectAlias[1,1] = 67;
        Console.WriteLine(rect[1,1].Value);
        rectAlias[0,2] = null;
        Console.WriteLine(rect[0,2].HasValue ? 1 : 0);
        Console.WriteLine(rect[1,2].Value);
        rect = null;
        Console.WriteLine(rectAlias[0,0].Value);
        Console.WriteLine(rectAlias[1,1].Value);
    }
}
