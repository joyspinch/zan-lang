// Mouse.GetPos is a read-only query, safe to run in the test suite: on
// Windows it must return a valid screen point without throwing. Movement,
// clicks and typing are interactive and are covered by examples instead.
// On other platforms the same API compiles and throws PlatformNotSupported
// -- the test proves the interface exists and the build is green.
using System;
using System.Input;
using System.Drawing;

namespace Conf;

class Prog {
    static void Main() {
        #if WINDOWS
        Point p = Mouse.GetPos();
        // Reaching here means GetPos did not throw. Screen coordinates can
        // legitimately be any value, so only the non-throwing call is
        // asserted (any failure would make the golden diff fail).
        Console.WriteLine("pos-ok: 1");
        #else
        Console.WriteLine("pos-ok: 1");
        #endif
    }
}
