// 接口数据协议与执行契约。
// 核心契约与语义定义。
using System;

class Program {
    static void Main() {
        long min = -9223372036854775808;
        long max = 9223372036854775807;
        ulong umax = 18446744073709551615;
        ulong ubig = 9300000000000000000;
        int i = -7;
        short sh = -32768;
        byte b = 200;
        long zero = 0;

        Console.WriteLine($"{min}");
        Console.WriteLine($"{max}");
        Console.WriteLine($"{umax}");
        Console.WriteLine($"{ubig}");
        Console.WriteLine($"{zero}|{i}|{sh}|{b}");
        Console.WriteLine($"a{min}b{umax}c");

        Console.WriteLine(Convert.ToString(min));
        Console.WriteLine(Convert.ToString(umax));
        Console.WriteLine(Convert.ToString(zero));
        Console.WriteLine(Convert.ToString(i));

        Console.WriteLine(min.ToString());
        Console.WriteLine(umax.ToString());
        Console.WriteLine(zero.ToString());

        StringBuilder sb = new StringBuilder();
        sb.Append(min);
        sb.Append(",");
        sb.Append(max);
        sb.Append(",");
        sb.Append(0);
        sb.Append(",");
        sb.Append(umax);
        Console.WriteLine(sb.ToString());

        // 接口数据协议与执行契约。
        Console.WriteLine("" + umax + "|" + min + "|" + b);

        // 核心契约与语义定义。
        Console.WriteLine($"{i:D8}");
        Console.WriteLine($"{255:X4}");
        Console.WriteLine($"{i:F2}");
    }
}
