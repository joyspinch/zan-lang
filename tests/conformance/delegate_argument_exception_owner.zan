using System;
using System.Threading;

class DelegateArgumentExceptionOwner {
    static void Require(bool value, string message) {
        if (!value) { throw new Exception(message); }
    }

    static void ReadToken(CancellationToken token) {
        Require(!token.IsCancellationRequested, "unexpected cancellation");
    }

    static void FailToken(CancellationToken token) {
        throw new Exception("token callback");
    }

    static void CheckToken(bool throwing) {
        CancellationTokenSource source = new CancellationTokenSource();
        WeakReference<CancellationToken> observer = new WeakReference<CancellationToken>(source.Token);
        Action<CancellationToken> callback = ReadToken;
        if (throwing) { callback = FailToken; }
        bool caught = false;
        try { callback(source.Token); }
        catch (Exception error) { caught = error.Message == "token callback"; }
        Require(caught == throwing, "token callback outcome");
        source.Dispose();
        source = null;
        Require(!observer.IsAlive, "delegate argument property temporary retained");
    }

    static void CheckClosure(bool throwing) {
        Semaphore entered = new Semaphore(0, 1);
        Semaphore release = new Semaphore(0, 1);
        WeakReference<Semaphore> enteredObserver = new WeakReference<Semaphore>(entered);
        WeakReference<Semaphore> releaseObserver = new WeakReference<Semaphore>(release);
        Action callback = () => {
            entered.Release();
            release.Release();
            if (throwing) { throw new Exception("closure callback"); }
        };
        bool caught = false;
        try { callback(); }
        catch (Exception error) { caught = error.Message == "closure callback"; }
        Require(caught == throwing, "closure callback outcome");
        callback = null;
        entered.Dispose(); release.Dispose();
        entered = null; release = null;
        Require(!enteredObserver.IsAlive && !releaseObserver.IsAlive, "delegate invocation retained closure captures");
    }

    static void Main() {
        CheckToken(false);
        CheckClosure(false);
        CheckClosure(true);
        CheckToken(true);
        Console.WriteLine("delegate argument exception ownership ok");
    }
}
