using System;

namespace Conf;

class UintInlineBitmaskEqTest {
    static void Main() {
        uint x = 0xFF0078D7U;
        uint y = 0x00123456U;
        // 1. 内联 uint 位运算结果（bit31=1）直接与 uint 常量做 == / != 比较，不得被错误符号扩展
        bool eq1 = (x & 0xFF000000U) == 0xFF000000U;
        bool eq2 = 0xFF000000U == (x & 0xFF000000U);
        // 2. 内联 uint 无符号序比较（bit31=1）
        bool lt1 = (y | 0x80000000U) < 0x90000000U;
        bool gt1 = (x & 0xFF000000U) > 0x7FFFFFFFU;
        // 3. 内联 uint 提升至 long 算术（零扩展为 4278190080L，而非 -16777216L）
        long promoted = (x & 0xFF000000U) + 1L;
        bool longOk = promoted == 4278190081L;
        // 4. 内联 uint 提升至 double（零扩展 UIToFP，而非负数 SIToFP）
        double asDouble = (x & 0xFF000000U) + 0.0;
        bool doubleOk = asDouble > 4278190000.0 && asDouble < 4278190100.0;

        Console.WriteLine("eq: " + Convert.ToString((eq1 && eq2) ? 1 : 0));
        Console.WriteLine("cmp: " + Convert.ToString((lt1 && gt1) ? 1 : 0));
        Console.WriteLine("widen-long: " + Convert.ToString(longOk ? 1 : 0));
        Console.WriteLine("widen-double: " + Convert.ToString(doubleOk ? 1 : 0));
    }
}
