// cs_b02_using.zan -- C#-compat: `using (res) { }` deterministic disposal.
// Desugars to try/finally + Dispose(); the resource is released on both the
// normal exit and an exceptional one.
using System;

class Res : IDisposable {
    public string Name;
    public void Dispose() { Console.WriteLine("dispose " + Name); }
}

class Program {
    static void Main() {
        using (Res r = new Res()) {
            r.Name = "x";
        }
        Console.WriteLine("after-x");
        try {
            using (Res r2 = new Res()) {
                r2.Name = "boom";
                throw new Exception("oops");
            }
        } catch (Exception) {
            Console.WriteLine("caught");
        }
        using (new Res()) { }
        Console.WriteLine("done");
    }
}
