// A383 第一步：未知 option 键告警。告警走 Console.ErrorWriteLine（stderr，
// 不进 stdout 黄金）——本用例钉住的是"带未知键/怪形态的 option 解析不崩、
// 已知键语义不变"；告警本身由探针与 stderr 人工核对。
using System;
using Gui.Component.Chart;

class ChartOptionUnknownKeyTest {
    static void Main() {
        ChartOption o = ChartOption.FromJson(
            "{\"title\":{\"text\":\"t\",\"shou\":1},\"axsiX\":{},"
            + "\"series\":[{\"type\":\"bar\",\"wat\":2}],"
            + "\"data\":[{\"x\":1,\"y\":2}],\"nested\":{\"a\":[{\"b\":{\"c\":1}}]}}");
        if (o.series.Count != 1) { Console.WriteLine("FAIL series"); return; }
        if (o.title != "t") { Console.WriteLine("FAIL title"); return; }
        Console.WriteLine("ok");
    }
}
