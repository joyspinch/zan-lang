using System;

// await 出现在字符串插值片段里（async 方法）：
// 1. 只有一个 await 片段时，帧布局必须含 await 子槽（扫描要数到插值里的 await）；
// 2. await 之前的片段必须先落帧临时量，不能以 SSA 值跨挂起点存活；
// 3. 求值顺序保真：await 之前读到的值是挂起前的快照。
class InterpAwait {
    static int counter = 5;

    static async int Bump(int v) {
        await Task.Yield();
        counter = counter + 100;
        return v;
    }

    static async string Echo(string v) {
        await Task.Yield();
        return v;
    }

    static async void Main() {
        Console.WriteLine($"[{await Bump(10)}]");
        for (int i = 0; i < 3; i++) {
            Console.WriteLine($"[{i}|{await Bump(i * 10)}|{await Echo("z")}|{1.5}]");
        }
        Console.WriteLine($"{await Echo("a")}-{await Bump(2):D3}");
        counter = 5;
        Console.WriteLine($"before={counter} mid={await Bump(1)} after={counter}");
        string name = "n";
        Console.WriteLine($"{name.ToUpper()}:{await Echo(name)}:{-42L}");
    }
}
