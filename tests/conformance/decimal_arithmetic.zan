using System;

class Program {
    static void Main() {
        decimal a = 10.5m;
        decimal b = 2.5m;
        Console.WriteLine($"a+b={a + b}");
        Console.WriteLine($"a-b={a - b}");
        Console.WriteLine($"a*b={a * b}");
        Console.WriteLine($"a/b={a / b}");
        Console.WriteLine($"a%b={a % b}");

        decimal d1 = 0.1m;
        decimal d2 = 0.2m;
        decimal d3 = d1 + d2;
        Console.WriteLine($"0.1+0.2==0.3:{d3 == 0.3m}");

        decimal neg = -15.75m;
        Console.WriteLine($"abs={Decimal.Abs(neg)}");
        Console.WriteLine($"floor={Decimal.Floor(neg)}");
        Console.WriteLine($"ceil={Decimal.Ceiling(neg)}");
        Console.WriteLine($"trunc={Decimal.Truncate(neg)}");

        decimal parsed = Decimal.Parse("99999.8888");
        Console.WriteLine($"parsed={parsed}");
        Console.WriteLine($"i64={Decimal.ToInt64(parsed)}");
    }
}
