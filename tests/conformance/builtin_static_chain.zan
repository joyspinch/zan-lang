using System;
using System.IO;

namespace BuiltinStaticChain;

// 核心契约与语义定义。
// 核心契约与执行状态转移规范。
class Program {
    static void Main() {
        Directory.CreateDirectory("_scratch");
        File.WriteAllText("_scratch/chain_tmp.txt", "alpha\nbeta\ngamma\n");

        List<string> lines = File.ReadAllText("_scratch/chain_tmp.txt")
            .Replace("\r\n", "\n").Split("\n");
        Console.WriteLine(lines.Count);
        Console.WriteLine(lines[1]);

        Console.WriteLine(File.ReadAllText("_scratch/chain_tmp.txt").Substring(0, 5));
        Console.WriteLine(Path.GetFileName("a/b/c.zan").ToUpper());
        Console.WriteLine(Path.Combine("a", "b").Length);
        Console.WriteLine(Directory.ListNames("_scratch/chain_tmp.*").Split("\n")[0]);

        File.Delete("_scratch/chain_tmp.txt");
    }
}
