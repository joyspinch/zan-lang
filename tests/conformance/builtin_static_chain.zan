using System;

namespace BuiltinStaticChain;

// irgen lowers the built-in statics itself, so their result type has to come
// from the built-in table: without it a chained call on one of them (a Split
// or a ToUpper on File.ReadAllText) found an untyped receiver and lowered to
// a constant instead.
class Program {
    static void Main() {
        File.WriteAllText("chain_tmp.txt", "alpha\nbeta\ngamma\n");

        List<string> lines = File.ReadAllText("chain_tmp.txt")
            .Replace("\r\n", "\n").Split("\n");
        Console.WriteLine(lines.Count);
        Console.WriteLine(lines[1]);

        Console.WriteLine(File.ReadAllText("chain_tmp.txt").Substring(0, 5));
        Console.WriteLine(Path.GetFileName("a/b/c.zan").ToUpper());
        Console.WriteLine(Path.Combine("a", "b").Length);
        // bound to a local rather than indexed in place: indexing a
        // temporary collection leaks it (a pre-existing ARC gap).
        List<string> listed = Directory.ListNames("chain_tmp.*").Split("\n");
        Console.WriteLine(listed[0]);

        File.Delete("chain_tmp.txt");
    }
}
