using System;

/* A same-arity overload declared on a derived class does not hide the
 * inherited one: `Add(child)` inside Strip has to reach `Bag.Add(Bag)`,
 * not Strip's own `Add(string)` — which took a string and would call
 * itself forever. */
class Bag {
    List<Bag> kids;
    string tag;

    public Bag(string t) {
        this.tag = t;
        this.kids = new List<Bag>();
    }

    /* Fluent: the discarded `this` from the inherited overload has to be
     * released, which needs the call site's real return type. */
    public Bag Add(Bag b) {
        kids.Add(b);
        return this;
    }

    public int Count() { return kids.Count; }

    public string TagAt(int i) { return kids[i].tag; }
}

class Strip : Bag {
    public Strip() : base("strip") { }

    public int Add(string text) {
        Bag b = new Bag(text);
        Add(b);
        return this.Count() - 1;
    }
}

class Program {
    static void Main() {
        Strip s = new Strip();
        int i = s.Add("one");
        int j = s.Add("two");
        Console.WriteLine(Convert.ToString(i) + " " + Convert.ToString(j)
            + " " + Convert.ToString(s.Count()));
        Console.WriteLine(s.TagAt(0) + " " + s.TagAt(1));
    }
}
