using System;

/* 底层系统交互与数据协议契约 */
class Bag {
    List<Bag> kids;
    string tag;

    public Bag(string t) {
        this.tag = t;
        this.kids = new List<Bag>();
    }

    /* 底层系统交互与数据协议契约 */
    public Bag Add(Bag b) {
        kids.Add(b);
        return this;
    }

    public int Count() { return kids.Count; }

    public string TagAt(int i) { return kids[i].tag; }
}

class Strip : Bag {
    public Strip() : base("strip") { }

    public int Add(string text) {
        Bag b = new Bag(text);
        Add(b);
        return this.Count() - 1;
    }
}

class Program {
    static void Main() {
        Strip s = new Strip();
        int i = s.Add("one");
        int j = s.Add("two");
        Console.WriteLine(Convert.ToString(i) + " " + Convert.ToString(j)
            + " " + Convert.ToString(s.Count()));
        Console.WriteLine(s.TagAt(0) + " " + s.TagAt(1));
    }
}
