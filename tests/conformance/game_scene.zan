using System;
using Game.Scene;

namespace T;

class Program {
    static void L(string tag, SceneRect r) {
        Console.WriteLine(tag + " " + SceneDoc.IntStr(r.Xi()) + "," + SceneDoc.IntStr(r.Yi())
            + " " + SceneDoc.IntStr(r.Wi()) + "x" + SceneDoc.IntStr(r.Hi()));
    }

    static void Main() {
        SceneDoc d = new SceneDoc("hud", 1280, 720);
        d.SetBackground("bg/field.png");
        d.Add(new SceneElement("bar", "hpBar")
            .At(24, 24).Size(220, 20)
            .AnchorTo(Anchor.Min(), Anchor.Min())
            .Caption("HP"));
        d.Add(new SceneElement("sprite", "crosshair")
            .At(0, 0).Size(48, 48)
            .AnchorTo(Anchor.Mid(), Anchor.Mid()));
        d.Add(new SceneElement("button", "skill1")
            .At(-80, -80).Size(64, 64)
            .AnchorTo(Anchor.Max(), Anchor.Max()));

        d.Add(new SceneElement("bagslot", "bag")
            .At(10, 10).Size(44, 44)
            .AnchorTo(Anchor.Min(), Anchor.Max())
            .Grid(5, 8, 4, 4));

        // Round-trip through the .zscene JSON format.
        SceneDoc s = SceneDoc.Parse(d.ToJson());
        Console.WriteLine("count=" + SceneDoc.IntStr(s.Count()));
        Console.WriteLine("bg=" + s.Background());
        SceneElement bag = s.Find("bag");
        if (bag == null) { Console.WriteLine("null:bag"); return; }
        Console.WriteLine("bag=" + SceneDoc.IntStr(bag.Rows()) + "x" + SceneDoc.IntStr(bag.Cols())
            + " total " + SceneDoc.IntStr(bag.TotalW()) + "x" + SceneDoc.IntStr(bag.TotalH()));

        s.SetMode(ScaleMode.Fit());
        Program.L("fit-1920 cross", s.Resolve(s.Find("crosshair"), 1920, 1080));
        Program.L("fit-1920 hp", s.Resolve(s.Find("hpBar"), 1920, 1080));
        Program.L("fit-1920 skill", s.Resolve(s.Find("skill1"), 1920, 1080));
        Program.L("fit-800 hp", s.Resolve(s.Find("hpBar"), 800, 600));

        s.SetMode(ScaleMode.Stretch());
        Program.L("stretch-800 hp", s.Resolve(s.Find("hpBar"), 800, 600));

        s.SetMode(ScaleMode.None());
        Program.L("none-800 cross", s.Resolve(s.Find("crosshair"), 800, 600));

        // Unknown (unmodeled) keys survive a ToJson/Parse round trip:
        // hand-written or future-version scene documents must not lose
        // their declarations to one round trip (FormField.extra policy).
        string extraSrc = "{\"name\": \"hud\", \"designWidth\": 640, \"designHeight\": 480,"
            + " \"elements\": [\n  {\"kind\": \"sprite\", \"name\": \"s1\","
            + " \"x\": 10, \"y\": 20, \"w\": 30, \"h\": 40,"
            + " \"image\": \"img/s1.png\", \"futureKey\": \"keepMe\","
            + " \"custom\": {\"deep\": [1, 2]}}\n]}";
        SceneDoc de = SceneDoc.Parse(extraSrc);
        string extraRt = de.ToJson();
        Console.WriteLine("extra-kept=" + (extraRt.IndexOf("keepMe") >= 0));
        Console.WriteLine("extra-deep-kept=" + (extraRt.IndexOf("deep") >= 0));
        SceneDoc de2 = SceneDoc.Parse(extraRt);
        Console.WriteLine("extra-kept-2nd=" + (de2.ToJson().IndexOf("keepMe") >= 0));
        SceneElement es1 = de2.Find("s1");
        Console.WriteLine("extra-modeled=" + (es1 == null ? "MISSING" : es1.ImageId()));

        // Strict parse: a truncated document is refused (not silently
        // degraded into half a scene), with the reason in LastError().
        SceneDoc bad = new SceneDoc("", 1280, 720);
        bool badOk = SceneDoc.TryParse("{\"name\": \"x\", \"elements\": [ {\"kind\": \"b", bad);
        Console.WriteLine("truncated-rejected=" + (!badOk));
        Console.WriteLine("truncated-err=" + (SceneDoc.LastError().Length > 0));
        SceneDoc good = new SceneDoc("", 0, 0);
        bool goodOk = SceneDoc.TryParse(extraRt, good);
        Console.WriteLine("good-accepted=" + goodOk);
        Console.WriteLine("good-count=" + good.Count());
    }
}
