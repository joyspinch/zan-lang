// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
using System;

class Node {
    string tag;
    static Node Of(string t) { Node n = new Node(); n.tag = t; return n; }
    string Tag() { return this.tag; }
}

class Acc<T> {
    T cur;
    void Set(T v) { this.cur = v; }
    T Get() { return this.cur; }
}

class Pair<K, V> {
    K k;
    V v;
    void Put(K k, V v) { this.k = k; this.v = v; }
    K Key() { return this.k; }
    V Val() { return this.v; }
}

class Program {
    static void Main() {
        // 接口数据协议与执行契约。
        // 接口数据协议与执行契约。
        Acc<Node> a = new Acc<Node>();
        a.Set(Node.Of("n1"));
        Node viaField = a.cur;
        Console.WriteLine("field=" + viaField.tag);
        Node viaGet = a.Get();
        Console.WriteLine("get=" + viaGet.tag);
        Console.WriteLine("chain=" + a.Get().tag);
        Console.WriteLine("chainCall=" + a.Get().Tag());

        // 核心契约与语义定义。
        for (int i = 0; i < 5; i = i + 1) {
            a.Set(Node.Of("n" + Convert.ToString(i)));
        }
        Console.WriteLine("loop=" + a.Get().tag);

        // 接口数据协议与执行契约。
        Acc<string> s = new Acc<string>();
        s.Set("hi");
        Console.WriteLine("s=" + s.Get());

        Acc<List<string>> l = new Acc<List<string>>();
        for (int k = 0; k < 3; k = k + 1) {
            List<string> tmp = new List<string>();
            tmp.Add("x");
            tmp.Add("y");
            l.Set(tmp);
        }
        Console.WriteLine("rows=" + Convert.ToString(l.Get().Count));
        Console.WriteLine("first=" + l.Get()[0]);

        // 接口数据协议与执行契约。
        Acc<int> n = new Acc<int>();
        n.Set(41);
        Console.WriteLine("n=" + Convert.ToString(n.Get() + 1));

        // 核心契约与语义定义。
        Pair<Node, int> p = new Pair<Node, int>();
        p.Put(Node.Of("pk"), 9);
        Console.WriteLine("key=" + p.Key().tag);
        Console.WriteLine("val=" + Convert.ToString(p.Val()));

        // 核心契约与语义定义。
        Console.WriteLine("temp=" + Node.Of("t9").tag);
    }
}
