using System;
using System.Json;
using System.Toml;
using System.Yaml;
using System.Csv;

class Program {
    static void Main() {
        // 1. TOML Tests
        string tomlText = "title = \"Zan Configuration\"\n" +
                          "[owner]\n" +
                          "name = \"Zan Team\"\n" +
                          "enabled = true\n" +
                          "[database]\n" +
                          "port = 8080\n" +
                          "connections = 100\n";
        JsonValue tomlVal = Toml.Parse(tomlText);
        Console.WriteLine("toml_title=" + tomlVal.Str("title", ""));
        JsonValue owner = tomlVal.Get("owner");
        if (owner != null) {
            Console.WriteLine("toml_owner=" + owner.Str("name", ""));
            Console.WriteLine("toml_enabled=" + Convert.ToString(owner.Bool("enabled", false)));
        }
        string serializedToml = Toml.ToToml(tomlVal);
        JsonValue tomlVal2 = Toml.Parse(serializedToml);
        Console.WriteLine("toml_roundtrip=" + tomlVal2.Str("title", ""));

        // TOML Exception test
        bool caughtToml = false;
        try {
            Toml.Parse("bad = = invalid");
        } catch (TomlException e) {
            caughtToml = true;
        }
        Console.WriteLine("toml_error_caught=" + Convert.ToString(caughtToml));

        // 2. YAML Tests
        string yamlText = "service: auth\n" +
                          "version: 2.1\n" +
                          "active: true\n" +
                          "endpoints:\n" +
                          "  - /login\n" +
                          "  - /logout\n" +
                          "  - /verify\n";
        JsonValue yamlVal = Yaml.Parse(yamlText);
        Console.WriteLine("yaml_service=" + yamlVal.Str("service", ""));
        Console.WriteLine("yaml_active=" + Convert.ToString(yamlVal.Bool("active", false)));
        JsonValue eps = yamlVal.Get("endpoints");
        if (eps != null && eps.IsArray()) {
            Console.WriteLine("yaml_eps_count=" + Convert.ToString(eps.Count()));
            Console.WriteLine("yaml_ep0=" + eps.At(0).AsString(""));
        }
        string serializedYaml = Yaml.ToYaml(yamlVal);
        JsonValue yamlVal2 = Yaml.Parse(serializedYaml);
        Console.WriteLine("yaml_roundtrip=" + yamlVal2.Str("service", ""));

        // YAML Exception test
        bool caughtYaml = false;
        try {
            Yaml.Parse("key:\n\tvalue_with_tab");
        } catch (YamlException e) {
            caughtYaml = true;
        }
        Console.WriteLine("yaml_error_caught=" + Convert.ToString(caughtYaml));

        // 3. CSV Tests
        string csvText = "id,name,role,notes\n" +
                         "1,Alice,Engineer,\"Loves coding, Zan & C\"\n" +
                         "2,Bob,Architect,\"Line 1\nLine 2\"\n" +
                         "3,Charlie,Tester,\"He said \"\"Hello\"\"\"\n";
        CsvTable table = Csv.Parse(csvText);
        Console.WriteLine("csv_rows=" + Convert.ToString(table.RowCount()));
        List<string> headers = table.Header();
        Console.WriteLine("csv_headers=" + Convert.ToString(headers.Count));
        List<string> names = table.Column("name");
        if (names != null && names.Count >= 3) {
            Console.WriteLine("csv_name0=" + names[0]);
            Console.WriteLine("csv_name1=" + names[1]);
            Console.WriteLine("csv_name2=" + names[2]);
        }
        List<string> notes = table.Column("notes");
        if (notes != null && notes.Count >= 3) {
            Console.WriteLine("csv_quoted_comma=" + notes[0]);
            Console.WriteLine("csv_escaped_quote=" + notes[2]);
        }

        // Custom separator TSV
        string tsvText = "a\tb\tc\n1\t2\t3\n";
        CsvTable tsvTable = Csv.ParseSep(tsvText, "\t");
        Console.WriteLine("tsv_rows=" + Convert.ToString(tsvTable.RowCount()));
        Console.WriteLine("tsv_header0=" + tsvTable.Header()[0]);

        Console.WriteLine("config_tabular_hardening_ok");
    }
}
