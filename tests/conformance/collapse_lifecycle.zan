using System;
using Gui;
using Gui.Widget;

namespace Tests.CollapseLifecycle;

class CollapseModel {
    public int index = -1;
}

class Program {
    static void DrainPosts() {
        Action action = Dispatcher.Take();
        while (action != null) {
            action();
            action = Dispatcher.Take();
        }
    }

    static void Main() {
        Dispatcher.Init();
        SignalInt model = new SignalInt(0 - 1);
        Collapse collapse = new Collapse(model);
        CollapseItem first = collapse.AddPanel("General", "General settings");
        Label content = new Label("Advanced settings");
        CollapseItem second = collapse.AddPanel("Advanced", content);
        CollapseItem third = new CollapseItem("Extra");
        Label extra = new Label("Extra content");
        third.Add(extra);
        Control added = collapse.Add(third);
        collapse.AddItem(third);
        Console.WriteLine("add-panels=" + Convert.ToString(collapse.children.Count == 3
            && first.Content is Label && second.Content == content));
        Console.WriteLine("add-control=" + Convert.ToString(added == third
            && third.Content == extra && third.children.Count == 1));

        int changes = 0;
        collapse.Change.Add(() => { changes = changes + 1; });
        first.SetExpanded(true);
        Console.WriteLine("expand-first=" + Convert.ToString(first.IsExpanded
            && first.children.Count == 2 && model.Get() == 0 && changes == 1));
        second.SetExpanded(true);
        Console.WriteLine("accordion-once=" + Convert.ToString(!first.IsExpanded
            && second.IsExpanded && model.Get() == 1 && changes == 2));
        second.SetExpanded(false);
        Console.WriteLine("collapse-once=" + Convert.ToString(!second.IsExpanded
            && second.children.Count == 1 && model.Get() == -1 && changes == 3));

        Control header = first.children[0];
        header.TriggerEvent("Click");
        Program.DrainPosts();
        Console.WriteLine("header-click=" + Convert.ToString(first.IsExpanded
            && model.Get() == 0 && changes == 4));
        header = first.children[0];
        first.Disabled = true;
        header.TriggerEvent("Click");
        Program.DrainPosts();
        first.Disabled = false;
        Console.WriteLine("disabled-click=" + Convert.ToString(first.IsExpanded
            && model.Get() == 0 && changes == 4));

        CollapseModel state = new CollapseModel();
        collapse.Active = state.index;
        collapse.SetProp("active", "1");
        Console.WriteLine("setprop-active-silent=" + Convert.ToString(!first.IsExpanded
            && second.IsExpanded && !third.IsExpanded && model.Get() == 1
            && state.index == 1 && collapse.Active.Version() == 1 && changes == 4));
        collapse.SetProp("data", "2");
        Console.WriteLine("setprop-data-silent=" + Convert.ToString(!first.IsExpanded
            && !second.IsExpanded && third.IsExpanded && model.Get() == 2
            && state.index == 2 && collapse.Active.Version() == 2 && changes == 4));
        collapse.SetProp("value", "0");
        Console.WriteLine("setprop-value-silent=" + Convert.ToString(first.IsExpanded
            && !second.IsExpanded && !third.IsExpanded && model.Get() == 0
            && state.index == 0 && collapse.Active.Version() == 3 && changes == 4));
        state.index = 2;
        collapse.SyncBinding();
        Console.WriteLine("binding-switch-silent=" + Convert.ToString(!first.IsExpanded
            && !second.IsExpanded && third.IsExpanded && model.Get() == 2
            && state.index == 2 && collapse.Active.Version() == 3 && changes == 4));
        state.index = -1;
        collapse.SyncBinding();
        Console.WriteLine("binding-clear-silent=" + Convert.ToString(!first.IsExpanded
            && !second.IsExpanded && !third.IsExpanded && model.Get() == -1
            && state.index == -1 && collapse.Active.Version() == 3 && changes == 4));
        state.index = 0;
        collapse.SyncBinding();
        collapse.SyncBinding();
        Console.WriteLine("binding-repeat-silent=" + Convert.ToString(first.IsExpanded
            && !second.IsExpanded && !third.IsExpanded && model.Get() == 0
            && state.index == 0 && collapse.Active.Version() == 3 && changes == 4));

        WeakReference<Collapse> ownerLife = new WeakReference<Collapse>(collapse);
        WeakReference<CollapseItem> itemLife = new WeakReference<CollapseItem>(first);
        UiEvent toggle = first.Toggle;
        Binding<int> active = collapse.Active;
        // TriggerEvent 同步执行；显式排队，才能验证 owner 释放后的回调。
        header.On.Click.Post();
        collapse = null;
        Console.WriteLine("owner-released=" + Convert.ToString(!ownerLife.IsAlive));
        Program.DrainPosts();
        first.SetExpanded(true);
        Console.WriteLine("expired-owner-no-op=" + Convert.ToString(!ownerLife.IsAlive
            && model.Get() == 0 && state.index == 0 && active.Version() == 3
            && changes == 4));

        first = null;
        second = null;
        third = null;
        added = null;
        content = null;
        extra = null;
        Console.WriteLine("item-released=" + Convert.ToString(!itemLife.IsAlive));
        header.TriggerEvent("Click");
        Program.DrainPosts();
        toggle.RaiseS(null);
        Console.WriteLine("expired-item-no-op=" + Convert.ToString(!itemLife.IsAlive
            && !ownerLife.IsAlive && model.Get() == 0 && state.index == 0
            && active.Version() == 3 && changes == 4));
        header = null;
        toggle = null;
        Dispatcher.Clear();
    }
}
