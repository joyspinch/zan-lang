using System;

enum Status { Pending, Running, Success, Failed }

class Program {
    static int Classify(Status s) {
        // 全部分支完整覆盖，不应触发未穷尽警告
        switch (s) {
            case Status.Pending: return 1;
            case Status.Running: return 2;
            case Status.Success: return 3;
            case Status.Failed: return 4;
        }
        return 0;
    }

    static int ClassifyWithDefault(Status s) {
        // 带 default 标签，不应触发未穷尽警告
        switch (s) {
            case Status.Running: return 20;
            default: return 99;
        }
    }

    static int ClassifyPartial(Status s) {
        // 未覆盖全部枚举且无 default，触发编译期穷尽性预警
        switch (s) {
            case Status.Pending: return 100;
            case Status.Running: return 200;
        }
        return -1;
    }

    static void Main() {
        Console.WriteLine(Classify(Status.Success));
        Console.WriteLine(ClassifyWithDefault(Status.Pending));
        Console.WriteLine(ClassifyPartial(Status.Running));
    }
}
