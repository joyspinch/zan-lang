using System;
using System.Text;

// Encoding.ASCII 必须是真 7 位 ASCII（.NET ASCIEncoding 口径）：码点 >0x7F
// 编码为 '?'(0x3F)，解码字节 >0x7F 也替为 '?'；GetByteCount 一字符一字节。
// 曾是 UTF-8 别名（"名实不一"），现由 AsciiEncoding 实例方法承载真语义。
class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            failures = failures + 1;
            Console.WriteLine("FAIL " + name);
        }
    }

    static string Hex(byte[] b) {
        string s = "";
        for (int i = 0; i < b.Length; i++) {
            if (i > 0) { s = s + " "; }
            s = s + b[i].ToString();
        }
        return s;
    }

    static void Main() {
        // 非 ASCII 输入运行时构造（Zan 字面量无十六进制转义）。
        string latin = "a" + Encoding.Utf8FromCodePoint(233);   // a + é(U+00E9)
        string cjk = "a" + Encoding.Utf8FromCodePoint(0x4E2D);  // a + 中(U+4E2D)

        // 编码：'a' 保留，'é'(U+00E9) 与 '中'(U+4E2D) 替为 '?'
        byte[] b = Encoding.ASCII.GetBytes(latin);
        Check(Hex(b) == "97 63", "latin1 char -> ?");

        byte[] b2 = Encoding.ASCII.GetBytes(cjk);
        Check(Hex(b2) == "97 63", "cjk char -> ?");

        byte[] pure = Encoding.ASCII.GetBytes("Zan 42!");
        Check(pure.Length == 7 && pure[0] == 90 && pure[6] == 33, "pure ascii passthrough");

        // 解码：0xC8 (>127) 替为 '?'
        string s = Encoding.ASCII.GetString(new byte[] { 65, 200, 66 }, 0, 3);
        Check(s == "A?B", "high byte -> ? on decode");

        string s2 = Encoding.ASCII.GetString(new byte[] { 72, 105 }, 0, 2);
        Check(s2 == "Hi", "low bytes passthrough on decode");

        string s3 = Encoding.ASCII.GetString(new byte[] { 65, 0xFE, 66 });
        Check(s3 == "A?B", "1-arg GetString replaces");

        // 空窗口夹取
        Check(Encoding.ASCII.GetString(new byte[] { 65 }, 5, 3) == "", "offset clamp empty");
        Check(Encoding.ASCII.GetString(new byte[] { 65 }, 0, 9) == "A", "count clamp");

        // GetByteCount：一字符一字节
        Check(Encoding.ASCII.GetByteCount("abc") == 3, "bytecount ascii");
        Check(Encoding.ASCII.GetByteCount(latin) == 2, "bytecount one per char");

        // 裸类静态入口仍是 UTF-8（不在 ASCII 语义范围内）
        byte[] utf8 = Encoding.GetBytes(latin);
        Check(Hex(utf8) == "97 195 169", "bare-class static stays utf8");
        string rt = Encoding.GetString(Encoding.GetBytes(latin));
        Check(rt == latin, "bare-class utf8 roundtrip");

        // ASCII 往返：纯 ASCII 输入无损
        string rt2 = Encoding.ASCII.GetString(Encoding.ASCII.GetBytes("Zan ASCII"));
        Check(rt2 == "Zan ASCII", "ascii roundtrip lossless for 7-bit");

        Console.WriteLine("failures=" + failures);
    }
}
