// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与执行状态转移规范。
using System;

class Box {
    bool value;
    Box(bool v) { this.value = v; }
    bool Get() { return this.value; }
}

class Num {
    int value;
    Num(int v) { this.value = v; }
    int Get() { return this.value; }
}

class GBox<T> {
    T value;
    GBox(T v) { this.value = v; }
    T Get() { return this.value; }
}

class Program {
    static bool TakeBool(Box b) { return b.Get(); }
    static int TakeInt(Num n) { return n.Get(); }
    static bool TakeGBool(GBox<bool> b) { return b.Get(); }

    static void Main() {
        if (TakeBool(false)) { Console.WriteLine("bad:false-lit"); return; }
        if (!TakeBool(true)) { Console.WriteLine("bad:true-lit"); return; }
        bool x = false;
        if (TakeBool(x)) { Console.WriteLine("bad:bool-var"); return; }
        if (TakeInt(7) != 7) { Console.WriteLine("bad:int-lit"); return; }
        int n = 3;
        if (TakeInt(n) != 3) { Console.WriteLine("bad:int-var"); return; }
        if (TakeGBool(false)) { Console.WriteLine("bad:generic"); return; }
        Console.WriteLine("ok");
    }
}
