// A throw in the middle of an n-ary string concat leaves owned operands
// live: they ride the EH unwind stack and are released by the throw-site
// unwind (B-ID113). Before the registration the operand leaked, which the
// --check-leaks gate of this suite catches.
using System;

class Program {
    static string GetStr(int v) { return "s" + v; }
    static int Thrower() { throw new Exception("boom"); }

    static int Work() {
        int r = 0;
        try {
            string s = "a" + GetStr(1) + "b" + Thrower();
            r = s.Length;
        } catch (Exception e) {
            r = 7;
        }
        return r;
    }

    static void Main() {
        Console.WriteLine(Work());
        Console.WriteLine("a" + GetStr(2) + "b");   // normal path unregisters
    }
}
