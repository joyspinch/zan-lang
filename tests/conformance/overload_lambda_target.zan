using System;

// 重载决议：lambda 实参必须绑到「委托」那个重载。
//
// 目标重载住在另一个文件（partial class 跨文件合并），而**调用点所在的
// 这个文件自己声明了另一个同名重载**——这个位置以前最危险：lambda 的
// 类型推不出来，所有候选同分，决议退化成「取成员表里第一个同名方法」，
// 于是绑到了错的那个上。
//
// 真实后果：IDE 里 `LspSession.StartAsync(app != null ? (Action a) =>
// ... : null, root, completed)` 绑到了 `StartAsync(App app, ...)` 自己
// 身上，无限自我递归 → EH 展开栈耗尽 → exit(1)，一开工程 IDE 就崩。
//
// 覆盖两种实参形状：裸 lambda、三元表达式（lambda : null）。
partial class Split {
    // 干扰项：形参不是委托，接不住 lambda。
    static string F(FakeApp app) { return "APP"; }

    static void Main() {
        // app 只为让 lambda 捕获到一个局部（与 IDE 里的写法同形）。
        // 不分配对象：退出时若还留着活对象，泄漏检查会把它当成泄漏。
        FakeApp app = null;
        Console.WriteLine("bare=" + Split.F((Action act) => { app.Post(act); }));
        Console.WriteLine("cond=" + Split.F(app != null ? (Action act) => { app.Post(act); } : null));
        Console.WriteLine("OK");
    }
}

class FakeApp {
    void Post(Action act) { }
}
