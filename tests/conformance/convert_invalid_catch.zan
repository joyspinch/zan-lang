using System;

class ConvertInvalidCatch {
    static void Main() {
        bool caughtFormat = false;
        try {
            int x = Convert.ToInt32("not_a_number");
        } catch (FormatException) {
            caughtFormat = true;
        } catch (Exception) {
            caughtFormat = false;
        }

        bool caughtOverflow = false;
        try {
            int y = Convert.ToInt32(99999999999L);
        } catch (OverflowException) {
            caughtOverflow = true;
        } catch (Exception) {
            caughtOverflow = false;
        }

        bool caughtDoubleFormat = false;
        try {
            double d = Convert.ToDouble("bad_double");
        } catch (FormatException) {
            caughtDoubleFormat = true;
        }

        bool caughtParseFormat = false;
        try {
            int p = int.Parse("bad_parse");
        } catch (FormatException) {
            caughtParseFormat = true;
        }

        Console.WriteLine(caughtFormat ? "format-caught: 1" : "format-caught: 0");
        Console.WriteLine(caughtOverflow ? "overflow-caught: 1" : "overflow-caught: 0");
        Console.WriteLine(caughtDoubleFormat ? "double-format-caught: 1" : "double-format-caught: 0");
        Console.WriteLine(caughtParseFormat ? "parse-format-caught: 1" : "parse-format-caught: 0");
    }
}
