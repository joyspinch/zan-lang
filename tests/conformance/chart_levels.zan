// N3 treemap/sunburst 分级样式契约（官方 echarts-master 源对抄）：
// levels 解析（color 数组/colorSaturation/colorMappingBy/itemStyle
// borderWidth-gapWidth-borderColor-borderColorSaturation/upperLabel/
// label.rotate/r0-r px 与百分比）、系级 visualDimension/visualMin/
// visualMax/visibleMin/leafDepth、sunburst 系级 label/itemStyle、
// 节点 id/多维 value/单色、克隆保真、squarify 与颜色接缝
// （TmLevel/TmSquareRatio/TmWorst/RgbSat/PaletteLerp）。
using System;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static string Rgb(int c) {
        return Convert.ToString((c >> 16) & 255)
            + "," + Convert.ToString((c >> 8) & 255)
            + "," + Convert.ToString(c & 255);
    }

    static void Main() {
        // ① 百分比半径："15%"=150‰、"12.5%"=125‰，非法/无 % = −1。
        Console.WriteLine("PP " + Convert.ToString(ChartOption.PercentPerMille("15%"))
            + ":" + Convert.ToString(ChartOption.PercentPerMille("12.5%"))
            + ":" + Convert.ToString(ChartOption.PercentPerMille("0%"))
            + ":" + Convert.ToString(ChartOption.PercentPerMille("150%"))
            + ":" + Convert.ToString(ChartOption.PercentPerMille("+5%"))
            + ":" + Convert.ToString(ChartOption.PercentPerMille("-5%"))
            + ":" + Convert.ToString(ChartOption.PercentPerMille("%"))
            + ":" + Convert.ToString(ChartOption.PercentPerMille("1.2.3%"))
            + ":" + Convert.ToString(ChartOption.PercentPerMille("15"))
            + ":" + Convert.ToString(ChartOption.PercentPerMille("abc"))
            + ":" + Convert.ToString(ChartOption.PercentPerMille("")));

        // ② sunburst-drink 形：百分比环带 + 级 label 切向 + 级 bw。
        ChartOption d = ChartOption.FromJson("{\"series\":[{\"type\":\"sunburst\"," +
            "\"label\":{\"rotate\":\"radial\",\"color\":\"#2E2733\"}," +
            "\"itemStyle\":{\"borderColor\":\"#2E2733\",\"borderWidth\":2}," +
            "\"levels\":[{}," +
            "{\"r0\":\"15%\",\"r\":\"35%\",\"itemStyle\":{\"borderWidth\":2}," +
            "\"label\":{\"rotate\":\"tangential\"}}," +
            "{\"r0\":\"35%\",\"r\":\"70%\"}," +
            "{\"r0\":70,\"r\":72,\"itemStyle\":{\"borderWidth\":3}," +
            "\"label\":{\"rotate\":0}}]}]}");
        ChartSeries ds = d.series[0];
        Console.WriteLine("SB mode=" + Convert.ToString(ds.sunLabelMode)
            + " lcol=" + Rgb(ds.sunLabelColor)
            + " bw=" + Convert.ToString(ds.tmBorderWidth)
            + " bor=" + Rgb(ds.tmBorderColor));
        Console.WriteLine("SB1 r0=" + Convert.ToString(ds.levels[1].r0)
            + "/" + Convert.ToString(ds.levels[1].r0Pct)
            + " r=" + Convert.ToString(ds.levels[1].r)
            + "/" + Convert.ToString(ds.levels[1].rPct)
            + " mode=" + Convert.ToString(ds.levels[1].labelMode)
            + " bw=" + Convert.ToString(ds.levels[1].borderWidth));
        Console.WriteLine("SB2 r0pct=" + Convert.ToString(ds.levels[2].r0Pct)
            + " rpct=" + Convert.ToString(ds.levels[2].rPct));
        Console.WriteLine("SB3 r0=" + Convert.ToString(ds.levels[3].r0)
            + " r=" + Convert.ToString(ds.levels[3].r)
            + " mode=" + Convert.ToString(ds.levels[3].labelMode)
            + " rot=" + Convert.ToString(ds.levels[3].labelRotate)
            + " bw=" + Convert.ToString(ds.levels[3].borderWidth));

        // ③ treemap-visual 形：视觉维/域拓宽 + 级色数组 + value 映射。
        ChartOption v = ChartOption.FromJson("{\"series\":[{\"type\":\"treemap\"," +
            "\"visualDimension\":3,\"visualMin\":-100,\"visualMax\":100," +
            "\"itemStyle\":{\"borderColor\":\"black\"}," +
            "\"upperLabel\":{\"show\":true,\"height\":30}," +
            "\"levels\":[" +
            "{\"itemStyle\":{\"borderWidth\":3,\"borderColor\":\"#333\",\"gapWidth\":3}," +
            "\"upperLabel\":{\"show\":false}}," +
            "{\"color\":[\"#942e38\",\"#aaa\",\"#269f3c\"]," +
            "\"colorMappingBy\":\"value\",\"itemStyle\":{\"gapWidth\":1}}]}]}");
        ChartSeries vs = v.series[0];
        ChartLevel v0 = vs.levels[0];
        ChartLevel v1 = vs.levels[1];
        Console.WriteLine("TV dim=" + Convert.ToString(vs.visualDimension)
            + " vmin=" + Convert.ToString(vs.visualMin)
            + " vmax=" + Convert.ToString(vs.visualMax)
            + " sBorder=" + Rgb(vs.tmBorderColor)
            + " up=" + Convert.ToString(vs.tmUpperShow)
            + "/" + Convert.ToString(vs.tmUpperHeight));
        Console.WriteLine("TV0 bw=" + Convert.ToString(v0.borderWidth)
            + " bor=" + Rgb(v0.borderColor)
            + " gw=" + Convert.ToString(v0.gapWidth)
            + " upShow=" + Convert.ToString(v0.upperShow));
        Console.WriteLine("TV1 n=" + Convert.ToString(v1.color.Count)
            + " c0=" + Rgb(v1.color[0])
            + " c1=" + Rgb(v1.color[1])
            + " c2=" + Rgb(v1.color[2])
            + " cmb=" + Convert.ToString(v1.colorMappingBy)
            + " gw=" + Convert.ToString(v1.gapWidth));

        // ④ treemap-obama 形：id 映射 + 节点 id/多维 value/单色。
        ChartOption ob = ChartOption.FromJson("{\"series\":[{\"type\":\"treemap\"," +
            "\"levels\":[" +
            "{\"color\":[\"#c23531\",\"#314656\"],\"colorMappingBy\":\"id\"," +
            "\"itemStyle\":{\"borderWidth\":3,\"gapWidth\":3}}," +
            "{\"itemStyle\":{\"gapWidth\":1}}]," +
            "\"data\":[" +
            "{\"name\":\"A\",\"id\":\"b1\",\"value\":[100,null,null,0]," +
            "\"itemStyle\":{\"color\":\"#123456\"},\"children\":[" +
            "{\"name\":\"A1\",\"id\":\"l1\",\"value\":[60,0,0,3.5]}," +
            "{\"name\":\"A2\",\"id\":\"l2\",\"value\":[40,0,0,1.5]}]}," +
            "{\"name\":\"B\",\"id\":\"b2\",\"value\":[50,0,0,0]}]}]}");
        ChartSeries os = ob.series[0];
        ChartLevel o0 = os.levels[0];
        ChartNode ob1 = os.tree[0];
        ChartNode ob1a = ob1.children[0];
        Console.WriteLine("OB cmb=" + Convert.ToString(o0.colorMappingBy)
            + " n=" + Convert.ToString(o0.color.Count)
            + " bw=" + Convert.ToString(o0.borderWidth)
            + " gw=" + Convert.ToString(o0.gapWidth)
            + " lv1gw=" + Convert.ToString(os.levels[1].gapWidth));
        Console.WriteLine("OBn id=[" + ob1.id + "] val="
            + Convert.ToString(ob1.val)
            + " v3=" + Convert.ToString(ob1.ValueOf(3))
            + " kid=" + Convert.ToString(ChartView.TreemapValue(ob1))
            + " ncol=" + Rgb(ob1.color)
            + " leafVof3=" + Convert.ToString(ob1a.ValueOf(3))
            + " leafId=[" + ob1a.id + "]");

        // ⑤ treemap-drill-down 形：leafDepth/visibleMin/colorSaturation 域
        // + borderColorSaturation。
        ChartOption dl = ChartOption.FromJson("{\"series\":[{\"type\":\"treemap\"," +
            "\"visibleMin\":300,\"leafDepth\":2," +
            "\"levels\":[" +
            "{\"itemStyle\":{\"borderColor\":\"#555\",\"borderWidth\":4,\"gapWidth\":4}}," +
            "{\"colorSaturation\":[0.3,0.6]," +
            "\"itemStyle\":{\"borderColorSaturation\":0.7,\"gapWidth\":2,\"borderWidth\":2}}" +
            "]}]}");
        ChartSeries dls = dl.series[0];
        ChartLevel dl1 = dls.levels[1];
        Console.WriteLine("DL vmin=" + Convert.ToString(dls.visibleMin)
            + " leafDepth=" + Convert.ToString(dls.leafDepth)
            + " sat=" + Convert.ToString(dl1.hasColorSat)
            + "/" + Convert.ToString(dl1.satLo)
            + "-" + Convert.ToString(dl1.satHi)
            + " bcs=" + Convert.ToString(dl1.borderColorSat)
            + " gw=" + Convert.ToString(dl1.gapWidth));

        // ⑥ sunburst-monochrome 形：系级纯色覆盖 + 空级数组。
        ChartOption mo = ChartOption.FromJson("{\"series\":[{\"type\":\"sunburst\"," +
            "\"itemStyle\":{\"color\":\"#ddd\",\"borderWidth\":2}," +
            "\"label\":{\"rotate\":\"radial\"},\"levels\":[]}]}");
        ChartSeries mos = mo.series[0];
        Console.WriteLine("MO item=" + Rgb(mos.sunItemColor)
            + " mode=" + Convert.ToString(mos.sunLabelMode)
            + " levels=" + Convert.ToString(mos.levels.Count));

        // ⑦ 克隆保真（levels / 标量 / 节点 id）。
        ChartOption vc = ChartOption.Clone(v);
        if (vc != null) {
            ChartLevel cv1 = vc.series[0].levels[1];
            Console.WriteLine("CL levels=" + Convert.ToString(vc.series[0].levels.Count)
                + " dim=" + Convert.ToString(vc.series[0].visualDimension)
                + " n=" + Convert.ToString(cv1.color.Count)
                + " cmb=" + Convert.ToString(cv1.colorMappingBy));
        }

        // ⑧ 缺省（Create 通道）：无 levels、官方缺省域。
        ChartOption e = ChartOption.Create();
        ChartSeries es = ChartSeries.Of("t", ChartType.Treemap, new List<int>());
        Console.WriteLine("E lv=" + Convert.ToString(es.levels.Count)
            + " bw=" + Convert.ToString(es.tmBorderWidth)
            + " leafDepth=" + Convert.ToString(es.leafDepth)
            + " visibleMin=" + Convert.ToString(es.visibleMin)
            + " bcs=" + Convert.ToString(es.tmBorderColorSat)
            + " sunMode=" + Convert.ToString(es.sunLabelMode));

        // ⑨ squarify / 颜色接缝。
        Console.WriteLine("TM ratio=" + Convert.ToString((int)(ChartView.TmSquareRatio() * 1000 + 0.5))
            + " worst=" + Convert.ToString((int)(ChartView.TmWorst(4.0, 2.0, 2.0, 2.0,
                ChartView.TmSquareRatio()) * 1000 + 0.5))
            + " worst2=" + Convert.ToString((int)(ChartView.TmWorst(1.0, 1.0, 1.0, 2.0,
                ChartView.TmSquareRatio()) * 1000 + 0.5)));
        Console.WriteLine("TMlevel clamp=" + (ChartView.TmLevel(vs, 99) == vs.levels[vs.levels.Count - 1])
            + " neg=" + (ChartView.TmLevel(vs, 0 - 1) == vs.levels[0]));
        Console.WriteLine("SAT red,0=" + Rgb(ChartView.RgbSat(0 - 65536, 0))
            + " red,1000=" + Rgb(ChartView.RgbSat(0 - 65536, 1000))
            + " red,500=" + Rgb(ChartView.RgbSat(0 - 65536, 500))
            + " gray,900=" + Rgb(ChartView.RgbSat(0 - 8355712, 900)));
        List<int> stops = new List<int>();
        stops.Add(0 - 65536);
        stops.Add(0 - 16776961);
        Console.WriteLine("PL2 t0=" + Rgb(ChartView.PaletteLerp(stops, 0))
            + " t500=" + Rgb(ChartView.PaletteLerp(stops, 500))
            + " t250=" + Rgb(ChartView.PaletteLerp(stops, 250))
            + " t1000=" + Rgb(ChartView.PaletteLerp(stops, 1000)));
        List<int> stops3 = new List<int>();
        stops3.Add(0 - 65536);
        stops3.Add(0 - 16711936);
        stops3.Add(0 - 16776961);
        Console.WriteLine("PL3 t500=" + Rgb(ChartView.PaletteLerp(stops3, 500))
            + " t750=" + Rgb(ChartView.PaletteLerp(stops3, 750))
            + " over=" + Rgb(ChartView.PaletteLerp(stops3, 2000)));
    }
}
