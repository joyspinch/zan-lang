// Region versioning of soft null checks (guard_version.cpp) used to fold a
// phi in the region's entry block when it cut the guard's ok edge.  The fold
// RAUWs the phi into its scratch input and the clone map follows RAUW, so the
// clone's loop exits got the failing path's scratch value (a non-dominating
// incoming, later poison) -- here the release of `bar` after the early
// `continue`, which then freed garbage.  Shape that hits it: a pinned
// receiver (`bar` is declared twice in the function), a method returning
// `this` on the `continue` path, and a loop too big to version whole.
// Output must match -O0.
using System;
using System.Collections.Generic;
class Item { public int hp; }
class Bar {
    public bool visible;
    public int pct;
    public string style;
    public Bar SetShown(bool v) { visible = v; return this; }
}
class Hud {
    public List<Bar> bars = new List<Bar>();
    public List<Item> items = new List<Item>();
    public int Sync() {
        while (this.bars.Count < this.items.Count) { Bar bar = new Bar(); this.bars.Add(bar); }
        int sum = 0;
        for (int i = 0; i < this.bars.Count; i = i + 1) {
            Bar bar = this.bars[i];
            if (i >= this.items.Count) { bar.SetShown(false); continue; }
            Item item = this.items[i];
            bar.SetShown(item.hp > 0);
            if (!bar.visible) { continue; }
            bar.pct = item.hp * 10;
            sum = sum + bar.pct;
            bar.style = "a:" + Convert.ToString(item.hp) + ";b:" + Convert.ToString(i) + ";c:" + Convert.ToString(sum);
            bar.style = bar.style + "d:" + Convert.ToString(item.hp * 3) + ";e:" + Convert.ToString(i * 7) + ";f:" + Convert.ToString(sum + 1);
            bar.style = bar.style + "g:" + Convert.ToString(item.hp * 5) + ";h:" + Convert.ToString(i * 9) + ";k:" + Convert.ToString(sum + 2);
        }
        return sum;
    }
}
class Program {
    static void Main() {
        Hud h = new Hud();
        for (int i = 0; i < 6; i = i + 1) { Item it = new Item(); it.hp = i; h.items.Add(it); }
        Console.WriteLine(h.Sync());
        h.items = new List<Item>();
        for (int i = 0; i < 2; i = i + 1) { Item it = new Item(); it.hp = 3; h.items.Add(it); }
        Console.WriteLine(h.Sync());
        Console.WriteLine(h.Sync());
        int shown = 0;
        for (int i = 0; i < h.bars.Count; i = i + 1) { if (h.bars[i].visible) { shown = shown + 1; } }
        Console.WriteLine("bars " + Convert.ToString(h.bars.Count) + " shown " + Convert.ToString(shown));
        Console.WriteLine(h.bars[1].style);
    }
}
