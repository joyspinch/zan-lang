using System;
using System.Json;

class Person {
    [JsonProperty("user_id")]
    int id;

    [JsonProperty("full_name")]
    string name;

    [JsonIgnore]
    string secret;

    int age;
}

class Program {
    static void Main() {
        string doc = "{\"user_id\":101,\"full_name\":\"Alice\",\"secret\":\"super_secret\",\"age\":28}";
        Person p = Json.Deserialize<Person>(doc);

        Console.WriteLine("id=" + Convert.ToString(p.id));
        Console.WriteLine("name=" + p.name);
        Console.WriteLine("secret_is_null=" + Convert.ToString(p.secret == null));
        Console.WriteLine("age=" + Convert.ToString(p.age));

        p.secret = "modified_secret";
        string json = Json.Serialize<Person>(p);
        Console.WriteLine("json=" + json);
        Console.WriteLine("has_secret=" + Convert.ToString(json.Contains("modified_secret")));
        Console.WriteLine("has_user_id=" + Convert.ToString(json.Contains("\"user_id\":101")));
        Console.WriteLine("has_full_name=" + Convert.ToString(json.Contains("\"full_name\":\"Alice\"")));

        Person p2 = Json.Deserialize<Person>(json);
        Console.WriteLine("p2_id=" + Convert.ToString(p2.id));
        Console.WriteLine("p2_name=" + p2.name);
        Console.WriteLine("p2_secret_is_null=" + Convert.ToString(p2.secret == null));
        Console.WriteLine("p2_age=" + Convert.ToString(p2.age));
    }
}
