using System;

// Environment.ProcessorCount：走 runtime 探针（Windows GetSystemInfo /
// POSIX sysconf），不再读 NUMBER_OF_PROCESSORS 环境变量——污染该
// 变量不影响结果，非 Windows 也不再恒 1。断言全部平台无关。
class Program {
    static void Main() {
        int n0 = Environment.ProcessorCount;
        Console.WriteLine("positive: " + Convert.ToString(n0 > 0 ? 1 : 0));
        Console.WriteLine("bounded: " + Convert.ToString(n0 <= 1024 ? 1 : 0));
        Console.WriteLine("stable: " + Convert.ToString(Environment.ProcessorCount == n0 ? 1 : 0));

        // 环境变量污染免疫（旧实现会把 9999 当真）
        Environment.SetEnvironmentVariable("NUMBER_OF_PROCESSORS", "9999");
        Console.WriteLine("pollution-proof: " + Convert.ToString(Environment.ProcessorCount == n0 ? 1 : 0));
        Environment.SetEnvironmentVariable("NUMBER_OF_PROCESSORS", "");
    }
}
