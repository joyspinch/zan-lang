using System;
using System.Collections.Generic;

class Animal {
    public string Name;
    public Animal(string name) {
        this.Name = name;
    }
}

class Dog : Animal {
    public Dog(string name) : base(name) {}
}

interface IProducer<out T> {
    T Get();
}

class DogProducer : IProducer<Dog> {
    public Dog Get() {
        return new Dog("producer_dog");
    }
}

interface IConsumer<in T> {
    void Accept(T val);
}

class AnimalConsumer : IConsumer<Animal> {
    public void Accept(Animal val) {
        Console.WriteLine("consumer_animal: " + val.Name);
    }
}

class DogEnumerator : IEnumerator<Dog> {
    int index = -1;
    Dog[] items;

    public DogEnumerator() {
        items = new Dog[2];
        items[0] = new Dog("spot");
        items[1] = new Dog("rover");
    }

    public bool MoveNext() {
        index = index + 1;
        return index < 2;
    }

    public Dog Current() {
        return items[index];
    }

    public void Reset() {
        index = -1;
    }
}

class DogSequence : IEnumerable<Dog> {
    public IEnumerator<Dog> GetEnumerator() {
        return new DogEnumerator();
    }
}

public class Program {
    public static void Main() {
        // 1. Interface covariance (IProducer<out T>)
        IProducer<Animal> prod = new DogProducer();
        Animal a1 = prod.Get();
        Console.WriteLine(a1.Name);

        // 2. Interface contravariance (IConsumer<in T>)
        IConsumer<Dog> cons = new AnimalConsumer();
        cons.Accept(new Dog("rex"));

        // 3. Delegate contravariance (Action<in T>)
        Action<Animal> actAnimal = (Animal a) => {
            Console.WriteLine("action: " + a.Name);
        };
        Action<Dog> actDog = actAnimal;
        actDog(new Dog("fido"));

        // 4. Delegate covariance & contravariance (Func<in T, out TResult>)
        Func<Animal, Dog> fn = (Animal a) => {
            return new Dog(a.Name + "_transformed");
        };
        Func<Dog, Animal> fnVariant = fn;
        Animal a3 = fnVariant(new Dog("puppy"));
        Console.WriteLine("func: " + a3.Name);

        // 5. Stdlib interface covariance (IEnumerable<out T>, IEnumerator<out T>)
        IEnumerable<Animal> animals = new DogSequence();
        IEnumerator<Animal> enumerator = animals.GetEnumerator();
        while (enumerator.MoveNext()) {
            Animal a = enumerator.Current();
            Console.WriteLine("enumerable: " + a.Name);
        }
    }
}
