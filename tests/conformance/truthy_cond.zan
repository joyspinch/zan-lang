// 条件真值化：Zan 允许非 bool 值作条件（checker 给 warning），
// irgen 必须对任意操作数类型生成合法的 "!= 零值" 比较。此前
// 指针/浮点操作数在三元、if/while/do-while/for、&&/|| 里都会
// 铸出非法的 i0 常量，LLVM verification 直接失败。
using System;
namespace Conf;
class Box {
    int v;
    Box(int n) { v = n; }
    static Box MakeNull() { return null; }
}
class Program {
    static void Main() {
        Box b = new Box(1);
        // 对象引用作三元条件：非 null 为真。
        Console.WriteLine(b != null ? "yes" : "no");
        string s = b ? "truthy" : "falsy";
        Console.WriteLine(s);
        // 对象引用作 if 条件。
        if (b) { Console.WriteLine("if-obj"); }
        // 整数真值化：0 假非 0 真。
        int n = 3;
        if (n) { Console.WriteLine("if-int"); }
        if (0) { Console.WriteLine("unreachable"); }
        // 浮点真值化。
        double d = 0.5;
        if (d) { Console.WriteLine("if-float"); }
        if (0.0) { Console.WriteLine("unreachable"); }
        // while/do-while/for 的真值化条件（对象引用置 null 后退出）。
        int spins = 0;
        while (b) {
            spins = spins + 1;
            b = null;
        }
        Console.WriteLine(spins);
        do { Console.WriteLine("do-once"); } while (0);
        int fors = 0;
        for (Box f = new Box(2); f; f = null) { fors = fors + 1; }
        Console.WriteLine(fors);
        // &&/|| 的操作数必须是 bool（checker 强制），真值化只属于条件位置。
        if (b == null && d < 0.0) { Console.WriteLine("unreachable"); }
        Console.WriteLine((b != null || d > 0.0) ? "or-truthy" : "or-falsy");
    }
}
