using System;
using System.Buffers.Binary;
using System.IO;

public class BinaryPrimitivesTest {
    static void Main() {
        int bad = 0;

        // 1. ReverseEndianness
        if (BinaryPrimitives.ReverseEndianness((short)0x1234) != (short)0x3412) {
            bad = bad + 1; Console.WriteLine("fail: ReverseEndianness(short)");
        }
        if (BinaryPrimitives.ReverseEndianness((ushort)0x1234) != (ushort)0x3412) {
            bad = bad + 1; Console.WriteLine("fail: ReverseEndianness(ushort)");
        }
        if (BinaryPrimitives.ReverseEndianness(0x12345678) != 0x78563412) {
            bad = bad + 1; Console.WriteLine("fail: ReverseEndianness(int)");
        }
        if (BinaryPrimitives.ReverseEndianness((uint)0x12345678) != (uint)0x78563412) {
            bad = bad + 1; Console.WriteLine("fail: ReverseEndianness(uint)");
        }
        if (BinaryPrimitives.ReverseEndianness(0x0102030405060708) != 0x0807060504030201) {
            bad = bad + 1; Console.WriteLine("fail: ReverseEndianness(long)");
        }

        // 2. BinaryPrimitives Read/Write LittleEndian & BigEndian
        byte[] buf = new byte[32];
        Span<byte> span = buf.AsSpan();

        // 16-bit
        BinaryPrimitives.WriteInt16LittleEndian(span, (short)0x1234);
        if (BinaryPrimitives.ReadInt16LittleEndian(span) != (short)0x1234) {
            bad = bad + 1; Console.WriteLine("fail: ReadInt16LittleEndian");
        }
        if (buf[0] != 0x34 || buf[1] != 0x12) {
            bad = bad + 1; Console.WriteLine("fail: WriteInt16LittleEndian bytes");
        }
        BinaryPrimitives.WriteInt16BigEndian(span, (short)0x1234);
        if (BinaryPrimitives.ReadInt16BigEndian(span) != (short)0x1234) {
            bad = bad + 1; Console.WriteLine("fail: ReadInt16BigEndian");
        }
        if (buf[0] != 0x12 || buf[1] != 0x34) {
            bad = bad + 1; Console.WriteLine("fail: WriteInt16BigEndian bytes");
        }

        // 32-bit
        BinaryPrimitives.WriteInt32LittleEndian(span, 0x12345678);
        if (BinaryPrimitives.ReadInt32LittleEndian(span) != 0x12345678) {
            bad = bad + 1; Console.WriteLine("fail: ReadInt32LittleEndian");
        }
        if (buf[0] != 0x78 || buf[3] != 0x12) {
            bad = bad + 1; Console.WriteLine("fail: WriteInt32LittleEndian bytes");
        }
        BinaryPrimitives.WriteInt32BigEndian(span, 0x12345678);
        if (BinaryPrimitives.ReadInt32BigEndian(span) != 0x12345678) {
            bad = bad + 1; Console.WriteLine("fail: ReadInt32BigEndian");
        }
        if (buf[0] != 0x12 || buf[3] != 0x78) {
            bad = bad + 1; Console.WriteLine("fail: WriteInt32BigEndian bytes");
        }

        // 64-bit
        BinaryPrimitives.WriteInt64LittleEndian(span, 0x0102030405060708);
        if (BinaryPrimitives.ReadInt64LittleEndian(span) != 0x0102030405060708) {
            bad = bad + 1; Console.WriteLine("fail: ReadInt64LittleEndian");
        }
        if (buf[0] != 0x08 || buf[7] != 0x01) {
            bad = bad + 1; Console.WriteLine("fail: WriteInt64LittleEndian bytes");
        }

        // Float (Single) & Double
        float fval = 3.14159f;
        BinaryPrimitives.WriteSingleLittleEndian(span, fval);
        float fback = BinaryPrimitives.ReadSingleLittleEndian(span);
        if (fback != fval) {
            bad = bad + 1; Console.WriteLine("fail: ReadSingleLittleEndian");
        }

        double dval = 2.718281828459045;
        BinaryPrimitives.WriteDoubleLittleEndian(span, dval);
        double dback = BinaryPrimitives.ReadDoubleLittleEndian(span);
        if (dback != dval) {
            bad = bad + 1; Console.WriteLine("fail: ReadDoubleLittleEndian");
        }

        // 3. BitConverter
        byte[] intBytes = BitConverter.GetBytes(100000);
        if (BitConverter.ToInt32(intBytes, 0) != 100000) {
            bad = bad + 1; Console.WriteLine("fail: BitConverter.ToInt32");
        }

        byte[] floatBytes = BitConverter.GetBytes(123.456f);
        if (BitConverter.ToSingle(floatBytes, 0) != 123.456f) {
            bad = bad + 1; Console.WriteLine("fail: BitConverter.ToSingle");
        }

        byte[] doubleBytes = BitConverter.GetBytes(987654.321);
        if (BitConverter.ToDouble(doubleBytes, 0) != 987654.321) {
            bad = bad + 1; Console.WriteLine("fail: BitConverter.ToDouble");
        }

        string hexStr = BitConverter.ToString(new byte[] { 0xDE, 0xAD, 0xBE, 0xEF });
        if (hexStr != "DE-AD-BE-EF") {
            bad = bad + 1; Console.WriteLine("fail: BitConverter.ToString got: " + hexStr);
        }

        // 4. ByteBuffer roundtrip
        ByteBuffer bb = ByteBuffer.Alloc(64);
        bb.WriteF32(42.5f);
        bb.WriteF64(1234567.89);
        bb.SeekRead(0);
        float bbF = bb.ReadF32();
        double bbD = bb.ReadF64();
        if (bbF != 42.5f) {
            bad = bad + 1; Console.WriteLine("fail: ByteBuffer.ReadF32");
        }
        if (bbD != 1234567.89) {
            bad = bad + 1; Console.WriteLine("fail: ByteBuffer.ReadF64");
        }
        bb.Free();

        Console.WriteLine("bad=" + Convert.ToString(bad));
        Console.WriteLine(bad == 0 ? "binary-primitives-ok: 1" : "binary-primitives-ok: 0");
    }
}
