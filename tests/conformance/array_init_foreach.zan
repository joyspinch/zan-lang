using System;

/* Array initializers (`new T[] { ... }`) and foreach over arrays and strings.
 * Both used to fault: the initializer produced a pointer to nothing, and
 * foreach read any collection as if it were a List. */
class Bag {
    int[] items;

    Bag() { items = new int[] { 2, 4, 6, 8 }; }

    int Total() {
        int t = 0;
        foreach (int v in items) { t = t + v; }
        return t + items.Length;
    }
}

class Program {
    /* an array passed as a parameter knows its own length: it used to be
     * tracked only at the declaration site */
    static int Count(string[] values) {
        int n = 0;
        foreach (string v in values) { n = n + 1; }
        return n + values.Length;
    }

    static void Main() {
        int[] nums = new int[] { 3, 5, 8 };
        Console.WriteLine(nums.Length);
        Console.WriteLine(nums[2]);
        int total = 0;
        foreach (int n in nums) { total = total + n; }
        Console.WriteLine(total);

        string[] names = new string[] { "ana", "bo" };
        foreach (string s in names) { Console.WriteLine(s); }

        byte[] bytes = new byte[] { 1, 200, 255 };
        int bsum = 0;
        foreach (byte v in bytes) { bsum = bsum + (int)v; }
        Console.WriteLine(bsum);

        int chars = 0;
        foreach (char c in "hello") { chars = chars + 1; }
        Console.WriteLine(chars);

        int stopped = 0;
        foreach (int n in nums) {
            if (n == 5) { continue; }
            if (n == 8) { break; }
            stopped = stopped + n;
        }
        Console.WriteLine(stopped);

        Console.WriteLine(Program.Count(names));
        Bag bag = new Bag();
        Console.WriteLine(bag.Total());

        List<int> list = new List<int>();
        list.Add(9);
        list.Add(10);
        foreach (int n in list) { Console.WriteLine(n); }
    }
}
