// Request parameters are discovered by the compiler from the action body: an
// `In`/`Need` call IS the parameter's declaration, so the generated OpenAPI
// document describes exactly what the handler reads, with the defaults and
// required-ness written in the code and nothing to keep in sync by hand.
using System;
using System.Web;

[Route("/api/post")]
class DocPostsController : Controller {
    [HttpGet]
    [Description("文章列表")]
    void List() {
        string kw = this.In("kw");
        int page = this.InInt("page", 1);
        long since = this.InLong("since", 0);
        bool draft = this.InBool("draft", false);
        this.Ok("null");
    }

    [HttpPost]
    [Description("保存文章")]
    void Save() {
        int id = this.InInt("article_id", 0);
        string title = this.Need("title", "标题");
        string body = this.NeedText("content", "内容");
        this.Ok("null");
    }

    // {id} is a parameter too, even though the action never names it in a read.
    [HttpGet]
    [Route("/api/post/read/{id}")]
    [Description("文章详情")]
    void Read() {
        this.Ok("null");
    }
}

class Program {
    static void Main() {
        WebApp app = new WebApp("127.0.0.1", 0);
        WebHost.Use(app);
        __AttrRoutes.Register(app);

        List<Route> routes = app.router.All();
        Console.WriteLine("routes " + Convert.ToString(routes.Count));
        int i = 0;
        while (i < routes.Count) {
            Route r = routes[i];
            i = i + 1;
            Console.WriteLine(r.method + " " + r.pattern + " [" + r.title + "]");
            int j = 0;
            while (j < r.docParams.Count) {
                ApiParam p = r.docParams[j];
                j = j + 1;
                string def = p.Default();
                if (def.Length == 0) { def = "-"; }
                string desc = p.Desc();
                if (desc.Length == 0) { desc = "-"; }
                Console.WriteLine("  " + p.Name() + " " + p.Type() + " "
                    + p.Source() + " required=" + Convert.ToString(p.Required())
                    + " default=" + def + " desc=" + desc);
            }
        }

        // The OpenAPI document is generated from the same route metadata: a GET's
        // parameters stay in `parameters`, a write's become the form body schema.
        string spec = ApiDocs.SpecJson(app);
        Console.WriteLine("has-openapi "
            + Convert.ToString(spec.IndexOf("\"openapi\":\"3.0.3\"") >= 0));
        Console.WriteLine("list-page-default "
            + Convert.ToString(spec.IndexOf("\"default\":\"1\"") >= 0));
        Console.WriteLine("save-required "
            + Convert.ToString(spec.IndexOf("\"required\":[\"title\",\"content\"]") >= 0));
        Console.WriteLine("read-path-param "
            + Convert.ToString(spec.IndexOf("\"in\":\"path\"") >= 0));
    }
}
