using System;
using System.IO;
using Gui.Component.CefBrowser;

// CefHost 的 profile 槽位分配：多开时各占一个 profileN，占用判定是槽位目录
// 里那个 lock 文件的独占锁，锁一释放槽位立即复用。
class Program {
    static void Main() {
        // ProfileDir 拿的是运行时目录，槽位落在 <缓存>/Zan/Cache/profileN。
        string cache = "cefprofile_case/Zan";
        string runtime = cache + "/cef/some-cef-version";
        string root = CefHost.ProfileRoot(runtime);
        Console.WriteLine("root=" + (root == cache + "/Cache/profile"));

        // 模拟已经开着的第一份副本：占住 profile1 的 lock 文件。
        Directory.CreateDirectoryRecursive(root + "1");
        long first = File.TryLock(root + "1/" + CefHost.ProfileLockName());
        Console.WriteLine("slot1_taken=" + (first != 0));

        // 本进程于是拿到 profile2，并且结论会记住（同一进程只占一个槽位）。
        string mine = CefHost.ProfileDir(runtime);
        Console.WriteLine("mine=" + (mine == root + "2"));
        Console.WriteLine("stable=" + (CefHost.ProfileDir(runtime) == mine));

        // profile1 的持有者退出（这里等价于释放锁）后槽位可复用。
        Console.WriteLine("slot1_freed=" + File.Unlock(first));
        long again = File.TryLock(root + "1/" + CefHost.ProfileLockName());
        Console.WriteLine("slot1_reusable=" + (again != 0));
        File.Unlock(again);
    }
}
