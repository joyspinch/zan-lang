using System;

/// Deeply chained calls used to cost 2^depth type inferences (a member access
/// infers its object, and overload scoring infers it again), so this file both
/// pins the inference results and keeps the memoized path honest: the same
/// expression is inferred under changing locals, a generic instantiation and a
/// re-declared name of a different type.
class Node {
    int v;
    Node next;

    Node(int n) { v = n; }

    Node Link(Node n) { next = n; return this; }
    Node Next() { return next; }
    int Value() { return v; }
}

class Box<T> {
    List<T> items;

    Box() { items = new List<T>(); }

    Box<T> Put(T item) { items.Add(item); return this; }
    T At(int i) { return items[i]; }
    int Count() { return items.Count; }
}

class Program {
    static Node Chain(int n) {
        Node head = new Node(0);
        Node cur = head;
        int i = 1;
        while (i <= n) {
            Node nn = new Node(i);
            cur.Link(nn);
            cur = nn;
            i = i + 1;
        }
        return head;
    }

    static void Main() {
        Node root = Program.Chain(12);
        Console.WriteLine(Convert.ToString(
            root.Next().Next().Next().Next().Next().Next()
                .Next().Next().Next().Next().Next().Next().Value()));

        // The same shape inside a generic instantiation.
        Box<Node> box = new Box<Node>();
        box.Put(root).Put(root.Next());
        Console.WriteLine(Convert.ToString(box.At(1).Value()));
        Console.WriteLine(Convert.ToString(box.Count()));

        // A name reused at a different type in a later scope must not read back
        // the earlier inference.
        {
            Box<string> reuse = new Box<string>();
            reuse.Put("a").Put("b");
            Console.WriteLine(reuse.At(0) + reuse.At(1));
        }
        Console.WriteLine(Convert.ToString(root.Next().Next().Value()));
    }
}
