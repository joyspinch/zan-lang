using System;
using System.Collections.Generic;

namespace SelfhostWithDeconTernaryQqSwitchOwnership;

class Box {
    public int Val;
    public string Name;
    public Box NullChild;
    public int? NullInt;
    public Box(int v) {
        this.Val = v;
        this.Name = "b_" + v.ToString();
        this.NullChild = null;
        this.NullInt = null;
    }
}

record Rec(string A, string B);

class Program {
    static Box MakeBox(int v) { return new Box(v); }
    static object MakeObjBox(int v) { return new Box(v); }
    static Rec MakeRec(int v) { return new Rec("ra_" + v.ToString(), "rb_" + v.ToString()); }
    static (Box, Box) MakePair(int v) { return (new Box(v), new Box(v + 1)); }
    static string BoomStr() { throw new Exception("boom_str"); }
    static (Box, Box) BoomPair() { throw new Exception("boom_pair"); }
    static Box BoomBox() { throw new Exception("boom_box"); }
    static int BoomInt() { throw new Exception("boom_int"); }
    static void BoomVoid() { throw new Exception("boom_void"); }
    static void OkVoid() { }

    static int TestWith() {
        int acc = 0;
        for (int i = 0; i < 3; i = i + 1) {
            Rec r = (MakeRec(i) with { A = "a" + i.ToString() }) with { B = MakeBox(i + 10).Name };
            acc = acc + r.A.Length + r.B.Length;
        }
        try {
            Rec r2 = MakeRec(1) with { B = BoomStr() };
            acc = acc + r2.A.Length;
        } catch (Exception e) {
            acc = acc + e.Message.Length;
        }
        return acc;
    }

    static int TestDecon() {
        int acc = 0;
        var (_, second) = MakePair(5);
        acc = acc + second.Val + second.Name.Length;

        Func<int> cap = null;
        {
            var (a, b) = MakePair(7);
            cap = () => a.Val + b.Val;
        }
        acc = acc + cap();

        try {
            var (x, y) = (MakeBox(1).Val > 0 ? BoomPair() : MakePair(2));
            acc = acc + x.Val + y.Val;
        } catch (Exception e) {
            acc = acc + e.Message.Length;
        }
        return acc;
    }

    static int TestTernaryAndQq() {
        int acc = 0;
        try {
            int r = MakeBox(1).Val > 0 ? BoomInt() : 0;
            acc = acc + r;
        } catch (Exception e) {
            acc = acc + e.Message.Length;
        }
        try {
            MakeBox(1).Val > 0 ? BoomVoid() : OkVoid();
        } catch (Exception e) {
            acc = acc + e.Message.Length;
        }
        try {
            MakeBox(1).NullChild ?? BoomBox();
        } catch (Exception e) {
            acc = acc + e.Message.Length;
        }
        try {
            MakeBox(1).NullInt ?? BoomInt();
        } catch (Exception e) {
            acc = acc + e.Message.Length;
        }
        return acc;
    }

    static int TestSwitchCapture() {
        int acc = 0;
        switch (MakeObjBox(5)) {
            case Box b when b.Val > 0:
                acc = acc + b.Val + b.Name.Length;
                break;
        }

        int v2 = MakeObjBox(6) switch {
            Box b when b.Val > 0 => b.Val + b.Name.Length,
            _ => 0
        };
        acc = acc + v2;
        return acc;
    }

    static void Main() {
        Console.WriteLine("with=" + TestWith().ToString());
        Console.WriteLine("decon=" + TestDecon().ToString());
        Console.WriteLine("ternaryQq=" + TestTernaryAndQq().ToString());
        Console.WriteLine("switchCap=" + TestSwitchCapture().ToString());
    }
}
