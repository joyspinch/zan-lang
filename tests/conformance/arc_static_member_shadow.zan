using System;

class StaticShadowNode {
    public int Value;
}

class StaticShadowStore {
    public static StaticShadowNode Current;
    public static StaticShadowNode Selected { get { return Current; } }
    public StaticShadowNode Item;
}

class StaticShadowBase {
    public weak StaticShadowStore StaticShadowStore;
}

class StaticShadowScope : StaticShadowBase {
    public void Enter(bool fail) {
        StaticShadowNode prior = StaticShadowStore.Current;
        try {
            StaticShadowStore.Current = new StaticShadowNode();
            if (fail) { throw new Exception("scope"); }
        } finally {
            StaticShadowStore.Current = prior;
        }
    }

    public StaticShadowNode ReadInstance() {
        return this.StaticShadowStore.Item;
    }

    public StaticShadowNode ReadLocal(StaticShadowStore StaticShadowStore) {
        return StaticShadowStore.Item;
    }
}

class StaticShadowPropertyBase {
    public int Calls;
    public StaticShadowStore StaticShadowStore {
        get {
            Calls = Calls + 1;
            return new StaticShadowStore();
        }
    }
}

class StaticShadowPropertyScope : StaticShadowPropertyBase {
    public void Enter() {
        StaticShadowNode prior = StaticShadowStore.Current;
        StaticShadowStore.Current = null;
        StaticShadowStore.Current = prior;
        StaticShadowNode selected = StaticShadowStore.Selected;
        Program.Check(selected == prior, "static getter result");
    }
}

class StaticShadowWatch {
    public weak StaticShadowNode Node;
}

class Program {
    public static void Check(bool ok, string message) {
        if (!ok) { throw new Exception(message); }
    }

    static void Exercise(StaticShadowWatch watch) {
        StaticShadowNode node = new StaticShadowNode();
        node.Value = 7;
        watch.Node = node;
        StaticShadowStore.Current = node;
        StaticShadowScope scope = new StaticShadowScope();
        scope.Enter(false);
        scope.Enter(false);
        bool caught = false;
        try { scope.Enter(true); }
        catch (Exception ex) { caught = true; }
        Check(caught, "exception path");
        Check(StaticShadowStore.Current == node && node.Value == 7, "restore static owner");

        StaticShadowPropertyScope propertyScope = new StaticShadowPropertyScope();
        propertyScope.Enter();
        propertyScope.Enter();
        Check(propertyScope.Calls == 0, "static receiver evaluated instance getter");

        StaticShadowStore store = new StaticShadowStore();
        store.Item = node;
        scope.StaticShadowStore = store;
        Check(scope.ReadInstance() == node, "explicit weak receiver");
        Check(scope.ReadLocal(store) == node, "local masks type name");
        StaticShadowStore.Current = null;
    }

    static void Main() {
        StaticShadowWatch watch = new StaticShadowWatch();
        Exercise(watch);
        Check(watch.Node == null, "static or instance reference leaked");
        Console.WriteLine("ARC_STATIC_MEMBER_SHADOW_OK");
    }
}
