using System;
using System.Net.Http;
using System.Web;
using Zan.Web;

namespace Conf;

class CompanyController : AppController {
    [HttpGet]
    [RouteR(@"^/about/company/?$")]
    void Detail() { this.Text("company_ok"); }

    [HttpGet]
    [RouteR(@"^/new/download\.(html|htm)$")]
    void Download() { this.Text("download_ok"); }

    [HttpGet]
    [RouteR(@"^/user/(?<id>\d+)$")]
    void UserDetail() {
        string id = this.In("id");
        this.Text("user_" + id);
    }

    [HttpGet]
    [Route("/static/page")]
    void StaticPage() { this.Text("static_ok"); }
}

class Program {
    static int failures = 0;

    static void Check(bool ok, string label) {
        if (!ok) {
            Program.failures = Program.failures + 1;
            Console.WriteLine("FAIL: " + label);
        }
    }

    static HttpContext Ctx(string method, string path) {
        HttpRequest req = HttpRequest.Parse(method + " " + path + " HTTP/1.1\r\nHost: localhost\r\n\r\n");
        return new HttpContext(req, "127.0.0.1");
    }

    static void Main() {
        WebApp app = new WebApp("127.0.0.1", 0);
        __AttrRoutes.Register(app);

        // 1. 验证 RouteR 正则：/about/company 与 /about/company/ 均可匹配
        HttpContext c1 = Program.Ctx("GET", "/about/company");
        Route r1 = app.router.Match(c1);
        Program.Check(r1 != null, "RouteR /about/company matched");

        HttpContext c2 = Program.Ctx("GET", "/about/company/");
        Route r2 = app.router.Match(c2);
        Program.Check(r2 != null, "RouteR /about/company/ matched");

        // 2. 验证 RouteR 正则扩展名：/new/download.html 与 /new/download.htm
        HttpContext c3 = Program.Ctx("GET", "/new/download.html");
        Route r3 = app.router.Match(c3);
        Program.Check(r3 != null, "RouteR /new/download.html matched");

        HttpContext c4 = Program.Ctx("GET", "/new/download.htm");
        Route r4 = app.router.Match(c4);
        Program.Check(r4 != null, "RouteR /new/download.htm matched");

        HttpContext c5 = Program.Ctx("GET", "/new/download.php");
        Route r5 = app.router.Match(c5);
        Program.Check(r5 == null, "RouteR /new/download.php rejected");

        // 3. 验证 RouteR 命名捕获组参数提取
        HttpContext c6 = Program.Ctx("GET", "/user/12345");
        Route r6 = app.router.Match(c6);
        Program.Check(r6 != null, "RouteR /user/12345 matched");
        Program.Check(c6.routeParams.Get("id") == "12345", "RouteR (?<id>\\d+) param extracted as 12345");

        // 4. 验证静态路由自动尾斜杠容错
        HttpContext c7 = Program.Ctx("GET", "/static/page/");
        Route r7 = app.router.Match(c7);
        Program.Check(r7 != null, "Static route /static/page/ auto trailing slash matched");

        if (Program.failures == 0) {
            Console.WriteLine("ALL REGEX ROUTE TESTS PASSED");
        } else {
            Console.WriteLine("FAILED COUNT: " + Convert.ToString(Program.failures));
        }
    }
}
