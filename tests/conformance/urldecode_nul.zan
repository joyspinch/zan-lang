// Conformance: UrlDecode keeps decoded NUL bytes. The decoder appends the
// decoded byte through StringBuilder, which used to take the argument's
// strlen, so "a%00b" collapsed to "a" and a NUL-bearing form value was
// silently truncated.
using System;
using System.Text;

class Program {
    static void Main() {
        string s = Encoding.UrlDecode("a%00b%00c");
        Console.WriteLine("len=" + Convert.ToString(s.Length));
        // A bare WriteLine stops at the first NUL: print the bytes instead.
        for (int i = 0; i < s.Length; i = i + 1) {
            Console.WriteLine("b" + Convert.ToString(i) + "="
                + Convert.ToString(s[i] & 255));
        }
    }
}
