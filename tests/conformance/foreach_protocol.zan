using System;

/* 底层系统交互与数据协议契约 */
class Numbers {
    int n;
    Numbers(int n) { this.n = n; }
    static Numbers Of(int n) { return new Numbers(n); }
    public NumEnumerator GetEnumerator() { return new NumEnumerator(n); }
}

class NumEnumerator {
    int i;
    int n;
    public NumEnumerator(int n) { this.n = n; this.i = 0; }
    public bool MoveNext() { i = i + 1; return i <= n; }
    public int Current() { return i * i; }
}

class Chars {
    string s;
    Chars(string s) { this.s = s; }
    static Chars Of(string s) { return new Chars(s); }
    public CharEnumerator GetEnumerator() { return new CharEnumerator(s); }
}

class CharEnumerator {
    string s;
    int i;
    public CharEnumerator(string s) { this.s = s; this.i = -1; }
    public bool MoveNext() { i = i + 1; return i < s.Length; }
    public int Current { get { return s[i]; } }
}

class Program {
    static async int SumAsync(Chars c) {
        int total = 0;
        foreach (int ch in c) {
            total = total + ch;
            await Task.Delay(1);
        }
        return total;
    }
    static async void Main() {
        int sum = 0;
        foreach (int x in Numbers.Of(4)) { sum = sum + x; }
        Console.WriteLine("sum " + Convert.ToString(sum));
        int cnt = 0;
        foreach (int v in Numbers.Of(3)) { cnt = cnt + 1; }
        Console.WriteLine("cnt " + Convert.ToString(cnt));
        int prop = 0;
        foreach (int ch in Chars.Of("ABC")) { prop = prop + ch; }
        Console.WriteLine("prop " + Convert.ToString(prop));
        int at = await SumAsync(Chars.Of("AB"));
        Console.WriteLine("async total " + Convert.ToString(at));
    }
}
