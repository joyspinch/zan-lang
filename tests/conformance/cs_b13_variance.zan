// A43-B13: generic interface variance annotations `interface I<out T>` /
// `I<in T>` are accepted (type system stays invariant). Also covers the
// generic-interface contract check for methods phrased in the interface's
// own type parameters (`T Get()` implemented by a concrete `int Get()`).
interface IEnumerable<out T> {
    T Get();
    T GetAt(int i);
}
interface IComparer<in T> {
    int Compare(T a, T b);
}
class NumList : IEnumerable<int>, IComparer<int> {
    public int Get() { return 42; }
    public int GetAt(int i) { return i * 10; }
    public int Compare(int a, int b) { return a < b ? -1 : (a > b ? 1 : 0); }
}
class Program {
    static void Main() {
        NumList nl = new NumList();
        Console.WriteLine(nl.Get());
        Console.WriteLine(nl.GetAt(2));
        Console.WriteLine(nl.Compare(1, 2));
        Console.WriteLine(nl.Compare(5, 2));
    }
}
