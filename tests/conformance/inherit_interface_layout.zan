using System;
using System.Collections.Generic;

namespace Conformance;

// 继承链上的字段偏移必须一致。
//
// 踩过的坑：基类没有接口也没有虚方法（无 vptr），派生类实现了接口（有 vptr），
// 以前这两条布局给同一个字段两套下标——基类构造器把字段写进了派生对象的
// vptr 槽，派生类读到的却是垃圾，ARC 释放也漏掉基类那份字段（泄漏）。
//
// 现在类一律在 0 号槽留 vptr 位，链上所有类对同一批字段给出同一个下标。
public interface IThing {
    int Id();
}

public class Base {
    public int count;
    public List<string> items;
    public string tag;

    public Base() {
        this.count = 1;
        this.items = new List<string>();
        this.items.Add("base");
        this.tag = "base-tag";
    }

    // 基类方法读自己的字段：this 可能是派生实例。
    public int Count() { return this.count; }
    public string Tag() { return this.tag; }
    public int ItemCount() { return this.items.Count; }
}

public class Derived : Base, IThing {
    public string extra;

    public Derived() {
        this.extra = "extra";
    }

    public int Id() { return this.count; }
}

public class Main {
    public static void Main() {
        Derived d = new Derived();
        Console.WriteLine("count=" + d.count.ToString());
        Console.WriteLine("items=" + d.items.Count.ToString());
        Console.WriteLine("tag=" + d.tag);
        Console.WriteLine("extra=" + d.extra);
        // 基类方法在派生实例上读字段
        Console.WriteLine("base-count=" + d.Count().ToString());
        Console.WriteLine("base-tag=" + d.Tag());
        Console.WriteLine("base-items=" + d.ItemCount().ToString());
        // 接口分派
        Console.WriteLine("iface-id=" + d.Id().ToString());
        // 基类类型引用
        Base b = d;
        Console.WriteLine("poly-count=" + b.Count().ToString());
        Console.WriteLine("INHERIT LAYOUT OK");
    }
}
