using System;
using System.Collections.Generic;
using System.Test;

// Zan.Test 自身的契约用例：通过/断言失败不中断/异常接住/跳过/分组/
// setup-teardown 配对/结果记账/Reset 全路径。输出即金样。
class Prog {
    static int setupRuns = 0;
    static int teardownRuns = 0;
    static bool inCase = false;

    static void Main() {
        Test.verbose = true;
        Test.Setup(() => { setupRuns = setupRuns + 1; inCase = true; });
        Test.Teardown(() => { teardownRuns = teardownRuns + 1; inCase = false; });

        Test.Run("passes", () => {
            Assert.True(inCase, "setup-ran");
            Assert.Equal(1, 1, "int-eq");
            Assert.Equal(2L, 2L, "long-eq");
            Assert.Equal(1.5, 1.5, "double-eq");
            Assert.Equal(true, true, "bool-eq");
            Assert.Equal("a", "a", "str-eq");
            Assert.Nearly(0.1 + 0.2, 0.3, 0.000001, "nearly");
            Assert.Contains("hello world", "lo wo", "contains");
            Assert.NotNull("x", "notnull");
            Assert.False(false, "false-ok");
            string nothing = null;
            Assert.Null(nothing, "null-ok");
        });

        // 断言失败不中断用例体：三个失败断言全部打出行，用例只记一次失败
        Test.Run("assert-fails", () => {
            Assert.Equal(5, 3, "expect-five");
            Assert.True(false, "expect-true");
            Assert.Equal("a", "b", "expect-a");
        });

        // 异常与字符串 throw 都算失败并带原因
        Test.Run("throws-exception", () => {
            throw new InvalidOperationException("kaboom");
        });
        Test.Run("throws-string", () => {
            throw "raw";
        });

        // teardown 在用例体抛异常后仍然执行，且不覆盖原失败原因
        Test.Run("teardown-after-throw", () => {
            throw new InvalidOperationException("body-first");
        });

        // 期望抛出/期望不抛
        Test.Run("expects-throw", () => {
            Assert.Throws(() => { throw new InvalidOperationException("x"); }, "threw");
            Assert.NotThrows(() => { }, "no-throw");
        });

        // 分组前缀
        Test.Group("grp");
        Test.Run("inner", () => { Assert.True(true, "t"); });
        Test.EndGroup();

        Test.Skip("later", "not implemented");

        // 记账：此刻已登记 8 个用例体 + 1 个 skip，results 里 7 条；
        // meta 自己的 setup 已跑、teardown 未跑。
        Test.Run("meta", () => {
            Assert.Equal(8, setupRuns, "setup-runs");
            Assert.Equal(7, teardownRuns, "teardown-runs");
            Assert.Equal(9, Test.total, "total");
            Assert.Equal(7, Test.Results().Count, "results-count");
            TestResult r = Test.Results()[1];
            Assert.Equal("assert-fails", r.name, "result-name");
            Assert.Equal(false, r.ok, "result-ok");
        });

        int n = Test.Report();
        Console.WriteLine("failed-count=" + Convert.ToString(n));

        // Reset 之后计数归零、可重跑
        Test.Reset();
        Test.Run("after-reset", () => { Assert.Equal(1, 1, "one"); });
        Test.Report();
    }
}
