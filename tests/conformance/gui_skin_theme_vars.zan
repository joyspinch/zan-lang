using System;
using System.Json;
using Gui;

// 皮肤层必须认得主题令牌。
//
// 皮肤 CSS 在 Skin.Load 里是裸解析的（只看得到皮肤自己的 :root），
// 于是 `var(--radius-medium)`、`var(--padding-large)`、`var(--anim-medium)`
// 这类**主题度量**会展开成空串——整条声明随之消失：
// `padding: 0 var(--padding-large)` 变成 `padding: 0`，按钮的水平内边距
// 直接没了；`border-radius: var(--radius-medium)` 整条被丢掉。
//
// 契约（App.ApplyAppCss → Skin.SheetWithVars 负责兑现）：
//   1) 按主题令牌解析时，皮肤规则里的主题度量必须有值；
//   2) 皮肤自己的 `:root` 仍然胜出（同名时本地覆盖主题）；
//   3) 时长令牌不带 px/dpx 尾巴——它是时间，不是长度。
class SkinThemeVarsTest {
    static int fails;

    static void Chk(bool ok, string what) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static StyleBox Apply(StyleSheet sheet) {
        StyleBox b = new StyleBox();
        Style.ApplySheet(sheet, b, "button", "", "", Style.SNormal());
        return b;
    }

    static void Main() {
        Theme t = Theme.Light();
        List<CssVarDecl> vars = Css.CollectVarDecls(Style.RootFromTheme(t));

        // 1) 主题度量在皮肤规则里有值。
        string css = "button {\n"
            + "  border-radius: var(--radius-medium);\n"
            + "  padding: 0 var(--padding-large);\n"
            + "  transition: var(--anim-medium) ease-out;\n"
            + "}\n";
        StyleBox b = Apply(Css.ParseWithSources(css, vars, vars.Count));
        Console.WriteLine("padding-large " + b.padL);
        Console.WriteLine("radius-medium " + b.radius);
        Console.WriteLine("transition-ms " + b.transitionMs);
        Chk(b.padL == t.paddingLarge, "theme padding token resolves");
        Chk(b.padT == 0, "padding shorthand keeps the literal side");
        Chk(b.radius == t.borderRadiusMedium, "theme radius token resolves");
        Chk(b.transitionMs == t.animMediumMs, "theme anim token resolves");

        // 2) 皮肤自己的 :root 仍然胜出。
        string own = ":root { --padding-large: 22; }\n"
            + "button { padding: 0 var(--padding-large); }\n";
        StyleBox ob = Apply(Css.ParseWithSources(own, vars, vars.Count));
        Console.WriteLine("own root padding " + ob.padL);
        Chk(ob.padL == 22, "skin :root overrides the theme");

        // 3) 对照组：不给变量的裸解析（旧的皮肤加载路径）会丢掉引用。
        StyleBox bb = Apply(Css.ParseWithSources(css, new List<CssVarDecl>(), 0));
        Console.WriteLine("bare padding " + bb.padL);
        Console.WriteLine("bare radius " + bb.radius);
        Chk(bb.padL == 0, "bare parse loses the unresolved var");
        Chk(bb.radius <= 0, "bare parse drops the unresolved declaration");

        // 4) 真实产品集合导出的主题度量进入同一条 CSS 解析路径。
        //    全套 16 套内置皮肤共享密度/内边距/字号档位，同时各自保留真实风格对应的
        //    圆角几何（如 brutal 0px、cyber 2px、liquid/clay 20px）与材质开关（均保持 --fx: 0 零空转）。
        List<string> builtins = Skin.BuiltInNames();
        Chk(Skin.DefaultName() == "porcelain" && builtins.Count == 16,
            "the default catalog exposes the 16-skin collection");
        for (int i = 0; i < builtins.Count; i = i + 1) {
            string name = builtins[i];
            Skin sk = Skin.Load(name);
            Chk(sk.IsLoaded(), "built-in skin pack found: " + name);
            if (!sk.IsLoaded()) { continue; }
            Theme actual = sk.NewTheme();
            List<CssVarDecl> live = Css.CollectVarDecls(Style.RootFromTheme(actual));
            StyleSheet composed = sk.SheetWithVars(live, live.Count);
            composed.MergeSheet(Css.ParseWithSources(css, live, live.Count));
            StyleBox wb = Apply(composed);
            if (i == 0) {
                Console.WriteLine("skin padding " + wb.padL);
                Console.WriteLine("skin radius " + wb.radius);
                Console.WriteLine("skin bare padding " + bb.padL);
            }
            Chk(wb.padL == t.paddingLarge,
                "skin composition keeps shared density padding: " + name);
            int expectedBtnRadius = actual.borderRadiusMedium;
            if (name == "liquid" || name == "starlight") { expectedBtnRadius = 999; }
            else if (name == "brutal") { expectedBtnRadius = 0; }
            Chk(wb.radius == expectedBtnRadius,
                "skin composition preserves skin button silhouette radius: " + name);
            int expectedFx = 0;
            if (name == "liquid" || name == "frosted") { expectedFx = 7; }
            else if (name == "aurora") { expectedFx = 2; }
            else if (name == "cyber") { expectedFx = 8; }
            else if (name == "starlight") { expectedFx = 11; }
            else if (name == "luxe") { expectedFx = 10; }
            if (name == "frosted" || name == "liquid" || name == "aurora" || name == "starlight") {
                Chk(actual.glass == 1 && actual.gradient == 1 && actual.fx == expectedFx
                    && actual.neu == 0 && actual.brutal == 0,
                    name + " skin enables glass, gradient and default atmospheric fx");
            } else if (name == "cyber" || name == "luxe" || name == "sakura" || name == "lavender") {
                Chk(actual.gradient == 1 && actual.glass == 0 && actual.fx == expectedFx
                    && actual.neu == 0 && actual.brutal == 0,
                    name + " skin enables atmospheric gradient with expected default fx");
            } else if (name == "brutal") {
                Chk(actual.brutal == 1 && actual.glass == 0 && actual.gradient == 0
                    && actual.fx == 0 && actual.neu == 0,
                    "brutal skin enables brutal shadow/border without glass");
            } else {
                Chk(actual.glass == 0 && actual.gradient == 0 && actual.fx == 0
                    && actual.neu == 0 && actual.brutal == 0,
                    "static built-in skin surfaces are calm and opaque: " + name);
            }
            StyleSheet bodyProbe = Css.ParseWithSources(
                "body { background: var(--window-bg); } windowbg { background: var(--window-solid-bg); }",
                live, live.Count);
            StyleBox bodyBox = new StyleBox();
            Style.ApplySheet(bodyProbe, bodyBox, "body", "", "", Style.SNormal());
            StyleBox solidBox = new StyleBox();
            Style.ApplySheet(bodyProbe, solidBox, "windowbg", "", "", Style.SNormal());
            if (actual.gradient != 0 || actual.glass != 0) {
                Chk(bodyBox.bg == 0, name + " exports transparent --window-bg so HTML body reveals backdrop");
            } else {
                Chk(((bodyBox.bg >> 24) & 255) == 255, name + " keeps opaque --window-bg on static skin");
            }
            Chk(((solidBox.bg >> 24) & 255) == 255, name + " keeps opaque --window-solid-bg");
            StyleBox divBox = new StyleBox();
            StyleSheet baseSheet = Css.ParseWithSources(Skin.BaseCss(), live, live.Count);
            Style.ApplySheet(baseSheet, divBox, "div", "", "", Style.SNormal());
            Chk(divBox.overflow == 0, "base.css sets HTML div container overflow: visible");
            StyleBox uaDivBox = new StyleBox();
            StyleSheet uaSheet = Css.ParseWithSources(Style.UaCss(), live, live.Count);
            Style.ApplySheet(uaSheet, uaDivBox, "div", "", "", Style.SNormal());
            Chk(uaDivBox.overflow == 0, "UA baseline sets HTML div container overflow: visible");
            if (name == "brutal") {
                Chk(actual.borderRadiusSmall == 0 && actual.borderRadiusMedium <= 2,
                    "brutal keeps crisp square geometry");
            } else if (name == "liquid" || name == "clay") {
                Chk(actual.borderRadiusLarge >= 18,
                    name + " keeps generous sculpted corner radius");
            } else if (name == "cyber") {
                Chk(actual.borderRadiusMedium <= 3,
                    "cyber keeps angular HUD corner radius");
            }
            Chk(Skin.DensityOf(sk.sheet) == -1, "skin choice preserves user density");
        }

        // 5) Theme.ApplySnapshotScaled 必须保留 0px 锐利圆角，不把 brutal 强制抬高。
        Theme brutalTheme = Skin.Load("brutal").NewTheme();
        ThemeMetricsSnapshot snap = brutalTheme.Snapshot();
        Theme scaled = Theme.Light();
        scaled.ApplySnapshotScaled(snap, 115, 100);
        Chk(scaled.borderRadiusSmall == 0, "snapshot scaling preserves 0px brutal radius");

        if (fails == 0) {
            Console.WriteLine("gui skin theme vars OK");
        } else {
            Console.WriteLine("gui skin theme vars FAILS " + fails);
        }
        Skin.ClearCache();
    }
}
