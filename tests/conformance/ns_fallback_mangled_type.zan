using System;

namespace Other {
    public class Box {
        public int val;
    }
}

class Program {
    static int result = 0;

    static void Invoke(Action a) {
        if (a != null) {
            a();
        }
    }

    static void Main() {
        Other.Action act = () => {
            result = 42;
        };
        Invoke(act);
        Console.WriteLine(result);
    }
}
