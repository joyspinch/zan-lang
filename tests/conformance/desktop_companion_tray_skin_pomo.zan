using System;
using System.Windows;

namespace Conf;

class DesktopCompanionTraySkinPomoTest {
    static void Main() {
        // 1. 系统托盘右键菜单模型：勾选切换、禁用拦截、分隔符与触发次数统计
        CompanionTrayMenuModel tray = new CompanionTrayMenuModel();
        tray.AddToggle("topmost", "Always On Top", true);
        tray.AddSeparator();
        tray.AddCommand("feed", "Feed Pet", "Ctrl+F");
        tray.SetEnabled("feed", false);

        bool toggle1 = tray.Trigger("topmost") && !tray.IsChecked("topmost");
        bool disabledBlocked = !tray.Trigger("feed");
        tray.SetEnabled("feed", true);
        bool feedTriggered = tray.Trigger("feed") && tray.Trigger("feed");

        bool trayOk = tray.ItemCount() == 3 && toggle1 && disabledBlocked && feedTriggered
            && tray.InvokeCount("topmost") == 1 && tray.InvokeCount("feed") == 2;
        Console.WriteLine("companion-tray-menu-model: " + Convert.ToString(trayOk ? 1 : 0));

        // 2. 桌宠换装衣柜：未解锁拦截、多槽位换装、预设保存与一键换装恢复
        CompanionSkinWardrobe wardrobe = new CompanionSkinWardrobe();
        wardrobe.UnlockCosmetic("hat_witch");
        wardrobe.UnlockCosmetic("scarf_red");
        wardrobe.UnlockCosmetic("hat_santa");

        bool lockedBlocked = !wardrobe.Equip("hat", "hat_vip_locked");
        bool eq1 = wardrobe.Equip("hat", "hat_witch") && wardrobe.Equip("neck", "scarf_red");
        wardrobe.SavePreset("autumn");

        wardrobe.Equip("hat", "hat_santa");
        bool switched = wardrobe.GetEquipped("hat") == "hat_santa";
        bool restored = wardrobe.ApplyPreset("autumn")
            && wardrobe.GetEquipped("hat") == "hat_witch"
            && wardrobe.GetEquipped("neck") == "scarf_red";

        bool wardrobeOk = lockedBlocked && eq1 && switched && restored;
        Console.WriteLine("companion-skin-wardrobe: " + Convert.ToString(wardrobeOk ? 1 : 0));

        // 3. 商用番茄专注钟：暂停冻结、Focus->ShortBreak->Focus->LongBreak 自动轮转与专注秒数统计
        CompanionPomodoroClock pomo = new CompanionPomodoroClock(60, 15, 45, 2);
        pomo.Pause();
        int pausedTrans = pomo.AdvanceSeconds(30);
        pomo.Resume();
        int t1 = pomo.AdvanceSeconds(60); // 第 1 轮 Focus 完 -> ShortBreak(15s)
        bool afterCycle1 = pomo.Phase == PomoPhaseKind.ShortBreak && pomo.RemainingSec == 15
            && pomo.CompletedFocusCycles == 1 && pomo.TotalFocusedSec == 60;
        pomo.SkipPhase(); // 跳过短休回到 Focus(60s)
        int t2 = pomo.AdvanceSeconds(60); // 第 2 轮 Focus 完 -> LongBreak(45s)
        bool afterCycle2 = pomo.Phase == PomoPhaseKind.LongBreak && pomo.RemainingSec == 45
            && pomo.CompletedFocusCycles == 2 && pomo.TotalFocusedSec == 120;

        bool pomoOk = pausedTrans == 0 && t1 == 1 && t2 == 1 && afterCycle1 && afterCycle2;
        Console.WriteLine("companion-pomodoro-clock: " + Convert.ToString(pomoOk ? 1 : 0));
    }
}
