// B-ID186 Wave 13: struct-typed container slots (`List<Struct>` OOB and
// `Dictionary<K, Struct>` missing-key) must never dereference a null struct
// pointer after a soft runtime guard; live reads and try-caught OOB continue
// to match the C host with zero leaks.
using System;
using System.Collections.Generic;

struct Vec3W13 {
    public double X;
    public double Y;
    public double Z;
}

class PropBoxW13 {
    int _v;
    public int Value { get { return _v + 10; } }
    public PropBoxW13(int v) { _v = v; }
}

class Program {
    static void Main() {
        List<Vec3W13> ls = new List<Vec3W13>();
        Vec3W13 v;
        v.X = 1.5; v.Y = 2.5; v.Z = 3.5;
        ls.Add(v);
        Console.WriteLine("list-ok=" + ls[0].X + "|" + ls[0].Z);

        try {
            Console.WriteLine(ls[-1].X);
        } catch (IndexOutOfRangeException e) {
            Console.WriteLine("list-oob-try=caught");
        }

        Dictionary<string, Vec3W13> d = new Dictionary<string, Vec3W13>();
        d["a"] = v;
        Vec3W13 hit = d["a"];
        Vec3W13 miss = d["missing"];
        Console.WriteLine("dict-hit=" + hit.Y + "|dict-miss=" + miss.X + "|" + miss.Z);

        PropBoxW13 pb = new PropBoxW13(32);
        Console.WriteLine("prop-live=" + pb.Value);
    }
}
