class Holder { public long v; }

class Prog {
    static Big nobody;
    static Holder none;
    static AtomicInt seen;
    static AtomicInt done;

    static void Writer() {
        for (int i = 0; i < 2000; i++) { Prog.none.v = 111; }
        Prog.done.Add(1);
    }

    static void Reader() {
        long worst = 0;
        for (int i = 0; i < 2000; i++) { long r = Prog.none.v; if (r > worst) { worst = r; } }
        Prog.seen.Add((int)worst);
        Prog.done.Add(1);
    }

    static void Main() {
        Prog.seen = new AtomicInt(0);
        Prog.done = new AtomicInt(0);
        Prog.nobody.f699 = 42;
        Console.WriteLine("far field survived: " + Convert.ToString(Prog.nobody.f699 >= 0));
        Thread.Start(Prog.Writer);
        while (Prog.done.Load() < 1) { Thread.Sleep(1); }
        Thread.Start(Prog.Reader);
        while (Prog.done.Load() < 2) { Thread.Sleep(1); }
        Console.WriteLine("other thread saw: " + Convert.ToString(Prog.seen.Load()));
    }
}
