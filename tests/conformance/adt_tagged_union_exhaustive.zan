using System;

enum Shape {
    Circle(double radius),
    Rect(double w, double h),
    Point
}

enum Option<T> {
    Some(T value),
    None
}

enum Result<T, E> {
    Ok(T value),
    Err(E error)
}

class Program {
    static int AreaInt(Shape s) {
        double a = s switch {
            Shape.Circle(var r) when r > 10.0 => r * r * 3.0,
            Shape.Circle(var r) => r * r * 3.14,
            Shape.Rect(var w, var h) => w * h,
            Shape.Point => 0.0
        };
        return (int)a;
    }

    static string DescribeShape(Shape s) {
        string res = "";
        switch (s) {
            case Shape.Circle(var r):
                res = $"C:{(int)r}";
                break;
            case Shape.Rect(var w, _):
                res = $"R:{(int)w}";
                break;
            case Shape.Point:
                res = "P";
                break;
        }
        return res;
    }

    static Result<string, string> CheckPositive(int n) {
        if (n > 0) return Result<string, string>.Ok($"pos:{n}");
        return Result<string, string>.Err($"bad:{n}");
    }

    static void Main() {
        Shape c1 = Shape.Circle(10.0);
        Shape c2 = Shape.Circle(20.0);
        Shape r = Shape.Rect(4.0, 5.0);
        Shape p = Shape.Point;
        Console.WriteLine($"area:{AreaInt(c1)},{AreaInt(c2)},{AreaInt(r)},{AreaInt(p)}");
        Console.WriteLine($"desc:{DescribeShape(c1)},{DescribeShape(r)},{DescribeShape(p)}");

        Option<int> oi = Option<int>.Some(42);
        Option<int> on = Option<int>.None;
        int vi = oi switch { Option<int>.Some(var x) => x, Option<int>.None => -1 };
        int vn = on switch { Option<int>.Some(var x) => x, Option<int>.None => -1 };
        Console.WriteLine($"opt_int:{vi},{vn}");

        Option<string> os = Option<string>.Some("hello" + "_adt");
        Option<string> osn = Option<string>.None;
        string s1 = os switch { Option<string>.Some(var s) => s, Option<string>.None => "empty" };
        string s2 = osn switch { Option<string>.Some(var s) => s, Option<string>.None => "empty" };
        Console.WriteLine($"opt_str:{s1},{s2}");

        string r1 = CheckPositive(7) switch {
            Result<string, string>.Ok(var ok) => "OK:" + ok,
            Result<string, string>.Err(var err) => "ERR:" + err
        };
        string r2 = CheckPositive(-3) switch {
            Result<string, string>.Ok(var ok) => "OK:" + ok,
            Result<string, string>.Err(var err) => "ERR:" + err
        };
        Console.WriteLine($"res:{r1}|{r2}");
    }
}
