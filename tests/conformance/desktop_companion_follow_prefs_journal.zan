using System;
using System.Windows;

namespace Conf;

class DesktopCompanionFollowPrefsJournalTest {
    static void Main() {
        // 1. 临界阻尼弹簧光标跟随器：死区内静止抗抖、远距平滑收敛且无过冲
        CompanionCursorSpringFollower follower = new CompanionCursorSpringFollower(0.0, 0.0, 0.15, 5.0, 1500.0);
        follower.Step(3.0, 2.0, 0.016); // 距离 < 5px 死区，位置不动
        bool deadzoneHeld = follower.PosX == 0.0 && follower.PosY == 0.0;

        bool noOvershoot = true;
        for (int i = 0; i < 60; i = i + 1) {
            follower.Step(200.0, 100.0, 0.016);
            if (follower.PosX > 201.0 || follower.PosY > 101.0) {
                noOvershoot = false;
            }
        }
        bool converged = follower.PosX > 192.0 && follower.PosX <= 200.5
            && follower.PosY > 94.0 && follower.PosY <= 100.5;
        Console.WriteLine("companion-cursor-spring-follower: " + Convert.ToString((deadzoneHeld && noOvershoot && converged) ? 1 : 0));

        // 2. 本地偏好配置仓库：强类型读写、脏标记、转义字符往返序列化持久化
        CompanionPreferenceStore prefs = new CompanionPreferenceStore();
        prefs.SetString("pet_name", "Mochi=Chan\nLive");
        prefs.SetInt("fps_cap", 30);
        prefs.SetBool("always_on_top", true);
        bool dirtyBeforeSave = prefs.IsDirty;

        string blob = prefs.Serialize();
        bool cleanAfterSave = !prefs.IsDirty;

        CompanionPreferenceStore restored = new CompanionPreferenceStore();
        int loaded = restored.LoadSerialized(blob);
        bool prefsOk = dirtyBeforeSave && cleanAfterSave && loaded == 3
            && restored.GetString("pet_name", "") == "Mochi=Chan\nLive"
            && restored.GetInt("fps_cap", 0) == 30
            && restored.GetBool("always_on_top", false)
            && restored.GetInt("missing_key", -7) == -7;
        Console.WriteLine("companion-preference-store: " + Convert.ToString(prefsOk ? 1 : 0));

        // 3. 情绪日记与趋势追踪器：每日打卡覆盖、区间均值、连续好心情连击与最低落日识别
        CompanionMoodJournalTracker journal = new CompanionMoodJournalTracker();
        journal.RecordMood(1, 5, "great start");
        journal.RecordMood(2, 2, "rainy");
        journal.RecordMood(3, 4, "walk");
        journal.RecordMood(4, 5, "coding");
        journal.RecordMood(5, 4, "music");
        journal.RecordMood(5, 5, "music updated"); // 同日覆盖

        double avg = journal.AverageScore(1, 5); // (5+2+4+5+5)/5 = 4.2
        int streak = journal.PositiveStreak(4);  // 第 3,4,5 天连续 >= 4 -> 3 天
        int lowDay = journal.LowestMoodDay();    // 第 2 天

        bool journalOk = journal.EntryCount() == 5
            && avg > 4.19 && avg < 4.21
            && streak == 3
            && lowDay == 2;
        Console.WriteLine("companion-mood-journal-tracker: " + Convert.ToString(journalOk ? 1 : 0));
    }
}
