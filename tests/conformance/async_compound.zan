// 核心契约与语义定义。
class Program {
    static async int Twice(int x) {
        return x * 2;
    }
    static async int SumTwice(int n) {
        int acc = 0;
        for (int i = 0; i < n; i = i + 1) {
            acc = acc + await Twice(i);
        }
        return acc;
    }
    static void Main() {
        int v = await SumTwice(4);
        Console.WriteLine(v);
    }
}
