using System;
using System.Collections.Generic;

/* await inside a foreach body: the element, the index and the collection are
 * frame-resident, so iteration continues correctly after each suspension. */
class Program {
    static async int Bump(int x) {
        await Task.Delay(1);
        return x + 1;
    }

    static async string Echo(string s) {
        await Task.Delay(1);
        return s;
    }

    static async int Run() {
        List<int> nums = new List<int>();
        nums.Add(10);
        nums.Add(20);
        nums.Add(30);

        int sum = 0;
        foreach (int n in nums) {
            var bumped = await Bump(n);
            sum = sum + bumped;
            Console.WriteLine("n=" + Convert.ToString(n) + " sum=" + Convert.ToString(sum));
        }

        List<string> names = new List<string>();
        names.Add("a");
        names.Add("b");
        foreach (string name in names) {
            var got = await Echo(name);
            Console.WriteLine("name=" + name + " got=" + got);
            foreach (int n in nums) {
                if (n == 20) { continue; }
                sum = sum + await Bump(n);
                Console.WriteLine("  inner n=" + Convert.ToString(n) + " sum=" + Convert.ToString(sum));
            }
        }

        foreach (int n in nums) {
            sum = sum + await Bump(n);
            if (n == 20) { break; }
        }
        Console.WriteLine("sum=" + Convert.ToString(sum));
        return sum;
    }

    static async void Main() {
        Console.WriteLine("total=" + Convert.ToString(await Run()));
    }
}
