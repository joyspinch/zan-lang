using System;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;

class ExtensionEntity {
    public int id;
    public string name;
}
class Program {
    static async bool SyncExecutor(IDbExecutor executor) {
        return await executor.SyncStructureAsync<ExtensionEntity>();
    }
    static void Main() {
        SqliteConnection db = SqliteConnection.Open(":memory:");
        IDbExecutor executor = db;
        Console.WriteLine(await db.SyncStructureAsync<ExtensionEntity>());
        Console.WriteLine(await Program.SyncExecutor(executor));
        executor.Execute("INSERT INTO ExtensionEntity (id, name) VALUES (1, 'one')");
        SelectQuery<ExtensionEntity> query = executor.Query<ExtensionEntity>();
        Console.WriteLine(query.Count());
        List<ExtensionEntity> rows = query.ToList();
        Console.WriteLine(rows[0].name);
        DbResult raw = executor.Query("SELECT name FROM ExtensionEntity");
        Console.WriteLine(raw.RowCount());
        db.Close();
    }
}
