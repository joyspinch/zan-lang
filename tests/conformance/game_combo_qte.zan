using System;
using Game.Foundation;

namespace Tests.GameComboQte;

// 连击计 + 收缩圈 QTE 的契约测试：
//   连击 —— 计数、倍率递增与封顶、超时清零、主动中断、热档与表现强度；
//   QTE —— 收缩推进、到底复位记漏按、窗口命中、命中计数与完成判定。
class Program {
    static void Main() {
        ComboMeter m = new ComboMeter()
            .WithTimeout(3200).WithStep(0.1).WithMax(2.0)
            .WithFever(3, 200, 40);
        Console.WriteLine("init=" + Convert.ToString(m.count)
            + "," + Convert.ToString((int)(m.multiplier * 100)));

        m.Hit(1000);
        Console.WriteLine("hit1=" + Convert.ToString(m.count)
            + "," + Convert.ToString((int)(m.multiplier * 100)));

        m.Hit(1100);
        m.Hit(1200);
        Console.WriteLine("hit3=" + Convert.ToString(m.count)
            + "," + Convert.ToString((int)(m.multiplier * 100)));
        Console.WriteLine("fever=" + Convert.ToString(m.IsFever() ? 1 : 0)
            + "," + Convert.ToString(m.GlowTarget()));

        // 倍率封顶：连击 23 次也只到 2.0
        for (int i = 0; i < 20; i = i + 1) { m.Hit(1300 + i); }
        Console.WriteLine("cap=" + Convert.ToString(m.count)
            + "," + Convert.ToString((int)(m.multiplier * 100)));

        // 超时清零
        Console.WriteLine("expired=" + Convert.ToString(m.Expire(99999) ? 1 : 0)
            + "," + Convert.ToString(m.count)
            + "," + Convert.ToString((int)(m.multiplier * 100)));

        // 没超时不清零
        m.Hit(20000);
        Console.WriteLine("alive=" + Convert.ToString(m.Expire(21000) ? 1 : 0)
            + "," + Convert.ToString(m.count));

        // 主动中断（垃圾/踩雷）
        m.Break();
        Console.WriteLine("broken=" + Convert.ToString(m.count)
            + "," + Convert.ToString((int)(m.multiplier * 100)));

        // 剩余时间
        m.Hit(30000);
        Console.WriteLine("remaining=" + Convert.ToString(m.RemainingMs(31000)));

        // 未到热档的表现强度按连击数线性涨
        m.Break();
        m.Hit(40000);
        m.Hit(41000);
        Console.WriteLine("glow=" + Convert.ToString(m.GlowTarget()));

        // --- 收缩圈 QTE ---
        RingQte q = new RingQte()
            .WithTiming(96.0, 14.0, 340.0, 34.0, 54.0).WithNeed(3);
        Console.WriteLine("qte=" + Convert.ToString((int)q.radius)
            + "," + Convert.ToString(q.done));

        // 收缩 100ms：96 - 340*0.1 = 62
        q.Update(100);
        Console.WriteLine("shrink=" + Convert.ToString((int)q.radius));

        // 再缩 30ms：62 - 340*0.03 = 51.8，落在窗口 [34,54] 内 → 命中
        q.Update(30);
        Console.WriteLine("inWindow=" + Convert.ToString((int)q.radius)
            + "," + Convert.ToString(q.Hit() ? 1 : 0)
            + "," + Convert.ToString(q.done));

        // 按早了：半径 62 不在窗口 → 漏按并复位
        q.Update(100);
        Console.WriteLine("early=" + Convert.ToString(q.Hit() ? 1 : 0)
            + "," + Convert.ToString(q.miss)
            + "," + Convert.ToString((int)q.radius));

        // 缩到底：96 - 340*0.25 = 11 < 14 → 复位并记一次漏按
        Console.WriteLine("floor=" + Convert.ToString(q.Update(250) ? 1 : 0)
            + "," + Convert.ToString(q.miss)
            + "," + Convert.ToString((int)q.radius));

        // 再命中两次 → 满 need
        q.Update(100);
        q.Update(30);
        q.Hit();
        q.Update(100);
        q.Update(30);
        q.Hit();
        Console.WriteLine("done3=" + Convert.ToString(q.done)
            + "," + Convert.ToString(q.Complete() ? 1 : 0));
    }
}
