routes 3
GET /api/post/list [文章列表]
  kw string query required=false default=- desc=-
  page int query required=false default=1 desc=-
  since long query required=false default=0 desc=-
  draft bool query required=false default=false desc=-
POST /api/post/save [保存文章]
  article_id int query required=false default=0 desc=-
  title string query required=true default=- desc=标题
  content string query required=true default=- desc=内容
GET /api/post/read/{id} [文章详情]
  id string path required=true default=- desc=-
has-openapi true
list-page-default true
save-required true
read-path-param true
