routes 3
GET /api/post/list [文章列表]
  kw string query required=0 default=- desc=-
  page int query required=0 default=1 desc=-
  since long query required=0 default=0 desc=-
  draft bool query required=0 default=false desc=-
POST /api/post/save [保存文章]
  article_id int query required=0 default=0 desc=-
  title string query required=1 default=- desc=标题
  content string query required=1 default=- desc=内容
GET /api/post/read/{id} [文章详情]
  id string path required=1 default=- desc=-
has-openapi 1
list-page-default 1
save-required 1
read-path-param 1
