// 一元运算符重载：一元与二元靠形参个数区分（一元 1 个形参、二元 2 个）。
struct Vec {
    public int X;
    public Vec(int x) { X = x; }
    public static Vec operator -(Vec v) { return new Vec(-v.X); }
}
class Counter {
    public int N;
    public Counter(int n) { N = n; }
    public static Counter operator -(Counter c) { return new Counter(-c.N); }
}
struct Pair<T> {
    public T A;
    public Pair(T a) { A = a; }
    public static Pair<T> operator -(Pair<T> p) { return new Pair<T>(p.A); }
}
class Program {
    static void Main() {
        Vec a = new Vec(5);
        Vec b = -a;
        Console.WriteLine(b.X);            // -5
        Vec d = -new Vec(7);
        Console.WriteLine(d.X);            // -7
        Counter k = new Counter(9);
        Counter m = -k;
        Console.WriteLine(m.N);            // -9
        Pair<int> p = new Pair<int>(42);
        Pair<int> q = -p;
        Console.WriteLine(q.A);            // 42
        int n = 3;
        Console.WriteLine(-n);             // -3
        long l = 4L;
        Console.WriteLine(-l);             // -4
        double f = 1.5;
        Console.WriteLine(-f);             // -1.5
    }
}
