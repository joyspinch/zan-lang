using System;

// B-ID76：checked 上下文须覆盖全部整数溢出点（C# 口径）：+ - * 之外，
// 取负 -MIN、++/--、MIN / -1、窄化强转都要抛 OverflowException；unchecked 与默认���绕。
class Program {
    static void T(string name, Action a) {
        try { a(); Console.WriteLine(name + ": no throw"); }
        catch (OverflowException) { Console.WriteLine(name + ": OverflowException"); }
    }
    static void Main() {
        int max = int.MaxValue; int min = int.MinValue; long lmax = long.MaxValue;
        T("add", () => { int r = checked(max + 1); Console.WriteLine(r); });
        T("sub", () => { int r = checked(min - 1); Console.WriteLine(r); });
        T("mul", () => { int r = checked(max * 2); Console.WriteLine(r); });
        T("neg", () => { int r = checked(-min); Console.WriteLine(r); });
        T("inc", () => { int x = max; checked { x++; } Console.WriteLine(x); });
        T("compound", () => { int x = max; checked { x += 1; } Console.WriteLine(x); });
        T("div", () => { int m1 = -1; int r = checked(min / m1); Console.WriteLine(r); });
        T("cast", () => { int r = checked((int)lmax); Console.WriteLine(r); });
        T("ladd", () => { long r = checked(lmax + 1L); Console.WriteLine(r); });
        T("unchecked", () => { int r = unchecked(max + 1); Console.WriteLine(r); });
        T("default", () => { int r = max + 1; Console.WriteLine(r); });
    }
}
