// B-ID136：override virtual methods dispatched by static receiver type
// instead of runtime type, dropping overrides on upcast objects.
// Root cause: methods overriding System.Object virtual methods (ToString,
// Equals, GetHashCode) in user root classes were marked MOD_OVERRIDE but lacked
// a base AST class declaring MOD_VIRTUAL, so they were excluded from vtable slot
// allocation (slot == -1) and emitted direct static calls.
// Fix: override methods introduce a vtable slot when no base class provides one.
using System;

class Animal {
    public string Name;
    public Animal(string name) { this.Name = name; }
    public override string ToString() {
        return "Animal:" + this.Name;
    }
}

class Mammal : Animal {
    public Mammal(string name) : base(name) {}
}

class Dog : Mammal {
    public Dog(string name) : base(name) {}
    public override string ToString() {
        return "Dog:" + this.Name;
    }
}

class Cat : Mammal {
    public Cat(string name) : base(name) {}
    // Cat inherits Animal.ToString
}

class Plain {
    // Plain has no ToString declared, uses System.Object fallback
}

class CustomVal {
    public int Val;
    public CustomVal(int v) { this.Val = v; }
    public override bool Equals(object other) {
        if (other is CustomVal cv) {
            return this.Val == cv.Val;
        }
        return false;
    }
    public override int GetHashCode() {
        return this.Val * 31;
    }
    public override string ToString() {
        return "Val:" + this.Val;
    }
}

class CustomBase {
    public override bool Equals(object other) {
        return false;
    }
}

class CustomDerived : CustomBase {
    public override bool Equals(object other) {
        return true;
    }
}

class Program {
    static void Main() {
        Animal a1 = new Dog("Buddy");
        Animal a2 = new Cat("Kitty");
        Animal a3 = new Animal("Generic");
        Mammal m1 = new Dog("Rover");

        Console.WriteLine(a1.ToString());
        Console.WriteLine(a2.ToString());
        Console.WriteLine(a3.ToString());
        Console.WriteLine(m1.ToString());

        object o1 = new Dog("Max");
        object o2 = new Plain();
        Console.WriteLine(o1.ToString());
        Console.WriteLine(o2.ToString());

        Plain p = new Plain();
        Console.WriteLine(p.ToString());
        Console.WriteLine(p.GetHashCode() != 0);
        Console.WriteLine(p.Equals(p));
        Console.WriteLine(p.Equals(new Plain()));

        CustomVal cv1 = new CustomVal(42);
        CustomVal cv2 = new CustomVal(42);
        CustomVal cv3 = new CustomVal(99);
        object oc1 = cv1;
        object oc2 = cv2;
        object oc3 = cv3;

        Console.WriteLine(oc1.Equals(oc2));
        Console.WriteLine(oc1.Equals(oc3));
        Console.WriteLine(oc1.GetHashCode() == 42 * 31);
        Console.WriteLine(oc1.ToString());

        CustomBase cb = new CustomDerived();
        Console.WriteLine(cb.Equals(cb));
        Console.WriteLine("done");
    }
}
