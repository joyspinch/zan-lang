using System;
using System.Windows;

namespace Conf;

class DesktopCompanionInteractionTest {
    static void Main() {
        // 1. 活动窗口标题栏栖息：实机 Win32 前景窗口查询 + 纯函数吸附/边角折返巡逻验证
        WindowPerchSurface liveSurf = WindowPerchTracker.QueryForegroundPerch(0, 120, 40);
        bool liveCallSafe = liveSurf != null && (!liveSurf.CanPerch || liveSurf.Width >= 120);

        WindowPerchSurface simWin = WindowPerchSurface.FromRect(12345, 300, 200, 900, 700, true);
        // 宠物脚底 y = 122 + 80 = 202，落在顶边 y=200 的 ±12px 吸附带内且水平居中于窗口内 -> 可栖息
        bool attachOk = WindowPerchTracker.CanAttachToPerch(500, 122, 64, 80, 10.0f, simWin, 12);
        // 宠物向上猛跳（velY = -180）时不应立即重新粘回标题栏
        bool jumpSkipOk = !WindowPerchTracker.CanAttachToPerch(500, 122, 64, 80, -180.0f, simWin, 12);
        // 宠物在窗口右角（x=830, w=64, maxX=836）向右行走 1s（+50px/s）-> 钳制到 836 并折返向左（nextVelX < 0）
        float nextX;
        float nextVx;
        bool patrolOk = WindowPerchTracker.StepPerchPatrol(830.0f, 50.0f, 64, 1.0f, simWin, out nextX, out nextVx)
            && nextX > 835.9f && nextX < 836.1f && nextVx < -49.0f;

        bool perchOk = liveCallSafe && attachOk && jumpSkipOk && patrolOk;
        Console.WriteLine("window-titlebar-perch: " + Convert.ToString(perchOk ? 1 : 0));

        // 2. Win32 系统全局热键实机注册/去重/完整清理（使用不冲突组合 Ctrl+Alt+Shift+F12，退出前必须清空）
        GlobalHotkeyRegistry hotkeys = new GlobalHotkeyRegistry();
        uint mods = HotkeyModifiers.Control | HotkeyModifiers.Alt | HotkeyModifiers.Shift | HotkeyModifiers.NoRepeat;
        uint vkF12 = 0x7Bu;
        bool reg1 = hotkeys.Register(9001, mods, vkF12);
        bool dupBlocked = !hotkeys.Register(9001, mods, vkF12);
        bool tracked = hotkeys.IsRegistered(9001) && hotkeys.RegisteredCount == 1;
        hotkeys.UnregisterAll();
        bool cleaned = !hotkeys.IsRegistered(9001) && hotkeys.RegisteredCount == 0;
        bool hotkeyOk = reg1 && dupBlocked && tracked && cleaned;
        Console.WriteLine("global-hotkey-registry: " + Convert.ToString(hotkeyOk ? 1 : 0));

        // 3. 桌宠气泡队列：分类防刷冷却 + 高优抢占低优闲聊 + 打字机进度 + 顶边自动翻折防裁切
        CompanionSpeechQueue q = new CompanionSpeechQueue();
        q.CharsPerSecond = 20.0f;
        bool e1 = q.Enqueue("idle", "Hello world!", SpeechPriority.Ambient, 4000, 5000, 1000);
        // 同分类 2 秒后触发被 5 秒冷却拦截
        bool e2Cooldown = !q.Enqueue("idle", "Spam!", SpeechPriority.Ambient, 4000, 5000, 3000);
        // 打字机 250ms 推进 -> 20 * 0.25 = 5 字符
        int chars250 = q.VisibleCharCount(1250);
        // 番茄钟高优提醒立即抢占当前低优闲聊
        bool e3Preempt = q.Enqueue("pomodoro", "Time for a break!", SpeechPriority.Alert, 3000, 1000, 1500);
        bool alertActive = q.Active != null && q.Active.Category == "pomodoro";
        // 同级普通互动消息进入等待队列，在提醒结束后自动弹出
        q.Enqueue("pet", "Purr~", SpeechPriority.Interaction, 2000, 0, 1600);
        SpeechBubbleItem afterAlert = q.Update(4600);
        bool nextPopped = afterAlert != null && afterAlert.Category == "pet";

        // 宠物紧贴屏幕左上角（anchorTopY=20，上方装不下 60px 气泡）-> 自动翻折到宠物下方（outY = anchorBottomY + gap = 110）且 X 钳制到 workLeft=0
        int bx;
        int by;
        CompanionSpeechQueue.ClampBubbleToWorkArea(30, 20, 100, 180, 60, 10, 0, 0, 1920, 1040, out bx, out by);
        bool clampOk = bx == 0 && by == 110;

        bool speechOk = e1 && e2Cooldown && chars250 == 5 && e3Preempt && alertActive && nextPopped && clampOk;
        Console.WriteLine("companion-speech-queue-clamp: " + Convert.ToString(speechOk ? 1 : 0));
    }
}
