// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。
using System;

class Counter {
    private int backing = 10;
    public int Value { get { return backing; } set { backing = value; } }
    public static int Total { get; set; } = 7;
    public static int ReadOnly { get { return 5; } }
    private static int base2 = 3;
    public static int Custom { get { return base2 + 1; } set { base2 = value; } }

    public void Run() {
        Value = 100;                       // bare-name instance write
        Console.WriteLine("write=" + Convert.ToString(Value));
        Value++;                           // bare-name instance read+write
        Console.WriteLine("inc=" + Convert.ToString(Value));
        Console.WriteLine("static=" + Convert.ToString(Total));
        Console.WriteLine("ro=" + Convert.ToString(ReadOnly));
        Console.WriteLine("custom=" + Convert.ToString(Custom));
        Custom = 40;
        Console.WriteLine("after=" + Convert.ToString(base2));
    }
}

class Program {
    static void Main() {
        Counter c = new Counter();
        c.Run();
    }
}
