using System;
using Gui;

// The UI dispatch queue grows instead of refusing work. It used to be a fixed
// 1024-entry ring whose overflow returned false -- and both Zan callers
// (App.Post, UiEvent.Post) discard that answer, so a burst of posts that
// outran one frame's drain meant handlers that simply never ran. Post far past
// the original capacity without draining, then drain and count.

class Program {
    static int ran;

    static void Handler() { Program.ran = Program.ran + 1; }

    static int Drain() {
        int n = 0;
        Action a = Dispatcher.Take();
        while (a != null) {
            a();
            n = n + 1;
            a = Dispatcher.Take();
        }
        return n;
    }

    static void Main() {
        int posted = 0;
        for (int i = 0; i < 5000; i = i + 1) {
            if (Dispatcher.Post(Handler)) { posted = posted + 1; }
        }
        Console.WriteLine("posted: " + Convert.ToString(posted));
        Console.WriteLine("drained: " + Convert.ToString(Program.Drain()));
        Console.WriteLine("ran: " + Convert.ToString(Program.ran));

        // A clear empties the grown ring, and it keeps serving afterwards.
        for (int i = 0; i < 3000; i = i + 1) { Dispatcher.Post(Handler); }
        Dispatcher.Clear();
        Console.WriteLine("cleared: " + Convert.ToString(Program.Drain()));

        Program.ran = 0;
        for (int i = 0; i < 2000; i = i + 1) { Dispatcher.Post(Handler); }
        Console.WriteLine("reuse: " + Convert.ToString(Program.Drain()));
    }
}
