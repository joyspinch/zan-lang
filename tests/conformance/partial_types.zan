// Conformance: partial classes/structs merged across declarations.
using System;

partial class Widget {
    public int width;

    public int Area() { return width * height; }
}

partial class Widget {
    public int height;

    public string Describe() {
        return Convert.ToString(width) + "x" + Convert.ToString(height);
    }
}

partial struct Point {
    public int x;
}

partial struct Point {
    public int y;

    public int Sum() { return x + y; }
}

partial class Outer {
    public partial class Inner {
        public int v;

        public int Get() { return v; }
    }
}

partial class Outer {
    public partial class Inner {
        public void Set(int x) { v = x; }
    }
}

class Program {
    static void Main() {
        Widget w = new Widget();
        w.width = 4;
        w.height = 5;
        Console.WriteLine(w.Area());
        Console.WriteLine(w.Describe());

        Point p;
        p.x = 2;
        p.y = 9;
        Console.WriteLine(p.Sum());

        // Nested partial parts merge the same way (the member-position
        // `partial` keyword is contextual, like the top-level one): after
        // the nested types are hoisted to unit level both parts land on
        // one Inner with both members.
        Outer.Inner o = new Outer.Inner();
        o.Set(41);
        Console.WriteLine(o.Get() + 1);
    }
}
