using System;

// Console.Clear and Console.ResetColor write ANSI sequences. The golden next
// to this case carries the raw bytes: ESC [ 2 J ESC [ H for Clear and
// ESC [ 0 m for ResetColor.
class Program {
    static void Main() {
        Console.Write("before");
        Console.Clear();
        Console.ResetColor();
        Console.WriteLine("after");
    }
}
