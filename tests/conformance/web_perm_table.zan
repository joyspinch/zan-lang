// Role x route access rights over shared memory, keyed by mixing the route hash
// the request already computed with the numeric role id.
using System;
using System.Web;

class Program {
    static void Main() {
        PermTable perms = PermTable.Create("zan.test.perms", 1024);
        if (perms == null) {
            Console.WriteLine("create failed");
            return;
        }

        int list = RouteTable.Key("GET", "/user/list");
        int save = RouteTable.Key("POST", "/user/save");
        int drop = RouteTable.Key("POST", "/user/delete");

        perms.Grant(7, "GET", "/user/list");
        perms.Grant(7, "POST", "/user/save");
        perms.Grant(9, "GET", "/user/list");
        // Finer rights than allow/deny: bit 1 read, bit 2 write, bit 4 delete.
        perms.SetMask(3, drop, 7);
        Console.WriteLine("rows " + Convert.ToString(perms.Count()));

        Console.WriteLine("role7 list " + Convert.ToString(perms.Allow(7, list)) +
            " save " + Convert.ToString(perms.Allow(7, save)) +
            " delete " + Convert.ToString(perms.Allow(7, drop)));
        Console.WriteLine("role9 list " + Convert.ToString(perms.Allow(9, list)) +
            " save " + Convert.ToString(perms.Allow(9, save)));
        // No grant at all for this role.
        Console.WriteLine("role1 list " + Convert.ToString(perms.Allow(1, list)));

        Console.WriteLine("role3 mask " + Convert.ToString(perms.Mask(3, drop)) +
            " read " + Convert.ToString(perms.Can(3, drop, 1)) +
            " delete " + Convert.ToString(perms.Can(3, drop, 4)) +
            " export " + Convert.ToString(perms.Can(3, drop, 8)));

        perms.Revoke(7, save);
        Console.WriteLine("after revoke role7 save " +
            Convert.ToString(perms.Allow(7, save)) +
            " list " + Convert.ToString(perms.Allow(7, list)));

        // A grant for one route must not answer for another route of the same
        // role, nor for another role of the same route.
        Console.WriteLine("cross route " + Convert.ToString(perms.Allow(7, drop)) +
            " cross role " + Convert.ToString(perms.Allow(8, list)));

        perms.Destroy();
    }
}
