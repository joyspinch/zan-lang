using System;

// RandomNumberGenerator.Fill 容量守卫契约：count 超过 buf.Length 必须显式
// 抛错——此前直传 OS CSPRNG（RtlGenRandom / /dev/urandom fread），超容量
// 即原生越界写（byte[1] + Fill(buf,64) 写 64 字节）。
//
// 覆盖的判定点：
//   - Fill(new byte[1], 64) 抛 ArgumentException；
//   - Fill(null, 4) / Fill(buf, 0) / Fill(buf, -1) 按失败契约返回 0；
//   - Fill(new byte[16], 16) 返回 16 且确实写入了非全零随机数据；
//   - GetBytes(16) 回归：返回 17 字节缓冲（含 NUL 哨兵位）。
class RngFillBoundsProbe {
    static string Caught(Func<int> body) {
        try {
            int got = body();
            return "returned " + got;
        } catch (ArgumentException) {
            return "ArgumentException";
        } catch (Exception e) {
            return "other:" + e.GetType().Name;
        }
    }

    static void Main() {
        byte[] tiny = new byte[1];
        Console.WriteLine("over-capacity " + Caught(() => RandomNumberGenerator.Fill(tiny, 64)));

        byte[] buf = new byte[16];
        Console.WriteLine("null " + Caught(() => RandomNumberGenerator.Fill(null, 4)));
        Console.WriteLine("zero " + Caught(() => RandomNumberGenerator.Fill(buf, 0)));
        Console.WriteLine("negative " + Caught(() => RandomNumberGenerator.Fill(buf, -1)));

        int got = RandomNumberGenerator.Fill(buf, 16);
        bool nonzero = false;
        for (int i = 0; i < 16; i = i + 1) {
            if (buf[i] != 0) { nonzero = true; }
        }
        Console.WriteLine("full " + got + " nonzero=" + (nonzero ? "true" : "false"));

        byte[] fromGet = RandomNumberGenerator.GetBytes(16);
        Console.WriteLine("getbytes " + (fromGet != null ? fromGet.Length : -1));
    }
}
