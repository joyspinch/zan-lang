    // 解码一个向量，比对明文长度与 FNV-1a 64。
    static void Vector(string label, string hex, int len, long fnv) {
        byte[] plain = Zstd.Decompress(Convert.FromHexString(hex));
        bool ok = plain != null && plain.Length == len && Fnv1a64(plain) == fnv;
        Check(ok, label);
    }

    // 期望抛出 ZstdException 且错误码相符。
    static bool Throws(byte[] src, ZstdError want) {
        try {
            Zstd.Decompress(src);
            return false;
        } catch (ZstdException e) {
            return e.Code == want;
        }
    }

    // TryDecompress 失败路径：返回 false、错误码相符、结果为空。
    static bool TryFails(byte[] src, ZstdError want) {
        byte[] data;
        ZstdError err;
        bool ok = Zstd.TryDecompress(src, out data, out err);
        return !ok && err == want && data == null;
    }

    static byte[] Cut(byte[] src, int keep) {
        byte[] r = new byte[keep];
        for (int i = 0; i < keep; i = i + 1) { r[i] = src[i]; }
        return r;
    }

    static void Main() {
        Vector("text", H_text(), 1170, -1010452698360265067L);
        Vector("empty", H_empty(), 0, -3750763034362895579L);
        Vector("one", H_one(), 1, -5808529385363204345L);
        Vector("binary", H_binary(), 2000, -1433933349473172005L);
        Vector("runs", H_runs(), 2700, 2556805379389582789L);
        Vector("checksum", H_checksum(), 850, -3225948987249880345L);
        Vector("nosize", H_nosize(), 640, 1846641837696123637L);
        Vector("seqrle", H_seqrle(), 600, 3775059932689452917L);
        Vector("singleseg", H_singleseg(), 30000, 4602338778658867989L);
        Vector("multiframe", H_multiframe(), 34, -85830575915879519L);
        Vector("skippable", H_skippable(), 15, 3299559446972085848L);
        Vector("treeless", H_treeless(), 151072, 4646277665837711659L);
        Vector("treeless2", H_treeless2(), 151072, 8452549198278202812L);
        Vector("rlelit", H_rlelit(), 200, -6324349056049888723L);
        Vector("seqrepeat", H_seqrepeat(), 139072, -145882950326387635L);
        Vector("seqrepeat2", H_seqrepeat2(), 151072, -8004996297563445511L);

        // 魔数判定。
        byte[] good = Convert.FromHexString(H_text());
        Check(Zstd.IsZstd(good), "iszstd-true");
        Check(!Zstd.IsZstd(Encoding.GetBytes("not zstd at all")), "iszstd-false");

        // 错误路径。
        Check(Throws(Encoding.GetBytes("not zstd at all"), ZstdError.NotZstd), "err-notzstd");
        Check(Throws(Cut(good, 4), ZstdError.Truncated), "err-truncated-header");
        Check(Throws(Cut(good, good.Length - 5), ZstdError.Truncated), "err-truncated-block");
        Check(Throws(Convert.FromHexString(H_dictid()), ZstdError.DictionaryRequired), "err-dictid");
        Check(Throws(Convert.FromHexString(H_badsum()), ZstdError.ChecksumMismatch), "err-checksum");
        Check(TryFails(Encoding.GetBytes("not zstd at all"), ZstdError.NotZstd), "try-fail-code");

        // 空输入：没有帧就没有输出，不算错误。
        Check(Zstd.Decompress(new byte[0]).Length == 0, "empty-input");

        if (bad == 0) { Console.WriteLine("zstd-decode-done"); }
    }
}
