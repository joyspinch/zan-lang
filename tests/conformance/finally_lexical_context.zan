using System;
using System.Threading.Tasks;

class FlowConstructed {
    public int value;

    public FlowConstructed() {
        try {
            goto SetValue;
        SetValue:
            value = 5;
        } finally {
        SetValue:
            value = value + 2;
        }
    }
}

class Program {
    static int token = 7;
    static int seen;

    static void ThroughReturn(bool early) {
        try {
            if (early) {
                int token = 99;
                if (token == 99) { return; }
            }
        } finally {
            seen = token;
        }
    }

    static void ThroughGoto(bool early) {
        try {
            if (early) {
                int token = 99;
                if (token == 99) { goto Done; }
            }
        } finally {
            seen = 99;
            if (token == 7) { goto ReadToken; }
            goto Done;
        ReadToken:
            seen = token;
        Done:
        }
    Done:
        return;
    }

    static int ThroughLoop() {
        int trace = 0;
        while (trace < 1) {
            try {
                int i = 0;
                while (i < 1) { return 99; }
                trace = trace + 10;
            } finally {
                trace = trace + 1;
                break;
            }
        }
        return trace;
    }

    static async Task<int> ThroughAsyncLoop() {
        int trace = 0;
        while (trace < 2) {
            try {
                int token = 99;
                while (token == 99) { return token; }
            } finally {
                await Task.Yield();
                seen = token;
                trace = trace + 1;
                continue;
            }
        }
        return trace;
    }

    static string ThroughRethrow(bool early) {
        try {
            try { throw new Exception("outer"); }
            catch (Exception) {
                try {
                    try { throw new Exception("inner"); }
                    catch (Exception) {
                        if (early) { return "lost"; }
                    }
                } finally {
                    try { throw new Exception("local"); }
                    catch (Exception ex) { seen = ex.Message.Length; }
                    throw;
                }
            }
        } catch (Exception ex) {
            return ex.Message;
        }
        return "missing";
    }

    static string ThroughForwardHandler(bool jump) {
        try {
            try {
                if (jump) { goto Done; }
            } finally {
                throw new Exception("forward handler");
            }
        } catch (Exception ex) {
            return ex.Message;
        }
    Done:
        return "missing";
    }

    static string ThroughRepeatedRethrow() {
        try {
            try { throw new Exception("retained"); }
            catch (Exception) {
                try {
                    try { } finally { throw; }
                } catch (Exception ex) { seen = ex.Message.Length; }
                throw;
            }
        } catch (Exception ex) {
            return ex.Message;
        }
        return "missing";
    }

    static string ThroughLambdaRethrow() {
        try { throw new Exception("caller"); }
        catch (Exception) {
            Func<string> read = () => {
                try {
                    try { throw new Exception("lambda"); }
                    catch (Exception) { throw; }
                } catch (Exception ex) { return ex.Message; }
                return "missing";
            };
            return read();
        }
        return "missing";
    }

    static void Main() {
        Console.WriteLine(new FlowConstructed().value);
        Console.WriteLine(ThroughForwardHandler(true));
        Console.WriteLine(ThroughRepeatedRethrow());
        Console.WriteLine(ThroughLambdaRethrow());
        Console.WriteLine(ThroughRethrow(false));
        Console.WriteLine(ThroughRethrow(true));
        ThroughReturn(false); Console.WriteLine(seen);
        ThroughReturn(true); Console.WriteLine(seen);
        ThroughGoto(false); Console.WriteLine(seen);
        ThroughGoto(true); Console.WriteLine(seen);
        Console.WriteLine(ThroughLoop());
        Console.WriteLine(await ThroughAsyncLoop());
        Console.WriteLine(seen);
    }
}
