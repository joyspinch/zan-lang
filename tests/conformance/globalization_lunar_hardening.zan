using System;
using System.Globalization;

class Program {
    static void Main() {
        // 1. Lunar conversion for Spring Festival 2024 (2024-02-10)
        LunarDate d2024 = Lunar.FromSolar(2024, 2, 10);
        Console.WriteLine("year=" + d2024.Year());
        Console.WriteLine("month=" + d2024.Month());
        Console.WriteLine("day=" + d2024.Day());
        Console.WriteLine("is_leap=" + d2024.IsLeapMonth());
        Console.WriteLine("ganzhi_year=" + d2024.YearGanZhi());
        Console.WriteLine("zodiac=" + d2024.Zodiac());
        Console.WriteLine("month_name=" + d2024.MonthName());
        Console.WriteLine("day_name=" + d2024.DayName());
        Console.WriteLine("full_str=" + d2024.ToString());

        // 2. Leap Month test (2023 Leap Month 2: 2023-03-22 -> 闰二月初一)
        LunarDate dLeap = Lunar.FromSolar(2023, 3, 22);
        Console.WriteLine("leap_month_name=" + dLeap.MonthName());
        Console.WriteLine("leap_is_leap=" + dLeap.IsLeapMonth());

        // 3. Solar Term (2024-02-04 -> 立春)
        string term = Lunar.SolarTerm(2024, 2, 4);
        Console.WriteLine("term_lichun=" + term);

        string nonTerm = Lunar.SolarTerm(2024, 2, 5);
        Console.WriteLine("non_term_len=" + nonTerm.Length);

        // 4. GanZhi & Animal calculation
        Console.WriteLine("gan_0=" + Lunar.GanName(0) + " zhi_0=" + Lunar.ZhiName(0));
        Console.WriteLine("animal_dragon=" + Lunar.AnimalName(4));

        // 5. Day GanZhi
        string dayGz = Lunar.DayGanZhi(2024, 2, 10);
        Console.WriteLine("day_ganzhi=" + dayGz);

        // 6. Lang localization
        Console.WriteLine("lang_initial=" + Lang.Code());
        Lang.Set("zh");
        Console.WriteLine("lang_code=" + Lang.Code());
        string tr1 = Lang.Tr("Cancel", "取消");
        Console.WriteLine("lang_tr_default=" + tr1);
        Lang.Set("");
        string trSource = Lang.Tr("OK", "确定");
        Console.WriteLine("lang_source=" + trSource);

        Console.WriteLine("globalization_hardening_ok");
    }
}
