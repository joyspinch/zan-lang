// Poison: generator-magic calls inside a package. Nothing references
// JsonBoom, so the parent never pulls it; if the package ever leaks into
// the generator child's closure it breaks the compile there.
namespace JsonBoom;

using System;
using System.Json;

public static class Boom {
    public static string Bang() {
        var xs = new List<int>();
        xs.Add(1);
        return Json.Serialize<List<int>>(xs);
    }
}
