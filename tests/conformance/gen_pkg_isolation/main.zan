// 核心契约与语义定义。
using System;
using System.Json;

class Point {
    public int x;
    public int y;
}

class App {
    static int Main() {
        Point p = new Point();
        p.x = 3;
        p.y = 4;
        string s = Json.Serialize<Point>(p);
        Console.WriteLine(s);
        Point q = Json.Deserialize<Point>(s);
        Console.WriteLine(q.x + q.y);
        return 0;
    }
}
