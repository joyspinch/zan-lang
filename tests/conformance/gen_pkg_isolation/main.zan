// Conformance: the nested code-generator build must not inherit user
// packages. Json.Serialize<T> / Json.Deserialize<T> are lowered only in
// the parent compile; under --no-gen (the generator child) they cannot
// resolve, so a package file leaking into that closure fails every
// generator-triggering compile (genrun passes --no-packages for this).
using System;
using System.Json;

class Point {
    public int x;
    public int y;
}

class App {
    static int Main() {
        Point p = new Point();
        p.x = 3;
        p.y = 4;
        string s = Json.Serialize<Point>(p);
        Console.WriteLine(s);
        Point q = Json.Deserialize<Point>(s);
        Console.WriteLine(q.x + q.y);
        return 0;
    }
}
