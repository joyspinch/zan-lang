using System;

class Program {
    static int calls = 0;
    static int failures = 0;
    static string current = "fixture";

    static void Check(bool valid, string name) {
        Console.WriteLine((valid ? "ok " : "FAIL ") + name);
        if (!valid) { failures = failures + 1; }
    }

    static async string Read(string suffix) {
        calls = calls + 1;
        await Task.Delay(1);
        // Each call returns an owned allocation; literal strings hide missing
        // releases because their reference counts are immortal.
        return "fix" + suffix;
    }

    static async string Mutate(string suffix) {
        calls = calls + 1;
        await Task.Delay(1);
        current = "changed";
        return "fix" + suffix;
    }

    static async int Main() {
        string value = "fixture";
        Check(value.Length > 0 && await Read("ture") == value,
            "short circuit awaited string equality");
        Check(value.Length > 0 && value == await Read("ture"),
            "awaited right string equality");
        Check(false || await Read("ture") != "different",
            "short circuit awaited string inequality");
        Check(true && await Read("a") < "fixb",
            "awaited string less than");
        Check(true && await Read("a") <= "fixa",
            "awaited string less than or equal");
        Check(true && await Read("b") > "fixa",
            "awaited string greater than");
        Check(true && await Read("b") >= "fixb",
            "awaited string greater than or equal");
        Check(true && await Read("ture") + "!" == "fixture!",
            "awaited string concatenation consumes result");
        Check(true && (true ? await Read("ture") : await Read("other")) == value,
            "conditional awaited string result");
        Check(true && await Read("ture") == await Read("ture"),
            "both awaited string operands preserve results");
        Check(true && current == await Mutate("ture"),
            "left value snapshots before awaited right operand");
        Check(current == "changed", "awaited right operand mutates source");
        Check(calls == 12, "live arms invoke each producer once");
        int before = calls;
        Check(!(false && await Read("dead") == value), "and skips await");
        Check(true || await Read("dead") == value, "or skips await");
        Check(calls == before, "dead arms never invoke async producer");
        Console.WriteLine("failures=" + Convert.ToString(failures));
        return failures;
    }
}
