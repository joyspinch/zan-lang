using System;

// 回归锁：`Binding<T> b = <T 表达式>` 的局部声明初始化必须与赋值语句
// 同语义——字段左值降级为活绑定，其他表达式包成常量绑定。此前只有
// 赋值路径（comp.prop = user.name）做这个 lowering，声明路径把裸值
// 直接存进 Binding 槽，首次 Get/Set 解引用裸指针即段错误。
class Model {
    string name = "seed";
    int n = 5;
}

class Program {
    static void Main() {
        Model m = new Model();
        // 活绑定：字段左值
        Binding<string> s = m.name;
        Console.WriteLine(s.Get());
        s.Set("written");
        Console.WriteLine(m.name);
        // 活绑定：int
        Binding<int> i = m.n;
        Console.WriteLine(Convert.ToString(i.Get()));
        i.Set(42);
        Console.WriteLine(Convert.ToString(m.n));
        // 常量绑定：非 lvalue 表达式
        Binding<string> c = "const" + "!";
        Console.WriteLine(c.Get());
        c.Set("still-const");
        Console.WriteLine(c.Get());
        // null 解绑
        Binding<string> z = m.name;
        z = null;
        Console.WriteLine(Convert.ToString(z == null));
        // null 字面量在赋值侧同样解绑（既有语义不回归）
        Binding<string> w;
        w = m.name;
        w = null;
        Console.WriteLine(Convert.ToString(w == null));
    }
}
