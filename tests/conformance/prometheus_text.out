---
# HELP http_requests_total Total HTTP requests.
# TYPE http_requests_total counter
http_requests_total 8
http_requests_total{method="GET"} 10
http_requests_total{method="POST"} 2
# HELP heap_bytes Current heap size in bytes.
# TYPE heap_bytes gauge
heap_bytes 1048576
# HELP latency_us Latency in microseconds.
# TYPE latency_us histogram
latency_us_bucket{le="10",route="/api"} 1
latency_us_bucket{le="50",route="/api"} 2
latency_us_bucket{le="100",route="/api"} 4
latency_us_bucket{le="+Inf",route="/api"} 3
latency_us_sum{route="/api"} 587
latency_us_count{route="/api"} 3
---
ok help
ok type-counter
ok counter-sum
ok counter-label-get
ok counter-label-post
ok type-gauge
ok gauge-int-nodot
ok type-hist
ok hist-b1
ok hist-b2
ok hist-b3
ok hist-inf
ok hist-sum
ok hist-count
ok escape
ok clean-name
# TYPE badname gauge
badname 42
ok fmt-nan
ok fmt-int
ok empty-registry
prometheus-done
