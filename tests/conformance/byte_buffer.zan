using System;
using System.Security.Cryptography;

/// byte[] as the owned byte buffer: zero-initialised, length-carrying, usable
/// as a `char*` at an extern boundary, and convertible to/from string without
/// the "calloc returns a string" idiom.
class Program {
    [DllImport("crt")] static extern long strlen(string s);

    static int Checksum(string buf, int len) {
        int t = 0; int i = 0;
        while (i < len) { t = (t + (buf[i] & 255)) & 65535; i = i + 1; }
        return t;
    }

    static void Main() {
        byte[] b = new byte[4];
        Console.WriteLine(b.Length);
        Console.WriteLine(b[0] + b[1] + b[2] + b[3]);
        b[0] = 65; b[1] = 66; b[2] = 200;
        Console.WriteLine(b[2]);
        Console.WriteLine(strlen(b));
        Console.WriteLine(Checksum(b, 4));

        Span<byte> s = b.AsSpan(1, 2);
        Console.WriteLine(s.Length);
        Console.WriteLine(s[0]);
        s[1] = 67;
        Console.WriteLine(b[2]);

        byte[] h = "hello".ToBytes();
        Console.WriteLine(h.Length);
        Console.WriteLine(h.ToStr());
        Console.WriteLine(h.ToStr(1, 3));
        h[0] = 72;
        Console.WriteLine(h.ToStr() + "!");

        byte[] nul = new byte[3];
        nul[0] = 65; nul[2] = 66;
        Console.WriteLine(nul.ToStr(0, 3).Length);

        // AES-CBC through the byte[] buffers.
        string key = Hex.Decode("000102030405060708090a0b0c0d0e0f");
        string iv = Hex.Decode("101112131415161718191a1b1c1d1e1f");
        string pt = "byte buffers, not strings";
        List<int> encLen = new List<int>(); encLen.Add(0);
        byte[] ct = Aes.EncryptCbc(key, 16, iv, pt, pt.Length, encLen);
        Console.WriteLine(ct.Length);
        Console.WriteLine(encLen[0]);
        List<int> decLen = new List<int>(); decLen.Add(0);
        byte[] back = Aes.DecryptCbc(key, 16, iv, ct, encLen[0], decLen);
        Console.WriteLine(decLen[0]);
        Console.WriteLine(back.ToStr(0, decLen[0]));

        // Repeated allocation stays leak-free under --check-leaks.
        int total = 0;
        int i = 0;
        while (i < 200) {
            byte[] tmp = "payload".ToBytes();
            tmp[0] = 80;
            total = total + tmp.ToStr().Length;
            i = i + 1;
        }
        Console.WriteLine(total);
    }
}
