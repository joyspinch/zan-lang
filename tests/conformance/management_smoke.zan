// Management family smoke test: every class must compile and return sane
// values without crashing. Only structural invariants are asserted (no
// negative sizes, refresh rate / cores within plausible bounds, monitor
// count >= 1); exact values vary by machine and are not asserted.
using System;
using System.Management;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        // Cpu
        int cores = Cpu.LogicalCores();
        if (cores < 1 || cores > 1024) { bad = bad + 1; }
        int usage = Cpu.Usage();
        if (usage < 0 || usage > 100) { bad = bad + 1; }
        // Memory
        MemoryStatus m = Memory.GetStatus();
        if (m.totalPhys <= 0) { bad = bad + 1; }
        if (m.availPhys < 0 || m.availPhys > m.totalPhys) { bad = bad + 1; }
        // SystemInfo
        string name = SystemInfo.ComputerName();
        string user = SystemInfo.UserName();
        if (name == "" && user == "") { bad = bad + 1; }
        long uptime = SystemInfo.UptimeSeconds();
        if (uptime < 0) { bad = bad + 1; }
        // Storage
        List<DiskUsage> drives = Storage.Drives();
        if (drives.Count < 1) { bad = bad + 1; }
        DiskUsage root = Storage.Root();
        if (root.totalBytes <= 0) { bad = bad + 1; }
        // Display
        int w = Display.ScreenWidth();
        int h = Display.ScreenHeight();
        if (w <= 0 || h <= 0) { bad = bad + 1; }
        List<DisplayInfo> monitors = Display.Monitors();
        if (monitors.Count < 1) { bad = bad + 1; }
        // Power
        PowerStatus p = Power.GetStatus();
        if (p.batteryPercent < -1 || p.batteryPercent > 100) { bad = bad + 1; }
        Console.WriteLine("mgmt-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
