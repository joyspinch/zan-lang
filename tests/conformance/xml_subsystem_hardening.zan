using System;
using System.Xml;

class Program {
    static void Main() {
        // 1. Parse structured XML document
        string xml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
                   + "<!-- Document Configuration -->\n"
                   + "<config app=\"ZanEnterprise\" version=\"2.0\">\n"
                   + "  <server host=\"127.0.0.1\" port=\"8080\">\n"
                   + "    <name>Primary Gateway</name>\n"
                   + "    <description><![CDATA[Special <escaped> content & characters]]></description>\n"
                   + "  </server>\n"
                   + "  <endpoints>\n"
                   + "    <ep path=\"/api/v1\" enabled=\"true\"/>\n"
                   + "    <ep path=\"/api/v2\" enabled=\"false\"/>\n"
                   + "  </endpoints>\n"
                   + "</config>";

        XmlDocument doc = XmlDocument.Parse(xml);
        XmlNode root = doc.RootElement();
        if (root != null) {
            Console.WriteLine("root_tag=" + root.name);
            Console.WriteLine("app_attr=" + root.Attr("app"));
            Console.WriteLine("version_attr=" + root.Attr("version"));

            // 2. Child nodes navigation
            XmlNode server = root.Element("server");
            if (server != null) {
                Console.WriteLine("server_host=" + server.Attr("host"));
                Console.WriteLine("server_port=" + server.Attr("port"));
                Console.WriteLine("server_fallback=" + server.AttrOr("timeout", "3000"));

                XmlNode sname = server.Element("name");
                if (sname != null) {
                    Console.WriteLine("server_name=" + sname.InnerText());
                }

                XmlNode sdesc = server.Element("description");
                if (sdesc != null) {
                    Console.WriteLine("server_desc=" + sdesc.InnerText());
                }
            }

            // 3. List of elements
            XmlNode endpoints = root.Element("endpoints");
            if (endpoints != null) {
                List<XmlNode> epList = endpoints.Elements("ep");
                Console.WriteLine("endpoints_count=" + epList.Count);
                for (int i = 0; i < epList.Count; i = i + 1) {
                    Console.WriteLine("ep_" + i + "=" + epList[i].Attr("path") + " enabled=" + epList[i].Attr("enabled"));
                }
            }
        }

        // 4. Programmatic Node & Document construction
        XmlDocument newDoc = new XmlDocument();
        XmlNode newRoot = XmlNode.NewElement("response");
        newRoot.SetAttr("status", "200");
        newRoot.SetAttr("msg", "OK");

        XmlNode body = XmlNode.NewElement("data");
        body.AddChild(XmlNode.NewCdata("raw-payload-data"));
        newRoot.AddChild(body);

        newDoc.children.Add(newRoot);

        string compact = newDoc.ToXml();
        Console.WriteLine("compact_xml=" + compact);

        // 5. Parse back programmatic XML
        XmlDocument reparsed = XmlDocument.Parse(compact);
        XmlNode rRoot = reparsed.RootElement();
        if (rRoot != null) {
            Console.WriteLine("reparsed_status=" + rRoot.Attr("status"));
            XmlNode rdata = rRoot.Element("data");
            if (rdata != null) {
                Console.WriteLine("reparsed_data=" + rdata.InnerText());
            }
        }

        // 6. Exception handling for malformed XML
        bool errorCaught = false;
        try {
            XmlDocument.Parse("<unclosed_tag><child></unclosed_tag>");
        } catch (XmlException ex) {
            errorCaught = true;
        }
        Console.WriteLine("malformed_caught=" + errorCaught);

        Console.WriteLine("xml_hardening_ok");
    }
}
