// C#-style comma declarators on member fields: `int a, b = 7, c;` lowers to
// one independent field per name, all sharing the declared type and the
// modifier list (instance or static). Regression: the parser used to accept
// only one declarator per field declaration ("expected ';', got ','"),
// which blocked ordinary declarations like `int imgW, imgH;`.
using System;

class Rec {
    int a, b = 7, c;
    static int s1 = 2, s2;
    bool f1, f2 = true;
    List<int> l1, l2;

    int Sum() { return this.a + this.b; }

    static void Main() {
        Rec r = new Rec();
        r.a = 3;
        r.c = r.Sum();
        Console.WriteLine(Convert.ToString(r.c));
        Console.WriteLine(Convert.ToString(Rec.s1 + Rec.s2));
        Console.WriteLine(Convert.ToString(r.f2 ? 1 : 0));
        Console.WriteLine(Convert.ToString(r.f1 ? 1 : 0));
        Console.WriteLine(Convert.ToString(r.l1 == null ? 0 : r.l1.Count));
        Console.WriteLine(Convert.ToString(r.l2 == null ? 0 : r.l2.Count));
    }
}
