// Dict as a class FIELD: indexer read/write (including read-modify-write),
// Add/ContainsKey/Remove/Clear/Count/Keys must all work — the compiler used to
// only route these through the dict lowering for local variables; a field
// receiver fell into the generic array path (a string key became a GEP index
// -> "GEP indexes must be integers" at codegen) or was rejected at check time.
using System;

namespace Conf;

class Bag {
    Dictionary<string, int> map = new Dictionary<string, int>();

    void Put(string k, int v) { map[k] = v; }
    int Get(string k) { return map[k]; }
    void Add(string k, int v) { map.Add(k, v); }
    bool Has(string k) { return map.ContainsKey(k); }
    void Del(string k) { map.Remove(k); }
    int Size() { return map.Count; }
    void Wipe() { map.Clear(); }

    static void Main() {
        int bad = 0;
        Bag b = new Bag();
        // Indexer write on an implicit-this field.
        b.Put("a", 1);
        // Read-modify-write on a field.
        b.Put("a", b.Get("a") + 1);
        if (b.Get("a") != 2) { bad = bad + 1; }
        // Method calls on a field receiver.
        b.Add("b", 10);
        if (!b.Has("b")) { bad = bad + 1; }
        if (b.Size() != 2) { bad = bad + 1; }
        // Explicit obj.field indexer write (Main has no this-context for it).
        Bag c = new Bag();
        c.map["x"] = 42;
        if (c.map["x"] != 42) { bad = bad + 1; }
        if (c.map.Count != 1) { bad = bad + 1; }
        // Keys snapshot on a field.
        List<string> ks = c.map.Keys;
        if (ks.Count != 1 || ks[0] != "x") { bad = bad + 1; }
        // Remove + Clear on a field.
        b.Del("a");
        if (b.Has("a")) { bad = bad + 1; }
        b.Wipe();
        if (b.Size() != 0) { bad = bad + 1; }
        Console.WriteLine("dict-field-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
