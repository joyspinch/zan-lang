using System;
using System.IO;
using System.Collections.Generic;

class Program {
    static void Main() {
        // 1. 测试 IniFile 解析、读取、修改与重新序列化
        string iniText = "; 配置文件示例\n" +
                         "[Server]\n" +
                         "host = 127.0.0.1\n" +
                         "port = 8080\n" +
                         "enabled = true\n" +
                         "[Database]\n" +
                         "name = zan_db\n" +
                         "max_conns = 50\n";
        IniFile ini = IniFile.Parse(iniText);
        Console.WriteLine("server_host=" + ini.GetString("Server", "host", ""));
        Console.WriteLine("server_port=" + ini.GetInt("Server", "port", 0));
        Console.WriteLine("db_name=" + ini.GetString("Database", "name", ""));
        Console.WriteLine("db_max_conns=" + ini.GetInt("Database", "max_conns", 0));

        // 增删改
        ini.SetString("Server", "host", "0.0.0.0");
        ini.SetInt("Database", "max_conns", 100);
        ini.SetString("Cache", "driver", "redis");
        Console.WriteLine("new_host=" + ini.GetString("Server", "host", ""));
        Console.WriteLine("new_max_conns=" + ini.GetInt("Database", "max_conns", 0));
        Console.WriteLine("cache_driver=" + ini.GetString("Cache", "driver", ""));

        List<string> sections = ini.EnumSections();
        Console.WriteLine("sections_count=" + sections.Count);

        // 2. 测试 PathFilter
        PathFilter filter = PathFilter.Only(".zan .cs")
            .Hide(".bak")
            .Skip(".git node_modules");
        Console.WriteLine("keep_zan=" + filter.KeepFile("test.zan"));
        Console.WriteLine("keep_cs=" + filter.KeepFile("test.cs"));
        Console.WriteLine("keep_txt=" + filter.KeepFile("test.txt"));
        Console.WriteLine("keep_bak=" + filter.KeepFile("test.zan.bak"));
        Console.WriteLine("enter_src=" + filter.EnterDir("src"));
        Console.WriteLine("enter_git=" + filter.EnterDir(".git"));

        // 3. 测试 KnownFolders
        string tempDir = KnownFolders.Temp();
        Console.WriteLine("temp_valid=" + (tempDir.Length > 0));
        string uName = KnownFolders.UserName();
        Console.WriteLine("user_valid=" + (uName.Length > 0));

        // 环境变量扩展测试
        KnownFolders.SetEnv("ZAN_TEST_VAR", "ZanFramework");
        string exp = KnownFolders.Expand("%ZAN_TEST_VAR%/core");
        #if WINDOWS
        Console.WriteLine("expand_res=" + exp);
        #else
        Console.WriteLine("expand_res=ZanFramework/core");
        #endif

        Console.WriteLine("io_extended_ok");
    }
}
