using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Threading;

class Program {
    static async Task<int> RunAsyncTest() {
        List<string> args = new List<string>();
        args.Add("/c");
        args.Add("echo async_diagnostics_ok");
        ProcessResult r = await Process.CaptureSafeAsync("cmd.exe", args);
        if (r == null || !r.Ok()) { return 0; }
        return r.Text().Contains("async_diagnostics_ok") ? 1 : 0;
    }

    static void Main() {
        int selfPid = ProcessList.SelfPid();
        Console.WriteLine("selfPid_valid=" + (selfPid > 0));

        bool running = ProcessControl.IsRunning(selfPid);
        Console.WriteLine("self_running=" + running);

        int prio = ProcessControl.GetPriority(selfPid);
        Console.WriteLine("prio_valid=" + (prio >= 0 && prio <= 5));

        ProcessEntry entry = ProcessList.ByPid(selfPid);
        bool entryOk = entry != null && entry.pid == selfPid && entry.threads > 0;
        Console.WriteLine("entry_ok=" + entryOk);

        string quoted = Process.QuoteArg("hello world");
        Console.WriteLine("quoted_ok=" + (quoted == "\"hello world\""));

        List<string> args = new List<string>();
        args.Add("/c");
        args.Add("echo safe_diagnostics_ok");
        string cmdline = Process.BuildCommandLine("cmd.exe", args);
        Console.WriteLine("cmdline_ok=" + cmdline.Contains("echo"));

        ProcessResult res = Process.CaptureSafe("cmd.exe", args, 5000);
        Console.WriteLine("res_ok=" + (res != null && res.Ok()));
        Console.WriteLine("res_text_ok=" + (res != null && res.Text().Contains("safe_diagnostics_ok")));
        Console.WriteLine("res_lines_ok=" + (res != null && res.Lines() != null && res.Lines().Count > 0));

        int asyncVal = await RunAsyncTest();
        Console.WriteLine("async_ok=" + (asyncVal == 1));

        Console.WriteLine("process-lifecycle-ok: 1");
    }
}
