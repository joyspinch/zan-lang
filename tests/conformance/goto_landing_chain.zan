using System;

class Program {
    static int finCount;
    static string log;

    static void Fin(string tag) {
        finCount = finCount + 1;
        log = log + tag;
    }

    // goto skips: inner finally B, outer finally C, and the lock's monitor
    // exit -- all three must run on the landing chain before out1.
    static int SkipThree(object o) {
        int x = 1;
        lock (o) {
            try {
                try {
                    x = x + 1;
                    Fin("A");
                    goto out1;
                    x = 100;
                } finally {
                    Fin("B");
                }
            } finally {
                Fin("C");
            }
        }
        x = 300;
    out1:
        return x + 5;
    }

    // goto out of a catch body: the caught exception's release is skipped by
    // the jump, the landing chain must release it.
    static int OutOfCatch() {
        int x = 0;
        try {
            throw new Exception("e1");
        } catch (Exception e) {
            x = 1;
            goto out2;
        }
        x = 2;
    out2:
        return x + 10;
    }

    static int Main() {
        finCount = 0;
        log = "";
        int r = SkipThree(new Program());
        Console.WriteLine("fin=" + finCount + " log=" + log + " r=" + r);
        if (finCount != 3 || log != "ABC" || r != 7) return 1;
        int c = OutOfCatch();
        Console.WriteLine("c=" + c);
        if (c != 11) return 2;
        return 0;
    }
}
