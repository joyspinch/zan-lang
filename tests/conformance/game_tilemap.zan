using System;
using System.Collections.Generic;
using Game.Arcade2D;
using Game.Tilemap;

namespace Tests.GameTilemap;

class Program {
    static int Main() {
        // 1. 测试手动网格
        TileLayer layer = new TileLayer("main", 4, 3, 16);
        layer.SetTile(0, 0, 1);
        layer.SetTile(1, 0, 1);
        layer.SetTile(2, 0, 1); // 第一行 (0,0)-(2,0) 为连续实心瓦片

        layer.SetTile(1, 2, 2); // 第三行 (1,2) 单个实心瓦片

        Console.WriteLine("tile_0_0=" + layer.GetTile(0, 0));
        Console.WriteLine("tile_3_0=" + layer.GetTile(3, 0));

        // 2. 坐标与网格转换
        int col = layer.WorldToCol(24.0); // 24 / 16 = 1
        int row = layer.WorldToRow(35.0); // 35 / 16 = 2
        Console.WriteLine("world_to_grid=" + col + "," + row);

        double wx = layer.ColToWorldX(2);
        double wy = layer.RowToWorldY(1);
        Console.WriteLine("grid_to_world=" + (int)wx + "," + (int)wy);

        // 3. 提取碰撞体（水平合并）
        List<Rect2> colliders = layer.ExtractColliders(1);
        Console.WriteLine("solid_1_colliders_count=" + colliders.Count);
        if (colliders.Count > 0) {
            Rect2 c0 = colliders[0];
            // 3个16宽的瓦片合并为宽48的矩形
            Console.WriteLine("c0_rect=" + (int)c0.X() + "," + (int)c0.Y() + "," + (int)c0.Width() + "," + (int)c0.Height());
        }

        // 4. CSV 数据解析测试
        string csv = "1,1,0,0\n0,1,1,1\n0,0,0,1";
        TileLayer csvLayer = new TileLayer("csv_layer", 4, 3, 32);
        csvLayer.LoadCsv(csv);
        Console.WriteLine("csv_w_h=" + csvLayer.Cols() + "," + csvLayer.Rows());
        Console.WriteLine("csv_t1_1=" + csvLayer.GetTile(1, 1));
        List<Rect2> csvColliders = csvLayer.ExtractColliders(1);
        // 第一行 2个合并(1个Rect)，第二行 3个合并(1个Rect)，第三行 1个(1个Rect) -> 共 3 个合并碰撞体
        Console.WriteLine("csv_colliders_count=" + csvColliders.Count);

        return 0;
    }
}
