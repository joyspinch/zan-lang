using System;

// The Console family the C host lowers member by member (src/compiler/
// irgen_call.c). The self-host used to have ONE catch-all that printed the
// first argument of every Console member, so this case pins the per-type
// rendering: string, bool, char (its UTF-8 text), double (the shortest
// round-trip form) and the no-argument forms.
class Program {
    static void Main() {
        Console.Write("a");
        Console.Write("b");
        Console.WriteLine("");
        Console.WriteLine("line");
        Console.PrintLine("print");
        Console.WriteLine(42);
        Console.WriteLine(-7);
        Console.WriteLine(3.5);
        Console.WriteLine(true);
        Console.WriteLine(false);
        Console.WriteLine('x');
        Console.WriteLine('\u4e2d');
        Console.WriteLine("end");
    }
}
