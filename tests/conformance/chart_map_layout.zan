using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

// MapLayout 纯几何：全局数据边界等比 fit、居中偏移、单/多部件环、
// 洞环、bbox、整数 point-in-polygon（含凹多边形）、命中次序
// （洞内不算命中）、确定性、空/退化输入。矩形 (0,0,200,200)
// pad=8：pw=184 ph=184；数据边界 0..50 x 0..80 →
// scale=min(3680, 2300)=2300，off=(42,8)。
class Program {
    static void Main() {
        List<ChartMapRegion> regions = new List<ChartMapRegion>{
            ChartMapRegion.Of("Square", 10, new List<ChartMapRing>{
                ChartMapRing.Of(new List<ChartMapPoint>{
                    ChartMapPoint.Of(0, 0), ChartMapPoint.Of(20, 0),
                    ChartMapPoint.Of(20, 20), ChartMapPoint.Of(0, 20) }, false) }),
            ChartMapRegion.Of("Frame", 20, new List<ChartMapRing>{
                ChartMapRing.Of(new List<ChartMapPoint>{
                    ChartMapPoint.Of(0, 40), ChartMapPoint.Of(30, 40),
                    ChartMapPoint.Of(30, 80), ChartMapPoint.Of(0, 80) }, false),
                ChartMapRing.Of(new List<ChartMapPoint>{
                    ChartMapPoint.Of(10, 50), ChartMapPoint.Of(20, 50),
                    ChartMapPoint.Of(20, 70), ChartMapPoint.Of(10, 70) }, true) }),
            ChartMapRegion.Of("Multi", 5, new List<ChartMapRing>{
                ChartMapRing.Of(new List<ChartMapPoint>{
                    ChartMapPoint.Of(40, 0), ChartMapPoint.Of(50, 0),
                    ChartMapPoint.Of(50, 15), ChartMapPoint.Of(40, 15) }, false),
                ChartMapRing.Of(new List<ChartMapPoint>{
                    ChartMapPoint.Of(40, 25), ChartMapPoint.Of(50, 25),
                    ChartMapPoint.Of(50, 40), ChartMapPoint.Of(40, 40) }, false) }) };

        MapLayout l = MapLayout.Of(regions, 0, 0, 200, 200, 8);

        Console.WriteLine("scale:" + Convert.ToString(l.scale));
        Console.WriteLine("off:" + Convert.ToString(l.offX) + ":" + Convert.ToString(l.offY));
        Console.WriteLine("bounds:" + Convert.ToString(l.minX) + ":" + Convert.ToString(l.minY)
            + ":" + Convert.ToString(l.maxX) + ":" + Convert.ToString(l.maxY));
        Console.WriteLine("polys:" + Convert.ToString(l.polys.Count));
        Console.WriteLine("regions:" + Convert.ToString(l.regionCount));
        // 每条环：region:hole:minX:minY:maxX:maxY:cx:cy
        Console.WriteLine("p0:" + Convert.ToString(l.polys[0].region) + ":"
            + Convert.ToString(ChartConf.B(l.polys[0].hole)) + ":"
            + Convert.ToString(l.polys[0].minX) + ":" + Convert.ToString(l.polys[0].minY)
            + ":" + Convert.ToString(l.polys[0].maxX) + ":" + Convert.ToString(l.polys[0].maxY)
            + ":" + Convert.ToString(l.polys[0].cx) + ":" + Convert.ToString(l.polys[0].cy));
        Console.WriteLine("p1:" + Convert.ToString(l.polys[1].region) + ":"
            + Convert.ToString(ChartConf.B(l.polys[1].hole)) + ":"
            + Convert.ToString(l.polys[1].minX) + ":" + Convert.ToString(l.polys[1].minY)
            + ":" + Convert.ToString(l.polys[1].maxX) + ":" + Convert.ToString(l.polys[1].maxY)
            + ":" + Convert.ToString(l.polys[1].cx) + ":" + Convert.ToString(l.polys[1].cy));
        Console.WriteLine("p2:" + Convert.ToString(l.polys[2].region) + ":"
            + Convert.ToString(ChartConf.B(l.polys[2].hole)) + ":"
            + Convert.ToString(l.polys[2].minX) + ":" + Convert.ToString(l.polys[2].minY)
            + ":" + Convert.ToString(l.polys[2].maxX) + ":" + Convert.ToString(l.polys[2].maxY)
            + ":" + Convert.ToString(l.polys[2].cx) + ":" + Convert.ToString(l.polys[2].cy));
        Console.WriteLine("p3:" + Convert.ToString(l.polys[3].region) + ":"
            + Convert.ToString(ChartConf.B(l.polys[3].hole)) + ":"
            + Convert.ToString(l.polys[3].minX) + ":" + Convert.ToString(l.polys[3].minY)
            + ":" + Convert.ToString(l.polys[3].maxX) + ":" + Convert.ToString(l.polys[3].maxY)
            + ":" + Convert.ToString(l.polys[3].cx) + ":" + Convert.ToString(l.polys[3].cy));
        Console.WriteLine("p4:" + Convert.ToString(l.polys[4].region) + ":"
            + Convert.ToString(ChartConf.B(l.polys[4].hole)) + ":"
            + Convert.ToString(l.polys[4].minX) + ":" + Convert.ToString(l.polys[4].minY)
            + ":" + Convert.ToString(l.polys[4].maxX) + ":" + Convert.ToString(l.polys[4].maxY)
            + ":" + Convert.ToString(l.polys[4].cx) + ":" + Convert.ToString(l.polys[4].cy));

        // 变换后的环顶点（Square 与 Frame 洞）。
        Console.WriteLine("s0:" + Convert.ToString(l.polys[0].points[0].x) + ":"
            + Convert.ToString(l.polys[0].points[0].y) + ":"
            + Convert.ToString(l.polys[0].points[2].x) + ":"
            + Convert.ToString(l.polys[0].points[2].y));
        Console.WriteLine("h1:" + Convert.ToString(l.polys[2].points[1].x) + ":"
            + Convert.ToString(l.polys[2].points[1].y));

        // 命中：bbox + point-in-polygon，洞内不算。
        Console.WriteLine("hit:" + Convert.ToString(MapLayout.RegionAt(l, 65, 31)) + ":"
            + Convert.ToString(MapLayout.RegionAt(l, 99, 54)) + ":"
            + Convert.ToString(MapLayout.RegionAt(l, 53, 123)) + ":"
            + Convert.ToString(MapLayout.RegionAt(l, 76, 146)) + ":"
            + Convert.ToString(MapLayout.RegionAt(l, 145, 31)) + ":"
            + Convert.ToString(MapLayout.RegionAt(l, 145, 77)) + ":"
            + Convert.ToString(MapLayout.RegionAt(l, 145, 54)) + ":"
            + Convert.ToString(MapLayout.RegionAt(l, 168, 146)) + ":"
            + Convert.ToString(MapLayout.RegionAt(l, 69, 149)));
        // 外环边界稳定命中，洞边界按洞优先规则不命中，
        // 共享边的结果不随 bbox 端点变化漂移。
        Console.WriteLine("edges:" + Convert.ToString(MapLayout.RegionAt(l, 42, 31)) + ":"
            + Convert.ToString(MapLayout.RegionAt(l, 65, 123)) + ":"
            + Convert.ToString(MapLayout.RegionAt(l, 76, 123)) + ":"
            + Convert.ToString(MapLayout.RegionAt(l, 88, 146)));

        // PointInPoly 直接断言（外环/洞/凹多边形/边界外）。
        List<ChartMapPoint> LRing = new List<ChartMapPoint>{
            ChartMapPoint.Of(0, 0), ChartMapPoint.Of(20, 0), ChartMapPoint.Of(20, 10),
            ChartMapPoint.Of(10, 10), ChartMapPoint.Of(10, 20), ChartMapPoint.Of(0, 20) };
        Console.WriteLine("pip:" + Convert.ToString(ChartConf.B(
            Chart.PointInPoly(l.polys[0].points, 65, 31)
            && !Chart.PointInPoly(l.polys[0].points, 99, 54)
            && Chart.PointInPoly(l.polys[1].points, 53, 123)
            && Chart.PointInPoly(l.polys[2].points, 76, 146)
            && !Chart.PointInPoly(l.polys[2].points, 53, 123)
            && Chart.PointInPoly(l.polys[3].points, 145, 31)
            && !Chart.PointInPoly(l.polys[4].points, 145, 54)
            && Chart.PointInPoly(LRing, 5, 5)
            && !Chart.PointInPoly(LRing, 15, 15))));
        Console.WriteLine("concave:" + Convert.ToString(ChartConf.B(
            Chart.PointInPoly(LRing, 5, 5))) + ":"
            + Convert.ToString(ChartConf.B(!Chart.PointInPoly(LRing, 15, 15))));

        // 大坐标回归：边向量/叉积的中间量必须先提升到 long，
        // 否则 int 差值会在进入 PointInPoly 前溢出。
        List<ChartMapPoint> largeRing = new List<ChartMapPoint>{
            ChartMapPoint.Of(0 - 1000000000, 0 - 1000000000),
            ChartMapPoint.Of(1000000000, 0 - 1000000000),
            ChartMapPoint.Of(1000000000, 1000000000),
            ChartMapPoint.Of(0 - 1000000000, 1000000000) };
        Console.WriteLine("large:" + Convert.ToString(ChartConf.B(
            Chart.PointInPoly(largeRing, 0, 0))) + ":"
            + Convert.ToString(ChartConf.B(!Chart.PointInPoly(largeRing, 1100000000, 0))));

        // 宽例：正方形 → 两向同 1840，居中无偏移。
        List<ChartMapRegion> square = new List<ChartMapRegion>{
            ChartMapRegion.Of("S", 1, new List<ChartMapRing>{
                ChartMapRing.Of(new List<ChartMapPoint>{
                    ChartMapPoint.Of(0, 0), ChartMapPoint.Of(100, 0),
                    ChartMapPoint.Of(100, 100), ChartMapPoint.Of(0, 100) }, false) }) };
        MapLayout sq = MapLayout.Of(square, 0, 0, 200, 200, 8);
        Console.WriteLine("sq:" + Convert.ToString(sq.scale) + ":"
            + Convert.ToString(sq.offX) + ":" + Convert.ToString(sq.offY)
            + ":" + Convert.ToString(sq.polys.Count));

        // 确定性：相同输入两次调用一致。
        MapLayout l2 = MapLayout.Of(regions, 0, 0, 200, 200, 8);
        Console.WriteLine("det:" + Convert.ToString(ChartConf.B(
            l.scale == l2.scale && l.offX == l2.offX && l.offY == l2.offY
            && l.polys.Count == l2.polys.Count
            && l.polys[4].cx == l2.polys[4].cx)));

        // 空 / 退化（<3 点的环被忽略）。
        List<ChartMapRegion> none = new List<ChartMapRegion>();
        MapLayout n = MapLayout.Of(none, 0, 0, 200, 200, 8);
        Console.WriteLine("empty:" + Convert.ToString(n.scale) + ":"
            + Convert.ToString(n.polys.Count) + ":" + Convert.ToString(n.regionCount));
        List<ChartMapRegion> thin = new List<ChartMapRegion>{
            ChartMapRegion.Of("Thin", 3, new List<ChartMapRing>{
                ChartMapRing.Of(new List<ChartMapPoint>{
                    ChartMapPoint.Of(0, 0), ChartMapPoint.Of(10, 0) }, false) }) };
        MapLayout th = MapLayout.Of(thin, 0, 0, 200, 200, 8);
        Console.WriteLine("thin:" + Convert.ToString(th.scale) + ":"
            + Convert.ToString(th.polys.Count));

        // markPoint 坐标换算：图坐标系（与 rings 同一系）→ 屏幕像素，
        // 公式与环变换一致（offX + (x-minX)*scale/1000）。
        ChartMarkPoint inside = ChartMarkPoint.Point(10, 10, "hub");
        int mx = l.offX + (inside.xValue - l.minX) * l.scale / 1000;
        int my = l.offY + (inside.yValue - l.minY) * l.scale / 1000;
        // (10,10) 在 Square 外环内：屏幕坐标必须落在 Square 的 bbox 内。
        Console.WriteLine("mk:" + Convert.ToString(mx >= l.polys[0].minX
            && mx <= l.polys[0].maxX && my >= l.polys[0].minY
            && my <= l.polys[0].maxY));
        // 图坐标系外的 mark（x=-50）映射到布局最左之前。
        ChartMarkPoint outside = ChartMarkPoint.Point(0 - 50, 10, "");
        int ox2 = l.offX + (outside.xValue - l.minX) * l.scale / 1000;
        Console.WriteLine("mkOut:" + Convert.ToString(ox2 < l.offX));
    }
}

class ChartConf {
    static string B(bool v) {
        if (v) { return "1"; }
        return "0";
    }
}
