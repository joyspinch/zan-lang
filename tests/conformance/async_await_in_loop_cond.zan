using System;

/* 底层系统交互与数据协议契约 */
class Program {
    static async int One() { await Task.Delay(1); return 1; }
    static async int Three() { await Task.Delay(1); return 3; }

    static async void Main() {
        int i = 0;
        while (i < await One()) { i = i + 1; }
        Console.WriteLine("while=" + Convert.ToString(i));

        int total = 0;
        for (int k = 0; k < await Three(); k = k + await One()) {
            total = total + 10;
        }
        Console.WriteLine("for=" + Convert.ToString(total));

        int n = 0;
        do { n = n + 1; } while (n < await Three());
        Console.WriteLine("dowhile=" + Convert.ToString(n));

        int c = 0;
        int iter = 0;
        while (iter < await Three()) {
            iter = iter + 1;
            if (iter == 2) { continue; }
            c = c + 10;
        }
        Console.WriteLine("cont=" + Convert.ToString(c));

        int b = 0;
        while (b < await Three()) {
            b = b + 1;
            if (b == 2) { break; }
        }
        Console.WriteLine("brk=" + Convert.ToString(b));
    }
}
