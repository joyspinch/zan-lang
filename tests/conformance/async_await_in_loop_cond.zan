using System;

/* await in a re-evaluated loop position (while/do-while condition, for
 * condition/step): the ANF pass evaluates those expressions at statement
 * position inside the body (per-iteration `$awN` temps), so no SSA value
 * computed before the suspension is consumed by the resume block. Leaving the
 * await in the condition used to fail LLVM verification ("Instruction does
 * not dominate all uses"). break/continue must keep landing on the condition
 * re-evaluation / loop exit. */
class Program {
    static async int One() { await Task.Delay(1); return 1; }
    static async int Three() { await Task.Delay(1); return 3; }

    static async void Main() {
        int i = 0;
        while (i < await One()) { i = i + 1; }
        Console.WriteLine("while=" + Convert.ToString(i));

        int total = 0;
        for (int k = 0; k < await Three(); k = k + await One()) {
            total = total + 10;
        }
        Console.WriteLine("for=" + Convert.ToString(total));

        int n = 0;
        do { n = n + 1; } while (n < await Three());
        Console.WriteLine("dowhile=" + Convert.ToString(n));

        int c = 0;
        int iter = 0;
        while (iter < await Three()) {
            iter = iter + 1;
            if (iter == 2) { continue; }
            c = c + 10;
        }
        Console.WriteLine("cont=" + Convert.ToString(c));

        int b = 0;
        while (b < await Three()) {
            b = b + 1;
            if (b == 2) { break; }
        }
        Console.WriteLine("brk=" + Convert.ToString(b));
    }
}
