using System;
using System.Windows;

class Program {
    static int Main() {
        // 1. 跨平台路径归一化与防目录穿越安全守卫
        CompanionCrossPlatformPathResolver macPath = new CompanionCrossPlatformPathResolver(DesktopOsFamily.MacOS, "MochiPet");
        CompanionCrossPlatformPathResolver ohosPath = new CompanionCrossPlatformPathResolver(DesktopOsFamily.HarmonyOS, "MochiPet");
        string joinedMac = macPath.SafeJoin("saves", "slot1\\pet.json");
        string joinedOhos = ohosPath.SafeJoin("cache", "icons//mood.png");
        string blockedDotDot = macPath.SafeJoin("saves", "../etc/passwd");
        string blockedAbs = ohosPath.SafeJoin("saves", "/etc/shadow");
        string blockedDrive = macPath.SafeJoin("saves", "C:\\Windows\\win.ini");
        bool pathOk = joinedMac == "~/Library/Application Support/MochiPet/saves/slot1/pet.json"
            && joinedOhos == "/data/storage/el2/base/cache/MochiPet/icons/mood.png"
            && blockedDotDot == "" && blockedAbs == "" && blockedDrive == "";
        Console.WriteLine("path_resolver_ok=" + (pathOk ? "1" : "0"));

        // 2. 跨平台插电/电池/省电功耗治理策略
        CompanionPowerBatteryPolicy power = new CompanionPowerBatteryPolicy();
        int fpsAc = power.Evaluate(true, 100, false, false);
        bool acParticles = power.ParticlesEnabled;
        int fpsBat = power.Evaluate(false, 65, false, false);
        bool batNoParticles = !power.ParticlesEnabled;
        int fpsLow = power.Evaluate(false, 15, false, false);
        bool lowNoSync = !power.BackgroundSyncEnabled;
        bool powerOk = fpsAc == 60 && acParticles && fpsBat == 30 && batNoParticles && fpsLow == 10 && lowNoSync;
        Console.WriteLine("power_policy_ok=" + (powerOk ? "1" : "0"));

        // 3. 跨平台自定义协议深链解析与注入防御
        CompanionDeepLinkUriParser parser = new CompanionDeepLinkUriParser("zanpet");
        bool okGood = parser.TryParse("zanpet://feed?item=fish&qty=2");
        bool fieldsOk = parser.LastAction == "feed" && parser.LastQuery == "item=fish&qty=2";
        bool blockedScheme = !parser.TryParse("javascript://alert(1)");
        bool blockedInject = !parser.TryParse("zanpet://feed?<script>");
        bool deepLinkOk = okGood && fieldsOk && blockedScheme && blockedInject;
        Console.WriteLine("deeplink_parser_ok=" + (deepLinkOk ? "1" : "0"));
        return 0;
    }
}
