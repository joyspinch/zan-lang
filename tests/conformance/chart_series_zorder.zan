using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

/// N7 series z/zlevel 绘制序（zrender 显示列表序的静态投影）：
///   键 = zlevel*1000 + z；未声明 z 按系列型官方缺省
///   （bar/pie/scatter/graph/candlestick/custom 等 z=2，line z=3，
///   各 Series.ts）。
/// 落地：
///   ①解析：z/zlevel 声明进 cs.z/cs.zlevel，缺省随系列型；
///   ②Resolve：系列表按 ZOrder 稳定重排（同键保声明序），图例键/
///     palette/CSS series-N 下标绑定绘制序；
///   ③lead 不漂移：declOrder 快照保 LeadSeries/DispatchKind 语义在
///     声明序（官方每系列自带 view，面板主导型不随 z 漂移）；
///   ④幂等：排序两次 = 排序一次；图例隐藏不改变绘制序。
class Program {
    static string Names(ChartOption o) {
        string r = "";
        for (int i = 0; i < o.series.Count; i = i + 1) {
            r = r + o.series[i].typeName + ",";
        }
        return r;
    }

    static void Main() {
        // ① 缺省 z：bar 2 / line 3 / pie 2；clone 保真。
        ChartSeries bar = ChartSeries.Bar("b", new List<int>{1});
        ChartSeries line = ChartSeries.Line("l", new List<int>{1});
        ChartSeries pie = ChartSeries.Pie("p", new List<int>{1});
        Console.WriteLine("defaults:" + Convert.ToString(bar.z)
            + ":" + Convert.ToString(line.z) + ":" + Convert.ToString(pie.z));
        ChartSeries c1 = ChartSeries.Clone(line);
        Console.WriteLine("clone:" + Convert.ToString(c1.z)
            + ":" + Convert.ToString(c1.zlevel));

        // ② 解析 + 排序：watermark（bar z=3 ×2 + bar 缺省 + pie 缺省）
        // → pie(2) 先画，z=3 的 bar 后画压上。
        ChartOption o = ChartOption.FromJson(File.ReadAllText(
            "examples/gui_charts/options/watermark.json"));
        Console.WriteLine("wm-before:" + Conf.Program.Names(o));
        ChartView.ZSort(o);
        Console.WriteLine("wm-after:" + Conf.Program.Names(o));

        // ③ 负 z 垫底：pictorialBar-hill 两条系列（z=-10 / 缺省 2）。
        ChartOption o2 = ChartOption.FromJson(File.ReadAllText(
            "examples/gui_charts/options/pictorialBar-hill.json"));
        ChartView.ZSort(o2);
        Console.WriteLine("hill:" + Conf.Program.Names(o2));

        // ④ lead/kind 不随重排漂移（custom-bar-trend：custom z=100
        // 排到柱群后，但 lead 仍是声明序首条的 custom）。
        ChartOption o3 = ChartOption.FromJson(File.ReadAllText(
            "examples/gui_charts/options/custom-bar-trend.json"));
        string kindB = ChartView.DispatchKind(o3);
        ChartView.ZSort(o3);
        Console.WriteLine("trend:" + kindB + "->" + ChartView.DispatchKind(o3)
            + ":" + Conf.Program.Names(o3));

        // ⑤ 幂等 + wind-barb（z 2,10,1,11 → 1,2,10,11 排序恰一次）。
        ChartOption o4 = ChartOption.FromJson(File.ReadAllText(
            "examples/gui_charts/options/wind-barb.json"));
        ChartView.ZSort(o4);
        string once = Conf.Program.Names(o4);
        ChartView.ZSort(o4);
        Console.WriteLine("windbarb:" + once + " idem:"
            + Convert.ToString(once == Conf.Program.Names(o4)));
    }
}
