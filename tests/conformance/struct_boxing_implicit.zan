using System;
using System.Collections.Generic;
interface IGreet {
    string Hello();
}
struct Num : IGreet {
    public int V;
    public string Tag;
    public string Hello() {
        return "n" + V;
    }
}
struct Bare {
    public int W;
}
class Box {
    public object F;
}
class Program {
    static object MakeBare(int w) {
        Bare b = new Bare();
        b.W = w;
        return b;
    }
    static int IsNull(object o) {
        return o == null ? 1 : 0;
    }
    static int Main() {
        Num n = new Num();
        n.V = 7;
        n.Tag = "t";
        object o = n;
        Console.WriteLine(o is Num ? 1 : 0);
        Num m = (Num)o;
        Console.WriteLine(m.V + m.Tag.Length);
        IGreet g = n;
        Console.WriteLine(g.Hello());
        Box bx = new Box();
        bx.F = n;
        Console.WriteLine(((Num)bx.F).V * 10 + ((Num)bx.F).Tag.Length);
        object[] arr = new object[2];
        arr[0] = n;
        arr[1] = MakeBare(11);
        Console.WriteLine(((Bare)arr[1]).W);
        List<object> lo = new List<object>();
        lo.Add(n);
        lo.Add(MakeBare(13));
        Console.WriteLine(((Num)lo[0]).V * 100 + ((Bare)lo[1]).W);
        Console.WriteLine(IsNull(n) * 10 + IsNull(null));
        Bare bare = new Bare();
        bare.W = 5;
        object ob = bare;
        Console.WriteLine(((Bare)ob).W * 2 + (ob is Bare ? 1 : 0));
        return 0;
    }
}
