// Conformance: RadioGroup 增强 —— 自定义 value / 禁用选项 / 组级
// Value 双向绑定 / SetSelectedValue-SetSelectedIndex 静默语义 /
// SelectedIndex-IndexOfValue 越界语义 / OptionsText 往返（含元数据
// 重建）/ 按钮形态（RadioButtonGroup）同一套组 API 与尺寸档位 /
// 组级 Change 事件计数。全部无头，不依赖 App。
using System;
using Gui;
using Gui.Widget;

class RadioGroupTest {
    static int fired = 0;

    /// 组级 Value 绑定的目标字段（编译器降级 Binding 的宿主）。
    class Host {
        int city;
    }

    static string Tf(bool b) {
        if (b) { return "true"; }
        return "false";
    }

    static void Main() {
        // ---- 自定义 value + 禁用项 ------------------------------------
        RadioGroup g = new RadioGroup();
        g.AddOption("北京", 10);
        g.AddOption("上海", 20);
        g.AddOption("广州", 30, true);   // 禁用：值点不出来
        g.AddOption("深圳", 40);
        Console.WriteLine(g.Count());              // 4
        Console.WriteLine(g.SelectedIndex());      // -1（model=0 不是任何选项 value）
        Console.WriteLine(g.SelectedValue());      // 0

        // 越界 / 禁用 value 都是静默无操作。
        g.SetSelectedValue(99);
        Console.WriteLine(g.SelectedValue());      // 0（无 99 这个选项）
        g.SetSelectedValue(30);
        Console.WriteLine(g.SelectedValue());      // 0（30 被禁用）
        g.SetSelectedValue(40);
        Console.WriteLine(g.SelectedValue());      // 40
        Console.WriteLine(g.SelectedIndex());      // 3
        g.SetSelectedIndex(2);
        Console.WriteLine(g.SelectedValue());      // 40（下标 2 禁用）
        g.SetSelectedIndex(1);
        Console.WriteLine(g.SelectedValue());      // 20
        Console.WriteLine(g.IndexOfValue(30));     // 2（存在但禁用）
        Console.WriteLine(g.IndexOfValue(77));     // -1

        // ---- 组级 Value 双向绑定 --------------------------------------
        Host host = new Host();
        host.city = 10;
        g.Value = host.city;
        g.SyncGroup();
        Console.WriteLine(g.SelectedValue());      // 10（绑定拉取）
        host.city = 40;
        g.SyncGroup();
        Console.WriteLine(g.SelectedValue());      // 40（model <- 绑定）
        Console.WriteLine(g.SelectedIndex());      // 3
        g.SetSelectedValue(20);
        Console.WriteLine(host.city);              // 20（model -> 绑定）

        // 绑定脏值：无此选项时回写 model 现值，model 不被污染。
        host.city = 99;
        g.SyncGroup();
        Console.WriteLine(g.SelectedValue());      // 20
        Console.WriteLine(host.city);              // 20

        // ---- 子控件元数据下发 ------------------------------------------
        Radio r2 = (Radio)g.children[2];
        Console.WriteLine(Tf(r2.Disabled.Get()));  // true
        Console.WriteLine(r2.optionValue);         // 30
        Console.WriteLine(((Radio)g.children[0]).optionValue);  // 10

        // ---- 用户切换联动：子 Change -> 组 Change + Value 回写 ---------
        Radio r3 = (Radio)g.children[3];
        r3.Change.Raise();
        Console.WriteLine(fired);                  // 0（还没订阅）
        g.OnChange(() => { fired = fired + 1; });
        r3.Change.Raise();
        Console.WriteLine(fired);                  // 1
        Console.WriteLine(host.city);              // 40

        // ---- 尺寸档位：组一次下发整组 ----------------------------------
        RadioGroup gs = new RadioGroup();
        gs.SetOptionsText("A|B|C");
        gs.Size.Set("large");
        gs.SyncGroup();
        Console.WriteLine(Tf(Style.Has(gs.children[0].Class, "large")));   // true
        Console.WriteLine(Tf(Style.Has(gs.children[2].Class, "large")));   // true
        gs.Size.Set("nonsense");
        gs.SyncGroup();
        Console.WriteLine(Tf(Style.Has(gs.children[0].Class, "large")));   // true（脏值不改类）

        // ---- OptionsText 往返 + 选项列表重建 ---------------------------
        RadioGroup g2 = new RadioGroup();
        g2.AddOption("甲", 5);
        g2.AddOption("乙", 6);
        Console.WriteLine(g2.GetExtra("options")); // 甲|乙
        Console.WriteLine(g2.SetExtra("options", "丙|丁"));
        Console.WriteLine(g2.Count());             // 4（SetOptionsText 追加，不清空）
        Console.WriteLine(g2.children.Count);      // 4
        g2.ClearOptions();
        g2.SetOptionsText("戊|己");
        Console.WriteLine(g2.Count());             // 2
        Console.WriteLine(g2.SelectedIndex());     // 0（文本路径 value=下标）
        Console.WriteLine(((Radio)g2.children[1]).optionValue);  // 1

        // ---- SetOptions（显式元数据投影）-------------------------------
        RadioGroup g5 = new RadioGroup();
        List<RadioOption> opts = new List<RadioOption>();
        opts.Add(new RadioOption("杭州", 100));
        opts.Add(new RadioOption("苏州", 200, true));
        opts.Add(new RadioOption("宁波"));
        g5.SetOptions(opts);
        Console.WriteLine(g5.Count());             // 3
        Console.WriteLine(((Radio)g5.children[0]).optionValue);  // 100
        Console.WriteLine(((Radio)g5.children[1]).optionValue);  // 200
        Console.WriteLine(Tf(((Radio)g5.children[1]).Disabled.Get())); // true
        Console.WriteLine(((Radio)g5.children[2]).optionValue);  // 2（未给 value = 下标）
        g5.SetSelectedValue(200);
        Console.WriteLine(g5.SelectedValue());     // 0（200 被禁用，拒绝）

        // ---- 按钮形态（RadioButtonGroup）-------------------------------
        RadioGroup gb = new RadioGroup();
        gb.AddOption("当日达配送", 1);
        gb.AddOption("门店自提（旗舰店）", 2);
        gb.AddOption("快递柜投递", 3, true);
        gb.Buttons.Set(true);
        gb.SyncGroup();
        RadioButtonGroup bg = gb.buttonGroup;
        Console.WriteLine(bg.Count());             // 3
        Console.WriteLine(gb.Count());             // 3（组查询口径不变）
        Console.WriteLine(bg.items[0].optionValue);  // 1
        Console.WriteLine(Tf(bg.items[2].Disabled.Get())); // true

        // 按钮段的选中切换走同一 model：段 Select -> 组 SelectedValue。
        bg.items[1].Select();
        Console.WriteLine(gb.SelectedValue());     // 2
        Console.WriteLine(gb.SelectedIndex());     // 1
        gb.OnChange(() => { fired = fired + 1; });
        bg.items[1].Change.Raise();
        Console.WriteLine(fired);                  // 2

        // 尺寸档位下发到段。
        gb.Size.Set("small");
        gb.SyncGroup();
        Console.WriteLine(bg.items[0].Cls().Contains("small") ? 1 : 0);  // 1

        // 接缝类：单行三段 = 行首 rb-first / 中间无 / 行尾 rb-last。
        Console.WriteLine(bg.items[0].seamCls.Trim());   // rb-first
        Console.WriteLine(bg.items[1].seamCls.Trim());   // （空）
        Console.WriteLine(bg.items[2].seamCls.Trim());   // rb-last

        // ---- 独立 RadioButtonGroup -------------------------------------
        RadioButtonGroup solo = new RadioButtonGroup();
        solo.AddOption("Left");
        solo.AddOption("Middle", 7);
        Console.WriteLine(solo.Count());           // 2
        Console.WriteLine(solo.items[1].optionValue);  // 7
        solo.items[1].Select();
        Console.WriteLine(solo.Selected().Get());  // 7
        solo.SetExtra("options", "A|B|C");
        Console.WriteLine(solo.Count());           // 5（追加，与 SelectBox 同约定）
    }
}
