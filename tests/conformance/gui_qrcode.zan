using System;
using Gui;

namespace Conf;

/// QrEncoder 的可观察行为：版本 1-40、Numeric/Alphanumeric/Byte 混合
/// 分段、L/M/Q/H 纠错、掩码罚分选优、format/version 信息、UTF-8 中文
/// 原样入 Byte 段、超容量抛异常。逐模块输出为黄金（`#` 深 / `.` 浅）。
class Program {
    static void Dump(string tag, QrMatrix m) {
        Console.WriteLine(tag + " v=" + Convert.ToString(m.version)
            + " sz=" + Convert.ToString(m.size)
            + " ecl=" + EclName(m.ecl));
        for (int y = 0; y < m.size; y = y + 1) {
            string line = "";
            for (int x = 0; x < m.size; x = x + 1) {
                line = line + (m.Get(x, y) ? "#" : ".");
            }
            Console.WriteLine(line);
        }
    }

    static string EclName(QrEcl e) {
        if (e == QrEcl.L) { return "L"; }
        if (e == QrEcl.M) { return "M"; }
        if (e == QrEcl.Q) { return "Q"; }
        return "H";
    }

    static string Repeat(string s, int n) {
        string r = "";
        for (int i = 0; i < n; i = i + 1) { r = r + s; }
        return r;
    }

    static void Main() {
        Dump("numeric", QrEncoder.Encode("0123456789", QrEcl.L));
        Dump("alnum", QrEncoder.Encode("HELLO WORLD", QrEcl.M));
        Dump("byte", QrEncoder.Encode("Hello, world!", QrEcl.Q));
        Dump("cjk", QrEncoder.Encode("雨淋湿了天空", QrEcl.M));
        Dump("mixed-short", QrEncoder.Encode("ab123cd", QrEcl.H));
        Dump("mixed-url", QrEncoder.Encode(
            "http://example.com/?q=1234567890", QrEcl.M));
        Dump("v7plus", QrEncoder.Encode(Repeat("HELLO WORLD ", 20), QrEcl.Q));
        Dump("v10plus", QrEncoder.Encode(Repeat("ZanLang", 60), QrEcl.L));
        // 级别解析（大小写、未知默认 M）
        Console.WriteLine("parse:" + EclName(QrEncoder.ParseEcl("h")) + ","
            + EclName(QrEncoder.ParseEcl("L")) + ","
            + EclName(QrEncoder.ParseEcl("x")) + ","
            + EclName(QrEncoder.ParseEcl("")));
        // 空输入
        QrMatrix e = QrEncoder.Encode("", QrEcl.L);
        Console.WriteLine("empty v" + Convert.ToString(e.version)
            + " sz" + Convert.ToString(e.size));
        // 超容量
        try {
            QrEncoder.Encode(Repeat("雨", 700), QrEcl.H);
            Console.WriteLine("toolong:FAIL");
        } catch (Exception) {
            Console.WriteLine("toolong:ok");
        }
    }
}
