using System;
using System.Net.Http;
using System.Net.Http.Client;

class Program {
    static int failures = 0;

    static void Check(bool ok, string label) {
        if (!ok) { Program.failures = Program.failures + 1; }
        Console.WriteLine((ok ? "ok " : "FAIL ") + label);
    }

    static void Main() {
        HttpResponse r = HttpResponse.Text("safe");
        r.SetHeader("CoNtEnT-LeNgTh", "999");
        r.SetHeader("TRANSFER-encoding", "chunked");
        r.SetHeader("connection", "close");
        r.SetHeader("X-Visible", "yes");
        string raw = r.Build();
        Program.Check(raw.IndexOf("Content-Length: 4\r\n") >= 0,
            "real Content-Length retained");
        Program.Check(raw.IndexOf("999") < 0
            && raw.ToLower().IndexOf("transfer-encoding") < 0,
            "response cannot override framing");
        Program.Check(raw.IndexOf("Connection: keep-alive\r\n") >= 0
            && raw.IndexOf("Connection: close") < 0,
            "response cannot override connection mode");
        Program.Check(raw.IndexOf("X-Visible: yes") >= 0,
            "ordinary response header retained");
        Console.WriteLine("failures=" + Convert.ToString(Program.failures));
    }
}
