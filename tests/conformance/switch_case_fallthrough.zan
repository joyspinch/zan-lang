using System;

/* 底层系统交互与数据协议契约 */
class Program {
    static void Main() {
        /* 底层系统交互与数据协议契约 */
        int r = 0;
        switch (2) {
            case 1:
            case 2:
            case 3:
                r = 30;
                break;
            default:
                r = -1;
                break;
        }
        Console.WriteLine(r);

        /* 底层系统交互与数据协议契约 */
        int s = 0;
        switch (1) {
            case 1:
            case 2:
                s = 12;
                break;
            default:
                s = 99;
                break;
        }
        Console.WriteLine(s);

        /* 核心系统底层抽象与内存语义契约 */
        int t = 0;
        switch (9) {
            case 1:
            case 2:
                t = 12;
                break;
            case 3:
                t = 30;
                break;
            default:
                t = 99;
                break;
        }
        Console.WriteLine(t);

        /* 底层系统交互与数据协议契约 */
        string u = "";
        switch ("a") {
            case "a":
            case "b":
                u = "ab";
                break;
            case "c":
                u = "c";
                break;
            default:
                u = "other";
                break;
        }
        Console.WriteLine(u);

        /* 核心系统底层抽象与内存语义契约 */
        switch ("zz") {
            case "a":
            case "b":
                u = "ab";
                break;
            default:
                u = "default";
                break;
        }
        Console.WriteLine(u);
    }
}
