using System;

/* Empty switch cases fall through into the next case, letting several labels
 * share one body (C# semantics). This used to be silent wrong behaviour:
 * each case got its own block and an empty one branched straight to the
 * switch end, so a label with an empty body never ran the shared statements. */
class Program {
    static void Main() {
        /* integer: three labels sharing one body */
        int r = 0;
        switch (2) {
            case 1:
            case 2:
            case 3:
                r = 30;
                break;
            default:
                r = -1;
                break;
        }
        Console.WriteLine(r);

        /* integer: empty label at the head of a pair */
        int s = 0;
        switch (1) {
            case 1:
            case 2:
                s = 12;
                break;
            default:
                s = 99;
                break;
        }
        Console.WriteLine(s);

        /* integer: unmatched value falls to default */
        int t = 0;
        switch (9) {
            case 1:
            case 2:
                t = 12;
                break;
            case 3:
                t = 30;
                break;
            default:
                t = 99;
                break;
        }
        Console.WriteLine(t);

        /* string switch: empty case falls through to the next label */
        string u = "";
        switch ("a") {
            case "a":
            case "b":
                u = "ab";
                break;
            case "c":
                u = "c";
                break;
            default:
                u = "other";
                break;
        }
        Console.WriteLine(u);

        /* string switch: unmatched falls to default */
        switch ("zz") {
            case "a":
            case "b":
                u = "ab";
                break;
            default:
                u = "default";
                break;
        }
        Console.WriteLine(u);
    }
}
