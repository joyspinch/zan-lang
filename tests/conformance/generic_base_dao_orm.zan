using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;

[Table("sys_users")]
public class SysUser {
    [Id]
    public int id;
    public string username;
    public string nickname;
}

[Table("sys_roles")]
public class SysRole {
    [Id]
    public int id;
    public string name;
    public string code;
}

public class BaseDao<T> {
    protected IDbConnection db;

    public BaseDao(IDbConnection db) {
        this.db = db;
    }

    public T FindById(int id) {
        return this.db.Select<T>().WhereEq("t.id", id).First();
    }

    public async T FindByIdAsync(int id) {
        return await this.db.Select<T>().WhereEq("t.id", id).FirstAsync();
    }

    public int Insert(T entity) {
        return this.db.Insert<T>(entity).ExecuteAffrows();
    }

    public async int InsertAsync(T entity) {
        return await this.db.Insert<T>(entity).ExecuteAffrowsAsync();
    }

    public int DeleteById(int id) {
        return this.db.Delete<T>().WhereEq("id", id).ExecuteAffrows();
    }

    public async int DeleteByIdAsync(int id) {
        return await this.db.Delete<T>().WhereEq("id", id).ExecuteAffrowsAsync();
    }

    public List<T> All() {
        return this.db.Select<T>().ToList();
    }

    public async List<T> AllAsync() {
        return await this.db.Select<T>().ToListAsync();
    }

    public long Count() {
        return this.db.Select<T>().Count();
    }

    public async int CountAsync() {
        return await this.db.Select<T>().CountAsync();
    }
}

public class SysUserDao : BaseDao<SysUser> {
    public SysUserDao(IDbConnection db) : base(db) {}

    public SysUser FindByUsername(string username) {
        return this.db.Select<SysUser>().Where(a => a.username == username).First();
    }
}

public class SysRoleDao : BaseDao<SysRole> {
    public SysRoleDao(IDbConnection db) : base(db) {}
}

class Program {
    static async void Main() {
        IDbConnection db = SqliteConnection.Open(":memory:");
        db.Execute("CREATE TABLE sys_users (id INTEGER PRIMARY KEY, username TEXT, nickname TEXT);");
        db.Execute("CREATE TABLE sys_roles (id INTEGER PRIMARY KEY, name TEXT, code TEXT);");

        SysUserDao userDao = new SysUserDao(db);
        SysRoleDao roleDao = new SysRoleDao(db);

        // 核心契约与执行状态转移规范。
        userDao.Insert(new SysUser { id = 1, username = "admin", nickname = "Admin" });
        await userDao.InsertAsync(new SysUser { id = 2, username = "bob", nickname = "Bob" });

        roleDao.Insert(new SysRole { id = 1, name = "超级管理员", code = "superadmin" });
        await roleDao.InsertAsync(new SysRole { id = 2, name = "财务", code = "finance" });

        // 2. Counts
        if (userDao.Count() != 2) { Console.WriteLine("FAIL user count"); return; }
        if (await roleDao.CountAsync() != 2) { Console.WriteLine("FAIL role count"); return; }

        // 核心契约与执行状态转移规范。
        SysUser u = userDao.FindById(1);
        if (u == null || u.username != "admin") { Console.WriteLine("FAIL user find"); return; }

        SysUser uCustom = userDao.FindByUsername("bob");
        if (uCustom == null || uCustom.id != 2) { Console.WriteLine("FAIL user custom find"); return; }

        SysRole r = await roleDao.FindByIdAsync(2);
        if (r == null || r.code != "finance") { Console.WriteLine("FAIL role find"); return; }

        // 4. All
        List<SysUser> users = userDao.All();
        if (users.Count != 2) { Console.WriteLine("FAIL user all"); return; }

        List<SysRole> roles = await roleDao.AllAsync();
        if (roles.Count != 2) { Console.WriteLine("FAIL role all"); return; }

        // 5. Delete
        userDao.DeleteById(1);
        await roleDao.DeleteByIdAsync(2);

        if (userDao.Count() != 1) { Console.WriteLine("FAIL user count after del"); return; }
        if (roleDao.Count() != 1) { Console.WriteLine("FAIL role count after del"); return; }

        Console.WriteLine("PASS");
    }
}
