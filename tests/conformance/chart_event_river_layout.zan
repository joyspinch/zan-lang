using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

// EventRiverLayout 纯几何：时间范围映射、稳定排序、
// 区间着色行号、行对称堆叠的 band 矩形、容错 swap、
// 确定性。矩形 (0,0,200,120) pad=8：plotW=184 plotH=104。
class Program {
    static void Main() {
        List<ChartEvent> ev = new List<ChartEvent>{
            ChartEvent.Of("A", 0, 10, 5),
            ChartEvent.Of("B", 5, 15, 10),
            ChartEvent.Of("C", 10, 20, 5),
            ChartEvent.Of("D", 0, 20, 15) };
        EventRiverLayout l = EventRiverLayout.Of(ev, 0, 0, 200, 120, 8);

        Console.WriteLine("range:" + Convert.ToString(l.t0) + ":" + Convert.ToString(l.t1)
            + ":" + Convert.ToString(l.span));
        Console.WriteLine("rows:" + Convert.ToString(l.rowCount));
        Console.WriteLine("bands:" + Convert.ToString(l.bands.Count));
        // 稳定序：[A, D, B, C]；行号 [0, 1, 2, 0]。
        Console.WriteLine("order:" + l.bands[0].name + ":" + l.bands[1].name
            + ":" + l.bands[2].name + ":" + l.bands[3].name);
        Console.WriteLine("rowsOf:" + Convert.ToString(l.bands[0].row) + ":"
            + Convert.ToString(l.bands[1].row) + ":" + Convert.ToString(l.bands[2].row)
            + ":" + Convert.ToString(l.bands[3].row));
        // band 矩形（x0:x1:y:h）：A(8,100,34,7) D(8,192,49,23)
        // B(54,146,76,15) C(100,192,34,7)。
        Console.WriteLine("b0:" + Convert.ToString(l.bands[0].x0) + ":"
            + Convert.ToString(l.bands[0].x1) + ":" + Convert.ToString(l.bands[0].y)
            + ":" + Convert.ToString(l.bands[0].h));
        Console.WriteLine("b1:" + Convert.ToString(l.bands[1].x0) + ":"
            + Convert.ToString(l.bands[1].x1) + ":" + Convert.ToString(l.bands[1].y)
            + ":" + Convert.ToString(l.bands[1].h));
        Console.WriteLine("b2:" + Convert.ToString(l.bands[2].x0) + ":"
            + Convert.ToString(l.bands[2].x1) + ":" + Convert.ToString(l.bands[2].y)
            + ":" + Convert.ToString(l.bands[2].h));
        Console.WriteLine("b3:" + Convert.ToString(l.bands[3].x0) + ":"
            + Convert.ToString(l.bands[3].x1) + ":" + Convert.ToString(l.bands[3].y)
            + ":" + Convert.ToString(l.bands[3].h));

        // 容错：start > end 的事件被交换；行数归并。
        List<ChartEvent> sw2 = new List<ChartEvent>{
            ChartEvent.Of("A", 0, 10, 5),
            ChartEvent.Of("S", 25, 20, 3) };
        EventRiverLayout s = EventRiverLayout.Of(sw2, 0, 0, 200, 120, 8);
        Console.WriteLine("swap:" + Convert.ToString(s.t0) + ":" + Convert.ToString(s.t1)
            + ":" + Convert.ToString(s.span) + ":" + Convert.ToString(s.rowCount)
            + ":" + Convert.ToString(s.bands.Count));
        // S 归一化为 (20,25)：x0=155 x1=192 y=40 h=41。
        Console.WriteLine("s1:" + Convert.ToString(s.bands[1].x0) + ":"
            + Convert.ToString(s.bands[1].x1) + ":" + Convert.ToString(s.bands[1].y)
            + ":" + Convert.ToString(s.bands[1].h));

        // 稳定排序：同 start/end 的事件保持原序。
        List<ChartEvent> tie = new List<ChartEvent>{
            ChartEvent.Of("X", 0, 10, 1),
            ChartEvent.Of("A", 0, 10, 5) };
        EventRiverLayout t = EventRiverLayout.Of(tie, 0, 0, 200, 120, 8);
        Console.WriteLine("tie:" + t.bands[0].name + ":" + t.bands[1].name
            + ":" + Convert.ToString(t.rowCount));

        // 空输入。
        List<ChartEvent> none = new List<ChartEvent>();
        EventRiverLayout n = EventRiverLayout.Of(none, 0, 0, 200, 120, 8);
        Console.WriteLine("empty:" + Convert.ToString(n.rowCount) + ":"
            + Convert.ToString(n.bands.Count) + ":" + Convert.ToString(n.span));

        // 确定性：相同输入两次调用结果一致。
        EventRiverLayout l2 = EventRiverLayout.Of(ev, 0, 0, 200, 120, 8);
        Console.WriteLine("det:" + Convert.ToString(ChartConf.B(
            l.span == l2.span && l.rowCount == l2.rowCount && l.bands.Count == l2.bands.Count
            && l.bands[0].x0 == l2.bands[0].x0 && l.bands[3].y == l2.bands[3].y)));
    }
}

class ChartConf {
    static string B(bool v) {
        if (v) { return "1"; }
        return "0";
    }
}
