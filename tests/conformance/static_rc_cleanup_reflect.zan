using System;
using System.Collections.Generic;

class CacheItem {
    public string Name;
    public CacheItem(string name) { Name = name; }
}

class NonGenericCache {
    static List<string> items = new List<string>();
    static Dict<string, CacheItem> map = new Dict<string, CacheItem>();

    public static void Seed(string key, string val) {
        NonGenericCache.items.Add(key);
        NonGenericCache.map[key] = new CacheItem(val);
    }

    public static int Count() {
        return NonGenericCache.items.Count + NonGenericCache.map.Count;
    }
}

class Program {
    static void Main() {
        TypeInfo t = typeof(NonGenericCache);
        NonGenericCache.Seed("k1", "v1");
        Console.WriteLine(t.Name + ":" + Convert.ToString(NonGenericCache.Count()));
    }
}
