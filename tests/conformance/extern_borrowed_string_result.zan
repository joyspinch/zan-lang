using System;
using System.IO;

namespace ExternBorrow;

/* 底层系统交互与数据协议契约 */
class Prog {
    static void Main() {
        for (int i = 0; i < 3; i = i + 1) {
            string cwd = Directory.GetCurrentDirectory();
            int n = cwd.Length;
            /* 底层系统交互与数据协议契约 */
            int acc = 0;
            for (int j = 0; j < n; j = j + 1) {
                acc = acc + (cwd[j] == '/' || cwd[j] == '\\' ? 1 : 0);
            }
            string cwd2 = Directory.GetCurrentDirectory();
            int same = 1;
            if (cwd2.Length != n) same = 0;
            for (int j = 0; j < n; j = j + 1) {
                if (same == 1 && cwd[j] != cwd2[j]) same = 0;
            }
            Console.WriteLine("ok=" + Convert.ToString(n > 0 && acc > 0 && same == 1));
        }
        Console.WriteLine("done");
    }
}
