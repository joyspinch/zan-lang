class Boom {
    string msg;
    Boom(string m) { this.msg = m; }
    string Message() { return this.msg; }
}

class Program {
    static async string Leaf(int mode) {
        await Task.Delay(1);
        if (mode == 0) {
            throw new Boom("leaf-after-await");
        }
        return "leaf-ok";
    }

    static async string Mid(int mode) {
        string v = await Program.Leaf(mode);
        return "mid(" + v + ")";
    }

    static async string PreAwait() {
        throw new Boom("before-await");
    }

    static async void Run() {
        // success path unchanged
        string a = await Program.Mid(1);
        Console.WriteLine("ok=" + a);

        // throw after a suspension, caught by the direct awaiter
        try {
            string b = await Program.Leaf(0);
            Console.WriteLine("unreached=" + b);
        } catch (Boom e) {
            Console.WriteLine("direct=" + e.Message());
        }

        // throw after a suspension, propagating through an intermediate frame
        try {
            string c = await Program.Mid(0);
            Console.WriteLine("unreached=" + c);
        } catch (Boom e) {
            Console.WriteLine("nested=" + e.Message());
        }

        // throw before any suspension still works
        try {
            string d = await Program.PreAwait();
            Console.WriteLine("unreached=" + d);
        } catch (Boom e) {
            Console.WriteLine("pre=" + e.Message());
        }

        // the awaiter recovers and keeps running
        string e2 = await Program.Leaf(1);
        Console.WriteLine("after=" + e2);
    }

    static void Main() {
        await Program.Run();
        try {
            string r = await Program.Leaf(0);
            Console.WriteLine("unreached=" + r);
        } catch (Boom e) {
            Console.WriteLine("root=" + e.Message());
        }
        Console.WriteLine("done");
    }
}
