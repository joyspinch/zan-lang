using System;
using System.Text;

// Regression: post-inline escape stack promotion in publish/sharded mode must
// clear `tail` on calls receiving the promoted alloca pointer; otherwise DSE
// deletes the stack header (rc/site) stores and zan_rt_release_dyn crashes.
class PublishEscapeTailRelease {
    static string CollapseLike(string s) {
        if (s == null || s.Length == 0) {
            return "";
        }
        StringBuilder outp = new StringBuilder();
        bool inSpace = false;
        int start = 0;
        int n = s.Length;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c == 32 || c == 9) {
                if (!inSpace) {
                    if (i > start) {
                        outp.Append(s.Substring(start, i - start));
                    }
                    inSpace = true;
                }
                start = i + 1;
                continue;
            }
            if (inSpace) {
                outp.Append(" ");
                inSpace = false;
                start = i;
            }
        }
        if (start < n) {
            outp.Append(s.Substring(start, n - start));
        }
        if (inSpace) {
            outp.Append(" ");
        }
        return outp.ToString();
    }

    static string WrapAndUse(string s) {
        try {
            return "[" + CollapseLike(s) + "]";
        } catch (Exception e) {
            return e.Message;
        }
    }

    static void Main() {
        Console.WriteLine(WrapAndUse("  hello   world  "));
        Console.WriteLine(WrapAndUse(""));
        Console.WriteLine("PUBLISH_ESCAPE_TAIL_RELEASE_OK");
    }
}
