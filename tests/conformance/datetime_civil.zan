using System;

// 核心契约与语义定义。
class Program {
    static void Main() {
        Console.WriteLine(DateTime.DaysFromCivil(1970, 1, 1));
        Console.WriteLine(DateTime.DaysFromCivil(1969, 12, 31));
        Console.WriteLine(DateTime.DaysFromCivil(2000, 3, 1));

        Console.WriteLine(DateTime.FromDate(2026, 7, 26).ToDateString());
        Console.WriteLine(DateTime.FromParts(1999, 12, 31, 23, 59, 58).ToString());
        Console.WriteLine(DateTime.FromDate(1900, 2, 28).ToDateString());
        Console.WriteLine(DateTime.FromDate(2024, 2, 29).ToDateString());

        // 核心契约与语义定义。
        int bad = 0;
        int d = 0 - 40000;
        while (d < 40000) {
            DateTime t = DateTime.FromUnixSeconds(d * 86400);
            if (DateTime.DaysFromCivil(t.Year(), t.Month(), t.Day()) != d) { bad = bad + 1; }
            d = d + 1;
        }
        Console.WriteLine(bad);

        Console.WriteLine(DateTime.IsLeapYear(2000));
        Console.WriteLine(DateTime.IsLeapYear(1900));
        Console.WriteLine(DateTime.IsLeapYear(2024));
        Console.WriteLine(DateTime.IsLeapYear(2023));

        Console.WriteLine(DateTime.DaysInMonth(2024, 2));
        Console.WriteLine(DateTime.DaysInMonth(2023, 2));
        Console.WriteLine(DateTime.DaysInMonth(2023, 4));
        Console.WriteLine(DateTime.DaysInMonth(2023, 12));
    }
}
