using System;

class Sink {
    public string name;
    public Sink(string n) { name = n; }
    public void WriteLine(int value) {
        Console.WriteLine(name + ":" + Convert.ToString(value));
    }
}

class Program {
    static async int Number() {
        await Task.Delay(1);
        return 42;
    }

    static async int Replace(Sink replacement) {
        await Task.Delay(1);
        return 7;
    }

    static async void Main() {
        Console.WriteLine(await Number());
        {
            Sink Console = new Sink("original");
            Console.WriteLine(await Replace(Console = new Sink("replacement")));
            Console.WriteLine(9);
        }
    }
}
