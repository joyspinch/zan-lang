using System;
using Gui;
using Gui.Backend;

namespace Tests.ChildWindowCallbackLifecycle;

class Owner {
    public ChildWindow window;
    public int calls;

    public Owner() { window = new ChildWindow(); }
    public void Render() { calls = calls + 1; }
}

class Program {
    static void Wire(Owner owner) {
        owner.window.SetRender(() => { owner.Render(); });
    }

    static void Main() {
        Owner owner = new Owner();
        ChildWindow window = owner.window;
        Program.Wire(owner);
        WeakReference<Owner> ownerLife = new WeakReference<Owner>(owner);
        WeakReference<ChildWindow> windowLife = new WeakReference<ChildWindow>(window);
        owner = null;
        Console.WriteLine("callback-retains-owner=" + Convert.ToString(ownerLife.IsAlive));
        // No OpenHost/OpenStandalone: teardown must tolerate an absent App/native window.
        window.Teardown();
        Console.WriteLine("callback-owner-released=" + Convert.ToString(!ownerLife.IsAlive));
        window.Teardown();
        Console.WriteLine("teardown-idempotent=" + Convert.ToString(!ownerLife.IsAlive));
        window = null;
        Console.WriteLine("window-released=" + Convert.ToString(!windowLife.IsAlive));

        ChildWindow rooted = new ChildWindow();
        Control tree = new Control();
        WeakReference<Control> treeLife = new WeakReference<Control>(tree);
        rooted.SetRoot(tree, (object)"model");
        tree = null;
        rooted.Teardown();
        Console.WriteLine("owned-driver-root-released=" + Convert.ToString(
            UiDriver.root == null && !treeLife.IsAlive));
        rooted = null;

        ChildWindow closing = new ChildWindow();
        ChildWindow other = new ChildWindow();
        closing.SetRoot(new Control(), (object)"closing");
        Control otherTree = new Control();
        other.SetRoot(otherTree, (object)"other");
        closing.Teardown();
        Console.WriteLine("other-driver-root-preserved=" + Convert.ToString(
            UiDriver.root == otherTree && other.Binder().Root() == otherTree));
        other.Teardown();
        closing = null;
        other = null;
        otherTree = null;
    }
}
