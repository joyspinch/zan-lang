using System;
using System.Collections.Generic;

// B-ID102 拓扑审计首发漏改钉子：表达式位泛型实例化 `Gen<T>.Static()` 的类型实参
// 挂在 ident.inst_type_ref 上，nr_walk 须下钻改写其中的命名空间类型，否则
// 绑定期 E1005 undefined type 'Queue'（Gen<int> 正常、Gen<Queue<int>> 红）。
static class Gen<T> {
    public static int Count() { return 7; }
}

class Prog {
    static void Main() {
        int a = Gen<int>.Count();
        int b = Gen<Queue<int>>.Count();
        Console.WriteLine(Convert.ToString(a + b));
    }
}
