using System;
using System.Data;
using System.Data.Sqlite;
using System.IO;

class Blog {
    [Column(IsIdentity = true)]
    int id;
    string title;
    int clicks;
    double score;
}

class Program {
    static void Main() {
        string path = "orm_dynamic.tmp.db";
        File.Delete(path);
        SqliteConnection db = SqliteConnection.Open(path);
        db.SyncStructure<Blog>();

        DbValues form = new DbValues()
            .Set("title", "dynamic")
            .Set("clicks", 3)
            .Set("score", 1.5);
        Console.WriteLine("ins: " + Convert.ToString(
            db.Insert<Blog>().AppendDict(form).ExecuteAffrows()));

        List<DbValues> batch = new List<DbValues> {
            new DbValues().Set("title", "a").Set("clicks", 1)
                .Set("score", 0.5),
            new DbValues().Set("title", "b").Set("clicks", 2)
                .Set("score", 2.5)
        };
        Console.WriteLine("batch: " + Convert.ToString(
            db.Insert<Blog>().AppendDict(batch).ExecuteAffrows()));

        DbValues patch = new DbValues()
            .Set("title", "patched")
            .Set("clicks", 99);
        Console.WriteLine("upd: " + Convert.ToString(
            db.Update<Blog>().SetDict(patch).Where(a => a.id == 1).ExecuteAffrows()));

        Blog one = db.Select<Blog>().Where(a => a.id == 1).First();
        if (one != null) {
            Console.WriteLine("row: " + one.title + " " + Convert.ToString(one.clicks)
                + " " + Convert.ToString(one.score));
        }

        Blog e = new Blog();
        e.id = 1;
        e.title = "entity";
        e.clicks = 7;
        e.score = 9.5;
        Console.WriteLine("src: " + Convert.ToString(
            db.Update<Blog>().SetSource(e).UpdateColumns("title").ExecuteAffrows()));
        Blog two = db.Select<Blog>().Where(a => a.id == 1).First();
        if (two != null) {
            Console.WriteLine("row2: " + two.title + " " + Convert.ToString(two.clicks));
        }

        DbValues cond = new DbValues().Set("title", "a");
        Console.WriteLine("dyn: " + Convert.ToString(
            db.Select<Blog>().WhereDict(cond).Count()));
        Console.WriteLine("del: " + Convert.ToString(
            db.Delete<Blog>().WhereDict(cond).ExecuteAffrows()));

        DbValues text = new DbValues()
            .Set("title", "typed")
            .Set("clicks", "42")
            .Set("score", "3");
        Console.WriteLine("txt: " + Convert.ToString(
            db.Insert<Blog>().AppendDict(text).ExecuteAffrows()));
        Blog t3 = db.Select<Blog>().Where(a => a.title == "typed").First();
        if (t3 != null) {
            Console.WriteLine("typed: " + Convert.ToString(t3.clicks + 1)
                + " " + Convert.ToString(t3.score + 0.5));
        }

        DbValues wrong = new DbValues()
            .Set("title", "x")
            .Set("clicks", "abc");
        try {
            db.Insert<Blog>().AppendDict(wrong).ExecuteAffrows();
            Console.WriteLine("cast: not rejected");
        } catch (Exception ce) {
            Console.WriteLine("cast: " + ce.Message);
        }

        DbValues unknown = new DbValues().Set("nope", 1);
        try {
            db.Update<Blog>().SetDict(unknown).Where(a => a.id == 1).ExecuteAffrows();
            Console.WriteLine("bad: not rejected");
        } catch (Exception ex) {
            Console.WriteLine("bad: " + ex.Message);
        }

        db.Close();
        File.Delete(path);
    }
}
