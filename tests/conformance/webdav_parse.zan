using System;
using System.Net.WebDav;

class Program {
    static string Repeat(string text, int count) {
        StringBuilder result = new StringBuilder();
        for (int i = 0; i < count; i = i + 1) {
            result.Append(text);
        }
        return result.ToString();
    }

    static void Main() {
        string xml = "<?xml version=\"1.0\"?><d:multistatus xmlns:d=\"DAV:\">"
            + "<d:response><d:href>/docs/</d:href><d:propstat><d:prop>"
            + "<d:resourcetype><d:collection/></d:resourcetype>"
            + "<d:getcontentlength>0</d:getcontentlength><d:getcontenttype/>"
            + "<d:getetag>&quot;folder&amp;tag&quot;</d:getetag>"
            + "<d:getlastmodified>Wed, 01 Jan 2025 00:00:00 GMT</d:getlastmodified>"
            + "</d:prop><d:status>HTTP/1.1 200 OK</d:status></d:propstat>"
            + "<d:status>HTTP/1.1 207 Multi-Status</d:status></d:response>"
            + "<response xmlns=\"DAV:\"><href>/docs/a&lt;b&amp;c.txt</href><propstat><prop>"
            + "<resourcetype/><getcontentlength>12345678901</getcontentlength>"
            + "<getcontenttype>text/plain</getcontenttype><getetag>\"abc\"</getetag>"
            + "<getlastmodified>Thu, 02 Jan 2025 03:04:05 GMT</getlastmodified>"
            + "</prop><status>HTTP/1.1 404 Not Found</status></propstat></response>"
            + "</d:multistatus>";

        List<WebDavResource> items = WebDavClient.ParseMultiStatus(xml);
        Console.WriteLine("parsed");
        Console.WriteLine("count=" + Convert.ToString(items.Count));
        for (int i = 0; i < items.Count; i = i + 1) {
            WebDavResource r = items[i];
            Console.WriteLine(r.href + "|" + Convert.ToString(r.status)
                + "|" + Convert.ToString(r.collection)
                + "|" + Convert.ToString(r.contentLength)
                + "|" + r.contentType + "|" + r.etag + "|" + r.lastModified);
        }

        string request = WebDavClient.BuildPropFindXml();
        Console.WriteLine("request=" + request);
        Console.WriteLine("escape=" + WebDavClient.EscapeXml("<&>\"'"));
        Console.WriteLine("unescape=" + WebDavClient.UnescapeXml("&lt;&amp;&gt;&quot;&apos;&unknown;"));

        try {
            WebDavClient.ValidateDepth("2");
            Console.WriteLine("depth=bad");
        } catch (ArgumentException e) {
            Console.WriteLine("depth=validated");
        }
        try {
            WebDavClient.ValidateDestination("https://example.test/a\r\nInjected: yes");
            Console.WriteLine("destination=bad");
        } catch (ArgumentException e) {
            Console.WriteLine("destination=validated");
        }
        WebDavClient.ValidateDestination("/safe/path");
        WebDavClient.ValidateDestination("https://example.test/safe");
        Console.WriteLine("destination=accepted");

        string response = "<response><href>/limit</href></response>";
        string maxResources = "<multistatus>" + Repeat(response, 10000) + "</multistatus>";
        List<WebDavResource> limitItems = WebDavClient.ParseMultiStatus(maxResources);
        Console.WriteLine("resource-limit=" + Convert.ToString(limitItems.Count));
        limitItems = null;
        try {
            WebDavClient.ParseMultiStatus(maxResources + response);
            Console.WriteLine("resource-overflow=bad");
        } catch (ArgumentException e) {
            Console.WriteLine("resource-overflow=validated");
        }

        string oversized = Repeat(" ", 4194305);
        Console.WriteLine("byte-overflow-size=" + Convert.ToString(oversized.Length));
        try {
            WebDavClient.ParseMultiStatus(oversized);
            Console.WriteLine("byte-overflow=bad");
        } catch (ArgumentException e) {
            Console.WriteLine("byte-overflow=validated");
        }
    }
}
