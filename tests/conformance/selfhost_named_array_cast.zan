using System;

class NamedArrayCastPayload {
    public int value;
    public NamedArrayCastPayload(int n) { value = n; }
}

class SelfhostNamedArrayCast {
    static void Main() {
        NamedArrayCastPayload[] values = new NamedArrayCastPayload[2];
        values[0] = new NamedArrayCastPayload(11);
        NamedArrayCastPayload[] alias = (NamedArrayCastPayload[])values;
        Console.WriteLine(alias[0].value);
        alias[1] = new NamedArrayCastPayload(23);
        Console.WriteLine(values[1].value);

        NamedArrayCastPayload[,] rect = new NamedArrayCastPayload[2,3];
        rect[1,2] = new NamedArrayCastPayload(31);
        NamedArrayCastPayload[,] rectAlias = (NamedArrayCastPayload[,])rect;
        Console.WriteLine(rectAlias[1,2].value);
        rectAlias[0,1] = new NamedArrayCastPayload(47);
        Console.WriteLine(rect[0,1].value);

        int[] a = new int[] { 5, 9 };
        int i = 1;
        Console.WriteLine((a[i]));
        int x = 6;
        int y = 7;
        Console.WriteLine((x) + y);
    }
}
