    static int PORT = 9528;

    static void TestRecordLayer() {
        byte[] key = new byte[16];
        byte[] iv12 = new byte[12];
        for (int i = 0; i < 16; i = i + 1) { key[i] = (byte)(i + 1); }
        for (int i = 0; i < 12; i = i + 1) { iv12[i] = (byte)(i + 10); }

        // TLS 1.3 Record
        TlsCipherState enc13 = new TlsCipherState(TlsRecord.VersionTls13, key, iv12);
        TlsCipherState dec13 = new TlsCipherState(TlsRecord.VersionTls13, key, iv12);
        byte[] pt = new byte[] { 104, 101, 108, 108, 111, 32, 116, 108, 115 };
        byte[] rec13 = enc13.Encrypt(TlsRecord.ContentTypeApplicationData, pt, 0, pt.Length);
        Check(rec13 != null, "tls13 record encrypt ok");

        List<int> ctOut = new List<int>(); ctOut.Add(0);
        byte[] hdr13 = new byte[5];
        for (int i = 0; i < 5; i = i + 1) { hdr13[i] = rec13[i]; }
        byte[] decPt13 = dec13.Decrypt(hdr13, rec13, 5, rec13.Length - 5, ctOut);
        Check(decPt13 != null && ctOut[0] == TlsRecord.ContentTypeApplicationData, "tls13 record decrypt ok");
        Check(decPt13.ToStr(0, decPt13.Length) == "hello tls", "tls13 record plaintext intact");

        // TLS 1.2 Record
        byte[] iv4 = new byte[4];
        for (int i = 0; i < 4; i = i + 1) { iv4[i] = (byte)(i + 20); }
        TlsCipherState enc12 = new TlsCipherState(TlsRecord.VersionTls12, key, iv4);
        TlsCipherState dec12 = new TlsCipherState(TlsRecord.VersionTls12, key, iv4);
        byte[] rec12 = enc12.Encrypt(TlsRecord.ContentTypeApplicationData, pt, 0, pt.Length);
        Check(rec12 != null, "tls12 record encrypt ok");

        List<int> ctOut12 = new List<int>(); ctOut12.Add(0);
        byte[] hdr12 = new byte[5];
        for (int i = 0; i < 5; i = i + 1) { hdr12[i] = rec12[i]; }
        byte[] decPt12 = dec12.Decrypt(hdr12, rec12, 5, rec12.Length - 5, ctOut12);
        Check(decPt12 != null && ctOut12[0] == TlsRecord.ContentTypeApplicationData, "tls12 record decrypt ok");
        Check(decPt12.ToStr(0, decPt12.Length) == "hello tls", "tls12 record plaintext intact");
    }

    static async void ServerLoop(TlsContext tls) {
        TcpListener l = new TcpListener("127.0.0.1", PORT);
        l.Start();
        for (int n = 0; n < 2; n = n + 1) {
            nint sock = await l.AcceptAsync();
            if (sock < 0) { break; }
            TlsStream s = await TlsStream.AcceptAsync(tls, sock);
            if (s != null) {
                string req = await s.RecvAsync(128);
                if (req == "ping tls13") {
                    await s.SendStringAsync("pong tls13");
                } else if (req == "ping tls12") {
                    await s.SendStringAsync("pong tls12");
                }
                s.Close();
            }
            Socket.Close(sock);
        }
        l.Stop();
    }

    static async int Run() {
        Socket.Initialize();
        TestRecordLayer();

        Directory.CreateDirectory("_scratch");
        File.WriteAllText("_scratch/tls_srv_cert.pem", SERVER_CERT);
        File.WriteAllText("_scratch/tls_srv_key.pem", SERVER_KEY);

        TlsContext serverTls = TlsContext.CreateServer("_scratch/tls_srv_cert.pem", "_scratch/tls_srv_key.pem");
        Check(serverTls != null, "server tls ctx ok");
        Task.Spawn(ServerLoop(serverTls));
        await Task.Delay(80);

        // 1. Loopback TLS 1.3
        TlsContext c13 = TlsContext.CreateClient();
        c13.DisableVerify();
        nint sock1 = Socket.CreateTcp();
        Socket.SetNonBlocking(sock1);
        await Socket.ConnectAsync(sock1, "127.0.0.1", PORT, 5000);
        TlsStream s1 = await TlsStream.ConnectAsync(c13, sock1, "wrong.example");
        Check(s1 != null, "tls13 client connect ok");
        if (s1 != null) {
            await s1.SendStringAsync("ping tls13");
            string resp = await s1.RecvAsync(128);
            Check(resp == "pong tls13", "tls13 ping pong ok");
            s1.Close();
        }
        Socket.Close(sock1);
        c13.Free();

        // 2. Loopback TLS 1.2
        TlsContext c12 = TlsContext.CreateClient();
        c12.DisableTls13();
        c12.DisableVerify();
        nint sock2 = Socket.CreateTcp();
        Socket.SetNonBlocking(sock2);
        await Socket.ConnectAsync(sock2, "127.0.0.1", PORT, 5000);
        TlsStream s2 = await TlsStream.ConnectAsync(c12, sock2, "wrong.example");
        Check(s2 != null, "tls12 client connect ok");
        if (s2 != null) {
            await s2.SendStringAsync("ping tls12");
            string resp2 = await s2.RecvAsync(128);
            Check(resp2 == "pong tls12", "tls12 ping pong ok");
            s2.Close();
        }
        Socket.Close(sock2);
        c12.Free();

        serverTls.Free();
        Socket.Cleanup();
        Console.WriteLine("failures=" + Convert.ToString(failures));
        for (int i = 0; i < 15; i = i + 1) { await Task.Delay(10); }
        return 0;
    }

    static void Main() {
        int r = await Run();
    }
}
