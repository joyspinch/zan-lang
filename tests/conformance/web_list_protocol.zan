// Every list screen answers the same five parameters -- page, limit, order, dir,
// kw -- read once through Controller.Paged / ListQuery.From with the server's
// bounds, and answers with the same shape (Listing.Json). The compiler documents
// all five from the single Paged() call site, so /api/docs describes a list
// endpoint without the action naming a parameter.
using System;
using System.Net.Http;
using System.Web;

[Route("/api/list")]
class ListDemoController : Controller {
    [HttpGet]
    [Description("列表")]
    void Index() {
        ListQuery q = this.Paged("id", 20);
        this.Ok(Listing.Json("[]", 0, q));
    }

    // An explicit read of one of the five names wins over the expansion: here
    // `kw` is required, and the docs must say so.
    [HttpGet]
    [Description("必填搜索")]
    void Search() {
        string kw = this.Need("kw", "关键词");
        ListQuery q = this.Paged("title", 50);
        this.Ok(Listing.Json("[]", 0, q));
    }
}

class Program {
    static ListQuery Parse(string query) {
        HttpRequest req = new HttpRequest();
        req.method = "GET";
        req.path = "/api/list";
        req.queryString = query;
        HttpContext ctx = new HttpContext(req, "127.0.0.1");
        return ListQuery.From(ctx, "id", 20, 200);
    }

    static void Show(string query) {
        ListQuery q = Program.Parse(query);
        Console.WriteLine("[" + query + "] page=" + Convert.ToString(q.Page())
            + " limit=" + Convert.ToString(q.Limit())
            + " order=" + q.Order()
            + " desc=" + Convert.ToString(q.Desc())
            + " kw=[" + q.Kw() + "]"
            + " skip=" + Convert.ToString(q.Skip())
            + " qs=" + q.QueryString());
    }

    static void Main() {
        // Defaults, then each parameter, then the values a client should not get
        // away with: page 0, a negative page size and a limit past the ceiling.
        Program.Show("");
        Program.Show("page=3");
        Program.Show("limit=5&order=title&dir=asc&kw=zan");
        Program.Show("page=0");
        Program.Show("limit=-1");
        Program.Show("limit=100000");
        Program.Show("kw=%20%20spaced%20%20");

        ListQuery q = Program.Parse("limit=10&page=2");
        Console.WriteLine("pages 0=" + Convert.ToString(q.Pages(0))
            + " 10=" + Convert.ToString(q.Pages(10))
            + " 11=" + Convert.ToString(q.Pages(11)));
        Console.WriteLine(Listing.Json("[{\"id\":1}]", 11, q));
        Console.WriteLine(Listing.Json("", 0, q));

        // The docs the compiler wrote from the Paged() call sites.
        WebApp app = new WebApp("127.0.0.1", 0);
        WebHost.Use(app);
        __AttrRoutes.Register(app);
        List<Route> routes = app.router.All();
        for (int i = 0; i < routes.Count; i = i + 1) {
            Route r = routes[i];
            Console.WriteLine(r.method + " " + r.pattern);
            for (int j = 0; j < r.docParams.Count; j = j + 1) {
                ApiParam p = r.docParams[j];
                string def = p.Default();
                if (def.Length == 0) { def = "-"; }
                Console.WriteLine("  " + p.Name() + " " + p.Type()
                    + " required=" + Convert.ToString(p.Required())
                    + " default=" + def + " desc=" + p.Desc());
            }
        }
    }
}
