// 接口数据协议与执行契约。
// by --check-leaks.
using System;

class Holder {
    int value;
    Holder(int v) { this.value = v; }
    int Get() { return this.value; }
}

class Program {
    static List<Holder> cache;
    static Holder single;

    static void Fill() {
        cache = new List<Holder>();
        cache.Add(new Holder(1));
        cache.Add(new Holder(2));
        single = new Holder(3);
    }

    static int Main() {
        Fill();
        if (cache.Count != 2) { Console.WriteLine("bad:count"); return 1; }
        if (cache[0].Get() + cache[1].Get() + single.Get() != 6) {
            Console.WriteLine("bad:sum");
            return 1;
        }
        Console.WriteLine("ok");
        return 0;
    }
}
