using System;
using System.Json;
using Gui;
using Gui.Widget;

namespace Conformance;

public class UserViewModel {
    public string Name;
    public int Age;
    public bool Active;
}

public class AddressEntity {
    public string City;
    public string Street;
}

public class EmployeeEntity {
    public string EmpId;
    public string Role;
}

public class CompanyViewModel {
    public string CorpName;
    public AddressEntity Location;
    public List<object> Staff;
}

class Program {
    static int fails = 0;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static Control Pick(Control root, string id) {
        Control c = root.Find(id);
        if (c == null) {
            fails = fails + 1;
            Console.WriteLine("FAIL find '" + id + "'");
            return new Panel();
        }
        return c;
    }

    static void RunTest() {
        // ====================================================================
        // 场景 1：POCO 强类型实体双向数据绑定 (ModelBinder + POCO Entity)
        // ====================================================================
        UserViewModel vm = new UserViewModel();
        vm.Name = "Alice";
        vm.Age = 25;
        vm.Active = true;

        HtmlDoc doc1 = Html.Parse(
            "<div id=\"page1\">"
            + "<input id=\"uname\" data-bind=\"Name\" />"
            + "<p id=\"uage\" data-bind=\"Age\"></p>"
            + "<span id=\"uactive\" data-if=\"Active\">User Active</span>"
            + "</div>", "", null);
        Control page1 = doc1.root.children[0];

        ModelBinder b1 = new ModelBinder();
        b1.SetRoot(page1, vm);
        b1.Wire();

        Control uname = Pick(page1, "uname");
        Control uage = Pick(page1, "uage");
        Control uactive = Pick(page1, "uactive");

        Eq("poco uname init", uname.GetProp("value"), "Alice");
        Eq("poco uage init", uage.GetProp("text"), "25");
        Eq("poco uactive visible", Convert.ToString(uactive.visible), "true");

        // UI -> Model 双向回写 POCO 属性
        uname.SetProp("value", "Bob");
        b1.SyncChangedNode(page1);
        Eq("poco vm.Name updated", vm.Name, "Bob");

        // 翻转布尔属性 -> Model -> UI 同步
        vm.Active = false;
        b1.MarkDirty();
        b1.SyncFromModel();
        Eq("poco uactive hidden", Convert.ToString(uactive.visible), "false");

        b1.Detach();

        // ====================================================================
        // 场景 2：JsonDoc 零拷贝 Tape 模型绑定与 <template data-for> 展开
        // ====================================================================
        string json = "{\"title\":\"Symbol List\",\"items\":[{\"name\":\"App\"},{\"name\":\"Window\"},{\"name\":\"Control\"}]}";
        JsonDoc doc = JsonDoc.Parse(json);

        HtmlDoc doc2 = Html.Parse(
            "<div id=\"page2\">"
            + "<h1 id=\"title\" data-bind=\"title\"></h1>"
            + "<template data-for=\"items\">"
            + "<li><span data-bind=\"name\"></span></li>"
            + "</template>"
            + "</div>", "", null);
        Control page2 = doc2.root.children[0];

        ModelBinder b2 = new ModelBinder();
        b2.SetRoot(page2, doc);
        b2.Wire();

        Control title = Pick(page2, "title");
        Eq("doc title", title.GetProp("text"), "Symbol List");

        // 验证 data-for 模板行展开
        // page2 孩子：h1 (0), template (1), row0 (2), row1 (3), row2 (4) -> 共 5 个
        Eq("doc kids count", Convert.ToString(page2.ChildCount()), "5");
        Control row0 = page2.children[2];
        Control row1 = page2.children[3];
        Control row2 = page2.children[4];

        Eq("doc row0 text", row0.children[0].GetProp("text"), "App");
        Eq("doc row1 text", row1.children[0].GetProp("text"), "Window");
        Eq("doc row2 text", row2.children[0].GetProp("text"), "Control");

        b2.Detach();

        // ====================================================================
        // 场景 3：现有 JsonValue 完全向后兼容
        // ====================================================================
        JsonValue jv = JsonValue.Parse("{\"city\":\"Berlin\",\"code\":49}");
        HtmlDoc doc3 = Html.Parse(
            "<div id=\"page3\">"
            + "<input id=\"city\" data-bind=\"city\" />"
            + "<span id=\"code\" data-bind=\"code\"></span>"
            + "</div>", "", null);
        Control page3 = doc3.root.children[0];

        ModelBinder b3 = new ModelBinder();
        b3.SetRoot(page3, jv);
        b3.Wire();

        Control city = Pick(page3, "city");
        Eq("jv city init", city.GetProp("value"), "Berlin");

        city.SetProp("value", "Munich");
        b3.SyncChangedNode(page3);
        JsonValue cv = jv.PathGet("city");
        Eq("jv city updated", cv != null ? cv.AsString("") : "", "Munich");

        b3.Detach();

        // ====================================================================
        // 场景 4：JsonDoc + data-key 键控增量 diff 与 DOM 节点原地复用
        // ====================================================================
        string jsonKeyed1 = "{\"items\":[{\"id\":\"k1\",\"val\":\"first\"},{\"id\":\"k2\",\"val\":\"second\"}]}";
        JsonDoc jdocKeyed1 = JsonDoc.Parse(jsonKeyed1);

        HtmlDoc doc4 = Html.Parse(
            "<div id=\"page4\">"
            + "<template data-for=\"items\" data-key=\"id\">"
            + "  <div class=\"item-row\"><span data-bind=\"val\"></span></div>"
            + "</template>"
            + "</div>", "", null);
        Control page4 = doc4.root.children[0];

        ModelBinder b4 = new ModelBinder();
        b4.SetRoot(page4, jdocKeyed1);
        b4.Wire();

        // 验证初始生成两个行
        Eq("doc4 kids count", Convert.ToString(page4.ChildCount()), "3"); // template (0), row1 (1), row2 (2)
        Control initialRow1 = page4.children[1];
        Control initialRow2 = page4.children[2];
        Eq("initial row1 val", initialRow1.children[0].GetProp("text"), "first");
        Eq("initial row2 val", initialRow2.children[0].GetProp("text"), "second");

        // 更新模型：k1 保留但 val 变更，k2 移除，新增 k3
        string jsonKeyed2 = "{\"items\":[{\"id\":\"k1\",\"val\":\"first_updated\"},{\"id\":\"k3\",\"val\":\"third\"}]}";
        JsonDoc jdocKeyed2 = JsonDoc.Parse(jsonKeyed2);
        b4.SetRoot(page4, jdocKeyed2);
        b4.SyncFromModel();

        // 验证行数仍为 3（template + 2 行）
        Eq("doc4 kids count after update", Convert.ToString(page4.ChildCount()), "3");
        Control updatedRow1 = page4.children[1];
        Control newRow3 = page4.children[2];

        // 关键断言：k1 对应的 DOM 控件实例必须原地复用（引用相等）！
        Eq("row1 DOM reused", updatedRow1 == initialRow1 ? "true" : "false", "true");
        Eq("row1 val updated", updatedRow1.children[0].GetProp("text"), "first_updated");
        Eq("new row3 val", newRow3.children[0].GetProp("text"), "third");

        // 注销解绑并断言 Detach 行为
        b4.Detach();
        Eq("b4 root detached", b4.Root() == null ? "true" : "false", "true");

        // ====================================================================
        // 场景 5：POCO 嵌套子实体（Location.City）与实体列表展开（Staff）
        // ====================================================================
        CompanyViewModel corp = new CompanyViewModel();
        corp.CorpName = "ZanTech";
        corp.Location = new AddressEntity();
        corp.Location.City = "Kyoto";
        corp.Location.Street = "Gion";
        corp.Staff = new List<object>();

        EmployeeEntity emp1 = new EmployeeEntity();
        emp1.EmpId = "E101";
        emp1.Role = "Architect";
        corp.Staff.Add(emp1);

        EmployeeEntity emp2 = new EmployeeEntity();
        emp2.EmpId = "E102";
        emp2.Role = "Engineer";
        corp.Staff.Add(emp2);

        HtmlDoc doc5 = Html.Parse(
            "<div id=\"page5\">"
            + "<h1 id=\"cname\" data-bind=\"CorpName\"></h1>"
            + "<input id=\"city\" data-bind=\"Location.City\" />"
            + "<template data-for=\"Staff\" data-key=\"EmpId\">"
            + "  <div class=\"emp-row\"><span data-bind=\"Role\"></span></div>"
            + "</template>"
            + "</div>", "", null);
        Control page5 = doc5.root.children[0];

        ModelBinder b5 = new ModelBinder();
        b5.SetRoot(page5, corp);
        b5.Wire();

        Control cname = Pick(page5, "cname");
        Control cityCtrl = Pick(page5, "city");
        Eq("corp name init", cname.GetProp("text"), "ZanTech");
        Eq("corp city init", cityCtrl.GetProp("value"), "Kyoto");

        // 验证嵌套属性回写：修改控件后回写到 Location.City
        cityCtrl.SetProp("value", "Osaka");
        b5.SyncChangedNode(page5);
        Eq("corp city updated", corp.Location.City, "Osaka");

        // 验证实体列表 Staff 展开为模板行
        // 孩子结构：h1(0), input(1), template(2), row1(3), row2(4) -> 共 5 个节点
        Eq("page5 kids count", Convert.ToString(page5.ChildCount()), "5");
        Control empRow1 = page5.children[3];
        Control empRow2 = page5.children[4];
        Eq("emp1 role", empRow1.children[0].GetProp("text"), "Architect");
        Eq("emp2 role", empRow2.children[0].GetProp("text"), "Engineer");

        b5.Detach();
        Eq("b5 root detached", b5.Root() == null ? "true" : "false", "true");
    }

    static void Main() {
        fails = 0;
        Html.Install();
        ControlBootstrap.Install();

        RunTest();

        if (fails == 0) {
            Console.WriteLine("GUI_MODEL_POCO_JSONDOC_OK");
        }
    }
}
