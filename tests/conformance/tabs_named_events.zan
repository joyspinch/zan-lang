using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

class TabsNamedEventWitness {
    public weak Control Expected;
    public int Changed;
    public int Closed;
    public int Added;
    public int Clicked;
    public int ChangedSenders;
    public int ClosedSenders;
    public int AddedSenders;
    public int ClickedSenders;
    public bool WrongSender;
    public void Change() { Changed = Changed + 1; }
    public void Close() { Closed = Closed + 1; }
    public void Add() { Added = Added + 1; }
    public void Click() { Clicked = Clicked + 1; }
    public void ChangeSender(Control sender) { ChangedSenders = ChangedSenders + 1; WrongSender = WrongSender || sender != Expected; }
    public void CloseSender(Control sender) { ClosedSenders = ClosedSenders + 1; WrongSender = WrongSender || sender != Expected; }
    public void AddSender(Control sender) { AddedSenders = AddedSenders + 1; WrongSender = WrongSender || sender != Expected; }
    public void ClickSender(Control sender) { ClickedSenders = ClickedSenders + 1; WrongSender = WrongSender || sender != Expected; }
}

class Program {
    static void Check(bool ok, string message) { if (!ok) { throw new Exception(message); } }
    static bool Has(List<string> names, string expected) {
        for (int i = 0; i < names.Count; i = i + 1) { if (names[i] == expected) { return true; } }
        return false;
    }
    static void Main() {
        Tabs tabs = new Tabs(); tabs.Add("First", true); tabs.Add("Second", true); tabs.SetShowAdd(true);
        Control control = tabs;
        TabsNamedEventWitness witness = new TabsNamedEventWitness(); witness.Expected = tabs;
        UiEvent changed = tabs.TabChanged; UiEvent closed = tabs.TabClosed; UiEvent added = tabs.TabAdded;
        List<string> names = control.Events();
        Check(Has(names, "TabChanged") && Has(names, "TabClosed") && Has(names, "TabAdded") && Has(names, "Click"),
            "Tabs publishes semantic and inherited events");
        control.BindEvent("TabChanged", witness.Change); control.BindEvent("TabChanged", witness.ChangeSender);
        control.BindEvent("TabClosed", witness.Close); control.BindEvent("TabClosed", witness.CloseSender);
        control.BindEvent("TabAdded", witness.Add); control.BindEvent("TabAdded", witness.AddSender);
        control.BindEvent("Click", witness.Click); control.BindEvent("Click", witness.ClickSender);
        Check(tabs.TabChanged == changed && tabs.TabClosed == closed && tabs.TabAdded == added,
            "named binding preserves existing typed event identity");
        Check(changed.Count() == 2 && closed.Count() == 2 && added.Count() == 2, "named binding attaches to the typed events");
        Button select = (Button)tabs.navStrip.ChildAt(1); select.Click.Raise(select);
        Check(tabs.Active() == 1 && witness.Changed == 1 && witness.ChangedSenders == 1,
            "select button fires both named event channels");
        Button selected = (Button)tabs.navStrip.ChildAt(1);
        Button close = (Button)selected.ChildAt(1); close.Click.Raise(close);
        Check(tabs.Count() == 1 && witness.Changed == 2 && witness.ChangedSenders == 2
            && witness.Closed == 1 && witness.ClosedSenders == 1, "close button fires both named event channels");
        Button add = (Button)tabs.navStrip.ChildAt(tabs.Count()); add.Click.Raise(add);
        Check(witness.Added == 1 && witness.AddedSenders == 1, "add button fires both named event channels");
        tabs.Click.Raise(tabs);
        Check(witness.Clicked == 1 && witness.ClickedSenders == 1 && !witness.WrongSender,
            "common event fallback keeps sender identity");
        Console.WriteLine("tabs named events OK");
    }
}
