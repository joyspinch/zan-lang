// 核心契约与语义定义。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
using System;
using System.Web;

class Program {
    static int failures = 0;

    static void Check(string got, string want, string name) {
        if (got == want) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name + " got=[" + got + "] want=[" + want + "]");
            failures = failures + 1;
        }
    }

    static string R(string tpl, string x) {
        ViewData d = new ViewData();
        d.Set("x", x);
        return View.RenderStr(tpl, d, null);
    }

    static string R2(string tpl, string a, string b) {
        ViewData d = new ViewData();
        d.Set("a", a);
        d.Set("b", b);
        return View.RenderStr(tpl, d, null);
    }

    static async int Run() {
        // 核心契约与语义定义。
        Check(R("{{#if x}}A{{else}}B{{/if}}", "1"), "A", "then when non-empty");
        Check(R("{{#if x}}A{{else}}B{{/if}}", "0"), "B", "else when zero");
        Check(R("{{#if x}}A{{else}}B{{/if}}", ""), "B", "else when empty");
        Check(R("{{#if x}}A{{else}}B{{/if}}", "false"), "B", "else when false");
        // 接口数据协议与执行契约。
        Check(R("{{#if x}}A{{/if}}", "1"), "A", "no-else then");
        Check(R("{{#if x}}A{{/if}}", "0"), "", "no-else falsy empty");
        // 接口数据协议与执行契约。
        string NT = "{{#if a}}X{{#if b}}Y{{else}}Z{{/if}}{{else}}W{{/if}}";
        Check(R2(NT, "1", "1"), "XY", "nested both true");
        Check(R2(NT, "1", "0"), "XZ", "nested inner else");
        Check(R2(NT, "0", "1"), "W", "nested outer else");
        // 接口数据协议与执行契约。
        Check(R2("{{#if a}}X{{#if b}}Y{{/if}}{{else}}W{{/if}}", "1", "1"),
            "XY", "outer else skipped when true");
        Check(R2("{{#if a}}X{{#if b}}Y{{/if}}{{else}}W{{/if}}", "0", "1"),
            "W", "outer else taken when false");
        // 接口数据协议与执行契约。
        ViewData d = new ViewData();
        List<StrMap> rows = d.AddList("rows");
        StrMap r1 = new StrMap();
        r1.Set("v", "1");
        rows.Add(r1);
        StrMap r2 = new StrMap();
        r2.Set("v", "");
        rows.Add(r2);
        Check(View.RenderStr("{{#each rows}}<{{#if v}}Y{{else}}N{{/if}}>{{/each}}", d, null),
            "<Y><N>", "each row else per row");
        // 接口数据协议与执行契约。
        Check(R("{{#if x}}{{x}}{{else}}B{{/if}}", "1"), "1", "then keeps body");
        Console.WriteLine("failures=" + failures.ToString());
        return 0;
    }

    static void Main() {
        int r = await Run();
    }
}
