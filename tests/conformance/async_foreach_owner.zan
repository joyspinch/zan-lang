using System;

class ConformanceAsyncForeachOwner {
    static int[] MakeArray() {
        int[] arr = new int[3];
        arr[0] = 10;
        arr[1] = 20;
        arr[2] = 30;
        return arr;
    }

    static string MakeString() {
        return "abc";
    }

    static async int TestArrayNormal() {
        int sum = 0;
        foreach (int x in MakeArray()) {
            await Task.Yield();
            sum = sum + x;
        }
        return sum;
    }

    static async int TestArrayBreak() {
        int sum = 0;
        foreach (int x in MakeArray()) {
            await Task.Yield();
            sum = sum + x;
            if (sum >= 10) break;
        }
        return sum;
    }

    static async int TestArrayThrow() {
        int sum = 0;
        try {
            foreach (int x in MakeArray()) {
                await Task.Yield();
                sum = sum + x;
                if (sum >= 10) throw new Exception("test throw in foreach");
            }
        } catch (Exception e) {
            sum = sum + 1000;
        }
        return sum;
    }

    static async int TestStringNormal() {
        int sum = 0;
        foreach (char c in MakeString()) {
            await Task.Yield();
            sum = sum + (int)c;
        }
        return sum;
    }

    static async int TestStringBreak() {
        int sum = 0;
        foreach (char c in MakeString()) {
            await Task.Yield();
            sum = sum + (int)c;
            break;
        }
        return sum;
    }

    static async int TestStringThrow() {
        int sum = 0;
        try {
            foreach (char c in MakeString()) {
                await Task.Yield();
                sum = sum + (int)c;
                throw new Exception("test throw in str foreach");
            }
        } catch (Exception e) {
            sum = sum + 2000;
        }
        return sum;
    }

    static async void Main() {
        int a1 = await TestArrayNormal();
        int a2 = await TestArrayBreak();
        int a3 = await TestArrayThrow();
        int s1 = await TestStringNormal();
        int s2 = await TestStringBreak();
        int s3 = await TestStringThrow();

        if (a1 != 60 || a2 != 10 || a3 != 1010 || s1 != 294 || s2 != 97 || s3 != 2097) {
            Console.WriteLine($"FAIL: a1={a1}, a2={a2}, a3={a3}, s1={s1}, s2={s2}, s3={s3}");
            Environment.Exit(1);
        }

        Console.WriteLine("PASS: async foreach owner");
    }
}
