using System;
using System.Platform;
using System.Net.Sockets;

class Program {
    static int Main() {
        Console.WriteLine("pal_network_smoke start");

        // 1. PAL Network 单例
        IPlatformNetwork net = Pal.Network;
        if (net == null) {
            Console.WriteLine("FAIL: Pal.Network is null");
            return 1;
        }

        // 2. 平台特定布尔特性
        #if WINDOWS
        if (!net.SupportsAsyncAcceptOv()) {
            Console.WriteLine("FAIL: Windows must support async accept ov");
            return 1;
        }
        if (!net.IsIpv6Family(23)) {
            Console.WriteLine("FAIL: Windows IPv6 family must be 23");
            return 1;
        }
        if (!net.IsUdpResetError(10054)) {
            Console.WriteLine("FAIL: Windows UDP reset error must be 10054");
            return 1;
        }
        if (net.IsUdpResetError(10000)) {
            Console.WriteLine("FAIL: 10000 is not UDP reset error");
            return 1;
        }
        #endif

        // 3. 纯 Zan 网络字节序翻转
        ushort port = 8080;
        ushort nport = Socket.Htons(port);
        if (nport != 36895) {
            Console.WriteLine("FAIL: Htons 8080 != 36895, got " + nport);
            return 1;
        }
        ushort hport = Socket.Ntohs(nport);
        if (hport != port) {
            Console.WriteLine("FAIL: Ntohs != 8080, got " + hport);
            return 1;
        }

        int val = 305419896; // 0x12345678
        int nval = Socket.Htonl(val);
        if (nval != 2018915346) { // 0x78563412
            Console.WriteLine("FAIL: Htonl 0x12345678 != 0x78563412");
            return 1;
        }
        int hval = Socket.Ntohl(nval);
        if (hval != val) {
            Console.WriteLine("FAIL: Ntohl != original value");
            return 1;
        }

        // 4. 纯 Zan 点分 IPv4 文本解析
        int ip1 = Socket.InetAddr("127.0.0.1");
        if (ip1 != 16777343) {
            Console.WriteLine("FAIL: InetAddr(127.0.0.1) != 16777343, got " + ip1);
            return 1;
        }
        int ipZero = Socket.InetAddr("0.0.0.0");
        if (ipZero != 0) {
            Console.WriteLine("FAIL: InetAddr(0.0.0.0) != 0, got " + ipZero);
            return 1;
        }
        int ipBcast = Socket.InetAddr("255.255.255.255");
        if (ipBcast != -1) {
            Console.WriteLine("FAIL: InetAddr(255.255.255.255) != -1, got " + ipBcast);
            return 1;
        }
        int ipErr1 = Socket.InetAddr("invalid");
        if (ipErr1 != -1) {
            Console.WriteLine("FAIL: InetAddr(invalid) != -1");
            return 1;
        }
        int ipErr2 = Socket.InetAddr("999.0.0.1");
        if (ipErr2 != -1) {
            Console.WriteLine("FAIL: InetAddr(999.0.0.1) != -1");
            return 1;
        }
        int ipErr3 = Socket.InetAddr("");
        if (ipErr3 != -1) {
            Console.WriteLine("FAIL: InetAddr empty != -1");
            return 1;
        }

        // 5. 纯 Zan sockaddr_in 构建
        byte[] sa = net.CreateSockAddrV4(ip1, 8080);
        if (sa.Length != 16) {
            Console.WriteLine("FAIL: sockaddr length != 16");
            return 1;
        }
        #if !MACOS
        if (sa[0] != 2) {
            Console.WriteLine("FAIL: sockaddr family != 2");
            return 1;
        }
        #endif
        if (sa[2] != (byte)(36895 & 255) || sa[3] != (byte)((36895 >> 8) & 255)) {
            Console.WriteLine("FAIL: sockaddr port mismatch");
            return 1;
        }

        // 6. 套接字句柄生命周期与选项下沉
        nint s = Socket.CreateTcp();
        if (s < 0) {
            Console.WriteLine("FAIL: Socket.CreateTcp returned invalid handle: " + s);
            return 1;
        }
        int nb = Socket.SetNonBlocking(s);
        if (nb != 0) {
            Console.WriteLine("FAIL: SetNonBlocking returned " + nb);
            Socket.Close(s);
            return 1;
        }
        Socket.SetReuseAddr(s);
        Socket.SetNoDelay(s);
        Socket.Close(s);

        Console.WriteLine("pal_network_smoke ok");
        return 0;
    }
}
