using System;
using System.Json;
using Platform;
using Sdk.Steam;
using Sdk.Wechat;
using Sdk.Jd;

class Program {
    static void Main() {
        // 1. Platform.Runtime
        Console.WriteLine("platform_valid=" + (Runtime.GetPlatform().Length > 0));
        Console.WriteLine("os_detected=" + (Runtime.IsWindows() || Runtime.IsLinux() || Runtime.IsMacOS()));
        Console.WriteLine("has_pid=" + (Runtime.GetProcessId() > 0));

        // 2. Sdk.Steam
        string steamJson = "{\"response\":{\"player_count\":42,\"name\":\"GabeN\",\"vacbanned\":false,\"hours\":\"123456789012\"}}";
        SteamResponse sResp = SteamResponse.Parse(200, steamJson);
        Console.WriteLine("steam_count=" + sResp.Int("response.player_count", 0));
        Console.WriteLine("steam_name=" + sResp.Str("response.name", ""));
        Console.WriteLine("steam_vac=" + sResp.Bool("response.vacbanned", true));
        Console.WriteLine("steam_hours=" + sResp.Long("response.hours", 0));

        string achJson = "{\"name\":\"ACH_WIN\",\"displayName\":\"Winner\",\"description\":\"Won\",\"hidden\":0,\"icon\":\"http://i\",\"icongray\":\"http://g\"}";
        SteamAchievement ach = SteamAchievement.From(JsonValue.Parse(achJson));
        Console.WriteLine("ach_name=" + ach.Name + "|" + ach.DisplayName);

        string gameJson = "{\"appid\":730,\"name\":\"CS:GO\",\"playtime_forever\":1000,\"playtime_2weeks\":50,\"rtime_last_played\":1600000000}";
        SteamOwnedGame game = SteamOwnedGame.From(JsonValue.Parse(gameJson));
        Console.WriteLine("game_name=" + game.Name + "|" + game.AppId + "|" + game.PlaytimeForeverMinutes);

        string ticketJson = "{\"response\":{\"params\":{\"result\":\"OK\",\"steamid\":\"76561197960287930\",\"ownersteamid\":\"76561197960287930\",\"vacbanned\":0,\"publisherbanned\":0}}}";
        SteamTicketResult ticket = SteamTicketResult.Parse(JsonValue.Parse(ticketJson));
        Console.WriteLine("ticket_steamid=" + ticket.SteamId + "|vac=" + ticket.VacBanned);

        // 3. Sdk.Wechat
        string sig = CheckSignature.GetSignature("1700000000", "nonce123", "token456");
        bool sigValid = CheckSignature.Check(sig, "1700000000", "nonce123", "token456");
        Console.WriteLine("wechat_sig_valid=" + sigValid);

        string wxJson = "{\"errcode\":0,\"errmsg\":\"ok\",\"access_token\":\"TEST_TOKEN\",\"expires_in\":7200}";
        WechatResponse wxResp = WechatResponse.Parse(wxJson);
        Console.WriteLine("wechat_token=" + wxResp.Str("access_token", "") + "|expires=" + wxResp.Int("expires_in", 0));
        Console.WriteLine("wechat_query_name=" + WechatCredential.QueryName(WechatCredentialKind.AccessToken));

        // 4. Sdk.Jd
        Dictionary<string, string> p = new Dictionary<string, string>();
        p.Add("method", "jingdong.order.get");
        p.Add("app_key", "test_app_key");
        p.Add("v", "2.0");
        string jdSign = JdSign.Compute(p, "test_secret");
        Console.WriteLine("jd_sign_len=" + jdSign.Length);

        JdRequest req = new JdRequest("jingdong.order.get");
        req.Set("orderId", "12345").SetInt("page", 1);
        Console.WriteLine("jd_param_json=" + req.ParamJson());

        string jdJson = "{\"jingdong_order_get_responce\":{\"code\":\"0\",\"order_info\":{\"order_id\":\"12345\"}}}";
        JdResponse jdResp = JdResponse.Parse(jdJson);
        Console.WriteLine("jd_resp_has_data=" + (jdResp.Data.Length > 0));

        string ts = JdClient.FormatTimestamp(1700000000, 480);
        Console.WriteLine("jd_timestamp=" + ts);

        Console.WriteLine("platform_sdk_hardening_ok");
    }
}
