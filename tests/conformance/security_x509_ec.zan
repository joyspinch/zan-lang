    static string Pem(string b64) {
        string out1 = "-----BEGIN CERTIFICATE-----\n";
        int pos = 0;
        while (pos < b64.Length) {
            int take = 64;
            if (pos + take > b64.Length) { take = b64.Length - pos; }
            out1 = out1 + b64.Substring(pos, take) + "\n";
            pos = pos + take;
        }
        return out1 + "-----END CERTIFICATE-----\n";
    }

    static void TestParseKeyTypes() {
        X509Certificate ecroot = X509Certificate.FromPem(Pem(ECROOT_B64));
        Check(ecroot != null && ecroot.HasEcKey() && ecroot.SigIsEcdsa(), "ecroot parses as EC with ECDSA sig");
        X509Certificate ecleaf = X509Certificate.FromPem(Pem(ECLEAF_B64));
        Check(ecleaf != null && ecleaf.HasEcKey() && ecleaf.SigIsEcdsa(), "ecleaf parses as EC with ECDSA sig");
        X509Certificate rsaleaf = X509Certificate.FromPem(Pem(RSALEAF_B64));
        Check(rsaleaf != null && !rsaleaf.HasEcKey() && rsaleaf.SigIsEcdsa(), "RSA-key leaf issued by EC root: RSA key with ECDSA sig");
        // 混合型：EC 公钥 + RSA 根签发（签名算法 RSA）。两个判定必须解耦。
        X509Certificate ecleafR = X509Certificate.FromPem(Pem(ECLEAFR_B64));
        Check(ecleafR != null && ecleafR.HasEcKey() && !ecleafR.SigIsEcdsa(), "hybrid EC-key/RSA-sig leaf keeps both fields");
        X509Certificate ed = X509Certificate.FromPem(Pem(EDROOT_B64));
        Check(ed == null, "Ed25519 certificate fails closed on parse");
    }

    static void TestVerifyMatrix() {
        X509Certificate ecroot = X509Certificate.FromPem(Pem(ECROOT_B64));
        X509Certificate ecrootpl = X509Certificate.FromPem(Pem(ECROOTPL_B64));
        X509Certificate rsaroot = X509Certificate.FromPem(Pem(RSAROOT_B64));
        X509Certificate rsasame = X509Certificate.FromPem(Pem(RSASAME_B64));
        X509Certificate ecsub = X509Certificate.FromPem(Pem(ECSUB_B64));
        X509Certificate ecleaf = X509Certificate.FromPem(Pem(ECLEAF_B64));
        X509Certificate ecleafR = X509Certificate.FromPem(Pem(ECLEAFR_B64));
        X509Certificate ecleafpl = X509Certificate.FromPem(Pem(ECLEAFPL_B64));
        X509Certificate ecleafdeep = X509Certificate.FromPem(Pem(ECLEAFDEEP_B64));
        if (ecroot == null || ecrootpl == null || rsaroot == null || rsasame == null || ecsub == null
            || ecleaf == null || ecleafR == null || ecleafpl == null || ecleafdeep == null) {
            Check(false, "verify matrix fixtures parse");
            return;
        }
        Check(ecleaf.VerifySignedBy(ecroot), "EC leaf verifies under EC root");
        Check(ecleafpl.VerifySignedBy(ecrootpl), "EC leaf direct under pathlen-0 root verifies");
        Check(ecleafR.VerifySignedBy(rsaroot), "EC-key leaf with RSA sig verifies under RSA root");
        Check(ecleafdeep.VerifySignedBy(ecsub), "deep EC leaf verifies against its direct issuer");
        Check(!ecleaf.VerifySignedBy(rsasame), "same-CN RSA root refuses ECDSA-signed leaf");
        Check(!ecleafR.VerifySignedBy(ecroot), "RSA-signed leaf refuses EC issuer key");
        // 篡改签名位：ECDSA 数学本身必须拒绝（不止密钥类型/查找层）。
        // 常量为 ecleaf DER 翻倒数第 8 字节（签名 s 整数中段，DER 结构不变）。
        X509Certificate tamperedCert = X509Certificate.FromPem(Pem(ECLEAF_TAMPERED_B64));
        Check(tamperedCert != null, "tampered signature still parses");
        Check(tamperedCert == null || !tamperedCert.VerifySignedBy(ecroot), "tampered ECDSA signature refused under correct root");
    }

    static async void EcServerLoop(TlsContext tls, int port, int conns) {
        TcpListener l = new TcpListener("127.0.0.1", port);
        l.Start();
        for (int n = 0; n < conns; n = n + 1) {
            nint sock = await l.AcceptAsync();
            if (sock < 0) { break; }
            await HandleEcConn(tls, sock);
            Socket.Close(sock);
        }
        l.Stop();
    }

    static async void HandleEcConn(TlsContext tls, nint sock) {
        TlsStream s = await TlsStream.AcceptAsync(tls, sock, 10000);
        if (s == null) {
            return;
        }
        string got = await s.RecvAsync(256);
        int _w = await s.SendStringAsync("pong:" + got);
        s.Close();
    }

    static bool exOk;
    static int exChain;
    static string exReply;

    static async void EcExchange(TlsContext ctx, int port, string host, string ping) {
        Program.exOk = false;
        Program.exChain = 0;
        Program.exReply = "";
        nint sock = Socket.CreateTcp();
        Socket.SetNonBlocking(sock);
        int rc = await Socket.ConnectAsync(sock, "127.0.0.1", port, 5000);
        if (rc != 0) {
            Socket.Close(sock);
            return;
        }
        TlsStream s = await TlsStream.ConnectAsync(ctx, sock, host, 10000);
        if (s == null) {
            Socket.Close(sock);
            return;
        }
        Program.exOk = true;
        Program.exChain = s.engine.peerChain.Count;
        int _s = await s.SendStringAsync(ping);
        Program.exReply = await s.RecvAsync(256);
        s.Close();
        Socket.Close(sock);
    }

    static async int Run() {
        TestParseKeyTypes();
        TestVerifyMatrix();

        Directory.CreateDirectory("_scratch");
        File.WriteAllText("_scratch/x509e_ecroot.pem", Pem(ECROOT_B64));
        File.WriteAllText("_scratch/x509e_ecrootpl.pem", Pem(ECROOTPL_B64));
        File.WriteAllText("_scratch/x509e_rsaroot.pem", Pem(RSAROOT_B64));
        File.WriteAllText("_scratch/x509e_rsasame.pem", Pem(RSASAME_B64));
        File.WriteAllText("_scratch/x509e_srv_ec.pem", Pem(ECLEAF_B64));
        File.WriteAllText("_scratch/x509e_srv_ecR.pem", Pem(ECLEAFR_B64));
        File.WriteAllText("_scratch/x509e_srv_rsa.pem", Pem(RSALEAF_B64));
        File.WriteAllText("_scratch/x509e_srv_deep.pem", Pem(ECLEAFDEEP_B64) + Pem(ECSUB_B64));
        File.WriteAllText("_scratch/x509e_ecleaf.key", EC_LEAF_KEY);
        File.WriteAllText("_scratch/x509e_ecleafR.key", EC_LEAFR_KEY);
        File.WriteAllText("_scratch/x509e_ecleafdeep.key", EC_LEAFDEEP_KEY);
        File.WriteAllText("_scratch/x509e_rsaleaf.key", RSA_LEAF_KEY);

        TlsContext s13 = TlsContext.CreateServer("_scratch/x509e_srv_ec.pem", "_scratch/x509e_ecleaf.key");
        TlsContext s12 = TlsContext.CreateServer("_scratch/x509e_srv_ec.pem", "_scratch/x509e_ecleaf.key");
        TlsContext sHybridEc = TlsContext.CreateServer("_scratch/x509e_srv_ecR.pem", "_scratch/x509e_ecleafR.key");
        TlsContext sHybridRsa = TlsContext.CreateServer("_scratch/x509e_srv_rsa.pem", "_scratch/x509e_rsaleaf.key");
        TlsContext sDeep = TlsContext.CreateServer("_scratch/x509e_srv_deep.pem", "_scratch/x509e_ecleafdeep.key");
        Check(s13 != null && s12 != null && sHybridEc != null && sHybridRsa != null && sDeep != null,
            "all EC server bundles parsed");
        if (s13 == null || s12 == null || sHybridEc == null || sHybridRsa == null || sDeep == null) {
            Console.WriteLine("failures=" + Convert.ToString(failures));
            return 0;
        }
        Task.Spawn(EcServerLoop(s13, 9608, 3));
        Task.Spawn(EcServerLoop(s12, 9609, 1));
        Task.Spawn(EcServerLoop(sHybridEc, 9610, 1));
        Task.Spawn(EcServerLoop(sHybridRsa, 9611, 1));
        Task.Spawn(EcServerLoop(sDeep, 9612, 1));
        await Task.Delay(150);

        TlsContext cEc = TlsContext.CreateClient();
        Check(cEc.AddTrustedCert("_scratch/x509e_ecroot.pem"), "ecroot anchor loaded");
        TlsContext cSameName = TlsContext.CreateClient();
        Check(cSameName.AddTrustedCert("_scratch/x509e_rsasame.pem"), "same-CN RSA anchor loaded");
        TlsContext cRsa = TlsContext.CreateClient();
        Check(cRsa.AddTrustedCert("_scratch/x509e_rsaroot.pem"), "RSA anchor loaded");
        TlsContext cEcPl = TlsContext.CreateClient();
        Check(cEcPl.AddTrustedCert("_scratch/x509e_ecrootpl.pem"), "pathlen-0 EC anchor loaded");

        await EcExchange(cEc, 9608, "ec.localhost", "e1");
        Check(Program.exOk, "tls13 EC server connects with EC anchor");
        Check(Program.exChain == 1, "single-cert EC chain length 1");
        Check(Program.exReply == "pong:e1", "tls13 EC app data roundtrip");

        await EcExchange(cSameName, 9608, "ec.localhost", "e2");
        Check(!Program.exOk, "same-CN RSA anchor refused on EC server");

        await EcExchange(cRsa, 9608, "ec.localhost", "e3");
        Check(!Program.exOk, "unrelated RSA anchor refused on EC server");

        TlsContext c12 = TlsContext.CreateClient();
        c12.AddTrustedCert("_scratch/x509e_ecroot.pem");
        c12.DisableTls13();
        await EcExchange(c12, 9609, "ec.localhost", "e4");
        Check(Program.exOk, "tls12 EC server (ECDHE_ECDSA) connects");
        Check(Program.exReply == "pong:e4", "tls12 EC app data roundtrip");

        await EcExchange(cRsa, 9610, "ec.localhost", "e5");
        Check(Program.exOk, "tls13 EC-key leaf under RSA root negotiates by key type");

        TlsContext cEcLocal = TlsContext.CreateClient();
        cEcLocal.AddTrustedCert("_scratch/x509e_ecroot.pem");
        await EcExchange(cEcLocal, 9611, "localhost", "e6");
        Check(Program.exOk, "tls13 RSA-key leaf under EC root negotiates by key type");

        await EcExchange(cEcPl, 9612, "ec.localhost", "e7");
        Check(!Program.exOk, "deep chain violating pathlen-0 EC root refused");

        Socket.Cleanup();
        Console.WriteLine("failures=" + Convert.ToString(failures));
        return 0;
    }

    static void Main() {
        int r = await Run();
    }
}
