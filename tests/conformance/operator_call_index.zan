class CallableTable {
    List<int> vals;
    int named;

    CallableTable() {
        this.vals = new List<int>();
        this.vals.Add(10);
        this.vals.Add(20);
        this.vals.Add(30);
        this.named = 42;
    }

    static int op_call(CallableTable self, int val) {
        return val * 2;
    }

    static int op_call(CallableTable self, params int[] vals) {
        int total = 0;
        for (int i = 0; i < vals.Count; i = i + 1) {
            total = total + vals[i];
        }
        return total;
    }

    static string op_call(CallableTable self, string val) {
        return "called:" + val;
    }

    static int op_index(CallableTable self, long index) {
        return self.vals[index];
    }

    static int op_index(CallableTable self, string key) {
        return self.named;
    }

    static void op_index_set(CallableTable self, long index, int val) {
        self.vals[index] = val;
    }

    static void op_index_set(CallableTable self, string key, int val) {
        self.named = val;
    }
}

class Program {
    static CallableTable Make() {
        return new CallableTable();
    }

    static void Main() {
        CallableTable table = new CallableTable();
        Console.WriteLine(table(7));
        Console.WriteLine(table(1, 2, 3, 4));
        List<int> packed = new List<int>();
        packed.Add(5);
        packed.Add(6);
        Console.WriteLine(table(packed));
        Console.WriteLine(table("zan"));
        Console.WriteLine(table[1]);
        Console.WriteLine(table["answer"]);
        table[1] = 99;
        table["answer"] = 84;
        Console.WriteLine(table[1]);
        Console.WriteLine(table["answer"]);
        Console.WriteLine(Make()(5));
        Console.WriteLine(Make()[2]);
    }
}
