using System;

// A458：泛型形参特化成**值类型**后与 null 比较。
//
// 缺陷：`v == null`（v 的静态类型是类型参数 T）在 T 特化成结构体后，
// 左侧是聚合值、右侧是空指针，比较直接落到 `icmp eq %struct.Point, ptr null`
// —— LLVM 校验失败（Both operands to ICmp instruction are not of the same
// type），编译器编译失败。
//
// 语义口径：值类型永远不是 null，所以 `v == null` 恒为 false；
// `v != null` 恒为 true。引用类型仍按指针比较。

struct Pt { public int x; public int y; }
class Box { public int v; }

public class Program {
    static bool IsNull<T>(T v) {
        return v == null;
    }

    static bool IsNotNull<T>(T v) {
        return v != null;
    }

    public static void Main() {
        int fail = 0;

        Pt p = new Pt();
        p.x = 3;
        if (IsNull<Pt>(p)) {
            Console.WriteLine("FAIL: struct value is not null");
            fail++;
        }
        if (!IsNotNull<Pt>(p)) {
            Console.WriteLine("FAIL: struct value is not null");
            fail++;
        }

        Box nul = null;
        if (!IsNull<Box>(nul)) {
            Console.WriteLine("FAIL: null class is null");
            fail++;
        }
        if (IsNotNull<Box>(nul)) {
            Console.WriteLine("FAIL: null class is null");
            fail++;
        }

        Box live = new Box();
        live.v = 7;
        if (IsNull<Box>(live)) {
            Console.WriteLine("FAIL: live class is not null");
            fail++;
        }
        if (!IsNotNull<Box>(live)) {
            Console.WriteLine("FAIL: live class is not null");
            fail++;
        }

        if (fail == 0) {
            Console.WriteLine("ALL GENERIC VALUE NULL COMPARE TESTS PASSED");
        }
    }
}
