// Conformance: an `await` used inside a larger expression keeps the awaited
// method's type.
//
// Such an await is hoisted into a temp declared before the statement; the temp
// used to be declared `int`, so a string/list/class result was seen as a number
// by the rest of the expression ("n=" + await F() printed a pointer value).
using System;

class Box {
    int n;
    static Box Of(int n) { Box b = new Box(); b.n = n; return b; }
}

class Program {
    static async string Text() {
        await Task.Delay(1);
        return "hello";
    }

    static async int Num() {
        await Task.Delay(1);
        return 40;
    }

    static async List<string> Rows() {
        await Task.Delay(1);
        List<string> l = new List<string>();
        l.Add("a");
        l.Add("b");
        return l;
    }

    static async Box Wrap(int n) {
        await Task.Delay(1);
        return Box.Of(n);
    }

    static async int Run() {
        Console.WriteLine("concat=" + await Program.Text());
        Console.WriteLine("len=" + Convert.ToString((await Program.Text()).Length));
        Console.WriteLine("sum=" + Convert.ToString(await Program.Num() + 2));
        Console.WriteLine("rows=" + Convert.ToString((await Program.Rows()).Count));
        Console.WriteLine("field=" + Convert.ToString((await Program.Wrap(7)).n));
        List<string> r = await Program.Rows();
        Console.WriteLine("first=" + r[0]);
        return await Program.Num() + await Program.Num();
    }

    static async void Main() {
        Console.WriteLine("total=" + Convert.ToString(await Program.Run()));
    }
}
