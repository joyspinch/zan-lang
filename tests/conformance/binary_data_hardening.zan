using System;
using System.Bson;
using System.Cbor;
using System.Data;
using System.Json;

class Program {
    static void Main() {
        // --- 1. Zan.Bson Hardening ---
        Console.WriteLine("=== BSON TEST ===");
        JsonValue bObj = JsonValue.NewObject();
        bObj.Put("name", JsonValue.NewStr("ZanBson"));
        bObj.Put("version", JsonValue.NewInt(1));
        bObj.Put("pi", JsonValue.NewDouble(3.14159));
        bObj.Put("active", JsonValue.NewBool(true));
        JsonValue tags = JsonValue.NewArray();
        tags.Append(JsonValue.NewStr("binary"));
        tags.Append(JsonValue.NewStr("document"));
        bObj.Put("tags", tags);

        byte[] bsonBytes = Bson.Pack(bObj);
        Console.WriteLine("BSON packed length: " + (bsonBytes.Length > 0 ? "valid" : "invalid"));

        JsonValue bUnpacked = Bson.Unpack(bsonBytes);
        JsonValue vName = bUnpacked.Get("name");
        Console.WriteLine("BSON name: " + (vName != null ? vName.AsString("") : ""));

        JsonValue vVer = bUnpacked.Get("version");
        Console.WriteLine("BSON version: " + Convert.ToString(vVer != null ? vVer.AsLong(0) : 0));

        JsonValue vAct = bUnpacked.Get("active");
        Console.WriteLine("BSON active: " + (vAct != null && vAct.AsBool(false) ? "true" : "false"));

        JsonValue vTags = bUnpacked.Get("tags");
        Console.WriteLine("BSON tags count: " + Convert.ToString(vTags != null ? vTags.Count() : 0));

        // --- 2. Zan.Cbor Hardening ---
        Console.WriteLine("=== CBOR TEST ===");
        JsonValue cObj = JsonValue.NewObject();
        cObj.Put("type", JsonValue.NewStr("sensor"));
        cObj.Put("temp", JsonValue.NewDouble(23.5));
        cObj.Put("id", JsonValue.NewInt(42));
        cObj.Put("online", JsonValue.NewBool(true));
        JsonValue cArr = JsonValue.NewArray();
        cArr.Append(JsonValue.NewInt(10));
        cArr.Append(JsonValue.NewInt(20));
        cObj.Put("history", cArr);

        byte[] cborBytes = Cbor.Encode(cObj);
        Console.WriteLine("CBOR encoded length: " + (cborBytes.Length > 0 ? "valid" : "invalid"));

        JsonValue cDecoded = Cbor.Decode(cborBytes);
        JsonValue vType = cDecoded.Get("type");
        Console.WriteLine("CBOR type: " + (vType != null ? vType.AsString("") : ""));

        JsonValue vId = cDecoded.Get("id");
        Console.WriteLine("CBOR id: " + Convert.ToString(vId != null ? vId.AsLong(0) : 0));

        JsonValue vOnline = cDecoded.Get("online");
        Console.WriteLine("CBOR online: " + (vOnline != null && vOnline.AsBool(false) ? "true" : "false"));

        JsonValue vHist = cDecoded.Get("history");
        Console.WriteLine("CBOR history count: " + Convert.ToString(vHist != null ? vHist.Count() : 0));

        // --- 3. Zan.DataFrame Hardening ---
        Console.WriteLine("=== DATAFRAME TEST ===");
        string csv = "id,dept,salary\r\n1,HR,5000\r\n2,ENG,8000\r\n3,ENG,9000\r\n4,HR,6000\r\n";
        DataFrame df = DataFrame.FromCsv(csv);
        Console.WriteLine("DF Rows: " + Convert.ToString(df.Rows()));
        Console.WriteLine("DF Cols: " + Convert.ToString(df.ColCount()));

        // Filter: salary >= 6000
        DataFrame highEarners = df.Filter((int r) => df.GetInt(r, "salary") >= 6000);
        Console.WriteLine("Filtered Rows: " + Convert.ToString(highEarners.Rows()));

        // SortBy: salary desc
        DataFrame sorted = df.SortBy("salary", true);
        Console.WriteLine("Top salary id: " + sorted.GetStr(0, "id"));

        // GroupBy: dept
        List<RowGroup> groups = df.GroupBy("dept");
        Console.WriteLine("Groups count: " + Convert.ToString(groups.Count));
        for (int i = 0; i < groups.Count; i = i + 1) {
            RowGroup g = groups[i];
            double sumSalary = df.Sum(g.Rows(), "salary");
            double avgSalary = df.Avg(g.Rows(), "salary");
            Console.WriteLine(g.Key() + ": count=" + Convert.ToString(g.Count())
                + ", sum=" + Convert.ToString((long)sumSalary)
                + ", avg=" + Convert.ToString((long)avgSalary));
        }

        Console.WriteLine("ALL PASSED");
    }
}
