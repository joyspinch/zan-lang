using System;

class Program {
    static void Main() {
        string name = "冰冰";
        int n = 42;

        string a = $"""hello {name}!""";
        Console.WriteLine(a);

        string b = $"""raw \n keep {n} and "quotes" here""";
        Console.WriteLine(b);

        string c = $"""
            SELECT *
            FROM "users" WHERE id = {n}
            """;
        Console.WriteLine(c);

        string d = $"normal \t interp {name}";
        Console.WriteLine(d);

        string e = $"""braces {{literal}} and {name}""";
        Console.WriteLine(e);

        string f = @$"""@-raw too: {n}""";
        Console.WriteLine(f);

        string g = $"""{name}{n}""";
        Console.WriteLine(g);
    }
}
