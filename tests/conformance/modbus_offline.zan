using System;
using System.Collections.Generic;
using System.Net.Modbus;

// Modbus TCP 离线参数边界、异常码响应与缓冲区防溢出验证测试
class Program {
    static int fails = 0;

    static void Check(string name, string got, string want) {
        if (got == want) {
            Console.WriteLine("ok " + name);
        } else {
            fails = fails + 1;
            Console.WriteLine("FAIL " + name);
            Console.WriteLine("  got:  " + got);
            Console.WriteLine("  want: " + want);
        }
    }

    static async void Main() {
        ModbusClient client = new ModbusClient();

        // 1. 未连接状态下参数校验拦截 (优先于网络调用)
        // 线圈数量超出规范 2000
        List<int> r1 = await client.ReadCoilsAsync(0, 2001);
        Check("coils-over-2000", client.LastError(), "invalid arguments");
        Check("coils-empty", Convert.ToString(r1.Count), "0");

        // 线圈数量为 0
        List<int> r2 = await client.ReadCoilsAsync(0, 0);
        Check("coils-zero", client.LastError(), "invalid arguments");

        // 寄存器数量超出规范 125
        List<int> r3 = await client.ReadHoldingAsync(0, 126);
        Check("holding-over-125", client.LastError(), "invalid arguments");

        // 寄存器数量超出规范 125
        List<int> r4 = await client.ReadInputAsync(0, 126);
        Check("input-over-125", client.LastError(), "invalid arguments");

        // 单寄存器写入值超出 65535
        int w1 = await client.WriteRegisterAsync(0, 70000);
        Check("write-reg-over-val", client.LastError(), "invalid arguments");
        Check("write-reg-failed", Convert.ToString(w1), "0");

        // 批量寄存器写入 null
        int w2 = await client.WriteRegistersAsync(0, null);
        Check("write-regs-null", client.LastError(), "invalid arguments");

        // 批量寄存器写入空列表
        int w3 = await client.WriteRegistersAsync(0, new List<int>());
        Check("write-regs-empty", client.LastError(), "invalid arguments");

        // 批量寄存器写入超出规范 123 个
        List<int> tooMany = new List<int>();
        for (int i = 0; i < 124; i = i + 1) {
            tooMany.Add(i);
        }
        int w4 = await client.WriteRegistersAsync(0, tooMany);
        Check("write-regs-over-123", client.LastError(), "invalid arguments");

        // 负数地址拦截
        int w5 = await client.WriteCoilAsync(-1, true);
        Check("write-coil-neg-addr", client.LastError(), "invalid arguments");

        if (fails == 0) {
            Console.WriteLine("modbus-offline-done");
        } else {
            Console.WriteLine("modbus-offline-fail " + Convert.ToString(fails));
        }
    }
}
