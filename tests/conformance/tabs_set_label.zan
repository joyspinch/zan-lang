using System;
using Gui;
using Gui.Widget;

namespace Tests.TabsSetLabel;

class Program {
    static void Main() {
        Tabs tabs = new Tabs();
        tabs.Add("Pinned", false);
        tabs.Add("Before", true);
        Panel first = tabs.Page(0);
        Panel second = tabs.Page(1);
        Label payload = new Label("page content");
        second.Add(payload);
        tabs.Select(1);
        tabs.TakeChanged();
        tabs.SetShowAdd(true);
        Control oldStrip = tabs.navStrip;

        tabs.SetLabel(0 - 1, "invalid");
        tabs.SetLabel(2, "invalid");
        tabs.SetLabel(1, "Before");
        Console.WriteLine("no-op-keeps-tree=" + Convert.ToString(tabs.navStrip == oldStrip));

        tabs.SetLabel(1, "After");
        Console.WriteLine("model=" + tabs.LabelAt(1));
        Control button = tabs.navStrip.children[1];
        Label caption = (Label)button.children[0];
        Console.WriteLine("caption=" + caption.GetText());
        Console.WriteLine("pages-preserved=" + Convert.ToString(tabs.PageCount() == 2
            && tabs.Page(0) == first && tabs.Page(1) == second
            && second.children.Count == 1 && second.children[0] == payload));
        Console.WriteLine("selection-preserved=" + Convert.ToString(tabs.Active() == 1
            && !first.Visible && second.Visible && tabs.TakeChanged() == (0 - 1)));
        Console.WriteLine("close-flags-preserved=" + Convert.ToString(!tabs.tabs[0].closable
            && tabs.tabs[1].closable && tabs.showAdd && !tabs.hostModel));
        Console.WriteLine("no-close-event=" + Convert.ToString(tabs.TakeClosed() == (0 - 1)));

        // Host-owned tabs retain pending close notifications across a label rebuild.
        tabs.SetHostModel(true);
        tabs.CloseTab(1);
        tabs.SetLabel(0, "Home");
        Console.WriteLine("pending-close-preserved=" + Convert.ToString(tabs.TakeClosed() == 1
            && tabs.Count() == 2 && tabs.Active() == 1 && tabs.Page(1) == second));
        tabs.SetLabel(1, null);
        Console.WriteLine("null-normalized=" + Convert.ToString(tabs.LabelAt(1) == ""));

        // Exercise the actual generated button handlers after repeated rebuilds.
        tabs.SetHostModel(false);
        Button selectButton = (Button)tabs.navStrip.children[0];
        selectButton.Click.RaiseS(selectButton);
        Console.WriteLine("click-select=" + Convert.ToString(tabs.Active() == 0));
        Button tabButton = (Button)tabs.navStrip.children[1];
        Button closeButton = (Button)tabButton.children[1];
        closeButton.Click.RaiseS(closeButton);
        Console.WriteLine("click-close=" + Convert.ToString(tabs.Count() == 1
            && tabs.TakeClosed() == 1 && tabs.TakeClosed() == (0 - 1)
            && tabs.PageCount() == 1 && tabs.Page(0) == first));
        int addedEvents = 0;
        tabs.TabAdded.Add(() => { addedEvents = addedEvents + 1; });
        Button addButton = (Button)tabs.navStrip.children[tabs.Count()];
        addButton.Click.RaiseS(addButton);
        Console.WriteLine("click-add=" + Convert.ToString(addedEvents == 1
            && tabs.TakeAdded() == 1 && tabs.TakeAdded() == (0 - 1)));
    }
}
