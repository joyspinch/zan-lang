using System;
using Gui;
using Gui.Widget;

namespace Tests.TabsSetLabel;

class CloseListener {
    public List<int> closed = new List<int>();
    public int added;
    public void Closed(Control s) { closed.Add(((Tabs)s).ClosedIndex()); }
    public void Added(Control s) { added = added + 1; }
}

class Program {
    static void Main() {
        Tabs tabs = new Tabs();
        CloseListener listen = new CloseListener();
        tabs.TabClosed.Add(listen.Closed);
        tabs.TabAdded.Add(listen.Added);
        tabs.Add("Pinned", false);
        tabs.Add("Before", true);
        Panel first = tabs.Page(0);
        Panel second = tabs.Page(1);
        Label payload = new Label("page content");
        second.Add(payload);
        tabs.Select(1);
        tabs.SetShowAdd(true);
        Control oldStrip = tabs.navStrip;

        tabs.SetLabel(0 - 1, "invalid");
        tabs.SetLabel(2, "invalid");
        tabs.SetLabel(1, "Before");
        Console.WriteLine("no-op-keeps-tree=" + Convert.ToString(tabs.navStrip == oldStrip));

        tabs.SetLabel(1, "After");
        Console.WriteLine("model=" + tabs.LabelAt(1));
        Control button = tabs.navStrip.ChildAt(1);
        Label caption = (Label)button.ChildAt(0);
        Console.WriteLine("caption=" + caption.GetText());
        Console.WriteLine("pages-preserved=" + Convert.ToString(tabs.PageCount() == 2
            && tabs.Page(0) == first && tabs.Page(1) == second
            && second.ChildCount() == 1 && second.ChildAt(0) == payload));
        Console.WriteLine("selection-preserved=" + Convert.ToString(tabs.Active() == 1
            && !first.Visible && second.Visible));
        Console.WriteLine("close-flags-preserved=" + Convert.ToString(!tabs.tabs[0].closable
            && tabs.tabs[1].closable && tabs.showAdd && !tabs.hostModel));
        Console.WriteLine("no-close-event=" + Convert.ToString(listen.closed.Count == 0));

        // Host-owned tabs are notified synchronously at close time; a later
        // label rebuild can neither lose nor replay the notification.
        tabs.SetHostModel(true);
        tabs.CloseTab(1);
        int closedAtClose = listen.closed.Count;
        int closedIndex = listen.closed.Count > 0 ? listen.closed[0] : 0 - 1;
        tabs.SetLabel(0, "Home");
        Console.WriteLine("pending-close-preserved=" + Convert.ToString(closedAtClose == 1
            && closedIndex == 1 && listen.closed.Count == 1
            && tabs.Count() == 2 && tabs.Active() == 1 && tabs.Page(1) == second));
        tabs.SetLabel(1, null);
        Console.WriteLine("null-normalized=" + Convert.ToString(tabs.LabelAt(1) == ""));

        // Exercise the actual generated button handlers after repeated rebuilds.
        tabs.SetHostModel(false);
        Button selectButton = (Button)tabs.navStrip.ChildAt(0);
        selectButton.Click.Raise(selectButton);
        Console.WriteLine("click-select=" + Convert.ToString(tabs.Active() == 0));
        Button tabButton = (Button)tabs.navStrip.ChildAt(1);
        Button closeButton = (Button)tabButton.ChildAt(1);
        closeButton.Click.Raise(closeButton);
        Console.WriteLine("click-close=" + Convert.ToString(tabs.Count() == 1
            && listen.closed.Count == 2 && listen.closed[1] == 1
            && tabs.PageCount() == 1 && tabs.Page(0) == first));
        Button addButton = (Button)tabs.navStrip.ChildAt(tabs.Count());
        addButton.Click.Raise(addButton);
        Console.WriteLine("click-add=" + Convert.ToString(listen.added == 1));
    }
}
