// Operator overloading codegen (A43-A12): binary and compound-assignment
// operators must lower to the right overload with the operand narrowed to the
// declared parameter type. `v + 5` / `v += 5` used to pass the 64-bit literal
// against an i32 parameter (LLVM verification failure), and same-named
// overloads were never resolved (`w + 2.5` called the int version).
class V {
    public int n = 0;
    public static V operator +(V a, int b) { V r = new V(); r.n = a.n + b; return r; }
    public static V operator -(V a, int b) { V r = new V(); r.n = a.n - b; return r; }
    public static V operator *(V a, int b) { V r = new V(); r.n = a.n * b; return r; }
    public static V operator /(V a, int b) { V r = new V(); r.n = a.n / b; return r; }
    public static V operator %(V a, int b) { V r = new V(); r.n = a.n % b; return r; }
    public static V operator +(V a, long b) { V r = new V(); r.n = a.n + (int)b; return r; }
    public static V operator +(V a, double b) { V r = new V(); r.n = a.n + (int)b; return r; }
    public static bool operator ==(V a, V b) { return a.n == b.n; }
}
class F {
    public double d;
    public static F operator +(F a, double b) { F r = new F(); r.d = a.d + b; return r; }
}
class Program {
    static void Main() {
        V v = new V();
        v += 5;
        v += 3;
        Console.WriteLine(v.n);        // 8
        v -= 2;
        Console.WriteLine(v.n);        // 6
        v *= 4;
        Console.WriteLine(v.n);        // 24
        v /= 6;
        Console.WriteLine(v.n);        // 4
        v %= 3;
        Console.WriteLine(v.n);        // 1
        V w = new V();
        w.n = 10;
        w = w + 7L;                    // long overload
        Console.WriteLine(w.n);        // 17
        w = w + 2.5;                   // double overload
        Console.WriteLine(w.n);        // 19
        V a = new V(); a.n = 5;
        V b = new V(); b.n = 5;
        Console.WriteLine(a == b);     // True
        V big = new V(); big.n = 100;
        big = big + 3.9;
        Console.WriteLine(big.n);      // 103
        F f = new F(); f.d = 1.5;
        f += 2.25;
        Console.WriteLine(f.d);        // 3.75
    }
}
