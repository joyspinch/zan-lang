// cs_b19_nullable_arr.zan -- C#-compat: arrays of nullable elements `int?[]`.
class Program {
    static void Main() {
        int?[] a = new int?[3];
        a[0] = 5;
        a[1] = null;
        a[2] = 9;
        Console.WriteLine(a[0].Value);
        Console.WriteLine(a[0].HasValue);
        Console.WriteLine(a[1].HasValue);
        Console.WriteLine(a[2]);
        int?[] b = new int?[] { 1, 2 };
        Console.WriteLine(b[0]);
        Console.WriteLine(b[1]);
    }
}
