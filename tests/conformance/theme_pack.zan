using System;
using Gui;
using Gui.Themes;

public class Program {
    public static void Main() {
        bool exists = ThemePack.Exists("chinese");
        if (!exists) {
            Console.WriteLine("exists:fail");
            return;
        }
        string css1 = ThemePack.GetCss("chinese");
        string css2 = ThemePack.GetCss("chinese");
        if (css1.Length == 0 || css1 != css2) {
            Console.WriteLine("css:fail");
            return;
        }

        StyleSheet s1 = ThemePack.GetStyleSheet("chinese");
        StyleSheet s2 = ThemePack.GetStyleSheet("chinese");
        if (s1 == null || s1 != s2) {
            Console.WriteLine("sheet_cache:fail");
            return;
        }

        Console.WriteLine("theme_pack:ok");
    }
}
