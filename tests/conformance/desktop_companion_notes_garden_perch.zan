using System;
using System.Collections.Generic;
using System.Windows;

namespace Conf;

class DesktopCompanionNotesGardenPerchTest {
    static void Main() {
        // 1. 桌面便签板管理器：置顶优先、按更新时间降序、归档隐藏、最大展示数截断与色标筛选
        CompanionDeskStickyBoard board = new CompanionDeskStickyBoard(2);
        int n1 = board.AddNote("Ship v2.4 release", "yellow", 100L);
        int n2 = board.AddNote("Buy coffee beans", "blue", 200L);
        int n3 = board.AddNote("Fix shader cache", "yellow", 300L);
        board.SetPinned(n1, true, 150L);
        board.SetArchived(n2, true);

        List<DeskStickyNote> vis = board.VisibleNotes();
        List<DeskStickyNote> yellows = board.FindByColorTag("yellow");
        bool notesOk = vis.Count == 2 && vis[0].NoteId == n1 && vis[1].NoteId == n3
            && yellows.Count == 2;
        Console.WriteLine("companion-desk-sticky-board: " + Convert.ToString(notesOk ? 1 : 0));

        // 2. 放置窗台花盆：湿润 1.5x 成长、干燥 0.5x 防枯萎与一键收获重置
        CompanionIdleWindowGarden garden = new CompanionIdleWindowGarden(2);
        bool planted = garden.Plant(0, "sunflower", 60.0);
        garden.AdvanceMinutes(20.0); // 湿润 rate=1.5 -> progress=0.5, moisture=0.7
        IdleCropSlot s0 = garden.GetSlot(0);
        double midProg = s0 != null ? s0.GrowthProgress : 0.0;
        garden.Water(0);
        garden.AdvanceMinutes(25.0); // 25*1.5/60 = 0.625 -> >= 1.0 Mature
        bool isMature = s0 != null && s0.State == IdleCropState.Mature;
        string harvested = garden.Harvest(0);

        bool gardenOk = planted && midProg > 0.49 && midProg < 0.51
            && isMature && harvested == "sunflower"
            && garden.TotalHarvested == 1 && s0 != null && s0.State == IdleCropState.Empty;
        Console.WriteLine("companion-idle-window-garden: " + Convert.ToString(gardenOk ? 1 : 0));

        // 3. 屏边任务栏栖息巡逻：右边界自动折返、定时切换坐下休息与分辨率缩小安全钳位
        CompanionScreenEdgePerch perch = new CompanionScreenEdgePerch(0.0, 100.0, 80.0, 20.0);
        perch.Step(2.0); // 80 + 40 -> 撞到 100 折返 FacingDir=-1
        bool flippedAtRight = perch.PosX == 100.0 && perch.FacingDir == -1;
        perch.Step(2.5); // 累计行走 4.5s >= 4.0s -> 切换 Sitting
        bool satDown = perch.Behavior == EdgePerchBehavior.Sitting;
        perch.Step(2.5); // 坐满 2.0s -> 恢复 Walking
        bool resumedWalk = perch.Behavior == EdgePerchBehavior.Walking;
        perch.UpdateBounds(0.0, 40.0); // 显示器变窄 -> 自动钳位至 40.0
        bool clampedOnResize = perch.PosX <= 40.0;

        bool perchOk = flippedAtRight && satDown && resumedWalk && clampedOnResize;
        Console.WriteLine("companion-screen-edge-perch: " + Convert.ToString(perchOk ? 1 : 0));
    }
}
