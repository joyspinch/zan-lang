using System;

class SelfhostDecimalPrecision {
    static decimal Identity(decimal value) { return value; }
    static void Main() {
        decimal sum = 0.1m + 0.2m;
        Console.WriteLine(sum == 0.3m);
        decimal large = 9007199254740992m;
        Console.WriteLine(Identity(large + 1m) - large == 1m);
        decimal wide = 79228162514264337593543950335m;
        Console.WriteLine(wide - 1m != wide);
        decimal tiny = 0.0000000000000000000000000001m;
        Console.WriteLine(tiny * 10m == 0.000000000000000000000000001m);
    }
}
