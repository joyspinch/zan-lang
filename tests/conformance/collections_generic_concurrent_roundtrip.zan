using System;
using System.Collections.Generic;
using System.Collections.Concurrent;

namespace ConformanceTests;

class Program {
    static void Main() {
        TestQueue();
        TestStack();
        TestLinkedList();
        TestHashSet();
        TestPriorityQueue();
        TestKeyValuePair();
        TestConcurrentQueue();
        TestConcurrentDictionary();
        Console.WriteLine("ALL COLLECTIONS TESTS PASSED");
    }

    static void TestQueue() {
        Queue<string> q = new Queue<string>();
        if (!q.IsEmpty() || q.Count() != 0) {
            Console.WriteLine("FAIL: Queue empty");
        }

        q.Enqueue("alpha");
        q.Enqueue("beta");
        q.Enqueue("gamma");

        if (q.Count() != 3 || q.IsEmpty()) {
            Console.WriteLine("FAIL: Queue count 3");
        }
        if (q.Peek() != "alpha") {
            Console.WriteLine("FAIL: Queue peek");
        }
        if (!q.Contains("beta") || q.Contains("delta")) {
            Console.WriteLine("FAIL: Queue contains");
        }

        string val1 = q.Dequeue();
        if (val1 != "alpha" || q.Count() != 2) {
            Console.WriteLine("FAIL: Queue dequeue 1");
        }

        string outVal;
        bool ok = q.TryDequeue(out outVal);
        if (!ok || outVal != "beta" || q.Count() != 1) {
            Console.WriteLine("FAIL: Queue TryDequeue");
        }

        string peekVal;
        ok = q.TryPeek(out peekVal);
        if (!ok || peekVal != "gamma") {
            Console.WriteLine("FAIL: Queue TryPeek");
        }

        string[] arr = q.ToArray();
        if (arr.Length != 1 || arr[0] != "gamma") {
            Console.WriteLine("FAIL: Queue ToArray");
        }

        q.Clear();
        if (q.Count() != 0 || !q.IsEmpty()) {
            Console.WriteLine("FAIL: Queue Clear");
        }
        ok = q.TryDequeue(out outVal);
        if (ok) {
            Console.WriteLine("FAIL: Queue TryDequeue on empty");
        }

        Console.WriteLine("OK: Queue");
    }

    static void TestStack() {
        Stack<int> s = new Stack<int>();
        if (!s.IsEmpty() || s.Count() != 0) {
            Console.WriteLine("FAIL: Stack empty");
        }

        s.Push(10);
        s.Push(20);
        s.Push(30);

        if (s.Count() != 3 || s.IsEmpty()) {
            Console.WriteLine("FAIL: Stack count");
        }
        if (s.Peek() != 30) {
            Console.WriteLine("FAIL: Stack peek");
        }
        if (!s.Contains(20) || s.Contains(99)) {
            Console.WriteLine("FAIL: Stack contains");
        }

        int pop1 = s.Pop();
        if (pop1 != 30 || s.Count() != 2) {
            Console.WriteLine("FAIL: Stack pop 1");
        }

        int popOut;
        bool ok = s.TryPop(out popOut);
        if (!ok || popOut != 20 || s.Count() != 1) {
            Console.WriteLine("FAIL: Stack TryPop");
        }

        int peekOut;
        ok = s.TryPeek(out peekOut);
        if (!ok || peekOut != 10) {
            Console.WriteLine("FAIL: Stack TryPeek");
        }

        int[] arr = s.ToArray();
        if (arr.Length != 1 || arr[0] != 10) {
            Console.WriteLine("FAIL: Stack ToArray");
        }

        s.Clear();
        if (!s.IsEmpty() || s.Count() != 0) {
            Console.WriteLine("FAIL: Stack Clear");
        }
        ok = s.TryPop(out popOut);
        if (ok) {
            Console.WriteLine("FAIL: Stack TryPop on empty");
        }

        Console.WriteLine("OK: Stack");
    }

    static void TestLinkedList() {
        LinkedList<string> list = new LinkedList<string>();
        if (!list.IsEmpty() || list.Count() != 0) {
            Console.WriteLine("FAIL: LinkedList empty");
        }

        list.AddLast("B");
        list.AddFirst("A");
        list.AddLast("C");

        if (list.Count() != 3) {
            Console.WriteLine("FAIL: LinkedList count");
        }
        if (list.First() != "A" || list.Last() != "C") {
            Console.WriteLine("FAIL: LinkedList First/Last");
        }

        LinkedListNode<string> head = list.Head();
        if (head == null || head.Value() != "A") {
            Console.WriteLine("FAIL: LinkedList Head");
        }
        LinkedListNode<string> next = head.Next();
        if (next == null || next.Value() != "B") {
            Console.WriteLine("FAIL: LinkedList Next");
        }
        LinkedListNode<string> tail = list.Tail();
        if (tail == null || tail.Value() != "C") {
            Console.WriteLine("FAIL: LinkedList Tail");
        }

        if (!list.Contains("B") || list.Contains("Z")) {
            Console.WriteLine("FAIL: LinkedList Contains");
        }

        bool removed = list.Remove("B");
        if (!removed || list.Count() != 2 || list.Contains("B")) {
            Console.WriteLine("FAIL: LinkedList Remove middle");
        }

        string first = list.RemoveFirst();
        if (first != "A" || list.Count() != 1) {
            Console.WriteLine("FAIL: LinkedList RemoveFirst");
        }

        string last = list.RemoveLast();
        if (last != "C" || list.Count() != 0 || !list.IsEmpty()) {
            Console.WriteLine("FAIL: LinkedList RemoveLast");
        }

        list.AddLast("X");
        list.AddLast("Y");
        string[] arr = list.ToArray();
        if (arr.Length != 2 || arr[0] != "X" || arr[1] != "Y") {
            Console.WriteLine("FAIL: LinkedList ToArray");
        }

        list.Clear();
        if (!list.IsEmpty() || list.Count() != 0) {
            Console.WriteLine("FAIL: LinkedList Clear");
        }

        Console.WriteLine("OK: LinkedList");
    }

    static void TestHashSet() {
        HashSet<string> hs = new HashSet<string>();
        if (!hs.IsEmpty() || hs.Count() != 0) {
            Console.WriteLine("FAIL: HashSet empty");
        }

        bool a1 = hs.Add("one");
        bool a2 = hs.Add("two");
        bool a3 = hs.Add("one");

        if (!a1 || !a2 || a3) {
            Console.WriteLine("FAIL: HashSet Add return values");
        }
        if (hs.Count() != 2) {
            Console.WriteLine("FAIL: HashSet Count 2");
        }
        if (!hs.Contains("one") || !hs.Contains("two") || hs.Contains("three")) {
            Console.WriteLine("FAIL: HashSet Contains");
        }

        if (hs.ElementAt(0) != "one" || hs.ElementAt(1) != "two") {
            Console.WriteLine("FAIL: HashSet ElementAt");
        }

        bool r1 = hs.Remove("one");
        bool r2 = hs.Remove("nonexistent");
        if (!r1 || r2 || hs.Count() != 1 || hs.Contains("one")) {
            Console.WriteLine("FAIL: HashSet Remove");
        }

        hs.Add("three");
        hs.Add("four");
        hs.Compact();
        if (hs.Count() != 3) {
            Console.WriteLine("FAIL: HashSet Compact");
        }

        string[] arr = hs.ToArray();
        if (arr.Length != 3) {
            Console.WriteLine("FAIL: HashSet ToArray length");
        }

        hs.Clear();
        if (!hs.IsEmpty() || hs.Count() != 0) {
            Console.WriteLine("FAIL: HashSet Clear");
        }

        Console.WriteLine("OK: HashSet");
    }

    static void TestPriorityQueue() {
        PriorityQueue<string, int> pq = new PriorityQueue<string, int>();
        if (!pq.IsEmpty() || pq.Count() != 0) {
            Console.WriteLine("FAIL: PriorityQueue empty");
        }

        pq.Enqueue("low", 100);
        pq.Enqueue("urgent", 5);
        pq.Enqueue("high", 10);
        pq.Enqueue("medium", 50);

        if (pq.Count() != 4 || pq.IsEmpty()) {
            Console.WriteLine("FAIL: PriorityQueue count 4");
        }
        if (pq.Peek() != "urgent") {
            Console.WriteLine("FAIL: PriorityQueue Peek urgent");
        }

        string e1 = pq.Dequeue();
        if (e1 != "urgent" || pq.Count() != 3) {
            Console.WriteLine("FAIL: PriorityQueue Dequeue 1");
        }

        string outElem;
        int outPrio;
        bool ok = pq.TryDequeue(out outElem, out outPrio);
        if (!ok || outElem != "high" || outPrio != 10) {
            Console.WriteLine("FAIL: PriorityQueue TryDequeue high");
        }

        ok = pq.TryPeek(out outElem, out outPrio);
        if (!ok || outElem != "medium" || outPrio != 50) {
            Console.WriteLine("FAIL: PriorityQueue TryPeek medium");
        }

        string e3 = pq.Dequeue();
        string e4 = pq.Dequeue();
        if (e3 != "medium" || e4 != "low" || !pq.IsEmpty()) {
            Console.WriteLine("FAIL: PriorityQueue remaining order");
        }

        pq.Enqueue("item1", 1);
        pq.Clear();
        if (!pq.IsEmpty() || pq.Count() != 0) {
            Console.WriteLine("FAIL: PriorityQueue Clear");
        }

        Console.WriteLine("OK: PriorityQueue");
    }

    static void TestKeyValuePair() {
        KeyValuePair<string, int> kvp = new KeyValuePair<string, int>("testKey", 42);
        if (kvp.Key != "testKey" || kvp.Value != 42) {
            Console.WriteLine("FAIL: KeyValuePair");
        }

        KVP<string, string> shortKvp = new KVP<string, string>("foo", "bar");
        if (shortKvp.Key != "foo" || shortKvp.Value != "bar") {
            Console.WriteLine("FAIL: KVP");
        }

        Console.WriteLine("OK: KeyValuePair");
    }

    static void TestConcurrentQueue() {
        using (ConcurrentQueue<string> cq = new ConcurrentQueue<string>()) {
            if (!cq.IsEmpty() || cq.Count() != 0) {
                Console.WriteLine("FAIL: ConcurrentQueue empty");
            }

            cq.Enqueue("msg1");
            cq.Enqueue("msg2");
            if (cq.Count() != 2) {
                Console.WriteLine("FAIL: ConcurrentQueue Count 2");
            }

            string outMsg;
            bool ok = cq.TryPeek(out outMsg);
            if (!ok || outMsg != "msg1") {
                Console.WriteLine("FAIL: ConcurrentQueue TryPeek");
            }

            ok = cq.TryDequeue(out outMsg);
            if (!ok || outMsg != "msg1" || cq.Count() != 1) {
                Console.WriteLine("FAIL: ConcurrentQueue TryDequeue");
            }

            string[] arr = cq.ToArray();
            if (arr.Length != 1 || arr[0] != "msg2") {
                Console.WriteLine("FAIL: ConcurrentQueue ToArray");
            }

            cq.Clear();
            if (!cq.IsEmpty() || cq.Count() != 0) {
                Console.WriteLine("FAIL: ConcurrentQueue Clear");
            }
        }

        Console.WriteLine("OK: ConcurrentQueue");
    }

    static void TestConcurrentDictionary() {
        using (ConcurrentDictionary<string, int> cd = new ConcurrentDictionary<string, int>(4)) {
            if (!cd.IsEmpty() || cd.Count() != 0) {
                Console.WriteLine("FAIL: ConcurrentDictionary empty");
            }

            bool a1 = cd.TryAdd("k1", 100);
            bool a2 = cd.TryAdd("k2", 200);
            bool a3 = cd.TryAdd("k1", 999);

            if (!a1 || !a2 || a3) {
                Console.WriteLine("FAIL: ConcurrentDictionary TryAdd");
            }
            if (cd.Count() != 2) {
                Console.WriteLine("FAIL: ConcurrentDictionary Count 2");
            }

            int val;
            bool ok = cd.TryGetValue("k1", out val);
            if (!ok || val != 100) {
                Console.WriteLine("FAIL: ConcurrentDictionary TryGetValue");
            }

            if (!cd.ContainsKey("k2") || cd.ContainsKey("k3")) {
                Console.WriteLine("FAIL: ConcurrentDictionary ContainsKey");
            }

            int gor = cd.GetOrAdd("k3", 300);
            if (gor != 300 || cd.Count() != 3) {
                Console.WriteLine("FAIL: ConcurrentDictionary GetOrAdd new");
            }

            int existing = cd.GetOrAdd("k1", 555);
            if (existing != 100) {
                Console.WriteLine("FAIL: ConcurrentDictionary GetOrAdd existing");
            }

            cd["k4"] = 400;
            if (cd["k4"] != 400 || cd.Count() != 4) {
                Console.WriteLine("FAIL: ConcurrentDictionary indexer hs");
            }

            int oldVal;
            bool rem = cd.TryRemove("k2", out oldVal);
            if (!rem || oldVal != 200 || cd.Count() != 3 || cd.ContainsKey("k2")) {
                Console.WriteLine("FAIL: ConcurrentDictionary TryRemove");
            }

            List<string> keys = cd.Keys();
            List<int> vals = cd.Values();
            if (keys.Count != 3 || vals.Count != 3) {
                Console.WriteLine("FAIL: ConcurrentDictionary Keys/Values count");
            }

            cd.Clear();
            if (!cd.IsEmpty() || cd.Count() != 0) {
                Console.WriteLine("FAIL: ConcurrentDictionary Clear");
            }
        }

        Console.WriteLine("OK: ConcurrentDictionary");
    }
}
