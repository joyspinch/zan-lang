using System;
using Gui;
using Gui.Widget;
using System.Web;

// 字段内联 CSS 声明（style 通道）的运行时语义。
// // 覆盖两段：
// 1) 布局键（width/height/pad/gap）即时落控件：它们是排布状态，
// 样式盒里的 width 只影响画出来的那张面，撑不开控件的槽位。
// 2) 视觉键（background/color/border-radius）落在**解析出的样式盒**
// 上，不在控件上留第二份副本——替换或清空内联原文后，未声明的属性
// 自然回到样式表与显式设置器的值（不留旧值的残影）。
// 画布预览路径（FormField.styleText → FormBuilder.FromField）与
// 生成代码（GenForm 发射 SetProp("style")）走同一落点。
class FieldStyleTest {
    static int fails;

    static void Chk(bool ok, string what) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Main() {
        App app = App.CreateOffscreen("field style", 320, 240);

        // 1) 直接 SetProp：布局键 + 视觉键。
        Label lbl = new Label("demo");
        lbl.SetProp("style",
            "background:#ff0000;color:#00ff00;width:88px;border-radius:6px");
        Chk(lbl.prefW == 88, "inline width");
        Chk(lbl.styleBg == 0, "no visual copy on the control");

        StyleBox box = lbl.Box(app);
        Chk(box.bg == StyleSheet.ParseColor("#ff0000"), "inline bg");
        Chk(box.fg == StyleSheet.ParseColor("#00ff00"), "inline fg");
        Chk(box.radius == 6, "inline radius");

        // rgb() 函数与皮肤值解析同源。
        Label rgb = new Label("rgb");
        rgb.SetProp("style", "background:rgb(0,128,255)");
        Chk(rgb.Box(app).bg == StyleSheet.ParseColor("rgb(0,128,255)"),
            "inline rgb fn");

        // 空串/垃圾值不炸、不落值。
        Label junk = new Label("junk");
        junk.SetProp("style", "");
        junk.SetProp("style", "not-a-decl");
        Chk(junk.prefW == 0, "junk no width");
        Chk(junk.Box(app).bg == 0, "junk no bg");

        // 2) 画布预览路径（FormBuilder.FromField）。
        FormField f = new FormField(0);
        f.styleText = "background:#3366ff;width:120px";
        Control ctl = FormBuilder.FromField(f);
        Chk(ctl != null, "FromField");
        if (ctl != null) {
            Chk(ctl.prefW == 120, "preview inline width");
            Chk(ctl.Box(app).bg == StyleSheet.ParseColor("#3366ff"),
                "preview inline bg");
        }

        if (fails == 0) {
            Console.WriteLine("gui field style OK");
        } else {
            Console.WriteLine("gui field style FAILS " + fails);
        }
    }
}
