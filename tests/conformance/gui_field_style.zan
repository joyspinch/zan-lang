using System;
using Gui;
using Gui.Widget;
using System.Web;

// WEB_GUI_ROADMAP P7b：字段内联 CSS 声明（style 通道）的运行时语义。
// // 覆盖三段：
// 1. SetProp("style") 即时落控件：布局键（width）落控件字段，
// 视觉键（background/color/border-radius）经 ApplyInline →
// ApplyBlock → CopyToControl 落 style* 覆盖字段（优先于类
// 规则，在每次样式解析的 Inline 覆盖之后生效）。
// 2. 设计器画布预览路径：FormField.styleText →
// 核心契约与语义定义。
// 与生成代码（GenForm 发射 SetProp("style")）同一落点。
// 3. 值解析复用整块 CSS 解析器：颜色函数、缩写键与皮肤同一套。
class FieldStyleTest {
    static int fails;

    static void Chk(bool ok, string what) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Main() {
        // 1) 直接 SetProp：布局键 + 视觉键。
        Label lbl = new Label("demo");
        lbl.SetProp("style",
            "background:#ff0000;color:#00ff00;width:88px;border-radius:6px");
        Chk(lbl.styleBg == StyleSheet.ParseColor("#ff0000"), "inline bg");
        Chk(lbl.styleColor == StyleSheet.ParseColor("#00ff00"), "inline fg");
        Chk(lbl.prefW == 88, "inline width");
        Chk(lbl.styleRadius == 6, "inline radius");

        // rgb() 函数与皮肤值解析同源。
        Label rgb = new Label("rgb");
        rgb.SetProp("style", "background:rgb(0,128,255)");
        Chk(rgb.styleBg == StyleSheet.ParseColor("rgb(0,128,255)"),
            "inline rgb fn");

        // 空串/垃圾值不炸、不落值。
        Label junk = new Label("junk");
        junk.SetProp("style", "");
        junk.SetProp("style", "not-a-decl");
        Chk(junk.styleBg == 0, "junk no bg");

        // 2) 画布预览路径（FormBuilder.FromField）。
        FormField f = new FormField(0);
        f.styleText = "background:#3366ff;width:120px";
        Control ctl = FormBuilder.FromField(f);
        Chk(ctl != null, "FromField");
        if (ctl != null) {
            Chk(ctl.styleBg == StyleSheet.ParseColor("#3366ff"),
                "preview inline bg");
            Chk(ctl.prefW == 120, "preview inline width");
        }

        if (fails == 0) {
            Console.WriteLine("gui field style OK");
        } else {
            Console.WriteLine("gui field style FAILS " + fails);
        }
    }
}
