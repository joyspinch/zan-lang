// B-ID76：--checked 全局算术溢出开关钉
// 默认编译：int.MaxValue+1 环绕为 -2147483648（unchecked 语义）。
// --checked 编译：溢出抛 OverflowException；unchecked(){ } 局部豁免仍环绕。
using System;
class Program {
    static int Main() {
        int x = int.MaxValue;
        try { int y = x + 1; Console.WriteLine("wrap " + Convert.ToString(y)); }
        catch (OverflowException) { Console.WriteLine("ovf"); }
        try {
            unchecked { int z = x + 1; Console.WriteLine("uwrap " + Convert.ToString(z)); }
        } catch (OverflowException) { Console.WriteLine("uovf"); }
        return 0;
    }
}
