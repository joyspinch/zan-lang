using System;

interface IPublishInterfaceCandidate {
    int Evaluate(object token);
}

// Emit this dispatch before the implementing bodies below. Its candidate tags
// must not root dead classes, but must still accept allocations discovered later.
class PublishInterfaceCalls {
    public static int Read(IPublishInterfaceCandidate candidate, object token) {
        return candidate.Evaluate(token);
    }
}

// No live body constructs this class. Emitting its interface method would
// bootstrap its own allocation site and pull in the otherwise dead payload.
class PublishInterfaceDeadCandidate : IPublishInterfaceCandidate {
    public PublishInterfaceDeadCandidate() {
    }

    public int Evaluate(object token) {
        PublishInterfaceDeadCandidate self = new PublishInterfaceDeadCandidate();
        PublishInterfaceDeadPayload payload = new PublishInterfaceDeadPayload();
        return -100;
    }
}

class PublishInterfaceDeadPayload {
    public PublishInterfaceDeadPayload() {
        Console.WriteLine("PUBLISH_INTERFACE_CANDIDATE_MUST_BE_DEAD");
    }
}

// Declared before the allocating method so a single forward emission pass
// cannot accidentally make this implementation callable.
class PublishInterfaceLateCandidate : IPublishInterfaceCandidate {
    public int Evaluate(object token) {
        return 40;
    }
}

class PublishInterfaceBase : IPublishInterfaceCandidate {
    public int Evaluate(object token) {
        return 20;
    }
}

class PublishInterfaceInherited : PublishInterfaceBase {
}

class PublishInterfaceAlpha {
}

class PublishInterfaceBeta {
}

// Exactly two closed instances; their specialized bodies must not be confused.
class PublishInterfaceGeneric<T> : IPublishInterfaceCandidate {
    public int Evaluate(object token) {
        return token is T ? 31 : 32;
    }
}

class PublishInterfaceEarlyCandidate : IPublishInterfaceCandidate {
    public int Evaluate(object token) {
        // This allocation is discovered only after Read's dispatch is emitted.
        IPublishInterfaceCandidate later = new PublishInterfaceLateCandidate();
        return PublishInterfaceCalls.Read(later, token) + 1;
    }
}

class Program {
    static int Main() {
        object alpha = new PublishInterfaceAlpha();
        object beta = new PublishInterfaceBeta();
        IPublishInterfaceCandidate early = new PublishInterfaceEarlyCandidate();
        IPublishInterfaceCandidate inherited = new PublishInterfaceInherited();
        IPublishInterfaceCandidate genericAlpha = new PublishInterfaceGeneric<PublishInterfaceAlpha>();
        IPublishInterfaceCandidate genericBeta = new PublishInterfaceGeneric<PublishInterfaceBeta>();
        if (PublishInterfaceCalls.Read(early, alpha) != 41) {
            return 1;
        }
        if (PublishInterfaceCalls.Read(inherited, alpha) != 20) {
            return 2;
        }
        if (PublishInterfaceCalls.Read(genericAlpha, alpha) != 31) {
            return 3;
        }
        if (PublishInterfaceCalls.Read(genericAlpha, beta) != 32) {
            return 4;
        }
        if (PublishInterfaceCalls.Read(genericBeta, beta) != 31) {
            return 5;
        }
        if (PublishInterfaceCalls.Read(genericBeta, alpha) != 32) {
            return 6;
        }
        Console.WriteLine("publish interface candidates PASS");
        return 0;
    }
}
