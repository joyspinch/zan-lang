using System;
using System.Threading;

class TaskShadowRunner {
    public void Run(Action action) {
        Console.WriteLine(99);
        action();
    }
    public void Spawn(Action action) {
        Console.WriteLine(88);
        action();
    }
}

class TaskActionShadow {
    static TaskShadowRunner Task = new TaskShadowRunner();

    static void CheckLocal() {
        TaskShadowRunner Task = new TaskShadowRunner();
        Task.Run(() => { Console.WriteLine(7); });
        Task.Spawn(() => { Console.WriteLine(8); });
    }

    static void CheckField() {
        Task.Run(() => { Console.WriteLine(9); });
        Task.Spawn(() => { Console.WriteLine(10); });
    }

    static void Main() {
        CheckLocal();
        CheckField();
    }
}
