// 核心契约与语义定义。
class Prog {
    static void Take(List<string> src, int i, out string s) { s = src[i]; }

    static void Bump(ref string s) { s = s + "!"; }

    static void Main() {
        List<string> src = new List<string>();
        src.Add("keep-" + Convert.ToString(12345));

        for (int i = 0; i < 4; i = i + 1) {
            string got = "";
            Prog.Take(src, 0, out got);
        }

        // 核心契约与语义定义。
        List<string> junk = new List<string>();
        for (int i = 0; i < 64; i = i + 1) {
            junk.Add("xxxxxxxxxxxx" + Convert.ToString(i));
        }

        Console.WriteLine(src[0]);

        string r = "x";
        Prog.Bump(ref r);
        Prog.Bump(ref r);
        Console.WriteLine(r);
    }
}
