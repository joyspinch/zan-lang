using System;
using System.Collections.Generic;
namespace Conf;

// Regression: writing through a `ref`/`out` parameter must retain the new
// value and release the previous occupant. The callee used to store the
// pointer raw, so the caller's slot held a borrowed reference that its scope
// exit released anyway -- one release too many. The list element below was
// freed while the list still owned it, and the next allocations handed the
// same block out again ("63" instead of "keep-12345").
class Prog {
    static void Take(List<string> src, int i, out string s) { s = src[i]; }

    static void Bump(ref string s) { s = s + "!"; }

    static void Main() {
        List<string> src = new List<string>();
        src.Add("keep-" + Convert.ToString(12345));

        for (int i = 0; i < 4; i = i + 1) {
            string got = "";
            Prog.Take(src, 0, out got);
        }

        // Churn the allocator so a prematurely freed element gets reused.
        List<string> junk = new List<string>();
        for (int i = 0; i < 64; i = i + 1) {
            junk.Add("xxxxxxxxxxxx" + Convert.ToString(i));
        }

        Console.WriteLine(src[0]);

        string r = "x";
        Prog.Bump(ref r);
        Prog.Bump(ref r);
        Console.WriteLine(r);
    }
}
