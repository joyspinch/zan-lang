using System;

class GenericPropertyBox<T> {
    public T backing;
    public T ordinary;
    public int gets;
    public int sets;
    public int marker;
    public int Marker {
        get { return marker + 100; }
        set { marker = value - 100; }
    }
    public T Value {
        get { gets = gets + 1; return backing; }
        set { sets = sets + 1; backing = value; }
    }
    public Binding<T> BindImplicit() { Binding<T> binding = Value; return binding; }
    public Binding<T> BindExplicit() { Binding<T> binding = this.Value; return binding; }
}

class GenericPropertyBindingTest {
    static void Check(bool ok, string message) { if (!ok) { throw new Exception(message); } }
    static void Main() {
        GenericPropertyBox<int> ints = new GenericPropertyBox<int>();
        GenericPropertyBox<string> strings = new GenericPropertyBox<string>();
        ints.backing = 17;
        strings.backing = "seed:" + 19.ToString();
        Binding<int> intMarker = ints.Marker;
        Binding<int> stringMarker = strings.Marker;
        intMarker.Set(107);
        stringMarker.Set(109);
        Check(intMarker.IsLive() && stringMarker.IsLive() && intMarker.Get() == 107 && stringMarker.Get() == 109, "fixed-value property still routes by generic receiver instance");
        // Same declaration symbols, distinct receiver and value instantiations.
        Binding<int> intBinding = ints.Value;
        Binding<string> stringBinding = strings.Value;
        Check(intBinding.IsLive() && stringBinding.IsLive(), "generic properties must stay live");
        Check(intBinding.Get() == 17 && stringBinding.Get() == "seed:19", "specialized getter ABI and cache");
        intBinding.Set(29);
        stringBinding.Set("stored:" + 31.ToString());
        Check(ints.backing == 29 && strings.backing == "stored:31", "specialized setter ABI and cache");
        Binding<string> againString = strings.Value;
        Binding<int> againInt = ints.Value;
        Check(againString.Get() == "stored:31" && againInt.Get() == 29, "reverse access order cache reuse");
        Binding<int> implicitInt = ints.BindImplicit();
        Binding<string> implicitString = strings.BindImplicit();
        Binding<int> explicitInt = ints.BindExplicit();
        Binding<string> explicitString = strings.BindExplicit();
        implicitInt.Set(41);
        implicitString.Set("implicit:" + 43.ToString());
        Check(explicitInt.Get() == 41 && explicitString.Get() == "implicit:43", "generic body this context");
        Check(ints.gets == 3 && strings.gets == 3 && ints.sets == 2 && strings.sets == 2, "generic accessor side effects");
        Binding<int> intField = ints.ordinary;
        Binding<string> stringField = strings.ordinary;
        intField.Set(47);
        stringField.Set("field:" + 53.ToString());
        Check(intField.IsLive() && stringField.IsLive() && ints.ordinary == 47 && strings.ordinary == "field:53", "generic ordinary field control");
        Console.WriteLine("BINDING_PROPERTY_GENERIC_IR_OK");
    }
}
