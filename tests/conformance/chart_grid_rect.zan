// A16: grid 矩形解算（ECharts Grid.resize 首遍 getLayoutRect +
// legacyContainLabel + layOutGridByOuterBounds）。此前 int px/pct
// 双字段把百分比截断成整数、把 center/middle 等关键字整体丢弃，
// containLabel 用 gut 口径（含 Scale(12) padding）而非官方纯
// labelUnion，y 还被错误下移。断言：
// ①六参原始声明保留（px/%带小数/关键字/null/auto）；
// ②mergeLayoutParam 语义：声明≥2 项时缺省不并入（width 反解）；
// ③getLayoutRect：'center'/'right'/'bottom' 关键字对齐、
// width/height 锚定、缺省 15%/65/10%/80；
// ④containLabel：y 轴缩「最宽标签+margin 8」且 x 右移；x 轴
// 只缩高度（bottom 侧 y 不动，官方 y 下移仅 position top）；
// ⑤axisLabel.show=false 的轴不参与收缩（pictorialBar-bar-transition）；
// ⑥outerBounds 缺省四边 0 = 整画布，声明 top/bottom 后按标签
// 外溢收缩（intraday-breaks-1 形态）；
// ⑦指纹折叠 null kw 不崩（chart_cache_fingerprint 回归）。
using System;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static string RectJson(string grid) {
        ChartOption o = ChartOption.FromJson("{\"series\":[{\"type\":\"line\",\"data\":[[0,0],[1,1]]}],\"grid\":" + grid + "}");
        ChartLayoutRect r = Chart.GridRawRect(o.gridLeftRaw, o.gridRightRaw,
            o.gridTopRaw, o.gridBottomRaw, o.gridWidthRaw, o.gridHeightRaw,
            1000.0, 600.0, false);
        return Convert.ToString(r.x) + "," + Convert.ToString(r.y)
            + "," + Convert.ToString(r.width) + "," + Convert.ToString(r.height);
    }

    static void Main() {
        // ① 原始声明保留
        ChartOption o1 = ChartOption.FromJson("{\"series\":[],\"grid\":{\"left\":\"17.166666666666664%\",\"top\":\"center\",\"width\":\"60%\",\"right\":80}}");
        Console.WriteLine("raw l=" + o1.gridLeftRaw.kind + "/" + Convert.ToString(o1.gridLeftRaw.num)
            + " t=" + o1.gridTopRaw.kind + "/" + o1.gridTopRaw.kw
            + " w=" + o1.gridWidthRaw.kind + "/" + Convert.ToString(o1.gridWidthRaw.num));
        // 声明 null/auto = 无值（kind 0）
        ChartOption o1b = ChartOption.FromJson("{\"series\":[],\"grid\":{\"left\":null,\"top\":\"auto\"}}");
        Console.WriteLine("void l=" + o1b.gridLeftRaw.kind + " t=" + o1b.gridTopRaw.kind);

        // ③ getLayoutRect 形态
        Console.WriteLine("default|" + RectJson("{}"));
        Console.WriteLine("ltrb|" + RectJson("{\"left\":100,\"top\":50,\"right\":60,\"bottom\":70}"));
        Console.WriteLine("width|" + RectJson("{\"left\":\"center\",\"width\":400}"));
        Console.WriteLine("right-align|" + RectJson("{\"right\":100,\"width\":300,\"bottom\":\"5%\"}"));
        Console.WriteLine("fracpct|" + RectJson("{\"left\":\"17.166666666666664%\",\"top\":65,\"right\":\"10%\",\"bottom\":80}"));

        // ④⑤ containLabel 走 BuildAxesR 全路径（1000x600，默认面板头）
        // axisLabel.show=false 的 x 轴不缩高度。
        ChartOption o2 = ChartOption.FromJson("{\"series\":[{\"type\":\"bar\",\"data\":[120,200]}],\"xAxis\":{\"type\":\"category\",\"data\":[\"Mon\",\"Tue\"]},\"yAxis\":{},\"grid\":{\"left\":\"3%\",\"right\":\"4%\",\"bottom\":\"3%\",\"containLabel\":true}}");
        App app = new App("conf", 1000, 600);
        app.BeginFrame();
        List<string> labels = o2.XCategories();
        ChartFrame f = Chart.BuildAxes(app, 0, 0, 1000, 600, 40, labels, o2, o2.series);
        Console.WriteLine("cl x=" + f.plotX + " h=" + f.plotH);
        ChartOption o3 = ChartOption.FromJson("{\"series\":[{\"type\":\"bar\",\"data\":[120,200]}],\"xAxis\":{\"type\":\"category\",\"data\":[\"Mon\",\"Tue\"],\"axisLabel\":{\"show\":false}},\"yAxis\":{},\"grid\":{\"left\":\"3%\",\"right\":\"4%\",\"bottom\":\"3%\",\"containLabel\":true}}");
        ChartFrame f2 = Chart.BuildAxes(app, 0, 0, 1000, 600, 40, o3.XCategories(), o3, o3.series);
        Console.WriteLine("nolabel h=" + f2.plotH);
    }
}
