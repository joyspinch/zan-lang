using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

/// 饼图布局（PieLayout）几何断言：扇区角度 / total / hidden /
/// pieRings 环 / donutPct 默认 / 颜色与命名解析。PieLayout 是
/// (Theme, ChartOption) -> 扇区几何的纯函数，不触碰 App/Canvas。
class Program {
    static void Main() {
        Theme t = Theme.Light();

        // 合并模式：每条可见 Pie 系列的每个数据项一个扇区；
        // 隐藏数据项不进 total、不占角度；非 Pie 系列不参与。
        ChartSeries a = ChartSeries.Pie("A", new List<int>{10, 20});
        a.data[1].hidden = true;
        ChartSeries b = ChartSeries.Pie("B", new List<int>{30});
        ChartSeries notPie = ChartSeries.Line("NotPie", new List<int>{999});

        ChartOption o = ChartOption.Of("Pie", new List<string>{"a", "b", "c"},
            new List<ChartSeries>{a, b, notPie});
        PieLayout layout = PieLayout.Of(t, o);

        Console.WriteLine("total:" + Convert.ToString(layout.total));
        Console.WriteLine("rings:" + Convert.ToString(layout.ringCount));
        Console.WriteLine("slices:" + Convert.ToString(layout.slices.Count));
        Console.WriteLine("s0:" + Convert.ToString(layout.slices[0].value)
            + ":" + Convert.ToString(layout.slices[0].a0)
            + ":" + Convert.ToString(layout.slices[0].a1)
            + ":" + Convert.ToString(layout.slices[0].ring));
        Console.WriteLine("s1:" + Convert.ToString(layout.slices[1].value)
            + ":" + Convert.ToString(layout.slices[1].a0)
            + ":" + Convert.ToString(layout.slices[1].a1)
            + ":" + Convert.ToString(layout.slices[1].ring));
        Console.WriteLine("span:" + Convert.ToString(
            layout.slices[0].a1 - layout.slices[0].a0
            + layout.slices[1].a1 - layout.slices[1].a0));
        Console.WriteLine("names:" + Convert.ToString(layout.slices[0].name)
            + ":" + Convert.ToString(layout.slices[1].name));
        Console.WriteLine("index:" + Convert.ToString(layout.slices[0].seriesIndex)
            + ":" + Convert.ToString(layout.slices[0].dataIndex)
            + ":" + Convert.ToString(layout.slices[1].seriesIndex)
            + ":" + Convert.ToString(layout.slices[1].dataIndex));

        // pieRings：每条可见 Pie 系列 = 一环，各自 total（各自 360°）。
        ChartSeries r1 = ChartSeries.Pie("R1", new List<int>{10, 10});
        ChartSeries r2 = ChartSeries.Pie("R2", new List<int>{20, 30});
        ChartOption or = ChartOption.OfRings("Rings", new List<ChartSeries>{r1, r2});
        PieLayout lr = PieLayout.Of(t, or);

        Console.WriteLine("rtotal:" + Convert.ToString(lr.total));
        Console.WriteLine("rrings:" + Convert.ToString(lr.ringCount));
        Console.WriteLine("rslices:" + Convert.ToString(lr.slices.Count));
        Console.WriteLine("rring0:" + Convert.ToString(lr.slices[0].ring)
            + ":" + Convert.ToString(lr.slices[1].ring));
        Console.WriteLine("rring1:" + Convert.ToString(lr.slices[2].ring)
            + ":" + Convert.ToString(lr.slices[3].ring));
        Console.WriteLine("ringTot:" + Convert.ToString(lr.ringTotal[0])
            + ":" + Convert.ToString(lr.ringTotal[1]));
        // 环 1 的扇区按环 1 自己的 total 分角：20/50 -> 144°，30/50 -> 216°。
        Console.WriteLine("r1angles:" + Convert.ToString(lr.slices[2].a0)
            + ":" + Convert.ToString(lr.slices[2].a1)
            + ":" + Convert.ToString(lr.slices[3].a0)
            + ":" + Convert.ToString(lr.slices[3].a1));
        // donutPct 默认（innerPct=0 时回落）：两条系列的环内径都是 55。
        Console.WriteLine("inner:" + Convert.ToString(lr.ringInner[0])
            + ":" + Convert.ToString(lr.ringInner[1]));

        // 单数据项系列：数据项色 > 系列色 > 调色板。
        ChartSeries colored = ChartSeries.Pie("C", new List<int>{5});
        colored.color = Chart.Rgb(1, 2, 3);
        ChartOption oc = ChartOption.Create();
        oc.series = new List<ChartSeries>{colored};
        PieLayout lc = PieLayout.Of(t, oc);
        Console.WriteLine("seriesColor:" + Convert.ToString(lc.slices[0].color));

        // 显式数据项色优先于系列色。
        ChartSeries itemColored = ChartSeries.Pie("I", new List<int>{7});
        itemColored.color = Chart.Rgb(10, 20, 30);
        itemColored.data[0].color = Chart.Rgb(40, 50, 60);
        ChartOption oi = ChartOption.Create();
        oi.series = new List<ChartSeries>{itemColored};
        PieLayout li = PieLayout.Of(t, oi);
        Console.WriteLine("itemColor:" + Convert.ToString(li.slices[0].color));

        // 多数据项系列无数据名：回落系列名（ECharts 饼图按项着
        // 色——调色板逐扇区），空系列名回落 "Item N"。
        ChartSeries multi = ChartSeries.Pie("M", new List<int>{1, 2});
        ChartOption om = ChartOption.Create();
        om.series = new List<ChartSeries>{multi};
        PieLayout lm = PieLayout.Of(t, om);
        Console.WriteLine("pal:" + Convert.ToString(lm.slices[0].color)
            + ":" + Convert.ToString(lm.slices[1].color));
        Console.WriteLine("mnames:" + Convert.ToString(lm.slices[0].name)
            + ":" + Convert.ToString(lm.slices[1].name));

        ChartSeries unNamed = ChartSeries.Pie("", new List<int>{1, 2});
        ChartOption on = ChartOption.Create();
        on.series = new List<ChartSeries>{unNamed};
        PieLayout ln = PieLayout.Of(t, on);
        Console.WriteLine("fallback:" + Convert.ToString(ln.slices[0].name)
            + ":" + Convert.ToString(ln.slices[1].name));

        // 空输入：无 Pie 系列或无可见数据时安全返回空布局。
        ChartOption empty = ChartOption.Create();
        PieLayout le = PieLayout.Of(t, empty);
        Console.WriteLine("empty:" + Convert.ToString(le.slices.Count)
            + ":" + Convert.ToString(le.total));
        ChartSeries allHidden = ChartSeries.Pie("H", new List<int>{3});
        allHidden.data[0].hidden = true;
        ChartOption oh = ChartOption.Create();
        oh.series = new List<ChartSeries>{allHidden};
        PieLayout lh = PieLayout.Of(t, oh);
        Console.WriteLine("hidden:" + Convert.ToString(lh.slices.Count)
            + ":" + Convert.ToString(lh.total));

        // 非正值不占角度；唯一正值保留完整 360°，避免出现
        // 空白缝或负值回退造成的重叠。
        ChartSeries signed = ChartSeries.Pie("Signed", new List<int>{-4, 0, 9});
        ChartOption os = ChartOption.Create();
        os.series = new List<ChartSeries>{signed};
        PieLayout ls = PieLayout.Of(t, os);
        Console.WriteLine("signed:" + Convert.ToString(ls.total) + ":"
            + Convert.ToString(ls.slices.Count) + ":"
            + Convert.ToString(ls.slices[0].a0) + ":"
            + Convert.ToString(ls.slices[0].a1));

        // 起始角规范化到 [0,360)，布局角度仍保持完整闭环。
        ChartSeries rotated = ChartSeries.Pie("Rot", new List<int>{5});
        rotated.startAngle = 450;
        ChartOption ot = ChartOption.Create();
        ot.series = new List<ChartSeries>{rotated};
        PieLayout lt = PieLayout.Of(t, ot);
        Console.WriteLine("rot:" + Convert.ToString(lt.rot) + ":"
            + Convert.ToString(lt.slices[0].a0) + ":"
            + Convert.ToString(lt.slices[0].a1));

        // 等分饼的半开区间 [0,180)、[180,360)：四个轴向量
        // 必须各自稳定落入唯一扇区，避免边界方向因整数近似错位。
        ChartSeries boundary = ChartSeries.Pie("Boundary", new List<int>{10, 10});
        ChartOption ob = ChartOption.Create();
        ob.series = new List<ChartSeries>{boundary};
        PieLayout lb = PieLayout.Of(t, ob);
        int topA = ChartView.AngleOf(0, 0 - 1);
        int rightA = ChartView.AngleOf(1, 0);
        int bottomA = ChartView.AngleOf(0, 1);
        int leftA = ChartView.AngleOf(0 - 1, 0);
        Console.WriteLine("axisBoundary:"
            + Convert.ToString(topA >= lb.slices[0].a0 && topA < lb.slices[0].a1)
            + ":" + Convert.ToString(rightA >= lb.slices[0].a0 && rightA < lb.slices[0].a1)
            + ":" + Convert.ToString(bottomA >= lb.slices[1].a0 && bottomA < lb.slices[1].a1)
            + ":" + Convert.ToString(leftA >= lb.slices[1].a0 && leftA < lb.slices[1].a1));

        // donutPct=0 表示实心饼：内半径必须从圆心开始，不能
        // 因 ringCount=1 的 band=0 退化成仅 1px 外圈。
        ChartSeries solid = ChartSeries.Pie("Solid", new List<int>{1, 1});
        ChartOption so = ChartOption.Create();
        so.donutPct = 0;
        so.series = new List<ChartSeries>{solid};
        PieLayout sl = PieLayout.Of(t, so);
        int sri = 0;
        int sro = 0;
        ChartView.PieRingBounds(sl, 0, 1, 100, 0, 2, out sri, out sro);
        Console.WriteLine("solidBounds:" + Convert.ToString(sri)
            + ":" + Convert.ToString(sro));

        // selectedOffset 的 0 是合法的“不外偏”，负值也安全归一为 0；
        // 构造默认值仍保持 ECharts 语义的 10 像素。
        ChartSeries selected = ChartSeries.Pie("Selected", new List<int>{1});
        int selectedDefault = selected.selectedOffset;
        selected.selectedOffset = 0;
        Console.WriteLine("selectedOffset:" + Convert.ToString(
            selectedDefault) + ":"
            + Convert.ToString(ChartView.PieSelectedOffset(selected.selectedOffset)) + ":"
            + Convert.ToString(ChartView.PieSelectedOffset(-4)) + ":"
            + Convert.ToString(ChartView.PieSelectedOffset(12)));
        Console.WriteLine("emphasisPaint:"
            + Convert.ToString(ChartView.PieHasEmphasisPaint(0, 0, 0))
            + ":" + Convert.ToString(ChartView.PieHasEmphasisPaint(0, 123, 1))
            + ":" + Convert.ToString(ChartView.PieHasEmphasisPaint(456, 0, 0)));
    }
}
