using System;
using System.Windows;

namespace Conf;

class DesktopCompanionTelemetryShortcutThemeTest {
    static void Main() {
        // 1. 系统遥测情绪感应器：过热触发 + 滞回带防抖保持 + 冷却后回落 + 低电告警优先
        CompanionSystemResourceMoodSensor sensor = new CompanionSystemResourceMoodSensor(60, 85, 20, 8);
        CompanionResourceMood m1 = sensor.Evaluate(30, 40, 100, true);  // Calm
        CompanionResourceMood m2 = sensor.Evaluate(90, 50, 100, true);  // >=85 -> Overheated
        CompanionResourceMood m3 = sensor.Evaluate(80, 50, 100, true);  // 80 > 85-8=77 -> 滞回保持 Overheated
        CompanionResourceMood m4 = sensor.Evaluate(72, 50, 100, true);  // <=77 且 >=60 -> 降级 Busy
        CompanionResourceMood m5 = sensor.Evaluate(25, 30, 15, false);  // 未插电 15% -> LowBattery 优先
        CompanionResourceMood m6 = sensor.Evaluate(25, 30, 50, true);   // 插电 50% -> Charging

        bool moodOk = m1 == CompanionResourceMood.Calm
            && m2 == CompanionResourceMood.Overheated
            && m3 == CompanionResourceMood.Overheated
            && m4 == CompanionResourceMood.Busy
            && m5 == CompanionResourceMood.LowBattery
            && m6 == CompanionResourceMood.Charging;
        Console.WriteLine("companion-telemetry-mood-hysteresis: " + Convert.ToString(moodOk ? 1 : 0));

        // 2. 全局热键绑定器：修饰键乱序规范化、冲突拦截与原子改绑
        CompanionGlobalShortcutBinder binder = new CompanionGlobalShortcutBinder();
        bool b1 = binder.Bind("toggle_pet", "shift+ctrl+p");
        bool conflictBlocked = !binder.Bind("open_shop", "CTRL + SHIFT + P"); // 同规范化热键冲突拦截
        bool rebindOk = binder.Bind("toggle_pet", "alt+ctrl+h");              // 原子改绑释放旧键
        bool nowFreeOk = binder.Bind("open_shop", "Ctrl+Shift+P");            // 旧键释放后可绑新动作
        string act1 = binder.ResolveAction("ctrl+alt+H");
        string act2 = binder.ResolveAction("SHIFT+CONTROL+p");

        bool bindOk = b1 && conflictBlocked && rebindOk && nowFreeOk
            && act1 == "toggle_pet" && act2 == "open_shop" && binder.BindingCount() == 2;
        Console.WriteLine("companion-shortcut-binder: " + Convert.ToString(bindOk ? 1 : 0));

        // 3. 主题包管理器：未解锁禁装、解锁装备与系统明暗自适应解析
        CompanionThemePackManager tm = new CompanionThemePackManager();
        tm.RegisterTheme("day_cream", false, true, unchecked((int)0xFFFFD8A8));
        tm.RegisterTheme("night_slate", true, true, unchecked((int)0xFF3B82F6));
        tm.RegisterTheme("cyber_neon", true, false, unchecked((int)0xFF00F5D4));

        bool lockedBlocked = !tm.EquipTheme("cyber_neon");
        bool unlockOk = tm.UnlockTheme("cyber_neon") && tm.EquipTheme("cyber_neon");
        ThemePackManifest darkPick = tm.ResolveActiveTheme(true);
        ThemePackManifest lightPick = tm.ResolveActiveTheme(false);

        bool themeOk = lockedBlocked && unlockOk
            && darkPick != null && darkPick.ThemeId == "cyber_neon"
            && lightPick != null && lightPick.ThemeId == "day_cream";
        Console.WriteLine("companion-theme-pack-manager: " + Convert.ToString(themeOk ? 1 : 0));
    }
}
