using System;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static void Main() {
        ChartOption parsed = ChartOption.FromJson("{\"title\":\"Revenue\",\"backgroundColor\":\"#102030\",\"grid\":{\"left\":12,\"right\":24,\"top\":8,\"bottom\":18},\"dataZoom\":[{\"show\":true,\"start\":80,\"end\":20}],\"legend\":{\"show\":false},\"tooltip\":{\"show\":true},\"markArea\":{\"data\":[[{\"yAxis\":10},{\"yAxis\":40}]]},\"xAxis\":{\"type\":\"category\",\"data\":[\"Q1\",\"Q2\"]},\"series\":[{\"name\":\"Sales\",\"type\":\"bar\",\"itemStyle\":{\"normal\":{\"color\":\"#5470C6\",\"borderColor\":\"#ffffff\",\"borderWidth\":2},\"emphasis\":{\"color\":\"#91CC75\"}},\"label\":{\"show\":true,\"color\":\"#ffffff\",\"fontSize\":12},\"lineStyle\":{\"color\":\"#fac858\",\"width\":3},\"areaStyle\":{\"show\":true,\"color\":\"#ee6666\"},\"data\":[10,20]},{\"name\":\"Overlap\",\"type\":\"venn\",\"data\":[{\"value\":10,\"name\":\"A\"}]}]}");
        ChartSeries sales = parsed.series[0];
        ChartSeries venn = parsed.series[1];
        Console.WriteLine(parsed.title + ":" + Convert.ToString(parsed.backgroundColor));
        Console.WriteLine(Convert.ToString(parsed.gridLeft) + ":" + Convert.ToString(parsed.gridRight) + ":" + Convert.ToString(parsed.gridTop) + ":" + Convert.ToString(parsed.gridBottom));
        Console.WriteLine(Convert.ToString(parsed.zoom) + ":" + Convert.ToString(parsed.zoomStart) + ":" + Convert.ToString(parsed.zoomEnd));
        Console.WriteLine(Convert.ToString(parsed.showLegend) + ":" + Convert.ToString(parsed.showTooltip) + ":" + Convert.ToString(parsed.markLo) + ":" + Convert.ToString(parsed.markHi));
        Console.WriteLine(Convert.ToString(sales.color) + ":" + Convert.ToString(sales.itemStyle.normal.borderWidth) + ":" + Convert.ToString(sales.itemStyle.normal.color) + ":" + Convert.ToString(sales.itemStyle.emphasis.color));
        Console.WriteLine(Convert.ToString(sales.labelShow) + ":" + Convert.ToString(sales.label.fontSize) + ":" + Convert.ToString(sales.areaStyle));
        Console.WriteLine(venn.custom + ":" + Convert.ToString(venn.data.Count));

        ChartOption direct = ChartOption.Create().DataZoom(120, -10).Grid(1, 2, 3, 4);
        Console.WriteLine(Convert.ToString(direct.zoomStart) + ":" + Convert.ToString(direct.zoomEnd) + ":" + Convert.ToString(direct.gridBottom));

        ChartOption sym = ChartOption.FromJson("{\"series\":[{\"type\":\"scatter\",\"symbol\":\"triangle\",\"symbolSize\":12,\"showSymbol\":false,\"symbol2\":\"bogus\",\"data\":[{\"value\":5,\"symbolSize\":7},{\"value\":3}],\"points\":[[1,2],{\"x\":3,\"y\":4,\"symbolSize\":9,\"color\":\"#ff0000\"}]}]}");
        ChartSeries sy = sym.series[0];
        Console.WriteLine(sy.symbol + ":" + Convert.ToString(sy.symbolSize) + ":" + Convert.ToString(sy.showSymbol)
            + ":" + Convert.ToString(sy.data[0].sizeSet) + ":" + Convert.ToString(sy.data[0].size)
            + ":" + Convert.ToString(sy.data[1].sizeSet)
            + ":" + Convert.ToString(sy.points[0].sizeSet)
            + ":" + Convert.ToString(sy.points[1].size) + ":" + Convert.ToString(sy.points[1].color != 0));
    }
}

