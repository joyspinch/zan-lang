using System;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static void Main() {
        ChartOption parsed = ChartOption.FromJson("{\"title\":\"Revenue\",\"backgroundColor\":\"#102030\",\"grid\":{\"left\":12,\"right\":24,\"top\":8,\"bottom\":18},\"dataZoom\":[{\"show\":true,\"start\":80,\"end\":20}],\"legend\":{\"show\":false},\"tooltip\":{\"show\":true},\"markArea\":{\"data\":[[{\"yAxis\":10},{\"yAxis\":40}]]},\"xAxis\":{\"type\":\"category\",\"data\":[\"Q1\",\"Q2\"]},\"series\":[{\"name\":\"Sales\",\"type\":\"bar\",\"itemStyle\":{\"normal\":{\"color\":\"#5470C6\",\"borderColor\":\"#ffffff\",\"borderWidth\":2},\"emphasis\":{\"color\":\"#91CC75\"}},\"label\":{\"show\":true,\"color\":\"#ffffff\",\"fontSize\":12},\"lineStyle\":{\"color\":\"#fac858\",\"width\":3},\"areaStyle\":{\"show\":true,\"color\":\"#ee6666\"},\"data\":[10,20]},{\"name\":\"Overlap\",\"type\":\"venn\",\"data\":[{\"value\":10,\"name\":\"A\"}]}]}");
        ChartSeries sales = parsed.series[0];
        ChartSeries venn = parsed.series[1];
        Console.WriteLine(parsed.title + ":" + Convert.ToString(parsed.backgroundColor));
        Console.WriteLine(Convert.ToString(parsed.gridLeft) + ":" + Convert.ToString(parsed.gridRight) + ":" + Convert.ToString(parsed.gridTop) + ":" + Convert.ToString(parsed.gridBottom));
        Console.WriteLine(Convert.ToString(parsed.zoom) + ":" + Convert.ToString(parsed.zoomStart) + ":" + Convert.ToString(parsed.zoomEnd));
        Console.WriteLine(Convert.ToString(parsed.showLegend) + ":" + Convert.ToString(parsed.showTooltip) + ":" + Convert.ToString(parsed.markLo) + ":" + Convert.ToString(parsed.markHi));
        Console.WriteLine(Convert.ToString(sales.color) + ":" + Convert.ToString(sales.itemStyle.normal.borderWidth) + ":" + Convert.ToString(sales.itemStyle.normal.color) + ":" + Convert.ToString(sales.itemStyle.emphasis.color));
        Console.WriteLine(Convert.ToString(sales.labelShow) + ":" + Convert.ToString(sales.label.fontSize) + ":" + Convert.ToString(sales.areaStyle));
        Console.WriteLine(venn.custom + ":" + Convert.ToString(venn.data.Count));

        ChartOption direct = ChartOption.Create().DataZoom(120, -10).Grid(1, 2, 3, 4);
        Console.WriteLine(Convert.ToString(direct.zoomStart) + ":" + Convert.ToString(direct.zoomEnd) + ":" + Convert.ToString(direct.gridBottom));

        ChartOption sym = ChartOption.FromJson("{\"series\":[{\"type\":\"scatter\",\"symbol\":\"triangle\",\"symbolSize\":12,\"showSymbol\":false,\"symbol2\":\"bogus\",\"data\":[{\"value\":5,\"symbolSize\":7},{\"value\":3}],\"points\":[[1,2],{\"x\":3,\"y\":4,\"symbolSize\":9,\"color\":\"#ff0000\"}]}]}");
        ChartSeries sy = sym.series[0];
        Console.WriteLine(sy.symbol + ":" + Convert.ToString(sy.symbolSize) + ":" + Convert.ToString(sy.showSymbol)
            + ":" + Convert.ToString(sy.data[0].sizeSet) + ":" + Convert.ToString(sy.data[0].size)
            + ":" + Convert.ToString(sy.data[1].sizeSet)
            + ":" + Convert.ToString(sy.points[0].sizeSet)
            + ":" + Convert.ToString(sy.points[1].size) + ":" + Convert.ToString(sy.points[1].color != 0));

        ChartOption mlx = ChartOption.FromJson("{\"xAxis\":{\"type\":\"category\",\"data\":[\"a\"],\"nameLocation\":\"end\",\"axisLabel\":{\"rotate\":45,\"interval\":2}},\"series\":[{\"type\":\"line\",\"name\":\"L\",\"data\":[1,2],\"markLine\":{\"data\":[{\"type\":\"average\",\"name\":\"avg-line\",\"lineStyle\":{\"type\":\"solid\",\"color\":\"#ff0000\"}},{\"yAxis\":50},{\"type\":\"max\"}]}}]}");
        ChartAxis xa = mlx.xAxes[0];
        ChartSeries ls = mlx.series[0];
        Console.WriteLine(xa.nameLocation + ":" + Convert.ToString(xa.labelRotate) + ":" + Convert.ToString(xa.labelInterval));
        Console.WriteLine(Convert.ToString(ls.markLines.Count)
            + ":" + ls.markLines[0].kind + ":" + ls.markLines[0].label + ":" + ls.markLines[0].lineType
            + ":" + Convert.ToString(ls.markLines[0].color != 0)
            + ":" + Convert.ToString(ls.markLines[1].yValue)
            + ":" + ls.markLines[2].kind);

        ChartOption rd = ChartOption.FromJson("{\"radar\":{\"indicator\":[{\"max\":100}],\"shape\":\"polygon\",\"splitArea\":{\"show\":true}},\"series\":[{\"type\":\"map\",\"name\":\"M\",\"data\":[{\"value\":1,\"name\":\"R1\"}],\"selectedMode\":\"false\"}]}");
        Console.WriteLine(rd.radarShape + ":" + Convert.ToString(rd.radarSplitArea ? 1 : 0)
            + ":" + rd.series[0].selectedMode);

        ChartOption lg = ChartOption.FromJson("{\"legend\":{\"orient\":\"vertical\",\"selectedMode\":\"single\",\"formatter\":\"S-{name}\"},\"dataRange\":{\"show\":true,\"min\":10,\"max\":90,\"calculable\":true,\"splitNumber\":4,\"color\":[\"#336699\",\"#99ccff\"],\"data\":[{\"name\":\"low\",\"start\":0,\"end\":30},{\"name\":\"high\",\"start\":70,\"end\":100}]},\"series\":[{\"type\":\"scatter\",\"data\":[1]}]}");
        Console.WriteLine(lg.legendOrient + ":" + lg.legendSelectedMode + ":" + lg.legendFormatter);
        Console.WriteLine(Convert.ToString(lg.dataRangeShow ? 1 : 0)
            + ":" + Convert.ToString(lg.dataRangeLo) + ":" + Convert.ToString(lg.dataRangeHi)
            + ":" + Convert.ToString(lg.dataRangeCalculable ? 1 : 0)
            + ":" + Convert.ToString(lg.dataRangeSplit)
            + ":" + Convert.ToString(lg.dataRangeList.Count)
            + ":" + lg.dataRangeList[0].label
            + ":" + Convert.ToString(lg.dataRangeList[0].lo)
            + ":" + Convert.ToString(lg.dataRangeList[0].hi)
            + ":" + Convert.ToString(lg.rampColors.Count));
        ChartOption lgb = ChartOption.FromJson("{\"legend\":{\"show\":false,\"selectedMode\":\"bogus\"},\"series\":[{\"type\":\"scatter\",\"data\":[1]}]}");
        Console.WriteLine(Convert.ToString(lgb.showLegend ? 1 : 0) + ":[" + lgb.legendSelectedMode + "]");

        // ---- 批 6：force / chord / funnel / wordCloud 参数 ----
        ChartOption b6 = ChartOption.FromJson("{\"series\":[{\"type\":\"force\",\"name\":\"F\",\"data\":[1],\"force\":{\"scaling\":250,\"gravity\":80,\"minRadius\":4,\"maxRadius\":18,\"nodeStyle\":{\"color\":\"#386fb4\"},\"linkStyle\":{\"color\":\"#969ca4\"}},\"chord\":{\"ribbonType\":\"path\",\"sort\":\"descending\",\"sortSub\":true,\"gap\":4,\"ringWidth\":14},\"funnelAlign\":\"left\",\"funnelGap\":6,\"funnelPercent\":true,\"sizeRange\":[12,44],\"rotate\":\"vary\"}]}");
        ChartSeries f6 = b6.series[0];
        Console.WriteLine(Convert.ToString(f6.forceScaling) + ":" + Convert.ToString(f6.forceGravity)
            + ":" + Convert.ToString(f6.forceMinRadius) + ":" + Convert.ToString(f6.forceMaxRadius)
            + ":" + Convert.ToString(f6.forceNodeColor != 0) + ":" + Convert.ToString(f6.forceLinkColor != 0));
        Console.WriteLine(f6.chordRibbonType + ":" + Convert.ToString(f6.chordSort)
            + ":" + Convert.ToString(f6.chordSortSub ? 1 : 0) + ":" + Convert.ToString(f6.chordGapDeg)
            + ":" + Convert.ToString(f6.chordRingWidthPct));
        Console.WriteLine(f6.funnelAlign + ":" + Convert.ToString(f6.funnelGap)
            + ":" + Convert.ToString(f6.funnelPercent ? 1 : 0)
            + ":" + Convert.ToString(f6.wcMinFontSize) + ":" + Convert.ToString(f6.wcMaxFontSize)
            + ":" + f6.wcRotate);
        // 未给参数时保持现状默认（scaling/gravity 100、gap -1 自动、字符串空）。
        ChartOption d6 = ChartOption.FromJson("{\"series\":[{\"type\":\"force\",\"data\":[1]}]}");
        ChartSeries g6 = d6.series[0];
        Console.WriteLine(Convert.ToString(g6.forceScaling) + ":" + Convert.ToString(g6.forceGravity)
            + ":" + Convert.ToString(g6.chordGapDeg) + ":" + Convert.ToString(g6.funnelGap)
            + ":[" + g6.chordRibbonType + "]:[" + g6.funnelAlign + "]:[" + g6.wcRotate + "]"
            + ":" + Convert.ToString(g6.wcMinFontSize) + ":" + Convert.ToString(g6.chordSort));
    }
}

