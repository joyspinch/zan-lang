// A root-level await must return when the coroutine it awaits completes, even
// while a background coroutine spawned meanwhile never finishes: the driver
// pumps until that frame's DONE flag is set, not until the queue drains.
using System;
using System.Threading;

class Program {
    static bool armed = false;

    static async void Forever() {
        while (true) { await Task.Delay(50); }
    }

    static async int Leaf() {
        await Task.Delay(1);
        return 1;
    }

    static async int Step() {
        int n = await Program.Leaf();
        if (!Program.armed) {
            Program.armed = true;
            Task.Spawn(Program.Forever());
        }
        return n;
    }

    static async int Body(int rounds) {
        int total = 0;
        for (int i = 0; i < rounds; i = i + 1) {
            total = total + await Program.Step();
        }
        return total;
    }

    static void Main() {
        int a = await Program.Body(3);
        Console.WriteLine("first=" + Convert.ToString(a));
        int b = await Program.Body(2);
        Console.WriteLine("second=" + Convert.ToString(b));
        Console.WriteLine("done");
    }
}
