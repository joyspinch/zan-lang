// A method of a generic class calling a SIBLING method of the same class must
// land in the instantiation being emitted, not in the erased copy: the erased
// body does not refcount T, so a returned element comes back unretained and the
// caller's release frees it while the collection still holds it. The churn loop
// below reads every value after taking it, so a premature free shows up as
// wrong content or a crash.
// Value-type arguments go through the same erased slots, so int/double
// instantiations check that a T-typed local and return are narrowed back to
// their concrete width instead of writing a pointer into a smaller slot.
using System;

class Store<T> {
    List<T> items;
    T empty;

    static Store<T> Of(T empty) {
        Store<T> s = new Store<T>();
        s.items = new List<T>();
        s.empty = empty;
        return s;
    }

    void Put(T v) { this.items.Add(v); }

    int Count() { return this.items.Count; }

    T Head() {
        if (this.items.Count == 0) { return this.empty; }
        T v = this.items[0];
        this.items.RemoveAt(0);
        return v;
    }

    // self-call: must reach Store<T>.Head of this instantiation
    T Take() { return this.Head(); }
}

class Program {
    static void Main() {
        Store<string> s = Store<string>.Of("(none)");
        int round = 0;
        int chars = 0;
        string last = "";
        while (round < 50) {
            int i = 0;
            while (i < 20) {
                s.Put("row " + Convert.ToString(round) + ":" + Convert.ToString(i));
                i = i + 1;
            }
            while (s.Count() > 0) {
                last = s.Take();
                chars = chars + last.Length;
            }
            round = round + 1;
        }
        Console.WriteLine("chars=" + Convert.ToString(chars));
        Console.WriteLine("last=" + last);
        Console.WriteLine("drained=" + s.Take());

        Store<int> n = Store<int>.Of(0 - 1);
        n.Put(7);
        n.Put(9);
        Console.WriteLine("n=" + Convert.ToString(n.Take())
            + "," + Convert.ToString(n.Take())
            + "," + Convert.ToString(n.Take()));

        Store<double> d = Store<double>.Of(0.5);
        d.Put(1.25);
        Console.WriteLine("d=" + Convert.ToString(d.Take())
            + "," + Convert.ToString(d.Take()));
    }
}
