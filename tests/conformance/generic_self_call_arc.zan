// 接口数据协议与执行契约。
// 核心契约与执行状态转移规范。
// 接口数据协议与执行契约。
using System;

class Store<T> {
    List<T> items;
    T empty;

    static Store<T> Of(T empty) {
        Store<T> s = new Store<T>();
        s.items = new List<T>();
        s.empty = empty;
        return s;
    }

    void Put(T v) { this.items.Add(v); }

    int Count() { return this.items.Count; }

    T Head() {
        if (this.items.Count == 0) { return this.empty; }
        T v = this.items[0];
        this.items.RemoveAt(0);
        return v;
    }

    // 接口数据协议与执行契约。
    T Take() { return this.Head(); }
}

class Program {
    static void Main() {
        Store<string> s = Store<string>.Of("(none)");
        int chars = 0;
        string last = "";
        for (int round = 0; round < 50; round = round + 1) {
            for (int i = 0; i < 20; i = i + 1) {
                s.Put("row " + Convert.ToString(round) + ":" + Convert.ToString(i));
            }
            while (s.Count() > 0) {
                last = s.Take();
                chars = chars + last.Length;
            }
        }
        Console.WriteLine("chars=" + Convert.ToString(chars));
        Console.WriteLine("last=" + last);
        Console.WriteLine("drained=" + s.Take());

        Store<int> n = Store<int>.Of(0 - 1);
        n.Put(7);
        n.Put(9);
        Console.WriteLine("n=" + Convert.ToString(n.Take())
            + "," + Convert.ToString(n.Take())
            + "," + Convert.ToString(n.Take()));

        Store<double> d = Store<double>.Of(0.5);
        d.Put(1.25);
        Console.WriteLine("d=" + Convert.ToString(d.Take())
            + "," + Convert.ToString(d.Take()));
    }
}
