using System;

interface Greeter { string Hi(); }

class Person : Greeter {
    public string name = "ada";
    public int age = 36;
    public string Hi() { return "hi " + this.name; }
}

class Program {
    static void Main() {
        Person? p = new Person();
        Console.WriteLine(p.name);
        Console.WriteLine(Convert.ToString(p.age));
        Greeter? g = new Person();
        Console.WriteLine(g.Hi());
        Person? missing = null;
        if (missing == null) { Console.WriteLine("none"); }
        string? s = null;
        Console.WriteLine(s ?? "fallback");
        bool flag = true;
        int pick = flag ? p.age : 0;
        Console.WriteLine(Convert.ToString(pick));
    }
}
