using System;

namespace Shop {
    public class Item {
        public int price;
        public static bool ok = true;
        public Item() { this.price = 7; }
    }
}

class Plain {
    public int v;
    public Plain() { this.v = 3; }
}

// A nullable marker on a **user** type must be recognised as part of the type,
// in every spelling the language allows:
//
//   - a qualified name:      `Shop.Item? x`
//   - a qualified array:     `Shop.Item?[] xs`
//   - a simple name + array: `Plain?[] ps`
//   - a keyword type:        `string?[] ss` (always worked)
//
// The declaration lookahead used to miss two of them: the qualified-name branch
// did not know about the `?` marker at all, and the simple-name branch
// explicitly refused a `[` right after the `?`. A qualified name followed by a
// ternary (`Shop.Item ? a : b`) must still parse as an expression.
class Program {
    static void Main() {
        Shop.Item? one = null;
        Console.WriteLine("one=" + (one == null));

        Shop.Item?[] many = new Shop.Item?[2];
        many[0] = new Shop.Item();
        Console.WriteLine("many=" + many.Length);
        Console.WriteLine("price=" + many[0].price);

        Plain?[] ps = new Plain?[1];
        ps[0] = new Plain();
        Console.WriteLine("pv=" + ps[0].v);

        string?[] ss = new string?[2];
        ss[0] = "hi";
        Console.WriteLine("ss=" + ss[0]);

        // a qualified receiver in a ternary is still an expression
        bool flag = true;
        flag ? Console.WriteLine("then") : Console.WriteLine("else");
        Shop.Item.ok ? Console.WriteLine("qthen") : Console.WriteLine("qelse");
    }
}
