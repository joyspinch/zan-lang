using System;
using System.Collections.Generic;
using System.Threading;

class Program {
    static Channel<string> ch;
    static List<string> consumed;
    static Gate finishGate;

    static async void Producer(int count) {
        for (int i = 1; i <= count; i = i + 1) {
            string msg = "item_" + i.ToString();
            await ch.Write(msg);
        }
        ch.Complete();
    }

    static async void Consumer() {
        while (true) {
            string val = "";
            bool ok = await ch.Read(out val);
            if (!ok) {
                break;
            }
            consumed.Add(val);
        }
        finishGate.Signal();
    }

    static async void RunSuite() {
        // 1. 无界通道基本收发
        Channel<int> unbounded = Channel<int>.CreateUnbounded();
        unbounded.TryWrite(100);
        unbounded.TryWrite(200);
        int v1 = 0;
        int v2 = 0;
        bool r1 = unbounded.TryRead(out v1);
        bool r2 = unbounded.TryRead(out v2);
        Console.WriteLine("unbounded r1=" + r1.ToString() + " v1=" + v1.ToString());
        Console.WriteLine("unbounded r2=" + r2.ToString() + " v2=" + v2.ToString());
        Console.WriteLine("unbounded count=" + unbounded.Count().ToString());

        // 2. 有界通道容量背压与优雅消费
        ch = Channel<string>.CreateBounded(2); // 容量为 2 的背压通道
        consumed = new List<string>();
        finishGate = new Gate();

        Task.Spawn(Consumer());
        Task.Spawn(Producer(5));

        // 等待消费者全部处理完毕
        await finishGate.Wait();

        Console.WriteLine("consumed count=" + consumed.Count.ToString());
        for (int i = 0; i < consumed.Count; i = i + 1) {
            Console.WriteLine("c[" + i.ToString() + "]=" + consumed[i]);
        }
        Console.WriteLine("channel completed=" + ch.IsCompleted().ToString());
        Console.WriteLine("All Channel tests passed successfully!");
    }

    static void Main() {
        await RunSuite();
    }
}
