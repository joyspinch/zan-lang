// null_string_concat.zan -- a null `string` concatenates as "" (C# semantics).
// Regression: strlen(NULL)/memcpy(_,NULL,0) are UB, so a null string operand
// used to segfault every concat/interp/comparison site.
using System;

class Program {
    static void Main() {
        string s = null;
        Console.WriteLine("a" + s);
        Console.WriteLine(s + "b");
        Console.WriteLine("a" + s + "b");
        Console.WriteLine($"[{s}]");
        Console.WriteLine($"x={s}, y");
        Console.WriteLine(s == null ? "null" : "other");
        Console.WriteLine(s == "x" ? "eq" : "neq");
        string t = "x";
        Console.WriteLine(s == t ? "same" : "diff");
        Console.WriteLine("done");
    }
}
