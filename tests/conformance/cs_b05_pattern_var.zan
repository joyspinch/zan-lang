// Conformance: B5 pattern variables and pattern switches.
// `is T x`, `is not null`, `is null`, `case T x:`, `when` guards.
class Animal { public int Legs; }
class Dog : Animal { public string Breed; }
class Cat : Animal { public bool Indoor; }

class Program {
    static string Kind(object o) {
        switch (o) {
        case Dog d when d.Legs > 3:
            return "big dog " + d.Legs;
        case Dog d:
            return "small dog";
        case Cat c when c.Indoor:
            return "indoor cat";
        case Cat c:
            return "cat";
        case string s:
            return "str " + s;
        case null:
            return "null";
        default:
            return "other";
        }
    }

    static void Main() {
        Animal a = new Dog();
        a.Legs = 4;
        Console.WriteLine(Kind(a));

        Animal a2 = new Dog();
        a2.Legs = 2;
        Console.WriteLine(Kind(a2));

        Console.WriteLine(Kind(new Cat()));

        Cat c2 = new Cat();
        c2.Indoor = true;
        Console.WriteLine(Kind(c2));

        Console.WriteLine(Kind("hi"));
        Console.WriteLine(Kind(null));

        // the switch must not release its discriminant: it is still usable
        // (and pattern-matchable) after the switch
        object o = new Dog();
        if (o is Dog d2) {
            Console.WriteLine("after " + d2.Legs);
        }

        object s = "hello";
        if (s is not null) Console.WriteLine("not null");
        if (s is string s2) Console.WriteLine("is string " + s2);
        if (!(s is int)) Console.WriteLine("not int");

        object n = null;
        if (n is null) Console.WriteLine("is null");
    }
}
