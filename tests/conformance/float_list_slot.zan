using System;

class FloatSlot {
    static void Main() {
        // 核心契约与语义定义。
        List<float> a = new List<float>();
        a.Add(1.5f);
        a.Add(2.25f);
        if (a[0] != 1.5f) { Console.WriteLine("FAIL a0 " + a[0]); return; }
        if (a[1] != 2.25f) { Console.WriteLine("FAIL a1 " + a[1]); return; }
        // 核心契约与语义定义。
        a[1] = 8.125f;
        if (a[1] != 8.125f) { Console.WriteLine("FAIL a1w " + a[1]); return; }
        // 核心契约与语义定义。
        float[] arr = a.ToArray();
        if (arr.Length != 2) { Console.WriteLine("FAIL alen " + arr.Length); return; }
        if (arr[0] != 1.5f || arr[1] != 8.125f) { Console.WriteLine("FAIL aval"); return; }
        // 核心契约与语义定义。
        List<double> d = new List<double>();
        d.Add(3);
        d.Add(2.5);
        if (d[0] != 3.0) { Console.WriteLine("FAIL d0 " + d[0]); return; }
        if (d[1] != 2.5) { Console.WriteLine("FAIL d1 " + d[1]); return; }
        // 核心契约与语义定义。
        List<string> ss = new List<string>();
        ss.Add("hi");
        string[] sa = ss.ToArray();
        if (sa.Length != 1 || sa[0] != "hi") { Console.WriteLine("FAIL sa"); return; }
        Console.WriteLine("FLOAT_SLOT_OK");
    }
}
