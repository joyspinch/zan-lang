using System;
using System.Platform;

class Program {
    static void Main() {
        // 1. Direct Pal.Environment probe
        IPlatformEnvironment pe = Pal.Environment;
        Console.WriteLine("pal_env_not_null=" + (pe != null));

        string nl = pe.NewLine();
        Console.WriteLine("pal_newline_ok=" + (nl != null && nl.Length > 0));
        Console.WriteLine("env_newline_match=" + (Environment.NewLine == nl));

        // 2. ProcessId and ExecutablePath
        int pid = pe.ProcessId();
        Console.WriteLine("pid_positive=" + (pid > 0));
        Console.WriteLine("apppath_pid_match=" + (AppPath.Pid() == pid));
        Console.WriteLine("env_pid_match=" + (Environment.ProcessId == pid));

        string exe = pe.ExecutablePath();
        Console.WriteLine("exe_not_empty=" + (exe != null && exe.Length > 0));
        Console.WriteLine("apppath_exe_match=" + (AppPath.Exe() == exe));
        Console.WriteLine("env_path_match=" + (Environment.ProcessPath == exe));

        // 3. Processor count
        int cpus = pe.ProcessorCount();
        Console.WriteLine("cpus_positive=" + (cpus >= 1));
        Console.WriteLine("env_cpus_match=" + (Environment.ProcessorCount == cpus));

        // 4. Environment variable roundtrip
        string key = "ZAN_PAL_TEST_ENV_VAR";
        string val = "PAL_VALUE_987654";
        Environment.SetEnvironmentVariable(key, val);
        string got = Environment.GetEnvironmentVariable(key);
        Console.WriteLine("env_var_match=" + (got == val));

        Environment.SetEnvironmentVariable(key, null);
        string afterUnset = Environment.GetEnvironmentVariable(key);
        Console.WriteLine("env_var_unset=" + (afterUnset == ""));

        // 5. RandomNumberGenerator
        byte[] rnd = RandomNumberGenerator.GetBytes(16);
        Console.WriteLine("rnd_not_null=" + (rnd != null));
        Console.WriteLine("rnd_len_ok=" + (rnd.Length >= 16));
        bool anyNonZero = false;
        for (int i = 0; i < 16; i = i + 1) {
            if ((rnd[i] & 255) != 0) {
                anyNonZero = true;
            }
        }
        Console.WriteLine("rnd_has_entropy=" + anyNonZero);

        Console.WriteLine("PAL_ENV_SMOKE: PASS");
    }
}
