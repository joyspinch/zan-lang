using System;
using System.IO;
using System.Net.External;
using System.Net.Http;
using System.Net.Https;
using System.Net.Sockets;
using System.Net.Tls;
using System.Threading;
using Sdk.Wechat;
using Sdk.Wechat.TenPay;

class Program {
    static int failures = 0;
    static int PORT_V2_MTLS = 19713;
    static int PORT_MP_HTTPS = 19714;
    static string MCH_KEY = "0123456789abcdef0123456789abcdef";

    static void Check(bool ok, string name) {
        Console.WriteLine((ok ? "ok " : "FAIL ") + name);
        if (!ok) { failures = failures + 1; }
    }

    static string SRV_CERT_B64 = "";
    static string SRV_KEY_B64 = "";
    static string SRV_PIN = "yfhw0i0ZlnTwW+M408wk7pFROB7w6S8CnZpZuwkcvjI=";
    static string CLI_CA_CERT_B64 = "";
    static string CLI_EC_CERT_B64 = "";
    static string CLI_EC_KEY_B64 = "MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgeZlvuIKkb20OrG1RMuTJE8GTxv2kNCbXqc/sqHyAVCShRANCAATTojgDOnP2zHj034/DSgnL42BtdwZnWYHOJV9AoI3rAraPY03EvJFueNxWVf0Otrmlk0kD/kPgLtGRAoNf8Mzc";

    static string WrapPem(string label, string b64) {
        string out1 = "-----BEGIN " + label + "-----\n";
        int pos = 0;
        while (pos < b64.Length) {
            int take = 64;
            if (pos + take > b64.Length) { take = b64.Length - pos; }
            out1 = out1 + b64.Substring(pos, take) + "\n";
            pos = pos + take;
        }
        return out1 + "-----END " + label + "-----\n";
    }

    static void WriteFixtures() {
        Directory.CreateDirectory("_scratch");
        File.WriteAllText("_scratch/wechat_srv_cert.pem", WrapPem("CERTIFICATE", SRV_CERT_B64));
        File.WriteAllText("_scratch/wechat_srv_key.pem", WrapPem("PRIVATE KEY", SRV_KEY_B64));
        File.WriteAllText("_scratch/wechat_cli_ca.pem", WrapPem("CERTIFICATE", CLI_CA_CERT_B64));
        File.WriteAllText("_scratch/wechat_cli_ec.pem", WrapPem("CERTIFICATE", CLI_EC_CERT_B64));
        File.WriteAllText("_scratch/wechat_cli_ec.key", WrapPem("PRIVATE KEY", CLI_EC_KEY_B64));
    }

    static bool AllowPinnedUnknownCa(long verifyResult, string certText) {
        return verifyResult == 19;
    }

    static async HttpResponse HandleV2Mtls(HttpRequest req) {
        WechatPayV2Request parsed = WechatPayV2Request.ParseXml(req.body);
        if (parsed.Get("out_refund_no", "") != "R20261122") {
            HttpResponse bad = HttpResponse.Text("bad request");
            bad.statusCode = 400;
            return bad;
        }
        WechatPayV2Request resp = new WechatPayV2Request();
        resp.Set("return_code", "SUCCESS")
            .Set("return_msg", "OK")
            .Set("result_code", "SUCCESS")
            .Set("refund_id", "RF_TLS_OK_001")
            .Set("nonce_str", "srvnonce1");
        resp.Set("sign", resp.Sign(MCH_KEY, "MD5"));
        string xml = resp.ToXml();
        HttpResponse ok = HttpResponse.Text(xml);
        ok.contentType = "text/xml; charset=utf-8";
        return ok;
    }

    static async HttpResponse HandleMpHttps(HttpRequest req) {
        if (req.path == "/cgi-bin/token") {
            return HttpResponse.Json("{\"access_token\":\"tok_https_001\",\"expires_in\":7200}");
        }
        if (req.path == "/cgi-bin/user/info" && req.queryString.IndexOf("access_token=tok_https_001") >= 0) {
            return HttpResponse.Json("{\"errcode\":0,\"errmsg\":\"ok\",\"openid\":\"o_https_1\"}");
        }
        HttpResponse err = HttpResponse.Json("{\"errcode\":40001,\"errmsg\":\"bad route\"}");
        err.statusCode = 400;
        return err;
    }

    static async void TestV2MtlsHttps() {
        HttpsServer srv = HttpsServer.Create("127.0.0.1", PORT_V2_MTLS,
            "_scratch/wechat_srv_cert.pem", "_scratch/wechat_srv_key.pem");
        srv.RequireClientCertificate("_scratch/wechat_cli_ca.pem");
        srv.SetTimeout(5000);
        srv.OnRequest(Program.HandleV2Mtls);
        Task.Spawn(srv.Start());
        await Task.Delay(80);
        try {
            ExternalCallPolicy policy = ExternalCallPolicy.Default().AllowLoopback();
            WechatPayV2Config cfg = new WechatPayV2Config("wx_app_1", "mch_1", MCH_KEY)
                .SetClientCertificate("_scratch/wechat_cli_ec.pem", "_scratch/wechat_cli_ec.key");
            WechatPayV2Client v2 = new WechatPayV2Client(cfg)
                .Server("127.0.0.1", PORT_V2_MTLS)
                .SetCallPolicy(policy)
                .PinPublicKey(SRV_PIN)
                .SetCertPolicy(Program.AllowPinnedUnknownCa);

            WechatPayV2Request req = new WechatPayV2Request();
            req.Set("out_refund_no", "R20261122");
            WechatRawResponse raw = await v2.RequestAsync("/secapi/pay/refund", req, true);
            WechatPayV2Request resp = WechatPayV2Request.ParseXml(raw.Body);
            Check(raw.StatusCode == 200 && resp.Get("refund_id", "") == "RF_TLS_OK_001",
                "WechatPayV2Client mTLS over HttpsServer succeeds");

            bool noMtlsDenied = false;
            WechatPayV2Client v2NoCert = new WechatPayV2Client(
                new WechatPayV2Config("wx_app_1", "mch_1", MCH_KEY))
                .Server("127.0.0.1", PORT_V2_MTLS)
                .SetCallPolicy(policy)
                .PinPublicKey(SRV_PIN)
                .SetCertPolicy(Program.AllowPinnedUnknownCa);
            try {
                WechatRawResponse unused = await v2NoCert.RequestAsync("/secapi/pay/refund", req, false);
            } catch (WechatException e) {
                noMtlsDenied = e.Code == "client.networkError";
            }
            Check(noMtlsDenied, "WechatPayV2Client without client cert rejected by mTLS HttpsServer");

            bool badPinDenied = false;
            WechatPayV2Client v2BadPin = new WechatPayV2Client(cfg)
                .Server("127.0.0.1", PORT_V2_MTLS)
                .SetCallPolicy(policy)
                .PinPublicKey("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=")
                .SetCertPolicy(Program.AllowPinnedUnknownCa);
            try {
                WechatRawResponse unused2 = await v2BadPin.RequestAsync("/secapi/pay/refund", req, true);
            } catch (WechatException e) {
                badPinDenied = e.Code == "client.networkError";
            }
            Check(badPinDenied, "WechatPayV2Client rejects mismatched server SPKI pin");
        } finally {
            srv.Stop();
            await Task.Delay(80);
        }
    }

    static async void TestMpHttps() {
        HttpsServer srv = HttpsServer.Create("127.0.0.1", PORT_MP_HTTPS,
            "_scratch/wechat_srv_cert.pem", "_scratch/wechat_srv_key.pem");
        srv.SetTimeout(5000);
        srv.OnRequest(Program.HandleMpHttps);
        Task.Spawn(srv.Start());
        await Task.Delay(80);
        try {
            ExternalCallPolicy policy = ExternalCallPolicy.Default().AllowLoopback();
            WechatClient mp = new WechatClient("wx_mp", "sec_mp")
                .Server("127.0.0.1", PORT_MP_HTTPS)
                .SetCallPolicy(policy)
                .PinPublicKey(SRV_PIN)
                .SetCertPolicy(Program.AllowPinnedUnknownCa);

            string token = await mp.GetAccessTokenAsync();
            WechatResponse r = await mp.RequestAsync("POST", "/cgi-bin/user/info", "", "{\"openid\":\"o1\"}");
            Check(token == "tok_https_001" && r.Value.Str("openid", "") == "o_https_1",
                "WechatClient token + API request over pinned HTTPS succeeds");
        } finally {
            srv.Stop();
            await Task.Delay(80);
        }
    }

    static async int Run() {
        Socket.Initialize();
        WriteFixtures();
        await TestV2MtlsHttps();
        await TestMpHttps();
        Socket.Cleanup();
        Console.WriteLine("failures=" + Convert.ToString(failures));
        return failures;
    }

    static void Main() {
        int result = await Program.Run();
        if (result != 0) { Environment.Exit(1); }
    }
}
