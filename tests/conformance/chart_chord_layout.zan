using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

// ChordLayout 纯几何：节点首现序 + 入出权重、稳定 gap、
// 最大余数法分弧、每节点内子弧中心角、ribbon 端点、确定性。
// links: A→B(10) B→C(20) C→A(5) A→C(5)。
class Program {
    static void Main() {
        List<ChartLink> links = new List<ChartLink>{
            ChartLink.Of("A", "B", 10),
            ChartLink.Of("B", "C", 20),
            ChartLink.Of("C", "A", 5),
            ChartLink.Of("A", "C", 5) };
        ChordLayout l = ChordLayout.Of(links);

        Console.WriteLine("nodes:" + Convert.ToString(l.nodes.Count));
        Console.WriteLine("weights:" + Convert.ToString(l.nodes[0].weight) + ":"
            + Convert.ToString(l.nodes[1].weight) + ":" + Convert.ToString(l.nodes[2].weight));
        Console.WriteLine("names:" + l.nodes[0].name + ":" + l.nodes[1].name + ":" + l.nodes[2].name);
        Console.WriteLine("gap:" + Convert.ToString(l.gap));
        Console.WriteLine("arcTotal:" + Convert.ToString(l.arcTotal));
        // 最大余数法：354*20/80=88 354*30/80=132 132，余 2 补前两个。
        Console.WriteLine("arcs:" + Convert.ToString(l.nodes[0].a1 - l.nodes[0].a0) + ":"
            + Convert.ToString(l.nodes[1].a1 - l.nodes[1].a0) + ":"
            + Convert.ToString(l.nodes[2].a1 - l.nodes[2].a0));
        Console.WriteLine("a0s:" + Convert.ToString(l.nodes[0].a0) + ":"
            + Convert.ToString(l.nodes[1].a0) + ":" + Convert.ToString(l.nodes[2].a0));
        Console.WriteLine("a1s:" + Convert.ToString(l.nodes[0].a1) + ":"
            + Convert.ToString(l.nodes[1].a1) + ":" + Convert.ToString(l.nodes[2].a1));
        // 弧长 + 每节点 gap 必须恰好 360。
        int sum = l.nodes[0].a1 - l.nodes[0].a0
            + (l.nodes[1].a1 - l.nodes[1].a0) + (l.nodes[2].a1 - l.nodes[2].a0)
            + l.gap * l.nodes.Count;
        Console.WriteLine("sum360:" + Convert.ToString(ChartConf.B(sum == 360)));

        Console.WriteLine("ribbons:" + Convert.ToString(l.ribbons.Count));
        // 端点 = 各节点内子弧中心角。
        Console.WriteLine("r0:" + Convert.ToString(l.ribbons[0].srcAngle) + ":"
            + Convert.ToString(l.ribbons[0].dstAngle));
        Console.WriteLine("r1:" + Convert.ToString(l.ribbons[1].srcAngle) + ":"
            + Convert.ToString(l.ribbons[1].dstAngle));
        Console.WriteLine("r2:" + Convert.ToString(l.ribbons[2].srcAngle) + ":"
            + Convert.ToString(l.ribbons[2].dstAngle));
        Console.WriteLine("r3:" + Convert.ToString(l.ribbons[3].srcAngle) + ":"
            + Convert.ToString(l.ribbons[3].dstAngle));

        // 确定性：相同输入两次调用结果一致。
        ChordLayout l2 = ChordLayout.Of(links);
        Console.WriteLine("det:" + Convert.ToString(ChartConf.B(
            l.nodes[0].a0 == l2.nodes[0].a0 && l.nodes[1].a1 == l2.nodes[1].a1
            && l.ribbons[2].srcAngle == l2.ribbons[2].srcAngle)));

        // 空 links。
        List<ChartLink> none = new List<ChartLink>();
        ChordLayout n = ChordLayout.Of(none);
        Console.WriteLine("empty:" + Convert.ToString(n.nodes.Count) + ":"
            + Convert.ToString(n.ribbons.Count));

        // AngleOf 与 FillSector 同一角度约定（0 = 12 点，顺时针）：
        // 右(1,0)=90，下(0,1)=180，左(-1,0)=270，上(0,-1)≈0（±1°）。
        // 二分查找精度 ±1°，上方向返回 359。
        Console.WriteLine("angRight:" + Convert.ToString(ChartView.AngleOf(1, 0)));
        Console.WriteLine("angBottom:" + Convert.ToString(ChartView.AngleOf(0, 1)));
        Console.WriteLine("angLeft:" + Convert.ToString(ChartView.AngleOf(0 - 1, 0)));
        Console.WriteLine("angTop:" + Convert.ToString(
            ChartConf.B((ChartView.AngleOf(0, 0 - 1) + 1) % 360 == 0)));
    }
}

class ChartConf {
    static string B(bool v) {
        if (v) { return "1"; }
        return "0";
    }
}
