using System;
using System.Collections.Generic;

namespace Conf;

/// 对象初始化器的成员集合初始化：`new C { Items = { a, b } }`
/// 对成员逐个执行 Add（C# 集合初始化器语义）。覆盖：
/// 字段成员、getter-only 属性成员、与构造器参数混用
///（构造器先种下种子，集合初始化器继续追加）、Dict 键值对、
/// 表达式项、两个实例互不共享集合。
class Bag {
    List<string> names = new List<string>();
    Dict<string, int> ages = new Dict<string, int>();

    List<string> tags = new List<string>();
    List<string> Tags {
        get { return tags; }
    }

    string Label;

    Bag(string label) { Label = label; }
}

class Holder {
    List<List<string>> grid = new List<List<string>>();
}

class Program {
    static void Main() {
        Bag b = new Bag("main") {
            names = { "ann", "bo" },
            ages = { "ann", 31, "bo", 17 },
            Tags = { "z" + "w" },
        };
        Console.WriteLine(b.names.Count);
        Console.WriteLine(b.names[0]);
        Console.WriteLine(b.names[1]);
        Console.WriteLine(b.ages["ann"]);
        Console.WriteLine(b.ages["bo"]);
        Console.WriteLine(b.Tags.Count);
        Console.WriteLine(b.Tags[0]);

        // 构造器与集合初始化器混用：成员已有的内容保留，逐个追加
        Bag c = new Bag("second");
        c.names.Add("pre");
        Console.WriteLine(c.names.Count);

        // 两个实例的集合互不共享
        Bag d = new Bag("third") { names = { "solo" } };
        Console.WriteLine(d.names.Count);
        Console.WriteLine(b.names.Count);

        // 嵌套：集合项本身又是对象初始化器
        Holder h = new Holder {
            grid = { new List<string> { "x", "y" } },
        };
        Console.WriteLine(h.grid[0][1]);
    }
}
