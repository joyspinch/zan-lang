using System;
using System.Collections.Generic;

class NullableBoxHolder {
    public int? Value;
    public static int? Shared = 4;
}

class NullableBoxOwner {
    static int? Echo(int? value) { return value; }
    static int? Fresh(int value) { int? local = value; return local; }
    static Func<int?> Capture() {
        int? value = 31;
        Func<int?> read = () => value;
        value = 37;
        return read;
    }
    static async Task<int?> AcrossAwait(int? value) {
        int? local = value;
        await Task.Delay(1);
        value = null;
        return local;
    }
    static async Task Main() {
        int? a = Fresh(11);
        int? b = Echo(a);
        a = null;
        Console.WriteLine(b.Value == 11);
        b = b;
        Console.WriteLine(b.Value == 11);
        NullableBoxHolder holder = new NullableBoxHolder();
        holder.Value = b;
        b = null;
        Console.WriteLine(holder.Value.Value == 11);
        holder.Value = holder.Value;
        Console.WriteLine(holder.Value.Value == 11);
        NullableBoxHolder.Shared = holder.Value;
        holder.Value = null;
        Console.WriteLine(NullableBoxHolder.Shared.Value == 11);
        NullableBoxHolder.Shared = null;
        Func<int?> read = Capture();
        Console.WriteLine(read().Value == 37);
        int? result = await AcrossAwait(Fresh(41));
        Console.WriteLine(result.Value == 41);
        int?[] one = new int?[] { Fresh(43), null, result };
        int? saved = one[0];
        one[0] = null;
        Console.WriteLine(saved.Value == 43);
        one[2] = one[2];
        Console.WriteLine(one[2].Value == 41);
        int?[,] rect = new int?[1,2];
        rect[0,0] = saved;
        saved = null;
        Console.WriteLine(rect[0,0].Value == 43);
        rect[0,0] = null;
        List<int?> items = new List<int?>();
        items.Add(Fresh(47));
        int? fromList = items[0];
        items.Clear();
        Console.WriteLine(fromList.Value == 47);
        decimal? wide = 1.25m;
        decimal? old = wide++;
        Console.WriteLine(old.Value == 1.25m);
        Console.WriteLine(wide.Value == 2.25m);
        decimal? sum = wide + old;
        old = null; wide = null;
        Console.WriteLine(sum.Value == 3.50m);
        for (int i = 0; i < 256; i = i + 1) {
            int? temp = Fresh(i);
            int? alias = temp;
            temp = null;
            if (alias.Value != i) { throw new Exception("nullable alias"); }
        }
        Console.WriteLine(true);
    }
}
