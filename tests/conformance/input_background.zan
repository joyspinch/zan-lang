using System;
using System.Input;

// 核心契约与语义定义。
// 接口数据协议与执行契约。
class Program {
    static int bad;

    static void Check(bool ok, string label) {
        if (!ok) { Console.WriteLine("FAIL " + label); bad = bad + 1; }
    }

    [DllImport("user32", EntryPoint = "GetDesktopWindow")]
    static extern long WinGetDesktopWindow();

    [DllImport("user32", EntryPoint = "PostMessageW")]
    static extern long WinPostMessage(nint hwnd, long msg, long wparam, long lparam);

    static void Main() {
        #if WINDOWS
        // 核心契约与语义定义。
        Check(Program.FindWindowByTitleNone() == 0, "find by title none");
        Check(Program.FindWindowByClassNone() == 0, "find by class none");
        Check(Program.FindChildNone() == 0, "find child none");

        // 接口数据协议与执行契约。
        Check(!Background.KeyDown((nint)0, 65), "keydown zero");
        Check(!Background.KeyUp((nint)0, 65), "keyup zero");
        Check(!Background.KeyPress((nint)0, 65), "keypress zero");
        Check(!Background.Repeat((nint)0, 65, 3), "repeat zero");
        Check(!Background.SendChar((nint)0, "a"), "sendchar zero");
        Check(!Background.SendText((nint)0, "abc"), "sendtext zero");
        Check(!Background.SendMacro((nint)0, "{Ctrl}{C}"), "macro zero");
        Check(!Background.MouseMove((nint)0, 5, 5), "mousemove zero");
        Check(!Background.MouseDown((nint)0, Mouse.Left(), 5, 5), "mousedown zero");
        Check(!Background.MouseUp((nint)0, Mouse.Left(), 5, 5), "mouseup zero");
        Check(!Background.MouseClick((nint)0, Mouse.Left(), 5, 5), "mouseclick zero");
        Check(!Background.MouseWheel((nint)0, 120, 0, 0), "wheel zero");
        Check(!Background.SyncKeyPress((nint)0, 65), "synckey zero");
        Check(!Background.SyncMouseClick((nint)0, Mouse.Left(), 5, 5), "syncclick zero");

        // 接口数据协议与执行契约。
        Background.SendMacro((nint)0, "");
        Background.SendMacro((nint)0, "{NoSuchKey}");
        Background.SendMacro((nint)0, "{Ctrl}{");

        // 接口数据协议与执行契约。
        long desktop = Program.WinGetDesktopWindow();
        if (desktop != 0) {
            Check(Program.WinPostMessage((nint)desktop, 0, 0, 0) != 0,
                "post chain to desktop");
        }
        #endif
        Console.WriteLine("input-background-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }

    static long FindWindowByTitleNone() {
        #if WINDOWS
        return (long)Background.FindWindowByTitle("Zan_NoSuchWindow_42");
        #else
        return 0;
        #endif
    }

    static long FindWindowByClassNone() {
        #if WINDOWS
        return (long)Background.FindWindowByClass("Zan_NoSuchClass_42");
        #else
        return 0;
        #endif
    }

    static long FindChildNone() {
        #if WINDOWS
        return (long)Background.FindChild((nint)0, "Zan_NoSuchChild_42", "");
        #else
        return 0;
        #endif
    }
}
