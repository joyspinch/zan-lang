// finally must run on every way out of its try (C# semantics): normal exit,
// return, break, continue, an exception with no matching clause, a throw out
// of a catch body, and nested try/finally unwinding.
using System;
using System.Collections.Generic;

class Boom : Exception {
    public Boom(string m) : base(m) { }
}

class Other : Exception {
    public Other(string m) : base(m) { }
}

class P {
    static int counter = 0;

    // no catch clause at all: the finally runs and the exception keeps going
    static void ThrowThrough() {
        try {
            throw new Boom("through");
        } finally {
            Console.WriteLine("f:through");
        }
    }

    // a clause that does not match: still not caught here
    static void Unmatched() {
        try {
            throw new Boom("unmatched");
        } catch (Other e) {
            Console.WriteLine("wrong " + e.Message);
        } finally {
            Console.WriteLine("f:unmatched");
        }
    }

    // two nested try/finally: both run, innermost first
    static void Nested() {
        try {
            try {
                throw new Boom("nested");
            } finally {
                Console.WriteLine("f:inner");
            }
        } finally {
            Console.WriteLine("f:outer");
        }
    }

    // a throw out of a catch body leaves this try, so its finally runs too
    static void ThrowFromCatch() {
        try {
            try {
                throw new Boom("first");
            } catch (Boom e) {
                Console.WriteLine("caught " + e.Message);
                throw new Other("second");
            } finally {
                Console.WriteLine("f:fromcatch");
            }
        } catch (Other e) {
            Console.WriteLine("caught " + e.Message);
        }
    }

    // the return value is evaluated before the finally runs
    static int ReturnValue() {
        try {
            return counter;
        } finally {
            counter = counter + 100;
        }
    }

    static int ReturnFromCatch() {
        try {
            throw new Boom("ret");
        } catch (Boom e) {
            Console.WriteLine("caught " + e.Message);
            return 5;
        } finally {
            Console.WriteLine("f:retcatch");
        }
    }

    static void Loop() {
        for (int i = 0; i < 4; i = i + 1) {
            try {
                if (i == 1) { continue; }
                if (i == 3) { break; }
                Console.WriteLine("body " + i);
            } finally {
                Console.WriteLine("f:loop " + i);
            }
        }
    }

    // owned locals in a try whose finally allocates too: no leaks
    static void Owned() {
        try {
            List<string> a = new List<string>();
            a.Add("x");
            throw new Boom("owned");
        } finally {
            List<string> b = new List<string>();
            b.Add("y");
            Console.WriteLine("f:owned " + b.Count);
        }
    }

    static int Main() {
        try { ThrowThrough(); } catch (Boom e) { Console.WriteLine("caught " + e.Message); }
        try { Unmatched(); } catch (Boom e) { Console.WriteLine("caught " + e.Message); }
        try { Nested(); } catch (Boom e) { Console.WriteLine("caught " + e.Message); }
        ThrowFromCatch();
        counter = 1;
        Console.WriteLine("ret " + ReturnValue() + " counter " + counter);
        Console.WriteLine("retcatch " + ReturnFromCatch());
        Loop();
        try { Owned(); } catch (Boom e) { Console.WriteLine("caught " + e.Message); }
        Console.WriteLine("done");
        return 0;
    }
}
