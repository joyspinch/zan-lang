using System;
using System.Security;

class Program {
    static void Main() {
        // 1. 测试 Guard.Check 初始状态幂等安全
        Guard.Check();
        Console.WriteLine("guard_check_unarmed=ok");

        // 2. 测试 Protected 内存防篡改基本存取
        Protected score = Protected.Of(1000);
        Console.WriteLine("score_init=" + score.Get().ToString());

        score.Add(250);
        Console.WriteLine("score_add=" + score.Get().ToString());

        score.Set(5000);
        Console.WriteLine("score_set=" + score.Get().ToString());

        score.Add(-1000);
        Console.WriteLine("score_sub=" + score.Get().ToString());

        Console.WriteLine("guard_probe_done=true");
    }
}
