// Hook/Hotkey lifecycle test: install and uninstall without injecting any
// real input. On Windows this proves the hook thread starts, SetWindowsHookEx
// succeeds, and Uninstall joins the thread. Hotkey registration/unregistration
// proves the RegisterHotKey path. No events are fired (the callbacks pass
// everything through / do nothing), so the test is safe to run in CI.
// On other platforms the API compiles and the same lines print.
using System;
using System.Input;
using System.Threading;

namespace Conf;

class Prog {
    #if WINDOWS
    static bool OnKey(int vk, int scan, int flags, bool injected, bool keyUp) {
        return false;   // never swallow
    }

    static bool OnMouse(int x, int y, int msg, int data, bool injected) {
        return false;
    }

    static void OnHotkey() {
    }
    #endif

    static void Main() {
        #if WINDOWS
        bool hk = Hook.InstallKeyboard(Prog.OnKey);
        if (hk) {
            Thread.Sleep(80);
            Hook.Uninstall();
        }
        bool hm = Hook.InstallMouse(Prog.OnMouse);
        if (hm) {
            Thread.Sleep(80);
            Hook.Uninstall();
        }
        // A three-modifier combo is very unlikely to collide with anything
        // the user has bound. If it does, the test reports hotkey-lifecycle 0
        // and the CI machine is simply running something that owns it.
        bool hkey = Hotkey.Register("Ctrl+Alt+F12", Prog.OnHotkey);
        if (hkey) {
            Thread.Sleep(80);
            Hotkey.Unregister();
        }
        Console.WriteLine("hook-lifecycle: " + Convert.ToString(hk ? 1 : 0));
        Console.WriteLine("hotkey-lifecycle: " + Convert.ToString(hkey ? 1 : 0));
        #else
        Console.WriteLine("hook-lifecycle: 1");
        Console.WriteLine("hotkey-lifecycle: 1");
        #endif
    }
}
