using System;
using System.Drawing;
using Gui;

namespace Conf;

class Program {
    static void Main() {
        // 1. Mat4.Mul with Vector128 FMA
        Mat4 m1 = Mat4.Translate(1.0f, 2.0f, 3.0f);
        Mat4 m2 = Mat4.Scale(2.0f, 2.0f, 2.0f);
        Mat4 mr = Mat4.Mul(m1, m2);
        Console.WriteLine((int)mr.m[0]);  // 2
        Console.WriteLine((int)mr.m[3]);  // 1
        Console.WriteLine((int)mr.m[15]); // 1

        // 2. MemoryExtensions on byte[]
        byte[] a = new byte[64];
        byte[] b = new byte[64];
        for (int i = 0; i < 64; i = i + 1) {
            a[i] = (byte)i;
            b[i] = (byte)i;
        }
        Console.WriteLine(a.SequenceEqual(b) ? "eq" : "neq"); // eq
        b[40] = 255;
        Console.WriteLine(a.SequenceEqual(b) ? "eq" : "neq"); // neq

        a[50] = 77;
        Console.WriteLine(a.IndexOf(77));     // 50
        Console.WriteLine(a.LastIndexOf(77)); // 50
        Console.WriteLine(a.Contains(77) ? "has77" : "no77"); // has77
        Console.WriteLine(a.Contains(99) ? "has99" : "no99"); // no99

        // 3. NativeMemory.SequenceEqual & IndexOf
        nint p1 = NativeMemory.Alloc(64);
        nint p2 = NativeMemory.Alloc(64);
        NativeMemory.Fill(p1, 55, 64);
        NativeMemory.Fill(p2, 55, 64);
        Console.WriteLine(NativeMemory.SequenceEqual(p1, p2, 64) ? "p_eq" : "p_neq"); // p_eq
        Span<byte> s1 = new Span<byte>(p1, 64);
        s1[33] = 42;
        Console.WriteLine(NativeMemory.IndexOf(p1, 64, 42)); // 33
        NativeMemory.Free(p1);
        NativeMemory.Free(p2);

        // 4. ImageBuffer Hardware Filters
        ImageBuffer img1 = new ImageBuffer(10, 10);
        ImageBuffer img2 = new ImageBuffer(10, 10);
        img1.Clear(0x00646464); // 100
        img2.Clear(0x00C8C8C8); // 200

        img1.AdjustBrightness(50);
        Span<byte> sp1 = new Span<byte>(img1.Pixels, 10 * 10 * 4);
        Console.WriteLine(sp1[0]); // 150

        img1.Blend50(img2);
        Console.WriteLine(sp1[0]); // 175

        img1.Darken(img2);
        Console.WriteLine(sp1[0]); // 175

        img1.Lighten(img2);
        Console.WriteLine(sp1[0]); // 200

        img1.Invert();
        Console.WriteLine(sp1[0]); // 55

        // 5. IsAscii & IndexOfAny
        Console.WriteLine(a.IsAscii() ? "ascii_yes" : "ascii_no"); // ascii_yes
        Console.WriteLine(b.IsAscii() ? "ascii_yes" : "ascii_no"); // ascii_no
        Console.WriteLine(a.IndexOfAny(100, 77)); // 50

        // 6. ToUpperAscii & ToLowerAscii
        byte[] text = new byte[32];
        text[0] = 104; text[1] = 101; text[2] = 108; text[3] = 108; text[4] = 111; // "hello"
        text.ToUpperAscii();
        Console.WriteLine((int)text[0]); // 72 ('H')
        Console.WriteLine((int)text[1]); // 69 ('E')
        text.ToLowerAscii();
        Console.WriteLine((int)text[0]); // 104 ('h')

        // 7. Mat4.TransformPoints with FMA
        float[] ptsIn = new float[6];
        ptsIn[0] = 1.0f; ptsIn[1] = 2.0f; ptsIn[2] = 3.0f;
        ptsIn[3] = 4.0f; ptsIn[4] = 5.0f; ptsIn[5] = 6.0f;
        float[] ptsOut = new float[6];
        Mat4 tr = Mat4.Translate(10.0f, 20.0f, 30.0f);
        tr.TransformPoints(ptsIn, 0, ptsOut, 0, 2);
        Console.WriteLine((int)ptsOut[0]); // 11
        Console.WriteLine((int)ptsOut[1]); // 22
        Console.WriteLine((int)ptsOut[2]); // 33
        Console.WriteLine((int)ptsOut[3]); // 14

        // 8. ImageBuffer.BoxBlur
        ImageBuffer bimg = new ImageBuffer(5, 5);
        bimg.Clear(0x00000000);
        Span<byte> bsp = new Span<byte>(bimg.Pixels, 5 * 5 * 4);
        bsp[2 * 5 * 4 + 2 * 4 + 0] = 90; // center pixel
        bimg.BoxBlur(1);
        Console.WriteLine(bsp[2 * 5 * 4 + 2 * 4 + 0] > 0 ? "blurred" : "zero"); // blurred
        bimg.Dispose();

        // 9. SwissTable 16-byte MatchGroup & MatchEmpty
        nint gptr = NativeMemory.Alloc(16);
        Span<byte> gsp = new Span<byte>(gptr, 16);
        gsp[3] = 66;   // 0x42
        gsp[7] = 128;  // 0x80 (Empty marker)
        int mGroup = NativeMemory.MatchGroup16(gptr, 66);
        Console.WriteLine(System.Numerics.BitOperations.TrailingZeroCount(mGroup)); // 3
        int mEmpty = NativeMemory.MatchEmpty16(gptr);
        Console.WriteLine(System.Numerics.BitOperations.TrailingZeroCount(mEmpty)); // 7
        NativeMemory.Free(gptr);

        // 10. Encoding.UTF8.GetString (ASCII fast path)
        byte[] asciiData = new byte[] { 72, 101, 108, 108, 111, 33 }; // "Hello!"
        Console.WriteLine(System.Text.Encoding.UTF8.GetString(asciiData)); // Hello!

        // 11. ToHexString & FromHexString
        byte[] hexRaw = new byte[] { 0xde, 0xad, 0xbe, 0xef };
        string hexStr = hexRaw.ToHexString();
        Console.WriteLine(hexStr); // deadbeef
        byte[] parsedHex = hexStr.FromHexString();
        Console.WriteLine(hexRaw.SequenceEqual(parsedHex) ? "hex_match" : "hex_mismatch"); // hex_match

        // 12. String ToUpper, ToLower, Trim
        string sTest = "  Zan Lang 2026!  ";
        Console.WriteLine(sTest.Trim()); // Zan Lang 2026!
        Console.WriteLine("hello world".ToUpper()); // HELLO WORLD
        Console.WriteLine("HELLO WORLD".ToLower()); // hello world

        // 13. IsNullOrWhiteSpace
        Console.WriteLine("                ".IsNullOrWhiteSpace() ? "ws_yes" : "ws_no"); // ws_yes
        Console.WriteLine("       x        ".IsNullOrWhiteSpace() ? "ws_yes" : "ws_no"); // ws_no

        // 14. ImageBuffer Grayscale
        ImageBuffer grayImg = new ImageBuffer(2, 2);
        Span<byte> gspx = new Span<byte>(grayImg.Pixels, 16);
        gspx[0] = 200; // B
        gspx[1] = 150; // G
        gspx[2] = 100; // R
        gspx[3] = 255; // A
        grayImg.Grayscale();
        Console.WriteLine((int)gspx[0]); // 140
        Console.WriteLine((int)gspx[1]); // 140
        Console.WriteLine((int)gspx[2]); // 140
        Console.WriteLine((int)gspx[3]); // 255
        grayImg.Dispose();

        img1.Dispose();
        img2.Dispose();
    }
}
