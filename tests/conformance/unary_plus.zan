// 一元正号：内建数值路径。宿主（C）与自举两个后端必须给出同一个结果，
// 所以这个用例只放两端口径一致的形态（类上的一元 `operator +` 重载两端口径
// 不同，另立 unary_plus_overload 用例）。
class Program {
    static void Main() {
        int x = 5;
        Console.WriteLine(+x);        // 5
        Console.WriteLine(+3.5);      // 3.5
        long l = 7L;
        Console.WriteLine(+l);        // 7
        Console.WriteLine(1 + +2);    // 3
        Console.WriteLine(+x + +x);   // 10
        int y = -4;
        Console.WriteLine(+y);        // -4
        Console.WriteLine(+(-y));     // 4
        Console.WriteLine(+x * -2);   // -10
    }
}
