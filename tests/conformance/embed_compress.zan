using System;
using System.IO;

class Program {
    static void Main() {
        string s = File.ReadAllText("assets/big.txt");
        Console.WriteLine("big_len=" + (s == null ? -1 : s.Length));
        Console.WriteLine("big_head=" + (s == null ? "NULL" : s.Substring(0, 19)));
        Console.WriteLine("big_has=" + (File.EmbedExists("assets/big.txt") ? 1 : 0));
        Console.WriteLine("big_extract=" + (File.ExtractEmbedded("assets/big.txt", "big_copy.txt") ? 1 : 0));
        Console.WriteLine("big_copy_size=" + File.GetSize("big_copy.txt"));
        string t = File.ReadAllText("assets/small.txt");
        Console.WriteLine("small_len=" + (t == null ? -1 : t.Length));
        Console.WriteLine("small_extract=" + (File.ExtractEmbedded("assets/small.txt", "small_copy.txt") ? 1 : 0));
        Console.WriteLine("small_copy_size=" + File.GetSize("small_copy.txt"));
        List<string> names = File.EmbeddedNames("");
        Console.WriteLine("names=" + (names == null ? -1 : names.Count));
        List<string> kept = new List<string>();
        bool stable = true;
        for (int i = 0; i < 32; i = i + 1) {
            string again = File.ReadAllText("assets/big.txt");
            stable = stable && (nint)again == (nint)s;
            kept.Add(again);
        }
        if (!stable || kept.Count != 32 || kept[31].Length != 1200
            || (Marshal.ReadInt64((nint)s, -8) >> 32) != 0x5A414E53L
            || Marshal.ReadInt64((nint)s, -16) != -1L) {
            throw new Exception("compressed embed string ABI or cache changed");
        }
        kept.Clear();
        string empty = File.zan_embed_read("assets/empty.txt");
        string missing = File.zan_embed_read("assets/missing.txt");
        if (empty.Length != 0 || missing.Length != 0
            || (Marshal.ReadInt64((nint)empty, -8) >> 32) != 0x5A414E53L
            || (Marshal.ReadInt64((nint)missing, -8) >> 32) != 0x5A414E53L) {
            throw new Exception("empty embed string ABI changed");
        }
        kept.Add(empty);
        kept.Add(missing);
        kept.Clear();
        Console.WriteLine("string_arc=1");
        File.Delete("big_copy.txt");
        File.Delete("small_copy.txt");
    }
}
