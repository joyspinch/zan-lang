using System;
using System.IO;

/* 底层系统交互与数据协议契约 */
class Program {
    static void Main() {
        string s = File.ReadAllText("assets/big.txt");
        Console.WriteLine("big_len=" + (s == null ? -1 : s.Length));
        Console.WriteLine("big_head=" + (s == null ? "NULL" : s.Substring(0, 19)));
        Console.WriteLine("big_has=" + (File.EmbedExists("assets/big.txt") ? 1 : 0));
        Console.WriteLine("big_extract=" + (File.ExtractEmbedded("assets/big.txt", "big_copy.txt") ? 1 : 0));
        Console.WriteLine("big_copy_size=" + File.GetSize("big_copy.txt"));
        string t = File.ReadAllText("assets/small.txt");
        Console.WriteLine("small_len=" + (t == null ? -1 : t.Length));
        Console.WriteLine("small_extract=" + (File.ExtractEmbedded("assets/small.txt", "small_copy.txt") ? 1 : 0));
        Console.WriteLine("small_copy_size=" + File.GetSize("small_copy.txt"));
        List<string> names = File.EmbeddedNames("");
        Console.WriteLine("names=" + (names == null ? -1 : names.Count));
        File.Delete("big_copy.txt");
        File.Delete("small_copy.txt");
    }
}
