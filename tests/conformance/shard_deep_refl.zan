// B-ID49: publish sharding closure truncation. This is the Fail.zan-shaped
// minimal repro (window-class GUI wiring: partial Form subclass, Form.ReadDoc
// doc lookup, sender-shaped handler kept for the reflection graph).
// Compiling it materializes the deep reflection metadata graph (type/targs/
// str/fields/mtab/ctor tables of the Gui package cross-referencing many
// types; DFS nesting ~90 interned-constant globals deep). The shard closure
// walk's old 32-level stack cap silently truncated nested travel globals'
// dependency walks: a fragment got a type table whose str/targs definitions
// landed in no fragment and LLVM parse rejected it ("use of undefined value
// '@__zan.refl.str.N'"). Demands a clean --publish through the SHARDED main
// path. At runtime the design file is absent, so the golden pins the
// deterministic miss path (no window is ever created).
using System;
using System.IO;
using Gui;
using Gui.Widget;

partial class ShardDeepRefl : Form {
    static Form ui;

    static void Main() {
        string html = Form.ReadDoc("no-such-design.html");
        if (html == null) {
            Console.WriteLine("ok: design not found");
            return;
        }
        ShardDeepRefl w = new ShardDeepRefl();
        w.ShowOffscreen();
        ui = w;
        w.Run();
    }

    static void OnFocus(Control c) {
        File.WriteAllText("FOCUS_NAME.txt", c.name);
        File.WriteAllText("FOCUS_FIRED.txt", "1");
    }
}
