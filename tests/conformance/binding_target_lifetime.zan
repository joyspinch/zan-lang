using System;

namespace Conf;

class LifetimeSpec {
    Binding<string> text;
    Binding<int> number;
}

class LifetimeModel {
    string name = "start";
    int value;
    Binding<int> self;

    LifetimeSpec Specs() {
        LifetimeSpec spec = new LifetimeSpec();
        spec.text = name;
        spec.number = value;
        return spec;
    }

    void BindSelf() { self = value; }
}

class Program {
    static void Edit(LifetimeModel model) {
        LifetimeSpec spec = model.Specs();
        spec.number.Set(spec.number.Get() + 1);
        spec.text.Set("value:" + spec.number.Get().ToString());
    }

    static void DropSelfBinding() {
        LifetimeModel model = new LifetimeModel();
        model.BindSelf();
        model.self.Set(23);
        Console.WriteLine(model.value);
    }

    static void Main() {
        LifetimeModel model = new LifetimeModel();
        for (int i = 0; i < 12; i = i + 1) { Edit(model); }
        Console.WriteLine(model.value);
        Console.WriteLine(model.name);
        DropSelfBinding();
    }
}
