using System;

class TypedPendingWatch {
    public weak TypedPendingItem target;
}
class TypedPendingItem {
    public int value;
    public TypedPendingItem() {
        value = 42;
        TypedPendingReturn.watch.target = this;
    }
}
class TypedPendingReturn {
    public static TypedPendingWatch watch;
    static void Fail() { throw new Exception("typed"); }
    static Func<int> Closure() {
        TypedPendingItem item = new TypedPendingItem();
        return () => item.value;
    }
    static Func<int> DelegateAbort() {
        try { return Closure(); }
        finally { Fail(); }
    }
    static Func<int> DelegateCaught() {
        try { return Closure(); }
        finally {
            try { Fail(); }
            catch (Exception e) { Console.WriteLine("delegate-inner"); }
        }
    }
    static TypedPendingItem[] ArrayAbort() {
        try { return new TypedPendingItem[] { new TypedPendingItem() }; }
        finally { Fail(); }
    }
    static TypedPendingItem[] ArrayCaught() {
        try { return new TypedPendingItem[] { new TypedPendingItem() }; }
        finally {
            try { Fail(); }
            catch (Exception e) { Console.WriteLine("array-inner"); }
        }
    }
    static void Main() {
        TypedPendingReturn.watch = new TypedPendingWatch();
        try { Func<int> ignored = DelegateAbort(); }
        catch (Exception e) { Console.WriteLine("delegate-abort=" + (TypedPendingReturn.watch.target == null)); }
        Func<int> callback = DelegateCaught();
        Console.WriteLine("delegate-result=" + callback());
        callback = null;
        Console.WriteLine("delegate-released=" + (TypedPendingReturn.watch.target == null));
        try { TypedPendingItem[] ignored = ArrayAbort(); }
        catch (Exception e) { Console.WriteLine("array-abort=" + (TypedPendingReturn.watch.target == null)); }
        TypedPendingItem[] values = ArrayCaught();
        Console.WriteLine("array-result=" + values[0].value);
        values = null;
        Console.WriteLine("array-released=" + (TypedPendingReturn.watch.target == null));
        TypedPendingReturn.watch = null;
    }
}
