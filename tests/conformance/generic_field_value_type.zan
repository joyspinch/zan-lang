// A generic class erases its type parameters, so the field STORAGE keeps the
// erased shape (one 64-bit slot). The VALUE that comes back out of it is
// still typed: `Box<double>.value` is a double and `Box<string>.value` is a
// string -- the receiver's static type carries the concrete type argument.
using System;

class Box<T> {
    public T value;
    public List<T> values;

    public Box(T v) {
        this.value = v;
        this.values = new List<T>();
    }

    public void Add(T v) { this.values.Add(v); }

    public T Get() { return this.value; }
}

class Program {
    static void Main() {
        Box<double> b = new Box<double>(1.5);
        b.Add(2.5);
        b.Add(4.0);
        double d = b.value;
        Console.WriteLine(Convert.ToString(d) + " " + Convert.ToString(b.Get()));
        Console.WriteLine(Convert.ToString(b.values.Count) + " "
            + Convert.ToString(b.values[0]) + " " + Convert.ToString(b.values[1]));

        Box<string> s = new Box<string>("hi");
        s.Add("there");
        string t = s.value;
        Console.WriteLine(t + " " + s.Get());
        Console.WriteLine(Convert.ToString(s.values.Count) + " "
            + Convert.ToString(s.values[0]));

        Box<int> n = new Box<int>(7);
        int k = n.value;
        Console.WriteLine(Convert.ToString(k) + " " + Convert.ToString(n.Get()));
    }
}
