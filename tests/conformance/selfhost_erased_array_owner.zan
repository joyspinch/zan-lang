using System;

interface IErasedArrayPayload {
    int GetValue();
}

class ErasedArrayPayload : IErasedArrayPayload {
    int value;
    public ErasedArrayPayload(int value) { this.value = value; }
    public int GetValue() { return value; }
}

class SelfhostErasedArrayOwner {
    static void CheckObjectArray() {
        ErasedArrayPayload first = new ErasedArrayPayload(21);
        ErasedArrayPayload next = new ErasedArrayPayload(22);
        WeakReference<ErasedArrayPayload> firstWatch = new WeakReference<ErasedArrayPayload>(first);
        WeakReference<ErasedArrayPayload> nextWatch = new WeakReference<ErasedArrayPayload>(next);
        object[] initialized = new object[] { first };
        object[] slots = new object[1];
        first = null;
        Console.WriteLine("object-init=" + (firstWatch.IsAlive && initialized[0] != null));
        slots[0] = initialized[0];
        initialized = null;
        Console.WriteLine("object-store=" + (firstWatch.IsAlive && slots[0] != null));
        slots[0] = next;
        next = null;
        Console.WriteLine("object-replace=" + (!firstWatch.IsAlive && nextWatch.IsAlive));
        slots = null;
        Console.WriteLine("object-release=" + !nextWatch.IsAlive);
    }

    static void CheckInterfaceArray() {
        ErasedArrayPayload first = new ErasedArrayPayload(31);
        ErasedArrayPayload next = new ErasedArrayPayload(32);
        WeakReference<ErasedArrayPayload> firstWatch = new WeakReference<ErasedArrayPayload>(first);
        WeakReference<ErasedArrayPayload> nextWatch = new WeakReference<ErasedArrayPayload>(next);
        IErasedArrayPayload[] initialized = new IErasedArrayPayload[] { first };
        IErasedArrayPayload[] slots = new IErasedArrayPayload[1];
        first = null;
        Console.WriteLine("interface-init=" + (firstWatch.IsAlive && initialized[0].GetValue() == 31));
        slots[0] = initialized[0];
        initialized = null;
        Console.WriteLine("interface-store=" + (firstWatch.IsAlive && slots[0].GetValue() == 31));
        slots[0] = next;
        next = null;
        Console.WriteLine("interface-replace=" + (!firstWatch.IsAlive && nextWatch.IsAlive));
        slots = null;
        Console.WriteLine("interface-release=" + !nextWatch.IsAlive);
    }

    static void CheckExplicitCasts() {
        ErasedArrayPayload[] concrete = new ErasedArrayPayload[] { new ErasedArrayPayload(41) };
        bool objectCastRejected = false;
        bool interfaceCastRejected = false;
        try {
            object[] erased = (object[])concrete;
        } catch (InvalidCastException error) {
            objectCastRejected = true;
        }
        try {
            IErasedArrayPayload[] erased = (IErasedArrayPayload[])concrete;
        } catch (InvalidCastException error) {
            interfaceCastRejected = true;
        }
        Console.WriteLine("object-cast=" + objectCastRejected);
        Console.WriteLine("interface-cast=" + interfaceCastRejected);
        Console.WriteLine("cast-source=" + (concrete[0].GetValue() == 41));

        concrete = null;
        object erasedNull = null;
        object[] nullObjectArray = (object[])concrete;
        IErasedArrayPayload[] nullInterfaceArray = (IErasedArrayPayload[])concrete;
        ErasedArrayPayload[] nullConcreteArray = (ErasedArrayPayload[])erasedNull;
        ErasedArrayPayload[,] nullRect = (ErasedArrayPayload[,])concrete;
        Console.WriteLine("null-casts=" + (nullObjectArray == null && nullInterfaceArray == null
            && nullConcreteArray == null && nullRect == null));
        Console.WriteLine("null-is-array=" + (erasedNull is ErasedArrayPayload[]));
    }

    static void Main() {
        CheckObjectArray();
        CheckInterfaceArray();
        CheckExplicitCasts();
    }
}
