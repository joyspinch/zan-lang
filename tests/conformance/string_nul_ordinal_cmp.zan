using System;
using System.Collections.Generic;

// String equality, ordering, Equals and Dict keys must be length-aware
// ordinal compares: a managed string may hold embedded NUL bytes (the \0
// escape, or bytes read through the zero-copy str/byte contract), and the
// old strcmp lowering truncated it at the first NUL -- "a\0b" == "a" was
// true and a Dict key collided with its own prefix. The bucket hash may
// still stop at the first NUL (equal hashes only mean "scan the bucket"),
// the comparison decides.
class Program {
    static void Main() {
        string a = "a\0b";
        string b = "a";
        Console.WriteLine(a.Length);
        Console.WriteLine(a == b);
        Console.WriteLine(a != b);
        Console.WriteLine("xy" == "xy");
        Console.WriteLine("xy" == "xz");
        Console.WriteLine(a.Equals("a"));
        Console.WriteLine(a.Equals("a\0b"));
        Dict<string,int> d = new Dict<string,int>();
        d["a\0b"] = 7;
        d["plain"] = 9;
        Console.WriteLine(d.ContainsKey("a"));
        Console.WriteLine(d.ContainsKey("a\0b"));
        Console.WriteLine(d.ContainsKey("plain"));
        Console.WriteLine(d["a\0b"]);
        Console.WriteLine(d["plain"]);
        Console.WriteLine("a\0b" < "a\0c");
        Console.WriteLine("abc" < "abd");
        Console.WriteLine("b" > "a\0zzz");
    }
}
