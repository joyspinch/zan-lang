using System;
using System.Linq;
using System.Collections.Generic;

class LinqPerfTest {
    static int pass = 0;
    static int fail = 0;

    static void Check(string name, bool ok) {
        if (ok) { pass = pass + 1; }
        else { fail = fail + 1; Console.WriteLine("FAIL: " + name); }
    }

    static int Main() {
        // 1. GroupByInt 语义与插入顺序保持
        List<int> nums = new List<int>();
        nums.Add(10); nums.Add(21); nums.Add(30); nums.Add(41); nums.Add(50);
        List<Grouping<int>> grp = nums.GroupBy(delegate(int x) { return x % 2; });
        Check("GroupBy count", grp.Count == 2);
        Check("GroupBy first key is 0 (10 % 2)", grp[0].IntKey == 0);
        Check("GroupBy first items count (10, 30, 50)", grp[0].Items.Count == 3);
        Check("GroupBy second key is 1 (21 % 2)", grp[1].IntKey == 1);
        Check("GroupBy second items count (21, 41)", grp[1].Items.Count == 2);

        // 2. DistinctStr (大集合哈希去重 > 4)
        List<string> words = new List<string>();
        words.Add("apple"); words.Add("banana"); words.Add("apple");
        words.Add("cherry"); words.Add("banana"); words.Add("date");
        List<string> uniq = words.Distinct();
        Check("DistinctStr count", uniq.Count == 4);
        Check("DistinctStr order", uniq[0] == "apple" && uniq[1] == "banana" && uniq[2] == "cherry" && uniq[3] == "date");

        // 3. InStr 哈希加速
        List<string> targets = new List<string>();
        targets.Add("banana"); targets.Add("date"); targets.Add("fig"); targets.Add("grape"); targets.Add("kiwi");
        List<string> inMatches = words.In(targets);
        Check("InStr matches count", inMatches.Count == 3); // banana, banana, date
        Check("InStr items", inMatches[0] == "banana" && inMatches[1] == "banana" && inMatches[2] == "date");

        // 4. TakeTop 堆排序前 3
        List<int> bigNums = new List<int>();
        bigNums.Add(55); bigNums.Add(12); bigNums.Add(89); bigNums.Add(3); bigNums.Add(42); bigNums.Add(7);
        List<int> top3 = bigNums.TakeTop(delegate(int x) { return x; }, 3);
        Check("TakeTop count", top3.Count == 3);
        Check("TakeTop values (3, 7, 12)", top3[0] == 3 && top3[1] == 7 && top3[2] == 12);

        Console.WriteLine("pass: " + Convert.ToString(pass));
        Console.WriteLine("fail: " + Convert.ToString(fail));

        return fail == 0 ? 0 : 1;
    }
}
