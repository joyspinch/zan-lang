using System;
using System.Collections.Generic;

namespace IdentityLeft;
class Item { public int Value; }

class CollectionFactory<T> {
    public object MakeList() { return new List<T>(); }
    public object MakeDictionary() { return new Dictionary<string, T>(); }
}

class Program {
    static void CheckDictionary(object value, int kind) {
        if ((value is Dictionary<string, double>) != (kind == 0))
            throw new Exception("dictionary double identity");
        if ((value is Dictionary<string, bool>) != (kind == 1))
            throw new Exception("dictionary bool identity");
        if ((value is Dictionary<string, string>) != (kind == 2))
            throw new Exception("dictionary string identity");
        if (((value as Dictionary<string, double>) != null) != (kind == 0))
            throw new Exception("dictionary double as");
        if (((value as Dictionary<string, bool>) != null) != (kind == 1))
            throw new Exception("dictionary bool as");
        if (((value as Dictionary<string, string>) != null) != (kind == 2))
            throw new Exception("dictionary string as");
        if (value is Dictionary<int, string>)
            throw new Exception("dictionary key identity");
        if (value is List<string>)
            throw new Exception("dictionary collection family");
    }

    static void CheckList(object value, int kind) {
        if ((value is List<double>) != (kind == 0))
            throw new Exception("list double identity");
        if ((value is List<bool>) != (kind == 1))
            throw new Exception("list bool identity");
        if ((value is List<string>) != (kind == 2))
            throw new Exception("list string identity");
        if (((value as List<double>) != null) != (kind == 0))
            throw new Exception("list double as");
        if (((value as List<bool>) != null) != (kind == 1))
            throw new Exception("list bool as");
        if (((value as List<string>) != null) != (kind == 2))
            throw new Exception("list string as");
        if (value is List<object>)
            throw new Exception("list invariance");
    }

    static void Main() {
        CheckDictionary(new Dictionary<string, double>(), 0);
        CheckDictionary(new Dictionary<string, bool>(), 1);
        Dictionary<string, string> words = new Dictionary<string, string>();
        words["selection"] = "beta";
        object model = words;
        CheckDictionary(model, 2);
        if (!(model is Dict<string, string>))
            throw new Exception("dictionary alias");
        Dictionary<string, string> selected = (Dictionary<string, string>)model;
        selected["selection"] = "alpha";
        if (words["selection"] != "alpha")
            throw new Exception("dictionary writeback");
        Dictionary<int, string> keyed = new Dictionary<int, string>();
        object otherKey = keyed;
        if (!(otherKey is Dictionary<int, string>) ||
            otherKey is Dictionary<string, string>)
            throw new Exception("dictionary key parameter");

        CheckList(new List<double>(), 0);
        CheckList(new List<bool>(), 1);
        CheckList(new List<string>(), 2);
        CheckList(null, -1);
        CheckDictionary(null, -1);

        object nested = new Dictionary<string, List<double>>();
        if (!(nested is Dictionary<string, List<double>>) ||
            nested is Dictionary<string, List<bool>> ||
            (nested as Dictionary<string, List<double>>) == null ||
            (nested as Dictionary<string, List<bool>>) != null)
            throw new Exception("nested dictionary identity");
        object nestedList = new List<Dictionary<string, string>>();
        if (!(nestedList is List<Dictionary<string, string>>) ||
            nestedList is List<Dictionary<string, bool>>)
            throw new Exception("nested list identity");

        object leftItems = new List<IdentityLeft.Item>();
        if (!(leftItems is List<IdentityLeft.Item>) ||
            leftItems is List<IdentityRight.Item>)
            throw new Exception("namespace list identity");
        object rightItems = new Dictionary<string, IdentityRight.Item>();
        if (!(rightItems is Dictionary<string, IdentityRight.Item>) ||
            rightItems is Dictionary<string, IdentityLeft.Item>)
            throw new Exception("namespace dictionary identity");

        CollectionFactory<string> strings = new CollectionFactory<string>();
        CollectionFactory<bool> flags = new CollectionFactory<bool>();
        CheckList(strings.MakeList(), 2);
        CheckDictionary(flags.MakeDictionary(), 1);
        List<string> ownedList = strings.MakeList() as List<string>;
        if (ownedList == null) throw new Exception("owned list as");
        ownedList.Add("kept");
        if (ownedList[0] != "kept") throw new Exception("owned list lifetime");
        Dictionary<string, bool> ownedDictionary =
            flags.MakeDictionary() as Dictionary<string, bool>;
        if (ownedDictionary == null) throw new Exception("owned dictionary as");
        ownedDictionary["kept"] = true;
        if (!ownedDictionary["kept"]) throw new Exception("owned dictionary lifetime");
        if ((strings.MakeList() as List<bool>) != null)
            throw new Exception("owned mismatch as");

        bool rejected = false;
        try {
            Dictionary<string, double> wrong = (Dictionary<string, double>)model;
            Console.WriteLine(wrong.Count);
        } catch (Exception) {
            rejected = true;
        }
        if (!rejected) throw new Exception("dictionary invalid cast");
        Console.WriteLine("RUNTIME_GENERIC_COLLECTION_IDENTITY_OK");
    }
}
