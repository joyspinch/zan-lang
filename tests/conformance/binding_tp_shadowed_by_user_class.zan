using System;

namespace TpShadow;

/// 用户类型与泛型类型参数同名（class T）不得击穿泛型方法调用。
/// Binding<T>.Set 的参数 T 曾在 irgen 侧被重新解析到用户的 class T——
/// 绑定期签名的类型参数只活在类作用域里，调用量化重解析走了单元作用域，
/// 唯一匹配的重载被判 "no overload matches"。修法：irgen 取方法参数
/// 类型时优先用绑定期落在方法符号上的 SYM_PARAM 子符号。
class Model {
    int n;
    string s;
}

class Box {
    Binding<int> num;
    Binding<string> str;

    /// 字段左值赋给 Binding 槽 = 活绑定；后续 Set 写穿回模型。
    void Bind(Model m) {
        num = m.n;
        str = m.s;
    }
    void WriteNum(int v) {
        if (num != null) { num.Set(v); }
    }
    void WriteStr(string v) {
        if (str != null) { str.Set(v); }
    }
    int ReadNum() {
        if (num == null) { return 0; }
        return num.Get();
    }
    string ReadStr() {
        if (str == null) { return ""; }
        return str.Get();
    }
}

class Holder {
    Binding<string> name;

    void Bind(string v) {
        name = v;
    }
    void Write(string x) {
        if (name != null) { name.Set(x); }
    }
    string Read() {
        if (name == null) { return ""; }
        return name.Get();
    }
}

/// 与 Binding<T> 的类型参数同名的用户类；必须照常可用。
class T {
    string tag;

    T(string t) {
        tag = t;
    }

    override string ToString() {
        return tag;
    }
}

class Program {
    static void Main() {
        Model m = new Model();
        Box b = new Box();
        b.Bind(m);
        b.WriteNum(41);
        b.WriteNum(b.ReadNum() + 1);
        Console.WriteLine(Convert.ToString(b.ReadNum()));
        Console.WriteLine(Convert.ToString(m.n));
        b.WriteStr("hello");
        Console.WriteLine(b.ReadStr());
        Console.WriteLine(m.s);

        Holder h = new Holder();
        h.Bind("seed");
        h.Write("zoom");
        Console.WriteLine(h.Read());

        T victim = new T("still-a-class");
        Console.WriteLine(victim.ToString());
    }
}
