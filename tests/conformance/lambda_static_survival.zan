using System;

// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// literals.
class Gate {
    public int hits;
}

class Program {
    static Gate gate;
    static string label;
    static int ticks;

    static bool PumpUntil(Func<bool> done) {
        for (int i = 0; i < 50; i = i + 1) {
            if (done()) { return true; }
            ticks = ticks + 1;
        }
        return done();
    }

    // 接口数据协议与执行契约。
    static int SumViaLiteral() {
        gate.hits = gate.hits + 1;
        bool ok = PumpUntil(delegate() { return gate.hits >= 1; });
        return ok ? gate.hits : -1;
    }

    static void Main() {
        gate = new Gate();
        label = "g";
        bool ok = PumpUntil(delegate() {
            gate.hits = gate.hits + 1;
            return gate.hits >= 3;
        });
        Console.WriteLine(Convert.ToString(ok ? gate.hits : -1));
        Console.WriteLine(label);
        Console.WriteLine(Convert.ToString(ticks));
        // 接口数据协议与执行契约。
        bool exprOk = PumpUntil(() => gate.hits >= 3);
        Console.WriteLine(Convert.ToString(exprOk ? 1 : 0));
        Console.WriteLine(Convert.ToString(SumViaLiteral()));
        Console.WriteLine(label + ":" + Convert.ToString(gate.hits));
    }
}
