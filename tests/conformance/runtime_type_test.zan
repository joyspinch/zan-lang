using System;
using System.Collections.Generic;

// The runtime type test: an `object` slot carries the class identity of the
// value it holds, so `o is T` is decided at runtime. The built-in containers
// are heap objects too -- they carry their own class id, so a List is not a
// Dict and a null container is not a List.

interface IShape {
    int Area();
}

class Square : IShape {
    public int side;
    public int Area() { return side * side; }
}

class Program {
    static void Main() {
        // a user class
        object sq = new Square();
        Console.WriteLine("class=" + (sq is Square));
        Console.WriteLine("iface=" + (sq is IShape));
        Console.WriteLine("object=" + (sq is object));

        // the built-in containers
        object l = new List<int>();
        Console.WriteLine("list=" + (l is List<int>));
        // the element type is not part of the runtime identity
        Console.WriteLine("list-elem=" + (l is List<string>));

        object d = new Dictionary<string, int>();
        Console.WriteLine("dict=" + (d is Dictionary<string, int>));
        Console.WriteLine("dict-alias=" + (d is Dict<string, int>));

        object sb = new StringBuilder();
        Console.WriteLine("sb=" + (sb is StringBuilder));

        // a null value is not a container
        List<int> nl = null;
        Console.WriteLine("null-list=" + (nl is List<int>));
        object onl = null;
        Console.WriteLine("null-obj=" + (onl is List<int>));

        // a container is not a user class
        Console.WriteLine("cross=" + (l is Square));
    }
}
