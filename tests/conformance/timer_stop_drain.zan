using System;
using System.Threading;

class TimerStopDrainTest {
    static AtomicInt periodicTicks = new AtomicInt(0);
    static AtomicInt entered = new AtomicInt(0);
    static AtomicInt completed = new AtomicInt(0);
    static AtomicInt selfTicks = new AtomicInt(0);
    static Timer self;
    static int checks = 0;

    static void Check(bool condition, string name) {
        if (!condition) { throw new Exception(name); }
        checks = checks + 1;
        Console.WriteLine("ok " + Convert.ToString(checks) + " - " + name);
    }

    static async void WaitFor(AtomicInt value, long target) {
        long deadline = Stopwatch.GetMilliseconds() + 2000;
        while (value.Load() < target && Stopwatch.GetMilliseconds() < deadline) { await Task.Delay(1); }
        if (value.Load() < target) { throw new Exception("timer callback deadline"); }
    }

    static void SlowTick() {
        entered.Store(1);
        Thread.Sleep(30);
        completed.Store(1);
    }

    static void SelfTick() {
        self.Stop();
        selfTicks.Increment();
    }

    static async int Main() {
        Timer periodic = new Timer(1, () => { periodicTicks.Increment(); });
        Timer slow = new Timer(1, SlowTick);
        self = new Timer(1, SelfTick);
        try {
            await periodic.StopAsync();
            await periodic.StopAsync();
            Check(!periodic.IsRunning() && periodic.TickCount() == 0, "cold and repeated stop drain");
            Check(periodic.Start(), "periodic timer starts");
            await WaitFor(periodicTicks, 2);
            await periodic.StopAsync();
            Check(!periodic.IsRunning() && periodic.TickCount() >= 2,
                "async stop drains periodic timer");

            slow.Start();
            await WaitFor(entered, 1);
            await slow.StopAsync();
            Check(completed.Load() == 1 && !slow.IsRunning(), "async stop waits for selected callback");

            self.Start();
            await WaitFor(selfTicks, 1);
            await self.StopAsync();
            self.Start();
            await WaitFor(selfTicks, 2);
            await self.StopAsync();
            Check(selfTicks.Load() == 2 && !self.IsRunning(), "callback self stop and explicit restart drain");

            for (int i = 0; i < 16; i = i + 1) {
                periodic.Start();
                await periodic.StopAsync();
            }
            Check(!periodic.IsRunning(), "last timer drains before immediate process exit");
            return 0;
        } catch (Exception e) {
            Console.WriteLine("failed - " + e.Message);
            return 1;
        } finally {
            await periodic.StopAsync();
            await slow.StopAsync();
            await self.StopAsync();
        }
    }
}
