using System;
using System.IO;

class Program {
    static void Main() {
        ByteBuffer buf = ByteBuffer.Alloc(64);

        // 1. 测试各大小数值写入与读取
        buf.WriteU8(0x42);
        buf.WriteU16(0x1234);
        buf.WriteU32(0x56789ABC);
        buf.WriteU64(0x1122334455667788L);
        buf.WriteF32(3.14159f);
        buf.WriteF64(2.718281828459045);
        buf.WriteVarInt(1);
        buf.WriteVarInt(300);
        buf.WriteVarInt(123456789012345L);

        int u8 = buf.ReadU8();
        int u16 = buf.ReadU16();
        long u32 = buf.ReadU32();
        long u64 = buf.ReadU64();
        float f32 = buf.ReadF32();
        double f64 = buf.ReadF64();
        long v1 = buf.ReadVarInt();
        long v2 = buf.ReadVarInt();
        long v3 = buf.ReadVarInt();

        if (u8 != 0x42) { Console.WriteLine("FAIL: u8=" + u8); return; }
        if (u16 != 0x1234) { Console.WriteLine("FAIL: u16=" + u16); return; }
        if (u32 != 0x56789ABC) { Console.WriteLine("FAIL: u32=" + u32); return; }
        if (u64 != 0x1122334455667788L) { Console.WriteLine("FAIL: u64=" + u64); return; }
        if (f32 < 3.14158f || f32 > 3.14160f) { Console.WriteLine("FAIL: f32=" + f32); return; }
        if (f64 < 2.7182818284 || f64 > 2.7182818285) { Console.WriteLine("FAIL: f64=" + f64); return; }
        if (v1 != 1) { Console.WriteLine("FAIL: v1=" + v1); return; }
        if (v2 != 300) { Console.WriteLine("FAIL: v2=" + v2); return; }
        if (v3 != 123456789012345L) { Console.WriteLine("FAIL: v3=" + v3); return; }

        // 2. 测试 ReadVarIntAt & PeekU8
        int np;
        long atVal = buf.ReadVarIntAt(0, out np);
        if (atVal != 0x42) { Console.WriteLine("FAIL: atVal=" + atVal); return; }
        if (buf.PeekU8(0) != 0x42) { Console.WriteLine("FAIL: peek=" + buf.PeekU8(0)); return; }

        Console.WriteLine("bytebuffer-primitives-ok: 1");
    }
}
