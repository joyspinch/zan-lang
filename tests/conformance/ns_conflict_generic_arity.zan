using System;

namespace Widgets;

// Widgets.Action below collides with Other.Action (helpers/
// ns_conflict_other_action.zan, passed alongside this file), so nsresolve
// mangles both declarations and rewrites every resolving `Action` reference.
// The generic reference `Action<string>` must NOT be rewritten onto the
// non-generic declaration: it carries type arguments Widgets.Action cannot
// take, so it stays untouched and binds the generic builtin
// System.Action<T>. Rewriting it used to drop the arguments and silently
// retype every Action<string> local as the zero-parameter delegate, which
// miscompiled each delegate invoke with the wrong argument count (LLVM
// verifier: "Incorrect number of arguments passed to called function").
// The bare form still rewrites to the mangled declaration and must keep
// working.
delegate void Action();

class Store {
    Action<string> fn;

    void Set(Action<string> f) { fn = f; }

    void Fire() { fn("lit"); }

    static void Print(string s) { Console.WriteLine("got:" + s); }

    static void UseLocal(Action a) { a(); }

    static int Main() {
        Store st = new Store();
        st.Set(Print);
        st.Fire();

        UseLocal(() => Console.WriteLine("bare-ok"));

        Console.WriteLine("OK");
        return 0;
    }
}
