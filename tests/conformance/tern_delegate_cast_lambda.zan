using System;

// B-ID111 钉子：三元臂内 cast 包裹 lambda 与 null 配对——两臂所有权判定不一致触发
// 委托 retain；委托 retain 是 clo.is 运行期分流（建 clo.rt/clo.rt.end 换块），条件
// 发射须重取臂末块，否则 Br(merge) 落回旧块成双终结符、clo.rt.end 悬空 → E3090。
// f5 用捕获 lambda 走堆闭包，让 retain 分支在运行期真正执行而非常量折叠。
delegate int Op(int a, int b);
delegate int Un(int a);

class Program {
    static bool Pick(bool c) { return c; }
    static void Main() {
        var f1 = Pick(true) ? (Op)((int a, int b) => a + b) : null;
        var f2 = Pick(false) ? (Op)((int a, int b) => a + b) : null;
        var f3 = Pick(false) ? null : (Un)((int a) => a * 3);
        var f4 = Pick(true) ? null : (Un)((int a) => a * 3);
        int k = 10;
        var f5 = Pick(true) ? (Un)((int a) => a + k) : null;
        Console.WriteLine($"{f1(2, 3)}{(f2 == null ? 1 : 0)}{f3(4)}{(f4 == null ? 1 : 0)}{f5(1)}");
    }
}
