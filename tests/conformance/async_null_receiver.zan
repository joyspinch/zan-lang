using System;

interface IRunner {
    Task<int> RunIfaceAsync();
}

class Target : IRunner {
    public int count = 10;

    public virtual void VirtualHello() {
        Console.WriteLine("Target.VirtualHello");
    }

    public async Task<int> RunAsync() {
        VirtualHello();
        await Task.Delay(1);
        return count + 1;
    }

    public async Task<int> RunIfaceAsync() {
        await Task.Delay(1);
        return count + 2;
    }

    public async Task<T> RunGenericAsync<T>(T val) {
        await Task.Delay(1);
        return val;
    }
}

class Program {
    static void Main() {
        Target t = null;
        try {
            int r1 = await t.RunAsync();
            Console.WriteLine("unreached r1: " + r1);
        } catch (Exception ex) {
            Console.WriteLine("ok local: " + ex.Message);
        }

        IRunner iface = null;
        try {
            int r2 = await iface.RunIfaceAsync();
            Console.WriteLine("unreached r2: " + r2);
        } catch (Exception ex) {
            Console.WriteLine("ok iface: " + ex.Message);
        }

        try {
            int r3 = await t.RunGenericAsync<int>(42);
            Console.WriteLine("unreached r3: " + r3);
        } catch (Exception ex) {
            Console.WriteLine("ok generic: " + ex.Message);
        }

        Target[] arr = new Target[1];
        Target t2 = arr[0];
        try {
            int r4 = await t2.RunAsync();
            Console.WriteLine("unreached r4: " + r4);
        } catch (Exception ex) {
            Console.WriteLine("ok array: " + ex.Message);
        }
    }
}
