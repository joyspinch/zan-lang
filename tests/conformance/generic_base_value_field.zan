using System;

// 依赖型泛型基类（class Validator<T> : Plan<T>）持有**值类型**类型参数字段。
//
// 三条路径都要过：
//  1. 非泛型派生类（Concrete : Validator<Pos>）；
//  2. 泛型派生类（Generic<T> : Validator<T>）；
//  3. 基类具体实例与派生类实例共存（槽宽按已知实例的最大 ABI 尺寸算）。
struct Pos {
    int x;
    int y;
    int z;
    int w;
}

class Plan<T> {
    T value;
    Plan() {
    }
    void Set(T v) {
        this.value = v;
    }
    T Get() {
        return this.value;
    }
}

class Validator<T> : Plan<T> {
    List<T> checks;
    Validator() {
        this.checks = new List<T>();
    }
    void Check(T item) {
        this.checks.Add(item);
    }
    int CheckCount() {
        return this.checks.Count;
    }
}

class Concrete : Validator<Pos> {
    Concrete() {
    }
}

class Generic<T> : Validator<T> {
    Generic() {
    }
}

class Program {
    static void Main() {
        Pos p = new Pos();
        p.x = 7;
        p.y = 8;
        p.z = 9;
        p.w = 10;

        Concrete c = new Concrete();
        c.Set(p);
        Pos q = c.Get();
        Console.WriteLine("concrete=" + Convert.ToString(q.x) + "," + Convert.ToString(q.y)
            + "," + Convert.ToString(q.z) + "," + Convert.ToString(q.w));
        c.Check(p);
        Console.WriteLine("checks=" + Convert.ToString(c.CheckCount()));

        Generic<Pos> g = new Generic<Pos>();
        g.Set(p);
        Pos r = g.Get();
        Console.WriteLine("generic=" + Convert.ToString(r.x) + "," + Convert.ToString(r.y)
            + "," + Convert.ToString(r.z) + "," + Convert.ToString(r.w));

        Plan<Pos> direct = new Plan<Pos>();
        direct.Set(p);
        Pos s = direct.Get();
        Console.WriteLine("direct=" + Convert.ToString(s.x) + "," + Convert.ToString(s.y)
            + "," + Convert.ToString(s.z) + "," + Convert.ToString(s.w));
    }
}
