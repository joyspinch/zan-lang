using System;
using System.Collections.Generic;

// B-ID101 钉子：元组表达式/元组解构初始化器/with/switch 表达式（含类型模式臂）
// 内的类型引用必须参与命名空间解析——nr_walk 缺分支时裸名不重写，
// binder scope_find 查不到直接编译红（undefined type）。
record Box(int V);

class Program {
    static void Main() {
        var t = (new HashSet<int>(), 7);                       // 元组表达式内 HashSet
        var (a, b) = (new Queue<int>().Count(), 3);            // 元组解构初始化器内 Queue
        var r = new Box(4) with { V = 5 };                     // with 表达式
        var s = r switch { Box rr => rr.V, HashSet<int> hs => hs.live, _ => -1 }; // 类型模式臂内 HashSet
        Console.WriteLine($"{t.Item1.live}{a}{b}{r.V}{s}");
    }
}
