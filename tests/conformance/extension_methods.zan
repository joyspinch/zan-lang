using System;
using System.Collections.Generic;

namespace ExtensionMethods;

class Point {
    public int X;
    public int Y;
}

class IntExtensions {
    public static int Twice(this int x) {
        return x * 2;
    }

    public static int Plus(this int x, int y) {
        return x + y;
    }
}

class StringExtensions {
    public static string Shout(this string s) {
        return s + "!";
    }
}

class PointExtensions {
    public static int Sum(this Point p) {
        return p.X + p.Y;
    }

    public static int Scaled(this Point p, int factor) {
        return (p.X + p.Y) * factor;
    }
}

class GenericExtensions {
    // 裸类型参数接收者（`this T`）扩展"任何类型"。曾被打分前的 kind 门
    // 整体跳过：TYPE_TYPE_PARAM 与任何具体接收者 kind 都不等，泛型扩展
    // 因此对所有接收者都解析失败。
    public static List<T> Singleton<T>(this T item) {
        List<T> r = new List<T>();
        r.Add(item);
        return r;
    }
}

interface Labelled {
    string Label();
}

interface ChildLabelled : Labelled { }

class LabelledItem : ChildLabelled {
    public string Label() { return "item"; }
}

class DerivedItem : LabelledItem { }

class LabelExtensions {
    public static string Describe<T>(this T item) { return "generic"; }
    public static string Describe(this Labelled item) { return item.Label(); }
    public static string Pick(this Labelled item) { return "interface"; }
    public static string Pick(this LabelledItem item) { return "concrete"; }
}

class Program {
    static void Main() {
        int n = 21;
        Console.WriteLine(n.Twice());
        Console.WriteLine(n.Plus(9));
        Console.WriteLine(n.Twice().Twice());

        string greeting = "hello";
        Console.WriteLine(greeting.Shout());

        Point p = new Point();
        p.X = 3;
        p.Y = 4;
        Console.WriteLine(p.Sum());
        Console.WriteLine(p.Scaled(10));

        List<string> one = "solo".Singleton();
        Console.WriteLine(Convert.ToString(one.Count) + ":" + one[0]);

        LabelledItem item = new LabelledItem();
        ChildLabelled child = item;
        DerivedItem derived = new DerivedItem();
        Console.WriteLine(item.Describe());
        Console.WriteLine(child.Describe());
        Console.WriteLine(derived.Describe());
        Console.WriteLine(item.Pick());
        Console.WriteLine(child.Pick());
        Console.WriteLine(p.Describe());
    }
}
