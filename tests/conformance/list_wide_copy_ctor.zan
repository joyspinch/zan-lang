using System;
using System.Collections.Generic;

namespace Conformance;

struct Vec3 {
    public double X;
    public double Y;
    public double Z;
}

struct Person {
    public string Name;
    public int Age;
    public double Score;
}

class Program {
    static void Main() {
        List<Vec3> list1 = new List<Vec3>();
        Vec3 v1; v1.X = 1.5; v1.Y = 2.5; v1.Z = 3.5;
        Vec3 v2; v2.X = 4.5; v2.Y = 5.5; v2.Z = 6.5;
        list1.Add(v1);
        list1.Add(v2);

        List<Vec3> list2 = new List<Vec3>(list1);
        Console.WriteLine(list2.Count);
        Console.WriteLine(list2[0].X);
        Console.WriteLine(list2[0].Z);
        Console.WriteLine(list2[1].X);
        Console.WriteLine(list2[1].Z);

        List<Person> plist1 = new List<Person>();
        Person p1; p1.Name = "ZanDev"; p1.Age = 42; p1.Score = 98.5;
        plist1.Add(p1);

        List<Person> plist2 = new List<Person>(plist1);
        Console.WriteLine(plist2.Count);
        Console.WriteLine(plist2[0].Name);
        Console.WriteLine(plist2[0].Age);
        Console.WriteLine(plist2[0].Score);
    }
}
