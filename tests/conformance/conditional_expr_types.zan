// A conditional expression has the type its two arms agree on.
//
// The self-hosted checker used to give a conditional expression NO type at
// all -- its InferType had no AK.Conditional branch, so the expression came
// back "unknown" and the enclosing expression fell back to its LEFT
// operand: `off + (isSet ? "#s" : "#g")` typed as `int`, and the
// self-hosted compiler refused the program with "cannot convert 'int' to
// 'string' in initializer: no implicit conversion". The C host merges the
// two arms (checker.c: merge_conditional_types) and accepts the same code.
using System;

class Program {
    static void Main() {
        bool isSet = true;
        int off = 7;

        // both arms are strings: the whole expression is a string, and
        // `int + string` is a concatenation
        string key = off + (isSet ? "#s" : "#g");
        Console.WriteLine(key);

        // both arms are ints
        int n = isSet ? 1 : 2;
        Console.WriteLine(n);

        // mixed numeric arms promote to the wider one (long)
        long widened = isSet ? 1 : 2L;
        Console.WriteLine(widened);

        // a plain string conditional
        string pick = isSet ? "a" : "b";
        Console.WriteLine(pick);
    }
}
