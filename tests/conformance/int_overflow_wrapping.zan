// A510 整数表达式 32 位运算与溢出环绕（C# unchecked 语义）
using System;

class Program {
    static void Main() {
        int a = 2147483647;
        int c = a + 1;
        Console.WriteLine(c);
        Console.WriteLine(a * 2);

        int b = -2147483647 - 1;
        Console.WriteLine(b - 1);

        uint u = 0;
        Console.WriteLine(u - 1u);

        Console.WriteLine((int)2147483648L);
        long big = 4294967296L;
        Console.WriteLine((int)big);

        Console.WriteLine(-8 >>> 1);

        int i = 2147483647;
        long j = i + 1;
        Console.WriteLine(j);

        long k = 2147483647L + 1;
        Console.WriteLine(k);
    }
}
