using System;

class Program {
    static void Main() {
        int[] empty = new int[0];
        Console.WriteLine("empty=" + empty[0]);

        int[] missing = null;
        Console.WriteLine("null=" + missing[4096]);

        string[] strings = new string[] { "first" };
        Console.WriteLine(strings[1] == null);
        Console.WriteLine(strings[0]);

        int?[] values = new int?[] { 7 };
        int? absent = values[1];
        Console.WriteLine(absent.HasValue);

        int[,] matrix = new int[2, 2];
        matrix[0, 1] = 21;
        matrix[1, 0] = 30;
        Console.WriteLine("row=" + matrix[2, 1]);
        Console.WriteLine("column=" + matrix[1, -1]);
        Console.WriteLine("valid=" + matrix[1, 0]);

        int[,] emptyMatrix = new int[2, 0];
        Console.WriteLine("empty matrix=" + emptyMatrix[1, 0]);
        try {
            int value = matrix[1, 2];
            Console.WriteLine("unexpected=" + value);
        } catch (IndexOutOfRangeException) {
            Console.WriteLine("caught matrix bounds");
        }
    }
}
