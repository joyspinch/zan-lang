// 核心契约与语义定义。
// /204     no body by definition              -> reusable
// 核心契约与语义定义。
// 测试断言与状态转移验证。
// 核心契约与语义定义。
// 用例前置构造与行为断言。
// 核心契约与执行状态转移规范。
using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Http.Client;
using System.Threading;

namespace Conf;

class Prog {
    static int PORT = 9641;
    static int accepted;
    static int requests;
    static bool killIdle;
    static TcpListener l;
    static bool probing = true;

    static async void Serve() {
        Prog.l = new TcpListener("127.0.0.1", Prog.PORT);
        Prog.l.Start();
        while (true) {
            nint c = await Prog.l.AcceptAsync();
            if (c < 0) { break; }
            if (Prog.probing) {
                // 测试断言与状态转移验证。
                // 核心契约与执行状态转移规范。
                Prog.probing = false;
            } else {
                Prog.accepted = Prog.accepted + 1;
            }
            Task.Spawn(Prog.ServeOne(c));
        }
        Prog.l.Stop();
        // 收尾后放掉静态引用：退出时的泄漏探测不再看到监听器。
        // 这里是最后碰 Prog.l 的地方（accept 循环已退出）。
        Prog.l = null;
    }

    // 用例前置构造与行为断言。
    // 测试断言与状态转移验证。
    static async void ServeOne(nint c) {
        string buf = "";
        while (true) {
            int hb = Prog.Find(buf, "\r\n\r\n");
            while (hb < 0) {
                string piece = await Socket.RecvAsync(c, 8192);
                if (piece.Length == 0) { Socket.Close(c); return; }
                buf = buf + piece;
                hb = Prog.Find(buf, "\r\n\r\n");
            }
            string head = buf.Substring(0, hb + 4);
            string rest = buf.Substring(hb + 4, buf.Length - hb - 4);
            int cl = Prog.ContentLength(head);
            while (rest.Length < cl) {
                string piece2 = await Socket.RecvAsync(c, 8192);
                if (piece2.Length == 0) { Socket.Close(c); return; }
                rest = rest + piece2;
            }
            buf = rest.Substring(cl, rest.Length - cl);
            Prog.requests = Prog.requests + 1;
            bool reqClose = Prog.FindNoCase(head, "connection: close") >= 0;

            if (Prog.Find(head, "/chunked") >= 0) {
                int _c = await Socket.SendStringAsync(c,
                    "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
                    + "5\r\nchunk\r\n0\r\n\r\n");
            } else if (Prog.Find(head, "/nolen") >= 0) {
                // 用例前置构造与行为断言。
                // 接口数据协议与执行契约。
                int _n = await Socket.SendStringAsync(c,
                    "HTTP/1.1 200 OK\r\n\r\nstreamed");
                Socket.Close(c);
                return;
            } else if (Prog.Find(head, "/close") >= 0) {
                int _x = await Socket.SendStringAsync(c,
                    "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n"
                    + "Connection: close\r\n\r\nbye!!");
                Socket.Close(c);
                return;
            } else if (Prog.Find(head, "/204") >= 0) {
                int _e = await Socket.SendStringAsync(c,
                    "HTTP/1.1 204 No Content\r\n\r\n");
            } else if (Prog.FindNoCase(head, "head /head") == 0) {
                // 测试断言与状态转移验证。
                int _h = await Socket.SendStringAsync(c,
                    "HTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\n");
            } else if (Prog.Find(head, "/echo") >= 0) {
                string rb = "len=" + Convert.ToString(cl)
                    + ":" + rest.Substring(0, cl);
                int _r = await Socket.SendStringAsync(c,
                    "HTTP/1.1 200 OK\r\nContent-Length: "
                    + Convert.ToString(rb.Length) + "\r\n\r\n" + rb);
            } else {
                int _o = await Socket.SendStringAsync(c,
                    "HTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\nlenbdy");
            }
            if (reqClose) {
                Socket.Close(c);
                return;
            }
            if (Prog.killIdle) {
                // 用例前置构造与行为断言。
                // 测试断言与状态转移验证。
                // 用例前置构造与行为断言。
                // 接口数据协议与执行契约。
                Socket.Close(c);
                return;
            }
        }
    }

    static int ContentLength(string head) {
        int i = Prog.FindNoCase(head, "content-length:");
        if (i < 0) { return 0; }
        int s = i + 15;
        while (s < head.Length && head[s] == ' ') { s = s + 1; }
        int v = 0;
        while (s < head.Length && head[s] >= '0' && head[s] <= '9') {
            v = v * 10 + (head[s] - 48);
            s = s + 1;
        }
        return v;
    }

    static int Find(string hay, string needle) {
        int n = hay.Length;
        int m = needle.Length;
        for (int i = 0; i + m <= n; i = i + 1) {
            int k = 0;
            while (k < m && (hay[i + k] & 255) == (needle[k] & 255)) {
                k = k + 1;
            }
            if (k == m) { return i; }
        }
        return -1;
    }

    static int FindNoCase(string hay, string needle) {
        int n = hay.Length;
        int m = needle.Length;
        for (int i = 0; i + m <= n; i = i + 1) {
            int k = 0;
            while (k < m) {
                int a = hay[i + k] & 255;
                int b = needle[k] & 255;
                if (a >= 65 && a <= 90) { a = a + 32; }
                if (b >= 65 && b <= 90) { b = b + 32; }
                if (a != b) { break; }
                k = k + 1;
            }
            if (k == m) { return i; }
        }
        return -1;
    }

    static async void BackgroundGet(HttpClient c, List<string> sink) {
        string r = await c.GetAsync("/len");
        sink.Add(r);
    }

    static async int Run() {
        Socket.Initialize();
        Prog.accepted = 0;
        Prog.requests = 0;
        Prog.killIdle = false;
        Task.Spawn(Prog.Serve());
        // 用例前置构造与行为断言。
        // 核心契约与语义定义。
        bool up = false;
        for (int i = 0; i < 250 && !up; i = i + 1) {
            TcpClient probe = await TcpClient.ConnectAsync("127.0.0.1",
                                                          Prog.PORT, 200);
            if (probe != null) {
                probe.Close();
                up = true;
            } else {
                await Task.Delay(20);
            }
        }

        HttpClient c = new HttpClient("127.0.0.1", Prog.PORT);
        c.SetTimeout(8000);

        // 核心契约与语义定义。
        string b1 = await c.GetAsync("/len");
        string b2 = await c.GetAsync("/len");
        string b3 = await c.GetAsync("/len");
        Console.WriteLine("bodies: " + b1 + b2 + b3);
        Console.WriteLine("reuse-one-conn: "
            + Convert.ToString(Prog.accepted == 1 ? 1 : 0));
        Console.WriteLine("requests-seen: " + Convert.ToString(Prog.requests));

        // 测试断言与状态转移验证。
        string echoed = await c.PostAsync("/echo", "a=1&b=2");
        Console.WriteLine("echo: " + echoed);
        Console.WriteLine("still-one-conn: "
            + Convert.ToString(Prog.accepted == 1 ? 1 : 0));

        // 接口数据协议与执行契约。
        string chunked = await c.GetAsync("/chunked");
        Console.WriteLine("chunked: " + chunked);
        Console.WriteLine("chunked-one-conn: "
            + Convert.ToString(Prog.accepted == 1 ? 1 : 0));

        // 接口数据协议与执行契约。
        string r204 = await c.GetAsync("/204");
        Console.WriteLine("empty204: "
            + Convert.ToString(r204.Length == 0 ? 1 : 0));
        Console.WriteLine("after204-one-conn: "
            + Convert.ToString(Prog.accepted == 1 ? 1 : 0));

        // 测试断言与状态转移验证。
        HttpResponse head = await c.SendAsync("HEAD", "/head", "");
        Console.WriteLine("head-empty: "
            + Convert.ToString(head.body.Length == 0 ? 1 : 0));
        Console.WriteLine("head-status: "
            + Convert.ToString(head.statusCode));
        Console.WriteLine("head-one-conn: "
            + Convert.ToString(Prog.accepted == 1 ? 1 : 0));

        // 测试断言与状态转移验证。
        string closed = await c.GetAsync("/close");
        int accAfterClose = Prog.accepted;
        string afterClose = await c.GetAsync("/len");
        Console.WriteLine("close-body: " + closed);
        Console.WriteLine("close-not-pooled: "
            + Convert.ToString(Prog.accepted == accAfterClose + 1 ? 1 : 0));
        Console.WriteLine("after-close: " + afterClose);

        // 测试断言与状态转移验证。
        string nolen = await c.GetAsync("/nolen");
        int accAfterNolen = Prog.accepted;
        string afterNolen = await c.GetAsync("/len");
        Console.WriteLine("nolen: " + nolen);
        Console.WriteLine("nolen-not-pooled: "
            + Convert.ToString(Prog.accepted == accAfterNolen + 1 ? 1 : 0));
        Console.WriteLine("after-nolen: " + afterNolen);

        // 用例前置构造与行为断言。
        // 测试断言与状态转移验证。
        Prog.killIdle = true;
        string _warm = await c.GetAsync("/len");
        int accBeforeRevive = Prog.accepted;
        string revived = await c.GetAsync("/len");
        Console.WriteLine("revived: " + revived);
        Console.WriteLine("revive-one-extra-conn: "
            + Convert.ToString(Prog.accepted == accBeforeRevive + 1 ? 1 : 0));

        // 用例前置构造与行为断言。
        // 接口数据协议与执行契约。
        Prog.killIdle = false;
        string _reprime = await c.GetAsync("/len");

        // 测试断言与状态转移验证。
        Prog.killIdle = false;
        int accBeforeConc = Prog.accepted;
        HttpClient cc = new HttpClient("127.0.0.1", Prog.PORT);
        cc.SetTimeout(8000);
        List<string> sink = new List<string>();
        Task.Spawn(Prog.BackgroundGet(cc, sink));
        string mainB = await cc.GetAsync("/len");
        for (int i = 0; i < 400 && sink.Count == 0; i = i + 1) {
            await Task.Delay(25);
        }
        Console.WriteLine("concurrent-main: " + mainB);
        Console.WriteLine("concurrent-bg: "
            + Convert.ToString(sink.Count == 1 ? 1 : 0)
            + (sink.Count == 1 ? ":" + sink[0] : ""));
        Console.WriteLine("concurrent-two-conns: "
            + Convert.ToString(Prog.accepted == accBeforeConc + 2 ? 1 : 0));

        // 核心契约与语义定义。
        int accBeforeNoKa = Prog.accepted;
        HttpClient nk = new HttpClient("127.0.0.1", Prog.PORT);
        nk.SetTimeout(8000);
        nk.DisableKeepAlive();
        string _na = await nk.GetAsync("/len");
        string _nb = await nk.GetAsync("/len");
        Console.WriteLine("noka-two-conns: "
            + Convert.ToString(Prog.accepted == accBeforeNoKa + 2 ? 1 : 0));

        // 测试断言与状态转移验证。
        int accBeforeExplicit = Prog.accepted;
        string _p1 = await c.GetAsync("/len");
        c.Close();
        string _p2 = await c.GetAsync("/len");
        Console.WriteLine("explicit-close-reconnects: "
            + Convert.ToString(Prog.accepted == accBeforeExplicit + 1 ? 1 : 0));

        // 测试断言与状态转移验证。
        c.Close();
        cc.Close();
        // 测试断言与状态转移验证。
        // 用例前置构造与行为断言。
        // 测试断言与状态转移验证。
        // 核心契约与语义定义。
        Prog.l.Stop();
        for (int i = 0; i < 20; i = i + 1) { await Task.Delay(10); }
        Console.WriteLine("keepalive-done: 1");
        return 0;
    }

    // 用例前置构造与行为断言。
    // 测试断言与状态转移验证。
    // 核心契约与语义定义。
    static void Main() {
        int _rc = await Run();
    }
}
