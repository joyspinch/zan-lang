using System;

// B-ID84: decimal 零除必须抛 DivideByZeroException，与 int 路径同口径，不得静默返回 0。
class Program {
    static decimal Zero() { return 0m; }

    static void Main() {
        try {
            decimal a = 100m;
            decimal c = a / Zero();
            Console.WriteLine("dec div zero fail: " + c);
        } catch (DivideByZeroException e) {
            Console.WriteLine("caught dec div zero: " + e.Message);
        }

        try {
            decimal a = 7.5m;
            decimal c = a % Zero();
            Console.WriteLine("dec rem zero fail: " + c);
        } catch (DivideByZeroException e) {
            Console.WriteLine("caught dec rem zero: " + e.Message);
        }

        // 非零路径不受影响
        Console.WriteLine(10m / 4m);
        Console.WriteLine(7.5m % 2m);
        Console.WriteLine("all checks passed");
    }
}
