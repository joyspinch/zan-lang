using System;
using System.Text;

namespace Conf;

class Prog {
    static void Check(string name, string actual, string expected) {
        if (actual == expected) { Console.WriteLine(name + ": ok"); }
        else {
            Console.WriteLine(name + ": bad");
            Console.WriteLine(actual);
        }
    }

    static void CheckUrl(string name, string url, bool expected) {
        bool actual = Markdown.SafeUrl(url);
        if (actual == expected) { Console.WriteLine(name + ": ok"); }
        else { Console.WriteLine(name + ": bad"); }
    }

    static void Main() {
        Prog.Check("blocks", Markdown.ToHtml(
            "# Title\n\nfirst <tag> & text\ncontinues\n\n- one\n- two\n\n1. alpha\n2. beta\n\n> quoted\n> again"),
            "<h1>Title</h1>\n<p>first &lt;tag&gt; &amp; text continues</p>\n<ul><li>one</li><li>two</li></ul>\n<ol><li>alpha</li><li>beta</li></ol>\n<blockquote><p>quoted again</p></blockquote>");

        Prog.Check("inline", Markdown.ToHtml(
            "**bold** and *em* and `a < b` and [site](https://example.com/?a=1&b=2) and \\*literal\\*"),
            "<p><strong>bold</strong> and <em>em</em> and <code>a &lt; b</code> and <a href=\"https://example.com/?a=1&amp;b=2\">site</a> and *literal*</p>");

        Prog.Check("fence", Markdown.ToHtml("```zan\n<x>&y\n```"),
            "<pre><code>&lt;x&gt;&amp;y</code></pre>");

        Prog.Check("unsafe", Markdown.ToHtml(
            "[x]( JAVASCRIPT:alert(1)) [y](data:text/html,bad) [z](mailto:a@b)"),
            "<p>x) y <a href=\"mailto:a@b\">z</a></p>");

        Prog.CheckUrl("url-relative", "../docs?q=1#top", true);
        Prog.CheckUrl("url-relative-c0", "/path" + (char)1 + "tail", false);
        Prog.CheckUrl("url-http-case", "HtTp://example.com", true);
        Prog.CheckUrl("url-https-case", "HTTPS://example.com", true);
        Prog.CheckUrl("url-mailto-case", "MaIlTo:a@b", true);
        Prog.CheckUrl("url-unknown", "ftp://example.com", false);
        Prog.CheckUrl("url-js-case", "JaVaScRiPt:alert(1)", false);
        Prog.CheckUrl("url-percent-scheme", "%6a%61vascript:alert(1)", false);
        Prog.CheckUrl("url-tab-scheme", "java\tscript:alert(1)", false);
        Prog.CheckUrl("url-cr-scheme", "java\rscript:alert(1)", false);
        Prog.CheckUrl("url-lf-scheme", "java\nscript:alert(1)", false);
        Prog.CheckUrl("url-nul-scheme", "java" + (char)0 + "script:alert(1)", false);
        Prog.CheckUrl("url-c0", "path" + (char)31 + "tail", false);
        Prog.CheckUrl("url-del", "path" + (char)127 + "tail", false);

        Prog.Check("malformed", Markdown.ToHtml(
            "##no heading\n\nopen **bold and [link](oops\n\n```\nraw <&"),
            "<p>##no heading</p>\n<p>open **bold and [link](oops</p>\n<pre><code>raw &lt;&amp;</code></pre>");
    }
}
