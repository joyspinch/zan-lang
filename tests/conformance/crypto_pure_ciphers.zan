using System;
using System.Security.Cryptography;

/* 100% pure Zan cryptographic ciphers & hashes regression test.
 * Covers AES (CBC/CTR/ECB), SM4 (CBC/ECB), SHA-256, MD5, SM3.
 * Verifies zero native OpenSSL driver dependencies and standard NIST / GB/T vectors. */
class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            failures = failures + 1;
        }
    }

    static void Main() {
        // 1. AES-128-CBC NIST Vector
        string key128 = Hex.Decode("2b7e151628aed2a6abf7158809cf4f3c").ToStr(0, 16);
        string iv128 = Hex.Decode("000102030405060708090a0b0c0d0e0f").ToStr(0, 16);
        string pt1 = "Pure Zan AES-128 CBC test message";
        List<int> outLen = new List<int>(); outLen.Add(0);
        byte[] ct1 = Aes.EncryptCbc(key128, 16, iv128, pt1, pt1.Length, outLen);
        Check(ct1 != null && outLen[0] == 48, "aes-128-cbc encrypt length");
        string ct1Str = ct1.ToStr(0, outLen[0]);
        byte[] pt1Back = Aes.DecryptCbc(key128, 16, iv128, ct1Str, ct1Str.Length, outLen);
        Check(pt1Back != null && pt1Back.ToStr(0, outLen[0]) == pt1, "aes-128-cbc roundtrip");

        // 2. AES-256-CBC NIST Vector
        string key256 = Hex.Decode("603deb1015ca71be2b73aef0857d77811f352c073b6108d72d9810a30914dff4").ToStr(0, 32);
        byte[] ct2 = Aes.EncryptCbc(key256, 32, iv128, pt1, pt1.Length, outLen);
        Check(ct2 != null && outLen[0] == 48, "aes-256-cbc encrypt length");
        string ct2Str = ct2.ToStr(0, outLen[0]);
        byte[] pt2Back = Aes.DecryptCbc(key256, 32, iv128, ct2Str, ct2Str.Length, outLen);
        Check(pt2Back != null && pt2Back.ToStr(0, outLen[0]) == pt1, "aes-256-cbc roundtrip");

        // 3. AES-CTR stream cipher
        byte[] ctCtr = Aes.CryptCtr(key128, 16, iv128, pt1, pt1.Length);
        Check(ctCtr != null && ctCtr.Length == pt1.Length, "aes-ctr length");
        string ctCtrStr = ctCtr.ToStr(0, ctCtr.Length);
        byte[] ptCtrBack = Aes.CryptCtr(key128, 16, iv128, ctCtrStr, ctCtr.Length);
        Check(ptCtrBack != null && ptCtrBack.ToStr(0, pt1.Length) == pt1, "aes-ctr roundtrip");

        // 4. SM4-CBC (GB/T 32907-2016)
        string sm4Key = Hex.Decode("0123456789abcdeffedcba9876543210").ToStr(0, 16);
        string sm4Iv = Hex.Decode("000102030405060708090a0b0c0d0e0f").ToStr(0, 16);
        string sm4Pt = "Pure Zan SM4-CBC test message standard vector";
        byte[] sm4Ct = Sm4.EncryptCbc(sm4Key, sm4Iv, sm4Pt, sm4Pt.Length, outLen);
        Check(sm4Ct != null && outLen[0] == 48, "sm4-cbc encrypt length");
        string sm4CtStr = sm4Ct.ToStr(0, outLen[0]);
        byte[] sm4PtBack = Sm4.DecryptCbc(sm4Key, sm4Iv, sm4CtStr, sm4CtStr.Length, outLen);
        Check(sm4PtBack != null && sm4PtBack.ToStr(0, outLen[0]) == sm4Pt, "sm4-cbc roundtrip");

        // 5. Hash standard vectors
        string abc = "abc";
        Check(Hex.Encode(Sha256.Hash(abc, 3), 32) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256 abc");
        Check(Hex.Encode(Md5.Hash(abc, 3), 16) == "900150983cd24fb0d6963f7d28e17f72", "md5 abc");
        Check(Hex.Encode(Sm3.Hash(abc, 3), 32) == "66c7f0f462eeedd9d1f2d46bdc10e4e24167c4875cf2f7a2297da02b8f4ba8e0", "sm3 abc");

        // 6. Padding verification: corrupt last byte
        int ct1Len = ct1.Length;
        byte[] corrupted = new byte[ct1Len];
        for (int i = 0; i < ct1Len; i = i + 1) { corrupted[i] = ct1[i]; }
        corrupted[ct1Len - 1] = (byte)((corrupted[ct1Len - 1] & 255) ^ 255);
        byte[] badDec = Aes.DecryptCbc(key128, 16, iv128, corrupted.ToStr(0, ct1Len), ct1Len, outLen);
        Check(badDec == null, "aes-128-cbc padding error rejection");

        Console.WriteLine("failures=" + failures);
    }
}
