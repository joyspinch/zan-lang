// Template test: {{key}} HTML-escapes, {{{key}}} is raw, unknown keys are
// empty; RenderRaw escapes nothing; EscapeHtml covers the five entities.
using System;
using System.Text;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        Dictionary<string, string> vars = new Dictionary<string, string>();
        vars["name"] = "<b>zan</b>";
        vars["x"] = "a&b";
        vars["empty"] = "";

        string r1 = Template.Render("Hi {{name}}!", vars);
        if (r1 != "Hi &lt;b&gt;zan&lt;/b&gt;!") { bad = bad + 1; }
        string r2 = Template.Render("Hi {{{name}}}!", vars);
        if (r2 != "Hi <b>zan</b>!") { bad = bad + 1; }
        // Unknown key -> "".
        string r3 = Template.Render("[{{missing}}]", vars);
        if (r3 != "[]") { bad = bad + 1; }
        // Escaping only applies to {{ }}, not {{{ }}}.
        string r4 = Template.Render("{{x}}|{{{x}}}", vars);
        if (r4 != "a&amp;b|a&b") { bad = bad + 1; }
        // RenderRaw: no escaping anywhere.
        string r5 = Template.RenderRaw("{{x}} {{{name}}}", vars);
        if (r5 != "a&b <b>zan</b>") { bad = bad + 1; }
        // No markers: unchanged, literal braces survive.
        string r6 = Template.Render("plain { text }", vars);
        if (r6 != "plain { text }") { bad = bad + 1; }
        // EscapeHtml covers all five entities.
        string e1 = Template.EscapeHtml("&<>\"'");
        if (e1 != "&amp;&lt;&gt;&quot;&#39;") { bad = bad + 1; }
        Console.WriteLine("template-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
