// 核心契约与语义定义。
using System;

class Program {
    static int Main() {
        int a = 1;
        long b = 1;
        int neg = -8;
        int i33 = a << 33;
        int i31 = a << 31;
        int i64v = a << 64;
        long l33 = b << 33;
        int r33 = neg >> 33;
        Console.WriteLine("i33=" + Convert.ToString(i33));
        Console.WriteLine("i31=" + Convert.ToString(i31));
        Console.WriteLine("i64=" + Convert.ToString(i64v));
        Console.WriteLine("l33=" + Convert.ToString(l33));
        Console.WriteLine("r33=" + Convert.ToString(r33));
        int c = 1;
        c = c << 33;
        Console.WriteLine("c=" + Convert.ToString(c));
        return 0;
    }
}
