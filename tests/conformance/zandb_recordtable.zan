using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Data.ZanDb;

// 刀16 纯二进制结构化表格引擎（RecordTable）工业级深化用例：
// 1. .ztab 物理文件创建与头部元数据校验（魔数 ZTAB、版本、行宽、列数、总行数）；
// 2. 0% JsonValue 强类型列存取（Int32/Int64/Float32/Float64/FixedStr/Bool/VarStr/Blob）；
// 3. .zblob 伴生变长存储池与 8 字节指针零额外 I/O 空值优化；
// 4. .zidx 二级索引磁盘持久化与重开免全表扫描 O(1) 恢复；
// 5. Add / AddBulk 高吞吐写入与 O(1) 绝对物理偏移 Get 直读；
// 6. Update 原地槽位与变长数据更新；
// 7. Delete 墓碑软删除与零 ID 漂移稳定性契约；
// 8. Scan 零拷贝全表访问与 Vacuum 物理紧凑双重空间回收（.ztab + .zblob）；
// 9. Schema 序列化与自描述无参重开恢复；
// 10. ZanDatabase 门面生命周期托管（GetRecordTable、IntegrityCheck、Backup 伴生文件全复制）。
class ZanDbRecordTableTest {
    static int checks = 0;

    static void Ok(bool cond, string what) {
        checks = checks + 1;
        if (cond) {
            Console.WriteLine("ok " + Convert.ToString(checks) + " - " + what);
        } else {
            Console.WriteLine("FAIL " + Convert.ToString(checks) + " - " + what);
        }
    }

    static void Clean(string basePath) {
        ZanStore.CleanTargetFiles(basePath, 256);
        if (File.Exists(basePath + ".emp.ztab")) { File.Delete(basePath + ".emp.ztab"); }
        if (File.Exists(basePath + ".emp.zblob")) { File.Delete(basePath + ".emp.zblob"); }
        if (File.Exists(basePath + ".emp.zidx")) { File.Delete(basePath + ".emp.zidx"); }
        if (File.Exists(basePath + ".emp.zwal")) { File.Delete(basePath + ".emp.zwal"); }
        if (File.Exists(basePath + ".emp.ztab.vac")) { File.Delete(basePath + ".emp.ztab.vac"); }
        if (File.Exists(basePath + ".emp.ztab.vac.emp.ztab")) { File.Delete(basePath + ".emp.ztab.vac.emp.ztab"); }
        if (File.Exists(basePath + ".emp.ztab.vac.emp.zblob")) { File.Delete(basePath + ".emp.ztab.vac.emp.zblob"); }
        if (File.Exists(basePath + ".emp.ztab.vac.emp.zidx")) { File.Delete(basePath + ".emp.ztab.vac.emp.zidx"); }
        if (File.Exists(basePath + ".emp.ztab.vac.emp.zwal")) { File.Delete(basePath + ".emp.ztab.vac.emp.zwal"); }
    }

    static void Main() {
        string dbPath = "_scratch/test_rt_conformance";
        string bkPath = "_scratch/test_rt_backup";
        Directory.CreateDirectory("_scratch");
        Clean(dbPath);
        Clean(bkPath);

        // 1. 初始化打开与基础元数据（含 VarStr 与 Blob）
        RecordSchema schema = new RecordSchema();
        schema.AddInt32("id");
        schema.AddFixedStr("name", 32);
        schema.AddFixedStr("dept", 16);
        schema.AddInt32("age");
        schema.AddFloat64("salary");
        schema.AddBool("isActive");
        schema.AddVarStr("bio");
        schema.AddBlob("avatar");

        RecordTable rt = RecordTable.Open(dbPath, "emp", schema);
        Ok(rt.IsOpen(), "RecordTable open successfully");
        Ok(rt.Count() == 0 && rt.TotalRows() == 0, "initial table is empty");
        Ok(rt.Schema().rowBytes == 92, "schema rowBytes aligned");
        Ok(rt.Schema().columns.Count == 8, "schema column count matches");
        Ok(File.Exists(dbPath + ".emp.zblob"), "companion zblob file created");

        // 2. 单条写入与读取（零 JsonValue，含变长文本与原始 Blob）
        RecordRow r1 = new RecordRow(schema);
        r1.SetInt32("id", 1001);
        r1.SetStr("name", "Alice");
        r1.SetStr("dept", "finance");
        r1.SetInt32("age", 28);
        r1.SetFloat64("salary", 18500.50);
        r1.SetBool("isActive", true);
        r1.SetVarStr("bio", "Alice is a principal software engineer specializing in database storage engines and compiler backends.");
        byte[] av1 = new byte[5];
        av1[0] = (byte)0xDE;
        av1[1] = (byte)0xAD;
        av1[2] = (byte)0xBE;
        av1[3] = (byte)0xEF;
        av1[4] = (byte)0x42;
        r1.SetBlob("avatar", av1);

        int id1 = rt.Add(r1);
        Ok(id1 == 1, "first sequential id is 1");
        Ok(rt.Count() == 1 && rt.TotalRows() == 1, "row count incremented");

        RecordRow g1 = rt.Get(id1);
        Ok(g1 != null, "Get returns row");
        Ok(g1.GetInt32("id") == 1001, "Get int32 matches");
        Ok(g1.GetStr("name") == "Alice", "Get fixedStr name matches");
        Ok(g1.GetStr("dept") == "finance", "Get fixedStr dept matches");
        Ok(g1.GetInt32("age") == 28, "Get int32 age matches");
        Ok(Math.Abs(g1.GetFloat64("salary") - 18500.50) < 1e-6, "Get float64 salary matches");
        Ok(g1.GetBool("isActive") == true, "Get bool matches");
        Ok(g1.GetVarStr("bio") == "Alice is a principal software engineer specializing in database storage engines and compiler backends.", "Get varStr bio matches");
        byte[] gAv = g1.GetBlob("avatar");
        bool avMatch = gAv != null && gAv.Length == 5 && gAv[0] == (byte)0xDE && gAv[1] == (byte)0xAD && gAv[2] == (byte)0xBE && gAv[3] == (byte)0xEF && gAv[4] == (byte)0x42;
        Ok(avMatch, "Get blob avatar matches");

        // 3. 原地 Update 修改
        g1.SetStr("name", "Alice Smith");
        g1.SetInt32("age", 29);
        g1.SetVarStr("bio", "Alice is a chief architect.");
        bool updated = rt.Update(id1, g1);
        Ok(updated, "Update succeeds");
        RecordRow u1 = rt.Get(id1);
        Ok(u1.GetStr("name") == "Alice Smith" && u1.GetInt32("age") == 29, "Update reflected in read");
        Ok(u1.GetVarStr("bio") == "Alice is a chief architect.", "Update varStr bio reflected");

        // 4. 批量追加 AddBulk
        List<RecordRow> bulk = new List<RecordRow>();
        for (int i = 2; i <= 21; i = i + 1) {
            RecordRow r = new RecordRow(schema);
            r.SetInt32("id", 1000 + i);
            r.SetStr("name", "User_" + Convert.ToString(i));
            r.SetStr("dept", (i % 2 == 0) ? "tech" : "finance");
            r.SetInt32("age", 20 + i);
            r.SetFloat64("salary", 10000.0 + (double)i * 1000.0);
            r.SetBool("isActive", true);
            r.SetVarStr("bio", "Bio for user " + Convert.ToString(i));
            byte[] avB = new byte[2];
            avB[0] = (byte)i;
            avB[1] = (byte)(i + 1);
            r.SetBlob("avatar", avB);
            bulk.Add(r);
        }
        int firstId = 0;
        rt.AddBulk(bulk, out firstId);
        Ok(firstId == 2, "AddBulk firstId is 2");
        Ok(rt.Count() == 21 && rt.TotalRows() == 21, "AddBulk total rows is 21");

        // 5. 二级索引构建与持久化 (.zidx)
        rt.EnsureIndex("dept");
        Ok(File.Exists(dbPath + ".emp.zidx"), "EnsureIndex persists zidx file");
        List<RecordRow> techRows = rt.FindByIndex("dept", "tech");
        Ok(techRows.Count == 10, "FindByIndex returns 10 tech rows");
        List<RecordRow> financeRows = rt.FindByIndex("dept", "finance");
        Ok(financeRows.Count == 11, "FindByIndex returns 11 finance rows (including Alice)");

        // 6. 软删除与墓碑稳定性（零 ID 漂移）
        rt.Delete(id1);
        Ok(rt.Count() == 20 && rt.TotalRows() == 21, "after Delete: active=20, total=21");
        Ok(rt.Get(id1) == null, "Get on deleted id returns null");
        Ok(rt.Get(2) != null, "Get on sibling id 2 returns row");

        // 追加新记录：分配新 id=22，前面的数据 ID 绝对不前移漂移
        RecordRow rNew = new RecordRow(schema);
        rNew.SetInt32("id", 9999);
        rNew.SetStr("name", "NewGuy");
        rNew.SetStr("dept", "hr");
        rNew.SetInt32("age", 22);
        rNew.SetFloat64("salary", 8000.0);
        rNew.SetBool("isActive", true);
        rNew.SetVarStr("bio", "New guy bio");
        byte[] avNew = new byte[1];
        avNew[0] = 99;
        rNew.SetBlob("avatar", avNew);
        int idNew = rt.Add(rNew);
        Ok(idNew == 22, "new Add receives next sequential id 22 without shifting previous ids");
        Ok(rt.Count() == 21 && rt.TotalRows() == 22, "counts accurate after add with tombstone: active=21, total=22");

        // 7. Scan 零拷贝全表扫描（跳过墓碑）
        int scannedCount = 0;
        rt.Scan((int id, RecordRow row) => {
            scannedCount = scannedCount + 1;
            return true;
        });
        Ok(scannedCount == 21, "Scan visits only 21 active rows");

        // 8. 刷盘与关闭，重开无参反序列化 Schema 与 .zidx 快速加载
        rt.Flush();
        rt.Close();

        RecordTable rtReopen = RecordTable.Open(dbPath, "emp");
        Ok(rtReopen.IsOpen(), "reopen RecordTable succeeds without passing schema");
        Ok(rtReopen.Count() == 21 && rtReopen.TotalRows() == 22, "reopened count matches");
        Ok(rtReopen.Schema().columns.Count == 8, "reopened schema column count matches");
        Ok(rtReopen.Get(id1) == null, "reopened tombstoned id remains null");
        RecordRow gNew = rtReopen.Get(22);
        Ok(gNew != null && gNew.GetStr("name") == "NewGuy", "reopened new row data matches");
        List<RecordRow> reFinance = rtReopen.FindByIndex("dept", "finance");
        Ok(reFinance.Count == 10, "reopened persistent index finds 10 finance rows without full reindex");
        Ok(gNew.GetVarStr("bio") == "New guy bio", "reopened varStr content intact");
        byte[] gNewAv = gNew.GetBlob("avatar");
        Ok(gNewAv != null && gNewAv.Length == 1 && gNewAv[0] == 99, "reopened blob content intact");

        // 9. 物理紧凑整理（Vacuum 回收 .ztab 墓碑与 .zblob 垃圾空间）
        rtReopen.Vacuum();
        Ok(rtReopen.Count() == 21 && rtReopen.TotalRows() == 21, "after Vacuum: active=21, total=21");
        RecordRow vNew = rtReopen.Get(21);
        Ok(vNew != null && vNew.GetVarStr("bio") == "New guy bio", "after Vacuum: varStr content preserved");
        byte[] vAv = vNew != null ? vNew.GetBlob("avatar") : null;
        Ok(vAv != null && vAv.Length == 1 && vAv[0] == 99, "after Vacuum: blob content preserved");
        rtReopen.Close();

        // 10. ZanDatabase 统一门面生命周期托管
        ZanDatabase db = ZanDatabase.Open(dbPath);
        RecordTable dbRt = db.GetRecordTable("emp");
        Ok(dbRt.IsOpen() && dbRt.Count() == 21, "ZanDatabase loads RecordTable with 21 rows");
        List<string> problems = db.IntegrityCheck();
        Ok(problems.Count == 0, "IntegrityCheck clean for database and record table");

        db.Flush();
        db.Backup(bkPath);
        db.Close();

        // 校验备份库伴生文件完整性与数据可读性
        Ok(File.Exists(bkPath + ".emp.zblob"), "backup copied companion zblob file");
        Ok(File.Exists(bkPath + ".emp.zidx"), "backup copied companion zidx file");
        Ok(File.Exists(bkPath + ".emp.zwal"), "backup copied companion zwal file");

        ZanDatabase dbBk = ZanDatabase.Open(bkPath);
        RecordTable bkRt = dbBk.GetRecordTable("emp");
        Ok(bkRt.IsOpen() && bkRt.Count() == 21, "backup database loaded RecordTable with 21 rows");
        List<string> bkProblems = dbBk.IntegrityCheck();
        Ok(bkProblems.Count == 0, "backup database integrity check clean");
        RecordRow bRow = bkRt.Get(21);
        Ok(bRow != null && bRow.GetVarStr("bio") == "New guy bio", "backup database reads varStr accurately");
        byte[] bAv = bRow != null ? bRow.GetBlob("avatar") : null;
        Ok(bAv != null && bAv.Length == 1 && bAv[0] == 99, "backup database reads blob accurately");
        dbBk.Close();

        // 11. 伴生预写日志 (.zwal) 与事务 ACID 原子回滚保障
        RecordTable rtTx = RecordTable.Open(dbPath, "emp");
        Ok(File.Exists(dbPath + ".emp.zwal"), "companion zwal log file exists");
        rtTx.BeginTransaction();
        RecordRow rRoll = new RecordRow(schema);
        rRoll.SetInt32("id", 8888);
        rRoll.SetStr("name", "RollbackUser");
        rRoll.SetStr("dept", "legal");
        rRoll.SetInt32("age", 40);
        rRoll.SetFloat64("salary", 30000.0);
        rRoll.SetBool("isActive", true);
        rRoll.SetVarStr("bio", "Will be rolled back");
        int rId = rtTx.Add(rRoll);
        Ok(rId == 22, "in-tx add returns next id 22");
        rtTx.Rollback();
        Ok(rtTx.Count() == 21 && rtTx.TotalRows() == 21, "after Rollback: counts revert to 21");
        Ok(rtTx.Get(22) == null, "after Rollback: row 22 is non-existent");

        // 事务提交
        rtTx.BeginTransaction();
        RecordRow rCommit = new RecordRow(schema);
        rCommit.SetInt32("id", 7777);
        rCommit.SetStr("name", "CommitUser");
        rCommit.SetStr("dept", "tech");
        rCommit.SetInt32("age", 32);
        rCommit.SetFloat64("salary", 25000.0);
        rCommit.SetBool("isActive", true);
        rCommit.SetVarStr("bio", "Committed successfully");
        int cId = rtTx.Add(rCommit);
        Ok(cId == 22, "second in-tx add returns id 22");
        rtTx.Commit();
        Ok(rtTx.Count() == 22 && rtTx.TotalRows() == 22, "after Commit: counts increment to 22");
        RecordRow gC = rtTx.Get(22);
        Ok(gC != null && gC.GetStr("name") == "CommitUser", "after Commit: row 22 data persistent");
        Ok(gC.GetVarStr("bio") == "Committed successfully", "after Commit: varStr bio intact");

        // 12. 磁盘有序索引与范围查询 (FindRange 支持 <, <=, >, >=)
        rtTx.EnsureIndex("age");
        List<RecordRow> rangeAge = rtTx.FindRange("age", "25", "30");
        Ok(rangeAge.Count > 0, "FindRange on age [25, 30] returns rows");
        bool allInRange = true;
        for (int i = 0; i < rangeAge.Count; i = i + 1) {
            int a = rangeAge[i].GetInt32("age");
            if (a < 25 || a > 30) { allInRange = false; }
        }
        Ok(allInRange, "all rows returned by FindRange are strictly within [25, 30]");

        // 13. System.Linq.ExprNode 编译期语法树下推求值器 (0% JsonValue, 0 SQL 字符串解析)
        RecordQuery q1 = rtTx.Where((ExprNode x) => x.age >= 25 && x.dept == "tech");
        List<RecordRow> qRes1 = q1.ToList();
        Ok(qRes1.Count > 0, "ExprNode query (age >= 25 && dept == 'tech') returns matching rows");
        bool q1Valid = true;
        for (int i = 0; i < qRes1.Count; i = i + 1) {
            if (qRes1[i].GetInt32("age") < 25 || qRes1[i].GetStr("dept") != "tech") {
                q1Valid = false;
            }
        }
        Ok(q1Valid, "ExprNode query results 100% fulfill predicate conditions");

        // 带有排序与分页的语法树查询
        RecordQuery q2 = rtTx.Where((ExprNode x) => x.salary > 10000.0).OrderByDescending("salary").Take(5);
        List<RecordRow> top5 = q2.ToList();
        Ok(top5.Count == 5, "OrderByDescending salary Take 5 returns 5 rows");
        bool sortedDesc = true;
        for (int i = 0; i < top5.Count - 1; i = i + 1) {
            if (top5[i].GetFloat64("salary") < top5[i + 1].GetFloat64("salary")) {
                sortedDesc = false;
            }
        }
        Ok(sortedDesc, "results are strictly sorted in descending order of salary");

        rtTx.Close();

        // 收尾清理
        Clean(dbPath);
        Clean(bkPath);
        Console.WriteLine("ALL " + Convert.ToString(checks) + " CHECKS PASSED");
    }
}
