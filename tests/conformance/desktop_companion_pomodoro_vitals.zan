using System;
using System.Windows;

namespace Conf;

class DesktopCompanionPomodoroVitalsTest {
    static void Main() {
        // 1. 番茄钟周期、AFK 自动暂停保护、连击经验/金币倍率与长休触发（2 轮触发长休）
        CompanionPomodoroSession pomo = new CompanionPomodoroSession(10.0f, 3.0f, 8.0f, 2);
        pomo.StartWork();
        pomo.Tick(4.0f);
        pomo.SyncAfkState(true); // 离席 -> 自动暂停
        pomo.Tick(5.0f);         // 暂停期间不应扣减时间
        bool pausedOk = pomo.Paused && pomo.AutoPausedByAfk && pomo.RemainingSec > 5.9f && pomo.RemainingSec < 6.1f;

        pomo.SyncAfkState(false); // 回来 -> 自动恢复
        bool done1 = pomo.Tick(6.0f); // 完成第 1 轮专注 -> 短休，XP=50，Streak=1
        bool inShortBreak = done1 && pomo.Phase == PomodoroPhase.ShortBreak && pomo.EarnedXp == 50 && pomo.FocusStreak == 1;

        pomo.Tick(3.0f);              // 短休结束 -> 第 2 轮专注
        bool done2 = pomo.Tick(10.0f); // 第 2 轮专注完成 -> 触发长休，Streak=2 (+10% 加成 -> +55 XP => 105)
        bool longBreakOk = done2 && pomo.Phase == PomodoroPhase.LongBreak && pomo.CompletedWorkCycles == 2 && pomo.EarnedXp == 105;
        Console.WriteLine("companion-pomodoro-afk-streak: " + Convert.ToString((pausedOk && inShortBreak && longBreakOk) ? 1 : 0));

        // 2. 桌面便签与每日习惯跨天连签板
        CompanionHabitAndTodoBoard board = new CompanionHabitAndTodoBoard(100);
        CompanionTodoItem habitWater = board.AddItem("Drink Water", true, true);
        CompanionTodoItem habitWalk = board.AddItem("Evening Walk", true, false);
        CompanionTodoItem taskShip = board.AddItem("Ship Round 11", false, true);

        board.MarkCompleted(habitWater.Id);
        board.MarkCompleted(taskShip.Id);
        // Day 101: habitWater 昨天打了卡，今天继续打卡 -> StreakDays=2；habitWalk 漏打卡 -> StreakDays=0；taskShip 非习惯保持已完成
        board.RolloverToDay(101);
        board.MarkCompleted(habitWater.Id);
        bool boardOk = habitWater.StreakDays == 2 && habitWater.Completed
            && habitWalk.StreakDays == 0 && !habitWalk.Completed
            && taskShip.Completed
            && board.CompletionRatio > 0.65f && board.CompletionRatio < 0.68f;
        Console.WriteLine("companion-habit-todo-board: " + Convert.ToString(boardOk ? 1 : 0));

        // 3. 真实 OS 主机体征快照（复用 System.Management.Memory/Cpu + UserActivityMonitor）+ 情绪评估 + 专注白噪音混音器
        CompanionSystemVitalsAdvisor advisor = new CompanionSystemVitalsAdvisor();
        CompanionVitalsSnapshot live = advisor.SampleLiveVitals(25);
        bool liveOsOk = live.LogicalCores >= 1 && live.TotalMemoryMb >= 256
            && live.MemoryUsagePercent >= 0 && live.MemoryUsagePercent <= 100;
        bool moodRulesOk = advisor.EvaluateMood(20, 40, 1000) == CompanionVitalsMood.Calm
            && advisor.EvaluateMood(75, 40, 1000) == CompanionVitalsMood.Busy
            && advisor.EvaluateMood(92, 40, 1000) == CompanionVitalsMood.Overheated
            && advisor.EvaluateMood(30, 90, 1000) == CompanionVitalsMood.MemoryStressed
            && advisor.EvaluateMood(95, 95, 400000) == CompanionVitalsMood.SleepingAfk;

        CompanionAmbientSoundMixer mixer = new CompanionAmbientSoundMixer();
        mixer.MasterVolume = 0.5f;
        mixer.SetChannel("rain", 0.8f, true);
        mixer.SetChannel("fireplace", 0.6f, false);
        float rainNormal = mixer.ComputeEffectiveGain("rain"); // 0.4
        mixer.DuckMultiplier = 0.25f;
        float rainDucked = mixer.ComputeEffectiveGain("rain"); // 0.1
        float fireOff = mixer.ComputeEffectiveGain("fireplace"); // 0.0
        bool mixerOk = rainNormal > 0.39f && rainNormal < 0.41f
            && rainDucked > 0.09f && rainDucked < 0.11f
            && fireOff == 0.0f;
        Console.WriteLine("companion-system-vitals-live: " + Convert.ToString((liveOsOk && moodRulesOk && mixerOk) ? 1 : 0));
    }
}
