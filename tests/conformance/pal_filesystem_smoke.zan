using System;
using System.IO;
using System.Platform;

class Program {
    static void Main() {
        // 1. Direct Pal.FileSystem probe
        IPlatformFileSystem fs = Pal.FileSystem;
        Console.WriteLine("pal_fs_not_null=" + (fs != null));

        string curDir = fs.GetCurrentDirectory();
        Console.WriteLine("pal_curdir_ok=" + (curDir != null && curDir.Length > 0));

        List<string> drives = fs.GetLogicalDrives();
        Console.WriteLine("pal_drives_ok=" + (drives != null && drives.Count > 0));

        // 2. High-level Directory & File via PAL
        string testDir = "_pal_smoke_dir";
        if (Directory.Exists(testDir)) {
            Directory.DeleteRecursive(testDir);
        }
        Directory.CreateDirectory(testDir);
        Console.WriteLine("dir_exists=" + Directory.Exists(testDir));

        string testFile = testDir + "/sample.txt";
        File.WriteAllText(testFile, "Hello PAL FileSystem!");
        Console.WriteLine("file_exists=" + File.Exists(testFile));

        string content = File.ReadAllText(testFile);
        Console.WriteLine("content_match=" + (content == "Hello PAL FileSystem!"));

        long sz = fs.GetLength(testFile);
        Console.WriteLine("file_length_match=" + (sz == 21));

        // Enumerate entries via PAL
        List<PlatformFileEntry> entries = fs.EnumerateEntries(testDir, false, false);
        Console.WriteLine("entries_count=" + Convert.ToString(entries.Count));
        if (entries.Count > 0) {
            Console.WriteLine("entry_name=" + entries[0].name);
            Console.WriteLine("entry_is_dir=" + entries[0].IsDirectory());
        }

        // Subdirectories & files
        string subDir = testDir + "/sub";
        Directory.CreateDirectory(subDir);
        Console.WriteLine("subdir_exists=" + Directory.Exists(subDir));

        List<string> subDirs = Directory.GetDirectories(testDir);
        Console.WriteLine("subdirs_count=" + Convert.ToString(subDirs.Count));

        List<string> files = Directory.GetFiles(testDir);
        Console.WriteLine("files_count=" + Convert.ToString(files.Count));

        // Timestamp
        bool timeOk = File.SetLastWriteTime(testFile, 1700000000L);
        Console.WriteLine("time_set=" + timeOk);

        // Reparse point check
        bool isReparse = File.IsReparsePoint(testFile);
        Console.WriteLine("is_reparse=" + isReparse);

        // Lock test
        long lockHandle = fs.TryLock(testFile);
        Console.WriteLine("lock_ok=" + (lockHandle != 0 && lockHandle != -1));
        bool unlockOk = fs.Unlock(lockHandle);
        Console.WriteLine("unlock_ok=" + unlockOk);

        // Hard link test
        string hardLink = testDir + "/sample_link.txt";
        bool linkOk = File.CreateHardLink(hardLink, testFile);
        Console.WriteLine("link_created=" + linkOk);
        if (linkOk) {
            Console.WriteLine("link_content=" + (File.ReadAllText(hardLink) == "Hello PAL FileSystem!"));
            File.Delete(hardLink);
        }

        // Clean up
        File.Delete(testFile);
        Console.WriteLine("file_deleted=" + (!File.Exists(testFile)));

        Directory.DeleteRecursive(testDir);
        Console.WriteLine("dir_deleted=" + (!Directory.Exists(testDir)));

        Console.WriteLine("PAL_SMOKE: PASS");
    }
}
