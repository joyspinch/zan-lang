using System;

class SelfhostNullableByteArrayStride {
    static byte?[] EchoBytes(byte?[] values) { return values; }
    static sbyte?[] EchoSigned(sbyte?[] values) { return values; }
    static byte?[,] EchoByteRect(byte?[,] values) { return values; }
    static sbyte?[,] EchoSignedRect(sbyte?[,] values) { return values; }

    static void Main() {
        byte low = 17;
        byte middle = 131;
        byte high = 251;
        sbyte negative = -113;
        sbyte replacement = -7;
        sbyte positive = 97;

        byte?[] bytes = new byte?[3];
        bytes[0] = low;
        bytes[1] = null;
        bytes[2] = high;
        byte?[] byteAlias = EchoBytes(bytes);
        Console.WriteLine(byteAlias[0].Value);
        Console.WriteLine(byteAlias[1].HasValue ? 1 : 0);
        Console.WriteLine(byteAlias[2].Value);
        byteAlias[1] = middle;
        Console.WriteLine(bytes[0].Value);
        Console.WriteLine(bytes[1].Value);
        Console.WriteLine(bytes[2].Value);
        byteAlias[1] = null;
        Console.WriteLine(bytes[0].Value);
        Console.WriteLine(bytes[1].HasValue ? 1 : 0);
        Console.WriteLine(bytes[2].Value);
        bytes = null;
        Console.WriteLine(byteAlias[2].Value);

        sbyte?[] signed = new sbyte?[3];
        signed[0] = negative;
        signed[1] = null;
        signed[2] = positive;
        sbyte?[] signedAlias = EchoSigned(signed);
        Console.WriteLine(signedAlias[0].Value);
        Console.WriteLine(signedAlias[1].HasValue ? 1 : 0);
        Console.WriteLine(signedAlias[2].Value);
        signedAlias[1] = replacement;
        Console.WriteLine(signed[0].Value);
        Console.WriteLine(signed[1].Value);
        Console.WriteLine(signed[2].Value);
        signedAlias[1] = null;
        Console.WriteLine(signed[0].Value);
        Console.WriteLine(signed[1].HasValue ? 1 : 0);
        Console.WriteLine(signed[2].Value);
        signed = null;
        Console.WriteLine(signedAlias[0].Value);

        byte?[,] rect = new byte?[2,3];
        rect[0,2] = low;
        rect[1,0] = null;
        rect[1,1] = high;
        byte?[,] rectAlias = EchoByteRect(rect);
        Console.WriteLine(rectAlias[0,2].Value);
        Console.WriteLine(rectAlias[1,0].HasValue ? 1 : 0);
        Console.WriteLine(rectAlias[1,1].Value);
        rectAlias[1,0] = middle;
        Console.WriteLine(rect[0,2].Value);
        Console.WriteLine(rect[1,0].Value);
        Console.WriteLine(rect[1,1].Value);
        rectAlias[1,0] = null;
        Console.WriteLine(rect[0,2].Value);
        Console.WriteLine(rect[1,0].HasValue ? 1 : 0);
        Console.WriteLine(rect[1,1].Value);
        rect = null;
        Console.WriteLine(rectAlias[1,1].Value);

        sbyte?[,] signedRect = new sbyte?[2,3];
        signedRect[0,2] = negative;
        signedRect[1,0] = null;
        signedRect[1,1] = positive;
        sbyte?[,] signedRectAlias = EchoSignedRect(signedRect);
        Console.WriteLine(signedRectAlias[0,2].Value);
        Console.WriteLine(signedRectAlias[1,0].HasValue ? 1 : 0);
        Console.WriteLine(signedRectAlias[1,1].Value);
        signedRectAlias[1,0] = replacement;
        Console.WriteLine(signedRect[0,2].Value);
        Console.WriteLine(signedRect[1,0].Value);
        Console.WriteLine(signedRect[1,1].Value);
        signedRectAlias[1,0] = null;
        Console.WriteLine(signedRect[0,2].Value);
        Console.WriteLine(signedRect[1,0].HasValue ? 1 : 0);
        Console.WriteLine(signedRect[1,1].Value);
        signedRect = null;
        Console.WriteLine(signedRectAlias[0,2].Value);
    }
}
