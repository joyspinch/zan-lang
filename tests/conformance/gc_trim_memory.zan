using System;

class Payload {
    public int a;
    public int b;
    public string tag;
    public Payload(int a, int b, string tag) {
        this.a = a;
        this.b = b;
        this.tag = tag;
    }
}

class Program {
    static void Main() {
        // 1. 分配一些对象使堆活跃
        for (int i = 0; i < 1000; i++) {
            Payload p = new Payload(i, i * 2, "gc_trim_test");
        }

        // 2. 调用 GC.Collect()，触发 zan_mem_trim
        GC.Collect();
        Console.WriteLine("collect: ok");

        // 3. 调用 GC.TrimMemory() 获取修剪字节数（非负）
        long trimmed = GC.TrimMemory();
        Console.WriteLine("trim non-negative: " + (trimmed >= 0));

        // 4. 修剪后继续分配，验证内存重提交正确且不崩溃
        int count = 0;
        for (int i = 0; i < 500; i++) {
            Payload p2 = new Payload(i, i + 1, "post_trim_alloc");
            if (p2.a == i) { count++; }
        }
        Console.WriteLine("post trim alloc: " + (count == 500));
    }
}
