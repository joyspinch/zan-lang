using System;

class LocalStringException : Exception {
    public string Code;

    public LocalStringException(string code) {
        this.Code = code;
        Message = code;
    }
}

class Program {
    static void ThrowLiteral() {
        string owned = "owned literal";
        throw new LocalStringException("literal");
    }

    static void ThrowComputed() {
        string owned = "computed value".Substring(0, 8);
        throw new LocalStringException("computed");
    }

    static void Main() {
        try {
            ThrowLiteral();
        } catch (LocalStringException e) {
            Console.WriteLine("caught=" + e.Code);
        }

        try {
            ThrowComputed();
        } catch (LocalStringException e) {
            Console.WriteLine("caught=" + e.Code);
        }
    }
}
