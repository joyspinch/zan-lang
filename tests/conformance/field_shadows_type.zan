using System;

/// A field named like a type shadows that type as a call receiver, the same
/// way a local does: `Collapse.Add(x)` in a class holding a `Collapse` field
/// is the field's method, not a static of the class named Collapse. Without
/// the shadow the receiver silently became the type and the call was emitted
/// against the wrong signature (LLVM: "Incorrect number of arguments").
class Collapse {
    static string Add(string s) { return "type:" + s; }
}

class Emitter {
    List<string> Collapse;

    Emitter() { Collapse = new List<string>(); }

    void Fire() {
        Collapse.Add("x");
        Collapse.Add("y");
    }

    int Count() { return Collapse.Count; }
}

class Program {
    static void Main() {
        Emitter e = new Emitter();
        e.Fire();
        Console.WriteLine(Convert.ToString(e.Count()));
        Console.WriteLine(Collapse.Add("z"));
    }
}
