using System;

// 核心契约与语义定义。
class Collapse {
    static string Add(string s) { return "type:" + s; }
}

class Emitter {
    List<string> Collapse;

    Emitter() { Collapse = new List<string>(); }

    void Fire() {
        Collapse.Add("x");
        Collapse.Add("y");
    }

    int Count() { return Collapse.Count; }
}

class Program {
    static void Main() {
        Emitter e = new Emitter();
        e.Fire();
        Console.WriteLine(Convert.ToString(e.Count()));
        Console.WriteLine(Collapse.Add("z"));
    }
}
