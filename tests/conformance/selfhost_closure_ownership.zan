using System;

public delegate int OwnershipRead();
class OwnershipPayload {
    public int value;
    public OwnershipPayload(int n) { value = n; }
    public int Read() { return value; }
}
class OwnershipHolder {
    public OwnershipRead read;
}
class SelfhostClosureOwnership {
    static OwnershipRead Capture(OwnershipPayload payload) {
        return () => payload.Read();
    }
    static OwnershipRead Bind(OwnershipPayload payload) {
        return payload.Read;
    }
    static void CheckCapture() {
        OwnershipPayload payload = new OwnershipPayload(41);
        WeakReference<OwnershipPayload> observer = new WeakReference<OwnershipPayload>(payload);
        OwnershipRead read = Capture(payload);
        payload = null;
        Console.WriteLine(observer.IsAlive);
        Console.WriteLine(read());
        OwnershipRead alias = read;
        read = null;
        Console.WriteLine(alias());
        alias = null;
        Console.WriteLine(observer.IsAlive);
    }
    static void CheckMethodGroup() {
        OwnershipPayload payload = new OwnershipPayload(42);
        WeakReference<OwnershipPayload> observer = new WeakReference<OwnershipPayload>(payload);
        OwnershipHolder holder = new OwnershipHolder();
        holder.read = Bind(payload);
        payload = null;
        Console.WriteLine(observer.IsAlive);
        Console.WriteLine(holder.read());
        holder.read = null;
        Console.WriteLine(observer.IsAlive);
    }
    static void Main() {
        CheckCapture();
        CheckMethodGroup();
    }
}
