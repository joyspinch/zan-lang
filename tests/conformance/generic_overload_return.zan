using System;

class OverloadItem { }

class OverloadQuery<T> {
    public List<T> Find(int key, T item) {
        List<T> result = new List<T>();
        result.Add(item);
        return result;
    }

    public List<T> Find(string key, T item) {
        List<T> result = new List<T>();
        result.Add(item);
        result.Add(item);
        return result;
    }
}

class Program {
    static void Main() {
        OverloadQuery<OverloadItem> query = new OverloadQuery<OverloadItem>();
        OverloadItem item = new OverloadItem();
        List<OverloadItem> number = query.Find(1, item);
        List<OverloadItem> text = query.Find("key", item);
        Console.WriteLine(number.Count);
        Console.WriteLine(text.Count);
    }
}
