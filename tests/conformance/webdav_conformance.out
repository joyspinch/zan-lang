PROPFIND path=/dav/ body=1 Depth=1
propfind=1:/dav/item.txt:200
MKCOL path=/dav/new/ body=1
mkcol=201
GET path=/dav/item.txt body=1
get=200:get-body
PUT path=/dav/item.txt body=put-body
put=204
DELETE path=/dav/item.txt body=1
delete=204
COPY path=/dav/source.txt body=1 Destination=/dav/copy.txt Overwrite=F
copy=201
MOVE path=/dav/copy.txt body=1 Destination=http://127.0.0.1:54392/dav/moved.txt Overwrite=T
move=201
