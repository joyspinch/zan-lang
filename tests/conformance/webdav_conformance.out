PROPFIND path=/dav/ body=true Depth=1
propfind=1:/dav/item.txt:200
MKCOL path=/dav/new/ body=true
mkcol=201
GET path=/dav/item.txt body=true
get=200:get-body
PUT path=/dav/item.txt body=put-body
put=204
DELETE path=/dav/item.txt body=true
delete=204
COPY path=/dav/source.txt body=true Destination=/dav/copy.txt Overwrite=F
copy=201
MOVE path=/dav/copy.txt body=true Destination=http://127.0.0.1:9516/dav/moved.txt Overwrite=T
move=201
