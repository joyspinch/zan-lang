using System;

class Numbers {
    int n;
    Numbers(int n) { this.n = n; }
    static Numbers Of(int n) { return new Numbers(n); }
    public NumEnumerator GetEnumerator() { return new NumEnumerator(n); }
}

class NumEnumerator {
    int i;
    int n;
    public NumEnumerator(int n) { this.n = n; this.i = 0; }
    public bool MoveNext() { i = i + 1; return i <= n; }
    public int Current() { return i * i; }
}

class FinallyForeach {
    static async int Run() {
        int[] xs = new int[1];
        xs[0] = 1;
        int sum = 0;
        for (int i = 0; i < 2; i = i + 1) {
            try {
                if (i == 0) { continue; }
                if (i == 1) { break; }
            } finally {
                foreach (int x in xs) {
                    await Task.Yield();
                    sum = sum + x;
                }
            }
        }
        foreach (int y in Numbers.Of(2)) {
            await Task.Yield();
            sum = sum + y;
        }
        return sum;
    }

    static async void Main() {
        for (int pass = 0; pass < 3; pass = pass + 1) {
            if (await Run() != 7) { throw new Exception("shared finally foreach"); }
        }
        Console.WriteLine("finally foreach ok");
    }
}
