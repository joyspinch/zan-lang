using System;
using System.Collections.Generic;
using System.Windows;

namespace Conf;

class DesktopCompanionSnapReminderBadgesTest {
    static void Main() {
        // 1. 多显示器边缘磁吸布局：主屏右下磁吸、副屏识别与越界防丢失钳制
        CompanionScreenSnapLayout layout = new CompanionScreenSnapLayout(24);
        layout.AddMonitor(new ScreenWorkArea(0, 0, 0, 1920, 1040));
        layout.AddMonitor(new ScreenWorkArea(1, 1920, 0, 1920, 1040));

        // 靠近主屏右下角 (1920-200=1720, 1040-200=840)，在 24px 阈值内自动磁吸贴边
        SnapPointResult r1 = layout.ResolvePosition(1705, 825, 200, 200);
        // 拖入副屏靠近左边界 (1920 + 10) -> 识别为副屏 1 并左边缘磁吸至 1920
        SnapPointResult r2 = layout.ResolvePosition(1930, 300, 200, 200);
        // 拖到屏幕外左侧 (-500, -100) -> 钳制回主屏 (0, 0)
        SnapPointResult r3 = layout.ResolvePosition(-500, -100, 200, 200);

        bool snapOk = r1.MonitorIndex == 0 && r1.X == 1720 && r1.Y == 840
            && r1.HorizontalEdge == SnapEdgeKind.Right && r1.VerticalEdge == SnapEdgeKind.Bottom
            && r2.MonitorIndex == 1 && r2.X == 1920 && r2.HorizontalEdge == SnapEdgeKind.Left
            && r3.MonitorIndex == 0 && r3.X == 0 && r3.Y == 0;
        Console.WriteLine("companion-screen-snap-layout: " + Convert.ToString(snapOk ? 1 : 0));

        // 2. 定时与周期提醒引擎：一次性触发关闭、周期自动推进、Snooze 延后重触发
        CompanionAlarmReminderEngine engine = new CompanionAlarmReminderEngine();
        engine.AddReminder("water", "Drink water", 1000L, 500L);
        engine.AddReminder("meeting", "Daily standup", 1200L, 0L);

        List<CompanionReminderItem> due1 = engine.PollDue(1000L); // water 触发，下次 1500
        List<CompanionReminderItem> due2 = engine.PollDue(1200L); // meeting 一次性触发后停用
        List<CompanionReminderItem> due3 = engine.PollDue(1300L); // 无到期
        bool snoozeOk = engine.Snooze("meeting", 1300L, 400L);    // 延后到 1700
        List<CompanionReminderItem> due4 = engine.PollDue(1700L); // water(1500->2000) + meeting(1700)

        bool remOk = due1.Count == 1 && due1[0].ReminderId == "water"
            && due2.Count == 1 && due2[0].ReminderId == "meeting"
            && due3.Count == 0 && snoozeOk
            && due4.Count == 2;
        Console.WriteLine("companion-alarm-reminder-engine: " + Convert.ToString(remOk ? 1 : 0));

        // 3. 互动成就徽章看板：累计达标首次解锁、防重复解锁、一次性领奖与完成度统计
        CompanionBadgeAchievementBoard board = new CompanionBadgeAchievementBoard();
        board.RegisterBadge("pet_10", 10, 100);
        board.RegisterBadge("focus_5", 5, 250);

        bool p1 = !board.RecordProgress("pet_10", 6);
        int earlyClaim = board.ClaimReward("pet_10");     // 未解锁 -> 0
        bool firstUnlock = board.RecordProgress("pet_10", 4); // 达到 10 -> 首次解锁 true
        bool repeatUnlock = !board.RecordProgress("pet_10", 5); // 已解锁再加 -> false
        int claim1 = board.ClaimReward("pet_10");         // 100
        int claim2 = board.ClaimReward("pet_10");         // 重复领奖 -> 0
        int pctHalf = board.CompletionPercent();          // 1/2 = 50%

        bool badgeOk = p1 && earlyClaim == 0 && firstUnlock && repeatUnlock
            && claim1 == 100 && claim2 == 0 && pctHalf == 50;
        Console.WriteLine("companion-badge-achievement-board: " + Convert.ToString(badgeOk ? 1 : 0));
    }
}
