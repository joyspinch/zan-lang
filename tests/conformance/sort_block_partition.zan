using System;
using System.Collections.Generic;

// Array.Sort(int[]) / List<int>.Sort / List<double>.Sort 走分块无分支划分的内省排序。
// 对照参考插入排序，覆盖：随机、少值重复（走"等于归左"分支）、全等、
// 有序、逆序、管风琴形，长度 0..~700（跨过 24 的插入阈值和 128 的分块收尾），
// 外加一个 20 万元素的大数组（多层分块 + 深递归）。
class Program {
    static long seed = 12345;

    static int Next(int range) {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        return (int)(seed % range);
    }

    static int Gen(int pattern, int i, int n, int range) {
        if (pattern == 0) { return Next(range) - range / 2; }
        if (pattern == 1) { return Next(4); }
        if (pattern == 2) { return 7; }
        if (pattern == 3) { return i; }
        if (pattern == 4) { return n - i; }
        if (i < n / 2) { return i; }
        return n - i;
    }

    static void RefSort(int[] a) {
        for (int k = 1; k < a.Length; k = k + 1) {
            int v = a[k];
            int m = k - 1;
            while (m >= 0 && v < a[m]) { a[m + 1] = a[m]; m = m - 1; }
            a[m + 1] = v;
        }
    }

    public static void Main() {
        int fails = 0;
        int cases = 0;
        for (int pattern = 0; pattern < 6; pattern = pattern + 1) {
            for (int n = 0; n < 700; n = n + 37) {
                int[] a = new int[n];
                int[] r = new int[n];
                List<int> li = new List<int>();
                List<double> ld = new List<double>();
                for (int i = 0; i < n; i = i + 1) {
                    int v = Gen(pattern, i, n, 1000000);
                    a[i] = v; r[i] = v; li.Add(v); ld.Add((double)v * 0.5);
                }
                Array.Sort(a);
                li.Sort();
                ld.Sort();
                RefSort(r);
                for (int i = 0; i < n; i = i + 1) {
                    if (a[i] != r[i] || li[i] != r[i] || ld[i] != (double)r[i] * 0.5) {
                        fails = fails + 1;
                        Console.WriteLine("mismatch pattern=" + pattern.ToString() + " n=" + n.ToString() + " i=" + i.ToString());
                        break;
                    }
                }
                cases = cases + 1;
            }
        }

        int big = 200000;
        int[] b = new int[big];
        long sum = 0;
        for (int i = 0; i < big; i = i + 1) { b[i] = Next(2000000000) - 1000000000; sum = sum + b[i]; }
        Array.Sort(b);
        long sum2 = 0;
        bool ordered = true;
        for (int i = 0; i < big; i = i + 1) {
            sum2 = sum2 + b[i];
            if (i > 0 && b[i - 1] > b[i]) { ordered = false; }
        }

        // 子区间排序（List.QuickSortInt 拷贝范围、排完写回，区间外不动）
        List<int> part = new List<int>();
        for (int i = 0; i < 50; i = i + 1) { part.Add(50 - i); }
        ListExtensions.QuickSortInt(part, 10, 39);
        Console.WriteLine("range: " + part[9].ToString() + " " + part[10].ToString() + " " + part[39].ToString() + " " + part[40].ToString());

        Console.WriteLine("cases=" + cases.ToString() + " fails=" + fails.ToString());
        Console.WriteLine("big ordered=" + ordered.ToString() + " sum_kept=" + (sum == sum2).ToString());
    }
}
