using System;

// arr[i].M() through an array held in a field of `this`: a leaf callee needs
// no pin (generic containers keep their arrays in fields), while a callee
// that can replace the field array or its slot must still keep the receiver
// alive until it returns. Run with the leak check.
interface IScore { int Score(); }
class Item : IScore {
    public int v;
    public Item(int x) { v = x; }
    public int Score() { return v * 3 + 1; }
}
class Box<T> where T : IScore {
    public T[] items;
    public Box(T[] a) { items = a; }
    public long Total() { long s = 0; for (int i = 0; i < items.Length; i++) s += items[i].Score(); return s; }
    public long TotalThis() { long s = 0; for (int i = 0; i < this.items.Length; i++) s += this.items[i].Score(); return s; }
}
class Node {
    public Holder owner;
    public int v;
    public int Replace() { owner.nodes = new Node[1]; owner.nodes[0] = new Node(); return v + 1; }
}
class Holder {
    public Node[] nodes;
    public int Run() { return nodes[0].Replace(); }
}
class Program {
    static void Main() {
        Item[] a = new Item[10];
        for (int i = 0; i < 10; i++) a[i] = new Item(i);
        Box<Item> b = new Box<Item>(a);
        Console.WriteLine(b.Total());
        Console.WriteLine(b.TotalThis());
        Holder h = new Holder();
        h.nodes = new Node[1];
        h.nodes[0] = new Node();
        h.nodes[0].owner = h;
        h.nodes[0].v = 41;
        Console.WriteLine(h.Run());
        h.nodes = null;
    }
}
