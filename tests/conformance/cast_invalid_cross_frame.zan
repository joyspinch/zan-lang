// B-ID186 Wave 5: reference downcasts and generic `(T)x` casts outside a local
// `try` block must throw InvalidCastException unconditionally so callers can
// catch them across call frames (matching C host construct_cast.c / B-ID163③).
using System;

class Animal {
    public string Kind;
    public Animal(string k) { Kind = k; }
}

class Dog : Animal {
    public Dog() : base("Dog") {}
}

class Cat : Animal {
    public Cat() : base("Cat") {}
}

class Caster<T> {
    // Deliberately no try/catch inside this helper: invalid cast must unwind to caller.
    public T Cast(object x) => (T)x;
}

class Program {
    static Dog DirectCast(object x) => (Dog)x;
    static string StringCast(object x) => (string)x;

    static void Main() {
        object dog = new Dog();
        object cat = new Cat();
        var dogCaster = new Caster<Dog>();

        // 1. Valid casts succeed across frame boundary
        Console.WriteLine("ok.direct=" + DirectCast(dog).Kind);
        Console.WriteLine("ok.generic=" + dogCaster.Cast(dog).Kind);
        Console.WriteLine("ok.null=" + (DirectCast(null) == null).ToString().ToLower());
        Console.WriteLine("ok.gennull=" + (dogCaster.Cast(null) == null).ToString().ToLower());

        // 2. Invalid direct class downcast in callee unwinds InvalidCastException to caller
        try {
            Dog d = DirectCast(cat);
            Console.WriteLine("direct.no_throw=" + (d == null).ToString());
        } catch (InvalidCastException) {
            Console.WriteLine("direct.caught=InvalidCastException");
        }

        // 3. Invalid generic `(T)x` downcast in callee unwinds InvalidCastException to caller
        try {
            Dog d = dogCaster.Cast(cat);
            Console.WriteLine("generic.no_throw=" + (d == null).ToString());
        } catch (InvalidCastException) {
            Console.WriteLine("generic.caught=InvalidCastException");
        }

        // 4. Invalid string downcast in callee unwinds InvalidCastException to caller
        try {
            string s = StringCast(dog);
            Console.WriteLine("string.no_throw=" + (s == null).ToString());
        } catch (InvalidCastException) {
            Console.WriteLine("string.caught=InvalidCastException");
        }
    }
}
