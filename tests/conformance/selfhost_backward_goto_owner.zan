using System;
class GotoValue { public int value; }
class Program {
    static WeakReference<GotoValue> watch;
    static void Loop() {
        int count = 0;
        again:
        if (count > 0) {
            if (watch.IsAlive) { throw new Exception("backward goto leaked"); }
            Console.WriteLine("backward-owner-released");
        }
        GotoValue value = new GotoValue();
        watch = new WeakReference<GotoValue>(value);
        count = count + 1;
        if (count < 2) { goto again; }
    }
    static void Main() {
        Loop();
        if (watch.IsAlive) { throw new Exception("normal exit leaked"); }
        Console.WriteLine("backward-normal-released");
        try { throw new Exception("control"); } catch { Console.WriteLine("backward-owner-retired"); }
    }
}
