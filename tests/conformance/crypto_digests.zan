using System;
using System.Security.Cryptography;

/* Known-answer vectors for the digest and encoding primitives, so the byte
 * buffer they run on can be changed without changing what they compute. */
class Program {
    static void Main() {
        string abc = "abc";
        Console.WriteLine(Hex.Encode(Sha256.Hash(abc, 3), 32));
        Console.WriteLine(Hex.Encode(Sha1.Hash(abc, 3), 20));
        Console.WriteLine(Hex.Encode(Md5.Hash(abc, 3), 16));
        Console.WriteLine(Hex.Encode(Sha512.Hash(abc, 3), 64));

        string key = "key";
        string msg = "The quick brown fox jumps over the lazy dog";
        Console.WriteLine(Hex.Encode(Hmac.Sha256Mac(key, 3, msg, msg.Length), 32));

        Console.WriteLine(Base64.Encode("hello world", 11));
        Console.WriteLine(Hex.Encode("hello", 5));

        string round = Hex.Decode("48656c6c6f");
        Console.WriteLine(round);
    }
}
