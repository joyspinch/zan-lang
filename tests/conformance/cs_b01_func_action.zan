// cs_b01_func_action.zan -- C#-compat: Func<...>/Action<...> generic delegate
// families and anonymous methods (`delegate (int x) { ... }`).
using System;

class Program {
    static void Main() {
        Func<int, int> f = x => x * 2;
        Console.WriteLine(f(21));
        Action<string> a = s => Console.WriteLine(s);
        a("hi");
        Action done = () => Console.WriteLine("done");
        done();
        Action<int, int> sum = (x, y) => Console.WriteLine(x + y);
        sum(2, 3);
        Func<int> seven = () => 7;
        Console.WriteLine(seven());
        Func<int, int, int> add = delegate (int a, int b) { return a + b; };
        Console.WriteLine(add(4, 5));
        Func<int, int> sq = delegate (int x) { return x * x; };
        Console.WriteLine(sq(6));
    }
}
