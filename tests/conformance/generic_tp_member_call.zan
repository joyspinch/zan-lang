using System;

/* A generic method or generic class that reaches into its own type parameter
 * (`c.Name()`, `this.item.Name()`) is monomorphized: the erased body has
 * nothing to resolve the member against. */

interface IConn {
    string Name();
    int Weight(int k);
}

class Conn : IConn {
    public string id;
    Conn(string i) { this.id = i; }
    public string Name() { return "conn-" + this.id; }
    public int Weight(int k) { return k * 2; }
}

class Other : IConn {
    public string tag;
    Other(string t) { this.tag = t; }
    public string Name() { return "other-" + this.tag; }
    public int Weight(int k) { return k + 100; }
}

class Pool<T> where T : IConn {
    public T item;
    Pool(T c) { this.item = c; }
    public string Describe() { return this.item.Name(); }
    public int Score(int k) { return this.item.Weight(k); }
}

class Program {
    static string CallIt<T>(T c) where T : IConn {
        return c.Name();
    }

    static int Sum<T>(T c, int k) where T : IConn {
        int total = 0;
        for (int i = 0; i < 3; i++) {
            total = total + c.Weight(k + i);
        }
        return total;
    }

    static string FieldOf<T>(T c) where T : Conn {
        return c.id;
    }

    static void Main() {
        Conn c = new Conn("a");
        Other o = new Other("b");

        Console.WriteLine(CallIt<Conn>(c));
        Console.WriteLine(CallIt(o));
        Console.WriteLine(Convert.ToString(Sum<Conn>(c, 1)));
        Console.WriteLine(Convert.ToString(Sum(o, 1)));
        Console.WriteLine(FieldOf(c));

        Pool<Conn> pc = new Pool<Conn>(c);
        Pool<Other> po = new Pool<Other>(o);
        Console.WriteLine(pc.Describe());
        Console.WriteLine(po.Describe());
        Console.WriteLine(Convert.ToString(pc.Score(4)));
        Console.WriteLine(Convert.ToString(po.Score(4)));
    }
}
