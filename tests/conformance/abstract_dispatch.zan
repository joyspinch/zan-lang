using System;
using System.Collections.Generic;

namespace ConformanceTests;

// 抽象方法（abstract）的动态分发。
//
// abstract 方法是虚表槽位的一员：基类没有实现体，但派生类的 override
// 要落进同一个槽位，调用点按静态类型走虚表分发。历史上 abstract 方法
// 既不进虚表、也没有函数体，调用会落到 "could not be resolved to any
// callable" 的兜底错误——这组用例把整条链路钉死。
public abstract class Shape {
    public string name;

    public Shape() { this.name = "shape"; }

    // 抽象方法：没有实现体。
    public abstract double Area();

    // 虚方法：与抽象方法共存，虚表槽位顺序不能互相挤掉。
    public virtual string Describe() {
        return this.name + "/" + Convert.ToString(this.Area());
    }
}

// 中间抽象类：覆盖了虚方法，但没实现抽象方法（允许）。
public abstract class Round : Shape {
    public double r;

    public Round(double r) { this.r = r; this.name = "round"; }

    public override string Describe() {
        return "round(" + Convert.ToString(this.r) + ")";
    }
}

// 具体类：实现抽象方法。
public class Square : Round {
    public Square(double side) : base(side) { this.name = "square"; }
    public override double Area() { return this.r * this.r; }
}

// 抽象方法带参数与返回值。
public abstract class Op {
    public abstract int Apply(int a, int b);
}

public class AddOp : Op {
    public override int Apply(int a, int b) { return a + b; }
}

public class MulOp : Op {
    public override int Apply(int a, int b) { return a * b; }
}

public class Program {
    static int failures = 0;

    static void Check(bool ok, string name) {
        if (!ok) {
            failures = failures + 1;
            Console.WriteLine("FAIL: " + name);
        }
    }

    static void Main() {
        // 1. 通过抽象基类引用调用抽象方法：应分派到具体实现。
        Shape s = new Square(3.0);
        Check(s.Area() == 9.0, "abstract dispatch through base reference");

        // 2. 抽象基类的虚方法：中间类的 override 生效。
        Check(s.Describe() == "round(3)", "virtual override in middle class");

        // 3. 抽象方法与虚方法各自独立分派，不互相干扰。
        Square sq = new Square(4.0);
        Check(sq.Area() == 16.0, "direct call on concrete type");
        Check(sq.Describe() == "round(4)", "direct virtual call on concrete type");

        // 4. 异构集合里按静态类型（抽象基类）遍历。
        List<Shape> shapes = new List<Shape>();
        shapes.Add(new Square(2.0));
        shapes.Add(new Square(5.0));
        double total = 0.0;
        for (int i = 0; i < shapes.Count; i = i + 1) {
            Shape item = shapes[i];
            total = total + item.Area();
        }
        Check(total == 29.0, "abstract dispatch inside collection loop");

        // 5. 抽象方法带参数：不同实现走不同分支。
        List<Op> ops = new List<Op>();
        ops.Add(new AddOp());
        ops.Add(new MulOp());
        Check(ops[0].Apply(3, 4) == 7, "abstract method with arguments (add)");
        Check(ops[1].Apply(3, 4) == 12, "abstract method with arguments (mul)");

        // 6. 抽象方法返回值参与表达式：不能被降级成默认值。
        int combined = ops[0].Apply(1, 2) + ops[1].Apply(3, 4);
        Check(combined == 15, "abstract method result used in expression");

        if (failures == 0) {
            Console.WriteLine("ALL ABSTRACT DISPATCH TESTS PASSED");
        }
    }
}
