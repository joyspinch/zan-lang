using System;

struct Vec3 {
    int x;
    int y;
    int z;
}

class Program {
    static async Task<Vec3> MakeVecFastAsync(int x, int y, int z) {
        Vec3 v;
        v.x = x;
        v.y = y;
        v.z = z;
        return v;
    }

    static async Task<Vec3> MakeVecSlowAsync(int x, int y, int z) {
        await Task.Delay(1);
        Vec3 v;
        v.x = x * 2;
        v.y = y * 2;
        v.z = z * 2;
        return v;
    }

    static async Task<Vec3> ChainVecAsync(int x, int y, int z) {
        Vec3 v1 = await MakeVecFastAsync(x, y, z);
        Vec3 v2 = await MakeVecSlowAsync(v1.x, v1.y, v1.z);
        return v2;
    }

    static async void Main() {
        Vec3 fast = await MakeVecFastAsync(1, 2, 3);
        Console.WriteLine("fast=" + fast.x + "," + fast.y + "," + fast.z);

        Vec3 slow = await MakeVecSlowAsync(4, 5, 6);
        Console.WriteLine("slow=" + slow.x + "," + slow.y + "," + slow.z);

        Vec3 chained = await ChainVecAsync(10, 20, 30);
        Console.WriteLine("chained=" + chained.x + "," + chained.y + "," + chained.z);
    }
}
