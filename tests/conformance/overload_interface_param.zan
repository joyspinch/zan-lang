// 重载决议：**接口形参**必须按实参的接口类型区分，不能"第一个同名方法赢"。
//
// 踩过的坑：irgen 打分时对接口形参一律给 0 分（理由是"打分看不出实现列表"），
// 于是**只靠接口类型区分**的一组重载全部同分，第一个永远赢：
// `TransactionScope.Create(fsql)`（fsql 是 IZanSql）被发到
// `Create(IUnitOfWork)` 上——字段里装的是错类型，等后面调用保存点方法时才炸，
// 错误消息完全指不到病根（看着像"事务已结束"，其实是重载选错了）。
//
// 覆盖：
// - 实参是接口：选**同一个**接口的那个重载（不是第一个）；
// - 实参是派生接口：选实参自己的接口（精确匹配优先于"基接口可赋值"）；
// - 实参是实现类：选它**实现**的那个接口重载（不是第一个）；
// - 接口重载与类重载并存：实参是类时选类重载，实参是接口时选接口重载；
// - 派生链上的接口：实参 IGamma 同时满足 IAlpha，IGamma 那个仍然更贴。
using System;

interface IAlpha { void Mark(); }
interface IBeta { void Mark(); }
interface IGamma : IAlpha { void Mark(); }

class ImplAlpha : IAlpha {
    public void Mark() { }
}

class ImplBeta : IBeta {
    public void Mark() { }
}

class ImplGamma : IGamma {
    public void Mark() { }
}

class Target {
    // 三个接口重载：声明顺序是 IAlpha 在前，但实参是 IBeta/IGamma 时
    // 不该落到它身上。
    void Pick(IAlpha a) { Console.WriteLine("pick:alpha"); }
    void Pick(IBeta b) { Console.WriteLine("pick:beta"); }
    void Pick(IGamma g) { Console.WriteLine("pick:gamma"); }

    // 接口重载与类重载并存。
    void Both(IAlpha a) { Console.WriteLine("both:alpha"); }
    void Both(ImplAlpha c) { Console.WriteLine("both:class"); }

    void Run(IAlpha a, IBeta b, IGamma g, ImplAlpha c) {
        Pick(a);
        Pick(b);
        Pick(g);
        Both(a);
        Both(c);
    }
}

class Program {
    static void Main() {
        Target t = new Target();
        IAlpha a = new ImplAlpha();
        IBeta b = new ImplBeta();
        IGamma g = new ImplGamma();
        ImplAlpha c = new ImplAlpha();
        t.Run(a, b, g, c);
    }
}
