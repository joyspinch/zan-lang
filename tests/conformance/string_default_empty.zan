using System;

/* A declared-but-unassigned string local is empty, not null: reading one used
 * to dereference null and take the whole process down (that is how a missing
 * initializer crashed a GUI app instead of printing a message).
 * Fields keep null as their unset value -- the ORM binds an unset string
 * column as SQL NULL -- so only locals are covered here. */
class Program {
    static void Main() {
        string plain;
        Console.WriteLine(Convert.ToString(plain == "") + " "
            + Convert.ToString(plain.Length));

        for (int i = 0; i < 2; i = i + 1) {
            string inLoop;
            if (i == 1) { inLoop = "second"; }
            Console.WriteLine(Convert.ToString(i) + "[" + inLoop + "]");
        }

        string joined;
        joined = joined + "tail";
        Console.WriteLine(joined + " " + Convert.ToString(joined.Length));
    }
}
