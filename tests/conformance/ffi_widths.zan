using System;
using System.IO;
using System.Threading;

// 核心契约与语义定义。
class Program {
    static string Repeat(string unit, int times) {
        string s = "";
        for (int i = 0; i < times; i = i + 1) { s = s + unit; }
        return s;
    }

    static void Main() {
        Console.WriteLine("=== pointer handles ===");
        // 核心契约与语义定义。
        nint p = NativeMemory.Alloc(4096);
        Console.WriteLine(p != 0);
        Span<byte> bytes = new Span<byte>(p, 4096);
        bytes[0] = 1;
        bytes[4095] = 255;
        Span<int> words = new Span<int>(p + 2048, 2);
        words[0] = 2147483647;
        words[1] = -2147483648;
        Console.WriteLine(bytes[0]);
        Console.WriteLine(bytes[4095]);
        Console.WriteLine(words[0]);
        Console.WriteLine(words[1]);
        Console.WriteLine(bytes[2048]);
        NativeMemory.Free(p);

        Console.WriteLine("=== size_t lanes ===");
        // 核心契约与语义定义。
        string unit = "0123456789abcdef";
        string payload = Repeat(unit, 4096);
        Console.WriteLine(payload.Length);
        string path = "zan_ffi_widths.bin";
        File.WriteAllText(path, payload);
        string back = File.ReadAllText(path);
        Console.WriteLine(back.Length);
        Console.WriteLine(back == payload);
        Console.WriteLine(File.GetSize(path));
        File.Delete(path);
        Console.WriteLine(File.Exists(path));

        Console.WriteLine("=== 64-bit clock ===");
        // 核心契约与语义定义。
        long us0 = Stopwatch.GetMicroseconds();
        long ms0 = Stopwatch.GetMilliseconds();
        int spin = 0;
        for (int i = 0; i < 200000; i = i + 1) { spin = spin + i; }
        long us1 = Stopwatch.GetMicroseconds();
        if (us0 > 0 && us1 >= us0 && ms0 > 0) {
            Console.WriteLine("clock ok");
        } else {
            Console.WriteLine("clock bad");
        }
    }
}
