// `Factory() { Field = v, Prop = v, Coll = { ... } }`: every initializer
// item acts on the ONE object the factory returned. The C host used to
// rebuild each plain member write as `Factory().Field = v` -- the factory
// ran again per member and the writes landed on discarded objects.
using System;
using System.Collections.Generic;

class Box {
    public static int made;
    public int a;
    public string s;
    List<int> items = new List<int>();
    public List<int> Items { get { return items; } }
    public int P { get; set; }
    public static Box Make() { made = made + 1; Box b = new Box(); b.a = 1; return b; }
}

class Program {
    static void Main() {
        Box x = Box.Make() { a = 5, s = "q", P = 9, Items = { 3, 4 } };
        Console.WriteLine(x.a);
        Console.WriteLine(x.s);
        Console.WriteLine(x.P);
        Console.WriteLine(x.Items.Count);
        Console.WriteLine("made=" + Convert.ToString(Box.made));
        Box y = Box.Make() { Items = { 7 } };
        Console.WriteLine(y.a + y.Items[0]);
        Console.WriteLine("made=" + Convert.ToString(Box.made));
    }
}
