using System;
using System.Platform;

class Program {
    static void Main() {
        // 1. Direct Pal.Library probe
        IPlatformLibraryLoader pl = Pal.Library;
        Console.WriteLine("pal_lib_not_null=" + (pl != null));

        // 2. MapLibraryName
        string mapped = Interop.MapLibraryName("testlib");
        bool mapOk = mapped != null && (mapped == "testlib.dll" || mapped == "libtestlib.so" || mapped == "libtestlib.dylib");
        Console.WriteLine("map_lib_name_ok=" + mapOk);

        // 3. Load known system library & resolve symbol
        string sysLibName = OperatingSystem.IsWindows() ? "kernel32.dll" : Interop.MapLibraryName("c");
        string symName = OperatingSystem.IsWindows() ? "GetCurrentProcessId" : "getpid";

        nint mod = Interop.Load(sysLibName);
        Console.WriteLine("load_sys_lib_ok=" + (mod != 0));

        nint sym = Interop.Symbol(mod, symName);
        Console.WriteLine("get_symbol_ok=" + (sym != 0));

        // 4. Test error handling on non-existent library
        nint nonExistent = Interop.Load("non_existent_library_987654.xyz");
        Console.WriteLine("load_nonexistent_zero=" + (nonExistent == 0));
        string err = Interop.LastError();
        Console.WriteLine("last_error_not_empty=" + (err != null && err.Length > 0));

        // 5. Test SafeLibraryHandle with using scope
        SafeLibraryHandle libRef = null;
        using (SafeLibraryHandle lib = Interop.LoadLibrarySafe(sysLibName)) {
            libRef = lib;
            Console.WriteLine("safe_handle_valid=" + (!lib.IsInvalid() && !lib.IsClosed));
            nint safeSym = Interop.Symbol(lib.DangerousGetHandle(), symName);
            Console.WriteLine("safe_symbol_ok=" + (safeSym != 0));
        }

        Console.WriteLine("safe_handle_auto_closed=" + (libRef != null && libRef.IsClosed && libRef.DangerousGetHandle() == 0));
        libRef.Dispose();
        Console.WriteLine("safe_handle_idempotent=" + (libRef.IsClosed && libRef.DangerousGetHandle() == 0));

        // 6. Native system error code roundtrip
        Marshal.SetLastSystemError(12345);
        int errGot = Marshal.GetLastSystemError();
        int win32Got = Marshal.GetLastWin32Error();
        Console.WriteLine("system_error_roundtrip=" + (errGot == 12345 && win32Got == 12345));

        Marshal.SetLastSystemError(0);
        Console.WriteLine("system_error_reset=" + (Marshal.GetLastSystemError() == 0));

        Console.WriteLine("PAL_LIBRARY_SMOKE: PASS");
    }
}
