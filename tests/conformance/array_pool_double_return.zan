using System;
using System.Buffers;

class Program {
    static int bad = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            bad = bad + 1;
            Console.WriteLine("FAIL " + name);
        }
    }

    static void Main() {
        // 1. ArrayPool.Shared 静态单例稳定性
        ArrayPool p1 = ArrayPool.Shared;
        ArrayPool p2 = ArrayPool.Shared;
        Check(p1 != null && p2 != null, "shared non null");
        Check(p1 == p2, "shared identity");

        // 2. 正常租还复用
        using (ArrayPool pool = ArrayPool.Create()) {
            byte[] a = pool.Rent(64);
            Check(a.Length >= 64, "rent 64");
            pool.Return(a, false);
            byte[] b = pool.Rent(64);
            Check(a == b, "single return reused");
            pool.Return(b, false);

            // 3. 重复归还拦截：将同一数组归还两次
            pool.Return(b, false);
            // 此时桶中应只有 1 个 b，绝不重复入池
            byte[] r1 = pool.Rent(64);
            byte[] r2 = pool.Rent(64);
            Check(r1 == b, "r1 got pooled buffer");
            Check(r2 != b, "r2 got fresh buffer not duplicate");
            Check(r1 != r2, "r1 and r2 are distinct instances");

            pool.Return(r1, false);
            pool.Return(r2, false);
        }

        if (bad > 0) {
            Console.WriteLine("FAIL: " + Convert.ToString(bad));
        } else {
            Console.WriteLine("all pass");
        }
    }
}
