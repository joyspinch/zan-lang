using System;
using System.Collections.Generic;
struct P { public int X; public long Y; }
class Z9 {
    static P Mk() { return new P { X = 61, Y = 62 }; }
    static int Take(P p) { return p.X; }
    static int Main() {
        // `new P{...}` / `new P()` 产出指针形结构体右值；元素槽写入必须
        // 取值进槽，不得把指针 8 字节裸写进槽（Span 与一维数组同族）。
        nint m = NativeMemory.Alloc(64);
        NativeMemory.Fill(m, 0, 64);
        Span<P> s = new Span<P>(m, 2);
        s[0] = new P { X = 42, Y = 7 };
        s[1] = new P();
        P a = s[0]; P b = s[1];
        Console.WriteLine("span0=" + a.X + "," + a.Y);
        Console.WriteLine("span1=" + b.X + "," + b.Y);
        NativeMemory.Free(m);
        P[] arr = new P[2];
        arr[0] = new P { X = 31, Y = 32 };
        arr[1] = new P();
        Console.WriteLine("arr0=" + arr[0].X + "," + arr[0].Y);
        Console.WriteLine("arr1=" + arr[1].X + "," + arr[1].Y);
        // 相邻形状是控制组：函数返回与调用实参本来就是按值形状，
        // List.Add 走合成访问器；三者在修复前后都正确，锁住不回退。
        P[] arr2 = new P[2];
        arr2[0] = Mk();
        Console.WriteLine("ret=" + arr2[0].X + "," + arr2[0].Y);
        Console.WriteLine("arg=" + Take(new P { X = 71, Y = 72 }));
        List<P> ls = new List<P>();
        ls.Add(new P { X = 81, Y = 82 });
        Console.WriteLine("list=" + ls[0].X + "," + ls[0].Y);
        return 0;
    }
}
