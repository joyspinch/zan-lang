using System;
using System.Collections.Generic;

public delegate int ArrayProducerRead();
class ArrayProducerPayload {
    public int value;
    public ArrayProducerPayload(int n) { value = n; }
    public int Read() { return value; }
}

class SelfhostArrayProducerOwner {
    // Natural static initializer: the backend may fold this to immortal storage.
    static int[] Shared = new int[] { 3, 5, 7 };
    static int[] StaticAlias() { return Shared; }
    static byte[] Bytes() { return "abc".ToBytes(); }
    static ArrayProducerRead Bind(ArrayProducerPayload payload) { return payload.Read; }

    static void CheckClassCopy() {
        ArrayProducerPayload payload = new ArrayProducerPayload(71);
        WeakReference<ArrayProducerPayload> watch = new WeakReference<ArrayProducerPayload>(payload);
        List<ArrayProducerPayload> source = new List<ArrayProducerPayload>();
        source.Add(payload);
        payload = null;
        ArrayProducerPayload[] first = source.ToArray();
        ArrayProducerPayload[] second = source.ToArray();
        source.Clear();
        source = null;
        Console.WriteLine("class-copy=" + (watch.IsAlive && first[0].value == 71 && second[0].value == 71));
        first[0] = first[0];
        first = null;
        Console.WriteLine("class-independent=" + (watch.IsAlive && second[0].value == 71));
        second = null;
        Console.WriteLine("class-copy-dtor=" + !watch.IsAlive);
    }

    static void CheckDelegateCopy() {
        ArrayProducerPayload payload = new ArrayProducerPayload(81);
        WeakReference<ArrayProducerPayload> watch = new WeakReference<ArrayProducerPayload>(payload);
        List<ArrayProducerRead> source = new List<ArrayProducerRead>();
        source.Add(Bind(payload));
        payload = null;
        ArrayProducerRead[] first = source.ToArray();
        ArrayProducerRead[] second = source.ToArray();
        source.Clear();
        source = null;
        Console.WriteLine("delegate-copy=" + (watch.IsAlive && first[0]() == 81 && second[0]() == 81));
        first[0] = first[0];
        first = null;
        Console.WriteLine("delegate-independent=" + (watch.IsAlive && second[0]() == 81));
        second = null;
        Console.WriteLine("delegate-copy-dtor=" + !watch.IsAlive);
    }

    static void CheckBoundaries() {
        ArrayProducerPayload[] absent = null;
        ArrayProducerPayload[,] absentRect = null;
        ArrayProducerPayload[] empty = new ArrayProducerPayload[0];
        ArrayProducerPayload[,] emptyRect = new ArrayProducerPayload[0,2];
        ArrayProducerRead[] emptyDelegates = new ArrayProducerRead[0];
        List<ArrayProducerPayload> source = new List<ArrayProducerPayload>();
        ArrayProducerPayload[] copiedEmpty = source.ToArray();
        Console.WriteLine("empty=" + (empty.Length == 0 && emptyRect.Length == 0 && emptyDelegates.Length == 0 && copiedEmpty.Length == 0));
        absent = null;
        absentRect = null;
        empty = null;
        emptyRect = null;
        emptyDelegates = null;
        copiedEmpty = null;
        Console.WriteLine("null=" + (absent == null && absentRect == null));

        byte[] bytes = Bytes();
        byte[] alias = bytes;
        bytes = null;
        Console.WriteLine("byte-bridge=" + (alias.Length == 3 && alias.ToStr() == "abc"));
        alias = null;
        byte[] noBytes = "".ToBytes();
        Console.WriteLine("byte-empty=" + (noBytes.Length == 0));
        noBytes = null;
        List<byte> byteSource = new List<byte>();
        byteSource.Add((byte)65);
        byteSource.Add((byte)66);
        byte[] byteCopy = byteSource.ToArray();
        byteSource.Clear();
        byteSource = null;
        Console.WriteLine("byte-copy=" + (byteCopy.Length == 2 && byteCopy.ToStr() == "AB"));
        byteCopy = null;

        int[] first = StaticAlias();
        int[] second = first;
        first = null;
        second[1] = 9;
        second = null;
        int[] again = StaticAlias();
        Console.WriteLine("immortal=" + (again.Length == 3 && again[0] == 3 && Shared[1] == 9));
        again = null;
        Console.WriteLine("immortal-root=" + (Shared[2] == 7));
    }

    static void Main() {
        CheckClassCopy();
        CheckDelegateCopy();
        CheckBoundaries();
    }
}
