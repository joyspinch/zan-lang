// List 赋值是引用共享：两个变量别名同一份存储，增删改双向可见；
// 重新赋值只重绑变量自己的引用。与 C# List<T> 语义一致（Zan 没有
// copy-on-write 集合，也不需要——本用例钉死这条契约）。
using System;
using System.Collections.Generic;

class Box { public int V; }

class Program {
    static void Main() {
        List<int> a = new List<int>();
        a.Add(1);
        List<int> b = a;
        b.Add(2);
        Console.WriteLine(a.Count);
        Console.WriteLine(b.Count);
        b.RemoveAt(0);
        Console.WriteLine(a.Count);

        Box x = new Box();
        x.V = 7;
        List<Box> la = new List<Box>();
        la.Add(x);
        List<Box> lb = la;
        lb[0].V = 99;
        Console.WriteLine(la[0].V);

        string s = "hi";
        List<string> ls = new List<string>();
        ls.Add(s);
        List<string> ls2 = ls;
        ls2[0] = "changed";
        Console.WriteLine(ls[0]);

        List<int> c = a;
        c = new List<int>();
        Console.WriteLine(a.Count);
        Console.WriteLine(c.Count);
    }
}
