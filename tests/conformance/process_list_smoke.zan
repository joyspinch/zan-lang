// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。
using System;
using System.Diagnostics;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        List<ProcessEntry> all = ProcessList.List();
        if (all.Count < 1) { bad = bad + 1; }
        bool sawSelf = false;
        int selfPid = ProcessList.SelfPid();
        for (int i = 0; i < all.Count; i = i + 1) {
            ProcessEntry e = all[i];
            if (e.pid < 0 || e.name == "") { bad = bad + 1; }
            if (e.pid == selfPid) { sawSelf = true; }
        }
        if (!sawSelf) { bad = bad + 1; }
        // 核心契约与语义定义。
        ProcessEntry self = ProcessList.ByPid(selfPid);
        if (self == null) { bad = bad + 1; }
        else {
            if (self.exePath == "") { bad = bad + 1; }
            if (self.memoryBytes <= 0) { bad = bad + 1; }
        }
        Console.WriteLine("proc-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
