// TextTable test: columns align to the widest cell; border lines match the
// header/row widths; short rows are padded.
using System;
using System.Text;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        List<string> headers = new List<string>();
        headers.Add("Name");
        headers.Add("Count");
        TextTable t = new TextTable(headers);
        List<string> r1 = new List<string>();
        r1.Add("a");
        r1.Add("1");
        t.AddRow(r1);
        List<string> r2 = new List<string>();
        r2.Add("longer");
        r2.Add("42");
        t.AddRow(r2);
        string rendered = t.Render();
        List<string> lines = rendered.Split("\n");
        // Header row: "| Name   | Count |"
        if (lines[0] != "+--------+-------+") { bad = bad + 1; }
        if (lines[1] != "| Name   | Count |") { bad = bad + 1; }
        if (lines[2] != "+--------+-------+") { bad = bad + 1; }
        if (lines[3] != "| a      | 1     |") { bad = bad + 1; }
        if (lines[4] != "| longer | 42    |") { bad = bad + 1; }
        if (lines[5] != "+--------+-------+") { bad = bad + 1; }
        Console.WriteLine("table-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}


