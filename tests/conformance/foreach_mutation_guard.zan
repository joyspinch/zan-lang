// A521 收口用例：foreach 枚举形状 + 枚举中变更的 fail-fast 守卫。
// C# .NET 8 地面真值：List/数组按索引序枚举；Dictionary 的 foreach 变量是
// 键 K（Zan 形状一致，取值需再 d[k]）；枚举中 Add/Remove 抛
// InvalidOperationException。
// Zan 行为：软运行时在变更点打 stderr 诊断
// （file:line: runtime error: Collection was modified; enumeration
// operation may not execute）并终止该次枚举，不崩不死循环：
//   list 枚举中 Add：守卫=1（首轮即断），xs 由 3 增到 4，acc 只收 10；
//   dict 枚举中 Remove：守卫=1，d 由 3 减到 2，acc 只收 k1。
// --strict-runtime 下同一错误 fail-fast exit=70（tests/runtime 语义）。
// 金档只锁 stdout；诊断走 stderr，不进金档。
using System;

class Program {
    public static void Main() {
        List<int> xs = new List<int>();
        xs.Add(10);
        xs.Add(20);
        xs.Add(30);
        string acc = "";
        foreach (int x in xs) {
            acc = acc + Convert.ToString(x) + ";";
        }
        Console.WriteLine("list-foreach=" + acc);

        int[] arr = new int[] { 7, 8, 9 };
        string acc2 = "";
        foreach (int e in arr) {
            acc2 = acc2 + Convert.ToString(e) + ";";
        }
        Console.WriteLine("array-foreach=" + acc2);

        Dictionary<string,int> d = new Dictionary<string,int>();
        d["k1"] = 1;
        d["k2"] = 2;
        d["k3"] = 3;
        string acc3 = "";
        foreach (string k in d) {
            acc3 = acc3 + k + ":" + Convert.ToString(d[k]) + ";";
        }
        Console.WriteLine("dict-foreach(keys)=" + acc3);

        // 枚举 List 中 Add（C# InvalidOperationException）
        int guard = 0;
        string acc4 = "";
        foreach (int x in xs) {
            guard = guard + 1;
            if (guard > 100) { break; }
            acc4 = acc4 + Convert.ToString(x) + ";";
            xs.Add(x);
        }
        Console.WriteLine("list-mutate count=" + Convert.ToString(xs.Count) + " guard=" + Convert.ToString(guard) + " acc=" + acc4);

        // 枚举 Dict 中 Remove（C# InvalidOperationException）
        int guard2 = 0;
        string acc5 = "";
        foreach (string k in d) {
            guard2 = guard2 + 1;
            if (guard2 > 100) { break; }
            acc5 = acc5 + k + ";";
            d.Remove(k);
        }
        Console.WriteLine("dict-mutate count=" + Convert.ToString(d.Count) + " guard=" + Convert.ToString(guard2) + " acc=" + acc5);
    }
}
