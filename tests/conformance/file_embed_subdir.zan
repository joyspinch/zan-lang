// 皮肤包过滤器的作用域回归：skin_filter（dark/light + skinlist）只为
// skins 规格而生，曾被评为所有 --embed 规格共用——一个只有子目录、
// 根上无散文件的显式 embed 规格会被整目录清空，编译报假错
// "matched no readable file"。程序引用 Skin_ 前缀让皮肤自动内嵌
// （skin_filter 就位），再显式内嵌一个只有 pack/ 子目录的资源树：
// 旧代码直接编译失败，新代码 pack/note.txt 必须可读。
//
// 内嵌根用 embedfx 而不是 assets：Directory 的目录枚举按设计把
// 磁盘目录与内嵌资源合并（磁盘优先、内嵌补差），而用例的运行目录
// 是仓库根——根上真实存在 assets/（品牌素材），用 assets 会让
// GetDirectories 数的既是内嵌的 pack 又是磁盘的 brand，断言必然翻红。
// 换成仓库里不会出现的根名，用例只量自己的内嵌树。
using System;
using System.IO;
using Gui;

class Program {
    static void P(bool v) {
        if (v) { Console.WriteLine(1); } else { Console.WriteLine(0); }
    }

    static void Main() {
        P(Skin.ExeDir() != "");
        P(File.GetSize("embedfx/pack/note.txt") == 6);
        byte[] b = File.ReadAllBytes("embedfx/pack/note.txt");
        P(b[0] == 's' && b[1] == 'u' && b[5] == 'k');
        P(File.ReadAllText("embedfx/pack/note.txt") == "sub-ok");
        P(Directory.Exists("embedfx") && Directory.Exists("embedfx/pack"));
        P(Directory.GetDirectories("embedfx").Count == 1
            && Directory.GetFiles("embedfx/pack").Count == 1);
        bool repeated = true;
        for (int i = 0; i < 32; i = i + 1) {
            if (Directory.GetFiles("embedfx/missing").Count != 0
                || Directory.GetFiles("embedfx/pack").Count != 1) {
                repeated = false;
            }
        }
        P(repeated);
    }
}
