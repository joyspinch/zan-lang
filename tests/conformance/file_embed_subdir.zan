// 皮肤包过滤器的作用域回归：skin_filter（dark/light + skinlist）只为
// skins 规格而生，曾被评为所有 --embed 规格共用——一个只有子目录、
// 根上无散文件的显式 embed 规格会被整目录清空，编译报假错
// "matched no readable file"。程序引用 Skin_ 前缀让皮肤自动内嵌
// （skin_filter 就位），再显式内嵌一个只有 pack/ 子目录的资源树：
// 旧代码直接编译失败，新代码 pack/note.txt 必须可读。
using System;
using System.IO;
using Gui;

class Program {
    static void P(bool v) {
        if (v) { Console.WriteLine(1); } else { Console.WriteLine(0); }
    }

    static void Main() {
        P(Skin.ExeDir() != "");
        P(File.GetSize("assets/pack/note.txt") == 6);
        byte[] b = File.ReadAllBytes("assets/pack/note.txt");
        P(b[0] == 's' && b[1] == 'u' && b[5] == 'k');
        P(File.ReadAllText("assets/pack/note.txt") == "sub-ok");
    }
}
