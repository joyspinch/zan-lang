using System;
using System.Collections.Generic;

delegate int ReadInt();

class StaticSink {
    public static int InitNarrow = 5 * -9223372036854775807;
    public static int AssignedNarrow;
    public static int? NullableStatic;
    static StaticSink() {
        AssignedNarrow = 5 * -9223372036854775807;
        NullableStatic = -9223372036854775807;
    }
}

class Program {
    static void Main() {
        // 1. Static field initializer and static cctor assignment narrowing
        Console.WriteLine("static_init=" + StaticSink.InitNarrow);
        Console.WriteLine("static_assign=" + StaticSink.AssignedNarrow);
        Console.WriteLine("static_nullable=" + StaticSink.NullableStatic.Value);

        // 2. Local nullable boxing narrowing (BoxVal)
        int? a = -9223372036854775807;
        Console.WriteLine("local_nullable=" + a.Value);
        Console.WriteLine("local_nullable_coalesce=" + (a ?? 0));

        // 3. Expression-bodied lambda returning int
        var readers = new List<ReadInt>();
        for (int j = 0; j < 3; j = j + 1) {
            readers.Add(() => j * -2147483648);
        }
        foreach (ReadInt r in readers) {
            Console.WriteLine("lambda_int=" + r());
        }
        ReadInt bigLam = () => 5 * -9223372036854775807;
        Console.WriteLine("lambda_big=" + bigLam());

        // 4. Container indexer stores (ToSlot)
        var nums = new List<int>();
        nums.Add(0);
        nums[0] = 5 * -9223372036854775807;
        Console.WriteLine("list_set=" + nums[0]);

        var map = new Dictionary<string, int>();
        map["k"] = 5 * -9223372036854775807;
        Console.WriteLine("dict_set=" + map["k"]);
    }
}
