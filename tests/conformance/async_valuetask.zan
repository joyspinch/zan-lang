// ValueTask 的拼写：宿主在解析期把 async ValueTask<T> 改写成 T 形状，
// 所以 "ValueTask" 这个名字从来不需要进 binder（自举的解析器做同样的
// 改写：ValueTask -> Task，并且给没有方法体的 Task 返回类型补 async 标记）。
//
// 反例（ValueTask 但没有 async 且有方法体）由两侧编译器用同一句诊断
// 拒绝：tests/selfhost/reject/valuetask_not_async.zan。
using System;

class Program {
    static async ValueTask<int> Square(int n) {
        await Task.Delay(1);
        return n * n;
    }

    static void Main() {
        int q = await Square(7);
        Console.WriteLine("q=" + q);
    }
}
