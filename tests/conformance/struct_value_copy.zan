using System;
using System.Collections.Generic;

// A struct is a value: every place the C host copies it, the self-hosted
// backend has to copy it too. The self-host keeps a struct instance as a
// heap object, so the copy is made explicit at each boundary (assignment,
// argument, container element) and a nested struct field points at a nested
// instance that has to be allocated.

struct Inner { public int v; }

struct Vec {
    public int x;
    public int y;
    // a struct method mutates the receiver in place -- the caller sees it
    public void Bump() { x = 100; y = 200; }
}

class Box { public int c; }

struct Outer {
    public int a;
    public Inner in2;
    public string s;
    public Box box;
}

class Program {
    static void Bump(Vec v) { v.x = 7; }

    static Vec Make() { Vec t; t.x = 7; t.y = 8; return t; }

    static void Main() {
        // 1) assignment copies
        Vec q; q.x = 3; q.y = 4;
        Vec r = q;
        r.x = 42;
        Console.WriteLine("assign=" + q.x + "," + r.x);

        // 2) an argument is copied
        Vec p; p.x = 1; p.y = 2;
        Bump(p);
        Console.WriteLine("param=" + p.x);

        // 3) a container element is copied
        Vec s; s.x = 1; s.y = 2;
        List<Vec> list = new List<Vec>();
        list.Add(s);
        s.x = 99;
        Console.WriteLine("list=" + list[0].x + "," + list[0].y);

        // 4) an array element is copied
        Vec[] arr = new Vec[2];
        arr[0] = s;
        s.x = 77;
        Console.WriteLine("array=" + arr[0].x);

        // 5) a nested struct is copied deeply
        Outer o; o.a = 1; o.in2.v = 5;
        Outer o2 = o;
        o2.in2.v = 9;
        Console.WriteLine("nested=" + o.in2.v + "," + o2.in2.v);

        // 6) a class field is shared between the copies
        Box b = new Box(); b.c = 7;
        Outer o3; o3.box = b;
        Outer o4 = o3;
        o4.box.c = 42;
        Console.WriteLine("classfield=" + o3.box.c + "," + b.c);

        // 7) a struct method writes through the receiver
        Vec m; m.x = 1; m.y = 2;
        m.Bump();
        Console.WriteLine("method=" + m.x + "," + m.y);

        // 8) a returned struct reaches the caller as a value
        Vec t = Make();
        Console.WriteLine("ret=" + t.x + "," + t.y);
    }
}
