// 单 worker 下，同步 Delay 必须在外层协程栈上推进同伴任务，
// 并保留外层协程退出同步等待后 Yield 的排队顺序。
using System;

class Program {
    static bool ranDuringDelay = false;
    static bool delayEnded = false;
    static bool peerFinished = false;

    static void SyncDelay(int ms) {
        await Task.Delay(ms);
    }

    static async int Peer() {
        // 每次 Yield 把自己放到普通就绪队列的尾部，直到同步等待结束。
        while (!delayEnded) {
            ranDuringDelay = true;
            await Task.Yield();
        }
        peerFinished = true;
        return 1;
    }

    static async int Yielder() {
        Task.Spawn(Peer());
        SyncDelay(100);
        bool nestedProgress = ranDuringDelay;
        delayEnded = true;
        await Task.Yield();
        return nestedProgress && peerFinished ? 1 : 0;
    }

    static void Main() {
        int yielded = await Yielder();
        Console.WriteLine("yieldLetOthersRun=" + Convert.ToString(yielded));
    }
}
