using System;

namespace QualifiedShadow.Widget;

public class LayerState {
    public int Value;
    public int Render(LayerState state) { return state.Value + 100; }
    public string Get() { return "local"; }
}

public class Layer {
    public static int Value = 17;
    public static int Get() { return 17; }
    public static int Render(LayerState state) { return state.Value + 10; }
}

public class T { public static int Get() { return 31; } }
public class Other { public static int Get() { return 99; } }
public class Base<T> {
    public int Read() { return QualifiedShadow.Widget.T.Get(); }
}
public class Derived : Base<Other> { }

public class QualifiedShadowReview {
    public weak LayerState Layer;

    public int Field(LayerState state) {
        // Collapsing the qualified path must not turn it into this.Layer.
        return QualifiedShadow.Widget.Layer.Render(state);
    }

    public int Local(LayerState state) {
        LayerState Layer = state;
        return QualifiedShadow.Widget.Layer.Render(state) + Layer.Render(state);
    }

    public int Parameter(LayerState Layer) {
        return QualifiedShadow.Widget.Layer.Render(Layer) + Layer.Render(Layer);
    }

    public int Values(LayerState state) {
        return Layer.Render(state) + this.Layer.Render(state);
    }
}

public class App {
    static App frameApp;
    public int Value = 5;
}
public class Control {
    public App App { get { return new App(); } }
}
public class Form : Control {
    public int ReadStatic() {
        App prior = App.frameApp;
        App next = new App();
        next.Value = 43;
        App.frameApp = next;
        int result = App.frameApp.Value;
        App.frameApp = prior;
        return result + this.App.Value;
    }
}

public class QualifiedShadowProgram {
    public static int Pick(Func<int> getter) { return getter(); }
    public static int Pick(Func<string> getter) { return 99; }

    public static void Main() {
        LayerState state = new LayerState();
        state.Value = 7;
        QualifiedShadowReview review = new QualifiedShadowReview();
        review.Layer = state;
        Console.WriteLine(review.Field(state));
        Console.WriteLine(review.Local(state));
        Console.WriteLine(review.Parameter(state));
        Console.WriteLine(review.Values(state));
        LayerState Layer = state;
        Console.WriteLine(QualifiedShadow.Widget.Layer.Value);
        QualifiedShadow.Widget.Layer.Value = 29;
        Console.WriteLine(QualifiedShadow.Widget.Layer.Value++);
        Console.WriteLine(--QualifiedShadow.Widget.Layer.Value);
        Console.WriteLine(Layer.Value);
        Console.WriteLine(Pick(QualifiedShadow.Widget.Layer.Get));
        Console.WriteLine(Pick(Layer.Get));
        Derived derived = new Derived();
        Console.WriteLine(derived.Read());
        Form form = new Form();
        Console.WriteLine(form.ReadStatic());
    }
}
