using System;

// Narrow and unsigned primitives are stored at their declared width (sbyte/byte
// i8, short/ushort i16, int/uint i32, long/ulong i64) and read back with the
// signedness of the declared type. Covers Span<T> strides over raw memory,
// static fields, value-struct fields carried through a by-value return, array
// and List elements, and explicit casts.
struct Pixel {
    uint argb;
    byte alpha;

    static Pixel Of(uint v, byte a) {
        Pixel p = new Pixel();
        p.argb = v;
        p.alpha = a;
        return p;
    }

    uint Argb() { return this.argb; }
}

class Program {
    static sbyte MinSbyte = -128;
    static byte MaxByte = 255;
    static ushort MaxUshort = 65535;
    static uint MaxUint = 4294967295;

    static void Main() {
        // Span<T> indexes by the declared element width, not by 8-byte slots.
        nint p = NativeMemory.Alloc(32);
        Span<ushort> h = new Span<ushort>(p, 4);
        h[0] = 258;                       // 0x0102
        h[1] = 65535;
        Span<byte> b = new Span<byte>(p, 16);
        Console.WriteLine(b[0]);
        Console.WriteLine(b[1]);
        Console.WriteLine(b[2]);
        Console.WriteLine(b[3]);
        Console.WriteLine(h[0]);
        Console.WriteLine(h[1]);

        Span<uint> w = new Span<uint>(p + 8, 2);
        w[0] = 4278190080;                // 0xFF000000
        w[1] = 1;
        Console.WriteLine(w[0]);
        Console.WriteLine(b[12]);         // low byte of w[1]
        NativeMemory.Free(p);

        Console.WriteLine(Program.MinSbyte);
        Console.WriteLine(Program.MaxByte);
        Console.WriteLine(Program.MaxUshort);
        Console.WriteLine(Program.MaxUint);

        Pixel px = Pixel.Of(4280296496, 255);
        Console.WriteLine(px.argb);
        Console.WriteLine(px.alpha);
        Console.WriteLine(px.Argb());

        uint[] arr = new uint[2];
        arr[0] = 4294967295;
        arr[1] = 1;
        Console.WriteLine(arr[0]);
        Console.WriteLine(arr[1]);

        List<uint> list = new List<uint>();
        list.Add(4278190080);
        Console.WriteLine(list[0]);

        long big = 4886718345;            // 0x1_23456789
        Console.WriteLine((uint)big);
        Console.WriteLine((ushort)big);
        Console.WriteLine((byte)big);
        Console.WriteLine((sbyte)200);
        Console.WriteLine((short)70000);
    }
}
