using System;

/* Storing through an array that came from anywhere other than a plain local
 * or a field used to be dropped on the floor: no store, no diagnostic. */
class Buf {
    byte[] data;
    int len;

    Buf(int n) { data = new byte[n]; len = n; }

    byte[] Data() { return data; }

    void Xor(byte[] other) {
        for (int i = 0; i < len; i = i + 1) { data[i] = (byte)(data[i] ^ other[i]); }
    }
}

class Program {
    static byte[] Fresh() { return new byte[2]; }

    static void Main() {
        Buf a = new Buf(4);
        Buf b = new Buf(4);
        int i = 0;
        for (; i < 4; i = i + 1) {
            a.Data()[i] = (byte)(200 + i);
            b.Data()[i] = 255;
        }
        Console.WriteLine((int)a.Data()[0] + "," + (int)b.Data()[3]);

        a.Xor(b.Data());
        Console.WriteLine((int)a.Data()[0] + "," + (int)a.Data()[3]);

        byte[] h = new byte[8];
        i = 0;
        while (i < 4) {
            h[2 * i] = (byte)i;
            h[2 * i + 1] = (byte)(255 - i);
            i = i + 1;
        }
        Console.WriteLine((int)h[0] + "," + (int)h[1] + "," + (int)h[6] + "," + (int)h[7]);

        string[] names = new string[2];
        names[0] = "x" + "y";
        names[1] = "zz";
        Console.WriteLine(names[0] + names[1] + names.Length);

        Console.WriteLine(Program.Fresh().Length);
    }
}
