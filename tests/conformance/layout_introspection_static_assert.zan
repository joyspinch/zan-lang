using System;
using System.Runtime.InteropServices;

struct NaturalLayout {
    public byte A;
    public int B;
    public byte C;
    public long D;
}

[StructLayout(LayoutKind.Sequential, Pack = 1)]
struct Packed1 {
    public byte Tag;
    public int Len;
    public long Seq;
}

[StructLayout(LayoutKind.Sequential, Pack = 2)]
struct Packed2 {
    public byte A;
    public int B;
    public byte C;
    public short D;
}

[StructLayout(LayoutKind.Sequential, Pack = 4)]
struct Packed4 {
    public byte A;
    public long B;
}

[StructLayout(LayoutKind.Explicit)]
struct ExplicitUnion {
    [FieldOffset(0)] public int AsInt;
    [FieldOffset(0)] public float AsFloat;
    [FieldOffset(4)] public short Tag;
}

class Program {
    static void CheckConstGeneric<const int N>() {
        static_assert(N == 16, "const generic N must be 16");
        static_assert(N >= sizeof(Packed1), "buffer too small for Packed1");
    }

    static void Main() {
        // Compile-time assertions over sizeof / alignof / offsetof
        static_assert(sizeof(byte) == 1 && alignof(byte) == 1);
        static_assert(sizeof(short) == 2 && alignof(short) == 2);
        static_assert(sizeof(int) == 4 && alignof(int) == 4);
        static_assert(sizeof(long) == 8 && alignof(long) == 8);
        static_assert(sizeof(double) == 8 && alignof(double) == 8);

        static_assert(sizeof(NaturalLayout) == 24 && alignof(NaturalLayout) == 8, "natural layout");
        static_assert(offsetof(NaturalLayout, A) == 0);
        static_assert(offsetof(NaturalLayout, B) == 4);
        static_assert(offsetof(NaturalLayout, C) == 8);
        static_assert(offsetof(NaturalLayout, D) == 16);

        static_assert(sizeof(Packed1) == 13 && alignof(Packed1) == 1, "pack1");
        static_assert(offsetof(Packed1, Tag) == 0);
        static_assert(offsetof(Packed1, Len) == 1);
        static_assert(offsetof(Packed1, Seq) == 5);

        static_assert(sizeof(Packed2) == 10 && alignof(Packed2) == 2, "pack2");
        static_assert(offsetof(Packed2, A) == 0);
        static_assert(offsetof(Packed2, B) == 2);
        static_assert(offsetof(Packed2, C) == 6);
        static_assert(offsetof(Packed2, D) == 8);

        static_assert(sizeof(Packed4) == 12 && alignof(Packed4) == 4, "pack4");
        static_assert(offsetof(Packed4, A) == 0);
        static_assert(offsetof(Packed4, B) == 4);

        static_assert(sizeof(ExplicitUnion) == 8 && alignof(ExplicitUnion) == 4, "explicit");
        static_assert(offsetof(ExplicitUnion, AsInt) == 0);
        static_assert(offsetof(ExplicitUnion, AsFloat) == 0);
        static_assert(offsetof(ExplicitUnion, Tag) == 4);

        CheckConstGeneric<16>();

        // Verify comptime() also evaluates layout queries
        int ctSum = comptime(sizeof(Packed1) + alignof(NaturalLayout) + offsetof(NaturalLayout, D));

        // Contextual identifier compatibility (variables named alignof/offsetof still work!)
        int alignof = 7;
        int offsetof = 9;

        Console.WriteLine($"nat={sizeof(NaturalLayout)},{alignof(NaturalLayout)},{offsetof(NaturalLayout, B)},{offsetof(NaturalLayout, D)}");
        Console.WriteLine($"p1={sizeof(Packed1)},{alignof(Packed1)},{offsetof(Packed1, Len)},{offsetof(Packed1, Seq)}");
        Console.WriteLine($"p2={sizeof(Packed2)},{alignof(Packed2)},{offsetof(Packed2, B)},{offsetof(Packed2, D)}");
        Console.WriteLine($"p4={sizeof(Packed4)},{alignof(Packed4)},{offsetof(Packed4, B)}");
        Console.WriteLine($"exp={sizeof(ExplicitUnion)},{alignof(ExplicitUnion)},{offsetof(ExplicitUnion, AsFloat)},{offsetof(ExplicitUnion, Tag)}");
        Console.WriteLine($"ct={ctSum},ctx={alignof + offsetof}");
    }
}
