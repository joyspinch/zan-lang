using System;
using System.Collections.Generic;

class RangeToken {
    public int Value;
}

class RangeSourceLifetime {
    static void Check(bool condition) {
        if (!condition) { throw new Exception("AddRange source lifetime"); }
    }

    static List<int> Snapshot() {
        List<int> result = new List<int>();
        result.Add(7);
        return result;
    }

    static List<RangeToken> Tokens() {
        List<RangeToken> result = new List<RangeToken>();
        RangeToken token = new RangeToken();
        token.Value = 23;
        result.Add(token);
        return result;
    }

    static List<int> Empty() { return new List<int>(); }
    static List<int> Absent() { return null; }
    static List<int> Throwing() {
        List<int> result = Snapshot();
        throw new Exception("source failed");
    }

    static void Inline() {
        List<int> combined = Snapshot();
        combined.AddRange(Snapshot());
        combined.AddRange(Snapshot());
        combined.AddRange(Empty());
        combined.AddRange(Absent());
        Check(combined.Count == 3 && combined[2] == 7);
        try { combined.AddRange(Throwing()); }
        catch (Exception ex) { Check(ex.Message == "source failed"); }
        Check(combined.Count == 3);
    }

    static void References() {
        List<RangeToken> combined = new List<RangeToken>();
        combined.AddRange(Tokens());
        Check(combined.Count == 1 && combined[0].Value == 23);
        List<RangeToken> borrowed = Tokens();
        combined.AddRange(borrowed);
        Check(borrowed.Count == 1 && borrowed[0].Value == 23);
        combined.AddRange(combined);
        Check(combined.Count == 4 && combined[3].Value == 23);
    }

    static void Main() {
        Inline();
        References();
        Console.WriteLine("LIST_ADDRANGE_SOURCE_LIFETIME_OK");
    }
}
