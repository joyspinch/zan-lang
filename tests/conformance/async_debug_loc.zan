class Program {
    static async int ComputeStep(int baseVal) {
        int a = baseVal + 5;
        await Task.Yield();
        int b = a * 2;
        await Task.Delay(1);
        int c = b + 3;
        return c;
    }

    static async Task<int> RunAll() {
        int step1 = await ComputeStep(10);
        await Task.Yield();
        int step2 = await ComputeStep(step1);
        return step2;
    }

    static void Main() {
        int res = await RunAll();
        Console.WriteLine(res);
    }
}
