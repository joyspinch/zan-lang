using System;
using System.Collections.Generic;
using System.Net;
using System.Net.Coap;
using System.Net.Dns;
using System.Net.Http;
using System.Net.Http.Client;
using System.Net.Https;
using System.Net.Mail;
using System.Net.Modbus;
using System.Net.Mqtt;
using System.Net.Ntp;
using System.Net.Sip;
using System.Net.Sockets;
using System.Net.Sse;
using System.Net.WebDav;
using System.Net.WebSocket.Secure;

class Program {
    static void Main() {
        Console.WriteLine("=== NET PROTOCOLS & CONNECTORS HARDENING TEST ===");

        // 1. IPAddress & Ping
        Console.WriteLine("-- 1. IP & Ping --");
        Console.WriteLine("Loopback: " + IPAddress.Loopback);
        Console.WriteLine("Is IPv4 loopback: " + Convert.ToString(IPAddress.IsIPv4(IPAddress.Loopback)));
        Console.WriteLine("Is IPv4 bad dots: " + Convert.ToString(IPAddress.IsIPv4("...1")));
        Console.WriteLine("Is IPv4 out of range: " + Convert.ToString(IPAddress.IsIPv4("1.2.3.999")));
        Console.WriteLine("Is IPv4 octal zero: " + Convert.ToString(IPAddress.IsIPv4("01.1.1.1")));
        Console.WriteLine("Is IPv6 loopback: " + Convert.ToString(IPAddress.IsIPv6(IPAddress.IPv6Loopback)));
        Console.WriteLine("Is IPv6 any: " + Convert.ToString(IPAddress.IsIPv6(IPAddress.IPv6Any)));
        Console.WriteLine("Is IPv6 bad triple colon: " + Convert.ToString(IPAddress.IsIPv6(":::1")));
        Console.WriteLine("IsLoopback IPv4: " + Convert.ToString(IPAddress.IsLoopback("127.0.0.1")));
        Console.WriteLine("IsLoopback IPv6: " + Convert.ToString(IPAddress.IsLoopback("::1")));
        Console.WriteLine("IsLoopback Public: " + Convert.ToString(IPAddress.IsLoopback("8.8.8.8")));
        Ping ping = new Ping();
        PingReply reply = new PingReply();
        reply.status = PingStatus.Success;
        reply.roundtripTime = 10;
        reply.address = "127.0.0.1";
        Console.WriteLine("Ping status: " + Convert.ToString(reply.status == PingStatus.Success));
        Console.WriteLine("Ping RTT: " + Convert.ToString(reply.roundtripTime));

        // 2. Modbus TCP Client
        Console.WriteLine("-- 2. Modbus Client --");
        ModbusClient mb = new ModbusClient();
        Console.WriteLine("Modbus isConnected: " + Convert.ToString(mb.IsConnected()));
        mb.Close();

        // 3. WebDAV Client & Resource
        Console.WriteLine("-- 3. WebDav --");
        WebDavClient wd = new WebDavClient("127.0.0.1", 8080);
        wd.SetTimeout(5000);
        WebDavResource res = new WebDavResource();
        res.href = "/webdav/file.txt";
        res.contentLength = 1024;
        res.collection = false;
        Console.WriteLine("WebDav href: " + res.href);
        Console.WriteLine("WebDav len: " + Convert.ToString(res.contentLength));
        HttpResponse lockResp = new HttpResponse();
        lockResp.SetHeader("Lock-Token", "<urn:uuid:e71d4fae-5dec-22d6-fea5-00a0c91e6bf0>");
        string token = WebDavClient.ExtractLockToken(lockResp);
        Console.WriteLine("WebDav LockToken: " + token);

        HttpResponse lockXmlResp = new HttpResponse();
        lockXmlResp.body = "<?xml version=\"1.0\" encoding=\"utf-8\"?><D:prop xmlns:D=\"DAV:\"><D:lockdiscovery><D:activelock><D:locktoken><D:href>urn:uuid:12345678-abcd-ef01-2345-6789abcdef01</D:href></D:locktoken></D:activelock></D:lockdiscovery></D:prop>";
        string xmlToken = WebDavClient.ExtractLockToken(lockXmlResp);
        Console.WriteLine("WebDav XmlLockToken: " + xmlToken);

        // 4. SSE Client & Event
        Console.WriteLine("-- 4. SSE Client & Event --");
        SseEvent sseEvt = new SseEvent();
        sseEvt.name = "update";
        sseEvt.data = "{\"sensor\": 24.5}";
        Console.WriteLine("SSE evt name: " + sseEvt.name);
        Console.WriteLine("SSE evt data: " + sseEvt.data);
        SseClient sseClient = new SseClient();
        Console.WriteLine("SSE isConnected: " + Convert.ToString(sseClient.IsConnected()));
        Console.WriteLine("SSE isTlsActive: " + Convert.ToString(sseClient.IsTlsActive()));
        sseClient.Close();

        // 5. MQTT Broker, Packet & QoS
        Console.WriteLine("-- 5. MQTT Primitives --");
        Console.WriteLine("Mqtt CONNECT: " + Convert.ToString(MqttPacketType.CONNECT));
        Console.WriteLine("Mqtt PUBLISH: " + Convert.ToString(MqttPacketType.PUBLISH));
        Console.WriteLine("Mqtt QoS AtMostOnce: " + Convert.ToString(MqttQos.AtMostOnce));
        Console.WriteLine("Mqtt QoS ExactlyOnce: " + Convert.ToString(MqttQos.ExactlyOnce));
        Console.WriteLine("Mqtt PUBREC: " + Convert.ToString(MqttPacketType.PUBREC));
        Console.WriteLine("Mqtt PUBREL: " + Convert.ToString(MqttPacketType.PUBREL));
        Console.WriteLine("Mqtt PUBCOMP: " + Convert.ToString(MqttPacketType.PUBCOMP));
        MqttBroker broker = new MqttBroker("127.0.0.1", 1883);
        broker.SetAuthHandler(Program.TestMqttAuth);
        Console.WriteLine("MqttBroker sessions count: " + Convert.ToString(broker.Count()));
        MqttClient mqttClient = new MqttClient();
        mqttClient.SetCredentials("admin", "secret123");
        Console.WriteLine("MqttClient return code init: " + Convert.ToString(mqttClient.ReturnCode()));
        Console.WriteLine("MqttClient TLS active: " + Convert.ToString(mqttClient.IsTlsActive()));
        broker.Shutdown();

        // 6. CoAP Client, Code & Response
        Console.WriteLine("-- 6. CoAP Primitives --");
        Console.WriteLine("CoAP GET: " + Convert.ToString(CoapCode.GET));
        Console.WriteLine("CoAP POST: " + Convert.ToString(CoapCode.POST));
        CoapResponse coapResp = new CoapResponse(69, "{\"temp\":22}");
        Console.WriteLine("CoapResp ok: " + Convert.ToString(coapResp.ok));
        Console.WriteLine("CoapResp CodeText: " + coapResp.CodeText());

        // 7. SIP, SDP & RTP
        Console.WriteLine("-- 7. SIP & VoIP --");
        SipMessage sipReq = SipMessage.Request("OPTIONS", "sip:127.0.0.1:5060");
        Console.WriteLine("SIP req method: " + sipReq.GetMethod());
        Console.WriteLine("SIP isRequest: " + Convert.ToString(sipReq.GetIsRequest()));
        Console.WriteLine("SIP Idle State: " + Convert.ToString(SipCallState.Idle));
        Console.WriteLine("SIP Connected State: " + Convert.ToString(SipCallState.Connected));

        SdpMessage sdp = SdpMessage.CreateAudio("127.0.0.1", 40000);
        Console.WriteLine("SDP mediaPort: " + Convert.ToString(sdp.GetMediaPort()));
        Console.WriteLine("SDP codec: " + sdp.GetCodec());

        string sdpOpusText = "v=0\r\no=- 123 1 IN IP4 10.0.0.1\r\ns=Call\r\nc=IN IP4 10.0.0.1\r\nt=0 0\r\nm=audio 5004 RTP/AVP 111\r\na=rtpmap:111 opus/48000/2\r\n";
        SdpMessage parsedSdp = SdpMessage.Parse(sdpOpusText);
        Console.WriteLine("SDP opus codec: " + parsedSdp.GetCodec());
        Console.WriteLine("SDP opus rate: " + Convert.ToString(parsedSdp.GetSampleRate()));

        SipCall sipCall = new SipCall("call-1", "sip:a@local", "sip:b@local", "tag1", 1, 40000);
        sipCall.SetInviteBranch("z9hG4bK-inv-123");
        Console.WriteLine("SIP invite branch: " + sipCall.GetInviteBranch());

        RtpPacket rtp = RtpPacket.Create(0, 100, 16000, 9999, new byte[160]);
        Console.WriteLine("RTP seq: " + Convert.ToString(rtp.GetSequenceNumber()));
        Console.WriteLine("RTP pt: " + Convert.ToString(rtp.GetPayloadType()));

        // 8. HTTPS & WSS Server construction
        Console.WriteLine("-- 8. HTTPS & WSS Server --");
        HttpsServer https = new HttpsServer("0.0.0.0", 8443);
        https.SetTimeout(15000);
        https.SetMaxConnections(500);
        Console.WriteLine("HTTPS server host: " + https.host);
        Console.WriteLine("HTTPS server port: " + Convert.ToString(https.port));

        WssServer wss = new WssServer("0.0.0.0", 9443);
        wss.SetTimeout(10000);
        wss.SetMaxConnections(200);
        wss.Broadcast("TEST_BROADCAST");
        Console.WriteLine("WSS server host: " + wss.host);
        Console.WriteLine("WSS server port: " + Convert.ToString(wss.port));
        Console.WriteLine("WSS connections count: " + Convert.ToString(wss.connections.Count));
        wss.Dispose();

        // 9. POP3 Client & Mail Receiving
        Console.WriteLine("-- 9. POP3 Client & Mail Receiving --");
        Pop3Client pop = new Pop3Client("127.0.0.1", 995);
        Console.WriteLine("POP3 client connected: " + Convert.ToString(pop.IsConnected()));
        Pop3MessageInfo pmsg = new Pop3MessageInfo(1, 2048);
        Console.WriteLine("POP3 msgId: " + Convert.ToString(pmsg.id));
        Console.WriteLine("POP3 size: " + Convert.ToString(pmsg.size));
        Pop3Result pres = Pop3Result.Ok("+OK 1 2048");
        pres.count = 1;
        pres.totalBytes = 2048;
        Console.WriteLine("POP3 result ok: " + Convert.ToString(pres.ok));
        Console.WriteLine("POP3 count: " + Convert.ToString(pres.count));
        Console.WriteLine("POP3 totalBytes: " + Convert.ToString(pres.totalBytes));
        Console.WriteLine("POP3 IsOk: " + Convert.ToString(Pop3Client.IsOk("+OK mail drop ready")));

        // 10. DNS Primitives & Advanced Records
        Console.WriteLine("-- 10. DNS Primitives & Records --");
        DnsClient dns = new DnsClient("8.8.8.8", 53);
        dns.SetTimeout(2000);
        Console.WriteLine("DNS server: " + dns.dnsServer);
        Console.WriteLine("DNS port: " + Convert.ToString(dns.dnsPort));
        Console.WriteLine("DNS Rec A: " + Convert.ToString(DnsRecordType.A));
        Console.WriteLine("DNS Rec AAAA: " + Convert.ToString(DnsRecordType.AAAA));
        Console.WriteLine("DNS Rec CNAME: " + Convert.ToString(DnsRecordType.CNAME));
        Console.WriteLine("DNS Rec MX: " + Convert.ToString(DnsRecordType.MX));
        Console.WriteLine("DNS Rec TXT: " + Convert.ToString(DnsRecordType.TXT));
        Console.WriteLine("DNS Rec PTR: " + Convert.ToString(DnsRecordType.PTR));
        DnsRecord mxRec = new DnsRecord("example.com", DnsRecordType.MX, 300, "10 mail.example.com");
        Console.WriteLine("DNS MX val: " + mxRec.value);
        DnsRecord txtRec = new DnsRecord("example.com", DnsRecordType.TXT, 300, "v=spf1 ~all");
        Console.WriteLine("DNS TXT val: " + txtRec.value);

        // 11. HTTP Router & 405 Method Not Allowed (RFC 7231 §6.5.5)
        Console.WriteLine("-- 11. HTTP Router & 405 --");
        HttpRouter router = new HttpRouter();
        router.Get("/api/items", "{\"items\":[]}");
        router.Post("/api/items", "{\"created\":true}");
        HttpRequest reqGet = HttpRequest.Parse("GET /api/items HTTP/1.1\r\nHost: localhost\r\n\r\n");
        HttpResponse respGet = router.Match(reqGet);
        Console.WriteLine("Router GET status: " + Convert.ToString(respGet.statusCode));

        HttpRequest reqDel = HttpRequest.Parse("DELETE /api/items HTTP/1.1\r\nHost: localhost\r\n\r\n");
        HttpResponse respDel = router.Match(reqDel);
        Console.WriteLine("Router DELETE 405 status: " + Convert.ToString(respDel.statusCode));
        Console.WriteLine("Router 405 Allow: " + (respDel.headers.Count > 0 ? respDel.headers[0] : "none"));

        HttpRequest reqNotFound = HttpRequest.Parse("GET /api/unknown HTTP/1.1\r\nHost: localhost\r\n\r\n");
        HttpResponse respNotFound = router.Match(reqNotFound);
        Console.WriteLine("Router 404 status: " + Convert.ToString(respNotFound.statusCode));

        // 12. NetworkInterface & IDisposable
        Console.WriteLine("-- 12. NetworkInterface & IDisposable --");
        NetworkInterface netIf = new NetworkInterface();
        netIf.name = "eth0";
        netIf.description = "Gigabit Ethernet";
        netIf.up = true;
        netIf.macAddress = "00:11:22:33:44:55";
        netIf.ipAddresses.Add("192.168.1.50");
        Console.WriteLine("NetIf name before: " + netIf.name);
        Console.WriteLine("NetIf ip count: " + Convert.ToString(netIf.ipAddresses.Count));
        IDisposable disp = netIf;
        disp.Dispose();
        Console.WriteLine("NetIf disposed name null: " + Convert.ToString(netIf.name == null));
        Console.WriteLine("NetIf disposed ips null: " + Convert.ToString(netIf.ipAddresses == null));

        // 13. NTP RFC 4330 Packet Parsing & Validation
        Console.WriteLine("-- 13. NTP RFC 4330 --");
        byte[] validNtp = new byte[48];
        validNtp[0] = (byte)((0 << 6) | (4 << 3) | 4); // LI=0, VN=4, mode=4 (server)
        validNtp[1] = 1; // Stratum 1
        long mockNtpSecs = NtpClient.EPOCH_DELTA + 1700000000;
        validNtp[40] = (byte)((mockNtpSecs >> 24) & 255);
        validNtp[41] = (byte)((mockNtpSecs >> 16) & 255);
        validNtp[42] = (byte)((mockNtpSecs >> 8) & 255);
        validNtp[43] = (byte)(mockNtpSecs & 255);
        long parsedSecs = NtpClient.ParseResponse(validNtp, 48);
        Console.WriteLine("NTP valid parsed secs: " + Convert.ToString(parsedSecs));

        byte[] kodNtp = new byte[48];
        kodNtp[0] = (byte)((0 << 6) | (4 << 3) | 4);
        kodNtp[1] = 0; // Stratum 0 (Kiss-o'-Death)
        long kodSecs = NtpClient.ParseResponse(kodNtp, 48);
        Console.WriteLine("NTP KoD parsed: " + Convert.ToString(kodSecs));

        byte[] unsyncNtp = new byte[48];
        unsyncNtp[0] = (byte)((3 << 6) | (4 << 3) | 4); // LI=3 (clock unsynchronized)
        unsyncNtp[1] = 1;
        long unsyncSecs = NtpClient.ParseResponse(unsyncNtp, 48);
        Console.WriteLine("NTP Unsync parsed: " + Convert.ToString(unsyncSecs));

        // 14. Modbus, SSE & DNS Hardening
        Console.WriteLine("-- 14. Modbus, SSE & DNS --");
        ModbusClient mbTest = new ModbusClient();
        IDisposable mbDisp = mbTest;
        mbDisp.Dispose();
        Console.WriteLine("Modbus isConnected after dispose: " + Convert.ToString(mbTest.IsConnected()));

        SseClient sseTest = new SseClient();
        IDisposable sseDisp = sseTest;
        sseDisp.Dispose();
        Console.WriteLine("SSE isConnected after dispose: " + Convert.ToString(sseTest.IsConnected()));

        // 15. DNS SRV (RFC 2782)
        Console.WriteLine("-- 15. DNS SRV --");
        Console.WriteLine("DNS Rec SRV type: " + Convert.ToString(DnsRecordType.SRV));
        DnsRecord srvRec = new DnsRecord("_sip._tcp.example.com", DnsRecordType.SRV, 3600, "10 60 5060 bigbox.example.com");
        Console.WriteLine("DNS SRV val: " + srvRec.value);

        // 16. RFC 4632 CIDR Subnet & IPv4-Mapped IPv6
        Console.WriteLine("-- 16. CIDR & IPv4-Mapped IPv6 --");
        Console.WriteLine("InSubnet 192.168.1.15 in /24: " + Convert.ToString(IPAddress.IsInSubnet("192.168.1.15", "192.168.1.0/24")));
        Console.WriteLine("InSubnet 192.168.2.1 in /24: " + Convert.ToString(IPAddress.IsInSubnet("192.168.2.1", "192.168.1.0/24")));
        Console.WriteLine("InSubnet 10.0.0.1 in /0: " + Convert.ToString(IPAddress.IsInSubnet("10.0.0.1", "0.0.0.0/0")));
        Console.WriteLine("InSubnet invalid: " + Convert.ToString(IPAddress.IsInSubnet("bad-ip", "10.0.0.0/8")));
        Console.WriteLine("IPv6 mapped: " + Convert.ToString(IPAddress.IsIPv6("::ffff:192.0.2.1")));
        Console.WriteLine("IPv6 full mapped: " + Convert.ToString(IPAddress.IsIPv6("0:0:0:0:0:ffff:192.0.2.1")));
        Console.WriteLine("IPv6 mapped bad ip: " + Convert.ToString(IPAddress.IsIPv6("::ffff:999.0.0.1")));

        // 17. WebDAV PROPPATCH
        Console.WriteLine("-- 17. WebDAV PROPPATCH --");
        WebDavClient wdPatch = new WebDavClient("127.0.0.1", 8080);
        Console.WriteLine("WebDAV patch host: " + wdPatch.host);

        // 18. CoAP Codes & IDisposable
        Console.WriteLine("-- 18. CoAP Codes & Disposable --");
        Console.WriteLine("CoAP Created: " + Convert.ToString(CoapCode.Created));
        Console.WriteLine("CoAP Content: " + Convert.ToString(CoapCode.Content));
        Console.WriteLine("CoAP NotFound: " + Convert.ToString(CoapCode.NotFound));
        Console.WriteLine("CoAP InternalServerError: " + Convert.ToString(CoapCode.InternalServerError));
        CoapClient coapClient = new CoapClient("127.0.0.1", 5683);
        IDisposable coapDisp = coapClient;
        coapDisp.Dispose();
        Console.WriteLine("CoAP client disposed");

        // 19. HttpRouter Extended Verbs (PUT, DELETE, PATCH, HEAD, OPTIONS)
        Console.WriteLine("-- 19. HttpRouter Extended Verbs --");
        HttpRouter extRouter = new HttpRouter();
        extRouter.Put("/api/resource", "put-ok");
        extRouter.Delete("/api/resource", "delete-ok");
        extRouter.Patch("/api/resource", "patch-ok");
        extRouter.Head("/api/resource", "head-ok");
        extRouter.Options("/api/resource", "options-ok");

        HttpRequest reqPut = HttpRequest.Parse("PUT /api/resource HTTP/1.1\r\nHost: localhost\r\n\r\n");
        Console.WriteLine("Router PUT status: " + Convert.ToString(extRouter.Match(reqPut).statusCode));

        HttpRequest reqDel2 = HttpRequest.Parse("DELETE /api/resource HTTP/1.1\r\nHost: localhost\r\n\r\n");
        Console.WriteLine("Router DELETE status: " + Convert.ToString(extRouter.Match(reqDel2).statusCode));

        HttpRequest reqPatch = HttpRequest.Parse("PATCH /api/resource HTTP/1.1\r\nHost: localhost\r\n\r\n");
        Console.WriteLine("Router PATCH status: " + Convert.ToString(extRouter.Match(reqPatch).statusCode));

        HttpRequest reqHead = HttpRequest.Parse("HEAD /api/resource HTTP/1.1\r\nHost: localhost\r\n\r\n");
        Console.WriteLine("Router HEAD status: " + Convert.ToString(extRouter.Match(reqHead).statusCode));

        HttpRequest reqOpt = HttpRequest.Parse("OPTIONS /api/resource HTTP/1.1\r\nHost: localhost\r\n\r\n");
        Console.WriteLine("Router OPTIONS status: " + Convert.ToString(extRouter.Match(reqOpt).statusCode));

        // 20. REST Standard Responses & Verb Assertions
        Console.WriteLine("-- 20. REST Responses & Assertions --");
        HttpResponse respCreated = HttpResponse.Created("/item/1", "{\"id\":1}");
        Console.WriteLine("Resp Created: " + Convert.ToString(respCreated.statusCode));
        Console.WriteLine("Resp Created Loc: " + (respCreated.headers.Count > 0 ? respCreated.headers[0] : "none"));

        HttpResponse respNoContent = HttpResponse.NoContent();
        Console.WriteLine("Resp NoContent: " + Convert.ToString(respNoContent.statusCode));

        HttpResponse respBadRequest = HttpResponse.BadRequest("missing field");
        Console.WriteLine("Resp BadRequest: " + Convert.ToString(respBadRequest.statusCode));

        HttpResponse respUnauthorized = HttpResponse.Unauthorized("ApiRealm");
        Console.WriteLine("Resp Unauthorized: " + Convert.ToString(respUnauthorized.statusCode));
        Console.WriteLine("Resp Auth Hdr: " + (respUnauthorized.headers.Count > 0 ? respUnauthorized.headers[0] : "none"));

        HttpResponse respForbidden = HttpResponse.Forbidden("denied");
        Console.WriteLine("Resp Forbidden: " + Convert.ToString(respForbidden.statusCode));

        HttpResponse respConflict = HttpResponse.Conflict("already exists");
        Console.WriteLine("Resp Conflict: " + Convert.ToString(respConflict.statusCode));

        Console.WriteLine("Req is GET: " + Convert.ToString(reqGet.IsGet()));
        Console.WriteLine("Req is POST: " + Convert.ToString(reqGet.IsPost()));
        Console.WriteLine("Coap isSuccess: " + Convert.ToString(coapResp.IsSuccess()));
        Console.WriteLine("Coap isClientError: " + Convert.ToString(coapResp.IsClientError()));

        // 21. MIME Guessing, HTML Response & Form Fields
        Console.WriteLine("-- 21. MIME, HTML & Form Fields --");
        Console.WriteLine("MIME html: " + HttpClient.GuessMime("index.html"));
        Console.WriteLine("MIME css: " + HttpClient.GuessMime("style.css"));
        Console.WriteLine("MIME js: " + HttpClient.GuessMime("app.mjs"));
        Console.WriteLine("MIME wasm: " + HttpClient.GuessMime("module.wasm"));
        Console.WriteLine("MIME png: " + HttpClient.GuessMime("logo.PNG"));
        Console.WriteLine("MIME webp: " + HttpClient.GuessMime("hero.webp"));
        Console.WriteLine("MIME svg: " + HttpClient.GuessMime("icon.svg"));
        Console.WriteLine("MIME mp4: " + HttpClient.GuessMime("video.mp4"));
        Console.WriteLine("MIME zip: " + HttpClient.GuessMime("archive.zip"));
        Console.WriteLine("MIME unknown: " + HttpClient.GuessMime("data.xyz"));
        HttpResponse respHtml = HttpResponse.Html("<h1>Hello</h1>");
        Console.WriteLine("Resp HTML status: " + Convert.ToString(respHtml.statusCode));
        Console.WriteLine("Resp HTML ct: " + respHtml.contentType);
        HttpRequest reqForm = HttpRequest.Parse("POST /submit HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/x-www-form-urlencoded\r\n\r\nuser%20name=Alice%20Smith&age=30&empty=");
        Dict<string, string> formFields = reqForm.GetFormFields();
        Console.WriteLine("Form user name: " + formFields["user name"]);
        Console.WriteLine("Form age: " + formFields["age"]);
        Console.WriteLine("Form empty: " + formFields["empty"]);
        HttpRequest reqQs = HttpRequest.Parse("GET /search?q%20term=zan%20lang&page=1 HTTP/1.1\r\nHost: localhost\r\n\r\n");
        Dict<string, string> qsParams = reqQs.GetQueryParams();
        Console.WriteLine("QS term: " + qsParams["q term"]);
        Console.WriteLine("QS page: " + qsParams["page"]);

        // 22. IP IsPrivate (SSRF Guard), DNS NS & SIP IDisposable
        Console.WriteLine("-- 22. IsPrivate, NS & SIP Disposable --");
        Console.WriteLine("IsPrivate 10.0.0.1: " + Convert.ToString(IPAddress.IsPrivate("10.0.0.1")));
        Console.WriteLine("IsPrivate 172.16.5.1: " + Convert.ToString(IPAddress.IsPrivate("172.16.5.1")));
        Console.WriteLine("IsPrivate 192.168.1.1: " + Convert.ToString(IPAddress.IsPrivate("192.168.1.1")));
        Console.WriteLine("IsPrivate 169.254.1.1: " + Convert.ToString(IPAddress.IsPrivate("169.254.1.1")));
        Console.WriteLine("IsPrivate 8.8.8.8: " + Convert.ToString(IPAddress.IsPrivate("8.8.8.8")));
        Console.WriteLine("IsPrivate ULA: " + Convert.ToString(IPAddress.IsPrivate("fc00::1")));
        Console.WriteLine("IsPrivate LinkLocal: " + Convert.ToString(IPAddress.IsPrivate("fe80::1")));
        Console.WriteLine("IsPrivate IPv6 Global: " + Convert.ToString(IPAddress.IsPrivate("2001:db8::1")));
        Console.WriteLine("DNS Rec NS type: " + Convert.ToString(DnsRecordType.NS));
        DnsRecord nsRec = new DnsRecord("example.com", DnsRecordType.NS, 86400, "ns1.example.com");
        Console.WriteLine("DNS NS val: " + nsRec.value);
        SipClient sipCli = new SipClient("127.0.0.1", 5060, "tag1");
        IDisposable sipDisp = sipCli;
        sipDisp.Dispose();
        Console.WriteLine("SipClient disposed");
        SipCall sipCall = new SipCall("c1", "sip:a@x", "sip:b@x", "tag", 1, 0);
        IDisposable callDisp = sipCall;
        callDisp.Dispose();
        Console.WriteLine("SipCall disposed");

        // 23. Server Lifecycle & IDisposable (WssServer, HttpsServer, MqttBroker, WebDavClient)
        Console.WriteLine("-- 23. Server Lifecycle & Disposable --");
        HttpsServer srvHttps = new HttpsServer("0.0.0.0", 8443);
        IDisposable srvHttpsDisp = srvHttps;
        srvHttpsDisp.Dispose();
        Console.WriteLine("HttpsServer disposed");
        WssServer srvWss = new WssServer("0.0.0.0", 9443);
        IDisposable srvWssDisp = srvWss;
        srvWssDisp.Dispose();
        Console.WriteLine("WssServer disposed");
        MqttBroker brk = new MqttBroker("0.0.0.0", 1883);
        IDisposable brkDisp = brk;
        brkDisp.Dispose();
        Console.WriteLine("MqttBroker disposed");
        WebDavClient wdClient = new WebDavClient("127.0.0.1", 80);
        IDisposable wdDisp = wdClient;
        wdDisp.Dispose();
        Console.WriteLine("WebDavClient disposed");

        Console.WriteLine("ALL NET PROTOCOLS & CONNECTORS HARDENING CHECKS PASSED!");
    }

    static bool TestMqttAuth(string clientId, string username, string password) {
        return username == "admin" && password == "secret123";
    }
}
