// A type nested in the current class wins over a same-named type brought
// in by `using`: inside Jobs, `Handler` is the nested delegate, so
// `this.handler(...)` invokes the delegate field (C# member lookup).
using System;
using NestedShadowOther;
namespace NestedShadowHost;

public class Jobs {
    public delegate bool Handler(string id, int n);
    public Handler handler;
    public bool Run() { return this.handler("job", 2); }
}

public class Program {
    static bool Echo(string id, int n) { Console.WriteLine(id + ":" + n); return true; }
    public static void Main() {
        Jobs j = new Jobs();
        j.handler = Echo;
        Console.WriteLine(j.Run());
    }
}
