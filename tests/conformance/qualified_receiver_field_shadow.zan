// A namespace-qualified static receiver names the TYPE even where a field
// of the same name is in scope: `QualShadow.Text.Len(s)` inside a class with
// a class-typed `Text` field calls the static class, it does not read the
// field (whose type has no such member).
using System;
namespace QualShadow.Ui;

public class Caption {
    public string Value = "field";
}

public class Label {
    public Caption Text = new Caption();
    public int Count = 0;
    public int Measure(string s) { return QualShadow.Text.Len(s) + Count; }
    public string Tag() { return QualShadow.Text.Name + "/" + Text.Value; }
}

public class Program {
    public static void Main() {
        Label l = new Label();
        Console.WriteLine(l.Measure("abcd"));
        Console.WriteLine(l.Tag());
    }
}
