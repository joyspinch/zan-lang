using System;
using System.Json;
using Sdk.Jd;

namespace JdSdkTest;

// 测试断言与状态转移验证。
// // 测试断言与状态转移验证。
// 测试断言与状态转移验证。
class Province {
    public long id;
    public string name;
    public bool cod;
}

class ProvinceResult {
    public List<Province> province_areas;
    public bool success;
}

class Program {
    static void TestSign() {
        // 核心契约与语义定义。
        Dictionary<string, string> p = new Dictionary<string, string>();
        p.Add("method", "jingdong.area.province.get");
        p.Add("app_key", "abc");
        p.Add("v", "2.0");
        string sign = JdSign.Compute(p, "sec");
        // 测试断言与状态转移验证。
        Console.WriteLine("sign=" + sign);
        Console.WriteLine("signLen=" + Convert.ToString(sign.Length));

        // 核心契约与语义定义。
        Dictionary<string, string> q = new Dictionary<string, string>();
        q.Add("v", "2.0");
        q.Add("method", "jingdong.area.province.get");
        q.Add("app_key", "abc");
        Console.WriteLine("orderStable=" + Convert.ToString(JdSign.Compute(q, "sec") == sign));

        // 核心契约与语义定义。
        Dictionary<string, string> r = new Dictionary<string, string>();
        r.Add("method", "jingdong.area.province.get");
        r.Add("app_key", "abc");
        r.Add("v", "2.0");
        r.Add("access_token", "");
        Console.WriteLine("emptySkipped=" + Convert.ToString(JdSign.Compute(r, "sec") == sign));
    }

    static void TestRequest() {
        JdRequest req = new JdRequest("jingdong.ware.read.searchWare4Valid");
        req.Set("field", "value").SetInt("pageNo", 1).SetBool("onlyValid", true);
        Console.WriteLine("api=" + req.ApiName);
        Console.WriteLine("version=" + req.ApiVersion);
        Console.WriteLine("param=" + req.ParamJson());

        // 测试断言与状态转移验证。
        JdRequest q = new JdRequest("jingdong.test");
        q.Set("keyword", "say \"hi\"");
        Console.WriteLine("escaped=" + q.ParamJson());

        // 核心契约与语义定义。
        JdRequest e = new JdRequest("jingdong.test");
        e.Set("a", "").Set("b", "x");
        Console.WriteLine("dropEmpty=" + e.ParamJson());
    }

    static void TestEnvelope() {
        string body = "{\"jingdong_area_province_get_responce\":{\"province_areas\":[{\"id\":1,\"name\":\"Beijing\",\"cod\":true},{\"id\":2,\"name\":\"Shanghai\",\"cod\":false}],\"success\":true}}";
        JdResponse resp = JdResponse.Parse(body);
        ProvinceResult r = Json.Deserialize<ProvinceResult>(resp.Data);
        Console.WriteLine("count=" + Convert.ToString(r.province_areas.Count));
        Console.WriteLine("first=" + r.province_areas[0].name);
        Console.WriteLine("cod=" + Convert.ToString(r.province_areas[0].cod));
        Console.WriteLine("success=" + Convert.ToString(r.success));
        // 核心契约与语义定义。
        JsonValue areas = resp.Value.Get("province_areas");
        if (areas == null) { Console.WriteLine("null:areas"); return; }
        JsonValue areaName = areas.At(1).Get("name");
        if (areaName == null) { Console.WriteLine("null:areaName"); return; }
        Console.WriteLine("dynamic=" + areaName.AsString(""));
    }

    static void TestGatewayError() {
        string body = "{\"error_response\":{\"code\":\"18\",\"zh_desc\":\"app is not exist\"}}";
        try {
            JdResponse resp = JdResponse.Parse(body);
            Console.WriteLine("gatewayError=NOT THROWN");
        } catch (JdException e) {
            Console.WriteLine("gatewayError code=" + e.Code);
            Console.WriteLine("gatewayError raw=" + Convert.ToString(e.Body.Length > 0));
        }
    }

    static void TestBusinessError() {
        string body = "{\"jingdong_x_responce\":{\"code\":\"1001\",\"zh_desc\":\"quota exceeded\"}}";
        try {
            JdResponse resp = JdResponse.Parse(body);
            Console.WriteLine("bizError=NOT THROWN");
        } catch (JdException e) {
            Console.WriteLine("bizError code=" + e.Code);
        }
    }

    static void TestSuccessCodeZero() {
        // 测试断言与状态转移验证。
        string body = "{\"jingdong_x_responce\":{\"code\":\"0\",\"total\":42}}";
        JdResponse resp = JdResponse.Parse(body);
        JsonValue total = resp.Value.Get("total");
        if (total == null) { Console.WriteLine("null:total"); return; }
        Console.WriteLine("codeZeroOk=" + Convert.ToString(total.AsInt(0)));
    }

    static void TestMalformed() {
        try {
            JdResponse resp = JdResponse.Parse("not json at all");
            Console.WriteLine("malformed=NOT THROWN");
        } catch (JdException e) {
            Console.WriteLine("malformed code=" + e.Code);
        }
    }

    static void TestTimestamp() {
        // 测试断言与状态转移验证。
        // 2024-05-06 07:08:09 UTC = 1714979289.
        Console.WriteLine("tsBeijing=" + JdClient.FormatTimestamp(1714979289, 480));
        Console.WriteLine("tsUtc=" + JdClient.FormatTimestamp(1714979289, 0));
        Console.WriteLine("tsIndia=" + JdClient.FormatTimestamp(1714979289, 330));
        Console.WriteLine("tsWest=" + JdClient.FormatTimestamp(1714979289, -300));
    }

    static void TestClientValidation() {
        // 测试断言与状态转移验证。
        JdClient bad = new JdClient("", "");
        Console.WriteLine("clientBuilt=ok");
    }

    static void Main() {
        TestSign();
        TestRequest();
        TestEnvelope();
        TestGatewayError();
        TestBusinessError();
        TestSuccessCodeZero();
        TestMalformed();
        TestTimestamp();
        TestClientValidation();
    }
}
