using System;
using System.Security.Cryptography;

class Program {
    static void Main() {
        byte[] alicePriv = Hex.Decode("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a");
        byte[] bobPriv = Hex.Decode("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb");

        byte[] alicePub = Curve25519.GetPublicKey(alicePriv);
        byte[] bobPub = Curve25519.GetPublicKey(bobPriv);
        Console.WriteLine(Hex.Encode(alicePub, 32));
        Console.WriteLine(Hex.Encode(bobPub, 32));

        byte[] sharedA = Curve25519.DeriveSharedSecret(alicePriv, bobPub);
        byte[] sharedB = Curve25519.DeriveSharedSecret(bobPriv, alicePub);
        Console.WriteLine(Hex.Encode(sharedA, 32));
        Console.WriteLine(Hex.Encode(sharedB, 32));

        // 核心契约与语义定义。
        byte[] secret = Hex.Decode("4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742");
        byte[] labelKey = Hkdf.ExpandLabel(secret, "key", null, 16);
        byte[] labelIv = Hkdf.ExpandLabel(secret, "iv", null, 12);
        Console.WriteLine(Hex.Encode(labelKey, 16));
        Console.WriteLine(Hex.Encode(labelIv, 12));
    }
}
