// B-ID163④：`as` 免查透传仅限静态可证安全两条——object 目标（引用源
// 上转恒真）、string 源到 string（恒等）。旧实现把 string/interface 目标
// 也零检查透传：异型对象 `as string` 直接把指针当 string 用、无关类
// `as 接口` 绕过实现检查（类型混淆，TASKS B-ID163④）。其余补运行时
// 检查，失败静默 null——as 契约与 C# 同义（与 `(T)x` 抛异常刻意不同）。
using System;

class Animal {
    public string Name;
}
interface ISpeak {
    string Speak();
}
class Cat : Animal, ISpeak {
    public string Speak() {
        return "meow";
    }
}

class Program {
    static int Main() {
        Animal a = new Animal();
        a.Name = "generic";
        string s = a as string;
        Console.WriteLine("as-string-null:" + (s == null));
        ISpeak sp = a as ISpeak;
        Console.WriteLine("as-iface-null:" + (sp == null));
        Cat c = new Cat();
        ISpeak sp2 = c as ISpeak;
        Console.WriteLine("as-iface-ok:" + (sp2 != null ? sp2.Speak() : "null"));
        object o = a as object;
        Console.WriteLine("as-object:" + (o != null));
        Animal again = c as Animal;
        Console.WriteLine("as-upcast:" + (again != null));
        string str = "text";
        string same = str as string;
        Console.WriteLine("as-str-id:" + (same == "text"));
        return 0;
    }
}
