// 接口数据协议与执行契约。
using System;
using System.Threading;

class Program {
    static AtomicInt hits;
    static AtomicInt pong;
    static AtomicInt cancelled;

    // 接口数据协议与执行契约。
    static async int Leaf(int ms) {
        await Task.Delay(ms);
        Program.hits.Add(1);
        return 0;
    }

    // 接口数据协议与执行契约。
    static async int Ping(int rounds) {
        for (int i = 0; i < rounds; i = i + 1) {
            await Task.Delay(0);
            Program.pong.Add(1);
        }
        return 0;
    }

    // 接口数据协议与执行契约。
    // 核心契约与语义定义。
    static async int Slow() {
        await Task.Delay(5000);
        Program.cancelled.Add(1);
        return 0;
    }

    static async int Run() {
        Program.hits = new AtomicInt(0);
        Program.pong = new AtomicInt(0);
        Program.cancelled = new AtomicInt(0);

        // 接口数据协议与执行契约。
        List<long> fan = new List<long>();
        for (int i = 0; i < 96; i = i + 1) {
            fan.Add(Task.Spawn(Program.Leaf(i % 4)));
        }
        int joined = await Task.WhenAll(fan);
        Console.WriteLine("joined=" + Convert.ToString(joined));
        Console.WriteLine("hits=" + Convert.ToString(Program.hits.Load()));

        List<long> pair = new List<long>();
        pair.Add(Task.Spawn(Program.Ping(50)));
        pair.Add(Task.Spawn(Program.Ping(50)));
        await Task.WhenAll(pair);
        Console.WriteLine("pong=" + Convert.ToString(Program.pong.Load()));

        List<long> slow = new List<long>();
        for (int i = 0; i < 16; i = i + 1) {
            slow.Add(Task.Spawn(Program.Slow()));
        }
        TaskJoin.CancelAll(slow);
        int drained = await Task.WhenAll(slow);
        Console.WriteLine("drained=" + Convert.ToString(drained));
        Console.WriteLine("cancelled=" + Convert.ToString(Program.cancelled.Load()));

        // 接口数据协议与执行契约。
        await Task.Delay(5);
        int tail = await Program.Leaf(1);
        Console.WriteLine("hits2=" + Convert.ToString(Program.hits.Load()));
        return tail;
    }

    static async void Main() {
        await Program.Run();
        Console.WriteLine("ok");
    }
}
