using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

// RenderCached 缓存命中帧的 owner-view 事件链路断言：
// - miss 帧产出的 Keyed 实例经 SetCachedOwner 登记后，
// 后续命中帧 CachedOwner 返回同一实例（实例身份是事件
// 订阅归属的基础；悬停的跨帧连续性由 wid 悬停槽承载，
// 不依赖实例存活）；
// - 未登记键现建 owner 且 wid 即传入键；
// - 事件 id 段 = 9700000 + wid（与普通 Render 同约定）；
// - owner view 的初始化态：eventHitId 未注册、wid 悬停槽
// 为空——命中帧由 BeginCachedEventFrame 恢复派发语义。
class Program {
    static void Main() {
        ChartOption heat = ChartOption.Of("Cached", null,
            new List<ChartSeries>{ChartSeries.Of("H", ChartType.Heatmap,
                new List<int>{1, 2, 3, 4})});
        ChartView v0 = ChartView.Keyed(heat, 300005);
        v0.staticFrame = true;
        ChartView.SetCachedOwner(300005, v0, 10, 10, 200, 100);
        ChartView v1 = ChartView.CachedOwner(heat, 300005, 12, 14, 220, 110);
        Console.WriteLine("ownerSame:" + Convert.ToString(v1 == v0)
            + ":" + Convert.ToString(v1.wid == 300005));
        ChartView v2 = ChartView.CachedOwner(heat, 300009, 0, 0, 50, 50);
        Console.WriteLine("freshOwner:" + Convert.ToString(v2 != null)
            + ":" + Convert.ToString(v2.wid == 300009));
        Console.WriteLine("hitIdSeg:" + Convert.ToString(v0.eventHitId < 0)
            + ":" + Convert.ToString(9700000 + 300005));
        Console.WriteLine("freshState:"
            + Convert.ToString(ChartView.HoverSlotHit(300009) == null)
            + ":" + Convert.ToString(ChartView.HoverSlotOver(300009) == false));
    }
}
