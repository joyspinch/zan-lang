using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static int clicks;
    static int hovers;
    static int dataIndex = -1;
    static int leaves;

    static void Check(bool value, string message) {
        if (!value) { throw new Exception("cached chart: " + message); }
    }
    static void Left(ChartInteractionEvent e) { leaves = leaves + 1; }
    static void Click(App app, int x, int y) {
        app.ProcessOffscreenInput(2, x, y, 0, 0, 0, 0);
        app.ProcessOffscreenInput(3, x, y, 0, 0, 0, 0);
    }

    static void Clicked(ChartInteractionEvent e) { clicks = clicks + 1; dataIndex = e.dataIndex; }
    static void Hovered(ChartInteractionEvent e) { hovers = hovers + 1; }

    static void Main() {
        App app = App.CreateOffscreen("cached chart events", 320, 240);
        Control root = new Control(); root.UseApp(app); app.SetRootControl(root);
        ChartOption heat = ChartOption.Of("Cached", null,
        new List<ChartSeries>{ChartSeries.Of("H", ChartType.Heatmap,
        new List<int>{1, 2, 3, 4})});
        heat.animate = false; heat.showLegend = false;
        int slot = ChartView.AllocCacheSlot(); int key = IdHash.HashInt(slot, 300);
        ChartView owner = ChartView.CachedOwner(app.canvas, heat, key, 0, 0, 320, 240);
        ChartView same = ChartView.CachedOwner(app.canvas, heat, key, 12, 14, 220, 110);
        Console.WriteLine("ownerSame:" + Convert.ToString(owner == same) + ":" + Convert.ToString(owner.wid == key));
        App otherApp = App.CreateOffscreen("cache scope", 320, 240);
        Canvas otherCanvas = otherApp.canvas;
        ChartView other = ChartView.CachedOwner(otherCanvas, heat, key, 0, 0, 320, 240);
        Console.WriteLine("canvasScoped:" + Convert.ToString(other != owner));
        owner.OnClick(Program.Clicked); owner.On(ChartEventType.Hover, Program.Hovered);
        owner.On(ChartEventType.MouseOut, Program.Left);
        root.Add(owner); root.MeasureTree(app); root.Arrange(0, 0, 320, 240); owner.Arrange(0, 0, 320, 240);
        app.ProcessOffscreenInput(2, 100, 90, 0, 0, 0, 0);
        app.ProcessOffscreenInput(3, 100, 90, 0, 0, 0, 0);
        app.ProcessOffscreenInput(2, 100, 90, 0, 0, 0, 0);
        app.ProcessOffscreenInput(3, 100, 90, 0, 0, 0, 0);
        Console.WriteLine("retainedInput:" + Convert.ToString(clicks == 2) + ":" + Convert.ToString(hovers > 0) + ":" + Convert.ToString(dataIndex == 0));
        int before = clicks; int nodes = owner.ChildCount();
        ChartView.PrepareCached(app, heat, slot, 0, 0, 320, 240);
        app.BeginOffscreenFrame(); owner.OnPaint(app); app.EndOffscreenFrame();
        Console.WriteLine("paintPure:" + Convert.ToString(clicks == before) + ":" + Convert.ToString(owner.ChildCount() == nodes));
        ChartView.PrepareCached(app, heat, slot, 0, 0, 320, 240);
        app.BeginOffscreenFrame();
        bool miss = !ChartView.RenderCached(app, heat, slot, 0, 0, 320, 240);
        bool restored = ChartView.RenderCached(app, heat, slot, 0, 0, 320, 240);
        app.EndOffscreenFrame();
        Click(app, 100, 90);
        Check(miss && restored && clicks == 3 && dataIndex == 0,
        "snapshot miss and hit preserve retained subscriptions and geometry");
        Console.WriteLine("cachedFrame:true:true:true");
        heat.toolboxShow = true; heat.toolboxDataView = true;
        app.ProcessOffscreenInput(1, 100, 90, 0, 0, 0, 0);
        Control tool = null;
        for (int i = 0; i < owner.ChildCount(); i = i + 1) {
            Control child = owner.ChildAt(i);
            if (child.Tip == "数据视图" && child.StyleVisible()) { tool = child; }
        }
        Check(tool != null, "toolbox prepared before paint");
        int oldLeaves = leaves;
        Click(app, tool.bx + 3, tool.by + 3);
        Check(clicks == 3 && leaves > oldLeaves && owner.LastHoverHit() == null,
        "chrome neither forwards click nor retains a body hover");
        Click(app, 100, 90);
        Check(clicks == 3 && owner.LastHoverHit() == null, "data view overlay fences body hits");
        Console.WriteLine("pointerBody:true:true:true");
        root.Remove(owner); ChartView.ReleaseCached(app.canvas, slot);
        ChartView fresh = ChartView.CachedOwner(app.canvas, heat, key, 0, 0, 320, 240);
        Check(fresh != owner && owner.IsDisposed(), "release creates a new retained owner");
        Console.WriteLine("freshOwner:true:true");
        ChartView.ReleaseCached(app.canvas, slot);
        ChartView.ReleaseCached(otherCanvas, slot); otherApp.StopLoop(); otherCanvas.Destroy();
        app.StopLoop(); app.canvas.Destroy();
    }
}
