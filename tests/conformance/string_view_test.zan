using System;
using System.Json;
using System.Net.Http;

class Program {
    static void Main() {
        string text = "  Hello, Zan High-Performance World! 123456  ";
        StringView v = text.AsView();
        Console.WriteLine("length=" + Convert.ToString(v.Length));
        Console.WriteLine("isEmpty=" + Convert.ToString(v.IsEmpty));

        StringView trimmed = v.Trim();
        Console.WriteLine("trimmed=" + trimmed.ToString());
        Console.WriteLine("trimmed.length=" + Convert.ToString(trimmed.Length));

        StringView sub = trimmed.Slice(7, 3);
        Console.WriteLine("sub=" + sub.ToString());
        Console.WriteLine("sub.eq.Zan=" + Convert.ToString(sub.Equals("Zan")));
        Console.WriteLine("sub.eq.wrong=" + Convert.ToString(sub.Equals("Zan2")));

        Console.WriteLine("startsWith.Hello=" + Convert.ToString(trimmed.StartsWith("Hello")));
        Console.WriteLine("endsWith.123456=" + Convert.ToString(trimmed.EndsWith("123456")));

        int idxWorld = trimmed.IndexOf("World");
        Console.WriteLine("idx.World=" + Convert.ToString(idxWorld));

        StringView numView = trimmed.Slice(trimmed.Length - 6, 6);
        Console.WriteLine("num=" + Convert.ToString(numView.ToInt32()));
        Console.WriteLine("num64=" + Convert.ToString(numView.ToInt64()));

        // JsonDoc ViewAt integration
        string json = "{\"path\":\"/api/v1/users\",\"role\":\"admin\",\"status\":200}";
        JsonDoc doc = JsonDoc.Parse(json);
        int pSlot = doc.Get("path");
        StringView pathView = doc.ViewAt(pSlot);
        Console.WriteLine("json.pathView=" + pathView.ToString());
        Console.WriteLine("json.pathView.starts=/api=" + Convert.ToString(pathView.StartsWith("/api")));

        int rSlot = doc.Get("role");
        StringView roleView = doc.ViewAt(rSlot);
        Console.WriteLine("json.roleView=" + roleView.ToString());
        Console.WriteLine("json.roleView.eq.admin=" + Convert.ToString(roleView.Equals("admin")));

        int sSlot = doc.Get("status");
        Console.WriteLine("json.status.int=" + Convert.ToString(doc.IntAt(sSlot, 0)));

        // HttpRequest View integration
        string reqRaw = "GET /dashboard?tab=overview HTTP/1.1\r\nHost: 127.0.0.1\r\nAuthorization: Bearer token_secret_123\r\n\r\n";
        HttpRequest req = HttpRequest.Parse(reqRaw);
        Console.WriteLine("req.method=" + req.MethodView().ToString());
        Console.WriteLine("req.path=" + req.PathView().ToString());
        Console.WriteLine("req.query=" + req.QueryView().ToString());
        StringView auth = req.GetHeaderView("Authorization");
        Console.WriteLine("req.auth=" + auth.ToString());
        Console.WriteLine("req.auth.startsWith.Bearer=" + Convert.ToString(auth.StartsWith("Bearer ")));
        StringView token = auth.Slice(7);
        Console.WriteLine("req.token=" + token.ToString());
        Console.WriteLine("req.token.eq=" + Convert.ToString(token.Equals("token_secret_123")));
        Console.WriteLine("STRINGVIEW TEST SUCCESS");
    }
}
