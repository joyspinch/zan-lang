using System;
using System.Threading;

// An exception leaving a `lock` body inside an async method releases the
// monitor (B-ID199 round 7: gen1 armed no handler for `lock` in coroutines,
// so the lock stayed held and the next locker -- here another thread --
// blocked forever).
class Program {
    static object gate = new object();
    static int got = 0;

    static async int Bad(int x) {
        await Task.Delay(1);
        lock (Program.gate) {
            if (x > 0) { throw new Exception("inside lock"); }
        }
        return 1;
    }

    static async int Good() {
        await Task.Delay(1);
        lock (Program.gate) { return 7; }
    }

    static async int Main() {
        try { await Bad(1); } catch (Exception e) { Console.WriteLine("caught " + e.Message); }
        Console.WriteLine("good " + (await Good()).ToString());
        Thread.Start(() => { lock (Program.gate) { Program.got = 1; } });
        int waited = 0;
        while (Program.got == 0 && waited < 2000) { Thread.Sleep(10); waited = waited + 10; }
        Console.WriteLine("reacquired " + Program.got.ToString());
        return 0;
    }
}
