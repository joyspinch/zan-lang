// System.Ocr smoke test: CTC greedy decoding, DB postprocess (binarize +
// connected components + exact rectangular unclip), and the image
// preprocessing primitives — all synthetic, no models needed. The expected
// pixel/box values are worked out by hand in the comments; fixtures come
// from the same generators as ocr_png_decode.
using System;
using System.Ocr;

namespace Conf;

class Prog {
    static int bad = 0;

    static void Main() {
        // ---- CTC：字典装载、折叠重复、丢 blank、空格类 ----
        // 字典 "AB" + 空格：blank=0, A=1, B=2, 空格=3
        Ctc ctc = Ctc.FromChars("AB", true);
        if (ctc.ClassCount() != 4) { bad = bad + 1; }
        // 5 帧：A, A, blank, B, B → "AB"
        float[] probs = new float[5 * 4];
        int[] want = new int[5];
        want[0] = 1; want[1] = 1; want[2] = 0; want[3] = 2; want[4] = 2;
        float[] conf = new float[5];
        conf[0] = 0.9f; conf[1] = 0.8f; conf[2] = 0.9f;
        conf[3] = 0.7f; conf[4] = 0.6f;
        for (int t = 0; t < 5; t = t + 1) {
            probs[t * 4] = 0.05f;
            probs[t * 4 + 1] = 0.05f;
            probs[t * 4 + 2] = 0.05f;
            probs[t * 4 + 3] = 0.05f;
            probs[t * 4 + want[t]] = conf[t];
        }
        OcrText r = ctc.Greedy(probs, 5, 4);
        if (r.Text() != "AB") { bad = bad + 1; }
        // 平均置信度只统计采纳帧（重复帧被折叠）: (0.9+0.7)/2 = 0.8
        if (Math.Abs(r.Score() - 0.8f) > 1e-4f) { bad = bad + 1; }

        // 空格类参与解码：帧序列 B, blank, space → "B "
        float[] probs2 = new float[3 * 4];
        int[] want2 = new int[3];
        want2[0] = 2; want2[1] = 0; want2[2] = 3;
        for (int t = 0; t < 3; t = t + 1) {
            probs2[t * 4 + want2[t]] = 0.85f;
        }
        OcrText r2 = ctc.Greedy(probs2, 3, 4);
        if (r2.Text() != "B ") { bad = bad + 1; }

        // 全 blank → 空文本 0 分
        float[] probs3 = new float[2 * 4];
        probs3[0] = 1.0f;
        probs3[4] = 1.0f;
        OcrText r3 = ctc.Greedy(probs3, 2, 4);
        if (r3.Text().Length != 0 || r3.Score() != 0.0f) { bad = bad + 1; }

        // 多字符字典文本装载（换行/回车/尾空行容错）
        Ctc ctc2 = Ctc.FromDictText("中\n文\r\n测\n试\n", true);
        if (ctc2.ClassCount() != 6) { bad = bad + 1; }
        float[] probs4 = new float[2 * 6];
        probs4[0 * 6 + 1] = 0.9f;  // 中
        probs4[1 * 6 + 2] = 0.8f;  // 文
        OcrText r4 = ctc2.Greedy(probs4, 2, 6);
        if (r4.Text() != "中文") { bad = bad + 1; }

        // ---- DB 后处理：两个连通域 + unclip + 低分丢弃 + 坐标还原 ----
        // 12x8 概率图（原图 24x16 的半分辨率，scale=2）
        // blob1 (1..3,1..2) 3x2 值 0.9；blob2 (7..10,3..6) 4x4 值 0.6；
        // blob3 (1..2,5..6) 2x2 值 0.4（低于 boxThresh=0.5，应被丢）
        int mw = 12;
        int mh = 8;
        float[] map = new float[mw * mh];
        for (int i = 0; i < map.Length; i = i + 1) { map[i] = 0.01f; }
        for (int y = 1; y <= 2; y = y + 1) {
            for (int x = 1; x <= 3; x = x + 1) { map[y * mw + x] = 0.9f; }
        }
        for (int y = 3; y <= 6; y = y + 1) {
            for (int x = 7; x <= 10; x = x + 1) { map[y * mw + x] = 0.6f; }
        }
        for (int y = 5; y <= 6; y = y + 1) {
            for (int x = 1; x <= 2; x = x + 1) { map[y * mw + x] = 0.4f; }
        }
        List<DetBox> boxes = Det.Boxes(map, mw, mh, 0.3f, 0.5f, 1.5f, 2.0f, 2.0f);
        if (boxes.Count != 2) { bad = bad + 1; }
        if (boxes.Count == 2) {
            // blob1: w=3,h=2 → d=(int)(6*1.5/10)=0 → 原图 (2,2)-(7,5)
            DetBox b1 = boxes[0].MinY() == 2 ? boxes[0] : boxes[1];
            DetBox b2 = boxes[0].MinY() == 2 ? boxes[1] : boxes[0];
            if (b1.MinX() != 2 || b1.MinY() != 2 || b1.MaxX() != 7
                || b1.MaxY() != 5) {
                bad = bad + 1;
            }
            // blob2: w=4,h=4 → d=(int)(16*1.5/16)=1 → (6,2)-(11,7)
            // → 原图 (12,4)-(23,15)
            if (b2.MinX() != 12 || b2.MinY() != 4 || b2.MaxX() != 23
                || b2.MaxY() != 15) {
                bad = bad + 1;
            }
            if (Math.Abs(b1.Score() - 0.9f) > 1e-5f) { bad = bad + 1; }
        }

        // ---- 预处理原语：灰度、恒等裁剪归一化 ----
        // 2x1 RGBA：(1,2,3,255),(4,5,6,255)
        byte[] px = new byte[8];
        px[0] = 1; px[1] = 2; px[2] = 3; px[3] = 255;
        px[4] = 4; px[5] = 5; px[6] = 6; px[7] = 255;
        float[] gray = ImgUtil.Gray(px, 2, 1);
        float g0 = 0.299f * 1 + 0.587f * 2 + 0.114f * 3;
        float g1 = 0.299f * 4 + 0.587f * 5 + 0.114f * 6;
        if (Math.Abs(gray[0] - g0) > 1e-3f || Math.Abs(gray[1] - g1) > 1e-3f) {
            bad = bad + 1;
        }
        // 恒等裁剪 + rec 归一化 (0.5/0.5)：x/255-1
        float[] nchw = ImgUtil.CropResizeNchw(px, 2, 1, 0, 0, 1, 0, 2, 1,
            0.5f, 0.5f, 0.5f, 0.5f, 0.5f, 0.5f);
        float want0 = (1.0f / 255 - 0.5f) / 0.5f;
        if (Math.Abs(nchw[0] - want0) > 1e-3f) { bad = bad + 1; }
        if (Math.Abs(nchw[1] - ((4.0f / 255 - 0.5f) / 0.5f)) > 1e-3f) {
            bad = bad + 1;
        }
        // det 归一化（ImageNet 统计）与 NCHW 通道排布
        float[] det = ImgUtil.CropResizeNchw(px, 2, 1, 0, 0, 1, 0, 2, 1,
            0.485f, 0.456f, 0.406f, 0.229f, 0.224f, 0.225f);
        float wantR = (1.0f / 255 - 0.485f) / 0.229f;
        if (Math.Abs(det[0] - wantR) > 1e-3f) { bad = bad + 1; }
        // NCHW：R 平面 2 像素在前，G 平面从 outH*outW=2 起
        float wantG = (2.0f / 255 - 0.456f) / 0.224f;
        if (Math.Abs(det[2] - wantG) > 1e-3f) { bad = bad + 1; }

        // DetInputSize：长边限制 + 32 对齐
        int[] wh = ImgUtil.DetInputSize(1920, 1080, 960);
        if (wh[0] != 960 || wh[1] != 544) { bad = bad + 1; }
        int[] wh2 = ImgUtil.DetInputSize(300, 200, 960);
        if (wh2[0] != 320 || wh2[1] != 224) { bad = bad + 1; }

        Console.WriteLine("ocr-core: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
