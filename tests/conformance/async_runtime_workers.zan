using System;
using System.Threading;

class Program {
    static AtomicInt counter;

    static async int WorkerTask(int id, int count) {
        for (int i = 0; i < count; i = i + 1) {
            await Task.Yield();
            Program.counter.Add(1);
        }
        return id;
    }

    static async int Run() {
        Program.counter = new AtomicInt(0);
        AsyncRuntime.SetWorkers(4);
        int workers = AsyncRuntime.Workers();
        Console.WriteLine("workers=" + Convert.ToString(workers));

        List<long> tasks = new List<long>();
        for (int i = 0; i < 32; i = i + 1) {
            tasks.Add(Task.Spawn(Program.WorkerTask(i, 20)));
        }

        int completed = await Task.WhenAll(tasks);
        Console.WriteLine("completed=" + Convert.ToString(completed));
        Console.WriteLine("counter=" + Convert.ToString(Program.counter.Load()));
        return 0;
    }

    static async void Main() {
        await Program.Run();
        Console.WriteLine("ok");
    }
}
