using System;
using System.Threading.Tasks;

class Item {
    public string Name;
    public Item(string name) { Name = name; }
}

class EmptyBox<T> {
    public static T Cached;
}

class Program {
    static async Task<int> RunAsync(int mode) {
        Item a = new Item("alpha");
        Item b = new Item("beta");
        await Task.Yield();
        if (mode == 1) {
            throw new Exception("uncaught:" + a.Name);
        }
        try {
            Item c = new Item("gamma");
            if (mode == 2) {
                throw new Exception("caught:" + c.Name);
            }
            return b.Name.Length;
        } catch (Exception ex) {
            return ex.Message.Length;
        }
    }

    static async Task Main() {
        EmptyBox<Item>.Cached = new Item("cached-item");
        EmptyBox<string>.Cached = "cached-" + "str";
        Console.WriteLine("cached=" + EmptyBox<Item>.Cached.Name + "," + EmptyBox<string>.Cached);

        int r0 = await RunAsync(0);
        int r2 = await RunAsync(2);
        string err = "";
        try {
            await RunAsync(1);
        } catch (Exception ex) {
            err = ex.Message;
        }
        Console.WriteLine("async=" + Convert.ToString(r0) + "," + Convert.ToString(r2) + "," + err);
    }
}
