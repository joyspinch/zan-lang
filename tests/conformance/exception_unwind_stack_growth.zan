// The unwind stack (A8-12) has to hold every live owning local of every frame
// between the handler and the throw site, so its depth is bounded by recursion
// depth -- not by anything the compiler can size up front. 1500 frames x 3
// owning locals overflows both the old fixed capacity and the growth steps
// below it; entries that do not fit are silently dropped, and everything they
// point at leaks when the longjmp skips those frames (run under --check-leaks).
using System;

class Program {
    static int Deep(int n) {
        List<string> a = new List<string>();
        a.Add("a" + Convert.ToString(n));
        List<string> b = new List<string>();
        b.Add("b");
        List<string> c = new List<string>();
        c.Add("c");
        if (n == 0)
            throw new Exception("bottom");
        int r = Deep(n - 1);
        return r + a.Count + b.Count + c.Count;
    }

    static void Main() {
        try {
            int r = Deep(1500);
            Console.WriteLine("no throw " + Convert.ToString(r));
        } catch (Exception e) {
            Console.WriteLine("caught " + e.Message);
        }
        // the stack is back at the handler's depth, so a shallow throw after it
        // still unwinds exactly its own entries
        try {
            int r2 = Deep(3);
            Console.WriteLine("no throw " + Convert.ToString(r2));
        } catch (Exception e2) {
            Console.WriteLine("caught again " + e2.Message);
        }
        Console.WriteLine("done");
    }
}
