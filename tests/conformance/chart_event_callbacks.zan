using System;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static int clicks;
    static int legends;
    static int dataChanges;
    static int restores;
    static string log;

    static void OnClick(ChartInteractionEvent e) {
        clicks = clicks + 1;
        log = log + e.TypeName() + ":" + Convert.ToString(e.chartWid) + ":"
            + Convert.ToString(e.x) + ":" + Convert.ToString(e.y) + "|";
    }

    static void OnLegend(ChartInteractionEvent e) {
        legends = legends + 1;
        log = log + e.TypeName() + ":" + Convert.ToString(e.seriesIndex)
            + ":" + e.seriesName + ":" + Convert.ToString(e.selected) + "|";
    }

    static void OnData(ChartInteractionEvent e) {
        dataChanges = dataChanges + 1;
        log = log + e.TypeName() + "|";
    }

    static void OnRestore(ChartInteractionEvent e) {
        restores = restores + 1;
        log = log + e.TypeName() + "|";
    }

    static void Main() {
        ChartInteractionEvent clickEvent = ChartInteractionEvent.Of(
            ChartEventType.Click, 77);
        clickEvent.x = 12;
        clickEvent.y = 34;
        Console.WriteLine(clickEvent.TypeName() + ":" + Convert.ToString(clickEvent.chartWid)
            + ":" + Convert.ToString(clickEvent.seriesIndex) + ":"
            + Convert.ToString(clickEvent.dataIndex) + ":"
            + Convert.ToString(clickEvent.zoomStart) + ":"
            + Convert.ToString(clickEvent.zoomEnd));
        Console.WriteLine(ChartInteractionEvent.ElementName(clickEvent.elementType)
            + ":" + Convert.ToString(clickEvent.dataHit) + ":"
            + Convert.ToString(clickEvent.numberValueSet));

        ChartInteractionEvent le = ChartInteractionEvent.Series(
            ChartEventType.LegendSelected, 77, 2, "Revenue");
        le.selected = true;
        Console.WriteLine(le.TypeName() + ":" + Convert.ToString(le.seriesIndex)
            + ":" + le.seriesName + ":" + Convert.ToString(le.selected));

        ChartInteractionEvent point = ChartInteractionEvent.DataPoint(
            ChartEventType.Hover, 77, 1, "CPU", 4, "A4",
            ChartElementType.LinePoint);
        point.value = 25;
        point.numberValueSet = true;
        point.numberValue = 25.5;
        Console.WriteLine(point.TypeName() + ":"
            + ChartInteractionEvent.ElementName(point.elementType) + ":"
            + Convert.ToString(point.dataHit) + ":"
            + Convert.ToString(point.dataIndex) + ":"
            + point.dataName + ":" + Convert.ToString(point.numberValueSet));

        ChartOption o = ChartOption.Of("Live", new List<string>{"A"},
            new List<ChartSeries>{ChartSeries.Line("CPU", new List<int>{10})});
        ChartController c = ChartController.Of(o);
        c.OnClick(Program.OnClick)
            .OnLegendSelected(Program.OnLegend)
            .OnDataChanged(Program.OnData)
            .OnRestore(Program.OnRestore);
        c.RaiseEvent(clickEvent);
        c.RaiseEvent(le);
        c.SetData(0, new List<ChartData>{ChartData.Of(20)});
        c.AppendValues(0, new List<int>{30});
        c.Restore();
        Console.WriteLine(log);
        Console.WriteLine(Convert.ToString(clicks) + ":" + Convert.ToString(legends)
            + ":" + Convert.ToString(dataChanges) + ":" + Convert.ToString(restores));

        c.Off(ChartEventType.Click, Program.OnClick);
        c.ClearEvents();
        c.RaiseEvent(clickEvent);
        c.SetData(0, new List<ChartData>{ChartData.Of(9)});
        Console.WriteLine(Convert.ToString(clicks) + ":" + Convert.ToString(dataChanges)
            + ":" + Convert.ToString(c.Version()));

        c.Dispose();
        c.RaiseEvent(clickEvent);
        Console.WriteLine(Convert.ToString(c.IsDisposed()) + ":" + Convert.ToString(clicks));
    }
}
