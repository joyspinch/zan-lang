using System;

class Program {
    static void Require(bool ok, string name) {
        if (!ok) { throw new Exception(name); }
    }

    static nint Decode(byte[] bytes) {
        nint value = 0;
        nint scale = 1;
        for (int k = 0; k < 8; k = k + 1) {
            value = value + (bytes[k] & 255) * scale;
            scale = scale * 256;
        }
        return value;
    }

    static void Check(nint wide, int small, long longer, bool choose) {
        Require(small * wide == 8589934592L, "int * nint");
        Require(wide * small == 8589934592L, "nint * int");
        Require(small + wide == 4294967298L, "int + nint");
        Require(wide + small == 4294967298L, "nint + int");
        Require(small - wide == -4294967294L, "int - nint");
        Require(wide - small == 4294967294L, "nint - int");
        Require(small < wide && wide > small, "mixed comparison");
        Require(small > -wide && -wide < small, "signed comparison");
        Require((small + wide) > wide && (wide + small) > wide, "nested comparison");
        Require((small * wide) / wide == small, "nested native width");
        Require(longer + wide == 8589934593L && wide + longer == 8589934593L, "long + nint");
        Require(longer - wide == 1 && wide - longer == -1, "long - nint");
        Require(longer * small == 8589934594L, "long multiplication control");
        var left = choose ? small : wide;
        var right = choose ? wide : small;
        Require(left == (choose ? 2L : 4294967296L), "conditional int/nint");
        Require(right == (choose ? 4294967296L : 2L), "conditional nint/int");
        Require(left + right == 4294967298L, "conditional result width");
    }

    static void Main() {
        Check(4294967296L, 2, 4294967297L, true);
        Check(4294967296L, 2, 4294967297L, false);
        byte[] bytes = new byte[8];
        bytes[4] = 1;
        Require(Decode(bytes) == 4294967296L, "pointer high byte");
        bytes[0] = 128;
        bytes[3] = 207;
        bytes[4] = 255;
        bytes[5] = 127;
        Require(Decode(bytes) == 140736666271872L, "pointer low sign bit");
        Console.WriteLine("PASS nint_mixed_arithmetic");
    }
}
