using System;
using System.Collections.Generic;
using System.Windows;

namespace Conf;

class DesktopCompanionBondAuditPacerTest {
    static void Main() {
        // 1. 好感度羁绊等级树：每日经验上限、跨日刷新、连升多级与里程碑解锁
        CompanionAffectionBondTree bond = new CompanionAffectionBondTree(100, 250, 1);
        bond.RegisterMilestone(2, "wave_anim");
        bond.RegisterMilestone(4, "secret_voice");

        int g1 = bond.GrantBondXp(200, 1); // Lv1 -> Lv3 (0 xp), today=200
        int g2 = bond.GrantBondXp(100, 1); // 仅剩 50 -> Lv3 (50 xp), today=250
        int g3 = bond.GrantBondXp(50, 1);  // 已达日上限 -> 0
        bool midUnlockOk = bond.IsMilestoneUnlocked("wave_anim") && !bond.IsMilestoneUnlocked("secret_voice");
        int g4 = bond.GrantBondXp(100, 2); // 次日刷新 -> Lv4 (50 xp) -> 解锁 secret_voice

        bool bondOk = g1 == 200 && g2 == 50 && g3 == 0 && g4 == 100
            && midUnlockOk && bond.Level == 4 && bond.IsMilestoneUnlocked("secret_voice");
        Console.WriteLine("companion-affection-bond-tree: " + Convert.ToString(bondOk ? 1 : 0));

        // 2. 定长环形审计日志：容量上限自动覆盖旧记录、类别筛选与最新条目查询
        CompanionRingEventLog log = new CompanionRingEventLog(3);
        log.Append(100L, "pet", "headpat");
        log.Append(200L, "alarm", "water");
        log.Append(300L, "pet", "feed");
        log.Append(400L, "theme", "night"); // 淘汰最旧的 100L

        List<CompanionAuditEntry> petEntries = log.QueryByCategory("pet");
        CompanionAuditEntry latest = log.Latest();
        bool logOk = log.Count() == 3
            && petEntries.Count == 1 && petEntries[0].Detail == "feed"
            && latest != null && latest.TimestampMs == 400L && latest.Category == "theme";
        Console.WriteLine("companion-ring-event-log: " + Convert.ToString(logOk ? 1 : 0));

        // 3. 低耗电自适应帧率调度器：60/30/12/2 FPS 分级降频与帧间隔校验
        CompanionAdaptiveFramePacer pacer = new CompanionAdaptiveFramePacer(15, 120);
        PowerPacingMode mActive = pacer.ResolveMode(false, true, false, 0);   // Active60
        PowerPacingMode mBatAct = pacer.ResolveMode(false, true, true, 0);    // Normal30
        PowerPacingMode mIdle = pacer.ResolveMode(false, false, false, 20);   // EcoIdle12
        PowerPacingMode mOccl = pacer.ResolveMode(true, true, false, 0);      // Hibernated2

        bool pacerOk = mActive == PowerPacingMode.Active60 && pacer.TargetFps(mActive) == 60
            && mBatAct == PowerPacingMode.Normal30 && pacer.TargetFps(mBatAct) == 30
            && mIdle == PowerPacingMode.EcoIdle12 && pacer.TargetFps(mIdle) == 12
            && mOccl == PowerPacingMode.Hibernated2 && pacer.FrameIntervalMs(mOccl) == 500;
        Console.WriteLine("companion-adaptive-frame-pacer: " + Convert.ToString(pacerOk ? 1 : 0));
    }
}
