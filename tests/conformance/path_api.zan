using System;
using System.IO;

/* Path in pure Zan: irgen used to lower these calls itself, so the stdlib
 * implementation was unreachable and its bugs unfixable. */
class Program {
    static void Show(string s) { Console.WriteLine("[" + s + "]"); }

    static void Main() {
        Program.Show(Path.GetFileName("a/b/c.txt"));
        Program.Show(Path.GetFileName("a\\b\\c.txt"));
        Program.Show(Path.GetFileName("c.txt"));
        Program.Show(Path.GetExtension("a/b/c.txt"));
        Program.Show(Path.GetExtension("a/b/c"));
        Program.Show(Path.GetDirectoryName("a/b/c.txt"));
        Program.Show(Path.GetDirectoryName("c.txt"));
        Program.Show(Path.GetFileNameWithoutExtension("a/b/c.txt"));
        Program.Show(Path.GetFileNameWithoutExtension("c"));
        Program.Show(Path.ChangeExtension("a/b/c.txt", ".md"));
        Program.Show(Path.ChangeExtension("a/b/c", ".md"));
        Console.WriteLine(Path.HasExtension("a/b/c.txt"));
        Console.WriteLine(Path.HasExtension("a/b/c"));
        Console.WriteLine(Path.GetFileName("a/b/c.zan").ToUpper());
        Console.WriteLine(Path.Combine("a", "b").Length);
    }
}
