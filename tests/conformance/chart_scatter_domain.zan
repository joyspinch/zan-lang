using System;
using Gui.Component.Chart;

namespace Conf;

/// 散点图自动值域：可见系列、隐藏系列和 dataZoom 窗口共用同一纯 seam。
class Program {
    static void Main() {
        ChartSeries visible = ChartSeries.OfPoints("V", new List<ChartPoint>{
            ChartPoint.Of(-42, -7), ChartPoint.Of(0, 20), ChartPoint.Of(40, 130) });
        ChartSeries hidden = ChartSeries.OfPoints("H", new List<ChartPoint>{
            ChartPoint.Of(-900, -900), ChartPoint.Of(900, 900) });
        hidden.hidden = true;
        List<ChartSeries> series = new List<ChartSeries>{visible, hidden};
        int minX = 0; int maxX = 0; int minY = 0; int maxY = 0;
        int fMnX = 0; int fMxX = 0; int fMnY = 0; int fMxY = 0;
        ChartView.ScatterSpan(series, 0, 2, out minX, out maxX, out minY, out maxY,
            out fMnX, out fMxX, out fMnY, out fMxY);
        Console.WriteLine("raw:" + Convert.ToString(minX) + ":" + Convert.ToString(maxX)
            + ":" + Convert.ToString(minY) + ":" + Convert.ToString(maxY));
        Console.WriteLine("axis:" + Convert.ToString(Chart.NiceMin(minX)) + ":"
            + Convert.ToString(Chart.NiceMax(maxX)) + ":"
            + Convert.ToString(Chart.NiceMin(minY)) + ":"
            + Convert.ToString(Chart.NiceMax(maxY)));

        ChartView.ScatterSpan(series, 1, 1, out minX, out maxX, out minY, out maxY,
            out fMnX, out fMxX, out fMnY, out fMxY);
        Console.WriteLine("window:" + Convert.ToString(minX) + ":" + Convert.ToString(maxX)
            + ":" + Convert.ToString(minY) + ":" + Convert.ToString(maxY));

        ChartSeries onlyHidden = ChartSeries.OfPoints("X",
            new List<ChartPoint>{ChartPoint.Of(-1, -2)});
        onlyHidden.hidden = true;
        ChartView.ScatterSpan(new List<ChartSeries>{onlyHidden}, 0, 3,
            out minX, out maxX, out minY, out maxY,
            out fMnX, out fMxX, out fMnY, out fMxY);
        Console.WriteLine("zero:" + Convert.ToString(minX) + ":" + Convert.ToString(maxX)
            + ":" + Convert.ToString(minY) + ":" + Convert.ToString(maxY));

        // —— B18：小数（×1000 定点）域管线 ——
        // JSON 值对以 ×1000 定点入库（pointG=1000）。x 小数、y 整数，
        // 两根轴各走各的管线：fracX 走 NiceRange(F)，fracY 走整数路。
        ChartOption o1 = ChartOption.FromJson(
            "{\"xAxis\":{},\"yAxis\":{},\"series\":[{\"type\":\"scatter\","
            + "\"data\":[[0.03,3],[0.5,4],[0.99,4]]}]}");
        Console.WriteLine("fracX:" + Convert.ToString(Chart.ScatterAxisFrac(o1.series, true) ? 1 : 0));
        Console.WriteLine("fracY:" + Convert.ToString(Chart.ScatterAxisFrac(o1.series, false) ? 1 : 0));
        ChartView.ScatterSpan(o1.series, 0, 2, out minX, out maxX, out minY, out maxY,
            out fMnX, out fMxX, out fMnY, out fMxY);
        Console.WriteLine("fext:" + Convert.ToString(fMnX) + ":" + Convert.ToString(fMxX)
            + ":" + Convert.ToString(fMnY) + ":" + Convert.ToString(fMxY));
        ChartSpan xr = ChartView.ScatterRangeX(o1, o1.series, 0, 2);
        Console.WriteLine("xr:" + Convert.ToString(xr.lo) + ":" + Convert.ToString(xr.hi)
            + ":" + Convert.ToString(xr.ticks));
        ChartSpan yr = ChartView.ScatterRangeY(o1, o1.series, 0, 2);
        Console.WriteLine("yr:" + Convert.ToString(yr.lo) + ":" + Convert.ToString(yr.hi)
            + ":" + Convert.ToString(yr.ticks));
        ChartOption o2 = ChartOption.FromJson(
            "{\"xAxis\":{\"min\":0.5,\"max\":1},\"yAxis\":{},\"series\":[{\"type\":\"scatter\","
            + "\"data\":[[0.55,3],[0.9,4]]}]}");
        ChartSpan xr2 = ChartView.ScatterRangeX(o2, o2.series, 0, 1);
        Console.WriteLine("xr2:" + Convert.ToString(xr2.lo) + ":" + Convert.ToString(xr2.hi)
            + ":" + Convert.ToString(xr2.ticks));
        Console.WriteLine("ftext:" + Chart.FracText(200));

        // 单侧声明端必须精确（不参与 nice 取整）：官方
        // scatter-polynomial-regression yAxis.min=-40 保持 -40，
        // 自动端仍走包络。
        ChartOption o3 = ChartOption.FromJson(
            "{\"xAxis\":{},\"yAxis\":{\"min\":-40},\"series\":[{\"type\":\"scatter\",\"data\":[[0.03,-0.5],[0.5,-0.2]]}]}");
        ChartSpan yr3 = ChartView.ScatterRangeY(o3, o3.series, 0, 1);
        Console.WriteLine("pin:" + Convert.ToString(yr3.lo) + ":"
            + Convert.ToString(yr3.hi) + ":" + Convert.ToString(yr3.ticks));
    }
}
