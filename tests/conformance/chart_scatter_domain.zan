using System;
using Gui.Component.Chart;

namespace Conf;

/// 散点图自动值域：可见系列、隐藏系列和 dataZoom 窗口共用同一纯 seam。
class Program {
    static void Main() {
        ChartSeries visible = ChartSeries.OfPoints("V", new List<ChartPoint>{
            ChartPoint.Of(-42, -7), ChartPoint.Of(0, 20), ChartPoint.Of(40, 130) });
        ChartSeries hidden = ChartSeries.OfPoints("H", new List<ChartPoint>{
            ChartPoint.Of(-900, -900), ChartPoint.Of(900, 900) });
        hidden.hidden = true;
        List<ChartSeries> series = new List<ChartSeries>{visible, hidden};
        int minX = 0; int maxX = 0; int minY = 0; int maxY = 0;
        ChartView.ScatterSpan(series, 0, 2, out minX, out maxX, out minY, out maxY);
        Console.WriteLine("raw:" + Convert.ToString(minX) + ":" + Convert.ToString(maxX)
            + ":" + Convert.ToString(minY) + ":" + Convert.ToString(maxY));
        Console.WriteLine("axis:" + Convert.ToString(Chart.NiceMin(minX)) + ":"
            + Convert.ToString(Chart.NiceMax(maxX)) + ":"
            + Convert.ToString(Chart.NiceMin(minY)) + ":"
            + Convert.ToString(Chart.NiceMax(maxY)));

        ChartView.ScatterSpan(series, 1, 1, out minX, out maxX, out minY, out maxY);
        Console.WriteLine("window:" + Convert.ToString(minX) + ":" + Convert.ToString(maxX)
            + ":" + Convert.ToString(minY) + ":" + Convert.ToString(maxY));

        ChartSeries onlyHidden = ChartSeries.OfPoints("X",
            new List<ChartPoint>{ChartPoint.Of(-1, -2)});
        onlyHidden.hidden = true;
        ChartView.ScatterSpan(new List<ChartSeries>{onlyHidden}, 0, 3,
            out minX, out maxX, out minY, out maxY);
        Console.WriteLine("zero:" + Convert.ToString(minX) + ":" + Convert.ToString(maxX)
            + ":" + Convert.ToString(minY) + ":" + Convert.ToString(maxY));
    }
}
