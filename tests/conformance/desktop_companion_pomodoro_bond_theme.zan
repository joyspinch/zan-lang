using System;
using System.Windows;

class Program {
    static int Main() {
        // 1. 番茄钟 4 轮/2 轮长短休自动流转与暂停
        CompanionPomodoroCycleEngine pomo = new CompanionPomodoroCycleEngine(25, 5, 15, 2);
        pomo.TogglePause();
        pomo.StepSeconds(600);
        bool pauseFrozen = pomo.RemainingSeconds == 1500 && pomo.Phase == PomodoroCycleStage.Focus;
        pomo.TogglePause();

        // 完成第 1 轮专注 -> 短休 5 分钟
        pomo.StepSeconds(1500);
        bool shortBreakOk = pomo.Phase == PomodoroCycleStage.ShortBreak && pomo.RemainingSeconds == 300
            && pomo.CompletedFocusCycles == 1 && pomo.TotalFocusMinutes == 25;

        // 完成短休 + 第 2 轮专注 -> 进入大休 15 分钟
        pomo.StepSeconds(300 + 1500);
        bool longBreakOk = pomo.Phase == PomodoroCycleStage.LongBreak && pomo.RemainingSeconds == 900
            && pomo.CompletedFocusCycles == 2 && pomo.TotalFocusMinutes == 50;
        Console.WriteLine("pomodoro_engine_ok=" + ((pauseFrozen && shortBreakOk && longBreakOk) ? "1" : "0"));

        // 2. 桌宠亲密度羁绊与抚摸冷却防刷
        CompanionPetAffectionBond pet = new CompanionPetAffectionBond(30000L);
        bool p1 = pet.TryPat(1000L);
        bool spamBlocked = !pet.TryPat(10000L); // 冷却内拒绝
        bool p2 = pet.TryPat(35000L); // 累计 50 XP -> Buddy
        bool buddyOk = pet.CurrentTier() == PetBondTier.Buddy && pet.MoodPercent == 80;
        pet.FeedTreat(50, 260); // 心情封顶 100，XP 310 -> Soulmate
        bool soulmateOk = pet.CurrentTier() == PetBondTier.Soulmate && pet.MoodPercent == 100;
        Console.WriteLine("pet_bond_ok=" + ((p1 && spamBlocked && p2 && buddyOk && soulmateOk) ? "1" : "0"));

        // 3. 昼夜节律自动配色路由与手动锁定覆盖
        CompanionCircadianThemeRouter router = new CompanionCircadianThemeRouter();
        bool autoOk = router.ResolveForHour(7) == CircadianThemeMode.Dawn
            && router.ResolveForHour(13) == CircadianThemeMode.Daylight
            && router.ResolveForHour(19) == CircadianThemeMode.Sunset
            && router.ResolveForHour(2) == CircadianThemeMode.Midnight;
        router.PinTheme(CircadianThemeMode.Midnight);
        bool pinOk = router.ResolveForHour(12) == CircadianThemeMode.Midnight;
        router.ResumeAuto();
        bool resumeOk = router.ResolveForHour(12) == CircadianThemeMode.Daylight;
        Console.WriteLine("circadian_theme_ok=" + ((autoOk && pinOk && resumeOk) ? "1" : "0"));
        return 0;
    }
}
