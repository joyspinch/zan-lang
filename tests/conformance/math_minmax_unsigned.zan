using System;

class MathMinMaxUnsigned {
    static string Pick(uint value) { return "uint"; }
    static string Pick(ulong value) { return "ulong"; }
    static string Pick(long value) { return "long"; }
    static string Pick(nint value) { return "nint"; }
    static uint ReturnUInt(uint a, uint b) { return Math.Max(a, b); }
    static ulong ReturnULong(ulong a, ulong b) { return Math.Min(a, b); }
    static nint ReturnNative(nint a, int b) { return Math.Min(a, b); }

    static void Main() {
        uint uhigh = 4294967295U;
        uint ulow = 2147483648U;
        uint umin = Math.Min(uhigh, ulow);
        uint umax = Math.Max(ulow, uhigh);
        if (umin != ulow || umax != uhigh || ReturnUInt(uhigh, ulow) != uhigh ||
            Math.Max(4294967295U, 1U) != uhigh ||
            Math.Min(4294967295U, 1U) != 1U) {
            throw new Exception("uint high bit");
        }
        Console.WriteLine("uint high bit ok");
        Console.WriteLine("uint variable " + Pick(Math.Max(uhigh, ulow)));
        Console.WriteLine("uint literal " + Pick(Math.Min(4294967295U, 1U)));
        var inferredUInt = Math.Min(uhigh, ulow);
        Console.WriteLine("uint inferred " + Pick(inferredUInt));

        ulong high = 18446744073709551615UL;
        ulong low = 9223372036854775809UL;
        ulong minimum = Math.Min(high, low);
        ulong maximum = Math.Max(low, high);
        if (minimum != low || maximum != high || ReturnULong(high, low) != low ||
            Math.Max(18446744073709551615UL, 1UL) != high ||
            Math.Min(18446744073709551615UL, 1UL) != 1UL ||
            Math.Min(high, uhigh) != (ulong)uhigh ||
            Math.Max(uhigh, high) != high) {
            throw new Exception("ulong high bit precision");
        }
        Console.WriteLine("ulong high bit precision ok");
        Console.WriteLine("ulong variable " + Pick(Math.Max(low, high)));
        Console.WriteLine("ulong literal " + Pick(Math.Min(18446744073709551615UL, 1UL)));
        Console.WriteLine("ulong uint " + Pick(Math.Max(uhigh, high)));
        var inferredULong = Math.Max(low, high);
        Console.WriteLine("ulong inferred " + Pick(inferredULong));
        Console.WriteLine("ulong nested " + Pick(Math.Min(Math.Max(low, high), low)));

        int negative = -1;
        long signedMin = Math.Min(uhigh, negative);
        long signedMax = Math.Max(negative, uhigh);
        if (signedMin != -1L || signedMax != 4294967295L) {
            throw new Exception("uint int widening");
        }
        Console.WriteLine("uint int widening ok");
        Console.WriteLine("uint int type " + Pick(Math.Max(negative, uhigh)));
        double floating = Math.Max(high, 0.0);
        if (floating != 18446744073709551616.0) {
            throw new Exception("ulong double conversion");
        }
        Console.WriteLine("ulong double conversion ok");

        byte byteHigh = (byte)255;
        ushort shortHigh = (ushort)65535;
        char charHigh = (char)65535;
        if (Math.Max(byteHigh, 0.0f) != 255.0 || Math.Min(300.0, byteHigh) != 255.0 ||
            Math.Max(shortHigh, 0.0) != 65535.0 || Math.Min(70000.0f, shortHigh) != 65535.0 ||
            Math.Max(charHigh, 0.0f) != 65535.0 || Math.Min(70000.0, charHigh) != 65535.0) {
            throw new Exception("small unsigned floating conversion");
        }

        nint native = (nint)(-7);
        nint nativeResult = ReturnNative(native, negative);
        if (nativeResult != native) { throw new Exception("nint signed comparison"); }
        Console.WriteLine("nint signed comparison ok");
        Console.WriteLine("nint type " + Pick(Math.Min(native, negative)));
    }
}
