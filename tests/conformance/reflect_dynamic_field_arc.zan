using System;

class ReflectFieldArcPayload {
    public ReflectFieldArcPayload Child;
}

class ReflectFieldArcTarget {
    public string Text;
    public object Value;
}

class ReflectDynamicFieldArc {
    static bool StoreText(object receiver, string name, string prefix) {
        return receiver.SetFieldString(name, prefix + "-value");
    }

    static void CheckString(ReflectFieldArcTarget target, object receiver, string name) {
        bool initial = StoreText(receiver, name, "first");
        bool self = receiver.SetFieldString(name, target.Text);
        Console.WriteLine("string-self=" + (initial && self && target.Text == "first-value"));
        bool replaced = StoreText(receiver, name, "second");
        Console.WriteLine("string-replace=" + (replaced && target.Text == "second-value"));
        bool cleared = receiver.SetFieldString(name, null);
        Console.WriteLine("string-clear=" + (cleared && target.Text == null));
    }

    static void CheckObject(ReflectFieldArcTarget target, object receiver, string name) {
        ReflectFieldArcPayload first = new ReflectFieldArcPayload();
        first.Child = new ReflectFieldArcPayload();
        ReflectFieldArcPayload next = new ReflectFieldArcPayload();
        WeakReference<ReflectFieldArcPayload> firstWatch = new WeakReference<ReflectFieldArcPayload>(first);
        WeakReference<ReflectFieldArcPayload> childWatch = new WeakReference<ReflectFieldArcPayload>(first.Child);
        WeakReference<ReflectFieldArcPayload> nextWatch = new WeakReference<ReflectFieldArcPayload>(next);

        bool initial = receiver.SetFieldObject(name, first);
        first = null;
        bool self = receiver.SetFieldObject(name, target.Value);
        Console.WriteLine("object-self=" + (initial && self && firstWatch.IsAlive && childWatch.IsAlive));
        bool replaced = receiver.SetFieldObject(name, next);
        next = null;
        Console.WriteLine("object-replace=" + (replaced && !firstWatch.IsAlive && !childWatch.IsAlive && nextWatch.IsAlive));
        bool cleared = receiver.SetFieldObject(name, null);
        Console.WriteLine("object-clear=" + (cleared && !nextWatch.IsAlive && target.Value == null));
    }

    static void Main() {
        ReflectFieldArcTarget target = new ReflectFieldArcTarget();
        object receiver = target;
        CheckString(target, receiver, "Text");
        CheckObject(target, receiver, "Value");

        string missingName = "Missing";
        Console.WriteLine("missing=" + !receiver.SetFieldString(missingName, null));
    }
}
