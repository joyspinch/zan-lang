// Conformance: a Dictionary handed out of the method that built it keeps its
// keys and values alive. A dict used to be header-less, so the builder's scope
// exit released every occupant while the caller still held them (keys read back
// as freed memory, then heap corruption); it now carries an rc header and is
// owned like List/StringBuilder.
using System;
using System.Text;

class Program {
    static Dictionary<string, string> ParseQuery(string body) {
        Dictionary<string, string> f = new Dictionary<string, string>();
        List<string> pairs = body.Split("&");
        int i = 0;
        while (i < pairs.Count) {
            string p = pairs[i];
            int eq = p.IndexOf("=");
            if (eq > 0) {
                string k = Encoding.UrlDecode(p.Substring(0, eq));
                string v = Encoding.UrlDecode(p.Substring(eq + 1));
                if (!f.ContainsKey(k)) { f.Add(k, v); }
            }
            i = i + 1;
        }
        return f;
    }

    static Dictionary<string, List<string>> BuildLists() {
        Dictionary<string, List<string>> d = new Dictionary<string, List<string>>();
        List<string> a = new List<string>();
        a.Add("x");
        a.Add("y");
        d.Add("first", a);
        return d;
    }

    static void Main() {
        Dictionary<string, string> q =
            ParseQuery("name=a%20b&method=get.thing&token=t-1&plus=a+b");
        List<string> ks = q.Keys;
        int i = 0;
        while (i < ks.Count) {
            Console.WriteLine(ks[i] + "=" + q[ks[i]]);
            i = i + 1;
        }

        Dictionary<string, List<string>> lists = BuildLists();
        List<string> got = lists["first"];
        Console.WriteLine("list=" + got[0] + got[1] + " n=" + Convert.ToString(got.Count));
    }
}
