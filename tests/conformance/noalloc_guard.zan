using System;
using System.Runtime.InteropServices;

[StructLayout(LayoutKind.Sequential, Pack = 1)]
public struct Pixel4 {
    public byte R;
    public byte G;
    public byte B;
    public byte A;
}

public class HotKernel {
    [NoAlloc]
    public static int RunNoEscape(int x, noescape Func<int, int> fn) {
        return fn(x);
    }

    [NoAlloc]
    public static int ProcessTile(Span<int> data) {
        // Allowed in [NoAlloc]: stackalloc, value struct new, InlineArray, BitCast, ZeroInit, noescape lambda
        Span<int> scratch = stackalloc int[4];
        Pixel4 px = new Pixel4();
        px.R = 1;
        px.G = 2;
        px.B = 3;
        px.A = 4;
        uint bits = NativeMemory.BitCast<Pixel4, uint>(px);
        NativeMemory.ZeroInit(ref px);

        int acc = 0;
        for (int i = 0; i < data.Length; i++) {
            scratch[i & 3] = scratch[i & 3] + data[i];
            acc = acc + RunNoEscape(data[i], v => v * 2);
        }
        return acc + scratch[0] + scratch[1] + (bits == 0x04030201u ? 1 : 0) + (int)px.R;
    }
}

public class Program {
    public static void Main() {
        int[] buf = new int[4];
        buf[0] = 5;
        buf[1] = 10;
        buf[2] = 15;
        buf[3] = 20;
        int r = HotKernel.ProcessTile(buf.AsSpan());
        Console.WriteLine($"noalloc={r}");
    }
}
