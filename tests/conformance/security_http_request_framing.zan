using System;
using System.Net.Http;

class Program {
    static int failures = 0;

    static void Check(string name, string wire, int status) {
        HttpRequest req = HttpRequest.Parse(wire);
        bool ok = req.parseStatus == status;
        Console.WriteLine((ok ? "ok " : "FAIL ") + name);
        if (!ok) { Program.failures = Program.failures + 1; }
    }

    static void Main() {
        string start = "POST /pay HTTP/1.1\r\nHost: example.test\r\n";
        Program.Check("ordinary content length", start
            + "Content-Length: 2\r\n\r\nok", 0);
        Program.Check("ordinary chunked", start
            + "Transfer-Encoding: chunked\r\n\r\n0\r\n\r\n", 0);
        Program.Check("empty content length", start
            + "Content-Length: \r\n\r\n", 400);
        Program.Check("duplicate transfer encoding", start
            + "Transfer-Encoding: chunked\r\nTransfer-Encoding: chunked\r\n\r\n", 501);
        Program.Check("duplicate chunked list", start
            + "Transfer-Encoding: chunked, chunked\r\n\r\n", 501);
        Program.Check("unknown encoding before chunked", start
            + "Transfer-Encoding: gzip, chunked\r\n\r\n", 501);
        Program.Check("transfer encoding with content length", start
            + "Transfer-Encoding: chunked\r\nContent-Length: 0\r\n\r\n", 400);
        Program.Check("line feed only", "GET / HTTP/1.1\nHost: example.test\n\n", 400);
        Program.Check("line feed in header", "GET / HTTP/1.1\r\nHost: example.test\n\r\n", 400);
        Program.Check("bare carriage return in header", start
            + "X-Test: yes\rno\r\n\r\n", 400);
        Program.Check("missing host", "GET / HTTP/1.1\r\n\r\n", 400);
        Program.Check("duplicate host", start + "Host: other.test\r\n\r\n", 400);
        Program.Check("empty host", "GET / HTTP/1.1\r\nHost: \r\n\r\n", 400);
        Program.Check("unknown version", "GET / HTTP/9.9\r\nHost: example.test\r\n\r\n", 400);
        Program.Check("embedded nul in target", "GET /\0x HTTP/1.1\r\nHost: example.test\r\n\r\n", 400);
        Program.Check("embedded nul in header", start + "X-Test: a\0b\r\n\r\n", 400);
        Program.Check("invalid header field name", start + "X(Thing): yes\r\n\r\n", 400);
        Program.Check("incomplete headers", "GET / HTTP/1.1\r\nHost: example.test\r\n", 400);
        Program.Check("http 1.0 without host", "GET / HTTP/1.0\r\n\r\n", 0);
        Console.WriteLine("failures=" + Convert.ToString(Program.failures));
    }
}
