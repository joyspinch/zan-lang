using System;

class A {
    public int v;
    public double d;
    public A() { v = 5; d = 1.5; }
    public int Get() { return this.v + 1; }
}

class Program {
    static int Main() {
        A a = null;
        A b = new A();
        int? f = a?.v;
        int? m = a?.Get();
        int? g = b?.v;
        int? h = b?.Get();
        double? e = a?.d;
        Console.WriteLine("f=" + Convert.ToString(f.HasValue));
        Console.WriteLine("m=" + Convert.ToString(m.HasValue));
        Console.WriteLine("e=" + Convert.ToString(e.HasValue));
        Console.WriteLine("g=" + Convert.ToString(g.HasValue) + "," + Convert.ToString(g.Value));
        Console.WriteLine("h=" + Convert.ToString(h.HasValue) + "," + Convert.ToString(h.Value));
        Console.WriteLine("dflt=" + Convert.ToString(f.GetValueOrDefault()));
        return 0;
    }
}
