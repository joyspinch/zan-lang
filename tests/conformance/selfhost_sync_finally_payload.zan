using System;

class Program {
    static void HandleNested() {
        try {
            throw new ArgumentException("handled inside finally");
        } catch (ArgumentException ex) {
            Console.WriteLine(ex.Message);
        }
    }

    static void DirectThrow() {
        try {
            InvalidOperationException original = new InvalidOperationException("original local");
            throw original;
        } finally {
            // Keep the nested handler in this frame, where it can reuse the
            // exception dispatch state of the interrupted throw.
            try {
                throw new ArgumentException("handled inside direct finally");
            } catch (ArgumentException ex) {
                Console.WriteLine(ex.Message);
            }
        }
    }

    static void BareRethrow() {
        try {
            throw new InvalidOperationException("original rethrow");
        } catch (InvalidOperationException ex) {
            throw;
        } finally {
            HandleNested();
        }
    }

    static void UnmatchedThrow() {
        try {
            throw new InvalidOperationException("original unmatched");
        } catch (ArgumentException ex) {
            Console.WriteLine("wrong inner handler");
        } finally {
            HandleNested();
        }
    }

    static void ReplacedThrow() {
        try {
            throw new InvalidOperationException("superseded");
        } finally {
            throw new ArgumentException("replacement escaped finally");
        }
    }

    static void Main() {
        try { DirectThrow(); }
        catch (InvalidOperationException ex) { Console.WriteLine(ex.Message); }
        catch (ArgumentException) { Console.WriteLine("wrong outer handler"); }

        try { BareRethrow(); }
        catch (InvalidOperationException ex) { Console.WriteLine(ex.Message); }
        catch (ArgumentException) { Console.WriteLine("wrong outer handler"); }

        try { UnmatchedThrow(); }
        catch (InvalidOperationException ex) { Console.WriteLine(ex.Message); }
        catch (ArgumentException) { Console.WriteLine("wrong outer handler"); }

        try { ReplacedThrow(); }
        catch (InvalidOperationException ex) { Console.WriteLine("wrong original handler"); }
        catch (ArgumentException ex) { Console.WriteLine(ex.Message); }
    }
}
