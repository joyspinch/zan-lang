using System;
using System.Threading;
using System.Resilience;

namespace Conf;

class Prog {
    static async Task<int> Run() {
        // 1. 验证重试策略退避计算与上限钳制
        RetryStrategy retry = new RetryStrategy(4, 50, 300, 2.0);
        Console.WriteLine("retry-attempt-1: " + Convert.ToString(retry.ComputeDelayMs(1))); // 50
        Console.WriteLine("retry-attempt-2: " + Convert.ToString(retry.ComputeDelayMs(2))); // 100
        Console.WriteLine("retry-attempt-3: " + Convert.ToString(retry.ComputeDelayMs(3))); // 200
        Console.WriteLine("retry-attempt-4: " + Convert.ToString(retry.ComputeDelayMs(4))); // 300 (capped at maxDelayMs)
        Console.WriteLine("retry-attempt-5: " + Convert.ToString(retry.ComputeDelayMs(5))); // 300 (capped)

        // 2. 验证熔断器状态机与故障自愈
        CircuitBreaker cb = new CircuitBreaker(3, 100, 2); // 3次错误熔断，静默100ms，半开成功2次自愈
        Console.WriteLine("cb-init-state: " + Convert.ToString((int)cb.State())); // Closed (0)
        Console.WriteLine("cb-init-can-exec: " + Convert.ToString(cb.CanExecute() ? 1 : 0)); // 1

        // 连续 2 次错误，未达阈值
        cb.RecordFailure();
        cb.RecordFailure();
        Console.WriteLine("cb-below-thresh-state: " + Convert.ToString((int)cb.State())); // Closed (0)

        // 第 3 次错误，触发熔断
        cb.RecordFailure();
        Console.WriteLine("cb-tripped-state: " + Convert.ToString((int)cb.State())); // Open (1)
        Console.WriteLine("cb-open-can-exec: " + Convert.ToString(cb.CanExecute() ? 1 : 0)); // 0 (fast-fail)

        // 等待静默期结束
        await Task.Delay(130);

        // 静默期过后，状态转为半开探测
        Console.WriteLine("cb-half-open-state: " + Convert.ToString((int)cb.State())); // HalfOpen (2)
        Console.WriteLine("cb-half-open-can-exec: " + Convert.ToString(cb.CanExecute() ? 1 : 0)); // 1

        // 第 1 次探测成功，仍处于半开
        cb.RecordSuccess();
        Console.WriteLine("cb-probe1-state: " + Convert.ToString((int)cb.State())); // HalfOpen (2)

        // 第 2 次探测成功，自愈恢复 Closed
        cb.RecordSuccess();
        Console.WriteLine("cb-healed-state: " + Convert.ToString((int)cb.State())); // Closed (0)
        Console.WriteLine("cb-healed-can-exec: " + Convert.ToString(cb.CanExecute() ? 1 : 0)); // 1

        // 3. 验证令牌桶限流器
        TokenBucketRateLimiter limiter = new TokenBucketRateLimiter(5, 50); // 容量5，每秒填充50个令牌
        Console.WriteLine("limiter-cap: " + Convert.ToString(limiter.Capacity()));

        // 突发消费 5 个令牌：全部成功
        bool all5 = true;
        for (int i = 0; i < 5; i = i + 1) {
            if (!limiter.TryAcquire()) { all5 = false; }
        }
        Console.WriteLine("limiter-burst-ok: " + Convert.ToString(all5 ? 1 : 0));

        // 桶耗尽后立即获取：被限流拦截
        Console.WriteLine("limiter-exhausted-rejected: " + Convert.ToString(limiter.TryAcquire() ? 0 : 1));

        // 等待短暂时间累积令牌后再次获取
        await Task.Delay(50);
        Console.WriteLine("limiter-refilled-ok: " + Convert.ToString(limiter.TryAcquire() ? 1 : 0));

        Console.WriteLine("resilience-tests-done: 1");
        return 0;
    }

    static void Main() {
        int _r = await Run();
    }
}
