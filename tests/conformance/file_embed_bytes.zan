// 内嵌二进制读回：GetSize / ReadAllBytes 对「盘上没有、--embed 烤进
// exe」的资源必须与 File.Exists 的内嵌兜底同口径 —— 单文件发布里
// 照片只存在于镜像中，没有可打开的文件句柄。回归背景：Upload 对
// 内嵌 jpeg 取 size，GetSize 只 fopen，抛 FileNotFoundException
// （Unhandled exception (class object)），单文件 gallery 启动即死。
using System;
using System.IO;

class Program {
    static void P(bool v) {
        if (v) { Console.WriteLine(1); } else { Console.WriteLine(0); }
    }

    static void Main() {
        // 盘上没这两个文件（工作区里它们只在 embed_assets/ 源目录，
        // 编进 exe 后以 "assets/..." 名注册，运行目录不存在）。
        string bin = "assets/blob.bin";
        string txt = "assets/note.txt";

        P(File.Exists(bin));
        P(File.GetSize(bin) == 25);
        P(File.Exists(txt));
        P(File.GetSize(txt) == 16);

        byte[] b = File.ReadAllBytes(bin);
        P(b.Length == 25);
        P(b[0] == 'Z' && b[1] == 'A' && b[2] == 'N');
        P(b[19] == 'T' && b[20] == 0x00 && b[21] == 0x01);
        P(b[22] == 0x02 && b[23] == 0xFF && b[24] == 0xFE);

        // 文本内嵌读回走 ReadAllText 的既有链路，一并复验。
        P(File.ReadAllText(txt) == "hello-embed-text");

        // 不存在的内嵌名仍抛 FileNotFoundException。
        bool threw = false;
        try {
            File.GetSize("assets/no_such_blob.bin");
        } catch (FileNotFoundException) {
            threw = true;
        }
        P(threw);
    }
}
