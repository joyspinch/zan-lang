using System;

enum Color { Red, Green }

struct Point { public int x; public int y; }

class Box {
    public int? level;
    public double? score;
}

class Program {
    static int? Half(int x) {
        if (x % 2 == 0) { return x / 2; }
        return null;
    }

    static int Pick(int? v) { return v ?? -1; }

    static void Main() {
        int? a = 5;
        int? b = null;

        Console.WriteLine(a.Value);
        Console.WriteLine(a.HasValue ? 1 : 0);
        Console.WriteLine(b.HasValue ? 1 : 0);
        Console.WriteLine(a ?? 7);
        Console.WriteLine(b ?? 7);

        if (b == null) { Console.WriteLine("b null"); }
        if (a != null) { Console.WriteLine("a set"); }

        int? c = a + 1;
        Console.WriteLine(c ?? -1);
        int? d = b + 1;
        Console.WriteLine(d == null ? "d null" : "d set");
        Console.WriteLine(b / 0 == null ? "div null" : "div set");

        Console.WriteLine(Pick(Half(10)));
        Console.WriteLine(Pick(Half(7)));

        b = 12;
        Console.WriteLine(b ?? -1);
        Console.WriteLine(b.GetValueOrDefault());
        int? f = null;
        Console.WriteLine(f.GetValueOrDefault());

        double? e = 1.5;
        Console.WriteLine(e ?? 0.0);

        Console.WriteLine("a=" + a);
        Console.WriteLine("f=" + f);
        Console.WriteLine(a);
        Console.WriteLine(f);

        int? g = 5;
        Console.WriteLine(a == g ? "eq" : "ne");
        Console.WriteLine(a == f ? "eq" : "ne");
        Console.WriteLine(f == f ? "eq" : "ne");
        Console.WriteLine(a > 3 ? "gt" : "ngt");
        Console.WriteLine(f > 3 ? "gt" : "ngt");

        Box box = new Box();
        Console.WriteLine(box.level == null ? "field null" : "field set");
        box.level = 3;
        Console.WriteLine(box.level ?? -1);
        box.level = null;
        Console.WriteLine(box.level ?? -1);
        box.score = 2.5;
        Console.WriteLine(box.score ?? 0.0);

        Color? col = Color.Green;
        Console.WriteLine(col.HasValue ? 1 : 0);
        Color? colNone = null;
        Console.WriteLine(colNone.HasValue ? 1 : 0);

        bool? flag = true;
        Console.WriteLine(flag.Value ? "yes" : "no");

        Point p;
        p.x = 1;
        p.y = 2;
        Point? pp = p;
        Console.WriteLine(pp.HasValue ? 1 : 0);
        Console.WriteLine(pp.Value.x + pp.Value.y);
        Point? pn = null;
        Console.WriteLine(pn.HasValue ? 1 : 0);

        long? big = 9000000000;
        Console.WriteLine(big ?? 0);
        int? small = 300;
        Console.WriteLine(small ?? 0);
    }
}
