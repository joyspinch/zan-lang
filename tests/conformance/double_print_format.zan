// A523 浮点打印格式与负零 (-0.0) 符号保持（对齐 C# .NET 8）
using System;

class Program {
    static void Main() {
        Console.WriteLine(0.1 + 0.2);
        Console.WriteLine(1.0);
        Console.WriteLine(1e-7);
        Console.WriteLine(1e20);
        Console.WriteLine(-0.0);
        double negzero = -0.0;
        Console.WriteLine(negzero.ToString());
        Console.WriteLine(0.0);
        double zero = 0.0;
        Console.WriteLine(zero.ToString());

        float f = 0.1f + 0.2f;
        Console.WriteLine(f);
        Console.WriteLine(f.ToString());
        Console.WriteLine("val=" + f);
        float fnz = -0.0f;
        Console.WriteLine(fnz);
        Console.WriteLine(fnz.ToString());
    }
}
