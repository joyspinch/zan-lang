// DirectoryWatcher test: create, modify, and delete a file in a scratch
// directory and verify each produces the right change event. The watcher
// polls every ~250 ms, so the test sleeps between actions.
using System;
using System.IO;
using System.Threading;

namespace Conf;

class Prog {
    static int added;
    static int removed;
    static int modified;
    static string modifiedName = "";

    static void OnChange(string name, int change) {
        if (change == FileChange.Added()) { added = added + 1; }
        else if (change == FileChange.Removed()) { removed = removed + 1; }
        else if (change == FileChange.Modified()) {
            modified = modified + 1;
            modifiedName = name;
        }
    }

    static void Main() {
        int bad = 0;
        string dir = Path.Combine(KnownFolders.Temp(),
            "zan_watch_" + Convert.ToString(ProcessList.SelfPid()));
        if (Directory.Exists(dir)) { Directory.Delete(dir); }
        Directory.CreateDirectory(dir);
        string file = Path.Combine(dir, "a.txt");
        File.WriteAllText(file, "one");

        if (!DirectoryWatcher.Watch(dir, Prog.OnChange)) { bad = bad + 1; }
        Thread.Sleep(400);   // let the first snapshot settle

        File.WriteAllText(file, "a longer second version");   // size changes
        Thread.Sleep(600);
        string second = Path.Combine(dir, "b.txt");
        File.WriteAllText(second, "hi");          // add
        Thread.Sleep(600);
        File.Delete(second);                      // remove
        Thread.Sleep(600);

        DirectoryWatcher.Stop();
        Thread.Sleep(300);   // ensure no events after Stop
        int addedAfter = added;
        Thread.Sleep(400);
        if (added != addedAfter) { bad = bad + 1; }   // stopped: no more events

        if (added < 1) { bad = bad + 1; }         // b.txt added
        if (removed < 1) { bad = bad + 1; }       // b.txt removed
        if (modified < 1 || modifiedName != "a.txt") { bad = bad + 1; }

        Directory.Delete(dir);
        Console.WriteLine("watch-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
