using System;
using System.Collections.Generic;
using System.Cli;
using System.Data;
using System.Data.Orm;
using System.Net.Http;
using System.Web;
using Cloud.Oss;
using Data.Validation;

class OptWave33Core {
    static void TestCliTextWidthTable() {
        Console.WriteLine("=== CLI ===");
        Console.WriteLine("w=" + Convert.ToString(TextWidth.Width(null))
            + "," + Convert.ToString(TextWidth.Width(""))
            + "," + Convert.ToString(TextWidth.Width("abc123"))
            + "," + Convert.ToString(TextWidth.Width("中文AB"))
            + "," + Convert.ToString(TextWidth.Width("caf\u0065\u0301"))
            + "," + Convert.ToString(TextWidth.Width("\x01\t\x7fa"))
            + "," + Convert.ToString(TextWidth.Width("🚀x")));
        Console.WriteLine("rep=" + TextWidth.Repeat("x", 0) + "|" + TextWidth.Repeat("a", 5) + "|" + TextWidth.Repeat("ab", 3));
        Console.WriteLine("sp=" + Convert.ToString(TextWidth.Spaces(0).Length)
            + "," + Convert.ToString(TextWidth.Spaces(5).Length)
            + "," + Convert.ToString(TextWidth.Spaces(70).Length));
        Console.WriteLine("pad=[" + TextWidth.Pad("hi", 6, 0) + "][" + TextWidth.Pad("中文", 7, 1)
            + "][" + TextWidth.Pad("9", 4, 2) + "][" + TextWidth.Pad("toolong", 3, 0) + "]");
        Console.WriteLine("tr=" + TextWidth.Truncate("abc", 0)
            + "|" + TextWidth.Truncate("a", 1)
            + "|" + TextWidth.Truncate("ab", 1)
            + "|" + TextWidth.Truncate("hello", 5)
            + "|" + TextWidth.Truncate("abcdef", 4)
            + "|" + TextWidth.Truncate("中文字", 5)
            + "|" + TextWidth.Truncate("a\u0301bc", 2));

        Table t1 = new Table().AsciiBorder();
        t1.AddColumn("Name", 0).AddColumn("Val", 2);
        t1.AddRow("中文", "42").AddRow("ok");
        Console.Write(t1.Render());

        Table t2 = new Table().NoBorder();
        t2.AddColumn("A", 0).AddColumn("B", 2).AddColumn("C", 0);
        t2.AddRow("x ", "", "").AddRow("y", "7", "z  ").AddRow("", "", "");
        Console.Write(t2.Render());
    }

    static void TestOrmDelete() {
        Console.WriteLine("=== ORM_DELETE ===");
        Console.WriteLine("u1=" + Dialect.Unalias("status = 1"));
        Console.WriteLine("u2=" + Dialect.Unalias("t.id = 1 AND (t.code = 't.lit''t.b') AND account.id = 2 AND other_t.x = 3"));

        Meta meta = Meta.Of("Item", "items");
        meta.Col("id", "Id", DbParams.KindInt, true, true, true, false, 0);
        meta.Col("code", "Code", DbParams.KindText, false, false, false, false, 32);
        meta.Col("status", "Status", DbParams.KindInt, false, false, false, false, 0);
        meta.Seal();

        DbValues dv = new DbValues();
        dv.Set("t.code", "A1");
        dv.Set("status", "3");

        Delete d = Delete.Create(null, meta);
        d.WhereDict(dv);
        d.CondBegin(false);
        d.WhereEq("id", 999);
        d.CondEnd();
        d.WherePk(42L);
        List<int> empty = new List<int>();
        d.WhereIn("status", empty);
        List<long> ten = new List<long>();
        for (int i = 1; i <= 10; i = i + 1) { ten.Add((long)i); }
        d.WhereIn("id", ten);
        d.W("t.status > ?");
        d.Pi(0);
        Delete snap = d.Snapshot();
        d.WhereNone();
        snap.PredicateCondition("status <> 9");
        Console.WriteLine("dw_snap=" + snap.CandidateWhere());
        Console.WriteLine("dp_snap=" + Convert.ToString(snap.CandidateParams().Count()));
        Console.WriteLine("dw_orig=" + d.CandidateWhere());
        Console.WriteLine("dp_orig=" + Convert.ToString(d.CandidateParams().Count()));

        Delete d2 = Delete.Create(null, meta);
        d2.PredicateCondition("id = 1");
        Console.WriteLine("dw2=" + d2.CandidateWhere());
    }

    static void TestOssCosAliyun() {
        Console.WriteLine("=== OSS_COS_ALIYUN ===");
        Console.WriteLine("cos0=" + TencentCosSigner.HttpString("GET", "a/b.txt"));
        List<string> qp = new List<string>();
        qp.Add("Z-Key=hello world");
        qp.Add("A/B=1+2");
        qp.Add("acl");
        qp.Add("");
        string upl = "";
        string hs = TencentCosSigner.HttpStringWithQuery("POST", "dir/f.bin", qp, out upl);
        Console.WriteLine("cos_upl=" + upl);
        Console.WriteLine("cos_hs=" + hs);
        string kt = TencentCosSigner.KeyTime(1700000000L, 0);
        Console.WriteLine("cos_kt=" + kt);
        Console.WriteLine("cos_auth=" + TencentCosSigner.AuthorizationWithQuery(
            "AK123", "SK456", "PUT", "obj.dat", qp, kt));
        Console.WriteLine("ali_sts=" + AliyunOssSigner.StringToSign(
            "PUT", "md5==", "text/plain", "Tue, 20 Oct 2026 08:00:00 GMT", "/bkt/k"));
        Console.WriteLine("ali_a1=" + AliyunOssSigner.Authorization(
            "AK1", "SK1", "GET", "application/json", "Tue, 20 Oct 2026 08:00:00 GMT", "bkt", "p/q.txt"));
        Console.WriteLine("ali_a2=" + AliyunOssSigner.Authorization(
            "AK1", "SK1", "GET", "", "Tue, 20 Oct 2026 08:00:00 GMT", "bkt", ""));
    }

    static void TestSeoRender() {
        Console.WriteLine("=== SEO_RENDER ===");
        Console.WriteLine("xe=" + Sitemap.XmlEscape("clean") + "|" + Sitemap.XmlEscape("a&b<c>\"d\"'e'"));
        Console.WriteLine("je=" + GeoSchema.JsonEscape("clean") + "|" + GeoSchema.JsonEscape("a\"b\\c\n\r\t\x08\x0c<>&\x01\x1f"));
        Console.WriteLine("he=" + GeoMeta.HtmlEscape("clean") + "|" + GeoMeta.HtmlEscape("a\"b&c<d>"));

        Sitemap sm = Sitemap.Create()
            .Add("https://example.com/p1", "2026-10-20", "daily", "0.9")
            .Add("https://example.com/s?a=1&b=2", "", "", "");
        Console.Write(sm.ToXml());

        GeoSchema faq = GeoSchema.FAQ().AddFAQ("Q<1>&\"x\"", "A\\1\nline2");
        GeoSchema bc = GeoSchema.Breadcrumbs().AddBreadcrumb("Home", "https://example.com/");
        GeoMeta gm = GeoMeta.Create()
            .SetTitle("Title & \"Quote\"")
            .SetDescription("Desc <tag>")
            .SetCanonical("https://example.com/?a=1&b=2")
            .AddSchema(faq)
            .AddSchema(bc);
        Console.Write(gm.RenderHead());
    }

    static void TestGeoAgent() {
        Console.WriteLine("=== GEO_AGENT ===");
        string[] bots = new string[] {
            "GPTBot/1.0", "ChatGPT-User/1.0", "ChatGPT/2.0", "PerplexityBot", "Perplexity/1.0",
            "ClaudeBot/1.0", "Claude-Web", "anthropic-ai", "Google-Extended", "GoogleOther",
            "Bytespider", "Applebot-Extended", "cohere-ai", "Diffbot", "Omgilibot",
            "CCBot/2.0", "FacebookBot", "Amazonbot", "Meta-ExternalAgent"
        };
        int hit = 0;
        for (int i = 0; i < bots.Length; i = i + 1) {
            if (GeoAgent.IsAiBot("Prefix " + bots[i] + " Suffix")) { hit = hit + 1; }
        }
        string[] nonBots = new string[] {
            null, "", "abc", "Googlebot/2.1", "Mozilla/5.0 Chrome/128.0",
            "anthropic\rai", "google\rextended", "meta\rexternalagent", "Chat/1.0", "Claude"
        };
        int falsePos = 0;
        for (int i = 0; i < nonBots.Length; i = i + 1) {
            if (GeoAgent.IsAiBot(nonBots[i])) { falsePos = falsePos + 1; }
        }
        Console.WriteLine("bots=" + Convert.ToString(hit) + "/" + Convert.ToString(bots.Length)
            + " fp=" + Convert.ToString(falsePos));
    }

    static void TestValidationText() {
        Console.WriteLine("=== VALIDATION_TEXT ===");
        string[] emails = new string[] {
            "a@b.c", "alice.smith+1@sub.example.com", "a@b", "a@b.", ".a@b.c",
            "a.@b.c", "a@.b.c", "a..b@c.d", "a@b..c", "a@@b.c", "a b@c.d", "a\x7f@b.c", null
        };
        string eOut = "";
        for (int i = 0; i < emails.Length; i = i + 1) {
            eOut = eOut + (ValidationText.IsValidEmail(emails[i]) ? "1" : "0");
        }
        Console.WriteLine("emails=" + eOut);

        string mOut = "";
        mOut = mOut + (ValidationText.Matches("abc", "abc") ? "1" : "0");
        mOut = mOut + (ValidationText.Matches("abc", "abd") ? "1" : "0");
        mOut = mOut + (ValidationText.Matches("", "") ? "1" : "0");
        mOut = mOut + (ValidationText.Matches("abc", "*") ? "1" : "0");
        mOut = mOut + (ValidationText.Matches("abc", "**") ? "1" : "0");
        mOut = mOut + (ValidationText.Matches("api.v2.get", "api.v2.*") ? "1" : "0");
        mOut = mOut + (ValidationText.Matches("api.v1.get", "api.v2.*") ? "1" : "0");
        mOut = mOut + (ValidationText.Matches("logo.png", "*.png") ? "1" : "0");
        mOut = mOut + (ValidationText.Matches("logo.jpg", "*.png") ? "1" : "0");
        mOut = mOut + (ValidationText.Matches("xx_mid_yy", "*mid*") ? "1" : "0");
        mOut = mOut + (ValidationText.Matches("xx_m_yy", "*mid*") ? "1" : "0");
        mOut = mOut + (ValidationText.Matches("aXbYc", "a?b?c") ? "1" : "0");
        mOut = mOut + (ValidationText.Matches("axxxbyyyczzz", "a*b*c*") ? "1" : "0");
        mOut = mOut + (ValidationText.Matches("axxxbyyy", "a*b*c") ? "1" : "0");
        mOut = mOut + (ValidationText.IsBlank(" \t\r\n") ? "1" : "0");
        mOut = mOut + (ValidationText.IsBlank(" x ") ? "1" : "0");
        Console.WriteLine("matches=" + mOut);
    }

    static void Main() {
        OptWave33Core.TestCliTextWidthTable();
        OptWave33Core.TestOrmDelete();
        OptWave33Core.TestOssCosAliyun();
        OptWave33Core.TestSeoRender();
        OptWave33Core.TestGeoAgent();
        OptWave33Core.TestValidationText();
    }
}
