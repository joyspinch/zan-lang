using System;

class SetterItem {
    public int Value;
    public SetterItem(int value) { this.Value = value; }
}

class SetterOwner {
    SetterItem stored;
    int number;
    public SetterItem View {
        get { return stored; }
        set { stored = value; }
    }
    public int Number {
        get { return number; }
        set { number = value; }
    }
    public void SetBody(SetterItem item) { View = item; }
    public void SetNumber(int value) { Number = value; }
    public int Read() { return View.Value + Number; }
}

class SetterWitness {
    public weak SetterOwner Owner;
    public weak SetterItem Item;
}

class Program {
    static void Check(bool condition, string message) {
        if (!condition) throw new Exception(message);
    }
    static void Exercise(SetterWitness witness) {
        SetterOwner owner = new SetterOwner();
        witness.Owner = owner;
        for (int i = 0; i < 8; i++) {
            SetterItem item = new SetterItem(i);
            witness.Item = item;
            // Both setters borrow implicit this. A reference-valued custom
            // getter must not make the setter consume that receiver.
            owner.SetBody(item);
            owner.SetNumber(10);
            Check(witness.Owner != null, "implicit setter released this");
            Check(owner.Read() == i + 10, "implicit setter stored wrong value");
            // Explicit receiver remains borrowed as well.
            owner.View = item;
            Check(owner.Read() == i + 10, "explicit setter released receiver");
            owner.SetBody(null);
            item = null;
            Check(witness.Item == null, "setter retained replaced item");
        }
    }
    static void Main() {
        SetterWitness witness = new SetterWitness();
        Exercise(witness);
        Check(witness.Owner == null, "implicit setter retained this");
        Check(witness.Item == null, "setter retained item");
        Console.WriteLine("ARC_IMPLICIT_SETTER_RECEIVER_OK");
    }
}
