using System;
using System.Collections.Generic;
using System.Linq;

// 推导出的泛型方法实例化与特化路由：
// 1. nums.AsStream()（类型实参靠推导）返回的 Stream<int> 必须登记为类实例，
//    其方法走特化版而不是擦除版；值类型元素与引用类型元素都要对。
// 2. 泛型方法体里的嵌套实例（ToList 里的 Dict<T,bool>）随绑定一并登记。
// 3. 类里有与类型同名的字段（Color Color）时，`Kind.Make<T>()` 是静态泛型调用，
//    接收者不占实参位，仍须特化（T 不丢失）。
// 4. 裸名调用带显式类型实参的泛型方法，返回类型按实参代换（First<int>(xs) 是 int）。
class Kind {
    public string name;
    public Kind(string n) { name = n; }
    public static Kind Make<T>() { return new Kind(typeof(T).Name); }
}

class Holder<T> {
    public static Kind Kind = Kind.Make<T>();
}

class Item {
    public int id;
    public Item(int i) { id = i; }
}

class InferInst {
    static T First<T>(List<T> xs) { return xs[0]; }

    static void Main() {
        List<int> nums = new List<int>();
        for (int i = 0; i < 10; i++) { nums.Add(i); }
        List<int> a = nums.AsStream().Where(x => x > 2).Skip(1).Take(3).ToList();
        Console.WriteLine(a.Count + " " + a[0] + " " + a[2]);
        List<int> d = nums.AsStream().Where(x => x % 3 == 0).ToList();
        Console.WriteLine(d.Count + " " + d[d.Count - 1]);

        List<Item> items = new List<Item>();
        for (int i = 0; i < 5; i++) { items.Add(new Item(i * 10)); }
        List<Item> big = items.AsStream().Where(it => it.id >= 20).ToList();
        Console.WriteLine(big.Count + " " + big[0].id);

        Console.WriteLine(Holder<Item>.Kind.name);
        Console.WriteLine(Holder<int>.Kind.name);

        Console.WriteLine(2 + First<int>(nums));
        Console.WriteLine(First<Item>(items).id + 1);
    }
}
