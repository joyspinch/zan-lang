using System;

class Program {
    [NoAlloc]
    static long AsmAddMul(long a, long b) {
        // AT&T syntax: imulq $3, %rdi -> result in output register
        long scaled = InlineAsm.Emit<long>("imulq $$3, $1, $0", "=r,r", a);
        long sum = InlineAsm.Emit<long>("addq $2, $0", "=r,0,r", scaled, b);
        return sum;
    }

    [NoAlloc]
    static uint AsmBswap32(uint x) {
        return InlineAsm.Emit<uint>("bswapl $0", "=r,0", x);
    }

    [NoAlloc]
    static int AsmIntelSub(int a, int b) {
        // Intel syntax: sub dst, src
        return InlineAsm.EmitIntel<int>("sub $0, $2", "=r,0,r", a, b);
    }

    [NoAlloc]
    static void AsmBarrierAndPause() {
        InlineAsm.Emit("", "~{memory}");
        InlineAsm.Emit("pause", "");
        InlineAsm.EmitIntel("nop", "");
    }

    static int Main() {
        AsmBarrierAndPause();
        long v = AsmAddMul(14L, 5L);      // 14 * 3 + 5 = 47
        uint b = AsmBswap32(0x12345678u); // 0x78563412 = 2018915346
        int d = AsmIntelSub(100, 37);     // 63
        Console.WriteLine($"v={v}");
        Console.WriteLine($"b={b}");
        Console.WriteLine($"d={d}");
        return 0;
    }
}
