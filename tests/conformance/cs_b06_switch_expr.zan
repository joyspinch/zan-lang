// B6: switch expressions — `expr switch { arm, ... }`. Arms support constant
// patterns, type patterns with a bound variable, `when` guards, `null`, the
// `_` discard, a missing discard (zero fallback), nesting and use as a call
// argument.
using System;

class Shape {
    public int Sides;
}
class Circle : Shape { }
class Item {
    public string Tag;
}

class Prog {
    static int Classify(object o) {
        return o switch {
            Circle c when c.Sides == 0 => 10,
            Shape s => 20,
            null => 0,
            _ => -1
        };
    }

    static string DoIt(string s) { return s; }

    static void Main() {
        int bad = 0;

        Shape sh = new Shape(); sh.Sides = 4;
        Circle ci = new Circle(); ci.Sides = 0;
        if (Classify(ci) != 10) { bad = bad + 1; }
        if (Classify(sh) != 20) { bad = bad + 1; }
        if (Classify(null) != 0) { bad = bad + 1; }

        int n = 2;
        if (n switch { 1 => "one", 2 => "two", _ => "many" } != "two") { bad = bad + 1; }

        // missing discard: unmatched keeps the zero initializer
        if ((5 switch { 1 => 100, 2 => 200 }) != 0) { bad = bad + 1; }

        // nested switch + switch as a call argument
        int x = 5;
        if (((x == 5 ? 1 : 2) switch { 1 => 7, _ => 8 }) != 7) { bad = bad + 1; }
        if (DoIt(3 switch { 3 => "three", _ => "?" }) != "three") { bad = bad + 1; }

        // pattern variable used in the arm result; owned string result
        Item it = new Item(); it.Tag = "box";
        string desc = it switch {
            Item i when i.Tag == "box" => "it's a " + i.Tag,
            Item i => "unknown:" + i.Tag,
            _ => "null"
        };
        if (desc != "it's a box") { bad = bad + 1; }

        Console.WriteLine("switchx-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
