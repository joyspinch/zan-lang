using System;
using System.Threading;

// B-ID98 钉子：协程就绪队列扩容 OOM 降档。注入 co.queue_grow:1（首次
// 翻倍分配失败）→ 降档 +16 分配接住 → 40 个并发让出/恢复全部完成，
// 无帧丢失。若双档全败的早退缺失，程序当场崩溃（NULL 线性化）。
class Program {
    static int done = 0;
    static int[] results = new int[40];

    static async Task Worker(int i) {
        await Task.Yield();
        results[i] = i * 2;
        done = done + 1;
    }

    static async Task<int> Run() {
        for (int i = 0; i < 40; i = i + 1) {
            Task.Spawn(Worker(i));
        }
        for (int spins = 0; done < 40 && spins < 4000; spins = spins + 1) {
            await Task.Delay(2);
        }
        int sum = 0;
        for (int i = 0; i < 40; i = i + 1) {
            sum = sum + results[i];
        }
        return sum;
    }

    static void Main() {
        int sum = await Run();
        Console.WriteLine("done: " + done.ToString());
        Console.WriteLine("sum: " + sum.ToString());
    }
}
