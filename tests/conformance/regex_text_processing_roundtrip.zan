using System;
using System.Text;
using System.Text.RegularExpressions;

class Program {
    static void Main() {
        // 1. Regex Constructor & IsMatch
        Regex r1 = new Regex("^\\d{3}-\\d{4}$");
        if (r1.IsMatch("123-4567")) {
            Console.WriteLine("REGEX_CTOR_OK");
        }

        // 2. Regex.Match static & Match groups
        Match m = Regex.Match("order: 42 item: book", "order:\\s*(\\d+)");
        if (m.Success() && m.Group(1) == "42") {
            Console.WriteLine("REGEX_MATCH_OK");
        }

        // 3. Regex.Replace static & instance
        string rep = Regex.Replace("red, green, blue", "green", "yellow");
        if (rep == "red, yellow, blue") {
            Console.WriteLine("REGEX_REPLACE_OK");
        }

        // 4. Regex.Split
        Regex rSplit = new Regex("[,;]\\s*");
        List<string> parts = rSplit.Split("apple, banana; cherry");
        if (parts.Count == 3 && parts[1] == "banana") {
            Console.WriteLine("REGEX_SPLIT_OK");
        }

        // 5. Template.Render & EscapeHtml
        Dictionary<string, string> vars = new Dictionary<string, string>();
        vars["user"] = "<Admin>";
        vars["role"] = "SuperUser";
        string rendered = Template.Render("Hello {{user}}, role: {{{role}}}", vars);
        if (rendered.IndexOf("&lt;Admin&gt;") >= 0 && rendered.IndexOf("SuperUser") >= 0) {
            Console.WriteLine("TEMPLATE_RENDER_OK");
        }

        // 6. Markdown.ToHtml
        string md = "# Zan Language\n\nFast and **safe** language.";
        string html = Markdown.ToHtml(md);
        if (html.IndexOf("<h1>Zan Language</h1>") >= 0 && html.IndexOf("<strong>safe</strong>") >= 0) {
            Console.WriteLine("MARKDOWN_TO_HTML_OK");
        }

        // 7. Fuzzy.Matches & Score
        if (Fuzzy.Matches("zan", "ZanLanguage") && Fuzzy.Score("Zan", "Zan") == 1.0) {
            Console.WriteLine("FUZZY_OK");
        }

        // 8. TextTable.Render
        List<string> headers = new List<string>();
        headers.Add("Col1");
        headers.Add("Col2");
        TextTable table = new TextTable(headers);
        List<string> row = new List<string>();
        row.Add("val1");
        row.Add("val2");
        table.AddRow(row);
        string tableStr = table.Render();
        if (tableStr.IndexOf("+") >= 0 && tableStr.IndexOf("Col1") >= 0) {
            Console.WriteLine("TEXT_TABLE_OK");
        }
    }
}
