// 接口数据协议与执行契约。
// 核心契约与语义定义。
// 接口数据协议与执行契约。
using System;

#if WINDOWS
namespace Conf;

class Prog {
    [DllImport("zan_gui", EntryPoint = "zan_gui_create_surface")]
    static extern int CreateSurface(int w, int h);

    [DllImport("zan_gui", EntryPoint = "zan_gui_draw_text")]
    static extern void DrawText(int surface, int x, int y, string text,
                                int color, int fontSize);

    // 接口数据协议与执行契约。
    [DllImport("zan_gui", EntryPoint = "zan_gui_text_stat_read")]
    static extern long StatRead(int idx);

    static void Main() {
        int surf = Prog.CreateSurface(400, 120);
        for (int i = 0; i < 2000; i = i + 1) {
            Prog.DrawText(surf, 4, 8, "count: " + Convert.ToString(i),
                          0xFF0000, 14);
        }
        long stores = Prog.StatRead(77);
        long swept = Prog.StatRead(78);
        long atlas = Prog.StatRead(76);
        // 接口数据协议与执行契约。
        Console.WriteLine("stores-ok: "
            + Convert.ToString(stores >= 2000 ? 1 : 0));
        Console.WriteLine("swept-ok: "
            + Convert.ToString(swept >= 1800 ? 1 : 0));
        Console.WriteLine("bounded-ok: "
            + Convert.ToString(atlas < 4000000 ? 1 : 0));
    }
}
#else
namespace Conf;

class Prog {
    static void Main() {
        // 接口数据协议与执行契约。
        Console.WriteLine("stores-ok: 1");
        Console.WriteLine("swept-ok: 1");
        Console.WriteLine("bounded-ok: 1");
    }
}
#endif
