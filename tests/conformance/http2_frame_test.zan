// 核心契约与语义定义。

using System;
using System.Net.Http;

namespace Tests.Conformance;

class Http2FrameTest {
    static void Main() {
        // 1. 验证客户端连接序言 (24 字节)
        string preface = Http2Frame.PREFACE;
        if (preface != "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n" || preface.Length != 24) {
            Console.WriteLine("Invalid HTTP/2 preface");
            Environment.Exit(1);
        }

        // 2. 验证 9 字节固定分帧帧头编码: SETTINGS 帧 (Length=6, Type=4, Flags=0, StreamID=0)
        byte[] settingsHdr = Http2Frame.EncodeHeader(6, Http2FrameType.SETTINGS, 0, 0);
        if (settingsHdr.Length != 9) {
            Console.WriteLine("Header length mismatch: " + Convert.ToString(settingsHdr.Length));
            Environment.Exit(2);
        }

        if (settingsHdr[0] != 0 || settingsHdr[1] != 0 || settingsHdr[2] != 6) {
            Console.WriteLine("Length field encoding failed");
            Environment.Exit(3);
        }
        if (settingsHdr[3] != 4) { // TYPE == SETTINGS (4)
            Console.WriteLine("Type field mismatch");
            Environment.Exit(4);
        }
        if (settingsHdr[4] != 0) { // FLAGS == 0
            Console.WriteLine("Flags mismatch");
            Environment.Exit(5);
        }

        // 3. 验证 SETTINGS ACK 帧
        byte[] ack = Http2Frame.BuildSettingsAck();
        if (ack.Length != 9 || ack[3] != 4 || ack[4] != 1) { // Type 4, Flag ACK (1)
            Console.WriteLine("Settings ACK encoding mismatch");
            Environment.Exit(6);
        }

        // 4. 验证 DecodeHeader
        Http2Frame decoded = Http2Frame.DecodeHeader(settingsHdr, 0);
        if (decoded == null || decoded.length != 6 || decoded.type != Http2FrameType.SETTINGS || decoded.streamId != 0) {
            Console.WriteLine("DecodeHeader mismatch");
            Environment.Exit(7);
        }

        // 5. 验证 RST_STREAM 帧 (StreamID=5, Error=REFUSED_STREAM)
        byte[] rst = Http2Frame.BuildRstStream(5, Http2Error.REFUSED_STREAM);
        if (rst.Length != 13 || rst[3] != Http2FrameType.RST_STREAM || rst[8] != 5 || rst[12] != Http2Error.REFUSED_STREAM) {
            Console.WriteLine("RST_STREAM encoding mismatch");
            Environment.Exit(8);
        }

        // 6. 验证 GOAWAY 帧 (LastStreamID=7, Error=PROTOCOL_ERROR)
        byte[] goaway = Http2Frame.BuildGoAway(7, Http2Error.PROTOCOL_ERROR);
        if (goaway.Length != 17 || goaway[3] != Http2FrameType.GOAWAY || goaway[12] != 7 || goaway[16] != Http2Error.PROTOCOL_ERROR) {
            Console.WriteLine("GOAWAY encoding mismatch");
            Environment.Exit(9);
        }

        // 7. 验证 WINDOW_UPDATE 帧 (StreamID=1, Increment=65535)
        byte[] win = Http2Frame.BuildWindowUpdate(1, 65535);
        if (win.Length != 13 || win[3] != Http2FrameType.WINDOW_UPDATE || win[8] != 1 || win[11] != 255 || win[12] != 255) {
            Console.WriteLine("WINDOW_UPDATE encoding mismatch");
            Environment.Exit(10);
        }

        Console.WriteLine("HTTP/2 framing test passed!");
    }
}
