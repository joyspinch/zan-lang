// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
using System;
using System.IO;
using System.Net.Http;
using System.Net.Http.Client;

class Program {
    static int Count(string hay, string needle) {
        int hl = hay.Length;
        int nl = needle.Length;
        if (nl == 0 || hl < nl) { return 0; }
        int hits = 0;
        for (int i = 0; i + nl <= hl; i = i + 1) {
            int j = 0;
            while (j < nl && (hay[i + j] & 255) == (needle[j] & 255)) {
                j = j + 1;
            }
            if (j == nl) { hits = hits + 1; }
        }
        return hits;
    }

    static string TempFile() {
        return Path.Combine(Path.GetTempPath(), "zan_mp_guard.txt");
    }

    // 接口数据协议与执行契约。
    // 接口数据协议与执行契约。
    static string TokenVerdict(string name) {
        try {
            HttpClient.ValidateMultipartToken("file name", name);
            return "accepted";
        } catch (ArgumentException e) {
            return "rejected";
        }
    }

    static void Main() {
        HttpResponse resp = new HttpResponse();
        resp.SetHeader("X-Ok", "v");
        resp.SetHeader("X-Bad", "v\r\nX-Injected: 2");
        resp.SetHeader("X-Colon", "ok");
        resp.SetHeader("Bad:Name", "v");
        Console.WriteLine("respOk=" + resp.GetHeader("X-Ok"));
        // 接口数据协议与执行契约。
        Console.WriteLine("respInject=" + Convert.ToString(resp.GetHeader("X-Injected").Length));
        Console.WriteLine("respColon=" + Convert.ToString(resp.GetHeader("Bad").Length));

        HttpClient hc = new HttpClient("127.0.0.1", 1);
        hc.SetHeader("X-Good", "1");
        hc.SetHeader("X-Evil", "1\r\nX-Injected: 2");
        string head = hc.BuildRequestHead("GET", "/", 0, true);
        Console.WriteLine("cliGood=" + Convert.ToString(hc.HasHeaderName("X-Good")));
        Console.WriteLine("cliEvil=" + Convert.ToString(hc.HasHeaderName("X-Evil")));
        Console.WriteLine("cliLines=" + Convert.ToString(Count(head, "X-Injected")));

        Console.WriteLine("tokenQuote=" + TokenVerdict("field\"evil"));
        Console.WriteLine("tokenCrlf=" + TokenVerdict("a\r\nX-Injected: 2"));
        Console.WriteLine("tokenOk=" + TokenVerdict("plain.txt"));

        // 接口数据协议与执行契约。
        // 接口数据协议与执行契约。
        string tmp = TempFile();
        File.WriteAllText(tmp, "payload");
        HttpClient up = new HttpClient("127.0.0.1", 1);
        string seen = "none";
        try {
            HttpResponse _r = await up.UploadFileAsync("/up", "field\"evil",
                tmp, "a.txt");
            seen = "accepted";
        } catch (ArgumentException e) {
            seen = "rejected";
        }
        Console.WriteLine("multipartField=" + seen);
        File.Delete(TempFile());
    }
}
