using System;

class Program {
    static int Main() {
        int n = 3;
        string name = "z";
        string s = $"v={$"[{n}]"}";
        string t = $"a{$"b{$"c{n}"}"}d";
        string u = $"{name}:{n:D3} {(n > 2 ? "hi" : "lo")}";
        Console.WriteLine(s);
        Console.WriteLine(t);
        Console.WriteLine(u);

        // 未声明的名字在转义花括号内必须保持字面文本；无真实孔也要解码。
        Console.WriteLine($"{{missing}} {{}} }}}}");
        // 起始、中间、末尾片段都解码，三个花括号包含一个真实孔。
        Console.WriteLine($"{{left}} {n} {{middle}} {n:D3} {{right}}");
        Console.WriteLine($"{{{n}}} {{{n:D3}}}");
        // 内层关闭后，外层转义片段和后续真实孔仍由各自词法上下文处理。
        Console.WriteLine($"{{outer}} {$"{{inner}} {{{n:D3}}}"} {{tail}} {n}");
        // 普通字符串（包含孔中的字符串）不能按插值片段解码。
        Console.WriteLine("{{n}} {n:D3}");
        Console.WriteLine($"literal={"{{n}}"} nested={$"{n:D3}"}");
        Console.WriteLine($"quote=\"{{n}}\" slash=\\ {{{n}}}");
        return 0;
    }
}
