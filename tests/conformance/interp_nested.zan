using System;

class Program {
    static int Main() {
        int n = 3;
        string name = "z";
        string s = $"v={$"[{n}]"}";
        string t = $"a{$"b{$"c{n}"}"}d";
        string u = $"{name}:{n:D3} {(n > 2 ? "hi" : "lo")}";
        Console.WriteLine(s);
        Console.WriteLine(t);
        Console.WriteLine(u);
        return 0;
    }
}
