// 核心契约与语义定义。
// 核心契约与执行状态转移规范。
using System;

class Outer {
    static class Helper {
        static int Scale(int v) { return v * 10; }
    }

    class Counter {
        int n;
        Counter() { n = 0; }
        int Next() { n = n + 1; return n; }
    }

    struct Pair {
        int x;
        int y;
    }

    enum Shade {
        Red = 1,
        Blue = 2
    }

    static int Run() {
        Counter c = new Counter();
        Pair p;
        p.x = 4;
        p.y = 3;
        return Helper.Scale(p.x + p.y) + c.Next() + c.Next();
    }
}

class Program {
    static void Main() {
        Console.WriteLine(Outer.Run());
        Console.WriteLine(Shade.Blue);
    }
}
