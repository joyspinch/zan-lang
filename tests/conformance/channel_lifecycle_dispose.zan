using System;
using System.Threading;

class Program {
    static async int Run() {
        // 1. Channel<T> 实现 IDisposable 与多态释放
        Channel<string> ch = Channel<string>.CreateBounded(4);
        ch.TryWrite("hello");
        ch.TryWrite("world");
        Console.WriteLine("count=" + Convert.ToString(ch.Count()));

        string item;
        bool ok = ch.TryRead(out item);
        Console.WriteLine("read=" + item);

        // 多态转型为 IDisposable
        IDisposable dispCh = ch;
        dispCh.Dispose();
        Console.WriteLine("ch_disposed");

        // 2. StringChannel 实现 IDisposable 与多态释放
        StringChannel sc = new StringChannel(2);
        Console.WriteLine("sc_closed=" + (sc.IsClosed() ? "true" : "false"));
        IDisposable dispSc = sc;
        dispSc.Dispose();
        Console.WriteLine("sc_closed_after=" + (sc.IsClosed() ? "true" : "false"));
        Console.WriteLine("sc_disposed");

        Console.WriteLine("ok");
        return 0;
    }

    static async void Main() {
        await Program.Run();
    }
}
