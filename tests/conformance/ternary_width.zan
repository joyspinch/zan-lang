class ArcValue {
    string text;

    ArcValue(string text) {
        this.text = text;
    }
}

class ArcHolder {
    ArcValue item;
}

class Foo {
    int n;
    double d;
    bool flag;

    static ArcValue Owned(string text) {
        return new ArcValue(text);
    }

    static ArcValue PickReturn(bool on, ArcValue borrowed) {
        return on ? borrowed : Foo.Owned("return-owned");
    }

    static void PrintArg(string label, ArcValue item) {
        Console.WriteLine(label + "=" + item.text);
    }

    int Count() {
        int c = 1;
        if (flag) { c = c + 1; }
        return c;
    }

    int Pick(bool on) {
        return on ? Count() : 0;
    }

    static void Main() {
        Foo f = new Foo();
        f.flag = true;
        // 接口数据协议与执行契约。
        // 接口数据协议与执行契约。
        f.n = f.Pick(true);
        Console.WriteLine(f.n);
        // 核心契约与语义定义。
        f.n = f.flag ? 5 : f.Count();
        Console.WriteLine(f.n);
        f.n = f.flag ? 5 : 0;
        Console.WriteLine(f.n);
        // 核心契约与语义定义。
        int v = f.Count();
        f.n = f.flag ? v : 0;
        Console.WriteLine(f.n);
        // 接口数据协议与执行契约。
        f.d = f.flag ? 1.5 : 2;
        Console.WriteLine(f.d);
        // 核心契约与语义定义。
        f.flag = false;
        f.n = f.flag ? f.Count() : 7;
        Console.WriteLine(f.n);
        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        string source = "owned";
        string a = f.flag ? "borrowed" : source.Substring(0, source.Length);
        Console.WriteLine(a);
        f.flag = true;
        string b = f.flag ? "borrowed" : source.Substring(0, source.Length);
        Console.WriteLine(b);

        // 接口数据协议与执行契约。
        // 接口数据协议与执行契约。
        // 接口数据协议与执行契约。
        ArcValue borrowed = new ArcValue("borrowed-class");
        ArcValue mixedOwned = false ? borrowed : Foo.Owned("mixed-owned");
        Console.WriteLine(mixedOwned.text);
        ArcValue mixedBorrowed = true ? borrowed : Foo.Owned("unused-owned");
        Console.WriteLine(mixedBorrowed.text);
        ArcValue reverseOwned = true ? Foo.Owned("reverse-owned") : borrowed;
        Console.WriteLine(reverseOwned.text);
        ArcValue reverseBorrowed = false ? Foo.Owned("unused-reverse") : borrowed;
        Console.WriteLine(reverseBorrowed.text);

        // 接口数据协议与执行契约。
        ArcValue ownedBoth = f.flag ? Foo.Owned("owned-left") : Foo.Owned("owned-right");
        Console.WriteLine(ownedBoth.text);
        ArcValue borrowedOther = new ArcValue("borrowed-other");
        ArcValue borrowedBoth = f.flag ? borrowed : borrowedOther;
        Console.WriteLine(borrowedBoth.text);

        // 接口数据协议与执行契约。
        ArcValue returnedBorrowed = Foo.PickReturn(true, borrowed);
        Console.WriteLine(returnedBorrowed.text);
        ArcValue returnedOwned = Foo.PickReturn(false, borrowed);
        Console.WriteLine(returnedOwned.text);
        Foo.PrintArg("arg-borrowed", false ? borrowed : Foo.Owned("arg-owned"));
        Foo.PrintArg("arg-owned", true ? Foo.Owned("arg-owned-left") : borrowed);

        ArcHolder holder = new ArcHolder();
        holder.item = true ? borrowed : Foo.Owned("field-unused");
        Console.WriteLine("field=" + holder.item.text);
        holder.item = false ? borrowed : Foo.Owned("field-replaced");
        Console.WriteLine("field=" + holder.item.text);

        List<ArcValue> items = new List<ArcValue>();
        items.Add(false ? borrowed : Foo.Owned("list-owned"));
        items.Add(true ? borrowed : Foo.Owned("list-unused"));
        Console.WriteLine("list=" + items[0].text + "," + items[1].text);

        ArcValue nested = false
            ? Foo.Owned("outer-unused")
            : (true ? borrowed : Foo.Owned("inner-unused"));
        Console.WriteLine("nested=" + nested.text);

        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        ArcValue replaced = Foo.Owned("old-reference");
        replaced = false ? borrowed : Foo.Owned("replacement-owned");
        Console.WriteLine("replace=" + replaced.text);
        replaced = true ? borrowed : Foo.Owned("replacement-unused");
        Console.WriteLine("replace=" + replaced.text);
    }
}
