class Foo {
    int n;
    double d;
    bool flag;

    int Count() {
        int c = 1;
        if (flag) { c = c + 1; }
        return c;
    }

    int Pick(bool on) {
        return on ? Count() : 0;
    }

    static void Main() {
        Foo f = new Foo();
        f.flag = true;
        // Method-call branch (i32) vs integer-literal branch (i64): the PHI
        // must unify both sides or LLVM verification fails.
        f.n = f.Pick(true);
        Console.WriteLine(f.n);
        // Reverse widths and constant/constant (regression).
        f.n = f.flag ? 5 : f.Count();
        Console.WriteLine(f.n);
        f.n = f.flag ? 5 : 0;
        Console.WriteLine(f.n);
        // Local variable branch (i32) vs literal (i64).
        int v = f.Count();
        f.n = f.flag ? v : 0;
        Console.WriteLine(f.n);
        // Mixed float/int branches unify to the float side.
        f.d = f.flag ? 1.5 : 2;
        Console.WriteLine(f.d);
        // Else branch taken at runtime.
        f.flag = false;
        f.n = f.flag ? f.Count() : 7;
        Console.WriteLine(f.n);
    }
}
