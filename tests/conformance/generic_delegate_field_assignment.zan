using System;

public delegate void FirstSlot<T>(T value, object target);
public delegate void BothSlots<T>(T first, T second);
public delegate void PlainSetter(object target, string value);
class GenericDelegateSlots<T> {
    public FirstSlot<T> First;
    public BothSlots<T> Both;
}
class DelegateFieldShadow {
    public PlainSetter Set;
}
class GenericDelegateFieldAssignmentTest {
    public string Value;
    public int Calls;
    static void Check(bool ok, string label) { if (!ok) { throw new Exception(label); } }
    public static string Get(object target) {
        GenericDelegateFieldAssignmentTest state = (GenericDelegateFieldAssignmentTest)target;
        return state.Value;
    }
    public static void Set(object target, string value) {
        GenericDelegateFieldAssignmentTest state = (GenericDelegateFieldAssignmentTest)target;
        state.Value = value; state.Calls = state.Calls + 1;
    }
    static void SetFirst(string value, object target) { GenericDelegateFieldAssignmentTest.Set(target, value); }
    static void SetBoth(string first, string second) { Check(first == "first" && second == "second", "both generic parameter slots"); }
    static void Main() {
        GenericDelegateFieldAssignmentTest state = new GenericDelegateFieldAssignmentTest();
        Binding<string> binding = new Binding<string>();
        binding.target = state;
        binding.getter = GenericDelegateFieldAssignmentTest.Get;
        binding.setter = GenericDelegateFieldAssignmentTest.Set;
        binding.live = true;
        binding.Set("updated");
        Check(binding.Get() == "updated" && state.Calls == 1 && binding.Version() == 1,
            "stdlib getter return and setter second parameter use receiver string argument");
        GenericDelegateSlots<string> slots = new GenericDelegateSlots<string>();
        slots.First = GenericDelegateFieldAssignmentTest.SetFirst;
        slots.Both = GenericDelegateFieldAssignmentTest.SetBoth;
        slots.First("first-slot", state);
        slots.Both("first", "second");
        Check(state.Value == "first-slot" && state.Calls == 2, "first generic parameter slot");
        DelegateFieldShadow holder = new DelegateFieldShadow();
        holder.Set = GenericDelegateFieldAssignmentTest.Set;
        PlainSetter local = holder.Set;
        holder.Set = local;
        holder.Set(state, "plain");
        Check(state.Value == "plain" && state.Calls == 3, "non-generic delegate field and local remain ordinary values");
        Console.WriteLine("GENERIC_DELEGATE_FIELD_ASSIGNMENT_OK");
    }
}
