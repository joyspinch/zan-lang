using System;
using System.IO;

class P {
    static void Main() {
        Directory.CreateDirectory("_scratch");
        string path = "_scratch/file_readallbytes_unlock.tmp";
        byte[] data = new byte[] { 0, 65, 0, 66, 255, 67 };
        File.WriteAllBytes(path, data);
        byte[] back = File.ReadAllBytes(path);
        Console.WriteLine(back.Length == data.Length ? "ok len" : "BAD len");
        bool same = back[0] == 0 && back[1] == 65 && back[2] == 0
            && back[3] == 66 && back[4] == 255 && back[5] == 67;
        Console.WriteLine(same ? "ok bytes" : "BAD bytes");
        try {
            File.Delete(path);
            Console.WriteLine("ok delete after read");
        } catch (Exception) {
            Console.WriteLine("BAD handle leaked (delete failed)");
        }
        Console.WriteLine(File.Exists(path) ? "BAD still exists" : "ok gone");
    }
}
