using System;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.IO;

class Program {
    static int pass = 0;
    static int fail = 0;

    static void Check(string name, bool ok) {
        if (ok) {
            pass = pass + 1;
        } else {
            fail = fail + 1;
            Console.WriteLine("FAIL: " + name);
        }
    }

    static async void RunTests() {
        string dbPath = "model_async_test.tmp.db";
        File.Delete(dbPath);

        SqliteConnection db = SqliteConnection.Open(dbPath);
        Check("db open", db != null);

        Model model = Model.Define("articles")
            .Column("id", "INTEGER", true)
            .Column("title", "TEXT")
            .Column("views", "INTEGER");

        // 1. TableExists & TableExistsAsync before creation
        Check("table not exists sync", !model.TableExists(db));
        Check("table not exists async", !await model.TableExistsAsync(db));

        // 2. CreateTableAsync
        await model.CreateTableAsync(db);
        Check("table exists sync", model.TableExists(db));
        Check("table exists async", await model.TableExistsAsync(db));

        // 3. Insert & InsertAsync
        ModelRow r1 = new ModelRow().Set("title", "Hello Zan").Set("views", "10");
        int aff1 = model.Insert(db, r1);
        Check("insert sync", aff1 == 1);

        ModelRow r2 = new ModelRow().Set("title", "Async ORM").Set("views", "25");
        int aff2 = await model.InsertAsync(db, r2);
        Check("insert async", aff2 == 1);

        ModelRow r3 = new ModelRow().Set("title", "Param Injection Test'--").Set("views", "99");
        int aff3 = await model.InsertAsync(db, r3);
        Check("insert async special chars", aff3 == 1);

        // 4. Count & CountAsync
        Check("count sync", model.Count(db) == 3);
        Check("count async", await model.CountAsync(db) == 3);

        // 5. FindById & FindByIdAsync (parameterized)
        ModelRow f1 = model.FindById(db, 1);
        Check("find by id sync", f1.Get("title") == "Hello Zan");

        ModelRow f2 = await model.FindByIdAsync(db, 2);
        Check("find by id async", f2.Get("title") == "Async ORM");

        ModelRow f3 = await model.FindByIdAsync(db, 3);
        Check("find by id special", f3.Get("title") == "Param Injection Test'--");

        ModelRow fNone = await model.FindByIdAsync(db, 9999);
        Check("find by id missing", fNone.GetKeys().Count == 0);

        // 6. ModelQuery Select, ExecuteAsync, FirstAsync, CountAsync, AnyAsync
        ModelQuery q = model.Select(db).WhereEq("title", "Async ORM");
        Check("query any async", await q.AnyAsync());
        Check("query count async", await q.CountAsync() == 1);

        List<ModelRow> rows = await q.ExecuteAsync();
        Check("query execute async count", rows.Count == 1);
        Check("query execute async val", rows[0].Get("views") == "25");

        ModelRow first = await model.Select(db).Where("views > 20").OrderBy("views").FirstAsync();
        Check("query first async", first.Get("title") == "Async ORM");

        // 7. ModelUpdate ExecuteAsync
        int upAff = await model.UpdateQuery(db).SetInt("views", 100).WhereEq("title", "Async ORM").ExecuteAsync();
        Check("update async", upAff == 1);
        ModelRow upRow = await model.FindByIdAsync(db, 2);
        Check("updated value", upRow.Get("views") == "100");

        // 8. DeleteById & DeleteByIdAsync (parameterized)
        model.DeleteById(db, 1);
        Check("delete by id sync", model.Count(db) == 2);

        int delAff = await model.DeleteByIdAsync(db, 2);
        Check("delete by id async", delAff == 1 && await model.CountAsync(db) == 1);

        // 9. ModelDelete ExecuteAsync
        int delAff2 = await model.DeleteQuery(db).WhereEq("title", "Param Injection Test'--").ExecuteAsync();
        Check("model delete async", delAff2 == 1);
        Check("final count 0", await model.CountAsync(db) == 0);

        // 10. AllAsync & DropTableAsync
        List<ModelRow> allEmpty = await model.AllAsync(db);
        Check("all async empty", allEmpty.Count == 0);

        int dropRes = await model.DropTableAsync(db);
        Check("table dropped", !await model.TableExistsAsync(db));

        db.Close();
        File.Delete(dbPath);

        Console.WriteLine("pass: " + Convert.ToString(pass));
        Console.WriteLine("fail: " + Convert.ToString(fail));
    }

    static async void Main() {
        RunTests();
    }
}
