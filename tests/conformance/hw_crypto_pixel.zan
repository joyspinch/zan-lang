using System;
using System.Drawing;
using System.Security.Cryptography;

class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            failures = failures + 1;
        }
    }

    static void TestSha256() {
        // Test 1: Empty string
        byte[] h0 = Sha256.Hash("", 0);
        string hex0 = Hex.Encode(h0);
        Check(hex0 == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "sha256 empty");

        // Test 2: "hello world"
        string msg = "hello world";
        byte[] h1 = Sha256.Hash(msg, msg.Length);
        string hex1 = Hex.Encode(h1);
        Check(hex1 == "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9", "sha256 hello world");

        // Test 3: NativeMemory.Sha256 intrinsic 的双路径契约：有硬件时内核
        // 结果须与向量一致；返回 null（本机无引擎）时纯 Zan 回退须与向量一致。
        string nmHash = NativeMemory.Sha256(msg, (long)msg.Length);
        bool nmOk = nmHash != null
            ? Hex.Encode(nmHash.ToBytes()) == "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9"
            : Hex.Encode(Sha256.Hash(msg, msg.Length)) == "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9";
        Check(nmOk, "native memory sha256");
    }

    static void TestMd5() {
        byte[] h0 = Md5.Hash("", 0);
        string hex0 = Hex.Encode(h0);
        Check(hex0 == "d41d8cd98f00b204e9800998ecf8427e", "md5 empty");

        string msg = "hello world";
        byte[] h1 = Md5.Hash(msg, msg.Length);
        string hex1 = Hex.Encode(h1);
        Check(hex1 == "5eb63bbbe01eeed093cb22bb8f5acdc3", "md5 hello world");

        // MD5 没有任何硬件指令引擎（x86/ARM 均无），内建已删除，纯 Zan 是唯一实现。
    }

    static void TestAesCbc() {
        string key = "0123456789abcdef"; // 16 bytes
        string iv  = "1234567890abcdef"; // 16 bytes
        string plain = "Hardware Accelerated Zan Engine 2026";
        int plainLen = plain.Length;

        List<int> outLen = new List<int>();
        outLen.Add(0);

        byte[] cipher = Aes.EncryptCbc(key, 16, iv, plain, plainLen, outLen);
        Check(cipher != null, "aes cbc encrypt non-null");
        Check(outLen[0] == 48, "aes cbc padded len");

        string cipherStr = cipher;
        List<int> decLen = new List<int>();
        decLen.Add(0);

        byte[] dec = Aes.DecryptCbc(key, 16, iv, cipherStr, outLen[0], decLen);
        Check(dec != null, "aes cbc decrypt non-null");
        Check(decLen[0] == plainLen, "aes cbc dec plain len");

        string decStr = dec.ToStr(0, decLen[0]);
        Check(decStr == plain, "aes cbc roundtrip match");
    }

    static void TestPixelOps() {
        // Test FillRect
        nint buf = NativeMemory.Alloc(16 * 4); // 4x4 image
        PixelOps.FillRect(buf, 16, 0, 0, 4, 4, 16711935); // 0x00FF00FF
        Span<int> px = new Span<int>(buf, 16);
        bool fillOk = true;
        for (int i = 0; i < 16; i = i + 1) {
            if (px[i] != 16711935) { fillOk = false; }
        }
        Check(fillOk, "pixelops fillrect");

        // Test SwapRB: 0x00FF0000 (Red) -> 0x000000FF (Blue)
        px[0] = 16711680; // 0x00FF0000
        PixelOps.SwapRB(buf, buf, 1);
        Check(px[0] == 255, "pixelops swaprb");

        NativeMemory.Free(buf);
    }

    static void TestSm3() {
        string msg = "abc";
        byte[] hash = Sm3.Hash(msg, msg.Length);
        Check(Hex.Encode(hash) == "66c7f0f462eeedd9d1f2d46bdc10e4e24167c4875cf2f7a2297da02b8f4ba8e0", "sm3 standard vector abc");

        // SM3 同一双路径契约（x86 无 SM3 引擎恒走回退臂；ARM FEAT_SM3 落地后走内核臂）
        string nmHash = NativeMemory.Sm3(msg, (long)msg.Length);
        bool smOk = nmHash != null
            ? Hex.Encode(nmHash.ToBytes()) == "66c7f0f462eeedd9d1f2d46bdc10e4e24167c4875cf2f7a2297da02b8f4ba8e0"
            : Hex.Encode(Sm3.Hash(msg, msg.Length)) == "66c7f0f462eeedd9d1f2d46bdc10e4e24167c4875cf2f7a2297da02b8f4ba8e0";
        Check(smOk, "native memory sm3");
    }

    static void TestSm4() {
        string key = "0123456789abcdef"; // 16 bytes
        string iv  = "fedcba9876543210"; // 16 bytes
        string plain = "Hardware Accelerated SM4 T-Table Engine!";
        int plainLen = plain.Length;

        List<int> outLen = new List<int>();
        outLen.Add(0);

        byte[] cipher = Sm4.EncryptCbc(key, iv, plain, plainLen, outLen);
        Check(cipher != null, "sm4 cbc encrypt non-null");
        Check(outLen[0] == 48, "sm4 cbc padded len");

        string cipherStr = cipher;
        List<int> decLen = new List<int>();
        decLen.Add(0);

        byte[] dec = Sm4.DecryptCbc(key, iv, cipherStr, outLen[0], decLen);
        Check(dec != null, "sm4 cbc decrypt non-null");
        Check(decLen[0] == plainLen, "sm4 cbc dec plain len");

        string decStr = dec.ToStr(0, decLen[0]);
        Check(decStr == plain, "sm4 cbc roundtrip match");
    }

    static void TestBase64() {
        string msg = "Hardware Accelerated Base64 Pipeline Verification 1234567890!";
        byte[] raw = msg.ToBytes();
        string b64 = Convert.ToBase64String(raw);
        byte[] dec = Convert.FromBase64String(b64);
        Check(dec != null && dec.ToStr(0, dec.Length) == msg, "convert base64 roundtrip");

        string b64_2 = Base64.Encode(msg, msg.Length);
        Check(b64_2 == b64, "base64 encode match convert");
        List<int> outLen = new List<int>();
        outLen.Add(0);
        byte[] dec2 = Base64.Decode(b64_2, outLen);
        Check(dec2 != null && outLen[0] == msg.Length && dec2.ToStr(0, outLen[0]) == msg, "base64 decode match");
    }

    static void Main() {
        TestSha256();
        TestMd5();
        TestAesCbc();
        TestSm3();
        TestSm4();
        TestPixelOps();
        TestBase64();
        Console.WriteLine("failures=" + Convert.ToString(failures));
    }
}
