using System;
using System.Collections.Generic;
using Game.Kit;

// 测试用的自定义作弊命令
public class TestGodCmd : IDebugCommandHandler {
    public bool godModeTriggered = false;

    public void Execute(DebugConsole console, string cmd, List<string> args) {
        godModeTriggered = true;
        console.LogSuccess("God mode enabled!");
    }
}

public class TestGoldCmd : IDebugCommandHandler {
    public int goldAdded = 0;

    public void Execute(DebugConsole console, string cmd, List<string> args) {
        if (args.Count > 0) {
            goldAdded = Convert.ToInt32(args[0]);
            console.LogSuccess("Added gold: " + Convert.ToString(goldAdded));
        }
    }
}

public class Program {
    private static void Check(string label, bool condition) {
        if (condition) {
            Console.WriteLine("[PASS] " + label);
        } else {
            Console.WriteLine("[FAIL] " + label);
        }
    }

    public static void Main() {
        DebugConsole console = new DebugConsole();
        Check("Console_InitClosed", !console.isOpen);

        // 切换显隐
        console.Toggle();
        Check("Console_ToggleOpen", console.isOpen);

        // 注册自定义指令
        TestGodCmd godCmd = new TestGodCmd();
        console.Register("god", "Toggle invincibility", godCmd);

        TestGoldCmd goldCmd = new TestGoldCmd();
        console.Register("give_gold", "Add gold amount", goldCmd);

        // 执行自定义指令
        console.SubmitCommand("god");
        Check("Console_GodCmd", godCmd.godModeTriggered);

        console.SubmitCommand("give_gold 9999");
        Check("Console_GoldCmd", goldCmd.goldAdded == 9999);

        // 测试内置 echo
        int logsBefore = console.logs.Count;
        console.SubmitCommand("echo Hello Zan Game Engine");
        Check("Console_EchoCmd", console.logs.Count == logsBefore + 2); // 1 for input prompt, 1 for echo output

        // 测试未知指令
        console.SubmitCommand("nonexistent_command_xyz");
        DebugConsole.ConsoleLogEntry lastLog = console.logs[console.logs.Count - 1];
        Check("Console_UnknownCmd", lastLog.text.Contains("Unknown command"));

        // 测试按键拦截
        console.isOpen = true;
        bool consumed1 = console.HandleKeyDown(65, 'a');
        Check("Console_KeyConsumedWhenOpen", consumed1 && console.inputBuffer == "a");

        console.isOpen = false;
        bool consumed2 = console.HandleKeyDown(65, 'a');
        Check("Console_KeyBypassedWhenClosed", !consumed2);

        // 测试 clear
        console.SubmitCommand("clear");
        Check("Console_ClearLogs", console.logs.Count == 0);

        Console.WriteLine("ALL DEBUG CONSOLE TESTS PASSED.");
    }
}
