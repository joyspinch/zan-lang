using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static int disposedHits;
    static int updatedHits;

    static void OnDisposed() { Program.disposedHits = Program.disposedHits + 1; }
    static void OnUpdated() { Program.updatedHits = Program.updatedHits + 1; }

    static void Main() {
        ChartOption option = ChartOption.Line("CPU", new List<string>{"A"});
        option.Add("load", new List<int>{10});
        ChartController model = ChartController.Of(option);
        ChartView view = ChartView.BindKeyed(model, 91);
        view.OnDisposed(Program.OnDisposed).OnUpdated(Program.OnUpdated);
        Console.WriteLine("factory:" + model.Status() + ":"
            + view.Status() + ":" + Convert.ToString(view.GetOption() != null));

        model.ShowLoading("fetching");
        Console.WriteLine("status:" + view.Status() + ":" + view.StatusMessage());
        ChartOption snap = view.GetOption();
        snap.title = "changed";
        Console.WriteLine("snapshot:" + model.Option().title + ":" + snap.title);

        view.SetOption(ChartOption.Bar("Next", new List<string>{"X"}));
        Console.WriteLine("set:" + model.Option().title + ":"
            + Convert.ToString(model.Version()) + ":" + view.Status());
        view.Restore();
        Console.WriteLine("restore:" + model.Option().title + ":"
            + Convert.ToString(model.Option().series.Count));

        view.Dispose();
        view.Dispose();
        Console.WriteLine("dispose:" + Convert.ToString(Program.disposedHits)
            + ":" + Convert.ToString(!model.IsDisposed()) + ":"
            + Convert.ToString(Program.updatedHits));

        ChartView direct = ChartView.Of(ChartOption.Line("Direct", new List<string>{"A"}));
        direct.ShowLoading("waiting");
        Console.WriteLine("direct-loading:" + direct.Status() + ":" + direct.StatusMessage());
        direct.SetEmptyMessage("No points");
        Console.WriteLine("direct-empty:" + direct.Status() + ":" + direct.StatusMessage());
        direct.SetOption(ChartOption.Bar("DirectNext", new List<string>{"B"}));
        direct.Clear();
        Console.WriteLine("direct-clear:" + direct.Status() + ":"
            + direct.GetOption().title + ":"
            + Convert.ToString(direct.GetOption().series.Count));
        direct.Restore();
        Console.WriteLine("direct-restore:" + direct.Status() + ":"
            + direct.GetOption().title + ":"
            + Convert.ToString(direct.IsDisposed()));
        direct.Dispose();
        Console.WriteLine("direct-dispose:" + direct.Status() + ":"
            + Convert.ToString(direct.IsDisposed()));
    }
}
