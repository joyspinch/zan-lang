using System;
using System.Collections.Generic;
using Game.Net;

namespace Conf;

class MultiplayerTournamentInvitePingTest {
    static void Main() {
        // 1. 单败淘汰锦标赛 4 强赛程树：半决赛胜者自动晋级决赛并决出总冠军
        NetSingleElimBracket bracket = new NetSingleElimBracket(4);
        List<int> seeds = new List<int>();
        seeds.Add(10); seeds.Add(11); seeds.Add(12); seeds.Add(13);
        bool seeded = bracket.SeedFirstRound(seeds);
        bool semi1 = bracket.ReportWinner(2, 11); // 半决赛 #2: 11 胜
        bool semi2 = bracket.ReportWinner(3, 12); // 半决赛 #3: 12 胜
        TournamentMatchSlot finalSlot = bracket.GetMatch(1);
        bool finalReady = finalSlot != null && finalSlot.PlayerA == 11 && finalSlot.PlayerB == 12;
        bool invalidWinnerBlocked = !bracket.ReportWinner(1, 10);
        bool finalDone = bracket.ReportWinner(1, 12);

        bool tourneyOk = seeded && semi1 && semi2 && finalReady && invalidWinnerBlocked
            && finalDone && bracket.ChampionId == 12;
        Console.WriteLine("net-single-elim-bracket: " + Convert.ToString(tourneyOk ? 1 : 0));

        // 2. 限时组队邀请代理：防重复发邀、撤回作废、过期拒收与满员上限拦截
        NetPartyInviteBroker broker = new NetPartyInviteBroker(3, 1);
        int inv1 = broker.SendInvite(1, 20, 1000L, 5000L);
        int dupBlocked = broker.SendInvite(1, 20, 2000L, 5000L); // 有效邀请期内拒重
        bool acc1 = broker.AcceptInvite(inv1, 20, 3000L);        // 人数 1 -> 2

        int inv2 = broker.SendInvite(1, 21, 3000L, 2000L);       // 到期 5000L
        bool expiredRejected = !broker.AcceptInvite(inv2, 21, 6000L);

        int inv3 = broker.SendInvite(1, 22, 6000L, 5000L);
        bool revoked = broker.RevokeInvite(inv3, 1);
        bool revokedRejected = !broker.AcceptInvite(inv3, 22, 7000L);

        int inv4 = broker.SendInvite(1, 23, 7000L, 5000L);
        bool acc4 = broker.AcceptInvite(inv4, 23, 8000L);        // 人数 2 -> 3 (满员)
        int fullBlocked = broker.SendInvite(1, 24, 9000L, 5000L);

        bool inviteOk = inv1 == 1 && dupBlocked == 0 && acc1 && expiredRejected
            && revoked && revokedRejected && acc4 && fullBlocked == 0 && broker.CurrentPartySize == 3;
        Console.WriteLine("net-party-invite-broker: " + Convert.ToString(inviteOk ? 1 : 0));

        // 3. 战术地图标记通道：单人 5 秒最多 3 次防刷屏 + 8 秒超时自动清理
        NetTacticalPingChannel ch = new NetTacticalPingChannel(3, 5000L, 8000L);
        bool p1 = ch.EmitPing(7, "Danger", 10.0f, 20.0f, 1000L);
        bool p2 = ch.EmitPing(7, "Assist", 12.0f, 22.0f, 2000L);
        bool p3 = ch.EmitPing(7, "Loot",   14.0f, 24.0f, 3000L);
        bool spamBlocked = !ch.EmitPing(7, "Danger", 15.0f, 25.0f, 4000L);
        bool otherAllowed = ch.EmitPing(8, "OnMyWay", 16.0f, 26.0f, 4000L);
        int pruned = ch.PruneExpired(10500L); // 1000L 与 2000L 均 >= 8000ms 过期

        bool pingOk = p1 && p2 && p3 && spamBlocked && otherAllowed
            && pruned == 2 && ch.ActiveCount() == 2;
        Console.WriteLine("net-tactical-ping-channel: " + Convert.ToString(pingOk ? 1 : 0));
    }
}
