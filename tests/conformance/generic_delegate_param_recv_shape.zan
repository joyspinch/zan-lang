using System;

/* A delegate parameter written over the class's own type parameters must be
 * substituted for the receiver's instantiation whatever shape the receiver
 * expression has. Only the local-variable receiver did that, so an untyped
 * lambda passed through a static field / field / call-result receiver kept the
 * bare type parameter and its body read the wrong object: the accessor was
 * called with garbage and silently produced empty values. */
delegate string TextOf<T>(T item);

class Col<T> {
    TextOf<T> read;
    T item;

    public string Show() { return this.read(this.item); }
}

class Table<T> {
    List<Col<T>> cols;

    public Table() { this.cols = new List<Col<T>>(); }

    public void Add(T item, TextOf<T> read) {
        Col<T> c = new Col<T>();
        c.read = read;
        c.item = item;
        cols.Add(c);
    }

    public string Text(int i) { return cols[i].Show(); }
}

class Person {
    public string name;
    public Person(string n) { this.name = n; }
}

class Holder {
    public Table<Person> t;
    public Holder() { this.t = new Table<Person>(); }
    public Table<Person> Get() { return this.t; }
}

class Program {
    static Table<Person> shared;

    static void Main() {
        Person p = new Person("ada");

        Program.shared = new Table<Person>();
        Program.shared.Add(p, x => x.name);
        Console.WriteLine("static " + Program.shared.Text(0));

        Holder h = new Holder();
        h.t.Add(p, x => x.name);
        Console.WriteLine("field " + h.t.Text(0));

        h.Get().Add(p, x => x.name);
        Console.WriteLine("call " + h.Get().Text(1));

        Table<Person> loc = new Table<Person>();
        loc.Add(p, x => x.name);
        Console.WriteLine("local " + loc.Text(0));
    }
}
