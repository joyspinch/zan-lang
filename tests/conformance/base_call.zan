using System;

/* `base.Method(args)` member calls. Two compiler halves have to agree:
 * infer_expr_type must give the AST_BASE_EXPR receiver the *base class*
 * static type so the method resolves through the inheritance chain, and
 * the call site must bind to the base implementation *statically* —
 * normal vtable dispatch would load the slot of the very override being
 * executed and recurse until the stack overflows. */
class Shape {
    public virtual string Name() { return "shape"; }
    public virtual int Area() { return 0; }
}

class Rect : Shape {
    int w;
    int h;

    public Rect(int w, int h) {
        this.w = w;
        this.h = h;
    }

    public override string Name() { return base.Name() + "/rect"; }
    public override int Area() { return this.w * this.h; }
}

class Labeled : Rect {
    string label;

    public Labeled(string label, int w, int h) : base(w, h) {
        this.label = label;
    }

    /* Two-level chain: Labeled.base.Name() must hit Rect.Name(), which
     * itself calls Shape.Name() via base. */
    public override string Name() { return this.label + ":" + base.Name(); }
}

class BaseFlow {
    string state;

    public virtual void Reset(string tag) {
        this.state = "";
    }

    public string State() { return this.state; }
}

class VoidOnly : BaseFlow {
    public override void Reset(string tag) {
        this.state = tag;
        base.Reset(tag);
    }
}

class Program {
    static void Main() {
        Shape s = new Rect(3, 4);
        Console.WriteLine(s.Name());
        Console.WriteLine(Convert.ToString(s.Area()));

        Labeled l = new Labeled("box", 2, 5);
        Console.WriteLine(l.Name());
        Console.WriteLine(Convert.ToString(l.Area()));

        VoidOnly v = new VoidOnly();
        v.Reset("live");
        /* base.Reset runs after the derived store, so the base body's
         * `state = ""` wins — documents that base.Method() really does
         * execute the base body (not the override again). */
        Console.WriteLine("[" + v.State() + "]");
    }
}
