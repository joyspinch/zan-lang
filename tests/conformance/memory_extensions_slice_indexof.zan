using System;

class Program {
    static int pass = 0;
    static int fail = 0;

    static void Check(string name, bool ok) {
        if (ok) {
            pass = pass + 1;
        } else {
            fail = fail + 1;
            Console.WriteLine("FAIL " + name);
        }
    }

    static void Main() {
        byte[] data = new byte[100];
        for (int i = 0; i < 100; i = i + 1) {
            data[i] = (byte)65; // 'A'
        }
        data[25] = (byte)13; // '\r'
        data[26] = (byte)10; // '\n'
        data[75] = (byte)13;
        data[76] = (byte)10;

        // Bounded search: before first target
        Check("bounded-before", MemoryExtensions.IndexOf(data, (byte)13, 0, 20) == -1);

        // Bounded search: reaching first target
        Check("bounded-reach-1", MemoryExtensions.IndexOf(data, (byte)13, 0, 26) == 25);
        Check("bounded-reach-exact", MemoryExtensions.IndexOf(data, (byte)13, 25, 1) == 25);

        // Bounded search: between targets
        Check("bounded-middle", MemoryExtensions.IndexOf(data, (byte)13, 27, 40) == -1);

        // Bounded search: reaching second target
        Check("bounded-reach-2", MemoryExtensions.IndexOf(data, (byte)13, 27, 50) == 75);

        // Bounded IndexOfAny
        Check("any-bounded-before", MemoryExtensions.IndexOfAny(data, (byte)13, (byte)10, 0, 20) == -1);
        Check("any-bounded-hit-first", MemoryExtensions.IndexOfAny(data, (byte)13, (byte)10, 20, 10) == 25);
        Check("any-bounded-hit-second", MemoryExtensions.IndexOfAny(data, (byte)13, (byte)10, 26, 10) == 26);

        // Unbounded backward-compatible overloads
        Check("unbounded-1", MemoryExtensions.IndexOf(data, (byte)13, 0) == 25);
        Check("unbounded-2", MemoryExtensions.IndexOf(data, (byte)13, 26) == 75);
        Check("unbounded-any", MemoryExtensions.IndexOfAny(data, (byte)10, (byte)99, 0) == 26);

        Console.WriteLine("pass=" + Convert.ToString(pass) + " fail=" + Convert.ToString(fail));
    }
}
