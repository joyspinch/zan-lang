using System;
using System.Platform;
using System.Threading;

class Program {
    static int Main() {
        Console.WriteLine("pal_threading_smoke start");

        // 1. PAL Threading 单例
        IPlatformThreading th = Pal.Threading;
        if (th == null) {
            Console.WriteLine("FAIL: Pal.Threading is null");
            return 1;
        }

        // 2. 底层 PAL Mutex 生命周期
        nint mtx = th.CreateMutex();
        if (mtx == 0) {
            Console.WriteLine("FAIL: th.CreateMutex returned 0");
            return 1;
        }
        th.LockMutex(mtx);
        th.UnlockMutex(mtx);
        th.DestroyMutex(mtx);

        // 3. 上层 System.Threading.Mutex 对齐
        Mutex m = new Mutex();
        m.WaitOne();
        m.ReleaseMutex();
        m.Dispose();

        // 4. 底层 PAL Semaphore 行为
        nint sem = th.CreateSemaphore(1, 2);
        if (sem == 0) {
            Console.WriteLine("FAIL: th.CreateSemaphore returned 0");
            return 1;
        }
        // 初始已有 1 个许可，WaitFor 应立即成功
        if (!th.WaitForSemaphore(sem, 100)) {
            Console.WriteLine("FAIL: initial WaitForSemaphore failed");
            return 1;
        }
        // 此时已无许可，带超时的等待应返回 false
        if (th.WaitForSemaphore(sem, 20)) {
            Console.WriteLine("FAIL: WaitForSemaphore should timeout when empty");
            return 1;
        }
        // 归还许可后 Wait 应不阻塞
        th.ReleaseSemaphore(sem);
        th.WaitSemaphore(sem);
        th.DestroySemaphore(sem);

        // 5. 上层 System.Threading.Semaphore 门面
        nint s = Semaphore.Create(2, 2);
        if (s == 0) {
            Console.WriteLine("FAIL: Semaphore.Create returned 0");
            return 1;
        }
        Semaphore.Wait(s);
        if (!Semaphore.WaitFor(s, 50)) {
            Console.WriteLine("FAIL: Semaphore.WaitFor second permit failed");
            return 1;
        }
        if (Semaphore.WaitFor(s, 20)) {
            Console.WriteLine("FAIL: Semaphore.WaitFor third permit should timeout");
            return 1;
        }
        Semaphore.Release(s);
        Semaphore.Release(s);
        Semaphore.Destroy(s);

        // 6. 线程休眠与 Thread.Sleep
        th.Sleep(5);
        Thread.Sleep(5);

        // 7. 线程 ID
        long tid = Thread.CurrentId();
        if (tid == 0) {
            Console.WriteLine("FAIL: Thread.CurrentId() returned 0");
            return 1;
        }

        Console.WriteLine("pal_threading_smoke ok");
        return 0;
    }
}
