using System;
using System.Drawing;

class Program {
    static int pass = 0;
    static int fail = 0;

    static void Check(string name, bool ok) {
        if (ok) { pass = pass + 1; }
        else { fail = fail + 1; Console.WriteLine("FAIL " + name); }
    }

    static void Main() {
        // 1. Allocation, Clear & FillRect
        ImageBuffer img = new ImageBuffer(40, 40);
        Check("width", img.Width == 40);
        Check("height", img.Height == 40);
        Check("stride", img.Stride == 160);
        Check("pixels", img.Pixels != 0);

        img.Clear((int)0xFFFF0000);
        Span<int> sp = new Span<int>(img.Pixels, 1600);
        Check("clear-red-0", sp[0] == (int)0xFFFF0000);
        Check("clear-red-last", sp[1599] == (int)0xFFFF0000);

        img.FillRect(10, 10, 10, 10, (int)0xFF00FF00);
        Check("fill-inside", sp[10 * 40 + 10] == (int)0xFF00FF00);
        Check("fill-inside-edge", sp[19 * 40 + 19] == (int)0xFF00FF00);
        Check("fill-outside-pre", sp[9 * 40 + 10] == (int)0xFFFF0000);
        Check("fill-outside-post", sp[20 * 40 + 20] == (int)0xFFFF0000);

        // 核心契约与语义定义。
        ImageBuffer crop = img.Crop(10, 10, 10, 10);
        Check("crop-w", crop.Width == 10);
        Check("crop-h", crop.Height == 10);
        Span<int> csp = new Span<int>(crop.Pixels, 100);
        Check("crop-pixel-0", csp[0] == (int)0xFF00FF00);
        Check("crop-pixel-last", csp[99] == (int)0xFF00FF00);
        crop.Dispose();

        // 3. SwapRB
        img.FillRect(0, 0, 1, 1, (int)0xFF112233);
        img.SwapRB();
        Check("swap-rb-1", sp[0] == (int)0xFF332211);
        img.SwapRB();
        Check("swap-rb-2", sp[0] == (int)0xFF112233);

        // 核心契约与执行状态转移规范。
        ImageBuffer icon = new ImageBuffer(4, 4);
        icon.Clear((int)0x80FFFFFF); // 50% white
        img.Clear((int)0xFF000000);   // solid black
        img.Blit(icon, 2, 2, true);
        int blended = sp[2 * 40 + 2];
        int bA = (blended >> 24) & 0xFF;
        int bR = (blended >> 16) & 0xFF;
        int bG = (blended >> 8) & 0xFF;
        int bB = blended & 0xFF;
        Check("alpha-blit-a", bA == 255);
        Check("alpha-blit-r", bR >= 126 && bR <= 130);
        Check("alpha-blit-g", bG >= 126 && bG <= 130);
        Check("alpha-blit-b", bB >= 126 && bB <= 130);
        icon.Dispose();

        // 核心契约与执行状态转移规范。
        ImageBuffer sm = new ImageBuffer(2, 2);
        Span<int> smp = new Span<int>(sm.Pixels, 4);
        smp[0] = (int)0xFF000000;
        smp[1] = (int)0xFFFF0000;
        smp[2] = (int)0xFF00FF00;
        smp[3] = (int)0xFF0000FF;

        ImageBuffer rz = sm.Resize(4, 4);
        Check("resize-w", rz.Width == 4);
        Check("resize-h", rz.Height == 4);
        Span<int> rsp = new Span<int>(rz.Pixels, 16);
        Check("resize-c00", rsp[0] == (int)0xFF000000);
        Check("resize-c01", rsp[3] == (int)0xFFFF0000);
        Check("resize-c10", rsp[12] == (int)0xFF00FF00);
        Check("resize-c11", rsp[15] == (int)0xFF0000FF);
        int rzMid = rsp[1 * 4 + 1];
        Check("resize-mid-a", ((rzMid >> 24) & 0xFF) == 255);

        sm.Dispose();
        rz.Dispose();
        img.Dispose();

        Console.WriteLine("pass: " + Convert.ToString(pass));
        Console.WriteLine("fail: " + Convert.ToString(fail));
    }
}
