using System;
using System.Collections.Generic;
using System.Linq;

class Program {
    static void Main() {
        List<int> numbers = new List<int>();
        for (int i = 1; i <= 10; i = i + 1) {
            numbers.Add(i);
        }

        Console.WriteLine("[1] ValueEnumerable basic count & any");
        var valEnum = numbers.AsValueEnumerable();
        Console.WriteLine("Count: " + Convert.ToString(valEnum.Count()));
        Console.WriteLine("Any: " + (valEnum.Any() ? "true" : "false"));
        Console.WriteLine("First: " + Convert.ToString(valEnum.First()));

        Console.WriteLine("[2] ValueWhereIterator");
        var oddIter = valEnum.Where(x => x % 2 != 0);
        Console.WriteLine("Odd Count: " + Convert.ToString(oddIter.Count()));
        Console.WriteLine("Odd First: " + Convert.ToString(oddIter.First()));

        Console.WriteLine("[3] Duck-typed foreach over ValueWhereIterator");
        foreach (int v in oddIter) {
            Console.WriteLine("odd: " + Convert.ToString(v));
        }

        Console.WriteLine("[4] ValueSelectIterator & chaining");
        var mappedIter = oddIter.Select<int>(x => x * 10);
        Console.WriteLine("Mapped First: " + Convert.ToString(mappedIter.First()));
        foreach (int m in mappedIter) {
            Console.WriteLine("mapped: " + Convert.ToString(m));
        }

        Console.WriteLine("[5] ValueSkipIterator & ValueTakeIterator");
        var skipped = valEnum.Skip(3);
        Console.WriteLine("Skipped First: " + Convert.ToString(skipped.First()));
        var taken = skipped.Take(2);
        Console.WriteLine("Taken Count: " + Convert.ToString(taken.Count()));
        foreach (int t in taken) {
            Console.WriteLine("taken: " + Convert.ToString(t));
        }

        Console.WriteLine("[6] ToList evaluation");
        List<int> finalResults = oddIter.ToList();
        Console.WriteLine("Final List Count: " + Convert.ToString(finalResults.Count));

        Console.WriteLine("OK: all value enumerable checks passed!");
    }
}
