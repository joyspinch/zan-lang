using System;
using System.IO;

public class Program {
    static int Main() {
        string dir = "_scratch/fmt_test";
        if (!Directory.Exists(dir)) {
            Directory.CreateDirectory(dir);
        }
        string crlfFile = $"{dir}/crlf_sample.zan";
        // 构造一个合规格式化但行尾为 CRLF 的代码文件
        string content = "public class Sample {\r\n    static void Foo() {\r\n    }\r\n}\r\n";
        File.WriteAllText(crlfFile, content);

        // 读回并校验换行符包含 \r
        string readBack = File.ReadAllText(crlfFile);
        if (!readBack.Contains("\r")) {
            Console.WriteLine("FAIL: test file does not contain carriage return");
            return 1;
        }

        // 归一化对比逻辑（模拟 ZanFmt --check 逻辑）
        string normalized = readBack.Replace("\r\n", "\n");
        if (normalized.Contains("\r")) {
            Console.WriteLine("FAIL: normalization failed to remove carriage return");
            return 1;
        }

        Console.WriteLine("fmt-check-crlf-ok: 1");
        return 0;
    }
}
