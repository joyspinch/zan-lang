using System;
using Gui.Component.Chart;

namespace Conf;

/// 每个 ChartType 与 custom kind 都映射到一个显式渲染键；
/// 未知/空/全部隐藏没有回退为折线图。这是
/// 阶段 7"显式分发、删回退"在阶段 1 的确定性锚点。
class Program {
    static string Kind(ChartSeries s) {
        return ChartView.DispatchKind(ChartOption.Single(s));
    }

    static void Main() {
        // 17 个原生类型逐一映射到显式键。
        Console.WriteLine(Kind(ChartSeries.Line("l", new List<int>{1})));
        Console.WriteLine(Kind(ChartSeries.Bar("b", new List<int>{1})));
        Console.WriteLine(Kind(ChartSeries.Pie("p", new List<int>{1})));
        Console.WriteLine(Kind(ChartSeries.Of("s", ChartType.Scatter, new List<int>{1})));
        Console.WriteLine(Kind(ChartSeries.Of("k", ChartType.K, new List<int>{1})));
        Console.WriteLine(Kind(ChartSeries.Polar("r", new List<int>{1})));
        Console.WriteLine(Kind(ChartSeries.Chord("c", new List<ChartLink>())));
        Console.WriteLine(Kind(ChartSeries.Force("f", new List<ChartLink>())));
        Console.WriteLine(Kind(ChartSeries.OfRegions("m", new List<ChartMapRegion>())));
        Console.WriteLine(Kind(ChartSeries.Gauge("g", 1)));
        Console.WriteLine(Kind(ChartSeries.Funnel("fu", new List<int>{1})));
        Console.WriteLine(Kind(ChartSeries.OfEvents("e", new List<ChartEvent>())));
        Console.WriteLine(Kind(ChartSeries.Of("t", ChartType.Treemap, new List<int>{1})));
        Console.WriteLine(Kind(ChartSeries.Of("tr", ChartType.Tree, new List<int>{1})));
        Console.WriteLine(Kind(ChartSeries.WordCloud("w", new List<ChartData>{})));
        Console.WriteLine(Kind(ChartSeries.Of("h", ChartType.Heatmap, new List<int>{1})));

        // custom kinds：每个扩展渲染器都有显式键。
        Console.WriteLine(Kind(ChartSeries.OfLinks("x", new List<ChartLink>{})));
        Console.WriteLine(Kind(ChartSeries.OfBoxes("x", new List<BoxItem>{})));
        Console.WriteLine(Kind(ChartSeries.OfErrors("x", new List<ErrorItem>{})));
        Console.WriteLine(Kind(ChartSeries.Waterfall("x", new List<ChartData>{})));
        Console.WriteLine(Kind(ChartSeries.SunburstTree("x", ChartNode.Leaf("a", 1))));
        Console.WriteLine(Kind(ChartSeries.RadialBars("x", 1)));
        Console.WriteLine(Kind(ChartSeries.Venn("v", new List<ChartData>{})));

        // 未知 custom kind：显式空状态，不落折线图。
        Console.WriteLine(Kind(ChartSeries.Of("x", ChartType.Custom, new List<int>{1})));

        // 系列子实体改变引导键。
        Console.WriteLine(Kind(ChartSeries.Rose("r", new List<int>{1})));
        Console.WriteLine(Kind(ChartSeries.StackedBar("sb", new List<int>{1})));
        Console.WriteLine(Kind(ChartSeries.HBar("hb", new List<int>{1})));
        Console.WriteLine(Kind(ChartSeries.OfBubbles("s", new List<Bubble>{ Bubble.Of(1, 2, 3) })));
        Console.WriteLine(Kind(ChartSeries.StackedArea("sa", new List<int>{1})));

        // 空选项与全部隐藏：明确空状态。
        Console.WriteLine(ChartView.DispatchKind(ChartOption.Of(new List<ChartSeries>{})));
        ChartSeries hiddenPie = ChartSeries.Pie("hp", new List<int>{1});
        hiddenPie.hidden = true;
        Console.WriteLine(ChartView.DispatchKind(ChartOption.Single(hiddenPie)));
    }
}
