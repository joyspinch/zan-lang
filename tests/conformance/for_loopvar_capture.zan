using System;
using System.Collections.Generic;

// A variable declared in a `for` init clause is captured per
// iteration (Go 1.22): a closure created in the body takes a fresh cell with
// the variable's value at capture time, so storing delegates in a loop
// captures 0, 1, 2 -- not three references to the one loop-carried cell that
// ends at 3. The loop machinery itself is untouched: the variable still
// steps, breaks, continues, and shadows normally, and the declaring scope
// releases what its closures do not keep.
delegate int Read();
delegate string ReadText();

class Program {
    static void Main(string[] args) {
        // classic case: 0, 1, 2
        var fs = new List<Read>();
        for (int i = 0; i < 3; i = i + 1) {
            fs.Add(() => i);
        }
        foreach (Read f in fs) Console.WriteLine(Convert.ToString(f()));

        // the snapshot is the iteration's value: 0, 10, 20
        var gs = new List<Read>();
        for (int j = 0; j < 3; j = j + 1) {
            gs.Add(() => j * 10);
        }
        foreach (Read g in gs) Console.WriteLine(Convert.ToString(g()));

        // the loop variable still steps, breaks and continues normally
        int sum = 0;
        for (int k = 0; k < 10; k = k + 1) {
            if (k == 8) break;
            if (k % 2 == 0) continue;
            sum = sum + k;
        }
        Console.WriteLine(Convert.ToString(sum));

        // nested loops with same-named variables bind separately
        int trace = 0;
        for (int n = 0; n < 2; n = n + 1) {
            for (int m = 0; m < 3; m = m + 1) {
                trace = trace + 1;
            }
        }
        Console.WriteLine(Convert.ToString(trace));

        // an rc-managed payload (string) is retained into the fresh cell and
        // released with it: a, aa, aaa
        var hs = new List<ReadText>();
        for (string w = "a"; w != "aaaa"; w = w + "a") {
            hs.Add(() => w);
        }
        foreach (ReadText h in hs) Console.WriteLine(h());

        // foreach variables were already value-captured: 7, 8, 9
        var es = new List<Read>();
        List<int> nums = new List<int>();
        nums.Add(7);
        nums.Add(8);
        nums.Add(9);
        foreach (int x in nums) {
            es.Add(() => x);
        }
        foreach (Read e in es) Console.WriteLine(Convert.ToString(e()));
    }
}
