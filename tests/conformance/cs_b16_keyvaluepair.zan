using System.Collections.Generic;

class Program {
    static void Main() {
        KeyValuePair<string, int> kv = new KeyValuePair<string, int>("a", 1);
        Console.WriteLine(kv.Key);
        Console.WriteLine(kv.Value);
        KVP<int, string> k2 = new KVP<int, string>(9, "nine");
        Console.WriteLine(k2.Key);
        Console.WriteLine(k2.Value);
        KeyValuePair<string, string> p = new KeyValuePair<string, string>("x", "y");
        Console.WriteLine(p.Key);
        Console.WriteLine(p.Value);
        KVP<double, long> k3 = new KVP<double, long>(3.5, 42);
        Console.WriteLine(k3.Key);
        Console.WriteLine(k3.Value);
    }
}
