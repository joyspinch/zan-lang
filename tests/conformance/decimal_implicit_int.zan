using System;

class DecimalImplicitBox {
    decimal d;
}

class Program {
    static decimal Half(decimal x) { return x / 2; }
    static decimal Seven() { return 7; }

    static void Main() {
        decimal a = 5.5m;
        decimal e = 5;
        e = 7;
        Console.WriteLine($"init+assign={e == 7}");
        Console.WriteLine($"arith={a + 5 == 10.5m}");
        Console.WriteLine($"call={Half(5) == 2.5m}");
        Console.WriteLine($"ret={Seven() == 7}");

        decimal[] arr = new decimal[2];
        arr[0] = 5;
        arr[1] = 10.5m;
        Console.WriteLine($"arr={arr[0] == 5 && arr[1] == 10.5m}");

        DecimalImplicitBox b = new DecimalImplicitBox();
        b.d = 5;
        Console.WriteLine($"field={b.d == 5}");

        decimal? n = 5;
        Console.WriteLine($"nullable={n}");

        Console.WriteLine($"replay={5.5m + 5 == 10.5m}");
    }
}
