using System;
using System.IO;
using System.Net.Sockets;
using System.Net.Tls;

/* TLS hostname verification: a client that trusts the server's CA must accept
 * the handshake when the expected hostname matches the certificate SAN, and
 * MUST reject it when the hostname does not match — even though the chain is
 * trusted. A server that only verified the chain would accept the second case.
 *
 * The certificates are generated by an out-of-band CA (openssl) and embedded
 * here so the test is self-contained: no network, no build-time openssl. */
class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            failures = failures + 1;
        }
    }

