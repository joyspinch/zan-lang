    static int PORT = 9520;

    // 服务端：接受一个 TLS 连接并回显握手结果，然后关闭。
    static async void ServerLoop(TlsContext tls) {
        TcpListener l = new TcpListener("127.0.0.1", PORT);
        l.Start();
        for (int n = 0; n < 3; n = n + 1) {
            nint sock = await l.AcceptAsync();
            if (sock < 0) { break; }
            TlsStream s = await TlsStream.AcceptAsync(tls, sock);
            if (s != null) {
                await s.RecvAsync(64);
                s.Close();
            }
            Socket.Close(sock);
        }
        l.Stop();
    }

    // 客户端：用 host 作为期望主机名建立 TLS 连接。返回握手是否成功。
    static async bool TryConnect(TlsContext ctx, string host) {
        nint sock = Socket.CreateTcp();
        Socket.SetNonBlocking(sock);
        int rc = await Socket.ConnectAsync(sock, "127.0.0.1", PORT, 5000);
        if (rc != 0) {
            Socket.Close(sock);
            return false;
        }
        TlsStream s = await TlsStream.ConnectAsync(ctx, sock, host);
        bool ok = s != null;
        if (s != null) { s.Close(); }
        Socket.Close(sock);
        return ok;
    }

    static async int Run() {
        Socket.Initialize();
        // 写出 PEM 文件（程序从 build 目录运行）。
        File.WriteAllText("tls_test_ca.pem", CA_CERT);
        File.WriteAllText("tls_test_server_cert.pem", SERVER_CERT);
        File.WriteAllText("tls_test_server_key.pem", SERVER_KEY);

        TlsContext serverTls = TlsContext.CreateServer(
            "tls_test_server_cert.pem", "tls_test_server_key.pem");
        Check(serverTls != null, "server ctx created");
        if (serverTls == null) {
            Console.WriteLine("failures=" + Convert.ToString(failures));
            return 0;
        }
        Task.Spawn(ServerLoop(serverTls));
        await Task.Delay(80);

        // 场景 1：期望主机名 = wrong.example（与证书 SAN 匹配），
        // 且信任签发 CA → 握手必须成功。
        TlsContext c1 = TlsContext.CreateClient();
        Check(c1 != null, "client ctx created");
        if (c1 != null) {
            Check(c1.AddTrustedCert("tls_test_ca.pem"), "trusted CA added");
            bool ok1 = await TryConnect(c1, "wrong.example");
            Check(ok1, "matching hostname accepted");
            c1.Free();
        }

        // 场景 2：期望主机名 = localhost（不匹配证书 SAN），
        // 链仍受信任 → 握手必须失败（主机名校验）。
        TlsContext c2 = TlsContext.CreateClient();
        if (c2 != null) {
            c2.AddTrustedCert("tls_test_ca.pem");
            bool ok2 = await TryConnect(c2, "localhost");
            Check(!ok2, "mismatched hostname rejected");
            c2.Free();
        }

        // 场景 3：verify 被禁用（DisableVerify）→ 主机名检查不生效，
        // 即使主机名不匹配也应成功（兼容 verifyTls=false 的开发开关）。
        TlsContext c3 = TlsContext.CreateClient();
        if (c3 != null) {
            c3.DisableVerify();
            bool ok3 = await TryConnect(c3, "localhost");
            Check(ok3, "verify disabled accepts");
            c3.Free();
        }

        serverTls.Free();
        Socket.Cleanup();
        Console.WriteLine("failures=" + Convert.ToString(failures));
        return 0;
    }

    static void Main() {
        int r = await Run();
    }
}
