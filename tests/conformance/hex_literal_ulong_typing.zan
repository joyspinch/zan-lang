using System;

// An unsuffixed hex/binary/octal literal above long.MaxValue types ulong,
// exactly like the decimal path's auto-promotion: the raw bit pattern used to
// be typed as a negative long, so `var v = 0xFFFFFFFFFFFFFFFF` silently
// CHANGED VALUE to -1 instead of the written 18446744073709551615. Values at
// or below long.MaxValue keep their existing typing: long.MaxValue stays
// long, the ARGB window [2^31, 2^32] stays an int with two's-complement wrap,
// and `-0x8000000000000000` is the legal spelling of long.MinValue.
class Program {
    static void Main() {
        var v = 0xFFFFFFFFFFFFFFFF;
        Console.WriteLine(v);
        ulong u = 0xFFFFFFFFFFFFFFFF;
        Console.WriteLine(u);
        var w = 0b1111111111111111111111111111111111111111111111111111111111111111;
        Console.WriteLine(w);
        long mx = 0x7FFFFFFFFFFFFFFF;
        Console.WriteLine(mx);
        long mn = -0x8000000000000000;
        Console.WriteLine(mn);
        int argb = 0xFF990000;
        Console.WriteLine(argb);
    }
}
