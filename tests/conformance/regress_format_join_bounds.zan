using System;

namespace Conf;

/// Regression (audit H2/H10): a Format placeholder whose digit run cannot
/// name an argument stays literal text instead of wrapping the index
/// negative and reading wild memory; string.Join treats null list elements
/// as empty strings instead of handing NULL to strlen.
class Program {
    static void Main() {
        Console.WriteLine(string.Format("{2147483648} {0}", 5));
        Console.WriteLine(string.Format("[{1}] [{0}]", "a", "b"));
        List<string> xs = new List<string>();
        xs.Add("a");
        xs.Add(null);
        xs.Add("b");
        Console.WriteLine(string.Join(",", xs));
    }
}
