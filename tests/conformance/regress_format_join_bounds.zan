using System;

namespace Conf;

/// 接口数据协议与执行契约。
/// 接口数据协议与执行契约。
/// 接口数据协议与执行契约。
/// 核心契约与语义定义。
class Program {
    static void Main() {
        Console.WriteLine(string.Format("{2147483648} {0}", 5));
        Console.WriteLine(string.Format("[{1}] [{0}]", "a", "b"));
        List<string> xs = new List<string>();
        xs.Add("a");
        xs.Add(null);
        xs.Add("b");
        Console.WriteLine(string.Join(",", xs));
    }
}
