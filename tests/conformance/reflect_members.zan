// Reflection, second layer: the type record also carries the method and
// constructor tables, so methods can be described and called by name,
// constructors selected by arity, fields written by name (properties through
// their real accessors), and the shape of a type (array / nullable /
// interface / generic instance) asked about.
using System;

namespace Reflect2;

interface IShape { int Area(); }

class Animal {
    public string Name;
    public int Legs;
    public double Weight;
    public int Age { get; set; }

    public Animal() { Name = "anon"; Legs = 4; }
    public Animal(string n) { Name = n; Legs = 2; }

    public int Doubled(int x) { return x * 2; }
    public string Greet() { return "hi " + Name; }
    public long Big(long v) { return v + 1; }
    public double Half(double d) { return d / 2.0; }
    public void Bump() { Legs = Legs + 1; }
    public static int Zero() { return 0; }
}

class Box : IShape {
    private int w;
    // a real property: reflection must go through the accessors, not through
    // the `w` backing field
    public int Doubled { get { return w * 2; } set { w = value / 2; } }
    public int Area() { return w * w; }
    public Box(int x) { w = x; }
}

class Pair<T> {
    public T First;
    public int Tag;
    public Pair() { Tag = 1; }
    public int TagOf() { return Tag; }
}

class Program {
    static void Main() {
        // ---- method metadata
        TypeInfo ti = typeof(Animal);
        Console.WriteLine(ti.MethodCount);
        for (int i = 0; i < ti.MethodCount; i++) {
            Console.WriteLine(ti.GetMethodName(i) + " " +
                              ti.GetMethodReturnType(i) + " " +
                              ti.GetMethodParamCount(i) + " " +
                              ti.IsMethodStatic(i));
        }
        Console.WriteLine(ti.GetMethodParamType(0, 0));
        Console.WriteLine(ti.HasMethod("Doubled"));
        Console.WriteLine(ti.HasMethod("Nope"));

        // ---- constructor metadata
        Console.WriteLine(ti.ConstructorCount);
        Console.WriteLine(ti.GetCtorParamCount(0));
        Console.WriteLine(ti.GetCtorParamCount(1));
        Console.WriteLine(ti.GetCtorParamType(1, 0));

        // ---- dynamic invocation
        Animal a = new Animal("Rex");
        Console.WriteLine(a.InvokeInt("Doubled", 21));
        Console.WriteLine(a.InvokeString("Greet"));
        Console.WriteLine(a.InvokeLong("Big", 41));
        Console.WriteLine(a.InvokeDouble("Half", 5.0));
        Console.WriteLine(a.Invoke("Bump"));
        Console.WriteLine(a.Legs);
        Console.WriteLine(a.HasMethod("Greet"));
        Console.WriteLine(a.HasMethod("Nope"));
        Console.WriteLine(a.InvokeInt("Nope", 1));

        // ---- writing fields by name
        Console.WriteLine(a.SetFieldString("Name", "Max"));
        Console.WriteLine(a.Name);
        Console.WriteLine(a.SetFieldInt("Legs", 6));
        Console.WriteLine(a.Legs);
        Console.WriteLine(a.SetFieldDouble("Weight", 3.5));
        Console.WriteLine(a.Weight);
        Console.WriteLine(a.SetFieldInt("Age", 7));
        Console.WriteLine(a.Age);
        Console.WriteLine(a.SetFieldInt("Nope", 1));

        // ---- properties go through the accessors
        Box b = new Box(5);
        Console.WriteLine(b.GetFieldInt("Doubled"));
        Console.WriteLine(b.SetFieldInt("Doubled", 20));
        Console.WriteLine(b.Doubled);
        Console.WriteLine(b.GetFieldInt("w"));
        Console.WriteLine(b.InvokeInt("Area"));
        Console.WriteLine(typeof(Box).MethodCount);
        Console.WriteLine(typeof(Box).GetMethodName(0));

        // ---- constructing dynamically
        object o = typeof(Box).CreateInstance(9);
        Console.WriteLine(o.GetType().Name);
        Console.WriteLine(o.GetFieldInt("w"));
        Console.WriteLine(o.InvokeInt("Area"));

        // ---- the shape of a type
        Console.WriteLine(ti.IsArray + " " + ti.IsNullable + " " +
                          ti.IsInterface + " " + ti.IsGeneric);
        Console.WriteLine(typeof(IShape).Kind + " " + typeof(IShape).IsInterface);
        Console.WriteLine(typeof(int[]).IsArray + " " +
                          typeof(int[]).ElementType.Name);
        Console.WriteLine(typeof(int?).IsNullable + " " +
                          typeof(int?).ElementType.Name);

        // ---- a generic instance
        TypeInfo pt = typeof(Pair<int>);
        Console.WriteLine(pt.Name + " " + pt.IsGeneric + " " + pt.TypeArgCount);
        Console.WriteLine(pt.GetTypeArg(0).Name);
        Pair<int> p = new Pair<int>();
        Console.WriteLine(p.InvokeInt("TagOf"));
        Console.WriteLine(p.SetFieldInt("Tag", 8));
        Console.WriteLine(p.Tag);
    }
}
