using System;
using System.IO;
namespace Conf;

// Directory.GetFiles(path, searchPattern)：模式只匹配文件名部分
//（'*' 任意序列 / '?' 单字符），返回值仍是完整路径；null/空 pattern
// 视为全量；无通配符的 pattern 按字面名精确匹配。
class Program {
    // 顺序无关：两个路径恰好是 a.png 与 b.png。
    static bool PairIs(List<string> ps, string n1, string n2) {
        if (ps.Count != 2) { return false; }
        string a = ps[0].Substring(ps[0].Length - n1.Length, n1.Length);
        string b = ps[1].Substring(ps[1].Length - n2.Length, n2.Length);
        return (a == n1 && b == n2) || (a == n2 && b == n1);
    }

    static void Main() {
        string root = "_dpat_probe";
        Directory.DeleteRecursive(root);
        Directory.CreateDirectory(root);
        File.WriteAllText(root + "/a.png", "1");
        File.WriteAllText(root + "/b.png", "2");
        File.WriteAllText(root + "/c.txt", "3");
        File.WriteAllText(root + "/note.md", "4");

        List<string> pngs = Directory.GetFiles(root, "*.png");
        Console.WriteLine("pngs=" + Convert.ToString(pngs.Count));
        Console.WriteLine("pngPair=" + PairIs(pngs, "a.png", "b.png").ToString());

        Console.WriteLine("star=" + Convert.ToString(Directory.GetFiles(root, "*").Count));
        Console.WriteLine("none=" + Convert.ToString(Directory.GetFiles(root, "*.exe").Count));
        Console.WriteLine("q=" + Convert.ToString(Directory.GetFiles(root, "a.pn?").Count));
        Console.WriteLine("mid=" + Convert.ToString(Directory.GetFiles(root, "n*te.md").Count));
        Console.WriteLine("literal=" + Convert.ToString(Directory.GetFiles(root, "c.txt").Count));
        Console.WriteLine("exactNoExt=" + Convert.ToString(Directory.GetFiles(root, "a").Count));
        Console.WriteLine("starMid=" + Convert.ToString(Directory.GetFiles(root, "*.p*").Count));
        Console.WriteLine("emptyPat=" + Convert.ToString(Directory.GetFiles(root, "").Count));
        Console.WriteLine("nullPat=" + Convert.ToString(Directory.GetFiles(root, null).Count));

        // 路径里含通配符也只按文件名匹配，不误吃目录段。
        List<string> dotStar = Directory.GetFiles(root, ".*");
        Console.WriteLine("dotStar=" + Convert.ToString(dotStar.Count));

        Directory.DeleteRecursive(root);
        Console.WriteLine("cleaned=" + (!Directory.Exists(root)).ToString());
    }
}
