namespace NestedIdentity;

partial class First {
    public partial class Item {
        public static int Value() { return 11; }
    }

    public static int FromOwner() {
        Item item = new Item();
        return Item.Value() + item.Extra();
    }
}

partial class First {
    public partial class Item {
        public int Extra() { return 3; }
    }

    public class IdentityToken {
        public static int Value() { return 31; }
    }
}

class Second {
    public class Item {
        public static int Value() { return 23; }
    }
}

class Program {
    static void Main() {
        First.Item item = new NestedIdentity.First.Item();
        Console.WriteLine(First.FromOwner());
        Console.WriteLine(First.Item.Value() - item.Extra());
        Console.WriteLine(NestedIdentity.Second.Item.Value());
        Console.WriteLine(IdentityToken.Value());
    }
}
