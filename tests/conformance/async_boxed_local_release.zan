using System;

// A closure inside an async method captures a class instance: the local
// lives in a heap cell, and the frame slot keeps the CELL pointer across
// the suspension. When the coroutine finishes, the cleanup function has to
// release the value INSIDE the cell -- releasing the cell pointer itself
// would treat a heap block as an object and free a wild pointer.
class Dog { public int n; }

class Program {
    static async void Main() {
        Dog d = new Dog();
        d.n = 7;
        Func<int> f = () => d.n;
        await Task.Delay(1);
        Console.WriteLine("v=" + Convert.ToString(f()));
        Console.WriteLine("done");
    }
}
