using System;

class PendingWatch {
    public weak PendingItem first;
    public weak PendingItem second;
}

class PendingItem {
    public int value;
    public PendingItem(int n) {
        value = n;
        if (n == 1) { SyncPendingReturn.watch.first = this; }
        else { SyncPendingReturn.watch.second = this; }
    }
}

class SyncPendingReturn {
    public static PendingWatch watch;
    static PendingItem selected;

    static void Fail() { throw new Exception("pending"); }
    static PendingItem Direct() {
        try { return new PendingItem(1); }
        finally { throw new Exception("direct"); }
    }
    static PendingItem Called() {
        try { return new PendingItem(1); }
        finally { Fail(); }
    }
    static PendingItem Caught() {
        try { return new PendingItem(1); }
        finally {
            try { Fail(); }
            catch (Exception e) { Console.WriteLine("inner-caught"); }
        }
    }
    static PendingItem Mutated() {
        SyncPendingReturn.selected = new PendingItem(1);
        try { return SyncPendingReturn.selected; }
        finally { SyncPendingReturn.selected = new PendingItem(2); }
    }
    static PendingItem Replaced() {
        try { return new PendingItem(1); }
        finally { return new PendingItem(2); }
    }
    static PendingItem Inner() {
        try { return new PendingItem(2); }
        finally { Console.WriteLine("inner-finally"); }
    }
    static PendingItem Nested(bool fail) {
        try { return new PendingItem(1); }
        finally {
            PendingItem inner = Inner();
            Console.WriteLine("inner-value=" + inner.value);
            inner = null;
            Console.WriteLine("inner-released=" + (SyncPendingReturn.watch.second == null));
            if (fail) { Fail(); }
        }
    }
    static PendingItem Boundary() {
        try {
            try { return new PendingItem(1); }
            finally { Fail(); }
        } catch (Exception e) {
            Console.WriteLine("boundary-released=" + (SyncPendingReturn.watch.first == null));
            return new PendingItem(2);
        }
    }
    static void Main() {
        SyncPendingReturn.watch = new PendingWatch();
        try { PendingItem ignored = Direct(); }
        catch (Exception e) { Console.WriteLine("direct=" + (SyncPendingReturn.watch.first == null)); }
        try { PendingItem ignored = Called(); }
        catch (Exception e) { Console.WriteLine("called=" + (SyncPendingReturn.watch.first == null)); }

        PendingItem caught = Caught();
        Console.WriteLine("caught-live=" + (caught.value == 1 && SyncPendingReturn.watch.first != null));
        caught = null;
        Console.WriteLine("caught-released=" + (SyncPendingReturn.watch.first == null));

        PendingItem original = Mutated();
        Console.WriteLine("mutation-original=" + original.value);
        Console.WriteLine("mutation-both=" + (SyncPendingReturn.watch.first != null && SyncPendingReturn.watch.second != null));
        original = null;
        SyncPendingReturn.selected = null;
        Console.WriteLine("mutation-released=" + (SyncPendingReturn.watch.first == null && SyncPendingReturn.watch.second == null));

        PendingItem replacement = Replaced();
        Console.WriteLine("replacement=" + replacement.value);
        Console.WriteLine("replacement-old-released=" + (SyncPendingReturn.watch.first == null));
        replacement = null;
        Console.WriteLine("replacement-new-released=" + (SyncPendingReturn.watch.second == null));

        PendingItem nested = Nested(false);
        Console.WriteLine("nested-live=" + (nested.value == 1 && SyncPendingReturn.watch.first != null));
        nested = null;
        Console.WriteLine("nested-released=" + (SyncPendingReturn.watch.first == null));
        try { PendingItem ignored = Nested(true); }
        catch (Exception e) { Console.WriteLine("nested-abort=" + (SyncPendingReturn.watch.first == null)); }

        PendingItem boundary = Boundary();
        Console.WriteLine("boundary-result=" + boundary.value);
        boundary = null;
        Console.WriteLine("boundary-result-released=" + (SyncPendingReturn.watch.second == null));
        SyncPendingReturn.watch = null;
    }
}
