using System;
using System.Collections.Generic;

namespace ConformanceTests;

// -g 与 ARC 插桩（--check-leaks / --arc-guard）同开时的模块校验。
//
// 插桩路径要用 llvm.returnaddress 记调用点；该 intrinsic 按返回指针类型
// 重载，新版 LLVM（≥23）的 verifier 只认修饰名 llvm.returnaddress.p0。
// 曾经裸名声明，于是 -g 编出的任何程序（连 hello-world）都在校验阶段失败。
// 本用例以 -g 编译，并让对象经历分配/共享/释放，覆盖 trace 与隔离写入点。
public class Node {
    public string name;
    public Node next;

    public Node(string name) { this.name = name; }
}

public class Program {
    static int failures = 0;

    static void Check(bool ok, string name) {
        if (!ok) {
            failures = failures + 1;
            Console.WriteLine("FAIL: " + name);
        }
    }

    static int Chain(int n) {
        Node head = null;
        for (int i = 0; i < n; i++) {
            Node node = new Node("n" + i);
            node.next = head;
            head = node;
        }
        int count = 0;
        Node cur = head;
        while (cur != null) {
            count = count + 1;
            cur = cur.next;
        }
        return count;
    }

    static void Main() {
        Console.WriteLine("hello");
        Check(Chain(16) == 16, "chain length");

        List<Node> list = new List<Node>();
        for (int i = 0; i < 8; i++) {
            list.Add(new Node("item" + i));
        }
        Node shared = list[3];
        list.Clear();
        Check(shared.name == "item3", "shared survives clear");

        if (failures == 0) {
            Console.WriteLine("PASS");
        }
    }
}
