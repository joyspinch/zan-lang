// ns_ambiguity_arity_filter.zan -- B-ID38: the "ambiguous type" report must
// filter same-simple-name candidates by generic arity before firing.
// `Action<int>` with a zero-arity `Shapes.Action` imported alongside the
// stdlib's one-arity System.Linq.Action<T> used to die on a false
// "ambiguous type 'Action'": the check counted declarations by name, though
// exactly one candidate can take the argument list. The imported zero-arity
// form keeps rewriting the bare reference (mangled Shapes_Action); the
// generic reference stays untouched and binds the stdlib generic.
using System;
using Shapes;

namespace Shapes;

// Same simple name as stdlib System.Linq.Action<T> -- zero-arity on purpose.
delegate void Action();

class Program {
    static int total;

    static void Bump(Action<int> step) { step(40); step(2); }

    static int Main() {
        Bump((int v) => { total = total + v; });
        Console.WriteLine("total=" + Convert.ToString(total));
        Action beat = () => { Console.WriteLine("beat"); };
        beat();
        Console.WriteLine("OK");
        return 0;
    }
}
