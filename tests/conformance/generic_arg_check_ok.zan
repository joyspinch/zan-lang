// 泛型**类型实参**的实参类型检查——"不该误伤"那一半。
//
// 修实参检查时最容易在这里收得太紧：把 int → long 的隐式 widening 也
// 判成不匹配、把 null 一律拒了、把派生类 → 基类也拒了。这条用例守住
// 那些合法的写法，确保检查只拦真正错的那一类。
using System;
using System.Collections.Generic;

class Base { }

class Derived : Base { }

class Program {
    static int Main() {
        int bad = 0;

        // 隐式数值 widening：int → long。
        List<long> longs = new List<long>();
        longs.Add(42);
        if (longs.Count != 1) { bad = bad + 1; }

        // 派生类 → 基类。
        List<object> objects = new List<object>();
        objects.Add(new Derived());
        if (objects.Count != 1) { bad = bad + 1; }

        // null → 引用类型形参。
        List<string> strings = new List<string>();
        strings.Add(null);
        if (strings.Count != 1) { bad = bad + 1; }

        // Dictionary 的 V 是引用类型时，派生类也要放行。
        Dictionary<string, object> map = new Dictionary<string, object>();
        map.Add("k", new Derived());
        if (map.Count != 1) { bad = bad + 1; }

        // 正确的用法照常工作。
        List<int> numbers = new List<int>();
        numbers.Add(42);
        if (numbers.Count != 1) { bad = bad + 1; }
        if (numbers[0] != 42) { bad = bad + 1; }

        Console.WriteLine("generic-arg-ok: " + (bad == 0 ? 1 : 0));
        return bad == 0 ? 0 : 1;
    }
}
