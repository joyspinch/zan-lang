using System;
namespace Conf;

// 核心契约与语义定义。

class Box {
    int num;
    static Box Of(int v) { Box b = new Box(); b.num = v; return b; }
}

class Store {
    static Box box;
    static List<int> items;
    static object rawLock = new object();
    static object dynObj;

    static void Fill(List<int> list) {
        list.Add(1);
        list.Add(2);
        list.Add(3);
    }

    static void Main() {
        Store.box = Box.Of(42);
        Console.WriteLine(Store.box.num);

        Store.items = new List<int>();
        Store.Fill(Store.items);
        Console.WriteLine(Store.items.Count);
        Store.items.Add(4);
        Console.WriteLine(Store.items.Count);
        Console.WriteLine(Store.items[0]);

        Store.dynObj = Box.Of(100);
        Console.WriteLine(Store.rawLock != null);
        Console.WriteLine(Store.dynObj != null);
    }
}
