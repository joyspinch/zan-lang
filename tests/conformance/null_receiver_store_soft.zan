// 回归：try 外经 null 局部写字段（`n.w = i` / `n.w += 1` / `n.w++`）与写 null 数组
// 元素曾直接 SIGSEGV（写入路径没有空接收者守卫，只有读路径有）。现与读同口径：
// 每站点软报告一次，写落在每线程软失败暂存区，程序继续。null 数组按长度 0 处理
// （Length = 0，任何下标越界，写被跳过、读为 0），不再读到暂存区对象 RC 的 2^62。
// try 内同样的写抛 NullReferenceException。
using System;

class Node {
    public int w;
    public string s;
}

class Program {
    static void Main() {
        Node n = null;
        for (int i = 0; i < 3; i++) {
            n.w = i;
            n.w += 1;
            n.w++;
            n.s = "x";
        }
        Console.WriteLine("after field stores");

        int[] a = null;
        Console.WriteLine("len=" + a.Length);
        Console.WriteLine("far=" + a[5000000]);
        a[5000000] = 3;
        a[0] += 2;
        a[1]++;
        Console.WriteLine("a0=" + a[0]);

        try {
            n.w = 1;
            Console.WriteLine("store no-throw");
        } catch (NullReferenceException) {
            Console.WriteLine("store NullReferenceException");
        }
        try {
            a[0] = 1;
            Console.WriteLine("arr store no-throw");
        } catch (NullReferenceException) {
            Console.WriteLine("arr store NullReferenceException");
        }

        Node real = new Node();
        real.w = 4;
        real.w += 1;
        real.w++;
        int[] b = new int[2];
        b[1] = 7;
        b[1] += 1;
        b[1]++;
        Console.WriteLine("real=" + real.w + " " + b[1] + " " + b.Length);
    }
}
