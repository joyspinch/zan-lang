// Conformance: `throw` releases the locals whose scope-exit code the longjmp
// skips -- the whole frame when the handler is in a caller, and the try body's
// locals when the handler is in this same frame (locals declared outside that
// try stay alive and are released normally afterwards).
using System;

class Node { public string name; Node(string n) { this.name = n; } }

class Program {
    static void ThrowsWithLocals() {
        Node a = new Node("inner");
        List<string> l = new List<string>();
        l.Add(a.name);
        throw new Exception("boom-" + a.name);
    }
    static void SameFrame() {
        Node outer = new Node("outer");
        try {
            Node inner = new Node("in-try");
            if (inner.name.Length > 0) { throw new Exception("same"); }
            Console.WriteLine("unreachable");
        } catch (Exception e) {
            Console.WriteLine("same-frame: " + e.Message);
        }
        Console.WriteLine("outer alive: " + outer.name);
    }
    static void InLoop() {
        for (int i = 0; i < 3; i = i + 1) {
            try {
                Node n = new Node("loop" + Convert.ToString(i));
                throw new Exception(n.name);
            } catch (Exception e) {
                Console.WriteLine("loop: " + e.Message);
            }
        }
    }
    static void Main() {
        try { ThrowsWithLocals(); } catch (Exception e) { Console.WriteLine("caught: " + e.Message); }
        SameFrame();
        InLoop();
    }
}
