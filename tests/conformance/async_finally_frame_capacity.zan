using System;

class Sync { }

class Program {
    static void Check(bool ok) {
        if (!ok) { throw new Exception("async finally frame capacity"); }
    }

    static async int Nested() {
        int marker = 0;
        try {
            try {
                try {
                    try {
                        await Task.Yield();
                        throw new Exception("nested");
                    } finally {
                        await Task.Yield();
                        marker = marker + 1;
                    }
                } finally {
                    await Task.Yield();
                    marker = marker + 10;
                }
            } finally {
                await Task.Yield();
                marker = marker + 100;
            }
        } catch (Exception ex) {
            Check(ex.Message == "nested");
            marker = marker + 1000;
        }
        return marker;
    }

    static async int Locked() {
        Sync sync = new Sync();
        int marker = 0;
        await Task.Yield();
        try {
            lock (sync) {
                int local = 23;
                try {
                    try {
                        throw new Exception("locked");
                    } finally {
                        marker = marker + local;
                    }
                } finally {
                    marker = marker + 100;
                }
            }
        } catch (Exception ex) {
            Check(ex.Message == "locked");
            marker = marker + 1000;
        }
        lock (sync) { marker = marker + 10000; }
        return marker;
    }

    static async int Checked() {
        checked {
            int value = 17;
            await Task.Yield();
            value = value + 2;
            return value;
        }
    }

    static async void Main() {
        Check(await Nested() == 1111);
        Check(await Locked() == 11123);
        Check(await Checked() == 19);
        Console.WriteLine("async finally frame ok");
    }
}
