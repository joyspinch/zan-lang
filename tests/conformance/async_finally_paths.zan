using System;

/* finally in an async body: it must run when an exception leaves the try (even
 * when the finally itself awaits, which suspends mid-unwind), on `return await`,
 * and on `continue`. The in-flight exception is frame-resident across the
 * suspension -- an alloca would be garbage when the finally resumes. */

class Boom : Exception {
    public Boom(string m) : base(m) { }
}

class Program {
    static async int Step(int n) {
        await Task.Delay(1);
        return n;
    }

    static async int ThrowThrough() {
        try {
            int v = await Step(3);
            Console.WriteLine("body " + Convert.ToString(v));
            throw new Boom("async");
        } finally {
            int w = await Step(4);
            Console.WriteLine("f:async " + Convert.ToString(w));
        }
    }

    static async int Ret() {
        try {
            return await Step(7);
        } finally {
            Console.WriteLine("f:ret");
        }
    }

    static async int Loop() {
        int sum = 0;
        int i = 0;
        while (i < 3) {
            try {
                if (i == 1) { i = i + 1; continue; }
                sum = sum + await Step(i);
            } finally {
                Console.WriteLine("f:loop " + Convert.ToString(i));
            }
            i = i + 1;
        }
        return sum;
    }

    static async void Main() {
        try {
            await ThrowThrough();
        } catch (Boom e) {
            Console.WriteLine("caught " + e.Message);
        }
        Console.WriteLine("ret " + Convert.ToString(await Ret()));
        Console.WriteLine("loop " + Convert.ToString(await Loop()));
        Console.WriteLine("done");
    }
}
