using System;

class Program {
    static void TestBasic() {
        Console.WriteLine("Start");
        defer Console.WriteLine("Deferred 1 (first registered, runs last)");
        defer Console.WriteLine("Deferred 2 (second registered, runs second)");
        defer {
            Console.WriteLine("Deferred 3 (block)");
        }
        Console.WriteLine("End of body");
    }

    static void TestWithEarlyReturn(bool early) {
        Console.WriteLine("EarlyFunc start");
        defer Console.WriteLine("EarlyFunc deferred");
        if (early) {
            Console.WriteLine("Returning early");
            return;
        }
        Console.WriteLine("Not early");
    }

    static void Main() {
        TestBasic();
        Console.WriteLine("---");
        TestWithEarlyReturn(true);
        Console.WriteLine("---");
        TestWithEarlyReturn(false);
        Console.WriteLine("ALL DEFER TESTS PASSED");
    }
}
