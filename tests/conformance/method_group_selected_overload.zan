using System;

class SelectedGroupBase {
    public int Read(string value) { return -100; }
    public int Read(int value) { return value + 20; }
}

class SelectedGroup : SelectedGroupBase {
    public int Bias;
    public SelectedGroup(int bias) { Bias = bias; }
    public static int StaticRead(string value) { return -200; }
    public static int StaticRead(int value) { return value + 30; }
    public int Mixed(string value) { return -300; }
    public static int Mixed(int value) { return value + 40; }
    public static int Bound(string value) { return -400; }
    public int Bound(int value) { return value + Bias; }
    public int RunBare() { Func<int, int> action = Bound; return action(2); }
    public int RunThis() { Func<int, int> action = this.Bound; return action(3); }
    public Func<int, int> ReturnGroup() { return this.Bound; }
    public static int RunStaticBare() { Func<int, int> action = Mixed; return action(4); }
}

class SelectedGroupShadow : SelectedGroupBase {
    public Func<int, int> Read;
}

class SelectedGroupHolder {
    public Func<int, int> Action;
    public SelectedGroupHolder(Func<int, int> action) { Action = action; }
}

class SelectedGroupFieldHost {
    SelectedGroup receiver = new SelectedGroup(70);
    public int BareField() {
        Func<int, int> action = receiver.Bound;
        return action(1);
    }
    public int ThisField() {
        Func<int, int> action = this.receiver.Bound;
        return action(2);
    }
    public int ShadowedField() {
        SelectedGroup receiver = new SelectedGroup(90);
        Func<int, int> action = receiver.Bound;
        Func<int, int> fieldAction = this.receiver.Bound;
        return action(3) + fieldAction(4);
    }
}

class SelectedGroupBox<T> {
    public T Echo(T value) { return value; }
    public static T StaticEcho(T value) { return value; }
}

class SelectedGroupEvent { }
class SelectedGroupParent {
    public int Value;
    public SelectedGroupParent OnClick(Func<int, int> action) {
        Value = action(5);
        return this;
    }
    public SelectedGroupParent Height(int height) { Value = Value + height; return this; }
}
class SelectedGroupChild : SelectedGroupParent {
    public void OnClick(SelectedGroupEvent value) { throw new Exception("wrong event overload"); }
}

class MethodGroupSelectedOverloadTest {
    static void Check(bool ok, string name) { if (!ok) throw new Exception(name); }
    static int Apply(Func<int, int> action) { return action(6); }
    static void Main() {
        Func<int, int> stat = SelectedGroup.StaticRead;
        Check(stat(1) == 31, "static second overload");
        Func<int, int> mixed = SelectedGroup.Mixed;
        Check(mixed(1) == 41, "type receiver selects static overload");
        SelectedGroup group = new SelectedGroup(50);
        Func<int, int> bound = group.Bound;
        Check(bound(1) == 51, "object receiver selects instance overload");
        Check(group.RunBare() == 52, "bare instance method group");
        Check(group.RunThis() == 53, "this instance method group");
        Check(SelectedGroup.RunStaticBare() == 44, "bare static method group");
        Func<int, int> returned = group.ReturnGroup();
        Check(returned(4) == 54, "return conversion");
        bound = SelectedGroup.StaticRead;
        Check(bound(2) == 32, "assignment conversion");
        Func<int, int> cast = (Func<int, int>)SelectedGroup.StaticRead;
        Check(cast(3) == 33, "explicit conversion");
        Check(Apply(SelectedGroup.StaticRead) == 36, "argument conversion");
        SelectedGroupHolder holder = new SelectedGroupHolder(SelectedGroup.StaticRead);
        Check(holder.Action(4) == 34, "constructor conversion");
        SelectedGroupBase inherited = group;
        Func<int, int> inheritedAction = inherited.Read;
        Check(inheritedAction(1) == 21, "inherited overload selection");
        SelectedGroupParent chain = new SelectedGroupChild().OnClick(group.Bound).Height(7);
        Check(chain.Value == 62, "natural inherited overload chain");
        SelectedGroupShadow shadow = new SelectedGroupShadow();
        shadow.Read = SelectedGroup.StaticRead;
        Check(Apply(shadow.Read) == 36, "delegate field shadows inherited method");
        SelectedGroupFieldHost fieldHost = new SelectedGroupFieldHost();
        Check(fieldHost.BareField() == 71, "bare host field receiver");
        Check(fieldHost.ThisField() == 72, "explicit this host field receiver");
        Check(fieldHost.ShadowedField() == 167, "local receiver shadows host field");
        SelectedGroupBox<double> doubleBox = new SelectedGroupBox<double>();
        Func<double, double> doubleEcho = doubleBox.Echo;
        Check(doubleEcho(1.25) == doubleBox.Echo(1.25), "closed generic instance method group ABI");
        Func<double, double> doubleStaticEcho = SelectedGroupBox<double>.StaticEcho;
        Check(doubleStaticEcho(2.5) == 2.5, "closed generic static method group ABI");
        SelectedGroupBox<string> stringBox = new SelectedGroupBox<string>();
        Func<string, string> stringEcho = stringBox.Echo;
        Check(stringEcho("selected") == "selected", "second generic instance retains its signature");
        Console.WriteLine("METHOD_GROUP_SELECTED_OVERLOAD_OK");
    }
}
