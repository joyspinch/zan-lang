using System;
using System.Collections.Generic;

// The C host accepts a `char` wherever it accepts a `string` argument
// (is_string_like_expr in src/compiler/irgen_call.c) and turns it into the
// one-character text. The self-host has to read the same: a char argument
// is packed into a one-character string, not handed to the string runtime
// as a number.
class Program {
    static void Main() {
        string s = "a,b,c";
        List<string> parts = s.Split(',');
        Console.WriteLine("n=" + parts.Count);
        Console.WriteLine("p0=" + parts[0]);
        Console.WriteLine("p1=" + parts[1]);
        Console.WriteLine("p2=" + parts[2]);
        Console.WriteLine("idx=" + s.IndexOf(','));
        Console.WriteLine("lidx=" + s.LastIndexOf(','));
        Console.WriteLine("eq=" + s.Equals(','));
        Console.WriteLine("eq2=" + s.Equals("a,b,c"));
        Console.WriteLine("sw=" + s.StartsWith(','));
        Console.WriteLine("ew=" + s.EndsWith('c'));
        Console.WriteLine("repl=" + s.Replace(',', ';'));
        Console.WriteLine("repl2=" + s.Replace(",", ";"));
        Console.WriteLine("ct=" + s.Contains(','));
        Console.WriteLine("ct2=" + s.Contains("b"));
        Console.WriteLine("ct3=" + s.Contains('x'));
    }
}
