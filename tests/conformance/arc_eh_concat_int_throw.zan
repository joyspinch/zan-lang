// 验证整型操作数的多操作数字符串拼接过程中抛出异常时，
// 已分配的操作数缓冲通过 EH unwind 栈按字符串种类正常释放
// （旧实现按源操作数类型判定槽位种类，整数落到 OBJECT 槽，
//   展开时 zan_rt_release_dyn 会把字符串头字当成 site 下标去查析构表，
//   读坏内存直接段错误）
using System;

class Program {
    static int Thrower() { throw new Exception("boom"); }

    static int Work() {
        int r = 0;
        try {
            // 这里的操作数是 int，拼接时会先转成托管字符串缓冲
            string s = "a" + 1 + "b" + 2 + "c" + Thrower();
            r = s.Length;
        } catch (Exception e) {
            r = 7;
        }
        return r;
    }

    static int WorkNested() {
        int r = 0;
        try {
            string s = "x" + (1 + 2) + "y" + Thrower();
            r = s.Length;
        } catch (Exception e) {
            r = 9;
        }
        return r;
    }

    static void Main() {
        Console.WriteLine(Work());
        Console.WriteLine(WorkNested());
        Console.WriteLine("a" + 1 + "b" + 2 + "c");   // normal path
    }
}
