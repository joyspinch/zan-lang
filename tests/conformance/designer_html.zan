using System;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Markup;
using Gui.Designer;

// WEB_GUI_ROADMAP P7a：设计器 HTML 存取格式的编解码器测试。
// // 覆盖三层，全部以"逐键保真往返"为准绳：
// 1. DesignerHtml 纯层：设计 JSON → HTML → 设计 JSON 的全键
// 往返（文档级键、字段树、事件键 Pascal 还原、props 直通
// JSON、未建模键的 x- 通道）；IsDesignDoc 对设计稿/运行期
// HTML/空文本的三态判定。
// 2. 设计器桥：LoadHtmlText → SaveHtml 再入 LoadHtmlText 的
// 序列稳定（第二遍 SaveHtml 与第一遍逐字节一致），解析失败
// 走 loadError。
// 3. 编译期通道由 conformance_gui_form_control 覆盖：form_control
// 测试编译 .html 设计稿并执行，断言输出符合金标准。
class DesignerHtmlTest {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got
            + "' want '" + want + "'");
    }

    // 递归逐键比较：对象键集合完整一致、数组按序、标量保留类型。
    static void Cmp(JsonValue a, JsonValue b, string path) {
        if (a == null || b == null) {
            if (a != b) {
                Console.WriteLine("DIFF null " + path);
                fails = fails + 1;
            }
            return;
        }
        // 根的文档序必须精确保留，不能把字符串 "0" 当作子节点索引 0。
        if (path == ".bodyContent") {
            Eq("bodyContent", b.ToJson(), a.ToJson());
            return;
        }
        if (a.IsObject() && b.IsObject()) {
            if (a.Count() != b.Count()) {
                Console.WriteLine("DIFF size " + path + " "
                    + a.Count() + " vs " + b.Count());
                fails = fails + 1;
            }
            for (int i = 0; i < a.Count(); i = i + 1) {
                string k = a.KeyAt(i);
                Cmp(a.ValAt(i), b.Get(k), path + "." + k);
            }
            return;
        }
        if (a.IsArray() && b.IsArray()) {
            if (a.Count() != b.Count()) {
                Console.WriteLine("DIFF arr " + path);
                fails = fails + 1;
                return;
            }
            for (int i = 0; i < a.Count(); i = i + 1) {
                Cmp(a.At(i), b.At(i), path + "[" + i + "]");
            }
            return;
        }
        string sa = a.ToJson();
        string sb = b.ToJson();
        // 原生 min/max/step 属性以字符串读回，保留原有数字文本兼容；
        // bool/null/容器不能再与同文字符串或空串混为一谈。
        if ((a.IsNumber() && b.IsString()) || (a.IsString() && b.IsNumber())) {
            sa = a.AsString("");
            sb = b.AsString("");
        }
        if (sa != sb) {
            Console.WriteLine("DIFF val " + path + " '" + sa
                + "' vs '" + sb + "'");
            fails = fails + 1;
        }
    }

    // 旧 JSON 缺 HTML 根身份是合法输入；仅在预期根补自然子节点序。
    // 不补实际输出或子字段，缺键、多键、错误值仍必须失败。
    static JsonValue WithBodyOrder(JsonValue doc) {
        if (doc == null || !doc.IsObject() || doc.Has("bodyContent")) { return doc; }
        JsonValue normalized = doc.Clone();
        JsonValue order = JsonValue.NewArray();
        JsonValue fields = doc.Get("fields");
        if (fields != null && fields.IsArray()) {
            for (int i = 0; i < fields.Count(); i = i + 1) {
                order.Append(JsonValue.NewInt(i));
            }
        }
        normalized.Set("bodyContent", order);
        return normalized;
    }

    static string ToJsonDoc(string html) {
        return DesignerHtml.DocOf(HtmlParser.Parse(html, ""));
    }

    static void CmpRoundTrip(string json, string back, string label) {
        JsonValue actual = JsonValue.ParseLenient(back);
        Cmp(WithBodyOrder(JsonValue.ParseLenient(json)), actual, "");
        // 首次导入可以增加根身份；从此 JSON 与规范 HTML 都须收敛。
        string canonicalHtml = DesignerHtml.FromJsonDoc(back);
        string next = ToJsonDoc(canonicalHtml);
        Cmp(actual, JsonValue.ParseLenient(next), "");
        Eq(label + " fixedpoint", DesignerHtml.FromJsonDoc(next), canonicalHtml);
    }

    // 在字段树里按 name 找 styleText（找不到返回 "<none>"）。
    static string FindStyleText(List<Gui.Widget.FormField> lst, string name) {
        for (int i = 0; i < lst.Count; i = i + 1) {
            Gui.Widget.FormField f = lst[i];
            if (f.fname == name) { return f.styleText; }
            string nested = FindStyleText(f.kids, name);
            if (nested != "<none>") { return nested; }
        }
        return "<none>";
    }

    static void Main() {
        fails = 0;
        // ---- 1. 纯层往返 -------------------------------------------------
        // 覆盖面：文档级字符串/数字/布尔键、role=control、layoutMode、
        // 字段树（CSS/label/class）、复合 props 直通表、事件键
        // onClick、未建模键（DataGrid columns 走 x- 通道）。
        string json = "{\n"
            + "  \"name\": \"RunStrip\",\n"
            + "  \"role\": \"control\",\n"
            + "  \"layoutMode\": 1,\n"
            + "  \"winW\": 320,\n"
            + "  \"winRound\": true,\n"
            + "  \"fields\": [\n"
            + "    {\n"
            + "      \"kind\": \"Divider\",\n"
            + "      \"name\": \"Rule\",\n"
            + "      \"style\": \"position:absolute;left:0;right:0;bottom:0;height:3px\"\n"
            + "    },\n"
            + "    {\n"
            + "      \"kind\": \"Panel\",\n"
            + "      \"name\": \"Line\",\n"
            + "      \"class\": \"runstrip\",\n"
            + "      \"style\": \"flex-grow:1;padding:8px; background:#101418\",\n"
            + "      \"props\": {\n"
            + "        \"min\": \"0\",\n"
            + "        \"max\": \"100\"\n"
            + "      },\n"
            + "      \"columns\": [\n"
            + "        {\n"
            + "          \"w\": 40\n"
            + "        },\n"
            + "        {\n"
            + "          \"w\": 60\n"
            + "        }\n"
            + "      ],\n"
            + "      \"kids\": [\n"
            + "        {\n"
            + "          \"kind\": \"Label\",\n"
            + "          \"name\": \"StatusLbl\",\n"
            + "          \"label\": \"OK\",\n"
            + "          \"class\": \"small secondary\",\n"
            + "          \"style\": \"flex-grow:1\"\n"
            + "        },\n"
            + "        {\n"
            + "          \"kind\": \"Button\",\n"
            + "          \"name\": \"GoBtn\",\n"
            + "          \"onClick\": \"OnGo\",\n"
            + "          \"arg\": \"apple\"\n"
            + "        }\n"
            + "      ]\n"
            + "    }\n"
            + "  ]\n"
            + "}\n";
        string html = DesignerHtml.FromJsonDoc(json);
        string back = ToJsonDoc(html);
        CmpRoundTrip(json, back, "document");
        // style 键走元素 style 属性（不是 data-* 通道）。
        Eq("style attr", html.Contains("style=\"flex-grow:1;padding:8px; background:#101418\"")
            ? "1" : "0", "1");
        // 带参事件声明走 data-arg 属性（与运行时 HTML 协议同键同名）。
        Eq("arg attr", html.Contains("data-arg=\"apple\"") ? "1" : "0", "1");

        // IsDesignDoc 三态：设计稿 true；运行期 UI 文档 false；空 false。
        Eq("isdesign doc", DesignerHtml.IsDesignDoc(html) ? "1" : "0", "1");
        Eq("isdesign ui",
            DesignerHtml.IsDesignDoc("<div class=\"card\"><p>Hi</p></div>")
                ? "1" : "0", "0");
        Eq("isdesign empty", DesignerHtml.IsDesignDoc("") ? "1" : "0", "0");

        // layoutMode=0（吸附/流式）必须显式往返：0 曾在 AppendKey 的
        // 零值跳过里被丢——.html 里没有 data-layout-mode，重新打开
        // 时读端回落缺省 1，吸附设计稿变自由布局（真踩过）。
        string snapJson = "{\n"
            + "  \"name\": \"SnapForm\",\n"
            + "  \"layoutMode\": 0,\n"
            + "  \"fields\": []\n"
            + "}\n";
        string snapHtml = DesignerHtml.FromJsonDoc(snapJson);
        Eq("snap attr", snapHtml.Contains("data-layout-mode=\"0\"")
            ? "1" : "0", "1");
        Eq("snap back",
            ToJsonDoc(snapHtml).Contains("\"layoutMode\": 0")
                ? "1" : "0", "1");
        // 空 body 也必须显式保留 [] 根身份，不可因 fields 为空省略。
        CmpRoundTrip(snapJson, ToJsonDoc(snapHtml), "empty document");
        CmpRoundTrip("{\"fields\":[]}",
            ToJsonDoc("<body data-zan-design></body>"), "empty body");

        // ---- 1b. 动态原语往返（P8）---------------------------------------
        // 都不在建模键名单里，靠元素名与 data-* 属性原样透传；读端
        // template → Element 由标签名兜底（data-kind 缺失也成立）。
        string dynJson = "{\n"
            + "  \"name\": \"DynDoc\",\n"
            + "  \"fields\": [\n"
            + "    {\n"
            + "      \"kind\": \"Element\",\n"
            + "      \"tag\": \"template\",\n"
            + "      \"name\": \"Rows\",\n"
            + "      \"for\": \"items\",\n"
            + "      \"kids\": [\n"
            + "        {\n"
            + "          \"kind\": \"Element\",\n"
            + "          \"tag\": \"li\",\n"
            + "          \"name\": \"RowLi\",\n"
            + "          \"kids\": [\n"
            + "            {\n"
            + "              \"kind\": \"Element\",\n"
            + "              \"tag\": \"span\",\n"
            + "              \"name\": \"RowName\",\n"
            + "              \"bindings\": [\n"
            + "                {\n"
            + "                  \"path\": \"name\",\n"
            + "                  \"property\": \"text\",\n"
            + "                  \"twoWay\": false\n"
            + "                }\n"
            + "              ]\n"
            + "            }\n"
            + "          ],\n"
            + "          \"style\": \"height:24px\"\n"
            + "        }\n"
            + "      ],\n"
            + "      \"style\": \"width:100%;flex-shrink:0\"\n"
            + "    },\n"
            + "    {\n"
            + "      \"kind\": \"Input\",\n"
            + "      \"name\": \"Title\",\n"
            + "      \"bindings\": [\n"
            + "        {\n"
            + "          \"path\": \"title\",\n"
            + "          \"property\": \"\",\n"
            + "          \"twoWay\": true\n"
            + "        },\n"
            + "        {\n"
            + "          \"path\": \"showTitle\",\n"
            + "          \"property\": \"visible\",\n"
            + "          \"twoWay\": false\n"
            + "        }\n"
            + "      ],\n"
            + "      \"style\": \"height:32px\"\n"
            + "    }\n"
            + "  ]\n"
            + "}\n";
        string dynHtml = DesignerHtml.FromJsonDoc(dynJson);
        string dynBack = ToJsonDoc(dynHtml);
        CmpRoundTrip(dynJson, dynBack, "dynamic");
        Eq("tpl element", dynHtml.Contains("<template") ? "1" : "0", "1");
        Eq("tpl for", dynHtml.Contains("data-for=\"items\"") ? "1" : "0", "1");
        Eq("visible binding", dynHtml.Contains(":visible=\"showTitle\"") ? "1" : "0", "1");
        Eq("one-way binding", dynHtml.Contains(":text=\"name\"") ? "1" : "0", "1");
        Eq("default binding", dynHtml.Contains(" bind=\"title\"") ? "1" : "0", "1");
        Eq("no legacy value binding", dynHtml.Contains("data-bind=") ? "0" : "1", "1");
        string bindingDoc = "{\"fields\":[{\"kind\":\"Input\",\"name\":\"Count\","
            + "\"bindings\":[{\"path\":\"count\",\"property\":\"value\",\"twoWay\":true}]}]}";
        string bindingHtml = DesignerHtml.FromJsonDoc(bindingDoc);
        Eq("explicit binding", bindingHtml.Contains("bind:value=\"count\"") ? "1" : "0", "1");
        CmpRoundTrip(bindingDoc, ToJsonDoc(bindingHtml), "explicit binding");
        Control exportRoot = new Control("root");
        Input exportedInput = new Input();
        exportedInput.BindPath("user.name");
        exportedInput.BindOneWay("saveTitle", "placeholder");
        exportRoot.Add(exportedInput);
        string exportDoc = DesignExport.Export(exportRoot, "Exported", 480, 320);
        Designer exportedDesigner = new Designer();
        exportedDesigner.LoadJson(exportDoc);
        Eq("code-tree export load", exportedDesigner.loadError ? "0" : "1", "1");
        Eq("code-tree export bindings", exportedDesigner.fields.Count == 1
            && exportedDesigner.fields[0].BindingCount == 2
            && exportedDesigner.fields[0].BindingAt(0).Path == "user.name"
            && exportedDesigner.fields[0].BindingAt(0).TwoWay
            && exportedDesigner.fields[0].BindingAt(1).Path == "saveTitle"
            && exportedDesigner.fields[0].BindingAt(1).Property == "placeholder"
            && !exportedDesigner.fields[0].BindingAt(1).TwoWay ? "1" : "0", "1");
        string exportHtml = DesignExport.ExportHtml(exportRoot, "Exported", 480, 320);
        Eq("code-tree HTML default binding", exportHtml.Contains("bind=\"user.name\"") ? "1" : "0", "1");
        Eq("code-tree HTML one-way binding", exportHtml.Contains(":placeholder=\"saveTitle\"") ? "1" : "0", "1");
        // 无 data-kind 的裸 <template>（运行期手写形态）也归 Element。
        string bareBack = ToJsonDoc(
            "<body data-zan-design><template data-for=\"xs\">"
            + "<p data-kind=\"Label\"></p></template></body>");
        Eq("bare tpl kind", bareBack.Contains("\"kind\": \"Element\"")
            ? "1" : "0", "1");
        Eq("bare tpl tag", bareBack.Contains("\"tag\": \"template\"")
            ? "1" : "0", "1");

        // ---- 1c. 原生 HTML 语义 ------------------------------------------
        // 手写真 HTML（无任何 data-* 建模属性）也能等价导入：
        // button/label/textarea 的文本内容；导出侧对称回写原生形态。
        string natHtml = "<body data-zan-design><button class=\"primary\" style=\"position:absolute;left:8px;top:8px;width:120px;height:36px\">点我</button>"
            + "<label style=\"position:absolute;left:8px;top:52px;width:120px;height:24px\">名称</label>"
            + "<img src=\"pic.png\" alt=\"图\" style=\"position:absolute;left:8px;top:84px;width:64px;height:64px\"/>"
            + "<input placeholder=\"请输入\" value=\"abc\" style=\"position:absolute;left:8px;top:156px;width:160px;height:32px\"/>"
            + "<textarea placeholder=\"备注\">hello</textarea></body>";
        string natBack = ToJsonDoc(natHtml);
        Eq("nat btn text", natBack.Contains("\"text\": \"点我\"")
            ? "1" : "0", "1");
        Eq("nat lbl text", natBack.Contains("\"text\": \"名称\"")
            ? "1" : "0", "1");
        Eq("nat img src", natBack.Contains("\"src\": \"pic.png\"")
            ? "1" : "0", "1");
        Eq("nat img alt", natBack.Contains("\"alt\": \"图\"")
            ? "1" : "0", "1");
        Eq("nat input ph", natBack.Contains("\"placeholder\": \"请输入\"")
            ? "1" : "0", "1");
        Eq("nat input val", natBack.Contains("\"value\": \"abc\"")
            ? "1" : "0", "1");
        Eq("nat textarea text", natBack.Contains("\"text\": \"hello\"")
            ? "1" : "0", "1");
        // 导出侧：text/src/alt/placeholder/value 回写为原生形态，
        string natJson = "{\n"
            + "  \"name\": \"NatDoc\",\n"
            + "  \"fields\": [\n"
            + "    {\n"
            + "      \"kind\": \"Button\",\n"
            + "      \"name\": \"GoBtn\",\n"
            + "      \"text\": \"点我\",\n"
            + "      \"style\": \"height:36px\"\n"
            + "    },\n"
            + "    {\n"
            + "      \"kind\": \"Image\",\n"
            + "      \"name\": \"Pic\",\n"
            + "      \"src\": \"pic.png\",\n"
            + "      \"alt\": \"图\",\n"
            + "      \"style\": \"height:64px\"\n"
            + "    },\n"
            + "    {\n"
            + "      \"kind\": \"Input\",\n"
            + "      \"name\": \"Title\",\n"
            + "      \"placeholder\": \"请输入\",\n"
            + "      \"style\": \"height:32px\"\n"
            + "    }\n"
            + "  ]\n"
            + "}\n";
        string natHtml2 = DesignerHtml.FromJsonDoc(natJson);
        CmpRoundTrip(natJson, ToJsonDoc(natHtml2), "native");
        Eq("nat exp btn", natHtml2.Contains(">点我</button>") ? "1" : "0", "1");
        Eq("nat exp btn nodatatext", natHtml2.Contains("data-text")
            ? "1" : "0", "0");
        Eq("nat exp img", natHtml2.Contains("src=\"pic.png\"") ? "1" : "0", "1");
        Eq("nat exp img nodatasrc", natHtml2.Contains("data-src")
            ? "1" : "0", "0");
        Eq("nat exp input", natHtml2.Contains("placeholder=\"请输入\"")
            ? "1" : "0", "1");

        // ---- 1d. 原生表单族语义 ------------------------------------------
        // 一族、<p> 段落——手写无 data-* 也等价导入。
        string fmHtml = "<body data-zan-design><hr data-x-props='{\"text\":\"分割线\"}' style=\"position:absolute;left:8px;top:8px;width:200px;height:16px\"/>"
            + "<progress value=\"72\" max=\"100\" style=\"position:absolute;left:8px;top:32px;width:200px;height:20px\"/>"
            + "<select style=\"position:absolute;left:8px;top:60px;width:160px;height:32px\"><option>甲</option><option selected>乙</option><option>丙</option>"
            + "</select><input type=\"checkbox\" value=\"记住我\" checked=\"true\" style=\"position:absolute;left:8px;top:100px;width:120px;height:28px\"/>"
            + "<input type=\"radio\" value=\"已选中\" style=\"position:absolute;left:8px;top:136px;width:120px;height:28px\"/>"
            + "<input type=\"range\" min=\"0\" max=\"100\" step=\"2\" value=\"30\" style=\"position:absolute;left:8px;top:172px;width:180px;height:28px\"/>"
            + "<input type=\"color\" value=\"#378add\" style=\"position:absolute;left:8px;top:208px;width:60px;height:28px\"/>"
            + "<input type=\"number\" min=\"0\" max=\"100\" value=\"42\" style=\"position:absolute;left:8px;top:244px;width:120px;height:32px\"/>"
            + "<input type=\"date\" value=\"2026-09-13\" style=\"position:absolute;left:8px;top:284px;width:160px;height:32px\"/>"
            + "<input type=\"file\" data-x-props='{\"triggerText\":\"点击上传\"}' style=\"position:absolute;left:8px;top:324px;width:160px;height:32px\"/>"
            + "<p style=\"position:absolute;left:8px;top:364px;width:220px;height:56px\">标题与正文</p></body>";
        string fmBack = ToJsonDoc(fmHtml);
        Eq("fm hr kind", fmBack.Contains("\"kind\": \"Divider\"")
            ? "1" : "0", "1");
        Eq("fm hr text", fmBack.Contains("\"text\": \"分割线\"")
            ? "1" : "0", "1");
        Eq("fm progress kind", fmBack.Contains("\"kind\": \"Progress\"")
            ? "1" : "0", "1");
        Eq("fm progress pct", fmBack.Contains("\"percent\": 72")
            ? "1" : "0", "1");
        Eq("fm select kind", fmBack.Contains("\"kind\": \"SelectBox\"")
            ? "1" : "0", "1");
        Eq("fm select opts", fmBack.Contains("\"options\": \"甲|乙|丙\"")
            ? "1" : "0", "1");
        Eq("fm select sel", fmBack.Contains("\"value\": 1")
            ? "1" : "0", "1");
        Eq("fm cb kind", fmBack.Contains("\"kind\": \"Checkbox\"")
            ? "1" : "0", "1");
        Eq("fm cb label", fmBack.Contains("\"label\": \"记住我\"")
            ? "1" : "0", "1");
        Eq("fm cb checked", fmBack.Contains("\"defOn\": true")
            ? "1" : "0", "1");
        Eq("fm radio kind", fmBack.Contains("\"kind\": \"Radio\"")
            ? "1" : "0", "1");
        Eq("fm range kind", fmBack.Contains("\"kind\": \"Slider\"")
            ? "1" : "0", "1");
        Eq("fm range min", fmBack.Contains("\"min\": \"0\"")
            ? "1" : "0", "1");
        Eq("fm range step", fmBack.Contains("\"step\": \"2\"")
            ? "1" : "0", "1");
        Eq("fm color kind", fmBack.Contains("\"kind\": \"ColorPicker\"")
            ? "1" : "0", "1");
        Eq("fm color val", fmBack.Contains("\"value\": \"#378add\"")
            ? "1" : "0", "1");
        Eq("fm num kind", fmBack.Contains("\"kind\": \"InputNumber\"")
            ? "1" : "0", "1");
        Eq("fm date kind", fmBack.Contains("\"kind\": \"DatePicker\"")
            ? "1" : "0", "1");
        Eq("fm date val", fmBack.Contains("\"value\": \"2026-09-13\"")
            ? "1" : "0", "1");
        Eq("fm file kind", fmBack.Contains("\"kind\": \"Upload\"")
            ? "1" : "0", "1");
        Eq("fm file props", fmBack.Contains("\"triggerText\": \"点击上传\"")
            ? "1" : "0", "1");
        Eq("fm p kind", fmBack.Contains("\"kind\": \"Typography\"")
            ? "1" : "0", "1");
        Eq("fm p text", fmBack.Contains("\"text\": \"标题与正文\"")
            ? "1" : "0", "1");
        // 导出侧对称：模型 → 原生形态，且模型级往返等价。
        string fmJson = "{\n"
            + "  \"name\": \"FmDoc\",\n"
            + "  \"fields\": [\n"
            + "    {\n"
            + "      \"kind\": \"Divider\",\n"
            + "      \"name\": \"Line\",\n"
            + "      \"text\": \"分割线\",\n"
            + "      \"style\": \"height:16px\"\n"
            + "    },\n"
            + "    {\n"
            + "      \"kind\": \"Progress\",\n"
            + "      \"name\": \"P\",\n"
            + "      \"percent\": 72,\n"
            + "      \"style\": \"height:20px\"\n"
            + "    },\n"
            + "    {\n"
            + "      \"kind\": \"SelectBox\",\n"
            + "      \"name\": \"Sel\",\n"
            + "      \"options\": \"甲|乙|丙\",\n"
            + "      \"value\": 1,\n"
            + "      \"style\": \"height:32px\"\n"
            + "    },\n"
            + "    {\n"
            + "      \"kind\": \"Checkbox\",\n"
            + "      \"name\": \"Ck\",\n"
            + "      \"label\": \"记住我\",\n"
            + "      \"defOn\": true,\n"
            + "      \"style\": \"height:28px\"\n"
            + "    },\n"
            + "    {\n"
            + "      \"kind\": \"Slider\",\n"
            + "      \"name\": \"Sl\",\n"
            + "      \"min\": 0,\n"
            + "      \"max\": 100,\n"
            + "      \"step\": 2,\n"
            + "      \"value\": 30,\n"
            + "      \"style\": \"height:28px\"\n"
            + "    },\n"
            + "    {\n"
            + "      \"kind\": \"Upload\",\n"
            + "      \"name\": \"Up\",\n"
            + "      \"props\": {\n"
            + "        \"triggerText\": \"点击上传\"\n"
            + "      },\n"
            + "      \"style\": \"height:32px\"\n"
            + "    },\n"
            + "    {\n"
            + "      \"kind\": \"Typography\",\n"
            + "      \"name\": \"Tx\",\n"
            + "      \"text\": \"标题与正文\",\n"
            + "      \"style\": \"height:56px\"\n"
            + "    }\n"
            + "  ]\n"
            + "}\n";
        string fmHtml2 = DesignerHtml.FromJsonDoc(fmJson);
        CmpRoundTrip(fmJson, ToJsonDoc(fmHtml2), "form widgets");
        Eq("fm exp hr", fmHtml2.Contains("<hr") ? "1" : "0", "1");
        Eq("fm exp progress", fmHtml2.Contains("value=\"72\" max=\"100\"")
            ? "1" : "0", "1");
        Eq("fm exp select opt", fmHtml2.Contains(">甲</option>")
            && fmHtml2.Contains("<option selected>乙</option>")
            ? "1" : "0", "1");
        Eq("fm exp checkbox", fmHtml2.Contains("type=\"checkbox\"")
            && fmHtml2.Contains("value=\"记住我\"")
            && fmHtml2.Contains("checked=\"true\"") ? "1" : "0", "1");
        Eq("fm exp range", fmHtml2.Contains("type=\"range\"")
            && fmHtml2.Contains("step=\"2\"") ? "1" : "0", "1");
        Eq("fm exp file", fmHtml2.Contains("type=\"file\"")
            ? "1" : "0", "1");
        Eq("fm exp p", fmHtml2.Contains(">标题与正文</p>")
            ? "1" : "0", "1");

        // ---- 1e. zan-* 自定义元素（无原生等价组件的组件化形态）----
        // 没有原生等价物的组件（Avatar/Card/DataGrid…）导出为
        // `zan-<kebab>` 标签，读端 TagKind 反解；原生 div 则保留标签
        // 身份，CSS 几何不参与类型判定。
        string ceHtml = "<body data-zan-design><zan-avatar id=\"Av\" data-x-props='{\"label\":\"ZK\"}' style=\"position:absolute;left:8px;top:8px;width:48px;height:48px\">"
            + "</zan-avatar><div id=\"Shell\" class=\"card\" style=\"position:absolute;top:64px;width:200px;height:60px\"></div></body>";
        string ceBack = ToJsonDoc(ceHtml);
        Eq("ce avatar kind", ceBack.Contains("\"kind\": \"Avatar\"")
            ? "1" : "0", "1");
        Eq("ce shell panel", ceBack.Contains("\"kind\": \"Panel\"")
            ? "1" : "0", "1");
        string ceJson = "{\n"
            + "  \"name\": \"CeDoc\",\n"
            + "  \"fields\": [\n"
            + "    {\n"
            + "      \"kind\": \"Avatar\",\n"
            + "      \"name\": \"Av\",\n"
            + "      \"props\": {\n"
            + "        \"label\": \"ZK\"\n"
            + "      },\n"
            + "      \"style\": \"height:48px\"\n"
            + "    },\n"
            + "    {\n"
            + "      \"kind\": \"Panel\",\n"
            + "      \"name\": \"Shell\",\n"
            + "      \"class\": \"card\",\n"
            + "      \"style\": \"height:60px\"\n"
            + "    }\n"
            + "  ]\n"
            + "}\n";
        string ceHtml2 = DesignerHtml.FromJsonDoc(ceJson);
        CmpRoundTrip(ceJson, ToJsonDoc(ceHtml2), "custom elements");
        Eq("ce exp avatar", ceHtml2.Contains("<zan-avatar")
            && !ceHtml2.Contains("data-kind=\"Avatar\"") ? "1" : "0", "1");
        Eq("ce exp panel bare", ceHtml2.Contains("<zan-panel id=\"Shell\"")
            && !ceHtml2.Contains("data-kind=\"Panel\"") ? "1" : "0", "1");

        // ---- 2. 设计器桥 -------------------------------------------------
        Designer d = new Designer();
        d.LoadHtmlText(html);
        Eq("bridge loadError", d.loadError ? "1" : "0", "0");
        // 桥的模型侧：style 属性落回 FormField.styleText（P7b 内联
        // 声明编辑的数据源）。
        Eq("bridge styleText", FindStyleText(d.fields, "Line"),
            "flex-grow:1;padding:8px; background:#101418");
        string saved = d.SaveHtml();
        Designer d2 = new Designer();
        d2.LoadHtmlText(saved);
        Eq("bridge reload", d2.loadError ? "1" : "0", "0");
        Eq("bridge stable", d2.SaveHtml() == saved ? "1" : "0", "1");

        // 空文档：HTML 解析对任何输入都产出（隐式）body——空文档
        // 降级成空表单而非错误。HTML 没有 JSON 那样的"损坏"形态，
        // loadError 通道对 .html 输入基本不可达（这是格式的诚实契约）。
        Designer d3 = new Designer();
        d3.LoadHtmlText("");
        Eq("bridge empty", d3.loadError ? "1" : "0", "0");
        Eq("bridge empty fields",
           d3.SaveHtml().Contains("<div") || d3.SaveHtml().Contains("<label")
           ? "1" : "0", "0");

        if (fails == 0) {
            Console.WriteLine("P7 designer html OK");
        } else {
            Console.WriteLine("P7 designer html FAILS " + fails);
        }
    }
}
