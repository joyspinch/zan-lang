// 核心契约与语义定义。
// 核心契约与语义定义。
using System;
using System.Text;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        // 核心契约与语义定义。
        if (!Fuzzy.Matches("flst", "FileList")) { bad = bad + 1; }
        if (!Fuzzy.Matches("zanc", "build/zanc.exe")) { bad = bad + 1; }
        if (Fuzzy.Matches("xyz", "abc")) { bad = bad + 1; }
        if (!Fuzzy.Matches("", "anything")) { bad = bad + 1; }
        // 核心契约与语义定义。
        if (Fuzzy.Score("FileList", "FileList") != 1.0) { bad = bad + 1; }
        if (Fuzzy.Score("zzz", "abc") != 0.0) { bad = bad + 1; }
        // 核心契约与语义定义。
        // 核心契约与语义定义。
        // 核心契约与语义定义。
        double ordered = Fuzzy.Score("flst", "FileList");
        double scattered = Fuzzy.Score("flit", "FileList");
        if (ordered <= scattered) { bad = bad + 1; }
        if (ordered <= 0.5 || ordered > 1.0) { bad = bad + 1; }

        // 核心契约与语义定义。
        // 核心契约与语义定义。
        Bm25Index idx = new Bm25Index();
        idx.Add(1, "the quick brown fox jumps over the lazy dog");
        idx.Add(2, "gardening tips for tomatoes and roses");
        idx.Add(3, "fox hunting is a traditional sport");
        List<int> hits = idx.Search("quick fox");
        if (hits.Count < 2) { bad = bad + 1; }
        else {
            if (hits[0] != 1) { bad = bad + 1; }      // both terms
        }
        // 核心契约与语义定义。
        List<int> rare = idx.Search("tomatoes");
        if (rare.Count != 1 || rare[0] != 2) { bad = bad + 1; }
        // 核心契约与语义定义。
        idx.Remove(2);
        if (idx.Search("tomatoes").Count != 0) { bad = bad + 1; }
        if (idx.Count() != 2) { bad = bad + 1; }
        // 核心契约与执行状态转移规范。
        if (idx.Search("").Count != 0) { bad = bad + 1; }
        Console.WriteLine("fuzzy-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
