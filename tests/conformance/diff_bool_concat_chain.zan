using System;

// B-ID132：三段及以上字符串链拉平（StrConcatN）与两段拼接下布尔值渲染对齐金标。
// 验证无论比较表达式、布尔局部变量、字面量还是复合链，均统一发射小写 true/false。
class Program {
    static void Main() {
        object u = null;
        object v = new object();

        // 1. 三段及以上链中的 null 比较表达式
        string s1 = "u=" + (u == null) + " v=" + (v == null) + " end";
        Console.WriteLine("null_cmp_chain=" + s1);

        // 2. 算术比较表达式在三段链中
        int x = 10;
        int y = 20;
        string s2 = "x_eq=" + (x == 10) + " y_gt=" + (y > 50) + " y_lt=" + (y < 30);
        Console.WriteLine("arith_cmp_chain=" + s2);

        // 3. 布尔变量在三段链中
        bool b1 = true;
        bool b2 = false;
        bool b3 = true;
        string s3 = "b1=" + b1 + " b2=" + b2 + " b3=" + b3;
        Console.WriteLine("bool_var_chain=" + s3);

        // 4. 布尔字面量直接在三段链中
        string s4 = "lit1=" + true + " lit2=" + false + " lit3=" + true;
        Console.WriteLine("bool_lit_chain=" + s4);

        // 5. 复合混合链
        string s5 = "mix:" + (u != null) + ":" + false + ":" + (v != null) + ":" + true;
        Console.WriteLine("mix_chain=" + s5);

        // 6. 实例 ToString 与 Convert.ToString 对比
        Console.WriteLine("tostr=" + b1.ToString() + "/" + Convert.ToString(b2));

        Console.WriteLine("diff_bool_concat_chain: PASS");
    }
}
