using System;

class LazySink {
    string name;
    string value;
    LazySink(string name) { this.name = name; }
    LazySink Set(string key, string text) {
        this.value = key + ":" + text;
        return this;
    }
}

class Program {
    static int calls;
    static string trace = "";
    static LazySink current;
    static LazySink replacement;

    static LazySink Receiver() {
        Program.trace = Program.trace + "R";
        return Program.current;
    }
    static string Key() {
        Program.trace = Program.trace + "K";
        return "ordered";
    }
    static async bool Check() {
        await Task.Yield();
        Program.calls = Program.calls + 1;
        return true;
    }
    static async string Text() {
        await Task.Yield();
        return "yes";
    }
    static async string Change() {
        Program.trace = Program.trace + "A";
        Program.current = Program.replacement;
        await Task.Yield();
        Program.trace = Program.trace + "B";
        return "yes";
    }
    static async void Run() {
        LazySink d = new LazySink("first");
        d.Set("approved", true && await Program.Check() ? "1" : "");
        Console.WriteLine(d.value);
        d.Set("skipped", false && await Program.Check() ? "bad" : "ok");
        Console.WriteLine(d.value);
        d.Set("orSkipped", true || await Program.Check() ? "ok" : "bad");
        Console.WriteLine(d.value);
        d.Set("or", false || await Program.Check() ? "ok" : "bad");
        Console.WriteLine(d.value);
        d.Set("nested", true ? (false ? await Program.Text() : await Program.Text()) : "bad");
        Console.WriteLine(d.value);
        d.Set("dead", false ? await Program.Text() : "ok");
        Console.WriteLine(d.value);
        Console.WriteLine(Program.calls);
        Program.current = d;
        Program.replacement = new LazySink("second");
        Program.Receiver().Set(Program.Key(), true ? await Program.Change() : "bad");
        Console.WriteLine(Program.trace);
        Console.WriteLine(d.value);
        Console.WriteLine(Program.current.name);
        Program.current = null;
        Program.replacement = null;
    }
    static void Main() { await Program.Run(); }
}
