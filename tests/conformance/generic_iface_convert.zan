using System;

// A43-B22② 泛型接口引用转换：类→实例化接口在实参/初始化位置都成立，
// 接口继承泛型接口（BoxSource<T> : Box<T>）的单跳提升同样成立，
// 且经由提升后的接口调用时实参/返回类型按使用点实参替换。
interface Seq<T> {
    T At(int i);
    int Count();
}

class Range : Seq<int> {
    int n;
    Range(int n) { this.n = n; }
    static Range Of(int n) { return new Range(n); }
    public int At(int i) { return i * 2; }
    public int Count() { return n; }
}

interface Box<T> {
    T Get();
    void Put(T v, T w);
}

interface BoxSource<T> : Box<T> {
    int Size();
}

class IntBox : BoxSource<int> {
    int v;
    public int Get() { return v; }
    public void Put(int a, int b) { v = a + b; }
    public int Size() { return 3; }
}

class Program {
    static int Sum(Seq<int> s) {
        int t = 0;
        for (int i = 0; i < s.Count(); i = i + 1) { t = t + s.At(i); }
        return t;
    }
    static void Main() {
        Seq<int> r = Range.Of(3);
        Console.WriteLine("sum " + Convert.ToString(Sum(r)));
        BoxSource<int> src = new IntBox();
        src.Put(5, 6);
        Box<int> up = src;
        Console.WriteLine("up " + Convert.ToString(up.Get()));
        Console.WriteLine("size " + Convert.ToString(src.Size()));
    }
}
