using System;
using Gui;
using Gui.Widget;
using Gui.Markup;

class Program {
    static int fails;

    static void Check(string what, bool cond) {
        if (cond) {
            Console.WriteLine("OK: " + what);
        } else {
            fails = fails + 1;
            Console.WriteLine("FAIL: " + what);
        }
    }

    static int Main() {
        string html = 
            "<div id=\"root\">"
            + "  <row id=\"toolbar\">"
            + "    <button id=\"btn-refresh\">刷新</button>"
            + "    <spacer id=\"sp\" />"
            + "    <button id=\"btn-add\">新增</button>"
            + "  </row>"
            + "  <card id=\"info-card\" title=\"用户信息卡\">"
            + "    <button id=\"btn-edit\" slot=\"extra\">编辑</button>"
            + "    <form-group id=\"user-form\" label-placement=\"left\" label-width=\"90\">"
            + "      <form-item id=\"item-user\" label=\"账号\" required=\"true\">"
            + "        <input name=\"username\" value=\"admin\" />"
            + "      </form-item>"
            + "      <form-item id=\"item-email\" label=\"邮箱\">"
            + "        <input name=\"email\" value=\"admin@example.com\" />"
            + "      </form-item>"
            + "    </form-group>"
            + "    <button id=\"btn-save\" slot=\"action\">保存设置</button>"
            + "  </card>"
            + "  <modal id=\"confirm-modal\" title=\"危险确认\" width=\"480\">"
            + "    <label id=\"modal-tip\">确定要执行此操作吗？</label>"
            + "  </modal>"
            + "  <drawer id=\"detail-drawer\" title=\"属性详情\" placement=\"right\">"
            + "    <label id=\"drawer-tip\">这是右侧滑出的属性面板</label>"
            + "  </drawer>"
            + "  <empty id=\"empty-box\" text=\"没有订单\" description=\"请点击新增创建第一笔订单\" />"
            + "  <result id=\"result-box\" status=\"success\" title=\"支付成功\" description=\"订单将于24小时内发货\" />"
            + "</div>";

        HtmlDoc doc = Html.Parse(html, "", new HtmlHandlers());
        if (doc == null || doc.root == null) {
            Console.WriteLine("FAIL: parse returned null");
            return 1;
        }

        Control root = doc.root;
        Control toolbar = root.Find("toolbar");
        Check("Row parsed and mapped", toolbar != null && toolbar.Kind() == "Row");

        Control sp = root.Find("sp");
        Check("Spacer parsed and mapped", sp != null && sp.Kind() == "Spacer");

        Control card = root.Find("info-card");
        Check("Card parsed and mapped", card != null && card.Kind() == "Card");

        Control form = root.Find("user-form");
        Check("FormGroup parsed and mapped", form != null && form.Kind() == "FormGroup");

        Control itemUser = root.Find("item-user");
        Check("FormItem parsed and mapped", itemUser != null && itemUser.Kind() == "FormItem");
        if (itemUser is FormItem) {
            FormItem fi = (FormItem)itemUser;
            Check("FormItem has input field", fi.field != null && fi.field.Kind() == "Input");
            Check("FormItem field name is username", fi.Name() == "username");
            Check("FormItem required rule registered", fi.rules.Count > 0);
        }

        if (form is FormGroup) {
            FormGroup fg = (FormGroup)form;
            Check("FormGroup count == 2", fg.Count() == 2);
            Check("FormGroup Validate passes on valid data", fg.Validate());
        }

        Control modal = root.Find("confirm-modal");
        Check("Modal parsed and mapped", modal != null && modal.Kind() == "Modal");

        Control drawer = root.Find("detail-drawer");
        Check("Drawer parsed and mapped", drawer != null && drawer.Kind() == "Drawer");

        Control emptyBox = root.Find("empty-box");
        Check("Empty parsed and mapped", emptyBox != null && emptyBox.Kind() == "Empty");

        Control resultBox = root.Find("result-box");
        Check("Result parsed and mapped", resultBox != null && resultBox.Kind() == "Result");

        if (fails == 0) {
            Console.WriteLine("GUI_DECLARATIVE_HTML_MODERN_OK");
            return 0;
        }
        return 1;
    }
}
