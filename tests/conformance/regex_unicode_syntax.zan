using System;
using System.Text;
using System.Text.RegularExpressions;

// 接口数据协议与执行契约。
class Program {
    static string M(string pattern, string input) {
        string why = Regex.Validate(pattern);
        if (why.Length > 0) { return "ERR"; }
        Match m = Regex.Compile(pattern).Find(input);
        if (!m.Success()) { return "-"; }
        return m.Group(0);
    }

    static void Main() {
        // 核心契约与语义定义。
        Console.WriteLine("dot=" + M(".", "中文"));
        Console.WriteLine("anchored_dot=" + M("^.$", "中"));
        Console.WriteLine("class_hit=" + M("[中文]+", "中文"));
        Console.WriteLine("class_miss=" + M("[中]", "文"));
        Console.WriteLine("class_range=" + M("[\\u4e00-\\u9fa5]+", "中文abc"));
        Console.WriteLine("neg_class=" + M("[^a]", "中"));
        Console.WriteLine("quant=" + M("文{2}", "中文文"));

        // 接口数据协议与执行契约。
        Console.WriteLine("class_D=" + M("[\\D]", "a") + M("[\\D]", "5"));
        Console.WriteLine("class_S=" + M("[\\S]", "x") + M("[\\S]", " "));
        Console.WriteLine("class_mixed=" + M("[\\Dx]", "5x"));

        // Escapes.
        Console.WriteLine("hex=" + M("\\x41", "A") + M("\\x{4e2d}", "中")
            + M("\\u4e2d", "中"));
        Console.WriteLine("ctrl=" + Convert.ToString(
            M("\\cA", Encoding.CharFromCode(1)).Length)
            + Convert.ToString(M("\\a", Encoding.CharFromCode(7)).Length));

        // Anchors.
        Console.WriteLine("bos=" + M("\\Aab", "ab") + M("a\\Ab", "ab"));
        Console.WriteLine("eos=" + M("ab\\z", "ab\n") + M("ab\\Z", "ab\n"));

        // 核心契约与语义定义。
        Console.WriteLine("flag_i=" + M("(?i)ab", "AB") + M("(?i)[a-z]+", "ABC"));
        Console.WriteLine("flag_s=" + Convert.ToString(M("(?s)a.b", "a\nb").Length)
            + Convert.ToString(M("a.b", "a\nb").Length));
        Console.WriteLine("flag_m=" + M("(?m)^b", "a\nb"));

        // 核心契约与语义定义。
        Console.WriteLine("look=" + M("a(?=b)", "ab") + M("a(?!b)", "ac"));
        Console.WriteLine("behind=" + M("(?<=ab)c", "abc") + M("(?<!x)c", "abc"));
        Console.WriteLine("named=" + M("(?<w>\\d+)", "42") + M("(?<c>\\w)\\k<c>", "aa"));
        Console.WriteLine("atomic=" + M("(?>ab|a)b", "ab") + M("(?>a)b", "ab"));
        Console.WriteLine("comment=" + M("a(?#skipped)b", "ab"));
        Regex named = Regex.Compile("(?<k>\\w+)=(?<v>\\d+)");
        Console.WriteLine("group_number=" + Convert.ToString(named.GroupNumber("v"))
            + Convert.ToString(named.GroupNumber("nope")));

        // 核心契约与执行状态转移规范。
        Console.WriteLine("posix=" + M("[[:digit:]]+", "42") + M("[[:alpha:]]+", "ab1"));

        // 核心契约与语义定义。
        Console.WriteLine("empty_loop=" + M("(a*)*b", "aaab") + M("(a?)*b", "b")
            + M("()*a", "a"));

        // 核心契约与执行状态转移规范。
        Regex kv = Regex.Compile("(\\w+)=(\\d+)");
        Console.WriteLine("braced=" + kv.Replace("port=8080", "${2}:${1}"));
        Console.WriteLine("amp=" + kv.Replace("port=8080", "[$&]"));
        Console.WriteLine("by_name=" + named.Replace("port=8080", "${v}/${k}"));
        Console.WriteLine("bad_ref=" + kv.Replace("port=8080", "${9}"));

        // 接口数据协议与执行契约。
        // 核心契约与执行状态转移规范。
        Console.WriteLine("empty_steps="
            + Convert.ToString(Regex.Compile("").Matches("中a").Count));

        // 接口数据协议与执行契约。
        // 核心契约与执行状态转移规范。
        Console.WriteLine("rejected=" + M("\\p{L}", "a") + M("a++", "a")
            + M("(?i:ab)", "AB") + M("\\101", "A") + M("(?<=a+)c", "aac")
            + M("[[:nope:]]", "a"));
    }
}
