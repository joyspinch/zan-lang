using System;
using System.Diagnostics;
using System.Threading;

namespace Conf;

class Prog {
    static int ticks;

    static void Main() {
        int bad = 0;
        Stopwatch sw = new Stopwatch();
        sw.Start();
        Thread.Sleep(200);
        sw.Stop();
        double ms = sw.ElapsedMilliseconds();
        if (ms < 150.0 || ms > 400.0) { bad = bad + 1; }
        long f = Stopwatch.Frequency();
        if (f < 1000 || f > 10000000000) { bad = bad + 1; }
        sw.Reset();
        if (sw.ElapsedMilliseconds() != 0.0) { bad = bad + 1; }

        // 验证现代零分配静态计时原语
        long t0 = Stopwatch.GetTimestamp();
        Thread.Sleep(50);
        double staticMs = Stopwatch.GetElapsedTimeMilliseconds(t0);
        if (staticMs < 30.0 || staticMs > 300.0) { bad = bad + 1; }
        TimeSpan elapsedSpan = Stopwatch.GetElapsedTime(t0);
        if (elapsedSpan.TotalMilliseconds() < 30 || elapsedSpan.TotalMilliseconds() > 300) { bad = bad + 1; }

        ticks = 0;
        Timer t = new Timer(50, Prog.Tick);
        t.Start();
        Thread.Sleep(400);
        t.Stop();
        int before = ticks;
        Thread.Sleep(150);
        if (ticks != before) { bad = bad + 1; }   // stopped: no more ticks
        if (before < 2) { bad = bad + 1; }        // fired at least twice
        Console.WriteLine("timer-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }

    static void Tick() {
        ticks = ticks + 1;
    }
}
