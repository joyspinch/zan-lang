// Stopwatch + Timer test: Stopwatch measures a real sleep within a loose
// tolerance; Timer fires periodically and Stop halts it.
using System;
using System.Diagnostics;
using System.Threading;

namespace Conf;

class Prog {
    static int ticks;

    static void Main() {
        int bad = 0;
        // Stopwatch: 200 ms sleep should measure ~150-400 ms.
        Stopwatch sw = new Stopwatch();
        sw.Start();
        Thread.Sleep(200);
        sw.Stop();
        double ms = sw.ElapsedMilliseconds();
        if (ms < 150.0 || ms > 400.0) { bad = bad + 1; }
        // Frequency is sane (1 kHz to 10 GHz).
        long f = Stopwatch.Frequency();
        if (f < 1000 || f > 10000000000) { bad = bad + 1; }
        // Reset clears the reading.
        sw.Reset();
        if (sw.ElapsedMilliseconds() != 0.0) { bad = bad + 1; }
        // Timer: 50 ms interval, let it fire 3+ times in ~400 ms, then stop.
        ticks = 0;
        Timer t = new Timer(50, Prog.Tick);
        t.Start();
        Thread.Sleep(400);
        t.Stop();
        int before = ticks;
        Thread.Sleep(150);
        if (ticks != before) { bad = bad + 1; }   // stopped: no more ticks
        if (before < 2) { bad = bad + 1; }        // fired at least twice
        Console.WriteLine("timer-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }

    static void Tick() {
        ticks = ticks + 1;
    }
}
