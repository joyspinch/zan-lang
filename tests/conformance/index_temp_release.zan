using System;

namespace IndexTempRelease;

// 接口数据协议与执行契约。
class Program {
    static Dict<string, string> Table() {
        Dict<string, string> d = new Dict<string, string>();
        d["k"] = "v";
        return d;
    }

    static List<string> Names() {
        List<string> l = new List<string>();
        l.Add("first");
        l.Add("second");
        return l;
    }

    static void Main() {
        Console.WriteLine("a,b,c".Split(",")[1]);
        Console.WriteLine(Program.Names()[1]);
        Console.WriteLine(Program.Table()["k"]);
        Console.WriteLine("hello".Substring(1, 3)[0]);

        // 接口数据协议与执行契约。
        string kept = Program.Names()[0];
        Console.WriteLine(kept.ToUpper());

        // 接口数据协议与执行契约。
        List<string> named = Program.Names();
        Console.WriteLine(named[0]);
        Console.WriteLine(named[1]);
    }
}
