using System;

namespace IndexTempRelease;

// Indexing a container that is itself a temporary used to leak the container:
// nothing owned it, so nothing released it. The element now comes out retained
// and the container is dropped on the spot. Under --check-leaks (the leakcheck
// variant of this test) every shape below has to end at zero live objects.
class Program {
    static Dict<string, string> Table() {
        Dict<string, string> d = new Dict<string, string>();
        d["k"] = "v";
        return d;
    }

    static List<string> Names() {
        List<string> l = new List<string>();
        l.Add("first");
        l.Add("second");
        return l;
    }

    static void Main() {
        Console.WriteLine("a,b,c".Split(",")[1]);
        Console.WriteLine(Program.Names()[1]);
        Console.WriteLine(Program.Table()["k"]);
        Console.WriteLine("hello".Substring(1, 3)[0]);

        // the element outlives the container it came from
        string kept = Program.Names()[0];
        Console.WriteLine(kept.ToUpper());

        // a named container is still borrowed, not released, on index
        List<string> named = Program.Names();
        Console.WriteLine(named[0]);
        Console.WriteLine(named[1]);
    }
}
