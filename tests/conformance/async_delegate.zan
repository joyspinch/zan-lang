// 接口数据协议与执行契约。
class Program {
    static async int Doubler(int x) {
        return x * 2;
    }

    static async int DoublerPlus(int x) {
        int d = await Doubler(x);
        return d + 100;
    }

    static async int Run(Handler h, int x) {
        int r = await h(x);
        return r + 1;
    }

    static void Main() {
        Handler h1 = Doubler;
        int v1 = await Run(h1, 21);
        Console.WriteLine(v1);

        Handler h2 = DoublerPlus;
        int v2 = await Run(h2, 21);
        Console.WriteLine(v2);
    }
}

async delegate int Handler(int x);
