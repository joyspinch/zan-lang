// Awaiting an async delegate (indirect async call). The delegate's callee is
// a loaded function pointer with no static name, so the awaiter cannot recover
// `<ramp>$resume` by mangling -- it must read the resume fn the ramp stored in
// the frame header (ASYNC_FRAME_SELF_STEP). Both a leaf async target and one
// that itself awaits are driven through the delegate.
class Program {
    static async int Doubler(int x) {
        return x * 2;
    }

    static async int DoublerPlus(int x) {
        int d = await Doubler(x);
        return d + 100;
    }

    static async int Run(Handler h, int x) {
        int r = await h(x);
        return r + 1;
    }

    static void Main() {
        Handler h1 = Doubler;
        int v1 = await Run(h1, 21);
        Console.WriteLine(v1);

        Handler h2 = DoublerPlus;
        int v2 = await Run(h2, 21);
        Console.WriteLine(v2);
    }
}

async delegate int Handler(int x);
