using System;

class Registry {
    public static int count = 3;
    public static int doubled;
    public static readonly string tag;
    public int id = 1;

    static Registry() {
        doubled = count * 2;
        tag = "reg";
    }

    public Registry(int extra) { id = id + extra; }
}

class Empty {
    public static int flag;
    static Empty() { flag = 9; }
}

// Both declaration orders are legal: startup type initialization and instance
// construction use distinct overload sets despite both having zero parameters.
class StaticFirst {
    public static int ready = 10;
    public int value;
    static StaticFirst() { ready = ready + 1; }
    public StaticFirst() { value = ready; }
}
class InstanceFirst {
    public static int ready = 20;
    public int value;
    public InstanceFirst() { value = ready; }
    static InstanceFirst() { ready = ready + 1; }
}

class Program {
    static void Main() {
        Console.WriteLine(Convert.ToString(Registry.doubled));
        Console.WriteLine(Registry.tag);
        Console.WriteLine(Convert.ToString(Empty.flag));
        // A static constructor does not suppress the implicit instance one.
        Empty empty = new Empty();
        if (empty == null) { throw new Exception("implicit instance constructor"); }
        Registry r = new Registry(2);
        Console.WriteLine(Convert.ToString(r.id));
        Console.WriteLine(Convert.ToString(Registry.doubled));
        StaticFirst first = new StaticFirst();
        InstanceFirst second = new InstanceFirst();
        Console.WriteLine(Convert.ToString(first.value));
        Console.WriteLine(Convert.ToString(second.value));
    }
}
