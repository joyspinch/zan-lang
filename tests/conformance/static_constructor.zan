using System;

class Registry {
    public static int count = 3;
    public static int doubled;
    public static readonly string tag;
    public int id = 1;

    static Registry() {
        doubled = count * 2;
        tag = "reg";
    }

    public Registry(int extra) { id = id + extra; }
}

class Empty {
    public static int flag;
    static Empty() { flag = 9; }
}

class Program {
    static void Main() {
        Console.WriteLine(Convert.ToString(Registry.doubled));
        Console.WriteLine(Registry.tag);
        Console.WriteLine(Convert.ToString(Empty.flag));
        Registry r = new Registry(2);
        Console.WriteLine(Convert.ToString(r.id));
        Console.WriteLine(Convert.ToString(Registry.doubled));
    }
}
