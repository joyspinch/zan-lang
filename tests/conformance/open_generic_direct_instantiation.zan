using System;

interface IStore {
    int Known();
}

class Store : IStore {
    public int Known() { return 7; }
}

class Repo<T> {
    IStore store;

    public Repo(IStore s) {
        this.store = s;
    }

    public T Find() {
        this.store.Known();
        return this.store.Load<T>();
    }
}

class User {
    public string name;
}

class App {
    static void Main() {
        User u = new Repo<User>(new Store()).Find();
        if (u == null) {
            Console.WriteLine("find returned default (null)");
        } else {
            Console.WriteLine("find returned object");
        }
        Console.WriteLine("done");
    }
}
