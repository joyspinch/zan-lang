using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

// dataset 类目轴背填（ECharts：类目轴未给 data 时类目来自系列
// 数据名——竖轴形态 dataset-encode0 是本引擎的用例）。
class Program {
    static void Main() {
        // dataset-encode0 形态：yAxis:{type:category} 无 data，
        // series.encode x=amount/y=product，数据落在系列 data 名上。
        string src = File.ReadAllText("tests/conformance/data_chart_cat_backfill.json");
        ChartOption o = ChartOption.FromJson(src);
        Console.WriteLine("ycount:" + Convert.ToString(o.yAxes.Count));
        Console.WriteLine("ytype:" + Convert.ToString((int)o.YAxis0().type));
        Console.WriteLine("ycats:" + Convert.ToString(o.YAxis0().categories.Count));
        Console.WriteLine("y0:" + o.YAxis0().categories[0]);
        Console.WriteLine("y8:" + o.YAxis0().categories[o.YAxis0().categories.Count - 1]);
        Console.WriteLine("sval0:" + Convert.ToString(o.series[0].data[0].val));
        Console.WriteLine("sname0:" + o.series[0].data[0].name);
        Console.WriteLine("hbar:" + Convert.ToString(o.series[0].hbar));

        // 横轴形态不回归：xAxis category 无 data 仍按名回填 x 轴。
        string src2 = File.ReadAllText("tests/conformance/data_chart_cat_backfill_x.json");
        ChartOption o2 = ChartOption.FromJson(src2);
        Console.WriteLine("xcats:" + Convert.ToString(o2.XAxis0().categories.Count));
        Console.WriteLine("x0:" + o2.XAxis0().categories[0]);
    }
}
