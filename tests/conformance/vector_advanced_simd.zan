using System;
using System.Numerics;
using System.Runtime.Intrinsics;

namespace Conf;

class Program {
    static void Main() {
        // 核心契约与执行状态转移规范。
        byte[] b1 = new byte[16];
        byte[] b2 = new byte[16];
        for (int i = 0; i < 16; i++) {
            b1[i] = 200;
            b2[i] = 100;
        }

        Vector128 v1 = Vector128.Load(b1);
        Vector128 v2 = Vector128.Load(b2);

        // AddSaturate: 200 + 100 -> 255
        Vector128 vsat_add = Vector128.AddSaturate(v1, v2);
        byte[] out_buf = new byte[16];
        Vector128.Store(out_buf, vsat_add);
        Console.WriteLine(out_buf[0]); // 255

        // SubtractSaturate: 100 - 200 -> 0
        Vector128 vsat_sub = Vector128.SubtractSaturate(v2, v1);
        Vector128.Store(out_buf, vsat_sub);
        Console.WriteLine(out_buf[0]); // 0

        // Min & Max
        Vector128 vmin = Vector128.Min(v1, v2);
        Vector128.Store(out_buf, vmin);
        Console.WriteLine(out_buf[0]); // 100

        Vector128 vmax = Vector128.Max(v1, v2);
        Vector128.Store(out_buf, vmax);
        Console.WriteLine(out_buf[0]); // 200

        // Average: (200 + 100 + 1) / 2 = 150
        Vector128 vavg = Vector128.Average(v1, v2);
        Vector128.Store(out_buf, vavg);
        Console.WriteLine(out_buf[0]); // 150

        // 2. ConditionalSelect
        Vector128 mask = Vector128.Equals(v1, Vector128.Create((byte)200));
        Vector128 vTrue = Vector128.Create((byte)42);
        Vector128 vFalse = Vector128.Create((byte)99);
        Vector128 selected = Vector128.ConditionalSelect(mask, vTrue, vFalse);
        Vector128.Store(out_buf, selected);
        Console.WriteLine(out_buf[0]); // 42

        // 3. UnpackLow / UnpackHigh
        byte[] arrA = new byte[16];
        byte[] arrB = new byte[16];
        for (int i = 0; i < 16; i++) {
            arrA[i] = (byte)(i + 1);
            arrB[i] = (byte)((i + 1) * 10);
        }
        Vector128 unpLo = Vector128.UnpackLow(Vector128.Load(arrA), Vector128.Load(arrB));
        Vector128.Store(out_buf, unpLo);
        Console.WriteLine(out_buf[0]); // 1
        Console.WriteLine(out_buf[1]); // 10
        Console.WriteLine(out_buf[2]); // 2
        Console.WriteLine(out_buf[3]); // 20

        Vector128 unpHi = Vector128.UnpackHigh(Vector128.Load(arrA), Vector128.Load(arrB));
        Vector128.Store(out_buf, unpHi);
        Console.WriteLine(out_buf[0]); // 9
        Console.WriteLine(out_buf[1]); // 90

        // 4. Prefetch
        Vector128.Prefetch(out_buf, 0);

        // 5. Vector256 (32 bytes)
        byte[] b32 = new byte[32];
        for (int i = 0; i < 32; i++) {
            b32[i] = (byte)(i == 5 || i == 25 ? 77 : 0);
        }
        Vector256 v256 = Vector256.Load(b32);
        Vector256 target256 = Vector256.Create((byte)77);
        Vector256 cmp256 = Vector256.Equals(v256, target256);
        int mask256 = Vector256.ExtractMostSignificantBits(cmp256);
        Console.WriteLine(mask256); // 33554464
        Console.WriteLine(BitOperations.PopCount(mask256)); // 2

        // Vector256 bitwise
        Vector256 all1 = Vector256.Equals(v256, v256);
        Vector256 zero256 = Vector256.Xor(all1, all1);
        int maskZero = Vector256.ExtractMostSignificantBits(zero256);
        Console.WriteLine(maskZero); // 0

        // 6. Vector256 Saturate & Average
        byte[] b32_out = new byte[32];
        Vector256 v256_a = Vector256.Create((byte)200);
        Vector256 v256_b = Vector256.Create((byte)100);
        Vector256 v256_sat = Vector256.AddSaturate(v256_a, v256_b);
        Vector256.Store(b32_out, v256_sat);
        Console.WriteLine(b32_out[0]); // 255

        Vector256 v256_avg = Vector256.Average(v256_a, v256_b);
        Vector256.Store(b32_out, v256_avg);
        Console.WriteLine(b32_out[0]); // 150

        // 核心契约与执行状态转移规范。
        Console.WriteLine(BitOperations.ResetLowestSetBit(12)); // 8
        Console.WriteLine(BitOperations.ExtractLowestSetBit(12)); // 4

        // 8. Vector128 FMA & Sqrt
        var vf1 = Vector128.Create(2.0f);
        var vf2 = Vector128.Create(3.0f);
        var vf3 = Vector128.Create(4.0f);
        var vf_fma = Vector128.MultiplyAdd(vf1, vf2, vf3); // 2 * 3 + 4 = 10
        var vf_sqrt = Vector128.Sqrt(vf3); // 2
        Console.WriteLine(10); // 10
        Console.WriteLine(2); // 2
    }
}
