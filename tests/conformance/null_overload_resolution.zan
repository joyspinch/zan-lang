using System;

namespace Conformance;

// 重载里混着值类型与引用类型时，null 字面量只能绑到引用类型那一支。
//
// 踩过的坑：以前 `Of(null)` 会走到 `Of(int)`——checker 与 irgen 各自分解
// 一次重载，规则还不一致，irgen 侧对 null 实参推断不出类型就一律给 0 分，
// 等于所有重载同分，第一个（值类型）就赢了。null 被当成 0 传下去，
// 调用点看不出任何异常，断言却永远对不上。
public class Overloads {
    public static string Of(int v) { return "int:" + v.ToString(); }
    public static string Of(long v) { return "long:" + v.ToString(); }
    public static string Of(double v) { return "double:"; }
    public static string Of(bool v) { return "bool:"; }
    public static string Of(string v) { return "string:" + (v != null ? v : "<null>"); }
}

// 引用类型接得住 null。
public class ObjHolder {
    public static string Take(object v) { return "object:" + (v == null ? "<null>" : "set"); }
}

// 可空类型也接得住 null。
public class NullableHolder {
    public static bool Take(int? v) { return v != null; }
}

public class Main {
    public static void Main() {
        Console.WriteLine(Overloads.Of(null));
        string s = null;
        Console.WriteLine(Overloads.Of(s));
        Console.WriteLine(ObjHolder.Take(null));
        Console.WriteLine(NullableHolder.Take((int?)null));
        Console.WriteLine("NULL OVERLOAD OK");
    }
}
