// String concatenation with embedded NULs: `+` must measure operands
// by their managed length (ARC header), not strlen -- a payload holding
// U+0000 (Encoding.GetString over binary bytes, Utf8FromCodePoint(0))
// keeps every byte through 2-way and n-way concat chains, and its
// Length still reports the full count.
using System;
using System.Text;

namespace Conf;

class Prog {
    static int bad = 0;

    static string Hex(byte[] b) {
        StringBuilder sb = new StringBuilder();
        string hex = "0123456789abcdef";
        int i = 0;
        while (i < b.Length) {
            if (i > 0) { sb.Append(" "); }
            int v = b[i] & 255;
            sb.Append(hex.Substring(v >> 4, 1));
            sb.Append(hex.Substring(v & 15, 1));
            i = i + 1;
        }
        return sb.ToString();
    }

    static void Chk(string label, long got, long want) {
        if (got != want) {
            bad = bad + 1;
            Console.WriteLine("FAIL " + label);
        }
    }

    static void ChkS(string label, string got, string want) {
        if (got != want) {
            bad = bad + 1;
            Console.WriteLine("FAIL " + label);
        }
    }

    static void Main() {
        // 构造含 U+0000 的管理串：GetString 长度显式，内嵌 NUL 保留。
        string nul = Encoding.GetString(new byte[] { 97, 0, 98 }, 0, 3);
        Chk("src-len", nul.Length, 3);
        Chk("src-hex", Hex(Encoding.GetBytes(nul)).Length, 8);

        // 双操作数拼接：NUL 不得截断（strlen 回落会把中段量成 0）。
        string joined = "x" + nul + "y";
        Chk("join-len", joined.Length, 5);
        ChkS("join-hex", Hex(Encoding.GetBytes(joined)), "78 61 00 62 79");

        // Utf8FromCodePoint(0) 同型：U+0000 过 + 号存活。
        string zero = "a" + Encoding.Utf8FromCodePoint(0) + "b";
        Chk("cp-len", zero.Length, 3);
        ChkS("cp-hex", Hex(Encoding.GetBytes(zero)), "61 00 62");

        // n 路（≥3 叶）拼接链同一契约。
        string chain = nul + "c" + nul + "d";
        Chk("chain-len", chain.Length, 8);
        ChkS("chain-hex", Hex(Encoding.GetBytes(chain)),
            "61 00 62 63 61 00 62 64");

        Console.WriteLine("concat-nul: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
