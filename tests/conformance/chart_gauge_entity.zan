using System;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static void Main() {
        ChartSeries direct = ChartSeries.Gauge("rpm", 4);
        direct.gauge.max = 7;
        direct.gauge.center = ChartPosition.Of(ChartScalar.Pct(25), ChartScalar.Pct(55));
        direct.gauge.radius = ChartScalar.Pct(50);
        direct.gauge.detail.formatter = "{value} x1000 r/min";
        Console.WriteLine(Convert.ToString(direct.gauge.max));
        Console.WriteLine(Convert.ToString(direct.gauge.center.x.amount) + ":" + Convert.ToString(direct.gauge.center.x.percent));

        ChartSeries legacy = ChartSeries.Gauge("temperature", 68)
            .GaugeRange(0, 120).GaugeLayout(50, 72, 82)
            .GaugeTicks(6, 4).GaugeText(0, 18, 0, 38, " °C");
        Console.WriteLine(Convert.ToString(legacy.gauge.max) + ":" + Convert.ToString(legacy.gauge.radius.amount));
        Console.WriteLine(Convert.ToString(legacy.gauge.axisTick.splitNumber) + ":" + legacy.gauge.detail.formatter);

        ChartOption parsed = ChartOption.FromJson("{\"series\":[{\"name\":\"rpm\",\"type\":\"gauge\",\"center\":[\"25%\",\"55%\"],\"radius\":\"50%\",\"max\":7,\"axisLine\":{\"lineStyle\":{\"color\":[[0.29,\"lime\"],[1,\"#ff4500\"]],\"width\":2}},\"pointer\":{\"width\":5},\"detail\":{\"offsetCenter\":[25,\"20%\"]},\"data\":[{\"value\":1.5,\"name\":\"x1000 r/min\"}]}]}");
        ChartSeries json = parsed.series[0];
        Console.WriteLine(Convert.ToString(json.gauge.axisLine.colors.Count) + ":" + Convert.ToString(json.gauge.axisLine.colors[0].stop));
        Console.WriteLine(Convert.ToString(json.gauge.pointer.width) + ":" + Convert.ToString(json.gauge.detail.offsetCenter.y.percent));
        Console.WriteLine(Convert.ToString(json.Number(0)) + ":" + json.data[0].name);
    }
}
