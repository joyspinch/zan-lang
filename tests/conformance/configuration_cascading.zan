using System;
using System.Configuration;

namespace Conf;

class Prog {
    static void Main() {
        ConfigurationBuilder builder = new ConfigurationBuilder();

        // 1. 基础默认配置层
        Dictionary<string, string> defaults = new Dictionary<string, string>();
        defaults["App:Name"] = "ZanService";
        defaults["App:Port"] = "8080";
        defaults["Database:Host"] = "${DB_HOST:-127.0.0.1}";
        defaults["Database:Port"] = "5432";
        defaults["Feature:EnableMetrics"] = "true";
        builder.AddInMemory(defaults);

        // 2. 高优先级覆盖层（模拟环境变量或 CLI 覆盖基础端口）
        builder.AddInMemoryValue("App:Port", "9090");

        IConfiguration config = builder.Build();

        Console.WriteLine("app-name: " + config.GetString("App:Name", "unknown"));
        Console.WriteLine("app-port: " + Convert.ToString(config.GetInt("App:Port", 0)));
        Console.WriteLine("db-host: " + config.GetString("Database:Host", ""));
        Console.WriteLine("db-port: " + Convert.ToString(config.GetInt("Database:Port", 0)));
        Console.WriteLine("metrics: " + Convert.ToString(config.GetBool("Feature:EnableMetrics", false) ? 1 : 0));

        // 3. Section 子配置小节分层导航
        IConfigurationSection dbSection = config.GetSection("Database");
        Console.WriteLine("section-key: " + dbSection.GetKey());
        Console.WriteLine("section-path: " + dbSection.GetPath());
        Console.WriteLine("section-db-host: " + dbSection.GetString("Host", ""));
        Console.WriteLine("section-db-port: " + Convert.ToString(dbSection.GetInt("Port", 0)));

        // 4. 动态热重载通知闭环
        bool reloadFired = false;
        config.OnReload(() => {
            reloadFired = true;
        });
        config.Reload();
        Console.WriteLine("reload-fired: " + Convert.ToString(reloadFired ? 1 : 0));

        Console.WriteLine("p9-all-passed: 1");
    }
}
