using System;
using System.Json;
using System.Web;

/// DesignerHtml .html 设计稿 ↔ JSON 文档模型往返契约。
///
/// 锁三件事（2026-10 修复的两个往返缺陷的回归锚）：
/// 1. 属性固定序：FieldHtml 的发射序不随模型键序走——异序文档
///    （手写/旧版生成）读存一代即收敛，不再每代换属性位置
///    （coreforge 进度条 value/max/style 震荡案例）；
/// 2. 文本保真：多行/制表/首尾空白文本走 data-text 实体通道
///    逐字节往返；元素正文通道只发安全文本，且读端 data-text
///    优先——修掉"读存一次多行塌单行 + JSON 里出现重复 text 键"；
/// 3. 语义保真：progress 的 value/max ↔ percent 折算、props
///    直通表的字符串值（"0" 不嗅探成数字）读回一致。
class DesignerHtmlRoundTrip {
    static string Y(bool b) { return b ? "yes" : "NO"; }

    static void Main() {
        // ---- 1. 异序文档固定点：value/max 在 style 之前的属性序 ----
        string html = "<!doctype html>\n<html>\n<head>\n"
            + "<meta charset=\"utf-8\">\n<title>Demo</title>\n</head>\n"
            + "<body data-zan-design id=\"Demo\">\n"
            + "  <progress id=\"bar\" data-kind=\"Progress\""
            + " class=\"wide\" data-fh=\"10\""
            + " value=\"30\" max=\"100\" style=\"width:120px\"></progress>\n"
            + "</body>\n</html>\n";
        string g1 = DesignerHtml.FromJsonDoc(DesignerHtml.ToJsonDoc(html));
        string g2 = DesignerHtml.FromJsonDoc(DesignerHtml.ToJsonDoc(g1));
        Console.WriteLine("fixedpoint " + Y(g1 == g2));
        // 固定序：class、style 在前，value/max 折算随后，extra（fh）垫底
        Console.WriteLine("canonical "
            + Y(g1.Contains("style=\"width:120px\" value=\"30\" max=\"100\"")));

        // ---- 2. 多行/制表文本逐字节往返 + 无重复键 ----
        JsonValue doc = JsonValue.NewObject();
        JsonValue fields = JsonValue.NewArray();
        JsonValue l = JsonValue.NewObject();
        l.Put("kind", JsonValue.NewStr("Label"));
        l.Put("name", JsonValue.NewStr("l1"));
        l.Put("text", JsonValue.NewStr("line1\nline2\tend"));
        fields.Append(l);
        doc.Put("name", JsonValue.NewStr("T"));
        doc.Put("fields", fields);
        string j1 = doc.PrettyToJson() + "\n";
        string h = DesignerHtml.FromJsonDoc(j1);
        string j2 = DesignerHtml.ToJsonDoc(h);
        Console.WriteLine("textexact " + Y(j1 == j2));
        // 不安全文本只走 data-text 属性通道，元素正文保持空
        Console.WriteLine("bodyempty " + Y(h.Contains("></label>")));

        // ---- 3. percent 折回 + props 字符串不嗅探 ----
        JsonValue doc2 = JsonValue.NewObject();
        JsonValue fields2 = JsonValue.NewArray();
        JsonValue pg = JsonValue.NewObject();
        pg.Put("kind", JsonValue.NewStr("Progress"));
        pg.Put("name", JsonValue.NewStr("pg1"));
        pg.Put("percent", JsonValue.NewNum("72"));
        fields2.Append(pg);
        JsonValue p = JsonValue.NewObject();
        p.Put("kind", JsonValue.NewStr("Panel"));
        p.Put("name", JsonValue.NewStr("p1"));
        JsonValue props = JsonValue.NewObject();
        props.Put("min", JsonValue.NewStr("0"));
        p.Put("props", props);
        fields2.Append(p);
        doc2.Put("name", JsonValue.NewStr("T2"));
        doc2.Put("fields", fields2);
        string j3 = DesignerHtml.ToJsonDoc(DesignerHtml.FromJsonDoc(
            doc2.PrettyToJson() + "\n"));
        Console.WriteLine("percentround " + Y(j3.Contains("\"percent\": 72")));
        Console.WriteLine("propstr " + Y(j3.Contains("\"min\": \"0\"")));
    }
}
