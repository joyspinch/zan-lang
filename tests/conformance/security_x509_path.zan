    static string Pem(string b64) {
        string out1 = "-----BEGIN CERTIFICATE-----\n";
        int pos = 0;
        while (pos < b64.Length) {
            int take = 64;
            if (pos + take > b64.Length) { take = b64.Length - pos; }
            out1 = out1 + b64.Substring(pos, take) + "\n";
            pos = pos + take;
        }
        return out1 + "-----END CERTIFICATE-----\n";
    }

    static bool ListHas(List<string> l, string v) {
        if (l == null) { return false; }
        for (int i = 0; i < l.Count; i = i + 1) { if (l[i] == v) { return true; } }
        return false;
    }

    static void TestParsePathLen() {
        X509Certificate rootA = X509Certificate.FromPem(Pem(ROOTA_B64));
        Check(rootA != null, "rootA parses");
        Check(rootA != null && rootA.HasPathLen() && rootA.PathLenConstraint() == 2, "rootA pathlen 2");
        X509Certificate rootB = X509Certificate.FromPem(Pem(ROOTB_B64));
        Check(rootB != null && rootB.HasPathLen() && rootB.PathLenConstraint() == 0, "rootB pathlen 0");
        X509Certificate rootC = X509Certificate.FromPem(Pem(ROOTC_B64));
        Check(rootC != null && rootC.HasPathLen() && rootC.PathLenConstraint() == 1, "rootC pathlen 1");
        X509Certificate rootD = X509Certificate.FromPem(Pem(ROOTD_B64));
        Check(rootD != null && rootD.HasPathLen() && rootD.PathLenConstraint() == 0, "rootD pathlen 0");
        X509Certificate i1 = X509Certificate.FromPem(Pem(I1_B64));
        Check(i1 != null && i1.HasPathLen() && i1.PathLenConstraint() == 1, "i1 pathlen 1");
        X509Certificate i0 = X509Certificate.FromPem(Pem(I0_B64));
        Check(i0 != null && i0.HasPathLen() && i0.PathLenConstraint() == 0, "i0 pathlen 0");
        X509Certificate i1x = X509Certificate.FromPem(Pem(I1X_B64));
        Check(i1x != null && i1x.HasPathLen() && i1x.PathLenConstraint() == 0, "i1x pathlen 0");
        X509Certificate i2c = X509Certificate.FromPem(Pem(I2C_B64));
        Check(i2c != null && !i2c.HasPathLen(), "i2c has no pathlen");
        X509Certificate leaf6 = X509Certificate.FromPem(Pem(LEAF6_B64));
        Check(leaf6 != null && !leaf6.HasPathLen(), "leaf has no pathlen");
        Check(i1 != null && i1.CanSignCertificates() && leaf6 != null && leaf6.CanServeTls(), "key usage gates hold");
    }

    static void TestSanStorage() {
        X509Certificate leaf6 = X509Certificate.FromPem(Pem(LEAF6_B64));
        if (leaf6 == null) { Check(false, "leaf6 parses for san"); return; }
        Check(ListHas(leaf6.IpAddresses(), "::1"), "san ::1 stored canonical");
        Check(ListHas(leaf6.IpAddresses(), "2001:db8::1"), "san 2001:db8::1 stored canonical");
        Check(ListHas(leaf6.IpAddresses(), "127.0.0.1"), "san 127.0.0.1 stored");
        Check(ListHas(leaf6.DnsNames(), "loop6.example"), "san dns stored");
        Check(leaf6.IpAddresses().Count == 3, "exactly three ip sans");
    }

    static void TestVerifyHost() {
        X509Certificate leaf6 = X509Certificate.FromPem(Pem(LEAF6_B64));
        if (leaf6 == null) { Check(false, "leaf6 parses for host"); return; }
        Check(leaf6.VerifyHost("::1"), "host ::1 matches");
        Check(leaf6.VerifyHost("0:0:0:0:0:0:0:1"), "host long-form ::1 matches");
        Check(leaf6.VerifyHost("[::1]"), "host [::1] matches");
        Check(leaf6.VerifyHost("2001:db8::1"), "host 2001:db8::1 matches");
        Check(leaf6.VerifyHost("2001:0db8:0000::1"), "host padded v6 matches");
        Check(leaf6.VerifyHost("2001:DB8::1"), "host uppercase v6 matches");
        Check(leaf6.VerifyHost("127.0.0.1"), "host v4 matches");
        Check(!leaf6.VerifyHost("::2"), "wrong v6 refused");
        Check(!leaf6.VerifyHost("::ffff:127.0.0.1"), "v6 form refuses v4-only san");
        Check(!leaf6.VerifyHost("::1%1"), "zone host refused");
        Check(!leaf6.VerifyHost("1::2::3"), "double compression refused");
        Check(!leaf6.VerifyHost("1.2.3"), "3-octet host refused");
        Check(!leaf6.VerifyHost("256.1.1.1"), "octet overflow refused");
        Check(!leaf6.VerifyHost("999.1.1.1"), "octet 999 refused");
        Check(!leaf6.VerifyHost("1.2.3.4.5"), "5-octet host refused");
        Check(!leaf6.VerifyHost("01.2.3.4"), "leading-zero v4 refused");
        Check(!leaf6.VerifyHost("8.8.8.8"), "unmatched ip does not fall back to dns or cn");
        Check(!leaf6.VerifyHost("[::1"), "unclosed bracket refused");
        Check(!leaf6.VerifyHost("2001:db8::1:1:1:1:1:1:1"), "overlong compressed v6 refused");
        Check(!leaf6.VerifyHost("1:2:3:4:5:6:7:8:9"), "nine-group v6 refused");
        Check(leaf6.VerifyHost("loop6.example"), "dns host still matches");
    }

    static async void PathServerLoop(TlsContext tls, int port, int conns) {
        TcpListener l = new TcpListener("127.0.0.1", port);
        l.Start();
        for (int n = 0; n < conns; n = n + 1) {
            nint sock = await l.AcceptAsync();
            if (sock < 0) { break; }
            await HandlePathConn(tls, sock);
            Socket.Close(sock);
        }
        l.Stop();
    }

    static async void HandlePathConn(TlsContext tls, nint sock) {
        TlsStream s = await TlsStream.AcceptAsync(tls, sock, 10000);
        if (s == null) {
            return;
        }
        string got = await s.RecvAsync(256);
        int _w = await s.SendStringAsync("pong:" + got);
        s.Close();
    }

    static bool exOk;
    static int exChain;
    static string exReply;

    static async void PathExchange(TlsContext ctx, int port, string host, string ping) {
        Program.exOk = false;
        Program.exChain = 0;
        Program.exReply = "";
        nint sock = Socket.CreateTcp();
        Socket.SetNonBlocking(sock);
        int rc = await Socket.ConnectAsync(sock, "127.0.0.1", port, 5000);
        if (rc != 0) {
            Socket.Close(sock);
            return;
        }
        TlsStream s = await TlsStream.ConnectAsync(ctx, sock, host, 10000);
        if (s == null) {
            Socket.Close(sock);
            return;
        }
        Program.exOk = true;
        Program.exChain = s.engine.peerChain.Count;
        int _s = await s.SendStringAsync(ping);
        Program.exReply = await s.RecvAsync(256);
        s.Close();
        Socket.Close(sock);
    }

    static async int Run() {
        TestParsePathLen();
        TestSanStorage();
        TestVerifyHost();

        Directory.CreateDirectory("_scratch");
        File.WriteAllText("_scratch/x509p_leaf6.key", LEAF_KEY);
        File.WriteAllText("_scratch/x509p_rootA.pem", Pem(ROOTA_B64));
        File.WriteAllText("_scratch/x509p_rootB.pem", Pem(ROOTB_B64));
        File.WriteAllText("_scratch/x509p_rootC.pem", Pem(ROOTC_B64));
        File.WriteAllText("_scratch/x509p_rootD.pem", Pem(ROOTD_B64));
        File.WriteAllText("_scratch/x509p_i1.pem", Pem(I1_B64));
        File.WriteAllText("_scratch/x509p_srv1.pem", Pem(LEAF6_B64) + Pem(I1_B64));
        File.WriteAllText("_scratch/x509p_srv6.pem", Pem(LEAF6_B64) + Pem(ROOTA_B64) + Pem(I1_B64));
        File.WriteAllText("_scratch/x509p_srv2.pem", Pem(LEAF6I0_B64) + Pem(I0_B64));
        File.WriteAllText("_scratch/x509p_srv3.pem", Pem(LEAF6X_B64) + Pem(I1X_B64) + Pem(I0_B64));
        File.WriteAllText("_scratch/x509p_srv4.pem", Pem(LEAF6C_B64) + Pem(I2C_B64));
        File.WriteAllText("_scratch/x509p_srv5.pem", Pem(LEAF6D_B64));

        TlsContext s1 = TlsContext.CreateServer("_scratch/x509p_srv1.pem", "_scratch/x509p_leaf6.key");
        TlsContext s6 = TlsContext.CreateServer("_scratch/x509p_srv6.pem", "_scratch/x509p_leaf6.key");
        TlsContext s2 = TlsContext.CreateServer("_scratch/x509p_srv2.pem", "_scratch/x509p_leaf6.key");
        TlsContext s3 = TlsContext.CreateServer("_scratch/x509p_srv3.pem", "_scratch/x509p_leaf6.key");
        TlsContext s4 = TlsContext.CreateServer("_scratch/x509p_srv4.pem", "_scratch/x509p_leaf6.key");
        TlsContext s5 = TlsContext.CreateServer("_scratch/x509p_srv5.pem", "_scratch/x509p_leaf6.key");
        Check(s1 != null && s6 != null && s2 != null && s3 != null && s4 != null && s5 != null,
            "all server bundles parsed");
        if (s1 == null || s6 == null || s2 == null || s3 == null || s4 == null || s5 == null) {
            Console.WriteLine("failures=" + Convert.ToString(failures));
            return 0;
        }
        Task.Spawn(PathServerLoop(s1, 9602, 8));
        Task.Spawn(PathServerLoop(s6, 9603, 1));
        Task.Spawn(PathServerLoop(s2, 9604, 1));
        Task.Spawn(PathServerLoop(s3, 9605, 1));
        Task.Spawn(PathServerLoop(s4, 9606, 2));
        Task.Spawn(PathServerLoop(s5, 9607, 1));
        await Task.Delay(150);

        TlsContext cRootA = TlsContext.CreateClient();
        Check(cRootA.AddTrustedCert("_scratch/x509p_rootA.pem"), "rootA anchor loaded");
        TlsContext cRootB = TlsContext.CreateClient();
        Check(cRootB.AddTrustedCert("_scratch/x509p_rootB.pem"), "rootB anchor loaded");
        TlsContext cRootC = TlsContext.CreateClient();
        Check(cRootC.AddTrustedCert("_scratch/x509p_rootC.pem"), "rootC anchor loaded");
        TlsContext cRootD = TlsContext.CreateClient();
        Check(cRootD.AddTrustedCert("_scratch/x509p_rootD.pem"), "rootD anchor loaded");
        TlsContext cInter = TlsContext.CreateClient();
        Check(cInter.AddTrustedCert("_scratch/x509p_i1.pem"), "intermediate anchor loaded");
        TlsContext cNone = TlsContext.CreateClient();

        await PathExchange(cRootA, 9602, "loop6.example", "p1");
        Check(Program.exOk, "tls13 path connect with root anchor");
        Check(Program.exChain == 2, "server sent leaf plus intermediate");
        await PathExchange(cInter, 9602, "loop6.example", "p2");
        Check(Program.exOk, "explicit intermediate anchor accepted");
        await PathExchange(cRootC, 9602, "loop6.example", "p3");
        Check(!Program.exOk, "unrelated root refused");
        await PathExchange(cRootB, 9602, "loop6.example", "p4");
        Check(!Program.exOk, "pathlen-0 unrelated root refused");
        await PathExchange(cNone, 9602, "loop6.example", "p5");
        Check(!Program.exOk, "no anchor refused");
        await PathExchange(cRootA, 9602, "[::1]", "p6");
        Check(Program.exOk, "bracketed ipv6 host accepted over tls");
        await PathExchange(cRootA, 9602, "0:0:0:0:0:0:0:1", "p7");
        Check(Program.exOk, "long-form ipv6 host accepted over tls");
        await PathExchange(cRootA, 9602, "other.example", "p8");
        Check(!Program.exOk, "wrong host refused over tls");

        await PathExchange(cRootA, 9603, "loop6.example", "p9");
        Check(Program.exOk, "out-of-order chain accepted");
        Check(Program.exChain == 3, "out-of-order chain length 3");

        await PathExchange(cRootA, 9604, "loop6.example", "p10");
        Check(Program.exOk, "pathlen-0 intermediate may issue leaf");

        await PathExchange(cRootA, 9605, "loop6.example", "p11");
        Check(!Program.exOk, "deep pathlen-0 violation refused");

        await PathExchange(cRootC, 9606, "loop6.example", "p12");
        Check(Program.exOk, "pathlen-1 anchor with one intermediate accepted");
        await PathExchange(cRootD, 9606, "loop6.example", "p13");
        Check(!Program.exOk, "pathlen-0 anchor with intermediate refused");

        await PathExchange(cRootD, 9607, "loop6.example", "p14");
        Check(Program.exOk, "pathlen-0 anchor with direct leaf accepted");
        Check(Program.exReply == "pong:p14", "tls13 app data roundtrip");

        Socket.Cleanup();
        Console.WriteLine("failures=" + Convert.ToString(failures));
        return 0;
    }

    static void Main() {
        int r = await Run();
    }
}
