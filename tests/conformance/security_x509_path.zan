using System;
using System.IO;
using System.Net.Sockets;
using System.Net.Tls;
using System.Security.Cryptography;

class Program {
    static int failures = 0;

    static void Check(bool ok, string name) {
        if (ok) { Console.WriteLine("ok " + name); }
        else { Console.WriteLine("FAIL " + name); failures = failures + 1; }
    }

    static string ROOTA_B64 = "";
    static string ROOTB_B64 = "";
    static string ROOTC_B64 = "";
    static string ROOTD_B64 = "";
    static string I1_B64 = "";
    static string I0_B64 = "";
    static string I1X_B64 = "";
    static string I2C_B64 = "";
    static string LEAF6_B64 = "";
    static string LEAF6I0_B64 = "";
    static string LEAF6X_B64 = "";
    static string LEAF6C_B64 = "";
    static string LEAF6D_B64 = "";
    static string LEAF_KEY = "-----BEGIN PRIVATE KEY-----\n"
