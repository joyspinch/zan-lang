using System;

// checked 上下文里的浮点→整型转换必须与整型窄化强转同口径：
// 目标位宽域外抛 OverflowException，而不是静默落到饱和值。
class Program {
    static void T(string name, Action a) {
        try {
            a();
            Console.WriteLine(name + ": no throw");
        } catch (OverflowException) {
            Console.WriteLine(name + ": OverflowException");
        }
    }

    static void Main() {
        T("checked-int", () => { int x = checked((int)3000000000.0); Console.WriteLine(x); });
        T("checked-short", () => { short x = checked((short)40000.0); Console.WriteLine(x); });
        T("checked-sbyte", () => { sbyte x = checked((sbyte)200.0); Console.WriteLine(x); });
        T("in-range", () => { int x = checked((int)1234.0); Console.WriteLine(x); });
        // unchecked 保持饱和（不是回绕）
        int u = unchecked((int)3000000000.0);
        Console.WriteLine("unchecked=" + Convert.ToString(u));
    }
}