using System;
using System.Text;

namespace Conf;

class Prog {
    static int bad;

    static void Require(bool condition, string label) {
        if (!condition) { bad = bad + 1; Console.WriteLine("FAIL " + label); }
    }

    static byte[] Bytes(int a, int b, int c, int d) {
        byte[] bytes = new byte[4];
        bytes[0] = (byte)a; bytes[1] = (byte)b; bytes[2] = (byte)c; bytes[3] = (byte)d;
        return bytes;
    }

    static void Reject(byte[] bytes, int n, string label) {
        int[] scalar = new int[1];
        string source = bytes.ToStr(0, n);
        Require(Encoding.DecodeCodePoint(source, 0, scalar) == 1 && scalar[0] == 65533, label + " decode");
        StringBuilder expected = new StringBuilder();
        for (int i = 0; i < n; i = i + 1) { expected.Append(Encoding.Utf8FromCodePoint(65533)); }
        Require(Encoding.GetString(bytes, 0, n) == expected.ToString(), label + " GetString");
    }

    static void Main() {
        Reject(Bytes(237, 160, 128, 0), 3, "high surrogate");
        Reject(Bytes(237, 191, 191, 0), 3, "low surrogate");
        Reject(Bytes(244, 144, 128, 128), 4, "above Unicode range");
        Reject(Bytes(244, 191, 191, 191), 4, "maximum invalid four-byte scalar");
        Reject(Bytes(192, 128, 0, 0), 2, "overlong two-byte");
        Reject(Bytes(224, 128, 128, 0), 3, "overlong three-byte");
        Reject(Bytes(240, 128, 128, 128), 4, "overlong four-byte");
        Reject(Bytes(240, 144, 128, 0), 3, "truncated four-byte");
        int[] scalar = new int[1];
        byte[] maximum = Bytes(244, 143, 191, 191);
        string last = maximum.ToStr(0, 4);
        Require(Encoding.DecodeCodePoint(last, 0, scalar) == 4 && scalar[0] == 1114111
            && Encoding.GetString(maximum, 0, 4) == last, "maximum valid scalar");
        string supplementary = "𠀀😀";
        Require(Encoding.DecodeCodePoint(supplementary, 0, scalar) == 4 && scalar[0] == 131072,
            "supplementary CJK");
        Require(Encoding.DecodeCodePoint(supplementary, 4, scalar) == 4 && scalar[0] == 128512,
            "emoji scalar");
        Require(Encoding.DecodeCodePoint(supplementary, supplementary.Length, scalar) == 0 && scalar[0] == 128512,
            "out of bounds preserves output");
        string replacement = Encoding.Utf8FromCodePoint(65533);
        byte[] malformed = Bytes(226, 40, 161, 0);
        Require(Encoding.GetString(malformed, 0, 3) == replacement + "(" + replacement,
            "invalid continuation preserves ASCII");
        Console.WriteLine("encoding-utf8-scalar-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
