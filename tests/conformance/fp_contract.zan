using System;

// `a*b + c` / `a*b - c` / `c - a*b` inside one expression may be fused into a
// single FMA under --fp-contract (and never by default). Results are printed
// rounded, so both builds must agree; registered twice (default and flag).
class Program {
    static void Main() {
        int inside = 0;
        for (int y = 0; y < 200; y++) {
            double ci = 2.0 * y / 200 - 1.0;
            for (int x = 0; x < 200; x++) {
                double cr = 2.0 * x / 200 - 1.5;
                double zr = 0.0; double zi = 0.0; int i = 0;
                while (i < 50 && zr * zr + zi * zi <= 4.0) {
                    double t = zr * zr - zi * zi + cr;
                    zi = 2.0 * zr * zi + ci;
                    zr = t;
                    i++;
                }
                if (i == 50) inside++;
            }
        }
        Console.WriteLine(inside);
        double acc = 0.0;
        for (int k = 1; k <= 1000; k++) { acc = acc + k * 0.5 - 0.25 * k; acc = 1000.0 - 0.001 * acc; }
        Console.WriteLine((long)(acc * 1000.0 + 0.5));
        float f = 1.5f * 2.0f + 0.25f;
        Console.WriteLine((int)(f * 100.0f));
    }
}
