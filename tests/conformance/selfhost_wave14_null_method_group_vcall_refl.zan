// B-ID186 Wave 14: dual-compiler regression pinning null-receiver guards across
// selected method groups (plain & virtual), concrete virtual dispatch, and
// reflection instance calls (InvokeInt / GetFieldInt / SetFieldInt).
using System;

delegate int UnaryOp(int x);

class VBase {
    public virtual int Calc(int x) { return x + 10; }
}

class VLeaf : VBase {
    public int value = 42;
    public override int Calc(int x) { return x + 20; }
    public int Plain(int x) { return x + 5; }
    public int Add(int a, int b) { return a + b; }
}

class Program {
    static void Main() {
        VLeaf live = new VLeaf();
        Console.WriteLine("live.Calc=" + live.Calc(3));
        Console.WriteLine("live.InvokeInt=" + live.InvokeInt("Add", 3, 4));
        Console.WriteLine("live.GetFieldInt=" + live.GetFieldInt("value"));

        VLeaf nil = null;
        try {
            UnaryOp f = nil.Plain;
            Console.WriteLine("FAIL Plain=" + f(1));
        } catch (Exception ex) {
            Console.WriteLine("caught Plain: " + ex.Message);
        }
        try {
            UnaryOp fv = nil.Calc;
            Console.WriteLine("FAIL CalcMG=" + fv(1));
        } catch (Exception ex) {
            Console.WriteLine("caught CalcMG: " + ex.Message);
        }
        try {
            int r = nil.Calc(1);
            Console.WriteLine("FAIL VCall=" + r);
        } catch (Exception ex) {
            Console.WriteLine("caught VCall: " + ex.Message);
        }
        try {
            int ri = nil.InvokeInt("Add", 1, 2);
            Console.WriteLine("FAIL ReflInvoke=" + ri);
        } catch (Exception ex) {
            Console.WriteLine("caught ReflInvoke: " + ex.Message);
        }
        try {
            int rf = nil.GetFieldInt("value");
            Console.WriteLine("FAIL ReflGet=" + rf);
        } catch (Exception ex) {
            Console.WriteLine("caught ReflGet: " + ex.Message);
        }

        UnaryOp softPlain = nil.Plain;
        Console.WriteLine("soft Plain=" + softPlain(3));
        UnaryOp softVirt = nil.Calc;
        Console.WriteLine("soft CalcMG=" + softVirt(3));
        Console.WriteLine("soft VCall=" + nil.Calc(3));
        Console.WriteLine("soft ReflInvoke=" + nil.InvokeInt("Add", 3, 4));
        Console.WriteLine("soft ReflGet=" + nil.GetFieldInt("value"));
        Console.WriteLine("soft ReflSet=" + nil.SetFieldInt("value", 9));
    }
}
