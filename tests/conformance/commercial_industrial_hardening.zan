using System;
using System.Collections.Generic;
using System.Commercial;
using Gui;
using Gui.Hmi;

class Program {
    static void Main() {
        Console.WriteLine("=== Commercial & Industrial Hardening Test ===");

        // 1. Zan.Commercial: LicenseState & LicenseClient
        LicenseClient client = new LicenseClient();
        client.Server("http://127.0.0.1:8080", "ZanVendor");
        client.Product("ZanProStudio");
        string fp = client.DeviceFp();
        Console.WriteLine("DeviceFp len: " + Convert.ToString(fp.Length));

        LicenseState state = new LicenseState();
        state.mode = "signed";
        state.product = "ZanProStudio";
        state.subject = "EnterpriseUser";
        state.deviceFp = fp;
        state.sessionToken = "sess_123456";
        state.expiresAt = 1893456000;
        state.graceSeconds = 86400;
        state.lastHeartbeat = 1700000000;
        state.salt = "testsalt01020304";

        string canon = LicenseClient.StateCanonical(state);
        bool hasPrefix = canon.IndexOf("zan-lic-v1|") == 0;
        Console.WriteLine("Canonical prefix ok: " + Convert.ToString(hasPrefix));

        string mac = client.StateAuth(state);
        Console.WriteLine("StateAuth mac len: " + Convert.ToString(mac.Length));

        LicenseCheckResult failRes = LicenseCheckResult.Fail("no_license", "Activation needed");
        Console.WriteLine("Fail result: ok=" + Convert.ToString(failRes.ok) + " reason=" + failRes.reason);

        // 2. Zan.Industrial: TagTable & IoTag
        TagTable io = new TagTable();
        IoTag t1 = io.Add("PT101", "bar", 10);
        t1.Range(0, 1000); // 0.0 .. 100.0 bar
        t1.Limits(200, 800); // 20.0 .. 80.0 bar
        t1.SetRaw(850); // 85.0 bar -> Alarm=2 (high)

        Console.WriteLine("Tag: " + t1.Name() + " Val=" + t1.TextWithUnit() + " Alarm=" + Convert.ToString(t1.Alarm()) + " Pct=" + Convert.ToString(t1.Percent()));

        IoTag t2 = io.Ensure("TT102");
        t2.Range(0, 200);
        t2.Limits(50, 150);
        t2.SetRaw(20); // Low alarm -> Alarm=1
        Console.WriteLine("Tag2: " + t2.Name() + " Alarm=" + Convert.ToString(t2.Alarm()));

        Console.WriteLine("Total alarm tags in IO: " + Convert.ToString(io.AlarmCount()));

        // 3. Zan.Industrial: AlarmBuffer
        AlarmBuffer ab = new AlarmBuffer();
        ab.Scan(io);
        Console.WriteLine("Alarm count after scan: " + Convert.ToString(ab.Count()));
        Console.WriteLine("Unacked count: " + Convert.ToString(ab.UnackedCount()));
        if (ab.Count() > 0) {
            AlarmItem first = ab.At(0);
            Console.WriteLine("Alarm0: point=" + first.Point() + " msg=" + first.Message() + " prio=" + Convert.ToString(first.Priority()));
        }
        ab.AckAll();
        Console.WriteLine("Unacked after AckAll: " + Convert.ToString(ab.UnackedCount()));

        // 4. Zan.Industrial: DeviceCard & DeviceCardRow
        DeviceCard card = new DeviceCard("FeedPump-01");
        card.Row("Discharge Pressure", t1);
        card.Row("Bearing Temp", t2);
        card.Set(1); // 1 = 运行
        Console.WriteLine("DeviceCard: title=" + card.title + " rows=" + Convert.ToString(card.RowCount()) + " state=" + DeviceCard.TextOf(card.state.Get()));

        // 5. Zan.Industrial: Trend & TrendPen
        Trend trend = new Trend("Pressure Trend", 0, 1000, 10, 60);
        TrendPen pen1 = trend.Add("PT101 Pen", t1, 0x00FF00);
        trend.Sample();
        Console.WriteLine("Trend: penCount=" + Convert.ToString(trend.PenCount()) + " pen1Count=" + Convert.ToString(pen1.Count()));

        // 6. Zan.Industrial: NumPad parsing
        int parsed = NumPad.Parse("123.45", 100);
        Console.WriteLine("NumPad parse 123.45 @ scale 100: " + Convert.ToString(parsed));
        int parsedNeg = NumPad.Parse("-50.2", 10);
        Console.WriteLine("NumPad parse -50.2 @ scale 10: " + Convert.ToString(parsedNeg));

        // 7. Zan.Industrial: Bargraph & Digital & Gauge & Led
        Bargraph bg = new Bargraph("Level", t1);
        Console.WriteLine("Bargraph kind: " + bg.Kind());

        Digital dig = new Digital("Pressure Dig", t1);
        Console.WriteLine("Digital kind: " + dig.Kind());

        Gauge gauge = new Gauge("Pressure Gauge", t1);
        Console.WriteLine("Gauge kind: " + gauge.Kind());

        Led led = new Led("Run Led");
        led.Set(1);
        Console.WriteLine("Led kind: " + led.Kind() + " state=" + Convert.ToString(led.State()));

        Console.WriteLine("=== All Commercial & Industrial Tests Passed ===");
    }
}
