using System;
using System.IO;

class Program {
    static void Main() {
        string p = "filelock_case.tmp";

        long a = File.TryLock(p);
        Console.WriteLine("locked=" + (a != 0));
        // 锁属于那个打开的句柄，同一路径再抢就抢不到（换个进程同理）。
        Console.WriteLine("again=" + File.TryLock(p));
        Console.WriteLine("released=" + File.Unlock(a));
        // 释放后槽位可复用。
        long b = File.TryLock(p);
        Console.WriteLine("relocked=" + (b != 0));
        Console.WriteLine("released2=" + File.Unlock(b));
        Console.WriteLine("double_release=" + File.Unlock(b));
        Console.WriteLine("bogus=" + File.Unlock(0));

        File.Delete(p);
    }
}
