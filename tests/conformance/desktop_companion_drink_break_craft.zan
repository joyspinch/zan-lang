using System;
using System.Windows;

namespace Conf;

class DesktopCompanionDrinkBreakCraftTest {
    static void Main() {
        // 1. 桌面健康饮水追踪器：超时触发提醒、勿扰抑制、饮水重置计时与每日达标连击
        CompanionHydrationTracker hydro = new CompanionHydrationTracker(1000, 45);
        bool remind45 = hydro.AdvanceMinutes(45);
        hydro.QuietMode = true;
        bool quietSuppressed = !hydro.AdvanceMinutes(30);
        hydro.QuietMode = false;
        hydro.LogDrink(500);
        bool halfWay = hydro.ProgressRatio() > 0.49 && hydro.ProgressRatio() < 0.51;
        hydro.LogDrink(600); // 1100 >= 1000 达标
        bool noRemindWhenMet = !hydro.AdvanceMinutes(60);
        hydro.EndOfDayReset();

        bool hydroOk = remind45 && quietSuppressed && halfWay && noRemindWhenMet
            && hydro.GoalMetStreakDays == 1 && hydro.ConsumedTodayMl == 0;
        Console.WriteLine("companion-hydration-tracker: " + Convert.ToString(hydroOk ? 1 : 0));

        // 2. 20-20-20 护眼计时器：AFK 空闲暂停累计、到期允许有限次 Snooze、完成休息计数累加
        CompanionEyeRest202020 eye = new CompanionEyeRest202020(1200, 20, 1);
        eye.Tick(600, false); // AFK -> ElapsedWorkSec 仍为 0
        bool afkPaused = eye.ElapsedWorkSec == 0;
        EyeRestPhase due = eye.Tick(1200, true);
        bool snooze1 = eye.Snooze(300); // 剩余 300s 再次到期
        eye.Tick(300, true);
        bool snooze2Blocked = !eye.Snooze(300); // 超过 MaxSnoozes=1 拒绝
        bool started = eye.StartBreak();
        EyeRestPhase backToWork = eye.Tick(20, true);

        bool eyeOk = afkPaused && due == EyeRestPhase.BreakDue && snooze1 && snooze2Blocked
            && started && backToWork == EyeRestPhase.Working && eye.CompletedBreaksToday == 1;
        Console.WriteLine("companion-eye-rest-202020: " + Convert.ToString(eyeOk ? 1 : 0));

        // 3. 桌面放置泡茶/手作工作台：扣减原料、定时产出、成品领取入库
        CompanionIdleCraftBench bench = new CompanionIdleCraftBench();
        bench.RegisterRecipe("brew_matcha", "tea_leaf", 2, "matcha_cup", 120);
        bench.AddStock("tea_leaf", 3);

        bool craftStarted = bench.StartCraft("brew_matcha"); // 剩余 tea_leaf = 1
        bool busyBlocked = !bench.StartCraft("brew_matcha");
        bench.AdvanceSec(60);
        bool notDoneYet = !bench.ReadyToCollect && bench.RemainingSec == 60;
        bench.AdvanceSec(60);
        string item = bench.Collect();

        bool craftOk = craftStarted && busyBlocked && notDoneYet
            && item == "matcha_cup" && bench.GetStock("tea_leaf") == 1 && bench.GetStock("matcha_cup") == 1;
        Console.WriteLine("companion-idle-craft-bench: " + Convert.ToString(craftOk ? 1 : 0));
    }
}
