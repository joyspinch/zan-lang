// Conformance: socket failures must be reported, not swallowed (S7).
// 1. A non-blocking connect to a closed port makes the socket writable just
//    like a successful connect -- only SO_ERROR distinguishes them. The old
//    AsyncSocket.Connect returned 0 unconditionally, so refused/unreachable
//    connects looked like success. It must now surface the error.
// 2. TcpListener.Start() must check bind/listen and throw SocketException
//    (e.g. port already taken) instead of setting running=true on a dead
//    listener.
using System;
using System.Net.Sockets;

class Program {
    static int FAIL_PORT = 9522;   // nothing listens here
    static int OCCUPIED_PORT = 9523;

    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            failures = failures + 1;
        }
    }

    static async int Run() {
        Socket.Initialize();

        // 1. Connect to a port nothing is listening on: must fail.
        nint sock = Socket.CreateTcp();
        Socket.SetNonBlocking(sock);
        int rc = await AsyncSocket.Connect(sock, "127.0.0.1", FAIL_PORT);
        Check(rc != 0, "connect to closed port fails");
        Socket.Close(sock);

        // 2. Same via the timeout overload used by callers.
        nint sock2 = Socket.CreateTcp();
        Socket.SetNonBlocking(sock2);
        int rc2 = await Socket.ConnectAsync(sock2, "127.0.0.1", FAIL_PORT, 3000);
        Check(rc2 != 0, "ConnectAsync to closed port fails");
        Socket.Close(sock2);

        // 3. Occupy a port, then a second TcpListener on the same port must
        //    throw SocketException from Start() -- and not report running.
        //    The port is occupied WITHOUT SO_REUSEADDR: on Windows a second
        //    socket may only double-bind when both sides set SO_REUSEADDR,
        //    so an unset first socket makes the listener's bind fail; on
        //    POSIX SO_REUSEADDR never allows double-bind of an active port.
        nint occupier = Socket.CreateTcp();
        Socket.Bind(occupier, "127.0.0.1", OCCUPIED_PORT);
        Socket.Listen(occupier, 4);
        Check(true, "occupier bound");

        TcpListener second = new TcpListener("127.0.0.1", OCCUPIED_PORT);
        bool threw = false;
        bool hasCode = false;
        try {
            second.Start();
        } catch (SocketException e) {
            threw = true;
            hasCode = e.code != 0;
        }
        Check(threw, "second bind throws SocketException");
        Check(hasCode, "SocketException carries nonzero error code");
        Check(!second.IsRunning(), "failed listener not running");
        Socket.Close(occupier);

        // 4. A freed port can be bound again (listener usable after throw).
        TcpListener third = new TcpListener("127.0.0.1", OCCUPIED_PORT);
        third.Start();
        Check(third.IsRunning(), "listener starts after port freed");
        third.Stop();

        Socket.Cleanup();
        Console.WriteLine("failures=" + Convert.ToString(failures));
        return 0;
    }

    static void Main() {
        int r = await Run();
    }
}
