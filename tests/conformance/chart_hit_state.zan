using System;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static void Main() {
        ChartHit a = ChartHit.Of(ChartElementType.LinePoint,
            0, "CPU", 2, "C", 30, 100, 200);
        a.numberValueSet = true;
        a.numberValue = 30.5;
        ChartHit a2 = ChartHit.Copy(a);
        if (a2 == null) {
            Console.WriteLine("copy:null");
            return;
        }
        a2.pixelX = 110;
        a2.pixelY = 210;
        ChartHit b = ChartHit.Of(ChartElementType.LinePoint,
            0, "CPU", 3, "D", 40, 120, 220);
        Console.WriteLine(Convert.ToString(ChartHit.Same(a, a2)) + ":"
            + Convert.ToString(ChartHit.Same(a, b)) + ":"
            + Convert.ToString(a2.numberValueSet) + ":"
            + Convert.ToString(a2.numberValue));

        ChartInteractionEvent outA = ChartInteractionEvent.DataPoint(
            ChartEventType.MouseOut, 9, a2.seriesIndex, a2.seriesName,
            a2.dataIndex, a2.dataName, a2.elementType);
        outA.value = a2.value;
        outA.numberValueSet = a2.numberValueSet;
        outA.numberValue = a2.numberValue;
        ChartInteractionEvent overB = ChartInteractionEvent.DataPoint(
            ChartEventType.Hover, 9, b.seriesIndex, b.seriesName,
            b.dataIndex, b.dataName, b.elementType);
        Console.WriteLine(outA.TypeName() + ":" + outA.dataName + ":"
            + overB.TypeName() + ":" + overB.dataName);

        ChartInteractionEvent blank = ChartInteractionEvent.Of(
            ChartEventType.Click, 9);
        Console.WriteLine(ChartInteractionEvent.ElementName(blank.elementType)
            + ":" + Convert.ToString(blank.dataHit) + ":"
            + Convert.ToString(blank.dataIndex));
    }
}
