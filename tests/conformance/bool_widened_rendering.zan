// A bool that comes back from a **generic method** is widened to i64 (the
// value rides an i64 slot). Every path that renders a bool must still say
// "true"/"false" -- the width is not the type (A492).
//
// Before the fix the C host printed "1" for the interpolation, the
// Convert.ToString and the ToString() paths (they judged the LLVM width),
// while the concatenation path (which judges the static type) printed
// "true" -- the same bool, two renderings, in one line of code.
using System;
using System.Collections.Generic;

class Program {
    static void Main() {
        List<string> l = new List<string>();
        l.Add("a");
        bool c = l.Contains("a");
        Console.WriteLine("var     : " + c);
        Console.WriteLine("concat  : " + ("x" + l.Contains("a")));
        Console.WriteLine("interp  : " + $"[{l.Contains("a")}]");
        Console.WriteLine("format  : " + string.Format("{0}|{1}", l.Contains("a"), l.Contains("b")));
        Console.WriteLine("convert : " + Convert.ToString(l.Contains("a")));
        Console.WriteLine("tostr   : " + l.Contains("a").ToString());
        Console.WriteLine("write   : " + l.Contains("a"));
    }
}
