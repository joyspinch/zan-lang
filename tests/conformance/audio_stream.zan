using System;
using System.Media;

class Program {
    static int pass = 0;
    static int fail = 0;

    static void Check(string name, bool ok) {
        if (ok) { pass = pass + 1; }
        else { fail = fail + 1; Console.WriteLine("FAIL " + name); }
    }

    static void Main() {
        // 1. 非法参数拒绝
        Check("reject-bad-rate", AudioStream.Create(100, 2, 500) == null);
        Check("reject-bad-ch", AudioStream.Create(48000, 0, 500) == null);

        // 2. 创建 48kHz 立体声 500ms 环形流（容量 24000 帧）
        AudioStream s = AudioStream.Create(48000, 2, 500);
        Check("stream-valid", s != null && s.IsValid);
        Check("stream-initial-free", s.FreeFrames == 24000);
        Check("stream-initial-buf", s.BufferedMs == 0);
        Check("stream-initial-played", s.PlayedMs == 0);

        // 暂停模式下推入 4800 帧（100ms），验证缓冲计数精确
        s.Pause();
        byte[] chunk = new byte[4800 * 4]; // 4800 frames * 2ch * 2bytes
        int written1 = s.WriteBytes(chunk, chunk.Length);
        Check("write-100ms", written1 == 4800);
        Check("buffered-100ms", s.BufferedMs == 100);
        Check("free-after-100ms", s.FreeFrames == 19200);

        // 再写满剩余缓冲，验证不越界截断
        byte[] big = new byte[25000 * 4];
        int written2 = s.WriteBytes(big, big.Length);
        Check("write-clamp", written2 == 19200);
        Check("free-zero", s.FreeFrames == 0);
        Check("buffered-500ms", s.BufferedMs == 500);

        // 调音量、倍速、Flush 归零
        s.SetGain(0.5);
        s.SetSpeed(1.5);
        s.Flush();
        Check("flush-buf-zero", s.BufferedMs == 0);
        Check("flush-free-full", s.FreeFrames == 24000);
        Check("flush-played-zero", s.PlayedMs == 0);

        s.Resume();
        s.Dispose();
        Check("disposed", !s.IsValid);

        Console.WriteLine("pass: " + Convert.ToString(pass));
        Console.WriteLine("fail: " + Convert.ToString(fail));
    }
}
