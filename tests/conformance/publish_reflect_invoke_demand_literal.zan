using System;

class InvokeDemandLiteralBase {
    public int Value;
    public int Stored;
    public int Number {
        get { return Stored * 2; }
        set { Stored = value / 2; }
    }

    public void OnChosen() {
        Value = Value + 7;
        Console.WriteLine("chosen PASS");
        object self = this;
        if (!self.Invoke("OnLate")) throw new Exception("late hook missing");
    }

    public void OnUnused() {
        Console.WriteLine("INVOKE_LITERAL_UNUSED_BODY_MUST_BE_DEAD");
    }
}

class InvokeDemandLiteralDerived : InvokeDemandLiteralBase {
    public void OnLate() {
        Value = Value + 11;
        Console.WriteLine("late PASS");
    }
}

class Program {
    // A dead dynamic call must not enable unknown invocation demand.
    static bool DeadDynamic(object target, string name) { return target.Invoke(name); }

    static void Require(bool condition, string message) {
        if (!condition) throw new Exception(message);
    }

    static void Main() {
        InvokeDemandLiteralBase instance = new InvokeDemandLiteralDerived();
        object target = instance;
        TypeInfo type = target.GetType();
        Require(type.HasMethod("OnChosen") && type.HasMethod("OnLate"), "inherited hook metadata");
        Require(type.HasMethod("OnUnused"), "uncalled hook still enumerated");
        Require(target.SetFieldInt("Number", 42), "property setter");
        Require(target.GetFieldInt("Number") == 42 && instance.Stored == 21, "property getter and storage");
        Require(target.Invoke("OnChosen"), "inherited chosen hook");
        Require(instance.Value == 18, "chosen and late hook bodies");
        Console.WriteLine("literal PASS");
    }
}
