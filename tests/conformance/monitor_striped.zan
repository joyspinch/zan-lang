using System;
using System.Threading;

// Two threads hammer `a`, two hammer `b`. Every increment is inside a lock, so
// each counter must land exactly on its expected total no matter how the
// stripes hash: over-serializing is allowed, losing an update is not.

class Cell {
    public int n;
}

class Program {
    static Cell a = new Cell();
    static Cell b = new Cell();
    static AtomicInt done = new AtomicInt(0);

    static void BumpA() {
        for (int i = 0; i < 20000; i = i + 1) {
            lock (a) {
                a.n = a.n + 1;
            }
        }
        done.Increment();
    }

    static void BumpB() {
        for (int i = 0; i < 20000; i = i + 1) {
            lock (b) {
                b.n = b.n + 1;
            }
        }
        done.Increment();
    }

    static void Main() {
        Thread.Start(BumpA);
        Thread.Start(BumpA);
        Thread.Start(BumpB);
        Thread.Start(BumpB);
        while (done.Load() < 4) {
            Thread.Sleep(1);
        }
        Console.WriteLine(a.n);
        Console.WriteLine(b.n);
        // A monitor is re-entrant for the thread that already owns it.
        lock (a) {
            lock (a) {
                Console.WriteLine("reentrant");
            }
        }
    }
}
