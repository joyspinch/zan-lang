using System;

struct Pos {
    int x;
    int y;
    int z;
    int w;
}

struct Tagged {
    string tag;
    int n;
}

class Box<T> {
    T value;
    Box(T v) {
        this.value = v;
    }
    void Set(T v) {
        this.value = v;
    }
    T Get() {
        return this.value;
    }
}

class Program {
    static void Main() {
        Box<Pos> b = new Box<Pos>(new Pos());
        Pos p = new Pos();
        p.x = 7;
        p.y = 8;
        p.z = 9;
        p.w = 10;
        b.Set(p);
        Pos q = b.Get();
        Console.WriteLine("pos=" + Convert.ToString(q.x) + "," + Convert.ToString(q.y)
            + "," + Convert.ToString(q.z) + "," + Convert.ToString(q.w));

        Box<int> bi = new Box<int>(41);
        bi.Set(7);
        Console.WriteLine("int=" + Convert.ToString(bi.Get() + 1));

        Box<string> bs = new Box<string>("zan");
        Console.WriteLine("str=" + bs.Get());

        Box<Tagged> bt = new Box<Tagged>(new Tagged());
        Tagged t = new Tagged();
        t.tag = "hi";
        t.n = 5;
        bt.Set(t);
        Tagged u = bt.Get();
        Console.WriteLine("tagged=" + u.tag + "," + Convert.ToString(u.n));

        Console.WriteLine("done");
    }
}
