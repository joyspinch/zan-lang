using System;
using System.Threading;

class Program {
    static void Main() {
        nint mtx = Mutex.Create();
        Mutex.Lock(mtx);
        int counter = 0;

        Thread.Start(delegate () {
            Mutex.Lock(mtx);
            counter = 99;
            Mutex.Unlock(mtx);
        });

        Thread.Sleep(20);
        Console.WriteLine("before_unlock=" + counter);
        Mutex.Unlock(mtx);

        // Wait a bit for thread to grab and finish
        for (int i = 0; i < 50; i = i + 1) {
            Mutex.Lock(mtx);
            int cur = counter;
            Mutex.Unlock(mtx);
            if (cur == 99) { break; }
            Thread.Sleep(10);
        }

        Console.WriteLine("after_worker=" + counter);
        Mutex.Destroy(mtx);
        Console.WriteLine("mutex-srwlock-ok: 1");
    }
}
