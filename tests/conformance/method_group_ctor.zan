// Conformance test: method group passed as constructor argument bound to delegate.
using System;

delegate string StringTransformer(string s);

class Worker {
    StringTransformer tf;
    public Worker(StringTransformer t) {
        this.tf = t;
    }
    public string Run(string x) {
        return this.tf(x);
    }
}

class Service {
    public string Decorate(string input) {
        return "[" + input + "]";
    }
}

class Program {
    static int Main() {
        Service svc = new Service();
        Worker w = new Worker(svc.Decorate);
        Console.WriteLine(w.Run("hello"));
        return 0;
    }
}
