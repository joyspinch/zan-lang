// A0-0c: a socket handle is `nint` end to end, as in C#
// (SafeSocketHandle / IntPtr): Windows SOCKET is a UINT_PTR, a POSIX fd is a
// 32-bit int, and only Socket's Sys* wrappers truncate. A loopback session runs
// without the handle ever passing through an `int` carrier.
using System;
using System.Net.Sockets;

class Program {
    static void Echo(nint server) {
        string req = Socket.Receive(server, 64);
        Socket.SendString(server, req);
    }

    static void Main() {
        Socket.Initialize();

        nint listener = Socket.CreateTcp();
        Socket.SetReuseAddr(listener);
        Socket.Bind(listener, "127.0.0.1", 9505);
        Socket.Listen(listener, 8);

        nint client = Socket.CreateTcp();
        Socket.Connect(client, "127.0.0.1", 9505);
        nint server = Socket.Accept(listener);
        Console.WriteLine(server >= 0);

        Socket.SendString(client, "PING");
        Echo(server);
        Console.WriteLine(Socket.Receive(client, 64));

        // Handles survive the containers a server keeps its connections in.
        List<nint> open = new List<nint>();
        open.Add(client);
        open.Add(server);
        open.Add(listener);
        Console.WriteLine(open.Count);
        Console.WriteLine(open[1] == server);

        Socket.Close(client);
        Socket.Close(server);
        Socket.Close(listener);
        Socket.Cleanup();

        // A pointer-width handle keeps its high half through the whole API
        // surface -- assignment, a struct-free round trip and comparison.
        nint wide = 4294967297;
        nint copy = wide;
        Console.WriteLine(copy);
        Console.WriteLine(copy == wide);
    }
}
