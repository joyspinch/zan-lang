// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。
using System;
using System.Net.Sockets;

class Program {
    static void Echo(nint server) {
        string req = Socket.Receive(server, 64);
        Socket.SendString(server, req);
    }

    static void Main() {
        Socket.Initialize();

        nint listener = Socket.CreateTcp();
        Socket.SetReuseAddr(listener);
        Socket.Bind(listener, "127.0.0.1", 9505);
        Socket.Listen(listener, 8);

        nint client = Socket.CreateTcp();
        Socket.Connect(client, "127.0.0.1", 9505);
        nint server = Socket.Accept(listener);
        Console.WriteLine(server >= 0);

        Socket.SendString(client, "PING");
        Echo(server);
        Console.WriteLine(Socket.Receive(client, 64));

        // 核心契约与语义定义。
        List<nint> open = new List<nint>();
        open.Add(client);
        open.Add(server);
        open.Add(listener);
        Console.WriteLine(open.Count);
        Console.WriteLine(open[1] == server);

        Socket.Close(client);
        Socket.Close(server);
        Socket.Close(listener);
        Socket.Cleanup();

        // 核心契约与语义定义。
        // 核心契约与语义定义。
        nint wide = 4294967297;
        nint copy = wide;
        Console.WriteLine(copy);
        Console.WriteLine(copy == wide);
    }
}
