using System;
using System.Runtime.InteropServices;

[StructLayout(LayoutKind.Explicit)]
struct FloatBits {
    [FieldOffset(0)] public float AsFloat;
    [FieldOffset(0)] public uint AsBits;
}

[StructLayout(LayoutKind.Explicit)]
struct TaggedVal {
    [FieldOffset(0)] public int Tag;
    [FieldOffset(8)] public int AsInt;
    [FieldOffset(8)] public float AsFloat;
    [FieldOffset(8)] public long AsLong;
}

[StructLayout(LayoutKind.Explicit)]
struct Reg64 {
    [FieldOffset(0)] public ulong Whole;
    [FieldOffset(0)] public uint Lo;
    [FieldOffset(4)] public uint Hi;
}

class Program {
    [Export("g_zan_counter")]
    static long g_counter = 100L;

    [Export]
    static readonly uint g_magic_id = 0x12345678u;

    [Export("bump_counter")]
    [NoAlloc]
    static long BumpCounter(long delta) {
        g_counter += delta;
        return g_counter;
    }

    static int Main() {
        FloatBits fb = new FloatBits();
        fb.AsFloat = 1.0f;
        uint bits = fb.AsBits; // IEEE 754 1.0f = 0x3F800000 = 1065353216

        Reg64 reg = new Reg64();
        reg.Lo = 0xDEADBEEFu;
        reg.Hi = 0xCAFEBABEu;
        ulong whole = reg.Whole;

        TaggedVal tv = new TaggedVal();
        tv.Tag = 2;
        tv.AsFloat = 2.0f; // 0x40000000 = 1073741824
        int rawInt = tv.AsInt;

        long c = BumpCounter(23L);
        int ok = (bits == 0x3F800000u &&
                  whole == 0xCAFEBABEDEADBEEFul &&
                  tv.Tag == 2 && rawInt == 0x40000000 &&
                  g_magic_id == 0x12345678u && c == 123L) ? 1 : 0;
        Console.WriteLine($"ok={ok} c={c} sz={sizeof(FloatBits)},{sizeof(Reg64)},{sizeof(TaggedVal)}");
        return 0;
    }
}
