using System;
using System.IO;
using System.Collections.Generic;
using System.Data.Excel;

class Program {
    static void Main() {
        // 1. 测试 Xlsx 工具类转义与列号换算
        Console.WriteLine("col_0=" + Xlsx.ColRef(0));
        Console.WriteLine("col_25=" + Xlsx.ColRef(25));
        Console.WriteLine("col_26=" + Xlsx.ColRef(26));
        Console.WriteLine("esc_xml=" + Xlsx.Esc("<data & val>"));
        Console.WriteLine("esc_attr=" + Xlsx.EscAttr("val=\"1\" & 'ok'"));

        // 2. 测试 XlsxCell 构建与类型标记
        XlsxCell cStr = XlsxCell.Str("Hello Zan");
        XlsxCell cNum = XlsxCell.Num(123.456);
        XlsxCell cBool = XlsxCell.Bool(true);
        XlsxCell cDate = XlsxCell.Date(19000);

        Console.WriteLine("cell_str=" + cStr.text);
        Console.WriteLine("cell_kind_num=" + cNum.kind);
        Console.WriteLine("cell_bool_flag=" + (cBool.flag ? 1 : 0));
        Console.WriteLine("cell_date_days=" + cDate.days);

        // 3. 测试 XlsxSheet 与 XlsxBook 创建及内存包生成
        XlsxBook book = XlsxBook.New();
        XlsxSheet sheet = book.AddSheet("Sales Report");
        sheet.AddMerge("A1:C1");

        List<XlsxCell> header = new List<XlsxCell>();
        header.Add(XlsxCell.Str("Title"));
        header.Add(XlsxCell.Str("Count"));
        header.Add(XlsxCell.Str("Status"));
        sheet.AddRow(header);

        List<XlsxCell> row1 = new List<XlsxCell>();
        row1.Add(XlsxCell.Str("Product A"));
        row1.Add(XlsxCell.Num(99.0));
        row1.Add(XlsxCell.Bool(true));
        sheet.AddRow(row1);

        Console.WriteLine("sheet_name=" + sheet.name);
        Console.WriteLine("sheet_rows=" + sheet.RowCount());
        Console.WriteLine("merge_count=" + sheet.mergeCells.Count);

        byte[] bytes = book.SaveToBytes();
        Console.WriteLine("zip_bytes_valid=" + (bytes != null && bytes.Length > 100));

        Console.WriteLine("xlsx_hardening_ok");
    }
}
