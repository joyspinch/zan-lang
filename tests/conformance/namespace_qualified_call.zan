// Positive twin of fully_qualified_unresolved: valid dotted calls at every
// depth must still resolve and run. Namespace-qualified statics
// (`My.Ns.Widget.Ping`), nested classes (`Outer.Inner.Value`), and plain
// single-segment calls (`Helper.Twice`) all share the member-access call path
// whose unresolved-name guard was widened to walk the whole path; nothing
// legitimate may trip it.
namespace My.Ns;
class Widget {
    public static int Ping() { return 100; }
}
class Helper {
    public static int Twice(int x) { return x * 2; }
}
class Outer {
    public class Inner {
        public static int Value() { return 42; }
    }
}
class Program {
    static void Main() {
        Console.WriteLine(My.Ns.Widget.Ping());   // namespace-qualified
        Console.WriteLine(Helper.Twice(3));        // single-segment
        Console.WriteLine(Outer.Inner.Value());    // nested class path
    }
}
