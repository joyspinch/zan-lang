using System;
using System.Collections.Generic;

struct Point {
    int x;
    int y;

    static Point Make(int px, int py) {
        Point p = new Point();
        p.x = px;
        p.y = py;
        return p;
    }
}

class Animal {
    int weight;
    string species;

    virtual void Speak() {
        Console.WriteLine("Animal sound");
    }
}

class Dog : Animal {
    string breed;
    bool isTrained;

    override void Speak() {
        Console.WriteLine("Bark");
    }

    static Dog Create(int w, string sp, string br, bool tr) {
        Dog d = new Dog();
        d.weight = w;
        d.species = sp;
        d.breed = br;
        d.isTrained = tr;
        return d;
    }
}

class Program {
    static int Inspect(ref int val, Point pt, Dog dog) {
        val = val + pt.x + pt.y + dog.weight;
        return val;
    }

    static void Main() {
        int val = 10;
        Point pt = Point.Make(1, 2);
        Dog d = Dog.Create(15, "Canine", "Golden", true);

        int res = Inspect(ref val, pt, d);
        Console.WriteLine(res);
        Console.WriteLine(d.weight);
        Console.WriteLine(d.species);
        Console.WriteLine(d.breed);
        Console.WriteLine(d.isTrained);
        d.Speak();

        List<int> list = new List<int>();
        list.Add(100);
        list.Add(200);
        Console.WriteLine(list.Count);

        Dictionary<string, int> dict = new Dictionary<string, int>();
        dict["key1"] = 42;
        Console.WriteLine(dict["key1"]);
    }
}
