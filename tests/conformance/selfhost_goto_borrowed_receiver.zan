using System;
class GotoReceiver {
    public int value;
    public int Read() { return value; }
}
class Program {
    static int Forward(GotoReceiver value) {
        int result = 0;
        {
            result = value?.Read();
            goto done;
        }
        done:
        return result;
    }
    static void Main() {
        GotoReceiver value = new GotoReceiver();
        value.value = 7;
        if (Forward(value) != 7 || Forward(null) != 0) {
            throw new Exception("borrowed receiver forward goto");
        }
        Console.WriteLine("borrowed-forward-readable");
    }
}
