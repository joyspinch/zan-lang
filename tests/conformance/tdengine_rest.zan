using System;
using System.Data;
using System.Data.TDengine;

class Program {
    static int passed = 0;
    static int failed = 0;

    static void Check(string name, bool ok) {
        if (ok) {
            Program.passed = Program.passed + 1;
        } else {
            Program.failed = Program.failed + 1;
            Console.WriteLine("FAIL: " + name);
        }
    }

    static void CheckEq(string name, string got, string want) {
        if (got == want) {
            Program.passed = Program.passed + 1;
        } else {
            Program.failed = Program.failed + 1;
            Console.WriteLine("FAIL: " + name + " got [" + got + "] want [" + want + "]");
        }
    }

    static void Main() {
        DbParams p = new DbParams().AddInt(7).Add("O'Brien").AddNull();
        CheckEq("render-mixed",
            TDengineConnection.RenderSql(
                "INSERT INTO t VALUES (NOW, ?, ?, ?)", p),
            "INSERT INTO t VALUES (NOW, 7, 'O\\'Brien', NULL)");

        CheckEq("render-question-in-literal",
            TDengineConnection.RenderSql("SELECT * FROM t WHERE a = 'x?y' AND b = ?",
                new DbParams().AddInt(1)),
            "SELECT * FROM t WHERE a = 'x?y' AND b = 1");

        CheckEq("render-escaped-quote",
            TDengineConnection.RenderSql("SELECT '\\'?' , ?",
                new DbParams().AddInt(2)),
            "SELECT '\\'?' , 2");

        CheckEq("render-hostile-value",
            TDengineConnection.RenderSql("SELECT * FROM t WHERE n = ?",
                new DbParams().Add("x'); DROP TABLE t;--")),
            "SELECT * FROM t WHERE n = 'x\\'); DROP TABLE t;--'");

        CheckEq("render-too-few",
            TDengineConnection.RenderSql("SELECT ?, ?", new DbParams().AddInt(1)), "");
        CheckEq("render-too-many",
            TDengineConnection.RenderSql("SELECT ?", new DbParams().AddInt(1).AddInt(2)), "");

        CheckEq("escape-backslash", TDengineConnection.EscapeText("a\\b'c"), "a\\\\b\\'c");

        CheckEq("dechunk", TDengineConnection.Dechunk("4\r\n{\"a\"\r\n3\r\n:1}\r\n0\r\n\r\n"),
            "{\"a\":1}");
        CheckEq("hex-of", Convert.ToString(TDengineConnection.HexOf("1a;ext\r")), "26");

        TDengineConnection db = new TDengineConnection();
        DbResult r = db.Decode("{\"code\":0,\"column_meta\":[[\"ts\",\"TIMESTAMP\",8],"
            + "[\"v\",\"INT\",4],[\"note\",\"BINARY\",16]],"
            + "\"data\":[[\"2024-01-01T00:00:00Z\",7,null],"
            + "[\"2024-01-01T00:00:01Z\",8,\"ok\"]],\"rows\":2}");
        Check("decode-shape", r.RowCount() == 2 && r.ColumnCount() == 3);
        CheckEq("decode-columns",
            r.GetColumnName(0) + "," + r.GetColumnName(1) + "," + r.GetColumnName(2),
            "ts,v,note");
        CheckEq("decode-number-cell", r.GetString(0, 1), "7");
        Check("decode-null-cell", r.IsNull(0, 2) && !r.IsNull(1, 2));
        CheckEq("decode-string-cell", r.GetByName(1, "note"), "ok");
        Check("decode-rows-count", db.AffectedRows() == 2);
        CheckEq("decode-no-error", db.GetError(), "");

        DbResult w = db.Decode("{\"code\":0,\"column_meta\":[[\"affected_rows\",\"INT\",4]],"
            + "\"data\":[[3]],\"rows\":1}");
        Check("decode-affected", db.AffectedRows() == 3 && w.RowCount() == 1);

        DbResult old = db.Decode("{\"status\":\"succ\",\"head\":[\"ts\",\"v\"],"
            + "\"data\":[[\"2024-01-01 00:00:00.000\",1]],\"rows\":1}");
        Check("decode-2x", old.RowCount() == 1 && old.GetColumnName(1) == "v"
            && old.GetString(0, 1) == "1");

        DbResult e1 = db.Decode("{\"code\":534,\"desc\":\"Table does not exist\"}");
        Check("decode-error-3x", e1.RowCount() == 0);
        CheckEq("decode-error-3x-desc", db.GetError(), "Table does not exist");
        DbResult e2 = db.Decode("{\"status\":\"error\",\"code\":866,\"desc\":\"invalid SQL\"}");
        Check("decode-error-2x", e2.RowCount() == 0);
        CheckEq("decode-error-2x-desc", db.GetError(), "invalid SQL");

        Check("unconnected", !db.IsConnected());
        Check("provider", db.GetProvider() == DbProvider.TDengine);
        bool execThrew = false;
        try {
            db.Execute("SELECT ?", new DbParams());
        } catch (DbException e) {
            execThrew = true;
        }
        Check("execute-mismatch", execThrew);
        bool queryThrew = false;
        try {
            db.Query("SELECT ?", new DbParams());
        } catch (DbException e) {
            queryThrew = true;
        }
        Check("query-mismatch", queryThrew);

        // TDengine returns schema details as rows in its REST DESCRIBE response.
        DbResult schema = db.Decode("{\"code\":0,\"column_meta\":[[\"Field\",\"VARCHAR\",65],"
            + "[\"Type\",\"VARCHAR\",16],[\"Length\",\"INT\",4],[\"Note\",\"VARCHAR\",16]],"
            + "\"data\":[[\"ts\",\"TIMESTAMP\",8,\"\"],[\"current\",\"FLOAT\",4,\"\"],"
            + "[\"location\",\"BINARY\",24,\"TAG\"]],\"rows\":3}");
        Check("describe-shape", schema.RowCount() == 3 && schema.ColumnCount() == 4);
        CheckEq("describe-leading-column", schema.GetByName(0, "Field"), "ts");
        CheckEq("describe-leading-type", schema.GetByName(0, "Type"), "TIMESTAMP");
        CheckEq("describe-binary-type", schema.GetByName(2, "Type"), "BINARY");
        Check("describe-binary-tag", schema.GetInt(2, schema.GetColumnIndex("Length")) == 24
            && schema.GetByName(2, "Note") == "TAG");

        Console.WriteLine("pass: " + Convert.ToString(Program.passed));
        Console.WriteLine("fail: " + Convert.ToString(Program.failed));
    }
}
