using System;

class Program {
    // 核心契约与语义定义。
    // 核心契约与语义定义。
    // need.
    [NoRuntime]
    static int Checksum(int seed, int rounds) {
        int h = seed;
        for (int i = 0; i < rounds; i = i + 1) {
            h = h * 31 + i;
            h = h ^ (h >> 7);
        }
        return h;
    }

    static void Main() {
        Console.WriteLine(Checksum(1, 8));
    }
}
