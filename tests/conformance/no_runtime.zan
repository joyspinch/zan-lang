using System;

class Program {
    // Runs with no managed runtime underneath: no allocation, no ARC, no
    // exceptions -- the shape rt_crash-style handlers and thread trampolines
    // need.
    [NoRuntime]
    static int Checksum(int seed, int rounds) {
        int h = seed;
        for (int i = 0; i < rounds; i = i + 1) {
            h = h * 31 + i;
            h = h ^ (h >> 7);
        }
        return h;
    }

    static void Main() {
        Console.WriteLine(Checksum(1, 8));
    }
}
