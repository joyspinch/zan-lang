using System;
using System.Collections.Generic;

// The duck-typed enumerable protocol: GetEnumerator() -> enumerator,
// enumerator.MoveNext() -> bool, enumerator.Current -> element.
// `Current` as a property and as a method -- the two forms the C host
// lowers (the self-hosted backend mirrors that choice).
class Range {
    int from;
    int to;
    public Range(int f, int t) { from = f; to = t; }
    public RangeEnum GetEnumerator() { return new RangeEnum(from, to); }
}

class RangeEnum {
    int cur;
    int to;
    public RangeEnum(int c, int t) { cur = c; to = t; }
    public bool MoveNext() { if (cur >= to) { return false; } cur = cur + 1; return true; }
    public int Current { get { return cur - 1; } }
}

class MethodEnum {
    int cur;
    int to;
    public MethodEnum(int c, int t) { cur = c; to = t; }
    public bool MoveNext() { if (cur >= to) { return false; } cur = cur + 1; return true; }
    public int Current() { return cur - 1; }
}

class MethodRange {
    public MethodEnum GetEnumerator() { return new MethodEnum(1, 4); }
}

class Program {
    static void Main() {
        foreach (int v in new Range(1, 4)) {
            Console.WriteLine("v=" + Convert.ToString(v));
        }
        foreach (int v in new MethodRange()) {
            Console.WriteLine("m=" + Convert.ToString(v));
        }
        Console.WriteLine("done");
    }
}
