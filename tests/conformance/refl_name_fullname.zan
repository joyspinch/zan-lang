// B-ID107：TypeInfo.Name/FullName/TableName 契约钉
// Name = 短名（剥命名空间，泛型实参同步剥 ns，对齐 C#）；
// FullName = 全限定名；TableName 兜底 = 短名，[Table] 属性优先。
using System;
using System.Collections.Generic;

namespace ReflNs.Inner;

public class PointClass {
    public int X;
    public int Y;
    public PointClass() { this.X = 1; this.Y = 2; }
}

[Table("t_annotated")]
public class AnnotatedEntity {
    public int V;
}

public static class Program {
    public static int Main() {
        TypeInfo ti = typeof(PointClass);
        Console.WriteLine("name=[" + ti.Name + "]");
        Console.WriteLine("full=[" + ti.FullName + "]");
        Console.WriteLine("tbl=[" + ti.TableName + "]");

        TypeInfo ta = typeof(AnnotatedEntity);
        Console.WriteLine("anno-name=[" + ta.Name + "]");
        Console.WriteLine("anno-tbl=[" + ta.TableName + "]");

        TypeInfo tl = typeof(List<PointClass>);
        Console.WriteLine("list=[" + tl.Name + "]");
        string ln = tl.Name;
        Console.WriteLine("is-list=[" + (ln.Length >= 5 && ln.Substring(0, 5) == "List<" ? "yes" : "no") + "]");
        return 0;
    }
}
