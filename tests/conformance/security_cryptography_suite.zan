using System;
using System.Security.Cryptography;

class Program {
    static void Main() {
        string msg = "zan language production grade security suite";
        int msgLen = msg.Length;

        // 1. SHA-256
        byte[] sha256_b = Sha256.Hash(msg, msgLen);
        string sha256_hex = Hex.Encode(sha256_b, 32);
        Console.WriteLine("sha256 len=" + sha256_hex.Length.ToString());

        // 2. SHA-1
        byte[] sha1_b = Sha1.Hash(msg, msgLen);
        string sha1_hex = Hex.Encode(sha1_b, 20);
        Console.WriteLine("sha1 len=" + sha1_hex.Length.ToString());

        // 3. SM3
        byte[] sm3_b = Sm3.Hash(msg, msgLen);
        string sm3_hex = Hex.Encode(sm3_b, 32);
        Console.WriteLine("sm3 len=" + sm3_hex.Length.ToString());

        // 4. HMAC-SHA256
        string secretKey = "my_top_secret_key_12345";
        byte[] hmac_b = Hmac.Compute(0, secretKey, secretKey.Length, msg, msgLen);
        string hmac_hex = Hex.Encode(hmac_b, 32);
        Console.WriteLine("hmac len=" + hmac_hex.Length.ToString());

        // 5. PBKDF2
        string password = "UserPassword@2026";
        string salt = "random_salt_16b!";
        string pbkdf2_raw = Pbkdf2.Derive(password, password.Length, salt, salt.Length, 100, 32);
        string pbkdf2_hex = Hex.Encode(pbkdf2_raw, 32);
        Console.WriteLine("pbkdf2 len=" + pbkdf2_hex.Length.ToString());

        // 6. AES-GCM 认证加密与解密
        string aesKey = "01234567890123456789012345678901"; // 32 bytes
        string iv = "123456789012"; // 12 bytes
        string plain = "Confidential industrial payload for ZanLang ecosystem!";
        string aad = "audit_header_metadata";

        byte[] tag = new byte[16];
        byte[] cipher = AesGcm.Encrypt(aesKey, 32, iv, aad, aad.Length, plain, plain.Length, tag);
        if (cipher != null) {
            Console.WriteLine("cipher len=" + cipher.Length.ToString());
            Console.WriteLine("tag len=" + tag.Length.ToString());

            List<int> ok = new List<int>();
            ok.Add(0);
            byte[] decrypted = AesGcm.Decrypt(aesKey, 32, iv, aad, aad.Length, cipher, cipher.Length, tag, ok);
            Console.WriteLine("decrypt ok=" + (ok[0] != 0).ToString());

            string decStr = decrypted;
            Console.WriteLine("dec matches=" + (decStr == plain).ToString());

            // 7. AES-GCM 篡改拦截验证
            tag[0] = (byte)(tag[0] ^ 1); // 篡改 tag 1 比特
            List<int> okBad = new List<int>();
            okBad.Add(0);
            byte[] decBad = AesGcm.Decrypt(aesKey, 32, iv, aad, aad.Length, cipher, cipher.Length, tag, okBad);
            Console.WriteLine("tamper detected=" + (okBad[0] == 0).ToString());
        }

        Console.WriteLine("All Cryptography tests passed successfully!");
    }
}
