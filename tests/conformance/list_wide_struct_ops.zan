using System;

struct LargeItem {
    int id;
    string name;
    double score;
}

class Program {
    static void Main() {
        List<LargeItem> list = new List<LargeItem>();

        LargeItem item1; item1.id = 1; item1.name = "alpha"; item1.score = 99.5;
        LargeItem item2; item2.id = 2; item2.name = "beta"; item2.score = 88.0;
        LargeItem item3; item3.id = 3; item3.name = "alpha"; item3.score = 99.5;
        LargeItem item4; item4.id = 1; item4.name = "alpha"; item4.score = 99.5;

        list.Add(item1);
        list.Add(item2);
        list.Add(item3);
        list.Add(item4);

        Console.WriteLine("Count=" + list.Count);

        LargeItem query1;
        query1.id = 1;
        query1.name = "alpha";
        query1.score = 99.5;

        Console.WriteLine("Contains query1: " + list.Contains(query1));
        Console.WriteLine("IndexOf query1: " + list.IndexOf(query1));
        Console.WriteLine("LastIndexOf query1: " + list.LastIndexOf(query1));

        LargeItem query2;
        query2.id = 2;
        query2.name = "beta";
        query2.score = 88.0;
        Console.WriteLine("Contains query2: " + list.Contains(query2));
        Console.WriteLine("IndexOf query2: " + list.IndexOf(query2));
        Console.WriteLine("LastIndexOf query2: " + list.LastIndexOf(query2));

        LargeItem queryMissing;
        queryMissing.id = 99;
        queryMissing.name = "gamma";
        queryMissing.score = 0.0;
        Console.WriteLine("Contains missing: " + list.Contains(queryMissing));
        Console.WriteLine("IndexOf missing: " + list.IndexOf(queryMissing));
        Console.WriteLine("LastIndexOf missing: " + list.LastIndexOf(queryMissing));

        bool removed = list.Remove(query1);
        Console.WriteLine("Removed query1: " + removed + ", new count=" + list.Count);
        Console.WriteLine("New IndexOf query1: " + list.IndexOf(query1));
    }
}
