using System;

/// A `string` an extern hands back is a bare C pointer: it has no Zan object
/// header, so indexing must measure it with strlen (what `string.Length`
/// reports) instead of reading a count word that is not there.
class Program {
    [DllImport("crt")] static extern string getenv(string name);

    static void Main() {
        string p = Program.getenv("PATH");
        int scanned = 0;
        int seps = 0;
        for (int i = 0; i < p.Length; i = i + 1) {
            if (p[i] == 59 || p[i] == 58) { seps = seps + 1; }
            scanned = scanned + 1;
        }
        Console.WriteLine(scanned == p.Length);
        Console.WriteLine(p.Length > 0 && seps >= 0);
    }
}
