using System;

class Program {
    static void Main() {
        int x = 42;
        string path = @"C:\foo\bar";

        // 1. Basic $@ and @$ with variable
        string s1 = $@"hello {x} \world";
        string s2 = @$"quote ""{x}"" path {path}";
        Console.WriteLine(s1);
        Console.WriteLine(s2);

        // 2. Escaped braces {{ and }}
        string s3 = $@"braces {{ {x} }} escaped";
        Console.WriteLine(s3);

        // 3. Multiline verbatim interpolation
        string s4 = $@"line 1
line 2: {x}
line 3";
        Console.WriteLine(s4);

        // 4. Format specifier
        string s5 = @$"fmt {x:D4} done";
        Console.WriteLine(s5);

        // 5. Nested regular interpolated inside verbatim interpolated
        string s6 = $@"{x} -> {$"inner {x + 1} \\"} -> end";
        Console.WriteLine(s6);
    }
}
