using System;

/// [StructLayout(LayoutKind.Explicit)] places every field at its own
/// [FieldOffset(n)]. Fields sharing an offset overlap, which is how a C union
/// (SDL_Event, XEvent, DEBUG_EVENT) is written -- no separate union kind.
[StructLayout(LayoutKind.Explicit)]
struct Word {
    [FieldOffset(0)] int all;
    [FieldOffset(0)] byte b0;
    [FieldOffset(1)] byte b1;
    [FieldOffset(2)] byte b2;
    [FieldOffset(3)] byte b3;
}

/// Overlapping fields of different kinds, plus a hole between them: the tag
/// sits alone in the first eight bytes.
[StructLayout(LayoutKind.Explicit)]
struct Event {
    [FieldOffset(0)] int kind;
    [FieldOffset(8)] long asLong;
    [FieldOffset(8)] int lo;
    [FieldOffset(12)] int hi;
    [FieldOffset(8)] float asFloat;
}

class Program {
    static void Main() {
        Console.WriteLine("=== union bytes ===");
        Word w = new Word();
        w.all = 67305985;
        Console.WriteLine(w.b0);
        Console.WriteLine(w.b1);
        Console.WriteLine(w.b2);
        Console.WriteLine(w.b3);

        w.b0 = 255;
        Console.WriteLine(w.all);

        Console.WriteLine("=== tagged union ===");
        Event e = new Event();
        e.kind = 7;
        e.lo = 100;
        e.hi = 200;
        Console.WriteLine(e.kind);
        Console.WriteLine(e.lo);
        Console.WriteLine(e.hi);
        Console.WriteLine(e.asLong);

        e.asLong = 4294967296;
        Console.WriteLine(e.lo);
        Console.WriteLine(e.hi);
        Console.WriteLine(e.kind);

        e.asFloat = 1.5;
        Console.WriteLine(e.asFloat);
        Console.WriteLine(e.lo);
        Console.WriteLine(e.hi);
    }
}
