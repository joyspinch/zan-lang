// 可空值类型走字符串拼接：null 渲染为 ""，有值渲染为值的常规形态。
// A496：自举的 ToCStr 曾没有可空分支——box 指针被当 i64 比较，IR 非法。
using System;

class App {
    static void Main() {
        bool? bt = true;
        bool? bf = false;
        bool? bn = null;
        Console.WriteLine("bt=" + bt);
        Console.WriteLine("bf=" + bf);
        Console.WriteLine("bn=" + bn);
        int? i = 42;
        int? inn = null;
        Console.WriteLine("i=" + i);
        Console.WriteLine("inn=" + inn);
        double? d = 1.5;
        Console.WriteLine("d=" + d);
    }
}
