using System;
using System.Collections.Generic;
using System.Json;
using System.Text;
using System.Text.RegularExpressions;
using System.Threading;
using System.Data.ZanDb;

class W23Item {
    public int Id;
    public string Name;
    public double Price;
    public bool Flag;
}

class W23Wide {
    public int F1;
    public int F2;
    public int F3;
    public int F4;
    public int F5;
    public int F6;
    public int F7;
    public int F8;
    public int F9;
    public string Tag;
    public List<W23Item> Items;
}

class Program {
    static void Check(bool cond, string msg) {
        if (!cond) {
            throw new Exception("FAIL: " + msg);
        }
    }

    static void TestDecimal() {
        // 1. FromDouble + ToString edge cases
        Check(Decimal.FromDouble(0.0).ToString() == "0", "dec 0");
        Check(Decimal.FromDouble(-0.0).ToString() == "0", "dec -0");
        Check(Decimal.FromDouble(42.0).ToString() == "42", "dec 42");
        Check(Decimal.FromDouble(-123456789012.0).ToString() == "-123456789012", "dec big int");
        Check(Decimal.FromDouble(0.1).ToString() == "0.1", "dec 0.1");
        Check(Decimal.FromDouble(19.99).ToString() == "19.99", "dec 19.99");
        Check(Decimal.FromDouble(-0.0025).ToString() == "-0.0025", "dec -0.0025");
        Check(Decimal.FromDouble(0.0001).ToString() == "0.0001", "dec 1e-4");
        Check(Decimal.FromDouble(0.000125).ToString() == "0.000125", "dec 0.000125");
        Check(Decimal.FromDouble(999999999999999.0).ToString() == "999999999999999", "dec 1e15-1");
        // 8.3 exact IEEE-754 parity with snprintf("%.16g")
        decimal d83 = Decimal.FromDouble(8.3);
        Check(d83 > 8.2999999m && d83 < 8.3000001m, "dec 8.3 range");

        // 2. Cross-scale add / sub / cmp + trailing zero stripping
        decimal a = 12345.67m;
        decimal b = 0.0000000000000001m;
        decimal s = a + b;
        Check(s.ToString() == "12345.6700000000000001", "dec cross-scale add");
        Check((s - b) == a, "dec cross-scale sub");
        Check(1.5000m + 2.5000m == 4m, "dec strip zeros");
        Check((1.5000m + 2.5000m).ToString() == "4.0000", "dec add preserves scale");
        Check(0.000000000001m < 0.000000000002m, "dec small cmp");

        // 3. Exact 64-bit div + general 128-bit div (hardware divq path)
        Check((100.00m / 4.0m).ToString() == "25", "dec exact div 25");
        Check((-8192m / 16m).ToString() == "-512", "dec exact div -512");
        Check((123456789000m / 1000m).ToString() == "123456789", "dec exact div 1000");
        decimal q13 = 1m / 3m;
        Check(q13.ToString().Substring(0, 10) == "0.33333333", "dec 1/3");
        decimal bigNum = 12345678901234567890m;
        decimal bigDen = 98765432101m;
        decimal bigQ = bigNum / bigDen;
        Check(Decimal.ToInt64(bigQ) == 124999999L, "dec 128/64 divq");

        // 4. 96-bit ToString boundary
        decimal maxD = 79228162514264337593543950335m;
        Check(maxD.ToString() == "79228162514264337593543950335", "dec max str");
        decimal tinyD = -0.0000000000000000000000000001m;
        Check(tinyD.ToString() == "-0.0000000000000000000000000001", "dec tiny str");
    }

    static void TestRegex() {
        // Greedy & lazy OpClassRep / OpAnyRep + backtracking
        Regex r1 = Regex.Compile("(\\w+)_(\\d+)");
        Match m1 = r1.Find("foo_bar_123_456");
        Check(m1.Success() && m1.Group(1) == "foo_bar_123" && m1.Group(2) == "456", "regex greedy class backtrack");

        Regex r2 = Regex.Compile("(\\w+?)_(\\d+)");
        Match m2 = r2.Find("foo_123_456");
        Check(m2.Success() && m2.Group(1) == "foo" && m2.Group(2) == "123", "regex lazy class");

        Regex r3 = Regex.Compile("([a-z]*)end");
        Match m3 = r3.Find("end");
        Check(m3.Success() && m3.Group(1) == "", "regex star zero");

        Regex r4 = Regex.Compile("a.*b");
        Match m4 = r4.Find("a123b456b\na999b");
        Check(m4.Success() && m4.Value() == "a123b456b", "regex greedy dot no-dotall");

        Regex r5 = Regex.Compile("(?s)a.*b");
        Match m5 = r5.Find("a123\n456b");
        Check(m5.Success() && m5.Value() == "a123\n456b", "regex greedy dot dotall");

        Regex r6 = Regex.Compile("a.*?b");
        Match m6 = r6.Find("a123b456b");
        Check(m6.Success() && m6.Value() == "a123b", "regex lazy dot");

        Regex r7 = Regex.Compile("a.+?b");
        Match m7 = r7.Find("ab_axb");
        Check(m7.Success() && m7.Value() == "ab_axb", "regex lazy dot plus");

        // UTF-8 multibyte backtracking
        Regex r8 = Regex.Compile("(.+)界");
        Match m8 = r8.Find("你好世界再见世界");
        Check(m8.Success() && m8.Group(1) == "你好世界再见世", "regex utf8 dot backtrack");

        Regex r9 = Regex.Compile("([^,]+),(\\w+)");
        Match m9 = r9.Find("中文标签,tag_99");
        Check(m9.Success() && m9.Group(1) == "中文标签" && m9.Group(2) == "tag_99", "regex utf8 negated class");

        // Backref + fused repeats
        Regex r10 = Regex.Compile("([a-z]+)_\\w+.*\\1");
        Match m10 = r10.Find("alpha_beta_gamma_alpha_end");
        Check(m10.Success() && m10.Value() == "alpha_beta_gamma_alpha", "regex backref fused");
    }

    static float[] MakeVec(int dims, int seed) {
        float[] v = new float[dims];
        int s = seed * 1103515245 + 12345;
        for (int i = 0; i < dims; i = i + 1) {
            s = s * 1103515245 + 12345;
            int u = (s >> 16) & 32767;
            v[i] = (float)((double)u / 16384.0 - 1.0);
        }
        return v;
    }

    static void TestVectorOne(int dims, int metric, bool quantize) {
        VectorIndexOptions opt = new VectorIndexOptions(dims);
        opt.metric = metric;
        opt.m = 8;
        opt.efConstruction = 24;
        opt.efSearch = 24;
        opt.quantize = quantize;
        opt.seed = 77;
        VectorIndex idx = new VectorIndex(opt);
        int n = 90;
        List<float[]> vecs = new List<float[]>();
        for (int i = 0; i < n; i = i + 1) {
            float[] v = MakeVec(dims, i + 10);
            vecs.Add(v);
            idx.Add(i + 1, v);
        }
        // Overwrite id=5 and remove id=6
        float[] vNew5 = MakeVec(dims, 999);
        idx.Add(5, vNew5);
        Check(idx.Remove(6), "vec remove 6");
        Check(idx.Count() == n - 1, "vec count after remove");

        List<VectorHit> h5 = idx.Search(vNew5, 3, 24);
        Check(h5.Count == 3 && h5[0].id == 5, "vec updated id=5 top1");
        for (int i = 0; i < h5.Count; i = i + 1) {
            Check(h5[i].id != 6, "vec removed id=6 absent");
        }

        // Filtered search (even ids only)
        List<VectorHit> hEven = idx.SearchFiltered(vecs[1], 3, 32, (id) => (id % 2) == 0);
        Check(hEven.Count > 0, "vec filtered non-empty");
        for (int i = 0; i < hEven.Count; i = i + 1) {
            Check((hEven[i].id % 2) == 0 && hEven[i].id != 6, "vec filtered predicate");
        }

        // Snapshot v2 round-trip (ExportBatches -> ImportBatch -> ImportFinish)
        List<string> batches = new List<string>();
        if (quantize) {
            idx.ExportBatches((payload) => { batches.Add(payload); }, 4096, (id) => {
                if (id == 5) { return vNew5; }
                return vecs[id - 1];
            });
        } else {
            idx.ExportBatches((payload) => { batches.Add(payload); }, 4096);
        }
        VectorIndex imported = new VectorIndex(opt);
        for (int i = 0; i < batches.Count; i = i + 1) {
            imported.ImportBatch(batches[i]);
        }
        imported.ImportFinish(idx.entry, idx.maxLevel, (int)idx.randomState, (long)idx.nodes.Count);
        List<VectorHit> hImp = imported.Search(vNew5, 3, 24);
        Check(hImp.Count == 3 && hImp[0].id == 5, "vec imported top1");

        // Rebuild (only for non-quantized, since quantized has no resident float vectors)
        if (!quantize) {
            idx.Rebuild();
            List<VectorHit> hReb = idx.Search(vNew5, 3, 24);
            Check(hReb.Count == 3 && hReb[0].id == 5, "vec rebuild top1");
        }
    }

    static void TestVector() {
        // Non-multiple-of-4 dims (13), power-of-2 chunkRows (256)
        TestVectorOne(13, 0, true);
        TestVectorOne(13, 1, true);
        TestVectorOne(13, 0, false);
        TestVectorOne(13, 1, false);
        // dims=300 => chunkRows=218 (non-power-of-2 fallback path)
        TestVectorOne(300, 0, true);
        TestVectorOne(300, 1, false);
    }

    static void TestJson() {
        W23Wide w = new W23Wide();
        w.F1 = 1; w.F2 = 2; w.F3 = 3; w.F4 = 4; w.F5 = 5;
        w.F6 = 6; w.F7 = 7; w.F8 = 8; w.F9 = 9;
        w.Tag = "hello\"world";
        w.Items = new List<W23Item>();
        W23Item it1 = new W23Item();
        it1.Id = 10; it1.Name = "alpha"; it1.Price = 12.5; it1.Flag = true;
        W23Item it2 = new W23Item();
        it2.Id = 20; it2.Name = "beta"; it2.Price = 0.25; it2.Flag = false;
        w.Items.Add(it1);
        w.Items.Add(it2);

        // Canonical order (O(1) cursor hit) + >8 fields (MatchProperties)
        string js = Json.Serialize<W23Wide>(w);
        W23Wide w2 = Json.Deserialize<W23Wide>(js);
        Check(w2.F1 == 1 && w2.F9 == 9 && w2.Tag == "hello\"world", "json wide roundtrip");
        Check(w2.Items.Count == 2 && w2.Items[0].Name == "alpha" && w2.Items[1].Price == 0.25, "json nested list");

        // Shuffled order + extra property + missing property (fallback off O(1) cursor)
        string shuffled = "{\"Flag\":true,\"Extra\":999,\"Price\":7.75,\"Id\":42,\"Name\":\"gamma\"}";
        W23Item it3 = Json.Deserialize<W23Item>(shuffled);
        Check(it3.Id == 42 && it3.Name == "gamma" && it3.Price == 7.75 && it3.Flag, "json shuffled item");

        // Dict<string, int> & Dict<string, string>
        Dict<string, int> d = new Dict<string, int>();
        d["k1"] = 10;
        d["k2"] = 20;
        string djs = Json.Serialize<Dict<string, int>>(d);
        Dict<string, int> d2 = Json.Deserialize<Dict<string, int>>(djs);
        Check(d2.Count == 2 && d2["k1"] == 10 && d2["k2"] == 20, "json dict roundtrip");

        // Multi-threaded ThreadLocal JsonTypeMappingLocalCache
        AtomicInt okCount = new AtomicInt(0);
        AtomicInt doneCount = new AtomicInt(0);
        Thread.Start(() => {
            for (int i = 0; i < 20; i = i + 1) {
                string s = Json.Serialize<W23Item>(it1);
                W23Item x = Json.Deserialize<W23Item>(s);
                if (x.Id == 10 && x.Name == "alpha") { okCount.Add(1); }
            }
            doneCount.Add(1);
        });
        Thread.Start(() => {
            for (int i = 0; i < 20; i = i + 1) {
                string s = Json.Serialize<W23Item>(it2);
                W23Item x = Json.Deserialize<W23Item>(s);
                if (x.Id == 20 && x.Name == "beta") { okCount.Add(1); }
            }
            doneCount.Add(1);
        });
        while (doneCount.Load() < 2) { Thread.Sleep(1); }
        Check(okCount.Load() == 40, "json multithread local cache");

        // Regression: expression-bodied void lambda against overloaded generic<T> / void method
        JsonDoc.ParseScopedDeferred("{\"ok\":1}", (doc) => Program.VerifyVoidLambda(doc));
    }

    static void VerifyVoidLambda(JsonDoc doc) {
        Check(doc.PathInt("ok", 0) == 1, "void lambda overload");
    }

    static void Main() {
        TestDecimal();
        TestRegex();
        TestVector();
        TestJson();
        Console.WriteLine("WAVE23_OK");
    }
}
