using System;

class Program {
    const float Rate = 0.2f;
    static float Half(float x) { return x / 2.0f; }

    static void Main() {
        // f/F 后缀字面量按 f32 语义定型与发射(此前一律 double 化,
        // float 变量与字面量在 double 空间比较,非精确值永不等)。
        float e = 0.2f;
        Console.WriteLine(e == 0.2f);
        Console.WriteLine(e != 0.3f);
        Console.WriteLine(Rate == e);
        Console.WriteLine(Half(0.4f) == 0.2f);

        // 一元负号保留 f32 语义。
        float n = -0.2f;
        Console.WriteLine(n == -0.2f);

        // 数组/字段往返。
        float[] arr = new float[1];
        arr[0] = 0.2f;
        Console.WriteLine(arr[0] == 0.2f);

        // 混合运算:f32 提升 double 后按 IEEE 精确和比较。
        double w = e + 0.1;
        Console.WriteLine(w == 0.30000000298023224432);

        // 无后缀仍是 double:double 0.2 与 f32 0.2 不等。
        Console.WriteLine(0.2 == 0.2f);
        Console.WriteLine((double)(float)0.2 == 0.2f);
    }
}
