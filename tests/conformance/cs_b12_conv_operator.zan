// cs_b12_conv_operator.zan -- C#-compat: user-defined conversion operators
// `static implicit operator T2(T1 v)` / `explicit operator T2(T1 v)` lower
// to static op_implicit/op_explicit members. The implicit form is applied at
// var-decl initializers, assignments, returns and call arguments; the
// explicit form at casts `(T2)x`. Like C#, the operator may be declared on
// either the source type or the target type.
using System;

struct Feet {
    public double Amount;
    public Feet(double v) { Amount = v; }
    public static implicit operator double(Feet f) {
        return f.Amount;
    }
    public static explicit operator int(Feet f) {
        return (int)f.Amount;
    }
}

class Fahrenheit {
    public double Degrees;
    public Fahrenheit(double v) { Degrees = v; }
    public static implicit operator Fahrenheit(double d) {
        return new Fahrenheit(d);
    }
}

class Celsius {
    public double Value;
    public Celsius(double v) { Value = v; }
    public static implicit operator double(Celsius c) {
        return c.Value;
    }
}

class Program {
    static double ToDouble(Feet f) {
        return f;
    }
    static void Show(double x) {
        Console.WriteLine(x);
    }
    static void Main() {
        // struct -> double: var-decl, assignment, return, argument
        Feet f = new Feet(5.5);
        double d = f;
        Console.WriteLine(d);
        double e;
        e = f;
        Console.WriteLine(e);
        Console.WriteLine(ToDouble(f));
        Show(f);
        // explicit cast
        int i = (int)f;
        Console.WriteLine(i);
        // class -> double (source-declared)
        Celsius c = new Celsius(36.6);
        double t = c;
        Console.WriteLine(t);
        // double -> class (target-declared)
        Fahrenheit h = 7.25;
        Console.WriteLine(h.Degrees);
        Console.WriteLine("done");
    }
}
