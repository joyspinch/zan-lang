using System;

// B-ID199：Environment.ArgAt 越界契约 = 空串。宿主 builtin_io.c 的 ArgAt
// 内建带完整 idx >= 0 且 idx+1 < argc 检查，越界回空串；gen1 曾裸读
// @__zan_argv[i+1]，差分门裸跑（无 RUN_ARGS）直接段错误
// （crash 簇 builtin_shadowing / environment_unicode_args 的根）。
// 本用例不带参数即可双端钉住该契约。
class Program {
    static void Main() {
        Console.WriteLine("n=" + Environment.ArgCount());
        Console.WriteLine("oob=[" + Environment.ArgAt(99) + "]");
        Console.WriteLine("neg=[" + Environment.ArgAt(-1) + "]");
        Console.WriteLine("ARGAT OOB EMPTY OK");
    }
}
