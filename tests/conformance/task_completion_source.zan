using System;
using System.Threading;

class Program {
    static async int RunAsync() {
        // 1. 测试 TaskCompletionSource<int> 跨协程通知
        TaskCompletionSource<int> tcs = new TaskCompletionSource<int>();
        Task.Run(delegate () {
            Thread.Sleep(20);
            tcs.SetResult(999);
        });

        int res = await tcs.Task;
        if (res != 999) { return 1; }

        // 2. 测试 CancellationToken 跨线程取消
        CancellationTokenSource cts = new CancellationTokenSource();
        CancellationToken token = cts.Token;
        if (token.IsCancellationRequested) { return 2; }

        cts.CancelAfter(30);
        await token.WaitHandle();
        if (!token.IsCancellationRequested) { return 3; }

        return 0;
    }

    static int Main() {
        Task<int> task = Task.Run(RunAsync());
        int code = task.Result;
        if (code == 0) {
            Console.WriteLine("tcs-cancel-ok: 1");
        } else {
            Console.WriteLine("fail: " + code);
        }
        return code;
    }
}
