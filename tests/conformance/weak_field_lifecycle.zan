using System;

class Node {
    public int tag;
    public weak Node up;
    public Node(int t) { tag = t; }
}

class Program {
    static void Main() {
        Node top = new Node(3);
        Node mid = new Node(2);
        Node low = new Node(1);
        mid.up = top;
        low.up = mid;
        Console.WriteLine(low.up.tag);
        Console.WriteLine(low.up.up.tag);
        Node probe = mid.up;
        Console.WriteLine(probe == top);
        probe = null;
        top = null;
        Console.WriteLine(mid.up == null);
        Console.WriteLine(low.tag + mid.tag);
    }
}
