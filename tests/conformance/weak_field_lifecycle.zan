using System;

// A weak field is a non-owning back-reference: storing into it must not keep
// the target alive, reading it while the target lives must yield the target,
// and the final release of the target must clear every slot pointing at it
// (the destroy path nulls the registry slots before the object is freed).
// Reading a cleared slot through a plain comparison observes null; using it
// as a receiver faults with the "weak field was cleared" runtime check.
class Node {
    public int tag;
    public weak Node up;
    public Node(int t) { tag = t; }
}

class Program {
    static void Main() {
        Node top = new Node(3);
        Node mid = new Node(2);
        Node low = new Node(1);
        mid.up = top;
        low.up = mid;
        // borrowed reads through the weak links while everything is alive
        Console.WriteLine(low.up.tag);
        Console.WriteLine(low.up.up.tag);
        // the +1 reading: a value struct copy would keep top alive; a weak
        // read must not -- dropping `top` clears `mid.up`
        Node probe = mid.up;
        Console.WriteLine(probe == top);
        probe = null;
        top = null;
        Console.WriteLine(mid.up == null);
        // low is still owned by its local, mid by its local
        Console.WriteLine(low.tag + mid.tag);
    }
}
