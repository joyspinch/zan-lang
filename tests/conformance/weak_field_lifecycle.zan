using System;

// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
class Node {
    public int tag;
    public weak Node up;
    public Node(int t) { tag = t; }
}

class Program {
    static void Main() {
        Node top = new Node(3);
        Node mid = new Node(2);
        Node low = new Node(1);
        mid.up = top;
        low.up = mid;
        // 接口数据协议与执行契约。
        Console.WriteLine(low.up.tag);
        Console.WriteLine(low.up.up.tag);
        // 接口数据协议与执行契约。
        // 接口数据协议与执行契约。
        Node probe = mid.up;
        Console.WriteLine(probe == top);
        probe = null;
        top = null;
        Console.WriteLine(mid.up == null);
        // 接口数据协议与执行契约。
        Console.WriteLine(low.tag + mid.tag);
    }
}
