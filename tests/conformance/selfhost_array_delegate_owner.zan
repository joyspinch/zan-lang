using System;

public delegate int ArrayOwnerRead();
class ArrayDelegatePayload {
    public int value;
    public ArrayDelegatePayload(int n) { value = n; }
    public int Read() { return value; }
}

class SelfhostArrayDelegateOwner {
    static ArrayOwnerRead Capture(ArrayDelegatePayload payload) { return () => payload.Read(); }
    static ArrayOwnerRead Bind(ArrayDelegatePayload payload) { return payload.Read; }
    static int StaticRead() { return 7; }
    static ArrayOwnerRead[] Echo(ArrayOwnerRead[] values) { return values; }
    static ArrayOwnerRead[,] EchoRect(ArrayOwnerRead[,] values) { return values; }

    static void CheckOne() {
        ArrayDelegatePayload first = new ArrayDelegatePayload(51);
        ArrayDelegatePayload next = new ArrayDelegatePayload(52);
        WeakReference<ArrayDelegatePayload> oldWatch = new WeakReference<ArrayDelegatePayload>(first);
        WeakReference<ArrayDelegatePayload> newWatch = new WeakReference<ArrayDelegatePayload>(next);
        ArrayOwnerRead[] values = new ArrayOwnerRead[] { Capture(first), null, StaticRead };
        first = null;
        Console.WriteLine("one-capture=" + (oldWatch.IsAlive && values[0]() == 51));
        values[1] = values[0];
        values[0] = values[0];
        Console.WriteLine("one-self=" + (oldWatch.IsAlive && values[0]() == 51));
        values[0] = Bind(next);
        next = null;
        Console.WriteLine("one-copy=" + (oldWatch.IsAlive && newWatch.IsAlive && values[1]() == 51));
        values[1] = null;
        Console.WriteLine("one-replace=" + !oldWatch.IsAlive);
        ArrayOwnerRead[] alias = Echo(values);
        values = null;
        Console.WriteLine("one-alias=" + (newWatch.IsAlive && alias[0]() == 52 && alias[2]() == 7));
        alias = null;
        Console.WriteLine("one-dtor=" + !newWatch.IsAlive);
    }

    static void CheckRect() {
        ArrayDelegatePayload first = new ArrayDelegatePayload(61);
        ArrayDelegatePayload next = new ArrayDelegatePayload(62);
        WeakReference<ArrayDelegatePayload> oldWatch = new WeakReference<ArrayDelegatePayload>(first);
        WeakReference<ArrayDelegatePayload> newWatch = new WeakReference<ArrayDelegatePayload>(next);
        ArrayOwnerRead[,] values = new ArrayOwnerRead[2,2];
        values[1,1] = Bind(first);
        first = null;
        values[0,0] = values[1,1];
        values[1,1] = values[1,1];
        Console.WriteLine("rect-self=" + (oldWatch.IsAlive && values[1,1]() == 61));
        values[1,1] = Capture(next);
        next = null;
        Console.WriteLine("rect-copy=" + (oldWatch.IsAlive && newWatch.IsAlive));
        values[0,0] = null;
        Console.WriteLine("rect-replace=" + !oldWatch.IsAlive);
        ArrayOwnerRead[,] alias = EchoRect(values);
        values = null;
        Console.WriteLine("rect-alias=" + (newWatch.IsAlive && alias[1,1]() == 62));
        alias = null;
        Console.WriteLine("rect-dtor=" + !newWatch.IsAlive);
    }

    static void Main() {
        CheckOne();
        CheckRect();
    }
}
