using System;
using System.Collections.Generic;
using System.Security;
using System.Security.Cryptography;

class Program {
    static string TEST_CERT = "-----BEGIN CERTIFICATE-----\n"
        + "MIIDDTCCAfWgAwIBAgIUb/bsPNHjOsVxStVQV+eCJLvKtSEwDQYJKoZIhvcNAQEL\n"
        + "BQAwFjEUMBIGA1UEAwwLWmFuIFRlc3QgQ0EwHhcNMjYwODA2MTcxMTI0WhcNMzYw\n"
        + "ODAzMTcxMTI0WjAWMRQwEgYDVQQDDAtaYW4gVGVzdCBDQTCCASIwDQYJKoZIhvcN\n"
        + "AQEBBQADggEPADCCAQoCggEBAK0xBdnDn6QVIaiCyPqPM3TDnomvnz3XrwUG54Kj\n"
        + "13vQfAbuxcg/0zkrr/yxOxJRcnkh4TPzm6i98ITem6kqw7ApO7XPXBOhe/Z5OdOp\n"
        + "ouBnQMcxgo9CqOKSqfJ9YoYdOrTxve/SiO0AHjEKaDLph8GsPynGEHftr9uRZm9H\n"
        + "qn08QjJDxtDiyn9xil+7ZMj1eNQuvKMDRTIgO4f37+JbIFRYoaZ8Zu2aRyf05Can\n"
        + "SyC6/g912iOgr3NS1JQuAQAe5+lAZrLgi3EAW3S4mjFJCfJpBngzC+wIuzJTFxCA\n"
        + "wsA+PmQtPE1g8c+L24cZxfPzT0BedYH1jbu+HSz2VbUTbVUCAwEAAaNTMFEwHQYD\n"
        + "VR0OBBYEFJ4qKfHGlmX+d/aJQBMFLs6jiEWUMB8GA1UdIwQYMBaAFJ4qKfHGlmX+\n"
        + "d/aJQBMFLs6jiEWUMA8GA1UdEwEB/wQFMAMBAf8wDQYJKoZIhvcNAQELBQADggEB\n"
        + "AAwPQAF56rKoGJ1d5bdAP/IqpNoRwKcUL/tbNMDxaLCV29/RvXTK5pneOB2YnyHd\n"
        + "RSUu+OBqc/KOl8f2WMmGWU+XpIHunBO9sikazAEy4TZQTob47nlI7s4x9Q3OETRm\n"
        + "S1FGeF2lLwcjD5qXrWNLKxP5ZLz7dmlk2qii6pEym1huaQy4352UY5WheS9ofTl0\n"
        + "JA4PFXhJqJLMFSrbz5IY00N3QPou99EWh9AFcaxksCOajtp7drG/VZEegDhhAGWa\n"
        + "iJHZaakLuy1uXinh9EpHxOuJ43+TmW+JN7ktlPXML0PFl+DubwDtmnux6fOdRM89\n"
        + "XyzocGB8jnk9l+9BX6qY1rU=\n"
        + "-----END CERTIFICATE-----\n";

    static void Main() {
        Console.WriteLine("=== CRYPTO & IDENTITY PROTOCOLS HARDENING TEST ===");

        // 1. Jwt & JwtToken
        Console.WriteLine("-- 1. Jwt & JwtToken --");
        string secret = "prod_secret_key_2026_enterprise";
        string jwt = Jwt.CreateHs256("{\"sub\":\"dev_user\",\"role\":\"sec_admin\"}", secret, secret.Length);
        JwtToken tok = Jwt.ParseHs256(jwt, secret, secret.Length, 0L, "", "");
        Console.WriteLine("Jwt Valid: " + Convert.ToString(tok.IsValid()));
        Console.WriteLine("Jwt Error: " + tok.Error());
        Console.WriteLine("Jwt Payload: " + tok.PayloadJson());

        // 2. Otp (TOTP)
        Console.WriteLine("-- 2. Otp --");
        string key = "12345678901234567890";
        string totp = Otp.Totp(key, 20, 1234567890L, 30, 6, Otp.SHA1);
        bool totpOk = Otp.VerifyTotp(key, 20, 1234567890L, 30, 6, Otp.SHA1, totp, 1);
        Console.WriteLine("Totp: " + totp + ", Valid: " + Convert.ToString(totpOk));

        // 3. Hkdf
        Console.WriteLine("-- 3. Hkdf --");
        byte[] salt = new byte[] { 10, 20, 30, 40 };
        byte[] ikm = new byte[] { 50, 60, 70, 80 };
        byte[] prk = Hkdf.Extract(salt, ikm);
        byte[] info = new byte[] { 90, 100 };
        byte[] okm = Hkdf.Expand(prk, info, 32);
        Console.WriteLine("Hkdf OKM length: " + Convert.ToString(okm.Length));

        // 4. Bits
        Console.WriteLine("-- 4. Bits --");
        int rotl = Bits.Rotl32(0x12345678, 4);
        int rotr = Bits.Rotr32(0x12345678, 4);
        Console.WriteLine("Bits Rotl32 ok: " + Convert.ToString(rotl == 0x23456781));
        Console.WriteLine("Bits Rotr32 ok: " + Convert.ToString(rotr == (int)0x81234567));

        // 5. Protected
        Console.WriteLine("-- 5. Protected --");
        Protected p = Protected.Of(100);
        p.Add(250);
        Console.WriteLine("Protected Val: " + Convert.ToString(p.Get()));

        // 6. Curve25519
        Console.WriteLine("-- 6. Curve25519 --");
        byte[] priv = new byte[32];
        for (int i = 0; i < 32; i = i + 1) { priv[i] = 1; }
        byte[] pub = Curve25519.GetPublicKey(priv);
        Console.WriteLine("Curve25519 Pub length: " + Convert.ToString(pub.Length));

        // 7. Sm2 & BigInt
        Console.WriteLine("-- 7. Sm2 & BigInt --");
        BigInt d = BigInt.FromBytesBE(new byte[] { 1, 2, 3, 4, 5 }, 5);
        List<BigInt> pubPoint = Sm2.PublicKey(d);
        Console.WriteLine("Sm2 pubPoint coordinates: " + Convert.ToString(pubPoint.Count));

        // 8. Ecdsa
        Console.WriteLine("-- 8. Ecdsa --");
        byte[] d32 = new byte[32];
        for (int i = 0; i < 32; i = i + 1) { d32[i] = 2; }
        byte[] p256Pub = Ecdsa.PublicKeyOf(d32);
        if (p256Pub != null) {
            bool p256Valid = Ecdsa.ValidPublicKey(p256Pub, p256Pub.Length);
            Console.WriteLine("Ecdsa ValidPublicKey: " + Convert.ToString(p256Valid));
        } else {
            Console.WriteLine("Ecdsa ValidPublicKey: false");
        }

        // 9. X509Certificate
        Console.WriteLine("-- 9. X509Certificate --");
        X509Certificate cert = X509Certificate.FromPem(TEST_CERT);
        if (cert != null) {
            Console.WriteLine("Cert SubjectCN: " + cert.SubjectCN());
            Console.WriteLine("Cert IssuerCN: " + cert.IssuerCN());
            Console.WriteLine("Cert CanSign: " + Convert.ToString(cert.CanSignCertificates()));
        } else {
            Console.WriteLine("Cert is null");
        }
    }
}
