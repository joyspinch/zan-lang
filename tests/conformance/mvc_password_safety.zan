using System;
using Zan.Web.Security;
using Zan.Web.Core;

class Program {
    static int failures = 0;

    static void Check(bool valid, string name) {
        Console.WriteLine((valid ? "ok " : "FAIL ") + name);
        if (!valid) { failures = failures + 1; }
    }

    static string Repeat(string text, int count) {
        StringBuilder value = new StringBuilder();
        for (int i = 0; i < count; i = i + 1) { value.Append(text); }
        return value.ToString();
    }

    static int Main() {
        Cfg.Auth.iter = 1000;
        string stored = AuthUser.NewHash("password");
        Check(stored.StartsWith("pbkdf2$1000$"), "new credentials use PBKDF2");
        Check(AuthUser.Verify("password", stored), "PBKDF2 credential accepted");
        Check(!AuthUser.Verify("wrong", stored), "wrong password rejected");
        string longPassword = Repeat("p", 128);
        string longStored = AuthUser.NewHash(longPassword);
        Check(AuthUser.Verify(longPassword, longStored), "long PBKDF2 password accepted safely");
        string emptyStored = AuthUser.NewHash("");
        Check(AuthUser.Verify("", emptyStored) && !AuthUser.Verify("x", emptyStored),
            "empty PBKDF2 password verifies deterministically");
        Check(!AuthUser.Verify("password", "97f447b1840b10223230ec1aba68065c5698106286283c0ec292ad0f4383755e"),
            "non-pbkdf2 digest rejected");
        Check(!AuthUser.Verify("password", "pbkdf2$1000$onlysalt"),
            "malformed pbkdf2 payload rejected");
        Check(!AuthUser.Verify("password", "pbkdf2$0$0123456789abcdef$97f447b1840b10223230ec1aba68065c5698106286283c0ec292ad0f4383755e"),
            "zero-iteration pbkdf2 payload rejected");
        Console.WriteLine("failures=" + Convert.ToString(failures));
        return failures;
    }
}
