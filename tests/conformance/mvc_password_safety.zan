using System;
using Zan.Web.Security;
using Zan.Web.Core;

class Program {
    static int failures = 0;

    static void Check(bool valid, string name) {
        Console.WriteLine((valid ? "ok " : "FAIL ") + name);
        if (!valid) { failures = failures + 1; }
    }

    static string Repeat(string text, int count) {
        StringBuilder value = new StringBuilder();
        for (int i = 0; i < count; i = i + 1) { value.Append(text); }
        return value.ToString();
    }

    static int Main() {
        // Independently generated SHA-256 chain vectors pin the historical
        // salt:password:salt first round and all 12000 rounds. The long vector
        // exceeds both the former allocation and the later-round message size.
        string salt = "0123456789abcdef0123456789abcdef";
        string stored = "97f447b1840b10223230ec1aba68065c5698106286283c0ec292ad0f4383755e";
        Check(AuthUser.PasswordHash("password", salt) == stored, "legacy digest compatibility");
        Check(AuthUser.Verify("password", salt, stored), "stored legacy credential accepted");
        Check(!AuthUser.Verify("wrong", salt, stored), "wrong legacy password rejected");
        string longPassword = Repeat("p", 128);
        string longSalt = Repeat("s", 96);
        string longHash = "94af65e4e26dd67686dbe13366f0cd0bf9a223d21e69eae53770ac93108b8221";
        Check(AuthUser.Verify(longPassword, longSalt, longHash), "long legacy password and salt accepted safely");
        Check(AuthUser.Verify("", "s", "c4cc31f8a60dee8969e6ef3c2191fff5043923fd6e8260454afcef261c6c1841"),
            "short first round retains later round capacity");
        Check(!AuthUser.Verify("password", "", stored), "missing legacy salt rejected");
        Cfg.Auth.iter = 1000;
        string upgraded = AuthUser.NewHash(longPassword);
        Check(upgraded.StartsWith("pbkdf2$1000$"), "new credentials use PBKDF2");
        Check(AuthUser.Verify(longPassword, "", upgraded), "migrated password verifies without legacy salt");
        Check(!AuthUser.Verify("wrong", longSalt, upgraded), "wrong migrated password rejected");
        Console.WriteLine("failures=" + Convert.ToString(failures));
        return failures;
    }
}
