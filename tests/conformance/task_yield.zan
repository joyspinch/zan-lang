using System;

/* 底层系统交互与数据协议契约 */
class Program {
    static async int SumAfterYields() {
        int sum = 0;
        for (int i = 0; i < 1000; i = i + 1) {
            await Task.Yield();
            sum = sum + 1;
        }
        return sum;
    }

    static async void Main() {
        Console.WriteLine("sum=" + Convert.ToString(await SumAfterYields()));
        Console.WriteLine("done");
    }
}
