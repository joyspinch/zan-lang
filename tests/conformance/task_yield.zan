using System;

/* `await Task.Yield()` requeues the frame at the tail of the driver's ready
 * queue and returns; the resume block re-enters from the queue. The
 * 1000-iteration loop stresses the slot save/reload around each suspension:
 * a local live across the yield must round-trip through the heap frame (the
 * stack-alloca class of bug from B-ID19 would show up here as a stuck or
 * garbage count). */
class Program {
    static async int SumAfterYields() {
        int sum = 0;
        for (int i = 0; i < 1000; i = i + 1) {
            await Task.Yield();
            sum = sum + 1;
        }
        return sum;
    }

    static async void Main() {
        Console.WriteLine("sum=" + Convert.ToString(await SumAfterYields()));
        Console.WriteLine("done");
    }
}
