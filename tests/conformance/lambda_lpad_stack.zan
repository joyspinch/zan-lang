using System;
using System.Collections.Generic;

delegate void Job();

/// E3090 回归锁：lambda 函数体 emit 必须切换 lpad 栈（宿主方法级 lpad
/// entry 不许滞留）。宿主方法含 ARC/boxed 局部 + lambda 体内 try/finally
/// （无 catch）+ invoke 调用时，landing pad 的异常传播兜底会清
/// lpad_stack[0]；修复前栈上是宿主 entry，在 lambda 函数的 builder 里
/// load/store 宿主 alloca——跨函数 IR 引用，LLVM verification 拒绝。
/// 运行期顺带验证：lambda 内 finally 的正常/异常两条路径都执行。
class Program {
    static void Main() {
        string cap = "cap";
        List<string> log = new List<string>();
        Job j = () => {
            try { cap = cap + "!"; Console.WriteLine("try:" + cap); }
            finally { log.Add("fin"); }
        };
        j();
        foreach (string s in log) Console.WriteLine(s);

        Job bad = () => {
            try { Thrower(); }
            finally { Console.WriteLine("fin-bad"); }
        };
        try { bad(); }
        catch (Boom e) { Console.WriteLine("caught:" + e.Message); }
        Console.WriteLine("done");
    }

    static void Thrower() {
        throw new Boom("boom");
    }
}

class Boom : Exception {
    public Boom(string m) : base(m) { }
}
