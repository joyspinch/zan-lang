using System;
using System.Numerics;
using System.Runtime.Intrinsics;

namespace ConformanceTests;

class Program {
    static void Main() {
        TestBitOperations();
        TestVector2();
        TestVector3();
        TestVector4();
        TestMatrix4x4();
        TestSIMDIntrinsics();
        Console.WriteLine("ALL NUMERICS TESTS PASSED");
    }

    static void TestBitOperations() {
        int val = 0b101100;
        int lowest = BitOperations.ExtractLowestSetBit(val);
        if (lowest != 4) {
            Console.WriteLine("FAIL: ExtractLowestSetBit");
        }

        int cleared = BitOperations.ResetLowestSetBit(val);
        if (cleared != 0b101000) {
            Console.WriteLine("FAIL: ResetLowestSetBit");
        }

        long val64 = 0x800000000L;
        long lowest64 = BitOperations.ExtractLowestSetBit(val64);
        if (lowest64 != 0x800000000L) {
            Console.WriteLine("FAIL: ExtractLowestSetBit 64");
        }

        Console.WriteLine("OK: BitOperations");
    }

    static void TestVector2() {
        Vector2 a = new Vector2(3.0f, 4.0f);
        Vector2 b = new Vector2(1.0f, 2.0f);

        Vector2 sum = Vector2.Add(a, b);
        if (sum.X != 4.0f || sum.Y != 6.0f) {
            Console.WriteLine("FAIL: Vector2 Add");
        }

        Vector2 diff = Vector2.Subtract(a, b);
        if (diff.X != 2.0f || diff.Y != 2.0f) {
            Console.WriteLine("FAIL: Vector2 Subtract");
        }

        float dot = Vector2.Dot(a, b);
        if (dot != 11.0f) {
            Console.WriteLine("FAIL: Vector2 Dot");
        }

        float len = a.Length();
        if (len < 4.99f || len > 5.01f) {
            Console.WriteLine("FAIL: Vector2 Length");
        }

        Vector2 norm = Vector2.Normalize(a);
        if (norm.Length() < 0.99f || norm.Length() > 1.01f) {
            Console.WriteLine("FAIL: Vector2 Normalize");
        }

        Console.WriteLine("OK: Vector2");
    }

    static void TestVector3() {
        Vector3 a = new Vector3(1.0f, 0.0f, 0.0f);
        Vector3 b = new Vector3(0.0f, 1.0f, 0.0f);

        Vector3 cross = Vector3.Cross(a, b);
        if (cross.X != 0.0f || cross.Y != 0.0f || cross.Z != 1.0f) {
            Console.WriteLine("FAIL: Vector3 Cross");
        }

        Vector3 v = new Vector3(2.0f, 3.0f, 6.0f);
        float len = v.Length();
        if (len < 6.99f || len > 7.01f) {
            Console.WriteLine("FAIL: Vector3 Length");
        }

        Vector3 lerped = Vector3.Lerp(Vector3.Zero, Vector3.One, 0.5f);
        if (lerped.X != 0.5f || lerped.Y != 0.5f || lerped.Z != 0.5f) {
            Console.WriteLine("FAIL: Vector3 Lerp");
        }

        Console.WriteLine("OK: Vector3");
    }

    static void TestVector4() {
        Vector4 a = new Vector4(1.0f, 2.0f, 3.0f, 4.0f);
        Vector4 b = new Vector4(2.0f, 2.0f, 2.0f, 2.0f);

        Vector4 scaled = Vector4.Multiply(a, 2.0f);
        if (scaled.X != 2.0f || scaled.Y != 4.0f || scaled.Z != 6.0f || scaled.W != 8.0f) {
            Console.WriteLine("FAIL: Vector4 Multiply scalar");
        }

        float dot = Vector4.Dot(a, b);
        if (dot != 20.0f) {
            Console.WriteLine("FAIL: Vector4 Dot");
        }

        Console.WriteLine("OK: Vector4");
    }

    static void TestMatrix4x4() {
        Matrix4x4 trans = Matrix4x4.CreateTranslation(10.0f, 20.0f, 30.0f);
        Vector3 pt = new Vector3(1.0f, 2.0f, 3.0f);
        Vector3 transformed = Matrix4x4.Transform(pt, trans);
        if (transformed.X != 11.0f || transformed.Y != 22.0f || transformed.Z != 33.0f) {
            Console.WriteLine("FAIL: Matrix4x4 Transform Translation");
        }

        Matrix4x4 scale = Matrix4x4.CreateScale(2.0f);
        Vector3 scaledPt = Matrix4x4.Transform(pt, scale);
        if (scaledPt.X != 2.0f || scaledPt.Y != 4.0f || scaledPt.Z != 6.0f) {
            Console.WriteLine("FAIL: Matrix4x4 Transform Scale");
        }

        Matrix4x4 combined = Matrix4x4.Multiply(scale, trans);
        Vector3 finalPt = Matrix4x4.Transform(pt, combined);
        if (finalPt.X != 12.0f || finalPt.Y != 24.0f || finalPt.Z != 36.0f) {
            Console.WriteLine("FAIL: Matrix4x4 Multiply Combined");
        }

        Console.WriteLine("OK: Matrix4x4");
    }

    static void TestSIMDIntrinsics() {
        Vector128 v1 = Vector128.Create(0x0102030405060708L, 0x090A0B0C0D0E0F10L);
        Vector128 v2 = Vector128.Create(0x0102030405060708L, 0x090A0B0C0D0E0F10L);

        Vector128 eq = Vector128.Equals(v1, v2);
        int mask = Vector128.ExtractMostSignificantBits(eq);
        if (mask != 0xFFFF) {
            Console.WriteLine("FAIL: Vector128 Equals / ExtractMostSignificantBits: " + mask.ToString());
        }

        Vector128 xorRes = Vector128.Xor(v1, v2);
        if (xorRes.Low != 0 || xorRes.High != 0) {
            Console.WriteLine("FAIL: Vector128 Xor");
        }

        Console.WriteLine("OK: SIMDIntrinsics");
    }
}
