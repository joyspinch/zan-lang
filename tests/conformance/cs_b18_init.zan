// 核心契约与语义定义。
class Point {
    public int X { get; init; }
    public int Y { get; init; }
    public Point(int x, int y) { X = x; Y = y; }
}
readonly struct R {
    public int V;
    public int Get() { return V * 2; }
}
ref struct S {
    public int W;
}
class Program {
    static void Main() {
        Point p = new Point { X = 5, Y = 6 };
        Console.WriteLine(p.X);
        Console.WriteLine(p.Y);
        Point q = new Point(7, 8);
        Console.WriteLine(q.X);
        Console.WriteLine(q.Y);
        R r = new R();
        r.V = 21;
        Console.WriteLine(r.Get());
        S s = new S();
        s.W = 4;
        Console.WriteLine(s.W);
    }
}
