using System;

class ReplacementError : Exception {
    public ReplacementError() : base("replacement") { }
}

class FinallyReplacement {
    static int attempts;

    static void Check(bool value) {
        if (!value) { throw new Exception("finally replacement assertion"); }
    }

    static async int Run() {
        try { return 17; }
        finally {
            await Task.Yield();
            attempts = attempts + 1;
            throw new ReplacementError();
        }
    }

    static async int Outer() {
        try {
            try { return 23; }
            finally {
                await Task.Yield();
                attempts = attempts + 1;
                throw new ReplacementError();
            }
        } catch (ReplacementError error) {
            Check(error.Message == "replacement");
            await Task.Yield();
            return 29;
        }
    }

    static async void Main() {
        bool caught = false;
        try { await Run(); }
        catch (ReplacementError error) {
            Check(error.Message == "replacement");
            caught = true;
        }
        Check(caught && attempts == 1);
        Check(await Outer() == 29);
        Check(attempts == 2);
        Console.WriteLine("finally replacement ok");
    }
}
