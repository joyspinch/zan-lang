using System;
using System.Collections.Generic;
using System.Json;
using System.Linq;

namespace ConformanceTests;

// 1. GenJson 属性增强实体
public class ModernUser {
    [JsonProperty("user_id")]
    public int id;

    [JsonProperty("user_name")]
    [JsonDefault("anonymous")]
    public string name;

    [JsonIgnore]
    public string internalSecret;

    [JsonDefault(true)]
    public bool active;
}

public class Program {
    static void Main() {
        TestGenJsonFeatures();
        TestReadOnlySpanSlicing();
        TestValueEnumerablePipeline();
        TestWeakReferenceAndNullable();
        Console.WriteLine("ALL MODERN SUITE TESTS PASSED");
    }

    static void TestGenJsonFeatures() {
        // 反序列化：测试属性重命名、默认值填充和忽略属性
        string inputJson = "{\"user_id\":1001,\"internalSecret\":\"should_ignore\"}";
        ModernUser u = Json.Deserialize<ModernUser>(inputJson);
        if (u.id != 1001) {
            Console.WriteLine("FAIL: u.id=" + Convert.ToString(u.id));
        }
        if (u.name != "anonymous") {
            Console.WriteLine("FAIL: u.name=" + u.name);
        }
        if (u.active != true) {
            Console.WriteLine("FAIL: u.active");
        }
        if (u.internalSecret != null && u.internalSecret.Length > 0) {
            Console.WriteLine("FAIL: u.internalSecret not ignored");
        }

        // 序列化：输出应使用 user_id 和 user_name，且不包含 internalSecret
        u.name = "alice";
        u.internalSecret = "confidential";
        string serialized = Json.Serialize<ModernUser>(u);
        if (!serialized.Contains("\"user_id\":1001")) {
            Console.WriteLine("FAIL: serialized user_id missing");
        }
        if (!serialized.Contains("\"user_name\":\"alice\"")) {
            Console.WriteLine("FAIL: serialized user_name missing");
        }
        if (serialized.Contains("internalSecret") || serialized.Contains("confidential")) {
            Console.WriteLine("FAIL: serialized contains ignored internalSecret");
        }
        Console.WriteLine("GenJson features: OK");
    }

    static void TestReadOnlySpanSlicing() {
        string text = "Zan-Modern-Language-AOT";
        ReadOnlySpan<char> span = text.AsSpan(4, 6);
        if (span.Length != 6) {
            Console.WriteLine("FAIL: span.Length=" + Convert.ToString(span.Length));
        }
        if (span[0] != 'M' || span[5] != 'n') {
            Console.WriteLine("FAIL: span chars");
        }
        ReadOnlySpan<char> sub = span.Slice(0, 3);
        if (sub.Length != 3 || sub[0] != 'M' || sub[2] != 'd') {
            Console.WriteLine("FAIL: span.Slice");
        }
        Console.WriteLine("ReadOnlySpan: OK");
    }

    static void TestValueEnumerablePipeline() {
        List<int> numbers = new List<int>();
        for (int i = 1; i <= 10; i = i + 1) {
            numbers.Add(i);
        }

        // 零堆分配值流水线过滤
        int evensSum = 0;
        foreach (var x in numbers.AsValueEnumerable().Where(n => n % 2 == 0)) {
            evensSum = evensSum + x;
        }
        if (evensSum != 30) {
            Console.WriteLine("FAIL: evensSum=" + Convert.ToString(evensSum));
        }

        // Any 与 All
        bool hasTen = numbers.AsValueEnumerable().Any(n => n == 10);
        bool allPositive = numbers.AsValueEnumerable().All(n => n > 0);
        if (!hasTen || !allPositive) {
            Console.WriteLine("FAIL: Any/All test");
        }
        Console.WriteLine("ValueEnumerable: OK");
    }

    static void TestWeakReferenceAndNullable() {
        // Nullable 测试
        int? valSome = 42;
        int? valNone = null;

        if (valSome.GetValueOrDefault(0) != 42) {
            Console.WriteLine("FAIL: valSome");
        }
        if (valNone.GetValueOrDefault(99) != 99) {
            Console.WriteLine("FAIL: valNone");
        }

        // WeakReference 测试
        ModernUser user = new ModernUser();
        user.name = "bob";
        WeakReference<ModernUser> weakRef = new WeakReference<ModernUser>(user);
        if (!weakRef.IsAlive) {
            Console.WriteLine("FAIL: weakRef should be alive");
        }
        ModernUser target = weakRef.Target;
        if (target == null || target.name != "bob") {
            Console.WriteLine("FAIL: weakRef target invalid");
        }
        Console.WriteLine("WeakReference & Nullable: OK");
    }
}
