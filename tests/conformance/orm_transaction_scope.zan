using System;
using System.Data;
using System.Data.Orm;

// 模拟测试用连接，完整实现 IDbConnection 契约
class MockDbConnection : IDbConnection {
    public int txCount;
    public int commitCount;
    public int rollbackCount;
    public bool isClosed;

    public MockDbConnection() {
        this.txCount = 0;
        this.commitCount = 0;
        this.rollbackCount = 0;
        this.isClosed = false;
    }

    public bool IsConnected() { return !this.isClosed; }
    public void Open() { }
    public void Close() { this.isClosed = true; }
    public void Dispose() { this.Close(); }

    public void BeginTransaction() {
        this.txCount = this.txCount + 1;
    }

    public void Commit() {
        this.commitCount = this.commitCount + 1;
    }

    public void Rollback() {
        this.rollbackCount = this.rollbackCount + 1;
    }

    public async bool BeginTransactionAsync() {
        this.txCount = this.txCount + 1;
        return true;
    }

    public async bool CommitAsync() {
        this.commitCount = this.commitCount + 1;
        return true;
    }

    public async bool RollbackAsync() {
        this.rollbackCount = this.rollbackCount + 1;
        return true;
    }

    public int Execute(string sql, DbParams ps) { return 1; }
    public int Execute(string sql) { return 1; }
    public async int ExecuteAsync(string sql, DbParams ps) { return 1; }
    public async int ExecuteAsync(string sql) { return 1; }

    public DbResult Query(string sql, DbParams ps) { return new DbResult(); }
    public DbResult Query(string sql) { return new DbResult(); }
    public async DbResult QueryAsync(string sql, DbParams ps) { return new DbResult(); }
    public async DbResult QueryAsync(string sql) { return new DbResult(); }

    public string ExecuteScalar(string sql) { return ""; }
    public string ExecuteScalar(string sql, DbParams prms) { return ""; }
    public async string ExecuteScalarAsync(string sql) { return ""; }
    public async string ExecuteScalarAsync(string sql, DbParams prms) { return ""; }

    public int GetProvider() { return 1; }
}

class Program {
    static async Task RunSuite() {
        Console.WriteLine("[1] Testing TransactionScope auto rollback on no Complete()...");
        MockDbConnection conn1 = new MockDbConnection();
        TransactionScope scope1 = new TransactionScope(conn1);
        // 不调用 scope1.Complete()
        scope1.Dispose();
        if (conn1.txCount == 1 && conn1.rollbackCount == 1 && conn1.commitCount == 0) {
            Console.WriteLine("PASS: auto rollback verified");
        } else {
            Console.WriteLine("FAIL: unexpected counts: tx=" + Convert.ToString(conn1.txCount)
                + " rollback=" + Convert.ToString(conn1.rollbackCount)
                + " commit=" + Convert.ToString(conn1.commitCount));
        }

        Console.WriteLine("[2] Testing TransactionScope commit on Complete()...");
        MockDbConnection conn2 = new MockDbConnection();
        TransactionScope scope2 = new TransactionScope(conn2);
        scope2.Complete();
        scope2.Dispose();
        if (conn2.txCount == 1 && conn2.rollbackCount == 0 && conn2.commitCount == 1) {
            Console.WriteLine("PASS: commit on complete verified");
        } else {
            Console.WriteLine("FAIL: unexpected counts: tx=" + Convert.ToString(conn2.txCount)
                + " rollback=" + Convert.ToString(conn2.rollbackCount)
                + " commit=" + Convert.ToString(conn2.commitCount));
        }

        Console.WriteLine("[3] Testing manual Rollback()...");
        MockDbConnection conn3 = new MockDbConnection();
        TransactionScope scope3 = new TransactionScope(conn3);
        scope3.Rollback();
        scope3.Dispose();
        if (conn3.rollbackCount == 1 && conn3.commitCount == 0) {
            Console.WriteLine("PASS: manual rollback verified");
        } else {
            Console.WriteLine("FAIL: unexpected counts for manual rollback");
        }

        Console.WriteLine("[4] Testing async transaction scope commit and rollback...");
        MockDbConnection conn4 = new MockDbConnection();
        TransactionScope scope4 = new TransactionScope(conn4);
        await scope4.CommitAsync();
        if (conn4.commitCount == 1) {
            Console.WriteLine("PASS: async commit verified");
        } else {
            Console.WriteLine("FAIL: async commit failed");
        }

        MockDbConnection conn5 = new MockDbConnection();
        TransactionScope scope5 = new TransactionScope(conn5);
        await scope5.RollbackAsync();
        if (conn5.rollbackCount == 1) {
            Console.WriteLine("PASS: async rollback verified");
        } else {
            Console.WriteLine("FAIL: async rollback failed");
        }

        Console.WriteLine("OK: all transaction scope tests passed!");
    }

    static async void Main() {
        await Program.RunSuite();
    }
}
