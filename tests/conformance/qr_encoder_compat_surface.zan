using System;
using Gui.Widget;

namespace Conf;

// `Gui.Widget.QrEncoder` 的兼容面契约。
//
// 编码器实现在抽包到 System.Barcode（Zan.Barcode 包）时，本类上
// **无修饰符**的静态成员被一起删掉了——而 Zan 里"无修饰符"= 默认跨包
// 可访问（只有 private/protected/internal 才拦），它们一直是外部项目的
// 既成公开面：仓库自己的 gui-design 文档与外部项目都直接调
// `QrEncoder.SeqByteLen(s[i] & 255)` 逐字节走 UTF-8 宽度。抽包让老代码
// 编译失败，而"改用 using System.Barcode"会在同时 using Gui.Widget 时
// 撞名（两个 QrEncoder）。
//
// 这里锁住：只用 `using Gui.Widget` 时兼容面仍在，且行为不变。
class Program {
    static void Main() {
        // UTF-8 首字节 -> 码点字节长度。
        Console.WriteLine("ascii=" + Convert.ToString(QrEncoder.SeqByteLen(65)));
        Console.WriteLine("two=" + Convert.ToString(QrEncoder.SeqByteLen(195)));
        Console.WriteLine("three=" + Convert.ToString(QrEncoder.SeqByteLen(229)));
        Console.WriteLine("four=" + Convert.ToString(QrEncoder.SeqByteLen(240)));

        // 字符分类：数字？字母数字表里的值？不在表内时 -1。
        Console.WriteLine("numeric=" + Convert.ToString(QrEncoder.IsNumeric(53) ? 1 : 0));
        Console.WriteLine("alnum0=" + Convert.ToString(QrEncoder.AlnumValueByte(48)));
        Console.WriteLine("alnumA=" + Convert.ToString(QrEncoder.AlnumValueByte(65)));
        Console.WriteLine("alnumSpace=" + Convert.ToString(QrEncoder.AlnumValueByte(32)));
        Console.WriteLine("alnumBad=" + Convert.ToString(QrEncoder.AlnumValueByte(33)));

        // 模式判定：MODE_NUMERIC=1 / MODE_ALNUM=2 / MODE_BYTE=4。
        Console.WriteLine("modeNum=" + Convert.ToString(QrEncoder.ModeOfByte(53, "5", 0)));
        Console.WriteLine("modeAlnum=" + Convert.ToString(QrEncoder.ModeOfByte(65, "A", 0)));
        Console.WriteLine("modeByte=" + Convert.ToString(QrEncoder.ModeOfByte(229, "中", 0)));

        // 老代码的用法：逐字节走 UTF-8 宽度算**字数**（string.Length 是
        // 字节数，中文一字三字节）。
        string name = "剑侠";
        int n = 0;
        int i = 0;
        while (i < name.Length) {
            i = i + QrEncoder.SeqByteLen(name[i] & 255);
            n = n + 1;
        }
        Console.WriteLine("bytes=" + Convert.ToString(name.Length));
        Console.WriteLine("chars=" + Convert.ToString(n));
    }
}
