using System;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.IO;

[Table(Name = "sync_all_a")]
class SyncAllA {
    [Column(IsIdentity = true)]
    int id;
    string name;
}

[Table(Name = "sync_all_b")]
class SyncAllB {
    [Column(IsIdentity = true)]
    int id;
    int count;
}

class Program {
    static void Main() {
        string path = "orm_sync_all.tmp.db";
        File.Delete(path);
        SqliteConnection db = SqliteConnection.Open(path);
        db.SyncStructureAll();

        SyncAllA a = new SyncAllA();
        a.name = "first";
        SyncAllB b = new SyncAllB();
        b.count = 7;
        db.Insert<SyncAllA>(a).ExecuteAffrows();
        db.Insert<SyncAllB>(b).ExecuteAffrows();

        Console.WriteLine("a=" + Convert.ToString(db.Select<SyncAllA>().Count()));
        Console.WriteLine("b=" + Convert.ToString(db.Select<SyncAllB>().Count()));
        db.Close();
        File.Delete(path);
    }
}
