using System;
using System.Net;

namespace Conf;

class Prog {
    static int Run() {
        int bad = 0;

        PingReply reply = Ping.Send("127.0.0.1", 2000);
        if (!reply.IsSuccess()) { bad = bad + 1; }
        if (reply.address != "127.0.0.1") { bad = bad + 1; }
        if (reply.roundtripTime < 0 || reply.dataSize != 8) { bad = bad + 1; }

        List<NetworkInterface> adapters = NetworkInterface.GetAllNetworkInterfaces();
        if (adapters.Count < 1) { bad = bad + 1; }
        bool hasLoopback = false;
        for (int i = 0; i < adapters.Count; i = i + 1) {
            NetworkInterface adapter = adapters[i];
            if (adapter.name == null || adapter.description == null
                || adapter.macAddress == null || adapter.ipAddresses == null) {
                bad = bad + 1;
            }
            if (adapter.index < 0) { bad = bad + 1; }
            for (int j = 0; j < adapter.ipAddresses.Count; j = j + 1) {
                string address = adapter.ipAddresses[j];
                if (address == null || address.Length == 0) { bad = bad + 1; }
                if (address == "127.0.0.1") { hasLoopback = true; }
            }
        }
        if (!hasLoopback) { bad = bad + 1; }
        return bad;
    }

    static void Main() {
        #if WINDOWS
        int bad = Prog.Run();
        Console.WriteLine("win-net-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
        #else
        Console.WriteLine("win-net-ok: 1");
        #endif
    }
}
