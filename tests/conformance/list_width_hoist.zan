using System;
using System.Collections.Generic;

// List<T> 窄槽宽度标签检查被提到循环前置头（list_width_hoist.cpp）之后的语义：
// 只读循环、Add 循环、嵌套循环、各种窄宽度元素，以及循环里穿插泛型
// （可能走擦除版 8 字节槽、触发 repack）的读写——结果必须与逐次检查时一致。
class Holder<T> {
    public List<T> Items = new List<T>();
    public void Push(T v) { Items.Add(v); }
    public T Get(int i) { return Items[i]; }
}

class Program {
    static void Bump<T>(List<T> l, T v) { l.Add(v); }
    static T At<T>(List<T> l, int i) { return l[i]; }

    static long SumInts(List<int> l) {
        long s = 0;
        for (int r = 0; r < 3; r = r + 1) {
            for (int i = 0; i < l.Count; i = i + 1) { s = s + l[i]; }
        }
        return s;
    }

    public static void Main() {
        List<int> li = new List<int>();
        for (int i = 0; i < 1000; i = i + 1) { li.Add(i * 3 - 700); }
        Console.WriteLine("ints " + SumInts(li).ToString());

        List<byte> lb = new List<byte>();
        for (int i = 0; i < 600; i = i + 1) { lb.Add((byte)(i & 255)); }
        int bs = 0;
        for (int i = 0; i < lb.Count; i = i + 1) { bs = bs + lb[i]; }
        Console.WriteLine("bytes " + bs.ToString());

        List<short> ls = new List<short>();
        for (int i = 0; i < 500; i = i + 1) { ls.Add((short)(i * 100 - 25000)); }
        long ss = 0;
        for (int i = 0; i < ls.Count; i = i + 1) { ss = ss + ls[i]; }
        Console.WriteLine("shorts " + ss.ToString());

        List<float> lf = new List<float>();
        for (int i = 0; i < 300; i = i + 1) { lf.Add((float)i * 0.5f); }
        double fs = 0;
        for (int i = 0; i < lf.Count; i = i + 1) { fs = fs + lf[i]; }
        Console.WriteLine("floats " + fs.ToString());

        List<bool> lbool = new List<bool>();
        for (int i = 0; i < 100; i = i + 1) { lbool.Add(i % 3 == 0); }
        int trues = 0;
        for (int i = 0; i < lbool.Count; i = i + 1) { if (lbool[i]) { trues = trues + 1; } }
        Console.WriteLine("bools " + trues.ToString());

        // 循环里穿插泛型读写：每轮都可能把槽宽改回 8 字节，下一次特化访问须重排。
        List<int> mix = new List<int>();
        long ms = 0;
        for (int i = 0; i < 200; i = i + 1) {
            mix.Add(i);
            Bump<int>(mix, -i);
            ms = ms + mix[mix.Count - 1] * 3 + At<int>(mix, mix.Count - 2) * 5 + mix[i] * (i + 1);
        }
        Console.WriteLine("mixed " + ms.ToString() + " count " + mix.Count.ToString());

        // 泛型类里建的表，回到特化代码的循环里读
        Holder<int> h = new Holder<int>();
        for (int i = 0; i < 250; i = i + 1) { h.Push(i * 7); }
        long hs = 0;
        for (int i = 0; i < h.Items.Count; i = i + 1) { hs = hs + h.Items[i] + h.Get(i); }
        Console.WriteLine("holder " + hs.ToString());

        // 嵌套：内层每轮都改外层的表
        List<int> grid = new List<int>();
        for (int r = 0; r < 20; r = r + 1) {
            for (int c = 0; c < 20; c = c + 1) { grid.Add(r * c); }
            grid[r] = grid[r] + 1;
        }
        long gs = 0;
        for (int i = 0; i < grid.Count; i = i + 1) { gs = gs + grid[i]; }
        Console.WriteLine("grid " + gs.ToString() + " " + grid.Count.ToString());
    }
}
