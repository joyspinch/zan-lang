using System;

class Owner {
    int id;
    string payload;
    int[] values;
    Owner(int value) {
        id = value;
        payload = "owner:" + value;
        values = new int[2];
        values[0] = value;
    }
}

class OwnerHost {
    Owner node;
}

class OwnerBoom : Exception {
    OwnerBoom(string message) : base(message) { }
}

class OwnerOther : Exception {
    OwnerOther(string message) : base(message) { }
}

class Program {
    static void Fail() { throw new OwnerBoom("boom"); }

    static void Leaf(OwnerHost host, Owner node) {
        Owner previous = host.node;
        Owner temporary = new Owner(3);
        host.node = node;
        try {
            Fail();
        } finally {
            host.node = previous;
            Console.WriteLine("leaf=" + host.node.id + ":" + temporary.values[0]);
        }
    }

    static void Nested(OwnerHost host, Owner node) {
        Owner previous = host.node;
        Owner temporary = new Owner(2);
        host.node = temporary;
        try {
            Leaf(host, node);
        } catch (OwnerOther ex) {
            Console.WriteLine("wrong=" + ex.Message);
        } finally {
            host.node = previous;
            Console.WriteLine("outer=" + host.node.id + ":" + temporary.id);
        }
    }

    static void SameFrame(OwnerHost host, Owner node) {
        Owner previous = host.node;
        Owner temporary = new Owner(5);
        try {
            host.node = node;
            try {
                Fail();
            } finally {
                host.node = previous;
                Console.WriteLine("same-finally=" + temporary.id);
            }
        } catch (OwnerBoom ex) {
            // Owners declared before this handler must survive propagation to it.
            Console.WriteLine("same-catch=" + previous.payload + ":" + temporary.values[0]);
        }
    }

    static void Run() {
        OwnerHost host = new OwnerHost();
        Owner outer = new Owner(1);
        Owner inner = new Owner(4);
        host.node = outer;
        try {
            Nested(host, inner);
        } catch (OwnerBoom ex) {
            Console.WriteLine("caught=" + ex.Message);
            Console.WriteLine("context=" + host.node.id);
        }
        SameFrame(host, inner);
        Console.WriteLine("after-same=" + host.node.payload);
    }

    static void Main() {
        // The leakcheck twin verifies owners and their string/array fields are released.
        Run();
        Console.WriteLine("done");
    }
}
