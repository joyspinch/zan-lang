using System;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static void Main() {
        ChartOption option = ChartOption.Of("Live", new List<string>{"A"}, new List<ChartSeries>{
            ChartSeries.Line("CPU", new List<int>{10})
        });
        ChartController model = ChartController.Of(option);
        Console.WriteLine(Convert.ToString(model.Version()) + ":" + Convert.ToString(model.Option().series[0].Count()));
        model.AppendValues(0, new List<int>{20, 30});
        Console.WriteLine(Convert.ToString(model.Version()) + ":" + Convert.ToString(model.Option().series[0].Count()) + ":" + Convert.ToString(model.Option().series[0].Value(2)));
        model.SetData(0, new List<ChartData>{ChartData.Numeric(1.25), ChartData.NamedNumber(2.5, "B")});
        Console.WriteLine(Convert.ToString(model.Version()) + ":" + Convert.ToString(model.Option().series[0].Number(0)) + ":" + model.Option().series[0].data[1].name);
        model.ClearData(0);
        Console.WriteLine(Convert.ToString(model.Version()) + ":" + Convert.ToString(model.Option().series[0].Count()));
        model.SetOption(ChartOption.Bar("Next", new List<string>{"X"}));
        Console.WriteLine(Convert.ToString(model.Version()) + ":" + model.Option().title + ":" + Convert.ToString(model.Option().defaultType));
    }
}
