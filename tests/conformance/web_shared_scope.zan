// 接口数据协议与执行契约。
// 核心契约与语义定义。
//
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
// 接口数据协议与执行契约。
using System;
using System.Net;
using System.Threading;
using System.Web;

class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            failures = failures + 1;
        }
    }

    static async bool Hello(HttpContext ctx) {
        ctx.Text("hi");
        return true;
    }

    static void Main() {
        WebApp app = new WebApp("127.0.0.1", 8099);
        Route _r = app.Get("/", Hello);

        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        app.InitShared();
        long rateHandle = app.Limiter().OsHandle();
        long lockHandle = app.Locks().OsHandle();
        Check(rateHandle != 0, "master creates the rate table before any worker");
        Check(lockHandle != 0, "master creates the lock table before any worker");

        // 接口数据协议与执行契约。
        // 接口数据协议与执行契约。
        WebApp moved = new WebApp("127.0.0.1", 9099);
        moved.InitShared();
        Check(moved.Limiter().OsHandle() != rateHandle,
            "another instance owns different memory");
        moved.Limiter().Allow("k", 5);
        Check(app.Limiter().CountOf("k") == 0,
            "the instance's counters stay separate");

        Check(Worker.InheritedHandle("WEB_RATE") == 0,
            "a process that is not a worker inherits nothing");

        // 接口数据协议与执行契约。
        RateLimiter worker = RateLimiter.Attach(rateHandle, 1000);
        Check(app.Limiter().Allow("k", 5), "the master counts a request");
        Check(worker.CountOf("k") == 1, "the worker sees the master's count");
        Check(worker.Allow("k", 5), "the worker counts one of its own");
        Check(app.Limiter().CountOf("k") == 2, "the master sees that one too");
        RateLimiter orphan = RateLimiter.Attach(0, 1000);
        Check(!orphan.Allow("k", 5),
            "no table means refuse, not run unlimited");

        LockManager workerLocks = LockManager.Attach(lockHandle);
        LockLease held = app.Locks().TryAcquire("g:GET_/");
        Check(held != null, "the master takes the lease");
        Check(workerLocks.TryAcquire("g:GET_/") == null,
            "the worker is locked out of the same key");
        app.Locks().Release(held);
        LockLease second = workerLocks.TryAcquire("g:GET_/");
        Check(second != null, "and gets it once the master lets go");
        workerLocks.Release(second);

        Console.WriteLine("failures " + Convert.ToString(failures));
    }
}
