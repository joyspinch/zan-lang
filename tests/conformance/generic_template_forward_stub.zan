// 开放泛型模板体里"真解析不到"的调用不报编译错（checker 运行期分派阀门
// checker_call_is_runtime_dispatched 与 T 接收者的既有 -1 路径，irgen 发
// 运行期转发桩同口径放行）。直接实例化模板并调用时，桩在运行期发 A494
// 软诊断到 stderr（不进本用例的 stdout golden）、返回默认值后继续执行。
using System;

class Box<T> {
    public int Hits;

    // T 接收者：成员集要等 T 落成具体类型才存在。带与不带类型实参的
    // 形状都必须编得过。
    public void Ghost(T v) {
        v.Mystery();
        v.Mystery<T>();
    }

    public int Add(int x) { Hits = Hits + x; return Hits; }
}

class Program {
    static void Main() {
        Box<int> b = new Box<int>();
        b.Ghost(42);
        int h = b.Add(1);
        Console.WriteLine(h == 1 ? "after:ok" : "after:bad");
    }
}
