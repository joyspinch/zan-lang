using System;
using Game.Net;

class Program {
    static int Main() {
        // 1. 跨平台 PMTU 二分探测（模拟移动 5G / IPv6 链路安全上限 1210B）
        NetMtuPathProber mtu = new NetMtuPathProber(1024, 1440);
        int guard = 0;
        while (!mtu.Converged && guard < 16) {
            int probe = mtu.NextProbeSize;
            mtu.ReportProbeResult(probe, probe <= 1210);
            guard = guard + 1;
        }
        bool mtuOk = mtu.Converged && mtu.SafePayloadBytes >= 1194 && mtu.SafePayloadBytes <= 1210;
        Console.WriteLine("mtu_prober_ok=" + (mtuOk ? "1" : "0"));

        // 2. 跨平台 Wi-Fi <-> 5G 无缝迁移与双路径序号去重守卫
        NetNetworkHandoverGuard ho = new NetNetworkHandoverGuard(987654321L, "192.168.1.10:5000", 5000L);
        bool seq1 = ho.AcceptPacketSequence(100);
        bool dup1 = !ho.AcceptPacketSequence(100);
        ho.BeginHandover(10000L);
        bool badTok = !ho.TryMigrateEndpoint(11000L, 111111L, "10.0.0.5:6000");
        bool goodMig = ho.TryMigrateEndpoint(12000L, 987654321L, "[2409::1]:6001");
        bool seq2 = ho.AcceptPacketSequence(101);
        bool hoOk = seq1 && dup1 && badTok && goodMig && seq2
            && ho.ActiveEndpoint == "[2409::1]:6001" && ho.HandoverCount == 1;
        Console.WriteLine("handover_guard_ok=" + (hoOk ? "1" : "0"));

        // 3. 跨平台键鼠/手柄/触屏输入确定性归一化 [-1000, 1000]
        CrossPlatformInputNormalizer norm = new CrossPlatformInputNormalizer(0.20f, 2.0f);
        int deadX; int deadY;
        norm.NormalizeStickToFixed1000(0.10f, 0.10f, out deadX, out deadY); // 半径 0.141 < 0.20 -> 死区归零
        int midX; int midY;
        norm.NormalizeStickToFixed1000(0.60f, 0.0f, out midX, out midY); // (0.6-0.2)/0.8 = 0.5 -> 0.5^2 = 0.25 -> 250
        int diagX; int diagY;
        norm.NormalizeDigitalKeysToFixed1000(false, true, false, true, out diagX, out diagY); // 对角线归一 707, 707
        bool normOk = deadX == 0 && deadY == 0 && midX == 250 && midY == 0 && diagX == 707 && diagY == 707;
        Console.WriteLine("input_norm_ok=" + (normOk ? "1" : "0"));
        return 0;
    }
}
