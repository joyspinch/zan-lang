using System;

// 静态全常量数组折叠用例（G8 第一轮）：`static T[] f = new long[]{...}`
// 全字面量元素在 gen1 折叠为 internal global 初始化器，而不是在 main
// 里逐元素 GEP+store 展开。global 用可变 `global`（非 constant）——
// 静态数组运行期可变异，变异写 .data 必须合法。本用例同时锁住：
// 读回逐元素一致、foreach 遍历、变异后读回、负数与宽窄整型字面量、
// bool/char 元素、空表，以及被折叠表与未折叠路径（byte[]）并存。
// 输出确定性，与 static_const_array.out 比对。
class StaticConstArrayTest {
    static long[] table1 = new long[] { 416611827777L, -1234567890123L, 7, 0, 9223372036854775807L };
    static int[] table2 = new int[] { -3, 2147483647, 0, 42 };
    static bool[] flags = new bool[] { true, false, true };
    static char[] letters = new char[] { 65, 66, 67 };
    static double[] ratios = new double[] { 1.5, -0.25, 2.0 };
    static byte[] raw = new byte[] { 1, 2, 3, 4 };
    static long[] empty = new long[] { };
    static long[] single = new long[] { 99 };

    static long Sum(long[] t) {
        long s = 0;
        for (int i = 0; i < t.Length; i = i + 1) { s = s + t[i]; }
        return s;
    }

    static long SumInts(int[] t) {
        long s = 0;
        for (int i = 0; i < t.Length; i = i + 1) { s = s + t[i]; }
        return s;
    }

    static void Main() {
        // 读回逐元素一致
        if (table1.Length != 5) { Console.WriteLine("len1 bad"); }
        Console.WriteLine(table1[0]);
        Console.WriteLine(table1[1]);
        Console.WriteLine(table1[4]);
        Console.WriteLine(Sum(table1));
        Console.WriteLine(table2[0]);
        Console.WriteLine(table2[1]);
        Console.WriteLine(SumInts(table2));

        // foreach 遍历（数组 foreach 走运行期路径，读的是同一块内存）
        long fsum = 0;
        foreach (int v in table2) { fsum = fsum + v; }
        Console.WriteLine(fsum);

        // bool/char/byte 元素
        Console.WriteLine(flags[0]);
        Console.WriteLine(flags[1]);
        Console.WriteLine(letters[0]);
        Console.WriteLine(letters[2]);
        Console.WriteLine(raw[1]);
        Console.WriteLine(raw[3]);

        // double 元素（未折叠路径与折叠路径并存的对照）
        Console.WriteLine(ratios[0]);
        Console.WriteLine(ratios[1]);

        // 空表与单元素表
        Console.WriteLine(empty.Length);
        Console.WriteLine(Sum(empty));
        Console.WriteLine(single[0]);
        Console.WriteLine(single.Length);

        // 运行期变异：折叠全局是可变 `global`，写 .data 必须合法，
        // 且静态槽是同一实例——本方法与 Helper 看到同一份
        table1[2] = -7;
        Console.WriteLine(table1[2]);
        Console.WriteLine(ReadShared());
        table1[2] = 7;
        Console.WriteLine(table1[2]);
    }

    static long ReadShared() {
        return table1[2];
    }
}
