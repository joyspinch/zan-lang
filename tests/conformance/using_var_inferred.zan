using System;
using System.Threading;

// using (var x = ...) 与局部声明同口径推断类型（此前把 var 当类型名，报 undefined type 'var'）。
// 正常路径与异常路径都调用 Dispose。
class Res : IDisposable {
    public string tag;
    public Res(string t) { tag = t; }
    public void Dispose() { Console.WriteLine("dispose " + tag); }
}

class Program {
    static void Main() {
        using (var r = new Res("a")) { Console.WriteLine("body " + r.tag); }
        using (Res r2 = new Res("b")) { Console.WriteLine("body " + r2.tag); }
        using (var a = new AtomicInt(41)) { Console.WriteLine("atomic " + a.Increment()); }
        try {
            using (var r3 = new Res("c")) { throw new Exception("x"); }
        } catch (Exception e) {
            Console.WriteLine("caught " + e.Message);
        }
    }
}
