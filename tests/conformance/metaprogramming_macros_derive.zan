using System;

macro Clamp(x, lo, hi) => (x < lo ? lo : (x > hi ? hi : x));
macro Square(v) => ((v) * (v));
macro SumSquares(a, b) => (Square!(a) + Square!(b));

macro Swap(a, b) {
    var tmp = a;
    a = b;
    b = tmp;
}

[Derive(Debug, Equatable, Clone, Hash, Default)]
struct Point {
    public int X;
    public int Y;
    public Point(int x, int y) {
        this.X = x;
        this.Y = y;
    }
}

[Derive(Debug, Equatable, Clone, Hash)]
class UserCard {
    public string Name;
    public int Level;
    public Point Origin;
    public UserCard(string name, int level, Point origin) {
        this.Name = name;
        this.Level = level;
        this.Origin = origin;
    }
}

class Program {
    static void Main() {
        static_assert!(sizeof(int) == 4 && sizeof(long) == 8 && (1 << 5) == 32, "sizes");

        // 1. Expression macros & nested macro expansion
        int c1 = Clamp!(-5, 0, 10);
        int c2 = Clamp!(7, 0, 10);
        int c3 = Clamp!(99, 0, 10);
        int ss = SumSquares!(3, 4);
        Console.WriteLine($"expr:{c1},{c2},{c3},{ss}");

        // 2. Hygienic statement macro: caller has local `tmp`, Swap! also declares `var tmp`
        int tmp = 100;
        int other = 250;
        Swap!(tmp, other);
        Console.WriteLine($"hyg:{tmp},{other}");

        // 3. Built-in compile-time macros: stringify!, concat!, file!, line!
        string s1 = stringify!(tmp + other * 2);
        string s2 = concat!("Zan-", 9, "-", true);
        string f = file!();
        int ln = line!();
        Console.WriteLine($"meta:{s1}|{s2}|{f}|{ln > 40}");

        // 4. [Derive(Debug, Equatable, Clone, Hash, Default)] on struct
        var p0 = Point.Default();
        var p1 = new Point(3, 4);
        var p2 = p1.Clone();
        var p3 = new Point(3, 5);
        Console.WriteLine($"pt:{p0.ToString()}|{p1.ToString()}|{p1 == p2}|{p1 != p3}|{p1.GetHashCode() == p2.GetHashCode()}");

        // 5. [Derive(Debug, Equatable, Clone, Hash)] on class with string + nested derived struct
        var u1 = new UserCard("Ada", 7, p1);
        var u2 = u1.Clone();
        var u3 = new UserCard("Ada", 8, p1);
        Console.WriteLine($"usr:{u1.ToString()}|{u1 == u2}|{u1 != u3}|{u1.GetHashCode() == u2.GetHashCode()}");
    }
}
