using System;
using System.Windows;

class Program {
    static int Main() {
        // 1. 久坐微拉伸卡片轮换与动作保持计时
        CompanionDeskStretchDeck deck = new CompanionDeskStretchDeck();
        deck.AddCard("neck_roll", 20);
        deck.AddCard("wrist_release", 15);
        StretchExerciseCard e1 = deck.StartNextExercise();
        bool done1 = deck.StepHoldSeconds(20);
        StretchExerciseCard e2 = deck.StartNextExercise();
        bool done2 = deck.StepHoldSeconds(15);
        bool stretchOk = e1 != null && e2 != null
            && e1.ExerciseId == "neck_roll" && e2.ExerciseId == "wrist_release"
            && done1 && done2 && deck.CompletedCount == 2;
        Console.WriteLine("desk_stretch_ok=" + (stretchOk ? "1" : "0"));

        // 2. 带断签保护盾的每日连签追踪器
        CompanionDailyLoginStreak streak = new CompanionDailyLoginStreak(1);
        int s1 = streak.CheckIn(10); // 1
        int s2 = streak.CheckIn(11); // 2
        int sDup = streak.CheckIn(11); // 同日不累加 -> 2
        int sShield = streak.CheckIn(13); // 漏签 12 日，消耗 1 盾保连签 -> 3
        int sReset = streak.CheckIn(16); // 漏签 14/15 两日且无盾 -> 重置为 1
        bool streakOk = s1 == 1 && s2 == 2 && sDup == 2 && sShield == 3
            && streak.FreezeShields == 0 && sReset == 1 && streak.BestStreak == 3;
        Console.WriteLine("login_streak_ok=" + (streakOk ? "1" : "0"));

        // 3. 跨午夜免打扰整点/半点轻柔报时器
        CompanionAmbientClockChime chime = new CompanionAmbientClockChime(true, 22, 7);
        int quietNight = chime.PollChime(23, 0);   // 免打扰 -> 0
        int quietEarly = chime.PollChime(6, 30);   // 跨午夜免打扰 -> 0
        int topHour = chime.PollChime(10, 0);      // 整点 -> 2
        int dupMuted = chime.PollChime(10, 0);     // 同分钟防重响 -> 0
        int halfHour = chime.PollChime(10, 30);    // 半点 -> 1
        bool chimeOk = quietNight == 0 && quietEarly == 0 && topHour == 2
            && dupMuted == 0 && halfHour == 1;
        Console.WriteLine("clock_chime_ok=" + (chimeOk ? "1" : "0"));
        return 0;
    }
}
