using System;

class Program {
    static void AddScaledNoAlias(noalias Span<int> dst, noalias ReadOnlySpan<int> src, int scale) {
        int n = dst.Length;
        for (int i = 0; i < n; i++) {
            dst[i] = dst[i] + src[i] * scale;
        }
    }

    static void CopyShift(Span<int> dst, ReadOnlySpan<int> src, int n) {
        for (int i = 0; i < n; i++) {
            dst[i] = src[i] + 10;
        }
    }

    static int Stencil3(ReadOnlySpan<int> s) {
        int sum = 0;
        for (int i = 0; i < s.Length - 2; i++) {
            sum = sum + s[i] + s[i + 1] + s[i + 2];
        }
        return sum;
    }

    static void DoubleScale(noalias Span<double> dst, noalias ReadOnlySpan<double> src) {
        for (int i = 0; i < dst.Length; i++) {
            dst[i] = src[i] * 2.5;
        }
    }

    static void Main() {
        int[] a = new int[16];
        int[] b = new int[16];
        for (int i = 0; i < 16; i++) {
            a[i] = i + 1;
            b[i] = (i + 1) * 2;
        }
        AddScaledNoAlias(a.AsSpan(), b.AsSpan(), 3);
        Console.WriteLine($"noalias:{a[0]},{a[7]},{a[15]}");

        // Non-overlapping CopyShift (fast versioned path)
        int[] c = new int[16];
        CopyShift(c.AsSpan(), b.AsSpan(), 16);
        Console.WriteLine($"fast:{c[0]},{c[15]}");

        // Overlapping CopyShift (must take slow sequential path: dst[i] = dst[i-1] + 10)
        int[] ov = new int[8];
        ov[0] = 1;
        CopyShift(ov.AsSpan(1, 6), ov.AsSpan(0, 6), 6);
        Console.WriteLine($"overlap:{ov[0]},{ov[1]},{ov[2]},{ov[6]}");

        // Static BCE with offset i+1, i+2
        int[] st = new int[5];
        st[0] = 1; st[1] = 2; st[2] = 3; st[3] = 4; st[4] = 5;
        Console.WriteLine($"stencil:{Stencil3(st.AsSpan())}");

        // Double alignment
        double[] da = new double[8];
        double[] db = new double[8];
        for (int i = 0; i < 8; i++) db[i] = (double)(i + 1);
        DoubleScale(da.AsSpan(), db.AsSpan());
        Console.WriteLine($"dbl:{(int)da[0]},{(int)da[3]},{(int)da[7]}");
    }
}
