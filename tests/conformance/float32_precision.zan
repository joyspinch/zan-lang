using System;

// float 是 f32：字面量、运算、槽位、强制转换都按单精度取值。
// 这条用例把"进 float 槽位要过一次单精度往返"的语义钉死——
// 自举曾把所有浮点当 double，于是 0.1f + 0.2f 的尾数多出一截，
// 比较、距离与向量检索全线偏掉。
class Program {
    static void Main() {
        float a = 0.1f;
        float b = 0.2f;
        Console.WriteLine("var=" + (a + b));
        Console.WriteLine("lit=" + (0.1f + 0.2f));
        float c = 0.1f + 0.2f;
        Console.WriteLine("slot=" + c);
        Console.WriteLine("one=" + 0.1f);
        Console.WriteLine("div=" + (1.0f / 3.0f));
        Console.WriteLine("cast=" + (double)(float)0.1);
        Console.WriteLine("mixed=" + (0.1f + 0.2));
        Console.WriteLine("sub=" + 1e-45f);
        Console.WriteLine("over=" + (3.4e38f * 2.0f));
        Console.WriteLine("exact=" + (0.1f + 0.2f == 0.30000001192092896f));
        Console.WriteLine("neq=" + (0.2 == 0.2f));
        Console.WriteLine("wide=" + (16777216.0f + 1.0f));

        float[] arr = new float[2];
        arr[0] = 0.2f;
        arr[1] = 0.1 + 0.1;
        Console.WriteLine("arr=" + arr[0] + "," + arr[1]);
    }
}
