using System;
using System.Windows;

class Program {
    static int Main() {
        // 1. 20-20-20 护眼守护器：满 20 分钟提示远眺、有限次延迟防拖延、完成 20 秒休息重置
        CompanionEyeRest202020Guard eye = new CompanionEyeRest202020Guard(1200, 20, 300, 1);
        eye.StepSeconds(1200);
        bool prompted = eye.Stage == EyeRestStage.RestPrompted && eye.RemainingRestSec == 20;
        bool snooze1 = eye.TrySnooze(); // 允许延迟 1 次（回到 900s）
        eye.StepSeconds(300);
        bool snooze2Blocked = !eye.TrySnooze(); // 第 2 次延迟拒绝
        eye.StepSeconds(20);
        bool completedOk = eye.Stage == EyeRestStage.Working && eye.CompletedRests == 1 && eye.SnoozesUsed == 0;
        Console.WriteLine("eye_rest_ok=" + ((prompted && snooze1 && snooze2Blocked && completedOk) ? "1" : "0"));

        // 2. 呼吸冥想引导器（4-7-8-0 放松节律）：自动跳过 0 秒 HoldOut 并准确计周期
        CompanionBreathingCadenceGuide breath = new CompanionBreathingCadenceGuide(4, 7, 8, 0);
        breath.StepSeconds(4);
        bool holdOk = breath.Phase == BreathingCadencePhase.HoldIn && breath.RemainingSec == 7;
        breath.StepSeconds(7);
        bool exhaleOk = breath.Phase == BreathingCadencePhase.Exhale && breath.RemainingSec == 8;
        breath.StepSeconds(8);
        bool cycleDone = breath.Phase == BreathingCadencePhase.Inhale && breath.CompletedCycles == 1;
        Console.WriteLine("breathing_guide_ok=" + ((holdOk && exhaleOk && cycleDone) ? "1" : "0"));

        // 3. 每日微目标打卡单：进度百分比与全达成庆祝
        CompanionMicroGoalChecklist list = new CompanionMicroGoalChecklist();
        int g0 = list.AddGoal("Drink water");
        int g1 = list.AddGoal("Ship feature");
        int g2 = list.AddGoal("Stretch shoulders");
        int g3 = list.AddGoal("Review PR");
        list.ToggleGoal(g0);
        list.ToggleGoal(g1);
        bool halfOk = list.CompletionPercent() == 50 && !list.AllCompletedCelebrationReady();
        list.ToggleGoal(g2);
        list.ToggleGoal(g3);
        bool fullOk = list.CompletionPercent() == 100 && list.AllCompletedCelebrationReady();
        Console.WriteLine("micro_goals_ok=" + ((halfOk && fullOk) ? "1" : "0"));
        return 0;
    }
}
