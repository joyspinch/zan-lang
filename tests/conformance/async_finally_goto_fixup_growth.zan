using System;

class FinallyGotoGrowth {
    static int visits;

    static async int Run() {
        try { goto done; }
        finally {
            await Task.Yield();
            goto a;
        a:
            visits = visits + 1;
            goto b;
        b:
            visits = visits + 1;
            goto c;
        c:
            visits = visits + 1;
            goto d;
        d:
            visits = visits + 1;
            goto e;
        e:
            visits = visits + 1;
            goto f;
        f:
            visits = visits + 1;
            goto h;
        h:
            visits = visits + 1;
            goto k;
        k:
            visits = visits + 1;
        }
    done:
        return 17;
    }

    static async void Main() {
        int result = await Run();
        if (result != 17 || visits != 8) {
            throw new Exception("finally goto fixup growth");
        }
        Console.WriteLine("finally goto fixup growth ok");
    }
}
