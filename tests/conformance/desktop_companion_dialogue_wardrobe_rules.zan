using System;
using System.Windows;

namespace Conf;

class DesktopCompanionDialogueWardrobeRulesTest {
    static void Main() {
        // 1. 前台应用情景自动规则引擎（会议静音免打扰 > 游戏降帧 > IDE 伴学加油 > Chrome 默认）
        CompanionAppContextMatcher matcher = CompanionAppContextMatcher.CreateDefaultPresets();
        CompanionAppContextRule rMeet = matcher.MatchForeground("Weekly Sync - Zoom", "chrome.exe"); // Zoom(100) 胜过 Chrome(10)
        CompanionAppContextRule rCode = matcher.MatchForeground("Main.zan - ZanIDE", "zanide.exe");
        CompanionAppContextRule rNone = matcher.MatchForeground("Notepad", "notepad.exe");
        bool rulesOk = rMeet.Category == CompanionAppCategory.Meeting && rMeet.SilentMode && rMeet.LowPowerMode
            && rCode.Category == CompanionAppCategory.Coding && rCode.BehaviorTag == "coding_cheer"
            && rNone.Category == CompanionAppCategory.General && !rNone.SilentMode;
        Console.WriteLine("companion-app-context-rules: " + Convert.ToString(rulesOk ? 1 : 0));

        // 2. 条件台词脚本引擎（跨午夜时段 22..4 + 好感度门槛 + 独立冷却 + 防复读）
        CompanionDialogueEngine dlg = new CompanionDialogueEngine();
        dlg.RegisterLine("late_care", "poke", "It is late, rest soon!", 22, 4, 2, 10, 60.0f);
        dlg.RegisterLine("poke_hi", "poke", "Hey there!", 0, 23, 0, 5, 10.0f);
        dlg.RegisterLine("poke_giggle", "poke", "Hehe!", 0, 23, 0, 5, 10.0f);

        // 凌晨 1 点、好感 3 -> 高优先级命中 late_care；5 秒后再次戳它，late_care 在 60s 冷却中 -> 切换到 poke_hi
        CompanionDialogueEntry l1 = dlg.PickLine("poke", 1, 3, 100.0f);
        CompanionDialogueEntry l2 = dlg.PickLine("poke", 1, 3, 105.0f);
        // 12 秒后 poke_hi 冷却刚过但防复读扣分 -> 自动轮换到 poke_giggle
        CompanionDialogueEntry l3 = dlg.PickLine("poke", 1, 3, 120.0f);
        bool dlgOk = l1 != null && l1.Id == "late_care"
            && l2 != null && l2.Id == "poke_hi"
            && l3 != null && l3.Id == "poke_giggle";
        Console.WriteLine("companion-dialogue-engine: " + Convert.ToString(dlgOk ? 1 : 0));

        // 3. 商业衣橱装扮管理（金币解锁、槽位顶替、命名套装一键切换与存档串输出）
        CompanionWardrobeManager wb = new CompanionWardrobeManager(150);
        wb.RegisterItem("hat_cap", "hat", "Cap", 0, true);
        wb.RegisterItem("hat_crown", "hat", "Golden Crown", 100, false);
        wb.RegisterItem("aura_star", "aura", "Star Aura", 80, false);

        bool lockedEquipRejected = !wb.Equip("hat_crown");
        bool unlockCrownOk = wb.UnlockItem("hat_crown"); // 剩余 50 金币
        bool insufficientRejected = !wb.UnlockItem("aura_star"); // 50 < 80 拒购
        wb.Equip("hat_cap");
        wb.SavePreset("casual");
        wb.Equip("hat_crown");
        wb.SavePreset("royal");
        wb.ApplyPreset("casual");
        string casualStr = wb.SerializeEquipped();
        wb.ApplyPreset("royal");
        string royalStr = wb.SerializeEquipped();

        bool wbOk = lockedEquipRejected && unlockCrownOk && insufficientRejected
            && wb.Coins == 50
            && casualStr == "hat=hat_cap"
            && royalStr == "hat=hat_crown";
        Console.WriteLine("companion-wardrobe-presets: " + Convert.ToString(wbOk ? 1 : 0));
    }
}
