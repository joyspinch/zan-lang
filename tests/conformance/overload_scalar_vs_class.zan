using System;

// A scalar argument reaching a class-typed parameter needs the implicit
// constructor conversion, which ranks below a numeric widening: with
// F(Big) and F(long), an int argument picks F(long) whatever the
// declaration order (B-ID199 round 7; Erc1155Token.BalanceOf(acct, 42)).
public class Big {
    public long v;
    public Big(long v) { this.v = v; }
}
public class C {
    public string F(string a, Big id) { return "big"; }
    public string F(string a, long id) { return "long"; }
    public string G(Big id) { return "big"; }
    public string G(long id) { return "long"; }
}
public class Program {
    public static void Main() {
        C c = new C();
        Console.WriteLine(c.G(42));
        Console.WriteLine(c.F("x", 42));
        Console.WriteLine(c.G(new Big(1)));
    }
}
