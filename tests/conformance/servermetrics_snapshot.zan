// ServerMetrics snapshot shape: pins the hand-rolled JsonValue serialization
// (ServerMetrics is on the generator bootstrap path, so SnapshotJson must not
// call Json.Serialize<T>). The key set, key order and every deterministic
// value are asserted; timing-derived fields (uptime/pid/cpu/mem) are only
// checked for presence.
using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Json;

class Program {
    static int fails;

    static void Check(bool ok, string what) {
        if (!ok) {
            Console.WriteLine("FAIL " + what);
            fails = fails + 1;
        }
    }

    static void CheckKeys(JsonValue v, List<string> want, string what) {
        Check(v.Count() == want.Count, what + " key count");
        bool ok = true;
        for (int i = 0; i < want.Count; i = i + 1) {
            if (v.KeyAt(i) != want[i]) { ok = false; }
        }
        Check(ok, what + " key order");
    }

    static int Main() {
        ServerMetrics m = ServerMetrics.Global();
        m.SlowRequestMs(10).SlowQueryMs(20).ErrorLog("", false);
        // A served request is keyed by what served it: a route by its pattern
        // (slot = Route.idx), an asset by its path (no slot). Two calls of the
        // same route are one row whatever the id in the URL was. Every duration
        // is MICROSECONDS, so these are 5ms / 12ms / 25ms against a 10ms slow
        // threshold.
        m.RecordRoute(0, "GET", "/api/a", 200, 5000);
        m.RecordRoute(1, "POST", "/api/b", 201, 12000);
        m.RecordRoute(2, "GET", "/slow", 500, 25000);
        // Nothing claimed these: counted, but never a row of their own.
        m.RecordUnmatched(404, 1000);
        m.RecordUnmatched(404, 1000);
        m.RecordError(1000, "db", "timeout");
        m.RecordQuery("select * from t where id = ?", 3000);
        m.RecordQuery("select count(*) from big", 40000);
        m.Entered();
        m.StreamClosed(3, 120);
        m.Left();

        JsonValue v = JsonValue.Parse(m.SnapshotJson());
        Check(v != null && v.IsObject(), "snapshot parses");
        Check(v.Count() == 13, "top key count");
        Check(v.KeyAt(0) == "uptime_ms" && v.KeyAt(1) == "pid" &&
              v.KeyAt(2) == "worker_id" && v.KeyAt(3) == "cpu_ms" &&
              v.KeyAt(4) == "cpu_percent" && v.KeyAt(5) == "mem_rss_bytes" &&
              v.KeyAt(6) == "requests" && v.KeyAt(7) == "queries" &&
              v.KeyAt(8) == "load" && v.KeyAt(9) == "slow_requests" &&
              v.KeyAt(10) == "slow_queries" && v.KeyAt(11) == "top_sql" &&
              v.KeyAt(12) == "top_requests", "top key order");

        JsonValue req = v.Get("requests");
        if (req == null) { Console.WriteLine("null:req"); return; }
        CheckKeys(req, new List<string> { "count", "errors", "failed", "rejected",
                  "unmatched", "total_us", "avg_us", "max_us",
                  "slow_threshold_us", "slow_count" }, "requests");
        Check(req.Int("count", -1) == 5, "requests.count");
        Check(req.Int("errors", -1) == 1, "requests.errors");
        Check(req.Int("failed", -1) == 3, "requests.failed");
        Check(req.Int("rejected", -1) == 0, "requests.rejected");
        Check(req.Int("unmatched", -1) == 2, "requests.unmatched");
        Check(req.Int("total_us", -1) == 44000, "requests.total_us");
        Check(req.Int("avg_us", -1) == 8800, "requests.avg_us");
        Check(req.Int("max_us", -1) == 25000, "requests.max_us");
        Check(req.Int("slow_threshold_us", -1) == 10000,
              "requests.slow_threshold_us");
        Check(req.Int("slow_count", -1) == 2, "requests.slow_count");

        JsonValue q = v.Get("queries");
        if (q == null) { Console.WriteLine("null:q"); return; }
        CheckKeys(q, new List<string> { "count", "total_us", "avg_us", "max_us",
                  "slow_threshold_us", "slow_count" }, "queries");
        Check(q.Int("count", -1) == 2, "queries.count");
        Check(q.Int("total_us", -1) == 43000, "queries.total_us");
        Check(q.Int("avg_us", -1) == 21500, "queries.avg_us");
        Check(q.Int("max_us", -1) == 40000, "queries.max_us");
        Check(q.Int("slow_threshold_us", -1) == 20000,
              "queries.slow_threshold_us");
        Check(q.Int("slow_count", -1) == 1, "queries.slow_count");

        JsonValue load = v.Get("load");
        if (load == null) { Console.WriteLine("null:load"); return; }
        CheckKeys(load, new List<string> { "concurrent", "peak", "streams",
                  "stream_frames", "stream_bytes" }, "load");
        Check(load.Int("concurrent", -1) == 0, "load.concurrent");
        Check(load.Int("peak", -1) == 1, "load.peak");
        Check(load.Int("streams", -1) == 0, "load.streams");
        Check(load.Int("stream_frames", -1) == 3, "load.stream_frames");
        Check(load.Int("stream_bytes", -1) == 120, "load.stream_bytes");

        JsonValue sr = v.Get("slow_requests");
        Check(sr != null && sr.IsArray() && sr.Count() == 2, "slow_requests size");
        Check(sr.At(0).Str("req", "") == "POST /api/b -> 201" &&
              sr.At(0).Int("us", -1) == 12000, "slow_requests[0]");
        Check(sr.At(1).Str("req", "") == "GET /slow -> 500" &&
              sr.At(1).Int("us", -1) == 25000, "slow_requests[1]");

        JsonValue sq = v.Get("slow_queries");
        Check(sq != null && sq.IsArray() && sq.Count() == 1, "slow_queries size");
        Check(sq.At(0).Str("sql", "") == "select count(*) from big" &&
              sq.At(0).Int("us", -1) == 40000, "slow_queries[0]");

        JsonValue ts = v.Get("top_sql");
        Check(ts != null && ts.IsArray() && ts.Count() == 2, "top_sql size");
        Check(ts.At(0).Str("sql", "") == "select count(*) from big" &&
              ts.At(0).Int("count", -1) == 1 &&
              ts.At(0).Int("total_us", -1) == 40000 &&
              ts.At(0).Int("avg_us", -1) == 40000 &&
              ts.At(0).Int("max_us", -1) == 40000, "top_sql[0]");
        Check(ts.At(1).Str("sql", "") == "select * from t where id = ?" &&
              ts.At(1).Int("total_us", -1) == 3000, "top_sql[1]");

        // Three rows for three routes: the two unmatched requests added none.
        JsonValue tr = v.Get("top_requests");
        Check(tr != null && tr.IsArray() && tr.Count() == 3, "top_requests size");
        Check(tr.At(0).Str("req", "") == "GET /slow" &&
              tr.At(0).Str("method", "") == "GET" &&
              tr.At(0).Str("path", "") == "/slow" &&
              tr.At(0).Int("total_us", -1) == 25000 &&
              tr.At(0).Int("errors", -1) == 1 &&
              tr.At(0).Int("failed", -1) == 1 && tr.At(0).Int("rejected", -1) == 0,
              "top_requests[0]");
        Check(tr.At(1).Str("req", "") == "POST /api/b" &&
              tr.At(1).Int("total_us", -1) == 12000, "top_requests[1]");
        Check(tr.At(2).Str("req", "") == "GET /api/a" &&
              tr.At(2).Int("total_us", -1) == 5000, "top_requests[2]");

        if (fails == 0) {
            Console.WriteLine("snapshot-ok: 1");
            return 0;
        }
        return 1;
    }
}
