// 接口数据协议与执行契约。
using System;
using System.Web;

namespace Conf;

/* 模块核心语义抽象与接口调用契约 */
[Route("[controller]/[action]")]
class FirstLanding : Controller {
    [HttpGet]
    [Route("/")]
    async void Index() {
        this.Ok("\"first\"");
    }
}

/* 模块核心语义抽象与接口调用契约 */
[Route("[controller]/[action]")]
class SecondLanding : Controller {
    [HttpGet]
    [Route("/")]
    async void Index() {
        this.Ok("\"second\"");
    }
}

class Program {
    static int failures;

    static void Check(bool ok, string label) {
        if (!ok) {
            Program.failures = Program.failures + 1;
            Console.WriteLine("FAIL " + label);
        }
    }

    static HttpContext Ctx(string method, string path) {
        HttpRequest req = HttpRequest.Parse(method + " " + path
            + " HTTP/1.1\r\nHost: t\r\n\r\n");
        return new HttpContext(req, "127.0.0.1");
    }

    static async void Main() {
        WebApp app = new WebApp("127.0.0.1", 0);
        __AttrRoutes.Register(app);
        HttpContext ctx = Program.Ctx("GET", "/");
        Route r = app.router.Match(ctx);
        Program.Check(r != null, "route / registered");
        if (r != null) {
            Program.Check(r.action == "FirstLanding.Index",
                "first declared controller wins (" + r.action + ")");
            await r.handler(ctx);
            string resp = ctx.BuildResponse(true);
            Program.Check(resp.Contains("first") && !resp.Contains("second"),
                "response served by first handler");
        }
        Console.WriteLine("failures=" + Convert.ToString(Program.failures));
    }
}
