// 局部别名借用：`T q = p;`（p 为局部/参数、二者都不再被赋值）不另持引用。
// 验证借用后需要 +1 的去处（return、存入集合/字段）仍正确持有，以及不满足
// 条件（被重新赋值）时退回原所有权语义。插桩档（--check-leaks）零泄漏、无双重释放。
using System;
using System.Collections.Generic;

class P {
    public long v;
    public P(long x) { v = x; }
}

class Holder {
    public P kept;
}

class Program {
    static long SumCopies(List<P> l) {
        long s = 0;
        foreach (P p in l) { P q = p; s = s + q.v; }
        return s;
    }

    static P FirstCopy(List<P> l) {
        foreach (P p in l) { P q = p; return q; }
        return null;
    }

    static P FromParam(P p) { P q = p; return q; }

    static void KeepCopies(List<P> src, List<P> dst, Holder h) {
        foreach (P p in src) { P q = p; dst.Add(q); h.kept = q; }
    }

    static string StrCopy(int n) { string a = "s" + n; string b = a; return b; }

    static long CopyReassigned(List<P> l) {
        long s = 0;
        foreach (P p in l) { P q = p; s = s + q.v; q = new P(1000); s = s + q.v; }
        return s;
    }

    static long SourceReassigned() {
        P a = new P(7);
        P b = a;
        a = new P(8);
        return a.v * 10 + b.v;
    }

    static void Main() {
        List<P> l = new List<P>();
        for (int i = 0; i < 5; i = i + 1) { l.Add(new P(i + 1)); }
        Console.WriteLine("sum=" + SumCopies(l));

        P first = FirstCopy(l);
        P fromParam = FromParam(l[4]);
        List<P> dst = new List<P>();
        Holder h = new Holder();
        KeepCopies(l, dst, h);
        l.Clear();
        Console.WriteLine("first=" + first.v + " param=" + fromParam.v);
        Console.WriteLine("kept=" + dst.Count + " last=" + h.kept.v + " dst0=" + dst[0].v);

        Console.WriteLine("str=" + StrCopy(42));

        List<P> m = new List<P>();
        m.Add(new P(1)); m.Add(new P(2));
        Console.WriteLine("reassigned=" + CopyReassigned(m));
        Console.WriteLine("srcReassigned=" + SourceReassigned());
    }
}
