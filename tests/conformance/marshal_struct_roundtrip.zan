using System;
struct P { public int X; public long Y; }
struct Q { public int A; public int B; }
class Z9 {
    static int Main() {
        // sizeof(T)：编译期常量，Zan 内存形态字节数（char 是 8 字节码位）
        Console.WriteLine("P=" + sizeof(P) + " Q=" + sizeof(Q));
        Console.WriteLine("int=" + sizeof(int) + " long=" + sizeof(long) +
            " bool=" + sizeof(bool) + " nint=" + sizeof(nint));
        // Marshal 包装：泛型方法体里的 sizeof(T) 在实例化点定型
        Console.WriteLine("wrap=" + Marshal.SizeOf<P>());
        // StructureToPtr / PtrToStructure 按值往返（Span<T> 胖指针语义）
        nint m = NativeMemory.Alloc(sizeof(P));
        NativeMemory.Fill(m, 0, sizeof(P));
        Marshal.StructureToPtr(new P { X = 91, Y = 92 }, m);
        P v = Marshal.PtrToStructure<P>(m);
        NativeMemory.Free(m);
        Console.WriteLine("rt=" + v.X + "," + v.Y);
        return 0;
    }
}
