using System;

class Program {
    static void Main() {
        bool t = true;
        bool f = false;
        Console.WriteLine("t32=" + Convert.ToInt32(t));
        Console.WriteLine("f32=" + Convert.ToInt32(f));
        Console.WriteLine("t64=" + Convert.ToInt64(t));
        Console.WriteLine("f64=" + Convert.ToInt64(f));
        Console.WriteLine("lit_t=" + Convert.ToInt32(true));
        Console.WriteLine("lit_f=" + Convert.ToInt32(false));
    }
}
