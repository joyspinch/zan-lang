using System;

// A type pattern over a value-type discriminant used to be lowered as a
// hardcoded `false`: `case int n when n > 3:` never matched and the switch fell
// through to default without a word. A value type has no runtime type
// variation, so the match is a static decision -- true iff the discriminant's
// static type is the pattern type, the same rule `x is T` already used. Both
// the statement and the expression form are covered (the expression lowers to
// the statement).

class Animal { }
class Dog : Animal { public int legs; }

class Program {
    static string Classify(int v) {
        switch (v) {
            case int n when n > 100: return "huge:" + Convert.ToString(n);
            case int n when n > 3: return "big:" + Convert.ToString(n);
            case int n: return "small:" + Convert.ToString(n);
            default: return "none";
        }
    }

    static void Main() {
        int v = 5;

        Console.WriteLine("expr-when: " +
            (v switch { int m when m > 3 => "big", _ => "other" }));
        Console.WriteLine("expr-bind: " +
            (v switch { int m => "int:" + Convert.ToString(m), _ => "other" }));
        Console.WriteLine("expr-const: " + (v switch { 5 => "five", _ => "other" }));

        // a pattern of a different value type must not match
        Console.WriteLine("expr-other-type: " +
            (v switch { long l => "long", int m => "int", _ => "other" }));

        Console.WriteLine("stmt: " + Program.Classify(5));
        Console.WriteLine("stmt2: " + Program.Classify(200));
        Console.WriteLine("stmt3: " + Program.Classify(1));

        // string and class patterns keep their runtime checks
        string s = "hi";
        Console.WriteLine("string: " +
            (s switch { string t => "str:" + t, _ => "other" }));

        Animal a = new Dog();
        Console.WriteLine("class: " +
            (a switch { Dog d when d.legs == 0 => "dog0", Dog d => "dog", _ => "other" }));

        double d2 = 2.5;
        Console.WriteLine("double: " +
            (d2 switch { double x when x > 2.0 => "gt2", double x => "le2", _ => "other" }));

        bool b = true;
        Console.WriteLine("bool: " + (b switch { bool x => "bool", _ => "other" }));
    }
}
