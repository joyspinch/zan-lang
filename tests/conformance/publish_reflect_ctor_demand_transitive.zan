using System;
using System.Collections.Generic;

class CtorDemandTransitiveLeaf {
    public int Value;
    public CtorDemandTransitiveLeaf() { Value = 59; }
}

class CtorDemandTransitiveOwner {
    // Emitting this implicit ctor thunk discovers allocations and a direct
    // dependency on Leaf's explicit constructor before dead-body stubs freeze.
    public CtorDemandTransitiveLeaf Leaf = new CtorDemandTransitiveLeaf();
    public List<List<CtorDemandTransitiveLeaf>> Groups = new List<List<CtorDemandTransitiveLeaf>>();
}

class Program {
    static void Require(bool value, string message) {
        if (!value) throw new Exception(message);
    }

    // Reached by the body worklist after Main: demand must take effect even
    // when the TypeInfo record was already created without callable thunks.
    static object LiveFactory(TypeInfo type) { return type.CreateInstance(); }

    static void Main() {
        TypeInfo type = typeof(CtorDemandTransitiveOwner);
        Require(type.ConstructorCount == 1 && type.GetCtorParamCount(0) == 0,
            "implicit constructor metadata before demand");
        object value = LiveFactory(type);
        Require(value is CtorDemandTransitiveOwner, "implicit constructor identity");
        CtorDemandTransitiveOwner owner = (CtorDemandTransitiveOwner)value;
        Require(owner.Leaf != null && owner.Leaf.Value == 59, "transitive constructor body");
        Require(owner.Groups != null && owner.Groups.Count == 0, "implicit List initializer");
        TypeInfo groups = typeof(CtorDemandTransitiveOwner).GetFieldTypeInfo(1);
        object nested = LiveFactory(groups);
        object child = LiveFactory(groups.ElementType);
        Require(nested is List<List<CtorDemandTransitiveLeaf>>, "nested List identity");
        Require(child is List<CtorDemandTransitiveLeaf>, "nested List element identity");
        Console.WriteLine("transitive PASS");
    }
}
