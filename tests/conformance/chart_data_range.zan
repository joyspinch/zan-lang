using System;
using Gui.Component.Chart;

namespace Conf;

/// dataRange 值域从不同系列族读取其主数值字段，并跳过隐藏系列。
class Program {
    static void Main() {
        ChartSeries line = ChartSeries.Line("line", new List<int>{-3, 4});
        ChartSeries candle = ChartSeries.OfCandles("candle",
            new List<Candle>{ Candle.Of(1000, 12, -8, 900) });
        ChartSeries bubble = ChartSeries.OfBubbles("bubble",
            new List<Bubble>{ Bubble.Of(1000, -1000, 30) });
        ChartSeries point = ChartSeries.OfPoints("point",
            new List<ChartPoint>{ ChartPoint.Of(1000, 15) });
        ChartSeries box = ChartSeries.OfBoxes("box",
            new List<BoxItem>{ BoxItem.Of("B", -20, 200, 300, 400, 25) });
        ChartSeries error = ChartSeries.OfErrors("error",
            new List<ErrorItem>{ ErrorItem.Of("E", 10, 40) });
        ChartSeries eventSeries = ChartSeries.Of("event", ChartType.EventRiver, new List<int>());
        eventSeries.events.Add(ChartEvent.Of("Ev", -1000, 1000, 60));
        ChartSeries links = ChartSeries.Chord("links",
            new List<ChartLink>{ ChartLink.Of("A", "B", 70) });
        ChartSeries tree = ChartSeries.OfTree("tree", ChartType.Tree,
            ChartNode.Group("G", new List<ChartNode>{ ChartNode.Leaf("a", 5), ChartNode.Leaf("b", 7) }));
        ChartSeries region = ChartSeries.Of("map", ChartType.Map, new List<int>());
        region.regions.Add(ChartMapRegion.Of("R", 80, new List<ChartMapRing>()));
        ChartSeries hidden = ChartSeries.Line("hidden", new List<int>{-9999, 9999});
        hidden.hidden = true;

        ChartOption o = ChartOption.Create();
        o.series = new List<ChartSeries>{line, candle, bubble, point, box, error,
            eventSeries, links, tree, region, hidden};
        int lo = 0;
        int hi = 0;
        ChartViewDataRange.DataSpan(o, out lo, out hi);
        Console.WriteLine("span:" + Convert.ToString(lo) + ":" + Convert.ToString(hi));

        ChartOption empty = ChartOption.Create();
        ChartSeries onlyHidden = ChartSeries.Line("hidden", new List<int>{-10, 10});
        onlyHidden.hidden = true;
        empty.series.Add(onlyHidden);
        ChartViewDataRange.DataSpan(empty, out lo, out hi);
        Console.WriteLine("empty:" + Convert.ToString(lo) + ":" + Convert.ToString(hi));
    }
}
