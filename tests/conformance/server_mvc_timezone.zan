// 核心契约与语义定义。
using System;
using ZanWeb.Core;
using ZanWeb.Web;

class Program {
    static void Main() {
        long morning = 1786769940;
        Fmt.SetOffsetMinutes(0);
        Console.WriteLine(Fmt.Stamp(morning));
        Console.WriteLine(Fmt.Day(morning));

        Fmt.SetOffsetMinutes(480);
        Console.WriteLine(Fmt.Stamp(morning));
        Console.WriteLine(Fmt.Day(morning));

        long evening = 1786825800;
        Console.WriteLine(Fmt.Stamp(evening));
        Console.WriteLine(Fmt.Day(evening));
        Console.WriteLine(Fmt.TodayStart(evening));

        Fmt.SetOffsetMinutes(-420);
        long localMidnight = 1786777200;
        Console.WriteLine(Fmt.Stamp(localMidnight));
        Console.WriteLine(Fmt.TodayStart(localMidnight));
        Console.WriteLine(Fmt.LocalDayStart(2026, 8, 15));
    }
}
