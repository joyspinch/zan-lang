// A43 补遗（P8 挂账缺陷①回归锁）：`x is T ? a : b` 的 `?` 歧义消解。
// C# 规则：条件运算符优先——类型操作数后跟 `?` 时，若 `?` 之后能起
// 表达式且后续有配对 `:`，则 `?` 归三元；可空类型/可空模式（无 `:`）
// 维持原读法。`as` 同规则。
using System;

class Item {
    int Val;
    string Name;
}

class TernaryIsType {
    static int Main() {
        int fails = 0;
        object o = "hi";
        string s = "hi";
        Item it = new Item();

        // ① 缺陷主体：is 类型测试后跟三元（此前 `?` 被吃成可空类型）。
        string r1 = o is string ? "str" : "other";
        if (r1 != "str") { fails++; Console.WriteLine("F1 " + r1); }

        string r2 = it is string ? "str" : "other";
        if (r2 != "other") { fails++; Console.WriteLine("F2 " + r2); }

        // ② is not + 三元。
        string r3 = o is not Item ? "notitem" : "item";
        if (r3 != "notitem") { fails++; Console.WriteLine("F3 " + r3); }

        // ③ 模式变量（无 ? 后缀）不受影响：is T x 照旧绑定。
        if (o is string n1) { if (n1 != "hi") { fails++; Console.WriteLine("F4a"); } }
        else { fails++; Console.WriteLine("F4b"); }

        // ④ 可空类型模式（`?` 后是标识符、无配对 `:`）维持可空读法，
        // 同型绑定照常。（int? → int 的解包模式 Zan 不支持，与本次
        // 歧义消解无关，不在此锁。）
        int? maybe = 7;
        if (!(maybe is int? n2)) { fails++; Console.WriteLine("F5"); }

        // ⑤ 纯可空类型测试（表达式尾部 `?`，`?` 后不能起表达式）。
        bool r6 = maybe is int?;
        if (!r6) { fails++; Console.WriteLine("F6"); }

        // ⑥ 泛型实参内的 `?` 仍是可空：外层 `?` 归三元。
        System.Collections.Generic.List<int?> li =
            new System.Collections.Generic.List<int?>();
        li.Add(5);
        string r7 = li is System.Collections.Generic.List<int?> ? "li" : "no";
        if (r7 != "li") { fails++; Console.WriteLine("F7 " + r7); }

        // ⑦ as + 三元（Zan 的 as 失败产缺省值非 null，故用成功的
        // as 只锁解析形态：条件部分是 as 表达式）。
        string r8 = (o as string) == null ? "null" : "str";
        if (r8 != "str") { fails++; Console.WriteLine("F8 " + r8); }

        // ⑧ 嵌套三元（then 臂里再一个三元）。
        string r9 = o is string ? (s is string ? "both" : "one") : "none";
        if (r9 != "both") { fails++; Console.WriteLine("F9 " + r9); }

        // ⑨ 括号形式回归：显式括起 is 后三元照旧。
        string r10 = (o is Item) ? "item" : "notitem";
        if (r10 != "notitem") { fails++; Console.WriteLine("F10 " + r10); }

        if (fails == 0) {
            Console.WriteLine("TERNARY_IS_TYPE_OK");
            return 0;
        }
        Console.WriteLine("TERNARY_IS_TYPE_FAILS " + Convert.ToString(fails));
        return 1;
    }
}
