using System;
using Gui.Component.Chart;

namespace Conf;

/// 阶段 1 的 JSON 解析：links、stack 字符串分组、title 对象、
/// pie radius、radar indicator、markPoint 数据、candle/bubble/
/// box/error/points/event/map regions、隐藏数据项，全部解析进模型。
class Program {
    static void Main() {
        ChartOption o = ChartOption.FromJson(
            "{" +
            "  \"title\":{\"text\":\"Main\",\"subtext\":\"Sub\"}," +
            "  \"radar\":{\"indicator\":[{\"name\":\"A\",\"max\":10},{\"name\":\"B\",\"max\":20}]}," +
            "  \"markPoint\":{\"data\":[{\"type\":\"max\"}]}," +
            "  \"series\":[" +
            "    {\"name\":\"S1\",\"type\":\"line\",\"stack\":\"total\"," +
            "     \"data\":[{\"value\":3,\"name\":\"Q1\",\"hidden\":true},5]}," +
            "    {\"name\":\"S2\",\"type\":\"pie\",\"radius\":[40,100],\"data\":[1,2]}," +
            "    {\"name\":\"S3\",\"type\":\"chord\"," +
            "     \"links\":[{\"source\":\"A\",\"target\":\"B\",\"value\":7}]," +
            "     \"data\":[]}," +
            "    {\"name\":\"S4\",\"type\":\"k\"," +
            "     \"candles\":[{\"open\":1,\"close\":3,\"low\":0,\"high\":5}]," +
            "     \"data\":[]}," +
            "    {\"name\":\"S5\",\"type\":\"scatter\"," +
            "     \"bubbles\":[{\"x\":1,\"y\":2,\"weight\":3}]," +
            "     \"points\":[{\"x\":4,\"y\":5}]," +
            "     \"data\":[]}," +
            "    {\"name\":\"S6\",\"type\":\"custom\",\"custom\":\"box\"," +
            "     \"boxes\":[{\"name\":\"B\",\"value\":[1,2,3,4,5]}]," +
            "     \"errors\":[{\"name\":\"E\",\"value\":6,\"err\":1}]," +
            "     \"data\":[]}," +
            "    {\"name\":\"S7\",\"type\":\"eventRiver\"," +
            "     \"events\":[{\"name\":\"Ev\",\"start\":10,\"end\":20,\"value\":3}]," +
            "     \"data\":[]}," +
            "    {\"name\":\"S8\",\"type\":\"map\"," +
            "     \"regions\":[{\"name\":\"R\",\"value\":9," +
            "       \"rings\":[{\"points\":[[0,0],[10,0],[10,10],[0,10]]}," +
            "                  {\"points\":[[2,2],[8,2],[8,8],[2,8]],\"hole\":true}]}]," +
            "     \"data\":[]}" +
            "  ]" +
            "}");

        ChartSeries s1 = o.series[0];
        ChartSeries s2 = o.series[1];
        ChartSeries s3 = o.series[2];
        ChartSeries s4 = o.series[3];
        ChartSeries s5 = o.series[4];
        ChartSeries s6 = o.series[5];
        ChartSeries s7 = o.series[6];
        ChartSeries s8 = o.series[7];

        // title 对象 {text,subtext} 合并。
        Console.WriteLine(o.title);

        // stack 字符串 -> stackName + 稳定 id；隐藏数据项。
        Console.WriteLine(Convert.ToString(s1.stackName) + ":" + Convert.ToString(s1.stack != 0)
            + ":" + Convert.ToString(s1.data[0].hidden) + ":" + Convert.ToString(s1.data[0].val));

        // pie radius [40,100] -> innerPct 40。
        Console.WriteLine(Convert.ToString(s2.innerPct) + ":" + Convert.ToString(s2.data.Count));

        // chord links。
        Console.WriteLine(Convert.ToString(s3.links.Count) + ":" + s3.links[0].from + ":" + s3.links[0].to
            + ":" + Convert.ToString(s3.links[0].val));

        // candles。
        Console.WriteLine(Convert.ToString(s4.candles.Count) + ":" + Convert.ToString(s4.candles[0].open)
            + ":" + Convert.ToString(s4.candles[0].high) + ":" + Convert.ToString(s4.candles[0].low)
            + ":" + Convert.ToString(s4.candles[0].close));

        // bubbles + scatter points。
        Console.WriteLine(Convert.ToString(s5.bubbles.Count) + ":" + Convert.ToString(s5.bubbles[0].weight)
            + ":" + Convert.ToString(s5.points.Count) + ":" + Convert.ToString(s5.points[0].x));

        // boxes + errors（custom 键）。
        Console.WriteLine(s6.custom + ":" + Convert.ToString(s6.boxes.Count)
            + ":" + Convert.ToString(s6.boxes[0].med)
            + ":" + Convert.ToString(s6.errors.Count) + ":" + Convert.ToString(s6.errors[0].err));

        // events。
        Console.WriteLine(Convert.ToString(s7.events.Count) + ":" + s7.events[0].name
            + ":" + Convert.ToString(s7.events[0].start) + ":" + Convert.ToString(s7.events[0].end));

        // map regions：多部件 + hole 环。
        Console.WriteLine(Convert.ToString(s8.regions.Count) + ":" + s8.regions[0].name
            + ":" + Convert.ToString(s8.regions[0].value)
            + ":" + Convert.ToString(s8.regions[0].rings.Count)
            + ":" + Convert.ToString(s8.regions[0].rings[1].hole)
            + ":" + Convert.ToString(s8.regions[0].rings[0].points.Count));

        // radarMax 每轴满刻度；option 级 markPoint.data 挂到第一个 line/bar 系列。
        Console.WriteLine(Convert.ToString(o.radarMax.Count) + ":" + Convert.ToString(o.radarMax[1])
            + ":" + Convert.ToString(s1.marks.Count) + ":" + s1.marks[0].kind);
    }
}
