// Task 句柄的两种形态必须分清（回归用例）：
//
//   1) 无结果任务：Task.Run(lambda/Action) 产生的是"没有结果"的任务。
//      声明成 Task（不是 Task<T>），用 .Wait() 等它完成。
//   2) 带结果任务：Task.Run(async 调用) 才产生 Task<T>，可以读 .Result。
//   3) Task 句柄本质是 long 帧指针：可以取回裸句柄交给
//      Task.IsDone(h) / TaskJoin 这类收 long 的 API。
//
// 反例（把 lambda 句柄当 Task<T> 用）现在由检查器在编译期拒绝：
// 见 tests/diag/task_run_action_result_type.zan。
using System;
using System.Threading;

class Program {
    static async int Cube(int n) {
        await Task.Delay(10);
        return n * n * n;
    }

    static void Main() {
        // 1) 无结果任务：跑一个 Action 再等它
        int val = 0;
        Task t = Task.Run(delegate () {
            Thread.Sleep(20);
            val = 42;
        });
        t.Wait();
        Console.WriteLine("val=" + val);
        Console.WriteLine("action-completed=" + t.IsCompleted);

        // 2) 带结果任务：async 调用形态
        Task<int> x = Task.Run(Cube(3));
        Task<int> y = Task.Run(Cube(4));
        Console.WriteLine("sum=" + (x.Result + y.Result));

        // 3) 裸句柄
        long h = Task.Run(Cube(5));
        while (Task.IsDone(h) == 0) { }
        Console.WriteLine("handle-done=" + (Task.IsDone(h) != 0));

        // 4) 委托变量形态与 Spawn 脱钩句柄
        Action a = delegate () { Console.WriteLine("action-var"); };
        Task t2 = Task.Run(a);
        t2.Wait();
        long s = Task.Spawn(Cube(6));
        Console.WriteLine("spawn-handle=" + (s != 0));

        Console.WriteLine("task-handle-ok: 1");
    }
}
