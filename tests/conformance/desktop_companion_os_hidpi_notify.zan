using System;
using System.Windows;

class Program {
    static int Main() {
        // 1. 跨平台桌面伴侣 OS 能力描述档案（零 Win32 硬编码，覆盖 Win/macOS/Linux/OHOS）
        DesktopOsFamily cur = CompanionOsCapabilityProfile.DetectCurrentOs();
        CompanionOsCapabilityProfile mac = CompanionOsCapabilityProfile.ForOs(DesktopOsFamily.MacOS);
        CompanionOsCapabilityProfile win = CompanionOsCapabilityProfile.ForOs(DesktopOsFamily.Windows);
        CompanionOsCapabilityProfile lin = CompanionOsCapabilityProfile.ForOs(DesktopOsFamily.Linux);
        CompanionOsCapabilityProfile ohos = CompanionOsCapabilityProfile.ForOs(DesktopOsFamily.HarmonyOS);
        bool osOk = cur != DesktopOsFamily.Unknown
            && mac.FormatShortcutLabel("K") == "Cmd+K" && mac.AutostartBackend == "LaunchAgentPlist"
            && win.FormatShortcutLabel("K") == "Ctrl+K" && win.TrayActivationMode == "TrayLeftClick"
            && lin.AutostartBackend == "XdgAutostartDesktop"
            && ohos.TrayActivationMode == "DockBadgeCard";
        Console.WriteLine("os_profile_ok=" + (osOk ? "1" : "0"));

        // 2. 跨平台 HiDPI 坐标换算与菜单栏/任务栏工作区安全钳位
        CompanionHiDpiCoordNormalizer macDpi = new CompanionHiDpiCoordNormalizer(2.0f, 1440, 900, mac);
        int phys = macDpi.LogicalToPhysical(120); // 240
        int back = macDpi.PhysicalToLogical(240); // 120
        int cx1; int cy1;
        macDpi.ClampWidgetPosition(-20, 4, 160, 160, out cx1, out cy1); // 顶部避让 24px 菜单栏
        int cx2; int cy2;
        macDpi.ClampWidgetPosition(1400, 880, 160, 160, out cx2, out cy2); // 底部避让 64px Dock -> 900-64-160=676
        bool dpiOk = phys == 240 && back == 120 && cx1 == 0 && cy1 == 24 && cx2 == 1280 && cy2 == 676;
        Console.WriteLine("hidpi_clamp_ok=" + (dpiOk ? "1" : "0"));

        // 3. 跨平台通知标题裁剪、动作按钮上限降级与免打扰静默路由
        CompanionPlatformNotificationRouter router = new CompanionPlatformNotificationRouter(ohos); // 标题<=40, 按钮<=2
        bool sent1 = router.TryDispatch("123456789012345678901234567890123456789012345", 5, false);
        bool clippedOk = sent1 && router.LastFormattedTitle.Length == 40 && router.LastActionCount == 2;
        router.DoNotDisturb = true;
        bool blockedDnd = !router.TryDispatch("normal", 1, false);
        bool urgentOk = router.TryDispatch("urgent", 1, true);
        bool notifyOk = clippedOk && blockedDnd && urgentOk && router.DispatchedCount == 2 && router.SuppressedCount == 1;
        Console.WriteLine("notify_router_ok=" + (notifyOk ? "1" : "0"));
        return 0;
    }
}
