/* array .Count: the params bundle is a plain array, so a callee reading the
 * List-spelling `.Count` on it must get the element count. Both members used
 * to type-check as errors (checker) and lower to the constant 0 (irgen's
 * unresolved-member fallback), so a params callee reported an empty bundle
 * while `.Length` on the same array reported the true count. */
class BizDef {
    static int KindCount(string label, params string[] kindIds) {
        return kindIds.Count;
    }
    static int LastIndex(params int[] xs) {
        return xs.Count - 1;
    }
}
class Program {
    static void Main() {
        Console.WriteLine(BizDef.KindCount("one", "k1", "k2", "k3"));
        Console.WriteLine(BizDef.KindCount("zero"));
        string[] nums = new string[] { "4", "5", "6", "7" };
        Console.WriteLine(BizDef.KindCount("arr", nums));
        Console.WriteLine(BizDef.LastIndex(9, 8, 7));
        Console.WriteLine(nums.Count);
        Console.WriteLine(nums.Length);
    }
}
