using System;
using System.Collections.Generic;
using Gui.Designer;

class Program {
    static void Main() {
        Console.WriteLine("[1] Testing LiveLayoutSession creation & delta queueing...");
        LiveLayoutSession session = LiveLayoutSession.Create("designer-session-01");

        session.Push(LiveDeltaOp.Text("btnSubmit", "保存修改"));
        session.Push(LiveDeltaOp.Style("headerPanel", "backgroundColor", "#1E1E1E"));
        session.Push(LiveDeltaOp.Attr("txtUsername", "placeholder", "请输入手机或邮箱"));
        session.Push(LiveDeltaOp.Remove("oldBanner"));

        Console.WriteLine("Pending count: " + Convert.ToString(session.PendingCount));
        Console.WriteLine("Session version: " + Convert.ToString(session.version));

        Console.WriteLine("[2] Flushing batch operations...");
        List<LiveDeltaOp> ops = session.Flush();
        Console.WriteLine("Flushed ops count: " + Convert.ToString(ops.Count));
        Console.WriteLine("Remaining pending: " + Convert.ToString(session.PendingCount));

        Console.WriteLine("[3] Validating delta operations details...");
        for (int i = 0; i < ops.Count; i = i + 1) {
            LiveDeltaOp op = ops[i];
            Console.WriteLine("Op " + Convert.ToString(i) + ": target=" + op.targetId + " key=" + op.key + " val=" + op.value);
        }

        Console.WriteLine("OK: all live layout delta session checks passed!");
    }
}
