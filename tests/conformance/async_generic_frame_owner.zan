using System;
using System.Threading;

class Result {
    public int Value = 42;
}

async delegate T Factory<T>();

class Source {
    public async Result Open() {
        await Task.Delay(1);
        return new Result();
    }
}

class Forwarder<T> {
    public int Completed;

    public async T Through(Factory<T> open, bool useFinally) {
        T result = null;
        if (useFinally) {
            try {
                result = await open();
                return result;
            } finally {
                this.Completed = this.Completed + 1;
            }
        }
        result = await open();
        return result;
    }
}

class Program {
    static async Result Forward(Forwarder<Result> forwarder, Factory<Result> open, bool useFinally) {
        return await forwarder.Through(open, useFinally);
    }

    static void Main() {
        Source source = new Source();
        Factory<Result> open = source.Open;
        Forwarder<Result> forwarder = new Forwarder<Result>();
        Result plain = await Program.Forward(forwarder, open, false);
        Result guarded = await Program.Forward(forwarder, open, true);
        if (plain == null || guarded == null || plain.Value != 42 || guarded.Value != 42 || forwarder.Completed != 1) {
            throw new Exception("generic async forwarding failed");
        }
        Console.WriteLine("async generic frame owner ok");
    }
}
