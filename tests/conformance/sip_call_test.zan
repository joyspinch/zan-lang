using System;
using System.Collections.Generic;
using System.Net.Sockets;
using System.Net.Sip;
using System.Threading;

class Program {
    static int ParsePortFromVia(string via) {
        // e.g. "SIP/2.0/UDP 127.0.0.1:5064;branch=..."
        int colon = via.IndexOf(":");
        if (colon >= 0) {
            int semi = via.IndexOf(";", colon);
            string portText = semi >= 0 ? via.Substring(colon + 1, semi - colon - 1) : via.Substring(colon + 1);
            return Convert.ToInt(portText);
        }
        return 5060;
    }

    static void TestSdpSerializationAndParse() {
        SdpMessage sdp = SdpMessage.CreateAudio("192.168.1.50", 40000);
        string text = sdp.Serialize();
        if (text.IndexOf("c=IN IP4 192.168.1.50") < 0) {
            Console.WriteLine("FAIL: sdp c line");
            Environment.Exit(1);
        }
        if (text.IndexOf("m=audio 40000 RTP/AVP 0") < 0) {
            Console.WriteLine("FAIL: sdp m line");
            Environment.Exit(2);
        }

        SdpMessage parsed = SdpMessage.Parse(text);
        if (parsed == null || parsed.GetConnectionIp() != "192.168.1.50" || parsed.GetMediaPort() != 40000 || parsed.GetPayloadType() != 0) {
            Console.WriteLine("FAIL: sdp parse");
            Environment.Exit(3);
        }
        if (parsed.GetCodec() != "PCMU" || parsed.GetSampleRate() != 8000) {
            Console.WriteLine("FAIL: sdp rtpmap parse");
            Environment.Exit(4);
        }
        Console.WriteLine("sdp serialize and parse ok");
    }

    static void TestRtpPacketEncodeDecode() {
        byte[] pcm = new byte[160]; // 20ms G.711u 采样
        for (int i = 0; i < 160; i = i + 1) {
            pcm[i] = (byte)(i & 255);
        }
        RtpPacket pkt = RtpPacket.Create(0, 101, 16000, 99998888, pcm);
        pkt.SetMarker(true);
        byte[] wire = pkt.Encode();
        if (wire == null || wire.Length != 172) { // 12 header + 160 payload
            Console.WriteLine("FAIL: rtp encode length");
            Environment.Exit(5);
        }
        if ((wire[0] & 255) != 128) { // V=2
            Console.WriteLine("FAIL: rtp version");
            Environment.Exit(6);
        }
        if ((wire[1] & 255) != 128) { // M=1, PT=0
            Console.WriteLine("FAIL: rtp marker and pt");
            Environment.Exit(7);
        }

        RtpPacket decoded = RtpPacket.Decode(wire, 0, wire.Length);
        if (decoded == null || !decoded.GetMarker() || decoded.GetPayloadType() != 0 || decoded.GetSequenceNumber() != 101) {
            Console.WriteLine("FAIL: rtp decode header");
            Environment.Exit(8);
        }
        if (decoded.GetTimestamp() != 16000 || decoded.GetSsrc() != 99998888) {
            Console.WriteLine("FAIL: rtp decode ts or ssrc");
            Environment.Exit(9);
        }
        byte[] decPayload = decoded.GetPayload();
        if (decPayload == null || decPayload.Length != 160 || (decPayload[159] & 255) != 159) {
            Console.WriteLine("FAIL: rtp decode payload");
            Environment.Exit(10);
        }
        Console.WriteLine("rtp packet encode and decode ok");
    }

    static void TestSipCallModel() {
        SipCall call = new SipCall("call-001", "sip:alice@127.0.0.1", "sip:bob@127.0.0.1", "tag-alice", 1, 30000);
        if (call.GetState() != SipCallState.Idle || call.IsActive()) {
            Console.WriteLine("FAIL: call initial state");
            Environment.Exit(11);
        }
        call.SetState(SipCallState.Calling);
        if (!call.IsActive() || call.IsConnected()) {
            Console.WriteLine("FAIL: call calling state");
            Environment.Exit(12);
        }
        call.SetState(SipCallState.Connected);
        if (!call.IsConnected()) {
            Console.WriteLine("FAIL: call connected state");
            Environment.Exit(13);
        }
        call.Close();
        if (call.GetState() != SipCallState.Terminated || call.IsActive()) {
            Console.WriteLine("FAIL: call terminated state");
            Environment.Exit(14);
        }
        Console.WriteLine("sip call model ok");
    }

    // 模拟服务端响应来电：接收 INVITE -> 回复 180 Ringing -> 回复 200 OK (带 SDP) -> 接收 ACK -> 接收 BYE -> 回复 200 OK
    // 严格遵循 RFC 3261 §18.2.2 将响应发回 Via 头部指定的客户端 IP 与端口
    static async void RunMockSipServer(int port, int clientPort) {
        UdpClient server = UdpClient.Bind("127.0.0.1", port);
        if (server == null) { return; }

        bool callDone = false;
        while (!callDone) {
            if (Socket.IsReadable(server.GetSocket())) {
                string d = server.RecvFrom(65536);
                SipMessage msg = SipMessage.Parse(d);
                if (msg != null && msg.GetIsRequest()) {
                    string method = msg.GetMethod();
                    if (method == "INVITE") {
                        string via = msg.Header("Via");
                        int viaPort = ParsePortFromVia(via);
                        if (viaPort != clientPort) {
                            Console.WriteLine("FAIL: invite via port is " + Convert.ToString(viaPort) + ", want " + Convert.ToString(clientPort));
                            Environment.Exit(30);
                        }
                        string contact = msg.Header("Contact");
                        if (contact.IndexOf(":" + Convert.ToString(clientPort)) < 0) {
                            Console.WriteLine("FAIL: invite contact port mismatch: " + contact);
                            Environment.Exit(31);
                        }

                        string from = msg.Header("From");
                        string to = msg.Header("To");
                        string callId = msg.Header("Call-ID");
                        string cseq = msg.Header("CSeq");

                        // 1. 发送 180 Ringing 回到 Via 端口
                        SipMessage ring = SipMessage.Response(180, "Ringing");
                        ring.Add("Via", via);
                        ring.Add("From", from);
                        ring.Add("To", to + ";tag=bob-tag-999");
                        ring.Add("Call-ID", callId);
                        ring.Add("CSeq", cseq);
                        await server.SendToAsync(ring.Serialize(), "127.0.0.1", viaPort);

                        await Task.Delay(50);

                        // 2. 发送 200 OK，携带对端 SDP（协商音频端口 50002）回到 Via 端口
                        SipMessage ok = SipMessage.Response(200, "OK");
                        ok.Add("Via", via);
                        ok.Add("From", from);
                        ok.Add("To", to + ";tag=bob-tag-999");
                        ok.Add("Call-ID", callId);
                        ok.Add("CSeq", cseq);
                        ok.Add("Contact", "<sip:bob@127.0.0.1:" + Convert.ToString(port) + ">");
                        ok.Add("Content-Type", "application/sdp");
                        SdpMessage bobSdp = SdpMessage.CreateAudio("127.0.0.1", 50002);
                        ok.SetBody(bobSdp.Serialize());
                        await server.SendToAsync(ok.Serialize(), "127.0.0.1", viaPort);
                    } else if (method == "ACK") {
                        // 握手完成：校验 ACK 的 Via 头部端口是否对齐 localSipPort
                        int ackPort = ParsePortFromVia(msg.Header("Via"));
                        if (ackPort != clientPort) {
                            Console.WriteLine("FAIL: ack via port is " + Convert.ToString(ackPort) + ", want " + Convert.ToString(clientPort));
                            Environment.Exit(32);
                        }
                    } else if (method == "BYE") {
                        // 3. 挂断确认 200 OK：校验 BYE 的 Via 头部端口是否对齐 localSipPort
                        string via = msg.Header("Via");
                        int byePort = ParsePortFromVia(via);
                        if (byePort != clientPort) {
                            Console.WriteLine("FAIL: bye via port is " + Convert.ToString(byePort) + ", want " + Convert.ToString(clientPort));
                            Environment.Exit(33);
                        }

                        string from = msg.Header("From");
                        string to = msg.Header("To");
                        string callId = msg.Header("Call-ID");
                        string cseq = msg.Header("CSeq");

                        SipMessage byeOk = SipMessage.Response(200, "OK");
                        byeOk.Add("Via", via);
                        byeOk.Add("From", from);
                        byeOk.Add("To", to);
                        byeOk.Add("Call-ID", callId);
                        byeOk.Add("CSeq", cseq);
                        await server.SendToAsync(byeOk.Serialize(), "127.0.0.1", byePort);
                        callDone = true;
                    }
                }
            } else {
                await Task.Delay(10);
            }
        }
        server.Close();
    }

    static async Task TestSipCallWorkflow() {
        int serverPort = 5062;
        int clientPort = 5064;
        RunMockSipServer(serverPort, clientPort);
        await Task.Delay(50);

        SipClient client = new SipClient("127.0.0.1", serverPort, "alice");
        client.SetLocalIp("127.0.0.1");
        client.SetLocalSipPort(clientPort);

        // 发起语音呼叫（拨打电话），本地准备接收音频的 RTP 端口为 50000
        SipCall call = await client.InviteAsync("alice", "bob", 50000);
        if (call == null) {
            Console.WriteLine("FAIL: invite call is null");
            Environment.Exit(15);
        }
        if (!call.IsConnected()) {
            Console.WriteLine("FAIL: invite call not connected");
            Environment.Exit(16);
        }
        if (call.GetRemoteTag() != "bob-tag-999") {
            Console.WriteLine("FAIL: remote tag mismatch: " + call.GetRemoteTag());
            Environment.Exit(17);
        }
        if (call.GetRemoteRtpPort() != 50002 || call.GetRemoteRtpHost() != "127.0.0.1") {
            Console.WriteLine("FAIL: remote rtp negotiation: port=" + Convert.ToString(call.GetRemoteRtpPort()) + " host=" + call.GetRemoteRtpHost());
            Environment.Exit(18);
        }

        // 验证语音媒体通道
        RtpChannel channel = call.GetOrCreateRtpChannel();
        if (channel == null || channel.GetRemotePort() != 50002) {
            Console.WriteLine("FAIL: rtp channel init");
            Environment.Exit(19);
        }

        // 模拟对端在协商好的 50002 端口准备接收与回发 RTP 语音
        UdpClient bobRtp = UdpClient.Bind("127.0.0.1", 50002);
        if (bobRtp == null) {
            Console.WriteLine("FAIL: bob rtp bind failed");
            Environment.Exit(27);
        }

        // 发送一帧语音数据包（Alice -> Bob:50002）
        byte[] voiceFrame = new byte[160];
        voiceFrame[0] = 11;
        voiceFrame[159] = 22;
        int sent = await channel.SendAudioFrameAsync(voiceFrame, 0, 160);
        if (sent <= 0) {
            Console.WriteLine("FAIL: send audio frame");
            Environment.Exit(20);
        }

        // Bob 接收来自 Alice 的语音数据包
        byte[] bobBuf = new byte[2048];
        int bobRecv = bobRtp.RecvBytesFrom(bobBuf, 2048);
        if (bobRecv < 12) {
            Console.WriteLine("FAIL: bob recv rtp frame: " + Convert.ToString(bobRecv));
            Environment.Exit(28);
        }
        RtpPacket bobPkt = RtpPacket.Decode(bobBuf, 0, bobRecv);
        if (bobPkt == null || bobPkt.GetPayload() == null || (bobPkt.GetPayload()[0] & 255) != 11) {
            Console.WriteLine("FAIL: bob decode rtp packet");
            Environment.Exit(29);
        }

        // Bob 向 Alice (127.0.0.1:50000) 回传一帧 RTP 音频流
        byte[] srvPcm = new byte[160];
        srvPcm[0] = 42;
        srvPcm[159] = 84;
        RtpPacket srvPkt = RtpPacket.Create(0, 555, 32000, 77778888, srvPcm);
        byte[] srvData = srvPkt.Encode();
        await bobRtp.SendBytesToAsync(srvData, srvData.Length, "127.0.0.1", 50000);
        bobRtp.Close();

        RtpPacket recvdPkt = await channel.RecvRtpAsync();
        if (recvdPkt == null) {
            Console.WriteLine("FAIL: recv rtp async null");
            Environment.Exit(21);
        }
        if (recvdPkt.GetSequenceNumber() != 555 || recvdPkt.GetTimestamp() != 32000) {
            Console.WriteLine("FAIL: recv rtp seq or ts mismatch");
            Environment.Exit(22);
        }
        byte[] recvdPayload = recvdPkt.GetPayload();
        if (recvdPayload == null || recvdPayload.Length != 160 || (recvdPayload[0] & 255) != 42 || (recvdPayload[159] & 255) != 84) {
            Console.WriteLine("FAIL: recv rtp payload mismatch");
            Environment.Exit(23);
        }
        Console.WriteLine("rtp channel recv async ok");

        // 挂断通话
        bool hungUp = await client.HangupAsync(call);
        if (!hungUp || call.GetState() != SipCallState.Terminated) {
            Console.WriteLine("FAIL: hangup failed");
            Environment.Exit(24);
        }

        Console.WriteLine("sip call workflow (invite, ringing, 200 ok, ack, rtp, bye) ok");
    }

    static async void RunMockRegisterServer(int port, int clientPort) {
        UdpClient server = UdpClient.Bind("127.0.0.1", port);
        if (server == null) { return; }

        bool done = false;
        while (!done) {
            if (Socket.IsReadable(server.GetSocket())) {
                string d = server.RecvFrom(65536);
                SipMessage msg = SipMessage.Parse(d);
                if (msg != null && msg.GetIsRequest()) {
                    string method = msg.GetMethod();
                    if (method == "REGISTER") {
                        string via = msg.Header("Via");
                        int viaPort = ParsePortFromVia(via);
                        if (viaPort != clientPort) {
                            Console.WriteLine("FAIL: register via port mismatch: " + Convert.ToString(viaPort));
                            Environment.Exit(34);
                        }

                        string contact = msg.Header("Contact");
                        string wantContact = "<sip:alice@127.0.0.1:" + Convert.ToString(clientPort) + ">";
                        if (contact != wantContact) {
                            Console.WriteLine("FAIL: register contact mismatch, got: " + contact + ", want: " + wantContact);
                            Environment.Exit(35);
                        }

                        SipMessage ok = SipMessage.Response(200, "OK");
                        ok.Add("Via", via);
                        ok.Add("From", msg.Header("From"));
                        ok.Add("To", msg.Header("To") + ";tag=reg-tag-1");
                        ok.Add("Call-ID", msg.Header("Call-ID"));
                        ok.Add("CSeq", msg.Header("CSeq"));
                        ok.Add("Contact", contact);
                        ok.Add("Expires", msg.Header("Expires"));
                        await server.SendToAsync(ok.Serialize(), "127.0.0.1", viaPort);
                        done = true;
                    }
                }
            } else {
                await Task.Delay(10);
            }
        }
        server.Close();
    }

    static async Task TestSipRegisterWorkflow() {
        int serverPort = 5066;
        int clientPort = 5068;
        RunMockRegisterServer(serverPort, clientPort);
        await Task.Delay(50);

        SipClient client = new SipClient("127.0.0.1", serverPort, "alice");
        client.SetLocalIp("127.0.0.1");
        client.SetLocalSipPort(clientPort);

        SipMessage regResp = await client.RegisterAsync("alice", 3600);
        if (regResp == null || regResp.GetStatus() != 200) {
            Console.WriteLine("FAIL: register failed");
            Environment.Exit(25);
        }
        Console.WriteLine("sip register workflow ok");
    }

    static async void RunMockCancelServer(int port, int clientPort) {
        UdpClient server = UdpClient.Bind("127.0.0.1", port);
        if (server == null) { return; }

        bool done = false;
        while (!done) {
            if (Socket.IsReadable(server.GetSocket())) {
                string d = server.RecvFrom(65536);
                SipMessage msg = SipMessage.Parse(d);
                if (msg != null && msg.GetIsRequest()) {
                    string method = msg.GetMethod();
                    if (method == "CANCEL") {
                        string via = msg.Header("Via");
                        int viaPort = ParsePortFromVia(via);
                        if (viaPort != clientPort) {
                            Console.WriteLine("FAIL: cancel via port mismatch: " + Convert.ToString(viaPort));
                            Environment.Exit(36);
                        }

                        SipMessage ok = SipMessage.Response(200, "OK");
                        ok.Add("Via", via);
                        ok.Add("From", msg.Header("From"));
                        ok.Add("To", msg.Header("To"));
                        ok.Add("Call-ID", msg.Header("Call-ID"));
                        ok.Add("CSeq", msg.Header("CSeq"));
                        await server.SendToAsync(ok.Serialize(), "127.0.0.1", viaPort);
                        done = true;
                    }
                }
            } else {
                await Task.Delay(10);
            }
        }
        server.Close();
    }

    static async Task TestSipCancelWorkflow() {
        int serverPort = 5070;
        int clientPort = 5072;
        RunMockCancelServer(serverPort, clientPort);
        await Task.Delay(50);

        SipClient client = new SipClient("127.0.0.1", serverPort, "alice");
        client.SetLocalIp("127.0.0.1");
        client.SetLocalSipPort(clientPort);

        SipCall call = new SipCall("call-cancel-1", "sip:alice@127.0.0.1", "sip:charlie@127.0.0.1", "alice", 1, 50010);
        call.SetState(SipCallState.Calling);

        bool canceled = await client.CancelAsync(call);
        if (!canceled || call.GetState() != SipCallState.Terminated) {
            Console.WriteLine("FAIL: cancel call failed");
            Environment.Exit(26);
        }
        Console.WriteLine("sip cancel workflow ok");
    }

    static void TestSipSecurityAndRobustness() {
        // 1. CRLF 注入防御：Add 自动剥离控制字符与换行
        SipMessage m = new SipMessage();
        m.Add("X-Injected\r\nBad-Header", "injected-value\r\nAnother-Bad: 123");
        string serialized = m.Serialize();
        if (serialized.IndexOf("Bad-Header") >= 0 || serialized.IndexOf("Another-Bad") >= 0) {
            Console.WriteLine("FAIL: sip crlf injection not sanitized");
            Environment.Exit(40);
        }

        // 2. RFC 3261 紧凑缩写双向查询
        SipMessage m2 = new SipMessage();
        m2.Add("i", "call-id-test-999");
        m2.Add("f", "alice-from");
        m2.Add("t", "bob-to");
        if (m2.Header("Call-ID") != "call-id-test-999" || m2.Header("i") != "call-id-test-999") {
            Console.WriteLine("FAIL: compact Call-ID lookup");
            Environment.Exit(41);
        }
        if (m2.Header("From") != "alice-from" || m2.Header("f") != "alice-from") {
            Console.WriteLine("FAIL: compact From lookup");
            Environment.Exit(42);
        }
        if (m2.Header("To") != "bob-to" || m2.Header("t") != "bob-to") {
            Console.WriteLine("FAIL: compact To lookup");
            Environment.Exit(43);
        }

        // 3. 畸形 SDP 容错：非法字符不导致崩溃，回退安全默认值
        SdpMessage badSdp = SdpMessage.Parse("v=0\r\nm=audio abc RTP/AVP xyz\r\na=rtpmap:99 OPUS/notanumber\r\n");
        if (badSdp == null || badSdp.GetMediaPort() != 0 || badSdp.GetPayloadType() != 0 || badSdp.GetSampleRate() != 0) {
            Console.WriteLine("FAIL: malformed sdp recovery");
            Environment.Exit(44);
        }

        // 4. RTP 数据包越界与填充校验
        if (RtpPacket.Decode(null, 0, 10) != null) {
            Console.WriteLine("FAIL: rtp decode null buf");
            Environment.Exit(45);
        }
        byte[] tiny = new byte[8];
        if (RtpPacket.Decode(tiny, 0, 8) != null) {
            Console.WriteLine("FAIL: rtp decode tiny");
            Environment.Exit(46);
        }
        // 带 Padding 的 RTP 数据包：V=2, P=1, PT=0, seq=10, ts=20, ssrc=30, payload 4 字节，padding 2 字节（末尾为 2）
        byte[] padded = new byte[18];
        padded[0] = 160; // V=2 (128) + P=1 (32)
        padded[1] = 0;   // M=0, PT=0
        padded[2] = 0; padded[3] = 10; // seq
        padded[4] = 0; padded[5] = 0; padded[6] = 0; padded[7] = 20; // ts
        padded[8] = 0; padded[9] = 0; padded[10] = 0; padded[11] = 30; // ssrc
        padded[12] = 1; padded[13] = 2; padded[14] = 3; padded[15] = 4; // payload
        padded[16] = 0; padded[17] = 2; // padding 2 字节
        RtpPacket decPadded = RtpPacket.Decode(padded, 0, 18);
        if (decPadded == null || decPadded.GetPayload() == null || decPadded.GetPayload().Length != 4) {
            Console.WriteLine("FAIL: rtp decode padding");
            Environment.Exit(47);
        }

        Console.WriteLine("sip security and robustness ok");
    }

    static async void Main() {
        TestSdpSerializationAndParse();
        TestRtpPacketEncodeDecode();
        TestSipCallModel();
        TestSipSecurityAndRobustness();
        await TestSipCallWorkflow();
        await TestSipRegisterWorkflow();
        await TestSipCancelWorkflow();
        Console.WriteLine("ALL_SIP_TESTS_OK");
    }
}
