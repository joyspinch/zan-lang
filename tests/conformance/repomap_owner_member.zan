using System;
using System.IO;

public class Program {
    static int Main() {
        string cgFile = ".zanmap/callgraph.jsonl";
        if (!File.Exists(cgFile)) {
            Console.WriteLine($"FAIL: {cgFile} does not exist");
            return 1;
        }

        string text = File.ReadAllText(cgFile);
        if (!text.Contains("\"id\":\"File.ReadAllText\"")) {
            Console.WriteLine("FAIL: callgraph.jsonl does not contain 'File.ReadAllText' as node id");
            return 1;
        }

        if (!text.Contains("\"owner\":\"File\"")) {
            Console.WriteLine("FAIL: callgraph.jsonl does not contain 'File' as owner");
            return 1;
        }

        Console.WriteLine("repomap-owner-member-ok: 1");
        return 0;
    }
}
