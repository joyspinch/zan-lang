using System;

// A closure inside an async method captures the foreach element variable,
// and the loop body suspends: the captured value has to survive the
// suspension, and every iteration has its own variable.
class Program {
    static async void Main() {
        int[] xs = new int[] { 1, 2, 3 };
        foreach (int x in xs) {
            Func<int> f = () => x;
            await Task.Delay(1);
            Console.WriteLine("v=" + Convert.ToString(f()));
        }
        Console.WriteLine("done");
    }
}
