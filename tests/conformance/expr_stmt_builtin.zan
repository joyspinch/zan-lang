using System;
namespace Conf;

// 回归(D17):`int.Parse("abc");` 这类丢弃返回值的调用曾报语法错
// 核心契约与语义定义。
// 把「类型关键字开头」一律判成声明,于是 `int.Parse` 进了声明解析器。
// 现在类型关键字后(跳过数组档)跟 `.` 的形态走表达式语句;
// 真声明(int x = 3、int[] arr = ...)不受影响。
class Program {
    static void Main() {
        int x = 3;
        int[] arr = new int[] { 1, 2 };
        string s = "hi";
        // 丢弃返回值的表达式语句,内建类型关键字开头
        int.Parse("42");
        double.Parse("1.5");
        long.Parse("77");
        string.IsNullOrEmpty(s);
        Console.WriteLine(int.Parse("42") + 1);
        Console.WriteLine(x);
        Console.WriteLine(arr.Length);
        Console.WriteLine(s);
        Console.WriteLine("end");
    }
}
