using System;
using System.Collections.Generic;

// 长共享前缀字符串键（同簇探测链）上的 Remove/Add churn。
// 探测不变量测试：Remove 采用「删槽 + 索引整表失效、下次 find 全量重建」后本形状必须
// 保持：无挂死、值正确、count 一致、Keys 保持插入序。
class Program {
    static void Main() {
        string[] keys = new string[] {
            "Admin.System.Roles", "Admin.System.Logs", "Admin.System.Users",
            "Admin.System.Config", "Admin.System.Menus", "Admin.System.Params",
            "Admin.Monitor.Online", "Admin.Monitor.Job", "Admin.Monitor.Server",
            "Admin.Tool.Build", "Admin.Tool.Gen", "Admin.Tool.Form",
            "Admin.Workflow.Leave", "Admin.Workflow.Task", "Admin.Report.Sales",
            "Admin.Profile.User", "Admin.Profile.Password", "Admin.Profile.Security"
        };
        Dict<string, int> d = new Dict<string, int>();
        for (int i = 0; i < 18; i = i + 1) { d.Add(keys[i], i * 3); }
        for (int round = 0; round < 4; round = round + 1) {
            for (int i = 0; i < 18; i = i + 1) {
                int v;
                if (!d.TryGetValue(keys[i], out v)) { Console.WriteLine("MISS"); return; }
                if (v != i * 3) { Console.WriteLine("BADVAL"); return; }
                d.Remove(keys[i]);
                d.Add(keys[i], i * 3);
            }
        }
        Console.WriteLine(d.Count);
        Console.WriteLine(d.Keys[0]);
        Console.WriteLine(d.Keys[17]);
        int sum = 0;
        for (int i = 0; i < 18; i = i + 1) { if (d.ContainsKey(keys[i])) { sum = sum + d[keys[i]]; } }
        Console.WriteLine(sum);
        Console.WriteLine("ok");
    }
}
