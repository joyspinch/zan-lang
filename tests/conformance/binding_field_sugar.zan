using System;

namespace Conf;

/// `Binding<T> = null` clears the slot, and a bare field name binds live to
/// `this.<field>`, so a widget can hand its own fields out as bindings.
class Spec {
    Binding<string> str;
    Binding<int> num;

    Spec() {
        str = null;
        num = null;
    }

    bool Bound() { return str != null || num != null; }
}

class Widget {
    string icon;
    int size;

    Widget() {
        icon = "save";
        size = 3;
    }

    Spec Icon() {
        Spec s = new Spec();
        s.str = icon;
        return s;
    }

    Spec Size() {
        Spec s = new Spec();
        s.num = size;
        return s;
    }
}

class Program {
    static void Main() {
        Spec empty = new Spec();
        Console.WriteLine(Convert.ToString(empty.Bound()));

        Widget w = new Widget();

        Spec icon = w.Icon();
        Console.WriteLine(Convert.ToString(icon.Bound()));
        Console.WriteLine(Convert.ToString(icon.str.IsLive()));
        Console.WriteLine(icon.str.Get());
        icon.str.Set("folder");
        Console.WriteLine(w.icon);

        Spec size = w.Size();
        Console.WriteLine(Convert.ToString(size.num.Get()));
        size.num.Set(9);
        Console.WriteLine(Convert.ToString(w.size));

        // a local, not a field: the binding keeps a constant snapshot
        string local = "x";
        Spec snap = new Spec();
        snap.str = local;
        Console.WriteLine(Convert.ToString(snap.str.IsLive()));
        Console.WriteLine(snap.str.Get());
    }
}
