// nsresolve regression lock: enclosing-namespace resolution.
//   1. ns Gui declares App; ns Gui.Sub.Widget references bare App — binds
//      through the ancestor walk, and KEEPS binding when a GLOBAL-scope App
//      also exists (the design-generated shape): both collide, both get
//      mangled, each site stays on its own declaration.
//   2. Global App wins at global scope (ctx exact hit).
// Files: nsresolve_ancestor_lib.zan (namespace Gui) +
// nsresolve_ancestor_sub.zan (namespace Gui.Sub) are the explicit sources.
using System;

public static class App {
    public static string Kind() { return "global-app"; }
}

class Program {
    static int failures = 0;

    static void Check(string name, string got, string want) {
        if (got == want) {
            Console.WriteLine(name + " OK");
        } else {
            Console.WriteLine(name + " FAIL got=" + got + " want=" + want);
            failures++;
        }
    }

    static int Main() {
        Check("enclosing", Gui.Sub.Widget.AppKind(), "gui-app");
        Check("global", App.Kind(), "global-app");
        if (failures == 0) Console.WriteLine("NSRESOLVE_ANCESTOR PASS");
        return failures == 0 ? 0 : 1;
    }
}
