// The regression: bare `App` in namespace Gui.Sub must bind to Gui.App via
// the enclosing-namespace walk (Gui.Sub -> Gui), NOT via the global binder
// fallback. When nsresolve_ancestor_ns.zan's global App joins the compile
// both Apps collide and get mangled; an unrewritten bare reference would
// die as "undefined type 'App'" exactly like Zan.Gui.DataTable's
// DataTable.Export.zan did when a design-generated global App coexisted
// with the vacuumed Gui tree.
namespace Gui.Sub;

public static class Widget {
    public static string AppKind() { return App.Kind(); }
}
