using System;
using System.Collections.Generic;

// The builtin surface the self-hosted backend lowers itself: the Math
// family, string.Equals, List<T>.ToArray and the Clear methods.
class Program {
    static void Main() {
        Console.WriteLine("abs=" + Convert.ToString(Math.Abs(-3)));
        Console.WriteLine("absd=" + Convert.ToString(Math.Abs(-2.5)));
        Console.WriteLine("max=" + Convert.ToString(Math.Max(3, 7)));
        Console.WriteLine("mind=" + Convert.ToString(Math.Min(2.5, 1.5)));
        Console.WriteLine("pow=" + Convert.ToString(Math.Pow(2.0, 10.0)));
        Console.WriteLine("sqrt=" + Convert.ToString(Math.Sqrt(16.0)));
        Console.WriteLine("floor=" + Convert.ToString(Math.Floor(2.7)));
        Console.WriteLine("ceil=" + Convert.ToString(Math.Ceiling(2.1)));
        Console.WriteLine("sin=" + Convert.ToString(Math.Sin(0.0)));
        Console.WriteLine("cos=" + Convert.ToString(Math.Cos(0.0)));
        Console.WriteLine("tan=" + Convert.ToString(Math.Tan(0.0)));
        Console.WriteLine("atan=" + Convert.ToString(Math.Atan(0.0)));
        Console.WriteLine("asin=" + Convert.ToString(Math.Asin(0.0)));
        Console.WriteLine("acos=" + Convert.ToString(Math.Acos(0.0)));
        Console.WriteLine("atan2=" + Convert.ToString(Math.Atan2(0.0, 1.0)));
        Console.WriteLine("round=" + Convert.ToString(Math.Round(2.5)));
        Console.WriteLine("round2=" + Convert.ToString(Math.Round(2.345, 2)));

        Console.WriteLine("eq=" + ("abc".Equals("abc") ? "y" : "n"));
        Console.WriteLine("ne=" + ("abc".Equals("abd") ? "y" : "n"));
        Console.WriteLine("eq2=" + ("abc".Equals("abc ") ? "y" : "n"));

        List<int> nums = new List<int>();
        nums.Add(4);
        nums.Add(9);
        int[] arr = nums.ToArray();
        Console.WriteLine("alen=" + Convert.ToString(arr.Length));
        Console.WriteLine("a0=" + Convert.ToString(arr[0]));
        Console.WriteLine("a1=" + Convert.ToString(arr[1]));

        Dictionary<string, int> d = new Dictionary<string, int>();
        d.Add("k", 1);
        d.Clear();
        Console.WriteLine("dcount=" + Convert.ToString(d.Count));

        StringBuilder sb = new StringBuilder();
        sb.Append("hello");
        sb.Clear();
        Console.WriteLine("sblen=" + Convert.ToString(sb.Length));
    }
}
