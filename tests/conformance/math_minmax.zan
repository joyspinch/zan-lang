// Conformance: Math.Max / Math.Min / Math.Abs across the operand types C#
// accepts. Max/Min used to compare their operands as signed integers no matter
// what they were, so a double pair reached `icmp` on a double and killed the
// compiler; mixing an int with a long compared values of different widths.
// Abs shifted by a hardcoded 31, which is not the sign bit of a long.
using System;

class MathMinMax {
    static void Main() {
        // Doubles: the comparison decides the value, and the result stays a
        // double (x.5 survives the round trip through *10).
        double a = 1.5;
        double b = 2.5;
        Console.WriteLine("dmax " + (long)(Math.Max(a, b) * 10.0));
        Console.WriteLine("dmin " + (long)(Math.Min(a, b) * 10.0));
        Console.WriteLine("dmax neg " + (long)(Math.Max(-4.25, -8.5) * 100.0));
        Console.WriteLine("dmin neg " + (long)(Math.Min(-4.25, -8.5) * 100.0));

        // Literals, and a mixed int/double pair: C# picks the double overload.
        Console.WriteLine("lit " + (long)(Math.Max(0.5, 0.25) * 100.0));
        Console.WriteLine("mixed " + (long)(Math.Max(2, 1.5) * 10.0));
        Console.WriteLine("mixed min " + (long)(Math.Min(2, 1.5) * 10.0));

        // Integers of the same and of different widths.
        int i = 7;
        int j = -9;
        long big = 5000000000;
        Console.WriteLine("imax " + Math.Max(i, j));
        Console.WriteLine("imin " + Math.Min(i, j));
        Console.WriteLine("lmax " + Math.Max(i, big));
        Console.WriteLine("lmin " + Math.Min(big, (long)i));

        // Abs, including a magnitude that does not fit in 32 bits.
        Console.WriteLine("abs int " + Math.Abs(-7));
        Console.WriteLine("abs int var " + Math.Abs(j));
        Console.WriteLine("abs long " + Math.Abs(-5000000001));
        Console.WriteLine("abs long var " + Math.Abs(0 - big));
        Console.WriteLine("abs double " + (long)(Math.Abs(-2.5) * 10.0));
    }
}
