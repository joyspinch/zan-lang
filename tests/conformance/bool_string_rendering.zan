using System;

// One bool, several string paths. They must all render the C# way --
// "true" / "false" -- and never as the integer 1/0. The host used to print
// "1" for `Convert.ToString(b)` and "x1" for `"x" + b` while `b.ToString()`
// printed "true"; the self-host had the same split on its own side.
class Program {
    static void Main() {
        bool b = true;
        bool f = false;
        Console.WriteLine(b);
        Console.WriteLine(b.ToString());
        Console.WriteLine(Convert.ToString(b));
        Console.WriteLine("x" + b);
        Console.WriteLine($"{b}");
        Console.WriteLine(Convert.ToString(f));
        Console.WriteLine("y" + f);
        Console.WriteLine($"{f}");
        Console.WriteLine(f.ToString());
    }
}
