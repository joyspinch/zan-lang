using System;

// Getter results carry +1 even when the instance is a static singleton.
// --check-leaks must see no surviving objects after normal static cleanup.
interface ISoloReceiver {
    int Run(int mode);
}

interface IChoiceReceiver {
    int Run(int mode);
}

class SoloReceiver : ISoloReceiver {
    public int Run(int mode) {
        if (mode == 1) { throw new Exception("solo"); }
        return 11;
    }
}

class ChoiceReceiverA : IChoiceReceiver {
    public int Run(int mode) {
        if (mode == 1) { throw new Exception("choice-a"); }
        return 21;
    }
}

class ChoiceReceiverB : IChoiceReceiver {
    public int Run(int mode) {
        if (mode == 1) { throw new Exception("choice-b"); }
        return 22;
    }
}

class Program {
    static ISoloReceiver solo = new SoloReceiver();
    static IChoiceReceiver choiceA = new ChoiceReceiverA();
    static IChoiceReceiver choiceB = new ChoiceReceiverB();
    static ISoloReceiver Solo { get { return Program.solo; } }
    static IChoiceReceiver ChoiceA { get { return Program.choiceA; } }
    static IChoiceReceiver ChoiceB { get { return Program.choiceB; } }

    static void Require(bool value) {
        if (!value) { throw new Exception("receiver ownership mismatch"); }
    }

    static int ThrowArgument() {
        throw new Exception("argument");
        return 0;
    }

    static void Main() {
        int caught = 0;
        for (int i = 0; i < 3; i = i + 1) {
            try { Program.Solo.Run(1); }
            catch (Exception) { caught = caught + 1; }
            try { Program.ChoiceA.Run(1); }
            catch (Exception) { caught = caught + 1; }
            try { Program.ChoiceB.Run(1); }
            catch (Exception) { caught = caught + 1; }

            // Receiver must already be armed before argument evaluation.
            try { Program.Solo.Run(Program.ThrowArgument()); }
            catch (Exception) { caught = caught + 1; }
            try { Program.ChoiceA.Run(Program.ThrowArgument()); }
            catch (Exception) { caught = caught + 1; }

            Program.Require(Program.Solo.Run(0) == 11);
            Program.Require(Program.ChoiceA.Run(0) == 21);
            Program.Require(Program.ChoiceB.Run(0) == 22);
        }
        Program.Require(caught == 15);
        Console.WriteLine("owned-interface-receivers");

        // Borrowed field/local receivers must not be consumed by unwinding.
        try { Program.solo.Run(1); }
        catch (Exception) { caught = caught + 1; }
        ISoloReceiver borrowed = Program.solo;
        try { borrowed.Run(1); }
        catch (Exception) { caught = caught + 1; }
        Program.Require(borrowed.Run(0) == 11);
        Program.Require(Program.solo.Run(0) == 11);
        Program.Require(caught == 17);
        Console.WriteLine("borrowed-interface-receivers");
    }
}
