using System;

class Animal { public string Name; }
class Dog : Animal { public int BarkCount; }
class Cat : Animal { public int MeowCount; }

class Program {
    static int Main() {
        int fails = 0;

        // sizeof reports the real store width, not a constant
        if (sizeof(int) != 4) { fails = fails + 1; }
        if (sizeof(long) != 8) { fails = fails + 1; }
        if (sizeof(byte) != 1) { fails = fails + 1; }

        // is/as from object: runtime class decides
        object a = new Dog();
        if (!(a is Animal)) { fails = fails + 1; }
        if (!(a is Dog)) { fails = fails + 1; }
        if (a is Cat) { fails = fails + 1; }
        Dog d = a as Dog;
        if (d == null) { fails = fails + 1; }
        Cat c = a as Cat;
        if (c != null) { fails = fails + 1; }

        // is/as from a base-typed reference: downcast checks the runtime class
        Animal pet = new Cat();
        if (!(pet is Cat)) { fails = fails + 1; }
        if (pet is Dog) { fails = fails + 1; }
        Cat c2 = pet as Cat;
        if (c2 == null) { fails = fails + 1; }
        Dog d2 = pet as Dog;
        if (d2 != null) { fails = fails + 1; }

        // null never matches a type
        Animal n = null;
        if (n is Animal) { fails = fails + 1; }
        if (n is Dog) { fails = fails + 1; }
        Dog d3 = n as Dog;
        if (d3 != null) { fails = fails + 1; }

        if (fails == 0) { Console.WriteLine("OK"); return 0; }
        Console.WriteLine("FAIL " + Convert.ToString(fails));
        return 1;
    }
}
