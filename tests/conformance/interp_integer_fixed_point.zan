using System;

// 整数配定点格式（{v:Fn}）按整数精确输出再补零，与 C# 一致：ulong 超过 2^63
// 曾经走有符号转 double 变成负数，大整数也会被 double 舍入。小数位过长时退回浮点路径。
class Program {
    static void Main() {
        ulong u = 18446744073709551615;
        ulong v = 10000000000000000000;
        long n = -5;
        int k = 42;
        long big = 9007199254740993;
        double d = 2.5;
        Console.WriteLine($"{u:F0}|{v:F1}|{n:F2}|{k:F3}|{big:F0}|{d:F2}");
        Console.WriteLine($"{k:F30}");
    }
}
