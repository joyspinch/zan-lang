// Publish-time design auto-embed: the DesignDoc. token below is the gate
// signal — `zanc --publish` must discover and encrypt src/page.html on its
// own (no explicit --embed). Skipped subtrees (src/docs) must stay out, and
// the program must read the design through the embedded VFS from a run
// directory that has no src/ on disk. The secret marker lives ONLY in the
// html asset (length + prefix here, never the marker itself) so the
// runner's plaintext check sees exactly one bake.
using System;
using System.IO;

class Program {
    static void Main() {
        Console.WriteLine("has=" + (File.EmbedExists("src/page.html") ? 1 : 0));
        string html = File.ReadAllText("src/page.html");
        Console.WriteLine("len=" + (html == null ? -1 : html.Length));
        int head = 0;
        if (html != null && html.Substring(0, 12) == "<html><body>") { head = 1; }
        Console.WriteLine("head=" + head);
        Console.WriteLine("hidden=" + (File.EmbedExists("src/docs/hidden.html") ? 1 : 0));
        List<string> names = File.EmbeddedNames("");
        Console.WriteLine("names=" + (names == null ? -1 : names.Count));
    }
}
