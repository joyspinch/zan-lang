// Publish-time design auto-embed: the " : Form" window-class marker below is
// the gate signal — `zanc --publish` must discover and encrypt src/page.html on
// its own. The explicit alias and automatic name must both read the embedded
// design from a directory without src/. Skipped subtrees stay out.
using System;
using System.IO;
using Gui;

class PageWin : Form {
}

class Program {
    static void Main() {
        Console.WriteLine("has=" + (File.EmbedExists("src/page.html") ? 1 : 0));
        string html = File.ReadAllText("src/page.html");
        Console.WriteLine("len=" + (html == null ? -1 : html.Length));
        int head = 0;
        if (html != null && html.Substring(0, 12) == "<html><body>") { head = 1; }
        Console.WriteLine("head=" + head);
        string alias = "views/start.html";
        Console.WriteLine("alias=" + (File.EmbedExists(alias) && File.ReadAllText(alias) == html ? 1 : 0));
        byte[] originalBytes = File.ReadAllBytes("src/page.html");
        byte[] aliasBytes = File.ReadAllBytes(alias);
        bool same = originalBytes != null && aliasBytes != null && originalBytes.Length == aliasBytes.Length;
        for (int i = 0; same && i < originalBytes.Length; i++) {
            same = originalBytes[i] == aliasBytes[i];
        }
        Console.WriteLine("bytes=" + (same ? 1 : 0));
        byte[] length = new byte[8];
        nint payload = File.zan_embed_bytes("src/page.html", length);
        Console.WriteLine("shared=" + (payload != 0 && payload == File.zan_embed_bytes(alias, length) ? 1 : 0));
        Console.WriteLine("alias-size=" + File.GetSize(alias));
        Console.WriteLine("hidden=" + (File.EmbedExists("src/docs/hidden.html") ? 1 : 0));
        List<string> names = File.EmbeddedNames("");
        Console.WriteLine("names=" + (names == null ? -1 : names.Count));
    }
}
