using System;
using System.Compiler;

// GenForm 列级点击事件脱糖单测：columns[i].click 必须生成
// 一条按 HitField 分派的 CellClick 绑定；无 click 的列不生成。
class GenFormClickTest {
    static int fails;

    static void Ok(string what, bool cond) {
        if (cond) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static void Main() {
        JsonValue cols = JsonValue.ParseLenient(
            "[{\"field\":\"planId\",\"title\":\"计划ID\",\"width\":110,"
            + "\"click\":\"OnPlanClick\",\"dblclick\":\"OnPlanDblClick\"},"
            + "{\"field\":\"title\",\"title\":\"主体名称\"}]");
        JsonValue o = JsonValue.NewObject();
        o.Put("kind", JsonValue.NewStr("DataGrid"));
        o.Put("columns", cols);
        o.Put("onRowClick", JsonValue.NewStr("OnRow"));

        StringBuilder wire = new StringBuilder();
        GenForm.EmitHandlers(wire, o, "grid1", "App.Dispatch");
        string outp = wire.ToString();

        Ok("colclick binding emitted",
           outp.Contains("BindEvent(\"CellClick\", () => {"));
        Ok("coldblclick binding emitted",
           outp.Contains("BindEvent(\"CellDoubleClick\", () => {"));
        Ok("colclick dispatches by field",
           outp.Contains("grid1.HitField() == \"planId\""));
        Ok("colclick handler name",
           outp.Contains("App.Dispatch(\"OnPlanClick\")"));
        Ok("coldblclick handler name",
           outp.Contains("App.Dispatch(\"OnPlanDblClick\")"));
        Ok("grid handler still wired",
           outp.Contains("BindEvent(\"RowClick\""));
        Ok("col without click skipped",
           !outp.Contains("\"title\") { App.Dispatch"));

        // 无 click 的 columns：不生成 CellClick 复合绑定。
        JsonValue cols2 = JsonValue.ParseLenient(
            "[{\"field\":\"a\",\"title\":\"A\"}]");
        JsonValue o2 = JsonValue.NewObject();
        o2.Put("columns", cols2);
        StringBuilder wire2 = new StringBuilder();
        GenForm.EmitHandlers(wire2, o2, "grid2", "App.Dispatch");
        Ok("no click no binding", !wire2.ToString().Contains("HitField"));

        // ToolStrip items[i].click 脱糖验证：
        // items[i].click 必须生成按 LastIndex() 分派的 ItemClick 绑定
        JsonValue items = JsonValue.ParseLenient(
            "[{\"label\":\"新建\",\"click\":\"OnNew\"},"
            + "{\"label\":\"保存\",\"click\":\"OnSave\"},"
            + "{\"label\":\"关于\"}]");
        JsonValue o3 = JsonValue.NewObject();
        o3.Put("kind", JsonValue.NewStr("ToolStrip"));
        o3.Put("items", items);
        StringBuilder wire3 = new StringBuilder();
        GenForm.EmitHandlers(wire3, o3, "bar1", "App.Dispatch");
        string outp3 = wire3.ToString();

        Ok("tool item click binding emitted",
           outp3.Contains("bar1.BindEvent(\"ItemClick\", () => {"));
        // 带参事件：ToolStrip 项级点击把被点项所属控件作为第二个实参传给
        // 处理器（02f61f69e 起 GenForm.EmitHandlers 就是这个形状）。
        Ok("tool item 0 dispatches OnNew",
           outp3.Contains("if (bar1.LastIndex() == 0) { App.Dispatch(\"OnNew\", bar1); }"));
        Ok("tool item 1 dispatches OnSave",
           outp3.Contains("if (bar1.LastIndex() == 1) { App.Dispatch(\"OnSave\", bar1); }"));
        Ok("tool item 2 without click skipped",
           !outp3.Contains("LastIndex() == 2"));

        Console.WriteLine(fails == 0 ? "GENFORM_CLICK_OK" : "GENFORM_CLICK_FAIL");
    }
}
