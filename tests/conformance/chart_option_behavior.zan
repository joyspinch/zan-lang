using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

/// 阶段二可观察行为的纯函数断言：showLegend 关闭不改变饼图几何、
/// radarMax 每轴独立上限、markPoint 窗口内极值推导、donutPct
/// 默认与显式 innerPct、pieRings 环模式开关。全部通过
/// (模型 -> 布局/推导) 的纯 seam 验证，不触碰 App/Canvas。
class Program {
    static void Main() {
        // ---- showLegend=false：选项/解析链保持关闭，饼图几何不变 ----
        Console.WriteLine("legendDefault:" + Convert.ToString(ChartOption.Create().showLegend));
        ChartOption o = ChartOption.Create();
        o.showLegend = false;
        ChartOption drawn = ResolvedChart.Resolve(o, Theme.Light(), null, 0).DrawOption(0, false);
        Console.WriteLine("legendDrawn:" + Convert.ToString(drawn.showLegend));

        ChartSeries p = ChartSeries.Pie("P", new List<int>{4, 6});
        ChartOption op = ChartOption.Create();
        op.series = new List<ChartSeries>{p};
        PieLayout l1 = PieLayout.Of(Theme.Light(), op);
        op.showLegend = false;
        PieLayout l2 = PieLayout.Of(Theme.Light(), op);
        Console.WriteLine("pieStable:" + Convert.ToString(l1.slices.Count == l2.slices.Count)
            + ":" + Convert.ToString(l1.total == l2.total));

        // ---- radarMax：每轴独立上限；显式值优先，0 = 按数据推导 ----
        ChartSeries s1 = ChartSeries.Polar("R1", new List<int>{3, 9});
        ChartSeries s2 = ChartSeries.Polar("R2", new List<int>{7, 4});
        ChartOption ro = ChartOption.Create();
        ro.series = new List<ChartSeries>{s1, s2};
        Console.WriteLine("axis0:" + Convert.ToString(ChartView.RadarAxisMax(ro.series, ro.radarMax, 0)));
        Console.WriteLine("axis1:" + Convert.ToString(ChartView.RadarAxisMax(ro.series, ro.radarMax, 1)));
        ro.radarMax = new List<int>{0, 15};
        Console.WriteLine("explicit0:" + Convert.ToString(ChartView.RadarAxisMax(ro.series, ro.radarMax, 0)));
        Console.WriteLine("explicit1:" + Convert.ToString(ChartView.RadarAxisMax(ro.series, ro.radarMax, 1)));
        Console.WriteLine("radarWrap:" + Convert.ToString(ChartView.RadarAxisAt(350, 4))
            + ":" + Convert.ToString(ChartView.RadarAxisAt(359, 4))
            + ":" + Convert.ToString(ChartView.RadarAxisAt(0, 4))
            + ":" + Convert.ToString(ChartView.RadarAxisAt(90, 4))
            + ":" + Convert.ToString(ChartView.RadarAxisAt(180, 4))
            + ":" + Convert.ToString(ChartView.RadarAxisAt(270, 4)));

        // ---- markPoint：窗口内 max/min 下标推导 ----
        ChartSeries line = ChartSeries.Line("L", new List<int>{5, 9, 2, 8, 3});
        Console.WriteLine("maxAt:" + Convert.ToString(ChartView.SeriesMaxIndex(line, 0, 4)));
        Console.WriteLine("minAt:" + Convert.ToString(ChartView.SeriesMinIndex(line, 0, 4)));
        Console.WriteLine("winMaxAt:" + Convert.ToString(ChartView.SeriesMaxIndex(line, 3, 4)));
        Console.WriteLine("winMinAt:" + Convert.ToString(ChartView.SeriesMinIndex(line, 3, 4)));
        Console.WriteLine("noData:" + Convert.ToString(ChartView.SeriesMaxIndex(line, 5, 9)));

        // ---- donutPct：默认 55；Donut 系列 innerPct=55；显式 innerPct 覆盖 ----
        Console.WriteLine("donutDefault:" + Convert.ToString(ChartOption.Create().donutPct));
        ChartSeries donut = ChartSeries.Donut("D", new List<int>{1, 2});
        ChartOption od = ChartOption.Create();
        od.series = new List<ChartSeries>{donut};
        PieLayout dl = PieLayout.Of(Theme.Light(), od);
        Console.WriteLine("donutInner:" + Convert.ToString(dl.ringInner[0]));
        ChartSeries explicitInner = ChartSeries.Pie("E", new List<int>{1, 2});
        explicitInner.innerPct = 30;
        ChartOption oe = ChartOption.Create();
        oe.series = new List<ChartSeries>{explicitInner};
        PieLayout el = PieLayout.Of(Theme.Light(), oe);
        Console.WriteLine("explicitInner:" + Convert.ToString(el.ringInner[0]));

        // ---- pieRings：开关切换环数，扇区数不变（合并 vs 分层） ----
        ChartSeries r1 = ChartSeries.Pie("R1", new List<int>{1, 2});
        ChartSeries r2 = ChartSeries.Pie("R2", new List<int>{3});
        ChartOption or = ChartOption.Create();
        or.pieRings = true;
        or.series = new List<ChartSeries>{r1, r2};
        PieLayout lr = PieLayout.Of(Theme.Light(), or);
        Console.WriteLine("rings:" + Convert.ToString(lr.ringCount)
            + ":" + Convert.ToString(lr.slices.Count)
            + ":" + Convert.ToString(lr.total));
        ChartOption or2 = ChartOption.Create();
        or2.pieRings = false;
        or2.series = new List<ChartSeries>{r1, r2};
        PieLayout lr2 = PieLayout.Of(Theme.Light(), or2);
        Console.WriteLine("single:" + Convert.ToString(lr2.ringCount)
            + ":" + Convert.ToString(lr2.slices.Count)
            + ":" + Convert.ToString(lr2.total));

        // ---- symbol 形状族：Sanitize 白名单、SymbolRadius 换算 ----
        Console.WriteLine("san:" + ChartKinds.SymbolSanitize("diamond")
            + "|" + ChartKinds.SymbolSanitize("emptyCircle")
            + "|" + ChartKinds.SymbolSanitize("star")
            + "|" + ChartKinds.SymbolSanitize(""));
        Console.WriteLine("sr:" + Convert.ToString(Chart.SymbolRadius(0, 4))
            + ":" + Convert.ToString(Chart.SymbolRadius(12, 4))
            + ":" + Convert.ToString(Chart.SymbolRadius(1, 4)));

        // ---- 默认值：symbol 空、尺寸自动、showSymbol 自动；逐项 size ----
        ChartSeries def = ChartSeries.Line("D", new List<int>{1});
        Console.WriteLine("symDef:" + def.symbol + "|" + Convert.ToString(def.symbolSize)
            + "|" + Convert.ToString(def.showSymbol) + "|" + Convert.ToString(def.data[0].sizeSet));
        ChartData sized = ChartData.Named(5, "x");
        sized.size = 9;
        sized.sizeSet = true;
        Console.WriteLine("sized:" + Convert.ToString(sized.size) + ":" + Convert.ToString(sized.sizeSet));
        ChartPoint pt = ChartPoint.Sized(3, 4, 10);
        Console.WriteLine("pt:" + Convert.ToString(pt.size) + ":" + Convert.ToString(pt.sizeSet)
            + ":" + Convert.ToString(pt.color) + ":" + Convert.ToString(ChartPoint.Of(1, 2).sizeSet));
        ChartNode nd = ChartNode.Shaped("N", 7, "triangle", 12);
        Console.WriteLine("node:" + nd.symbol + ":" + Convert.ToString(nd.size)
            + ":" + ChartNode.Leaf("L", 1).symbol);

        // ---- 指纹：symbol / symbolSize / 逐项 size 变像素必须变指纹 ----
        ChartSeries fp = ChartSeries.OfPoints("F", new List<ChartPoint>());
        fp.points = new List<ChartPoint>{ ChartPoint.Of(1, 2), ChartPoint.Of(3, 4) };
        ChartOption fo = ChartOption.Single(fp);
        int h0 = ChartView.FingerprintCore(1, 0, 100, fo,
            ResolvedChart.Resolve(fo, Theme.Light(), null, 0));
        ChartSeries f2 = ChartSeries.OfPoints("F", new List<ChartPoint>());
        f2.points = fp.points;
        f2.symbol = "diamond";
        ChartOption f2o = ChartOption.Single(f2);
        int h1 = ChartView.FingerprintCore(1, 0, 100, f2o,
            ResolvedChart.Resolve(f2o, Theme.Light(), null, 0));
        Console.WriteLine("fpsym:" + Convert.ToString(h0 != h1));
        fp.symbolSize = 10;
        int h2 = ChartView.FingerprintCore(1, 0, 100, fo,
            ResolvedChart.Resolve(fo, Theme.Light(), null, 0));
        Console.WriteLine("fpsize:" + Convert.ToString(h0 != h2));
        ChartOption fo3 = ChartOption.Single(ChartSeries.Line("S", new List<int>{1, 2}));
        int h3 = ChartView.FingerprintCore(1, 0, 100, fo3,
            ResolvedChart.Resolve(fo3, Theme.Light(), null, 0));
        fo3.series[0].data[0].size = 8;
        fo3.series[0].data[0].sizeSet = true;
        int h4 = ChartView.FingerprintCore(1, 0, 100, fo3,
            ResolvedChart.Resolve(fo3, Theme.Light(), null, 0));
        Console.WriteLine("fpdata:" + Convert.ToString(h3 != h4));

        // ---- 轴标签 seam：interval 抽稀 + 旋转占位（整数三角表） ----
        Console.WriteLine("shown:" + Convert.ToString(Chart.LabelShown(3, 0 - 1))
            + ":" + Convert.ToString(Chart.LabelShown(3, 0))
            + ":" + Convert.ToString(Chart.LabelShown(4, 1))
            + ":" + Convert.ToString(Chart.LabelShown(5, 1))
            + ":" + Convert.ToString(Chart.LabelShown(6, 2)));
        int rh0 = Chart.RotatedLabelH(60, 14, 0);
        int rh45 = Chart.RotatedLabelH(60, 14, 0 - 45);
        int rh90 = Chart.RotatedLabelH(60, 14, 90);
        Console.WriteLine("rotH:" + Convert.ToString(rh0) + ":" + Convert.ToString(rh45)
            + ":" + Convert.ToString(rh90) + ":"
            + Convert.ToString(rh0 < rh45 && rh45 < rh90));

        // ---- markLine 推导：average/min/max 从窗口取，显式线用 yValue ----
        ChartSeries ms = ChartSeries.Line("M", new List<int>{10, 20, 30, 40});
        ChartMarkLine mAvg = ChartMarkLine.Average();
        ChartMarkLine mMin = ChartMarkLine.Min();
        ChartMarkLine mMax = ChartMarkLine.Max();
        ChartMarkLine mAt = ChartMarkLine.At(25, "threshold {value}");
        Console.WriteLine("ml:" + Convert.ToString(ChartView.MarkLineValue(mAvg, ms, 0, 3))
            + ":" + Convert.ToString(ChartView.MarkLineValue(mMin, ms, 1, 2))
            + ":" + Convert.ToString(ChartView.MarkLineValue(mMax, ms, 0, 1))
            + ":" + Convert.ToString(ChartView.MarkLineValue(mAt, ms, 0, 3))
            + ":" + mAt.label);
        Console.WriteLine("mlEmpty:" + Convert.ToString(
            ChartView.MarkLineValue(mMax, ms, 4, 9) == ChartOption.Auto()));
        // 系列 markLine 链 + 默认线型
        ChartSeries chain = ChartSeries.Line("C", new List<int>{1}).MarkLine(mAvg);
        Console.WriteLine("chain:" + Convert.ToString(chain.markLines.Count)
            + ":" + chain.markLines[0].kind
            + ":" + ChartMarkLine.Of("").lineType
            + ":" + ChartSeries.Line("N", new List<int>{1}).markLines.Count);

        // ---- 指纹：轴 rotate/interval/nameLocation、markLine 变像素必须变指纹 ----
        ChartOption ax = ChartOption.With(ChartType.Line, "T", new List<string>{"a", "b"});
        ax.Add(ChartSeries.Line("S", new List<int>{1, 2}));
        int a0 = ChartView.FingerprintCore(1, 0, 100, ax,
            ResolvedChart.Resolve(ax, Theme.Light(), null, 0));
        ax.xAxes[0].labelRotate = 45;
        int a1 = ChartView.FingerprintCore(1, 0, 100, ax,
            ResolvedChart.Resolve(ax, Theme.Light(), null, 0));
        ax.xAxes[0].labelRotate = 0;
        ax.xAxes[0].labelInterval = 1;
        int a2 = ChartView.FingerprintCore(1, 0, 100, ax,
            ResolvedChart.Resolve(ax, Theme.Light(), null, 0));
        ax.xAxes[0].labelInterval = 0 - 1;
        ax.xAxes[0].nameLocation = "end";
        int a3 = ChartView.FingerprintCore(1, 0, 100, ax,
            ResolvedChart.Resolve(ax, Theme.Light(), null, 0));
        Console.WriteLine("fpaxis:" + Convert.ToString(a0 != a1)
            + ":" + Convert.ToString(a0 != a2) + ":" + Convert.ToString(a0 != a3));
        ChartOption mo = ChartOption.Single(ChartSeries.Line("S", new List<int>{1, 2}));
        int b0 = ChartView.FingerprintCore(1, 0, 100, mo,
            ResolvedChart.Resolve(mo, Theme.Light(), null, 0));
        mo.series[0].MarkLine(ChartMarkLine.Average());
        int b1 = ChartView.FingerprintCore(1, 0, 100, mo,
            ResolvedChart.Resolve(mo, Theme.Light(), null, 0));
        mo.series[0].markLines[0].lineType = "dotted";
        int b2 = ChartView.FingerprintCore(1, 0, 100, mo,
            ResolvedChart.Resolve(mo, Theme.Light(), null, 0));
        Console.WriteLine("fpml:" + Convert.ToString(b0 != b1) + ":" + Convert.ToString(b1 != b2));

        // ---- 批 3：HBar 坐标 seam（负值零基线 + 窗口抽稀索引映射） ----
        // 横向数值映射 lo..hi -> plotX..plotX+plotW（span<=0 钳 1）。
        Console.WriteLine("vx:" + Convert.ToString(Chart.ValueX(0, 100, 0 - 10, 10, 0))
            + ":" + Convert.ToString(Chart.ValueX(0, 100, 0 - 10, 10, 0 - 10))
            + ":" + Convert.ToString(Chart.ValueX(0, 100, 0 - 10, 10, 10))
            + ":" + Convert.ToString(Chart.ValueX(0, 100, 0, 0, 5))
            + ":" + Convert.ToString(Chart.ValueX(20, 80, 100, 200, 150)));
        // 堆叠柱窗口累加最大值与 MarkLineValue 窗口 seam 复用（横向共享）。
        Console.WriteLine("avgWin:" + Convert.ToString(
            ChartView.SeriesAverage(ms, 0, 3)) + ":" + Convert.ToString(
            ChartView.SeriesAverage(ms, 2, 3)));
        // hbar 标志影响指纹（同一组数据横竖布局必须变指纹）。
        ChartOption ho = ChartOption.Of("H", new List<string>{"a", "b"},
            new List<ChartSeries>{ ChartSeries.Bar("B", new List<int>{ 1, 2 }) });
        int hc0 = ChartView.FingerprintCore(1, 0, 100, ho,
            ResolvedChart.Resolve(ho, Theme.Light(), null, 0));
        ho.series[0].hbar = true;
        int hc1 = ChartView.FingerprintCore(1, 0, 100, ho,
            ResolvedChart.Resolve(ho, Theme.Light(), null, 0));
        Console.WriteLine("fphbar:" + Convert.ToString(hc0 != hc1));

        // ---- 批 4：selectedMode 白名单 / radarShape+radarSplitArea 指纹 ----
        Console.WriteLine("selm:" + ChartKinds.SelectedModeSanitize("multiple")
            + "|" + ChartKinds.SelectedModeSanitize("single")
            + "|" + ChartKinds.SelectedModeSanitize("bogus")
            + "|" + Convert.ToString(ChartKinds.SelectedModeEnabled("false") ? 1 : 0)
            + ":" + Convert.ToString(ChartKinds.SelectedModeEnabled("multiple") ? 1 : 0));
        ChartOption rd = ChartOption.Of("R", new List<string>{"a", "b", "c"},
            new List<ChartSeries>{ ChartSeries.Polar("P", new List<int>{ 5, 8, 3 }) });
        int rd0 = ChartView.FingerprintCore(1, 0, 100, rd,
            ResolvedChart.Resolve(rd, Theme.Light(), null, 0));
        rd.radarShape = "polygon";
        int rd1 = ChartView.FingerprintCore(1, 0, 100, rd,
            ResolvedChart.Resolve(rd, Theme.Light(), null, 0));
        rd.radarShape = "circle";
        rd.radarSplitArea = true;
        int rd2 = ChartView.FingerprintCore(1, 0, 100, rd,
            ResolvedChart.Resolve(rd, Theme.Light(), null, 0));
        Console.WriteLine("fpradar:" + Convert.ToString(rd0 != rd1)
            + ":" + Convert.ToString(rd0 != rd2));
        ChartOption sm = ChartOption.Of("M", new List<string>{"a"},
            new List<ChartSeries>{ ChartSeries.Line("S", new List<int>{ 1 }) });
        sm.series[0].selectedMode = "multiple";
        int sm0 = ChartView.FingerprintCore(1, 0, 100, sm,
            ResolvedChart.Resolve(sm, Theme.Light(), null, 0));
        ChartOption sm2 = ChartOption.Of("M", new List<string>{"a"},
            new List<ChartSeries>{ ChartSeries.Line("S", new List<int>{ 1 }) });
        int sm1 = ChartView.FingerprintCore(1, 0, 100, sm2,
            ResolvedChart.Resolve(sm2, Theme.Light(), null, 0));
        Console.WriteLine("fpsel:" + Convert.ToString(sm0 != sm1));

        // ---- 批 5：legend formatter / dataRange 纯 seam 与指纹敏感度 ----
        Console.WriteLine("lgfmt:" + Chart.LegendLabel("", "A")
            + ":" + Chart.LegendLabel("系列-{name}", "A"));
        Console.WriteLine("drmap:" + Convert.ToString(Chart.DataRangeValue(0, 100, 0))
            + ":" + Convert.ToString(Chart.DataRangeValue(0, 100, 500))
            + ":" + Convert.ToString(Chart.DataRangeValue(0, 100, 1000))
            + ":" + Convert.ToString(Chart.DataRangeValue(0, 100, 2000))
            + ":" + Convert.ToString(Chart.DataRangeValue(50, 10, 300)));
        ChartOption ld = ChartOption.Of("D", new List<string>{"a"},
            new List<ChartSeries>{ ChartSeries.Line("S", new List<int>{ 1 }) });
        int ld0 = ChartView.FingerprintCore(1, 0, 100, ld,
            ResolvedChart.Resolve(ld, Theme.Light(), null, 0));
        ld.legendOrient = "vertical";
        int ld1 = ChartView.FingerprintCore(1, 0, 100, ld,
            ResolvedChart.Resolve(ld, Theme.Light(), null, 0));
        ld.legendFormatter = "[{name}]";
        int ld2 = ChartView.FingerprintCore(1, 0, 100, ld,
            ResolvedChart.Resolve(ld, Theme.Light(), null, 0));
        ld.dataRangeShow = true;
        ld.dataRangeCalculable = true;
        int ld3 = ChartView.FingerprintCore(1, 0, 100, ld,
            ResolvedChart.Resolve(ld, Theme.Light(), null, 0));
        ld.dataRangeList.Add(ChartRangeSplit.Of("低", 0, 50));
        int ld4 = ChartView.FingerprintCore(1, 0, 100, ld,
            ResolvedChart.Resolve(ld, Theme.Light(), null, 0));
        Console.WriteLine("fpdr:" + Convert.ToString(ld0 != ld1)
            + ":" + Convert.ToString(ld1 != ld2)
            + ":" + Convert.ToString(ld2 != ld3)
            + ":" + Convert.ToString(ld3 != ld4)
            + ":" + Convert.ToString(ld0 != ld4));

        // ---- 批 A4：dataRange.hoverLink 字段链（JSON → DrawOption 抄写；
        // HoverHighlight 未悬停/未开启时恒假，不改变默认观感）----
        ChartOption hl = ChartOption.FromJson(
            "{\"dataRange\":{\"show\":true,\"hoverLink\":true,\"min\":10,\"max\":90},"
            + "\"series\":[{\"type\":\"scatter\",\"name\":\"s\",\"points\":"
            + "[{\"x\":1,\"y\":30}]}]}");
        Console.WriteLine("hlJson:" + Convert.ToString(hl.dataRangeHoverLink));
        ChartOption hlDraw = ResolvedChart.Resolve(hl, Theme.Light(), null, 0)
            .DrawOption(9, false);
        Console.WriteLine("hlDr:" + Convert.ToString(hlDraw.dataRangeHoverLink));
        // HoverHighlight 需要 App state——无 App 时 iwid!=0 但 StateGet 仍可用
        // （App 为 null 时返回默认值 0 → 未悬停 → 恒假）。
        Console.WriteLine("hlOff:" + Convert.ToString(
            ChartViewDataRange.HoverHighlight(null, hlDraw, 10, 90, 30)));

        // ---- connect() 组：字段解析 + 指纹敏感度（跨图联动的
        // 键基址随组号变化，缓存须随其失效）----
        ChartOption cg0 = ChartOption.Of("CG", new List<string>{"a"},
            new List<ChartSeries>{ ChartSeries.Line("S", new List<int>{ 1 }) });
        Console.WriteLine("cgDef:" + Convert.ToString(cg0.connectGroup)
            + ":" + Convert.ToString(cg0.ConnectGroup(42).connectGroup));
        int cgF0 = ChartView.FingerprintCore(1, 0, 100, cg0,
            ResolvedChart.Resolve(cg0, Theme.Light(), null, 0));
        cg0.connectGroup = 0;
        int cgF1 = ChartView.FingerprintCore(1, 0, 100, cg0,
            ResolvedChart.Resolve(cg0, Theme.Light(), null, 0));
        cg0.connectGroup = 43;
        int cgF2 = ChartView.FingerprintCore(1, 0, 100, cg0,
            ResolvedChart.Resolve(cg0, Theme.Light(), null, 0));
        Console.WriteLine("cgFp:" + Convert.ToString(cgF0 != cgF1)
            + ":" + Convert.ToString(cgF0 != cgF2)
            + ":" + Convert.ToString(cgF1 != cgF2));
        ChartOption cgj = ChartOption.FromJson(
            "{\"connectGroup\":7,\"series\":[{\"type\":\"line\",\"data\":[1]}]}");
        Console.WriteLine("cgJson:" + Convert.ToString(cgj.connectGroup));

        // ---- 批 6：force/chord/funnel/wordCloud 系列参数入指纹敏感度 ----
        ChartOption b6 = ChartOption.Of("B6", new List<string>{"a"},
            new List<ChartSeries>{ ChartSeries.Force("net", new List<ChartLink>{
                ChartLink.Of("A", "B", 5), ChartLink.Of("B", "C", 3) }) });
        ChartSeries s6 = b6.series[0];
        int b6a = ChartView.FingerprintCore(1, 0, 100, b6,
            ResolvedChart.Resolve(b6, Theme.Light(), null, 0));
        s6.forceScaling = 250;
        int b6b = ChartView.FingerprintCore(1, 0, 100, b6,
            ResolvedChart.Resolve(b6, Theme.Light(), null, 0));
        s6.chordSort = 1;
        int b6c = ChartView.FingerprintCore(1, 0, 100, b6,
            ResolvedChart.Resolve(b6, Theme.Light(), null, 0));
        s6.funnelAlign = "left";
        int b6d = ChartView.FingerprintCore(1, 0, 100, b6,
            ResolvedChart.Resolve(b6, Theme.Light(), null, 0));
        s6.wcRotate = "vary";
        int b6e = ChartView.FingerprintCore(1, 0, 100, b6,
            ResolvedChart.Resolve(b6, Theme.Light(), null, 0));
        s6.wcMaxFontSize = 44;
        int b6f = ChartView.FingerprintCore(1, 0, 100, b6,
            ResolvedChart.Resolve(b6, Theme.Light(), null, 0));
        Console.WriteLine("fpb6:" + Convert.ToString(b6a != b6b)
            + ":" + Convert.ToString(b6b != b6c)
            + ":" + Convert.ToString(b6c != b6d)
            + ":" + Convert.ToString(b6d != b6e)
            + ":" + Convert.ToString(b6e != b6f)
            + ":" + Convert.ToString(b6a != b6f));

        // DrawOption 泄漏回归：系列批 6 字段须抄进渲染用的帧内 option。
        ResolvedChart rc6 = ResolvedChart.Resolve(b6, Theme.Light(), null, 0);
        ChartSeries mat6 = rc6.DrawOption(1, false).series[0];
        Console.WriteLine("drb6:" + Convert.ToString(mat6.forceScaling)
            + ":" + Convert.ToString(mat6.chordSort)
            + ":" + mat6.funnelAlign + ":" + mat6.wcRotate
            + ":" + Convert.ToString(mat6.wcMaxFontSize));

        // ---- symbolSizeFn：坐标回调的公式化替代，抄进 DrawOption 且指纹敏感 ----
        ChartSeries sc = ChartSeries.OfPoints("S", new List<ChartPoint>{
            ChartPoint.Of(2, 9), ChartPoint.Of(4, 25), ChartPoint.Of(6, 49) });
        ChartOption so = ChartOption.Create();
        so.series = new List<ChartSeries>{sc};
        Console.WriteLine("szfDefault:" + Convert.ToString(sc.symbolSizeFn.Length));
        sc.symbolSizeFn = "ySqrt";
        Console.WriteLine("szfRadii:" + Convert.ToString(ChartView.ISqrt(sc.points[0].y))
            + ":" + Convert.ToString(ChartView.ISqrt(sc.points[1].y))
            + ":" + Convert.ToString(ChartView.ISqrt(sc.points[2].y)));
        int sz0 = ChartView.FingerprintCore(1, 0, 100, so,
            ResolvedChart.Resolve(so, Theme.Light(), null, 0));
        sc.symbolSizeFn = "y";
        int sz1 = ChartView.FingerprintCore(1, 0, 100, so,
            ResolvedChart.Resolve(so, Theme.Light(), null, 0));
        Console.WriteLine("szfFp:" + Convert.ToString(sz0 != sz1));
        ChartSeries matS = ResolvedChart.Resolve(so, Theme.Light(), null, 0)
            .DrawOption(1, false).series[0];
        Console.WriteLine("szfDr:" + matS.symbolSizeFn + ":" + matS.points.Count);
        Console.WriteLine("szfJson:" + Convert.ToString(ChartOption.FromJson(
            "{\"series\":[{\"type\":\"scatter\",\"name\":\"s\",\"points\":"
            + "[{\"x\":1,\"y\":16}],\"symbolSizeFn\":\"ySqrt\"}]}")
            .series[0].symbolSizeFn));
    }
}
