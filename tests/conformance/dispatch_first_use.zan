using System;
using System.Threading;
using Gui;

// 核心契约与语义定义。

class Program {
    static AtomicInt ran = new AtomicInt(0);
    static AtomicInt posted = new AtomicInt(0);

    static void Handler() { ran.Increment(); }

    static void Worker() {
        for (int i = 0; i < 200; i = i + 1) {
            if (Dispatcher.Post(Handler)) { posted.Increment(); }
        }
    }

    static void Main() {
        // 核心契约与执行状态转移规范。
        Action first = Dispatcher.Take();
        if (first == null) { Console.WriteLine("empty"); }

        Thread.Start(Worker);
        Thread.Start(Worker);
        Thread.Start(Worker);
        Thread.Start(Worker);

        while (ran.Load() < 800) {
            Action a = Dispatcher.Take();
            if (a != null) { a(); }
            else { Thread.Sleep(0); }
        }
        Console.WriteLine(posted.Load());
        Console.WriteLine(ran.Load());
    }
}
