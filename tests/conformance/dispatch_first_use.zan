using System;
using System.Threading;
using Gui;

// The dispatch queue must be usable without anyone having initialised it
// first: the drain below runs before any post, and the four workers all reach
// it as first-time users at once. On Windows the lock used to be created by
// whichever caller found a plain `ready` flag clear -- so two first posts
// raced on creating it, and a drain-before-post entered a section that had
// never been initialised at all.

class Program {
    static AtomicInt ran = new AtomicInt(0);
    static AtomicInt posted = new AtomicInt(0);

    static void Handler() { ran.Increment(); }

    static void Worker() {
        for (int i = 0; i < 200; i = i + 1) {
            if (Dispatcher.Post(Handler)) { posted.Increment(); }
        }
    }

    static void Main() {
        // Drain an untouched queue.
        Action first = Dispatcher.Take();
        if (first == null) { Console.WriteLine("empty"); }

        Thread.Start(Worker);
        Thread.Start(Worker);
        Thread.Start(Worker);
        Thread.Start(Worker);

        while (ran.Load() < 800) {
            Action a = Dispatcher.Take();
            if (a != null) { a(); }
            else { Thread.Sleep(0); }
        }
        Console.WriteLine(posted.Load());
        Console.WriteLine(ran.Load());
    }
}
