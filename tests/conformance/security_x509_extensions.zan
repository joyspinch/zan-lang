using System;
using System.Security.Cryptography;

class Program {
    static int failures = 0;
    static void Check(bool ok, string name) {
        if (ok) { Console.WriteLine("ok " + name); }
        else { Console.WriteLine("FAIL " + name); failures = failures + 1; }
    }

    // 接口数据协议与执行契约。
    static string ROOT = "";
    static string LEAF = "";

    static byte[] Decode(string text) {
        List<int> length = new List<int>(); length.Add(0);
        byte[] decoded = Base64.Decode(text, length);
        if (decoded == null || length[0] < 1) { return null; }
        byte[] exact = new byte[length[0]];
        NativeMemory.Copy(exact, decoded, length[0]);
        return exact;
    }
    static int Start(byte[] d, int at) {
        int b = d[at + 1] & 255;
        return at + 2 + (b < 128 ? 0 : b - 128);
    }
    static int End(byte[] d, int at) {
        int b = d[at + 1] & 255;
        int n = b < 128 ? 0 : b - 128;
        int len = b < 128 ? b : 0;
        for (int i = 0; i < n; i = i + 1) { len = (len << 8) | (d[at + 2 + i] & 255); }
        return at + 2 + n + len;
    }
    static byte[] Slice(byte[] d, int at, int end) {
        byte[] result = new byte[end - at];
        NativeMemory.Copy(result, (nint)d + (nint)at, result.Length);
        return result;
    }
    static byte[] Join(byte[] left, byte[] right) {
        byte[] result = new byte[left.Length + right.Length];
        NativeMemory.Copy(result, left, left.Length);
        NativeMemory.Copy((nint)result + (nint)left.Length, right, right.Length);
        return result;
    }
    static byte[] Der(int tag, byte[] body) {
        int n = body.Length;
        int header = n < 128 ? 2 : (n < 256 ? 3 : (n < 65536 ? 4 : 5));
        byte[] result = new byte[header + n];
        result[0] = (byte)tag;
        if (header == 2) { result[1] = (byte)n; }
        else {
            result[1] = (byte)(128 + header - 2);
            for (int i = 2; i < header; i = i + 1) {
                result[i] = (byte)((n >> (8 * (header - 1 - i))) & 255);
            }
        }
        NativeMemory.Copy((nint)result + (nint)header, body, n);
        return result;
    }
    // 接口数据协议与执行契约。
    static int ExtensionsAt(byte[] d) {
        int tbs = Start(d, 0);
        int p = Start(d, tbs);
        while (p < End(d, tbs)) {
            if ((d[p] & 255) == 163) { return p; }
            p = End(d, p);
        }
        return -1;
    }
    static byte[] AddExtension(byte[] original, byte[] extension) {
        int tbs = Start(original, 0);
        int ext = ExtensionsAt(original);
        if (ext < 0 || End(original, ext) != End(original, tbs)) { return null; }
        int seq = Start(original, ext);
        byte[] oldItems = Slice(original, Start(original, seq), End(original, seq));
        byte[] newExt = Der(163, Der(48, Join(oldItems, extension)));
        byte[] newTbs = Der(48, Join(Slice(original, Start(original, tbs), ext), newExt));
        return Der(48, Join(newTbs, Slice(original, End(original, tbs), End(original, 0))));
    }
    static int ExtensionAt(byte[] d, int lastOidByte) {
        int ext = ExtensionsAt(d);
        if (ext < 0) { return -1; }
        int seq = Start(d, ext);
        int p = Start(d, seq);
        while (p < End(d, seq)) {
            int oid = Start(d, p);
            int value = Start(d, oid);
            if ((d[oid] & 255) == 6 && End(d, oid) - value == 3
                && (d[value] & 255) == 85 && (d[value + 1] & 255) == 29
                && (d[value + 2] & 255) == lastOidByte) { return p; }
            p = End(d, p);
        }
        return -1;
    }
    static byte[] NewExtension(int lastOidByte, bool critical, byte[] value) {
        byte[] oid = new byte[] { 6, 3, 85, 29, (byte)lastOidByte };
        byte[] field = critical ? Join(oid, new byte[] { 1, 1, 255 }) : oid;
        return Der(48, Join(field, Der(4, value)));
    }
    static bool Rejected(byte[] d) {
        return d != null && X509Certificate.ParseForTls(d, d.Length) == null;
    }
    static void Main() {
        byte[] rootDer = Decode(ROOT);
        byte[] leafDer = Decode(LEAF);
        X509Certificate root = rootDer == null ? null : X509Certificate.ParseForTls(rootDer, rootDer.Length);
        X509Certificate leaf = leafDer == null ? null : X509Certificate.ParseForTls(leafDer, leafDer.Length);
        Check(root != null && leaf != null && leaf.VerifySignedBy(root)
            && root.CanSignCertificates() && leaf.CanServeTls() && leaf.VerifyHost("secure.example"),
            "signed root and leaf retain supported semantics");
        if (root == null || leaf == null) { Console.WriteLine("failures=" + Convert.ToString(failures)); return; }

        int ku = ExtensionAt(leafDer, 15);
        int san = ExtensionAt(leafDer, 17);
        int eku = ExtensionAt(leafDer, 37);
        int basic = ExtensionAt(rootDer, 19);
        int ski = ExtensionAt(rootDer, 14);
        Check(ku >= 0 && san >= 0 && eku >= 0 && basic >= 0 && ski >= 0,
            "exact extension offsets located in signed fixtures");
        if (ku < 0 || san < 0 || eku < 0 || basic < 0 || ski < 0) {
            Console.WriteLine("failures=" + Convert.ToString(failures)); return;
        }

        // 接口数据协议与执行契约。
        byte[] restricted = Slice(leafDer, 0, leafDer.Length);
        int kuOid = Start(restricted, ku);
        int field = End(restricted, kuOid);
        if ((restricted[field] & 255) == 1) { field = End(restricted, field); }
        int bits = Start(restricted, field);
        int flags = Start(restricted, bits);
        Check((restricted[flags + 1] & 255) == 128, "signed leaf keyUsage is digitalSignature");
        restricted[flags + 1] = 0;
        X509Certificate denied = X509Certificate.ParseForTls(restricted, restricted.Length);
        Check(denied != null && !denied.CanServeTls(), "first keyUsage denies TLS before duplicate");
        byte[] permissiveKu = Slice(leafDer, ku, End(leafDer, ku));
        Check(Rejected(AddExtension(restricted, permissiveKu)), "duplicate keyUsage cannot overwrite first restriction");

        byte[] restrictedEku = Slice(leafDer, 0, leafDer.Length);
        int ekuOid = Start(restrictedEku, eku);
        int ekuOctet = End(restrictedEku, ekuOid);
        int ekuSequence = Start(restrictedEku, ekuOctet);
        int ekuUsage = Start(restrictedEku, ekuSequence);
        int usageLast = End(restrictedEku, ekuUsage) - 1;
        Check((restrictedEku[usageLast] & 255) == 1, "signed leaf EKU is serverAuth");
        restrictedEku[usageLast] = 2; // clientAuth instead of serverAuth
        X509Certificate clientOnly = X509Certificate.ParseForTls(restrictedEku, restrictedEku.Length);
        Check(clientOnly != null && !clientOnly.CanServeTls(), "first EKU denies TLS before duplicate");
        Check(Rejected(AddExtension(restrictedEku, Slice(leafDer, eku, End(leafDer, eku)))),
            "duplicate EKU cannot overwrite first restriction");

        byte[] restrictedCa = Slice(rootDer, 0, rootDer.Length);
        int caOid = Start(restrictedCa, basic);
        int caBool = End(restrictedCa, caOid);
        int caOctet = End(restrictedCa, caBool);
        int caSequence = Start(restrictedCa, caOctet);
        int caFlag = Start(restrictedCa, Start(restrictedCa, caSequence));
        Check((restrictedCa[caFlag] & 255) == 255, "signed root basicConstraints permits CA");
        restrictedCa[caFlag] = 0;
        X509Certificate notCa = X509Certificate.ParseForTls(restrictedCa, restrictedCa.Length);
        Check(notCa != null && !notCa.CanSignCertificates(), "first basicConstraints denies CA before duplicate");
        Check(Rejected(AddExtension(restrictedCa, Slice(rootDer, basic, End(rootDer, basic)))),
            "duplicate basicConstraints cannot overwrite first restriction");
        byte[] otherSan = Slice(leafDer, san, End(leafDer, san));
        int sanOid = Start(otherSan, 0);
        int sanNames = Start(otherSan, End(otherSan, sanOid));
        int firstDns = Start(otherSan, sanNames);
        int firstDnsValue = Start(otherSan, firstDns);
        Check((otherSan[firstDnsValue] & 255) == 115 && !leaf.VerifyHost("xecure.example"),
            "signed SAN excludes injected hostname");
        otherSan[firstDnsValue] = 120; // 接口数据协议与执行契约。
        Check(Rejected(AddExtension(leafDer, otherSan)), "duplicate SAN cannot add host identities");
        Check(Rejected(AddExtension(rootDer, Slice(rootDer, ski, End(rootDer, ski)))),
            "duplicate noncritical unknown extension OID refused");

        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        byte[] constraints = new byte[] { 48, 11, 160, 9, 48, 7, 130, 5, 46, 116, 101, 115, 116 };
        byte[] noncriticalNc = NewExtension(30, false, constraints);
        byte[] criticalNc = NewExtension(30, true, constraints);
        Check(Rejected(AddExtension(rootDer, noncriticalNc)), "noncritical nameConstraints refused on CA");
        Check(Rejected(AddExtension(rootDer, criticalNc)), "critical nameConstraints refused on CA");
        Check(Rejected(AddExtension(leafDer, noncriticalNc)), "noncritical nameConstraints refused on leaf");
        Check(Rejected(AddExtension(leafDer, criticalNc)), "critical nameConstraints refused on leaf");
        // 接口数据协议与执行契约。
        byte[] otherUnknown = AddExtension(leafDer, NewExtension(99, false, new byte[] { 5, 0 }));
        Check(otherUnknown != null && X509Certificate.ParseForTls(otherUnknown, otherUnknown.Length) != null,
            "other noncritical unknown extension remains accepted");
        Check(Rejected(AddExtension(otherUnknown, NewExtension(99, false, new byte[] { 5, 0 }))),
            "duplicate unknown OID refused when both noncritical");
        Console.WriteLine("failures=" + Convert.ToString(failures));
    }
}
