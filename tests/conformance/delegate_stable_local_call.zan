using System;

// Delegate calls through a local or parameter skip retain/temp-push when the
// slot can't change during the call. Each shape below must still be correct
// and leak-free: a never-written parameter, a local reassigned later in the
// function, and a local captured by a lambda that replaces it mid-call.
class Program {
    static long Apply(Func<long, long> f, long n) {
        long s = 0;
        for (long i = 0; i < n; i++) s += f(i);
        return s;
    }

    static long Reassigned(long n) {
        long k = 2;
        Func<long, long> f = (long x) => x * k;
        long s = f(n);
        f = (long x) => x + k;
        s += f(n);
        return s;
    }

    static Func<long, long> holder;

    static long CapturedReplaced() {
        long seen = 0;
        Func<long, long> g = null;
        g = (long x) => {
            g = (long y) => y - 1;   // replaces the slot while g is running
            seen = x;
            return x + 1;
        };
        long first = g(10);
        long second = g(10);
        return first * 100 + second * 10 + seen;
    }

    static void Main() {
        long k = 3;
        Console.WriteLine(Apply((long x) => x * k + 1, 1000));
        Console.WriteLine(Reassigned(5));
        Console.WriteLine(CapturedReplaced());
        holder = (long x) => x * 2;
        Console.WriteLine(Apply(holder, 10));
        holder = null;
    }
}
