using System;

class ChainEventValue { }

class ChainParent {
    public int HeightValue;
    public int ParentCalls;
    public ChainParent OnClick(Action action) {
        ParentCalls = ParentCalls + 1;
        action();
        return this;
    }
    public ChainParent Height(int height) { HeightValue = height; return this; }
}

class ChainChild : ChainParent {
    public int EventCalls;
    public virtual void OnClick(ChainEventValue value) { EventCalls = EventCalls + 1; }
}

class ChainState {
    public int Calls;
    public void Click() { Calls = Calls + 1; }
    public ChainParent Build() { return new ChainChild().OnClick(this.Click).Height(36); }
    public ChainControl BuildControl() {
        return new ChainButton("Action").OnClick(this.Click).Height(36);
    }
}

partial class ChainControl {
    public int HeightValue;
    public int ParentCalls;
    public int EventCalls;
    public ChainControl OnClick(Action action) {
        ParentCalls = ParentCalls + 1;
        action();
        return this;
    }
    public ChainControl Height(int height) { HeightValue = height; return this; }
}

partial class ChainControl {
    public virtual void OnClick(ChainEventValue value) { EventCalls = EventCalls + 1; }
}

class ChainButton : ChainControl {
    public ChainButton(string text) { }
    public override void OnClick(ChainEventValue value) { EventCalls = EventCalls + 1; }
}

class ChainDelegateHolder {
    public Action Click;
    public ChainParent Build() { return new ChainChild().OnClick(this.Click).Height(84); }
}

class InheritedOverloadChainTest {
    static void Check(bool ok, string label) { if (!ok) { throw new Exception(label); } }
    static void StaticClick() { }
    static void Main() {
        ChainState state = new ChainState();
        ChainChild standalone = new ChainChild();
        standalone.OnClick(state.Click);
        Check(state.Calls == 1 && standalone.ParentCalls == 1 && standalone.EventCalls == 0,
            "standalone instance method group selects inherited Action overload");
        // Exact reported shape: no cast, typed delegate temporary or split call.
        ChainParent result = new ChainChild().OnClick(state.Click).Height(36);
        Check(result.HeightValue == 36 && result.ParentCalls == 1 && state.Calls == 2,
            "temporary fluent chain preserves selected inherited return type");
        ChainParent same = standalone.OnClick(state.Click).Height(48);
        Check(same == standalone && standalone.HeightValue == 48 && state.Calls == 3,
            "local fluent chain preserves receiver identity and invocation count");
        standalone.OnClick(new ChainEventValue());
        Check(standalone.EventCalls == 1 && state.Calls == 3,
            "derived value overload remains available");
        ChainParent staticResult = new ChainChild().OnClick(InheritedOverloadChainTest.StaticClick).Height(60);
        Check(staticResult.HeightValue == 60, "static method group compatibility retained");
        ChainDelegateHolder holder = new ChainDelegateHolder(); holder.Click = state.Click;
        ChainParent delegateResult = new ChainChild().OnClick(holder.Click).Height(72);
        Check(delegateResult.HeightValue == 72 && state.Calls == 4,
            "delegate field remains a value and is not misclassified as a method group");
        ChainParent thisResult = state.Build();
        Check(thisResult.HeightValue == 36 && thisResult.ParentCalls == 1 && state.Calls == 5,
            "this method group in a direct return preserves inherited fluent return type");
        ChainControl controlResult = state.BuildControl();
        Check(controlResult.HeightValue == 36 && controlResult.ParentCalls == 1 &&
            controlResult.EventCalls == 0 && state.Calls == 6,
            "partial parent overloads and child override preserve this method group return chain");
        ChainButton eventButton = new ChainButton("Event");
        eventButton.OnClick(new ChainEventValue());
        Check(eventButton.EventCalls == 1 && eventButton.ParentCalls == 0,
            "child event override remains callable");
        ChainParent thisDelegateResult = holder.Build();
        Check(thisDelegateResult.HeightValue == 84 && state.Calls == 7,
            "this delegate field remains a value and shadows method group lookup");
        Console.WriteLine("INHERITED_OVERLOAD_CHAIN_OK");
    }
}
