using System;

class AwaitError : Exception {
    public AwaitError() : base("child failed") { }
}

class Program {
    static int cleanup;

    static async int Child(bool suspend) {
        if (suspend) await Task.Delay(1);
        throw new AwaitError();
    }

    static async int Parent(bool suspend) {
        try {
            try {
                return await Child(suspend);
            } finally {
                Program.cleanup = Program.cleanup * 10 + 1;
            }
        } finally {
            Program.cleanup = Program.cleanup * 10 + 2;
        }
    }

    static async void Check(bool suspend) {
        Program.cleanup = 0;
        try {
            await Parent(suspend);
            throw new Exception("child exception was lost");
        } catch (AwaitError e) {
            if (e.Message != "child failed") throw new Exception("wrong exception payload");
            if (Program.cleanup != 12) throw new Exception("finally order or count was wrong");
        }
    }

    static async void Main() {
        await Check(false);
        await Check(true);
        Console.WriteLine("ok failed await unwinds nested finally");
    }
}
