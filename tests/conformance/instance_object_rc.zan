using System;

class Child {
    public int id;
    public Child(int id) {
        this.id = id;
    }
}

class Holder {
    public object val = new Child(100);

    public Holder() {
    }

    public Holder(object v) {
        this.val = v;
    }

    public void SetImplicit(object v) {
        val = v;
    }
}

class Program {
    static int Main() {
        for (int i = 0; i < 50; i++) {
            // 1. Default field initializer
            var h0 = new Holder();
            var c0 = (Child)h0.val;
            if (c0 == null || c0.id != 100) return 1;

            // 2. Explicit ctor assignment
            var h1 = new Holder(new Child(1));
            var c1 = (Child)h1.val;
            if (c1 == null || c1.id != 1) return 2;

            // 3. Implicit this assignment
            h1.SetImplicit(new Child(2));
            var c2 = (Child)h1.val;
            if (c2 == null || c2.id != 2) return 3;

            // 4. Local receiver assignment
            h1.val = new Child(3);
            var c3 = (Child)h1.val;
            if (c3 == null || c3.id != 3) return 4;

            // 5. General member access assignment (via array element)
            var arr = new Holder[1];
            arr[0] = h1;
            arr[0].val = new Child(4);
            var c4 = (Child)arr[0].val;
            if (c4 == null || c4.id != 4) return 5;

            // 6. Object initializer syntax
            var h2 = new Holder { val = new Child(5) };
            var c5 = (Child)h2.val;
            if (c5 == null || c5.id != 5) return 6;
        }

        Console.WriteLine("conformance_instance_object_rc passed");
        return 0;
    }
}
