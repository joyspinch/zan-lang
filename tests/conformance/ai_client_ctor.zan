// AiClient 构造器回归钉（B-ID167①）。
//
// 覆盖：
// - **三参构造出的客户端直接 Dispose/Close 不炸**：曾经三参构造器只设
//   config、漏初始化 `clients` 字典，经它构造的客户端一调 Close/Dispose
//   就在 `clients.Keys` 上空引用——"方便入口"造出来的对象反而是不可
//   关闭的。
// - 三参构造的 config 与主构造器等价（`: this(new AiConfig(...))` 链
//   真实生效，三元组与超时预算都落位）。
// - null 入参经 AiConfig 归一为空串；Dispose 之后 Close 幂等（空字典
//   二次 Close 无害）。
//
// 纯进程内构造，不出网。
using System;
using Ai;

namespace Conf;

class Prog {
    static int Main() {
        AiClient a = new AiClient("http://127.0.0.1:9", "k", "m-test");
        Console.WriteLine(a.config.baseUrl);
        Console.WriteLine(a.config.apiKey);
        Console.WriteLine(a.config.model);
        Console.WriteLine(a.config.connectTimeoutMs);
        a.Dispose();

        AiClient b = new AiClient(new AiConfig("http://127.0.0.1:9", "k2", "m2"));
        b.Dispose();

        AiClient c = new AiClient(null, null, null);
        Console.WriteLine(c.config.baseUrl.Length);
        c.Close();
        c.Close();
        Console.WriteLine("ctor-ok");
        return 0;
    }
}
