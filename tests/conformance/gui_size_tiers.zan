using System;
using Gui;

// 组件度量表：尺寸档与圆角全库统一。
//
// 契约（"同一个词在所有组件上是同一个量"）：
//  1) Control.SizeClass 四档一一对应：tiny/small/medium/large 各自成
//     类，未知值落回默认档（空串）。过去 tiny 被并进 small，base.css
//     里写好的 .tiny 规则永远走不到。
//  2) 标准控件族（按钮 / 输入框 / 下拉框 / 验证码格）的四档高度是
//     24 / 28 / 32 / 40（WidgetSize 的四档），紧凑件（标签）走微型档
//     16 / 20 / 24 / 28。
//  3) 表面（卡片 / 弹层）的圆角取 Radius.M = 8：历史上是写死的 3px，
//     不在圆角阶梯（0/2/4/8/12/16）上，比按钮的 8 明显更尖。
class SizeTiersTest {
    static int fails;
    static App app;

    static void Chk(bool ok, string what) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static int H(string type, string cls) {
        return Style.Full(app, type, cls, "", Style.SNormal()).height;
    }

    static void Tier(string type, int tiny, int small, int medium, int large) {
        int h0 = H(type, "tiny");
        int h1 = H(type, "small");
        int h2 = H(type, "medium");
        int h3 = H(type, "large");
        Console.WriteLine(type + " " + h0 + " " + h1 + " " + h2 + " " + h3);
        Chk(h0 == tiny, type + " tiny height");
        Chk(h1 == small, type + " small height");
        Chk(h2 == medium, type + " medium height");
        Chk(h3 == large, type + " large height");
    }

    static void Main() {
        app = App.CreateOffscreen("size tiers", 320, 240);

        // 1) 档位映射：一档一类。
        Chk(Control.SizeClass("tiny") == "tiny", "tiny maps to tiny");
        Chk(Control.SizeClass("small") == "small", "small maps to small");
        Chk(Control.SizeClass("medium") == "medium", "medium maps to medium");
        Chk(Control.SizeClass("large") == "large", "large maps to large");
        Chk(Control.SizeClass("huge") == "", "unknown size falls back");
        Chk(Control.SizeClass("") == "", "empty size falls back");

        // 2) 尺寸档高度表。
        Tier("button", 24, 28, 32, 40);
        Tier("input", 24, 28, 32, 40);
        Tier("select", 24, 28, 32, 40);
        Tier("otp", 24, 28, 32, 40);
        Tier("tag", 16, 20, 24, 28);

        // 3) 表面圆角在阶梯上，且与按钮同档（Radius.M）。
        int cardR = Style.Full(app, "card", "", "", Style.SNormal()).radius;
        int buttonR = Style.Full(app, "button", "", "", Style.SNormal()).radius;
        Console.WriteLine("radius card " + cardR + " button " + buttonR);
        Chk(cardR == Radius.M, "card radius follows the radius ladder");
        Chk(cardR == buttonR, "card and button share one radius");

        if (fails == 0) {
            Console.WriteLine("gui size tiers OK");
        } else {
            Console.WriteLine("gui size tiers FAILS " + fails);
        }
    }
}
