// `lhs += rhs` desugars into `lhs = lhs + rhs` with the target subtree
// shared by both occurrences. The irgen must rewrite effectful spine nodes
// into single-evaluation temps: previously `data[Next()] += 5` ran Next()
// twice per statement and could read one slot while writing another.
using System;

class SlotBox {
    public int[] data = new int[8];
    public List<int> items = new List<int>();
    public int calls;
}

class CompoundAssignSingleEval {
    static SlotBox box = new SlotBox();
    static SlotBox held;

    static int Next() {
        box.calls++;
        return box.calls - 1;
    }

    static SlotBox Fetch() {
        if (held == null) held = new SlotBox();
        box.calls++;
        return held;
    }

    static void Main() {
        box.data[Next()] += 5;
        box.data[Next()] += 7;
        Console.WriteLine(box.calls);
        Console.WriteLine(box.data[0]);
        Console.WriteLine(box.data[1]);

        // a container reached through a call must be fetched once, too
        Fetch().items.Add(4);
        box.calls = 0;
        Fetch().items[0] += 3;
        Console.WriteLine(box.calls);
        Console.WriteLine(held.items[0]);
        return 0;
    }
}
