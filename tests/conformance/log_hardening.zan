using System;
using System.IO;
using System.Diagnostics;

namespace Conf;

class Prog {
    static void Main() {
        // 1. LogLevel & LogFormat
        bool b1 = (int)LogLevel.TRACE == 0 && (int)LogLevel.FATAL == 5;
        bool b2 = LogLevel.INFO.ToString() == "INFO";
        bool b3 = (int)LogFormat.TEXT == 0 && (int)LogFormat.JSON == 1;
        Console.WriteLine(b1 && b2 && b3);

        // 2. Configure & Text Format
        string dir = Path.GetTempPath() + "zan_log_harden_" + Convert.ToString(ProcessHost.Pid());
        Log.Configure(dir, "harden-{yyyy}{MM}{dd}-w{wid}.log", Log.INFO);
        Log.EchoToConsole(false);
        Log.SetFormat((int)LogFormat.TEXT);
        bool b4 = Log.IsEnabled();
        Console.WriteLine(b4);

        Log.Debug("dropped_debug_msg");
        Log.Info("accepted_info_msg");
        Log.Warn("accepted_warn_msg");

        // 3. JSON Format without Activity
        Log.SetFormat((int)LogFormat.JSON);
        Log.Error("json_error_quote\"test\nline");

        // 4. JSON Format with Activity
        Activity act = Activity.Start("TestSpan");
        string tId = act.traceId;
        string sId = act.spanId;
        Log.Fatal("json_fatal_in_trace");
        act.Stop();

        // 5. Verify Content
        string path = Log.CurrentPath();
        bool exists = File.Exists(path);
        Console.WriteLine(exists);

        string content = File.ReadAllText(path);
        bool noDropped = !content.Contains("dropped_debug_msg");
        bool hasInfo = content.Contains("accepted_info_msg");
        bool hasWarn = content.Contains("accepted_warn_msg");
        bool hasJsonErr = content.Contains("\"level\":\"ERROR\"") && content.Contains("json_error_quote\\\"test\\nline");
        bool hasTraceId = content.Contains("\"traceId\":\"" + tId + "\"");
        bool hasSpanId = content.Contains("\"spanId\":\"" + sId + "\"");
        bool hasFatal = content.Contains("json_fatal_in_trace");
        Console.WriteLine(noDropped && hasInfo && hasWarn);
        Console.WriteLine(hasJsonErr);
        Console.WriteLine(hasTraceId && hasSpanId && hasFatal);

        // 6. Rolling by size
        Log.SetFormat((int)LogFormat.TEXT);
        Log.MaxFileSize(100);
        for (int i = 0; i < 15; i = i + 1) {
            Log.Error("rolling_test_line_" + Convert.ToString(i));
        }
        bool rolled = File.Exists(path + ".1");
        Console.WriteLine(rolled);

        // Cleanup
        if (File.Exists(path)) { File.Delete(path); }
        if (File.Exists(path + ".1")) { File.Delete(path + ".1"); }
        if (File.Exists(path + ".2")) { File.Delete(path + ".2"); }
        if (Directory.Exists(dir)) { Directory.Delete(dir); }
    }
}
