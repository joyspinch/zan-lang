using System;
using Gui;
using Gui.Widget;

namespace Tests.InputNumberStepBounds;

class Program {
    static void Main() {
        InputNumber number = new InputNumber(int.MinValue, int.MaxValue);
        Console.WriteLine("unit-boundaries=" + Convert.ToString(
            number.StepUpVal(int.MaxValue) == int.MaxValue
            && number.StepDownVal(int.MinValue) == int.MinValue
            && number.StepUpVal(int.MinValue) == int.MinValue + 1
            && number.StepDownVal(int.MaxValue) == int.MaxValue - 1));

        number.stepV = int.MaxValue;
        Console.WriteLine("large-step-saturates=" + Convert.ToString(
            number.StepUpVal(1) == int.MaxValue
            && number.StepDownVal(0 - 2) == int.MinValue
            && number.StepUpVal(int.MaxValue) == int.MaxValue
            && number.StepDownVal(int.MinValue) == int.MinValue));
        Console.WriteLine("large-step-crosses-zero=" + Convert.ToString(
            number.StepUpVal(int.MinValue) == (0 - 1)
            && number.StepDownVal(int.MaxValue) == 0));

        number.stepV = 0;
        Console.WriteLine("zero-step-is-one=" + Convert.ToString(number.Step() == 1
            && number.StepUpVal(5) == 6 && number.StepDownVal(5) == 4
            && number.StepUpVal(int.MaxValue) == int.MaxValue));
        number.stepV = 0 - 3;
        Console.WriteLine("negative-step-is-one=" + Convert.ToString(number.Step() == 1
            && number.StepUpVal(5) == 6 && number.StepDownVal(5) == 4));
        number.stepV = int.MinValue;
        Console.WriteLine("minimum-step-is-one=" + Convert.ToString(number.Step() == 1
            && number.StepUpVal(5) == 6 && number.StepDownVal(5) == 4
            && number.StepDownVal(int.MinValue) == int.MinValue));

        number.stepV = int.MaxValue;
        int changes = 0;
        number.Change.Add(() => { changes = changes + 1; });
        number.plusBtn.Click.RaiseS(number.plusBtn);
        number.plusBtn.Click.RaiseS(number.plusBtn);
        number.plusBtn.Click.RaiseS(number.plusBtn);
        number.plusBtn.Click.RaiseS(number.plusBtn);
        Console.WriteLine("button-upper-saturates=" + Convert.ToString(
            number.Value() == int.MaxValue && changes == 3));
        number.minusBtn.Click.RaiseS(number.minusBtn);
        number.minusBtn.Click.RaiseS(number.minusBtn);
        number.minusBtn.Click.RaiseS(number.minusBtn);
        number.minusBtn.Click.RaiseS(number.minusBtn);
        Console.WriteLine("button-lower-saturates=" + Convert.ToString(
            number.Value() == int.MinValue && changes == 6));

        InputNumber bounded = new InputNumber(0 - 10, 10);
        bounded.stepV = int.MaxValue;
        Console.WriteLine("helpers-ignore-widget-range=" + Convert.ToString(
            bounded.StepUpVal(10) == int.MaxValue
            && bounded.StepDownVal(0 - 10) == int.MinValue));
        bounded.plusBtn.Click.RaiseS(bounded.plusBtn);
        bool upper = bounded.Value() == 10;
        bounded.minusBtn.Click.RaiseS(bounded.minusBtn);
        Console.WriteLine("buttons-clamp-widget-range=" + Convert.ToString(
            upper && bounded.Value() == (0 - 10)));
    }
}
