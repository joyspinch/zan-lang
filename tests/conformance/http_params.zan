// HttpContext 类型化取参族（InputString/InputInt/InputLong/InputBool）的契约：
// 合并顺序 route → query → form，空串视同缺失，数值解析必须整串
// 消费（"12abc"、""、"2.5" 都落默认值），布尔词表大小写不敏感。
using System;
using System.Web;

class Program {
    static int failures = 0;

    static void Eq(string what, string got, string want) {
        if (got == want) {
            Console.WriteLine("ok " + what);
        } else {
            Console.WriteLine("FAIL " + what + ": got '" + got
                              + "' want '" + want + "'");
            Program.failures = Program.failures + 1;
        }
    }

    static void Ok(string what, bool got, bool want) {
        Program.Eq(what, got ? "true" : "false", want ? "true" : "false");
    }

    static void Main() {
        // GET + 查询串。
        string raw = "GET /user/42?page=3&flag=on&q=hello HTTP/1.1\r\n"
                     + "Host: h\r\n\r\n";
        HttpContext c = new HttpContext(HttpRequest.Parse(raw), "127.0.0.1");
        c.routeParams.Set("id", "42");
        Program.Eq("route param", c.InputString("id"), "42");
        Program.Eq("query raw", c.InputString("q"), "hello");
        Program.Ok("route int", c.InputInt("id", 0) == 42, true);
        Program.Ok("query int", c.InputInt("page", 1) == 3, true);
        Program.Ok("bool on", c.InputBool("flag", false) == true, true);
        Program.Eq("missing raw", c.InputString("nope"), "");
        Program.Ok("missing int dflt", c.InputInt("nope", 9) == 9, true);

        // 整串消费：垃圾一律默认值。
        Program.Ok("trailing junk", c.InputInt("bad1", 7) == 7, true);
        c.query.Set("bad1", "12abc");
        Program.Ok("12abc rejected", c.InputInt("bad1", 7) == 7, true);
        c.query.Set("frac", "2.5");
        Program.Ok("float rejected", c.InputInt("frac", 7) == 7, true);
        c.query.Set("neg", "-5");
        Program.Ok("negative ok", c.InputInt("neg", 7) == 0 - 5, true);
        c.query.Set("plus", "+6");
        Program.Ok("plus sign", c.InputInt("plus", 7) == 6, true);
        c.query.Set("emptyv", "");
        Program.Ok("empty falls to dflt", c.InputInt("emptyv", 3) == 3, true);
        c.query.Set("big", "9223372036854775807");
        Program.Ok("long max", c.InputLong("big", 0) == 9223372036854775807L,
                   true);
        c.query.Set("huge", "2147483648");
        Program.Ok("int overflow to dflt", c.InputInt("huge", 5) == 5, true);

        // POST 表单：query 与 form 同名时 query 优先；form 兜底。
        string post = "POST /save?src=q HTTP/1.1\r\nHost: h\r\n"
                      + "Content-Type: application/x-www-form-urlencoded\r\n"
                      + "Content-Length: 15\r\n\r\nname=alice&src=f";
        HttpContext p = new HttpContext(HttpRequest.Parse(post), "127.0.0.1");
        Program.Eq("query beats form", p.InputString("src"), "q");
        Program.Eq("form value", p.InputString("name"), "alice");
        Program.Ok("form int", p.InputInt("name", 0) == 0, true);

        // 布尔词表。
        p.form.Set("t1", "TRUE");
        p.form.Set("t2", "Yes");
        p.form.Set("f1", "off");
        p.form.Set("f2", "garbage");
        Program.Ok("true word", p.InputBool("t1", false) == true, true);
        Program.Ok("yes word", p.InputBool("t2", false) == true, true);
        Program.Ok("off word", p.InputBool("f1", true) == false, true);
        Program.Ok("garbage keeps dflt", p.InputBool("f2", true) == true, true);

        // ---- In* 家族与 Input* 同序同规则（收编后的契约）----
        // In* 曾经反着合并（form → query → route），同名参数在两族里
        // 会读到不同来源。现在 In* 也走 route → query → form，数值解析
        // 同样整串消费。
        p.routeParams.Set("id", "77");
        p.query.Set("id", "55");
        p.form.Set("id", "33");
        Program.Ok("in route beats query", p.InInt("id", 0) == 77, true);
        Program.Eq("in route raw", p.InRaw("id"), "77");
        p.query.Set("pick", "11");
        p.form.Set("pick", "22");
        Program.Ok("in query beats form", p.InInt("pick", 0) == 11, true);
        Program.Ok("in form fallback", p.InInt("name", 0) == 0, true);
        p.query.Set("junk", "12abc");
        Program.Ok("in int junk rejected", p.InInt("junk", 7) == 7, true);
        p.query.Set("plus2", "+6");
        Program.Ok("in int plus sign", p.InInt("plus2", 7) == 6, true);
        p.query.Set("huge2", "2147483648");
        Program.Ok("in int overflow to dflt", p.InInt("huge2", 5) == 5, true);
        p.form.Set("emptyq", "");
        p.query.Set("emptyq", "still-here");
        // 空值视同缺失：query 的值不被 form 里的空串遮蔽。
        Program.Eq("empty does not shadow", p.InRaw("emptyq"), "still-here");

        // ---- JsonBody：惰性解析一次 ----
        string jp = "POST /api HTTP/1.1\r\nHost: h\r\n"
                    + "Content-Type: application/json\r\n"
                    + "Content-Length: 26\r\n\r\n{\"a\":7,\"s\":\"hi there\"}";
        HttpContext j = new HttpContext(HttpRequest.Parse(jp), "127.0.0.1");
        JsonValue jb = j.JsonBody();
        JsonValue ja = jb == null ? null : jb.Get("a");
        JsonValue js = jb == null ? null : jb.Get("s");
        Program.Ok("json body parsed", ja != null && ja.AsLong(0) == 7, true);
        Program.Eq("json string field",
                   js == null ? "" : js.AsString(""), "hi there");
        Program.Ok("json cached", j.JsonBody() == jb, true);
        string je = "POST /api HTTP/1.1\r\nHost: h\r\n"
                    + "Content-Type: application/json\r\n"
                    + "Content-Length: 0\r\n\r\n";
        HttpContext j2 = new HttpContext(HttpRequest.Parse(je), "127.0.0.1");
        Program.Ok("json empty is null", j2.JsonBody() == null, true);

        // ---- multipart 文本字段进 form 表 ----
        // 同一张表单里文本输入与文件输入混排：文本字段必须能被
        // Form()/In* 读到，文件部件（带 filename=）不能混进 form。
        string mp = "POST /upload HTTP/1.1\r\nHost: h\r\n"
            + "Content-Type: multipart/form-data; boundary=XBND\r\n"
            + "Content-Length: 232\r\n\r\n"
            + "--XBND\r\n"
            + "Content-Disposition: form-data; name=\"title\"\r\n"
            + "\r\n"
            + "hello multipart\r\n"
            + "--XBND\r\n"
            + "Content-Disposition: form-data; name=\"tag\"\r\n"
            + "\r\n"
            + "z\r\n"
            + "--XBND\r\n"
            + "Content-Disposition: form-data; name=\"doc\"; filename=\"a.bin\"\r\n"
            + "Content-Type: application/octet-stream\r\n"
            + "\r\n"
            + "RAWBYTES\r\n"
            + "--XBND--\r\n";
        HttpContext m = new HttpContext(HttpRequest.Parse(mp), "127.0.0.1");
        Program.Eq("multipart title", m.Form("title"), "hello multipart");
        Program.Eq("multipart tag", m.In("tag"), "z");
        Program.Ok("multipart file part skipped", m.Form("doc").Length == 0,
                   true);

        if (Program.failures > 0) {
            Console.WriteLine("fail: " + Convert.ToString(Program.failures));
        } else {
            Console.WriteLine("all pass");
        }
    }
}
