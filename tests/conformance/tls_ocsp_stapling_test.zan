using System;
using System.Collections.Generic;
using System.Net.Tls;
using System.Security.Cryptography;

class Program {
    static int failures = 0;

    static void Check(bool ok, string name) {
        if (ok) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            failures = failures + 1;
        }
    }

    static string ROOT = "";
    static string LEAF = "";

    static X509Certificate DecodeCert(string text) {
        List<int> len = new List<int>(); len.Add(0);
        byte[] der = Base64.Decode(text, len);
        return X509Certificate.ParseForTls(der, len[0]);
    }

    static void Main() {
        // 1. 验证 OCSPResponse 基础 ASN.1 DER 解码 (RFC 6960)
        byte[] goodDer = OcspResponse.BuildMockResponse(0, OcspCertStatus.Good);
        OcspResponse goodResp = OcspResponse.Parse(goodDer, 0, goodDer.Length);
        Check(goodResp != null && goodResp.responseStatus == 0 && goodResp.certStatus == OcspCertStatus.Good,
              "OCSP parse Good response");

        byte[] revokedDer = OcspResponse.BuildMockResponse(0, OcspCertStatus.Revoked);
        OcspResponse revResp = OcspResponse.Parse(revokedDer, 0, revokedDer.Length);
        Check(revResp != null && revResp.responseStatus == 0 && revResp.certStatus == OcspCertStatus.Revoked
              && revResp.revocationTime > 0,
              "OCSP parse Revoked response with timestamp");

        byte[] errDer = OcspResponse.BuildMockResponse(1, -1); // malformedRequest
        OcspResponse errResp = OcspResponse.Parse(errDer, 0, errDer.Length);
        Check(errResp != null && errResp.responseStatus == 1 && errResp.certStatus == -1,
              "OCSP parse malformedRequest status code");

        // 2. 验证 ClientHello 中包含 status_request (0x0005) 扩展 (RFC 6066 §8)
        TlsEngine client = new TlsEngine("secure.example", true, false, null, false, null, null, false, "", "");
        byte[] chMsg = client.BuildClientHello();
        Check(chMsg != null && chMsg.Length > 0, "BuildClientHello returns valid bytes");
        // 扫描 ClientHello 扩展中是否存在 0x0005
        bool foundStatusRequest = false;
        for (int i = 0; i < chMsg.Length - 4; i = i + 1) {
            if ((chMsg[i] & 255) == 0 && (chMsg[i + 1] & 255) == 5) {
                // 验证长度为 5
                if ((chMsg[i + 2] & 255) == 0 && (chMsg[i + 3] & 255) == 5) {
                    foundStatusRequest = true;
                    break;
                }
            }
        }
        Check(foundStatusRequest, "ClientHello contains status_request extension 0x0005");

        // 3. 验证 TLS 1.3 服务端 OCSP Stapling 状态检验与阻断
        X509Certificate root = DecodeCert(ROOT);
        X509Certificate leaf = DecodeCert(LEAF);
        List<X509Certificate> trusted = new List<X509Certificate>();
        trusted.Add(root);

        // 3.1 TLS 1.3 证书附带 Good OCSP -> 握手验证通过
        TlsEngine tls13Good = new TlsEngine("secure.example", false, false, null, false, null, trusted, false, "", "");
        tls13Good.negotiatedVersion = TlsRecord.VersionTls13;
        tls13Good.receivedEncryptedExtensions = true;

        // 组装带 Good OCSP 扩展的 TLS 1.3 Certificate 握手报文
        TlsByteWriter cbw1 = new TlsByteWriter();
        cbw1.WriteU8(TlsRecord.HandshakeCertificate);
        cbw1.WriteU24(0);
        int cstart1 = cbw1.Length();
        cbw1.WriteU8(0); // req_context len = 0
        int extDataLen1 = 4 + goodDer.Length;
        int leafEntryExtLen1 = 4 + extDataLen1;
        int totalCertsLen1 = 3 + leaf.RawDerLen() + 2 + leafEntryExtLen1;
        cbw1.WriteU24(totalCertsLen1);
        cbw1.WriteU24(leaf.RawDerLen());
        cbw1.WriteBytes(leaf.RawDer(), 0, leaf.RawDerLen());
        cbw1.WriteU16(leafEntryExtLen1);
        cbw1.WriteU16(5); // status_request
        cbw1.WriteU16(extDataLen1);
        cbw1.WriteU8(1); // ocsp(1)
        cbw1.WriteU24(goodDer.Length);
        cbw1.WriteBytes(goodDer);
        byte[] certMsg1 = cbw1.ToArray();
        int bodyLen1 = cbw1.Length() - cstart1;
        certMsg1[1] = (byte)((bodyLen1 >> 16) & 255);
        certMsg1[2] = (byte)((bodyLen1 >> 8) & 255);
        certMsg1[3] = (byte)(bodyLen1 & 255);

        int rcGood = tls13Good.ProcessHandshakePayload(certMsg1);
        Check(rcGood == 0 && tls13Good.stapledOcsp != null && tls13Good.stapledOcsp.certStatus == OcspCertStatus.Good,
              "TLS 1.3 stapled Good OCSP accepted");

        // 3.2 TLS 1.3 证书附带 Revoked OCSP -> 立即熔断拒绝！
        TlsEngine tls13Rev = new TlsEngine("secure.example", false, false, null, false, null, trusted, false, "", "");
        tls13Rev.negotiatedVersion = TlsRecord.VersionTls13;
        tls13Rev.receivedEncryptedExtensions = true;

        TlsByteWriter cbw2 = new TlsByteWriter();
        cbw2.WriteU8(TlsRecord.HandshakeCertificate);
        cbw2.WriteU24(0);
        int cstart2 = cbw2.Length();
        cbw2.WriteU8(0);
        int extDataLen2 = 4 + revokedDer.Length;
        int leafEntryExtLen2 = 4 + extDataLen2;
        int totalCertsLen2 = 3 + leaf.RawDerLen() + 2 + leafEntryExtLen2;
        cbw2.WriteU24(totalCertsLen2);
        cbw2.WriteU24(leaf.RawDerLen());
        cbw2.WriteBytes(leaf.RawDer(), 0, leaf.RawDerLen());
        cbw2.WriteU16(leafEntryExtLen2);
        cbw2.WriteU16(5); // status_request
        cbw2.WriteU16(extDataLen2);
        cbw2.WriteU8(1);
        cbw2.WriteU24(revokedDer.Length);
        cbw2.WriteBytes(revokedDer);
        byte[] certMsg2 = cbw2.ToArray();
        int bodyLen2 = cbw2.Length() - cstart2;
        certMsg2[1] = (byte)((bodyLen2 >> 16) & 255);
        certMsg2[2] = (byte)((bodyLen2 >> 8) & 255);
        certMsg2[3] = (byte)(bodyLen2 & 255);

        int rcRev = tls13Rev.ProcessHandshakePayload(certMsg2);
        Check(rcRev != 0 && tls13Rev.lastError.IndexOf("OCSP") >= 0,
              "TLS 1.3 stapled Revoked OCSP rejected with fail-closed");

        // 4. 验证 TLS 1.2 CertificateStatus 握手报文阻断
        TlsEngine tls12Rev = new TlsEngine("secure.example", false, true, null, false, null, trusted, false, "", "");
        tls12Rev.negotiatedVersion = TlsRecord.VersionTls12;
        tls12Rev.peerCert = leaf;
        tls12Rev.peerChain.Add(leaf);

        TlsByteWriter csBw = new TlsByteWriter();
        csBw.WriteU8(TlsRecord.HandshakeCertificateStatus);
        csBw.WriteU24(1 + 3 + revokedDer.Length);
        csBw.WriteU8(1);
        csBw.WriteU24(revokedDer.Length);
        csBw.WriteBytes(revokedDer);
        byte[] csMsg = csBw.ToArray();

        int rcCsRev = tls12Rev.ProcessHandshakePayload(csMsg);
        Check(rcCsRev != 0 && tls12Rev.lastError.IndexOf("OCSP") >= 0,
              "TLS 1.2 CertificateStatus Revoked OCSP rejected");

        // 5. 验证 requireOcspStapling 门禁防线：未提供状态时直接拦截
        TlsEngine tlsReq = new TlsEngine("secure.example", false, false, null, false, null, trusted, false, "", "");
        tlsReq.requireOcspStapling = true;
        tlsReq.negotiatedVersion = TlsRecord.VersionTls13;
        tlsReq.receivedEncryptedExtensions = true;

        // 组装无 OCSP 扩展的普通证书报文
        TlsByteWriter cbwNoExt = new TlsByteWriter();
        cbwNoExt.WriteU8(TlsRecord.HandshakeCertificate);
        cbwNoExt.WriteU24(0);
        int cstartNoExt = cbwNoExt.Length();
        cbwNoExt.WriteU8(0);
        cbwNoExt.WriteU24(3 + leaf.RawDerLen() + 2);
        cbwNoExt.WriteU24(leaf.RawDerLen());
        cbwNoExt.WriteBytes(leaf.RawDer(), 0, leaf.RawDerLen());
        cbwNoExt.WriteU16(0); // extensions len = 0
        byte[] certMsgNoExt = cbwNoExt.ToArray();
        int bodyLenNoExt = cbwNoExt.Length() - cstartNoExt;
        certMsgNoExt[1] = (byte)((bodyLenNoExt >> 16) & 255);
        certMsgNoExt[2] = (byte)((bodyLenNoExt >> 8) & 255);
        certMsgNoExt[3] = (byte)(bodyLenNoExt & 255);

        int rcReq = tlsReq.ProcessHandshakePayload(certMsgNoExt);
        Check(rcReq != 0 && tlsReq.lastError.IndexOf("OCSP") >= 0,
              "requireOcspStapling gate blocks handshake when server provides no OCSP");

        if (failures > 0) {
            Console.WriteLine("FAILURES: " + Convert.ToString(failures));
            Environment.Exit(1);
        } else {
            Console.WriteLine("ALL OCSP STAPLING TESTS PASSED");
        }
    }
}
