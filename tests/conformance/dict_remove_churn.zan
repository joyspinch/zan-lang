using System;
using System.Collections.Generic;
namespace Conf;
class Program {
    static void Main() {
        // 核心契约与语义定义。
        Dict<string, int> d = new Dict<string, int>();
        d.Add("a", 1); d.Add("b", 2); d.Add("c", 3); d.Add("d", 4);
        Console.WriteLine(Convert.ToString(d.Remove("c")));
        Console.WriteLine(Convert.ToString(d.Remove("zz")));
        Console.WriteLine(Convert.ToString(d.Remove("d")));
        Console.WriteLine(d.Count);
        Console.WriteLine(Convert.ToString(d.ContainsKey("a")));
        Console.WriteLine(Convert.ToString(d.ContainsKey("c")));
        Console.WriteLine(Convert.ToString(d["b"]));
        // 核心契约与语义定义。
        Dict<int, int> m = new Dict<int, int>();
        for (int i = 0; i < 64; i = i + 1) { m.Add(i, i * 2); }
        for (int i = 0; i < 64; i = i + 1) { m.Remove(i); }
        Console.WriteLine(Convert.ToString(m.Count));
        for (int i = 0; i < 64; i = i + 1) { if (m.ContainsKey(i)) { Console.WriteLine("leak"); } }
        for (int i = 0; i < 64; i = i + 1) { m.Add(i, i * 2); }
        long sum = 0;
        for (int i = 0; i < 64; i = i + 1) { if (m.ContainsKey(i)) { sum = sum + m[i]; } }
        Console.WriteLine(Convert.ToString(sum));
        // 核心契约与语义定义。
        Dict<int, int> c = new Dict<int, int>();
        for (int r = 0; r < 20; r = r + 1) {
            for (int i = 0; i < 50; i = i + 1) {
                int k = (i * 37 + r * 11) % 100;
                if (i % 3 == 0) { c.Remove(k); }
                else { c.Add(k, k + 1); }
            }
        }
        bool bad = false;
        for (int k = 0; k < 100; k = k + 1) {
            if (c.ContainsKey(k)) { if (c[k] != k + 1) { bad = true; } }
        }
        Console.WriteLine(Convert.ToString(bad));
        Console.WriteLine(Convert.ToString(c.Count >= 0));
        // 核心契约与语义定义。
        Dict<int, int> f = new Dict<int, int>();
        for (int i = 0; i < 10; i = i + 1) { f.Add(i, i); }
        int last = f[9];
        Console.WriteLine(Convert.ToString(f.Remove(0)));
        Console.WriteLine(Convert.ToString(f.Remove(9)));
        Console.WriteLine(Convert.ToString(f.ContainsKey(1)));
        Console.WriteLine(Convert.ToString(f.Count));
    }
}
