using System;

namespace Conformance;

public class Target {
    public string Name;
    public int Value;
}

public class Container {
    Target target;

    public Container() {
        this.target = new Target();
    }

    public Target GetTarget() {
        return this.target;
    }
}

class Program {
    static void Main() {
        Container c = new Container();
        // 对方法调用临时接收者的字段直接赋值，临时接收者必须在赋值后正确释放
        c.GetTarget().Name = "hello";
        c.GetTarget().Value = 42;

        if (c.GetTarget().Name != "hello" || c.GetTarget().Value != 42) {
            Console.WriteLine("FAIL: values mismatch");
            return;
        }

        Console.WriteLine("ARC_ASSIGN_CALL_TEMP_RECEIVER_OK");
    }
}
