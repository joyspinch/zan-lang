// Conformance: a default-constructed ByteBuffer (capacity 0) must grow on
// the first write. Growth doubled from the current capacity, so 0 * 2 never
// reached the requested size and the first write spun forever.
using System;
using System.IO;

class Program {
    static int Main() {
        ByteBuffer bb = new ByteBuffer();
        bb.WriteVarInt(12345);
        bb.WriteString("hi");
        bb.SeekRead(0);
        Console.WriteLine("v=" + Convert.ToString(bb.ReadVarInt()));
        Console.WriteLine("s=" + bb.ReadString());
        Console.WriteLine("len=" + Convert.ToString(bb.Length()));
        bb.Free();
        return 0;
    }
}
