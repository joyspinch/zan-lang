    static async HttpResponse Handle(HttpRequest req) {
        if (req.path == "/bin") {
            // 300 bytes of the 0..255 pattern plus 44 more: every position
            // matters, and NULs land right at the front where strlen dies.
            byte[] b = new byte[300];
            for (int i = 0; i < 300; i = i + 1) {
                b[i] = (byte)(i % 256);
            }
            return HttpResponse.Bytes(b, 300, "application/octet-stream");
        }
        if (req.path == "/nuls") {
            byte[] b = new byte[1000];
            return HttpResponse.Bytes(b, 1000, "application/octet-stream");
        }
        if (req.path == "/text") {
            return HttpResponse.Text("plain over tls");
        }
        return HttpResponse.NotFound();
    }

    static async int Run() {
        Socket.Initialize();
        File.WriteAllText("https_bin_ca.pem", Program.CA_CERT);
        File.WriteAllText("https_bin_server_cert.pem", Program.SERVER_CERT);
        File.WriteAllText("https_bin_server_key.pem", Program.SERVER_KEY);

        HttpsServer server = HttpsServer.Create("127.0.0.1", Program.PORT,
            "https_bin_server_cert.pem", "https_bin_server_key.pem");
        Check(server != null, "server created");
        server.OnRequest(Program.Handle);
        Task.Spawn(server.Start());
        bool up = false;
        for (int i = 0; i < 250 && !up; i = i + 1) {
            TcpClient probe = await TcpClient.ConnectAsync("127.0.0.1",
                                                          Program.PORT, 200);
            if (probe != null) {
                probe.Close();
                up = true;
            } else {
                await Task.Delay(20);
            }
        }
        Check(up, "listener up");

        HttpClient c = HttpClient.CreateHttps("127.0.0.1", Program.PORT);
        c.DisableTlsVerify();
        c.SetTimeout(10000);

        // Binary body over TLS: every byte position survives.
        HttpResponse bin = await c.SendBytesAsync("GET", "/bin", "");
        Check(bin.statusCode == 200, "bin status");
        Check(bin.BodyLength() == 300, "bin length");
        byte[] bb = bin.bodyBytes;
        Check(bb[0] == 0 && bb[1] == 1 && bb[2] == 2, "bin head bytes");
        Check(bb[255] == (byte)255, "bin byte 255");
        Check(bb[299] == (byte)43, "bin tail byte");

        // All-NUL body: strlen-based assembly would report length 0.
        HttpResponse nuls = await c.SendBytesAsync("GET", "/nuls", "");
        Check(nuls.BodyLength() == 1000, "nuls length");
        byte[] nb = nuls.bodyBytes;
        Check(nb[0] == 0 && nb[999] == 0, "nuls bytes");

        // Text still takes the ordinary path.
        HttpResponse tx = await c.SendBytesAsync("GET", "/text", "");
        Check(tx.statusCode == 200 && tx.body == "plain over tls",
            "text body");

        // The pooled TLS connection stays in sync after binary bodies.
        HttpResponse bin2 = await c.SendBytesAsync("GET", "/bin", "");
        Check(bin2.BodyLength() == 300 && bin2.bodyBytes[10] == (byte)10,
            "bin again over reused connection");
        HttpResponse tx2 = await c.SendBytesAsync("GET", "/text", "");
        Check(tx2.body == "plain over tls", "text again over reused connection");

        // 收尾：先关客户端连接（服务端 HandleConnection 的 TLS recv
        // 以 EOF 收场），再停监听器并给 reactor 几个泵转把两头的
        // 协程收干净——否则退出时的泄漏探测把服务端对象链记为仍可达。
        c.Close();
        for (int i = 0; i < 10; i = i + 1) { await Task.Delay(10); }
        server.Stop();
        for (int i = 0; i < 20; i = i + 1) { await Task.Delay(10); }
        Console.WriteLine("failures: " + Convert.ToString(failures));
        return failures;
    }

    static void Main() {
        int _rc = await Program.Run();
    }
}
