// Conformance: HttpsServer's binary-safe response path.
//
// HttpsServer used to serialize every response with response.Build(), which
// is a strlen-shaped string: a binary body (HttpResponse.Bytes) truncated at
// its first NUL byte, so an image or a font served over TLS arrived mangled.
// It now mirrors HttpServer: IsBinary() responses go out as BuildHeaders()
// followed by bodyBytes in explicit-length chunks (Content-Length and the
// send length both come from BodyLength).
//
// The TLS material is the same embedded CA/server pair tls_hostname uses, so
// the case is self-contained: no network, no build-time openssl. The client
// runs with verification disabled because the embedded server certificate is
// issued for a different hostname on purpose.
using System;
using System.IO;
using System.Net.Http;
using System.Net.Http.Client;
using System.Net.Https;

class Program {
    static int failures = 0;
    static int PORT = 9651;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            failures = failures + 1;
        }
    }

