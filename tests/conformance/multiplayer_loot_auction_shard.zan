using System;
using Game.Net;

class Program {
    static int Main() {
        // 1. 副本 Need/Greed/Pass 掷点裁决
        NetLootNeedGreedRoll roll = new NetLootNeedGreedRoll(9001);
        roll.SubmitRoll(1, LootBidChoice.Greed, 99);
        roll.SubmitRoll(2, LootBidChoice.Need, 42);
        roll.SubmitRoll(3, LootBidChoice.Need, 77);
        bool dupReject = !roll.SubmitRoll(3, LootBidChoice.Need, 100);
        int winner = roll.ResolveWinner();

        NetLootNeedGreedRoll allPass = new NetLootNeedGreedRoll(9002);
        allPass.SubmitRoll(1, LootBidChoice.Pass, 50);
        bool lootOk = dupReject && winner == 3 && allPass.ResolveWinner() == -1;
        Console.WriteLine("loot_roll_ok=" + (lootOk ? "1" : "0"));

        // 2. 拍卖行防狙击延时、被超价退款与一口价直购
        NetAuctionEscrowHouse ah = new NetAuctionEscrowHouse(100, 20, 500, 100000L, 30000L, 30000L);
        bool b1 = ah.PlaceBid(10, 100, 50000L);
        bool lowReject = !ah.PlaceBid(20, 110, 60000L); // 加价不足 20
        // 距截拍仅剩 10s -> 触发防狙击延长 30s 至 130000L，并退还 10 号 100G
        bool b2 = ah.PlaceBid(20, 150, 90000L);
        bool snipeExtended = ah.EndTimeMs == 130000L && ah.PendingRefundTotalFor(10) == 100;
        // 一口价 500G 直购结拍，退还 20 号 150G
        bool b3 = ah.PlaceBid(30, 500, 110000L);
        bool settledOk = ah.Settled && ah.HighestBidderId == 30 && ah.PendingRefundTotalFor(20) == 150
            && !ah.PlaceBid(40, 600, 111000L);
        Console.WriteLine("auction_house_ok=" + ((b1 && lowReject && b2 && snipeExtended && b3 && settledOk) ? "1" : "0"));

        // 3. 一次性跨服迁移令牌：单次核销、重放拒绝与超时拒绝
        NetCrossServerTransferTicket xfer = new NetCrossServerTransferTicket();
        string t1 = xfer.Issue(77, 3, 1000L, 5000L);
        bool wrongShard = !xfer.Redeem(t1, 77, 4, 2000L);
        bool okRedeem = xfer.Redeem(t1, 77, 3, 2000L);
        bool replayBlocked = !xfer.Redeem(t1, 77, 3, 2100L);
        string t2 = xfer.Issue(88, 5, 1000L, 5000L);
        bool expiredBlocked = !xfer.Redeem(t2, 88, 5, 7000L);
        Console.WriteLine("shard_ticket_ok=" + ((wrongShard && okRedeem && replayBlocked && expiredBlocked) ? "1" : "0"));
        return 0;
    }
}
