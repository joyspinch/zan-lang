using System;

namespace GenericDelegateCtorMethodGroup;

/// A method named but not called (`Rows.Of`) is a method group: it converts to
/// a delegate parameter and to nothing else. Ranking it as an untyped argument
/// let declaration order pick the `List<Col<T>>` overload, which then stored a
/// function pointer in an ARC field and crashed on the retain.
delegate string CellOf<T>(T item);
delegate Box RowOf<T>(T item);

class Box {
    string tag;
    Box(string t) { tag = t; }
}

class Item {
    string name;
    Item(string n) { name = n; }
}

class Col<T> {
    string title;
    CellOf<T> cell;
    Col(string title, CellOf<T> cell) { this.title = title; this.cell = cell; }
    string TextOf(T item) { return cell(item); }
}

class Bag<T> {
    List<T> src;
    List<Col<T>> cols;
    RowOf<T> row;

    void Init() { src = new List<T>(); cols = new List<Col<T>>(); row = null; }

    Bag() { Init(); }
    Bag(List<Col<T>> columns) { Init(); if (columns != null) { cols = columns; } }
    Bag(Col<T> column) { Init(); if (column != null) { cols.Add(column); } }
    Bag(RowOf<T> r) { Init(); row = r; }

    void Add(T v) { src.Add(v); }
    int ColumnCount() { return cols.Count; }
    bool HasRowTemplate() { return row != null; }
    string TagAt(int i) { return row(src[i]).tag; }
    string CellAt(int i) { return cols[0].TextOf(src[i]); }
    /// The same choice on a method, not a constructor.
    void Retemplate(RowOf<T> r) { row = r; }
    void Retemplate(Col<T> c) { cols.Add(c); }
}

class Rows {
    static Box Of(Item it) { return new Box("[" + it.name + "]"); }
    static Box Bare(Item it) { return new Box(it.name); }
}

class Cells {
    static string NameOf(Item it) { return it.name; }
}

class Program {
    static void Main() {
        Bag<Item> byRow = new Bag<Item>(Rows.Of);
        byRow.Add(new Item("alpha"));
        if (byRow.HasRowTemplate()) { Console.WriteLine("row template"); }
        Console.WriteLine(byRow.ColumnCount());
        Console.WriteLine(byRow.TagAt(0));

        byRow.Retemplate(Rows.Bare);
        Console.WriteLine(byRow.TagAt(0));

        Bag<Item> byCol = new Bag<Item>(new Col<Item>("Name", Cells.NameOf));
        byCol.Add(new Item("beta"));
        Console.WriteLine(byCol.ColumnCount());
        Console.WriteLine(byCol.CellAt(0));

        List<Col<Item>> cols = new List<Col<Item>>();
        cols.Add(new Col<Item>("Name", Cells.NameOf));
        Bag<Item> byList = new Bag<Item>(cols);
        byList.Add(new Item("gamma"));
        Console.WriteLine(byList.ColumnCount());
        Console.WriteLine(byList.CellAt(0));
    }
}
