using System;
using System.Windows;

namespace Conf;

class DesktopCompanionThemePhysicsIdleTest {
    static void Main() {
        // 1. Windows 原生深浅色主题与 DWM 强调色实机查询（只读 advapi32!RegGetValueA）
        OsThemeSnapshot snap = WindowsThemeWatcher.QueryCurrent();
        uint surf = WindowsThemeWatcher.RecommendedSurfaceArgb(snap);
        uint text = WindowsThemeWatcher.RecommendedTextArgb(snap);
        bool themeOk = snap != null
            && snap.QueriedFromOs
            && (snap.AccentColorArgb & 0xFF000000U) == 0xFF000000U
            && surf != text;
        Console.WriteLine("win-theme-watcher-registry: " + Convert.ToString(themeOk ? 1 : 0));

        // 2. 桌宠 2D 拖拽抛掷 + 重力下落 + 墙面/地面弹性碰撞与稳态落座
        CompanionDesktopPhysics phys = new CompanionDesktopPhysics(100.0f, 100.0f, 100.0f, 100.0f);
        phys.BeginDrag(100.0f, 100.0f);
        phys.UpdateDrag(140.0f, 90.0f, 0.02f);
        phys.UpdateDrag(180.0f, 80.0f, 0.02f);
        phys.EndDrag();
        bool launchedRight = phys.VelX > 500.0f && !phys.IsDragging;

        // 模拟 4 秒（200 帧 * 20ms）在 1000x600 工作区内抛掷反弹并最终稳态落座在地面 Y=500
        for (int i = 0; i < 200; i = i + 1) {
            phys.Step(0.02f, 0.0f, 0.0f, 1000.0f, 600.0f);
        }
        bool physOk = launchedRight
            && phys.IsGrounded
            && phys.Y > 499.5f && phys.Y < 500.5f
            && phys.X >= 0.0f && phys.X <= 900.0f;
        Console.WriteLine("companion-desktop-physics-throw-settle: " + Convert.ToString(physOk ? 1 : 0));

        // 3. 放置类挂机产线：指数涨价批量购入 + 封顶离线补算 + 转生 Prestige 永久加成
        IdleProductionEngine idle = new IdleProductionEngine();
        idle.MaxOfflineSeconds = 3600.0; // 封顶 1 小时
        idle.Currency = 100.0;
        idle.RegisterGenerator("farm", "Auto Berry Farm", 10.0, 1.5, 2.0);
        // 连买 3 级费用 = 10 + 15 + 22.5 = 47.5
        double bulk3 = idle.GetBulkCost("farm", 3);
        bool bought3 = idle.TryBuy("farm", 3);
        double rate1 = idle.GetTotalRatePerSec(); // 3 * 2.0 = 6.0 / sec

        // 模拟离线 10 小时，应按 3600 秒封顶补算 -> 3600 * 6 = 21600
        double offlineEarned = idle.ApplyOfflineCatchup(36000.0);
        // 终身产出 21600，阈值 1000 -> floor(sqrt(21.6)) = 4 点 Prestige（永久 +40% 产能）
        int gainedPrestige = idle.TryAscend(1000.0);
        idle.Currency = 20.0;
        bool rebuy = idle.TryBuy("farm", 1);
        double rateAfterPrestige = idle.GetTotalRatePerSec(); // 1 * 2.0 * 1.4 = 2.8 / sec

        bool idleOk = bulk3 > 47.49 && bulk3 < 47.51
            && bought3
            && rate1 > 5.99 && rate1 < 6.01
            && offlineEarned > 21599.0 && offlineEarned < 21601.0
            && gainedPrestige == 4 && idle.PrestigePoints == 4
            && rebuy && rateAfterPrestige > 2.79 && rateAfterPrestige < 2.81;
        Console.WriteLine("idle-production-offline-prestige: " + Convert.ToString(idleOk ? 1 : 0));
    }
}
