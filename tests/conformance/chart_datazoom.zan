// N2 dataZoom 组件契约：多组件解析（inside/slider 混排、x/y 靶向）、
// 窗口投影（zoomStart/zoomEnd/zoomStartValue/zoomEndValue 兼容旧字段）、
// 系统底层交互与数据流转契约
// 系统底层交互与数据流转契约
// labelFormatter、textStyle/dataBackground/filler 覆写）、克隆保真、
// 对象形态、K 系列阴影取值接缝（ZoomShadowN/ZoomShadowV 取收口价）。
using System;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static void Main() {
        // ① inside+slider 对：窗口取首个 x 靶向组件，o.zoom 开窗。
        ChartOption a = ChartOption.FromJson(
            "{\"series\":[{\"type\":\"line\",\"data\":[1,2,3]}]," +
            "\"dataZoom\":[{\"type\":\"inside\",\"start\":0,\"end\":10}," +
            "{\"type\":\"slider\",\"start\":0,\"end\":10,\"show\":true}]}");
        Console.WriteLine("A comps=" + Convert.ToString(a.zooms.Count)
            + " zoom=" + Convert.ToString(a.zoom)
            + " start=" + Convert.ToString(a.zoomStart)
            + " end=" + Convert.ToString(a.zoomEnd)
            + " slider0=" + Convert.ToString(a.zooms[0].slider)
            + " slider1=" + Convert.ToString(a.zooms[1].slider));

        // ② inside-only：开窗但 slider 组件为 null（不画条不预留带）。
        ChartOption b = ChartOption.FromJson(
            "{\"series\":[{\"type\":\"bar\",\"data\":[1,2,3]}]," +
            "\"dataZoom\":[{\"type\":\"inside\"}]}");
        Console.WriteLine("B comps=" + Convert.ToString(b.zooms.Count)
            + " zoom=" + Convert.ToString(b.zoom)
            + " bar=" + Convert.ToString(Chart.ZoomBarComp(b) != null));

        // ③ show:false slider：藏条不关窗（dynamic-data 语义）。
        ChartOption d = ChartOption.FromJson(
            "{\"series\":[{\"type\":\"line\",\"data\":[1,2,3]}]," +
            "\"dataZoom\":[{\"type\":\"slider\",\"start\":0,\"end\":100,\"show\":false}]}");
        Console.WriteLine("D comps=" + Convert.ToString(d.zooms.Count)
            + " zoom=" + Convert.ToString(d.zoom)
            + " bar=" + Convert.ToString(Chart.ZoomBarComp(d) != null));

        // ④ gantt 形：x slider + y slider（zoomLock、handleSize 0、宽 10）。
        ChartOption g = ChartOption.FromJson(
            "{\"series\":[],\"dataZoom\":[" +
            "{\"type\":\"slider\",\"xAxisIndex\":0,\"start\":0,\"end\":26," +
            "\"filterMode\":\"weakFilter\",\"height\":20,\"bottom\":0," +
            "\"showDetail\":false,\"handleSize\":\"80%\"}," +
            "{\"type\":\"slider\",\"yAxisIndex\":0,\"start\":95,\"end\":100," +
            "\"zoomLock\":true,\"right\":10,\"width\":10,\"top\":70,\"handleSize\":0}]}");
        Console.WriteLine("G comps=" + Convert.ToString(g.zooms.Count)
            + " xS=" + Convert.ToString(g.zoomX.start) + "/" + Convert.ToString(g.zoomX.end)
            + " h=" + Convert.ToString(g.zoomX.height)
            + " hs=" + Convert.ToString(g.zoomX.handleSize)
            + " yS=" + Convert.ToString(g.zoomY.start) + "/" + Convert.ToString(g.zoomY.end)
            + " yLock=" + Convert.ToString(g.zoomY.zoomLock)
            + " yW=" + Convert.ToString(g.zoomY.width)
            + " yHsPx=" + Convert.ToString(g.zoomY.handleSizePx)
            + " b=" + Convert.ToString(g.zoomX.bottom)
            + " t=" + Convert.ToString(g.zoomY.top));

        // ⑤ sh-2015 形：dataBackground/textStyle 覆写 + brushSelect。
        ChartOption s = ChartOption.FromJson(
            "{\"series\":[],\"dataZoom\":[" +
            "{\"type\":\"slider\",\"xAxisIndex\":0,\"brushSelect\":true," +
            "\"textStyle\":{\"color\":\"#8392A5\"}," +
            "\"dataBackground\":{" +
            "\"areaStyle\":{\"color\":\"#8392A5\"}," +
            "\"lineStyle\":{\"opacity\":0.8,\"color\":\"#8392A5\"}}}]}");
        Console.WriteLine("S comps=" + Convert.ToString(s.zooms.Count)
            + " db=" + Convert.ToString(s.zooms[0].dbAreaColor)
            + "/" + Convert.ToString(s.zooms[0].dbLineColor)
            + " ts=" + Convert.ToString(s.zooms[0].textStyleColor)
            + " brush=" + Convert.ToString(s.zooms[0].brushSelect));

        // ⑥ 盒锚百分比与 labelFormatter/showDataShadow。
        ChartOption p = ChartOption.FromJson(
            "{\"series\":[],\"dataZoom\":[" +
            "{\"type\":\"slider\",\"top\":\"73%\",\"showDataShadow\":false," +
            "\"labelFormatter\":\"\"}," +
            "{\"type\":\"slider\",\"height\":30,\"bottom\":30," +
            "\"left\":\"10%\",\"right\":\"10%\",\"xAxisIndex\":\"all\"}]}");
        Console.WriteLine("P comps=" + Convert.ToString(p.zooms.Count)
            + " topPct=" + Convert.ToString(p.zooms[0].topPct)
            + " sds=" + Convert.ToString(p.zooms[0].shadowMode)
            + " lf=[" + Convert.ToString(p.zooms[0].labelFormatter) + "]"
            + " h=" + Convert.ToString(p.zooms[1].height)
            + " lPct=" + Convert.ToString(p.zooms[1].leftPct)
            + " rPct=" + Convert.ToString(p.zooms[1].rightPct));

        // ⑦ minSpan/minValueSpan。
        ChartOption w = ChartOption.FromJson(
            "{\"series\":[],\"dataZoom\":[" +
            "{\"type\":\"inside\",\"minSpan\":5}," +
            "{\"type\":\"slider\",\"bottom\":50,\"minSpan\":5}]}");
        ChartOption iv = ChartOption.FromJson(
            "{\"series\":[],\"dataZoom\":[" +
            "{\"type\":\"inside\",\"minValueSpan\":3600000}," +
            "{\"type\":\"slider\",\"minValueSpan\":3600000}]}");
        Console.WriteLine("W minSpan=" + Convert.ToString(w.zooms[1].minSpan)
            + " iv=" + Convert.ToString(iv.zooms[1].minValueSpan));

        // ⑧ 数值 startValue/endValue（数值轴）与类目 startValue。
        ChartOption lf = ChartOption.FromJson(
            "{\"series\":[],\"dataZoom\":[" +
            "{\"type\":\"inside\",\"startValue\":-20,\"endValue\":20}]}");
        Console.WriteLine("LF sv=[" + lf.zoomStartValue + "] ev=[" + lf.zoomEndValue + "]");
        ChartOption aq = ChartOption.FromJson(
            "{\"series\":[],\"dataZoom\":[" +
            "{\"type\":\"slider\",\"startValue\":\"2014-06-01\"}]}");
        Console.WriteLine("AQ sv=[" + aq.zoomStartValue + "]");

        // ⑨ 克隆保真 + Create 缺省（无组件、不开窗）。
        ChartOption ac = ChartOption.Clone(a);
        if (ac != null) {
            Console.WriteLine("CL comps=" + Convert.ToString(ac.zooms.Count)
                + " x=" + Convert.ToString(ac.zoomX != null)
                + " start=" + Convert.ToString(ac.zoomStart));
        }
        ChartOption e = ChartOption.Create();
        if (e != null) {
            Console.WriteLine("E zoom=" + Convert.ToString(e.zoom)
                + " comps=" + Convert.ToString(e.zooms.Count)
                + " x=" + Convert.ToString(e.zoomX == null));
        }

        // ⑩ 对象形态（非数组），start>end 自动交换。
        ChartOption ob = ChartOption.FromJson(
            "{\"series\":[],\"dataZoom\":{\"show\":true,\"start\":80,\"end\":20}}");
        Console.WriteLine("OB comps=" + Convert.ToString(ob.zooms.Count)
            + " start=" + Convert.ToString(ob.zoomStart)
            + " end=" + Convert.ToString(ob.zoomEnd));

        // ⑪ K 阴影取值接缝：candles 的收口价（dataShadowDimension 缺省）。
        // 引擎蜡烛序（ParseCandles 契约）= [open, high, low, close]。
        ChartOption k = ChartOption.FromJson(
            "{\"series\":[{\"type\":\"candlestick\"," +
            "\"data\":[[10,13,9,12],[12,14,10,11],[11,16,11,15]]}]," +
            "\"dataZoom\":[{\"type\":\"slider\",\"showDataShadow\":true}]}");
        ChartSeries ks = k.series[0];
        Console.WriteLine("K n=" + Convert.ToString(Chart.ZoomShadowN(ks))
            + " v0=" + Convert.ToString(Chart.ZoomShadowV(ks, 0))
            + " v2=" + Convert.ToString(Chart.ZoomShadowV(ks, 2)));
    }
}
