using System;
using System.IO;

class FileUnicodePath {
    static void Main() {
        string dir = "file_unicode_中文";
        string first = dir + "/参数.txt";
        string second = dir + "/移动.txt";
        Directory.CreateDirectory(dir);
        File.WriteAllText(first, "内容");
        Console.WriteLine(Convert.ToString(File.Exists(first)));
        Console.WriteLine(File.ReadAllText(first));
        File.Move(first, second);
        Console.WriteLine(Convert.ToString(File.Exists(second)));
        File.Delete(second);
        Console.WriteLine(Convert.ToString(File.Exists(second)));
        Directory.Delete(dir);
    }
}
