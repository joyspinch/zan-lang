// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。
class Program {
    static void Main() {
        int acc = 0;
        for (int i = 0; i < 200000; i = i + 1) {
            StringBuilder sb = new StringBuilder();
            sb.Append("HTTP/1.1 ");
            sb.Append(200);
            sb.Append(" OK\r\n");
            sb.Append(i);
            string r = sb.ToString();
            acc = acc + r.Length;
        }
        Console.WriteLine(acc);

        int n = 0;
        for (int i = 0; i < 200000; i = i + 1) {
            string s = "v=" + i + ";";
            n = n + s.Length;
        }
        Console.WriteLine(n);
    }
}
