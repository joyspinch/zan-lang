// A formatting scratch buffer emitted inside a loop must be allocated once in
// the function's entry block: emitting the alloca in the loop body grows the
// stack on every iteration, so a long-running loop (a request loop in a daemon)
// overflows it and the process reports ever-growing memory.
class Program {
    static void Main() {
        int acc = 0;
        for (int i = 0; i < 200000; i = i + 1) {
            StringBuilder sb = new StringBuilder();
            sb.Append("HTTP/1.1 ");
            sb.Append(200);
            sb.Append(" OK\r\n");
            sb.Append(i);
            string r = sb.ToString();
            acc = acc + r.Length;
        }
        Console.WriteLine(acc);

        int n = 0;
        for (int i = 0; i < 200000; i = i + 1) {
            string s = "v=" + i + ";";
            n = n + s.Length;
        }
        Console.WriteLine(n);
    }
}
