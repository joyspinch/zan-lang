using System;

delegate int IntFn(int a);
delegate void Handler(int v);

class Counter {
    public int Base;
    public Counter(int b) { Base = b; }
    public IntFn Adder() { return (x) => x + Base; }
}

class Bus {
    public Handler H;
    public void Fire(int v) { H(v); }
}

class Sink {
    public int Total;
    public void OnE(int v) { Total = Total + v; }
}

class Program {
    static int Apply(IntFn f, int v) { return f(v); }

    static void Main() {
        int k = 10;
        IntFn f = (a) => a + k;
        Console.WriteLine(Convert.ToString(f(5)));

        string p = "hi ";
        IntFn g = (a) => a + p.Length;
        Console.WriteLine(Convert.ToString(g(1)));

        Counter c = new Counter(100);
        IntFn h = c.Adder();
        Console.WriteLine(Convert.ToString(h(7)));

        IntFn nc = (a) => a * 2;
        Console.WriteLine(Convert.ToString(nc(21)));

        Console.WriteLine(Convert.ToString(Apply((a) => a * k, 5)));

        Bus b = new Bus();
        Sink s = new Sink();
        b.H = (v) => { Console.WriteLine("lam " + Convert.ToString(v)); };
        b.Fire(9);
        b.H = s.OnE;
        b.Fire(4);
        b.Fire(6);
        Console.WriteLine(Convert.ToString(s.Total));

        Sink s2 = new Sink();
        Handler m1 = s.OnE;
        Handler m2 = s.OnE;
        Handler m3 = s2.OnE;
        Console.WriteLine(Convert.ToString(m1 == m2));
        Console.WriteLine(Convert.ToString(m1 == m3));
    }
}
