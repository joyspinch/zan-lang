using System;

class Person {
    public string Name;
    public int Age;
}

class Program {
    static void Main() {
        // 1. Reference type nullability & assignment
        string? s1 = null;
        string? s2 = "Zan-Null-Safety";
        string s3 = s2!;
        string s4 = s1 ?? "Default-String";
        Console.WriteLine(s3);
        Console.WriteLine(s4);

        // 2. User class nullability & postfix ! & ??
        Person? p1 = null;
        Person? p2 = new Person { Name = "Bob", Age = 30 };
        Person p3 = p2!;
        Person p4 = p1 ?? new Person { Name = "Fallback", Age = 99 };
        Console.WriteLine(p3.Name);
        Console.WriteLine(Convert.ToString(p3.Age));
        Console.WriteLine(p4.Name);
        Console.WriteLine(Convert.ToString(p4.Age));

        // 3. Flow-sensitive null guard
        if (p2 != null) {
            Console.WriteLine(p2.Name);
        }

        // 4. Array of nullable references
        string?[] arr = new string?[2];
        arr[0] = "Item-0";
        arr[1] = null;
        Console.WriteLine(arr[0]!);
        Console.WriteLine(arr[1] ?? "Null-Slot");

        // 5. Value type nullable & unwrap & Convert.ToString
        int? num1 = null;
        int? num2 = 42;
        int num3 = num2 ?? 0;
        int num4 = num2!;
        Console.WriteLine(Convert.ToString(num3));
        Console.WriteLine(Convert.ToString(num4));
        Console.WriteLine(Convert.ToString(num2));

        Console.WriteLine("NULL-SAFETY-OK");
    }
}
