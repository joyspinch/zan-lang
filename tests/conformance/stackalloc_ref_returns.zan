struct Pixel {
    public int R;
    public int G;
    public int B;
    public Pixel(int r, int g, int b) { R = r; G = g; B = b; }
}

class IntBuf {
    public int[] Data;
    public IntBuf(int n) {
        Data = new int[n];
        for (int i = 0; i < n; i++) Data[i] = (i + 1) * 10;
    }
    public ref int At(int i) {
        return ref Data[i];
    }
    public ref int ArrowAt(int i) => ref Data[i];
}

class PixelGrid {
    public Pixel[] Cells;
    public PixelGrid(int n) {
        Cells = new Pixel[n];
        for (int i = 0; i < n; i++) Cells[i] = new Pixel(i, i * 2, i * 3);
    }
    public ref Pixel Cell(int i) {
        return ref Cells[i];
    }
}

class StrBox {
    public string[] Items;
    public StrBox() {
        Items = new string[2];
        Items[0] = "alpha";
        Items[1] = "beta";
    }
    public ref string Slot(int i) {
        return ref Items[i];
    }
}

class Program {
    static ref int PickMax(ref int a, ref int b) {
        if (a >= b) return ref a;
        return ref b;
    }

    static int StackDot(int n) {
        Span<int> a = stackalloc int[n];
        Span<int> b = stackalloc int[8];
        for (int i = 0; i < n; i++) {
            a[i] = i + 1;
            b[i] = (i + 1) * 2;
        }
        int s = 0;
        for (int i = 0; i < n; i++) s += a[i] * b[i];
        return s;
    }

    static void Main() {
        // 1. stackalloc dynamic + constant (zero-init verified)
        Span<byte> z = stackalloc byte[4];
        Console.WriteLine($"z0={z[0]} dot={StackDot(5)}");

        // 2. ref return read, ref local alias, and direct lvalue assignment
        var buf = new IntBuf(4);
        ref int r1 = ref buf.At(1);
        r1 = 99;
        buf.At(2) = 77;
        buf.ArrowAt(3) += 5;
        Console.WriteLine($"buf={buf.At(0)},{buf.At(1)},{buf.At(2)},{buf.At(3)}");

        // 3. ref return of struct + in-place field mutation
        var grid = new PixelGrid(3);
        grid.Cell(1).G = 255;
        ref var p2 = ref grid.Cell(2);
        p2.R = 128;
        p2.B = 64;
        Console.WriteLine($"p1={grid.Cell(1).R},{grid.Cell(1).G},{grid.Cell(1).B} p2={grid.Cell(2).R},{grid.Cell(2).G},{grid.Cell(2).B}");

        // 4. ref passthrough (non-scoped ref params -> ref return)
        int x = 10;
        int y = 25;
        PickMax(ref x, ref y) = 50;
        Console.WriteLine($"xy={x},{y}");

        // 5. RC-managed string ref return (read + overwrite -> 0 ARC leaks)
        var sb = new StrBox();
        string copy = sb.Slot(0);
        sb.Slot(0) = copy + "_v2";
        ref string s1 = ref sb.Slot(1);
        s1 = "gamma";
        Console.WriteLine($"str={sb.Slot(0)},{sb.Slot(1)}");
    }
}
