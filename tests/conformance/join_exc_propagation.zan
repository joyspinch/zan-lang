using System;
using System.Collections.Generic;
using System.Threading;

// M2：join 必须沿 await 链传播子任务异常——反射派发（InvokeTask）与
// Task.Spawn 两条路都要可达 WebApp 错误处理。
class Job {
    public int Ran;

    public async void Fail() {
        Ran = 1;
        // 先 park 一拍再抛：保证 bind 发生在子任务完成前（确定性路径）。
        // 即时 throw 且先于 bind 被 reap 的子任务，异常传播是既有 WhenAll
        // 语义缺口（TASKS.md 记账）。
        await Task.Delay(1);
        throw new Exception("boom reflected");
    }
}

class Program {
    static WeakReference<Exception> failureWatch;
    static bool cancelledWaitReturned;

    static void Check(bool condition, string message) {
        if (!condition) { throw new Exception(message); }
    }

    static async int ReflectedProbe() {
        Job job = new Job();
        List<long> hs = new List<long>();
        hs.Add(job.InvokeTask("Fail"));
        await Task.WhenAll(hs);
        return 0;
    }

    static async void SpawnFail() {
        await Task.Delay(1);
        throw new Exception("boom spawn");
    }

    static async int SpawnProbe() {
        List<long> hs = new List<long>();
        hs.Add(Task.Spawn(SpawnFail()));
        await Task.WhenAll(hs);
        return 0;
    }

    static async int FailWhenSignalled(Gate finish) {
        await finish.Wait();
        Exception failure = new Exception("boom gated");
        failureWatch = new WeakReference<Exception>(failure);
        throw failure;
    }

    static async void CancelledWait(long failure, Gate bound) {
        long entry = Task.JoinNew(1, 0);
        Check(Task.JoinBind(entry, failure, 0) == 1, "failure was already complete");
        bound.Signal();
        await Task.JoinWaitOwned(entry);
        cancelledWaitReturned = true;
    }

    static async void CancelProbe() {
        Gate finish = new Gate();
        Gate bound = new Gate();
        long failure = Task.Run(FailWhenSignalled(finish));
        Task waiter = Task.Run(CancelledWait(failure, bound));
        await bound.Wait();
        Task.Cancel(waiter);
        finish.Signal();
        while (Task.IsDone(waiter) == 0) { await Task.Yield(); }
        Task.Release(failure);
        Task.Release(waiter);
        Check(!cancelledWaitReturned, "cancelled join returned a result");
        Check(!failureWatch.IsAlive, "cancelled join retained its exception");
        bound.Close();
        finish.Close();
    }

    static async void AnyProbe() {
        Gate finish = new Gate();
        long failure = Task.Run(FailWhenSignalled(finish));
        List<long> handles = new List<long>();
        handles.Add(failure);
        finish.Signal();
        // A retained, already-completed child gives WhenAny its immediate path.
        while (Task.IsDone(failure) == 0) { await Task.Yield(); }
        try {
            await Task.WhenAny(handles);
            throw new Exception("WhenAny swallowed its child exception");
        } catch (Exception e) {
            Check(e.Message == "boom gated", "WhenAny exc message");
        } finally {
            Task.Release(failure);
            finish.Close();
        }
        Check(!failureWatch.IsAlive, "failed join retained its exception");
    }

    static async int Main() {
        try {
            int rc = await ReflectedProbe();
            Console.WriteLine("BAD reflected swallowed rc=" + rc);
            return 1;
        } catch (Exception e) {
            Check(e.Message == "boom reflected", "reflected exc message");
            Console.WriteLine("reflected propagated");
        }

        try {
            int rc = await SpawnProbe();
            Console.WriteLine("BAD spawn swallowed rc=" + rc);
            return 1;
        } catch (Exception e) {
            Check(e.Message == "boom spawn", "spawn exc message");
            Console.WriteLine("spawn propagated");
        }
        await AnyProbe();
        Console.WriteLine("whenany propagated");
        await CancelProbe();
        Console.WriteLine("cancelled join released");
        Console.WriteLine("join exc propagation passed");
        return 0;
    }
}
