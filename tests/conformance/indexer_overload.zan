// C# 式索引器重载：一个类可声明多个 this[]，按下标参数类型区分（同
// 系统底层交互与数据流转契约
// 只按名字判重，索引器属性又全部命名 Item，第二个索引器无法声明。
// 现在 binder 豁免 indexer/indexer 同名对，真实重复（同下标类型）仍由
// 合成 op_index 的重复方法检查拦截。
using System;

namespace IndexerOverload;

class Bag {
    string[] data = new string[8];
    int named = 42;

    public string this[int i] {
        get { return data[i]; }
        set { data[i] = value; }
    }

    public string this[string key] => "k:" + key;

    public int Named { get { return named; } }
}

class Program {
    static void Main() {
        Bag b = new Bag();
        b[1] = "hello";
        Console.WriteLine(b[1]);
        Console.WriteLine(b["k"]);
        Console.WriteLine(Convert.ToString(b.Named));
    }
}
