// 测试断言与状态转移验证。
// 核心契约与语义定义。
using System;
using System.Diagnostics;
using System.Json;

class Program {
    static void Main() {
        ServerMetrics m = ServerMetrics.Global();
        // 核心契约与执行状态转移规范。
        m.RecordRequest("GET", "/fast", 200, 3000);
        m.RecordRequest("GET", "/mid", 200, 40000);
        m.RecordRequest("GET", "/slow", 500, 900000);
        m.RecordQuery("select 1", 6000);
        m.RecordQuery("select 2", 8000);

        JsonValue s = JsonValue.ParseLenient(m.SeriesJson(5));
        Console.WriteLine("step " + Convert.ToString(s.Long("step_ms", 0)));
        Console.WriteLine("count " + Convert.ToString(s.Long("count", 0)));

        JsonValue pts = s.Get("points");
        if (pts == null) { Console.WriteLine("null:pts"); return; }
        Console.WriteLine("points " + Convert.ToString(pts.Count()));

        // 测试断言与状态转移验证。
        Console.WriteLine("first t " + Convert.ToString(pts.At(0).Long("t", 1)));
        Console.WriteLine("last t "
            + Convert.ToString(pts.At(pts.Count() - 1).Long("t", 1)));

        // 测试断言与状态转移验证。
        // 核心契约与语义定义。
        long req = 0;
        long err = 0;
        long queries = 0;
        long max = 0;
        long p95 = 0;
        long idleSeconds = 0;
        for (int i = 0; i < pts.Count(); i = i + 1) {
            JsonValue p = pts.At(i);
            req = req + p.Long("req", 0);
            err = err + p.Long("err", 0);
            queries = queries + p.Long("queries", 0);
            if (p.Long("max_us", 0) > max) { max = p.Long("max_us", 0); }
            if (p.Long("p95_us", 0) > p95) { p95 = p.Long("p95_us", 0); }
            // 核心契约与语义定义。
            if (p.Long("req", 0) == 0 && p.Long("avg_us", -1) == 0) {
                idleSeconds = idleSeconds + 1;
            }
        }
        Console.WriteLine("req " + Convert.ToString(req)
            + " err " + Convert.ToString(err)
            + " queries " + Convert.ToString(queries)
            + " max " + Convert.ToString(max));

        // 测试断言与状态转移验证。
        Console.WriteLine("p95 <= max " + Convert.ToString(p95 <= max));
        Console.WriteLine("idle seconds " + Convert.ToString(idleSeconds >= 3));

        // 测试断言与状态转移验证。
        JsonValue big = JsonValue.ParseLenient(m.SeriesJson(100000));
        Console.WriteLine("clamped " + Convert.ToString(big.Long("count", 0)));

        // 核心契约与语义定义。
        // 测试断言与状态转移验证。
        Console.WriteLine("rss>0 " + Convert.ToString(
            ServerMetrics.MemoryRssBytes() > 0));
        Console.WriteLine("cpu>=0 " + Convert.ToString(
            ServerMetrics.CpuMillis() >= 0));
    }
}
