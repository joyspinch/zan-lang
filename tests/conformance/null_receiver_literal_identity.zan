using System;

// Guard messages originate in reusable compiler stack buffers. Equal-length
// receiver names must retain distinct literal identities after later emission.
class NullReceiverLiteralTarget {
    public int Get() { return 17; }
}
class NullReceiverLiteralIdentity {
    static int ReadMenu(NullReceiverLiteralTarget menuResult) {
        return menuResult.Get();
    }
    static int ReadTabs(NullReceiverLiteralTarget editorTabs) {
        return editorTabs.Get();
    }
    static int Main() {
        int failures = 0;
        NullReceiverLiteralTarget live = new NullReceiverLiteralTarget();
        int menuValue = NullReceiverLiteralIdentity.ReadMenu(live);
        int tabsValue = NullReceiverLiteralIdentity.ReadTabs(live);
        Console.WriteLine("live menu=" + Convert.ToString(menuValue));
        Console.WriteLine("live tabs=" + Convert.ToString(tabsValue));
        if (menuValue != 17 || tabsValue != 17) { failures = failures + 1; }

        bool caughtMenu = false;
        try {
            NullReceiverLiteralIdentity.ReadMenu(null);
        } catch (Exception ex) {
            caughtMenu = true;
            Console.WriteLine("MENU " + ex.Message);
            if (ex.Message != "null reference: receiver 'menuResult' is null") {
                failures = failures + 1;
            }
        }
        bool caughtTabs = false;
        try {
            NullReceiverLiteralIdentity.ReadTabs(null);
        } catch (Exception ex) {
            caughtTabs = true;
            Console.WriteLine("TABS " + ex.Message);
            if (ex.Message != "null reference: receiver 'editorTabs' is null") {
                failures = failures + 1;
            }
        }
        if (!caughtMenu || !caughtTabs) { failures = failures + 1; }
        Console.WriteLine("FAILURES " + Convert.ToString(failures));
        return failures == 0 ? 0 : 1;
    }
}
