using System;
using System.Windows;

namespace Conf;

class DesktopCompanionQuestsRoutineDndTest {
    static void Main() {
        // 1. 每日互动任务板：进度推进、一次性领奖、全勤加成与跨日重置
        CompanionDailyQuestBoard board = new CompanionDailyQuestBoard(100, 150);
        board.AddQuest("pet", 3, 50);
        board.AddQuest("focus", 2, 80);

        board.AdvanceQuest("pet", 3);
        int q1Reward = board.ClaimQuestReward("pet");
        int q1Dup = board.ClaimQuestReward("pet");
        int earlyBonus = board.ClaimAllCompleteBonus(); // focus 未完成 -> 0

        board.AdvanceQuest("focus", 2);
        int bonus = board.ClaimAllCompleteBonus();      // 全部完成 -> 150
        int bonusDup = board.ClaimAllCompleteBonus();   // 防重复 -> 0

        bool rolled = board.RolloverIfNewDay(101);      // 跨日清零
        int afterResetClaim = board.ClaimQuestReward("pet");

        bool questOk = q1Reward == 50 && q1Dup == 0 && earlyBonus == 0
            && bonus == 150 && bonusDup == 0 && rolled && afterResetClaim == 0;
        Console.WriteLine("companion-daily-quest-board: " + Convert.ToString(questOk ? 1 : 0));

        // 2. 24 小时作息生物钟：白昼常规区间与跨午夜睡眠区间精准解析
        CompanionCircadianRoutine routine = new CompanionCircadianRoutine();
        routine.AddSlot("Work", 540, 1080);   // 09:00..18:00
        routine.AddSlot("Sleep", 1380, 420);  // 23:00..07:00（跨午夜）

        string aWork = routine.ResolveActivity(600);    // 10:00 -> Work
        string aLate = routine.ResolveActivity(1410);   // 23:30 -> Sleep
        string aEarly = routine.ResolveActivity(180);   // 03:00 -> Sleep
        string aIdle = routine.ResolveActivity(1200);   // 20:00 -> Idle

        bool routineOk = aWork == "Work" && aLate == "Sleep" && aEarly == "Sleep" && aIdle == "Idle";
        Console.WriteLine("companion-circadian-routine: " + Convert.ToString(routineOk ? 1 : 0));

        // 3. 静默勿扰策略引擎：勿扰窗分级降级 + 全屏/会议抑制 + 关键告警静音透传
        CompanionDndFocusPolicy dnd = new CompanionDndFocusPolicy(true, 1380, 420); // 23:00..07:00
        DndDeliveryAction dayCasual = dnd.EvaluateDelivery(600, DndAlertLevel.Casual);       // PopupWithSound
        DndDeliveryAction nightCasual = dnd.EvaluateDelivery(1400, DndAlertLevel.Casual);    // SuppressToTray
        DndDeliveryAction nightImp = dnd.EvaluateDelivery(1400, DndAlertLevel.Important);    // SilentToast
        dnd.FullscreenAppActive = true;
        DndDeliveryAction fsImp = dnd.EvaluateDelivery(600, DndAlertLevel.Important);        // SuppressToTray
        DndDeliveryAction fsCrit = dnd.EvaluateDelivery(600, DndAlertLevel.Critical);        // SilentToast

        bool dndOk = dayCasual == DndDeliveryAction.PopupWithSound
            && nightCasual == DndDeliveryAction.SuppressToTray
            && nightImp == DndDeliveryAction.SilentToast
            && fsImp == DndDeliveryAction.SuppressToTray
            && fsCrit == DndDeliveryAction.SilentToast;
        Console.WriteLine("companion-dnd-focus-policy: " + Convert.ToString(dndOk ? 1 : 0));
    }
}
