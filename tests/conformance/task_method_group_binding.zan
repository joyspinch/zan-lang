using System;
using System.Threading;

class TaskMethodBase {
    public virtual void Work() { Console.WriteLine("base"); }
}
class TaskMethodDerived : TaskMethodBase {
    public override void Work() { Console.WriteLine("derived"); }
}
class TaskMethodReceiver {
    public int value = 37;
    public static WeakReference<TaskMethodReceiver> observer;
    public void Work(int ignored) { Console.WriteLine("wrong overload"); }
    public void Work() { Console.WriteLine(value); }
    public Task QueueBare() { return Task.Run(Work); }
    public static TaskMethodReceiver Make() {
        TaskMethodReceiver receiver = new TaskMethodReceiver();
        observer = new WeakReference<TaskMethodReceiver>(receiver);
        return receiver;
    }
}
class TaskMethodGroupBinding {
    static void StaticWork() { Console.WriteLine("static"); }
    static Task QueueBare() {
        TaskMethodReceiver receiver = TaskMethodReceiver.Make();
        return receiver.QueueBare();
    }
    static void Main() {
        Task bareStatic = Task.Run(StaticWork);
        bareStatic.Wait();
        Task qualifiedStatic = Task.Run(TaskMethodGroupBinding.StaticWork);
        qualifiedStatic.Wait();
        Task bareInstance = QueueBare();
        bareInstance.Wait();
        Console.WriteLine(TaskMethodReceiver.observer.IsAlive);
        Task temporary = Task.Run(TaskMethodReceiver.Make().Work);
        temporary.Wait();
        Console.WriteLine(TaskMethodReceiver.observer.IsAlive);
        Task constructed = Task.Run(new TaskMethodReceiver().Work);
        constructed.Wait();
        TaskMethodBase receiver = new TaskMethodDerived();
        Task virtualTask = Task.Run(receiver.Work);
        virtualTask.Wait();
        Task spawned = Task.Spawn(receiver.Work);
        spawned.Wait();
    }
}
