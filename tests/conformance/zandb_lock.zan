using System;
using System.Data.ZanDb;
using System.IO;

// 单写模型守卫用例：第一个句柄持有期间，第二个 ZanStore 打开
// 同一路径必须失败并留下明确错误；释放后可重新打开且数据完好。
// 输出确定性，与 zandb_lock.out 比对。
class ZanDbLockTest {
    static int checks = 0;

    static void Ok(bool cond, string what) {
        checks = checks + 1;
        Console.WriteLine((cond ? "ok " : "FAIL ") + Convert.ToString(checks)
            + " - " + what);
    }

    static void Clean(string basePath) {
        File.Delete(basePath);
        File.Delete(basePath + ".m0");
        File.Delete(basePath + ".m1");
        for (int i = 0; i < 4; i = i + 1) {
            File.Delete(basePath + ".s" + Convert.ToString(i));
        }
    }

    static void Main() {
        string path = "_scratch/zandb_lock_tmp.zdb";
        // 库文件写 _scratch/（git-ignored），不在仓库根残留 .zdb/.zseg。
        Directory.CreateDirectory("_scratch");
        Clean(path);

        ZanStore first = ZanStore.Open(path, ZanStore.DUR_SYNC);
        Ok(first.IsOpen(), "first open");
        first.Put("a", "1");

        ZanStore second = ZanStore.Open(path, ZanStore.DUR_SYNC);
        Ok(!second.IsOpen(), "second open refused");
        Ok(second.GetError().IndexOf("lock") >= 0, "error mentions lock");

        first.Put("b", "2");
        first.Close();

        ZanStore third = ZanStore.Open(path, ZanStore.DUR_SYNC);
        Ok(third.IsOpen(), "reopen after release");
        Ok(third.Get("a") == "1" && third.Get("b") == "2", "data intact");
        third.Close();

        Console.WriteLine("done " + Convert.ToString(checks) + " checks");
        Clean(path);
    }
}
