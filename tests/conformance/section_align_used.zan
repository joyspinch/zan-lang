using System;

[Align(64)]
struct CacheLineSlot {
    public long Counter;
    public long Tag;
}

class Program {
    [Align(4096)]
    static long g_page_aligned = 0L;

    [Section(".rodata.boot")]
    [Used]
    [Align(16)]
    static uint g_boot_magic = 0x1BADB002u;

    [Section(".text.fast")]
    [Used]
    [NoAlloc]
    static int FastKernelStep(int x) {
        return x * 3 + 7;
    }

    static int Main() {
        static_assert(alignof(CacheLineSlot) == 64);

        CacheLineSlot localSlot = new CacheLineSlot();
        localSlot.Counter = 123L;
        localSlot.Tag = 456L;

        nint pLocal = NativeMemory.AddressOf(ref localSlot);
        nint pPage = NativeMemory.AddressOf(ref g_page_aligned);
        nint pMagic = NativeMemory.AddressOf(ref g_boot_magic);

        int alLocal = ((long)pLocal % 64L == 0L) ? 1 : 0;
        int alPage = ((long)pPage % 4096L == 0L) ? 1 : 0;
        int alMagic = ((long)pMagic % 16L == 0L) ? 1 : 0;
        int step = FastKernelStep(10);

        Console.WriteLine($"alignof={alignof(CacheLineSlot)}");
        Console.WriteLine($"al={alLocal},{alPage},{alMagic}");
        Console.WriteLine($"magic={g_boot_magic} step={step}");
        return 0;
    }
}
