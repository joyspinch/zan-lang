using System;
using System.Numerics;

class Program {
    [Export("k_fshl64")]
    [NoAlloc]
    static ulong Fshl64(ulong hi, ulong lo, int sh) {
        return BitOperations.FunnelShiftLeft(hi, lo, sh);
    }

    [Export("k_fshr64")]
    [NoAlloc]
    static ulong Fshr64(ulong hi, ulong lo, int sh) {
        return BitOperations.FunnelShiftRight(hi, lo, sh);
    }

    [Export("k_divrem128")]
    [NoAlloc]
    static ulong DivRemU(ulong hi, ulong lo, ulong dv, ref ulong rem) {
        return BitOperations.DivRem128(hi, lo, dv, ref rem);
    }

    static int Main() {
        // 1. FunnelShiftLeft / FunnelShiftRight (32-bit & 64-bit)
        uint fl32 = BitOperations.FunnelShiftLeft(0x12345678U, 0x9ABCDEF0U, 8);   // 0x3456789A
        uint fr32 = BitOperations.FunnelShiftRight(0x12345678U, 0x9ABCDEF0U, 8);  // 0x789ABCDE
        ulong fl64 = Fshl64(0x0123456789ABCDEFUL, 0xFEDCBA9876543210UL, 16);      // 0x456789ABCDEFFEDC
        ulong fr64 = Fshr64(0x0123456789ABCDEFUL, 0xFEDCBA9876543210UL, 16);      // 0xCDEFFEDCBA987654

        // 2. 16-bit / 32-bit / 64-bit ReverseEndianness
        ushort b16 = BitOperations.ReverseEndianness((ushort)0x1234);
        short s16 = BitOperations.ReverseEndianness((short)0x0102);

        // 3. Unsigned 128/64 hardware division (BigMul -> DivRem128 roundtrip + remainder)
        ulong a = 0x123456789ABCDEF0UL;
        ulong b = 0xFEDCBA9876543210UL;
        ulong plo = 0UL;
        ulong phi = BitOperations.BigMul(a, b, ref plo);
        ulong r1 = 0UL;
        ulong q1 = DivRemU(phi, plo, b, ref r1);

        ulong r2 = 0UL;
        ulong q2 = DivRemU(1UL, 7UL, 3UL, ref r2); // (2^64 + 7) / 3 = 0x5555555555555557, rem = 2

        // 4. Signed 128/64 hardware division: (-100) / 7 => q=-14, r=-2
        long sr = 0L;
        long sq = BitOperations.DivRem128(-1L, -100L, 7L, ref sr);

        int fOk = (fl32 == 0x3456789AU && fr32 == 0x789ABCDEU &&
                   fl64 == 0x456789ABCDEFFEDCUL && fr64 == 0xCDEFFEDCBA987654UL) ? 1 : 0;
        int bOk = (b16 == (ushort)0x3412 && s16 == (short)0x0201) ? 1 : 0;
        int dOk = (q1 == a && r1 == 0UL && q2 == 0x5555555555555557UL && r2 == 2UL &&
                   sq == -14L && sr == -2L) ? 1 : 0;
        Console.WriteLine($"f={fOk} b={bOk} d={dOk}");
        return 0;
    }
}
