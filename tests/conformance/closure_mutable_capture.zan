using System;

// A lambda captures the variable, not its value (C# semantics): writes inside
// the lambda are visible outside it, several lambdas share one variable, and
// the variable outlives the frame that declared it when a closure does.
delegate void Step();
delegate int Read();

class Counter {
    public Step Bump;
    public Read Get;
}

class Program {
    static Counter Make(int start) {
        int n = start;
        Counter c = new Counter();
        c.Bump = () => { n = n + 1; };
        c.Get = () => n;
        return c;
    }

    static void Main() {
        int n = 0;
        Step inc = () => { n = n + 1; };
        inc();
        inc();
        Console.WriteLine(Convert.ToString(n));

        // the enclosing method writes the same variable
        n = 40;
        inc();
        Console.WriteLine(Convert.ToString(n));

        // two closures sharing one variable
        int sum = 0;
        Step addFive = () => { sum = sum + 5; };
        Step addHundred = () => { sum = sum + 100; };
        addFive();
        addHundred();
        addFive();
        Console.WriteLine(Convert.ToString(sum));

        // the loop drives the closure; the count survives every iteration
        int seen = 0;
        Step tick = () => { seen = seen + 1; };
        for (int i = 0; i < 4; i = i + 1) {
            tick();
        }
        Console.WriteLine(Convert.ToString(seen));

        // a read-only capture of a written variable reads the shared value
        int shared = 1;
        Step twice = () => { shared = shared * 2; };
        Read peek = () => shared;
        twice();
        twice();
        Console.WriteLine(Convert.ToString(peek()));

        // the variable outlives the frame that declared it
        Counter c = Make(10);
        c.Bump();
        c.Bump();
        Console.WriteLine(Convert.ToString(c.Get()));
    }
}
