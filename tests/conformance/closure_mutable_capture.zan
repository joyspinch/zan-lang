using System;

delegate void Step();
delegate int Read();
delegate int ReadArg(int value);
delegate Read MakeRead(int value);
delegate string ReadText();

class Box {
    public int Value;

    public int ReadValue() {
        return Value;
    }
}

struct TextCell {
    public string Text;
}

class Counter {
    public Step Bump;
    public Read Get;
}

class Program {
    static Counter Make(int start) {
        int n = start;
        Counter c = new Counter();
        c.Bump = () => { n = n + 1; };
        c.Get = () => n;
        return c;
    }

    static Read CaptureParameter(int value) {
        Read read = () => value;
        value = 31;
        return read;
    }

    static ReadText CaptureStructParameter(TextCell value) {
        ReadText read = () => value.Text;
        TextCell changed;
        changed.Text = "param-" + Convert.ToString(52);
        value = changed;
        return read;
    }

    static ReadText CaptureGenericParameter<T>(T value) {
        return () => Convert.ToString(value);
    }

    static ReadText CaptureGenericLocal<T>(T value) {
        T local = value;
        return () => Convert.ToString(local);
    }

    static void ThrowAfterCapture() {
        TextCell value;
        value.Text = "throw-" + Convert.ToString(3);
        ReadText read = () => value.Text;
        throw new Exception("captured");
    }

    static void Main(string[] args) {
        int n = 0;
        Step inc = () => { n = n + 1; };
        inc();
        inc();
        Console.WriteLine(Convert.ToString(n));

        n = 40;
        inc();
        Console.WriteLine(Convert.ToString(n));

        int sum = 0;
        Step addFive = () => { sum = sum + 5; };
        Step addHundred = () => { sum = sum + 100; };
        addFive();
        addHundred();
        addFive();
        Console.WriteLine(Convert.ToString(sum));

        int seen = 0;
        Step tick = () => { seen = seen + 1; };
        for (int i = 0; i < 4; i = i + 1) {
            tick();
        }
        Console.WriteLine(Convert.ToString(seen));

        int shared = 1;
        Step twice = () => { shared = shared * 2; };
        Read peek = () => shared;
        twice();
        twice();
        Console.WriteLine(Convert.ToString(peek()));

        int later = 1;
        Read readLater = () => later;
        later = 42;
        Console.WriteLine(Convert.ToString(readLater()));

        int shadow = 7;
        ReadArg parameterShadow = (shadow) => shadow + 1;
        Read localShadow = () => { int shadow = 9; return shadow; };
        Console.WriteLine(Convert.ToString(parameterShadow(4)));
        Console.WriteLine(Convert.ToString(localShadow()));
        Console.WriteLine(Convert.ToString(shadow));
        Read sibling = () => shadow;
        shadow = 8;
        Console.WriteLine(Convert.ToString(sibling()));

        Read parameter = CaptureParameter(2);
        Console.WriteLine(Convert.ToString(parameter()));
        MakeRead nestedFactory = (value) => {
            Read nested = () => value;
            value = 33;
            return nested;
        };
        Read nestedParameter = nestedFactory(3);
        Console.WriteLine(Convert.ToString(nestedParameter()));

        Box first = new Box();
        first.Value = 5;
        Box box = first;
        Read readBox = () => box.Value;
        Read callBox = () => box.ReadValue();
        Step writeBox = () => { box.Value = box.Value + 1; };
        Box second = new Box();
        second.Value = 44;
        box = second;
        Console.WriteLine(Convert.ToString(readBox()));
        Console.WriteLine(Convert.ToString(callBox()));
        writeBox();
        Console.WriteLine(Convert.ToString(readBox()));

        string text = "text-" + Convert.ToString(1);
        ReadText readText = () => text;
        text = "text-" + Convert.ToString(2);
        Console.WriteLine(readText());

        TextCell cell;
        cell.Text = "cell-" + Convert.ToString(1);
        ReadText readCell = () => cell.Text;
        TextCell replacement;
        replacement.Text = "cell-" + Convert.ToString(2);
        cell = replacement;
        Console.WriteLine(readCell());

        TextCell input;
        input.Text = "input-" + Convert.ToString(7);
        ReadText readStructParameter = CaptureStructParameter(input);
        Console.WriteLine(readStructParameter());
        Console.WriteLine(input.Text);

        ReadText genericParameter = CaptureGenericParameter<string>("generic-param");
        ReadText genericLocal = CaptureGenericLocal<string>("generic-local");
        Console.WriteLine(genericParameter());
        Console.WriteLine(genericLocal());

        Read readArgs = () => args.Count;
        args = new string[2];
        Console.WriteLine(Convert.ToString(readArgs()));

        try {
            ThrowAfterCapture();
        } catch (Exception e) {
            Console.WriteLine("caught");
        }

        Counter c = Make(10);
        c.Bump();
        c.Bump();
        Console.WriteLine(Convert.ToString(c.Get()));
    }
}
