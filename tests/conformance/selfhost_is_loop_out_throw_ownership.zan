using System;
using System.Collections.Generic;

namespace SelfhostIsLoopOutThrowOwnership;

class Box {
    public int Val;
    public string Name;
    public Box(int v) { this.Val = v; this.Name = "b_" + v.ToString(); }
    public int ThrowIntProp {
        get { throw new Exception("int_boom"); }
    }
    public string ThrowStrProp {
        get { throw new Exception("str_boom"); }
    }
}

class BadEnumerable {
    public Box Seed;
    public BadEnumerable(Box b) { this.Seed = b; }
    public BadEnumerator GetEnumerator() {
        throw new Exception("enum_boom_" + this.Seed.Name);
    }
}

class BadEnumerator {
    public bool MoveNext() { return false; }
    public Box Current { get { return null; } }
}

class Program {
    static Box MakeBox(int v) { return new Box(v); }
    static object MakeObjBox(int v) { return new Box(v); }
    static Exception BoomEx() { throw new Exception("boom_ex"); }
    static List<Box> BoomList() { throw new Exception("boom_list"); }
    static List<Box> MakeList() {
        List<Box> ls = new List<Box>();
        ls.Add(new Box(1));
        return ls;
    }
    static bool TryMakeBox(int v, out Box b) {
        b = new Box(v);
        return v > 0;
    }

    static int TestSyncIsPatterns() {
        int acc = 0;
        Func<int> f = null;
        if (MakeObjBox(5) is Box b) {
            f = () => b.Val + b.Name.Length;
            acc = acc + f();
        }
        if (f != null) { acc = acc + f(); }

        Func<int> f2 = null;
        if (MakeBox(0).Val > 0 && MakeObjBox(7) is Box b2) {
            f2 = () => b2.Val;
        }
        if (f2 != null) { acc = acc + f2(); }

        if (MakeObjBox(7) is Box b3) {
            acc = acc + b3.Val;
        }
        if (MakeObjBox(8) is Box b3) {
            acc = acc + b3.Val + b3.Name.Length;
        }
        return acc;
    }

    static int TestSyncInlineOut() {
        int acc = 0;
        Func<int> syncCap = null;
        if (TryMakeBox(6, out Box sb)) {
            syncCap = () => sb.Val + sb.Name.Length;
        }
        if (syncCap != null) { acc = acc + syncCap(); }

        int i = 0;
        while (TryMakeBox(2 - i, out Box wb)) {
            acc = acc + wb.Val + wb.Name.Length;
            i = i + 1;
        }
        return acc;
    }

    static int TestLoopsAndThrowTemps() {
        int acc = 0;
        int di = 0;
        do {
            acc = acc + di;
            di = di + 1;
        } while (MakeBox(di).Val < 3);

        try {
            int k = 0;
            do { k = k + 1; } while (MakeBox(1).Val + MakeBox(2).ThrowIntProp < 3);
        } catch (Exception e) { acc = acc + e.Message.Length; }

        for (int i = 0; i < 3; i = MakeBox(i + 1).Val) {
            acc = acc + i;
        }

        try {
            for (int i = 0; i < 3; i = MakeBox(1).Val + MakeBox(2).ThrowIntProp) {
                acc = acc + i;
            }
        } catch (Exception e) { acc = acc + e.Message.Length; }

        try {
            throw (MakeBox(1).Val > 0 ? BoomEx() : new Exception("x"));
        } catch (Exception e) { acc = acc + e.Message.Length; }

        try {
            foreach (Box b in (MakeBox(1).Val > 0 ? BoomList() : MakeList())) {
                acc = acc + b.Val;
            }
        } catch (Exception e) { acc = acc + e.Message.Length; }

        try {
            foreach (Box b in new BadEnumerable(MakeBox(4))) {
                acc = acc + b.Val;
            }
        } catch (Exception e) { acc = acc + e.Message.Length; }

        return acc;
    }

    static void Main() {
        Console.WriteLine("syncIs=" + TestSyncIsPatterns().ToString());
        Console.WriteLine("syncOut=" + TestSyncInlineOut().ToString());
        Console.WriteLine("loopsThrow=" + TestLoopsAndThrowTemps().ToString());
    }
}
