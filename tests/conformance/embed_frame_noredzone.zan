using System;

class Program {
    [NoInline]
    [NoRedZone]
    [NoAlloc]
    static int ProbeEmbedAndFrame() {
        Span<byte> blob = NativeMemory.IncludeBytes("embed_frame_noredzone.bin");
        bool embedOk = (blob.Length == 8 &&
                        blob[0] == (byte)0x5A &&
                        blob[1] == (byte)0x41 &&
                        blob[2] == (byte)0x4E &&
                        blob[3] == (byte)0x00 &&
                        blob[4] == (byte)0xFF &&
                        blob[5] == (byte)0x10 &&
                        blob[6] == (byte)0x20 &&
                        blob[7] == (byte)0x7F);
        nint ra = NativeMemory.ReturnAddress(0);
        nint fa = NativeMemory.FrameAddress(0);
        int ok = (embedOk && ra != (nint)0 && fa != (nint)0) ? 1 : 0;
        return ok * 100 + (int)blob.Length;
    }

    static int Main() {
        int r = ProbeEmbedAndFrame();
        Console.WriteLine($"r={r}");
        return 0;
    }
}
