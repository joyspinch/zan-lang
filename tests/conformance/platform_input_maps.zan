using System;
using System.Input;
using System.IO;
using System.Windows;

/* The cross-platform parts of the desktop-integration modules: the VK
 * translation tables the POSIX input backends drive, the Win32-compatible
 * MessageBox return codes, and File.ReadAllBytes (which Screen's BMP readback
 * relies on, so it must keep embedded NUL bytes). None of this touches a
 * display, so it runs identically on every platform. */
class Program {
    static void Main() {
        /* VK -> X11 keysym: letters lower-case, digits literal, F-keys "Fn",
         * modifiers by name; an unmapped code must come back empty so the
         * backend reports it instead of pressing an arbitrary key. */
        Console.WriteLine("keysym=" + InputTool.Keysym(0x41)
            + "," + InputTool.Keysym(0x5A)
            + "," + InputTool.Keysym(0x39)
            + "," + InputTool.Keysym(0x74)
            + "," + InputTool.Keysym(0x11)
            + "," + InputTool.Keysym(0x0D)
            + ",[" + InputTool.Keysym(0xFF) + "]");

        /* VK -> macOS key code (non-contiguous table) and the System Events
         * modifier names. -1 marks "no equivalent". */
        Console.WriteLine("mackey=" + Convert.ToString(InputTool.MacKeyCode(0x41))
            + "," + Convert.ToString(InputTool.MacKeyCode(0x53))
            + "," + Convert.ToString(InputTool.MacKeyCode(0x30))
            + "," + Convert.ToString(InputTool.MacKeyCode(0x70))
            + "," + Convert.ToString(InputTool.MacKeyCode(0x0D))
            + "," + Convert.ToString(InputTool.MacKeyCode(0x11)));
        Console.WriteLine("macmod=" + InputTool.MacModifier(0x11)
            + "|" + InputTool.MacModifier(0x5B)
            + "|[" + InputTool.MacModifier(0x41) + "]");

        /* Keyboard's own name table round-trips through both directions. */
        Console.WriteLine("vk=" + Keyboard.VKName(Keyboard.VK("ctrl"))
            + Keyboard.VKName(Keyboard.VK("F5"))
            + Keyboard.VKName(Keyboard.VK("pgdn"))
            + Convert.ToString(Keyboard.VK("nosuchkey")));

        /* MessageBox keeps the Win32 IDOK/IDCANCEL/IDYES/IDNO values on every
         * platform, so callers compare against the same constants. */
        Console.WriteLine("dlgcodes=" + Convert.ToString(MessageBox.Ok())
            + Convert.ToString(MessageBox.Cancel())
            + Convert.ToString(MessageBox.Yes())
            + Convert.ToString(MessageBox.No()));

        /* ReadAllBytes is binary-safe: an embedded NUL must not truncate. */
        byte[] data = new byte[5];
        data[0] = 66;
        data[1] = 0;
        data[2] = 77;
        data[3] = 228;
        data[4] = 255;
        string path = Path.GetTempPath() + "zan_conf_bytes.bin";
        File.WriteAllBytes(path, data);
        byte[] back = File.ReadAllBytes(path);
        File.Delete(path);
        string dump = "";
        for (int i = 0; i < back.Length; i = i + 1) {
            if (i > 0) { dump = dump + "-"; }
            dump = dump + Convert.ToString(back[i]);
        }
        Console.WriteLine("bytes=" + Convert.ToString(back.Length) + ":" + dump);
    }
}
