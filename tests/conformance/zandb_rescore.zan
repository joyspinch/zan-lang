using System;
using System.Data.ZanDb;
using System.Json;
using System.IO;

// 刀3b 两段式重打分一致性用例：量化索引 ADC 近召回 k×4 候选，
// 精排段经文档行（tag 11 float32 数组）取原向量重算精确距离。
// 钉死：候选覆盖下 rescore top-k 与精确真值完全一致、距离与
// 真值同式、过滤穿透、墓碑排除、重开往返、非量化索引转发普通
// 搜索。输出确定性，与 zandb_rescore.out 比对。
class ZanDbRescoreTest {
    static int checks = 0;
    static long seed = 987654321;

    static void Ok(bool cond, string what) {
        checks = checks + 1;
        if (cond) {
            Console.WriteLine("ok " + Convert.ToString(checks) + " - " + what);
        } else {
            Console.WriteLine("FAIL " + Convert.ToString(checks) + " - " + what);
        }
    }

    static float Next() {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        double v = (double)(seed % 2001) / 1000.0 - 1.0;
        return (float)v;
    }

    static JsonValue Doc(int i, float[] vector) {
        JsonValue doc = JsonValue.NewObject();
        doc.Put("name", JsonValue.NewStr("doc" + Convert.ToString(i)));
        doc.Put("group", JsonValue.NewStr(i % 2 == 0 ? "even" : "odd"));
        JsonValue arr = JsonValue.NewArray();
        for (int j = 0; j < vector.Length; j = j + 1) {
            arr.Append(JsonValue.NewDouble((double)vector[j]));
        }
        doc.Put("embedding", arr);
        return doc;
    }

    // 暴力余弦 top-k（距离升序、id 升序平手）。
    static List<int> Truth(List<int> ids, List<float[]> vectors, float[] query, int k) {
        List<int> order = new List<int>();
        List<double> dist = new List<double>();
        double nq = 0;
        for (int j = 0; j < query.Length; j = j + 1) { nq = nq + query[j] * query[j]; }
        nq = Math.Sqrt(nq);
        for (int i = 0; i < ids.Count; i = i + 1) {
            double dot = 0;
            double nv = 0;
            for (int j = 0; j < query.Length; j = j + 1) {
                dot = dot + query[j] * vectors[i][j];
                nv = nv + vectors[i][j] * vectors[i][j];
            }
            nv = Math.Sqrt(nv);
            double d = 1.0 - dot / (nq * nv);
            int at = 0;
            while (at < order.Count && (dist[at] < d
            || (dist[at] == d && ids[at] < ids[i]))) { at = at + 1; }
            order.Insert(at, ids[i]);
            dist.Insert(at, d);
        }
        List<int> top = new List<int>();
        for (int i = 0; i < k && i < order.Count; i = i + 1) { top.Add(order[i]); }
        return top;
    }

    static int Overlap(List<VectorHit> hits, List<int> truth) {
        int overlap = 0;
        for (int i = 0; i < hits.Count; i = i + 1) {
            for (int j = 0; j < truth.Count; j = j + 1) {
                if (hits[i].id == truth[j]) { overlap = overlap + 1; }
            }
        }
        return overlap;
    }

    static void Clean(string basePath) {
        File.Delete(basePath);
        File.Delete(basePath + ".m0");
        File.Delete(basePath + ".m1");
        for (int i = 0; i < 40; i = i + 1) {
            File.Delete(basePath + ".s" + Convert.ToString(i));
        }
    }

    static void Main() {
        string path = "_scratch/zandb_rescore_tmp.zdb";
        Directory.CreateDirectory("_scratch");
        Clean(path);

        float[] query = new float[8];
        query[0] = 0.5f;
        query[1] = -0.25f;
        query[2] = 0.75f;
        query[3] = 0.125f;
        query[4] = -0.5f;
        query[5] = 0.375f;
        query[6] = -0.125f;
        query[7] = 0.625f;

        ZanDatabase db = ZanDatabase.Open(path, ZanStore.DUR_SYNC);
        Ok(db.IsOpen(), "open");
        Collection docs = db.GetCollection("docs");

        List<int> ids = new List<int>();
        List<float[]> vectors = new List<float[]>();
        for (int i = 0; i < 60; i = i + 1) {
            float[] vector = new float[8];
            for (int j = 0; j < 8; j = j + 1) { vector[j] = Next(); }
            vector[0] = vector[0] + 0.25f;
            ids.Add(docs.Insert(Doc(i, vector)));
            vectors.Add(vector);
        }
        VectorIndexOptions options = new VectorIndexOptions(8);
        options.quantize = true;
        docs.EnsureVectorIndex("embedding", options);

        List<int> truth = Truth(ids, vectors, query, 5);

        // 1) 纯量化近似（基线）与重打分对比。
        List<VectorHit> approx = docs.SearchVector("embedding", query, 5, 64);
        List<VectorHit> rescored = docs.SearchVectorRescore("embedding", query, 5, 64);
        int approxOverlap = Overlap(approx, truth);
        int rescoreOverlap = Overlap(rescored, truth);
        Ok(approx.Count == 5 && rescored.Count == 5, "both searches return 5");
        Ok(rescoreOverlap == 5, "rescore top5 matches exact truth: " + Convert.ToString(rescoreOverlap) + "/5");
        Ok(rescoreOverlap >= approxOverlap, "rescore recall >= approx: " + Convert.ToString(rescoreOverlap) + " vs " + Convert.ToString(approxOverlap));
        // 重打分距离 = 精确余弦（与真值第 1 名距离同式同值）。
        double nq = 0;
        for (int j = 0; j < 8; j = j + 1) { nq = nq + query[j] * query[j]; }
        nq = Math.Sqrt(nq);
        double dotTop = 0;
        double nvTop = 0;
        // 文档 id 从 1 起，行索引差一位。
        int topRow = truth[0] - 1;
        for (int j = 0; j < 8; j = j + 1) {
            dotTop = dotTop + query[j] * vectors[topRow][j];
            nvTop = nvTop + vectors[topRow][j] * vectors[topRow][j];
        }
        double wantDist = 1.0 - dotTop / (nq * Math.Sqrt(nvTop));
        double gotDist = -1;
        for (int i = 0; i < rescored.Count; i = i + 1) {
            if (rescored[i].id == truth[0]) { gotDist = rescored[i].distance; }
        }
        Ok(gotDist >= 0 && gotDist < wantDist + 0.000001 && gotDist > wantDist - 0.000001,
        "rescore distance equals exact cosine");

        // 2) 过滤穿透：filter 拒绝的组不出现在结果里。
        Dictionary<int, bool> allow = new Dictionary<int, bool>();
        for (int i = 0; i < ids.Count; i = i + 1) {
            if (ids[i] % 2 == 0) { allow.Add(ids[i], true); }
        }
        List<VectorHit> filtered = docs.SearchVectorRescoreFiltered("embedding", query, 5, 64,
        (int id) => {
            bool v;
            return allow.TryGetValue(id, out v);
        });
        bool allEven = filtered.Count == 5;
        for (int i = 0; i < filtered.Count && allEven; i = i + 1) {
            if (filtered[i].id % 2 != 0) { allEven = false; }
        }
        Ok(allEven, "filter passes through to rescore results");

        // 3) 重开往返后 rescore 一致（量化候选 + 文档行精排）。
        db.Checkpoint();
        docs.CheckpointSearchIndexes();
        db.Close();
        db = ZanDatabase.Open(path, ZanStore.DUR_SYNC);
        docs = db.GetCollection("docs");
        List<VectorHit> after = docs.SearchVectorRescore("embedding", query, 5, 64);
        bool same = after.Count == 5;
        for (int i = 0; i < 5 && same; i = i + 1) {
            if (after[i].id != rescored[i].id) { same = false; }
        }
        Ok(same, "rescore stable across checkpoint reopen");

        // 4) 墓碑：删除真值 top1 后 rescore 不再返回它。
        int removed = rescored[0].id;
        Ok(docs.DeleteById(removed), "delete rescore top hit");
        List<VectorHit> minus = docs.SearchVectorRescore("embedding", query, 5, 64);
        bool gone = minus.Count == 5;
        for (int i = 0; i < minus.Count && gone; i = i + 1) {
            if (minus[i].id == removed) { gone = false; }
        }
        Ok(gone, "tombstone excluded from rescore");

        // 5) 非量化索引 rescore 转发普通搜索（图距离精确）。
        VectorIndexOptions plain = new VectorIndexOptions(8);
        docs.EnsureVectorIndex("embedding", plain);
        List<VectorHit> plainTop = docs.SearchVectorRescore("embedding", query, 5, 64);
        Ok(plainTop.Count == 5, "non-quantize rescore forwards plain search");
        List<int> plainTruth = Truth(ids, vectors, query, 5);
        plainTruth.Remove(removed);
        Ok(Overlap(plainTop, plainTruth) == 4, "non-quantize rescore matches exact graph truth");

        db.Close();
        Clean(path);
        Console.WriteLine("done " + Convert.ToString(checks));
    }
}
