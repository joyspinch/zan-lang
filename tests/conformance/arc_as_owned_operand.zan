using System;

class AsOwnedBase { }
class AsOwnedNode : AsOwnedBase { public int Value = 42; }
class AsOwnedOther : AsOwnedBase { }
class AsOwnedLink { public weak AsOwnedBase Parent; }
class AsOwnedWatch { public weak AsOwnedBase Node; }

class AsOwnedOperandTest {
    static void Check(bool ok, string label) {
        if (!ok) { throw new Exception(label); }
    }

    static AsOwnedBase Make(AsOwnedWatch watch, bool match) {
        AsOwnedBase value = match ? new AsOwnedNode() : new AsOwnedOther();
        watch.Node = value;
        return value;
    }

    static void ReadWeak(AsOwnedLink link, bool match) {
        AsOwnedNode value = link.Parent as AsOwnedNode;
        Check((value != null) == match, "weak cast result");
        if (value != null) { Check(value.Value == 42, "successful cast remains alive"); }
    }

    static void WeakScope(AsOwnedWatch watch, bool match) {
        AsOwnedBase value = Make(watch, match);
        AsOwnedLink link = new AsOwnedLink();
        link.Parent = value;
        ReadWeak(link, match);
    }

    static void TemporaryScope(AsOwnedWatch watch) {
        AsOwnedNode match = Make(watch, true) as AsOwnedNode;
        Check(match != null && match.Value == 42, "owned call success transfers reference");
    }

    static void BorrowedScope(AsOwnedWatch watch) {
        AsOwnedBase value = Make(watch, true);
        AsOwnedNode cast = value as AsOwnedNode;
        value = null;
        Check(cast != null && cast.Value == 42, "borrowed cast retains local result");
    }

    static void Main() {
        AsOwnedWatch watch = new AsOwnedWatch();
        WeakScope(watch, true);
        Check(watch.Node == null, "weak success releases promotion");
        WeakScope(watch, false);
        Check(watch.Node == null, "weak failure releases promotion");
        TemporaryScope(watch);
        Check(watch.Node == null, "owned success releases result");
        AsOwnedNode missing = Make(watch, false) as AsOwnedNode;
        Check(missing == null && watch.Node == null, "owned failure releases discarded source");
        BorrowedScope(watch);
        Check(watch.Node == null, "borrowed success releases result");
        Console.WriteLine("ARC_AS_OWNED_OPERAND_OK");
    }
}
