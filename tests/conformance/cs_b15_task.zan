// B15: Task / Task<T> — the `Task` type name (a coroutine handle) plus the
// C#-style surface on top of the existing spawn machinery:
//   Task t = Task.Run(delegate () { ... }); t.Wait();
//   Task<int> t = Task.Run(Compute()); int r = t.Result;
//   t.IsCompleted, Task.Run(<lambda>) / Task.Run(<Action variable>).
// A Task.Run delegate body runs to completion before Run returns (the
// cooperative model: any awaits inside it pump the driver via the root-await
// path), so Wait()/IsCompleted return immediately for it. A Task<T> spawn of
// an async call leaves the frame alive until Result/Wait reads (and reaps)
// it, and Wait() pumps the driver so concurrently spawned coroutines make
// progress too.
using System;

class Program {
    static void Main() {
        // 1. anonymous delegate body + Wait
        Task t = Task.Run(delegate () { Console.WriteLine("run"); });
        t.Wait();

        // 2. arrow lambda
        Task t1 = Task.Run(() => { Console.WriteLine("arrow"); });
        t1.Wait();

        // 3. a named Action variable
        Action a = delegate () { Console.WriteLine("action var"); };
        Task t2 = Task.Run(a);
        t2.Wait();

        // 4. IsCompleted on the already-completed inline task
        Task t3 = Task.Run(delegate () { Console.WriteLine("t3"); });
        Console.WriteLine("t3 done=" + t3.IsCompleted);

        // 5. Task<T> result reading; the Result pump also lets a previously
        // spawned coroutine finish
        Task.Spawn(PrintLater("spawned"));
        Task<int> x = Task.Run(Cube(3));
        Task<int> y = Task.Run(Cube(4));
        int sum = x.Result + y.Result;
        Console.WriteLine("sum=" + sum);

        // 6. Wait on a plain spawned void task (reaper frees its frame)
        Task tv = Task.Run(VoidWork());
        tv.Wait();

        Console.WriteLine("task-ok: 1");
    }

    static async int Cube(int n) {
        await Task.Delay(10);
        return n * n * n;
    }

    static async void VoidWork() {
        await Task.Delay(5);
        Console.WriteLine("void work");
    }

    static async void PrintLater(string s) {
        await Task.Delay(20);
        Console.WriteLine(s);
    }
}
