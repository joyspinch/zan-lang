// 核心契约与执行状态转移规范。
using System;

class Program {
    static void Main() {
        Task t = Task.Run(delegate () { Console.WriteLine("run"); });
        t.Wait();

        // 核心契约与执行状态转移规范。
        Task t1 = Task.Run(() => { Console.WriteLine("arrow"); });
        t1.Wait();

        // 核心契约与执行状态转移规范。
        Action a = delegate () { Console.WriteLine("action var"); };
        Task t2 = Task.Run(a);
        t2.Wait();

        Task t3 = Task.Run(delegate () { Console.WriteLine("t3"); });
        t3.Wait();
        Console.WriteLine("t3 done=" + t3.IsCompleted);

        // 核心契约与执行状态转移规范。
        Task.Spawn(PrintLater("spawned"));
        Task<int> x = Task.Run(Cube(3));
        Task<int> y = Task.Run(Cube(4));
        int sum = x.Result + y.Result;
        Console.WriteLine("sum=" + sum);

        Task tv = Task.Run(VoidWork());
        tv.Wait();

        Console.WriteLine("task-ok: 1");
    }

    static async int Cube(int n) {
        await Task.Delay(10);
        return n * n * n;
    }

    static async void VoidWork() {
        await Task.Delay(5);
        Console.WriteLine("void work");
    }

    static async void PrintLater(string s) {
        await Task.Delay(20);
        Console.WriteLine(s);
    }
}
