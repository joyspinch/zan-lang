// C# syntax: static members are reachable through a constructed generic type
// (`Box<int>.Create(7)`), and naming the instantiation routes the call to that
// instantiation's specialization rather than the erased body.
using System;

class Box<T> {
    T v;
    Box(T x) { this.v = x; }
    T Get() { return this.v; }
    static Box<T> Create(T x) { return new Box<T>(x); }
    static string Tag() { return "box"; }
}

class Pair<K, V> {
    K k; V v;
    Pair(K a, V b) { this.k = a; this.v = b; }
    K Key() { return this.k; }
    V Val() { return this.v; }
    static Pair<K, V> Of(K a, V b) { return new Pair<K, V>(a, b); }
}

class Counter<T> {
    static int Twice(int n) { return n + n; }
}

class Program {
    static void Main() {
        Box<int> b = Box<int>.Create(7);
        Console.WriteLine(b.Get());

        Box<string> bs = Box<string>.Create("hi");
        Console.WriteLine(bs.Get());

        Console.WriteLine(Box<string>.Tag());

        Pair<int, string> p = Pair<int, string>.Of(3, "three");
        Console.WriteLine(p.Key() + ":" + p.Val());

        // a static member that does not mention T still resolves through the
        // constructed type
        Console.WriteLine(Counter<double>.Twice(21));

        // the same class reached without type arguments keeps working
        Box<int> b2 = Box.Create(8);
        Console.WriteLine(b2.Get());

        // `<` in expressions is still a comparison: none of these are type
        // argument lists
        int lo = 1;
        int hi = 5;
        List<int> xs = new List<int>();
        xs.Add(9);
        Console.WriteLine(lo < hi);
        Console.WriteLine(lo < xs.Count);
        Console.WriteLine(lo < hi == true);
    }
}
