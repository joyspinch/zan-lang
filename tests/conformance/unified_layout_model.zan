using System;
using Gui;
using Gui.Widget;
using Game.Scene;

namespace T;

class Program {
    static void Assert(string name, bool condition) {
        if (!condition) {
            Console.WriteLine("FAIL: " + name);
            Environment.Exit(1);
        }
        Console.WriteLine("PASS: " + name);
    }

    static void Main() {
        Console.WriteLine("=== Testing Unified Flex + Float Layout & Strongly-typed Enums ===");

        // 1. 测试 Game.Scene 强类型枚举与实体
        SceneDoc doc = new SceneDoc("test_scene", 1920, 1080);
        doc.SetMode(ScaleMode.Fit());

        // 浮动元素
        SceneElement hudFloat = new SceneElement("button", "btn_hud")
            .At(10, 10)
            .Size(120, 40)
            .AnchorTo(Anchor.Min(), Anchor.Min())
            .SetPosition(1) // Float
            .SetCssClass("game-btn hud gold-border");

        // 绑定强类型动作
        hudFloat.On("onClick", "ShowLayer:bag;PlaySound:click");
        doc.Add(hudFloat);

        Assert("SceneElement.CssClass", hudFloat.CssClass() == "game-btn hud gold-border");
        Assert("SceneElement.Position", hudFloat.Position() == 1);
        Assert("SceneElement.OnAction", hudFloat.OnAction("onClick") == "ShowLayer:bag;PlaySound:click");

        // 2. 测试序列化与反序列化保留强类型属性
        string json = doc.ToJson();
        Assert("ToJson contains class", json.IndexOf("\"class\": \"game-btn hud gold-border\"") >= 0);
        Assert("ToJson contains position", json.IndexOf("\"position\": 1") < 0); // 1 是默认值，省略或写出

        SceneDoc doc2 = SceneDoc.Parse(json);
        SceneElement parsedElem = doc2.Find("btn_hud");
        Assert("Parsed element found", parsedElem != null);
        Assert("Parsed cssClass preserved", parsedElem.CssClass() == "game-btn hud gold-border");
        Assert("Parsed position preserved", parsedElem.Position() == 1);
        Assert("Parsed action preserved", parsedElem.OnAction("onClick") == "ShowLayer:bag;PlaySound:click");

        // 3. 测试 FormField 统一强类型定位属性 (Flow vs Float)
        FormField fieldFlow = new FormField(0);
        fieldFlow.position = (int)FieldPositionMode.Flow;
        fieldFlow.flexGrow = 1;

        FormField fieldFloat = new FormField(0);
        fieldFloat.position = (int)FieldPositionMode.Float;
        fieldFloat.anchor = (int)FieldAnchorMode.TopRight;
        fieldFloat.PlaceAt(0 - 150, 20);
        fieldFloat.FreeSize(120, 36);

        Assert("FormField.Flow position", fieldFlow.position == 0);
        Assert("FormField.Flow flexGrow", fieldFlow.flexGrow == 1);
        Assert("FormField.Float position", fieldFloat.position == 1);
        Assert("FormField.Float anchor", fieldFloat.anchor == 3);

        Console.WriteLine("ALL UNIFIED LAYOUT & TYPED MODEL CHECKS PASSED!");
    }
}
