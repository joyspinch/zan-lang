// B-ID186 Wave 12: interface dispatch on null receiver (including alongside
// boxed-struct implementors) matches C host soft-guard zero return outside try
// and throws NullReferenceException inside try; checked(-uint) / checked(-ulong)
// do not spuriously overflow while checked(-int.MinValue) / checked(-long.MinValue)
// still throw OverflowException.
using System;

interface IWave12 {
    int Eval();
    string Tag();
    void Touch();
}

struct Wave12Struct : IWave12 {
    public int v;
    public Wave12Struct(int x) { v = x; }
    public int Eval() { return v + 10; }
    public string Tag() { return "S"; }
    public void Touch() {}
}

class Wave12ClassA : IWave12 {
    public int Eval() { return 2; }
    public string Tag() { return "A"; }
    public void Touch() {}
}

class Wave12ClassB : IWave12 {
    public int Eval() { return 3; }
    public string Tag() { return "B"; }
    public void Touch() {}
}

class Program {
    static void Main() {
        IWave12 s = new Wave12Struct(5);
        IWave12 a = new Wave12ClassA();
        IWave12 b = new Wave12ClassB();
        Console.WriteLine("live=" + (s.Eval() + a.Eval() + b.Eval()) + "|" + s.Tag() + a.Tag() + b.Tag());

        IWave12 n = null;
        try {
            Console.WriteLine(n.Eval());
        } catch (NullReferenceException e) {
            Console.WriteLine("try-null=caught");
        }

        int ev = n.Eval();
        string tg = n.Tag();
        n.Touch();
        Console.WriteLine("soft-null=" + ev + "|" + (tg == null ? "null" : tg));

        uint u = 2147483648;
        int ru = checked(-u);
        ulong ul = 9223372036854775808UL;
        long rul = checked(-ul);
        Console.WriteLine("checked-neg-unsigned=" + ru + "|" + rul);

        int im = int.MinValue;
        try {
            int ri = checked(-im);
            Console.WriteLine("checked-neg-int=" + ri);
        } catch (OverflowException e) {
            Console.WriteLine("checked-neg-int=OVF");
        }

        long lm = long.MinValue;
        try {
            long rl = checked(-lm);
            Console.WriteLine("checked-neg-long=" + rl);
        } catch (OverflowException e) {
            Console.WriteLine("checked-neg-long=OVF");
        }
    }
}
