using System;

/* 底层系统交互与数据协议契约 */
class User {
    public string Name;
    public int Age;
    public User(string name, int age) { this.Name = name; this.Age = age; }
}

class Box {
    /* 核心系统底层抽象与内存语义契约 */
    public async string GetAsync(string key) {
        await Task.Delay(1);
        return "plain";
    }

    public async T GetAsync<T>(string key) {
        return new User("Bob", 25);
    }

    /* 核心系统底层抽象与内存语义契约 */
    public T Pick<T>(T v) {
        return v;
    }

    public string Pick(string v) {
        return "plain-pick";
    }
}

class Program {
    static async int Run() {
        Box b = new Box();

        /* 底层系统交互与数据协议契约 */
        User u = await b.GetAsync<User>("k");
        Console.WriteLine("a: " + u.Name + " " + Convert.ToString(u.Age));

        /* 底层系统交互与数据协议契约 */
        string s = await b.GetAsync("k");
        Console.WriteLine("b: " + s);

        /* sync, generic-first */
        User u2 = b.Pick<User>(u);
        Console.WriteLine("c: " + u2.Name);

        /* 底层系统交互与数据协议契约 */
        Console.WriteLine("d: " + b.Pick("x"));

        return 0;
    }

    static void Main() {
        int r = await Run();
    }
}
