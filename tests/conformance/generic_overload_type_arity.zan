using System;

/* Generic-method arity is part of overload identity (C# CS0111 exempts
 * `M<T>(string)` from `M(string)`): a call with explicit type arguments must
 * bind to the generic overload no matter which sibling is declared first.
 * The checker already filtered candidates by type-param count, but irgen
 * scored both same-arity candidates on argument types alone and kept the
 * declaration-order winner -- so with the plain overload first, the call was
 * emitted against the string signature while the static type said `T`, and
 * the result was null/garbage at runtime (FreeRedis-style
 * `cli.GetAsync<User>(key)` next to `cli.GetAsync(key)`). */
class User {
    public string Name;
    public int Age;
    public User(string name, int age) { this.Name = name; this.Age = age; }
}

class Box {
    /* plain overload declared FIRST */
    public async string GetAsync(string key) {
        await Task.Delay(1);
        return "plain";
    }

    public async T GetAsync<T>(string key) {
        return new User("Bob", 25);
    }

    /* generic overload declared FIRST */
    public T Pick<T>(T v) {
        return v;
    }

    public string Pick(string v) {
        return "plain-pick";
    }
}

class Program {
    static async int Run() {
        Box b = new Box();

        /* async, plain-first: the shape that miscompiled */
        User u = await b.GetAsync<User>("k");
        Console.WriteLine("a: " + u.Name + " " + Convert.ToString(u.Age));

        /* the plain overload stays reachable without type arguments */
        string s = await b.GetAsync("k");
        Console.WriteLine("b: " + s);

        /* sync, generic-first */
        User u2 = b.Pick<User>(u);
        Console.WriteLine("c: " + u2.Name);

        /* sync, plain call still lands on the string overload */
        Console.WriteLine("d: " + b.Pick("x"));

        return 0;
    }

    static void Main() {
        int r = await Run();
    }
}
