// cs_b07_ext_method.zan -- C#-compat: extension methods.
// A method whose first parameter is `this T v` is callable as `recv.Method(...)`
// on any expression of type T (identifier receivers, string literals, and
// parenthesized numeric literals -- bare `5.Method()` reads `5.` as a float,
// the same ambiguity C# has).
using System;

static class Ext {
    public static int Twice(this int v) { return v * 2; }
    public static string Shout(this string s) { return s + "!"; }
}

class Program {
    static void Main() {
        int n = 5;
        Console.WriteLine(n.Twice());
        string s = "hi";
        Console.WriteLine(s.Shout());
        Console.WriteLine("hey".Shout());
        Console.WriteLine((3).Twice());
    }
}
