using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;

class TestUser {
    public string name;
    public int age;
    public double salary;
    public bool active;

    public TestUser(string n, int a, double s, bool act) {
        this.name = n;
        this.age = a;
        this.salary = s;
        this.active = act;
    }
}

class CustomUserSource : DataSource {
    List<TestUser> list;

    public CustomUserSource(List<TestUser> l) {
        this.list = l;
    }

    public override int RowCount() {
        return this.list.Count;
    }

    public override string CellText(int row, int col) {
        if (row < 0 || row >= this.list.Count) { return ""; }
        TestUser u = this.list[row];
        if (col == 0) { return u.name; }
        if (col == 1) { return Convert.ToString(u.age); }
        if (col == 2) { return DataTable.FormatReal(u.salary, 2); }
        if (col == 3) { return u.active ? "true" : "false"; }
        return "";
    }

    public override int CellNum(int row, int col) {
        if (row < 0 || row >= this.list.Count) { return 0; }
        if (col == 1) { return this.list[row].age; }
        return 0;
    }

    public override RowKey GetRowKey(int row) {
        if (row < 0 || row >= this.list.Count) { return null; }
        return RowKey.Of(this.list[row].name);
    }
}

class Program {
    static void Main() {
        Console.WriteLine("[1] DataRow testing");
        DataRow r = new DataRow();
        r.Push("val0");
        r.Push("val1");
        Console.WriteLine("DataRow Count=" + Convert.ToString(r.Count()) + ", At(0)=" + r.At(0) + ", At(1)=" + r.At(1));
        DataRow r2 = r.Copy();
        r2.Set(1, "val1_mod");
        Console.WriteLine("DataRow Copy At(1)=" + r2.At(1) + ", Original At(1)=" + r.At(1));

        Console.WriteLine("[2] DataColumn testing");
        DataColumn colText = DataColumn.Text("Name", 120);
        DataColumn.Field(colText, "f_name");
        Console.WriteLine("colText title=" + colText.title + ", width=" + Convert.ToString(colText.width) + ", field=" + colText.FieldName());

        DataColumn colNum = DataColumn.Numeric("Age", 80);
        Console.WriteLine("colNum title=" + colNum.title + ", numeric=" + (colNum.numeric ? "true" : "false") + ", align=" + Convert.ToString(colNum.align));

        DataColumn colMoney = DataColumn.Money(DataColumn.Numeric("Salary", 100), "$");
        Console.WriteLine("colMoney prefix=" + colMoney.prefix + ", decimals=" + Convert.ToString(colMoney.decimals));

        Console.WriteLine("[3] RowKey testing");
        RowKey k1 = RowKey.Of("emp_42");
        RowKey k2 = RowKey.Of("emp_42");
        RowKey k3 = RowKey.Legacy(10);
        Console.WriteLine("k1 Canonical=" + k1.Canonical() + ", temp=" + (k1.IsTemporary() ? "true" : "false"));
        Console.WriteLine("k1 Same k2=" + (k1.Same(k2) ? "true" : "false"));
        Console.WriteLine("k3 Canonical=" + k3.Canonical() + ", temp=" + (k3.IsTemporary() ? "true" : "false"));

        Console.WriteLine("[4] DataSource testing");
        List<TestUser> users = new List<TestUser>();
        users.Add(new TestUser("Alice", 28, 9500.50, true));
        users.Add(new TestUser("Bob", 35, 12000.00, false));

        CustomUserSource src = new CustomUserSource(users);
        Console.WriteLine("src RowCount=" + Convert.ToString(src.RowCount()));
        Console.WriteLine("src CellText(0,0)=" + src.CellText(0, 0) + ", CellNum(0,1)=" + Convert.ToString(src.CellNum(0, 1)));
        Console.WriteLine("src CellText(1,0)=" + src.CellText(1, 0) + ", CellText(1,2)=" + src.CellText(1, 2));
        RowKey rk = src.GetRowKey(0);
        if (rk != null) {
            Console.WriteLine("src GetRowKey(0)=" + rk.Canonical());
        }

        Console.WriteLine("[5] DataGrid testing");
        DataGrid<TestUser> grid = new DataGrid<TestUser>();
        grid.Col("Name", 120, u => u.name);
        grid.NumCol("Age", 80, u => u.age);
        grid.RealCol("Salary", 100, 2, u => u.salary);
        grid.BoolCol("Active", 60, u => u.active);
        grid.RowNumbers(true);
        grid.Striped(true);
        grid.Selectable(false);
        grid.Bind(users);

        Console.WriteLine("grid Count=" + Convert.ToString(grid.Count()));
        Console.WriteLine("grid State non-null=" + (grid.State() != null ? "true" : "false"));

        Console.WriteLine("[6] DeltaBatch testing");
        DeltaBatch batch = DeltaBatch.Create();
        List<string> rowVals = new List<string>();
        rowVals.Add("Charlie");
        rowVals.Add("40");
        batch.Add(DeltaOp.UpsertRow("emp_43", rowVals, 1));
        batch.Add(DeltaOp.SetCell("emp_42", "Salary", "9800.00", 2));
        Console.WriteLine("batch Count=" + Convert.ToString(batch.Count()));

        string json = batch.ToJson();
        DeltaBatch parsed = DeltaBatch.FromJson(json);
        if (parsed != null) {
            Console.WriteLine("parsed Count=" + Convert.ToString(parsed.Count()));
            DeltaOp op0 = parsed.At(0);
            if (op0 != null) {
                Console.WriteLine("parsed op0 Key=" + op0.Key() + ", kind=" + Convert.ToString(op0.Kind()));
            }
            DeltaOp op1 = parsed.At(1);
            if (op1 != null) {
                Console.WriteLine("parsed op1 Key=" + op1.Key() + ", field=" + op1.Field() + ", val=" + op1.Value());
            }
        }

        Console.WriteLine("OK: all datatable hardening checks passed!");
    }
}
