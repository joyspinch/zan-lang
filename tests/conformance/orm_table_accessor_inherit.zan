using System;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.IO;

/* 连接口声明在基类（控制器基类 AppController 的同构形态）：
   派生类上的 this.<Entity> 必须沿基类链找到 __Conn() 才能合成访问器。
   只扫自身成员时，派生类会被迫为每个实体重复声明一份连接口。 */

[Table(Name = "acc_inh_item")]
class InhItem {
    [Column(IsIdentity = true)]
    int id;
    [Column(StringLength = 64)]
    string name;
    int qty;
}

class StoreBase {
    IDbConnection conn;

    StoreBase(IDbConnection c) { this.conn = c; }

    IDbConnection __Conn() { return this.conn; }
}

class Store : StoreBase {
    Store(IDbConnection c) : base(c) { }

    int Add(string name, int qty) {
        InhItem it = new InhItem();
        it.name = name;
        it.qty = qty;
        return this.InhItem.InsertIdentity(it);
    }

    async int Total() { return await this.InhItem.CountAsync(); }

    async List<InhItem> All() {
        return await this.InhItem.OrderBy(a => a.id).ToListAsync();
    }

    async InhItem Find(string name) {
        return await this.InhItem.Where(a => a.name == name).FirstAsync();
    }
}

class Program {
    static void Main() {
        string path = "orm_table_accessor_inherit.tmp.db";
        File.Delete(path);
        SqliteConnection db = SqliteConnection.Open(path);
        db.SyncStructure<InhItem>();

        Store s = new Store(db);
        s.Add("potion", 3);
        s.Add("scroll", 5);
        Console.WriteLine("total: " + Convert.ToString(await s.Total()));

        List<InhItem> all = await s.All();
        Console.WriteLine("first: " + all[0].name + " qty="
            + Convert.ToString(all[0].qty));

        Console.WriteLine("restock: " + Convert.ToString(
            (await s.Find("scroll")).qty));

        db.Close();
        File.Delete(path);
    }
}
