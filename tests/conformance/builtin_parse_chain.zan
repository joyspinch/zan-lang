using System;

class Program {
    static void Main() {
        string s1 = int.Parse("123").ToString();
        string s2 = double.Parse("2.5").ToString();
        string s3 = long.Parse("77").ToString();
        Console.WriteLine("s1=" + s1);
        Console.WriteLine("s2=" + s2);
        Console.WriteLine("s3=" + s3);
    }
}
