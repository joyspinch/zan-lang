using System;
using System.Collections.Generic;

// new List<T>(array) 数组拷贝构造。
//
// 缺陷：单实参且实参是数组时，既不走 List 拷贝构造（list_copy 只认
// List<T> 源），也不报错，而是掉进集合初始化式路径——整个数组对象
// 被当成 1 个元素 Add 进去。症状：Count=1、读元素得到假扮字符串的
// 数组头（len=垃圾、data=指针字节）、下标 1 直接越界，全程静默。
// 实测踩过：Process 参数列表经此构造后全是垃圾，Firefox 静默安装器
// 收不到 /S 进了交互模式干等——"装了却不落盘"的最终根因。
//
// 语义口径：new List<T>(array) 逐元素拷贝（C# 惯用法），元素含
// 引用/整型/结构体；空数组得空表；拷贝是快照，与源数组互不影响。

struct V3 { public int x; public int y; public int z; }

public class Program {
    public static void Main() {
        string[] ss = new string[] { "aa", "bbb", "c" };
        List<string> ls = new List<string>(ss);
        if (ls.Count != 3 || ls[0] != "aa" || ls[1] != "bbb"
                || ls[2] != "c") {
            Console.WriteLine("LIST ARRAY CTOR FAIL string");
            return;
        }

        int[] ii = new int[] { 3, 1, 4, 1, 5 };
        List<int> li = new List<int>(ii);
        if (li.Count != 5 || li[0] != 3 || li[2] != 4 || li[4] != 5) {
            Console.WriteLine("LIST ARRAY CTOR FAIL int");
            return;
        }

        string[] es = new string[] { };
        List<string> le = new List<string>(es);
        if (le.Count != 0) {
            Console.WriteLine("LIST ARRAY CTOR FAIL empty");
            return;
        }

        // 拷贝后互不影响（值语义快照）
        ss[0] = "changed";
        if (ls[0] != "aa") {
            Console.WriteLine("LIST ARRAY CTOR FAIL snapshot");
            return;
        }

        // 结构体元素逐槽拷贝（数组紧凑布局 → List 字槽）
        V3[] vs = new V3[] { new V3(), new V3() };
        vs[0].x = 7;
        vs[0].y = 8;
        vs[1].z = 9;
        List<V3> lv = new List<V3>(vs);
        if (lv.Count != 2 || lv[0].x != 7 || lv[0].y != 8
                || lv[1].z != 9) {
            Console.WriteLine("LIST ARRAY CTOR FAIL struct");
            return;
        }

        Console.WriteLine("LIST ARRAY CTOR OK");
    }
}
