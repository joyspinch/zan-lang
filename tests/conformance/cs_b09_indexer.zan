// A43-B9: C#-style indexers `this[int i] { get; set; }` lower to the
// op_index / op_index_set protocol as instance methods. Covers block get/set,
// expression-bodied getter (read-only indexer), and compound use.
class Bag {
    private List<int> data = new List<int>();
    public Bag() { for (int k = 0; k < 4; k++) data.Add(k * 10); }
    public int this[int i] {
        get { return data[i]; }
        set { data[i] = value; }
    }
}

class ReadOnly {
    private int v = 42;
    public int this[int i] => v + i;
}

class Program {
    static void Main() {
        Bag b = new Bag();
        Console.WriteLine(b[0]);
        Console.WriteLine(b[3]);
        b[1] = 99;
        Console.WriteLine(b[1]);
        b[2] += 5;                  // compound through setter
        Console.WriteLine(b[2]);
        ReadOnly r = new ReadOnly();
        Console.WriteLine(r[0]);
        Console.WriteLine(r[3]);
    }
}
