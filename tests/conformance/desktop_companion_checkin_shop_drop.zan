using System;
using System.Windows;

namespace Conf;

class DesktopCompanionCheckInShopDropTest {
    static void Main() {
        // 1. 每日连签日历：递增奖励 + 同日防重 + 断签保护卡保连签 + 真正断签归 1
        CompanionDailyCheckInCalendar cal = new CompanionDailyCheckInCalendar(20, 5, 50);
        cal.StreakFreezeTokens = 1;
        int c1; bool f1;
        bool ok1 = cal.CheckIn(10, out c1, out f1);        // 第 1 天 -> streak=1, coins=20
        int cDup; bool fDup;
        bool dupBlocked = !cal.CheckIn(10, out cDup, out fDup);
        int c2; bool f2;
        bool ok2 = cal.CheckIn(11, out c2, out f2);        // 第 2 天 -> streak=2, coins=25
        int c3; bool f3;
        bool ok3 = cal.CheckIn(13, out c3, out f3);        // 漏签第 12 天，自动消耗 1 张保护卡 -> streak=3, coins=30
        int c4; bool f4;
        bool ok4 = cal.CheckIn(16, out c4, out f4);        // 漏签 2 天且无卡 -> streak 重置 1, coins=20

        bool calOk = ok1 && c1 == 20 && !f1 && dupBlocked
            && ok2 && c2 == 25 && !f2
            && ok3 && c3 == 30 && f3 && cal.StreakFreezeTokens == 0
            && ok4 && c4 == 20 && !f4
            && cal.LongestStreak == 3 && cal.TotalCheckIns == 4;
        Console.WriteLine("companion-daily-checkin-freeze: " + Convert.ToString(calOk ? 1 : 0));

        // 2. 桌宠商店：折扣价、好感度门槛、永久外观防重购、限量库存耗尽
        CompanionPetShopCatalog shop = new CompanionPetShopCatalog();
        shop.AddItem("hat_crown", 200, 5, 2, true, 25);   // 75折=150, 需好感>=5, 永久外观
        shop.AddItem("snack_fish", 30, 0, 2, false, 0);   // 限量 2 份消耗品

        int coins = 300;
        int paid;
        bool affBlocked = !shop.Purchase("hat_crown", 3, ref coins, out paid); // 好感不足
        bool hatOk = shop.Purchase("hat_crown", 6, ref coins, out paid);       // 扣 150 -> 剩 150
        int paidDup;
        bool cosDupBlocked = !shop.Purchase("hat_crown", 6, ref coins, out paidDup); // 永久外观禁重买
        int pSnack1; int pSnack2; int pSnack3;
        bool s1 = shop.Purchase("snack_fish", 1, ref coins, out pSnack1);      // 扣 30 -> 120 (库存 1)
        bool s2 = shop.Purchase("snack_fish", 1, ref coins, out pSnack2);      // 扣 30 -> 90  (库存 0)
        bool stockOut = !shop.Purchase("snack_fish", 1, ref coins, out pSnack3);

        bool shopOk = affBlocked && hatOk && paid == 150 && cosDupBlocked
            && s1 && s2 && stockOut && coins == 90
            && shop.GetOwnedCount("hat_crown") == 1 && shop.GetOwnedCount("snack_fish") == 2;
        Console.WriteLine("companion-pet-shop-catalog: " + Convert.ToString(shopOk ? 1 : 0));

        // 3. 文件拖放路由器：大小写扩展名匹配、高优先级覆盖、超大文件拦截与未知类型拒收
        CompanionFileDropRouter router = new CompanionFileDropRouter();
        router.AddRule("img_gen", "PreviewImage", ".png,.jpg", 5000000L, 10);
        router.AddRule("img_hq", "CompressPng", ".png", 2000000L, 20); // 高优先级 .png 规则
        router.AddRule("doc_sum", "SummarizeNote", ".md,.txt", 1000000L, 10);

        string act1; string rej1;
        bool r1 = router.RouteFile("C:/Users/me/Banner.PNG", 500000L, out act1, out rej1); // 命中高优 CompressPng
        string act2; string rej2;
        bool r2 = router.RouteFile("C:/Users/me/Big.PNG", 3000000L, out act2, out rej2);   // 超过 2MB 降级命中 5MB PreviewImage
        string act3; string rej3;
        bool r3 = !router.RouteFile("notes.TXT", 5000000L, out act3, out rej3);            // 超大拒收 FILE_TOO_LARGE
        string act4; string rej4;
        bool r4 = !router.RouteFile("archive.zip", 1024L, out act4, out rej4);             // 未知类型 UNSUPPORTED_TYPE

        bool dropOk = r1 && act1 == "CompressPng"
            && r2 && act2 == "PreviewImage"
            && r3 && rej3 == "FILE_TOO_LARGE"
            && r4 && rej4 == "UNSUPPORTED_TYPE"
            && router.RoutedCount == 2 && router.RejectedCount == 2;
        Console.WriteLine("companion-file-drop-router: " + Convert.ToString(dropOk ? 1 : 0));
    }
}
