using System;
using System.Text;

namespace Conf;

class Prog {
    static void Main() {
        // 限定名按命名空间解析：类住在 System.Text，就得用 System.Text 去限定。
        // 编译器以前会按路径最后一段去猜（"System.Text" 找不到就抓 using 引进的
        // 同名类），限定名写错时静默绑到别的类上，返回类型对不上 → 运行期踩内存。
        int qualified = System.Text.Encoding.GetByteCount("hi");
        int imported = Encoding.GetByteCount("hi");
        if (qualified != 2 || imported != 2) {
            Console.WriteLine("qualified-FAIL");
            return;
        }
        Console.WriteLine("qualified-ok: 2");
    }
}
