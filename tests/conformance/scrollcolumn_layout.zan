// ScrollColumn keeps its zero-padding geometry and applies explicit padding
// to child position, width, visibility, and total scrollable height.
using System;
using Gui;
using Gui.Widget;

class Program {
    static void Main() {
        ScrollColumn col = new ScrollColumn();
        col.Gap(6);
        Label first = new Label();
        first.Prefer(100, 20);
        first.Dock(1);
        Label second = new Label();
        second.Prefer(100, 20);
        second.Dock(1);
        col.Add(first);
        col.Add(second);

        col.Arrange(10, 20, 200, 100);
        Console.WriteLine("zero " + Convert.ToString(first.bx) + ","
            + Convert.ToString(first.by) + " "
            + Convert.ToString(first.bw) + "x"
            + Convert.ToString(first.bh) + " "
            + Convert.ToString(col.contentH));

        col.Padding(5, 7, 9, 11);
        col.Arrange(10, 20, 200, 30);
        Console.WriteLine("padded " + Convert.ToString(first.bx) + ","
            + Convert.ToString(first.by) + " "
            + Convert.ToString(first.bw) + "x"
            + Convert.ToString(first.bh) + " "
            + Convert.ToString(first.visible) + " "
            + Convert.ToString(second.visible) + " "
            + Convert.ToString(col.contentH));
    }
}
