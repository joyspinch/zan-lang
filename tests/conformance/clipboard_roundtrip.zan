// 核心契约与语义定义。
using System;
using System.Diagnostics;
using System.IO;
using System.Windows.Clipboard;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        string original = Clipboard.GetText();
        bool hadText = Clipboard.HasText();
        bool hadFiles = Clipboard.HasFiles();
        List<string> originalFiles = Clipboard.GetFiles();
        List<string> paths = new List<string>();
        string prefix = Path.GetTempPath() + "zan_clip_test_" + Guid.New() + "_";
        paths.Add(prefix + "测试-&%#'.txt");
        paths.Add(prefix + "b file.zan");
        #if MACOS
        // 核心契约与语义定义。
        paths.Add(prefix + "line\nbreak.txt");
        #endif
        try {
            for (int i = 0; i < paths.Count; i = i + 1) {
                File.WriteAllText(paths[i], "clipboard fixture");
            }
            string unique = "zan-clip-测试-\n'&%#-" + Convert.ToString(ProcessList.SelfPid());
            if (!Clipboard.SetText(unique)) { bad = bad + 1; }
            if (Clipboard.GetText() != unique) { bad = bad + 1; }
            if (!Clipboard.HasText()) { bad = bad + 1; }

            if (!Clipboard.SetFiles(paths)) { bad = bad + 1; }
            if (!Clipboard.HasFiles()) { bad = bad + 1; }
            List<string> files = Clipboard.GetFiles();
            if (files.Count != paths.Count) { bad = bad + 1; }
            else {
                for (int i = 0; i < paths.Count; i = i + 1) {
                    if (files[i] != paths[i]) { bad = bad + 1; }
                }
            }
            List<int> formats = Clipboard.Formats();
            bool sawFiles = false;
            for (int i = 0; i < formats.Count; i = i + 1) {
                if (formats[i] == 15) { sawFiles = true; }
            }
            if (!sawFiles) { bad = bad + 1; }
            List<string> mimeTypes = Clipboard.MimeTypes();
            bool sawUriList = false;
            for (int i = 0; i < mimeTypes.Count; i = i + 1) {
                if (mimeTypes[i] == Clipboard.MimeUriList()) { sawUriList = true; }
            }
            if (!sawUriList) { bad = bad + 1; }

            // 核心契约与语义定义。
            if (!Clipboard.SetText(unique)) { bad = bad + 1; }
            if (Clipboard.HasFiles() || Clipboard.GetFiles().Count != 0) { bad = bad + 1; }
            #if MACOS
            List<string> empty = new List<string>();
            if (!Clipboard.SetFiles(empty)) { bad = bad + 1; }
            if (Clipboard.HasFiles() || Clipboard.GetFiles().Count != 0) { bad = bad + 1; }
            #endif
        } finally {
            if (hadFiles) { Clipboard.SetFiles(originalFiles); }
            else if (hadText) { Clipboard.SetText(original); }
            else { Clipboard.Clear(); }
            for (int i = 0; i < paths.Count; i = i + 1) {
                if (File.Exists(paths[i])) { File.Delete(paths[i]); }
            }
        }
        Console.WriteLine("clip-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
