// Clipboard test: text round-trip, file list (CF_HDROP) round-trip, format
// enumeration. The original clipboard text is restored afterwards so the
// test does not clobber the user's clipboard.
using System;
using System.Diagnostics;
using System.Windows.Clipboard;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        string original = Clipboard.GetText();
        bool hadText = Clipboard.HasText();

        // Text round-trip (Unicode content).
        string unique = "zan-clip-测试-" + Convert.ToString(ProcessList.SelfPid());
        if (!Clipboard.SetText(unique)) { bad = bad + 1; }
        string got = Clipboard.GetText();
        if (got != unique) { bad = bad + 1; }
        if (!Clipboard.HasText()) { bad = bad + 1; }

        // File list round-trip.
        List<string> paths = new List<string>();
        paths.Add("C:\\temp\\a.txt");
        paths.Add("D:\\docs\\b file.zan");
        if (!Clipboard.SetFiles(paths)) { bad = bad + 1; }
        if (!Clipboard.HasFiles()) { bad = bad + 1; }
        List<string> files = Clipboard.GetFiles();
        if (files.Count != 2) { bad = bad + 1; }
        else {
            if (files[0] != "C:\\temp\\a.txt") { bad = bad + 1; }
            if (files[1] != "D:\\docs\\b file.zan") { bad = bad + 1; }
        }

        // Format enumeration: a file list must expose CF_HDROP (15).
        List<int> formats = Clipboard.Formats();
        bool sawHdrop = false;
        for (int i = 0; i < formats.Count; i = i + 1) {
            if (formats[i] == 15) { sawHdrop = true; }
        }
        if (!sawHdrop) { bad = bad + 1; }

        // Restore the original clipboard content.
        if (hadText) { Clipboard.SetText(original); }
        else { Clipboard.Clear(); }

        Console.WriteLine("clip-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}

