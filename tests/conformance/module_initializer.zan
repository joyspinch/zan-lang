using System;
using System.Runtime.CompilerServices;

namespace Conf;

class Alpha {
    public static string Trace = "";
    public static bool HiddenRan = false;

    static Alpha() {
        Trace = Trace + "cctor;";
    }

    [ModuleInitializer]
    public static void InitFirst() {
        Trace = Trace + "init1;";
    }
}

class UnreferencedModule {
    [System.Runtime.CompilerServices.ModuleInitializer]
    internal static void InitHidden() {
        Alpha.HiddenRan = true;
        Alpha.Trace = Alpha.Trace + "hidden;";
    }
}

class Program {
    static void Main() {
        Alpha.Trace = Alpha.Trace + "main;";
        Console.WriteLine(Alpha.Trace);
        Console.WriteLine(Alpha.HiddenRan ? "hidden=true" : "hidden=false");
    }
}
