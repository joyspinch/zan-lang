using System;

// 核心契约与语义定义。
class Program {
    static void Main() {
        double nan = double.NaN;
        Console.WriteLine(Math.Max(nan, 5.0) != Math.Max(nan, 5.0));
        Console.WriteLine(Math.Max(5.0, nan) != Math.Max(5.0, nan));
        Console.WriteLine(Math.Min(nan, 5.0) != Math.Min(nan, 5.0));
        Console.WriteLine(Math.Min(5.0, nan) != Math.Min(5.0, nan));
        Console.WriteLine(Math.Max(3.0, 7.0));
        Console.WriteLine(Math.Min(3.0, 7.0));
        Console.WriteLine(Math.Max(-3.5, -7.5));
        Console.WriteLine(Math.Min(-3.5, -7.5));
        Console.WriteLine(Math.Max(3, 9));
        Console.WriteLine(Math.Min(3, 9));
    }
}
