using System;
namespace Conf;

// 回归:INT_MIN / -1 与 LONG_MIN / -1 曾让进程在硬件 #DE 异常里
// 挂死。现行契约(75fcb3bef 后,与 C# unchecked 有别):软路径对
// 溢出组合与零除一律取 0,避免硬件异常;零除另在 stderr 报
// "runtime error: division by zero" 后继续(checked{} 内抛异常)。
class Program {
    static void Main() {
        int lo = -2147483647 - 1;
        int m = -1;
        int q = lo / m;
        Console.WriteLine(q);
        int r = lo % m;
        Console.WriteLine(r);
        long lmin = -9223372036854775807L - 1;
        long lm = -1L;
        Console.WriteLine(lmin / lm);
        Console.WriteLine(lmin % lm);
        // 非溢出除法不受折叠影响
        Console.WriteLine(10 / -1);
        Console.WriteLine(10 % -1);
        Console.WriteLine(-7 / 3);
        // 零除:stderr 报运行时错误后继续,x/0 -> 0,x%0 -> 0
        int z = 0;
        int dz = 10 / z;
        Console.WriteLine(dz);
        int dz2 = 10 % z;
        Console.WriteLine(dz2);
    }
}
