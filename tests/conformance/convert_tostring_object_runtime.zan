using System;

// A444 安全栏：Convert.ToString(object) 运行期判别负载。
// 字符串负载照旧拷贝内容；null 与类实例不再把对象指针当 C 字符串
// strlen（越界读 + 内存信息泄露），而是软运行时错（stderr，
// strict 模式 exit 70）+ 空串兜底，程序继续。stdout 钉住定义行为。
class Program {
    static void Main() {
        object s = "kept";
        Console.WriteLine(Convert.ToString(s));
        object n = null;
        Console.WriteLine("[" + Convert.ToString(n) + "]");
        object o = new ArgumentException("x");
        Console.WriteLine("[" + Convert.ToString(o) + "]");
        Console.WriteLine("done");
    }
}
