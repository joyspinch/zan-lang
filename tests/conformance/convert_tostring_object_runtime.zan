using System;

// A444 安全栏：Convert.ToString(object) 运行期判别负载。
// 字符串负载照旧拷贝内容；null 返回空串；类实例走虚方法 ToString()
// （重写者返回自己的文本，如异常返回 Message；未重写的返回类型名），
// 不再把对象指针当 C 字符串 strlen（越界读 + 内存信息泄露）。stdout 钉住定义行为。
class Plain {
    public int v;
}

class Program {
    static void Main() {
        object s = "kept";
        Console.WriteLine(Convert.ToString(s));
        object n = null;
        Console.WriteLine("[" + Convert.ToString(n) + "]");
        object o = new ArgumentException("x");
        Console.WriteLine("[" + Convert.ToString(o) + "]");
        object p = new Plain();
        Console.WriteLine("[" + Convert.ToString(p) + "]");
        Console.WriteLine("done");
    }
}
