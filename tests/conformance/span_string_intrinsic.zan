using System;
namespace Conf;
class Program {
    static void Main() {
        string text = "Hello, Zan!";
        ReadOnlySpan<char> s = text.AsSpan();
        Console.WriteLine(s.Length);
        Console.WriteLine((int)s[0]);
        Console.WriteLine((int)s[7]);

        ReadOnlySpan<char> sub = text.AsSpan(7, 3);
        Console.WriteLine(sub.Length);
        Console.WriteLine((int)sub[0]);
        Console.WriteLine((int)sub[1]);
        Console.WriteLine((int)sub[2]);

        ReadOnlySpan<char> sub2 = sub.Slice(1, 2);
        Console.WriteLine(sub2.Length);
        Console.WriteLine((int)sub2[0]);
        Console.WriteLine((int)sub2[1]);
    }
}
