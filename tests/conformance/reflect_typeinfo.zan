// Reflection, first layer: the compiler emits a type record per class/struct/
// enum, `typeof(T)` and `obj.GetType()` hand back a TypeInfo on it, and fields
// can be listed and read by name.
using System;

namespace Reflect;

enum Color { Red, Green = 5, Blue }

struct Point {
    public int X;
    public int Y;
}

class Animal {
    public string Name;
}

class Dog : Animal {
    public int Legs;
    public double Weight;
    public int Age { get; set; }
}

class Program {
    static void Main() {
        // typeof(T) still prints the display name
        Console.WriteLine(typeof(int));
        Console.WriteLine(typeof(Dog));

        // type identity and kind
        TypeInfo ti = typeof(Dog);
        Console.WriteLine(ti.Name);
        Console.WriteLine(ti.Kind);
        Console.WriteLine(typeof(Point).Kind);
        Console.WriteLine(typeof(Color).Kind);

        // fields, inherited ones first (they are the layout prefix)
        Console.WriteLine(ti.FieldCount);
        for (int i = 0; i < ti.FieldCount; i++) {
            Console.WriteLine(ti.GetFieldName(i) + ":" + ti.GetFieldType(i));
        }
        Console.WriteLine(typeof(Point).FieldCount);
        Console.WriteLine(typeof(Point).GetFieldName(1));
        Console.WriteLine(typeof(Point).GetFieldType(1));

        // enum members carry their value
        Console.WriteLine(typeof(Color).FieldCount);
        Console.WriteLine(typeof(Color).GetFieldName(1));
        Console.WriteLine(typeof(Color).GetMemberValue(1));
        Console.WriteLine(typeof(Color).GetMemberValue(2));

        // GetType() answers the concrete type through a base-typed reference
        Dog d = new Dog();
        d.Name = "Rex";
        d.Legs = 4;
        d.Weight = 12.5;
        d.Age = 3;
        Animal a = d;
        Console.WriteLine(a.GetType().Name);

        // read fields by name
        Console.WriteLine(d.GetFieldString("Name"));
        Console.WriteLine(d.GetFieldInt("Legs"));
        Console.WriteLine(d.GetFieldDouble("Weight"));
        Console.WriteLine(d.GetFieldInt("Age"));
        Console.WriteLine(a.GetFieldString("Name"));
        Console.WriteLine(d.HasField("Legs"));
        Console.WriteLine(d.HasField("Tail"));
        Console.WriteLine(d.GetFieldInt("Tail"));
        Console.WriteLine("[" + d.GetFieldString("Tail") + "]");

        // structs too, by value
        Point p = new Point();
        p.X = 7;
        p.Y = 9;
        Console.WriteLine(p.GetType().Name);
        Console.WriteLine(p.GetFieldInt("X") + p.GetFieldInt("Y"));
        Console.WriteLine(typeof(Dog).HasField("Weight"));
    }
}
