using System;
using System.Collections.Generic;

class Entity {
    public string name;
    public int age;
}

class Query<T> {
    public string lastOrder;

    public Query<T> OrderBy(Func<T, int> expr) {
        this.lastOrder = "int";
        return this;
    }

    public Query<T> OrderBy(Func<T, string> expr) {
        this.lastOrder = "string";
        return this;
    }
}

class Program {
    static int Main() {
        Query<Entity> q = new Query<Entity>();
        q.OrderBy(a => a.name);
        if (q.lastOrder != "string") return 1;

        q.OrderBy(a => a.age);
        if (q.lastOrder != "int") return 2;

        Console.WriteLine("PASS: generic delegate overload resolution");
        return 0;
    }
}
