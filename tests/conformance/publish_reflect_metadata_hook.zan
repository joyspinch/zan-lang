using System;

// Field TypeInfo preserves signatures without allocating their owners.
class PublishReflectMetadataHolder {
    public PublishReflectMetadataHookOwner Owner;
}

class PublishReflectMetadataHookOwner {
    public void OnPaint() {
        Console.WriteLine("PUBLISH_REFLECT_METADATA_ONPAINT_MUST_BE_DEAD");
        PublishReflectMetadataHookPayload payload = new PublishReflectMetadataHookPayload();
    }
}

class PublishReflectMetadataHookPayload {
    public PublishReflectMetadataHookPayload() {
        Console.WriteLine("PUBLISH_REFLECT_METADATA_PAYLOAD_MUST_BE_DEAD");
    }
}

class Program {
    static void Require(bool value, string message) {
        if (!value) throw new Exception(message);
    }

    static int Main() {
        TypeInfo holder = typeof(PublishReflectMetadataHolder);
        Require(holder.FieldCount == 1, "holder field metadata retained");
        TypeInfo owner = holder.GetFieldTypeInfo(0);
        Require(owner.HasMethod("OnPaint"), "field owner hook metadata retained");
        Console.WriteLine("publish reflect metadata hook PASS");
        return 0;
    }
}
