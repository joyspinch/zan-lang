using System;

// A459：**表达式体** lambda 返回结构体。
//
// 缺陷：lambda 体是 `new Point()` 时，求值结果是结构体对象的**地址**，
// 而委托的返回签名是「按值返回结构体」——`ret ptr %new` 与函数返回类型
// `%struct.Point` 不符，LLVM 校验失败（Function return type does not match
// operand type of return inst）。
//
// 块体 lambda 的 `return v;` 走的是另一条发射路径（会按值取出），
// 所以只有表达式体这一条漏了。

struct Point { public int x; public int y; }

class Factory<T> {
    public T Make(Func<T> f) {
        return f();
    }
}

public class Program {
    public static void Main() {
        int fail = 0;

        // 表达式体 lambda 返回结构体
        Factory<Point> factory = new Factory<Point>();
        Point made = factory.Make(() => new Point());
        if (made.x != 0 || made.y != 0) {
            Console.WriteLine("FAIL: expression-bodied lambda struct return");
            fail++;
        }

        // 块体 lambda 返回结构体（值语义：改的是副本）
        Point src = new Point();
        src.x = 3;
        FuncT<Point, Point> bump = (Point v) => { v.x = v.x + 1; return v; };
        Point moved = bump(src);
        if (moved.x != 4) {
            Console.WriteLine("FAIL: block-bodied lambda struct return");
            fail++;
        }
        if (src.x != 3) {
            Console.WriteLine("FAIL: block-bodied lambda mutated the source");
            fail++;
        }

        if (fail == 0) {
            Console.WriteLine("ALL LAMBDA STRUCT RETURN TESTS PASSED");
        }
    }
}
