using System;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static void Main() {
        ChartOption o = ChartOption.Of("Chart", new List<string>{"A"}, new List<ChartSeries>{
            ChartSeries.Line("Series", new List<int>{1, 2})
        });
        ChartController c = ChartController.Of(o);
        ChartView view = ChartView.BindKeyed(c, 42);
        Console.WriteLine(Convert.ToString(c.Version()) + ":" + Convert.ToString(view != null));
    }
}

