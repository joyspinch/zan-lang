using System;

class Box {
    string tag;
    Box(string t) {
        this.tag = t;
    }
    string Tag() {
        return this.tag;
    }
}

class Prog {
    static async void Parker() {
        Box keep = new Box("keep");
        await Task.Delay(60000);
    }

    static async int Run() {
        Task.Spawn(Prog.Parker());
        await Task.Delay(100);
        Box decoy = new Box("decoy");
        Console.WriteLine("decoy: " + decoy.Tag());
        for (int i = 0; i < 5; i = i + 1) { await Task.Delay(10); }
        return 0;
    }

    static void Main() {
        int r = await Prog.Run();
    }
}
