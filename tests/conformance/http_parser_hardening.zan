// Conformance: HTTP parser OWS and response-header injection hardening.
using System;
using System.Net.Http;

class Program {
    static int failures = 0;

    static void Check(bool ok, string name) {
        if (ok) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            Program.failures = Program.failures + 1;
        }
    }

    static void Main() {
        HttpRequest r = HttpRequest.Parse(
            "GET\t/p?q=1\tHTTP/1.1\r\n"
            + "Host:\th.example\t\r\n"
            + "X-Test:\t value \t\r\n"
            + "Connection:\t keep-alive\t,\tclose \r\n"
            + "\r\n");
        Program.Check(r.method == "GET", "request method with HTAB OWS");
        Program.Check(r.path == "/p", "request target with HTAB OWS");
        Program.Check(r.queryString == "q=1", "request query with HTAB OWS");
        Program.Check(r.host == "h.example", "request value OWS trimmed");
        Program.Check(r.GetHeader("X-Test") == "value", "generic header OWS trimmed");
        Program.Check(!r.keepAlive, "connection tokens with OWS");

        HttpResponse p = HttpResponse.Parse(
            "HTTP/1.1\t200\tOK\r\n"
            + "Content-Type:\t text/plain \t\r\n"
            + "X-Test:\t yes \t\r\n\r\nbody");
        Program.Check(p.statusCode == 200, "response status with HTAB OWS");
        Program.Check(p.statusText == "OK", "response reason OWS trimmed");
        Program.Check(p.contentType == "text/plain", "response content type OWS trimmed");
        Program.Check(p.GetHeader("X-Test") == "yes", "response header OWS trimmed");
        Program.Check(p.body == "body", "response body after OWS headers");

        HttpResponse h = HttpResponse.Text("ok");
        h.SetHeader("X-Bad\r\nInjected", "yes");
        h.SetHeader("X-Bad-Value", "yes\r\nInjected: x");
        Program.Check(h.Build().IndexOf("Injected") < 0,
            "response SetHeader rejects CRLF");
        HttpResponse safe = HttpResponse.Redirect("/next");
        Program.Check(safe.statusCode == 302
            && safe.GetHeader("Location") == "/next",
            "safe redirect retained");
        HttpResponse bad = HttpResponse.Redirect("/next\r\nX-Evil: 1");
        Program.Check(bad.statusCode == 400
            && bad.GetHeader("Location") == "",
            "redirect CRLF rejected");

        // 畸形状态行/头部/分帧必须整体拒收（statusCode=0，合法状态码
        // 恒 >= 100），不得解释成"200 空响应"——响应错位的起点。
        string ctrl = "" + (char)1;
        string[] badWires = new string[] {
            "HTTP/1.1x 200 OK\r\n\r\n",                          // 版本后缀
            "HTTP/1.1200 OK\r\n\r\n",                            // 版本与码间缺 OWS
            "HTTP/1.1 2000 OK\r\n\r\n",                          // 4 位状态码
            "HTTP/1.1 610 X\r\n\r\n",                            // 6xx
            "HTTP/1.1 200 OK\nX-Bad: 1\r\n\r\n",                 // 状态行内裸 LF
            "HTTP/1.1 200 OK\r\nNoColon\r\n\r\n",                // 无冒号头
            "HTTP/1.1 200 OK\r\nX-Test : v\r\n\r\n",             // 冒号前空白
            "HTTP/1.1 200 OK\r\nX-Bad: a" + ctrl + "b\r\n\r\n",  // 值含控制字符
            "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n"
                + "Transfer-Encoding: chunked\r\n\r\n",          // TE+CL 冲突
            "HTTP/1.1 200 OK\r\nX-A: 1\r\n"                      // 头块未终止
        };
        for (int i = 0; i < badWires.Length; i = i + 1) {
            HttpResponse rej = HttpResponse.Parse(badWires[i]);
            Program.Check(rej != null && rej.statusCode == 0
                && rej.GetHeader("X-Bad") == "",
                "malformed response rejected " + Convert.ToString(i));
        }
        HttpResponse minimal = HttpResponse.Parse("HTTP/1.1 200\r\n\r\n");
        Program.Check(minimal.statusCode == 200 && minimal.statusText == "",
            "reasonless status line accepted");
        HttpResponse withBody = HttpResponse.Parse(
            "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\n\r\noops");
        Program.Check(withBody.statusCode == 404 && withBody.body == "oops"
            && withBody.contentType == "text/plain",
            "normal response still parses");

        Console.WriteLine("failures=" + Convert.ToString(Program.failures));
    }
}
