    static async void HandleHello(HttpContext ctx) {
        ctx.Text("hello over https");
    }

    static async void HandleSecureCookie(HttpContext ctx) {
        ctx.SetCookie("token", "secret123", 3600);
        ctx.Text("cookie set");
    }

    static TcpListener listener;
    static bool listening = true;

    static async void Accept(WebApp app) {
        TcpListener l = new TcpListener("127.0.0.1", Program.PORT);
        l.Start();
        Program.listener = l;
        while (Program.listening) {
            nint sock = await l.AcceptAsync();
            if (sock >= 0) {
                Task.Spawn(app.HandleTlsConnection(sock));
            }
        }
    }

    static async int Run() {
        Socket.Initialize();
        Directory.CreateDirectory("_scratch");
        File.WriteAllText("_scratch/web_tls_ca.pem", Program.CA_CERT);
        File.WriteAllText("_scratch/web_tls_cert.pem", Program.SERVER_CERT);
        File.WriteAllText("_scratch/web_tls_key.pem", Program.SERVER_KEY);

        WebApp app = new WebApp("127.0.0.1", Program.PORT);
        app.UseHttps("_scratch/web_tls_cert.pem", "_scratch/web_tls_key.pem");

        app.Router().Get("/hello", Program.HandleHello);
        app.Router().Get("/secure_cookie", Program.HandleSecureCookie);

        Task.Spawn(Program.Accept(app));
        await Task.Delay(100);
        Check(true, "listener up");

        // 1. HTTPS (HTTP/1.1 over TLS) 测试
        HttpClient httpsClient = HttpClient.CreateHttps("127.0.0.1", Program.PORT);
        httpsClient.DisableTlsVerify();
        httpsClient.SetTimeout(10000);

        HttpResponse r1 = await httpsClient.SendAsync("GET", "/hello", "");
        Check(r1.statusCode == 200, "https get status");
        Check(r1.body == "hello over https", "https get body");

        HttpResponse r2 = await httpsClient.SendAsync("GET", "/secure_cookie", "");
        Check(r2.statusCode == 200, "https cookie status");
        string setCookie = r2.GetHeader("Set-Cookie");
        Check(setCookie.IndexOf("; Secure") >= 0, "https secure cookie");
        httpsClient.Dispose();

        // 2. HTTP/2 (over TLS) 测试
        Http2ClientConnection h2 = await Http2ClientConnection.ConnectTlsAsync("127.0.0.1", Program.PORT, false);
        Check(h2 != null, "http2 client connected");
        if (h2 != null) {
            HttpResponse h2Resp = await h2.SendAsync("GET", "/hello", null, null, "");
            Check(h2Resp != null && h2Resp.statusCode == 200, "http2 get status");
            Check(h2Resp != null && h2Resp.body == "hello over https", "http2 get body");
            h2.Dispose();
        }

        Program.listening = false;
        if (Program.listener != null) {
            Program.listener.Stop();
            Program.listener = null;
        }
        app.Dispose();
        for (int i = 0; i < 25; i = i + 1) { await Task.Delay(10); }

        HpackStaticTable.Teardown();
        HpackHuffman.Teardown();
        Socket.Cleanup();

        if (failures == 0) {
            Console.WriteLine("ok web https and http2 passed");
            return 0;
        }
        return 1;
    }

    static void Main() {
        int r = await Run();
    }
}
