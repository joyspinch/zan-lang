using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

/// min/max:'dataMin'/'dataMax' 字面量（scaleRawExtentInfo.ts:241-262 fixMM
/// 语义）：该端钉在原始数据极值上——不 nice、不并入 0，单侧并入 0 因
/// respect fixMM 不生效。此前 minDataB/maxDataB 只解析不接线。
class Program {
    static void Main() {
        App app = new App("dm", 900, 600);
        app.BeginFrame();

        // 只声明 min:'dataMin'：lo = 137 精确（不 nice 到 100/0），
        // hi 仍走自动 nice。
        ChartOption o1 = ChartOption.FromJson(File.ReadAllText(
            "tests/conformance/data_chart_datamin_line.json"));
        ChartFrame f1 = Chart.BuildAxesR(app, 0, 0, 900, 600, 40,
            o1.XCategories(), o1, o1.series, 0 - 1, 0 - 1, 0 - 1, 0 - 1);
        Console.WriteLine("pinLo:" + Convert.ToString(f1.leftMin));

        // 双端声明：域 = [137, 245] 精确，无 nice 包络。
        ChartOption o2 = ChartOption.FromJson(File.ReadAllText(
            "tests/conformance/data_chart_dataminmax_line.json"));
        ChartFrame f2 = Chart.BuildAxesR(app, 0, 0, 900, 600, 40,
            o2.XCategories(), o2, o2.series, 0 - 1, 0 - 1, 0 - 1, 0 - 1);
        Console.WriteLine("pinBoth:" + Convert.ToString(f2.leftMin)
            + ":" + Convert.ToString(f2.leftMax));

        // 声明端不受 markLine/markArea 填充钳制：mark 分支只在两端
        // Auto 时扩域，dataMin/dataMax 是"已声明"。
        ChartSeries ms = ChartSeries.Line("m", new List<int>{137, 213, 189, 245});
        ChartOption o3 = ChartOption.Create();
        o3.series = new List<ChartSeries>{ms};
        ChartAxis ya3 = ChartAxis.Value();
        ya3.minDataB = true; ya3.maxDataB = true;
        o3.yAxes = new List<ChartAxis>{ya3};
        o3.xAxes = new List<ChartAxis>{ChartAxis.Category(new List<string>{"A","B","C","D"})};
        ChartFrame f3 = Chart.BuildAxesR(app, 0, 0, 900, 600, 40,
            o3.XCategories(), o3, o3.series, 0 - 1, 0 - 1, 0 - 1, 0 - 1);
        Console.WriteLine("noMarkPad:" + Convert.ToString(f3.leftMin)
            + ":" + Convert.ToString(f3.leftMax));
    }
}
