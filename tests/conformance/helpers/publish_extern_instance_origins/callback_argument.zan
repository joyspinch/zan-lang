using System;

interface IRun {
    void Run();
}

class Worker : IRun {
    public void Run() {
        Console.WriteLine("EXTERN_INSTANCE_BODY_RETAINED");
    }
}

class Native {
    [DllImport("publish_extern_instance_origins", EntryPoint = "ExternInstanceCallback")]
    public static extern void Visit(Action<IRun> callback);
}

class Program {
    static void Read(IRun worker) {
        worker.Run();
    }

    static int Main() {
        Console.WriteLine("EXTERN_INSTANCE_MAIN");
        Native.Visit(Program.Read);
        return 0;
    }
}
