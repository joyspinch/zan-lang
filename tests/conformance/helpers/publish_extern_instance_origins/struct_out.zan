using System;

interface IRun {
    void Run();
}

struct Envelope<T> {
    public T Value;
}

// The out parameter supplies the interface instance without allocating
// Worker in Zan or returning an instance from the extern method itself.
class Worker : IRun {
    public void Run() {
        Console.WriteLine("EXTERN_INSTANCE_BODY_RETAINED");
    }
}

class Native {
    [DllImport("publish_extern_instance_origins", EntryPoint = "ExternInstanceStructOut")]
    public static extern void GetEnvelope(out Envelope<IRun> envelope);
}

class Program {
    static int Main() {
        Console.WriteLine("EXTERN_INSTANCE_MAIN");
        Envelope<IRun> envelope;
        Native.GetEnvelope(out envelope);
        envelope.Value.Run();
        return 0;
    }
}
