using System;

struct Envelope<T> {
    public T Value;
}

class Native {
    [DllImport("publish_extern_instance_origins", EntryPoint = "ExternScalarBytes")]
    public static extern byte[] GetBytes();

    [DllImport("publish_extern_instance_origins", EntryPoint = "ExternScalarString")]
    public static extern string GetText();

    [DllImport("publish_extern_instance_origins", EntryPoint = "ExternScalarStruct")]
    public static extern Envelope<int> GetNumber();

    [DllImport("publish_extern_instance_origins", EntryPoint = "ExternScalarAction")]
    public static extern Action GetAction();
}

// This field preserves DeadOwner metadata without introducing an instance.
class Holder {
    public DeadOwner Owner;
}

class DeadOwner {
    public void OnPaint() {
        Console.WriteLine("EXTERN_SCALAR_HOOK_MUST_BE_DEAD");
    }
}

class Program {
    static int Main() {
        Console.WriteLine("EXTERN_INSTANCE_MAIN");
        byte[] bytes = Native.GetBytes();
        string text = Native.GetText();
        Envelope<int> number = Native.GetNumber();
        Action action = Native.GetAction();
        action();
        Console.WriteLine(bytes.Length);
        Console.WriteLine(text);
        Console.WriteLine(number.Value);
        TypeInfo holder = typeof(Holder);
        if (holder.FieldCount != 1) return 1;
        TypeInfo owner = holder.GetFieldTypeInfo(0);
        if (!owner.HasMethod("OnPaint")) return 2;
        return 0;
    }
}
