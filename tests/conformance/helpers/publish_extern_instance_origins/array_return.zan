using System;

interface IRun {
    void Run();
}

// The native array is the only source of an instance; do not add a local
// Worker allocation that could independently keep this method alive.
class Worker : IRun {
    public void Run() {
        Console.WriteLine("EXTERN_INSTANCE_BODY_RETAINED");
    }
}

class Native {
    [DllImport("publish_extern_instance_origins", EntryPoint = "ExternInstanceArrayReturn")]
    public static extern IRun[] GetWorkers();
}

class Program {
    static int Main() {
        Console.WriteLine("EXTERN_INSTANCE_MAIN");
        IRun[] workers = Native.GetWorkers();
        workers[0].Run();
        return 0;
    }
}
