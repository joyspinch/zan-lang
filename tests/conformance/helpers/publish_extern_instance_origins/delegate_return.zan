using System;

interface IRun {
    void Run();
}

class Worker : IRun {
    public void Run() {
        Console.WriteLine("EXTERN_INSTANCE_BODY_RETAINED");
    }
}

class Native {
    [DllImport("publish_extern_instance_origins", EntryPoint = "ExternInstanceDelegateReturn")]
    public static extern Func<IRun> GetFactory();
}

class Program {
    static int Main() {
        Console.WriteLine("EXTERN_INSTANCE_MAIN");
        Func<IRun> factory = Native.GetFactory();
        IRun worker = factory();
        worker.Run();
        return 0;
    }
}
