using System;

interface IRun {
    void Run();
}

struct Envelope<T> {
    public T Value;
}

// No Zan allocation site exists for Worker; the instance arrives through
// a generic struct field containing an array of interface references.
class Worker : IRun {
    public void Run() {
        Console.WriteLine("EXTERN_INSTANCE_BODY_RETAINED");
    }
}

class Native {
    [DllImport("publish_extern_instance_origins", EntryPoint = "ExternInstanceStructReturn")]
    public static extern Envelope<IRun[]> GetEnvelope();
}

class Program {
    static int Main() {
        Console.WriteLine("EXTERN_INSTANCE_MAIN");
        Envelope<IRun[]> envelope = Native.GetEnvelope();
        envelope.Value[0].Run();
        return 0;
    }
}
