using System;
using System.Collections.Concurrent;
using System.Threading;

class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            failures = failures + 1;
        }
    }

    static void Main() {
        // 1. ConcurrentQueue 基本队列与先进先出
        ConcurrentQueue<string> q = new ConcurrentQueue<string>();
        q.Enqueue("alpha");
        q.Enqueue("beta");
        q.Enqueue("gamma");
        Check(q.Count() == 3, "queue_count_initial");

        string peekVal;
        Check(q.TryPeek(out peekVal) == true && peekVal == "alpha", "queue_peek");
        Check(q.Count() == 3, "queue_count_after_peek");

        string deqVal;
        Check(q.TryDequeue(out deqVal) == true && deqVal == "alpha", "queue_dequeue_1");
        Check(q.Count() == 2, "queue_count_after_deq_1");

        string[] arr = q.ToArray();
        Check(arr.Length == 2 && arr[0] == "beta" && arr[1] == "gamma", "queue_to_array");

        q.Clear();
        Check(q.IsEmpty() == true && q.Count() == 0, "queue_clear");
        Check(q.TryDequeue(out deqVal) == false && deqVal == null, "queue_dequeue_empty");

        // 2. ConcurrentDictionary 分段锁字典操作
        ConcurrentDictionary<string, int> dict = new ConcurrentDictionary<string, int>();
        Check(dict.TryAdd("k1", 100) == true, "dict_try_add_new");
        Check(dict.TryAdd("k1", 999) == false, "dict_try_add_duplicate");

        int dictVal;
        Check(dict.TryGetValue("k1", out dictVal) == true && dictVal == 100, "dict_try_get_value");
        Check(dict.TryGetValue("missing", out dictVal) == false, "dict_try_get_missing");
        Check(dict.ContainsKey("k1") == true, "dict_contains_key");
        Check(dict.ContainsKey("missing") == false, "dict_not_contains_key");

        int got = dict.GetOrAdd("k2", 200);
        Check(got == 200 && dict.Count() == 2, "dict_get_or_add_new");
        got = dict.GetOrAdd("k1", 999);
        Check(got == 100, "dict_get_or_add_existing");

        dict["k3"] = 300;
        Check(dict["k3"] == 300 && dict.Count() == 3, "dict_indexer");

        int removedVal;
        Check(dict.TryRemove("k2", out removedVal) == true && removedVal == 200, "dict_try_remove");
        Check(dict.ContainsKey("k2") == false && dict.Count() == 2, "dict_after_remove");

        var keys = dict.Keys();
        Check(keys.Count == 2, "dict_keys");

        // 3. 值类型并发队列与字典消费循环
        ConcurrentQueue<int> iq = new ConcurrentQueue<int>();
        ConcurrentDictionary<int, int> idict = new ConcurrentDictionary<int, int>();
        for (int i = 0; i < 50; i = i + 1) {
            iq.Enqueue(i);
            idict.TryAdd(i, i * 2);
        }
        Check(iq.Count() == 50, "int_queue_count");
        Check(idict.Count() == 50, "int_dict_count");

        int countDequeued = 0;
        int elem;
        while (iq.TryDequeue(out elem)) {
            countDequeued = countDequeued + 1;
            int v;
            Check(idict.TryGetValue(elem, out v) == true && v == elem * 2, "int_dict_lookup_" + elem);
        }
        Check(countDequeued == 50 && iq.IsEmpty(), "int_queue_all_dequeued");

        if (failures > 0) {
            Console.WriteLine("Total failures: " + failures);
            Environment.Exit(1);
        }
        Console.WriteLine("All concurrent collections tests passed!");
    }
}
