using System;
using System.Web;
using ZanWeb.Web;

namespace Conf;

class PublicToolController : AppController {
    [HttpGet]
    [Route("/tool")]
    void Index() { this.Text("tool"); }
}

class SettingsScreenController : AdminController {
    [HttpGet]
    [Route("/screen")]
    void Index() { this.Text("screen"); }
}

class Program {
    static int failures;

    static void Check(bool ok, string label) {
        if (!ok) {
            Program.failures = Program.failures + 1;
            Console.WriteLine("FAIL " + label);
        }
    }

    static Route Match(WebApp app, string path) {
        HttpRequest request = HttpRequest.Parse("GET " + path + " HTTP/1.1\r\nHost: test\r\n\r\n");
        HttpContext ctx = new HttpContext(request, "127.0.0.1");
        return app.router.Match(ctx);
    }

    static void Main() {
        WebApp app = new WebApp("127.0.0.1", 0);
        __AttrRoutes.Register(app);
        Program.Check(Program.Match(app, "/tool") != null, "AppController descendant route");
        Program.Check(Program.Match(app, "/screen") != null, "AdminController descendant route");
        Program.Check(Program.Match(app, "/zanweb/app/onbeforeasync") == null, "base before hook excluded");
        Program.Check(Program.Match(app, "/zanweb/app/onafterasync") == null, "base after hook excluded");
        Program.Check(Program.Match(app, "/zanweb/app/ondone") == null, "base done hook excluded");
        Program.Check(Program.Match(app, "/zanweb/app/inany") == null, "base input helper excluded");
        Program.Check(Program.Match(app, "/zanweb/app/inanyint") == null, "base integer helper excluded");
        Program.Check(Program.Match(app, "/zanweb/admin/onbeforeasync") == null, "admin base hook excluded");
        Console.WriteLine("failures=" + Convert.ToString(Program.failures));
    }
}
