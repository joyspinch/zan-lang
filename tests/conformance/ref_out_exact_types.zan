using System;

// ref/out 实参精确类型契约（P3，E3106 红绿钉的正面）：引用传递不发生
// 转换——同型 ref/out、`out T x` 声明形式、字段/数组元素/对象位、
// 泛型形参 T 的调用点推断都必须照常工作；宽度错配由 diag 用例钉住。
class Holder {
    public long slot;
    public int[] cells = new int[4];
}

class Program {
    static void TakeRef(ref long v) { v = v + 1; }
    static void TakeOut(out int v) { v = 42; }
    static void TakeArr(ref int[] arr) { arr[0] = arr[0] + 1; }
    static void TakeObj(ref Holder h) { h.slot = h.slot + 9; }
    static void TakeGen<T>(ref T v) { v = v; }

    static int Main() {
        long l = 3;
        TakeRef(ref l);
        int n;
        TakeOut(out n);
        Holder h = new Holder();
        TakeRef(ref h.slot);
        TakeArr(ref h.cells);
        TakeObj(ref h);
        TakeGen(ref l);
        TakeGen(out n);
        Console.WriteLine(Convert.ToString(l));
        Console.WriteLine(Convert.ToString(n));
        Console.WriteLine(Convert.ToString(h.slot));
        Console.WriteLine(Convert.ToString(h.cells[0]));
        Console.WriteLine("REF_OUT_EXACT_TYPES_OK");
        return 0;
    }
}
