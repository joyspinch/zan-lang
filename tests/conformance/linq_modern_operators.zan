using System;
using System.Linq;

class Item {
    public string name;
    public int score;
    public double weight;

    public Item(string n, int s, double w) {
        this.name = n;
        this.score = s;
        this.weight = w;
    }
}

class Program {
    static int failures = 0;

    static void Check(bool cond, string name) {
        if (cond) {
            Console.WriteLine("ok " + name);
        } else {
            Console.WriteLine("FAIL " + name);
            Program.failures = Program.failures + 1;
        }
    }

    static void Main() {
        // 1. Chunk
        List<int> nums = new List<int>();
        nums.Add(1); nums.Add(2); nums.Add(3); nums.Add(4); nums.Add(5);
        List<List<int>> chunks = nums.Chunk(2);
        Check(chunks.Count == 3, "chunk count");
        Check(chunks[0].Count == 2 && chunks[0][0] == 1 && chunks[0][1] == 2, "chunk 0");
        Check(chunks[1].Count == 2 && chunks[1][0] == 3 && chunks[1][1] == 4, "chunk 1");
        Check(chunks[2].Count == 1 && chunks[2][0] == 5, "chunk 2");

        // 2. DistinctBy
        List<Item> items = new List<Item>();
        items.Add(new Item("A", 10, 1.5));
        items.Add(new Item("B", 20, 2.5));
        items.Add(new Item("A", 30, 3.5));
        items.Add(new Item("C", 10, 4.5));

        List<Item> byName = items.DistinctBy((Item x) => x.name);
        Check(byName.Count == 3, "distinct by name count");
        Check(byName[0].score == 10 && byName[2].name == "C", "distinct by name items");

        // 3. MinBy & MaxBy
        Item minItem = items.MinBy((Item x) => x.score);
        Check(minItem.score == 10, "min by int score");

        Item maxItem = items.MaxBy((Item x) => x.score);
        Check(maxItem.score == 30 && maxItem.name == "A", "max by int score");

        Item minWeight = items.MinByNum((Item x) => x.weight);
        Check(minWeight.weight == 1.5, "min by double weight");

        Item maxWeight = items.MaxByNum((Item x) => x.weight);
        Check(maxWeight.weight == 4.5, "max by double weight");

        Item minName = items.MinByStr((Item x) => x.name);
        Check(minName.name == "A", "min by str name");

        Item maxName = items.MaxByStr((Item x) => x.name);
        Check(maxName.name == "C", "max by str name");

        // 4. Zip
        List<int> list1 = new List<int>();
        list1.Add(1); list1.Add(2); list1.Add(3);
        List<string> list2 = new List<string>();
        list2.Add("x"); list2.Add("y");

        List<string> zipped = list1.Zip(list2, (int a, string b) => a + ":" + b);
        Check(zipped.Count == 2, "zip length limited by shorter");
        Check(zipped[0] == "1:x" && zipped[1] == "2:y", "zip elements");

        // 5. Prepend & Append
        List<int> prep = list1.Prepend(0);
        Check(prep.Count == 4 && prep[0] == 0 && prep[1] == 1, "prepend item");

        List<int> app = list1.Append(4);
        Check(app.Count == 4 && app[3] == 4, "append item");

        // 6. SequenceEqual
        List<int> list3 = new List<int>();
        list3.Add(1); list3.Add(2); list3.Add(3);
        Check(list1.SequenceEqual(list3), "sequence equal true");
        Check(!list1.SequenceEqual(prep), "sequence equal false");

        // 7. DefaultIfEmpty
        List<int> emptyList = new List<int>();
        List<int> def = emptyList.DefaultIfEmpty(99);
        Check(def.Count == 1 && def[0] == 99, "default if empty with val");

        List<int> nonEmptyDef = list1.DefaultIfEmpty(99);
        Check(nonEmptyDef.Count == 3 && nonEmptyDef[0] == 1, "default if empty non-empty");

        if (Program.failures == 0) {
            Console.WriteLine("ok linq modern operators passed");
        } else {
            Console.WriteLine("FAIL count: " + Program.failures);
        }
    }
}
