using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

// 轴名（ECharts axis.name）的三态几何与缺省值。
// // 官方出处（`_scratch/echarts-master`）：
// - `coord/axisDefault.ts:34` —— nameLocation 缺省 **'end'**（旧 Zan
// 是 'middle'，语料里 36 条轴没写 nameLocation，全部落点错误）。
// - `coord/axisDefault.ts:47` —— nameGap 缺省 **15**。
// - `component/axis/AxisBuilder.ts:855-880` —— 三态基位公式：
// 核心契约与语义定义。
// （sig = axis.inverse ? -1 : 1）；y 轴再叠 transformGroup 的
// 90° 旋转与 (轴线 x, plotBot) 平移，故 middle 的轴名是**竖排**的。
// // 数值由 `_scratch/chart_oracle/axisname.js`（ECharts SSR + SVG 读
// text 的 transform/text-anchor，nameMoveOverlap:false 关掉重叠搬移）
// 实测对齐：rect=100,100,400,200 下 x start=(85,300,anchor end)、
// 核心契约与语义定义。
// y middle=(85,200,matrix 0,-1,1,0)、y end=(100,85)。
class Program {
    static int FH = 16;
    static int CT = 0 - 10;   // 垂直居中一行时的行盒顶边偏移（探针值）
    static int PX = 50;       // plotX
    static int PY = 40;       // plotY
    static int PW = 410;      // plotW
    static int PH = 310;      // plotH
    // plotBot = 350、plotRight = 460

    static ChartAxis AX(string loc, bool inverse) {
        ChartAxis a = ChartAxis.Value();
        a.title = "T";
        a.nameLocation = loc;
        a.reversed = inverse;
        return a;
    }

    static string Pos(ChartAxis a, bool isX, bool far, int gap) {
        ChartAxisName n = Chart.AxisNamePosPx(a, isX, Program.PX, Program.PY,
            Program.PW, Program.PH, far, gap, Program.FH, Program.CT);
        return "ax=" + Convert.ToString(n.ax) + " ay=" + Convert.ToString(n.ay)
            + " rot=" + Convert.ToString(n.rot) + " anc=" + Convert.ToString(n.anchor);
    }

    static void Main() {
        // ---- x 轴三态（gap=15、normal、非翻转）----
        // start: plotX - gap = 35，右对齐、骑轴线（ay = axisLine + centerTop）
        Console.WriteLine("x/start:" + Program.Pos(Program.AX("start", false), true, false, 15));
        // middle: 图中线 = 50 + 410/2 = 255，字盒顶贴 plotBot + gap = 365
        Console.WriteLine("x/mid:" + Program.Pos(Program.AX("middle", false), true, false, 15));
        // end: plotRight + gap = 475，左对齐
        Console.WriteLine("x/end:" + Program.Pos(Program.AX("end", false), true, false, 15));

        // ---- y 轴三态 ----
        // start: 轴线 x=50，字盒顶贴 plotBot + gap = 365（原实现只在左上角）
        Console.WriteLine("y/start:" + Program.Pos(Program.AX("start", false), false, false, 15));
        // middle: 竖排（rot=-90），锚点 x = 轴线 - gap - 行高 = 19，
        // 锚点 y = plotBot - 155 = 195
        Console.WriteLine("y/mid:" + Program.Pos(Program.AX("middle", false), false, false, 15));
        // end: 字盒底贴 plotY - gap = 25，故顶边 = 25 - 16 = 9
        Console.WriteLine("y/end:" + Program.Pos(Program.AX("end", false), false, false, 15));

        // ---- inverse 只翻 start/end 的端（area-rainfall y[1] 的形态）----
        Console.WriteLine("inv/x/start:" + Program.Pos(Program.AX("start", true), true, false, 15));
        Console.WriteLine("inv/x/end:" + Program.Pos(Program.AX("end", true), true, false, 15));
        Console.WriteLine("inv/y/start:" + Program.Pos(Program.AX("start", true), false, false, 15));
        Console.WriteLine("inv/y/end:" + Program.Pos(Program.AX("end", true), false, false, 15));

        // 系统底层交互与数据流转契约
        Console.WriteLine("gap0/x/end:" + Program.Pos(Program.AX("end", false), true, false, 0));
        Console.WriteLine("gap40/x/end:" + Program.Pos(Program.AX("end", false), true, false, 40));
        Console.WriteLine("gap40/x/start:" + Program.Pos(Program.AX("start", false), true, false, 40));

        // ---- y 轴 position=right（middle 的 gap 翻到轴线外侧）----
        Console.WriteLine("far/y/start:" + Program.Pos(Program.AX("start", false), false, true, 15));
        Console.WriteLine("far/y/mid:" + Program.Pos(Program.AX("middle", false), false, true, 15));
        Console.WriteLine("far/y/end:" + Program.Pos(Program.AX("end", false), false, true, 15));

        // ---- 缺省值：工厂 + JSON 解析都必须是官方值 ----
        ChartAxis fresh = ChartAxis.Value();
        Console.WriteLine("def/factory:" + fresh.nameLocation + ":"
            + Convert.ToString(fresh.nameGap));
        ChartAxis cat = ChartAxis.Category(new List<string>{"a"});
        Console.WriteLine("def/category:" + cat.nameLocation + ":"
            + Convert.ToString(cat.nameGap));
        ChartOption o = ChartOption.FromJson(
            "{\"xAxis\":{\"type\":\"category\",\"data\":[\"a\"],\"name\":\"X\"},"
            + "\"yAxis\":{\"name\":\"Y\",\"nameLocation\":\"start\",\"nameGap\":40},"
            + "\"series\":[{\"type\":\"line\",\"data\":[1]}]}");
        Console.WriteLine("def/json:" + o.xAxes[0].nameLocation + ":"
            + Convert.ToString(o.xAxes[0].nameGap)
            + ":" + o.yAxes[0].nameLocation + ":"
            + Convert.ToString(o.yAxes[0].nameGap));
        // Clone 必须带上 nameGap（否则 ResolvedChart 丢参数）
        ChartAxis cl = ChartAxis.Clone(o.yAxes[0]);
        string clLoc = "";
        int clGap = 0;
        if (cl != null) { clLoc = cl.nameLocation; clGap = cl.nameGap; }
        Console.WriteLine("def/clone:" + clLoc + ":" + Convert.ToString(clGap));
        // nameGap<=0 的调用方语义：NameGapPx 走缺省 15（App 侧）。
        // 解析不到的字段保持 -1（未声明），显式 0 是合法锚。
        ChartOption z = ChartOption.FromJson(
            "{\"xAxis\":{\"type\":\"category\",\"data\":[\"a\"],\"nameGap\":0},"
            + "\"series\":[{\"type\":\"line\",\"data\":[1]}]}");
        Console.WriteLine("def/gap0:" + Convert.ToString(z.xAxes[0].nameGap));
        // 未知 nameLocation 落回 end（官方 retrieve3 的兜底）。
        Console.WriteLine("def/unknown:"
            + Program.Pos(Program.AX("garbage", false), true, false, 15));

        // ---- 与 ECharts 实测逐点对齐（rect = 50,40,410,310，即
        // line-function 的 grid，gap 取官方缺省 15）----
        // 官方（oracle: _scratch/chart_oracle/axisname.oracle.txt，关掉重叠搬移）：
        // x end   -> 页面 x = 475（plotRight + gap），字盒中心骑轴线 y
        // x start -> 页面 x =  35（plotX - gap）
        // x middle-> 页面 x = 255（图中线）、字盒顶 = plotBot + gap = 365
        // y end   -> 字盒底 = plotY - gap = 25（顶边 25 - 16 = 9）
        // y start -> 字盒顶 = plotBot + gap = 365
        ChartAxisName xe = Chart.AxisNamePosPx(Program.AX("end", false), true,
            Program.PX, Program.PY, Program.PW, Program.PH, false, 15,
            Program.FH, Program.CT);
        ChartAxisName xs = Chart.AxisNamePosPx(Program.AX("start", false), true,
            Program.PX, Program.PY, Program.PW, Program.PH, false, 15,
            Program.FH, Program.CT);
        ChartAxisName xm = Chart.AxisNamePosPx(Program.AX("middle", false), true,
            Program.PX, Program.PY, Program.PW, Program.PH, false, 15,
            Program.FH, Program.CT);
        ChartAxisName ye = Chart.AxisNamePosPx(Program.AX("end", false), false,
            Program.PX, Program.PY, Program.PW, Program.PH, false, 15,
            Program.FH, Program.CT);
        ChartAxisName ys = Chart.AxisNamePosPx(Program.AX("start", false), false,
            Program.PX, Program.PY, Program.PW, Program.PH, false, 15,
            Program.FH, Program.CT);
        Console.WriteLine("oracle:" + Convert.ToString(xe.ax) + ":"
            + Convert.ToString(xs.ax) + ":" + Convert.ToString(xm.ax)
            + ":" + Convert.ToString(xm.ay) + ":" + Convert.ToString(ye.ay + Program.FH)
            + ":" + Convert.ToString(ys.ay));

        // 名字盒：竖排（middle）用旋转盒测出"以轴线内侧 gap 处为中心"，
        // 横排用 anchor 对齐算左缘 —— 上下栏留白靠它，必须可回归。
        ChartAxis midAxis = Program.AX("middle", false);
        midAxis.title = "yyyy";
        ChartNameBox mb = Chart.AxisNameBoxPx(midAxis, false, Program.PX,
            Program.PY, Program.PW, Program.PH, false, 15, Program.FH,
            Program.CT, 40, 0 - 1);
        Console.WriteLine("box/mid:l=" + Convert.ToString(mb.left) + " r="
            + Convert.ToString(mb.right) + " t=" + Convert.ToString(mb.top)
            + " b=" + Convert.ToString(mb.bottom));
        ChartAxis endAxis = Program.AX("end", false);
        endAxis.title = "yyyy";
        ChartNameBox eb = Chart.AxisNameBoxPx(endAxis, false, Program.PX,
            Program.PY, Program.PW, Program.PH, false, 15, Program.FH,
            Program.CT, 40, 0 - 1);
        Console.WriteLine("box/end:t=" + Convert.ToString(eb.top) + " b="
            + Convert.ToString(eb.bottom));
        ChartAxis xendAxis = Program.AX("end", false);
        xendAxis.title = "xxxx";
        ChartNameBox xb = Chart.AxisNameBoxPx(xendAxis, true, Program.PX,
            Program.PY, Program.PW, Program.PH, false, 15, Program.FH,
            Program.CT, 40, 0 - 1);
        Console.WriteLine("box/xend:l=" + Convert.ToString(xb.left) + " r="
            + Convert.ToString(xb.right) + " t=" + Convert.ToString(xb.top)
            + " b=" + Convert.ToString(xb.bottom));
    }
}
