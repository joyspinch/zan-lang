using System;

class Model {
    public string name;
}

class Host {
    public Binding<string> text;
}

class Program {
    static void Main() {
        Model m = new Model();
        m.name = "冰冰";
        Host h = new Host();
        h.text = m.name;
        Console.WriteLine(h.text.Get());
        m.name = "改后";
        Console.WriteLine(h.text.Get());
        string cur = h.text.Get();
        Console.WriteLine(cur == "改后" ? "get-eq" : "get-bad");

        Binding<int> n = 42;
        Console.WriteLine(n.Get());
        Console.WriteLine(n.Get() == 42 ? "const-eq" : "const-bad");

        Binding<string> b = m.name;
        Console.WriteLine(b.Get());
        m.name = "三改";
        Console.WriteLine(b.Get());

        Console.WriteLine(h.text == null ? "null-eq" : "null-neq");
    }
}
