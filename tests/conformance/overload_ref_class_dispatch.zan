using System;

// Regression guard for irgen concrete_arg_score() FAM_REF overload selection:
// when a class defines unrelated reference-type overloads (e.g. Add(Other) and
// override Add(BaseNode)), passing a derived SubNode must never tie on FAM_REF
// and mis-dispatch to the earlier unrelated Add(Other) overload.
class BaseNode {
    public virtual BaseNode Add(BaseNode child) {
        Console.WriteLine("BaseNode.Add(BaseNode)");
        return child;
    }
}

class SubNode : BaseNode {
    public string label;
    public SubNode(string s) { label = s; }
}

class OtherItem {
    public string text;
    public OtherItem(string s) { text = s; }
}

class Container : BaseNode {
    public void Add(string s) { Console.WriteLine("Add(string):" + s); }
    public void Add(OtherItem o) { Console.WriteLine("Add(OtherItem):" + o.text); }
    public override BaseNode Add(BaseNode child) {
        if (child is SubNode) {
            SubNode sn = (SubNode)child;
            Console.WriteLine("Add(BaseNode):SubNode:" + sn.label);
        } else {
            Console.WriteLine("Add(BaseNode)");
        }
        return child;
    }
}

class Program {
    static void Main() {
        Container c = new Container();
        c.Add("hi");
        c.Add(new OtherItem("item1"));
        c.Add(new SubNode("pane1"));
    }
}
