using System;

class Boom : Exception {
    public Boom(string m) : base(m) { }
}

class Program {
    static void Main() {
        // B-ID199 round3: a bare string throw (tid = null) must MISS every
        // typed catch clause and unwind to the enclosing catch-all. The
        // self-hosted compiler used to let a null tid match the first
        // clause unconditionally, binding the raw string into the clause's
        // variable -- member reads then dereferenced string bytes as an
        // object header (segfault). Host semantics: only an untyped catch
        // can take a string throw.
        try {
            try {
                throw "plain";
            } catch (Boom e) {
                Console.WriteLine("wrong: " + e.Message);
            }
        } catch {
            Console.WriteLine("A:miss-goes-to-catchall");
        }

        // positive control: a typed clause still catches its own class
        try {
            throw new Boom("typed");
        } catch (Boom e) {
            Console.WriteLine("B:" + e.Message);
        }
        Console.WriteLine("done");
    }
}
