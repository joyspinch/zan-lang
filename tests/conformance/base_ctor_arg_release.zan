using System;

/* A `: base(args)` initializer is a call site like any other: the base
 * constructor retains what it stores, so the +1 each argument expression
 * produced belongs to the derived constructor and must be dropped there.
 * It used to be leaked, so every instance of a derived class constructed with
 * a computed rc-managed argument leaked that argument. */
class Tagged {
    public string tag;
    public Tagged(string t) { this.tag = t; }
}

class Counted : Tagged {
    public int code;
    public Counted(int c) : base("tag" + Convert.ToString(c)) { this.code = c; }
}

class Boxed : Tagged {
    public List<string> items;
    public Boxed(List<string> xs, int c) : base("box" + Convert.ToString(c)) {
        this.items = xs;
    }
}

/* three levels: the middle constructor both receives and forwards a computed
 * string, so each level must drop exactly its own temporary */
class Deeper : Counted {
    public string extra;
    public Deeper(int c) : base(c * 2) { this.extra = "x" + Convert.ToString(c); }
}

class Program {
    static void Main() {
        int i = 0;
        while (i < 200) {
            Counted c = new Counted(i);
            Deeper d = new Deeper(i);
            List<string> xs = new List<string>();
            xs.Add("e" + Convert.ToString(i));
            Boxed b = new Boxed(xs, i);
            if (i == 199) {
                Console.WriteLine(c.tag + " " + Convert.ToString(c.code));
                Console.WriteLine(d.tag + " " + Convert.ToString(d.code) + " " + d.extra);
                Console.WriteLine(b.tag + " " + b.items[0]);
            }
            i = i + 1;
        }
        Console.WriteLine("done");
    }
}
