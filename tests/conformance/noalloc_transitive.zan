using System;

interface IHotKernel {
    [NoAlloc]
    int Step(int x);
}

class BaseKernel : IHotKernel {
    [NoAlloc]
    public virtual int Step(int x) {
        return x + 1;
    }
}

class FastKernel : BaseKernel {
    [NoAlloc]
    public override int Step(int x) {
        return BaseStep(x) * 2;
    }

    [NoAlloc]
    static int BaseStep(int x) {
        return x + 10;
    }
}

struct Accumulator {
    public int Total;
    public int Count;
}

class Program {
    [NoRuntime]
    static int BareAdd(int a, int b) {
        return a + b;
    }

    [NoAlloc]
    static int HotHelper(ref Accumulator acc, int delta) {
        acc.Total = BareAdd(acc.Total, delta);
        acc.Count = acc.Count + 1;
        return acc.Total;
    }

    [NoAlloc]
    static int RunNoAllocPipeline(IHotKernel k, int seed) {
        Accumulator acc = new Accumulator();
        acc.Total = 999;
        NativeMemory.ZeroInit(ref acc);
        Span<int> scratch = stackalloc int[4];
        for (int i = 0; i < 4; i++) {
            scratch[i] = k.Step(seed + i);
            HotHelper(ref acc, scratch[i]);
        }
        return acc.Total + acc.Count;
    }

    static int Main() {
        FastKernel fk = new FastKernel();
        IHotKernel ik = fk;
        int r = RunNoAllocPipeline(ik, 5);
        // seed+0..3 = 5,6,7,8 -> BaseStep = 15,16,17,18 -> *2 = 30,32,34,36 -> sum=132, count=4 -> 136
        Console.WriteLine($"r={r}");
        return 0;
    }
}
