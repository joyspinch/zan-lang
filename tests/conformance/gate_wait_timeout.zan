using System;
using System.Diagnostics;
using System.Threading;

class Check {
    static int passed = 0;
    static int failed = 0;

    static void True(bool cond, string what) {
        if (cond) {
            Check.passed = Check.passed + 1;
        } else {
            Check.failed = Check.failed + 1;
            Console.WriteLine("FAIL " + what);
        }
    }
}

class WaitResults {
    public int completed = 0;
    public int succeeded = 0;
}

class Program {
    static async void TimedWait(Gate g, WaitResults results, int ms) {
        bool ok = await g.Wait(ms);
        lock (results) {
            results.completed = results.completed + 1;
            if (ok) { results.succeeded = results.succeeded + 1; }
        }
    }

    static async void Expire(long h, long ticket, int ms) {
        await Task.Delay(ms);
        Gate.zan_gate_ticket_signal_and_release(h, ticket);
    }

    static async void Waker(Gate g, int afterMs) {
        await Task.Delay(afterMs);
        g.Signal();
    }

    static async void Work() {
        Gate silent = new Gate();
        long t0 = ServerMetrics.MonoMillis();
        bool r = await silent.Wait(60);
        long dt = ServerMetrics.MonoMillis() - t0;
        Check.True(r, "timeout wait resumes");
        Check.True(dt >= 40, "timeout wait actually waited");
        Check.True(dt < 5000, "timeout wait ended on its own");

        Gate banked = new Gate();
        banked.Signal();
        long t1 = ServerMetrics.MonoMillis();
        bool r2 = await banked.Wait(60000);
        long dt2 = ServerMetrics.MonoMillis() - t1;
        Check.True(r2, "banked wait resumes");
        Check.True(dt2 < 2000, "banked signal consumed immediately");

        Gate woken = new Gate();
        Task.Spawn(Program.Waker(woken, 20));
        long t3 = ServerMetrics.MonoMillis();
        await woken.Wait(60000);
        long dt3 = ServerMetrics.MonoMillis() - t3;
        Check.True(dt3 < 3000, "signal wakes the waiter early");

        Gate plain = new Gate();
        Task.Spawn(Program.Waker(plain, 15));
        bool r4 = await plain.Wait();
        Check.True(r4, "unbounded wait still works");

        Gate overlap = new Gate();
        WaitResults results = new WaitResults();
        Task.Spawn(Program.TimedWait(overlap, results, 20));
        Task.Spawn(Program.TimedWait(overlap, results, 35));
        int done = 0;
        int okCount = 0;
        long deadline = ServerMetrics.MonoMillis() + 2000;
        while (done < 2 && ServerMetrics.MonoMillis() < deadline) {
            await Task.Delay(5);
            lock (results) {
                done = results.completed;
                okCount = results.succeeded;
            }
        }
        Check.True(done == 2 && okCount == 2, "concurrent timeouts both return true");
        overlap.Close();

        // Two-argument Park must carry the exact arm, including completion
        // before code generation reaches the suspend point.
        Gate explicitTickets = new Gate();
        long h = explicitTickets.Handle();
        long first = Gate.zan_gate_arm(h);
        long second = Gate.zan_gate_arm(h);
        Gate.zan_gate_ticket_signal_and_release(h, second);
        Task.Spawn(Program.Expire(h, first, 15));
        await Gate.Park(h, first);
        await Gate.Park(h, second);
        Check.True(true, "explicit distinct tickets and early timeout resume");
        explicitTickets.Close();
        bool closed = await explicitTickets.Wait(10);
        Check.True(!closed, "closed timed wait returns false");

        silent.Close();
        banked.Close();
        woken.Close();
        plain.Close();
    }

    static void Main() {
        await Program.Work();
        Console.WriteLine("pass: " + Convert.ToString(Check.passed));
        Console.WriteLine("fail: " + Convert.ToString(Check.failed));
    }
}
