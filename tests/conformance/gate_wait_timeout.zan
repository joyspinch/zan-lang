// 接口数据协议与执行契约。
// 核心契约与语义定义。
using System;
using System.Diagnostics;
using System.Threading;

class Check {
    static int passed = 0;
    static int failed = 0;

    static void True(bool cond, string what) {
        if (cond) {
            Check.passed = Check.passed + 1;
        } else {
            Check.failed = Check.failed + 1;
            Console.WriteLine("FAIL " + what);
        }
    }
}

class Program {
    static async void Waker(Gate g, int afterMs) {
        await Task.Delay(afterMs);
        g.Signal();
    }

    static async void Work() {
        // 接口数据协议与执行契约。
        Gate silent = new Gate();
        long t0 = ServerMetrics.MonoMillis();
        bool r = await silent.Wait(60);
        long dt = ServerMetrics.MonoMillis() - t0;
        Check.True(r, "timeout wait resumes");
        Check.True(dt >= 40, "timeout wait actually waited");
        Check.True(dt < 5000, "timeout wait ended on its own");

        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        Gate banked = new Gate();
        banked.Signal();
        long t1 = ServerMetrics.MonoMillis();
        bool r2 = await banked.Wait(60000);
        long dt2 = ServerMetrics.MonoMillis() - t1;
        Check.True(r2, "banked wait resumes");
        Check.True(dt2 < 2000, "banked signal consumed immediately");

        // 接口数据协议与执行契约。
        Gate woken = new Gate();
        Task.Spawn(Program.Waker(woken, 20));
        long t3 = ServerMetrics.MonoMillis();
        await woken.Wait(60000);
        long dt3 = ServerMetrics.MonoMillis() - t3;
        Check.True(dt3 < 3000, "signal wakes the waiter early");

        // 接口数据协议与执行契约。
        // 核心契约与语义定义。
        Gate plain = new Gate();
        Task.Spawn(Program.Waker(plain, 15));
        bool r4 = await plain.Wait();
        Check.True(r4, "unbounded wait still works");
    }

    static void Main() {
        await Program.Work();
        Console.WriteLine("pass: " + Convert.ToString(Check.passed));
        Console.WriteLine("fail: " + Convert.ToString(Check.failed));
    }
}
