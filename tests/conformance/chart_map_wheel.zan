using System;
using Gui.Component.Chart;

namespace Conf;

/// 地图滚轮策略的纯 seam：默认消费滚轮，pass/none 交给外层滚动容器。
class Program {
    static void Main() {
        ChartOption o = ChartOption.Create();
        Console.WriteLine("default:" + o.roamWheelMode);
        o.RoamWheel("pass");
        Console.WriteLine("pass:" + o.roamWheelMode);
        o.RoamWheel("none");
        Console.WriteLine("none:" + o.roamWheelMode);
        o.RoamWheel("bogus");
        Console.WriteLine("bogus:" + o.roamWheelMode);
        Console.WriteLine("sanitize:" + ChartKinds.RoamWheelModeSanitize("zoom")
            + ":" + ChartKinds.RoamWheelModeSanitize("pass")
            + ":" + ChartKinds.RoamWheelModeSanitize("none")
            + ":" + ChartKinds.RoamWheelModeSanitize("bad"));
        ChartOption parsed = ChartOption.FromJson(
            "{\"roamWheelMode\":\"pass\",\"series\":[]}");
        Console.WriteLine("json:" + parsed.roamWheelMode);
        ChartOption cloned = ChartOption.Clone(parsed);
        if (cloned == null) { Console.WriteLine("clone:null"); }
        else { Console.WriteLine("clone:" + cloned.roamWheelMode); }
    }
}
