// 一元 `operator +` 重载：重载是 static 的，一元/二元靠形参个数区分
// （1 个形参是一元，2 个是二元）。使用端写一元正号 `+obj`，编译器必须
// 派发到那个一元重载，而不是把它当成内建算术（对结构体指针做加法）。
struct Vec {
    public int X;
    public Vec(int x) { X = x; }
    public static Vec operator +(Vec v) { return new Vec(v.X + 1); }
}
class Counter {
    public int N;
    public Counter(int n) { N = n; }
    public static Counter operator +(Counter c) { return new Counter(c.N + 1); }
}
class Program {
    static void Main() {
        Vec a = new Vec(5);
        Vec b = +a;
        Console.WriteLine(b.X);          // 6
        Vec c = +new Vec(7);
        Console.WriteLine(c.X);          // 8
        Counter k = new Counter(9);
        Counter m = +k;
        Console.WriteLine(m.N);          // 10
    }
}
