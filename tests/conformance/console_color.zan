using System;

// The console color properties and the window title. The C host keeps the
// current color in two module-level slots and emits the ANSI escape on
// assignment; the golden next to this case carries the raw escape bytes
// (ESC [ <code> m for a color, ESC ] 0 ; <title> BEL for the title).
class Program {
    static void Main() {
        Console.WriteLine(Console.ForegroundColor);
        Console.WriteLine(Console.BackgroundColor);
        Console.ForegroundColor = 3;
        Console.WriteLine(Console.ForegroundColor);
        Console.BackgroundColor = 12;
        Console.WriteLine(Console.BackgroundColor);
        Console.ForegroundColor = 19;
        Console.WriteLine(Console.ForegroundColor);
        Console.Title = "zan-title";
        Console.WriteLine("after-title");
    }
}
