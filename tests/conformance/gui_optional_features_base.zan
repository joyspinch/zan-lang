using System;
using Gui;
using Gui.Widget;

// The same published program retains the public native Create/Run path and a
// deterministic offscreen path. No optional feature entry point is referenced.
class GuiOptionalFeaturesBase {
    static void Check(bool ok) {
        if (!ok) { throw new Exception("base GUI acquired an optional feature"); }
    }

    static void AddControls(Form form) {
        form.Add(new Label("Small retained window"));
        Button close = new Button("Close");
        close.Click.Add(() => form.Close());
        form.Add(close);
    }

    static void RunWindow() {
        Form form = Form.Create("Optional GUI boundary", 320, 180);
        AddControls(form);
        int turns = 0;
        form.FrameHook(() => {
            turns = turns + 1;
            if (turns >= 2) { form.Close(); }
        });
        form.Run();
        App app = form.GetApp();
        app.StopLoop();
        app.window.Destroy();
        app.canvas.Destroy();
    }

    static void Main() {
        Form form = Form.CreateOffscreen("Optional GUI boundary", 320, 180);
        AddControls(form);
        App app = form.GetApp();
        Check(app.ModelHostCount() == 0 && app.AutomationSession() == null);
        Check(app.FrameDiagnostics() == null && !app.HasThemeSettings());
        Check(app.showCloseButton && app.showMinimizeButton && app.showMaximizeButton);
        form.CaptureSnapshot();
        Check(app.ModelHostCount() == 0 && app.AutomationSession() == null);
        app.StopLoop();
        app.canvas.Destroy();
        if (Environment.GetEnvironmentVariable("ZAN_GUI_OPTIONAL_WINDOW") == "1") { RunWindow(); }
        Console.WriteLine("GUI_OPTIONAL_FEATURES_BASE_OK");
    }
}
