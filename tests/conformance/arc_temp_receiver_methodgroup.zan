// ARC：绑定实例方法组时，接收者临时量必须释放。`new Job(i).Run` 生成的
// 闭包记录 retain 了 receiver（记录第三槽），但调用点若不再释放
// `new Job(i)` 自己的 +1，每个这样的表达式就泄漏一个 Job（20000 次调用
// 可见的对象数恒定 20000）。本用例验证功能正确；泄漏回归与 ARC 穿越回归
// 由同一条 case_arc_temp_receiver_methodgroup 用例守住（--check-leaks 退出
// 时任何 rc 对象仍可达即失败；--arc-guard 把释放块隔离，让"提前释放后被引用"
// 立即暴露）。
using System;

namespace Prog;

class Job {
    public int n;
    public Job(int x) { n = x; }
    public void Run() { Prog.sum = Prog.sum + this.n; }
}

class Prog {
    public static long sum;

    static void Main() {
        Prog.sum = 0;
        for (int i = 0; i < 20000; i = i + 1) {
            // 接收者是临时量：闭包持有它，调用点也必须放掉自己那一份。
            Action a = new Job(i).Run;
            a();
        }
        // 0 + 1 + ... + 19999 = 199990000
        Console.WriteLine("ok " + Convert.ToString(Prog.sum));
    }
}
