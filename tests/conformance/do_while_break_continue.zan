using System;

/* 底层系统交互与数据协议契约 */
class Program {
    static void Main() {
        int n = 0;
        do {
            n = n + 1;
            if (n == 3) { break; }
        } while (n < 100);
        Console.WriteLine("brk=" + Convert.ToString(n));

        int sum = 0;
        int i = 0;
        do {
            i = i + 1;
            if (i == 4) { continue; }
            sum = sum + i;
        } while (i < 6);
        Console.WriteLine("cont=" + Convert.ToString(sum));

        /* 底层系统交互与数据协议契约 */
        int outer = 0;
        do {
            outer = outer + 1;
            for (int k = 0; k < 10; k = k + 1) {
                if (k == 2) { break; }
            }
        } while (outer < 100);
        Console.WriteLine("outer=" + Convert.ToString(outer));
    }
}
