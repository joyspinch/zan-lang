using System;

/* break/continue inside a do-while body. The do-while emitter never
 * registered the loop's break/continue targets, so `break` silently fell
 * through (infinite loop, or a stale outer-loop target exited the wrong
 * loop) and `continue` re-ran the body instead of re-testing the condition.
 * continue in a do-while re-tests the condition: 4 is skipped but still
 * re-checked. */
class Program {
    static void Main() {
        int n = 0;
        do {
            n = n + 1;
            if (n == 3) { break; }
        } while (n < 100);
        Console.WriteLine("brk=" + Convert.ToString(n));

        int sum = 0;
        int i = 0;
        do {
            i = i + 1;
            if (i == 4) { continue; }
            sum = sum + i;
        } while (i < 6);
        Console.WriteLine("cont=" + Convert.ToString(sum));

        /* break with a nested loop inside: must exit the do-while only */
        int outer = 0;
        do {
            outer = outer + 1;
            for (int k = 0; k < 10; k = k + 1) {
                if (k == 2) { break; }
            }
        } while (outer < 100);
        Console.WriteLine("outer=" + Convert.ToString(outer));
    }
}
