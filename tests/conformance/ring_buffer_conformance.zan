using System;
using System.Collections.Generic;

class Program {
    static void Main() {
        Console.WriteLine("[1] Testing RingBuffer capacity power-of-two alignment...");
        RingBuffer<int> rb = RingBuffer<int>.Create(5);
        Console.WriteLine("Capacity: " + Convert.ToString(rb.Capacity));
        Console.WriteLine("Initial count: " + Convert.ToString(rb.Count));
        Console.WriteLine("Initial IsEmpty: " + (rb.IsEmpty ? "true" : "false"));

        Console.WriteLine("[2] Testing sequential writes...");
        for (int i = 1; i <= 7; i = i + 1) {
            bool ok = rb.TryWrite(i * 10);
            if (!ok) {
                Console.WriteLine("FAIL: write failed at " + Convert.ToString(i));
            }
        }
        Console.WriteLine("Count after writes: " + Convert.ToString(rb.Count));
        Console.WriteLine("IsFull: " + (rb.IsFull ? "true" : "false"));

        bool overflowOk = rb.TryWrite(888);
        Console.WriteLine("Write on full rejected: " + (!overflowOk ? "true" : "false"));

        Console.WriteLine("[3] Testing sequential reads & peek...");
        int peekVal;
        if (rb.TryPeek(out peekVal)) {
            Console.WriteLine("Peek value: " + Convert.ToString(peekVal));
        }

        int readVal;
        while (rb.TryRead(out readVal)) {
            Console.WriteLine("read: " + Convert.ToString(readVal));
        }

        Console.WriteLine("Count after draining: " + Convert.ToString(rb.Count));
        Console.WriteLine("IsEmpty after draining: " + (rb.IsEmpty ? "true" : "false"));

        Console.WriteLine("OK: all ring buffer checks passed!");
    }
}
