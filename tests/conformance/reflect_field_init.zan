// 反射构造器字段初始化器契约测试（B-ID158）：
// 验证无显式构造函数类及派生类在 TypeInfo.CreateInstance() 路径下，
// 继承链各层字段初始化器均按顺序正确执行，类型下转成立，且 ARC 零泄漏。
// golden: REFLECT_FIELD_INIT_OK
using System;
using System.Collections.Generic;

class Item {
    public string val;
    public Item(string v) { val = v; }
}

class BaseNoCtor {
    public int baseN = 100;
    public string baseS = "base_str";
    public Item baseItem = new Item("base_item");
}

class DerivedNoCtor : BaseNoCtor {
    public int derN = 200;
    public string derS = "der_str";
    public List<string> list = new List<string>();
}

class BaseWithCtor {
    public int baseA = 10;
    public string baseB = "init_b";
    public BaseWithCtor() {
        baseB = baseB + "_ctor";
    }
}

class DerivedWithCtor : BaseWithCtor {
    public int derA = 20;
    public string derB = "init_db";
    public DerivedWithCtor() {
        derB = derB + "_ctor";
    }
}

class Program {
    static int fails;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got + "' want '" + want + "'");
    }

    static void Main() {
        fails = 0;

        // 1. 无显式构造函数：继承链字段初始化器均执行
        object o1 = typeof(DerivedNoCtor).CreateInstance();
        DerivedNoCtor d1 = (DerivedNoCtor)o1;
        Eq("d1.baseN", Convert.ToString(d1.baseN), "100");
        Eq("d1.baseS", d1.baseS, "base_str");
        Eq("d1.baseItem", d1.baseItem != null ? d1.baseItem.val : "null", "base_item");
        Eq("d1.derN", Convert.ToString(d1.derN), "200");
        Eq("d1.derS", d1.derS, "der_str");
        Eq("d1.list", d1.list != null ? "list" : "null", "list");

        // 2. 有显式构造函数：字段初始化器先于构造体执行
        object o2 = typeof(DerivedWithCtor).CreateInstance();
        DerivedWithCtor d2 = (DerivedWithCtor)o2;
        Eq("d2.baseA", Convert.ToString(d2.baseA), "10");
        Eq("d2.baseB", d2.baseB, "init_b_ctor");
        Eq("d2.derA", Convert.ToString(d2.derA), "20");
        Eq("d2.derB", d2.derB, "init_db_ctor");

        if (fails == 0) {
            Console.WriteLine("REFLECT_FIELD_INIT_OK");
        }
    }
}
