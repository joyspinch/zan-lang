using System;

namespace Conformance;

class SetterTarget {
    int value;
    public int Value { get { return value; } set { this.value = value; } }
}

class SetterOwner {
    SetterTarget target;
    public SetterOwner() { this.target = new SetterTarget(); }
    public SetterTarget Child { get { return this.target; } }
    public SetterTarget GetChild() { return this.target; }
}

class Program {
    static void Main() {
        SetterOwner owner = new SetterOwner();
        // The owner field remains the only persistent owner of the receiver.
        // Each getter/method result supplies one temporary reference to the setter.
        owner.Child.Value = 42;
        if (owner.Child.Value != 42) {
            throw new Exception("Property receiver lost its owner after setter");
        }
        owner.GetChild().Value = 73;
        if (owner.Child.Value != 73) {
            throw new Exception("Call receiver lost its owner after setter");
        }
        owner.Child.Value = 19;
        if (owner.GetChild().Value != 19) {
            throw new Exception("Repeated setter receiver ownership mismatch");
        }
        Console.WriteLine("ARC_PROPERTY_SETTER_TEMP_RECEIVER_OK");
    }
}
