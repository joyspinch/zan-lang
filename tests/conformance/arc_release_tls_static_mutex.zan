using System;
using System.Threading;

class ReleaseNode { public int Value; }

class Program {
    // Mutex.Create releases a PAL receiver during static initialization,
    // before Main. That release must read the current thread's TLS depth.
    static Mutex gate = new Mutex();
    static void ReleaseChild() {
        ReleaseNode node = new ReleaseNode();
        node.Value = 7;
        if (node.Value != 7) throw new Exception("node value");
    }
    static void Main() {
        gate.WaitOne();
        ReleaseChild();
        gate.ReleaseMutex();
        gate.Dispose();
        Console.WriteLine("ARC_RELEASE_TLS_STATIC_MUTEX_OK");
    }
}
