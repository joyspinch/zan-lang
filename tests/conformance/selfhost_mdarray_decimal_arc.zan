using System;

class MdDecimalOwner {
    public decimal[,] Matrix;
    public decimal[,,] Cube;
}

class SelfhostMdarrayDecimalArc {
    static decimal[,] Saved;
    static decimal[,] Echo(decimal[,] value) { return value; }
    static decimal[,,] EchoCube(decimal[,,] value) { return value; }

    static void CheckAliases(decimal[,] matrix, decimal[,,] cube, decimal exact) {
        decimal[,] first = Echo(matrix);
        decimal[,] second = Echo(first);
        decimal[,,] other = EchoCube(cube);
        Console.WriteLine(second.GetLength(1) == 2);
        Console.WriteLine(second[1,1] == exact);
        Console.WriteLine(other.GetLength(2) == 2);
        Console.WriteLine(other[1,1,1] == -exact);
        MdDecimalOwner holder = new MdDecimalOwner();
        holder.Matrix = second;
        holder.Cube = other;
        Console.WriteLine(holder.Matrix[1,1] == exact);
        Console.WriteLine(holder.Cube[1,1,1] == -exact);
    }

    static async Task CheckAsync(decimal[,] matrix, decimal[,,] cube, decimal exact) {
        decimal[,] missing = null;
        decimal[,,] absent = null;
        await Task.Yield();
        Console.WriteLine(Echo(missing) == null);
        Console.WriteLine(EchoCube(absent) == null);
        CheckAliases(matrix, cube, exact);
    }

    static void Main() {
        decimal exact = 9007199254740993m;
        decimal[,] matrix = new decimal[2,2];
        decimal[,,] cube = new decimal[2,2,2];
        matrix[1,1] = exact;
        cube[1,1,1] = -exact;
        Saved = matrix;
        CheckAliases(matrix, cube, exact);
        CheckAliases(matrix, cube, exact);
        Console.WriteLine(Saved[1,1] == exact);
        await CheckAsync(matrix, cube, exact);
        Console.WriteLine(matrix[1,1] == exact);
        Console.WriteLine(cube[1,1,1] == -exact);
    }
}
