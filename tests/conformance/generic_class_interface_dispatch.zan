using System;
using System.Collections.Generic;

namespace Conf;

class DummyEnum : IEnumerator<int> {
    public bool MoveNext() { return false; }
    public int Current() { return 0; }
}

class BoxEnum<T> : IEnumerator<T> {
    T[] items;
    int pos;
    public BoxEnum(T[] src) { items = src; pos = -1; }
    public bool MoveNext() {
        if (pos + 1 >= items.Length) { return false; }
        pos = pos + 1;
        return true;
    }
    public T Current() { return items[pos]; }
}

class Box<T> : IEnumerable<T> {
    T[] items;
    public Box(T[] src) { items = src; }
    public IEnumerator<T> GetEnumerator() {
        return new BoxEnum<T>(items);
    }
}

class Prog {
    static int Take(IEnumerator<int> e) {
        int count = 0;
        while (e.MoveNext()) {
            count = count + e.Current();
        }
        return count;
    }

    static void Main() {
        DummyEnum d = new DummyEnum();
        Box<int> b = new Box<int>(new int[] { 10, 20, 30 });
        int res = Take(b.GetEnumerator());
        Console.WriteLine(Convert.ToString(res));
    }
}
