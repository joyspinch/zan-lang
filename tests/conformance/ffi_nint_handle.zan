using System;

/// Handles crossing the FFI boundary must keep their full pointer width: they
/// are declared `nint`, stored in `nint` fields and locals, and handed back to
/// the C library unchanged. `int` must not be used to carry them -- that is
/// exactly what silently truncates once `int` is 32-bit.
class Handle {
    nint fp;
}

class T {
    [DllImport("crt")] static extern nint fopen(string path, string mode);
    [DllImport("crt")] static extern int fputs(string s, nint fp);
    [DllImport("crt")] static extern int fclose(nint fp);
    [DllImport("crt")] static extern int fgetc(nint fp);
    [DllImport("crt")] static extern int remove(string path);
    [DllImport("crt")] static extern nint malloc(int n);
    [DllImport("crt")] static extern void free(nint p);

    static nint Pass(nint h) { return h; }

    static void Main() {
        string path = "_nint_handle.tmp";
        Handle w = new Handle();
        w.fp = fopen(path, "wb");
        Console.WriteLine("open=" + (w.fp != 0));
        fputs("ok", w.fp);
        Console.WriteLine("close=" + fclose(w.fp));

        nint r = fopen(path, "rb");
        Console.WriteLine("roundtrip=" + (Pass(r) == r));
        Console.WriteLine("c0=" + fgetc(r));
        Console.WriteLine("c1=" + fgetc(Pass(r)));
        fclose(r);
        remove(path);

        nint p = malloc(16);
        nint q = p;
        Console.WriteLine("alias=" + (q == p));
        Console.WriteLine("nonzero=" + (p != 0));
        free(p);
    }
}
