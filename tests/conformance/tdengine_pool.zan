using System;
using System.Data;
using System.Data.TDengine;
using System.Net.Sockets;

// 测试断言与状态转移验证。
// 核心契约与执行状态转移规范。

class Fake {
    static int PORT = 9509;
    static int served = 0;      // statements answered
    static int inFlight = 0;    // requests being handled right now
    static int peak = 0;        // high-water mark of inFlight

    static string Body(string sql) {
        if (sql.Contains("SERVER_VERSION")) {
            return "{\"code\":0,\"column_meta\":[[\"server_version()\",\"VARCHAR\",7]],"
                + "\"data\":[[\"3.2.1.0\"]],\"rows\":1}";
        }
        if (sql.StartsWith("INSERT")) {
            return "{\"code\":0,\"column_meta\":[[\"affected_rows\",\"INT\",4]],"
                + "\"data\":[[3]],\"rows\":1}";
        }
        return "{\"code\":0,\"column_meta\":[[\"ts\",\"TIMESTAMP\",8],[\"v\",\"INT\",4]],"
            + "\"data\":[[\"2024-01-01 00:00:00.000\",7]],\"rows\":1}";
    }

    // 测试断言与状态转移验证。
    static async void Serve(nint client) {
        string req = await AsyncSocket.Receive(client, 65536);
        Fake.inFlight = Fake.inFlight + 1;
        if (Fake.inFlight > Fake.peak) {
            Fake.peak = Fake.inFlight;
        }
        int cut = req.IndexOf("\r\n\r\n");
        string sql = "";
        if (cut >= 0) {
            sql = req.Substring(cut + 4, req.Length - cut - 4);
        }
        await Task.Delay(15);
        string body = Fake.Body(sql);
        string resp = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n"
            + "Content-Length: " + Convert.ToString(body.Length)
            + "\r\nConnection: close\r\n\r\n" + body;
        int sent = await AsyncSocket.SendString(client, resp);
        Fake.inFlight = Fake.inFlight - 1;
        Fake.served = Fake.served + 1;
        Socket.Close(client);
    }

    // 测试断言与状态转移验证。
    static async void Accept(nint listener, int count) {
        for (int n = 0; n < count; n = n + 1) {
            nint client = await AsyncSocket.Accept(listener);
            Socket.SetNonBlocking(client);
            Task.Spawn(Fake.Serve(client));
        }
        Socket.Close(listener);
    }

    static nint Listen() {
        nint listener = Socket.CreateTcp();
        Socket.SetReuseAddr(listener);
        Socket.Bind(listener, "127.0.0.1", Fake.PORT);
        Socket.Listen(listener, 16);
        Socket.SetNonBlocking(listener);
        return listener;
    }
}

class Program {
    static int passed = 0;
    static int failed = 0;
    static int done = 0;

    static void Check(string name, bool ok) {
        if (ok) {
            Program.passed = Program.passed + 1;
        } else {
            Program.failed = Program.failed + 1;
            Console.WriteLine("FAIL: " + name);
        }
    }

    // 测试断言与状态转移验证。
    static async void Worker(TDenginePool pool) {
        TDengineConnection db = await pool.AcquireAsync();
        if (db == null) {
            Program.done = Program.done + 1;
            return;
        }
        DbResult r = await db.QueryAsync("SELECT ts, v FROM meters LIMIT 1");
        if (r.RowCount() == 1 && r.GetInt(0, 1) == 7) {
            Program.done = Program.done + 1;
        }
        pool.Release(db);
    }

    static async void Run() {
        // 测试断言与状态转移验证。
        nint listener = Fake.Listen();
        Task.Spawn(Fake.Accept(listener, 10));

        TDengineConnection db = await TDengineConnection.OpenAsync(
            "127.0.0.1", Fake.PORT, "root", "taosdata", "power");
        Program.Check("async open validates against the server", db.IsConnected());

        DbResult r = await db.QueryAsync("SELECT ts, v FROM meters LIMIT 1");
        Program.Check("async query decodes column_meta", r.ColumnCount() == 2);
        Program.Check("async query decodes rows", r.RowCount() == 1);
        Program.Check("async query decodes values", r.GetInt(0, 1) == 7);

        int n = await db.ExecuteAsync("INSERT INTO meters VALUES (NOW, ?)",
                                      new DbParams().AddInt(1));
        Program.Check("async execute reports affected rows", n == 3);

        string v = await db.ExecuteScalarAsync("SELECT SERVER_VERSION()");
        Program.Check("async scalar", v == "3.2.1.0");
        db.Close();

        // 测试断言与状态转移验证。
        // 核心契约与语义定义。
        TDenginePool pool = new TDenginePool("127.0.0.1", Fake.PORT, "root",
                                                "taosdata", "", "power", 2);
        Program.Check("pool max size", pool.MaxSize() == 2);
        Fake.peak = 0;
        for (int i = 0; i < 4; i = i + 1) {
            Task.Spawn(Program.Worker(pool));
        }
        while (Program.done < 4) {
            await Task.Delay(5);
        }
        Program.Check("every pooled worker finished", Program.done == 4);
        Program.Check("pool never exceeds its size", pool.LiveCount() <= 2);
        Program.Check("statements really overlap", Fake.peak >= 2);
        Program.Check("connections are reused", pool.IdleCount() == 2);
        Program.Check("no waiters left", pool.WaitingCount() == 0);

        pool.Close();
        Program.Check("close drains the pool", pool.IdleCount() == 0);
        Program.Check("close drops the live count", pool.LiveCount() == 0);
        TDengineConnection dead = await pool.AcquireAsync();
        Program.Check("acquire on a closed pool yields null", dead == null);

    }

    static void Main() {
        Socket.Initialize();
        await Program.Run();
        Console.WriteLine("pass: " + Convert.ToString(Program.passed));
        Console.WriteLine("fail: " + Convert.ToString(Program.failed));
    }
}
