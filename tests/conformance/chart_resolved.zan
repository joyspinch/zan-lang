using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static void Main() {
        int itemColor = Chart.Rgb(1, 2, 3);
        int seriesColor = Chart.Rgb(4, 5, 6);
        int dataColor = Chart.Rgb(7, 8, 9);

        ChartSeries inherited = ChartSeries.Line("Inherited", new List<int>{10});
        inherited.itemStyle.normal.color = itemColor;
        inherited.itemStyle.normal.lineStyle.width = 4;
        inherited.hidden = true;

        ChartSeries explicit = ChartSeries.Line("Explicit", new List<int>{20});
        explicit.color = seriesColor;
        explicit.itemStyle.normal.color = itemColor;
        explicit.data[0].color = dataColor;

        ChartSeries automatic = ChartSeries.Line("Automatic", new List<int>{30});
        ChartOption option = ChartOption.Of("Resolved", new List<string>{"A"},
            new List<ChartSeries>{inherited, explicit, automatic});
        option.iwid = 9;
        option.animate = true;

        ResolvedChart resolved = ResolvedChart.Resolve(option, Theme.Light(), null, 77);
        Console.WriteLine(Convert.ToString(resolved.series[0].color == itemColor)
            + ":" + Convert.ToString(resolved.series[1].color == seriesColor)
            + ":" + Convert.ToString(resolved.series[2].color == Chart.Palette(Theme.Light(), 2)));
        Console.WriteLine(Convert.ToString(resolved.series[1].DataColor(0) == dataColor)
            + ":" + Convert.ToString(resolved.series[0].lineColor == itemColor)
            + ":" + Convert.ToString(resolved.series[0].lineWidth));
        Console.WriteLine("legendColor:" + Convert.ToString(
            Chart.SeriesPaintColor(inherited, Theme.Light(), 0) == itemColor)
            + ":" + Convert.ToString(
            Chart.SeriesPaintColor(explicit, Theme.Light(), 1) == seriesColor)
            + ":" + Convert.ToString(
            Chart.SeriesPaintColor(automatic, Theme.Light(), 2) == Chart.Palette(Theme.Light(), 2)));

        ChartOption draw = resolved.DrawOption(77, false);
        draw.series[0].color = Chart.Rgb(90, 90, 90);
        draw.series[0].hidden = false;
        draw.animate = false;
        draw.iwid = 88;
        Console.WriteLine(Convert.ToString(inherited.color)
            + ":" + Convert.ToString(inherited.hidden)
            + ":" + Convert.ToString(option.animate)
            + ":" + Convert.ToString(option.iwid));

        ChartOption json = ChartOption.FromJson(
            "{\"series\":[{\"name\":\"Json\",\"type\":\"line\",\"itemStyle\":{\"normal\":{\"color\":\"#112233\"}},\"data\":[1]}]}");
        ChartController controller = ChartController.Of(json);
        ResolvedChart fromController = ResolvedChart.Resolve(
            controller.Option(), Theme.Dark(), null, 12);
        Console.WriteLine(Convert.ToString(fromController.series[0].color)
            + ":" + Convert.ToString(json.series[0].color)
            + ":" + Convert.ToString(controller.Version()));

        // 阶段六：emphasis paint —— 命中取强调色，未设置时回退
        // normal，普通状态始终用解析色，源系列永不被改写。
        int emphColor = Chart.Rgb(11, 12, 13);
        int emphBorder = Chart.Rgb(21, 22, 23);
        ChartSeries emph = ChartSeries.Line("Emph", new List<int>{50});
        emph.itemStyle.normal.color = itemColor;
        emph.itemStyle.emphasis.color = emphColor;
        emph.itemStyle.emphasis.borderColor = emphBorder;
        emph.itemStyle.emphasis.borderWidth = 3;
        ChartOption emphOpt = ChartOption.Of("Emph", new List<string>{"A"},
            new List<ChartSeries>{emph});
        ResolvedChart emphChart = ResolvedChart.Resolve(emphOpt, Theme.Light(), null, 78);
        ResolvedSeries re = emphChart.series[0];
        Console.WriteLine("emph:" + Convert.ToString(re.EffectiveColor(false) == itemColor)
            + ":" + Convert.ToString(re.EffectiveColor(true) == emphColor)
            + ":" + Convert.ToString(re.EffectiveBorderWidth(true))
            + ":" + Convert.ToString(re.EffectiveBorderWidth(false))
            + ":" + Convert.ToString(re.EffectiveBorderColor(true) == emphBorder)
            + ":" + Convert.ToString(emph.itemStyle.emphasis.color == emphColor));
    }
}
