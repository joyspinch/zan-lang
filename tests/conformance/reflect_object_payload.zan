// An `object` slot holds any payload: a class instance, a heap string, a
// one-dimensional array, or a rectangular array. `GetType()` and `is` must
// classify all four. The second header word of a string is the string tag (with
// the cached byte length) and of an array is the array magic (or, for a
// rectangular array, the rank) -- none of them is a type descriptor, so a
// build whose default descriptor layout dereferences that word as a pointer
// crashes on every one of these. check-leaks mode range-checks the word and
// survives, so this case is what pins the two modes together.
using System;

class Box {
    public int W;
    public Box(int x) { W = x; }
    public int Area() { return W * W; }
}

class Program {
    static void Main() {
        object box = new Box(9);
        Console.WriteLine(box.GetType().Name);
        Console.WriteLine(box.InvokeInt("Area"));

        object s = "lit" + "eral";
        Console.WriteLine(s is string);
        Console.WriteLine(s is Box);

        object arr = new int[4];
        Console.WriteLine(arr.GetType().Name);
        Console.WriteLine(arr is string);

        object md = new int[2, 3];
        Console.WriteLine(md.GetType().Name);
        Console.WriteLine(md is string);
        Console.WriteLine(md is int[]);
    }
}
