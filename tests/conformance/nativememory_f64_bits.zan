// B-ID46：NativeMemory.AsI64/AsF64（double ⇄ i64 位型 bitcast）。
// 钉死位型语义：常规值精确（含 0.1 的 1-ULP 四舍五入位）、±0 各归各位、
// ±∞/quiet NaN 原位往返、最小/次小次正规位型 1/2。期望值来自 IEEE-754
// 真值（python struct），不是程序自证。
using System;

class F64Bits {
    static void Main() {
        // 常规值：0.1 的位型以 0x...9A 结尾（旧手工截断实现差 1 ULP）
        Console.WriteLine(NativeMemory.AsI64(1.0));
        Console.WriteLine(NativeMemory.AsI64(-2.0));
        Console.WriteLine(NativeMemory.AsI64(0.1));
        // ±0：-0.0 经变量取负（防常量折叠），位型必须是 0x8000...
        double z = 0.0;
        Console.WriteLine(NativeMemory.AsI64(-z));
        Console.WriteLine(NativeMemory.AsI64(z));
        // ±∞ 位型往返原位保留
        double pinf = NativeMemory.AsF64(9218868437227405312L);
        double ninf = NativeMemory.AsF64(-4503599627370496L);
        Console.WriteLine(NativeMemory.AsI64(pinf));
        Console.WriteLine(NativeMemory.AsI64(ninf));
        // NaN → quiet 位型
        double nan = NativeMemory.AsF64(9221120237041090560L);
        Console.WriteLine(NativeMemory.AsI64(nan));
        // 次正规：位型 1/2 原位往返；4.9e-324 字面量直接编回 1
        Console.WriteLine(NativeMemory.AsI64(NativeMemory.AsF64(1L)));
        Console.WriteLine(NativeMemory.AsI64(NativeMemory.AsF64(2L)));
        Console.WriteLine(NativeMemory.AsI64(4.9e-324));
        // 值域 roundtrip
        double pi = 3.141592653589793;
        Console.WriteLine(NativeMemory.AsF64(NativeMemory.AsI64(pi)) == pi);
        Console.WriteLine(NativeMemory.AsI64(
            NativeMemory.AsF64(-4611686018427387904L)) == -4611686018427387904L);
    }
}
