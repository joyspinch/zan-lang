using System;
using System.Collections.Generic;
using System.Csv;
using Gui.Hmi;
using System.Protobuf;

class Program {
    static void Main() {
        Console.WriteLine("=== INDUSTRIAL, CSV & PROTOBUF VISIBILITY HARDENING TEST ===");

        // 1. Csv & CsvTable
        Console.WriteLine("-- 1. CSV --");
        string csvData = "id,name,value\r\n1,sensor_temp,25.4\r\n2,sensor_press,101.3\r\n";
        CsvTable table = Csv.Parse(csvData);
        Console.WriteLine("CSV header count: " + Convert.ToString(table.header.Count));
        Console.WriteLine("CSV row count: " + Convert.ToString(table.RowCount()));
        List<string> colNames = table.Column("name");
        Console.WriteLine("CSV col[0]: " + colNames[0]);
        Console.WriteLine("CSV col[1]: " + colNames[1]);

        // 2. Industrial HMI Tags, AlarmBuffer & Models
        Console.WriteLine("-- 2. Industrial HMI --");
        TagTable tagTable = new TagTable();
        IoTag t1 = tagTable.Add("TANK_LEVEL", "m", 10);
        t1.SetRaw(45); // 4.5m
        Console.WriteLine("Tag name: " + t1.Name());
        Console.WriteLine("Tag raw: " + Convert.ToString(t1.Raw()));

        AlarmBuffer alarmBuf = new AlarmBuffer();
        AlarmItem item = new AlarmItem("TANK_LEVEL", "High level alarm warning", 1);
        alarmBuf.items.Add(item);
        Console.WriteLine("Alarm count: " + Convert.ToString(alarmBuf.Count()));
        Console.WriteLine("Alarm unacked: " + Convert.ToString(alarmBuf.UnackedCount()));
        Console.WriteLine("Alarm level: " + AlarmItem.LevelOf(item.Priority()));
        item.Ack();
        Console.WriteLine("Alarm unacked after Ack: " + Convert.ToString(alarmBuf.UnackedCount()));

        TrendPen pen = new TrendPen("Pen1", t1, 16711680, 100);
        Console.WriteLine("Pen title: " + pen.Title());

        DeviceCardRow cardRow = DeviceCardRow.Of("MainPump", t1);
        Console.WriteLine("CardRow name: " + cardRow.name);

        // 3. Protobuf Wire Writer & Reader
        Console.WriteLine("-- 3. Protobuf --");
        ProtoWriter writer = new ProtoWriter();
        writer.WriteInt32(1, 1001);
        writer.WriteString(2, "ZanEngine");
        writer.WriteBool(3, true);
        byte[] protoBytes = writer.ToBytes();
        Console.WriteLine("Proto encoded bytes: " + Convert.ToString(protoBytes.Length));

        ProtoReader reader = new ProtoReader(protoBytes);
        while (reader.Next()) {
            int field = reader.FieldNumber();
            int wire = reader.WireType();
            if (field == 1) {
                Console.WriteLine("Field 1 (int32): " + Convert.ToString(reader.ReadInt32()));
            } else if (field == 2) {
                Console.WriteLine("Field 2 (string): " + reader.ReadString());
            } else if (field == 3) {
                Console.WriteLine("Field 3 (bool): " + Convert.ToString(reader.ReadBool()));
            }
        }

        Console.WriteLine("ALL INDUSTRIAL, CSV & PROTOBUF HARDENING CHECKS PASSED!");
    }
}
