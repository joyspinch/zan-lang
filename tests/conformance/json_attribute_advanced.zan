using System;
using System.Json;

class UserConfig {
    [JsonProperty("user_role")]
    [JsonDefault("viewer")]
    public string role;

    [JsonDefault(10)]
    public int retryCount;

    [JsonDefault(true)]
    public bool isEnabled;

    [JsonDefault(95.5)]
    public double rating;
}

class AuthRequest {
    [JsonProperty("auth_token")]
    [JsonRequired]
    public string token;

    [JsonDefault("user")]
    public string scope;
}

class Program {
    static void Main() {
        // Test 1: JsonDefault with missing fields in JSON
        string emptyJson = "{}";
        UserConfig cfg = Json.Deserialize<UserConfig>(emptyJson);
        Console.WriteLine("role=" + cfg.role);
        Console.WriteLine("retry=" + Convert.ToString(cfg.retryCount));
        Console.WriteLine("enabled=" + (cfg.isEnabled ? "1" : "0"));
        Console.WriteLine("rating=" + Convert.ToString((int)cfg.rating));

        // Test 2: JsonDefault overridden when JSON contains explicit value
        string customJson = "{\"user_role\":\"admin\",\"retryCount\":3,\"isEnabled\":false,\"rating\":80.0}";
        UserConfig cfg2 = Json.Deserialize<UserConfig>(customJson);
        Console.WriteLine("role2=" + cfg2.role);
        Console.WriteLine("retry2=" + Convert.ToString(cfg2.retryCount));
        Console.WriteLine("enabled2=" + (cfg2.isEnabled ? "1" : "0"));

        // Test 3: JsonRequired missing throws exception
        bool caught = false;
        try {
            AuthRequest reqFail = Json.Deserialize<AuthRequest>("{\"scope\":\"admin\"}");
        } catch (Exception ex) {
            caught = true;
        }
        Console.WriteLine("missing_required_caught=" + (caught ? "1" : "0"));

        // Test 4: JsonRequired provided succeeds
        AuthRequest reqOk = Json.Deserialize<AuthRequest>("{\"auth_token\":\"secret_xyz\"}");
        Console.WriteLine("token=" + reqOk.token);
        Console.WriteLine("scope=" + reqOk.scope);
    }
}
