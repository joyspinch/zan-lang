using System;
using System.Collections.Generic;
using Gui.Component.WebView;
using Gui.Component.CefBrowser;

namespace Tests.BrowserContainerHardening;

class Program {
    static void Main() {
        Console.WriteLine("=== Testing Browser Container Hardening ===");

        // 1. WebView2 Utilities
        string host = WebView2.HostOf("https://user.example.com:8443/a/b?q=1");
        Console.WriteLine("wv_host=" + host);
        bool safeChar = WebView2.IsSafeChar('a');
        Console.WriteLine("wv_safe=" + Convert.ToString(safeChar));
        string quoted = WebView2.JsQuote("zan'test");
        Console.WriteLine("wv_quoted_valid=" + Convert.ToString(quoted.Length > 0));
        string shim = WebView2.ShimScript("zan");
        Console.WriteLine("wv_shim_valid=" + Convert.ToString(shim.Length > 0));
        string deferred = WebView2.DeferToDomReady("window.x=1;");
        Console.WriteLine("wv_deferred_valid=" + Convert.ToString(deferred.Length > 0));

        // 2. WebCookie
        WebCookie cookie = new WebCookie("sid", "abc123xyz", "example.com", "/");
        cookie.isSecure = true;
        Console.WriteLine("cookie=" + cookie.name + "=" + cookie.value + ";domain=" + cookie.domain + ";secure=" + Convert.ToString(cookie.isSecure));

        // 3. WvResponseContext
        WvResponseContext resp = new WvResponseContext(1, 100, "https://example.com/api", 200, (nint)0);
        Console.WriteLine("resp_status=" + Convert.ToString(resp.status));
        Console.WriteLine("resp_url=" + resp.url);

        // 4. WebViewHandlerEntry
        WebViewHandlerEntry handler = new WebViewHandlerEntry("apiChannel", "shim_01");
        Console.WriteLine("handler_entry=" + handler.name + ":" + handler.shimId);

        // 5. WebView Lifecycle & Dispose
        WebView wv = new WebView("profile_test");
        Console.WriteLine("wv_profile=" + wv.ProfileId());
        Console.WriteLine("wv_handle=" + Convert.ToString(wv.handle));
        wv.Dispose();
        Console.WriteLine("wv_disposed=true");

        // 6. CefOptions
        CefOptions opts = new CefOptions();
        opts.switches = "disable-gpu";
        opts.locale = "zh-CN";
        Console.WriteLine("cef_switches=" + opts.switches);
        Console.WriteLine("cef_locale=" + opts.locale);

        // 7. CefBrowser Lifecycle & Dispose
        CefBrowser cef = new CefBrowser();
        cef.BlockPopups();
        Console.WriteLine("cef_handle=" + Convert.ToString(cef.Handle()));
        cef.Dispose();
        Console.WriteLine("cef_disposed=true");

        // 8. CefFingerprint
        CefFingerprint fp = new CefFingerprint(null);
        fp.userAgent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64)";
        fp.platform = "Win32";
        fp.screenWidth = 1920;
        fp.screenHeight = 1080;
        fp.webglVendor = "Google Inc. (NVIDIA)";
        Console.WriteLine("fp_ua_valid=" + Convert.ToString(fp.userAgent.Length > 0));
        Console.WriteLine("fp_platform=" + fp.platform);
        Console.WriteLine("fp_screen=" + Convert.ToString(fp.screenWidth) + "x" + Convert.ToString(fp.screenHeight));
        Console.WriteLine("fp_webgl_vendor=" + fp.webglVendor);

        // 9. CefArchive & CefHttpEndpoint
        CefArchive archive = new CefArchive();
        archive.fileName = "cef_109.zip";
        archive.sha1 = "da39a3ee5e6b4b0d3255bfef95601890afd80709";
        Console.WriteLine("archive=" + archive.fileName + ":sha1=" + archive.sha1);

        CefHttpEndpoint ep = new CefHttpEndpoint();
        ep.host = "127.0.0.1";
        ep.port = 9222;
        Console.WriteLine("ep=" + ep.host + ":" + Convert.ToString(ep.port));

        Console.WriteLine("=== Browser Container Hardening Verified ===");
    }
}
