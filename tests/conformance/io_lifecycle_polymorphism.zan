using System;
using System.IO;

class Program {
    static void TestMemoryStream() {
        MemoryStream ms = new MemoryStream(32);
        byte[] input = new byte[4];
        input[0] = 72; // H
        input[1] = 69; // E
        input[2] = 76; // L
        input[3] = 76; // L
        ms.WriteBytes(input, 0, 4);
        ms.WriteByte(79); // O

        Console.WriteLine("ms_len=" + Convert.ToString(ms.Length()));
        byte[] output = ms.ToArray();
        Console.WriteLine("ms_arr_len=" + Convert.ToString(output.Length));
        Console.WriteLine("ms_str=" + ms.ToStr());

        IDisposable disp = ms;
        disp.Dispose();
        Console.WriteLine("ms_disposed=" + (ms.CanRead() ? "false" : "true"));
    }

    static void TestTextReaderWriter() {
        MemoryStream ms = new MemoryStream(64);
        StreamWriter sw = StreamWriter.Wrap(ms);
        sw.WriteLine("hello-world-line");
        sw.WriteLine("second-line");
        sw.Flush();

        ms.Seek(0, 0);

        StreamReader sr = StreamReader.Wrap(ms);
        string l1 = sr.ReadLine();
        string l2 = sr.ReadLine();
        Console.WriteLine("l1=" + l1);
        Console.WriteLine("l2=" + l2);

        IDisposable dispR = sr;
        dispR.Dispose();

        IDisposable dispW = sw;
        dispW.Dispose();

        ms.Close();
    }

    static void Main() {
        TestMemoryStream();
        TestTextReaderWriter();
        Console.WriteLine("io_lifecycle_ok=1");
    }
}
