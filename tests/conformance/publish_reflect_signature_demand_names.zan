using System;

// These types occur only in unused method/constructor signatures.
class SignatureNamesParameter { }
class SignatureNamesReturn { }
class SignatureNamesFieldType { }

class SignatureNamesTarget {
    [Column("SIGNATURE_NAMES_FIELD_ALIAS_DEAD")]
    [DefaultValue("SIGNATURE_NAMES_FIELD_DEFAULT_DEAD")]
    [Description("SIGNATURE_NAMES_FIELD_ATTR_DEAD")]
    public SignatureNamesFieldType Field;
    public int Stored;
    public int Number {
        get { return Stored * 2; }
        set { Stored = value / 2; }
    }

    public SignatureNamesTarget() { }
    public SignatureNamesTarget(SignatureNamesParameter parameter) { }

    [Description("SIGNATURE_NAMES_ATTR_MUST_BE_DEAD")]
    public SignatureNamesReturn Describe(SignatureNamesParameter parameter) { return null; }
}

class Program {
    // Dead queries must not enable signature capabilities.
    static string DeadReturn(TypeInfo type) { return type.GetMethodReturnType(0); }
    static string DeadParams(TypeInfo type) { return type.GetMethodParamType(0, 0); }
    static string DeadAttrs(TypeInfo type) { return type.GetMethodCustomAttributes(0); }
    static string DeadAttributeData(TypeInfo type) { return type.GetMethodAttributeData(0); }
    static string DeadCtor(TypeInfo type) { return type.GetCtorParamType(1, 0); }

    static void Require(bool condition, string message) {
        if (!condition) throw new Exception(message);
    }

    static void Main() {
        SignatureNamesTarget instance = new SignatureNamesTarget();
        object target = instance;
        Require(target.HasMethod("Describe"), "object method name query");
        Require(target.HasField("Field"), "field name query");
        TypeInfo type = target.GetType();
        Require(type.HasMethod("Describe"), "type method name query");
        bool found = false;
        for (int i = 0; i < type.MethodCount; i++) {
            if (type.GetMethodName(i) == "Describe") {
                found = true;
                Require(type.GetMethodParamCount(i) == 1, "parameter count");
                Require(!type.IsMethodStatic(i), "instance method flags");
            }
        }
        Require(found, "method enumeration");
        Require(target.SetFieldInt("Number", 46), "property setter");
        Require(target.GetFieldInt("Number") == 46 && instance.Stored == 23, "property getter");
        Console.WriteLine("names PASS");
    }
}
