using System;
using System.Data.Redis;

class Program {
    static void Main() {
        RedisPool pool = new RedisPool("127.0.0.1", 6379, 0);
        Console.WriteLine("max=" + Convert.ToString(pool.MaxSize()));
        Console.WriteLine("live=" + Convert.ToString(pool.LiveCount()));
        Console.WriteLine("idle=" + Convert.ToString(pool.IdleCount()));
        Console.WriteLine("waiting=" + Convert.ToString(pool.WaitingCount()));
        Console.WriteLine("closed=" + Convert.ToString(pool.IsClosed()));
        pool.Close();
        Console.WriteLine("closed2=" + Convert.ToString(pool.IsClosed()));
    }
}
