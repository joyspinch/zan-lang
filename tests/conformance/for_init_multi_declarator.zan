// for-head with several declarators (`for (int i = 0, j = 1; ...)`) must keep
// every declarator inside the loop scope: the body, condition and step all
// see them. They used to escape via parse_var_decl's pending-statement queue
// and the body reported `j` as undeclared. Owned (string) head declarators
// share the wrapper scope and are released with it.
using System;

class Program {
    static int Main() {
        int sum = 0;
        for (int i = 0, j = 1; i < 5; i++) {
            sum += j;
        }
        Console.WriteLine(sum);

        // a later declarator may reference an earlier one
        int count = 0;
        for (int a = 2, b = a * 3; b < 20; b += a) {
            count++;
        }
        Console.WriteLine(count);

        // owned (string) head declarators live and die with the loop
        int k = 0;
        for (string p = "x", q = p + "y"; k < 3; k++) {
            Console.WriteLine(q);
        }
        return 0;
    }
}
