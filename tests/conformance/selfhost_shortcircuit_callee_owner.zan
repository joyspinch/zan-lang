using System;

public delegate bool ShortCircuitRead();
class ShortCircuitPayload {
    public static int calls;
    public bool Read() { calls = calls + 1; return true; }
}
class SelfhostShortCircuitCalleeOwner {
    static ShortCircuitRead Bind(ShortCircuitPayload payload) { return payload.Read; }
    static void Main() {
        ShortCircuitPayload payload = new ShortCircuitPayload();
        WeakReference<ShortCircuitPayload> watch = new WeakReference<ShortCircuitPayload>(payload);
        ShortCircuitRead read = Bind(payload);
        payload = null;
        Console.WriteLine("and-rhs=" + (true && read()));
        Console.WriteLine("or-rhs=" + (false || read()));
        Console.WriteLine("and-lhs=" + (read() && true));
        Console.WriteLine("or-lhs=" + (read() || false));
        Console.WriteLine("and-skip=" + !(false && read()));
        Console.WriteLine("or-skip=" + (true || read()));
        Console.WriteLine("nested=" + ((true && read()) || read()));
        Console.WriteLine("calls=" + ShortCircuitPayload.calls);
        Console.WriteLine("alive=" + watch.IsAlive);
        read = null;
        Console.WriteLine("released=" + !watch.IsAlive);
    }
}
