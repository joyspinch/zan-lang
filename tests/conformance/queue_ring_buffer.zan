using System;
using System.Collections.Generic;

class Item {
    public int id;
    public Item(int id) { this.id = id; }
}

class Program {
    static void Main() {
        Queue<Item> q = new Queue<Item>(4);
        if (q.Count() != 0 || !q.IsEmpty()) {
            Console.WriteLine("FAIL: initial state");
            return;
        }

        // 1. Enqueue 3 items
        q.Enqueue(new Item(1));
        q.Enqueue(new Item(2));
        q.Enqueue(new Item(3));
        if (q.Count() != 3 || q.Peek().id != 1) {
            Console.WriteLine("FAIL: peek or count");
            return;
        }

        // 2. Dequeue 2 items (head advances to 2)
        Item d1 = q.Dequeue();
        Item d2 = q.Dequeue();
        if (d1.id != 1 || d2.id != 2 || q.Count() != 1) {
            Console.WriteLine("FAIL: dequeue 2");
            return;
        }

        // 3. Enqueue 3 more items (causes ring wrap-around: tail wraps to 0, 1)
        q.Enqueue(new Item(4));
        q.Enqueue(new Item(5));
        q.Enqueue(new Item(6));
        if (q.Count() != 4) {
            Console.WriteLine("FAIL: count after wrap");
            return;
        }

        // 4. Enqueue 1 more item (forces Grow while wrapped)
        q.Enqueue(new Item(7));
        if (q.Count() != 5) {
            Console.WriteLine("FAIL: count after grow while wrapped");
            return;
        }

        // 5. Verify all items come out in exact FIFO order: 3, 4, 5, 6, 7
        int[] expected = new int[5] { 3, 4, 5, 6, 7 };
        for (int i = 0; i < 5; i = i + 1) {
            Item it = q.Dequeue();
            if (it.id != expected[i]) {
                Console.WriteLine("FAIL: item " + Convert.ToString(i) + " expected " + Convert.ToString(expected[i]) + " got " + Convert.ToString(it.id));
                return;
            }
        }

        if (!q.IsEmpty() || q.Count() != 0) {
            Console.WriteLine("FAIL: queue should be empty");
            return;
        }

        // 6. Test ToArray & Clear
        q.Enqueue(new Item(10));
        q.Enqueue(new Item(20));
        Item[] arr = q.ToArray();
        if (arr.Length != 2 || arr[0].id != 10 || arr[1].id != 20) {
            Console.WriteLine("FAIL: ToArray");
            return;
        }
        q.Clear();
        if (!q.IsEmpty() || q.Count() != 0) {
            Console.WriteLine("FAIL: Clear");
            return;
        }

        Console.WriteLine("QUEUE RING BUFFER ALL PASSED");
    }
}
