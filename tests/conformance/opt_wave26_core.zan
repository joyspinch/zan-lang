using System;
using System.IO;
using System.IO.Compression;
using System.Data;
using System.Xml;
using System.Json;
using System.Text;
using Formats.Yaml;
using Formats.Cbor;

class OptWave26Core {
    static void Check(bool cond, string msg) {
        if (!cond) {
            throw new Exception("FAIL: " + msg);
        }
    }

    static bool IsMissingAt(DataFrame df, int row, string col) {
        int idx = df.ColIndex(col);
        Check(idx >= 0, "missing col: " + col);
        return df.cols[idx].IsMissing(row);
    }

    static int HexVal(int c) {
        if (c >= 97) { return c - 87; }
        if (c >= 65) { return c - 55; }
        return c - 48;
    }

    static byte[] FromHex(string s) {
        int n = s.Length / 2;
        byte[] b = new byte[n];
        for (int i = 0; i < n; i = i + 1) {
            int hi = HexVal(s[i * 2] & 255);
            int lo = HexVal(s[i * 2 + 1] & 255);
            b[i] = (byte)((hi << 4) | lo);
        }
        return b;
    }

    static long FnvBytes(byte[] data) {
        long h = -3750763034362895579L;
        for (int i = 0; i < data.Length; i = i + 1) {
            h = (h ^ (long)(data[i] & 255)) * 1099511628211L;
        }
        return h;
    }

    static void TestDataFrame() {
        // 1. Unstack: sparse cells, duplicate overwrite, multi-id columns
        string csv = "k1,k2,metric,val\n"
            + "a,1,cpu,10.5\n"
            + "a,1,mem,20.0\n"
            + "a,1,cpu,15.5\n"
            + "b,2,mem,40.0\n"
            + "a,2,cpu,5.0\n";
        DataFrame df = DataFrame.FromCsv(csv);
        DataFrame wide = Reshape.Unstack(df, "metric", "val");
        Check(wide.Rows() == 3, "unstack rows");
        Check(wide.ColCount() == 4, "unstack cols");
        Check(wide.GetFloat(0, "metric_cpu") == 15.5, "unstack dup overwrite");
        Check(wide.GetFloat(0, "metric_mem") == 20.0, "unstack mem row0");
        Check(IsMissingAt(wide, 1, "metric_cpu"), "unstack sparse null cpu");
        Check(wide.GetFloat(1, "metric_mem") == 40.0, "unstack mem row1");
        Check(wide.GetFloat(2, "metric_cpu") == 5.0, "unstack cpu row2");
        Check(IsMissingAt(wide, 2, "metric_mem"), "unstack sparse null mem");

        // 2. ResampleBy: unsorted timestamps & all Agg modes
        long t0 = 1704067200L; // 2024-01-01 00:00:00 UTC
        string tsCsv = "ts,v\n"
            + Convert.ToString(t0 + 90000L) + ",30.0\n"
            + Convert.ToString(t0 + 100L) + ",10.0\n"
            + Convert.ToString(t0 + 86500L) + ",50.0\n"
            + Convert.ToString(t0 + 200L) + ",20.0\n";
        DataFrame tsDf = DataFrame.FromCsv(tsCsv);
        DataFrame rSum = Resample.ResampleBy(tsDf, "ts", "v", Freq.Day, Agg.Sum);
        Check(rSum.Rows() == 2, "resample day buckets");
        Check(rSum.GetFloat(0, "v") == 30.0, "resample day0 sum");
        Check(rSum.GetFloat(1, "v") == 80.0, "resample day1 sum");
        DataFrame rAvg = Resample.ResampleBy(tsDf, "ts", "v", Freq.Day, Agg.Avg);
        Check(rAvg.GetFloat(0, "v") == 15.0, "resample day0 avg");
        Check(rAvg.GetFloat(1, "v") == 40.0, "resample day1 avg");
        DataFrame rMin = Resample.ResampleBy(tsDf, "ts", "v", Freq.Day, Agg.Min);
        Check(rMin.GetFloat(0, "v") == 10.0 && rMin.GetFloat(1, "v") == 30.0, "resample min");
        DataFrame rMax = Resample.ResampleBy(tsDf, "ts", "v", Freq.Day, Agg.Max);
        Check(rMax.GetFloat(0, "v") == 20.0 && rMax.GetFloat(1, "v") == 50.0, "resample max");
        DataFrame rCnt = Resample.ResampleBy(tsDf, "ts", "v", Freq.Day, Agg.Count);
        Check(rCnt.GetFloat(0, "v") == 2.0 && rCnt.GetFloat(1, "v") == 2.0, "resample count");

        // 3. MergeTables (Inner/Left/Right/Outer) + DataFrame.Join with duplicate keys in ascending order
        DataFrame left = DataFrame.FromCsv("id,lval\n1,L1\n2,L2\n3,L3\n");
        DataFrame right = DataFrame.FromCsv("id,rval,rnum\n2,R2a,20\n2,R2b,21\n4,R4,40\n");
        List<string> on = new List<string>();
        on.Add("id");

        DataFrame inner = Merge.MergeTables(left, right, on, on, MergeKind.Inner);
        Check(inner.Rows() == 2, "merge inner rows");
        Check(inner.GetStr(0, "rval") == "R2a" && inner.GetStr(1, "rval") == "R2b", "merge inner order");

        DataFrame mLeft = Merge.MergeTables(left, right, on, on, MergeKind.Left);
        Check(mLeft.Rows() == 4, "merge left rows");
        Check(mLeft.GetStr(0, "rval") == "" && IsMissingAt(mLeft, 0, "rnum")
            && mLeft.GetStr(1, "rval") == "R2a" && mLeft.GetInt(1, "rnum") == 20
            && mLeft.GetStr(2, "rval") == "R2b" && mLeft.GetInt(2, "rnum") == 21
            && mLeft.GetStr(3, "rval") == "" && IsMissingAt(mLeft, 3, "rnum"), "merge left vals");

        DataFrame mRight = Merge.MergeTables(left, right, on, on, MergeKind.Right);
        Check(mRight.Rows() == 3, "merge right rows");
        Check(mRight.GetStr(0, "lval") == "L2" && mRight.GetStr(1, "lval") == "L2"
            && mRight.GetStr(2, "lval") == "" && mRight.GetStr(2, "rval") == "R4", "merge right vals");

        DataFrame mOuter = Merge.MergeTables(left, right, on, on, MergeKind.Outer);
        Check(mOuter.Rows() == 5, "merge outer rows");
        Check(mOuter.GetStr(4, "lval") == "" && mOuter.GetInt(4, "id") == 4
            && mOuter.GetStr(4, "rval") == "R4" && mOuter.GetInt(4, "rnum") == 40, "merge outer fallback key");

        DataFrame joined = left.Join(right, "id", "id");
        Check(joined.Rows() == 2, "df join rows");
        Check(joined.GetStr(0, "rval") == "R2a" && joined.GetStr(1, "rval") == "R2b", "df join order");
        Console.WriteLine("dataframe=ok");
    }

