        byte[] plain = BZip2.Decompress(comp);
        Check(plain != null && plain.Length == 2025, "bzip2 plain length");
        comp[10] = (byte)((comp[10] ^ 1) & 255);
        Check(BZip2.Decompress(comp) == null, "bzip2 bad crc returns null");
        Console.WriteLine("bzip2=ok");
    }

    static void TestLz4() {
        // Test empty, tiny (<16), medium compressible (hashLog 8/10/12/14/16), RLE overlap, and incompressible
        int[] sizes = new int[]{ 0, 1, 7, 15, 16, 128, 1024, 8192, 65536 };
        for (int s = 0; s < sizes.Length; s = s + 1) {
            int n = sizes[s];
            byte[] src = new byte[n];
            for (int i = 0; i < n; i = i + 1) {
                src[i] = (byte)(((i / 4) + (i % 7) * 13) & 255);
            }
            byte[] comp = Lz4Block.Encode(src, 3);
            byte[] dec = Lz4Block.Decode(comp, 0, comp.Length, n);
            Check(dec.Length == n && FnvBytes(dec) == FnvBytes(src), "lz4 compressible size=" + Convert.ToString(n));
        }

        // Overlapping short-offset RLE matches (offsets 1, 2, 3)
        byte[] rle = new byte[4096];
        for (int i = 0; i < 1024; i = i + 1) { rle[i] = 65; }
        for (int i = 1024; i < 2048; i = i + 1) { rle[i] = (byte)(66 + (i & 1)); }
        for (int i = 2048; i < 4096; i = i + 1) { rle[i] = (byte)(70 + (i % 3)); }
        byte[] rleComp = Lz4Block.Encode(rle, 5);
        byte[] rleDec = Lz4Block.Decode(rleComp, 0, rleComp.Length, rle.Length);
        Check(FnvBytes(rleDec) == FnvBytes(rle), "lz4 overlapping rle");

        // Incompressible pseudo-random payload (triggers miss acceleration)
        byte[] rnd = new byte[32768];
        uint seed = 2463534242U;
        for (int i = 0; i < rnd.Length; i = i + 1) {
            seed = seed ^ (seed << 13);
            seed = seed ^ (seed >> 17);
            seed = seed ^ (seed << 5);
            rnd[i] = (byte)(seed & 255U);
        }
        byte[] rndComp = Lz4Block.Encode(rnd, 3);
        byte[] rndDec = Lz4Block.Decode(rndComp, 0, rndComp.Length, rnd.Length);
        Check(FnvBytes(rndDec) == FnvBytes(rnd), "lz4 incompressible");
        Console.WriteLine("lz4=ok");
    }

    static void TestXml() {
        string xml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\r\n"
            + "<!-- top comment -->\r\n"
            + "<ns:root xmlns:ns=\"urn:test\" ns:ver=\"1.0\" attr=\"a&amp;b&lt;c&gt;&quot;d&#39;\">\r\n"
            + "  <ns:item id=\"1\">\r\n"
            + "    <ns:name>Alpha &amp; &#65;&#x42;</ns:name>\r\n"
            + "    <ns:raw><![CDATA[plain text without bracket]]></ns:raw>\r\n"
            + "    <ns:edge><![CDATA[has ]]]]><![CDATA[> split ]] end]]></ns:edge>\r\n"
            + "  </ns:item>\r\n"
            + "  <ns:item id=\"2\">\r\n"
            + "    <ns:name>Beta</ns:name>\r\n"
            + "  </ns:item>\r\n"
            + "</ns:root>\r\n";
        XmlDocument doc = XmlDocument.Parse(xml);
        XmlNode root = doc.RootElement();
        Check(root != null, "xml root non-null");
        Check(root.LocalName() == "root", "xml root local");
        Check(root.Attr("ver") == "1.0", "xml attr local fallback");
        Check(root.Attr("ns:ver") == "1.0", "xml attr exact");
        Check(root.Attr("attr") == "a&b<c>\"d'", "xml attr entities");
        List<XmlNode> items = root.Elements("item");
        Check(items.Count == 2, "xml local Elements count");
        XmlNode nName = items[0].Element("name");
        XmlNode nRaw = items[0].Element("raw");
        XmlNode nEdge = items[0].Element("edge");
        Check(nName != null && nName.InnerText() == "Alpha & AB", "xml entity decode");
        Check(nRaw != null && nRaw.InnerText() == "plain text without bracket", "xml cdata fastpath");
        Check(nEdge != null && nEdge.InnerText() == "has ]]> split ]] end", "xml cdata split");

        string compact = doc.ToXml();
        XmlDocument doc2 = XmlDocument.Parse(compact);
        XmlNode r2 = doc2.RootElement();
        Check(r2 != null, "xml roundtrip root");
        XmlNode e2 = r2.Elements("item")[0].Element("edge");
        Check(e2 != null && e2.InnerText() == "has ]]> split ]] end", "xml compact roundtrip");

        // Deep nesting (> 16 levels -> > 32 spaces indent)
        XmlDocument deep = new XmlDocument();
        XmlNode cur = XmlNode.NewElement("d0");
        deep.children.Add(cur);
        for (int i = 1; i <= 20; i = i + 1) {
            XmlNode nxt = XmlNode.NewElement("d" + Convert.ToString(i));
            cur.AddChild(nxt);
            cur = nxt;
        }
        cur.AddText("leaf");
        string pretty = deep.ToPrettyXml();
        XmlDocument deep2 = XmlDocument.Parse(pretty);
        XmlNode dr2 = deep2.RootElement();
        Check(dr2 != null && dr2.InnerText().IndexOf("leaf") >= 0, "xml deep pretty roundtrip");
        Console.WriteLine("xml=ok");
    }

    static JsonValue MustGet(JsonValue obj, string key) {
        JsonValue v = obj.Get(key);
        Check(v != null, "missing key: " + key);
        return v;
    }

    static void TestYamlAndCbor() {
        string yml = "defaults: &def\n"
            + "  enabled: true\n"
            + "  disabled: false\n"
            + "  empty: null\n"
            + "  tilde: ~\n"
            + "items:\n"
            + "  - name: first # inline comment\n"
            + "    dec: -42\n"
            + "    hex: 0x2a\n"
            + "    oct: 0o52\n"
            + "    big: 99999999999999999999999\n"
            + "    flt: 3.14\n"
            + "    dq: \"line1\\nline2\"\n"
            + "    sq: 'it''s ok'\n"
            + "    lit: |-\n"
            + "      a\n"
            + "      b\n"
            + "    fld: >\n"
            + "      hello\n"
            + "      world\n"
            + "    flow: [1, 2, 3]\n"
            + "    ref: *def\n"
            + "  - name: second\n"
            + "    dec: 100\n";
        JsonValue doc = Yaml.Parse(yml);
        JsonValue items = MustGet(doc, "items");
        Check(items.Count() == 2, "yaml items count");
        JsonValue i0 = items.At(0);
        Check(i0 != null, "yaml i0");
        Check(MustGet(i0, "name").AsString("") == "first", "yaml inline comment strip");
        Check(MustGet(i0, "dec").AsInt(0) == -42, "yaml neg int");
        Check(MustGet(i0, "hex").AsInt(0) == 42, "yaml hex int");
        Check(MustGet(i0, "oct").AsInt(0) == 42, "yaml oct int");
        Check(MustGet(i0, "big").AsString("") == "99999999999999999999999", "yaml overflow str");
        Check(MustGet(i0, "dq").AsString("") == "line1\nline2", "yaml double quote");
        Check(MustGet(i0, "sq").AsString("") == "it's ok", "yaml single quote");
        Check(MustGet(i0, "lit").AsString("") == "a\nb", "yaml literal strip");
        Check(MustGet(i0, "fld").AsString("") == "hello world\n", "yaml folded clip");
        Check(MustGet(i0, "flow").Count() == 3, "yaml flow seq");
        JsonValue rdef = MustGet(i0, "ref");
        Check(MustGet(rdef, "enabled").AsBool(false) && !MustGet(rdef, "disabled").AsBool(true)
            && MustGet(rdef, "empty").IsNull() && MustGet(rdef, "tilde").IsNull(), "yaml alias & types");
        JsonValue i1 = items.At(1);
        Check(i1 != null && MustGet(i1, "name").AsString("") == "second"
            && MustGet(i1, "dec").AsInt(0) == 100, "yaml cached keys");

        // CBOR roundtrip + indefinite-length text/byte strings
        byte[] enc = Cbor.Encode(doc);
        JsonValue dec = Cbor.Decode(enc);
        JsonValue decItems = MustGet(dec, "items");
        Check(decItems.Count() == 2, "cbor roundtrip count");
        JsonValue d0 = decItems.At(0);
        JsonValue d1 = decItems.At(1);
        Check(d0 != null && d1 != null && MustGet(d0, "dec").AsInt(0) == -42
            && MustGet(d1, "name").AsString("") == "second", "cbor roundtrip values");

        // Indefinite-length text string (0x7f, "hi", "!", 0xff)
        byte[] indefTxt = FromHex("7f6268696121ff");
        JsonValue tVal = Cbor.Decode(indefTxt);
        Check(tVal.AsString("") == "hi!", "cbor indef text chunks");

        // Indefinite-length byte string (0x5f, "AB", "C", 0xff -> decoded as UTF-8 "ABC")
        byte[] indefBytes = FromHex("5f4241424143ff");
        JsonValue bVal = Cbor.Decode(indefBytes);
        Check(bVal.AsString("") == "ABC", "cbor indef bytes chunks");
        Console.WriteLine("yaml_cbor=ok");
    }

    public static void Main() {
        TestDataFrame();
        TestZstd();
        TestBZip2();
        TestLz4();
        TestXml();
        TestYamlAndCbor();
        Console.WriteLine("ALL_WAVE26_OK");
    }
}
