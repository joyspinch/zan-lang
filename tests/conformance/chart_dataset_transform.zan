// dataset transform 与显式类目轴契约：filter 结果集保留表头行
// （此前 r=1 起筛，首条数据行被当表头吃掉、末条被 RowCount 的
// -1 截掉）；显式 type:'category' 不得被"数值列智能推断"翻成
// value 轴（axisModelCreator.ts:143 只推断无 type 的轴——data-
// transform-filter 的 Year 列全数值，曾被翻后零锚域把 1950..2015
// 全钳到绘图区右缘）；sort 分支保留表头回归钉；bump-chart 的
// y 值轴 min/max/interval/inverse 解析。
using System;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static void Main() {
        // ① filter 保留表头：gte 1955 → 行表 [hdr,1955,1960]，
        // RowCount=2、首条即 1955。
        ChartOption a = ChartOption.FromJson(
            "{\"dataset\":[" +
            "{\"id\":\"raw\",\"source\":[[\"Year\",\"V\"],[1950,10],[1955,20],[1960,30]]}," +
            "{\"id\":\"f\",\"fromDatasetId\":\"raw\",\"transform\":{\"type\":\"filter\"," +
            "\"config\":{\"and\":[{\"dimension\":\"Year\",\"gte\":1955}]}}}" +
            "],\"xAxis\":{\"type\":\"category\"},\"yAxis\":{}," +
            "\"series\":[{\"type\":\"line\",\"datasetId\":\"f\"," +
            "\"encode\":{\"x\":\"Year\",\"y\":\"V\"}}]}");
        ChartJsonDataset f = a.datasets[1];
        Console.WriteLine("FL rows=" + Convert.ToString(f.RowCount())
            + " y0=[" + f.Text(0, 0) + "] y1=[" + f.Text(1, 0)
            + "] inc0=" + Convert.ToString(f.Num(0, 1)));
        // 显式 category 不翻：类目从 Year 列回填，系列数据 [名,值] 对。
        bool xc = a.xAxes[0].type == ChartAxisType.Category;
        Console.WriteLine("NC xcat=" + Convert.ToString(xc)
            + " cats=" + Convert.ToString(a.xAxes[0].categories.Count)
            + " c0=[" + a.xAxes[0].categories[0] + "]"
            + " v0=" + Convert.ToString(a.series[0].data[0].val)
            + " n0=[" + a.series[0].data[0].name + "]");
        // ② 无 and 包裹的单条件 filter 同路（ColumnOf 直查维度名）。
        ChartOption a2 = ChartOption.FromJson(
            "{\"dataset\":[" +
            "{\"id\":\"raw\",\"source\":[[\"Y\",\"V\"],[1,5],[2,6],[3,7]]}," +
            "{\"fromDatasetId\":\"raw\",\"transform\":{\"type\":\"filter\"," +
            "\"config\":{\"dimension\":\"Y\",\"gte\":2}}}" +
            "],\"series\":[]}");
        ChartJsonDataset g = a2.datasets[1];
        Console.WriteLine("FL1 rows=" + Convert.ToString(g.RowCount())
            + " y0=[" + g.Text(0, 0) + "] yN=[" + g.Text(g.RowCount() - 1, 0) + "]");
        // ③ bump-chart 形：y 值轴 min/max/interval/inverse 四键解析。
        ChartOption b = ChartOption.FromJson(
            "{\"xAxis\":{\"type\":\"category\",\"data\":[\"2001\",\"2002\"]}," +
            "\"yAxis\":{\"type\":\"value\",\"inverse\":true,\"interval\":1,\"min\":1,\"max\":9}," +
            "\"series\":[{\"type\":\"line\",\"smooth\":true,\"data\":[2,7]}]}");
        ChartAxis y = b.yAxes[0];
        Console.WriteLine("BC min=" + Convert.ToString(y.min)
            + " max=" + Convert.ToString(y.max)
            + " ticks=" + Convert.ToString(y.ticks)
            + " rev=" + Convert.ToString(y.reversed));
        // ④ sort 升序按 V：[2002,3] 排到 [2001,5] 前；表头钉在槽 0。
        ChartOption s = ChartOption.FromJson(
            "{\"dataset\":[" +
            "{\"id\":\"raw\",\"source\":[[\"Y\",\"V\"],[2001,5],[2002,3]]}," +
            "{\"fromDatasetId\":\"raw\",\"transform\":{\"type\":\"sort\"," +
            "\"config\":{\"dimension\":\"V\",\"order\":\"asc\"}}}" +
            "],\"series\":[{\"type\":\"bar\",\"datasetIndex\":1," +
            "\"encode\":{\"x\":\"Y\",\"y\":\"V\"}}]}");
        ChartJsonDataset sd = s.datasets[1];
        Console.WriteLine("SO rows=" + Convert.ToString(sd.RowCount())
            + " y0=[" + sd.Text(0, 0) + "] v0=" + Convert.ToString(sd.Num(0, 1))
            + " v1=" + Convert.ToString(sd.Num(1, 1)));
    }
}
