using System;

class HostSlotBase {
    public virtual int Pick(int value) { return 11; }
    public virtual int Pick(string value) { return 22; }
    public virtual int Pick(int[] value) { return 55; }
    public virtual int Pick(string[] value) { return 66; }
    public virtual int RefPick(ref int value) { value = 7; return 77; }
}
class HostSlotChild : HostSlotBase {
    // Reverse declaration order so member order cannot stand in for identity.
    public override int Pick(string value) { return 44; }
    public override int Pick(int value) { return 33; }
    public override int Pick(string[] value) { return 88; }
    public override int RefPick(ref int value) { value = 9; return 99; }
}
class HostSlotLeaf : HostSlotChild {
    public override int Pick(string value) { return 111; }
}
abstract class HostAbstractSlotBase {
    public abstract int Read(int value);
    public abstract int Read(string value);
}
class HostAbstractSlotChild : HostAbstractSlotBase {
    public override int Read(string value) { return 202; }
    public override int Read(int value) { return 201; }
}
class HostGenericSlot<T> {
    public virtual int Read(int value) { return 301; }
    public virtual int Read(string value) { return 302; }
}
class HostGenericBase<T> {
    public virtual int Read(T value) { return 401; }
}
class HostGenericDerived : HostGenericBase<int> {
    public override int Read(int value) { return 402; }
}
class HostSlotProgram {
    static void Main() {
        HostSlotBase value = new HostSlotLeaf();
        Console.WriteLine(value.Pick(1));
        Console.WriteLine(value.Pick("x"));
        Console.WriteLine(value.Pick(new int[0]));
        Console.WriteLine(value.Pick(new string[0]));
        int changed = 0;
        Console.WriteLine(value.RefPick(ref changed));
        Console.WriteLine(changed);
        HostAbstractSlotBase abstractValue = new HostAbstractSlotChild();
        Console.WriteLine(abstractValue.Read(1));
        Console.WriteLine(abstractValue.Read("x"));
        HostGenericSlot<string> genericValue = new HostGenericSlot<string>();
        Console.WriteLine(genericValue.Read(1));
        Console.WriteLine(genericValue.Read("x"));
        HostGenericBase<int> genericBase = new HostGenericDerived();
        Console.WriteLine(genericBase.Read(1));
    }
}
