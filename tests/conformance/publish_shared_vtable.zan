// Identical inherited slot arrays may share one LLVM constant initializer.
// An unused sibling table must not hide the live table's method dependencies.
using System;

class SharedVtableBase {
    public virtual int Value() {
        return 42;
    }
}

class SharedVtableLive : SharedVtableBase {
}

class SharedVtableUnused : SharedVtableBase {
}

class SharedVtableOverride : SharedVtableBase {
    public override int Value() {
        return 99;
    }
}

class Program {
    static int Read(SharedVtableBase value) {
        return value.Value();
    }

    static int Main() {
        int first = Program.Read(new SharedVtableBase());
        int second = Program.Read(new SharedVtableLive());
        int third = Program.Read(new SharedVtableOverride());
        if (first != 42 || second != 42 || third != 99) {
            return 1;
        }
        Console.WriteLine("publish shared vtable PASS");
        return 0;
    }
}
