// Conformance: the nullable-call-result check stays a heuristic -- guards
// that really precede the access keep compiling, in every shape users write:
// early return, `?.`, `??` fallback, `is null`, and a guard inside the if
// condition of the very statement that uses the value.
using System;

class Cfg {
    public string Name;
    public override string ToString() { return Name; }
}

class Store {
    public Cfg Find(string k) {
        if (k == "hit") { Cfg c = new Cfg(); c.Name = "cfg"; return c; }
        return null;
    }
}

class Program {
    static string EarlyReturn(Store s) {
        Cfg c = s.Find("hit");
        if (c == null) { return "none"; }
        return c.Name;
    }

    static string NullCond(Store s) {
        Cfg c = s.Find("miss");
        return c?.Name == null ? "fallback" : c.Name;
    }

    static Cfg Coalesce(Store s) {
        Cfg c = s.Find("miss");
        return c ?? new Cfg();
    }

    static string IsNull(Store s) {
        Cfg c = s.Find("hit");
        if (c is null) { return "none"; }
        return c.Name;
    }

    static void Main() {
        Store s = new Store();
        Console.WriteLine(EarlyReturn(s));
        Console.WriteLine(NullCond(s));
        Cfg d = Coalesce(s);
        Console.WriteLine(d == null ? "null" : "obj");
        Console.WriteLine(IsNull(s));
        Console.WriteLine("GUARD-ORDER-OK");
    }
}
