using System;
using System.Threading;

class Program {
    static void Main() {
        Console.WriteLine("[1] Testing ThreadLocal<int> default initialization...");
        ThreadLocal<int> localInt = new ThreadLocal<int>();
        Console.WriteLine("Initial IsValueCreated: " + (localInt.IsValueCreated ? "true" : "false"));
        
        localInt.Value = 1024;
        Console.WriteLine("After set IsValueCreated: " + (localInt.IsValueCreated ? "true" : "false"));
        Console.WriteLine("Value: " + Convert.ToString(localInt.Value));

        Console.WriteLine("[2] Testing ThreadLocal<string> with factory...");
        ThreadLocal<string> localStr = new ThreadLocal<string>(() => "Lazy-Initialized-ThreadState");
        Console.WriteLine("Factory IsValueCreated before get: " + (localStr.IsValueCreated ? "true" : "false"));
        Console.WriteLine("Factory Value: " + localStr.Value);
        Console.WriteLine("Factory IsValueCreated after get: " + (localStr.IsValueCreated ? "true" : "false"));

        Console.WriteLine("[3] Testing Values snapshot...");
        var values = localStr.Values;
        Console.WriteLine("Values count: " + Convert.ToString(values.Count));
        if (values.Count > 0) {
            Console.WriteLine("Values[0]: " + values[0]);
        }

        localInt.Dispose();
        localStr.Dispose();

        Console.WriteLine("OK: all thread local checks passed!");
    }
}
