using System;

// B-ID84 钉子：96 位满幅 mantissa 除法（Knuth 算法 D 路径）。
// 覆盖：整除 / 非整除舍入（…6667）/ scale 对齐升位 / 大余数取模。
// golden 取自逐位移位环旧实现的输出（对拍探针已证新旧逐位一致）。
class Program {
    static void Main() {
        decimal mx = Decimal.Parse("79228162514264337593543950335"); // 2^96-1
        decimal p = Decimal.Parse("1234567890123456789012345678");
        decimal s1 = Decimal.Parse("79228162.514264337593543950335"); // scale 21

        Console.WriteLine($"mx/3={mx / 3m}");
        Console.WriteLine($"mx/7={mx / 7m}");
        Console.WriteLine($"mx/999999937={mx / 999999937m}");
        Console.WriteLine($"p/123456789={p / 123456789m}");
        Console.WriteLine($"s1/3={s1 / 3m}");
        Console.WriteLine($"mx%7={mx % 7m}");
        Console.WriteLine($"p%99991={p % 99991m}");
        Console.WriteLine($"s1%7={s1 % 7m}");

        // 恒等式抽查：q*b + r == a（decimal 口径）
        decimal q = mx / 7m;
        decimal r = mx % 7m;
        Console.WriteLine($"identity={(q * 7m + r) == mx}");
    }
}
