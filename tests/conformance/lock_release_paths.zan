using System;
using System.Threading;

// Every way out of a `lock` body must release the monitor. Each case leaves the
// lock by a different route, then a second thread tries to take the same
// monitor: it can only get in if the exit path released it.

class Cell { public int n; }

class Program {
    static Cell gate = new Cell();
    static AtomicInt entered = new AtomicInt(0);

    static void Worker() {
        lock (gate) {
            entered.Increment();
        }
    }

    static bool WorkerCanEnter() {
        long before = entered.Load();
        Thread.Start(Worker);
        for (int i = 0; i < 500; i = i + 1) {
            if (entered.Load() > before) return true;
            Thread.Sleep(2);
        }
        return false;
    }

    static int LeaveByReturn() {
        lock (gate) {
            return 1;
        }
    }

    static void LeaveByBreak() {
        lock (gate) {
            for (int i = 0; i < 4; i = i + 1) {
                if (i == 2) break;
            }
        }
    }

    static void LeaveByThrow() {
        try {
            lock (gate) {
                throw new Exception("out");
            }
        } catch (Exception e) {
            gate.n = gate.n + 1;
        }
    }

    static void Main() {
        Console.WriteLine(LeaveByReturn());
        Console.WriteLine(WorkerCanEnter() ? "after return: entered" : "after return: BLOCKED");

        LeaveByBreak();
        Console.WriteLine(WorkerCanEnter() ? "after break: entered" : "after break: BLOCKED");

        LeaveByThrow();
        Console.WriteLine(WorkerCanEnter() ? "after throw: entered" : "after throw: BLOCKED");
    }
}
