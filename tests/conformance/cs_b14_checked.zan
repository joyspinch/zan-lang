// cs_b14_checked.zan -- C#-compat: checked/unchecked expressions and blocks.
// Zan's runtime always wraps on overflow (no overflow checking), so both
// forms are accepted and lower to a plain expression/block (no-op).
class Program {
    static void Main() {
        int x = 2147483647; // int.MaxValue
        int y = checked(x + 1);
        int z = unchecked(x + 1);
        Console.WriteLine(y);   // wraps: -2147483648
        Console.WriteLine(z);   // wraps: -2147483648
        checked {
            int d = x + 1;
            Console.WriteLine(d);
        }
        unchecked {
            int e = x - 1;
            Console.WriteLine(e);
        }
        Console.WriteLine(checked(1 + 2));
    }
}
