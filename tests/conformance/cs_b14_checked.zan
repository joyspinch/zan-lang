// cs_b14_checked.zan -- C#-compat: checked/unchecked expressions and blocks.
// `checked` gives integer + - * a real overflow trap (soft mode prints once
// and continues with the wrapped value; hard mode -- how the runtime-error
// suite runs -- exits 70). `unchecked` pins the plain wrapping semantics even
// inside an enclosing checked context. This conformance case runs in soft
// mode: every checked overflow below prints one report line (stderr, filtered
// out by the harness) and continues, so the wrapped results are observable.
class Program {
    static void Main() {
        int x = 2147483647; // int.MaxValue
        // checked(x + 1): traps (soft: report + wrapped value flows on)
        int y = checked(x + 1);
        // unchecked inside nothing: plain wrapping, no report
        int z = unchecked(x + 1);
        Console.WriteLine(y);   // wraps: -2147483648
        Console.WriteLine(z);   // wraps: -2147483648
        checked {
            int d = x + 1;      // traps (soft: report)
            Console.WriteLine(d);
        }
        unchecked {
            int e = x - 1;      // no report ever
            Console.WriteLine(e);
        }
        // in-range checked arithmetic is silent
        Console.WriteLine(checked(1 + 2));
        // mixed-sign add never overflows and must not trap
        Console.WriteLine(checked(-5 + 3));
    }
}
