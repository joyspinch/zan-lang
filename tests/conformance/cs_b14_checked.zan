// 接口数据协议与执行契约。
class Program {
    static void Main() {
        int x = 2147483647; // int.MaxValue
        // 接口数据协议与执行契约。
        int y = checked(x + 1);
        // 核心契约与语义定义。
        int z = unchecked(x + 1);
        Console.WriteLine(y);   // wraps: -2147483648
        Console.WriteLine(z);   // wraps: -2147483648
        checked {
            int d = x + 1;      // traps (soft: report)
            Console.WriteLine(d);
        }
        unchecked {
            int e = x - 1;      // no report ever
            Console.WriteLine(e);
        }
        // 核心契约与语义定义。
        Console.WriteLine(checked(1 + 2));
        // 接口数据协议与执行契约。
        Console.WriteLine(checked(-5 + 3));
    }
}
