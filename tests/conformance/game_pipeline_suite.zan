using System;
using Gui;
using Game.Core;
using Game.Graphics;
using Game.Input;
using Game.Arpg;

class TestHero : Entity {
    public int updateCount;

    TestHero(int id) : base(id, "hero") {
        this.updateCount = 0;
        this.Width = 32.0;
        this.Height = 32.0;
        this.Radius = 16.0;
    }

    static TestHero Create(int id) {
        return new TestHero(id);
    }

    override void OnFixedUpdate(Scene scene, double dt) {
        base.OnFixedUpdate(scene, dt);
        updateCount = updateCount + 1;
        this.X = this.X + 10.0 * dt;
    }
}

class PipelineSuite {
    static void Main() {
        TestSceneAndEntity();
        TestSpriteAndAnimator();
        TestInputMapper();
        TestGameViewport();

        Console.WriteLine("PIPELINE_ALL_PASSED");
    }

    static void Assert(bool cond, string msg) {
        if (!cond) {
            Console.WriteLine("[FAIL] " + msg);
            throw new Exception("Assertion failed: " + msg);
        }
    }

    static void TestSceneAndEntity() {
        Scene scene = Scene.Create("MainWorld", 1280, 720, 512);
        TestHero hero = TestHero.Create(scene.NextId());
        hero.X = 100.0;
        hero.Y = 200.0;
        scene.AddEntity(hero);

        scene.AdvanceFixedStep(0.01666667);
        scene.AdvanceFixedStep(0.01666667);

        Assert(hero.updateCount == 2, "Hero should have ticked 2 times");
        Assert(hero.X > 100.0, "Hero should move right");

        int[] outIds = new int[16];
        int hits = scene.SpatialGrid.QueryRange(hero.X, hero.Y, 30.0, outIds, 16);
        Assert(hits == 1 && outIds[0] == hero.Id, "SpatialGrid must auto-index the hero");

        Entity found = scene.FindById(hero.Id);
        Assert(found != null && found.Tag == "hero", "FindById should locate hero");

        hero.Destroy();
        scene.AdvanceFixedStep(0.01666667);
        Assert(scene.EntityCount == 0, "Destroyed entity must be collected");
    }

    static void TestSpriteAndAnimator() {
        SpriteSheet sheet = SpriteSheet.Create("hero_atlas", 256, 256, 32, 32);
        Assert(sheet.Cols == 8 && sheet.Rows == 8, "Sheet grid must be 8x8");

        float u0, v0, u1, v1;
        sheet.GetFrameUV(0, out u0, out v0, out u1, out v1);
        Assert(u0 == 0.0f && v0 == 0.0f, "Frame 0 UV must start at 0,0");

        DirectionalAnimator anim = DirectionalAnimator.Create(sheet, 8);
        anim.AddState("walk", 0, 4, 10.0, true);
        anim.Play("walk", 3, true);

        int g0 = anim.GetCurrentGlobalFrame();
        Assert(g0 == 24, "Initial global frame for dir 3 must be 24");

        anim.Update(0.1);
        int g1 = anim.GetCurrentGlobalFrame();
        Assert(g1 == 25, "Next global frame must be 25");
    }

    static void TestInputMapper() {
        InputMapper input = InputMapper.Create();
        Camera2D cam = Camera2D.Create(1280, 720);
        cam.X = 500.0;
        cam.Y = 300.0;

        IsoTileMap map = IsoTileMap.Create(64, 64, 64, 32);

        input.BindAction("Fire", 32);
        input.OnKeyDown(32);
        Assert(input.IsActionDown("Fire"), "Action Fire should be down");
        Assert(input.IsActionJustPressed("Fire"), "Action Fire should be just pressed");

        input.FlushFrameEvents();
        Assert(!input.IsActionJustPressed("Fire"), "Just pressed must be cleared after flush");
        Assert(input.IsActionDown("Fire"), "Action should remain down");

        input.OnMouseMove(640.0, 360.0);
        double wx, wy;
        input.GetWorldMouse(cam, out wx, out wy);
        Assert(Math.Abs(wx - 500.0) < 0.01 && Math.Abs(wy - 300.0) < 0.01, "Mouse should project to world center");

        int gx, gy;
        input.GetIsoGridMouse(cam, map, out gx, out gy);
        Assert(gx >= 0 && gy >= 0, "Iso grid coords must be non-negative");

        input.OnMouseButton(0, true);
        input.OnMouseMove(700.0, 420.0);
        Assert(input.IsDragging, "Mouse drag should activate selection box");

        double minX, minY, maxX, maxY;
        bool hasBox = input.GetSelectionWorldBox(cam, out minX, out minY, out maxX, out maxY);
        Assert(hasBox && maxX > minX && maxY > minY, "Selection box world coords must be valid");
    }

    static void TestGameViewport() {
        Scene scene = Scene.Create("ViewportScene", 800, 600, 128);
        GameViewport viewport = GameViewport.Create(scene);
        Assert(viewport.CurrentScene != null, "Viewport should hold current scene");
        Assert(viewport.Input != null, "Viewport should provide input mapper");
    }
}
