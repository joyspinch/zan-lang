using System;
using Gui;
using Game.Core;
using Game.Graphics;
using Game.Input;
using Game.Arpg;

class TestHero : Entity {
    public int updateCount;
    public InputMapper input;
    public int pressedSteps;

    TestHero(int id) : base(id, "hero") {
        this.updateCount = 0;
        this.Width = 32.0;
        this.Height = 32.0;
        this.Radius = 16.0;
    }

    static TestHero Create(int id) {
        return new TestHero(id);
    }

    override void OnFixedUpdate(Scene scene, double dt) {
        base.OnFixedUpdate(scene, dt);
        updateCount = updateCount + 1;
        if (input != null && input.IsActionJustPressed("fire")) { pressedSteps++; }
        this.X = this.X + 10.0 * dt;
    }
}

class PixelEntity : Entity {
    int color;
    public int renders;
    PixelEntity(int id, int color) : base(id, "pixel") { this.color = color; }
    public override void OnRender(Scene scene, Canvas c, double x, double y) {
        renders++;
        c.FillRect(0, 0, c.Width(), c.Height(), color);
    }
}

class PipelineSuite {
    static void Main() {
        TestSceneAndEntity();
        TestSpriteAndAnimator();
        TestInputMapper();
        TestGameViewport();
        TestCameraFixedSteps();

        Console.WriteLine("PIPELINE_ALL_PASSED");
    }

    static void Assert(bool cond, string msg) {
        if (!cond) {
            Console.WriteLine("[FAIL] " + msg);
            throw new Exception("Assertion failed: " + msg);
        }
    }

    static void TestSceneAndEntity() {
        Scene scene = Scene.Create("MainWorld", 1280, 720, 512);
        TestHero hero = TestHero.Create(scene.NextId());
        hero.X = 100.0;
        hero.Y = 200.0;
        scene.AddEntity(hero);

        scene.AdvanceFixedStep(0.01666667);
        scene.AdvanceFixedStep(0.01666667);

        Assert(hero.updateCount == 2, "Hero should have ticked 2 times");
        Assert(hero.X > 100.0, "Hero should move right");

        int[] outIds = new int[16];
        int hits = scene.SpatialGrid.QueryRange(hero.X, hero.Y, 30.0, outIds, 16);
        Assert(hits == 1 && outIds[0] == hero.Id, "SpatialGrid must auto-index the hero");

        Entity found = scene.FindById(hero.Id);
        Assert(found != null && found.Tag == "hero", "FindById should locate hero");

        hero.Destroy();
        scene.AdvanceFixedStep(0.01666667);
        Assert(scene.EntityCount == 0, "Destroyed entity must be collected");
    }

    static void TestSpriteAndAnimator() {
        SpriteSheet sheet = SpriteSheet.Create("hero_atlas", 256, 256, 32, 32);
        Assert(sheet.Cols == 8 && sheet.Rows == 8, "Sheet grid must be 8x8");

        float u0, v0, u1, v1;
        sheet.GetFrameUV(0, out u0, out v0, out u1, out v1);
        Assert(u0 == 0.0f && v0 == 0.0f, "Frame 0 UV must start at 0,0");

        DirectionalAnimator anim = DirectionalAnimator.Create(sheet, 8);
        anim.AddState("walk", 0, 4, 10.0, true);
        anim.Play("walk", 3, true);

        int g0 = anim.GetCurrentGlobalFrame();
        Assert(g0 == 24, "Initial global frame for dir 3 must be 24");

        anim.Update(0.1);
        int g1 = anim.GetCurrentGlobalFrame();
        Assert(g1 == 25, "Next global frame must be 25");
    }

    static void TestInputMapper() {
        InputMapper input = InputMapper.Create();
        Camera2D cam = Camera2D.Create(1280, 720);
        cam.X = 500.0;
        cam.Y = 300.0;

        IsoTileMap map = IsoTileMap.Create(64, 64, 64, 32);

        input.BindAction("Fire", 32);
        input.OnKeyDown(32);
        Assert(input.IsActionDown("Fire"), "Action Fire should be down");
        Assert(input.IsActionJustPressed("Fire"), "Action Fire should be just pressed");

        input.FlushFrameEvents();
        Assert(!input.IsActionJustPressed("Fire"), "Just pressed must be cleared after flush");
        Assert(input.IsActionDown("Fire"), "Action should remain down");

        input.OnMouseMove(640.0, 360.0);
        double wx, wy;
        input.GetWorldMouse(cam, out wx, out wy);
        Assert(Math.Abs(wx - 500.0) < 0.01 && Math.Abs(wy - 300.0) < 0.01, "Mouse should project to world center");

        int gx, gy;
        input.GetIsoGridMouse(cam, map, out gx, out gy);
        Assert(gx >= 0 && gy >= 0, "Iso grid coords must be non-negative");

        input.OnMouseButton(0, true);
        input.OnMouseMove(700.0, 420.0);
        Assert(input.IsDragging, "Mouse drag should activate selection box");

        double minX, minY, maxX, maxY;
        bool hasBox = input.GetSelectionWorldBox(cam, out minX, out minY, out maxX, out maxY);
        Assert(hasBox && maxX > minX && maxY > minY, "Selection box world coords must be valid");
    }

    static void TestGameViewport() {
        Scene scene = Scene.Create("ViewportScene", 800, 600, 128);
        GameViewport viewport = GameViewport.Create(scene);
        Assert(viewport.CurrentScene != null, "Viewport should hold current scene");
        Assert(viewport.Input != null, "Viewport should provide input mapper");

        App app = App.CreateOffscreen("Viewport pixels", 160, 120);
        Scene first = Scene.Create("red", 64, 48, 128);
        Scene second = Scene.Create("blue", 64, 48, 128);
        PixelEntity red = new PixelEntity(first.NextId(), 0xffc02030);
        PixelEntity blue = new PixelEntity(second.NextId(), 0xff2040c0);
        first.AddEntity(red);
        second.AddEntity(blue);
        first.AdvanceFixedStep(0.02);
        second.AdvanceFixedStep(0.02);
        Assert(first.WorldGen() == second.WorldGen(), "Regression scenes must share generation");
        viewport.CurrentScene = first;
        viewport.Arrange(17, 23, 64, 48);
        app.canvas.Clear(0xff102030);
        viewport.OnPaint(app);
        Assert(app.canvas.GetPixel(30, 35) == 0xffc02030, "Viewport must blit real first-scene pixels");
        Assert(app.canvas.GetPixel(16, 35) == 0xff102030, "Viewport blit must respect its origin");
        viewport.OnPaint(app);
        Assert(red.renders == 1, "Unchanged scene must reuse offscreen pixels");
        viewport.CurrentScene = second;
        viewport.OnPaint(app);
        Assert(app.canvas.GetPixel(30, 35) == 0xff2040c0, "Same-generation scene switch must replace cached pixels");
        Assert(blue.renders == 1, "Replacement scene must render immediately");
        viewport.activeScene = first;
        viewport.OnPaint(app);
        Assert(app.canvas.GetPixel(30, 35) == 0xffc02030, "Direct scene field replacement must also invalidate identity cache");
        viewport.CurrentScene = second;
        second.Clock.TimeScale = 0.0;
        viewport.Input.BindAction("fire", 32);
        viewport.Input.OnKeyDown(32);
        viewport.StepLogic();
        Assert(viewport.Input.IsActionJustPressed("fire"), "Zero-step pump must preserve pending input edge");
        TestHero reader = TestHero.Create(second.NextId());
        reader.input = viewport.Input;
        second.AddEntity(reader);
        second.Clock.accumulator = second.Clock.FixedDeltaTime * 3.1;
        viewport.StepLogic();
        Assert(reader.updateCount == 3 && reader.pressedSteps == 1, "Catch-up must expose pressed edge to only its first logic step");
        Assert(!viewport.Input.IsActionJustPressed("fire"), "Executed logic step must clear consumed input edge");
        viewport.off.Destroy();
        app.canvas.Destroy();
    }

    static void TestCameraFixedSteps() {
        Scene scene = Scene.Create("fixed camera", 64, 48, 128);
        scene.clock = new GameClock(0.02);
        scene.Clock.TimeScale = 0.0;
        scene.Camera.Shake(8.0, 1.0);
        for (int i = 0; i < 144; i++) { Assert(scene.Tick() == 0, "Paused clock must execute zero steps"); }
        Assert(scene.Camera.shakeTimer == 1.0, "Display-only refreshes must not age camera shake");
        scene.Clock.accumulator = 0.061;
        Assert(scene.Tick() == 3, "Accumulator must execute three catch-up steps");
        Assert(Math.Abs(scene.Camera.shakeTimer - 0.94) < 0.000001, "Camera shake must age once per fixed step");
        scene.AdvanceFixedStep(0.02);
        Assert(Math.Abs(scene.Camera.shakeTimer - 0.92) < 0.000001, "Direct fixed stepping must also advance camera");
    }
}
