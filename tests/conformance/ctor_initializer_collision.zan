using System;
using NsA;
namespace NsB;

// Two namespaces declare `Cfg`, so both get collision-mangled names. The
// arguments of a constructor's `: this(..)` / `: base(..)` initializer must
// be qualified like any other expression (B-ID199 round 7: gen1 skipped
// them -- `: this(GeckoViewConfig.CreateDefault())` did not resolve).
public struct Cfg {
    public int v;
    public static Cfg CreateDefault() { Cfg c = new Cfg(); c.v = 2; return c; }
}
public class Holder {
    public int v;
    public Holder(int x) { this.v = x; }
    public Holder() : this(Cfg.CreateDefault().v) { }
}
public class Sub : Holder {
    public Sub() : base(Cfg.CreateDefault().v + 10) { }
}
public class Program {
    public static void Main() {
        Console.WriteLine(UseA.Get().ToString() + " " + new Holder().v.ToString() + " " + new Sub().v.ToString());
    }
}
