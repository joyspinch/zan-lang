using System;
using System.Runtime.CompilerServices;

// 1. 用户自定义同名类 NativeMemory：不应被编译器底层 libc 拦截，必须走用户实现
class NativeMemory {
    public static nint Alloc(int size) {
        Console.WriteLine($"Custom NativeMemory.Alloc({size})");
        return (nint)12345;
    }

    public static void Free(nint ptr) {
        Console.WriteLine($"Custom NativeMemory.Free({ptr})");
    }
}

// 2. 用户自定义同名类 BitOperations：不应被 LLVM Intrinsics 拦截，必须走用户实现
class BitOperations {
    public static int PopCount(int val) {
        Console.WriteLine($"Custom BitOperations.PopCount({val})");
        return 999;
    }

    public static int LeadingZeroCount(int val) {
        Console.WriteLine($"Custom BitOperations.LeadingZeroCount({val})");
        return 888;
    }
}

// 3. 用户自定义同名类 String：不应被 strcmp 拦截
class String {
    public static int CompareOrdinal(string a, string b) {
        Console.WriteLine($"Custom String.CompareOrdinal({a}, {b})");
        return 777;
    }
}

// 4. 用户自定义同名方法 nameof
class CustomNameofHolder {
    public static string nameof(int id) {
        return $"CustomNameof_{id}";
    }
}

// 5. 用户类自定义 GetValueOrDefault
class CustomBox {
    public int Value;
    public CustomBox(int v) { this.Value = v; }
    public int GetValueOrDefault(int dflt) {
        return this.Value > 0 ? this.Value : dflt;
    }
}

class Program {
    static void Main() {
        // 验证 1：用户 NativeMemory 调用
        nint p = NativeMemory.Alloc(64);
        Console.WriteLine(p);
        NativeMemory.Free(p);

        // 验证 2：用户 BitOperations 调用
        int pop = BitOperations.PopCount(5);
        Console.WriteLine(pop);
        int lz = BitOperations.LeadingZeroCount(10);
        Console.WriteLine(lz);

        // 验证 3：用户 String 调用
        int cmp = String.CompareOrdinal("hello", "world");
        Console.WriteLine(cmp);

        // 验证 4：用户 nameof 与原生 nameof 共存
        Console.WriteLine(CustomNameofHolder.nameof(42));
        Console.WriteLine(nameof(CustomNameofHolder));

        // 验证 5：用户 GetValueOrDefault 与原生 Nullable.GetValueOrDefault 共存
        CustomBox box = new CustomBox(100);
        Console.WriteLine(box.GetValueOrDefault(0));
        int? nullableVal = 55;
        Console.WriteLine(nullableVal.GetValueOrDefault(10));
        int? nullVal = null;
        Console.WriteLine(nullVal.GetValueOrDefault(99));

        // 验证 6：标准库原生 Intrinsic 正常工作
        int stdPop = System.Numerics.BitOperations.PopCount(7);
        Console.WriteLine($"Stdlib PopCount(7): {stdPop}");
        nint realMem = System.NativeMemory.Alloc(32);
        Console.WriteLine($"Stdlib NativeMemory allocated: {realMem != (nint)0}");
        System.NativeMemory.Free(realMem);

        Console.WriteLine("INTRINSIC_DISPATCH_OK");
    }
}
