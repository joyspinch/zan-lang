// A454：值类型装箱/拆箱（显式 cast 与 is 判定）。
// 无托管字段的结构体可 (object) 装箱进堆对象（payload 顶格、无 vtable
// 槽，与结构体释放函数的字段偏移约定 class_vptr_offset==0 对齐）、
// is 按描述符 tyname 判定、(Point)o 显式拆箱校验失败时按运行期检查
// 软失败——在 try 里走 throw 路径可捕获，捕获后 EH 状态不被破坏，
// 原有箱仍可继续拆箱。含托管字段的结构体仍报 E2070（box_managed 探针
// 在 _scratch 留档；v1 边界：隐式装箱与方法分派不在本期）。
using System;

public struct Point {
    public int X;
    public int Y;
    public Point(int x, int y) { X = x; Y = y; }
    public int Sum() { return X + Y; }
}

public struct Counter {
    public int N;
    public Counter(int n) { N = n; }
}

class Program {
    static int ReadSum(object o) {
        Point p = (Point)o;
        return p.Sum();
    }

    static void Main() {
        object a = (object)new Point(3, 4);
        Console.WriteLine(a is Point);
        Console.WriteLine(ReadSum(a));
        Console.WriteLine(ReadSum(a));

        string s = "hello";
        object os = (object)s;
        Console.WriteLine(os is Point);
        Console.WriteLine(os is string);
        object b = (object)new Counter(9);
        Console.WriteLine(b is Point);

        int caught = 0;
        try {
            Point bad = (Point)os;
        } catch (Exception e) {
            caught = 1;
        }
        Console.WriteLine(caught);

        // 抛过之后 EH 状态完好，原有箱继续拆箱
        Console.WriteLine(ReadSum(a));

        // 循环里反复装箱拆箱（ARC 无泄漏、计数正确）
        int total = 0;
        for (int i = 0; i < 100; i++) {
            object t = (object)new Point(i, 1);
            if (t is Point) total += ReadSum(t);
        }
        Console.WriteLine(total);
    }
}
