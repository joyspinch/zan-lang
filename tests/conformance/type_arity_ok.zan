// 类型实参个数正确的写法必须被接受（回归用例）：
//
//   * 内建泛型：List 带一个实参，Dictionary/Dict 带两个；
//   * 用户泛型类：实参个数 = 声明的类型参数个数；
//   * 委托：Func/Action 的实参个数由返回类型和参数列表决定，不走
//     "泛型实参个数"这条规则（宿主对 Func/Action 不查个数）。
//
// 反例（实参个数不对）在编译期被拒绝，见
// tests/selfhost/reject/generic_arity.zan。
using System;
using System.Collections.Generic;

class Box<T> {
    public T value;
    public Box(T v) { value = v; }
}

class Program {
    static void Main() {
        List<int> xs = new List<int>();
        xs.Add(1);
        xs.Add(2);
        Dictionary<string, int> d = new Dictionary<string, int>();
        d.Add("k", 7);
        Dict<string, int> d2 = new Dict<string, int>();
        d2.Add("k", 8);
        Box<int> b = new Box<int>(3);
        int bv = b.value;
        Func<int, int> f = (int x) => x + 1;

        Console.WriteLine("count=" + Convert.ToString(xs.Count));
        Console.WriteLine("dict=" + Convert.ToString(d.Count));
        Console.WriteLine("dict2=" + Convert.ToString(d2.Count));
        Console.WriteLine("box=" + Convert.ToString(bv));
        Console.WriteLine("func=" + Convert.ToString(f(41)));
    }
}
