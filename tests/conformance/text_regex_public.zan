using System;
using System.Text.RegularExpressions;
using System.Text;

class Program {
    static int failures;

    static void Check(bool ok, string label) {
        if (!ok) {
            Program.failures = Program.failures + 1;
            Console.WriteLine("FAIL: " + label);
        } else {
            Console.WriteLine("OK: " + label);
        }
    }

    static void Main() {
        Program.Check(Regex.IsMatch("hello123world", @"\d+"), "Regex.IsMatch static");

        Regex re = new Regex(@"(\w+):(\d+)");
        Match m = re.Find("port:8080");
        Program.Check(m.Success(), "Regex match success");
        Program.Check(m.Group(1) == "port", "Regex group 1");
        Program.Check(m.Group(2) == "8080", "Regex group 2");

        Program.Check(Fuzzy.Matches("zan", "ZanWeb Framework"), "Fuzzy.Matches");

        Console.WriteLine("failures=" + Convert.ToString(Program.failures));
    }
}
