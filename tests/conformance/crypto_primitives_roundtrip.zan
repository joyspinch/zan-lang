using System;
using System.Security.Cryptography;

class Program {
    static void Main() {
        // 1. SHA-256
        byte[] empty = new byte[0];
        byte[] h256 = Sha256.Hash(empty);
        if (h256 != null) {
            string hex256 = Hex.Encode(h256);
            if (hex256.StartsWith("e3b0c442")) {
                Console.WriteLine("SHA256_EMPTY_OK");
            }
        }

        // 2. MD5
        byte[] hmd5 = Md5.Hash("hello", 5);
        if (hmd5 != null) {
            string hexmd5 = Hex.Encode(hmd5);
            if (hexmd5.Length == 32) {
                Console.WriteLine("MD5_LEN_OK");
            }
        }

        // 3. SHA-512
        byte[] h512 = Sha512.Hash("test", 4);
        if (h512 != null && h512.Length == 64) {
            Console.WriteLine("SHA512_LEN_OK");
        }

        // 4. SHA-1
        byte[] h1 = Sha1.Hash("test", 4);
        if (h1 != null && h1.Length == 20) {
            Console.WriteLine("SHA1_LEN_OK");
        }

        // 5. SM3
        byte[] hsm3 = Sm3.Hash("test", 4);
        if (hsm3 != null && hsm3.Length == 32) {
            Console.WriteLine("SM3_LEN_OK");
        }

        // 6. HMAC-SHA256
        byte[] key = new byte[] { 1, 2, 3, 4, 5, 6, 7, 8 };
        byte[] msg = new byte[] { 65, 66, 67 };
        byte[] mac = Hmac.Sha256(key, msg);
        if (mac != null && mac.Length == 32) {
            Console.WriteLine("HMAC_SHA256_OK");
        }

        // 7. AES-CBC Roundtrip
        string aesKey = "0123456789abcdef"; // 16 bytes
        string aesIv  = "abcdef9876543210"; // 16 bytes
        string plain  = "Hello Zan Production Crypto!";
        List<int> outLen = new List<int>();
        outLen.Add(0);
        byte[] cipher = Aes.EncryptCbc(aesKey, 16, aesIv, plain, plain.Length, outLen);
        if (cipher != null && outLen[0] > 0) {
            List<int> decLen = new List<int>();
            decLen.Add(0);
            string cipherStr = cipher;
            byte[] decrypted = Aes.DecryptCbc(aesKey, 16, aesIv, cipherStr, outLen[0], decLen);
            if (decrypted != null && decLen[0] == plain.Length) {
                Console.WriteLine("AES_CBC_OK");
            }
        }

        // 8. SM4-CBC Roundtrip
        string sm4Key = "0123456789abcdef";
        string sm4Iv  = "abcdef9876543210";
        List<int> sm4Out = new List<int>();
        sm4Out.Add(0);
        byte[] sm4Cipher = Sm4.EncryptCbc(sm4Key, sm4Iv, plain, plain.Length, sm4Out);
        if (sm4Cipher != null && sm4Out[0] > 0) {
            List<int> sm4DecLen = new List<int>();
            sm4DecLen.Add(0);
            string sm4CipherStr = sm4Cipher;
            byte[] sm4Dec = Sm4.DecryptCbc(sm4Key, sm4Iv, sm4CipherStr, sm4Out[0], sm4DecLen);
            if (sm4Dec != null && sm4DecLen[0] == plain.Length) {
                Console.WriteLine("SM4_CBC_OK");
            }
        }

        // 9. Base64 Roundtrip
        string b64 = Base64.Encode(msg);
        byte[] decB64 = Base64.Decode(b64);
        if (decB64 != null && decB64.Length == msg.Length) {
            Console.WriteLine("BASE64_ROUNDTRIP_OK");
        }

        // 10. PBKDF2
        string derivedHex = Pbkdf2.Hex("password", "salt", 1000);
        if (derivedHex != null && derivedHex.Length == 64) {
            Console.WriteLine("PBKDF2_OK");
        }
    }
}
