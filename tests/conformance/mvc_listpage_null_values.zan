using System;
using System.Web;
using Zan.Web;
using Zan.Web.Modules.Crud.Engine;

class Program {
    static void Check(string got, string want, string label) {
        if (got != want) { throw new Exception(label + ": " + got); }
        Console.WriteLine("ok " + label);
    }

    static int Main() {
        StrMap row = new StrMap();
        row.Set("note", null);
        ListCol column = new ListCol();
        column.field = "note";
        column.kind = "text";
        column.opts = "";
        Check(ListPage.Cell(column, row), "<td class=\"muted\">—</td>", "null text cell");
        column.kind = "muted";
        Check(ListPage.Cell(column, row), "<td class=\"muted\">—</td>", "null muted cell");
        column.kind = "flag";
        Check(ListPage.Cell(column, row), "<td></td>", "null flag cell");
        column.kind = "num";
        Check(ListPage.Cell(column, row), "<td class=\"num muted\"></td>", "null numeric cell");
        column.kind = "time";
        Check(ListPage.Cell(column, row), "<td class=\"muted\">—</td>", "null time cell");
        column.kind = "tag";
        Check(ListPage.Cell(column, row), "<td class=\"muted\"></td>", "null tag cell");
        row.Set("note", "<pending>");
        column.kind = "text";
        Check(ListPage.Cell(column, row), "<td class=\"ellip\" title=\"&lt;pending&gt;\">&lt;pending&gt;</td>",
            "non-null text remains escaped");
        row.Set("note", "approved|on");
        column.kind = "flag";
        Check(ListPage.Cell(column, row), "<td><span class=\"tag on\">approved</span></td>",
            "non-null flag remains visible");
        Console.WriteLine("MVC_LISTPAGE_NULL_VALUES_OK");
        return 0;
    }
}
