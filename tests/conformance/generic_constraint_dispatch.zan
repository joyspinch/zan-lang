using System;

namespace GenericConstraintDispatch;

interface IShape {
    int Area();
    string Name();
}

class Square : IShape {
    int side;
    static Square Of(int s) { Square q = new Square(); q.side = s; return q; }
    int Area() { return this.side * this.side; }
    string Name() { return "square"; }
}

class Circle : IShape {
    int r;
    static Circle Of(int r) { Circle c = new Circle(); c.r = r; return c; }
    int Area() { return 3 * this.r * this.r; }
    string Name() { return "circle"; }
}

// 接口数据协议与执行契约。
class Box<T> where T : IShape {
    T item;
    List<T> more;

    void Init(T v) {
        this.item = v;
        this.more = new List<T>();
    }

    void Add(T v) { this.more.Add(v); }

    int DirectArea() { return this.item.Area(); }
    string DirectName() { return this.item.Name(); }

    int ElementArea(int i) { return this.more[i].Area(); }

    int ViaLocal(int i) {
        T picked = this.more[i];
        return picked.Area();
    }

    int TotalArea() {
        int sum = 0;
        for (int i = 0; i < this.more.Count; i = i + 1) {
            sum = sum + this.more[i].Area();
        }
        return sum;
    }
}

class Program {
    static int SumAll<T>(List<T> items) where T : IShape {
        int sum = 0;
        for (int i = 0; i < items.Count; i = i + 1) {
            sum = sum + items[i].Area();
        }
        return sum;
    }

    static void Main() {
        Square three = Square.Of(3);
        Box<Square> sq = new Box<Square>();
        sq.Init(three);
        sq.Add(Square.Of(2));
        sq.Add(Square.Of(4));
        Console.WriteLine(sq.DirectArea());
        Console.WriteLine(sq.DirectName());
        Console.WriteLine(sq.ElementArea(1));
        Console.WriteLine(sq.ViaLocal(0));
        Console.WriteLine(sq.TotalArea());

        // 核心契约与语义定义。
        Circle two = Circle.Of(2);
        Box<Circle> ci = new Box<Circle>();
        ci.Init(two);
        ci.Add(Circle.Of(1));
        Console.WriteLine(ci.DirectArea());
        Console.WriteLine(ci.DirectName());
        Console.WriteLine(ci.TotalArea());

        List<Square> list = new List<Square>();
        list.Add(Square.Of(5));
        list.Add(Square.Of(6));
        Console.WriteLine(Program.SumAll<Square>(list));
    }
}
