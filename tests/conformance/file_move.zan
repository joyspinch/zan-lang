using System;
using System.IO;

// File.Move：正常移动（内容随迁、源消失）、覆盖已存在目标、
// 源不存在抛 FileNotFoundException、跨盘/非法目标抛 IOException
//（旧实现忽略 rename 返回值静默失败）。
class Program {
    static void Main() {
        string src = "_fmv_src.txt";
        string dst = "_fmv_dst.txt";
        File.Delete(src);
        File.Delete(dst);

        // 源不存在 → FileNotFoundException
        bool threwMissing = false;
        try {
            File.Move(src, dst);
        } catch (FileNotFoundException) {
            threwMissing = true;
        }
        Console.WriteLine("missing: " + Convert.ToString(threwMissing ? 1 : 0));

        // 正常移动：内容随迁，源消失
        File.WriteAllText(src, "payload-1");
        File.Move(src, dst);
        Console.WriteLine("moved: " + Convert.ToString(File.ReadAllText(dst) == "payload-1" ? 1 : 0));
        Console.WriteLine("src-gone: " + Convert.ToString(!File.Exists(src) ? 1 : 0));

        // 覆盖已存在目标（rename 语义）
        File.WriteAllText(src, "payload-2");
        File.Move(src, dst);
        Console.WriteLine("overwritten: " + Convert.ToString(File.ReadAllText(dst) == "payload-2" ? 1 : 0));
        Console.WriteLine("src-gone2: " + Convert.ToString(!File.Exists(src) ? 1 : 0));

        // 非法目标（目录段不存在）→ IOException
        bool threwBad = false;
        try {
            File.Move(dst, "_fmv_no_such_dir/x.txt");
        } catch (IOException) {
            threwBad = true;
        }
        Console.WriteLine("bad-dest: " + Convert.ToString(threwBad ? 1 : 0));
        Console.WriteLine("dst-alive: " + Convert.ToString(File.Exists(dst) ? 1 : 0));

        File.Delete(dst);
        Console.WriteLine("cleaned: " + Convert.ToString(!File.Exists(dst) ? 1 : 0));
    }
}
