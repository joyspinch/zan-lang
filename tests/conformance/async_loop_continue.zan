using System;

class ConformanceAsyncLoopContinue {
    static int nextCalls = 0;
    static int moreCalls = 0;

    static async int Next(int cur) {
        nextCalls = nextCalls + 1;
        await Task.Yield();
        return cur + 1;
    }

    static async bool More() {
        moreCalls = moreCalls + 1;
        await Task.Yield();
        return moreCalls < 3;
    }

    static async int TestForContinue() {
        int hit = -1;
        for (int i = 0; i < 3; i = await Next(i)) {
            if (i == 1) {
                hit = i;
                continue;
            }
        }
        return hit;
    }

    static async int TestDoWhileContinue() {
        int hit = 0;
        do {
            hit = hit + 1;
            if (hit == 1) {
                continue;
            }
        } while (await More());
        return hit;
    }

    static async void Main() {
        int forHit = await TestForContinue();
        int doHit = await TestDoWhileContinue();

        if (forHit != 1 || nextCalls != 3) {
            Console.WriteLine($"FAIL: forHit={forHit}, nextCalls={nextCalls}");
            Environment.Exit(1);
        }
        if (doHit != 3 || moreCalls != 3) {
            Console.WriteLine($"FAIL: doHit={doHit}, moreCalls={moreCalls}");
            Environment.Exit(2);
        }

        Console.WriteLine("PASS: async loop continue");
    }
}
