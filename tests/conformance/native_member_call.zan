using System;

namespace Conformance;

// 编译器原生实现的成员：不在任何成员表里，但确实存在。
//
// 踩过的坑：checker 判定「这个类型上有没有这个方法」时按成员表枚举，
// 而 int.Parse / string.ToBytes / string.AsSpan 这类是编译器原生分派的
// ——实现完全在编译器里，成员表里根本没有。结果合法调用被判成
// 「没有这个方法」，整个标准库都编不过。
//
// 这条用例钉住「原生成员必须算进成员集」：
//   int/long/double.Parse —— 标量上的原生静态方法；
//   string.ToBytes         —— string 上的原生实例方法（返回 byte[]）；
//   string.AsSpan          —— string 上的原生实例方法（返回 Span<char>）。
public class Program {
    static void Main() {
        int n = int.Parse("42");
        long m = long.Parse("10000000000");
        double d = double.Parse("3.5");
        string s = "abc";
        Console.WriteLine(n);
        Console.WriteLine(m);
        Console.WriteLine(d);
        Console.WriteLine(s.ToUpper());
        Console.WriteLine(s.Length);

        byte[] bytes = s.ToBytes();
        Console.WriteLine(bytes.Length);
        Console.WriteLine(bytes[0]);
        Console.WriteLine(s.AsSpan().Length);
    }
}
