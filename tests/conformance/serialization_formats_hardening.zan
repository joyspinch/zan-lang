using System;
using System.IO;
using System.Json;
using System.Csv;
using System.Yaml;
using System.Toml;
using System.Protobuf;
using System.MsgPack;

namespace Conf;

class Prog {
    static void Main() {
        // 1. Csv test
        string csvSrc = "name,score,note\nAlice,95,Top\n\"Bob, Jr.\",88,\"Line1\nLine2\"";
        CsvTable tbl = Csv.Parse(csvSrc);
        bool c1 = tbl.RowCount() == 2;
        bool c2 = tbl.Header().Count == 3;
        bool c3 = tbl.Column("name")[0] == "Alice" && tbl.Column("name")[1] == "Bob, Jr.";
        bool c4 = tbl.Column("note")[1] == "Line1\nLine2";
        string csvOut = Csv.Serialize(tbl.Rows());
        bool c5 = csvOut.Contains("Alice,95,Top") && csvOut.Contains("\"Bob, Jr.\"");
        Console.WriteLine(c1 && c2 && c3 && c4 && c5);

        // 2. Yaml test
        string yamlSrc = "server:\n  host: 127.0.0.1\n  port: 8080\nservices:\n  - auth\n  - payment\n";
        JsonValue yVal = Yaml.Parse(yamlSrc);
        bool y1 = yVal.IsObject() && yVal.Get("server")?.Get("port")?.AsInt(0) == 8080;
        bool y2 = yVal.Get("services")?.Count() == 2 && yVal.Get("services")?.At(0)?.AsString("") == "auth";
        string yOut = Yaml.ToYaml(yVal);
        bool y3 = yOut.Contains("host: 127.0.0.1") && yOut.Contains("- auth");
        Console.WriteLine(y1 && y2 && y3);

        // 3. Toml test
        string tomlSrc = "title = \"TOML Example\"\n\n[database]\nserver = \"192.168.1.1\"\nports = [ 8001, 8002 ]\nconnection_max = 5000\n";
        JsonValue tVal = Toml.Parse(tomlSrc);
        bool t1 = tVal.Get("title")?.AsString("") == "TOML Example";
        bool t2 = tVal.Get("database")?.Get("connection_max")?.AsInt(0) == 5000;
        bool t3 = tVal.Get("database")?.Get("ports")?.Count() == 2;
        string tOut = Toml.ToToml(tVal);
        bool t4 = tOut.Contains("title = \"TOML Example\"") && tOut.Contains("connection_max = 5000");
        Console.WriteLine(t1 && t2 && t3 && t4);

        // 4. Protobuf test
        ProtoWriter pw = new ProtoWriter();
        pw.WriteInt32(1, 42);
        pw.WriteString(2, "Hello Protobuf");
        pw.WriteDouble(3, 3.14159);
        pw.BeginMessage(4);
        pw.WriteString(1, "Nested Message");
        pw.EndMessage();
        byte[] pBytes = pw.ToBytes();

        ProtoReader pr = new ProtoReader(pBytes);
        int gotFields = 0;
        bool p1 = false;
        bool p2 = false;
        bool p3 = false;
        bool p4 = false;
        while (pr.Next()) {
            gotFields = gotFields + 1;
            int fn = pr.FieldNumber();
            if (fn == 1) {
                p1 = pr.ReadInt32() == 42;
            } else if (fn == 2) {
                p2 = pr.ReadString() == "Hello Protobuf";
            } else if (fn == 3) {
                double d = pr.ReadDouble();
                p3 = d > 3.14 && d < 3.15;
            } else if (fn == 4) {
                byte[] nested = pr.ReadMessage();
                ProtoReader npr = new ProtoReader(nested);
                if (npr.Next() && npr.FieldNumber() == 1) {
                    p4 = npr.ReadString() == "Nested Message";
                }
            }
        }
        Console.WriteLine(gotFields == 4 && p1 && p2 && p3 && p4);

        // 5. MsgPack test
        JsonValue mVal = JsonValue.NewObject();
        mVal.Put("id", JsonValue.NewInt(1001));
        mVal.Put("name", JsonValue.NewStr("Zan"));
        JsonValue items = JsonValue.NewArray();
        items.Append(JsonValue.NewInt(10));
        items.Append(JsonValue.NewInt(20));
        mVal.Put("items", items);

        byte[] mpBytes = MsgPack.Pack(mVal);
        JsonValue unVal = MsgPack.Unpack(mpBytes);
        bool m1 = unVal.Get("id")?.AsInt(0) == 1001;
        bool m2 = unVal.Get("name")?.AsString("") == "Zan";
        bool m3 = unVal.Get("items")?.Count() == 2 && unVal.Get("items")?.At(1)?.AsInt(0) == 20;
        Console.WriteLine(m1 && m2 && m3);
    }
}
