using System;
using System.Numerics;

class Program {
    [NoAlloc]
    static long RunOverflowAndBigMul() {
        bool ov1 = false;
        int s1 = BitOperations.OverflowAdd(2147483640, 100, ref ov1);
        bool ov2 = false;
        int s2 = BitOperations.OverflowAdd(10, 20, ref ov2);

        bool ov3 = false;
        uint u1 = BitOperations.OverflowSub(5u, 10u, ref ov3);
        bool ov4 = false;
        uint u2 = BitOperations.OverflowSub(20u, 5u, ref ov4);

        bool ov5 = false;
        long m1 = BitOperations.OverflowMul(1000000000000L, 1000000000000L, ref ov5);
        bool ov6 = false;
        ulong m2 = BitOperations.OverflowMul(1000ul, 2000ul, ref ov6);

        // Unsigned 64x64 -> 128-bit widening multiply:
        // (1ul << 60) * 32ul = 32 * 2^60 = 2^65 -> hi = 2, lo = 0
        ulong ulo = 0ul;
        ulong uhi = BitOperations.BigMul(0x1000000000000000ul, 32ul, ref ulo);

        // Exact full-width test: 0xFFFFFFFFFFFFFFFF * 2 = hi:1, lo:0xFFFFFFFFFFFFFFFE
        ulong ulo2 = 0ul;
        ulong uhi2 = BitOperations.BigMul(0xFFFFFFFFFFFFFFFFul, 2ul, ref ulo2);

        // Signed 64x64 -> 128-bit: (-2L) * 4L = -8 -> hi = -1L, lo = -8L
        long slo = 0L;
        long shi = BitOperations.BigMul(-2L, 4L, ref slo);

        int ok = (ov1 && !ov2 && s2 == 30 &&
                  ov3 && u1 == 4294967291u && !ov4 && u2 == 15u &&
                  ov5 && !ov6 && m2 == 2000000ul &&
                  uhi == 2ul && ulo == 0ul &&
                  uhi2 == 1ul && ulo2 == 0xFFFFFFFFFFFFFFFEul &&
                  shi == -1L && slo == -8L && s1 < 0 && m1 != 0L) ? 1 : 0;
        return (long)ok * 1000L + (long)uhi * 100L + (long)s2;
    }

    static int Main() {
        long r = RunOverflowAndBigMul();
        Console.WriteLine($"r={r}");
        return 0;
    }
}
