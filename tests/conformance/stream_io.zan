using System;
using System.IO;

class Program {
    static void Main() {
        // 接口数据协议与执行契约。
        MemoryStream ms = MemoryStream.Alloc(8);
        ms.Write("hello ");
        ms.Write("world");
        Console.WriteLine("mem_len=" + ms.Length());
        Console.WriteLine("mem_pos=" + ms.Position());
        ms.SeekTo(0);
        Console.WriteLine("mem_head=" + ms.Read(5));
        Console.WriteLine("mem_rest=" + ms.ReadToEnd());
        Console.WriteLine("mem_all=" + ms.ToStr());
        Console.WriteLine("mem_eof=" + ms.Read(4).Length);
        ms.SeekTo(0);
        Console.WriteLine("mem_byte=" + ms.ReadByte());
        Console.WriteLine("mem_seek_end=" + ms.Seek(-5, 2));
        Console.WriteLine("mem_remaining=" + ms.Remaining());
        ms.Close();
        Console.WriteLine("mem_closed_len=" + ms.Length());

        // 核心契约与语义定义。
        string p = "stream_case.tmp";
        StreamWriter w = new StreamWriter(p);
        w.WriteLine("line1");
        w.WriteLine("line2");
        w.Write("tail");
        w.Close();

        // 核心契约与语义定义。
        StreamReader r = StreamReader.Open(p);
        string line = r.ReadLine();
        while (line != null) {
            Console.WriteLine("line=[" + line + "]");
            line = r.ReadLine();
        }
        Console.WriteLine("eos=" + r.EndOfStream());
        r.Close();

        // 接口数据协议与执行契约。
        FileStream fs = FileStream.OpenRead(p);
        Console.WriteLine("fs_can=" + fs.CanRead() + fs.CanWrite() + fs.CanSeek());
        Console.WriteLine("fs_len=" + fs.Length());
        Console.WriteLine("fs_head=" + fs.Read(5));
        Console.WriteLine("fs_pos=" + fs.Position());
        fs.Seek(-4, 2);
        Console.WriteLine("fs_tail=" + fs.ReadToEnd());
        fs.Close();
        Console.WriteLine("fs_closed=" + fs.IsClosed());

        // 核心契约与语义定义。
        MemoryStream copy = MemoryStream.Alloc(4);
        FileStream src = FileStream.OpenRead(p);
        Console.WriteLine("copied=" + src.CopyTo(copy));
        src.Close();
        Console.WriteLine("copy_all=" + copy.ToStr().Length);
        copy.Close();

        // 核心契约与语义定义。
        StreamWriter ap = StreamWriter.Append(p);
        ap.Write("+more");
        ap.Close();
        StreamReader ar = StreamReader.Open(p);
        Console.WriteLine("appended=" + ar.ReadToEnd().Length);
        ar.Close();

        // 核心契约与语义定义。
        FileStream rw = FileStream.OpenWrite(p);
        rw.SeekTo(0);
        rw.Write("LINE1");
        rw.Flush();
        rw.SeekTo(0);
        Console.WriteLine("rw_head=" + rw.Read(5));
        rw.Close();

        // 核心契约与语义定义。
        StreamReader sr = StreamReader.FromStr("a\r\nb\nc");
        List<string> lines = sr.ReadAllLines();
        Console.WriteLine("lines=" + lines.Count + ":" + lines[0] + lines[1] + lines[2]);
        sr.Close();

        // 接口数据协议与执行契约。
        MemoryStream shared = MemoryStream.Alloc(16);
        StreamWriter sw2 = StreamWriter.Wrap(shared);
        sw2.WriteLine("wrapped");
        sw2.Close();
        shared.SeekTo(0);
        StreamReader sr2 = StreamReader.Wrap(shared);
        Console.WriteLine("wrapped=[" + sr2.ReadLine() + "]");
        sr2.Close();
        shared.Close();

        // 核心契约与语义定义。
        MemoryStream bs = MemoryStream.Alloc(4);
        bs.WriteByte(65);
        bs.WriteByte(66);
        bs.SeekTo(0);
        Console.WriteLine("bytes=" + bs.ReadByte() + "," + bs.ReadByte() + "," + bs.ReadByte());
        bs.Close();

        // 接口数据协议与执行契约。
        try {
            FileStream missing = FileStream.OpenRead("stream_absent.tmp");
            Console.WriteLine("unreached=" + missing.Length());
        } catch (FileNotFoundException e) {
            Console.WriteLine("missing=caught");
        }

        File.Delete(p);
        Console.WriteLine("deleted=" + File.Exists(p));
    }
}
