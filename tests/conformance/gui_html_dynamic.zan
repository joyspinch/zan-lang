// 文档动态原语（<template data-for> / :visible）的运行时通道无头用例。
// Html.Parse 建树 → ChildWindow 挂强类型模型：模板行按源列表克隆展开、
// 行内 bind/:visible 以本项为第一作用域、列表变化调和、行内与根级双向回写。
// 不泵事件，经 App 同步与回写模型宿主。
using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

class DynItem {
    public string name;
    public string qty;
    public bool on;

    public DynItem(string name, string qty, bool on) {
        this.name = name;
        this.qty = qty;
        this.on = on;
    }
}

class DynModel {
    public bool flag = true;
    public string title = "hello";
    public string city = "Shanghai";
    public List<string> cities;
    public List<DynItem> items;

    public DynModel() {
        cities = new List<string>();
        cities.Add("Beijing");
        cities.Add("Shanghai");
        items = new List<DynItem>();
        items.Add(new DynItem("a", "1", true));
        items.Add(new DynItem("b", "2", false));
    }
}

class DynConfWin : ChildWindow {
    public void Attach(App app, Control tree, object model) {
        host = app;
        open = true;
        this.SetView(tree, model);
    }
}

class GuiHtmlDynamic {
    static int fails;
    static string picked;
    static int pickCount;
    static DynItem pickedScope;

    static void Eq(string what, string got, string want) {
        if (got == want) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what + ": got '" + got
            + "' want '" + want + "'");
    }

    // visible 是布尔：ToString 对布尔的字面量口径在 "1"/"0" 与
    // "true"/"false" 之间变过——断言只认真假，不认字面量。
    static string Vis(bool v) { return v ? "1" : "0"; }

    static void Main() {
        fails = 0;
        // 模板行展开经 App 克隆槽（Gui.Html.Install 注册）：App 编译图
        // 不背 HTML 声明层，用 template data-for 的宿主必须先装；行内
        // Input/Button 等控件克隆走 ControlFactory kind 重建，还得
        // ControlBootstrap.Install 注册标准 kind（先注册后可用）。
        Html.Install();
        picked = "";
        pickCount = 0;
        string html = "<div>"
            + "<template data-for=\"items\">"
            + "<li class=\"row\" @click=\"pickrow\"><span bind=\"name\"></span>"
            + "<input bind=\"qty\" :visible=\"on\" />"
            + "<button data-on-click=\"pick\" data-arg=\"rowqty\">Go</button></li>"
            + "</template>"
            + "<input bind=\"title\" :visible=\"flag\" />"
            + "</div>"
            + "<div><button data-on-click=\"pick\" data-arg=\"apple\">P</button></div>"
            + "<div><select bind=\"city\" :options=\"cities\"></select></div>";
        HtmlDoc doc = Html.Parse(html, "", null);
        Control rootT = doc.root;
        Control div = rootT.ChildAt(0);

        // 未挂模型：动态原语惰性——原型隐藏，不展开、不插拔。
        DynConfWin w = new DynConfWin();
        App app = App.CreateOffscreen("gui-html-dynamic", 400, 300);
        w.Attach(app, rootT, null);
        GuiHtmlDynamic.Eq("inert kids", Convert.ToString(div.ChildCount()), "2");

        DynModel model = new DynModel();
        w.HandleArg("pick", (string s) => { picked = s;
                                           pickCount = pickCount + 1; });
        w.HandleItem("pickrow", (Control sender, object value) => {
            if (value is DynItem) { pickedScope = (DynItem)value; }
        });
        w.SetView(rootT, model);

        // 首展：模板后两行 li（每项克隆一个原型子项），行内作用域
        // 推送与插拔同时生效。
        GuiHtmlDynamic.Eq("expanded kids",
                          Convert.ToString(div.ChildCount()), "4");
        Control row0 = div.ChildAt(1);
        Control row1 = div.ChildAt(2);
        Control title = div.ChildAt(3);
        GuiHtmlDynamic.Eq("row0 kind", row0.Kind(), "li");
        GuiHtmlDynamic.Eq("row0 name", row0.ChildAt(0).GetProp("text"), "a");
        GuiHtmlDynamic.Eq("row1 name", row1.ChildAt(0).GetProp("text"), "b");
        GuiHtmlDynamic.Eq("inp0 shown",
                          Vis(row0.ChildAt(1).visible), "1");
        GuiHtmlDynamic.Eq("inp1 hidden",
                          Vis(row1.ChildAt(1).visible), "0");

        // 行根本身没有绑定声明，事件仍须取得本项作用域。
        row0.Click.Raise();
        DynItem rowScope = pickedScope;
        GuiHtmlDynamic.Eq("row root scope",
                          (rowScope == null) ? "" : rowScope.name, "a");
        pickedScope = null;
        row1.Click.Raise();
        DynItem rowScope1 = pickedScope;
        GuiHtmlDynamic.Eq("row1 root scope",
                          (rowScope1 == null) ? "" : rowScope1.name, "b");

        // 根级 :visible 插拔。
        GuiHtmlDynamic.Eq("title shown",
                          Vis(title.visible), "1");
        model.flag = false;
        app.SyncModelHosts();
        GuiHtmlDynamic.Eq("title hidden",
                          Vis(title.visible), "0");

        // 同根替换列表 → 按实际源身份调和。
        model.items = new List<DynItem>();
        model.items.Add(new DynItem("a", "1", true));
        app.SyncModelHosts();
        GuiHtmlDynamic.Eq("shrunk kids",
                          Convert.ToString(div.ChildCount()), "3");

        // 行内回写（改克隆 span 的文本 → items[0].name）与根级回写。
        div.ChildAt(1).ChildAt(0).SetProp("text", "z");
        title.SetProp("value", "changed");
        app.WriteBackModelHosts();
        GuiHtmlDynamic.Eq("row writeback", model.items[0].name, "z");
        GuiHtmlDynamic.Eq("root writeback", model.title, "changed");

        // data-arg 带参事件：静态按钮与模板行按钮都把 data-arg 快照闭包进
        // 处理器；带参槽未命中不挤占无参 Handle 同名条目。
        Control argDiv = rootT.ChildAt(1);
        ((Button)argDiv.ChildAt(0)).Click.Raise();
        GuiHtmlDynamic.Eq("static arg", picked, "apple");
        GuiHtmlDynamic.Eq("static fires once",
                          Convert.ToString(pickCount), "1");
        Control rowBtn = div.ChildAt(1).ChildAt(2);
        ((Button)rowBtn).Click.Raise();
        GuiHtmlDynamic.Eq("row arg", picked, "rowqty");
        GuiHtmlDynamic.Eq("row fires twice",
                          Convert.ToString(pickCount), "2");

        // 强类型字符串列表驱动选项绑定。
        Control selDiv = rootT.ChildAt(2);
        SelectBox citySel = (SelectBox)selDiv.ChildAt(0);
        GuiHtmlDynamic.Eq("city init sel", citySel.SelectedValue(), "Shanghai");
        citySel.Select(0);
        app.WriteBackModelHosts();
        GuiHtmlDynamic.Eq("city writeback", model.city, "Beijing");

        citySel = null;
        rootT = null;
        doc = null;
        model = null;
        w.Teardown();

        if (fails == 0) {
            Console.WriteLine("GUI_HTML_DYNAMIC_OK");
        } else {
            Console.WriteLine("GUI_HTML_DYNAMIC_FAILS " + fails);
        }
    }
}
