using System;
using System.Threading;

// `await h` on a stored Task handle inside a coroutine suspends until the
// task is done and yields its result (B-ID199 round 6). The host used to
// treat the handle as a child frame (no wait, garbage result); gen1 pumped
// the scheduler from inside a worker step and deadlocked on the M:N pool.
class Program {
    static int flag = 0;
    static async int Slow(int v) { await Task.Delay(30); flag = flag + 1; return v; }

    static async int Flow() {
        Task<int> t = Task.Run(Slow(42));
        int v = await t;
        Console.WriteLine("local: " + v.ToString() + " ran: " + flag.ToString());

        Task u = Task.Run(() => { Thread.Sleep(30); flag = 10; });
        await u;
        Console.WriteLine("void: " + flag.ToString());

        List<Task<int>> pending = new List<Task<int>>();
        pending.Add(Task.Run(Slow(7)));
        int w = await pending[0];
        Console.WriteLine("element: " + w.ToString());
        return v + w;
    }

    static void Main() {
        int r = await Flow();
        Console.WriteLine("sum: " + r.ToString());
    }
}
