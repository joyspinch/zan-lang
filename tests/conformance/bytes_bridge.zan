using System;

// The byte[] <-> string bridges and the ordinal string compare are compiler
// intrinsics in the C host (irgen_call.c / irgen_expr.c), not stdlib
// methods. The self-hosted backend has to lower them the same way.
class Program {
    static void Main() {
        string s = "hello";
        byte[] b = s.ToBytes();
        Console.WriteLine("len=" + Convert.ToString(b.Length));
        Console.WriteLine("all=" + b.ToStr(0, b.Length));
        Console.WriteLine("win=" + b.ToStr(1, 3));

        string t = "he";
        byte[] c = t.ToBytes();
        Console.WriteLine("tlen=" + Convert.ToString(c.Length));
        Console.WriteLine("tall=" + c.ToStr(0, c.Length));

        Console.WriteLine("eq=" + Convert.ToString(String.CompareOrdinal("abc", "abc")));
        Console.WriteLine("lt=" + Convert.ToString(String.CompareOrdinal("abc", "abd") < 0 ? 1 : 0));
        Console.WriteLine("gt=" + Convert.ToString(String.CompareOrdinal("abd", "abc") > 0 ? 1 : 0));
    }
}
