using System;

class Program {
    static async int FastAdd(int a, int b) {
        return a + b;
    }

    static async int SlowAdd(int a, int b) {
        await Task.Delay(2);
        return a + b;
    }

    static async int FastThrow() {
        throw new Exception("fast failure");
    }

    static async int TestFlow() {
        int sum = 0;
        // 核心契约与语义定义。
        for (int i = 0; i < 5; i++) {
            int part = await FastAdd(i, 10);
            sum = sum + part;
        }

        // 核心契约与语义定义。
        Task t = Task.Run(() => {
        });
        await t;

        // 核心契约与语义定义。
        sum = sum + (await FastAdd(1, 2));
        sum = sum + (await SlowAdd(3, 4));
        sum = sum + (await FastAdd(5, 6));

        // 核心契约与执行状态转移规范。
        int caught = 0;
        try {
            await FastThrow();
        } catch (Exception ex) {
            caught = 1;
        }

        if (caught == 1) {
            sum = sum + 100;
        }

        return sum;
    }

    static void Main() {
        int result = await TestFlow();
        Console.WriteLine("flow result: " + Convert.ToString(result));
    }
}
