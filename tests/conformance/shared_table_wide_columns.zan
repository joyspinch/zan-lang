using System.Threading;

class Program {
    static void Main() {
        string name = "zan_conformance_wide_columns";
        SharedTable stale = SharedTable.Open(name);
        if (stale.IsOpen()) {
            stale.Destroy();
        }

        // 核心契约与语义定义。
        SharedTable table = new SharedTable(name, 8);
        for (int i = 0; i < 24; i = i + 1) {
            string colName = "c" + i;
            if (i % 3 == 0) {
                table.ColumnInt(colName);
            } else if (i % 3 == 1) {
                table.ColumnFloat(colName);
            } else {
                table.ColumnString(colName, 32);
            }
        }

        bool created = table.Create();
        if (created) {
            Console.WriteLine("created: 1");
        } else {
            Console.WriteLine("created: 0");
        }

        // 核心契约与执行状态转移规范。
        table.SetInt("row1", "c0", 100);
        table.SetFloat("row1", "c1", 3.14);
        table.SetString("row1", "c2", "val2");
        table.SetInt("row1", "c21", 2100);
        table.SetFloat("row1", "c22", 22.5);
        table.SetString("row1", "c23", "val23");

        // 核心契约与执行状态转移规范。
        Console.WriteLine(table.GetInt("row1", "c0"));
        Console.WriteLine((int)table.GetFloat("row1", "c1"));
        Console.WriteLine(table.GetString("row1", "c2"));
        Console.WriteLine(table.GetInt("row1", "c21"));
        Console.WriteLine((int)table.GetFloat("row1", "c22"));
        Console.WriteLine(table.GetString("row1", "c23"));

        // 核心契约与执行状态转移规范。
        Console.WriteLine(table.ColumnCount());

        // 核心契约与执行状态转移规范。
        Console.WriteLine(table.Increment("row1", "c21", 50));
        Console.WriteLine(table.GetInt("row1", "c21"));

        table.Destroy();
        Console.WriteLine("done");
    }
}
