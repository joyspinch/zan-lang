using System;
using Gui;
using Gui.Widget;

namespace Tests.InputNumberLifecycle;

class Program {
    static void DrainPosts() {
        Action action = Dispatcher.Take();
        while (action != null) {
            action();
            action = Dispatcher.Take();
        }
    }

    static void Main() {
        Dispatcher.Init();
        InputNumber number = new InputNumber(0, 20);
        number.stepV = 3;
        int changes = 0;
        int submits = 0;
        number.Change.Add(() => { changes = changes + 1; });
        number.Submit.Add(() => { submits = submits + 1; });

        Button minus = number.minusBtn;
        Button plus = number.plusBtn;
        Input input = number.inputNode;
        plus.Click.RaiseS(plus);
        Console.WriteLine("click-plus=" + Convert.ToString(number.Value() == 3 && changes == 1));
        minus.TriggerEvent("Click");
        Program.DrainPosts();
        Console.WriteLine("routed-minus=" + Convert.ToString(number.Value() == 0 && changes == 2));
        plus.TriggerEvent("Click");
        Program.DrainPosts();
        minus.Click.RaiseS(minus);
        Console.WriteLine("both-directions=" + Convert.ToString(number.Value() == 0 && changes == 4));

        number.Loading = true;
        plus.Click.RaiseS(plus);
        minus.Click.RaiseS(minus);
        number.Loading = false;
        number.Disabled = true;
        plus.TriggerEvent("Click");
        Program.DrainPosts();
        plus.Click.RaiseS(plus);
        number.Disabled = false;
        Console.WriteLine("step-guards=" + Convert.ToString(number.Value() == 0 && changes == 4));

        bool inserted = input.Insert("17");
        Console.WriteLine("typed-change=" + Convert.ToString(inserted
            && number.Value() == 17 && changes == 5 && submits == 0));
        input.SetText("9");
        input.Submit.RaiseS(input);
        Console.WriteLine("submit-reads-text=" + Convert.ToString(number.Value() == 9
            && changes == 6 && submits == 1));
        input.SetText("99");
        input.Submit.RaiseS(input);
        input.Submit.RaiseS(input);
        Console.WriteLine("submit-clamp-and-repeat=" + Convert.ToString(number.Value() == 20
            && changes == 7 && submits == 3));
        input.SetText("");
        input.Change.RaiseS(input);
        Console.WriteLine("empty-change=" + Convert.ToString(number.Value() == 20 && changes == 7));

        // Queued actions and retained child events must not keep their owner alive.
        WeakReference<InputNumber> lifetime = new WeakReference<InputNumber>(number);
        SignalInt model = number.model;
        plus.TriggerEvent("Click");
        minus.TriggerEvent("Click");
        number = null;
        Console.WriteLine("owner-released=" + Convert.ToString(!lifetime.IsAlive));
        Program.DrainPosts();
        plus.Click.RaiseS(plus);
        minus.Click.RaiseS(minus);
        input.Insert("5");
        input.Submit.RaiseS(input);
        Console.WriteLine("expired-actions-no-op=" + Convert.ToString(!lifetime.IsAlive
            && model.Get() == 20 && changes == 7 && submits == 3));
        Dispatcher.Clear();
        WeakReference<UiEvent> minusClick = new WeakReference<UiEvent>(minus.Click);
        WeakReference<UiEvent> plusClick = new WeakReference<UiEvent>(plus.Click);
        minus = null;
        plus = null;
        input = null;
        // TriggerEvent's bare Click getter must release its temporary ownership.
        Console.WriteLine("click-events-released=" + Convert.ToString(!minusClick.IsAlive
            && !plusClick.IsAlive));
    }
}
