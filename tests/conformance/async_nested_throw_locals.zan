using System;

class Program {
    // 核心契约与语义定义。
    static void Deep() {
        throw new ArgumentException("bad");
    }

    static async int Do() {
        Program.Deep();
        return 1;
    }

    static async void Main() {
        string tmp = "plain-literal-string";
        List<string> lst = new List<string>();
        lst.Add("x");
        try {
            int r = await Program.Do();
        } catch (ArgumentException e) {
        }
        Console.WriteLine("len=" + Convert.ToString(tmp.Length));
        Console.WriteLine("cnt=" + Convert.ToString(lst.Count));
    }
}
