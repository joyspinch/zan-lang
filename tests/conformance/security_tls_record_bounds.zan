// Conformance: TLS record-layer fail-closed bounds — Alert must be exactly
// 2 bytes, CCS exactly 1 byte of value 1 and only in a matching state, TLS 1.3
// KeyUpdate rejected instead of silently ignored, oversized records rejected —
// plus server PEM chain-bundle sending (leaf first, intermediate second) and
// trust-bundle candidate traversal (a damaged first path must not block later
// ones). Root/intermediate/leaf generated with OpenSSL RSA-SHA256, valid
// 2026-09-28 through 2036-09-25; leaf SAN chain.example.
using System;
using System.IO;
using System.Net.Sockets;
using System.Net.Tls;
using System.Security.Cryptography;

class Program {
    static int failures = 0;

    static void Check(bool ok, string name) {
        if (ok) { Console.WriteLine("ok " + name); }
        else { Console.WriteLine("FAIL " + name); failures = failures + 1; }
    }

    static string ROOT_B64 = "";
    static string INTER_B64 = "";
    static string LEAF_B64 = "";
    static string LEAF_KEY = "-----BEGIN PRIVATE KEY-----\n"
        + "MIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQCQD4We4DY7v9b6\n"
        + "N0CHhVtO0ejLjWzgmfllDsRFa5ukWg6jSAzigj3hK6Ia6tvaNaVCUlwjM9/PnBQ6\n"
        + "k6osOyenaw5WSrAbCYYxnfyHHE5WuDNM3Uuxtx2geQH9g5xm+R3NR4B4pi6PJceo\n"
        + "8K5SQ6deWu+hoJvhwt/d8UPWrdQdX5qUefbXzYTBxgw7qkyNcSXStAVSNhy3G0CM\n"
        + "jf1TEVGXwC2Q2ePxozZ1RAGVJtEWGTv8jq5mb88McBVx+SqfmtIqNuw2t1ZQ0IUM\n"
        + "dpQggMnQipy2inTLXY03H6Yy957K2iuKx/Dy9XGEzMR6QtaQI6KtRMOIzLuwzhUo\n"
        + "nnOKsSxPAgMBAAECggEANpXzEwKw+g3URuYlqNQih2ipNWvGnAorwhuIyiceh/Vp\n"
        + "w3vbCf7AtK/EUj+4g2O9VTaA3APdY7ynu5RVMEJP4bOCcLcHKI+Azg8nbwiONHTC\n"
        + "V3copdOVQcdoNiem3Su6m5xitRR+4tW1ZDGiU+B3rBx33T3OowokqmOvSUp/a4tL\n"
        + "A40hkUE10uytODEH0DbrC4xeU9QJjrqqWjLWoQJgMu/r3aFZBe1dYiJ5aTauIjN/\n"
        + "a7Vt1HSnB/rpvl0SZwK10onATq9BwyuUqhEw6fugO8xNhTopJSTeyHRZJST8smJ2\n"
        + "/ugvcal+z6UjBABvMHsAu5VLwlYSt4h0lU16TSuA5QKBgQDJcvLHmy2eW1/sroPB\n"
        + "4LaqyAvZcYtU9PPiLIeKdRSW6uD7Ah8dvo44N3qM8xqZazyLCp4xpZy6ADItmbz5\n"
        + "Yog/FwQ9zJgy6QT2eiT6UJbgLHE72Nkj6w/2OU7V/cLyF+9aPlRXH9yZfTo/6q9i\n"
        + "s7aqKGLHxPFPVLTshGUsBgIYYwKBgQC3Ejz715UhoR6PtIIM1FFrEBss7qhtBTeW\n"
        + "0ZPgHnxiX/cHaIw41rbBNN2r1Ls4fPxAS7UKJ1Prgt5uWCGg1qvglMhAhpGgUOke\n"
        + "sNsP6o6eUt+jnz+s2b8RUhnt6yzKMHbwj+1/MqW1EJ58KFN1AZfRd6k70F/CoU/F\n"
        + "FYpZTMeiJQKBgQC+4mESqwQrDcJzb1oCGIB+i1hPDrxMIGAIbNFybUa5So8syfHa\n"
        + "KXpx4oAJl0IZJfgUeFc2DAvaY90oQIlEdg1MWu718Cw38X12YH8xgbO1b+dMIkp/\n"
