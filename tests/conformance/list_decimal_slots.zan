using System;
using System.Collections.Generic;

class ListDecimalSlots {
    static void Main() {
        decimal exact = 9007199254740993m;
        List<decimal> values = new List<decimal>();
        values.Add(exact);
        Console.WriteLine(values[0] == exact);
        values.Add(0.3m);
        Console.WriteLine(values[0] == exact);
        Console.WriteLine(values[1] == 0.3m);
        Console.WriteLine(values.Contains(0.3m));
        Console.WriteLine(values.Contains(exact));
        values[0] = 0.1m;
        Console.WriteLine(values[0] == 0.1m);
        Console.WriteLine(values[1] == 0.3m);
        decimal[] snapshot = values.ToArray();
        Console.WriteLine(snapshot[0] == 0.1m);
        Console.WriteLine(snapshot[1] == 0.3m);
        values.Clear();
        Console.WriteLine(snapshot[0] == 0.1m);
        Console.WriteLine(snapshot[1] == 0.3m);
        values.Add(1.00m);
        Console.WriteLine(values.Contains(1m));
        Console.WriteLine(!values.Contains(2m));
        for (int i = 0; i < 20; i++) { values.Add(exact + i); }
        Console.WriteLine(values[20] == exact + 19m);
        Console.WriteLine(values[1] == exact);
    }
}
