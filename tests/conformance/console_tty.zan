using System;

// TTY 探测：Console.IsOutputRedirected() / Console.IsTerminal()。
//
// 只能断言"关系"不能断言"值"——conformance 跑的时候 stdout 是管道还是
// 终端取决于环境（跑在管道里 = 已重定向），值会变；两个判定必须严格互补、
// 重复求值必须一致，这些是环境无关的。
class Program {
    static int failures = 0;

    static void Check(string label, bool ok) {
        if (!ok) {
            failures = failures + 1;
            Console.WriteLine("FAIL: " + label);
        }
    }

    static void Main() {
        bool redirected = Console.IsOutputRedirected();
        bool terminal = Console.IsTerminal();

        Check("redirected and terminal are complementary", redirected != terminal);
        Check("terminal is stable across calls", Console.IsTerminal() == terminal);
        Check("redirected is stable across calls",
              Console.IsOutputRedirected() == redirected);

        // 能直接当条件用（是 bool 值，不是整数）。
        bool seen = false;
        if (terminal) {
            seen = true;
        } else {
            seen = false;
        }
        Check("usable as a condition", seen == terminal);

        // 取反后与另一个判定一致。
        Check("negated terminal equals redirected", !terminal == redirected);

        if (failures == 0) {
            Console.WriteLine("TTY PROBE OK");
        } else {
            Console.WriteLine("TTY PROBE FAILURES: " + Convert.ToString(failures));
        }
    }
}
