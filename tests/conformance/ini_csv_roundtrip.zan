// IniFile + Csv test: INI parse/serialize round-trip with sections, keys,
// comments and inline values; CSV round-trip with quoting, embedded
// separator, quote doubling and newlines.
using System;
using System.Csv;
using System.IO;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        // --- INI ---
        IniFile ini = IniFile.Parse(
            "; comment\n"
            + "# hash comment\n"
            + "[server]\n"
            + "host=127.0.0.1\n"
            + "port = 8080\n"
            + "[logging]\n"
            + "level=debug\n");
        string host = ini.GetString("server", "host", "");
        if (host != "127.0.0.1") { bad = bad + 1; }
        int port = ini.GetInt("server", "port", -1);
        if (port != 8080) { bad = bad + 1; }
        // Missing keys fall back.
        if (ini.GetString("server", "nope", "fb") != "fb") { bad = bad + 1; }
        if (ini.GetInt("missing", "x", -5) != -5) { bad = bad + 1; }
        // Section/key enumeration (missing lookups must not create sections).
        List<string> secs = ini.EnumSections();
        if (secs.Count != 2) { bad = bad + 1; }
        if (secs[0] != "server" || secs[1] != "logging") { bad = bad + 1; }
        List<string> keys = ini.EnumKeys("server");
        if (keys.Count != 2) { bad = bad + 1; }
        if (keys[0] != "host" || keys[1] != "port") { bad = bad + 1; }
        // Set + serialize + reparse round-trip.
        ini.SetString("server", "host", "localhost");
        ini.SetInt("server", "port", 9090);
        ini.SetString("server", "newkey", "with=equals");
        string text = ini.ToText();
        IniFile re = IniFile.Parse(text);
        if (re.GetString("server", "host", "") != "localhost") { bad = bad + 1; }
        if (re.GetInt("server", "port", -1) != 9090) { bad = bad + 1; }
        if (re.GetString("server", "newkey", "") != "with=equals") { bad = bad + 1; }
        if (re.GetString("logging", "level", "") != "debug") { bad = bad + 1; }
        // Remove key + section.
        if (!ini.RemoveKey("server", "newkey")) { bad = bad + 1; }
        if (ini.GetString("server", "newkey", "gone") != "gone") { bad = bad + 1; }
        if (!ini.RemoveSection("logging")) { bad = bad + 1; }
        if (ini.EnumSections().Count != 1) { bad = bad + 1; }
        // File round-trip.
        string tmp = "_scratch_ini_test.tmp";
        ini.Save(tmp);
        IniFile fromFile = IniFile.Load(tmp);
        if (fromFile.GetString("server", "host", "") != "localhost") { bad = bad + 1; }
        File.Delete(tmp);

        // --- CSV ---
        string csvText = "a,b,c\n\"x,y\",\"he said \"\"hi\"\"\",z\n\"line1\nline2\",q,\n";
        CsvTable t = Csv.Parse(csvText);
        if (t.Header().Count != 3) { bad = bad + 1; }
        if (t.Header()[0] != "a" || t.Header()[1] != "b" || t.Header()[2] != "c") { bad = bad + 1; }
        if (t.RowCount() != 2) { bad = bad + 1; }
        List<List<string>> rows = t.Rows();
        if (rows[0].Count != 3) { bad = bad + 1; }
        if (rows[0][0] != "x,y") { bad = bad + 1; }
        if (rows[0][1] != "he said \"hi\"") { bad = bad + 1; }
        if (rows[0][2] != "z") { bad = bad + 1; }
        if (rows[1].Count != 3) { bad = bad + 1; }
        if (rows[1][0] != "line1\nline2") { bad = bad + 1; }
        if (rows[1][1] != "q") { bad = bad + 1; }
        if (rows[1][2] != "") { bad = bad + 1; }
        // Column lookup by header name.
        List<string> col = t.Column("b");
        if (col == null) { bad = bad + 1; }
        else if (col.Count != 2 || col[0] != "he said \"hi\"" || col[1] != "q") { bad = bad + 1; }
        if (t.Column("nope") != null) { bad = bad + 1; }
        // Serialize round-trip (header + rows together).
        List<List<string>> all = new List<List<string>>();
        all.Add(t.Header());
        all.Add(rows[0]);
        all.Add(rows[1]);
        string outText = Csv.Serialize(all);
        CsvTable reT = Csv.Parse(outText);
        if (reT.RowCount() != 2) { bad = bad + 1; }
        if (reT.Rows()[0][0] != "x,y") { bad = bad + 1; }
        if (reT.Rows()[0][1] != "he said \"hi\"") { bad = bad + 1; }
        if (reT.Rows()[1][0] != "line1\nline2") { bad = bad + 1; }
        if (reT.Rows()[1][2] != "") { bad = bad + 1; }
        // TSV.
        CsvTable tsv = Csv.ParseSep("1\t2\t3", "\t");
        if (tsv.Header().Count != 3) { bad = bad + 1; }
        if (tsv.Header()[1] != "2") { bad = bad + 1; }
        Console.WriteLine("ini-csv-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
