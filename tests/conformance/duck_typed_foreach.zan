using System;

class NumberSequence {
    int max;
    public NumberSequence(int max) {
        this.max = max;
    }

    public NumberEnumerator GetEnumerator() {
        return new NumberEnumerator(max);
    }
}

class NumberEnumerator {
    int max;
    int current;

    public NumberEnumerator(int max) {
        this.max = max;
        this.current = 0;
    }

    public bool MoveNext() {
        if (current < max) {
            current = current + 1;
            return true;
        }
        return false;
    }

    public int Current {
        get { return current; }
    }
}

class Program {
    static void Main() {
        NumberSequence seq = new NumberSequence(5);
        int sum = 0;
        foreach (var x in seq) {
            Console.WriteLine(x);
            sum = sum + x;
        }
        Console.WriteLine("sum=" + Convert.ToString(sum));
    }
}
