using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

/// ECharts 富文本标签（label.rich + {style|content} 令牌）解析与分词。
///
/// 官方出处（echarts 官方"富文本标签"文档 + examples）：
///   - `{name|content}` 段按 \n 分行；content 空 = 线/占位块（hr）。
///   - 样式键 color/fontSize/fontWeight（官方也接受数字 800，gauge-car）/
/// 核心契约与语义定义。
/// 核心契约与语义定义。
///     随整块宽）/height。
///   - label 本体的 backgroundColor/border/padding 是整块底板
///     （pie-rich-text 的 data.label 底板）。
///   - data[i].label.formatter 是**模板**（pie-rich-text 的
///     "{title|{b}}\n..."），覆盖系列级 label.formatter；模板令牌
///     {a}{b}{c}{d} 先展开、rich 壳保留，分词时才查表。
class Program {
    static string ST(ChartRichStyle s) {
        return s == null ? "-" : s.name;
    }

    static void Main() {
        // ---- 解析：pie-nest 形（series.label.rich）----
        ChartOption o = ChartOption.FromJson(
            "{\"series\":[{\"type\":\"pie\",\"data\":[120,200],\"label\":{"
            + "\"formatter\":\"{a|{b}}\\n{hr|}\\n{b|2023: {c}} {per|{d}%}\","
            + "\"rich\":{"
            + "\"a\":{\"color\":\"#6E7079\",\"lineHeight\":22,\"align\":\"center\"},"
            + "\"hr\":{\"borderColor\":\"#8C8D8E\",\"width\":\"100%\","
            + "\"borderWidth\":1,\"height\":0},"
            + "\"b\":{\"color\":\"#4C5058\",\"fontSize\":14,"
            + "\"fontWeight\":\"bold\",\"lineHeight\":33},"
            + "\"per\":{\"color\":\"#fff\",\"backgroundColor\":\"#4C5058\","
            + "\"padding\":[3,4],\"borderRadius\":4}"
            + "}}}]}");
        ChartSeries s = o.series[0];
        ChartTextStyle lb = s.label;
        Console.WriteLine("rich/count:" + Convert.ToString(lb.rich.Count));
        ChartRichStyle a = Chart.RichStyleOf(lb, "a");
        ChartRichStyle hr = Chart.RichStyleOf(lb, "hr");
        ChartRichStyle b = Chart.RichStyleOf(lb, "b");
        ChartRichStyle per = Chart.RichStyleOf(lb, "per");
        if (a == null || hr == null || b == null || per == null) {
            Console.WriteLine("rich/missing");
            return;
        }
        // a：颜色（ParseColor + 0xFF 通道）、lineHeight、align center
        Console.WriteLine("rich/a:" + Convert.ToString(a.color)
            + ":" + Convert.ToString(a.lineHeight)
            + ":" + Convert.ToString(a.align));
        // hr：width '100%' 记 -2、borderWidth 1、height 0（声明 0 ≠ 未声明 -1）
        Console.WriteLine("rich/hr:" + Convert.ToString(hr.width)
            + ":" + Convert.ToString(hr.borderWidth)
            + ":" + Convert.ToString(hr.height)
            + ":" + Convert.ToString(hr.borderColor));
        // b：字号/粗体/行高
        Console.WriteLine("rich/b:" + Convert.ToString(b.fontSize)
            + ":" + b.fontWeight + ":" + Convert.ToString(b.lineHeight));
        // per：[3,4] = 纵 3 横 4（t=3 r=4 b=3 l=4）、底色片、圆角
        Console.WriteLine("rich/per:" + Convert.ToString(per.backgroundColor)
            + ":" + Convert.ToString(per.padT) + ":" + Convert.ToString(per.padR)
            + ":" + Convert.ToString(per.padB) + ":" + Convert.ToString(per.padL)
            + ":" + Convert.ToString(per.radTL) + ":" + Convert.ToString(per.radBR));

        // ---- 分词：模板展开保留 rich 壳，按 \n 分行 ----
        string raw = Chart.RichFmtRaw(s, s.labelFmt, "Direct", 120, 26);
        Console.WriteLine("raw:" + raw);
        List<RichSeg> segs = Chart.RichTokenize(raw, lb);
        string desc = "";
        for (int i = 0; i < segs.Count; i = i + 1) {
            desc = desc + segs[i].line + ":" + ST(segs[i].st) + ":"
                + segs[i].text + "|";
        }
        Console.WriteLine("tok:" + desc);
        // 未知样式名 = 纯文本段（保留内容）
        List<RichSeg> unk = Chart.RichTokenize("{zz|x}", lb);
        Console.WriteLine("tok/unk:" + ST(unk[0].st) + ":" + unk[0].text);
        // 无 rich 壳的纯文本一行一段
        List<RichSeg> plain = Chart.RichTokenize("L1\nL2", lb);
        Console.WriteLine("tok/plain:" + Convert.ToString(plain.Count)
            + ":" + ST(plain[0].st) + ":" + ST(plain[1].st));
        // 空串也回一段（行 0），排版层按 0 高兜底
        List<RichSeg> empty = Chart.RichTokenize("", lb);
        Console.WriteLine("tok/empty:" + Convert.ToString(empty.Count)
            + ":" + empty[0].text.Length);

        // 图表配置契约与样式属性适配规范
        ChartOption o2 = ChartOption.FromJson(
            "{\"series\":[{\"type\":\"pie\",\"data\":["
            + "{\"value\":1548,\"name\":\"CityE\",\"label\":{"
            + "\"formatter\":\"{title|{b}}{abg|}\\n{hr|}\","
            + "\"backgroundColor\":\"#eee\",\"borderColor\":\"#777\","
            + "\"borderWidth\":1,\"borderRadius\":4,"
            + "\"rich\":{\"title\":{\"color\":\"#eee\",\"align\":\"center\"}}"
            + "}}],\"label\":{\"formatter\":\"{b}: {d}%\"}}]}");
        ChartSeries s2 = o2.series[0];
        ChartData d0 = s2.data[0];
        if (d0.dlabel == null) {
            Console.WriteLine("data/nolabel");
            return;
        }
        // labelText 兼容承载原串；labelFmtT 承载模板
        Console.WriteLine("data/fmt:" + d0.labelText + "#" + d0.labelFmtT);
        // 整块底板：bg/border/borderWidth/radius
        Console.WriteLine("data/box:" + Convert.ToString(d0.dlabel.boxBg)
            + ":" + Convert.ToString(d0.dlabel.boxBorder)
            + ":" + Convert.ToString(d0.dlabel.boxBorderW)
            + ":" + Convert.ToString(d0.dlabel.boxRadius)
            + ":" + Convert.ToString(d0.dlabel.rich.Count));
        // 逐扇区解析：data 有模板 → 覆盖系列级
        PieSlice sl = PieSlice.Of(1548, 0 - 65536, "CityE", 0, 0, 0, 900, 0);
        Console.WriteLine("slice/raw:" + ChartView.PieSliceRaw(s2, sl, 33));
        ChartTextStyle rs2 = ChartView.PieSliceRichStyle(s2, sl);
        Console.WriteLine("slice/rich:" + (rs2 == null
            ? "null" : Convert.ToString(rs2.rich.Count)));
        // 系列级 rich 兜底：data 无 dlabel 时回落系列 label
        ChartSeries s3 = o.series[0];
        PieSlice sl3 = PieSlice.Of(120, 0 - 65536, "Direct", 0, 0, 0, 900, 0);
        ChartTextStyle rs3 = ChartView.PieSliceRichStyle(s3, sl3);
        Console.WriteLine("slice/fallback:" + (rs3 == null
            ? "null" : Convert.ToString(rs3.rich.Count)));
        Console.WriteLine("slice/raw3:" + ChartView.PieSliceRaw(s3, sl3, 26));

        // ---- padding 其余形态与 fontWeight 数字 ----
        ChartOption o3 = ChartOption.FromJson(
            "{\"series\":[{\"type\":\"pie\",\"data\":[1],\"label\":{"
            + "\"padding\":5,\"borderRadius\":2,"
            + "\"rich\":{\"w\":{\"fontWeight\":800,\"padding\":[0,0,-20,10]},"
            + "\"n\":{\"padding\":[0,20,0,30]},"
            + "\"abg\":{\"borderRadius\":[4,4,0,0],\"width\":\"100%\"}}}}]}");
        ChartTextStyle lb3 = o3.series[0].label;
        Console.WriteLine("pad/num:" + Convert.ToString(lb3.padT)
            + ":" + Convert.ToString(lb3.padR) + ":" + Convert.ToString(lb3.padB)
            + ":" + Convert.ToString(lb3.padL)
            + ":" + Convert.ToString(lb3.boxRadius));
        ChartRichStyle w = Chart.RichStyleOf(lb3, "w");
        ChartRichStyle n = Chart.RichStyleOf(lb3, "n");
        if (w == null || n == null) {
            Console.WriteLine("pad/missing");
            return;
        }
        Console.WriteLine("pad/neg:" + Convert.ToString(w.fontWeight)
            + ":" + Convert.ToString(w.padT) + ":" + Convert.ToString(w.padR)
            + ":" + Convert.ToString(w.padB) + ":" + Convert.ToString(w.padL));
        Console.WriteLine("pad/tvth:" + Convert.ToString(n.padT)
            + ":" + Convert.ToString(n.padR) + ":" + Convert.ToString(n.padB)
            + ":" + Convert.ToString(n.padL));
        ChartRichStyle abg = Chart.RichStyleOf(lb3, "abg");
        if (abg == null) {
            Console.WriteLine("abg/missing");
            return;
        }
        // borderRadius 数组 = [左上,右上,右下,左下]（abg 只圆上两角）；
        // width '100%' 记 -2
        Console.WriteLine("abg/rad:" + Convert.ToString(abg.radTL)
            + ":" + Convert.ToString(abg.radTR) + ":" + Convert.ToString(abg.radBR)
            + ":" + Convert.ToString(abg.radBL)
            + ":" + Convert.ToString(abg.width));

        // ---- 段盒高：声明 height 或行盒，加纵向 padding（可为负）----
        Console.WriteLine("segh:" + Convert.ToString(Chart.RichSegH(30, 16, 0, 0))
            + ":" + Convert.ToString(Chart.RichSegH(0 - 1, 16, 2, 3))
            + ":" + Convert.ToString(Chart.RichSegH(0 - 1, 16, 0, 0)));

        // ---- T4-2d：axisLabel.rich 解析（bar-race-country 旗标形）----
        // 声明 rich 才建 labelSt（ParseTextStyle 单点解析，fontSize 14
        // 落 labelSt.fontSize）；未声明 rich 的轴 labelSt = null，渲染
        // 路径不变；Clone 必须携带（Materialize 教训的轴版）。
        ChartOption o4 = ChartOption.FromJson(
            "{\"xAxis\":[{\"type\":\"category\",\"data\":[\"A\",\"B\"],"
            + "\"axisLabel\":{\"show\":true,\"fontSize\":14,"
            + "\"rich\":{\"flag\":{\"fontSize\":25,\"padding\":5}}}}],"
            + "\"yAxis\":[{\"type\":\"value\"}],"
            + "\"series\":[{\"type\":\"bar\",\"data\":[1,2]}]}");
        ChartAxis ax = o4.xAxes[0];
        if (ax.labelSt == null || ax.labelSt.rich == null) {
            Console.WriteLine("axis/norich");
            return;
        }
        Console.WriteLine("axis/st:" + Convert.ToString(ax.labelSt.fontSize)
            + ":" + Convert.ToString(ax.labelSt.rich.Count));
        ChartRichStyle flag = Chart.RichStyleOf(ax.labelSt, "flag");
        if (flag == null) {
            Console.WriteLine("axis/noflag");
            return;
        }
        Console.WriteLine("axis/flag:" + Convert.ToString(flag.fontSize)
            + ":" + Convert.ToString(flag.padT) + ":" + Convert.ToString(flag.padR)
            + ":" + Convert.ToString(flag.padB) + ":" + Convert.ToString(flag.padL));
        Console.WriteLine("axis/plain:" + (o4.yAxes[0].labelSt == null
            ? "null" : "set"));
        ChartAxis axc = ChartAxis.Clone(ax);
        if (axc == null || axc.labelSt == null || axc.labelSt.rich == null) {
            Console.WriteLine("axis/clone:lost");
            return;
        }
        Console.WriteLine("axis/clone:" + Convert.ToString(axc.labelSt.rich.Count));

        // ---- T4-2d：RichStrip 剥壳（量宽/旋转/LabelText 共用）----
        Console.WriteLine("strip:" + Chart.RichStrip("{a|Hello} world")
            + ":" + Chart.RichStrip("{zz|x}")
            + ":" + Chart.RichStrip("plain")
            + ":" + Chart.RichStrip("a{b")
            + ":" + Chart.RichStrip(""));

        // ---- T4-2d：LabelText 剥壳（bar-label-rotation 形）----
        // "{c}  {name|{a}}" 展开后带壳——直接画会把花括号画出来；
        // rich.name = {}（空样式）官方渲染与 plain 同像素。
        ChartOption o5 = ChartOption.FromJson(
            "{\"series\":[{\"type\":\"bar\",\"name\":\"Forest\","
            + "\"data\":[135,226],"
            + "\"label\":{\"show\":true,\"rotate\":90,"
            + "\"formatter\":\"{c}  {name|{a}}\",\"rich\":{\"name\":{}}}}]}");
        ChartSeries s5 = o5.series[0];
        Console.WriteLine("lbltext:" + ChartView.LabelText(s5, 0 - 1, "2012", 135));
        Console.WriteLine("lbltext/nofmt:" + ChartView.LabelText(s5, 0 - 1, "", 7));

        // 图表配置契约与样式属性适配规范
        // 图表配置契约与样式属性适配规范
        // markPoint.symbolSize（声明后 mark 点画小点不画 pin 气球）。
        ChartOption o6 = ChartOption.FromJson(
            "{\"series\":[{\"type\":\"bar\",\"name\":\"City Alpha\","
            + "\"data\":[170,30],"
            + "\"markPoint\":{\"symbolSize\":1,"
            + "\"label\":{\"formatter\":\"{a|max days: }{c}\","
            + "\"position\":\"right\",\"distance\":8,"
            + "\"rich\":{\"a\":{\"fontSize\":12,\"color\":\"#fff\"}}},"
            + "\"data\":[{\"type\":\"max\"}]}}]}");
        ChartSeries s6 = o6.series[0];
        Console.WriteLine("mp/fmt:" + s6.markLabelFmt
            + ":" + s6.markLabelPos + ":" + Convert.ToString(s6.markLabelDist)
            + ":" + Convert.ToString(s6.markSymbolSize));
        Console.WriteLine("mp/rich:" + (s6.markLabelSt == null
            ? "null" : Convert.ToString(s6.markLabelSt.rich.Count)));
        ChartRichStyle mpA = s6.markLabelSt != null
            ? Chart.RichStyleOf(s6.markLabelSt, "a") : null;
        Console.WriteLine("mp/a:" + (mpA == null
            ? "-" : Convert.ToString(mpA.fontSize)));
        // 未声明 = 哨兵（"" / -1 / null）；渲染层用官方缺省 top/5。
        ChartOption o7 = ChartOption.FromJson(
            "{\"series\":[{\"type\":\"bar\",\"data\":[1],"
            + "\"markPoint\":{\"data\":[{\"type\":\"min\"}]}}]}");
        ChartSeries s7 = o7.series[0];
        Console.WriteLine("mp/def:" + s7.markLabelFmt + ":" + s7.markLabelPos
            + ":" + Convert.ToString(s7.markLabelDist)
            + ":" + Convert.ToString(s7.markSymbolSize)
            + ":" + (s7.markLabelSt == null ? "null" : "set"));
        // Clone 两分支都携带（share 读共享引用、deep 深拷 rich 表）。
        ChartSeries s6sh = ChartSeries.Clone(s6, true);
        ChartSeries s6dp = ChartSeries.Clone(s6, false);
        if (s6sh == null || s6dp == null) {
            Console.WriteLine("mp/clone:null");
            return;
        }
        Console.WriteLine("mp/clone:" + s6sh.markLabelFmt
            + ":" + Convert.ToString(s6sh.markSymbolSize)
            + ":" + (s6sh.markLabelSt != null && s6sh.markLabelSt.rich != null
                ? Convert.ToString(s6sh.markLabelSt.rich.Count) : "lost")
            + ":" + (s6dp.markLabelSt != null && s6dp.markLabelSt.rich != null
                ? Convert.ToString(s6dp.markLabelSt.rich.Count) : "lost"));

        // ---- T4-2e：gauge detail 级样式键（ECharts 5 形）----
        // 官方 5.x 把 lineHeight/rich/盒样式直接挂在 detail 上
        // （gauge-speed 的 lineHeight 40、gauge-car 的三块富文本卡）；
        // detail 级后解析、同键覆盖 detail.textStyle 旧形态。
        ChartOption o8 = ChartOption.FromJson(
            "{\"series\":[{\"type\":\"gauge\",\"data\":[{\"value\":100}],"
            + "\"detail\":{\"formatter\":\"{value|{value}}{unit|km/h}\","
            + "\"lineHeight\":40,\"offsetCenter\":[0,\"60%\"],"
            + "\"textStyle\":{\"lineHeight\":10,\"color\":\"#333\"},"
            + "\"rich\":{\"value\":{\"fontSize\":50,\"color\":\"#777\"},"
            + "\"unit\":{\"fontSize\":14}}}}]}");
        ChartSeries g8 = o8.series[0];
        ChartTextStyle gts = g8.gauge.detail.textStyle;
        Console.WriteLine("gdt/rich:" + (gts.rich != null
            ? Convert.ToString(gts.rich.Count) : "null")
            + ":" + Convert.ToString(gts.lineHeight)
            + ":" + Convert.ToString(gts.color));
        ChartRichStyle gv = Chart.RichStyleOf(gts, "value");
        Console.WriteLine("gdt/v:" + (gv == null
            ? "-" : Convert.ToString(gv.fontSize)));
        // Clone 链（ChartSeries → GaugeOption → GaugeDetail →
        // ChartTextStyle）必须携带 lineHeight + rich。
        ChartSeries g8c = ChartSeries.Clone(g8, false);
        if (g8c == null) {
            Console.WriteLine("gdt/clone:null");
            return;
        }
        ChartTextStyle gcts = g8c.gauge.detail.textStyle;
        Console.WriteLine("gdt/clone:" + (gcts.rich != null
            ? Convert.ToString(gcts.rich.Count) : "lost")
            + ":" + Convert.ToString(gcts.lineHeight));
        // label 级 lineHeight 哨兵 = -1（0 是合法声明值，不能当哨兵）。
        Console.WriteLine("lh/def:" + Convert.ToString(ChartTextStyle.Create().lineHeight)
            + ":" + Convert.ToString(lb.lineHeight));
    }
}
