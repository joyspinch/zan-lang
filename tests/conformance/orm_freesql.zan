// 接口数据协议与执行契约。
// 核心契约与语义定义。
using System;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.IO;

[Table(Name = "t_blog")]
class Blog {
    [Column(IsIdentity = true)]
    int id;
    [Column(Name = "title", StringLength = 64)]
    string title;
    int clicks;
    double score;
    bool online;

    static Blog Of(string title, int clicks, double score, bool online) {
        Blog b = new Blog();
        b.title = title;
        b.clicks = clicks;
        b.score = score;
        b.online = online;
        return b;
    }

    int Id() { return this.id; }
    string Title() { return this.title; }
    int Clicks() { return this.clicks; }
}

class BlogRepository : BaseRepository<Blog> {
    BlogRepository(IFreeSql fsql) : base(fsql) {}

    Blog ById(int id) {
        return this.GetExecutor().Select<Blog>().Where(a => a.id == id).ToOne();
    }
}

class Program {
    static void Main() {
        string path = "orm_freesql.tmp.db";
        File.Delete(path);

        // 核心契约与语义定义。
        IFreeSql fsql = new FreeSqlBuilder()
            .UseConnectionString(DbProvider.SQLite, path)
            .Build();

        // 接口数据协议与执行契约。
        fsql.CodeFirst().SyncStructure<Blog>();
        fsql.CodeFirst().SyncStructure<Blog>();

        // 接口数据协议与执行契约。
        int id = fsql.Insert<Blog>(Blog.Of("hello", 3, 1.5, true)).ExecuteIdentity();
        Console.WriteLine("id: " + Convert.ToString(id));

        // 核心契约与语义定义。
        List<Blog> more = new List<Blog> {
            Blog.Of("zan orm", 10, 2.0, true),
            Blog.Of("freesql style", 40, 3.5, false),
            Blog.Of("draft", 1, 0.5, false)
        };
        Console.WriteLine("ins: " + Convert.ToString(fsql.Insert<Blog>(more).ExecuteAffrows()));

        // 核心契约与语义定义。
        int up = fsql.Update<Blog>()
            .Set(a => a.title, "hello zan")
            .SetIncr(a => a.clicks, 5)
            .Where(a => a.id == id)
            .ExecuteAffrows();
        Console.WriteLine("up: " + Convert.ToString(up));

        // 核心契约与执行状态转移规范。
        List<Blog> hot = fsql.Select<Blog>()
            .Where(a => a.clicks >= 8)
            .OrderByDescending(a => a.clicks)
            .ToList();
        Console.WriteLine("hot: " + Convert.ToString(hot.Count) + " " + hot[0].title);

        Blog one = fsql.Select<Blog>().Where(a => a.id == id).ToOne();
        Console.WriteLine("one: " + one.title + " clicks=" + Convert.ToString(one.clicks)
            + " online=" + Convert.ToString(one.online));

        // 7. Aggregates
        Console.WriteLine("sum: " + Convert.ToString(fsql.Select<Blog>().Sum(a => a.clicks)));
        Console.WriteLine("max: " + Convert.ToString(fsql.Select<Blog>().Max(a => a.clicks)));
        Console.WriteLine("avg: " + Convert.ToString(fsql.Select<Blog>().Avg(a => a.score)));
        Console.WriteLine("any: " + Convert.ToString(fsql.Select<Blog>().Where(a => a.online).Any()));

        // 8. Paging
        List<Blog> page = fsql.Select<Blog>().OrderBy(a => a.id).Page(2, 2).ToList();
        Console.WriteLine("page: " + Convert.ToString(page.Count) + " " + page[0].title);

        // 接口数据协议与执行契约。
        string kw = "free";
        bool useKw = true;
        bool useDraft = false;
        List<Blog> found = fsql.Select<Blog>()
            .WhereIf(useDraft, a => a.title == "draft")
            .WhereIf(useKw, a => a.title.StartsWith(kw))
            .ToList();
        Console.WriteLine("found: " + Convert.ToString(found.Count) + " " + found[0].title);

        // 接口数据协议与执行契约。
        one.score = 9.5;
        one.online = false;
        Console.WriteLine("src: " + Convert.ToString(fsql.Update<Blog>().SetSource(one).ExecuteAffrows()));
        Console.WriteLine("score: " + Convert.ToString(fsql.Select<Blog>().Where(a => a.id == id).ToOne().score));

        // 11. Delete
        Console.WriteLine("del: " + Convert.ToString(fsql.Delete<Blog>().Where(a => a.clicks < 5).ExecuteAffrows()));
        Console.WriteLine("left: " + Convert.ToString(fsql.Select<Blog>().Count()));

        // 核心契约与执行状态转移规范。
        BlogRepository repo = new BlogRepository(fsql);
        int repoId = repo.InsertIdentity(Blog.Of("repo blog", 99, 4.8, true));
        Console.WriteLine("repo-ins: " + Convert.ToString(repoId));
        Console.WriteLine("repo-get: " + repo.ById(repoId).Title());
        Console.WriteLine("repo-count: " + Convert.ToString(repo.Count()));

        // 核心契约与执行状态转移规范。
        using (IUnitOfWork uow = fsql.CreateUnitOfWork()) {
            repo.Attach(uow);
            repo.Insert(Blog.Of("tx blog", 15, 3.0, true));
            uow.Commit();
        }
        repo.Detach();
        Console.WriteLine("uow-count: " + Convert.ToString(repo.Count()));

        fsql.Dispose();
        File.Delete(path);
    }
}
