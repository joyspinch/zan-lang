using System;
using System.Collections.Generic;
class Src {
    public static int ran;
    public static IEnumerable<int> Nums() {
        ran = ran + 1;
        yield return 10;
        ran = ran + 10;
        yield return 20;
        ran = ran + 100;
    }
}
class Z9 {
    static int Main() {
        // 惰性铁证：调用迭代器方法不执行体；每个 MoveNext 只推进到下一个
        // yield（访问外层静态字段经 Enclosing.name 限定改写）。
        Console.WriteLine("before=" + Src.ran);
        IEnumerable<int> seq = Src.Nums();
        Console.WriteLine("call=" + Src.ran);
        int s = 0;
        foreach (int x in seq) {
            s = s + x;
            Console.WriteLine("pull=" + Src.ran);
            if (s == 10) { break; }
        }
        Console.WriteLine("s=" + s + " end=" + Src.ran);
        return s == 10 && Src.ran == 1 ? 0 : 1;
    }
}
