using System;

class Program {
    static void Main() {
        string text = "a\tb\tc";
        Console.WriteLine(Convert.ToString(text.IndexOf("\t")));
        Console.WriteLine(Convert.ToString(text.IndexOf("\t", 2)));
        Console.WriteLine(Convert.ToString(text.IndexOf("\t", 4)));
        Console.WriteLine(Convert.ToString(text.IndexOf("\t", 5)));
        Console.WriteLine(Convert.ToString(text.IndexOf("x", 0)));
    }
}
