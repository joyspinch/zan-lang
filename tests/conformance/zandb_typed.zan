using System;
using System.IO;
using System.Data.ZanDb;
using System.Json;

// 接口数据协议与执行契约。
class Program {
    static int pass = 0;
    static int fail = 0;

    static void Check(string name, bool ok) {
        if (ok) { pass = pass + 1; }
        else { fail = fail + 1; Console.WriteLine("FAIL " + name); }
    }

    static JsonValue Doc(string cat, int age) {
        JsonValue u = JsonValue.NewObject();
        u.Put("cat", JsonValue.NewStr(cat));
        if (age >= 0) { u.Put("age", JsonValue.NewNum(Convert.ToString(age))); }
        return u;
    }

    static async int Run() {
        string basePath = "_scratch/zandb_typed.tmp.db";
        // 库文件写 _scratch/（git-ignored），不在仓库根残留库文件。
        Directory.CreateDirectory("_scratch");
        File.Delete(basePath);
        File.Delete(basePath + ".m0");
        File.Delete(basePath + ".m1");
        for (int i = 0; i < 8; i = i + 1) {
            string seg = basePath + ".s" + Convert.ToString(i);
            if (File.Exists(seg)) { File.Delete(seg); }
        }

        ZanDatabase db = ZanDatabase.Open(basePath, 64);
        Check("open", db.IsOpen());
        Collection docs = db.GetCollection("docs");

        // 种子：age = 10,20,30,40（id 1..4，cat 交替 a/b）；id5 无 age；
        // id6 age 为负（-5，varint tag 8）；id7 age 为字符串字段。
        int a = docs.Insert(Doc("a", 10));
        int b = docs.Insert(Doc("b", 20));
        int c = docs.Insert(Doc("a", 30));
        int d = docs.Insert(Doc("b", 40));
        JsonValue noAge = JsonValue.NewObject();
        noAge.Put("cat", JsonValue.NewStr("a"));
        int e = docs.Insert(noAge);
        JsonValue neg = JsonValue.NewObject();
        neg.Put("cat", JsonValue.NewStr("a"));
        neg.Put("age", JsonValue.NewNum("-5"));
        int f = docs.Insert(neg);
        JsonValue strAge = JsonValue.NewObject();
        strAge.Put("cat", JsonValue.NewStr("b"));
        strAge.Put("age", JsonValue.NewStr("not-a-num"));
        int g = docs.Insert(strAge);

        // 1. SumField：10+20+30+40-5 = 95；无 age 与字符串 age 不计入。
        Check("sum", docs.SumField("age") == 95);
        Check("sum-missing-field", docs.SumField("nosuch") == 0);

        // 2. ScanNumField：访问数 = 数值 age 文档数（5）；值逐个对。
        List<long> nums = new List<long>();
        int nn = docs.ScanNumField("age", (int id, long v) => {
            nums.Add(v);
            return true;
        });
        Check("scanum-count", nn == 5);
        Check("scanum-vals", nums[0] == 10 && nums[1] == 20 && nums[2] == 30
            && nums[3] == 40 && nums[4] == 0 - 5);

        // 3. ScanNumField 提前停。
        List<long> early = new List<long>();
        int ne = docs.ScanNumField("age", (int id, long v) => {
            early.Add(v);
            return false;
        });
        Check("scanum-stop", ne == 1 && early.Count == 1 && early[0] == 10);

        // 4. ScanStrField：cat 文本形态，无 age 的文档也有 cat。
        List<string> cats = new List<string>();
        int ns = docs.ScanStrField("cat", (int id, string v) => {
            cats.Add(v);
            return true;
        });
        Check("scanstr-count", ns == 7);
        Check("scanstr-vals", cats[0] == "a" && cats[1] == "b" && cats[6] == "b");
        Check("scanstr-missing-field", docs.ScanStrField("nosuch", (int id, string v) => {
            return true;
        }) == 0);

        // 5. CountGroups：a=4（id1,id3,id5无age,id6负），b=3（含字符串age）。
        Dictionary<string, int> groups = docs.CountGroups("cat");
        Check("groups-count", groups.Count == 2);
        int ca;
        int cb;
        groups.TryGetValue("a", out ca);
        groups.TryGetValue("b", out cb);
        Check("groups-a", ca == 4);
        Check("groups-b", cb == 3);
        Check("groups-missing-field", docs.CountGroups("nosuch").Count == 0);

        // 6. Update 后聚合跟随：b 的 20 改成 100 → sum 175。
        docs.Update(b, Doc("b", 100));
        Check("sum-after-update", docs.SumField("age") == 175);

        // 6.5 Min/Max/Avg/TopN。当前数值 age：{1:10, 2:100, 3:30,
        // 4:40, 6:-5}。再补等值文档制造 TopN 平局：id8=100、id9=100、
        // id10=40（cat "t"，不影响 a/b 组计数）。
        long mn;
        long mx;
        bool hasMin = docs.MinField("age", out mn);
        bool hasMax = docs.MaxField("age", out mx);
        Check("min", hasMin && mn == 0 - 5);
        Check("max", hasMax && mx == 100);
        Check("avg", docs.AvgField("age") == 35.0);
        long mnx;
        long mxx;
        Check("min-missing-field", docs.MinField("nosuch", out mnx) == false);
        Check("max-missing-field", docs.MaxField("nosuch", out mxx) == false);
        Check("avg-missing-field", docs.AvgField("nosuch") == 0.0);

        int t1 = docs.Insert(Doc("t", 100));
        int t2 = docs.Insert(Doc("t", 100));
        int t3 = docs.Insert(Doc("t", 40));
        Check("tie-ids", t1 == 8 && t2 == 9 && t3 == 10);

        // TopN(3)：三个 100 平局，id 小者在前 → [2, 8, 9]。
        List<int> top3 = docs.FindTopIds("age", 3);
        Check("top3-count", top3.Count == 3);
        Check("top3-ties", top3[0] == b && top3[1] == t1 && top3[2] == t2);
        // TopN(5)：100,100,100,40,40 → [2, 8, 9, 4, 10]。
        List<int> top5 = docs.FindTopIds("age", 5);
        Check("top5", top5.Count == 5 && top5[0] == b && top5[1] == t1
            && top5[2] == t2 && top5[3] == d && top5[4] == t3);
        // TopN(0) 空；TopN 超过数值文档数 → 全部 8 个降序。
        Check("top0", docs.FindTopIds("age", 0).Count == 0);
        List<int> topAll = docs.FindTopIds("age", 100);
        Check("topall-count", topAll.Count == 8);
        Check("topall-order", topAll[0] == b && topAll[1] == t1 && topAll[2] == t2
            && topAll[3] == d && topAll[4] == t3 && topAll[5] == c
            && topAll[6] == a && topAll[7] == f);
        Check("top-missing-field", docs.FindTopIds("nosuch", 3).Count == 0);
        // 平局文档加入后聚合跟随：sum 415 / avg 51.875。
        Check("sum-with-ties", docs.SumField("age") == 415);
        Check("avg-with-ties", docs.AvgField("age") == 51.875);

        db.Close();

        // 7. 重开：冷缓存同结果。
        ZanDatabase db2 = ZanDatabase.Open(basePath, 64);
        Collection docs2 = db2.GetCollection("docs");
        Check("reopen-sum", docs2.SumField("age") == 415);
        Dictionary<string, int> g2 = docs2.CountGroups("cat");
        int ca2;
        g2.TryGetValue("a", out ca2);
        Check("reopen-groups", g2.Count == 3 && ca2 == 4);
        List<int> top3b = docs2.FindTopIds("age", 3);
        Check("reopen-top3", top3b.Count == 3 && top3b[0] == b && top3b[1] == t1);
        db2.Close();

        File.Delete(basePath);
        File.Delete(basePath + ".m0");
        File.Delete(basePath + ".m1");
        for (int i = 0; i < 8; i = i + 1) {
            string seg = basePath + ".s" + Convert.ToString(i);
            if (File.Exists(seg)) { File.Delete(seg); }
        }
        Console.WriteLine("pass: " + Convert.ToString(pass));
        Console.WriteLine("fail: " + Convert.ToString(fail));
        return 0;
    }

    static async void Main() {
        int r = await Run();
    }
}
