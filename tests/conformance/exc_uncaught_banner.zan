// B-ID186 Wave 11: unhandled exception banner must include the runtime exception
// type name across sync/async throws, empty messages, and non-Exception classes.
using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Threading;

class Boom : Exception {
    public Boom(string msg) : base(msg) {}
}

class PlainErr {
    public int code;
}

class Program {
    static async void ThrowAsync() {
        await Task.Delay(1);
        throw new FormatException("bad-fmt");
    }

    static async void Main() {
        if (Environment.ArgCount() >= 1) {
            string mode = Environment.ArgAt(0);
            if (mode == "boom") { throw new Boom("boom100"); }
            if (mode == "empty") { throw new Boom(""); }
            if (mode == "plain") { throw new PlainErr(); }
            if (mode == "async") { await ThrowAsync(); return; }
            return;
        }
        string[] modes = new string[] { "boom", "empty", "plain", "async" };
        for (int i = 0; i < modes.Length; i = i + 1) {
            List<string> args = new List<string>();
            args.Add(modes[i]);
            ProcessResult r = Process.CaptureSafe(Environment.ProcessPath, args, 5000);
            string banner = "";
            for (int j = 0; j < r.lines.Count; j = j + 1) {
                if (r.lines[j].Contains("Unhandled exception")) {
                    banner = r.lines[j].Trim();
                    break;
                }
            }
            Console.WriteLine(modes[i] + "|rc=" + r.exitCode + "|" + banner);
        }
    }
}
