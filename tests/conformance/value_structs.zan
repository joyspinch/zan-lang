using System;

// Value structs: passed and returned by value, usable as fields, as collection
// elements (packed into the 8-byte slot) and as the receiver of a method call
// on a temporary.
struct Rgba {
    uint v;

    static Rgba Of(uint x) { Rgba c = new Rgba(); c.v = x; return c; }
    uint Argb() { return v; }
    bool IsNone() { return v == 0; }
    Rgba WithAlpha(uint a) { return Rgba.Of((v & 16777215) | (a * 16777216)); }
}

struct Pair {
    int a;
    int b;
    static Pair Of(int x, int y) { Pair p = new Pair(); p.a = x; p.b = y; return p; }
    int Sum() { return a + b; }
}

class Holder {
    Rgba bg;
    static Holder Make(Rgba c) { Holder h = new Holder(); h.bg = c; return h; }
    Rgba Bg() { return bg; }
}

class Program {
    static Rgba Twice(Rgba c) { return Rgba.Of(c.Argb()); }

    static void Main() {
        Rgba c = Rgba.Of(4280296496);
        Console.WriteLine(c.Argb());
        Console.WriteLine(c.IsNone());
        Console.WriteLine(Rgba.Of(0).IsNone());

        // method call on a value returned by value (no addressable receiver)
        Console.WriteLine(Holder.Make(c).Bg().Argb());
        Console.WriteLine(Program.Twice(c).Argb());
        Console.WriteLine(c.WithAlpha(128).Argb());

        // a struct field survives a round trip through a class
        Holder h = Holder.Make(c);
        Rgba back = h.Bg();
        Console.WriteLine(back.Argb());

        // collection elements
        List<Rgba> l = new List<Rgba>();
        l.Add(c);
        l.Add(Rgba.Of(255));
        Console.WriteLine(l.Count);
        Console.WriteLine(l[0].Argb());
        Console.WriteLine(l[1].Argb());

        Console.WriteLine(Pair.Of(3, 4).Sum());

        // value semantics: a copy is independent of the original
        Pair p1 = Pair.Of(1, 2);
        Pair p2 = p1;
        p2.a = 100;
        Console.WriteLine(p1.a);
        Console.WriteLine(p2.a);
    }
}
