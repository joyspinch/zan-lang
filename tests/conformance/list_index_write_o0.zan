using System;

// 接口数据协议与执行契约。

class Repro {
    static void Main() {
        List<int> a = new List<int>();
        for (int c = 0; c < 70; c = c + 1) { a.Add(0); }
        for (int k = 0; k < 1000000; k = k + 1) {
            int idx = k % 5 + 1;
            a[idx] = a[idx] + 1;
        }
        Console.WriteLine("ok " + Convert.ToString(a[1]));
    }
}
