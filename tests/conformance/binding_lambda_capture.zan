using System;
using System.Threading;

class BindingCaptureModel {
    public int count = 10;
}

class BindingLambdaCaptureTest {
    static async Task<int> AsyncLocalBinding() {
        Binding<int> local = 7;
        Action bump = () => { local.Set(local.Get() + 5); };
        await Task.Delay(1);
        bump();
        return local.Get();
    }

    static void Main() {
        Binding<int> clicks = 0;
        Action inc = () => { clicks.Set(clicks.Get() + 1); };
        inc();
        inc();
        Console.WriteLine("const int=" + clicks.Get().ToString());

        Binding<string> label = "init";
        Action<string> rename = (string s) => { label.Set(s); };
        rename("updated");
        Console.WriteLine("const str=" + label.Get());

        BindingCaptureModel m = new BindingCaptureModel();
        Binding<int> live = m.count;
        Action addTen = () => { live.Set(live.Get() + 10); };
        addTen();
        Console.WriteLine("live=" + m.count.ToString());

        // Reassigning a captured binding inside a lambda also wraps literal RHS.
        Action reset = () => { clicks = 99; };
        reset();
        Console.WriteLine("reassigned=" + clicks.Get().ToString());

        int asyncVal = await AsyncLocalBinding();
        Console.WriteLine("async=" + asyncVal.ToString());
    }
}
