using System;

class Host {
    public int offset = 100;

    public void Run() {
        int[] numbers = new int[] { 1, 2, 3, 4, 5 };
        string prefix = "ITEM_";
        Func<int, string> formatter = (x) => {
            int localOffset = this.offset;
            return prefix + (x + localOffset);
        };

        for (int i = 0; i < numbers.Length; i = i + 1) {
            Console.WriteLine(formatter(numbers[i]));
        }

        Action inlineAction = () => {
            string[] subItems = new string[] { "A", "B" };
            Console.WriteLine("SUB:" + subItems.Length);
        };
        inlineAction();
    }
}

class Program {
    static int Main() {
        Host h = new Host();
        h.Run();
        Console.WriteLine("DEBUG_LAMBDA_OK");
        return 0;
    }
}
