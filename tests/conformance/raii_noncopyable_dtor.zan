using System;

struct Handle : ~Copyable {
    public int Id;
    public Handle(int id) {
        Id = id;
        Console.WriteLine($"+H{Id}");
    }
    ~Handle() {
        Console.WriteLine($"-H{Id}");
    }
}

struct DeinitTag : ~Copyable {
    public int Tag;
    public string Label;
    public DeinitTag(int tag, string label) {
        Tag = tag;
        Label = label;
        Console.WriteLine($"+D{Tag}:{Label}");
    }
    deinit {
        Console.WriteLine($"-D{Tag}:{Label}");
    }
}

struct Outer : ~Copyable {
    public Handle First;
    public Handle Second;
    public Outer(Handle a, Handle b) {
        First = a;
        Second = b;
    }
    ~Outer() {
        Console.WriteLine($"-Outer({First.Id},{Second.Id})");
    }
}

struct AutoWrapper : ~Copyable {
    public Handle Inner;
    public AutoWrapper(Handle h) { Inner = h; }
}

class Program {
    static void Consume(Handle h) {
        Console.WriteLine($"consume({h.Id})");
    }

    static Handle Make(int id) {
        var h = new Handle(id);
        return h;
    }

    static Handle Transform(Handle h) {
        int next = h.Id + 100;
        return new Handle(next);
    }

    static void BranchMove(bool take) {
        var h = new Handle(take ? 31 : 32);
        if (take) {
            Consume(h);
        }
        Console.WriteLine($"after({take})");
    }

    static void Main() {
        // 1. Reverse-order scope drop
        {
            var a = new Handle(1);
            var b = new Handle(2);
            Console.WriteLine($"in({a.Id},{b.Id})");
        }

        // 2. Move var + move param + return move
        {
            var m1 = Make(10);
            var m2 = m1;
            Consume(m2);
        }

        // 3. Conditional branch move (drop flag)
        BranchMove(true);
        BranchMove(false);

        // 4. Reassignment & Transform(h)
        {
            var r = new Handle(40);
            r = new Handle(41);
            r = Transform(r);
            Console.WriteLine($"reassigned({r.Id})");
        }

        // 5. Nested ~Outer() + reverse field drop (Second then First)
        {
            var o = new Outer(new Handle(51), new Handle(52));
            Console.WriteLine($"outer({o.First.Id},{o.Second.Id})");
        }

        // 6. AutoWrapper without explicit ~AutoWrapper()
        {
            var w = new AutoWrapper(new Handle(60));
            Console.WriteLine($"wrap({w.Inner.Id})");
        }

        // 7. Exception unwind drops in reverse order
        try {
            var u1 = new Handle(71);
            var u2 = new Handle(72);
            Console.WriteLine($"throwing({u1.Id},{u2.Id})");
            throw new Exception("boom");
        } catch (Exception ex) {
            Console.WriteLine($"caught:{ex.Message}");
        }

        // 8. deinit + RC string field (0 leaks) + discarded temporary
        {
            var d = new DeinitTag(80, "alpha" + "_rc");
            Console.WriteLine($"tag({d.Tag})");
        }
        new Handle(99);
        Console.WriteLine("done");
    }
}
