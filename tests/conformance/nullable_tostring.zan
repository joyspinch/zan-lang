using System;

// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。

class Program {
    static string InterpULong(ulong? u) { return $"{u}|{u.HasValue}"; }
    static string InterpDouble(double? d) { return $"[{d}]"; }

    static void Main() {
        int? a = 42;
        int? n = null;
        Console.WriteLine(Convert.ToString(a));
        Console.WriteLine("<" + Convert.ToString(n) + ">");

        double? d = 1.5;
        double? dn = null;
        Console.WriteLine(Convert.ToString(d));
        Console.WriteLine("<" + Convert.ToString(dn) + ">");

        ulong? u = 18446744073709551615;
        ulong? un = null;
        Console.WriteLine(Convert.ToString(u));
        Console.WriteLine("<" + Convert.ToString(un) + ">");

        Console.WriteLine($"{a}!");
        Console.WriteLine($"<{n}>");
        Console.WriteLine(InterpDouble(d));
        Console.WriteLine($"<{dn}>");
        Console.WriteLine(InterpULong(u));
        Console.WriteLine($"<{un}>");

        // 核心契约与语义定义。
        Console.WriteLine(Convert.ToString(n ?? 7));
    }
}
