// Block-scoped `namespace X { ... }` must not swallow the top-level
// declarations that follow its closing brace. The decls loop used to stop at
// the namespace's `}`, so `class B` after it silently vanished. Both classes
// must exist, and B -- declared outside the namespace -- must not inherit X.
namespace X {
    class A {
        public static string Who() { return "A-in-X"; }
    }
}
class B {
    public static string Who() { return "B"; }
}
class Program {
    static void Main() {
        Console.WriteLine(X.A.Who());
        Console.WriteLine(B.Who());
    }
}
