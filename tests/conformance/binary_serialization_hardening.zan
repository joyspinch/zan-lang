using System;
using System.Json;
using System.Bson;
using System.Cbor;
using System.MsgPack;

class Program {
    static void Main() {
        // 1. BSON (root must be object)
        JsonValue bObj = JsonValue.NewObject();
        bObj.Put("title", JsonValue.NewStr("Enterprise Zan"));
        bObj.Put("version", JsonValue.NewNum("42"));
        bObj.Put("ratio", JsonValue.NewNum("3.14"));
        bObj.Put("active", JsonValue.NewBool(true));
        bObj.Put("empty", JsonValue.NewNull());

        byte[] bsonBytes = Bson.Pack(bObj);
        JsonValue bRestored = Bson.Unpack(bsonBytes);
        Console.WriteLine("bson_title=" + bRestored.Str("title", ""));
        Console.WriteLine("bson_ver=" + bRestored.Int("version", 0));
        Console.WriteLine("bson_active=" + bRestored.Bool("active", false));

        // 2. CBOR
        JsonValue cObj = JsonValue.NewObject();
        cObj.Put("code", JsonValue.NewNum("-100"));
        cObj.Put("name", JsonValue.NewStr("CBOR Protocol"));
        JsonValue cArr = JsonValue.NewArray();
        cArr.Append(JsonValue.NewNum("1"));
        cArr.Append(JsonValue.NewNum("2"));
        cArr.Append(JsonValue.NewNum("3"));
        cObj.Put("list", cArr);

        byte[] cborBytes = Cbor.Encode(cObj);
        JsonValue cRestored = Cbor.Decode(cborBytes);
        Console.WriteLine("cbor_code=" + cRestored.Int("code", 0));
        Console.WriteLine("cbor_name=" + cRestored.Str("name", ""));
        JsonValue listVal = cRestored.Get("list");
        if (listVal != null) {
            Console.WriteLine("cbor_arr_count=" + listVal.Count());
        }

        // 3. MsgPack
        JsonValue mObj = JsonValue.NewObject();
        mObj.Put("service", JsonValue.NewStr("MsgPack RPC"));
        mObj.Put("port", JsonValue.NewNum("8080"));
        mObj.Put("secure", JsonValue.NewBool(true));

        byte[] msgBytes = MsgPack.Pack(mObj);
        JsonValue mRestored = MsgPack.Unpack(msgBytes);
        Console.WriteLine("msgpack_service=" + mRestored.Str("service", ""));
        Console.WriteLine("msgpack_port=" + mRestored.Int("port", 0));
        Console.WriteLine("msgpack_secure=" + mRestored.Bool("secure", false));

        Console.WriteLine("binary_serialization_hardening_ok");
    }
}
