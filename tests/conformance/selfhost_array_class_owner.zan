using System;

class ArrayClassPayload {
    public int value;
    public ArrayClassPayload(int n) { value = n; }
}

class SelfhostArrayClassOwner {
    static ArrayClassPayload[] Echo(ArrayClassPayload[] values) { return values; }
    static ArrayClassPayload[,] EchoRect(ArrayClassPayload[,] values) { return values; }

    static void CheckOne() {
        ArrayClassPayload first = new ArrayClassPayload(11);
        ArrayClassPayload next = new ArrayClassPayload(22);
        WeakReference<ArrayClassPayload> oldWatch = new WeakReference<ArrayClassPayload>(first);
        WeakReference<ArrayClassPayload> newWatch = new WeakReference<ArrayClassPayload>(next);
        ArrayClassPayload[] values = new ArrayClassPayload[] { first, null };
        first = null;
        Console.WriteLine("one-init=" + oldWatch.IsAlive);
        values[1] = values[0];
        values[0] = values[0];
        Console.WriteLine("one-self=" + (oldWatch.IsAlive && values[0].value == 11));
        values[0] = next;
        next = null;
        Console.WriteLine("one-copy=" + (oldWatch.IsAlive && newWatch.IsAlive && values[1].value == 11));
        values[1] = null;
        Console.WriteLine("one-replace=" + !oldWatch.IsAlive);
        ArrayClassPayload[] alias = Echo(values);
        values = null;
        Console.WriteLine("one-alias=" + (newWatch.IsAlive && alias[0].value == 22));
        alias = null;
        Console.WriteLine("one-dtor=" + !newWatch.IsAlive);
    }

    static void CheckRect() {
        ArrayClassPayload first = new ArrayClassPayload(31);
        ArrayClassPayload next = new ArrayClassPayload(32);
        WeakReference<ArrayClassPayload> oldWatch = new WeakReference<ArrayClassPayload>(first);
        WeakReference<ArrayClassPayload> newWatch = new WeakReference<ArrayClassPayload>(next);
        ArrayClassPayload[,] values = new ArrayClassPayload[2,2];
        values[1,1] = first;
        first = null;
        values[0,0] = values[1,1];
        values[1,1] = values[1,1];
        Console.WriteLine("rect-self=" + (oldWatch.IsAlive && values[1,1].value == 31));
        values[1,1] = next;
        next = null;
        Console.WriteLine("rect-copy=" + (oldWatch.IsAlive && newWatch.IsAlive));
        values[0,0] = null;
        Console.WriteLine("rect-replace=" + !oldWatch.IsAlive);
        ArrayClassPayload[,] alias = EchoRect(values);
        values = null;
        Console.WriteLine("rect-alias=" + (newWatch.IsAlive && alias.GetLength(1) == 2 && alias[1,1].value == 32));
        alias = null;
        Console.WriteLine("rect-dtor=" + !newWatch.IsAlive);
    }

    static WeakReference<ArrayClassPayload> ScopeExit() {
        ArrayClassPayload payload = new ArrayClassPayload(41);
        WeakReference<ArrayClassPayload> watch = new WeakReference<ArrayClassPayload>(payload);
        ArrayClassPayload[] values = new ArrayClassPayload[] { payload, payload };
        payload = null;
        Console.WriteLine("scope-live=" + (watch.IsAlive && values[1].value == 41));
        return watch;
    }

    static void Main() {
        CheckOne();
        CheckRect();
        WeakReference<ArrayClassPayload> scopeWatch = ScopeExit();
        Console.WriteLine("scope-dtor=" + !scopeWatch.IsAlive);
    }
}
