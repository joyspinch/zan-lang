// 核心契约与语义定义。
class Pair<T1, T2> {
    public T1 first;
    public T2 second;
}

class Program {
    static void Main() {
        Pair<int, string> p = new Pair<int, string>();
        p.first = 42;
        p.second = "ok";
        Console.WriteLine(p.first);
        Console.WriteLine(p.second);
    }
}
