// Conformance: `break` inside a `switch` leaves the switch, not the enclosing
// loop; `continue` inside a switch still targets the loop.
//
// The switch lowering did not install its own break target, so a case's
// `break` branched to the loop's exit block: every such loop ran exactly one
// iteration.
using System;

class Program {
    static int WhileSwitch() {
        int i = 0;
        int n = 0;
        for (; i < 3; i = i + 1) {
            switch (i) {
                case 0: n = n + 1; break;
                default: n = n + 10; break;
            }
        }
        return n * 10 + i;
    }

    static int ForeachSwitch() {
        int[] xs = new int[3];
        xs[0] = 1;
        xs[1] = 2;
        xs[2] = 5;
        int sum = 0;
        foreach (int x in xs) {
            switch (x) {
                case 1: sum = sum + 1; break;
                default: sum = sum + x * 10; break;
            }
        }
        return sum;
    }

    static int ContinueInSwitch() {
        int i = 0;
        int n = 0;
        while (i < 4) {
            i = i + 1;
            switch (i) {
                case 2: continue;
                default: break;
            }
            n = n + i;
        }
        return n;
    }

    static int StringSwitch() {
        string[] ks = new string[3];
        ks[0] = "a";
        ks[1] = "b";
        ks[2] = "a";
        int n = 0;
        foreach (string k in ks) {
            switch (k) {
                case "a": n = n + 1; break;
                default: n = n + 100; break;
            }
        }
        return n;
    }

    static void Main() {
        Console.WriteLine("while=" + Convert.ToString(Program.WhileSwitch()));
        Console.WriteLine("foreach=" + Convert.ToString(Program.ForeachSwitch()));
        Console.WriteLine("continue=" + Convert.ToString(Program.ContinueInSwitch()));
        Console.WriteLine("strings=" + Convert.ToString(Program.StringSwitch()));
    }
}
