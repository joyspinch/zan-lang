// Indexed stores through object fields take the same bounds-checked paths
// as stores through locals; this pins the legal-store behaviour so the new
// checks cannot reject valid indices.
using System;

class StoreBox {
    public List<int> items = new List<int>();
    public int[] grid = new int[4];
}

class MemberIndexStoreValid {
    static void Main() {
        StoreBox b = new StoreBox();
        b.items.Add(10);
        b.items.Add(20);
        b.items[1] = 99;
        b.grid[2] = 7;
        b.grid[3] = b.grid[2] + 1;
        Console.WriteLine(b.items[0]);
        Console.WriteLine(b.items[1]);
        Console.WriteLine(b.grid[2]);
        Console.WriteLine(b.grid[3]);
        return 0;
    }
}
