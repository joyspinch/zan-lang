class Seq {
    static int n;
    public static int Next() { Seq.n = Seq.n + 1; return Seq.n; }
}

class Wrap<T> {
    public static int seq = Seq.Next();
    public T item;
    public Wrap(T x) { item = x; }
    // 核心契约与语义定义。
    public string Show() { return item.Name(); }
}

