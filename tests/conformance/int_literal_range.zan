using System;
using System.Collections.Generic;

// An `int` is a signed i32. Hex/bit-pattern spellings in [2^31, 2^32] wrap
// two's-complement in every context -- locals, parameters, returns, fields,
// array elements, and generic List<int>/Dict<int,...> slots (the ARGB design;
// the mask idiom `x & 4294967295` rides the same exemption as a binary
// expression). A *decimal* literal in that range no longer wraps: it narrows
// with a C# CS0031-style error (see diag_decimal_literal_narrowing) and the
// explicit cast is the opt-in.
class Program {
    static int fld = 0xFFFFFFFF;
    static int F() { return 0xFFFFFFFF; }
    static int Echo(int x) { return x; }
    static int Mask(int x) { return x & 4294967295; }
    static void Main() {
        int a = 0xFFFFFFFF;
        int c = 0x7FFFFFFF;
        Console.WriteLine(a);
        Console.WriteLine(c);
        Console.WriteLine(F());
        Console.WriteLine(Echo(0xFFFFFFFF));
        Console.WriteLine(fld);
        Console.WriteLine(Mask(-1));

        int[] arr = new int[2];
        arr[0] = 0xFFFFFFFF;
        arr[1] = 1000;
        Console.WriteLine(arr[0]);
        Console.WriteLine(arr[1]);

        long L = 0xFFFFFFFF;
        Console.WriteLine(L);

        List<int> vs = new List<int>();
        vs.Add(0xFFFFFFFF);
        vs.Add(5);
        Console.WriteLine(vs[0]);
        Console.WriteLine(vs[1]);

        Dictionary<int,int> d = new Dictionary<int,int>();
        d[0xFFFFFFFF] = 11;
        d[-1] = 22;
        Console.WriteLine(d.Count);
        Console.WriteLine(d[0xFFFFFFFF]);
        int key = 0xFFFFFFFF;
        Console.WriteLine(d[key]);

        Dictionary<int,int> d2 = new Dictionary<int,int>();
        d2.Add(7, 0xFFFFFFFF);
        Console.WriteLine(d2[7]);

        // The opt-in: an explicit cast still narrows by bit pattern.
        int casted = (int)4294967295L;
        Console.WriteLine(casted);
    }
}
