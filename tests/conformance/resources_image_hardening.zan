using System;
using System.Drawing.Imaging;
using System.IO;
using System.Resources;

class Program {
    static void Main() {
        // --- 1. Zan.Image / ImageCodec Hardening ---
        Console.WriteLine("=== IMAGE CODEC TEST ===");
        string svg = "<svg width='16' height='16'><rect width='16' height='16' fill='red'/></svg>";
        int svgW = ImageCodec.LoadSvg("mem:test_icon", svg, 16, 16);
        Console.WriteLine("SVG Load: " + (svgW > 0 ? "success" : "failed"));
        Console.WriteLine("Icon Width: " + Convert.ToString(ImageCodec.Width("mem:test_icon")));
        Console.WriteLine("Icon Height: " + Convert.ToString(ImageCodec.Height("mem:test_icon")));
        ImageCodec.Evict("mem:test_icon");
        Console.WriteLine("Evict Width: " + Convert.ToString(ImageCodec.Width("mem:test_icon")));

        // --- 2. Zan.Resources / ResourcePack Hardening ---
        Console.WriteLine("=== RESOURCE PACK TEST ===");
        string packPath = "_scratch/test_pack.zrp";
        ResourcePackWriter writer = new ResourcePackWriter();
        string data1 = "{\"app\":\"Zan\"}";
        string data2 = "TopSecretResourceData";
        writer.Add("config.json", data1, data1.Length);
        writer.Add("secret.txt", data2, data2.Length);

        string masterKey = "0123456789abcdef0123456789abcdef"; // 32 bytes
        bool wrote = writer.Write(packPath, masterKey, null, null);
        Console.WriteLine("Pack Write: " + (wrote ? "success" : "failed"));

        List<int> err = new List<int>();
        err.Add(0);
        ResourcePack pack = ResourcePack.Open(packPath, masterKey, null, null, err);
        Console.WriteLine("Pack Open err: " + Convert.ToString(err[0]));
        if (pack != null) {
            Console.WriteLine("Pack Count: " + Convert.ToString(pack.Count()));
            Console.WriteLine("Contains config: " + (pack.Contains("config.json") ? "true" : "false"));
            Console.WriteLine("Contains secret: " + (pack.Contains("secret.txt") ? "true" : "false"));
            Console.WriteLine("Size of config: " + Convert.ToString(pack.SizeOf("config.json")));

            List<int> outLen = new List<int>();
            outLen.Add(0);
            byte[] pt1 = pack.Read("config.json", outLen);
            Console.WriteLine("Read config len: " + Convert.ToString(outLen[0]));
            if (pt1 != null) {
                Console.WriteLine("Read config match: " + (outLen[0] == data1.Length ? "true" : "false"));
            }
        }

        if (File.Exists(packPath)) {
            File.Delete(packPath);
        }

        Console.WriteLine("ALL PASSED");
    }
}
