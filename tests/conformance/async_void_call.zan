using System;

// An async void method called (not awaited) from an async Main: the call
// only allocates the frame, so the call site has to hand it to the
// cooperative scheduler -- otherwise the body never runs.
class Program {
    static async void Main() {
        Work();
        await Task.Delay(50);
        Console.WriteLine("done");
    }

    static async void Work() {
        await Task.Delay(1);
        Console.WriteLine("work");
    }
}
