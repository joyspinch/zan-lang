using System;
using System.Collections.Generic;

class ClearItem { public int Value; }
class ClearWitness { public weak ClearItem Item; }

class ClearOwner {
    public List<ClearItem> Items = new List<ClearItem>();
    public List<ClearItem> Children { get { return Items; } }
    public List<ClearItem> GetItems() { return Items; }
    public void ClearBare() { Children.Clear(); }
    public void ClearThis() { this.Children.Clear(); }
}

class Program {
    static void Check(bool condition, string message) {
        if (!condition) throw new Exception(message);
    }
    static void Fill(ClearOwner owner, ClearWitness witness) {
        ClearItem item = new ClearItem();
        witness.Item = item;
        owner.Items.Add(item);
    }
    static void Main() {
        ClearOwner owner = new ClearOwner();
        ClearWitness witness = new ClearWitness();
        for (int i = 0; i < 8; i++) {
            Fill(owner, witness);
            owner.Children.Clear();
            Check(witness.Item == null && owner.Items.Count == 0, "member getter clear");
            owner.Children.Clear();
            Fill(owner, witness);
            owner.ClearBare();
            Check(witness.Item == null && owner.Items.Count == 0, "bare getter clear");
            Fill(owner, witness);
            owner.ClearThis();
            Check(witness.Item == null && owner.Items.Count == 0, "this getter clear");
            Fill(owner, witness);
            owner.GetItems().Clear();
            Check(witness.Item == null && owner.Items.Count == 0, "call receiver clear");
            Fill(owner, witness);
            owner.Items.Clear();
            Check(witness.Item == null && owner.Items.Count == 0, "borrowed field clear");
            List<ClearItem> borrowed = owner.Items;
            borrowed.Clear();
            borrowed.Add(new ClearItem());
            Check(borrowed.Count == 1 && owner.Items.Count == 1, "borrowed local consumed");
            borrowed.Clear();
        }
        Console.WriteLine("ARC_LIST_CLEAR_RECEIVER_OK");
    }
}
