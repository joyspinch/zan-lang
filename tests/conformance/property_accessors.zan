// Property accessors (B): block-body getters/setters, expression-body getters,
// automatic properties with/without initializers, getter-only (read-only)
// properties, static properties, ++/compound assignment through accessors, and
// object initializers dispatching to setters.
class A {
    private int backing = 10;
    public int BlockGetter { get { return backing + 5; } }      // block getter
    public int ExprGetter => backing * 2;                       // expr-body getter
    public int Mixed { get { return backing + 1; } set { backing = value; } }
    public int Auto { get; set; }                               // automatic
    public int AutoInit { get; set; } = 42;                     // automatic + init
    public int ReadOnly { get; }                                // getter-only
    public int IncProp { get { return backing; } set { backing = value; } }
    public static int StatMixed { get { return 5; } set { StatAuto = value; } }
    public static int StatAuto { get; set; } = 77;              // static + init
}
class P {
    static void Main() {
        A a = new A();
        Console.WriteLine(a.BlockGetter);   // 15
        Console.WriteLine(a.ExprGetter);    // 20
        a.Auto = 7;
        Console.WriteLine(a.Auto);          // 7
        Console.WriteLine(a.AutoInit);      // 42
        a.AutoInit = 3;
        Console.WriteLine(a.AutoInit);      // 3
        A b = new A();
        Console.WriteLine(b.AutoInit);      // 42 (per-instance backing)
        a.Mixed = 100;
        Console.WriteLine(a.Mixed);         // 101
        a.Mixed += 5;
        Console.WriteLine(a.Mixed);         // 107
        a.IncProp++;
        Console.WriteLine(a.IncProp);       // 107
        a.IncProp = 20;
        Console.WriteLine(a.IncProp);       // 20
        A.StatMixed = 9;
        Console.WriteLine(A.StatAuto);      // 9 (setter wrote the static slot)
        Console.WriteLine(A.StatMixed);     // 5 (getter is constant)
        A.StatAuto = 99;
        Console.WriteLine(A.StatAuto);      // 99
        A c = new A { Mixed = 50, Auto = 8 };
        Console.WriteLine(c.Mixed);         // 51 (object initializer -> setter)
        Console.WriteLine(c.Auto);          // 8
        a.Mixed = a.Mixed + 1;
        Console.WriteLine(a.Mixed);         // 23
    }
}
