using System;
using System.Collections.Generic;

// 委托变量实参按委托签名选重载：Add(Action) 与 Add(SenderFn) 并存时，
// 传入 SenderFn 类型的变量/形参必须落到 Add(SenderFn)。曾经两个非泛型
// 委托被判"同一具体类型"，打分打平后先声明的 Add(Action) 获胜，闭包按
// 无参签名被调用（ARC 守卫下表现为重入已释放对象）。
public delegate void SenderFn(Node sender);
public delegate int Pick(int a, int b);

public class Hub {
    List<Action> plain = new List<Action>();
    List<SenderFn> withSender = new List<SenderFn>();
    public string last = "";
    public void Add(Action h) { plain.Add(h); last = "plain"; }
    public void Add(SenderFn h) { withSender.Add(h); last = "sender"; }
    public int Apply(Func<int, int> f) { return f(1); }
    public int Apply(Pick f) { return f(2, 3); }
    public void Raise(Node n) {
        for (int i = 0; i < plain.Count; i = i + 1) { Action h = plain[i]; h(); }
        for (int i = 0; i < withSender.Count; i = i + 1) { SenderFn h = withSender[i]; h(n); }
    }
}

public class Node {
    public string name;
    public Hub hub = new Hub();
    public Node(string n) { name = n; }
    // 形参转发：委托变量再传给重载方法。
    public void Bind(SenderFn h) { hub.Add(h); }
    public void Bind(Action h) { hub.Add(h); }
}

class Program {
    static string trace = "";
    static void Main() {
        Node n = new Node("n1");
        SenderFn s = (Node x) => { trace = trace + "S:" + x.name + " "; };
        Action a = () => { trace = trace + "A "; };
        n.hub.Add(s);
        Console.WriteLine("local sender var -> " + n.hub.last);
        n.hub.Add(a);
        Console.WriteLine("local action var -> " + n.hub.last);
        n.Bind(s);
        Console.WriteLine("forwarded sender param -> " + n.hub.last);
        n.Bind(a);
        Console.WriteLine("forwarded action param -> " + n.hub.last);
        n.hub.Raise(n);
        Console.WriteLine(trace.Trim());
        Pick p = (int x, int y) => x * y;
        Func<int, int> f = (int x) => x + 10;
        Console.WriteLine("Pick var -> " + Convert.ToString(n.hub.Apply(p)));
        Console.WriteLine("Func var -> " + Convert.ToString(n.hub.Apply(f)));
    }
}
