// await 一个**同步**委托：拿到的是委托的返回值，不是子协程帧。
//
// 为什么要有这个用例：await 的目标分两类——异步目标（值是子协程帧，
// 结果从帧里抽）与普通目标（值就是普通值）。判错了就是读野指针：
// 普通值往往也是 i8 指针（字符串就是），与子协程帧同型，被当成帧去读
// 就会读出垃圾，而且**不报错**。
//
// 曾经的症状：`await syncDelegate()` 返回 null；字符串型返回值还会
// 先崩一次（拿野指针当长度探测）。
class Program {
    public delegate string SyncFn(int x);
    public async delegate string AsyncFn(int x);

    static string Double(int x) { return "v" + Convert.ToString(x * 2); }

    static async string ComputeAsync(int x) {
        return "a" + Convert.ToString(x * 2);
    }

    static async int Main() {
        SyncFn f = Program.Double;
        // await 一个非异步的值：原样返回。
        string s = await f(21);
        Console.WriteLine("sync-await=" + s);

        // 不 await 直接调也对。
        string t = f(10);
        Console.WriteLine("sync-call=" + t);

        // 异步方法走另一条路：结果从子协程帧里抽。
        Console.WriteLine("async-await=" + await Program.ComputeAsync(21));

        // 异步委托：调用产出的值是子协程帧，结果从帧里抽。
        AsyncFn af = Program.ComputeAsync;
        Console.WriteLine("async-delegate=" + await af(10));
        return 0;
    }
}
