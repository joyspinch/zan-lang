using System;
using Zan.Web.Core;
using Zan.Web;
using Zan.Web.Security;
using Zan.Web.Services;
using Zan.Web.Framework.Security;

class MvcHardeningTest {
    static int Main() {
        // 1. Verify Fmt formatting
        if (Fmt.Bytes(1024) != "1 KB") { return 1; }
        if (Fmt.MaskMobile("13800138000") != "138****8000") { return 2; }
        if (Fmt.MaskEmail("user@example.com") != "u***r@example.com") { return 3; }
        if (Fmt.Dash("") != "—") { return 4; }
        if (Fmt.PublishedText(1) != "已发布") { return 5; }
        if (Fmt.EnabledText(1) != "启用") { return 6; }

        // 2. Verify MarkdownLite
        string html = MarkdownLite.Html("### Subheader\nParagraph text");
        if (!html.Contains("<h5>Subheader</h5>")) { return 7; }
        if (!html.Contains("<p>Paragraph text</p>")) { return 8; }

        // 3. Verify Codes constants
        if (Codes.Ok != "0000" || Codes.NoAuth != "0001" || Codes.NoPerm != "0403") { return 9; }

        // 4. Verify ClientIp
        if (ClientIp.Canonical("127.0.0.1") != "127.0.0.1") { return 10; }
        if (ClientIp.Canonical("::1") != "0000:0000:0000:0000:0000:0000:0000:0001") { return 11; }

        // 5. Verify DataScope
        DataScope scope = DataScope.None();
        if (scope.Any()) { return 12; }
        if (!scope.ByDept()) { return 13; }
        if (scope.Covers(100, 1)) { return 14; }

        DataScope all = DataScope.Everything(42);
        if (!all.Any()) { return 15; }
        if (!all.Covers(99, 99)) { return 16; }

        // 6. Verify Perm bit arithmetic
        if (Perm.BitValue("View") != 1) { return 17; }
        if (Perm.BitValue("Create") != 2) { return 18; }
        if (Perm.BitValue("View|Create") != 3) { return 19; }
        if (Perm.ScreenOf("Admin.Users.Save") != "Admin.Users") { return 20; }

        // 7. Verify CacheContext local
        CacheContext cache = CacheContext.Of(null);
        if (cache.Shared()) { return 21; }
        cache.LocalSet("k1", "v1");
        if (cache.LocalGet("k1") != "v1") { return 22; }
        if (!cache.LocalHas("k1")) { return 23; }
        cache.LocalDel("k1");
        if (cache.LocalHas("k1")) { return 24; }

        // 8. Verify AppServices
        AppServices s = new AppServices(null, cache);
        AppServices.Use(s);
        if (AppServices.Current() != s) { return 25; }
        if (AppServices.Current().Cache() != cache) { return 26; }

        // 9. Verify Cache facade
        Cache.LocalSet("foo", "bar");
        if (Cache.LocalGet("foo") != "bar") { return 27; }
        Cache.LocalDel("foo");
        if (Cache.LocalHas("foo")) { return 28; }

        Console.WriteLine("MVC_HARDENING_OK");
        return 0;
    }
}
