using System;

class ReflectNumericResult {
    object payload = new object();

    public object Payload() { return payload; }
    public object Empty() { return null; }
    public long Wide() { return 4294967295L; }
    public double Fraction() { return -7.5; }

    static void CheckTyped(ReflectNumericResult target) {
        long address = target.InvokeLong("Payload");
        Console.WriteLine("typed-reference=" + (address != 0 && target.InvokeInt("Payload") == (int)address
            && target.InvokeDouble("Payload") == (double)address));
        Console.WriteLine("typed-null=" + (target.InvokeInt("Empty") == 0 && target.InvokeDouble("Empty") == 0.0));
    }

    static void CheckErased(object target) {
        long address = target.InvokeLong("Payload");
        Console.WriteLine("erased-reference=" + (address != 0 && target.InvokeInt("Payload") == (int)address
            && target.InvokeDouble("Payload") == (double)address));
        Console.WriteLine("erased-null=" + (target.InvokeInt("Empty") == 0 && target.InvokeDouble("Empty") == 0.0));
        Console.WriteLine("wide=" + target.InvokeInt("Wide"));
        Console.WriteLine("fraction-int=" + target.InvokeLong("Fraction"));
        Console.WriteLine("fraction-double=" + target.InvokeDouble("Fraction"));
    }

    static void Main() {
        ReflectNumericResult target = new ReflectNumericResult();
        CheckTyped(target);
        CheckErased(target);
    }
}
