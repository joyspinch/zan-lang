using System;
using System.Linq;

class TestItem {
    public int id;
    public string name;
    public double score;

    public TestItem(int id, string name, double score) {
        this.id = id;
        this.name = name;
        this.score = score;
    }
}

class Program {
    static void Main() {
        // 1. Basic Enumerable Operations
        List<int> nums = new List<int>();
        nums.Add(5);
        nums.Add(2);
        nums.Add(8);
        nums.Add(1);
        nums.Add(9);
        nums.Add(2);

        List<int> evens = nums.Where((int x) => x % 2 == 0);
        Console.WriteLine("evens_count=" + evens.Count);

        List<int> sorted = nums.OrderBy((int x) => x);
        Console.WriteLine("sorted_first=" + sorted[0] + " sorted_last=" + sorted[sorted.Count - 1]);

        List<int> distinct = nums.Distinct();
        Console.WriteLine("distinct_count=" + distinct.Count);

        int sum = nums.Sum();
        int min = nums.Min();
        int max = nums.Max();
        Console.WriteLine("sum=" + sum + " min=" + min + " max=" + max);

        bool anyBig = nums.Any((int x) => x > 8);
        bool allPositive = nums.All((int x) => x > 0);
        Console.WriteLine("any_big=" + anyBig + " all_pos=" + allPositive);

        // 2. Stream Pipeline
        List<int> streamRes = nums.AsStream()
            .Where((int x) => x > 2)
            .Distinct()
            .Take(3)
            .ToList();
        Console.WriteLine("stream_count=" + streamRes.Count);

        // 3. Object Projection & GroupBy
        List<TestItem> items = new List<TestItem>();
        items.Add(new TestItem(1, "Alice", 95.5));
        items.Add(new TestItem(2, "Bob", 82.0));
        items.Add(new TestItem(3, "Charlie", 95.5));
        items.Add(new TestItem(4, "David", 60.0));

        List<string> names = items.Select((TestItem it) => it.name);
        Console.WriteLine("names_count=" + names.Count + " first=" + names[0]);

        List<Grouping<TestItem>> groups = items.GroupByStr((TestItem it) => Convert.ToString((int)it.score));
        Console.WriteLine("groups_count=" + groups.Count);

        // 4. Set Algebra (Union, Intersect, Except)
        List<int> setA = new List<int>();
        setA.Add(1); setA.Add(2); setA.Add(3);
        List<int> setB = new List<int>();
        setB.Add(2); setB.Add(3); setB.Add(4);

        List<int> union = setA.Union(setB);
        List<int> inter = setA.Intersect(setB);
        List<int> diff = setA.Except(setB);
        Console.WriteLine("union=" + union.Count + " inter=" + inter.Count + " diff=" + diff.Count);

        // 5. Dict Mapping
        Dict<int, string> idNameMap = items.ToDictInt<TestItem, string>(
            (TestItem it) => it.id,
            (TestItem it) => it.name
        );
        Console.WriteLine("map_alice=" + idNameMap[1] + " map_bob=" + idNameMap[2]);

        // 6. Expr & ExprNode
        ExprNode node = new ExprNode();
        node.Kind = 1;
        node.IVal = 42;
        Expr<int> expr = Expr<int>.From(node);
        Console.WriteLine("expr_kind=" + expr.Root.Kind + " expr_val=" + expr.Root.IVal);

        Console.WriteLine("linq_hardening_ok");
    }
}
