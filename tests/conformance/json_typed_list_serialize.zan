using System;
using System.Collections.Generic;
using System.Json;

class TypedJsonRow { public int id; public string name; }
class TypedJsonRows { public List<TypedJsonRow> rows; }
enum TypedJsonTier { Low, Mid, High }
class Program {
    static void Equal(string label, string actual, string expected) {
        if (actual != expected) { throw new Exception(label + ": " + actual + " != " + expected); }
    }
    static void Roundtrip<T>(string label, string json) {
        try {
            T value = Json.Deserialize<T>(json);
            Equal(label, Json.Serialize<T>(value), json);
            if (json != "null") {
                object erased = (object)value;
                Equal(label + " runtime type", erased.GetType().Name, typeof(T).Name);
            } else if (value != null) { throw new Exception(label + ": expected null"); }
        } catch (Exception ex) { throw new Exception(label + ": " + ex.Message); }
    }
    static void Main() {
        List<TypedJsonRow> rows = new List<TypedJsonRow>();
        Equal("empty entity list", Json.Serialize<List<TypedJsonRow>>(rows), "[]");
        TypedJsonRow row = new TypedJsonRow(); row.id = 9; row.name = "a\"b";
        rows.Add(row); rows.Add(null);
        Equal("entity list", Json.Serialize<List<TypedJsonRow>>(rows), "[{\"id\":9,\"name\":\"a\\\"b\"},null]");
        TypedJsonRows doc = new TypedJsonRows(); doc.rows = rows;
        Equal("entity list field", Json.Serialize<TypedJsonRows>(doc), "{\"rows\":[{\"id\":9,\"name\":\"a\\\"b\"},null]}");
        doc.rows = null;
        Equal("null list field", Json.Serialize<TypedJsonRows>(doc), "{\"rows\":null}");
        Equal("null root", Json.Serialize<List<TypedJsonRow>>(null), "null");
        List<List<TypedJsonRow>> nested = new List<List<TypedJsonRow>>();
        nested.Add(rows); nested.Add(new List<TypedJsonRow>()); nested.Add(null);
        Equal("nested lists", Json.Serialize<List<List<TypedJsonRow>>>(nested), "[[{\"id\":9,\"name\":\"a\\\"b\"},null],[],null]");
        List<JsonValue> values = new List<JsonValue>();
        values.Add(JsonValue.NewInt(3)); values.Add(JsonValue.NewStr("ok")); values.Add(null);
        Equal("JsonValue list", Json.Serialize<List<JsonValue>>(values), "[3,\"ok\",null]");
        List<Dict<string, int>> dictionaries = new List<Dict<string, int>>();
        Dict<string, int> entry = new Dict<string, int>(); entry["n"] = 4;
        dictionaries.Add(entry); dictionaries.Add(null);
        Equal("dictionary list", Json.Serialize<List<Dict<string, int>>>(dictionaries), "[{\"n\":4},null]");
        List<int> ints = new List<int>(); ints.Add(7); ints.Add(-2);
        Equal("int control", Json.Serialize<List<int>>(ints), "[7,-2]");
        List<string> strings = new List<string>(); strings.Add("ok"); strings.Add(null);
        Equal("string control", Json.Serialize<List<string>>(strings), "[\"ok\",null]");
        List<long> longs = new List<long>(); longs.Add(2147483648L);
        Equal("long control", Json.Serialize<List<long>>(longs), "[2147483648]");
        List<double> doubles = new List<double>(); doubles.Add(1.5);
        Equal("double control", Json.Serialize<List<double>>(doubles), "[1.5]");
        List<bool> bools = new List<bool>(); bools.Add(true); bools.Add(false);
        Equal("bool control", Json.Serialize<List<bool>>(bools), "[true,false]");
        List<TypedJsonTier> tiers = new List<TypedJsonTier>(); tiers.Add(TypedJsonTier.Low); tiers.Add(TypedJsonTier.High);
        Equal("enum list", Json.Serialize<List<TypedJsonTier>>(tiers), "[0,2]");
        List<short> shorts = new List<short>(); shorts.Add((short)12); shorts.Add((short)-3);
        Equal("short list", Json.Serialize<List<short>>(shorts), "[12,-3]");
        List<byte> bytes = new List<byte>(); bytes.Add((byte)5); bytes.Add((byte)255);
        Equal("byte list", Json.Serialize<List<byte>>(bytes), "[5,255]");
        List<float> floats = new List<float>(); floats.Add((float)1.5);
        Equal("float list", Json.Serialize<List<float>>(floats), "[1.5]");
        Roundtrip<List<TypedJsonRow>>("empty entity roundtrip", "[]");
        Roundtrip<List<TypedJsonRow>>("entity roundtrip", "[{\"id\":9,\"name\":\"a\\\"b\"},null]");
        Roundtrip<TypedJsonRows>("field roundtrip", "{\"rows\":[{\"id\":9,\"name\":\"a\\\"b\"},null]}");
        Roundtrip<TypedJsonRows>("null field roundtrip", "{\"rows\":null}");
        Roundtrip<List<TypedJsonRow>>("null root roundtrip", "null");
        Roundtrip<List<List<TypedJsonRow>>>("nested roundtrip", "[[{\"id\":9,\"name\":\"a\\\"b\"},null],[],null]");
        Roundtrip<List<JsonValue>>("JsonValue roundtrip", "[3,\"ok\",null]");
        Roundtrip<List<Dict<string, int>>>("dict roundtrip", "[{\"n\":4},null]");
        Roundtrip<List<int>>("int roundtrip", "[7,-2]");
        Roundtrip<List<string>>("string roundtrip", "[\"ok\",null]");
        Roundtrip<List<long>>("long roundtrip", "[2147483648]");
        Roundtrip<List<double>>("double roundtrip", "[1.5]");
        Roundtrip<List<bool>>("bool roundtrip", "[true,false]");
        Roundtrip<List<TypedJsonTier>>("enum roundtrip", "[0,2]");
        Roundtrip<List<short>>("short roundtrip", "[12,-3]");
        Roundtrip<List<byte>>("byte roundtrip", "[5,255]");
        Roundtrip<List<float>>("float roundtrip", "[1.5]");
        Roundtrip<List<List<TypedJsonTier>>>("nested enum roundtrip", "[[0,2],[],null]");
        Roundtrip<List<List<float>>>("nested float roundtrip", "[[1.5],[],null]");
        Roundtrip<List<int>>("empty primitive roundtrip", "[]");
        Roundtrip<List<int>>("null primitive root roundtrip", "null");
        Equal("lenient int scalar", Json.Serialize<List<int>>(Json.Deserialize<List<int>>("7")), "[7]");
        Equal("lenient float scalar", Json.Serialize<List<float>>(Json.Deserialize<List<float>>("1.5")), "[1.5]");
        Equal("lenient string scalar", Json.Serialize<List<string>>(Json.Deserialize<List<string>>("\"ok\"")), "[\"ok\"]");
        Equal("lenient entity singleton", Json.Serialize<List<TypedJsonRow>>(Json.Deserialize<List<TypedJsonRow>>("{\"id\":9,\"name\":\"ok\"}")), "[{\"id\":9,\"name\":\"ok\"}]");
        List<TypedJsonRow> restored = Json.Deserialize<List<TypedJsonRow>>("[{\"id\":9,\"name\":\"ok\"},null]");
        if (restored.Count != 2 || restored[0].id != 9 || restored[1] != null) { throw new Exception("entity null position"); }
        TypedJsonRows field = Json.Deserialize<TypedJsonRows>("{\"rows\":[{\"id\":9,\"name\":\"ok\"},null]}");
        Equal("field list runtime type", ((object)field.rows).GetType().Name, typeof(List<TypedJsonRow>).Name);
        List<List<TypedJsonRow>> restoredNested = Json.Deserialize<List<List<TypedJsonRow>>>("[[],null]");
        if (restoredNested.Count != 2 || restoredNested[0].Count != 0 || restoredNested[1] != null) { throw new Exception("nested null position"); }
        Equal("nested list runtime type", ((object)restoredNested[0]).GetType().Name, typeof(List<TypedJsonRow>).Name);
        List<JsonValue> restoredValues = Json.Deserialize<List<JsonValue>>("[3,\"ok\",null]");
        if (restoredValues.Count != 3 || restoredValues[2] != null) { throw new Exception("JsonValue null position"); }
        List<Dict<string, int>> restoredDicts = Json.Deserialize<List<Dict<string, int>>>("[{\"n\":4},null]");
        if (restoredDicts.Count != 2 || restoredDicts[0]["n"] != 4 || restoredDicts[1] != null) { throw new Exception("dict null position"); }
        object erased = (object)rows;
        bool rejected = false;
        try { List<object> invalid = (List<object>)erased; }
        catch (InvalidCastException) { rejected = true; }
        if (!rejected) { throw new Exception("closed generic cast must remain checked"); }
        Console.WriteLine("json typed list serialization and roundtrip PASS");
    }
}
