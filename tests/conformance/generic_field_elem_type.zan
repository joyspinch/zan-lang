// 核心契约与语义定义。
// crashed.
using System;
using System.Collections.Generic;

namespace T;

class Box<T> {
    public List<T> values;
    public T single;

    public Box(T initial) {
        this.values = new List<T>();
        this.values.Add(initial);
        this.single = initial;
    }
}

class Program {
    static void Main() {
        Box<int> ints = new Box<int>(7);
        Console.WriteLine("int=" + Convert.ToString(ints.values[0]));
        Console.WriteLine("count=" + Convert.ToString(ints.values.Count));

        Box<double> doubles = new Box<double>(1.5);
        Console.WriteLine("double=" + Convert.ToString(doubles.values[0]));

        Box<string> strings = new Box<string>("zan");
        Console.WriteLine("string=" + Convert.ToString(strings.values[0]));

        int sum = ints.values[0] + 1;
        Console.WriteLine("sum=" + Convert.ToString(sum));
    }
}
