// System.Net.Http.Proxy.HttpForwarder: upstream connections must be reused
// across requests. Forwarding an AI/API endpoint pays a TCP (and, over TLS, a
// handshake) round trip per request otherwise, which dwarfs the cost of moving
// the bytes; the pool turns that into one setup per upstream link.
//
// The upstream is a raw socket server so connection reuse is directly
// observable: it counts accepted connections and how many requests each one
// carried, and it exercises the cases where reuse must NOT happen:
//   /len     Content-Length framed, keep-alive        -> reusable
//   /chunked chunked, keep-alive                      -> reusable
//   /nolen   no length, delimited by close            -> must not be pooled
//   /close   keep-alive framing but Connection: close -> must not be pooled
//   /204     no body by definition                    -> reusable
// The last check closes an idle pooled link from the upstream side: the next
// request must still succeed (the forwarder retries a body-less request on a
// fresh link), which is the race every keep-alive client has to survive.
using System;
using System.Net.Sockets;
using System.Net.Http.Proxy;

namespace Conf;

class Prog {
    static int UP_PORT = 9631;
    static int FWD_PORT = 9632;
    static int accepted;
    static int requests;
    static bool killIdle;

    static async void Upstream() {
        TcpListener l = new TcpListener("127.0.0.1", Prog.UP_PORT);
        l.Start();
        while (true) {
            nint c = await l.AcceptAsync();
            if (c < 0) { break; }
            Prog.accepted = Prog.accepted + 1;
            Task.Spawn(Prog.ServeUpstream(c));
        }
        l.Stop();
    }

    /// Serves requests on one connection until the peer goes away (or the
    /// response itself says the connection ends).
    static async void ServeUpstream(nint c) {
        string buf = "";
        while (true) {
            while (Prog.Find(buf, "\r\n\r\n") < 0) {
                string piece = await Socket.RecvAsync(c, 8192);
                if (piece.Length == 0) { Socket.Close(c); return; }
                buf = buf + piece;
            }
            int hb = Prog.Find(buf, "\r\n\r\n");
            string head = buf.Substring(0, hb + 4);
            buf = buf.Substring(hb + 4, buf.Length - hb - 4);
            Prog.requests = Prog.requests + 1;

            if (Prog.Find(head, "/chunked") >= 0) {
                int _c = await Socket.SendStringAsync(c,
                    "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
                    + "5\r\nchunk\r\n0\r\n\r\n");
            } else if (Prog.Find(head, "/nolen") >= 0) {
                // Neither Content-Length nor chunked: the body ends when the
                // connection does, so this link can never be pooled.
                int _n = await Socket.SendStringAsync(c,
                    "HTTP/1.1 200 OK\r\n\r\nstreamed");
                Socket.Close(c);
                return;
            } else if (Prog.Find(head, "/close") >= 0) {
                int _x = await Socket.SendStringAsync(c,
                    "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n"
                    + "Connection: close\r\n\r\nbye!!");
                Socket.Close(c);
                return;
            } else if (Prog.Find(head, "/204") >= 0) {
                int _e = await Socket.SendStringAsync(c,
                    "HTTP/1.1 204 No Content\r\n\r\n");
            } else {
                int _o = await Socket.SendStringAsync(c,
                    "HTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\nlenbdy");
            }

            if (Prog.killIdle) {
                // Drop the idle link the way a real upstream does when its own
                // keep-alive timer fires.
                await Task.Delay(40);
                Socket.Close(c);
                return;
            }
        }
    }

    static int Find(string hay, string needle) {
        return Prog.FindFrom(hay, needle, 0);
    }

    static int FindFrom(string hay, string needle, int from) {
        int n = hay.Length;
        int m = needle.Length;
        for (int i = from; i + m <= n; i = i + 1) {
            int k = 0;
            while (k < m && (hay[i + k] & 255) == (needle[k] & 255)) {
                k = k + 1;
            }
            if (k == m) { return i; }
        }
        return -1;
    }

    /// One downstream request per connection (the forwarder closes the client
    /// side after each response), returning head + body.
    static async string Ask(string path) {
        TcpClient c = await TcpClient.ConnectAsync("127.0.0.1", Prog.FWD_PORT,
                                                   5000);
        if (c == null) { return ""; }
        int _s = await c.SendAsync("GET " + path
            + " HTTP/1.1\r\nHost: front\r\n\r\n");
        string all = "";
        while (true) {
            string piece = await c.RecvAsync(8192);
            if (piece.Length == 0) { break; }
            all = all + piece;
        }
        c.Close();
        return all;
    }

    static string BodyOf(string resp) {
        int hb = Prog.Find(resp, "\r\n\r\n");
        if (hb < 0) { return ""; }
        return resp.Substring(hb + 4, resp.Length - hb - 4);
    }

    static async int Run() {
        Socket.Initialize();
        Prog.accepted = 0;
        Prog.requests = 0;
        Prog.killIdle = false;
        Task.Spawn(Prog.Upstream());
        HttpForwarder fwd = new HttpForwarder("127.0.0.1", Prog.FWD_PORT,
            "http://127.0.0.1:" + Convert.ToString(Prog.UP_PORT));
        fwd.SetTimeout(10000);
        Task.Spawn(fwd.Start());
        await Task.Delay(120);

        // 1. Four Content-Length responses in a row ride one upstream link.
        string bodies = "";
        for (int i = 0; i < 4; i = i + 1) {
            bodies = bodies + Prog.BodyOf(await Prog.Ask("/len"));
        }
        Console.WriteLine("len-bodies: " + bodies);
        Console.WriteLine("len-one-upstream-conn: "
            + Convert.ToString(Prog.accepted == 1 ? 1 : 0));
        Console.WriteLine("len-requests: " + Convert.ToString(Prog.requests));
        Console.WriteLine("pool-hits-3: "
            + Convert.ToString(fwd.UpstreamPool().Hits() == 3 ? 1 : 0));

        // 2. Chunked responses are self-delimiting too, so the same link
        //    keeps serving (and the frames reach the client untouched).
        string ch1 = Prog.BodyOf(await Prog.Ask("/chunked"));
        string ch2 = Prog.BodyOf(await Prog.Ask("/chunked"));
        Console.WriteLine("chunked-frames: "
            + Convert.ToString(Prog.Find(ch1, "5\r\nchunk\r\n0\r\n\r\n") >= 0
                && Prog.Find(ch2, "5\r\nchunk\r\n0\r\n\r\n") >= 0 ? 1 : 0));
        Console.WriteLine("chunked-still-one-conn: "
            + Convert.ToString(Prog.accepted == 1 ? 1 : 0));

        // 3. A 204 carries no body by definition: reusable, and the forwarder
        //    must not wait for bytes that will never come.
        string r204 = await Prog.Ask("/204");
        Console.WriteLine("no-content-204: "
            + Convert.ToString(Prog.Find(r204, "204 No Content") >= 0
                && Prog.BodyOf(r204).Length == 0 ? 1 : 0));
        Console.WriteLine("no-content-still-one-conn: "
            + Convert.ToString(Prog.accepted == 1 ? 1 : 0));

        // 4. A close-delimited response can't be pooled: the upstream link is
        //    gone, so the next request needs a new one.
        string nolen = Prog.BodyOf(await Prog.Ask("/nolen"));
        int accAfterNolen = Prog.accepted;
        string afterNolen = Prog.BodyOf(await Prog.Ask("/len"));
        Console.WriteLine("nolen-body: " + nolen);
        Console.WriteLine("nolen-not-pooled: "
            + Convert.ToString(Prog.accepted == accAfterNolen + 1 ? 1 : 0));
        Console.WriteLine("after-nolen-body: " + afterNolen);

        // 5. Connection: close on a Content-Length response: body still
        //    correct, link retired.
        string closed = Prog.BodyOf(await Prog.Ask("/close"));
        int accAfterClose = Prog.accepted;
        string afterClose = Prog.BodyOf(await Prog.Ask("/len"));
        Console.WriteLine("close-body: " + closed);
        Console.WriteLine("close-not-pooled: "
            + Convert.ToString(Prog.accepted == accAfterClose + 1 ? 1 : 0));
        Console.WriteLine("after-close-body: " + afterClose);

        // 6. The upstream drops the pooled link while it sits idle: the next
        //    request must still be answered (retried on a fresh link).
        Prog.killIdle = true;
        string _warm = Prog.BodyOf(await Prog.Ask("/len"));
        await Task.Delay(200);
        Prog.killIdle = false;
        string revived = Prog.BodyOf(await Prog.Ask("/len"));
        Console.WriteLine("dead-idle-recovered: "
            + Convert.ToString(revived == "lenbdy" ? 1 : 0));

        // 7. With pooling switched off every request opens its own link.
        fwd.DisableUpstreamKeepAlive();
        int accBefore = Prog.accepted;
        string off1 = Prog.BodyOf(await Prog.Ask("/len"));
        string off2 = Prog.BodyOf(await Prog.Ask("/len"));
        Console.WriteLine("disabled-bodies: " + off1 + off2);
        Console.WriteLine("disabled-two-conns: "
            + Convert.ToString(Prog.accepted == accBefore + 2 ? 1 : 0));

        fwd.Stop();
        Console.WriteLine("keepalive-ok: 1");
        // 停服后留几个泵转：accept 协程以 -1 复位并退出，退出时的
        // 泄漏探测才不会把服务端对象链记为仍可达。
        for (int i = 0; i < 20; i = i + 1) { await Task.Delay(10); }
        return 0;
    }

    static void Main() {
        int r = await Prog.Run();
    }
}
