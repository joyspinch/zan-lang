// conformance test: empty List<T> lazy buffer allocation
using System;
using System.Collections.Generic;

class Program {
    static int Main() {
        List<int> l = new List<int>();
        if (l.Count != 0) { return 1; }
        int[] a = l.ToArray();
        if (a.Length != 0) { return 2; }
        l.Add(100);
        if (l.Count != 1 || l[0] != 100) { return 3; }
        l.Clear();
        if (l.Count != 0) { return 4; }
        List<string> s = new List<string>();
        s.Insert(0, "lazy");
        if (s.Count != 1 || s[0] != "lazy") { return 5; }
        Console.WriteLine("list_lazy_init: PASS");
        return 0;
    }
}
