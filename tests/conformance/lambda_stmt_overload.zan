using System;
using System.Linq;

// B-ID85: a statement lambda must rank delegate overloads that differ only in
// return type by its return statements' common type. Before the fix every
// delegate candidate tied at arity and declaration order decided — with the
// string overload declared first, `() => { return 8; }` bound to it and the
// int was reinterpreted as a string pointer (crash or silently wrong keys).
delegate string StrFn();
delegate int NumFn();

class Pick {
    static string OfStr(StrFn f) { return "s" + f(); }
    static string OfNum(NumFn f) { return "n" + Convert.ToString(f()); }
}

class Prog {
    static void Main() {
        // expression lambdas — baseline ranking, always worked
        Console.WriteLine(Pick.OfStr(() => "ex"));
        Console.WriteLine(Pick.OfNum(() => 7));
        // int-returning statement lambda must reject the StrFn overload
        Console.WriteLine(Pick.OfNum(() => { return 8; }));
        // string-returning statement lambda must reject the NumFn overload
        Console.WriteLine(Pick.OfStr(() => { return "blk"; }));
        // the original report: OrderBy keyed by a statement lambda
        List<string> items = new List<string>();
        items.Add("bb"); items.Add("a"); items.Add("ccc");
        List<string> byLen = items.OrderBy(x => { return x.Length; });
        Console.WriteLine(byLen[0] + byLen[1] + byLen[2]);
        List<string> byRule = items.OrderBy(x => {
            if (x == "a") { return 5; }
            return 1;
        });
        Console.WriteLine(byRule[0] + byRule[1] + byRule[2]);
    }
}
