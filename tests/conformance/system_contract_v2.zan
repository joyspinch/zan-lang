using System;
using System.Collections.Generic;
using System.Threading;

class Program {
    static int CompareDesc(int a, int b) {
        return b - a;
    }

    static async Task Main() {
        // 1. List<int>.Sort() QuickSort 验证
        List<int> numbers = new List<int>();
        int cur = 42;
        for (int i = 0; i < 50; i = i + 1) {
            cur = (cur * 1103515245 + 12345) & 2147483647;
            numbers.Add(cur % 1000);
        }
        numbers.Sort();
        for (int i = 0; i < numbers.Count - 1; i = i + 1) {
            if (numbers[i] > numbers[i + 1]) {
                Console.WriteLine("FAIL: int sort");
                return;
            }
        }

        // 2. List<string>.Sort() 验证
        List<string> words = new List<string>();
        words.Add("cherry");
        words.Add("apple");
        words.Add("banana");
        words.Sort();
        if (words[0] != "apple" || words[1] != "banana" || words[2] != "cherry") {
            Console.WriteLine("FAIL: string sort");
            return;
        }

        // 3. List<T>.Sort(comparison) 通用比较器验证
        List<int> descNums = new List<int>();
        descNums.Add(10);
        descNums.Add(40);
        descNums.Add(20);
        descNums.Sort(CompareDesc);
        if (descNums[0] != 40 || descNums[1] != 20 || descNums[2] != 10) {
            Console.WriteLine("FAIL: comparison sort");
            return;
        }

        // 4. StringExtensions 零分配与优化验证
        if (!"   \t\r\n  ".IsNullOrWhiteSpace()) { Console.WriteLine("FAIL: whitespace 1"); return; }
        if ("   abc  ".IsNullOrWhiteSpace()) { Console.WriteLine("FAIL: whitespace 2"); return; }
        if ("   hello".TrimStart() != "hello") { Console.WriteLine("FAIL: trim start"); return; }
        if ("world   ".TrimEnd() != "world") { Console.WriteLine("FAIL: trim end"); return; }
        if ("foo".PadLeft(5) != "  foo") { Console.WriteLine("FAIL: pad left"); return; }

        // 5. TimeSpan 毫秒精度验证
        TimeSpan ts = TimeSpan.FromMilliseconds(1500);
        if (ts.TotalMilliseconds() != 1500 || ts.TotalSeconds() != 1 || ts.Milliseconds() != 500) {
            Console.WriteLine("FAIL: timespan ms");
            return;
        }
        if (ts.ToString() != "00:00:01.500") {
            Console.WriteLine("FAIL: timespan tostring " + ts.ToString());
            return;
        }

        // 6. Thread.SleepAsync 非阻塞验证
        await Thread.SleepAsync(5);

        Console.WriteLine("system-contract-v2-ok: 1");
    }
}
