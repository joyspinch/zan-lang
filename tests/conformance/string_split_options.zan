using System;
using System.Collections.Generic;

class Program {
    static void Main() {
        string s = "a,,b,,,c,";
        List<string> all = s.Split(",");
        Console.WriteLine("all count=" + all.Count.ToString());

        List<string> rm = s.Split(",", StringSplitOptions.RemoveEmptyEntries);
        Console.WriteLine("rm count=" + rm.Count.ToString());
        for (int i = 0; i < rm.Count; i++) {
            Console.WriteLine("rm[" + i.ToString() + "]=" + rm[i]);
        }

        List<string> none = s.Split(",", StringSplitOptions.None);
        Console.WriteLine("none count=" + none.Count.ToString());
    }
}
