// At / KeyAt / ValAt 的非法访问必须抛 JsonException，而不是段崩。
// 历史版本三处都是裸 items[i] / keys[i] / vals[i]：把 At 用在对象上
// （items=null）直接 0xC0000005 且无任何诊断；越界同样裸奔。
using System;
using System.Json;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        JsonValue arr = JsonValue.NewArray();
        arr.Append(JsonValue.NewStr("a"));
        arr.Append(JsonValue.NewStr("b"));
        JsonValue obj = JsonValue.NewObject();
        obj.Put("k", JsonValue.NewStr("v"));
        JsonValue num = JsonValue.NewInt(7);

        bool threw = false;
        try { obj.At(0); } catch (JsonException e) { threw = true; }
        if (!threw) { bad = bad + 1; }

        threw = false;
        try { arr.At(5); } catch (JsonException e) { threw = true; }
        if (!threw) { bad = bad + 1; }

        threw = false;
        try { arr.At(-1); } catch (JsonException e) { threw = true; }
        if (!threw) { bad = bad + 1; }

        threw = false;
        try { num.At(0); } catch (JsonException e) { threw = true; }
        if (!threw) { bad = bad + 1; }

        threw = false;
        try { arr.KeyAt(0); } catch (JsonException e) { threw = true; }
        if (!threw) { bad = bad + 1; }

        threw = false;
        try { obj.KeyAt(3); } catch (JsonException e) { threw = true; }
        if (!threw) { bad = bad + 1; }

        threw = false;
        try { obj.ValAt(-2); } catch (JsonException e) { threw = true; }
        if (!threw) { bad = bad + 1; }

        // 合法路径不受影响。
        if (arr.At(1) == null || arr.At(1).AsString("") != "b") { bad = bad + 1; }
        if (obj.KeyAt(0) != "k") { bad = bad + 1; }
        if (obj.ValAt(0) == null || obj.ValAt(0).AsString("") != "v") { bad = bad + 1; }

        Console.WriteLine("json-at-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
