prom.snap:
# HELP reqcnt Line1 Line2
# TYPE reqcnt counter
reqcnt{m="a"} 5
reqcnt{m="x\"y\\z\n"} 1
# HELP g_val Gauge help
# TYPE g_val gauge
g_val 42.5
# HELP quad_g Four labels
# TYPE quad_g gauge
quad_g{a="1",b="2",c="3",d="4"} 9
# HELP lat_ms Latency
# TYPE lat_ms histogram
lat_ms_bucket{le="10",m="a"} 1
lat_ms_bucket{le="50",m="a"} 1
lat_ms_bucket{le="+Inf",m="a"} 2
lat_ms_sum{m="a"} 70
lat_ms_count{m="a"} 2
# HELP lat_unsorted Unsorted
# TYPE lat_unsorted histogram
lat_unsorted_bucket{le="50"} 1
lat_unsorted_bucket{le="10"} 0
lat_unsorted_bucket{le="+Inf"} 1
lat_unsorted_sum 20
lat_unsorted_count 1
prom.fmt=NaN|+Inf|-Inf
dia.q="a""b"."c"|`a``b`.`c`|[a]]b].[c]|NULL|?|?, ?, ?, ?
qb.sel=SELECT DISTINCT orders.id FROM "orders" LEFT JOIN users ON users.id = orders.uid WHERE "orders"."tenant" = ? AND "orders"."status" IN (?, ?) AND ("t"."a" LIKE ? OR "t"."b" LIKE ?) AND "orders"."deleted_at" IS NULL ORDER BY orders.id DESC LIMIT 10 OFFSET 20|p=5
qb.ins=INSERT INTO "orders" ("a", "b") VALUES (?, ?)
qb.upd=UPDATE [orders] SET [a] = ? WHERE [id] = ?
qb.del=DELETE FROM "orders" WHERE "c" < ?|p=1
