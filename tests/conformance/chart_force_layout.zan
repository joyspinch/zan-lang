using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

// ForceLayout：节点首现序、边去重（自环丢弃、重复对求和）、
// 圆周初始位、固定轮数弹簧模拟、边界钳制、确定性与退化输入。
class Program {
    static void Main() {
        List<ChartLink> links = new List<ChartLink>{
            ChartLink.Of("A", "B", 10),
            ChartLink.Of("B", "C", 20),
            ChartLink.Of("C", "A", 5),
            ChartLink.Of("A", "C", 5),
            ChartLink.Of("D", "D", 7) };   // 自环：节点在、边丢弃
        ForceLayout l = ForceLayout.Of(links, 80, 200, 200, 100, 100);

        Console.WriteLine("nodes:" + Convert.ToString(l.nodes.Count));
        Console.WriteLine("weights:" + Convert.ToString(l.nodes[0].weight) + ":"
            + Convert.ToString(l.nodes[1].weight) + ":"
            + Convert.ToString(l.nodes[2].weight));
        // 边去重：A-B=10, B-C=20, A-C=5+5=10；自环 D 丢弃。
        Console.WriteLine("edges:" + Convert.ToString(l.edges.Count));
        Console.WriteLine("e0:" + Convert.ToString(l.edges[0].a) + ":"
            + Convert.ToString(l.edges[0].b) + ":" + Convert.ToString(l.edges[0].val));
        Console.WriteLine("e1:" + Convert.ToString(l.edges[1].a) + ":"
            + Convert.ToString(l.edges[1].b) + ":" + Convert.ToString(l.edges[1].val));
        Console.WriteLine("e2:" + Convert.ToString(l.edges[2].a) + ":"
            + Convert.ToString(l.edges[2].b) + ":" + Convert.ToString(l.edges[2].val));
        Console.WriteLine("iters:" + Convert.ToString(l.iterations));

        // 边界钳制 + 不共点 + 确定性。
        bool inb = ChartConf.In(l.nodes[0], 0, 200) && ChartConf.In(l.nodes[1], 0, 200)
            && ChartConf.In(l.nodes[2], 0, 200) && ChartConf.In(l.nodes[3], 0, 200);
        bool apart = ChartConf.Distinct(l.nodes[0], l.nodes[1])
            && ChartConf.Distinct(l.nodes[0], l.nodes[2]);
        Console.WriteLine("bounds:" + Convert.ToString(ChartConf.B(inb)));
        Console.WriteLine("apart:" + Convert.ToString(ChartConf.B(apart)));
        ForceLayout l2 = ForceLayout.Of(links, 80, 200, 200, 100, 100);
        Console.WriteLine("det:" + Convert.ToString(ChartConf.B(
            l.nodes[0].x == l2.nodes[0].x && l.nodes[0].y == l2.nodes[0].y
            && l.nodes[1].x == l2.nodes[1].x && l.nodes[2].y == l2.nodes[2].y)));

        // 单节点（仅自环）：位于中心，零迭代。
        List<ChartLink> solo = new List<ChartLink>{ ChartLink.Of("X", "X", 5) };
        ForceLayout s = ForceLayout.Of(solo, 80, 200, 200, 100, 100);
        Console.WriteLine("single:" + Convert.ToString(s.nodes.Count) + ":"
            + Convert.ToString(s.edges.Count) + ":" + Convert.ToString(s.iterations)
            + ":" + Convert.ToString(s.nodes[0].x) + ":" + Convert.ToString(s.nodes[0].y));

        // 空 links。
        List<ChartLink> none = new List<ChartLink>();
        ForceLayout n = ForceLayout.Of(none, 80, 200, 200, 100, 100);
        Console.WriteLine("empty:" + Convert.ToString(n.nodes.Count) + ":"
            + Convert.ToString(n.edges.Count) + ":" + Convert.ToString(n.iterations));

        // scaling / gravity 参数化敏感性（ECharts force.scaling/gravity）：
        // 相对基线 100/100，加倍中心引力或弹簧力都改变收敛位形。
        ForceLayout hiG = ForceLayout.Of(links, 80, 200, 200, 100, 200);
        ForceLayout hiS = ForceLayout.Of(links, 80, 200, 200, 300, 100);
        int dg = 0;
        int ds = 0;
        for (int i = 0; i < l.nodes.Count; i = i + 1) {
            if (hiG.nodes[i].x != l.nodes[i].x || hiG.nodes[i].y != l.nodes[i].y) {
                dg = dg + 1;
            }
            if (hiS.nodes[i].x != l.nodes[i].x || hiS.nodes[i].y != l.nodes[i].y) {
                ds = ds + 1;
            }
        }
        Console.WriteLine("paramSens:" + Convert.ToString(ChartConf.B(dg > 0)) + ":"
            + Convert.ToString(ChartConf.B(ds > 0)));

        // 相对位置（确定性快照）：前两个节点坐标。
        Console.WriteLine("pos:" + Convert.ToString(l.nodes[0].x) + ":"
            + Convert.ToString(l.nodes[0].y) + ":" + Convert.ToString(l.nodes[1].x) + ":"
            + Convert.ToString(l.nodes[1].y));
    }
}

class ChartConf {
    static bool In(ForceNode nd, int lo, int hi) {
        return nd.x >= lo && nd.x <= hi && nd.y >= lo && nd.y <= hi;
    }
    static bool Distinct(ForceNode a, ForceNode b) {
        return a.x != b.x || a.y != b.y;
    }
    static string B(bool v) {
        if (v) { return "1"; }
        return "0";
    }
}
