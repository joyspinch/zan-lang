// Conformance: postfix `!` (null-forgiving, C# parity). It suppresses the
// nullable-call-result diagnostic on the member access it wraps, chains
// (`c!.Name`), feeds `var` inference with the operand's type, and is
// transparent to ARC ownership (an owned call behind `!` stays owned).
using System;

class Cfg {
    public string Name;
}

class Store {
    public Cfg Find(string k) {
        if (k == "hit") { Cfg c = new Cfg(); c.Name = "n1"; return c; }
        return null;
    }
}

class Program {
    static int Len(Store s) {
        return s.Find("hit")!.Name.Length;
    }

    static void Main() {
        Store s = new Store();
        Cfg c = s.Find("hit");
        Console.WriteLine(c!.Name);
        Console.WriteLine(s.Find("hit")!.Name);
        var d = s.Find("hit")!;
        Console.WriteLine(d.Name);
        Console.WriteLine(Convert.ToString(Len(s)));
        Console.WriteLine("BANG-OK");
    }
}
