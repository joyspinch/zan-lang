// RAW printing protocol conformance. The fake backend never contacts winspool.
using System;
using System.Drawing.Printing;

namespace Conf;

class FakeRawPrinterBackend : IRawPrinterBackend {
    string failAt;
    string calls;
    int writeCount;

    FakeRawPrinterBackend(string failAt, int writeCount) {
        this.failAt = failAt;
        this.calls = "";
        this.writeCount = writeCount;
    }

    void Record(string call) {
        if (this.calls.Length != 0) { this.calls = this.calls + ","; }
        this.calls = this.calls + call;
    }

    string Calls() { return this.calls; }

    bool Open(string printerName) {
        this.Record("Open");
        return this.failAt != "Open";
    }

    bool StartDoc(string documentName) {
        this.Record("StartDoc");
        return this.failAt != "StartDoc";
    }

    bool StartPage() {
        this.Record("StartPage");
        return this.failAt != "StartPage";
    }

    int Write(byte[] data) {
        this.Record("Write");
        if (this.failAt == "Write") { return -1; }
        return this.writeCount;
    }

    bool EndPage() {
        this.Record("EndPage");
        return this.failAt != "EndPage";
    }

    bool EndDoc() {
        this.Record("EndDoc");
        return this.failAt != "EndDoc";
    }

    void Abort() { this.Record("Abort"); }

    bool Close() {
        this.Record("Close");
        return this.failAt != "Close";
    }
}

class Prog {
    static int bad = 0;

    static void Check(bool cond, string what) {
        if (!cond) {
            Prog.bad = Prog.bad + 1;
            Console.WriteLine("FAIL " + what);
        }
    }

    static void Case(string name, string failAt, int writeCount,
                     bool wantResult, string wantCalls) {
        byte[] data = new byte[] { 1, 2, 3 };
        FakeRawPrinterBackend backend = new FakeRawPrinterBackend(failAt, writeCount);
        bool got = RawPrinter.SendWithBackend("fake", "document", data, backend);
        Prog.Check(got == wantResult, name + " result");
        Prog.Check(backend.Calls() == wantCalls,
            name + " calls: " + backend.Calls());
    }

    static void Main() {
        Prog.Case("success", "", 3, true,
            "Open,StartDoc,StartPage,Write,EndPage,EndDoc,Close");
        Prog.Case("short write", "", 2, false,
            "Open,StartDoc,StartPage,Write,Abort,Close");
        Prog.Case("open failure", "Open", 3, false, "Open");
        Prog.Case("start doc failure", "StartDoc", 3, false,
            "Open,StartDoc,Close");
        Prog.Case("start page failure", "StartPage", 3, false,
            "Open,StartDoc,StartPage,Abort,Close");
        Prog.Case("write failure", "Write", 3, false,
            "Open,StartDoc,StartPage,Write,Abort,Close");
        Prog.Case("end page failure", "EndPage", 3, false,
            "Open,StartDoc,StartPage,Write,EndPage,Abort,Close");
        Prog.Case("end doc failure", "EndDoc", 3, false,
            "Open,StartDoc,StartPage,Write,EndPage,EndDoc,Close");
        Prog.Case("close failure", "Close", 3, false,
            "Open,StartDoc,StartPage,Write,EndPage,EndDoc,Close");

        Console.WriteLine("win-printing-raw-backend-ok: "
            + Convert.ToString(Prog.bad == 0 ? 1 : 0));
    }
}
