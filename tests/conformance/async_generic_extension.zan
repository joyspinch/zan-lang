using System;
using System.Threading;

interface IExecutor {
    int Mark();
    int ReadAsync(string text);
    async int ReadSync(string text);
}
class Executor : IExecutor {
    public int Mark() { return 37; }
    public int ReadAsync(string text) { return -7; }
    public async int ReadSync(string text) { return -7; }
}
class Entity {}
class Extensions {
    // The wrong generic arity is deliberately first, with the opposite async flag.
    public static int ReadAsync<T, U>(this IExecutor executor) { return -1; }
    public static async int ReadAsync<T>(this IExecutor executor) {
        await Task.Delay(10);
        return executor.Mark() + 5;
    }
    public static async int ReadSync<T, U>(this IExecutor executor) {
        await Task.Delay(10);
        return -1;
    }
    public static int ReadSync<T>(this IExecutor executor) { return executor.Mark() + 5; }
}
class Program {
    static async int Nested(IExecutor executor) {
        return await executor.ReadAsync<Entity>();
    }
    static void Main() {
        IExecutor executor = new Executor();
        Console.WriteLine(await executor.ReadAsync<Entity>());
        Console.WriteLine(await Program.Nested(executor));
        Console.WriteLine(await executor.ReadSync<Entity>());
    }
}
