using System;

// B-ID64：终结自动析构——fire-and-forget（Task.Spawn）带结果协程的结果
// 载荷无人读取时，帧终结（co.orphan 分支）按返回类型释放 RVAL 载荷。
// 修复前：exit 时 "memory leak detected: 3 object(s)"（--check-leaks 档）。

struct Pair {
    long x;
    string tag;
}

class Program {
    static async string MakeString(int i) {
        await Task.Delay(1);
        return "s" + Convert.ToString(i);
    }

    static async Task<Pair> MakePair(int i) {
        await Task.Delay(1);
        Pair p;
        p.x = i;
        p.tag = "p" + Convert.ToString(i);
        return p;
    }

    static async void Main() {
        // 结果句柄从未读：字符串与含引用字段的结构体载荷（孤儿释放路径）
        Task.Spawn(Program.MakeString(1));
        Task.Spawn(Program.MakeString(2));
        Task.Spawn(Program.MakePair(3));
        // 有读结果的对照（awaiter 路径不受孤儿释放影响）
        string read = await Program.MakeString(9);
        Console.WriteLine("read=" + read);
        await Task.Delay(50);
        Console.WriteLine("done");
    }
}
