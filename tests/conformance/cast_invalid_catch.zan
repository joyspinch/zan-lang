// B-ID163③：`(T)x` 引用下转/拆箱失败一律抛 InvalidCastException（C# 同
// 语义）。try 内可 catch；try 外未捕获由运行时终止进程（锁在
// runtime_cast_invalid_downcast）。旧实现 try 外软失败——stderr 一次后
// 拿 null 继续跑（TASKS B-ID163③ 静默失效实录），此用例锁新契约。
using System;

class Animal {
    public string Name;
}
class Dog : Animal {
    public int Bark;
}
struct Point {
    public int x;
    public int y;
}

class Program {
    static int Main() {
        Animal a = new Animal();
        a.Name = "generic";
        int r = 0;
        try {
            Dog d = (Dog)a;
            Console.WriteLine("no-throw:" + d.Bark);
        } catch (InvalidCastException ice) {
            Console.WriteLine("caught-ice");
            r = r + 1;
        }
        // 合法下转照常
        Dog rex = new Dog();
        rex.Bark = 3;
        Animal avatar = rex;
        Dog back = (Dog)avatar;
        Console.WriteLine("valid-downcast:" + back.Bark);
        r = r + 1;
        // 装箱结构体合法拆箱
        object boxed = new Point();
        Point p = (Point)boxed;
        Console.WriteLine("unbox-ok:" + p.x);
        r = r + 1;
        // 拆箱类型不符：同口径抛
        object notPoint = "hello";
        try {
            Point bad = (Point)notPoint;
            Console.WriteLine("no-throw-unbox");
        } catch (InvalidCastException ice) {
            Console.WriteLine("unbox-caught-ice");
            r = r + 1;
        }
        return r == 4 ? 0 : 1;
    }
}
