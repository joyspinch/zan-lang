using System;

// A static property is a static getter method (`Cls.get_Prop()`); the
// self-hosted backend has to lower `Cls.Prop` the same way the C host does.
class Config {
    public static int Version { get { return 3; } }
    public static string Name { get { return "zan"; } }
    public static int Counter = 0;
}

class Program {
    static void Main() {
        Console.WriteLine("v=" + Convert.ToString(Config.Version));
        Console.WriteLine("n=" + Config.Name);
        Console.WriteLine("c=" + Convert.ToString(Config.Counter));
    }
}
