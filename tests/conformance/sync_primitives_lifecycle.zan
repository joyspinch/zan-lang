using System;
using System.Threading;

class Program {
    static void Main() {
        // 1. Thread APIs
        long tid = Thread.CurrentId();
        Console.WriteLine("thread_id_ok=" + (tid != 0));

        // 2. Mutex OOP lifecycle & IDisposable
        Mutex m = new Mutex();
        m.WaitOne();
        m.ReleaseMutex();
        m.Dispose();
        Console.WriteLine("mutex_lifecycle_ok=1");

        // 3. Mutex static low-level APIs
        nint rawMtx = Mutex.Create();
        Mutex.Lock(rawMtx);
        Mutex.Unlock(rawMtx);
        Mutex.Destroy(rawMtx);
        Console.WriteLine("mutex_static_ok=1");

        // 4. Semaphore static APIs
        nint rawSem = Semaphore.Create(1, 2);
        Semaphore.Wait(rawSem);
        Semaphore.Release(rawSem);
        bool waitOk = Semaphore.WaitFor(rawSem, 50);
        Console.WriteLine("sem_waitfor_ok=" + (waitOk ? 1 : 0));
        Semaphore.Release(rawSem);
        Semaphore.Destroy(rawSem);
        Console.WriteLine("semaphore_static_ok=1");

        // 5. SemaphoreSlim OOP lifecycle & IDisposable
        SemaphoreSlim slim = new SemaphoreSlim(2);
        slim.Wait();
        bool gotTry = slim.TryWait();
        Console.WriteLine("slim_try_ok=" + (gotTry ? 1 : 0));
        Console.WriteLine("slim_active=" + slim.Active());
        slim.Release();
        slim.Release();
        Console.WriteLine("slim_after_release_active=" + slim.Active());
        slim.Dispose();
        Console.WriteLine("slim_lifecycle_ok=1");

        // 6. Timer lifecycle & IDisposable
        int ticks = 0;
        Timer t = new Timer(100, delegate () {
            ticks = ticks + 1;
        });
        Console.WriteLine("timer_created_ok=1");
        Console.WriteLine("timer_init_running=" + (t.IsRunning() ? 1 : 0));
        t.Dispose();
        Console.WriteLine("timer_lifecycle_ok=1");

        Console.WriteLine("sync-primitives-ok: 1");
    }
}
