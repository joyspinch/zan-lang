using System;

class PublishReflectFieldHookBase {
    public int Value;
    public void OnCustomEvent() { Value = Value + 17; }
}

// Only field TypeInfo creates the derived instance and inherited hook receiver.
class PublishReflectFieldHookDerived : PublishReflectFieldHookBase {
    public PublishReflectFieldHookDerived() { Value = 7; }
}

class PublishReflectFieldHookHolder {
    public PublishReflectFieldHookDerived Owner;
}

class Program {
    static void Require(bool value, string message) {
        if (!value) throw new Exception(message);
    }

    static object Make(TypeInfo type) { return type.CreateInstance(); }

    static int Main() {
        TypeInfo owner = typeof(PublishReflectFieldHookHolder).GetFieldTypeInfo(0);
        Require(owner.HasMethod("OnCustomEvent"), "inherited hook metadata retained");
        object value = Make(owner);
        Require(value is PublishReflectFieldHookDerived, "field TypeInfo creates derived owner");
        Require(value.GetFieldInt("Value") == 7, "derived constructor body retained");
        Require(value.Invoke("OnCustomEvent"), "inherited hook invocation succeeds");
        Require(value.GetFieldInt("Value") == 24, "inherited hook body updates derived instance");
        Console.WriteLine("publish reflect field hook PASS");
        return 0;
    }
}
