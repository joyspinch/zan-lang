using System;
using System.Windows;

namespace Conf;

class DesktopCompanionWeatherMilestoneSnapTest {
    static void Main() {
        // 1. 天气感知伴侣穿搭与情绪适配器：雨天打伞、低温围巾、高温短袖
        CompanionWeatherMoodAdapter adapter = new CompanionWeatherMoodAdapter();
        WeatherOutfitAdvice rain = adapter.Advise(DesktopWeatherKind.Rainy, 12);
        WeatherOutfitAdvice snow = adapter.Advise(DesktopWeatherKind.Snowy, 0);
        WeatherOutfitAdvice hot = adapter.Advise(DesktopWeatherKind.Sunny, 32);

        bool weatherOk = rain.CarryUmbrella && rain.OutfitTag == "raincoat_warm" && rain.MoodTag == "cozy"
            && !snow.CarryUmbrella && snow.OutfitTag == "winter_scarf"
            && hot.OutfitTag == "summer_tee" && hot.MoodTag == "breezy";
        Console.WriteLine("companion-weather-mood-adapter: " + Convert.ToString(weatherOk ? 1 : 0));

        // 2. 累计专注里程碑账本：阶梯解锁防重并正确汇总积分
        CompanionDailyMilestoneLedger ledger = new CompanionDailyMilestoneLedger();
        ledger.AddMilestone("focus_30", 30, 50);
        ledger.AddMilestone("focus_90", 90, 150);

        int u1 = ledger.RecordFocusMinutes(20); // 20 < 30 -> 0
        int u2 = ledger.RecordFocusMinutes(25); // 45 >= 30 -> +1 (50 pts)
        int u3 = ledger.RecordFocusMinutes(60); // 105 >= 90 -> +1 (200 pts)
        int u4 = ledger.RecordFocusMinutes(30); // 已全部解锁 -> 0

        bool milestoneOk = u1 == 0 && u2 == 1 && u3 == 1 && u4 == 0
            && ledger.UnlockedCount() == 2 && ledger.TotalRewardPoints == 200;
        Console.WriteLine("companion-daily-milestone-ledger: " + Convert.ToString(milestoneOk ? 1 : 0));

        // 3. 窗口磁吸对齐器：贴近屏幕边缘自动吸附、贴近宿主应用标题栏上沿自动坐上去且不越界
        CompanionWindowSnapMagnet magnet = new CompanionWindowSnapMagnet(1920, 1080, 20);
        int sx;
        int sy;
        magnet.SnapToScreenEdges(12, 100, 160, 160, out sx, out sy); // x=12 <= 20 -> 吸附到 0
        bool edgeSnapped = sx == 0 && sy == 100;

        int tx;
        int ty;
        bool perched = magnet.TrySnapToWindowTop(400, 148, 160, 160, 300, 900, 300, out tx, out ty);
        // footY = 148+160 = 308，距 hostTopY=300 仅 8px <= 20 -> 贴坐到 ty = 300-160 = 140
        bool titleSnapped = perched && tx == 400 && ty == 140;

        Console.WriteLine("companion-window-snap-magnet: " + Convert.ToString((edgeSnapped && titleSnapped) ? 1 : 0));
    }
}
