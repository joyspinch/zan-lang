// A namespace-qualified static receiver binds by its last segment when the
// written prefix and the type's namespace are related (the C host's
// qpath_ns_ok): equal, an ancestor either way, or the namespace's tail.
// Declaration-less builtins (Math, Console) take any prefix.
using System;
namespace QualTail.App;

public class Program {
    public static void Main() {
        Console.WriteLine(QualTail.Lib.Deep.Tool.Name());      // ns is the prefix's ancestor
        Console.WriteLine(QualTail.Tool.Name());               // prefix is the ns's ancestor
        Console.WriteLine(Lib.Tool.Name());                    // relative to the outer namespace
        Console.WriteLine(System.Math.Max(3, 4));              // builtin, no declaration
        System.Console.WriteLine("console");
        Console.WriteLine(System.Security.Cryptography.RandomNumberGenerator.GetBytes(4) != null);
    }
}
