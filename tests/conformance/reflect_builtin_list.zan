using System;
using System.Collections.Generic;

class RowItem {
    public string Name;
    public RowItem(string n) { Name = n; }
}

class Program {
    static void Main() {
        TypeInfo ti = typeof(List<string>);
        Console.WriteLine(ti.Name);
        Console.WriteLine(ti.FieldCount);
        Console.WriteLine(ti.GetFieldName(0) + " " + ti.GetFieldType(0));
        Console.WriteLine(ti.GetFieldName(1) + " " + ti.GetFieldType(1));
        Console.WriteLine(ti.MethodCount);
        Console.WriteLine(ti.GetMethodName(0) + " " + ti.GetMethodReturnType(0) + " " + ti.GetMethodParamCount(0));
        Console.WriteLine(ti.GetMethodName(1) + " " + ti.GetMethodReturnType(1) + " " + ti.GetMethodParamCount(1));
        Console.WriteLine(ti.GetMethodName(2) + " " + ti.GetMethodReturnType(2) + " " + ti.GetMethodParamCount(2));

        Console.WriteLine(ti.ElementType.Name);

        List<string> strList = new List<string>();
        strList.Add("alpha");
        strList.Add("beta");
        object fo_str = strList;

        Console.WriteLine(fo_str.HasField("Count"));
        Console.WriteLine(fo_str.HasField("count"));
        Console.WriteLine(fo_str.GetFieldInt("Count"));
        Console.WriteLine(fo_str.GetFieldInt("count"));
        Console.WriteLine(fo_str.HasMethod("Count"));
        Console.WriteLine(fo_str.HasMethod("Get"));
        Console.WriteLine(fo_str.HasMethod("At"));
        Console.WriteLine(fo_str.InvokeInt("Count"));
        Console.WriteLine(fo_str.InvokeString("Get", 0));
        Console.WriteLine(fo_str.InvokeString("At", 1));

        List<int> intList = new List<int>();
        intList.Add(100);
        intList.Add(200);
        object fo_int = intList;
        Console.WriteLine(fo_int.InvokeInt("Get", 0));
        Console.WriteLine(fo_int.InvokeInt("At", 1));

        List<RowItem> rowList = new List<RowItem>();
        rowList.Add(new RowItem("row0"));
        rowList.Add(new RowItem("row1"));
        object fo_row = rowList;
        object r0 = fo_row.InvokeObject("Get", 0);
        object r1 = fo_row.InvokeObject("At", 1);
        object r5 = fo_row.InvokeObject("Get", 5);
        Console.WriteLine(r0 != null ? "row0_ok" : "row0_null");
        Console.WriteLine(r1 != null ? "row1_ok" : "row1_null");
        Console.WriteLine(r5 != null ? "r5_ok" : "r5_null");
        if (r0 != null) {
            Console.WriteLine(r0.GetFieldString("Name"));
        }
    }
}
