// Equal-sized bodies share a shard; the smaller Pad forces a second one.
class ShardGc {
    public static int LiveOffset;
    public static int UnusedOffset;

    public static int Live(int value) {
        return value + 21 + ShardGc.LiveOffset;
    }

    public static int Unused(int value) {
        return value + 5 + ShardGc.UnusedOffset;
    }

    public static int Pad(int value) {
        return value;
    }
}

class Program {
    static int Main() {
        return ShardGc.Live(21) + ShardGc.Unused(2) + ShardGc.Pad(0) - 49;
    }
}
