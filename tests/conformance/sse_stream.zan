using System;
using System.Net;
using System.Net.Sse;
using System.Threading;

// SSE 端到端回归（loopback）：Worker("sse") + SseClient。
// SseServer 类已退役——订阅者握手与分发的唯一实现是 Worker.HandleSse
// （走 onSseSubscriber 回调）。本回归钉住的行为不变：
// 1. event-stream 握手头正确、SseClient 能解析事件流；
// 2. 具名事件 / 多行 data（\n 拆成多个 data: 行）/ 匿名事件 / Ping 注释行；
// 3. 流关闭后 NextAsync 返回 null。
class Program {
    static Worker srv;
    static List<SseConnection> subs;

    static async void OnSubscriber(SseConnection c) {
        Console.WriteLine("subscriber on " + c.Path());
        subs.Add(c);
        await c.SendAsync("tick", "hello");
        await c.PingAsync();
        await c.SendAsync("multi", "line1\nline2");
        await c.SendDataAsync("plain payload");
        c.Close();
    }

    static async int Run() {
        Socket.Initialize();
        subs = new List<SseConnection>();
        srv = new Worker("sse", "127.0.0.1", 9510);
        // sse 编解码自 A332 肥边③起按需编译，且回调移到分片静态字段
        // （Worker.zan 的回调表注明 shard static）——装分片、挂静态。
        WorkerSse.Install();
        WorkerSse.onSseSubscriber = Program.OnSubscriber;
        nint listenSock = srv.BindSocket(false);
        if (listenSock < 0) { Console.WriteLine("accept failed"); return 0; }
        List<nint> socks = new List<nint>();
        socks.Add(listenSock);
        Task.Spawn(Worker.RunAllLoopsOnSockets(socks));

        SseClient c = await SseClient.ConnectAsync("127.0.0.1", 9510, "/events");
        Console.WriteLine("client connected: " + Convert.ToString(c.IsConnected()));
        int n = 0;
        while (true) {
            SseEvent e = await c.NextAsync();
            if (e == null) { break; }
            Console.WriteLine("event " + e.Name() + ": " + e.Data());
            n = n + 1;
        }
        Console.WriteLine("total " + Convert.ToString(n));
        c.Close();
        srv.Stop();
        // 关监听 fd 让停摆的 accept 以 -1 复位（Worker.Stop 只翻标志），
        // RunAllLoopsOnSockets 帧完成释放 socks/Worker 对象链，退出时的
        // 泄漏探测才不会把它们记为仍可达。
        Socket.Close(listenSock);
        // 拆静态分片与总线（A352）：sseEntry/onSseSubscriber/sharedBus/
        // busConsumer 是泄漏探测里的保持根。
        WorkerSse.Uninstall();
        for (int i = 0; i < 20; i = i + 1) { await Task.Delay(10); }
        return 0;
    }

    static void Main() {
        int r = await Run();
    }
}
