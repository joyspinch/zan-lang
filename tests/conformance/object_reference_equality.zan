using System;

class Program {
    static void Main() {
        string s1 = "ab";
        string head = "a";
        string s2 = head + "b";
        Console.WriteLine(s1 == s2);
        object o1 = s1;
        object o2 = s2;
        object o3 = s1;
        object on = null;
        Console.WriteLine(o1 == o2);
        Console.WriteLine(o1 == o3);
        Console.WriteLine(o1 == on);
        Console.WriteLine(on == null);
    }
}
