using System;
using System.IO;
using System.Platform;
using System.Net.Sockets;
using System.Net.Tls;
using System.Net.WebSocket;
using System.Threading;

namespace System.Net.WebSocket;

class ReaderClosePair {
    public TcpClient conn;
    public TcpClient peer;
    public int result;
    public string text;
    public bool sent;
    public TlsStream peerStream;
}

