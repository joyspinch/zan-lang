// 核心契约与语义定义。
using System;
using System.Text;

namespace Conf;

class Resp {
    public List<string> headers;
    public string body;

    static Resp Ok(string b) {
        Resp r = new Resp();
        r.headers = new List<string>();
        r.headers.Add("Content-Type: text/plain");
        r.headers.Add("Connection: keep-alive");
        r.body = b;
        return r;
    }

    string Build() {
        StringBuilder sb = new StringBuilder();
        sb.Append("HTTP/1.1 200 OK\r\n");
        for (int i = 0; i < headers.Count; i = i + 1) { sb.Append(headers[i]); sb.Append("\r\n"); }
        sb.Append("\r\n");
        sb.Append(body);
        return sb.ToString();
    }
}

class Program {
    static void Main() {
        int total = 0;
        for (int r = 0; r < 300; r = r + 1) {
            // 核心契约与语义定义。
            var xs = new List<int>();
            for (int i = 0; i < 8; i = i + 1) { xs.Add(i); }
            total = total + xs.Count;

            // 核心契约与语义定义。
            StringBuilder sb = new StringBuilder();
            for (int j = 0; j < 16; j = j + 1) { sb.Append("abc"); }

            // 核心契约与语义定义。
            Resp resp = Resp.Ok("hello-" + r.ToString());
            string wire = resp.Build();
            total = total + wire.Length;

        }
        Console.WriteLine(total);
    }
}
