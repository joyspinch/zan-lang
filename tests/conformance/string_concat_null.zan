using System;

class Program {
    public static void Main() {
        string s1 = "a" + null;
        string s2 = null + "b";
        string s3 = "a" + null + "c";
        string s4 = $"x{null}y";
        string s5 = "start_" + (null) + "_end";

        Console.WriteLine(s1);
        Console.WriteLine(s1.Length.ToString());
        Console.WriteLine(s2);
        Console.WriteLine(s2.Length.ToString());
        Console.WriteLine(s3);
        Console.WriteLine(s3.Length.ToString());
        Console.WriteLine(s4);
        Console.WriteLine(s4.Length.ToString());
        Console.WriteLine(s5);
        Console.WriteLine(s5.Length.ToString());

        string r1 = "num:" + 42;
        string r2 = "bool:" + true;
        string r3 = "char:" + 'Z';
        Console.WriteLine(r1);
        Console.WriteLine(r2);
        Console.WriteLine(r3);
    }
}
