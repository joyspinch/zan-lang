using System;
using System.Text;

class Program {
    static int bad;

    static void Check(bool ok, string label) {
        if (!ok) {
            Console.WriteLine("FAIL: " + label);
            bad = bad + 1;
        }
    }

    static void Main() {
        bad = 0;

        // 1. Convert Hex Roundtrip
        byte[] raw = new byte[] { 0, 1, 15, 16, 255, 170, 85 };
        string hex = Convert.ToHexString(raw);
        Check(hex == "00010f10ffaa55", "convert to hex");
        byte[] fromHex = Convert.FromHexString(hex);
        Check(fromHex.Length == raw.Length, "from hex length");
        bool hexOk = true;
        for (int i = 0; i < raw.Length; i = i + 1) {
            if (fromHex[i] != raw[i]) { hexOk = false; break; }
        }
        Check(hexOk, "from hex bytes match");

        // 2. Convert Base64 Roundtrip
        string hello = "Hello Enterprise Zan Language! 2026";
        byte[] helloBytes = hello.ToBytes();
        string b64 = Convert.ToBase64String(helloBytes);
        Check(b64.Length > 0, "base64 encode not empty");
        byte[] decB64 = Convert.FromBase64String(b64);
        Check(decB64 != null && decB64.Length == helloBytes.Length, "base64 decode length");
        string decHello = decB64 != null ? Encoding.UTF8.GetString(decB64) : "";
        Check(decHello == hello, "base64 roundtrip string match");

        // 3. Encoding UTF8 & ASCII aliases
        byte[] ubytes = Encoding.UTF8.GetBytes("Zan 语言");
        Check(ubytes.Length > 0, "utf8 get bytes");
        string ustr = Encoding.UTF8.GetString(ubytes);
        Check(ustr == "Zan 语言", "utf8 get string");

        byte[] abytes = Encoding.ASCII.GetBytes("Zan ASCII");
        string astr = Encoding.ASCII.GetString(abytes);
        Check(astr == "Zan ASCII", "ascii alias match");

        // 4. URL & HTML & JSON Encoding
        string urlRaw = "name=张三&age=25&quote=\"hello\"";
        string urlEnc = Encoding.UrlEncode(urlRaw);
        Check(urlEnc.IndexOf("%") >= 0, "url encode escaped");
        string urlDec = Encoding.UrlDecode(urlEnc);
        Check(urlDec == urlRaw, "url decode roundtrip");

        string htmlRaw = "<script>alert('XSS' & \"danger\")</script>";
        string htmlEnc = Encoding.HtmlEncode(htmlRaw);
        Check(htmlEnc.IndexOf("&lt;") >= 0 && htmlEnc.IndexOf("&gt;") >= 0, "html encode tags");

        string jsonRaw = "line1\nline2\t\"quoted\"\\backslash\0";
        string jsonEnc = Encoding.JsonEscape(jsonRaw);
        Check(jsonEnc.IndexOf("\\n") >= 0 && jsonEnc.IndexOf("\\\"") >= 0, "json escape");

        // 5. Rune & CodePoint
        string s = "A中B文C";
        int cpCount = Encoding.CodePointCount(s);
        Check(cpCount == 5, "codepoint count");
        string rune1 = Encoding.RuneFromIndex(s, 1);
        Check(rune1 == "中", "rune from index");
        string rune3 = Encoding.RuneFromIndex(s, 3);
        Check(rune3 == "文", "rune from index 3");

        // 6. Number parsing
        int parsedInt = Encoding.ParseInt("  -12345abc");
        Check(parsedInt == 0 - 12345, "parse int with sign and suffix");
        double parsedDbl = Encoding.ParseDouble("  +3.1415926e2");
        Check(parsedDbl > 314.15 && parsedDbl < 314.16, "parse double with scientific notation");

        // 7. WebSocket Accept & SHA-1
        string wsAccept = Encoding.WebSocketAccept("dGhlIHNhbXBsZSBub25jZQ==");
        Check(wsAccept == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=", "websocket handshake accept key");

        if (bad == 0) {
            Console.WriteLine("PASS: convert encoding roundtrip ok");
        } else {
            Console.WriteLine("FAIL: " + bad + " tests failed");
        }
    }
}
