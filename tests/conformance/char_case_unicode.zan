// Unicode 简单大小写映射 conformance（审计 P1-12 / A525 后续）。
// C# 语义：Char.ToUpper/ToLower = 不变文化 Unicode 简单映射；无映射或
// 扩张型（ß→SS）原样返回。谓词（IsDigit 等）仍为 ASCII 口径（A525 已声明）。
using System;

public class CharCaseUnicode {
    static void Main() {
        int bad = 0;

        // ASCII 回归（libc 路径既有行为不变）
        if (Char.ToUpper('a') != 'A') { bad = bad + 1; }
        if (Char.ToLower('A') != 'a') { bad = bad + 1; }
        if (Char.ToUpper('Z') != 'Z') { bad = bad + 1; }

        // 拉丁-1 补充区：ä↔Ä、é↔É、ß 原样（扩张型）
        if (Char.ToUpper((char)0xE4) != (char)0xC4) { bad = bad + 1; Console.WriteLine("  au: auml"); }
        if (Char.ToLower((char)0xC4) != (char)0xE4) { bad = bad + 1; Console.WriteLine("  al: auml"); }
        if (Char.ToUpper((char)0xE9) != (char)0xC9) { bad = bad + 1; Console.WriteLine("  eu: eacute"); }
        if (Char.ToUpper((char)0xDF) != (char)0xDF) { bad = bad + 1; Console.WriteLine("  eszett"); }

        // 希腊：ω→Ω、Σ→σ
        if (Char.ToUpper((char)0x3C9) != (char)0x3A9) { bad = bad + 1; Console.WriteLine("  gr: omega"); }
        if (Char.ToLower((char)0x3A3) != (char)0x3C3) { bad = bad + 1; Console.WriteLine("  gr: sigma"); }

        // 西里尔：б→Б、Ж→ж
        if (Char.ToUpper((char)0x431) != (char)0x411) { bad = bad + 1; Console.WriteLine("  cy: be"); }
        if (Char.ToLower((char)0x416) != (char)0x436) { bad = bad + 1; Console.WriteLine("  cy: zhe"); }

        // 全角拉丁：ａ→Ａ（FF41→FF21）、Ｊ→ｊ
        if (Char.ToUpper((char)0xFF41) != (char)0xFF21) { bad = bad + 1; Console.WriteLine("  fw: a"); }
        if (Char.ToLower((char)0xFF2A) != (char)0xFF4A) { bad = bad + 1; Console.WriteLine("  fw: J"); }

        // 无大小写映射：汉字、数字、符号原样
        if (Char.ToUpper((char)0x4E2D) != (char)0x4E2D) { bad = bad + 1; Console.WriteLine("  zh: CJK"); }
        if (Char.ToLower('1') != '1') { bad = bad + 1; Console.WriteLine("  digit"); }
        if (Char.ToUpper((char)0x2764) != (char)0x2764) { bad = bad + 1; Console.WriteLine("  sym: heart"); }

        // 上下界：surrogate 区原样、astral 区双向映射（Deseret: 𐐨↔𐐀）、无映射 astral 符号原样
        if (Char.ToUpper((char)0xD800) != (char)0xD800) { bad = bad + 1; Console.WriteLine("  surrogate"); }
        if (Char.ToUpper((char)0x10428) != (char)0x10400) { bad = bad + 1; Console.WriteLine("  astral: deseret up"); }
        if (Char.ToLower((char)0x10400) != (char)0x10428) { bad = bad + 1; Console.WriteLine("  astral: deseret down"); }
        if (Char.ToUpper(0x1D41A) != 0x1D41A) { bad = bad + 1; Console.WriteLine("  astral: math symbol unchanged"); }

        Console.WriteLine("bad=" + Convert.ToString(bad));
        Console.WriteLine(bad == 0 ? "char-case-unicode-ok: 1" : "char-case-unicode-ok: 0");
    }
}
