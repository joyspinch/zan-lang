using System;
using System.Hardware;
using System.Numerics;

public class MockHardwareHost : IHardwareHost {
    bool keepAwake;
    float brightness = 0.5f;
    bool barVisible = true;
    int barStyle = 2;
    int barColor = 123456;
    bool navVisible = true;
    string openUrl = "";

    public int SensorGet(int sensorType, float[] outVec) {
        if (sensorType == 1 && outVec.Length >= 3) {
            outVec[0] = 1.5f;
            outVec[1] = 2.5f;
            outVec[2] = 9.8f;
            return 0;
        }
        return -1;
    }

    public int SensorSet(int sensorType, float x, float y, float z) {
        return 0;
    }

    public int NotificationSend(string title, string body, string action, int badge, string sound) {
        if (title == "ok" && badge == 5) { return 42; }
        return -1;
    }

    public int NetworkType() {
        return 1;
    }

    public bool IsDarkMode() {
        return true;
    }

    public int ShareText(string text, string title) {
        return text == "share-me" ? 0 : -1;
    }

    public string PickFile(string filter) {
        return filter == "image/*" ? "/tmp/photo.png" : "";
    }

    public int PermissionCheck(int permType) {
        return permType == 0 ? 0 : 1;
    }

    public int PermissionRequest(int permType) {
        return 0;
    }

    public void ScreenKeepAwake(bool enable) {
        this.keepAwake = enable;
    }

    public bool ScreenIsKeepAwake() {
        return this.keepAwake;
    }

    public void ScreenSetBrightness(float b) {
        this.brightness = b;
    }

    public float ScreenGetBrightness() {
        return this.brightness;
    }

    public int LocationGet(double[] outCoords, float[] outMetrics) {
        if (outCoords.Length >= 3 && outMetrics.Length >= 2) {
            outCoords[0] = 31.23;
            outCoords[1] = 121.47;
            outCoords[2] = 12.0;
            outMetrics[0] = 5.0f;
            outMetrics[1] = 0.0f;
            return 0;
        }
        return -1;
    }

    public string DeviceInfoGet(int infoKey) {
        if (infoKey == 1) { return "HostDevice"; }
        if (infoKey == 2) { return "HostMaker"; }
        if (infoKey == 3) { return "HostOS"; }
        return "1.0";
    }

    public bool DeviceIsFoldable() {
        return true;
    }

    public bool BiometricsCanAuthenticate() {
        return true;
    }

    public int BiometricsType() {
        return 2;
    }

    public bool BiometricsAuthenticate(string title, string subtitle) {
        return title == "verify";
    }

    public void SystemBarSetStatus(bool visible, int style, int color) {
        this.barVisible = visible;
        this.barStyle = style;
        this.barColor = color;
    }

    public bool SystemBarIsStatusVisible() {
        return this.barVisible;
    }

    public int SystemBarStyle() {
        return this.barStyle;
    }

    public int SystemBarColor() {
        return this.barColor;
    }

    public void SystemBarSetNavVisible(bool visible) {
        this.navVisible = visible;
    }

    public bool SystemBarIsNavVisible() {
        return this.navVisible;
    }

    public string TakeOpenUrl() {
        string u = this.openUrl;
        this.openUrl = "";
        return u;
    }

    public void InjectOpenUrl(string url) {
        this.openUrl = url != null ? url : "";
    }
}

public class Program {
    public static int Main() {
        // 1. Headless native DeviceInfo & Network
        string plat = DeviceInfo.PlatformName();
        string osver = DeviceInfo.OSVersion();
        string model = DeviceInfo.Model();
        Console.WriteLine("plat_ok=" + ((plat.Length > 0 && osver.Length > 0 && model.Length > 0) ? "1" : "0"));
        Console.WriteLine("foldable=" + (DeviceInfo.IsFoldable() ? "1" : "0"));

        DeviceInfo.Inject("TestModel", "TestMaker", "TestOS", "9.9", true);
        Console.WriteLine("dev_inj=" + DeviceInfo.Model() + "|" + DeviceInfo.PlatformName() + "|" + (DeviceInfo.IsFoldable() ? "1" : "0"));
        DeviceInfo.Reset();
        Console.WriteLine("dev_rst=" + (DeviceInfo.PlatformName() == plat ? "1" : "0"));

        int netRaw = (int)Network.Type();
        Console.WriteLine("net_valid=" + ((netRaw >= -1 && netRaw <= 3) ? "1" : "0"));
        Network.Inject(NetworkType.Ethernet);
        Console.WriteLine("net_eth=" + (Network.IsConnected() ? "1" : "0"));
        Network.Inject(NetworkType.None);
        Console.WriteLine("net_none=" + (Network.IsConnected() ? "1" : "0"));
        Network.Inject(NetworkType.Unknown);
        Console.WriteLine("net_unk=" + (Network.IsConnected() ? "1" : "0"));
        Network.Reset();

        // 2. Honest unsupported/unknown defaults without HardwareHost (B-ID217)
        Console.WriteLine("perm_default=" + ((int)Permissions.Check(PermissionType.Location)).ToString());
        Console.WriteLine("acc_sup=" + (Accelerometer.IsSupported() ? "1" : "0"));
        Console.WriteLine("gyro_sup=" + (Gyroscope.IsSupported() ? "1" : "0"));
        Console.WriteLine("comp_sup=" + (Compass.IsSupported() ? "1" : "0"));
        Console.WriteLine("geo_sup=" + (Geolocation.IsSupported() ? "1" : "0"));
        Console.WriteLine("bio_can=" + (Biometrics.CanAuthenticate() ? "1" : "0"));
        Console.WriteLine("bio_type=" + ((int)Biometrics.Type()).ToString());
        Console.WriteLine("bio_auth=" + (Biometrics.Authenticate("login") ? "1" : "0"));
        Console.WriteLine("notif=" + Notification.New("hi", "body").WithAction("open").WithBadge(1).WithSound("tick").Send().ToString());
        Console.WriteLine("share=" + (Share.Text("hi") ? "1" : "0"));
        Console.WriteLine("picker=" + NativePicker.PickImage());
        Console.WriteLine("screen=" + (Screen.IsKeepAwake() ? "1" : "0") + "|" + Screen.Brightness().ToString());
        Console.WriteLine("bar=" + ((int)SystemBar.Style()).ToString() + "|" + (SystemBar.IsVisible() ? "1" : "0") + "|" + (SystemBar.IsNavVisible() ? "1" : "0"));

        // 3. Inject & Reset + Permission gating on Geolocation
        Accelerometer.Inject(1.0f, 2.0f, 3.0f);
        Vector3 acc = Accelerometer.Current();
        Console.WriteLine("acc_inj=" + (Accelerometer.IsSupported() ? "1" : "0") + "|" + acc.X.ToString() + "," + acc.Y.ToString() + "," + acc.Z.ToString());
        Accelerometer.Reset();

        Gyroscope.Inject(0.5f, 0.0f, -0.5f);
        Console.WriteLine("gyro_inj=" + (Gyroscope.IsSupported() ? "1" : "0") + "|" + Gyroscope.Current().X.ToString());
        Gyroscope.Reset();

        Compass.Inject(405.0f);
        Console.WriteLine("comp_inj=" + (Compass.IsSupported() ? "1" : "0") + "|" + Compass.Heading().ToString());
        Compass.Reset();

        Geolocation.Inject(30.5, 114.3, 10.0, 3.0f, 1.5f);
        LocationData deniedLoc = Geolocation.Current();
        Permissions.Inject(PermissionType.Location, PermissionStatus.Granted);
        LocationData grantedLoc = Geolocation.Current();
        Console.WriteLine("geo_gate=" + deniedLoc.latitude.ToString() + "|" + grantedLoc.latitude.ToString() + "|" + (grantedLoc.timestampMs > 0 ? "1" : "0"));
        Geolocation.Reset();
        Permissions.Reset();

        Biometrics.Inject(true, BiometricType.Fingerprint, true);
        Console.WriteLine("bio_inj=" + (Biometrics.CanAuthenticate() ? "1" : "0") + "|" + ((int)Biometrics.Type()).ToString() + "|" + (Biometrics.Authenticate("pay") ? "1" : "0"));
        Biometrics.Reset();

        SystemTheme.Inject(true);
        Console.WriteLine("theme_inj=" + (SystemTheme.IsDarkMode() ? "1" : "0") + "|" + ((int)SystemTheme.Mode()).ToString());
        SystemTheme.InjectMode(SystemThemeMode.Unknown);
        Console.WriteLine("theme_unk=" + (SystemTheme.IsDarkMode() ? "1" : "0") + "|" + ((int)SystemTheme.Mode()).ToString());
        SystemTheme.Reset();

        DeepLink.Inject("zanapp://order/42");
        Console.WriteLine("dl=" + (DeepLink.HasPendingUrl() ? "1" : "0") + "|" + DeepLink.ExtractScheme(DeepLink.TakePendingUrl()) + "|" + (DeepLink.HasPendingUrl() ? "1" : "0"));
        DeepLink.Reset();

        // 4. Dependency inversion via IHardwareHost
        MockHardwareHost host = new MockHardwareHost();
        HardwareHost.Register(host);
        Console.WriteLine("host_dev=" + DeviceInfo.Model() + "|" + (DeviceInfo.IsFoldable() ? "1" : "0"));
        Console.WriteLine("host_net=" + ((int)Network.Type()).ToString());
        Console.WriteLine("host_notif=" + Notification.New("ok", "b").WithBadge(5).Send().ToString());
        Console.WriteLine("host_share=" + (Share.Text("share-me") ? "1" : "0"));
        Console.WriteLine("host_pick=" + NativePicker.PickImage());
        Console.WriteLine("host_bio=" + ((int)Biometrics.Type()).ToString() + "|" + (Biometrics.Authenticate("verify") ? "1" : "0"));
        Screen.KeepAwake(true);
        SystemBar.SetLightIcons();
        Console.WriteLine("host_ui=" + (Screen.IsKeepAwake() ? "1" : "0") + "|" + ((int)SystemBar.Style()).ToString());
        HardwareHost.Clear();
        Console.WriteLine("host_cleared=" + (HardwareHost.Current() == null ? "1" : "0"));
        return 0;
    }
}
