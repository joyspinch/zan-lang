using System;

public delegate int ExceptionOwnerCall(int ignored);
class ExceptionOwnerSlot {
    public ExceptionOwnerCall call;
}
class ExceptionOwnerReceiver {
    public ExceptionOwnerSlot slot;
    public int Read(int ignored) { return 51; }
    public int Fail(int ignored) {
        slot.call = null;
        throw new Exception("callback");
    }
}
class DelegateCalleeExceptionOwner {
    static int FailArgument(ExceptionOwnerSlot slot, WeakReference<ExceptionOwnerReceiver> observer) {
        slot.call = null;
        Console.WriteLine(observer.IsAlive);
        throw new Exception("argument");
    }
    static int StaticRead(int ignored) { return 52; }
    static int FailStaticArgument() { throw new Exception("static argument"); }
    static void CheckArgument() {
        ExceptionOwnerReceiver receiver = new ExceptionOwnerReceiver();
        WeakReference<ExceptionOwnerReceiver> observer = new WeakReference<ExceptionOwnerReceiver>(receiver);
        ExceptionOwnerSlot slot = new ExceptionOwnerSlot();
        slot.call = receiver.Read;
        receiver = null;
        try { slot.call(FailArgument(slot, observer)); }
        catch (Exception e) { Console.WriteLine("argument caught"); }
        Console.WriteLine(observer.IsAlive);
    }
    static void CheckCallback() {
        ExceptionOwnerReceiver receiver = new ExceptionOwnerReceiver();
        WeakReference<ExceptionOwnerReceiver> observer = new WeakReference<ExceptionOwnerReceiver>(receiver);
        ExceptionOwnerSlot slot = new ExceptionOwnerSlot();
        receiver.slot = slot;
        slot.call = receiver.Fail;
        receiver = null;
        try { slot.call(0); }
        catch (Exception e) { Console.WriteLine("callback caught"); }
        Console.WriteLine(observer.IsAlive);
    }
    static void CheckStaticAndNull() {
        ExceptionOwnerCall raw = StaticRead;
        try { raw(FailStaticArgument()); }
        catch (Exception e) { Console.WriteLine("static caught"); }
        Console.WriteLine(raw(0));
        ExceptionOwnerCall empty = null;
        try { empty(FailStaticArgument()); }
        catch (Exception e) { Console.WriteLine("null argument caught"); }
    }
    static void Main() {
        CheckArgument();
        CheckCallback();
        CheckStaticAndNull();
    }
}
