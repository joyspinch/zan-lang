using System;

class TransferError : Exception {
    public TransferError() : base("transfer") { }
}

class HandlerExitDepth {
    static int stale;
    static int outer;

    static void Check(bool value) {
        if (!value) { throw new Exception("handler depth assertion"); }
    }

    static async int Break() {
        try {
            for (int i = 0; i < 3; i = i + 1) {
                try { await Task.Yield(); break; }
                catch (TransferError error) { stale = stale + 1; return -1; }
            }
            await Task.Yield();
            throw new TransferError();
        } catch (TransferError error) { outer = outer + 1; return 1; }
    }

    static async int Continue() {
        try {
            for (int i = 0; i < 3; i = i + 1) {
                try { await Task.Yield(); continue; }
                catch (TransferError error) { stale = stale + 1; return -1; }
            }
            await Task.Yield();
            throw new TransferError();
        } catch (TransferError error) { outer = outer + 1; return 1; }
    }

    static async int Forward() {
        try {
            try { await Task.Yield(); goto Done; }
            catch (TransferError error) { stale = stale + 1; return -1; }
            Done:
            await Task.Yield();
            throw new TransferError();
        } catch (TransferError error) { outer = outer + 1; return 1; }
    }

    static async int Backward() {
        try {
            int pass = 0;
            Again:
            if (pass == 0) {
                try { await Task.Yield(); pass = 1; goto Again; }
                catch (TransferError error) { stale = stale + 1; return -1; }
            }
            await Task.Yield();
            throw new TransferError();
        } catch (TransferError error) { outer = outer + 1; return 1; }
    }

    static async void Main() {
        Check(await Break() == 1);
        Check(await Continue() == 1);
        Check(await Forward() == 1);
        Check(await Backward() == 1);
        Check(stale == 0 && outer == 4);
        Console.WriteLine("async handler depth ok");
    }
}
