using System;

interface Named {
    string Name();
    string Label() { return "[" + this.Name() + "]"; }
    int Score(int bonus) { return this.Name().Length + bonus; }
}

interface Doubled : Named {
    int Base();
    int Twice() { return this.Base() * 2; }
}

class Box : Named {
    public string Name() { return "box"; }
}

class Loud : Named {
    public string Name() { return "loud"; }
    public string Label() { return "!!"; }
}

class Pair : Doubled {
    public string Name() { return "pair"; }
    public int Base() { return 3; }
}

class Program {
    static void Main() {
        Box b = new Box();
        Console.WriteLine(b.Label());
        Console.WriteLine(Convert.ToString(b.Score(2)));
        Named n = new Box();
        Console.WriteLine(n.Label());
        Named l = new Loud();
        Console.WriteLine(l.Label());
        Pair p = new Pair();
        Console.WriteLine(Convert.ToString(p.Twice()));
        Console.WriteLine(p.Label());
        Doubled d = new Pair();
        Console.WriteLine(Convert.ToString(d.Twice()));
    }
}
