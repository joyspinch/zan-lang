using System;

class Box {
    public int Value;
}

class Program {
    static void Main() {
        // B-ID199 round3: a null receiver's instance-field READ used to go
        // straight to a raw GEP+load in the self-hosted compiler -- a
        // hardware segfault with no diagnostic. The C host (access_member.c)
        // checks TYPE_CLASS receivers first and raises a
        // NullReferenceException with the receiver's name; the field read
        // then lands on the soft scratch page and yields zero. Field STORE
        // is intentionally NOT covered: the C host segfaults there too, and
        // matching that is the contract.
        Box b = null;
        try {
            int v = b.Value;
            Console.WriteLine("read fail: " + v);
        } catch (NullReferenceException e) {
            Console.WriteLine("caught: " + e.Message);
        }
        // positive control: a live receiver still reads through
        Box live = new Box();
        live.Value = 7;
        Console.WriteLine("live=" + live.Value);
        Console.WriteLine("done");
    }
}
