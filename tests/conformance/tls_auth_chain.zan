using System;
using System.Net.Tls;
using System.Security.Cryptography;

class Program {
    static int failures = 0;
    static void Check(bool ok, string name) {
        if (ok) { Console.WriteLine("ok " + name); }
        else { Console.WriteLine("FAIL " + name); failures = failures + 1; }
    }
    // Root and leaf generated with OpenSSL RSA-SHA256, valid 2026-09-28 through 2036-09-25.
    static string ROOT = "";
    static string LEAF = "";
    static string CLIENT_AUTH_ROOT = "";
    static string CLIENT_AUTH_LEAF = "";
    static string SKE_SIG = "";
    static string CV_SIG = "";
    static byte[] DecodeBytes(string text) {
        List<int> len = new List<int>(); len.Add(0);
        byte[] raw = Base64.Decode(text, len);
        if (raw == null || len[0] <= 0) { return null; }
        byte[] exact = new byte[len[0]];
        NativeMemory.Copy(exact, raw, len[0]);
        return exact;
    }
    static X509Certificate Decode(string text) {
        List<int> len = new List<int>(); len.Add(0);
        byte[] der = Base64.Decode(text, len);
        return X509Certificate.ParseForTls(der, len[0]);
    }
    static TlsEngine Client(X509Certificate peer, List<X509Certificate> roots, string host) {
        TlsEngine e = new TlsEngine(host, false, true, null, false, null, roots, false, "", "");
        e.peerCert = peer;
        e.peerChain.Add(peer);
        return e;
    }
    static void Main() {
        X509Certificate root = Decode(ROOT);
        X509Certificate leaf = Decode(LEAF);
        Check(root != null && leaf != null, "strict DER parses legitimate chain");
        if (root == null || leaf == null) { return; }
        Check(root.ValidNow() && leaf.ValidNow() && root.CanSignCertificates() && leaf.CanServeTls(), "validity and usage");
        Check(leaf.VerifySignedBy(root), "legitimate RSA issuer signature");
        List<X509Certificate> trusted = new List<X509Certificate>(); trusted.Add(root);
        byte[] ske = new byte[100];
        for (int i = 0; i < 32; i = i + 1) { ske[i] = 1; ske[32 + i] = 2; ske[68 + i] = 3; }
        ske[64] = 3; ske[65] = 0; ske[66] = 29; ske[67] = 32;
        byte[] skeSig = DecodeBytes(SKE_SIG);
        if (skeSig == null) { Check(false, "decode TLS 1.2 signature"); return; }
        Check(leaf.VerifyHandshakeSignature(ske, skeSig), "TLS 1.2 authentic ServerKeyExchange");
        ske[64] = 4;
        Check(!leaf.VerifyHandshakeSignature(ske, skeSig), "TLS 1.2 forged ServerKeyExchange rejected");
        ske[64] = 3;
        byte[] skeBody = new byte[36 + 4 + skeSig.Length];
        NativeMemory.Copy(skeBody, (nint)ske + 64, 36);
        skeBody[36] = 4; skeBody[37] = 1;
        skeBody[38] = (byte)(skeSig.Length >> 8); skeBody[39] = (byte)(skeSig.Length & 255);
        NativeMemory.Copy((nint)skeBody + 40, skeSig, skeSig.Length);
        TlsEngine tls12 = Client(leaf, trusted, "secure.example");
        tls12.negotiatedVersion = TlsRecord.VersionTls12;
        tls12.clientRandom = new byte[32]; tls12.serverRandom = new byte[32];
        for (int i = 0; i < 32; i = i + 1) { tls12.clientRandom[i] = 1; tls12.serverRandom[i] = 2; }
        Check(tls12.HandleServerKeyExchange(new byte[0], skeBody) == 0 && tls12.handshakeSignatureVerified,
            "TLS 1.2 handshake authentic signature accepted");
        skeBody[40] = (byte)((skeBody[40] & 255) ^ 1);
        TlsEngine bad12 = Client(leaf, trusted, "secure.example");
        bad12.negotiatedVersion = TlsRecord.VersionTls12;
        bad12.clientRandom = tls12.clientRandom; bad12.serverRandom = tls12.serverRandom;
        Check(bad12.HandleServerKeyExchange(new byte[0], skeBody) < 0, "TLS 1.2 handshake forged signature refused");
        byte[] signed = new byte[130];
        for (int i = 0; i < 64; i = i + 1) { signed[i] = 32; }
        string context = "TLS 1.3, server CertificateVerify";
        for (int i = 0; i < 33; i = i + 1) { signed[64 + i] = (byte)(context[i] & 255); }
        byte[] emptyHash = Sha256.Hash(new byte[0], 0);
        NativeMemory.Copy((nint)signed + 98, emptyHash, 32);
        byte[] cvSig = DecodeBytes(CV_SIG);
        if (cvSig == null) { Check(false, "decode TLS 1.3 signature"); return; }
        Check(leaf.VerifyPssSha256(signed, cvSig), "TLS 1.3 authentic RSA-PSS CertificateVerify");
        signed[64] = 0;
        Check(!leaf.VerifyPssSha256(signed, cvSig), "TLS 1.3 forged CertificateVerify rejected");
        byte[] cvBody = new byte[4 + cvSig.Length];
        cvBody[0] = 8; cvBody[1] = 4;
        cvBody[2] = (byte)(cvSig.Length >> 8); cvBody[3] = (byte)(cvSig.Length & 255);
        NativeMemory.Copy((nint)cvBody + 4, cvSig, cvSig.Length);
        TlsEngine tls13 = Client(leaf, trusted, "secure.example");
        tls13.negotiatedVersion = TlsRecord.VersionTls13;
        Check(tls13.HandleCertificateVerify(new byte[0], cvBody) == 0 && tls13.handshakeSignatureVerified,
            "TLS 1.3 handshake authentic signature accepted");
        cvBody[4] = (byte)((cvBody[4] & 255) ^ 1);
        TlsEngine bad13 = Client(leaf, trusted, "secure.example");
        bad13.negotiatedVersion = TlsRecord.VersionTls13;
        Check(bad13.HandleCertificateVerify(new byte[0], cvBody) < 0, "TLS 1.3 handshake forged signature refused");
        Check(leaf.VerifyHost("secure.example") && leaf.VerifyHost("www.secure.example"), "SAN DNS and single-label wildcard");
        Check(!leaf.VerifyHost("else.example") && !leaf.VerifyHost("deep.www.secure.example")
            && !leaf.VerifyHost("127.0.0.1"), "SAN mismatch and IP reject");
        Check(Client(leaf, trusted, "secure.example").VerifyCertificate() == 0, "trusted chain accepted");
        Check(Client(leaf, null, "secure.example").VerifyCertificate() < 0, "no implicit trust roots");
        Check(Client(leaf, trusted, "else.example").VerifyCertificate() < 0, "wrong host refused");
        X509Certificate clientOnlyRoot = Decode(CLIENT_AUTH_ROOT);
        X509Certificate clientOnlyLeaf = Decode(CLIENT_AUTH_LEAF);
        Check(clientOnlyRoot != null && clientOnlyLeaf != null && clientOnlyRoot.ValidNow()
            && clientOnlyLeaf.ValidNow() && clientOnlyLeaf.CanServeTls()
            && clientOnlyLeaf.VerifyHost("secure.example") && clientOnlyLeaf.VerifySignedBy(clientOnlyRoot),
            "restricted CA chain is otherwise valid");
        if (clientOnlyRoot != null && clientOnlyLeaf != null) {
            List<X509Certificate> restricted = new List<X509Certificate>(); restricted.Add(clientOnlyRoot);
            Check(!clientOnlyRoot.CanSignCertificates()
                && Client(clientOnlyLeaf, restricted, "secure.example").VerifyCertificate() < 0,
                "clientAuth-only CA cannot authenticate TLS server");
        }
        TlsEngine policy = new TlsEngine("else.example", false, true, null, false,
            (long reason, string certText) => reason == 62 && certText.Length > 0, trusted, false, "", "");
        policy.peerCert = leaf; policy.peerChain.Add(leaf);
        policy.peerCertText = "issuer=" + leaf.Issuer() + " subject=" + leaf.Subject();
        Check(policy.VerifyCertificate() == 0, "explicit policy accepts hostname mismatch");
        TlsEngine combinedFailure = new TlsEngine("else.example", false, true, null, false,
            (long reason, string certText) => reason == 62, null, false, "", "");
        combinedFailure.peerCert = leaf; combinedFailure.peerChain.Add(leaf);
        Check(combinedFailure.VerifyCertificate() < 0 && combinedFailure.verifyResult == 19,
            "hostname policy cannot also waive untrusted chain");
        TlsEngine pinDisabled = new TlsEngine("else.example", true, true, null, true,
            null, null, false, "", "");
        pinDisabled.peerCert = leaf;
        Check(pinDisabled.VerifyCertificate() < 0 && pinDisabled.verifyResult == 63,
            "disabled chain verification still enforces required pin");
        List<string> wrongPins = new List<string>(); wrongPins.Add("sha256/invalid");
        TlsEngine wrongPinDisabled = new TlsEngine("else.example", true, true, wrongPins, false,
            null, null, false, "", "");
        wrongPinDisabled.peerCert = leaf;
        Check(wrongPinDisabled.VerifyCertificate() < 0 && wrongPinDisabled.verifyResult == 63,
            "disabled chain verification still rejects mismatched pin");
        Check(!leaf.VerifyHost("xn--test.secure.example") && !leaf.VerifyHost("XN--test.secure.example"),
            "wildcard refuses IDNA labels regardless of case");
        List<int> n = new List<int>(); n.Add(0);
        byte[] forged = Base64.Decode(LEAF, n);
        forged[n[0] - 3] = (byte)((forged[n[0] - 3] & 255) ^ 1);
        X509Certificate fake = X509Certificate.ParseForTls(forged, n[0]);
        Check(fake != null && !fake.VerifySignedBy(root), "forged issuer signature rejected");
        if (fake != null) { Check(Client(fake, trusted, "secure.example").VerifyCertificate() < 0, "forged chain refused"); }
        Console.WriteLine("failures=" + Convert.ToString(failures));
    }
}
