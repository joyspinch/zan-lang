// Conformance: the NativeMemory.Sha256 intrinsic must compute the FIPS 180-4
// digest over the raw bytes and hand the caller an OWNED (+1) ARC string of
// exactly 32 digest bytes. It is lowered by the compiler (emit_nm_digest:
// stack scratch block -> zan_hw_sha256 -> ARC string or null) but it is
// DECLARED as a bodyless [DllImport] -- so the borrowed-extern rule in
// expr_yields_owned_rc_value must not claim it (the A262 GetString leak shape).
//
// The kernel reports -1 (null digest) on machines without a hardware engine;
// the null-acting shapes below stay balanced either way, and the vectors go
// through the stdlib wrapper so the golden holds on hardware-less machines
// too (ZAN_NO_HWACCEL=1 exercises the pure path on any machine).
//
// Vectors are the NIST FIPS 180-4 examples: empty, "abc", the 56-byte message
// whose 0x80 pad byte lands exactly on the block boundary, and the canonical
// 112-byte two-block message. Every consumer shape must balance (a discarded
// call, a local binding reassigned in a loop, an argument temp, a return); run
// under the leakcheck twin -- 0 objects may remain at exit.
using System;
using System.Security.Cryptography;

class Program {
    // [DllImport] declaration only types the call; the compiler recognizes
    // NativeMemory.Sha256 and lowers it internally.
    [DllImport("zanrt_mem")]
    static extern string Sha256(nint p, int len);

    // Intrinsic first; null (no hardware engine) falls back to the pure-Zan
    // class implementation over a managed copy of the same raw bytes.
    static string Sha(nint p, int len) {
        if (len < 0) { len = 0; }
        string d = NativeMemory.Sha256(p, len);
        if (d != null) { return d; }
        return Sha256.Hash(NativeMemory.GetString(p, 0, len), len);
    }

    static string HashBytes(string msg) {
        nint p = NativeMemory.Alloc(msg.Length + 8);
        NativeMemory.PutString(p, 0, msg, msg.Length);
        string d = Sha(p, msg.Length);
        NativeMemory.Free(p);
        return d;
    }

    static int Main() {
        // discarded result (the A262 consumer shape that leaked GetString)
        nint p = NativeMemory.Alloc(8);
        NativeMemory.PutString(p, 0, "abc", 3);
        NativeMemory.Sha256(p, 3);

        // NIST vectors, compared as raw digest bytes against a reference table
        string[] msgs = new string[] { "", "abc",
            "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
            "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu" };
        string[] want = new string[] {
            "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
            "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
            "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
            "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1" };
        for (int i = 0; i < 4; i = i + 1) {
            string d = HashBytes(msgs[i]);
            if (d.Length != 32) { Console.WriteLine("BADLEN " + i); return 1; }
            string hex = Hex.Encode(d, 32).ToLower();
            if (hex != want[i]) {
                Console.WriteLine("BADVEC " + Convert.ToString(i));
                return 2;
            }
        }

        // local binding reassigned in a loop (the KDF-chain shape the server
        // templates run 12000 rounds of)
        string acc = "seed";
        nint q = NativeMemory.Alloc(128);
        for (int r = 0; r < 64; r = r + 1) {
            NativeMemory.PutString(q, 0, acc, acc.Length);
            acc = Sha(q, acc.Length);
        }
        NativeMemory.Free(q);
        string accHex = Hex.Encode(acc, 32).ToLower();
        // 64 rounds of sha256 over the raw digest starting from "seed" --
        // golden computed independently; pins chain determinism + lengths
        if (accHex != "c0118ba02bb5e6e591ad0eb53bafe9024dc16cae408d0608cf166042475043c4") {
            Console.WriteLine("BADCHAIN");
            return 3;
        }

        // length clamping: a negative length must hash as zero bytes, not wrap
        // (hardware-path contract; vacuous where the intrinsic returns null)
        NativeMemory.PutString(p, 0, "x", 1);
        string dn = NativeMemory.Sha256(p, -5);
        string d0 = NativeMemory.Sha256(p, 0);
        if (dn != null && d0 != null) {
            if (Hex.Encode(dn, 32).ToLower() != Hex.Encode(d0, 32).ToLower()) {
                Console.WriteLine("BADNEG");
                return 5;
            }
        }
        NativeMemory.Free(p);
        Console.WriteLine("ok");
        return 0;
    }
}
