using System;

// A434：类型参数字段在"擦除上下文"（泛型方法体内经类型实参访问）里
// 的读写。早期实现把按值内联的槽位头 8 字节当指针返回（野指针）；
// 现在两条路径都必须拿到正确的当前值。
struct Pos {
    public int x;
    public int y;
    public Pos(int px, int py) { x = px; y = py; }
}

class Box<T> {
    public T value;
    public T Get() { return this.value; }
    public void Set(T v) { this.value = v; }
}

class Program {
    static T PeekCall<T>(Box<T> b) { return b.Get(); }
    static T PeekField<T>(Box<T> b) { return b.value; }
    static void PokeCall<T>(Box<T> b, T v) { b.Set(v); }
    static void PokeField<T>(Box<T> b, T v) { b.value = v; }

    static void Main() {
        Box<Pos> box = new Box<Pos>();
        box.Set(new Pos(3, 4));
        Console.WriteLine(Convert.ToString(box.Get().x) + "," + Convert.ToString(box.Get().y));

        Pos p = PeekCall<Pos>(box);
        Console.WriteLine(Convert.ToString(p.x) + "," + Convert.ToString(p.y));
        Pos q = PeekField<Pos>(box);
        Console.WriteLine(Convert.ToString(q.x) + "," + Convert.ToString(q.y));

        PokeField<Pos>(box, new Pos(7, 8));
        Console.WriteLine(Convert.ToString(PeekField<Pos>(box).x) + "," + Convert.ToString(PeekField<Pos>(box).y));
        PokeCall<Pos>(box, new Pos(9, 10));
        Console.WriteLine(Convert.ToString(PeekCall<Pos>(box).x) + "," + Convert.ToString(PeekCall<Pos>(box).y));

        Box<string> bs = new Box<string>();
        PokeCall<string>(bs, "zan");
        Console.WriteLine(PeekCall<string>(bs));

        Box<int> bi = new Box<int>();
        PokeField<int>(bi, 41);
        int n = PeekField<int>(bi);
        Console.WriteLine(Convert.ToString(n + 1));
    }
}
