using System;

class DivZeroCatch {
    static void Main() {
        // try 外：soft 报告 + 商归一化 0（binary 通道）
        int a = 1 / Zero();
        int b = 5 % Zero();
        int c = int.MinValue / -1;
        long d = 9L / ZeroL();
        Console.WriteLine("out div=" + a);
        Console.WriteLine("out mod=" + b);
        Console.WriteLine("out min.div=" + c);
        Console.WriteLine("out long.div=" + d);
        // 复合赋值通道（/= 与 %=）
        int e = 42;
        e /= Zero();
        int f = 42;
        f %= Zero();
        int g = int.MinValue;
        g /= -1;
        Console.WriteLine("out diveq=" + e);
        Console.WriteLine("out modeq=" + f);
        Console.WriteLine("out mineq=" + g);
        // try 内：DivideByZeroException 分发（binary + assign 两通道）
        try {
            int h = 1 / Zero();
            Console.WriteLine("in div no-throw " + h);
        } catch (DivideByZeroException) {
            Console.WriteLine("in div DivideByZeroException");
        }
        try {
            int i = 1;
            i %= Zero();
            Console.WriteLine("in modeq no-throw " + i);
        } catch (DivideByZeroException) {
            Console.WriteLine("in modeq DivideByZeroException");
        } catch (Exception) {
            Console.WriteLine("in modeq wrong-exception");
        }
        // 正常除法回归
        int j = 100 / 7;
        int k = 100 % 7;
        int m = 100;
        m /= 7;
        Console.WriteLine("norm " + j + " " + k + " " + m);
        // 非零负除数回归：截断向零
        int n = -7 / 2;
        int o = -7 % 2;
        Console.WriteLine("neg " + n + " " + o);
    }
    static int Zero() { return 0; }
    static long ZeroL() { return 0; }
}
