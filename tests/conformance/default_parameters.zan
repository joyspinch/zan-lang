using System;

class Widget {
    public int total;
    public Widget(int a, int b = 5) { total = a + b; }
}

class Panel : Widget {
    public Panel(int a) : base(a) { }
}

class Chained {
    public int total;
    public Chained(int a, int b = 3) { total = a + b; }
    public Chained() : this(1) { }
}

struct Point {
    public int v;
    public Point(int a, int b = 9) { v = a + b; }
}

class Calc {
    public static int Sum(int a, int b = 2) { return a + b; }
    public static double Scale(double a, double b = 1.5) { return a * b; }
    public int Mix(int a, int b = 2, string s = "xy") { return a + b + s.Length; }
    public int Self() { return this.Mix(1) + Mix(1, 1); }
}

class Program {
    static void Main() {
        Console.WriteLine(Convert.ToString(Calc.Sum(1)));
        Console.WriteLine(Convert.ToString(Calc.Sum(1, 10)));
        Console.WriteLine(Convert.ToString(Calc.Scale(2)));
        Calc c = new Calc();
        Console.WriteLine(Convert.ToString(c.Mix(1)));
        Console.WriteLine(Convert.ToString(c.Mix(1, 1)));
        Console.WriteLine(Convert.ToString(c.Mix(1, 1, "z")));
        Console.WriteLine(Convert.ToString(c.Self()));
        Console.WriteLine(Convert.ToString(new Widget(1).total));
        Console.WriteLine(Convert.ToString(new Widget(1, 1).total));
        Console.WriteLine(Convert.ToString(new Panel(2).total));
        Console.WriteLine(Convert.ToString(new Chained().total));
        Point p = new Point(1);
        Console.WriteLine(Convert.ToString(p.v));
    }
}
