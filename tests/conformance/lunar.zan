using System;
using System.Globalization;

/// System.Globalization.Lunar conformance: 公历 → 农历转换、干支(年/月/日)、
/// 生肖、农历月日中文名、二十四节气与边界异常。期望值由权威历表
/// (lunar_python,紫金山天文台历算)在 1900..2100 全量 73384 天逐日核对。
class Program {
    static int bad;

    static void Check(bool ok, string label) {
        if (!ok) { Console.WriteLine("FAIL " + label); bad = bad + 1; }
    }

    static void CheckDate(int y, int m, int d, int ly, int lm, int ld, bool leap,
                          string text, string label) {
        LunarDate x = Lunar.FromSolar(y, m, d);
        Check(x.Year() == ly && x.Month() == lm && x.Day() == ld
              && x.IsLeapMonth() == leap, label + " fields");
        Check(x.ToString() == text, label + " text");
    }

    static void Main() {
        // ---- 农历转换 + 中文名(年份跨 1900..2100,含闰月/腊月) ----
        CheckDate(1900, 1, 31, 1900, 1, 1, false, "庚子年正月初一", "1900 cny");
        CheckDate(1900, 8, 25, 1900, 8, 1, false, "庚子年八月初一", "1900 aug");
        CheckDate(1901, 1, 1, 1900, 11, 11, false, "庚子年冬月十一", "1901 jan");
        CheckDate(1949, 10, 1, 1949, 8, 10, false, "己丑年八月初十", "1949");
        CheckDate(1984, 2, 2, 1984, 1, 1, false, "甲子年正月初一", "1984 cny");
        CheckDate(2000, 2, 5, 2000, 1, 1, false, "庚辰年正月初一", "2000 cny");
        CheckDate(2021, 2, 12, 2021, 1, 1, false, "辛丑年正月初一", "2021 cny");
        CheckDate(2023, 1, 22, 2023, 1, 1, false, "癸卯年正月初一", "2023 cny");
        CheckDate(2023, 3, 22, 2023, 2, 1, true, "癸卯年闰二月初一", "2023 leap2");
        CheckDate(2023, 4, 20, 2023, 3, 1, false, "癸卯年三月初一", "2023 mar");
        CheckDate(2024, 2, 4, 2023, 12, 25, false, "癸卯年腊月廿五", "2024 pre-cny");
        CheckDate(2024, 2, 10, 2024, 1, 1, false, "甲辰年正月初一", "2024 cny");
        CheckDate(2024, 3, 5, 2024, 1, 25, false, "甲辰年正月廿五", "2024 jan");
        CheckDate(2024, 6, 10, 2024, 5, 5, false, "甲辰年五月初五", "2024 dragonboat");
        CheckDate(2024, 12, 21, 2024, 11, 21, false, "甲辰年冬月廿一", "2024 dec");
        CheckDate(2026, 2, 17, 2026, 1, 1, false, "丙午年正月初一", "2026 cny");
        CheckDate(1990, 6, 23, 1990, 5, 1, true, "庚午年闰五月初一", "1990 leap5");
        CheckDate(2033, 12, 22, 2033, 11, 1, true, "癸丑年闰冬月初一", "2033 leap11");
        CheckDate(2050, 1, 23, 2050, 1, 1, false, "庚午年正月初一", "2050 cny");
        CheckDate(2100, 12, 31, 2100, 12, 1, false, "庚申年腊月初一", "2100 last");

        // ---- 年干支 / 生肖(以农历正月初一为界) ----
        Check(Lunar.FromSolar(2024, 2, 10).YearGanZhi() == "甲辰", "ygz 2024");
        Check(Lunar.FromSolar(2024, 2, 4).YearGanZhi() == "癸卯", "ygz 2024 pre-cny");
        Check(Lunar.FromSolar(2023, 1, 22).Zodiac() == "兔", "zodiac 2023");
        Check(Lunar.FromSolar(2024, 2, 10).Zodiac() == "龙", "zodiac 2024");
        Check(Lunar.FromSolar(1984, 2, 2).Zodiac() == "鼠", "zodiac 1984");

        // ---- 月干支(节气月,立春为年界) ----
        Check(Lunar.FromSolar(2024, 2, 10).MonthGanZhi() == "丙寅", "mgz 2024 cny");
        Check(Lunar.FromSolar(2024, 2, 4).MonthGanZhi() == "丙寅", "mgz lichun");
        Check(Lunar.FromSolar(2024, 3, 5).MonthGanZhi() == "丁卯", "mgz jingzhe");
        Check(Lunar.FromSolar(2023, 3, 22).MonthGanZhi() == "乙卯", "mgz leap2");
        Check(Lunar.FromSolar(2023, 1, 22).MonthGanZhi() == "癸丑", "mgz 2023 jan");
        Check(Lunar.FromSolar(1900, 1, 31).MonthGanZhi() == "丁丑", "mgz 1900");

        // ---- 日干支(按公历日,不限于农历范围) ----
        Check(Lunar.DayGanZhi(1900, 1, 1) == "甲戌", "dgz 1900-1-1");
        Check(Lunar.DayGanZhi(1984, 2, 2) == "丙寅", "dgz 1984-2-2");
        Check(Lunar.DayGanZhi(2024, 2, 10) == "甲辰", "dgz 2024-2-10");
        Check(Lunar.FromSolar(2024, 12, 21).DayGanZhi() == "己未", "dgz 2024-12-21");

        // ---- 节气(当天匹配) ----
        Check(Lunar.SolarTerm(2024, 2, 4) == "立春", "lichun");
        Check(Lunar.SolarTerm(2024, 3, 5) == "惊蛰", "jingzhe");
        Check(Lunar.SolarTerm(2024, 6, 21) == "夏至", "xiazhi");
        Check(Lunar.SolarTerm(2024, 12, 21) == "冬至", "dongzhi");
        Check(Lunar.SolarTerm(1902, 12, 23) == "冬至", "dongzhi 1902");
        Check(Lunar.SolarTerm(2024, 3, 6) == "", "no term");
        Check(Lunar.SolarTerm(1899, 1, 1) == "", "term out of range");

        // ---- 边界异常 ----
        bool threw = false;
        try { LunarDate x = Lunar.FromSolar(1899, 12, 31); } catch (ArgumentException) { threw = true; }
        Check(threw, "1899 throws");
        threw = false;
        try { LunarDate x = Lunar.FromSolar(2101, 1, 1); } catch (ArgumentException) { threw = true; }
        Check(threw, "2101 throws");

        Console.WriteLine("lunar-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
