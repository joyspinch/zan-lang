using System;
using System.Bson;
using System.Cbor;
using System.MsgPack;
using System.Protobuf;
using System.Toml;
using System.Yaml;
using System.Csv;
using System.Json;
using System.Collections.Generic;

class SerializationSuiteTest {
    static int Main() {
        // 1. BSON Document Roundtrip
        JsonValue doc = JsonValue.NewObject();
        doc.Set("name", JsonValue.NewStr("ZanLang"));
        doc.Set("version", JsonValue.NewInt(2026));
        doc.Set("active", JsonValue.NewBool(true));
        byte[] bsonBytes = Bson.Pack(doc);
        JsonValue bsonDec = Bson.Unpack(bsonBytes);
        if (bsonDec.Str("name", "") != "ZanLang" || bsonDec.Int("version", 0) != 2026 || !bsonDec.Bool("active", false)) {
            return 1;
        }

        // 2. CBOR Value Roundtrip
        byte[] cborBytes = Cbor.Encode(doc);
        JsonValue cborDec = Cbor.Decode(cborBytes);
        if (cborDec.Str("name", "") != "ZanLang" || cborDec.Int("version", 0) != 2026) {
            return 2;
        }

        // 3. MsgPack Roundtrip
        byte[] mpBytes = MsgPack.Pack(doc);
        JsonValue mpDec = MsgPack.Unpack(mpBytes);
        if (mpDec.Str("name", "") != "ZanLang" || mpDec.Int("version", 0) != 2026) {
            return 3;
        }

        // 4. Protobuf Wire Roundtrip
        ProtoWriter pw = new ProtoWriter();
        pw.WriteString(1, "zan_proto");
        pw.WriteVarint(2, 42);
        pw.WriteFixed32(3, 100);
        byte[] protoBytes = pw.ToBytes();

        ProtoReader pr = new ProtoReader(protoBytes);
        string f1 = "";
        long f2 = 0;
        int f3 = 0;
        while (pr.Next()) {
            if (pr.FieldNumber() == 1) { f1 = pr.ReadString(); }
            else if (pr.FieldNumber() == 2) { f2 = pr.ReadVarint(); }
            else if (pr.FieldNumber() == 3) { f3 = pr.ReadFixed32(); }
            else { pr.Skip(); }
        }
        if (f1 != "zan_proto" || f2 != 42 || f3 != 100) {
            return 4;
        }

        // 5. TOML Roundtrip
        string tomlText = "title = \"Zan Application\"\nport = 8080\n[owner]\nname = \"Admin\"\n";
        JsonValue tomlVal = Toml.Parse(tomlText);
        if (tomlVal.Str("title", "") != "Zan Application" || tomlVal.Int("port", 0) != 8080) {
            return 5;
        }
        if (tomlVal.Get("owner")?.Str("name", "") != "Admin") {
            return 6;
        }
        string tomlOut = Toml.ToToml(tomlVal);
        JsonValue tomlVal2 = Toml.Parse(tomlOut);
        if (tomlVal2.Str("title", "") != "Zan Application" || tomlVal2.Int("port", 0) != 8080) {
            return 7;
        }

        // 6. YAML Roundtrip
        string yamlText = "name: ZanYaml\nversion: 1.0\nenabled: true\n";
        JsonValue yamlVal = Yaml.Parse(yamlText);
        if (yamlVal.Str("name", "") != "ZanYaml" || !yamlVal.Bool("enabled", false)) {
            return 8;
        }

        // 7. CSV Roundtrip
        string csvText = "id,name,role\n1,Alice,Engineer\n2,Bob,Architect\n";
        CsvTable table = Csv.Parse(csvText);
        if (table.RowCount() != 2) { return 9; }
        List<string> colNames = table.Column("name");
        if (colNames == null || colNames.Count != 2 || colNames[0] != "Alice" || colNames[1] != "Bob") {
            return 10;
        }

        Console.WriteLine("SERIALIZATION_SUITE_OK");
        return 0;
    }
}
