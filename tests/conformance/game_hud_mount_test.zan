using System;
using Gui;
using Gui.Widget;
using Game.Foundation.Gui;

namespace T;

class Program {
    static void Assert(string name, bool cond) {
        if (!cond) {
            Console.WriteLine("FAIL: " + name);
            Environment.Exit(1);
        }
        Console.WriteLine("PASS: " + name);
    }

    static void Main() {
        Console.WriteLine("=== Testing Game HudLayer Unified GUI Mount ===");

        HudLayer hud = new HudLayer();
        Assert("initial empty", hud.Count() == 0);
        Assert("initial visible", hud.IsVisible());

        // 挂载标准 GUI Button
        Button btnBag = new Button { Text = "背包", Class = "game-btn hud" };
        hud.Add(btnBag);
        Assert("count after add", hud.Count() == 1);

        // 挂载状态栏
        Progress barHp = new Progress(80, 1);
        hud.Add(barHp);
        Assert("count after add 2", hud.Count() == 2);

        // 移除测试
        bool rm = hud.Remove(btnBag);
        Assert("removed btn", rm);
        Assert("count after rm", hud.Count() == 1);

        hud.Clear();
        Assert("cleared", hud.Count() == 0);

        Console.WriteLine("HUD_LAYER_TEST_OK");
    }
}
