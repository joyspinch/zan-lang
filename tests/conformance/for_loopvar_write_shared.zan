// A519 收口用例：for 循环变量是【一个】共享变量（C# 经典坑语义）。
// C# .NET 8 地面真值：
//   for 的循环变量 i 整个循环只有一个实例——全部闭包共享同一个 i，
//   循环结束后全部读到 3；闭包内给 i 赋值合法且共享同一个 i，
//   三次调用依次得 13/23/33。
//   对照组：foreach 的迭代变量每次迭代新建——各自捕获独立副本 a/b/c；
//   普通局部变量只被读捕获、外部随后写入——闭包必须读到新值 9
//   （捕获的是变量本身，不是值的快照）。
using System;
using System.Collections.Generic;

class Program {
    static void Main() {
        List<Func<int>> fs = new List<Func<int>>();
        for (int i = 0; i < 3; i = i + 1) {
            fs.Add(() => i);
        }
        for (int k = 0; k < fs.Count; k = k + 1) {
            Console.WriteLine("for:" + Convert.ToString(fs[k]()));
        }

        List<string> words = new List<string>();
        words.Add("a");
        words.Add("b");
        words.Add("c");
        List<Func<string>> gs = new List<Func<string>>();
        foreach (string w in words) {
            gs.Add(() => w);
        }
        for (int k = 0; k < gs.Count; k = k + 1) {
            Console.WriteLine("fe:" + gs[k]());
        }

        int q = 1;
        Func<int> rq = () => q;
        q = 9;
        Console.WriteLine("plain:" + Convert.ToString(rq()));

        List<Func<int>> hs = new List<Func<int>>();
        for (int i = 0; i < 3; i = i + 1) {
            hs.Add(() => { i = i + 10; return i; });
        }
        for (int k = 0; k < hs.Count; k = k + 1) {
            Console.WriteLine("assign:" + Convert.ToString(hs[k]()));
        }
    }
}
