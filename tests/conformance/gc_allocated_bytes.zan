using System;

class DummyObj {
    public int x;
    public int y;
    public string name;

    public DummyObj(int x, int y, string name) {
        this.x = x;
        this.y = y;
        this.name = name;
    }
}

class Program {
    static void Main() {
        long t0 = GC.GetAllocatedBytesForCurrentThread();
        long g0 = GC.GetTotalAllocatedBytes();

        // 1. 验证对象分配增加计数
        DummyObj obj = new DummyObj(10, 20, "hello-alloc-metrics");
        long t1 = GC.GetAllocatedBytesForCurrentThread();
        long g1 = GC.GetTotalAllocatedBytes();

        bool delta_obj = (t1 - t0) > 0;
        bool delta_total_obj = (g1 - g0) >= (t1 - t0);

        if (delta_obj && delta_total_obj) {
            Console.WriteLine("obj alloc tracked: ok");
        } else {
            Console.WriteLine("obj alloc tracked: fail t0=" + t0 + " t1=" + t1);
        }

        // 2. 验证数组分配增加计数
        long t2 = GC.GetAllocatedBytesForCurrentThread();
        int[] arr = new int[256];
        for (int i = 0; i < 256; i++) {
            arr[i] = i;
        }
        long t3 = GC.GetAllocatedBytesForCurrentThread();
        long arr_delta = t3 - t2;
        // 256 * 4 = 1024 bytes + array header (64 bytes)
        if (arr_delta >= 1024) {
            Console.WriteLine("array alloc tracked: ok");
        } else {
            Console.WriteLine("array alloc tracked: fail delta=" + arr_delta);
        }

        // 3. 验证 GC.Collect 与 GetTotalMemory
        GC.Collect();
        long totalMem = GC.GetTotalMemory(false);
        if (totalMem >= t3) {
            Console.WriteLine("gc query: ok");
        } else {
            Console.WriteLine("gc query: fail mem=" + totalMem);
        }
    }
}
