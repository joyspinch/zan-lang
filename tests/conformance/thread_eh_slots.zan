using System;
using System.Threading;

// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。
// 核心契约与语义定义。

class Program {
    static AtomicInt done = new AtomicInt(0);

    static void Body() {
        try {
            throw new Exception("x");
        } catch (Exception e) {
            done.Increment();
        }
    }

    static void Main() {
        int n = 3000;
        for (int i = 0; i < n; i = i + 1) {
            Thread.Start(Body);
            while (done.Load() < i + 1) { Thread.Sleep(0); }
        }
        Console.WriteLine(done.Load());
    }
}
