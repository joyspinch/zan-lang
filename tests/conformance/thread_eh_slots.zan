using System;
using System.Threading;

// Every thread that enters a try claims a slot in the exception-handling
// table, which holds 1024 of them. The slot used to be held for the life of
// the process, so 3000 threads that each throw once exhausted it (and leaked
// their handler chunks: ~100 MB here). A thread that has finished must hand
// its slot back, so this must run in a bounded table and finish.

class Program {
    static AtomicInt done = new AtomicInt(0);

    static void Body() {
        try {
            throw new Exception("x");
        } catch (Exception e) {
            done.Increment();
        }
    }

    static void Main() {
        int n = 3000;
        for (int i = 0; i < n; i = i + 1) {
            Thread.Start(Body);
            while (done.Load() < i + 1) { Thread.Sleep(0); }
        }
        Console.WriteLine(done.Load());
    }
}
