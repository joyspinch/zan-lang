// Convert.ToInt32/ToInt64 整数路径的溢出语义（审计 P1-12）。
// C# 语义：超 int 范围抛 OverflowException。Zan 软诊断口径（A512）：
// 软诊断 + 安全值 0，程序继续（--strict-runtime 下 exit 70）。
// 修复前：ToInt32(2^31L) 静默截断回绕 → -2147483648。
using System;

public class ConvertOverflow {
    static void Main() {
        // 越界：上侧、下侧——软诊断 + 0
        int over_hi = Convert.ToInt32(2147483648L);
        int over_lo = Convert.ToInt32(-2147483649L);
        // 边界内：不误杀
        int edge_hi = Convert.ToInt32(2147483647L);
        int edge_lo = Convert.ToInt32(-2147483648L);
        // 全宽：ToInt64 不受限
        long wide = Convert.ToInt64(5000000000L);
        // 字符串路径回归（A512 既有行为）
        int str_ok = Convert.ToInt32("123");
        // ToInt64 字符串溢出（ERANGE 判定）：超 long 曾静默饱和成
        // INT64_MAX/MIN——只看返回值分不清饱和与恰好极值，须软诊断 + 0
        long s64over = Convert.ToInt64("99999999999999999999");
        long s64under = Convert.ToInt64("-99999999999999999999");
        // 恰好极值：不得误杀
        long s64max = Convert.ToInt64("9223372036854775807");
        long s64min = Convert.ToInt64("-9223372036854775808");
        Console.WriteLine("over_hi=" + Convert.ToString(over_hi));
        Console.WriteLine("over_lo=" + Convert.ToString(over_lo));
        Console.WriteLine("edge_hi=" + Convert.ToString(edge_hi));
        Console.WriteLine("edge_lo=" + Convert.ToString(edge_lo));
        Console.WriteLine("wide=" + Convert.ToString(wide));
        Console.WriteLine("str_ok=" + Convert.ToString(str_ok));
        Console.WriteLine("s64over=" + Convert.ToString(s64over));
        Console.WriteLine("s64under=" + Convert.ToString(s64under));
        Console.WriteLine("s64max=" + Convert.ToString(s64max));
        Console.WriteLine("s64min=" + Convert.ToString(s64min));
        bool ok = over_hi == 0 && over_lo == 0
            && edge_hi == 2147483647 && edge_lo == -2147483648
            && wide == 5000000000L && str_ok == 123
            && s64over == 0 && s64under == 0
            && s64max == 9223372036854775807L
            && s64min == -9223372036854775807L - 1;
        Console.WriteLine(ok ? "convert-overflow-ok: 1" : "convert-overflow-ok: 0");
    }
}
