using System;

interface IService {
    string Name();
    int Action();
}

class ServiceImpl : IService {
    string name;
    int id;

    public ServiceImpl(string name, int id) {
        this.name = name;
        this.id = id;
    }

    public string Name() {
        return this.name;
    }

    public int Action() {
        return this.id * 10;
    }
}

class ServiceConsumer {
    IService svc;

    public ServiceConsumer(IService svc) {
        this.svc = svc;
    }

    public int Execute() {
        if (this.svc == null) return -1;
        return this.svc.Action();
    }
}

class Program {
    static int Inspect(IService s) {
        if (s == null) return 0;
        return s.Action();
    }

    static void Main() {
        ServiceImpl impl = new ServiceImpl("auth", 5);
        ServiceConsumer consumer = new ServiceConsumer(impl);
        int res1 = consumer.Execute();
        int res2 = Inspect(impl);
        int res3 = Inspect(null);
        ServiceConsumer nullConsumer = new ServiceConsumer(null);
        int res4 = nullConsumer.Execute();

        Console.WriteLine(Convert.ToString(res1));
        Console.WriteLine(Convert.ToString(res2));
        Console.WriteLine(Convert.ToString(res3));
        Console.WriteLine(Convert.ToString(res4));
    }
}
