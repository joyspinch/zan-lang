// B-ID63：类→变型接口的协变/逆变转换（泛型类实例化携带替换后接口列表）。
// 修前：Box<Dog> -> IBox<Animal> 被 checker 误拒 E2024（实例化类型
// interface_count==0，derives 走查进不了接口方差分支）。
interface IBox<out T> {
    T Get();
    int Tag();
}
interface ICmp<in T> {
    int Cmp(T a, T b);
}
delegate T Factory<out T>();
delegate void Sink<in T>(T v);

class Animal {
    public int Legs() { return 4; }
}
class Dog : Animal {
    public int Bark() { return 7; }
}

class DogBox : IBox<Dog> {
    public Dog Get() { return new Dog(); }
    public int Tag() { return 1; }
}
class Box<T> : IBox<T> {
    T v;
    public Box(T v) { this.v = v; }
    public T Get() { return v; }
    public int Tag() { return 2; }
}
class AnimalCmp : ICmp<Animal> {
    public int Cmp(Animal a, Animal b) { return 11; }
}

class Program {
    static Dog MakeDog() { return new Dog(); }
    static void Eat(Animal a) { }

    static void Main() {
        Dog d = new Dog();
        // 泛型类→变型接口协变（本修主路径）
        IBox<Animal> up = new Box<Dog>(d);
        Console.WriteLine(up.Tag());
        Console.WriteLine(up.Get().Legs());

        // 非泛型类→变型接口协变
        IBox<Animal> up2 = new DogBox();
        Console.WriteLine(up2.Tag());

        // 接口→接口同符号协变（既有路径回归钉）
        IBox<Dog> b1 = new Box<Dog>(d);
        IBox<Animal> b2 = b1;
        Console.WriteLine(b2.Tag());

        // 逆变接口：ICmp<Animal> 用在 ICmp<Dog> 位
        AnimalCmp ac = new AnimalCmp();
        ICmp<Dog> dc = ac;
        Console.WriteLine(dc.Cmp(new Dog(), new Dog()));

        // 协变委托：方法组 Dog() -> Factory<Animal>
        Factory<Animal> f = MakeDog;
        Console.WriteLine(f().Legs());

        // 逆变委托：Eat(Animal) 用在 Sink<Dog> 位
        Sink<Dog> s = Eat;
        s(new Dog());
        Console.WriteLine("ok");
    }
}
