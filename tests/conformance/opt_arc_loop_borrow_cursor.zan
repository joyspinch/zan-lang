using System;
using System.Collections.Generic;

class CursorNode {
    public int Value;
    public CursorNode Next;
    public CursorNode(int value, CursorNode next) {
        Value = value;
        Next = next;
    }
}

class CursorWitness {
    public weak CursorNode Target;
}

class OptArcLoopBorrowCursor {
    static void Check(bool condition, string message) {
        if (!condition) { throw new Exception(message); }
    }

    static int SumPure(CursorNode head) {
        int sum = 0;
        CursorNode cur = head;
        while (cur != null) {
            sum += cur.Value;
            cur = cur.Next;
        }
        return sum;
    }

    static int FindEarly(CursorNode head, int target) {
        CursorNode cur = head;
        while (cur != null) {
            if (cur.Value == target) { return cur.Value * 10; }
            cur = cur.Next;
        }
        return -1;
    }

    static CursorNode FindEscaping(CursorNode head, int target) {
        CursorNode cur = head;
        while (cur != null) {
            if (cur.Value == target) { return cur; }
            cur = cur.Next;
        }
        return null;
    }

    // Mutates Next during traversal: ARC must NOT be elided here.
    static int UnlinkAndSum(CursorNode head) {
        int sum = 0;
        CursorNode cur = head;
        while (cur != null) {
            sum += cur.Value;
            CursorNode nxt = cur.Next;
            cur.Next = null;
            cur = nxt;
        }
        return sum;
    }

    static void ThrowWithTemp(int n) {
        string label = "tmp_" + n;
        if (n > 0) { throw new Exception(label); }
    }

    static void Main() {
        CursorNode head = null;
        for (int i = 1; i <= 1000; i = i + 1) {
            head = new CursorNode(i, head);
        }
        Check(SumPure(head) == 500500, "SumPure 1..1000");
        Check(FindEarly(head, 500) == 5000, "FindEarly hit");
        Check(FindEarly(head, 9999) == -1, "FindEarly miss");

        CursorNode escaped = FindEscaping(head, 42);
        Check(escaped != null && escaped.Value == 42, "FindEscaping hit");

        CursorWitness witness = new CursorWitness();
        witness.Target = escaped;
        head = null;
        Check(witness.Target != null && escaped.Value == 42, "escaped node kept alive after head dropped");
        escaped = null;
        Check(witness.Target == null, "escaped node released cleanly");

        CursorNode mutable = new CursorNode(1, new CursorNode(2, new CursorNode(3, null)));
        CursorWitness tailWitness = new CursorWitness();
        tailWitness.Target = mutable.Next.Next;
        Check(UnlinkAndSum(mutable) == 6, "UnlinkAndSum intact");
        mutable = null;
        Check(tailWitness.Target == null, "mutated chain released cleanly");

        var dynList = new List<object>();
        dynList.Add("dyn_" + 7);
        dynList.Add(new int[] { 4, 5, 6 });
        dynList.Add(new CursorNode(9, null));
        Check(dynList.Count == 3, "dynamic release slots populated");

        int caught = 0;
        try {
            ThrowWithTemp(3);
        } catch (Exception ex) {
            if (ex.Message == "tmp_3") { caught = 1; }
        }
        Check(caught == 1, "deferred EH cleanup works");

        Console.WriteLine("PASS opt_arc_loop_borrow_cursor");
    }
}
