using System;

class Program {
    static int Main() {
        // 1. AllocHGlobal, Read/Write primitives
        nint mem = Marshal.AllocHGlobal(64);
        Marshal.WriteByte(mem, 0, (byte)123);
        Marshal.WriteInt16(mem, 2, (short)12345);
        Marshal.WriteInt32(mem, 4, 123456789);
        Marshal.WriteInt64(mem, 8, 9876543210123L);
        Marshal.WriteIntPtr(mem, 16, (nint)556677);

        byte b = Marshal.ReadByte(mem, 0);
        short s = Marshal.ReadInt16(mem, 2);
        int i = Marshal.ReadInt32(mem, 4);
        long l = Marshal.ReadInt64(mem, 8);
        nint p = Marshal.ReadIntPtr(mem, 16);
        Console.WriteLine("Scalar: b=" + b + " s=" + s + " i=" + i + " l=" + l + " p=" + p);

        // 2. ReAllocHGlobal
        nint mem2 = Marshal.ReAllocHGlobal(mem, 128);
        byte b2 = Marshal.ReadByte(mem2, 0);
        int i2 = Marshal.ReadInt32(mem2, 4);
        Console.WriteLine("Realloc: b2=" + b2 + " i2=" + i2);
        Marshal.FreeHGlobal(mem2);

        // 3. Array Copy
        byte[] srcBytes = new byte[4];
        srcBytes[0] = 10; srcBytes[1] = 20; srcBytes[2] = 30; srcBytes[3] = 40;
        nint byteBuf = Marshal.AllocHGlobal(4);
        Marshal.Copy(srcBytes, 0, byteBuf, 4);

        byte[] dstBytes = new byte[4];
        Marshal.Copy(byteBuf, dstBytes, 0, 4);
        Marshal.FreeHGlobal(byteBuf);
        Console.WriteLine("CopyByte: " + dstBytes[0] + "," + dstBytes[1] + "," + dstBytes[2] + "," + dstBytes[3]);

        int[] srcInts = new int[3];
        srcInts[0] = 100; srcInts[1] = 200; srcInts[2] = 300;
        nint intBuf = Marshal.AllocHGlobal(12);
        Marshal.Copy(srcInts, 0, intBuf, 3);
        int[] dstInts = new int[3];
        Marshal.Copy(intBuf, dstInts, 0, 3);
        Marshal.FreeHGlobal(intBuf);
        Console.WriteLine("CopyInt: " + dstInts[0] + "," + dstInts[1] + "," + dstInts[2]);

        // 4. String marshalling
        string orig = "Hello, Zan Interop!";
        nint pAnsi = Marshal.StringToHGlobalAnsi(orig);
        string backAnsi = Marshal.PtrToStringAnsi(pAnsi);
        string subAnsi = Marshal.PtrToStringAnsi(pAnsi, 5);
        Marshal.FreeHGlobal(pAnsi);
        Console.WriteLine("Ansi: " + backAnsi + " | " + subAnsi);

        nint pUni = Marshal.StringToHGlobalUni(orig);
        string backUni = Marshal.PtrToStringUni(pUni);
        Marshal.ZeroFreeGlobalAllocUnicode(pUni);
        Console.WriteLine("Uni: " + backUni);

        // 5. Win32 error
        Marshal.SetLastWin32Error(42);
        int err = Marshal.GetLastWin32Error();
        Console.WriteLine("Error: " + err);

        return 0;
    }
}
