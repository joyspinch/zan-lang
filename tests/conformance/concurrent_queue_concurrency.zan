using System;
using System.Collections.Generic;
using System.Collections.Concurrent;
using System.Threading;

class Program {
    static async void Producer(ConcurrentQueue<int> q, int start, int count) {
        for (int i = 0; i < count; i = i + 1) {
            q.Enqueue(start + i);
        }
    }

    static async void Main() {
        ConcurrentQueue<int> q = new ConcurrentQueue<int>();

        // 基础压入与快照提取
        q.Enqueue(10);
        q.Enqueue(20);
        q.Enqueue(30);

        if (q.Count() != 3) {
            Console.WriteLine("FAIL: count not 3");
            return;
        }

        // 验证 ToArray 保持原队列状态且内容正确
        int[] arr = q.ToArray();
        if (arr.Length != 3 || arr[0] != 10 || arr[1] != 20 || arr[2] != 30) {
            Console.WriteLine("FAIL: ToArray contents incorrect");
            return;
        }
        if (q.Count() != 3) {
            Console.WriteLine("FAIL: count mutated after ToArray");
            return;
        }

        // 并发生产测试
        for (int p = 0; p < 5; p = p + 1) {
            Program.Producer(q, p * 100, 20);
        }

        await Task.Delay(50);

        int totalCount = q.Count();
        if (totalCount != 103) { // 3 + 5 * 20
            Console.WriteLine("FAIL: total count mismatch: " + Convert.ToString(totalCount));
            return;
        }

        int[] bigArr = q.ToArray();
        if (bigArr.Length != 103) {
            Console.WriteLine("FAIL: bigArr length mismatch: " + Convert.ToString(bigArr.Length));
            return;
        }

        // 出队并校验 FIFO 顺序前三项
        int v;
        if (!q.TryDequeue(out v) || v != 10) {
            Console.WriteLine("FAIL: Dequeue 1 failed");
            return;
        }
        if (!q.TryDequeue(out v) || v != 20) {
            Console.WriteLine("FAIL: Dequeue 2 failed");
            return;
        }
        if (!q.TryDequeue(out v) || v != 30) {
            Console.WriteLine("FAIL: Dequeue 3 failed");
            return;
        }

        Console.WriteLine("PASS: concurrent queue toarray and fifo ok");
    }
}
