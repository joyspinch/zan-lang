// Conformance: the LEGAL shapes of signed/unsigned integer mixing.
// Comparisons against a non-negative constant literal on
// the signed side stay implicit (C# implicit constant conversion), uint
// widens to ulong value-preserving, and same-signedness pairs are untouched.
// The illegal shapes (var-vs-var, negative constant) are covered by
// diag_mixed_sign_compare.
using System;

class Program {
    static void Main() {
        ulong u = 3;
        Console.WriteLine((u > 0).ToString());
        Console.WriteLine((u == 3).ToString());
        uint w = 2;
        Console.WriteLine((u > w).ToString());
        long a = -1;
        long b = 1;
        Console.WriteLine((a < b).ToString());
        int i = 7;
        Console.WriteLine((a < i).ToString());
        Console.WriteLine((i == 7).ToString());
    }
}
