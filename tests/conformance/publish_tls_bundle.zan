using System;
using System.Net.Tls;

/* A47-1 step 1: pin the --publish driver-bundle copy for a Tls program.
 * zanc discovers stdlib/System/Net/Tls/drivers/ on its own (no --driver-dir
 * override here), links the real OpenSSL shared libraries, and on --publish
 * must copy them (libssl-3-x64.dll / libcrypto-3-x64.dll and friends) next
 * to the exe. The assertion is behavioral: the published exe starts and
 * TlsContext.CreateClient() hands back a usable context, which is only
 * possible when the bundled DLLs actually loaded. A broken bundle copy
 * leaves the exe unable to start (DLL not found) and fails this case. */
class Program {
    static void Main() {
        TlsContext ctx = TlsContext.CreateClient();
        Console.WriteLine("ctx_ok=" + (ctx != null ? 1 : 0));
        Console.WriteLine("OK");
    }
}
