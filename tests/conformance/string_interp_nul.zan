// 核心契约与语义定义。
// 核心契约与语义定义。
using System;
namespace Conformance;
class Program {
    static byte[] Raw3() {
        byte[] raw = new byte[3];
        raw[0] = (byte)'a'; raw[1] = 0; raw[2] = (byte)'b';
        return raw;
    }
    static void Show(string j) {
        string hex = "";
        for (int i = 0; i < j.Length; i++) {
            if (i > 0) hex += " ";
            hex += $"{(int)(byte)j[i]:x2}";
        }
        Console.WriteLine("len=" + j.Length + " hex=" + hex);
    }
    static int Main() {
        string nul = Raw3();
        Console.WriteLine("raw=" + nul.Length);
        Show($"v={nul};");
        string plain = "AB\0CD";
        Show($"[{plain}]");
        Show($"{1}a\0b{2}");
        return 0;
    }
}
