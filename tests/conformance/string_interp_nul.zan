// Conformance: string interpolation must assemble parts by their exact
// managed lengths. A hole holding an embedded NUL (a zero-copy byte[] view
// or a managed literal) used to be copied with strcpy/strcat, which stop at
// the first NUL while the stamped result length still counted the whole
// part: bytes after the NUL were lost and garbage grew in their place.
// (B-ID61; the assembly now memcpys each part, same family as the `+`
// concat fix.)
using System;
namespace Conformance;
class Program {
    static byte[] Raw3() {
        byte[] raw = new byte[3];
        raw[0] = (byte)'a'; raw[1] = 0; raw[2] = (byte)'b';
        return raw;
    }
    static void Show(string j) {
        string hex = "";
        for (int i = 0; i < j.Length; i++) {
            if (i > 0) hex += " ";
            hex += $"{(int)(byte)j[i]:x2}";
        }
        Console.WriteLine("len=" + j.Length + " hex=" + hex);
    }
    static int Main() {
        string nul = Raw3();
        Console.WriteLine("raw=" + nul.Length);
        Show($"v={nul};");
        string plain = "AB\0CD";
        Show($"[{plain}]");
        Show($"{1}a\0b{2}");
        return 0;
    }
}
