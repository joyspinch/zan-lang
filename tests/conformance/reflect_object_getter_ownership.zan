using System;

class ReflectOwnedPayload {
    public int Value = 42;
}

class ReflectOwnedHolder {
    public ReflectOwnedPayload Stored = new ReflectOwnedPayload();
    public object ObjectValue { get { return Stored; } }
    public ReflectOwnedPayload ClassValue { get { return Stored; } }
    public object Self { get { return this; } }
    public string Text = "payload-" + "owned";
    public string StringValue { get { return Text; } }
    public string FreshString { get { return "fresh-" + Text; } }
    public string NullString { get { return null; } }
    public object NullObject { get { return null; } }
}

class ReflectOwnedWitness {
    public weak ReflectOwnedHolder Holder;
    public weak ReflectOwnedPayload Payload;
}

class Program {
    static void Check(bool condition, string message) {
        if (!condition) { throw new Exception(message); }
    }

    static void DropDirect(ReflectOwnedWitness witness) {
        ReflectOwnedHolder holder = new ReflectOwnedHolder();
        witness.Holder = holder; witness.Payload = holder.Stored;
        object value = holder.ObjectValue;
        Check(value == holder.Stored, "direct object getter returns its payload");
    }

    static void DropReflected(ReflectOwnedWitness witness, string member) {
        ReflectOwnedHolder holder = new ReflectOwnedHolder();
        witness.Holder = holder; witness.Payload = holder.Stored;
        object target = holder;
        object value = target.GetFieldObject(member);
        Check(value == holder.Stored && ((ReflectOwnedPayload)value).Value == 42,
            "reflected field/getter returns its payload");
    }

    static void DropSelf(ReflectOwnedWitness witness) {
        ReflectOwnedHolder holder = new ReflectOwnedHolder();
        witness.Holder = holder; witness.Payload = holder.Stored;
        object target = holder;
        object value = target.GetFieldObject("Self");
        Check(value == holder, "reflected self getter preserves identity");
    }

    static string ReadString(ReflectOwnedWitness witness, string member) {
        ReflectOwnedHolder holder = new ReflectOwnedHolder();
        witness.Holder = holder; witness.Payload = holder.Stored;
        object target = holder;
        return target.GetFieldString(member);
    }

    static object ReadStringObject(ReflectOwnedWitness witness, string member) {
        ReflectOwnedHolder holder = new ReflectOwnedHolder();
        witness.Holder = holder; witness.Payload = holder.Stored;
        object target = holder;
        return target.GetFieldObject(member);
    }

    static void CheckString(ReflectOwnedWitness witness, string member, string expected) {
        string value = ReadString(witness, member);
        Check(witness.Holder == null && witness.Payload == null,
            "reflected string read releases its owner");
        Check(value == expected, "reflected string survives its owner");
    }

    static void CheckStringObject(ReflectOwnedWitness witness, string member, string expected) {
        object value = ReadStringObject(witness, member);
        Check(witness.Holder == null && witness.Payload == null,
            "reflected object string read releases its owner");
        Check((string)value == expected, "reflected object string survives its owner");
    }

    static void Main() {
        ReflectOwnedWitness witness = new ReflectOwnedWitness();
        DropDirect(witness);
        Check(witness.Holder == null && witness.Payload == null, "direct getter releases owner and payload");
        Console.WriteLine("direct getter ownership OK");
        DropReflected(witness, "Stored");
        Check(witness.Holder == null && witness.Payload == null, "reflected field releases owner and payload");
        Console.WriteLine("reflected field ownership OK");
        DropReflected(witness, "ObjectValue");
        Check(witness.Holder == null && witness.Payload == null, "reflected object getter releases owner and payload");
        Console.WriteLine("reflected object getter ownership OK");
        DropReflected(witness, "ClassValue");
        Check(witness.Holder == null && witness.Payload == null, "reflected class getter releases owner and payload");
        Console.WriteLine("reflected class getter ownership OK");
        DropSelf(witness);
        Check(witness.Holder == null && witness.Payload == null, "reflected self getter releases owner and payload");
        Console.WriteLine("reflected self getter ownership OK");
        CheckString(witness, "Text", "payload-owned");
        CheckString(witness, "StringValue", "payload-owned");
        CheckString(witness, "FreshString", "fresh-payload-owned");
        CheckString(witness, "NullString", null);
        Console.WriteLine("reflected string field/getter ownership OK");
        CheckStringObject(witness, "Text", "payload-owned");
        CheckStringObject(witness, "StringValue", "payload-owned");
        CheckStringObject(witness, "FreshString", "fresh-payload-owned");
        Check(ReadStringObject(witness, "NullString") == null,
            "object getter preserves null string");
        Check(ReadStringObject(witness, "NullObject") == null,
            "object getter preserves null object");
        Console.WriteLine("reflected object string field/getter ownership OK");
    }
}
