// op_call with a params tail: an empty call `f()` binds the zero-argument
// params overload and packs an empty List; a non-empty call packs the tail.
// Regression for a compiler crash (args[-1] read) when the params overload's
// fixed-parameter count underflowed to -1 for a zero-argument call, and for
// instance op_call receivers whose params start without an explicit `self`.
using System;

class StaticCallee {
    public int N;
    static int op_call(StaticCallee self, params double[] args) { return self.N; }
}

class StaticMulti {
    public int Base;
    static int op_call(StaticMulti self, double scale, params long[] args) { return self.Base; }
}

class InstanceCallee {
    public int N;
    int op_call(params double[] args) { return N; }
}

class Prog {
    static void Main() {
        int bad = 0;
        StaticCallee sc = new StaticCallee();
        sc.N = 4;
        if (sc() != 4) { bad = bad + 1; }
        if (sc(1.0, 2.5) != 4) { bad = bad + 1; }

        StaticMulti sm = new StaticMulti();
        sm.Base = 2;
        if (sm(3.0) != 2) { bad = bad + 1; }
        if (sm(3.0, 7L, 9L) != 2) { bad = bad + 1; }

        InstanceCallee ic = new InstanceCallee();
        ic.N = 6;
        if (ic() != 6) { bad = bad + 1; }
        if (ic(8.5) != 6) { bad = bad + 1; }

        Console.WriteLine("opcall-params-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
