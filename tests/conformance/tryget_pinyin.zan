using System;
using System.Text;

/// Dictionary.TryGetValue (string and int values, hit/miss, inline `out T x`)
/// and System.Text.Pinyin (hanzi -> pinyin, initials, pass-through).
class Program {
    static int bad;

    static void Check(bool ok, string label) {
        if (!ok) { Console.WriteLine("FAIL " + label); bad = bad + 1; }
    }

    static void Main() {
        // ---- Dictionary.TryGetValue ----
        Dictionary<string, string> d = new Dictionary<string, string>();
        d["啊"] = "a";
        d["中"] = "zhong";
        string v = "unset";
        Check(d.TryGetValue("啊", v), "tryget hit");
        Check(v == "a", "tryget hit value");
        Check(!d.TryGetValue("不在", v), "tryget miss");
        Check(v == "a", "tryget miss keeps value");
        Check(d.TryGetValue("中", out string w), "tryget inline out");
        Check(w == "zhong", "tryget inline out value");

        Dictionary<string, int> di = new Dictionary<string, int>();
        di["k1"] = 42;
        int iv = -1;
        Check(di.TryGetValue("k1", iv), "tryget int hit");
        Check(iv == 42, "tryget int value");
        Check(!di.TryGetValue("nope", iv), "tryget int miss");
        Check(iv == 42, "tryget int miss keeps value");

        // ARC: value read out of the dict must survive the dict's lifetime.
        Dictionary<string, string> d2 = new Dictionary<string, string>();
        d2["key"] = "survives";
        string keep;
        Check(d2.TryGetValue("key", out keep), "tryget out keep");
        d2.Clear();
        Check(keep == "survives", "tryget value survives clear");

        // ---- Pinyin ----
        Check(Pinyin.ToPinyin("中文") == "zhongwen", "pinyin hanzi");
        Check(Pinyin.Initials("中文") == "ZW", "pinyin initials");
        Check(Pinyin.ToPinyin("Zan 语言") == "Zan yuyan", "pinyin mixed");
        Check(Pinyin.Initials("hello 世界") == "hello SJ", "pinyin initials mixed");
        Check(Pinyin.ToPinyinChar("中") == "zhong", "pinyin char");
        Check(Pinyin.ToPinyinChar("z") == "", "pinyin non-hanzi");
        Check(Pinyin.ToPinyin("我爱编程") == "woaibiancheng", "pinyin sentence");
        Check(Pinyin.Initials("中华人民共和国") == "ZHRMGHG", "pinyin long initials");
        Check(Pinyin.ToPinyin("啊") == "a", "pinyin a");

        Console.WriteLine("tryget-pinyin-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
