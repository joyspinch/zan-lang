using System;

// The C host folds `Math.PI` into a compile-time double constant
// (src/compiler/irgen_expr.c) and lowers `Cpu.HasXxx` /
// `Cpu.CpuFeature(id)` to its compiler-internal feature probe, which on a
// native build reports no feature at all. The self-host has to answer
// exactly the same -- with the same digits for PI and the same "no" for
// every feature.
class Program {
    static void Main() {
        Console.WriteLine("pi=" + Math.PI);
        Console.WriteLine("halfpi=" + (Math.PI / 2.0));
        Console.WriteLine("popcnt=" + Cpu.HasPopcnt);
        Console.WriteLine("lzcnt=" + Cpu.HasLzcnt);
        Console.WriteLine("sse42=" + Cpu.HasSse42);
        Console.WriteLine("avx2=" + Cpu.HasAvx2);
        Console.WriteLine("aesni=" + Cpu.HasAesNi);
        Console.WriteLine("neon=" + Cpu.HasNeon);
        Console.WriteLine("feat3=" + Cpu.CpuFeature(3));
    }
}
