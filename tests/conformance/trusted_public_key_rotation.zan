using System;
using System.Security.Cryptography;
using Security.Commercial;
using AppUpdate;

// OpenSSL-generated public-only fixtures. All messages identify a synthetic device
// and product; temporary private keys were destroyed after independent verification.
class Program {
    static void Check(bool ok, string name) {
        if (!ok) { Console.WriteLine("FAIL: " + name); Environment.Exit(1); }
    }
    static string KeyA() { return ":010001"; }
    static string PemA() { return "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA1ttCiQNGd89+e+g3BDrN\nJH/pW+g2KxoZuklvSLIi+FPjXRnArrwU5TqJ6AFyqpkA1qiTSYIL0cNndKmrhRd7\no55uvfe3cbUcnjFzbEDWr3/CxLRVeEl5q6YtlS9H5Cl0YBrUsB1X7EqSB7TaluNO\nSQUgB4Lc6XlIzQG4xpjxkxEqaJNQYRtkPcnvdzDWdx8l6LcrnYi2xRS2reixIX5D\n3VJyG7XLBgwQajLP9H60ICmSuSBuVxXcoe/C55hvWRyUbCRGvJb3zycFIy53Bf5b\nYgMyKKrvtfVmIWbxcFqS/U2EJp/pUXzEHa+pjwG54ujQobWZQs/onj3zRzAkEXbq\n3wIDAQAB\n-----END PUBLIC KEY-----\n"; }
    static string ArtifactA() { return ""; }
    static string CertificateA() { return ""; }
    static string ManifestA() { return ""; }
    static string KeyB() { return ":010001"; }
    static string PemB() { return "-----BEGIN PUBLIC KEY-----\nMIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEAnhwPswh5fIk+MVKyzrTI\nZdB/lXfXwRqqgNhC4YFMDGtIM81IlAZarWtoGnE9s55l55yZK+Ywm8iQST409drQ\nqOvCh+AjmbeacOicMtw0IJDhOpGwP3X8QMLWCNzA7zN6mgVcmXIQImNQ5oGM+x/X\n5/+VgqFxrp5mLZw6s+OGRgXg7qWnCGEKHeAl+gWHUtLtWtqBY2z+jigAEl2dASmR\nH53hMq7to8z3gKPQgyVFIeOOEVKeUvbVyiTCcuKH6ckRTBVTA2ptzPobZFpuyOZg\n3sdvte6cX47xUzi9+yO8kJdVG5xePgSylaHDsm6V2lDeZfnKRT10YLJqi0XvQJxj\n71oIeXysp9GOMjsS7PsJMOWyCLtINSmwjkfvxkIV6yzTqRcKpVyQrez3mGOmERwg\n2oQ0KQ1hMy7kcuAnC93980oP37r9faRWTm+ZF/t3PbG+Kgj+3CDiq+ruQnv3SJst\n3T8Q6yBtfV1CmHMcUdgBmElUPrTCXsTCVT9QPmdTRRBcz9QI6GXQ6mlBgEdvL5bz\nP+tWHmQoJ+gSmtbrGaCPRfCs9h8Xj859et4cHDywzgWZNc9KXU+oqG++cLz8yyOY\nEmOKp2+F+AdmTJXuxbaPWTRZQfPhzKoxp+DuMbcvB6rKPV2+H0SOPKy5cdfm25/7\noAAn7ZMBAr6EhLSXuVLYcgECAwEAAQ==\n-----END PUBLIC KEY-----\n"; }
    static string ArtifactB() { return ""; }
    static string CertificateB() { return ""; }
    static string ManifestB() { return ""; }
    static string KeyC() { return ":010001"; }
    static string PemC() { return "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA3y/LHXUDXdI56VDXwvgQ\nrJCnaKMl5CkaLGCK9PDnpSySoNNRH0nrbg/6DiVlew2uYQJN6C+hhGes1XMD6Jvu\nasFYJxMCWrkEjqLvNhnlNGzl3vdKSvmPlnmdYHeTq8HK4nPi2nRORIlJDKjQztmR\nUwgEeJzkCZx9PeV9wubaBqbJA3wcgjBi1M06veLnrxs7ybc3odVvOI4Ks47xAGFD\nb5WJYU5QUxVxvRKaPAb9ARqG3YNw41T6IxSo0rqA1EAsr1L/kiCOuxrCv/U9wLhA\nVvMA8lKDkpfSKcoTEiQS+EYRgKiCleK+rSkTsbaqTbFGiQIdRhavnqtltSy3wCKn\nTwIDAQAB\n-----END PUBLIC KEY-----\n"; }
    static string ArtifactC() { return ""; }
    static string CertificateC() { return ""; }
    static string ManifestC() { return ""; }
    static UpdateManifest Manifest(string signature) {
        UpdateManifest m = UpdateManifest.Parse("{\"appName\":\"RotationFixture\",\"version\":\"1.0.0\",\"releaseDate\":\"\",\"packageUrl\":\"\",\"packageSize\":1,\"packageMd5\":\"\",\"packageSha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"changelog\":\"\",\"files\":[{\"path\":\"app.bin\",\"size\":1,\"md5\":\"\",\"sha256\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"required\":true}],\"signature\":\"\"}");
        Check(m != null, "manifest fixture parses");
        m.SetSignature(signature);
        return m;
    }
    static string Der(int tag, string content) {
        int length = content.Length / 2;
        byte[] header = new byte[4];
        header[0] = (byte)tag;
        int count = 2;
        if (length < 128) { header[1] = (byte)length; }
        else if (length < 256) { header[1] = 129; header[2] = (byte)length; count = 3; }
        else { header[1] = 130; header[2] = (byte)(length >> 8); header[3] = (byte)(length & 255); count = 4; }
        return Hex.Encode(header, count) + content;
    }
    static string PemDer(string der, bool pkcs1) {
        string label = pkcs1 ? "RSA PUBLIC KEY" : "PUBLIC KEY";
        return "-----BEGIN " + label + "-----\n" + Base64.Encode(Hex.Decode(der), der.Length / 2)
            + "\n-----END " + label + "-----\n";
    }
    static void CompleteDerContract() {
        string n = KeyA().Substring(0, 512);
        string integers = Der(2, "00" + n) + Der(2, "010001");
        string pkcs1 = Der(48, integers);
        string extra = Der(2, "01");
        string algorithm = "300d06092a864886f70d0101010500";
        string spki = Der(48, algorithm + Der(3, "00" + pkcs1));
        Check(TrustedRsaKeys.FromPemBundle(PemDer(pkcs1, true)) == KeyA(), "complete PKCS1 public key accepted");
        Check(TrustedRsaKeys.FromPemBundle(PemDer(spki, false)) == KeyA(), "complete SPKI public key accepted");
        string internalTail = PemDer(Der(48, integers + extra), true);
        Check(TrustedRsaKeys.FromPemBundle(internalTail) == "", "PKCS1 internal third INTEGER rejected");
        Check(TrustedRsaKeys.FromPemBundle(PemDer(pkcs1 + extra, true)) == "", "PKCS1 external DER tail rejected");
        Check(TrustedRsaKeys.FromPemBundle(PemDer(Der(48, algorithm + Der(3, "00" + pkcs1) + extra), false)) == "", "SPKI outer internal tail rejected");
        Check(TrustedRsaKeys.FromPemBundle(PemDer(spki + extra, false)) == "", "SPKI external DER tail rejected");
        Check(TrustedRsaKeys.FromPemBundle(PemDer(Der(48, algorithm + Der(3, "00" + Der(48, integers + extra))), false)) == "", "SPKI nested PKCS1 third INTEGER rejected");
        Check(TrustedRsaKeys.FromPemBundle(PemDer(Der(48, algorithm + Der(3, "00" + pkcs1 + extra)), false)) == "", "SPKI BIT STRING nested external tail rejected");
        string badAlgorithm = Der(48, "06092a864886f70d0101010500" + extra);
        Check(TrustedRsaKeys.FromPemBundle(PemDer(Der(48, badAlgorithm + Der(3, "00" + pkcs1)), false)) == "", "SPKI algorithm trailing material rejected");
        Check(TrustedRsaKeys.FromPemBundle(PemDer(Der(48, algorithm + Der(3, "01" + pkcs1)), false)) == "", "SPKI unused bits rejected");
        Check(TrustedRsaKeys.FromPemBundle(PemDer(pkcs1, false)) == "", "public PEM label requires SPKI structure");
        Check(TrustedRsaKeys.FromPemBundle(PemA() + internalTail) == "", "valid anchor plus malformed DER clears complete set");
        AppUpdater.SetTrustedSignerPemBundle(PemA());
        Check(!AppUpdater.SetTrustedSignerPemBundle(PemA() + internalTail)
            && !AppUpdater.VerifyManifestSignature(Manifest(ManifestA()), null), "malformed DER replacement clears update trust");
        LicenseClient client = new LicenseClient();
        LicenseState state = new LicenseState();
        state.product = "RotationFixture"; state.deviceFp = "fixture-device";
        state.subject = "fixture-subject"; state.expiresAt = 1893456000L; state.certSig = CertificateA();
        client.state = state;
        Check(client.VendorPublicKeyPemBundle(PemA()) && client.SignedCertOk(), "valid DER certificate anchor control");
        Check(!client.VendorPublicKeyPemBundle(PemA() + internalTail) && !client.SignedCertOk(), "malformed DER replacement clears certificate trust");
    }
    static void Main() {
        CompleteDerContract();
        string a = KeyA(); string b = KeyB(); string c = KeyC();
        string ab = a + "\n" + b;
        string message = "widget\n1.2.3\n0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
        Check(TrustedRsaKeys.VerifyBase64(a, message, ArtifactA()), "A-only accepts A");
        Check(!TrustedRsaKeys.VerifyBase64(a, message, ArtifactB()), "A-only rejects B4096");
        Check(TrustedRsaKeys.VerifyBase64(ab, message, ArtifactA()) && TrustedRsaKeys.VerifyBase64(ab, message, ArtifactB()), "overlap verifies both key lengths");
        Check(!TrustedRsaKeys.VerifyBase64(b, message, ArtifactA()) && TrustedRsaKeys.VerifyBase64(b, message, ArtifactB()), "B-only revokes A");
        Check(!TrustedRsaKeys.VerifyBase64(ab, message, ArtifactC()), "unknown C rejected");
        Check(!TrustedRsaKeys.VerifyBase64(ab, message + "x", ArtifactB()), "artifact tamper rejected");
        Check(TrustedRsaKeys.FromPemBundle(PemA() + PemB()) == ab, "PEM serializes all anchors");
        Check(TrustedRsaKeys.FromHex(ab.ToUpper()) == ab, "hex canonical snapshot");
        Check(TrustedRsaKeys.FromHex(a + "\ninvalid") == "", "invalid tail invalidates all");
        Check(!TrustedRsaKeys.VerifyBase64(a + "\ninvalid", message, ArtifactA()), "valid first key cannot mask invalid tail");
        Check(TrustedRsaKeys.FromHex(a + "\n" + a) == "", "duplicate anchors rejected");
        string six = a + "\n" + b + "\n" + c + "\n" + a + "\n" + b + "\n" + c;
        Check(TrustedRsaKeys.FromHex(six) == "", "more than five rejected");
        Check(TrustedRsaKeys.FromPemBundle(PemA() + "unknown") == "", "PEM trailing unknown rejected");
        Check(TrustedRsaKeys.FromPemBundle(PemA() + "-----BEGIN PRIVATE KEY-----\nAA==\n-----END PRIVATE KEY-----") == "", "mixed private material rejected");
        Check(TrustedRsaKeys.FromPemBundle(PemA() + PemA()) == "", "duplicate PEM rejected");
        Check(TrustedRsaKeys.FromPemBundle(PemA() + PemB() + PemC() + PemA() + PemB() + PemC()) == "", "oversized PEM set rejected");
        Check(TrustedRsaKeys.Single(a.Substring(0, 512), "00") == "", "zero exponent rejected");
        Check(TrustedRsaKeys.Single(a.Substring(0, 512), "02") == "", "even exponent rejected");
        Check(TrustedRsaKeys.Single(a.Substring(0, 512), "0003") == "", "noncanonical exponent rejected");
        Check(TrustedRsaKeys.Single("00" + a.Substring(2, 510), "010001") == "", "noncanonical modulus rejected");
        Check(TrustedRsaKeys.Single("zz" + a.Substring(2, 510), "010001") == "", "invalid hex rejected");
        UpdateManifest ma = Manifest(ManifestA()); UpdateManifest mb = Manifest(ManifestB());
        Check(ma.SigningPayload() == mb.SigningPayload(), "manifest canonical payload unchanged");
        AppUpdater.SetTrustedSigner(a.Substring(0, 512), "010001");
        Check(AppUpdater.VerifyManifestSignature(ma, null) && !AppUpdater.VerifyManifestSignature(mb, null), "update A-only");
        Check(AppUpdater.SetTrustedSigners(ab), "update overlap config");
        Check(AppUpdater.VerifyManifestSignature(ma, null) && AppUpdater.VerifyManifestSignature(mb, null), "update overlap");
        Check(AppUpdater.SetTrustedSignerPemBundle(PemA() + PemB()), "update PEM snapshot");
        Check(AppUpdater.VerifyManifestSignature(mb, null), "update serialized B4096");
        Check(AppUpdater.SetTrustedSigners(b), "update B-only config");
        Check(!AppUpdater.VerifyManifestSignature(ma, null) && AppUpdater.VerifyManifestSignature(mb, null), "update B-only");
        Check(!AppUpdater.VerifyManifestSignature(Manifest(ManifestC()), null), "update C rejected");
        mb.changelog = "tampered"; Check(!AppUpdater.VerifyManifestSignature(mb, null), "manifest tamper");
        Check(!AppUpdater.SetTrustedSigners(ab + "\nbad") && !AppUpdater.VerifyManifestSignature(ma, null), "update invalid clears all");
        AppUpdater.SetTrustedSigners(ab); AppUpdater.SetTrustedSigner(a.Substring(0, 512), "010001");
        Check(!AppUpdater.VerifyManifestSignature(Manifest(ManifestB()), null), "update singleton clears previous keys");
        AppUpdater.SetTrustedSigners(ab); AppUpdater.SetTrustedSigner("bad", "010001");
        Check(!AppUpdater.VerifyManifestSignature(ma, null), "update invalid singleton clears trust");
        LicenseClient client = new LicenseClient(); LicenseState state = new LicenseState();
        state.product = "RotationFixture"; state.deviceFp = "fixture-device";
        state.subject = "fixture-subject"; state.expiresAt = 1893456000L; state.certSig = CertificateA(); client.state = state;
        Check(LicenseClient.CertCanonical(state.product, state.deviceFp, state.subject, state.expiresAt) == "zan-cert-v1|RotationFixture|fixture-device|fixture-subject|1893456000", "certificate canonical unchanged");
        client.VendorPublicKey(a.Substring(0, 512), "010001"); Check(client.SignedCertOk(), "certificate A-only");
        state.certSig = CertificateB(); Check(!client.SignedCertOk(), "certificate A-only rejects B");
        Check(client.VendorPublicKeys(ab) && client.SignedCertOk(), "certificate B4096 overlap");
        state.certSig = CertificateA(); Check(client.SignedCertOk(), "certificate A overlap");
        Check(client.VendorPublicKeyPemBundle(PemA() + PemB()) && client.SignedCertOk(), "certificate PEM snapshot");
        Check(client.VendorPublicKeys(b) && !client.SignedCertOk(), "certificate B-only revokes A");
        state.certSig = CertificateB(); Check(client.SignedCertOk(), "certificate B-only accepts B");
        state.certSig = CertificateC(); Check(!client.SignedCertOk(), "certificate unknown C");
        state.certSig = CertificateB(); state.subject = "tampered"; Check(!client.SignedCertOk(), "certificate tamper"); state.subject = "fixture-subject";
        client.VendorPublicKeys(ab); client.VendorPublicKey(a.Substring(0, 512), "010001"); Check(!client.SignedCertOk(), "certificate singleton clears B");
        client.VendorPublicKeys(ab); client.VendorPublicKey("bad", "010001"); state.certSig = CertificateA(); Check(!client.SignedCertOk(), "certificate invalid singleton clears all");
        client.VendorPublicKeys(ab); Check(!client.VendorPublicKeys(six) && !client.SignedCertOk(), "certificate oversized set clears all");
        client.VendorPublicKeys(ab); Check(!client.VendorPublicKeyPemBundle(PemA() + "bad") && !client.SignedCertOk(), "certificate invalid PEM clears all");
        Console.WriteLine("trusted public key rotation passed");
    }
}
