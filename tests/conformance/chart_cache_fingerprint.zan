using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

/// 缓存指纹的纯核心（FingerprintCore）在数据、可见性、主题代、
/// dataZoom 状态、专用数据、窗口和动画上的敏感性。同一输入
/// 必须产生同一指纹；任何会改变像素的输入变化必须改变指纹。
class Program {
    static ChartOption Base() {
        ChartOption o = ChartOption.Of("FP", new List<string>{"A", "B"},
            new List<ChartSeries>{
                ChartSeries.Line("L", new List<int>{1, 2}),
                ChartSeries.Bar("B", new List<int>{3, 4}),
            });
        o.animate = false;
        return o;
    }

    static int Fp(ChartOption o, int themeGen, int zoomLo, int zoomHi) {
        ResolvedChart resolved = ResolvedChart.Resolve(o, Theme.Light(), null, 77);
        return ChartView.FingerprintCore(themeGen, zoomLo, zoomHi, o, resolved);
    }

    static void Main() {
        ChartOption base1 = Base();
        ChartOption base2 = Base();

        // 同一输入 -> 同一指纹；确定性。
        Console.WriteLine(Convert.ToString(Fp(base1, 100, 0, 0) == Fp(base2, 100, 0, 0)));

        // 主题代变化 -> 指纹变化。
        Console.WriteLine(Convert.ToString(Fp(base1, 100, 0, 0) != Fp(base1, 101, 0, 0)));

        // 数据变化 -> 指纹变化。
        base2.series[0].data[0].number = 99.0;
        Console.WriteLine(Convert.ToString(Fp(base1, 100, 0, 0) != Fp(base2, 100, 0, 0)));

        // 可见性变化（series.hidden / ResolvedChart 读取它）-> 指纹变化。
        ChartOption hidden = Base();
        hidden.series[1].hidden = true;
        Console.WriteLine(Convert.ToString(Fp(base1, 100, 0, 0) != Fp(hidden, 100, 0, 0)));

        // dataZoom 状态变化（仅当 zoom 开启时进入指纹）-> 指纹变化。
        ChartOption zoomed = Base();
        zoomed.zoom = true;
        zoomed.zoomStart = 0;
        zoomed.zoomEnd = 50;
        Console.WriteLine(Convert.ToString(Fp(zoomed, 100, 20, 60) != Fp(zoomed, 100, 30, 70)));

        // 窗口变化 -> 指纹变化（zoomStart/zoomEnd 直接混入）。
        ChartOption win = Base();
        win.zoomStart = 10;
        Console.WriteLine(Convert.ToString(Fp(base1, 100, 0, 0) != Fp(win, 100, 0, 0)));

        // 动画标志 -> 指纹变化。
        ChartOption anim = Base();
        anim.animate = true;
        Console.WriteLine(Convert.ToString(Fp(base1, 100, 0, 0) != Fp(anim, 100, 0, 0)));

        // 专用数据（links）-> 指纹变化。
        ChartOption links = Base();
        links.series[0].links.Add(ChartLink.Of("A", "B", 5));
        Console.WriteLine(Convert.ToString(Fp(base1, 100, 0, 0) != Fp(links, 100, 0, 0)));

        // 专用数据（marks、regions、events）-> 指纹变化。
        ChartOption marks = Base();
        marks.series[0].marks.Add(ChartMarkPoint.Max());
        Console.WriteLine(Convert.ToString(Fp(base1, 100, 0, 0) != Fp(marks, 100, 0, 0)));

        ChartOption regions = Base();
        regions.series[0].regions.Add(ChartMapRegion.Of("R", 3,
            new List<ChartMapRing>{ ChartMapRing.Of(
                new List<ChartMapPoint>{ ChartMapPoint.Of(0, 0), ChartMapPoint.Of(4, 0), ChartMapPoint.Of(4, 4) }, false) }));
        Console.WriteLine(Convert.ToString(Fp(base1, 100, 0, 0) != Fp(regions, 100, 0, 0)));

        ChartOption events = Base();
        events.series[0].events.Add(ChartEvent.Of("E", 1, 2, 3));
        Console.WriteLine(Convert.ToString(Fp(base1, 100, 0, 0) != Fp(events, 100, 0, 0)));

        // radarMax 列表 -> 指纹变化。
        ChartOption radar = Base();
        radar.radarMax.Add(50);
        Console.WriteLine(Convert.ToString(Fp(base1, 100, 0, 0) != Fp(radar, 100, 0, 0)));

        // gauge 字段 -> 指纹变化。
        ChartOption gauge = Base();
        gauge.gaugeMax = 200;
        Console.WriteLine(Convert.ToString(Fp(base1, 100, 0, 0) != Fp(gauge, 100, 0, 0)));

        // wid 变化 -> 指纹变化（不同视图槽位共享同一 option）。
        ChartOption same = Base();
        ResolvedChart r1 = ResolvedChart.Resolve(same, Theme.Light(), null, 77);
        ResolvedChart r2 = ResolvedChart.Resolve(same, Theme.Light(), null, 78);
        Console.WriteLine(Convert.ToString(
            ChartView.FingerprintCore(100, 0, 0, same, r1)
            != ChartView.FingerprintCore(100, 0, 0, same, r2)));
    }
}
