// Keep enough managed strings alive to grow every rt_mem registry stripe.
// Static musl calloc may call wrapped malloc; registry metadata freed through
// native free must therefore be allocated through native malloc as well.
using System;
using System.Collections.Generic;

class Program {
    static void GrowAndRelease() {
        List<string> values = new List<string>();
        for (int i = 0; i < 100000; i++) {
            values.Add(Convert.ToString(i));
        }
        if (values.Count != 100000) {
            throw new Exception("registry growth lost retained strings");
        }
        for (int i = 0; i < values.Count; i++) {
            if (values[i] != Convert.ToString(i)) {
                throw new Exception("registry growth corrupted retained strings");
            }
        }
    }

    static void Main() {
        // Reuse registry entries after unregistering the first batch as well.
        Program.GrowAndRelease();
        Program.GrowAndRelease();
        Console.WriteLine("PASS live_registry_growth");
    }
}
