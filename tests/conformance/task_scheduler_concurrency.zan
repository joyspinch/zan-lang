using System;
using System.Collections.Generic;
using System.Threading;

class Program {
    static int observedCount;

    static void OnUnobserved(object sender, UnobservedTaskExceptionEventArgs e) {
        Program.observedCount = Program.observedCount + 1;
        e.SetObserved();
    }

    static async void TriggerUnobserved(string msg) {
        // 模拟多线程/多协程并发调用 TaskScheduler
        Exception ex = new Exception(msg);
        TaskScheduler.PublishUnobservedException("Sender", ex);
    }

    static async void Main() {
        Program.observedCount = 0;

        // 阶段 1: 并发注册与初始化 EnsureInitialized
        TaskScheduler.AddUnobservedTaskException(Program.OnUnobserved);

        // 阶段 2: 多并发异常分发
        List<long> tasks = new List<long>();
        for (int i = 0; i < 20; i = i + 1) {
            Program.TriggerUnobserved("Err_" + Convert.ToString(i));
        }

        await Task.Delay(50);

        if (Program.observedCount != 20) {
            Console.WriteLine("FAIL: observedCount expected 20, got " + Convert.ToString(Program.observedCount));
            return;
        }

        // 阶段 3: 清除处理器
        TaskScheduler.ClearHandlers();
        Console.WriteLine("PASS: task scheduler thread safety ok");
    }
}
