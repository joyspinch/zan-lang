using System;

/* An exception unwinds through the frames between the throw and the handler.
 * Those frames' locals are only reachable through the slots they registered
 * with the unwinder, so releasing them is what keeps a cross-frame throw from
 * leaking (run under --check-leaks). */

class Node {
    public string name;
    Node(string n) { this.name = n; }
}

class Program {
    static void Inner(string tag) {
        Node deep = new Node("deep-" + tag);
        List<string> dl = new List<string>();
        dl.Add(deep.name);
        throw new Exception("boom-" + tag);
    }

    /* one intermediate frame */
    static void Middle(string tag) {
        Node m = new Node("mid-" + tag);
        List<string> l = new List<string>();
        l.Add(m.name);
        Inner(tag);
        Console.WriteLine("unreachable");
    }

    /* two intermediate frames, the outer one holding a reassigned local */
    static void Outer2(string tag) {
        Node a = new Node("a");
        a = new Node("b");
        Middle(tag);
    }

    /* an intermediate frame whose locals are declared inside a loop */
    static void LoopMiddle(int n) {
        for (int i = 0; i < n; i++) {
            Node li = new Node("loop");
            List<string> ll = new List<string>();
            ll.Add(li.name);
            if (i == n - 1) {
                Inner("loop");
            }
        }
    }

    /* an intermediate frame that catches, cleans up, and rethrows */
    static void Rethrow(string tag) {
        Node r = new Node("r");
        try {
            Inner(tag);
        } catch (Exception e) {
            Node caught = new Node("c");
            throw new Exception(e.Message + "/" + caught.name + "/" + r.name);
        }
    }

    static void Main() {
        try {
            Middle("one");
        } catch (Exception e) {
            Console.WriteLine("caught " + e.Message);
        }

        try {
            Outer2("two");
        } catch (Exception e) {
            Console.WriteLine("caught " + e.Message);
        }

        try {
            LoopMiddle(3);
        } catch (Exception e) {
            Console.WriteLine("caught " + e.Message);
        }

        try {
            Rethrow("three");
        } catch (Exception e) {
            Console.WriteLine("caught " + e.Message);
        }

        /* the same frames on a path that never throws still clean up once */
        Node ok = new Node("ok");
        for (int i = 0; i < 3; i++) {
            Node li = new Node("iter");
            List<string> ll = new List<string>();
            ll.Add(li.name);
        }
        Console.WriteLine("done " + ok.name);
    }
}
