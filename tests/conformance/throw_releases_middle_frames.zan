using System;

/* 模块核心语义抽象与接口调用契约 */

class Node {
    public string name;
    Node(string n) { this.name = n; }
}

class Program {
    static void Inner(string tag) {
        Node deep = new Node("deep-" + tag);
        List<string> dl = new List<string>();
        dl.Add(deep.name);
        throw new Exception("boom-" + tag);
    }

    /* 核心系统底层抽象与内存语义契约 */
    static void Middle(string tag) {
        Node m = new Node("mid-" + tag);
        List<string> l = new List<string>();
        l.Add(m.name);
        Inner(tag);
        Console.WriteLine("unreachable");
    }

    /* 模块核心语义抽象与接口调用契约 */
    static void Outer2(string tag) {
        Node a = new Node("a");
        a = new Node("b");
        Middle(tag);
    }

    /* 模块核心语义抽象与接口调用契约 */
    static void LoopMiddle(int n) {
        for (int i = 0; i < n; i++) {
            Node li = new Node("loop");
            List<string> ll = new List<string>();
            ll.Add(li.name);
            if (i == n - 1) {
                Inner("loop");
            }
        }
    }

    /* 底层系统交互与数据协议契约 */
    static void Rethrow(string tag) {
        Node r = new Node("r");
        try {
            Inner(tag);
        } catch (Exception e) {
            Node caught = new Node("c");
            throw new Exception(e.Message + "/" + caught.name + "/" + r.name);
        }
    }

    static void Main() {
        try {
            Middle("one");
        } catch (Exception e) {
            Console.WriteLine("caught " + e.Message);
        }

        try {
            Outer2("two");
        } catch (Exception e) {
            Console.WriteLine("caught " + e.Message);
        }

        try {
            LoopMiddle(3);
        } catch (Exception e) {
            Console.WriteLine("caught " + e.Message);
        }

        try {
            Rethrow("three");
        } catch (Exception e) {
            Console.WriteLine("caught " + e.Message);
        }

        /* 模块核心语义抽象与接口调用契约 */
        Node ok = new Node("ok");
        for (int i = 0; i < 3; i++) {
            Node li = new Node("iter");
            List<string> ll = new List<string>();
            ll.Add(li.name);
        }
        Console.WriteLine("done " + ok.name);
    }
}
