using System;

class Program {
    [Weak]
    static int g_weak_bias = 10;

    [CallingConvention("sysv64")]
    [NoInline]
    [NoAlloc]
    static long SysvCompute(long a, long b, long c, long d, long e, long f) {
        return a * 1L + b * 2L + c * 3L + d * 4L + e * 5L + f * 6L;
    }

    [CallingConvention("win64")]
    [NoInline]
    [NoAlloc]
    static int Win64Compute(int x, int y) {
        return x * 10 + y;
    }

    [Weak]
    [NoInline]
    [NoAlloc]
    static int WeakDefaultHook(int v) {
        return v + g_weak_bias;
    }

    static int Main() {
        long s = SysvCompute(1L, 2L, 3L, 4L, 5L, 6L); // 1+4+9+16+25+36 = 91
        int w = Win64Compute(4, 2);                   // 42
        int h = WeakDefaultHook(5);                   // 15
        Console.WriteLine($"s={s} w={w} h={h}");
        return 0;
    }
}
