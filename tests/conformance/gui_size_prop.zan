using System;
using Gui;

// 尺寸档是控件的通用能力（Control.ApplySizeClass / SizeProp）。
//
// 契约：
//  1) 控件声明 `Binding<string> Size` 后，四档各自生效：档位 class
//     与档位名一一对应，高度取 --height-* 令牌。
//  2) 档位互斥：`Class = "small"` 与 `Size = "large"` 同时存在时，
//     绑定说了算（不能留下两个高度规则互相打架）。
//  3) 没有尺寸档绑定的控件不受影响：Class 里手写的档位类原样保留。
class SizePropTest {
    static int fails;

    static void Chk(bool ok, string what) {
        if (ok) { return; }
        fails = fails + 1;
        Console.WriteLine("FAIL " + what);
    }

    static int ButtonH(App app, string size) {
        Button b = new Button { Text = "OK" };
        b.Size = size;
        b.OnMeasure(app);
        return b.prefH;
    }

    static int TagH(App app, string size) {
        Tag t = new Tag { Text = "OK" };
        t.Size = size;
        t.OnMeasure(app);
        return t.prefH;
    }

    static void Main() {
        App app = App.CreateOffscreen("size prop", 320, 240);

        // 1) 按钮四档。
        int bt = ButtonH(app, "tiny");
        int bs = ButtonH(app, "small");
        int bm = ButtonH(app, "medium");
        int bl = ButtonH(app, "large");
        Console.WriteLine("button " + bt + " " + bs + " " + bm + " " + bl);
        Chk(bt == 24, "button tiny height");
        Chk(bs == 28, "button small height");
        Chk(bm == 32, "button medium height");
        Chk(bl == 40, "button large height");

        // 标签是紧凑件族：16 / 20 / 24 / 28。
        int tt = TagH(app, "tiny");
        int ts = TagH(app, "small");
        int tm = TagH(app, "medium");
        int tl = TagH(app, "large");
        Console.WriteLine("tag " + tt + " " + ts + " " + tm + " " + tl);
        Chk(tt == 16, "tag tiny height");
        Chk(ts == 20, "tag small height");
        Chk(tm == 24, "tag medium height");
        Chk(tl == 28, "tag large height");

        // 2) 档位互斥：绑定说了算。
        Button b = new Button { Text = "OK" };
        b.Class = "small";
        b.Size = "large";
        b.OnMeasure(app);
        Console.WriteLine("conflict " + b.prefH);
        Chk(b.prefH == 40, "the size binding wins over a stale class");

        // 3) 没有绑定的控件：Class 里的档位原样保留。
        Button plain = new Button { Text = "OK" };
        plain.Class = "small";
        plain.OnMeasure(app);
        Console.WriteLine("plain " + plain.prefH);
        Chk(plain.prefH == 28, "a class without a binding still applies");

        if (fails == 0) {
            Console.WriteLine("gui size prop OK");
        } else {
            Console.WriteLine("gui size prop FAILS " + fails);
        }
    }
}
