using System;
using Gui;
using Gui.Widget;

// 接口数据协议与执行契约。
// 核心契约与语义定义。
class GuiInputTest {
    // 接口数据协议与执行契约。
    // 核心契约与执行状态转移规范。
    static string ThumbsUp()  { return Text.CharStr(0x1F44D); }           // 1 cp
    static string Combining() { return "e" + Text.CharStr(0x0301); }      // 2 cp, 1 grapheme
    static string Flag()      { return Text.CharStr(0x1F1E6) + Text.CharStr(0x1F1FF); } // 2 cp, 1 grapheme
    static string Keycap()    { return "1" + Text.CharStr(0xFE0F); }      // 2 cp, 1 grapheme
    static string Family() {
        // 接口数据协议与执行契约。
        return Text.CharStr(0x1F468) + Text.CharStr(0x200D)
             + Text.CharStr(0x1F469) + Text.CharStr(0x200D)
             + Text.CharStr(0x1F467);
    }

    static string Hex(int cp) {
        if (cp < 0) { return "<"; }
        string digits = "0123456789ABCDEF";
        string s = "";
        int v = cp;
        if (v == 0) { return "0"; }
        while (v > 0) {
            s = "" + digits[v % 16] + s;
            v = v / 16;
        }
        return s;
    }

    static void Main() {
        // 核心契约与执行状态转移规范。
        Console.WriteLine(Text.Chars("") + " " + Text.Chars("abc")
            + " " + Text.Chars("中文"));
        Console.WriteLine(Text.Chars(ThumbsUp()) + " "
            + Text.Chars("a" + ThumbsUp() + "b"));

        // ---- 2. UTF-8 decode (CpAt) -------------------------------------
        Console.WriteLine(Hex(Text.CpAt("A", 0)) + " " + Hex(Text.CpAt("中", 0))
            + " " + Hex(Text.CpAt(ThumbsUp(), 0)));

        // 核心契约与语义定义。
        Console.WriteLine(Text.Chars(Combining()) + " " + Text.Graphemes(Combining()));
        Console.WriteLine(Text.Chars(Flag()) + " " + Text.Graphemes(Flag()));
        Console.WriteLine(Text.Chars(Keycap()) + " " + Text.Graphemes(Keycap()));
        Console.WriteLine(Text.Chars(Family()) + " " + Text.Graphemes(Family()));
        Console.WriteLine(Text.Chars("hello") + " " + Text.Graphemes("hello"));

        // 核心契约与语义定义。
        Console.WriteLine("[" + Input.OnlyDigits("a1b2 3") + "]");
        Console.WriteLine("[" + Input.NoSpaces("  hi there  ") + "]");
        Console.WriteLine(Input.CountText(5, 30) + " | "
            + Input.CountText(150, 200) + " | " + Input.CountText(7, 0));

        // 核心契约与语义定义。
        Input num = new Input("n");
        int changes = 0;
        num.Change += () => { changes = changes + 1; };
        num.MaxLen = 3;
        num.Filter = Input.OnlyDigits;
        num.SetText("");
        Console.WriteLine(num.Insert("12") + " '" + num.GetText() + "' c=" + changes);
        // 接口数据协议与执行契约。
        Console.WriteLine(num.Insert("34") + " '" + num.GetText() + "' c=" + changes);
        // 接口数据协议与执行契约。
        Console.WriteLine(num.Insert("x") + " '" + num.GetText() + "' c=" + changes);
        // 核心契约与语义定义。
        Console.WriteLine(num.Insert("9x") + " '" + num.GetText() + "' c=" + changes);
        Console.WriteLine(num.CountValue());

        // 核心契约与语义定义。
        Input f = new Input("f");
        f.SetStatus("warning");
        Console.WriteLine("'" + f.GetProp("status") + "'");
        f.SetStatus("bogus");
        Console.WriteLine("'" + f.GetProp("status") + "'");
        f.SetProp("maxlen", "20");
        f.SetProp("showCount", "true");
        f.SetProp("round", "true");
        Console.WriteLine(f.MaxLen + " " + f.GetProp("showCount") + " "
            + f.GetProp("round") + " " + f.GetProp("maxlen"));

        // 核心契约与语义定义。
        Input g = new Input("g");
        g.CountGraphemes = true;
        g.ShowCount = true;
        g.MaxLen = 4;
        g.SetText(ThumbsUp());
        Console.WriteLine(g.CountValue() + " " + Input.CountText(g.CountValue(), g.MaxLen));
        // 接口数据协议与执行契约。
        Console.WriteLine(g.Insert("abc") + " count=" + g.CountValue());
        Console.WriteLine(g.Insert(Flag()) + " count=" + g.CountValue());

        // 接口数据协议与执行契约。
        g.Focus();
        g.Blur();
        g.ScrollToEnd();
        g.ScrollToStart();
        Console.WriteLine("manual-ops-survive '" + g.GetText() + "'");

        // 核心契约与语义定义。
        TextArea ta = new TextArea("t");
        int tac = 0;
        ta.Change += () => { tac = tac + 1; };
        ta.MaxLen = 4;
        ta.ShowCount = true;
        ta.SetStatus("error");
        Console.WriteLine("ta-status '" + ta.GetProp("status") + "'");
        ta.SetStatus("nope");
        Console.WriteLine("ta-status '" + ta.GetProp("status") + "'");
        Console.WriteLine(ta.Insert("abc") + " '" + ta.GetText() + "' c=" + tac);
        // 接口数据协议与执行契约。
        Console.WriteLine(ta.Insert("\n") + " count=" + ta.CountValue());
        Console.WriteLine(ta.Insert("def") + " '" + ta.GetText() + "' c=" + tac);
        ta.Filter = Input.NoSpaces;
        ta.Clear();
        Console.WriteLine(ta.Insert("  x  ") + " '" + ta.GetText() + "' c=" + tac);
        ta.SetProp("maxlen", "9");
        Console.WriteLine(ta.MaxLen + " " + ta.GetProp("showCount") + " " + ta.GetProp("round"));
    }
}
