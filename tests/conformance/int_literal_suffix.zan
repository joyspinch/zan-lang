using System;

// C# integer literal suffixes: 1L (long), 1U (uint), 1UL (ulong), in either
// case and on any base (decimal/hex/octal/binary). The suffix pins the static
// type regardless of value, so `long x = 1L` needs no widening and a ulong
// literal prints as unsigned even above long.MaxValue. Unsigned semantics
// (logical shift, unsigned div/mod/compare) and uint wraparound follow.
class Program {
    static void Main() {
        // ---- suffixes pin the type (values small enough for int) ----
        long a = 1L;
        long b = 1l;
        uint c = 7U;
        uint d = 7u;
        ulong e = 10UL;
        ulong f = 10Lu;
        ulong g = 10uL;
        Console.WriteLine(a);
        Console.WriteLine(b);
        Console.WriteLine(c);
        Console.WriteLine(d);
        Console.WriteLine(e);
        Console.WriteLine(f);
        Console.WriteLine(g);

        // ---- suffixes on every base ----
        long h1 = 0x10L;        // 16
        long h2 = 0b1010L;      // 10
        long h3 = 0o17L;        // 15
        ulong h4 = 0xFFUL;      // 255
        uint h5 = 0x7FFFFFFFU;  // 2147483647
        Console.WriteLine(h1);
        Console.WriteLine(h2);
        Console.WriteLine(h3);
        Console.WriteLine(h4);
        Console.WriteLine(h5);

        // ---- long.MaxValue / ulong.MaxValue round-trip ----
        long maxL = 0x7FFFFFFFFFFFFFFFL;
        ulong maxU = 0xFFFFFFFFFFFFFFFFUL;
        ulong maxU2 = 18446744073709551615UL;
        Console.WriteLine(Convert.ToString(maxL));
        Console.WriteLine(Convert.ToString(maxU));
        Console.WriteLine(Convert.ToString(maxU2));

        // ---- uint max + wraparound ----
        uint umax = 4294967295U;
        uint wrap = umax + 1;
        Console.WriteLine(Convert.ToString(umax));
        Console.WriteLine(Convert.ToString(wrap));

        // ---- unsigned semantics on ulong ----
        ulong u = 18446744073709551615UL;
        Console.WriteLine(Convert.ToString(u >> 63));   // 1 (logical shift)
        Console.WriteLine(Convert.ToString(u / 2));     // 9223372036854775807
        Console.WriteLine(Convert.ToString(u % 3));     // 0
        Console.WriteLine(Convert.ToString(u > 10 ? 1 : 0));   // 1 (unsigned cmp)

        // ---- suffix vs narrowing: 1L to long is fine, no warning ----
        long w = 5L * 2 + 1L;
        Console.WriteLine(Convert.ToString(w));

        Console.WriteLine("suffix-ok: 1");
    }
}
