using System;

// 核心契约与执行状态转移规范。

class Base {
    public int n;

    Base WithN(int v) { this.n = v; return this; }
    static Base Bare() { return new Base(); }
}

class Derived : Base {
    static Derived Head() { return new Derived(); }
    static Derived Build(int v) {
        Derived d = Derived.Head().WithN(v);
        return d;
    }
}

class Program {
    static string Name(bool on) { return on ? "on" : ""; }
    static int Pick() { return 7; }

    static string Maybe(int i) {
        string t = i > 0 ? Program.Name(true) : null;
        return t;
    }

    static void Main() {
        int seven = Program.Pick();
        Console.WriteLine("pick=" + seven);

        Derived d = Derived.Build(42);
        Console.WriteLine("build=" + d.n + " isDerived=" + (d is Derived));
        Derived d2 = Derived.Head().WithN(99);
        Console.WriteLine("chain=" + d2.n);
        Base b = Base.Bare().WithN(5);
        Console.WriteLine("base=" + b.n);

        // 3. reference vs null in a conditional
        string m1 = Program.Maybe(1);
        string m2 = Program.Maybe(-1);
        Console.WriteLine("maybe=" + (m1 == "on" ? "on" : "BROKEN") +
                          "," + (m2 == null ? "null" : "BROKEN"));
    }
}
