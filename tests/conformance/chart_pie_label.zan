using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

// ECharts 饼标签缺省矩阵与外标几何。
// // 官方出处（`_scratch/echarts-master`）：
// - `chart/pie/PieSeries.ts:265-300` —— 饼 label.show 缺省 **true**、
// position 缺省 'outer'、distanceToLabelLine 缺省 5；labelLine
// （series 兄弟键，:288）show 缺省 true、length 15、length2 30；
// position 'inner' 与 'inside' 同义（:285 注）。
// - `chart/pie/labelLayout.ts:430-470` —— 外标初始几何：
// x1 = 圆心 + n·r（弧缘）→ x2 = x1 + n·(len + r - sectorShape.r)
// （roseType 扇区半径补差到基准外径）→ x3 = x2 ± len2（水平）；
// textX = x3 ± distanceToLabelLine、textAlign 按半球取 left/right；
// alignTo:'edge' 时 textX 压视口边（:454-459）且 textAlign 反向。
// - `label/labelLayoutHelper.ts:324-368` shiftLayoutOnXY —— 每半球
// 按文本顶 y 排序后自上而下只推不拉；`labelLayout.ts:224-256`
// 末趟把水平段压到最终 y（x3 不动、x2 保持原 x、y2=y3=label.y）。
// 核心契约与语义定义。
// // 数值出处：`_scratch/chart_oracle/pie_geo.js`（SSR 抓 pie-simple
// 引线 15/30/5 逐点吻合）与 shots_t41 实机截图。
class Program {
    static string B(bool v) { return v ? "1" : "0"; }

    static void Main() {
        // ---- label.show 三态：饼"未声明"=开（线柱缺省 false 不经此） ----
        Console.WriteLine("show/undef:" + Program.B(Chart.PieLabelShows(0 - 1)));
        Console.WriteLine("show/true:" + Program.B(Chart.PieLabelShows(1)));
        Console.WriteLine("show/false:" + Program.B(Chart.PieLabelShows(0)));

        // ---- position 内位分类（不出引线；center 落圆心） ----
        Console.WriteLine("pos/outer:" + Program.B(Chart.PieLabelInside("outer")));
        Console.WriteLine("pos/inside:" + Program.B(Chart.PieLabelInside("inside")));
        Console.WriteLine("pos/inner:" + Program.B(Chart.PieLabelInside("inner")));
        Console.WriteLine("pos/center:" + Program.B(Chart.PieLabelInside("center")));
        Console.WriteLine("pos/empty:" + Program.B(Chart.PieLabelInside("")));

        // ---- labelLine.show 三态：false 只藏线，文本仍在 x3 ----
        Console.WriteLine("line/undef:" + Program.B(Chart.PieLeaderDraws(0 - 1)));
        Console.WriteLine("line/off:" + Program.B(Chart.PieLeaderDraws(0)));
        Console.WriteLine("line/on:" + Program.B(Chart.PieLeaderDraws(1)));

        // ---- alignTo:'edge' 水平段终点：左半球 = 视口左缘 +
        // edgeDistance + 文本宽 + 文距，右半球镜像（labelLayout.ts:236-243） ----
        Console.WriteLine("edge/right:" + Convert.ToString(Chart.PieEdgeX3(true, 20, 400, 10, 60, 5)));
        Console.WriteLine("edge/left:" + Convert.ToString(Chart.PieEdgeX3(false, 20, 400, 10, 60, 5)));

        // ---- percent = Math.round(v/sum*100)；sum<=0 保护 ----
        Console.WriteLine("pct:" + Convert.ToString(Chart.PiePct(27, 102))
            + ":" + Convert.ToString(Chart.PiePct(0, 100))
            + ":" + Convert.ToString(Chart.PiePct(1, 3))
            + ":" + Convert.ToString(Chart.PiePct(5, 0)));

        // ---- 解析层：什么都不写的饼（ECharts 缺省即外标 + 引线）与
        // 全量声明饼；labelLine 是 series 兄弟键 ----
        ChartOption o = ChartOption.FromJson(
            "{\"series\":["
            + "{\"type\":\"pie\",\"data\":[{\"value\":1,\"name\":\"A\"}]},"
            + "{\"type\":\"pie\",\"label\":{\"show\":false,\"position\":\"center\","
            + "\"alignTo\":\"edge\",\"distanceToLabelLine\":8,\"edgeDistance\":12},"
            + "\"labelLine\":{\"show\":false,\"length\":10,\"length2\":20},"
            + "\"data\":[{\"value\":2,\"name\":\"B\"}]}]}");
        Console.WriteLine("parse/def:" + Convert.ToString(o.series[0].labelShowT)
            + ":" + o.series[0].labelPos
            + ":" + Convert.ToString(o.series[0].labelLineShow)
            + ":" + Convert.ToString(o.series[0].labelLineLen)
            + ":" + Convert.ToString(o.series[0].labelLineLen2)
            + ":" + Convert.ToString(o.series[0].labelDist));
        Console.WriteLine("parse/decl:" + Convert.ToString(o.series[1].labelShowT)
            + ":" + Program.B(o.series[1].labelShow)
            + ":" + o.series[1].labelPos
            + ":" + Convert.ToString(o.series[1].labelAlignTo)
            + ":" + Convert.ToString(o.series[1].labelDist)
            + ":" + Convert.ToString(o.series[1].labelEdgeDist)
            + ":" + Convert.ToString(o.series[1].labelLineShow)
            + ":" + Convert.ToString(o.series[1].labelLineLen)
            + ":" + Convert.ToString(o.series[1].labelLineLen2));
    }
}
