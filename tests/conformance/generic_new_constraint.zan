using System;

interface IShape {
    int Area();
}

class Rect : IShape {
    public int W;
    public int H;
    public Rect() {
        this.W = 3;
        this.H = 4;
    }
    public int Area() {
        return this.W * this.H;
    }
}

class Circle : IShape {
    public int R;
    public Circle() {
        this.R = 5;
    }
    public int Area() {
        return 3 * this.R * this.R;
    }
}

class Counter {
    public int val;
    public Counter() {
        this.val = 100;
    }
}

struct Point {
    public int x;
    public int y;
}

class ShapeMaker<T> where T : IShape, new() {
    public T CreateShape() {
        T item = new T();
        return item;
    }
}

class Container<T> where T : new() {
    public T Item;
    public Container() {
        this.Item = new T();
    }
}

class Factory {
    public static T Produce<T>() where T : new() {
        return new T();
    }
}

class Program {
    static void Main() {
        ShapeMaker<Rect> rm = new ShapeMaker<Rect>();
        Rect r = rm.CreateShape();
        Console.WriteLine(r.Area());

        ShapeMaker<Circle> cm = new ShapeMaker<Circle>();
        Circle c = cm.CreateShape();
        Console.WriteLine(c.Area());

        Container<Counter> cnt = new Container<Counter>();
        Console.WriteLine(cnt.Item.val);

        Container<Point> pbox = new Container<Point>();
        Console.WriteLine(pbox.Item.x);

        Rect r2 = Factory.Produce<Rect>();
        Console.WriteLine(r2.Area());

        Counter c2 = Factory.Produce<Counter>();
        Console.WriteLine(c2.val);
    }
}
