using System;
using System.Numerics;

namespace Conf;

struct Pair3 {
    public float A;
    public float B;
    public float C;

    public Pair3(float a, float b, float c) {
        this.A = a;
        this.B = b;
        this.C = c;
    }
}

class OutRefStructAssignTest {
    static void MakePairOut(float a, float b, float c, out Pair3 dst) {
        dst = new Pair3(a, b, c);
    }

    static void MutateVecRef(ref Vector3 v) {
        v = new Vector3(v.X + 10.0f, v.Y + 20.0f, v.Z + 30.0f);
    }

    static void Main() {
        Pair3 p;
        MakePairOut(1.5f, 2.5f, 3.5f, out p);
        bool outOk = p.A == 1.5f && p.B == 2.5f && p.C == 3.5f;
        Console.WriteLine("out-struct-new-assign: " + Convert.ToString(outOk ? 1 : 0));

        Vector3 v = new Vector3(1.0f, 2.0f, 3.0f);
        MutateVecRef(ref v);
        bool refOk = v.X == 11.0f && v.Y == 22.0f && v.Z == 33.0f;
        Console.WriteLine("ref-struct-new-assign: " + Convert.ToString(refOk ? 1 : 0));
    }
}
