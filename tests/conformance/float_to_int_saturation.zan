using System;

// B-ID180 收口补充：浮点→整型越界值必须在**目标位宽**上饱和。
// 旧实现先在 i64 上饱和、再截断到目标宽度：(int)-1e308 得到 0，
// (int)3e9 得到 -1294967296——既不是饱和也不是回绕。现在域外值
// 直接落到目标类型的 MIN/MAX。
class Program {
    static void Main() {
        // 目标位宽 32：i64 域内、i32 域外（不触发 i64 范围守卫）
        Console.WriteLine(Convert.ToString((int)3000000000.0));
        Console.WriteLine(Convert.ToString((int)-3000000000.0));
        Console.WriteLine(Convert.ToString((int)2147483648.0));
        Console.WriteLine(Convert.ToString((int)-2147483649.0));
        // 目标位宽 16 / 8：同一收口路径的宽度覆盖
        Console.WriteLine(Convert.ToString((short)40000.0));
        Console.WriteLine(Convert.ToString((short)-40000.0));
        Console.WriteLine(Convert.ToString((sbyte)200.0));
        Console.WriteLine(Convert.ToString((sbyte)-200.0));
    }
}