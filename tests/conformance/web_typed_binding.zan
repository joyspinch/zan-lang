using System;
using System.Json;
using System.Net;
using System.Net.Http;
using System.Web;
using Zan.Web;

[Route("/api/calc")]
class CalcController : Controller {
    [HttpGet]
    [Description("加法")]
    void Sum(int a, int b) {
        this.Ok("{\"sum\":" + Convert.ToString(a + b) + "}");
    }
}

class TxLog {
    static List<string> events;

    static void Push(string e) {
        if (TxLog.events == null) { TxLog.events = new List<string>(); }
        TxLog.events.Add(e);
    }

    static string Joined() {
        if (TxLog.events == null) { return ""; }
        string out0 = "";
        for (int i = 0; i < TxLog.events.Count; i = i + 1) {
            if (i > 0) { out0 = out0 + ","; }
            out0 = out0 + TxLog.events[i];
        }
        return out0;
    }

    static void Reset() { TxLog.events = new List<string>(); }

    static void Drop() { TxLog.events = null; }
}

[Route("/api/tx")]
class DocController : Controller {
    [Tx]
    [HttpPost]
    [Description("保存")]
    void Save(string name, int qty) {
        TxLog.Push("action:" + name + ":" + Convert.ToString(qty));
        if (qty < 0) { this.Fail(400, "0004", "数量不能为负"); }
        this.Ok("null");
    }

    override async bool TxBegin() { TxLog.Push("begin"); return true; }
    override async void TxCommit() { TxLog.Push("commit"); }
    override async void TxRollback() { TxLog.Push("rollback"); }
}

class ItemForm {
    string sku = "";
    int qty;
    string note = "none";
    double weight;
    /* 类级状态不是请求形态：出现在表单类里也必须被绑定器跳过，
     * 否则生成"经实例写静态字段"的必炸源码。 */
    static int made;
}

[Route("/api/items")]
class ItemController : Controller {
    [HttpGet]
    [Opt("page=1", "kw=")]
    [Description("浏览")]
    void Browse(int page, int limit, string kw) {
        JsonValue body = JsonValue.NewObject();
        body.PutInt("page", page);
        body.PutInt("limit", limit);
        body.PutStr("kw", kw);
        this.Ok(body.ToJson());
    }

    [HttpPost]
    [Description("保存")]
    void Save(ItemForm f) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("sku", f.sku);
        body.PutInt("qty", f.qty);
        body.PutStr("note", f.note);
        body.PutDouble("weight", f.weight);
        body.PutInt("made", ItemForm.made);
        this.Ok(body.ToJson());
    }
}

class Program {
    static int failures = 0;

    static void Check(bool ok, string label) {
        if (!ok) { Program.failures = Program.failures + 1; }
        Console.WriteLine((ok ? "ok " : "FAIL ") + label);
    }

    static HttpContext Ctx(string method, string target) {
        string raw = method + " " + target + " HTTP/1.1\r\nHost: t\r\n\r\n";
        HttpRequest r = HttpRequest.Parse(raw);
        return new HttpContext(r, "127.0.0.1");
    }

    static async void Dispatch(WebApp app, HttpContext ctx) {
        Route r = app.router.Match(ctx);
        if (r == null) {
            ctx.Status(404, "Not Found");
            return;
        }
        ctx.routeAction = r.action;
        ctx.routePattern = r.pattern;
        try {
            await r.handler(ctx);
        } catch (ApiError ae) {
            if (!ctx.ended) {
                ctx.Status(ae.Status(), ApiError.Reason(ae.Status()));
                ctx.Api(ae.Code(), ae.Message, "null");
            }
        }
    }

    static async int Run() {
        WebApp app = new WebApp("127.0.0.1", 0);
        __AttrRoutes.Register(app);
        List<Route> routes = app.router.All();

        HttpContext c1 = Program.Ctx("GET", "/api/calc/sum?a=2&b=40");
        await Program.Dispatch(app, c1);
        string p1 = c1.BuildResponse(true);
        Program.Check(p1.IndexOf("200 OK") >= 0, "sum answers 200");
        Program.Check(p1.IndexOf("\"sum\":42") >= 0, "sum body computed");

        HttpContext c2 = Program.Ctx("GET", "/api/calc/sum?a=2");
        await Program.Dispatch(app, c2);
        string p2 = c2.BuildResponse(true);
        Program.Check(p2.IndexOf("400 Bad") >= 0
            && p2.IndexOf("\"0003\"") >= 0,
            "missing param answered 0003");

        HttpContext c3 = Program.Ctx("GET", "/api/calc/sum?a=2&b=xyz");
        await Program.Dispatch(app, c3);
        string p3 = c3.BuildResponse(true);
        Program.Check(p3.IndexOf("400 Bad") >= 0
            && p3.IndexOf("\"0003\"") >= 0,
            "malformed int answered 0003");

        Route sum = null;
        for (int i = 0; i < routes.Count; i = i + 1) {
            if (routes[i].pattern == "/api/calc/sum") { sum = routes[i]; }
        }
        Program.Check(sum != null && sum.docParams.Count == 2
            && sum.docParams[0].Name() == "a"
            && sum.docParams[0].Type() == "int"
            && sum.docParams[0].Required(),
            "signature params documented");

        TxLog.Reset();
        HttpContext c5 = Program.Ctx("POST", "/api/tx/save?name=box&qty=3");
        await Program.Dispatch(app, c5);
        string p5 = c5.BuildResponse(true);
        Program.Check(p5.IndexOf("200 OK") >= 0, "tx save answers 200");
        Program.Check(TxLog.Joined() == "begin,action:box:3,commit",
            "tx commit order");

        TxLog.Reset();
        HttpContext c6 = Program.Ctx("POST", "/api/tx/save?name=box&qty=-1");
        await Program.Dispatch(app, c6);
        string p6 = c6.BuildResponse(true);
        Program.Check(p6.IndexOf("400 Bad") >= 0, "tx failure answers 400");
        Program.Check(TxLog.Joined() == "begin,action:box:-1,rollback",
            "tx rollback order");

        HttpContext c7 = Program.Ctx("GET", "/api/items/browse?limit=10&page=7&kw=ab");
        await Program.Dispatch(app, c7);
        string p7 = c7.BuildResponse(true);
        Program.Check(p7.IndexOf("200 OK") >= 0, "opt params answer 200");
        Program.Check(p7.IndexOf("\"page\":7") >= 0, "opt given value wins");
        Program.Check(p7.IndexOf("\"kw\":\"ab\"") >= 0, "opt string given");

        HttpContext c8 = Program.Ctx("GET", "/api/items/browse?limit=10");
        await Program.Dispatch(app, c8);
        string p8 = c8.BuildResponse(true);
        Program.Check(p8.IndexOf("200 OK") >= 0, "opt missing answers 200");
        Program.Check(p8.IndexOf("\"page\":1") >= 0, "opt int default used");
        Program.Check(p8.IndexOf("\"kw\":\"\"") >= 0, "opt string default used");

        HttpContext c9 = Program.Ctx("GET", "/api/items/browse");
        await Program.Dispatch(app, c9);
        string p9 = c9.BuildResponse(true);
        Program.Check(p9.IndexOf("400 Bad") >= 0
            && p9.IndexOf("\"0003\"") >= 0,
            "non-opt param still required");

        Route browse = null;
        Route save = null;
        for (int i = 0; i < routes.Count; i = i + 1) {
            if (routes[i].pattern == "/api/items/browse") { browse = routes[i]; }
            if (routes[i].pattern == "/api/items/save") { save = routes[i]; }
        }
        Program.Check(browse != null && browse.docParams.Count == 3
            && browse.docParams[0].Name() == "page"
            && !browse.docParams[0].Required()
            && browse.docParams[0].Default() == "1"
            && browse.docParams[1].Name() == "limit"
            && browse.docParams[1].Required()
            && !browse.docParams[2].Required()
            && browse.docParams[2].Default() == "",
            "opt params documented with defaults");

        HttpContext c10 = Program.Ctx("POST", "/api/items/save?sku=box&qty=3");
        await Program.Dispatch(app, c10);
        string p10 = c10.BuildResponse(true);
        Program.Check(p10.IndexOf("200 OK") >= 0, "form object answers 200");
        Program.Check(p10.IndexOf("\"sku\":\"box\"") >= 0
            && p10.IndexOf("\"qty\":3") >= 0,
            "form fields bound by name");
        Program.Check(p10.IndexOf("\"note\":\"none\"") >= 0,
            "absent field keeps initializer");

        HttpContext c11 = Program.Ctx("POST", "/api/items/save?sku=pen");
        await Program.Dispatch(app, c11);
        string p11 = c11.BuildResponse(true);
        Program.Check(p11.IndexOf("\"qty\":0") >= 0
            && p11.IndexOf("\"weight\":0") >= 0,
            "absent numeric fields stay zero");

        Program.Check(save != null && save.docParams.Count == 4
            && save.docParams[0].Name() == "sku"
            && save.docParams[0].Source() == "form"
            && !save.docParams[0].Required()
            && save.docParams[3].Name() == "weight"
            && save.docParams[3].Type() == "double",
            "form fields documented as optional form params");

        HttpContext c12 = Program.Ctx("POST", "/api/items/save?sku=box&made=99");
        await Program.Dispatch(app, c12);
        string p12 = c12.BuildResponse(true);
        Program.Check(p12.IndexOf("\"made\":0") >= 0,
            "static form field ignored");

        TxLog.Drop();
        Console.WriteLine("failures=" + Convert.ToString(Program.failures));
        return 0;
    }

    static void Main() {
        int r = await Run();
    }
}
