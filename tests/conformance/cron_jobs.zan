// Cron 解析 + 持久化任务：五域解析（步进/区间/列表/7=周日）、
// Matches 命中、NextAfter 严格未来、日周并集语义、坏表达式拒绝、
// PersistentJobs 崩溃恢复（重启后 next/retry/runs 保留）。
using System;
using System.Hosting;
using System.Collections.Generic;
using System.Data.ZanDb;
using System.IO;
using System.Threading;

class Program {
    static int bad;

    static void Check(bool ok, string label) {
        if (!ok) { Console.WriteLine("FAIL " + label); bad = bad + 1; }
        else { Console.WriteLine("ok " + label); }
    }

    static async void Main() {
        // 解析成功/失败。
        Check(Cron.Parse("* * * * *") != null, "parse-all-star");
        Check(Cron.Parse("*/5 * * * *") != null, "parse-step");
        Check(Cron.Parse("0 9-17/2 * * 1-5") != null, "parse-range-step");
        Check(Cron.Parse("30 4 1,15 * 5") != null, "parse-list");
        Check(Cron.Parse(null) == null, "parse-null");
        Check(Cron.Parse("") == null, "parse-empty");
        Check(Cron.Parse("* * * *") == null, "parse-4fields");
        Check(Cron.Parse("* * * * * *") == null, "parse-6fields");
        Check(Cron.Parse("60 * * * *") == null, "parse-min-60");
        Check(Cron.Parse("* 24 * * *") == null, "parse-hour-24");
        Check(Cron.Parse("* * 32 * *") == null, "parse-day-32");
        Check(Cron.Parse("* * * 13 *") == null, "parse-month-13");
        Check(Cron.Parse("* * * * 7") != null, "parse-wd-7");
        Check(Cron.Parse("5/3 * * * *") != null, "parse-single-step");
        Check(Cron.Parse("abc * * * *") == null, "parse-alpha");
        Check(Cron.Parse("1-5-9 * * * *") == null, "parse-double-dash");
        // Matches 命中。
        Cron everyMin = Cron.Parse("* * * * *");
        Check(everyMin != null && everyMin.Matches(DateTime.FromParts(2026, 10, 19, 8, 30, 0)), "match-every");
        Cron at930 = Cron.Parse("30 9 * * *");
        Check(at930 != null && at930.Matches(DateTime.FromParts(2026, 10, 19, 9, 30, 0)), "match-930-hit");
        Check(at930 != null && !at930.Matches(DateTime.FromParts(2026, 10, 19, 9, 31, 0)), "match-931-miss");
        Check(at930 != null && !at930.Matches(DateTime.FromParts(2026, 10, 19, 8, 30, 0)), "match-830-miss");
        Cron wkdy = Cron.Parse("* * * * 1-5");
        Check(wkdy != null && wkdy.Matches(DateTime.FromParts(2026, 10, 19, 10, 0, 0)), "match-monday");
        Check(wkdy != null && !wkdy.Matches(DateTime.FromParts(2026, 10, 18, 10, 0, 0)), "match-sunday");
        Cron every5 = Cron.Parse("*/5 * * * *");
        Check(every5 != null && every5.Matches(DateTime.FromParts(2026, 10, 19, 10, 55, 0)), "match-55");
        Check(every5 != null && !every5.Matches(DateTime.FromParts(2026, 10, 19, 10, 57, 0)), "match-57");
        Cron monthly = Cron.Parse("0 0 1 * *");
        Check(monthly != null && monthly.Matches(DateTime.FromParts(2026, 11, 1, 0, 0, 0)), "match-first");
        Check(monthly != null && !monthly.Matches(DateTime.FromParts(2026, 10, 19, 0, 0, 0)), "match-19th");
        // NextAfter 严格未来。
        // 2026-10-19 10:15:00 UTC = 1792800900000? 算一下用 DateTime。
        long base0 = DateTime.FromParts(2026, 10, 19, 10, 15, 0).ToUnixMilliseconds();
        Cron h930 = Cron.Parse("30 9 * * *");
        long n1 = h930 != null ? h930.NextAfter(base0) : -1;
        Check(n1 == DateTime.FromParts(2026, 10, 20, 9, 30, 0).ToUnixMilliseconds(), "next-tomorrow-930");
        // 当天 10:15 后的 */15 是 10:30。
        Cron q = Cron.Parse("*/15 * * * *");
        long n2 = q != null ? q.NextAfter(base0) : -1;
        Check(n2 == DateTime.FromParts(2026, 10, 19, 10, 30, 0).ToUnixMilliseconds(), "next-1030");
        // 整点后的下一分钟。
        Cron m1 = Cron.Parse("* * * * *");
        long n3 = m1 != null ? m1.NextAfter(base0) : -1;
        Check(n3 == DateTime.FromParts(2026, 10, 19, 10, 16, 0).ToUnixMilliseconds(), "next-1016");
        // 月尾不可达（2 月 31 日）→ -1。
        Cron bad31 = Cron.Parse("0 0 31 2 *");
        Check(bad31 != null && bad31.NextAfter(base0) == -1, "next-feb31");
        // 日周并集：13 号周五 或 周五。
        Cron fr13 = Cron.Parse("0 0 13 * 5");
        // 2026-10-19 是周一；10-13 是周二？下个月 11-13 周五。
        long n4 = fr13 != null ? fr13.NextAfter(base0) : -1;
        DateTime n4d = DateTime.FromUnixMilliseconds(n4);
        // 并集语义：最近命中是 10-23 周五（而非 11-13 号周五）。
        Check(n4d.Day() == 23 && n4d.Month() == 10 && n4d.DayOfWeek() == 5,
            "next-dom-dow-union");
        // 从 11-7 起搜：11-13 恰是周五，13 号 + 周五一次命中。
        long n5 = fr13 != null ? fr13.NextAfter(
            DateTime.FromParts(2026, 11, 7, 0, 0, 0).ToUnixMilliseconds()) : -1;
        DateTime n5d = DateTime.FromUnixMilliseconds(n5);
        Check(n5d.Day() == 13 && n5d.Month() == 11 && n5d.DayOfWeek() == 5,
            "next-friday13");
        string dir = "_scratch/cron_jobs_" + Guid.New();
        Directory.CreateDirectory(dir);
        string path = dir + "/jobs.zdb";
        try {
            await TestStore(path);
        } finally {
            ZanStore.CrashHook = null;
            Check(Directory.DeleteRecursive(dir), "fixture-cleaned");
        }
        if (bad == 0) { Console.WriteLine("cron-jobs-done"); }
    }

    static async void TestStore(string path) {
        CancellationToken ct = CancellationToken.None;
        long later = DateTime.GetCurrentUnixMilliseconds() + 3600000;
        ZanStore legacy = ZanStore.Open(path);
        legacy.Begin();
        legacy.Put("job:old:name", "Legacy");
        legacy.Put("job:old:cron", "0 12 13 * 5");
        legacy.Put("job:old:next", Convert.ToString(later));
        legacy.Put("job:old:last", "123");
        legacy.Put("job:old:retry", "1");
        legacy.Put("job:old:runs", "4");
        legacy.Put("job:old:fails", "2");
        legacy.Put("param:old", "{\"legacy\":true}");
        Check(legacy.Commit(), "legacy-store-written");
        legacy.Close();

        PersistentJobs jobs = new PersistentJobs(path);
        Check(jobs.StoreOk(), "store-open");
        JobDef old = jobs.Snapshot()[0];
        Check(old.id == "old" && old.name == "Legacy" && old.cron == "0 12 13 * 5"
            && old.nextMs == later && old.lastMs == 123 && old.runs == 4 && old.fails == 2
            && old.retriesLeft == 1 && old.retryPending && !old.inFlight, "legacy-layout-read");
        int calls = 0;
        jobs.handler = delegate(string id, string name, string param) {
            calls = calls + 1;
            return id == "old" && name == "Legacy" && param == "{\"legacy\":true}";
        };
        await jobs.ExecuteAsync(ct);
        Check(calls == 0, "old-param-alone-is-not-in-flight");
        Check(jobs.TriggerNow("old"), "trigger-legacy");
        await jobs.ExecuteAsync(ct);
        JobDef done = jobs.Snapshot()[0];
        Check(calls == 1 && done.runs == 5 && done.fails == 2 && done.retriesLeft == 0
            && !done.NeedsAttention(), "legacy-callback-and-counters");
        jobs.Close();

        legacy = ZanStore.Open(path);
        Check(legacy.Get("job:old:name") == "Legacy" && legacy.Get("job:old:cron") == "0 12 13 * 5"
            && legacy.Get("job:old:runs") == "5" && legacy.Get("job:old:fails") == "2"
            && !legacy.Contains("param:old") && !legacy.Contains("job:old:retry")
            && !legacy.Contains("job:old:phase"),
            "legacy-layout-written");
        legacy.Close();

        jobs = new PersistentJobs(path);
        jobs.Remove("old");
        Check(jobs.Snapshot().Count == 0, "removed");
        Check(!jobs.Upsert("bad", "not cron", "Bad"), "upsert-bad-rejected");
        Check(jobs.Upsert("job", "0 0 31 2 *", "Report"), "upsert-ok");
        jobs.maxParallel = 2;
        bool rejected = false;
        try { await jobs.ExecuteAsync(ct); } catch (ArgumentException e) { rejected = true; }
        Check(rejected, "nonzero-parallel-rejected");
        jobs.maxParallel = 0;
        jobs.maxRetries = 1;
        jobs.retryDelayMs = 60000;
        bool closeRejected = false;
        bool sawInFlight = false;
        PersistentJobs active = jobs;
        jobs.handler = delegate(string id, string name, string param) {
            sawInFlight = active.Snapshot()[0].inFlight;
            try { active.Close(); } catch (InvalidOperationException e) { closeRejected = true; }
            return false;
        };
        Check(jobs.TriggerNow("job"), "trigger-now");
        await jobs.ExecuteAsync(ct);
        JobDef waiting = jobs.Snapshot()[0];
        Check(sawInFlight && closeRejected && jobs.StoreOk(), "close-rejected-during-callback");
        Check(waiting.fails == 1 && waiting.retriesLeft == 1 && waiting.retryPending
            && waiting.nextMs > DateTime.GetCurrentUnixMilliseconds() && !waiting.NeedsAttention(),
            "false-schedules-retry");
        jobs.handler = null;
        jobs.Close();

        jobs = new PersistentJobs(path);
        JobDef reopened = jobs.Snapshot()[0];
        Check(reopened.nextMs == waiting.nextMs && reopened.retryPending && reopened.retriesLeft == 1,
            "retry-survives-reopen");
        jobs.handler = delegate(string id, string name, string param) {
            throw new InvalidOperationException("retry failed");
        };
        jobs.TriggerNow("job");
        await jobs.ExecuteAsync(ct);
        JobDef exhausted = jobs.Snapshot()[0];
        Check(exhausted.fails == 2 && exhausted.retriesLeft == 0 && !exhausted.retryPending
            && exhausted.NeedsAttention() && exhausted.lastError == "retry failed" && exhausted.nextMs == -1,
            "retry-exhaustion-resumes-cron");
        jobs.handler = delegate(string id, string name, string param) {
            ZanStore.CrashHook = (string phase) => {
                if (phase == "wal_before_commit") { throw new IOException("interrupted before outcome commit"); }
            };
            return true;
        };
        jobs.TriggerNow("job");
        bool interrupted = false;
        try { await jobs.ExecuteAsync(ct); } catch (IOException e) { interrupted = true; }
        ZanStore.CrashHook = null;
        Check(interrupted && !jobs.StoreOk(), "outcome-commit-failure-visible");
        jobs.Close();

        jobs = new PersistentJobs(path);
        Check(jobs.Upsert("job", "0 0 31 2 *", "Report") && jobs.Snapshot()[0].inFlight,
            "processing-marker-survives-reopen-and-registration");
        jobs.handler = delegate(string id, string name, string param) { return true; };
        await jobs.ExecuteAsync(ct);
        JobDef recovered = jobs.Snapshot()[0];
        Check(!recovered.inFlight && !recovered.NeedsAttention() && recovered.runs == 1
            && recovered.fails == 2, "replayed-once-and-cleared-marker");
        jobs.SetInterval(10);
        Check(await jobs.StartAsync(ct), "host-start");
        rejected = false;
        try { jobs.Close(); } catch (InvalidOperationException e) { rejected = true; }
        Check(rejected && jobs.StoreOk(), "close-rejected-before-host-stop");
        Check(await jobs.StopAsync(ct), "host-stop-joined");
        jobs.Close();
        Check(!jobs.StoreOk(), "store-closed-after-stop");
    }
}
