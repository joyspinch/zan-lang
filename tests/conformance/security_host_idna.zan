// 核心契约与语义定义。
using System;
using System.Security.Cryptography;

class Program {
    static int failures = 0;

    static void Check(bool ok, string name) {
        if (ok) { Console.WriteLine("ok " + name); }
        else { Console.WriteLine("FAIL " + name); failures = failures + 1; }
    }

    static string ECROOT_B64 = "";
    static string IDNA_B64 = "";

    static string Pem(string b64) {
        string out1 = "-----BEGIN CERTIFICATE-----\n";
        int pos = 0;
        while (pos < b64.Length) {
            int take = 64;
            if (pos + take > b64.Length) { take = b64.Length - pos; }
            out1 = out1 + b64.Substring(pos, take) + "\n";
            pos = pos + take;
        }
        return out1 + "-----END CERTIFICATE-----\n";
    }

    static async int Run() {
        X509Certificate cert = X509Certificate.FromPem(Pem(IDNA_B64));
        Check(cert != null, "idna leaf parses");
        if (cert == null) {
            Console.WriteLine("failures=" + Convert.ToString(failures));
            return 0;
        }

        // 接受：精确、大小写、尾随根点、A-label 精确、最左单标签通配。
        Check(cert.VerifyHost("ec.localhost"), "exact san matches");
        Check(cert.VerifyHost("EC.Localhost"), "case-insensitive match");
        Check(cert.VerifyHost("ec.localhost."), "trailing root dot on host accepted");
        Check(cert.VerifyHost("xn--e8b4f.example"), "A-label exact match accepted");
        Check(cert.VerifyHost("a.wild.example"), "leftmost wildcard matches");
        Check(cert.VerifyHost("B.WILD.EXAMPLE"), "wildcard case-insensitive");
        Check(cert.VerifyHost("trailing.example"), "trailing dot on san pattern accepted");
        Check(cert.VerifyHost("a.wild.example."), "trailing dot with wildcard accepted");

        // 拒绝：空标签 / 连续点 / 孤立点 / 双尾点。
        Check(!cert.VerifyHost("ec..localhost"), "empty label refused");
        Check(!cert.VerifyHost(".ec.localhost"), "leading dot refused");
        Check(!cert.VerifyHost("."), "lone dot refused");
        Check(!cert.VerifyHost("ec.localhost.."), "double trailing dot refused");
        Check(!cert.VerifyHost(""), "empty host refused");

        // 拒绝：非 ASCII（U-label）主机——本栈不做 Unicode 归一与同形字
        // 防护，应用层必须先 to-ASCII；任何非 ASCII 输入一律失败关闭。
        Check(!cert.VerifyHost("例え.example"), "unicode host refused");
        Check(!cert.VerifyHost("пример.example"), "cyrillic host refused");

        // 拒绝：LDH 之外字符。
        Check(!cert.VerifyHost("foo_bar.example"), "underscore refused");
        Check(!cert.VerifyHost("foo bar.example"), "space refused");
        Check(!cert.VerifyHost("*.wild.example"), "star in host refused");

        // 拒绝：通配越界（跨标签、A-label 首标签、单标签父域）。
        Check(!cert.VerifyHost("a.b.wild.example"), "cross-label wildcard refused");
        Check(!cert.VerifyHost("xn--80ak6aa92e.wild.example"), "wildcard vs A-label refused");
        Check(!cert.VerifyHost("x.single"), "single-label wildcard parent refused");

        // 拒绝：超长主机名（>255）。
        string longHost = "";
        for (int i = 0; i < 30; i = i + 1) { longHost = longHost + "abcdefghij."; }
        Check(!cert.VerifyHost(longHost), "overlong host refused");

        // 锚点自身仍可正常解析（健全性）。
        X509Certificate root = X509Certificate.FromPem(Pem(ECROOT_B64));
        Check(root != null && root.HasEcKey(), "ecroot anchor parses");

        Console.WriteLine("failures=" + Convert.ToString(failures));
        return 0;
    }

    static void Main() {
        int r = await Run();
    }
}
