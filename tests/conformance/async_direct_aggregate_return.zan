using System;

// B-ID64：非 Task 聚合 async 返回（`async Big M()` 直返结构体）——E3087 过期
// 限制随类型化返回值字段（RVAL）解除。聚合返回存 RVAL、RESULT 槽承载槽地址，
// await 按值拷出后再释放子帧；fire-and-forget（Task.Spawn）走 co.orphan
// 按类型释放含引用字段的载荷（--check-leaks 零泄漏）。

struct Big {
    long a;
    long b;
    double e;
    string tag;
}

class Program {
    static async Big MakeBig(long seed) {
        await Task.Delay(1);
        Big v;
        v.a = seed;
        v.b = seed * 2;
        v.e = 1.5;
        v.tag = "t" + Convert.ToString(seed);
        return v;
    }

    static async Big ChainBig(long seed) {
        Big m = await Program.MakeBig(seed);
        await Task.Delay(1);
        Big n = await Program.MakeBig(m.b);
        return n;
    }

    static async void Main() {
        Big r = await Program.ChainBig(10);
        Console.WriteLine("r=" + Convert.ToString(r.a) + "," + Convert.ToString(r.b)
            + "," + r.tag);
        Console.WriteLine("rf=" + Convert.ToString(r.e));
        // fire-and-forget 对照：孤儿释放路径覆盖结构体载荷（含 string 字段）
        Task.Spawn(Program.MakeBig(7));
        await Task.Delay(50);
        Console.WriteLine("done");
    }
}
