using System;

class Entity {
    public int Id;
}

class User : Entity {
    public string Name;
}

class Program {
    static T GetFirst<T>(List<T> list) where T : Entity {
        return list[0];
    }

    static void PrintId<T>(T item) where T : Entity {
        Console.WriteLine(item.Id.ToString());
    }

    public static void Main() {
        List<User> users = new List<User>();
        User u = new User();
        u.Id = 101;
        u.Name = "Alice";
        users.Add(u);

        User first = GetFirst(users);
        Console.WriteLine(first.Name);
        PrintId(first);
    }
}
