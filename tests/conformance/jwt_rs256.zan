using System;
using System.Security.Cryptography;

// RS256 signing and verification with a fixed test key, including payload and signature tampering.
class Program {
    static void Show(string label, JwtToken token) {
        Console.WriteLine(label + "=" + Convert.ToString(token.IsValid()) + ":" + token.Error());
    }

    static void Main() {
        string privatePem = "-----BEGIN RSA PRIVATE KEY-----\n"
            + "MIIEpAIBAAKCAQEAnyxKES8cfS5jSFZ5+UvwWu8uWbcTNal7lIlQ0H2q6JDbrQKZ\n"
            + "ZBqgOe9jH8yNxVEW8b23ZrfoT0Q521LFIGw5KvoqB5U0U1pNQpH7GJ6a4fkpQJfn\n"
            + "oe+MN/ihxBTgCGVUZdUbv1TM/KShhQ3z8InZrHn0dODTTWUk6lqpNuH4tVm9MFhn\n"
            + "nLN4np49o36zTBx/tjS1AVRw+quEJsT0SsFzZWiKR50LD7jHTdCu3JfrsR1uWk6T\n"
            + "ippGhfUl2huy8oeLWpAXHp3yl1UGKJEt6ks1P2hdZq4pqvhojxe1e8gyF3P2Hx3I\n"
            + "HQpD5rNGrGJHIkMTTQHpvayhPv5pRHbGKNZqiwIDAQABAoIBABYyQ+XfjvZ56Ihm\n"
            + "3r1/9HWJ0wnZuMkL6FrPR0C7tYCW6rtWmHNYLy3FDyqZCNASPcPaM+AUF0Yuem72\n"
            + "PN0HmnU+y2uhR9mzxwBYgQ5u16RZbYI/bKKtV/1aI5zHWHJzRvCoZiUpOyikAI4g\n"
            + "YvsRDhS6MPe3fl/Vke9IUz5/BoKrV4e6CVp2jCeIImGq88D2Eou1yDAUgtvl7xfn\n"
            + "y53s+bvvgAYo2GdwjPBfThIglssaeDtulA96TyNwU91d0dnSxe1U5FpQuS05RBHx\n"
            + "dehIs4z/rY5F3bAoy/Fo9sFe5Y4YtSzaijZtqmmahFB4teOfQJtnLN59cJqejUhb\n"
            + "vheq/cECgYEA1x/0PlV5fdcsMTHEuNDviGsRNfND/gkWcC0Q3jK33pUQg3oBi5uO\n"
            + "Fdo4frT6D6173728653+T6Kq4mueSrwUIIcN5F3eL2uUc8pjAASZY1h/VeciF5Mx\n"
            + "sCRDQUDdtTBNnJU8+96t6WQehCQioYV/+unnAf2gGIc1iScTwGbEOCsCgYEAvWq9\n"
            + "0yfpe/7RGFrU26R/eX+fpcVo99H9pXkpDIy30wfUJefi2y87ICDeZrzYWa8OWHeu\n"
            + "xkJtVeILZXl6tjxQ25IiUpi30j4kwwTAdhAWYxFQUkNdryeIiAHQ8qqGWQUddmAC\n"
            + "KHWafPwur+eZo4e4o/OfySSEyUFnAUFacDEGByECgYBSDJn3fFpOKNduG/FQHEB/\n"
            + "43Y5AYOZTJYGSun4FZgTiP83Zj1YpgfXRdfuW9BUUnLAr3ly1Fu+u+g5W5qQHpP+\n"
            + "pAQkabjolTuVvkdsJlTqk0Jd3T4fh8CX0fzk0ny9MqMnabRMzG3AarNI6w9aU7Sw\n"
            + "Wq4FEFsTf95nZUQfShLk6QKBgQCmOFCCRykOpcuJ6tOWN6Gh1kwb5cO6ja1fk5Zh\n"
            + "K+94ogsahIZAQA9Ln2xrjdbxxLv7CHP4CXz2+9lyYAs+dmmidXfnMZtGRUBvXvEh\n"
            + "6fYrU5s/xVwmA7Q9XhKlkN06q1FyesgKB0Hd4lN6C+x4Y/a08WrL0V8xWVJx+I7L\n"
            + "m0ml4QKBgQDJ97oUF0g/pgGsWleSi2DqE8dsGS0RFSPeyaxfej0z2Dfep/reRZZa\n"
            + "Yt7bEydonYvJ3xx3qIFhtz9XMGMXQkWfr7ElBs9r4LoPaEqE8uCBDC1wZX9/7FpM\n"
            + "M9eus88lFcJ5lqKNn14UOTgYGpzjosCaKeL84Cxb35jZmEgtnSRZIQ==\n"
            + "-----END RSA PRIVATE KEY-----\n";
        string publicPem = "-----BEGIN PUBLIC KEY-----\n"
            + "MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAnyxKES8cfS5jSFZ5+Uvw\n"
            + "Wu8uWbcTNal7lIlQ0H2q6JDbrQKZZBqgOe9jH8yNxVEW8b23ZrfoT0Q521LFIGw5\n"
            + "KvoqB5U0U1pNQpH7GJ6a4fkpQJfnoe+MN/ihxBTgCGVUZdUbv1TM/KShhQ3z8InZ\n"
            + "rHn0dODTTWUk6lqpNuH4tVm9MFhnnLN4np49o36zTBx/tjS1AVRw+quEJsT0SsFz\n"
            + "ZWiKR50LD7jHTdCu3JfrsR1uWk6TippGhfUl2huy8oeLWpAXHp3yl1UGKJEt6ks1\n"
            + "P2hdZq4pqvhojxe1e8gyF3P2Hx3IHQpD5rNGrGJHIkMTTQHpvayhPv5pRHbGKNZq\n"
            + "iwIDAQAB\n"
            + "-----END PUBLIC KEY-----\n";

        RsaKey privateKey = RsaKey.FromPrivatePem(privatePem);
        RsaKey publicKey = RsaKey.FromPublicPem(publicPem);
        string token = Jwt.CreateRs256("{\"sub\":\"fixed\",\"exp\":200}", privateKey);
        Console.WriteLine("created=" + Convert.ToString(token.Length > 0));
        Show("valid", Jwt.ParseRs256(token, publicKey, 100, "", ""));

        int first = token.IndexOf(".");
        int second = token.Substring(first + 1, token.Length - first - 1).IndexOf(".") + first + 1;
        string evilPayload = "{\"sub\":\"evil\",\"exp\":200}";
        string tamperedPayload = token.Substring(0, first + 1)
            + Jwt.Base64UrlEncode(evilPayload, evilPayload.Length)
            + token.Substring(second, token.Length - second);
        Show("payload-tampered", Jwt.ParseRs256(tamperedPayload, publicKey, 100, "", ""));
        string tamperedSignature = token.Substring(0, token.Length - 1)
            + (token.Substring(token.Length - 1, 1) == "A" ? "B" : "A");
        Show("signature-tampered", Jwt.ParseRs256(tamperedSignature, publicKey, 100, "", ""));
        Show("null-key", Jwt.ParseRs256(token, null, 100, "", ""));
    }
}
