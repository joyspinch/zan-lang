using System;
using System.IO;

class Program {
    static void Main() {
        string p = "fileinfo_case.tmp";
        File.WriteAllText(p, "hello");

        FileInfo fi = new FileInfo(p);
        Console.WriteLine("exists=" + fi.Exists());
        Console.WriteLine("length=" + fi.Length());
        Console.WriteLine("isdir=" + fi.IsDirectory());
        Console.WriteLine("stamped=" + (fi.LastWriteTime() > 1600000000));
        Console.WriteLine("created=" + (fi.CreationTime() > 0));
        Console.WriteLine("static_length=" + FileInfo.GetLength(p));
        Console.WriteLine("static_stamped=" + (FileInfo.GetLastWriteTime(p) > 1600000000));

        FileInfo missing = new FileInfo("fileinfo_absent.tmp");
        Console.WriteLine("missing_exists=" + missing.Exists());
        Console.WriteLine("missing_length=" + missing.Length());
        Console.WriteLine("missing_time=" + missing.LastWriteTime());
        Console.WriteLine("newer_than_missing=" + fi.NewerThan("fileinfo_absent.tmp"));

        Console.WriteLine("readonly_before=" + fi.IsReadOnly());
        Console.WriteLine("set_readonly=" + fi.SetReadOnly(true));
        Console.WriteLine("readonly_after=" + fi.IsReadOnly());
        Console.WriteLine("set_writable=" + fi.SetReadOnly(false));
        Console.WriteLine("readonly_end=" + fi.IsReadOnly());

        File.Delete(p);
        Console.WriteLine("deleted=" + fi.Exists());
    }
}
