// 测试断言与状态转移验证。
using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Http.Client;
using System.Threading;

class Program {
    static int PORT = 9515;

    static async HttpResponse Handle(HttpRequest req) {
        if (req.path == "/slow") {
            // 测试断言与状态转移验证。
            await Task.Delay(3000);
            return HttpResponse.Text("too late");
        }
        if (req.path == "/bad-gateway") {
            HttpResponse resp = HttpResponse.Text("upstream is down");
            resp.statusCode = 502;
            resp.statusText = "Bad Gateway";
            return resp;
        }
        return HttpResponse.Text("ok");
    }

    static async int Run() {
        Socket.Initialize();
        HttpServer server = new HttpServer("127.0.0.1", PORT);
        server.OnRequest(Handle);
        Task.Spawn(server.Start());
        await Task.Delay(50);

        // 测试断言与状态转移验证。
        HttpClient client = new HttpClient("127.0.0.1", PORT);
        HttpResponse ok = await client.SendAsync("GET", "/", "");
        Console.WriteLine("okStatus=" + Convert.ToString(ok.statusCode) + " body=" + ok.body);

        HttpResponse bad = await client.SendAsync("GET", "/bad-gateway", "");
        Console.WriteLine("badStatus=" + Convert.ToString(bad.statusCode)
            + " text=" + bad.statusText + " body=" + bad.body);

        // 测试断言与状态转移验证。
        // 核心契约与语义定义。
        string bodyOnly = await client.GetAsync("/bad-gateway");
        Console.WriteLine("bodyOnly=" + bodyOnly);

        // 核心契约与语义定义。
        HttpClient slow = new HttpClient("127.0.0.1", PORT);
        slow.SetTimeout(1000);
        long t0 = Stopwatch.GetMilliseconds();
        try {
            string _never = await slow.GetAsync("/slow");
            Console.WriteLine("slow=NOT THROWN");
        } catch (HttpRequestException e) {
            if (e.Message.IndexOf("timed out") >= 0) {
                Console.WriteLine("slowTimedOut=yes");
            } else {
                Console.WriteLine("slowTimedOut=no msg=" + e.Message);
            }
        }
        long elapsed = Stopwatch.GetMilliseconds() - t0;
        if (elapsed < 15000) {
            Console.WriteLine("slowBounded=yes");
        } else {
            Console.WriteLine("slowBounded=no ms=" + Convert.ToString(elapsed));
        }

        // 测试断言与状态转移验证。
        string after = await client.GetAsync("/");
        Console.WriteLine("after=" + after);

        // 进程退出前关掉池中的 keep-alive 连接：否则对端停在
        // RecvAsync 的协程带着未完成事件挂起，调度器永不静止。
        client.Close();
        slow.Close();
        server.Stop();
        for (int i = 0; i < 20; i = i + 1) { await Task.Delay(10); }
        return 0;
    }

    static async void Main() {
        int _rc = await Run();
    }
}
