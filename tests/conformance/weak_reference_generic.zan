using System;

class Parent {
    public string Name;
    public Child ChildNode;
    public Parent(string name) {
        this.Name = name;
    }
}

class Child {
    public WeakReference<Parent> ParentRef;
}

class Program {
    static void Main() {
        Parent p = new Parent("Root");
        Child c = new Child();
        p.ChildNode = c;
        c.ParentRef = new WeakReference<Parent>(p);

        Console.WriteLine($"Parent alive: {c.ParentRef.IsAlive}");
        Parent extracted;
        if (c.ParentRef.TryGetTarget(out extracted)) {
            Console.WriteLine($"Parent name: {extracted.Name}");
        }

        extracted = null;
        p = null;

        Console.WriteLine($"Parent alive after clear: {c.ParentRef.IsAlive}");
        Console.WriteLine($"Parent target is null: {c.ParentRef.Target == null}");
    }
}
