// Tar.WriteHeader must preserve file and directory modification times
// as Unix seconds in the 12-byte octal mtime field.
using System;
using System.IO.Compression;

class Program {
    static int bad;

    static void Check(bool ok, string label) {
        if (!ok) { Console.WriteLine("FAIL " + label); bad = bad + 1; }
    }

    static long ParseOctal(byte[] b, int off, int len) {
        long v = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = b[off + i] & 255;
            if (c >= 48 && c <= 55) { v = (v << 3) | (long)(c - 48); }
        }
        return v;
    }

    static void Main() {
        long dirMtime = 1700000010;
        long fileMtime = 2200000000;
        List<TarEntry> entries = new List<TarEntry>();
        TarEntry dir = new TarEntry("pkg/");
        dir.isDirectory = true;
        dir.mtime = dirMtime;
        entries.Add(dir);
        TarEntry file = new TarEntry("pkg/app");
        file.data = "payload".ToBytes();
        file.mtime = fileMtime;
        entries.Add(file);

        byte[] tar = Tar.Create(entries);
        Check(ParseOctal(tar, 136, 12) == dirMtime, "directory-mtime");
        Check(ParseOctal(tar, 512 + 136, 12) == fileMtime, "file-mtime");
        Console.WriteLine("tar-mtime-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
