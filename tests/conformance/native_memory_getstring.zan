using System;

class Program {
    [DllImport("zanrt_mem")]
    static extern string GetString(byte[] bytes, int offset, int count);

    static string EchoHead(byte[] bytes) {
        return NativeMemory.GetString(bytes, 0, 4);
    }

    static int Main() {
        byte[] bytes = new byte[8];
        for (int i = 0; i < 8; i = i + 1) { bytes[i] = 65 + i; }

        NativeMemory.GetString(bytes, 0, 4);

        string s = "";
        int total = 0;
        while (total < 1000) {
            s = NativeMemory.GetString(bytes, 0, 8);
            total = total + s.Length;
        }
        if (s != "ABCDEFGH") { return 1; }

        // 核心契约与执行状态转移规范。
        if (EchoHead(bytes) != "ABCD") { return 2; }

        Console.WriteLine("total=" + Convert.ToString(total));
        return 0;
    }
}
