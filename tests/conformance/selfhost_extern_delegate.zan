using System;

delegate long NativeStep(long value);

class SelfhostExternDelegate {
    [DllImport("crt", EntryPoint = "zan_dispatch_init")]
    static extern void Init();

    [DllImport("crt", EntryPoint = "zan_dispatch_post")]
    static extern int Post(NativeStep callback);

    [DllImport("crt", EntryPoint = "zan_dispatch_take")]
    static extern NativeStep Take();

    static long Step(long value) { return value + 7; }

    static void Main() {
        Init();
        NativeStep empty = Take();
        Console.WriteLine(empty == null);
        Post(SelfhostExternDelegate.Step);
        NativeStep callback = Take();
        Console.WriteLine(callback != null);
        Console.WriteLine(callback(35) == 42);
        callback = null;
        Console.WriteLine(Take() == null);
        long offset = 11;
        Post((long value) => { return value + offset; });
        NativeStep captured = Take();
        Console.WriteLine(captured(31) == 42);
        captured = null;
        Console.WriteLine(Take() == null);
    }
}
