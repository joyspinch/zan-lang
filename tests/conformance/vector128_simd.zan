using System;
using System.Numerics;
using System.Runtime.Intrinsics;
using System.Runtime.Intrinsics.X86;

namespace Conf;

class Program {
    static void Main() {
        // 1. BitOperations
        Console.WriteLine(BitOperations.PopCount(0b10110010)); // 4
        Console.WriteLine(BitOperations.LeadingZeroCount(0x00F00000)); // 8
        Console.WriteLine(BitOperations.TrailingZeroCount(0x00F00000)); // 20
        Console.WriteLine(BitOperations.RotateLeft(0x12345678, 4) == 0x23456781); // true
        Console.WriteLine(BitOperations.RotateRight(0x12345678, 4) == 0x81234567); // true

        // 2. Vector128 Create and Bitwise
        Vector128 a = Vector128.Create(10, 20);
        Vector128 b = Vector128.Create(30, 40);

        Vector128 vxor = Vector128.Xor(a, b);
        Console.WriteLine(vxor.Low);  // 10 ^ 30 = 20
        Console.WriteLine(vxor.High); // 20 ^ 40 = 60

        Vector128 vand = Vector128.And(a, b);
        Console.WriteLine(vand.Low);  // 10 & 30 = 10
        Console.WriteLine(vand.High); // 20 & 40 = 0

        Vector128 vor = Vector128.Or(a, b);
        Console.WriteLine(vor.Low);   // 10 | 30 = 30
        Console.WriteLine(vor.High);  // 20 | 40 = 60

        // 3. Vector128 Load, Equals, MoveMask
        byte[] buf = new byte[16];
        for (int i = 0; i < 16; i++) {
            buf[i] = (byte)(i == 3 || i == 7 ? 42 : 0);
        }
        Vector128 loaded = Vector128.Load(buf);
        Vector128 target = Vector128.Create((byte)42);
        Vector128 cmp = Vector128.Equals(loaded, target);
        int mask = Vector128.ExtractMostSignificantBits(cmp);
        // bits 3 and 7: (1 << 3) | (1 << 7) = 8 + 128 = 136
        Console.WriteLine(mask);
        Console.WriteLine(BitOperations.PopCount(mask)); // 2

        // 4. Vector128 Store
        byte[] outBuf = new byte[16];
        Vector128.Store(outBuf, cmp);
        Console.WriteLine(outBuf[3]); // 255
        Console.WriteLine(outBuf[0]); // 0

        // 5. Vector128 Shuffle (reverse)
        byte[] revMask = new byte[16];
        for (int i = 0; i < 16; i++) {
            revMask[i] = (byte)(15 - i);
        }
        Vector128 vRev = Vector128.Shuffle(loaded, Vector128.Load(revMask));
        Vector128.Store(outBuf, vRev);
        // original index 3 (value 42) moves to index 15 - 3 = 12
        Console.WriteLine(outBuf[12]); // 42
    }
}
