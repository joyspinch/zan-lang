using System;
using Game.Net;

class Program {
    static int Main() {
        // 1. 高段位休眠衰减与活跃天数银行
        NetRankedDecayTracker decay = new NetRankedDecayTracker(2400, 2000, 10, 50);
        decay.RecordRankedMatch(4); // 存入 4 天银行
        int lossWithinBank = decay.AdvanceInactiveDays(3); // 剩余 1 天，零扣分
        int lossOverflow = decay.AdvanceInactiveDays(4);   // 耗尽 1 天 + 溢出 3 天 -> 扣 150 -> 2250
        int lossToFloor = decay.AdvanceInactiveDays(20);   // 最多扣到底线 2000 -> 实际扣 250
        bool decayOk = lossWithinBank == 0 && lossOverflow == 150
            && lossToFloor == 250 && decay.Rating == 2000 && decay.BankDays == 0;
        Console.WriteLine("ranked_decay_ok=" + (decayOk ? "1" : "0"));

        // 2. 连杀赏金与终结奖金池
        NetBountyShutdownPool pool = new NetBountyShutdownPool(300, 3, 150, 500);
        int k1 = pool.RecordKill(1, 2); // 1 连杀 -> 300
        int k2 = pool.RecordKill(1, 3); // 2 连杀 -> 300
        int k3 = pool.RecordKill(1, 4); // 3 连杀 -> 300，此后玩家 1 赏金 = 150
        int k4 = pool.RecordKill(1, 5); // 4 连杀 -> 300，此后玩家 1 赏金 = 300
        int bonusBeforeShutdown = pool.CurrentBonusFor(1);
        int shutdownPay = pool.RecordKill(2, 1); // 终结玩家 1 -> 300 + 300 = 600
        int bonusAfterShutdown = pool.CurrentBonusFor(1);
        bool bountyOk = k1 == 300 && k2 == 300 && k3 == 300 && k4 == 300
            && bonusBeforeShutdown == 300 && shutdownPay == 600 && bonusAfterShutdown == 0;
        Console.WriteLine("bounty_pool_ok=" + (bountyOk ? "1" : "0"));

        // 3. 跨区数据中心选路（过载熔断 + 滞回防抖）
        NetRegionPingSelector sel = new NetRegionPingSelector(12.0f, 0.90f);
        sel.UpdateSample("ap-tokyo", 35.0f, 0.40f);
        sel.UpdateSample("ap-singapore", 18.0f, 0.96f); // 过载跳过
        string r1 = sel.SelectBestRegion(); // ap-tokyo
        sel.UpdateSample("ap-seoul", 28.0f, 0.35f); // 仅快 7ms (<12ms 滞回)，保持 ap-tokyo
        string r2 = sel.SelectBestRegion();
        sel.UpdateSample("ap-hk", 16.0f, 0.30f); // 快 19ms (>=12ms 滞回)，切至 ap-hk
        string r3 = sel.SelectBestRegion();
        bool regionOk = r1 == "ap-tokyo" && r2 == "ap-tokyo" && r3 == "ap-hk";
        Console.WriteLine("region_selector_ok=" + (regionOk ? "1" : "0"));
        return 0;
    }
}
