using System;
using System.Collections.Generic;
using Game.Board;

namespace Tests.GameGoBoard;

// 围棋规则契约测试：提子、自杀禁手、打劫禁着、试探无副作用、
// 中国规则数子、两次停手终局。
//
// 这些是 GoBoard 对调用方（游戏项目）的承诺，改规则语义时先改这里。
class Program {
    // 摆一个"白(4,4) 被黑围住"的局面：白先落，四面黑依次落。
    static GoBoard CaptureSetup() {
        GoBoard b = new GoBoard(9);
        b.Play(4, 4, GoBoard.White);
        b.Play(3, 4, GoBoard.Black);
        b.Play(5, 4, GoBoard.Black);
        b.Play(4, 3, GoBoard.Black);
        return b;
    }

    // 摆一个标准劫形：黑(2,1) 提掉白(1,1) 后，(1,1) 立刻回提被禁。
    //   白(1,1) 的唯一一口气是 (2,1)；黑(2,1) 落下提子后自己只剩一气 → 劫。
    static GoBoard KoSetup() {
        GoBoard b = new GoBoard(9);
        b.Play(1, 0, GoBoard.Black);
        b.Play(2, 0, GoBoard.White);
        b.Play(0, 1, GoBoard.Black);
        b.Play(3, 1, GoBoard.White);
        b.Play(1, 2, GoBoard.Black);
        b.Play(2, 2, GoBoard.White);
        b.Play(1, 1, GoBoard.White);
        return b;
    }

    static void Main() {
        // 1) 提子
        GoBoard b = CaptureSetup();
        int cap = b.Play(4, 5, GoBoard.Black);
        Console.WriteLine("capture=" + Convert.ToString(cap));
        Console.WriteLine("cell=" + Convert.ToString(b.At(4, 4)));
        Console.WriteLine("byBlack=" + Convert.ToString(b.CapturedByBlack));

        // 2) 自杀禁手：角上白(1,0)(0,1) 围点，黑下 (0,0) 无气且提不到子
        GoBoard s = new GoBoard(9);
        s.Play(1, 0, GoBoard.White);
        s.Play(0, 1, GoBoard.White);
        int suicide = s.Play(0, 0, GoBoard.Black);
        Console.WriteLine("suicide=" + Convert.ToString(suicide));
        Console.WriteLine("suicideCell=" + Convert.ToString(s.At(0, 0)));

        // 3) 打劫：黑(2,1) 提子后设禁着点，白立刻回提必须被拒
        GoBoard k = KoSetup();
        int koCap = k.Play(2, 1, GoBoard.Black);
        Console.WriteLine("koCapture=" + Convert.ToString(koCap));
        Console.WriteLine("koPoint=" + Convert.ToString(k.KoPoint));
        Console.WriteLine("koBlock=" + Convert.ToString(k.Play(1, 1, GoBoard.White)));

        // 4) 试探无副作用：能提，但棋盘 / 禁着 / 计数都不变
        GoBoard p = CaptureSetup();
        int probe = p.Probe(4, 5, GoBoard.Black);
        Console.WriteLine("probe=" + Convert.ToString(probe));
        Console.WriteLine("probeCell=" + Convert.ToString(p.At(4, 4)));
        Console.WriteLine("probeKo=" + Convert.ToString(p.KoPoint));
        Console.WriteLine("probeByBlack=" + Convert.ToString(p.CapturedByBlack));

        // 5) 中国规则数子：角上一黑一白，中间大片空区双方都临 = 争议不计
        GoBoard g = new GoBoard(9);
        g.Play(0, 0, GoBoard.Black);
        g.Play(8, 8, GoBoard.White);
        GoScore sc = g.Score(7.5);
        Console.WriteLine("score=" + Convert.ToString(sc.Black) + "," + Convert.ToString(sc.White));
        Console.WriteLine("winner=" + Convert.ToString(sc.Winner()));

        // 6) 停手两次 = 终局
        GoBoard o = new GoBoard(9);
        o.Pass(GoBoard.Black);
        o.Pass(GoBoard.White);
        Console.WriteLine("over=" + Convert.ToString(o.IsOverByPasses() ? 1 : 0));

        // 7) 提子坐标回传（给表现层播动画用）
        GoBoard v = CaptureSetup();
        List<int> taken = new List<int>();
        v.Play(4, 5, GoBoard.Black, taken);
        Console.WriteLine("taken=" + Convert.ToString(taken.Count)
            + "," + Convert.ToString(taken.Count > 0 ? taken[0] : -1));

        // 8) ProbeMove：一次探测给全信息，且不动棋盘
        GoBoard q = CaptureSetup();
        GoProbe pr = q.ProbeMove(4, 5, GoBoard.Black);
        Console.WriteLine("probeMove=" + Convert.ToString(pr.Legal ? 1 : 0)
            + "," + Convert.ToString(pr.Captured)
            + "," + Convert.ToString(pr.Liberties)
            + "," + Convert.ToString(pr.GroupSize));
        Console.WriteLine("probeMoveCell=" + Convert.ToString(q.At(4, 4)));
        GoProbe bad = q.ProbeMove(4, 4, GoBoard.Black);
        Console.WriteLine("probeIllegal=" + Convert.ToString(bad.Legal ? 1 : 0));
    }
}
