// 接口数据协议与执行契约。
using System;
using System.Net.Sockets;

class Program {
    static async int ResolveName(string host) {
        return await Socket.ResolveAsync(host);
    }

    static void Main() {
        int ip = await ResolveName("localhost");
        int sync = Socket.ResolveIpv4("localhost");
        int bad = await ResolveName("");
        if (ip == sync && ip != 0 && bad == 0) {
            Console.WriteLine("OK");
        } else {
            Console.WriteLine("FAIL async=" + ip + " sync=" + sync + " bad=" + bad);
        }
    }
}
