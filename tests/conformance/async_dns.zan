// Async DNS: resolve a hostname through zan_io_resolve_co. The lookup runs
// on a worker thread and the coroutine suspends on the IO reactor until it
// completes, so a slow resolver can never block the event loop. "localhost"
// resolves from the hosts file on every platform the suite runs on; the
// async result must match the synchronous ResolveIpv4, and an empty hostname
// must fail immediately with 0 (no worker thread is spawned). Prints OK.
using System;
using System.Net.Sockets;

class Program {
    static async int ResolveName(string host) {
        return await Socket.ResolveAsync(host);
    }

    static void Main() {
        int ip = await ResolveName("localhost");
        int sync = Socket.ResolveIpv4("localhost");
        int bad = await ResolveName("");
        if (ip == sync && ip != 0 && bad == 0) {
            Console.WriteLine("OK");
        } else {
            Console.WriteLine("FAIL async=" + ip + " sync=" + sync + " bad=" + bad);
        }
    }
}
