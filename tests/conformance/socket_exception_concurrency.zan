using System;

class Program {
    static void Main() {
        // 1. 无参构造验证
        SocketException se0 = new SocketException();
        if (se0.ErrorCode != 0 || se0.Message != "A socket operation encountered an error.") {
            Console.WriteLine("FAIL: se0 properties unexpected");
            return;
        }

        // 2. 错误码单参数构造
        SocketException se1 = new SocketException(10061); // WSAECONNREFUSED
        if (se1.ErrorCode != 10061 || se1.Message != "Socket error code: 10061") {
            Console.WriteLine("FAIL: se1 properties unexpected");
            return;
        }

        // 3. 错误码与文本构造
        SocketException se2 = new SocketException(10054, "Connection reset by peer");
        if (se2.ErrorCode != 10054 || se2.Message != "Connection reset by peer") {
            Console.WriteLine("FAIL: se2 properties unexpected");
            return;
        }

        // 4. 作为 Exception 捕获
        bool caught = false;
        try {
            throw se2;
        } catch (SocketException sex) {
            caught = true;
            if (sex.ErrorCode != 10054) {
                Console.WriteLine("FAIL: caught error code mismatch");
                return;
            }
        }

        if (!caught) {
            Console.WriteLine("FAIL: exception not caught");
            return;
        }

        Console.WriteLine("PASS: socket exception properties and handling ok");
    }
}
