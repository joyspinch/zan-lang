using System;
using System.Windows;

namespace Conf;

class DesktopCompanionHabitDockSleepTest {
    static void Main() {
        // 1. 每日习惯打卡与连击看板：连续打卡累加、同日防重、断签归零保留历史最佳、当日完成率
        CompanionHabitStreakBoard habits = new CompanionHabitStreakBoard();
        habits.RegisterHabit("drink_water");
        habits.RegisterHabit("stretch");

        bool d1 = habits.CheckIn("drink_water", 1);
        bool dupBlocked = !habits.CheckIn("drink_water", 1);
        bool d2 = habits.CheckIn("drink_water", 2);
        bool d3 = habits.CheckIn("drink_water", 3); // streak=3, best=3
        bool d5 = habits.CheckIn("drink_water", 5); // 第 4 天断签 -> streak=1, best=3
        habits.CheckIn("stretch", 5);

        HabitCheckinItem water = habits.GetHabit("drink_water");
        double rateDay5 = habits.CompletionRateOnDay(5);
        bool habitOk = d1 && dupBlocked && d2 && d3 && d5
            && water != null && water.CurrentStreak == 1 && water.BestStreak == 3 && water.TotalCompletions == 4
            && rateDay5 > 0.99 && rateDay5 <= 1.01;
        Console.WriteLine("companion-habit-streak-board: " + Convert.ToString(habitOk ? 1 : 0));

        // 2. 桌面微件贴边网格布局器：同锚点多微件自动防重叠顺移且留在屏幕内
        CompanionWidgetDockGrid grid = new CompanionWidgetDockGrid(1920, 1080, 20, 12);
        DesktopWidgetRect w1 = grid.PlaceWidget("clock", 240, 120, WidgetDockAnchor.TopRight);
        DesktopWidgetRect w2 = grid.PlaceWidget("weather", 240, 120, WidgetDockAnchor.TopRight);
        DesktopWidgetRect w3 = grid.PlaceWidget("pet_bar", 260, 80, WidgetDockAnchor.BottomRight);

        bool dockOk = grid.PlacedCount() == 3
            && w1.X == 1660 && w1.Y == 20
            && !w1.Overlaps(w2) && w2.X == 1660 && w2.Y == 152
            && w3.X == 1640 && w3.Y == 980;
        Console.WriteLine("companion-widget-dock-grid: " + Convert.ToString(dockOk ? 1 : 0));

        // 3. 深夜护眼与睡眠守护策略：跨午夜窗口(22:30-06:00)、四档渐进提醒与临时延后(Snooze)
        CompanionBedtimeGuard guard = new CompanionBedtimeGuard(22 * 60 + 30, 23 * 60, 6 * 60);
        SleepReminderStage sNoon = guard.EvaluateStage(14 * 60);        // Awake
        SleepReminderStage sWind = guard.EvaluateStage(22 * 60 + 45);   // WindDown
        SleepReminderStage sBed = guard.EvaluateStage(23 * 60 + 20);    // Bedtime
        guard.Snooze(23 * 60 + 20, 20);                                 // 延后至 23:40
        SleepReminderStage sSnoozed = guard.EvaluateStage(23 * 60 + 30);// 延后期降回 WindDown
        SleepReminderStage sLate = guard.EvaluateStage(1 * 60 + 15);    // 跨午夜超过 1h -> LateNightLock

        bool sleepOk = sNoon == SleepReminderStage.Awake
            && sWind == SleepReminderStage.WindDown
            && sBed == SleepReminderStage.Bedtime
            && sSnoozed == SleepReminderStage.WindDown
            && sLate == SleepReminderStage.LateNightLock;
        Console.WriteLine("companion-bedtime-guard: " + Convert.ToString(sleepOk ? 1 : 0));
    }
}
