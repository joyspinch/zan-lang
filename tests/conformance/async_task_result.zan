// The awaited result of a Task-shaped async method: `async Task<T>` carries
// the RESULT, not a handle -- the awaited value has the element type.
//
// The C host's parser rewrites the declared return type (`async Task<int>`
// -> `int`, `async Task` -> `void`), so the checker and the code generator
// only ever see the result type. The self-hosted compiler has to unwrap the
// same way: typed as the handle, the awaited value came out as a pointer --
// harmless for integers and strings (the inttoptr/ptrtoint round trip keeps
// the bits) but a double result landed in a double slot as a pointer, and
// clang rejected the IR outright.
using System;

class Program {
    static async Task<double> Half(double x) {
        await Task.Delay(5);
        return x / 2.0;
    }

    static async Task<string> Name() {
        await Task.Delay(5);
        return "zane";
    }

    static async Task<int> Square(int n) {
        await Task.Delay(5);
        return n * n;
    }

    static async Task Nothing() {
        await Task.Delay(5);
    }

    static void Main() {
        double d = await Half(5.0);
        string s = await Name();
        int q = await Square(7);
        await Nothing();
        Console.WriteLine("d=" + d);
        Console.WriteLine("s=" + s);
        Console.WriteLine("q=" + q);
        Console.WriteLine("async-task-result: 1");
    }
}
