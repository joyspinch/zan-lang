using System;
using System.Threading;

// B-ID97 钉子：AtomicInt 语言契约——Add/Increment/Decrement 返回加后新值，
// Exchange/CompareExchange 返回旧值。原生 rt_sync.c 与 rt_sync_wasm.c 必须同答。
class Program {
    static void Main() {
        AtomicInt a = new AtomicInt(10);
        long v1 = a.Add(5);                  // 15：新值
        long v2 = a.Increment();             // 16：新值
        long v3 = a.Decrement();             // 15：新值
        long v4 = a.Exchange(100);           // 15：旧值
        long v5 = a.CompareExchange(100, 7); // 100：旧值（命中并换成 7）
        long v6 = a.Load();                  // 7
        Console.WriteLine($"{v1} {v2} {v3} {v4} {v5} {v6}");
    }
}
