using System;

// A closure written inside an instance method sees the receiver: the C host
// captures `this` in the closure's display class, the self-hosted backend
// lowers it into one more env slot.
class Counter {
    int n;
    int[] buf;
    public Counter(int k) { n = k; buf = new int[k]; }
    public Func<int> GetN() { return () => n; }
    public Func<int> GetLen() { return () => buf.Length; }
    // a nested closure: the inner one captures the receiver of the outer one
    public Func<int, int> GetPicker() {
        return (int x) => {
            Func<int> inner = () => buf.Length;
            return inner() + x;
        };
    }
}

class Program {
    static void Main() {
        Counter c = new Counter(3);
        Func<int> fn = c.GetN();
        Console.WriteLine("n=" + Convert.ToString(fn()));
        Func<int> fl = c.GetLen();
        Console.WriteLine("len=" + Convert.ToString(fl()));
        Func<int, int> p = c.GetPicker();
        Console.WriteLine("p=" + Convert.ToString(p(5)));
    }
}
