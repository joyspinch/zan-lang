// `new T(args)` evaluates the arguments before allocating the object, and
// recursive allocators are proven nothrow (S-UNWIND greatest fixpoint), so the
// late ARC pass drops the temp-stack bookkeeping and the constructor's
// retain(arg)/release(temp) pairs. Exceptions in an argument or in the
// constructor body must still release every owned temporary and the
// half-built object (the leak gate checks this case).
using System;

class Node {
    public Node l;
    public Node r;
    public string tag;
    public Node(Node a, Node b) { l = a; r = b; }
    public Node(Node a, Node b, int bad) {
        l = a;
        r = b;
        if (bad > 0) throw new Exception("ctor " + bad);
        tag = "ok";
    }
}

class Holder {
    public Node n = new Node(null, null);
    public Holder(Node x) { n = x; }
}

class P {
    static int made = 0;
    static Node Make(int d) {
        made++;
        if (d == 0) return new Node(null, null);
        return new Node(Make(d - 1), Make(d - 1));
    }
    static Node Boom(int d) {
        if (d == 3) throw new Exception("boom");
        return Make(d);
    }
    static int Check(Node n) {
        if (n.l == null) return 1;
        return 1 + Check(n.l) + Check(n.r);
    }
    static void Main() {
        Console.WriteLine(Check(Make(10)));
        try {
            var x = new Node(Make(4), Boom(3));
            Console.WriteLine("unreachable " + Check(x));
        } catch (Exception e) {
            Console.WriteLine(e.Message);
        }
        try {
            var x = new Node(Make(4), Make(3), 7);
            Console.WriteLine("unreachable " + Check(x));
        } catch (Exception e) {
            Console.WriteLine(e.Message);
        }
        var h = new Holder(Make(2));
        Console.WriteLine(Check(h.n));
        var y = new Node(Make(1), Make(1), 0);
        Console.WriteLine(y.tag + Check(y));
        Node chain = null;
        for (int i = 0; i < 200000; i++) chain = new Node(chain, null);
        int len = 0;
        for (Node c = chain; c != null; c = c.l) len++;
        Console.WriteLine(len);
        chain = null;
        Console.WriteLine(made);
    }
}
