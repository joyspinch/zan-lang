using System;

class Root {
    public string trace;
    public Root() { this.trace = "R"; }
}

class Chain : Root {
    public int code;

    public Chain() : this(7) {
        this.trace = this.trace + ":Z";
    }

    public Chain(int n) : this("I" + Convert.ToString(n)) {
        this.code = n;
    }

    public Chain(string text) {
        this.trace = this.trace + ":" + text;
    }
}

class GenericChain<T> {
    public string trace;

    public GenericChain() : this("G") {
        this.trace = this.trace + ":Z";
    }

    public GenericChain(int n) {
        this.trace = "I" + Convert.ToString(n);
    }

    public GenericChain(string text) {
        this.trace = text;
    }
}

class Program {
    static void Main() {
        Chain c = new Chain();
        Chain fromInt = new Chain(3);
        Chain fromString = new Chain("Q");
        GenericChain<int> generic = new GenericChain<int>();
        GenericChain<int> genericInt = new GenericChain<int>(4);
        GenericChain<int> genericString = new GenericChain<int>("S");
        Console.WriteLine(c.trace);
        Console.WriteLine(c.code);
        Console.WriteLine(fromInt.trace);
        Console.WriteLine(fromInt.code);
        Console.WriteLine(fromString.trace);
        Console.WriteLine(fromString.code);
        Console.WriteLine(generic.trace);
        Console.WriteLine(genericInt.trace);
        Console.WriteLine(genericString.trace);
    }
}
