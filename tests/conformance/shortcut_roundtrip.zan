// Shortcut test: create a .lnk in the temp dir, read it back and compare
// target/arguments/working-dir/icon; then delete it.
using System;
using System.Diagnostics;
using System.IO;

namespace Conf;

class Prog {
    static void Main() {
        int bad = 0;
        string lnk = Path.Combine(KnownFolders.Temp(),
            "zan_lnk_" + Convert.ToString(ProcessList.SelfPid()) + ".lnk");
        string target = "C:\\Windows\\System32\\notepad.exe";
        string args = "\"C:\\test file.txt\"";
        string work = "C:\\Windows\\System32";
        string icon = "C:\\Windows\\System32\\notepad.exe";
        bool created = Shortcut.Create(lnk, target, args, work, icon, 0, "zan test");
        if (!created) { bad = bad + 1; }
        if (!File.Exists(lnk)) { bad = bad + 1; }
        ShortcutInfo info = Shortcut.Read(lnk);
        if (info.target != target) { bad = bad + 1; }
        if (info.arguments != args) { bad = bad + 1; }
        if (info.workingDir != work) { bad = bad + 1; }
        if (info.iconPath != icon) { bad = bad + 1; }
        if (File.Exists(lnk)) { File.Delete(lnk); }
        Console.WriteLine("lnk-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
