using System;

class Stat<T> {
    public static int s;
    public static int n = 100;
    public static int F() { return Stat<T>.s + 1; }
    public static void Bump() { Stat<T>.s = Stat<T>.s + 1; }
}

class Program {
    static int Main() {
        Stat<int>.s = 3;
        Stat<double>.s = 4;
        Stat<string>.s = 5;
        Stat<int>.Bump();
        Console.WriteLine("i=" + Convert.ToString(Stat<int>.s));
        Console.WriteLine("d=" + Convert.ToString(Stat<double>.s));
        Console.WriteLine("s=" + Convert.ToString(Stat<string>.s));
        Console.WriteLine("f=" + Convert.ToString(Stat<double>.F()));
        Console.WriteLine("n=" + Convert.ToString(Stat<int>.n) + "," +
                          Convert.ToString(Stat<string>.n));
        return 0;
    }
}
