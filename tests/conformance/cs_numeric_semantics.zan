using System;

// C# 语义钉子（编译器运行时复审，2026-10-23 批次）：
//   三元公共提升型（A514）、?? 短路（A515）、银行家舍入（A513）、
//   decimal 28 位除法/末位进位/去尾零（A511①）、Convert.ToInt32(bool)=1（A498）、
//   WriteLine(decimal)（A511③）。期望值按 .NET 8 实测。
class Program {
    static int calls = 0;
    static string Side() { calls = calls + 1; return "side"; }

    public static void Main() {
        bool t = true;
        double d1 = (t ? 1 : 2.0) / 2;
        Console.WriteLine(d1);             // C#: 0.5（int/double 合并为 double）
        double d2 = (!t ? 1 : 2.0) / 2;
        Console.WriteLine(d2);             // C#: 1

        string s = "s";
        string nn = s ?? Side();           // 非 null：右支不求值
        Console.WriteLine(nn);
        Console.WriteLine(calls);          // C#: 0
        string x = null;
        Console.WriteLine(x ?? Side());    // null：右支求值
        Console.WriteLine(calls);          // C#: 1

        Console.WriteLine(Math.Round(2.5));          // C#: 2（银行家）
        Console.WriteLine(Math.Round(0.5));          // C#: 0
        Console.WriteLine(Math.Round(3.5));          // C#: 4
        Console.WriteLine(Convert.ToInt32(3.9));     // C#: 4（舍入非截断）
        Console.WriteLine(Convert.ToInt32(true));    // C#: 1（bool 零扩展）

        Console.WriteLine(Decimal.ToString(1m / 3m));   // C#: 28 位
        Console.WriteLine(Decimal.ToString(2m / 3m));   // C#: 尾位进位 …6667
        Console.WriteLine(Decimal.ToString(10m / 4m));  // C#: 2.5（去尾零）
        Console.WriteLine(Decimal.ToInt64(2.9m));       // C#: 3
        Console.WriteLine(Decimal.ToInt64(2.5m));       // C#: 2（银行家）

        Console.WriteLine(0.1m + 0.2m);    // C#: 0.3（decimal 精确）
    }
}
