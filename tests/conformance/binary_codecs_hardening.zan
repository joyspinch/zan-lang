using System;
using System.Json;
using System.Bson;
using System.Cbor;

class Program {
    static void Main() {
        Console.WriteLine("=== BSON & CBOR CODECS HARDENING TEST ===");

        // 1. System.Bson
        Console.WriteLine("-- 1. Bson --");
        JsonValue bDoc = JsonValue.NewObject();
        bDoc.Put("name", JsonValue.NewStr("ZanEdgeNode"));
        bDoc.Put("code", JsonValue.NewInt(4200));
        bDoc.Put("online", JsonValue.NewBool(true));

        byte[] bBytes = Bson.Pack(bDoc);
        Console.WriteLine("Bson packed bytes length: " + Convert.ToString(bBytes.Length));

        JsonValue bUnpacked = Bson.Unpack(bBytes);
        if (bUnpacked != null) {
            JsonValue nameVal = bUnpacked.Get("name");
            if (nameVal != null) {
                Console.WriteLine("Bson unpacked name: " + nameVal.strVal);
            }
            JsonValue codeVal = bUnpacked.Get("code");
            if (codeVal != null) {
                Console.WriteLine("Bson unpacked code: " + Convert.ToString((int)codeVal.numI));
            }
            JsonValue onlineVal = bUnpacked.Get("online");
            if (onlineVal != null) {
                Console.WriteLine("Bson unpacked online: " + Convert.ToString(onlineVal.boolVal));
            }
        }

        // 2. System.Cbor
        Console.WriteLine("-- 2. Cbor --");
        JsonValue cObj = JsonValue.NewObject();
        cObj.Put("device", JsonValue.NewStr("Gateway-Alpha"));
        cObj.Put("rssi", JsonValue.NewInt(-65));

        byte[] cBytes = Cbor.Encode(cObj);
        Console.WriteLine("Cbor encoded bytes length: " + Convert.ToString(cBytes.Length));

        JsonValue cDecoded = Cbor.Decode(cBytes);
        if (cDecoded != null) {
            JsonValue devVal = cDecoded.Get("device");
            if (devVal != null) {
                Console.WriteLine("Cbor decoded device: " + devVal.strVal);
            }
            JsonValue rssiVal = cDecoded.Get("rssi");
            if (rssiVal != null) {
                Console.WriteLine("Cbor decoded rssi: " + Convert.ToString((int)rssiVal.numI));
            }
        }

        Console.WriteLine("ALL BSON & CBOR CODECS CHECKS PASSED!");
    }
}
