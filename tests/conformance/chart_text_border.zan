// A14: 文本描边/阴影 textBorder* / textShadow*（ECharts
// label/labelStyle.ts:522,550-612；zrender stroke 字形 = SVG
// paint-order:stroke，描边在填充之下）。
// 系统底层交互与数据流转契约
// 仅 examples）——bar-rich-text 摘要卡白字无 #333 2px 描边、
// 核心契约与语义定义。
// 图表配置契约与样式属性适配规范
// 丢失。本用例钉死解析与渲染判定两层（渲染侧 DrawTextStyled 的
// 决策——是否有描边/影子——由返回前的画布调用次序保证，无头环境
// 逐像素断言描边色环；这里断言纯数据 + 决策入口）：
// ①label 级：textBorderColor/Width、textShadow* 四键进
// 核心契约与语义定义。
// ②rich 段级：text-options 的 textBorder/textShadow 段、
// bar-rich-text 的 a/c 段逐段进 ChartRichStyle；
// ③未声明宽度 = -1（DrawTextStyled 判 tbWidth>0 才描——
// matrix-confusion 的 value 段 textBorderWidth:0 不描边）；
// 图表配置契约与样式属性适配规范
// ⑤Clone 全量携带（label 级 + rich 段级）。
// JSON 内联：ctest 从 build 目录跑，仓库相对路径取不到。
using System;
using Gui.Component.Chart;

namespace Conf;

class Program {
    static void Main() {
        // ①label 级解析（label-position：#000 3px）。
        ChartOption o = ChartOption.FromJson("{\"xAxis\":{\"type\":\"value\",\"min\":-1,\"max\":1},\"yAxis\":{\"type\":\"value\",\"min\":-1,\"max\":1},\"series\":[{\"type\":\"scatter\",\"symbolSize\":1,\"label\":{\"show\":true,\"formatter\":\"Label Text\",\"textBorderColor\":\"#000\",\"textBorderWidth\":3},\"data\":[{\"value\":[0,0]}]}]}");
        ChartTextStyle lb = o.series[0].label;
        Console.WriteLine("lp|tb=" + Convert.ToString(lb.tbColor)
            + "," + Convert.ToString(lb.tbWidth)
            + "|ts=" + Convert.ToString(lb.tsColor));

        // ②rich 段级（text-options 的 textBorder/textShadow 段）。
        ChartOption o2 = ChartOption.FromJson("{\"xAxis\":{\"type\":\"value\",\"min\":-1,\"max\":1},\"yAxis\":{\"type\":\"value\",\"min\":-1,\"max\":1},\"series\":[{\"type\":\"scatter\",\"symbolSize\":1,\"data\":[{\"value\":[0,0],\"label\":{\"show\":true,\"formatter\":\"{textBorder|B}{textShadow|S}\",\"rich\":{\"textBorder\":{\"fontSize\":20,\"textBorderColor\":\"#000\",\"textBorderWidth\":3,\"color\":\"#fff\"},\"textShadow\":{\"fontSize\":16,\"textShadowBlur\":5,\"textShadowColor\":\"#000\",\"textShadowOffsetX\":3,\"textShadowOffsetY\":3,\"color\":\"#fff\"}}}}]}]}");
        List<ChartRichStyle> rich = o2.series[0].data[0].dlabel.rich;
        Console.WriteLine("richN=" + Convert.ToString(rich.Count));
        Console.WriteLine("r0|" + rich[0].name + "|tb=" + Convert.ToString(rich[0].tbColor)
            + "," + Convert.ToString(rich[0].tbWidth)
            + "|col=" + Convert.ToString(rich[0].color));
        Console.WriteLine("r1|" + rich[1].name + "|ts=" + Convert.ToString(rich[1].tsColor)
            + "," + Convert.ToString(rich[1].tsBlur)
            + "," + Convert.ToString(rich[1].tsDx)
            + "," + Convert.ToString(rich[1].tsDy));

        // ③textBorderWidth:0 是显式零 → 不描边（宽度 0，颜色可非 0）。
        ChartOption o3 = ChartOption.FromJson("{\"xAxis\":{},\"yAxis\":{},\"series\":[{\"type\":\"scatter\",\"symbolSize\":1,\"data\":[{\"value\":[0,0],\"label\":{\"show\":true,\"formatter\":\"{value|V}\",\"rich\":{\"value\":{\"color\":\"#444\",\"textBorderWidth\":0,\"fontSize\":16}}}}]}]}");
        Console.WriteLine("zero|" + Convert.ToString(o3.series[0].data[0].dlabel.rich[0].tbWidth));

        // ④geo.label 文本样式（geo-graph：白字 #fff 2px 描边）。
        ChartOption o4 = ChartOption.FromJson("{\"geo\":{\"map\":\"ch\",\"roam\":true,\"label\":{\"show\":true,\"textBorderColor\":\"#fff\",\"textBorderWidth\":2}},\"series\":[]}");
        ChartTextStyle gls = o4.geos[0].labelSt;
        Console.WriteLine("geo|tb=" + Convert.ToString(gls.tbColor)
            + "," + Convert.ToString(gls.tbWidth)
            + "|show=" + (o4.geos[0].labelShow ? "1" : "0"));

        // ⑤Clone：label 级 + rich 段级全量携带。
        ChartSeries src = o.series[0];
        ChartSeries cp = ChartSeries.Clone(src);
        Console.WriteLine("clone|tb=" + Convert.ToString(cp.label.tbColor)
            + "," + Convert.ToString(cp.label.tbWidth));
        ChartOption o2c = ChartOption.Clone(o2);
        if (o2c == null || o2c.series.Count < 1) { Console.WriteLine("cloneRich|null"); }
        else {
            List<ChartRichStyle> crich = o2c.series[0].data[0].dlabel.rich;
            Console.WriteLine("cloneRich|tb=" + Convert.ToString(crich[0].tbColor)
                + ",ts=" + Convert.ToString(crich[1].tsDx));
        }

        // ⑥同段双效（bar-rich-text a 段形态：textShadowBlur 2
        // offset (0,1) + textBorder #333 2px）。
        ChartOption o5 = ChartOption.FromJson("{\"xAxis\":{},\"yAxis\":{},\"series\":[{\"type\":\"scatter\",\"symbolSize\":1,\"data\":[{\"value\":[0,0],\"label\":{\"show\":true,\"formatter\":\"V\",\"textBorderColor\":\"#333\",\"textBorderWidth\":2,\"textShadowColor\":\"#000\",\"textShadowBlur\":2,\"textShadowOffsetY\":1}}]}]}");
        ChartTextStyle st = o5.series[0].data[0].dlabel;
        Console.WriteLine("both|tb=" + Convert.ToString(st.tbColor)
            + "," + Convert.ToString(st.tbWidth)
            + "|ts=" + Convert.ToString(st.tsColor)
            + "," + Convert.ToString(st.tsBlur)
            + "," + Convert.ToString(st.tsDx)
            + "," + Convert.ToString(st.tsDy));

        Console.WriteLine("chart_text_border_test: OK");
    }
}
