using System;
using System.Collections.Generic;

// A field initializer is a statement of its own: the store retains the
// value and the initializer's owned temporary (`new H()`) is released after
// it (B-ID199 round 8: gen1 never released it, so every object built with
// `public H State = new H();` kept State alive for good).
class H { public List<int> Undo = new List<int>(); }
class O { public H State = new H(); }
class O2 { public H State; public O2() { State = new H(); } }
class Derived : O { public H Extra = new H(); }
class W { public weak H Hist; public weak H Extra; }
class Program {
    static void Take(H h, W w) { w.Hist = h; }
    static void A(W w) { O o = new O(); w.Hist = o.State; }
    static void B(W w) { O o = new O(); Take(o.State, w); }
    static void C(W w) { O2 o = new O2(); w.Hist = o.State; }
    static void D(W w) { Derived d = new Derived(); w.Hist = d.State; w.Extra = d.Extra; }
    static void Main() {
        W w = new W(); A(w); Console.WriteLine("initializer " + (w.Hist == null).ToString());
        w = new W(); B(w); Console.WriteLine("initializer argument " + (w.Hist == null).ToString());
        w = new W(); C(w); Console.WriteLine("constructor " + (w.Hist == null).ToString());
        w = new W(); D(w); Console.WriteLine("base and derived " + (w.Hist == null && w.Extra == null).ToString());
    }
}
