using System;
using Gui;
using Gui.Component.Chart;

namespace Conf;

// VennLayout 纯几何：半径按面积比例、重叠千分比、圆心距
// （相离/相交/包含/钳制）、标签锚点、hidden 排除、确定性。
class Program {
    static void Main() {
        // A=[A=40, B=40, I=16]：重叠 400‰，d=(200*600)/1000=120。
        List<ChartData> merged = new List<ChartData>{
            ChartData.NamedNumber(40, "A"), ChartData.NamedNumber(40, "B"),
            ChartData.NamedNumber(16, "I") };
        VennLayout m = VennLayout.Of(merged, 100, 10, 0, 0);

        // B=[A=10, B=40, I=4]：rA=50（面积比例），重叠 400‰，d=90。
        List<ChartData> half = new List<ChartData>{
            ChartData.NamedNumber(10, "A"), ChartData.NamedNumber(40, "B"),
            ChartData.NamedNumber(4, "I") };
        VennLayout h = VennLayout.Of(half, 100, 10, 0, 0);

        // C=[A=40, B=40, I=0]：相离，d = 200 + gap = 210。
        List<ChartData> apart = new List<ChartData>{
            ChartData.NamedNumber(40, "A"), ChartData.NamedNumber(40, "B"),
            ChartData.NamedNumber(0, "I") };
        VennLayout c = VennLayout.Of(apart, 100, 10, 0, 0);

        // D=[A=40, B=10, I=20]：vI >= vMin → 包含，d=|rA-rB|*3/4=37。
        List<ChartData> inside = new List<ChartData>{
            ChartData.NamedNumber(40, "A"), ChartData.NamedNumber(10, "B"),
            ChartData.NamedNumber(20, "I") };
        VennLayout d = VennLayout.Of(inside, 100, 10, 0, 0);

        // E=单圆 [40]：d = rA + 0 + gap = 110。
        List<ChartData> single = new List<ChartData>{ ChartData.NamedNumber(40, "A") };
        VennLayout e = VennLayout.Of(single, 100, 10, 0, 0);

        // F=全零：无圆。
        List<ChartData> zero = new List<ChartData>{
            ChartData.Of(0), ChartData.Of(0), ChartData.Of(0) };
        VennLayout f = VennLayout.Of(zero, 100, 10, 0, 0);

        // G=hidden 交集：vI 按 0 处理 → 相离 d=210。
        List<ChartData> hc = new List<ChartData>{
            ChartData.NamedNumber(40, "A"), ChartData.NamedNumber(40, "B"),
            ChartData.NamedNumber(16, "I") };
        hc[2].hidden = true;
        VennLayout g = VennLayout.Of(hc, 100, 10, 0, 0);

        Console.WriteLine("r:" + Convert.ToString(m.a.r) + ":" + Convert.ToString(h.b.r)
            + ":" + Convert.ToString(m.b.r) + ":" + Convert.ToString(f.a.r) + ":" + Convert.ToString(f.b.r));
        Console.WriteLine("ov:" + Convert.ToString(m.overlap) + ":" + Convert.ToString(h.overlap)
            + ":" + Convert.ToString(c.overlap) + ":" + Convert.ToString(d.overlap)
            + ":" + Convert.ToString(g.overlap) + ":" + Convert.ToString(f.overlap));
        Console.WriteLine("d:" + Convert.ToString(m.d) + ":" + Convert.ToString(h.d)
            + ":" + Convert.ToString(c.d) + ":" + Convert.ToString(d.d)
            + ":" + Convert.ToString(e.d) + ":" + Convert.ToString(f.d) + ":" + Convert.ToString(g.d));
        Console.WriteLine("ct:" + Convert.ToString(ChartConf.B(m.contained))
            + ":" + Convert.ToString(ChartConf.B(h.contained))
            + ":" + Convert.ToString(ChartConf.B(c.contained))
            + ":" + Convert.ToString(ChartConf.B(d.contained))
            + ":" + Convert.ToString(ChartConf.B(f.contained)));
        Console.WriteLine("cx:" + Convert.ToString(m.a.cx) + ":" + Convert.ToString(m.b.cx)
            + ":" + Convert.ToString(d.a.cx) + ":" + Convert.ToString(d.b.cx)
            + ":" + Convert.ToString(e.a.cx) + ":" + Convert.ToString(e.b.cx)
            + ":" + Convert.ToString(f.a.cx) + ":" + Convert.ToString(f.b.cx));
        Console.WriteLine("anchors:" + Convert.ToString(m.ax) + ":" + Convert.ToString(m.bx)
            + ":" + Convert.ToString(m.ix) + ":" + Convert.ToString(d.ax)
            + ":" + Convert.ToString(d.bx) + ":" + Convert.ToString(d.ix)
            + ":" + Convert.ToString(f.ax) + ":" + Convert.ToString(f.bx) + ":" + Convert.ToString(f.ix));
        Console.WriteLine("ay:" + Convert.ToString(m.ay) + ":" + Convert.ToString(m.by)
            + ":" + Convert.ToString(m.iy));

        // 确定性：相同输入两次调用结果一致。
        VennLayout m2 = VennLayout.Of(merged, 100, 10, 0, 0);
        Console.WriteLine("det:" + Convert.ToString(ChartConf.B(m.d == m2.d
            && m.a.r == m2.a.r && m.b.r == m2.b.r && m.ax == m2.ax && m.bx == m2.bx)));

        // hidden A：vA=0 → 只有 B 有圆，d = rB + gap = 110。
        List<ChartData> hA = new List<ChartData>{
            ChartData.NamedNumber(40, "A"), ChartData.NamedNumber(40, "B"),
            ChartData.NamedNumber(16, "I") };
        hA[0].hidden = true;
        VennLayout hh = VennLayout.Of(hA, 100, 10, 0, 0);
        Console.WriteLine("hA:" + Convert.ToString(hh.a.r) + ":" + Convert.ToString(hh.b.r)
            + ":" + Convert.ToString(hh.d));

        // 绘图区适配：最坏相离布局的外接宽度 4*r+gap 不得越过 areaW。
        int fitR = ChartView.VennRadius(1000, 1000, 10);
        int fitGap = fitR / 8;
        if (fitGap < 10) { fitGap = 10; }
        Console.WriteLine("fit:" + Convert.ToString(fitR) + ":"
            + ChartConf.B(4 * fitR + fitGap <= 1000));
    }
}

class ChartConf {
    static string B(bool v) {
        if (v) { return "1"; }
        return "0";
    }
}
