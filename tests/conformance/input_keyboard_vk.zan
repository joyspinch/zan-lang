// Keyboard.VK / VKName tables are pure functions with no OS interaction, so
// they are fully deterministic and testable on every platform. The named
// modifiers, navigation keys, function keys and single letters/digits must
// round-trip: VK(name) -> code -> VKName(code) -> same name (or equivalent).
using System;
using System.Input;

namespace Conf;

class Prog {
    static int Fail(string what, int got) {
        Console.WriteLine("FAIL: " + what + " = " + Convert.ToString(got));
        return 1;
    }

    static void Main() {
        int bad = 0;
        // Modifiers and navigation keys.
        if (Keyboard.VK("Ctrl") != 0x11) { bad = bad + Prog.Fail("Ctrl", Keyboard.VK("Ctrl")); }
        if (Keyboard.VK("shift") != 0x10) { bad = bad + Prog.Fail("shift", Keyboard.VK("shift")); }
        if (Keyboard.VK("Alt") != 0x12) { bad = bad + Prog.Fail("Alt", Keyboard.VK("Alt")); }
        if (Keyboard.VK("Enter") != 0x0D) { bad = bad + Prog.Fail("Enter", Keyboard.VK("Enter")); }
        if (Keyboard.VK("Esc") != 0x1B) { bad = bad + Prog.Fail("Esc", Keyboard.VK("Esc")); }
        if (Keyboard.VK("Tab") != 0x09) { bad = bad + Prog.Fail("Tab", Keyboard.VK("Tab")); }
        if (Keyboard.VK("Space") != 0x20) { bad = bad + Prog.Fail("Space", Keyboard.VK("Space")); }
        if (Keyboard.VK("Delete") != 0x2E) { bad = bad + Prog.Fail("Delete", Keyboard.VK("Delete")); }
        if (Keyboard.VK("Home") != 0x24) { bad = bad + Prog.Fail("Home", Keyboard.VK("Home")); }
        if (Keyboard.VK("PageUp") != 0x21) { bad = bad + Prog.Fail("PageUp", Keyboard.VK("PageUp")); }
        if (Keyboard.VK("Up") != 0x26) { bad = bad + Prog.Fail("Up", Keyboard.VK("Up")); }
        if (Keyboard.VK("F5") != 0x74) { bad = bad + Prog.Fail("F5", Keyboard.VK("F5")); }
        if (Keyboard.VK("F12") != 0x7B) { bad = bad + Prog.Fail("F12", Keyboard.VK("F12")); }
        // Single letters / digits.
        if (Keyboard.VK("A") != 0x41) { bad = bad + Prog.Fail("A", Keyboard.VK("A")); }
        if (Keyboard.VK("z") != 0x5A) { bad = bad + Prog.Fail("z", Keyboard.VK("z")); }
        if (Keyboard.VK("0") != 0x30) { bad = bad + Prog.Fail("0", Keyboard.VK("0")); }
        if (Keyboard.VK("9") != 0x39) { bad = bad + Prog.Fail("9", Keyboard.VK("9")); }
        // Unknown names resolve to 0, never a crash.
        if (Keyboard.VK("NoSuchKey") != 0) { bad = bad + Prog.Fail("NoSuchKey", Keyboard.VK("NoSuchKey")); }
        if (Keyboard.VK("") != 0) { bad = bad + Prog.Fail("empty", Keyboard.VK("")); }
        // Reverse names.
        if (Keyboard.VKName(0x11) != "Ctrl") { bad = bad + Prog.Fail("VKName(0x11)", 0); }
        if (Keyboard.VKName(0x41) != "A") { bad = bad + Prog.Fail("VKName(0x41)", 0); }
        if (Keyboard.VKName(0x30) != "0") { bad = bad + Prog.Fail("VKName(0x30)", 0); }
        if (Keyboard.VKName(0x74) != "F5") { bad = bad + Prog.Fail("VKName(0x74)", 0); }
        if (Keyboard.VKName(0x1234) != "VK-0x1234") { bad = bad + Prog.Fail("VKName(0x1234)", 0); }
        Console.WriteLine("vk-ok: " + Convert.ToString(bad == 0 ? 1 : 0));
    }
}
