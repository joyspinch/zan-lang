using System;

class Fp2IntOverflow {
    static void Main() {
        double nan = 0.0 / 0.0;
        double pinf = 1.0 / 0.0;
        double ninf = -1.0 / 0.0;
        double huge = 1.0e300;

        // try 外：soft 报告 + 定义值（clamp：上越界→MAX、下越界→MIN、NaN→0）
        long a = (long)nan;
        long b = (long)pinf;
        long c = (long)ninf;
        long d = (long)huge;
        Console.WriteLine("out cast nan=" + a);
        Console.WriteLine("out cast pinf=" + b);
        Console.WriteLine("out cast ninf=" + c);
        Console.WriteLine("out cast huge=" + d);
        long e = Convert.ToInt64(nan);
        long f = Convert.ToInt64(huge);
        Console.WriteLine("out conv nan=" + e);
        Console.WriteLine("out conv huge=" + f);

        // 三元统一通道
        bool flag = true;
        long g = flag ? (long)pinf : 0L;
        Console.WriteLine("out tern pinf=" + g);

        // 窄目标域外值：定义化（旧 fptosi poison 域）
        int j = (int)2147483648.0;
        byte k = (byte)300.0;
        Console.WriteLine("out narrow i32=" + j + " byte=" + k);

        // 域内回归对照：截断向零，逐位不变
        long m = (long)3.9;
        int n = (int)-7.2;
        Console.WriteLine("norm long3.9=" + m + " int-7.2=" + n);
        byte p = (byte)200.9;
        sbyte q = (sbyte)-100.5;
        Console.WriteLine("norm byte200.9=" + p + " sbyte-100.5=" + q);

        // try 内：OverflowException 分发
        try {
            long h = (long)pinf;
            Console.WriteLine("in cast no-throw " + h);
        } catch (OverflowException) {
            Console.WriteLine("in cast OverflowException");
        }
        try {
            long i = Convert.ToInt64(huge);
            Console.WriteLine("in conv no-throw " + i);
        } catch (OverflowException) {
            Console.WriteLine("in conv OverflowException");
        }
        try {
            int w = (int)nan;
            Console.WriteLine("in narrow no-throw " + w);
        } catch (OverflowException) {
            Console.WriteLine("in narrow OverflowException");
        }
    }
}
