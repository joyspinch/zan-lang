// (string)v and (object)v casts parse like the other built-in type casts:
// the cast dispatch used to miss the string/object keywords, so the paren
// fell through to the expression path and was rejected. object -> string ->
// object round-trips preserve the value.
using System;

class Program {
    static int Main() {
        object o = "hello";
        string s = (string)o;
        Console.WriteLine(s);
        object o2 = (object)s;
        Console.WriteLine((string)o2);
        object boxed = (object)"round";
        Console.WriteLine((string)boxed);
        return 0;
    }
}
