// 核心契约与语义定义。
using System;

class Program {
    static int Main() {
        object o = "hello";
        string s = (string)o;
        Console.WriteLine(s);
        object o2 = (object)s;
        Console.WriteLine((string)o2);
        object boxed = (object)"round";
        Console.WriteLine((string)boxed);
        return 0;
    }
}
