using System;

// A closure inside an async method: the captured local is written after the
// capture, so the closure must observe the new value (C# semantics).
class Program {
    static async void Main() {
        int x = 1;
        Func<int> f = () => x;
        x = 2;
        await Task.Delay(1);
        Console.WriteLine("f=" + Convert.ToString(f()));
    }
}
