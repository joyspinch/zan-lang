using System;

// A closure inside an async method captures by reference (C# semantics): a
// write to the captured local after the capture is visible inside the closure,
// and a write from inside the closure is visible outside -- also across an
// await, because the captured local lives in a heap cell that survives the
// suspension.
class Program {
    static async void Main() {
        // a write after the capture is visible inside the closure
        int x = 1;
        Func<int> f = () => x;
        x = 2;
        await Task.Delay(1);
        Console.WriteLine("f=" + Convert.ToString(f()));

        // a write from inside the closure is visible outside
        int y = 10;
        Action setY = () => { y = 20; };
        setY();
        Console.WriteLine("y=" + Convert.ToString(y));

        // a write after the suspension is visible inside the closure
        int z = 1;
        Func<int> g = () => z;
        await Task.Delay(1);
        z = 3;
        Console.WriteLine("g=" + Convert.ToString(g()));

        // two captured variables
        int a = 1;
        int b = 2;
        Func<int> h = () => a + b;
        a = 10;
        b = 20;
        Console.WriteLine("h=" + Convert.ToString(h()));
    }
}
