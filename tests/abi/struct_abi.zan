using System;

/// Struct-by-value externs: each shape is declared with the register/memory
/// form the platform C compiler uses, checked per target against the
/// declarations clang emits for the same C signatures.

[StructLayout] struct I8 { sbyte f0; }
[StructLayout] struct I32 { int f0; }
[StructLayout] struct P8 { int f0; int f1; }
[StructLayout] struct P12 { int f0; int f1; int f2; }
[StructLayout] struct S3 { sbyte f0; sbyte f1; sbyte f2; }
[StructLayout] struct S9 { sbyte f0; sbyte f1; sbyte f2; sbyte f3; sbyte f4; sbyte f5; sbyte f6; sbyte f7; sbyte f8; }
[StructLayout] struct F8 { float f0; float f1; }
[StructLayout] struct FRect { float f0; float f1; float f2; float f3; }
[StructLayout] struct F12 { float f0; float f1; float f2; }
[StructLayout] struct D16 { double f0; double f1; }
[StructLayout] struct D24 { double f0; double f1; double f2; }
[StructLayout] struct Mix16 { int f0; long f1; }
[StructLayout] struct MixFI { float f0; int f1; }
[StructLayout] struct MixIF { int f0; float f1; }
[StructLayout] struct MixLD { long f0; double f1; }
[StructLayout] struct MixDL { double f0; long f1; }
[StructLayout] struct MixDII { double f0; int f1; int f2; }
[StructLayout] struct Ptr12 { nint f0; int f1; }
[StructLayout] struct Ptr16 { nint f0; nint f1; }
[StructLayout] struct Ptr20 { nint f0; nint f1; int f2; }

class N {
    [DllImport("abi_probe")] static extern int i8_take(I8 v);
    [DllImport("abi_probe")] static extern I8 i8_make(int x);
    static int TI8(I8 v) { return i8_take(v); }
    static I8 MI8(int x) { return i8_make(x); }
    [DllImport("abi_probe")] static extern int i32_take(I32 v);
    [DllImport("abi_probe")] static extern I32 i32_make(int x);
    static int TI32(I32 v) { return i32_take(v); }
    static I32 MI32(int x) { return i32_make(x); }
    [DllImport("abi_probe")] static extern int p8_take(P8 v);
    [DllImport("abi_probe")] static extern P8 p8_make(int x);
    static int TP8(P8 v) { return p8_take(v); }
    static P8 MP8(int x) { return p8_make(x); }
    [DllImport("abi_probe")] static extern int p12_take(P12 v);
    [DllImport("abi_probe")] static extern P12 p12_make(int x);
    static int TP12(P12 v) { return p12_take(v); }
    static P12 MP12(int x) { return p12_make(x); }
    [DllImport("abi_probe")] static extern int s3_take(S3 v);
    [DllImport("abi_probe")] static extern S3 s3_make(int x);
    static int TS3(S3 v) { return s3_take(v); }
    static S3 MS3(int x) { return s3_make(x); }
    [DllImport("abi_probe")] static extern int s9_take(S9 v);
    [DllImport("abi_probe")] static extern S9 s9_make(int x);
    static int TS9(S9 v) { return s9_take(v); }
    static S9 MS9(int x) { return s9_make(x); }
    [DllImport("abi_probe")] static extern int f8_take(F8 v);
    [DllImport("abi_probe")] static extern F8 f8_make(int x);
    static int TF8(F8 v) { return f8_take(v); }
    static F8 MF8(int x) { return f8_make(x); }
    [DllImport("abi_probe")] static extern int frect_take(FRect v);
    [DllImport("abi_probe")] static extern FRect frect_make(int x);
    static int TFRect(FRect v) { return frect_take(v); }
    static FRect MFRect(int x) { return frect_make(x); }
    [DllImport("abi_probe")] static extern int f12_take(F12 v);
    [DllImport("abi_probe")] static extern F12 f12_make(int x);
    static int TF12(F12 v) { return f12_take(v); }
    static F12 MF12(int x) { return f12_make(x); }
    [DllImport("abi_probe")] static extern int d16_take(D16 v);
    [DllImport("abi_probe")] static extern D16 d16_make(int x);
    static int TD16(D16 v) { return d16_take(v); }
    static D16 MD16(int x) { return d16_make(x); }
    [DllImport("abi_probe")] static extern int d24_take(D24 v);
    [DllImport("abi_probe")] static extern D24 d24_make(int x);
    static int TD24(D24 v) { return d24_take(v); }
    static D24 MD24(int x) { return d24_make(x); }
    [DllImport("abi_probe")] static extern int mix16_take(Mix16 v);
    [DllImport("abi_probe")] static extern Mix16 mix16_make(int x);
    static int TMix16(Mix16 v) { return mix16_take(v); }
    static Mix16 MMix16(int x) { return mix16_make(x); }
    [DllImport("abi_probe")] static extern int mixfi_take(MixFI v);
    [DllImport("abi_probe")] static extern MixFI mixfi_make(int x);
    static int TMixFI(MixFI v) { return mixfi_take(v); }
    static MixFI MMixFI(int x) { return mixfi_make(x); }
    [DllImport("abi_probe")] static extern int mixif_take(MixIF v);
    [DllImport("abi_probe")] static extern MixIF mixif_make(int x);
    static int TMixIF(MixIF v) { return mixif_take(v); }
    static MixIF MMixIF(int x) { return mixif_make(x); }
    [DllImport("abi_probe")] static extern int mixld_take(MixLD v);
    [DllImport("abi_probe")] static extern MixLD mixld_make(int x);
    static int TMixLD(MixLD v) { return mixld_take(v); }
    static MixLD MMixLD(int x) { return mixld_make(x); }
    [DllImport("abi_probe")] static extern int mixdl_take(MixDL v);
    [DllImport("abi_probe")] static extern MixDL mixdl_make(int x);
    static int TMixDL(MixDL v) { return mixdl_take(v); }
    static MixDL MMixDL(int x) { return mixdl_make(x); }
    [DllImport("abi_probe")] static extern int mixdii_take(MixDII v);
    [DllImport("abi_probe")] static extern MixDII mixdii_make(int x);
    static int TMixDII(MixDII v) { return mixdii_take(v); }
    static MixDII MMixDII(int x) { return mixdii_make(x); }
    [DllImport("abi_probe")] static extern int ptr12_take(Ptr12 v);
    [DllImport("abi_probe")] static extern Ptr12 ptr12_make(int x);
    static int TPtr12(Ptr12 v) { return ptr12_take(v); }
    static Ptr12 MPtr12(int x) { return ptr12_make(x); }
    [DllImport("abi_probe")] static extern int ptr16_take(Ptr16 v);
    [DllImport("abi_probe")] static extern Ptr16 ptr16_make(int x);
    static int TPtr16(Ptr16 v) { return ptr16_take(v); }
    static Ptr16 MPtr16(int x) { return ptr16_make(x); }
    [DllImport("abi_probe")] static extern int ptr20_take(Ptr20 v);
    [DllImport("abi_probe")] static extern Ptr20 ptr20_make(int x);
    static int TPtr20(Ptr20 v) { return ptr20_take(v); }
    static Ptr20 MPtr20(int x) { return ptr20_make(x); }
}

class Program { static void Main() { Console.WriteLine(0); } }
