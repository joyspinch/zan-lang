using System;

/// Sub-`int` externs: C promotes anything narrower than `int` at the boundary
/// and every supported target leaves that to the caller, so each declaration
/// has to carry the same `signext` / `zeroext` clang gives the C signature.
/// `char` and enums are 64-bit in Zan and take no promotion.

enum Mode { Off, On }

class N {
    [DllImport("ext_probe")] static extern sbyte i8_id(sbyte v);
    [DllImport("ext_probe")] static extern byte u8_id(byte v);
    [DllImport("ext_probe")] static extern short i16_id(short v);
    [DllImport("ext_probe")] static extern ushort u16_id(ushort v);
    [DllImport("ext_probe")] static extern bool b_id(bool v);
    [DllImport("ext_probe")] static extern int i32_id(int v);
    [DllImport("ext_probe")] static extern long i64_id(long v);
    [DllImport("ext_probe")] static extern char c_id(char v);
    [DllImport("ext_probe")] static extern int mixed(sbyte a, int b, ushort c, bool d, long e);

    static sbyte TI8(sbyte v) { return i8_id(v); }
    static byte TU8(byte v) { return u8_id(v); }
    static short TI16(short v) { return i16_id(v); }
    static ushort TU16(ushort v) { return u16_id(v); }
    static bool TB(bool v) { return b_id(v); }
    static int TI32(int v) { return i32_id(v); }
    static long TI64(long v) { return i64_id(v); }
    static char TC(char v) { return c_id(v); }
    static int TMixed(sbyte a, int b, ushort c, bool d, long e) {
        return mixed(a, b, c, d, e);
    }

    static void Main() {
        Console.WriteLine(N.TI32(1));
    }
}
