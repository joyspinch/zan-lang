using System;

delegate int Read();

class Program {
    static void Main(string[] args) {
        int value = 1;
        Read read = () => value;
        value = 42;
        Console.WriteLine(Convert.ToString(read()));

        Read readArgs = () => args.Count;
        args = new string[2];
        Console.WriteLine(Convert.ToString(readArgs()));
    }
}
