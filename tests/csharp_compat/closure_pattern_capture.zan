using System;

delegate int ReadPattern();

class Box {
    public int Value;
}

class Program {
    static void Main() {
        Box first = new Box();
        first.Value = 5;
        object item = first;
        switch (item) {
        case Box value:
            ReadPattern read = () => value.Value;
            Box second = new Box();
            second.Value = 33;
            value = second;
            Console.WriteLine(Convert.ToString(read()));
            break;
        default:
            Console.WriteLine("miss");
            break;
        }

        object rejected = item;
        bool allowPattern = rejected == null;
        switch (rejected) {
        case Box skipped when allowPattern:
            ReadPattern never = () => skipped.Value;
            Console.WriteLine(Convert.ToString(never()));
            break;
        default:
            Console.WriteLine("guard-miss");
            break;
        }
    }
}
