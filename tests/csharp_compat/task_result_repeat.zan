using System;

class Program {
    static void Main() {
        Task<int> task = Task.Run(() => 21);
        Console.WriteLine(Convert.ToString(task.Result));
        Console.WriteLine(Convert.ToString(task.Result));
        task.Wait();
        task.Wait();
        Console.WriteLine("completed=" + (task.IsCompleted ? "yes" : "no"));
    }
}
