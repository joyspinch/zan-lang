using System;
using System.Threading;

class Program {
    static AtomicInt gate;
    static AtomicInt bodyThread;

    static void Main() {
        Program.gate = new AtomicInt(0);
        Program.bodyThread = new AtomicInt(0);
        long mainThread = Thread.CurrentId();

        Task task = Task.Run(() => {
            Program.bodyThread.Store(Thread.CurrentId());
            while (Program.gate.Load() == 0) {
                Thread.Sleep(1);
            }
            Console.WriteLine("body");
        });

        Console.WriteLine("returned");
        while (Program.bodyThread.Load() == 0) {
            Thread.Sleep(1);
        }
        Console.WriteLine("same-thread=" + (mainThread == Program.bodyThread.Load() ? "yes" : "no"));
        Console.WriteLine("completed-before-release=" + (task.IsCompleted ? "yes" : "no"));
        Program.gate.Store(1);
        task.Wait();
        Console.WriteLine("completed-after-wait=" + (task.IsCompleted ? "yes" : "no"));
    }
}
