# Exercise zanc's production Linux link command with an argv-capturing linker.
# The fake linker deliberately fails; this test does not validate target ABI.
if(NOT DEFINED ZANC OR NOT DEFINED CAPTURE OR NOT DEFINED WORK)
  message(FATAL_ERROR "ZANC, CAPTURE and WORK are required")
endif()
get_filename_component(fake_dir "${CAPTURE}" DIRECTORY)
file(MAKE_DIRECTORY "${WORK}/library path")
set(ENV{ZAN_TEST_LINK_ARGV} "${WORK}/link-argv.log")
file(REMOVE "$ENV{ZAN_TEST_LINK_ARGV}")
if(CMAKE_HOST_WIN32)
  set(ENV{PATH} "${fake_dir};$ENV{PATH}")
else()
  set(ENV{PATH} "${fake_dir}:$ENV{PATH}")
endif()
set(ENV{ZAN_SHARD} 0)
set(source "${WORK}/input.zan")
file(WRITE "${source}" "class Program { static int Main() { return 0; } }\n")
set(first "${WORK}/first input.o")
set(second "${WORK}/second input.a")
# Empty inputs are intentional: only the capturing linker sees them.
file(WRITE "${first}" "")
file(WRITE "${second}" "")
execute_process(COMMAND "${ZANC}" "${source}" --no-stdlib --target linux-musl -O0
  --libpath "${WORK}/library path"
  --link-input "${first}" --link-input "${second}"
  --link-lib zan_cli_first --link-lib zan_cli_second
  -o "${WORK}/output"
  WORKING_DIRECTORY "${WORK}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 60)
file(WRITE "${WORK}/compile.log" "exit=${rc}\nstdout:\n${stdout}\nstderr:\n${stderr}")
if(NOT "${rc}" STREQUAL "1" OR NOT stderr MATCHES "linking failed")
  message(FATAL_ERROR "expected fake linker failure, got ${rc}: ${stderr}")
endif()
if(NOT EXISTS "$ENV{ZAN_TEST_LINK_ARGV}")
  message(FATAL_ERROR "production linker invocation did not reach capture helper")
endif()
file(STRINGS "$ENV{ZAN_TEST_LINK_ARGV}" captured_args)
# The compiler's executable directory uses native Windows separators while
# CMake supplies forward slashes. Compare equivalent paths after normalization.
set(args)
foreach(arg IN LISTS captured_args)
  string(REPLACE "\\" "/" arg "${arg}")
  list(APPEND args "${arg}")
endforeach()
foreach(value "${first}" "${second}" "-lzan_cli_first" "-lzan_cli_second" "-L${WORK}/library path")
  list(FIND args "${value}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "missing unsplit linker argument '${value}': ${args}")
  endif()
endforeach()
list(FIND args "${first}" first_index)
list(FIND args "${second}" second_index)
list(FIND args "--start-group" group_index)
list(FIND args "--end-group" end_index)
list(FIND args "-lzan_cli_first" first_lib)
list(FIND args "-lzan_cli_second" second_lib)
if(NOT first_index LESS second_index OR NOT second_index LESS group_index
   OR NOT group_index LESS first_lib OR NOT first_lib LESS second_lib
   OR NOT second_lib LESS end_index)
  message(FATAL_ERROR "input order or archive-group library placement changed: ${args}")
endif()
# Match only artifacts provisioned for this target; other developer bundles
# may not have been refreshed yet.
get_filename_component(compiler_dir "${ZANC}" DIRECTORY)
foreach(name libc++.a libc++abi.a libunwind.a libcompiler_rt.a)
  set(runtime "${compiler_dir}/linux-musl/${name}")
  if(EXISTS "${runtime}")
    list(FIND args "${runtime}" runtime_index)
    if(NOT group_index LESS runtime_index OR NOT runtime_index LESS end_index)
      message(FATAL_ERROR "target exception runtime missing from archive group: ${runtime}")
    endif()
  endif()
endforeach()
list(FIND args "--eh-frame-hdr" eh_header)
if(eh_header EQUAL -1)
  message(FATAL_ERROR "static exception unwinder requires an EH frame header")
endif()
if(EXISTS "${compiler_dir}/linux-musl/zanrt_mem.o")
  list(FIND args "--wrap=__malloc_allzerop" calloc_guard)
  if(calloc_guard EQUAL -1)
    message(FATAL_ERROR "musl calloc metadata guard must follow malloc interposition")
  endif()
endif()
set(crash "${compiler_dir}/linux-musl/zanrt_crash.o")
if(EXISTS "${crash}")
  list(FIND args "${crash}" crash_index)
  if(crash_index EQUAL -1)
    message(FATAL_ERROR "target crash runtime omitted from Linux link")
  endif()
endif()
message(STATUS "Linux explicit inputs and target exception runtimes reach production linker argv")
