# Inspect rebuilt Windows artifacts without compiling or launching a GUI.
# cmake -DRUNTIME_OBJECT=<build/zanrt_io.obj> [-DTARGET=win-x64]
#       [-DMEMORY_OBJECT=<build/zanrt_mem.obj>]
#       [-DDRIVER_DIR=<common staged root>] [-DOBJDUMP=<llvm-objdump>]
#       [-DREADOBJ=<llvm-readobj>]
#       -P tests/run_native_driver_sections.cmake
cmake_minimum_required(VERSION 3.16)
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT RUNTIME_OBJECT OR NOT EXISTS "${RUNTIME_OBJECT}")
  message(FATAL_ERROR "native_driver_sections: RUNTIME_OBJECT must name the rebuilt reactor object")
endif()
if(NOT DEFINED TARGET)
  set(TARGET win-x64)
endif()
if(NOT "${TARGET}" MATCHES "^win-(x64|arm64)$")
  message(FATAL_ERROR "native_driver_sections: expected a Windows driver target")
endif()
if(NOT OBJDUMP)
  find_program(OBJDUMP NAMES llvm-objdump llvm-objdump.exe)
endif()
if(NOT OBJDUMP)
  message(FATAL_ERROR "native_driver_sections: llvm-objdump is required")
endif()
if(NOT READOBJ)
  get_filename_component(_llvm_dir "${OBJDUMP}" DIRECTORY)
  find_program(READOBJ NAMES llvm-readobj llvm-readobj.exe HINTS "${_llvm_dir}")
endif()
if(NOT READOBJ)
  message(FATAL_ERROR "native_driver_sections: llvm-readobj is required")
endif()

function(read_coff path output)
  execute_process(COMMAND "${READOBJ}" --sections --symbols "${path}"
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "native_driver_sections: cannot inspect COFF ${path}\n${_out}${_err}")
  endif()
  set(${output} "${_out}" PARENT_SCOPE)
endfunction()

function(read_sections path output)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "native_driver_sections: missing artifact ${path}")
  endif()
  execute_process(COMMAND "${OBJDUMP}" --section-headers "${path}"
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "native_driver_sections: cannot inspect ${path}\n${_out}${_err}")
  endif()
  set(${output} "${_out}" PARENT_SCOPE)
endfunction()

# Inspect every archive member, including the GUI C++ member separately: a large
# C member must not mask a missing section flag in the DirectWrite recipe.
foreach(_driver zan_gui zan_image zan_audio zan_game)
  if(DRIVER_DIR)
    set(_archive "${DRIVER_DIR}/static/lib${_driver}.a")
  else()
    if(_driver STREQUAL "zan_gui")
      set(_owner "packages/Zan.Gui/src/Gui/drivers")
    elseif(_driver STREQUAL "zan_image")
      set(_owner "packages/Zan.Drawing/src/System/Drawing/Imaging/drivers")
    elseif(_driver STREQUAL "zan_audio")
      set(_owner "packages/Zan.Desktop/src/System/Media/drivers")
    else()
      set(_owner "packages/Zan.Game/src/Game/Graphics/drivers")
    endif()
    set(_archive "${_root}/${_owner}/${TARGET}/static/lib${_driver}.a")
  endif()
  read_sections("${_archive}" _sections)
  if("${TARGET}" STREQUAL "win-arm64")
    set(_format coff-arm64)
  else()
    set(_format coff-x86-64)
  endif()
  string(REGEX MATCHALL "file format [^\r\n]+" _formats "${_sections}")
  list(LENGTH _formats _count)
  set(_expected 1)
  if(_driver STREQUAL "zan_gui")
    set(_expected 2)
  endif()
  if(NOT _count EQUAL _expected)
    message(FATAL_ERROR "native_driver_sections: ${_archive} has ${_count} members, expected ${_expected}")
  endif()
  foreach(_member_format IN LISTS _formats)
    if(NOT _member_format STREQUAL "file format ${_format}")
      message(FATAL_ERROR "native_driver_sections: wrong target in ${_archive}: ${_member_format}")
    endif()
  endforeach()
  string(REGEX REPLACE "([^\r\n]*file format [^\r\n]+)" ";\\1" _members "${_sections}")
  foreach(_member IN LISTS _members)
    if(NOT _member MATCHES "file format")
      continue()
    endif()
    string(REGEX MATCHALL "[ \t][.]text[$.][^ \t\r\n]+[ \t]" _text_sections "${_member}")
    list(LENGTH _text_sections _text_count)
    # C++ inline COMDATs split even without -ffunction-sections. The default
    # .text must also be empty, and mutable globals must have their own sections.
    if(_text_count LESS 2 OR NOT _member MATCHES "[ \t][.](data|bss)[$.][^ \t\r\n]+[ \t]")
      message(FATAL_ERROR "native_driver_sections: unsplit code/data in ${_archive}\n${_member}")
    endif()
    if(_member MATCHES "[ \t][.]text[ \t]+([0-9a-fA-F]+)[ \t]")
      math(EXPR _default_text_size "0x${CMAKE_MATCH_1}")
      if(NOT _default_text_size EQUAL 0)
        message(FATAL_ERROR "native_driver_sections: monolithic .text remains in ${_archive}\n${_member}")
      endif()
    endif()
  endforeach()
  # LLD COFF GC starts non-COMDAT sections live, even if they have split names.
  # Check each member independently so a working C++ COMDAT does not hide C code
  # produced by a GNU compiler that only emits .text$ names without COMDAT.
  read_coff("${_archive}" _coff)
  string(REGEX REPLACE "([\r\n]File: [^\r\n]+)" ";\\1" _coff_members "${_coff}")
  foreach(_coff_member IN LISTS _coff_members)
    if(NOT _coff_member MATCHES "File:")
      continue()
    endif()
    string(REGEX MATCHALL "  Section [{][^}]*[}]" _coff_sections "${_coff_member}")
    set(_comdat_text_count 0)
    set(_comdat_data_count 0)
    foreach(_coff_section IN LISTS _coff_sections)
      if(_coff_section MATCHES "Name: [.]text[$.][^ \t\r\n]+[ \t]")
        math(EXPR _comdat_text_count "${_comdat_text_count} + 1")
      elseif(_coff_section MATCHES "Name: [.](data|bss|rdata)[$.][^ \t\r\n]+[ \t]")
        math(EXPR _comdat_data_count "${_comdat_data_count} + 1")
      else()
        continue()
      endif()
      if(NOT _coff_section MATCHES "IMAGE_SCN_LNK_COMDAT")
        message(FATAL_ERROR "native_driver_sections: split section cannot be GC'd by LLD in ${_archive}\n${_coff_section}")
      endif()
    endforeach()
    if(_comdat_text_count LESS 2 OR _comdat_data_count LESS 1)
      message(FATAL_ERROR "native_driver_sections: missing COMDAT code/data in ${_archive}\n${_coff_member}")
    endif()
  endforeach()
endforeach()

# The independent Windows runtime compiler can be TDM-GCC even with a Clang
# host. Its zero tables must occupy BSS, while function GC remains available.
read_sections("${RUNTIME_OBJECT}" _runtime)
if(NOT _runtime MATCHES "[ \t][.]text[$.][^ \t\r\n]+[ \t]")
  message(FATAL_ERROR "native_driver_sections: runtime lost per-function sections")
endif()
if(_runtime MATCHES "[ \t][.](data|bss)[$.][^ \t\r\n]+[ \t]")
  message(FATAL_ERROR "native_driver_sections: runtime still uses per-data sections\n${_runtime}")
endif()
if(NOT _runtime MATCHES "[ \t][.]bss[ \t]+([0-9a-fA-F]+)[ \t]")
  message(FATAL_ERROR "native_driver_sections: runtime has no BSS section")
endif()
math(EXPR _bss_size "0x${CMAKE_MATCH_1}")
if(_bss_size EQUAL 0)
  message(FATAL_ERROR "native_driver_sections: runtime zero tables have no BSS storage")
endif()
if(DEFINED MEMORY_OBJECT)
  if(NOT EXISTS "${MEMORY_OBJECT}")
    message(FATAL_ERROR "native_driver_sections: MEMORY_OBJECT does not exist: ${MEMORY_OBJECT}")
  endif()
  read_coff("${MEMORY_OBJECT}" _memory)
  # Match the actual table symbol, then its indexed section. An unrelated BSS
  # section must not hide g_slab_set in file-backed .data$g_slab_set.
  string(REGEX MATCH "  Symbol [{][^}]*Name: g_slab_set[\r\n][^}]*[}]" _slab_symbol "${_memory}")
  if(NOT _slab_symbol MATCHES "Section: [.]bss [(]([0-9]+)[)]")
    message(FATAL_ERROR "native_driver_sections: g_slab_set is missing or is not in .bss\n${_slab_symbol}")
  endif()
  set(_slab_section_number "${CMAKE_MATCH_1}")
  string(REGEX MATCH "  Section [{][\r\n]+    Number: ${_slab_section_number}[\r\n][^}]*[}]" _slab_section "${_memory}")
  if(NOT _slab_section MATCHES "Name: [.]bss [(]" OR
     NOT _slab_section MATCHES "IMAGE_SCN_CNT_UNINITIALIZED_DATA" OR
     _slab_section MATCHES "IMAGE_SCN_CNT_INITIALIZED_DATA" OR
     NOT _slab_section MATCHES "PointerToRawData: 0x0[\r\n]")
    message(FATAL_ERROR "native_driver_sections: g_slab_set section is not unbacked BSS\n${_slab_section}")
  endif()
  message(STATUS "native_driver_sections: g_slab_set is in unbacked, uninitialized .bss")
endif()
message(STATUS "native_driver_sections: static C/C++ members are split; runtime zero tables use BSS")
