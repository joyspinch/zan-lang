#!/bin/sh
# commit-msg gate -- selfhost twin-verification marker (B-ID189 ③).
#
# A commit that changes the compiler pair (the C host in src/compiler/ or the
# self-hosted compiler in src/selfhost/) can silently desynchronize the twin
# compilers: the stdout differential gate, the fixed point and the new repo
# gate are opt-in targeted runs (WC §8), so nothing forces the author to have
# run them. This hook does not run the gates -- it only requires the author
# to STATE which selfhost verification the commit carries, via the
# `selfhost-verified:` marker in the commit message, e.g.:
#
#     selfhost-verified: selfhost_gen1 selfhost_fixed_point selfhost_diff
#
# (name the ctest tests actually run; `none -- test-only change` is a valid
# value for compiler-side comment/doc-only edits.)
#
# Bypass with `git commit --no-verify` only for a proven false positive and
# say so in the commit message.

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    exit 0
fi

_msg_file="$1"
if [ ! -f "$_msg_file" ]; then
    exit 0
fi

if git diff --cached --name-only HEAD 2>/dev/null | grep -qE '^src/(selfhost|compiler)/'; then
    if ! grep -q 'selfhost-verified:' "$_msg_file"; then
        cat >&2 <<'EOF'
commit-msg gate: this commit changes the compiler pair (src/compiler/ or
src/selfhost/), but the message carries no `selfhost-verified:` marker.

State which selfhost verification the commit carries, e.g.:

    selfhost-verified: selfhost_gen1 selfhost_fixed_point selfhost_diff

(or `selfhost-verified: none -- comment/doc-only` for non-behavioural edits).
The gates themselves stay opt-in targeted runs (WC §8); the marker only makes
the claim auditable in history.
EOF
        exit 1
    fi
fi

exit 0
