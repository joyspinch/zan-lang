#!/bin/sh
# pre-commit gate -- part of the trampling/revert-prevention discipline
# (AGENTS.md rules 7/11/12, docs/WORKSPACE_CONVENTIONS.md 9/9.1/10).
#
# Blocks at commit time:
#   1. leftover conflict markers in staged content (a bulk one-sided resolve
#      that was never actually merged);
#   2. source-extension blobs > 8 MiB (build products masquerading as source).
#
# Untracked-file littering (rule 2) is deliberately NOT checked here: many
# legit flows leave untracked files mid-task, and blocking commits on it
# invites disabling the hook. It stays a human/agent finishing-step duty.
# Bypass with `git commit --no-verify` only for a proven false positive, and
# say so in the commit message.

. "$(dirname "$0")/gate_common.sh" || exit 1

if ! repo_guard; then
    exit 0
fi
gate_tmp || exit 1
trap gate_cleanup EXIT

_rc=0

gate_check_conflict_markers staged || _rc=1
gate_check_blob_size staged || _rc=1

exit $_rc
