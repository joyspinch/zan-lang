using System;
using System.Threading;
using Gui;
using Gui.Backend;

// 真实键盘事件探针：把窗口收到的键盘事件（种类 / 键码 / 修饰键）逐条
// 打到标准输出，回答"Windows 上这个组合键到底送来哪些事件、修饰键
// 记在哪个事件上"。
//
// 为什么要有它：UiDriver / InjectEvent 这类**合成事件自带修饰键**，
// 会把真机上"修饰键根本没送到上层"这类缺陷完全掩盖掉。IDE 的一批
// 组合键（Ctrl+Space、Shift+F12、Ctrl+Shift+F、Shift+Tab…）当初就是
// 因为只被合成事件验证过而一直没被发现真机上是坏的。
//
// 用法见 scripts/key_event_probe.ps1（它负责编译、起窗口、发按键）。
class KeyEventProbe {
    static App app;

    static void Body() { }

    static void Main() {
        app = new App("zan-key-probe", 420, 260);
        app.Show();
        int n = 0;
        while (n < 1200) {   // 约 20 秒，够发完几组按键
            int r = app.window.PollEvent();
            if (r == 0) {
                int kind = app.window.EventKind();
                if (kind == 4 || kind == 5 || kind == 6) {
                    Console.WriteLine("EV kind=" + Convert.ToString(kind)
                        + " code=" + Convert.ToString(app.window.EventKeyCode())
                        + " mods=" + Convert.ToString(app.window.EventMods()));
                }
            }
            app.FrameGuarded(KeyEventProbe.Body);
            n = n + 1;
            Thread.Sleep(10);
        }
        Console.WriteLine("PROBE_DONE");
    }
}
