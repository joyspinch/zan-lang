using System;
using Gui;
using Gui.Widget;
using Gui.Hmi;

// Business logic for {{NAME}}. The screen is designed in {{NAME}}.zform; the
// process tags live here, because I/O is code, not layout.
partial class {{NAME}} {
    static TagTable io;
    static AlarmBuffer alarms;
    static IoTag pv;
    static IoTag level;

    static void OnLoad(Form form) {
        io = new TagTable();
        alarms = new AlarmBuffer();

        // Scaled engineering values: raw counts are tenths of a degree / a
        // percent, so scale = 10 and the widgets print one decimal.
        pv = io.Add("TIC101.PV", "C", 10);
        pv.Range(0, 3000).Limits(300, 2500);
        level = io.Add("LIC102.PV", "%", 10);
        level.Range(0, 1000).Limits(100, 900);

        Alarms.Bind(alarms);
        PvGauge.Bind(pv);
        LevelBar.Bind(level);
        RunLed.Set(1);
        PvTrend.Range(0, 3000);
        PvTrend.Add("PV", pv, form.GetApp().theme.success);

        // One periodic scan drives the whole screen: read the process, sample
        // the trend, then let the alarm buffer raise / clear by limit.
        form.Every(1000, () => {
            Scan();
        });
    }

    // Replace the two SetRaw calls with your field bus / OPC / Modbus reads.
    static void Scan() {
        pv.SetRaw(pv.Raw());
        level.SetRaw(level.Raw());
        PvTrend.Sample();
        alarms.Scan(io);
        MainStatusBar.SetText(0, "Alarms: "
            + Convert.ToString(alarms.UnackedCount()));
    }
}
