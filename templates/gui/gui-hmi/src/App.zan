using System;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Hmi;

/* {{NAME}} 业务逻辑：屏幕在 {{NAME}}.html 中设计；过程点位在此定义，
 * 因为 I/O 属于代码而非布局（B-ID46 运行期形态：设计稿由 Main 运行期
 * 投影，HMI 控件用 ui.Ctl("Id") 取用后 Bind 点位）。 */
partial class {{NAME}} {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;
    static TagTable io;
    static AlarmBuffer alarms;
    static IoTag pv;
    static IoTag level;

    static void Main() {
        ControlBootstrap.Install();
        JsonValue doc = DesignDoc.Load("src/{{NAME}}.html");
        if (doc == null) {
            Console.WriteLine("error: design not found: src/{{NAME}}.html");
            return;
        }
        Form form = Form.Create(doc.Str("winTitle", "{{NAME}}"),
                                doc.Int("winW", 1024), doc.Int("winH", 640));
        form.Add(FormBuilder.BuildWith(doc, null));
        if (doc.Bool("winCenter", false)) { form.GetApp().CenterWindow(); }
        ui = form;
        Wire(form);
        OnLoad(form);
        form.Run();
    }

    static void Wire(Form form) {
    }

    static void OnLoad(Form form) {
        io = new TagTable();
        alarms = new AlarmBuffer();

        /* 缩放后的工程值：原始计数为单位 0.1 度/百分比，scale=10 使控件显示一位小数。 */
        pv = io.Add("TIC101.PV", "C", 10);
        pv.Range(0, 3000).Limits(300, 2500);
        level = io.Add("LIC102.PV", "%", 10);
        level.Range(0, 1000).Limits(100, 900);

        ((AlarmList)ui.Ctl("Alarms")).Bind(alarms);
        ((Gauge)ui.Ctl("PvGauge")).Bind(pv);
        ((Bargraph)ui.Ctl("LevelBar")).Bind(level);
        ((Led)ui.Ctl("RunLed")).Set(1);
        Trend trend = (Trend)ui.Ctl("PvTrend");
        trend.Range(0, 3000);
        trend.Add("PV", pv, form.GetApp().theme.success);

        /* 单次周期性扫描驱动整个屏幕：读取过程值、记录趋势，再由报警缓冲区按限值触发/复位。 */
        form.Every(1000, () => {
            Scan();
        });
    }

    /* 用现场总线 / OPC / Modbus 读取替换以下 SetRaw 调用。 */
    static void Scan() {
        pv.SetRaw(pv.Raw());
        level.SetRaw(level.Raw());
        ((Trend)ui.Ctl("PvTrend")).Sample();
        alarms.Scan(io);
        StatusBar sb = (StatusBar)ui.Ctl("MainStatusBar");
        sb.SetText(0, "报警： "
            + Convert.ToString(alarms.UnackedCount()));
    }
}
