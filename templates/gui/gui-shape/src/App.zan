using System;
using Gui;
using Gui.Widget;

// Business logic for {{NAME}}. The window is designed visually in {{NAME}}.zform
// (open it in the form designer). This template is a SHAPED window with its OWN
// skin: the design's winShape is a UNION of regions -- a big rounded card, a
// side panel poking out of its left edge and a round action button hanging
// below -- so the window itself is that silhouette (per-pixel alpha, or a
// classic region when DWM is off). winShadow casts the soft drop shadow and
// winChrome removes the standard title bar. All colours come from the project's
// OWN skin pack `skins/shape/skin.css` (loaded via UseSkin below), not from the
// generic GUI skins. No drawing code.
partial class {{NAME}} {
    static Label __sel;

    // Runs once after the window is built, before the event loop starts.
    static void OnLoad(Form form) {
        // 专属皮肤：项目自带 skins/shape/skin.css（与 src/ 平级）。
        // 它会替换整个窗口的主题令牌与控件样式，不依赖 GUI 通用皮肤。
        form.GetApp().UseSkin("shape");

        // 菜单项样式：圆角高亮条由皮肤 .menuItem 提供，选中背景由内联 Bg 设置。
        ScanItem.Class = "menuItem";
        JunkItem.Class = "menuItem";
        MailItem.Class = "menuItem";
        TrashItem.Class = "menuItem";
        UninstallItem.Class = "menuItem";

        ScanItem.OnClick(() => { __Pick(ScanItem, "智能扫描", "扫描你的 Mac，找出可以安全清理的垃圾文件，释放磁盘空间。", "扫描完成后会列出每一类可清理项，一键清除。"); });
        JunkItem.OnClick(() => { __Pick(JunkItem, "系统垃圾", "清理系统缓存、临时文件与日志，让系统保持轻盈。", "这些文件由 macOS 与常用应用生成，删除后不会影响使用。"); });
        MailItem.OnClick(() => { __Pick(MailItem, "邮件附件", "移除电子邮件下载和附件的本地副本。", "您的邮件不会囤积成千上百个公司徽标和其他小附件。"); });
        TrashItem.OnClick(() => { __Pick(TrashItem, "废纸篓", "清空废纸篓，回收每一块磁盘空间。", "按文件类型与大小预览后再清空，误删也能从时间机器找回。"); });
        UninstallItem.OnClick(() => { __Pick(UninstallItem, "卸载器", "彻底卸载应用及其全部残留文件。", "连同偏好设置、缓存与支持文件一起移除，不留碎片。"); });

        // 圆形扫描按钮：点击演示扫描状态。
        ScanButton.OnClick(() => {
            if (BodyTitle.Str() == "正在扫描…") {
                BodyTitle.Text = "智能扫描";
                ScanButton.Text = "扫描";
            } else {
                BodyTitle.Text = "正在扫描…";
                ScanButton.Text = "停止";
            }
        });

        // 初始选中第一项。
        __Pick(ScanItem, "智能扫描", "扫描你的 Mac，找出可以安全清理的垃圾文件，释放磁盘空间。", "扫描完成后会列出每一类可清理项，一键清除。");
    }

    // 切换左侧菜单选中项：点亮当前项，熄灭上一项，并更新右侧内容。
    static void __Pick(Label item, string title, string desc, string extra) {
        if (__sel != null) { __sel.Bg(0x00000000); }
        __sel = item;
        item.Bg(0x26FFFFFF); // 半透明白高亮（皮肤 .menuItem 提供圆角）
        BodyTitle.Text = title;
        BodyText1.Text = desc;
        BodyText2.Text = extra;
    }
}
