using System;
using System.Json;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 模板直接声明 @item-click 与 @click 绑定，
 * 后台类专注处理视图切换与业务（B-ID46 运行期形态）。 */
partial class {{NAME}} {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    static void Main() {
        ControlBootstrap.Install();
        Gui.Component.DataTable.DataTableBootstrap.Install();
        JsonValue doc = DesignDoc.Load("src/{{NAME}}.html");
        if (doc == null) {
            Console.WriteLine("error: design not found: src/{{NAME}}.html");
            return;
        }
        Form form = Form.Create(doc.Str("winTitle", "{{NAME}}"),
                                doc.Int("winW", 1080), doc.Int("winH", 680));
        form.Add(FormBuilder.BuildWith(doc, null));
        if (doc.Bool("winCenter", false)) { form.GetApp().CenterWindow(); }
        ui = form;
        Wire(form);
        OnLoad(form);
        form.Run();
    }

    static void Wire(Form form) {
        form.On("OnHeaderCommand", OnHeaderCommand);
        form.On("OnNavProject", OnNavProject);
        form.On("OnNavArchitecture", OnNavArchitecture);
        form.On("OnNavDatabase", OnNavDatabase);
        form.On("OnNavSettings", OnNavSettings);
    }

    static void OnLoad(Form form) {
        SwitchView("工程总览");
    }

    static void OnHeaderCommand() {
        ToolStrip header = (ToolStrip)ui.Ctl("TopHeader");
        int index = header.LastIndex();
        if (index == 0) { OnNewProject(); }
        else if (index == 1) { OnOpenProject(); }
        else if (index == 3) { OnBuild(); }
    }

    static void OnNavProject() { SwitchView("工程总览"); }
    static void OnNavArchitecture() { SwitchView("调用链路图"); }
    static void OnNavDatabase() { SwitchView("数据中心"); }
    static void OnNavSettings() { SwitchView("全局配置"); }

    static void SwitchView(string title) {
        Label titleCtl = (Label)ui.Ctl("WorkspaceTitle");
        titleCtl.Text = "当前视图: " + title;
        StatusBar sb = (StatusBar)ui.Ctl("MainStatusBar");
        sb.SetText(0, "激活: " + title);
    }

    static void OnNewProject() {
        Bar().SetText(0, "操作: 新建工程");
    }

    static void OnOpenProject() {
        Bar().SetText(0, "操作: 打开工程");
    }

    static void OnBuild() {
        Bar().SetText(0, "操作: 正在构建...");
    }

    // 设计稿里的状态栏：多个处理器共用，收口到一个取用点。
    static StatusBar Bar() {
        return (StatusBar)ui.Ctl("MainStatusBar");
    }
}
