using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：现代工作台母版，遵循 8pt 设计系统档位与弹性容器。 */
partial class {{NAME}} {
    static void OnLoad(Form form) {
        TopHeader.OnItemClick((int index) => {
            if (index == 0) { OnNewProject(); }
            else if (index == 1) { OnOpenProject(); }
            else if (index == 3) { OnBuild(); }
        });

        NavProject.OnClick(() => { SwitchView("工程总览"); });
        NavArchitecture.OnClick(() => { SwitchView("调用链路图"); });
        NavDatabase.OnClick(() => { SwitchView("数据中心"); });
        NavSettings.OnClick(() => { SwitchView("全局配置"); });

        SwitchView("工程总览");
    }

    static void SwitchView(string title) {
        WorkspaceTitle.Text = "当前视图: " + title;
        MainStatusBar.SetText(0, "激活: " + title);
    }

    static void OnNewProject() {
        MainStatusBar.SetText(0, "操作: 新建工程");
    }

    static void OnOpenProject() {
        MainStatusBar.SetText(0, "操作: 打开工程");
    }

    static void OnBuild() {
        MainStatusBar.SetText(0, "操作: 正在构建...");
    }
}
