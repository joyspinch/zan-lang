using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 模板直接声明 @item-click 与 @click 绑定，后台类专注处理视图切换与业务。 */
partial class {{NAME}} {
    static void OnLoad(Form form) {
        SwitchView("工程总览");
    }

    static void OnHeaderCommand() {
        int index = TopHeader.LastIndex();
        if (index == 0) { OnNewProject(); }
        else if (index == 1) { OnOpenProject(); }
        else if (index == 3) { OnBuild(); }
    }

    static void OnNavProject() { SwitchView("工程总览"); }
    static void OnNavArchitecture() { SwitchView("调用链路图"); }
    static void OnNavDatabase() { SwitchView("数据中心"); }
    static void OnNavSettings() { SwitchView("全局配置"); }

    static void SwitchView(string title) {
        WorkspaceTitle.Text = "当前视图: " + title;
        MainStatusBar.SetText(0, "激活: " + title);
    }

    static void OnNewProject() {
        MainStatusBar.SetText(0, "操作: 新建工程");
    }

    static void OnOpenProject() {
        MainStatusBar.SetText(0, "操作: 打开工程");
    }

    static void OnBuild() {
        MainStatusBar.SetText(0, "操作: 正在构建...");
    }
}
