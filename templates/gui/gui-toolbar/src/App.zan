using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：界面在 {{NAME}}.html 中声明式设计；事件自动直连 ViewModel 方法。 */
partial class {{NAME}} {
    static void OnLoad(Form form) {
        form.On("OnToolClick", OnToolClick);
    }

    static void OnToolClick() {
        int index = MainToolStrip.LastIndex();
        MainStatusBar.SetText(0, "命令 " + Convert.ToString(index));
    }
}
