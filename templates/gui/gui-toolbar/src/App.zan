using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：界面在 {{NAME}}.zform 中设计；MainToolStrip 置顶、MainStatusBar 置底、ContentPanel 填充其余区域。 */
partial class {{NAME}} {
    static void OnLoad(Form form) {
        MainToolStrip.OnItemClick((int index) => {
            MainStatusBar.SetText(0, "命令 " + Convert.ToString(index));
        });
    }
}
