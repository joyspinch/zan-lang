using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：界面在 {{NAME}}.html 中声明式设计，事件经 form.On
 * 直连本类方法（B-ID149 窗口即对象：事件 @click 按名接线）。 */
partial class {{NAME}} : Form {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    static void OnLoad(Form form) {
        ui = form;
    }

    static void OnToolClick() {
        ToolStrip tools = (ToolStrip)ui.Ctl("MainToolStrip");
        StatusBar sb = (StatusBar)ui.Ctl("MainStatusBar");
        sb.SetText(0, "命令 " + Convert.ToString(tools.LastIndex()));
    }
}
