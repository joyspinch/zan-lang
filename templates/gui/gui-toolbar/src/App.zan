using System;
using Gui;
using Gui.Widget;

// Business logic for {{NAME}}. The shell is designed in {{NAME}}.zform:
// MainToolStrip docks to the top, MainStatusBar to the bottom, ContentPanel
// fills the rest.
partial class {{NAME}} {
    static void OnLoad(Form form) {
        MainToolStrip.OnItemClick((int index) => {
            MainStatusBar.SetText(0, "Command " + Convert.ToString(index));
        });
    }
}
