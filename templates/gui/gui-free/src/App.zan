using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：窗口在 {{NAME}}.zform 中可视化设计，使用自由布局（控件绝对定位）；编译时 zanc 自动投影控件和 Main，此文件不会被设计器覆盖。 */
partial class {{NAME}} {
    /* 窗口构建后、事件循环前执行一次。 */
    static void OnLoad(Form form) {
        SignInButton.OnClick(() => {
            /* 必填字段（设计器中标注）由 __ValidateForm 校验：空输入显示红框和提示。 */
            if (!__ValidateForm()) { return; }
            TitleLabel.Text = "Hello " + NameInput.GetText() + "!";
        });
        PasswordInput.OnEnter(() => { TitleLabel.Text = "Enter pressed"; });
        RememberCheck.OnChange(() => {
            TitleLabel.Text = "Remember: " + RememberCheck.IsChecked();
        });
    }
}
