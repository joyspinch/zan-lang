using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 模板直接声明 @click、@change 与按键事件绑定，后台类专注处理登录与状态。 */
partial class {{NAME}} {
    static void OnLoad(Form form) {
    }

    static void OnSignIn() {
        /* 必填字段（设计器中标注）由 __ValidateForm 校验：空输入显示红框和提示。 */
        if (!__ValidateForm()) { return; }
        TitleLabel.Text = "你好，" + NameInput.GetText() + "！";
    }

    static void OnPasswordKey(int key, int mod) {
        if (key == 13) { TitleLabel.Text = "已按回车"; }
    }

    static void OnRememberChange() {
        TitleLabel.Text = "记住我：" + RememberCheck.IsChecked();
    }
}
