using System;
using Gui;
using Gui.Widget;

/* {{NAME}} —— 自由布局（绝对定位）登录窗。
 * 布局：{{NAME}}.html 的 body 与卡片都声明 data-layout-mode="1"，子控件按
 * left/top/width/height 摆放，适合嵌入式屏、固定尺寸面板这类"像素级对齐"的界面。
 * 逻辑：输入框/复选框用 bind 绑定到字段，登录按钮的 :disabled 绑定 locked。
 * 把 CheckCredentials 换成你的真实校验（数据库、HTTP 接口……）即可。 */
partial class {{NAME}} : Form {
    string user = "";
    string password = "";
    bool remember = true;
    bool locked = false;
    string message = "";
    string messageClass = "secondary"; // :class 绑定整串替换 class
    int failures = 0;

    const int MaxFailures = 3;

    void OnLoad(Form form) {
        Gui.ThemeSettings.Enable(form.GetApp());
        Gui.Backend.UiDriver.Enable(form.GetApp());
    }

    void OnSignIn() {
        if (locked) { return; }
        string name = user.Trim();
        if (name == "" || password == "") {
            Show("用户名和密码都必须填写。", "error");
            return;
        }
        if (!CheckCredentials(name, password)) {
            failures = failures + 1;
            password = "";
            if (failures >= MaxFailures) {
                locked = true;
                Show("连续 " + MaxFailures + " 次失败，登录已锁定。", "error");
            } else {
                Show("用户名或密码错误，还可尝试 " + (MaxFailures - failures) + " 次。", "warning");
            }
            return;
        }
        failures = 0;
        Show("登录成功，欢迎 " + name + "！" + (remember ? "下次将自动登录。" : ""), "success");
    }

    void OnForgot() {
        Show("请联系管理员重置密码。", "secondary");
    }

    void Show(string text, string cls) {
        message = text;
        messageClass = cls;
    }

    // 演示用的固定账号；真实项目在这里查库或调接口（耗时操作放后台线程）。
    static bool CheckCredentials(string name, string pass) {
        return name == "admin" && pass == "123456";
    }
}
