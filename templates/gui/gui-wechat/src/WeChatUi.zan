using System;
using Gui;
using Gui.Widget;

/// 界面里反复出现的小件。这里的方法只组装标准库控件（Label / Button /
/// Avatar / Flex / Panel / Divider），不画任何像素——外观全部交给
/// WeChatSkin 的样式表。
class Wx {
    /// 带类的标签。列容器里的子控件默认停靠在顶部。
    static Label Lbl(string txt, string cls) {
        Label l = new Label(txt);
        l.Class = cls;
        l.dock = 1;
        return l;
    }

    /// 无文字的图标按钮（标题条上的 …）。标准扁平按钮：`text` 变体
    /// 无底无框、`small` 是尺寸档，外观由皮肤的 `button.text` 规则定，
    /// 这里不写一行式样。图标来自皮肤内置的图标集。
    static Button IconBtn(string icon) {
        Button b = new Button("");
        b.Icon = icon;
        b.Class = "text small";
        return b;
    }

    /// 头像：首字 + 直径 + 色调类（primary / info / success / warning / error）。
    static Avatar Ava(string initial, int size, string tint) {
        Avatar a = new Avatar(initial, size);
        a.Class = tint;
        return a;
    }

    /// 图标头像（快捷入口那种：底色 + 一个线性图标，没有字）。
    static Avatar AvaIcon(string icon, int size, string tint) {
        Avatar a = new Avatar("", size, icon);
        a.Class = tint;
        return a;
    }

    /// 纵向流式容器（宽度/内边距/间距都在样式表里）。
    static Panel Col(string cls) {
        Panel p = Panel.Column();
        p.Class = cls;
        return p;
    }

    /// 横向 flex 行，交叉轴居中——「左边标题、右边值」这类行都用它。
    static Flex Row(string cls) {
        Flex f = Flex.Row();
        f.Class = cls;
        f.Align("center");
        f.dock = 1;
        return f;
    }

    /// 分组小标题。
    static Label Sec(string txt) {
        return Wx.Lbl(txt, "wxsetsec");
    }

    /// 设置里导航按钮的类名（选中的那个加状态类 wxon）。
    static string NavCls(bool on) {
        if (on) { return "wxsetnavbtn wxon"; }
        return "wxsetnavbtn";
    }

    /// 分隔线（标准库组件，不自绘）。
    static Divider Line() {
        Divider d = new Divider();
        d.dock = 1;
        return d;
    }
}

/// 一行「左键右值」的资料行；值 Label 留给调用方在选中变化时改写。
class WxRow {
    Flex row;
    Label val;

    static WxRow Of(string k, string v, string rowCls, string kCls, string vCls) {
        WxRow r = new WxRow();
        r.row = Wx.Row(rowCls);
        // 键吃掉行内剩余空间，值就被推到右侧（Label 只管在自己矩形里
        // 从左往右画，所以右对齐要靠 flex 的排布，不能靠文字对齐）。
        Label key = Wx.Lbl(k, kCls + " grow");
        r.val = Wx.Lbl(v, vCls);
        r.row.Add(key);
        r.row.Add(r.val);
        return r;
    }

    Flex Row() { return row; }

    void SetVal(string v) { val.Text = v; }

    /// 设置窗口里的「左键右值」行（几何类写在 WeChatSkin 里）。
    static Flex Kv(string k, string v) {
        WxRow r = WxRow.Of(k, v, "wxsetrow", "wxsetkey", "wxsetval");
        return r.row;
    }
}
