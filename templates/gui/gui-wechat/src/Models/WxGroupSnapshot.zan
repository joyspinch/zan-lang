using System;
using Gui.Component;

public class WxGroupSnapshot {
    string id;
    string title;
    string lastText;
    string lastAt;
    int unread;
    int memberCount;

    WxGroupSnapshot(string id, string title, string lastText, string lastAt, int unread, int memberCount) {
        this.id = id != null ? id : "";
        this.title = title != null ? title : "";
        this.lastText = lastText != null ? lastText : "";
        this.lastAt = lastAt != null ? lastAt : "0";
        this.unread = unread;
        this.memberCount = memberCount;
    }

    string Id { get { return id; } }
    string Title { get { return title; } }
    string LastText { get { return lastText; } }
    string LastAt { get { return lastAt; } }
    int Unread { get { return unread; } }
    int MemberCount { get { return memberCount; } }
}

// 服务端联系人项强类型实体（消除 contacts 回复中的动态 JsonValue 项）。
