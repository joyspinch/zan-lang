using System;
using System.Json;
using Gui.Component;

public class WxGroupSnapshot {
    public string id = "";
    public string title = "";
    public string lastText = "";
    public string lastAt = "0";
    public int unread = 0;
    public int memberCount = 0;

    public WxGroupSnapshot(string id, string title, string lastText, string lastAt, int unread, int memberCount) {
        this.id = id != null ? id : "";
        this.title = title != null ? title : "";
        this.lastText = lastText != null ? lastText : "";
        this.lastAt = lastAt != null ? lastAt : "0";
        this.unread = unread;
        this.memberCount = memberCount;
    }

    public static WxGroupSnapshot FromDoc(JsonDoc doc, int slot) {
        if (doc == null || slot < 0) {
            return new WxGroupSnapshot("", "?", "", "0", 0, 0);
        }
        string unreadStr = doc.Str(slot, "unread", "0");
        int unread = (int)doc.Long(slot, "unread", 0);
        if (unread == 0 && unreadStr != "0") {
            try { unread = int.Parse(unreadStr); } catch (Exception) { }
        }
        string memStr = doc.Str(slot, "members", "0");
        int members = (int)doc.Long(slot, "members", 0);
        if (members == 0 && memStr != "0") {
            try { members = int.Parse(memStr); } catch (Exception) { }
        }
        return new WxGroupSnapshot(
            doc.Str(slot, "id", ""),
            doc.Str(slot, "title", "?"),
            doc.Str(slot, "lastText", ""),
            doc.Str(slot, "lastAt", "0"),
            unread,
            members
        );
    }

    public string Id { get { return this.id; } }
    public string Title { get { return this.title; } }
    public string LastText { get { return this.lastText; } }
    public string LastAt { get { return this.lastAt; } }
    public int Unread { get { return this.unread; } }
    public int MemberCount { get { return this.memberCount; } }
}
