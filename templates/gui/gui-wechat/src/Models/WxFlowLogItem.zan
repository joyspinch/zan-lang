using System;
using System.Json;
using Gui.Component;

public class WxFlowLogItem {
    public string userName = "";
    public string content = "";
    public string at = "0";

    public WxFlowLogItem() { }

    public static WxFlowLogItem FromDoc(JsonDoc doc, int slot) {
        WxFlowLogItem l = new WxFlowLogItem();
        if (doc == null || slot < 0) { return l; }
        l.userName = doc.Str(slot, "userName", "");
        l.content = doc.Str(slot, "content", "");
        l.at = doc.Str(slot, "at", "0");
        return l;
    }
}
