using System;
using Gui.Component;

public class WxFlowLogItem {
    string userName;
    string content;
    string at;

    WxFlowLogItem() {
        this.userName = "";
        this.content = "";
        this.at = "0";
    }

    static WxFlowLogItem FromJson(JsonValue o) {
        WxFlowLogItem l = new WxFlowLogItem();
        if (o == null) { return l; }
        l.userName = o.Str("userName", "");
        l.content = o.Str("content", "");
        l.at = o.Str("at", "0");
        return l;
    }
}

// 流程实例详情强类型实体（收敛 WeChatWork.zan 对动态 JsonValue 树的遍历）。
