using System;
using System.Json;

/* 智能体（服务端 /api/agent/list）：清单里的一项。
   服务端把「就绪与否」与智能体清单一并给出——没配好模型时清单可能
   是空的，客户端据此提示「服务端未配置 AI」。 */
public class WxAgentItem {
    string code;
    string name;
    string hint;
    string icon;

    WxAgentItem() {
        this.code = "";
        this.name = "";
        this.hint = "";
        this.icon = "cpu";
    }

    static WxAgentItem FromJson(JsonValue d) {
        WxAgentItem it = new WxAgentItem();
        if (d == null) { return it; }
        it.code = d.Str("code", "");
        it.name = d.Str("name", "智能体");
        it.hint = d.Str("hint", "");
        it.icon = d.Str("icon", "cpu");
        if (it.icon.Length == 0) { it.icon = "cpu"; }
        return it;
    }
}
