using System;
using System.Json;

public class WxAgentItem {
    public string code = "";
    public string name = "";
    public string hint = "";
    public string icon = "cpu";

    public WxAgentItem() { }

    public static WxAgentItem FromDoc(JsonDoc doc, int slot) {
        WxAgentItem it = new WxAgentItem();
        if (doc == null || slot < 0) { return it; }
        it.code = doc.Str(slot, "code", "");
        it.name = doc.Str(slot, "name", "智能体");
        it.hint = doc.Str(slot, "hint", "");
        it.icon = doc.Str(slot, "icon", "cpu");
        if (it.icon.Length == 0) { it.icon = "cpu"; }
        return it;
    }
}
