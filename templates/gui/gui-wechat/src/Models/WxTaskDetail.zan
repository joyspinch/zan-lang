using System;
using Gui.Component;

public class WxTaskDetail {
    string title;
    string status;
    string ownerId;
    string assigneeId;
    int progress;
    string description;
    List<WxTaskEventItem> events;

    WxTaskDetail() {
        this.title = "";
        this.status = "";
        this.ownerId = "0";
        this.assigneeId = "0";
        this.progress = 0;
        this.description = "";
        this.events = new List<WxTaskEventItem>();
    }

    static WxTaskDetail FromJson(JsonValue d) {
        WxTaskDetail td = new WxTaskDetail();
        if (d == null) { return td; }
        td.title = d.Str("title", "");
        td.status = d.Str("status", "");
        td.ownerId = d.Str("ownerId", "0");
        td.assigneeId = d.Str("assigneeId", "0");
        td.progress = Convert.ToInt32(d.Str("progress", "0"));
        td.description = d.Str("description", "");
        JsonValue evs = d.Get("events");
        if (evs != null && evs.IsArray()) {
            for (int i = 0; i < evs.Count(); i = i + 1) {
                td.events.Add(WxTaskEventItem.FromJson(evs.At(i)));
            }
        }
        return td;
    }
}

// 工作流环节/节点子任务强类型实体。
