using System;
using System.Collections.Generic;
using System.Json;
using Gui.Component;

public class WxTaskDetail {
    public string title = "";
    public string status = "";
    public string ownerId = "0";
    public string assigneeId = "0";
    public int progress = 0;
    public string description = "";
    public List<WxTaskEventItem> events = new List<WxTaskEventItem>();

    public WxTaskDetail() { }

    public static WxTaskDetail FromDoc(JsonDoc doc, int slot) {
        WxTaskDetail td = new WxTaskDetail();
        if (doc == null || slot < 0) { return td; }
        td.title = doc.Str(slot, "title", "");
        td.status = doc.Str(slot, "status", "");
        td.ownerId = doc.Str(slot, "ownerId", "0");
        td.assigneeId = doc.Str(slot, "assigneeId", "0");
        td.progress = (int)doc.Long(slot, "progress", 0L);
        td.description = doc.Str(slot, "description", "");
        int evs = doc.Get(slot, "events");
        if (evs >= 0 && doc.KindAt(evs) == 4) {
            int count = doc.Count(evs);
            for (int i = 0; i < count; i = i + 1) {
                td.events.Add(WxTaskEventItem.FromDoc(doc, doc.At(evs, i)));
            }
        }
        return td;
    }
}
