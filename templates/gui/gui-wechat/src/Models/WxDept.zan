using System;
using System.IO;
using System.Json;
using System.Text;
using Gui;
using Gui.Backend;
using Gui.Component;
using Gui.Widget;

public class WxDept {
    public string id;
    public string name;

    static WxDept Of(string i, string n) {
        WxDept d = new WxDept();
        d.id = i;
        d.name = n;
        return d;
    }
}
