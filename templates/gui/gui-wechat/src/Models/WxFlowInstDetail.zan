using System;
using Gui.Component;

public class WxFlowInstDetail {
    string id;
    string title;
    string defName;
    int status;
    string startedBy;
    string startedByName;
    string createdAt;
    List<WxFlowNodeItem> nodes;
    List<WxFlowLogItem> logs;

    WxFlowInstDetail() {
        this.id = "";
        this.title = "";
        this.defName = "-";
        this.status = 1;
        this.startedBy = "0";
        this.startedByName = "";
        this.createdAt = "0";
        this.nodes = new List<WxFlowNodeItem>();
        this.logs = new List<WxFlowLogItem>();
    }

    static WxFlowInstDetail FromJson(JsonValue d) {
        WxFlowInstDetail inst = new WxFlowInstDetail();
        if (d == null) { return inst; }
        inst.id = d.Str("id", "");
        inst.title = d.Str("title", "");
        inst.defName = d.Str("defName", "-");
        inst.status = Convert.ToInt32(d.Str("status", "1"));
        inst.startedBy = d.Str("startedBy", "0");
        inst.startedByName = d.Str("startedByName", "");
        inst.createdAt = d.Str("createdAt", "0");
        JsonValue ns = d.Get("nodes");
        if (ns != null && ns.IsArray()) {
            for (int i = 0; i < ns.Count(); i = i + 1) {
                inst.nodes.Add(WxFlowNodeItem.FromJson(ns.At(i)));
            }
        }
        JsonValue ls = d.Get("logs");
        if (ls != null && ls.IsArray()) {
            for (int i = 0; i < ls.Count(); i = i + 1) {
                inst.logs.Add(WxFlowLogItem.FromJson(ls.At(i)));
            }
        }
        return inst;
    }
}

// 流程模板定义详情强类型实体。
