using System;
using System.Collections.Generic;
using System.Json;
using Gui.Component;

public class WxFlowInstDetail {
    public string id = "";
    public string title = "";
    public string defName = "-";
    public int status = 1;
    public string startedBy = "0";
    public string startedByName = "";
    public string createdAt = "0";
    public List<WxFlowNodeItem> nodes = new List<WxFlowNodeItem>();
    public List<WxFlowLogItem> logs = new List<WxFlowLogItem>();

    public WxFlowInstDetail() { }

    public static WxFlowInstDetail FromDoc(JsonDoc doc, int slot) {
        WxFlowInstDetail inst = new WxFlowInstDetail();
        if (doc == null || slot < 0) { return inst; }
        inst.id = doc.Str(slot, "id", "");
        inst.title = doc.Str(slot, "title", "");
        inst.defName = doc.Str(slot, "defName", "-");
        inst.status = (int)doc.Long(slot, "status", 1L);
        inst.startedBy = doc.Str(slot, "startedBy", "0");
        inst.startedByName = doc.Str(slot, "startedByName", "");
        inst.createdAt = doc.Str(slot, "createdAt", "0");
        int ns = doc.Get(slot, "nodes");
        if (ns >= 0 && doc.KindAt(ns) == 4) {
            int count = doc.Count(ns);
            for (int i = 0; i < count; i = i + 1) {
                inst.nodes.Add(WxFlowNodeItem.FromDoc(doc, doc.At(ns, i)));
            }
        }
        int ls = doc.Get(slot, "logs");
        if (ls >= 0 && doc.KindAt(ls) == 4) {
            int count = doc.Count(ls);
            for (int i = 0; i < count; i = i + 1) {
                inst.logs.Add(WxFlowLogItem.FromDoc(doc, doc.At(ls, i)));
            }
        }
        return inst;
    }
}
