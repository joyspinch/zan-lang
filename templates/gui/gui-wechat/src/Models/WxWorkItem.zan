using System;
using System.Json;
using Gui;
using Gui.Backend;
using Gui.Component;
using Gui.Widget;

public class WxWorkItem {
    public string id = "";
    public string taskId = "";
    public string instId = "";
    public string title = "";
    public string nodeName = "";
    public string status = "0";
    public string description = "";
    public string nodeCount = "0";
    public int kind = 0;

    public string projectNo = "";
    public string category = "";
    public string currentStage = "";
    public string currentStageName = "";
    public string ownerName = "";
    public string conversationId = "0";
    public string targetGmv = "0";
    public string targetRoi = "0";

    public WxWorkItem() { }

    public static WxWorkItem FromDoc(JsonDoc doc, int slot, int kind) {
        WxWorkItem it = new WxWorkItem();
        it.kind = kind;
        if (doc == null || slot < 0) { return it; }
        if (kind == 2) {
            it.id = doc.Str(slot, "id", "");
            it.projectNo = doc.Str(slot, "projectNo", "");
            it.title = doc.Str(slot, "name", "");
            it.category = doc.Str(slot, "category", "");
            it.currentStage = doc.Str(slot, "currentStage", "selection");
            it.currentStageName = doc.Str(slot, "currentStageName", "1.企划与选品");
            it.status = doc.Str(slot, "status", "active");
            it.ownerName = doc.Str(slot, "ownerName", "负责人");
            it.conversationId = doc.Str(slot, "conversationId", "0");
            it.targetGmv = doc.Str(slot, "targetGmv", "0");
            it.targetRoi = doc.Str(slot, "targetRoi", "0");
            return it;
        }
        if (kind == 1) {
            it.id = doc.Str(slot, "id", "");
            it.title = doc.Str(slot, "name", "");
            it.description = doc.Str(slot, "description", "");
            it.nodeCount = doc.Str(slot, "nodeCount", "0");
            it.status = "0";
            return it;
        }
        it.taskId = doc.Str(slot, "taskId", "");
        it.instId = doc.Str(slot, "instId", "");
        it.title = doc.Str(slot, "title", "");
        it.nodeName = doc.Str(slot, "nodeName", "");
        it.status = doc.Str(slot, "status", "0");
        return it;
    }
}
