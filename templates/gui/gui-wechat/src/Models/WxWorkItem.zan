using System;
using System.IO;
using System.Json;
using System.Text;
using Gui;
using Gui.Backend;
using Gui.Component;
using Gui.Widget;

public class WxWorkItem {
    public string id;
    public string taskId;
    public string instId;
    public string title;
    public string nodeName;
    public string status;
    public string description;
    public string nodeCount;
    public int kind;

    // 全生命周期项目专属字段 (kind == 2)
    public string projectNo;
    public string category;
    public string currentStage;
    public string currentStageName;
    public string ownerName;
    public string conversationId;
    public string targetGmv;
    public string targetRoi;

    static WxWorkItem Of(JsonValue o, int kind) {
        WxWorkItem it = new WxWorkItem();
        it.kind = kind;
        if (kind == 2) {
            it.id = o.Str("id", "");
            it.projectNo = o.Str("projectNo", "");
            it.title = o.Str("name", "");
            it.category = o.Str("category", "");
            it.currentStage = o.Str("currentStage", "selection");
            it.currentStageName = o.Str("currentStageName", "1.企划与选品");
            it.status = o.Str("status", "active");
            it.ownerName = o.Str("ownerName", "负责人");
            it.conversationId = o.Str("conversationId", "0");
            it.targetGmv = o.Str("targetGmv", "0");
            it.targetRoi = o.Str("targetRoi", "0");
            return it;
        }
        if (kind == 1) {
            it.id = o.Str("id", "");
            it.title = o.Str("name", "");
            it.description = o.Str("description", "");
            it.nodeCount = o.Str("nodeCount", "0");
            it.status = "0";
            return it;
        }
        it.taskId = o.Str("taskId", "");
        it.instId = o.Str("instId", "");
        it.title = o.Str("title", "");
        it.nodeName = o.Str("nodeName", "");
        it.status = o.Str("status", "0");
        return it;
    }
}

// 工作台行：图标 + 标题/摘要 + 右缘状态。
