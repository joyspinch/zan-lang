using System;
using System.Json;

public class WxDocVersion {
    public string version = "0";
    public string title = "";
    public string editor = "";
    public string createdAt = "";
    public string cur = "";

    public WxDocVersion() { }

    public static WxDocVersion FromDoc(JsonDoc doc, int slot) {
        WxDocVersion it = new WxDocVersion();
        if (doc == null || slot < 0) { return it; }
        it.version = doc.Str(slot, "version", "0");
        it.title = doc.Str(slot, "title", "");
        it.editor = doc.Str(slot, "editor", "");
        it.createdAt = doc.Str(slot, "createdAt", "");
        it.cur = doc.Str(slot, "current", "");
        return it;
    }

    public bool IsCur() {
        return this.cur == "1";
    }

    public string Sub() {
        string s = this.editor;
        if (this.createdAt.Length > 0) {
            if (s.Length > 0) { s = s + " · "; }
            s = s + this.createdAt;
        }
        return s;
    }
}
