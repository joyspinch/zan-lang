using System;
using System.Json;

/* 文档版本（服务端 /api/oa/docs/versions）：一条版本快照的摘要。
   cur 为 "1" 表示当前版本。版本只增不改——回滚也是新增一个版本。 */
public class WxDocVersion {
    string version;
    string title;
    string editor;
    string createdAt;
    string cur;

    WxDocVersion() {
        this.version = "0";
        this.title = "";
        this.editor = "";
        this.createdAt = "";
        this.cur = "";
    }

    static WxDocVersion FromJson(JsonValue d) {
        WxDocVersion it = new WxDocVersion();
        if (d == null) { return it; }
        it.version = d.Str("version", "0");
        it.title = d.Str("title", "");
        it.editor = d.Str("editor", "");
        it.createdAt = d.Str("createdAt", "");
        it.cur = d.Str("current", "");
        return it;
    }

    // 是否当前版本（行的标题旁标「当前」）。
    bool IsCur() { return this.cur == "1"; }

    // 行的副标题：编辑人 + 时间。
    string Sub() {
        string s = this.editor;
        if (this.createdAt.Length > 0) {
            if (s.Length > 0) { s = s + " · "; }
            s = s + this.createdAt;
        }
        if (s.Length == 0) { s = "—"; }
        return s;
    }
}
