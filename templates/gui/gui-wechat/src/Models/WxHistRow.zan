using System;
using Gui.Component;

public class WxHistRow {
    string name;  // 发言人（私聊也显示，与截图一致）
    string ini;  // 头像首字
    string text;
    string date;  // 右对齐的日期串
    string tint;  // 头像色调类

    WxHistRow(string name, string ini, string text, string date, string tint) {
        this.name = name;
        this.ini = ini;
        this.text = text;
        this.date = date;
        this.tint = tint;
    }

    static WxHistRow Of(string name, string ini, string text, string date,
            string tint) {
        return new WxHistRow(name, ini, text, date, tint);
    }
}

// 示例数据：全部虚构，与任何真实账号、真实联系人无关。
