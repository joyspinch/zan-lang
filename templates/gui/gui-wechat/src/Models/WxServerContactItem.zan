using System;
using Gui.Component;

public class WxServerContactItem {
    string id;
    string name;
    string username;

    WxServerContactItem(string id, string name, string username) {
        this.id = id != null ? id : "";
        this.name = name != null ? name : "";
        this.username = username != null ? username : "";
    }

    string Id { get { return id; } }
    string Name { get { return name; } }
    string Username { get { return username; } }
}

// 聊天消息流网络快照实体（消除遍历动态 JsonValue 树散布）。
