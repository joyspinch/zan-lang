using System;
using System.Json;

public class WxFlowTool {
    public string code = "";
    public string name = "";
    public string hint = "";
    public string icon = "cpu";
    public string state = "healthy";
    public string failures = "0";
    public string lastError = "";

    public WxFlowTool() { }

    public static WxFlowTool FromDoc(JsonDoc doc, int slot) {
        WxFlowTool it = new WxFlowTool();
        if (doc == null || slot < 0) { return it; }
        it.code = doc.Str(slot, "code", "");
        it.name = doc.Str(slot, "name", "未命名工具");
        it.hint = doc.Str(slot, "hint", "");
        it.icon = doc.Str(slot, "icon", "cpu");
        it.state = doc.Str(slot, "state", "healthy");
        it.failures = doc.Str(slot, "failures", "0");
        it.lastError = doc.Str(slot, "lastError", "");
        return it;
    }
}
