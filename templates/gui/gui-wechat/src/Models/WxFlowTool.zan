using System;
using System.Json;

/* 服务端可用的 AI 工具（助手）目录：/api/flowagent/nodes 的 catalog。
   分配页右栏据此列「可绑定工具」——工具清单只在服务端有一份，客户端
   不另存。加助手只改服务端。 */
public class WxFlowTool {
    string code;
    string name;
    string hint;
    string icon;
    string state;
    string failures;
    string lastError;

    WxFlowTool() {
        this.code = "";
        this.name = "";
        this.hint = "";
        this.icon = "cpu";
        this.state = "healthy";
        this.failures = "0";
        this.lastError = "";
    }

    static WxFlowTool FromJson(JsonValue d) {
        WxFlowTool it = new WxFlowTool();
        if (d == null) { return it; }
        it.code = d.Str("code", "");
        it.name = d.Str("name", "未命名工具");
        it.hint = d.Str("hint", "");
        it.icon = d.Str("icon", "cpu");
        it.state = d.Str("state", "healthy");
        it.failures = d.Str("failures", "0");
        it.lastError = d.Str("lastError", "");
        return it;
    }
}
