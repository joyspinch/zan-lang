using System;
using Gui.Component;

public class WxFlowNodeItem {
    string id;
    string name;
    int sort;
    string deptId;
    string assignUserId;
    string kind;
    List<WxFlowTaskItem> tasks;

    WxFlowNodeItem() {
        this.id = "";
        this.name = "";
        this.sort = 0;
        this.deptId = "0";
        this.assignUserId = "0";
        this.kind = "approval";
        this.tasks = new List<WxFlowTaskItem>();
    }

    static WxFlowNodeItem FromJson(JsonValue o) {
        WxFlowNodeItem n = new WxFlowNodeItem();
        if (o == null) { return n; }
        n.id = o.Str("id", "");
        n.name = o.Str("name", "");
        n.sort = Convert.ToInt32(o.Str("sort", "0"));
        n.deptId = o.Str("deptId", "0");
        n.assignUserId = o.Str("assignUserId", "0");
        n.kind = o.Str("kind", "approval");
        JsonValue ts = o.Get("tasks");
        if (ts != null && ts.IsArray()) {
            for (int i = 0; i < ts.Count(); i = i + 1) {
                n.tasks.Add(WxFlowTaskItem.FromJson(ts.At(i)));
            }
        }
        return n;
    }
}

// 流程实例流转日志强类型实体。
