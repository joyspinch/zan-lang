using System;
using System.Collections.Generic;
using System.Json;
using Gui.Component;

public class WxFlowNodeItem {
    public string id = "";
    public string name = "";
    public int sort = 0;
    public string deptId = "0";
    public string assignUserId = "0";
    public string kind = "approval";
    public List<WxFlowTaskItem> tasks = new List<WxFlowTaskItem>();

    public WxFlowNodeItem() { }

    public static WxFlowNodeItem FromDoc(JsonDoc doc, int slot) {
        WxFlowNodeItem n = new WxFlowNodeItem();
        if (doc == null || slot < 0) { return n; }
        n.id = doc.Str(slot, "id", "");
        n.name = doc.Str(slot, "name", "");
        n.sort = (int)doc.Long(slot, "sort", 0L);
        n.deptId = doc.Str(slot, "deptId", "0");
        n.assignUserId = doc.Str(slot, "assignUserId", "0");
        n.kind = doc.Str(slot, "kind", "approval");
        int ts = doc.Get(slot, "tasks");
        if (ts >= 0 && doc.KindAt(ts) == 4) {
            int count = doc.Count(ts);
            for (int i = 0; i < count; i = i + 1) {
                n.tasks.Add(WxFlowTaskItem.FromDoc(doc, doc.At(ts, i)));
            }
        }
        return n;
    }
}
