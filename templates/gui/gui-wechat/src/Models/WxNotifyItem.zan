using System;
using System.Json;
using Gui.Component;

public class WxNotifyItem {
    public string id = "";
    public string module = "";
    public string kind = "";
    public string title = "";
    public string content = "";
    public string link = "";
    public bool unread = false;
    public string at = "0";

    public WxNotifyItem() { }

    public static WxNotifyItem FromDoc(JsonDoc doc, int slot) {
        WxNotifyItem n = new WxNotifyItem();
        if (doc == null || slot < 0) { return n; }
        n.id = doc.Str(slot, "id", "");
        n.module = doc.Str(slot, "module", "");
        n.kind = doc.Str(slot, "kind", "");
        n.title = doc.Str(slot, "title", "");
        n.content = doc.Str(slot, "content", "");
        n.link = doc.Str(slot, "link", "");
        n.unread = doc.Str(slot, "unread", "0") == "1" || doc.Bool(slot, "unread", false);
        n.at = doc.Str(slot, "at", "0");
        return n;
    }

    public string Icon() {
        if (this.kind == "assign") { return "target"; }
        if (this.kind == "mention") { return "at"; }
        if (this.kind == "done") { return "check"; }
        if (this.kind == "alert") { return "warning"; }
        return "bell";
    }

    public string Tint() {
        if (this.kind == "assign") { return "primary"; }
        if (this.kind == "mention") { return "warning"; }
        if (this.kind == "alert") { return "error"; }
        if (this.kind == "done") { return "success"; }
        return "info";
    }
}
