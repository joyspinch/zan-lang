using System;
using System.Json;
using Gui.Component;

/* 通知条目（服务端 /api/notify/items 与 /api/notify/unread 的行）：
   正文原样带出——业务语义在服务端写入侧收口（Flow Engine → Notify.Send），
   客户端只做展示与已读标记，不二次解释内容。 */
public class WxNotifyItem {
    string id;
    string module;  // 业务域：flow 等
    string kind;    // assign 派工 / mention 提及 / done 流程 / alert 告警 / info 通知
    string title;
    string content;
    string link;
    bool unread;
    string at;      // Unix 秒（服务端原样带出，客户端再格式化）

    WxNotifyItem() {
        this.id = "";
        this.module = "";
        this.kind = "";
        this.title = "";
        this.content = "";
        this.link = "";
        this.unread = false;
        this.at = "0";
    }

    static WxNotifyItem FromJson(JsonValue d) {
        WxNotifyItem n = new WxNotifyItem();
        if (d == null) { return n; }
        n.id = d.Str("id", "");
        n.module = d.Str("module", "");
        n.kind = d.Str("kind", "");
        n.title = d.Str("title", "");
        n.content = d.Str("content", "");
        n.link = d.Str("link", "");
        n.unread = d.Str("unread", "0") == "1";
        n.at = d.Str("at", "0");
        return n;
    }

    // 分类图标：派工/提及吸睛，流程完结与普通通知安静。
    string Icon() {
        if (this.kind == "assign") { return "target"; }
        if (this.kind == "mention") { return "at"; }
        if (this.kind == "done") { return "check"; }
        if (this.kind == "alert") { return "warning"; }
        return "bell";
    }

    // 分类色调（Avatar 的 tint 类：primary/info/success/warning/error）。
    string Tint() {
        if (this.kind == "assign") { return "primary"; }
        if (this.kind == "mention") { return "warning"; }
        if (this.kind == "alert") { return "error"; }
        if (this.kind == "done") { return "success"; }
        return "info";
    }

    // 分类名（列表行上的小标）。
    string KindText() {
        if (this.kind == "assign") { return "派工"; }
        if (this.kind == "mention") { return "提及"; }
        if (this.kind == "done") { return "流程"; }
        if (this.kind == "alert") { return "告警"; }
        if (this.kind == "message") { return "私信"; }
        return "通知";
    }
}
