using System;
using System.Json;

/* 文档空间（服务端 /api/oa/docs/spaces）：文档的分组容器，docCount 是
   空间里的文档数——左栏一眼看出哪个空间还是空的。 */
public class WxDocSpace {
    string id;
    string name;
    string description;
    string docCount;

    WxDocSpace() {
        this.id = "";
        this.name = "";
        this.description = "";
        this.docCount = "0";
    }

    static WxDocSpace FromJson(JsonValue d) {
        WxDocSpace it = new WxDocSpace();
        if (d == null) { return it; }
        it.id = d.Str("id", "");
        it.name = d.Str("name", "未命名空间");
        it.description = d.Str("description", "");
        it.docCount = d.Str("docCount", "0");
        return it;
    }

    // 左栏行的副标题：几篇文档。
    string Sub() {
        return this.docCount + " 篇文档";
    }
}
