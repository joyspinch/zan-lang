using System;
using System.Json;

public class WxDocSpace {
    public string id = "";
    public string name = "";
    public string description = "";
    public string docCount = "0";

    public WxDocSpace() { }

    public static WxDocSpace FromDoc(JsonDoc doc, int slot) {
        WxDocSpace it = new WxDocSpace();
        if (doc == null || slot < 0) { return it; }
        it.id = doc.Str(slot, "id", "");
        it.name = doc.Str(slot, "name", "未命名空间");
        it.description = doc.Str(slot, "description", "");
        it.docCount = doc.Str(slot, "docCount", "0");
        return it;
    }

    public string Sub() {
        return this.docCount + " 篇文档";
    }
}
