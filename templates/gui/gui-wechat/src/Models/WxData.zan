    // ---- 群抽屉的成员格 ----------------------------------------------

    static List<WxMate> mates;

    // 群抽屉成员网格的那批昵称（zy. / H-one / 过客云飞…），全部虚构。
    static List<WxMate> Mates() {
        if (mates == null) {
            mates = new List<WxMate>();
            WxData.Mate("zy.", "z");
            WxData.Mate("H-one", "H");
            WxData.Mate("过客云飞", "过");
            WxData.Mate("纽扣", "纽");
            WxData.Mate("李东旭", "李");
            WxData.Mate("TlAn", "T");
            WxData.Mate("slimer", "s");
            WxData.Mate("永动机", "永");
            WxData.Mate("Sky", "S");
            WxData.Mate("陈工", "陈");
            WxData.Mate("初心不改", "初");
        }
        return mates;
    }

    static void Mate(string name, string ini) {
        WxData.Mates().Add(WxMate.Of(name, ini));
    }

    // 按序号轮换的色调类（头像格 / 记录行共用，避免一排同色）。
    static string TintOf(int i) {
        string[] ts = new string[]{ "primary", "info", "success", "warning",
            "error" };
        return ts[i % 5];
    }

    // 成员 id → 色调类：在注册表里找到就取它的位次色，找不到给
    // primary（气泡头像点开的资料名片用）。
    static string TintOfId(string id) {
        List<WxMember> ms = Members();
        for (int i = 0; i < ms.Count; i = i + 1) {
            if (ms[i].id == id) { return WxData.TintOf(i); }
        }
        return "primary";
    }

    // 抽屉上显示的微信号：通讯录里有这位就用资料里的，没有就按
    // 首字编一个（纯示例，不对应任何真实账号）。`ini` 由调用方
    // 显式给——字符串按字节索引，这里不切名字。
    static string WxidOf(string name, string ini) {
        List<WxContact> cs = WxData.Contacts();
        for (int i = 0; i < cs.Count; i = i + 1) {
            if (cs[i].kind == 2 && cs[i].name == name && cs[i].wxid != "") {
                return cs[i].wxid;
            }
        }
        return "wxid_" + ini;
    }

    // ---- 表情面板 ------------------------------------------------------

    // 所有表情（第一行起）。字形来自系统字体回退，Windows 上渲染为
    // 单色轮廓（Segoe UI Symbol 一类），不挑主题、不挑平台。
    static List<string> Emojis() {
        List<string> e = new List<string>();
