using System;
using Gui.Component;

public class WxTaskEventItem {
    string event;
    string at;
    string reason;
    string content;

    WxTaskEventItem() {
        this.event = "";
        this.at = "0";
        this.reason = "";
        this.content = "";
    }

    static WxTaskEventItem FromJson(JsonValue e) {
        WxTaskEventItem item = new WxTaskEventItem();
        if (e == null) { return item; }
        item.event = e.Str("event", "");
        item.at = e.Str("at", "0");
        item.reason = e.Str("reason", "");
        item.content = e.Str("content", "");
        return item;
    }
}

// 任务详情强类型实体（收敛 WxTaskSheet 弹卡对动态 JsonValue 树的遍历）。
