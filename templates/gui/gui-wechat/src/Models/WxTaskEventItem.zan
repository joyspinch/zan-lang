using System;
using System.Json;
using Gui.Component;

public class WxTaskEventItem {
    public string event = "";
    public string at = "0";
    public string reason = "";
    public string content = "";

    public WxTaskEventItem() { }

    public static WxTaskEventItem FromDoc(JsonDoc doc, int slot) {
        WxTaskEventItem item = new WxTaskEventItem();
        if (doc == null || slot < 0) { return item; }
        item.event = doc.Str(slot, "event", "");
        item.at = doc.Str(slot, "at", "0");
        item.reason = doc.Str(slot, "reason", "");
        item.content = doc.Str(slot, "content", "");
        return item;
    }
}
