using System;
using System.Json;

/* 流程（服务端 /api/flowagent/defs）：一条流程定义。
   aiNodes 是流程里的 AI 节点数（可分配 AI 工具的节点），tools 是已经
   分配上的工具数——左栏一眼看出哪些流程还没配 AI 工具。 */
public class WxFlowDefItem {
    string id;
    string name;
    string description;
    string aiNodes;
    string tools;

    WxFlowDefItem() {
        this.id = "";
        this.name = "";
        this.description = "";
        this.aiNodes = "0";
        this.tools = "0";
    }

    static WxFlowDefItem FromJson(JsonValue d) {
        WxFlowDefItem it = new WxFlowDefItem();
        if (d == null) { return it; }
        it.id = d.Str("id", "");
        it.name = d.Str("name", "未命名流程");
        it.description = d.Str("description", "");
        it.aiNodes = d.Str("aiNodes", "0");
        it.tools = d.Str("tools", "0");
        return it;
    }

    // 左栏行的副标题：几个 AI 节点、配了几个工具。
    string Sub() {
        return this.aiNodes + " 个 AI 节点 · " + this.tools + " 个工具";
    }
}
