using System;
using System.Json;

public class WxFlowDefItem {
    public string id = "";
    public string name = "";
    public string description = "";
    public string aiNodes = "0";
    public string tools = "0";

    public WxFlowDefItem() { }

    public static WxFlowDefItem FromDoc(JsonDoc doc, int slot) {
        WxFlowDefItem it = new WxFlowDefItem();
        if (doc == null || slot < 0) { return it; }
        it.id = doc.Str(slot, "id", "");
        it.name = doc.Str(slot, "name", "未命名流程");
        it.description = doc.Str(slot, "description", "");
        it.aiNodes = doc.Str(slot, "aiNodes", "0");
        it.tools = doc.Str(slot, "tools", "0");
        return it;
    }

    public string Sub() {
        return this.aiNodes + " 个 AI 节点 · " + this.tools + " 个工具";
    }
}
