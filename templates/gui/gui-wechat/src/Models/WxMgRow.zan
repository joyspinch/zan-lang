using System;
using Gui.Component;

public class WxMgRow {
    string name;
    string ini;  // 头像首字（Zan 字符串按字节索引，中文必须显式给）
    string tint;
    string remark;
    string tag;
    string perm;  // 朋友权限：仅聊天 / 不让他（她）看 / 不看他（她）
    bool picked;

    WxMgRow() {
        this.name = "";
        this.ini = "";
        this.tint = "primary";
        this.remark = "";
        this.tag = "";
        this.perm = "仅聊天";
        this.picked = false;
    }

    static WxMgRow Of(string name, string ini, string tint, string remark,
            string tag, string perm) {
        WxMgRow r = new WxMgRow();
        r.name = name;
        r.ini = ini;
        r.tint = tint;
        r.remark = remark;
        r.tag = tag;
        r.perm = perm;
        return r;
    }
}

