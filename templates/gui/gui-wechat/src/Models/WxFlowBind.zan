using System;
using System.Json;

public class WxFlowBind {
    public string id = "";
    public string agentCode = "";
    public int priority = 1;
    public string enabled = "1";
    public string note = "";
    public string state = "healthy";
    public string failures = "0";
    public string lastError = "";
    public string cooling = "0";

    public WxFlowBind() { }

    public static WxFlowBind FromDoc(JsonDoc doc, int slot) {
        WxFlowBind it = new WxFlowBind();
        if (doc == null || slot < 0) { return it; }
        it.id = doc.Str(slot, "id", "");
        it.agentCode = doc.Str(slot, "agentCode", "");
        it.priority = (int)doc.Long(slot, "priority", 1L);
        it.enabled = doc.Str(slot, "enabled", "1");
        it.note = doc.Str(slot, "note", "");
        it.state = doc.Str(slot, "state", "healthy");
        it.failures = doc.Str(slot, "failures", "0");
        it.lastError = doc.Str(slot, "lastError", "");
        it.cooling = doc.Str(slot, "cooling", "0");
        return it;
    }

    public bool On() {
        return this.enabled == "1";
    }

    public string StateZh() {
        if (this.cooling == "1") { return "冷却中"; }
        if (this.state == "degraded") { return "降级"; }
        if (this.state == "down") { return "不可用"; }
        return "正常";
    }

    public string StateCls() {
        if (this.cooling == "1") { return "error"; }
        if (this.state == "degraded") { return "warning"; }
        if (this.state == "down") { return "error"; }
        return "success";
    }
}
