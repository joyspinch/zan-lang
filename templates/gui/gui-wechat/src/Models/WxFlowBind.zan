using System;
using System.Json;

/* 一个工具在某节点上的分配（服务端 /api/flowagent/nodes 的 agents 项）。
   priority 是高可用顺序：数字小优先，派发时按序试，失败自动降级到
   下一个。state/cooling 是服务端记的健康状态（连续失败会转降级并
   冷却，客户端如实显示，不自己猜）。 */
public class WxFlowBind {
    string id;
    string agentCode;
    int priority;
    string enabled;
    string note;
    string state;
    string failures;
    string lastError;
    string cooling;

    WxFlowBind() {
        this.id = "";
        this.agentCode = "";
        this.priority = 1;
        this.enabled = "1";
        this.note = "";
        this.state = "healthy";
        this.failures = "0";
        this.lastError = "";
        this.cooling = "0";
    }

    static WxFlowBind FromJson(JsonValue d) {
        WxFlowBind it = new WxFlowBind();
        if (d == null) { return it; }
        it.id = d.Str("id", "");
        it.agentCode = d.Str("agentCode", "");
        it.priority = Convert.ToInt32(d.Str("priority", "1"));
        it.enabled = d.Str("enabled", "1");
        it.note = d.Str("note", "");
        it.state = d.Str("state", "healthy");
        it.failures = d.Str("failures", "0");
        it.lastError = d.Str("lastError", "");
        it.cooling = d.Str("cooling", "0");
        return it;
    }

    // 停用中的工具不参与派发（配置留着，随时能开回来）。
    bool On() {
        return this.enabled == "1";
    }

    // 健康状态的中文说法：冷却优先于降级（冷却是降级后的表现）。
    string StateZh() {
        if (this.cooling == "1") { return "冷却中"; }
        if (this.state == "degraded") { return "降级"; }
        if (this.state == "down") { return "不可用"; }
        return "正常";
    }

    // 状态色调类（皮肤层配 --success/--warning/--error）。
    string StateCls() {
        if (this.cooling == "1") { return "error"; }
        if (this.state == "degraded") { return "warning"; }
        if (this.state == "down") { return "error"; }
        return "success";
    }
}
