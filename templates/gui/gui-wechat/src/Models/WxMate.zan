using System;
using Gui.Component;

public class WxMate {
    string name;
    string ini;

    WxMate(string name, string ini) {
        this.name = name;
        this.ini = ini;
    }

    static WxMate Of(string name, string ini) {
        return new WxMate(name, ini);
    }
}

