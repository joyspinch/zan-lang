using System;
using System.Collections.Generic;
using System.Json;
using Gui.Component;

public class WxFlowDefDetail {
    public string id = "";
    public string name = "";
    public string description = "";
    public int status = 1;
    public List<WxFlowNodeItem> nodes = new List<WxFlowNodeItem>();

    public WxFlowDefDetail() { }

    public static WxFlowDefDetail FromDoc(JsonDoc doc, int slot) {
        WxFlowDefDetail def = new WxFlowDefDetail();
        if (doc == null || slot < 0) { return def; }
        def.id = doc.Str(slot, "id", "");
        def.name = doc.Str(slot, "name", "");
        def.description = doc.Str(slot, "description", "");
        def.status = (int)doc.Long(slot, "status", 1L);
        int ns = doc.Get(slot, "nodes");
        if (ns >= 0 && doc.KindAt(ns) == 4) {
            int count = doc.Count(ns);
            for (int i = 0; i < count; i = i + 1) {
                def.nodes.Add(WxFlowNodeItem.FromDoc(doc, doc.At(ns, i)));
            }
        }
        return def;
    }
}
