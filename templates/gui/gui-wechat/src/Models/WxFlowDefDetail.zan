using System;
using Gui.Component;

public class WxFlowDefDetail {
    string id;
    string name;
    string description;
    int status;
    List<WxFlowNodeItem> nodes;

    WxFlowDefDetail() {
        this.id = "";
        this.name = "";
        this.description = "";
        this.status = 1;
        this.nodes = new List<WxFlowNodeItem>();
    }

    static WxFlowDefDetail FromJson(JsonValue d) {
        WxFlowDefDetail def = new WxFlowDefDetail();
        if (d == null) { return def; }
        def.id = d.Str("id", "");
        def.name = d.Str("name", "");
        def.description = d.Str("description", "");
        def.status = Convert.ToInt32(d.Str("status", "1"));
        JsonValue ns = d.Get("nodes");
        if (ns != null && ns.IsArray()) {
            for (int i = 0; i < ns.Count(); i = i + 1) {
                def.nodes.Add(WxFlowNodeItem.FromJson(ns.At(i)));
            }
        }
        return def;
    }
}

// 通讯录的一行：分组节 / 字母分组头 / 联系人 / 好友申请 / 群聊 /
// 公众号 / 企业，七类共用一种行类型，列表的行模板按 `kind` 决定
// 长什么样，`Selectable()` 把字母头排除在可选之外。分组节是可折叠
// 的：页面按 `open` 状态重建视图列表，内容行靠 `section` 归属到节。
