using System;
using System.Json;

public class WxBitableItem {
    public string id = "";
    public string name = "";
    public string icon = "table";
    public string description = "";
    public string owner = "";
    public string shared = "0";
    public string fieldCount = "0";
    public string recordCount = "0";
    public string updatedAt = "0";

    public WxBitableItem() { }

    public static WxBitableItem FromDoc(JsonDoc doc, int slot) {
        WxBitableItem it = new WxBitableItem();
        if (doc == null || slot < 0) { return it; }
        it.id = doc.Str(slot, "id", "");
        it.name = doc.Str(slot, "name", "未命名表格");
        it.icon = doc.Str(slot, "icon", "table");
        it.description = doc.Str(slot, "description", "");
        it.owner = doc.Str(slot, "owner", "");
        it.shared = doc.Str(slot, "shared", "0");
        it.fieldCount = doc.Str(slot, "fields", "0");
        it.recordCount = doc.Str(slot, "records", "0");
        it.updatedAt = doc.Str(slot, "updatedAt", "0");
        return it;
    }

    public string Sub() {
        return this.fieldCount + " 列 · " + this.recordCount + " 行";
    }
}
