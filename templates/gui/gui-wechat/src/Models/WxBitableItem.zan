using System;
using System.Json;

/* 多维表格（服务端 /api/bitable 端点）：表本体。
   服务端把「表 / 列 / 行」三层摊平成 JSON：表与列是元数据，行是
   cells 字符串数组（顺序与列一一对应）——客户端据此建网格，不必
   再猜列下标的含义。 */
public class WxBitableItem {
    string id;
    string name;
    string icon;
    string description;
    string owner;
    string shared;
    string fieldCount;
    string recordCount;
    string updatedAt;

    WxBitableItem() {
        this.id = "";
        this.name = "";
        this.icon = "table";
        this.description = "";
        this.owner = "";
        this.shared = "0";
        this.fieldCount = "0";
        this.recordCount = "0";
        this.updatedAt = "0";
    }

    static WxBitableItem FromJson(JsonValue d) {
        WxBitableItem it = new WxBitableItem();
        if (d == null) { return it; }
        it.id = d.Str("id", "");
        it.name = d.Str("name", "未命名表格");
        it.icon = d.Str("icon", "table");
        it.description = d.Str("description", "");
        it.owner = d.Str("owner", "");
        it.shared = d.Str("shared", "0");
        it.fieldCount = d.Str("fields", "0");
        it.recordCount = d.Str("records", "0");
        it.updatedAt = d.Str("updatedAt", "0");
        return it;
    }

    // 左栏行的副标题：列数 + 行数（表本体自带的计数，不必再查）。
    string Sub() {
        return this.fieldCount + " 列 · " + this.recordCount + " 行";
    }
}
