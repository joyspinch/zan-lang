using System;
using Gui.Component;

public class WxMessageSnapshot {
    string id;
    bool mine;
    string content;
    long at;
    bool readed;
    bool acked;
    string replyTo;
    string quoteWho;
    string quoteText;
    string kind;
    string from;
    string name;
    string attachmentId;
    string fileName;
    int width;
    int height;
    long size;
    string taskTitle;
    string taskStatus;
    string taskId;

    WxMessageSnapshot() {
        this.id = "";
        this.mine = false;
        this.content = "";
        this.at = 0;
        this.readed = false;
        this.acked = false;
        this.replyTo = "";
        this.quoteWho = "";
        this.quoteText = "";
        this.kind = "text";
        this.from = "";
        this.name = "";
        this.attachmentId = "";
        this.fileName = "";
        this.width = 0;
        this.height = 0;
        this.size = 0;
        this.taskTitle = "";
        this.taskStatus = "";
        this.taskId = "";
    }

    static WxMessageSnapshot FromJson(JsonValue o) {
        WxMessageSnapshot m = new WxMessageSnapshot();
        if (o == null) { return m; }
        m.id = o.Str("id", "");
        m.mine = o.Str("mine", "0") == "1";
        m.content = o.Str("content", "");
        m.at = Convert.ToInt64(o.Str("at", "0"));
        m.readed = o.Str("readed", "0") == "1";
        m.acked = o.Str("acked", "0") == "1";
        m.replyTo = o.Str("replyTo", "");
        m.quoteWho = o.Str("quoteWho", "");
        m.quoteText = o.Str("quoteText", "");
        m.kind = o.Str("kind", "text");
        m.from = o.Str("from", "");
        m.name = o.Str("name", "");
        m.attachmentId = o.Str("attachmentId", "");
        m.fileName = o.Str("fileName", "");
        m.width = Convert.ToInt32(o.Str("width", "0"));
        m.height = Convert.ToInt32(o.Str("height", "0"));
        m.size = Convert.ToInt64(o.Str("size", "0"));
        m.taskTitle = o.Str("taskTitle", "");
        m.taskStatus = o.Str("taskStatus", "");
        m.taskId = o.Str("taskId", "");
        return m;
    }
}

// 任务动态审计流项强类型实体。
