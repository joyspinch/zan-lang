using System;
using System.Json;
using Gui.Component;

public class WxMessageSnapshot {
    public string id = "";
    public bool mine = false;
    public string content = "";
    public long at = 0;
    public bool readed = false;
    public bool acked = false;
    public string replyTo = "";
    public string quoteWho = "";
    public string quoteText = "";
    public string kind = "text";
    public string from = "";
    public string name = "";
    public string attachmentId = "";
    public string fileName = "";
    public int width = 0;
    public int height = 0;
    public long size = 0;
    public string taskTitle = "";
    public string taskStatus = "";
    public string taskId = "";

    public WxMessageSnapshot() { }

    public static WxMessageSnapshot FromDoc(JsonDoc doc, int slot) {
        WxMessageSnapshot m = new WxMessageSnapshot();
        if (doc == null || slot < 0) { return m; }
        m.id = doc.Str(slot, "id", "");
        m.mine = doc.Str(slot, "mine", "0") == "1" || doc.Bool(slot, "mine", false);
        m.content = doc.Str(slot, "content", "");
        m.at = doc.Long(slot, "at", 0L);
        m.readed = doc.Str(slot, "readed", "0") == "1" || doc.Bool(slot, "readed", false);
        m.acked = doc.Str(slot, "acked", "0") == "1" || doc.Bool(slot, "acked", false);
        m.replyTo = doc.Str(slot, "replyTo", "");
        m.quoteWho = doc.Str(slot, "quoteWho", "");
        m.quoteText = doc.Str(slot, "quoteText", "");
        m.kind = doc.Str(slot, "kind", "text");
        m.from = doc.Str(slot, "from", "");
        m.name = doc.Str(slot, "name", "");
        m.attachmentId = doc.Str(slot, "attachmentId", "");
        m.fileName = doc.Str(slot, "fileName", "");
        m.width = (int)doc.Long(slot, "width", 0L);
        m.height = (int)doc.Long(slot, "height", 0L);
        m.size = doc.Long(slot, "size", 0L);
        m.taskTitle = doc.Str(slot, "taskTitle", "");
        m.taskStatus = doc.Str(slot, "taskStatus", "");
        m.taskId = doc.Str(slot, "taskId", "");
        return m;
    }
}
