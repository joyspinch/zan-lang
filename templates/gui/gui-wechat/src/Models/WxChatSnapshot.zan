using System;
using Gui.Component;

public class WxChatSnapshot {
    string peerId;
    string peerName;
    string lastText;
    string lastAt;
    int unread;
    int sentUnread;
    int readed;
    int acked;
    string ackId;

    WxChatSnapshot(string peerId, string peerName, string lastText, string lastAt,
        int unread, int sentUnread, int readed, int acked, string ackId) {
        this.peerId = peerId != null ? peerId : "";
        this.peerName = peerName != null ? peerName : "";
        this.lastText = lastText != null ? lastText : "";
        this.lastAt = lastAt != null ? lastAt : "0";
        this.unread = unread;
        this.sentUnread = sentUnread;
        this.readed = readed;
        this.acked = acked;
        this.ackId = ackId != null ? ackId : "0";
    }

    string PeerId { get { return peerId; } }
    string PeerName { get { return peerName; } }
    string LastText { get { return lastText; } }
    string LastAt { get { return lastAt; } }
    int Unread { get { return unread; } }
    int SentUnread { get { return sentUnread; } }
    int Readed { get { return readed; } }
    int Acked { get { return acked; } }
    string AckId { get { return ackId; } }
}

// 群聊会话网络快照实体（消除 groupRows 动态 JsonValue 树散布）。
