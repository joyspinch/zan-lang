using System;
using System.Json;
using Gui.Component;

public class WxChatSnapshot {
    public string peerId = "";
    public string peerName = "";
    public string lastText = "";
    public string lastAt = "0";
    public int unread = 0;
    public int sentUnread = 0;
    public int readed = 0;
    public int acked = 0;
    public string ackId = "0";

    public WxChatSnapshot(string peerId, string peerName, string lastText, string lastAt,
        int unread, int sentUnread, int readed, int acked, string ackId) {
        this.peerId = peerId != null ? peerId : "";
        this.peerName = peerName != null ? peerName : "";
        this.lastText = lastText != null ? lastText : "";
        this.lastAt = lastAt != null ? lastAt : "0";
        this.unread = unread;
        this.sentUnread = sentUnread;
        this.readed = readed;
        this.acked = acked;
        this.ackId = ackId != null ? ackId : "0";
    }

    public static WxChatSnapshot FromDoc(JsonDoc doc, int slot) {
        if (doc == null || slot < 0) {
            return new WxChatSnapshot("", "?", "", "0", 0, 0, 0, 0, "0");
        }
        string unreadStr = doc.Str(slot, "unread", "0");
        int unread = (int)doc.Long(slot, "unread", 0);
        if (unread == 0 && unreadStr != "0") {
            try { unread = int.Parse(unreadStr); } catch (Exception) { }
        }
        string sentUnreadStr = doc.Str(slot, "sentUnread", "0");
        int sentUnread = (int)doc.Long(slot, "sentUnread", 0);
        if (sentUnread == 0 && sentUnreadStr != "0") {
            try { sentUnread = int.Parse(sentUnreadStr); } catch (Exception) { }
        }
        return new WxChatSnapshot(
            doc.Str(slot, "peerId", ""),
            doc.Str(slot, "peerName", "?"),
            doc.Str(slot, "lastText", ""),
            doc.Str(slot, "lastAt", "0"),
            unread,
            sentUnread,
            doc.Str(slot, "readed", "0") == "1" ? 1 : 0,
            doc.Str(slot, "acked", "0") == "1" ? 1 : 0,
            doc.Str(slot, "ackId", "0")
        );
    }

    public string PeerId { get { return this.peerId; } }
    public string PeerName { get { return this.peerName; } }
    public string LastText { get { return this.lastText; } }
    public string LastAt { get { return this.lastAt; } }
    public int Unread { get { return this.unread; } }
    public int SentUnread { get { return this.sentUnread; } }
    public int Readed { get { return this.readed; } }
    public int Acked { get { return this.acked; } }
    public string AckId { get { return this.ackId; } }
}
