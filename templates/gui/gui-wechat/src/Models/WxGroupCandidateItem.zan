using System;

public class WxGroupCandidateItem {
    public string id;
    public string name;
    public string username;
    public string ini;
    public string tint;
    public bool picked;

    public WxGroupCandidateItem(string id, string name, string username, string ini, string tint) {
        this.id = id;
        this.name = name;
        this.username = username;
        this.ini = ini;
        this.tint = tint;
        this.picked = false;
    }
}
