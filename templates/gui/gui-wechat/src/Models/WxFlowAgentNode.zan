using System;
using System.Collections.Generic;
using System.Json;

/* AI 分配页的流程节点（服务端 /api/flowagent/nodes）：节点链上的一环。
   kind=ai 的节点才是 AI 工具的落点——人工节点不分配工具。
   （工作台那边另有一个 WxFlowNodeItem，是流程实例的节点，两者不同。） */
public class WxFlowAgentNode {
    string id;
    string name;
    string sort;
    string kind;
    string aiPrompt;
    List<WxFlowBind> agents;

    WxFlowAgentNode() {
        this.id = "";
        this.name = "";
        this.sort = "0";
        this.kind = "human";
        this.aiPrompt = "";
        this.agents = new List<WxFlowBind>();
    }

    static WxFlowAgentNode FromJson(JsonValue d) {
        WxFlowAgentNode it = new WxFlowAgentNode();
        if (d == null) { return it; }
        it.id = d.Str("id", "");
        it.name = d.Str("name", "未命名节点");
        it.sort = d.Str("sort", "0");
        it.kind = d.Str("kind", "human");
        it.aiPrompt = d.Str("aiPrompt", "");
        JsonValue arr = d.Get("agents");
        int n = arr == null ? 0 : arr.Count();
        for (int i = 0; i < n; i = i + 1) {
            it.agents.Add(WxFlowBind.FromJson(arr.At(i)));
        }
        return it;
    }

    // 中栏行的副标题：AI 节点写工具数，人工节点直接标出来。
    string Sub() {
        if (this.kind == "ai") {
            return "AI 节点 · " + Convert.ToString(this.agents.Count) + " 个工具";
        }
        return "人工节点";
    }
}
