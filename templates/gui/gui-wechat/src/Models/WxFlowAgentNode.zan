using System;
using System.Collections.Generic;
using System.Json;

public class WxFlowAgentNode {
    public string id = "";
    public string name = "";
    public string sort = "0";
    public string kind = "human";
    public string aiPrompt = "";
    public List<WxFlowBind> agents = new List<WxFlowBind>();

    public WxFlowAgentNode() { }

    public static WxFlowAgentNode FromDoc(JsonDoc doc, int slot) {
        WxFlowAgentNode it = new WxFlowAgentNode();
        if (doc == null || slot < 0) { return it; }
        it.id = doc.Str(slot, "id", "");
        it.name = doc.Str(slot, "name", "未命名节点");
        it.sort = doc.Str(slot, "sort", "0");
        it.kind = doc.Str(slot, "kind", "human");
        it.aiPrompt = doc.Str(slot, "aiPrompt", "");
        int arr = doc.Get(slot, "agents");
        int n = (arr >= 0 && doc.KindAt(arr) == 4) ? doc.Count(arr) : 0;
        for (int i = 0; i < n; i = i + 1) {
            it.agents.Add(WxFlowBind.FromDoc(doc, doc.At(arr, i)));
        }
        return it;
    }

    public string Sub() {
        if (this.kind == "ai") {
            return "AI 节点 · " + this.agents.Count.ToString() + " 个工具";
        }
        return "人工节点";
    }
}
