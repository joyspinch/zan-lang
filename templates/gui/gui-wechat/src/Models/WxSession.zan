using System;
using Gui.Component;

public class WxSession {
    string name;  // 列表标题（对方昵称或群名）
    string initial;  // 头像里的首字
    string tint;  // 头像色调类：primary / info / success / warning
    bool group;  // 群聊：气泡上方显示发言人名字
    int people;  // 群成员数（一对一为 0）
    string snippet;  // 列表第二行：最后一条摘要
    string time;  // 列表右上角时间
    int unread;  // 未读数，0 = 不显示角标
    string peer;  // 旧域（/api/im）对端账号 id（"" = 非 1:1）
    string conv;  // collab 域会话 id（"" = 非 collab 群聊）
    int sentUnread;  // 我发出且对方未读的条数（列表"未送达"语义）
    int lastMark;  // 最后一条我发的消息的回执：0 发出 1 送达 2 已读
    List<ChatMessage> msgs;

    WxSession(string name, string initial, string tint, bool group, int people,
            string snippet, string time, int unread) {
        this.name = name;
        this.initial = initial;
        this.tint = tint;
        this.group = group;
        this.people = people;
        this.snippet = snippet;
        this.time = time;
        this.unread = unread;
        this.peer = "";
        this.conv = "";
        this.sentUnread = 0;
        this.lastMark = 0;
        this.msgs = new List<ChatMessage>();
    }

    // 桥（WxIm）重建会话表用的空槽：字段随后逐项填。
    static WxSession Blank() {
        return new WxSession("", "", "primary", false, 0, "", "", 0);
    }

    static WxSession Group(string name, string initial, string tint, int people,
            string snippet, string time, int unread) {
        return new WxSession(name, initial, tint, true, people,
            snippet, time, unread);
    }

    static WxSession Peer(string name, string initial, string tint,
            string snippet, string time, int unread) {
        return new WxSession(name, initial, tint, false, 0,
            snippet, time, unread);
    }

    // 是否接了服务端（1:1 旧域或 collab 群聊，二选一）。
    bool Linked() {
        return this.peer.Length > 0 || this.conv.Length > 0;
    }

    // 槽身份键：collab 群聊按会话 id，
    // 1:1 按旧域对端 id——两域并行、互不串槽。
    string Key() {
        if (this.conv.Length > 0) { return "c" + this.conv; }
        return "p" + this.peer;
    }
}

// 1:1 私聊会话网络快照实体（消除 imChats 动态 JsonValue 树散布）。
