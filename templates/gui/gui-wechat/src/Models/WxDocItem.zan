using System;
using System.Json;

/* 文档（服务端 /api/oa/docs/list）：一篇文档的摘要行。正文不在这里
   （走 /api/oa/docs/doc 单独取），列表只给标题、版本、最后编辑人与摘要。 */
public class WxDocItem {
    string id;
    string spaceId;
    string title;
    string version;
    string updatedAt;
    string editor;
    string excerpt;

    WxDocItem() {
        this.id = "";
        this.spaceId = "";
        this.title = "";
        this.version = "0";
        this.updatedAt = "";
        this.editor = "";
        this.excerpt = "";
    }

    static WxDocItem FromJson(JsonValue d) {
        WxDocItem it = new WxDocItem();
        if (d == null) { return it; }
        it.id = d.Str("id", "");
        it.spaceId = d.Str("spaceId", "");
        it.title = d.Str("title", "未命名文档");
        it.version = d.Str("version", "0");
        it.updatedAt = d.Str("updatedAt", "");
        it.editor = d.Str("editor", "");
        it.excerpt = d.Str("excerpt", "");
        return it;
    }

    // 行的副标题：版本 · 最后编辑人 · 更新时间。
    string Sub() {
        string s = "v" + this.version;
        if (this.editor.Length > 0) { s = s + " · " + this.editor; }
        if (this.updatedAt.Length > 0) { s = s + " · " + this.updatedAt; }
        return s;
    }
}
