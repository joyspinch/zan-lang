using System;
using System.Json;

public class WxDocItem {
    public string id = "";
    public string spaceId = "";
    public string title = "";
    public string version = "0";
    public string updatedAt = "";
    public string editor = "";
    public string excerpt = "";

    public WxDocItem() { }

    public static WxDocItem FromDoc(JsonDoc doc, int slot) {
        WxDocItem it = new WxDocItem();
        if (doc == null || slot < 0) { return it; }
        it.id = doc.Str(slot, "id", "");
        it.spaceId = doc.Str(slot, "spaceId", "");
        it.title = doc.Str(slot, "title", "未命名文档");
        it.version = doc.Str(slot, "version", "0");
        it.updatedAt = doc.Str(slot, "updatedAt", "");
        it.editor = doc.Str(slot, "editor", "");
        it.excerpt = doc.Str(slot, "excerpt", "");
        return it;
    }

    public string Sub() {
        string s = "v" + this.version;
        if (this.editor.Length > 0) { s = s + " · " + this.editor; }
        if (this.updatedAt.Length > 0) { s = s + " · " + this.updatedAt; }
        return s;
    }
}
