using System;
using System.Json;
using Gui.Component;

public class WxFlowTaskItem {
    public string id = "";
    public int status = 0;
    public string assignUserId = "0";
    public string result = "";
    public string finishedAt = "0";

    public WxFlowTaskItem() { }

    public static WxFlowTaskItem FromDoc(JsonDoc doc, int slot) {
        WxFlowTaskItem t = new WxFlowTaskItem();
        if (doc == null || slot < 0) { return t; }
        t.id = doc.Str(slot, "id", "");
        t.status = (int)doc.Long(slot, "status", 0L);
        t.assignUserId = doc.Str(slot, "assignUserId", "0");
        t.result = doc.Str(slot, "result", "");
        t.finishedAt = doc.Str(slot, "finishedAt", "0");
        return t;
    }
}
