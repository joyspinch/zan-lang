using System;
using Gui.Component;

public class WxFlowTaskItem {
    string id;
    int status;
    string assignUserId;
    string result;
    string finishedAt;

    WxFlowTaskItem() {
        this.id = "";
        this.status = 0;
        this.assignUserId = "0";
        this.result = "";
        this.finishedAt = "0";
    }

    static WxFlowTaskItem FromJson(JsonValue o) {
        WxFlowTaskItem t = new WxFlowTaskItem();
        if (o == null) { return t; }
        t.id = o.Str("id", "");
        t.status = Convert.ToInt32(o.Str("status", "0"));
        t.assignUserId = o.Str("assignUserId", "0");
        t.result = o.Str("result", "");
        t.finishedAt = o.Str("finishedAt", "0");
        return t;
    }
}

// 工作流环节/节点强类型实体。
