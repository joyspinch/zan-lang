using System;
using Gui;
using Gui.Component;
using Gui.Widget;

/// 设置窗口：一扇真正的独立子窗口（`Gui.ChildWindow`），不是主窗口里的
/// 浮层——原版的设置就是这样一扇可以自己移动、自己关掉的窗口。
/// 界面本体仍是 `WxSettingsView` 这棵标准库控件树，窗口只负责外壳：
/// 标题、初始尺寸、把宿主样式表铺进来、以及随主窗口换肤。
class WxSettingsWindow : ChildWindow {
    /// 同时只留一扇设置窗：已经开着就重绘现有的，不叠第二扇。
    static WxSettingsWindow live;
    App owner;
    WxSettingsView view;

    override string Title() { return "设置"; }
    /// 原版设置窗是一扇窄窗：左导航 166 + 右正文，760 足够。
    override int Width() { return 760; }
    override int Height() { return 620; }
    /// 设置窗不是工作区，不要最大化按钮（最小化/关闭照常）。
    override bool ShowMaximize() { return false; }
    override int IdBase() { return 910000; }

    /// 打开设置窗（主窗口导航栏的齿轮按钮调用）。
    static void Open(App app) {
        if (WxSettingsWindow.live != null && WxSettingsWindow.live.IsOpen()) {
            WxSettingsWindow.live.RequestRedraw();
            return;
        }
        WxSettingsWindow w = new WxSettingsWindow();
        w.owner = app;
        w.view = new WxSettingsView(app);
        // 纯代码建树：没有 .zform 的 bind 通道，model 传 null。
        w.SetRoot(w.view, null);
        w.Wire();
        w.OpenHost(app);
        // 子窗口是另一个 App，主窗口用 UseAppCss 铺的 .wx* 类不会自动
        // 跟过来；外壳类与正文类都在同一张 WxSkin 表里，铺同一份即可。
        w.host.UseAppCss(WxSkin.Css());
        w.RequestRedraw();
        WxSettingsWindow.live = w;
    }
}

/// 独立聊天窗口：把会话行拖出主窗口后，这条会话开成一扇自己的子窗口
/// （原版微信的「拖出来成独立窗口」）。窗口里是一份完整会话视图——
/// 标题 + 气泡记录 + 输入区——数据与主窗口共享同一个 `WxSession`，
/// 因此两边看到的是同一份记录；在这里发送后由 `notify` 让主窗口刷新
/// 列表摘要与当前会话。
class WxChatWindow : ChildWindow {
    /// 每个会话至多一扇窗（拖出同一条会话不再开第二扇）。
    static List<WxChatWindow> wins;
    /// 各窗口的 WidgetId 基线：同进程内窗口不许撞号，每扇窗占一段
    /// （同基线会让两扇窗的悬停/按压 id 互相覆盖）。
    static int nextBase = 930000;
    WxSession sess;
    App owner;
    Action notify;
    int idBaseVal;
    ChatView chat;
    TextArea box;
    WxProfilePanel prof;

    WxChatWindow() {
        this.idBaseVal = WxChatWindow.nextBase;
        WxChatWindow.nextBase = WxChatWindow.nextBase + 2000;
        this.sess = null;
        this.owner = null;
        this.notify = null;
    }

    /// 把会话 `s` 开成独立窗口。`afterSend` 由宿主传入，用于在浮窗里
    /// 发出消息后刷新主窗口（列表摘要 + 当前会话记录）。
    static void Open(App app, WxSession s, Action afterSend) {
        WxChatWindow old = WxChatWindow.Find(s);
        if (old != null) {
            old.notify = afterSend;
            old.RequestRedraw();
            return;
        }
        WxChatWindow w = new WxChatWindow();
        w.sess = s;
        w.owner = app;
        w.notify = afterSend;
        w.BuildWindow();
        if (WxChatWindow.wins == null) {
            WxChatWindow.wins = new List<WxChatWindow>();
        }
        WxChatWindow.wins.Add(w);
    }

    /// 已开着的该会话窗口（按会话对象认：槽身份跟对端走，同一会话
    /// 在轮询重建前后是同一个对象）。
    static WxChatWindow Find(WxSession s) {
        if (WxChatWindow.wins == null) { return null; }
        for (int i = 0; i < WxChatWindow.wins.Count; i = i + 1) {
            WxChatWindow w = WxChatWindow.wins[i];
            if (w.IsOpen() && w.sess == s) { return w; }
        }
        return null;
    }

    /// 共享模型变了（轮询并入新消息、回执翻位）就重画气泡区。
    /// WxIm.RefreshViews 对每扇开着的窗调一遍。
    static void RefreshAll() {
        if (WxChatWindow.wins == null) { return; }
        for (int i = 0; i < WxChatWindow.wins.Count; i = i + 1) {
            WxChatWindow w = WxChatWindow.wins[i];
            if (w.IsOpen()) { w.OnModelChanged(); }
        }
    }

    void OnModelChanged() {
        if (chat == null || !this.IsOpen()) { return; }
        this.BindChat();
        this.RequestRedraw();
    }

    override string Title() { return sess.name; }
    /// 独立会话窗比主窗口窄：一列气泡 + 一条输入区。
    override int Width() { return 520; }
    override int Height() { return 680; }
    override bool ShowMaximize() { return false; }
    override int IdBase() { return idBaseVal; }

    /// 搭窗口的控件树。结构与主窗口聊天页右侧一致（标题条 / 气泡记录 /
    /// 输入区），所以沿用同一批 wx* 类；这里一个像素也不画。
    void BuildWindow() {
        Panel root = Wx.Col("wxchatwin");

        Flex head = Wx.Row("wxhead");
        Avatar headAva = Wx.Ava(sess.initial, 34, sess.tint);
        headAva.OnClick(() => {
            this.ShowProfile(WxProfiles.Of(sess.name, sess.initial,
                sess.tint));
        });
        head.Add(headAva);
        Panel hp = Panel.Column();
        hp.Class = "grow";
        hp.Grow();
        hp.Add(Wx.Lbl(sess.name, "wxheadname"));
        if (sess.group) {
            hp.Add(Wx.Lbl("群聊 · " + Convert.ToString(sess.people) + " 人",
                "wxheaddesc"));
        } else {
            hp.Add(Wx.Lbl("独立窗口", "wxheaddesc"));
        }
        head.Add(hp);
        head.Add(Wx.IconBtn("dots"));
        root.Add(head);
        root.Add(Wx.Line());

        Panel comp = Wx.Col("wxcomposer");
        // 与主窗口聊天页同款：输入框在上，图标 + 发送在底部。
        Panel tw = Wx.Col("wxtypewrap");
        tw.Grow();
        box = new TextArea("");
        box.Class = "wxtype";
        box.Grow();
        tw.Add(box);
        comp.Add(tw);
        ToolStrip bar = new ToolStrip();
        bar.SetIconOnly(true);
        bar.Class = "grow";
        bar.Add("", "mood-smile");
        bar.Add("", "folder");
        bar.Add("", "scissors");
        Flex bb = Wx.Row("wxbottom");
        bb.Add(bar);
        Button send = new Button("发送");
        send.Class = "primary small";
        send.OnClick(() => { this.Send(); });
        bb.Add(send);
        comp.Add(bb);
        root.Add(comp);
        root.Add(Wx.Line());

        chat = new ChatView();
        chat.Class = "wxchat";
        chat.Grow();
        chat.WithStyle(ChatStyle.Bubble());
        chat.WithBubbleWidth(560);
        this.BindChat();
        chat.OnAvatarClick((idx) => { this.OpenMsgProfile(idx); });
        root.Add(chat);

        prof = WxProfilePanel.Of();
        root.Add(prof);

        this.SetRoot(root, null);
        this.Wire();
        this.OpenHost(this.owner);
        // 子窗口是另一个 App：主窗口铺的 .wx* 应用样式表要再铺一遍，
        // 否则这扇窗里只有皮肤基线、没有会话布局类。
        this.host.UseAppCss(WxSkin.Css());
        this.RequestRedraw();
    }

    /// 点气泡头像弹名片：解析与主窗口聊天页同一套（user=我，
    /// agent 按注册表，其余用会话对方）。
    void OpenMsgProfile(int idx) {
        if (idx < 0 || idx >= sess.msgs.Count) { return; }
        ChatMessage m = sess.msgs[idx];
        if (m.role == "user") {
            this.ShowProfile(WxProfiles.Me());
            return;
        }
        if (m.agent != "") {
            string nm = WxData.NameOf(m.agent);
            if (nm != null) {
                this.ShowProfile(WxProfiles.Of(nm,
                    WxData.IniOf(m.agent), WxData.TintOfId(m.agent)));
                return;
            }
        }
        this.ShowProfile(WxProfiles.Of(sess.name, sess.initial, sess.tint));
    }

    /// 弹名片。浮窗没有抽屉/弹出层，名片直接盖上即可。
    void ShowProfile(WxProfileCard c) {
        prof.Show(c);
        this.RequestRedraw();
    }

    /// 与主窗口同一套气泡配置（发言人解析走同一份虚构数据）。
    void BindChat() {
        ChatStrings cs = ChatStrings.Default();
        cs.you = "我";
        cs.assistant = sess.name;
        cs.empty = "还没有消息";
        chat.WithStrings(cs);
        chat.WithSpeakerNames(sess.group);
        chat.WithSpeakers(WxData.Speaker, WxData.KindLabel);
        chat.Reset();
        chat.Bind(sess.msgs);
        chat.Invalidate();
    }

    /// 在浮窗里发送。接了服务端的会话走 WxIm.Send——与主窗口同一条
    /// 链路：本地先进气泡、服务端落账、回执随轮询翻位；气泡上屏由
    /// WxIm.RefreshViews → RefreshAll 回到这扇窗完成。没接服务端的
    /// 示例行维持纯本地行为。
    void Send() {
        string t = box.GetText();
        if (t == "") { return; }
        if (sess.Linked()) {
            WxIm.Send(sess, t);
        } else {
            ChatMessage m = ChatMessage.Create("user", t);
            m.at = DateTime.UtcNow().ToUnixSeconds();
            sess.msgs.Add(m);
            sess.snippet = t;
            sess.time = "刚刚";
        }
        sess.unread = 0;
        box.SetText("");
        chat.Invalidate();
        this.RequestRedraw();
        if (notify != null) { notify(); }
    }
}

/// 聊天记录窗口：聊天页标题条上的聊天图标打开的那扇独立子窗口
/// （原版的「聊天记录」）。上半是搜索框与类型标签条（文件/图片与
/// 视频/链接/…，标签可点、只挪选中态——示例记录全是文本，没有
/// 按类型筛的内容），下半是带日期列的记录行列表。
class WxHistoryWindow : ChildWindow {
    /// 同时只留一扇：换会话就地把内容换掉，不叠第二扇。
    static WxHistoryWindow live;
    static WxSession cur;
    WxSession sess;
    App owner;
    int count;
    ListView<WxHistRow> lv;

    override string Title() {
        return "「" + sess.name + "」的聊天记录(" + Convert.ToString(count) + ")";
    }
    override int Width() { return 720; }
    override int Height() { return 560; }
    override bool ShowMaximize() { return false; }
    override int IdBase() { return 950000; }

    /// 打开（私聊/群聊同一扇）：会话相同只拉前台，不同就重建内容。
    static void Open(App app, WxSession s) {
        if (WxHistoryWindow.live != null && WxHistoryWindow.live.IsOpen()) {
            if (WxHistoryWindow.cur == s) {
                WxHistoryWindow.live.RequestRedraw();
                return;
            }
            WxHistoryWindow.live.Close();
        }
        WxHistoryWindow w = new WxHistoryWindow();
        w.sess = s;
        w.owner = app;
        w.Build();
        WxHistoryWindow.live = w;
        WxHistoryWindow.cur = s;
    }

    /// 共享会话记录 → 记录窗口的行。数据就是会话模型里那份：主窗口
    /// 与浮窗发的每一条、服务端轮询并进来的每一条都在——记录窗与
    /// 聊天区看到的历史从此一致，不再有虚构语料补长。`q` 非空时按
    /// 正文过滤。
    List<WxHistRow> RowsOf(string q) {
        List<WxHistRow> rows = new List<WxHistRow>();
        for (int i = 0; i < sess.msgs.Count; i = i + 1) {
            ChatMessage m = sess.msgs[i];
            if (q.Length > 0 && m.text.IndexOf(q) < 0) { continue; }
            string who = "我";
            string ini = "我";
            string tint = "primary";
            if (m.role != "user") {
                tint = sess.tint;
                who = sess.name;
                ini = sess.initial;
                if (m.agent != "") {
                    string n = WxData.NameOf(m.agent);
                    if (n != null) { who = n; }
                    string t = WxData.IniOf(m.agent);
                    if (t != "") { ini = t; }
                    tint = WxData.TintOfId(m.agent);
                }
            }
            // 日期与列表一致：今天 HH:MM、更早 MM-dd；发送中的气泡
            // （服务端 id 还没回来，at=0）留空。
            string date = m.at > 0 ? WxIm.ClockOf(Convert.ToString(m.at)) : "";
            rows.Add(WxHistRow.Of(who, ini, m.text, date, tint));
        }
        return rows;
    }

    void Build() {
        Panel root = Wx.Col("wxhist");

        Flex head = Wx.Row("wxhisthead");
        Input q = new Input("搜索");
        q.Class = "grow";
        // 每次编辑就地重筛：行是纯展示模型，重 Bind 即可。
        q.BindEvent("Change", () => { this.Rebind(q.GetText()); });
        head.Add(q);
        root.Add(head);

        ToolStrip ts = new ToolStrip();
        ts.Class = "wxhisttabs";
        string[] names = new string[]{ "文件", "图片与视频", "链接", "音乐",
            "小程序", "视频号", "日期" };
        for (int i = 0; i < names.Length; i = i + 1) {
            ts.Add(names[i], "");
        }
        if (sess.group) { ts.Add("群成员", ""); }
        for (int i = 0; i < ts.Count(); i = i + 1) {
            Wx.Item(ts, i).AddClass(i == 0 ? "wxhisttab wxon" : "wxhisttab");
        }
        ts.OnItemClick((i) => {
            for (int j = 0; j < ts.Count(); j = j + 1) {
                Wx.Item(ts, j).SetClassIn("wxon", j == i ? "wxon" : "");
            }
            this.RequestRedraw();
        });
        root.Add(ts);
        root.Add(Wx.Line());

        lv = new ListView<WxHistRow>(WxHistRowTpl.Of);
        lv.Class = "wxhistlist";
        lv.Grow();
        root.Add(lv);

        this.SetRoot(root, null);
        this.Wire();
        this.OpenHost(this.owner);
        // 子窗口是另一个 App：主窗口铺的 .wx* 应用样式表要再铺一遍。
        this.host.UseAppCss(WxSkin.Css());
        this.Rebind("");
        this.RequestRedraw();
    }

    /// 按关键字重筛并重绑（搜索框每次编辑与首次打开都走这）。计数
    /// 不含空态占位行。
    void Rebind(string q) {
        List<WxHistRow> rows = this.RowsOf(q);
        count = rows.Count;
        if (rows.Count == 0) {
            rows.Add(WxHistRow.Of("", "",
                q.Length > 0 ? "没有匹配的聊天记录" : "还没有聊天记录", "", ""));
        }
        lv.Bind(rows);
        this.RequestRedraw();
    }
}


/// 「通讯录管理」的界面本体：左导航（全部 + 筛选，朋友权限可再展开
/// 三档）+ 勾选式联系人表格 + 底部批量操作栏（修改权限/设置标签/删除
/// 只作用于勾选行，操作后计数与表格就地刷新）。做成独立控件树——
/// 与 WxSettingsView 同一个路数：窗口只当外壳，这棵树也能直接长在
/// 主窗口里（探针驱动就是这么验证交互的）。
class WxContactManagerView : Control {
    List<WxMgRow> rows;  // 全量数据（删行从这里扣）
    List<WxMgRow> shown;  // 按权限筛选后的可见行
    string filter;  // "" = 全部，否则是权限档名
    ListView<WxMgRow> table;
    Button allBtn;
    Button permHeadBtn;
    Button[] permBtns;
    string[] permNames;
    IconView permChev;
    Flex permBox;
    Button headAll;
    Label countLbl;
    Input search;

    WxContactManagerView() {
        this.InitControl("wxmg", 5);
        this.Class = "wxmg";
        rows = WxData.Manager();
        shown = new List<WxMgRow>();
        filter = "";
        this.Build();
    }

    void Build() {
        Panel body = Panel.Row();
        body.Class = "wxmgbody";
        body.Grow();

        // ---- 左栏：全部 + 筛选 ----
        // 侧栏用 Flex 流式：Panel 对默认 dock 的子项不保证按 add 序
        // 排列（permBox 实测被排到了侧栏末尾），flow 顺序才可靠。
        Flex side = Flex.Column();
        // Class 是整串覆盖，会把 Column() 挂的 column 类抹掉、方向
        // 退回 row——变体类一律 AddClass 追加（permBox/Op 同此）。
        side.AddClass("wxmgside");
        allBtn = new Button("");
        allBtn.Class = "wxmgall wxon";
        allBtn.OnClick(() => { this.SetFilter(""); });
        side.Add(allBtn);
        side.Add(Wx.Lbl("筛选", "wxmgsec"));
        permHeadBtn = new Button("朋友权限");
        permHeadBtn.Class = "wxmgitem";
        // flex 里 dock 不拉伸：不加 grow 按钮只有 pref 宽，行右侧
        // 一大块空白点了没反应。grow 让整行可点，箭头也被推到最右。
        permHeadBtn.AddClass("grow");
        permChev = new IconView("chevron-down", 14);
        permBox = Flex.Column();
        permBox.AddClass("wxpermbox");
        Action togglePerm = () => {
            permBox.visible = !permBox.visible;
            permChev.Name = permBox.visible ? "chevron-down" : "chevron-right";
        };
        permHeadBtn.OnClick(togglePerm);
        permChev.OnClick(togglePerm);
        Flex permHead = Wx.Row("wxpermhead");
        permHead.Add(permHeadBtn);
        permHead.Add(permChev);
        side.Add(permHead);
        permNames = new string[]{ "仅聊天", "不让他（她）看", "不看他（她）" };
        permBtns = new Button[]{ new Button(""), new Button(""),
            new Button("") };
        for (int i = 0; i < permBtns.Length; i = i + 1) {
            string name = permNames[i];
            permBtns[i].Class = "wxmgsub";
            permBtns[i].OnClick(() => { this.SetFilter(name); });
            permBox.Add(permBtns[i]);
        }
        side.Add(permBox);
        Button tags = new Button("标签");
        tags.Class = "wxmgitem";
        side.Add(tags);
        Button recent = new Button("最近群聊");
        recent.Class = "wxmgitem";
        side.Add(recent);
        body.Add(side);

        // ---- 右栏：搜索 + 表头 + 表格 ----
        Panel main = Wx.Col("wxmgmain");
        main.Grow();
        search = new Input("搜索");
        search.Class = "wxmgsearch";
        main.Add(search);
        WxMgHeadRow head = new WxMgHeadRow();
        headAll = head.Circle();
        headAll.OnClick(() => { this.ToggleAll(); });
        main.Add(head);
        table = new ListView<WxMgRow>(WxMgRowTpl.Of);
        table.Class = "wxmgtable";
        table.Grow();
        table.Bind(shown);
        table.OnSelect(() => {
            int i = table.SelectedIndex();
            if (i < 0 || i >= shown.Count) { return; }
            shown[i].picked = !shown[i].picked;
            table.Refresh();
            this.UpdateBar();
        });
        main.Add(table);
        body.Add(main);

        // ---- 底部：已选计数 + 批量操作 ----
        Flex bar = Wx.Row("wxmgbottom");
        countLbl = Wx.Lbl("已选择 0 人", "wxmgcount");
        bar.Add(countLbl);
        Button clear = new Button("取消选择");
        clear.Class = "text small";
        clear.OnClick(() => { this.ClearPicked(); });
        bar.Add(clear);
        Flex sp = Flex.Row();
        sp.Class = "grow";
        sp.Grow();
        bar.Add(sp);
        // Flex 行按 add 序从左到右排（dock 在 flex 里不参与定位），
        // 与原版一致：修改权限、设置标签、删除（删除最靠右）。
        bar.Add(this.Op("lock", "修改权限", () => { this.DoPerm(); }));
        bar.Add(this.Op("tag", "设置标签", () => { this.DoTag(); }));
        bar.Add(this.Op("trash", "删除", () => { this.DoDelete(); }));
        this.Add(body);
        this.Add(bar);

        this.ApplyFilter();
        this.UpdateCounts();
        this.UpdateBar();
    }

    /// 底部的一个操作：图标在文字上方的竖排按钮（整格可点）。
    Flex Op(string icon, string txt, Action run) {
        Flex op = Flex.Column();
        op.AddClass("wxmgop");
        op.Align("center");
        IconView ic = new IconView(icon, 18);
        Label tl = Wx.Lbl(txt, "wxmgoptext");
        op.OnClick(run);
        ic.OnClick(run);
        tl.OnClick(run);
        op.Add(ic);
        op.Add(tl);
        return op;
    }

    int PickedCount() {
        int n = 0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].picked) { n = n + 1; }
        }
        return n;
    }

    int PermCount(string perm) {
        int n = 0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].perm == perm) { n = n + 1; }
        }
        return n;
    }

    void UpdateBar() {
        countLbl.Text = "已选择 " + Convert.ToString(this.PickedCount()) + " 人";
    }

    /// 左栏计数与选中态：全部按钮 + 三档权限按钮的文字里带条数。
    void UpdateCounts() {
        allBtn.Text = "全部 (" + Convert.ToString(rows.Count) + ")";
        for (int i = 0; i < permBtns.Length; i = i + 1) {
            permBtns[i].Text = permNames[i] + " ("
                + Convert.ToString(this.PermCount(permNames[i])) + ")";
        }
        this.RestyleSide();
    }

    /// 侧栏选中态只亮一个：全部或某档权限。
    void RestyleSide() {
        bool allOn = filter == "";
        allBtn.SetClassIn("wxon", allOn ? "wxon" : "");
        for (int i = 0; i < permBtns.Length; i = i + 1) {
            bool on = filter == permNames[i];
            permBtns[i].SetClassIn("wxon", on ? "wxon" : "");
        }
    }

    void SetFilter(string f) {
        filter = f;
        this.RestyleSide();
        this.ApplyFilter();
    }

    void ApplyFilter() {
        shown.Clear();
        for (int i = 0; i < rows.Count; i = i + 1) {
            WxMgRow r = rows[i];
            if (filter == "" || r.perm == filter) { shown.Add(r); }
        }
        table.Bind(shown);
        table.Refresh();
    }

    void ToggleAll() {
        bool any = false;
        for (int i = 0; i < shown.Count; i = i + 1) {
            if (!shown[i].picked) { any = true; break; }
        }
        for (int i = 0; i < shown.Count; i = i + 1) {
            shown[i].picked = any;
        }
        if (headAll != null) {
            headAll.Icon = any ? "check" : "";
            headAll.SetClassIn("on", any ? "on" : "");
        }
        table.Refresh();
        this.UpdateBar();
    }

    void ClearPicked() {
        for (int i = 0; i < rows.Count; i = i + 1) { rows[i].picked = false; }
        if (headAll != null) {
            headAll.Icon = "";
            headAll.SetClassIn("on", "");
        }
        table.Refresh();
        this.UpdateBar();
    }

    /// 批量把勾选行改成仅聊天（演示「修改权限」；权限变了，筛选项
    /// 的计数与可见行都要跟着刷新）。
    void DoPerm() {
        bool hit = false;
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].picked) { rows[i].perm = "仅聊天"; hit = true; }
        }
        if (!hit) { return; }
        this.ApplyFilter();
        this.UpdateCounts();
        this.UpdateBar();
    }

    void DoTag() {
        bool hit = false;
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].picked) { rows[i].tag = "常用"; hit = true; }
        }
        if (hit) { table.Refresh(); }
    }

    void DoDelete() {
        List<WxMgRow> keep = new List<WxMgRow>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (!rows[i].picked) { keep.Add(rows[i]); }
        }
        rows = keep;
        this.ApplyFilter();
        this.UpdateCounts();
        this.UpdateBar();
    }
}

/// 通讯录管理窗口：通讯录页左上「通讯录管理」打开的独立子窗口（原版
/// 的同名窗口），界面本体是 WxContactManagerView 这棵控件树，窗口
/// 只负责外壳：标题、尺寸、铺样式表。
class WxContactManagerWindow : ChildWindow {
    /// 同时只留一扇。
    static WxContactManagerWindow live;
    App owner;

    override string Title() { return "通讯录管理"; }
    /// 原版这扇窗是一张宽表：左导航 250 + 表格。
    override int Width() { return 1000; }
    override int Height() { return 680; }
    override bool ShowMaximize() { return false; }
    override int IdBase() { return 960000; }

    static void Open(App app) {
        if (WxContactManagerWindow.live != null
                && WxContactManagerWindow.live.IsOpen()) {
            WxContactManagerWindow.live.RequestRedraw();
            return;
        }
        WxContactManagerWindow w = new WxContactManagerWindow();
        w.owner = app;
        // 纯代码建树：没有 .zform 的 bind 通道，model 传 null。
        w.SetRoot(new WxContactManagerView(), null);
        w.Wire();
        w.OpenHost(app);
        // 子窗口是另一个 App：主窗口铺的 .wx* 应用样式表要再铺一遍。
        w.host.UseAppCss(WxSkin.Css());
        w.RequestRedraw();
        WxContactManagerWindow.live = w;
    }
}

/// 设置分区强类型实体（包含标题、内容面板与对应导航按钮）
class WxSettingSection {
    public string title;
    public Panel panel;
    public Button navBtn;

    public WxSettingSection(string title, Panel panel) {
        this.title = title;
        this.panel = panel;
        this.navBtn = null;
    }
}

/// 设置层窗口里的内容：左列导航，右侧六个分区（只让当前分区可见，
/// 六个分区共用同一条保留的控件树，切换不重建控件）。
class WxSettingsView : Control {
    Panel body;
    List<WxSettingSection> sections;
    int cur;

    WxSettingsView(App app) {
        this.InitControl("wxSettingsView", 5);
        this.Class = "wxset";
        Panel nav = Wx.Col("wxsetnav");
        body = Wx.Col("wxsetbody");
        body.Grow();
        this.Add(nav);
        this.Add(body);

        sections = new List<WxSettingSection>();
        sections.Add(new WxSettingSection("账号与存储", this.SecAccount(app)));
        sections.Add(new WxSettingSection("通用", this.SecGeneral(app)));
        sections.Add(new WxSettingSection("快捷键", this.SecKeys(app)));
        sections.Add(new WxSettingSection("通知", this.SecNotify(app)));
        sections.Add(new WxSettingSection("插件", this.SecPlugins(app)));
        sections.Add(new WxSettingSection("关于微信", this.SecAbout(app)));

        for (int i = 0; i < sections.Count; i = i + 1) {
            WxSettingSection sec = sections[i];
            body.Add(sec.panel);

            Button b = new Button(sec.title);
            b.Class = "wxsetnavbtn";
            nav.Add(b);
            sec.navBtn = b;

            int idx = i;
            b.OnClick(() => { this.Pick(idx); });
        }
        this.Pick(0);
    }

    void Pick(int i) {
        if (i < 0 || i >= sections.Count) { return; }
        cur = i;
        for (int k = 0; k < sections.Count; k = k + 1) {
            WxSettingSection sec = sections[k];
            sec.panel.visible = k == i;
            if (sec.navBtn != null) {
                sec.navBtn.Class = Wx.NavCls(k == i);
            }
        }
    }

    Panel SecAccount(App app) {
        Panel s = Wx.Col("");
        s.Grow();
        s.Add(Wx.Sec("账号"));
        Flex r0 = Wx.Row("wxsetrow");
        r0.Add(Wx.Lbl("退出登录", "wxsetkey grow"));
        Button quit = new Button("退出登录");
        quit.Class = "danger";
        r0.Add(quit);
        s.Add(r0);
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("登录方式", "自动"));
        s.Add(Wx.Line());
        Flex r2 = Wx.Row("wxsetrow");
        r2.Add(Wx.Lbl("保留聊天记录", "wxsetkey grow"));
        Switch keep = new Switch();
        keep.SetOn(false);
        r2.Add(keep);
        s.Add(r2);
        s.Add(Wx.Line());
        Flex r3 = Wx.Row("wxsetrow");
        r3.Add(Wx.Lbl("存储空间", "wxsetkey grow"));
        r3.Add(Wx.Lbl("已使用 148.6M", "wxsetval"));
        r3.Add(new Button("管理"));
        s.Add(r3);
        s.Add(Wx.Line());
        Flex r4 = Wx.Row("wxsetrow");
        r4.Add(Wx.Lbl("存储位置", "wxsetkey grow"));
        r4.Add(Wx.Lbl("D:\\微聊\\数据", "wxsetval"));
        r4.Add(new Button("更改"));
        s.Add(r4);
        s.Add(Wx.Line());
        Flex r5 = Wx.Row("wxsetrow");
        r5.Add(Wx.Lbl("自动下载小于", "wxsetkey grow"));
        SelectBox limit = new SelectBox("20 MB");
        limit.AddOption("5 MB");
        limit.AddOption("10 MB");
        limit.AddOption("20 MB");
        limit.AddOption("50 MB");
        r5.Add(limit);
        r5.Add(Wx.Lbl("的文件", "wxsetkey"));
        Switch dl = new Switch();
        dl.SetOn(true);
        r5.Add(dl);
        s.Add(r5);
        s.Add(Wx.Line());
        return s;
    }

    Panel SecGeneral(App app) {
        Panel s = Wx.Col("");
        s.Grow();
        s.Add(Wx.Sec("外观"));
        s.Add(WxRow.Kv("语言", "简体中文"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("字体大小", "标准"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("皮肤", "跟随系统"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("界面缩放", "100%"));
        s.Add(Wx.Line());
        return s;
    }

    Panel SecKeys(App app) {
        Panel s = Wx.Col("");
        s.Grow();
        s.Add(Wx.Sec("发送与截图"));
        s.Add(WxRow.Kv("发送消息", "Enter"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("换行", "Ctrl + Enter"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("截图", "Alt + A"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("锁定", "Ctrl + L"));
        s.Add(Wx.Line());
        return s;
    }

    Panel SecNotify(App app) {
        Panel s = Wx.Col("");
        s.Grow();
        s.Add(Wx.Sec("消息提醒"));
        Flex r0 = Wx.Row("wxsetrow");
        r0.Add(Wx.Lbl("新消息提醒", "wxsetkey grow"));
        Switch n1 = new Switch();
        n1.SetOn(true);
        r0.Add(n1);
        s.Add(r0);
        s.Add(Wx.Line());
        Flex r1 = Wx.Row("wxsetrow");
        r1.Add(Wx.Lbl("声音", "wxsetkey grow"));
        Switch n2 = new Switch();
        n2.SetOn(true);
        r1.Add(n2);
        s.Add(r1);
        s.Add(Wx.Line());
        Flex r2 = Wx.Row("wxsetrow");
        r2.Add(Wx.Lbl("免打扰时段", "wxsetkey grow"));
        r2.Add(Wx.Lbl("23:00 - 07:00", "wxsetval"));
        s.Add(r2);
        s.Add(Wx.Line());
        return s;
    }

    Panel SecPlugins(App app) {
        Panel s = Wx.Col("");
        s.Grow();
        s.Add(Wx.Sec("已安装的插件"));
        s.Add(WxRow.Kv("剪贴板增强", "已启用"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("代码片段", "已启用"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("插件市场", "浏览"));
        s.Add(Wx.Line());
        return s;
    }

    Panel SecAbout(App app) {
        Panel s = Wx.Col("");
        s.Grow();
        s.Add(Wx.Sec("版本信息"));
        s.Add(WxRow.Kv("版本", "1.0.0 (build 20260911)"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("内核", "Zan / Gui 标准库"));
        s.Add(Wx.Line());
        Flex r2 = Wx.Row("wxsetrow");
        r2.Add(Wx.Lbl("检查更新", "wxsetkey grow"));
        r2.Add(new Button("检查"));
        s.Add(r2);
        s.Add(Wx.Line());
        s.Add(Wx.Lbl("示例数据全部虚构，与任何真实账号无关。", "wxhint"));
        return s;
    }

    override string Kind() { return "WxSettingsView"; }
}
