using System;
using Gui;
using Gui.Widget;
using Gui.Component;

/* 登录小窗口：注册 / 登录 / 修改密码 / 找回密码，四页在同一扇小窗里翻。
 *
 * HTML+CSS 改造：窗口内容整个是一份 WeChatLogin.html 运行期文档
 * （GenHtml 编译期生成 WeChatLoginHtml 建树类）——四页的排布、文案与
 * 外观（<style> 里的 wxlogin* 规则，已从 WeChatSkin 迁进文档）都在
 * HTML 里；这份 code-behind 只留行为：翻页、状态行、登录请求。
 *
 * 时序（对齐原版微信）：登录窗是一扇独立 OS 小窗，在主窗口 OnLoad 里
 * 用 OpenStandalone + PumpStandaloneUntil 泵它自己的事件循环——此时主
 * 窗口还没 Show，登录成功泵返回后主窗口才打开；没登录就把登录窗关掉
 * 的话，它会在外层循环里重新打开（进程内没有干净的"放弃启动"出口，
 * 见 App.zan 的调用注释）。
 *
 * 账号体系（本单）：接 server-collab 服务端，全系统只有一套账号——
 * 登录走 POST /api/auth/login 拿 token（此后 /api/im 接口都带 Bearer）；
 * 注册/改密/找回带邮箱与邮件验证码，是 Web 端表单流，客户端这三页
 * 给出服务地址指引（单账户体系，注册口在 Web 端）。泵循环里顺带
 * WxNet.Poll() 并入网络应答（Pump 即该窗口的 UI 线程心跳）。
 */

// 登录小窗：四页翻面。Run(app) 阻塞到登录成功（返回 true）或
// 登录窗被关掉（返回 false，宿主负责重新拉起）。
class WxLoginWindow : ChildWindow {
    // 页序：与 ShowPage 的参数一致。
    static int PAGE_LOGIN = 0;
    static int PAGE_REG = 1;
    static int PAGE_CHPWD = 2;
    static int PAGE_FORGOT = 3;

    List<Control> pages;
    bool loggedIn;
    Input acc;
    Input pwd;
    Control status;
    bool busy;

    override string Title() { return "微聊"; }
    // 原版微信登录窗是一扇竖版小窗。
    override int Width() { return 300; }
    override int Height() { return 430; }
    override bool ShowMaximize() { return false; }
    override int IdBase() { return 950000; }

    // 阻塞跑一遍登录窗。返回 true = 已登录成功（进主窗口）；
    // false = 窗口被关掉（宿主重新拉起）。
    static bool Run() {
        WxLoginWindow w = new WxLoginWindow();
        w.BuildUi();
        w.OpenStandalone();
        w.host.UseAppCss(WeChatLoginHtml.Css);
        w.RequestRedraw();
        // 实机验证缝：ZAN_WX_AUTOLOGIN="user:pass" 预填账号
        // 并直接走登录流（冒烟/GUI e2e 用，不设即人工输入）。
        string auto = Interop.EnvVar("ZAN_WX_AUTOLOGIN");
        if (auto != null) {
            int colon = auto.IndexOf(":");
            if (colon > 0) {
                w.acc.SetText(auto.Substring(0, colon));
                w.pwd.SetText(auto.Substring(colon + 1));
                w.DoLogin();
            }
        }
        // 独立泵：登录成功（loggedIn 置位）即返回；窗口被关也返回。
        // 每拍顺带并入网络应答（回调在本窗口 UI 线程跑）。
        w.PumpStandaloneUntil(() => {
            WxNet.Poll();
            return w.loggedIn;
        });
        return w.loggedIn;
    }

    void BuildUi() {
        HtmlHandlers hs = new HtmlHandlers();
        hs.Add("login", () => { this.DoLogin(); });
        hs.Add("show-reg", () => { this.ShowPage(PAGE_REG); });
        hs.Add("show-chpwd", () => { this.ShowPage(PAGE_CHPWD); });
        hs.Add("show-forgot", () => { this.ShowPage(PAGE_FORGOT); });
        hs.Add("back", () => { this.ShowPage(PAGE_LOGIN); });
        Control root = WeChatLoginHtml.Build(hs);

        // 文档里的真控件按 id 找回（id → name）：账号/密码输入框与
        // 状态行。密码掩码是行为配置，runtime 通道没有 data-x-props，
        // 在 code-behind 补 SetProp（探针验证过的路）。
        acc = (Input)root.Find("LoginAcc");
        pwd = (Input)root.Find("LoginPwd");
        pwd.SetProp("password", "true");
        pwd.BindEvent("Submit", () => { this.DoLogin(); });
        status = root.Find("LoginStatus");

        pages = new List<Control>();
        pages.Add(root.Find("PageLogin"));
        pages.Add(root.Find("PageReg"));
        pages.Add(root.Find("PageChpwd"));
        pages.Add(root.Find("PageForgot"));
        this.ShowPage(PAGE_LOGIN);

        this.SetRoot(root, null);
    }

    // 翻页：切可见 + 状态行清空。
    void ShowPage(int n) {
        for (int i = 0; i < pages.Count; i = i + 1) {
            pages[i].visible = i == n;
        }
        this.Note("", false);
    }

    // 状态行：错误红字 / 成功绿字。
    void Note(string msg, bool ok) {
        status.SetProp("text", msg);
        status.SetClassIn("wxloginok", ok ? "wxloginok" : "");
        this.RequestRedraw();
    }

    void DoLogin() {
        if (this.busy) { return; }
        string user = acc.GetText();
        string pass = pwd.GetText();
        if (user.Length == 0 || pass.Length == 0) {
            this.Note("先填账号和密码", false);
            return;
        }
        this.busy = true;
        this.Note("正在连接服务器…", true);
        WxNetReq req = WxNet.NewReq();
        WxNet.Login(req, user, pass, () => {
            this.busy = false;
            if (!WxNet.OkOf(req)) {
                this.Note(WxNet.ErrOf(req), false);
                return;
            }
            JsonValue d = WxNet.DataOf(req);
            WxNet.SetSession(d.Str("token", ""), user);
            this.Note("登录成功，正在打开微聊…", true);
            loggedIn = true;
        });
    }
}
