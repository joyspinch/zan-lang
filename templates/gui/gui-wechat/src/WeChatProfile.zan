using System;
using Gui;
using Gui.Widget;
using Gui.Component;

/* 点用户头像弹出的小名片（原版「用户面板」）。
 *
 * 版式对齐原版：大头像 + 名字旁的性别标 + 微信号/地区，下面依次是
 * 朋友资料（备注）、朋友圈（缩略图行）、视频号（昵称 + 缩略图行）、
 * 更多信息（个性签名/来源/添加时间），底部一排「发消息 / 语音聊天 /
 * 视频聊天」图标叠文字的操作。整卡贴在页面右缘，圆角 + 投影让它
 * 读起来像浮在内容上的名片；显隐是 dock 子项翻 visible，不做浮层
 * （与聊天页「...」抽屉同一套弹出定式，两者互斥）。
 */

/// 资料卡的宿主回调：告诉页面「用户点了发消息」之类的动作，
/// 页面借此收起抽屉/关掉名片（切会话之类的重活由页面自己做）。
delegate void ProfileAction();

class WxProfilePanel : Control {
    Avatar big;
    /// 名片被收起时通知宿主（朋友圈页同步名片槽显隐）。
    ProfileAction onHide;
    Label nameLbl;
    Label genderLbl;
    Label wxLbl;
    Label regionLbl;
    Label remarkVal;
    Label signVal;
    Label sourceVal;
    Label addedVal;
    Label videoName;

    static WxProfilePanel Of() { return new WxProfilePanel(); }

    WxProfilePanel() {
        this.InitControl("wxprofile", 4);
        this.Class = "wxprofile";
        this.visible = false;

        // ---- 头部：大头像 + 名字(性别) + 微信号 + 地区 ----
        Flex head = Wx.Row("wxphead");
        head.dock = 1;
        big = Wx.Ava("", 64, "primary");
        big.dock = 3;
        head.Add(big);
        Panel ht = Panel.Column();
        ht.Class = "grow";
        Flex nr = Wx.Row("");
        nameLbl = Wx.Lbl("", "wxpname");
        nr.Add(nameLbl);
        genderLbl = Wx.Lbl("♂", "wxpgender");
        nr.Add(genderLbl);
        ht.Add(nr);
        wxLbl = Wx.Lbl("", "wxpsub");
        ht.Add(wxLbl);
        regionLbl = Wx.Lbl("", "wxpsub");
        ht.Add(regionLbl);
        head.Add(ht);
        Button dots = Wx.IconBtn("dots");
        dots.dock = 4;
        dots.OnClick(() => { this.Hide(); });
        head.Add(dots);
        this.Add(head);
        this.Add(Wx.Line());

        // ---- 正文：朋友资料 / 朋友圈 / 视频号 / 更多信息 ----
        Panel body = Wx.Col("wxpbody");
        body.dock = 5;
        remarkVal = Wx.Lbl("", "wxpval");
        body.Add(Wx.Lbl("朋友资料", "wxpsec"));
        body.Add(this.KeyVal("备注", remarkVal));
        body.Add(Wx.Line());

        body.Add(Wx.Lbl("朋友圈", "wxpsec"));
        body.Add(this.Thumbs(false));
        body.Add(Wx.Line());

        body.Add(Wx.Lbl("视频号", "wxpsec"));
        videoName = Wx.Lbl("", "wxpvideo");
        body.Add(videoName);
        body.Add(this.Thumbs(true));
        body.Add(Wx.Line());

        signVal = Wx.Lbl("", "wxpval");
        sourceVal = Wx.Lbl("", "wxpval");
        addedVal = Wx.Lbl("", "wxpval");
        body.Add(Wx.Lbl("更多信息", "wxpsec"));
        body.Add(this.KeyVal("个性签名", signVal));
        body.Add(this.KeyVal("来源", sourceVal));
        body.Add(this.KeyVal("添加时间", addedVal));
        this.Add(body);

        // ---- 底部操作：图标叠文字，三项均分（删除/设置标签同款） ----
        Flex bar = Wx.Row("wxpbar");
        bar.dock = 2;
        bar.Add(this.Op("message", "发消息"));
        bar.Add(this.Op("phone", "语音聊天"));
        bar.Add(this.Op("video", "视频聊天"));
        this.Add(bar);
    }

    /// 「键 + 值」的一行：键是次级灰字，值由 Show 时填（值 Label
    /// 由调用方先建好传入——`out` 实参写实例字段编译过但运行崩，
    /// 见 TASKS.md A307）。
    Flex KeyVal(string key, Label val) {
        Flex r = Wx.Row("wxprow");
        r.Add(Wx.Lbl(key, "wxpkey grow"));
        r.Add(val);
        return r;
    }

    /// 一行虚构的缩略图（朋友圈照片 / 视频号封面）。视频版中间
    /// 叠一个播放键；图块颜色走皮肤 token，不挑主题。
    Flex Thumbs(bool video) {
        // 裸 Flex（不带 Wx.Row 的居中）：行高定 72，图块靠默认
        // stretch 拉满——居中的行会让空图块缩回 0 高（照片块没有
        // 内容字），只剩视频块因为叠了播放键看得见。
        Flex r = Flex.Row();
        r.AddClass("wxpthumbs");
        r.dock = 1;
        string[] cls = new string[]{ "wxph-a", "wxph-b", "wxph-c", "wxph-d" };
        for (int i = 0; i < 4; i = i + 1) {
            Flex t = Flex.Column();
            t.AddClass(cls[i]);
            t.Justify("center");
            t.Align("center");
            if (video) {
                t.Add(Wx.Lbl("▶", "wxpplay"));
            }
            r.Add(t);
        }
        return r;
    }

    /// 底部的一个操作：图标在文字上方的竖排按钮（整格可点）。
    Flex Op(string icon, string txt) {
        Flex op = Flex.Column();
        op.AddClass("wxpop");
        op.Align("center");
        op.Justify("center");
        IconView ic = new IconView(icon, 20);
        Label tl = Wx.Lbl(txt, "wxpoptext");
        Action run = () => { this.Hide(); };
        op.OnClick(run);
        ic.OnClick(run);
        tl.OnClick(run);
        op.Add(ic);
        op.Add(tl);
        return op;
    }

    override string Kind() { return "WxProfilePanel"; }
    override string StyleType() { return "wxprofile"; }

    override void OnMeasure(App app) {
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefW = s.WidthOr(app.Scale(400));
        prefH = 0;
    }

    /// 弹出某人的名片；再点别的头像就原地换内容，不叠第二张。
    /// 先把卡片快照进局部量再填：控件属性是 Binding<string>，
    /// 直接赋 `c.xxx`（字段左值）会合成「实时绑定」，而卡片是
    /// 临时件，Show 一返回就被释放，下一帧经绑定回读即悬空
    /// （症状：渲染帧量文本时段错误）。局部量右值走常量绑定，
    /// 字符串就地留存。
    void Show(WxProfileCard c) {
        string ini = c.ini;
        string tint = c.tint;
        string name = c.name;
        int gender = c.gender;
        string wxid = c.wxid;
        string region = c.region;
        string remark = c.remark;
        string signature = c.signature;
        string source = c.source;
        string added = c.added;
        string video = c.videoName;
        bool mine = c.mine;
        big.Text = ini;
        big.Class = tint;
        nameLbl.Text = name;
        genderLbl.Text = gender == 2 ? "♀" : "♂";
        genderLbl.SetClassIn("wxpgender-f",
            gender == 2 ? "wxpgender-f" : "");
        genderLbl.visible = gender != 0;
        wxLbl.Text = "微信号：" + wxid;
        regionLbl.Text = "地区：" + (region == "" ? "未设置" : region);
        remarkVal.Text = mine ? signature : (remark == "" ? "添加备注" : remark);
        remarkVal.SetClassIn("wxpghost",
            !mine && remark == "" ? "wxpghost" : "");
        signVal.Text = signature == "" ? "未设置" : signature;
        sourceVal.Text = source == "" ? "未设置" : source;
        addedVal.Text = added == "" ? "未设置" : added;
        videoName.Text = video == "" ? "未开通" : video;
        this.visible = true;
    }

    void Hide() {
        this.visible = false;
        // 收起回调（宿主页面借此同步外部状态——朋友圈页的名片槽
        // 要跟着翻 visible，flex 布局才收缩回去）。
        if (onHide != null) { onHide(); }
    }

    bool Shown() { return this.visible; }
}
