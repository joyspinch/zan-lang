using System;
using System.Collections;
using System.Json;
using System.Threading;

/* gui-wechat ↔ server-collab 的业务桥：把服务端 JSON 翻成
   WxSession/ChatMessage 模型。请求都走 WxNet 的队列（UI 线程提交、
   回调在 UI 线程并入），这里只做三件事：
     1. RefreshChats —— 会话列表全量重建（App.OnLoad 首拉 + 轮询）；
     2. Open         —— 打开会话：拉全量消息（collab 群聊顺带落已读水位）；
     3. Send         —— 发送：本地先插气泡，应答带回 id/at 定稿；失败
        把该气泡改成红色 error 角色（原版微信的红色感叹号语义）。
   双域并行（A327 总原则「旧域只读不动、新域旁路增量」）：
     - 1:1 私聊走旧域 /api/im 全家（oa_message，回执已送达/已读齐全），
       槽身份键 "p"+peer；
     - 群聊走 collab 域 /api/collab 全家（collab_message），槽身份键
       "c"+conv——「去 peer=唯一键」后槽身份由 Key() 裁决，两域互不
       串槽；collab 域没有送达/已读回执小字，群聊气泡不打勾。
   实时：90ms 拍并入 WxEvents 帧（OnLiveEvent），轮询（Beat）兜底。
   回执：ChatMessage.mark 存 0 发出 / 1 送达 / 2 已读，渲染走 kind
   （"wx-acked"/"wx-readed" → WxData.KindLabel 的头行小字）。 */
static class WxIm {
    /// 会话模型（页与桥共享同一份 List 引用，重建 = 清掉重填）。
    static List<WxSession> sessions;
    static WxPageChat page;
    /// 轮询节拍计数：chats 每 3 拍拉一次，打开的会话每拍拉流。
    static int tick;
    /// 当前打开的会话：1:1 对端 id 或 collab 会话 id（"" = 没开）。
    static string openPeer = "";
    static string openConv = "";
    /// 两源快照：最近一次应答的数组节点，Merge() 消费。
    static JsonValue imChats;
    static JsonValue groupRows;
    /// collab 群聊未读合计（徽标 = 旧域 unread + 群聊合计）。
    static int groupUnread;

    /// 接桥：页把模型与自身交给桥（App.OnLoad 里调一次）。
    static void Use(List<WxSession> model, WxPageChat host) {
        WxIm.sessions = model;
        WxIm.page = host;
        // 登录后主窗口只认服务端数据：示例会话清空，列表/聊天区重绑。
        host.BeginServerMode();
    }

    /* ---- 会话列表（双源合并） ---- */

    /// 拉会话列表并整表重建：1:1（/api/im/chats）与群聊
    /// （/api/collab/conversations）各发一单，先到的先落快照、
    /// 后到的再并一次——Merge 按槽身份认领，两单谁先谁后结果一致。
    /// done 在 UI 线程回调（可空）。
    static void RefreshChats(Action done) {
        if (!WxNet.LoggedIn()) { return; }
        WxNetReq req = WxNet.NewReq();
        WxNet.Get(req, "chats", () => {
            if (WxNet.OkOf(req)) {
                JsonValue d = WxNet.DataOf(req);
                WxIm.imChats = d == null ? null : d.Get("chats");
                WxIm.Merge();
            }
            if (done != null) { done(); }
        });
        WxNetReq gr = WxNet.NewReq();
        WxNet.ApiGet(gr, "/api/collab/conversations", () => {
            if (!WxNet.OkOf(gr)) { return; }
            JsonValue d = WxNet.DataOf(gr);
            WxIm.groupRows = d == null ? null : d.Get("conversations");
            WxIm.Merge();
        });
    }

    /// 两源快照 → 共享模型整表重建。槽身份跟 Key() 走，不跟下标走：
    /// 服务端按最新消息排序，两次轮询之间顺序经常变——按下标复用会
    /// 把槽悄悄换给别的会话（旧消息记录被当"别人家的"清掉、拖出的
    /// 浮窗拿着旧对象直接串台）。先按键建索引，认领得到的原对象连同
    /// 消息记录继续用，认领不到的开新槽；列表实例不换（页与列表绑定
    /// 的是同一份引用），清掉按 1:1 → 群聊的顺序重填。
    static void Merge() {
        if (WxIm.sessions == null) { return; }
        Dict<string, WxSession> idle = new Dict<string, WxSession>();
        for (int i = 0; i < WxIm.sessions.Count; i = i + 1) {
            idle.Add(WxIm.sessions[i].Key(), WxIm.sessions[i]);
        }
        List<WxSession> next = new List<WxSession>();
        int n1 = WxIm.imChats == null ? 0 : WxIm.imChats.Count();
        for (int i = 0; i < n1; i = i + 1) {
            JsonValue o = WxIm.imChats.At(i);
            string newPeer = o.Str("peerId", "");
            WxSession s = WxIm.Claim(idle, "p" + newPeer);
            next.Add(s);
            s.peer = newPeer;
            s.conv = "";
            s.name = o.Str("peerName", "?");
            s.initial = WxIm.IniOf(s.name);
            s.tint = WxData.TintOf(i);
            s.group = false;
            s.people = 0;
            s.snippet = o.Str("lastText", "");
            s.time = WxIm.ClockOf(o.Str("lastAt", "0"));
            s.unread = Convert.ToInt32(o.Str("unread", "0"));
            s.sentUnread = Convert.ToInt32(o.Str("sentUnread", "0"));
            s.lastMark = o.Str("readed", "0") == "1" ? 2
                : (o.Str("acked", "0") == "1" ? 1 : 0);
            // 对方发来还没回执的：立刻打送达位（服务端按 toId 幂等）。
            // 有了这一条，"已送达"在对方没点开这条会话时就亮了。
            string ackId = o.Str("ackId", "0");
            if (ackId != "0" && ackId != "") { WxIm.QueueAck(newPeer); }
        }
        int n2 = WxIm.groupRows == null ? 0 : WxIm.groupRows.Count();
        int sumUnread = 0;
        for (int i = 0; i < n2; i = i + 1) {
            JsonValue o = WxIm.groupRows.At(i);
            string cid = o.Str("id", "");
            WxSession s = WxIm.Claim(idle, "c" + cid);
            next.Add(s);
            s.peer = "";
            s.conv = cid;
            s.name = o.Str("title", "?");
            s.initial = WxIm.IniOf(s.name);
            s.tint = WxData.TintOf(i);
            s.group = true;
            s.people = Convert.ToInt32(o.Str("members", "0"));
            s.snippet = o.Str("lastText", "");
            s.time = WxIm.ClockOf(o.Str("lastAt", "0"));
            s.unread = Convert.ToInt32(o.Str("unread", "0"));
            s.sentUnread = 0;          // collab 域一期没有送达回执小字
            s.lastMark = 0;
            sumUnread = sumUnread + s.unread;
        }
        WxIm.sessions.Clear();
        for (int i = 0; i < next.Count; i = i + 1) {
            WxIm.sessions.Add(next[i]);
        }
        if (sumUnread != WxIm.groupUnread) {
            WxIm.groupUnread = sumUnread;
            WxIm.RefreshBadge();
        }
        // 列表重建后当前选中行已经是新的槽对象。只有"还没选过"时才主动
        // 选一次（登录后首屏：不点行也能看到当前会话的记录）——每次轮询
        // 都 Select 会把 chat.Reset() 一并跑掉，用户的滚动位置每 4.5 秒被
        // 拽回最新一条（实测：往上翻立刻弹回底部）。刷新已在看的会话由
        // RefreshOpen 负责，标题区由 OnDataChanged 负责。
        if (WxIm.page != null && WxIm.sessions.Count > 0
            && WxIm.page.CurrentIndex() < 0) {
            WxIm.page.Select(0);
        }
        WxIm.RefreshViews();
    }

    /// 从 idle 索引认领槽对象（有则摘出复用，无则开新槽）。
    static WxSession Claim(Dict<string, WxSession> idle, string key) {
        WxSession s;
        if (!idle.TryGetValue(key, out s)) { s = null; }
        if (s != null) { idle.Remove(key); }
        if (s == null) { s = WxSession.Blank(); }
        return s;
    }

    /* ---- 打开会话：拉消息流 ---- */

    /// 打开（或刷新）某会话：记下身份键，拉全量流。1:1 打开即已读由
    /// 旧域 Stream 落账；collab 群聊打开即调 read 推进水位。
    static void Open(WxSession s) {
        if (s == null) { return; }
        if (s.conv.Length > 0) {
            openConv = s.conv;
            openPeer = "";
            WxIm.PullConvStream(s.conv, null);
            WxIm.PostRead(s.conv);
            return;
        }
        if (s.peer.Length == 0) { return; }
        openPeer = s.peer;
        openConv = "";
        WxIm.PullStream(s.peer, null);
    }

    /// 当前打开的会话拉一遍流（轮询与新消息并入用）。
    static void RefreshOpen() {
        if (openConv.Length > 0) { WxIm.PullConvStream(openConv, null); }
        if (openPeer.Length > 0) { WxIm.PullStream(openPeer, null); }
    }

    static void PullStream(string peer, Action done) {
        if (!WxNet.LoggedIn()) { return; }
        WxNetReq req = WxNet.NewReq();
        WxNet.Post(req, "stream", "peer=" + Encoding.UrlEncode(peer), () => {
            if (done != null) { done(); }
            if (!WxNet.OkOf(req)) { return; }
            JsonValue d = WxNet.DataOf(req);
            if (d == null) { return; }
            WxIm.ApplyStream(d.Str("peer", ""), d.Get("msgs"));
        });
    }

    /// collab 群聊消息流（before/limit 游标分页，一期整页 200 拉满）。
    static void PullConvStream(string conv, Action done) {
        if (!WxNet.LoggedIn()) { return; }
        WxNetReq req = WxNet.NewReq();
        WxNet.ApiGet(req, "/api/collab/messages?conversationId="
            + Encoding.UrlEncode(conv) + "&limit=200", () => {
            if (done != null) { done(); }
            if (!WxNet.OkOf(req)) { return; }
            JsonValue d = WxNet.DataOf(req);
            if (d == null) { return; }
            WxIm.ApplyConvStream(d.Str("conversationId", ""), d.Get("msgs"));
        });
    }

    /// 把流并进会话模型：按服务端消息 id 对账——已有的更新回执位，
    /// 没有的按序追加。发送中的气泡（id ""）保持在尾部，等 Send 的
    /// 应答来定稿；这里只追加 id 非空的消息。
    static void ApplyStream(string peer, JsonValue msgs) {
        if (WxIm.sessions == null || msgs == null) { return; }
        WxSession s = WxIm.ByPeer(peer);
        if (s == null) { return; }
        for (int i = 0; i < msgs.Count(); i = i + 1) {
            JsonValue o = msgs.At(i);
            string id = o.Str("id", "");
            bool mine = o.Str("mine", "0") == "1";
            bool readed = o.Str("readed", "0") == "1";
            bool acked = o.Str("acked", "0") == "1";
            int mark = readed ? 2 : (acked ? 1 : 0);
            ChatMessage m = WxIm.ById(s, id);
            if (m != null) {
                if (mine) {
                    m.mark = mark;
                    m.kind = mark == 2 ? "wx-readed"
                        : (mark == 1 ? "wx-acked" : "");
                }
                continue;
            }
            ChatMessage nm = ChatMessage.Create(
                mine ? "user" : "assistant", o.Str("content", ""));
            nm.agent = mine ? "" : "peer:" + peer;
            nm.at = Convert.ToInt64(o.Str("at", "0"));
            nm.msgId = id;
            nm.mark = mine ? mark : -1;
            if (mine) {
                nm.kind = mark == 2 ? "wx-readed"
                    : (mark == 1 ? "wx-acked" : "");
            }
            // 引用回复：服务端把被引消息的发送者与摘要回在 quoteWho/
            // quoteText（发送时传 replyTo）。服务端校验不过时降级成
            // 普通消息，这两个字段缺席——照样画，只是没有引用条。
            nm.quoteId = o.Str("replyTo", "");
            nm.quoteWho = o.Str("quoteWho", "");
            nm.quoteText = o.Str("quoteText", "");
            s.msgs.Add(nm);
            WxData.Who("peer:" + peer, s.name, s.initial);
        }
        WxIm.AfterStream(s, peer == openPeer);
    }

    /// collab 群聊流并入：字段与旧域对齐（服务端已把发送者显示名、
    /// 引用解析、附件/任务卡元数据都回在行上）。已撤回消息 kind=
    /// deleted、正文为空——气泡显示「已撤回」占位。回执位不翻
    /// （collab 域没有送达/已读小字）。附件与任务卡的完整呈现
    /// （图片气泡/文件行/卡片）随 A327-13b/c。
    static void ApplyConvStream(string conv, JsonValue msgs) {
        if (WxIm.sessions == null || msgs == null) { return; }
        WxSession s = WxIm.ByConv(conv);
        if (s == null) { return; }
        int appended = 0;
        for (int i = 0; i < msgs.Count(); i = i + 1) {
            JsonValue o = msgs.At(i);
            string id = o.Str("id", "");
            bool mine = o.Str("mine", "0") == "1";
            ChatMessage m = WxIm.ById(s, id);
            if (m != null) { continue; }
            appended = appended + 1;
            string kind = o.Str("kind", "text");
            string body = o.Str("content", "");
            if (kind == "deleted") { body = "已撤回"; }
            ChatMessage nm = ChatMessage.Create(
                mine ? "user" : "assistant", body);
            // 群聊发言人：agent = "u:"+senderId，显示名/首字按服务端
            // 回传登记（WhoOnce 幂等，不随每拍流重复注册）。
            string from = o.Str("from", "");
            nm.agent = mine ? "" : "u:" + from;
            if (!mine) {
                string nm2 = o.Str("name", "");
                WxData.WhoOnce("u:" + from, nm2, WxIm.IniOf(nm2));
            }
            nm.at = Convert.ToInt64(o.Str("at", "0"));
            nm.msgId = id;
            nm.mark = mine ? 0 : -1;
            nm.quoteId = o.Str("replyTo", "");
            nm.quoteWho = o.Str("quoteWho", "");
            nm.quoteText = o.Str("quoteText", "");
            s.msgs.Add(nm);
        }
        WxIm.AfterStream(s, conv == openConv);
        // 打开中并入的新消息就地落已读水位：Open 只在打开那一刻
        // PostRead 一次，之后 Beat/live 并入的新消息若不跟着推进，
        // 服务端未读（conversations.unread 按 lastReadMsgId 算）会一直
        // 挂着——用户明明看着屏幕，Rail 徽标却亮着。幂等只进不退，
        // 重复打无害。
        if (appended > 0 && conv == openConv) { WxIm.PostRead(conv); }
    }

    /// 流并入后的共同收尾：摘要/时间跟最新一条、列表回执位取最后
    /// 一条我发的消息、打开中的会话未读清零。
    static void AfterStream(WxSession s, bool isOpen) {
        int lastMineMark = -1;
        if (s.msgs.Count > 0) {
            ChatMessage last = s.msgs[s.msgs.Count - 1];
            s.snippet = last.text;
            s.time = WxIm.ClockOf(Convert.ToString(last.at));
            for (int i = s.msgs.Count - 1; i >= 0; i = i - 1) {
                if (s.msgs[i].role == "user" && s.msgs[i].msgId.Length > 0) {
                    lastMineMark = s.msgs[i].mark;
                    break;
                }
            }
        }
        if (lastMineMark >= 0) { s.lastMark = lastMineMark; }
        if (isOpen) { s.unread = 0; }
        WxIm.RefreshViews();
    }

    /* ---- 发送 ---- */

    /// 发送：先插"发送中"气泡（灰勾），应答定稿（绿勾/已读），失败
    /// 翻红。正文长度服务端裁到 2048，客户端不再卡。三参版按引用
    /// 回复发送：quoteId 是被引消息的服务端 id（随下一拍流对账）。
    static void Send(WxSession s, string text) {
        WxIm.Send(s, text, "");
    }

    /// 页发送钮的入口：有引用草稿就带上（发送后草稿被清、引用条收起）。
    static void SendWithDraft(WxSession s, string text) {
        WxIm.Send(s, text, WxIm.quoteIdPending);
    }

    static void Send(WxSession s, string text, string quoteId) {
        if (s == null || text.Length == 0) { return; }
        if (!s.Linked()) {
            // 没接上服务端的旧示例数据行：维持纯本地行为。
            return;
        }
        ChatMessage m = ChatMessage.Create("user", text);
        m.at = DateTime.UtcNow().ToUnixSeconds();
        m.msgId = "";
        m.mark = 0;
        m.quoteId = quoteId != null ? quoteId : "";
        // 本地气泡的引用条即刻画出来（引用草稿里有被引人与摘要）；
        // 下一拍流刷新会用服务端的 quoteWho/quoteText 对账覆盖。
        if (m.quoteId.Length > 0) {
            m.quoteWho = WxIm.quoteWhoPending;
            m.quoteText = WxIm.quoteTextPending;
        }
        WxIm.ClearQuoteDraft();
        s.msgs.Add(m);
        s.snippet = text;
        s.time = "刚刚";
        WxIm.RefreshViews();
        WxNetReq req = WxNet.NewReq();
        string form;
        if (s.conv.Length > 0) {
            // collab 群聊：clientRequestId 是服务端可重试写契约的
            // 幂等键（必填），本地单调序号 + 秒级时钟足够唯一。
            form = "conversationId=" + Encoding.UrlEncode(s.conv)
                + "&content=" + Encoding.UrlEncode(text)
                + "&clientRequestId=" + WxIm.NextCrid();
            if (m.quoteId.Length > 0) {
                form = form + "&replyTo=" + Encoding.UrlEncode(m.quoteId);
            }
            WxNet.ApiPost(req, "/api/collab/send", form, () => {
                WxIm.SettleSend(s, m, req);
            });
            return;
        }
        form = "peer=" + Encoding.UrlEncode(s.peer)
            + "&content=" + Encoding.UrlEncode(text);
        if (m.quoteId.Length > 0) {
            form = form + "&replyTo=" + Encoding.UrlEncode(m.quoteId);
        }
        WxNet.Post(req, "send", form, () => {
            WxIm.SettleSend(s, m, req);
        });
    }

    /// Send 应答的共同定稿：成功拿 id/at，失败气泡翻红。
    static void SettleSend(WxSession s, ChatMessage m, WxNetReq req) {
        if (WxNet.OkOf(req)) {
            JsonValue d = WxNet.DataOf(req);
            m.msgId = d == null ? "" : d.Str("id", "");
            if (d != null) {
                long at = Convert.ToInt64(d.Str("at", "0"));
                if (at > 0) { m.at = at; }
            }
            // 送达/已读回执等轮询翻；先按"已发出"画。
            m.mark = 0;
            s.lastMark = 0;
        } else {
            m.role = "error";
        }
        WxIm.RefreshViews();
    }

    /// 可重试写的幂等键：秒级时钟 + 进程内单调序号。
    static int cridSeq;

    static string NextCrid() {
        WxIm.cridSeq = WxIm.cridSeq + 1;
        return "wx-" + Convert.ToString(DateTime.UtcNow().ToUnixSeconds())
            + "-" + Convert.ToString(WxIm.cridSeq);
    }

    /* ---- 引用草稿（输入区上方的引用条） ---- */

    /// 待发送的引用：会话里点「引用」后暂存，随下一条消息发走。
    /// 与输入框文字无关——清空输入框不清引用，点引用条上的 × 才清。
    static string quoteWhoPending = "";
    static string quoteTextPending = "";
    static string quoteIdPending = "";

    /// 页把引用草稿压进来（msgIndex + 选中文本；文本空 = 整条引用）。
    static void SetQuoteDraft(int msgIndex, string text) {
        if (WxIm.sessions == null || WxIm.page == null) { return; }
        // msgIndex 是 ChatView data（= 当前会话 msgs）里的下标，
        // 当前会话就是页上正打开的那个。
        WxSession s = WxIm.page.CurrentSession();
        if (s == null || msgIndex < 0 || msgIndex >= s.msgs.Count) { return; }
        ChatMessage m = s.msgs[msgIndex];
        string who = m.role == "user" ? "我" : s.name;
        string body = text != null && text.Length > 0 ? text : m.text;
        if (body.Length > 120) { body = body.Substring(0, 120) + "…"; }
        WxIm.quoteWhoPending = who;
        WxIm.quoteTextPending = body;
        WxIm.quoteIdPending = m.msgId;
        // 引用的是"发送中"还没拿到 id 的气泡：等价于普通发送。
        if (WxIm.quoteIdPending.Length == 0) {
            WxIm.ClearQuoteDraft();
            return;
        }
        WxIm.page.ShowQuoteBar(who, body);
    }

    static void ClearQuoteDraft() {
        WxIm.quoteWhoPending = "";
        WxIm.quoteTextPending = "";
        WxIm.quoteIdPending = "";
    }

    /// 页上的 × 按钮调：清草稿并收起引用条。
    static void DismissQuoteDraft() {
        WxIm.ClearQuoteDraft();
        if (WxIm.page != null) { WxIm.page.HideQuoteBar(); }
    }

    /* ---- 未读总数（Rail 徽标用） ---- */

    static int unreadTotal;

    /// 实时事件接线点（A327-12 接入、A327-13 落地）：WxEvents 线程
    /// 去重后的帧在 UI 线程递到这里，按事件类型驱动会话模型——
    /// message.created：打开中的群会话直接拉流并入；没打开的本地
    /// 并入摘要与未读（服务端帧顶层带 excerpt，平铺外形见 Policy.Frame）。
    /// conversation.created / member.joined / member.left：列表结构
    /// 变化，整表重拉（两源快照合并，槽身份认领保消息记录）。
    static int liveEvents;

    static void OnLiveEvent(string eventJson) {
        WxIm.liveEvents = WxIm.liveEvents + 1;
        JsonValue v = JsonValue.ParseLenient(eventJson);
        if (v == null) { return; }
        string ev = v.Str("event", "");
        if (ev == "message.created") {
            string conv = v.Str("conversationId", "");
            if (conv.Length == 0) { return; }
            if (conv == WxIm.openConv) {
                WxIm.PullConvStream(conv, null);
                return;
            }
            WxSession s = WxIm.ByConv(conv);
            if (s != null) {
                s.snippet = v.Str("excerpt", "");
                s.time = "刚刚";
                s.unread = s.unread + 1;
                WxIm.groupUnread = WxIm.groupUnread + 1;
                WxIm.RefreshBadge();
                WxIm.RefreshViews();
            }
            return;
        }
        if (ev == "conversation.created" || ev == "member.joined"
            || ev == "member.left") {
            WxIm.RefreshChats(null);
        }
    }

    /// 未读总数（Rail 徽标；App 轮询后读它刷新）。
    static int TotalUnread() { return WxIm.unreadTotal; }

    /// 未读徽标刷新回调（宿主接：Rail 上的红点随 total 变）。
    static Action badgeSink;

    static void OnBadge(Action cb) { WxIm.badgeSink = cb; }

    static void RefreshBadge() {
        if (WxIm.badgeSink != null) { WxIm.badgeSink(); }
    }

    /// 打一条送达回执（服务端按 toId 幂等；同一 id 重复打无害）。
    static void PostAck(string id) {
        if (!WxNet.LoggedIn() || id.Length == 0 || id == "0") { return; }
        WxNetReq req = WxNet.NewReq();
        WxNet.Post(req, "ack", "id=" + Encoding.UrlEncode(id), null);
    }

    /// collab 群聊已读水位：打开会话时调一次，服务端把水位推进到
    /// 当前最大消息 id（幂等只进不退）。
    static void PostRead(string conv) {
        if (!WxNet.LoggedIn() || conv.Length == 0) { return; }
        WxNetReq req = WxNet.NewReq();
        WxNet.ApiPost(req, "/api/collab/read",
            "conversationId=" + Encoding.UrlEncode(conv), null);
    }

    static void PollUnread() {
        if (!WxNet.LoggedIn()) { return; }
        WxNetReq req = WxNet.NewReq();
        WxNet.Get(req, "unread", () => {
            if (!WxNet.OkOf(req)) { return; }
            JsonValue d = WxNet.DataOf(req);
            if (d == null) { return; }
            WxIm.SyncBadge(Convert.ToInt32(d.Str("count", "0")));
        });
    }

    /// 徽标总账：旧域 1:1 未读 + collab 群聊未读合计（群聊部分在
    /// Merge 里随快照重算，live 事件就地增减）。
    static void SyncBadge(int imUnread) {
        int n = imUnread + WxIm.groupUnread;
        if (n != WxIm.unreadTotal) {
            WxIm.unreadTotal = n;
            WxIm.RefreshBadge();
        }
    }

    /// 一次拉流的应答体（WxNet.DataOf 的薄包装，回调里读得顺一些）。
    static JsonValue WxDataOf(WxNetReq r) { return WxNet.DataOf(r); }

    /* ---- 待回执的对端队列 ---- */

    /// 列表重拉看到的"对方发来、我还没回执"的对端（每端一条就够，
    /// 服务端会把这端发来的整批一次打点）。收进队列，轮询的下半拍
    /// 发批量回执——在 ApplyChats 里直接发会让同一拍堆两条请求。
    static List<string> ackQueue;

    static void QueueAck(string peer) {
        if (peer.Length == 0 || peer == "0") { return; }
        if (WxIm.ackQueue == null) { WxIm.ackQueue = new List<string>(); }
        for (int i = 0; i < WxIm.ackQueue.Count; i = i + 1) {
            if (WxIm.ackQueue[i] == peer) { return; }
        }
        WxIm.ackQueue.Add(peer);
    }

    /// 把队列里的对端各打一次批量送达回执（服务端幂等）。
    static void DrainAckQueue() {
        if (WxIm.ackQueue == null || WxIm.ackQueue.Count == 0) { return; }
        List<string> q = WxIm.ackQueue;
        WxIm.ackQueue = new List<string>();
        for (int i = 0; i < q.Count; i = i + 1) {
            WxNetReq req = WxNet.NewReq();
            WxNet.Post(req, "ack", "peer=" + Encoding.UrlEncode(q[i]), null);
        }
    }

    /* ---- 定时节拍（宿主 form.Every(1500, ...) 调） ---- */

    static void Tick() {
        if (!WxNet.LoggedIn()) { return; }
        WxIm.tick = WxIm.tick + 1;
        WxIm.RefreshOpen();
        WxIm.DrainAckQueue();
        if (WxIm.tick % 3 == 0) {
            WxIm.RefreshChats(null);
            WxIm.PollUnread();
        }
    }

    /// 宿主接节拍（主窗口 form.Every 里调）。
    static void Beat() { WxIm.Tick(); }

    /* ---- 工具 ---- */

    static WxSession ByPeer(string peer) {
        if (WxIm.sessions == null) { return null; }
        for (int i = 0; i < WxIm.sessions.Count; i = i + 1) {
            if (WxIm.sessions[i].peer == peer) { return WxIm.sessions[i]; }
        }
        return null;
    }

    static WxSession ByConv(string conv) {
        if (WxIm.sessions == null || conv.Length == 0) { return null; }
        for (int i = 0; i < WxIm.sessions.Count; i = i + 1) {
            if (WxIm.sessions[i].conv == conv) { return WxIm.sessions[i]; }
        }
        return null;
    }

    static ChatMessage ById(WxSession s, string id) {
        if (id.Length == 0) { return null; }
        for (int i = 0; i < s.msgs.Count; i = i + 1) {
            if (s.msgs[i].msgId == id) { return s.msgs[i]; }
        }
        return null;
    }

    /// 名字取首字（头像格）：ASCII 首字节大写；中文取首字（数据显式
    /// 给不到时按字节兜底）。
    static string IniOf(string name) {
        if (name.Length == 0) { return "?"; }
        return name.Substring(0, 1);
    }

    /// Unix 秒 → 列表时间：今天显示 HH:MM，更早显示 MM-dd。
    static string ClockOf(string atStr) {
        long at = Convert.ToInt64(atStr);
        if (at <= 0) { return ""; }
        long now = DateTime.UtcNow().ToUnixSeconds();
        DateTime t = DateTime.FromUnixSeconds(at).ToLocalTime();
        if (now - at < 86400) {
            return t.ToTimeString().Substring(0, 5);
        }
        return t.ToDateString().Substring(5, 5);
    }

    /// 让页面把新数据画出来（列表行 + 气泡 + 标题区）。拖出去的浮窗
    /// 共享同一份会话模型，一并跟上——浮窗里才能实时看到新消息并入
    /// 与回执翻位，而不是只停在发送那一刻的画面。
    static void RefreshViews() {
        if (WxIm.page != null) { WxIm.page.OnDataChanged(); }
        WxChatWindow.RefreshAll();
    }
}
