using System;
using Gui;
using Gui.Widget;

public class Wx {
    // 带类的标签。
    static Label Lbl(string txt, string cls) {
        Label l = new Label(txt);
        l.Class = cls;
        return l;
    }

    // 无文字的图标按钮（标题条上的 …）。标准扁平按钮：`text` 变体
    // 无底无框、`small` 是尺寸档，外观由皮肤的 `button.text` 规则定，
    // 这里不写一行式样。图标来自皮肤内置的图标集。
    static Button IconBtn(string icon) {
        Button b = new Button("");
        b.Icon = icon;
        b.Class = "text small";
        return b;
    }

    // 行内小动作钮（面板行里的 ↑/↓/停用/解绑）：无框文字钮，紧凑尺寸。
    static Button MiniBtn(string label) {
        Button b = new Button(label);
        b.Class = "text small";
        return b;
    }

    // 头像：首字 + 直径 + 色调类（primary / info / success / warning / error）。
    static Avatar Ava(string initial, int size, string tint) {
        Avatar a = new Avatar(initial, size);
        a.Class = tint;
        return a;
    }

    // 图标头像（快捷入口那种：底色 + 一个线性图标，没有字）。
    static Avatar AvaIcon(string icon, int size, string tint) {
        Avatar a = new Avatar("", size, icon);
        a.Class = tint;
        return a;
    }

    // 纵向流式容器（宽度/内边距/间距都在样式表里）。
    static Panel Col(string cls) {
        Panel p = Panel.Column();
        p.Class = cls;
        return p;
    }

    // 横向 flex 行，交叉轴居中——「左边标题、右边值」这类行都用它。
    static Flex Row(string cls) {
        Flex f = Flex.Row();
        f.Class = cls;
        f.Align("center");
        return f;
    }

    // 分组小标题。
    static Label Sec(string txt) {
        return Wx.Lbl(txt, "wxsetsec");
    }

    // 设置里导航按钮的类名（选中的那个加状态类 wxon）。
    static string NavCls(bool on) {
        if (on) { return "wxsetnavbtn wxon"; }
        return "wxsetnavbtn";
    }

    // 分隔线（标准库组件，不自绘）。
    static Divider Line() {
        Divider d = new Divider();
        return d;
    }

    // 抽屉里「标签 + 开关」的一行（开关是标准库 Switch，状态不接
    // 业务——示例数据的这些偏好本来就是摆设）。
    static Flex SwRow(string label) {
        Flex row = Wx.Row("wxdrow");
        row.Add(Wx.Lbl(label, "wxdkey grow"));
        Switch sw = new Switch();
        row.Add(sw);
        return row;
    }

    // 抽屉底部红色的「清空聊天记录」（原版就是居中一行红字按钮）。
    static Button ClearBtn(Action onClear) {
        Button b = new Button("清空聊天记录");
        b.Class = "wxclear";
        b.OnClick(() => { onClear(); });
        return b;
    }

    // 成员格：头像 + 昵称（抽屉与常用头像面板共用的四列网格）。
    // 纯展示——dock 布局里没有可靠的「格子上盖一层点击区」的
    // 组件化做法，面板的交互由表情/文件面板承担。`ini` 是头像
    // 首字，由数据显式给出（字符串按字节索引，中文切不得）。
    static Flex MemberCell(string name, string ini, string tint) {
        Flex cell = Flex.Column();
        cell.AddClass("wxcell");
        cell.Align("center");
        cell.Add(Wx.Ava(ini, 36, tint));
        cell.Add(Wx.Lbl(name, "wxcellname"));
        return cell;
    }

    // 成员格的可点版本：整格、头像、名字都会触发 onClick
    // （群抽屉点成员弹资料名片用）。头像和名字单独再绑一次是
    // 因为子控件先于父格吃到命中。
    static Flex MemberCell(string name, string ini, string tint,
            Action onClick) {
        Flex cell = Flex.Column();
        cell.AddClass("wxcell");
        cell.Align("center");
        Avatar a = Wx.Ava(ini, 36, tint);
        Label l = Wx.Lbl(name, "wxcellname");
        cell.OnClick(onClick);
        a.OnClick(onClick);
        l.OnClick(onClick);
        cell.Add(a);
        cell.Add(l);
        return cell;
    }

    // 成员格网格末尾的「添加」格（图标头像 + 字）。
    static Flex MemberCellPlus() {
        Flex cell = Flex.Column();
        cell.AddClass("wxcell");
        cell.Align("center");
        cell.Add(Wx.AvaIcon("plus", 40, ""));
        cell.Add(Wx.Lbl("添加", "wxcellname"));
        return cell;
    }

    // 表情面板的一行等宽表情按钮；`big` 是收藏页的大号格。
    static Flex EmojiRow(List<string> items, Action<string> insert, bool big) {
        Flex row = Flex.Row();
        row.AddClass(big ? "wxemogrid big" : "wxemogrid");
        for (int i = 0; i < items.Count; i = i + 1) {
            string e = items[i];
            Button b = new Button(e);
            b.Class = big ? "wxemo big" : "wxemo";
            b.OnClick(() => { insert(e); });
            row.Add(b);
        }
        return row;
    }

    // 工具条第 i 项，越界给一个无名的哑按钮——ItemAt 的可空返回
    // 在每个调用点判空太吵，收拢到这里（越界本身就是模板的 bug，
    // 哑按钮保证写 tip/类名不至于崩）。
    static Button Item(ToolStrip ts, int i) {
        Button b = ts.ItemAt(i);
        if (b != null) { return b; }
        return new Button("");
    }
}

// 一行「左键右值」的资料行；键与值都留给调用方在选中变化时改写
// （通讯录资料卡按分组换键名：联系人是「标签」，企业联系人是「企业」）。
