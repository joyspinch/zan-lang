using System;
using Gui;
using Gui.Backend;
using Gui.Component;
using Gui.Widget;

// 命名配对：WeChatMoments.html（骨架文档）↔ WeChatMoments.zan（code-behind）——每个 .html 窗口文档都有一个同名 .zan。

// 朋友圈页：左栏是「发现」入口列（朋友圈/视频号/搜一搜/游戏/小程序，
// 只有朋友圈是真的，其余是原版同款的摆设项）；右侧上方是封面（自己的
// 名字与头像压在封面右下角，点头像弹自己的名片），下方是帖子流
// （头像 + 名字 + 正文 + 图墙 + 时间 + 「···」）。头像可点、长文可展开。
// 版式上「左窄导航 + 右信息流」与将来的企业工作台同构。
class WxPageMoments : Control {
    ListView<WxPost> feed;
    WxProfilePanel prof;
    // 名片槽（HTML 骨架里的 #MomProfSlot）：随名片显隐同步翻
    // visible——槽是 flex 项，隐藏后随内容收缩，信息流占满整行。
    Control profSlot;
    App app;

    WxPageMoments() {
        this.InitControl("wxmoments", 5);
        this.Class = "wxmain";

        // ---- HTML 骨架（WeChatMoments.html）：发现栏 + 封面 + 信息流 ----
        // 树根是 body 元素（dock 0 = Manual），runtime 文档必须
        // code-behind 补 DockFill（同收藏页）。
        Control ui = WeChatMomentsHtml.Build(null);
        ui.DockFill();
        this.Add(ui);

        // ---- 左栏：发现。行模板（图标 + 文字）仍是 code-behind——
        // IconView 图标是动态控件，挂进骨架预留的标题之后。骨架 id
        // 都在文档里写死，找不到即断言兜底挂本页（防呆不防编译）。 ----
        Control disc = ui.Find("MomDisc");
        if (disc == null) { disc = ui; }
        disc.Add(this.Entry("compass", "朋友圈", true));
        disc.Add(this.Entry("device-tv", "视频号", false));
        disc.Add(this.Entry("search", "搜一搜", false));
        disc.Add(this.Entry("device-gamepad", "游戏", false));
        disc.Add(this.Entry("apps", "小程序", false));

        // ---- 封面右下角：自己的头像（点头像 = 我的名片）。名字那行
        // 文案已在 HTML 里，头像控件从骨架的角落容器挂进来。 ----
        Control corner = ui.Find("MomCoverCorner");
        if (corner == null) { corner = ui; }
        Avatar me = Wx.Ava("季", 64, "success");
        me.AddClass("wxpme");
        me.OnClick(() => { this.Ask("季然", "季", "success"); });
        corner.Add(me);

        // ---- 帖子流：ListView 挂进骨架的信息流壳。 ----
        Control feedHost = ui.Find("MomFeedHost");
        if (feedHost == null) { feedHost = ui; }
        feed = new ListView<WxPost>(WxPostRow.Of);
        feed.Class = "wxfeed grow";
        feed.Bind(WxProfiles.Moments());
        feedHost.Add(feed);

        // ---- 资料名片（与聊天页同一张卡）挂进名片槽。 ----
        prof = WxProfilePanel.Of();
        profSlot = ui.Find("MomProfSlot");
        if (profSlot == null) { profSlot = ui; }
        profSlot.Add(prof);
    }

    // 「发现」的一行：图标 + 名字；只有当前项亮着，其余是原版
    // 同款的摆设项，点了不动。
    Flex Entry(string icon, string txt, bool on) {
        Flex e = Wx.Row("wxdentry");
        IconView ic = new IconView(icon, 20);
        Label tl = Wx.Lbl(txt, "wxdentrytext");
        e.Add(ic);
        e.Add(tl);
        if (on) {
            e.SetClassIn("wxon", "wxon");
            ic.AddClass("wxon");
            tl.AddClass("wxon");
        }
        return e;
    }

    void Ask(string nm, string ini, string tint) {
        prof.Show(WxProfiles.Of(nm, ini, tint));
        // 名片槽与名片同步显隐（槽隐藏时随内容收缩，信息流占满整行）。
        profSlot.visible = true;
        Control slot = profSlot;
        prof.onHide = () => { slot.visible = false; };
        {
            App a = this.FindApp();
            if (a == null) { a = this.app; }
            if (a != null) { a.RequestRedraw(); }
        }
    }

    void UseApp(App a) {
        this.app = a;
    }

    override string Kind() { return "WxPageMoments"; }
}
