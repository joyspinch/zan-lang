using Gui;

/// {{NAME}} 的应用样式表：只放布局（宽度/高度/内边距/间距）与自有类的
/// 外观，颜色一律走 token。它叠加在皮肤之上，且每次换肤后自动重新生效，
/// 因此换成 liquidglass 皮肤这套界面照样成立。
/// （`App.UseAppCss` 的用法见 gui_gallery / gui_charts。）
class WxSkin {
    static string Css() {
        return ""
            // ---- 图标导航栏 -------------------------------------------------
            // 栏底色比列表深一档；按钮是 56×56 的无边框正方形。
            + "#RailHost { background: var(--bg-tertiary); }\n"
            + "button.rail-btn { height: 56; border-width: 0; border-radius: 10;"
            + " background: transparent; color: var(--text-secondary); font-size: 20; }\n"
            + "button.rail-btn:hover { background: var(--bg-hover); color: var(--text-primary); }\n"
            + "button.rail-btn.wxon { background: var(--bg-active); color: var(--primary); }\n"
            // 头像一律圆角方形（微信样式）；皮肤默认的 999 圆形被这条盖掉。
            + "avatar { border-radius: 8; }\n"
            // ---- 三栏共用 ---------------------------------------------------
            + ".wxmain { background: var(--bg-primary); }\n"
            + ".wxcol { width: 300; background: var(--bg-secondary); }\n"
            + ".wxpad { height: 46; padding: 10 10 6 10; }\n"
            + ".wxlist { background: transparent; }\n"
            // ---- 会话行 -----------------------------------------------------
            // 列表行的行高在这里声明：行模板用 Style.HeightOr 取它，
            // 代码里不再写死高度，改一行数字全列表生效。
            + ".wxsess { height: 64; padding: 5 10; background: transparent;"
            + " border-bottom: 1 var(--divider); }\n"
            + ".wxsessname { font-size: 14; }\n"
            + ".wxsessub { font-size: 12; color: var(--text-tertiary); }\n"
            // 中列与头像/右列的水平间距走自己的 padding：行的 gap 若
            // 还在，会叠在行底分隔线（dock 子项）上方，把内容盒压矮。
            + ".wxmid { padding-left: 10; gap: 0; }\n"
            + ".wxmeta { width: 54; gap: 2; }\n"
            + ".wxtime { font-size: 12; color: var(--text-tertiary); }\n"
            // ---- 聊天页 -----------------------------------------------------
            + ".wxhead { height: 56; padding: 0 16; gap: 8; }\n"
            + ".wxheadname { font-size: 15; }\n"
            + ".wxheaddesc { font-size: 12; color: var(--text-tertiary); }\n"
            + ".wxchat { background: var(--bg-primary); }\n"
            + ".wxcomposer { height: 172; background: var(--bg-secondary); }\n"
            + ".wxtypewrap { padding: 10 12 6 12; }\n"
            + "textarea.wxtype { background: transparent; border-width: 0; }\n"
            + ".wxbottom { height: 46; padding: 0 12 10 6; gap: 8; }\n"
            // ---- 通讯录左栏 -------------------------------------------------
            + ".wxcat { height: 56; padding: 6 12; gap: 12; background: transparent; }\n"
            + ".wxcatname { font-size: 14; }\n"
            + ".wxcatcount { font-size: 12; color: var(--text-tertiary); }\n"
            + ".wxhead2 { height: 32; padding: 6 12; font-size: 12;"
            + " color: var(--text-tertiary); }\n"
            // ---- 联系人资料栏 -----------------------------------------------
            + ".wxcard { background: var(--bg-primary); }\n"
            + ".wxdetail { padding: 24 30; }\n"
            + ".wxdname { font-size: 20; }\n"
            + ".wxdsub { font-size: 12; color: var(--text-tertiary); }\n"
            + ".wxsec { font-size: 12; color: var(--text-tertiary); padding: 14 0 2 0; }\n"
            + ".wxdrow { height: 30; gap: 12; }\n"
            + ".wxdkey { color: var(--text-secondary); font-size: 13; }\n"
            + ".wxdval { font-size: 13; }\n"
            + ".wxacts { height: 68; gap: 10; padding: 14 0 0 0; }\n"
            + ".wxhint { font-size: 12; color: var(--text-tertiary); padding: 8 0 0 0; }\n"
            // ---- 收藏 -------------------------------------------------------
            + ".wxfilters { width: 208; background: var(--bg-secondary); }\n"
            + ".wxfilt { height: 42; padding: 0 14; background: transparent; }\n"
            + ".wxfiltname { font-size: 14; }\n"
            + ".wxfavs { background: var(--bg-primary); }\n"
            + ".wxfavhead { height: 52; padding: 0 18; }\n"
            + ".wxfavtitle { font-size: 15; }\n"
            + ".wxfavrow { height: 68; padding: 8 18; background: transparent;"
            + " border-bottom: 1 var(--divider); }\n"
            + ".wxfavname { font-size: 14; }\n"
            + ".wxfavsub { font-size: 12; color: var(--text-tertiary); }\n"
            + ".wxfavfoot { height: 36; padding: 0 18; background: var(--bg-secondary); }\n"
            + ".wxfavfoottxt { font-size: 12; color: var(--text-tertiary); }\n"
            // ---- 设置层窗口 -------------------------------------------------
            + ".wxset { background: var(--bg-primary); }\n"
            + ".wxsetnav { width: 166; background: var(--bg-secondary);"
            + " padding: 8; gap: 2; }\n"
            + "button.wxsetnavbtn { height: 34; border-width: 0;"
            + " background: transparent; color: var(--text-primary); }\n"
            + "button.wxsetnavbtn:hover { background: var(--bg-hover); }\n"
            + "button.wxsetnavbtn.wxon { background: var(--bg-active); color: var(--primary); }\n"
            + ".wxsetbody { padding: 12 20; }\n"
            + ".wxsetsec { font-size: 12; color: var(--text-tertiary);"
            + " padding: 10 0 4 0; }\n"
            + ".wxsetrow { height: 54; gap: 12; }\n"
            + ".wxsetkey { font-size: 14; }\n"
            + ".wxsetval { font-size: 13; color: var(--text-secondary); }\n"
            // ---- 独立聊天窗口（会话行拖出主窗口后开的子窗口） ---------------
            + ".wxchatwin { background: var(--bg-primary); }\n";
    }
}
