using Gui;

/// {{NAME}} 的应用样式表：只放布局（宽度/高度/内边距/间距）与自有类的
/// 外观，颜色一律走 token。它叠加在皮肤之上，且每次换肤后自动重新生效，
/// 因此换成 liquidglass 皮肤这套界面照样成立。
/// （`App.UseAppCss` 的用法见 gui_gallery / gui_charts。）
class WxSkin {
    static string Css() {
        return ""
            // ---- 图标导航栏 -------------------------------------------------
            // 栏底色比列表深一档；按钮是 56×56 的无边框正方形。
            + "#RailHost { background: var(--bg-tertiary); }\n"
            + "button.rail-btn { height: 56; border-width: 0; border-radius: 10;"
            + " background: transparent; color: var(--text-secondary); font-size: 20; }\n"
            + "button.rail-btn:hover { background: var(--bg-hover); color: var(--text-primary); }\n"
            + "button.rail-btn.wxon { background: var(--bg-active); color: var(--primary); }\n"
            // 头像一律圆角方形（微信样式）；皮肤默认的 999 圆形被这条盖掉。
            + "avatar { border-radius: 8; }\n"
            // ---- 三栏共用 ---------------------------------------------------
            + ".wxmain { background: var(--bg-primary); }\n"
            + ".wxcol { width: 300; background: var(--bg-secondary); }\n"
            + ".wxpad { height: 46; padding: 10 10 6 10; }\n"
            + ".wxlist { background: transparent; }\n"
            // ---- 会话行 -----------------------------------------------------
            // 列表行的行高在这里声明：行模板用 Style.HeightOr 取它，
            // 代码里不再写死高度，改一行数字全列表生效。
            + ".wxsess { height: 64; padding: 5 10; background: transparent;"
            + " border-bottom: 1 var(--divider); }\n"
            + ".wxsessname { font-size: 14; }\n"
            + ".wxsessub { font-size: 12; color: var(--text-tertiary); }\n"
            // 中列与头像/右列的水平间距走自己的 padding：行的 gap 若
            // 还在，会叠在行底分隔线（dock 子项）上方，把内容盒压矮。
            + ".wxmid { padding-left: 10; gap: 0; }\n"
            + ".wxmeta { width: 54; gap: 2; }\n"
            + ".wxtime { font-size: 12; color: var(--text-tertiary); }\n"
            // ---- 聊天页 -----------------------------------------------------
            + ".wxhead { height: 56; padding: 0 16; gap: 8; }\n"
            + ".wxheadname { font-size: 15; }\n"
            + ".wxheaddesc { font-size: 12; color: var(--text-tertiary); }\n"
            + ".wxchat { background: var(--bg-primary); }\n"
            + ".wxcomposer { height: 172; background: var(--bg-secondary); }\n"
            + ".wxtypewrap { padding: 10 12 6 12; }\n"
            + "textarea.wxtype { background: transparent; border-width: 0; }\n"
            + ".wxbottom { height: 46; padding: 0 12 10 6; gap: 8; }\n"
            // 引用条：输入框上方那一行小字 + 右侧取消按钮。
            + ".wxquote { height: 34; padding: 0 12; gap: 8;"
            + " background: var(--bg-secondary); border-top: 1 var(--divider); }\n"
            + ".wxquotetext { font-size: 12; color: var(--text-secondary); }\n"
            // ---- 通讯录左栏 -------------------------------------------------
            + ".wxcat { height: 56; padding: 6 12; gap: 12; background: transparent; }\n"
            + ".wxcatname { font-size: 14; }\n"
            + ".wxcatcount { font-size: 12; color: var(--text-tertiary); }\n"
            + ".wxhead2 { height: 32; padding: 6 12; font-size: 12;"
            + " color: var(--text-tertiary); }\n"
            // ---- 联系人资料栏 -----------------------------------------------
            + ".wxcard { background: var(--bg-primary); }\n"
            + ".wxdetail { padding: 24 30; }\n"
            + ".wxdname { font-size: 20; }\n"
            + ".wxdsub { font-size: 12; color: var(--text-tertiary); }\n"
            + ".wxsec { font-size: 12; color: var(--text-tertiary); padding: 14 0 2 0; }\n"
            + ".wxdrow { height: 30; gap: 12; }\n"
            + ".wxdkey { color: var(--text-secondary); font-size: 13; }\n"
            + ".wxdval { font-size: 13; }\n"
            + ".wxacts { height: 68; gap: 10; padding: 14 0 0 0; }\n"
            + ".wxhint { font-size: 12; color: var(--text-tertiary); padding: 8 0 0 0; }\n"
            // ---- 收藏 -------------------------------------------------------
            + ".wxfilters { width: 208; background: var(--bg-secondary); }\n"
            + ".wxfilt { height: 42; padding: 0 14; background: transparent; }\n"
            + ".wxfiltname { font-size: 14; }\n"
            + ".wxfavs { background: var(--bg-primary); }\n"
            + ".wxfavhead { height: 52; padding: 0 18; }\n"
            + ".wxfavtitle { font-size: 15; }\n"
            + ".wxfavrow { height: 68; padding: 8 18; background: transparent;"
            + " border-bottom: 1 var(--divider); }\n"
            + ".wxfavname { font-size: 14; }\n"
            + ".wxfavsub { font-size: 12; color: var(--text-tertiary); }\n"
            + ".wxfavfoot { height: 36; padding: 0 18; background: var(--bg-secondary); }\n"
            + ".wxfavfoottxt { font-size: 12; color: var(--text-tertiary); }\n"
            // ---- 设置层窗口 -------------------------------------------------
            + ".wxset { background: var(--bg-primary); }\n"
            + ".wxsetnav { width: 166; background: var(--bg-secondary);"
            + " padding: 8; gap: 2; }\n"
            + "button.wxsetnavbtn { height: 34; border-width: 0;"
            + " background: transparent; color: var(--text-primary); }\n"
            + "button.wxsetnavbtn:hover { background: var(--bg-hover); }\n"
            + "button.wxsetnavbtn.wxon { background: var(--bg-active); color: var(--primary); }\n"
            + ".wxsetbody { padding: 12 20; }\n"
            + ".wxsetsec { font-size: 12; color: var(--text-tertiary);"
            + " padding: 10 0 4 0; }\n"
            + ".wxsetrow { height: 54; gap: 12; }\n"
            + ".wxsetkey { font-size: 14; }\n"
            + ".wxsetval { font-size: 13; color: var(--text-secondary); }\n"
            // ---- 独立聊天窗口（会话行拖出主窗口后开的子窗口） ---------------
            + ".wxchatwin { background: var(--bg-primary); }\n"
            // ---- 聊天页右侧抽屉（... 按钮） ---------------------------------
            + ".wxdrawer { width: 320; background: var(--bg-secondary);"
            + " border-left: 1 var(--divider); }\n"
            + ".wxdbody { padding: 12 14; gap: 2; }\n"
            + ".wxdbody2 { gap: 2; }\n"
            + ".wxdtitle { font-size: 16; }\n"
            + ".wxdsub { font-size: 12; color: var(--text-tertiary); }\n"
            + ".wxdadd { margin: 4 0 2 0; }\n"
            + ".wxdrow { height: 38; gap: 10; }\n"
            + ".wxdkey { font-size: 14; }\n"
            + ".wxdval { font-size: 13; color: var(--text-secondary); }\n"
            + ".wxdmore { font-size: 13; color: var(--text-tertiary);"
            + " padding: 2 0; }\n"
            + ".wxdnotice { font-size: 12; color: var(--text-tertiary);"
            + " padding: 0 0 2 0; }\n"
            + ".wxdsearch { height: 32; margin: 0 0 2 0; }\n"
            + "button.wxdrowbtn { height: 38; border-width: 0;"
            + " background: transparent; }\n"
            + "button.wxdrowbtn:hover { background: var(--bg-hover); }\n"
            + "button.wxclear { height: 36; border-width: 0;"
            + " background: transparent; color: var(--error);"
            + " margin: 4 0 0 0; }\n"
            + "button.wxclear:hover { background: var(--bg-hover); }\n"
            // ---- 成员格（抽屉与常用头像面板共用的四列网格） ------------------
            + ".wxgrid { gap: 8; }\n"
            + ".wxcell { width: 62; gap: 3; }\n"
            + ".wxcellname { font-size: 11; color: var(--text-tertiary); }\n"
            // ---- 输入区上方的弹出面板（表情 / 头像 / 文件） ------------------
            + ".wxpopup { background: transparent; }\n"
            + ".wxemopanel { width: 424; background: var(--bg-secondary);"
            + " border-top: 1 var(--divider); padding: 8 16; gap: 4; }\n"
            + ".wxavapanel { width: 424; background: var(--bg-secondary);"
            + " border-top: 1 var(--divider); padding: 8 16; gap: 8; }\n"
            + ".wxfilepanel { width: 424; background: var(--bg-secondary);"
            + " border-top: 1 var(--divider); padding: 8 16; gap: 2; }\n"
            + ".wxemotitle { font-size: 12; color: var(--text-tertiary);"
            + " padding: 4 0 0 0; }\n"
            + ".wxemogrid { gap: 2; }\n"
            + ".wxemogrid.big { gap: 4; }\n"
            + "button.wxemo { width: 38; height: 36; border-width: 0;"
            + " background: transparent; font-size: 19; }\n"
            + "button.wxemo:hover { background: var(--bg-hover); }\n"
            + "button.wxemo.big { width: 48; height: 46; font-size: 26; }\n"
            + ".wxemotabs { height: 34; }\n"
            + "button.wxemo-tab { border-width: 0; background: transparent;"
            + " color: var(--text-tertiary); }\n"
            + "button.wxemo-tab.wxon { color: var(--primary); }\n"
            + "button.wxfilebtn { height: 38; border-width: 0;"
            + " background: transparent; }\n"
            + "button.wxfilebtn:hover { background: var(--bg-hover); }\n"
            // ---- 发语音圆钮（图标条右侧） ------------------------------------
            + "button.wxvoice { border-radius: 999;"
            + " background: var(--bg-hover); }\n"
            // ---- 聊天记录窗口 -------------------------------------------------
            + ".wxhist { background: var(--bg-primary); }\n"
            + ".wxhisthead { height: 54; padding: 10 14; gap: 10; }\n"
            + ".wxhisttabs { height: 42; padding: 0 10; gap: 4; }\n"
            + "button.wxhisttab { height: 28; border-width: 0;"
            + " background: transparent; color: var(--text-secondary);"
            + " font-size: 13; }\n"
            + "button.wxhisttab:hover { background: var(--bg-hover); }\n"
            + "button.wxhisttab.wxon { color: var(--primary);"
            + " background: var(--bg-active); }\n"
            + ".wxhistlist { background: transparent; }\n"
            + ".wxhistrow { height: 62; padding: 8 18; background: transparent;"
            + " border-bottom: 1 var(--divider); }\n"
            + ".wxhmid { padding-left: 10; gap: 0; }\n"
            + ".wxhdate { width: 150; gap: 0; }\n"
            + ".wxhistname { font-size: 13; }\n"
            + ".wxhisttext { font-size: 13; color: var(--text-secondary); }\n"
            + ".wxhistdate { font-size: 12; color: var(--text-tertiary); }\n"
            // ---- 通讯录页：管理入口 + 可折叠分组节 + 好友申请行 -----------
            + ".wxmgmt { height: 40; margin: 8 10; padding: 0 10; gap: 8;"
            + " border: 1 var(--divider); border-radius: 6;"
            + " background: var(--bg-secondary); }\n"
            + ".wxmgmt:hover { background: var(--bg-hover); }\n"
            + ".wxmgmttext { font-size: 14; }\n"
            + ".wxsec { height: 44; padding: 0 12 0 8; gap: 6;"
            + " background: transparent; }\n"
            + ".wxcatname { font-size: 14; }\n"
            + ".wxreqmsg { font-size: 12; color: var(--text-tertiary); }\n"
            + ".wxreqdone { font-size: 13; color: var(--text-tertiary);"
            + " margin: 0 10; }\n"
            + "button.wxreqbtn { height: 30; }\n"
            // ---- 通讯录管理窗口 --------------------------------------------
            + ".wxmg { background: var(--bg-primary); }\n"
            + ".wxmgbody { gap: 0; }\n"
            + ".wxmgside { width: 250; background: var(--bg-secondary);"
            + " padding: 10 0; gap: 2; }\n"
            + "button.wxmgall { height: 40; border-width: 0;"
            + " border-radius: 0; background: transparent;"
            + " text-align: left; padding: 0 18; font-size: 14; }\n"
            + "button.wxmgall.wxon { background: var(--primary);"
            + " color: #ffffff; }\n"
            + ".wxmgsec { font-size: 12; color: var(--text-tertiary);"
            + " padding: 12 18 4 18; }\n"
            + ".wxpermhead { height: 38; padding: 0 12 0 10; gap: 4; }\n"
            + "button.wxmgitem { height: 38; border-width: 0;"
            + " background: transparent; text-align: left;"
            + " padding: 0 18; font-size: 13; }\n"
            + "button.wxmgitem:hover { background: var(--bg-hover); }\n"
            + ".wxpermbox { gap: 0; }\n"
            + "button.wxmgsub { height: 34; border-width: 0;"
            + " background: transparent; text-align: left;"
            + " padding: 0 32; font-size: 13;"
            + " color: var(--text-secondary); }\n"
            + "button.wxmgsub:hover { background: var(--bg-hover); }\n"
            + "button.wxmgsub.wxon { color: var(--primary); }\n"
            + ".wxmgmain { background: var(--bg-primary);"
            + " padding: 10 14 0 14; gap: 8; }\n"
            + ".wxmgsearch { height: 34; }\n"
            + ".wxmghead { height: 40; padding: 0 6; gap: 10;"
            + " border-bottom: 1 var(--divider); }\n"
            + ".wxmgheadcell { font-size: 13;"
            + " color: var(--text-secondary); }\n"
            + ".wxmgrowin { gap: 10; }\n"
            + ".wxmgc1 { width: 170; gap: 0; }\n"
            + ".wxmgc2 { width: 140; gap: 0; }\n"
            + ".wxmgc3 { width: 130; gap: 0; }\n"
            + ".wxmgcell { font-size: 13; color: var(--text-secondary); }\n"
            + ".wxmgtable { background: transparent; }\n"
            + ".wxmgrow { height: 52; padding: 0 6; gap: 10;"
            + " background: transparent;"
            + " border-bottom: 1 var(--divider); }\n"
            + ".wxmgname { font-size: 14; }\n"
            + ".wxcircle { width: 20; height: 20;"
            + " border-radius: 999; border: 1 var(--text-tertiary);"
            + " background: transparent; padding: 0; }\n"
            + ".wxcircle.on { border-color: var(--primary);"
            + " background: var(--primary); color: #ffffff; }\n"
            + ".wxmgbottom { height: 64; padding: 0 18; gap: 12;"
            + " border-top: 1 var(--divider);"
            + " background: var(--bg-secondary); }\n"
            + ".wxmgcount { font-size: 13; }\n"
            + ".wxmgop { width: 72; gap: 3; }\n"
            + ".wxmgop:hover { background: var(--bg-hover); }\n"
            + ".wxmgoptext { font-size: 12; color: var(--text-secondary); }\n"

            // ---- 资料名片：点用户头像弹出的小卡（聊天页/独立窗/朋友圈共用）----
            + ".wxprofile { width: 400; height: 600; margin: 14 16 14 0; border-radius: 12; border: 1 var(--divider); background: var(--bg-primary); box-shadow: 0 10 30 #22000000; }\n"
            + ".wxphead { padding: 22 20 14; gap: 14; align-items: start; }\n"
            + ".wxpname { font-size: 19; }\n"
            + ".wxpgender { font-size: 15; margin-left: 6; color: #4f7ed0; }\n"
            + ".wxpgender.wxpgender-f { color: #e0658f; }\n"
            + ".wxpsub { font-size: 13; color: var(--text-secondary); margin-top: 6; }\n"
            + ".wxpbody { padding: 4 20 10; gap: 4; }\n"
            + ".wxpsec { font-size: 13; color: var(--text-tertiary); margin: 10 0 2; }\n"
            + ".wxprow { height: 30; gap: 12; }\n"
            + ".wxpkey { font-size: 14; color: var(--text-secondary); }\n"
            + ".wxpval { font-size: 14; }\n"
            + ".wxpval.wxpghost { color: var(--text-tertiary); }\n"
            + ".wxpthumbs { gap: 6; margin: 4 0 8; height: 72; }\n"
            + ".wxph-a, .wxph-b, .wxph-c, .wxph-d, .wxph-e, .wxph-f { width: 72; border-radius: 4; }\n"
            + ".wxph-a { background: linear-gradient(135deg, #7fb2e8, #4a7fc4); }\n"
            + ".wxph-b { background: linear-gradient(135deg, #9ed09a, #5f9c5c); }\n"
            + ".wxph-c { background: linear-gradient(135deg, #f0c67f, #d39a45); }\n"
            + ".wxph-d { background: linear-gradient(135deg, #d9a3d4, #a86ab3); }\n"
            + ".wxph-e { background: linear-gradient(135deg, #8fd0cd, #4f9d99); }\n"
            + ".wxph-f { background: linear-gradient(135deg, #e89f9f, #c46868); }\n"
            + ".wxpvideo { font-size: 14; color: var(--primary); margin: 2 0 4; }\n"
            + ".wxpplay { font-size: 15; color: #ffffff; }\n"
            + ".wxpbar { height: 62; border-top: 1 var(--divider); padding: 0 8; justify-content: space-around; }\n"
            + ".wxpop { width: 108; gap: 4; align-items: center; justify-content: center; }\n"
            + ".wxpop:hover { background: var(--bg-hover); border-radius: 8; }\n"
            + ".wxpoptext { font-size: 12; color: var(--text-secondary); }\n"

            // ---- 朋友圈页：发现栏 + 封面 + 帖子流 ----
            + ".wxdisc { width: 230; background: var(--bg-primary); border-right: 1 var(--divider); padding: 18 10; gap: 4; }\n"
