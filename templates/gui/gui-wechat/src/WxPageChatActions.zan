using System;

// Controls own callbacks; callbacks borrow the page and pin it only while invoked.
class WxPageChatActions {
    public weak WxPageChat owner;

    public void History() {
        WxPageChat page = owner;
        if (page == null || page.app == null || page.current < 0
                || page.current >= page.data.Count) { return; }
        WxHistoryWindow.Open(page.app, page.data[page.current]);
    }
    public void ToggleDrawer() { WxPageChat page = owner; if (page != null) { page.ToggleDrawer(); } }
    public void Send() { WxPageChat page = owner; if (page != null) { page.Send(); } }
    public void StartGroup() {
        WxPageChat page = owner;
        if (page != null && page.app != null) { WxCreateGroupWindow.Open(page.app, this.OpenConv); }
    }
    public void OpenConv(string id, string title) {
        WxPageChat page = owner;
        if (page != null) { page.OpenConv(id, title); }
    }
    public void Select() { WxPageChat page = owner; if (page != null) { page.Select(page.list.SelectedIndex()); } }
    public void Type(string text) { WxPageChat page = owner; if (page != null) { page.Type(text); } }
    public void Clear() { WxPageChat page = owner; if (page != null) { page.ClearCurrent(); } }
    public void ShowProfile(string name, string initial, string tint) {
        WxPageChat page = owner;
        if (page != null) { page.ShowProfile(name, initial, tint); }
    }
    public void OpenMsgProfile(int index) { WxPageChat page = owner; if (page != null) { page.OpenMsgProfile(index); } }
    public void OpenBubbleMenu(int index, string text) {
        WxPageChat page = owner;
        if (page != null) { page.OpenBubbleMenu(index, text); }
    }
    public void OpenTaskCard(int index, string text) { WxPageChat page = owner; if (page != null) { page.OpenTaskCard(index); } }
    public void ShowEmoji() { WxPageChat page = owner; if (page != null) { page.ShowPopup(page.emoPanel.Root()); } }
    public void ShowAvatar() { WxPageChat page = owner; if (page != null) { page.ShowPopup(page.avaPanel.Root()); } }
    public void PickAttach() { WxPageChat page = owner; if (page != null) { page.PickAttach(); } }
    public void Detach(int index) { WxPageChat page = owner; if (page != null) { page.Detach(index); } }
    public void OnPicked() { WxPageChat page = owner; if (page != null) { page.OnPicked(); } }
}
