using System;
using System.Collections.Generic;
using System.Json;
using Gui;
using Gui.Backend;
using Gui.Component;
using Gui.Widget;

public class WxNotifyRowViewModel {
    public string id = "";
    public string title = "";
    public string content = "";
    public string time = "";
    public bool unread = false;
}

public class WxNotifyViewModel {
    public string title = "全部";
    public string keyword = "";
    public bool empty = false;
    public bool showGoWork = false;
    public string footText = "";
    public List<WxNotifyRowViewModel> items = new List<WxNotifyRowViewModel>();
}

public class WxPageNotify : Control {
    ModelBinder binder;
    public WxNotifyViewModel model;
    App host;
    ListView<string> filters;
    List<string> names;
    List<WxNotifyItem> all;
    int cur;
    public Badge badge;
    public Action onGoWork;

    public WxPageNotify() {
        this.InitControl("wxPageNotify", 5);
        this.Class = "wxmain";
        names = new List<string>();
        names.Add("全部");
        names.Add("未读");
        names.Add("派工");
        names.Add("提及");
        all = new List<WxNotifyItem>();
        cur = 0;
        model = new WxNotifyViewModel();
    }

    public void Build(App app) {
        this.host = app;
        Control ui = app.LoadHtmlWith(Form.ReadDoc("src/WxPageNotify.html"), null, "");
        if (ui == null) { return; }
        ui.DockFill();
        this.Add(ui);

        Control filterHost = ui.Find("NotifyFilterHost");
        if (filterHost != null) {
            filters = new ListView<string>(WxFilterRow.Of);
            filters.Class = "wxlist grow";
            filters.Bind(names);
            filters.OnSelect(() => { this.SwitchTab(filters.SelectedIndex()); });
            filterHost.Add(filters);
        }

        binder = new ModelBinder();
        binder.Handle("notify-readall", () => { this.ReadAll(); });
        binder.Handle("notify-search", () => { this.Refilter(); });
        binder.Handle("notify-work", () => {
            if (this.onGoWork != null) { this.onGoWork(); }
        });
        binder.HandleSender("notify-open", (Control c) => { this.OpenRow(c); });
        binder.SetRoot(ui, model);
        binder.Wire();
        ModelHosts.Register(app, binder);
    }

    public void OnShow() {
        this.Load();
    }

    public void Beat() {
        if (!WxNet.LoggedIn()) { return; }
        WxNetReq r = WxNet.NewReq();
        WxNet.ApiGet(r, "/api/notify/unread", () => {
            try {
                if (!WxNet.OkOf(r)) { return; }
                WxNet.ParseData(r, (JsonDoc doc, int d) => {
                    this.SetBadge((int)doc.Long(d, "count", 0L));
                });
            } catch (Exception ex) { }
        });
    }

    public void Load() {
        if (!WxNet.LoggedIn()) { return; }
        WxNetReq r = WxNet.NewReq();
        WxNet.ApiGet(r, "/api/notify/items?limit=100", () => {
            try {
                if (!WxNet.OkOf(r)) {
                    this.Foot("加载失败：" + WxNet.ErrOf(r));
                    return;
                }
                WxNet.ParseData(r, (JsonDoc doc, int d) => {
                    all.Clear();
                    int items = doc.Get(d, "items");
                    int n = (items >= 0 && doc.KindAt(items) == 4) ? doc.Count(items) : 0;
                    for (int i = 0; i < n; i = i + 1) {
                        all.Add(WxNotifyItem.FromDoc(doc, doc.At(items, i)));
                    }
                    this.SetBadge((int)doc.Long(d, "unread", 0L));
                    this.Refilter();
                });
            } catch (Exception ex) { this.Foot(ex.Message); }
        });
    }

    public void SwitchTab(int i) {
        if (i < 0 || i >= names.Count) { i = 0; }
        cur = i;
        this.Refilter();
    }

    public void Refilter() {
        string kw = model.keyword == null ? "" : model.keyword.Trim();
        List<WxNotifyRowViewModel> arr = new List<WxNotifyRowViewModel>();
        int n = 0;
        for (int k = 0; k < all.Count; k = k + 1) {
            WxNotifyItem it = all[k];
            if (!this.Hit(cur, it)) { continue; }
            if (kw != "" && it.title.IndexOf(kw) < 0
                && it.content.IndexOf(kw) < 0) { continue; }
            WxNotifyRowViewModel o = new WxNotifyRowViewModel();
            o.id = it.id;
            o.title = it.title;
            o.content = it.content;
            o.time = WxIm.ClockOf(it.at);
            o.unread = it.unread;
            arr.Add(o);
            n = n + 1;
        }
        model.items = arr;
        model.empty = n == 0;
        model.title = names[cur] + "（" + n.ToString() + "）";
        if (binder != null) { binder.MarkDirty(); }
        this.Redraw();
    }

    public bool Hit(int tab, WxNotifyItem it) {
        if (it == null) { return false; }
        if (tab == 1) { return it.unread; }
        if (tab == 2) { return it.kind == "assign"; }
        if (tab == 3) { return it.kind == "mention"; }
        return true;
    }

    public void OpenRow(Control c) {
        if (binder == null || c == null) { return; }
        object scope = binder.ScopeOf(c);
        if (scope == null) { return; }
        string rowId = "";
        if (scope is WxNotifyRowViewModel) {
            rowId = ((WxNotifyRowViewModel)scope).id;
        }
        if (rowId.Length == 0) { return; }
        WxNotifyItem it = this.FindById(rowId);
        if (it == null) { return; }
        this.ShowDetail(it);
        if (!it.unread) { return; }
        WxNetReq r = WxNet.NewReq();
        WxNet.ApiPost(r, "/api/notify/read", "id=" + it.id, () => {
            try {
                if (!WxNet.OkOf(r)) { return; }
                WxNet.ParseData(r, (JsonDoc doc, int d) => {
                    if (it != null) { it.unread = false; }
                    this.SetBadge((int)doc.Long(d, "unread", 0L));
                    this.Refilter();
                });
            } catch (Exception ex) { this.Foot(ex.Message); }
        });
    }

    public WxNotifyItem FindById(string id) {
        if (id == "") { return null; }
        for (int i = 0; i < all.Count; i = i + 1) {
            if (all[i].id == id) { return all[i]; }
        }
        return null;
    }

    public void ReadAll() {
        WxNetReq r = WxNet.NewReq();
        WxNet.ApiPost(r, "/api/notify/read", "id=0", () => {
            try {
                if (!WxNet.OkOf(r)) {
                    this.Foot("标记失败：" + WxNet.ErrOf(r));
                    return;
                }
                for (int i = 0; i < all.Count; i = i + 1) {
                    all[i].unread = false;
                }
                this.SetBadge(0);
                this.Refilter();
                this.Foot("已全部标记为已读");
            } catch (Exception ex) { this.Foot(ex.Message); }
        });
    }

    public void ShowDetail(WxNotifyItem it) {
        model.footText = it.content;
        model.showGoWork = it.module == "flow" && this.onGoWork != null;
        if (binder != null) { binder.MarkDirty(); }
        this.Redraw();
    }

    public void Foot(string msg) {
        model.footText = msg;
        if (binder != null) { binder.MarkDirty(); }
        this.Redraw();
    }

    public void SetBadge(int n) {
        if (this.badge == null) { return; }
        this.badge.Count = n;
        this.badge.visible = n > 0;
        if (this.host != null && n > 0) { this.host.RequestRedraw(); }
    }

    public void Redraw() {
        if (this.host != null) { this.host.RequestRedraw(); }
    }

    public override string Kind() { return "WxPageNotify"; }
}
