using System;
using System.IO;
using System.Json;
using System.Text;
using Gui;
using Gui.Backend;
using Gui.Component;
using Gui.Widget;

public class WxPageWork : Control {
    ListView<string> tabs;
    ListView<WxWorkItem> list;
    // 标题行的计数是骨架文档里的元素（#WorkTitle）。
    Control titleEl;
    Control detailCol;
    // 右栏内容壳：代码构建的 dock 卡片，重建只清它，不动文档 div。
    // 懒建——首次开详情才挂进文档列（构造期不放，进场布局零差异）。
    Flex detailBody;
    Control detailHostCtrl;
    // 详情底部的状态行（错误 / 提示共用一行，随面板重建换引用）。
    Label statusLbl;

    List<WxWorkItem> mine;
    List<WxWorkItem> pool;
    List<WxWorkItem> accept;
    List<WxWorkItem> tpls;
    List<WxWorkItem> lifecycles;
    List<WxWorkItem> shown;
    // 当前 tab：0 我的待办 / 1 待认领 / 2 待我验收 / 3 模板 / 4 全链路项目。
    int tab;
    // 选中行（动作按钮的上下文：哪个 tab、哪个任务/模板）。
    WxWorkItem picked;
    // 我的数字 id（/api/auth/me 的 uid，登录后取一次）。
    string myId;
    // 部门表（flowtemplates 带回，模板编辑器选部门认领用）。
    List<WxDept> depts;
    // 联系人缓存（选负责人用，懒拉一次）。
    List<WxDept> contacts;

    public Action<string, string> onStartConv;

    WxPageWork() {
        this.InitControl("wxPageWork", 5);
        this.Class = "wxmain";
        mine = new List<WxWorkItem>();
        pool = new List<WxWorkItem>();
        accept = new List<WxWorkItem>();
        tpls = new List<WxWorkItem>();
        lifecycles = new List<WxWorkItem>();
        shown = new List<WxWorkItem>();
        depts = new List<WxDept>();
        contacts = new List<WxDept>();
        tab = 0;
        picked = null;
        myId = "";

        // ---- HTML 骨架（WeChatWork.html）：三栏，声明式事件与动态控件挂壳 ----
        HtmlHandlers hs = new HtmlHandlers();
        hs.Add("work-new", () => {
            try {
                if (this.tab == 4) {
                    this.CreateSampleLifecycleProject();
                } else {
                    editDefId = "0";
                    edName = "";
                    edDesc = "";
                    stages = new List<WxStageData>();
                    this.BuildEditor();
                }
            }
            catch (Exception ex) { this.Note(ex.Message); }
        });
        Control ui = WxPageWorkHtml.Build(hs);
        ui.DockFill();
        this.Add(ui);

        Control tabsHost = ui.Find("WorkTabsHost");
        if (tabsHost == null) { tabsHost = ui; }
        List<string> names = new List<string>();
        names.Add("我的待办");
        names.Add("待认领");
        names.Add("待我验收");
        names.Add("模板");
        names.Add("全链路项目");
        tabs = new ListView<string>(WxFilterRow.Of);
        tabs.Class = "wxlist grow";
        tabs.Bind(names);
        tabs.OnSelect(() => {
            try { this.SwitchTab(tabs.SelectedIndex()); }
            catch (Exception ex) { this.Note(ex.Message); }
        });
        tabsHost.Add(tabs);

        Control listHost = ui.Find("WorkListHost");
        if (listHost == null) { listHost = ui; }
        list = new ListView<WxWorkItem>(WxWorkRow.Of);
        list.Class = "wxlist grow";
        list.OnSelect(() => {
            try { this.OpenRow(list.SelectedIndex()); }
            catch (Exception ex) { this.Note(ex.Message); }
        });
        listHost.Add(list);

        titleEl = ui.Find("WorkTitle");
        detailCol = ui.Find("WorkDetail");
        Control detailHost = ui.Find("WorkDetailHost");
        if (detailHost == null) { detailHost = ui; }
        detailBody = Flex.Column();
        detailBody.name = "wxworkdetail";
        detailBody.AddClass("grow");
        detailHost.Add(detailBody);

        this.SwitchTab(0);
    }

    void RequestRedrawHost() {
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }

    // 每次切到本页都重拉（App.Pick(4) 调）——工作流状态是别人也在推
    // 进的数据，进页面就是最新的；顺带补 me（登录后第一次进页才有）。
    void OnShow() {
        if (!WxNet.LoggedIn()) { return; }
        if (myId.Length == 0) {
            WxNetReq mr = WxNet.NewReq();
            WxNet.ApiGet(mr, "/api/auth/me", () => {
                try {
                    // 应答里没有 data 节点时 DataOf 返回 null——先存局部量再判空。
                    JsonValue mrData = WxNet.DataOf(mr);
                    if (WxNet.OkOf(mr) && mrData != null) {
                        myId = mrData.Str("uid", "0");
                        // 详情「发起人」按注册表解析人名，联系人端点
                        // 不含自己——把自己的显示名补登记（幂等）。
                        if (myId.Length > 0 && myId != "0") {
                            WxData.WhoOnce("u:" + myId, WxNet.Account(),
                                StyledText.Initial(WxNet.Account()));
                        }
                    }
                } catch (Exception ex) { this.Note(ex.Message); }
                this.LoadAll();
            });
            return;
        }
        this.LoadAll();
    }

    // 重拉三态待办 + 模板（+ 部门表，编辑器用）。
    void LoadAll() {
        WxNetReq a = WxNet.NewReq();
        WxNet.ApiGet(a, "/api/flow/flowmine", () => {
            try {
                mine.Clear();
                pool.Clear();
                accept.Clear();
                JsonValue aData = WxNet.DataOf(a);
                if (WxNet.OkOf(a) && aData != null) {
                    this.Fill(mine, aData.Get("mine"), 0);
                    this.Fill(pool, aData.Get("pool"), 0);
                    this.Fill(accept, aData.Get("accept"), 0);
                }
            } catch (Exception ex) { this.Note(ex.Message); }
            this.LoadTpls();
        });
    }

    void LoadTpls() {
        WxNetReq b = WxNet.NewReq();
        WxNet.ApiGet(b, "/api/flow/flowtemplates", () => {
            try {
                tpls.Clear();
                depts.Clear();
                JsonValue bData = WxNet.DataOf(b);
                if (WxNet.OkOf(b) && bData != null) {
                    this.Fill(tpls, bData.Get("defs"), 1);
                    JsonValue ds = bData.Get("depts");
                    int dn = ds == null ? 0 : ds.Count();
                    for (int i = 0; i < dn; i = i + 1) {
                        depts.Add(WxDept.Of(ds.At(i).Str("id", ""),
                            ds.At(i).Str("name", "")));
                    }
                }
            } catch (Exception ex) { this.Note(ex.Message); }
            this.LoadLifecycleProjects();
        });
    }

    void LoadLifecycleProjects() {
        WxNetReq c = WxNet.NewReq();
        WxNet.ApiGet(c, "/api/lifecycle/projects", () => {
            try {
                lifecycles.Clear();
                JsonValue cData = WxNet.DataOf(c);
                if (WxNet.OkOf(c) && cData != null) {
                    this.Fill(lifecycles, cData.Get("projects"), 2);
                }
            } catch (Exception ex) { this.Note(ex.Message); }
            this.Rebind();
        });
    }

    // 行数组 → 模型（kind 0 任务行 / 1 模板行 / 2 全生命周期项目）。
    void Fill(List<WxWorkItem> into, JsonValue rows, int kind) {
        int n = rows == null ? 0 : rows.Count();
        for (int i = 0; i < n; i = i + 1) {
            into.Add(WxWorkItem.Of(rows.At(i), kind));
        }
    }

    // 列表重绑 + 标题计数。重绑清滚动缓存与选中——详情凭 picked 的
    // 上下文重建，不依赖 ListView 的选中态。
    void Rebind() {
        if (tab == 0) { shown = mine; }
        else if (tab == 1) { shown = pool; }
        else if (tab == 2) { shown = accept; }
        else if (tab == 3) { shown = tpls; }
        else { shown = lifecycles; }
        string label = tab == 0 ? "我的待办" : tab == 1 ? "待认领"
            : tab == 2 ? "待我验收" : tab == 3 ? "模板" : "全链路项目";
        if (titleEl != null) {
            titleEl.SetProp("text", label
                + "（" + Convert.ToString(shown.Count) + "）");
        }
        list.Bind(shown);
    }

    void SwitchTab(int i) {
        if (i < 0 || i > 4) { i = 0; }
        tab = i;
        this.CloseDetail();
        this.Rebind();
    }

    void OpenRow(int idx) {
        if (idx < 0 || idx >= shown.Count) { return; }
        picked = shown[idx];
        if (picked.kind == 2) { this.FetchLifecycleDetail(picked.id); }
        else if (picked.kind == 1) { this.FetchTemplate(picked.id); }
        else { this.FetchInst(picked.instId); }
    }

    void FetchInst(string instId) {
        WxNetReq r = WxNet.NewReq();
        WxNet.ApiGet(r, "/api/flow/flowinst?id="
            + Encoding.UrlEncode(instId), () => {
                try {
                    if (!WxNet.OkOf(r) || WxNet.DataOf(r) == null) {
                        this.Note("详情拉取失败：" + WxNet.ErrOf(r));
                        return;
                    }
                    this.BuildInstPanelDetail(WxFlowInstDetail.FromJson(WxNet.DataOf(r)));
                } catch (Exception ex) { this.Note(ex.Message); }
            });
    }

    void FetchTemplate(string id) {
        WxNetReq r = WxNet.NewReq();
        WxNet.ApiGet(r, "/api/flow/flowtemplate?id="
            + Encoding.UrlEncode(id), () => {
                try {
                    if (!WxNet.OkOf(r) || WxNet.DataOf(r) == null) {
                        this.Note("模板拉取失败：" + WxNet.ErrOf(r));
                        return;
                    }
                    this.BuildTplPanelDetail(WxFlowDefDetail.FromJson(WxNet.DataOf(r)));
                } catch (Exception ex) { this.Note(ex.Message); }
            });
    }

    // 右栏内容壳懒建（首次开详情才挂；构造期不碰文档列）。
    void EnsureDetailBody() {
        if (detailBody != null) { return; }
        detailBody = Flex.Column();
        detailBody.name = "wxworkcard";
        detailBody.AddClass("grow");
        detailHostCtrl.Add(detailBody);
    }

    void CloseDetail() {
        picked = null;
        if (detailCol != null) { detailCol.visible = false; }
        if (detailBody != null) { detailBody.RemoveAll(); }
        statusLbl = null;
    }

    // 统一 POST：成功重拉全部（详情凭 picked 上下文重开），失败就地
    // 状态行红字。
    void Act(string path, string body) {
        WxNetReq r = WxNet.NewReq();
        WxNet.ApiPost(r, path, body, () => {
            try {
                if (!WxNet.OkOf(r)) {
                    this.Note(WxNet.ErrOf(r));
                    return;
                }
                this.LoadAll();
            } catch (Exception ex) { this.Note(ex.Message); }
        });
    }

    // 状态行提示（面板没开着就丢弃——下一拍刷新会带回面板）。
    void Note(string msg) {
        if (statusLbl == null) { return; }
        statusLbl.Text = msg;
        this.RequestRedrawHost();
    }

    // 右栏卡片头：标题 + 关闭钮；返回卡片本体（dock 容器，head 顶 /
    // body 填），调用方往 body 里续内容。
    Flex CardHead(string title, Flex into) {
        Flex head = Wx.Row("wxphead");
        Flex ht = Flex.Column();
        ht.AddClass("grow");
        ht.Grow();
        ht.Add(Wx.Lbl(title, "wxpname"));
        head.Add(ht);
        Button close = Wx.IconBtn("dots");
        close.OnClick(() => { this.CloseDetail(); });
        head.Add(close);
        into.Add(head);
        into.Add(Wx.Line());
        Flex body = Wx.ColGrow("wxpbody");
        into.Add(body);
        return body;
    }

    // 摆一个动作钮。
    void ActBtn(Flex body, string label, Action fire) {
        Button b = new Button(label);
        b.OnClick(() => {
            try { fire(); }
            catch (Exception ex) { this.Note(ex.Message); }
        });
        body.Add(b);
    }

    /* ---- 形态一：流程实例详情 ---- */

    void BuildInstPanelDetail(WxFlowInstDetail d) {
        this.EnsureDetailBody();
        detailBody.RemoveAll();
        statusLbl = null;

        Flex card = Flex.Column();
        card.name = "wxworkcard";
        card.AddClass("grow");
        Flex body = this.CardHead(d.title, card);
        int st = d.status;
        body.Add(Wx.Lbl(WxPageWork.InstZh(st) + " · 流程 "
            + d.defName + " · 发起 "
            + d.startedByName, "wxpsub"));

        // 节点链：顺序环节 + 最新一次任务状态。
        int nn = d.nodes != null ? d.nodes.Count : 0;
        body.Add(Wx.Line());
        for (int i = 0; i < nn; i = i + 1) {
            WxFlowNodeItem n = d.nodes[i];
            string line = Convert.ToString(i + 1) + ". " + n.name;
            int tn = n.tasks != null ? n.tasks.Count : 0;
            if (tn > 0) {
                WxFlowTaskItem t = n.tasks[tn - 1];
                line = line + " —— " + WxPageWork.TaskZh(t.status);
                string who = WxTaskSheet.Who(t.assignUserId);
                if (who != "-") { line = line + " · " + who; }
                string res = t.result;
                if (res.Length > 0 && t.status == 3) {
                    line = line + "：" + res;
                }
            } else {
                line = line + " —— 未开始";
            }
            body.Add(Wx.Lbl(line, "wxpval"));
        }

        // 动作区：按选中行的上下文（tab × 任务状态 × 发起人）摆钮。
        body.Add(Wx.Line());
        Input noteIn = new Input("汇报 / 驳回理由（动作要填的写这里）");
        body.Add(noteIn);
        Switch repool = new Switch();
        Flex pr = Wx.Row("");
        pr.Add(Wx.Lbl("驳回后回部门池重新认领", "wxpsub grow"));
        pr.Add(repool);
        body.Add(pr);
        if (picked != null && st == 1) {
            if (tab == 0 && picked.status == "0") {
                this.ActBtn(body, "完成并提交", () => {
                    this.Act("/api/flow/flowsubmit",
                        "taskId=" + picked.taskId + "&report="
                        + Encoding.UrlEncode(noteIn.GetText()));
                });
            }
            if (tab == 1 && picked.status == "0") {
                this.ActBtn(body, "认领", () => {
                    this.Act("/api/flow/flowclaim",
                        "taskId=" + picked.taskId);
                });
            }
            if (tab == 2 && picked.status == "3") {
                this.ActBtn(body, "验收通过", () => {
                    this.Act("/api/flow/flowaccept",
                        "taskId=" + picked.taskId);
                });
                this.ActBtn(body, "驳回重来", () => {
                    this.Act("/api/flow/flowreject",
                        "taskId=" + picked.taskId + "&reason="
                        + Encoding.UrlEncode(noteIn.GetText())
                        + "&repool=" + (repool.IsOn() ? "1" : "0"));
                });
            }
            if (d.startedBy == myId) {
                this.ActBtn(body, "终止流程", () => {
                    this.Act("/api/flow/flowcancel",
                        "instId=" + picked.instId);
                });
            }
        }
        if (st != 1) {
            body.Add(Wx.Lbl("流程已结束（"
                + WxPageWork.InstZh(st) + "）", "wxemotitle"));
        }

        // 流水（最近 12 条，升序取尾段倒着摆，最新在上）。
        body.Add(Wx.Line());
        body.Add(Wx.Lbl("动态", "wxemotitle"));
        int ln = d.logs != null ? d.logs.Count : 0;
        int from = ln > 12 ? ln - 12 : 0;
        for (int i = ln - 1; i >= from; i = i - 1) {
            WxFlowLogItem e = d.logs[i];
            body.Add(Wx.Lbl(e.content + " · "
                + e.userName + " · "
                + WxIm.ClockOf(e.at), "wxpsub"));
        }
        if (ln == 0) { body.Add(Wx.Lbl("暂无动态", "wxpsub")); }

        statusLbl = Wx.Lbl("", "wxpsub");
        body.Add(statusLbl);
        detailBody.Add(card);

        if (detailCol != null) { detailCol.visible = true; }
        this.RequestRedrawHost();
    }

    void BuildInstPanel(JsonValue d) {
        this.BuildInstPanelDetail(WxFlowInstDetail.FromJson(d));
    }

    /* ---- 形态二：模板详情 + 发起 ---- */

    void BuildTplPanelDetail(WxFlowDefDetail d) {
        this.EnsureDetailBody();
        detailBody.RemoveAll();
        statusLbl = null;

        Flex card = Flex.Column();
        card.name = "wxworkcard";
        card.AddClass("grow");
        Flex body = this.CardHead(d.name, card);
        string desc = d.description;
        body.Add(Wx.Lbl("流程模板 · "
            + (desc.Length > 0 ? desc : "（无描述）"), "wxpsub"));
        int nn = d.nodes != null ? d.nodes.Count : 0;
        body.Add(Wx.Line());
        for (int i = 0; i < nn; i = i + 1) {
            WxFlowNodeItem n = d.nodes[i];
            string line = Convert.ToString(i + 1) + ". " + n.name;
            string uid = n.assignUserId;
            if (uid != "0") {
                line = line + " · " + WxTaskSheet.Who(uid);
            } else {
                line = line + " · 部门认领";
            }
            body.Add(Wx.Lbl(line, "wxpval"));
        }

        body.Add(Wx.Line());
        Input title = new Input("实例标题（必填）");
        body.Add(title);
        this.ActBtn(body, "发起流程", () => {
            string t = title.GetText();
            if (t.Length == 0) {
                this.Note("标题不能为空");
                return;
            }
            this.SwitchTab(0);
            this.Act("/api/flow/flowstart",
                "defId=" + d.id + "&title="
                + Encoding.UrlEncode(t));
        });
        this.ActBtn(body, "编辑模板", () => { this.EditTemplateDetail(d); });

        statusLbl = Wx.Lbl("", "wxpsub");
        body.Add(statusLbl);
        detailBody.Add(card);

        if (detailCol != null) { detailCol.visible = true; }
        this.RequestRedrawHost();
    }

    void BuildTplPanel(JsonValue d) {
        this.BuildTplPanelDetail(WxFlowDefDetail.FromJson(d));
    }

    /* ---- 形态三：模板编辑器（新建 / 复用改造）----
       状态全在数据侧（edName/edDesc/stages），每次增删/选人先
       SaveEditorState 把输入框里的字收回去再整卡重建——重建不丢字。
       回调里抛异常会带崩进程（见类注），故每个回调体都有守卫。 */

    string edName = "";
    string edDesc = "";
    string editDefId = "0";
    List<WxStageData> stages;
    Flex stageBox;
    Input eName;
    Input eDesc;
    // 编辑中的行控件（与 stages 一一对应，只活在两次重建之间）。
    List<WxStageRow> stageRows;

    void BuildEditor() {
        this.EnsureDetailBody();
        detailBody.RemoveAll();
        statusLbl = null;
        stageRows = new List<WxStageRow>();

        Flex card = Flex.Column();
        card.name = "wxworkcard";
        card.AddClass("grow");
        Flex body = this.CardHead(editDefId == "0" ? "新建模板"
            : "编辑模板", card);
        body.Add(Wx.Lbl("环节按从上到下依次流转；不指派人的环节由所选"
            + "部门整队认领。", "wxpsub"));
        eName = new Input("流程名称（必填）");
        if (edName.Length > 0) { eName.SetText(edName); }
        body.Add(eName);
        eDesc = new Input("描述（选填）");
        if (edDesc.Length > 0) { eDesc.SetText(edDesc); }
        body.Add(eDesc);
        stageBox = Flex.Column();
        body.Add(stageBox);
        for (int i = 0; i < stages.Count; i = i + 1) {
            this.AddStageRow(stages[i]);
        }

        this.ActBtn(body, "+ 添加环节", () => {
            this.SaveEditorState();
            stages.Add(new WxStageData());
            this.BuildEditor();
        });
        this.ActBtn(body, "保存模板", () => { this.SaveTpl(); });
        statusLbl = Wx.Lbl("", "wxpsub");
        body.Add(statusLbl);
        detailBody.Add(card);

        if (detailCol != null) { detailCol.visible = true; }
        this.RequestRedrawHost();
    }

    WxStageRow AddStageRow(WxStageData data) {
        WxStageRow r = new WxStageRow();
        r.data = data;
        r.row = Wx.Row("");
        r.name = new Input("环节名称");
        r.name.Class = "grow";
        if (data.name.Length > 0) { r.name.SetText(data.name); }
        r.row.Add(r.name);
        r.pick = new Button(data.who);
        r.pick.Class = "text small";
        WxStageRow captured = r;
        r.pick.OnClick(() => { this.BeginPickFor(captured); });
        r.row.Add(r.pick);
        r.del = new Button("删");
        r.del.Class = "text small";
        r.del.OnClick(() => {
            this.SaveEditorState();
            stages.Remove(captured.data);
            this.BuildEditor();
        });
        r.row.Add(r.del);
        stageRows.Add(r);
        stageBox.Add(r.row);
        return r;
    }

    // 把两根输入框与各环节名的现值收回数据侧（重建前必调）。
    void SaveEditorState() {
        if (eName != null) { edName = eName.GetText(); }
        if (eDesc != null) { edDesc = eDesc.GetText(); }
        for (int i = 0; i < stageRows.Count; i = i + 1) {
            stageRows[i].data.name = stageRows[i].name.GetText();
        }
    }

    void SaveTpl() {
        this.SaveEditorState();
        if (edName.Length == 0) {
            this.Note("名称不能为空");
            return;
        }
        if (stages.Count == 0) {
            this.Note("至少一个环节");
            return;
        }
        string nodes = "[";
        for (int i = 0; i < stages.Count; i = i + 1) {
            WxStageData d = stages[i];
            if (d.name.Length == 0) {
                this.Note("第 " + Convert.ToString(i + 1) + " 个环节缺名称");
                return;
            }
            if (i > 0) { nodes = nodes + ","; }
            nodes = nodes + "{\"name\":\""
                + Encoding.UrlEncode(d.name) + "\",\"assignUserId\":\""
                + d.userId + "\",\"deptId\":\"" + d.deptId + "\"}";
        }
        nodes = nodes + "]";
        WxNetReq r2 = WxNet.NewReq();
        WxNet.ApiPost(r2, "/api/flow/flowsave",
            "id=" + editDefId
            + "&name=" + Encoding.UrlEncode(edName)
            + "&description=" + Encoding.UrlEncode(edDesc)
            + "&nodes=" + nodes
            + "&clientRequestId=" + WxIm.NextCrid(), () => {
                try {
                    if (!WxNet.OkOf(r2)) {
                        this.Note(WxNet.ErrOf(r2));
                        return;
                    }
                    this.CloseDetail();
                    this.LoadAll();
                } catch (Exception ex) { this.Note(ex.Message); }
            });
    }

    /* ---- 形态四：选负责人（联系人直派 或 部门整队认领）---- */

    WxStageData picking;

    void BeginPickFor(WxStageRow row) {
        this.SaveEditorState();
        picking = row.data;
        if (contacts.Count > 0) { this.BuildPickPanel(); return; }
        WxNetReq r = WxNet.NewReq();
        WxNet.Get(r, "contacts", () => {
            try {
                JsonValue rData = WxNet.DataOf(r);
                if (!WxNet.OkOf(r) || rData == null) {
                    this.Note("联系人拉取失败：" + WxNet.ErrOf(r));
                    return;
                }
                JsonValue items = rData.Get("contacts");
                int n = items == null ? 0 : items.Count();
                for (int i = 0; i < n; i = i + 1) {
                    contacts.Add(WxDept.Of(items.At(i).Str("id", "0"),
                        items.At(i).Str("name", "?")));
                }
                this.BuildPickPanel();
            } catch (Exception ex) { this.Note(ex.Message); }
        });
    }

    void BuildPickPanel() {
        this.EnsureDetailBody();
        detailBody.RemoveAll();
        statusLbl = null;

        Flex card = Flex.Column();
        card.name = "wxworkcard";
        card.AddClass("grow");
        Flex body = this.CardHead("环节负责人", card);
        body.Add(Wx.Lbl("指定人直派本环节；部门则整队进认领池。", "wxpsub"));
        body.Add(Wx.Line());
        for (int i = 0; i < contacts.Count; i = i + 1) {
            WxDept c = contacts[i];
            Button b = new Button(c.name);
            b.Class = "text small";
            b.OnClick(() => {
                picking.userId = c.id;
                picking.deptId = "0";
                picking.who = c.name;
                this.BuildEditor();
            });
            body.Add(b);
        }
        for (int i = 0; i < depts.Count; i = i + 1) {
            WxDept dp = depts[i];
            Button b = new Button("部门池：" + dp.name);
            b.Class = "text small";
            b.OnClick(() => {
                picking.userId = "0";
                picking.deptId = dp.id;
                picking.who = "部门池：" + dp.name;
                this.BuildEditor();
            });
            body.Add(b);
        }
        Button back = new Button("返回编辑");
        back.Class = "text small";
        back.OnClick(() => { this.BuildEditor(); });
        body.Add(back);
        statusLbl = Wx.Lbl("", "wxpsub");
        body.Add(statusLbl);
        detailBody.Add(card);
        this.RequestRedrawHost();
    }

    // 模板详情卡里的「编辑」入口：强类型实体喂进编辑器状态。
    void EditTemplateDetail(WxFlowDefDetail d) {
        editDefId = d.id;
        edName = d.name;
        edDesc = d.description;
        stages = new List<WxStageData>();
        int nn = d.nodes != null ? d.nodes.Count : 0;
        for (int i = 0; i < nn; i = i + 1) {
            WxFlowNodeItem n = d.nodes[i];
            WxStageData sd = new WxStageData();
            sd.name = n.name;
            sd.userId = n.assignUserId;
            sd.deptId = n.deptId;
            if (sd.userId != "0") {
                sd.who = WxTaskSheet.Who(sd.userId);
            } else if (sd.deptId != "0") {
                sd.who = this.DeptName(sd.deptId);
            }
            stages.Add(sd);
        }
        this.BuildEditor();
    }

    string DeptName(string id) {
        for (int i = 0; i < depts.Count; i = i + 1) {
            if (depts[i].id == id) { return "部门池：" + depts[i].name; }
        }
        return "部门认领";
    }

    /* ---- 形态三：全生命周期项目作战面板 (选品-生产-上架-推广-优化) ---- */

    public void OpenLifecycleProject(string projectId) {
        this.SwitchTab(4);
        if (tabs != null) { tabs.SelectIndex(4); }
        this.FetchLifecycleDetail(projectId);
    }

    void FetchLifecycleDetail(string projectId) {
        WxNetReq r = WxNet.NewReq();
        WxNet.ApiGet(r, "/api/lifecycle/detail?projectId="
            + Encoding.UrlEncode(projectId), () => {
                try {
                    if (!WxNet.OkOf(r) || WxNet.DataOf(r) == null) {
                        this.Note("项目详情拉取失败：" + WxNet.ErrOf(r));
                        return;
                    }
                    this.BuildLifecycleDetail(WxNet.DataOf(r));
                } catch (Exception ex) { this.Note(ex.Message); }
            });
    }

    void BuildLifecycleDetail(JsonValue d) {
        this.EnsureDetailBody();
        detailBody.RemoveAll();
        statusLbl = null;

        Flex card = Flex.Column();
        card.name = "wxworkcard";
        card.AddClass("grow");
        string pName = d.Str("name", "全生命周期项目");
        Flex body = this.CardHead(pName, card);

        string pId = d.Str("id", "");
        string pNo = d.Str("projectNo", "");
        string pCat = d.Str("category", "");
        string pOwner = d.Str("ownerName", "");
        string pStageName = d.Str("currentStageName", "");
        string pGmv = d.Str("targetGmv", "0");
        string pRoi = d.Str("targetRoi", "0");
        string actGmv = d.Str("actualGmv", "0");
        string actRoi = d.Str("actualRoi", "0");
        string convId = d.Str("conversationId", "0");

        body.Add(Wx.Lbl("编号: " + pNo + " · 品类: " + pCat + " · 操盘总负责人: " + pOwner, "wxpsub"));
        body.Add(Wx.Lbl("当前阶段: " + pStageName + " | 目标GMV: ¥" + pGmv + " | 目标ROI: " + pRoi, "wxfavname"));
        if (actGmv != "0" || actRoi != "0") {
            body.Add(Wx.Lbl("实际达成GMV: ¥" + actGmv + " | 实际达成ROI: " + actRoi, "wxworksub"));
        }

        Flex btnRow = Wx.Row("wxpactrow");
        if (convId != "0" && convId.Length > 0) {
            Button convBtn = new Button("进入项目协同作战群");
            convBtn.OnClick(() => {
                if (this.onStartConv != null) {
                    this.onStartConv(convId, "【作战群】" + pName);
                }
            });
            btnRow.Add(convBtn);
        }
        body.Add(btnRow);
        body.Add(Wx.Line());

        JsonValue nodes = d.Get("nodes");
        int count = nodes == null ? 0 : nodes.Count();
        for (int i = 0; i < count; i = i + 1) {
            JsonValue n = nodes.At(i);
            string st = n.Str("stage", "");
            string stName = n.Str("stageName", "");
            string rName = n.Str("responsibleName", "待指派");
            string aiRole = n.Str("aiAgentRole", "");
            string nStatus = n.Str("status", "pending");
            string aiAdvice = n.Str("aiSuggestion", "");
            string summary = n.Str("deliverableSummary", "");

            string statusZh = nStatus == "passed" ? "【已核准通过】"
                : (nStatus == "in_progress" ? "【正在推进中】"
                : (nStatus == "rejected" ? "【已驳回】" : "【待开始】"));

            body.Add(Wx.Lbl(stName + "  " + statusZh, "wxfavname"));
            body.Add(Wx.Lbl("人类第一责任人: " + rName + " | 专属协同角色: " + aiRole, "wxworksub"));

            if (aiAdvice.Length > 0) {
                body.Add(Wx.Lbl("AI 赋能建议: " + aiAdvice, "wxpsub"));
            }
            if (summary.Length > 0) {
                body.Add(Wx.Lbl("阶段成果/审核结论: " + summary, "wxpsub"));
            }

            if (nStatus == "in_progress") {
                Input sumIn = new Input("阶段成果核准意见/实绩说明（选填）");
                body.Add(sumIn);

                Flex actRow = Wx.Row("wxpactrow");
                Button advBtn = new Button("核准并推进下一阶段");
                advBtn.OnClick(() => {
                    string sTxt = sumIn.GetText();
                    if (sTxt.Length == 0) { sTxt = "阶段成果审核确认，推进至下一阶段"; }
                    this.AdvanceStage(pId, st, sTxt, "pass");
                });
                actRow.Add(advBtn);

                Button rejBtn = new Button("驳回此阶段成果");
                rejBtn.OnClick(() => {
                    string sTxt = sumIn.GetText();
                    if (sTxt.Length == 0) { sTxt = "阶段成果未达预期，驳回重修"; }
                    this.AdvanceStage(pId, st, sTxt, "reject");
                });
                actRow.Add(rejBtn);

                Button aiBtn = new Button("AI 深度推演与作战群同步");
                aiBtn.OnClick(() => {
                    this.TriggerAiAssist(pId, st, "深度多维数据复盘与风险对齐");
                });
                actRow.Add(aiBtn);
                body.Add(actRow);
            } else if (nStatus == "rejected") {
                Input sumIn = new Input("补充修改说明/重新提审备注（选填）");
                body.Add(sumIn);

                Flex actRow = Wx.Row("wxpactrow");
                Button reAdvBtn = new Button("重新核准并推进下一阶段");
                reAdvBtn.OnClick(() => {
                    string sTxt = sumIn.GetText();
                    if (sTxt.Length == 0) { sTxt = "修改材料已完善，重新核准通过"; }
                    this.AdvanceStage(pId, st, sTxt, "pass");
                });
                actRow.Add(reAdvBtn);

                Button aiBtn = new Button("AI 针对性优化推演");
                aiBtn.OnClick(() => {
                    this.TriggerAiAssist(pId, st, "针对驳回意见进行针对性优化推演与数据修复");
                });
                actRow.Add(aiBtn);
                body.Add(actRow);
            }
            body.Add(Wx.Line());
        }

        statusLbl = Wx.Lbl("", "wxpsub");
        body.Add(statusLbl);
        detailBody.Add(card);
        if (detailCol != null) { detailCol.visible = true; }
        this.RequestRedrawHost();
    }

    void AdvanceStage(string projectId, string stage, string summary, string action) {
        WxNetReq r = WxNet.NewReq();
        string body = "projectId=" + Encoding.UrlEncode(projectId)
            + "&stage=" + Encoding.UrlEncode(stage)
            + "&summary=" + Encoding.UrlEncode(summary)
            + "&action=" + Encoding.UrlEncode(action);
        WxNet.ApiPost(r, "/api/lifecycle/advance", body, () => {
            try {
                if (!WxNet.OkOf(r)) {
                    this.Note("推进失败：" + WxNet.ErrOf(r));
                    return;
                }
                this.FetchLifecycleDetail(projectId);
                this.LoadAll();
            } catch (Exception ex) { this.Note(ex.Message); }
        });
    }

    void TriggerAiAssist(string projectId, string stage, string prompt) {
        WxNetReq r = WxNet.NewReq();
        string body = "projectId=" + Encoding.UrlEncode(projectId)
            + "&stage=" + Encoding.UrlEncode(stage)
            + "&prompt=" + Encoding.UrlEncode(prompt);
        WxNet.ApiPost(r, "/api/lifecycle/aiassist", body, () => {
            try {
                if (!WxNet.OkOf(r)) {
                    this.Note("AI 辅助失败：" + WxNet.ErrOf(r));
                    return;
                }
                this.FetchLifecycleDetail(projectId);
            } catch (Exception ex) { this.Note(ex.Message); }
        });
    }

    void CreateSampleLifecycleProject() {
        this.CreateLifecycleProject("2026秋冬加绒休闲裤", "服装鞋包", "200000", "2.8");
    }

    void CreateLifecycleProject(string name, string category, string gmv, string roi) {
        WxNetReq r = WxNet.NewReq();
        string body = "name=" + Encoding.UrlEncode(name)
            + "&category=" + Encoding.UrlEncode(category)
            + "&targetGmv=" + Encoding.UrlEncode(gmv)
            + "&targetRoi=" + Encoding.UrlEncode(roi);
        WxNet.ApiPost(r, "/api/lifecycle/create", body, () => {
            try {
                if (!WxNet.OkOf(r)) {
                    this.Note("立项失败：" + WxNet.ErrOf(r));
                    return;
                }
                this.LoadAll();
            } catch (Exception ex) { this.Note(ex.Message); }
        });
    }

    override string Kind() { return "WxPageWork"; }

    /* ---- 词典 ---- */

    static string InstZh(int st) {
        if (st == 2) { return "已完成"; }
        if (st == 3) { return "已终止"; }
        return "进行中";
    }

    static string TaskTint(int st) {
        if (st == 3) { return "warning"; }
        if (st == 1) { return "success"; }
        return "info";
    }

    static string TaskZh(int st) {
        if (st == 0) { return "待处理"; }
        if (st == 1) { return "已完成"; }
        if (st == 2) { return "已跳过"; }
        if (st == 3) { return "待验收"; }
        return "未知";
    }
}
