using System;
using System.IO;
using System.Json;
using System.Text;
using Gui;
using Gui.Backend;
using Gui.Component;
using Gui.Widget;

public class WxPageWork : Control {
    ListView<string> tabs;
    ListView<WxWorkItem> list;
    // 标题行的计数是骨架文档里的元素（#WorkTitle）。
    Control titleEl;
    Control detailCol;
    // 右栏内容壳：代码构建的 dock 卡片，重建只清它，不动文档 div。
    // 懒建——首次开详情才挂进文档列（构造期不放，进场布局零差异）。
    Panel detailBody;
    Control detailHostCtrl;
    // 详情底部的状态行（错误 / 提示共用一行，随面板重建换引用）。
    Label statusLbl;

    List<WxWorkItem> mine;
    List<WxWorkItem> pool;
    List<WxWorkItem> accept;
    List<WxWorkItem> tpls;
    List<WxWorkItem> shown;
    // 当前 tab：0 我的待办 / 1 待认领 / 2 待我验收 / 3 模板。
    int tab;
    // 选中行（动作按钮的上下文：哪个 tab、哪个任务/模板）。
    WxWorkItem picked;
    // 我的数字 id（/api/auth/me 的 uid，登录后取一次）。
    string myId;
    // 部门表（flowtemplates 带回，模板编辑器选部门认领用）。
    List<WxDept> depts;
    // 联系人缓存（选负责人用，懒拉一次）。
    List<WxDept> contacts;

    WxPageWork() {
        this.InitControl("wxPageWork", 5);
        this.Class = "wxmain";
        mine = new List<WxWorkItem>();
        pool = new List<WxWorkItem>();
        accept = new List<WxWorkItem>();
        tpls = new List<WxWorkItem>();
        shown = new List<WxWorkItem>();
        depts = new List<WxDept>();
        contacts = new List<WxDept>();
        tab = 0;
        picked = null;
        myId = "";

        // ---- HTML 骨架（WeChatWork.html）：三栏，声明式事件与动态控件挂壳 ----
        HtmlHandlers hs = new HtmlHandlers();
        hs.Add("work-new", () => {
            try {
                editDefId = "0";
                edName = "";
                edDesc = "";
                stages = new List<WxStageData>();
                this.BuildEditor();
            }
            catch (Exception ex) { this.Note(ex.Message); }
        });
        Control ui = WxPageWorkHtml.Build(hs);
        ui.DockFill();
        this.Add(ui);

        Control tabsHost = ui.Find("WorkTabsHost");
        if (tabsHost == null) { tabsHost = ui; }
        List<string> names = new List<string>();
        names.Add("我的待办");
        names.Add("待认领");
        names.Add("待我验收");
        names.Add("模板");
        tabs = new ListView<string>(WxFilterRow.Of);
        tabs.Class = "wxlist grow";
        tabs.Bind(names);
        tabs.OnSelect(() => {
            try { this.SwitchTab(tabs.SelectedIndex()); }
            catch (Exception ex) { this.Note(ex.Message); }
        });
        tabsHost.Add(tabs);

        Control listHost = ui.Find("WorkListHost");
        if (listHost == null) { listHost = ui; }
        list = new ListView<WxWorkItem>(WxWorkRow.Of);
        list.Class = "wxlist grow";
        list.OnSelect(() => {
            try { this.OpenRow(list.SelectedIndex()); }
            catch (Exception ex) { this.Note(ex.Message); }
        });
        listHost.Add(list);

        titleEl = ui.Find("WorkTitle");
        detailCol = ui.Find("WorkDetail");
        Control detailHost = ui.Find("WorkDetailHost");
        if (detailHost == null) { detailHost = ui; }
        detailBody = Panel.Root("wxworkdetail");
        detailBody.Class = "grow";
        detailHost.Add(detailBody);

        this.SwitchTab(0);
    }

    void RequestRedrawHost() {
        App a = this.FindApp();
        if (a != null) { a.RequestRedraw(); }
    }

    // 每次切到本页都重拉（App.Pick(4) 调）——工作流状态是别人也在推
    // 进的数据，进页面就是最新的；顺带补 me（登录后第一次进页才有）。
    void OnShow() {
        if (!WxNet.LoggedIn()) { return; }
        if (myId.Length == 0) {
            WxNetReq mr = WxNet.NewReq();
            WxNet.ApiGet(mr, "/api/auth/me", () => {
                try {
                    if (WxNet.OkOf(mr) && WxNet.DataOf(mr) != null) {
                        myId = WxNet.DataOf(mr).Str("uid", "0");
                        // 详情「发起人」按注册表解析人名，联系人端点
                        // 不含自己——把自己的显示名补登记（幂等）。
                        if (myId.Length > 0 && myId != "0") {
                            WxData.WhoOnce("u:" + myId, WxNet.Account(),
                                StyledText.Initial(WxNet.Account()));
                        }
                    }
                } catch (Exception ex) { this.Note(ex.Message); }
                this.LoadAll();
            });
            return;
        }
        this.LoadAll();
    }

    // 重拉三态待办 + 模板（+ 部门表，编辑器用）。
    void LoadAll() {
        WxNetReq a = WxNet.NewReq();
        WxNet.ApiGet(a, "/api/flow/flowmine", () => {
            try {
                mine.Clear();
                pool.Clear();
                accept.Clear();
                if (WxNet.OkOf(a) && WxNet.DataOf(a) != null) {
                    this.Fill(mine, WxNet.DataOf(a).Get("mine"), 0);
                    this.Fill(pool, WxNet.DataOf(a).Get("pool"), 0);
                    this.Fill(accept, WxNet.DataOf(a).Get("accept"), 0);
                }
            } catch (Exception ex) { this.Note(ex.Message); }
            this.LoadTpls();
        });
    }

    void LoadTpls() {
        WxNetReq b = WxNet.NewReq();
        WxNet.ApiGet(b, "/api/flow/flowtemplates", () => {
            try {
                tpls.Clear();
                depts.Clear();
                if (WxNet.OkOf(b) && WxNet.DataOf(b) != null) {
                    JsonValue d = WxNet.DataOf(b);
                    this.Fill(tpls, d.Get("defs"), 1);
                    JsonValue ds = d.Get("depts");
                    int dn = ds == null ? 0 : ds.Count();
                    for (int i = 0; i < dn; i = i + 1) {
                        depts.Add(WxDept.Of(ds.At(i).Str("id", ""),
                            ds.At(i).Str("name", "")));
                    }
                }
            } catch (Exception ex) { this.Note(ex.Message); }
            this.Rebind();
        });
    }

    // 行数组 → 模型（kind 0 任务行 / 1 模板行）。
    void Fill(List<WxWorkItem> into, JsonValue rows, int kind) {
        int n = rows == null ? 0 : rows.Count();
        for (int i = 0; i < n; i = i + 1) {
            into.Add(WxWorkItem.Of(rows.At(i), kind));
        }
    }

    // 列表重绑 + 标题计数。重绑清滚动缓存与选中——详情凭 picked 的
    // 上下文重建，不依赖 ListView 的选中态。
    void Rebind() {
        if (tab == 0) { shown = mine; }
        else if (tab == 1) { shown = pool; }
        else if (tab == 2) { shown = accept; }
        else { shown = tpls; }
        string label = tab == 0 ? "我的待办" : tab == 1 ? "待认领"
            : tab == 2 ? "待我验收" : "模板";
        if (titleEl != null) {
            titleEl.SetProp("text", label
                + "（" + Convert.ToString(shown.Count) + "）");
        }
        list.Bind(shown);
    }

    void SwitchTab(int i) {
        if (i < 0 || i > 3) { i = 0; }
        tab = i;
        this.CloseDetail();
        this.Rebind();
    }

    void OpenRow(int idx) {
        if (idx < 0 || idx >= shown.Count) { return; }
        picked = shown[idx];
        if (picked.kind == 1) { this.FetchTemplate(picked.id); }
        else { this.FetchInst(picked.instId); }
    }

    void FetchInst(string instId) {
        WxNetReq r = WxNet.NewReq();
        WxNet.ApiGet(r, "/api/flow/flowinst?id="
            + Encoding.UrlEncode(instId), () => {
                try {
                    if (!WxNet.OkOf(r) || WxNet.DataOf(r) == null) {
                        this.Note("详情拉取失败：" + WxNet.ErrOf(r));
                        return;
                    }
                    this.BuildInstPanelDetail(WxFlowInstDetail.FromJson(WxNet.DataOf(r)));
                } catch (Exception ex) { this.Note(ex.Message); }
            });
    }

    void FetchTemplate(string id) {
        WxNetReq r = WxNet.NewReq();
        WxNet.ApiGet(r, "/api/flow/flowtemplate?id="
            + Encoding.UrlEncode(id), () => {
                try {
                    if (!WxNet.OkOf(r) || WxNet.DataOf(r) == null) {
                        this.Note("模板拉取失败：" + WxNet.ErrOf(r));
                        return;
                    }
                    this.BuildTplPanelDetail(WxFlowDefDetail.FromJson(WxNet.DataOf(r)));
                } catch (Exception ex) { this.Note(ex.Message); }
            });
    }

    // 右栏内容壳懒建（首次开详情才挂；构造期不碰文档列）。
    void EnsureDetailBody() {
        if (detailBody != null) { return; }
        detailBody = Panel.Root("wxworkcard");
        detailBody.Class = "grow";
        detailHostCtrl.Add(detailBody);
    }

    void CloseDetail() {
        picked = null;
        if (detailCol != null) { detailCol.visible = false; }
        if (detailBody != null) { detailBody.RemoveAll(); }
        statusLbl = null;
    }

    // 统一 POST：成功重拉全部（详情凭 picked 上下文重开），失败就地
    // 状态行红字。
    void Act(string path, string body) {
        WxNetReq r = WxNet.NewReq();
        WxNet.ApiPost(r, path, body, () => {
            try {
                if (!WxNet.OkOf(r)) {
                    this.Note(WxNet.ErrOf(r));
                    return;
                }
                this.LoadAll();
            } catch (Exception ex) { this.Note(ex.Message); }
        });
    }

    // 状态行提示（面板没开着就丢弃——下一拍刷新会带回面板）。
    void Note(string msg) {
        if (statusLbl == null) { return; }
        statusLbl.Text = msg;
        this.RequestRedrawHost();
    }

    // 右栏卡片头：标题 + 关闭钮；返回卡片本体（dock 容器，head 顶 /
    // body 填），调用方往 body 里续内容。
    Panel CardHead(string title, Panel into) {
        Flex head = Wx.Row("wxphead");
        Panel ht = Panel.Column();
        ht.Class = "grow";
        ht.Grow();
        ht.Add(Wx.Lbl(title, "wxpname"));
        head.Add(ht);
        Button close = Wx.IconBtn("dots");
        close.OnClick(() => { this.CloseDetail(); });
        head.Add(close);
        into.Add(head);
        into.Add(Wx.Line());
        Panel body = Wx.Col("wxpbody");
        body.Grow();
        into.Add(body);
        return body;
    }

    // 摆一个动作钮。
    void ActBtn(Panel body, string label, Action fire) {
        Button b = new Button(label);
        b.OnClick(() => {
            try { fire(); }
            catch (Exception ex) { this.Note(ex.Message); }
        });
        body.Add(b);
    }

    /* ---- 形态一：流程实例详情 ---- */

    void BuildInstPanelDetail(WxFlowInstDetail d) {
        this.EnsureDetailBody();
        detailBody.RemoveAll();
        statusLbl = null;

        Panel card = Panel.Root("wxworkcard");
        card.Class = "grow";
        Panel body = this.CardHead(d.title, card);
        int st = d.status;
        body.Add(Wx.Lbl(WxPageWork.InstZh(st) + " · 流程 "
            + d.defName + " · 发起 "
            + d.startedByName, "wxpsub"));

        // 节点链：顺序环节 + 最新一次任务状态。
        int nn = d.nodes != null ? d.nodes.Count : 0;
        body.Add(Wx.Line());
        for (int i = 0; i < nn; i = i + 1) {
            WxFlowNodeItem n = d.nodes[i];
            string line = Convert.ToString(i + 1) + ". " + n.name;
            int tn = n.tasks != null ? n.tasks.Count : 0;
            if (tn > 0) {
                WxFlowTaskItem t = n.tasks[tn - 1];
                line = line + " —— " + WxPageWork.TaskZh(t.status);
                string who = WxTaskSheet.Who(t.assignUserId);
                if (who != "-") { line = line + " · " + who; }
                string res = t.result;
                if (res.Length > 0 && t.status == 3) {
                    line = line + "：" + res;
                }
            } else {
                line = line + " —— 未开始";
            }
            body.Add(Wx.Lbl(line, "wxpval"));
        }

        // 动作区：按选中行的上下文（tab × 任务状态 × 发起人）摆钮。
        body.Add(Wx.Line());
        Input noteIn = new Input("汇报 / 驳回理由（动作要填的写这里）");
        body.Add(noteIn);
        Switch repool = new Switch();
        Flex pr = Wx.Row("");
        pr.Add(Wx.Lbl("驳回后回部门池重新认领", "wxpsub grow"));
        pr.Add(repool);
        body.Add(pr);
        if (picked != null && st == 1) {
            if (tab == 0 && picked.status == "0") {
                this.ActBtn(body, "完成并提交", () => {
                    this.Act("/api/flow/flowsubmit",
                        "taskId=" + picked.taskId + "&report="
                        + Encoding.UrlEncode(noteIn.GetText()));
                });
            }
            if (tab == 1 && picked.status == "0") {
                this.ActBtn(body, "认领", () => {
                    this.Act("/api/flow/flowclaim",
                        "taskId=" + picked.taskId);
                });
            }
            if (tab == 2 && picked.status == "3") {
                this.ActBtn(body, "验收通过", () => {
                    this.Act("/api/flow/flowaccept",
                        "taskId=" + picked.taskId);
                });
                this.ActBtn(body, "驳回重来", () => {
                    this.Act("/api/flow/flowreject",
                        "taskId=" + picked.taskId + "&reason="
                        + Encoding.UrlEncode(noteIn.GetText())
                        + "&repool=" + (repool.IsOn() ? "1" : "0"));
                });
            }
            if (d.startedBy == myId) {
                this.ActBtn(body, "终止流程", () => {
                    this.Act("/api/flow/flowcancel",
                        "instId=" + picked.instId);
                });
            }
        }
        if (st != 1) {
            body.Add(Wx.Lbl("流程已结束（"
                + WxPageWork.InstZh(st) + "）", "wxemotitle"));
        }

        // 流水（最近 12 条，升序取尾段倒着摆，最新在上）。
        body.Add(Wx.Line());
        body.Add(Wx.Lbl("动态", "wxemotitle"));
        int ln = d.logs != null ? d.logs.Count : 0;
        int from = ln > 12 ? ln - 12 : 0;
        for (int i = ln - 1; i >= from; i = i - 1) {
            WxFlowLogItem e = d.logs[i];
            body.Add(Wx.Lbl(e.content + " · "
                + e.userName + " · "
                + WxIm.ClockOf(e.at), "wxpsub"));
        }
        if (ln == 0) { body.Add(Wx.Lbl("暂无动态", "wxpsub")); }

        statusLbl = Wx.Lbl("", "wxpsub");
        body.Add(statusLbl);
        detailBody.Add(card);

        if (detailCol != null) { detailCol.visible = true; }
        this.RequestRedrawHost();
    }

    void BuildInstPanel(JsonValue d) {
        this.BuildInstPanelDetail(WxFlowInstDetail.FromJson(d));
    }

    /* ---- 形态二：模板详情 + 发起 ---- */

    void BuildTplPanelDetail(WxFlowDefDetail d) {
        this.EnsureDetailBody();
        detailBody.RemoveAll();
        statusLbl = null;

        Panel card = Panel.Root("wxworkcard");
        card.Class = "grow";
        Panel body = this.CardHead(d.name, card);
        string desc = d.description;
        body.Add(Wx.Lbl("流程模板 · "
            + (desc.Length > 0 ? desc : "（无描述）"), "wxpsub"));
        int nn = d.nodes != null ? d.nodes.Count : 0;
        body.Add(Wx.Line());
        for (int i = 0; i < nn; i = i + 1) {
            WxFlowNodeItem n = d.nodes[i];
            string line = Convert.ToString(i + 1) + ". " + n.name;
            string uid = n.assignUserId;
            if (uid != "0") {
                line = line + " · " + WxTaskSheet.Who(uid);
            } else {
                line = line + " · 部门认领";
            }
            body.Add(Wx.Lbl(line, "wxpval"));
        }

        body.Add(Wx.Line());
        Input title = new Input("实例标题（必填）");
        body.Add(title);
        this.ActBtn(body, "发起流程", () => {
            string t = title.GetText();
            if (t.Length == 0) {
                this.Note("标题不能为空");
                return;
            }
            this.SwitchTab(0);
            this.Act("/api/flow/flowstart",
                "defId=" + d.id + "&title="
                + Encoding.UrlEncode(t));
        });
        this.ActBtn(body, "编辑模板", () => { this.EditTemplateDetail(d); });

        statusLbl = Wx.Lbl("", "wxpsub");
        body.Add(statusLbl);
        detailBody.Add(card);

        if (detailCol != null) { detailCol.visible = true; }
        this.RequestRedrawHost();
    }

    void BuildTplPanel(JsonValue d) {
        this.BuildTplPanelDetail(WxFlowDefDetail.FromJson(d));
    }

    /* ---- 形态三：模板编辑器（新建 / 复用改造）----
       状态全在数据侧（edName/edDesc/stages），每次增删/选人先
       SaveEditorState 把输入框里的字收回去再整卡重建——重建不丢字。
       回调里抛异常会带崩进程（见类注），故每个回调体都有守卫。 */

    string edName = "";
    string edDesc = "";
    string editDefId = "0";
    List<WxStageData> stages;
    Panel stageBox;
    Input eName;
    Input eDesc;
    // 编辑中的行控件（与 stages 一一对应，只活在两次重建之间）。
    List<WxStageRow> stageRows;
