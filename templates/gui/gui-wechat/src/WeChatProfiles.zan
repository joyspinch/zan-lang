using System;
using Gui;
using Gui.Widget;
using Gui.Component;

/* 资料卡与朋友圈的数据。
 *
 * 点任意用户头像弹出的名片（WxProfilePanel）读 WxProfileCard：优先用
 * 通讯录里同名联系人的真实资料，没有的就地虚构一份——原版点谁都有
 * 名片，示例数据不可能穷举，缺省值兜底是设计的一部分。
 * 朋友圈的帖子流读 WxPost，全是虚构内容。
 */

/// 页面问资料卡要一次「弹出某人」：参数是展示名 / 头像首字 / 色调类。
delegate void ProfileAsk(string name, string ini, string tint);

/// 资料卡的一份数据。`mine` 为真时是「我」的名片（备注行换成签名）。
class WxProfileCard {
    string name;
    string ini;         // 头像首字（Zan 字符串按字节索引，中文必须显式给）
    string tint;
    int gender;         // 1 男 2 女 0 不显示
    string wxid;
    string region;
    string remark;
    string signature;
    string source;
    string added;
    string videoName;   // 视频号昵称（空 = 没开通）
    bool mine;

    WxProfileCard() {
        this.name = "";
        this.ini = "";
        this.tint = "primary";
        this.gender = 0;
        this.wxid = "";
        this.region = "";
        this.remark = "";
        this.signature = "";
        this.source = "";
        this.added = "";
        this.videoName = "";
        this.mine = false;
    }

    static WxProfileCard Of(string name, string ini, string tint) {
        WxProfileCard c = new WxProfileCard();
        c.name = name;
        c.ini = ini;
        c.tint = tint;
        return c;
    }

    WxProfileCard WithGender(int g) { this.gender = g; return this; }
    WxProfileCard WithWxid(string v) { this.wxid = v; return this; }
    WxProfileCard WithRegion(string v) { this.region = v; return this; }
    WxProfileCard WithRemark(string v) { this.remark = v; return this; }
    WxProfileCard WithSignature(string v) { this.signature = v; return this; }
    WxProfileCard WithSource(string v) { this.source = v; return this; }
    WxProfileCard WithAdded(string v) { this.added = v; return this; }
    WxProfileCard WithVideo(string v) { this.videoName = v; return this; }
    WxProfileCard AsMine() { this.mine = true; return this; }
}

/// 朋友圈的一条帖子：文字 + 图墙 + 时间。图片是虚构的占位色块，
/// 长文默认折叠加「全文」，点开翻 `open`。
class WxPost {
    string name;
    string ini;
    string tint;
    string text;
    bool full;          // 长文：未展开时截断并显示「全文」
    bool open;          // 用户点过「全文」
    int imgs;           // 图墙张数（0 = 纯文字；版式按 1/2/3/4/6 分档）
    string time;

    WxPost(string name, string ini, string tint, string text, bool full,
            int imgs, string time) {
        this.name = name;
        this.ini = ini;
        this.tint = tint;
        this.text = text;
        this.full = full;
        this.open = false;
        this.imgs = imgs;
        this.time = time;
    }

    static WxPost Of(string name, string ini, string tint, string text,
            bool full, int imgs, string time) {
        return new WxPost(name, ini, tint, text, full, imgs, time);
    }

    void ToggleOpen() { this.open = !this.open; }
}

/// 资料卡与朋友圈的取数入口。
class WxProfiles {
    static WxProfileCard me;

    /// 「我」的名片。
    static WxProfileCard Me() {
        if (WxProfiles.me == null) {
            WxProfiles.me = WxProfileCard.Of("季然", "季", "success")
                .WithGender(1).WithWxid("jiran_2024").WithRegion("浙江 杭州")
                .WithSignature("简单点。").WithSource("微聊注册")
                .WithAdded("2023-01-01").WithVideo("季然的分享").AsMine();
        }
        return WxProfiles.me;
    }

    /// 点谁都有名片：通讯录里有同一位（联系人/企业联系人）就用真实
    /// 资料，没有就按首字与色调就地虚构，微信号按首字编一个。
    static WxProfileCard Of(string name, string ini, string tint) {
        List<WxContact> cs = WxData.Contacts();
        for (int i = 0; i < cs.Count; i = i + 1) {
            WxContact c = cs[i];
            if ((c.kind == 2 || c.kind == 6) && c.initial != ""
                    && c.name == name) {
                return WxProfileCard.Of(c.name, c.initial, c.tint)
                    .WithGender(c.gender).WithWxid(c.wxid)
                    .WithRegion(c.region).WithRemark(c.remark)
                    .WithSignature(c.signature).WithSource(c.source)
                    .WithAdded(c.added).WithVideo(c.name + "的分享");
            }
        }
        return WxProfileCard.Of(name, ini, tint)
            .WithGender(1).WithWxid("wxid_" + ini)
            .WithSource("通过搜索添加").WithVideo(name + "的分享");
    }

    /// 朋友圈的帖子流（全部虚构；张数 0/1/2/3/4/6 决定图墙版式）。
    static List<WxPost> Moments() {
        List<WxPost> all = new List<WxPost>();
        all.Add(WxPost.Of("安若", "安", "primary",
            "季度复盘讲完了，一整天走访下来感触很深……很多团队不是不努力，"
            + "是节奏没踩准：排期一挤，验证就被压缩，返工成本一路涨，"
            + "市场窗口却不等人。工具链越顺，试错越便宜，敢把半成品拿出"
            + "来的团队反而走得远。感恩一起打磨的伙伴，全程极致敬业，"
            + "不空谈理论，直……",
            true, 6, "1小时前"));
        all.Add(WxPost.Of("程雨", "程", "info",
            "告警分级终于收敛成一页纸了，P0 只留两类：资损与数据不可恢复。",
            false, 3, "3小时前"));
        all.Add(WxPost.Of("陆斯年", "陆", "primary",
            "设计是减法的艺术，今天又删掉了三分之一的字段。",
            false, 0, "昨天"));
        all.Add(WxPost.Of("苏黎", "苏", "warning",
            "配色方案第四版，深色背景下的对比度这次真的稳了。",
            false, 4, "昨天"));
        all.Add(WxPost.Of("周予安", "周", "success",
            "客户现场联调通过，深夜的泡面最香。",
            false, 1, "2天前"));
        all.Add(WxPost.Of("唐砚", "唐", "info",
            "把半年来的评审记录翻了一遍，发现被毙掉的方案里有一大半不是"
            + "方向错了，而是讲的人没把前提说清楚。以后评审第一页只写"
            + "前提与约束，方案放第二页。",
            true, 2, "3天前"));
        return all;
    }
}
