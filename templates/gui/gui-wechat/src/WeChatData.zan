    }

    // ---- 聊天记录 ----------------------------------------------------

    /// 聊天记录窗口的正文。会话里已有的消息原样搬进来（名字按发言人
    /// 解析），不够 12 条用虚构的补充——记录窗总是比会话里看到的更长，
    /// 和原版「向上翻永远还有」的体感一致。
    static List<WxHistRow> History(WxSession s) {
        List<WxHistRow> rows = new List<WxHistRow>();
        List<string> dates = WxData.HistDates();
        for (int i = 0; i < s.msgs.Count; i = i + 1) {
            ChatMessage m = s.msgs[i];
            string who = "我";
            string ini = "我";
            string tint = "primary";
            if (m.role != "user") {
                if (m.agent != "") {
                    string n = WxData.NameOf(m.agent);
                    if (n != null) { who = n; }
                    string t = WxData.IniOf(m.agent);
                    if (t != "") { ini = t; }
                } else {
                    who = s.name;
                    ini = s.initial;
                }
                tint = WxData.TintOf(i + 1);
            }
            string d = dates[dates.Count - 1];
            if (i < dates.Count) { d = dates[i]; }
            rows.Add(WxHistRow.Of(who, ini, m.text, d, tint));
        }
        // 补足到 12 条：补的正文来自虚构语料，说话人与日期接着往下排。
        List<string> pool = WxData.HistPool();
        int fill = 12 - rows.Count;
        for (int i = 0; i < fill; i = i + 1) {
            string who = "我";
            string ini = "我";
            string tint = "primary";
            if (i % 2 == 0) {
                if (s.group) {
                    WxMate mt = WxData.Mates()[i % WxData.Mates().Count];
                    who = mt.name;
                    ini = mt.ini;
                } else {
                    who = s.name;
                    ini = s.initial;
                }
                tint = WxData.TintOf(i + 2);
            }
            int di = s.msgs.Count + i;
            string d = dates[dates.Count - 1];
            if (di < dates.Count) { d = dates[di]; }
            rows.Add(WxHistRow.Of(who, ini,
                pool[(i + s.name.Length) % pool.Count], d, tint));
        }
        return rows;
    }

    /// 聊天记录行的日期列：从新到旧排（与消息顺序一致）。
    static List<string> HistDates() {
        List<string> d = new List<string>();
        d.Add("2026年9月12日 01:07");
        d.Add("2026年9月11日 23:41");
        d.Add("2026年9月11日 22:18");
