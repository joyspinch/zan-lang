    }

    /// 补足聊天记录用的虚构语料。
    static List<string> HistPool() {
        List<string> p = new List<string>();
        p.Add("这版我把告警阈值改成按水位分档了，你明天看下效果。");
        p.Add("收到，我下午把回归用例补上。");
        p.Add("接口文档里那个字段名写错了，是 orderId，不是 order_id。");
        p.Add("好的，我统一改一遍，顺便把示例请求也更新了。");
        p.Add("灰度曲线平了，第二批可以放开了。");
        p.Add("先别放，等我把回滚脚本演练完。");
        p.Add("明天评审的会议纪要我发群里，大家先看第二页。");
        p.Add("这个背景色在深色模式下对比度不够，要再压一档。");
        p.Add("已改，配色我出了三版，都在共享盘里。");
        p.Add("磁盘水位下来了，归档任务跑完了。");
        return p;
    }

    /// 按序号轮换的色调类（头像格 / 记录行共用，避免一排同色）。
    static string TintOf(int i) {
        string[] ts = new string[]{ "primary", "info", "success", "warning",
            "error" };
        return ts[i % 5];
    }

    /// 抽屉上显示的微信号：通讯录里有这位就用资料里的，没有就按
    /// 首字编一个（纯示例，不对应任何真实账号）。`ini` 由调用方
    /// 显式给——字符串按字节索引，这里不切名字。
    static string WxidOf(string name, string ini) {
        List<WxContact> cs = WxData.Contacts();
        for (int i = 0; i < cs.Count; i = i + 1) {
            if (cs[i].kind == 2 && cs[i].name == name && cs[i].wxid != "") {
                return cs[i].wxid;
            }
        }
        return "wxid_" + ini;
    }

