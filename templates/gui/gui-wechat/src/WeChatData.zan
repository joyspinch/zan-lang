using System;
using Gui.Component;

/// 会话成员：群聊气泡上方的发言人名字走它。`id` 是消息的 agent 字段，
/// 同一份示例数据里全局唯一（这样解析发言人不需要宿主再传上下文）。
class WxMember {
    string id;
    string name;
    string ini;     // 头像首字（字符串按字节索引，中文切不得，数据显式给）

    WxMember(string id, string name, string ini) {
        this.id = id;
        this.name = name;
        this.ini = ini;
    }

    static WxMember Of(string id, string name, string ini) {
        return new WxMember(id, name, ini);
    }
}

/// 群抽屉 / 常用头像面板里的一个成员格。首字由数据显式给出——
/// Zan 字符串按字节索引，对中文 Substring(0,1) 会切出半个字。
class WxMate {
    string name;
    string ini;

    WxMate(string name, string ini) {
        this.name = name;
        this.ini = ini;
    }

    static WxMate Of(string name, string ini) {
        return new WxMate(name, ini);
    }
}

/// 一个会话：左侧列表的一行 + 它自己的消息记录。
class WxSession {
    string name;        // 列表标题（对方昵称或群名）
    string initial;     // 头像里的首字
    string tint;        // 头像色调类：primary / info / success / warning
    bool group;         // 群聊：气泡上方显示发言人名字
    int people;         // 群成员数（一对一为 0）
    string snippet;     // 列表第二行：最后一条摘要
    string time;        // 列表右上角时间
    int unread;         // 未读数，0 = 不显示角标
    List<ChatMessage> msgs;

    WxSession(string name, string initial, string tint, bool group, int people,
            string snippet, string time, int unread) {
        this.name = name;
        this.initial = initial;
        this.tint = tint;
        this.group = group;
        this.people = people;
        this.snippet = snippet;
        this.time = time;
        this.unread = unread;
        this.msgs = new List<ChatMessage>();
    }

    static WxSession Group(string name, string initial, string tint, int people,
            string snippet, string time, int unread) {
        return new WxSession(name, initial, tint, true, people,
            snippet, time, unread);
    }

    static WxSession Peer(string name, string initial, string tint,
            string snippet, string time, int unread) {
        return new WxSession(name, initial, tint, false, 0,
            snippet, time, unread);
    }
}

/// 通讯录的一行：分组节 / 字母分组头 / 联系人 / 好友申请 / 群聊 /
/// 公众号 / 企业，七类共用一种行类型，列表的行模板按 `kind` 决定
/// 长什么样，`Selectable()` 把字母头排除在可选之外。分组节是可折叠
/// 的：页面按 `open` 状态重建视图列表，内容行靠 `section` 归属到节。
class WxContact {
    int kind;           // 0 分组节 1 字母头 2 联系人 3 好友申请 4 群聊 5 公众号 6 企业
    int section;        // 内容行所属分组节的下标（与页面 open[] 对齐）
    string name;
    string initial;
    string tint;
    string wxid;        // 微信号
    string region;      // 地区
    string remark;      // 备注（群聊行：我的群昵称）
    string tag;         // 标签（群聊行：群公告）
    string signature;   // 个性签名
    string source;      // 来源
    string added;       // 添加时间
    string msg;         // 好友申请语 / 公众号功能介绍
    string org;         // 企业名（公众号行：认证主体）
    string role;        // 职务
    bool done;          // 好友申请已通过
    bool open;          // 分组节当前是否展开（页面重建视图前写好）
    int count;          // 分组节右边的数字（群聊 18 / 联系人 2304…）
    int people;         // 群聊人数

    WxContact(int kind, string name) {
        this.kind = kind;
        this.name = name;
        this.section = 5;
        this.initial = "";
        this.tint = "primary";
        this.count = 0;
        this.people = 0;
        this.wxid = "";
        this.region = "";
        this.remark = "";
        this.tag = "";
        this.signature = "";
        this.source = "";
        this.added = "";
        this.msg = "";
        this.org = "";
        this.role = "";
        this.done = false;
        this.open = false;
    }

    /// 分组节（可折叠，右侧有计数）。
    static WxContact Section(string name, int count, int section) {
        WxContact c = new WxContact(0, name);
        c.count = count;
        c.section = section;
        return c;
    }

    /// 字母分组头（不可选）。
    static WxContact Header(string name) {
        return new WxContact(1, name);
    }

    /// 一位联系人（资料栏的每一行都来自这里）。
    static WxContact Person(string name, string initial, string tint,
            string wxid, string region, string remark, string tag,
            string signature, string source, string added) {
        WxContact c = new WxContact(2, name);
        c.initial = initial;
        c.tint = tint;
        c.wxid = wxid;
        c.region = region;
        c.remark = remark;
        c.tag = tag;
        c.signature = signature;
        c.source = source;
        c.added = added;
        return c;
    }

    /// 一条好友申请（「新的朋友」节；通过后行内按钮就地变灰字）。
    static WxContact Req(string name, string initial, string tint,
            string msg, string source, string added, bool done) {
        WxContact c = new WxContact(3, name);
        c.section = 0;
        c.initial = initial;
        c.tint = tint;
        c.msg = msg;
        c.source = source;
        c.added = added;
        c.done = done;
        return c;
    }

    /// 一个已保存的群聊。
    static WxContact Group(string name, string initial, string tint, int people,
            string nick, string notice) {
        WxContact c = new WxContact(4, name);
        c.section = 1;
        c.initial = initial;
        c.tint = tint;
        c.people = people;
        c.count = people;
        c.remark = nick;
        c.tag = notice;
        return c;
    }

    /// 一个公众号/服务号。
    static WxContact Account(string name, string initial, string tint,
            string wxid, string intro, string subject) {
        WxContact c = new WxContact(5, name);
        c.section = 2;
        c.initial = initial;
        c.tint = tint;
        c.wxid = wxid;
        c.msg = intro;
        c.org = subject;
        return c;
    }

    /// 一条企业关系（企业微信联系人 / 我的企业；`initial` 为空表示
    /// 公司本身，行模板用蓝色楼宇图标代替首字头像）。
    static WxContact Ent(string name, string initial, string tint,
            string org, string role, string sign, int section) {
        WxContact c = new WxContact(6, name);
        c.section = section;
        c.initial = initial;
        c.tint = tint;
        c.org = org;
        c.role = role;
        c.signature = sign;
        return c;
    }
}

/// 「通讯录管理」表格的一行：勾选状态留在行模型上，行模板按它画
/// 圆圈，底部的计数与批量操作都读这里。
class WxMgRow {
    string name;
    string ini;         // 头像首字（Zan 字符串按字节索引，中文必须显式给）
    string tint;
    string remark;
    string tag;
    string perm;        // 朋友权限：仅聊天 / 不让他（她）看 / 不看他（她）
    bool picked;

    WxMgRow() {
        this.name = "";
        this.ini = "";
        this.tint = "primary";
        this.remark = "";
        this.tag = "";
        this.perm = "仅聊天";
        this.picked = false;
    }

    static WxMgRow Of(string name, string ini, string tint, string remark,
            string tag, string perm) {
        WxMgRow r = new WxMgRow();
        r.name = name;
        r.ini = ini;
        r.tint = tint;
        r.remark = remark;
        r.tag = tag;
        r.perm = perm;
        return r;
    }
}

/// 收藏列表的一张卡片。
class WxFav {
    string kind;        // 链接 / 图片 / 文件 / 聊天记录 / 位置，用于筛选
    string icon;
    string tint;
    string title;
    string desc;
    string source;
    string time;

    WxFav(string kind, string icon, string tint, string title, string desc,
            string source, string time) {
        this.kind = kind;
        this.icon = icon;
        this.tint = tint;
        this.title = title;
        this.desc = desc;
        this.source = source;
        this.time = time;
    }

    static WxFav Of(string kind, string icon, string tint, string title,
            string desc, string source, string time) {
        return new WxFav(kind, icon, tint, title, desc, source, time);
    }
}

/// 聊天记录窗口的一行：发言人 + 正文 + 右对齐的日期。日期串直接
/// 虚构好（「2026年9月12日 01:07」），不走时间戳格式化——这份示例
/// 数据本来就是编的，格式化反而把「编」藏起来了。
class WxHistRow {
    string name;        // 发言人（私聊也显示，与截图一致）
    string ini;         // 头像首字
    string text;
    string date;        // 右对齐的日期串
    string tint;        // 头像色调类

    WxHistRow(string name, string ini, string text, string date, string tint) {
        this.name = name;
        this.ini = ini;
        this.text = text;
        this.date = date;
        this.tint = tint;
    }

    static WxHistRow Of(string name, string ini, string text, string date,
            string tint) {
        return new WxHistRow(name, ini, text, date, tint);
    }
}

/// 「选择文件」面板里的一行最近文件。
class WxFileRow {
    string name;
    string size;
    string date;
    string icon;        // tabler 图标名（file-text / archive / video / photo）

    WxFileRow(string name, string size, string date, string icon) {
        this.name = name;
        this.size = size;
        this.date = date;
        this.icon = icon;
    }

    static WxFileRow Of(string name, string size, string date, string icon) {
        return new WxFileRow(name, size, date, icon);
    }
}

/// 示例数据：全部虚构，与任何真实账号、真实联系人无关。
class WxData {
    // ---- 发言人注册表 ----------------------------------------------

    static List<WxMember> reg;

    static List<WxMember> Members() {
        if (reg == null) { reg = new List<WxMember>(); }
        return reg;
    }

    static void Who(string id, string name, string ini) {
        WxData.Members().Add(WxMember.Of(id, name, ini));
    }

    /// 发言人的头像首字；没登记过的返回空串（行模板自己兜底）。
    static string IniOf(string id) {
        List<WxMember> ms = WxData.Members();
        for (int i = 0; i < ms.Count; i = i + 1) {
            if (ms[i].id == id) { return ms[i].ini; }
        }
        return "";
    }

    /// 把 agent id 解析成显示名；不认识返回 null（组件按默认助手画）。
    static string NameOf(string id) {
        List<WxMember> ms = WxData.Members();
        for (int i = 0; i < ms.Count; i = i + 1) {
            if (ms[i].id == id) { return ms[i].name; }
        }
        return null;
    }

    /// ChatView 的发言人钩子（多智能体会话那套 API 的普通人名版本）。
    static ChatSpeaker Speaker(string id) {
        string n = WxData.NameOf(id);
        if (n == null) { return null; }
        return ChatSpeaker.Of(n, 0, "");
    }

    /// 协议节拍标签：这份示例数据没有节拍，恒定返回空串。
    static string KindLabel(string kind) {
        return "";
    }

    // ---- 消息 ------------------------------------------------------

    /// 一条消息。`off` 是它发生在「现在」之前多少秒——时刻分隔要靠
    /// 真实间隔算出来，所以不能全用“现在”。
    static ChatMessage At(string role, string text, string agent, long off) {
        ChatMessage m = ChatMessage.Create(role, text);
        m.agent = agent;
        m.at = DateTime.UtcNow().ToUnixSeconds() - off;
        return m;
    }

    static void Say(List<ChatMessage> into, string role, string text,
            string agent, long off) {
        into.Add(WxData.At(role, text, agent, off));
    }

    // ---- 会话 ------------------------------------------------------

    static List<WxSession> Sessions() {
        List<WxSession> all = new List<WxSession>();

        // 产品评审群
        WxData.Who("g1a", "陆斯年", "陆");
        WxData.Who("g1b", "程雨", "程");
        WxData.Who("g1c", "何嘉树", "何");
        WxSession s1 = WxSession.Group("产品评审群", "产", "primary", 12,
            "收到，我把告警级别提到 P0 并补一条对账任务", "刚刚", 3);
        WxData.Say(s1.msgs, "assistant", "评审稿我放到共享盘了，重点看第三章的库存扣减顺序。", "g1a", 7500);
        WxData.Say(s1.msgs, "assistant", "看了，扣减和释放的边界现在分开写了两遍。", "g1b", 7400);
        WxData.Say(s1.msgs, "user", "那段我合并成一进一出，顺手把超卖那条用例补上了。", "", 7300);
        WxData.Say(s1.msgs, "assistant", "好，那我把第三章的时序图也跟着改一版。", "g1a", 3600);
        WxData.Say(s1.msgs, "assistant", "顺便问一句，回滚失败要不要直接告警？", "g1c", 3500);
        WxData.Say(s1.msgs, "user", "要，回滚失败按最高级别报，这条不能吞。", "", 3400);
        WxData.Say(s1.msgs, "assistant", "收到，我把告警级别提到 P0 并补一条对账任务。", "g1c", 120);
        all.Add(s1);

        // 设计稿同步
        WxData.Who("g3a", "苏黎", "苏");
        WxData.Who("g3b", "唐砚", "唐");
        WxSession s2 = WxSession.Group("设计稿同步", "设", "info", 5,
            "列表行的间距我按 4 的倍数重排了一遍", "14:32", 2);
        WxData.Say(s2.msgs, "assistant", "新的一版在 Figma 里，导航栏图标换成线性描边了。", "g3a", 100000);
        WxData.Say(s2.msgs, "assistant", "看到了，间距好像有半像素的偏差。", "g3b", 96000);
        WxData.Say(s2.msgs, "assistant", "列表行的间距我按 4 的倍数重排了一遍。", "g3a", 9000);
        all.Add(s2);

        // 发布看板
        WxData.Who("g5a", "秦望", "秦");
        WxData.Who("g5b", "沈迟", "沈");
        WxData.Who("g5c", "罗一舟", "罗");
        WxSession s3 = WxSession.Group("发布看板", "发", "warning", 8,
            "灰度批次先停在 5%，明早再看曲线", "13:07", 7);
        WxData.Say(s3.msgs, "assistant", "2.4.0 的构建产物已经推到预发。", "g5a", 400000);
        WxData.Say(s3.msgs, "assistant", "预发的冒烟过了，但那条老用例还在抖。", "g5b", 300000);
        WxData.Say(s3.msgs, "user", "抖的那条先标记跳过，别让它挡发布。", "", 250000);
        WxData.Say(s3.msgs, "assistant", "灰度批次先停在 5%，明早再看曲线。", "g5c", 20000);
        all.Add(s3);

        // 一对一会话
        WxSession p1 = WxSession.Peer("林昭远", "林", "success",
            "那我明天上午把接口文档发你", "11:20", 0);
        WxData.Say(p1.msgs, "assistant", "上次说的那个导出接口，字段能不能再少几个？", "", 200000);
        WxData.Say(p1.msgs, "user", "可以，只留 id、状态和时间三个，其余走详情接口。", "", 190000);
        WxData.Say(p1.msgs, "assistant", "行，那我明天上午把接口文档发你。", "", 8000);
        all.Add(p1);

        WxSession p2 = WxSession.Peer("唐砚", "唐", "info",
            "下午的评审我迟到十分钟", "10:05", 1);
        WxData.Say(p2.msgs, "assistant", "下午的评审我迟到十分钟，先帮我占个位。", "", 30000);
        all.Add(p2);

        WxSession p3 = WxSession.Peer("苏黎", "苏", "warning",
            "配色我出了三版，你看哪版稳一点", "昨天", 0);
        WxData.Say(p3.msgs, "assistant", "配色我出了三版，你看哪版稳一点。", "", 150000);
        WxData.Say(p3.msgs, "user", "第二版，深色背景下对比度够。", "", 140000);
        all.Add(p3);

        WxSession p4 = WxSession.Peer("运维值班", "运", "error",
            "磁盘水位回到 62%，告警已恢复", "昨天", 0);
        WxData.Say(p4.msgs, "assistant", "凌晨那波写入把日志盘顶到 91% 了。", "", 400000);
        WxData.Say(p4.msgs, "user", "先把七天的日志归档，扩容排到下周。", "", 390000);
        WxData.Say(p4.msgs, "assistant", "磁盘水位回到 62%，告警已恢复。", "", 380000);
        all.Add(p4);

        WxSession p5 = WxSession.Peer("素材归档", "素", "success",
            "这批图标已经按 24 像素网格导出", "周三", 0);
        WxData.Say(p5.msgs, "assistant", "这批图标已经按 24 像素网格导出。", "", 500000);
        all.Add(p5);

        return all;
    }

    // ---- 通讯录 ----------------------------------------------------

    /// 通讯录的完整数据：六个分组节按原版顺序排列，内容行用 `section`
    /// 归属到节。节是否展开由页面状态决定——这里只管「每节有什么」。
    /// 计数对齐原版截图的量级（群聊 18 / 联系人 2304），内容是虚构的子集。
    static List<WxContact> Contacts() {
        List<WxContact> all = new List<WxContact>();
        all.Add(WxContact.Section("新的朋友", 2, 0));
        all.Add(WxContact.Req("何嘉树", "何", "success",
            "我是何嘉树，上周群聊里认识的，多交流", "来自群聊「Zan 语言交流群」",
            "昨天", false));
        all.Add(WxContact.Req("苏黎", "苏", "warning",
            "您好，我是苏黎，想请教一下配色的问题", "通过手机号搜索",
            "09-10", false));
        all.Add(WxContact.Req("唐望", "唐", "info",
            "同名的缘分，加个好友吧", "扫一扫", "09-08", true));

        all.Add(WxContact.Section("群聊", 18, 1));
        all.Add(WxContact.Group("Zan 语言交流群", "Z", "info", 216,
            "", "每月第一个周六线上聚，公告栏贴回放。"));
        all.Add(WxContact.Group("周末爬山队", "周", "success", 12,
            "陆斯年", "本周六 7:00 云栖小镇集合，雨顺延。"));
        all.Add(WxContact.Group("前端摸鱼小组", "前", "warning", 48,
            "", "只聊前端，不聊加班。"));

        all.Add(WxContact.Section("公众号、服务号", 256, 2));
        all.Add(WxContact.Account("Zan 语言官方号", "Z", "primary", "zanlang",
            "Zan 语言与标准库的官方发布号，周更。", "杭州赞语科技有限公司"));
        all.Add(WxContact.Account("程序员的日常", "程", "info", "coder_daily",
            "每天一篇，讲透一个工程问题。", "上海秩心文化传媒有限公司"));
        all.Add(WxContact.Account("深夜代码博物馆", "博", "error", "night_code",
            "午夜十二点，讲一段代码背后的历史。", "深圳夜航传媒有限公司"));

        all.Add(WxContact.Section("企业微信联系人", 33, 3));
        all.Add(WxContact.Ent("罗云", "罗", "primary", "爱悦域科技",
            "后端工程师", "接口先行，文档随行。", 3));
        all.Add(WxContact.Ent("秦岭", "秦", "warning", "电弧听有限公司",
            "产品经理", "需求评审前请先读一遍PRD。", 3));

        all.Add(WxContact.Section("我的企业", 5, 4));
        all.Add(WxContact.Header("A"));
        all.Add(WxContact.Ent("爱悦域科技", "", "info", "爱悦域科技", "我的企业",
            "", 4));
        all.Add(WxContact.Header("C"));
        all.Add(WxContact.Ent("长沙市比赞教育科技有限公司", "", "info",
            "长沙市比赞教育科技有限公司", "我的企业", "", 4));
        all.Add(WxContact.Header("D"));
        all.Add(WxContact.Ent("电弧听有限公司", "", "info", "电弧听有限公司",
            "我的企业", "", 4));
        all.Add(WxContact.Header("Q"));
