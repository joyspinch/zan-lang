using System;
using Gui;
using Gui.Component;
using Gui.Widget;

/* 中栏一行：节点图标 + 节点名 + 节点类型（AI 节点写工具数）。
   行模板是代码建的控件，不吃文档作用域类——外观规则在皮肤层
   （.wxflownoderow/.wxflownodename/.wxflownodesub）。 */
public class WxFlowAgentNodeRow : Control {
    WxFlowAgentNode item;

    static Control Of(WxFlowAgentNode it) { return new WxFlowAgentNodeRow(it); }

    WxFlowAgentNodeRow(WxFlowAgentNode it) {
        this.InitControl("wxflowagentnoderow", 5);
        this.Class = "wxflownoderow";
        item = it;
        // AI 节点挂 cpu 图标，人工节点挂人像——一眼分得清谁能分配工具。
        if (it.kind == "ai") {
            this.Add(Wx.AvaIcon("cpu", 28, "info"));
        } else {
            this.Add(Wx.AvaIcon("user", 28, "info"));
        }
        Flex mid = Flex.Column();
        // grow：行是横向 flex（皮肤 .wxflownoderow 里 display:flex），中列吃满
        // 剩余宽度，节点名与类型才不会被压成一条线。
        mid.AddClass("wxflownodemid grow");
        mid.Justify("center");
        mid.Grow();
        mid.Add(Wx.Lbl(it.name, "wxflownodename"));
        mid.Add(Wx.Lbl(it.Sub(), "wxflownodesub"));
        this.Add(mid);
    }

    override string Kind() { return "WxFlowAgentNodeRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxflownoderow 的 height）。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(52));
        prefW = app.Scale(240);
    }
}
