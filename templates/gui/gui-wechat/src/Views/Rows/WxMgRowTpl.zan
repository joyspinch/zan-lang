using System;
using Gui;
using Gui.Widget;

public class WxMgRowTpl : Control {
    WxMgRow item;

    static Control Of(WxMgRow it) { return new WxMgRowTpl(it); }

    WxMgRowTpl(WxMgRow it) {
        this.InitControl("wxmgrow", 5);
        this.Class = "wxmgrow";
        item = it;
        Flex row = Wx.Row("wxmgrowin");
        row.Grow();
        row.Add(WxMgHeadRow.Dot(it.picked));
        row.Add(Wx.Ava(it.ini, 32, it.tint));
        row.Add(Wx.Lbl(it.name, "wxmgname grow"));
        row.Add(WxMgHeadRow.Col(it.remark, "wxmgc1", "wxmgcell"));
        row.Add(WxMgHeadRow.Col(it.tag, "wxmgc2", "wxmgcell"));
        row.Add(WxMgHeadRow.Col(it.perm, "wxmgc3", "wxmgcell"));
        this.Add(row);
    }

    override string Kind() { return "WxMgRowTpl"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(52));
        prefW = app.Scale(700);
    }
}

// 「通讯录管理」表格的表头行：与数据行同一套内部流式结构（勾选圈 +
// 昵称 + 右缘三列），没有头像、文字用表头样式——同构才像素对齐。
// 全选勾选圈经 Circle() 交给窗口接行为。
