using System;
using Gui;
using Gui.Component;
using Gui.Widget;

/* 左栏一行：流程图标 + 流程名 + AI 节点/工具计数。
   行模板是代码建的控件，不吃文档作用域类——外观规则在皮肤层
   （.wxflowdefrow/.wxflowdefname/.wxflowdefsub）。 */
public class WxFlowDefRow : Control {
    WxFlowDefItem item;

    static Control Of(WxFlowDefItem it) { return new WxFlowDefRow(it); }

    WxFlowDefRow(WxFlowDefItem it) {
        this.InitControl("wxflowdefrow", 5);
        this.Class = "wxflowdefrow";
        item = it;
        this.Add(Wx.AvaIcon("activity", 32, "primary"));
        Flex mid = Flex.Column();
        // grow：行是横向 flex（皮肤 .wxflowdefrow 里 display:flex），中列吃满
        // 剩余宽度，流程名与计数才不会被压成一条线。
        mid.AddClass("wxflowdefmid grow");
        mid.Justify("center");
        mid.Grow();
        mid.Add(Wx.Lbl(it.name, "wxflowdefname"));
        mid.Add(Wx.Lbl(it.Sub(), "wxflowdefsub"));
        this.Add(mid);
    }

    override string Kind() { return "WxFlowDefRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxflowdefrow 的 height），同多维表格行。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(56));
        prefW = app.Scale(210);
    }
}
