using System;
using Gui;
using Gui.Widget;

public class WxFavRow : Control {
    WxFav item;

    static Control Of(WxFav it) { return new WxFavRow(it); }

    WxFavRow(WxFav it) {
        this.InitControl("wxfavrow", 5);
        this.Class = "wxfavrow";
        item = it;
        Avatar av = Wx.AvaIcon(it.icon, 40, it.tint);
        this.Add(av);
        // 同会话行：内容垂直居中，分隔线走 .wxfavrow 的 border-bottom。
        Flex mid = Flex.Column();
        // grow：行是横向 flex（皮肤 .wxfavrow 里 display:flex），中列吃满
        // 剩余宽度，右列（.wxmeta）才贴得到右缘。
        mid.AddClass("wxmid grow");
        mid.Justify("center");
        mid.Grow();
        mid.Add(Wx.Lbl(it.title, "wxfavname"));
        mid.Add(Wx.Lbl(it.desc, "wxfavsub"));
        this.Add(mid);
        Flex meta = Flex.Column();
        meta.AddClass("wxmeta");
        meta.Justify("center");
        Flex r1 = Wx.Row("");
        r1.Justify("end");
        r1.Add(Wx.Lbl(it.source, "wxfavsub"));
        meta.Add(r1);
        Flex r2 = Wx.Row("");
        r2.Justify("end");
        r2.Add(Wx.Lbl(it.time, "wxfavsub"));
        meta.Add(r2);
        this.Add(meta);
    }

    override string Kind() { return "WxFavRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxfavrow 的 height），同会话行。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(66));
        prefW = app.Scale(280);
    }
}

// 收藏左栏的一个筛选项。整行就是一条标签，选中底色由 ListView 画。
