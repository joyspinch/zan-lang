using System;
using Gui;
using Gui.Component;
using Gui.Widget;

/* 右栏一行：版本号 + 标题 + 编辑人/时间（当前版本标「当前」）。
   行模板是代码建的控件，不吃文档作用域类——外观规则在皮肤层
   （.wxdocverrow/.wxdocvermid）。 */
public class WxDocVersionRow : Control {
    WxDocVersion item;

    static Control Of(WxDocVersion it) { return new WxDocVersionRow(it); }

    WxDocVersionRow(WxDocVersion it) {
        this.InitControl("wxdocverrow", 5);
        this.Class = "wxdocverrow";
        item = it;
        this.Add(Wx.AvaIcon("history", 26, it.IsCur() ? "success" : ""));
        Flex mid = Flex.Column();
        // grow：行是横向 flex（皮肤 .wxdocverrow 里 display:flex），中列
        // 吃满剩余宽度，版本标题与时间才不会被压成一条线。
        mid.AddClass("wxdocvermid grow");
        mid.Justify("center");
        mid.Grow();
        string head = "v" + it.version;
        if (it.IsCur()) { head = head + "（当前）"; }
        mid.Add(Wx.Lbl(head, "wxdocverhead"));
        mid.Add(Wx.Lbl(it.Sub(), "wxdocversub"));
        this.Add(mid);
    }

    override string Kind() { return "WxDocVersionRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxdocverrow 的 height）。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(44));
        prefW = app.Scale(210);
    }
}
