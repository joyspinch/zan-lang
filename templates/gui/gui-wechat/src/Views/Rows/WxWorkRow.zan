using System;
using System.IO;
using System.Json;
using System.Text;
using Gui;
using Gui.Backend;
using Gui.Component;
using Gui.Widget;

public class WxWorkRow : Control {
    WxWorkItem item;

    static Control Of(WxWorkItem it) { return new WxWorkRow(it); }

    WxWorkRow(WxWorkItem it) {
        this.InitControl("wxworkrowtpl", 5);
        this.Class = "wxworkrow";
        item = it;
        string tint = it.kind == 1 ? "primary"
            : WxPageWork.TaskTint(Convert.ToInt32(it.status));
        Avatar av = Wx.AvaIcon(it.kind == 1 ? "target" : "box", 40, tint);
        this.Add(av);
        Flex mid = Flex.Column();
        // grow：行是横向 flex（皮肤 .wxworkrow 里 display:flex），中列吃满
        // 剩余宽度，右列（.wxmeta）才贴得到右缘。
        mid.AddClass("wxmid grow");
        mid.Justify("center");
        mid.Grow();
        mid.Add(Wx.Lbl(it.title, "wxfavname"));
        string sub;
        if (it.kind == 1) {
            sub = it.description.Length > 0
                ? it.description : it.nodeCount + " 个环节";
        } else {
            sub = it.nodeName + " · "
                + WxPageWork.TaskZh(Convert.ToInt32(it.status));
        }
        mid.Add(Wx.Lbl(sub, "wxworksub"));
        this.Add(mid);
        Flex meta = Flex.Column();
        meta.AddClass("wxmeta");
        meta.Justify("center");
        Flex r1 = Wx.Row("");
        r1.Justify("end");
        r1.Add(Wx.Lbl(it.kind == 1 ? it.nodeCount + " 环" : "", "wxworkmeta"));
        meta.Add(r1);
        this.Add(meta);
    }

    override string Kind() { return "WxWorkRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxworkrow 的 height），同收藏卡行。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(64));
        prefW = app.Scale(280);
    }
}

