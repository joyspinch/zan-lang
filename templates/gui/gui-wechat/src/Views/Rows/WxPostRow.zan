using System;
using Gui;
using Gui.Widget;

public class WxPostRow : Control {
    WxPost item;
    Label body;
    Label more;

    static Control Of(WxPost it) { return new WxPostRow(it); }

    WxPostRow(WxPost it) {
        this.InitControl("wxpostrow", 5);
        this.Class = "wxpost";
        item = it;
        Avatar av = Wx.Ava(it.ini, 44, it.tint);
        this.Add(av);

        Panel mid = Panel.Column();
        mid.Class = "grow";
        mid.Grow();
        mid.Add(Wx.Lbl(it.name, "wxpostname"));
        body = Wx.Lbl(this.Display(), "wxposttext");
        body.wrap = true;
        mid.Add(body);
        if (it.full) {
            more = Wx.Lbl(it.open ? "收起" : "全文", "wxpmore");
            more.OnClick(() => {
                item.ToggleOpen();
                body.Text = this.Display();
                more.Text = item.open ? "收起" : "全文";
            });
            mid.Add(more);
        }
        if (it.imgs > 0) {
            mid.Add(this.Grid());
        }
        Flex tr = Wx.Row("wxpostfoot");
        tr.Add(Wx.Lbl(it.time, "wxposttime"));
        Flex sp = Flex.Row();
        sp.AddClass("grow");
        sp.Grow();
        tr.Add(sp);
        Label dots = Wx.Lbl("···", "wxpostdots");
        Flex dw = Wx.Row("");
        dw.Add(dots);
        tr.Add(dw);
        mid.Add(tr);
        this.Add(mid);
    }

    // 折叠时长文截到约 60 个字；展开或本就不长则全文。
    string Display() {
        if (!item.full || item.open) { return item.text; }
        return WxPostRow.Cut(item.text, 60);
    }

    // 图墙：1 张独占一行，2~3 张一行三列，4 张两行，6 张两行三列。
    // 图块是皮肤里定义的渐变色块（示例数据没有真实照片）。
    Flex Grid() {
        Flex g = Flex.Column();
        g.AddClass("wxpostgrid");
        int n = item.imgs;
        if (n == 1) {
            g.Add(WxPostRow.TileRow(0, 1));
            return g;
        }
        int first = n <= 3 ? n : (n + 1) / 2;
        g.Add(WxPostRow.TileRow(0, first));
        if (n > first) { g.Add(WxPostRow.TileRow(first, n - first)); }
        return g;
    }

    // 一行图块：从 `from` 起画 `cnt` 个。
    static Flex TileRow(int from, int cnt) {
        Flex r = Flex.Row();
        r.AddClass("wxptilerow");
        string[] cls = new string[]{ "wxph-a", "wxph-b", "wxph-c",
            "wxph-d", "wxph-e", "wxph-f" };
        for (int i = 0; i < cnt; i = i + 1) {
            Flex t = Flex.Column();
            t.AddClass("wxptile " + cls[(from + i) % cls.Length]);
            r.Add(t);
        }
        return r;
    }

    // 按字符边界截断：UTF-8 的续字节（0b10xxxxxx）不作开头，
    // 从目标字节往前退到码点起点（长文折叠用）。
    static string Cut(string s, int maxChars) {
        int bytes = 0;
        for (int i = 0; i < maxChars; i = i + 1) {
            int end = Text.NextCharEnd(s, bytes);
            if (end <= bytes || end >= s.Length) { break; }
            bytes = end;
        }
        if (bytes <= 0 || bytes >= s.Length) { return s; }
        return Text.Left(s, bytes) + "…";
    }

    override string Kind() { return "WxPostRow"; }
    override string StyleType() { return "wxpost"; }

    override void OnMeasure(App app) {
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        // 正文列宽 ~540、字号 15 → 一行约 36 个汉字；字符数按字节估
        // （示例正文以 CJK 为主），行数宁可多算一档，省得布局自检报
        // 「矩形装不下自然高度」。
        int bytes = item.text.Length;
        int chars = bytes / 3 + 1;
        if (!item.full || item.open) {
            int lines = chars / 36 + 1;
            prefH = s.HeightOr(app.Scale(96 + lines * 26
                + this.GridH() + 14));
        } else {
            prefH = s.HeightOr(app.Scale(96 + 2 * 26 + this.GridH() + 14));
        }
        prefW = app.Scale(680);
    }

    int GridH() {
        int n = item.imgs;
        if (n == 0) { return 0; }
        if (n == 1) { return 168; }
        return n <= 3 ? 104 : 2 * 104 + 6;
    }
}
