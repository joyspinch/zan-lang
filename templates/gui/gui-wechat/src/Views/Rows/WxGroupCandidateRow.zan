using System;
using Gui;
using Gui.Widget;

public class WxGroupCandidateRow : Control {
    WxGroupCandidateItem item;

    public static Control Of(WxGroupCandidateItem it) {
        return new WxGroupCandidateRow(it);
    }

    public WxGroupCandidateRow(WxGroupCandidateItem it) {
        this.InitControl("wxgrow", 5);
        this.Class = "wxmgrow";
        this.item = it;
        Flex row = Wx.Row("wxmgrowin");
        row.Grow();
        row.Add(WxMgHeadRow.Dot(it.picked));
        row.Add(Wx.Ava(it.ini, 32, it.tint));
        row.Add(Wx.Lbl(it.name, "wxmgname grow"));
        if (it.username.Length > 0 && it.username != it.name) {
            row.Add(Wx.Lbl("@" + it.username, "wxmgmttext"));
        }
        this.Add(row);
    }

    override string Kind() { return "WxGroupCandidateRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(44));
        prefW = app.Scale(400);
    }
}
