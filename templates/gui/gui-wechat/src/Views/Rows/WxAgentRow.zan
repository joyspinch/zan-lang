using System;
using Gui;
using Gui.Component;
using Gui.Widget;

/* 左栏一行：智能体图标 + 名字 + 一句提示（用途）。
   行模板是代码建的控件，不吃文档作用域类——外观规则在皮肤层
   （.wxagentrow/.wxagentname/.wxagenthint）。 */
public class WxAgentRow : Control {
    WxAgentItem item;

    static Control Of(WxAgentItem it) { return new WxAgentRow(it); }

    WxAgentRow(WxAgentItem it) {
        this.InitControl("wxagentrow", 5);
        this.Class = "wxagentrow";
        item = it;
        this.Add(Wx.AvaIcon(it.icon, 30, "info"));
        Flex mid = Flex.Column();
        mid.AddClass("wxagentmid");
        mid.Justify("center");
        mid.Grow();
        mid.Add(Wx.Lbl(it.name, "wxagentname"));
        mid.Add(Wx.Lbl(it.hint, "wxagenthint"));
        this.Add(mid);
    }

    override string Kind() { return "WxAgentRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxagentrow 的 height），同多维表格行。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(56));
        prefW = app.Scale(220);
    }
}
