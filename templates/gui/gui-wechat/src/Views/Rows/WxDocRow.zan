using System;
using Gui;
using Gui.Component;
using Gui.Widget;

/* 左栏一行：文档图标 + 标题 + 版本/编辑人/时间。
   行模板是代码建的控件，不吃文档作用域类——外观规则在皮肤层
   （.wxdocrow/.wxdocmid）。 */
public class WxDocRow : Control {
    WxDocItem item;

    static Control Of(WxDocItem it) { return new WxDocRow(it); }

    WxDocRow(WxDocItem it) {
        this.InitControl("wxdocrow", 5);
        this.Class = "wxdocrow";
        item = it;
        this.Add(Wx.AvaIcon("file-text", 30, "primary"));
        Flex mid = Flex.Column();
        // grow：行是横向 flex（皮肤 .wxdocrow 里 display:flex），中列
        // 吃满剩余宽度，标题与元信息才不会被压成一条线。
        mid.AddClass("wxdocmid grow");
        mid.Justify("center");
        mid.Grow();
        mid.Add(Wx.Lbl(it.title, "wxdocname"));
        mid.Add(Wx.Lbl(it.Sub(), "wxdocsub"));
        this.Add(mid);
    }

    override string Kind() { return "WxDocRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxdocrow 的 height）。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(52));
        prefW = app.Scale(210);
    }
}
