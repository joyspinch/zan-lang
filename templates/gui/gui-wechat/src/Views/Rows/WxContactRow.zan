using System;
using Gui;
using Gui.Widget;

public class WxContactRow : Control {
    WxContact item;

    static Control Of(WxContact it) { return new WxContactRow(it); }

    // ListView 的可选门控：字母分组头只是分节标题，不是选项。
    static bool Selectable(WxContact it) { return it.kind != 1; }

    WxContactRow(WxContact it) {
        this.InitControl("wxcatrow", 5);
        item = it;
        if (it.kind == 1) {
            this.Class = "wxhead2";
            this.Add(Wx.Lbl(it.name, "wxhead2"));
            return;
        }
        if (it.kind == 0) {
            this.Class = "wxsec";
            IconView ch = new IconView(
                it.open ? "chevron-down" : "chevron-right", 14);
            this.Add(ch);
            Label nm = Wx.Lbl(it.name, "wxcatname grow");
            nm.Grow();
            this.Add(nm);
            if (it.count > 0) {
                Flex cr = Wx.Row("");
                cr.Justify("end");
                cr.Add(Wx.Lbl(Convert.ToString(it.count), "wxcatcount"));
                this.Add(cr);
            }
            return;
        }
        this.Class = "wxcat";
        Avatar av = null;
        if (it.kind == 6 && it.initial == "") {
            av = Wx.AvaIcon("building", 36, "info");
        } else {
            av = Wx.Ava(it.initial, 36, it.tint);
        }
        this.Add(av);
        if (it.kind == 3) {
            // 好友申请：名字下面还有一行申请语，右侧是通过按钮
            // （通过后就地变灰字，与原版「接受 → 已添加」一致）。
            Flex mp = Flex.Column();
            mp.AddClass("grow");
            mp.Justify("center");
            mp.Grow();
            mp.Add(Wx.Lbl(it.name, "wxcatname"));
            mp.Add(Wx.Lbl(it.msg, "wxreqmsg"));
            this.Add(mp);
            Label ok = Wx.Lbl("已添加", "wxreqdone");
            Button acc = new Button("接受");
            acc.Class = "primary small wxreqbtn";
            acc.OnClick(() => {
                it.done = true;
                acc.visible = false;
                ok.visible = true;
            });
            ok.visible = it.done;
            acc.visible = !it.done;
            this.Add(acc);
            this.Add(ok);
            return;
        }
        Label nm = Wx.Lbl(it.name, "wxcatname grow");
        nm.Grow();
        this.Add(nm);
        if (it.kind == 4 && it.people > 0) {
            Flex cr = Wx.Row("");
            cr.Justify("end");
            cr.Add(Wx.Lbl(Convert.ToString(it.people) + " 人", "wxcatcount"));
            this.Add(cr);
        }
    }

    override string Kind() { return "WxContactRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxcat / .wxsec / .wxhead2 的 height）；兜底值
        // 随行种类给出：申请行带两行文字高一档，字母头矮一档。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        int nat = 56;
        if (item.kind == 0) { nat = 44; }
        if (item.kind == 1) { nat = 28; }
        if (item.kind == 3) { nat = 66; }
        prefH = s.HeightOr(app.Scale(nat));
        prefW = app.Scale(280);
    }
}

// 收藏列表的一张卡片：图标 + 标题/摘要 + 右侧来源与时间，底部一条分隔线。
