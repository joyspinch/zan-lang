using System;
using Gui;
using Gui.Component;
using Gui.Widget;

/* 左栏一行：表图标 + 表名 + 列/行计数。
   行模板是代码建的控件，不吃文档作用域类——外观规则在皮肤层
   （.wxbitrow/.wxbitname/.wxbitsub）。 */
public class WxBitableRow : Control {
    WxBitableItem item;

    static Control Of(WxBitableItem it) { return new WxBitableRow(it); }

    WxBitableRow(WxBitableItem it) {
        this.InitControl("wxbitablerow", 5);
        this.Class = "wxbitrow";
        item = it;
        this.Add(Wx.AvaIcon(it.icon, 32, "primary"));
        Flex mid = Flex.Column();
        mid.AddClass("wxbitmid");
        mid.Justify("center");
        mid.Grow();
        mid.Add(Wx.Lbl(it.name, "wxbitname"));
        mid.Add(Wx.Lbl(it.Sub(), "wxbitsub"));
        this.Add(mid);
    }

    override string Kind() { return "WxBitableRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxbitrow 的 height），同工作台行。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(56));
        prefW = app.Scale(240);
    }
}
