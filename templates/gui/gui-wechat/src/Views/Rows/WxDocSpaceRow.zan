using System;
using Gui;
using Gui.Component;
using Gui.Widget;

/* 左栏一行：空间图标 + 空间名 + 文档数。
   行模板是代码建的控件，不吃文档作用域类——外观规则在皮肤层
   （.wxdocspacerow/.wxdocspacemid）。 */
public class WxDocSpaceRow : Control {
    WxDocSpace item;

    static Control Of(WxDocSpace it) { return new WxDocSpaceRow(it); }

    WxDocSpaceRow(WxDocSpace it) {
        this.InitControl("wxdocspacerow", 5);
        this.Class = "wxdocspacerow";
        item = it;
        this.Add(Wx.AvaIcon("folder", 30, "info"));
        Flex mid = Flex.Column();
        // grow：行是横向 flex（皮肤 .wxdocspacerow 里 display:flex），
        // 中列吃满剩余宽度，名字与计数才不会被压成一条线。
        mid.AddClass("wxdocspacemid grow");
        mid.Justify("center");
        mid.Grow();
        mid.Add(Wx.Lbl(it.name, "wxdocspacename"));
        mid.Add(Wx.Lbl(it.Sub(), "wxdocspacesub"));
        this.Add(mid);
    }

    override string Kind() { return "WxDocSpaceRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxdocspacerow 的 height）。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(48));
        prefW = app.Scale(210);
    }
}
