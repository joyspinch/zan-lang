using System;
using Gui;
using Gui.Widget;

public class WxMgHeadRow : Control {
    Button circleBtn;

    Button Circle() { return circleBtn; }

    // 一个定宽数据列：列宽类写在 Flex 上（Label 上的 width 类不被
    // 测量消费，必须包一层定宽容器）。
    static Flex Col(string txt, string wcls, string lblCls) {
        Flex c = Wx.Row(wcls);
        c.Add(Wx.Lbl(txt, lblCls));
        return c;
    }

    // 勾选圈（on = 绿底白勾）。表头用 Button 版（Circle），点击行为
    // 由窗口接；数据行用 Dot 版——按钮会把点击吃掉，ListView 的
    // 行选中（Select）就不再触发，整行勾选会失灵。
    static Button Circle(bool on) {
        Button c = new Button("");
        if (on) { c.Icon = "check"; }
        c.Class = on ? "wxcircle on" : "wxcircle";
        return c;
    }

    // 数据行的勾选圈：纯视觉，点击穿透到行。
    static Flex Dot(bool on) {
        Flex d = new Flex();
        d.Class = on ? "wxcircle on" : "wxcircle";
        if (on) {
            d.Justify("center");
            d.Align("center");
            d.Add(new IconView("check", 12));
        }
        return d;
    }

    WxMgHeadRow() {
        this.InitControl("wxmgrow", 5);
        this.Class = "wxmghead";
        Flex row = Wx.Row("wxmgrowin");
        row.Grow();
        circleBtn = WxMgHeadRow.Circle(false);
        row.Add(circleBtn);
        row.Add(Wx.Lbl("昵称", "wxmgname grow"));
        row.Add(WxMgHeadRow.Col("备注", "wxmgc1", "wxmgheadcell"));
        row.Add(WxMgHeadRow.Col("标签", "wxmgc2", "wxmgheadcell"));
        row.Add(WxMgHeadRow.Col("朋友权限", "wxmgc3", "wxmgheadcell"));
        this.Add(row);
    }

    override string Kind() { return "WxMgHeadRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(40));
        prefW = app.Scale(700);
    }
}

// 朋友圈的一条帖子行：头像 + 名字 + 正文（长文折叠出「全文」）
// + 图墙 + 时间与「···」。行高按正文行数与图墙档位估算，翻「全文」
// 后由页面对 RequestRedraw 重新量行。
