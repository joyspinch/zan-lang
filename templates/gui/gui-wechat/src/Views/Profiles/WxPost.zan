using System;
using Gui;
using Gui.Widget;
using Gui.Component;

public class WxPost {
    string name;
    string ini;
    string tint;
    string text;
    bool full;  // 长文：未展开时截断并显示「全文」
    bool open;  // 用户点过「全文」
    int imgs;  // 图墙张数（0 = 纯文字；版式按 1/2/3/4/6 分档）
    string time;

    WxPost(string name, string ini, string tint, string text, bool full,
            int imgs, string time) {
        this.name = name;
        this.ini = ini;
        this.tint = tint;
        this.text = text;
        this.full = full;
        this.open = false;
        this.imgs = imgs;
        this.time = time;
    }

    static WxPost Of(string name, string ini, string tint, string text,
            bool full, int imgs, string time) {
        return new WxPost(name, ini, tint, text, full, imgs, time);
    }

    void ToggleOpen() { this.open = !this.open; }
}

// 资料卡与朋友圈的取数入口。
