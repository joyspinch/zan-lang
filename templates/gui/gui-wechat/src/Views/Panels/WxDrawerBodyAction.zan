using System;

class WxDrawerBodyAction {
    public weak WxDrawerBody owner;
    public string name;
    public string initial;
    public string tint;
    public void Ask() { WxDrawerBody body = owner; if (body != null) { body.Ask(); } }
    public void AskNamed() {
        WxDrawerBody body = owner;
        if (body != null) { body.AskNamed(name, initial, tint); }
    }
    public void Add() {
        WxDrawerBody body = owner;
        if (body != null && body.onAdd != null) { body.onAdd(); }
    }
}
