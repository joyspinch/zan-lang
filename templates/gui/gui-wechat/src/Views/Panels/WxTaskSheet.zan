using System;
using Gui;
using Gui.Widget;

public class WxTaskSheet : Control {
    Label titleLbl;
    Label statusLbl;
    Label ownerLbl;
    Label descLbl;
    Label progLbl;
    Flex evBox;

    static WxTaskSheet Of() { return new WxTaskSheet(); }

    WxTaskSheet() {
        this.InitControl("wxtasksheet", 4);
        this.Class = "wxprofile";
        this.visible = false;

        // 卡片本体是纵向流：标题条 / 分隔线 / 正文依次往下排。
        Flex root = Flex.Column();
        root.DockFill();
        this.Add(root);

        Flex head = Wx.Row("wxphead");
        Flex ht = Flex.Column();
        ht.AddClass("grow");
        ht.Grow();
        titleLbl = Wx.Lbl("任务", "wxpname");
        ht.Add(titleLbl);
        statusLbl = Wx.Lbl("", "wxpsub");
        ht.Add(statusLbl);
        head.Add(ht);
        Button dots = Wx.IconBtn("dots");
        dots.OnClick(() => { this.Hide(); });
        head.Add(dots);
        root.Add(head);
        root.Add(Wx.Line());

        Flex body = Wx.ColGrow("wxpbody");
        ownerLbl = Wx.Lbl("", "wxpsub");
        body.Add(ownerLbl);
        progLbl = Wx.Lbl("", "wxpsub");
        body.Add(progLbl);
        descLbl = Wx.Lbl("", "wxpval");
        body.Add(descLbl);
        body.Add(Wx.Line());
        body.Add(Wx.Lbl("动态", "wxemotitle"));
        evBox = Flex.Column();
        evBox.AddClass("grow");
        body.Add(evBox);
        root.Add(body);
    }

    // 详情没拉到前的占位（taskId 已带上，异步回填）。
    void ShowLoading() {
        titleLbl.Text = "任务";
        statusLbl.Text = "加载中…";
        ownerLbl.Text = "";
        progLbl.Text = "";
        descLbl.Text = "";
        evBox.RemoveAll();
        this.visible = true;
    }

    // 拉取失败就地改写（卡片还开着，用户看得见失败）。
    void ShowError(string msg) {
        statusLbl.Text = msg;
        evBox.RemoveAll();
        this.visible = true;
    }

    // 按 taskdetail 强类型实体摆卡（彻底消除对动态 JsonValue 树的遍历）。
    void ShowDetail(WxTaskDetail td) {
        if (td == null) { return; }
        titleLbl.Text = td.title;
        statusLbl.Text = WxIm.StatusZh(td.status);
        ownerLbl.Text = "创建 " + WxTaskSheet.Who(td.ownerId)
            + " · 负责 " + WxTaskSheet.Who(td.assigneeId);
        progLbl.Text = "进度 " + Convert.ToString(td.progress) + "%";
        descLbl.Text = td.description.Length > 0 ? td.description : "（无描述）";

        evBox.RemoveAll();
        int n = td.events != null ? td.events.Count : 0;
        int from = n > 8 ? n - 8 : 0;
        for (int i = n - 1; i >= from; i = i - 1) {
            WxTaskEventItem e = td.events[i];
            string line = WxIm.StatusZh(WxTaskSheet.EventZh(e.event))
                + " · " + WxIm.ClockOf(e.at);
            string why = e.reason;
            if (why.Length == 0) { why = e.content; }
            if (why.Length > 0) { line = line + "：" + why; }
            evBox.Add(Wx.Lbl(line, "wxpsub"));
        }
        if (n == 0) {
            evBox.Add(Wx.Lbl("暂无动态", "wxpsub"));
        }
        this.visible = true;
    }

    public void ShowLifecycleCard(string projectId, string projectNo, string projectName,
                                  string stage, string stageName, string respName, string aiRole,
                                  string status, string m1, string m2, string m3,
                                  string aiAdvice, string summary,
                                  Action onAdvance, Action onAi, Action onOpenWorkbench) {
        titleLbl.Text = stageName;
        statusLbl.Text = status == "passed" ? "【已核准通过】"
            : (status == "in_progress" ? "【正在推进中】"
            : (status == "rejected" ? "【已驳回】" : "【待开始】"));
        ownerLbl.Text = "责任人 @" + respName + " · 赋能 " + aiRole;
        progLbl.Text = "项目 " + projectNo + " · " + projectName;
        descLbl.Text = "核心指标:\n • " + m1 + "\n • " + m2 + "\n • " + m3;

        evBox.RemoveAll();
        if (aiAdvice.Length > 0) {
            evBox.Add(Wx.Lbl("AI 赋能建议", "wxemotitle"));
            evBox.Add(Wx.Lbl(aiAdvice, "wxpsub"));
        }
        if (summary.Length > 0) {
            evBox.Add(Wx.Lbl("阶段成果摘要", "wxemotitle"));
            evBox.Add(Wx.Lbl(summary, "wxpsub"));
        }
        evBox.Add(Wx.Line());

        if (status == "in_progress") {
            Button btnAdv = new Button("核准通过并流转下一阶段");
            btnAdv.OnClick(() => {
                if (onAdvance != null) { onAdvance(); }
            });
            evBox.Add(btnAdv);

            Button btnAi = new Button("AI 深度推演与协同赋能");
            btnAi.OnClick(() => {
                if (onAi != null) { onAi(); }
            });
            evBox.Add(btnAi);
        }

        Button btnBench = new Button("进入全链路项目工作台");
        btnBench.OnClick(() => {
            if (onOpenWorkbench != null) { onOpenWorkbench(); }
        });
        evBox.Add(btnBench);

        this.visible = true;
    }

    void Hide() {
        this.visible = false;
    }

    // 成员 id → 显示名（注册表认不出给「成员#id」）。
    static string Who(string idStr) {
        long id = Convert.ToInt64(idStr);
        if (id <= 0) { return "—"; }
        string key = "u:" + Convert.ToString(id);
        string nm = WxData.NameOf(key);
        if (nm != null) { return nm; }
        return "成员#" + Convert.ToString(id);
    }

    // 事件类型 → 中文（服务端 TaskLog 的 eventType 词典）。
    static string EventZh(string ev) {
        if (ev == "created") { return "创建"; }
        if (ev == "claimed") { return "认领"; }
        if (ev == "assigned") { return "转交"; }
        if (ev == "started") { return "开工"; }
        if (ev == "progress") { return "汇报进度"; }
        if (ev == "blocked") { return "阻塞"; }
        if (ev == "unblocked") { return "解除阻塞"; }
        if (ev == "submitted") { return "提交验收"; }
        if (ev == "approved") { return "验收通过"; }
        if (ev == "rejected") { return "验收驳回"; }
        if (ev == "cancelled") { return "取消"; }
        return ev;
    }
}
