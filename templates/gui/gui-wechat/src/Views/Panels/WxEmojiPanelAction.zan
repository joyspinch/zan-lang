using System;

class WxEmojiPanelAction {
    public weak WxEmojiPanel owner;
    public void Pick(int index) {
        WxEmojiPanel panel = owner;
        if (panel == null) { return; }
        if (index == panel.smileIdx) { panel.Pick(false); }
        if (index == panel.heartIdx) { panel.Pick(true); }
    }
}
