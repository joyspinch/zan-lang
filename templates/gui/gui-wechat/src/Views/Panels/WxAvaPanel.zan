using System;
using Gui;
using Gui.Widget;

public class WxAvaPanel {
    Flex root;

    static WxAvaPanel Of(Action<string> insert) {
        WxAvaPanel p = new WxAvaPanel();
        p.Build(insert);
        return p;
    }

    Control Root() { return root; }

    void Build(Action<string> insert) {
        root = Flex.Column();
        root.AddClass("wxavapanel");
        root.Add(Wx.Lbl("常用头像", "wxemotitle"));
        Flex grid = null;
        List<WxMate> ms = WxData.Mates();
        for (int i = 0; i < ms.Count; i = i + 1) {
            if (i % 4 == 0) {
                grid = Flex.Row();
                grid.AddClass("wxgrid");
                root.Add(grid);
            }
            grid.Add(Wx.MemberCell(ms[i].name, ms[i].ini, WxData.TintOf(i)));
        }
        root.Add(Wx.Lbl("聊天时常@的联系人格子", "wxemotitle"));
    }
}

// 任务详情卡：点聊天里的任务卡片弹出。dock 4 右缘浮卡，
// 与资料名片同一互斥组（宿主弹卡前收抽屉/弹出面板）；外观复用名片
// 那套 wxp* 皮肤类。数据来自 /api/collab/taskdetail 的 data 节点，
// 拉取与失败改写由宿主负责（WxIm.FetchTaskCard → WeChatChat）。
