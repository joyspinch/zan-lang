using System;
using Gui;
using Gui.Component;
using Gui.Widget;

public class WxHistoryWindow : ChildWindow {
    // 同时只留一扇：换会话就地把内容换掉，不叠第二扇。
    static WxHistoryWindow live;
    static WxSession cur;
    WxSession sess;
    App owner;
    int count;
    ListView<WxHistRow> lv;

    override string Title() {
        return "「" + sess.name + "」的聊天记录(" + Convert.ToString(count) + ")";
    }
    override int Width() { return 720; }
    override int Height() { return 560; }
    override bool ShowMaximize() { return false; }
    override int IdBase() { return 950000; }

    // 打开（私聊/群聊同一扇）：会话相同只拉前台，不同就重建内容。
    static void Open(App app, WxSession s) {
        if (WxHistoryWindow.live != null && WxHistoryWindow.live.IsOpen()) {
            if (WxHistoryWindow.cur == s) {
                WxHistoryWindow.live.RequestRedraw();
                return;
            }
            WxHistoryWindow.live.Close();
        }
        WxHistoryWindow w = new WxHistoryWindow();
        w.sess = s;
        w.owner = app;
        w.Build();
        WxHistoryWindow.live = w;
        WxHistoryWindow.cur = s;
    }

    // 共享会话记录 → 记录窗口的行。数据就是会话模型里那份：主窗口
    // 与浮窗发的每一条、服务端轮询并进来的每一条都在——记录窗与
    // 聊天区看到的历史从此一致，不再有虚构语料补长。`q` 非空时按
    // 正文过滤。
    List<WxHistRow> RowsOf(string q) {
        List<WxHistRow> rows = new List<WxHistRow>();
        for (int i = 0; i < sess.msgs.Count; i = i + 1) {
            ChatMessage m = sess.msgs[i];
            if (q.Length > 0 && m.text.IndexOf(q) < 0) { continue; }
            string who = "我";
            string ini = "我";
            string tint = "primary";
            if (m.role != "user") {
                tint = sess.tint;
                who = sess.name;
                ini = sess.initial;
                if (m.agent != "") {
                    string n = WxData.NameOf(m.agent);
                    if (n != null) { who = n; }
                    string t = WxData.IniOf(m.agent);
                    if (t != "") { ini = t; }
                    tint = WxData.TintOfId(m.agent);
                }
            }
            // 日期与列表一致：今天 HH:MM、更早 MM-dd；发送中的气泡
            // （服务端 id 还没回来，at=0）留空。
            string date = m.at > 0 ? WxIm.ClockOf(Convert.ToString(m.at)) : "";
            rows.Add(WxHistRow.Of(who, ini, m.text, date, tint));
        }
        return rows;
    }

    void Build() {
        Flex root = Wx.Col("wxhist");

        Flex head = Wx.Row("wxhisthead");
        Input q = new Input("搜索");
        q.Class = "grow";
        // 每次编辑就地重筛：行是纯展示模型，重 Bind 即可。
        q.BindEvent("Change", () => { this.Rebind(q.GetText()); });
        head.Add(q);
        root.Add(head);

        ToolStrip ts = new ToolStrip();
        ts.Class = "wxhisttabs";
        string[] names = new string[]{ "文件", "图片与视频", "链接", "音乐",
            "小程序", "视频号", "日期" };
        for (int i = 0; i < names.Length; i = i + 1) {
            ts.Add(names[i], "");
        }
        if (sess.group) { ts.Add("群成员", ""); }
        for (int i = 0; i < ts.Count(); i = i + 1) {
            Wx.Item(ts, i).AddClass(i == 0 ? "wxhisttab wxon" : "wxhisttab");
        }
        ts.OnItemClick((i) => {
            for (int j = 0; j < ts.Count(); j = j + 1) {
                Wx.Item(ts, j).SetClassIn("wxon", j == i ? "wxon" : "");
            }
            this.RequestRedraw();
        });
        root.Add(ts);
        root.Add(Wx.Line());

        lv = new ListView<WxHistRow>(WxHistRowTpl.Of);
        lv.Class = "wxhistlist grow";
        lv.Grow();
        root.Add(lv);

        this.SetRoot(root, null);
        this.Wire();
        this.OpenHost(this.owner);
        // 子窗口是另一个 App：主窗口铺的 .wx* 应用样式表要再铺一遍。
        this.host.UseAppCss(WxSkin.Css());
        this.Rebind("");
        this.RequestRedraw();
    }

    // 按关键字重筛并重绑（搜索框每次编辑与首次打开都走这）。计数
    // 不含空态占位行。
    void Rebind(string q) {
        List<WxHistRow> rows = this.RowsOf(q);
        count = rows.Count;
        if (rows.Count == 0) {
            rows.Add(WxHistRow.Of("", "",
                q.Length > 0 ? "没有匹配的聊天记录" : "还没有聊天记录", "", ""));
        }
        lv.Bind(rows);
        this.RequestRedraw();
    }
}


// 「通讯录管理」的界面本体：左导航（全部 + 筛选，朋友权限可再展开
// 三档）+ 勾选式联系人表格 + 底部批量操作栏（修改权限/设置标签/删除
// 只作用于勾选行，操作后计数与表格就地刷新）。做成独立控件树——
// 与 WxSettingsView 同一个路数：窗口只当外壳，这棵树也能直接长在
// 主窗口里（探针驱动就是这么验证交互的）。
