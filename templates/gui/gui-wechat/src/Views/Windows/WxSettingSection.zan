using System;
using Gui;
using Gui.Component;
using Gui.Widget;

public class WxSettingSection {
    public string title;
    public Flex panel;
    public Button navBtn;

    public WxSettingSection(string title, Flex panel) {
        this.title = title;
        this.panel = panel;
        this.navBtn = null;
    }
}

