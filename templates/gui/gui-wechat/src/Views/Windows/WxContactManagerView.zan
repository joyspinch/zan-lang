using System;
using Gui;
using Gui.Component;
using Gui.Widget;

// 通讯录管理窗口的界面本体：左导航（全部 + 权限筛选折叠组 + 两个入口）、
// 右栏（搜索 + 表头 + 联系人表格）、底栏（已选计数 + 批量操作）。
//
// 骨架（导航列/右栏/底栏/表格宿主）在 WxContactManagerView.html 里，
// 文档负责结构与骨架样式；表头行、表格（ListView）与底栏的图标操作格
// 由本类建（数据驱动的动态控件），它们的样式走皮肤全局规则。
public class WxContactManagerView : Control {
    List<WxMgRow> rows;  // 全量数据（删行从这里扣）
    List<WxMgRow> shown;  // 按权限筛选后的可见行
    string filter;  // "" = 全部，否则是权限档名
    ListView<WxMgRow> table;
    Button allBtn;
    Button permHeadBtn;
    Button[] permBtns;
    string[] permNames;
    IconView permChev;
    Control permBox;
    Button headAll;
    Label countLbl;
    Input search;
    Control ui;  // 文档建出来的骨架树

    WxContactManagerView() {
        this.InitControl("wxmg", 5);
        rows = WxData.Manager();
        shown = new List<WxMgRow>();
        filter = "";
        this.Build();
    }

    void Build() {
        // ---- 文档骨架 ----
        HtmlHandlers hs = new HtmlHandlers();
        hs.Add("filter-all", () => { this.SetFilter(""); });
        hs.Add("toggle-perm", () => { this.TogglePerm(); });
        for (int i = 0; i < 3; i = i + 1) {
            int idx = i;
            hs.Add("perm-" + Convert.ToString(i), () => { this.SetFilter(this.PermName(idx)); });
        }
        hs.Add("clear", () => { this.ClearPicked(); });
        ui = WxContactManagerViewHtml.Build(hs);
        ui.DockFill();
        this.Add(ui);

        // ---- 左栏：全部 + 筛选 ----
        allBtn = (Button)ui.Find("MgAll");
        permHeadBtn = (Button)ui.Find("MgPermHead");
        permBox = ui.Find("MgPermBox");
        permBtns = new Button[]{ (Button)ui.Find("MgPerm0"),
            (Button)ui.Find("MgPerm1"), (Button)ui.Find("MgPerm2") };
        permNames = new string[]{ "仅聊天", "不让他（她）看", "不看他（她）" };
        // 箭头是图标控件（HTML 里没有对应标签），挂进文档给的槽位。
        permChev = new IconView("chevron-down", 14);
        Control chevHost = ui.Find("MgChev");
        if (chevHost != null) { chevHost.Add(permChev); }
        permChev.OnClick(() => { this.TogglePerm(); });

        // ---- 右栏：搜索 + 表头 + 表格 ----
        search = (Input)ui.Find("MgSearch");
        WxMgHeadRow head = new WxMgHeadRow();
        headAll = head.Circle();
        headAll.OnClick(() => { this.ToggleAll(); });
        Control headHost = ui.Find("MgHead");
        if (headHost != null) { headHost.Add(head); }
        table = new ListView<WxMgRow>(WxMgRowTpl.Of);
        table.Class = "wxmgtable grow";
        table.Grow();
        table.Bind(shown);
        table.OnSelect(() => {
            int i = table.SelectedIndex();
            if (i < 0 || i >= shown.Count) { return; }
            shown[i].picked = !shown[i].picked;
            table.Refresh();
            this.UpdateBar();
        });
        Control tableHost = ui.Find("MgTable");
        if (tableHost != null) { tableHost.Add(table); }

        // ---- 底部：已选计数 + 批量操作 ----
        countLbl = Wx.Lbl("已选择 0 人", "wxmgcount");
        Control countHost = ui.Find("MgCount");
        if (countHost != null) { countHost.Add(countLbl); }
        // 三个操作格（图标在上、文字在下），顺序与原版一致：
        // 修改权限、设置标签、删除（删除最靠右）。
        this.MountOp("MgOp1", "lock", "修改权限", () => { this.DoPerm(); });
        this.MountOp("MgOp2", "tag", "设置标签", () => { this.DoTag(); });
        this.MountOp("MgOp3", "trash", "删除", () => { this.DoDelete(); });

        this.ApplyFilter();
        this.UpdateCounts();
        this.UpdateBar();
    }

    // 底部的一个操作：图标在文字上方的竖排按钮（整格可点）。
    void MountOp(string hostId, string icon, string txt, Action run) {
        Flex op = Flex.Column();
        op.AddClass("wxmgop");
        op.Align("center");
        IconView ic = new IconView(icon, 18);
        Label tl = Wx.Lbl(txt, "wxmgoptext");
        op.OnClick(run);
        ic.OnClick(run);
        tl.OnClick(run);
        op.Add(ic);
        op.Add(tl);
        Control host = ui.Find(hostId);
        if (host != null) { host.Add(op); }
    }

    // 权限档名（折叠组里的三项，顺序与文档里的按钮一致）。
    string PermName(int i) {
        if (i < 0 || i >= permNames.Length) { return ""; }
        return permNames[i];
    }

    // 展开/收起权限折叠组。
    void TogglePerm() {
        if (permBox == null) { return; }
        permBox.visible = !permBox.visible;
        permChev.Name = permBox.visible ? "chevron-down" : "chevron-right";
    }

    int PickedCount() {
        int n = 0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].picked) { n = n + 1; }
        }
        return n;
    }

    int PermCount(string perm) {
        int n = 0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].perm == perm) { n = n + 1; }
        }
        return n;
    }

    void UpdateBar() {
        countLbl.Text = "已选择 " + Convert.ToString(this.PickedCount()) + " 人";
    }

    // 左栏计数与选中态：全部按钮 + 三档权限按钮的文字里带条数。
    void UpdateCounts() {
        allBtn.Text = "全部 (" + Convert.ToString(rows.Count) + ")";
        for (int i = 0; i < permBtns.Length; i = i + 1) {
            permBtns[i].Text = permNames[i] + " ("
                + Convert.ToString(this.PermCount(permNames[i])) + ")";
        }
        this.RestyleSide();
    }

    // 侧栏选中态只亮一个：全部或某档权限。
    void RestyleSide() {
        bool allOn = filter == "";
        allBtn.SetClassIn("wxon", allOn ? "wxon" : "");
        for (int i = 0; i < permBtns.Length; i = i + 1) {
            bool on = filter == permNames[i];
            permBtns[i].SetClassIn("wxon", on ? "wxon" : "");
        }
    }

    void SetFilter(string f) {
        filter = f;
        this.RestyleSide();
        this.ApplyFilter();
    }

    void ApplyFilter() {
        shown.Clear();
        for (int i = 0; i < rows.Count; i = i + 1) {
            WxMgRow r = rows[i];
            if (filter == "" || r.perm == filter) { shown.Add(r); }
        }
        table.Bind(shown);
        table.Refresh();
    }

    void ToggleAll() {
        bool any = false;
        for (int i = 0; i < shown.Count; i = i + 1) {
            if (!shown[i].picked) { any = true; break; }
        }
        for (int i = 0; i < shown.Count; i = i + 1) {
            shown[i].picked = any;
        }
        if (headAll != null) {
            headAll.Icon = any ? "check" : "";
            headAll.SetClassIn("on", any ? "on" : "");
        }
        table.Refresh();
        this.UpdateBar();
    }

    void ClearPicked() {
        for (int i = 0; i < rows.Count; i = i + 1) { rows[i].picked = false; }
        if (headAll != null) {
            headAll.Icon = "";
            headAll.SetClassIn("on", "");
        }
        table.Refresh();
        this.UpdateBar();
    }

    // 批量把勾选行改成仅聊天（演示「修改权限」；权限变了，筛选项
    // 的计数与可见行都要跟着刷新）。
    void DoPerm() {
        bool hit = false;
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].picked) { rows[i].perm = "仅聊天"; hit = true; }
        }
        if (!hit) { return; }
        this.ApplyFilter();
        this.UpdateCounts();
        this.UpdateBar();
    }

    void DoTag() {
        bool hit = false;
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].picked) { rows[i].tag = "常用"; hit = true; }
        }
        if (hit) { table.Refresh(); }
    }

    void DoDelete() {
        List<WxMgRow> keep = new List<WxMgRow>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (!rows[i].picked) { keep.Add(rows[i]); }
        }
        rows = keep;
        this.ApplyFilter();
        this.UpdateCounts();
        this.UpdateBar();
    }
}

// 通讯录管理窗口：通讯录页左上「通讯录管理」打开的独立子窗口（原版
// 的同名窗口），界面本体是 WxContactManagerView 这棵控件树，窗口
// 只负责外壳：标题、尺寸、铺样式表。
