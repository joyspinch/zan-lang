using System;
using Gui;
using Gui.Component;
using Gui.Widget;

public class WxSettingsWindow : ChildWindow {
    // 同时只留一扇设置窗：已经开着就重绘现有的，不叠第二扇。
    static WxSettingsWindow live;
    App owner;
    WxSettingsView view;

    override string Title() { return "设置"; }
    // 原版设置窗是一扇窄窗：左导航 166 + 右正文，760 足够。
    override int Width() { return 760; }
    override int Height() { return 620; }
    // 设置窗不是工作区，不要最大化按钮（最小化/关闭照常）。
    override bool ShowMaximize() { return false; }
    override int IdBase() { return 910000; }

    // 打开设置窗（主窗口导航栏的齿轮按钮调用）。
    static void Open(App app) {
        if (WxSettingsWindow.live != null && WxSettingsWindow.live.IsOpen()) {
            WxSettingsWindow.live.RequestRedraw();
            return;
        }
        WxSettingsWindow w = new WxSettingsWindow();
        w.owner = app;
        w.view = new WxSettingsView(app);
        // 纯代码建树：没有设计稿的 bind 通道，model 传 null。
        w.SetRoot(w.view, null);
        w.Wire();
        w.OpenHost(app);
        // 子窗口是另一个 App，主窗口用 UseAppCss 铺的 .wx* 类不会自动
        // 跟过来；外壳类与正文类都在同一张 WxSkin 表里，铺同一份即可。
        // 设置窗的骨架样式在自己的文档里（WxSettingsView.html），它的
        // 作用域类只认这份 CSS，所以两份一起铺（UseAppCss 是整表替换）。
        w.host.UseAppCss(WxSkin.Css());
        w.RequestRedraw();
        WxSettingsWindow.live = w;
    }
}

// 独立聊天窗口：把会话行拖出主窗口后，这条会话开成一扇自己的子窗口
// （原版微信的「拖出来成独立窗口」）。窗口里是一份完整会话视图——
// 标题 + 气泡记录 + 输入区——数据与主窗口共享同一个 `WxSession`，
// 因此两边看到的是同一份记录；在这里发送后由 `notify` 让主窗口刷新
// 列表摘要与当前会话。
