using System;
using Gui;
using Gui.Component;
using Gui.Widget;

// 设置层窗口的界面本体：左导航 + 右侧六个分区（只显示当前分区，
// 六个分区共用同一棵保留树，切换不重建控件）。
//
// 骨架（导航列、六个分区壳、分区小标题）在 WxSettingsView.html 里，
// 文档负责结构与骨架样式；分区里的「键 + 值/控件」行由本类建
// （行里有 Switch/SelectBox 这类标准控件，HTML 标签映射里没有
// Switch），行的样式走皮肤全局规则。
public class WxSettingsView : Control {
    // 导航钮与分区容器都是文档里的元素（按 id 找回来）。
    List<Control> navBtns;
    List<Control> secs;
    int cur;

    WxSettingsView(App app) {
        this.InitControl("wxSettingsView", 5);

        HtmlHandlers hs = new HtmlHandlers();
        for (int i = 0; i < 6; i = i + 1) {
            int idx = i;
            hs.Add("pick-" + Convert.ToString(i), () => { this.Pick(idx); });
        }
        Control ui = WxSettingsViewHtml.Build(hs);
        ui.DockFill();
        this.Add(ui);

        navBtns = new List<Control>();
        secs = new List<Control>();
        for (int i = 0; i < 6; i = i + 1) {
            navBtns.Add(ui.Find("Nav" + Convert.ToString(i)));
            secs.Add(ui.Find("Sec" + Convert.ToString(i)));
        }

        // 分区内容（行）进各自的行容器。
        this.Fill(ui, "Sec0Body", this.SecAccount(app));
        this.Fill(ui, "Sec1Body", this.SecGeneral(app));
        this.Fill(ui, "Sec2Body", this.SecKeys(app));
        this.Fill(ui, "Sec3Body", this.SecNotify(app));
        this.Fill(ui, "Sec4Body", this.SecPlugins(app));
        this.Fill(ui, "Sec5Body", this.SecAbout(app));

        this.Pick(0);
    }

    // 把分区行挂进文档里的行容器；找不到容器就退回本控件（骨架改了
    // id 只可能是我改错了文档——别让整扇窗空掉）。
    void Fill(Control ui, string hostId, Flex rows) {
        Control host = ui.Find(hostId);
        if (host == null) { host = ui; }
        host.Add(rows);
    }

    void Pick(int i) {
        if (i < 0 || i >= secs.Count) { return; }
        cur = i;
        for (int k = 0; k < secs.Count; k = k + 1) {
            secs[k].visible = k == i;
            Control b = navBtns[k];
            if (b != null) {
                // SetClassIn 只换「wxon」这一族，文档作用域类不会被抹掉
                // （Class = 整串覆盖会把作用域类冲掉，样式全丢）。
                b.SetClassIn("wxon", k == i ? "wxon" : "");
            }
        }
    }

    Flex SecAccount(App app) {
        Flex s = Wx.Col("");
        Flex r0 = Wx.Row("wxsetrow");
        r0.Add(Wx.Lbl("退出登录", "wxsetkey grow"));
        Button quit = new Button("退出登录");
        quit.Class = "danger";
        r0.Add(quit);
        s.Add(r0);
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("登录方式", "自动"));
        s.Add(Wx.Line());
        Flex r2 = Wx.Row("wxsetrow");
        r2.Add(Wx.Lbl("保留聊天记录", "wxsetkey grow"));
        Switch keep = new Switch();
        keep.SetOn(false);
        r2.Add(keep);
        s.Add(r2);
        s.Add(Wx.Line());
        Flex r3 = Wx.Row("wxsetrow");
        r3.Add(Wx.Lbl("存储空间", "wxsetkey grow"));
        r3.Add(Wx.Lbl("已使用 148.6M", "wxsetval"));
        r3.Add(new Button("管理"));
        s.Add(r3);
        s.Add(Wx.Line());
        Flex r4 = Wx.Row("wxsetrow");
        r4.Add(Wx.Lbl("存储位置", "wxsetkey grow"));
        r4.Add(Wx.Lbl("D:\\微聊\\数据", "wxsetval"));
        r4.Add(new Button("更改"));
        s.Add(r4);
        s.Add(Wx.Line());
        Flex r5 = Wx.Row("wxsetrow");
        r5.Add(Wx.Lbl("自动下载小于", "wxsetkey grow"));
        SelectBox limit = new SelectBox("20 MB");
        limit.AddOption("5 MB");
        limit.AddOption("10 MB");
        limit.AddOption("20 MB");
        limit.AddOption("50 MB");
        r5.Add(limit);
        r5.Add(Wx.Lbl("的文件", "wxsetkey"));
        Switch dl = new Switch();
        dl.SetOn(true);
        r5.Add(dl);
        s.Add(r5);
        s.Add(Wx.Line());
        return s;
    }

    Flex SecGeneral(App app) {
        Flex s = Wx.Col("");
        s.Add(WxRow.Kv("语言", "简体中文"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("字体大小", "标准"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("皮肤", "跟随系统"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("界面缩放", "100%"));
        s.Add(Wx.Line());
        return s;
    }

    Flex SecKeys(App app) {
        Flex s = Wx.Col("");
        s.Add(WxRow.Kv("发送消息", "Enter"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("换行", "Ctrl + Enter"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("截图", "Alt + A"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("锁定", "Ctrl + L"));
        s.Add(Wx.Line());
        return s;
    }

    Flex SecNotify(App app) {
        Flex s = Wx.Col("");
        Flex r0 = Wx.Row("wxsetrow");
        r0.Add(Wx.Lbl("新消息提醒", "wxsetkey grow"));
        Switch n1 = new Switch();
        n1.SetOn(true);
        r0.Add(n1);
        s.Add(r0);
        s.Add(Wx.Line());
        Flex r1 = Wx.Row("wxsetrow");
        r1.Add(Wx.Lbl("声音", "wxsetkey grow"));
        Switch n2 = new Switch();
        n2.SetOn(true);
        r1.Add(n2);
        s.Add(r1);
        s.Add(Wx.Line());
        Flex r2 = Wx.Row("wxsetrow");
        r2.Add(Wx.Lbl("免打扰时段", "wxsetkey grow"));
        r2.Add(Wx.Lbl("23:00 - 07:00", "wxsetval"));
        s.Add(r2);
        s.Add(Wx.Line());
        return s;
    }

    Flex SecPlugins(App app) {
        Flex s = Wx.Col("");
        s.Add(WxRow.Kv("剪贴板增强", "已启用"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("代码片段", "已启用"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("插件市场", "浏览"));
        s.Add(Wx.Line());
        return s;
    }

    Flex SecAbout(App app) {
        Flex s = Wx.Col("");
        s.Add(WxRow.Kv("版本", "1.0.0 (build 20260911)"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("内核", "Zan / Gui 标准库"));
        s.Add(Wx.Line());
        Flex r2 = Wx.Row("wxsetrow");
        r2.Add(Wx.Lbl("检查更新", "wxsetkey grow"));
        r2.Add(new Button("检查"));
        s.Add(r2);
        s.Add(Wx.Line());
        s.Add(Wx.Lbl("示例数据全部虚构，与任何真实账号无关。", "wxhint"));
        return s;
    }

    override string Kind() { return "WxSettingsView"; }
}
