using System;
using Gui;
using Gui.Component;
using Gui.Widget;

public class WxSettingsView : Control {
    Panel body;
    List<WxSettingSection> sections;
    int cur;

    WxSettingsView(App app) {
        this.InitControl("wxSettingsView", 5);
        this.Class = "wxset";
        Panel nav = Wx.Col("wxsetnav");
        body = Wx.Col("wxsetbody");
        body.Grow();
        this.Add(nav);
        this.Add(body);

        sections = new List<WxSettingSection>();
        sections.Add(new WxSettingSection("账号与存储", this.SecAccount(app)));
        sections.Add(new WxSettingSection("通用", this.SecGeneral(app)));
        sections.Add(new WxSettingSection("快捷键", this.SecKeys(app)));
        sections.Add(new WxSettingSection("通知", this.SecNotify(app)));
        sections.Add(new WxSettingSection("插件", this.SecPlugins(app)));
        sections.Add(new WxSettingSection("关于微信", this.SecAbout(app)));

        for (int i = 0; i < sections.Count; i = i + 1) {
            WxSettingSection sec = sections[i];
            body.Add(sec.panel);

            Button b = new Button(sec.title);
            b.Class = "wxsetnavbtn";
            nav.Add(b);
            sec.navBtn = b;

            int idx = i;
            b.OnClick(() => { this.Pick(idx); });
        }
        this.Pick(0);
    }

    void Pick(int i) {
        if (i < 0 || i >= sections.Count) { return; }
        cur = i;
        for (int k = 0; k < sections.Count; k = k + 1) {
            WxSettingSection sec = sections[k];
            sec.panel.visible = k == i;
            if (sec.navBtn != null) {
                sec.navBtn.Class = Wx.NavCls(k == i);
            }
        }
    }

    Panel SecAccount(App app) {
        Panel s = Wx.Col("");
        s.Grow();
        s.Add(Wx.Sec("账号"));
        Flex r0 = Wx.Row("wxsetrow");
        r0.Add(Wx.Lbl("退出登录", "wxsetkey grow"));
        Button quit = new Button("退出登录");
        quit.Class = "danger";
        r0.Add(quit);
        s.Add(r0);
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("登录方式", "自动"));
        s.Add(Wx.Line());
        Flex r2 = Wx.Row("wxsetrow");
        r2.Add(Wx.Lbl("保留聊天记录", "wxsetkey grow"));
        Switch keep = new Switch();
        keep.SetOn(false);
        r2.Add(keep);
        s.Add(r2);
        s.Add(Wx.Line());
        Flex r3 = Wx.Row("wxsetrow");
        r3.Add(Wx.Lbl("存储空间", "wxsetkey grow"));
        r3.Add(Wx.Lbl("已使用 148.6M", "wxsetval"));
        r3.Add(new Button("管理"));
        s.Add(r3);
        s.Add(Wx.Line());
        Flex r4 = Wx.Row("wxsetrow");
        r4.Add(Wx.Lbl("存储位置", "wxsetkey grow"));
        r4.Add(Wx.Lbl("D:\\微聊\\数据", "wxsetval"));
        r4.Add(new Button("更改"));
        s.Add(r4);
        s.Add(Wx.Line());
        Flex r5 = Wx.Row("wxsetrow");
        r5.Add(Wx.Lbl("自动下载小于", "wxsetkey grow"));
        SelectBox limit = new SelectBox("20 MB");
        limit.AddOption("5 MB");
        limit.AddOption("10 MB");
        limit.AddOption("20 MB");
        limit.AddOption("50 MB");
        r5.Add(limit);
        r5.Add(Wx.Lbl("的文件", "wxsetkey"));
        Switch dl = new Switch();
        dl.SetOn(true);
        r5.Add(dl);
        s.Add(r5);
        s.Add(Wx.Line());
        return s;
    }

    Panel SecGeneral(App app) {
        Panel s = Wx.Col("");
        s.Grow();
        s.Add(Wx.Sec("外观"));
        s.Add(WxRow.Kv("语言", "简体中文"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("字体大小", "标准"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("皮肤", "跟随系统"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("界面缩放", "100%"));
        s.Add(Wx.Line());
        return s;
    }

    Panel SecKeys(App app) {
        Panel s = Wx.Col("");
        s.Grow();
        s.Add(Wx.Sec("发送与截图"));
        s.Add(WxRow.Kv("发送消息", "Enter"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("换行", "Ctrl + Enter"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("截图", "Alt + A"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("锁定", "Ctrl + L"));
        s.Add(Wx.Line());
        return s;
    }

    Panel SecNotify(App app) {
        Panel s = Wx.Col("");
        s.Grow();
        s.Add(Wx.Sec("消息提醒"));
        Flex r0 = Wx.Row("wxsetrow");
        r0.Add(Wx.Lbl("新消息提醒", "wxsetkey grow"));
        Switch n1 = new Switch();
        n1.SetOn(true);
        r0.Add(n1);
        s.Add(r0);
        s.Add(Wx.Line());
        Flex r1 = Wx.Row("wxsetrow");
        r1.Add(Wx.Lbl("声音", "wxsetkey grow"));
        Switch n2 = new Switch();
        n2.SetOn(true);
        r1.Add(n2);
        s.Add(r1);
        s.Add(Wx.Line());
        Flex r2 = Wx.Row("wxsetrow");
        r2.Add(Wx.Lbl("免打扰时段", "wxsetkey grow"));
        r2.Add(Wx.Lbl("23:00 - 07:00", "wxsetval"));
        s.Add(r2);
        s.Add(Wx.Line());
        return s;
    }

    Panel SecPlugins(App app) {
        Panel s = Wx.Col("");
        s.Grow();
        s.Add(Wx.Sec("已安装的插件"));
        s.Add(WxRow.Kv("剪贴板增强", "已启用"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("代码片段", "已启用"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("插件市场", "浏览"));
        s.Add(Wx.Line());
        return s;
    }

    Panel SecAbout(App app) {
        Panel s = Wx.Col("");
        s.Grow();
        s.Add(Wx.Sec("版本信息"));
        s.Add(WxRow.Kv("版本", "1.0.0 (build 20260911)"));
        s.Add(Wx.Line());
        s.Add(WxRow.Kv("内核", "Zan / Gui 标准库"));
        s.Add(Wx.Line());
        Flex r2 = Wx.Row("wxsetrow");
        r2.Add(Wx.Lbl("检查更新", "wxsetkey grow"));
        r2.Add(new Button("检查"));
        s.Add(r2);
        s.Add(Wx.Line());
        s.Add(Wx.Lbl("示例数据全部虚构，与任何真实账号无关。", "wxhint"));
        return s;
    }

    override string Kind() { return "WxSettingsView"; }
}
