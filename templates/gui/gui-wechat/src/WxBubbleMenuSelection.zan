using System;
using Gui;
using Gui.Component;
using Gui.Widget;

// 事件表强持有 action，action 只借用页面，避免菜单反向留住页面。
class WxBubbleMenuSelection {
    public weak WxPageChat owner;
    public int epoch;
    public WxSession session;
    public ChatMessage message;
    public int index;
    public string text;

    public void Run(Control sender) {
        WxPageChat page = owner;
        ContextMenu menu = sender as ContextMenu;
        if (page == null || menu == null) { return; }
        page.ApplyBubbleMenu(epoch, session, message, index, text, menu.SelectedAction());
    }
}
