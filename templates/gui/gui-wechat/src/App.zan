using System;
using Gui;
using Gui.Widget;
using Gui.Component;

/* {{NAME}}：微聊——微信风格的三栏桌面客户端外壳。
 *
 * 界面结构（HTML+CSS 改造：主窗骨架在 App.html 运行期文档里，
 * GenHtml 编译期生成 {{NAME}}Html 建树类（类名 = 入口文档基名帕斯卡化 + Html，{{NAME}} 脚手架时替换）；业务在下面）：
 *   左侧  RailHost   图标导航栏（聊天 / 通讯录 / 收藏 / 朋友圈 + 底部设置）
 *   右侧  ChatHost / ContactsHost / FavsHost / MomHost
 *                    四页叠在同一块矩形里，只让当前页可见
 *   设置  由 WxSettingsWindow 打开的一扇独立子窗口
 *
 * 组件全部来自标准库：会话/联系人/收藏/筛选项四种列表行是自定义
 * Control + ListView 的行模板；聊天区是 ChatView 的气泡模式；
 * 设置与会话浮窗是 Gui.ChildWindow 子窗口。示例数据见 WeChatData.zan，
 * 全部虚构。
 */
partial class {{NAME}} {
    static WxPageChat chatPage;
    static WxPageContacts contactsPage;
    static WxPageFavorites favsPage;
    static WxPageMoments momPage;

    /// HTML 文档建树出来的骨架节点（Pick 翻页用）。
    static Control RailHost;
    static Control ChatHost;
    static Control ContactsHost;
    static Control FavsHost;
    static Control MomHost;
    static Button RailChat;
    static Button RailContacts;
    static Button RailFavs;
    static Button RailMoments;
    static Button RailSettings;

    static void OnLoad(Form form) {
        App app = form.GetApp();
        // 界面自己的排版节奏与自有类外观（颜色仍走皮肤 token）；
        // 主窗骨架文档的 <style> 已在 Root() 里并入 appCss。
        chatPage = new WxPageChat();
        // 会话行拖出列表 → 该会话开成一扇独立子窗口。
        chatPage.UseDetach(app);
        ChatHost.Add(chatPage);
        contactsPage = new WxPageContacts();
        contactsPage.UseApp(app);
        ContactsHost.Add(contactsPage);
        favsPage = new WxPageFavorites();
        FavsHost.Add(favsPage);
        momPage = new WxPageMoments();
        momPage.UseApp(app);
        MomHost.Add(momPage);

        // 导航栏的图标按钮刻意钉死了尺寸（64×46）——这正是布局自检里
        // 「刻意定尺寸」的场景（图标按钮/画布图元/分隔条），按约定挂
        // FreeLayout() 免检；文字按钮一律不钉尺寸，让皮肤内边距自算。
        RailChat.FreeLayout();
        RailContacts.FreeLayout();
        RailFavs.FreeLayout();
        RailMoments.FreeLayout();
        RailSettings.FreeLayout();
        // 悬停提示像微信那样出现在图标右侧（窄栏上朝下的气泡容易被
        // 状态栏/任务栏截住）。
        RailChat.TipSide = "right";
        RailContacts.TipSide = "right";
        RailFavs.TipSide = "right";
        RailMoments.TipSide = "right";
        RailSettings.TipSide = "right";

        // 登录门：登录小窗在主窗口 Show 之前用独立事件泵跑（见
        // WxLoginWindow.Run）——这里返回 true 才继续往下走，主窗口
        // 才会打开。把登录窗直接关掉视为"还没登录"，重新拉起：
        // 进程内没有干净的"放弃启动"出口，门必须闩住。
        while (!WxLoginWindow.Run()) { }

        // 登录成功：把聊天页接上服务端数据（WxIm 桥共享页里的模型），
        // 首拉一次会话列表，再开轮询节拍（打开的会话每拍拉流，列表
        // 与未读徽标每 3 拍重拉——轮询就是客户端的"实时"）。
        WxIm.Use(chatPage.Model(), chatPage);
        WxIm.RefreshChats(null);
        form.Every(1500, () => { WxIm.Beat(); });
        // 网络应答的并入点：Poll 在这里把回调跑在 UI 线程上。
        form.Every(90, () => {
            if (WxNet.Poll()) { app.RequestRedraw(); }
        });

        // 未读徽标：叠在导航栏「聊天」图标右上角的计数胶囊（零未读
        // 藏起来）。徽标不进停靠流，自由定位钉在按钮角上；宿主按钮
        // 自己钉了尺寸，这里也照挂免检牌。
        railBadge = new Badge(0);
        railBadge.DockManual();
        railBadge.NoOverlapCheck();
        railBadge.visible = false;
        RailHost.Add(railBadge);
        Form hostForm = form;
        WxIm.OnBadge(() => { SyncBadge(hostForm); });
        contactsPage.RefreshServerContacts();

        Pick(0);
    }

    /// 进程入口：GenHtml 运行期文档通道没有 GenForm 那样的 Main
    /// 生成（那是设计稿 emitMain 的产物），这里手写同形的一套——
    /// 建窗、挂骨架、跑 OnLoad、进事件循环。
    static void Main() {
        {{NAME}}.Show();
    }

    /// 建主窗口（骨架 + OnLoad），交给调用方 Run。独立出来的
    /// 意义与 GenForm 的 __CreateWindow 一致：别的窗口想先调整
    /// 再运行也有挂点。
    static Form Show() {
        Form form = Form.Create("微聊", 1180, 760);
        form.GetApp().CenterWindow();
        form.Add({{NAME}}.Root(form));
        form.Run();
        return form;
    }

    /// 把 HTML 骨架接上窗口：UseAppCss（文档 <style> + 皮肤）→
    /// 建树接线 → 找回挂点补行为配置 → OnLoad 装配业务页。GenForm
    /// 时代这段由生成器发射（__BuildForm + __WireForm + OnLoad 调用），
    /// 现在收拢成一个显式函数。
    static Control Root(Form form) {
        App app = form.GetApp();
        // UseAppCss 是"整表替换"语义（appCss = css），两块样式必须
        // 先拼成一整份再装——两次调用会让后一次把骨架文档的 <style>
        //（rail 按钮尺寸、四页宿主底色）整个冲掉。
        app.UseAppCss({{NAME}}Html.Css + "\n" + WxSkin.Css());
        HtmlHandlers hs = new HtmlHandlers();
        hs.Add("nav-chat", () => { Pick(0); });
        hs.Add("nav-contacts", () => { Pick(1); });
        hs.Add("nav-favs", () => { Pick(2); });
        hs.Add("nav-moments", () => { Pick(3); });
        hs.Add("nav-settings", () => { WxSettingsWindow.Open(app); });
        Control main = {{NAME}}Html.Build(hs);
        // 树根是 body 元素（dock 0 = Manual）——Form 只对 dock=Fill
        // 的根做客户区填充（GenForm 时代这句由 __BuildForm 发射），
        // runtime 文档必须 code-behind 补上，否则整棵树缩在左上角
        // 按内容尺寸排版。
        main.DockFill();

        RailHost = main.Find("RailHost");
        ChatHost = main.Find("ChatHost");
        ContactsHost = main.Find("ContactsHost");
        FavsHost = main.Find("FavsHost");
        MomHost = main.Find("MomHost");
        RailChat = (Button)main.Find("RailChat");
        RailContacts = (Button)main.Find("RailContacts");
        RailFavs = (Button)main.Find("RailFavs");
        RailMoments = (Button)main.Find("RailMoments");
        RailSettings = (Button)main.Find("RailSettings");

        // runtime 通道没有 data-dock/data-x-props：dock（左栏/按钮
        // 纵排/设置沉底/四页填充）、图标与悬停提示在 code-behind 补。
        // 栏宽走文档 <style> 的 width 声明（DockSize 取 StyleWidthIn），
        // 与 GenForm 时代的 logW=56 同效；按钮高度同理由 rail-btn
        // 规则的 height 给。
        RailHost.DockLeft();
        RailChat.DockTop();
        RailContacts.DockTop();
        RailFavs.DockTop();
        RailMoments.DockTop();
        RailSettings.DockBottom();
        ChatHost.DockFill();
        ContactsHost.DockFill();
        FavsHost.DockFill();
        MomHost.DockFill();
        RailChat.SetProp("icon", "message");
        RailContacts.SetProp("icon", "users");
        RailFavs.SetProp("icon", "star");
        RailMoments.SetProp("icon", "compass");
        RailSettings.SetProp("icon", "settings");
        RailChat.Tip = "聊天";
        RailContacts.Tip = "通讯录";
        RailFavs.Tip = "收藏";
        RailMoments.Tip = "朋友圈";
        RailSettings.Tip = "设置";

        {{NAME}}.OnLoad(form);
        return main;
    }
    static Badge railBadge;

    /// 未读徽标同步（WxIm 每拉到新的 total 调一次）。位置按胶囊宽度
    /// 反算：右缘贴导航栏内侧，宽度随位数变化也贴得住。
    static void SyncBadge(Form form) {
        if (railBadge == null) { return; }
        int n = WxIm.TotalUnread();
        railBadge.Count = n;
        railBadge.visible = n > 0;
        if (form != null) {
            App a = form.GetApp();
            if (n > 0) {
                int w = Badge.WidthOf(a, railBadge.Label(), "error");
                railBadge.Place(a.Scale(56) - w - a.Scale(4), a.Scale(4));
            }
            a.RequestRedraw();
        }
    }

    /// 切换内容页：四个宿主叠在同一个矩形里，只让当前那一页可见——
    /// 隐藏的宿主不参与排版、命中与绘制，也不会被布局自检报成重叠。
    static void Pick(int n) {
        ChatHost.visible = n == 0;
        ContactsHost.visible = n == 1;
        FavsHost.visible = n == 2;
        MomHost.visible = n == 3;
        RailChat.Class = RailCls(n == 0);
        RailContacts.Class = RailCls(n == 1);
        RailFavs.Class = RailCls(n == 2);
        RailMoments.Class = RailCls(n == 3);
    }

    /// 导航按钮的类名：当前页那个带状态类，皮肤里 `button.rail-btn.wxon`
    /// 一条规则就把它点亮。
    static string RailCls(bool on) {
        if (on) { return "rail-btn wxon"; }
        return "rail-btn";
    }
}
