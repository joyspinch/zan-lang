using System;
using Gui;
using Gui.Widget;
using Gui.Component;
using Gui.Component.WebView;

/* {{NAME}}：微聊——公司内部协作客户端外壳（三栏桌面客户端）。
 *
 * 界面结构（HTML+CSS 改造：主窗骨架在 App.html 运行期文档里，
 * GenHtml 编译期生成 {{NAME}}Html 建树类（类名 = 文件基名帕斯卡化
 * + Html；脚手架把 App.html 改名为 <NAME>.html，引用必须走
 * {{NAME}}Html）；业务在下面）：
 *   左侧  RailHost   图标导航栏（聊天 / 通讯录 / 收藏 / 工作台 /
 *                    多维表格 / 智能体 / AI 分配 / 通知 / 管理后台 +
 *                    底部设置）
 *   右侧  ChatHost / ContactsHost / FavsHost / WorkHost /
 *                    BitableHost / AgentHost / FlowAgentHost /
 *                    NotifyHost / DocsHost / AdminHost 十页叠在
 *                    同一块矩形里，只让当前页可见
 *   设置  由 WxSettingsWindow 打开的一扇独立子窗口
 *
 * 定位是「公司内部的工作台」，不是社交软件：朋友圈那类社交功能
 * 已移除，导航只留内部协作要用的面（沟通 / 找人 / 资源 / 工作台 /
 * 通知 / 后台）。管理后台是服务端渲染的网页（/admin/dashboard），这里用
 * WebView 内嵌，不在客户端重做一套。
 *
 * 组件全部来自标准库：会话/联系人/收藏/筛选项四种列表行是自定义
 * Control + ListView 的行模板；聊天区是 ChatView 的气泡模式；
 * 设置与会话浮窗是 Gui.ChildWindow 子窗口。示例数据见 WeChatData.zan，
 * 全部虚构。
 */
partial class {{NAME}} {
    static WxPageChat chatPage;
    static WxPageContacts contactsPage;
    static WxPageFavorites favsPage;
    static WxPageWork workPage;
    static WxPageBitable bitablePage;
    static WxAgent agentPage;
    static WxFlowAgent flowAgentPage;
    static WxPageNotify notifyPage;
    static WxDocs docsPage;
    static WxAdmin adminPage;

    // 主窗口骨架的模型宿主：骨架文档里的 @click="nav-*" 按名字接到这里
    // （运行期装载的文档，事件由宿主统一接线）。
    static ModelBinder appBinder;

    // HTML 文档建树出来的骨架节点（Pick 翻页用）。
    static Control RailHost;
    static Control ChatHost;
    static Control ContactsHost;
    static Control FavsHost;
    static Control WorkHost;
    static Control BitableHost;
    static Control AgentHost;
    static Control FlowAgentHost;
    static Control NotifyHost;
    static Control DocsHost;
    static Control AdminHost;
    static Button RailChat;
    static Button RailContacts;
    static Button RailFavs;
    static Button RailWork;
    static Button RailBitable;
    static Button RailAgent;
    static Button RailFlowAgent;
    static Button RailNotify;
    static Button RailDocs;
    static Button RailAdmin;

    static void OnLoad(Form form) {
        App app = form.GetApp();
        // 界面自己的排版节奏与自有类外观（颜色仍走皮肤 token）；
        // 主窗骨架文档的 <style> 已在 Root() 里并入 appCss。
        chatPage = new WxPageChat();
        // 会话行拖出列表 → 该会话开成一扇独立子窗口。
        chatPage.UseDetach(app);
        ChatHost.Add(chatPage);
        contactsPage = new WxPageContacts();
        contactsPage.onStartChat = (peerId, name) => {
            Pick(0);
            if (chatPage != null) {
                chatPage.OpenPeer(peerId, name);
            }
        };
        contactsPage.onStartConv = (convId, title) => {
            Pick(0);
            if (chatPage != null) {
                chatPage.OpenConv(convId, title);
            }
        };
        ContactsHost.Add(contactsPage);
        favsPage = new WxPageFavorites();
        FavsHost.Add(favsPage);
        workPage = new WxPageWork();
        workPage.onStartConv = (convId, title) => {
            Pick(0);
            if (chatPage != null) {
                chatPage.OpenConv(convId, title);
            }
        };
        chatPage.onOpenLifecycle = (projectId, stage) => {
            Pick(3);
            if (workPage != null) {
                workPage.OpenLifecycleProject(projectId);
            }
        };
        WorkHost.Add(workPage);
        // 多维表格：左栏表清单 + 右栏记录网格（标准库 DataGrid）。
        bitablePage = new WxPageBitable();
        bitablePage.Build(app);
        BitableHost.Add(bitablePage);
        // 智能体：左栏智能体清单 + 右栏对话（服务端转发，密钥不出服务器）。
        agentPage = new WxAgent();
        agentPage.Build(app);
        AgentHost.Add(agentPage);
        // AI 分配：左栏流程清单 + 中栏节点链 + 右栏 AI 工具面板
        // （绑定/调序/启停/解绑 + 高可用试跑）。
        flowAgentPage = new WxFlowAgent();
        flowAgentPage.Build(app);
        FlowAgentHost.Add(flowAgentPage);
        notifyPage = new WxPageNotify();
        notifyPage.Build(app);
        NotifyHost.Add(notifyPage);
        // 管理后台：服务端后台网页内嵌（WebView 家族要先装，否则
        // 原生视图族被 DCE 裁掉、发布目录也不带 WebView2Loader）。
        WebViewBootstrap.Install();
        // 文档：左栏空间/文档清单 + 中间正文（服务端渲染的 HTML，走
        // 网页视图显示）+ 右栏版本历史；正文也用 WebView 家族，装载
        // 放在 Install() 之后。
        docsPage = new WxDocs();
        docsPage.Build(app);
        DocsHost.Add(docsPage);
        adminPage = new WxAdmin();
        adminPage.Build(app);
        AdminHost.Add(adminPage);

        // 登录门：登录小窗在主窗口 Show 之前运行（见 WxLoginWindow.Run）
        // ——返回 true 才继续往下走，主窗口才会打开；用户关窗则安全退出。
        if (!WxLoginWindow.Run()) {
            form.GetApp().RequestClose();
            return;
        }

        // 登录成功：把聊天页接上服务端数据（WxIm 桥共享页里的模型），
        // 首拉一次会话列表，再开轮询节拍（打开的会话每拍拉流，列表
        // 与未读徽标每 3 拍重拉——轮询就是客户端的"实时"）。
        WxIm.Use(chatPage.Model(), chatPage);
        WxIm.RefreshChats(null);
        form.Every(1500, () => { WxIm.Beat(); });
        // 网络应答与实时事件的并入点：Poll 在这里把回调跑在 UI 线程上。
        // WxEvents 的帧来自独立 WS 线程，与请求 worker 互不
        // 阻塞——断线重连不挡发送。
        form.Every(90, () => {
            bool live = WxEvents.Poll();
            if (WxNet.Poll() || live) { app.RequestRedraw(); }
        });

        // 实时事件层：WS 主通道 + 轮询兜底，帧经上面的
        // 90ms 拍并入 UI 线程；水位去重在线程侧完成。事件→会话模型
        // 递给 WxIm 的接线点。
        WxEvents.Start((string ev) => {
            WxIm.OnLiveEvent(ev);
            app.RequestRedraw();
        });

        // 未读徽标：叠在导航栏「聊天」图标右上角的计数胶囊（零未读
        // 藏起来）。徽标 absolute 脱离 flex 流（.wxrailbadge 的
        // top/right 落位）；宿主按钮自己钉了尺寸，这里也照挂免检牌。
        // 挂在按钮里（不是挂在栏里）——角标才落在图标角上，而不是
        // 飘到栏角。
        railBadge = new Badge(0);
        railBadge.AddClass("wxrailbadge");
        railBadge.NoOverlapCheck();
        railBadge.visible = false;
        RailChat.Add(railBadge);
        Form hostForm = form;
        WxIm.OnBadge(() => { SyncBadge(hostForm); });
        contactsPage.RefreshServerContacts();

        // 通知角标：叠在导航栏「通知」图标右上角的计数胶囊（零未读
        // 藏起来）。徽标挂在按钮里——按钮自身 position:relative，
        // 角标 absolute 才落在这个按钮的角上（聊天角标同理挂在
        // 「聊天」按钮里，两处互不干扰）。
        notifyBadge = new Badge(0);
        notifyBadge.AddClass("wxrailbadge");
        notifyBadge.NoOverlapCheck();
        notifyBadge.visible = false;
        RailNotify.Add(notifyBadge);
        notifyPage.badge = notifyBadge;
        // 流程类通知的「去工作台」跳转：回调注入，页面不依赖主窗类。
        notifyPage.onGoWork = () => { Pick(3); };

        // 通知角标轮询：通知是别人推给我的数据，5s 一拍拉未读数
        // （实时事件通道未就位时的兜底，与聊天的 1.5s 拍同源）。
        form.Every(5000, () => {
            if (notifyPage != null) { notifyPage.Beat(); }
        });

        Pick(0);
    }

    // 进程入口：GenHtml 运行期文档通道没有 GenForm 那样的 Main
    // 生成（那是设计稿 emitMain 的产物），这里手写同形的一套——
    // 建窗、挂骨架、跑 OnLoad、进事件循环。
    static void Main() {
        {{NAME}}.Show();
    }

    // 建主窗口（骨架 + OnLoad），交给调用方 Run。独立出来的
    // 意义与 GenForm 的 __CreateWindow 一致：别的窗口想先调整
    // 再运行也有挂点。
    static Form Show() {
        Form form = Form.Create("微聊", 1180, 760);
        form.GetApp().CenterWindow();
        form.Add({{NAME}}.Root(form));
        form.Run();
        return form;
    }

    // 把 HTML 骨架接上窗口：装载运行期文档（样式随装载并进 appCss）
    // → 建树接线 → 找回挂点补行为配置 → OnLoad 装配业务页。GenForm
    // 时代这段由生成器发射（__BuildForm + __WireForm + OnLoad 调用），
    // 现在收拢成一个显式函数。
    static Control Root(Form form) {
        App app = form.GetApp();
        // 运行期装载文档（app.LoadHtmlWith）需要声明层已安装：装载后端
        // 由 Html.Install 注册。走 GenHtml 建树入口时编译器会自动装，
        // 这里只做运行时装载——不装则 LoadHtmlWith 静默返回 null。
        Html.Install();
        // UseAppCss 是"整表替换"语义（appCss = css），所有样式必须
        // 先拼成一整份再装——两次调用会让后一次把前面的整个冲掉。
        // 走运行期通道的文档（主窗骨架、通知页）在装载时把各自的
        // <style> 自动追加进 appCss，不必手工拼；尚未迁移的页面仍由
        // GenHtml 通道提供样式，这里拼进去——漏拼哪份，那份的骨架样式
        // （flex、栏宽、渐变封面）就整体失效、页面塌成纵向块流。
        app.UseAppCss(WxPageChatHtml.Css + "\n" + WxPageContactsHtml.Css + "\n"
            + WxPageFavoritesHtml.Css + "\n"
            + WxPageWorkHtml.Css + "\n" + WxSkin.Css());
        // 主窗骨架：运行期装载文档（样式自动并入，作用域类自动混入），
        // 事件按名字接线——导航钮在文档里写 @click="nav-chat" 等。
        appBinder = new ModelBinder();
        appBinder.Handle("nav-chat", () => { Pick(0); });
        appBinder.Handle("nav-contacts", () => { Pick(1); });
        appBinder.Handle("nav-favs", () => { Pick(2); });
        appBinder.Handle("nav-work", () => { Pick(3); });
        appBinder.Handle("nav-bitable", () => { Pick(4); });
        appBinder.Handle("nav-agent", () => { Pick(5); });
        appBinder.Handle("nav-flowagent", () => { Pick(6); });
        appBinder.Handle("nav-notify", () => { Pick(7); });
        appBinder.Handle("nav-docs", () => { Pick(8); });
        appBinder.Handle("nav-admin", () => { Pick(9); });
        appBinder.Handle("nav-settings", () => { WxSettingsWindow.Open(app); });
        Control main = app.LoadHtmlWith({{NAME}}Html.Doc, null, "");
        if (main == null) {
            // 装载失败（声明层没装 / 文档为空）：给一棵空树，别把 null
            // 挂进窗口——后面的 Find 全是空指针。
            Console.WriteLine("WX_APP: 主窗文档装载失败");
            return new Panel();
        }
        // runtime 文档必须 code-behind 补上客户区填充（GenForm 时代
        // 这句由 __BuildForm 发射），否则整棵树缩在左上角按内容尺寸
        // 排版。
        main.DockFill();
        appBinder.SetRoot(main, null);
        appBinder.Wire();

        RailHost = main.Find("RailHost");
        ChatHost = main.Find("ChatHost");
        ContactsHost = main.Find("ContactsHost");
        FavsHost = main.Find("FavsHost");
        WorkHost = main.Find("WorkHost");
        BitableHost = main.Find("BitableHost");
        AgentHost = main.Find("AgentHost");
        FlowAgentHost = main.Find("FlowAgentHost");
        NotifyHost = main.Find("NotifyHost");
        DocsHost = main.Find("DocsHost");
        AdminHost = main.Find("AdminHost");
        RailChat = (Button)main.Find("RailChat");
        RailContacts = (Button)main.Find("RailContacts");
        RailFavs = (Button)main.Find("RailFavs");
        RailWork = (Button)main.Find("RailWork");
        RailBitable = (Button)main.Find("RailBitable");
        RailAgent = (Button)main.Find("RailAgent");
        RailFlowAgent = (Button)main.Find("RailFlowAgent");
        RailNotify = (Button)main.Find("RailNotify");
        RailDocs = (Button)main.Find("RailDocs");
        RailAdmin = (Button)main.Find("RailAdmin");

        {{NAME}}.OnLoad(form);
        return main;
    }
    static Badge railBadge;
    static Badge notifyBadge;

    // 未读徽标同步（WxIm 每拉到新的 total 调一次）。徽标挂在 RailHost
    // 里、absolute 落位（.wxrailbadge 的 top/right），右缘贴导航栏
    // 内侧，宽度随位数变化也贴得住。
    static void SyncBadge(Form form) {
        if (railBadge == null) { return; }
        int n = WxIm.TotalUnread();
        railBadge.Count = n;
        railBadge.visible = n > 0;
        if (form != null && n > 0) {
            form.GetApp().RequestRedraw();
        }
    }

    // 切换内容页：十个宿主叠在同一个矩形里，只让当前那一页可见——
    // 隐藏的宿主不参与排版、命中与绘制，也不会被布局自检报成重叠。
    static void Pick(int n) {
        ChatHost.visible = n == 0;
        ContactsHost.visible = n == 1;
        FavsHost.visible = n == 2;
        WorkHost.visible = n == 3;
        BitableHost.visible = n == 4;
        AgentHost.visible = n == 5;
        FlowAgentHost.visible = n == 6;
        NotifyHost.visible = n == 7;
        DocsHost.visible = n == 8;
        AdminHost.visible = n == 9;
        SetRailCls(RailChat, n == 0);
        SetRailCls(RailContacts, n == 1);
        SetRailCls(RailFavs, n == 2);
        SetRailCls(RailWork, n == 3);
        SetRailCls(RailBitable, n == 4);
        SetRailCls(RailAgent, n == 5);
        SetRailCls(RailFlowAgent, n == 6);
        SetRailCls(RailNotify, n == 7);
        SetRailCls(RailDocs, n == 8);
        SetRailCls(RailAdmin, n == 9);
        // 工作台是别人也会动的数据：每次进页都重拉（首次顺带取 me）。
        if (n == 3 && workPage != null) { workPage.OnShow(); }
        // 多维表格同理：共享表，谁都可能改，进页重拉。
        if (n == 4 && bitablePage != null) { bitablePage.OnShow(); }
        // 智能体同理：清单与服务端配置可能变过，进页重拉。
        if (n == 5 && agentPage != null) { agentPage.OnShow(); }
        // AI 分配同理：分配与健康状态是别人也会改的配置，进页重拉。
        if (n == 6 && flowAgentPage != null) { flowAgentPage.OnShow(); }
        // 通知同理：进页重拉整页通知（角标另有 5s 拍轮询）。
        if (n == 7 && notifyPage != null) { notifyPage.OnShow(); }
        // 文档同理：文档是别人也会改的内容，进页重拉。
        if (n == 8 && docsPage != null) { docsPage.OnShow(); }
        // 管理后台：进页同步地址条与「运行时不可用」的降级提示。
        if (n == 9 && adminPage != null) { adminPage.OnShow(); }
    }

    // 导航按钮的类名：当前页那个带状态类，皮肤里 `button.rail-btn.wxon`
    // 一条规则就把它点亮。
    //
    // 注意只能换「导航态」这一组类（SetClassIn）：Class 是整体替换，
    // 会把文档作用域类（zs-load-<序>）一起冲掉——作用域选择器随之
    // 失配，按钮高度退回尺寸档、悬停底色与选中底色全部失效。
    static void SetRailCls(Button btn, bool on) {
        if (btn == null) { return; }
        btn.SetClassIn("rail-btn wxon", RailCls(on));
    }

    static string RailCls(bool on) {
        if (on) { return "rail-btn wxon"; }
        return "rail-btn";
    }
}
