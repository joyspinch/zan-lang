using System;
using Gui;
using Gui.Widget;

/// 会话列表的一行：头像 + 名字/摘要 + 右侧时间与未读角标。
/// 行自己**不画底色**——选中/悬停的底色由 ListView 统一画在行下面，
/// 行再画一层就会把它盖住（所以 StyleType 归 "listrow"）。
class WxSessionRow : Control {
    WxSession item;

    static Control Of(WxSession it) { return new WxSessionRow(it); }

    WxSessionRow(WxSession it) {
        this.InitControl("wxsessrow", 5);
        this.Class = "wxsess";
        item = it;
        Avatar av = Wx.Ava(it.initial, 40, it.tint);
        av.dock = 3;
        this.Add(av);
        // 中列/右列都是纵向 flex、整块垂直居中：dock 行的 gap 若再
        // 叠加行底分隔线，会把内容盒压矮、右列徽标被钳到只剩 29px
        // （胶囊 33px 画满就被自己的矩形裁掉底边），居中后上下留白
        // 也对称。分隔线由 `.wxsess` 的 border-bottom 画，不占布局。
        Flex mid = Flex.Column();
        mid.AddClass("wxmid");
        mid.Justify("center");
        mid.dock = 5;
        mid.Add(Wx.Lbl(it.name, "wxsessname"));
        mid.Add(Wx.Lbl(it.snippet, "wxsessub"));
        this.Add(mid);
        // 右列：时间在上、未读角标在下，都贴着右缘。
        Flex meta = Flex.Column();
        meta.AddClass("wxmeta");
        meta.Justify("center");
        meta.dock = 4;
        Flex tr = Wx.Row("");
        tr.Justify("end");
        tr.Add(Wx.Lbl(it.time, "wxtime"));
        meta.Add(tr);
        if (it.unread > 0) {
            Flex br = Wx.Row("");
            br.Justify("end");
            br.Add(new Badge(it.unread));
            meta.Add(br);
        }
        this.Add(meta);
    }

    override string Kind() { return "WxSessionRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表：行类的 `height` 声明了就用它的（皮肤里改一行
        // 数字全列表生效），没声明时才落到内容自然高度的兜底值
        //（Style.HeightOr 的约定，两个值都已按显示缩放）。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(58));
        prefW = app.Scale(280);
    }
}

/// 通讯录的一行。按行种类分型：分组节（chevron + 名字 + 计数，整行
/// 可点折叠/展开）、字母分组头（一行小字，不可选）、联系人/群聊/
/// 公众号（头像 + 名字）、好友申请（头像 + 名字与申请语 + 接受按钮）、
/// 企业（公司行用蓝色楼宇图标，联系人行用首字头像）。
class WxContactRow : Control {
    WxContact item;

    static Control Of(WxContact it) { return new WxContactRow(it); }

    /// ListView 的可选门控：字母分组头只是分节标题，不是选项。
    static bool Selectable(WxContact it) { return it.kind != 1; }

    WxContactRow(WxContact it) {
        this.InitControl("wxcatrow", 5);
        item = it;
        if (it.kind == 1) {
            this.Class = "wxhead2";
            this.Add(Wx.Lbl(it.name, "wxhead2"));
            return;
        }
        if (it.kind == 0) {
            this.Class = "wxsec";
            IconView ch = new IconView(
                it.open ? "chevron-down" : "chevron-right", 14);
            ch.dock = 3;
            this.Add(ch);
            Label nm = Wx.Lbl(it.name, "wxcatname");
            nm.dock = 5;
            this.Add(nm);
            if (it.count > 0) {
                Flex cr = Wx.Row("");
                cr.Justify("end");
                cr.Add(Wx.Lbl(Convert.ToString(it.count), "wxcatcount"));
                cr.dock = 4;
                this.Add(cr);
            }
            return;
        }
        this.Class = "wxcat";
        Avatar av = null;
        if (it.kind == 6 && it.initial == "") {
            av = Wx.AvaIcon("building", 36, "info");
        } else {
            av = Wx.Ava(it.initial, 36, it.tint);
        }
        av.dock = 3;
        this.Add(av);
        if (it.kind == 3) {
            // 好友申请：名字下面还有一行申请语，右侧是通过按钮
            // （通过后就地变灰字，与原版「接受 → 已添加」一致）。
            Flex mp = Flex.Column();
            mp.AddClass("grow");
            mp.Justify("center");
            mp.dock = 5;
            mp.Add(Wx.Lbl(it.name, "wxcatname"));
            mp.Add(Wx.Lbl(it.msg, "wxreqmsg"));
            this.Add(mp);
            Label ok = Wx.Lbl("已添加", "wxreqdone");
            Button acc = new Button("接受");
            acc.Class = "primary small wxreqbtn";
            acc.OnClick(() => {
                it.done = true;
                acc.visible = false;
                ok.visible = true;
            });
            acc.dock = 4;
            ok.dock = 4;
            ok.visible = it.done;
            acc.visible = !it.done;
            this.Add(acc);
            this.Add(ok);
            return;
        }
        Label nm = Wx.Lbl(it.name, "wxcatname");
        nm.dock = 5;
        this.Add(nm);
        if (it.kind == 4 && it.people > 0) {
            Flex cr = Wx.Row("");
            cr.Justify("end");
            cr.Add(Wx.Lbl(Convert.ToString(it.people) + " 人", "wxcatcount"));
            cr.dock = 4;
            this.Add(cr);
        }
    }

    override string Kind() { return "WxContactRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxcat / .wxsec / .wxhead2 的 height）；兜底值
        // 随行种类给出：申请行带两行文字高一档，字母头矮一档。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        int nat = 56;
        if (item.kind == 0) { nat = 44; }
        if (item.kind == 1) { nat = 28; }
        if (item.kind == 3) { nat = 66; }
        prefH = s.HeightOr(app.Scale(nat));
        prefW = app.Scale(280);
    }
}

/// 收藏列表的一张卡片：图标 + 标题/摘要 + 右侧来源与时间，底部一条分隔线。
class WxFavRow : Control {
    WxFav item;

    static Control Of(WxFav it) { return new WxFavRow(it); }

    WxFavRow(WxFav it) {
        this.InitControl("wxfavrow", 5);
        this.Class = "wxfavrow";
        item = it;
        Avatar av = Wx.AvaIcon(it.icon, 40, it.tint);
        av.dock = 3;
        this.Add(av);
        // 同会话行：内容垂直居中，分隔线走 .wxfavrow 的 border-bottom。
        Flex mid = Flex.Column();
        mid.AddClass("wxmid");
        mid.Justify("center");
        mid.dock = 5;
        mid.Add(Wx.Lbl(it.title, "wxfavname"));
        mid.Add(Wx.Lbl(it.desc, "wxfavsub"));
        this.Add(mid);
        Flex meta = Flex.Column();
        meta.AddClass("wxmeta");
        meta.Justify("center");
        meta.dock = 4;
        Flex r1 = Wx.Row("");
        r1.Justify("end");
        r1.Add(Wx.Lbl(it.source, "wxfavsub"));
        meta.Add(r1);
        Flex r2 = Wx.Row("");
        r2.Justify("end");
        r2.Add(Wx.Lbl(it.time, "wxfavsub"));
        meta.Add(r2);
        this.Add(meta);
    }

    override string Kind() { return "WxFavRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxfavrow 的 height），同会话行。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(66));
        prefW = app.Scale(280);
    }
}

/// 收藏左栏的一个筛选项。整行就是一条标签，选中底色由 ListView 画。
class WxFilterRow : Control {
    string label;

    static Control Of(string s) { return new WxFilterRow(s); }

    WxFilterRow(string s) {
        this.InitControl("wxfiltrow", 5);
        this.Class = "wxfilt";
        label = s;
        this.Add(Wx.Lbl(s, "wxfiltname"));
    }

    override string Kind() { return "WxFilterRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxfilt 的 height），同会话行。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(40));
        prefW = app.Scale(200);
    }
}

/// 聊天记录窗口的一行：头像 + 发言人/正文 + 右对齐日期。与原版一致，
/// 私聊和群聊用同一种行（群里行上多一个名字，数据里有就显示）。
class WxHistRowTpl : Control {
    WxHistRow item;

    static Control Of(WxHistRow it) { return new WxHistRowTpl(it); }

    WxHistRowTpl(WxHistRow it) {
        this.InitControl("wxhistrow", 5);
        this.Class = "wxhistrow";
        item = it;
        Avatar av = Wx.Ava(it.ini, 36, it.tint);
        av.dock = 3;
        this.Add(av);
        Flex mid = Flex.Column();
        mid.AddClass("wxhmid");
        mid.Justify("center");
        mid.dock = 5;
        mid.Add(Wx.Lbl(it.name, "wxhistname"));
        mid.Add(Wx.Lbl(it.text, "wxhisttext"));
        this.Add(mid);
        Flex meta = Flex.Column();
        meta.AddClass("wxhdate");
        meta.Justify("center");
        meta.dock = 4;
        // 日期靠右：外层列管垂直居中，内层行 justify end 管水平贴右
        //（Label 只在自己矩形里从左往右画，右对齐要靠 flex 排布）。
        Flex dr = Wx.Row("");
        dr.Justify("end");
        dr.Add(Wx.Lbl(it.date, "wxhistdate"));
        meta.Add(dr);
        this.Add(meta);
    }

    override string Kind() { return "WxHistRowTpl"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(58));
        prefW = app.Scale(620);
    }
}

/// 「通讯录管理」表格的一行：外壳只负责行高与分隔线，内容是一整条
/// 流式 Flex（勾选圈 + 头像 + 昵称 grow + 备注列 + 标签列 + 朋友权限
/// 列），列宽 wxmgc1/2/3 与表头共用——两边同构才上下对齐。勾选状态
/// 只在行模型上；整行的选中交给 ListView。
class WxMgRowTpl : Control {
    WxMgRow item;

    static Control Of(WxMgRow it) { return new WxMgRowTpl(it); }

    WxMgRowTpl(WxMgRow it) {
        this.InitControl("wxmgrow", 5);
        this.Class = "wxmgrow";
        item = it;
        Flex row = Wx.Row("wxmgrowin");
        row.dock = 5;
        row.Add(WxMgHeadRow.Dot(it.picked));
        row.Add(Wx.Ava(it.ini, 32, it.tint));
        row.Add(Wx.Lbl(it.name, "wxmgname grow"));
        row.Add(WxMgHeadRow.Col(it.remark, "wxmgc1", "wxmgcell"));
        row.Add(WxMgHeadRow.Col(it.tag, "wxmgc2", "wxmgcell"));
        row.Add(WxMgHeadRow.Col(it.perm, "wxmgc3", "wxmgcell"));
        this.Add(row);
    }

    override string Kind() { return "WxMgRowTpl"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(52));
        prefW = app.Scale(700);
    }
}

/// 「通讯录管理」表格的表头行：与数据行同一套内部流式结构（勾选圈 +
/// 昵称 + 右缘三列），没有头像、文字用表头样式——同构才像素对齐。
/// 全选勾选圈经 Circle() 交给窗口接行为。
class WxMgHeadRow : Control {
    Button circleBtn;

    Button Circle() { return circleBtn; }

    /// 一个定宽数据列：列宽类写在 Flex 上（Label 上的 width 类不被
    /// 测量消费，必须包一层定宽容器）。
    static Flex Col(string txt, string wcls, string lblCls) {
        Flex c = Wx.Row(wcls);
        c.Add(Wx.Lbl(txt, lblCls));
        return c;
    }

    /// 勾选圈（on = 绿底白勾）。表头用 Button 版（Circle），点击行为
    /// 由窗口接；数据行用 Dot 版——按钮会把点击吃掉，ListView 的
    /// 行选中（Select）就不再触发，整行勾选会失灵。
    static Button Circle(bool on) {
        Button c = new Button("");
        if (on) { c.Icon = "check"; }
        c.Class = on ? "wxcircle on" : "wxcircle";
        return c;
    }

    /// 数据行的勾选圈：纯视觉，点击穿透到行。
    static Flex Dot(bool on) {
        Flex d = new Flex();
        d.Class = on ? "wxcircle on" : "wxcircle";
        if (on) {
            d.Justify("center");
            d.Align("center");
            d.Add(new IconView("check", 12));
        }
        return d;
    }

    WxMgHeadRow() {
        this.InitControl("wxmgrow", 5);
        this.Class = "wxmghead";
        Flex row = Wx.Row("wxmgrowin");
        row.dock = 5;
        circleBtn = WxMgHeadRow.Circle(false);
        row.Add(circleBtn);
        row.Add(Wx.Lbl("昵称", "wxmgname grow"));
        row.Add(WxMgHeadRow.Col("备注", "wxmgc1", "wxmgheadcell"));
        row.Add(WxMgHeadRow.Col("标签", "wxmgc2", "wxmgheadcell"));
        row.Add(WxMgHeadRow.Col("朋友权限", "wxmgc3", "wxmgheadcell"));
        this.Add(row);
    }

    override string Kind() { return "WxMgHeadRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(40));
        prefW = app.Scale(700);
    }
}
