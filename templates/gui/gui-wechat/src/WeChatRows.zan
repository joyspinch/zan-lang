using System;
using Gui;
using Gui.Widget;

/// 会话列表的一行：头像 + 名字/摘要 + 右侧时间与未读角标。
/// 行自己**不画底色**——选中/悬停的底色由 ListView 统一画在行下面，
/// 行再画一层就会把它盖住（所以 StyleType 归 "listrow"）。
class WxSessionRow : Control {
    WxSession item;

    static Control Of(WxSession it) { return new WxSessionRow(it); }

    WxSessionRow(WxSession it) {
        this.InitControl("wxsessrow", 5);
        this.Class = "wxsess";
        item = it;
        Avatar av = Wx.Ava(it.initial, 40, it.tint);
        av.dock = 3;
        this.Add(av);
        // 中列/右列都是纵向 flex、整块垂直居中：dock 行的 gap 若再
        // 叠加行底分隔线，会把内容盒压矮、右列徽标被钳到只剩 29px
        // （胶囊 33px 画满就被自己的矩形裁掉底边），居中后上下留白
        // 也对称。分隔线由 `.wxsess` 的 border-bottom 画，不占布局。
        Flex mid = Flex.Column();
        mid.AddClass("wxmid");
        mid.Justify("center");
        mid.dock = 5;
        mid.Add(Wx.Lbl(it.name, "wxsessname"));
        mid.Add(Wx.Lbl(it.snippet, "wxsessub"));
        this.Add(mid);
        // 右列：时间在上、未读角标在下，都贴着右缘。
        Flex meta = Flex.Column();
        meta.AddClass("wxmeta");
        meta.Justify("center");
        meta.dock = 4;
        Flex tr = Wx.Row("");
        tr.Justify("end");
        tr.Add(Wx.Lbl(it.time, "wxtime"));
        meta.Add(tr);
        if (it.unread > 0) {
            Flex br = Wx.Row("");
            br.Justify("end");
            br.Add(new Badge(it.unread));
            meta.Add(br);
        }
        this.Add(meta);
    }

    override string Kind() { return "WxSessionRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表：行类的 `height` 声明了就用它的（皮肤里改一行
        // 数字全列表生效），没声明时才落到内容自然高度的兜底值
        //（Style.HeightOr 的约定，两个值都已按显示缩放）。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(58));
        prefW = app.Scale(280);
    }
}

/// 通讯录的一行。三种行共用这一个模板：快捷入口（图标 + 名字 + 数量）、
/// 字母分组头（一行小字）、联系人（头像 + 名字）。分组头不可选。
class WxContactRow : Control {
    WxContact item;

    static Control Of(WxContact it) { return new WxContactRow(it); }

    /// ListView 的可选门控：分组头只是一个分节标题，不是选项。
    static bool Selectable(WxContact it) { return it.kind != 1; }

    WxContactRow(WxContact it) {
        this.InitControl("wxcatrow", 5);
        item = it;
        if (it.kind == 1) {
            this.Class = "wxhead2";
            this.Add(Wx.Lbl(it.name, "wxhead2"));
            return;
        }
        this.Class = "wxcat";
        Avatar av = null;
        if (it.kind == 0) { av = Wx.AvaIcon(it.initial, 36, it.tint); }
        else { av = Wx.Ava(it.initial, 36, it.tint); }
        av.dock = 3;
        this.Add(av);
        Label nm = Wx.Lbl(it.name, "wxcatname");
        nm.dock = 5;
        this.Add(nm);
        if (it.count > 0) {
            Flex cr = Wx.Row("");
            cr.Justify("end");
            cr.Add(Wx.Lbl(Convert.ToString(it.count), "wxcatcount"));
            cr.dock = 4;
            this.Add(cr);
        }
    }

    override string Kind() { return "WxContactRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxcat / .wxhead2 的 height）；分组头矮一档，
        // 兜底值随行种类给出。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        int nat = 56;
        if (item.kind == 1) { nat = 28; }
        prefH = s.HeightOr(app.Scale(nat));
        prefW = app.Scale(280);
    }
}

/// 收藏列表的一张卡片：图标 + 标题/摘要 + 右侧来源与时间，底部一条分隔线。
class WxFavRow : Control {
    WxFav item;

    static Control Of(WxFav it) { return new WxFavRow(it); }

    WxFavRow(WxFav it) {
        this.InitControl("wxfavrow", 5);
        this.Class = "wxfavrow";
        item = it;
        Avatar av = Wx.AvaIcon(it.icon, 40, it.tint);
        av.dock = 3;
        this.Add(av);
        // 同会话行：内容垂直居中，分隔线走 .wxfavrow 的 border-bottom。
        Flex mid = Flex.Column();
        mid.AddClass("wxmid");
        mid.Justify("center");
        mid.dock = 5;
        mid.Add(Wx.Lbl(it.title, "wxfavname"));
        mid.Add(Wx.Lbl(it.desc, "wxfavsub"));
        this.Add(mid);
        Flex meta = Flex.Column();
        meta.AddClass("wxmeta");
        meta.Justify("center");
        meta.dock = 4;
        Flex r1 = Wx.Row("");
        r1.Justify("end");
        r1.Add(Wx.Lbl(it.source, "wxfavsub"));
        meta.Add(r1);
        Flex r2 = Wx.Row("");
        r2.Justify("end");
        r2.Add(Wx.Lbl(it.time, "wxfavsub"));
        meta.Add(r2);
        this.Add(meta);
    }

    override string Kind() { return "WxFavRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxfavrow 的 height），同会话行。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(66));
        prefW = app.Scale(280);
    }
}

/// 收藏左栏的一个筛选项。整行就是一条标签，选中底色由 ListView 画。
class WxFilterRow : Control {
    string label;

    static Control Of(string s) { return new WxFilterRow(s); }

    WxFilterRow(string s) {
        this.InitControl("wxfiltrow", 5);
        this.Class = "wxfilt";
        label = s;
        this.Add(Wx.Lbl(s, "wxfiltname"));
    }

    override string Kind() { return "WxFilterRow"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        // 行高归样式表（.wxfilt 的 height），同会话行。
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(40));
        prefW = app.Scale(200);
    }
}

/// 聊天记录窗口的一行：头像 + 发言人/正文 + 右对齐日期。与原版一致，
/// 私聊和群聊用同一种行（群里行上多一个名字，数据里有就显示）。
class WxHistRowTpl : Control {
    WxHistRow item;

    static Control Of(WxHistRow it) { return new WxHistRowTpl(it); }

    WxHistRowTpl(WxHistRow it) {
        this.InitControl("wxhistrow", 5);
        this.Class = "wxhistrow";
        item = it;
        Avatar av = Wx.Ava(it.ini, 36, it.tint);
        av.dock = 3;
        this.Add(av);
        Flex mid = Flex.Column();
        mid.AddClass("wxhmid");
        mid.Justify("center");
        mid.dock = 5;
        mid.Add(Wx.Lbl(it.name, "wxhistname"));
        mid.Add(Wx.Lbl(it.text, "wxhisttext"));
        this.Add(mid);
        Flex meta = Flex.Column();
        meta.AddClass("wxhdate");
        meta.Justify("center");
        meta.dock = 4;
        // 日期靠右：外层列管垂直居中，内层行 justify end 管水平贴右
        //（Label 只在自己矩形里从左往右画，右对齐要靠 flex 排布）。
        Flex dr = Wx.Row("");
        dr.Justify("end");
        dr.Add(Wx.Lbl(it.date, "wxhistdate"));
        meta.Add(dr);
        this.Add(meta);
    }

    override string Kind() { return "WxHistRowTpl"; }
    override string StyleType() { return "listrow"; }

    override void OnMeasure(App app) {
        StyleBox s = Style.Of(app, this.StyleType(), this.Class, 0);
        prefH = s.HeightOr(app.Scale(58));
        prefW = app.Scale(620);
    }
}
