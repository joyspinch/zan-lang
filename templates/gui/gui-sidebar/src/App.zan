using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 模板直接声明 @click 绑定，后台类专注处理页面切换
 * （B-ID149 窗口即对象：事件 @click 按名接线）。 */
partial class {{NAME}} : Form {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    static void OnLoad(Form form) {
        ui = form;
    }

    static void OnDashboardClick() { Show("仪表盘"); }
    static void OnDevicesClick() { Show("设备"); }
    static void OnReportsClick() { Show("报表"); }
    static void OnSettingsClick() { Show("设置"); }

    /* 切换页面标题；可基于此方法扩展自定义页面切换。 */
    static void Show(string page) {
        Label pageTitle = (Label)ui.Ctl("PageTitle");
        pageTitle.Text = page;
        StatusBar sb = (StatusBar)ui.Ctl("MainStatusBar");
        sb.SetText(0, page);
    }
}
