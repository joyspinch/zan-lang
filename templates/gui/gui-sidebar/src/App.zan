using System;
using Gui;
using Gui.Widget;

// Business logic for {{NAME}}. NavPanel is the left rail; ContentPanel is the
// page area whose title is PageTitle.
partial class {{NAME}} {
    static void OnLoad(Form form) {
        DashboardNav.OnClick(() => { Show("Dashboard"); });
        DevicesNav.OnClick(() => { Show("Devices"); });
        ReportsNav.OnClick(() => { Show("Reports"); });
        SettingsNav.OnClick(() => { Show("Settings"); });
    }

    // Swaps the page heading; hang your own page switching off the same call.
    static void Show(string page) {
        PageTitle.Text = page;
        MainStatusBar.SetText(0, page);
    }
}
