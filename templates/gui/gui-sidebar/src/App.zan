using System;
using System.Json;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 模板直接声明 @click 绑定，后台类专注处理页面切换
 * （B-ID46 运行期形态）。 */
partial class {{NAME}} {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    static void Main() {
        ControlBootstrap.Install();
        Gui.Component.DataTable.DataTableBootstrap.Install();
        JsonValue doc = DesignDoc.Load("src/{{NAME}}.html");
        if (doc == null) {
            Console.WriteLine("error: design not found: src/{{NAME}}.html");
            return;
        }
        Form form = Form.Create(doc.Str("winTitle", "{{NAME}}"),
                                doc.Int("winW", 980), doc.Int("winH", 640));
        form.Add(FormBuilder.BuildWith(doc, null));
        if (doc.Bool("winCenter", false)) { form.GetApp().CenterWindow(); }
        ui = form;
        Wire(form);
        OnLoad(form);
        form.Run();
    }

    static void Wire(Form form) {
        form.On("OnDashboardClick", OnDashboardClick);
        form.On("OnDevicesClick", OnDevicesClick);
        form.On("OnReportsClick", OnReportsClick);
        form.On("OnSettingsClick", OnSettingsClick);
    }

    static void OnLoad(Form form) {
    }

    static void OnDashboardClick() { Show("仪表盘"); }
    static void OnDevicesClick() { Show("设备"); }
    static void OnReportsClick() { Show("报表"); }
    static void OnSettingsClick() { Show("设置"); }

    /* 切换页面标题；可基于此方法扩展自定义页面切换。 */
    static void Show(string page) {
        Label pageTitle = (Label)ui.Ctl("PageTitle");
        pageTitle.Text = page;
        StatusBar sb = (StatusBar)ui.Ctl("MainStatusBar");
        sb.SetText(0, page);
    }
}
