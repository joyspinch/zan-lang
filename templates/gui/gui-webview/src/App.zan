using System;
using System.Json;
using Gui;
using Gui.Widget;
using Gui.Component.WebView;

/* {{NAME}} 的业务逻辑：多标签浏览器。每页一个 WebViewBox，标签条只决定
 * 哪一页可见（B-ID46 运行期形态：设计稿由 Main 运行期投影，控件用
 * ui.Ctl("Id") 取用）。 */
partial class {{NAME}} {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;
    static string Home() { return "https://www.example.com"; }

    static List<WebViewBox> views;
    /* 地址栏当前显示的地址，输入中不被回填覆盖。 */
    static string shownUrl;
    static bool editing;

    static void Main() {
        ControlBootstrap.Install();
        WebViewBootstrap.Install();
        JsonValue doc = DesignDoc.Load("src/{{NAME}}.html");
        if (doc == null) {
            Console.WriteLine("error: design not found: src/{{NAME}}.html");
            return;
        }
        Form form = Form.Create(doc.Str("winTitle", "{{NAME}}"),
                                doc.Int("winW", 1180), doc.Int("winH", 720));
        form.Add(FormBuilder.BuildWith(doc, null));
        if (doc.Bool("winCenter", false)) { form.GetApp().CenterWindow(); }
        ui = form;
        Wire(form);
        OnLoad(form);
        form.Run();
    }

    static void Wire(Form form) {
        form.On("OnNavCommand", OnNavCommand);
    }

    static void OnLoad(Form form) {
        views = new List<WebViewBox>();
        WebViewBox first = (WebViewBox)ui.Ctl("Tab1View");
        views.Add(first);
        shownUrl = first.StartUrl();
        Tabs tabs = Tabs();
        tabs.SetShowAdd(true);
        Input address = AddressBar();
        address.SetText(shownUrl);

        address.Submit += () => { {{NAME}}.Go(); };
        tabs.TabAdded += () => { {{NAME}}.OpenTab(); };
        tabs.TabClosed += () => { {{NAME}}.Reap(); };
        tabs.TabChanged += () => { {{NAME}}.Switched(); };
        form.FrameHook(() => { {{NAME}}.Sync(); });
    }

    // 设计稿里的常驻控件：多个处理器共用，收口到取用点。
    static Tabs Tabs() { return (Tabs)ui.Ctl("BrowserTabs"); }
    static Input AddressBar() { return (Input)ui.Ctl("AddressBar"); }
    static StatusBar Bar() { return (StatusBar)ui.Ctl("MainStatusBar"); }

    static void OnNavCommand() {
        ToolStrip nav = (ToolStrip)ui.Ctl("NavStrip");
        {{NAME}}.Command(nav.LastIndex());
    }

    /* 工具条命令：0 后退，1 前进，2 刷新，4 新建标签。 */
    static void Command(int index) {
        if (index == 4) {
            Tabs().AddNew();
            return;
        }
        WebViewBox v = {{NAME}}.Active();
        if (v == null) { return; }
        if (index == 0) { v.Back(); }
        else if (index == 1) { v.Forward(); }
        else if (index == 2) { v.Reload(); }
    }

    /* 地址栏回车，在当前标签打开输入地址。 */
    static void Go() {
        WebViewBox v = {{NAME}}.Active();
        if (v == null) { return; }
        shownUrl = AddressBar().GetText();
        v.Navigate(shownUrl);
    }

    /* 新标签：AddNew() 之后补一个 WebViewBox。 */
    static void OpenTab() {
        int i = Tabs().Active();
        WebViewBox v = new WebViewBox();
        Tabs().Page(i).Add(v);
        if (i >= views.Count) { views.Add(v); }
        else { views.Insert(i, v); }
        v.Navigate({{NAME}}.Home());
        shownUrl = "";
    }

    /* 标签关闭后清理孤儿 WebViewBox；最后一页关闭时补开一个。 */
    static void Reap() {
        List<WebViewBox> keep = new List<WebViewBox>();
        for (int i = 0; i < views.Count; i = i + 1) {
            WebViewBox v = views[i];
            if (v.HostForm() == null) { v.Destroy(); }
            else { keep.Add(v); }
        }
        views = keep;
        shownUrl = "";
        if (Tabs().Count() == 0) { Tabs().AddNew(); }
    }

    static void Switched() {
        shownUrl = "";
    }

    static WebViewBox Active() {
        int i = Tabs().Active();
        if (i < 0 || i >= views.Count) { return null; }
        return views[i];
    }

    /* 每帧回填地址、标题、加载状态。 */
    static void Sync() {
        for (int i = 0; i < views.Count; i = i + 1) {
            string label = views[i].CurrentTitle();
            if (label == "") { label = "新建标签"; }
            if (label.Length > 24) { label = label.Substring(0, 24) + "..."; }
            if (Tabs().LabelAt(i) != label) {
                Tabs().SetLabel(i, label);
            }
        }
        Bar().SetText(1, Convert.ToString(views.Count) + " 个标签");
        WebViewBox v = {{NAME}}.Active();
        if (v == null) { return; }
        string url = v.CurrentUrl();
        if (editing) { return; }
        if (url != "" && url != shownUrl) {
            shownUrl = url;
            AddressBar().SetText(url);
        }
        Bar().SetText(0, {{NAME}}.Status(v));
    }

    static string Status(WebViewBox v) {
        if (v.IsLoading()) {
            string req = v.View().LastRequest();
            if (req == "") { req = v.CurrentUrl(); }
            return "正在加载 " + req;
        }
        string s = v.CurrentTitle();
        if (v.LastStatus() > 0) {
            s = s + "  (" + Convert.ToString(v.LastStatus()) + ")";
        }
        if (s == "") { s = "就绪"; }
        return s;
    }
}
