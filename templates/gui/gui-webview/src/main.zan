using System;
using Gui;
using Gui.Widget;

// A window hosting real web content: WebView is a native browser layer
// (WebView2 on Windows, WKWebView on macOS) placed over the canvas, driven from
// the region it should occupy every frame. Where no native backend exists it
// paints an in-canvas notice instead, so this window still runs.
//
// Chrome (address bar + navigation buttons) is ordinary Gui: the buttons and the
// input read their look from the active skin's style sheet, so `app.UseSkin(...)`
// restyles them without touching this file.
//
// The browser reports back through events -- NavStart, LoadingChanged,
// TitleChanged and NavComplete -- which is how the address bar and the status
// line below stay in sync with pages the user navigates to from inside the page.
class Program {
    static WebView web;
    static Input address;
    static Button goBtn;
    static Button backBtn;
    static Button fwdBtn;
    static Button reloadBtn;
    static string status;

    static void Main() {
        App app = App.CreateDark("{{NAME}}", 1100, 760);
        app.Show();

        Program.web = WebView.Create();
        Program.address = Input.Create("https://example.com");
        Program.address.SetText("https://example.com");
        Program.goBtn = Button.Primary("Go");
        Program.backBtn = Button.IconOnly("chevron-left");
        Program.fwdBtn = Button.IconOnly("chevron-right");
        Program.reloadBtn = Button.IconOnly("refresh");
        Program.status = "";
        Program.web.Navigate(Program.address.GetText());
        Program.address.Submit += () => {
            Program.web.Navigate(Program.address.GetText());
        };
        Program.web.NavStart += () => {
            Program.status = "Loading " + Program.web.LastRequest();
        };
        Program.web.NavComplete += () => {
            // Follows in-page navigation too, not just the address bar.
            Program.address.SetText(Program.web.CurrentUrl());
            Program.status = $"{Program.web.CurrentTitle()} "
                + $"({Program.web.LastStatus()})";
        };
        Program.web.TitleChanged += () => {
            app.window.SetTitle(Program.web.CurrentTitle());
        };

        while (app.isRunning) {
            app.BeginFrame();
            Program.Frame(app);
            app.RenderChrome("{{NAME}}");
            app.PresentFrame();
            if (!app.ProcessEvent()) { break; }
        }
        Program.web.Destroy();
    }

    static void Frame(App app) {
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int barY = app.ContentTop() + pad;
        int btn = app.Scale(34);
        int gap = t.gapSmall;
        int W = app.canvas.Width();

        int x = pad;
        if (Ui.Clicked(app, Program.backBtn.Render(app, x, barY, btn))) {
            Program.web.Back();
        }
        x = x + btn + gap;
        if (Ui.Clicked(app, Program.fwdBtn.Render(app, x, barY, btn))) {
            Program.web.Forward();
        }
        x = x + btn + gap;
        if (Ui.Clicked(app, Program.reloadBtn.Render(app, x, barY, btn))) {
            Program.web.Reload();
        }
        x = x + btn + gap;

        int goW = app.Scale(72);
        int addrW = W - x - goW - gap - pad;
        Program.address.Render(app, x, barY, addrW, btn);
        if (Ui.Clicked(app,
                Program.goBtn.Render(app, x + addrW + gap, barY, goW))) {
            Program.web.Navigate(Program.address.GetText());
        }

        int top = barY + btn + pad;
        int statusH = app.Scale(22);
        int viewH = app.canvas.Height() - top - statusH;
        Program.web.Render(app, 0, top, W, viewH);

        string line = Program.status;
        if (Program.web.IsLoading()) { line = line + " ..."; }
        app.canvas.DrawText(pad, top + viewH + app.Scale(4), line,
            t.textSecondary, t.fontSizeSmall);
    }
}
