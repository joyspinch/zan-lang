using System;
using Gui;
using Gui.Widget;

// Business logic for {{NAME}}. The window is designed visually in {{NAME}}.zform
// (open it in the form designer); its typed controls are generated into
// {{NAME}}.g.zan. This file is yours - the designer never overwrites it.
partial class {{NAME}} {
    // Runs once after the window is built, before the event loop starts.
    // The designed controls are available here as typed fields (NameInput,
    // RememberCheck, RoleSelect, VolumeSlider, OkButton, TitleLabel), so
    // autocomplete and event binding just work.
    static void OnLoad(Form form) {
        OkButton.OnClick(() => {
            TitleLabel.SetText("Submitted");
        });
    }
}
