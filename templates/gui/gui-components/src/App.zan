using System;
using System.Json;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 中声明控件结构与 @click/@change/@focus 等事件绑定，
 * 后台类仅需实现事件响应方法（B-ID46 运行期形态：设计稿由 Main 运行期投影，
 * 事件走 form.On 注册，控件用 ui.Ctl("Id") 取用）。 */
partial class {{NAME}} {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    static void Main() {
        ControlBootstrap.Install();
        JsonValue doc = DesignDoc.Load("src/{{NAME}}.html");
        if (doc == null) {
            Console.WriteLine("error: design not found: src/{{NAME}}.html");
            return;
        }
        Form form = Form.Create(doc.Str("winTitle", "{{NAME}}"),
                                doc.Int("winW", 480), doc.Int("winH", 520));
        form.Add(FormBuilder.BuildWith(doc, null));
        if (doc.Bool("winCenter", false)) { form.GetApp().CenterWindow(); }
        ui = form;
        Wire(form);
        OnLoad(form);
        form.Run();
    }

    static void Wire(Form form) {
        form.On("OnSubmit", OnSubmit);
        form.On("OnNameFocus", OnNameFocus);
        form.On("OnNameBlur", OnNameBlur);
        form.On("OnOkEnter", OnOkEnter);
        form.On("OnOkLeave", OnOkLeave);
        form.On("OnRoleChange", OnRoleChange);
        form.On("OnRememberChange", OnRememberChange);
    }

    static void OnLoad(Form form) {
    }

    static void OnSubmit() {
        Title().Text = "已提交";
    }

    static void OnNameFocus() {
        Title().Text = "正在输入姓名";
    }

    static void OnNameBlur() {
        Title().Text = "欢迎";
    }

    static void OnOkEnter() {
        Title().Text = "按回车提交";
    }

    static void OnOkLeave() {
        Title().Text = "欢迎";
    }

    static void OnRoleChange() {
        SelectBox role = (SelectBox)ui.Ctl("RoleSelect");
        Title().Text = "角色：" + role.SelectedLabel();
    }

    static void OnRememberChange() {
        Checkbox remember = (Checkbox)ui.Ctl("RememberCheck");
        Title().Text = "记住我：" + Convert.ToString(remember.IsChecked());
    }

    // 设计稿里的标题 Label：多个处理器共用，收口到一个取用点。
    static Label Title() {
        return (Label)ui.Ctl("TitleLabel");
    }
}
