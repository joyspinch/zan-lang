using System;
using Gui;
using Gui.Widget;

// Business logic for {{NAME}}. The window is designed visually in {{NAME}}.zform
// (open it in the form designer). At compile time zanc projects its typed
// controls and Main from the design, so there is no generated file to keep in
// sync. This file is yours - the designer never overwrites it.
partial class {{NAME}} {
    // Runs once after the window is built, before the event loop starts.
    // The designed controls are available here as typed fields (NameInput,
    // RememberCheck, RoleSelect, VolumeSlider, OkButton, TitleLabel), so
    // autocomplete and event binding just work.
    static void OnLoad(Form form) {
        OkButton.OnClick(() => {
            TitleLabel.Text = "Submitted";
        });

        // Every control carries the same event bundle -- pointer, focus,
        // keyboard, drag -- not just the few that have a dedicated callback.
        NameInput.OnFocus(() => { TitleLabel.Text = "Editing name"; });
        NameInput.OnBlur(() => { TitleLabel.Text = "Welcome"; });
        OkButton.OnEnter(() => { TitleLabel.Text = "Press to submit"; });
        OkButton.OnLeave(() => { TitleLabel.Text = "Welcome"; });
        RoleSelect.OnChange(() => {
            TitleLabel.Text = "Role: " + RoleSelect.Text();
        });
        RememberCheck.OnChange(() => {
            TitleLabel.Text = $"Remember: {RememberCheck.IsChecked()}";
        });
    }
}
