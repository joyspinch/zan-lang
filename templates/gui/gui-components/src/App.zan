using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 中声明控件结构与 @click/@change/@focus 等事件绑定，
   后台类仅需实现事件响应方法，告别在 OnLoad 中冗长繁琐的手动挂载。 */
partial class {{NAME}} {
    static void OnLoad(Form form) {
    }

    static void OnSubmit() {
        TitleLabel.Text = "已提交";
    }

    static void OnNameFocus() {
        TitleLabel.Text = "正在输入姓名";
    }

    static void OnNameBlur() {
        TitleLabel.Text = "欢迎";
    }

    static void OnOkEnter() {
        TitleLabel.Text = "按回车提交";
    }

    static void OnOkLeave() {
        TitleLabel.Text = "欢迎";
    }

    static void OnRoleChange() {
        TitleLabel.Text = "角色：" + RoleSelect.Text();
    }

    static void OnRememberChange() {
        TitleLabel.Text = $"记住我：{RememberCheck.IsChecked()}";
    }
}
