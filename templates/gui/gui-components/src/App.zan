using System;
using Gui;
using Gui.Widget;

/* {{NAME}} —— 常用表单组件 + 数据绑定。
 * 每个输入控件在 {{NAME}}.html 里用 bind="字段名" 双向绑定到下面的字段：
 * 用户操作控件 → 字段自动更新；代码改字段 → 控件下一帧自动刷新（见 OnReset）。
 * 音量旁的数字用单向绑定 :text="volume"，拖动滑块即时跟随，不用写任何事件。 */
partial class {{NAME}} : Form {
    static void Main() {
        new {{NAME}}().Show();
    }

    // ---- 表单字段（与 .html 中 bind 的名字一一对应）----
    string nickname = "";
    string email = "";
    string role = "开发者";      // select 绑定字符串字段 = 选中项文字
    int plan = 0;                // radio-group 绑定整数 = 选中序号
    int volume = 60;
    int seats = 5;
    bool notify = true;
    bool subscribe = false;

    // ---- 结果区 ----
    string status = "填写左侧表单后点击「提交」。";
    string statusClass = "secondary"; // :class 绑定整串替换 class
    string summary = "";

    static string[] PlanNames = new string[] { "免费版", "专业版", "企业版" };

    void OnLoad(Form form) {
        Gui.ThemeSettings.Enable(form.GetApp());
        Gui.Backend.UiDriver.Enable(form.GetApp());
    }

    void OnSubmit() {
        string error = Validate();
        if (error != "") {
            status = "✗ " + error;
            statusClass = "error";
            summary = "";
            return;
        }
        status = "✓ 提交成功";
        statusClass = "success";
        summary = "昵称：" + nickname.Trim()
            + "\n邮箱：" + email.Trim()
            + "\n角色：" + role
            + "\n套餐：" + PlanNames[plan]
            + "\n音量：" + volume + "%"
            + "\n席位数：" + seats
            + "\n通知：" + (notify ? "开启" : "关闭")
            + "\n订阅邮件：" + (subscribe ? "是" : "否");
    }

    void OnReset() {
        nickname = "";
        email = "";
        role = "开发者";
        plan = 0;
        volume = 60;
        seats = 5;
        notify = true;
        subscribe = false;
        status = "已重置为默认值。";
        statusClass = "secondary";
        summary = "";
    }

    // 返回第一条校验错误；全部通过返回空串。
    string Validate() {
        string nick = nickname.Trim();
        if (nick == "") { return "请填写昵称。"; }
        string mail = email.Trim();
        int at = mail.IndexOf("@");
        if (at <= 0 || mail.Substring(at).IndexOf(".") < 0) { return "邮箱格式不正确。"; }
        return "";
    }
}
