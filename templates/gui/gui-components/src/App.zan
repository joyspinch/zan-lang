using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：窗口在 {{NAME}}.zform 中可视化设计，编译时 zanc 自动投影控件和 Main，此文件不会被设计器覆盖。 */
partial class {{NAME}} {
    /* 窗口构建后、事件循环前执行一次；设计控件以类型字段暴露（NameInput、RememberCheck、RoleSelect、VolumeSlider、OkButton、TitleLabel），支持自动补全和事件绑定。 */
    static void OnLoad(Form form) {
        OkButton.OnClick(() => {
            TitleLabel.Text = "已提交";
        });

        /* 每个控件都携带统一的事件集（指针、焦点、键盘、拖拽），不仅限于有专用回调的少量事件。 */
        NameInput.OnFocus(() => { TitleLabel.Text = "正在输入姓名"; });
        NameInput.OnBlur(() => { TitleLabel.Text = "欢迎"; });
        OkButton.OnEnter(() => { TitleLabel.Text = "按回车提交"; });
        OkButton.OnLeave(() => { TitleLabel.Text = "欢迎"; });
        RoleSelect.OnChange(() => {
            TitleLabel.Text = "角色："; + RoleSelect.Text();
        });
        RememberCheck.OnChange(() => {
            TitleLabel.Text = $"记住我：{RememberCheck.IsChecked()}";
        });
    }
}
