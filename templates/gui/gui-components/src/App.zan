using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 中声明控件结构与 @click/@change/@focus 等事件绑定，
 * 后台类仅需实现事件响应方法（B-ID46 运行期形态：设计稿由 Main 运行期投影，
 * 事件走 form.On 注册，控件用 ui.Ctl("Id") 取用）。 */
partial class {{NAME}} : Form {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    static void OnLoad(Form form) {
        ui = form;
    }

    static void OnSubmit() {
        Title().Text = "已提交";
    }

    static void OnNameFocus() {
        Title().Text = "正在输入姓名";
    }

    static void OnNameBlur() {
        Title().Text = "欢迎";
    }

    static void OnOkEnter() {
        Title().Text = "按回车提交";
    }

    static void OnOkLeave() {
        Title().Text = "欢迎";
    }

    static void OnRoleChange() {
        SelectBox role = (SelectBox)ui.Ctl("RoleSelect");
        Title().Text = "角色：" + role.SelectedLabel();
    }

    static void OnRememberChange() {
        Checkbox remember = (Checkbox)ui.Ctl("RememberCheck");
        Title().Text = "记住我：" + Convert.ToString(remember.IsChecked());
    }

    // 设计稿里的标题 Label：多个处理器共用，收口到一个取用点。
    static Label Title() {
        return (Label)ui.Ctl("TitleLabel");
    }
}
