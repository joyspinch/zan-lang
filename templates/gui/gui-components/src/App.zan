using System;
using Gui;
using Gui.Widget;

// Business logic for {{NAME}}. The window is designed visually in {{NAME}}.zform
// (open it in the form designer); its typed controls are generated into
// {{NAME}}.g.zan. This file is yours - the designer never overwrites it.
partial class {{NAME}} {
    // Runs once after the window is built, before the event loop starts.
    // The designed controls are available here as typed fields (NameInput,
    // RememberCheck, RoleSelect, VolumeSlider, OkButton, TitleLabel), so
    // autocomplete and event binding just work.
    static void OnLoad(Form form) {
        OkButton.OnClick(() => {
            TitleLabel.SetText("Submitted");
        });

        // Every control carries the same event bundle -- pointer, focus,
        // keyboard, drag -- not just the few that have a dedicated callback.
        NameInput.OnFocus(() => { TitleLabel.SetText("Editing name"); });
        NameInput.OnBlur(() => { TitleLabel.SetText("Welcome"); });
        OkButton.OnEnter(() => { TitleLabel.SetText("Press to submit"); });
        OkButton.OnLeave(() => { TitleLabel.SetText("Welcome"); });
        RoleSelect.OnChange(() => {
            TitleLabel.SetText("Role: " + RoleSelect.Text());
        });
        RememberCheck.OnChange(() => {
            TitleLabel.SetText($"Remember: {RememberCheck.IsChecked()}");
        });
    }
}
