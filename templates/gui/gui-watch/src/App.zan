using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 模板直接声明 @click 与 @change 绑定，后台类专注处理
 * 登录与输入响应（B-ID149 窗口即对象：事件 @click 按名接线）。 */
partial class {{NAME}} : Form {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    static void OnLoad(Form form) {
        ui = form;
    }

    // 姓名框回车 = 提交（键值从宿主窗口当前键盘事件槽读取）。
    static void OnNameKeyDown() {
        if (Ui.KeyDown(ui.GetApp()) == 13) { OnSignIn(); }
    }

    static void OnSignIn() {
        Input nameIn = (Input)ui.Ctl("NameInput");
        Label title = (Label)ui.Ctl("TitleLabel");
        if (nameIn.GetText() == "") {
            title.Text = "姓名必填";
            return;
        }
        title.Text = "你好，" + nameIn.GetText() + "！";
    }
}
