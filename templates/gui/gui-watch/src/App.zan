using System;
using System.Json;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 模板直接声明 @click 与 @change 绑定，后台类专注处理
 * 登录与输入响应（B-ID46 运行期形态）。 */
partial class {{NAME}} {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    static void Main() {
        ControlBootstrap.Install();
        JsonValue doc = DesignDoc.Load("src/{{NAME}}.html");
        if (doc == null) {
            Console.WriteLine("error: design not found: src/{{NAME}}.html");
            return;
        }
        Form form = Form.Create(doc.Str("winTitle", "{{NAME}}"),
                                doc.Int("winW", 480), doc.Int("winH", 420));
        form.Add(FormBuilder.BuildWith(doc, null));
        if (doc.Bool("winCenter", false)) { form.GetApp().CenterWindow(); }
        ui = form;
        Wire(form);
        OnLoad(form);
        form.Run();
    }

    static void Wire(Form form) {
        form.On("OnSignIn", OnSignIn);
    }

    static void OnLoad(Form form) {
    }

    static void OnSignIn() {
        Input nameIn = (Input)ui.Ctl("NameInput");
        Label title = (Label)ui.Ctl("TitleLabel");
        if (nameIn.GetText() == "") {
            title.Text = "姓名必填";
            return;
        }
        title.Text = "你好，" + nameIn.GetText() + "！";
    }
}
