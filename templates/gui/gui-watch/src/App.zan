using System;
using Gui;
using Gui.Widget;

/* {{NAME}} —— 圆形手表表盘。
 * - 表盘布局在 {{NAME}}.html：自由布局 + data-win-round 圆形窗口，控件放在内接正方形里。
 * - 界面全部通过 bind 绑定下面的字段；Tick 每秒改字段，界面下一帧自动刷新。
 * - 步数 / 心率在这里用随机数模拟，接真实传感器时替换 ReadSensors 即可。 */
partial class {{NAME}} : Form {
    static void Main() {
        new {{NAME}}().Show();
    }

    string timeText = "";
    string dateText = "";
    string stepsText = "";
    string heartText = "";
    string statusText = "";
    string buttonText = "开始锻炼";
    int stepsPercent = 0;
    int heartPercent = 0;

    int steps = 6240;
    int heartRate = 72;
    bool working = false;
    int workoutSeconds = 0;
    Random rng = new Random();

    const int StepGoal = 10000;
    const int MaxHeartRate = 200;
    static string[] WeekNames = new string[] { "周日", "周一", "周二", "周三", "周四", "周五", "周六" };

    void OnLoad(Form form) {
        Gui.ThemeSettings.Enable(form.GetApp());
        Gui.Backend.UiDriver.Enable(form.GetApp());
        Tick();
        // Every 由窗口事件循环驱动，回调里改字段即可，跑完会自动请求重绘。
        form.Every(1000, () => { Tick(); });
    }

    void OnToggleWorkout() {
        working = !working;
        if (working) {
            workoutSeconds = 0;
            buttonText = "结束锻炼";
        } else {
            buttonText = "开始锻炼";
            statusText = "本次锻炼 " + Clock(workoutSeconds);
        }
        Refresh();
    }

    void Tick() {
        ReadSensors();
        if (working) { workoutSeconds = workoutSeconds + 1; }
        Refresh();
    }

    // 模拟传感器：锻炼中步频和心率更高。
    void ReadSensors() {
        if (working) {
            steps = steps + rng.Between(2, 4);
            heartRate = Approach(heartRate, rng.Between(118, 140));
        } else {
            steps = steps + rng.Between(0, 1);
            heartRate = Approach(heartRate, rng.Between(64, 80));
        }
    }

    void Refresh() {
        DateTime now = DateTime.Now();
        timeText = DateTime.Pad2(now.Hour()) + ":" + DateTime.Pad2(now.Minute());
        dateText = $"{now.Month()}月{now.Day()}日 " + WeekNames[now.DayOfWeek()];
        stepsPercent = Math.Min(100, steps * 100 / StepGoal);
        heartPercent = Math.Min(100, heartRate * 100 / MaxHeartRate);
        stepsText = $"{steps} 步";
        heartText = $"{heartRate} 次/分";
        if (working) { statusText = "锻炼中 " + Clock(workoutSeconds); }
        else if (statusText == "") { statusText = "目标 " + StepGoal + " 步"; }
    }

    // 心率每秒向目标值靠近一点，避免跳变。
    static int Approach(int current, int target) {
        if (current < target) { return current + Math.Min(4, target - current); }
        if (current > target) { return current - Math.Min(4, current - target); }
        return current;
    }

    static string Clock(int seconds) {
        return DateTime.Pad2(seconds / 60) + ":" + DateTime.Pad2(seconds % 60);
    }
}
