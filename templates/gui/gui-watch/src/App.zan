using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 模板直接声明 @click 与事件绑定，后台类专注处理登录与输入响应。 */
partial class {{NAME}} {
    static void OnLoad(Form form) {
    }

    static void OnSignIn() {
        if (!__ValidateForm()) { return; }
        TitleLabel.Text = "你好，" + NameInput.GetText() + "！";
    }

    static void OnNameKeyDown(int key, int mod) {
        if (key == 13) {
            TitleLabel.Text = "已按回车";
        }
    }
}
