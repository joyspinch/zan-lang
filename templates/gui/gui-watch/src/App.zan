using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：窗口在 {{NAME}}.zform 中可视化设计，使用自由布局的圆形表盘；控件须保持在圆形设计区内。编译时 zanc 自动投影控件和 Main，此文件不会被设计器覆盖。 */
partial class {{NAME}} {
    /* 窗口构建后、事件循环前执行一次。 */
    static void OnLoad(Form form) {
        SignInButton.OnClick(() => {
            if (!__ValidateForm()) { return; }
            TitleLabel.Text = "你好，" + NameInput.GetText() + "！";
        });
        NameInput.OnEnter(() => { TitleLabel.Text = "已按回车"; });
    }
}
