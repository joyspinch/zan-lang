using System;
using Gui;
using Gui.Widget;

// Business logic for {{NAME}}. The window is designed visually in {{NAME}}.zform
// (open it in the form designer). This form uses FREE layout on a ROUND watch
// canvas: keep controls inside the circular design area. At compile time zanc
// projects its typed controls and Main from the design, so there is no
// generated file to keep in sync. This file is yours - the designer never
// overwrites it.
partial class {{NAME}} {
    // Runs once after the window is built, before the event loop starts.
    static void OnLoad(Form form) {
        SignInButton.OnClick(() => {
            if (!__ValidateForm()) { return; }
            TitleLabel.Text = "Hello " + NameInput.GetText() + "!";
        });
        NameInput.OnEnter(() => { TitleLabel.Text = "Enter pressed"; });
    }
}
