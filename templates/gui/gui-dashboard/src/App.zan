using System;
using Gui;
using Gui.Widget;

// Business logic for {{NAME}}. The cards are laid out on the free canvas of
// {{NAME}}.zform; Refresh on the tool strip is where a data pull belongs.
partial class {{NAME}} {
    static void OnLoad(Form form) {
        MainToolStrip.OnItemClick((int index) => {
            if (index == 0) { Refresh(); }
        });
        Refresh();
    }

    static void Refresh() {
        MainStatusBar.SetText(0, "Refreshed");
    }
}
