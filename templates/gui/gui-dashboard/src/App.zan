using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：卡片在 {{NAME}}.zform 自由画布上布局；工具条的刷新按钮用于拉取数据。 */
partial class {{NAME}} {
    static void OnLoad(Form form) {
        MainToolStrip.OnItemClick((int index) => {
            if (index == 0) { Refresh(); }
        });
        Refresh();
    }

    static void Refresh() {
        MainStatusBar.SetText(0, "已刷新");
    }
}
