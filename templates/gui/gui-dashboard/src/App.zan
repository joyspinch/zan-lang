using System;
using System.Json;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 模板直接声明 @item-click="OnToolClick" 绑定，
 * 后台类专注处理数据与状态（B-ID46 运行期形态）。 */
partial class {{NAME}} {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    static void Main() {
        ControlBootstrap.Install();
        JsonValue doc = DesignDoc.Load("src/{{NAME}}.html");
        if (doc == null) {
            Console.WriteLine("error: design not found: src/{{NAME}}.html");
            return;
        }
        Form form = Form.Create(doc.Str("winTitle", "{{NAME}}"),
                                doc.Int("winW", 1000), doc.Int("winH", 520));
        form.Add(FormBuilder.BuildWith(doc, null));
        if (doc.Bool("winCenter", false)) { form.GetApp().CenterWindow(); }
        ui = form;
        Wire(form);
        OnLoad(form);
        form.Run();
    }

    static void Wire(Form form) {
        form.On("OnToolClick", OnToolClick);
    }

    static void OnLoad(Form form) {
        Refresh();
    }

    static void OnToolClick() {
        ToolStrip tools = (ToolStrip)ui.Ctl("MainToolStrip");
        int index = tools.LastIndex();
        if (index == 0) { Refresh(); }
    }

    static void Refresh() {
        StatusBar sb = (StatusBar)ui.Ctl("MainStatusBar");
        sb.SetText(0, "已刷新");
    }
}
