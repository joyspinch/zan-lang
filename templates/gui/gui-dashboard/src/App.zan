using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 模板直接声明 @item-click="OnToolClick" 绑定，后台类专注处理数据与状态。 */
partial class {{NAME}} {
    static void OnLoad(Form form) {
        Refresh();
    }

    static void OnToolClick() {
        int index = MainToolStrip.LastIndex();
        if (index == 0) { Refresh(); }
    }

    static void Refresh() {
        MainStatusBar.SetText(0, "已刷新");
    }
}
