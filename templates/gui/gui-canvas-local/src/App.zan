using System;
using System.Json;
using Gui;
using Gui.Widget;

/* App 业务逻辑：局部自由画布与自定义算法排版范式（B-ID46 运行期形态）。
 * 窗口设计稿 src/{{NAME}}.html 由 Main 运行期投影：DesignDoc 读文档
 * （发布态读 --embed 烘入的内嵌副本，开发态读散盘），FormBuilder 建树，
 * form.On 注册设计里的 @事件。发布需在 zan.proj 声明
 * gen.embed = src/{{NAME}}.html。 */
partial class App {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    static void Main() {
        ControlBootstrap.Install();
        JsonValue doc = DesignDoc.Load("src/{{NAME}}.html");
        if (doc == null) {
            Console.WriteLine("error: design not found: src/{{NAME}}.html");
            return;
        }
        Form form = Form.Create(doc.Str("winTitle", "{{NAME}}"),
                                doc.Int("winW", 980), doc.Int("winH", 640));
        form.Add(FormBuilder.BuildWith(doc, null));
        if (doc.Bool("winCenter", false)) { form.GetApp().CenterWindow(); }
        ui = form;
        Wire(form);
        OnLoad(form);
        form.Run();
    }

    // 注册设计稿里声明的全部 @事件。
    static void Wire(Form form) {
        form.On("OnDeal", OnDeal);
        form.On("OnRearrange", OnRearrange);
    }

    static void OnLoad(Form form) {
    }

    static void OnDeal() {
        Console.WriteLine("Action: Deal Cards");
    }

    static void OnRearrange() {
        Console.WriteLine("Action: Rearrange in Fan Curve");
    }
}
