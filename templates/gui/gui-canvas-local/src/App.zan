using System;
using Gui;
using Gui.Widget;

/* App 业务逻辑：局部自由画布与自定义算法排版范式（B-ID149 窗口即对象：事件 @click 按名接线）。
 * 窗口设计稿 src/{{NAME}}.html 由 Form.Show 运行期装载建树（发布态读
 * --embed 烘入的内嵌副本，开发态读散盘），事件按名自动接线。发布需在
 * zan.proj 声明 gen.embed = src/{{NAME}}.html。 */
partial class {{NAME}} : Form {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    // 注册设计稿里声明的全部 @事件。
    static void OnLoad(Form form) {
        ui = form;    }

    static void OnDeal() {
        Console.WriteLine("Action: Deal Cards");
    }

    static void OnRearrange() {
        Console.WriteLine("Action: Rearrange in Fan Curve");
    }
}
