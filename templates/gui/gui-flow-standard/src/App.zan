using System;
using System.Json;
using Gui;
using Gui.Widget;

/* App 业务逻辑：标准流式容器驱动，无任何手写绝对坐标（B-ID46 运行期形态）。
 * 窗口设计稿 src/{{NAME}}.html 由 Main 运行期投影；发布时经 zan.proj 的
 * gen.embed 烘进 exe（压缩加密内嵌），开发期直接读散盘。 */
partial class App {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    static void Main() {
        ControlBootstrap.Install();
        JsonValue doc = DesignDoc.Load("src/{{NAME}}.html");
        if (doc == null) {
            Console.WriteLine("error: design not found: src/{{NAME}}.html");
            return;
        }
        Form form = Form.Create(doc.Str("winTitle", "{{NAME}}"),
                                doc.Int("winW", 980), doc.Int("winH", 640));
        form.Add(FormBuilder.BuildWith(doc, null));
        if (doc.Bool("winCenter", false)) { form.GetApp().CenterWindow(); }
        ui = form;
        Wire(form);
        OnLoad(form);
        form.Run();
    }

    static void Wire(Form form) {
        form.On("OnNavDashboard", OnNavDashboard);
        form.On("OnNavSettings", OnNavSettings);
        form.On("OnSave", OnSave);
    }

    static void OnLoad(Form form) {
    }

    static void OnNavDashboard() {
        Console.WriteLine("Nav to Dashboard");
    }

    static void OnNavSettings() {
        Console.WriteLine("Nav to Settings");
    }

    static void OnSave() {
        Console.WriteLine("Settings saved successfully");
    }
}
