using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

/* {{NAME}} —— 标准流式排版的管理后台：顶栏 + 侧栏 + 内容区。
 * - 布局全部是 flex/gap/padding（见 {{NAME}}.html 的 <style>），没有绝对坐标。
 * - 切页：三个页面各绑一个 :visible 布尔字段，OnNav 只改字段，界面自动切换。
 * - 用户列表：<template data-for="users"> 按 users 列表逐行克隆；往列表里加一项，
 *   下一帧就多出一行。
 * - 侧栏按钮用 :class 绑定当前页高亮。 */
partial class {{NAME}} : Form {
    // ---- 导航 ----
    string pageTitle = "";
    bool showDashboard = true;
    bool showUsers = false;
    bool showSettings = false;
    string navDashboard = "";
    string navUsers = "";
    string navSettings = "";
    string lastAction = "";

    // ---- 仪表盘 ----
    string userCountText = "";
    string onlineText = "";
    string saveCountText = "0";
    string activity1 = "";
    string activity2 = "";
    string activity3 = "";

    // ---- 用户 ----
    List<object> users = new List<object>();
    string newUser = "";

    // ---- 设置 ----
    string siteName = "我的站点";
    string adminEmail = "admin@example.com";
    string language = "简体中文";
    bool allowSignup = true;
    string saveMessage = "";
    string saveClass = "secondary";
    int saveCount = 0;

    void OnLoad(Form form) {
        Gui.ThemeSettings.Enable(form.GetApp());
        Gui.Backend.UiDriver.Enable(form.GetApp());
        users.Add(new UserRow("alice", "管理员", true));
        users.Add(new UserRow("bob", "编辑", true));
        users.Add(new UserRow("carol", "访客", false));
        Log("系统启动");
        OnNav("dashboard");
    }

    // 侧栏按钮 data-arg="users" @click="OnNav"：data-arg 的字面量作为参数传进来。
    void OnNav(string page) {
        showDashboard = page == "dashboard";
        showUsers = page == "users";
        showSettings = page == "settings";
        navDashboard = NavClass(showDashboard);
        navUsers = NavClass(showUsers);
        navSettings = NavClass(showSettings);
        if (showDashboard) { pageTitle = "仪表盘"; RefreshStats(); }
        if (showUsers) { pageTitle = "用户管理"; }
        if (showSettings) { pageTitle = "系统设置"; }
    }

    void OnAddUser() {
        string name = newUser.Trim();
        if (name == "") { return; }
        users.Add(new UserRow(name, "访客", true));
        newUser = "";
        Log("新增用户 " + name);
        RefreshStats();
    }

    void OnSave() {
        if (siteName.Trim() == "" || adminEmail.IndexOf("@") <= 0) {
            saveMessage = "站点名称不能为空，邮箱需包含 @。";
            saveClass = "error";
            return;
        }
        saveCount = saveCount + 1;
        saveMessage = "✓ 已保存（" + Now() + "）";
        saveClass = "success";
        Log("保存配置：" + siteName.Trim() + " / " + language + (allowSignup ? " / 开放注册" : " / 关闭注册"));
        RefreshStats();
    }

    void RefreshStats() {
        int online = 0;
        for (int i = 0; i < users.Count; i++) {
            if (((UserRow)users[i]).online) { online = online + 1; }
        }
        userCountText = $"{users.Count}";
        onlineText = $"{online}";
        saveCountText = $"{saveCount}";
    }

    // 最近动态只留三条：新的顶到最上面。
    void Log(string text) {
        activity3 = activity2;
        activity2 = activity1;
        activity1 = Now() + "  " + text;
        lastAction = "最后操作 " + Now();
    }

    // :class 会整串替换 class，所以尺寸档 medium 也要写上。
    static string NavClass(bool active) { return active ? "medium secondary primary" : "medium text"; }

    static string Now() {
        DateTime t = DateTime.Now();
        return DateTime.Pad2(t.Hour()) + ":" + DateTime.Pad2(t.Minute()) + ":" + DateTime.Pad2(t.Second());
    }
}

// 用户列表的一行：字段名对应 data-for 行模板里的 bind。
class UserRow {
    string name = "";
    string role = "";
    string state = "";
    string stateClass = "";
    bool online = false;

    UserRow(string name, string role, bool online) {
        this.name = name;
        this.role = role;
        this.online = online;
        this.state = online ? "在线" : "离线";
        this.stateClass = online ? "success" : "secondary";
    }
}
