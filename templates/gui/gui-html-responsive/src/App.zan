using System;
using System.Json;
using Gui;
using Gui.Widget;

/* 响应式管理后台 code-behind（B-ID46 运行期形态）：
 * 1. 窗口设计稿 src/{{NAME}}.html 由 Main 运行期投影（内嵌副本发布态优先）；
 * 2. 在 HTML 占位容器（TablePlaceholder）中挂载复杂组件，演示
 *    “声明式骨架 + 代码填充”的规范模式。
 */
partial class {{NAME}} {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    static void Main() {
        ControlBootstrap.Install();
        JsonValue doc = DesignDoc.Load("src/{{NAME}}.html");
        if (doc == null) {
            Console.WriteLine("error: design not found: src/{{NAME}}.html");
            return;
        }
        Form form = Form.Create(doc.Str("winTitle", "Zan 响应式控制台"),
                                doc.Int("winW", 1024), doc.Int("winH", 640));
        form.Add(FormBuilder.BuildWith(doc, null));
        if (doc.Bool("winCenter", false)) { form.GetApp().CenterWindow(); }
        ui = form;
        Wire(form);
        OnLoad(form);
        form.Run();
    }

    static void Wire(Form form) {
        form.On("OnAction", OnAction);
        form.On("OnNavDashboard", OnNavDashboard);
        form.On("OnNavUsers", OnNavUsers);
        form.On("OnNavSettings", OnNavSettings);
        form.On("OnNavExit", OnNavExit);
    }

    /* 在 HTML 占位容器中挂载复杂组件：设计稿留一个空 Panel 槽，
     * 代码把真正的控件树填进去。 */
    static void OnLoad(Form form) {
        Control placeholder = form.Ctl("TablePlaceholder");
        if (placeholder != null) {
            Panel tablePanel = Panel.Column().Gap(6);
            tablePanel.With(new Label("• 核心服务调度器：正常 (运行时间: 14天 8小时)"));
            tablePanel.With(new Label("• 数据库连接池：健康 (活动连接: 12/64)"));
            tablePanel.With(new Label("• 缓存中间件命中率：94.2%"));
            placeholder.Add(tablePanel);
        }
    }

    static void OnAction() {
        Console.WriteLine("Action executed from HTML button");
    }

    static void OnNavDashboard() {
        Console.WriteLine("Nav to Dashboard");
    }

    static void OnNavUsers() {
        Console.WriteLine("Nav to Users");
    }

    static void OnNavSettings() {
        Console.WriteLine("Nav to Settings");
    }

    static void OnNavExit() {
        Console.WriteLine("Nav to Exit");
    }
}
