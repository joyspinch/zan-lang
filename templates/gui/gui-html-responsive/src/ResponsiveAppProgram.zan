using System;
using Gui;
using Gui.Core;
using Gui.Widget;

/* 响应式 HTML 应用 code-behind：
 * 1. 负责窗口生命周期与 GenHtml 发射物的挂载；
 * 2. 补齐 GenHtml 树根的 DockFill；
 * 3. 演示“在 HTML 占位容器中挂载复杂组件”的规范模式。
 */
public class ResponsiveAppProgram {
    static int Main() {
        Form form = Form.Create("Zan 响应式控制台", 1024, 640);

        // 1. 通过 GenHtml 编译期生成的静态方法构建 DOM 树
        HtmlHandlers handlers = new HtmlHandlers();
        handlers.Add("OnAction", OnAction);
        handlers.Add("OnNavDashboard", OnNavDashboard);
        handlers.Add("OnNavUsers", OnNavUsers);
        handlers.Add("OnNavSettings", OnNavSettings);
        handlers.Add("OnNavExit", OnNavExit);

        Control root = {{NAME}}Html.Build(handlers);
        if (root == null) {
            Console.WriteLine("error: failed to build {{NAME}}Html root");
            return 1;
        }

        // 2. GenHtml 树根硬契约：必须补齐 DockFill
        root.DockFill();

        // 3. 在 HTML 占位容器中挂载复杂组件
        Control placeholder = root.Find("TablePlaceholder");
        if (placeholder != null) {
            Panel tablePanel = Panel.Column().Gap(6);
            tablePanel.With(new Label("• 核心服务调度器：正常 (运行时间: 14天 8小时)"));
            tablePanel.With(new Label("• 数据库连接池：健康 (活动连接: 12/64)"));
            tablePanel.With(new Label("• 缓存中间件命中率：94.2%"));
            placeholder.Add(tablePanel);
        }

        // 4. 将生成的样式合并入 App
        form.With(root);
        form.Run();
        return 0;
    }

    static void OnAction() {
        Console.WriteLine("Action executed from HTML button");
    }

    static void OnNavDashboard() {
        Console.WriteLine("Nav to Dashboard");
    }

    static void OnNavUsers() {
        Console.WriteLine("Nav to Users");
    }

    static void OnNavSettings() {
        Console.WriteLine("Nav to Settings");
    }

    static void OnNavExit() {
        Console.WriteLine("Nav to Exit");
    }
}
