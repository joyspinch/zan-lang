using System;
using System.Collections.Generic;

/* 监控数据：一组服务及其状态。Refresh() 现在用随机数模拟一次巡检，
 * 接真实系统时换成接口 / 数据库查询即可，界面只读这里的公开字段。 */
public class ServiceInfo {
    public string Name;
    public bool Up;
    public int LatencyMs;
    public int Instances;

    public ServiceInfo(string name, int instances) {
        Name = name;
        Instances = instances;
        Up = true;
        LatencyMs = 0;
    }
}

public class ServiceStore {
    public List<ServiceInfo> Services;
    Random rng;

    public ServiceStore() {
        rng = new Random(42);
        Services = new List<ServiceInfo>();
        Services.Add(new ServiceInfo("api-gateway", 4));
        Services.Add(new ServiceInfo("auth-service", 2));
        Services.Add(new ServiceInfo("order-service", 3));
        Services.Add(new ServiceInfo("payment-service", 2));
        Services.Add(new ServiceInfo("inventory-service", 2));
        Services.Add(new ServiceInfo("search-indexer", 1));
        Services.Add(new ServiceInfo("notification-worker", 2));
        Services.Add(new ServiceInfo("report-scheduler", 1));
        Refresh();
    }

    // 模拟一次巡检：大约每 8 个服务里有 1 个异常。
    public void Refresh() {
        for (int i = 0; i < Services.Count; i = i + 1) {
            ServiceInfo s = Services[i];
            s.Up = rng.NextBelow(8) != 0;
            s.LatencyMs = s.Up ? 8 + rng.NextBelow(120) : 0;
        }
    }

    public int UpCount() {
        int n = 0;
        for (int i = 0; i < Services.Count; i = i + 1) {
            if (Services[i].Up) { n = n + 1; }
        }
        return n;
    }

    public int AverageLatency() {
        int sum = 0;
        int n = 0;
        for (int i = 0; i < Services.Count; i = i + 1) {
            if (Services[i].Up) { sum = sum + Services[i].LatencyMs; n = n + 1; }
        }
        return n == 0 ? 0 : sum / n;
    }

    public int InstanceCount() {
        int n = 0;
        for (int i = 0; i < Services.Count; i = i + 1) { n = n + Services[i].Instances; }
        return n;
    }
}
