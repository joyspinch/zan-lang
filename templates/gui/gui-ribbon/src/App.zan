using System;
using Gui;
using Gui.Widget;

// Business logic for {{NAME}}. RibbonTabs is the command bar (one page per
// tab); HomeCommands is the tool strip on its first page.
partial class {{NAME}} {
    static void OnLoad(Form form) {
        HomeCommands.OnItemClick((int index) => {
            MainStatusBar.SetText(0, "Command " + Convert.ToString(index));
        });
    }
}
