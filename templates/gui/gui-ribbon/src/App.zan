using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 模板直接声明 @item-click="OnHomeCommand" 绑定，
 * 后台类专注处理状态（B-ID149 窗口即对象：事件 @click 按名接线）。 */
partial class {{NAME}} : Form {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    static void OnLoad(Form form) {
        ui = form;
    }

    static void OnHomeCommand() {
        ToolStrip home = (ToolStrip)ui.Ctl("HomeCommands");
        StatusBar sb = (StatusBar)ui.Ctl("MainStatusBar");
        sb.SetText(0, "命令 " + Convert.ToString(home.LastIndex()));
    }
}
