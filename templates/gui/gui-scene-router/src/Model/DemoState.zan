using System;

/* 跨场景共享的游戏状态：场景对象常驻复用，状态放这里由各场景读写，
 * 场景之间不互相引用（menu 不知道 play 的存在，只知道路由名）。 */
public class DemoState {
    int score;
    int best;
    int rounds;
    bool paused;

    /* 一局结束时调用：累计局数、刷新最高分；返回是否破纪录。 */
    bool FinishRound() {
        this.rounds = this.rounds + 1;
        if (this.score > this.best) {
            this.best = this.score;
            return true;
        }
        return false;
    }
}
