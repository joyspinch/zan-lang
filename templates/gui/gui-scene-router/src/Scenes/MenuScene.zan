using System;
using Gui;
using Gui.Widget;
using Game.Kit;
using Game.Foundation.Gui;

public class MenuScene : HtmlScene {
    DemoState st;

    MenuScene(DemoState st) { this.st = st; }

    override string HtmlFile() { return "assets/scenes/menu.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("start", () => this.router.Go("play"));
        handlers.Add("quit", () => this.router.Exit());
    }

    override void OnEnter(Control root) {
        this.st.paused = false;
    }

    override void Event(int kind, int key) {
        if (kind == 4 && key == 27) { this.router.Exit(); }
    }
}

// 玩法：Canvas 直绘弹球（世界层）+ 顶部 HTML HUD（UI 层）。
// 球碰底即掉落 → 路由到结算场景。
