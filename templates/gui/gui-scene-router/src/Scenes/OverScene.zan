using System;
using Gui;
using Gui.Widget;
using Game.Kit;
using Game.Foundation.Gui;

public class OverScene : HtmlScene {
    DemoState st;
    Element scoreEl;

    OverScene(DemoState st) { this.st = st; }

    override string HtmlFile() { return "assets/scenes/over.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("retry", () => this.router.Go("play"));
        handlers.Add("menu", () => this.router.Go("menu"));
    }

    override void OnEnter(Control root) {
        this.scoreEl = null;
        if (root != null) {
            Control sc = root.Find("score");
            if (sc != null && sc is Element) { this.scoreEl = (Element)sc; }
        }
        if (this.scoreEl != null) {
            this.scoreEl.SetText("得分 " + Convert.ToString(this.st.score));
        }
    }

    override void Event(int kind, int key) {
        if (kind == 4 && key == 27) { this.router.Go("menu"); }
    }
}
