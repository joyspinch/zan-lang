using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 模板直接声明 @click="OnOk" 绑定，后台类专注处理业务逻辑
 * （B-ID149 窗口即对象：class X : Form + 同目录同名 .html，事件 @click 按名接线）。 */
partial class {{NAME}} : Form {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    static void OnLoad(Form form) {
        ui = form;
    }

    static void OnOk() {
        Label title = (Label)ui.Ctl("TitleLabel");
        title.Text = "Hello!";
    }
}
