using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：窗口在 {{NAME}}.zform 中可视化设计，编译时 zanc 自动投影控件和 Main，此文件不会被设计器覆盖。 */
partial class {{NAME}} {
    /* 窗口构建后、事件循环前执行一次；设计控件以类型字段暴露，支持自动补全和事件绑定。 */
    static void OnLoad(Form form) {
        OkButton.OnClick(() => {
            TitleLabel.Text = "Hello!";
        });
    }
}
