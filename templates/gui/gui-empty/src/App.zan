using System;
using Gui;
using Gui.Widget;

/* {{NAME}} —— 窗口即对象：本类与同目录的 {{NAME}}.html 配对。
 * - 字段就是界面的数据模型：HTML 里 bind="name" 双向绑定到 name 字段，
 *   bind="greeting" 把 greeting 显示到标签上；改字段，下一帧界面自动更新。
 * - 方法就是事件处理器：@click="OnGreet" / @submit="OnGreet" 按名接到本类方法。
 * 想加控件：在 .html 里写标签并给 id，需要时再加字段或方法即可。 */
partial class {{NAME}} : Form {
    string name = "";
    string greeting = "你好！请先告诉我你的名字。";
    // :class 绑定整串替换 class，所以这里写全（h3 = 小标题字号）。
    string greetingClass = "h3 secondary";
    int greetCount = 0;

    void OnLoad(Form form) {
        Gui.ThemeSettings.Enable(form.GetApp());
        Gui.Backend.UiDriver.Enable(form.GetApp());
    }

    void OnGreet() {
        string who = name.Trim();
        if (who == "") {
            greeting = "名字不能为空。";
            greetingClass = "h3 error";
            return;
        }
        greetCount = greetCount + 1;
        greeting = $"你好，{who}！这是第 {greetCount} 次问候。";
        greetingClass = "h3 success";
    }
}
