using System;
using Gui;
using Gui.Widget;

partial class {{NAME}} : Form {
    static void Main() {
        {{NAME}} window = new {{NAME}}();
        #if PUBLISH
        window.ShowStaticWith("src/{{NAME}}.html", CreateControl, window.Register);
        #else
        window.ShowStaticWith(CreateControl, window.Register, OnLoad);
        #endif
    }

    static Control CreateControl(string kind) {
        switch (kind) {
            case "Button": return new Button();
            case "Input": return new Input();
            case "Label": return new Label();
            default: return null;
        }
    }

    void Register(HandlerRegistry handlers) {
        handlers.Set("OnOk", this.OnOk);
    }

    #if !PUBLISH
    static void OnLoad(Form form) {
        Gui.ThemeSettings.Enable(form.GetApp());
        Gui.Backend.UiDriver.Enable(form.GetApp());
    }
    #endif

    void OnOk() {
        Label title = (Label)this.Ctl("TitleLabel");
        title.Text = "Hello!";
    }
}
