using System;
using Gui;
using Gui.Widget;

// Business logic for {{NAME}}. DocumentTabs holds one page per open document;
// each page owns the controls designed under it in {{NAME}}.zform.
partial class {{NAME}} {
    static void OnLoad(Form form) {
        MainToolStrip.OnItemClick((int index) => {
            MainStatusBar.SetText(0, "Command " + Convert.ToString(index));
        });
    }
}
