using System;
using Gui;
using Gui.Widget;

/* {{NAME}} 业务逻辑：HTML 模板直接声明 @item-click="OnToolClick" 绑定，后台类专注处理状态。 */
partial class {{NAME}} {
    static void OnLoad(Form form) {
    }

    static void OnToolClick() {
        int index = MainToolStrip.LastIndex();
        MainStatusBar.SetText(0, "命令 " + Convert.ToString(index));
    }
}
