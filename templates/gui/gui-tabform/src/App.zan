using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

/* {{NAME}}：多标签文档外壳（MDI 的现代形态）。
 *
 * 文档是运行期数据，所以页签不写死在 {{NAME}}.html 里，而是由本类增删：
 *   - 工具条「新建文档」或页签条右侧「+」→ NewDocument()：加一个可关闭页签，
 *     页里放一个 TextArea；
 *   - 页签上的 × /「关闭当前」/「关闭其他」→ Tabs 发出 TabClosed，
 *     这里同步删掉对应的编辑器（docs 与页签下标一一对应）；
 *   - 切换页签或编辑文字 → 状态栏显示当前是第几个文档、多少字、是否已修改。 */
partial class {{NAME}} : Form {
    // 主窗引用：处理器里用 ui.Ctl("Id") 取设计稿里的控件。
    static Form ui;
    // 与页签下标一一对应的文档。
    static List<DocumentTab> docs;
    static int created;

    const int ToolNew = 0;
    const int ToolClose = 1;
    const int ToolCloseOthers = 2;

    static void OnLoad(Form form) {
        Gui.ThemeSettings.Enable(form.GetApp());
        Gui.Backend.UiDriver.Enable(form.GetApp());
        ui = form;
        docs = new List<DocumentTab>();
        created = 0;

        Tabs tabs = Docs();
        tabs.SetShowAdd(true);
        tabs.TabAdded.Add(() => { NewDocument(""); });
        tabs.TabChanged.Add(() => { UpdateStatus(); });
        tabs.TabClosed.Add(() => {
            int closed = tabs.ClosedIndex();
            if (closed >= 0 && closed < docs.Count) { docs.RemoveAt(closed); }
            UpdateStatus();
        });

        NewDocument("欢迎使用 {{NAME}}。\n\n点工具条「新建文档」或页签条右侧的 + 打开新页签，\n页签上的 × 可以关闭它。");
        NewDocument("");
        tabs.Select(0);
        UpdateStatus();
    }

    static void OnToolClick() {
        ToolStrip tools = (ToolStrip)ui.Ctl("MainToolStrip");
        int index = tools.LastIndex();
        Tabs tabs = Docs();
        if (index == ToolNew) {
            NewDocument("");
        } else if (index == ToolClose) {
            if (tabs.Count() > 0) { tabs.CloseTab(tabs.Active()); }
        } else if (index == ToolCloseOthers) {
            if (tabs.Count() > 0) { tabs.CloseOthers(tabs.Active()); }
        }
        UpdateStatus();
    }

    // 新建一个文档页签并切过去。
    static void NewDocument(string text) {
        created = created + 1;
        DocumentTab doc = new DocumentTab("文档 " + Convert.ToString(created));
        doc.Editor.SetText(text);
        // 只有当前页签的编辑器能被输入，所以 Change 里按"当前页签"找文档；
        // 闭包不捕获 doc / 编辑器本身，避免 编辑器→委托→编辑器 的引用环。
        doc.Editor.Change.Add(() => { OnEdited(); });
        docs.Add(doc);

        Tabs tabs = Docs();
        tabs.Add(doc.Title, true);
        int index = tabs.Count() - 1;
        Panel page = tabs.Page(index);
        // 页面默认是普通流式容器，编辑器的 flex-grow 不生效；改成纵向 flex 让它铺满整页。
        page.SetProp("style", "display: flex; flex-direction: column; flex-grow: 1; min-width: 0; min-height: 0;");
        page.Add(doc.Editor);
        tabs.Select(index);
    }

    static void OnEdited() {
        int active = Docs().Active();
        if (active < 0 || active >= docs.Count) { return; }
        docs[active].Dirty = true;
        UpdateStatus();
    }

    static void UpdateStatus() {
        Tabs tabs = Docs();
        StatusBar sb = (StatusBar)ui.Ctl("MainStatusBar");
        int active = tabs.Active();
        if (tabs.Count() == 0 || active < 0 || active >= docs.Count) {
            sb.SetText(0, "没有打开的文档：点「新建文档」或页签条右侧的 +");
            sb.SetText(1, "");
            return;
        }
        DocumentTab doc = docs[active];
        sb.SetText(0, doc.Title + (doc.Dirty ? "（已修改）" : "") + " · 第 "
            + Convert.ToString(active + 1) + " 个，共 " + Convert.ToString(tabs.Count()) + " 个");
        sb.SetText(1, Convert.ToString(doc.Editor.CountValue()) + " 字");
    }

    static Tabs Docs() {
        return (Tabs)ui.Ctl("DocumentTabs");
    }
}

/* 一个打开的文档：标题 + 编辑器 + 是否改过。 */
class DocumentTab {
    public string Title;
    public TextArea Editor;
    public bool Dirty;

    public DocumentTab(string title) {
        Title = title;
        Dirty = false;
        Editor = new TextArea("在此输入……");
        Editor.SetProp("style", "flex-grow: 1; min-height: 0; margin: var(--padding-medium);");
    }
}
