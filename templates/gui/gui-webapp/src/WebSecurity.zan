using System;
using System.Collections.Generic;
using Gui.Component.WebView;

public class WebSecurity {
    // 启动阶段安全加固：彻底清除敏感环境变量，生产发布模式提前注入禁用 DevTools 参数
    public static void SanitizeEnvironment(bool isDevMode) {
        #if WINDOWS
        Environment.SetEnvironmentVariable("WEBVIEW2_RELEASE_CHANNEL_PREFERENCE", null);
        Environment.SetEnvironmentVariable("WEBVIEW2_BROWSER_EXECUTABLE_FOLDER", null);
        Environment.SetEnvironmentVariable("WEBVIEW2_USER_DATA_FOLDER", null);
        if (!isDevMode) {
            // 生产发布模式：提前为 WebView2 注入禁用 DevTools 参数双重兜底
            Environment.SetEnvironmentVariable("WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS", "--disable-devtools --disable-features=DevTools");
        } else {
            Environment.SetEnvironmentVariable("WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS", null);
        }
        #endif
    }

    // 过滤来自命令行的任何外部注入参数
    public static string[] SanitizeCommandLine(string[] args) {
        if (args == null || args.Length == 0) {
            return new string[0];
        }
        List<string> clean = new List<string>();
        for (int i = 0; i < args.Length; i++) {
            string a = args[i].ToLower();
            if (a.Contains("--remote-debugging") ||
                a.Contains("--devtools") ||
                a.Contains("--remote-allow-origins") ||
                a.Contains("--auto-open-devtools-for-tabs") ||
                a.Contains("--enable-logging") ||
                a.Contains("--single-process")) {
                continue;
            }
            clean.Add(args[i]);
        }
        return clean.ToArray();
    }

    // 生成 128 位 (32 字符十六进制) 强随机 Session 隔离 Token。
    // 必须走 OS CSPRNG（RandomNumberGenerator）：本 token 是本地 HTTP
    // 服务全部路由的 URL 门禁；历史版本用 time(0) 种子的 LCG 生成，
    // 名义 128 位熵实际退化为"进程启动的 Unix 秒"，本机攻击者按启动
    // 时间枚举几百个种子即可打穿隔离（P0-1）。
    public static string GenerateToken() {
        byte[] rnd = RandomNumberGenerator.GetBytes(16);
        // CSPRNG 失败必须当场炸：空 token 会让 WebServer 的门禁退化成
        // StartsWith("/")，等于全路径放行、隔离整个失效（fail-closed，
        // P0-1 修复时引入的回归，这里杜绝它）。
        if (rnd == null) {
            throw new Exception("OS CSPRNG unavailable: cannot generate session token");
        }
        byte[] outb = new byte[32];
        int p = 0;
        for (int i = 0; i < 16; i = i + 1) {
            int v = rnd[i] & 255;
            int hi = v >> 4;
            int lo = v & 15;
            outb[p] = (byte)(hi < 10 ? hi + 48 : hi + 87);
            outb[p + 1] = (byte)(lo < 10 ? lo + 48 : lo + 87);
            p = p + 2;
        }
        return outb.ToStr(0, 32);
    }

    // 配置 WebView 核心安全防御策略（跨平台底层物理阻断 + 前端防探查）
    public static void ConfigureWebViewSecurity(WebView view, bool isDevMode) {
        if (view == null) { return; }
        if (!isDevMode) {
            // 1. 核心底层：跨平台物理关闭 DevTools 与默认右键菜单
            view.SetDevToolsEnabled(false);
            view.SetContextMenuEnabled(false);

            // 2. 前端 DOM 层防探查兜底：拦截 F12 / Ctrl+U 等敏感快捷键
            string antiInspectJs = @"
                (function() {
                    window.addEventListener('contextmenu', function(e) {
                        e.preventDefault();
                        return false;
                    }, true);
                    window.addEventListener('keydown', function(e) {
                        if (e.key === 'F12' ||
                            (e.ctrlKey && (e.key === 'u' || e.key === 'U' || e.key === 's' || e.key === 'S' || e.key === 'i' || e.key === 'I'))) {
                            e.preventDefault();
                            e.stopPropagation();
                            return false;
                        }
                    }, true);
                })();
            ";
            view.InjectScript(antiInspectJs, false);
        } else {
            // 开发调试模式：启用 DevTools 并自动打开调试窗口
            view.SetDevToolsEnabled(true);
            view.SetContextMenuEnabled(true);
            view.OpenDevTools();
        }
    }
}
