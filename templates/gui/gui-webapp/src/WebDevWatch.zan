using System;
using System.IO;
using System.Threading;

/// <summary>
/// 开发模式前端资产监视器：后台线程每 250 ms 递归 stat 一遍 webRoot，
/// 与上一份快照（相对路径 + 写入时间 + 大小拼接串）比对，有差异即置脏。
/// stdlib 的 DirectoryWatcher 不递归子目录且全进程单实例，而 Vite 产物
/// 恰好把哈希命名的资源放在 assets/ 子目录，所以模板内自带这份递归轮询
/// （同为快照比对手法，代价一致：延迟 ≤ 250 ms）。
/// 脏标记由 WebBridge 的 UI 轮询定时器经 WebServer.PollDevReload 消费并
/// 触发 WebView 刷新，实现"保存即生效"。
/// </summary>
public class WebDevWatch {
    /// 被监视的 webRoot。
    static string root = "";
    /// 监视运行标志；Stop 置 false，轮询线程据此退出。
    static bool watching = false;
    /// 脏标记：快照比对发现差异时置位，UI 线程取走时清除。
    static bool dirty = false;

    /// <summary>开始监视 `webRoot`。目录不存在或已在监视时返回 false。</summary>
    public static bool Start(string webRoot) {
        if (watching) { return false; }
        if (webRoot == null || webRoot.Length == 0) { return false; }
        if (!Directory.ExistsOnDisk(webRoot)) { return false; }
        WebDevWatch.root = webRoot;
        WebDevWatch.dirty = false;
        WebDevWatch.watching = true;
        bool started = Thread.Start(PollLoop);
        Console.WriteLine("[zan-webapp] watch: root=" + webRoot + " started=" + started);
        return started;
    }

    /// 停止监视。当前这轮轮询结束后线程退出。
    public static void Stop() {
        watching = false;
    }

    /// <summary>取走并清除脏标记。UI 线程调用。</summary>
    public static bool ConsumeDirty() {
        if (!dirty) { return false; }
        dirty = false;
        return true;
    }

    /// 轮询线程主体：每 250 ms 拍一次全树快照并与上一份比对。
    /// 单轮快照失败（构建期文件被删改导致的 stat 竞态等）只跳过本轮，
    /// 不允许监视线程停摆。
    static void PollLoop() {
        string last = "";
        while (watching) {
            Thread.Sleep(250);
            if (!watching) { break; }
            string now = "";
            try {
                now = Snapshot();
            } catch (Exception ex) {
                Console.WriteLine("[zan-webapp] watch: snapshot error: " + ex.Message);
                continue;
            }
            if (last.Length == 0) {
                Console.WriteLine("[zan-webapp] watch: first snapshot " + now.Length.ToString() + " chars");
            } else if (now.CompareTo(last) != 0) {
                Console.WriteLine("[zan-webapp] watch: change detected");
                dirty = true;
            }
            last = now;
        }
    }

    /// 全树快照：递归拼接 "相对路径|写入时间|大小" 串。
    /// GetFiles/GetDirectories 返回裸名，逐层拼出绝对路径与相对路径；
    /// 列举顺序在目录未变时是稳定的，顺序漂移本身就会被当作一次变化
    /// （代价只是多刷新一次页面，无害）。
    static string Snapshot() {
        StringBuilder sb = new StringBuilder();
        Collect(WebDevWatch.root, "", sb);
        return sb.ToString();
    }

    static void Collect(string absDir, string relPrefix, StringBuilder sb) {
        List<string> names = Directory.GetFiles(absDir);
        for (int i = 0; i < names.Count; i = i + 1) {
            string full = absDir + "/" + names[i];
            sb.Append(relPrefix + names[i] + "|" + FileInfo.GetLastWriteTime(full).ToString() + "|" + FileInfo.GetLength(full).ToString() + "\n");
        }
        List<string> subs = Directory.GetDirectories(absDir);
        for (int i = 0; i < subs.Count; i = i + 1) {
            Collect(absDir + "/" + subs[i], relPrefix + subs[i] + "/", sb);
        }
    }
}
