using System;
using Gui;
using Gui.Component.WebView;

partial class {{NAME}} {
    /* 窗口加载完成：初始化微服务、安全加固、IPC 桥与网页导航 */
    static void OnLoad(Form form) {
        // 0. 跨平台版本更新自检：启动时自动清理上一版本遗留的 .old 临时备份文件
        WebUpdater.CleanupOldFiles();

        // 1. 运行与发布模式自适应：
        // 编译器在 --publish 模式下会自动预定义 PUBLISH 宏，进入物理锁死的安全生产发布状态；
        // 在日常编译与调试运行模式下自动预定义 DEBUG 宏，启用 DevTools 调试支持。
        #if PUBLISH
        bool isDevMode = false;
        #else
        bool isDevMode = true;
        #endif

        // 2. 安全加固：清除危险环境变量，阻断通过外部注入调试参数
        WebSecurity.SanitizeEnvironment(isDevMode);

        // 3. 启动本地全随机端口微服务（带 128 位 Token 隔离，资产全内存解密无临时文件）
        string startUrl = WebServer.StartAndVerify(isDevMode);

        // 4. 配置 WebView 跨平台底层安全策略（生产模式内核级禁用 DevTools、禁用右键菜单）
        WebSecurity.ConfigureWebViewSecurity(MainWebBox.View(), isDevMode);

        // 4. 初始化双向 IPC 消息通信桥与无边框原生拖拽（WM_NCLBUTTONDOWN 原生接管）
        WebBridge bridge = new WebBridge(form, MainWebBox);

        // 注册原生业务示例 RPC 方法（供前端 zan.invoke 调用）
        bridge.Register("getSystemInfo", (string payload) => {
            return "{\"os\":\"" + WebUpdater.GetPlatformName() + "\",\"version\":\"" + WebUpdater.CURRENT_VERSION + "\",\"engine\":\"Zan AOT NativeCode\",\"security\":\"Hardened (Anti-Debugging & In-Memory)\"}";
        });

        bridge.Register("getAppVersion", (string payload) => {
            return WebUpdater.GetVersionInfo();
        });

        bridge.Register("checkUpdate", (string payload) => {
            // 返回示例更新信息（在生产环境中可请求远程 version.json）
            return "{\"hasUpdate\":true,\"latestVersion\":\"1.1.0\",\"releaseDate\":\"2026-09-21\",\"changelog\":\"1. 支持跨平台二进制平滑自更新\\n2. 优化 Vue 3 启动速度\\n3. 增强内嵌加密流式解密性能\",\"downloadUrl\":\"https:  // example.com/download/latest\"}";
        });

        bridge.Register("applyUpdate", (string payload) => {
            // 接收前端请求，执行跨平台自替换与重启
            // 若 payload 含有下载好的本地路径，则直接调用替换
            bool success = WebUpdater.ApplyBinaryUpdate("update_package.tmp");
            return "{\"success\":" + (success ? "true" : "false") + "}";
        });

        bridge.Register("greet", (string payload) => {
            return "{\"message\":\"Hello from Zan Native Backend!\"}";
        });

        // 5. 导航到本地全内存解密的虚拟网页入口
        MainWebBox.Navigate(startUrl);
    }
}
