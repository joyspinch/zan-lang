using System;
using System.IO;
using System.Collections.Generic;

class PackedAsset {
    public string rel;
    public string mime;
    public int offset;
    public int length;

    public PackedAsset(string rel, string mime, int offset, int length) {
        this.rel = rel;
        this.mime = mime;
        this.offset = offset;
        this.length = length;
    }
}

// 系统底层交互与数据流转契约
class PackWeb {
    static void Main(string[] args) {
        string webDir = "web";
        string outFile = "src/WebAssets.zan";

        // 优先检查构建产物目录 wwwroot 或 web/dist，若存在则打包产物；若不存在则打包纯静态 web 目录
        if (Directory.Exists("wwwroot") && Directory.GetPaths("wwwroot").Count > 0) {
            webDir = "wwwroot";
            Console.WriteLine("[PackWeb] Detected production assets in 'wwwroot', bundling distribution build.");
        } else if (Directory.Exists("web/dist")) {
            webDir = "web/dist";
            Console.WriteLine("[PackWeb] Detected production assets in 'web/dist', bundling distribution build.");
        } else if (Directory.Exists("web")) {
            webDir = "web";
            Console.WriteLine("[PackWeb] 'web/dist' not found, falling back to 'web' source directory.");
        } else {
            Console.WriteLine("[PackWeb] Error: Neither 'wwwroot', 'web/dist', nor 'web' directory found.");
            return;
        }

        Console.WriteLine("[PackWeb] Scanning '" + webDir + "' for web assets...");
        List<string> files = new List<string>();
        ScanDir(webDir, files, webDir == "web");

        if (files.Count == 0) {
            Console.WriteLine("[PackWeb] Warning: No files found in '" + webDir + "'.");
            return;
        }

        List<PackedAsset> packedAssets = new List<PackedAsset>();
        List<byte> blob = new List<byte>();

        int currentOffset = 0;
        string prefix = webDir + "/";

        for (int i = 0; i < files.Count; i++) {
            string file = files[i];
            string norm = file.Replace("\\", "/");
            string rel = norm;
            if (rel.StartsWith(prefix)) {
                rel = rel.Substring(prefix.Length);
            } else if (rel.StartsWith(webDir)) {
                rel = rel.Substring(webDir.Length);
            }
            if (!rel.StartsWith("/")) {
                rel = "/" + rel;
            }

            string mime = GuessMime(rel);
            string text = File.ReadAllText(file);
            int len = text.Length;

            packedAssets.Add(new PackedAsset(rel, mime, currentOffset, len));

            // 使用掩码对数据加密 (可替换为高强度对称密文算法)
            for (int j = 0; j < len; j++) {
                int b = text[j] & 255;
                int enc = b ^ 0xA5;
                blob.Add((byte)enc);
            }

            currentOffset += len;
            Console.WriteLine("  + Packed: " + rel + " (" + len + " bytes, " + mime + ")");
        }

        // 构造十六进制字符串
        string hexChars = "0123456789abcdef";
        string hexBlob = "";
        for (int i = 0; i < blob.Count; i++) {
            int b = blob[i] & 255;
            hexBlob += hexChars.Substring((b >> 4) & 15, 1);
            hexBlob += hexChars.Substring(b & 15, 1);
        }

        // 生成 src/WebAssets.zan 源代码
        string code = "// <auto-generated>\n";
        code += "// Generated by Zan Native WebPacker. DO NOT EDIT DIRECTLY.\n";
        code += "// </auto-generated>\n";
        code += "using System;\n";
        code += "using System.Collections.Generic;\n\n";
        code += "public class WebAssetEntry {\n";
        code += "    public string path;\n";
        code += "    public string mime;\n";
        code += "    public int offset;\n";
        code += "    public int length;\n\n";
        code += "    public WebAssetEntry(string path, string mime, int offset, int length) {\n";
        code += "        this.path = path;\n";
        code += "        this.mime = mime;\n";
        code += "        this.offset = offset;\n";
        code += "        this.length = length;\n";
        code += "    }\n";
        code += "}\n\n";
        code += "public static class WebAssets {\n";
        code += "    static Dictionary<string, WebAssetEntry> entries = null;\n";
        code += "    static byte[] rawBlob = null;\n\n";
        code += "    public static readonly string EncryptedHex = \"" + hexBlob + "\";\n\n";
        code += "    public static void Init() {\n";
        code += "        if (entries != null) { return; }\n";
        code += "        entries = new Dictionary<string, WebAssetEntry>();\n";

        for (int i = 0; i < packedAssets.Count; i++) {
            PackedAsset asset = packedAssets[i];
            code += "        entries.Add(\"" + asset.rel + "\", new WebAssetEntry(\"" + asset.rel + "\", \"" + asset.mime + "\", " + asset.offset + ", " + asset.length + "));\n";
        }

        code += "    }\n\n";
        code += "    public static WebAssetEntry GetEntry(string path) {\n";
        code += "        Init();\n";
        code += "        if (entries.ContainsKey(path)) {\n";
        code += "            return entries[path];\n";
        code += "        }\n";
        code += "        return null;\n";
        code += "    }\n\n";
        code += "    public static byte[] ReadAsset(string path) {\n";
        code += "        WebAssetEntry e = GetEntry(path);\n";
        code += "        if (e == null) { return null; }\n";
        code += "        if (rawBlob == null) {\n";
        code += "            rawBlob = DecodeAndDecrypt(EncryptedHex);\n";
        code += "        }\n";
        code += "        byte[] data = new byte[e.length];\n";
        code += "        for (int i = 0; i < e.length; i++) {\n";
        code += "            data[i] = rawBlob[e.offset + i];\n";
        code += "        }\n";
        code += "        return data;\n";
        code += "    }\n\n";
        code += "    static byte[] DecodeAndDecrypt(string hex) {\n";
        code += "        int len = hex.Length / 2;\n";
        code += "        byte[] res = new byte[len];\n";
        code += "        for (int i = 0; i < len; i++) {\n";
        code += "            int hi = FromHex(hex[i * 2]);\n";
        code += "            int lo = FromHex(hex[i * 2 + 1]);\n";
        code += "            int enc = (hi << 4) | lo;\n";
        code += "            res[i] = (byte)(enc ^ 0xA5);\n";
        code += "        }\n";
        code += "        return res;\n";
        code += "    }\n\n";
        code += "    static int FromHex(char c) {\n";
        code += "        if (c >= '0' && c <= '9') { return (int)(c - '0'); }\n";
        code += "        if (c >= 'a' && c <= 'f') { return (int)(c - 'a' + 10); }\n";
        code += "        if (c >= 'A' && c <= 'F') { return (int)(c - 'A' + 10); }\n";
        code += "        return 0;\n";
        code += "    }\n";
        code += "}\n";

        File.WriteAllText(outFile, code);
        Console.WriteLine("[PackWeb] Success! Built '" + outFile + "' (" + blob.Count + " bytes encrypted).");
    }

    static void ScanDir(string dir, List<string> files, bool filterDevFiles) {
        List<string> entries = Directory.GetPaths(dir);
        for (int i = 0; i < entries.Count; i++) {
            string file = entries[i];
            string norm = file.Replace("\\", "/");
            if (filterDevFiles) {
                // 若直接打包 web 源码目录，过滤 node_modules, package.json, vite.config.js 等脚手架文件
                if (norm.Contains("node_modules") || norm.EndsWith("package.json") || norm.EndsWith("package-lock.json") || norm.EndsWith("vite.config.js")) {
                    continue;
                }
            }
            files.Add(file);
        }

        List<string> subDirs = Directory.GetDirectoryPaths(dir);
        for (int i = 0; i < subDirs.Count; i++) {
            string subDir = subDirs[i];
            string normSub = subDir.Replace("\\", "/");
            if (filterDevFiles && (normSub.Contains("node_modules") || normSub.Contains(".git"))) {
                continue;
            }
            ScanDir(subDir, files, filterDevFiles);
        }
    }

    static string GuessMime(string path) {
        if (path.EndsWith(".html") || path.EndsWith(".htm")) { return "text/html; charset=utf-8"; }
        if (path.EndsWith(".js")) { return "application/javascript; charset=utf-8"; }
        if (path.EndsWith(".css")) { return "text/css; charset=utf-8"; }
        if (path.EndsWith(".json")) { return "application/json; charset=utf-8"; }
        if (path.EndsWith(".png")) { return "image/png"; }
        if (path.EndsWith(".svg")) { return "image/svg+xml"; }
        if (path.EndsWith(".jpg") || path.EndsWith(".jpeg")) { return "image/jpeg"; }
        return "application/octet-stream";
    }
}
