using System;
using Gui;
using Gui.Widget;

/* App 业务逻辑：游戏 HUD 九宫格锚定范式（B-ID149 窗口即对象：事件 @click 按名接线）。
 * 窗口设计稿 src/{{NAME}}.html 由 Main 运行期投影；发布时经 zan.proj 的
 * gen.embed 烘进 exe（压缩加密内嵌），开发期直接读散盘。 */
partial class {{NAME}} : Form {
    // 主窗引用：事件处理器用 ui.Ctl("Id") 取设计里的控件。
    static Form ui;

    static void OnLoad(Form form) {
        ui = form;    }

    static void OnSkill1() {
        Console.WriteLine("Cast Skill 1: Slash");
    }

    static void OnSkill2() {
        Console.WriteLine("Cast Skill 2: Dodge");
    }

    static void OnSkill3() {
        Console.WriteLine("Cast Skill 3: Arrow Rain");
    }

    static void OnSkill4() {
        Console.WriteLine("Cast Ultimate: Roar");
    }
}
