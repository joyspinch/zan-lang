using System;

/*
 * {{NAME}} —— 跨平台动态共享库（Windows .dll / Linux .so / macOS .dylib），
 * 导出 C-ABI 函数，可被 C/C++、Python(ctypes)、Rust、Go、C#(P/Invoke)、Node.js(ffi) 调用。
 *
 * 导出规则：
 *   - 只有 public static 方法会导出；符号名 = 类名_方法名（如 {{NAME}}_Add）。
 *     非 public 的方法是库内部实现，不出现在导出表里。
 *   - 参数与返回值只用 C 能直接表示的标量：int → int32_t，long → int64_t，
 *     double → double，bool → bool。Zan 的 string / 数组 / 对象是带引用计数的
 *     托管对象，不是 C 的 char* —— 不要把它们放进导出签名。
 *   - 导出函数不要让异常逃出边界：C 调用方接不住。可能失败的操作用
 *     "返回状态码 + 约定哨兵值" 的方式报告（见 SafeDivide）。
 *
 * include/exports.h 是与这里一一对应的 C 头文件；增删导出时两边同步改。
 * 调用示例见 README.md。
 */
public class {{NAME}} {
    /* 库版本：主版本 * 10000 + 次版本 * 100 + 修订号（1.2.0 → 10200）。
     * 调用方据此做兼容性检查。 */
    public static int Version() {
        return 10200;
    }

    /* 整数相加。 */
    public static int Add(int a, int b) {
        return a + b;
    }

    /* 把 value 限制在 [lo, hi] 区间内。 */
    public static int Clamp(int value, int lo, int hi) {
        if (value < lo) { return lo; }
        if (value > hi) { return hi; }
        return value;
    }

    /* 线性插值：t=0 返回 a，t=1 返回 b。 */
    public static double Lerp(double a, double b, double t) {
        return a + (b - a) * t;
    }

    /* 平面两点间的欧氏距离。 */
    public static double Distance(double x1, double y1, double x2, double y2) {
        double dx = x2 - x1;
        double dy = y2 - y1;
        return Math.Sqrt(dx * dx + dy * dy);
    }

    /* 素数判定（试除到 √n）。 */
    public static bool IsPrime(int n) {
        if (n < 2) { return false; }
        if (n % 2 == 0) { return n == 2; }
        for (int d = 3; d * d <= n; d = d + 2) {
            if (n % d == 0) { return false; }
        }
        return true;
    }

    /* 第 n 个斐波那契数（F0=0, F1=1）；n 超出 [0, 92] 时返回 -1（int64 会溢出）。 */
    public static long Fibonacci(int n) {
        if (n < 0 || n > 92) { return -1; }
        long a = 0;
        long b = 1;
        for (int i = 0; i < n; i++) {
            long next = a + b;
            a = b;
            b = next;
        }
        return a;
    }

    /* 安全除法：除数为 0 不抛异常，而是返回哨兵值 ErrorValue()。
     * 这是导出函数报告失败的典型写法——C 侧比较返回值即可。 */
    public static int SafeDivide(int a, int b) {
        if (b == 0) { return {{NAME}}.ErrorValue(); }
        return a / b;
    }

    /* SafeDivide 失败时的哨兵值（int32 最小值），供调用方比较。 */
    public static int ErrorValue() {
        return -2147483647 - 1;
    }
}
