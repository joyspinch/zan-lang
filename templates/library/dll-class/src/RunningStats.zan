using System;

namespace {{NAME}};

/* 在线统计：逐个喂数据，随时取数量 / 均值 / 标准差 / 最小 / 最大。
 * 用 Welford 算法，不保存历史样本，内存 O(1)，数值稳定。 */
public class RunningStats : IMetric {
    string name;
    long n;
    double mean;
    double m2;
    double min;
    double max;

    public RunningStats(string name) {
        if (name == null || name.Length == 0) {
            throw new ArgumentException("RunningStats 需要非空名字");
        }
        this.name = name;
        this.Reset();
    }

    /* 喂一个样本。 */
    public void Add(double x) {
        this.n = this.n + 1;
        double delta = x - this.mean;
        this.mean = this.mean + delta / (double)this.n;
        this.m2 = this.m2 + delta * (x - this.mean);
        if (this.n == 1 || x < this.min) { this.min = x; }
        if (this.n == 1 || x > this.max) { this.max = x; }
    }

    public long Count() { return this.n; }
    public double Mean() { return this.mean; }
    public double Min() { return this.min; }
    public double Max() { return this.max; }

    /* 样本标准差（n-1）；不足两个样本时为 0。 */
    public double StdDev() {
        if (this.n < 2) { return 0.0; }
        return Math.Sqrt(this.m2 / (double)(this.n - 1));
    }

    public string Name() { return this.name; }
    public double Value() { return this.mean; }

    public string Describe() {
        if (this.n == 0) { return "无样本"; }
        return "n=" + Convert.ToString(this.n)
            + " 均值=" + RunningStats.Fmt(this.mean)
            + " σ=" + RunningStats.Fmt(this.StdDev())
            + " 范围=[" + RunningStats.Fmt(this.min) + ", " + RunningStats.Fmt(this.max) + "]";
    }

    public void Reset() {
        this.n = 0;
        this.mean = 0.0;
        this.m2 = 0.0;
        this.min = 0.0;
        this.max = 0.0;
    }

    /* 两位小数，报表够用。 */
    static string Fmt(double v) {
        return Convert.ToString(Math.Round(v * 100.0) / 100.0);
    }
}
