using System;

namespace {{NAME}};

/* 单调递增计数器：请求数、错误数、处理条数…… */
public class Counter : IMetric {
    string name;
    long count;

    public Counter(string name) {
        if (name == null || name.Length == 0) {
            throw new ArgumentException("Counter 需要非空名字");
        }
        this.name = name;
        this.count = 0;
    }

    /* 加 1。 */
    public void Increment() {
        this.count = this.count + 1;
    }

    /* 加 n；n 必须非负（计数器只增不减）。 */
    public void Add(long n) {
        if (n < 0) {
            throw new ArgumentException("Counter.Add 不接受负数：" + Convert.ToString(n));
        }
        this.count = this.count + n;
    }

    public long Count() { return this.count; }

    public string Name() { return this.name; }
    public double Value() { return (double)this.count; }
    public string Describe() { return Convert.ToString(this.count); }
    public void Reset() { this.count = 0; }
}
