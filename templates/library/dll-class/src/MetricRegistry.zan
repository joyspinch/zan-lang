using System;
using System.Text;

namespace {{NAME}};

/* 指标注册表：按名字登记任意 IMetric，统一查询与出报表。 */
public class MetricRegistry {
    List<IMetric> metrics;

    public MetricRegistry() {
        this.metrics = new List<IMetric>();
    }

    /* 登记一个指标并原样返回，便于链式取用：
     *   Counter hits = (Counter)registry.Register(new Counter("hits")); */
    public IMetric Register(IMetric metric) {
        if (metric == null) { throw new ArgumentException("metric 不能为 null"); }
        if (this.Find(metric.Name()) != null) {
            throw new ArgumentException("指标重名：" + metric.Name());
        }
        this.metrics.Add(metric);
        return metric;
    }

    /* 按名字查找；没有返回 null。 */
    public IMetric Find(string name) {
        for (int i = 0; i < this.metrics.Count; i++) {
            if (this.metrics[i].Name() == name) { return this.metrics[i]; }
        }
        return null;
    }

    public int Count() { return this.metrics.Count; }

    public void ResetAll() {
        for (int i = 0; i < this.metrics.Count; i++) { this.metrics[i].Reset(); }
    }

    /* 多行文本报表：每行 "名字: 描述"。 */
    public string Report() {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < this.metrics.Count; i++) {
            sb.Append(this.metrics[i].Name());
            sb.Append(": ");
            sb.Append(this.metrics[i].Describe());
            sb.Append("\n");
        }
        return sb.ToString();
    }
}
