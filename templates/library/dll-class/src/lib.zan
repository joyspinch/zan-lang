using System;

/*
 * {{NAME}} 类库 —— 一组可复用的"指标"类型：计数器、滑动统计、注册表。
 * 换成你自己的业务类型时，保留这里的组织方式即可：
 *
 *   src/lib.zan             入口：库信息 + 公开 API 一览（本文件）
 *   src/IMetric.zan         接口：所有指标的共同契约
 *   src/Counter.zan         实现：单调计数器
 *   src/RunningStats.zan    实现：在线均值 / 方差 / 极值（Welford 算法）
 *   src/MetricRegistry.zan  组合：按名字登记、查询、输出报表
 *
 * 约定：
 *   - 全部类型放在 namespace {{NAME}} 下，调用方 `using {{NAME}};` 即可；
 *   - public 是对外承诺，改签名就是破坏性变更；内部辅助不写 public；
 *   - 输入不合法时抛 ArgumentException，而不是悄悄返回怪值。
 *
 * 如何被其他工程引用见 README.md。
 */
namespace {{NAME}};

public class LibraryInfo {
    /* 语义化版本号：破坏性变更升主版本，新增 API 升次版本。 */
    public static string Version() {
        return "1.0.0";
    }

    public static string Name() {
        return "{{NAME}}";
    }
}
