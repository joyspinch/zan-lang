using System;
using System.Net.Sockets;
using System.Net.Http;

/* {{NAME}} -- Zan 协程运行期上的最小 HTTP 服务器。 */
/* 每个连接在独立协程上服务（见 stdlib HttpServer）；如需完整框架（路由/{param}、限流、认证、钩子、内存视图），改用 "Web MVC Framework" 模板。 */
class Program {
    static async int Run() {
        HttpRouter router = new HttpRouter();
        router.Get("/", "<h1>{{NAME}}</h1><p>Hello from Zan!</p>");
        router.Get("/ping", "pong");

        Socket.Initialize();
        TcpListener listener = new TcpListener("127.0.0.1", 8080);
        listener.Start();
        Console.WriteLine("{{NAME}} listening on http://127.0.0.1:8080");
        while (true) {
            nint client = await listener.AcceptAsync();
            if (client >= 0) {
                Task.Spawn(Serve(client, router));
            }
        }
        return 0;
    }

    static async void Serve(nint sock, HttpRouter router) {
        TcpClient client = TcpClient.FromSocket(sock);
        bool keepAlive = true;
        while (keepAlive) {
            string raw = await client.RecvReuseAsync();
            if (raw.Length == 0) { break; }
            HttpRequest req = HttpRequest.Parse(raw);
            keepAlive = req.keepAlive;
            HttpResponse resp = router.Match(req);
            resp = resp.SetKeepAlive(keepAlive);
            int _sent = await client.SendAsync(resp.Build());
            if (!keepAlive) { break; }
        }
        client.Close();
    }

    static void Main() {
        int r = await Run();
    }
}