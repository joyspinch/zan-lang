using System;
using System.Net;
using System.Net.Http;

/* 路由表：把 "方法 + 路径" 翻译成处理函数调用。
 * 静态页面用 HttpRouter 预登记（命中即返回固定内容）；带参数的 REST 路径手工匹配，
 * 一目了然，也方便加新接口：在 Dispatch 里照着 /api/todos 再写一段即可。 */
public class Routes {
    static HttpRouter pages;

    public static void Register() {
        pages = new HttpRouter();
        pages.Get("/", Routes.IndexHtml());
        /* GEO（生成式引擎优化）：给大模型搜索引擎的站点索引。 */
        pages.Get("/llms.txt", Routes.LlmsTxt());
        pages.Get("/.well-known/llms.txt", Routes.LlmsTxt());
    }

    public static HttpResponse Dispatch(HttpRequest req) {
        string path = req.path;
        if (path == "/health") {
            return HttpResponse.Json("{\"status\":\"ok\"}");
        }
        if (path == "/api/todos") {
            if (req.IsGet()) { return TodoApi.List(req); }
            if (req.IsPost()) { return TodoApi.Create(req); }
            return TodoApi.Error(405, "Method Not Allowed", "只支持 GET / POST");
        }
        if (path.StartsWith("/api/todos/")) {
            string idText = path.Substring(11);
            if (req.IsGet()) { return TodoApi.Get(idText); }
            if (req.IsPut()) { return TodoApi.Update(idText, req); }
            if (req.IsDelete()) { return TodoApi.Delete(idText); }
            return TodoApi.Error(405, "Method Not Allowed", "只支持 GET / PUT / DELETE");
        }
        if (req.IsGet()) {
            HttpResponse page = pages.Match(req);
            if (page.statusCode != 404) { return page; }
        }
        return TodoApi.Error(404, "Not Found", "没有这个接口：" + path);
    }

    static string IndexHtml() {
        return "<!doctype html><meta charset=\"utf-8\"><title>{{NAME}}</title>"
            + "<h1>{{NAME}}</h1><p>Zan HTTP/JSON 服务骨架。</p><ul>"
            + "<li>GET <a href=\"/health\">/health</a></li>"
            + "<li>GET <a href=\"/api/todos\">/api/todos</a></li>"
            + "<li>GET /api/todos/{id}</li>"
            + "<li>POST /api/todos  {\"title\":\"...\"}</li>"
            + "<li>PUT /api/todos/{id}  {\"title\":\"...\",\"done\":true}</li>"
            + "<li>DELETE /api/todos/{id}</li></ul>";
    }

    static string LlmsTxt() {
        return "# {{NAME}}\n\n> Zan HTTP/JSON service\n\n"
            + "- [Health](/health): health check\n"
            + "- [Todos](/api/todos): todo list API (GET/POST, GET/PUT/DELETE /api/todos/{id})\n";
    }
}
