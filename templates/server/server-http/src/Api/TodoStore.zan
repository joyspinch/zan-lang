using System;

/* 内存存储：进程重启即清空。接口刻意做成"仓储"形状（All/Find/Add/Remove），
 * 换成数据库时只改这个类，TodoApi 不用动。 */
public class TodoStore {
    static List<Todo> items = new List<Todo>();
    static int nextId = 1;

    public static List<Todo> All() {
        return items;
    }

    public static Todo Find(int id) {
        for (int i = 0; i < items.Count; i++) {
            if (items[i].id == id) { return items[i]; }
        }
        return null;
    }

    public static Todo Add(string title) {
        Todo t = new Todo();
        t.id = nextId;
        nextId = nextId + 1;
        t.title = title;
        t.done = false;
        t.createdAt = DateTime.GetCurrentUnixMilliseconds();
        items.Add(t);
        return t;
    }

    public static bool Remove(int id) {
        Todo t = TodoStore.Find(id);
        if (t == null) { return false; }
        items.Remove(t);
        return true;
    }
}
