using System;

/* 待办事项：字段即 JSON 键（Json.Serialize/Deserialize 按字段名映射）。 */
public class Todo {
    public int id;
    public string title;
    public bool done;
    public long createdAt;   /* Unix 毫秒 */
}

/* POST / PUT 请求体。字段缺省时 title 为 null、done 为 false。 */
public class TodoInput {
    public string title;
    public bool done;
}
