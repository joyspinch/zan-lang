using System;

namespace ZanWeb.Game;

/* UTF-8 感知的字符计数与截断（原并行 Fmt.zan 的 CharCount/SubChar 迁为
   应用自有面）：字符串按字节索引，字符数按首字节判宽——游戏名/公告等
   玩家可见文案限长按字符而非字节。包 Fmt 无此二者，应用侧补齐。 */
class GameFmt {
    /* UTF-8 字符数：续字节（10xxxxxx）不计数。 */
    static int CharCount(string s) {
        int n = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            if ((s[i] & 0xC0) != 0x80) { n = n + 1; }
        }
        return n;
    }

    /* 按完整字符截断到 maxChars：不切半个多字节字符。 */
    static string SubChar(string s, int maxChars) {
        if (GameFmt.CharCount(s) <= maxChars) { return s; }
        string cut = "";
        int chars = 0;
        int i = 0;
        while (i < s.Length && chars < maxChars) {
            int b0 = s[i] & 255;
            int w = 1;
            if ((b0 & 0xE0) == 0xC0) { w = 2; }
            else if ((b0 & 0xF0) == 0xE0) { w = 3; }
            else if ((b0 & 0xF8) == 0xF0) { w = 4; }
            if (i + w > s.Length) { break; }
            cut = cut + s.Substring(i, w);
            i = i + w;
            chars = chars + 1;
        }
        return cut;
    }
}
