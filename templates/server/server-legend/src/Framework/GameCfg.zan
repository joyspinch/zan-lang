using System;
using System.Json;

namespace ZanWeb.Game;

/* [game] 配置（原并行 Cfg.zan 的 Game 段迁为应用自有面）：TCP 游戏网关
   与世界节奏。游戏世界是进程内单例，[worker].count 必须为 1。包 Cfg
   不含应用段——配置的平台段归包，游戏段归应用，首次取用 V() 时从
   config/app.json 的 [game] 叠加到内置默认值（缺失字段逐项回落）。 */
class GameCfg {
    /* 游戏网关绑定地址；局域网互联用 0.0.0.0。*/
    string host;
    /* 游戏网关端口（HTTP 管理后台用 [server].port）。*/
    int port;
    /* 世界心跳步长（毫秒）。*/
    int tickMs;
    /* 心跳超时（秒）：超时未收到任何消息即按断线处理并落库。*/
    int kickSeconds;
    /* 在线会话落库周期（秒）。*/
    int flushSeconds;
    /* 离线收益：每小时金币，与封顶小时数；登录时一次性结算。*/
    long offlineGoldPerHour;
    int offlineCapHours;
    /* 坐标上限：walk 的 x/y 钳在 [0, walkMax]。*/
    int walkMax;
    /* 网关会话加密的共享 secret：与客户端约定的口令，派生每连接
       AES-256-GCM 密钥（Secure.zan）。空 = 加密握手不可用（只明文）。*/
    string secret;
    /* 1 = 拒绝未加密会话（hello 之外的所有明文 op 一律拒绝）。*/
    int requireEnc;
    /* 服务器连接密码：hello 的 pass 字段须与此一致，否则拒绝并断开。
       空 = 不设门禁。给玩家口令用，与加密 secret 分开。*/
    string gatePass;

    static GameCfg v;

    /* 单例：worker 内首次取用解析一次；解析失败按内置默认值继续。 */
    public static GameCfg V() {
        if (GameCfg.v != null) { return GameCfg.v; }
        GameCfg c = new GameCfg();
        c.host = "0.0.0.0";
        c.port = 47100;
        c.tickMs = 1000;
        c.kickSeconds = 90;
        c.flushSeconds = 10;
        c.offlineGoldPerHour = 500;
        c.offlineCapHours = 12;
        c.walkMax = 511;
        c.secret = "zan-game-dev-secret";
        c.requireEnc = 0;
        c.gatePass = "";
        JsonValue root = null;
        if (File.Exists("config/app.json")) {
            string txt = File.ReadAllText("config/app.json");
            if (txt.Length > 0) { root = JsonValue.ParseLenient(txt); }
        }
        if (root != null) {
            JsonValue g = root.Get("game");
            if (g != null && g.IsObject()) {
                c.host = g.Str("host", c.host);
                c.port = g.Int("port", c.port);
                c.tickMs = g.Int("tickMs", c.tickMs);
                c.kickSeconds = g.Int("kickSeconds", c.kickSeconds);
                c.flushSeconds = g.Int("flushSeconds", c.flushSeconds);
                c.offlineGoldPerHour = g.Long("offlineGoldPerHour", c.offlineGoldPerHour);
                c.offlineCapHours = g.Int("offlineCapHours", c.offlineCapHours);
                c.walkMax = g.Int("walkMax", c.walkMax);
                c.secret = g.Str("secret", c.secret);
                c.requireEnc = g.Int("requireEnc", c.requireEnc);
                c.gatePass = g.Str("gatePass", c.gatePass);
            }
        }
        GameCfg.v = c;
        return c;
    }
}
