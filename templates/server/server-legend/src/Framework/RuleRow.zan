using System;
using System.Collections.Generic;
using System.Csv;
using System.IO;
using ZanWeb.Model.Game;

public class RuleRow {
    string location;
    Dictionary<string, string> fields = new Dictionary<string, string>();

    void Put(string key, string value) { fields[key] = value; }
    bool Has(string key) { return fields.ContainsKey(key); }

    string Text(string key) {
        if (!fields.ContainsKey(key)) { throw new Exception(location + ": missing column " + key); }
        return fields[key];
    }

    int Int(string key) { return Ruleset.ParseInt(Text(key), location + ": " + key); }
    long Long(string key) { return (long)Int(key); }

    bool Flag(string key) {
        string v = Text(key);
        if (v == "1" || v == "true" || v == "yes") { return true; }
        if (v == "0" || v == "false" || v == "no" || v.Length == 0) { return false; }
        throw new Exception(location + ": not a flag: " + key + "=" + v);
    }
}

/* 一张规则表：按行序 + 按 id 索引。id 列恒为第一列的规范十进制。 */
