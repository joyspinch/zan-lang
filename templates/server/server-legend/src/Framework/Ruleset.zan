using System;
using System.Collections.Generic;
using System.Csv;
using System.IO;
using ZanWeb.Model.Game;

public class Ruleset {
    string name;
    List<RuleRow> rows = new List<RuleRow>();
    Dictionary<string, RuleRow> byId = new Dictionary<string, RuleRow>();

    List<RuleRow> All() { return rows; }
    int Count() { return rows.Count; }

    RuleRow At(int id) { return ById(Convert.ToString(id)); }

    RuleRow ById(string id) {
        if (!byId.ContainsKey(id)) { throw new Exception(name + ": unknown id " + id); }
        return byId[id];
    }

    /* 软查询：缺 id 返回 false（运行时可选行，如未标价的回收物品）。
       配置校验仍用 ById——缺行就该在启动时炸。 */
    bool TryById(string id, out RuleRow row) {
        if (this.byId.ContainsKey(id)) {
            row = this.byId[id];
            return true;
        }
        row = null;
        return false;
    }

    /* 列名存在性检查（用于可选列，如 encounters.progress_cap_mode）。 */
    bool HasColumn(string key) { return rows.Count > 0 && rows[0].Has(key); }

    static int ParseInt(string value, string context) {
        if (value.Length == 0) { throw new Exception(context + ": empty integer"); }
        int start = value.Substring(0, 1) == "-" ? 1 : 0;
        if (start == value.Length) { throw new Exception(context + ": invalid integer"); }
        long n = 0;
        for (int i = start; i < value.Length; i = i + 1) {
            int digit = value[i] & 255;
            if (digit < 48 || digit > 57) { throw new Exception(context + ": invalid integer " + value); }
            n = n * 10 + digit - 48;
            if (n > 2147483647) { throw new Exception(context + ": integer overflow"); }
        }
        return start == 1 ? 0 - (int)n : (int)n;
    }

    /* schema 项：`列` = 必需非空文本；`列:min:max` = 必需且在闭区间内。 */
    static Ruleset Load(string path, string schema) {
        if (!File.Exists(path)) { throw new Exception("Configuration missing: " + path); }
        string text = File.ReadAllText(path);
        if (text.Length > 0 && text.Substring(0, 1) == "\uFEFF") { text = text.Substring(1, text.Length - 1); }
        Ruleset.CheckQuotes(path, text);
        CsvTable parsedCsv = Csv.Parse(text);
        if (parsedCsv.RowCount() < 1) { throw new Exception(path + ": empty table"); }
        Ruleset table = new Ruleset();
        table.name = path;
        List<string> header = parsedCsv.Header();
        List<string> spec = schema.Split(",");
        if (header.Count != spec.Count) { throw new Exception(path + ": schema column count mismatch"); }
        for (int c = 0; c < header.Count; c = c + 1) {
            string column = header[c];
            int seen = 0;
            for (int o = 0; o < header.Count; o = o + 1) { if (header[o] == column) { seen = seen + 1; } }
            if (column.Length == 0 || seen != 1) { throw new Exception(path + ": duplicate or empty header " + column); }
            if (spec[c].Split(":")[0] != column) { throw new Exception(path + ": schema expects " + spec[c] + " at column " + Convert.ToString(c + 1) + ", found " + column); }
        }
        List<List<string>> dataRows = parsedCsv.Rows();
        for (int r = 0; r < dataRows.Count; r = r + 1) {
            List<string> values = dataRows[r];
            string context = path + ": row " + Convert.ToString(r + 2);
            if (values.Count != header.Count) { throw new Exception(context + ": column count mismatch"); }
            RuleRow row = new RuleRow();
            row.location = context;
            for (int c = 0; c < header.Count; c = c + 1) { row.Put(header[c], values[c]); }
            for (int c = 0; c < spec.Count; c = c + 1) {
                List<string> bits = spec[c].Split(":");
                string value = row.Text(bits[0]);
                if (bits.Count == 3) {
                    int n = ParseInt(value, context + ": " + bits[0]);
                    if (n < ParseInt(bits[1], context) || n > ParseInt(bits[2], context)) {
                        throw new Exception(context + ": out of range " + bits[0]);
                    }
                } else if (value.Length == 0) { throw new Exception(context + ": empty " + bits[0]); }
            }
            string id = row.Text("id");
            /* 数字键表要求规范十进制；`balance` 的 id 是符号名
               （initial_gold…），schema 首项 `id` 无范围，与客户端
               `Tables.zan` 的同一判据对齐。 */
            if (spec[0].StartsWith("id:") && id != Convert.ToString(ParseInt(id, context))) { throw new Exception(context + ": ID must be canonical decimal"); }
            if (table.byId.ContainsKey(id)) { throw new Exception(context + ": duplicate id " + id); }
            table.byId[id] = row;
            table.rows.Add(row);
        }
        return table;
    }

    /* stdlib Csv 刻意宽松，这里先拒掉畸形引号，避免把坏行读成合法行。 */
    static void CheckQuotes(string path, string text) {
        bool quoted = false;
        bool closed = false;
        bool atStart = true;
        for (int i = 0; i < text.Length; i = i + 1) {
            string ch = text.Substring(i, 1);
            if (quoted) {
                if (ch == "\"") {
                    if (i + 1 < text.Length && text.Substring(i + 1, 1) == "\"") { i = i + 1; } else { quoted = false; closed = true; }
                }
            } else if (ch == "," || ch == "\n" || ch == "\r") { atStart = true; closed = false; }
            else if (ch == "\"" && atStart && !closed) { quoted = true; atStart = false; }
            else {
                if (closed || ch == "\"") { throw new Exception(path + ": malformed CSV quotes"); }
                atStart = false;
            }
        }
        if (quoted) { throw new Exception(path + ": unclosed CSV quote"); }
    }
}

/* 规则表全集 + 派生查询。启动装载一次，之后只读。 */
