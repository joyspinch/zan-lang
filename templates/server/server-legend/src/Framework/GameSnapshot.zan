using System;
using System.Data;
using System.Data.Sqlite;
using System.IO;

namespace ZanWeb;

/* data/M2.DB 快照直读。该文件由 tools/sync_csv_to_db.py 从迷你传奇
   data.dll 生成（42 张 Game* 表，纯数据、版本化），服务端把它当
   种子输入，永不改写。列名即 data.dll 原始小写字段，值全为 TEXT，
   NULL 读作空串。种子阶段用独立单连接直读——不能用 ATTACH：池里
   每条连接各自独立，附加只落在其中一条上，下一条查询即漂移。 */
static class GameSnapshot {
    static DbPool pool;
    static IDbConnection db;

    /* 打开并自检种子源表非空；文件缺失或结构不对返回 false，启动中止。 */
    static async bool Open(string path) {
        if (!File.Exists(path)) {
            Console.WriteLine("[game] data snapshot missing: " + path);
            return false;
        }
        GameSnapshot.pool = SqliteConnector.Pool(path, 1);
        GameSnapshot.db = await GameSnapshot.pool.AcquireAsync();
        if (GameSnapshot.db == null) { GameSnapshot.Close(); return false; }
        DbResult probe = await GameSnapshot.db.QueryAsync(
            "select count(*) from gameitem");
        if (probe.RowCount() == 0 || probe.GetInt(0, 0) == 0) {
            Console.WriteLine("[game] data snapshot has no gameitem: " + path);
            GameSnapshot.Close();
            return false;
        }
        return true;
    }

    /* 整表读出，按数值 id 升序（快照 id 列是 TEXT，需 cast）。 */
    static async DbResult Table(string name) {
        return await GameSnapshot.db.QueryAsync("select * from "
            + name + " order by cast(id as integer)");
    }

    /* 单元格取值：NULL/缺列/空串安全，数值格空即 0。 */
    static string Str(DbResult r, int row, string col) {
        return r.GetByName(row, col);
    }

    static int Int(DbResult r, int row, string col) {
        string v = r.GetByName(row, col);
        if (v.Length == 0) { return 0; }
        return Convert.ToInt(v);
    }

    static long Long(DbResult r, int row, string col) {
        string v = r.GetByName(row, col);
        if (v.Length == 0) { return 0; }
        return Convert.ToInt64(v);
    }

    static void Close() {
        if (GameSnapshot.db != null && GameSnapshot.pool != null) {
            GameSnapshot.pool.Release(GameSnapshot.db);
        }
        GameSnapshot.db = null;
        GameSnapshot.pool = null;
    }
}
