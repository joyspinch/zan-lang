using System;

namespace ZanWeb;

/* 应用服务根：Db 和 Cache 由 main.zan 一次性装配并通过构造注入（依赖注入，无惰性静态发现）。单例通过 Use() 安装，通过 Current() 读取。*/
class AppServices {
    static AppServices current;

    DbContext db;
    CacheContext cache;

    AppServices(DbContext db, CacheContext cache) {
        this.db = db;
        this.cache = cache;
    }

    static void Use(AppServices services) {
        AppServices.current = services;
    }

    static AppServices Current() {
        return AppServices.current;
    }

    DbContext Db() {
        return this.db;
    }

    CacheContext Cache() {
        return this.cache;
    }
}
