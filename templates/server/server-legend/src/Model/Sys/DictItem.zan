using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/* 字典类型的一条条目：存储值及 UI 显示标签。 */
[Table(Name = "sys_dict_item")]
class DictItem {
    [Column(IsIdentity = true)]
    int id;

    /* sys_dict_type.code；按机器名引用，导出字典不带代理键。 */
    [Column(StringLength = 64, IsNullable = false)]
    string typeCode;

    [Column(StringLength = 64, IsNullable = false)]
    string value;

    [Column(StringLength = 128, IsNullable = false)]
    string label;

    int sortOrder;
    int status;
    long createdAt;
    long updatedAt;
}