using System.Data;
using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/* 一条权限：角色<roleId>在界面<action>上持有<mask>；每屏一行，每行五位（查看/新增/修改/删除/导出，见 PermBit）。数据库唯一的权限数据。存在的权限=路由表，由控制器上的 [Route]/[Custom] 属性编译生成，新增界面即新增权限；部署决策（角色获得哪些权限）是运行期数据，存于此。中间无权限目录，无需发明代码、无需关联 id、无需重灌。mask 引入前的旧行每行动作为 mask 0，启动时合并（Schema.MigrateGrants）。 */
[Table(Name = "sys_role_grant")]
class RoleGrant {
    [Column(IsIdentity = true)]
    int id;

    int roleId;

    /* 路由命名的界面名（无方法前缀），如 "Users" 或模块前缀 "Admin.System.Users"。 */
    [Column(StringLength = 128, IsNullable = false)]
    string action;

    /* 该角色持有的按钮位，或运算合并；0 标记 mask 引入前的单动作旧行。 */
    int mask;

    long createdAt;
}