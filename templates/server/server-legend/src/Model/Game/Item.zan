using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 物品模板：kind 0=消耗品（hp=回复量）1=武器 2=其他穿戴（首饰/
   勋章/防具……）3=材料（只能卖店）。price 是商店售价；卖给商店按
   price/2 结算，材料（kind=3）不可购买只能掉落+出售——这是打金
   闭环的出水口。minLevel 是穿戴门槛；status=1 上架/可掉落。 */
[Table(Name = "game_item")]
class Item {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 32, IsNullable = false)]
    string name;

    int kind;

    /* 原版属性区间（gameitem a/b/c/d/e 列原值，lo~hi）：攻(a)/魔(b)/
       道(c)/防(d)/魔御(e)。首饰勋章同样带攻（荣耀戒指 攻10-35），
       战斗聚合对全部穿戴位求和，不再只算武器/防具。atk/def 是上限
       （历史列名），xxxMin 是下限；hp 对消耗品是回复量、对装备是
       +HP 上限（原表同列同义）；mp 是装备 +MP。 */
    int atk;
    int atkMin;
    int magic;
    int magicMin;
    int tao;
    int taoMin;
    int def;
    int defMin;
    int mdef;
    int mdefMin;
    int hp;
    int mp;

    /* 商店售价（金币）；0=非卖品。 */
    long price;

    int minLevel;

    /* 穿戴槽位（原版原值）：0=武器 1=衣服 2=头盔 3=项链 4=手镯
       6=戒指 8=腰带 9=靴子 10=勋章 11=宝石；-1=非穿戴（消耗/道具/
       材料/杂物/石头/天书）。客户端背包按它分类签页，穿戴校验按
       slot 落位（原版单手镯/单戒指）。 */
    int slot;

    /* 职业限制（原表 job：1=战士 2=法师 3=道士，0/空=不限）；
       玩家 job 0战/1法/2道，校验时按 job-1 比对。 */
    int jobNeed;

    /* 重量（原值，展示用）。gameitem 的 need/met/f1/fj 语义原工程
       未定型，不导入。 */
    int weight;

    /* 美术键：客户端 art.csv 查到图片文件；键在服务端定，客户端只展示。 */
    [Column(StringLength = 64)]
    string picture;

    int status;
}
