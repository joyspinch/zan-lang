using System;
using System.Collections.Generic;

public class SupremeSlotModel {
    string title;
    string sub;
    string owner;
    long itemId;
    string itemName;
    long value;
    bool copyable;
    int fee;

    SupremeSlotModel(string title, string sub, string owner, long itemId, string itemName, long value, bool copyable, int fee) {
        this.title = title != null ? title : "";
        this.sub = sub != null ? sub : "";
        this.owner = owner != null ? owner : "";
        this.itemId = itemId;
        this.itemName = itemName != null ? itemName : "";
        this.value = value;
        this.copyable = copyable;
        this.fee = fee;
    }

    string Title { get { return title; } }
    string Sub { get { return sub; } }
    string Owner { get { return owner; } }
    long ItemId { get { return itemId; } }
    string ItemName { get { return itemName; } }
    long Value { get { return value; } }
    bool Copyable { get { return copyable; } }
    int Fee { get { return fee; } }
}

// 至尊殿堂全量状态强类型实体。
