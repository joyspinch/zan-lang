using System;
using System.Collections.Generic;

public class SnapItem {
    public int id;
    public string name;
    public string aclass;

    public SnapItem(int id, string name, string aclass) {
        this.id = id;
        this.name = name != null ? name : "";
        this.aclass = aclass != null ? aclass : "";
    }
}

// 五行修炼单行条目强类型实体（服务端权威事实：id/name/rank/xp/need/cap/itemId）。
