using System;
using System.Collections.Generic;

namespace ZanWeb.Model.Game;

/// <summary>
/// 竞技场对手排行强类型实体。
/// </summary>
class ArenaRivalEntry {
    string name;
    int rank;
    bool isMe;

    ArenaRivalEntry(string name, int rank, bool isMe) {
        this.name = name != null ? name : "";
        this.rank = rank;
        this.isMe = isMe;
    }

    string Name { get { return name; } }
    int Rank { get { return rank; } }
    bool IsMe { get { return isMe; } }
}

/// <summary>
/// 行会列表项强类型实体。
/// </summary>
class GuildListItem {
    int id;
    string name;
    string leader;
    int members;
    int memberCap;
    long fund;
    bool isMine;

    GuildListItem(int id, string name, string leader, int members, int memberCap, long fund, bool isMine) {
        this.id = id;
        this.name = name != null ? name : "";
        this.leader = leader != null ? leader : "";
        this.members = members;
        this.memberCap = memberCap;
        this.fund = fund;
        this.isMine = isMine;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    string Leader { get { return leader; } }
    int Members { get { return members; } }
    int MemberCap { get { return memberCap; } }
    long Fund { get { return fund; } }
    bool IsMine { get { return isMine; } }
}

/// <summary>
/// 邮件附件物品条目强类型实体（替代 "itemId:count" 动态字符串切分反模式）。
/// </summary>
class MailAttachmentItem {
    int itemId;
    int count;

    MailAttachmentItem(int itemId, int count) {
        this.itemId = itemId;
        this.count = count;
    }

    int ItemId { get { return itemId; } }
    int Count { get { return count; } }

    static List<MailAttachmentItem> ParseCsv(string csv) {
        List<MailAttachmentItem> list = new List<MailAttachmentItem>();
        if (csv == null || csv.Length == 0) { return list; }
        List<string> parts = csv.Split(",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string p = parts[i].Trim();
            if (p.Length == 0) { continue; }
            List<string> kv = p.Split(":");
            if (kv.Count != 2) { continue; }
            int id = Convert.ToInt(kv[0].Trim());
            int cnt = Convert.ToInt(kv[1].Trim());
            if (id > 0 && cnt > 0) {
                list.Add(new MailAttachmentItem(id, cnt));
            }
        }
        return list;
    }
}

/// <summary>
/// 图鉴已放槽位强类型实体（替代 "组:格:itemId" 字符串动态切分）。
/// </summary>
class TjSlotEntry {
    int group;
    int slot;
    int itemId;

    TjSlotEntry(int group, int slot, int itemId) {
        this.group = group;
        this.slot = slot;
        this.itemId = itemId;
    }

    int Group { get { return group; } }
    int Slot { get { return slot; } }
    int ItemId { get { return itemId; } }

    static List<TjSlotEntry> ParseCsv(string csv) {
        List<TjSlotEntry> list = new List<TjSlotEntry>();
        if (csv == null || csv.Length == 0) { return list; }
        List<string> parts = csv.Split(",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string p = parts[i].Trim();
            if (p.Length == 0) { continue; }
            List<string> kv = p.Split(":");
            if (kv.Count == 3) {
                int g = Convert.ToInt(kv[0].Trim());
                int s = Convert.ToInt(kv[1].Trim());
                int id = Convert.ToInt(kv[2].Trim());
                list.Add(new TjSlotEntry(g, s, id));
            }
        }
        return list;
    }
}

/// <summary>
/// 攻城争夺城池信息强类型实体。
/// </summary>
class SiegeCityItem {
    int id;
    string name;
    string owner;
    string guild;
    long income;
    long cost;
    string date;

    SiegeCityItem(int id, string name, string owner, string guild, long income, long cost, string date) {
        this.id = id;
        this.name = name != null ? name : "";
        this.owner = owner != null ? owner : "";
        this.guild = guild != null ? guild : "";
        this.income = income;
        this.cost = cost;
        this.date = date != null ? date : "";
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    string Owner { get { return owner; } }
    string Guild { get { return guild; } }
    long Income { get { return income; } }
    long Cost { get { return cost; } }
    string Date { get { return date; } }
}

/// <summary>
/// 沙巴克攻城与战役奖励强类型实体（消除客户端硬编码与离线假数据反模式）。
/// </summary>
class SiegeRewardItem {
    int picture;
    int count;

    SiegeRewardItem(int picture, int count) {
        this.picture = picture;
        this.count = count;
    }

    int Picture { get { return picture; } }
    int Count { get { return count; } }
}

/// <summary>
/// 攻城与城池争夺全量状态强类型实体。
/// </summary>
class SiegeStateModel {
    string owner;
    string guild;
    long holdSeconds;
    List<SiegeCityItem> cities;
    List<SiegeRewardItem> rewardsOccupied;
    List<SiegeRewardItem> rewardsRandom;

    SiegeStateModel(string owner, string guild, long holdSeconds, List<SiegeCityItem> cities,
                    List<SiegeRewardItem> rewardsOccupied, List<SiegeRewardItem> rewardsRandom) {
        this.owner = owner != null ? owner : "";
        this.guild = guild != null ? guild : "";
        this.holdSeconds = holdSeconds;
        this.cities = cities != null ? cities : new List<SiegeCityItem>();
        this.rewardsOccupied = rewardsOccupied != null ? rewardsOccupied : new List<SiegeRewardItem>();
        this.rewardsRandom = rewardsRandom != null ? rewardsRandom : new List<SiegeRewardItem>();
    }

    string Owner { get { return owner; } }
    string Guild { get { return guild; } }
    long HoldSeconds { get { return holdSeconds; } }
    List<SiegeCityItem> Cities { get { return cities; } }
    List<SiegeRewardItem> RewardsOccupied { get { return rewardsOccupied; } }
    List<SiegeRewardItem> RewardsRandom { get { return rewardsRandom; } }
}

