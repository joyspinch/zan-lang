// 成就单行条目强类型实体（服务端权威事实：name/req/ok/claimed/rewards）。
class AchRowModel {
    string name;
    string req;
    bool ok;
    bool claimed;
    List<AchRewardCellModel> rewards;

    AchRowModel(string name, string req, bool ok, bool claimed, List<AchRewardCellModel> rewards) {
        this.name = name != null ? name : "";
        this.req = req != null ? req : "";
        this.ok = ok;
        this.claimed = claimed;
        this.rewards = rewards != null ? rewards : new List<AchRewardCellModel>();
    }

    string Name { get { return name; } }
    string Req { get { return req; } }
    bool Ok { get { return ok; } }
    bool Claimed { get { return claimed; } }
    List<AchRewardCellModel> Rewards { get { return rewards; } }
}

// 成就列表全量状态强类型实体。
class AchStateModel {
    List<AchRowModel> rows;

    AchStateModel(List<AchRowModel> rows) {
        this.rows = rows != null ? rows : new List<AchRowModel>();
    }

    List<AchRowModel> Rows { get { return rows; } }

    JsonValue ToJson() {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            AchRowModel r = rows[i];
            JsonValue o = JsonValue.NewObject();
            o.Set("name", JsonValue.NewStr(r.Name));
            o.Set("req", JsonValue.NewStr(r.Req));
            o.Set("ok", JsonValue.NewNum(r.Ok ? "1" : "0"));
            o.Set("claimed", JsonValue.NewNum(r.Claimed ? "1" : "0"));
            JsonValue rw = JsonValue.NewArray();
            for (int k = 0; k < r.Rewards.Count; k = k + 1) {
                AchRewardCellModel cell = r.Rewards[k];
                JsonValue c = JsonValue.NewObject();
                c.Set("pic", JsonValue.NewNum(Convert.ToString(cell.Picture)));
                c.Set("badge", JsonValue.NewStr(cell.Badge));
                rw.Append(c);
            }
            o.Set("rewards", rw);
            arr.Append(o);
        }
        return arr;
    }
}

