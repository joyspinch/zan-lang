// BOSS 之家列表状态强类型实体。
class BossListStateModel {
    List<BossListItemModel> rows;

    BossListStateModel(List<BossListItemModel> rows) {
        this.rows = rows != null ? rows : new List<BossListItemModel>();
    }

    List<BossListItemModel> Rows { get { return rows; } }

    JsonValue ToJson() {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            BossListItemModel b = rows[i];
            JsonValue o = JsonValue.NewObject();
            o.Set("tpl", JsonValue.NewNum(Convert.ToString(b.Tpl)));
            o.Set("name", JsonValue.NewStr(b.Name));
            o.Set("level", JsonValue.NewNum(Convert.ToString(b.Level)));
            o.Set("hp", JsonValue.NewNum(Convert.ToString(b.Hp)));
            o.Set("mp", JsonValue.NewNum(Convert.ToString(b.Mp)));
            o.Set("atk", JsonValue.NewNum(Convert.ToString(b.AtkMax)));
            o.Set("atkMin", JsonValue.NewNum(Convert.ToString(b.AtkMin)));
            o.Set("def", JsonValue.NewNum(Convert.ToString(b.Def)));
            o.Set("mdef", JsonValue.NewNum(Convert.ToString(b.Mdef)));
            o.Set("map", JsonValue.NewNum(Convert.ToString(b.MapId)));
            o.Set("exp", JsonValue.NewNum(Convert.ToString(b.Exp)));
            o.Set("gold", JsonValue.NewStr(b.Gold));
            o.Set("alive", JsonValue.NewNum(b.Alive ? "1" : "0"));
            o.Set("respawnIn", JsonValue.NewNum(Convert.ToString(b.RespawnIn)));
            o.Set("drop", JsonValue.NewStr(b.Drop));
            o.Set("picture", JsonValue.NewStr(b.Picture));
            arr.Append(o);
        }
        return arr;
    }
}

// 仓库条目强类型实体。
class WarehouseItemModel {
    int id;
    string name;
    int kind;
    int slot;
    int count;

    WarehouseItemModel(int id, string name, int kind, int slot, int count) {
        this.id = id;
        this.name = name != null ? name : "";
        this.kind = kind;
        this.slot = slot;
        this.count = count;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    int Kind { get { return kind; } }
    int Slot { get { return slot; } }
    int Count { get { return count; } }
}

// 仓库全量列表状态强类型实体。
class WarehouseStateModel {
    List<WarehouseItemModel> items;

    WarehouseStateModel(List<WarehouseItemModel> items) {
        this.items = items != null ? items : new List<WarehouseItemModel>();
    }

    List<WarehouseItemModel> Items { get { return items; } }

    JsonValue ToJson() {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < items.Count; i = i + 1) {
            WarehouseItemModel it = items[i];
            JsonValue o = JsonValue.NewObject();
            o.Set("id", JsonValue.NewNum(Convert.ToString(it.Id)));
            o.Set("name", JsonValue.NewStr(it.Name));
            o.Set("kind", JsonValue.NewNum(Convert.ToString(it.Kind)));
            o.Set("slot", JsonValue.NewNum(Convert.ToString(it.Slot)));
            o.Set("count", JsonValue.NewNum(Convert.ToString(it.Count)));
            arr.Append(o);
        }
        return arr;
    }
}
