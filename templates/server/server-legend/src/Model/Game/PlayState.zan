// 称谓分页状态强类型实体。
class TitleStateModel {
    int page;
    int pages;
    int total;
    long pts;
    long fame;
    List<TitleItemModel> titles;

    TitleStateModel(int page, int pages, int total, long pts, long fame, List<TitleItemModel> titles) {
        this.page = page;
        this.pages = pages;
        this.total = total;
        this.pts = pts;
        this.fame = fame;
        this.titles = titles != null ? titles : new List<TitleItemModel>();
    }

    int Page { get { return page; } }
    int Pages { get { return pages; } }
    int Total { get { return total; } }
    long Pts { get { return pts; } }
    long Fame { get { return fame; } }
    List<TitleItemModel> Titles { get { return titles; } }

    void IntoJson(JsonValue r) {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < titles.Count; i = i + 1) {
            TitleItemModel t = titles[i];
            JsonValue o = JsonValue.NewObject();
            o.Set("id", JsonValue.NewNum(Convert.ToString(t.Id)));
            o.Set("name", JsonValue.NewStr(t.Name));
            o.Set("fame", JsonValue.NewNum(Convert.ToString(t.Fame)));
            o.Set("gold", JsonValue.NewNum(Convert.ToString(t.Gold)));
            o.Set("rebirth", JsonValue.NewNum(Convert.ToString(t.Rebirth)));
            o.Set("level", JsonValue.NewNum(Convert.ToString(t.Level)));
            o.Set("atkMin", JsonValue.NewNum(Convert.ToString(t.AtkMin)));
            o.Set("atkMax", JsonValue.NewNum(Convert.ToString(t.AtkMax)));
            o.Set("magMin", JsonValue.NewNum(Convert.ToString(t.MagMin)));
            o.Set("magMax", JsonValue.NewNum(Convert.ToString(t.MagMax)));
            o.Set("taoMin", JsonValue.NewNum(Convert.ToString(t.TaoMin)));
            o.Set("taoMax", JsonValue.NewNum(Convert.ToString(t.TaoMax)));
            o.Set("defMin", JsonValue.NewNum(Convert.ToString(t.DefMin)));
            o.Set("defMax", JsonValue.NewNum(Convert.ToString(t.DefMax)));
            o.Set("mdefMin", JsonValue.NewNum(Convert.ToString(t.MdefMin)));
            o.Set("mdefMax", JsonValue.NewNum(Convert.ToString(t.MdefMax)));
            o.Set("owned", JsonValue.NewNum(t.Owned ? "1" : "0"));
            o.Set("worn", JsonValue.NewNum(t.Worn ? "1" : "0"));
            arr.Append(o);
        }
        r.Set("rows", arr);
        r.Set("page", JsonValue.NewNum(Convert.ToString(page)));
        r.Set("pages", JsonValue.NewNum(Convert.ToString(pages)));
        r.Set("total", JsonValue.NewNum(Convert.ToString(total)));
        r.Set("pts", JsonValue.NewNum(Convert.ToString(pts)));
        r.Set("fame", JsonValue.NewNum(Convert.ToString(fame)));
    }
}

