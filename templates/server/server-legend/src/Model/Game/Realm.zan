using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 区服表。state：0=开放（可登录进入）、1=维护（拒绝 enter/create，
   客户端列表置灰）。sort 决定客户端列表顺序。区服在本模板里是逻辑
   分区（同进程按 realmId 隔离广播与角色）；扩多进程时本表加 host/port
   即可变成路由表，协议不变。castleLord 是沙巴克城主角色名（城池争夺
   押上城主者），空=无主。 */
[Table(Name = "game_realm")]
class Realm {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    /* 分区组：客户端「分区」窗按本列分组（如“永久区”“公测1-10区”），
       组内再列区服。空串按“永久区”处理（旧库行不用回填）。 */
    [Column(StringLength = 32, IsNullable = false)]
    string grp;

    /* 0=开放 1=维护。 */
    int state;

    int sort;

    /* 沙巴克城主角色名（城池争夺产出，空=无主）。 */
    [Column(StringLength = 32)]
    string castleLord;

    /* 区服倍率（万分比整型，10000=1.0 倍）：活动服可单独调经验/金币/
       爆率，数据本身已按 realmId 隔离，互不影响。同倍率的区服才可
       合区——合区工具按这三列校验。 */
    int expRate;
    int goldRate;
    int dropRate;

    long createdAt;
}
