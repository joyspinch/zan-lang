using System;
using System.Collections.Generic;

public class BossListItemModel {
    int tpl;
    string name;
    int level;
    long hp;
    int mp;
    int atkMin;
    int atkMax;
    int def;
    int mdef;
    int mapId;
    int exp;
    string gold;
    bool alive;
    long respawnIn;
    string drop;
    string picture;

    BossListItemModel(
        int tpl, string name, int level, long hp, int mp,
        int atkMin, int atkMax, int def, int mdef, int mapId,
        int exp, string gold, bool alive, long respawnIn, string drop, string picture
    ) {
        this.tpl = tpl;
        this.name = name != null ? name : "";
        this.level = level;
        this.hp = hp;
        this.mp = mp;
        this.atkMin = atkMin;
        this.atkMax = atkMax;
        this.def = def;
        this.mdef = mdef;
        this.mapId = mapId;
        this.exp = exp;
        this.gold = gold != null ? gold : "";
        this.alive = alive;
        this.respawnIn = respawnIn;
        this.drop = drop != null ? drop : "";
        this.picture = picture != null ? picture : "";
    }

    int Tpl { get { return tpl; } }
    string Name { get { return name; } }
    int Level { get { return level; } }
    long Hp { get { return hp; } }
    int Mp { get { return mp; } }
    int AtkMin { get { return atkMin; } }
    int AtkMax { get { return atkMax; } }
    int Def { get { return def; } }
    int Mdef { get { return mdef; } }
    int MapId { get { return mapId; } }
    int Exp { get { return exp; } }
    string Gold { get { return gold; } }
    bool Alive { get { return alive; } }
    long RespawnIn { get { return respawnIn; } }
    string Drop { get { return drop; } }
    string Picture { get { return picture; } }
}

// BOSS 之家列表状态强类型实体。
