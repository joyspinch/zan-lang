using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 爆率表：一只怪物的掉落清单（一条 = 一件可能掉落的物品）。原版
   （传奇2 TBL_MONITEM / 迷你传奇掉落串）每怪挂多条，各自独立掷骰——
   杀死怪物时逐条 roll 万分比概率，命中即入包；金币不在此表，走
   game_mob 的 [goldMin, goldMax] 区间。种子来自 M2.DB 快照掉落串
   "快照id|数量|?|权重/..." 的全部条目（权重×10 = 万分比，封顶 5000）。 */
[Table(Name = "game_drop")]
class Drop {
    [Column(IsIdentity = true)]
    int id;

    /* 所属刷怪点（game_mob.id）。 */
    int mobId;

    /* 掉落物品（game_item.id）。 */
    int itemId;

    /* 万分比概率：每次击杀独立 roll（1000 = 10%）。 */
    int rate;

    /* 展示顺序（按快照掉落串的先后）。 */
    int sort;
}
