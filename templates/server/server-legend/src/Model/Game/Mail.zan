using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 邮箱：系统/运营发给角色的信。items 是附件清单（"itemId:count" 逗号
   分隔，最多 8 格）；claimed=1 表示附件已提取。删除是物理删行，
   「清空已领邮件」批量删 claimed=1 的行。 */
[Table(Name = "game_mail")]
class Mail {
    [Column(IsIdentity = true)]
    int id;

    int playerId;

    [Column(StringLength = 64, IsNullable = false)]
    string title;

    [Column(StringLength = 32)]
    string sender;

    [Column(StringLength = 512)]
    string body;

    [Column(StringLength = 256)]
    string items;

    int claimed;

    long createdAt;
}
