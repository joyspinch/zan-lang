using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 称谓原版配置表（只读） */
[Table(Name = "gametitle")]
class TitleDef {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64)]
    string name;

    int lvl;
    long money;
    long rep;
    int met;

    long a1;
    long a2;
    long b1;
    long b2;
    long c1;
    long c2;
    long d1;
    long d2;
    long e1;
    long e2;
}
