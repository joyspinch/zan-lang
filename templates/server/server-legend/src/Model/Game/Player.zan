using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 角色表：属于一个区服（realmId），一个账号每区至多一个（应用层唯一，
   创建时检查）。凭据与封禁在 game_account——账号可登录不等于某区有
   角色，创建角色才进得了世界。username 是账号名的冗余拷贝，仅供后台
   列表展示，鉴权永远走账号表。在线角色的权威状态在内存会话
   （Game.Session）里，定期与登出时落库；离线角色以本表为准。
   status=1 正常；0=屏蔽（GM 手工下架单个角色，账号封禁在账号表）。 */
[Table(Name = "game_player")]
class Player {
    [Column(IsIdentity = true)]
    int id;

    /* 所属账号（game_account.id）。 */
    int accountId;

    [Column(StringLength = 64, IsNullable = false)]
    string username;

    /* 所属区服（game_realm.id）。 */
    int realmId;

    [Column(StringLength = 32, IsNullable = false)]
    string nickname;

    /* 0=战士 1=法师 2=道士。三职业成长曲线（血量/法力/主属性/防御）
       见 Game.ClassCurves——形状忠实移植传奇2 服务端源码
       RecalcLevelAbilitys，数值带按迷你传奇真怪表校准。 */
    int job;

    /* 0=男 1=女（创建角色选定；开局布衣按性别发放）。 */
    int gender;

    int level;

    /* 战斗态：当前血量/法力、累计经验（升级曲线 ExpNext=44*level²），
       已穿戴装备（game_item.id，0=空位；穿戴中的物品不在背包）。
       血量/法力上限由 ClassCurves 三职业曲线推出，升级与登录时回满
       上限约束。 */
    int hp;
    int mp;
    long exp;
    int weaponId;
    int armorId;
    /* 其余穿戴位（原版原值槽位，单手镯/单戒指；天书原版即无槽）：
       2头盔 3项链 4手镯 6戒指 8腰带 9靴子 10勋章 11宝石。
       game_item.id，0=空位；穿戴中的物品不在背包。 */
    int helmetId;
    int necklaceId;
    int braceletId;
    int ringId;
    int beltId;
    int bootsId;
    int medalId;
    int gemId;

    long gold;
    long gems;

    /* 累计击杀：主线任务进度（客户端 quests.csv 首个任务“首次击杀”
       按它展示）。 */
    int kills;

    /* 铁匠铺强化星级（0-9）：武器每星 +2 攻、防具每星 +2 防，见
       Fight.Atk/Def。 */
    int weaponStar;
    int armorStar;

    /* 称谓：玩家在已解锁列表里自选的展示名（空=不显示）。 */
    [Column(StringLength = 32)]
    string title;

    /* 传说塔已通关层数（0=未爬）。 */
    int towerFloor;

    /* 祭坛增益到期时刻（秒）；早于当前时刻即失效。 */
    long buffUntil;

    /* 五行修炼总层数（每层 +1 攻 +5 血，Fight 结算）。 */
    int wuxing;

    /* 所属行会（game_guild.id，0=无会）。 */
    int guildId;

    /* 押镖：0=无任务；1=押送中（escortUntil 前结算，完成领金币）。
       escortReward 预估奖励（出发时按等级算好）。 */
    int escortStage;
    long escortUntil;
    long escortReward;

    /* 师父角色名（空=未拜师）。 */
    [Column(StringLength = 32)]
    string masterName;

    /* 竞技场积分（PK竞技场页展示与对手强度公式）。 */
    int arenaPts;
    /* 竞技场累计胜场。 */
    int arenaWins;
    /* 竞技场每日次数（跨天回满，日期字符串同 bossTryDate 定式）。 */
    int arenaTries;
    [Column(StringLength = 10)]
    string arenaTryDate;

    /* 押镖每日次数（跨天回满）。 */
    int escortTries;
    [Column(StringLength = 10)]
    string escortTryDate;

    /* 称谓解锁列表（逗号分隔的称谓名；称谓页消耗战功解锁+佩戴）。 */
    [Column(StringLength = 255)]
    string titlesUnlocked;

    /* 传说塔每日尝试次数（跨天回满）。 */
    int towerTries;
    [Column(StringLength = 10)]
    string towerTryDate;

    /* 祭坛增益到期时刻（秒）：有效期内打怪经验/金币 ×1.1（Fight.OnKill）。 */
    long altarBuffUntil;

    /* 将星图谱：已击败 BOSS 的地图位图（bit = mapId-1，BossFight 胜利点亮）。 */
    int stars;

    /* 五行修炼明细：金木水火土各行等级与当前经验（逗号分隔五元组）；
       wuxingPool 是修炼经验池（打怪按秒累计，注入转行经验，突破耗金币/元宝）。
       总层数=五行之和，随升级同步写回上行 wuxing。 */
    [Column(StringLength = 64)]
    string wuxingRanks;
    [Column(StringLength = 128)]
    string wuxingXp;
    long wuxingPool;

    /* 祭坛个人进度 / 今日捐献（跨天清零，altarDonationDate 同 bossTryDate）；
       服务器权威，捐献走金币现结。 */
    long altarPersonal;
    int altarDonations;
    [Column(StringLength = 10)]
    string altarDonationDate;

    /* 当前所在地图（game_map.id）与坐标；移动合法性由网关校验。 */
    int mapId;
    int x;
    int y;

    /* 地图解锁进度（照原版 BOSS 链）：已解锁的最大 game_map.id，
       在地图内页挑战 BOSS 胜利解锁 N+1；建角=1。0 按旧角色视为 1。 */
    int mapUnlocked;

    /* 地图内页 BOSS 挑战（照原版「挑战BOSS(剩N)次」）：每天 20 次，
       bossTryDate 记上次重置日（yyyy-MM-dd，跨天自动回满）；
       bossHpLeft/bossHpMap 记挑战失败的 BOSS 余血（下挑战接着打，
       换图重置满血）。 */
    int bossTries;
    [Column(StringLength = 10)]
    string bossTryDate;
    int bossHpLeft;
    int bossHpMap;

    /* 1=正常；0=屏蔽。 */
    int status;

    /* 角色级登录痕迹：离线结算按本角色的 lastLogoutAt 起算。 */
    long lastLoginAt;
    long lastLogoutAt;

    long createdAt;
    long updatedAt;
}
