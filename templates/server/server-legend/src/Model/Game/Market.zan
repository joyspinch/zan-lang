using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 交易市场寄售行：卖家把背包物品挂上来（count 件、总价 price 金币），
   买家一口价买走，物品与金币现结（卖家离线也成立：卖出所得记到他
   角色行上）。取消即删除行并退回物品。 */
[Table(Name = "game_market")]
class Market {
    [Column(IsIdentity = true)]
    int id;

    int sellerId;

    [Column(StringLength = 32, IsNullable = false)]
    string sellerName;

    int itemId;
    int count;

    /* 一口价（金币）。 */
    long price;

    long createdAt;
}
