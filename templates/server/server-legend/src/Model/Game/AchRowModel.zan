using System;
using System.Collections.Generic;

public class AchRowModel {
    string name;
    string req;
    bool ok;
    bool claimed;
    List<AchRewardCellModel> rewards;

    AchRowModel(string name, string req, bool ok, bool claimed, List<AchRewardCellModel> rewards) {
        this.name = name != null ? name : "";
        this.req = req != null ? req : "";
        this.ok = ok;
        this.claimed = claimed;
        this.rewards = rewards != null ? rewards : new List<AchRewardCellModel>();
    }

    string Name { get { return name; } }
    string Req { get { return req; } }
    bool Ok { get { return ok; } }
    bool Claimed { get { return claimed; } }
    List<AchRewardCellModel> Rewards { get { return rewards; } }
}

// 成就列表全量状态强类型实体。
