using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 怪物模板 = 一个刷怪点：每行在同一地图刷 count 只同名怪，杀死后
   respawnSec 秒重生。实例态（当前血量、存活、重生时刻）在世界内存
   （Game.Fight），不落库——重启即满血重刷。掉落清单在 game_drop
   （一怪多条、各掷万分比，爆率管理页维护）。status=1 启用。 */
[Table(Name = "game_mob")]
class Mob {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 32, IsNullable = false)]
    string name;

    /* 所在地图（game_map.id）：玩家必须先 move 过去才能打。 */
    int mapId;

    int level;

    int hp;
    /* 原版怪表只有上限列（za2 攻/zd2 防/ze2 魔防），atkMin 存 za1
       供地图内页 BOSS 面板「攻击 a-b」展示；mp 存 zmp。 */
    int atk;
    int atkMin;
    int def;
    int mdef;
    int mp;

    /* 击杀奖励：固定经验；金币在 [goldMin, goldMax] 内随机。 */
    int exp;
    long goldMin;
    long goldMax;

    /* 重生等待（秒）与同点数量。 */
    int respawnSec;
    int count;

    /* 美术键：客户端 art.csv 查图。 */
    [Column(StringLength = 64)]
    string picture;

    int status;
}
