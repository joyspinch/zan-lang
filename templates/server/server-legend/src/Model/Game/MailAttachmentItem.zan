using System;
using System.Collections.Generic;

public class MailAttachmentItem {
    int itemId;
    int count;

    MailAttachmentItem(int itemId, int count) {
        this.itemId = itemId;
        this.count = count;
    }

    int ItemId { get { return itemId; } }
    int Count { get { return count; } }

    static List<MailAttachmentItem> ParseCsv(string csv) {
        List<MailAttachmentItem> list = new List<MailAttachmentItem>();
        if (csv == null || csv.Length == 0) { return list; }
        List<string> parts = csv.Split(",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string p = parts[i].Trim();
            if (p.Length == 0) { continue; }
            List<string> kv = p.Split(":");
            if (kv.Count != 2) { continue; }
            int id = Convert.ToInt(kv[0].Trim());
            int cnt = Convert.ToInt(kv[1].Trim());
            if (id > 0 && cnt > 0) {
                list.Add(new MailAttachmentItem(id, cnt));
            }
        }
        return list;
    }
}

// 图鉴已放槽位强类型实体（替代 "组:格:itemId" 字符串动态切分）。
