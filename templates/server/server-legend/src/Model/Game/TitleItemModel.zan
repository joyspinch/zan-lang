using System;
using System.Collections.Generic;

public class TitleItemModel {
    int id;
    string name;
    int fame;
    long gold;
    int rebirth;
    int level;
    int atkMin;
    int atkMax;
    int magMin;
    int magMax;
    int taoMin;
    int taoMax;
    int defMin;
    int defMax;
    int mdefMin;
    int mdefMax;
    bool owned;
    bool worn;

    TitleItemModel(int id, string name, int fame, long gold, int rebirth, int level,
                   int a1, int a2, int b1, int b2, int c1, int c2, int d1, int d2, int e1, int e2,
                   bool owned, bool worn) {
        this.id = id;
        this.name = name != null ? name : "";
        this.fame = fame;
        this.gold = gold;
        this.rebirth = rebirth;
        this.level = level;
        this.atkMin = a1;
        this.atkMax = a2;
        this.magMin = b1;
        this.magMax = b2;
        this.taoMin = c1;
        this.taoMax = c2;
        this.defMin = d1;
        this.defMax = d2;
        this.mdefMin = e1;
        this.mdefMax = e2;
        this.owned = owned;
        this.worn = worn;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    int Fame { get { return fame; } }
    long Gold { get { return gold; } }
    int Rebirth { get { return rebirth; } }
    int Level { get { return level; } }
    int AtkMin { get { return atkMin; } }
    int AtkMax { get { return atkMax; } }
    int MagMin { get { return magMin; } }
    int MagMax { get { return magMax; } }
    int TaoMin { get { return taoMin; } }
    int TaoMax { get { return taoMax; } }
    int DefMin { get { return defMin; } }
    int DefMax { get { return defMax; } }
    int MdefMin { get { return mdefMin; } }
    int MdefMax { get { return mdefMax; } }
    bool Owned { get { return owned; } }
    bool Worn { get { return worn; } }
}

// 称谓分页状态强类型实体。
