using System;
using System.Collections.Generic;

public class WuxingStateModel {
    long pool;
    long poolCap;
    List<WuxingRowModel> rows;

    WuxingStateModel(long pool, long poolCap, List<WuxingRowModel> rows) {
        this.pool = pool;
        this.poolCap = poolCap;
        this.rows = rows != null ? rows : new List<WuxingRowModel>();
    }

    long Pool { get { return pool; } }
    long PoolCap { get { return poolCap; } }
    List<WuxingRowModel> Rows { get { return rows; } }

    JsonValue ToJson() {
        JsonValue o = JsonValue.NewObject();
        o.Set("pool", JsonValue.NewNum(Convert.ToString(pool)));
        o.Set("poolCap", JsonValue.NewNum(Convert.ToString(poolCap)));
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            WuxingRowModel r = rows[i];
            JsonValue e = JsonValue.NewObject();
            e.Set("id", JsonValue.NewNum(Convert.ToString(r.Id)));
            e.Set("name", JsonValue.NewStr(r.Name));
            e.Set("rank", JsonValue.NewNum(Convert.ToString(r.Rank)));
            e.Set("xp", JsonValue.NewNum(Convert.ToString(r.Xp)));
            e.Set("need", JsonValue.NewNum(Convert.ToString(r.Need)));
            e.Set("cap", JsonValue.NewNum(Convert.ToString(r.Cap)));
            e.Set("itemId", JsonValue.NewNum(Convert.ToString(r.ItemId)));
            arr.Append(e);
        }
        o.Set("rows", arr);
        return o;
    }
}

// 将星图谱单行条目强类型实体（服务端权威事实：name/level/map/lit）。
