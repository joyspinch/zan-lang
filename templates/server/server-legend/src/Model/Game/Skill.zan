using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 技能模板：三职业各 8 个（4 主动 + 4 被动），种子来自 M2.DB 快照的
   skills 表（迷你传奇原值：伤害/治疗系数、冷却、耗蓝、升级花费）。
   主动技能战斗结算（damage_pct + damage_per_level·技能等级，耗 mana）；
   被动技能按 passive_damage_pct/passive_defense_pct 摊进 Fight 属性。
   玩家已学技能等级在 game_player_skill（升级花费 train_gold/train_iron）。
   job 0=战 1=法 2=道；kind active/passive；school 展示用流派名。 */
[Table(Name = "game_skill")]
class Skill {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 32, IsNullable = false)]
    string name;

    /* 0=战士 1=法师 2=道士。 */
    int job;

    /* 职业内技能栏位 0-7。 */
    int slot;

    /* active=主动 enemy；passive=被动 self。 */
    [Column(StringLength = 16)]
    string kind;

    [Column(StringLength = 16)]
    string target;

    /* 主动：冷却秒与耗蓝。 */
    int cooldown;
    int mana;

    /* 主动：100 级基准伤害% 与每技能等级加成%。 */
    int damagePct;
    int damagePerLevel;

    /* 道士技能的附带治疗（回复% 与每级加成）。 */
    int healPct;
    int healPerLevel;

    /* 被动：每级伤害/防御加成（Fight 结算）。 */
    int passiveDamagePct;
    int passiveDefensePct;

    /* 技能可练等级上限（原版 20）与升级花费。 */
    int maxLevel;
    long trainGold;
    int trainIron;

    /* 展示流派：attack/magic/tao/defense。 */
    [Column(StringLength = 16)]
    string school;

    /* 美术键：客户端查图。 */
    [Column(StringLength = 64)]
    string picture;

    int status;
}
