using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 跨重启世界态 KV（RULES.md §五）：城池/沙巴克归属、红包池、世界 BOSS
   血量与重生时刻。内存是热缓存，世界 tick 定期写穿本表（与会话
   dirty-flush 同节奏）；重启丢失窗口 = flushSeconds，与玩家存档一致。
   realm_id + k 定位一行；v 是字符串，数值键由调用方自行转换。 */
[Table(Name = "game_world")]
class WorldStateRow {
    [Column(IsIdentity = true)]
    int id;

    int realmId;

    [Column(StringLength = 64)]
    string k;

    [Column(StringLength = 256)]
    string v;

    long updatedAt;
}
