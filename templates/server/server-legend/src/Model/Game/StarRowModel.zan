using System;
using System.Collections.Generic;

public class StarRowModel {
    string name;
    int level;
    int map;
    bool lit;

    StarRowModel(string name, int level, int map, bool lit) {
        this.name = name != null ? name : "";
        this.level = level;
        this.map = map;
        this.lit = lit;
    }

    string Name { get { return name; } }
    int Level { get { return level; } }
    int Map { get { return map; } }
    bool Lit { get { return lit; } }
}

// 将星图谱全量状态强类型实体。
