using System;
using System.Collections.Generic;

public class StarStateModel {
    List<StarRowModel> rows;

    StarStateModel(List<StarRowModel> rows) {
        this.rows = rows != null ? rows : new List<StarRowModel>();
    }

    List<StarRowModel> Rows { get { return rows; } }

    JsonValue ToJson() {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            StarRowModel r = rows[i];
            JsonValue o = JsonValue.NewObject();
            o.Set("name", JsonValue.NewStr(r.Name));
            o.Set("level", JsonValue.NewNum(Convert.ToString(r.Level)));
            o.Set("map", JsonValue.NewNum(Convert.ToString(r.Map)));
            o.Set("lit", JsonValue.NewNum(r.Lit ? "1" : "0"));
            arr.Append(o);
        }
        return arr;
    }
}

// 称谓单项强类型实体（服务端权威事实：id/name/fame/gold/rebirth/level/攻魔道防/owned/worn）。
