using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 地图表。种子由 M2.DB 快照 gamemap 整表写入（迷你传奇原值 35 张）；
   status=1 开放。GM 可在后台加图，客户端登录时拉取全表。
   进入门槛照原版是 BOSS 链：击败本图 boss 怪才解锁下一图
   （Player.mapUnlocked 记进度），minLevel 只作展示参考不再拦人。 */
[Table(Name = "game_map")]
class GameMap {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    int minLevel;
    int sortOrder;

    /* 本图 BOSS 怪名（快照 gamemap.boss → gamemonster 名）。
       Fight.LoadCatalog 按「图 id + 怪名」圈出 BOSS 怪行；空=无主。 */
    [Column(StringLength = 32)]
    string boss;

    /* 美术键：地图缩略图。 */
    [Column(StringLength = 64)]
    string picture;

    int status;
}
