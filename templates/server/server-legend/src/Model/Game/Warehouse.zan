using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 仓库行：玩家寄存某物品的数量（同物品合并一行）。低频操作直写
   事实层（不进会话热缓存，与背包的会话权威+整包回写不同轨）：
   入库先扣会话背包（BagTake）再 upsert 本表；出库走条件更新
   （count 原值比对）防同一行被并发取两份。加锁（防回收/卖出）
   是背包侧行为，不在本表。 */
[Table(Name = "game_warehouse")]
class Warehouse {
    [Column(IsIdentity = true)]
    int id;

    /* 所属角色（game_player.id）。 */
    int playerId;

    /* 物品（game_item.id）。 */
    int itemId;

    int count;
}
