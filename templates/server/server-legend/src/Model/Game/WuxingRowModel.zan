using System;
using System.Collections.Generic;

public class WuxingRowModel {
    int id;
    string name;
    int rank;
    long xp;
    long need;
    int cap;
    int itemId;

    WuxingRowModel(int id, string name, int rank, long xp, long need, int cap, int itemId) {
        this.id = id;
        this.name = name != null ? name : "";
        this.rank = rank;
        this.xp = xp;
        this.need = need;
        this.cap = cap;
        this.itemId = itemId;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    int Rank { get { return rank; } }
    long Xp { get { return xp; } }
    long Need { get { return need; } }
    int Cap { get { return cap; } }
    int ItemId { get { return itemId; } }
}

// 五行修炼全量状态强类型实体。
