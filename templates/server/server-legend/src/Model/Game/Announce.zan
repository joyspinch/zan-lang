using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 公告表。GM 在后台发布；玩家登录即收到最新启用公告，已在线会话由
   GM 点「推送」即时收到（Game.World.PushAnnounce）。 */
[Table(Name = "game_announce")]
class Announce {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 128, IsNullable = false)]
    string title;

    [Column(StringLength = 512, IsNullable = false)]
    string body;

    /* 1=启用（登录时下发）；0=下线。 */
    int enabled;

    [Column(StringLength = 64, IsNullable = false)]
    string author;

    long createdAt;
}
