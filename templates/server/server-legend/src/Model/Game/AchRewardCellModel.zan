using System;
using System.Collections.Generic;

public class AchRewardCellModel {
    int picture;
    string badge;

    AchRewardCellModel(int picture, string badge) {
        this.picture = picture;
        this.badge = badge != null ? badge : "";
    }

    int Picture { get { return picture; } }
    string Badge { get { return badge; } }
}

// 成就单行条目强类型实体（服务端权威事实：name/req/ok/claimed/rewards）。
