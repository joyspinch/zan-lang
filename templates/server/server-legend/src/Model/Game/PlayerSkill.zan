using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 玩家已学技能：一行 = 玩家 x 技能 x 当前等级（1..Skill.maxLevel）。
   学习/升级在「技能」页（GM 或玩家侧协议 op:skill）扣 train_gold/
   train_iron；主动技能的战斗结算与被动加成见 Fight.Cast/SkillBonus。 */
[Table(Name = "game_player_skill")]
class PlayerSkill {
    [Column(IsIdentity = true)]
    int id;

    /* 角色（game_player.id）。 */
    int playerId;

    /* 技能（game_skill.id）。 */
    int skillId;

    /* 当前技能等级（1 起）。 */
    int level;

    long createdAt;
    long updatedAt;
}
