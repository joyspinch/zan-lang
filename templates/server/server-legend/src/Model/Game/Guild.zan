using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 行会表：名字全局唯一（应用层建会时检查），leader 是会长角色名的
   冗余拷贝（会长离线时列表也要能显示）。成员在 game_player.guildId
   上反向引用； fund 是会库金币（行会玩法扩展用）。 */
[Table(Name = "game_guild")]
class Guild {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 32, IsNullable = false)]
    string name;

    [Column(StringLength = 32, IsNullable = false)]
    string leader;

    long fund;

    long createdAt;
}
