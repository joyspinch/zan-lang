using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 背包行：玩家持有某物品的数量（同物品合并为一行）。在线时权威状态
   在会话内存（Game.Session 的 bag 列表），随 flush 周期与登出整包回写；
   离线发放（GM 送物品）直写本表，进区时装载进会话。 */
[Table(Name = "game_bag")]
class Bag {
    [Column(IsIdentity = true)]
    int id;

    /* 所属角色（game_player.id）。 */
    int playerId;

    /* 物品（game_item.id）。 */
    int itemId;

    int count;
}
