using System.Data.Orm;

namespace ZanWeb.Model.Game;

/* 游戏账号表：只管凭据，与角色分离——账号全局唯一，角色（game_player）
   属于某个区服，一个账号每区至多一个角色。密码与密保同一套加盐迭代
   散列（AuthUser.PasswordHash）；密保答案入库存归一化（trim+小写）后
   的散列，找回密码按同规则比对。question 为空串表示未设置密保。
   status=0 封禁：登录被拒并展示 banReason，在线会话被 GM 踢出。 */
[Table(Name = "game_account")]
class Account {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string username;

    /* 加盐迭代 SHA-256（见 AuthUser.PasswordHash）。不返回、不记录。 */
    [Column(StringLength = 128, IsNullable = false)]
    string passwordHash;

    [Column(StringLength = 64, IsNullable = false)]
    string passwordSalt;

    [Column(StringLength = 64, IsNullable = false)]
    string question;

    [Column(StringLength = 128, IsNullable = false)]
    string answerHash;

    [Column(StringLength = 64, IsNullable = false)]
    string answerSalt;

    /* 密保答错限频：1 小时窗口内错满 AnswerLimit 次锁定到窗口结束。 */
    int answerFails;
    long answerFailAt;

    /* 登录密码错限频（A303 建议 ④）：1 小时窗口内错满 LoginLimit 次
       锁定到窗口结束，登录成功即清零。IP 限流防得住单源扫描，防不住
       分布式撞库——账号级计数兜住后一种。旧行缺列由 SyncStructureAll
       自动 ALTER 补齐（读作 0 = 未锁定）。 */
    int loginFails;
    long loginFailAt;

    /* 1=正常；0=封禁（banReason 说明原因，登录时展示给玩家）。 */
    int status;

    [Column(StringLength = 128, IsNullable = false)]
    string banReason;

    /* 邮箱（创建账号时备档，可空串；找回密码走密保，不依赖邮箱）。 */
    [Column(StringLength = 128, IsNullable = false)]
    string email;

    long lastLoginAt;
    long createdAt;
}
