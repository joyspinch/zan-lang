using System;
using System.Collections.Generic;

public class SupremeStateModel {
    int bonus;
    List<SupremeSlotModel> rows;

    SupremeStateModel(int bonus, List<SupremeSlotModel> rows) {
        this.bonus = bonus;
        this.rows = rows != null ? rows : new List<SupremeSlotModel>();
    }

    int Bonus { get { return bonus; } }
    List<SupremeSlotModel> Rows { get { return rows; } }

    void IntoJson(JsonValue r) {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            SupremeSlotModel m = rows[i];
            JsonValue o = JsonValue.NewObject();
            o.Set("title", JsonValue.NewStr(m.Title));
            o.Set("sub", JsonValue.NewStr(m.Sub));
            o.Set("owner", JsonValue.NewStr(m.Owner));
            o.Set("itemId", JsonValue.NewNum(Convert.ToString(m.ItemId)));
            o.Set("itemName", JsonValue.NewStr(m.ItemName));
            o.Set("value", JsonValue.NewNum(Convert.ToString(m.Value)));
            o.Set("copyable", JsonValue.NewNum(m.Copyable ? "1" : "0"));
            o.Set("fee", JsonValue.NewNum(Convert.ToString(m.Fee)));
            arr.Append(o);
        }
        r.Set("rows", arr);
        r.Set("bonus", JsonValue.NewNum(Convert.ToString(bonus)));
    }
}

// BOSS 之家条目强类型实体（服务端权威事实：tpl/name/level/hp/mp/atkMin/atkMax/def/mdef/map/exp/gold/alive/respawnIn/drop/picture）。
