using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* AnnounceDao 强类型数据访问网关（继承 FreeSql BaseRepository 范式） */
class AnnounceDao : BaseRepository<Announce> {
    AnnounceDao(IFreeSql fsql) : base(fsql) {}
    AnnounceDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async Announce ById(int id) {
        return await this.GetExecutor().Select<Announce>().Where(a => a.id == id).FirstAsync();
    }

    async List<Announce> All() {
        return await this.GetExecutor().Select<Announce>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<Announce>().CountAsync();
    }

    async int Insert(Announce entity) {
        return await this.GetExecutor().Insert<Announce>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<Announce>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
