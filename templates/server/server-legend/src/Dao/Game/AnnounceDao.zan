using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_announce 的数据读写网关 */
class AnnounceDao {
    IDbConnection db;

    AnnounceDao(IDbConnection db) {
        this.db = db;
    }

    async Announce ById(int id) {
        return await this.db.Select<Announce>().Where(a => a.id == id).FirstAsync();
    }

    async List<Announce> All() {
        return await this.db.Select<Announce>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Announce>().CountAsync();
    }

    async int Insert(Announce entity) {
        return await this.db.Insert<Announce>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<Announce>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
