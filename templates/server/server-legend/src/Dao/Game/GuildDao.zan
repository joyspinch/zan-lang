using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* GuildDao 强类型数据访问网关（继承 FreeSql BaseRepository 范式） */
class GuildDao : BaseRepository<Guild> {
    GuildDao(IFreeSql fsql) : base(fsql) {}
    GuildDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async Guild ById(int id) {
        return await this.GetExecutor().Select<Guild>().Where(a => a.id == id).FirstAsync();
    }

    async List<Guild> All() {
        return await this.GetExecutor().Select<Guild>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<Guild>().CountAsync();
    }

    async int Insert(Guild entity) {
        return await this.GetExecutor().Insert<Guild>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<Guild>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
