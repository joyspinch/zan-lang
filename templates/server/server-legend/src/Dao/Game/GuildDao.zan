using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_guild 的数据读写网关 */
class GuildDao {
    IDbConnection db;

    GuildDao(IDbConnection db) {
        this.db = db;
    }

    async Guild ById(int id) {
        return await this.db.Select<Guild>().Where(a => a.id == id).FirstAsync();
    }

    async List<Guild> All() {
        return await this.db.Select<Guild>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Guild>().CountAsync();
    }

    async int Insert(Guild entity) {
        return await this.db.Insert<Guild>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<Guild>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
