using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_realm 的数据读写网关 */
class RealmDao {
    IDbConnection db;

    RealmDao(IDbConnection db) {
        this.db = db;
    }

    async Realm ById(int id) {
        return await this.db.Select<Realm>().Where(a => a.id == id).FirstAsync();
    }

    async List<Realm> All() {
        return await this.db.Select<Realm>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Realm>().CountAsync();
    }

    async int Insert(Realm entity) {
        return await this.db.Insert<Realm>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<Realm>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
