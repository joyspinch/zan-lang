using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* RealmDao 强类型数据访问网关（继承 FreeSql BaseRepository 范式） */
class RealmDao : BaseRepository<Realm> {
    RealmDao(IFreeSql fsql) : base(fsql) {}
    RealmDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async Realm ById(int id) {
        return await this.GetExecutor().Select<Realm>().Where(a => a.id == id).FirstAsync();
    }

    async List<Realm> All() {
        return await this.GetExecutor().Select<Realm>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<Realm>().CountAsync();
    }

    async int Insert(Realm entity) {
        return await this.GetExecutor().Insert<Realm>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<Realm>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
