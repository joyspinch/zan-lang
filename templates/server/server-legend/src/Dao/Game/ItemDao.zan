using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_item 的数据读写网关 */
class ItemDao {
    IDbConnection db;

    ItemDao(IDbConnection db) {
        this.db = db;
    }

    async Item ById(int id) {
        return await this.db.Select<Item>().Where(a => a.id == id).FirstAsync();
    }

    async List<Item> All() {
        return await this.db.Select<Item>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Item>().CountAsync();
    }

    async int Insert(Item entity) {
        return await this.db.Insert<Item>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<Item>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
