using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* ItemDao 强类型数据访问网关（继承 FreeSql BaseRepository 范式） */
class ItemDao : BaseRepository<Item> {
    ItemDao(IFreeSql fsql) : base(fsql) {}
    ItemDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async Item ById(int id) {
        return await this.GetExecutor().Select<Item>().Where(a => a.id == id).FirstAsync();
    }

    async List<Item> All() {
        return await this.GetExecutor().Select<Item>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<Item>().CountAsync();
    }

    async int Insert(Item entity) {
        return await this.GetExecutor().Insert<Item>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<Item>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
