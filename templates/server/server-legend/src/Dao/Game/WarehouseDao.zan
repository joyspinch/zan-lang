using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* WarehouseDao 强类型数据访问网关（继承 FreeSql BaseRepository 范式） */
class WarehouseDao : BaseRepository<Warehouse> {
    WarehouseDao(IFreeSql fsql) : base(fsql) {}
    WarehouseDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async Warehouse ById(int id) {
        return await this.GetExecutor().Select<Warehouse>().Where(a => a.id == id).FirstAsync();
    }

    async List<Warehouse> All() {
        return await this.GetExecutor().Select<Warehouse>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<Warehouse>().CountAsync();
    }

    async int Insert(Warehouse entity) {
        return await this.GetExecutor().Insert<Warehouse>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<Warehouse>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
