using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_warehouse 的数据读写网关 */
class WarehouseDao {
    IDbConnection db;

    WarehouseDao(IDbConnection db) {
        this.db = db;
    }

    async Warehouse ById(int id) {
        return await this.db.Select<Warehouse>().Where(a => a.id == id).FirstAsync();
    }

    async List<Warehouse> All() {
        return await this.db.Select<Warehouse>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Warehouse>().CountAsync();
    }

    async int Insert(Warehouse entity) {
        return await this.db.Insert<Warehouse>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<Warehouse>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
