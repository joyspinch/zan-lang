using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* PlayerSkillDao 强类型数据访问网关（继承 ZanSql BaseRepository 范式） */
public class PlayerSkillDao : BaseRepository<PlayerSkill> {
    PlayerSkillDao(IZanSql fsql) : base(fsql) {}
    PlayerSkillDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async PlayerSkill ById(int id) {
        return await this.GetExecutor().Select<PlayerSkill>().Where(a => a.id == id).FirstAsync();
    }

    async List<PlayerSkill> All() {
        return await this.GetExecutor().Select<PlayerSkill>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<PlayerSkill>().CountAsync();
    }

    async int Insert(PlayerSkill entity) {
        return await this.GetExecutor().Insert<PlayerSkill>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<PlayerSkill>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
