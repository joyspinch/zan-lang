using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_player_skill 的数据读写网关 */
class PlayerSkillDao {
    IDbConnection db;

    PlayerSkillDao(IDbConnection db) {
        this.db = db;
    }

    async PlayerSkill ById(int id) {
        return await this.db.Select<PlayerSkill>().Where(a => a.id == id).FirstAsync();
    }

    async List<PlayerSkill> All() {
        return await this.db.Select<PlayerSkill>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<PlayerSkill>().CountAsync();
    }

    async int Insert(PlayerSkill entity) {
        return await this.db.Insert<PlayerSkill>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<PlayerSkill>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
