using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_world_state 的数据读写网关 */
class WorldStateRowDao : BaseRepository<WorldStateRow> {
    WorldStateRowDao(IFreeSql fsql) : base(fsql) {}
    WorldStateRowDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async WorldStateRow ById(int id) {
        return await this.GetExecutor().Select<WorldStateRow>().Where(a => a.id == id).FirstAsync();
    }

    async List<WorldStateRow> ByRealmId(int realmId) {
        return await this.GetExecutor().Select<WorldStateRow>()
            .Where(a => a.realmId == realmId)
            .ToListAsync();
    }

    async int Upsert(int realmId, string k, string v, long updatedAt) {
        WorldStateRow row = await this.GetExecutor().Select<WorldStateRow>()
            .Where(a => a.realmId == realmId && a.k == k)
            .FirstAsync();
        if (row == null) {
            WorldStateRow item = new WorldStateRow();
            item.realmId = realmId;
            item.k = k;
            item.v = v;
            item.updatedAt = updatedAt;
            return await this.InsertIdentity(item);
        }
        return await this.GetExecutor().Update<WorldStateRow>()
            .Set(a => a.v, v)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == row.id)
            .ExecuteAffrowsAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<WorldStateRow>().CountAsync();
    }

    async int Insert(WorldStateRow entity) {
        return await this.GetExecutor().Insert<WorldStateRow>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<WorldStateRow>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
