using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* MarketDao 强类型数据访问网关（继承 FreeSql BaseRepository 范式） */
class MarketDao : BaseRepository<Market> {
    MarketDao(IFreeSql fsql) : base(fsql) {}
    MarketDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async Market ById(int id) {
        return await this.GetExecutor().Select<Market>().Where(a => a.id == id).FirstAsync();
    }

    async List<Market> All() {
        return await this.GetExecutor().Select<Market>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<Market>().CountAsync();
    }

    async int Insert(Market entity) {
        return await this.GetExecutor().Insert<Market>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<Market>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
