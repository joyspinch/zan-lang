using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_market 的数据读写网关 */
class MarketDao {
    IDbConnection db;

    MarketDao(IDbConnection db) {
        this.db = db;
    }

    async Market ById(int id) {
        return await this.db.Select<Market>().Where(a => a.id == id).FirstAsync();
    }

    async List<Market> All() {
        return await this.db.Select<Market>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Market>().CountAsync();
    }

    async int Insert(Market entity) {
        return await this.db.Insert<Market>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<Market>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
