using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* BagDao 强类型数据访问网关（继承 FreeSql BaseRepository 范式） */
class BagDao : BaseRepository<Bag> {
    BagDao(IFreeSql fsql) : base(fsql) {}
    BagDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async Bag ById(int id) {
        return await this.GetExecutor().Select<Bag>().Where(a => a.id == id).FirstAsync();
    }

    async List<Bag> All() {
        return await this.GetExecutor().Select<Bag>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<Bag>().CountAsync();
    }

    async int Insert(Bag entity) {
        return await this.GetExecutor().Insert<Bag>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<Bag>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
