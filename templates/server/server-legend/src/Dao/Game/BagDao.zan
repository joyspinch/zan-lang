using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_bag 的数据读写网关 */
class BagDao {
    IDbConnection db;

    BagDao(IDbConnection db) {
        this.db = db;
    }

    async Bag ById(int id) {
        return await this.db.Select<Bag>().Where(a => a.id == id).FirstAsync();
    }

    async List<Bag> All() {
        return await this.db.Select<Bag>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Bag>().CountAsync();
    }

    async int Insert(Bag entity) {
        return await this.db.Insert<Bag>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<Bag>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
