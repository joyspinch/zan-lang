using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_map 的数据读写网关 */
class GameMapDao {
    IDbConnection db;

    GameMapDao(IDbConnection db) {
        this.db = db;
    }

    async GameMap ById(int id) {
        return await this.db.Select<GameMap>().Where(a => a.id == id).FirstAsync();
    }

    async List<GameMap> All() {
        return await this.db.Select<GameMap>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<GameMap>().CountAsync();
    }

    async int Insert(GameMap entity) {
        return await this.db.Insert<GameMap>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<GameMap>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
