using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* GameMapDao 强类型数据访问网关（继承 FreeSql BaseRepository 范式） */
class GameMapDao : BaseRepository<GameMap> {
    GameMapDao(IFreeSql fsql) : base(fsql) {}
    GameMapDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async GameMap ById(int id) {
        return await this.GetExecutor().Select<GameMap>().Where(a => a.id == id).FirstAsync();
    }

    async List<GameMap> All() {
        return await this.GetExecutor().Select<GameMap>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<GameMap>().CountAsync();
    }

    async int Insert(GameMap entity) {
        return await this.GetExecutor().Insert<GameMap>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<GameMap>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
