using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* gametitle 只读原版称谓表数据访问网关 */
class TitleDefDao : BaseRepository<TitleDef> {
    TitleDefDao(IFreeSql fsql) : base(fsql) {}
    TitleDefDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async List<TitleDef> All() {
        return await this.GetExecutor().Select<TitleDef>()
            .OrderBy(a => a.id)
            .ToListAsync();
    }

    async TitleDef ById(int id) {
        return await this.GetExecutor().Select<TitleDef>().Where(a => a.id == id).FirstAsync();
    }
}
