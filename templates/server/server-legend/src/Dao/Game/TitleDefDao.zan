using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* gametitle 只读原版称谓表数据访问网关 */
class TitleDefDao {
    IDbConnection db;

    TitleDefDao(IDbConnection db) {
        this.db = db;
    }

    async List<TitleDef> All() {
        return await this.db.Select<TitleDef>()
            .OrderBy(a => a.id)
            .ToListAsync();
    }

    async TitleDef ById(int id) {
        return await this.db.Select<TitleDef>().Where(a => a.id == id).FirstAsync();
    }
}
