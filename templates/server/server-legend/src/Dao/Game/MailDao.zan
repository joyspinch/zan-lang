using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* MailDao 强类型数据访问网关（继承 FreeSql BaseRepository 范式） */
class MailDao : BaseRepository<Mail> {
    MailDao(IFreeSql fsql) : base(fsql) {}
    MailDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async Mail ById(int id) {
        return await this.GetExecutor().Select<Mail>().Where(a => a.id == id).FirstAsync();
    }

    async List<Mail> All() {
        return await this.GetExecutor().Select<Mail>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<Mail>().CountAsync();
    }

    async int Insert(Mail entity) {
        return await this.GetExecutor().Insert<Mail>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<Mail>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
