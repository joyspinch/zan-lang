using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_mail 的数据读写网关 */
class MailDao {
    IDbConnection db;

    MailDao(IDbConnection db) {
        this.db = db;
    }

    async Mail ById(int id) {
        return await this.db.Select<Mail>().Where(a => a.id == id).FirstAsync();
    }

    async List<Mail> All() {
        return await this.db.Select<Mail>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Mail>().CountAsync();
    }

    async int Insert(Mail entity) {
        return await this.db.Insert<Mail>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<Mail>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
