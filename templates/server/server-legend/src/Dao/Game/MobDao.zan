using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* MobDao 强类型数据访问网关（继承 FreeSql BaseRepository 范式） */
class MobDao : BaseRepository<Mob> {
    MobDao(IFreeSql fsql) : base(fsql) {}
    MobDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async Mob ById(int id) {
        return await this.GetExecutor().Select<Mob>().Where(a => a.id == id).FirstAsync();
    }

    async List<Mob> All() {
        return await this.GetExecutor().Select<Mob>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<Mob>().CountAsync();
    }

    async int Insert(Mob entity) {
        return await this.GetExecutor().Insert<Mob>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<Mob>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
