using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_mob 的数据读写网关 */
class MobDao {
    IDbConnection db;

    MobDao(IDbConnection db) {
        this.db = db;
    }

    async Mob ById(int id) {
        return await this.db.Select<Mob>().Where(a => a.id == id).FirstAsync();
    }

    async List<Mob> All() {
        return await this.db.Select<Mob>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Mob>().CountAsync();
    }

    async int Insert(Mob entity) {
        return await this.db.Insert<Mob>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<Mob>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
