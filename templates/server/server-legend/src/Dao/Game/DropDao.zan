using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_drop 的数据读写网关 */
class DropDao {
    IDbConnection db;

    DropDao(IDbConnection db) {
        this.db = db;
    }

    async Drop ById(int id) {
        return await this.db.Select<Drop>().Where(a => a.id == id).FirstAsync();
    }

    async List<Drop> All() {
        return await this.db.Select<Drop>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Drop>().CountAsync();
    }

    async int Insert(Drop entity) {
        return await this.db.Insert<Drop>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<Drop>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
