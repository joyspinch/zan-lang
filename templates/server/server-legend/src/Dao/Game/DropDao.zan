using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* DropDao 强类型数据访问网关（继承 FreeSql BaseRepository 范式） */
class DropDao : BaseRepository<Drop> {
    DropDao(IFreeSql fsql) : base(fsql) {}
    DropDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async Drop ById(int id) {
        return await this.GetExecutor().Select<Drop>().Where(a => a.id == id).FirstAsync();
    }

    async List<Drop> All() {
        return await this.GetExecutor().Select<Drop>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<Drop>().CountAsync();
    }

    async int Insert(Drop entity) {
        return await this.GetExecutor().Insert<Drop>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<Drop>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
