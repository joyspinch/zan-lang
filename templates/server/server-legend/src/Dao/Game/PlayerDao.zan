using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_player 的数据读写网关 */
class PlayerDao {
    IDbConnection db;

    PlayerDao(IDbConnection db) {
        this.db = db;
    }

    async Player ById(int id) {
        return await this.db.Select<Player>().Where(a => a.id == id).FirstAsync();
    }

    async List<Player> All() {
        return await this.db.Select<Player>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Player>().CountAsync();
    }

    async int Insert(Player entity) {
        return await this.db.Insert<Player>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<Player>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
