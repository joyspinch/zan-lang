using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* PlayerDao 强类型数据访问网关（继承 FreeSql BaseRepository 范式） */
class PlayerDao : BaseRepository<Player> {
    PlayerDao(IFreeSql fsql) : base(fsql) {}
    PlayerDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async Player ById(int id) {
        return await this.GetExecutor().Select<Player>().Where(a => a.id == id).FirstAsync();
    }

    async List<Player> All() {
        return await this.GetExecutor().Select<Player>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<Player>().CountAsync();
    }

    async int Insert(Player entity) {
        return await this.GetExecutor().Insert<Player>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<Player>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int UpdateRow(Player row) {
        long now = WebApp.NowSeconds();
        return await this.GetExecutor().Update<Player>()
            .Set(a => a.level, row.level)
            .Set(a => a.hp, row.hp)
            .Set(a => a.mp, row.mp)
            .Set(a => a.exp, row.exp)
            .Set(a => a.weaponId, row.weaponId)
            .Set(a => a.armorId, row.armorId)
            .Set(a => a.helmetId, row.helmetId)
            .Set(a => a.necklaceId, row.necklaceId)
            .Set(a => a.braceletId, row.braceletId)
            .Set(a => a.ringId, row.ringId)
            .Set(a => a.beltId, row.beltId)
            .Set(a => a.bootsId, row.bootsId)
            .Set(a => a.medalId, row.medalId)
            .Set(a => a.gemId, row.gemId)
            .Set(a => a.kills, row.kills)
            .Set(a => a.weaponStar, row.weaponStar)
            .Set(a => a.armorStar, row.armorStar)
            .Set(a => a.gold, row.gold)
            .Set(a => a.gems, row.gems)
            .Set(a => a.mapId, row.mapId)
            .Set(a => a.x, row.x)
            .Set(a => a.y, row.y)
            .Set(a => a.mapUnlocked, row.mapUnlocked)
            .Set(a => a.bossTries, row.bossTries)
            .Set(a => a.bossTryDate, row.bossTryDate)
            .Set(a => a.bossHpLeft, row.bossHpLeft)
            .Set(a => a.bossHpMap, row.bossHpMap)
            .Set(a => a.merit, row.merit)
            .Set(a => a.reputation, row.reputation)
            .Set(a => a.redPackets, row.redPackets)
            .Set(a => a.recyclePoints, row.recyclePoints)
            .Set(a => a.arenaWins, row.arenaWins)
            .Set(a => a.arenaTries, row.arenaTries)
            .Set(a => a.arenaTryDate, row.arenaTryDate)
            .Set(a => a.escortTries, row.escortTries)
            .Set(a => a.escortTryDate, row.escortTryDate)
            .Set(a => a.escortStage, row.escortStage)
            .Set(a => a.escortUntil, row.escortUntil)
            .Set(a => a.escortReward, row.escortReward)
            .Set(a => a.guildId, row.guildId)
            .Set(a => a.masterName, row.masterName)
            .Set(a => a.wuxing, row.wuxing)
            .Set(a => a.wuxingRanks, row.wuxingRanks)
            .Set(a => a.wuxingXp, row.wuxingXp)
            .Set(a => a.wuxingPool, row.wuxingPool)
            .Set(a => a.altarPersonal, row.altarPersonal)
            .Set(a => a.altarDonations, row.altarDonations)
            .Set(a => a.altarDonationDate, row.altarDonationDate)
            .Set(a => a.altarBuffUntil, row.altarBuffUntil)
            .Set(a => a.starsLit, row.starsLit)
            .Set(a => a.titlesUnlocked, row.titlesUnlocked)
            .Set(a => a.towerFloor, row.towerFloor)
            .Set(a => a.towerTries, row.towerTries)
            .Set(a => a.towerTryDate, row.towerTryDate)
            .Set(a => a.title, row.title)
            .Set(a => a.lordContrib, row.lordContrib)
            .Set(a => a.achClaimed, row.achClaimed)
            .Set(a => a.codexItems, row.codexItems)
            .Set(a => a.updatedAt, now)
            .Where(a => a.id == row.id)
            .ExecuteAffrowsAsync();
    }
}
