using System;
using System.Data;
using System.Data.Orm;
using System.Security.Cryptography;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_account 的读写入口：TCP 网关（register/login/forgot/reset）与 网页注册/找回密码共用同一套校验与散列，两侧行为永远一致。DAO 继承 BaseRepository<Account>，支持 IFreeSql 注入与 IDbConnection 兼容。 */
class AccountDao : BaseRepository<Account> {
    /* 密保答错锁定：1 小时窗口内错满 5 次，本小时窗口结束前拒绝再试。 */
    static int AnswerLimit = 5;
    static int AnswerWindowSec = 3600;

    /* 登录密码错锁定（账号级）：1 小时窗口内错满 LoginLimit 次，本窗口结束前登录拒绝。IP 限流是第一道闸（防单源 扫描），这是第二道（防分布式按账号撞库）。 */
    static int LoginLimit = 10;
    static int LoginWindowSec = 3600;

    AccountDao(IFreeSql fsql) : base(fsql) {}
    AccountDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async Account ByUsername(string username) {
        return await this.GetExecutor().Select<Account>()
            .Where(a => a.username == username).FirstAsync();
    }

    async Account ById(int id) {
        return await this.GetExecutor().Select<Account>()
            .Where(a => a.id == id).FirstAsync();
    }

    /* 注册新账号：校验与散列都在这里，调用方只递原始输入。
 返回新 id；0=账号已存在；-1=写入失败。 */
    async int Register(string username, string password, string email,
                       string question, string answer) {
        Account have = await this.ByUsername(username);
        if (have != null) { return 0; }
        Account row = new Account();
        row.username = username;
        row.email = email;
        row.passwordSalt = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        row.passwordHash = AuthUser.PasswordHash(password, row.passwordSalt);
        row.question = question;
        row.answerSalt = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        row.answerHash = AccountDao.AnswerHash(answer, row.answerSalt);
        row.answerFails = 0;
        row.answerFailAt = 0;
        row.status = 1;
        row.banReason = "";
        row.lastLoginAt = 0;
        row.createdAt = WebApp.NowSeconds();
        return await this.GetExecutor().Insert<Account>(row).ExecuteIdentityAsync();
    }

    /* 密码校验（只比散列；状态/封禁语义由调用方处理，便于区分文案）。 */
    bool CheckPassword(Account row, string password) {
        return row != null
            && AuthUser.PasswordHash(password, row.passwordSalt)
                == row.passwordHash;
    }

    /* 密保答案归一化后比对：与注册时同一规则（trim + 小写）。 */
    static string Normalize(string answer) {
        return answer.Trim().ToLower();
    }

    static string AnswerHash(string answer, string salt) {
        return AuthUser.PasswordHash(AccountDao.Normalize(answer), salt);
    }

    bool CheckAnswer(Account row, string answer) {
        if (row == null || row.question.Length == 0) { return false; }
        return AccountDao.AnswerHash(answer, row.answerSalt) == row.answerHash;
    }

    /* 重置密码：换盐重散列；返回影响行数。 */
    async int SetPassword(int accountId, string password) {
        string salt = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        string hash = AuthUser.PasswordHash(password, salt);
        return await this.GetExecutor().Update<Account>()
            .Set(a => a.passwordSalt, salt)
            .Set(a => a.passwordHash, hash)
            .Where(a => a.id == accountId)
            .ExecuteAffrowsAsync();
    }

    /* 答错限频：窗口内错满 AnswerLimit 次后拒绝再试（找回密码的暴力
 破解闸门，网页与 TCP 共用）。 */
    bool AnswerLocked(Account row, long now) {
        if (row.answerFails < AccountDao.AnswerLimit) { return false; }
        return now - row.answerFailAt < AccountDao.AnswerWindowSec;
    }

    async void NoteAnswerFail(Account row, long now) {
        /* 窗口过期则从零计。 */
        int fails = row.answerFails;
        if (now - row.answerFailAt >= AccountDao.AnswerWindowSec) { fails = 0; }
        int _n = await this.GetExecutor().Update<Account>()
            .Set(a => a.answerFails, fails + 1)
            .Set(a => a.answerFailAt, now)
            .Where(a => a.id == row.id)
            .ExecuteAffrowsAsync();
    }

    async void ClearAnswerFails(int accountId) {
        int _n = await this.GetExecutor().Update<Account>()
            .Set(a => a.answerFails, 0)
            .Where(a => a.id == accountId)
            .ExecuteAffrowsAsync();
    }

    /* 登录锁定：窗口内错满 LoginLimit 次后拒绝（与密保同构的窗口语义）。
 row 为 null（账号不存在）恒不锁定——错误计数没有落点。 */
    bool LoginLocked(Account row, long now) {
        if (row == null || row.loginFails < AccountDao.LoginLimit) {
            return false;
        }
        return now - row.loginFailAt < AccountDao.LoginWindowSec;
    }

    async void NoteLoginFail(Account row, long now) {
        if (row == null) { return; }
        /* 窗口过期则从零计。 */
        int fails = row.loginFails;
        if (now - row.loginFailAt >= AccountDao.LoginWindowSec) { fails = 0; }
        int _n = await this.GetExecutor().Update<Account>()
            .Set(a => a.loginFails, fails + 1)
            .Set(a => a.loginFailAt, now)
            .Where(a => a.id == row.id)
            .ExecuteAffrowsAsync();
    }

    async void ClearLoginFails(int accountId) {
        int _n = await this.GetExecutor().Update<Account>()
            .Set(a => a.loginFails, 0)
            .Where(a => a.id == accountId)
            .ExecuteAffrowsAsync();
    }

    /* 封禁/解封账号：封禁必须留原因（登录时展示给玩家）。返回影响行数。 */
    async int SetStatus(int id, int status, string banReason) {
        return await this.GetExecutor().Update<Account>()
            .Set(a => a.status, status)
            .Set(a => a.banReason, banReason)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int TouchLogin(int id, long now) {
        return await this.GetExecutor().Update<Account>()
            .Set(a => a.lastLoginAt, now)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }
}
