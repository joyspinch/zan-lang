using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* SkillDao 强类型数据访问网关（继承 FreeSql BaseRepository 范式） */
class SkillDao : BaseRepository<Skill> {
    SkillDao(IFreeSql fsql) : base(fsql) {}
    SkillDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async Skill ById(int id) {
        return await this.GetExecutor().Select<Skill>().Where(a => a.id == id).FirstAsync();
    }

    async List<Skill> All() {
        return await this.GetExecutor().Select<Skill>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<Skill>().CountAsync();
    }

    async int Insert(Skill entity) {
        return await this.GetExecutor().Insert<Skill>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<Skill>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
