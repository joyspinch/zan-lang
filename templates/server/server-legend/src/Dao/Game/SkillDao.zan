using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Game;

namespace ZanWeb.Dao.Game;

/* game_skill 的数据读写网关 */
class SkillDao {
    IDbConnection db;

    SkillDao(IDbConnection db) {
        this.db = db;
    }

    async Skill ById(int id) {
        return await this.db.Select<Skill>().Where(a => a.id == id).FirstAsync();
    }

    async List<Skill> All() {
        return await this.db.Select<Skill>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Skill>().CountAsync();
    }

    async int Insert(Skill entity) {
        return await this.db.Insert<Skill>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<Skill>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
