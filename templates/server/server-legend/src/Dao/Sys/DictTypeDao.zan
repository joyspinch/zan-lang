using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;

namespace ZanWeb.Dao.Sys;

/* sys_dict_type 的数据读写网关 */
class DictTypeDao {
    IDbConnection db;

    DictTypeDao(IDbConnection db) {
        this.db = db;
    }

    async DictType ById(int id) {
        return await this.db.Select<DictType>().Where(a => a.id == id).FirstAsync();
    }

    async DictType ByCode(string code) {
        return await this.db.Select<DictType>().Where(a => a.code == code).FirstAsync();
    }

    async List<DictType> All() {
        return await this.db.Select<DictType>().OrderBy(a => a.code).ToListAsync();
    }

    async List<DictType> AllActive() {
        return await this.db.Select<DictType>()
            .Where(a => a.status == 1)
            .OrderBy(a => a.code)
            .ToListAsync();
    }

    async int UpdateFields(int id, string code, string name, string description, int status, long updatedAt) {
        return await this.db.Update<DictType>()
            .Set(a => a.code, code)
            .Set(a => a.name, name)
            .Set(a => a.description, description)
            .Set(a => a.status, status)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int Insert(DictType dt) {
        return await this.db.Insert<DictType>(dt).ExecuteIdentityAsync();
    }

    async int Update(DictType dt) {
        return await this.UpdateFields(dt.id, dt.code, dt.name, dt.description, dt.status, dt.updatedAt);
    }

    async int Delete(int id) {
        return await this.db.Delete<DictType>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
