using System;
using System.Collections.Generic;
using System.Net;

public class Session {
    /* 会话 id（进程内唯一）。TCP 登录用连接 id；HTTP 登录用 10 亿段
       自增号，与 TCP 连接 id 永不重叠。 */
    public int cid;

    /* 推送通道的 TCP 连接；HTTP 登录的会话登录时为 null，客户端随后
       用 attach op 把推送通道挂上来。所有游戏操作走 HTTP，这条连接
       只收 ev（聊天/公告/战斗通知），Kick 走 conn.Close()。 */
    public System.Net.Connection conn;

    /* 会话由 HTTP 登录创建时为 true：推送连接断开只摘通道不登出
       （会话由 HTTP 心跳/操作续命，超时由 World.Sweep 收口）；TCP
       直连登录的旧式会话断开即落库登出。 */
    public bool httpOwned;

    /* 当前推送连接的连接 id；0=未挂通道。断开与顶号按它对号。 */
    public int pushCid;

    /* 账号（登录后即有）。 */
    public int accountId;
    public string username;

    /* 已进入的区服（game_realm.id）；0=登录了但还没进区。 */
    public int realmId;

    /* 本区倍率（万分比，进区时从 game_realm 读出随会话缓存）：
       经验/金币/爆率结算只看这三个值，换区即换套数值。 */
    public int expRate = 10000;
    public int goldRate = 10000;
    public int dropRate = 10000;

    /* 角色行的内存副本；未进区为 null。落库与读档都经它。 */
    public ZanWeb.Model.Game.Player row;

    /* 背包道具槽位强类型实体列表（已彻底消除平行列表 bagIds 与 bagCounts）。
       变更置 bagDirty，随 flush/登出整包回写 game_bag。 */
    public List<BagSlot> bagSlots = new List<BagSlot>();
    public bool bagDirty;

    /* 自动挂机：正在打击的怪物模板 id（game_mob.id），0=关闭。
       照原版离线挂机：服务端不再逐秒推送战况，Fight 每 60 秒把
       过去的战斗批量补跑结算成一条 ev idlesum；客户端的逐秒战况
       是本地演示动画。autoSettledAt 是批量结算的时钟锚点。 */
    public int autoMobId;
    public long autoSettledAt;

    /* 世界 BOSS 累计伤害（进程内战绩，公告表扬用）。 */
    public long wbDmg;

    public bool dirty;
    public long lastSeen;
    public long loginAt;

    /* 被顶号或 GM 踢出时置位：登出推送据此区分主动离线。 */
    public bool kicked;
}
