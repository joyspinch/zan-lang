using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.Json;
using ZanWeb.Model.Game;

public class SceneRankEntry {
    string name;
    int level;
    int floor;

    SceneRankEntry(string name, int level, int floor) {
        this.name = name != null ? name : "";
        this.level = level;
        this.floor = floor;
    }
}

