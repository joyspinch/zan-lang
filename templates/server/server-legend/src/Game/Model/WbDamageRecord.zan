using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Json;
using ZanWeb.Model.Game;

public class WbDamageRecord {
    public string name;
    public long damage;

    public WbDamageRecord(string name, long damage) {
        this.name = name != null ? name : "";
        this.damage = damage;
    }
}

/* 战斗闭环：怪物模板/物品模板装载、刷怪实例、一轮战斗（hunt 与
   自动挂机共用）、经验升级、掉落入包、背包与商店结算。
   模板与刷怪实例是进程内只读/运行态，不落库；背包走会话内存副本
   （bagDirty 整包回写），与角色行同一条纪律：在线改内存，落库交
   flush/登出。伤害不掷骰（atk-def 下限 1），随机只用于金币区间与
   掉落判定，方便测试与复现。 */
