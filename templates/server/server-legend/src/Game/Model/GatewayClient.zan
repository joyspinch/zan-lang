using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Net;
using System.Security.Cryptography;
using ZanWeb.Model.Game;

public class GatewayClient {
    int cid;
    Connection conn;
    string buffer;
    long lastSeen;
    ConnSec sec;

    GatewayClient(Connection conn) {
        this.cid = conn.GetId();
        this.conn = conn;
        this.buffer = "";
        this.lastSeen = WebApp.NowSeconds();
        this.sec = new ConnSec();
    }
}
