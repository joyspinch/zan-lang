using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.Json;
using ZanWeb.Model.Game;

public class MentorMateEntry {
    string name;
    int count;
    int level;

    MentorMateEntry(string name, int count, int level) {
        this.name = name != null ? name : "";
        this.count = count;
        this.level = level;
    }
}
