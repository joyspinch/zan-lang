using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Json;
using ZanWeb.Model.Game;

public class MonsterInstance {
    public int id;
    public int tplId;
    public int hp;
    public bool alive;
    public long respawnAt;

    public MonsterInstance(int id, int tplId, int hp, bool alive, long respawnAt) {
        this.id = id;
        this.tplId = tplId;
        this.hp = hp;
        this.alive = alive;
        this.respawnAt = respawnAt;
    }
}

