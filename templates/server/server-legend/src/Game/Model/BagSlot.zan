using System;
using System.Collections.Generic;
using System.Net;

public class BagSlot {
    int itemId;
    int count;

    BagSlot(int itemId, int count) {
        this.itemId = itemId;
        this.count = count;
    }
}

/* 一条在线会话 = 一条已通过网关登录的连接，生命周期两段：
   登录成功（accountId>0，realmId=0，row=null）→ 进入区服（row 非空，
   在世界中）。持有账号行与角色行的内存副本，在线期间的变更（移动、
   聊天、GM 发奖）都改这份副本并置 dirty，由 World 的 tick 定期与登出
   时落库——在线角色以内存为权威，避免 GM 页与网关两条写路径互相覆盖。
   字段公开可读，写入请走 World/Gateway 的入口，让 dirty 与推送不漏。
   Zan 调度器是协作式单线程，会话表无需加锁，只要不跨 await 持有半更新
   的状态即可。 */
