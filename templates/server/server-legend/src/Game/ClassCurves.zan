using System;

namespace ZanWeb.Game;

/* 三职业成长曲线。公式形状忠实移植传奇2 服务端源码
   CPlayerObject::RecalcLevelAbilitys（GameSvr/ObjectPlayer.cpp）：
   战=job0 血厚防高、法=job1 血薄魔厚、道=job2 中庸带魔御；主属性
   战力（DC）/魔法（MC）/道术（SC）三条曲线原版同级同幅（战略高）。
   数值带按迷你传奇校准：真怪表（稻草人 200hp@2 … 赤月恶魔 3000hp@50）
   落在 hp≈150+45·lvl / atk≈8+1.8·lvl / def≈2+0.9·lvl 的带上，玩家
   曲线乘 mirrors 原版职业比（血量 战:法:道 = 1:0.35:0.65、法力
   1:6:3）放到同带，保证同图怪 10 击内可杀、互殴数合不死。
   原版把装备加成以 RecalcAbilitys 的"基础+AddAbility"叠加在曲线上，
   本模板同构：装备/强化星/五行由 Fight 在曲线之上追加。 */
static class ClassCurves {
    /* ROUND(n/d)，n、d 非负整数（原版浮点 ROUND 的整型化）。 */
    static int DivRound(int n, int d) {
        return (n + d / 2) / d;
    }

    static int Max(int a, int b) {
        return a > b ? a : b;
    }

    /* 血量上限：战 140+20L、法 140+7L、道 140+13L（原版形状
       14+ROUND((L/系数+常数)·L) 的迷你带等距版）。 */
    static int MaxHp(int job, int level) {
        if (job == 1) { return 140 + 7 * level; }
        if (job == 2) { return 140 + 13 * level; }
        return 140 + 20 * level;
    }

    /* 法力上限：战 30+5L、法 30+30L、道 30+15L（原版 MP 比 1:9.8:6.6
       取整档）。法/道技能消耗的蓄水池。 */
    static int MaxMp(int job, int level) {
        if (job == 1) { return 30 + 30 * level; }
        if (job == 2) { return 30 + 15 * level; }
        return 30 + 5 * level;
    }

    /* 主属性区间（战=DC 力、法=MC 魔、道=SC 道）：hi = 10+4L/10+3L/
       10+3L（原版战 L/5、法道 L/7 的同幅关系），lo = hi·3/4。战斗
       结算取 hi（模板不掷骰契约），区间随协议下发供客户端展示。 */
    static int AtkHi(int job, int level) {
        if (job == 0) { return 10 + 4 * level; }
        return 10 + 3 * level;
    }

    static int AtkLo(int job, int level) {
        return ClassCurves.AtkHi(job, level) * 3 / 4;
    }

    /* 物防（原版 AC）：战 8+1.5L、道 8+L、法 8+0.4L——原版只有战士
       有 AC，这里按职业比摊开（怪的物理攻击对所有职业结算）。 */
    static int AcHi(int job, int level) {
        if (job == 0) { return 8 + 3 * level / 2; }
        if (job == 2) { return 8 + level; }
        return 8 + 2 * level / 5;
    }

    /* 魔防（原版 MAC）：道有，n=ROUND(L/6) 区间 n/2..n+1 → 迷你带
       8+L 上限；战法无。预留魔法系怪物结算。 */
    static int MacHi(int job, int level) {
        if (job == 2) { return 8 + level; }
        return 0;
    }
}
