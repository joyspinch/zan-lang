using System;
using System.Collections.Generic;
using System.Net;

namespace ZanWeb.Game;

/* 一条在线会话 = 一条已通过网关登录的连接，生命周期两段：
   登录成功（accountId>0，realmId=0，row=null）→ 进入区服（row 非空，
   在世界中）。持有账号行与角色行的内存副本，在线期间的变更（移动、
   聊天、GM 发奖）都改这份副本并置 dirty，由 World 的 tick 定期与登出
   时落库——在线角色以内存为权威，避免 GM 页与网关两条写路径互相覆盖。
   字段公开可读，写入请走 World/Gateway 的入口，让 dirty 与推送不漏。
   Zan 调度器是协作式单线程，会话表无需加锁，只要不跨 await 持有半更新
   的状态即可。 */
class Session {
    /* 会话 id（进程内唯一）。TCP 登录用连接 id；HTTP 登录用 10 亿段
       自增号，与 TCP 连接 id 永不重叠。 */
    int cid;

    /* 推送通道的 TCP 连接；HTTP 登录的会话登录时为 null，客户端随后
       用 attach op 把推送通道挂上来。所有游戏操作走 HTTP，这条连接
       只收 ev（聊天/公告/战斗通知），Kick 走 conn.Close()。 */
    System.Net.Connection conn;

    /* 会话由 HTTP 登录创建时为 true：推送连接断开只摘通道不登出
       （会话由 HTTP 心跳/操作续命，超时由 World.Sweep 收口）；TCP
       直连登录的旧式会话断开即落库登出。 */
    bool httpOwned;

    /* 当前推送连接的连接 id；0=未挂通道。断开与顶号按它对号。 */
    int pushCid;

    /* 账号（登录后即有）。 */
    int accountId;
    string username;

    /* 已进入的区服（game_realm.id）；0=登录了但还没进区。 */
    int realmId;

    /* 本区倍率（万分比，进区时从 game_realm 读出随会话缓存）：
       经验/金币/爆率结算只看这三个值，换区即换套数值。 */
    int expRate = 10000;
    int goldRate = 10000;
    int dropRate = 10000;

    /* 角色行的内存副本；未进区为 null。落库与读档都经它。 */
    ZanWeb.Model.Game.Player row;

    /* 背包内存副本（物品 id 与数量平行列表，同物品合并一项）。
       变更置 bagDirty，随 flush/登出整包回写 game_bag。 */
    List<int> bagIds = new List<int>();
    List<int> bagCounts = new List<int>();
    bool bagDirty;

    /* 自动挂机：正在打击的怪物模板 id（game_mob.id），0=关闭。
       照原版离线挂机：服务端不再逐秒推送战况，Fight 每 60 秒把
       过去的战斗批量补跑结算成一条 ev idlesum；客户端的逐秒战况
       是本地演示动画。autoSettledAt 是批量结算的时钟锚点。 */
    int autoMobId;
    long autoSettledAt;

    /* 世界 BOSS 累计伤害（进程内战绩，公告表扬用）。 */
    long wbDmg;

    bool dirty;
    long lastSeen;
    long loginAt;

    /* 被顶号或 GM 踢出时置位：登出推送据此区分主动离线。 */
    bool kicked;
}
