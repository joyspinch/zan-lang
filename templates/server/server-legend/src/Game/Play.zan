using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Data.Sqlite;
using System.Json;
using ZanWeb.Model.Game;
using ZanWeb.Dao.Game;

namespace ZanWeb.Game;

/* 玩法页（导航 1/4/5/7/8/10/11/14/16/18/22/23/25）的服务端实现：
   PK竞技场、押镖、行会、城池争夺、传说塔、五行修炼、师徒、祭坛、
   将星图谱、发红包、交易市场、图鉴明细、称谓。
   本文件不允许出现玩法数值常量：次数/费用/曲线/概率一律 Rules.Val
   与规则表行取值（balance.csv / elements.csv / 原版事实表 GameTitle），
   改数值是改 CSV，不是改代码——这是与旧服务端最大的结构差异。
   四种玩法货币（战功/声望/红包币/图谱积分）在这里入账，闭环见
   data/RULES.md §3.5。每日次数照 bossTryDate 定式跨天回满；所有可变
   状态改会话内存副本并置 dirty，落库随 World.Flush。图鉴明细（codex）
   按物品/怪物分页，页面一次一页。 */
/// 场景排行榜条目强类型实体（消除 names/lvls/floors 平行列表反模式）。
class SceneRankEntry {
    string name;
    int level;
    int floor;

    SceneRankEntry(string name, int level, int floor) {
        this.name = name != null ? name : "";
        this.level = level;
        this.floor = floor;
    }
}

/// 宗师结伴聚合条目强类型实体（消除 mNames/mCnts/mLvls 平行列表反模式）。
class MentorMateEntry {
    string name;
    int count;
    int level;

    MentorMateEntry(string name, int count, int level) {
        this.name = name != null ? name : "";
        this.count = count;
        this.level = level;
    }
}

class Play {
    static Random rng = new Random();

    static string Err(string why) { return why; }

    /* 今天日期（yyyy-MM-dd），BossDaily 同款。 */
    static string Today(long now) {
        DateTime dt = DateTime.FromUnixSeconds(now);
        return Convert.ToString(dt.year) + "-"
            + (dt.month < 10 ? "0" : "") + Convert.ToString(dt.month) + "-"
            + (dt.day < 10 ? "0" : "") + Convert.ToString(dt.day);
    }

    /* arena/escort/tower 每日次数跨天回满，上限读 balance.csv。 */
    static void DailyReset(Session s, long now) {
        string today = Play.Today(now);
        if (s.row.arenaTryDate != today) {
            s.row.arenaTries = Rules.Val("arena_tries");
            s.row.arenaTryDate = today;
            s.dirty = true;
        }
        if (s.row.escortTryDate != today) {
            s.row.escortTries = Rules.Val("escort_tries");
            s.row.escortTryDate = today;
            s.dirty = true;
        }
        if (s.row.altarDonationDate != today) {
            s.row.altarDonations = 0;
            s.row.altarDonationDate = today;
            s.dirty = true;
        }
        if (s.row.towerTryDate != today) {
            s.row.towerTries = Rules.Val("tower_tries");
            s.row.towerTryDate = today;
            s.dirty = true;
        }
    }

    /* ---- 协议 ---- */

    /* arena: {}=面板；{"fight":1..N}=打一场（N=arena_rival_count，与
       客户端 16 张挑战卡一致）。对手战力照客户端 Game.zan 的公式：
       base + (胜场+1)*win + rival0*rival（服务端 rival 1 基，转 0 基）；
       胜负 = 我方战力×随机系数 ≥ 对手战力×arena_win_scale。 */
    static async JsonValue Arena(Session s, JsonValue m, long now) {
        Play.DailyReset(s, now);
        if (m.Int("fight", 0) > 0) {
            int rival = m.Int("fight", 1);
            int rivalCount = Rules.Val("arena_rival_count");
            if (rival < 1 || rival > rivalCount) { return Gateway.Err("对手编号不合法"); }
            if (s.row.arenaTries <= 0) {
                return Gateway.Err("竞技场每日" + Convert.ToString(Rules.Val("arena_tries"))
                    + "次，明日再来");
            }
            s.row.arenaTries = s.row.arenaTries - 1;
            long winMerit = Rules.Long("arena_win_merit");
            long loseMerit = Rules.Long("arena_lose_merit");
            long winReputation = Rules.Long("arena_win_reputation");
            long loseReputation = Rules.Long("arena_lose_reputation");
            long winGold = Rules.Long("arena_win_gold");
            int power = Fight.Atk(s.row) * Rules.Val("arena_power_scale")
                / (Fight.Def(s.row) + Rules.Val("arena_def_offset"));
            long opponent = (long)Rules.Val("arena_power_base")
                + (long)(s.row.arenaWins + 1) * Rules.Val("arena_power_win")
                + (long)(rival - 1) * Rules.Val("arena_power_rival");
            long myRoll = (long)power * (Rules.Val("incoming_random_min")
                + Play.rng.Between(0, Rules.Val("incoming_random_range")));
            bool win = myRoll >= opponent * Rules.Val("arena_win_scale");
            s.row.merit = s.row.merit + loseMerit;
            s.row.reputation = s.row.reputation + loseReputation;
            JsonValue r = Gateway.Ok();
            long gotMerit = loseMerit;
            long gotReputation = loseReputation;
            long gotGold = 0;
            if (win) {
                s.row.arenaWins = s.row.arenaWins + 1;
                s.row.merit = s.row.merit + winMerit - loseMerit;
                s.row.reputation = s.row.reputation + winReputation - loseReputation;
                s.row.gold = s.row.gold + winGold;
                gotMerit = winMerit;
                gotReputation = winReputation;
                gotGold = winGold;
            }
            r.Set("win", JsonValue.NewNum(win ? "1" : "0"));
            r.Set("rival", JsonValue.NewNum(Convert.ToString(rival)));
            r.Set("gold", JsonValue.NewNum(Convert.ToString(gotGold)));
            r.Set("merit", JsonValue.NewNum(Convert.ToString(gotMerit)));
            r.Set("reputation", JsonValue.NewNum(Convert.ToString(gotReputation)));
            r.Set("log", JsonValue.NewStr(win
                ? "击败对手 " + Convert.ToString(rival) + "！战功 +"
                    + Convert.ToString(gotMerit) + "、声望 +"
                    + Convert.ToString(gotReputation) + "、金币 +"
                    + Convert.ToString(gotGold)
                : "挑战对手 " + Convert.ToString(rival) + " 失败，战功 +"
                    + Convert.ToString(gotMerit) + "、声望 +"
                    + Convert.ToString(gotReputation)));
            r.Set("arena", await Play.ArenaState(s, now));
            Gateway.SelfInto(r, s);
            s.dirty = true;
            return r;
        }
        JsonValue p = Gateway.Ok();
        p.Set("arena", await Play.ArenaState(s, now));
        return p;
    }

    /* 面板：计数器 + 本区战功榜（arena_rival_count 行，客户端挑战卡
       逐张取 rows[i].name/rank/me，无榜时退回演示数据）。 */
    static async JsonValue ArenaState(Session s, long now) {
        JsonValue a = JsonValue.NewObject();
        a.Set("tries", JsonValue.NewNum(Convert.ToString(s.row.arenaTries)));
        a.Set("wins", JsonValue.NewNum(Convert.ToString(s.row.arenaWins)));
        a.Set("pts", JsonValue.NewNum(Convert.ToString(s.row.merit)));
        a.Set("power", JsonValue.NewNum(Convert.ToString(Fight.Atk(s.row))));
        a.Set("time", JsonValue.NewNum(Convert.ToString(now)));
        int take = Rules.Val("arena_rival_count");
        JsonValue arr = JsonValue.NewArray();
        List<ArenaRivalEntry> rivalEntries = new List<ArenaRivalEntry>();
        IDbConnection db = await Gateway.Db();
        if (db != null) {
            try {
                List<ZanWeb.Model.Game.Player> rows = await db
                    .Select<ZanWeb.Model.Game.Player>()
                    .Where(x => x.realmId == s.realmId)
                    .OrderByDescending(x => x.merit)
                    .Take(take).ToListAsync();
                for (int i = 0; i < rows.Count; i = i + 1) {
                    rivalEntries.Add(new ArenaRivalEntry(rows[i].nickname, i + 1, rows[i].id == s.row.id));
                }
            } finally {
                Gateway.Give(db);
            }
        }
        for (int i = 0; i < rivalEntries.Count; i = i + 1) {
            ArenaRivalEntry e = rivalEntries[i];
            JsonValue o = JsonValue.NewObject();
            o.Set("name", JsonValue.NewStr(e.Name));
            o.Set("rank", JsonValue.NewNum(Convert.ToString(e.Rank)));
            o.Set("me", JsonValue.NewNum(e.IsMe ? "1" : "0"));
            arr.Append(o);
        }
        a.Set("rows", arr);
        return a;
    }

    /* escort: {}=面板；{"go":1}=出发（押金 escort_gold 不退）；{"collect":1}
       =到达收镖。奖励 = escort_reward + 等级×escort_level_gold + 有会加
       escort_guild_gold；收镖入账金币 + 声望 escort_merit，行会资金同步
       +escort_guild_gold（RULES.md 裁决 #9：金币+行会物资+声望）。 */
    static async JsonValue Escort(Session s, JsonValue m, long now) {
        Play.DailyReset(s, now);
        if (m.Int("go", 0) == 1) {
            if (s.row.escortStage == 1) { return Gateway.Err("镖车已在路上"); }
            if (s.row.escortTries <= 0) { return Gateway.Err("今日押镖次数已用完，明天再来"); }
            long deposit = Rules.Long("escort_gold");
            if (s.row.gold < deposit) {
                return Gateway.Err("金币不够（押金 " + Convert.ToString(deposit) + "）");
            }
            s.row.gold = s.row.gold - deposit;
            s.row.escortTries = s.row.escortTries - 1;
            s.row.escortStage = 1;
            s.row.escortUntil = now + Rules.Val("escort_seconds");
            s.row.escortReward = Rules.Long("escort_reward")
                + (long)s.row.level * Rules.Val("escort_level_gold")
                + (s.row.guildId > 0 ? Rules.Long("escort_guild_gold") : 0);
            s.dirty = true;
        }
        if (m.Int("collect", 0) == 1) {
            if (s.row.escortStage != 1) { return Gateway.Err("当前没有运输中的镖车"); }
            if (now < s.row.escortUntil) {
                return Gateway.Err("镖车还在路上（还差 "
                    + Convert.ToString(s.row.escortUntil - now) + " 秒）");
            }
            long gain = s.row.escortReward;
            s.row.escortStage = 0;
            s.row.escortUntil = 0;
            s.row.escortReward = 0;
            s.row.gold = s.row.gold + gain;
            s.row.reputation = s.row.reputation + Rules.Long("escort_merit");
            s.dirty = true;
            if (s.row.guildId > 0) {
                IDbConnection db = await Gateway.Db();
                if (db != null) {
                    try {
                        int _g = await db.Update<ZanWeb.Model.Game.Guild>()
                            .SetIncr(a => a.fund, Rules.Long("escort_guild_gold"))
                            .Where(a => a.id == s.row.guildId)
                            .ExecuteAffrowsAsync();
                    } finally {
                        Gateway.Give(db);
                    }
                }
            }
            JsonValue rc = Gateway.Ok();
            rc.Set("gain", JsonValue.NewNum(Convert.ToString(gain)));
            rc.Set("escort", Play.EscortState(s, now));
            Gateway.SelfInto(rc, s);
            return rc;
        }
        JsonValue r = Gateway.Ok();
        r.Set("escort", Play.EscortState(s, now));
        return r;
    }

    static JsonValue EscortState(Session s, long now) {
        JsonValue a = JsonValue.NewObject();
        a.Set("tries", JsonValue.NewNum(Convert.ToString(s.row.escortTries)));
        a.Set("stage", JsonValue.NewNum(Convert.ToString(s.row.escortStage)));
        if (s.row.escortStage == 1) {
            long left = s.row.escortUntil - now;
            if (left < 0) { left = 0; }
            a.Set("left", JsonValue.NewNum(Convert.ToString(left)));
            a.Set("reward", JsonValue.NewNum(Convert.ToString(s.row.escortReward)));
        }
        return a;
    }

    /* guild: {}=列表+我的会；{"create":"名"}=建会（guild_create_gold
       + 道具 guild_create_item，名字 guild_name_min/max 字）；
       {"join":id}=入会；{"quit":1}=退会。会长退会先转让/拒绝。
       行形状照客户端 GuildRow：master/memberCap/goods/limitLevel，
       旧键 leader/fund 同步下发双保险。 */
    static async JsonValue Guild(Session s, JsonValue m, long now) {
        IDbConnection db = await Gateway.Db();
        if (db == null) { return Gateway.Err("数据库不可用，请稍后再试"); }
        try {
            if (m.Str("create", "").Length > 0) {
                string name = m.Str("create", "").Trim();
                int nameMin = Rules.Val("guild_name_min");
                int nameMax = Rules.Val("guild_name_max");
                if (GameFmt.CharCount(name) < nameMin || GameFmt.CharCount(name) > nameMax) {
                    return Gateway.Err("行会名需 " + Convert.ToString(nameMin) + "-"
                        + Convert.ToString(nameMax) + " 字");
                }
                if (s.row.guildId > 0) { return Gateway.Err("你已有行会，先退出再建"); }
                long cost = Rules.Long("guild_create_gold");
                if (s.row.gold < cost) {
                    return Gateway.Err("建会需要 " + Convert.ToString(cost) + " 金币");
                }
                int token = Rules.Val("guild_create_item");
                if (!Fight.BagTake(s, token, 1)) {
                    ZanWeb.Model.Game.Item tokenItem = Fight.ById(token);
                    return Gateway.Err("建会需要 1 个 "
                        + (tokenItem != null ? tokenItem.name : "信物"));
                }
                int dup = await db.Select<ZanWeb.Model.Game.Guild>()
                    .Where(a => a.name == name).CountAsync();
                if (dup > 0) { return Gateway.Err("行会名已被使用"); }
                s.row.gold = s.row.gold - cost;
                ZanWeb.Model.Game.Guild g = new ZanWeb.Model.Game.Guild();
                g.name = name;
                g.leader = s.row.nickname;
                g.fund = 0;
                g.createdAt = now;
                int gid = await db.Insert<ZanWeb.Model.Game.Guild>(g)
                    .ExecuteIdentityAsync();
                s.row.guildId = gid;
                s.dirty = true;
            }
            if (m.Int("join", 0) > 0) {
                if (s.row.guildId > 0) { return Gateway.Err("你已在行会中"); }
                ZanWeb.Model.Game.Guild g = await db
                    .Select<ZanWeb.Model.Game.Guild>()
                    .Where(a => a.id == m.Int("join", 0)).FirstAsync();
                if (g == null) { return Gateway.Err("没有这个行会"); }
                s.row.guildId = g.id;
                s.dirty = true;
            }
            if (m.Int("quit", 0) == 1) {
                if (s.row.guildId <= 0) { return Gateway.Err("你还没有行会"); }
                ZanWeb.Model.Game.Guild g = await db
                    .Select<ZanWeb.Model.Game.Guild>()
                    .Where(a => a.id == s.row.guildId).FirstAsync();
                if (g != null && g.leader == s.row.nickname) {
                    int members = await db.Select<ZanWeb.Model.Game.Player>()
                        .Where(a => a.guildId == g.id).CountAsync();
                    if (members > 1) {
                        return Gateway.Err("会长不能直接退会，请先转让或解散");
                    }
                    await db.Delete<ZanWeb.Model.Game.Guild>()
                        .Where(a => a.id == g.id).ExecuteAffrowsAsync();
                }
                s.row.guildId = 0;
                s.dirty = true;
            }
            int cap = Rules.Val("guild_max_members");
            List<ZanWeb.Model.Game.Guild> rows = await db
                .Select<ZanWeb.Model.Game.Guild>()
                .OrderBy(a => a.id).ToListAsync();
            List<GuildListItem> guildEntries = new List<GuildListItem>();
            for (int i = 0; i < rows.Count; i = i + 1) {
                ZanWeb.Model.Game.Guild g = rows[i];
                int members = await db.Select<ZanWeb.Model.Game.Player>()
                    .Where(a => a.guildId == g.id).CountAsync();
                guildEntries.Add(new GuildListItem(g.id, g.name, g.leader, members, cap, g.fund, g.id == s.row.guildId));
            }
            JsonValue arr = JsonValue.NewArray();
            for (int i = 0; i < guildEntries.Count; i = i + 1) {
                GuildListItem g = guildEntries[i];
                JsonValue o = JsonValue.NewObject();
                o.Set("id", JsonValue.NewNum(Convert.ToString(g.Id)));
                o.Set("name", JsonValue.NewStr(g.Name));
                o.Set("master", JsonValue.NewStr(g.Leader));
                o.Set("leader", JsonValue.NewStr(g.Leader));
                o.Set("members", JsonValue.NewNum(Convert.ToString(g.Members)));
                o.Set("memberCap", JsonValue.NewNum(Convert.ToString(g.MemberCap)));
                o.Set("goods", JsonValue.NewNum(Convert.ToString(g.Fund)));
                o.Set("fund", JsonValue.NewNum(Convert.ToString(g.Fund)));
                o.Set("limitLevel", JsonValue.NewNum("0"));
                o.Set("mine", JsonValue.NewNum(g.IsMine ? "1" : "0"));
                arr.Append(o);
            }
            JsonValue r = Gateway.Ok();
            r.Set("rows", arr);
            r.Set("myGuild", JsonValue.NewNum(Convert.ToString(s.row.guildId)));
            Gateway.SelfInto(r, s);
            return r;
        } finally {
            Gateway.Give(db);
        }
    }

    /* siege 城池争夺：沙巴克城主（owner 名 + 申报战时间）
       + 城池争夺页的 city_count 座钱庄（每座 owner/guild/at）。
       全部走 WorldState（进程内热缓存 + 写穿 game_world，重启恢复）。
       攻占 = 消耗 siege_attack_gold 掷骰（胜率 siege_base_chance
       + (攻 + 等级×siege_level_power) / siege_power_div），成功即易主
       并全服公告。 */
    static string SiegeOwner() { return WorldState.Get("siege.master.owner", ""); }
    static string SiegeGuild() { return WorldState.Get("siege.master.guild", ""); }
    static long SiegeAt() { return WorldState.GetNum("siege.master.at", 0); }
    static string CityOwner(int city) {
        return WorldState.Get("city." + Convert.ToString(city) + ".owner", "");
    }
    static string CityGuild(int city) {
        return WorldState.Get("city." + Convert.ToString(city) + ".guild", "");
    }
    static long CityAt(int city) {
        return WorldState.GetNum("city." + Convert.ToString(city) + ".at", 0);
    }

    /* city_count 可配，进程内数组固定 8 座，配置超出按 8 封顶。 */
    static int CityCount() {
        int n = Rules.Val("city_count");
        if (n > 8) { n = 8; }
        if (n < 1) { n = 1; }
        return n;
    }

    static string CityName(int city) { return "钱庄" + Convert.ToString(city); }

    static async JsonValue Siege(Session s, JsonValue m, long now) {
        /* 沙巴克争夺（{"sha":1}）：同攻城判定，赢主 writeWorld 的
           siege.master.*——沙巴克页头带的占领公会/占领时间/城主就来自它。 */
        if (m.Int("sha", 0) == 1) {
            if (s.row.guildId <= 0) { return Gateway.Err("先加入行会才能争夺沙巴克"); }
            long cost = Rules.Long("siege_attack_gold");
            if (s.row.gold < cost) {
                return Gateway.Err("争夺沙巴克需要 " + Convert.ToString(cost) + " 金币");
            }
            string guildName = "";
            IDbConnection db = await Gateway.Db();
            if (db != null) {
                try {
                    ZanWeb.Model.Game.Guild g = await db
                        .Select<ZanWeb.Model.Game.Guild>()
                        .Where(a => a.id == s.row.guildId).FirstAsync();
                    if (g != null) { guildName = g.name; }
                } finally {
                    Gateway.Give(db);
                }
            }
            int power = Fight.Atk(s.row)
                + s.row.level * Rules.Val("siege_level_power");
            s.row.gold = s.row.gold - cost;
            s.dirty = true;
            int chance = Rules.Val("siege_base_chance") + power / Rules.Val("siege_power_div");
            bool win = Play.rng.Between(0, 99) < chance;
            JsonValue rs = Gateway.Ok();
            if (win) {
                WorldState.Set("siege.master.owner", s.row.nickname);
                WorldState.Set("siege.master.guild", guildName);
                WorldState.SetNum("siege.master.at", now);
                Gateway.AnnounceAll("沙巴克易主",
                    s.row.nickname + " 率" + guildName + "攻占了沙巴克！");
            }
            rs.Set("win", JsonValue.NewNum(win ? "1" : "0"));
            rs.Set("log", JsonValue.NewStr(win
                ? "攻占沙巴克成功，全服公告已发！"
                : "攻占沙巴克失败，守军太强。金币已消耗。"));
            rs.Set("siege", Play.SiegeState(now));
            Gateway.SelfInto(rs, s);
            return rs;
        }
        if (m.Int("attack", 0) == 1) {
            int city = m.Int("city", 0);
            if (city < 1 || city > Play.CityCount()) { return Gateway.Err("城池编号不合法"); }
            if (s.row.guildId <= 0) { return Gateway.Err("先加入行会才能攻占城池"); }
            long cost = Rules.Long("siege_attack_gold");
            if (s.row.gold < cost) {
                return Gateway.Err("攻占城池需要 " + Convert.ToString(cost) + " 金币");
            }
            string guildName = "";
            IDbConnection db = await Gateway.Db();
            if (db != null) {
                try {
                    ZanWeb.Model.Game.Guild g = await db
                        .Select<ZanWeb.Model.Game.Guild>()
                        .Where(a => a.id == s.row.guildId).FirstAsync();
                    if (g != null) { guildName = g.name; }
                } finally {
                    Gateway.Give(db);
                }
            }
            int power = Fight.Atk(s.row)
                + s.row.level * Rules.Val("siege_level_power");
            s.row.gold = s.row.gold - cost;
            s.dirty = true;
            int chance = Rules.Val("siege_base_chance") + power / Rules.Val("siege_power_div");
            bool win = Play.rng.Between(0, 99) < chance;
            JsonValue r = Gateway.Ok();
            if (win) {
                WorldState.Set("city." + Convert.ToString(city) + ".owner", s.row.nickname);
                WorldState.Set("city." + Convert.ToString(city) + ".guild", guildName);
                WorldState.SetNum("city." + Convert.ToString(city) + ".at", now);
                Gateway.AnnounceAll("城池易主",
                    s.row.nickname + " 率行会攻占了" + Play.CityName(city) + "！");
            }
            r.Set("win", JsonValue.NewNum(win ? "1" : "0"));
            r.Set("log", JsonValue.NewStr(win
                ? "攻占" + Play.CityName(city) + "成功，全服公告已发！"
                : "攻占" + Play.CityName(city) + "失败，守军太强。金币已消耗。"));
            r.Set("siege", Play.SiegeState(now));
            Gateway.SelfInto(r, s);
            return r;
        }
        JsonValue r2 = Gateway.Ok();
        r2.Set("siege", Play.SiegeState(now));
        return r2;
    }

    static SiegeStateModel TypedSiegeState(long now) {
        long at = Play.SiegeAt();
        long hold = at > 0 ? now - at : 0;
        int n = Play.CityCount();
        long incomeBase = Rules.Long("city_income_base");
        long incomeStep = Rules.Long("city_income_step");
        long cost = Rules.Long("siege_attack_gold");
        List<SiegeCityItem> cities = new List<SiegeCityItem>();
        for (int i = 0; i < n; i = i + 1) {
            int cid = i + 1;
            string dateStr = Play.CityAt(cid) > 0 ? Play.Today(Play.CityAt(cid)) : "";
            cities.Add(new SiegeCityItem(
                cid,
                Play.CityName(cid),
                Play.CityOwner(cid),
                Play.CityGuild(cid),
                incomeBase + (long)i * incomeStep,
                cost,
                dateStr
            ));
        }
        List<SiegeRewardItem> rewardsOccupied = new List<SiegeRewardItem>();
        rewardsOccupied.Add(new SiegeRewardItem(0, 0));
        rewardsOccupied.Add(new SiegeRewardItem(0, 0));
        rewardsOccupied.Add(new SiegeRewardItem(27, 10000));
        rewardsOccupied.Add(new SiegeRewardItem(31, 3000));
        rewardsOccupied.Add(new SiegeRewardItem(44, 30000));
        rewardsOccupied.Add(new SiegeRewardItem(62, 300));

        List<SiegeRewardItem> rewardsRandom = new List<SiegeRewardItem>();
        rewardsRandom.Add(new SiegeRewardItem(27, 100));
        rewardsRandom.Add(new SiegeRewardItem(15, 10));
        rewardsRandom.Add(new SiegeRewardItem(19, 0));
        rewardsRandom.Add(new SiegeRewardItem(44, 100));

        return new SiegeStateModel(Play.SiegeOwner(), Play.SiegeGuild(), hold, cities, rewardsOccupied, rewardsRandom);
    }

    static JsonValue SiegeState(long now) {
        SiegeStateModel model = Play.TypedSiegeState(now);
        JsonValue o = JsonValue.NewObject();
        o.Set("owner", JsonValue.NewStr(model.Owner));
        o.Set("guild", JsonValue.NewStr(model.Guild));
        o.Set("holdSeconds", JsonValue.NewNum(Convert.ToString(model.HoldSeconds)));
        JsonValue cities = JsonValue.NewArray();
        for (int i = 0; i < model.Cities.Count; i = i + 1) {
            SiegeCityItem c = model.Cities[i];
            JsonValue co = JsonValue.NewObject();
            co.Set("id", JsonValue.NewNum(Convert.ToString(c.Id)));
            co.Set("name", JsonValue.NewStr(c.Name));
            co.Set("owner", JsonValue.NewStr(c.Owner));
            co.Set("guild", JsonValue.NewStr(c.Guild));
            co.Set("income", JsonValue.NewNum(Convert.ToString(c.Income)));
            co.Set("cost", JsonValue.NewNum(Convert.ToString(c.Cost)));
            co.Set("date", JsonValue.NewStr(c.Date));
            cities.Append(co);
        }
        o.Set("cities", cities);

        JsonValue ro = JsonValue.NewArray();
        for (int i = 0; i < model.RewardsOccupied.Count; i = i + 1) {
            SiegeRewardItem g = model.RewardsOccupied[i];
            JsonValue go = JsonValue.NewObject();
            go.Set("picture", JsonValue.NewNum(Convert.ToString(g.Picture)));
            go.Set("count", JsonValue.NewNum(Convert.ToString(g.Count)));
            ro.Append(go);
        }
        o.Set("rewardsOccupied", ro);

        JsonValue rr = JsonValue.NewArray();
        for (int i = 0; i < model.RewardsRandom.Count; i = i + 1) {
            SiegeRewardItem g = model.RewardsRandom[i];
            JsonValue go = JsonValue.NewObject();
            go.Set("picture", JsonValue.NewNum(Convert.ToString(g.Picture)));
            go.Set("count", JsonValue.NewNum(Convert.ToString(g.Count)));
            rr.Append(go);
        }
        o.Set("rewardsRandom", rr);

        return o;
    }

    /* tower 传说塔：{"climb":1} 爬一层。敌人强度随层涨（tower_foe_*），
       胜负 = 我攻×tower_win_atk_scale > 敌攻×(tower_win_def_base
       + 层/tower_win_floor_div)；胜利楼层+1、金币/经验/战功入账；
       失败塔层保留（明日再战），每日 tower_tries 次。 */
    static async JsonValue Tower(Session s, JsonValue m, long now) {
        Play.DailyReset(s, now);
        if (m.Int("climb", 0) == 1) {
            if (s.row.towerTries <= 0) {
                return Gateway.Err("今日登塔次数已用完，明天再来");
            }
            s.row.towerTries = s.row.towerTries - 1;
            int floor = s.row.towerFloor + 1;
            int foeAtk = Rules.Val("tower_foe_atk_base")
                + floor * Rules.Val("tower_foe_atk_per_floor");
            int foeHp = Rules.Val("tower_foe_hp_base")
                + floor * Rules.Val("tower_foe_hp_per_floor");
            int myAtk = Fight.Atk(s.row);
            bool win = (long)myAtk * Rules.Val("tower_win_atk_scale")
                > (long)foeAtk * (Rules.Val("tower_win_def_base")
                    + floor / Rules.Val("tower_win_floor_div"));
            JsonValue r = Gateway.Ok();
            if (win) {
                s.row.towerFloor = floor;
                long gold = Rules.Long("tower_gold_base")
                    + (long)floor * Rules.Val("tower_gold_per_floor");
                long exp = Rules.Long("tower_xp_base")
                    + (long)floor * Rules.Val("tower_xp_per_floor");
                s.row.gold = s.row.gold + gold;
                s.row.exp = s.row.exp + exp;
                s.row.merit = s.row.merit + Rules.Long("tower_merit");
                int ups = 0;
                while (s.row.exp >= Fight.ExpNext(s.row.level)) {
                    s.row.exp = s.row.exp - Fight.ExpNext(s.row.level);
                    s.row.level = s.row.level + 1;
                    s.row.hp = Fight.MaxHp(s.row);
                    s.row.mp = Fight.MaxMp(s.row);
                    ups = ups + 1;
                }
                r.Set("levelup", JsonValue.NewNum(Convert.ToString(ups > 0
                    ? s.row.level : 0)));
                r.Set("gold", JsonValue.NewNum(Convert.ToString(gold)));
                r.Set("exp", JsonValue.NewNum(Convert.ToString(exp)));
                r.Set("merit", JsonValue.NewNum(Convert.ToString(
                    Rules.Val("tower_merit"))));
                r.Set("floor", JsonValue.NewNum(Convert.ToString(floor)));
            }
            r.Set("win", JsonValue.NewNum(win ? "1" : "0"));
            r.Set("log", JsonValue.NewStr(win
                ? "第 " + Convert.ToString(floor) + " 层攻克！守卫血量 "
                    + Convert.ToString(foeHp) + "。"
                : "第 " + Convert.ToString(floor) + " 层守卫太强， Retreat。"));
            r.Set("tower", await Play.TowerState(s));
            Gateway.SelfInto(r, s);
            s.dirty = true;
            return r;
        }
        JsonValue r2 = Gateway.Ok();
        r2.Set("tower", await Play.TowerState(s));
        return r2;
    }

    static async JsonValue TowerState(Session s) {
        JsonValue o = JsonValue.NewObject();
        o.Set("floor", JsonValue.NewNum(Convert.ToString(s.row.towerFloor)));
        o.Set("tries", JsonValue.NewNum(Convert.ToString(s.row.towerTries)));
        o.Set("maxTries", JsonValue.NewNum(Convert.ToString(Rules.Val("tower_tries"))));
        /* 传说塔页的挑战者卡（原版每层 15 张）：本区前 15 名的层榜，
           rank 0 = 自己的位置卡（floor=自己进度，me=1）。 */
        o.Set("rivals", await Play.TowerRivals(s));
        return o;
    }

    /* 挑战者：本区层榜前 15（level/kills 排序近似），不含自己。 */
    static async JsonValue TowerRivals(Session s) {
        JsonValue arr = JsonValue.NewArray();
        IDbConnection db = await Gateway.Db();
        if (db == null) { return arr; }
        try {
            List<ZanWeb.Model.Game.Player> rows = await db
                .Select<ZanWeb.Model.Game.Player>()
                .Where(a => a.realmId == s.realmId && a.id != s.row.id)
                .OrderByDescending(a => a.towerFloor)
                .Take(Rules.Val("tower_rival_cards")).ToListAsync();
            for (int i = 0; i < rows.Count; i = i + 1) {
                JsonValue p = JsonValue.NewObject();
                p.Set("name", JsonValue.NewStr(rows[i].nickname));
                p.Set("floor", JsonValue.NewNum(Convert.ToString(rows[i].towerFloor)));
                p.Set("level", JsonValue.NewNum(Convert.ToString(rows[i].level)));
                arr.Append(p);
            }
        } finally {
            Gateway.Give(db);
        }
        return arr;
    }

    /* wuxing 五行修炼：{"do":"pool"} 打怪经验入池（挂机自动）；
       {"do":"inject","id":0..4} 注入；{"do":"up","id":0..4} 突破。
       每行的上限/经验曲线/突破费用（黑铁+元宝）读 elements.csv 行。 */
    static JsonValue Wuxing(Session s, JsonValue m) {
        int[] ranks = Play.WxParse(s.row.wuxingRanks);
        long[] xp = Play.WxParseL(s.row.wuxingXp);
        string act = m.Str("do", "");
        JsonValue r = Gateway.Ok();
        if (act == "inject") {
            int id = m.Int("id", -1);
            if (id < 0 || id > 4) { return Gateway.Err("五行编号不合法"); }
            ZanWeb.RuleRow el = Rules.Elements().At(id);
            if (ranks[id] >= el.Int("max_level")) { return Gateway.Err("该五行已满级"); }
            long need = (long)el.Int("xp_base") + (long)el.Int("xp_step") * ranks[id];
            long amount = need - xp[id];
            if (amount > s.row.wuxingPool) { amount = s.row.wuxingPool; }
            if (amount <= 0) { return Gateway.Err("经验池为空，先去挂机积累"); }
            s.row.wuxingPool = s.row.wuxingPool - amount;
            xp[id] = xp[id] + amount;
            s.dirty = true;
        } else if (act == "up") {
            int id = m.Int("id", -1);
            if (id < 0 || id > 4) { return Gateway.Err("五行编号不合法"); }
            ZanWeb.RuleRow el = Rules.Elements().At(id);
            if (ranks[id] >= el.Int("max_level")) { return Gateway.Err("该五行已满级"); }
            long need = (long)el.Int("xp_base") + (long)el.Int("xp_step") * ranks[id];
            if (xp[id] < need) { return Gateway.Err("经验不足，先注入"); }
            long ironCost = (long)el.Int("upgrade_iron")
                + (long)el.Int("upgrade_iron_step") * ranks[id];
            long yuanCost = (long)el.Int("upgrade_yuan")
                + (long)el.Int("upgrade_yuan_step") * ranks[id];
            if (s.row.gems < yuanCost) {
                return Gateway.Err("突破需要 " + Convert.ToString(yuanCost) + " 元宝");
            }
            if (ironCost > 0) {
                ZanWeb.Model.Game.Item iron = Fight.ByName("黑铁矿石");
                if (iron == null) { return Gateway.Err("黑铁矿石不存在"); }
                if (!Fight.BagTake(s, iron.id, (int)ironCost)) {
                    return Gateway.Err("背包里没有 "
                        + Convert.ToString(ironCost) + " 个黑铁矿石");
                }
            }
            s.row.gems = s.row.gems - yuanCost;
            xp[id] = xp[id] - need;
            ranks[id] = ranks[id] + 1;
            s.row.wuxing = ranks[0] + ranks[1] + ranks[2] + ranks[3] + ranks[4];
            s.dirty = true;
        }
        s.row.wuxingRanks = Play.WxJoin(ranks);
        s.row.wuxingXp = Play.WxJoinL(xp);
        r.Set("wuxing", Play.WuxingState(s, ranks, xp));
        Gateway.SelfInto(r, s);
        return r;
    }

    /* 打怪入池：Fight.OnKill 按 element_xp_per_second 调用（Play.WxGain）。 */
    static void WxGain(Session s) {
        long cap = Rules.Long("element_pool_cap");
        long step = Rules.Long("element_xp_per_second");
        if (s.row.wuxingPool + step > cap) { step = cap - s.row.wuxingPool; }
        if (step > 0) {
            s.row.wuxingPool = s.row.wuxingPool + step;
            s.dirty = true;
        }
    }

    /* 祭坛增益是否生效（Fight.OnKill 经验/金币按 altar_buff_mult_pct 放大）。 */
    static bool AltarBuffed(Session s) {
        return s.row.altarBuffUntil > WebApp.NowSeconds();
    }

    static int[] WxParse(string csv) {
        int[] v = new int[] { 0, 0, 0, 0, 0 };
        if (csv == null || csv.Length == 0) { return v; }
        List<string> parts = csv.Split(',');
        for (int i = 0; i < 5 && i < parts.Count; i = i + 1) {
            v[i] = Convert.ToInt(parts[i].Trim());
        }
        return v;
    }

    static long[] WxParseL(string csv) {
        long[] v = new long[] { 0, 0, 0, 0, 0 };
        if (csv == null || csv.Length == 0) { return v; }
        List<string> parts = csv.Split(',');
        for (int i = 0; i < 5 && i < parts.Count; i = i + 1) {
            v[i] = Convert.ToInt64(parts[i].Trim());
        }
        return v;
    }

    static string WxJoin(int[] v) {
        string t = "";
        for (int i = 0; i < 5; i = i + 1) {
            t = t + (i > 0 ? "," : "") + Convert.ToString(v[i]);
        }
        return t;
    }

    static string WxJoinL(long[] v) {
        string t = "";
        for (int i = 0; i < 5; i = i + 1) {
            t = t + (i > 0 ? "," : "") + Convert.ToString(v[i]);
        }
        return t;
    }

    static JsonValue WuxingState(Session s, int[] ranks, long[] xp) {
        long pool = s.row.wuxingPool;
        long poolCap = Rules.Val("element_pool_cap");
        List<WuxingRowModel> rows = new List<WuxingRowModel>();
        for (int i = 0; i < 5; i = i + 1) {
            ZanWeb.RuleRow el = Rules.Elements().At(i);
            int itemId = 491 + i;
            long need = el.Int("xp_base") + el.Int("xp_step") * ranks[i];
            int cap = el.Int("max_level");
            rows.Add(new WuxingRowModel(i, el.Text("name"), ranks[i], xp[i], need, cap, itemId));
        }
        WuxingStateModel model = new WuxingStateModel(pool, poolCap, rows);
        return model.ToJson();
    }

    /* mentor 师徒：{"master":"名"}=拜师（徒弟 ≤ mentor_apprentice_max_level、
       师傅等级更高且转数 ≥ mentor_master_rebirth、门下弟子未满）；
       {"take":1}=出师（等级 ≥ mentor_take_level）：徒弟得
       mentor_take_gold/mentor_take_xp，师傅得 mentor_take_reputation 声望
       （在线走内存，离线直接落库）。 */
    static async JsonValue Mentor(Session s, JsonValue m, long now) {
        /* masterName 老库可能为 NULL（SelfJson 同款判空）：Length 直探
           会打崩整个 op，先归一成空串再走业务。 */
        if (s.row.masterName == null) { s.row.masterName = ""; }
        if (m.Str("master", "").Length > 0) {
            string name = m.Str("master", "").Trim();
            if (s.row.masterName.Length > 0) {
                return Gateway.Err("你已有师父：" + s.row.masterName);
            }
            if (name == s.row.nickname) { return Gateway.Err("不能拜自己为师"); }
            if (s.row.level > Rules.Val("mentor_apprentice_max_level")) {
                return Gateway.Err("拜师需不超过 "
                    + Convert.ToString(Rules.Val("mentor_apprentice_max_level")) + " 级");
            }
            IDbConnection db = await Gateway.Db();
            if (db == null) { return Gateway.Err("数据库不可用，请稍后再试"); }
            try {
                ZanWeb.Model.Game.Player master = await db
                    .Select<ZanWeb.Model.Game.Player>()
                    .Where(a => a.nickname == name && a.realmId == s.realmId)
                    .FirstAsync();
                if (master == null) { return Gateway.Err("本区没有这位玩家"); }
                if (master.level <= s.row.level) {
                    return Gateway.Err("对方等级不比你高，不能拜师");
                }
                int apprentices = await db.Select<ZanWeb.Model.Game.Player>()
                    .Where(a => a.masterName == master.nickname
                        && a.realmId == s.realmId).CountAsync();
                if (apprentices >= Rules.Val("mentor_max_apprentices")) {
                    return Gateway.Err("对方门下弟子已满");
                }
                s.row.masterName = name;
                s.dirty = true;
            } finally {
                Gateway.Give(db);
            }
        }
        if (m.Int("take", 0) == 1) {
            if (s.row.masterName.Length == 0) { return Gateway.Err("你还没有师父"); }
            int takeLevel = Rules.Val("mentor_take_level");
            if (s.row.level < takeLevel) {
                return Gateway.Err("出师需 " + Convert.ToString(takeLevel) + " 级");
            }
            IDbConnection db = await Gateway.Db();
            if (db == null) { return Gateway.Err("数据库不可用，请稍后再试"); }
            try {
                string masterName = s.row.masterName;
                s.row.masterName = "";
                s.row.gold = s.row.gold + Rules.Long("mentor_take_gold");
                s.row.exp = s.row.exp + Rules.Long("mentor_take_xp");
                s.dirty = true;
                ZanWeb.Model.Game.Player master = await db
                    .Select<ZanWeb.Model.Game.Player>()
                    .Where(a => a.nickname == masterName && a.realmId == s.realmId)
                    .FirstAsync();
                if (master != null) {
                    Session online = World.ByChar(master.id);
                    if (online != null) {
                        online.row.reputation = online.row.reputation
                            + Rules.Long("mentor_take_reputation");
                        online.dirty = true;
                    } else {
                        int _u = await db.Update<ZanWeb.Model.Game.Player>()
                            .SetIncr(a => a.reputation,
                                Rules.Long("mentor_take_reputation"))
                            .Where(a => a.id == master.id)
                            .ExecuteAffrowsAsync();
                    }
                }
            } finally {
                Gateway.Give(db);
            }
        }
        JsonValue r = Gateway.Ok();
        JsonValue o = JsonValue.NewObject();
        o.Set("master", JsonValue.NewStr(s.row.masterName));
        o.Set("canTake", JsonValue.NewNum(
            s.row.masterName.Length > 0
                && s.row.level >= Rules.Val("mentor_take_level") ? "1" : "0"));
        /* 结伴榜：本区门徒数前 10 的师父（师徒页右栏名单的数据通道）。
           masterName 聚合线性扫（在线人数小），名次选择同爵位榜。
           挂在 mentor 对象里下发——客户端缓存的就是这个对象。 */
        JsonValue mates = JsonValue.NewArray();
        IDbConnection dbM = await Gateway.Db();
        if (dbM != null) {
            try {
                List<ZanWeb.Model.Game.Player> apps = await dbM
                    .Select<ZanWeb.Model.Game.Player>()
                    .Where(a => a.realmId == s.realmId && a.masterName != "")
                    .ToListAsync();
                List<MentorMateEntry> mateEntries = new List<MentorMateEntry>();
                for (int i = 0; i < apps.Count; i = i + 1) {
                    string mn = apps[i].masterName != null ? apps[i].masterName : "";
                    if (mn.Length == 0) { continue; }
                    int at = -1;
                    for (int k = 0; k < mateEntries.Count; k = k + 1) {
                        if (mateEntries[k].name == mn) { at = k; break; }
                    }
                    if (at < 0) {
                        mateEntries.Add(new MentorMateEntry(mn, 1, 0));
                    } else {
                        mateEntries[at].count = mateEntries[at].count + 1;
                    }
                }
                for (int k = 0; k < mateEntries.Count; k = k + 1) {
                    ZanWeb.Model.Game.Player mm = await dbM
                        .Select<ZanWeb.Model.Game.Player>()
                        .Where(a => a.nickname == mateEntries[k].name && a.realmId == s.realmId)
                        .FirstAsync();
                    mateEntries[k].level = mm != null ? mm.level : 0;
                }
                for (int rank = 0; rank < 10 && mateEntries.Count > 0; rank = rank + 1) {
                    int best = 0;
                    for (int k = 1; k < mateEntries.Count; k = k + 1) {
                        if (mateEntries[k].count > mateEntries[best].count) { best = k; }
                    }
                    JsonValue mo = JsonValue.NewObject();
                    mo.Set("name", JsonValue.NewStr(mateEntries[best].name));
                    mo.Set("level", JsonValue.NewNum(Convert.ToString(mateEntries[best].level)));
                    mo.Set("cnt", JsonValue.NewNum(Convert.ToString(mateEntries[best].count)));
                    mates.Append(mo);
                    mateEntries.RemoveAt(best);
                }
            } finally {
                Gateway.Give(dbM);
            }
        }
        o.Set("mates", mates);
        r.Set("mentor", o);
        Gateway.SelfInto(r, s);
        return r;
    }

    /* altar 祭坛：{"do":"gold"|"yuan"|"large"|"iron"} 捐献（费用/点数/
       次数全读 balance.csv）；{"do":"claim"} 领个人奖励（金币+元宝+声望）。
       捐献+Buff 到期前打怪按 altar_buff_mult_pct 放大（Fight.OnKill）。 */
    static JsonValue Altar(Session s, JsonValue m, long now) {
        Play.DailyReset(s, now);
        string act = m.Str("do", "");
        if (act.Length > 0 && act != "claim") {
            long points = 0;
            if (act == "gold") {
                long cost = Rules.Long("altar_gold_cost");
                if (s.row.gold < cost) { return Gateway.Err("金币不够"); }
                s.row.gold = s.row.gold - cost;
                points = Rules.Val("altar_gold_gain");
            } else if (act == "yuan") {
                long cost = Rules.Long("altar_yuan_cost");
                if (s.row.gems < cost) { return Gateway.Err("元宝不够"); }
                s.row.gems = s.row.gems - cost;
                points = Rules.Val("altar_yuan_gain");
            } else if (act == "large") {
                long cost = Rules.Long("altar_yuan_large_cost");
                if (s.row.gems < cost) { return Gateway.Err("元宝不够"); }
                s.row.gems = s.row.gems - cost;
                points = Rules.Val("altar_yuan_large_gain");
            } else if (act == "iron") {
                long cost = Rules.Long("altar_iron_cost");
                ZanWeb.Model.Game.Item iron = Fight.ByName("黑铁矿石");
                if (iron == null) { return Gateway.Err("黑铁矿石不存在"); }
                if (!Fight.BagTake(s, iron.id, (int)cost)) {
                    return Gateway.Err("背包里没有 " + Convert.ToString(cost)
                        + " 个黑铁矿石");
                }
                points = Rules.Val("altar_iron_gain");
            } else {
                return Gateway.Err("未知捐献类型");
            }
            s.row.altarPersonal = s.row.altarPersonal + points;
            s.row.altarDonations = s.row.altarDonations + 1;
            s.row.altarBuffUntil = now + Rules.Val("altar_buff_seconds");
            /* 全服祭坛进度走 world_state（重启不丢），原版「祭坛进度」行。 */
            WorldState.SetNum("altar.global",
                WorldState.GetNum("altar.global", 0) + points);
            s.dirty = true;
        }
        if (act == "claim") {
            long cap = Rules.Long("altar_personal_cap");
            if (s.row.altarPersonal < cap) {
                return Gateway.Err("个人进度未到领取线（" + Convert.ToString(cap) + "）");
            }
            s.row.altarPersonal = s.row.altarPersonal - cap;
            s.row.gold = s.row.gold + Rules.Long("altar_personal_reward_gold");
            s.row.gems = s.row.gems + Rules.Long("altar_personal_reward_yuan");
            s.row.reputation = s.row.reputation
                + Rules.Long("altar_personal_reward_reputation");
            s.dirty = true;
        }
        JsonValue r = Gateway.Ok();
        JsonValue o = JsonValue.NewObject();
        o.Set("personal", JsonValue.NewNum(Convert.ToString(s.row.altarPersonal)));
        o.Set("cap", JsonValue.NewNum(Convert.ToString(
            Rules.Val("altar_personal_cap"))));
        /* 全服祭坛进度（捐献累加，写穿 world_state）。 */
        o.Set("global", JsonValue.NewNum(Convert.ToString(
            WorldState.GetNum("altar.global", 0))));
        o.Set("globalCap", JsonValue.NewNum(Convert.ToString(
            Rules.Val("altar_world_cap"))));
        o.Set("donations", JsonValue.NewNum(Convert.ToString(s.row.altarDonations)));
        long buffLeft = s.row.altarBuffUntil - now;
        o.Set("buff", JsonValue.NewNum(Convert.ToString(buffLeft > 0 ? buffLeft : 0)));
        r.Set("altar", o);
        Gateway.SelfInto(r, s);
        return r;
    }

    /* stars 将星图谱：全部 BOSS 清单（boss 名与图行同源），带点亮状态
       （该图 BOSS 已被本角色击败过，BossFight 胜利时点亮）。BOSS 图
       35 张，long 位图按 bit=mapId-1 装。 */
    static JsonValue Stars(Session s, long now) {
        List<StarRowModel> rows = new List<StarRowModel>();
        for (int i = 0; i < Fight.mobs.Count; i = i + 1) {
            ZanWeb.Model.Game.Mob t = Fight.mobs[i];
            if (t == null || t.count != 1 || t.status != 1) { continue; }
            long bit = (long)1 << (t.mapId - 1);
            bool lit = (s.row.starsLit & bit) != 0;
            rows.Add(new StarRowModel(t.name, t.level, t.mapId, lit));
        }
        StarStateModel model = new StarStateModel(rows);
        JsonValue r = Gateway.Ok();
        r.Set("rows", model.ToJson());
        return r;
    }

    /* BossFight 胜利后点亮图谱位（Fight 调用）。 */
    static void LightStar(Session s, int mapId) {
        long bit = (long)1 << (mapId - 1);
        if ((s.row.starsLit & bit) == 0) {
            s.row.starsLit = s.row.starsLit | bit;
            s.dirty = true;
        }
    }

    /* redpack 发红包：{"send":N} 发一个全服元宝红包（N 在
       redpack_min_yuan/max_yuan 之间）；{"grab":1} 抢一次（每红包每人
       一次，抢到 pool×redpack_share_pct）。池子/发送人/已抢名单走
       WorldState（写穿 game_world，重启恢复）。 */
    static long RpPool() { return WorldState.GetNum("redpack.pool", 0); }
    static bool RpTakenHas(string name) {
        string csv = WorldState.Get("redpack.taken", "");
        if (csv.Length == 0) { return false; }
        List<string> parts = csv.Split(",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (parts[i] == name) { return true; }
        }
        return false;
    }
    static void RpTakenAdd(string name) {
        string csv = WorldState.Get("redpack.taken", "");
        WorldState.Set("redpack.taken", csv.Length == 0 ? name : csv + "," + name);
    }

    static JsonValue Redpack(Session s, JsonValue m, long now) {
        if (m.Int("send", 0) > 0) {
            long amount = m.Int("send", 0);
            if (amount < Rules.Val("redpack_min_yuan")
                    || amount > Rules.Val("redpack_max_yuan")) {
                return Gateway.Err("红包金额需 " + Convert.ToString(Rules.Val("redpack_min_yuan"))
                    + "-" + Convert.ToString(Rules.Val("redpack_max_yuan")) + " 元宝");
            }
            if (s.row.gems < amount) { return Gateway.Err("元宝不够"); }
            s.row.gems = s.row.gems - amount;
            WorldState.SetNum("redpack.pool", Play.RpPool() + amount);
            WorldState.Set("redpack.from", s.row.nickname);
            WorldState.Set("redpack.taken", "");
            s.dirty = true;
            Gateway.AnnounceAll("红包雨",
                s.row.nickname + " 发出 " + Convert.ToString(amount)
                + " 元宝红包，全服可抢！");
        }
        JsonValue r = Gateway.Ok();
        JsonValue o = JsonValue.NewObject();
        o.Set("pool", JsonValue.NewNum(Convert.ToString(Play.RpPool())));
        o.Set("from", JsonValue.NewStr(WorldState.Get("redpack.from", "")));
        if (m.Int("grab", 0) == 1) {
            if (Play.RpPool() <= 0) { return Gateway.Err("红包已抢完"); }
            if (Play.RpTakenHas(s.row.nickname)) {
                return Gateway.Err("你已经抢过这个红包了");
            }
            long grab = Play.RpPool() * Rules.Val("redpack_share_pct") / 100;
            if (grab < 1) { grab = 1; }
            if (grab > Play.RpPool()) { grab = Play.RpPool(); }
            WorldState.SetNum("redpack.pool", Play.RpPool() - grab);
            Play.RpTakenAdd(s.row.nickname);
            s.row.gems = s.row.gems + grab;
            s.dirty = true;
            o.Set("grab", JsonValue.NewNum(Convert.ToString(grab)));
        }
        o.Set("taken", JsonValue.NewNum(Play.RpTakenHas(s.row.nickname)
            ? "1" : "0"));
        r.Set("redpack", o);
        Gateway.SelfInto(r, s);
        return r;
    }

    /* market 交易市场：{}=列表；{"sellItem":id,"count":N,"price":P}=上架
       （价格 ≥ market_min_price）；{"buy":rowId}=购买；{"cancel":rowId}
       =下架。购买走条件更新抢占（sellerId 原值改写为买家，RULES.md §五：
       修旧服「同一挂单被两人同时买走」的双花），手续费 market_fee_pct。 */
    static async JsonValue Market(Session s, JsonValue m) {
        IDbConnection db = await Gateway.Db();
        if (db == null) { return Gateway.Err("数据库不可用，请稍后再试"); }
        try {
            if (m.Int("sellItem", 0) > 0) {
                int itemId = m.Int("sellItem", 0);
                int count = m.Int("count", 1);
                long price = m.Int("price", 0);
                if (count < 1) { count = 1; }
                if (price < Rules.Val("market_min_price")) {
                    return Gateway.Err("价格需不低于 "
                        + Convert.ToString(Rules.Val("market_min_price")));
                }
                if (!Fight.BagTake(s, itemId, count)) {
                    return Gateway.Err("背包里数量不够");
                }
                ZanWeb.Model.Game.Market row = new ZanWeb.Model.Game.Market();
                row.sellerId = s.row.id;
                row.sellerName = s.row.nickname;
                row.itemId = itemId;
                row.count = count;
                row.price = price;
                row.createdAt = WebApp.NowSeconds();
                int _id = await db.Insert<ZanWeb.Model.Game.Market>(row)
                    .ExecuteIdentityAsync();
                s.dirty = true;
            }
            if (m.Int("buy", 0) > 0) {
                int buyId = m.Int("buy", 0);
                /* 只读在售单（sellerId>0；买断会把 sellerId 改成负的
                   「已售」标记）。顺序双买的第二个买家在这里就拿到 null。 */
                ZanWeb.Model.Game.Market row = await db
                    .Select<ZanWeb.Model.Game.Market>()
                    .Where(a => a.id == buyId && a.sellerId > 0).FirstAsync();
                if (row == null) { return Gateway.Err("这件商品已售出或下架"); }
                if (row.sellerId == s.row.id) { return Gateway.Err("不能买自己的挂单"); }
                if (s.row.gold < row.price) { return Gateway.Err("金币不够"); }
                /* 抢占：sellerId 从原卖家改成负值，只有还能改走的那个
                   请求买断成功；并发的第二个请求 affected=0 → 明确报
                   「刚被别人买走」。改成正的买家 id 挡不住顺序双买
                   （第二次 select 会把它当「新卖家」再卖一遍）。 */
                int claimed = await db.Update<ZanWeb.Model.Game.Market>()
                    .Set(a => a.sellerId, -row.sellerId)
                    .Where(a => a.id == row.id && a.sellerId == row.sellerId)
                    .ExecuteAffrowsAsync();
                if (claimed <= 0) { return Gateway.Err("这件商品刚被别人买走"); }
                s.row.gold = s.row.gold - row.price;
                Fight.BagAdd(s, row.itemId, row.count);
                s.dirty = true;
                /* 卖家得价扣手续费；离线也成立：直接记他角色行。 */
                long payout = row.price * (100 - Rules.Val("market_fee_pct")) / 100;
                ZanWeb.Model.Game.Player seller = await db
                    .Select<ZanWeb.Model.Game.Player>()
                    .Where(a => a.id == row.sellerId).FirstAsync();
                if (seller != null) {
                    Session online = World.ByChar(seller.id);
                    if (online != null) {
                        online.row.gold = online.row.gold + payout;
                        online.dirty = true;
                    } else {
                        int _u = await db.Update<ZanWeb.Model.Game.Player>()
                            .SetIncr(a => a.gold, payout)
                            .Where(a => a.id == seller.id)
                            .ExecuteAffrowsAsync();
                    }
                }
                int _d = await db.Delete<ZanWeb.Model.Game.Market>()
                    .Where(a => a.id == row.id).ExecuteAffrowsAsync();
            }
            if (m.Int("cancel", 0) > 0) {
                ZanWeb.Model.Game.Market row = await db
                    .Select<ZanWeb.Model.Game.Market>()
                    .Where(a => a.id == m.Int("cancel", 0)).FirstAsync();
                if (row == null || row.sellerId != s.row.id) {
                    return Gateway.Err("只能下架自己的挂单");
                }
                Fight.BagAdd(s, row.itemId, row.count);
                s.dirty = true;
                await db.Delete<ZanWeb.Model.Game.Market>()
                    .Where(a => a.id == row.id).ExecuteAffrowsAsync();
            }
            List<ZanWeb.Model.Game.Market> rows = await db
                .Select<ZanWeb.Model.Game.Market>()
                .Where(a => a.sellerId > 0)
                .OrderBy(a => a.id).ToListAsync();
            JsonValue arr = JsonValue.NewArray();
            for (int i = 0; i < rows.Count; i = i + 1) {
                ZanWeb.Model.Game.Market row = rows[i];
                ZanWeb.Model.Game.Item it = Fight.ById(row.itemId);
                JsonValue o = JsonValue.NewObject();
                o.Set("id", JsonValue.NewNum(Convert.ToString(row.id)));
                /* 记录格取图与挂龄显示都要原始数据：itemId + 已挂秒数。 */
                o.Set("itemId", JsonValue.NewNum(Convert.ToString(row.itemId)));
                o.Set("age", JsonValue.NewNum(Convert.ToString(
                    WebApp.NowSeconds() - row.createdAt)));
                o.Set("seller", JsonValue.NewStr(row.sellerName));
                o.Set("name", JsonValue.NewStr(it != null ? it.name : "???"));
                o.Set("count", JsonValue.NewNum(Convert.ToString(row.count)));
                o.Set("price", JsonValue.NewNum(Convert.ToString(row.price)));
                o.Set("mine", JsonValue.NewNum(row.sellerId == s.row.id ? "1" : "0"));
                arr.Append(o);
            }
            JsonValue r = Gateway.Ok();
            r.Set("rows", arr);
            Gateway.SelfInto(r, s);
            return r;
        } finally {
            Gateway.Give(db);
        }
    }

    /* codex 图鉴明细：kind=items/mobs，page 从 0，每页 codex_page_size。 */
    static JsonValue CodexPage(JsonValue m) {
        string kind = m.Str("kind", "items");
        int page = m.Int("page", 0);
        if (page < 0) { page = 0; }
        int per = Rules.Val("codex_page_size");
        JsonValue arr = JsonValue.NewArray();
        if (kind == "mobs") {
            int total = Fight.mobs.Count;
            int from = page * per;
            for (int i = from; i < total && i < from + per; i = i + 1) {
                ZanWeb.Model.Game.Mob t = Fight.mobs[i];
                JsonValue o = JsonValue.NewObject();
                o.Set("name", JsonValue.NewStr(t.name));
                o.Set("level", JsonValue.NewNum(Convert.ToString(t.level)));
                o.Set("hp", JsonValue.NewNum(Convert.ToString(t.hp)));
                o.Set("atk", JsonValue.NewNum(Convert.ToString(t.atk)));
                o.Set("def", JsonValue.NewNum(Convert.ToString(t.def)));
                o.Set("map", JsonValue.NewNum(Convert.ToString(t.mapId)));
                o.Set("boss", JsonValue.NewNum(t.count == 1 ? "1" : "0"));
                o.Set("exp", JsonValue.NewNum(Convert.ToString(t.exp)));
                arr.Append(o);
            }
            JsonValue r = Gateway.Ok();
            r.Set("rows", arr);
            r.Set("total", JsonValue.NewNum(Convert.ToString(total)));
            r.Set("page", JsonValue.NewNum(Convert.ToString(page)));
            return r;
        }
        int total2 = Fight.items.Count;
        int from2 = page * per;
        for (int i = from2; i < total2 && i < from2 + per; i = i + 1) {
            ZanWeb.Model.Game.Item it = Fight.items[i];
            JsonValue o = JsonValue.NewObject();
            o.Set("name", JsonValue.NewStr(it.name));
            o.Set("kind", JsonValue.NewNum(Convert.ToString(it.kind)));
            o.Set("slot", JsonValue.NewNum(Convert.ToString(it.slot)));
            o.Set("atk", JsonValue.NewNum(Convert.ToString(it.atk)));
            o.Set("def", JsonValue.NewNum(Convert.ToString(it.def)));
            o.Set("heal", JsonValue.NewNum(Convert.ToString(it.hp)));
            o.Set("price", JsonValue.NewNum(Convert.ToString(it.price)));
            o.Set("minLevel", JsonValue.NewNum(Convert.ToString(it.minLevel)));
            o.Set("picture", JsonValue.NewNum(Convert.ToString(it.picture)));
            arr.Append(o);
        }
        JsonValue r2 = Gateway.Ok();
        r2.Set("rows", arr);
        r2.Set("total", JsonValue.NewNum(Convert.ToString(total2)));
        r2.Set("page", JsonValue.NewNum(Convert.ToString(page)));
        return r2;
    }

    /* ---- 称谓：原版事实表 GameTitle（data/M2.DB，251 行，只读）---- */

    static List<TitleDef> titleDefs;
    static bool titleTried;

    /* GameTitle 只读快照：种子库是纯数据文件，通过连接池异步借出，使用 TitleDefDao 强类型映射装配。 */
    static async bool LoadTitles() {
        if (Play.titleTried) { return Play.titleDefs != null && Play.titleDefs.Count > 0; }
        Play.titleTried = true;
        DbPool pool = SqliteConnector.Pool("data/M2.DB", 1);
        IDbConnection db = await pool.AcquireAsync();
        if (db == null) { return false; }
        try {
            Play.titleDefs = await new TitleDefDao(db).All();
        } finally {
            pool.Release(db);
        }
        return Play.titleDefs != null && Play.titleDefs.Count > 0;
    }

    static TitleDef TitleByName(string name) {
        if (Play.titleDefs == null) { return null; }
        for (int i = 0; i < Play.titleDefs.Count; i = i + 1) {
            if (Play.titleDefs[i].name == name) { return Play.titleDefs[i]; }
        }
        return null;
    }

    static List<int> TitleIds(string csv) {
        List<int> v = new List<int>();
        if (csv == null || csv.Length == 0) { return v; }
        List<string> parts = csv.Split(',');
        for (int i = 0; i < parts.Count; i = i + 1) {
            string t = parts[i].Trim();
            if (t.Length > 0) { v.Add(Convert.ToInt(t)); }
        }
        return v;
    }

    static bool TitleOwned(string csv, int id) {
        List<int> v = Play.TitleIds(csv);
        return v.Contains(id);
    }

    static string TitleIdsJoin(List<int> v) {
        string t = "";
        for (int i = 0; i < v.Count; i = i + 1) {
            t = t + (i > 0 ? "," : "") + Convert.ToString(v[i]);
        }
        return t;
    }

    /* title 称谓：{}=面板（12 行/页，原版称谓表分页）；{"page":N}=翻页；
       {"unlock":"名"}=解锁（声望 rep×title_unlock_rep_pct% + 金币 money，
       RULES.md 裁决 #8）；{"wear":"名"}=佩戴（"无"=摘下）。
       rows 字段与客户端 TitleRow 同构：fame/gold/rebirth/level/atk…mdef。 */
    static async JsonValue Title(Session s, JsonValue m) {
        if (!await Play.LoadTitles()) {
            return Gateway.Err("称谓数据未就绪");
        }
        if (m.Str("unlock", "").Length > 0) {
            string want = m.Str("unlock", "").Trim();
            TitleDef def = Play.TitleByName(want);
            if (def == null) { return Gateway.Err("没有这个称谓"); }
            if (!Play.TitleOwned(s.row.titlesUnlocked, def.id)) {
                long repCost = def.rep * Rules.Val("title_unlock_rep_pct") / 100;
                long goldCost = def.money;
                if (s.row.reputation < repCost) {
                    return Gateway.Err("声望不够（需 " + Convert.ToString(repCost) + "）");
                }
                if (s.row.gold < goldCost) {
                    return Gateway.Err("金币不够（需 " + Convert.ToString(goldCost) + "）");
                }
                s.row.reputation = s.row.reputation - repCost;
                s.row.gold = s.row.gold - goldCost;
                List<int> owned = Play.TitleIds(s.row.titlesUnlocked);
                owned.Add(def.id);
                s.row.titlesUnlocked = Play.TitleIdsJoin(owned);
                s.dirty = true;
            }
        }
        if (m.Str("wear", "").Length > 0) {
            string want = m.Str("wear", "").Trim();
            if (want == "无") { want = ""; }
            if (want.Length > 0) {
                TitleDef def = Play.TitleByName(want);
                if (def == null || !Play.TitleOwned(s.row.titlesUnlocked, def.id)) {
                    return Gateway.Err("先解锁这个称谓");
                }
            }
            s.row.title = want;
            s.dirty = true;
        }
        int per = Rules.Val("title_page_size");
        int page = m.Int("page", 0);
        if (page < 0) { page = 0; }
        int total = Play.titleDefs.Count;
        int pages = (total + per - 1) / per;
        if (page >= pages && pages > 0) { page = pages - 1; }
        List<TitleItemModel> titles = new List<TitleItemModel>();
        int from = page * per;
        for (int i = from; i < total && i < from + per; i = i + 1) {
            TitleDef t = Play.titleDefs[i];
            bool owned = Play.TitleOwned(s.row.titlesUnlocked, t.id);
            bool worn = s.row.title != null && s.row.title == t.name;
            titles.Add(new TitleItemModel(
                t.id, t.name, t.rep, t.money, t.met, t.lvl,
                t.a1, t.a2, t.b1, t.b2, t.c1, t.c2, t.d1, t.d2, t.e1, t.e2,
                owned, worn
            ));
        }
        TitleStateModel model = new TitleStateModel(page, pages, total, s.row.merit, s.row.reputation, titles);
        JsonValue r = Gateway.Ok();
        model.IntoJson(r);
        Gateway.SelfInto(r, s);
        return r;
    }

    /* ---- 成就 / 爵位 / 邮箱 / 至尊殿堂（客户端 26/24/29/19 页）----
       成就表是服务器事实（等级/转生里程碑，奖励按原版行配）；爵位按
       累计贡献（元宝 1:1）分四档；邮箱独立表 game_mail，建角发开区礼
       包信；至尊殿堂按八格收服全服最好装备（world_state 写穿），登记
       者获得打怪经验加成。数值全部走 balance.csv 键。 */

    /* 成就一行定义：奖励的物品按**名字**对目录（启动种子来自 M2.DB，
       同名同物），发奖时 BagAdd；金币/元宝/经验直入角色行。kind
       0=等级里程碑，1=转生里程碑（本版还没有转生状态，资格恒未满足，
       行照发——客户端页面照原版 8 行显示）。 */
    class AchDef {
        string name;
        string req;
        int kind;
        int need;
        long gold;
        long gems;
        long exp;
        string i1; long c1;
        string i2; long c2;
        string i3; long c3;
    }

    static List<AchDef> achDefs = null;
    static List<AchDef> AchDefs() {
        if (achDefs != null) { return achDefs; }
        List<AchDef> v = new List<AchDef>();
        v.Add(Play.AchRow("10级奖励", "等级达到10级", 0, 10, 100000, 0, 0,
            "", 0, "", 0, "", 0));
        v.Add(Play.AchRow("20级奖励", "等级达到20级", 0, 20, 200000, 0, 0,
            "黑铁矿石", 5, "", 0, "", 0));
        v.Add(Play.AchRow("30级奖励", "等级达到30级", 0, 30, 0, 0, 0,
            "黑铁矿石", 100, "BOSS卷轴", 100, "", 0));
        v.Add(Play.AchRow("40级奖励", "等级达到40级", 0, 40, 0, 1000, 0,
            "书籍包", 1000, "黑铁矿石", 100, "", 0));
        v.Add(Play.AchRow("50级奖励", "等级达到50级", 0, 50, 0, 0, 0,
            "天书", 200, "BOSS卷轴", 100, "书籍包", 1000));
        v.Add(Play.AchRow("60级奖励", "等级达到60级", 0, 60, 2000000, 0, 2000000,
            "书籍包", 5000, "黑铁矿石", 200, "", 0));
        v.Add(Play.AchRow("1转奖励", "转生达到1转", 1, 1, 1000000, 0, 0,
            "幸运雪莲", 1, "书籍包", 10000, "天书", 2000));
        v.Add(Play.AchRow("2转奖励", "转生达到2转", 1, 2, 5000000, 0, 0,
            "幸运雪莲", 2, "书籍包", 30000, "天书", 10000));
        achDefs = v;
        return v;
    }

    static AchDef AchRow(string name, string req, int kind, int need,
                         long gold, long gems, long exp,
                         string i1, long c1, string i2, long c2,
                         string i3, long c3) {
        AchDef d = new AchDef();
        d.name = name; d.req = req; d.kind = kind; d.need = need;
        d.gold = gold; d.gems = gems; d.exp = exp;
        d.i1 = i1; d.c1 = c1; d.i2 = i2; d.c2 = c2;
        d.i3 = i3; d.c3 = c3;
        return d;
    }

    static bool AchOwned(string csv, int no) {
        List<int> v = Play.CsvIds(csv);
        return v.Contains(no);
    }

    /* "1,2,3" → 整数列表（空串=空表）。 */
    static List<int> CsvIds(string csv) {
        List<int> v = new List<int>();
        if (csv == null) { return v; }
        List<string> parts = csv.Split(",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string t = parts[i].Trim();
            if (t.Length > 0) { v.Add(Convert.ToInt(t)); }
        }
        return v;
    }

    static string AchIdsJoin(List<int> v) {
        string t = "";
        for (int i = 0; i < v.Count; i = i + 1) {
            t = t + (i > 0 ? "," : "") + Convert.ToString(v[i]);
        }
        return t;
    }

    static bool AchEligible(Session s, AchDef d) {
        if (d.kind == 1) { return false; }   // 转生未开放，里程碑行照发展示
        return s.row.level >= d.need;
    }

    /* 奖励角标文案：≥1万 折「N万」，其余原数（原版「10万/200万」同款）。 */
    static string AchBadge(long n) {
        if (n >= 10000) { return Convert.ToString(n / 10000) + "万"; }
        return Convert.ToString(n);
    }

    /* 一枚奖励格：picture（货币用固定图号：金币 116 / 元宝袋 1121 /
       经验 1187，物品用目录 picture）+ 角标原文。 */
    static void AchRewardCell(JsonValue arr, int picture, long count) {
        JsonValue o = JsonValue.NewObject();
        o.Set("pic", JsonValue.NewNum(Convert.ToString(picture)));
        o.Set("badge", JsonValue.NewStr(Play.AchBadge(count)));
        arr.Append(o);
    }

    /* ach：{}=面板（8 行全量）；{"take":行号}=领取（资格+未领过）。
       行字段与客户端 AchRow 同构：name/req/ok/claimed/rewards[{pic,badge}]。 */
    static JsonValue Ach(Session s, JsonValue m, long now) {
        List<AchDef> defs = Play.AchDefs();
        int take = m.Int("take", 0);
        if (take > 0) {
            if (take > defs.Count) { return Gateway.Err("没有这个成就"); }
            AchDef def = defs[take - 1];
            if (Play.AchOwned(s.row.achClaimed, take)) {
                return Gateway.Err("这个成就已领取过");
            }
            if (!Play.AchEligible(s, def)) {
                return Gateway.Err("条件未达成：" + def.req);
            }
            s.row.gold = s.row.gold + def.gold;
            s.row.gems = s.row.gems + def.gems;
            s.row.exp = s.row.exp + def.exp;
            string[] names = new string[] { def.i1, def.i2, def.i3 };
            long[] counts = new long[] { def.c1, def.c2, def.c3 };
            for (int i = 0; i < 3; i = i + 1) {
                if (names[i] == null || names[i].Length == 0) { continue; }
                ZanWeb.Model.Game.Item it = Fight.ByName(names[i]);
                if (it == null) {
                    return Gateway.Err("奖励物品「" + names[i] + "」不在目录，请联系 GM");
                }
                Fight.BagAdd(s, it.id, (int)counts[i]);
            }
            int _ups = Fight.LevelUpApply(s);
            List<int> owned = Play.CsvIds(s.row.achClaimed);
            owned.Add(take);
            s.row.achClaimed = Play.AchIdsJoin(owned);
            s.dirty = true;
        }
        List<AchRowModel> rows = new List<AchRowModel>();
        for (int i = 0; i < defs.Count; i = i + 1) {
            AchDef d = defs[i];
            bool ok = Play.AchEligible(s, d);
            bool claimed = Play.AchOwned(s.row.achClaimed, i + 1);
            List<AchRewardCellModel> rw = new List<AchRewardCellModel>();
            if (d.gold > 0) { rw.Add(new AchRewardCellModel(116, Play.AchBadge(d.gold))); }
            if (d.gems > 0) { rw.Add(new AchRewardCellModel(1121, Play.AchBadge(d.gems))); }
            if (d.exp > 0) { rw.Add(new AchRewardCellModel(1187, Play.AchBadge(d.exp))); }
            string[] names = new string[] { d.i1, d.i2, d.i3 };
            long[] counts = new long[] { d.c1, d.c2, d.c3 };
            for (int k = 0; k < 3; k = k + 1) {
                if (names[k] == null || names[k].Length == 0) { continue; }
                ZanWeb.Model.Game.Item it = Fight.ByName(names[k]);
                if (it == null) { continue; }
                int pic = 0;
                if (it.picture != null && it.picture.Length > 0) {
                    pic = Convert.ToInt(it.picture);
                }
                rw.Add(new AchRewardCellModel(pic, Play.AchBadge(counts[k])));
            }
            rows.Add(new AchRowModel(d.name, d.req, ok, claimed, rw));
        }
        AchStateModel model = new AchStateModel(rows);
        JsonValue r = Gateway.Ok();
        r.Set("rows", model.ToJson());
        Gateway.SelfInto(r, s);
        return r;
    }

    /* 爵位档：累计贡献 ≥lord_tier4/3/2/1 → 亲王/国公/侯爵/伯爵（0..3），
       不足最低档 = 4（无爵位）。加成三组按档查 lord_bonus/speed/exp N 键。 */
    static int LordTier(long contrib) {
        if (contrib >= Rules.Val("lord_tier4")) { return 0; }
        if (contrib >= Rules.Val("lord_tier3")) { return 1; }
        if (contrib >= Rules.Val("lord_tier2")) { return 2; }
        if (contrib >= Rules.Val("lord_tier1")) { return 3; }
        return 4;
    }

    static int LordBonus(int tier, string key) {
        if (tier < 0 || tier > 3) { return 0; }
        /* tier 0 亲王拿最高档 bonus4，tier 3 伯爵拿 bonus1——与客户端
           PageLord.LordTierVal 同一套映射。 */
        return Rules.Val(key + Convert.ToString(4 - tier));
    }

    /* lord：{}=面板（贡献榜 top12 + 我的爵位）；{"donate":N}=捐元宝进
       贡献（1:1）。七项属性加成 = 档位 bonus，速度/经验加成同档取键。 */
    static async JsonValue Lord(Session s, JsonValue m, long now) {
        if (m.Int("donate", 0) > 0) {
            long yuan = m.Int("donate", 0);
            long min = Rules.Val("lord_donate_min");
            if (yuan < min) {
                return Gateway.Err("每次至少捐献 " + Convert.ToString(min) + " 元宝");
            }
            if (s.row.gems < yuan) { return Gateway.Err("元宝不够"); }
            s.row.gems = s.row.gems - yuan;
            s.row.lordContrib = s.row.lordContrib + yuan;
            s.dirty = true;
        }
        List<Play.LordTop> tops = new List<Play.LordTop>();
        IDbConnection db = await Gateway.Db();
        if (db != null) {
            try {
                List<ZanWeb.Model.Game.Player> rows = await db
                    .Select<ZanWeb.Model.Game.Player>()
                    .Where(a => a.realmId == s.row.realmId && a.lordContrib > 0)
                    .ToListAsync();
                /* 捐献只写内存（dirty 待 flush），DB 还是旧值——同一请求
                   内读自己的写：把会话行的贡献度叠加进候选集。 */
                bool selfIn = false;
                for (int i = 0; i < rows.Count; i = i + 1) {
                    if (rows[i].id == s.row.id) {
                        rows[i].lordContrib = s.row.lordContrib;
                        selfIn = true;
                    }
                }
                if (!selfIn && s.row.lordContrib > 0) { rows.Add(s.row); }
                /* 12 名次选择：每轮线性取最大（榜面固定 12，人数小到
                   不值得排序）。 */
                for (int rank = 0; rank < 12 && rows.Count > 0; rank = rank + 1) {
                    int best = 0;
                    for (int i = 1; i < rows.Count; i = i + 1) {
                        if (rows[i].lordContrib > rows[best].lordContrib) { best = i; }
                    }
                    Play.LordTop t = new Play.LordTop();
                    t.name = rows[best].nickname;
                    t.contrib = rows[best].lordContrib;
                    t.tier = Play.LordTier(t.contrib);
                    tops.Add(t);
                    rows.RemoveAt(best);
                }
            } finally {
                Gateway.Give(db);
            }
        }
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < tops.Count; i = i + 1) {
            JsonValue o = JsonValue.NewObject();
            o.Set("name", JsonValue.NewStr(tops[i].name));
            o.Set("contrib", JsonValue.NewNum(Convert.ToString(tops[i].contrib)));
            o.Set("tier", JsonValue.NewNum(Convert.ToString(tops[i].tier)));
            o.Set("self", JsonValue.NewNum(tops[i].name == s.row.nickname ? "1" : "0"));
            arr.Append(o);
        }
        int myTier = Play.LordTier(s.row.lordContrib);
        JsonValue r = Gateway.Ok();
        r.Set("rows", arr);
        JsonValue me = JsonValue.NewObject();
        me.Set("contrib", JsonValue.NewNum(Convert.ToString(s.row.lordContrib)));
        me.Set("tier", JsonValue.NewNum(Convert.ToString(myTier)));
        me.Set("bonus", JsonValue.NewNum(Convert.ToString(Play.LordBonus(myTier, "lord_bonus"))));
        me.Set("speed", JsonValue.NewNum(Convert.ToString(Play.LordBonus(myTier, "lord_speed"))));
        me.Set("exp", JsonValue.NewNum(Convert.ToString(Play.LordBonus(myTier, "lord_exp"))));
        r.Set("me", me);
        Gateway.SelfInto(r, s);
        return r;
    }

    class LordTop {
        string name;
        long contrib;
        int tier;
    }

    /* mail：{}=列表（≤50 封，新信在前）；{"take":id}=提取附件（物品
       入背包、标记已领）；{"del":id}=删信；{"takeall":1}=一键提取全部
       附件；{"clear":1}=清空已领信。items 列是 "itemId:count" 逗号串。 */
    static async JsonValue Mail(Session s, JsonValue m, long now) {
        IDbConnection db = await Gateway.Db();
        if (db == null) { return Gateway.Err("数据库不可用，请稍后再试"); }
        try {
            if (m.Int("take", 0) > 0 || m.Int("takeall", 0) == 1) {
                bool all = m.Int("takeall", 0) == 1;
                int want = m.Int("take", 0);
                List<ZanWeb.Model.Game.Mail> mails = await db
                    .Select<ZanWeb.Model.Game.Mail>()
                    .Where(a => a.playerId == s.row.id && a.claimed == 0)
                    .ToListAsync();
                int granted = 0;
                for (int i = 0; i < mails.Count; i = i + 1) {
                    ZanWeb.Model.Game.Mail row = mails[i];
                    if (!all && row.id != want) { continue; }
                    string itemsCsv = row.items != null ? row.items : "";
                    List<MailAttachmentItem> attachList = MailAttachmentItem.ParseCsv(itemsCsv);
                    for (int k = 0; k < attachList.Count; k = k + 1) {
                        MailAttachmentItem item = attachList[k];
                        Fight.BagAdd(s, item.ItemId, item.Count);
                        granted = granted + 1;
                    }
                    await db.Update<ZanWeb.Model.Game.Mail>()
                        .Set(a => a.claimed, 1)
                        .Where(a => a.id == row.id)
                        .ExecuteAffrowsAsync();
                    s.dirty = true;
                    if (!all) { break; }
                }
                if (!all && granted == 0) {
                    /* 单封提取但没有任何物品：也标记已领，避免重复点。 */
                    ZanWeb.Model.Game.Mail one = await db
                        .Select<ZanWeb.Model.Game.Mail>()
                        .Where(a => a.id == want && a.playerId == s.row.id)
                        .FirstAsync();
                    if (one == null) { return Gateway.Err("没有这封信"); }
                    if (one.claimed == 1) { return Gateway.Err("这封信的附件已提取过"); }
                }
            }
            if (m.Int("del", 0) > 0) {
                int delId = m.Int("del", 0);
                ZanWeb.Model.Game.Mail row = await db
                    .Select<ZanWeb.Model.Game.Mail>()
                    .Where(a => a.id == delId && a.playerId == s.row.id)
                    .FirstAsync();
                if (row == null) { return Gateway.Err("没有这封信"); }
                await db.Delete<ZanWeb.Model.Game.Mail>()
                    .Where(a => a.id == row.id).ExecuteAffrowsAsync();
            }
            if (m.Int("clear", 0) == 1) {
                List<ZanWeb.Model.Game.Mail> claimed = await db
                    .Select<ZanWeb.Model.Game.Mail>()
                    .Where(a => a.playerId == s.row.id && a.claimed == 1)
                    .ToListAsync();
                for (int i = 0; i < claimed.Count; i = i + 1) {
                    await db.Delete<ZanWeb.Model.Game.Mail>()
                        .Where(a => a.id == claimed[i].id).ExecuteAffrowsAsync();
                }
            }
            List<ZanWeb.Model.Game.Mail> rows = await db
                .Select<ZanWeb.Model.Game.Mail>()
                .Where(a => a.playerId == s.row.id)
                .OrderBy(a => a.id).ToListAsync();
            JsonValue arr = JsonValue.NewArray();
            int listed = 0;
            for (int i = rows.Count - 1; i >= 0 && listed < 50; i = i - 1) {
                listed = listed + 1;
                ZanWeb.Model.Game.Mail row = rows[i];
                JsonValue o = JsonValue.NewObject();
                o.Set("id", JsonValue.NewNum(Convert.ToString(row.id)));
                o.Set("title", JsonValue.NewStr(row.title));
                o.Set("sender", JsonValue.NewStr(row.sender));
                o.Set("claimed", JsonValue.NewNum(Convert.ToString(row.claimed)));
                DateTime dt = DateTime.FromUnixSeconds(row.createdAt);
                o.Set("date", JsonValue.NewStr(Play.Today(row.createdAt)
                    + " " + (dt.hour < 10 ? "0" : "") + Convert.ToString(dt.hour)
                    + ":" + (dt.minute < 10 ? "0" : "") + Convert.ToString(dt.minute)));
                o.Set("body", JsonValue.NewStr(row.body != null ? row.body : ""));
                JsonValue its = JsonValue.NewArray();
                string itemsCsv = row.items != null ? row.items : "";
                List<string> parts = itemsCsv.Split(",");
                for (int k = 0; k < parts.Count; k = k + 1) {
                    string p = parts[k].Trim();
                    if (p.Length == 0) { continue; }
                    List<string> kv = p.Split(":");
                    if (kv.Count != 2) { continue; }
                    ZanWeb.Model.Game.Item it = Fight.ById(Convert.ToInt(kv[0].Trim()));
                    if (it == null) { continue; }
                    int pic = 0;
                    if (it.picture != null && it.picture.Length > 0) {
                        pic = Convert.ToInt(it.picture);
                    }
                    JsonValue w = JsonValue.NewObject();
                    w.Set("pic", JsonValue.NewNum(Convert.ToString(pic)));
                    w.Set("count", JsonValue.NewNum(kv[1].Trim()));
                    its.Append(w);
                }
                o.Set("items", its);
                arr.Append(o);
            }
            JsonValue r = Gateway.Ok();
            r.Set("rows", arr);
            Gateway.SelfInto(r, s);
            return r;
        } finally {
            Gateway.Give(db);
        }
    }

    /* 至尊殿堂八格键：武器之攻/法/道（同一把武器按不同主属性记分）、
       铠甲/头盔（防御）、项链/手镯/戒指（三主属性之和）。 */
    static string[] SupKeys() {
        return new string[] {
            "atk", "mag", "tao", "armor", "helmet", "necklace", "bracelet", "ring"
        };
    }

    static string SupTitle(int i) {
        string[] t = new string[] {
            "武器之攻", "武器之法", "武器之道", "铠甲之首",
            "头盔之首", "项链之首", "手镯之首", "戒指之首"
        };
        return t[i];
    }

    static string SupSub(int i) {
        string[] s = new string[] {
            "武器（攻击天赋>总系数>攻击值）",
            "武器（魔法天赋>总系数>魔法值）",
            "武器（道术天赋>总系数>道术值）",
            "铠甲（防御天赋>总系数>防御值）",
            "头盔（防御天赋>总系数>防御值）",
            "项链（主属性>总系数）",
            "手镯（主属性>总系数）",
            "戒指（主属性>总系数）"
        };
        return s[i];
    }

    static bool SupCopyable(int i) {
        return i >= 4;
    }

    static int SupFee(int i) {
        if (i >= 4 && i <= 6) { return 100; }
        if (i == 7) { return 10; }
        return 0;
    }

    /* 登记格 → 玩家装备位：0..2 武器、3 铠甲、4 头盔、5 项链、6 手镯、7 戒指。 */
    static int SupSlotItem(Session s, int i) {
        if (i <= 2) { return s.row.weaponId; }
        if (i == 3) { return s.row.armorId; }
        if (i == 4) { return s.row.helmetId; }
        if (i == 5) { return s.row.necklaceId; }
        if (i == 6) { return s.row.braceletId; }
        return s.row.ringId;
    }

    static long SupScore(int i, ZanWeb.Model.Game.Item it) {
        if (i == 0) { return it.atk; }
        if (i == 1) { return it.magic; }
        if (i == 2) { return it.tao; }
        if (i <= 4) { return it.def; }
        return (long)it.atk + it.magic + it.tao;
    }

    /* 我的登记加成：每格榜首 +sup_exp_pct_per%，封顶 sup_exp_pct_cap。 */
    static int SupBonusPct(Session s) {
        int held = 0;
        string[] keys = Play.SupKeys();
        for (int i = 0; i < keys.Length; i = i + 1) {
            if (WorldState.Get("sup." + keys[i] + ".owner", "") == s.row.nickname) {
                held = held + 1;
            }
        }
        int pct = held * Rules.Val("sup_exp_pct_per");
        int cap = Rules.Val("sup_exp_pct_cap");
        return pct > cap ? cap : pct;
    }

    /* sup：{}=殿堂面板（八格榜首 + 我的经验加成）；{"reg":格号}=以对应
       装备位登记（分数须超过现任榜首才易主）。 */
    static JsonValue Sup(Session s, JsonValue m, long now) {
        string[] keys = Play.SupKeys();
        int reg = m.Int("reg", -1);
        if (reg >= 0) {
            if (reg >= keys.Length) { return Gateway.Err("没有这个殿堂格"); }
            int itemId = Play.SupSlotItem(s, reg);
            if (itemId <= 0) {
                return Gateway.Err("这个部位还没有穿戴装备");
            }
            ZanWeb.Model.Game.Item it = Fight.ById(itemId);
            if (it == null) { return Gateway.Err("装备数据异常"); }
            long score = Play.SupScore(reg, it);
            string key = "sup." + keys[reg];
            long cur = WorldState.GetNum(key + ".value", -1);
            if (score <= cur) {
                return Gateway.Err("未能超过现任榜首（"
                    + Convert.ToString(cur) + "），登记失败不扣任何费用");
            }
            WorldState.Set(key + ".owner", s.row.nickname);
            WorldState.SetNum(key + ".value", score);
            WorldState.SetNum(key + ".item", itemId);
        }
        List<SupremeSlotModel> rows = new List<SupremeSlotModel>();
        for (int i = 0; i < keys.Length; i = i + 1) {
            string key = "sup." + keys[i];
            string owner = WorldState.Get(key + ".owner", "");
            long itemId = WorldState.GetNum(key + ".item", 0);
            long val = WorldState.GetNum(key + ".value", 0);
            ZanWeb.Model.Game.Item it = itemId > 0 ? Fight.ById((int)itemId) : null;
            string itemName = it != null ? it.name : "";
            rows.Add(new SupremeSlotModel(
                Play.SupTitle(i),
                Play.SupSub(i),
                owner,
                itemId,
                itemName,
                val,
                Play.SupCopyable(i),
                Play.SupFee(i)
            ));
        }
        SupremeStateModel model = new SupremeStateModel(Play.SupBonusPct(s), rows);
        JsonValue r = Gateway.Ok();
        model.IntoJson(r);
        Gateway.SelfInto(r, s);
        return r;
    }

    /* tj 图鉴套装收集：{}=六组面板（组名/已放格数/系数/九格道具）；
       {"put":组,"slot":格}=从背包找该格对应装备放入（消耗，放入无法
       取出）。成套（全部定义格放满）激活属性：atk 组加攻击、def 组加
       防御，数值 tj_baseN/10（Fight.Atk/Def 现算）。六组定义与客户端
       PageTujian 同源（原版图鉴抄录），组属性文案客户端自持。 */
    class TjSetDef {
        string name;
        string kind;    // "atk" / "def"
        int[] items;    // 按格位的道具 id，0 = 该组不用的空格
    }

    static List<Play.TjSetDef> tjDefs = null;
    static List<Play.TjSetDef> TjDefs() {
        if (tjDefs != null) { return tjDefs; }
        List<Play.TjSetDef> v = new List<Play.TjSetDef>();
        v.Add(Play.TjSetOf("祈祷", "def", 124, 125, 126, 127, 128, 0, 0, 0, 0));
        v.Add(Play.TjSetOf("沃玛", "atk", 45, 33, 32, 117, 119, 136, 135, 121, 122));
        v.Add(Play.TjSetOf("祖玛", "atk", 123, 142, 146, 145, 129, 54, 91, 172, 177));
        v.Add(Play.TjSetOf("圣战", "atk", 166, 167, 168, 169, 0, 0, 0, 0, 0));
        v.Add(Play.TjSetOf("法神", "atk", 170, 171, 172, 173, 0, 0, 0, 0, 0));
        v.Add(Play.TjSetOf("天尊", "atk", 174, 175, 176, 177, 0, 0, 0, 0, 0));
        tjDefs = v;
        return v;
    }

    static Play.TjSetDef TjSetOf(string name, string kind,
                                 int i0, int i1, int i2, int i3, int i4,
                                 int i5, int i6, int i7, int i8) {
        Play.TjSetDef d = new Play.TjSetDef();
        d.name = name; d.kind = kind;
        d.items = new int[] { i0, i1, i2, i3, i4, i5, i6, i7, i8 };
        return d;
    }

    /* codexItems CSV（"组:格:itemId,…"）里某格是否已放。 */
    static bool TjHas(string csv, int g, int slot) {
        if (csv == null || csv.Length == 0) { return false; }
        List<TjSlotEntry> slots = TjSlotEntry.ParseCsv(csv);
        for (int i = 0; i < slots.Count; i = i + 1) {
            TjSlotEntry e = slots[i];
            if (e.Group == g && e.Slot == slot) {
                return true;
            }
        }
        return false;
    }

    /* 成套判定：该组全部非 0 定义格都已放入。 */
    static bool TjComplete(string csv, Play.TjSetDef def, int g) {
        for (int k = 0; k < def.items.Length; k = k + 1) {
            if (def.items[k] <= 0) { continue; }
            if (!Play.TjHas(csv, g, k)) { return false; }
        }
        return true;
    }

    /* 成套加成（攻/防分开取）：Fight.Atk/AtkLo/Def/DefLo 现算挂入。 */
    static int TjBonusAtk(ZanWeb.Model.Game.Player row) {
        string csv = row.codexItems != null ? row.codexItems : "";
        List<Play.TjSetDef> defs = Play.TjDefs();
        int bonus = 0;
        for (int i = 0; i < defs.Count; i = i + 1) {
            if (defs[i].kind != "atk") { continue; }
            if (Play.TjComplete(csv, defs[i], i)) {
                bonus = bonus + Rules.Val("tj_base" + Convert.ToString(i + 1)) / 10;
            }
        }
        return bonus;
    }

    static int TjBonusDef(ZanWeb.Model.Game.Player row) {
        string csv = row.codexItems != null ? row.codexItems : "";
        List<Play.TjSetDef> defs = Play.TjDefs();
        int bonus = 0;
        for (int i = 0; i < defs.Count; i = i + 1) {
            if (defs[i].kind != "def") { continue; }
            if (Play.TjComplete(csv, defs[i], i)) {
                bonus = bonus + Rules.Val("tj_base" + Convert.ToString(i + 1)) / 10;
            }
        }
        return bonus;
    }

    static JsonValue Tj(Session s, JsonValue m, long now) {
        List<Play.TjSetDef> defs = Play.TjDefs();
        int put = m.Int("put", -1);
        if (put >= 0) {
            int slot = m.Int("slot", -1);
            if (put >= defs.Count) { return Gateway.Err("没有这组图鉴"); }
            Play.TjSetDef def = defs[put];
            if (slot < 0 || slot >= def.items.Length || def.items[slot] <= 0) {
                return Gateway.Err("这格不接受装备");
            }
            if (Play.TjHas(s.row.codexItems, put, slot)) {
                return Gateway.Err("这格已有装备（放入无法取出）");
            }
            ZanWeb.Model.Game.Item want = Fight.ById(def.items[slot]);
            if (!Fight.BagTake(s, def.items[slot], 1)) {
                return Gateway.Err("背包里没有「"
                    + (want != null ? want.name : "该装备") + "」");
            }
            string csv = s.row.codexItems != null ? s.row.codexItems : "";
            if (csv.Length > 0) { csv = csv + ","; }
            s.row.codexItems = csv + Convert.ToString(put) + ":"
                + Convert.ToString(slot) + ":" + Convert.ToString(def.items[slot]);
            s.dirty = true;
        }
        string cur = s.row.codexItems != null ? s.row.codexItems : "";
        JsonValue groups = JsonValue.NewArray();
        for (int i = 0; i < defs.Count; i = i + 1) {
            Play.TjSetDef def = defs[i];
            JsonValue o = JsonValue.NewObject();
            o.Set("name", JsonValue.NewStr(def.name));
            o.Set("kind", JsonValue.NewStr(def.kind));
            JsonValue slots = JsonValue.NewArray();
            int filled = 0;
            for (int k = 0; k < def.items.Length; k = k + 1) {
                JsonValue so = JsonValue.NewObject();
                int itemId = 0;
                if (def.items[k] > 0 && Play.TjHas(cur, i, k)) {
                    itemId = def.items[k];
                    filled = filled + 1;
                }
                so.Set("item", JsonValue.NewNum(Convert.ToString(itemId)));
                slots.Append(so);
            }
            o.Set("slots", slots);
            o.Set("filled", JsonValue.NewNum(Convert.ToString(filled)));
            o.Set("coeff", JsonValue.NewNum(Convert.ToString(filled * 10)));
            o.Set("complete", JsonValue.NewNum(
                Play.TjComplete(cur, def, i) ? "1" : "0"));
            groups.Append(o);
        }
        JsonValue r = Gateway.Ok();
        r.Set("groups", groups);
        Gateway.SelfInto(r, s);
        return r;
    }

    /* 场景页家族进度榜（幻境/秘境/世界BOSS 右栏 10 行的数据通道）：
       {"op":"scenerank","dim":1|2|3} → rows[{name,level,floor}]×10 + me。
       dim1 幻境 = 地图解锁进度 mapUnlocked（地图链推进 = 推层）；
       dim2 秘境 = 五行总层数（修炼深度，打怪实时涨）；
       dim3 世界BOSS = 本周期伤害（Fight 内存榜，重生清零）。
       前两维扫本区玩家表（在线人数小，名次选择同爵位/结伴榜）。 */
    static async JsonValue SceneRank(Session s, JsonValue m) {
        int dim = m.Int("dim", 1);
        JsonValue rows = JsonValue.NewArray();
        if (dim == 3) {
            List<WbDamageRecord> top = Fight.WbTopRecords(10);
            for (int rank = 0; rank < top.Count; rank = rank + 1) {
                WbDamageRecord rec = top[rank];
                JsonValue o = JsonValue.NewObject();
                o.Set("name", JsonValue.NewStr(rec.name));
                o.Set("level", JsonValue.NewNum("0"));
                o.Set("floor", JsonValue.NewNum(Convert.ToString(rec.damage)));
                rows.Append(o);
            }
            JsonValue r3 = Gateway.Ok();
            r3.Set("rows", rows);
            r3.Set("me", JsonValue.NewNum(Convert.ToString(s.wbDmg)));
            Gateway.SelfInto(r3, s);
            return r3;
        }
        IDbConnection db = await Gateway.Db();
        if (db == null) { return Gateway.Err("数据库不可用，请稍后再试"); }
        try {
            List<ZanWeb.Model.Game.Player> all = await db
                .Select<ZanWeb.Model.Game.Player>()
                .Where(a => a.realmId == s.realmId)
                .ToListAsync();
            List<SceneRankEntry> entries = new List<SceneRankEntry>();
            for (int i = 0; i < all.Count; i = i + 1) {
                int f = 0;
                if (dim == 2) {
                    int[] wx = Play.WxParse(all[i].wuxingRanks);
                    for (int k = 0; k < wx.Length; k = k + 1) { f = f + wx[k]; }
                } else {
                    f = all[i].mapUnlocked;
                }
                if (f <= 0) { continue; }
                entries.Add(new SceneRankEntry(all[i].nickname, all[i].level, f));
            }
            for (int rank = 0; rank < 10 && entries.Count > 0; rank = rank + 1) {
                int best = 0;
                for (int k = 1; k < entries.Count; k = k + 1) {
                    if (entries[k].floor > entries[best].floor) { best = k; }
                }
                JsonValue o = JsonValue.NewObject();
                o.Set("name", JsonValue.NewStr(entries[best].name));
                o.Set("level", JsonValue.NewNum(Convert.ToString(entries[best].level)));
                o.Set("floor", JsonValue.NewNum(Convert.ToString(entries[best].floor)));
                rows.Append(o);
                entries.RemoveAt(best);
            }
        } finally {
            Gateway.Give(db);
        }
        int me = dim == 2 ? Play.WxSum(s.row.wuxingRanks) : s.row.mapUnlocked;
        JsonValue r = Gateway.Ok();
        r.Set("rows", rows);
        r.Set("me", JsonValue.NewNum(Convert.ToString(me)));
        Gateway.SelfInto(r, s);
        return r;
    }

    static int WxSum(string csv) {
        int[] wx = Play.WxParse(csv);
        int sum = 0;
        for (int i = 0; i < wx.Length; i = i + 1) { sum = sum + wx[i]; }
        return sum;
    }

    /* 仓库（wh）：{}=列表；{"in":itemId,"count":N}=入库（先扣会话
       背包再 upsert 本表）；{"out":itemId,"count":N}=出库（条件更新
       count 原值比对防双花，再 BagAdd 入会话背包）。低频操作直写
       事实层，不进会话热缓存。行内联 name/kind/slot 供客户端直渲染
       （图标客户端按 items.csv 自解析，同背包）。 */
    static async JsonValue Wh(Session s, JsonValue m) {
        IDbConnection db = await Gateway.Db();
        if (db == null) { return Gateway.Err("数据库不可用，请稍后再试"); }
        try {
            int itemId = m.Int("in", 0) > 0 ? m.Int("in", 0) : m.Int("out", 0);
            if (itemId > 0) {
                int count = m.Int("count", 1);
                if (count < 1) { return Gateway.Err("数量要大于 0"); }
                ZanWeb.Model.Game.Item it = Fight.ById(itemId);
                if (it == null) { return Gateway.Err("没有这种物品"); }
                ZanWeb.Model.Game.Warehouse row = await db
                    .Select<ZanWeb.Model.Game.Warehouse>()
                    .Where(a => a.playerId == s.row.id && a.itemId == itemId)
                    .FirstAsync();
                if (m.Int("in", 0) > 0) {
                    if (!Fight.BagTake(s, itemId, count)) {
                        return Gateway.Err("背包里没有这么多 " + it.name);
                    }
                    if (row == null) {
                        ZanWeb.Model.Game.Warehouse add =
                            new ZanWeb.Model.Game.Warehouse();
                        add.playerId = s.row.id;
                        add.itemId = itemId;
                        add.count = count;
                        int _ins = await db.Insert<ZanWeb.Model.Game.Warehouse>(add)
                            .ExecuteAffrowsAsync();
                    } else {
                        int _upd = await db.Update<ZanWeb.Model.Game.Warehouse>()
                            .SetIncr(a => a.count, count)
                            .Where(a => a.id == row.id)
                            .ExecuteAffrowsAsync();
                    }
                } else {
                    if (row == null || row.count < count) {
                        return Gateway.Err("仓库里没有这么多 " + it.name);
                    }
                    int taken = await db.Update<ZanWeb.Model.Game.Warehouse>()
                        .SetIncr(a => a.count, 0 - count)
                        .Where(a => a.id == row.id && a.count == row.count)
                        .ExecuteAffrowsAsync();
                    if (taken <= 0) { return Gateway.Err("仓库状态已变化，请重试"); }
                    Fight.BagAdd(s, itemId, count);
                    s.bagDirty = true;
                }
            }
            List<ZanWeb.Model.Game.Warehouse> rows = await db
                .Select<ZanWeb.Model.Game.Warehouse>()
                .Where(a => a.playerId == s.row.id)
                .OrderBy(a => a.itemId).ToListAsync();
            JsonValue arr = JsonValue.NewArray();
            for (int i = 0; i < rows.Count; i = i + 1) {
                if (rows[i].count <= 0) { continue; }
                ZanWeb.Model.Game.Item it = Fight.ById(rows[i].itemId);
                if (it == null) { continue; }
                JsonValue o = JsonValue.NewObject();
                o.Set("id", JsonValue.NewNum(Convert.ToString(it.id)));
                o.Set("name", JsonValue.NewStr(it.name));
                o.Set("kind", JsonValue.NewNum(Convert.ToString(it.kind)));
                o.Set("slot", JsonValue.NewNum(Convert.ToString(it.slot)));
                o.Set("count", JsonValue.NewNum(Convert.ToString(rows[i].count)));
                arr.Append(o);
            }
            JsonValue r = Gateway.Ok();
            r.Set("wh", arr);
            r.Set("bag", Fight.BagJson(s));
            Gateway.SelfInto(r, s);
            return r;
        } finally {
            Gateway.Give(db);
        }
    }
}
