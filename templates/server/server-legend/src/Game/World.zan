using System;
using System.Collections.Generic;
using System.Data;
using System.Json;
using System.Net;

namespace ZanWeb.Game;

/* 游戏世界：在线会话表 + tick 协程，模板的服务权威所在。
   - 会话以 cid 为主键、账号 id 为索引；登录（进区前）与进区都登记在这里，
     断开统一走 Leave。
   - 广播按区服收窄：聊天/动向只进本区，公告与 GM 喊话全服可见。
   - tick 每 tickMs 跳一次：心跳超时踢出、定期把 dirty 角色落库。
   - 离线结算在进入区服的路径（Gateway 的 enter）：按角色 lastLogoutAt
     起算的离线时长发放金币，封顶 offlineCapHours。
   - GM 写在线角色必须经这里（Adjust/ApplyEdit），让内存副本、落库标记
     与客户端推送保持一致；离线角色由 GM 页直接改库。所有可变状态只在
     协程不跨 await 的前提下共享，单线程无需加锁。 */
class World {
    /* cid → 会话；账号 id → 会话（登录即登记）。索引在 Enter/Leave 维护。 */
    static Dictionary<int, Session> byCid = new Dictionary<int, Session>();
    static Dictionary<int, Session> byAccount = new Dictionary<int, Session>();

    /* tick 落库用的连接上下文，Start 时注入（每进程一份）。 */
    static DbContext dbctx;

    static bool running = false;

    /* 在世界中的会话数（进了区、有角色的）——对玩家展示的"在线"用这个。 */
    static int OnlineCount() {
        int n = 0;
        List<Session> rows = World.All();
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].row != null) { n = n + 1; }
        }
        return n;
    }

    /* 已登录会话数（含登录了还没进区的）。 */
    static int SessionCount() { return World.byCid.Count; }

    /* 某区服当前在世界中的角色数；realmId<=0 视为全服。 */
    static int RealmOnline(int realmId) {
        int n = 0;
        List<Session> rows = World.All();
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].row == null) { continue; }
            if (realmId > 0 && rows[i].realmId != realmId) { continue; }
            n = n + 1;
        }
        return n;
    }

    static Session ByAccount(int accountId) {
        Session s = null;
        if (World.byAccount.TryGetValue(accountId, out s)) { return s; }
        return null;
    }

    static Session ByCid(int cid) {
        Session s = null;
        if (World.byCid.TryGetValue(cid, out s)) { return s; }
        return null;
    }

    /* 按推送连接找会话（Gateway 断开/顶号回调用）。在线量小，线性扫。 */
    static Session ByPush(int pushCid) {
        List<Session> rows = World.All();
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].pushCid == pushCid) { return rows[i]; }
        }
        return null;
    }

    /* 在线角色快照：按角色 id 找仍在外面的会话（GM 页按角色行操作）。 */
    static Session ByChar(int playerId) {
        List<Session> rows = World.All();
        for (int i = 0; i < rows.Count; i = i + 1) {
            Session s = rows[i];
            if (s.row != null && s.row.id == playerId) { return s; }
        }
        return null;
    }

    /* 在线会话快照：GM 页与广播使用（Values 返回当前集合的快照列表）。 */
    static List<Session> All() { return World.byCid.Values; }

    /* 某角色当前是否被在线会话持有（删除角色前拦截，防 flush 回写
       复活已删行）。 */
    static bool HoldsPlayer(int playerId) {
        List<Session> rows = World.All();
        for (int i = 0; i < rows.Count; i = i + 1) {
            Session s = rows[i];
            if (s == null || s.row == null || s.kicked) { continue; }
            if (s.row.id == playerId) { return true; }
        }
        return false;
    }

    /* 登录成功登记会话；同账号旧连接被顶号：推送后立即 Leave 收敛
       （角色/背包当场落库，连接本体由 worker 懒收口）——半开连接不再
       挂着旧 row，避免 ByChar/Gift 误命中死会话。此时新会话 row 为空，
       进区另有 EnterWorld。旧会话可能还没有推送通道（HTTP 登录未
       attach），Send/Close 都对 null 连接安全。 */
    static async void Enter(Session s, long now) {
        Session old = World.ByAccount(s.accountId);
        if (old != null && old.cid != s.cid) {
            old.kicked = true;
            Gateway.Send(old.conn, Gateway.Ev("kick", "该账号在别处登录"));
            if (old.conn != null) { old.conn.Close(); }
            await World.Leave(old.cid);
        }
        World.byCid.Add(s.cid, s);
        World.byAccount.Add(s.accountId, s);
        Console.WriteLine("[world] login #" + Convert.ToString(s.cid)
            + " " + s.username + " sessions="
            + Convert.ToString(World.byCid.Count));
    }

    /* 进入区服：会话挂上角色与该区倍率，开始参与世界（广播/落库/踢线
       都看 row）。realm 传 null 时保留会话现有倍率（不会发生，防御）。 */
    static void EnterWorld(Session s, int realmId,
                           ZanWeb.Model.Game.Realm realm,
                           ZanWeb.Model.Game.Player row, long now) {
        s.realmId = realmId;
        if (realm != null) {
            s.expRate = realm.expRate > 0 ? realm.expRate : 10000;
            s.goldRate = realm.goldRate > 0 ? realm.goldRate : 10000;
            s.dropRate = realm.dropRate > 0 ? realm.dropRate : 10000;
        }
        s.row = row;
        s.dirty = false;
        s.lastSeen = now;
        GameShared.OnlineEnter(realmId, row.id);
        Console.WriteLine("[world] enter #" + Convert.ToString(s.cid)
            + " " + s.username + " realm=" + Convert.ToString(realmId)
            + " rate=" + Convert.ToString(s.expRate) + "/"
            + Convert.ToString(s.goldRate) + "/"
            + Convert.ToString(s.dropRate)
            + " online=" + Convert.ToString(World.OnlineCount()));
    }

    /* 离开当前区服（换区重进时先走这里）：把角色与背包落库再摘下来，
       连接与会话保留，账号仍算在线。 */
    static async void ExitWorld(Session s) {
        if (s.row == null) { return; }
        Fight.PersistBagNow(s);
        ZanWeb.Model.Game.Player row = s.row;
        int fromRealm = s.realmId;
        s.row = null;
        s.realmId = 0;
        GameShared.OnlineExit(fromRealm, row.id);
        row.lastLogoutAt = WebApp.NowSeconds();
        await World.PersistRow(row, true);
        Console.WriteLine("[world] exit #" + Convert.ToString(s.cid)
            + " " + s.username + " online="
            + Convert.ToString(World.OnlineCount()));
    }

    /* 连接关闭后的清理：移除索引，仍在外面的角色落库并写登出时间。 */
    static async void Leave(int cid) {
        Session s = World.ByCid(cid);
        if (s == null) { return; }
        World.byCid.Remove(cid);
        Session idx = World.ByAccount(s.accountId);
        if (idx != null && idx.cid == cid) { World.byAccount.Remove(s.accountId); }
        if (s.row != null) {
            GameShared.OnlineExit(s.realmId, s.row.id);
            /* 挂机尾巴先结算再落库：不足一个批量周期的产出也入账
               （连接已关，不推送）。 */
            if (s.autoMobId > 0) { Fight.Settle(s, WebApp.NowSeconds(), false); }
            s.autoMobId = 0;
            s.row.lastLogoutAt = WebApp.NowSeconds();
            Fight.PersistBagNow(s);
            await World.PersistRow(s.row, true);
        }
        Console.WriteLine("[world] leave #" + Convert.ToString(cid)
            + " " + s.username + " sessions="
            + Convert.ToString(World.byCid.Count));
    }

    /* 发放资源（GM 发奖）：数额可为负（扣回误发），下限 0。返回 false
       表示该角色当前不在世界中——GM 页应转走直接改库的路径。 */
    static bool Adjust(int playerId, long gold, long gems) {
        Session s = World.ByChar(playerId);
        if (s == null) { return false; }
        s.row.gold = s.row.gold + gold;
        if (s.row.gold < 0) { s.row.gold = 0; }
        s.row.gems = s.row.gems + gems;
        if (s.row.gems < 0) { s.row.gems = 0; }
        s.dirty = true;
        Gateway.PushState(s);
        return true;
    }

    /* GM 改等级/职业/驻地/昵称等基本项：只动内存副本，落库随 tick。
       level<=0 表示不改。返回 false 同 Adjust。 */
    static bool ApplyEdit(int playerId, int level, int job, int mapId,
                          string nickname) {
        Session s = World.ByChar(playerId);
        if (s == null) { return false; }
        if (level > 0) { s.row.level = level; }
        s.row.job = job;
        s.row.mapId = mapId;
        if (nickname.Length > 0) { s.row.nickname = nickname; }
        s.row.hp = Fight.ClampHp(s.row);
        int maxMp = Fight.MaxMp(s.row);
        if (s.row.mp > maxMp) { s.row.mp = maxMp; }
        s.dirty = true;
        Gateway.PushState(s);
        return true;
    }

    /* 踢出账号（封禁/顶号/GM 踢线）；返回 false 表示不在线。推送 kick
       后立即 Leave：角色与背包当场落库、会话移出世界（连接本体由
       worker 懒收口，之后的清理是幂等空转）。 */
    static async bool Kick(int accountId, string reason) {
        Session s = World.ByAccount(accountId);
        if (s == null) { return false; }
        s.kicked = true;
        Gateway.Send(s.conn, Gateway.Ev("kick", reason));
        if (s.conn != null) { s.conn.Close(); }
        await World.Leave(s.cid);
        return true;
    }

    /* 全服 GM 喊话：发给所有已登录会话（含未进区的）。返回送达数。 */
    static int Broadcast(string from, string text) {
        List<Session> rows = World.All();
        for (int i = 0; i < rows.Count; i = i + 1) {
            Gateway.PushChat(rows[i].conn, from, text);
        }
        return rows.Count;
    }

    /* 区服聊天：只进本区。 */
    static void Chat(ZanWeb.Model.Game.Player from, string text) {
        JsonValue ev = JsonValue.NewObject();
        ev.Set("ev", JsonValue.NewStr("chat"));
        ev.Set("from", JsonValue.NewStr(from.nickname));
        ev.Set("text", JsonValue.NewStr(text));
        World.DeliverRealm(from.realmId, ev);
    }

    /* 把一条公告推给全部已登录会话；返回送达数。 */
    static int PushAnnounce(string title, string body) {
        List<Session> rows = World.All();
        for (int i = 0; i < rows.Count; i = i + 1) {
            Gateway.PushAnnounce(rows[i].conn, title, body);
        }
        return rows.Count;
    }

    /* 事件只发给本区在世界中的会话。 */
    static void DeliverRealm(int realmId, JsonValue ev) {
        List<Session> rows = World.All();
        for (int i = 0; i < rows.Count; i = i + 1) {
            Session s = rows[i];
            if (s.row == null || s.realmId != realmId) { continue; }
            Gateway.Send(s.conn, ev);
        }
    }

    /* ---- 启动与 tick ---- */

    static void Start(DbContext ctx) {
        if (World.running) { return; }
        World.running = true;
        World.dbctx = ctx;
        Task.Spawn(Fight.Bootstrap(ctx));
        Task.Spawn(World.Loop());
        /* 跨 worker 中继的服务循环：HTTP worker 把登录会话登记、世界
           op 与管理页写动作发到本进程的环回 TCP 控制通道，这里逐连接
           接入执行。 */
        Task.Spawn(GameShared.RpcLoop());
        Console.WriteLine("[world] tick " + Convert.ToString(Cfg.Game.tickMs)
            + "ms flush=" + Convert.ToString(Cfg.Game.flushSeconds) + "s");
    }

    /* HTTP 登录的世界侧半场（Gateway.Login 与跨 worker 中继共用）：
       顶掉同账号旧会话（当场落库），登记新会话并分配 HTTP 段 cid。
       只做登记不做应答——token、区服列表由调用方自己组装。 */
    static async int EnsureHttpSession(int accountId, string username,
                                       long now) {
        Session old = World.ByAccount(accountId);
        Session s = new Session();
        s.cid = GameShared.NextHttpCid();
        s.httpOwned = true;
        s.conn = null;
        s.pushCid = 0;
        s.accountId = accountId;
        s.username = username;
        s.realmId = 0;
        s.row = null;
        s.dirty = false;
        s.kicked = false;
        s.lastSeen = now;
        s.loginAt = now;
        /* 先登记新会话、再拆旧通道，顺序不能倒：客户端收到 kick 会
            当场重连 attach，而 Leave 落库是一次几十 ms 的 DB 写——若
            先踢后登记，重连恰好掉进「旧会话已摘、新会话未登记」的缝，
            attach 答「登录已过期」，推送通道从此挂不上。登记与踢线
            之间没有 await，单线程调度下外部看不到中间态。Leave 的
            byAccount cid 守卫保证摘旧会话时不会误摘新登记。 */
        World.byCid.Add(s.cid, s);
        if (old != null) {
            old.kicked = true;
            World.byAccount.Remove(accountId);
            World.byAccount.Add(accountId, s);
            /* 顶号必须把旧会话挂着的推送通道一并拆掉：只 Leave 不通知，
               旧 TCP 连接就成了收不到任何推送的孤儿——客户端要等自己的
               空闲超时才能发现，期间的公告/聊天全丢。与 Enter/Kick/Sweep
               三处的顶号形态保持一致。 */
            Gateway.Send(old.conn, Gateway.Ev("kick", "该账号在别处登录"));
            if (old.conn != null) { old.conn.Close(); }
            await World.Leave(old.cid);
        } else {
            World.byAccount.Add(accountId, s);
        }
        Console.WriteLine("[world] login #" + Convert.ToString(s.cid)
            + " " + s.username + " sessions="
            + Convert.ToString(World.byCid.Count));
        return s.cid;
    }

    /* 在线会话清单（管理页在线列表）：世界进程本地生成，跨 worker 时
       经 ops 表中继（GameShared.Gm act=sessions）。 */
    static JsonValue SessionsJson() {
        JsonValue arr = JsonValue.NewArray();
        List<Session> rows = World.All();
        for (int i = 0; i < rows.Count; i = i + 1) {
            Session s = rows[i];
            JsonValue o = JsonValue.NewObject();
            o.Set("cid", JsonValue.NewNum(Convert.ToString(s.cid)));
            o.Set("user", JsonValue.NewStr(s.username));
            o.Set("uid", JsonValue.NewNum(Convert.ToString(s.accountId)));
            o.Set("realm", JsonValue.NewNum(Convert.ToString(s.realmId)));
            o.Set("channel", JsonValue.NewStr(s.httpOwned ? "http" : "tcp"));
            o.Set("push", JsonValue.NewNum(s.pushCid > 0 ? "1" : "0"));
            o.Set("level", JsonValue.NewNum(Convert.ToString(
                s.row != null ? s.row.level : 0)));
            o.Set("name", JsonValue.NewStr(
                s.row != null ? s.row.nickname : ""));
            o.Set("map", JsonValue.NewNum(Convert.ToString(
                s.row != null ? s.row.mapId : 0)));
            o.Set("x", JsonValue.NewNum(Convert.ToString(
                s.row != null ? s.row.x : 0)));
            o.Set("y", JsonValue.NewNum(Convert.ToString(
                s.row != null ? s.row.y : 0)));
            o.Set("loginAt", JsonValue.NewNum(Convert.ToString(s.loginAt)));
            o.Set("lastSeen", JsonValue.NewNum(Convert.ToString(s.lastSeen)));
            arr.Append(o);
        }
        JsonValue r = JsonValue.NewObject();
        r.Set("ok", JsonValue.NewNum("1"));
        r.Set("rows", arr);
        return r;
    }

    static async void Loop() {
        int elapsed = 0;
        while (true) {
            await Task.Delay(Cfg.Game.tickMs);
            long now = WebApp.NowSeconds();
            elapsed = elapsed + Cfg.Game.tickMs;
            await World.Sweep(now);
            Gateway.SweepIdle(now);
            Fight.Tick(now);
            if (elapsed >= Cfg.Game.flushSeconds * 1000) {
                elapsed = 0;
                int n = await World.Flush();
                if (n > 0) {
                    Console.WriteLine("[world] flush " + Convert.ToString(n));
                }
            }
        }
    }

    /* 心跳超时：kickSeconds 内没有任何消息（含 hb）的会话按断线处理：
       推 kick、立即 Leave 落库并移出世界（连接本体由 worker 懒收口）。
       kicked 会话跳过，别每秒重踢刷屏。 */
    static async void Sweep(long now) {
        List<Session> rows = World.All();
        for (int i = 0; i < rows.Count; i = i + 1) {
            Session s = rows[i];
            if (s.kicked) { continue; }
            if (now - s.lastSeen > Cfg.Game.kickSeconds) {
                Console.WriteLine("[world] timeout #" + Convert.ToString(s.cid)
                    + " " + s.username + " idle="
                    + Convert.ToString(now - s.lastSeen) + "s");
                s.kicked = true;
                Gateway.Send(s.conn, Gateway.Ev("kick", "心跳超时"));
                if (s.conn != null) { s.conn.Close(); }
                await World.Leave(s.cid);
                continue;
            }
        }
    }

    /* 把全部 dirty 角色写回数据库；连接按需借还，借不到就留到下一轮。 */
    static async int Flush() {
        if (World.dbctx == null) { return 0; }
        IDbConnection db = await World.dbctx.Acquire();
        if (db == null) { return 0; }
        try {
            List<Session> rows = World.All();
            int n = 0;
            for (int i = 0; i < rows.Count; i = i + 1) {
                Session s = rows[i];
                if (s.row == null) { continue; }
                if (s.dirty) {
                    s.dirty = false;
                    if (await World.WriteRow(db, s.row)) { n = n + 1; }
                }
                n = n + await Fight.FlushBag(db, s);
            }
            return n;
        } finally {
            World.dbctx.Release(db);
        }
    }

    /* 单行落库：自借连接，尽力而为——失败只留日志，下一轮 Flush 或
       玩家再次进区仍会覆盖。logout 时同时写登出时间。 */
    static async bool PersistRow(ZanWeb.Model.Game.Player row, bool logout) {
        if (World.dbctx == null) { return false; }
        IDbConnection db = await World.dbctx.Acquire();
        if (db == null) { return false; }
        try {
            /* WriteRow 声明 async bool（内部已折算受影响行数），此前
               await 无 checker 类型，bool 装进 int 静默通过。 */
            bool n = await World.WriteRow(db, row);
            if (logout) {
                int _t = await db.Update<ZanWeb.Model.Game.Player>()
                    .Set(a => a.lastLogoutAt, row.lastLogoutAt)
                    .Where(a => a.id == row.id)
                    .ExecuteAffrowsAsync();
            }
            return n;
        } finally {
            World.dbctx.Release(db);
        }
    }

    static async bool WriteRow(IDbConnection db,
                               ZanWeb.Model.Game.Player row) {
        long now = WebApp.NowSeconds();
        int n = await db.Update<ZanWeb.Model.Game.Player>()
            .Set(a => a.level, row.level)
            .Set(a => a.hp, row.hp)
            .Set(a => a.exp, row.exp)
            .Set(a => a.weaponId, row.weaponId)
            .Set(a => a.armorId, row.armorId)
            .Set(a => a.gold, row.gold)
            .Set(a => a.gems, row.gems)
            .Set(a => a.mapId, row.mapId)
            .Set(a => a.x, row.x)
            .Set(a => a.y, row.y)
            /* BOSS 链进度随行落库：解锁图、当日剩余次数与日期、失败余血
               及其所在图——漏了的话挑战胜利在重启后全部回退。 */
            .Set(a => a.mapUnlocked, row.mapUnlocked)
            .Set(a => a.bossTries, row.bossTries)
            .Set(a => a.bossTryDate, row.bossTryDate)
            .Set(a => a.bossHpLeft, row.bossHpLeft)
            .Set(a => a.bossHpMap, row.bossHpMap)
            /* 玩法页状态（Play 模块）：竞技场/押镖/祭坛/五行/将星/称谓/
               传说塔/师徒——漏了的话玩法进度重启回退。 */
            .Set(a => a.arenaPts, row.arenaPts)
            .Set(a => a.arenaWins, row.arenaWins)
            .Set(a => a.arenaTries, row.arenaTries)
            .Set(a => a.arenaTryDate, row.arenaTryDate)
            .Set(a => a.escortTries, row.escortTries)
            .Set(a => a.escortTryDate, row.escortTryDate)
            .Set(a => a.escortStage, row.escortStage)
            .Set(a => a.escortUntil, row.escortUntil)
            .Set(a => a.escortReward, row.escortReward)
            .Set(a => a.guildId, row.guildId)
            .Set(a => a.masterName, row.masterName)
            .Set(a => a.wuxing, row.wuxing)
            .Set(a => a.wuxingRanks, row.wuxingRanks)
            .Set(a => a.wuxingXp, row.wuxingXp)
            .Set(a => a.wuxingPool, row.wuxingPool)
            .Set(a => a.altarPersonal, row.altarPersonal)
            .Set(a => a.altarDonations, row.altarDonations)
            .Set(a => a.altarDonationDate, row.altarDonationDate)
            .Set(a => a.altarBuffUntil, row.altarBuffUntil)
            .Set(a => a.stars, row.stars)
            .Set(a => a.titlesUnlocked, row.titlesUnlocked)
            .Set(a => a.towerFloor, row.towerFloor)
            .Set(a => a.towerTries, row.towerTries)
            .Set(a => a.towerTryDate, row.towerTryDate)
            .Set(a => a.title, row.title)
            .Set(a => a.updatedAt, now)
            .Where(a => a.id == row.id)
            .ExecuteAffrowsAsync();
        return n > 0;
    }
}
