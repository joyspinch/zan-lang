using System;
using System.Json;
using System.Web;
using ZanWeb.Game;

namespace ZanWeb.Api;

/* 游戏操作端点：POST /api/game/<op>，body 为 JSON
   {"token":...,"op":...,...op 参数}。一问一答的 op 全走这里（登录/
   进区/背包/商店/BOSS 挑战……），分发与 TCP 网关共用 Gateway.Op，
   应答保持网关原形 {"ok":..,...}（不套 {code,msg,data} 信封，客户端
   两侧同构）。防刷按用户：登录后按「账号+op」固定窗口限流（查询类
   宽松 30/s，写操作与高成本战斗收紧到 3-10/s），登录/注册/找回按 IP
   （此时还没有用户身份）。错误码：401 会话失效，429 限流；游戏语义
   的失败（金币不足、未解锁等）仍是 HTTP 200 + ok:0。 */
[Route("api/game/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("游戏")]
class GameApi : ApiController {
    /* 每秒窗：世界内操作，按 账号+op 计数。 */
    static RateLimiter ops = RateLimiter.Owned(1000);

    /* 5 秒窗：匿名端点（无用户身份，按 IP 计数），登录爆破的第一道闸。 */
    static RateLimiter anon = RateLimiter.Owned(5000);

    /* 每用户每秒上限；缺省 30（查询类足够），写操作与战斗收紧。 */
    static int OpMax(string op) {
        if (op == "hunt" || op == "move" || op == "walk" || op == "buy"
                || op == "sell" || op == "say") { return 10; }
        if (op == "bossfight" || op == "bossweep" || op == "auto") { return 5; }
        if (op == "draw" || op == "forge" || op == "wboss") { return 3; }
        /* 改密/重置是凭据自证型写操作：3/s 足够，且挡得住撞库试原密码。 */
        if (op == "changepw" || op == "reset") { return 3; }
        if (op == "arena" || op == "tower" || op == "escort"
                || op == "redpack" || op == "grab") { return 3; }
        if (op == "altar" || op == "wuxing" || op == "market") { return 5; }
        return 30;
    }

    /* 公共跑道：解析 body、认领 token、限流，然后交给 Gateway.Op。 */
    async JsonValue Run(string op) {
        long now = WebApp.NowSeconds();
        JsonValue m = null;
        try {
            m = JsonValue.ParseLenient(this.Body());
        } catch (Exception e) { }
        if (m == null || !m.IsObject()) { m = JsonValue.NewObject(); }

        /* changepw 也走匿名跑道：登录窗的「修改密码」页在**登录之前**
           （原版就是忘了密码从登录页直接改），此时没有 token。它与
           reset 同属凭据自证型端点，风险面由「账号+原密码」与 IP 限流
           共同约束。 */
        bool anonOp = op == "register" || op == "login" || op == "forgot"
            || op == "reset" || op == "changepw" || op == "realms"
            || op == "hb";
        Session s = null;
        if (anonOp) {
            string ip = this.ctx.RemoteIp();
            if (!GameApi.anon.Allow(op + ":ip:" + ip, 5)) {
                this.TooMany();
                return null;
            }
        } else {
            int accountId = TokenBox.Resolve(m.Str("token", ""), now);
            if (accountId <= 0) {
                this.ctx.Status(401, "Unauthorized");
                this.ctx.Json("{\"ok\":0,\"err\":\"登录已过期，请重新登录\"}");
                return null;
            }
            if (!GameApi.ops.Allow("g:" + op + ":u"
                    + Convert.ToString(accountId), GameApi.OpMax(op))) {
                this.TooMany();
                return null;
            }
            if (!GameShared.WorldHere()) {
                /* 本 worker 不持有世界：整单中继给世界进程执行。token
                   认领与限流都发生在本进程（tokens 表跨 worker 共享），
                   世界进程只做会话查找与 op 执行。 */
                m.Set("gop", JsonValue.NewStr(op));
                JsonValue rr = await GameShared.WorldCall("game", m,
                    accountId);
                this.ctx.Json(rr.ToJson());
                return null;
            }
            s = World.ByAccount(accountId);
            if (s == null) {
                this.ctx.Status(401, "Unauthorized");
                this.ctx.Json("{\"ok\":0,\"err\":\"会话已失效，请重新登录\"}");
                return null;
            }
            s.lastSeen = now;
        }

        JsonValue r = await Gateway.Op(s, op, m, now, true, 0);
        if (r == null) { r = Gateway.Ok(); }
        this.ctx.Json(r.ToJson());
        return r;
    }

    void TooMany() {
        this.ctx.Status(429, "Too Many Requests");
        this.ctx.Json("{\"ok\":0,\"err\":\"操作过于频繁，请稍后再试\"}");
    }

    /* ---- 匿名端点（按 IP 限流） ---- */

    [HttpPost] [Description("注册")]
    async void Register() { JsonValue _r = await this.Run("register"); }

    [HttpPost] [Description("登录")]
    async void Login() { JsonValue _r = await this.Run("login"); }

    [HttpPost] [Description("密保问题")]
    async void Forgot() { JsonValue _r = await this.Run("forgot"); }

    [HttpPost] [Description("重置密码")]
    async void Reset() { JsonValue _r = await this.Run("reset"); }

    [HttpPost] [Description("修改密码")]
    async void Changepw() { JsonValue _r = await this.Run("changepw"); }

    [HttpPost] [Description("区服列表")]
    async void Realms() { JsonValue _r = await this.Run("realms"); }

    [HttpPost] [Description("心跳")]
    async void Hb() { JsonValue _r = await this.Run("hb"); }

    /* ---- 选角（token） ---- */

    [HttpPost] [Description("角色列表")]
    async void Characters() { JsonValue _r = await this.Run("characters"); }

    [HttpPost] [Description("删除角色")]
    async void Delchar() { JsonValue _r = await this.Run("delchar"); }

    [HttpPost] [Description("创建角色")]
    async void Create() { JsonValue _r = await this.Run("create"); }

    [HttpPost] [Description("进入区服")]
    async void Enter() { JsonValue _r = await this.Run("enter"); }

    /* ---- 世界交互（token，进区后） ---- */

    [HttpPost] [Description("我的状态")]
    async void State() { JsonValue _r = await this.Run("state"); }

    [HttpPost] [Description("地图列表")]
    async void Maps() { JsonValue _r = await this.Run("maps"); }

    [HttpPost] [Description("换图")]
    async void Move() { JsonValue _r = await this.Run("move"); }

    [HttpPost] [Description("行走")]
    async void Walk() { JsonValue _r = await this.Run("walk"); }

    [HttpPost] [Description("聊天")]
    async void Say() { JsonValue _r = await this.Run("say"); }

    [HttpPost] [Description("同图玩家")]
    async void Who() { JsonValue _r = await this.Run("who"); }

    [HttpPost] [Description("本图怪物")]
    async void Mobs() { JsonValue _r = await this.Run("mobs"); }

    [HttpPost] [Description("打一轮")]
    async void Hunt() { JsonValue _r = await this.Run("hunt"); }

    [HttpPost] [Description("挂机开关")]
    async void Auto() { JsonValue _r = await this.Run("auto"); }

    [HttpPost] [Description("内页BOSS面板")]
    async void Bossinfo() { JsonValue _r = await this.Run("bossinfo"); }

    [HttpPost] [Description("挑战BOSS")]
    async void Bossfight() { JsonValue _r = await this.Run("bossfight"); }

    [HttpPost] [Description("扫荡BOSS")]
    async void Bossweep() { JsonValue _r = await this.Run("bossweep"); }

    [HttpPost] [Description("背包")]
    async void Bag() { JsonValue _r = await this.Run("bag"); }

    [HttpPost] [Description("使用物品")]
    async void Use() { JsonValue _r = await this.Run("use"); }

    [HttpPost] [Description("穿戴")]
    async void Equip() { JsonValue _r = await this.Run("equip"); }

    [HttpPost] [Description("脱下")]
    async void Takeoff() { JsonValue _r = await this.Run("takeoff"); }

    [HttpPost] [Description("商店列表")]
    async void Shop() { JsonValue _r = await this.Run("shop"); }

    [HttpPost] [Description("购买")]
    async void Buy() { JsonValue _r = await this.Run("buy"); }

    [HttpPost] [Description("出售")]
    async void Sell() { JsonValue _r = await this.Run("sell"); }

    [HttpPost] [Description("BOSS列表")]
    async void Bosses() { JsonValue _r = await this.Run("bosses"); }

    [HttpPost] [Description("公告列表")]
    async void Announces() { JsonValue _r = await this.Run("announces"); }

    [HttpPost] [Description("排行榜")]
    async void Rank() { JsonValue _r = await this.Run("rank"); }

    [HttpPost] [Description("强化")]
    async void Forge() { JsonValue _r = await this.Run("forge"); }

    [HttpPost] [Description("世界BOSS")]
    async void Wboss() { JsonValue _r = await this.Run("wboss"); }

    [HttpPost] [Description("寻宝")]
    async void Draw() { JsonValue _r = await this.Run("draw"); }

    [HttpPost] [Description("回收")]
    async void Recycle() { JsonValue _r = await this.Run("recycle"); }

    [HttpPost] [Description("图鉴")]
    async void Codex() { JsonValue _r = await this.Run("codex"); }

    /* ---- 玩法页（Play 模块） ---- */

    [HttpPost] [Description("PK竞技场")]
    async void Arena() { JsonValue _r = await this.Run("arena"); }

    [HttpPost] [Description("押镖")]
    async void Escort() { JsonValue _r = await this.Run("escort"); }

    [HttpPost] [Description("行会")]
    async void Guild() { JsonValue _r = await this.Run("guild"); }

    [HttpPost] [Description("城池争夺")]
    async void Siege() { JsonValue _r = await this.Run("siege"); }

    [HttpPost] [Description("传说塔")]
    async void Tower() { JsonValue _r = await this.Run("tower"); }

    [HttpPost] [Description("五行修炼")]
    async void Wuxing() { JsonValue _r = await this.Run("wuxing"); }

    [HttpPost] [Description("师徒")]
    async void Mentor() { JsonValue _r = await this.Run("mentor"); }

    [HttpPost] [Description("祭坛")]
    async void Altar() { JsonValue _r = await this.Run("altar"); }

    [HttpPost] [Description("将星图谱")]
    async void Stars() { JsonValue _r = await this.Run("stars"); }

    [HttpPost] [Description("红包")]
    async void Redpack() { JsonValue _r = await this.Run("redpack"); }

    [HttpPost] [Description("交易市场")]
    async void Market() { JsonValue _r = await this.Run("market"); }

    [HttpPost] [Description("图鉴分页")]
    async void Codexpage() { JsonValue _r = await this.Run("codexpage"); }

    [HttpPost] [Description("称谓")]
    async void Title() { JsonValue _r = await this.Run("title"); }
}
