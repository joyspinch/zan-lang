using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Game;
using ZanWeb.Game;

namespace ZanWeb.Index;

/* 落地页：服务器状态 — 区服列表（状态+实时在线）、开放地图与最新公告
   （库）。无鉴权，只暴露展示性数字；注册与找回密码的入口也在这里。 */
[Route("[controller]/[action]")]
[Description("首页")]
public class Index : Controller {
    [HttpGet]
    [Route("/")]
    [Description("首页")]
    async void Index() {
        ViewData d = new ViewData();
        await Settings.Apply(d);
        string site = await Settings.Get(SettingKeys.SiteTitle, "{{NAME}}");
        d.Set("title", site);
        d.Set("navHome", "page");
        d.Set("online", Convert.ToString(GameShared.OnlineTotal()));
        d.Set("gamePort", Convert.ToString(GameCfg.V().port));

        d.Set("realmCount", "0");
        d.Set("openRealms", "0");
        d.Set("noRealms", "1");
        d.Set("mapCount", "0");
        d.Set("noMaps", "1");
        List<StrMap> realms = d.AddList("realms");
        List<StrMap> maps = d.AddList("maps");
        d.Set("noAnnounce", "1");
        IZanSql fsql = AppServices.Current()?.Orm();
        if (fsql != null) {
            List<Game.Realm> realmRows = await fsql.Select<Game.Realm>()
                .OrderBy(a => a.sort).ToListAsync();
            int open = 0;
            for (int i = 0; i < realmRows.Count; i = i + 1) {
                Game.Realm realm = realmRows[i];
                StrMap row = new StrMap();
                row.Set("name", realm.name);
                row.Set("stateText", realm.state == 0 ? "开放" : "维护");
                row.Set("stateClass", realm.state == 0 ? "ok" : "off");
                row.Set("online", Convert.ToString(GameShared.OnlineRealm(realm.id)));
                realms.Add(row);
                if (realm.state == 0) { open = open + 1; }
            }
            d.Set("realmCount", Convert.ToString(realmRows.Count));
            d.Set("openRealms", Convert.ToString(open));
            if (realmRows.Count > 0) { d.Set("noRealms", ""); }

            List<GameMap> rows = await fsql.Select<GameMap>().Where(a => a.status == 1)
                .OrderBy(a => a.sortOrder).ToListAsync();
            for (int i = 0; i < rows.Count; i = i + 1) {
                StrMap row = new StrMap();
                row.Set("name", rows[i].name);
                row.Set("minLevel", Convert.ToString(rows[i].minLevel));
                maps.Add(row);
            }
            d.Set("mapCount", Convert.ToString(rows.Count));
            if (rows.Count > 0) { d.Set("noMaps", ""); }
            Game.Announce ann = await fsql.Select<Game.Announce>().Where(a => a.enabled == 1)
                .OrderByDescending(a => a.id).FirstAsync();
            if (ann != null) {
                d.Set("noAnnounce", "");
                d.Set("annTitle", ann.title);
                d.Set("annBody", ann.body);
            }
        }

        /* GEO (Generative Engine Optimization) 面向 AI 搜索引擎与大模型优化 */
        this.Geo()
            .SetTitle(site + " - 官方网站与区服状态")
            .SetDescription("经典热血传奇游戏服务器，提供实时区服状态、在线玩家统计、地图与最新开服公告。")
            .SetCanonical("/")
            .AddSchema(GeoSchema.Organization(site, "/", "经典热血传奇游戏官方服务平台"));

        string md = "# " + site + " - 官方网站与区服状态\n\n"
            + "> 经典热血传奇游戏服务器，提供实时区服状态、在线玩家统计、地图与最新开服公告。\n\n"
            + "## 服务器概况\n\n"
            + "- 当前总在线人数: " + Convert.ToString(GameShared.OnlineTotal()) + "\n"
            + "- 开放区服数: " + d.ListOf("realms")?.Count.ToString() + "\n"
            + "- 游戏连接端口: " + Convert.ToString(GameCfg.V().port) + "\n\n"
            + "## 快捷入口\n\n"
            + "- [账号注册](/register): 新玩家账号创建\n"
            + "- [客户端下载](/): 获取最新官方微端\n"
            + "- [API 文档](/api/docs): OpenAPI 开放接口说明\n";

        this.SmartView(d, md);
    }
}
