using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Game;
using ZanWeb.Game;
using ZanWeb.Dao.Game;

namespace ZanWeb.Admin.Game;

/* /admin/game/players 角色管理：搜索、编辑、发奖、封禁账号、踢下线。
   角色属于区服，凭据与封禁在账号表——本页编辑角色，封禁作用于账号
   （拦下次登录）并踢掉在线会话。在线与离线角色走不同写路径：在线的
   权威状态在内存会话（World），编辑经 World.ApplyEdit/Adjust 生效并
   即时推送、随 tick 落库；离线角色直接改库。换区服对在线角色拒绝，
   先踢下线再改。 */
[Route("admin/game/players/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("角色管理")]
class Players : AdminController {
    [HttpGet]
    [Route("/admin/game/players")]
    [Custom(IsMenu = true, Icon = "mdi:account-group", Perm = PermBit.View)]
    [Description("角色管理")]
    async void Index() {
        ViewData d = await this.Layout("角色管理");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }

        ListQuery q = this.Paged("id", 20);
        string kw = q.Kw();
        int realmId = this.InInt("realm", 0);
        d.Set("realmFilter", Convert.ToString(realmId));

        int total = await this.Player
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(realmId > 0, a => a.realmId == realmId)
            .CountAsync();
        List<Player> rows = await this.Player
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .WhereIf(realmId > 0, a => a.realmId == realmId)
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();

        List<GameMap> maps = await this.GameMap.OrderBy(a => a.sortOrder)
            .ToListAsync();
        List<Realm> realms = await this.Realm.OrderBy(a => a.sort)
            .ToListAsync();
        List<StrMap> ropts = d.AddList("realms");
        for (int i = 0; i < realms.Count; i = i + 1) {
            StrMap o = new StrMap();
            o.Set("id", Convert.ToString(realms[i].id));
            o.Set("name", realms[i].name);
            if (realms[i].id == realmId) { o.Set("selected", "selected"); }
            ropts.Add(o);
        }
        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            Player p = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(p.id));
            row.Set("username", p.username);
            row.Set("nickname", Fmt.Dash(p.nickname));
            row.Set("realm", Players.RealmName(realms, p.realmId));
            row.Set("job", Players.JobText(p.job));
            row.Set("level", Convert.ToString(p.level));
            row.Set("gold", Convert.ToString(p.gold));
            row.Set("gems", Convert.ToString(p.gems));
            row.Set("map", Players.MapName(maps, p.mapId));
            row.Set("lastLoginAt", p.lastLoginAt > 0
                ? Fmt.Stamp(p.lastLoginAt) : "—");
            bool online = GameShared.PlayerOnline(p.id);
            row.Set("onlineText", online ? "在线" : "离线");
            row.Set("onlineClass", online ? "ok" : "off");
            items.Add(row);
        }
        this.Pager(d, q, total);
        this.Page(d);
    }

    /* 编辑对话框；在线角色的金币/元宝展示内存实时值，同时带出账号封禁态。 */
    [HttpGet]
    [Custom(Perm = PermBit.Update)]
    [Description("角色表单")]
    async void Form() {
        int id = this.InInt("id", 0);
        Player p = await this.Reach(id);
        /* 在线角色的实时值来自世界进程（本进程即世界时直读）；不在线
           或世界不可达时展示库值。 */
        JsonValue live = await GameShared.LivePlayer(id);
        long curGold = live != null ? live.Long("gold", p.gold) : p.gold;
        long curGems = live != null ? live.Long("gems", p.gems) : p.gems;
        int curMap = live != null ? live.Int("mapId", p.mapId) : p.mapId;
        int curLevel = live != null ? live.Int("level", p.level) : p.level;
        List<GameMap> maps = await this.GameMap.OrderBy(a => a.sortOrder)
            .ToListAsync();
        List<Realm> realms = await this.Realm.OrderBy(a => a.sort)
            .ToListAsync();
        List<Item> items = await this.Item.OrderBy(a => a.id).ToListAsync();
        Account acc = await this.Account.Where(a => a.id == p.accountId)
            .FirstAsync();

        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("username", p.username);
        d.Set("nickname", live != null ? live.Str("nickname", "") : p.nickname);
        d.Set("level", Convert.ToString(curLevel));
        d.Set("gold", Convert.ToString(curGold));
        d.Set("gems", Convert.ToString(curGems));
        d.Set("banReason", acc != null ? acc.banReason : "");
        d.Set("dialogTitle", "编辑角色 " + Fmt.Text(p.nickname, p.username));
        if (live != null) { d.Set("online", "1"); }
        if (acc != null && acc.status == 0) { d.Set("banned", "1"); }
        int job = live != null ? live.Int("job", p.job) : p.job;
        if (job == 1) { d.Set("job1", "selected"); }
        if (job == 2) { d.Set("job2", "selected"); }
        if (job == 0) { d.Set("job0", "selected"); }
        int curRealm = live != null && live.Int("realmId", 0) > 0
            ? live.Int("realmId", 0) : p.realmId;
        List<StrMap> ropts = d.AddList("realms");
        for (int i = 0; i < realms.Count; i = i + 1) {
            StrMap o = new StrMap();
            o.Set("id", Convert.ToString(realms[i].id));
            o.Set("name", realms[i].name);
            if (realms[i].id == curRealm) { o.Set("selected", "selected"); }
            ropts.Add(o);
        }
        List<StrMap> opts = d.AddList("maps");
        for (int i = 0; i < maps.Count; i = i + 1) {
            StrMap o = new StrMap();
            o.Set("id", Convert.ToString(maps[i].id));
            o.Set("name", maps[i].name + "（"
                + Convert.ToString(maps[i].minLevel) + " 级）");
            if (maps[i].id == curMap) { o.Set("selected", "selected"); }
            opts.Add(o);
        }
        List<StrMap> iopts = d.AddList("gifts");
        for (int i = 0; i < items.Count; i = i + 1) {
            StrMap o = new StrMap();
            o.Set("id", Convert.ToString(items[i].id));
            o.Set("name", items[i].name + "（"
                + Players.KindText(items[i].kind) + "）");
            iopts.Add(o);
        }
        this.Dialog(d);
    }

    static string KindText(int kind) {
        if (kind == 0) { return "消耗品"; }
        if (kind == 1) { return "武器"; }
        if (kind == 2) { return "防具"; }
        return "材料";
    }

    /* 保存：角色字段在线经 World（差量发奖 + 基本项），离线直写库；
       账号封禁总是写库，账号在线时同时踢出。在线角色换区服被拒绝。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("保存角色")]
    async void Save() {
        int id = this.InInt("id", 0);
        Player p = await this.Reach(id);
        bool isOnline = GameShared.PlayerOnline(id);
        string nickname = this.Need("nickname", "角色名");
        if (Fmt.CharCount(nickname) > 32) {
            this.Fail(400, "0003", "角色名最长 32 字");
        }
        int realmId = this.InInt("realmId", p.realmId);
        int level = this.InInt("level", 1);
        int job = this.InInt("job", 0);
        long gold = this.InLong("gold", 0);
        long gems = this.InLong("gems", 0);
        int mapId = this.InInt("mapId", 0);
        if (level < 1) { level = 1; }
        if (gold < 0) { gold = 0; }
        if (gems < 0) { gems = 0; }
        if (realmId != p.realmId && isOnline) {
            this.Fail(400, "0003", "该角色在线，先踢下线再换区服");
        }

        string changed = "";

        /* GM 送物品：随本次保存一起发放（giftItem=0 表示不发）。 */
        int giftItem = this.InInt("giftItem", 0);
        int giftCount = this.InInt("giftCount", 1);
        if (giftCount < 1) { giftCount = 1; }
        if (giftCount > 999) { giftCount = 999; }
        string gifted = "";

        /* 在线角色整单交给世界进程（本进程即世界时直调）：金币/元宝
           传绝对目标值，差量在世界侧对着实时内存值算，页面读不到的
           中间变化不会算偏。返回 false 视为刚下线，走库路径。 */
        bool appliedOnline = false;
        if (isOnline) {
            appliedOnline = await GameShared.SaveOnlinePlayer(id, level,
                job, mapId, nickname, gold, gems, giftItem, giftCount);
        }
        if (appliedOnline) {
            changed = "已应用到在线会话";
            if (giftItem > 0) { gifted = "已发放物品并推送"; }
        } else {
            p.hp = Fight.ClampHp(p);
            int n = await this.Player.Update()
                .Set(a => a.nickname, nickname)
                .Set(a => a.realmId, realmId)
                .Set(a => a.level, level)
                .Set(a => a.hp, p.hp)
                .Set(a => a.job, job)
                .Set(a => a.gold, gold)
                .Set(a => a.gems, gems)
                .Set(a => a.mapId, mapId)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            changed = n > 0 ? "已保存" : "无改动";
            if (giftItem > 0) {
                if (await Fight.GrantOffline(this.Held(), id, giftItem, giftCount)) {
                    gifted = "物品已写入背包（下次进区生效）";
                }
            }
        }
        if (gifted.Length > 0) { changed = changed + "；" + gifted; }

        /* 账号封禁：写账号表（拦下次登录），在线则踢出。 */
        int accStatus = this.InInt("accountStatus", 1);
        if (accStatus != 1) { accStatus = 0; }
        string banReason = this.In("banReason");
        if (accStatus == 0 && banReason.Length == 0) {
            this.Fail(400, "0003", "封禁必须填写原因");
        }
        Account acc = await this.Account.Where(a => a.id == p.accountId)
            .FirstAsync();
        if (acc != null && acc.status != accStatus) {
            AccountDao dao = new AccountDao(this.Held());
            int _b = await dao.SetStatus(acc.id, accStatus,
                accStatus == 0 ? banReason : "");
            if (accStatus == 0) {
                await GameShared.GmKick(acc.id,
                    "账号已被封禁：" + banReason);
                changed = "已封禁账号并踢下线";
            } else {
                changed = "账号已解封";
            }
        }

        await this.Note("保存角色", "#" + Convert.ToString(id) + " "
            + p.username, true, changed);
        this.Saved("角色已保存（" + changed + "）");
    }

    /* 踢下线：踢的是账号会话。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("踢下线")]
    async void Kick() {
        int id = this.InInt("id", 0);
        Player p = await this.Reach(id);
        bool hit = await GameShared.GmKick(p.accountId, "GM 强制下线");
        await this.Note("踢下线",
            "#" + Convert.ToString(id) + " " + p.username, hit,
            hit ? "" : "该账号不在线");
        if (!hit) { this.Saved("该账号当前不在线"); return; }
        this.Saved("已发送下线通知并断开连接");
    }

    /* 请求存在的角色；不存在答 404。 */
    async Player Reach(int id) {
        Player p = await this.Player.Where(a => a.id == id).FirstAsync();
        if (p == null) { this.Fail(404, "0404", "角色不存在"); }
        return p;
    }

    static string JobText(int job) {
        if (job == 1) { return "法师"; }
        if (job == 2) { return "道士"; }
        return "战士";
    }

    static string MapName(List<GameMap> maps, int id) {
        for (int i = 0; i < maps.Count; i = i + 1) {
            if (maps[i].id == id) { return maps[i].name; }
        }
        return "—";
    }

    static string RealmName(List<Realm> realms, int id) {
        for (int i = 0; i < realms.Count; i = i + 1) {
            if (realms[i].id == id) { return realms[i].name; }
        }
        return "#" + Convert.ToString(id);
    }
}
