using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Game;

namespace ZanWeb.Admin.Game;

/* /admin/game/skills 技能管理：三职业各 8 个模板（种子来自 M2.DB
   快照 skills 表原值——伤害/治疗系数、冷却、耗蓝、升级花费）。GM 在
   这里改数值；玩家已学等级在 game_player_skill，战斗结算见 Fight。 */
[Route("admin/game/skills/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("技能管理")]
class Skills : AdminController {
    [HttpGet]
    [Route("/admin/game/skills")]
    [Custom(IsMenu = true, Icon = "mdi:magic-staff", Perm = PermBit.View)]
    [Description("技能管理")]
    async void Index() {
        ViewData d = await this.Layout("技能管理");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }
        ListQuery q = this.Paged("job", 24);
        string kw = q.Kw();
        int job = this.InInt("job", -1);
        d.Set("jobFilter", Convert.ToString(job));

        int total = await this.Skill
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .WhereIf(job >= 0, a => a.job == job)
            .CountAsync();
        List<Skill> rows = await this.Skill
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .WhereIf(job >= 0, a => a.job == job)
            .OrderBy(a => a.job).OrderBy(a => a.slot)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();

        List<StrMap> jopts = d.AddList("jobs");
        string[] labels = new string[] { "全部职业", "战士", "法师", "道士" };
        for (int v = -1; v <= 2; v = v + 1) {
            StrMap o = new StrMap();
            o.Set("v", Convert.ToString(v));
            o.Set("name", labels[v + 1]);
            if (v == job) { o.Set("selected", "selected"); }
            jopts.Add(o);
        }
        List<StrMap> list = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            Skill s = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(s.id));
            row.Set("name", s.name);
            row.Set("job", Skills.JobName(s.job));
            row.Set("slot", Convert.ToString(s.slot));
            row.Set("kind", s.kind == "passive" ? "被动" : "主动");
            row.Set("kindClass", s.kind == "passive" ? "off" : "ok");
            row.Set("desc", Skills.Desc(s));
            row.Set("train", Convert.ToString(s.trainGold) + " 金 + "
                + Convert.ToString(s.trainIron) + " 铁");
            row.Set("onText", s.status == 1 ? "启用" : "停用");
            row.Set("onClass", s.status == 1 ? "ok" : "off");
            list.Add(row);
        }
        this.Pager(d, q, total);
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("技能表单")]
    async void Form() {
        int id = this.InInt("id", 0);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("dialogTitle", "新增技能");
        d.Set("new", "1");
        d.Set("on1", "selected");
        d.Set("job0", "selected");
        d.Set("kindA", "selected");
        d.Set("name", "");
        d.Set("job", "0");
        d.Set("slot", "0");
        d.Set("kind", "active");
        d.Set("cooldown", "4");
        d.Set("mana", "18");
        d.Set("damagePct", "100");
        d.Set("damagePerLevel", "12");
        d.Set("healPct", "0");
        d.Set("healPerLevel", "0");
        d.Set("passiveDamagePct", "0");
        d.Set("passiveDefensePct", "0");
        d.Set("maxLevel", "20");
        d.Set("trainGold", "120");
        d.Set("trainIron", "2");
        d.Set("school", "attack");
        d.Set("picture", "");
        if (id > 0) {
            Skill s = await this.Reach(id);
            d.Set("dialogTitle", "编辑技能 " + s.name);
            d.Set("name", s.name);
            d.Set("job", Convert.ToString(s.job));
            d.Set("slot", Convert.ToString(s.slot));
            d.Set("kind", s.kind);
            d.Set("cooldown", Convert.ToString(s.cooldown));
            d.Set("mana", Convert.ToString(s.mana));
            d.Set("damagePct", Convert.ToString(s.damagePct));
            d.Set("damagePerLevel", Convert.ToString(s.damagePerLevel));
            d.Set("healPct", Convert.ToString(s.healPct));
            d.Set("healPerLevel", Convert.ToString(s.healPerLevel));
            d.Set("passiveDamagePct", Convert.ToString(s.passiveDamagePct));
            d.Set("passiveDefensePct", Convert.ToString(s.passiveDefensePct));
            d.Set("maxLevel", Convert.ToString(s.maxLevel));
            d.Set("trainGold", Convert.ToString(s.trainGold));
            d.Set("trainIron", Convert.ToString(s.trainIron));
            d.Set("school", s.school);
            d.Set("picture", Fmt.Text(s.picture, ""));
            d.Set("edit", "1");
            d.Set("new", "");
            if (s.job == 1) { d.Set("job1", "selected"); }
            else if (s.job == 2) { d.Set("job2", "selected"); }
            else { d.Set("job0", "selected"); }
            if (s.kind == "passive") { d.Set("kindP", "selected"); }
            else { d.Set("kindA", "selected"); }
            if (s.status == 1) { d.Set("on1", "selected"); }
            else { d.Set("on0", "selected"); }
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存技能")]
    async void Save() {
        int id = this.InInt("id", 0);
        string name = this.Need("name", "技能名");
        if (Fmt.CharCount(name) > 32) {
            this.Fail(400, "0003", "技能名最长 32 字");
        }
        int job = this.InInt("job", 0);
        if (job < 0 || job > 2) { this.Fail(400, "0003", "职业不合法"); }
        int slot = this.InInt("slot", 0);
        if (slot < 0) { slot = 0; }
        if (slot > 7) { slot = 7; }
        string kind = this.In("kind").Trim();
        if (kind != "passive") { kind = "active"; }
        string target = kind == "passive" ? "self" : "enemy";
        int cooldown = this.InInt("cooldown", 0);
        if (cooldown < 0) { cooldown = 0; }
        int mana = this.InInt("mana", 0);
        if (mana < 0) { mana = 0; }
        int damagePct = this.InInt("damagePct", 0);
        if (damagePct < 0) { damagePct = 0; }
        int damagePerLevel = this.InInt("damagePerLevel", 0);
        if (damagePerLevel < 0) { damagePerLevel = 0; }
        int healPct = this.InInt("healPct", 0);
        if (healPct < 0) { healPct = 0; }
        int healPerLevel = this.InInt("healPerLevel", 0);
        if (healPerLevel < 0) { healPerLevel = 0; }
        int passiveDamagePct = this.InInt("passiveDamagePct", 0);
        if (passiveDamagePct < 0) { passiveDamagePct = 0; }
        int passiveDefensePct = this.InInt("passiveDefensePct", 0);
        if (passiveDefensePct < 0) { passiveDefensePct = 0; }
        int maxLevel = this.InInt("maxLevel", 20);
        if (maxLevel < 1) { maxLevel = 1; }
        long trainGold = this.InLong("trainGold", 0);
        if (trainGold < 0) { trainGold = 0; }
        int trainIron = this.InInt("trainIron", 0);
        if (trainIron < 0) { trainIron = 0; }
        string school = this.In("school").Trim();
        if (Fmt.CharCount(school) > 16) {
            this.Fail(400, "0003", "流派名最长 16 字符");
        }
        string picture = this.In("picture").Trim();
        if (Fmt.CharCount(picture) > 64) {
            this.Fail(400, "0003", "美术键最长 64 字符");
        }
        int status = this.InInt("status", 1);
        if (status != 1) { status = 0; }

        if (id > 0) {
            Skill have = await this.Reach(id);
            int n = await this.Skill.Update()
                .Set(a => a.name, name)
                .Set(a => a.job, job)
                .Set(a => a.slot, slot)
                .Set(a => a.kind, kind)
                .Set(a => a.target, target)
                .Set(a => a.cooldown, cooldown)
                .Set(a => a.mana, mana)
                .Set(a => a.damagePct, damagePct)
                .Set(a => a.damagePerLevel, damagePerLevel)
                .Set(a => a.healPct, healPct)
                .Set(a => a.healPerLevel, healPerLevel)
                .Set(a => a.passiveDamagePct, passiveDamagePct)
                .Set(a => a.passiveDefensePct, passiveDefensePct)
                .Set(a => a.maxLevel, maxLevel)
                .Set(a => a.trainGold, trainGold)
                .Set(a => a.trainIron, trainIron)
                .Set(a => a.school, school)
                .Set(a => a.picture, picture)
                .Set(a => a.status, status)
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            await this.Note("编辑技能", "#" + Convert.ToString(id)
                + " " + have.name, n > 0, "");
            this.Saved("技能已保存");
            return;
        }
        Skill row = new Skill();
        row.name = name;
        row.job = job;
        row.slot = slot;
        row.kind = kind;
        row.target = target;
        row.cooldown = cooldown;
        row.mana = mana;
        row.damagePct = damagePct;
        row.damagePerLevel = damagePerLevel;
        row.healPct = healPct;
        row.healPerLevel = healPerLevel;
        row.passiveDamagePct = passiveDamagePct;
        row.passiveDefensePct = passiveDefensePct;
        row.maxLevel = maxLevel;
        row.trainGold = trainGold;
        row.trainIron = trainIron;
        row.school = school;
        row.picture = picture;
        row.status = status;
        int newId = await this.Skill.Insert(row).ExecuteIdentityAsync();
        await this.Note("新增技能", "#" + Convert.ToString(newId)
            + " " + name, newId > 0, "");
        this.Saved("技能已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除技能")]
    async void Delete() {
        int id = this.InInt("id", 0);
        Skill have = await this.Reach(id);
        int n = await this.Skill.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        /* 已学等级随模板走：孤儿等级没人结算。 */
        int _ns = await this.PlayerSkill.Delete()
            .Where(a => a.skillId == id).ExecuteAffrowsAsync();
        await this.Note("删除技能", "#" + Convert.ToString(id)
            + " " + have.name, n > 0, "");
        this.Saved("技能已删除");
    }

    async Skill Reach(int id) {
        Skill s = await this.Skill.Where(a => a.id == id).FirstAsync();
        if (s == null) { this.Fail(404, "0404", "技能不存在"); }
        return s;
    }

    static string JobName(int job) {
        if (job == 1) { return "法师"; }
        if (job == 2) { return "道士"; }
        return "战士";
    }

    /* 一句话数值：主动 = 系数%+每级%、冷却/耗蓝；被动 = 每级攻/防%。 */
    static string Desc(Skill s) {
        if (s.kind == "passive") {
            return "被动：每级 +" + Convert.ToString(s.passiveDamagePct)
                + "% 伤害 +" + Convert.ToString(s.passiveDefensePct) + "% 防御";
        }
        string heal = s.healPct > 0
            ? " 回血 " + Convert.ToString(s.healPct) + "%+" + Convert.ToString(s.healPerLevel) + "/级"
            : "";
        return "主动：" + Convert.ToString(s.damagePct) + "%+"
            + Convert.ToString(s.damagePerLevel) + "/级 冷却 "
            + Convert.ToString(s.cooldown) + "s 耗蓝 "
            + Convert.ToString(s.mana) + heal;
    }
}
