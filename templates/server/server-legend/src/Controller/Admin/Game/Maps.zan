using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Game;

namespace ZanWeb.Admin.Game;

/* /admin/game/maps 地图管理：增删改。种子来自 M2.DB 快照 gamemap
   （35 张原值）。minLevel 是进入门槛（网关在 move 时校验），
   sortOrder 决定客户端列表顺序（种子=快照 id）。picture 是美术键，
   对应客户端地图缩略图。停用的地图拒绝进入，列表仍可见。 */
[Route("admin/game/maps/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("地图管理")]
class Maps : AdminController {
    [HttpGet]
    [Route("/admin/game/maps")]
    [Custom(IsMenu = true, Icon = "mdi:map", Perm = PermBit.View)]
    [Description("地图管理")]
    async void Index() {
        ViewData d = await this.Layout("地图管理");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }
        ListQuery q = this.Paged("sortOrder", 20);
        string kw = q.Kw();
        int total = await this.GameMap
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .CountAsync();
        List<GameMap> rows = await this.GameMap
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .OrderBy(a => a.sortOrder)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();

        List<Mob> mobs = await this.Mob.ToListAsync();
        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            GameMap m = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(m.id));
            row.Set("name", m.name);
            row.Set("minLevel", Convert.ToString(m.minLevel));
            row.Set("sortOrder", Convert.ToString(m.sortOrder));
            row.Set("picture", Fmt.Dash(m.picture));
            row.Set("spawns", Convert.ToString(Maps.SpawnCount(mobs, m.id)));
            row.Set("onText", m.status == 1 ? "开放" : "维护");
            row.Set("onClass", m.status == 1 ? "ok" : "bad");
            items.Add(row);
        }
        this.Pager(d, q, total);
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("地图表单")]
    async void Form() {
        int id = this.InInt("id", 0);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("dialogTitle", "新增地图");
        d.Set("new", "1");
        d.Set("on1", "selected");
        d.Set("minLevel", "1");
        d.Set("sortOrder", "10");
        d.Set("picture", "");
        if (id > 0) {
            GameMap m = await this.Reach(id);
            d.Set("dialogTitle", "编辑地图 " + m.name);
            d.Set("name", m.name);
            d.Set("minLevel", Convert.ToString(m.minLevel));
            d.Set("sortOrder", Convert.ToString(m.sortOrder));
            d.Set("picture", Fmt.Text(m.picture, ""));
            d.Set("edit", "1");
            d.Set("new", "");
            if (m.status == 1) { d.Set("on1", "selected"); }
            else { d.Set("on0", "selected"); }
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存地图")]
    async void Save() {
        int id = this.InInt("id", 0);
        string name = this.Need("name", "地图名");
        if (Fmt.CharCount(name) > 64) {
            this.Fail(400, "0003", "地图名最长 64 字");
        }
        int minLevel = this.InInt("minLevel", 1);
        int sortOrder = this.InInt("sortOrder", 10);
        if (minLevel < 1) { minLevel = 1; }
        if (sortOrder < 0) { sortOrder = 0; }
        string picture = this.In("picture").Trim();
        if (Fmt.CharCount(picture) > 64) {
            this.Fail(400, "0003", "美术键最长 64 字符");
        }
        int status = this.InInt("status", 1);
        if (status != 1) { status = 0; }

        if (id > 0) {
            GameMap have = await this.Reach(id);
            int n = await this.GameMap.Update()
                .Set(a => a.name, name)
                .Set(a => a.minLevel, minLevel)
                .Set(a => a.sortOrder, sortOrder)
                .Set(a => a.picture, picture)
                .Set(a => a.status, status)
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            await this.Note("编辑地图", "#" + Convert.ToString(id)
                + " " + have.name, n > 0, "");
            this.Saved("地图已保存");
            return;
        }
        GameMap row = new GameMap();
        row.name = name;
        row.minLevel = minLevel;
        row.sortOrder = sortOrder;
        row.picture = picture;
        row.status = status;
        int newId = await this.GameMap.Insert(row).ExecuteIdentityAsync();
        await this.Note("新增地图", "#" + Convert.ToString(newId)
            + " " + name, newId > 0, "");
        this.Saved("地图已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除地图")]
    async void Delete() {
        int id = this.InInt("id", 0);
        GameMap have = await this.Reach(id);
        int spawns = await this.Mob.Where(a => a.mapId == id).CountAsync();
        if (spawns > 0) {
            this.Fail(400, "0003", "地图上还有 "
                + Convert.ToString(spawns) + " 个刷怪点，先迁走或删除");
        }
        int n = await this.GameMap.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Note("删除地图", "#" + Convert.ToString(id)
            + " " + have.name, n > 0, "");
        this.Saved("地图已删除");
    }

    async GameMap Reach(int id) {
        GameMap m = await this.GameMap.Where(a => a.id == id).FirstAsync();
        if (m == null) { this.Fail(404, "0404", "地图不存在"); }
        return m;
    }

    static int SpawnCount(List<Mob> mobs, int mapId) {
        int n = 0;
        for (int i = 0; i < mobs.Count; i = i + 1) {
            if (mobs[i].mapId == mapId) { n = n + 1; }
        }
        return n;
    }
}
