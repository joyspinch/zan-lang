using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Game;
using ZanWeb.Game;

namespace ZanWeb.Admin.Game;

/* /admin/game/announces 公告管理：增删改 + 一键推送。启用中的公告在
   玩家登录时随 login 应答下发；「推送」把指定公告即时发给全部在线
   会话（World.PushAnnounce）。 */
[Route("admin/game/announces/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("公告管理")]
class Announces : AdminController {
    [HttpGet]
    [Route("/admin/game/announces")]
    [Custom(IsMenu = true, Icon = "mdi:bullhorn", Perm = PermBit.View)]
    [Description("公告管理")]
    async void Index() {
        ViewData d = await this.Layout("公告管理");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }
        List<Announce> rows = await this.Announce
            .OrderByDescending(a => a.id).ToListAsync();
        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            Announce a = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(a.id));
            row.Set("title", a.title);
            row.Set("body", a.body);
            row.Set("author", Fmt.Dash(a.author));
            row.Set("createdAt", Fmt.Stamp(a.createdAt));
            row.Set("onText", a.enabled == 1 ? "启用" : "停用");
            row.Set("onClass", a.enabled == 1 ? "ok" : "off");
            items.Add(row);
        }
        if (rows.Count == 0) { d.Set("empty", "1"); }
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("公告表单")]
    async void Form() {
        int id = this.InInt("id", 0);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("dialogTitle", "发布公告");
        d.Set("new", "1");
        d.Set("on1", "selected");
        if (id > 0) {
            Announce a = await this.Reach(id);
            d.Set("dialogTitle", "编辑公告");
            d.Set("title", a.title);
            d.Set("body", a.body);
            d.Set("edit", "1");
            d.Set("new", "");
            d.Set("on1", "");
            if (a.enabled == 1) { d.Set("on1", "selected"); }
            else { d.Set("on0", "selected"); }
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存公告")]
    async void Save() {
        int id = this.InInt("id", 0);
        string title = this.Need("title", "标题");
        string body = this.Need("body", "正文");
        if (title.Length > 128) {
            this.Fail(400, "0003", "标题最长 128 字符");
        }
        if (body.Length > 512) {
            this.Fail(400, "0003", "正文最长 512 字符");
        }
        int enabled = this.InInt("enabled", 1);
        if (enabled != 1) { enabled = 0; }

        if (id > 0) {
            Announce have = await this.Reach(id);
            int n = await this.Announce.Update()
                .Set(a => a.title, title)
                .Set(a => a.body, body)
                .Set(a => a.enabled, enabled)
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            await this.Note("编辑公告", "#" + Convert.ToString(id)
                + " " + have.title, n > 0, "");
            this.Saved("公告已保存");
            return;
        }
        Announce row = new Announce();
        row.title = title;
        row.body = body;
        row.enabled = enabled;
        row.author = this.who != null ? this.who.username : "gm";
        row.createdAt = WebApp.NowSeconds();
        int newId = await this.Announce.Insert(row).ExecuteIdentityAsync();
        await this.Note("发布公告", "#" + Convert.ToString(newId)
            + " " + title, newId > 0, "");
        this.Saved("公告已发布");
    }

    /* 一键推送：把这条公告发给全部在线会话。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("推送公告")]
    async void Push() {
        int id = this.InInt("id", 0);
        Announce a = await this.Reach(id);
        if (a.enabled != 1) {
            this.Fail(400, "0003", "公告已停用，先启用再推送");
        }
        int hit = await GameShared.GmAnnounce(a.title, a.body);
        await this.Note("推送公告", "#" + Convert.ToString(id)
            + " " + a.title, hit >= 0,
            hit >= 0 ? Convert.ToString(hit) + " 人在线" : "世界进程未响应");
        if (hit < 0) { this.Saved("世界进程未响应，请稍后再试"); return; }
        this.Saved("已推送给 " + Convert.ToString(hit) + " 个在线会话");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除公告")]
    async void Delete() {
        int id = this.InInt("id", 0);
        Announce have = await this.Reach(id);
        int n = await this.Announce.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Note("删除公告", "#" + Convert.ToString(id)
            + " " + have.title, n > 0, "");
        this.Saved("公告已删除");
    }

    async Announce Reach(int id) {
        Announce a = await this.Announce.Where(a => a.id == id).FirstAsync();
        if (a == null) { this.Fail(404, "0404", "公告不存在"); }
        return a;
    }
}
