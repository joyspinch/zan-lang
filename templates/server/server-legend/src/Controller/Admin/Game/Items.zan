using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Game;
using ZanWeb.Model.Game;

namespace ZanWeb.Admin.Game;

/* /admin/game/items 物品目录：搜索、增删改。目录由 M2.DB 快照整表
   种入（迷你传奇 data.dll 原值 732 条），后台改的就是运行时目录——
   商店、掉落、背包都读这张表。picture 是美术键，对应客户端物品图
   item/NNNNN.png；改数值即时生效，无需重启。 */
[Route("admin/game/items/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("物品管理")]
class Items : AdminController {
    [HttpGet]
    [Route("/admin/game/items")]
    [Custom(IsMenu = true, Icon = "mdi:sword", Perm = PermBit.View)]
    [Description("物品管理")]
    async void Index() {
        ViewData d = await this.Layout("物品管理");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }
        ListQuery q = this.Paged("id", 20);
        string kw = q.Kw();
        int kind = this.InInt("kind", -1);
        d.Set("kindFilter", Convert.ToString(kind));

        int total = await this.Item
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .WhereIf(kind >= 0, a => a.kind == kind)
            .CountAsync();
        List<Item> rows = await this.Item
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .WhereIf(kind >= 0, a => a.kind == kind)
            .OrderBy(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();

        List<StrMap> kopts = d.AddList("kinds");
        List<int> kindVals = new List<int>();
        kindVals.Add(-1);
        kindVals.Add(0);
        kindVals.Add(1);
        kindVals.Add(2);
        kindVals.Add(3);
        for (int i = 0; i < kindVals.Count; i = i + 1) {
            StrMap o = new StrMap();
            o.Set("id", Convert.ToString(kindVals[i]));
            o.Set("name", kindVals[i] < 0 ? "全部类型"
                : Items.KindText(kindVals[i]));
            if (kindVals[i] == kind) { o.Set("selected", "selected"); }
            kopts.Add(o);
        }
        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            Item it = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(it.id));
            row.Set("name", it.name);
            row.Set("kindText", Items.KindText(it.kind));
            row.Set("kindClass", Items.KindClass(it.kind));
            row.Set("atk", Convert.ToString(it.atk));
            row.Set("def", Convert.ToString(it.def));
            row.Set("hp", Convert.ToString(it.hp));
            row.Set("price", Convert.ToString(it.price));
            row.Set("minLevel", Convert.ToString(it.minLevel));
            row.Set("picture", Fmt.Dash(it.picture));
            row.Set("onText", it.status == 1 ? "启用" : "停用");
            row.Set("onClass", it.status == 1 ? "ok" : "off");
            items.Add(row);
        }
        this.Pager(d, q, total);
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("物品表单")]
    async void Form() {
        int id = this.InInt("id", 0);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("dialogTitle", "新增物品");
        d.Set("new", "1");
        d.Set("kind0", "selected");
        d.Set("on1", "selected");
        if (id > 0) {
            Item it = await this.Reach(id);
            d.Set("dialogTitle", "编辑物品 " + it.name);
            d.Set("name", it.name);
            d.Set("atk", Convert.ToString(it.atk));
            d.Set("def", Convert.ToString(it.def));
            d.Set("hp", Convert.ToString(it.hp));
            d.Set("price", Convert.ToString(it.price));
            d.Set("minLevel", Convert.ToString(it.minLevel));
            d.Set("picture", Fmt.Text(it.picture, ""));
            d.Set("edit", "1");
            d.Set("new", "");
            d.Set("kind0", "");
            if (it.kind == 0) { d.Set("kind0", "selected"); }
            if (it.kind == 1) { d.Set("kind1", "selected"); }
            if (it.kind == 2) { d.Set("kind2", "selected"); }
            if (it.kind == 3) { d.Set("kind3", "selected"); }
            if (it.status == 1) { d.Set("on1", "selected"); }
            else { d.Set("on0", "selected"); }
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存物品")]
    async void Save() {
        int id = this.InInt("id", 0);
        string name = this.Need("name", "名称");
        if (Fmt.CharCount(name) > 32) {
            this.Fail(400, "0003", "名称最长 32 字");
        }
        int kind = this.InInt("kind", 0);
        if (kind < 0 || kind > 3) { kind = 3; }
        int atk = this.InInt("atk", 0);
        int def = this.InInt("def", 0);
        int hp = this.InInt("hp", 0);
        long price = this.InLong("price", 0);
        int minLevel = this.InInt("minLevel", 0);
        if (atk < 0) { atk = 0; }
        if (def < 0) { def = 0; }
        if (hp < 0) { hp = 0; }
        if (price < 0) { price = 0; }
        if (minLevel < 0) { minLevel = 0; }
        string picture = this.In("picture").Trim();
        if (Fmt.CharCount(picture) > 64) {
            this.Fail(400, "0003", "美术键最长 64 字符");
        }
        int status = this.InInt("status", 1);
        if (status != 1) { status = 0; }

        string brief = name + " " + Items.KindText(kind);
        if (id > 0) {
            Item have = await this.Reach(id);
            int n = await this.Item.Update()
                .Set(a => a.name, name)
                .Set(a => a.kind, kind)
                .Set(a => a.atk, atk)
                .Set(a => a.def, def)
                .Set(a => a.hp, hp)
                .Set(a => a.price, price)
                .Set(a => a.minLevel, minLevel)
                .Set(a => a.picture, picture)
                .Set(a => a.status, status)
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            await this.Note("编辑物品", "#" + Convert.ToString(id)
                + " " + have.name, n > 0, "");
            Fight.ReloadCatalog();
            this.Saved("物品已保存，战斗内存已热重载");
            return;
        }
        Item row = new Item();
        row.name = name;
        row.kind = kind;
        row.atk = atk;
        row.def = def;
        row.hp = hp;
        row.price = price;
        row.minLevel = minLevel;
        row.picture = picture;
        row.status = status;
        int newId = await this.Item.Insert(row).ExecuteIdentityAsync();
        await this.Note("新增物品", "#" + Convert.ToString(newId)
            + " " + brief, newId > 0, "");
        Fight.ReloadCatalog();
        this.Saved("物品已创建，战斗内存已热重载");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除物品")]
    async void Delete() {
        int id = this.InInt("id", 0);
        Item have = await this.Reach(id);
        int n = await this.Item.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Note("删除物品", "#" + Convert.ToString(id)
            + " " + have.name, n > 0, "");
        Fight.ReloadCatalog();
        this.Saved("物品已删除，战斗内存已热重载");
    }

    async Item Reach(int id) {
        Item a = await this.Item.Where(a => a.id == id).FirstAsync();
        if (a == null) { this.Fail(404, "0404", "物品不存在"); }
        return a;
    }

    static string KindText(int kind) {
        if (kind == 0) { return "消耗品"; }
        if (kind == 1) { return "武器"; }
        if (kind == 2) { return "防具"; }
        return "材料";
    }

    static string KindClass(int kind) {
        if (kind == 1) { return "ok"; }
        if (kind == 2) { return "info"; }
        if (kind == 3) { return "off"; }
        return "warn";
    }
}
