using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Game;
using ZanWeb.Model.Game;

namespace ZanWeb.Admin.Game;

/* /admin/game/drops 爆率管理（怪物主视图）：左列怪物、右列它的掉落
   清单（game_drop），选中怪物一次看完+改完。概率用行内小表单直接改
   （rate 行内保存，不弹窗）；加条目用页内表单，删=×。保存即热重载
   战斗内存（Fight.ReloadCatalog），无需重启。 */
[Route("admin/game/drops/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("爆率管理")]
class Drops : AdminController {
    [HttpGet]
    [Route("/admin/game/drops")]
    [Custom(IsMenu = true, Icon = "mdi:dice-multiple", Perm = PermBit.View)]
    [Description("爆率管理")]
    async void Index() {
        ViewData d = await this.Layout("爆率管理");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }
        ListQuery q = this.Paged("mobId", 20);
        string kw = q.Kw();
        d.Set("kw", kw);

        /* 左列：怪物清单（搜索按怪名；页大小 20 与行内编辑高度匹配）。 */
        int total = await this.Mob
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .CountAsync();
        List<Mob> mobs = await this.Mob
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .OrderBy(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();

        /* 右列：当前选中怪的完整清单。选中 = ?sel=，缺省取本页第一只。 */
        int sel = this.InInt("sel", 0);
        if (sel <= 0 && mobs.Count > 0) { sel = mobs[0].id; }
        d.Set("sel", Convert.ToString(sel));
        Mob cur = null;
        for (int i = 0; i < mobs.Count; i = i + 1) {
            if (mobs[i].id == sel) { cur = mobs[i]; break; }
        }
        if (cur == null && sel > 0) {
            cur = await this.Mob.Where(a => a.id == sel).FirstAsync();
        }
        if (cur != null) { d.Set("selName", cur.name); }

        List<Item> items = await this.Item.OrderBy(a => a.id).ToListAsync();
        List<Drop> drops = cur != null
            ? await this.Drop.Where(a => a.mobId == cur.id)
                .OrderBy(a => a.sort).ToListAsync()
            : new List<Drop>();
        d.Set("selCount", Convert.ToString(drops.Count));
        List<StrMap> list = d.AddList("rows");
        for (int i = 0; i < drops.Count; i = i + 1) {
            Drop dr = drops[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(dr.id));
            row.Set("item", Drops.ItemName(items, dr.itemId));
            row.Set("rate", Convert.ToString(dr.rate));
            row.Set("pct", Convert.ToString(dr.rate / 100) + "%");
            list.Add(row);
        }

        /* 左列怪物行：带条目数，选中高亮。 */
        List<Drop> all = await this.Drop.ToListAsync();
        List<int> dropIds = new List<int>();
        List<int> dropCounts = new List<int>();
        for (int i = 0; i < all.Count; i = i + 1) {
            int at = dropIds.IndexOf(all[i].mobId);
            if (at >= 0) {
                dropCounts[at] = dropCounts[at] + 1;
            } else {
                dropIds.Add(all[i].mobId);
                dropCounts.Add(1);
            }
        }
        List<StrMap> mrows = d.AddList("mobs");
        for (int i = 0; i < mobs.Count; i = i + 1) {
            Mob m = mobs[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(m.id));
            row.Set("name", m.name);
            row.Set("level", Convert.ToString(m.level));
            int at = dropIds.IndexOf(m.id);
            row.Set("n", at >= 0 ? Convert.ToString(dropCounts[at]) : "0");
            if (m.id == sel) { row.Set("on", "on"); }
            mrows.Add(row);
        }

        /* 加条目下拉：全物品档。 */
        List<StrMap> iopts = d.AddList("items");
        for (int i = 0; i < items.Count; i = i + 1) {
            StrMap o = new StrMap();
            o.Set("id", Convert.ToString(items[i].id));
            o.Set("name", items[i].name);
            iopts.Add(o);
        }
        this.Pager(d, q, total);
        d.Set("kwRaw", kw);
        this.Page(d);
    }

    /* 行内改概率：payload {id, rate}。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("改爆率")]
    async void Rate() {
        int id = this.InInt("id", 0);
        int rate = this.InInt("rate", 0);
        Drop dr = await this.Reach(id);
        if (rate < 1) { rate = 1; }
        if (rate > 10000) { rate = 10000; }
        int n = await this.Drop.Update()
            .Set(a => a.rate, rate)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Note("改爆率", dr.mobId + "号怪 条目#" + Convert.ToString(id)
            + " → " + Convert.ToString(rate) + "/万", n > 0, "");
        Fight.ReloadCatalog();
        this.Saved("概率已改为 " + Convert.ToString(rate) + "/万，已热重载");
    }

    /* 页内加条目：mob/item/rate。 */
    [HttpPost]
    [Custom(Perm = PermBit.Create)]
    [Description("加掉落")]
    async void Add() {
        int mobId = this.InInt("mobId", 0);
        int itemId = this.InInt("itemId", 0);
        int rate = this.InInt("rate", 1000);
        Mob mob = await this.Mob.Where(a => a.id == mobId).FirstAsync();
        if (mob == null) { this.Fail(400, "0003", "刷怪点不存在"); }
        Item item = await this.Item.Where(a => a.id == itemId).FirstAsync();
        if (item == null) { this.Fail(400, "0003", "物品不存在"); }
        if (rate < 1) { rate = 1; }
        if (rate > 10000) { rate = 10000; }
        int sort = 0;
        List<Drop> have = await this.Drop
            .Where(a => a.mobId == mobId).ToListAsync();
        for (int i = 0; i < have.Count; i = i + 1) {
            if (have[i].sort >= sort) { sort = have[i].sort + 1; }
        }
        Drop row = new Drop();
        row.mobId = mobId;
        row.itemId = itemId;
        row.rate = rate;
        row.sort = sort;
        int newId = await this.Drop.Insert(row).ExecuteIdentityAsync();
        await this.Note("加掉落", mob.name + " ← " + item.name
            + " " + Convert.ToString(rate) + "/万", newId > 0, "");
        Fight.ReloadCatalog();
        this.Saved("已加 " + item.name + "，已热重载");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删掉落")]
    async void Delete() {
        int id = this.InInt("id", 0);
        Drop have = await this.Reach(id);
        int n = await this.Drop.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Note("删掉落", "#" + Convert.ToString(id), n > 0, "");
        Fight.ReloadCatalog();
        this.Saved("已删除，已热重载");
    }

    async Drop Reach(int id) {
        Drop d = await this.Drop.Where(a => a.id == id).FirstAsync();
        if (d == null) { this.Fail(404, "0404", "掉落不存在"); }
        return d;
    }

    static string ItemName(List<Item> items, int itemId) {
        for (int i = 0; i < items.Count; i = i + 1) {
            if (items[i].id == itemId) { return items[i].name; }
        }
        return "—" + Convert.ToString(itemId);
    }
}
