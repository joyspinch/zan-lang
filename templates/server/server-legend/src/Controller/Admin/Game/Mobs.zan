using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Game;
using ZanWeb.Model.Game;

namespace ZanWeb.Admin.Game;

/* /admin/game/mobs 刷怪点管理：搜索、按图筛选、增删改。一行 = 一个
   刷怪点（同图 count 只同名怪，respawnSec 秒重生），种子来自 M2.DB
   快照的 gamemap×gamemonster 结构。掉落清单在「爆率管理」页按怪维护
   （game_drop，一怪多条）；战斗实例态在内存，改数值后重启或等重生
   生效。 */
[Route("admin/game/mobs/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("刷怪管理")]
class Mobs : AdminController {
    [HttpGet]
    [Route("/admin/game/mobs")]
    [Custom(IsMenu = true, Icon = "mdi:bug", Perm = PermBit.View)]
    [Description("刷怪管理")]
    async void Index() {
        ViewData d = await this.Layout("刷怪管理");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }
        ListQuery q = this.Paged("id", 20);
        string kw = q.Kw();
        int mapId = this.InInt("map", 0);
        d.Set("mapFilter", Convert.ToString(mapId));

        int total = await this.Mob
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .WhereIf(mapId > 0, a => a.mapId == mapId)
            .CountAsync();
        List<Mob> rows = await this.Mob
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .WhereIf(mapId > 0, a => a.mapId == mapId)
            .OrderBy(a => a.mapId).OrderBy(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();

        List<GameMap> maps = await this.GameMap.OrderBy(a => a.sortOrder)
            .ToListAsync();
        List<StrMap> mopts = d.AddList("maps");
        for (int i = 0; i < maps.Count; i = i + 1) {
            StrMap o = new StrMap();
            o.Set("id", Convert.ToString(maps[i].id));
            o.Set("name", maps[i].name + "（"
                + Convert.ToString(maps[i].minLevel) + " 级）");
            if (maps[i].id == mapId) { o.Set("selected", "selected"); }
            mopts.Add(o);
        }
        /* 爆率条目计数：整表轻量读（几千行）按 mobId 并列计数，
           比每行一个 Count 查询省事。 */
        List<Drop> allDrops = await this.Drop.ToListAsync();
        List<int> dropIds = new List<int>();
        List<int> dropCounts = new List<int>();
        for (int i = 0; i < allDrops.Count; i = i + 1) {
            int at = dropIds.IndexOf(allDrops[i].mobId);
            if (at >= 0) {
                dropCounts[at] = dropCounts[at] + 1;
            } else {
                dropIds.Add(allDrops[i].mobId);
                dropCounts.Add(1);
            }
        }
        List<StrMap> mobs = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            Mob m = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(m.id));
            row.Set("name", m.name);
            row.Set("map", Mobs.MapName(maps, m.mapId));
            row.Set("level", Convert.ToString(m.level));
            row.Set("hp", Convert.ToString(m.hp));
            row.Set("atk", Convert.ToString(m.atk));
            row.Set("def", Convert.ToString(m.def));
            row.Set("exp", Convert.ToString(m.exp));
            row.Set("gold", Convert.ToString(m.goldMin) + ".."
                + Convert.ToString(m.goldMax));
            row.Set("respawn", Convert.ToString(m.respawnSec));
            row.Set("count", Convert.ToString(m.count));
            int at = dropIds.IndexOf(m.id);
            row.Set("drops", at >= 0
                ? Convert.ToString(dropCounts[at]) + " 条" : "—");
            row.Set("onText", m.status == 1 ? "启用" : "停用");
            row.Set("onClass", m.status == 1 ? "ok" : "off");
            mobs.Add(row);
        }
        this.Pager(d, q, total);
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("刷怪点表单")]
    async void Form() {
        int id = this.InInt("id", 0);
        int selMap = id > 0 ? 0 : this.InInt("map", 0);
        List<GameMap> maps = await this.GameMap.OrderBy(a => a.sortOrder)
            .ToListAsync();
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("dialogTitle", "新增刷怪点");
        d.Set("new", "1");
        d.Set("on1", "selected");
        d.Set("level", "1");
        d.Set("hp", "100");
        d.Set("atk", "10");
        d.Set("def", "5");
        d.Set("exp", "10");
        d.Set("goldMin", "5");
        d.Set("goldMax", "20");
        d.Set("respawnSec", "10");
        d.Set("count", "4");
        d.Set("picture", "");
        if (id > 0) {
            Mob m = await this.Reach(id);
            selMap = m.mapId;
            d.Set("dialogTitle", "编辑刷怪点 " + m.name);
            d.Set("name", m.name);
            d.Set("level", Convert.ToString(m.level));
            d.Set("hp", Convert.ToString(m.hp));
            d.Set("atk", Convert.ToString(m.atk));
            d.Set("def", Convert.ToString(m.def));
            d.Set("exp", Convert.ToString(m.exp));
            d.Set("goldMin", Convert.ToString(m.goldMin));
            d.Set("goldMax", Convert.ToString(m.goldMax));
            d.Set("respawnSec", Convert.ToString(m.respawnSec));
            d.Set("count", Convert.ToString(m.count));
            d.Set("picture", Fmt.Text(m.picture, ""));
            d.Set("edit", "1");
            d.Set("new", "");
            if (m.status == 1) { d.Set("on1", "selected"); }
            else { d.Set("on0", "selected"); }
        }
        List<StrMap> mopts = d.AddList("maps");
        for (int i = 0; i < maps.Count; i = i + 1) {
            StrMap o = new StrMap();
            o.Set("id", Convert.ToString(maps[i].id));
            o.Set("name", maps[i].name + "（"
                + Convert.ToString(maps[i].minLevel) + " 级）");
            if (maps[i].id == selMap) { o.Set("selected", "selected"); }
            mopts.Add(o);
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("行内改属性")]
    async void Stat() {
        int id = this.InInt("id", 0);
        Mob have = await this.Reach(id);
        string field = this.In("field").Trim();
        int val = this.InInt("val", 0);
        int n = 0;
        if (field == "hp") {
            if (val < 1) { val = 1; }
            n = await this.Mob.Update().Set(a => a.hp, val)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
        } else if (field == "atk") {
            if (val < 0) { val = 0; }
            n = await this.Mob.Update().Set(a => a.atk, val)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
        } else if (field == "def") {
            if (val < 0) { val = 0; }
            n = await this.Mob.Update().Set(a => a.def, val)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
        } else if (field == "exp") {
            if (val < 0) { val = 0; }
            n = await this.Mob.Update().Set(a => a.exp, val)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
        } else if (field == "level") {
            if (val < 1) { val = 1; }
            n = await this.Mob.Update().Set(a => a.level, val)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
        } else {
            this.Fail(400, "0003", "未知字段");
        }
        await this.Note("改怪物属性", have.name + " " + field + "→"
            + Convert.ToString(val), n > 0, "");
        Fight.ReloadCatalog();
        this.Saved(have.name + " " + field + " 已改为 " + Convert.ToString(val)
            + "，战斗内存已热重载");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存刷怪点")]
    async void Save() {
        int id = this.InInt("id", 0);
        string name = this.Need("name", "怪物名");
        if (Fmt.CharCount(name) > 32) {
            this.Fail(400, "0003", "怪物名最长 32 字");
        }
        int mapId = this.InInt("mapId", 0);
        GameMap map = await this.GameMap.Where(a => a.id == mapId)
            .FirstAsync();
        if (map == null) { this.Fail(400, "0003", "地图不存在"); }
        int level = this.InInt("level", 1);
        int hp = this.InInt("hp", 1);
        int atk = this.InInt("atk", 0);
        int def = this.InInt("def", 0);
        int exp = this.InInt("exp", 0);
        long goldMin = this.InLong("goldMin", 0);
        long goldMax = this.InLong("goldMax", 0);
        int respawnSec = this.InInt("respawnSec", 10);
        int count = this.InInt("count", 4);
        if (level < 1) { level = 1; }
        if (hp < 1) { hp = 1; }
        if (atk < 0) { atk = 0; }
        if (def < 0) { def = 0; }
        if (exp < 0) { exp = 0; }
        if (goldMin < 0) { goldMin = 0; }
        if (goldMax < goldMin) { goldMax = goldMin; }
        if (respawnSec < 1) { respawnSec = 1; }
        if (count < 1) { count = 1; }
        if (count > 99) { count = 99; }
        string picture = this.In("picture").Trim();
        if (Fmt.CharCount(picture) > 64) {
            this.Fail(400, "0003", "美术键最长 64 字符");
        }
        int status = this.InInt("status", 1);
        if (status != 1) { status = 0; }

        if (id > 0) {
            Mob have = await this.Reach(id);
            int n = await this.Mob.Update()
                .Set(a => a.name, name)
                .Set(a => a.mapId, mapId)
                .Set(a => a.level, level)
                .Set(a => a.hp, hp)
                .Set(a => a.atk, atk)
                .Set(a => a.def, def)
                .Set(a => a.exp, exp)
                .Set(a => a.goldMin, goldMin)
                .Set(a => a.goldMax, goldMax)
                .Set(a => a.respawnSec, respawnSec)
                .Set(a => a.count, count)
                .Set(a => a.picture, picture)
                .Set(a => a.status, status)
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            await this.Note("编辑刷怪点", "#" + Convert.ToString(id)
                + " " + have.name, n > 0, "");
            Fight.ReloadCatalog();
            this.Saved("刷怪点已保存，战斗内存已热重载");
            return;
        }
        Mob row = new Mob();
        row.name = name;
        row.mapId = mapId;
        row.level = level;
        row.hp = hp;
        row.atk = atk;
        row.def = def;
        row.exp = exp;
        row.goldMin = goldMin;
        row.goldMax = goldMax;
        row.respawnSec = respawnSec;
        row.count = count;
        row.picture = picture;
        row.status = status;
        int newId = await this.Mob.Insert(row).ExecuteIdentityAsync();
        await this.Note("新增刷怪点", "#" + Convert.ToString(newId)
            + " " + name, newId > 0, "");
        Fight.ReloadCatalog();
        this.Saved("刷怪点已创建，战斗内存已热重载");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除刷怪点")]
    async void Delete() {
        int id = this.InInt("id", 0);
        Mob have = await this.Reach(id);
        int n = await this.Mob.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        /* 爆率清单随怪走：孤儿行没人再掷。 */
        int _nd = await this.Drop.Delete().Where(a => a.mobId == id)
            .ExecuteAffrowsAsync();
        await this.Note("删除刷怪点", "#" + Convert.ToString(id)
            + " " + have.name, n > 0, "");
        Fight.ReloadCatalog();
        this.Saved("刷怪点已删除，战斗内存已热重载");
    }

    async Mob Reach(int id) {
        Mob m = await this.Mob.Where(a => a.id == id).FirstAsync();
        if (m == null) { this.Fail(404, "0404", "刷怪点不存在"); }
        return m;
    }

    static string MapName(List<GameMap> maps, int mapId) {
        for (int i = 0; i < maps.Count; i = i + 1) {
            if (maps[i].id == mapId) { return maps[i].name; }
        }
        return "—" + Convert.ToString(mapId);
    }
}
