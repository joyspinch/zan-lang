using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Game;
using ZanWeb.Game;

namespace ZanWeb.Admin.Game;

/* /admin/game/online 在线会话：世界内存态的直接视口（不查玩家表，
   数字即真实会话数），支持单点踢下线与全服喊话。会话分两态：已登录
   未进区（选区/建角中）与在世界中；喊话发给全部会话。会话不记录对端
   IP（Worker 的 TCP 连接不暴露远端地址），需要审计时看操作日志。 */
[Route("admin/game/online/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("在线会话")]
class Online : AdminController {
    [HttpGet]
    [Route("/admin/game/online")]
    [Custom(IsMenu = true, Icon = "mdi:radar", Perm = PermBit.View)]
    [Description("在线会话")]
    async void Index() {
        ViewData d = await this.Layout("在线会话");
        /* 会话清单来自世界进程（本进程即世界时直读，否则经共享内存
           中继）；在线计数读共享表，多 worker 各页一致。 */
        JsonValue live = await GameShared.Sessions();
        List<GameMap> maps = new List<GameMap>();
        List<Realm> realms = new List<Realm>();
        if (this.DbReady()) {
            maps = await this.GameMap.OrderBy(a => a.sortOrder).ToListAsync();
            realms = await this.Realm.OrderBy(a => a.sort).ToListAsync();
        }
        long now = WebApp.NowSeconds();
        int count = 0;
        List<StrMap> items = d.AddList("rows");
        if (live != null) {
            JsonValue rows = live.Get("rows");
            if (rows != null) {
            count = rows.Count();
            for (int i = 0; i < rows.Count(); i = i + 1) {
                JsonValue s = rows.At(i);
                StrMap row = new StrMap();
                row.Set("cid", Convert.ToString(s.Int("cid", 0)));
                row.Set("username", s.Str("user", ""));
                int realmId = s.Int("realm", 0);
                row.Set("realm", realmId > 0
                    ? Online.RealmName(realms, realmId) : "—");
                string nickname = s.Str("name", "");
                if (nickname.Length > 0) {
                    row.Set("nickname", Fmt.Dash(nickname));
                    row.Set("level", Convert.ToString(s.Int("level", 0)));
                    row.Set("map", Online.MapName(maps, s.Int("map", 0)));
                    row.Set("pos", Convert.ToString(s.Int("x", 0)) + ","
                        + Convert.ToString(s.Int("y", 0)));
                    row.Set("stage", "在世界中");
                    row.Set("stageClass", "ok");
                } else {
                    row.Set("nickname", "—");
                    row.Set("level", "—");
                    row.Set("map", "—");
                    row.Set("pos", "—");
                    row.Set("stage", "未进区");
                    row.Set("stageClass", "off");
                }
                row.Set("loginAt", Fmt.Stamp(s.Int("loginAt", 0)));
                row.Set("idle", Fmt.Dur(
                    (now - s.Int("lastSeen", 0)) * 1000000));
                items.Add(row);
            }
            }
        }
        d.Set("count", Convert.ToString(count));
        d.Set("inWorld", Convert.ToString(GameShared.OnlineTotal()));
        if (count == 0) { d.Set("empty", "1"); }
        this.Page(d);
    }

    /* 按 cid 踢下线。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("踢下线")]
    async void Kick() {
        int cid = this.InInt("cid", 0);
        /* 会话清单里按 cid 找账号（会话本体在世界进程）。 */
        JsonValue live = await GameShared.Sessions();
        if (live == null) { this.Fail(404, "0404", "该会话已不在线"); }
        JsonValue rows = live.Get("rows");
        int accountId = 0;
        string who = "";
        if (rows != null) {
        for (int i = 0; i < rows.Count(); i = i + 1) {
            JsonValue s = rows.At(i);
            if (s.Int("cid", 0) == cid) {
                accountId = s.Int("uid", 0);
                who = s.Str("user", "");
                break;
            }
        }
        }
        if (accountId == 0) { this.Fail(404, "0404", "该会话已不在线"); }
        bool hit = await GameShared.GmKick(accountId, "GM 强制下线");
        await this.Note("在线踢下线", "#" + Convert.ToString(cid)
            + " " + who, hit, hit ? "" : "世界进程未响应");
        if (!hit) { this.Saved("世界进程未响应，请稍后再试"); return; }
        this.Saved("已断开该会话");
    }

    /* 全服喊话：经聊天通道发给所有会话（含未进区的），from 为当前 GM。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("全服喊话")]
    async void Broadcast() {
        string text = this.Need("text", "喊话内容");
        if (Fmt.CharCount(text) > 200) {
            this.Fail(400, "0003", "喊话最长 200 字");
        }
        string from = "GM";
        if (this.who != null) {
            from = Fmt.Text(this.who.nickname, this.who.username);
        }
        int hit = await GameShared.GmBroadcast(from, text);
        await this.Note("全服喊话", text, hit >= 0,
            hit >= 0 ? Convert.ToString(hit) + " 个会话" : "世界进程未响应");
        if (hit < 0) { this.Saved("世界进程未响应，请稍后再试"); return; }
        this.Saved("已推送给 " + Convert.ToString(hit) + " 个在线会话");
    }

    static string MapName(List<GameMap> maps, int id) {
        for (int i = 0; i < maps.Count; i = i + 1) {
            if (maps[i].id == id) { return maps[i].name; }
        }
        return "#" + Convert.ToString(id);
    }

    static string RealmName(List<Realm> realms, int id) {
        for (int i = 0; i < realms.Count; i = i + 1) {
            if (realms[i].id == id) { return realms[i].name; }
        }
        return "#" + Convert.ToString(id);
    }
}
