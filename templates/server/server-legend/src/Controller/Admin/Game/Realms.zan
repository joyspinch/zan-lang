using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Game;
using ZanWeb.Game;

namespace ZanWeb.Admin.Game;

/* /admin/game/realms 区服管理：增删改 + 开放/维护切换。维护中的区服
   拒绝 enter/create（网关侧 OpenRealm 校验），列表接口照常可见方便
   客户端置灰。删除有角色的区服会被拒绝——先迁走或清空角色。 */
[Route("admin/game/realms/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("区服管理")]
class Realms : AdminController {
    [HttpGet]
    [Route("/admin/game/realms")]
    [Custom(IsMenu = true, Icon = "mdi:server", Perm = PermBit.View)]
    [Description("区服管理")]
    async void Index() {
        ViewData d = await this.Layout("区服管理");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }
        List<Realm> rows = await this.Realm.OrderBy(a => a.sort)
            .ToListAsync();
        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            Realm r = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(r.id));
            row.Set("name", r.name);
            row.Set("sort", Convert.ToString(r.sort));
            row.Set("online", Convert.ToString(GameShared.OnlineRealm(r.id)));
            row.Set("stateText", r.state == 0 ? "开放" : "维护");
            row.Set("stateClass", r.state == 0 ? "ok" : "bad");
            row.Set("createdAt", Fmt.Stamp(r.createdAt));
            items.Add(row);
        }
        if (rows.Count == 0) { d.Set("empty", "1"); }
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("区服表单")]
    async void Form() {
        int id = this.InInt("id", 0);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("dialogTitle", "新增区服");
        d.Set("new", "1");
        d.Set("state0", "selected");
        d.Set("sort", Convert.ToString(id > 0 ? 0 : 10));
        if (id > 0) {
            Realm r = await this.Reach(id);
            d.Set("dialogTitle", "编辑区服");
            d.Set("name", r.name);
            d.Set("sort", Convert.ToString(r.sort));
            d.Set("edit", "1");
            d.Set("new", "");
            d.Set("state0", "");
            if (r.state == 0) { d.Set("state0", "selected"); }
            else { d.Set("state1", "selected"); }
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存区服")]
    async void Save() {
        int id = this.InInt("id", 0);
        string name = this.Need("name", "区服名称");
        if (name.Length > 64) {
            this.Fail(400, "0003", "区服名称最长 64 字符");
        }
        int state = this.InInt("state", 0);
        if (state != 0) { state = 1; }
        int sort = this.InInt("sort", 10);

        /* 区名唯一，避免客户端列表出现两个"一区"。 */
        Realm dup = await this.Realm.Where(a => a.name == name).FirstAsync();
        if (dup != null && dup.id != id) {
            this.Fail(400, "0409", "已存在同名区服");
        }
        if (id > 0) {
            Realm have = await this.Reach(id);
            int n = await this.Realm.Update()
                .Set(a => a.name, name)
                .Set(a => a.state, state)
                .Set(a => a.sort, sort)
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            await this.Note("编辑区服", "#" + Convert.ToString(id)
                + " " + have.name, n > 0,
                state == 1 ? "置为维护" : "");
            this.Saved("区服已保存");
            return;
        }
        Realm row = new Realm();
        row.name = name;
        row.state = state;
        row.sort = sort;
        row.createdAt = WebApp.NowSeconds();
        int newId = await this.Realm.Insert(row).ExecuteIdentityAsync();
        await this.Note("新增区服", "#" + Convert.ToString(newId)
            + " " + name, newId > 0, "");
        this.Saved("区服已创建，客户端列表即刻可见");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除区服")]
    async void Delete() {
        int id = this.InInt("id", 0);
        Realm have = await this.Reach(id);
        int chars = await this.Player.Where(a => a.realmId == id).CountAsync();
        if (chars > 0) {
            this.Fail(400, "0409", "该区还有 " + Convert.ToString(chars)
                + " 个角色，先处理角色再删除");
        }
        int n = await this.Realm.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Note("删除区服", "#" + Convert.ToString(id)
            + " " + have.name, n > 0, "");
        this.Saved("区服已删除");
    }

    async Realm Reach(int id) {
        Realm r = await this.Realm.Where(a => a.id == id).FirstAsync();
        if (r == null) { this.Fail(404, "0404", "区服不存在"); }
        return r;
    }
}
