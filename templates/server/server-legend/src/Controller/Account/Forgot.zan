using System;
using System.Data;
using System.Web;
using ZanWeb;
using ZanWeb.Dao.Game;

namespace ZanWeb.Account;

/* 网页找回密码，三步走同一张卡片：
   ① 输账号 → ② 展示密保问题、答案+新密码 → ③ 成功页。
   与 TCP forgot/reset 协议共用 AccountDao：答案归一化比对、答错限频
   （1 小时错满 5 次锁定）两侧行为一致。账号不存在与未设置密保同一
   文案，不在第一步向探测者区分。 */
[Route("[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("找回密码")]
class Forgot : AppController {
    static string Tpl = "Account.Forgot.Index";

    [HttpGet]
    [Route("/forgot")]
    [Description("找回密码")]
    async void Index() {
        this.ViewOf(Forgot.Tpl, await Forgot.Page("", "", "", 1, ""));
    }

    /* 第一步：查账号，命中且设有密保则进入第二步。 */
    [HttpPost]
    [Route("/forgot")]
    [Description("找回密码·查账号")]
    async void Submit() {
        string user = this.In("user").Trim();
        if (user.Length == 0 || user.Length > 32) {
            this.ViewOf(Forgot.Tpl, await Forgot.Page("", "", "", 1,
                "请输入要找回的账号"));
            return;
        }
        if (!this.DbReady()) {
            this.ViewOf(Forgot.Tpl, await Forgot.Page(user, "", "", 1,
                "数据库不可用，请稍后再试"));
            return;
        }
        AccountDao dao = new AccountDao(this.Held());
        Account row = await dao.ByUsername(user);
        if (row == null || row.question.Length == 0) {
            this.ViewOf(Forgot.Tpl, await Forgot.Page("", "", "", 1,
                "账号不存在或未设置密保"));
            return;
        }
        this.ViewOf(Forgot.Tpl, await Forgot.Page(user, row.question, "", 2,
            ""));
    }

    /* 第二步：验密保答案，通过即重置密码。 */
    [HttpPost]
    [Route("/forgot/reset")]
    [Description("找回密码·重置")]
    async void Reset() {
        string user = this.In("user").Trim();
        string answer = this.In("answer");
        string newpass = this.In("newpass");
        string newpass2 = this.In("newpass2");
        long now = WebApp.NowSeconds();
        if (!this.DbReady()) {
            this.ViewOf(Forgot.Tpl, await Forgot.Page(user, "", "", 1,
                "数据库不可用，请稍后再试"));
            return;
        }
        AccountDao dao = new AccountDao(this.Held());
        Account row = await dao.ByUsername(user);
        if (row == null || row.question.Length == 0) {
            this.ViewOf(Forgot.Tpl, await Forgot.Page("", "", "", 1,
                "账号不存在或未设置密保"));
            return;
        }
        if (Fmt.CharCount(newpass) < 6 || Fmt.CharCount(newpass) > 64) {
            this.ViewOf(Forgot.Tpl, await Forgot.Page(user, row.question,
                "", 2, "新密码需 6-64 字"));
            return;
        }
        if (newpass != newpass2) {
            this.ViewOf(Forgot.Tpl, await Forgot.Page(user, row.question,
                answer, 2, "两次输入的新密码不一致"));
            return;
        }
        if (dao.AnswerLocked(row, now)) {
            this.ViewOf(Forgot.Tpl, await Forgot.Page(user, row.question,
                "", 2, "错误次数过多，请一小时后再试"));
            return;
        }
        if (!dao.CheckAnswer(row, answer)) {
            await dao.NoteAnswerFail(row, now);
            this.ViewOf(Forgot.Tpl, await Forgot.Page(user, row.question,
                "", 2, "密保答案不正确"));
            return;
        }
        await dao.ClearAnswerFails(row.id);
        await dao.SetPassword(row.id, newpass);
        this.ViewOf(Forgot.Tpl, await Forgot.Page(user, "", "", 3, ""));
    }

    /* 卡片数据：step 1=输账号 2=答密保 3=完成。answer 不回显。 */
    static async ViewData Page(string user, string question, string answer,
                               int step, string error) {
        string site = await Settings.Get(SettingKeys.SiteTitle, "ZanWeb");
        ViewData d = new ViewData();
        d.Set("title", "找回密码 · " + site);
        d.Set("brand", site);
        d.Set("user", user);
        d.Set("question", question);
        d.Set("answer", answer);
        d.Set("error", error);
        if (step == 2) { d.Set("step2", "1"); }
        if (step == 3) { d.Set("done", "1"); }
        return d;
    }
}
