using System;
using System.Data;
using System.Web;
using ZanWeb;
using ZanWeb.Dao.Game;

namespace ZanWeb.Account;

/* 网页注册：与客户端 register 协议共用 AccountDao.Register——同一套
   长度校验与加盐散列，两侧行为永远一致。注册只开户（账号+密保），
   角色由玩家进客户端后按区服创建。成功页引导去客户端登录，游戏入口
   在 TCP 网关，网页不发放会话。独立外壳（Account/layout.html 居中卡片，
   非管理后台外壳）。 */
[Route("[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("注册账号")]
class Register : AppController {
    static string Tpl = "Account.Register.Index";

    [HttpGet]
    [Route("/register")]
    [Description("注册账号")]
    async void Index() {
        this.ViewOf(Register.Tpl, await Register.Form("", "", "", "", "", false));
    }

    [HttpPost]
    [Route("/register")]
    [Description("注册提交")]
    async void Submit() {
        string user = this.In("user").Trim();
        string pass = this.In("pass");
        string pass2 = this.In("pass2");
        string question = this.In("question").Trim();
        string answer = this.In("answer").Trim();
        string error = Register.Validate(user, pass, pass2, question, answer);
        if (error.Length > 0) {
            this.ViewOf(Register.Tpl, await Register.Form(user, pass,
                question, answer, error, false));
            return;
        }
        if (!this.DbReady()) {
            this.ViewOf(Register.Tpl, await Register.Form(user, pass,
                question, answer, "数据库不可用，请稍后再试", false));
            return;
        }
        AccountDao dao = new AccountDao(this.Held());
        int id = await dao.Register(user, pass, "", question, answer);
        if (id == 0) {
            this.ViewOf(Register.Tpl, await Register.Form("", "", "", "",
                "账号已存在，请换一个或直接登录", false));
            return;
        }
        if (id < 0) {
            this.ViewOf(Register.Tpl, await Register.Form(user, pass,
                question, answer, "注册失败，请稍后再试", false));
            return;
        }
        this.ViewOf(Register.Tpl, await Register.Form(user, "", "", "", "",
            true));
    }

    /* 与 TCP register 协议同一套约束；文案两处一致。密保与客户端
       一致可选：都空=不设置，只填一半要求补全。 */
    static string Validate(string user, string pass, string pass2,
                           string question, string answer) {
        if (Fmt.CharCount(user) < 3 || Fmt.CharCount(user) > 32) { return "账号需 3-32 字"; }
        if (Fmt.CharCount(pass) < 6 || Fmt.CharCount(pass) > 64) { return "密码需 6-64 字"; }
        if (pass != pass2) { return "两次输入的密码不一致"; }
        if (question.Length > 0 || answer.Length > 0) {
            if (Fmt.CharCount(question) < 2 || Fmt.CharCount(question) > 50) { return "密保问题需 2-50 字"; }
            if (Fmt.CharCount(answer) < 2 || Fmt.CharCount(answer) > 50) { return "密保答案需 2-50 字"; }
        }
        return "";
    }

    /* 卡片数据：done 时渲染成功态（不回填密码）。 */
    static async ViewData Form(string user, string pass, string question,
                               string answer, string error, bool done) {
        string site = await Settings.Get(SettingKeys.SiteTitle, "ZanWeb");
        ViewData d = new ViewData();
        d.Set("title", "注册账号 · " + site);
        d.Set("brand", site);
        d.Set("user", user);
        d.Set("pass", pass);
        d.Set("question", question);
        d.Set("answer", answer);
        d.Set("error", error);
        if (done) { d.Set("done", "1"); }
        return d;
    }
}
