using System;
using System.Diagnostics;
using System.Net.Mqtt;
using ZanWeb;
using System.Web;

/* {{NAME}} -- EMQX 风格 MQTT 物联网管理服务器。 */
/* 两个监听器在同一协程事件循环上运行：MQTT 3.1.1 代理（config mqtt.port，默认 1883）接收设备、跟踪会话/订阅、路由带 +/# 通配符的 PUBLISH；HTTP 管理控制台（config server.port，默认 8080）提供看板及 /iot/<wildcard> JSON API，路由表见 src/framework/Routes.gen.zan（新增控制器/动作时编辑）。 */
/* 运行期设置存于 config/app.json（改 host/port 无需重编译）。 */
class Program {
    static void Main() {
        /* config/ 和 views/ 按相对路径读取，进程需位于发布目录；双击或从其他目录启动时不满足。 */
        bool _cd = ProcessHost.UseAppDir("config/app.json");
        Config.Load("config/app.json");

        /* ---- MQTT 代理 ---- */
        MqttBroker broker = new MqttBroker(
            Config.Str("mqtt", "host", "0.0.0.0"),
            Config.Int("mqtt", "port", 1883));
        MqttBroker.Use(broker);
        Task.Spawn(broker.RunAsync());    /* 在共享事件循环上运行 */

        /* ---- HTTP 管理控制台 ---- */
        WebApp app = new WebApp(
            Config.Str("server", "host", "127.0.0.1"),
            Config.Int("server", "port", 8080));
        WebHost.Use(app);
        app.Views("views");
        app.MaxBody(Config.Int("server", "maxBodyMB", 2) * 1024 * 1024);
        app.GlobalLimit(Config.Int("server", "globalLimitPerSec", 0));
        app.Before(Program.AccessLog);

        Routes.Map(app);                  /* 路由表（src/framework/Routes.gen.zan） */

        int r = await WebServer.Run(app,
            Config.Int("worker", "count", 1),
            Config.Bool("worker", "daemon", false));
    }

    static bool AccessLog(HttpContext ctx) {
        Console.WriteLine("[req] " + ctx.method + " " + ctx.path);
        return true;
    }
}