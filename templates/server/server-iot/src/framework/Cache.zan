using System;
using System.Web;
using System.Data.Redis;

namespace App;

/* 可选 TTL 的缓存。两种后端由 [cache].driver 选择："memory"（默认）零依赖进程内 StrMap；"redis"基于 System.Data.Redis 的分布式缓存。RESP 客户端完全异步，异步 API 在协程上驱动，处理器 await 缓存查找时工作线程仍服务其他连接。处理器应调用异步 API，Redis 未配置或不可达时透明回退内存。同步方法供内存模式/非协程调用方使用。 */
class Cache {
    static StrMap store = new StrMap();
    static StrMap expiry = new StrMap();   /* key → 过期纪元秒（"0"=不过期） */

    /* 惰性打开的共享 Redis 连接（仅 driver == "redis" 时）。 */
    static RedisClient rc = null;
    static bool rcTried = false;

    static int Digit(string ch) {
        string d = "0123456789";
        int i = 0;
        while (i < 10) {
            if (d.Substring(i, 1) == ch) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }

    static int ToInt(string s) {
        int v = 0;
        int i = 0;
        while (i < s.Length) {
            int d = Cache.Digit(s.Substring(i, 1));
            if (d < 0) { break; }
            v = v * 10 + d;
            i = i + 1;
        }
        return v;
    }

    static bool Alive(string key) {
        if (!store.Has(key)) { return false; }
        string e = expiry.GetOr(key, "0");
        if (e == "0") { return true; }
        if (WebApp.NowSeconds() >= Cache.ToInt(e)) {
            store.Set(key, "");
            expiry.Set(key, "0");
            return false;
        }
        return true;
    }

    static bool Has(string key) { return Cache.Alive(key); }

    static string Get(string key) {
        if (!Cache.Alive(key)) { return ""; }
        return store.Get(key);
    }

    static string GetOr(string key, string dflt) {
        if (!Cache.Alive(key)) { return dflt; }
        return store.Get(key);
    }

    static void Set(string key, string val) {
        store.Set(key, val);
        expiry.Set(key, "0");
    }

    static void SetTtl(string key, string val, int seconds) {
        store.Set(key, val);
        expiry.Set(key, Convert.ToString(WebApp.NowSeconds() + seconds));
    }

    static void Del(string key) {
        store.Set(key, "");
        expiry.Set(key, "0");
    }

    /* ---- 异步 API（Redis 后端，内存回退） ---- */

    /* 返回共享 Redis 连接，首次使用时打开；driver != "redis" 或服务器不可达时返回 null，异步方法回退内存。 */
    static async RedisClient Redis() {
        if (rc != null) { return rc; }
        if (rcTried) { return null; }
        rcTried = true;
        string driver = Config.Str("cache", "driver", "memory");
        if (driver != "redis") { return null; }
        string redisHost = Config.Str("cache", "redisHost", "127.0.0.1");
        int redisPort = Config.Int("cache", "redisPort", 6379);
        RedisClient c = await RedisClient.ConnectAsync(redisHost, redisPort);
        /* 拒绝/半开连接可能仍报告已连接；PING 往返确认真正服务器后才信任，否则回退内存，避免泄露 RESP 错误。 */
        bool alive = false;
        if (c != null) { alive = await c.PingAsync(); }
        if (!alive) {
            if (c != null) { c.Close(); }
            Console.WriteLine("[cache] redis unreachable ("
                + redisHost + ":" + Convert.ToString(redisPort)
                + ") -- using in-memory cache");
            return null;
        }
        rc = c;
        Console.WriteLine("[cache] redis connected");
        return rc;
    }

    /* 读取键；缺失返回 ""；已配置 Redis 时 await。 */
    static async string GetAsync(string key) {
        RedisClient r = await Cache.Redis();
        if (r != null) { return await r.GetAsync(key); }
        return Cache.Get(key);
    }

    /* 存储键，无过期；已配置 Redis 时 await。 */
    static async void SetAsync(string key, string val) {
        RedisClient r = await Cache.Redis();
        if (r != null) {
            bool _ok = await r.SetAsync(key, val);
            return;
        }
        Cache.Set(key, val);
    }

    /* 存储键，seconds 秒后过期。 */
    static async void SetTtlAsync(string key, string val, int seconds) {
        RedisClient r = await Cache.Redis();
        if (r != null) {
            bool _ok = await r.SetAsync(key, val);
            int _e = await r.ExpireAsync(key, seconds);
            return;
        }
        Cache.SetTtl(key, val, seconds);
    }

    /* 删除键；已配置 Redis 时 await。 */
    static async void DelAsync(string key) {
        RedisClient r = await Cache.Redis();
        if (r != null) {
            int _d = await r.DelAsync(key);
            return;
        }
        Cache.Del(key);
    }
}