using System;

namespace ZanWeb;

// ---------------------------------------------------------------------------
// Route table: maps HTTP method + path to controller actions, with route
// metadata (name / title / group / auth). Edit this when you add or change a
// controller action.
// ---------------------------------------------------------------------------
class Routes {
    static void Map(WebApp app) {
        app.Map("POST", "/auth/login", AuthController.Login)
            .Named("AuthController.Login").Title("登录").Meta("Group", "auth");
        app.Map("GET", "/auth/me", AuthController.Me)
            .Named("AuthController.Me").Title("当前用户").Meta("Group", "auth").Login();
        app.Map("GET", "/", HomeController.Index)
            .Named("HomeController.Index").Title("控制台").Meta("Group", "");
        app.Map("GET", "/iot/clients", IotController.Clients)
            .Named("IotController.Clients").Title("客户端列表").Meta("Group", "iot").Menu();
        app.Map("GET", "/iot/clients/{id}", IotController.Client)
            .Named("IotController.Client").Title("客户端详情").Meta("Group", "iot");
        app.Map("POST", "/iot/clients/{id}/kick", IotController.Kick)
            .Named("IotController.Kick").Title("踢下线").Meta("Group", "iot").Auth().Meta("Rank", "9").Lock("global");
        app.Map("GET", "/iot/subscriptions", IotController.Subscriptions)
            .Named("IotController.Subscriptions").Title("订阅管理").Meta("Group", "iot").Menu();
        app.Map("GET", "/iot/topics", IotController.Topics)
            .Named("IotController.Topics").Title("主题列表").Meta("Group", "iot").Menu();
        app.Map("GET", "/iot/metrics", IotController.Metrics)
            .Named("IotController.Metrics").Title("broker指标").Meta("Group", "iot");
        app.Map("POST", "/iot/publish", IotController.Publish)
            .Named("IotController.Publish").Title("发布消息").Meta("Group", "iot").Auth().Meta("Rank", "3");
        app.Map("GET", "/admin/stats", IotController.Stats)
            .Named("IotController.Stats").Title("性能检测").Meta("Group", "admin").Auth().Meta("Rank", "9").Menu();
    }
}
