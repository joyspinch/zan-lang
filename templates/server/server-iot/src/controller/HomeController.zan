using System;
using System.Web;
using ZanWeb;

namespace ZanWeb.Home;

/* 管理控制台落地页（单页轮询 /iot/ 下的 JSON API）。视图跟随控制器——
   View(d) 渲染 views/Home/HomeController.Index.html，包 Views 管线
   按 ViewData 替换 {{title}} 等占位。 */
[Route("[controller]/[action]")]
[Description("控制台")]
class HomeController : Controller {
    [HttpGet]
    [Route("/")]
    [Description("控制台")]
    async void Index() {
        ViewData d = new ViewData();
        d.Set("title", "{{NAME}} IoT Console");
        this.View(d);
    }
}
