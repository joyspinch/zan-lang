using System;
using System.Collections.Generic;
using System.Json;
using System.Net.Mqtt;
using System.Web;
using Zan.Web;
using Zan.Web.Core;
using Zan.Web.Security;

namespace Zan.Web.Admin;

/* IoT 物联网管理后台控制器，深度继承 Zan.Mvc 体系的 AdminController。
   自动融入多标签页、侧边栏菜单、账号会话以及 RBAC 权限控制。 */
[Custom(Authorization = CustomAuthorization.Login)]
[Description("IoT物联平台")]
public class IotAdminController : AdminController {

    /* 1. IoT 核心概览大屏 */
    [HttpGet]
    [Route("/admin/iot")]
    [Custom(IsMenu = true, Group = "IoT物联", Icon = "mdi:view-dashboard", Order = 10)]
    [Description("IoT仪表盘")]
    public async void Index() {
        ViewData d = await this.Layout("IoT仪表盘");

        MqttBroker broker = MqttBroker.Instance();
        string metricsRaw = broker.MetricsJson();
        JsonDoc m = JsonDoc.Parse(metricsRaw);

        long uptime = m != null ? m.Long(0, "uptime_sec", 0L) : 0L;
        long clientsConn = m != null ? m.Long(0, "clients_connected", 0L) : 0L;
        long clientsTotal = m != null ? m.Long(0, "clients_total", 0L) : 0L;
        long subs = m != null ? m.Long(0, "subscriptions", 0L) : 0L;
        long topics = m != null ? m.Long(0, "topics", 0L) : 0L;
        long msgsIn = m != null ? m.Long(0, "messages_in", 0L) : 0L;
        long msgsOut = m != null ? m.Long(0, "messages_out", 0L) : 0L;
        long bytesIn = m != null ? m.Long(0, "bytes_in", 0L) : 0L;
        long bytesOut = m != null ? m.Long(0, "bytes_out", 0L) : 0L;

        d.Set("uptime", Fmt.Uptime(uptime * 1000L));
        d.Set("clientsConn", Convert.ToString(clientsConn));
        d.Set("clientsTotal", Convert.ToString(clientsTotal));
        d.Set("subs", Convert.ToString(subs));
        d.Set("topics", Convert.ToString(topics));
        d.Set("msgsIn", Convert.ToString(msgsIn));
        d.Set("msgsOut", Convert.ToString(msgsOut));
        d.Set("bytesIn", Convert.ToString(bytesIn));
        d.Set("bytesOut", Convert.ToString(bytesOut));
        d.Set("brokerHost", MqttCfg.host);
        d.Set("brokerPort", Convert.ToString(MqttCfg.port));

        this.Page(d);
    }

    /* 2. 在线客户端与连接管理（支持踢出） */
    [HttpGet]
    [Route("/admin/iot/clients")]
    [Custom(IsMenu = true, Group = "IoT物联", Icon = "mdi:devices", Order = 11)]
    [Description("客户端管理")]
    public async void Clients() {
        ViewData d = await this.Layout("客户端管理");
        this.Page(d);
    }

    /* 3. 保留消息管理（支持查看与清除） */
    [HttpGet]
    [Route("/admin/iot/retained")]
    [Custom(IsMenu = true, Group = "IoT物联", Icon = "mdi:content-save-all", Order = 12)]
    [Description("保留消息")]
    public async void Retained() {
        ViewData d = await this.Layout("保留消息");
        this.Page(d);
    }

    /* 4. 规则与 Webhook 转发审计 */
    [HttpGet]
    [Route("/admin/iot/webhooks")]
    [Custom(IsMenu = true, Group = "IoT物联", Icon = "mdi:webhook", Order = 13)]
    [Description("规则与Webhook")]
    public async void Webhooks() {
        ViewData d = await this.Layout("规则与Webhook");
        d.Set("webhookEnabled", MqttCfg.webhookEnabled ? "已启用" : "未启用");
        d.Set("webhookUrl", MqttCfg.webhookUrl);
        d.Set("webhookRuleTopic", MqttCfg.webhookRuleTopic);
        this.Page(d);
    }

    /* 5. 在线调试与消息测试台（支持 QoS 0/1/2 与 Retain） */
    [HttpGet]
    [Route("/admin/iot/console")]
    [Custom(IsMenu = true, Group = "IoT物联", Icon = "mdi:console-line", Order = 14)]
    [Description("消息测试台")]
    public async void Console() {
        ViewData d = await this.Layout("消息测试台");
        this.Page(d);
    }
}
