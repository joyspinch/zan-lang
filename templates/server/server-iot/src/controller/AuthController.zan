using System;
using System.Json;
using System.Web;
using ZanWeb;
using ZanWeb.Web;

namespace ZanWeb.Auth;

/* 管理控制台会话认证：/auth/login 发会话（Bearer 或 zsession cookie 双通道，
   包 WebApp.AuthUser 两条都解析），/auth/me 回显当前 uid。演示凭证是包
   Schema 种子的 bootstrap 管理员（[auth].bootstrapPassword），替换为自有
   用户存储时接 sys_user 即可。 */
[Route("[controller]/[action]")]
[Description("认证")]
class AuthController : ApiController {
    [HttpPost]
    [Description("登录")]
    async void Login() {
        string user = this.In("user");
        string pass = this.In("pass");
        if (user.Length == 0 || user.Length > 32 || pass.Length == 0
            || pass.Length > 64) {
            this.Fail(422, "1003", "validation failed");
            return;
        }
        /* 空令牌同时覆盖"无此账号"与"密码错误"，不向调用方透露是哪一种。 */
        string token = await AuthUser.Login(user, pass);
        if (token.Length == 0) {
            this.Fail(401, "1001", "bad credentials");
            return;
        }
        this.Ctx().SetCookie("zsession", token, 86400);
        JsonValue o = JsonValue.NewObject();
        o.Put("token", JsonValue.NewStr(token));
        this.Ok(o.ToJson());
    }

    [HttpGet]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("当前用户")]
    async void Me() {
        JsonValue o = JsonValue.NewObject();
        o.Put("uid", JsonValue.NewStr(this.Ctx().uid));
        this.Ok(o.ToJson());
    }
}
