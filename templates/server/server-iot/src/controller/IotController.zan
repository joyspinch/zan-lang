using System;
using System.Json;
using System.Net.Mqtt;
using System.Web;
using Zan.Web;
using Zan.Web;

namespace Zan.Web.Iot;

/* MQTT 代理管理 API。类路由 [controller]→"iot" 给出 /iot/clients 等
   约定路径；路径参数与 /admin/stats 以 [Route] 覆盖。各动作通过
   MqttBroker.Instance() 读取实时代理注册表。信封是包 ApiController
   的 {code:0, msg, data, traceId}。 */
[Route("[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("MQTT代理")]
public class IotController : ApiController {
    [HttpGet]
    [Description("客户端列表")]
    public async void Clients() {
        this.Ok(MqttBroker.Instance().ClientsJson());
    }

    [HttpGet]
    [Route("/iot/clients/{id}")]
    [Description("客户端详情")]
    public async void Client() {
        string id = this.In("id");
        string data = MqttBroker.Instance().ClientDetailJson(id);
        if (data.Length == 0) {
            this.Fail(404, "2001", "client not found");
            return;
        }
        this.Ok(data);
    }

    [HttpPost]
    [Route("/iot/clients/{id}/kick")]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Lock("global")]
    [Description("踢下线")]
    public async void Kick() {
        string id = this.In("id");
        if (MqttBroker.Instance().Kick(id)) {
            JsonWriter w = new JsonWriter();
            w.StartObject();
            w.WriteProperty("kicked", id);
            w.EndObject();
            this.Ok(w.ToJson());
        } else {
            this.Fail(404, "2001", "client not found");
        }
    }

    [HttpGet]
    [Description("订阅管理")]
    public async void Subscriptions() {
        this.Ok(MqttBroker.Instance().SubscriptionsJson());
    }

    [HttpGet]
    [Description("主题列表")]
    public async void Topics() {
        this.Ok(MqttBroker.Instance().TopicsJson());
    }

    /* 看板用的代理专用指标（不含 HTTP 内部指标）。 */
    [HttpGet]
    [Description("broker指标")]
    public async void Metrics() {
        this.Ok(MqttBroker.Instance().MetricsJson());
    }

    /* 全部保留消息（Retained Messages）列表。 */
    [HttpGet]
    [Route("/iot/retained")]
    [Description("保留消息列表")]
    public async void Retained() {
        this.Ok(MqttBroker.Instance().RetainedJson());
    }

    /* 清除指定主题的保留消息；未指定 topic 时清空所有。 */
    [HttpPost]
    [Route("/iot/retained/clear")]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("清除保留消息")]
    public async void ClearRetained() {
        string topic = this.In("topic");
        bool cleared = MqttBroker.Instance().ClearRetained(topic);
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("cleared", cleared ? "true" : "false");
        w.WriteProperty("topic", topic.Length > 0 ? topic : "*");
        w.EndObject();
        this.Ok(w.ToJson());
    }

    /* Webhook 转发运行期统计与审计日志。 */
    [HttpGet]
    [Route("/iot/webhook/stats")]
    [Description("Webhook运行统计")]
    public async void WebhookStats() {
        this.Ok(MqttWebhook.StatsJson());
    }

    /* Webhook 本地演示接收桩（供开箱即用测试与验证）。 */
    [HttpPost]
    [Route("/iot/webhook/mock")]
    [Description("Webhook演示接收端")]
    public async void WebhookMock() {
        string raw = this.InRaw("raw");
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("status", "mock_received");
        w.EndObject();
        this.Ok(w.ToJson());
    }

    /* 以代理身份向主题注入消息（支持 QoS 0/1/2 与 Retain 标记）；topic 必填。 */
    [HttpPost]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("发布消息")]
    public async void Publish() {
        string topic = this.In("topic");
        if (topic.Length == 0) {
            this.Fail(422, "2002", "topic required");
            return;
        }
        string payload = this.InRaw("payload");
        int qos = 0;
        string qosStr = this.In("qos");
        if (qosStr.Length > 0) {
            qos = Convert.ToInt32(qosStr);
            if (qos < 0) { qos = 0; }
            if (qos > 2) { qos = 2; }
        }
        string retStr = this.In("retain");
        bool retain = retStr == "1" || retStr == "true";

        int n = MqttBroker.Instance().Publish(topic, payload, qos, retain);
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("topic", topic);
        w.WriteProperty("delivered", n.ToString());
        w.WriteProperty("qos", qos.ToString());
        w.WriteProperty("retain", retain ? "true" : "false");
        w.EndObject();
        this.Ok(w.ToJson());
    }

    /* 性能检测：代理吞吐/客户端 + HTTP 运行期指标的单快照。 */
    [HttpGet]
    [Route("/admin/stats")]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("性能检测")]
    public async void Stats() {
        string broker = MqttBroker.Instance().MetricsJson();
        string http = WebHost.Current().MetricsJson();
        JsonWriter w = new JsonWriter();
        w.StartObject();
        if (broker != null && broker.Length > 0) {
            w.WriteRawProperty("broker", broker);
        }
        if (http != null && http.Length > 0) {
            w.WriteRawProperty("http", http);
        }
        w.EndObject();
        this.Ok(w.ToJson());
    }
}
