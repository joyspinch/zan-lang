using System;
using System.Json;
using System.Net.Mqtt;
using System.Web;
using Zan.Web;
using Zan.Web;

namespace Zan.Web.Iot;

/* MQTT 代理管理 API。类路由 [controller]→"iot" 给出 /iot/clients 等
   约定路径；路径参数与 /admin/stats 以 [Route] 覆盖。各动作通过
   MqttBroker.Instance() 读取实时代理注册表。信封是包 ApiController
   的 {code:0, msg, data, traceId}。 */
[Route("[controller]/[action]")]
[Description("MQTT代理")]
public class IotController : ApiController {
    [HttpGet]
    [Description("客户端列表")]
    public async void Clients() {
        this.Ok(MqttBroker.Instance().ClientsJson());
    }

    [HttpGet]
    [Route("/iot/clients/{id}")]
    [Description("客户端详情")]
    public async void Client() {
        string id = this.In("id");
        string data = MqttBroker.Instance().ClientDetailJson(id);
        if (data.Length == 0) {
            this.Fail(404, "2001", "client not found");
            return;
        }
        this.Ok(data);
    }

    [HttpPost]
    [Route("/iot/clients/{id}/kick")]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Lock("global")]
    [Description("踢下线")]
    public async void Kick() {
        string id = this.In("id");
        if (MqttBroker.Instance().Kick(id)) {
            JsonWriter w = new JsonWriter();
            w.StartObject();
            w.WriteProperty("kicked", id);
            w.EndObject();
            this.Ok(w.ToJson());
        } else {
            this.Fail(404, "2001", "client not found");
        }
    }

    [HttpGet]
    [Description("订阅管理")]
    public async void Subscriptions() {
        this.Ok(MqttBroker.Instance().SubscriptionsJson());
    }

    [HttpGet]
    [Description("主题列表")]
    public async void Topics() {
        this.Ok(MqttBroker.Instance().TopicsJson());
    }

    /* 看板用的代理专用指标（不含 HTTP 内部指标）。 */
    [HttpGet]
    [Description("broker指标")]
    public async void Metrics() {
        this.Ok(MqttBroker.Instance().MetricsJson());
    }

    /* 以代理身份向主题注入消息（扇出给所有匹配订阅者）；topic 必填，payload 原样取用。 */
    [HttpPost]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("发布消息")]
    public async void Publish() {
        string topic = this.In("topic");
        if (topic.Length == 0) {
            this.Fail(422, "2002", "topic required");
            return;
        }
        string payload = this.InRaw("payload");
        int n = MqttBroker.Instance().Publish(topic, payload);
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("topic", topic);
        w.WriteProperty("delivered", n.ToString());
        w.EndObject();
        this.Ok(w.ToJson());
    }

    /* 性能检测：代理吞吐/客户端 + HTTP 运行期指标的单快照。 */
    [HttpGet]
    [Route("/admin/stats")]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("性能检测")]
    public async void Stats() {
        string broker = MqttBroker.Instance().MetricsJson();
        string http = WebHost.Current().MetricsJson();
        JsonWriter w = new JsonWriter();
        w.StartObject();
        if (broker != null && broker.Length > 0) {
            w.WriteRawProperty("broker", broker);
        }
        if (http != null && http.Length > 0) {
            w.WriteRawProperty("http", http);
        }
        w.EndObject();
        this.Ok(w.ToJson());
    }
}
