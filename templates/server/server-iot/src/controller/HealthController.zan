using System;
using System.Json;
using App;

namespace ZanWeb;

/* 免鉴权健康检查：给负载均衡、看门狗与外部进程监督（systemd/Docker）探活。
   监控接口都要登录，而探活端点必须不能要——认证墙内没有可用性观测。
   本模板的核心服务是 MQTT broker，数据库是可选件：默认只答进程事实；
   db 字段如实报告连接状态（informational，不据此 503——设备面不依赖库）。
   路由手工登记在 framework/Routes.gen.zan。 */
class HealthController {
    [Get]
    [Route("/health")]
    [Title("健康检查")]
    static async void Index(HttpContext ctx) {
        JsonValue o = JsonValue.NewObject();
        o.Put("status", JsonValue.NewStr("ok"));
        WebApp app = WebHost.Current();
        if (app != null) {
            JsonValue m = JsonValue.ParseLenient(app.MetricsJson());
            if (m != null && m.IsObject()) {
                o.Put("uptime_ms", JsonValue.NewNum(Convert.ToString(m.Long("uptime_ms", 0))));
                JsonValue rq = m.Get("requests");
                if (rq != null) {
                    o.Put("requests", JsonValue.NewNum(Convert.ToString(rq.Long("count", 0))));
                }
            }
        }
        o.Put("pid", JsonValue.NewNum(Convert.ToString(ProcessHost.Pid())));
        o.Put("worker", JsonValue.NewNum(Convert.ToString(ProcessHost.WorkerId())));
        string db = "not connected";
        if (Db.Ready()) { db = "up"; }
        o.Put("db", JsonValue.NewStr(db));
        ctx.Json(o.ToJson());
    }
}
