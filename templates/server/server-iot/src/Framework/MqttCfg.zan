using System;
using System.IO;
using System.Json;

namespace ZanWeb;

/* MQTT 监听配置：包 Cfg 只有类型化节（server/database/auth/...），
   模板专属的 [mqtt] 节由本类直读 config/app.json，缺文件/键回退内置
   默认值（0.0.0.0:1883）。改配置重启生效，与包 Cfg 同一文件。 */
class MqttCfg {
    static string host = "0.0.0.0";
    static int port = 1883;

    static void Load(string relPath) {
        List<string> cands = new List<string>();
        if (relPath.Length > 0) { cands.Add(relPath); }
        cands.Add("config/app.json");
        cands.Add("app.json");
        int i = 0;
        while (i < cands.Count) {
            if (File.Exists(cands[i])) {
                JsonValue root = JsonValue.ParseLenient(File.ReadAllText(cands[i]));
                if (root != null && root.IsObject()) {
                    JsonValue s = root.Get("mqtt");
                    if (s != null && s.IsObject()) {
                        MqttCfg.host = s.Str("host", MqttCfg.host);
                        MqttCfg.port = s.Int("port", MqttCfg.port);
                    }
                    return;
                }
            }
            i = i + 1;
        }
    }
}
