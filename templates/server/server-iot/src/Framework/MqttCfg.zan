using System;
using System.IO;
using System.Json;

namespace Zan.Web;

/* MQTT 监听配置：包 Cfg 只有类型化节（server/database/auth/...），
   模板专属的 [mqtt] 节由本类直读 config/app.json，缺文件/键回退内置
   默认值（0.0.0.0:1883）。改配置重启生效，与包 Cfg 同一文件。 */
public class MqttCfg {
    static string host = "0.0.0.0";
    static int port = 1883;

    static void Load(string relPath) {
        List<string> cands = new List<string>();
        if (relPath.Length > 0) { cands.Add(relPath); }
        cands.Add("config/app.json");
        cands.Add("app.json");
        int i = 0;
        while (i < cands.Count) {
            if (File.Exists(cands[i])) {
                string text = File.ReadAllText(cands[i]);
                try {
                    JsonDoc.ParseScoped(text, (JsonDoc doc) => {
                        if (doc.KindAt(0) == 5) {
                            int s = doc.Get(0, "mqtt");
                            if (s >= 0 && doc.KindAt(s) == 5) {
                                MqttCfg.host = doc.Str(s, "host", "127.0.0.1");
                                MqttCfg.port = (int)doc.Long(s, "port", 1883L);
                            }
                        }
                    });
                    return;
                } catch (Exception) { }
            }
            i = i + 1;
        }
    }
}
