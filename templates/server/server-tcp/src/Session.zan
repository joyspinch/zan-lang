using System;
using System.Net;

/* 每个连接一份会话状态。 */
public class Session {
    public Connection conn;
    public string nick;
    public bool quitting;
    public bool overflowed;   /* 本次输入里有超长行被丢弃 */
    string pending;   /* 还没遇到 \n 的半截输入 */

    /* 单行上限：防止对端只发不换行把内存撑爆。 */
    const int MaxLine = 4096;

    public Session(Connection conn, string nick) {
        this.conn = conn;
        this.nick = nick;
        this.quitting = false;
        this.overflowed = false;
        this.pending = "";
    }

    /* 喂入新收到的字节，返回其中所有完整行（已去掉 \r\n）。 */
    public List<string> Feed(string data) {
        List<string> lines = new List<string>();
        string buf = this.pending + data;
        int start = 0;
        for (int i = 0; i < buf.Length; i++) {
            if (buf[i] == '\n') {
                string line = buf.Substring(start, i - start);
                if (line.EndsWith("\r")) { line = line.Substring(0, line.Length - 1); }
                if (line.Length > MaxLine) {
                    this.overflowed = true;
                } else {
                    lines.Add(line);
                }
                start = i + 1;
            }
        }
        this.pending = buf.Substring(start);
        if (this.pending.Length > MaxLine) {
            this.pending = "";
            this.overflowed = true;
        }
        return lines;
    }
}
