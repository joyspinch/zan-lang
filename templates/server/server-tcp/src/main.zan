using System;
using System.Net;

/* {{NAME}} -- Worker 统一宿主上的最小 TCP 服务器。 */
/* accept、一连接一协程、断线检测全部由 Worker 内建；业务只写 onConnect/onMessage/onClose 回调。 */
/* 如需完整框架（路由、限流、认证、内存视图），改用 "Web MVC Framework" 模板。 */
class Program {
    static async int Run() {
        Worker server = new Worker("tcp", "127.0.0.1", 9000);
        server.onConnect = Program.OnConnect;
        server.onMessage = Program.OnMessage;
        server.onClose = Program.OnClose;

        Console.WriteLine("{{NAME}} listening on tcp://127.0.0.1:9000");
        await Worker.RunAll();            /* 永不返回 */
        return 0;
    }

    static async void OnConnect(Connection conn) {
        Console.WriteLine("[open] client#" + Convert.ToString(conn.GetId()));
        conn.Send("welcome, client#" + Convert.ToString(conn.GetId()) + "\n");
    }

    /* 返回值即回显给对端的内容；返回 "" 不回复。 */
    static async string OnMessage(Connection conn, string data) {
        return data;
    }

    static async void OnClose(Connection conn) {
        Console.WriteLine("[close] client#" + Convert.ToString(conn.GetId()));
    }

    static void Main() {
        int r = await Run();
    }
}
