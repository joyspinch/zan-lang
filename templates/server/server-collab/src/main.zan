using System;
using System.Data;
using System.Diagnostics;
using System.Web;
using Zan.Web;
using Zan.Web.Core;
using Zan.Web.Services;

/* {{NAME}} -- ZanWeb 企业级协同应用。主入口经 Zan.Mvc Boot.Run 装配框架标准件、
   核心 Sys/Crud 路由、安全中间件与生命周期，仅挂载协同业务钩子与管理台外壳扩展。 */
public class Program {
    [DllImport("crt")]
    static extern string getenv(string name);

    static void Main() {
        Boot.OnAfterSchema(Program.AfterSchema);
        Boot.OnApp(Program.WireApp);
        Geo.AddContributor(Program.ContributeGeo);

        int _r = await Boot.Run(AppSchema.Models());
    }

    /* Schema 迁移与系统种子完成后的业务表初始化（共用 Schema 租约连接）。 */
    static async bool AfterSchema(IDbConnection db) {
        await Attachment.EnsureQuotaRow(db);
        await MessageRelay.InitWatermark(db);
        await Zan.Web.Modules.Collab.CollabEventRelay.InitWatermark(db);
        return true;
    }

    /* WebApp 标准件装配完成后挂载协同业务后台任务、聚合源与 AdminShell 扩展。 */
    static void WireApp(WebApp app) {
        /* 日程提醒 / IM 实时层 / 协作事件扇出：ZAN_NO_BG=1 时不启。 */
        if (getenv("ZAN_NO_BG") == null) {
            Task.Spawn(CalendarRemind.Loop());
            Task.Spawn(MessageRelay.Loop());
            Task.Spawn(Zan.Web.Modules.Collab.CollabEventRelay.Loop());
        }

        /* 菜单分段声明 */
        MenuBuilder.Section("lifecycle", "生命周期协同");

        /* 待办源注册 */
        TodoCenter.Register("flow", TodoSources.Flow);
        TodoCenter.Register("crm", TodoSources.Crm);
        TodoCenter.Register("wms", TodoSources.Wms);
        TodoCenter.Register("calendar", CalendarSources.Calendar);

        /* 全局搜索源注册 */
        Search.Register("crm_customer", SearchSources.CrmCustomer);
        Search.Register("crm_contact", SearchSources.CrmContact);
        Search.Register("crm_opportunity", SearchSources.CrmOpportunity);
        Search.Register("wms_sku", SearchSources.WmsSku);
        Search.Register("wms_warehouse", SearchSources.WmsWarehouse);
        Search.Register("flow_inst", SearchSources.FlowInst);
        Search.Register("oa_doc", SearchSources.OaDoc);

        /* 管理台外壳扩展：协同专属样式、脚本与顶栏挂件通过 AdminShell 插槽注入，
           不再分叉 views/Admin/layout.html 或 admin.css/admin.js。 */
        AdminShell.AddStyle("/static/css/collab.css?v=1");
        AdminShell.AddScript("/static/vendor/alpine.min.js");
        AdminShell.AddScript("/static/js/collab.js?v=1");
        AdminShell.AddScript("/static/js/attach.js?v=2");
        AdminShell.AddScript("/static/js/bell.js?v=2");
        AdminShell.AddScript("/static/js/search.js?v=1");
        AdminShell.AddScript("/static/js/blocks.js?v=2");
        AdminShell.AddScript("/static/js/chat.js?v=2");

        AdminShell.AddTopWidget("collab-gsearch",
            "<div class=\"ad-gsearch\" data-gsearch>"
            + "<input type=\"search\" data-gsearch-input placeholder=\"搜索客户、商机、流程…\" autocomplete=\"off\">"
            + "<div class=\"ad-gsearch-menu\" data-gsearch-menu hidden><div data-gsearch-list></div></div>"
            + "</div>\n");
        AdminShell.AddTopWidget("collab-bell",
            "<div class=\"collab-bell\" data-bell title=\"通知\">"
            + "<button class=\"collab-bell-btn\" type=\"button\" data-bell-btn>🔔<i class=\"collab-bell-badge\" data-bell-badge hidden>0</i></button>"
            + "<div class=\"collab-bell-menu\" data-bell-menu hidden>"
            + "<div class=\"collab-bell-head\">通知 <a href=\"/admin/oa/notifies\" data-tab data-title=\"通知中心\">全部</a></div>"
            + "<div data-bell-list><div class=\"collab-bell-empty\">暂无未读</div></div>"
            + "</div></div>\n");
    }

    /* GEO 协同模块链接贡献：并入 /llms.txt。 */
    static async bool ContributeGeo(GeoBuilder builder) {
        builder.Link("Modules", "Lifecycle Workbench", "/admin/lifecycle/workbench", "全生命周期大屏工作台");
        builder.Link("Modules", "Lifecycle Templates", "/admin/lifecycle/templates", "业务生命周期模板配置中心");
        builder.Link("Modules", "OA Documents", "/admin/oa/docs", "企业协同文档与知识库");
        builder.Link("Modules", "Flow Engine", "/admin/flow/flows", "审批与自动化工作流定义");
        builder.Link("Modules", "CRM", "/admin/crm/customers", "客户与销售机会管理");
        builder.Link("Modules", "WMS", "/admin/wms/inventory", "库存与出入库单据");
        return true;
    }
}
