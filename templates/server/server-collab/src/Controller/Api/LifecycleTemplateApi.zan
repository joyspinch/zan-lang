using System;
using System.Collections.Generic;
using System.Data.Orm;
using System.Json;
using System.Web;
using ZanWeb.Model.Lifecycle;
using ZanWeb.Model;
using ZanWeb.Security;

namespace ZanWeb.Api;

/* 生命周期配置元数据接口：
   提供业务模板与阶段定义的完整增删改查、排序及开箱即用默认配置 Seed，
   使企业全链路流程完全数据驱动，彻底避免业务硬编码。 */
[Route("api/lifecycle-template/[action]")]
[Custom(Authorization = CustomAuthorization.ApiAuth)]
[Description("生命周期配置模板域")]
class LifecycleTemplateApi : ApiController {

    /* 开箱即用默认配置 Seed 种子注入：
       如果租户未配置任何模板，则自动植入标准的服饰快反全链路模板与 5 大标准阶段定义。 */
    public static async void SeedDefaultTemplates(ApiController c, int tenantId) {
        long count = await c.LifecycleTemplate
            .Where(a => a.tenantId == tenantId).CountAsync();
        if (count > 0) { return; }

        long now = WebApp.NowSeconds();

        /* 1. 默认服饰快反爆款全链路模板 */
        LifecycleTemplate tmpl = new LifecycleTemplate();
        tmpl.tenantId = tenantId;
        tmpl.templateKey = "clothing_fast_fashion";
        tmpl.name = "服饰快反爆款全链路模板";
        tmpl.category = "服装鞋包";
        tmpl.description = "适用于快时尚女装/休闲服饰爆款研发，从市场企划、柔性工序打样、跨平台货盘锁库到全域投流与复盘追单";
        tmpl.isDefault = 1;
        tmpl.status = "active";
        tmpl.createdAt = now;
        tmpl.updatedAt = now;
        int templateId = await c.LifecycleTemplate.Insert(tmpl).ExecuteIdentityAsync();

        /* 2. 注入 5 大标准阶段元数据定义 */
        /* 阶段 1: 企划与选品 */
        LifecycleStageDef st1 = new LifecycleStageDef();
        st1.tenantId = tenantId;
        st1.templateId = templateId;
        st1.stageKey = "selection";
        st1.stageName = "1.企划与选品";
        st1.seq = 10;
        st1.defaultAiAgentRole = "选品分析师Agent";
        st1.aiPromptTemplate = "[选品分析师Agent] 竞品均价 ¥89-129，同类热度环比 +142%。建议测款首批生产 1,000 件，阶梯定价：首单体验价 ¥79，零售价 ¥99，预估毛利率 52.8%。";
        st1.metric1Name = "建议零售价";
        st1.metric1Default = "¥99";
        st1.metric2Name = "预估BOM成本";
        st1.metric2Default = "¥46.8";
        st1.metric3Name = "首批测款产能";
        st1.metric3Default = "1,000件";
        st1.createdAt = now;
        st1.updatedAt = now;
        await c.LifecycleStageDef.Insert(st1).ExecuteIdentityAsync();

        /* 阶段 2: 打样与生产 */
        LifecycleStageDef st2 = new LifecycleStageDef();
        st2.tenantId = tenantId;
        st2.templateId = templateId;
        st2.stageKey = "manufacturing";
        st2.stageName = "2.打样与生产";
        st2.seq = 20;
        st2.defaultAiAgentRole = "工艺排产Agent";
        st2.aiPromptTemplate = "[工艺排产Agent] 智能 BOM 已推导完成：面料耗损率预估 2.4%，主辅料已锁定。智能工序调度排期：裁剪 2天 -> 车缝 4天 -> 质检整烫 1天，预计第 7 天质检合格入库。";
        st2.metric1Name = "排产交付工期";
        st2.metric1Default = "7 天";
        st2.metric2Name = "计划良品率";
        st2.metric2Default = "98.5%";
        st2.metric3Name = "面料耗损容差";
        st2.metric3Default = "2.4%";
        st2.createdAt = now;
        st2.updatedAt = now;
        await c.LifecycleStageDef.Insert(st2).ExecuteIdentityAsync();

        /* 阶段 3: 上架与渠道 */
        LifecycleStageDef st3 = new LifecycleStageDef();
        st3.tenantId = tenantId;
        st3.templateId = templateId;
        st3.stageKey = "publishing";
        st3.stageName = "3.上架与渠道";
        st3.seq = 30;
        st3.defaultAiAgentRole = "货品上架Agent";
        st3.aiPromptTemplate = "[货品上架Agent] 多渠道主图与商详卖点已就绪。主打核心卖点'保暖垂顺/防静电'。跨平台库存策略建议：主推渠道 40%，次要渠道 35%，全域分发 25%，防超卖锁定。";
        st3.metric1Name = "主推渠道矩阵";
        st3.metric1Default = "抖音/天猫/快手";
        st3.metric2Name = "库存动态配比";
        st3.metric2Default = "40:35:25";
        st3.metric3Name = "库存安全机制";
        st3.metric3Default = "全域防超卖锁定";
        st3.createdAt = now;
        st3.updatedAt = now;
        await c.LifecycleStageDef.Insert(st3).ExecuteIdentityAsync();

        /* 阶段 4: 全域营销推广 */
        LifecycleStageDef st4 = new LifecycleStageDef();
        st4.tenantId = tenantId;
        st4.templateId = templateId;
        st4.stageKey = "marketing";
        st4.stageName = "4.全域营销推广";
        st4.seq = 40;
        st4.defaultAiAgentRole = "营销创意Agent";
        st4.aiPromptTemplate = "[营销创意Agent] 3 套带货短视频分镜脚本已生成，黄金前 3 秒痛点抓手完备。建议投放梯队：头部 1 位背书 + 中腰部 10 位挂车起量；ROI 止损警戒线设为 1.8。";
        st4.metric1Name = "初期投放预算";
        st4.metric1Default = "¥30,000";
        st4.metric2Name = "保底止损ROI";
        st4.metric2Default = "2.0";
        st4.metric3Name = "KOL达人梯队";
        st4.metric3Default = "1头部+10中腰部";
        st4.createdAt = now;
        st4.updatedAt = now;
        await c.LifecycleStageDef.Insert(st4).ExecuteIdentityAsync();

        /* 阶段 5: 复盘与持续优化 */
        LifecycleStageDef st5 = new LifecycleStageDef();
        st5.tenantId = tenantId;
        st5.templateId = templateId;
        st5.stageKey = "optimization";
        st5.stageName = "5.复盘与持续优化";
        st5.seq = 50;
        st5.defaultAiAgentRole = "数据归因Agent";
        st5.aiPromptTemplate = "[数据归因Agent] 上线首周客诉退货率 3.1%（显著优于行业 8% 大盘）。好评关键词集中在'触感细腻'；归因发现个别反馈裤长偏长，已输出版型优化与追加翻单建议。";
        st5.metric1Name = "客诉退货容忍率";
        st5.metric1Default = "3.1%";
        st5.metric2Name = "首轮追加翻单";
        st5.metric2Default = "3,000件";
        st5.metric3Name = "二代迭代方向";
        st5.metric3Default = "裤长版型微调";
        st5.createdAt = now;
        st5.updatedAt = now;
        await c.LifecycleStageDef.Insert(st5).ExecuteIdentityAsync();
    }

    [Description("可用业务模板列表")]
    [Custom(Perm = PermBit.View)]
    async void Templates() {
        int tid = Tenant.Cur();
        await LifecycleTemplateApi.SeedDefaultTemplates(this, tid);

        List<LifecycleTemplate> list = await this.LifecycleTemplate
            .Where(a => a.tenantId == tid && a.status == "active")
            .OrderByDescending(a => a.isDefault)
            .OrderBy(a => a.id)
            .ToListAsync();

        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < list.Count; i = i + 1) {
            LifecycleTemplate t = list[i];
            long stageCount = await this.LifecycleStageDef
                .Where(a => a.templateId == t.id).CountAsync();

            JsonValue o = JsonValue.NewObject();
            o.Put("id", JsonValue.NewStr(Convert.ToString(t.id)));
            o.Put("templateKey", JsonValue.NewStr(t.templateKey));
            o.Put("name", JsonValue.NewStr(t.name));
            o.Put("category", JsonValue.NewStr(t.category));
            o.Put("description", JsonValue.NewStr(t.description));
            o.Put("isDefault", JsonValue.NewNum(Convert.ToString(t.isDefault)));
            o.Put("stageCount", JsonValue.NewNum(Convert.ToString(stageCount)));
            arr.Append(o);
        }

        JsonValue ret = JsonValue.NewObject();
        ret.Put("templates", arr);
        this.Ok(ret.ToJson());
    }

    [Description("模板详情与阶段元数据列表")]
    [Custom(Perm = PermBit.View)]
    async void Detail() {
        int id = this.InInt("id", 0);
        int tid = Tenant.Cur();
        await LifecycleTemplateApi.SeedDefaultTemplates(this, tid);

        LifecycleTemplate t = null;
        if (id > 0) {
            t = await this.LifecycleTemplate.Where(a => a.id == id && a.tenantId == tid).FirstAsync();
        } else {
            t = await this.LifecycleTemplate.Where(a => a.tenantId == tid && a.isDefault == 1).FirstAsync();
        }
        if (t == null) { this.Fail(404, "0404", "模板不存在"); return; }

        List<LifecycleStageDef> stages = await this.LifecycleStageDef
            .Where(a => a.templateId == t.id)
            .OrderBy(a => a.seq)
            .ToListAsync();

        JsonValue stArr = JsonValue.NewArray();
        for (int i = 0; i < stages.Count; i = i + 1) {
            LifecycleStageDef s = stages[i];
            JsonValue so = JsonValue.NewObject();
            so.Put("id", JsonValue.NewStr(Convert.ToString(s.id)));
            so.Put("stageKey", JsonValue.NewStr(s.stageKey));
            so.Put("stageName", JsonValue.NewStr(s.stageName));
            so.Put("seq", JsonValue.NewNum(Convert.ToString(s.seq)));
            so.Put("defaultAiAgentRole", JsonValue.NewStr(s.defaultAiAgentRole));
            so.Put("aiPromptTemplate", JsonValue.NewStr(s.aiPromptTemplate));
            so.Put("metric1Name", JsonValue.NewStr(s.metric1Name));
            so.Put("metric1Default", JsonValue.NewStr(s.metric1Default));
            so.Put("metric2Name", JsonValue.NewStr(s.metric2Name));
            so.Put("metric2Default", JsonValue.NewStr(s.metric2Default));
            so.Put("metric3Name", JsonValue.NewStr(s.metric3Name));
            so.Put("metric3Default", JsonValue.NewStr(s.metric3Default));
            stArr.Append(so);
        }

        JsonValue to = JsonValue.NewObject();
        to.Put("id", JsonValue.NewStr(Convert.ToString(t.id)));
        to.Put("templateKey", JsonValue.NewStr(t.templateKey));
        to.Put("name", JsonValue.NewStr(t.name));
        to.Put("category", JsonValue.NewStr(t.category));
        to.Put("description", JsonValue.NewStr(t.description));
        to.Put("isDefault", JsonValue.NewNum(Convert.ToString(t.isDefault)));
        to.Put("stages", stArr);

        this.Ok(to.ToJson());
    }

    [Description("保存或新增业务模板")]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    async void Save() {
        int id = this.InInt("id", 0);
        string name = this.Need("name", "模板名称");
        string category = this.In("category");
        string description = this.In("description");
        string templateKey = this.In("templateKey");
        if (templateKey.Length == 0) { templateKey = "custom_" + Convert.ToString(WebApp.NowSeconds()); }

        int tid = Tenant.Cur();
        long now = WebApp.NowSeconds();

        LifecycleTemplate t = null;
        if (id > 0) {
            t = await this.LifecycleTemplate.Where(a => a.id == id && a.tenantId == tid).FirstAsync();
        }
        if (t == null) {
            t = new LifecycleTemplate();
            t.tenantId = tid;
            t.templateKey = templateKey;
            t.isDefault = 0;
            t.status = "active";
            t.createdAt = now;
        }

        t.name = name;
        t.category = category;
        t.description = description;
        t.updatedAt = now;

        if (id > 0) {
            await this.LifecycleTemplate.Update(t).ExecuteAffrowsAsync();
        } else {
            id = await this.LifecycleTemplate.Insert(t).ExecuteIdentityAsync();
        }

        JsonValue ret = JsonValue.NewObject();
        ret.Put("id", JsonValue.NewStr(Convert.ToString(id)));
        this.Ok(ret.ToJson());
    }

    [Description("保存或更新阶段定义")]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    async void SaveStage() {
        int stageId = this.InInt("id", 0);
        int templateId = this.InInt("templateId", 0);
        if (templateId <= 0) { this.Fail(400, "0400", "缺少 templateId"); return; }

        string stageKey = this.Need("stageKey", "阶段唯一标识");
        string stageName = this.Need("stageName", "阶段名称");
        int seq = this.InInt("seq", 10);
        string aiRole = this.In("defaultAiAgentRole");
        string aiPrompt = this.In("aiPromptTemplate");
        string m1n = this.In("metric1Name");
        string m1d = this.In("metric1Default");
        string m2n = this.In("metric2Name");
        string m2d = this.In("metric2Default");
        string m3n = this.In("metric3Name");
        string m3d = this.In("metric3Default");

        int tid = Tenant.Cur();
        long now = WebApp.NowSeconds();

        LifecycleStageDef st = null;
        if (stageId > 0) {
            st = await this.LifecycleStageDef.Where(a => a.id == stageId && a.tenantId == tid).FirstAsync();
        }
        if (st == null) {
            st = new LifecycleStageDef();
            st.tenantId = tid;
            st.templateId = templateId;
            st.createdAt = now;
        }

        st.stageKey = stageKey;
        st.stageName = stageName;
        st.seq = seq;
        st.defaultAiAgentRole = aiRole;
        st.aiPromptTemplate = aiPrompt;
        st.metric1Name = m1n;
        st.metric1Default = m1d;
        st.metric2Name = m2n;
        st.metric2Default = m2d;
        st.metric3Name = m3n;
        st.metric3Default = m3d;
        st.updatedAt = now;

        if (stageId > 0) {
            await this.LifecycleStageDef.Update(st).ExecuteAffrowsAsync();
        } else {
            stageId = await this.LifecycleStageDef.Insert(st).ExecuteIdentityAsync();
        }

        JsonValue ret = JsonValue.NewObject();
        ret.Put("id", JsonValue.NewStr(Convert.ToString(stageId)));
        this.Ok(ret.ToJson());
    }
}
