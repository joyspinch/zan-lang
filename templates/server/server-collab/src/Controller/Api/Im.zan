using System;
using System.Collections;
using System.Data.Orm;
using System.Json;
using System.Web;
using ZanWeb.Model.Oa;
using ZanWeb.Model;

namespace ZanWeb.Api;

/* 桌面客户端（gui-wechat）IM 接口：与 /admin/oa/messages 同一份数据与回执
   语义，专为 token 调用的 JSON 面板（ApiAuth = Grant 的 token 形态）。
   全部端点返回 {code,msg,data}；会话双方本租户启用账号才可达（同 Chat 的
   404 口径）；已读/送达只按 toId 维度写（isRead/isAcked 纪律勿破）。 */
[Route("api/im/[action]")]
[Custom(Authorization = CustomAuthorization.ApiAuth)]
[Description("桌面客户端 IM")]
class Im : ApiController {
    /* 会话列表：按对端分组的最新一条 + 未读数 + 我发消息的已读/送达摘要
       （客户端列表页要的"已读/已送达"角标直接给结果，不再算一遍）。
       单遍聚合：id 倒序扫一遍，对端第一次出现即该会话的最新一条，
       计数随行累进到槽里，出槽时一次落 JSON——没有第二遍回填。 */
    [HttpGet]
    [Description("会话列表")]
    [Custom(Perm = PermBit.View)]
    async void Chats() {
        SysUser me = await this.Me();
        // 轮询端点（客户端每 4.5s 拉一次）：限最新 2000 条让扫描成本
        // 有界。未读与回执都落在"新近"消息上，窗口外的老账不影响列表页。
        List<OaMessage> rows = await this.OaMessage
            .Where(a => (a.fromId == me.id || a.toId == me.id))
            .OrderByDescending(a => a.id).Take(2000).ToListAsync();
        List<SysUser> users = await this.SysUser
            .Where(a => a.status == 1)
            .ToListAsync();
        List<ChatSlot> slots = new List<ChatSlot>();
        Dict<int, ChatSlot> byPeer = new Dict<int, ChatSlot>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            OaMessage r = rows[i];
            int peer = r.fromId == me.id ? r.toId : r.fromId;
            ChatSlot s;
            if (!byPeer.TryGetValue(peer, out s)) {
                s = new ChatSlot();
                s.peer = peer;
                s.lastText = Im.Excerpt(r.content, 60);
                s.lastAt = Convert.ToString(r.createdAt);
                s.mine = r.fromId == me.id;
                s.readed = s.mine && r.isRead == 1;
                s.acked = s.mine && (r.isRead == 1 || r.isAcked == 1);
                byPeer.Add(peer, s);
                slots.Add(s);
            }
            if (r.toId == me.id) {
                if (r.isRead == 0) { s.unread = s.unread + 1; }
                /* 收件人侧：对方发来还没打送达位的最新一条（id 倒序扫，
                   记第一条命中）。客户端拿到就立刻回执——"已送达"不必
                   等用户点开这条会话才亮；回执后下一拍再取剩下的。 */
                if (r.isAcked == 0 && s.ackId == 0) { s.ackId = r.id; }
            }
            if (r.fromId == me.id && r.isRead == 0) {
                s.sentUnread = s.sentUnread + 1;
            }
        }
        JsonValue items = JsonValue.NewArray();
        for (int i = 0; i < slots.Count; i = i + 1) {
            ChatSlot s = slots[i];
            JsonValue o = JsonValue.NewObject();
            o.Put("peerId", JsonValue.NewStr(Convert.ToString(s.peer)));
            o.Put("peerName", JsonValue.NewStr(Im.NameOf(users, s.peer)));
            o.Put("lastText", JsonValue.NewStr(s.lastText));
            o.Put("lastAt", JsonValue.NewStr(s.lastAt));
            o.Put("mine", JsonValue.NewStr(s.mine ? "1" : "0"));
            o.Put("readed", JsonValue.NewStr(s.readed ? "1" : "0"));
            o.Put("acked", JsonValue.NewStr(s.acked ? "1" : "0"));
            o.Put("unread", JsonValue.NewStr(Convert.ToString(s.unread)));
            o.Put("sentUnread", JsonValue.NewStr(Convert.ToString(s.sentUnread)));
            o.Put("ackId", JsonValue.NewStr(Convert.ToString(s.ackId)));
            items.Append(o);
        }
        JsonValue body = JsonValue.NewObject();
        body.Put("chats", items);
        this.Ok(body.ToJson());
    }

    /* 与某人的双向流（时间正序）；对端必须本租户启用账号（404 口径同 Chat）。
       打开会话即批量已读（+送达位），与 Chat 语义一致。 */
    [HttpPost]
    [Description("对话流")]
    [Custom(Perm = PermBit.View)]
    async void Stream() {
        SysUser me = await this.Me();
        int peerId = this.InInt("peer", 0);
        SysUser peer = await this.SysUser
            .Where(a => a.id == peerId
                && a.status == 1).FirstAsync();
        if (peer == null) { this.Fail(404, "0404", "对方不存在或已停用"); }
        List<SysUser> peerList = new List<SysUser>();
        peerList.Add(peer);
        List<OaMessage> rows = await this.OaMessage
            .Where(a => ((a.fromId == me.id && a.toId == peer.id)
                    || (a.fromId == peer.id && a.toId == me.id)))
            .OrderBy(a => a.id).ToListAsync();
        // 引用回复的发送者名字要在这里解析：先按 id 建索引，回填 O(1)。
        Dict<int, OaMessage> byId = new Dict<int, OaMessage>();
        for (int i = 0; i < rows.Count; i = i + 1) { byId[rows[i].id] = rows[i]; }
        JsonValue items = JsonValue.NewArray();
        int maxUnread = 0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            OaMessage r = rows[i];
            JsonValue o = JsonValue.NewObject();
            o.Put("id", JsonValue.NewStr(Convert.ToString(r.id)));
            o.Put("content", JsonValue.NewStr(r.content));
            o.Put("mine", JsonValue.NewStr(r.fromId == me.id ? "1" : "0"));
            o.Put("at", JsonValue.NewStr(Convert.ToString(r.createdAt)));
            o.Put("readed", JsonValue.NewStr(
                (r.fromId == me.id && r.isRead == 1) ? "1" : "0"));
            o.Put("acked", JsonValue.NewStr(
                (r.fromId == me.id && (r.isRead == 1 || r.isAcked == 1)) ? "1" : "0"));
            /* 引用回复：被引消息还在本会话里就回 发送者名 + 摘要，
               客户端拿去画引用条；被引消息已删则照带 replyTo、
               文本为空（客户端按"引用已失效"处理）。 */
            if (r.replyTo > 0) {
                o.Put("replyTo", JsonValue.NewStr(Convert.ToString(r.replyTo)));
                OaMessage q = byId.ContainsKey(r.replyTo) ? byId[r.replyTo] : null;
                if (q != null) {
                    // 被引人只有两种：我（显示"我"）或对端（显示其昵称）。
                    // 两个人的会话里 NameOf 只需要 user 表里的对端一行。
                    string who = q.fromId == me.id
                        ? "我" : Im.NameOf(peerList, q.fromId);
                    o.Put("quoteWho", JsonValue.NewStr(who));
                    o.Put("quoteText", JsonValue.NewStr(Im.Excerpt(q.content, 60)));
                }
            }
            items.Append(o);
            if (r.toId == me.id && r.isRead == 0 && r.id > maxUnread) {
                maxUnread = r.id;
            }
        }
        JsonValue body = JsonValue.NewObject();
        body.Put("peer", JsonValue.NewStr(Convert.ToString(peer.id)));
        body.Put("peerName", JsonValue.NewStr(Im.NameOf(peerList, peer.id)));
        body.Put("msgs", items);
        /* 打开即批量已读 + 送达位（只清 toId==me 侧）；确有新已读落事件。 */
        int n = await this.OaMessage.Update()
            .Set(a => a.isRead, 1)
            .Set(a => a.isAcked, 1)
            .Where(a => a.toId == me.id && a.fromId == peer.id && a.isRead == 0)
            .ExecuteAffrowsAsync();
        if (n > 0 && maxUnread > 0) {
            await Im.Receipt(this.Held(), Tenant.Cur(), maxUnread,
                peer.id, me.id, 2);
        }
        this.Ok(body.ToJson());
    }

    /* 发送：语义同 /admin/oa/messages/send（正文 2048 上限、通知走铃铛）。 */
    [HttpPost]
    [Description("发送私信")]
    [Custom(Perm = PermBit.View)]
    async void Send() {
        SysUser me = await this.Me();
        int peerId = this.InInt("peer", 0);
        string content = this.InRaw("content");
        if (content.Length == 0) { this.Fail(400, "0003", "私信内容不能为空"); }
        if (content.Length > 2048) { content = content.Substring(0, 2048); }
        if (peerId == me.id) { this.Fail(400, "0004", "不能给自己发私信"); }
        SysUser peer = await this.SysUser
            .Where(a => a.id == peerId
                && a.status == 1).FirstAsync();
        if (peer == null) { this.Fail(404, "0404", "对方不存在或已停用"); }
        /* 引用回复：replyTo 必须是本会话里的既有消息，否则按普通消息
           收下（客户端伪造/被引消息已删都不至于 500，也不留悬空引用）。 */
        int replyTo = this.InInt("replyTo", 0);
        if (replyTo > 0) {
            OaMessage q = await this.OaMessage
                .Where(a => a.id == replyTo
                    && ((a.fromId == me.id && a.toId == peerId)
                        || (a.fromId == peerId && a.toId == me.id))).FirstAsync();
            if (q == null) { replyTo = 0; }
        }
        OaMessage r = new OaMessage();
        r.tenantId = Tenant.Cur();
        r.fromId = me.id;
        r.toId = peer.id;
        r.content = content;
        r.isRead = 0;
        r.isAcked = 0;
        r.replyTo = replyTo;
        r.createdAt = WebApp.NowSeconds();
        int msgId = await this.OaMessage.Insert(r).ExecuteIdentityAsync();
        await Notify.Send(this.Held(), Tenant.Cur(), peer.id, "oa", "message",
            "新私信：" + Fmt.Text(me.nickname, me.username),
            Im.Excerpt(content, 50),
            "/admin/oa/messages/chat?peer=" + Convert.ToString(me.id));
        JsonValue body = JsonValue.NewObject();
        body.Put("id", JsonValue.NewStr(Convert.ToString(msgId)));
        body.Put("at", JsonValue.NewStr(Convert.ToString(r.createdAt)));
        this.Ok(body.ToJson());
    }

    /* 送达回执：收件人客户端收帧后打点（幂等，只按 toId 维度）。
       两种口径：
         - id=<消息 id>：单条送达；
         - peer=<对端 id>：把该对端发给我且尚未送达的全部一次性打点
           （客户端只轮询 /chats 拿不到逐条 id，"已送达"要在对方打开
           会话之前就亮，批量口径是必需的）。 */
    [HttpPost]
    [Description("送达回执")]
    [Custom(Perm = PermBit.View)]
    async void Ack() {
        SysUser me = await this.Me();
        int peerId = this.InInt("peer", 0);
        if (peerId > 0) { await this.AckPeer(me, peerId); return; }
        int id = this.InInt("id", 0);
        if (id <= 0) { this.Fail(400, "0003", "缺少消息 id"); }
        OaMessage r = await this.OaMessage
            .Where(a => a.id == id)
            .FirstAsync();
        if (r == null || r.toId != me.id) {
            this.Fail(404, "0404", "消息不存在");
        }
        int n = await this.OaMessage.Update()
            .Set(a => a.isAcked, 1)
            .Where(a => a.id == r.id
                && a.toId == me.id && a.isAcked == 0)
            .ExecuteAffrowsAsync();
        if (n > 0) {
            await Im.Receipt(this.Held(), Tenant.Cur(), r.id,
                r.fromId, me.id, 1);
        }
        JsonValue body = JsonValue.NewObject();
        body.Put("ok", JsonValue.NewStr("1"));
        this.Ok(body.ToJson());
    }

    /* 批量送达：某对端发给我且还没送达的那些，一次打点。回执事件按
       最大 id 记一条（与 Stream 的已读批量同一口径——事件表记的是
       "这批到哪"，不是逐条流水）。 */
    private async  void AckPeer(SysUser me, int peerId) {
        List<OaMessage> rows = await this.OaMessage
            .Where(a => a.toId == me.id
                && a.fromId == peerId && a.isAcked == 0)
            .OrderByDescending(a => a.id).ToListAsync();
        if (rows.Count == 0) {
            JsonValue zero = JsonValue.NewObject();
            zero.Put("ok", JsonValue.NewStr("1"));
            this.Ok(zero.ToJson());
        }
        int maxId = rows[0].id;
        await this.OaMessage.Update()
            .Set(a => a.isAcked, 1)
            .Where(a => a.toId == me.id
                && a.fromId == peerId && a.isAcked == 0)
            .ExecuteAffrowsAsync();
        await Im.Receipt(this.Held(), Tenant.Cur(), maxId,
            peerId, me.id, 1);
        JsonValue body = JsonValue.NewObject();
        body.Put("ok", JsonValue.NewStr("1"));
        this.Ok(body.ToJson());
    }

    /* 未读数（铃铛口径）：全部会话未读合计 + 明细。 */
    [HttpGet]
    [Description("未读数")]
    [Custom(Perm = PermBit.View)]
    async void Unread() {
        SysUser me = await this.Me();
        int total = await this.OaMessage
            .Where(a => a.toId == me.id && a.isRead == 0).CountAsync();
        JsonValue body = JsonValue.NewObject();
        body.Put("count", JsonValue.NewStr(Convert.ToString(total)));
        this.Ok(body.ToJson());
    }

    /* 本租户可选联系人（会话发起的选人页）：不含自己。 */
    [HttpGet]
    [Description("联系人")]
    [Custom(Perm = PermBit.View)]
    async void Contacts() {
        SysUser me = await this.Me();
        List<SysUser> users = await this.SysUser
            .Where(a => a.status == 1)
            .OrderBy(a => a.id).ToListAsync();
        JsonValue items = JsonValue.NewArray();
        for (int i = 0; i < users.Count; i = i + 1) {
            SysUser u = users[i];
            if (u.id == me.id) { continue; }
            JsonValue o = JsonValue.NewObject();
            o.Put("id", JsonValue.NewStr(Convert.ToString(u.id)));
            o.Put("name", JsonValue.NewStr(Fmt.Text(u.nickname, u.username)));
            // 登录名（客户端资料卡的"微信号"一栏显示它）。
            o.Put("username", JsonValue.NewStr(u.username));
            items.Append(o);
        }
        JsonValue body = JsonValue.NewObject();
        body.Put("contacts", items);
        this.Ok(body.ToJson());
    }

    /* ---- helpers ---- */

    /* 当前登录账号（ApiAuth 下 uid 必在；查不到即 401——token 版本失效等）。 */
    private async  SysUser Me() {
        SysUser me = await this.SysUser
            .Where(a => a.id == Filter.ToInt(this.uid, 0)).FirstAsync();
        if (me == null || me.status != 1) {
            this.Fail(401, "1001", "账号不可用，请重新登录");
        }
        return me;
    }

    /* 回执事件落库（与 Messages.Receipt 同语义；此处无请求租约外的
       依赖，直接走请求连接）。 */
    static async void Receipt(IDbConnection db, int tenantId, int msgId,
        int senderId, int byId, int kind) {
        OaMessageEvent ev = new OaMessageEvent();
        ev.tenantId = tenantId;
        ev.msgId = msgId;
        ev.fromId = senderId;
        ev.toId = byId;
        ev.kind = kind;
        ev.createdAt = WebApp.NowSeconds();
        await db.Insert<OaMessageEvent>(ev).ExecuteIdentityAsync();
    }

    /// Chats() 的按对端聚合槽：一行消息把最新一条与计数一次算清，
    /// 不再要四个平行数组按下标对位。
    class ChatSlot {
        int peer;
        string lastText;
        string lastAt;
        bool mine;
        bool readed;
        bool acked;
        int unread;
        int sentUnread;
        int ackId;
    }

    static string NameOf(List<SysUser> users, int id) {
        for (int i = 0; i < users.Count; i = i + 1) {
            if (users[i].id == id) { return Fmt.Text(users[i].nickname, users[i].username); }
        }
        return "用户" + Convert.ToString(id);
    }

    /* 会话列表/联系人摘要统一走 Fmt.Excerpt：按字节截断前先回退到
       UTF-8 字符边界（切掉半个汉字会让整个 JSON 应答不可解析，
       客户端拿到的是乱码会话列表——"消息乱码"的根因之一）。 */
    static string Excerpt(string s, int max) { return WebFmt.Excerpt(s, max); }
}
