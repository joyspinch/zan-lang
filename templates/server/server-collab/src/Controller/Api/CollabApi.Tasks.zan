using System;
using System.Collections;
using System.Data.Orm;
using System.IO;
using System.Json;
using System.Web;
using Zan.Web.Model.Collab;
using Zan.Web.Model.Oa;
using Zan.Web.Model;
using Zan.Web.Modules.Collab;
using Zan.Web.Dao.Collab;
using Zan.Web.Dao.Oa;

namespace Zan.Web.Api;

partial class CollabApi : ApiController {
    [HttpPost]
    [Description("创建任务")]
    [Custom(Perm = PermBit.Create)]
    public async void TaskCreate() {
        SysUser me = await this.Me();
        string title = this.Need("title", "任务标题");
        if (title.Length > 128) { title = title.Substring(0, 128); }
        string crid = this.Crid();
        int conversationId = this.InInt("conversationId", 0);
        if (conversationId > 0) {
            CollabConversation c = await Policy.Conversation(this.Held(),
                Tenant.Cur(), conversationId);
            if (c == null) { this.Fail(404, "0404", "会话不存在"); }
            CollabMember mine = await Policy.Member(this.Held(), Tenant.Cur(),
                conversationId, me.id);
            if (!Policy.IsActive(mine)) { this.Fail(403, "0403", "仅会话成员可建任务"); }
        }
        int assigneeId = this.InInt("assigneeId", 0);
        SysUser assignee = null;
        if (assigneeId > 0) {
            assignee = await this.SysUser
                .Where(a => a.id == assigneeId
                    && a.status == 1).FirstAsync();
            if (assignee == null) { this.Fail(404, "0404", "指定执行人不存在或已停用"); }
        }
        int priority = this.InInt("priority", 1);
        if (priority < 0) { priority = 0; }
        if (priority > 3) { priority = 3; }
        await this.Begin();
        string stored = await this.IdemBegin(me.id, "task.create", crid);
        if (stored != null) { await this.Rollback(); this.Replay(stored); return; }
        long now = WebApp.NowSeconds();
        CollabTask t = new CollabTask();
        t.tenantId = Tenant.Cur();
        t.conversationId = conversationId;
        t.createdBy = me.id;
        t.ownerId = me.id;
        t.assigneeId = assignee == null ? 0 : assignee.id;
        t.title = title;
        t.description = this.In("description");
        t.status = assignee == null ? "unassigned" : "claimed";
        t.priority = priority;
        t.progress = 0;
        t.dueAt = this.InInt("dueAt", 0);
        t.blockedReason = "";
        t.flowInstId = 0;
        t.version = 1;
        t.createdAt = now;
        t.updatedAt = now;
        t.completedAt = 0;
        int id = await this.CollabTask.Insert(t).ExecuteIdentityAsync();
        await this.TaskLog(t, id, "created", me.id, t.status, t.assigneeId,
            t.ownerId, 0, "", "", crid);
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("id", id.ToString());
        w.WriteProperty("status", t.status);
        w.EndObject();
        await this.IdemFinish(me.id, "task.create", crid, "task", id, w.ToJson());
        await this.Commit();
        this.Ok(w.ToJson());
    }

    /* 我的任务：执行人或责任侧；status 过滤（缺省全部）；overdue 由 dueAt
       派生（视图），不落状态列。 */
    [HttpGet]
    [Description("我的任务")]
    [Custom(Perm = PermBit.View)]
    public async void TasksMine() {
        SysUser me = await this.Me();
        string status = this.In("status");
        long now = WebApp.NowSeconds();
        List<CollabTask> rows = await this.CollabTask
            .Where(a => (a.assigneeId == me.id || a.ownerId == me.id))
            .WhereIf(status.Length > 0 && status != "all", a => a.status == status)
            .OrderBy(a => a.id).Take(100).ToListAsync();
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteKey("tasks");
        w.StartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            CollabTask t = rows[i];
            w.StartObject();
            w.WriteProperty("id", t.id.ToString());
            w.WriteProperty("title", t.title);
            w.WriteProperty("status", t.status);
            w.WriteProperty("priority", t.priority.ToString());
            w.WriteProperty("progress", t.progress.ToString());
            w.WriteProperty("ownerId", t.ownerId.ToString());
            w.WriteProperty("assigneeId", t.assigneeId.ToString());
            w.WriteProperty("mine", t.assigneeId == me.id ? "1" : "0");
            w.WriteProperty("overdue",
                t.dueAt > 0 && t.dueAt < now && t.status != "done"
                    && t.status != "cancelled" ? "1" : "0");
            w.WriteProperty("dueAt", t.dueAt.ToString());
            w.WriteProperty("version", t.version.ToString());
            w.EndObject();
        }
        w.EndArray();
        w.EndObject();
        this.Ok(w.ToJson());
    }

    /* 任务池：未分配任务（可按会话过滤），认领入口。 */
    [HttpGet]
    [Description("任务池")]
    [Custom(Perm = PermBit.View)]
    public async void TasksPool() {
        SysUser me = await this.Me();
        int conversationId = this.InInt("conversationId", 0);
        List<CollabTask> rows = await this.CollabTask
            .Where(a => a.status == "unassigned")
            .WhereIf(conversationId > 0, a => a.conversationId == conversationId)
            .OrderBy(a => a.id).Take(100).ToListAsync();
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteKey("tasks");
        w.StartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            CollabTask t = rows[i];
            w.StartObject();
            w.WriteProperty("id", t.id.ToString());
            w.WriteProperty("title", t.title);
            w.WriteProperty("conversationId", t.conversationId.ToString());
            w.WriteProperty("priority", t.priority.ToString());
            w.WriteProperty("dueAt", t.dueAt.ToString());
            w.EndObject();
        }
        w.EndArray();
        w.EndObject();
        this.Ok(w.ToJson());
    }

    /* 任务详情 + 不可变时间线（最近 100 条，升序）。参与可见：责任侧/
       执行人/会话成员；跨租户同 404。 */
    [HttpGet]
    [Description("任务详情")]
    [Custom(Perm = PermBit.View)]
    public async void TaskDetail() {
        SysUser me = await this.Me();
        CollabTask t = await this.LoadTask(this.InInt("id", 0));
        if (!await this.TaskSees(t, me)) { this.Fail(403, "0403", "无权查看该任务"); }
        List<CollabTaskEvent> evs = await this.CollabTaskEvent
            .Where(a => a.taskId == t.id)
            .OrderBy(a => a.id).Take(100).ToListAsync();
        List<CollabAttachmentLink> tlinks = await this.CollabAttachmentLink
            .Where(a => a.ownerType == "task"
                && a.ownerId == t.id).ToListAsync();
        List<int> taids = new List<int>();
        for (int i = 0; i < tlinks.Count; i = i + 1) {
            taids.Add(tlinks[i].attachmentId);
        }
        List<OaAttachment> trows = new List<OaAttachment>();
        if (taids.Count > 0) {
            trows = await this.OaAttachment
                .Where(a => taids.Contains(a.id)).ToListAsync();
        }

        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("id", t.id.ToString());
        w.WriteProperty("title", t.title);
        w.WriteProperty("description", t.description);
        w.WriteProperty("status", t.status);
        w.WriteProperty("progress", t.progress.ToString());
        w.WriteProperty("ownerId", t.ownerId.ToString());
        w.WriteProperty("assigneeId", t.assigneeId.ToString());
        w.WriteProperty("blockedReason", t.blockedReason);
        w.WriteProperty("dueAt", t.dueAt.ToString());
        w.WriteProperty("version", t.version.ToString());

        w.WriteKey("attachments");
        w.StartArray();
        for (int i = 0; i < trows.Count; i = i + 1) {
            OaAttachment a1 = trows[i];
            w.StartObject();
            w.WriteProperty("attachmentId", a1.id.ToString());
            w.WriteProperty("fileName", a1.fileName);
            w.WriteProperty("size", a1.size.ToString());
            w.WriteProperty("mime", a1.mime);
            if (a1.imgWidth > 0) {
                w.WriteProperty("width", a1.imgWidth.ToString());
                w.WriteProperty("height", a1.imgHeight.ToString());
            }
            w.EndObject();
        }
        w.EndArray();

        w.WriteKey("events");
        w.StartArray();
        for (int i = 0; i < evs.Count; i = i + 1) {
            CollabTaskEvent e = evs[i];
            w.StartObject();
            w.WriteProperty("id", e.id.ToString());
            w.WriteProperty("event", e.eventType);
            w.WriteProperty("actorId", e.actorId.ToString());
            w.WriteProperty("fromStatus", e.fromStatus);
            w.WriteProperty("toStatus", e.toStatus);
            w.WriteProperty("fromAssigneeId", e.fromAssigneeId.ToString());
            w.WriteProperty("toAssigneeId", e.toAssigneeId.ToString());
            w.WriteProperty("fromProgress", e.fromProgress.ToString());
            w.WriteProperty("toProgress", e.toProgress.ToString());
            w.WriteProperty("reason", e.reason);
            w.WriteProperty("content", e.content);
            w.WriteProperty("at", e.createdAt.ToString());
            w.EndObject();
        }
        w.EndArray();

        w.EndObject();
        this.Ok(w.ToJson());
    }

    /* 认领：CAS——unassigned 且 assignee=0 且 version 相符才生效，
       affected=0 即他人抢先（409）。 */
    [HttpPost]
    [Description("认领任务")]
    [Custom(Perm = PermBit.Update)]
    public async void TaskClaim() {
        SysUser me = await this.Me();
        CollabTask t = await this.LoadTask(this.InInt("id", 0));
        string crid = this.Crid();
        if (t.conversationId > 0) {
            CollabMember mine = await Policy.Member(this.Held(), Tenant.Cur(),
                t.conversationId, me.id);
            if (!Policy.IsActive(mine)) { this.Fail(403, "0403", "仅会话成员可认领"); }
        }
        await this.Begin();
        string stored = await this.IdemBegin(me.id, "task.claim", crid);
        if (stored != null) { await this.Rollback(); this.Replay(stored); return; }
        long now = WebApp.NowSeconds();
        int n = await this.CollabTask.Update()
            .Set(a => a.assigneeId, me.id)
            .Set(a => a.status, "claimed")
            .Set(a => a.version, t.version + 1)
            .Set(a => a.updatedAt, now)
            .Where(a => a.id == t.id
                && a.status == "unassigned" && a.assigneeId == 0
                && a.version == t.version)
            .ExecuteAffrowsAsync();
        if (n == 0) { this.Fail(409, "0409", "任务已被他人认领或状态已变化"); }
        await this.TaskLog(t, t.id, "claimed", me.id, "claimed", me.id,
            t.ownerId, t.progress, "", "", crid);
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("ok", "1");
        w.WriteProperty("status", "claimed");
        w.EndObject();
        await this.IdemFinish(me.id, "task.claim", crid, "task", t.id, w.ToJson());
        await this.Commit();
        this.Ok(w.ToJson());
    }

    /* 分配（unassigned→claimed）或转交（claimed/in_progress/blocked 内换人，
       必填理由）：owner/creator；CAS 同认领。 */
    [HttpPost]
    [Description("分配或转交任务")]
    [Custom(Perm = PermBit.Update)]
    public async void TaskAssign() {
        SysUser me = await this.Me();
        CollabTask t = await this.LoadTask(this.InInt("id", 0));
        string crid = this.Crid();
        if (!CollabApi.TaskOwns(t, me)) { this.Fail(403, "0403", "仅责任人可分配或转交"); }
        int userId = this.InInt("userId", 0);
        SysUser target = await this.SysUser
            .Where(a => a.id == userId
                && a.status == 1).FirstAsync();
        if (target == null) { this.Fail(404, "0404", "执行人不存在或已停用"); }
        bool isAssign = t.status == "unassigned";
        string reason = "";
        if (!isAssign) {
            reason = this.Need("reason", "转交理由");
            if (t.status != "claimed" && t.status != "in_progress"
                && t.status != "blocked") {
                this.Fail(409, "0409", "当前状态不可转交");
            }
        }
        string toStatus = isAssign ? "claimed" : t.status;
        await this.Begin();
        string stored = await this.IdemBegin(me.id, "task.assign", crid);
        if (stored != null) { await this.Rollback(); this.Replay(stored); return; }
        long now = WebApp.NowSeconds();
        int n = await this.CollabTask.Update()
            .Set(a => a.assigneeId, target.id)
            .Set(a => a.status, toStatus)
            .Set(a => a.version, t.version + 1)
            .Set(a => a.updatedAt, now)
            .Where(a => a.id == t.id
                && a.version == t.version
                && a.status == (isAssign ? "unassigned" : t.status))
            .ExecuteAffrowsAsync();
        if (n == 0) { this.Fail(409, "0409", "任务状态已变化，请刷新后重试"); }
        await this.TaskLog(t, t.id, isAssign ? "assigned" : "transferred", me.id,
            toStatus, target.id, t.ownerId, t.progress, reason, "", crid);
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("ok", "1");
        w.WriteProperty("assigneeId", target.id.ToString());
        w.EndObject();
        await this.IdemFinish(me.id, "task.assign", crid, "task", t.id, w.ToJson());
        await this.Commit();
        this.Ok(w.ToJson());
    }

    /* 开始：claimed→in_progress（执行人）。 */
    [HttpPost]
    [Description("开始任务")]
    [Custom(Perm = PermBit.Update)]
    public async void TaskStart() {
        await this.Transition("task.start", "started", "claimed", "in_progress");
    }

    /* 更新进度（0..100，追加事件不覆盖）：in_progress（执行人）。 */
    [HttpPost]
    [Description("更新进度")]
    [Custom(Perm = PermBit.Update)]
    public async void TaskProgress() {
        SysUser me = await this.Me();
        CollabTask t = await this.LoadTask(this.InInt("id", 0));
        string crid = this.Crid();
        if (t.assigneeId != me.id) { this.Fail(403, "0403", "仅执行人可更新进度"); }
        int progress = this.InInt("progress", -1);
        if (progress < 0 || progress > 100) { this.Fail(400, "0003", "进度需在 0..100"); }
        await this.Begin();
        string stored = await this.IdemBegin(me.id, "task.progress", crid);
        if (stored != null) { await this.Rollback(); this.Replay(stored); return; }
        long now = WebApp.NowSeconds();
        int n = await this.CollabTask.Update()
            .Set(a => a.progress, progress)
            .Set(a => a.version, t.version + 1)
            .Set(a => a.updatedAt, now)
            .Where(a => a.id == t.id
                && a.version == t.version && a.status == "in_progress"
                && a.assigneeId == me.id)
            .ExecuteAffrowsAsync();
        if (n == 0) { this.Fail(409, "0409", "任务状态已变化，请刷新后重试"); }
        await this.TaskLog(t, t.id, "progress", me.id, "in_progress", me.id,
            t.ownerId, progress, "", this.In("content"), crid);
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("ok", "1");
        w.WriteProperty("progress", progress.ToString());
        w.EndObject();
        await this.IdemFinish(me.id, "task.progress", crid, "task", t.id, w.ToJson());
        await this.Commit();
        this.Ok(w.ToJson());
    }

    /* 阻塞（必填原因）/解除阻塞：in_progress→blocked→in_progress
       （执行人或责任人）。 */
    [HttpPost]
    [Description("标记阻塞")]
    [Custom(Perm = PermBit.Update)]
    public async void TaskBlock() {
        SysUser me = await this.Me();
        CollabTask t = await this.LoadTask(this.InInt("id", 0));
        string crid = this.Crid();
        if (!CollabApi.TaskOwns(t, me) && t.assigneeId != me.id) {
            this.Fail(403, "0403", "仅执行人或责任人可标记阻塞");
        }
        string reason = this.Need("reason", "阻塞原因");
        if (t.status != "in_progress") { this.Fail(409, "0409", "仅进行中任务可标记阻塞"); }
        await this.Begin();
        string stored = await this.IdemBegin(me.id, "task.block", crid);
        if (stored != null) { await this.Rollback(); this.Replay(stored); return; }
        long now = WebApp.NowSeconds();
        int n = await this.CollabTask.Update()
            .Set(a => a.status, "blocked")
            .Set(a => a.blockedReason, reason)
            .Set(a => a.version, t.version + 1)
            .Set(a => a.updatedAt, now)
            .Where(a => a.id == t.id
                && a.version == t.version && a.status == "in_progress")
            .ExecuteAffrowsAsync();
        if (n == 0) { this.Fail(409, "0409", "任务状态已变化，请刷新后重试"); }
        await this.TaskLog(t, t.id, "blocked", me.id, "blocked", t.assigneeId,
            t.ownerId, t.progress, reason, "", crid);
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("ok", "1");
        w.WriteProperty("status", "blocked");
        w.EndObject();
        await this.IdemFinish(me.id, "task.block", crid, "task", t.id, w.ToJson());
        await this.Commit();
        this.Ok(w.ToJson());
    }

    [HttpPost]
    [Description("解除阻塞")]
    [Custom(Perm = PermBit.Update)]
    public async void TaskUnblock() {
        await this.Transition("task.unblock", "unblocked", "blocked", "in_progress");
    }

    /* 提交验收：in_progress→review（执行人）。 */
    [HttpPost]
    [Description("提交验收")]
    [Custom(Perm = PermBit.Update)]
    public async void TaskSubmit() {
        await this.Transition("task.submit", "submitted", "in_progress", "review");
    }

    /* 验收通过：review→done（owner/creator），落 completedAt。 */
    [HttpPost]
    [Description("验收通过")]
    [Custom(Perm = PermBit.Update)]
    public async void TaskApprove() {
        SysUser me = await this.Me();
        CollabTask t = await this.LoadTask(this.InInt("id", 0));
        string crid = this.Crid();
        if (!CollabApi.TaskOwns(t, me)) { this.Fail(403, "0403", "仅责任人可验收"); }
        if (t.status != "review") { this.Fail(409, "0409", "仅待验收任务可通过"); }
        await this.Begin();
        string stored = await this.IdemBegin(me.id, "task.approve", crid);
        if (stored != null) { await this.Rollback(); this.Replay(stored); return; }
        long now = WebApp.NowSeconds();
        int n = await this.CollabTask.Update()
            .Set(a => a.status, "done")
            .Set(a => a.progress, 100)
            .Set(a => a.completedAt, now)
            .Set(a => a.version, t.version + 1)
            .Set(a => a.updatedAt, now)
            .Where(a => a.id == t.id
                && a.version == t.version && a.status == "review")
            .ExecuteAffrowsAsync();
        if (n == 0) { this.Fail(409, "0409", "任务状态已变化，请刷新后重试"); }
        await this.TaskLog(t, t.id, "approved", me.id, "done", t.assigneeId,
            t.ownerId, 100, "", this.In("content"), crid);
        JsonWriter body = new JsonWriter();
        body.StartObject();
        body.WriteProperty("ok", "1");
        body.WriteProperty("status", "done");
        body.EndObject();
        string bodyJson = body.ToJson();
        await this.IdemFinish(me.id, "task.approve", crid, "task", t.id, bodyJson);
        await this.Commit();
        this.Ok(bodyJson);
    }

    /* 驳回返工（必填理由）：review→in_progress（owner/creator）。 */
    [HttpPost]
    [Description("驳回返工")]
    [Custom(Perm = PermBit.Update)]
    public async void TaskReject() {
        SysUser me = await this.Me();
        CollabTask t = await this.LoadTask(this.InInt("id", 0));
        string crid = this.Crid();
        if (!CollabApi.TaskOwns(t, me)) { this.Fail(403, "0403", "仅责任人可驳回"); }
        string reason = this.Need("reason", "驳回理由");
        if (t.status != "review") { this.Fail(409, "0409", "仅待验收任务可驳回"); }
        await this.Begin();
        string stored = await this.IdemBegin(me.id, "task.reject", crid);
        if (stored != null) { await this.Rollback(); this.Replay(stored); return; }
        long now = WebApp.NowSeconds();
        int n = await this.CollabTask.Update()
            .Set(a => a.status, "in_progress")
            .Set(a => a.version, t.version + 1)
            .Set(a => a.updatedAt, now)
            .Where(a => a.id == t.id
                && a.version == t.version && a.status == "review")
            .ExecuteAffrowsAsync();
        if (n == 0) { this.Fail(409, "0409", "任务状态已变化，请刷新后重试"); }
        await this.TaskLog(t, t.id, "rejected", me.id, "in_progress", t.assigneeId,
            t.ownerId, t.progress, reason, "", crid);
        JsonWriter body = new JsonWriter();
        body.StartObject();
        body.WriteProperty("ok", "1");
        body.WriteProperty("status", "in_progress");
        body.EndObject();
        string bodyJson = body.ToJson();
        await this.IdemFinish(me.id, "task.reject", crid, "task", t.id, bodyJson);
        await this.Commit();
        this.Ok(bodyJson);
    }

    /* 取消（owner/creator；done/cancelled 不可取消）：删除=取消+事件，
       不抹行。 */
    [HttpPost]
    [Description("取消任务")]
    [Custom(Perm = PermBit.Update)]
    public async void TaskCancel() {
        SysUser me = await this.Me();
        CollabTask t = await this.LoadTask(this.InInt("id", 0));
        string crid = this.Crid();
        if (!CollabApi.TaskOwns(t, me)) { this.Fail(403, "0403", "仅责任人可取消"); }
        string reason = this.Need("reason", "取消理由");
        if (t.status == "done" || t.status == "cancelled") {
            this.Fail(409, "0409", "任务已终结，不可取消");
        }
        await this.Begin();
        string stored = await this.IdemBegin(me.id, "task.cancel", crid);
        if (stored != null) { await this.Rollback(); this.Replay(stored); return; }
        long now = WebApp.NowSeconds();
        int n = await this.CollabTask.Update()
            .Set(a => a.status, "cancelled")
            .Set(a => a.version, t.version + 1)
            .Set(a => a.updatedAt, now)
            .Where(a => a.id == t.id
                && a.version == t.version && a.status == t.status)
            .ExecuteAffrowsAsync();
        if (n == 0) { this.Fail(409, "0409", "任务状态已变化，请刷新后重试"); }
        await this.TaskLog(t, t.id, "cancelled", me.id, "cancelled", t.assigneeId,
            t.ownerId, t.progress, reason, "", crid);
        JsonWriter body = new JsonWriter();
        body.StartObject();
        body.WriteProperty("ok", "1");
        body.WriteProperty("status", "cancelled");
        body.EndObject();
        string bodyJson = body.ToJson();
        await this.IdemFinish(me.id, "task.cancel", crid, "task", t.id, bodyJson);
        await this.Commit();
        this.Ok(bodyJson);
    }

    /* 任务附件：上传在 /uploadattachment（先传后绑，一字节
       文件至多一个绑定——attachmentId 唯一约束），本端点把未绑定附件
       挂到任务上（ownerType=task）。责任人或执行人可挂；下载走
       /downloadattachment 的 task 分支（任务参与者可见）。 */
    [HttpPost]
    [Description("任务挂附件")]
    [Custom(Perm = PermBit.Update)]
    public async void TaskAttach() {
        SysUser me = await this.Me();
        CollabTask t = await this.LoadTask(this.InInt("id", 0));
        if (!CollabApi.TaskOwns(t, me) && t.assigneeId != me.id) {
            this.Fail(403, "0403", "仅责任人或执行人可挂附件");
        }
        int attachmentId = this.InInt("attachmentId", 0);
        OaAttachment att = await this.OaAttachment
            .Where(a => a.id == attachmentId
               ).FirstAsync();
        if (att == null) { this.Fail(404, "0404", "附件不存在"); }
        List<CollabAttachmentLink> bound = await this.CollabAttachmentLink
            .Where(a => a.attachmentId == attachmentId).ToListAsync();
        if (bound.Count > 0) { this.Fail(409, "0409", "附件已绑定其他资源"); }
        string crid = this.Crid();
        await this.Begin();
        string stored = await this.IdemBegin(me.id, "task.attach", crid);
        if (stored != null) { await this.Rollback(); this.Replay(stored); return; }
        CollabAttachmentLink link = new CollabAttachmentLink();
        link.tenantId = Tenant.Cur();
        link.attachmentId = att.id;
        link.ownerType = "task";
        link.ownerId = t.id;
        link.addedBy = me.id;
        link.createdAt = WebApp.NowSeconds();
        await this.CollabAttachmentLink.Insert(link).ExecuteIdentityAsync();
        await this.TaskLog(t, t.id, "attached", me.id, t.status, t.assigneeId,
            t.ownerId, t.progress, "", att.fileName, crid);
        JsonWriter body = new JsonWriter();
        body.StartObject();
        body.WriteProperty("ok", "1");
        body.EndObject();
        string bodyJson = body.ToJson();
        await this.IdemFinish(me.id, "task.attach", crid, "task", t.id, bodyJson);
        await this.Commit();
        this.Ok(bodyJson);
    }

    /* 撤回：仅发送者本人；deletedAt 置时不抹行，历史按
       deleted 形态呈现；message.recalled 事件同事务；已撤回按幂等成功。 */
    [HttpPost]
    [Description("撤回消息")]
    [Custom(Perm = PermBit.Update)]
    public async void Recall() {
        SysUser me = await this.Me();
        string crid = this.Crid();
        CollabMessage r = await this.CollabMessage
            .Where(a => a.id == this.InInt("id", 0)
               ).FirstAsync();
        if (r == null) { this.Fail(404, "0404", "消息不存在"); }
        if (r.senderId != me.id) { this.Fail(403, "0403", "仅发送者可撤回"); }
        CollabMember mine = await Policy.Member(this.Held(), Tenant.Cur(),
            r.conversationId, me.id);
        if (!Policy.IsActive(mine)) { this.Fail(403, "0403", "仅会话成员可撤回"); }
        if (r.deletedAt > 0) {
            JsonWriter gone = new JsonWriter();
            gone.StartObject();
            gone.WriteProperty("ok", "1");
            gone.EndObject();
            this.Ok(gone.ToJson());
            return;
        }
        await this.Begin();
        string stored = await this.IdemBegin(me.id, "message.recall", crid);
        if (stored != null) { await this.Rollback(); this.Replay(stored); return; }
        long now = WebApp.NowSeconds();
        int n = await this.CollabMessage.Update()
            .Set(a => a.deletedAt, now)
            .Where(a => a.id == r.id && a.deletedAt == 0)
            .ExecuteAffrowsAsync();
        if (n == 0) { this.Fail(409, "0409", "消息状态已变化"); }
        JsonWriter ev = new JsonWriter();
        ev.StartObject();
        ev.WriteProperty("conversationId", r.conversationId.ToString());
        ev.WriteProperty("messageId", r.id.ToString());
        ev.EndObject();
        await this.InsertEvent("message.recalled", "message", r.id,
            r.conversationId, me.id, ev.ToJson());
        JsonWriter body = new JsonWriter();
        body.StartObject();
        body.WriteProperty("ok", "1");
        body.EndObject();
        string bodyJson = body.ToJson();
        await this.IdemFinish(me.id, "message.recall", crid, "message", r.id, bodyJson);
        await this.Commit();
        this.Ok(bodyJson);
    }

    /* ---- helpers ---- */

    /* 当前登录账号（ApiAuth 下 uid 必在；查不到即 401——token 版本失效等）。 */
    private async  SysUser Me() {
        SysUser me = await this.SysUser
            .Where(a => a.id == Filter.ToInt(this.uid, 0)).FirstAsync();
        if (me == null || me.status != 1) {
            this.Fail(401, "1001", "账号不可用，请重新登录");
        }
        return me;
    }

    /* 邀请对象校验：全部必须是本租户启用账号（先于幂等占位判定，
       失败不留键、原键可重试）；自邀与重复 id 在此静默忽略。 */
    private async  List<SysUser> ResolveInvitees(SysUser me, List<int> ids) {
        List<SysUser> users = new List<SysUser>();
        for (int i = 0; i < ids.Count; i = i + 1) {
            if (ids[i] == me.id) { continue; }
            bool dup = false;
            for (int j = 0; j < users.Count; j = j + 1) {
                if (users[j].id == ids[i]) { dup = true; break; }
            }
            if (dup) { continue; }
            SysUser u = await this.SysUser
                .Where(a => a.id == ids[i]
                    && a.status == 1).FirstAsync();
            if (u == null) { this.Fail(404, "0404", "邀请对象不存在或已停用"); }
            users.Add(u);
        }
        return users;
    }

    /* 加入/重入：无行插入；left 行条件复位（并发重入仅一方生效，CAS 口径）。
       返回本次实际新增/复活的行数。 */
    private async int Join(int conversationId, int userId, long now) {
        CollabMember exist = await Policy.Member(this.Held(), Tenant.Cur(),
            conversationId, userId);
        if (exist == null) {
            await this.InsertMember(Tenant.Cur(), conversationId, userId, "member", now);
            return 1;
        }
        if (exist.status == "active") { return 0; }
        int n = await this.CollabMember.Update()
            .Set(a => a.status, "active")
            .Set(a => a.leftAt, 0)
            .Set(a => a.joinedAt, now)
            .Where(a => a.id == exist.id && a.status == "left")
            .ExecuteAffrowsAsync();
        return n;
    }

    private async  void InsertMember(int tenantId, int conversationId, int userId,
                            string role, long now) {
        CollabMember m = new CollabMember();
        m.tenantId = tenantId;
        m.conversationId = conversationId;
        m.userId = userId;
        m.role = role;
        m.status = "active";
        m.lastReadMsgId = 0;
        m.joinedAt = now;
        m.leftAt = 0;
        await this.CollabMember.Insert(m).ExecuteIdentityAsync();
    }

    /* ---- 幂等（collab_idem） ---- */

    /* clientRequestId 必填（可重试写契约），超长截断。 */
    private string Crid() {
        string crid = this.Need("clientRequestId", "clientRequestId");
        if (crid.Length > 64) { crid = crid.Substring(0, 64); }
        return crid;
    }

    /* 必须在请求事务内调用。返回 null = 首次（占位行已插入，收尾必须
       IdemFinish）；非空 = 已有应答（空串 = 上次仍在处理，Replay 答 409）。
       并发同键：占位行唯一索引裁决，后到者随事务整体回滚，原键重试即得。 */
    private async string IdemBegin(int actorId, string operation, string crid) {
        List<CollabIdem> prev = await this.CollabIdem
            .Where(a => a.actorId == actorId
                && a.operation == operation && a.clientRequestId == crid)
            .ToListAsync();
        if (prev.Count > 0) { return prev[0].response; }
        CollabIdem k = new CollabIdem();
        k.tenantId = Tenant.Cur();
        k.actorId = actorId;
        k.operation = operation;
        k.clientRequestId = crid;
        k.resourceType = "";
        k.resourceId = 0;
        k.response = "";
        k.createdAt = WebApp.NowSeconds();
        await this.CollabIdem.Insert(k).ExecuteIdentityAsync();
        return null;
    }

    /* 事务收尾：回填应答与资源回链（提交前，与事实行同生共死）。 */
    private async void IdemFinish(int actorId, string operation, string crid,
                          string resourceType, int resourceId, string bodyJson) {
        await this.CollabIdem.Update()
            .Set(a => a.response, bodyJson)
            .Set(a => a.resourceType, resourceType)
            .Set(a => a.resourceId, resourceId)
            .Where(a => a.actorId == actorId
                && a.operation == operation && a.clientRequestId == crid)
            .ExecuteAffrowsAsync();
    }

    /* 重放收尾：原应答 + replayed=1；空串 = 占位未完成 → 409。 */
    private void Replay(string stored) {
        if (stored.Length == 0) {
            this.Fail(409, "0009", "上次请求仍在处理，请稍后重试");
            return;
        }
        JsonWriter w = new JsonWriter();
        try {
            JsonDoc.ParseScoped(stored, (JsonDoc doc) => {
                w.StartObject();
                if (doc.KindAt(0) == 5) {
                    int count = doc.Count(0);
                    for (int i = 0; i < count; i = i + 1) {
                        string k = doc.KeyAt(0, i);
                        if (k != "replayed") {
                            int slot = doc.ValAt(0, i);
                            w.WriteRawProperty(k, doc.ToJson(slot));
                        }
                    }
                }
                w.WriteProperty("replayed", "1");
                w.EndObject();
            });
        } catch (Exception) {
            w.Reset();
            w.StartObject();
            w.WriteProperty("replayed", "1");
            w.EndObject();
        }
        this.Ok(w.ToJson());
    }

    /* "1,2,3" → 去重正整数表；空/脏片段忽略。 */
    private static List<int> IdsOf(string csv) {
        List<int> ids = new List<int>();
        if (csv == null || csv.Length == 0) { return ids; }
        List<string> parts = csv.Split(",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            int v = Filter.ToInt(parts[i].Trim(), 0);
            if (v <= 0) { continue; }
            bool dup = false;
            for (int j = 0; j < ids.Count; j = j + 1) {
                if (ids[j] == v) { dup = true; break; }
            }
            if (!dup) { ids.Add(v); }
        }
        return ids;
    }

    static string NameOf(List<SysUser> users, int id) {
        for (int i = 0; i < users.Count; i = i + 1) {
            if (users[i].id == id) { return Fmt.Text(users[i].nickname, users[i].username); }
        }
        return "用户" + id.ToString();
    }

    /* 领域事件落库：必须在事实所在请求事务内调用，
       同生共死；payload 只放紧凑摘要；conversationId 供补拉与扇出做
       成员资格过滤。 */
    private async void InsertEvent(string type, string aggregateType, int aggregateId,
                           int conversationId, int actorId, string payloadJson) {
        CollabEvent e = new CollabEvent();
        e.tenantId = Tenant.Cur();
        e.type = type;
        e.aggregateType = aggregateType;
        e.aggregateId = aggregateId;
        e.conversationId = conversationId;
        e.actorId = actorId;
        e.payload = payloadJson;
        e.createdAt = WebApp.NowSeconds();
        await this.CollabEvent.Insert(e).ExecuteIdentityAsync();
    }

    /* 倒序取页 → 时间正序输出（重建列表，不依赖原地反转）。 */
    private static List<CollabMessage> Asc(List<CollabMessage> desc) {
        List<CollabMessage> asc = new List<CollabMessage>();
        for (int i = desc.Count - 1; i >= 0; i = i - 1) { asc.Add(desc[i]); }
        return asc;
    }

    /* PNG/JPEG 头嗅探宽高：只看前 64KB；解析不出返回 0/0（非图
       或变体格式），不影响上传。PNG 宽高在 16..24（大端）；JPEG 扫
       SOF0..SOF15 段标记取高宽。缩略图一期不生成——桌面客户端本地图形栈
       自行缩放（微信式），服务端无头环境不引图像编解码依赖。 */
    private static ImgDim SniffImage(string path, string mime) {
        ImgDim d = new ImgDim();
        if (mime != "image/png" && mime != "image/jpeg") { return d; }
        try {
            byte[] b = File.ReadAllBytes(path);
            if (mime == "image/png") {
                if (b.Length >= 24 && b[0] == 0x89 && b[1] == 0x50
                    && b[2] == 0x4E && b[3] == 0x47) {
                    d.width = (b[16] & 255) * 16777216 + (b[17] & 255) * 65536
                        + (b[18] & 255) * 256 + (b[19] & 255);
                    d.height = (b[20] & 255) * 16777216 + (b[21] & 255) * 65536
                        + (b[22] & 255) * 256 + (b[23] & 255);
                }
                return d;
            }
            if (b.Length >= 4 && b[0] == 0xFF && b[1] == 0xD8) {
                int i = 2;
                while (i + 9 < b.Length) {
                    if (b[i] != 0xFF) { break; }
                    int mark = b[i + 1] & 255;
                    if (mark >= 0xC0 && mark <= 0xCF && mark != 0xC4
                        && mark != 0xC8 && mark != 0xCC) {
                        d.height = (b[i + 5] & 255) * 256 + (b[i + 6] & 255);
                        d.width = (b[i + 7] & 255) * 256 + (b[i + 8] & 255);
                        break;
                    }
                    i = i + 2 + (b[i + 2] & 255) * 256 + (b[i + 3] & 255);
                }
            }
        } catch (Exception) {
            /* 读不到/解析不了按 0/0 处理，上传主流程不受影响。 */
        }
        return d;
    }

    /* 图片尺寸嗅探结果。 */
    class ImgDim {
        int width;
        int height;
    }
}
