using System;
using ZanWeb;
using System.Web;
using System.Json;

namespace ZanWeb.Api;

/* 数据端点：演示请求元数据（限流 ApiMax、按用户请求锁、流式上传）；路由 /api/data/echo、/api/data/gather，及绝对 /upload 覆盖。 */
[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("数据")]
class Data : ApiController {
    [HttpPost]
    [Custom(ApiMax = 100)]
    [Description("回显")]
    void Echo() {
        string msg = this.In("msg");
        if (msg.Length == 0) { msg = this.Body(); }
        JsonValue o = JsonValue.NewObject();
        o.Put("echo", JsonValue.NewStr(msg));
        this.Ok(o.ToJson());
    }

    [HttpPost]
    [Custom(Authorization = CustomAuthorization.Login, Lock = "user")]
    [Description("收集数据")]
    void Gather() {
        string payload = this.In("payload");
        if (payload.Length == 0) { payload = this.Body(); }
        JsonValue o = JsonValue.NewObject();
        o.Put("uid", JsonValue.NewStr(this.uid));
        o.Put("bytes", JsonValue.NewNum(Convert.ToString(payload.Length)));
        this.Ok(o.ToJson());
    }

    [HttpPost]
    [Route("/upload")]
    [Custom(Authorization = CustomAuthorization.Login, Lock = "user", Upload = true)]
    [Description("上传")]
    void Upload() {
        string path = this.ctx.uploadPath;
        if (path.Length == 0) {
            this.Fail(400, "1002", "no upload body");
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("path", JsonValue.NewStr(path));
        o.Put("bytes", JsonValue.NewNum(Convert.ToString(this.ctx.uploadSize)));
        this.Ok(o.ToJson());
    }
}
