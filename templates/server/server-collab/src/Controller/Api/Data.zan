using System;
using Zan.Web;
using System.Web;
using System.Json;

namespace Zan.Web.Api;

/* 数据端点：演示请求元数据（限流 ApiMax、按用户请求锁、流式上传）；路由 /api/data/echo、/api/data/gather，及绝对 /upload 覆盖。 */
[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("数据")]
public class Data : ApiController {
    [HttpPost]
    [Custom(ApiMax = 100)]
    [Description("回显")]
    public void Echo() {
        string msg = this.In("msg");
        if (msg.Length == 0) { msg = this.Body(); }
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("echo", msg);
        w.EndObject();
        this.Ok(w.ToJson());
    }

    [HttpPost]
    [Custom(Authorization = CustomAuthorization.Login, Lock = "user")]
    [Description("收集数据")]
    public void Gather() {
        string payload = this.In("payload");
        if (payload.Length == 0) { payload = this.Body(); }
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("uid", this.uid);
        w.WriteProperty("bytes", payload.Length);
        w.EndObject();
        this.Ok(w.ToJson());
    }

    [HttpPost]
    [Route("/upload")]
    [Custom(Authorization = CustomAuthorization.Login, Lock = "user", Upload = true)]
    [Description("上传")]
    public void Upload() {
        string path = this.ctx.UploadPath();
        if (path.Length == 0) {
            this.Fail(400, "1002", "no upload body");
        }
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("path", path);
        w.WriteProperty("bytes", this.ctx.UploadSize());
        w.EndObject();
        this.Ok(w.ToJson());
    }
}
