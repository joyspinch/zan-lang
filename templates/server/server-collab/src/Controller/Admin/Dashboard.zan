using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Flow;
using ZanWeb.Model.Oa;
using ZanWeb.Model.Sys;

namespace ZanWeb.Admin;

/* /admin 仪表盘（架构 §2.4 WP-4 / T5）：首屏三卡片——我的待办聚合
   （Feature.TodoCenter.Gather 真数据）、我的日程、公告（后两者为空态
   占位，T11/T12 接线）。运维指标收进管理员折叠区；登录记录保留。 */
[Route("admin/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.Login)]
[Description("仪表盘")]
class Dashboard : AdminController {
    /* 侧边栏条目即此属性——见 AdminController.Layout，向 MenuBuilder 询问该账号可到达的项。 */
    [HttpGet]
    [Route("/admin")]
    [Custom(IsMenu = true, Icon = "mdi:gauge")]
    [Description("仪表盘")]
    async void Index() {
        User me = await this.Admin();
        ViewData d = await this.Layout("仪表盘");
        d.Set("isSuper", me != null && me.isSuper == 1 ? "1" : "");

        JsonValue m = JsonValue.ParseLenient(WebHost.Current().MetricsJson());
        JsonValue req = m.Get("requests");
        if (req == null) { req = JsonValue.NewObject(); }

        d.Set("requests", Convert.ToString(req.Long("count", 0)));
        d.Set("errors", Convert.ToString(req.Long("errors", 0)));
        d.Set("avg", Fmt.Dur(req.Long("avg_us", 0)));
        d.Set("uptime", Fmt.Uptime(m.Long("uptime_ms", 0)));

        d.Set("users", "—");
        if (this.DbReady()) {
            DataScope sc = await this.Scope();
            List<int> scoped = sc.Depts();
            int mine = sc.UserId();
            int users = await this.User
                .WhereIf(sc.ByDept(), a => scoped.Contains(a.departmentId))
                .WhereIf(sc.Mine(), a => a.id == mine)
                .CountAsync();
            d.Set("users", Convert.ToString(users));

            /* 我的待办聚合：manual 真行 + flow/crm/wms 实时流，Gather 内
               已按截止排序并滤掉完成/忽略标记。首屏取前 8 条，全量在
               /admin/oa/todocenter。 */
            if (me != null) {
                List<TodoItem> items = await ZanWeb.TodoCenter.Gather(
                    this.Held(), this.TenantId(), me);
                long now = WebApp.NowSeconds();
                int top = items.Count > 8 ? 8 : items.Count;
                List<StrMap> trows = d.AddList("todos");
                for (int i = 0; i < top; i = i + 1) {
                    TodoItem it = items[i];
                    StrMap row = new StrMap();
                    row.Set("src", Dashboard.SrcText(it.source));
                    row.Set("title", it.title);
                    row.Set("link", it.link.Length > 0 ? it.link : "#");
                    row.Set("due", it.dueAt > 0 ? Fmt.Day(it.dueAt) : "—");
                    row.Set("overdue", it.dueAt > 0 && it.dueAt < now ? "1" : "");
                    trows.Add(row);
                }
                d.Set("hasTodos", items.Count > 0 ? "1" : "");
                d.Set("todoCount", Convert.ToString(items.Count));

                /* 我的日程（T11 接线）：今天 0 点起 7 天内开始的本人日程，
                   首屏 ≤5 条（owner+租户双闸，与日历屏同款）。 */
                long dayStart = Fmt.TodayStart(now);
                long dayEnd = dayStart + 7 * 86400;
                List<OaCalendarEvent> evs = await this.OaCalendarEvent
                    .Where(a => a.tenantId == this.TenantId()
                        && a.ownerId == me.id
                        && a.startAt >= dayStart && a.startAt < dayEnd)
                    .OrderBy(a => a.startAt).ToListAsync();
                List<StrMap> erows = d.AddList("events");
                int evTop = evs.Count > 5 ? 5 : evs.Count;
                for (int i = 0; i < evTop; i = i + 1) {
                    OaCalendarEvent ev = evs[i];
                    StrMap row = new StrMap();
                    row.Set("title", ev.title);
                    row.Set("link", "/admin/oa/calendar");
                    row.Set("due", Fmt.Stamp(ev.startAt));
                    row.Set("started", ev.startAt < now ? "1" : "");
                    erows.Add(row);
                }
                d.Set("hasEvents", evs.Count > 0 ? "1" : "");
            }

            /* 登录记录按用户名匹配（非归属）：一条登录行写于对应账号确认之前，故用本 scope 覆盖的用户名匹配——与登录日志屏同一规则。 */
            List<string> names = new List<string>();
            if (!sc.Any()) {
                List<ZanWeb.Model.Sys.User> members = await this.User
                    .WhereIf(sc.ByDept(), a => scoped.Contains(a.departmentId))
                    .WhereIf(sc.Mine(), a => a.id == mine).ToListAsync();
                for (int k = 0; k < members.Count; k = k + 1) {
                    names.Add(members[k].username);
                }
            }
            bool byName = !sc.Any() && names.Count > 0;
            bool nothing = !sc.Any() && names.Count == 0;
            List<ZanWeb.Model.Sys.LoginLog> logins = await this.LoginLog
                .WhereIf(byName, a => names.Contains(a.username))
                .WhereIf(nothing, a => a.id < 0)
                .OrderByDescending(a => a.id).Take(8).ToListAsync();
            List<StrMap> lrows = d.AddList("logins");
            for (int i = 0; i < logins.Count; i = i + 1) {
                ZanWeb.Model.Sys.LoginLog l = logins[i];
                StrMap row = new StrMap();
                row.Set("username", Fmt.Dash(l.username));
                row.Set("ip", Fmt.Dash(l.ip));
                row.Set("createdAt", Fmt.Stamp(l.createdAt));
                row.Set("okText", Dashboard.OkText(l.ok));
                row.Set("okClass", Dashboard.OkClass(l.ok));
                lrows.Add(row);
            }
            if (logins.Count == 0) { d.Set("noLogins", "1"); }
        } else {
            d.Set("dbDown", "1");
        }
        this.Page(d);
    }

    static string SrcText(string source) {
        if (source == "manual") { return "个人"; }
        if (source == "flow") { return "流程"; }
        if (source == "crm") { return "商机"; }
        if (source == "wms") { return "库存"; }
        return source;
    }

    static string OkText(int ok) {
        if (ok == 1) { return "成功"; }
        return "失败";
    }

    static string OkClass(int ok) {
        if (ok == 1) { return "ok"; }
        return "bad";
    }
}
