using System;
using System.Collections;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model.Oa;
using Zan.Web.Model;
using Zan.Web.Dao.Oa;

namespace Zan.Web.Admin.System;

/* 备份恢复（T16，架构定案 #75）：运维面——列表 / 立即备份 / 下载。
   【tenantId 豁免声明】本控制器有意不挂租户过滤：备份是全库运维动作
   （库文件本身含全部租户），租户语义不适用；manifest 附件统计同为全库口径。
   【权限面】控制器 Grant + 屏 Perm 之外，每 action 首行 isSuper 硬闸。
   【driver 分叉】仅 sqlite 开放；非 sqlite 显式 400——降级不静默。
   【下载注入面】name 先过形态白名单 [0-9]{8}-[0-9]{6}，再断言组合路径前缀。 */
[Route("admin/system/backup/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("备份恢复")]
public class Backups : AdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .TbarCustom("立即备份", "/admin/system/backup/create", "确认立即执行全库与附件备份吗？")
            .Col("name", "备份批次", "text", "180")
            .Col("createdAt", "备份时间", "text", "180")
            .Col("dbSize", "数据库体积", "text", "120")
            .Col("zipSize", "附件包体积", "text", "120")
            .Ops("下载备份", "/admin/system/backup/download", "", "name={name}", "");
    }

    [HttpGet]
    [Route("/admin/system/backup")]
    [Custom(IsMenu = true, Icon = "mdi:database-export", Perm = PermBit.View)]
    [Description("备份恢复")]
    async void Index() {
        await this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("备份恢复表格配置")]
    public async void Conf() {
        SysUser me = await this.Admin();
        if (me.isSuper != 1) {
            this.Fail(403, "0403", "仅超级管理员可访问备份恢复");
            return;
        }
        CrudOps.Conf(this, Backups.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("备份列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        SysUser me = await this.Admin();
        if (me.isSuper != 1) {
            this.Fail(403, "0403", "仅超级管理员可访问备份恢复");
            return;
        }
        if (Cfg.Db.driver != "sqlite") {
            this.Fail(400, "0004", "内置备份仅支持 sqlite（当前 driver="
                + Cfg.Db.driver + "），请使用数据库原生备份");
            return;
        }
        List<string> names = Backup.ListNames();
        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < names.Count; i = i + 1) {
            string name = names[i];
            string dir = Backup.Root + "/" + name;
            w.WriteStartObject();
            w.WriteProperty("id", i + 1);
            w.WriteProperty("name", name);
            w.WriteProperty("createdAt", Backup.NameText(name));
            w.WriteProperty("dbSize", Backup.SizeText(dir + "/app.db"));
            w.WriteProperty("zipSize", Backup.SizeText(dir + "/uploads.zip"));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, names.Count, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create)]
    [Description("立即备份")]
    async void Create() {
        SysUser me = await this.Admin();
        if (me.isSuper != 1) {
            this.Fail(403, "0403", "仅超级管理员可执行备份");
            return;
        }
        if (Cfg.Db.driver != "sqlite") {
            this.Fail(400, "0004", "内置备份仅支持 sqlite（当前 driver="
                + Cfg.Db.driver + "），请使用数据库原生备份，见 README「备份与恢复」");
            return;
        }
        Directory.CreateDirectoryRecursive(Backup.Root);
        long lockH = File.TryLock(Backup.Root + "/.lock");
        if (lockH == 0) {
            this.Fail(409, "0409", "备份执行中，请稍候");
            return;
        }
        try {
            List<OaAttachment> atts = await new OaAttachmentDao().All();
            long bytes = 0;
            for (int i = 0; i < atts.Count; i = i + 1) {
                bytes = bytes + atts[i].size;
            }
            string name = await Backup.Create(this.Held(), atts.Count, bytes);
            await this.Note("立即备份", name, true, "");
            this.Saved("备份完成：" + name);
        } finally {
            File.Unlock(lockH);
        }
    }

    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("下载备份")]
    async void Download() {
        SysUser me = await this.Admin();
        if (me.isSuper != 1) {
            this.Fail(403, "0403", "仅超级管理员可下载备份");
            return;
        }
        string name = this.InAny("name");
        if (!Backup.NameOk(name)) {
            this.Fail(400, "0004", "备份名不合法");
            return;
        }
        string dir = Backup.Root + "/" + name;
        if (!dir.StartsWith(Backup.Root + "/")) {
            this.Fail(400, "0004", "备份名不合法");
            return;
        }
        if (!Directory.ExistsOnDisk(dir)) {
            this.Fail(404, "0404", "备份不存在");
            return;
        }
        byte[] data = Backup.ZipOf(dir, name);
        this.Ctx().SetHeader("Content-Disposition",
            "attachment; filename=\"backup-" + name + ".zip\"");
        this.Ctx().Binary("application/zip", data, data.Length);
    }
}
