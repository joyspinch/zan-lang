using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;

namespace ZanWeb.Dao.Sys;

/* sys_department_role 的数据读写网关 */
class DepartmentRoleDao {
    IDbConnection db;

    DepartmentRoleDao(IDbConnection db) {
        this.db = db;
    }

    async DepartmentRole ById(int id) {
        return await this.db.Select<DepartmentRole>().Where(a => a.id == id).FirstAsync();
    }

    async List<DepartmentRole> ByDepartmentId(int deptId) {
        return await this.db.Select<DepartmentRole>()
            .Where(a => a.departmentId == deptId)
            .ToListAsync();
    }

    async List<DepartmentRole> ByRoleId(int roleId) {
        return await this.db.Select<DepartmentRole>()
            .Where(a => a.roleId == roleId)
            .ToListAsync();
    }

    async int Insert(DepartmentRole dr) {
        return await this.db.Insert<DepartmentRole>(dr).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<DepartmentRole>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int DeleteByDepartmentId(int deptId) {
        return await this.db.Delete<DepartmentRole>().Where(a => a.departmentId == deptId).ExecuteAffrowsAsync();
    }
}
