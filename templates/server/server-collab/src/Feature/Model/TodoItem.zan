public class TodoItem {
    /* 来源注册名：manual/flow/crm/wms（视图按此取徽标文案）。 */
    string source;
    string title;
    string link;
    long dueAt;
    string relatedType;
    int relatedId;
    int rowId;
}

/* 各模块待办源签名：返回"该用户当前待办流"。db/tenantId 显式传参
   （Notify.Send / Attachment.Save 同款纪律：静态链路拿不到控制器上下文）。 */
public async delegate List<TodoItem> TodoSource(IDbConnection db, int tenantId, SysUser me);

/* 待办中心聚合器（架构 §2.4 WP-4 / T5）：模块经 TodoCenter.Register 挂源，
   Gather 汇成一条按截止排序的流。新源（Calendar T11、form T15）只需写一个
   TodoSource 方法 + 在 main.zan 注册一行，聚合器与聚合页零改动。 */
