using System;
using System.Collections;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Dao.Oa;
using Zan.Web.Model.Oa;
using Zan.Web.Model;

public class CalendarSources {
    public static async List<TodoItem> Calendar(IDbConnection db, int tenantId,
                                         SysUser me) {
        List<TodoItem> items = new List<TodoItem>();
        long start = Fmt.TodayStart(WebApp.NowSeconds());
        long end = start + 7 * 86400;
        List<OaCalendarEvent> rows = await new OaCalendarEventDao(db).UpcomingEvents(tenantId, me.id, start, end);
        for (int i = 0; i < rows.Count; i = i + 1) {
            OaCalendarEvent ev = rows[i];
            TodoItem it = new TodoItem();
            it.source = "calendar";
            it.title = "日程：" + ev.title;
            it.link = "/admin/oa/calendar";
            it.dueAt = ev.startAt;
            it.relatedType = "calendar_event";
            it.relatedId = ev.id;
            it.rowId = 0;
            items.Add(it);
        }
        return items;
    }
}
