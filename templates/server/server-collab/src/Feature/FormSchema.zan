using System;
using System.Collections;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web.Dao;
using Zan.Web.Model;

namespace Zan.Web;

/* 表单字段定义 */
public class FormFieldDef {
    public string code = "";
    public string label = "";
    public string type = "";
    public bool required = false;
    public int maxlen = 0;
    public int max = 5;
    public double min = 0.0;
    public double maxNum = 0.0;
    public bool hasMin = false;
    public bool hasMax = false;
    public string minText = "";
    public string maxText = "";
    public List<string> options = new List<string>();
    public string optionsSrc = "";
}

/* 表单结构模型定义 */
public class FormSchemaDef {
    public List<FormFieldDef> fields = new List<FormFieldDef>();
}

/* 表单 schema：Parse（结构校验）/ Validate（数据校验）/ Render（转视图行）。
   字段类型 8 种白名单：text/textarea/number/date/select/radio/checkbox/attachment。
   select/radio/checkbox 选项来源二选一：内联 options 数组或 optionsSrc="dict:类型code"。 */
public class FormSchema {
    /* 校验并解析 schema 为强类型 FormSchemaDef。结构非法抛 ApiError(400)。 */
    public static FormSchemaDef Parse(string schemaJson) {
        string src = schemaJson == null ? "" : schemaJson.Trim();
        if (src.Length == 0) {
            throw new ApiError(400, "0004", "schema 必须是 JSON 对象");
        }
        FormSchemaDef schema = new FormSchemaDef();
        List<string> errs = new List<string>();
        try {
            JsonDoc.ParseScoped(src, (JsonDoc doc) => {
                if (doc.KindAt(0) != 5) {
                    errs.Add("schema 必须是 JSON 对象");
                    return;
                }
                int fieldsSlot = doc.Get(0, "fields");
                if (fieldsSlot < 0 || doc.KindAt(fieldsSlot) != 4 || doc.Count(fieldsSlot) == 0) {
                    errs.Add("fields 必须是非空数组");
                    return;
                }
                List<string> codes = new List<string>();
                int c = doc.FirstChild(fieldsSlot);
                int idx = 1;
                while (c >= 0) {
                    FormFieldDef f = FormSchema.CheckField(doc, c, idx, codes, errs);
                    if (f != null) {
                        schema.fields.Add(f);
                    }
                    idx = idx + 1;
                    c = doc.NextSibling(c);
                }
            });
        } catch (Exception ex) {
            throw new ApiError(400, "0004", "schema 解析失败：" + ex.Message);
        }
        if (errs.Count > 0) {
            throw new ApiError(400, "0004", FormSchema.Join(errs));
        }
        return schema;
    }

    public static FormFieldDef CheckField(JsonDoc doc, int slot, int no, List<string> codes,
                                          List<string> errs) {
        string at = "第 " + no.ToString() + " 项：";
        if (slot < 0 || doc.KindAt(slot) != 5) {
            errs.Add(at + "必须是对象");
            return null;
        }
        FormFieldDef f = new FormFieldDef();
        string code = doc.Str(slot, "code", "");
        if (!FormSchema.CodeOk(code)) {
            errs.Add(at + "code 需为 [a-z0-9_] 且 1~64 位");
        } else if (codes.Contains(code)) {
            errs.Add(at + "code 重复（" + code + "）");
        } else {
            codes.Add(code);
            f.code = code;
        }

        string label = doc.Str(slot, "label", "");
        if (label.Length == 0 || label.Length > 64) {
            errs.Add(at + "label 需 1~64 字");
        }
        f.label = label.Length > 0 ? label : code;

        string type = doc.Str(slot, "type", "");
        if (FormSchema.TypeOk(type).Length == 0) {
            errs.Add(at + "type 不在 8 种白名单内（" + type + "）");
        }
        f.type = type;

        f.required = doc.Bool(slot, "required", false);

        int optsSlot = doc.Get(slot, "options");
        if (optsSlot >= 0 && doc.KindAt(optsSlot) == 4) {
            int ch = doc.FirstChild(optsSlot);
            while (ch >= 0) {
                string o = doc.StrAt(ch, "");
                f.options.Add(o);
                ch = doc.NextSibling(ch);
            }
        }
        f.optionsSrc = doc.Str(slot, "optionsSrc", "");

        if (type == "select" || type == "radio" || type == "checkbox") {
            if (!FormSchema.HasOptionsDef(f)) {
                errs.Add(at + "select/radio/checkbox 须带 options 或 optionsSrc");
            }
        }

        if (type == "number") {
            int mnSlot = doc.Get(slot, "min");
            int mxSlot = doc.Get(slot, "max");
            if (mnSlot >= 0 && doc.KindAt(mnSlot) != 0 && doc.KindAt(mnSlot) != 2) {
                errs.Add(at + "min 须为数字");
            } else if (mnSlot >= 0 && doc.KindAt(mnSlot) == 2) {
                f.hasMin = true;
                f.min = doc.DoubleAt(mnSlot, 0.0);
                f.minText = doc.StrAt(mnSlot, "");
            }

            if (mxSlot >= 0 && doc.KindAt(mxSlot) != 0 && doc.KindAt(mxSlot) != 2) {
                errs.Add(at + "max 须为数字");
            } else if (mxSlot >= 0 && doc.KindAt(mxSlot) == 2) {
                f.hasMax = true;
                f.maxNum = doc.DoubleAt(mxSlot, 0.0);
                f.maxText = doc.StrAt(mxSlot, "");
            }

            if (f.hasMin && f.hasMax && f.min > f.maxNum) {
                errs.Add(at + "min 不得大于 max");
            }
        }

        int maxlen = (int)doc.Long(slot, "maxlen", 0L);
        if (maxlen < 0 || maxlen > 60000) {
            errs.Add(at + "maxlen 需 0~60000");
        }
        f.maxlen = maxlen;

        int max = (int)doc.Long(slot, "max", 0L);
        if (max < 0 || max > 99) {
            errs.Add(at + "max 需 0~99");
        }
        f.max = max > 0 ? max : 5;

        return f;
    }

    public static string TypeOk(string t) {
        if (t == "text") { return "1"; }
        if (t == "textarea") { return "1"; }
        if (t == "number") { return "1"; }
        if (t == "date") { return "1"; }
        if (t == "select") { return "1"; }
        if (t == "radio") { return "1"; }
        if (t == "checkbox") { return "1"; }
        if (t == "attachment") { return "1"; }
        return "";
    }

    public static bool CodeOk(string s) {
        if (s.Length == 0 || s.Length > 64) { return false; }
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            bool ok = (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
            if (!ok) { return false; }
        }
        return true;
    }

    public static bool HasOptionsDef(FormFieldDef f) {
        if (f.options != null && f.options.Count > 0) {
            for (int i = 0; i < f.options.Count; i = i + 1) {
                string o = f.options[i];
                if (o.Length == 0 || o.Length > 64 || o.IndexOf(",") >= 0) {
                    return false;
                }
            }
            return true;
        }
        return FormSchema.DictCodeDef(f).Length > 0;
    }

    public static string DictCodeDef(FormFieldDef f) {
        string src = f.optionsSrc;
        if (src.StartsWith("dict:")) {
            string code = src.Substring(5);
            if (code.Length > 0 && code.Length <= 64) { return code; }
        }
        return "";
    }

    public static string Join(List<string> errs) {
        string s = "";
        for (int i = 0; i < errs.Count; i = i + 1) {
            if (i > 0) { s = s + "；"; }
            s = s + errs[i];
        }
        return s;
    }

    /* ---- 数据校验 ---- */

    public static List<string> Validate(FormSchemaDef schema, Dictionary<string, List<string>> data,
                                        List<SysDictItem> dicts, bool draft) {
        List<string> errs = new List<string>();
        if (schema == null || schema.fields == null) { errs.Add("schema 缺失"); return errs; }
        Dictionary<string, List<string>> dt = data;
        if (dt == null) { dt = new Dictionary<string, List<string>>(); }
        for (int i = 0; i < schema.fields.Count; i = i + 1) {
            FormFieldDef f = schema.fields[i];
            string code = f.code;
            string label = f.label.Length > 0 ? f.label : code;
            string type = f.type;
            List<string> vals = dt.ContainsKey(code) ? dt[code] : new List<string>();
            bool has = vals.Count > 0;
            if (!draft && f.required && !has) {
                errs.Add(label + " 必填");
                continue;
            }
            if (!has) { continue; }
            if (type == "number") {
                string s = vals[0];
                if (!FormSchema.NumOk(s)) {
                    errs.Add(label + " 须为数字");
                } else {
                    double d = Filter.ToDouble(s, 0.0);
                    if (f.hasMin && d < f.min) {
                        errs.Add(label + " 不得小于下限");
                    }
                    if (f.hasMax && d > f.maxNum) {
                        errs.Add(label + " 不得大于上限");
                    }
                }
            } else if (type == "text" || type == "textarea") {
                int maxlen = f.maxlen;
                if (maxlen > 0 && vals[0].Length > maxlen) {
                    errs.Add(label + " 超 " + maxlen.ToString() + " 字上限");
                }
            } else if (type == "date") {
                if (!FormSchema.DateOk(vals[0])) { errs.Add(label + " 格式须为 YYYY-MM-DD"); }
            } else if (type == "select" || type == "radio" || type == "checkbox") {
                List<string> allowed = FormSchema.AllowedDef(f, dicts);
                for (int k = 0; k < vals.Count; k = k + 1) {
                    if (!allowed.Contains(vals[k])) {
                        errs.Add(label + " 不在选项内");
                        break;
                    }
                }
            } else if (type == "attachment") {
                int max = f.max > 0 ? f.max : 5;
                if (vals.Count > max) {
                    errs.Add(label + " 附件超 " + max.ToString() + " 个上限");
                }
            }
        }
        return errs;
    }

    public static List<string> Validate(FormSchemaDef schema, string dataJson,
                                        List<SysDictItem> dicts, bool draft) {
        Dictionary<string, List<string>> data = FormSchema.ParseData(dataJson);
        return FormSchema.Validate(schema, data, dicts, draft);
    }

    public static Dictionary<string, List<string>> ParseData(string dataJson) {
        Dictionary<string, List<string>> map = new Dictionary<string, List<string>>();
        if (dataJson == null) { return map; }
        string src = dataJson.Trim();
        if (src.Length == 0) { return map; }
        try {
            JsonDoc.ParseScoped(src, (JsonDoc doc) => {
                if (doc.KindAt(0) != 5) { return; }
                int p = (int)(doc.slots[0].a >> 8);
                while (p >= 0) {
                    JsonPair pair = doc.pairs[p];
                    string key = "";
                    int ks = pair.keyStart;
                    if (ks < 0) {
                        key = doc.escPool[pair.keyLen];
                    } else {
                        key = doc.src.Substring(ks, pair.keyLen);
                    }
                    int valSlot = pair.valueSlot;
                    List<string> vals = FormSchema.ValuesOf(doc, valSlot);
                    map[key] = vals;
                    p = pair.nextPair;
                }
            });
        } catch (Exception) {}
        return map;
    }

    public static List<string> ValuesOf(JsonDoc doc, int valSlot) {
        List<string> vals = new List<string>();
        if (valSlot < 0 || valSlot >= doc.slotCount) { return vals; }
        int k = doc.KindAt(valSlot);
        if (k == 0) { return vals; }
        if (k == 4) {
            int c = doc.FirstChild(valSlot);
            int count = doc.Count(valSlot);
            for (int i = 0; i < count; i = i + 1) {
                if (c < 0) { break; }
                int ck = doc.KindAt(c);
                if (ck != 0) {
                    string s = doc.StrAt(c, "");
                    if (s.Length > 0) { vals.Add(s); }
                }
                c = doc.NextSibling(c);
            }
            return vals;
        }
        string s1 = doc.StrAt(valSlot, "");
        if (s1.Length > 0) { vals.Add(s1); }
        return vals;
    }

    public static List<string> AllowedDef(FormFieldDef f, List<SysDictItem> dicts) {
        List<string> allowed = new List<string>();
        if (f.options != null && f.options.Count > 0) {
            for (int i = 0; i < f.options.Count; i = i + 1) {
                string o = f.options[i];
                if (o.Length > 0) { allowed.Add(o); }
            }
            return allowed;
        }
        string code = FormSchema.DictCodeDef(f);
        if (code.Length > 0 && dicts != null) {
            for (int i = 0; i < dicts.Count; i = i + 1) {
                if (dicts[i].typeCode == code && dicts[i].status == 1) {
                    allowed.Add(dicts[i].value);
                }
            }
        }
        return allowed;
    }

    public static bool NumOk(string s) {
        if (s.Length == 0) { return false; }
        int dot = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c == 45 || c == 43) {
                if (i > 0) { return false; }
            } else if (c == 46) {
                dot = dot + 1;
                if (dot > 1) { return false; }
            } else if (c < 48 || c > 57) {
                return false;
            }
        }
        return true;
    }

    public static bool DateOk(string s) {
        if (s.Length != 10) { return false; }
        for (int i = 0; i < 10; i = i + 1) {
            int c = s[i] & 255;
            if (i == 4 || i == 7) {
                if (c != 45) { return false; }
            } else if (c < 48 || c > 57) {
                return false;
            }
        }
        int mm = Convert.ToInt32(s.Substring(5, 2));
        int dd = Convert.ToInt32(s.Substring(8, 2));
        return mm >= 1 && mm <= 12 && dd >= 1 && dd <= 31;
    }

    /* ---- 渲染 ---- */

    public static async List<SysDictItem> DictsFor(IDbConnection db, FormSchemaDef schema) {
        List<string> codes = new List<string>();
        if (schema != null && schema.fields != null) {
            for (int i = 0; i < schema.fields.Count; i = i + 1) {
                FormFieldDef f = schema.fields[i];
                string code = FormSchema.DictCodeDef(f);
                if (code.Length > 0 && !codes.Contains(code)) {
                    codes.Add(code);
                }
            }
        }
        List<SysDictItem> rows = new List<SysDictItem>();
        if (codes.Count == 0) { return rows; }
        SysDictItemDao dictDao = new SysDictItemDao();
        for (int i = 0; i < codes.Count; i = i + 1) {
            List<SysDictItem> part = await dictDao.ByTypeCodeActive(codes[i]);
            for (int j = 0; j < part.Count; j = j + 1) { rows.Add(part[j]); }
        }
        return rows;
    }

    public static async List<SysDictItem> DictsFor(IDbConnection db, string schemaJson) {
        FormSchemaDef schema = FormSchema.Parse(schemaJson);
        return await FormSchema.DictsFor(db, schema);
    }

    public static void Render(ViewData d, FormSchemaDef schema, Dictionary<string, List<string>> data,
                              int relatedId, List<SysDictItem> dicts) {
        Dictionary<string, List<string>> dt = data;
        if (dt == null) { dt = new Dictionary<string, List<string>>(); }
        List<StrMap> items = d.AddList("fields");
        if (schema == null || schema.fields == null) { return; }
        for (int i = 0; i < schema.fields.Count; i = i + 1) {
            FormFieldDef f = schema.fields[i];
            string code = f.code;
            string type = f.type;
            string name = "f_" + code;
            string req = f.required ? " required" : "";
            string val = "";
            List<string> vals = dt.ContainsKey(code) ? dt[code] : new List<string>();
            if (vals.Count > 0) { val = vals[0]; }
            string html = "";
            if (type == "text") {
                html = "<input class=\"input\" name=\"" + name + "\" value=\""
                    + View.HtmlEscape(val) + "\"" + req
                    + FormSchema.MaxlenAttrDef(f) + ">";
            } else if (type == "textarea") {
                html = "<textarea class=\"input\" name=\"" + name
                    + "\" rows=\"4\"" + req + FormSchema.MaxlenAttrDef(f) + ">"
                    + View.HtmlEscape(val) + "</textarea>";
            } else if (type == "number") {
                html = "<input class=\"input\" name=\"" + name
                    + "\" type=\"number\" value=\"" + View.HtmlEscape(val) + "\""
                    + req + FormSchema.RangeAttrDef(f) + ">";
            } else if (type == "date") {
                html = "<input class=\"input\" name=\"" + name
                    + "\" type=\"date\" value=\"" + View.HtmlEscape(val) + "\"" + req + ">";
            } else if (type == "select") {
                html = "<select class=\"input\" name=\"" + name + "\"" + req + ">"
                    + "<option value=\"\">请选择</option>"
                    + FormSchema.OptsDef(f, dicts, vals, "option") + "</select>";
            } else if (type == "radio") {
                html = FormSchema.OptsDef(f, dicts, vals, "radio") + req;
            } else if (type == "checkbox") {
                html = FormSchema.OptsDef(f, dicts, vals, "checkbox");
            } else if (type == "attachment") {
                int max = f.max > 0 ? f.max : 5;
                string tip = "最多 " + max.ToString() + " 个";
                if (relatedId > 0) {
                    html = "<div data-attach data-module=\"form\" data-related=\""
                        + relatedId.ToString() + "\"></div>"
                        + "<div class=\"muted\" style=\"font-size:12px\">" + tip + "</div>";
                } else {
                    html = "<div class=\"muted\" style=\"font-size:12px\">提交后在详情页上传附件（"
                        + tip + "）</div>";
                }
            } else {
                html = "<div class=\"muted\">未知类型字段</div>";
            }
            StrMap m = new StrMap();
            m.Set("code", code);
            m.Set("label", f.label.Length > 0 ? f.label : code);
            m.Set("type", type);
            m.Set("required", req.Length > 0 ? "1" : "");
            m.Set("ctrl", html);
            items.Add(m);
        }
    }

    public static void Render(ViewData d, FormSchemaDef schema, string dataJson,
                              int relatedId, List<SysDictItem> dicts) {
        Dictionary<string, List<string>> data = FormSchema.ParseData(dataJson);
        FormSchema.Render(d, schema, data, relatedId, dicts);
    }

    public static string MaxlenAttrDef(FormFieldDef f) {
        int maxlen = f.maxlen;
        return maxlen > 0 ? " maxlength=\"" + maxlen.ToString() + "\"" : "";
    }

    public static string RangeAttrDef(FormFieldDef f) {
        string s = "";
        if (f.hasMin) {
            s = s + " min=\"" + f.minText + "\"";
        }
        if (f.hasMax) {
            s = s + " max=\"" + f.maxText + "\"";
        }
        return s;
    }

    public static string OptsDef(FormFieldDef f, List<SysDictItem> dicts, List<string> vals,
                                 string kind) {
        string name = "f_" + f.code;
        if (kind == "checkbox") { name = name + "[]"; }
        string html = "";
        if (f.options != null && f.options.Count > 0) {
            for (int i = 0; i < f.options.Count; i = i + 1) {
                string o = f.options[i];
                if (o.Length == 0) { continue; }
                html = html + FormSchema.OptOne(kind, name, o, o, vals);
            }
            return html;
        }
        string code = FormSchema.DictCodeDef(f);
        if (code.Length > 0 && dicts != null) {
            for (int i = 0; i < dicts.Count; i = i + 1) {
                if (dicts[i].typeCode == code && dicts[i].status == 1) {
                    html = html + FormSchema.OptOne(kind, name, dicts[i].value,
                        dicts[i].label, vals);
                }
            }
        }
        return html;
    }

    public static string OptOne(string kind, string name, string value, string label,
                                List<string> vals) {
        bool hit = vals != null && vals.Contains(value);
        string v = View.HtmlEscape(value);
        string l = View.HtmlEscape(label);
        if (kind == "option") {
            return "<option value=\"" + v + "\"" + (hit ? " selected" : "") + ">"
                + l + "</option>";
        }
        string type = kind == "radio" ? "radio" : "checkbox";
        return "<label style=\"display:inline-flex;align-items:center;gap:4px;"
            + "font-weight:400;margin-right:12px\"><input type=\"" + type
            + "\" name=\"" + name + "\" value=\"" + v + "\""
            + (hit ? " checked" : "") + "> " + l + "</label>";
    }
}
