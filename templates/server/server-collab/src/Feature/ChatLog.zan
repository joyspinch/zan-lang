using System;
using System.IO;
using System.Json;

namespace ZanWeb;

/* 私信本地历史（运行路径 data/chat/）：send/read/ack 三类事件逐行 JSONL
   追加。落库的 oa_message / oa_message_event 才是事实源，本文件是旁路
   存证（运维可 grep 的消息流水），写失败只记日志、绝不打断消息主链路。
   文件按租户 + 会话双方切分：data/chat/t{tenantId}/{a}-{b}.jsonl，
   a<b 为用户 id 且方向无关（会话是双向流，双方事件共一份流水）。 */
class ChatLog {
    static void AppendEvent(int tenantId, int u1, int u2, JsonValue evt) {
        int a = u1 < u2 ? u1 : u2;
        int b = u1 < u2 ? u2 : u1;
        string dir = "data/chat/t" + Convert.ToString(tenantId);
        try {
            if (!Directory.Exists(dir)) { Directory.CreateDirectoryRecursive(dir); }
            File.AppendAllText(dir + "/" + Convert.ToString(a) + "-"
                + Convert.ToString(b) + ".jsonl", evt.ToJson() + "\n");
        } catch (Exception ex) {
            /* 历史是旁路：磁盘失败不影响消息与回执的落库主链路。 */
            Console.WriteLine("[chatlog] append failed: " + ex.Message);
        }
    }
}
