using System;
using System.Collections;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Dao.Crm;
using Zan.Web.Dao.Flow;
using Zan.Web.Dao.Oa;
using Zan.Web.Dao.Wms;
using Zan.Web.Model.Crm;
using Zan.Web.Model.Flow;
using Zan.Web.Model.Oa;
using Zan.Web.Model;
using Zan.Web.Model.Wms;
using Zan.Web.Modules.Flow;

namespace Zan.Web;

/* 待办中心聚合器（架构 §2.4 WP-4 / T5）：模块经 TodoCenter.Register 挂源，
   Gather 汇成一条按截止排序的流。新源（Calendar T11、form T15）只需写一个
   TodoSource 方法 + 在 main.zan 注册一行，聚合器与聚合页零改动。 */
public class TodoCenter {
    /* 注册序（视图分组顺序用）：Dict 不保证遍历序，模块名并行存 List。 */
    public static List<string> order = new List<string>();
    public static Dict<string, TodoSource> sources = null;

    public static void Init() {
        if (TodoCenter.sources == null) {
            TodoCenter.sources = new Dict<string, TodoSource>();
        }
    }

    /* 模块注册：main.zan 启动时逐行挂源。 */
    public static void Register(string module, TodoSource src) {
        TodoCenter.Init();
        if (TodoCenter.sources.ContainsKey(module)) {
            TodoCenter.sources.Remove(module);
            TodoCenter.order.Remove(module);
        }
        TodoCenter.sources.Add(module, src);
        TodoCenter.order.Add(module);
    }

    /* 来源是否已注册（控制器动作入参校验用）。manual 恒真。 */
    public static bool HasSource(string module) {
        if (module == "manual") { return true; }
        TodoCenter.Init();
        return TodoCenter.sources.ContainsKey(module);
    }

    /* 标记键：源 + 回链类型 + 回链 id。 */
    public static string MarkKey(string source, string relatedType, int relatedId) {
        return source + "|" + relatedType + "|" + Convert.ToString(relatedId);
    }

    /* 聚合：manual 真行 + 各虚拟源实时流，滤掉已标记完成/忽略的项目，
       按截止时间升序（无截止排最后）。 */
    public static async List<TodoItem> Gather(IDbConnection db, int tenantId, SysUser me) {
        if (me == null) { return new List<TodoItem>(); }
        List<TodoItem> items = new List<TodoItem>();

        /* manual：本人真待办行直接入流。 */
        List<OaTodo> manual = await db.OaTodo.ActiveManual(tenantId, me.id);
        for (int i = 0; i < manual.Count; i = i + 1) {
            OaTodo t = manual[i];
            TodoItem it = new TodoItem();
            it.source = "manual";
            it.title = t.title;
            it.link = t.link;
            it.dueAt = t.dueAt;
            it.relatedType = "manual";
            it.relatedId = t.id;
            it.rowId = t.id;
            items.Add(it);
        }

        /* 虚拟源标记行：status=1/2 的 (source,relatedType,relatedId) 集合。 */
        List<OaTodo> marks = await db.OaTodo.DoneMarks(tenantId, me.id);
        Dict<string, int> done = new Dict<string, int>();
        for (int i = 0; i < marks.Count; i = i + 1) {
            OaTodo t = marks[i];
            done.Add(TodoCenter.MarkKey(t.source, t.relatedType, t.relatedId),
                t.status);
        }

        /* 逐源挂载：源内部自行按"我的"范围过滤（assignUserId/ownerId/全局）。 */
        TodoCenter.Init();
        for (int m = 0; m < TodoCenter.order.Count; m = m + 1) {
            string module = TodoCenter.order[m];
            TodoSource src = null;
            if (!TodoCenter.sources.TryGetValue(module, out src)) { continue; }
            List<TodoItem> part = await src(db, tenantId, me);
            for (int i = 0; i < part.Count; i = i + 1) {
                TodoItem it = part[i];
                int st = 0;
                if (done.TryGetValue(TodoCenter.MarkKey(it.source,
                    it.relatedType, it.relatedId), out st)) { continue; }
                items.Add(it);
            }
        }

        /* 截止升序、无截止垫底（条目量小，插入排序足够）。 */
        for (int i = 1; i < items.Count; i = i + 1) {
            TodoItem it = items[i];
            int j = i - 1;
            while (j >= 0 && TodoCenter.Earlier(it, items[j])) {
                items[j + 1] = items[j];
                j = j - 1;
            }
            items[j + 1] = it;
        }
        return items;
    }

    /* a 是否应排在 b 前：有截止者优先，其次截止更早者。 */
    public static bool Earlier(TodoItem a, TodoItem b) {
        if (a.dueAt == 0) { return false; }
        if (b.dueAt == 0) { return true; }
        return a.dueAt < b.dueAt;
    }

    /* 完成/忽略标记：manual 源直接改真行状态；虚拟源 upsert 一行标记
       （同键已存在则改状态，否则插入）。返回是否命中。 */
    public static async bool Mark(IDbConnection db, int tenantId, int userId,
                           string source, string relatedType, int relatedId,
                           int status, string title) {
        long now = WebApp.NowSeconds();
        if (source == "manual") {
            OaTodo row = await db.OaTodo.FindManual(tenantId, userId, relatedId);
            if (row == null) { return false; }
            await db.OaTodo.UpdateStatus(row.id, status, now);
            return true;
        }
        OaTodo mark = await db.OaTodo.FindMark(tenantId, userId, source, relatedType, relatedId);
        if (mark != null) {
            await db.OaTodo.UpdateStatus(mark.id, status, now);
            return true;
        }
        OaTodo t = new OaTodo();
        t.tenantId = tenantId;
        t.userId = userId;
        t.source = source;
        t.title = Fmt.Text(title, "待办");
        t.link = "";
        t.dueAt = 0;
        t.status = status;
        t.relatedType = Fmt.Text(relatedType, "0");
        t.relatedId = relatedId;
        t.createdAt = now;
        t.doneAt = now;
        await db.OaTodo.Insert(t).ExecuteIdentityAsync();
        return true;
    }
}
