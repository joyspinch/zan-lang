            w.status = 1;
            w.createdAt = WebApp.NowSeconds();
            w.updatedAt = w.createdAt;
            await db.Insert<WmsWarehouse>(w).ExecuteIdentityAsync();
        }
        int sk = await db.Select<WmsSku>().CountAsync();
        if (sk == 0) {
            WmsSku s = new WmsSku();
            s.sku = "SKU001";
            s.name = "示例商品";
            s.unit = "件";
            s.spec = "";
            s.createdAt = WebApp.NowSeconds();
            s.updatedAt = s.createdAt;
            await db.Insert<WmsSku>(s).ExecuteIdentityAsync();
        }
        return true;
    }

