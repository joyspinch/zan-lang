using System;
using System.Collections;
using System.Data;
using System.Data.Orm;
using ZanWeb.Dao.Crm;
using ZanWeb.Dao.Flow;
using ZanWeb.Dao.Oa;
using ZanWeb.Dao.Wms;
using ZanWeb.Model.Crm;
using ZanWeb.Model.Flow;
using ZanWeb.Model.Oa;
using ZanWeb.Model;
using ZanWeb.Model.Wms;

namespace ZanWeb;

/* 全局搜索聚合器（架构 T8）：模块经 Search.Register 挂源，Run 按注册序
   逐源执行、按来源分组拼接（order List 平行表保序——Dict 不保证遍历序，
   TodoCenter 成熟形态）。新增源 = 一个 SearchSource 方法 + main.zan 一行
   注册，本类零改动。
   kw 由 Run 统一清洗（Trim、去 %/_ LIKE 通配符、限 50 字符）；源内查询
   仍必须 (tenantId, kw) 双条件起 Where（#34 基列），租户硬边先于一切。
   SQL 只允许存在于 SearchSources 一个文件——MySQL FULLTEXT 升级只改该处。 */
public class Search {
    /* 注册序 = 下拉分组展示序。 */
    public static List<string> order = new List<string>();
    public static Dict<string, SearchSource> sources = null;

    public static void Init() {
        if (Search.sources == null) {
            Search.sources = new Dict<string, SearchSource>();
        }
    }

    /* 模块注册：main.zan 启动时逐行挂源；同键重注册=替换并保持原位。 */
    public static void Register(string module, SearchSource src) {
        Search.Init();
        if (Search.sources.ContainsKey(module)) {
            Search.sources.Remove(module);
            Search.order.Remove(module);
        }
        Search.sources.Add(module, src);
        Search.order.Add(module);
    }

    /* 聚合：空 kw / 空账号短路；逐源执行后 module 统一盖分组章（与注册
       键强一致，源实现不必自填），单源条数以 perModule 兜底截断。 */
    public static async List<SearchHit> Run(IDbConnection db, int tenantId, SysUser me,
                                     string kw, int perModule) {
        List<SearchHit> hits = new List<SearchHit>();
        if (me == null) { return hits; }
        kw = Search.Clean(kw);
        if (kw.Length == 0 || perModule <= 0) { return hits; }
        Search.Init();
        for (int m = 0; m < Search.order.Count; m = m + 1) {
            string module = Search.order[m];
            SearchSource src = null;
            if (!Search.sources.TryGetValue(module, out src)) { continue; }
            List<SearchHit> part = await src(db, tenantId, me, kw, perModule);
            int n = part.Count < perModule ? part.Count : perModule;
            for (int i = 0; i < n; i = i + 1) {
                SearchHit it = part[i];
                it.module = module;
                hits.Add(it);
            }
        }
        return hits;
    }

    /* LIKE 注入防御：去两端空白、剥 %/_ 通配符、限 50 字符——Contains
       语义为 %kw%，kw 内不含通配符即不可能越权匹配。 */
    public static string Clean(string kw) {
        string s = kw == null ? "" : kw.Trim();
        s = s.Replace("%", "").Replace("_", "");
        if (s.Length > 50) { s = s.Substring(0, 50); }
        return s;
    }
}
