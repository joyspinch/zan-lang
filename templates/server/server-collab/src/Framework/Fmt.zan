using System;

namespace ZanWeb;

/* 值按界面呈现格式转换：时间戳转日期、字节转 MB、空单元格转破折号等静态函数。不依赖请求上下文。*/
class Fmt {
    static int offsetMinutes;

    static void SetOffsetMinutes(int minutes) {
        Fmt.offsetMinutes = minutes;
    }

    static int OffsetMinutes() {
        return Fmt.offsetMinutes;
    }

    static long LocalDayStart(int year, int month, int day) {
        long offset = (long)Fmt.OffsetMinutes() * 60;
        return DateTime.FromDate(year, month, day).ToUnixSeconds() - offset;
    }

    static long TodayStart(long seconds) {
        long offset = (long)Fmt.OffsetMinutes() * 60;
        long local = seconds + offset;
        long days = local / 86400;
        if (local < 0 && local % 86400 != 0) { days = days - 1; }
        return days * 86400 - offset;
    }

    static string Dash(string v) {
        if (v == null || v.Length == 0 || v == "0") { return "—"; }
        return v;
    }

    /* 手机号脱敏：如 13812345678 -> 138****5678 */
    static string MaskMobile(string mobile) {
        if (mobile == null || mobile.Length < 7) { return mobile; }
        if (mobile.Length == 11) {
            return mobile.Substring(0, 3) + "****" + mobile.Substring(7, 4);
        }
        return mobile.Substring(0, 2) + "****" + mobile.Substring(mobile.Length - 2, 2);
    }

    /* 邮箱脱敏：如 test@example.com -> t***t@example.com */
    static string MaskEmail(string email) {
        if (email == null || email.Length == 0) { return email; }
        int at = email.IndexOf("@");
        if (at <= 1) { return email; }
        string name = email.Substring(0, at);
        string domain = email.Substring(at, email.Length - at);
        if (name.Length <= 2) {
            return name.Substring(0, 1) + "***" + domain;
        }
        return name.Substring(0, 1) + "***" + name.Substring(name.Length - 1, 1) + domain;
    }

    static string Text(string v, string fallback) {
        if (v == null || v.Length == 0) { return fallback; }
        return v;
    }

    /* 第一个完整 UTF-8 字符（用于头像首字）；字符串按字节索引，需按首字节判断字符宽度。*/
    static string FirstChar(string s) {
        if (s == null || s.Length == 0) { return ""; }
        int lead = s[0] & 255;
        int n = 1;
        if (lead >= 240) { n = 4; }
        else if (lead >= 224) { n = 3; }
        else if (lead >= 192) { n = 2; }
        if (n > s.Length) { n = s.Length; }
        return s.Substring(0, n);
    }

    /* 就地取摘要：先按字节数截到 max，再把落点回退到 UTF-8 字符边界。
       字符串按字节索引，按字节切会把一个汉字切掉一半——那半个序列不是
       合法 UTF-8，JSON 应答整个变得不可解析（客户端解不出来 = 列表摘要
       变成乱码/整条消息丢失；实测 59 个 ASCII 加中文正好踩中）。
       `\r\n`/`\n`/`\r` 先折成空格：摘要是一行，正文里的换行不能把行撑开。 */
    static string Excerpt(string s, int max) {
        if (s == null) { return ""; }
        string t = s.Replace("\r\n", " ").Replace("\n", " ").Replace("\r", " ");
        if (t.Length <= max) { return t; }
        int cut = max;
        // 回退到不是 UTF-8 续字节（10xxxxxx）的位置：即一个完整字符的头。
        while (cut > 0 && (t[cut - 1] & 255) >= 128 && (t[cut - 1] & 255) < 192) {
            cut = cut - 1;
        }
        if (cut > 0 && (t[cut - 1] & 255) >= 192) { cut = cut - 1; }
        return t.Substring(0, cut) + "…";
    }

    static string Flag(bool on) {
        if (on) { return "1"; }
        return "";
    }

    static string Stamp(long seconds) {
        if (seconds <= 0) { return "-"; }
        long shifted = seconds + (long)Fmt.OffsetMinutes() * 60;
        return DateTime.FromUnixSeconds(shifted).ToString();
    }

    static string Day(long seconds) {
        if (seconds <= 0) { return "-"; }
        long shifted = seconds + (long)Fmt.OffsetMinutes() * 60;
        string s = DateTime.FromUnixSeconds(shifted).ToString();
        int sp = s.IndexOf(" ");
        if (sp > 0) { return s.Substring(0, sp); }
        return s;
    }

    static string Uptime(long ms) {
        long total = ms / 1000;
        long days = total / 86400;
        string clock = Fmt.Pad2((total % 86400) / 3600) + ":"
            + Fmt.Pad2((total % 3600) / 60) + ":"
            + Fmt.Pad2(total % 60);
        if (days > 0) { return Convert.ToString(days) + "d " + clock; }
        return clock;
    }

    /* 负值表示平台未上报，不显示 plausible 0。*/
    static string Bytes(long v) {
        if (v < 0) { return "n/a"; }
        if (v < 1024) { return Convert.ToString(v) + " B"; }
        if (v < 1048576) { return Convert.ToString(v / 1024) + " KB"; }
        return Convert.ToString(v / 1048576) + "."
            + Convert.ToString((v * 10 / 1048576) % 10) + " MB";
    }

    /* 服务记录的微秒转可读时长；负值表示未测得。*/
    static string Dur(long us) {
        if (us < 0) { return "n/a"; }
        if (us < 1000) { return Convert.ToString(us) + " µs"; }
        if (us < 1000000) { return Fmt.Frac(us, 1000, 2) + " ms"; }
        return Fmt.Frac(us, 1000000, 2) + " s";
    }

    static string Frac(long v, long unit, int digits) {
        long scale = 1;
        for (int i = 0; i < digits; i = i + 1) { scale = scale * 10; }
        long scaled = (v * scale + unit / 2) / unit;
        string frac = Convert.ToString(scaled % scale);
        while (frac.Length < digits) { frac = "0" + frac; }
        return Convert.ToString(scaled / scale) + "." + frac;
    }

    static string Percent(long v) {
        if (v < 0) { return "n/a"; }
        return Convert.ToString(v) + "%";
    }

    static string Pad2(long v) {
        if (v < 10) { return "0" + Convert.ToString(v); }
        return Convert.ToString(v);
    }
}
