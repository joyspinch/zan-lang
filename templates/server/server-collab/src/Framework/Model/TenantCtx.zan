using System;

public class TenantCtx {
    /* 非断言读槽：只回答「绑没绑」，供绑定前的条件检查使用——
       「检查未绑定」这个动作自身不能触发断言（Bug#1 教训：
       Id() 的断言读取与检查读取曾混用同一入口）。 */
    static int Peek(int slot) {
        return slot;
    }

    /* 当前租户；0=未绑定哨兵。开发态下业务查询遇 0 即抛错（Where 链构建期求值，异常落在动作里）。仅供业务查询读取租户时调用；控制流判断一律用 Peek()。 */
    static int Id(int slot) {
        if (slot == 0 && Cfg.Log.debug) {
            throw new Exception(
                "[tenant] 租户上下文未绑定（0=哨兵）：业务查询不得在无租户请求中运行");
        }
        return slot;
    }
}

/* 应用本地租户门面（包代际移植）：Zan.Mvc 包已全局化 sys 主数据
 * （sys_user 无租户列，AppController 无租户绑定），控制器基类不再提供
 * TenantId()。应用业务表保留 tenantId 列作数据谱系（一期单租户，插入
 * 路径恒写 1），读取侧统一经本门面取值——将来若恢复多租户，只需在此
 * 重新锚定（如从登录域扩展表读用户租户），调用点不动。 */
