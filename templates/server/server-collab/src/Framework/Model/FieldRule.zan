using System;
using System.Collections;
using System.Csv;
using System.Data;
using System.Data.Orm;
using System.Data.Excel;
using System.Json;
using System.Text;
using System.Web;
using ZanWeb.Dao.Oa;
using ZanWeb.Model.Oa;
using ZanWeb.Model;

public class FieldRule {
    string name;
    bool required;
    int kind;
    int maxLen;

    static FieldRule Text(string name, bool required, int maxLen) {
        FieldRule r = new FieldRule();
        r.name = name;
        r.required = required;
        r.kind = 0;
        r.maxLen = maxLen;
        return r;
    }

    static FieldRule Num(string name, bool required, int kind) {
        FieldRule r = new FieldRule();
        r.name = name;
        r.required = required;
        r.kind = kind;
        r.maxLen = 0;
        return r;
    }

    string Name() { return name; }

    bool Required() { return required; }

    int Kind() { return kind; }

    int MaxLen() { return maxLen; }
}

/* 导入行单个字段强类型实体（消除 recKeys / recVals 平行列表反模式）。 */
