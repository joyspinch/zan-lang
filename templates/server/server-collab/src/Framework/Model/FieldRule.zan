using System;
using System.Collections;
using System.Csv;
using System.Data;
using System.Data.Orm;
using System.Data.Excel;
using System.Json;
using System.Text;
using System.Web;
using Zan.Web.Dao.Oa;
using Zan.Web.Model.Oa;
using Zan.Web.Model;

public class FieldRule {
    public string name;
    public bool required;
    public int kind;
    public int maxLen;

    public static FieldRule Text(string name, bool required, int maxLen) {
        FieldRule r = new FieldRule();
        r.name = name;
        r.required = required;
        r.kind = 0;
        r.maxLen = maxLen;
        return r;
    }

    public static FieldRule Num(string name, bool required, int kind) {
        FieldRule r = new FieldRule();
        r.name = name;
        r.required = required;
        r.kind = kind;
        r.maxLen = 0;
        return r;
    }

    public string Name() { return name; }

    public bool Required() { return required; }

    public int Kind() { return kind; }

    public int MaxLen() { return maxLen; }
}

/* 导入行单个字段强类型实体（消除 recKeys / recVals 平行列表反模式）。 */
