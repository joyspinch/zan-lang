using System;
using System.Data;
using System.Data.Orm;
using Zan.Web.Dao.Crm;
using Zan.Web.Dao.Flow;
using Zan.Web.Dao.Oa;
using Zan.Web.Dao.Wms;
using Zan.Web.Model.Crm;
using Zan.Web.Model.Flow;
using Zan.Web.Model.Oa;
using Zan.Web.Model;
using Zan.Web.Model.Wms;

public class SearchSources {
    /* CRM 客户：name | contact | phone。 */
    public static async List<SearchHit> CrmCustomer(IDbConnection db, int tenantId,
                                             SysUser me, string kw, int limit) {
        List<SearchHit> items = new List<SearchHit>();
        int mask = await AuthUser.MaskOf(db, Convert.ToString(me.id),
            "Admin.Crm.Customers");
        if ((mask & (int)PermBit.View) == 0) { return items; }
        List<CrmCustomer> rows = await new CrmCustomerDao(db).Search(tenantId, kw, limit);
        for (int i = 0; i < rows.Count; i = i + 1) {
            CrmCustomer r = rows[i];
            SearchHit it = new SearchHit();
            it.title = r.name;
            it.link = "/admin/crm/customers";
            items.Add(it);
        }
        return items;
    }

