using System;
using System.Collections;
using System.Csv;
using System.Data;
using System.Data.Orm;
using System.Data.Excel;
using System.Json;
using System.Text;
using System.Web;
using ZanWeb.Dao.Oa;
using ZanWeb.Model.Oa;
using ZanWeb.Model;

public class ImportField {
    public string key;
    public string val;

    public static ImportField Make(string key, string val) {
        ImportField f = new ImportField();
        f.key = key;
        f.val = val;
        return f;
    }

    public string Key() { return key; }
    public string Val() { return val; }
}

