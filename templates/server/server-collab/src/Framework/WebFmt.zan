using System;

namespace ZanWeb;

/* 应用本地文本件（包代际移植）：ZanWeb.Web.Fmt 未随包提供 Excerpt——
 * 摘要截断留在应用侧，调用点 WebFmt.Excerpt( 改经本类。 */
class WebFmt {
    /* 摘要截断：压平换行，超长按 UTF-8 字符头回退截断加省略号
       （字节串即 UTF-8，直接按字节切会劈开多字节字符）。 */
    static string Excerpt(string s, int max) {
        if (s == null) { return ""; }
        string t = s.Replace("\r\n", " ").Replace("\n", " ").Replace("\r", " ");
        if (t.Length <= max) { return t; }
        int cut = max;
        /* 回退到不是 UTF-8 续字节（10xxxxxx）的位置：即一个完整字符的头。 */
        while (cut > 0 && (t[cut - 1] & 255) >= 128 && (t[cut - 1] & 255) < 192) {
            cut = cut - 1;
        }
        if (cut > 0 && (t[cut - 1] & 255) >= 192) { cut = cut - 1; }
        return t.Substring(0, cut) + "…";
    }
}
