using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb.Model.Flow;
using ZanWeb.Model.Sys;
using ZanWeb.Modules.Flow;

namespace ZanWeb.Admin.Flow;

/* /admin/flow/tasks 我的待办：流程流转到我的任务，含进度汇报（流水）与完成推进。
   完成即推进到下一节点并通知下一个责任人——「汇报进度 + 流转通知相关责任人」的闭环就在这里。 */
[Route("admin/flow/tasks/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("我的待办")]
class Tasks : AdminController {
    [HttpGet]
    [Route("/admin/flow/tasks")]
    [Custom(IsMenu = true, Icon = "mdi:clipboard-check", Perm = PermBit.View)]
    [Description("我的待办")]
    async void Index() {
        User me = await this.Admin();
        ViewData d = await this.Layout("我的待办");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }
        ListQuery q = this.Paged("id", 20);

        /* 我的待办 = 落在我头上的未完成任务；已办标签页看最近完成的。 */
        int mine = this.InInt("done", 0);
        d.Set("done", Convert.ToString(mine));
        d.Set("doneOn", mine == 1 ? "pri" : "");
        d.Set("doneOff", mine == 1 ? "" : "pri");
        d.Set("tabTitle", mine == 1 ? "已办任务" : "我的待办");
        d.Set("emptyText", mine == 1 ? "还没有已完成的任务" : "太棒了，没有待办任务");
        List<FlowTask> rows = await this.FlowTask
            .Where(a => a.assignUserId == me.id
                && a.status == (mine == 1 ? 1 : 0))
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.FlowTask
            .Where(a => a.assignUserId == me.id
                && a.status == (mine == 1 ? 1 : 0)).CountAsync();

        /* 实例标题只取本租户行（#34）；节点名经已闸任务可达。 */
        List<FlowInst> insts = await this.FlowInst
            .Where(a => a.tenantId == this.TenantId()).ToListAsync();
        List<FlowNode> nodes = await this.FlowNode.ToListAsync();
        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            FlowTask t = rows[i];
            StrMap m = new StrMap();
            m.Set("id", Convert.ToString(t.id));
            m.Set("inst", ZanWeb.Modules.Flow.Engine.InstTitle(insts, t.instId));
            m.Set("node", ZanWeb.Modules.Flow.Engine.NodeName(nodes, t.nodeId));
            m.Set("status", t.status == 0 ? "待处理"
                : (t.status == 1 ? "已完成" : "已跳过"));
            m.Set("result", t.result);
            m.Set("createdAt", Fmt.Day(t.createdAt));
            m.Set("canReport", t.status == 0 && this.Can(PermBit.Update) ? "1" : "");
            items.Add(m);
        }
        d.Set("empty", total == 0 ? "1" : "");
        this.Pager(d, q, total);
        this.Page(d);
    }

    /* Bug#3 租户闸（#34 起直读基列）：flow_inst 行带 tenantId——
       实例不在本租户（含超管跨租户）一律按任务不存在处理，
       与 Attachment.CanDownload 同语义：租户硬边先于任何角色豁免。 */
    async bool OwnTask(FlowTask t) {
        if (t == null) { return false; }
        FlowInst inst = await this.FlowInst
            .Where(a => a.id == t.instId
                && a.tenantId == this.TenantId()).FirstAsync();
        return inst != null;
    }

    /* 任务详情：实例信息、节点、进度汇报流水（只增不改）。 */
    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("任务详情")]
    async void Detail() {
        int id = this.InInt("id", 0);
        FlowTask t = await this.FlowTask.Where(a => a.id == id).FirstAsync();
        if (t == null) { this.Fail(404, "0404", "任务不存在"); return; }
        if (!await this.OwnTask(t)) { this.Fail(404, "0404", "任务不存在"); return; }
        FlowInst inst = await this.FlowInst
            .Where(a => a.id == t.instId).FirstAsync();
        FlowNode node = await this.FlowNode
            .Where(a => a.id == t.nodeId).FirstAsync();
        ViewData d = await this.Layout("任务详情");
        d.Set("id", Convert.ToString(t.id));
        d.Set("inst", inst != null ? inst.title : "-");
        d.Set("node", node != null ? node.name : "-");
        d.Set("status", t.status == 0 ? "待处理"
            : (t.status == 1 ? "已完成" : "已跳过"));
        d.Set("result", t.result);

        List<FlowLog> logs = await this.FlowLog
            .Where(a => a.taskId == t.id).ToListAsync();
        /* 流水署名与 @ 候选同源：仅本租户账号（Bug#3 同源收敛）。 */
        List<User> users = await this.User
            .Where(a => a.tenantId == this.TenantId()).ToListAsync();
        List<StrMap> items = d.AddList("logs");
        for (int i = 0; i < logs.Count; i = i + 1) {
            StrMap m = new StrMap();
            m.Set("who", ZanWeb.Modules.Flow.Engine.UserName(users, logs[i].userId));
            m.Set("content", logs[i].content);
            m.Set("createdAt", Fmt.Day(logs[i].createdAt));
            items.Add(m);
        }
        d.Set("logsEmpty", logs.Count == 0 ? "1" : "");
        /* 候选 @ 对象：本部门同事 + 全体启用账号（模板规模小，直接全量）。 */
        List<StrMap> cands = d.AddList("users");
        for (int i = 0; i < users.Count; i = i + 1) {
            if (users[i].status != 1) { continue; }
            StrMap m = new StrMap();
            m.Set("id", Convert.ToString(users[i].id));
            m.Set("name", Fmt.Text(users[i].nickname, users[i].username));
            cands.Add(m);
        }
        this.Dialog(d);
    }

    /* 汇报表单：本任务信息 + @ 候选人。 */
    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("汇报表单")]
    async void Form() {
        int id = this.InInt("id", 0);
        FlowTask t = await this.FlowTask.Where(a => a.id == id).FirstAsync();
        if (t == null) { this.Fail(404, "0404", "任务不存在"); return; }
        if (!await this.OwnTask(t)) { this.Fail(404, "0404", "任务不存在"); return; }
        FlowInst inst = await this.FlowInst
            .Where(a => a.id == t.instId).FirstAsync();
        FlowNode node = await this.FlowNode
            .Where(a => a.id == t.nodeId).FirstAsync();
        ViewData d = await this.Layout("汇报并完成");
        d.Set("id", Convert.ToString(t.id));
        d.Set("inst", inst != null ? inst.title : "-");
        d.Set("node", node != null ? node.name : "-");
        List<User> users = await this.User
            .Where(a => a.tenantId == this.TenantId() && a.status == 1)
            .ToListAsync();
        List<StrMap> cands = d.AddList("users");
        for (int i = 0; i < users.Count; i = i + 1) {
            StrMap m = new StrMap();
            m.Set("id", Convert.ToString(users[i].id));
            m.Set("name", Fmt.Text(users[i].nickname, users[i].username));
            cands.Add(m);
        }
        this.Dialog(d);
    }

    /* 汇报并完成：写流水、@相关责任人（每人生成通知）、完成任务并推进到下一节点。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("汇报完成")]
    async void Report() {
        int id = this.InInt("id", 0);
        FlowTask t = await this.FlowTask.Where(a => a.id == id).FirstAsync();
        if (t == null) { this.Fail(404, "0404", "任务不存在"); return; }
        if (!await this.OwnTask(t)) { this.Fail(404, "0404", "任务不存在"); return; }
        if (t.status != 0) { this.Fail(400, "0004", "任务已处理"); return; }
        User me = await this.Admin();
        if (t.assignUserId != me.id && !this.Can(PermBit.Update)) {
            this.Fail(403, "0403", "不是你的任务"); return;
        }
        /* Bug#8：汇报内容 textarea 多行语义，Need 内部走 In(Filter.Clean) 会剥
           换行——InRaw + 同语义空检查（原 Need 文案不变）。 */
        string report = this.InRaw("report");
        if (report.Length == 0) { this.Fail(400, "0003", "汇报内容不能为空"); return; }
        bool ok = await ZanWeb.Modules.Flow.Engine.Complete(
            this.Held(), t, me, report, this.In("mentions"));
        if (!ok) { this.Fail(400, "0004", "流程不在进行中"); return; }
        await this.Note("汇报完成", report, true, "");
        this.Saved("已汇报，流程已流转");
    }
}
