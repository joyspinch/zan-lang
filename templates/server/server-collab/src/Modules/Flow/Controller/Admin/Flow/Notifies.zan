using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Threading;
using System.Web;
using ZanWeb.Model.Oa;
using ZanWeb.Model.Sys;

namespace ZanWeb.Admin.Flow;

/* /admin/flow/notifies 兼容层（架构 §2.2 WP-2 / T3）：通知中心 canonical 页已迁
   Oa 域（ZanWeb.Admin.Oa.Notifies，/admin/oa/notifies）——Index 301 到新页；
   铃铛 API（unread/stream/read）是 T2 已焊死的存量契约，前端 bell.js 与收藏夹
   零改动依赖它们，原路径照常服务，实现与 Oa 版同源（sys_notify + NotifyHub），
   待 T13 统一事件流时收编。数据源已迁公共层：读写 sys_notify，旧 flow_notify
   停写只读。 */
[Route("admin/flow/notifies/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("通知中心(兼容)")]
class Notifies : AdminController {
    /* 流存活时长；标签整夜开着不应永远占协程，EventSource 会自连。 */
    static int StreamSeconds = 1800;

    /* 页面入口：301 永久重定向到 Oa 域新页（namespace 焊死纪律——URL 变更
       必留重定向兼容层，不得静默 404）。鉴权之后才到这里，未登录者照旧
       先见登录页。 */
    [HttpGet]
    [Route("/admin/flow/notifies")]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("通知中心")]
    async void Index() {
        await this.Admin();
        this.Ctx().Status(301, "Moved Permanently")
            .SetHeader("Location", "/admin/oa/notifies");
        /* Redirect() 的收尾契约：body 置空 + ended 置位，缺一则响应被判为
           未完成（500）。Text("") 正是这两笔。 */
        this.Ctx().Text("");
    }

    /* 未读数与最新未读列表：顶栏铃铛的轻量数据源，由前端定时拉取（SSE 只推在线实时增量）。 */
    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("未读通知")]
    async void Unread() {
        User me = await this.Admin();
        List<SysNotify> rows = await this.SysNotify
            .Where(a => a.userId == me.id && a.isRead == 0)
            .OrderByDescending(a => a.id).Take(8).ToListAsync();
        int total = await this.SysNotify
            .Where(a => a.userId == me.id && a.isRead == 0).CountAsync();
        JsonValue items = JsonValue.NewArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            JsonValue o = JsonValue.NewObject();
            o.Put("content", JsonValue.NewStr(rows[i].content));
            o.Put("link", JsonValue.NewStr(rows[i].link));
            items.Append(o);
        }
        JsonValue body = JsonValue.NewObject();
        body.Put("count", JsonValue.NewStr(Convert.ToString(total)));
        body.Put("items", items);
        this.Ctx().Json(body.ToJson());
    }

    /* 实时通知通道：WebSocket 长连接为主——ctx.WsUpgrade() 在路由/权限之后升级，
       会话直接继承本路由的授权语义，升级前收到的管道帧由框架切进 WsReader。
       非 WS 请求（老代理/老客户端）回落 SSE，同一端点按 Upgrade 头自动分流。
       写方只有 NotifyHub.Push：会话循环只读，客户端 20s 文本心跳唤醒 Recv 即自动
       续期；服务端 30 分钟收口一次，前端断开后自动重连（重连重新过一遍鉴权）。 */
    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("通知事件流")]
    async void Stream() {
        User me = await this.Admin();
        HttpContext ctx = this.Ctx();
        WsSession ws = await WebWs.Upgrade(ctx);
        if (ws != null) {
            /* 首帧同步未读数——此刻尚未登记进 NotifyHub，无并发写方，安全。 */
            int unread = await this.SysNotify
                .Where(a => a.userId == me.id && a.isRead == 0).CountAsync();
            JsonValue first = JsonValue.NewObject();
            first.PutStr("type", "unread");
            first.PutInt("count", unread);
            if (!await ws.SendText(first.ToJson())) { return; }
            ZanWeb.NotifyHub.JoinWs(me.id, ws);
            long started = WebApp.NowSeconds();
            while (ws.Open()) {
                string m = await ws.Recv();
                if (m == null) { break; }
                if (WebApp.NowSeconds() - started >= Notifies.StreamSeconds) {
                    await ws.Close(1000);
                    break;
                }
                /* 入站文本（心跳 ping 等）一律忽略；协议级 ping/pong 在 Recv 内已答。 */
            }
            ZanWeb.NotifyHub.LeaveWs(ws);
            return;
        }
        /* SSE 回退通道：与 WS 同一端点，老代理/老客户端走原路。 */
        if (!await ctx.SseOpen()) { return; }
        ZanWeb.NotifyHub.JoinSse(me.id, ctx);
        /* 首帧同步一次未读数，页面打开即为最新。 */
        int unread2 = await this.SysNotify
            .Where(a => a.userId == me.id && a.isRead == 0).CountAsync();
        if (!await ctx.SseSend("unread", "{\"count\":"
                + Convert.ToString(unread2) + "}")) {
            ZanWeb.NotifyHub.LeaveSse(ctx);
            return;
        }
        int elapsed = 0;
        while (elapsed < Notifies.StreamSeconds) {
            await Task.Delay(15000);
            elapsed = elapsed + 15;
            /* 保活注释行：空闲时让代理不误判断连；NotifyHub.Push 的事件不受此影响。 */
            if (!await ctx.SseSend("", ": keep-alive")) {
                break;
            }
        }
        ZanWeb.NotifyHub.LeaveSse(ctx);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("标记已读")]
    async void Read() {
        User me = await this.Admin();
        int id = this.InInt("id", 0);
        long now = WebApp.NowSeconds();
        if (id > 0) {
            int _n = await this.SysNotify.Update()
                .Set(a => a.isRead, 1)
                .Where(a => a.id == id && a.userId == me.id)
                .ExecuteAffrowsAsync();
        } else {
            int _n = await this.SysNotify.Update()
                .Set(a => a.isRead, 1)
                .Where(a => a.userId == me.id).ExecuteAffrowsAsync();
        }
        this.Saved("已标记");
    }
}
