/* /admin/flow/flows 流程编排：流程定义 CRUD + 节点编排子表弹窗 + 流程实例子表弹窗。 */
[Route("admin/flow/flows/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("流程编排")]
public class Flows : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .Text("流程名称", "kw", "name", "搜索流程名称")
            .TbarAdd("新建流程", "/admin/flow/flows/form")
            .TbarCustom("全部实例", "/admin/flow/flows/instances", "")
            .Col("id", "ID", "num", "75")
            .Col("name", "流程名称", "text", "200")
            .Col("description", "说明", "text", "240")
            .Col("nodeCount", "节点数", "num", "90")
            .Tag("status", "状态", "1=启用|ok,0=停用|off", "90")
            .OpsEdit("/admin/flow/flows/form")
            .Ops("编排节点", "/admin/flow/flows/nodes", "", "defId={id}", "u")
            .Ops("流程实例", "/admin/flow/flows/instances", "", "defId={id}", "")
            .Ops("启停", "/admin/flow/flows/status", "确认切换该流程启停状态吗？", "id={id}&status={nextStatus}", "u")
            .OpsDel("/admin/flow/flows/delete", "确认删除该流程及其全部节点吗？");
    }

    static ListPage NodesDef() {
        return ListPage.Of()
            .TbarAdd("新增节点", "/admin/flow/flows/nodes/form")
            .Col("sort", "顺序", "num", "80")
            .Col("name", "节点名称", "text", "180")
            .Tag("kind", "处理方式", "human=人工|ok,ai=AI 自动|warn", "110")
            .Col("deptName", "责任部门", "text", "140")
            .Col("assignUser", "指定责任人", "text", "140")
            .Col("aiPrompt", "AI 提示词", "text", "220")
            .OpsEdit("/admin/flow/flows/nodes/form")
            .OpsDel("/admin/flow/flows/nodes/delete", "确认删除该流程节点吗？");
    }

    static ListPage InstancesDef() {
        return ListPage.Of()
            .Text("实例标题", "kw", "title", "搜索实例标题")
            .TbarAdd("发起流程", "/admin/flow/flows/instances/form")
            .Col("id", "ID", "num", "75")
            .Col("title", "实例标题", "text", "220")
            .Col("def", "所属流程", "text", "160")
            .Col("node", "当前节点", "text", "140")
            .Tag("status", "状态", "1=进行中|warn,2=已完成|ok,3=已终止|off", "100")
            .Col("createdAt", "发起日期", "text", "125")
            .Ops("终止实例", "/admin/flow/flows/kill", "确认终止该进行中的流程实例吗？", "id={id}", "d");
    }

    [HttpGet]
    [Route("/admin/flow/flows")]
    [Custom(IsMenu = true, Icon = "mdi:file-tree", Perm = PermBit.View)]
    [Description("流程编排")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("流程编排表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Flows.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("流程列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        ListQuery q = this.PagedAny("id", 20);
        string kw = q.Kw();
        List<FlowDef> rows = await this.FlowDef
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .OrderBy(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.FlowDef
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw)).CountAsync();
        List<FlowNode> allNodes = await this.FlowNode.ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            FlowDef r = rows[i];
            int nc = 0;
            for (int k = 0; k < allNodes.Count; k = k + 1) {
                if (allNodes[k].defId == r.id) { nc = nc + 1; }
            }
            w.WriteStartObject();
            w.WriteProperty("id", r.id);
            w.WriteProperty("name", r.name);
            w.WriteProperty("description", Fmt.Dash(r.description));
            w.WriteProperty("nodeCount", nc);
            w.WriteProperty("status", Convert.ToString(r.status));
            w.WriteProperty("nextStatus", r.status == 1 ? 0 : 1);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("流程表单配置")]
    public void FormConf() {
        FormPage fp = FormPage.Of("/admin/flow/flows/save")
            .Text("流程名称", "name").Req().Ph("请输入流程名称")
            .Area("流程说明", "description").Span().Ph("描述该审批或协同流程的适用场景")
            .Select("状态", "status", "1=启用,0=停用").Val("1");
        CrudOps.FormConf(this, fp, "流程定义");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("流程编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        FlowDef r = await this.FlowDef
            .Where(a => a.id == id).FirstAsync();
        if (r == null) { this.Fail(404, "0404", "流程不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", r.id);
        w.WriteProperty("name", r.name);
        w.WriteProperty("description", r.description);
        w.WriteProperty("status", Convert.ToString(r.status));
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    /* 保存流程定义；如请求带 node_name_0..63 则兼容整表节点替换，否则保留已有节点。 */
    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存流程")]
    async void Save() {
        int id = this.InAnyInt("id", 0);
        string name = this.NeedAny("name", "流程名称");
        if (name.Length == 0) { this.Fail(400, "0004", "请填写流程名称"); return; }
        long now = WebApp.NowSeconds();
        FlowDef def;
        if (id > 0) {
            def = await this.FlowDef
                .Where(a => a.id == id).FirstAsync();
            if (def == null) { this.Fail(404, "0404", "流程不存在"); return; }
            int _u = await this.FlowDef.Update()
                .Set(a => a.name, name)
                .Set(a => a.description, this.InAny("description"))
                .Set(a => a.status, this.InAnyInt("status", def.status))
                .Set(a => a.updatedAt, now)
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
        } else {
            def = new FlowDef();
            def.tenantId = Tenant.Cur();
            def.name = name;
            def.description = this.InAny("description");
            def.status = this.InAnyInt("status", 1);
            def.createdAt = now;
            def.updatedAt = now;
            id = await this.FlowDef.Insert(def).ExecuteIdentityAsync();
        }

        if (this.HasInAny("node_name_0")) {
            int _d = await this.FlowNode.Delete()
                .Where(a => a.defId == id).ExecuteAffrowsAsync();
            for (int i = 0; i < 64; i = i + 1) {
                string nodeName = this.InAny("node_name_" + Convert.ToString(i));
                if (nodeName.Length == 0) { continue; }
                FlowNode n = new FlowNode();
                n.defId = id;
                n.name = nodeName;
                n.sort = this.InAnyInt("node_sort_" + Convert.ToString(i), i + 1);
                n.deptId = this.InAnyInt("node_dept_" + Convert.ToString(i), 0);
                n.assignUserId = this.InAnyInt("node_user_" + Convert.ToString(i), 0);
                string kind = this.InAny("node_kind_" + Convert.ToString(i));
                n.kind = kind == "ai" ? "ai" : "human";
                n.aiPrompt = this.InAny("node_prompt_" + Convert.ToString(i));
                n.createdAt = now;
                await this.FlowNode.Insert(n).ExecuteIdentityAsync();
            }
        }
        await this.Note("保存流程", name, true, "");
        this.Saved("已保存");
    }

