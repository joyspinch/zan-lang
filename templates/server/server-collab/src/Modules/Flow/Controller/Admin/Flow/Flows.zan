        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Route("/admin/flow/flows/nodes/save")]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存流程节点")]
    public async void NodesSave() {
        int id = this.InAnyInt("id", 0);
        int defId = this.InAnyInt("defId", 0);
        string name = this.NeedAny("name", "节点名称");
        int sort = this.InAnyInt("sort", 1);
        int deptId = this.InAnyInt("deptId", 0);
        int assignUserId = this.InAnyInt("assignUserId", 0);
        string kind = this.InAny("kind") == "ai" ? "ai" : "human";
        string aiPrompt = this.InAnyRaw("aiPrompt");

        if (id > 0) {
            int aff = await this.FlowNode.Update()
                .Set(a => a.name, name)
                .Set(a => a.sort, sort)
                .Set(a => a.deptId, deptId)
                .Set(a => a.assignUserId, assignUserId)
                .Set(a => a.kind, kind)
                .Set(a => a.aiPrompt, aiPrompt)
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            if (aff <= 0) { this.Fail(404, "0404", "节点不存在"); return; }
            await this.Note("编辑流程节点", "#" + Convert.ToString(id) + " " + name, true, "");
            this.Saved("节点已保存");
            return;
        }
        if (defId <= 0) { this.Fail(400, "0004", "缺少流程定义"); return; }
        FlowNode node = new FlowNode();
        node.defId = defId;
        node.name = name;
        node.sort = sort;
        node.deptId = deptId;
        node.assignUserId = assignUserId;
        node.kind = kind;
        node.aiPrompt = aiPrompt;
        node.createdAt = WebApp.NowSeconds();
        int newId = await this.FlowNode.Insert(node).ExecuteIdentityAsync();
        await this.Note("新增流程节点", "#" + Convert.ToString(newId) + " " + name, newId > 0, "");
        this.Saved("节点已创建");
    }

    [HttpPost]
    [Route("/admin/flow/flows/nodes/delete")]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除流程节点")]
    public async void NodesDelete() {
        int id = this.InAnyInt("id", 0);
        int n = await this.FlowNode.Delete()
            .Where(a => a.id == id).ExecuteAffrowsAsync();
        if (n <= 0) { this.Fail(404, "0404", "节点不存在"); return; }
        await this.Note("删除流程节点", "#" + Convert.ToString(id), true, "");
        this.Saved("节点已删除");
    }

    /* 发起实例（兼容直接 POST 与实例子表新建弹窗）。 */
    [HttpPost]
    [Custom(Perm = PermBit.Create)]
    [Description("发起流程")]
    public async void Start() {
        int defId = this.InAnyInt("defId", 0);
        string title = this.NeedAny("title", "实例标题");
        FlowDef def = await this.FlowDef
            .Where(a => a.id == defId).FirstAsync();
        if (def == null) { this.Fail(404, "0404", "流程不存在"); return; }
        if (def.status != 1) { this.Fail(400, "0004", "流程已停用"); return; }
        if (title.Length == 0) { this.Fail(400, "0004", "请填写实例标题"); return; }
        SysUser me = await this.Admin();
        int instId = await Zan.Web.Modules.Flow.Engine.Start(
            this.Held(), def, title, this.InAny("bizRef"), me.id);
        await this.Note("发起流程", title, instId > 0, "");
        this.Saved("已发起，首个任务已派发");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("启停流程")]
    async void Status() {
        int id = this.InAnyInt("id", 0);
        int status = this.InAnyInt("status", 1);
        if (status != 0 && status != 1) { this.Fail(400, "0004", "状态不合法"); return; }
        long now = WebApp.NowSeconds();
        int n = await this.FlowDef.Update()
            .Set(a => a.status, status)
            .Set(a => a.updatedAt, now)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        this.Saved(n > 0 ? (status == 1 ? "已启用" : "已停用") : "流程不存在");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除流程")]
    async void Delete() {
        int id = this.InAnyInt("id", 0);
        FlowDef def = await this.FlowDef
            .Where(a => a.id == id).FirstAsync();
        if (def == null) { this.Fail(404, "0404", "流程不存在"); return; }
        int used = await this.FlowInst
            .Where(a => a.defId == def.id && a.status == 1).CountAsync();
        if (used > 0) { this.Fail(400, "0004", "有进行中的实例，先终止再删除"); return; }
        int _n1 = await this.FlowNode.Delete()
            .Where(a => a.defId == def.id).ExecuteAffrowsAsync();
        int _n2 = await this.FlowDef.Delete()
            .Where(a => a.id == def.id).ExecuteAffrowsAsync();
        await this.Note("删除流程", "defId=" + Convert.ToString(def.id), true, "");
        this.Saved("已删除");
    }

    /* ---- 流程实例子表（SubTableModal）---- */

    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("流程实例")]
    void Instances() {
        this.InstancesConf();
    }

    [HttpPut]
    [Route("/admin/flow/flows/instances/conf")]
    [Custom(Perm = PermBit.View)]
    [Description("流程实例表格配置")]
    public void InstancesConf() {
        CrudOps.Conf(this, Flows.InstancesDef());
    }

    [HttpPost]
    [Route("/admin/flow/flows/instances/list")]
    [Custom(Perm = PermBit.View)]
    [Description("流程实例列表数据")]
    public async void InstancesList() {
        if (!this.DataReady()) { return; }
        ListQuery q = this.PagedAny("id", 20);
        string kw = q.Kw();
        int defId = this.InAnyInt("defId", 0);
        List<FlowInst> rows = await this.FlowInst
            .WhereIf(defId > 0, a => a.defId == defId)
            .WhereIf(kw.Length > 0, a => a.title.Contains(kw))
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.FlowInst
            .WhereIf(defId > 0, a => a.defId == defId)
            .WhereIf(kw.Length > 0, a => a.title.Contains(kw)).CountAsync();

        List<FlowDef> defs = await this.FlowDef.ToListAsync();
        List<FlowNode> nodes = await this.FlowNode.ToListAsync();
        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            FlowInst r = rows[i];
            w.WriteStartObject();
            w.WriteProperty("id", r.id);
            w.WriteProperty("title", r.title);
            w.WriteProperty("def", Zan.Web.Modules.Flow.Engine.DefName(defs, r.defId));
            w.WriteProperty("node", Zan.Web.Modules.Flow.Engine.NodeName(nodes, r.currentNodeId));
            w.WriteProperty("status", Convert.ToString(r.status));
            w.WriteProperty("createdAt", Fmt.Day(r.createdAt));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpPut]
    [Route("/admin/flow/flows/instances/formconf")]
    [Custom(Perm = PermBit.Create)]
    [Description("发起流程表单配置")]
    public async void InstancesFormConf() {
        int presetDefId = this.InAnyInt("defId", 0);
        List<FlowDef> defs = await this.FlowDef
            .Where(a => a.status == 1).OrderBy(a => a.id).ToListAsync();
        List<StrMap> dopts = new List<StrMap>();
        for (int i = 0; i < defs.Count; i = i + 1) {
            StrMap m = new StrMap();
            m.Set("id", Convert.ToString(defs[i].id));
            m.Set("name", defs[i].name);
            dopts.Add(m);
        }
        FormPage fp = FormPage.Of("/admin/flow/flows/start")
            .SelectList("流程定义", "defId", dopts).Req()
            .Text("实例标题", "title").Req().Ph("例如：新品上架审批 - SKU001")
            .Text("关联业务单号", "bizRef").Ph("可选，如订单/客户 ID");
        if (presetDefId > 0) {
            fp.Field("defId").Val(Convert.ToString(presetDefId));
        }
        CrudOps.FormConf(this, fp, "发起流程");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("终止实例")]
    async void Kill() {
        int id = this.InAnyInt("id", 0);
        long now = WebApp.NowSeconds();
        int n = await this.FlowInst.Update()
            .Set(a => a.status, 3)
            .Set(a => a.currentNodeId, 0)
            .Set(a => a.updatedAt, now)
            .Where(a => a.id == id && a.status == 1).ExecuteAffrowsAsync();
        this.Saved(n > 0 ? "已终止" : "实例不在进行中");
    }

    static string DeptName(List<SysDepartment> depts, int id) {
        if (id <= 0) { return "不限"; }
        for (int i = 0; i < depts.Count; i = i + 1) {
            if (depts[i].id == id) { return depts[i].name; }
        }
        return "—";
    }

    static string UserName(List<SysUser> users, int id) {
        if (id <= 0) { return "未指定"; }
        for (int i = 0; i < users.Count; i = i + 1) {
            if (users[i].id == id) { return Fmt.Text(users[i].nickname, users[i].username); }
        }
        return "—";
    }
}
