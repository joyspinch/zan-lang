    }

    [HttpPost]
    [Route("/admin/flow/flows/nodes/list")]
    [Custom(Perm = PermBit.View)]
    [Description("流程节点列表数据")]
    public async void NodesList() {
        if (!this.DataReady()) { return; }
        int defId = this.InAnyInt("defId", 0);
        List<FlowNode> nodes = await this.FlowNode
            .Where(a => a.defId == defId).ToListAsync();
        List<FlowNode> ordered = Zan.Web.Modules.Flow.Engine.SortNodes(nodes);
        List<SysDepartment> depts = await this.SysDepartment.ToListAsync();
        List<SysUser> users = await this.SysUser.ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < ordered.Count; i = i + 1) {
            FlowNode n = ordered[i];
            w.WriteStartObject();
            w.WriteProperty("id", n.id);
            w.WriteProperty("defId", n.defId);
            w.WriteProperty("sort", n.sort);
            w.WriteProperty("name", n.name);
            w.WriteProperty("kind", n.kind == "ai" ? "ai" : "human");
            w.WriteProperty("deptId", Convert.ToString(n.deptId));
            w.WriteProperty("deptName", Flows.DeptName(depts, n.deptId));
            w.WriteProperty("assignUserId", Convert.ToString(n.assignUserId));
            w.WriteProperty("assignUser", Flows.UserName(users, n.assignUserId));
            w.WriteProperty("aiPrompt", Fmt.Dash(n.aiPrompt));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, ordered.Count, w.ToString());
    }

    [HttpPut]
    [Route("/admin/flow/flows/nodes/formconf")]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("流程节点表单配置")]
    public async void NodesFormConf() {
        List<SysDepartment> depts = await this.SysDepartment.ToListAsync();
        List<StrMap> dopts = new List<StrMap>();
        StrMap d0 = new StrMap(); d0.Set("id", "0"); d0.Set("name", "不限部门"); dopts.Add(d0);
        for (int i = 0; i < depts.Count; i = i + 1) {
            StrMap m = new StrMap();
            m.Set("id", Convert.ToString(depts[i].id));
            m.Set("name", depts[i].name);
            dopts.Add(m);
        }
        List<SysUser> users = await this.SysUser.Where(a => a.status == 1).ToListAsync();
        List<StrMap> uopts = new List<StrMap>();
        StrMap u0 = new StrMap(); u0.Set("id", "0"); u0.Set("name", "未指定责任人"); uopts.Add(u0);
        for (int i = 0; i < users.Count; i = i + 1) {
            StrMap m = new StrMap();
            m.Set("id", Convert.ToString(users[i].id));
            m.Set("name", Fmt.Text(users[i].nickname, users[i].username));
            uopts.Add(m);
        }
        FormPage fp = FormPage.Of("/admin/flow/flows/nodes/save")
            .Wide()
            .Text("节点名称", "name").Req().Ph("例如：部门初审 / 财务复核")
            .Num("顺序号", "sort").Val("1")
            .Select("处理方式", "kind", "human=人工处理,ai=AI 自动处理").Val("human")
            .SelectList("责任部门", "deptId", dopts).Val("0")
            .SelectList("指定责任人", "assignUserId", uopts).Val("0")
            .Area("AI 提示词", "aiPrompt").Span().Ph("仅 AI 自动节点填写");
        CrudOps.FormConf(this, fp, "流程节点");
    }

    [HttpPost]
