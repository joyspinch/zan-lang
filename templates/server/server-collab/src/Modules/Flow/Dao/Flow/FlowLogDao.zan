using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Flow;

namespace ZanWeb.Dao.Flow;

/* FlowLog 强类型数据访问网关（FreeSql 风格） */
class FlowLogDao {
    IDbConnection db;

    FlowLogDao(IDbConnection db) {
        this.db = db;
    }

    async FlowLog ById(int id) {
        return await this.db.Select<FlowLog>().Where(a => a.id == id).FirstAsync();
    }

    async List<FlowLog> All() {
        return await this.db.Select<FlowLog>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<FlowLog>().CountAsync();
    }

    async int Insert(FlowLog entity) {
        return await this.db.Insert<FlowLog>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<FlowLog>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
