using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Flow;

namespace ZanWeb.Dao.Flow;

/* FlowLog 强类型数据访问网关（FreeSql 风格） */
class FlowLogDao : BaseRepository<FlowLog> {
    FlowLogDao(IFreeSql fsql) : base(fsql) {}
    FlowLogDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async FlowLog ById(int id) {
        return await this.GetExecutor().Select<FlowLog>().Where(a => a.id == id).FirstAsync();
    }

    async List<FlowLog> All() {
        return await this.GetExecutor().Select<FlowLog>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<FlowLog>().CountAsync();
    }

    async int Insert(FlowLog entity) {
        return await this.GetExecutor().Insert<FlowLog>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<FlowLog>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
