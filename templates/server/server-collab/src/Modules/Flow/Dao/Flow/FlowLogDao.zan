using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Flow;

namespace Zan.Web.Dao.Flow;

/* FlowLog 强类型数据访问网关（ZanSql 风格） */
public class FlowLogDao : BaseRepository<FlowLog> {
    public FlowLogDao() : base() {}
    public FlowLogDao(IZanSql fsql) : base(fsql) {}
    public FlowLogDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async FlowLog ById(int id) {
        return await this.GetExecutor().Select<FlowLog>().Where(a => a.id == id).FirstAsync();
    }

    public async List<FlowLog> All() {
        return await this.GetExecutor().Select<FlowLog>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<FlowLog>().CountAsync();
    }

    public InsertQuery<FlowLog> Insert(FlowLog entity) {
        return this.GetExecutor().Insert<FlowLog>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<FlowLog>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
