using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Flow;

namespace Zan.Web.Dao.Flow;

/* FlowNotify 强类型数据访问网关（ZanSql 风格） */
public class FlowNotifyDao : BaseRepository<FlowNotify> {
    public FlowNotifyDao() : base() {}
    public FlowNotifyDao(IZanSql fsql) : base(fsql) {}
    public FlowNotifyDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async FlowNotify ById(int id) {
        return await this.GetExecutor().Select<FlowNotify>().Where(a => a.id == id).FirstAsync();
    }

    public async List<FlowNotify> All() {
        return await this.GetExecutor().Select<FlowNotify>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<FlowNotify>().CountAsync();
    }

    public InsertQuery<FlowNotify> Insert(FlowNotify entity) {
        return this.GetExecutor().Insert<FlowNotify>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<FlowNotify>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
