using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Flow;

namespace ZanWeb.Dao.Flow;

/* FlowNotify 强类型数据访问网关（FreeSql 风格） */
class FlowNotifyDao {
    IDbConnection db;

    FlowNotifyDao(IDbConnection db) {
        this.db = db;
    }

    async FlowNotify ById(int id) {
        return await this.db.Select<FlowNotify>().Where(a => a.id == id).FirstAsync();
    }

    async List<FlowNotify> All() {
        return await this.db.Select<FlowNotify>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<FlowNotify>().CountAsync();
    }

    async int Insert(FlowNotify entity) {
        return await this.db.Insert<FlowNotify>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<FlowNotify>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
