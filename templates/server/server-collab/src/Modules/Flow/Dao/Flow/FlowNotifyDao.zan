using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Flow;

namespace ZanWeb.Dao.Flow;

/* FlowNotify 强类型数据访问网关（FreeSql 风格） */
class FlowNotifyDao : BaseRepository<FlowNotify> {
    FlowNotifyDao(IFreeSql fsql) : base(fsql) {}
    FlowNotifyDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async FlowNotify ById(int id) {
        return await this.GetExecutor().Select<FlowNotify>().Where(a => a.id == id).FirstAsync();
    }

    async List<FlowNotify> All() {
        return await this.GetExecutor().Select<FlowNotify>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<FlowNotify>().CountAsync();
    }

    async int Insert(FlowNotify entity) {
        return await this.GetExecutor().Insert<FlowNotify>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<FlowNotify>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
