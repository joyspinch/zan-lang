using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Flow;

namespace Zan.Web.Dao.Flow;

/* FlowDef 强类型数据访问网关（ZanSql 风格） */
public class FlowDefDao : BaseRepository<FlowDef> {
    public FlowDefDao() : base() {}
    public FlowDefDao(IZanSql fsql) : base(fsql) {}
    public FlowDefDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async FlowDef ById(int id) {
        return await this.GetExecutor().Select<FlowDef>().Where(a => a.id == id).FirstAsync();
    }

    public async List<FlowDef> All() {
        return await this.GetExecutor().Select<FlowDef>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<FlowDef>().CountAsync();
    }

    public InsertQuery<FlowDef> Insert(FlowDef entity) {
        return this.GetExecutor().Insert<FlowDef>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<FlowDef>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
