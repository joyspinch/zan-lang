using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Flow;

namespace ZanWeb.Dao.Flow;

/* FlowDef 强类型数据访问网关（FreeSql 风格） */
class FlowDefDao : BaseRepository<FlowDef> {
    FlowDefDao(IFreeSql fsql) : base(fsql) {}
    FlowDefDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async FlowDef ById(int id) {
        return await this.GetExecutor().Select<FlowDef>().Where(a => a.id == id).FirstAsync();
    }

    async List<FlowDef> All() {
        return await this.GetExecutor().Select<FlowDef>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<FlowDef>().CountAsync();
    }

    async int Insert(FlowDef entity) {
        return await this.GetExecutor().Insert<FlowDef>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<FlowDef>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
