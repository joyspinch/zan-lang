using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Flow;

namespace ZanWeb.Dao.Flow;

/* FlowDef 强类型数据访问网关（FreeSql 风格） */
class FlowDefDao {
    IDbConnection db;

    FlowDefDao(IDbConnection db) {
        this.db = db;
    }

    async FlowDef ById(int id) {
        return await this.db.Select<FlowDef>().Where(a => a.id == id).FirstAsync();
    }

    async List<FlowDef> All() {
        return await this.db.Select<FlowDef>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<FlowDef>().CountAsync();
    }

    async int Insert(FlowDef entity) {
        return await this.db.Insert<FlowDef>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<FlowDef>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
