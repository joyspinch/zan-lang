using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Flow;

namespace ZanWeb.Dao.Flow;

/* FlowTask 强类型数据访问网关（FreeSql 风格） */
class FlowTaskDao {
    IDbConnection db;

    FlowTaskDao(IDbConnection db) {
        this.db = db;
    }

    async FlowTask ById(int id) {
        return await this.db.Select<FlowTask>().Where(a => a.id == id).FirstAsync();
    }

    async List<FlowTask> All() {
        return await this.db.Select<FlowTask>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<FlowTask>().CountAsync();
    }

    async int Insert(FlowTask entity) {
        return await this.db.Insert<FlowTask>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<FlowTask>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async List<FlowTask> PendingByAssignee(int assignUserId) {
        return await this.db.Select<FlowTask>()
            .Where(a => a.assignUserId == assignUserId && a.status == 0)
            .ToListAsync();
    }

    async int FinishTask(int id, string report, long finishedAt) {
        return await this.db.Update<FlowTask>()
            .Set(a => a.status, 1)
            .Set(a => a.result, report)
            .Set(a => a.finishedAt, finishedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int ClaimTask(int id, int userId) {
        return await this.db.Update<FlowTask>()
            .Set(a => a.assignUserId, userId)
            .Where(a => a.id == id && a.status == 0 && a.assignUserId == 0)
            .ExecuteAffrowsAsync();
    }

    async int SubmitForReview(int id, string report) {
        return await this.db.Update<FlowTask>()
            .Set(a => a.status, 3)
            .Set(a => a.result, report)
            .Where(a => a.id == id && a.status == 0)
            .ExecuteAffrowsAsync();
    }

    async int AcceptReview(int id, long finishedAt) {
        return await this.db.Update<FlowTask>()
            .Set(a => a.status, 1)
            .Set(a => a.finishedAt, finishedAt)
            .Where(a => a.id == id && a.status == 3)
            .ExecuteAffrowsAsync();
    }

    async int RejectReview(int id, bool repool) {
        if (repool) {
            return await this.db.Update<FlowTask>()
                .Set(a => a.status, 0)
                .Set(a => a.assignUserId, 0)
                .Set(a => a.finishedAt, 0)
                .Where(a => a.id == id && a.status == 3)
                .ExecuteAffrowsAsync();
        } else {
            return await this.db.Update<FlowTask>()
                .Set(a => a.status, 0)
                .Set(a => a.finishedAt, 0)
                .Where(a => a.id == id && a.status == 3)
                .ExecuteAffrowsAsync();
        }
    }
}
