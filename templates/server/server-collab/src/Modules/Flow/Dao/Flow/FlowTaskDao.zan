using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Flow;

namespace Zan.Web.Dao.Flow;

/* FlowTask 强类型数据访问网关（ZanSql 风格） */
public class FlowTaskDao : BaseRepository<FlowTask> {
    public FlowTaskDao() : base() {}
    public FlowTaskDao(IZanSql fsql) : base(fsql) {}
    public FlowTaskDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async FlowTask ById(int id) {
        return await this.GetExecutor().Select<FlowTask>().Where(a => a.id == id).FirstAsync();
    }

    public async List<FlowTask> All() {
        return await this.GetExecutor().Select<FlowTask>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<FlowTask>().CountAsync();
    }

    public InsertQuery<FlowTask> Insert(FlowTask entity) {
        return this.GetExecutor().Insert<FlowTask>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<FlowTask>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async List<FlowTask> PendingByAssignee(int assignUserId) {
        return await this.GetExecutor().Select<FlowTask>()
            .Where(a => a.assignUserId == assignUserId && a.status == 0)
            .ToListAsync();
    }

    public async int FinishTask(int id, string report, long finishedAt) {
        return await this.GetExecutor().Update<FlowTask>()
            .Set(a => a.status, 1)
            .Set(a => a.result, report)
            .Set(a => a.finishedAt, finishedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    public async int ClaimTask(int id, int userId) {
        return await this.GetExecutor().Update<FlowTask>()
            .Set(a => a.assignUserId, userId)
            .Where(a => a.id == id && a.status == 0 && a.assignUserId == 0)
            .ExecuteAffrowsAsync();
    }

    public async int SubmitForReview(int id, string report) {
        return await this.GetExecutor().Update<FlowTask>()
            .Set(a => a.status, 3)
            .Set(a => a.result, report)
            .Where(a => a.id == id && a.status == 0)
            .ExecuteAffrowsAsync();
    }

    public async int AcceptReview(int id, long finishedAt) {
        return await this.GetExecutor().Update<FlowTask>()
            .Set(a => a.status, 1)
            .Set(a => a.finishedAt, finishedAt)
            .Where(a => a.id == id && a.status == 3)
            .ExecuteAffrowsAsync();
    }

    public async int RejectReview(int id, bool repool) {
        if (repool) {
            return await this.GetExecutor().Update<FlowTask>()
                .Set(a => a.status, 0)
                .Set(a => a.assignUserId, 0)
                .Set(a => a.finishedAt, 0)
                .Where(a => a.id == id && a.status == 3)
                .ExecuteAffrowsAsync();
        } else {
            return await this.GetExecutor().Update<FlowTask>()
                .Set(a => a.status, 0)
                .Set(a => a.finishedAt, 0)
                .Where(a => a.id == id && a.status == 3)
                .ExecuteAffrowsAsync();
        }
    }
}
