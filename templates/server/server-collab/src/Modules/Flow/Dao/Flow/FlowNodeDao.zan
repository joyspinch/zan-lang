using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Flow;

namespace ZanWeb.Dao.Flow;

/* FlowNode 强类型数据访问网关（FreeSql 风格） */
class FlowNodeDao {
    IDbConnection db;

    FlowNodeDao(IDbConnection db) {
        this.db = db;
    }

    async FlowNode ById(int id) {
        return await this.db.Select<FlowNode>().Where(a => a.id == id).FirstAsync();
    }

    async List<FlowNode> All() {
        return await this.db.Select<FlowNode>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<FlowNode>().CountAsync();
    }

    async int Insert(FlowNode entity) {
        return await this.db.Insert<FlowNode>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<FlowNode>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async List<FlowNode> ByDefId(int defId) {
        return await this.db.Select<FlowNode>()
            .Where(a => a.defId == defId)
            .ToListAsync();
    }
}
