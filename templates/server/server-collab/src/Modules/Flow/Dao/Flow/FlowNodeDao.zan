using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Flow;

namespace Zan.Web.Dao.Flow;

/* FlowNode 强类型数据访问网关（ZanSql 风格） */
public class FlowNodeDao : BaseRepository<FlowNode> {
    public FlowNodeDao() : base() {}
    public FlowNodeDao(IZanSql fsql) : base(fsql) {}
    public FlowNodeDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async FlowNode ById(int id) {
        return await this.GetExecutor().Select<FlowNode>().Where(a => a.id == id).FirstAsync();
    }

    public async List<FlowNode> All() {
        return await this.GetExecutor().Select<FlowNode>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<FlowNode>().CountAsync();
    }

    public InsertQuery<FlowNode> Insert(FlowNode entity) {
        return this.GetExecutor().Insert<FlowNode>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<FlowNode>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async List<FlowNode> ByDefId(int defId) {
        return await this.GetExecutor().Select<FlowNode>()
            .Where(a => a.defId == defId)
            .ToListAsync();
    }
}
