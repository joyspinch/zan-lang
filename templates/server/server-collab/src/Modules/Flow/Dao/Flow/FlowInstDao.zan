using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Flow;

namespace ZanWeb.Dao.Flow;

/* FlowInst 强类型数据访问网关（FreeSql 风格） */
class FlowInstDao {
    IDbConnection db;

    FlowInstDao(IDbConnection db) {
        this.db = db;
    }

    async FlowInst ById(int id) {
        return await this.db.Select<FlowInst>().Where(a => a.id == id).FirstAsync();
    }

    async List<FlowInst> All() {
        return await this.db.Select<FlowInst>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<FlowInst>().CountAsync();
    }

    async int Insert(FlowInst entity) {
        return await this.db.Insert<FlowInst>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<FlowInst>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async List<FlowInst> ByTenant(int tenantId) {
        return await this.db.Select<FlowInst>()
            .Where(a => a.tenantId == tenantId)
            .ToListAsync();
    }

    async int UpdateCurrentNode(int id, int nodeId, long updatedAt) {
        return await this.db.Update<FlowInst>()
            .Set(a => a.currentNodeId, nodeId)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int CloseInstance(int id, long updatedAt) {
        return await this.db.Update<FlowInst>()
            .Set(a => a.status, 2)
            .Set(a => a.currentNodeId, 0)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async List<FlowInst> Search(int tenantId, string kw, int limit) {
        return await this.db.Select<FlowInst>()
            .Where(a => a.tenantId == tenantId
                && (a.title.Contains(kw) || a.bizRef.Contains(kw)))
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }
}
