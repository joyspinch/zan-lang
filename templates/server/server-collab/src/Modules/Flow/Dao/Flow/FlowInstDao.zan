using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Flow;

namespace Zan.Web.Dao.Flow;

/* FlowInst 强类型数据访问网关（ZanSql 风格） */
public class FlowInstDao : BaseRepository<FlowInst> {
    public FlowInstDao() : base() {}
    public FlowInstDao(IZanSql fsql) : base(fsql) {}
    public FlowInstDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async FlowInst ById(int id) {
        return await this.GetExecutor().Select<FlowInst>().Where(a => a.id == id).FirstAsync();
    }

    public async List<FlowInst> All() {
        return await this.GetExecutor().Select<FlowInst>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<FlowInst>().CountAsync();
    }

    public InsertQuery<FlowInst> Insert(FlowInst entity) {
        return this.GetExecutor().Insert<FlowInst>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<FlowInst>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async List<FlowInst> ByTenant(int tenantId) {
        return await this.GetExecutor().Select<FlowInst>()
            .Where(a => a.tenantId == tenantId)
            .ToListAsync();
    }

    public async int UpdateCurrentNode(int id, int nodeId, long updatedAt) {
        return await this.GetExecutor().Update<FlowInst>()
            .Set(a => a.currentNodeId, nodeId)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    public async int CloseInstance(int id, long updatedAt) {
        return await this.GetExecutor().Update<FlowInst>()
            .Set(a => a.status, 2)
            .Set(a => a.currentNodeId, 0)
            .Set(a => a.updatedAt, updatedAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    public async List<FlowInst> Search(int tenantId, string kw, int limit) {
        return await this.GetExecutor().Select<FlowInst>()
            .Where(a => a.tenantId == tenantId
                && (a.title.Contains(kw) || a.bizRef.Contains(kw)))
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }
}
