using System;
using System.Collections.Generic;
using System.Data;
using ZanWeb.Dao.Flow;
using ZanWeb.Dao;
using ZanWeb.Model.Flow;
using ZanWeb.Model;

namespace ZanWeb.Modules.Flow;

/* 流程引擎：实例推进、任务落人、通知落库与实时推送的唯一实现。
   通知已迁公共层（架构 §2.2 WP-2）：Note() 转调 Notify.Send（module="flow"），
   sys_notify 落库 + NotifyHub.Push 实时推给在线者；旧 flow_notify 停止新写，
   存量行由 Schema.SeedNotify 迁入 sys_notify 后旧表只读保留。 */
class Engine {
    /* 只读展示辅助：定义/节点名查表。 */
    static string DefName(List<FlowDef> defs, int defId) {
        for (int i = 0; i < defs.Count; i = i + 1) {
            if (defs[i].id == defId) { return defs[i].name; }
        }
        return "-";
    }

    static string NodeName(List<FlowNode> nodes, int nodeId) {
        if (nodeId == 0) { return "-"; }
        for (int i = 0; i < nodes.Count; i = i + 1) {
            if (nodes[i].id == nodeId) { return nodes[i].name; }
        }
        return "-";
    }

    static string InstTitle(List<FlowInst> insts, int instId) {
        for (int i = 0; i < insts.Count; i = i + 1) {
            if (insts[i].id == instId) { return insts[i].title; }
        }
        return "-";
    }

    static string UserName(List<SysUser> users, int userId) {
        for (int i = 0; i < users.Count; i = i + 1) {
            if (users[i].id == userId) {
                return Fmt.Text(users[i].nickname, users[i].username);
            }
        }
        return "-";
    }

    /* 节点按 sort 升序（插入排序，节点数小）。 */
    static List<FlowNode> SortNodes(List<FlowNode> nodes) {
        List<FlowNode> r = new List<FlowNode>();
        for (int i = 0; i < nodes.Count; i = i + 1) {
            int at = 0;
            while (at < r.Count && r[at].sort <= nodes[i].sort) {
                at = at + 1;
            }
            r.Insert(at, nodes[i]);
        }
        return r;
    }

    /* 推进到下一节点：生成任务、按 kind 分派、通知责任人；全部节点完成则收口实例。返回新任务 id；0 = 实例已完结。 */
    static async int Advance(IDbConnection db, FlowInst inst) {
        List<FlowNode> nodes = await new FlowNodeDao(db).ByDefId(inst.defId);
        if (nodes.Count == 0) { return 0; }
        /* 按 sort 升序（内存排序，模板规模节点数小）。 */
        List<FlowNode> ordered = Engine.SortNodes(nodes);
        FlowNode next = null;
        if (inst.currentNodeId == 0) {
            next = ordered[0];
        } else {
            int at = -1;
            for (int i = 0; i < ordered.Count; i = i + 1) {
                if (ordered[i].id == inst.currentNodeId) { at = i; }
            }
            if (at < 0 || at + 1 >= ordered.Count) {
                /* 已是最后一环：收口。 */
                return 0;
            }
            next = ordered[at + 1];
        }

        int assignTo = next.assignUserId;
        /* 未指定人但有部门：落部门待认领池（assignUserId=0 + deptId 快照）
           ——部门成员经 flowclaim 认领后执行；知会部门
           负责人一声。原自动指派（落负责人/首个成员）废弃：指派语义由
           模板显式 assignUserId 承担，认领语义由池承担，两者不再混写。 */
        if (assignTo == 0 && next.deptId > 0) {
            SysDepartment dept = await new SysDepartmentDao(db).ById(next.deptId);
            if (dept != null && dept.leaderUserId > 0) {
                await Engine.Note(db, inst.tenantId, dept.leaderUserId, "assign",
                    "新待认领任务",
                    "「" + inst.title + "」→ " + next.name
                        + " 待" + dept.name + "认领",
                    "/admin/flow/tasks");
            }
        }

        FlowTask task = new FlowTask();
        task.instId = inst.id;
        task.nodeId = next.id;
        task.assignUserId = next.kind == "ai" ? 0 : assignTo;
        task.deptId = next.deptId;
        task.status = 0;
        task.result = "";
        long now = WebApp.NowSeconds();
        task.createdAt = now;
        task.finishedAt = 0;
        int taskId = await new FlowTaskDao(db).Insert(task);

        int _u = await new FlowInstDao(db).UpdateCurrentNode(inst.id, next.id, now);

        if (next.kind == "ai") {
            /* AI 节点：系统代跑——模板内置占位执行（真实接 AI 供应商属演进项），完成后自动再推进。
               同步本地 inst.currentNodeId，使递归 Advance 从「下一环」继续而非重复本环。 */
            string text = next.aiPrompt.Length > 0
                ? next.aiPrompt : next.name;
            string summary = "[AI] " + text + "（已由系统代为执行）";
            int _d = await new FlowTaskDao(db).FinishTask(taskId, summary, now);
            await Engine.Note(db, inst.tenantId, inst.startedBy, "done",
                "AI 节点完成", "AI 节点「" + next.name + "」已完成",
                "/admin/flow/instances");
            inst.currentNodeId = next.id;
            await Engine.Advance(db, inst);
            return taskId;
        }

        if (assignTo > 0) {
            await Engine.Note(db, inst.tenantId, assignTo, "assign",
                "新任务派发", "新任务：「" + inst.title + "」→ " + next.name,
                "/admin/flow/tasks");
        }
        return taskId;
    }

    /* 发起实例：写 inst 行并把第一环节跑起来。 */
    static async int Start(IDbConnection db, FlowDef def, string title,
                        string bizRef, int byUserId) {
        long now = WebApp.NowSeconds();
        FlowInst inst = new FlowInst();
        inst.tenantId = def.tenantId;
        inst.defId = def.id;
        inst.title = title;
        inst.bizRef = Fmt.Text(bizRef, "");
        inst.startedBy = byUserId;
        inst.status = 1;
        inst.currentNodeId = 0;
        inst.createdAt = now;
        inst.updatedAt = now;
        int id = await new FlowInstDao(db).Insert(inst);
        inst.id = id;
        await Engine.Advance(db, inst);
        return id;
    }

    /* 完成任务并推进；汇报文本写入任务 result 并追加流水。mentions 为逗号分隔 userId。 */
    static async bool Complete(IDbConnection db, FlowTask task, SysUser me,
                            string report, string mentions) {
        long now = WebApp.NowSeconds();
        FlowInst inst = await new FlowInstDao(db).ById(task.instId);
        if (inst == null || inst.status != 1) { return false; }

        FlowLog log = new FlowLog();
        log.taskId = task.id;
        log.userId = me.id;
        log.content = Fmt.Text(report, "完成");
        log.mentionIds = Fmt.Text(mentions, "");
        log.createdAt = now;
        await new FlowLogDao(db).Insert(log);

        if (mentions.Length > 0) {
            await Engine.NoteMentions(db, inst.tenantId, mentions,
                me.nickname + " 在「" + inst.title + "」中 @了你：" + report,
                "/admin/flow/tasks");
        }

        int _d = await new FlowTaskDao(db).FinishTask(task.id, Fmt.Text(report, "完成"), now);
        if (_d == 0) { return false; }

        await Engine.Note(db, inst.tenantId, inst.startedBy, "done",
            "环节已完成", "「" + inst.title + "」· "
                + await Engine.NodeNameOf(db, task.nodeId)
                + " 由 " + Fmt.Text(me.nickname, me.username) + " 完成",
            "/admin/flow/tasks");

        int nxt = await Engine.Advance(db, inst);
        if (nxt == 0) {
            int _f = await new FlowInstDao(db).CloseInstance(inst.id, now);
            await Engine.Note(db, inst.tenantId, inst.startedBy, "done",
                "流程完结", "流程「" + inst.title + "」已全部完成",
                "/admin/flow/instances");
        }
        return true;
    }

    /* ---- 认领 / 验收 / 驳回 ----
       Complete 保留给后台「进度汇报」直通（验收人当面同屏，无需门）；
       客户端域走 Claim→Submit→Accept/Reject：部门成员从池里认领、执行人
       提交、发起人验收，驳回即重来（原人返工或清人回部门池重新认领）。 */

    /* 认领：部门成员把池中任务落到自己名下（assignUserId 0 → me）。
       CAS 条件 UPDATE（status==0 且仍无人认领）使并发认领恰好一人成功。
       返回 false = 实例已终/非本部门/已被认领/状态不符。 */
    static async bool Claim(IDbConnection db, FlowTask task, SysUser me) {
        FlowInst inst = await new FlowInstDao(db).ById(task.instId);
        if (inst == null || inst.status != 1) { return false; }
        if (task.status != 0 || task.assignUserId != 0) { return false; }
        if (task.deptId > 0 && me.departmentId != task.deptId) { return false; }
        int _u = await new FlowTaskDao(db).ClaimTask(task.id, me.id);
        if (_u == 0) { return false; }
        FlowLog log = new FlowLog();
        log.taskId = task.id;
        log.userId = me.id;
        log.content = "认领";
        log.mentionIds = "";
        log.createdAt = WebApp.NowSeconds();
        await new FlowLogDao(db).Insert(log);
        await Engine.Note(db, inst.tenantId, inst.startedBy, "assign",
            "任务已认领", "「" + inst.title + "」· "
                + await Engine.NodeNameOf(db, task.nodeId)
                + " 由 " + Fmt.Text(me.nickname, me.username) + " 认领",
            "/admin/flow/tasks");
        return true;
    }

    /* 节点名（按 id 查一次，通知文案用；节点规模小，不值得缓存）。 */
    static async string NodeNameOf(IDbConnection db, int nodeId) {
        if (nodeId == 0) { return "-"; }
        FlowNode n = await new FlowNodeDao(db).ById(nodeId);
        return n == null ? "-" : n.name;
    }

    /* 提交验收：执行人 0→3，汇报入流水，知会发起人。
       返回 false = 实例已终/非执行人/状态不符（控制器转 403/409）。 */
    static async bool Submit(IDbConnection db, FlowTask task, SysUser me,
                           string report) {
        FlowInst inst = await new FlowInstDao(db).ById(task.instId);
        if (inst == null || inst.status != 1) { return false; }
        if (task.status != 0 || task.assignUserId != me.id) { return false; }
        long now = WebApp.NowSeconds();
        FlowLog log = new FlowLog();
        log.taskId = task.id;
        log.userId = me.id;
        log.content = "提交验收：" + Fmt.Text(report, "完成");
        log.mentionIds = "";
        log.createdAt = now;
        await new FlowLogDao(db).Insert(log);
        int _u = await new FlowTaskDao(db).SubmitForReview(task.id, Fmt.Text(report, "完成"));
        if (_u == 0) { return false; }
        await Engine.Note(db, inst.tenantId, inst.startedBy, "done",
            "待验收", "「" + inst.title + "」· "
                + await Engine.NodeNameOf(db, task.nodeId) + " 已提交验收",
            "/admin/flow/tasks");
        return true;
    }

    /* 验收通过：发起人 3→1 并推进下一环；已是最后一环则收口实例。
       状态门带乐观语义（Update 带 status==3 条件），并发验收只有一方生效。 */
    static async bool Accept(IDbConnection db, FlowTask task, SysUser me) {
        FlowInst inst = await new FlowInstDao(db).ById(task.instId);
        if (inst == null || inst.status != 1) { return false; }
        if (inst.startedBy != me.id) { return false; }
        if (task.status != 3) { return false; }
        long now = WebApp.NowSeconds();
        int _u = await new FlowTaskDao(db).AcceptReview(task.id, now);
        if (_u == 0) { return false; }
        FlowLog log = new FlowLog();
        log.taskId = task.id;
        log.userId = me.id;
        log.content = "验收通过";
        log.mentionIds = "";
        log.createdAt = now;
        await new FlowLogDao(db).Insert(log);
        await Engine.Note(db, inst.tenantId, task.assignUserId, "done",
            "验收通过", "「" + inst.title + "」· "
                + await Engine.NodeNameOf(db, task.nodeId) + " 验收通过",
            "/admin/flow/tasks");
        int nxt = await Engine.Advance(db, inst);
        if (nxt == 0) {
            int _f = await new FlowInstDao(db).CloseInstance(inst.id, now);
            await Engine.Note(db, inst.tenantId, inst.startedBy, "done",
                "流程完结", "流程「" + inst.title + "」已全部完成",
                "/admin/flow/instances");
        }
        return true;
    }

    /* 驳回重来：发起人 3→0；repool=true 同时清执行人回部门认领池
       （谁都可以再认领），false 原人返工。实例与当前节点不动——
       「是否重来、重来到哪」由验收人当场定。 */
    static async bool Reject(IDbConnection db, FlowTask task, SysUser me,
                           string reason, bool repool) {
        FlowInst inst = await new FlowInstDao(db).ById(task.instId);
        if (inst == null || inst.status != 1) { return false; }
        if (inst.startedBy != me.id) { return false; }
        if (task.status != 3) { return false; }
        long now = WebApp.NowSeconds();
        FlowLog log = new FlowLog();
        log.taskId = task.id;
        log.userId = me.id;
        log.content = "验收驳回：" + Fmt.Text(reason, "需返工");
        log.mentionIds = "";
        log.createdAt = now;
        await new FlowLogDao(db).Insert(log);
        int _r = await new FlowTaskDao(db).RejectReview(task.id, repool);
        if (_r == 0) { return false; }
        await Engine.Note(db, inst.tenantId,
            repool ? inst.startedBy : task.assignUserId, "assign",
            "验收驳回", "「" + inst.title + "」· "
                + await Engine.NodeNameOf(db, task.nodeId)
                + " 驳回重来：" + Fmt.Text(reason, "需返工"),
            "/admin/flow/tasks");
        return true;
    }

    /* 单条通知：转调公共层 Notify.Send（module="flow"，落 sys_notify + 推 NotifyHub）。
       kind 语义不变（assign/mention/done），title 为新增的一句话摘要。
       tenantId 显式传参（Notify.Send 同款纪律）：发送链路只有 db 与流程行在手，
       随 inst.tenantId 传递（#34 起实例行带租户基列）。 */
    static async bool Note(IDbConnection db, int tenantId, int userId,
                        string kind, string title, string content, string link) {
        await Notify.Send(db, tenantId, userId, "flow", kind,
            title, content, Fmt.Text(link, "/admin/flow/notifies"));
        return true;
    }

    /* @提及：按逗号分隔逐人生成 mention 通知。Bug#6（本体 A）：解析出的
       uid 须经 sys_user 校验"存在且同租户"才投递——原样直投使跨租户提及
       （t2 实例 @ t1 uid）成功写入 sys_notify（QA #42 实锤）；非本租户
       或不存在的 uid 一律忽略不投递。tenantId 为本方法既有显式入参。 */
    static async void NoteMentions(IDbConnection db, int tenantId,
                                string mentionIds, string content, string link) {
        int from = 0;
        for (int i = 0; i <= mentionIds.Length; i = i + 1) {
            if (i == mentionIds.Length || mentionIds.Substring(i, 1) == ",") {
                string one = mentionIds.Substring(from, i - from);
                if (one.Length > 0) {
                    int uid = Filter.ToInt(one, 0);
                    if (uid > 0) {
                        SysUser u = await new SysUserDao(db).ById(uid);
                        if (u != null) {
                            await Engine.Note(db, tenantId, uid, "mention",
                                "流程提及", content, link);
                        }
                    }
                }
                from = i + 1;
            }
        }
    }
}

