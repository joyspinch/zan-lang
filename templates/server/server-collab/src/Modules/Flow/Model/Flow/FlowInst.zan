using System.Data.Orm;

namespace ZanWeb.Model.Flow;

/* 流程实例：某业务对象（如一件商品、一张设计单）走一遍流程的运行记录。 */
[Table(Name = "flow_inst")]
class FlowInst {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int defId;

    /* 实例标题，如「2026秋季连衣裙上架」。 */
    [Column(StringLength = 128, IsNullable = false)]
    string title;

    /* 业务关联（可选）：如 "wms.sku:3"。 */
    [Column(StringLength = 64)]
    string bizRef;

    /* 发起人。 */
    int startedBy;

    /* 1 进行中 / 2 已完成 / 3 已终止。 */
    int status;

    /* 当前所在节点 id；0 = 未开始/已结束。 */
    int currentNodeId;

    long createdAt;

    long updatedAt;
}
