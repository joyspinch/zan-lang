using System.Data.Orm;

namespace ZanWeb.Model.Flow;

/* 流程定义：一个可复用的任务流程模板（如「商品上架」「设计出图」），由有序节点组成。 */
[Table(Name = "flow_def")]
class FlowDef {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    [Column(StringLength = 256)]
    string description;

    /* 1 启用 / 0 停用；停用后不能再发起新实例，进行中的实例照常走完。 */
    int status;

    long createdAt;

    long updatedAt;
}
