using System.Data.Orm;

namespace ZanWeb.Model.Flow;

/* 流程节点：定义里的一个环节；按 sort 顺序流转。负责人二选一：指定员工(assignUserId)直接落任务，或只给部门(deptId)；kind 决定执行者——human 人工 / ai 调用 AI 能力（如做图、生成文案）。 */
[Table(Name = "flow_node")]
class FlowNode {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int defId;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    /* 顺序，从 1 开始。 */
    int sort;

    /* 责任部门。 */
    int deptId;

    /* 指定员工 id；0 = 未指定（按部门落任务）。 */
    int assignUserId;

    /* human / ai。 */
    [Column(StringLength = 16)]
    string kind;

    /* ai 节点的任务指令（提示词模板）。 */
    [Column(StringLength = 512)]
    string aiPrompt;

    long createdAt;
}
