using System.Data.Orm;

namespace ZanWeb.Model.Flow;

/* 进度汇报流水：任务执行过程中的每次汇报，只 INSERT 不 UPDATE——过程可追溯，符合「流水只增不改」纪律。 */
[Table(Name = "flow_log")]
class FlowLog {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int taskId;

    /* 汇报人。 */
    int userId;

    [Column(StringLength = 512, IsNullable = false)]
    string content;

    /* 汇报时提及的相关责任人（逗号分隔 userId），每人生成一条 mention 通知。 */
    [Column(StringLength = 128)]
    string mentionIds;

    long createdAt;
}
