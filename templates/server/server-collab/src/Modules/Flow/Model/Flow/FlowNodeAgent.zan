using System.Data.Orm;

namespace ZanWeb.Model.Flow;

/* 流程节点的 AI 工具分配：一个 AI 节点可绑多个智能体（工具）。
   priority 定**高可用顺序**（数字小优先）：派发时按序试，第一个失败
   自动降级到下一个，不因为单个工具不可用就卡住整个流程。
   enabled=0 是停用不删——工具配置要能随时下线又随时恢复。 */
[Table(Name = "flow_node_agent")]
public class FlowNodeAgent {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 流程定义 id（冗余一份：按流程查分配不必先捞节点链）。 */
    int defId;

    /* 流程节点 id（flow_node.id）。 */
    int nodeId;

    /* 智能体 code（ZanWeb.Ai 的助手 code，如 build / ops）。 */
    [Column(StringLength = 64, IsNullable = false)]
    string agentCode;

    /* 高可用顺序：从 1 起，数字小优先。 */
    int priority;

    /* 1 启用 / 0 停用。 */
    int enabled;

    /* 备注：为什么这个工具排在这个位置（主用 / 兜底）。 */
    [Column(StringLength = 128)]
    string note;

    int createdBy;

    long createdAt;

    long updatedAt;
}
