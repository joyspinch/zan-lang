using System.Data.Orm;

namespace ZanWeb.Model.Flow;

/* AI 工具的健康状态（按智能体 code 一行）。
   派发失败累加 failures；连续失败达阈值转 degraded 并进入冷却，
   冷却期内不再被优先选中；成功一次即归零回 healthy。状态落库而不是
   只放内存：服务端是多 worker 进程，内存里的健康视图各 worker 不
   共享，降级决策会各说各话。 */
[Table(Name = "flow_agent_health")]
public class FlowAgentHealth {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 智能体 code。 */
    [Column(StringLength = 64, IsNullable = false)]
    string agentCode;

    /* healthy / degraded / down。 */
    [Column(StringLength = 16)]
    string state;

    /* 连续失败次数；成功一次归零。 */
    int failures;

    /* 最近一次失败的错误文案（排障用）。 */
    [Column(StringLength = 255)]
    string lastError;

    long lastOkAt;

    long lastFailAt;

    /* 冷却到点前不再被选中（降级期间）。 */
    long cooldownUntil;

    long updatedAt;
}
