using System.Data.Orm;

namespace ZanWeb.Model.Flow;

/* 流程任务：流转到某节点时落给具体员工的待办；ai 节点由系统代跑，assignUserId=0。 */
[Table(Name = "flow_task")]
class FlowTask {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int instId;

    [Column(IsNullable = false)]
    int nodeId;

    /* 责任人；0 = AI 节点（系统执行）。 */
    int assignUserId;

    /* 0 待处理 / 1 已完成 / 2 已跳过。 */
    int status;

    /* 完成时的汇报文本（进度汇报的终态摘要）。 */
    [Column(StringLength = 512)]
    string result;

    long createdAt;

    long finishedAt;
}
