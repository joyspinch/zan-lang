using System.Data.Orm;

namespace ZanWeb.Model.Flow;

/* 流程任务：流转到某节点时落给具体员工的待办；ai 节点由系统代跑，assignUserId=0。
   状态机（A327-14 工作流化后）：0 待处理（含部门池待认领）→ 3 待验收 →
   1 已完成（验收通过，引擎随即推进下一环）/ 回 0（驳回重来）；
   2 已跳过（保留）。 */
[Table(Name = "flow_task")]
class FlowTask {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int instId;

    [Column(IsNullable = false)]
    int nodeId;

    /* 责任人；0 = AI 节点（系统执行）或待认领（部门池）。 */
    int assignUserId;

    /* 节点责任部门快照（建任务时自 node.deptId 抄）：待认领池的
       单表查询就够（assignUserId=0 且 deptId=我部门）；子表不补
       租户列的纪律不变——deptId 只服务认领匹配，不承载隔离语义。 */
    int deptId;

    /* 0 待处理 / 1 已完成 / 2 已跳过 / 3 待验收。 */
    int status;

    /* 完成时的汇报文本（进度汇报的终态摘要）。 */
    [Column(StringLength = 512)]
    string result;

    long createdAt;

    long finishedAt;
}
