using System.Data.Orm;

namespace ZanWeb.Model.Flow;

/* 流程通知：流转事件的落库记录（铃铛未读数与历史查询的数据源），实时推送走 SSE 流。 */
[Table(Name = "flow_notify")]
class FlowNotify {
    [Column(IsIdentity = true)]
    int id;

    /* 接收人。 */
    int userId;

    /* 事件类型：assign 派给你 / mention 汇报提及 / done 流程完结。 */
    [Column(StringLength = 16)]
    string kind;

    [Column(StringLength = 256, IsNullable = false)]
    string content;

    /* 跳转目标，如 /admin/flow/tasks */
    [Column(StringLength = 128)]
    string link;

    /* 0 未读 / 1 已读。 */
    int isRead;

    long createdAt;
}
