using System;
using System.Collections.Generic;
using System.Data.Orm;
using System.Json;
using System.Text;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Api;
using Zan.Web.Dao.Lifecycle;
using Zan.Web.Model.Lifecycle;
using Zan.Web.Model;

namespace Zan.Web.Admin.Lifecycle;

/* 全生命周期业务配置模板管理：模板 CRUD + 阶段工序元数据子表弹窗。 */
[Route("admin/lifecycle/templates/[action]")]
[Custom(Authorization = CustomAuthorization.Login)]
[Description("业务模板管理")]
public class Templates : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .TbarAdd("新建模板", "/admin/lifecycle/templates/form")
            .TbarCustom("注入官方模板", "/admin/lifecycle/templates/seed", "确认初始化/补齐官方标准全生命周期模板吗？")
            .Col("id", "ID", "num", "75")
            .Col("templateKey", "模板 Key", "text", "150")
            .Col("name", "模板名称", "text", "200")
            .Col("category", "行业/品类", "text", "120")
            .Col("stageCount", "阶段数", "num", "85")
            .Tag("isDefault", "默认推荐", "1=默认推荐|ok,0=普通|off", "95")
            .Col("description", "说明", "text", "240")
            .OpsEdit("/admin/lifecycle/templates/form")
            .Ops("配置阶段工序", "/admin/lifecycle/templates/stages", "", "templateId={id}", "");
    }

    static ListPage StagesDef() {
        return ListPage.Of()
            .TbarAdd("新增阶段工序", "/admin/lifecycle/templates/stages/form")
            .Col("seq", "顺序", "num", "75")
            .Col("stageKey", "阶段 Key", "text", "130")
            .Col("stageName", "阶段名称", "text", "150")
            .Col("aiRole", "默认 AI 角色", "text", "140")
            .Col("m1", "考核指标 1", "text", "150")
            .Col("m2", "考核指标 2", "text", "150")
            .Col("m3", "考核指标 3", "text", "150")
            .OpsEdit("/admin/lifecycle/templates/stages/form")
            .OpsDel("/admin/lifecycle/templates/stages/delete", "确认删除该阶段工序定义吗？");
    }

    [HttpGet]
    [Route("/admin/lifecycle/templates")]
    [Custom(IsMenu = true, Icon = "mdi:shape-outline", Perm = PermBit.View)]
    [Description("业务模板管理")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Description("业务模板表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Templates.ScreenDef());
    }

    [HttpPost]
    [Description("业务模板列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        int tid = Tenant.Cur();
        List<LifecycleTemplate> tmpls = await this.LifecycleTemplate
            .Where(a => a.tenantId == tid)
            .OrderBy(a => a.id).ToListAsync();
        if (tmpls.Count == 0) {
            await LifecycleTemplateApi.SeedDefaultTemplates(this, tid);
            tmpls = await this.LifecycleTemplate
                .Where(a => a.tenantId == tid)
                .OrderBy(a => a.id).ToListAsync();
        }
        List<LifecycleStageDef> allDefs = await this.LifecycleStageDef
            .Where(a => a.tenantId == tid).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < tmpls.Count; i = i + 1) {
            LifecycleTemplate t = tmpls[i];
            int sc = 0;
            for (int k = 0; k < allDefs.Count; k = k + 1) {
                if (allDefs[k].templateId == t.id) { sc = sc + 1; }
            }
            w.WriteStartObject();
            w.WriteProperty("id", t.id);
            w.WriteProperty("templateKey", t.templateKey);
            w.WriteProperty("name", t.name);
            w.WriteProperty("category", Fmt.Dash(t.category));
            w.WriteProperty("stageCount", sc);
            w.WriteProperty("isDefault", Convert.ToString(t.isDefault));
            w.WriteProperty("description", Fmt.Dash(t.description));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, tmpls.Count, w.ToString());
    }

    [HttpPut]
    [Description("业务模板表单配置")]
    public void FormConf() {
        FormPage fp = FormPage.Of("/admin/lifecycle/templates/save")
            .Text("模板名称", "name").Req().Ph("例如：电商新品爆品孵化标准流")
            .Text("模板标识 Key", "templateKey").Req().Ph("例如：ec_new_product")
            .Text("行业/品类", "category").Val("通用").Ph("例如：3C / 美妆 / 通用")
            .Select("是否默认推荐", "isDefault", "0=普通,1=默认推荐").Val("0")
            .Area("模板说明", "description").Span().Ph("说明适用业务场景");
        CrudOps.FormConf(this, fp, "业务模板");
    }

    [HttpPost]
    [Description("业务模板编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        LifecycleTemplate t = await this.LifecycleTemplate
            .Where(a => a.id == id && a.tenantId == Tenant.Cur()).FirstAsync();
        if (t == null) { this.Fail(404, "0404", "模板不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", t.id);
        w.WriteProperty("name", t.name);
        w.WriteProperty("templateKey", t.templateKey);
        w.WriteProperty("category", t.category);
        w.WriteProperty("description", t.description);
        w.WriteProperty("isDefault", Convert.ToString(t.isDefault));
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Description("初始化官方模板")]
    async void Seed() {
        int tid = Tenant.Cur();
        await LifecycleTemplateApi.SeedDefaultTemplates(this, tid);
        this.Saved("官方标准全生命周期业务模板已成功注入！");
    }

    [HttpPost]
    [Description("保存业务模板")]
    async void Save() {
        int tid = Tenant.Cur();
        int id = this.InAnyInt("id", 0);
        string name = this.NeedAny("name", "模板名称");
        string templateKey = this.NeedAny("templateKey", "模板标识Key");
        string category = this.InAny("category");
        if (category.Length == 0) { category = "通用"; }
        string description = this.InAny("description");
        int isDefault = this.InAnyInt("isDefault", 0);
        long now = WebApp.NowSeconds();

        if (id > 0) {
            LifecycleTemplate tmpl = await this.LifecycleTemplate
                .Where(a => a.id == id && a.tenantId == tid).FirstAsync();
            if (tmpl == null) { this.Fail(404, "0404", "模板不存在"); return; }
            tmpl.name = name;
            tmpl.templateKey = templateKey;
            tmpl.category = category;
            tmpl.description = description;
            tmpl.isDefault = isDefault;
            tmpl.updatedAt = now;
            await this.LifecycleTemplate.Update(tmpl).ExecuteAffrowsAsync();
            this.Saved("业务模板已更新");
        } else {
            LifecycleTemplate tmpl = new LifecycleTemplate();
            tmpl.tenantId = tid;
            tmpl.name = name;
            tmpl.templateKey = templateKey;
            tmpl.category = category;
            tmpl.description = description;
            tmpl.isDefault = isDefault;
            tmpl.status = "active";
            tmpl.createdAt = now;
            tmpl.updatedAt = now;
            await this.LifecycleTemplate.Insert(tmpl).ExecuteIdentityAsync();
            this.Saved("新业务模板创建成功");
        }
    }

    /* ---- 阶段工序子表（SubTableModal）---- */

    [HttpGet]
    [Description("阶段工序配置")]
    void Stages() {
        this.StagesConf();
    }

    [HttpPut]
    [Route("/admin/lifecycle/templates/stages/conf")]
    [Description("阶段工序表格配置")]
    public void StagesConf() {
        CrudOps.Conf(this, Templates.StagesDef());
    }

    [HttpPost]
    [Route("/admin/lifecycle/templates/stages/list")]
    [Description("阶段工序列表数据")]
    public async void StagesList() {
        if (!this.DataReady()) { return; }
        int templateId = this.InAnyInt("templateId", 0);
        List<LifecycleStageDef> defs = await this.LifecycleStageDef
            .Where(a => a.templateId == templateId)
            .OrderBy(a => a.seq).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < defs.Count; i = i + 1) {
            LifecycleStageDef s = defs[i];
            w.WriteStartObject();
            w.WriteProperty("id", s.id);
            w.WriteProperty("templateId", s.templateId);
            w.WriteProperty("seq", s.seq);
            w.WriteProperty("stageKey", s.stageKey);
            w.WriteProperty("stageName", s.stageName);
            w.WriteProperty("aiRole", Fmt.Dash(s.defaultAiAgentRole));
            w.WriteProperty("m1", s.metric1Name + " (" + s.metric1Default + ")");
            w.WriteProperty("m2", s.metric2Name + " (" + s.metric2Default + ")");
            w.WriteProperty("m3", s.metric3Name + " (" + s.metric3Default + ")");
            w.WriteProperty("prompt", Fmt.Dash(s.aiPromptTemplate));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, defs.Count, w.ToString());
    }

    [HttpPut]
    [Route("/admin/lifecycle/templates/stages/formconf")]
    [Description("阶段工序表单配置")]
    public void StagesFormConf() {
        FormPage fp = FormPage.Of("/admin/lifecycle/templates/savestage")
            .Wide()
            .Text("阶段标识 Key", "stageKey").Req().Ph("例如：selection / design / launch")
            .Text("阶段名称", "stageName").Req().Ph("例如：爆品选品 / 视觉设计")
            .Num("流转顺序号", "seq").Val("10")
            .Text("默认 AI 角色", "defaultAiAgentRole").Val("协同AI")
            .Text("考核指标1名称", "metric1Name")
            .Text("考核指标1默认值", "metric1Default")
            .Text("考核指标2名称", "metric2Name")
            .Text("考核指标2默认值", "metric2Default")
            .Text("考核指标3名称", "metric3Name")
            .Text("考核指标3默认值", "metric3Default")
            .Area("AI 推演提示词", "aiPromptTemplate").Span().Ph("阶段 AI 协同分析提示词模板");
        CrudOps.FormConf(this, fp, "阶段工序");
    }

    [HttpPost]
    [Route("/admin/lifecycle/templates/stages/edit")]
    [Description("阶段工序编辑回显")]
    public async void StagesEdit() {
        int id = this.InAnyInt("id", 0);
        LifecycleStageDef s = await this.LifecycleStageDef
            .Where(a => a.id == id && a.tenantId == Tenant.Cur()).FirstAsync();
        if (s == null) { this.Fail(404, "0404", "阶段工序不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", s.id);
        w.WriteProperty("templateId", s.templateId);
        w.WriteProperty("stageKey", s.stageKey);
        w.WriteProperty("stageName", s.stageName);
        w.WriteProperty("seq", s.seq);
        w.WriteProperty("defaultAiAgentRole", s.defaultAiAgentRole);
        w.WriteProperty("metric1Name", s.metric1Name);
        w.WriteProperty("metric1Default", s.metric1Default);
        w.WriteProperty("metric2Name", s.metric2Name);
        w.WriteProperty("metric2Default", s.metric2Default);
        w.WriteProperty("metric3Name", s.metric3Name);
        w.WriteProperty("metric3Default", s.metric3Default);
        w.WriteProperty("aiPromptTemplate", s.aiPromptTemplate);
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Description("保存阶段工序")]
    async void SaveStage() {
        int tid = Tenant.Cur();
        int id = this.InAnyInt("id", 0);
        int templateId = this.NeedAnyInt("templateId", "模板ID");
        string stageKey = this.NeedAny("stageKey", "阶段标识Key");
        string stageName = this.NeedAny("stageName", "阶段展示名");
        int seq = this.InAnyInt("seq", 10);
        string aiRole = this.InAny("defaultAiAgentRole");
        if (aiRole.Length == 0) { aiRole = "协同AI"; }
        string m1Name = this.InAny("metric1Name");
        string m1Def = this.InAny("metric1Default");
        string m2Name = this.InAny("metric2Name");
        string m2Def = this.InAny("metric2Default");
        string m3Name = this.InAny("metric3Name");
        string m3Def = this.InAny("metric3Default");
        string prompt = this.InAnyRaw("aiPromptTemplate");
        long now = WebApp.NowSeconds();

        if (id > 0) {
            LifecycleStageDef def = await this.LifecycleStageDef
                .Where(a => a.id == id && a.templateId == templateId).FirstAsync();
            if (def == null) { this.Fail(404, "0404", "阶段工序不存在"); return; }
            def.stageKey = stageKey;
            def.stageName = stageName;
            def.seq = seq;
            def.defaultAiAgentRole = aiRole;
            def.metric1Name = m1Name;
            def.metric1Default = m1Def;
            def.metric2Name = m2Name;
            def.metric2Default = m2Def;
            def.metric3Name = m3Name;
            def.metric3Default = m3Def;
            def.aiPromptTemplate = prompt;
            def.updatedAt = now;
            await this.LifecycleStageDef.Update(def).ExecuteAffrowsAsync();
            this.Saved("阶段工序定义已更新");
        } else {
            LifecycleStageDef def = new LifecycleStageDef();
            def.tenantId = tid;
            def.templateId = templateId;
            def.stageKey = stageKey;
            def.stageName = stageName;
            def.seq = seq;
            def.defaultAiAgentRole = aiRole;
            def.metric1Name = m1Name;
            def.metric1Default = m1Def;
            def.metric2Name = m2Name;
            def.metric2Default = m2Def;
            def.metric3Name = m3Name;
            def.metric3Default = m3Def;
            def.aiPromptTemplate = prompt;
            def.createdAt = now;
            def.updatedAt = now;
            await this.LifecycleStageDef.Insert(def).ExecuteIdentityAsync();
            this.Saved("新阶段工序定义已追加");
        }
    }

    [HttpPost]
    [Route("/admin/lifecycle/templates/stages/delete")]
    [Description("删除阶段工序")]
    async void DeleteStage() {
        int id = this.InAnyInt("id", 0);
        int n = await this.LifecycleStageDef.Delete()
            .Where(a => a.id == id && a.tenantId == Tenant.Cur()).ExecuteAffrowsAsync();
        if (n <= 0) { this.Fail(404, "0404", "阶段工序不存在"); return; }
        this.Saved("阶段工序已删除");
    }
}
