using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Lifecycle;

namespace Zan.Web.Dao.Lifecycle;

/* LifecycleTemplate 强类型数据访问网关 */
public class LifecycleTemplateDao : BaseRepository<LifecycleTemplate> {
    public LifecycleTemplateDao() : base() {}
    public LifecycleTemplateDao(IZanSql fsql) : base(fsql) {}
    public LifecycleTemplateDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public InsertQuery<LifecycleTemplate> Insert(LifecycleTemplate entity) {
        return this.GetExecutor().Insert<LifecycleTemplate>(entity);
    }

    public async LifecycleTemplate ById(int id) {
        return await this.GetExecutor().Select<LifecycleTemplate>().Where(a => a.id == id).FirstAsync();
    }

    public async LifecycleTemplate DefaultTemplate(int tenantId) {
        return await this.GetExecutor().Select<LifecycleTemplate>()
            .Where(a => a.tenantId == tenantId && a.isDefault == 1 && a.status == "active")
            .FirstAsync();
    }

    public async List<LifecycleTemplate> AllActive(int tenantId) {
        return await this.GetExecutor().Select<LifecycleTemplate>()
            .Where(a => a.tenantId == tenantId && a.status == "active")
            .OrderByDescending(a => a.isDefault)
            .OrderBy(a => a.id)
            .ToListAsync();
    }
}
