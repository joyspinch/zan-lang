using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Lifecycle;

namespace Zan.Web.Dao.Lifecycle;

/* LifecycleNode 强类型数据访问网关 */
public class LifecycleNodeDao : BaseRepository<LifecycleNode> {
    public LifecycleNodeDao() : base() {}
    public LifecycleNodeDao(IZanSql fsql) : base(fsql) {}
    public LifecycleNodeDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public InsertQuery<LifecycleNode> Insert(LifecycleNode entity) {
        return this.GetExecutor().Insert<LifecycleNode>(entity);
    }

    public async LifecycleNode ById(int id) {
        return await this.GetExecutor().Select<LifecycleNode>().Where(a => a.id == id).FirstAsync();
    }

    public async List<LifecycleNode> ByProjectId(int projectId) {
        return await this.GetExecutor().Select<LifecycleNode>().Where(a => a.projectId == projectId).OrderBy(a => a.id).ToListAsync();
    }

    public async LifecycleNode ByProjectAndStage(int projectId, string stage) {
        return await this.GetExecutor().Select<LifecycleNode>().Where(a => a.projectId == projectId && a.stage == stage).FirstAsync();
    }
}
