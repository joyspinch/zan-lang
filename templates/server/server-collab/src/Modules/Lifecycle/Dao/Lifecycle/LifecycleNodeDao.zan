using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Lifecycle;

namespace ZanWeb.Dao.Lifecycle;

/* LifecycleNode 强类型数据访问网关 */
public class LifecycleNodeDao : BaseRepository<LifecycleNode> {
    LifecycleNodeDao(IZanSql fsql) : base(fsql) {}
    LifecycleNodeDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async LifecycleNode ById(int id) {
        return await this.GetExecutor().Select<LifecycleNode>().Where(a => a.id == id).FirstAsync();
    }

    async List<LifecycleNode> ByProjectId(int projectId) {
        return await this.GetExecutor().Select<LifecycleNode>().Where(a => a.projectId == projectId).OrderBy(a => a.id).ToListAsync();
    }

    async LifecycleNode ByProjectAndStage(int projectId, string stage) {
        return await this.GetExecutor().Select<LifecycleNode>().Where(a => a.projectId == projectId && a.stage == stage).FirstAsync();
    }
}
