using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Lifecycle;

namespace ZanWeb.Dao.Lifecycle;

/* LifecycleStageDetail 强类型数据访问网关 */
public class LifecycleStageDetailDao : BaseRepository<LifecycleStageDetail> {
    LifecycleStageDetailDao(IZanSql fsql) : base(fsql) {}
    LifecycleStageDetailDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async LifecycleStageDetail ByNodeId(int nodeId) {
        return await this.GetExecutor().Select<LifecycleStageDetail>().Where(a => a.nodeId == nodeId).FirstAsync();
    }

    async List<LifecycleStageDetail> ByProjectId(int projectId) {
        return await this.GetExecutor().Select<LifecycleStageDetail>().Where(a => a.projectId == projectId).OrderBy(a => a.id).ToListAsync();
    }
}
