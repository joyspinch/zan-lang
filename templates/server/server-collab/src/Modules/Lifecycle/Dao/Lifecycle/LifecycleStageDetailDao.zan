using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Lifecycle;

namespace Zan.Web.Dao.Lifecycle;

/* LifecycleStageDetail 强类型数据访问网关 */
public class LifecycleStageDetailDao : BaseRepository<LifecycleStageDetail> {
    public LifecycleStageDetailDao() : base() {}
    public LifecycleStageDetailDao(IZanSql fsql) : base(fsql) {}
    public LifecycleStageDetailDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public InsertQuery<LifecycleStageDetail> Insert(LifecycleStageDetail entity) {
        return this.GetExecutor().Insert<LifecycleStageDetail>(entity);
    }

    public async LifecycleStageDetail ByNodeId(int nodeId) {
        return await this.GetExecutor().Select<LifecycleStageDetail>().Where(a => a.nodeId == nodeId).FirstAsync();
    }

    public async List<LifecycleStageDetail> ByProjectId(int projectId) {
        return await this.GetExecutor().Select<LifecycleStageDetail>().Where(a => a.projectId == projectId).OrderBy(a => a.id).ToListAsync();
    }
}
