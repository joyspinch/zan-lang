using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Lifecycle;

namespace ZanWeb.Dao.Lifecycle;

/* LifecycleProject 强类型数据访问网关 */
public class LifecycleProjectDao : BaseRepository<LifecycleProject> {
    LifecycleProjectDao(IZanSql fsql) : base(fsql) {}
    LifecycleProjectDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async LifecycleProject ById(int id) {
        return await this.GetExecutor().Select<LifecycleProject>().Where(a => a.id == id).FirstAsync();
    }

    async List<LifecycleProject> All() {
        return await this.GetExecutor().Select<LifecycleProject>().OrderByDescending(a => a.id).ToListAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<LifecycleProject>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
