using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Lifecycle;

namespace Zan.Web.Dao.Lifecycle;

/* LifecycleProject 强类型数据访问网关 */
public class LifecycleProjectDao : BaseRepository<LifecycleProject> {
    public LifecycleProjectDao() : base() {}
    public LifecycleProjectDao(IZanSql fsql) : base(fsql) {}
    public LifecycleProjectDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public InsertQuery<LifecycleProject> Insert(LifecycleProject entity) {
        return this.GetExecutor().Insert<LifecycleProject>(entity);
    }

    public async LifecycleProject ById(int id) {
        return await this.GetExecutor().Select<LifecycleProject>().Where(a => a.id == id).FirstAsync();
    }

    public async List<LifecycleProject> All() {
        return await this.GetExecutor().Select<LifecycleProject>().OrderByDescending(a => a.id).ToListAsync();
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<LifecycleProject>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
