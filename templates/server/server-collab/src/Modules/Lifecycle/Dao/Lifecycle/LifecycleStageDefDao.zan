using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Lifecycle;

namespace ZanWeb.Dao.Lifecycle;

/* LifecycleStageDef 强类型数据访问网关 */
public class LifecycleStageDefDao : BaseRepository<LifecycleStageDef> {
    LifecycleStageDefDao(IZanSql fsql) : base(fsql) {}
    LifecycleStageDefDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async List<LifecycleStageDef> ByTemplateId(int templateId) {
        return await this.GetExecutor().Select<LifecycleStageDef>()
            .Where(a => a.templateId == templateId)
            .OrderBy(a => a.seq)
            .ToListAsync();
    }

    async LifecycleStageDef ByKey(int templateId, string stageKey) {
        return await this.GetExecutor().Select<LifecycleStageDef>()
            .Where(a => a.templateId == templateId && a.stageKey == stageKey)
            .FirstAsync();
    }
}
