using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Lifecycle;

namespace Zan.Web.Dao.Lifecycle;

/* LifecycleStageDef 强类型数据访问网关 */
public class LifecycleStageDefDao : BaseRepository<LifecycleStageDef> {
    public LifecycleStageDefDao() : base() {}
    public LifecycleStageDefDao(IZanSql fsql) : base(fsql) {}
    public LifecycleStageDefDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public InsertQuery<LifecycleStageDef> Insert(LifecycleStageDef entity) {
        return this.GetExecutor().Insert<LifecycleStageDef>(entity);
    }

    public async List<LifecycleStageDef> ByTemplateId(int templateId) {
        return await this.GetExecutor().Select<LifecycleStageDef>()
            .Where(a => a.templateId == templateId)
            .OrderBy(a => a.seq)
            .ToListAsync();
    }

    public async LifecycleStageDef ByKey(int templateId, string stageKey) {
        return await this.GetExecutor().Select<LifecycleStageDef>()
            .Where(a => a.templateId == templateId && a.stageKey == stageKey)
            .FirstAsync();
    }
}
