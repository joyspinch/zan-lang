using System.Data.Orm;

namespace ZanWeb.Model.Lifecycle;

/* 全生命周期阶段业务明细数据：
   针对选品、生产、上架、推广、优化五大阶段的专业指标与方案大文本进行结构化持久化。 */
[Table(Name = "lifecycle_stage_detail")]
[Index(Name = "ix_lifecycle_detail_node", Fields = "tenantId,projectId,stage")]
public class LifecycleStageDetail {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户软隔离 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    int projectId;

    int nodeId;

    /* stage: selection | manufacturing | publishing | marketing | optimization */
    [Column(StringLength = 32, IsNullable = false)]
    string stage;

    /* 业务指标1: 选品(建议零售价) / 生产(排产周期) / 上架(主打渠道) / 推广(预算额度) / 优化(退货率) */
    [Column(StringLength = 64)]
    string metric1;

    /* 业务指标2: 选品(BOM目标成本) / 生产(计划良品率) / 上架(库存配比) / 推广(保底ROI) / 优化(追加翻单数) */
    [Column(StringLength = 64)]
    string metric2;

    /* 业务指标3: 选品(首批试产件数) / 生产(主料耗损率) / 上架(主推卖点) / 推广(达人梯队) / 优化(改版计划) */
    [Column(StringLength = 128)]
    string metric3;

    /* 完整业务方案大文本 (含 AI 生成的完整文案、脚本、物料清单、排期表) */
    [Column(StringLength = 4096)]
    string extraPayload;

    long createdAt;

    long updatedAt;
}
