using System.Data.Orm;

namespace Zan.Web.Model.Lifecycle;

/* 全生命周期阶段节点：
   记录特定阶段的人类第一责任人、AI 专属角色、阶段状态、交付物摘要、AI 建议及审核记录。 */
[Table(Name = "lifecycle_node")]
[Index(Name = "ix_lifecycle_node_prj", Fields = "tenantId,projectId,stage")]
public class LifecycleNode {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户软隔离 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 关联的项目 ID */
    int projectId;

    /* 阶段标识: 动态匹配 stageKey (如 selection, manufacturing ...) */
    [Column(StringLength = 64, IsNullable = false)]
    string stage;

    /* 阶段名称 */
    [Column(StringLength = 128, IsNullable = false)]
    string stageName;

    /* 阶段流转排序号 (升序排列，用于动态自动推导下一流转阶段) */
    int seq;

    /* 阶段人类第一责任人 */
    int responsibleUserId;

    /* 辅助该阶段的专属 AI 角色 */
    [Column(StringLength = 64)]
    string aiAgentRole;

    /* 节点状态: pending(未开始) | in_progress(执行中) | review(待审核) | passed(已核准通过) | rejected(被驳回) */
    [Column(StringLength = 16, IsNullable = false)]
    string status;

    /* 阶段产出交付物摘要或人工审核结论 */
    [Column(StringLength = 2048)]
    string deliverableSummary;

    /* AI 协同建议（选品测算分析/排产物料BOM/多渠道文案脚本/客诉与转化归因报告） */
    [Column(StringLength = 2048)]
    string aiSuggestion;

    /* 审核人 ID */
    int approvedBy;

    /* 审核/通过时间 (Unix秒) */
    long approvedAt;

    long createdAt;

    long updatedAt;
}
