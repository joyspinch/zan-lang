using System.Data.Orm;

namespace Zan.Web.Model.Lifecycle;

/* 全生命周期业务模板配置主表：
   定义企业各品类/业务线的生命周期流转模板（如服饰快反爆款、通用标品研产销等）。 */
[Table(Name = "lifecycle_template")]
[Index(Name = "ix_lifecycle_tmpl", Fields = "tenantId,status,isDefault")]
public class LifecycleTemplate {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户软隔离 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 模板唯一标识 Key，例如 clothing_fast_fashion / standard_ecommerce */
    [Column(StringLength = 64, IsNullable = false)]
    string templateKey;

    /* 模板名称，例如 "服饰快反爆款全链路模板" */
    [Column(StringLength = 128, IsNullable = false)]
    string name;

    /* 适用业务品类，例如 "服装鞋包" / "3C数码" / "通用" */
    [Column(StringLength = 64)]
    string category;

    /* 模板详细描述与业务适用场景说明 */
    [Column(StringLength = 512)]
    string description;

    /* 是否为租户默认推荐模板 (1: 是, 0: 否) */
    int isDefault;

    /* 状态: active(启用) | disabled(停用) */
    [Column(StringLength = 16, IsNullable = false)]
    string status = "active";

    long createdAt;

    long updatedAt;
}
