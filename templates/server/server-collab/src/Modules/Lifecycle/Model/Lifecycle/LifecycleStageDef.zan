using System.Data.Orm;

namespace Zan.Web.Model.Lifecycle;

/* 全生命周期阶段元数据定义表：
   归属特定业务模板，定义流转顺序、专属 AI 角色、指标规范与默认建议模板，零硬编码。 */
[Table(Name = "lifecycle_stage_def")]
[Index(Name = "ix_lifecycle_stagedef", Fields = "tenantId,templateId,seq")]
public class LifecycleStageDef {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户软隔离 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 关联的模板 ID */
    int templateId;

    /* 阶段标识，例如 selection / manufacturing / publishing / marketing / optimization */
    [Column(StringLength = 64, IsNullable = false)]
    string stageKey;

    /* 阶段展示名称，例如 "1.企划与选品" */
    [Column(StringLength = 128, IsNullable = false)]
    string stageName;

    /* 流转排序号 (例如 10, 20, 30, 40, 50)，流转推进时按 seq 严格升序推导下一阶段 */
    int seq;

    /* 默认协同 AI 角色名，例如 "选品分析师Agent" */
    [Column(StringLength = 64)]
    string defaultAiAgentRole;

    /* 默认 AI 建议提示模版或业务推演规则模板 */
    [Column(StringLength = 2048)]
    string aiPromptTemplate;

    /* 阶段关键指标 1 名称与默认/基线值规范 */
    [Column(StringLength = 64)]
    string metric1Name;

    [Column(StringLength = 64)]
    string metric1Default;

    /* 阶段关键指标 2 名称与默认/基线值规范 */
    [Column(StringLength = 64)]
    string metric2Name;

    [Column(StringLength = 64)]
    string metric2Default;

    /* 阶段关键指标 3 名称与默认/基线值规范 */
    [Column(StringLength = 64)]
    string metric3Name;

    [Column(StringLength = 64)]
    string metric3Default;

    long createdAt;

    long updatedAt;
}
