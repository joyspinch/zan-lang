using System.Data.Orm;

namespace ZanWeb.Model.Lifecycle;

/* 全生命周期协同项目：
   覆盖企划选品、车间生产、电商上架、全域推广、经营优化全流程。
   每一个项目绑定专属作战群(CollabConversation)，各阶段严格责任到人，AI 全程协同赋能。 */
[Table(Name = "lifecycle_project")]
[Index(Name = "ix_lifecycle_prj_st", Fields = "tenantId,currentStage,status")]
public class LifecycleProject {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户软隔离 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 项目编号，例如 PRJ-2026-001 */
    [Column(StringLength = 32, IsNullable = false)]
    string projectNo;

    /* 项目名称，例如 "2026秋冬加绒休闲裤" */
    [Column(StringLength = 128, IsNullable = false)]
    string name;

    /* 品类归属，例如 "服装鞋包" */
    [Column(StringLength = 64)]
    string category;

    /* 绑定的生命周期业务配置模板 ID */
    int templateId;

    /* 当前阶段: 动态匹配 stageKey (如 selection, manufacturing ...) 或 completed(归档) */
    [Column(StringLength = 64, IsNullable = false)]
    string currentStage;

    /* 状态: active(正常推进) | warning(风险预警) | blocked(流程阻塞) | completed(已达成归档) */
    [Column(StringLength = 16, IsNullable = false)]
    string status;

    /* 项目总负责人 (项目操盘手/总监) */
    int ownerId;

    /* 关联的项目专属作战协同群 ID (CollabConversation) */
    int conversationId;

    /* 目标 GMV 预期 (元) */
    [Column(StringLength = 32)]
    string targetGmv;

    /* 目标 ROI 预期 */
    [Column(StringLength = 16)]
    string targetRoi;

    /* 实际达成 GMV */
    [Column(StringLength = 32)]
    string actualGmv;

    /* 实际达成 ROI */
    [Column(StringLength = 16)]
    string actualRoi;

    long createdAt;

    long updatedAt;
}
