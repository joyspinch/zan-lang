using System.Data.Orm;

namespace ZanWeb.Model.Ecbi;

/* 电商平台主数据：天猫/京东/拼多多…。店铺挂在平台下（ods_shop.platformId）。 */
[Table(Name = "ods_platform")]
class OdsPlatform {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，#34）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new OdsPlatform() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    [Column(StringLength = 32, IsNullable = false)]
    string name;

    [Column(StringLength = 32)]
    string code;

    int status;

    long createdAt;
}
