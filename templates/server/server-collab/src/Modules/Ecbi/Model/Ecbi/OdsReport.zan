using System.Data.Orm;

namespace ZanWeb.Model.Ecbi;

/* 报表编排定义：维度串(dims) + 指标串(metrics) + 图表类型(chart)。串格式如 "platform|shop" 与 "sales|orders"，运行时按此聚合 ods_order / ods_ad。 */
[Table(Name = "ods_report")]
class OdsReport {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，#34）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new OdsReport() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    [Column(StringLength = 128)]
    string dims;

    [Column(StringLength = 128)]
    string metrics;

    [Column(StringLength = 16)]
    string chart;

    long createdAt;
}
