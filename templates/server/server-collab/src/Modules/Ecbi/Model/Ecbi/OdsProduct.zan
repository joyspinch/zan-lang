using System.Data.Orm;

namespace ZanWeb.Model.Ecbi;

/* 内部商品（集团维度）：一份商品主档；在各平台的售卖链接由 ods_shop_product 映射，同一商品可关联 N 条平台链接。 */
[Table(Name = "ods_product")]
class OdsProduct {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，#34）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new OdsProduct() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    [Column(StringLength = 32)]
    string sku;

    [Column(StringLength = 32)]
    string category;

    int status;

    long createdAt;
}
