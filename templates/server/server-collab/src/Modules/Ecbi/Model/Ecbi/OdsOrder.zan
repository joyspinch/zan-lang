using System.Data.Orm;

namespace ZanWeb.Model.Ecbi;

/* 电商订单落地（ODS）。从业务系统/第三方平台抽取后写入，是 BI 的唯一数据来源；本模板用「导入示例」产生演示数据。ods_ 前缀=集成/落地域。 */
[Table(Name = "ods_order")]
class OdsOrder {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，#34）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new OdsOrder() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    [Column(StringLength = 32, IsNullable = false)]
    string orderNo;

    [Column(StringLength = 64)]
    string customerName;

    [Column(StringLength = 128)]
    string productName;

    [Column(StringLength = 32)]
    string category;

    [Column(StringLength = 32)]
    string channel;

    /* 维度列：平台/店铺/内部商品。旧数据三者皆 0，看板按「未分类」处理。 */
    int platformId;

    int shopId;

    int productId;

    [Column(StringLength = 32)]
    string province;

    long amount;
    int qty;
    long payAt;
    long createdAt;
}
