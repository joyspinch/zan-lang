using System.Data.Orm;

namespace ZanWeb.Model.Ecbi;

/* 店铺：归属某平台（platformId），BI 的核心分析维度之一。 */
[Table(Name = "ods_shop")]
class OdsShop {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    int platformId;

    int status;

    long createdAt;
}
