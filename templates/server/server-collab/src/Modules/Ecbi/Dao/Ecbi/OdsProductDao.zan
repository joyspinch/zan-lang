using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Ecbi;

namespace ZanWeb.Dao.Ecbi;

/* OdsProduct 强类型数据访问网关（FreeSql 风格） */
class OdsProductDao {
    IDbConnection db;

    OdsProductDao(IDbConnection db) {
        this.db = db;
    }

    async OdsProduct ById(int id) {
        return await this.db.Select<OdsProduct>().Where(a => a.id == id).FirstAsync();
    }

    async List<OdsProduct> All() {
        return await this.db.Select<OdsProduct>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OdsProduct>().CountAsync();
    }

    async int Insert(OdsProduct entity) {
        return await this.db.Insert<OdsProduct>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OdsProduct>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
