using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Ecbi;

namespace Zan.Web.Dao.Ecbi;

/* OdsProduct 强类型数据访问网关（ZanSql 风格） */
public class OdsProductDao : BaseRepository<OdsProduct> {
    public OdsProductDao() : base() {}
    public OdsProductDao(IZanSql fsql) : base(fsql) {}
    public OdsProductDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OdsProduct ById(int id) {
        return await this.GetExecutor().Select<OdsProduct>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OdsProduct> All() {
        return await this.GetExecutor().Select<OdsProduct>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OdsProduct>().CountAsync();
    }

    public InsertQuery<OdsProduct> Insert(OdsProduct entity) {
        return this.GetExecutor().Insert<OdsProduct>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OdsProduct>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
