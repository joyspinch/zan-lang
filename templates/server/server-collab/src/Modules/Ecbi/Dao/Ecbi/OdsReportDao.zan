using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Ecbi;

namespace ZanWeb.Dao.Ecbi;

/* OdsReport 强类型数据访问网关（FreeSql 风格） */
class OdsReportDao {
    IDbConnection db;

    OdsReportDao(IDbConnection db) {
        this.db = db;
    }

    async OdsReport ById(int id) {
        return await this.db.Select<OdsReport>().Where(a => a.id == id).FirstAsync();
    }

    async List<OdsReport> All() {
        return await this.db.Select<OdsReport>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OdsReport>().CountAsync();
    }

    async int Insert(OdsReport entity) {
        return await this.db.Insert<OdsReport>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OdsReport>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
