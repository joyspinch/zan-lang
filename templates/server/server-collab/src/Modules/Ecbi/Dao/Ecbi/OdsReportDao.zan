using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Ecbi;

namespace Zan.Web.Dao.Ecbi;

/* OdsReport 强类型数据访问网关（ZanSql 风格） */
public class OdsReportDao : BaseRepository<OdsReport> {
    public OdsReportDao() : base() {}
    public OdsReportDao(IZanSql fsql) : base(fsql) {}
    public OdsReportDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OdsReport ById(int id) {
        return await this.GetExecutor().Select<OdsReport>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OdsReport> All() {
        return await this.GetExecutor().Select<OdsReport>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OdsReport>().CountAsync();
    }

    public InsertQuery<OdsReport> Insert(OdsReport entity) {
        return this.GetExecutor().Insert<OdsReport>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OdsReport>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
