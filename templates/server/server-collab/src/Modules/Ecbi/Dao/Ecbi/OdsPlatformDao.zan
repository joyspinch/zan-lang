using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Ecbi;

namespace ZanWeb.Dao.Ecbi;

/* OdsPlatform 强类型数据访问网关（FreeSql 风格） */
class OdsPlatformDao : BaseRepository<OdsPlatform> {
    OdsPlatformDao(IFreeSql fsql) : base(fsql) {}
    OdsPlatformDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async OdsPlatform ById(int id) {
        return await this.GetExecutor().Select<OdsPlatform>().Where(a => a.id == id).FirstAsync();
    }

    async List<OdsPlatform> All() {
        return await this.GetExecutor().Select<OdsPlatform>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<OdsPlatform>().CountAsync();
    }

    async int Insert(OdsPlatform entity) {
        return await this.GetExecutor().Insert<OdsPlatform>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<OdsPlatform>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
