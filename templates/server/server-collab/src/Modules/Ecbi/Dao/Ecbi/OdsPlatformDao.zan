using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Ecbi;

namespace ZanWeb.Dao.Ecbi;

/* OdsPlatform 强类型数据访问网关（FreeSql 风格） */
class OdsPlatformDao {
    IDbConnection db;

    OdsPlatformDao(IDbConnection db) {
        this.db = db;
    }

    async OdsPlatform ById(int id) {
        return await this.db.Select<OdsPlatform>().Where(a => a.id == id).FirstAsync();
    }

    async List<OdsPlatform> All() {
        return await this.db.Select<OdsPlatform>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OdsPlatform>().CountAsync();
    }

    async int Insert(OdsPlatform entity) {
        return await this.db.Insert<OdsPlatform>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OdsPlatform>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
