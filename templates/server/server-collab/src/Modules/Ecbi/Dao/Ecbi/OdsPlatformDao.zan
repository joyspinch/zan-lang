using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Ecbi;

namespace Zan.Web.Dao.Ecbi;

/* OdsPlatform 强类型数据访问网关（ZanSql 风格） */
public class OdsPlatformDao : BaseRepository<OdsPlatform> {
    public OdsPlatformDao() : base() {}
    public OdsPlatformDao(IZanSql fsql) : base(fsql) {}
    public OdsPlatformDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OdsPlatform ById(int id) {
        return await this.GetExecutor().Select<OdsPlatform>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OdsPlatform> All() {
        return await this.GetExecutor().Select<OdsPlatform>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OdsPlatform>().CountAsync();
    }

    public InsertQuery<OdsPlatform> Insert(OdsPlatform entity) {
        return this.GetExecutor().Insert<OdsPlatform>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OdsPlatform>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
