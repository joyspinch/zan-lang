using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Ecbi;

namespace ZanWeb.Dao.Ecbi;

/* OdsShop 强类型数据访问网关（FreeSql 风格） */
class OdsShopDao : BaseRepository<OdsShop> {
    OdsShopDao(IFreeSql fsql) : base(fsql) {}
    OdsShopDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async OdsShop ById(int id) {
        return await this.GetExecutor().Select<OdsShop>().Where(a => a.id == id).FirstAsync();
    }

    async List<OdsShop> All() {
        return await this.GetExecutor().Select<OdsShop>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<OdsShop>().CountAsync();
    }

    async int Insert(OdsShop entity) {
        return await this.GetExecutor().Insert<OdsShop>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<OdsShop>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
