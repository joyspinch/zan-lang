using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Ecbi;

namespace ZanWeb.Dao.Ecbi;

/* OdsShop 强类型数据访问网关（FreeSql 风格） */
class OdsShopDao {
    IDbConnection db;

    OdsShopDao(IDbConnection db) {
        this.db = db;
    }

    async OdsShop ById(int id) {
        return await this.db.Select<OdsShop>().Where(a => a.id == id).FirstAsync();
    }

    async List<OdsShop> All() {
        return await this.db.Select<OdsShop>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OdsShop>().CountAsync();
    }

    async int Insert(OdsShop entity) {
        return await this.db.Insert<OdsShop>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OdsShop>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
