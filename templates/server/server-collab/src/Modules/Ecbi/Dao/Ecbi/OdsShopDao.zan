using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Ecbi;

namespace Zan.Web.Dao.Ecbi;

/* OdsShop 强类型数据访问网关（ZanSql 风格） */
public class OdsShopDao : BaseRepository<OdsShop> {
    public OdsShopDao() : base() {}
    public OdsShopDao(IZanSql fsql) : base(fsql) {}
    public OdsShopDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OdsShop ById(int id) {
        return await this.GetExecutor().Select<OdsShop>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OdsShop> All() {
        return await this.GetExecutor().Select<OdsShop>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OdsShop>().CountAsync();
    }

    public InsertQuery<OdsShop> Insert(OdsShop entity) {
        return this.GetExecutor().Insert<OdsShop>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OdsShop>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
