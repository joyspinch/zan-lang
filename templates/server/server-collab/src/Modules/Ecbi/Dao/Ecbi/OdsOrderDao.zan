using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Ecbi;

namespace Zan.Web.Dao.Ecbi;

/* OdsOrder 强类型数据访问网关（ZanSql 风格） */
public class OdsOrderDao : BaseRepository<OdsOrder> {
    public OdsOrderDao() : base() {}
    public OdsOrderDao(IZanSql fsql) : base(fsql) {}
    public OdsOrderDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OdsOrder ById(int id) {
        return await this.GetExecutor().Select<OdsOrder>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OdsOrder> All() {
        return await this.GetExecutor().Select<OdsOrder>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OdsOrder>().CountAsync();
    }

    public InsertQuery<OdsOrder> Insert(OdsOrder entity) {
        return this.GetExecutor().Insert<OdsOrder>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OdsOrder>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async int CountByOrderNo(int tenantId, string orderNo) {
        return await this.GetExecutor().Select<OdsOrder>()
            .Where(a => a.orderNo == orderNo && a.tenantId == tenantId)
            .CountAsync();
    }

    /* 兼容行导入或后台场景的同步版本 */
    public int CountByOrderNoSync(int tenantId, string orderNo) {
        return this.GetExecutor().Select<OdsOrder>()
            .Where(a => a.orderNo == orderNo && a.tenantId == tenantId)
            .Count();
    }

    public int InsertSync(OdsOrder entity) {
        return this.GetExecutor().Insert<OdsOrder>(entity).ExecuteAffrows();
    }
}
