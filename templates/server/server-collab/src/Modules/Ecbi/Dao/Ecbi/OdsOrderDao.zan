using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Ecbi;

namespace ZanWeb.Dao.Ecbi;

/* OdsOrder 强类型数据访问网关（FreeSql 风格） */
class OdsOrderDao : BaseRepository<OdsOrder> {
    OdsOrderDao(IFreeSql fsql) : base(fsql) {}
    OdsOrderDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async OdsOrder ById(int id) {
        return await this.GetExecutor().Select<OdsOrder>().Where(a => a.id == id).FirstAsync();
    }

    async List<OdsOrder> All() {
        return await this.GetExecutor().Select<OdsOrder>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<OdsOrder>().CountAsync();
    }

    async int Insert(OdsOrder entity) {
        return await this.GetExecutor().Insert<OdsOrder>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<OdsOrder>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int CountByOrderNo(int tenantId, string orderNo) {
        return await this.GetExecutor().Select<OdsOrder>()
            .Where(a => a.orderNo == orderNo && a.tenantId == tenantId)
            .CountAsync();
    }

    /* 兼容行导入或后台场景的同步版本 */
    int CountByOrderNoSync(int tenantId, string orderNo) {
        return this.GetExecutor().Select<OdsOrder>()
            .Where(a => a.orderNo == orderNo && a.tenantId == tenantId)
            .Count();
    }

    int InsertSync(OdsOrder entity) {
        return this.GetExecutor().Insert<OdsOrder>(entity).ExecuteAffrows();
    }
}
