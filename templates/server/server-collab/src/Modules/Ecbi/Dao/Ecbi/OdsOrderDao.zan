using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Ecbi;

namespace ZanWeb.Dao.Ecbi;

/* OdsOrder 强类型数据访问网关（FreeSql 风格） */
class OdsOrderDao {
    IDbConnection db;

    OdsOrderDao(IDbConnection db) {
        this.db = db;
    }

    async OdsOrder ById(int id) {
        return await this.db.Select<OdsOrder>().Where(a => a.id == id).FirstAsync();
    }

    async List<OdsOrder> All() {
        return await this.db.Select<OdsOrder>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OdsOrder>().CountAsync();
    }

    async int Insert(OdsOrder entity) {
        return await this.db.Insert<OdsOrder>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OdsOrder>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int CountByOrderNo(int tenantId, string orderNo) {
        return await this.db.Select<OdsOrder>()
            .Where(a => a.orderNo == orderNo && a.tenantId == tenantId)
            .CountAsync();
    }

    /* 兼容行导入或后台场景的同步版本 */
    int CountByOrderNoSync(int tenantId, string orderNo) {
        return this.db.Select<OdsOrder>()
            .Where(a => a.orderNo == orderNo && a.tenantId == tenantId)
            .Count();
    }

    int InsertSync(OdsOrder entity) {
        return this.db.Insert<OdsOrder>(entity).ExecuteAffrows();
    }
}
