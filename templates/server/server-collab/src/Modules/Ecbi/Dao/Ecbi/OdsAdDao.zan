using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Ecbi;

namespace ZanWeb.Dao.Ecbi;

/* OdsAd 强类型数据访问网关（FreeSql 风格） */
class OdsAdDao : BaseRepository<OdsAd> {
    OdsAdDao(IFreeSql fsql) : base(fsql) {}
    OdsAdDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async OdsAd ById(int id) {
        return await this.GetExecutor().Select<OdsAd>().Where(a => a.id == id).FirstAsync();
    }

    async List<OdsAd> All() {
        return await this.GetExecutor().Select<OdsAd>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<OdsAd>().CountAsync();
    }

    async int Insert(OdsAd entity) {
        return await this.GetExecutor().Insert<OdsAd>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<OdsAd>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
