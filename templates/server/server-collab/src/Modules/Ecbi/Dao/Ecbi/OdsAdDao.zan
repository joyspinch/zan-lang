using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Ecbi;

namespace ZanWeb.Dao.Ecbi;

/* OdsAd 强类型数据访问网关（FreeSql 风格） */
class OdsAdDao {
    IDbConnection db;

    OdsAdDao(IDbConnection db) {
        this.db = db;
    }

    async OdsAd ById(int id) {
        return await this.db.Select<OdsAd>().Where(a => a.id == id).FirstAsync();
    }

    async List<OdsAd> All() {
        return await this.db.Select<OdsAd>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OdsAd>().CountAsync();
    }

    async int Insert(OdsAd entity) {
        return await this.db.Insert<OdsAd>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OdsAd>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
