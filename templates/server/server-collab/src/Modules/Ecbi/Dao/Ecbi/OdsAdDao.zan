using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Ecbi;

namespace Zan.Web.Dao.Ecbi;

/* OdsAd 强类型数据访问网关（ZanSql 风格） */
public class OdsAdDao : BaseRepository<OdsAd> {
    public OdsAdDao() : base() {}
    public OdsAdDao(IZanSql fsql) : base(fsql) {}
    public OdsAdDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OdsAd ById(int id) {
        return await this.GetExecutor().Select<OdsAd>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OdsAd> All() {
        return await this.GetExecutor().Select<OdsAd>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OdsAd>().CountAsync();
    }

    public InsertQuery<OdsAd> Insert(OdsAd entity) {
        return this.GetExecutor().Insert<OdsAd>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OdsAd>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
