using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Ecbi;

namespace Zan.Web.Dao.Ecbi;

/* OdsShopProduct 强类型数据访问网关（ZanSql 风格） */
public class OdsShopProductDao : BaseRepository<OdsShopProduct> {
    public OdsShopProductDao() : base() {}
    OdsShopProductDao(IZanSql fsql) : base(fsql) {}
    OdsShopProductDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async OdsShopProduct ById(int id) {
        return await this.GetExecutor().Select<OdsShopProduct>().Where(a => a.id == id).FirstAsync();
    }

    async List<OdsShopProduct> All() {
        return await this.GetExecutor().Select<OdsShopProduct>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<OdsShopProduct>().CountAsync();
    }

    async int Insert(OdsShopProduct entity) {
        return await this.GetExecutor().Insert<OdsShopProduct>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<OdsShopProduct>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
