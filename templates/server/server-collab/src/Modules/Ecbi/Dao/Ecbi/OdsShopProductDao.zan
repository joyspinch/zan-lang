using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Ecbi;

namespace ZanWeb.Dao.Ecbi;

/* OdsShopProduct 强类型数据访问网关（FreeSql 风格） */
class OdsShopProductDao {
    IDbConnection db;

    OdsShopProductDao(IDbConnection db) {
        this.db = db;
    }

    async OdsShopProduct ById(int id) {
        return await this.db.Select<OdsShopProduct>().Where(a => a.id == id).FirstAsync();
    }

    async List<OdsShopProduct> All() {
        return await this.db.Select<OdsShopProduct>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OdsShopProduct>().CountAsync();
    }

    async int Insert(OdsShopProduct entity) {
        return await this.db.Insert<OdsShopProduct>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OdsShopProduct>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
