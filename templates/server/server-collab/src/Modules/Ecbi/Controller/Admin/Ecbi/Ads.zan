using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model.Ecbi;

namespace Zan.Web.Admin.Ecbi;

/* /admin/ecbi/ads 推广数据：按店铺的投放日报与推广分析（子表弹窗）。ROI = 推广成交金额 / 花费。 */
[Route("admin/ecbi/ads/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("推广数据")]
public class Ads : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .TbarAdd("录入推广数据", "/admin/ecbi/ads/form")
            .TbarCustom("推广分析汇总", "/admin/ecbi/ads/analysis", "")
            .Col("id", "ID", "num", "75")
            .Col("day", "日期", "text", "115")
            .Col("platform", "平台", "text", "110")
            .Col("shop", "店铺", "text", "150")
            .Col("campaign", "推广计划", "text", "160")
            .Col("cost", "花费(分)", "num", "105")
            .Col("impression", "展现", "num", "95")
            .Col("click", "点击", "num", "85")
            .Col("ctr", "点击率", "text", "85")
            .Col("orderCount", "成交笔数", "num", "95")
            .Col("orderAmount", "成交额(分)", "num", "110")
            .Col("roi", "ROI", "text", "85")
            .OpsEdit("/admin/ecbi/ads/form")
            .OpsDel("/admin/ecbi/ads/delete", "确认删除该推广记录吗？");
    }

    static ListPage AnalysisDef() {
        return ListPage.Of()
            .Col("platform", "平台", "text", "130")
            .Col("shop", "店铺", "text", "180")
            .Col("cost", "总花费(分)", "num", "120")
            .Col("orderAmount", "总成交额(分)", "num", "130")
            .Col("roi", "ROI", "text", "100")
            .Col("ctr", "点击率", "text", "100");
    }

    [HttpGet]
    [Route("/admin/ecbi/ads")]
    [Custom(IsMenu = true, Icon = "mdi:megaphone", Perm = PermBit.View)]
    [Description("推广数据")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("推广数据表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Ads.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("推广数据列表")]
    public async void List() {
        if (!this.DataReady()) { return; }
        ListQuery q = this.PagedAny("day", 20);
        List<OdsAd> rows = await this.OdsAd
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderByDescending(a => a.day).OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.OdsAd
            .Where(a => a.tenantId == Tenant.Cur()).CountAsync();
        List<OdsShop> shops = await this.OdsShop
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<OdsPlatform> plats = await this.OdsPlatform
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            OdsAd a = rows[i];
            w.WriteStartObject();
            w.WriteProperty("id", a.id);
            w.WriteProperty("shopId", Convert.ToString(a.shopId));
            w.WriteProperty("shop", Ads.ShopName(shops, a.shopId));
            w.WriteProperty("platform", Ads.PlatOfShop(shops, plats, a.shopId));
            w.WriteProperty("campaign", Fmt.Dash(a.campaign));
            w.WriteProperty("day", Fmt.Day(a.day));
            w.WriteProperty("cost", a.cost);
            w.WriteProperty("impression", a.impression);
            w.WriteProperty("click", a.click);
            w.WriteProperty("ctr", a.impression > 0
                ? Convert.ToString(a.click * 100 / a.impression) + "%" : "—");
            w.WriteProperty("orderCount", a.orderCount);
            w.WriteProperty("orderAmount", a.orderAmount);
            w.WriteProperty("roi", a.cost > 0
                ? Convert.ToString(a.orderAmount * 100 / a.cost) + "%" : "—");
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("推广表单配置")]
    public async void FormConf() {
        List<OdsShop> shops = await this.OdsShop
            .Where(x => x.tenantId == Tenant.Cur() && x.status == 1)
            .OrderBy(x => x.id).ToListAsync();
        List<OdsPlatform> plats = await this.OdsPlatform
            .Where(x => x.tenantId == Tenant.Cur())
            .OrderBy(x => x.id).ToListAsync();
        List<StrMap> sopts = new List<StrMap>();
        for (int i = 0; i < shops.Count; i = i + 1) {
            StrMap opt = new StrMap();
            opt.Set("id", Convert.ToString(shops[i].id));
            opt.Set("name", shops[i].name + "（"
                + Ads.PlatName(plats, shops[i].platformId) + "）");
            sopts.Add(opt);
        }
        FormPage fp = FormPage.Of("/admin/ecbi/ads/save")
            .Wide()
            .SelectList("所属店铺", "shopId", sopts).Req()
            .Text("投放日期", "day").Req().Ph("YYYY-MM-DD").Val(Fmt.Day(WebApp.NowSeconds()))
            .Text("推广计划", "campaign").Ph("推广计划名称")
            .Num("花费(分)", "cost").Val("0")
            .Num("展现量", "impression").Val("0")
            .Num("点击量", "click").Val("0")
            .Num("成交笔数", "orderCount").Val("0")
            .Num("成交金额(分)", "orderAmount").Val("0");
        CrudOps.FormConf(this, fp, "推广记录");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("推广记录编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        OdsAd a = await this.OdsAd
            .Where(x => x.id == id && x.tenantId == Tenant.Cur())
            .FirstAsync();
        if (a == null) { this.Fail(404, "0404", "记录不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", a.id);
        w.WriteProperty("shopId", Convert.ToString(a.shopId));
        w.WriteProperty("campaign", a.campaign);
        w.WriteProperty("day", Fmt.Day(a.day));
        w.WriteProperty("cost", a.cost);
        w.WriteProperty("impression", a.impression);
        w.WriteProperty("click", a.click);
        w.WriteProperty("orderCount", a.orderCount);
        w.WriteProperty("orderAmount", a.orderAmount);
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存推广数据")]
    async void Save() {
        int id = this.InAnyInt("id", 0);
        int shopId = this.InAnyInt("shopId", 0);
        string campaign = this.InAny("campaign");
        string dayStr = this.NeedAny("day", "日期");
        long cost = this.InAnyLong("cost", 0);
        long impression = this.InAnyLong("impression", 0);
        long click = this.InAnyLong("click", 0);
        int orderCount = this.InAnyInt("orderCount", 0);
        long orderAmount = this.InAnyLong("orderAmount", 0);
        if (shopId <= 0) { this.Fail(400, "0004", "请选择店铺"); return; }

        long day = Ads.DayStart(dayStr);
        if (day <= 0) { this.Fail(400, "0004", "日期格式应为 YYYY-MM-DD"); return; }

        if (id > 0) {
            int n = await this.OdsAd.Update()
                .Set(a => a.shopId, shopId)
                .Set(a => a.campaign, campaign)
                .Set(a => a.day, day)
                .Set(a => a.cost, cost)
                .Set(a => a.impression, impression)
                .Set(a => a.click, click)
                .Set(a => a.orderCount, orderCount)
                .Set(a => a.orderAmount, orderAmount)
                .Where(a => a.id == id && a.tenantId == Tenant.Cur())
                .ExecuteAffrowsAsync();
            await this.Note("编辑推广数据", "#" + Convert.ToString(id), n > 0, "");
            this.Saved("推广数据已保存");
            return;
        }
        OdsAd a = new OdsAd();
        a.tenantId = Tenant.Cur();
        a.shopId = shopId;
        a.campaign = campaign;
        a.day = day;
        a.cost = cost;
        a.impression = impression;
        a.click = click;
        a.orderCount = orderCount;
        a.orderAmount = orderAmount;
        int newId = await this.OdsAd.Insert(a).ExecuteIdentityAsync();
        await this.Note("录入推广数据", "#" + Convert.ToString(newId) + " " + campaign,
            newId > 0, "");
        this.Saved("推广数据已录入");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除推广数据")]
    async void Delete() {
        int id = this.InAnyInt("id", 0);
        int n = await this.OdsAd.Delete()
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        await this.Note("删除推广数据", "#" + Convert.ToString(id), n > 0, "");
        this.Saved("推广数据已删除");
    }

    /* 推广分析：按平台×店铺汇总，作为子表弹窗展示。 */
    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("推广分析")]
    void Analysis() {
        this.AnalysisConf();
    }

    [HttpPut]
    [Route("/admin/ecbi/ads/analysis/conf")]
    [Custom(Perm = PermBit.View)]
    [Description("推广分析表格配置")]
    public void AnalysisConf() {
        CrudOps.Conf(this, Ads.AnalysisDef());
    }

    [HttpPost]
    [Route("/admin/ecbi/ads/analysis/list")]
    [Custom(Perm = PermBit.View)]
    [Description("推广分析汇总数据")]
    public async void AnalysisList() {
        if (!this.DataReady()) { return; }
        List<OdsAd> all = await this.OdsAd
            .Where(a => a.tenantId == Tenant.Cur()).ToListAsync();
        List<OdsShop> shops = await this.OdsShop
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<OdsPlatform> plats = await this.OdsPlatform
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();

        long totalCost = 0;
        long totalAmount = 0;
        long totalClick = 0;
        long totalImpression = 0;
        int count = 0;
        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < shops.Count; i = i + 1) {
            long cost = 0;
            long amount = 0;
            long click = 0;
            long impression = 0;
            for (int k = 0; k < all.Count; k = k + 1) {
                if (all[k].shopId == shops[i].id) {
                    cost = cost + all[k].cost;
                    amount = amount + all[k].orderAmount;
                    click = click + all[k].click;
                    impression = impression + all[k].impression;
                }
            }
            if (cost == 0 && amount == 0) { continue; }
            totalCost = totalCost + cost;
            totalAmount = totalAmount + amount;
            totalClick = totalClick + click;
            totalImpression = totalImpression + impression;
            count = count + 1;
            w.WriteStartObject();
            w.WriteProperty("id", shops[i].id);
            w.WriteProperty("shop", shops[i].name);
            w.WriteProperty("platform", Ads.PlatName(plats, shops[i].platformId));
            w.WriteProperty("cost", cost);
            w.WriteProperty("orderAmount", amount);
            w.WriteProperty("roi", cost > 0 ? Convert.ToString(amount * 100 / cost) + "%" : "—");
            w.WriteProperty("ctr", impression > 0
                ? Convert.ToString(click * 100 / impression) + "%" : "—");
            w.WriteEndObject();
        }
        if (count > 0) {
            count = count + 1;
            w.WriteStartObject();
            w.WriteProperty("id", 0);
            w.WriteProperty("shop", "全部汇总");
            w.WriteProperty("platform", "—");
            w.WriteProperty("cost", totalCost);
            w.WriteProperty("orderAmount", totalAmount);
            w.WriteProperty("roi", totalCost > 0
                ? Convert.ToString(totalAmount * 100 / totalCost) + "%" : "—");
            w.WriteProperty("ctr", totalImpression > 0
                ? Convert.ToString(totalClick * 100 / totalImpression) + "%" : "—");
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, count, w.ToString());
    }

    static long DayStart(string s) {
        if (s.Length != 10 || s[4] != '-' || s[7] != '-') { return 0; }
        int y = 0;
        int mo = 0;
        int da = 0;
        int i = 0;
        while (i < 4) {
            if (s[i] < '0' || s[i] > '9') { return 0; }
            y = y * 10 + (s[i] - '0');
            i = i + 1;
        }
        i = 5;
        while (i < 7) {
            if (s[i] < '0' || s[i] > '9') { return 0; }
            mo = mo * 10 + (s[i] - '0');
            i = i + 1;
        }
        i = 8;
        while (i < 10) {
            if (s[i] < '0' || s[i] > '9') { return 0; }
            da = da * 10 + (s[i] - '0');
            i = i + 1;
        }
        if (mo < 1 || mo > 12 || da < 1 || da > 31) { return 0; }
        return (long)Ads.DaysFromEpoch(y, mo, da) * 86400;
    }

    static int DaysFromEpoch(int year, int month, int day) {
        int days = 0;
        for (int y = 1970; y < year; y = y + 1) {
            days = days + (Ads.IsLeap(y) ? 366 : 365);
        }
        int feb = Ads.IsLeap(year) ? 29 : 28;
        int m = 1;
        while (m < month) {
            if (m == 1) { days = days + 31; }
            else if (m == 2) { days = days + feb; }
            else if (m == 3) { days = days + 31; }
            else if (m == 4) { days = days + 30; }
            else if (m == 5) { days = days + 31; }
            else if (m == 6) { days = days + 30; }
            else if (m == 7) { days = days + 31; }
            else if (m == 8) { days = days + 31; }
            else if (m == 9) { days = days + 30; }
            else if (m == 10) { days = days + 31; }
            else if (m == 11) { days = days + 30; }
            else { days = days + 31; }
            m = m + 1;
        }
        return days + day - 1;
    }

    static bool IsLeap(int y) {
        return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0;
    }

    static string ShopName(List<OdsShop> shops, int id) {
        for (int i = 0; i < shops.Count; i = i + 1) {
            if (shops[i].id == id) { return shops[i].name; }
        }
        return "—";
    }

    static string PlatName(List<OdsPlatform> plats, int id) {
        for (int i = 0; i < plats.Count; i = i + 1) {
            if (plats[i].id == id) { return plats[i].name; }
        }
        return "—";
    }

    static string PlatOfShop(List<OdsShop> shops, List<OdsPlatform> plats, int shopId) {
        for (int i = 0; i < shops.Count; i = i + 1) {
            if (shops[i].id == shopId) { return Ads.PlatName(plats, shops[i].platformId); }
        }
        return "—";
    }
}
