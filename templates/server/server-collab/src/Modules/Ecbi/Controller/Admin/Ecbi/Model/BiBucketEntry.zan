using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Dao.Ecbi;
using ZanWeb.Model.Ecbi;

public class BiBucketEntry {
    string key;
    long amount;

    BiBucketEntry(string key, long amount) {
        this.key = key != null ? key : "";
        this.amount = amount;
    }
}

