using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Dao.Ecbi;
using ZanWeb.Model.Ecbi;

public class BiDayTrendEntry {
    string day;
    long amount;

    BiDayTrendEntry(string day, long amount) {
        this.day = day != null ? day : "";
        this.amount = amount;
    }
}

