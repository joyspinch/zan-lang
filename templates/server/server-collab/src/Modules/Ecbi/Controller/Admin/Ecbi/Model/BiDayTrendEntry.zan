using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using Zan.Web;
using Zan.Web.Dao.Ecbi;
using Zan.Web.Model.Ecbi;

public class BiDayTrendEntry {
    public string day;
    public long amount;

    public BiDayTrendEntry(string day, long amount) {
        this.day = day != null ? day : "";
        this.amount = amount;
    }
}

