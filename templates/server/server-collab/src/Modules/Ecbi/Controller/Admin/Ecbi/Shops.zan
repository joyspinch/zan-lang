using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model.Ecbi;

namespace Zan.Web.Admin.Ecbi;

/* /admin/ecbi/shops 店铺管理：归属平台的店铺档案，订单/推广/链接映射的核心维度。 */
[Route("admin/ecbi/shops/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("店铺管理")]
public class Shops : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .TbarAdd("新增店铺", "/admin/ecbi/shops/form")
            .Col("id", "ID", "num", "75")
            .Col("name", "店铺名称", "text", "200")
            .Col("platform", "所属平台", "text", "150")
            .Tag("status", "状态", "1=启用|ok,0=禁用|off", "90")
            .OpsEdit("/admin/ecbi/shops/form")
            .Ops("切换状态", "/admin/ecbi/shops/status", "确认切换该店铺启停状态吗？", "id={id}&status={nextStatus}", "u");
    }

    [HttpGet]
    [Route("/admin/ecbi/shops")]
    [Custom(IsMenu = true, Icon = "mdi:store", Perm = PermBit.View)]
    [Description("店铺管理")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("店铺表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Shops.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("店铺列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        /* 租户硬边（#34）：列表只出本租户店铺，平台下拉同链。 */
        List<OdsShop> rows = await this.OdsShop
            .Where(a => a.tenantId == Tenant.Cur()).OrderBy(a => a.id).ToListAsync();
        List<OdsPlatform> plats = await this.OdsPlatform
            .Where(a => a.tenantId == Tenant.Cur()).OrderBy(a => a.id).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            OdsShop s = rows[i];
            w.WriteStartObject();
            w.WriteProperty("id", s.id);
            w.WriteProperty("platformId", Convert.ToString(s.platformId));
            w.WriteProperty("name", s.name);
            w.WriteProperty("platform", Shops.PlatName(plats, s.platformId));
            w.WriteProperty("status", Convert.ToString(s.status));
            w.WriteProperty("nextStatus", s.status == 1 ? 0 : 1);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, rows.Count, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("店铺表单配置")]
    public async void FormConf() {
        List<OdsPlatform> plats = await this.OdsPlatform
            .Where(a => a.status == 1 && a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<StrMap> popts = new List<StrMap>();
        for (int i = 0; i < plats.Count; i = i + 1) {
            StrMap opt = new StrMap();
            opt.Set("id", Convert.ToString(plats[i].id));
            opt.Set("name", plats[i].name);
            popts.Add(opt);
        }
        FormPage fp = FormPage.Of("/admin/ecbi/shops/save")
            .SelectList("所属平台", "platformId", popts).Req()
            .Text("店铺名称", "name").Req().Ph("请输入店铺名称");
        CrudOps.FormConf(this, fp, "店铺");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("店铺编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        OdsShop s = await this.OdsShop
            .Where(a => a.id == id && a.tenantId == Tenant.Cur()).FirstAsync();
        if (s == null) { this.Fail(404, "0404", "店铺不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", s.id);
        w.WriteProperty("platformId", Convert.ToString(s.platformId));
        w.WriteProperty("name", s.name);
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存店铺")]
    async void Save() {
        int id = this.InAnyInt("id", 0);
        string name = this.NeedAny("name", "店铺名称");
        int platformId = this.InAnyInt("platformId", 0);
        if (platformId <= 0) { this.Fail(400, "0004", "请选择所属平台"); return; }

        if (id > 0) {
            int n = await this.OdsShop.Update()
                .Set(a => a.name, name)
                .Set(a => a.platformId, platformId)
                .Where(a => a.id == id && a.tenantId == Tenant.Cur())
                .ExecuteAffrowsAsync();
            if (n <= 0) { this.Fail(404, "0404", "店铺不存在"); return; }
            await this.Note("编辑店铺", "#" + Convert.ToString(id) + " " + name, n > 0, "");
            this.Saved("店铺已保存");
            return;
        }
        OdsShop s = new OdsShop();
        s.name = name;
        s.platformId = platformId;
        s.status = 1;
        s.tenantId = Tenant.Cur();
        s.createdAt = WebApp.NowSeconds();
        int newId = await this.OdsShop.Insert(s).ExecuteIdentityAsync();
        await this.Note("新增店铺", "#" + Convert.ToString(newId) + " " + name, newId > 0, "");
        this.Saved("店铺已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("启用或禁用店铺")]
    async void Status() {
        int id = this.InAnyInt("id", 0);
        int status = this.InAnyInt("status", 1);
        if (status != 1) { status = 0; }
        int n = await this.OdsShop.Update()
            .Set(a => a.status, status)
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        if (n <= 0) { this.Fail(404, "0404", "店铺不存在"); return; }
        await this.Note("启用或禁用店铺", "#" + Convert.ToString(id), n > 0,
            status == 1 ? "启用" : "禁用");
        this.Saved(status == 1 ? "店铺已启用" : "店铺已禁用");
    }

    static string PlatName(List<OdsPlatform> list, int id) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i].id == id) { return list[i].name; }
        }
        return "—";
    }
}
