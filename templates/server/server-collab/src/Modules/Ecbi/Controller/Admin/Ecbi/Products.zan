using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model.Ecbi;

namespace Zan.Web.Admin.Ecbi;

/* /admin/ecbi/products 内部商品主档 + 平台链接映射（子表弹窗，零跳页）。 */
[Route("admin/ecbi/products/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("商品主档")]
public class Products : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .Text("商品名 / SKU", "kw", "name|sku", "搜索商品名称或 SKU")
            .TbarAdd("新增商品", "/admin/ecbi/products/form")
            .Col("id", "ID", "num", "75")
            .Col("name", "商品名称", "text", "220")
            .Col("sku", "内部 SKU", "text", "150")
            .Col("category", "类目", "text", "130")
            .Col("linkCount", "平台链接数", "num", "110")
            .OpsEdit("/admin/ecbi/products/form")
            .Ops("平台链接", "/admin/ecbi/products/links", "", "productId={id}", "")
            .OpsDel("/admin/ecbi/products/delete", "确认删除该商品及其全部平台链接吗？");
    }

    static FormPage FormDef() {
        return FormPage.Of("/admin/ecbi/products/save")
            .Text("商品名称", "name").Req().Ph("请输入商品名称")
            .Text("内部 SKU", "sku").Ph("例如：SKU-1001")
            .Text("商品类目", "category").Ph("例如：3C数码 / 服饰");
    }

    static ListPage LinksDef() {
        return ListPage.Of()
            .TbarAdd("新增链接", "/admin/ecbi/products/links/form")
            .Col("id", "ID", "num", "75")
            .Col("platform", "所属平台", "text", "130")
            .Col("shop", "所属店铺", "text", "160")
            .Col("outerCode", "外部编码", "text", "160")
            .Col("url", "商品链接", "text", "260")
            .OpsEdit("/admin/ecbi/products/links/form")
            .OpsDel("/admin/ecbi/products/links/delete", "确认删除该平台链接吗？");
    }

    [HttpGet]
    [Route("/admin/ecbi/products")]
    [Custom(IsMenu = true, Icon = "mdi:package-variant-closed", Perm = PermBit.View)]
    [Description("商品主档")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("商品主档表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Products.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("商品主档列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        ListQuery q = this.PagedAny("id", 20);
        string kw = q.Kw();
        /* 租户硬边（#34）：列表只出本租户行，链接统计同链。 */
        List<OdsProduct> rows = await this.OdsProduct
            .Where(a => a.tenantId == Tenant.Cur())
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw) || a.sku.Contains(kw))
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.OdsProduct
            .Where(a => a.tenantId == Tenant.Cur())
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw) || a.sku.Contains(kw))
            .CountAsync();
        List<OdsShopProduct> links = await this.OdsShopProduct
            .Where(a => a.tenantId == Tenant.Cur()).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            OdsProduct p = rows[i];
            w.WriteStartObject();
            w.WriteProperty("id", p.id);
            w.WriteProperty("name", p.name);
            w.WriteProperty("sku", Fmt.Dash(p.sku));
            w.WriteProperty("category", Fmt.Dash(p.category));
            w.WriteProperty("linkCount", Products.LinkCount(links, p.id));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("商品表单配置")]
    public void FormConf() {
        CrudOps.FormConf(this, Products.FormDef(), "商品");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("商品编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        OdsProduct p = await this.OdsProduct
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (p == null) { this.Fail(404, "0404", "商品不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", p.id);
        w.WriteProperty("name", p.name);
        w.WriteProperty("sku", p.sku);
        w.WriteProperty("category", p.category);
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存商品")]
    async void Save() {
        int id = this.InAnyInt("id", 0);
        string name = this.NeedAny("name", "商品名称");
        string sku = this.InAny("sku");
        string category = this.InAny("category");

        if (id > 0) {
            int n = await this.OdsProduct.Update()
                .Set(a => a.name, name)
                .Set(a => a.sku, sku)
                .Set(a => a.category, category)
                .Where(a => a.id == id && a.tenantId == Tenant.Cur())
                .ExecuteAffrowsAsync();
            if (n <= 0) { this.Fail(404, "0404", "商品不存在"); return; }
            await this.Note("编辑商品", "#" + Convert.ToString(id) + " " + name, n > 0, "");
            this.Saved("商品已保存");
            return;
        }
        OdsProduct p = new OdsProduct();
        p.name = name;
        p.sku = sku;
        p.category = category;
        p.status = 1;
        p.tenantId = Tenant.Cur();
        p.createdAt = WebApp.NowSeconds();
        int newId = await this.OdsProduct.Insert(p).ExecuteIdentityAsync();
        await this.Note("新增商品", "#" + Convert.ToString(newId) + " " + name, newId > 0, "");
        this.Saved("商品已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除商品")]
    async void Delete() {
        int id = this.InAnyInt("id", 0);
        OdsProduct p = await this.OdsProduct
            .Where(a => a.id == id && a.tenantId == Tenant.Cur()).FirstAsync();
        if (p == null) { this.Fail(404, "0404", "商品不存在"); return; }
        int n = await this.OdsProduct.Delete()
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        int _m = await this.OdsShopProduct.Delete()
            .Where(a => a.productId == id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        await this.Note("删除商品", "#" + Convert.ToString(id) + " " + p.name, n > 0, "");
        this.Saved("商品及其平台链接已删除");
    }

    /* ---- 平台链接映射子表（SubTableModal）---- */

    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("平台链接")]
    void Links() {
        this.LinksConf();
    }

    [HttpPut]
    [Route("/admin/ecbi/products/links/conf")]
    [Custom(Perm = PermBit.View)]
    [Description("平台链接表格配置")]
    public void LinksConf() {
        CrudOps.Conf(this, Products.LinksDef());
    }

    [HttpPost]
    [Route("/admin/ecbi/products/links/list")]
    [Custom(Perm = PermBit.View)]
    [Description("平台链接列表数据")]
    public async void LinksList() {
        if (!this.DataReady()) { return; }
        int productId = this.InAnyInt("productId", 0);
        OdsProduct p = await this.OdsProduct
            .Where(a => a.id == productId && a.tenantId == Tenant.Cur()).FirstAsync();
        if (p == null) { this.Fail(404, "0404", "商品不存在"); return; }

        List<OdsShopProduct> rows = await this.OdsShopProduct
            .Where(a => a.productId == productId && a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<OdsShop> shops = await this.OdsShop
            .Where(a => a.tenantId == Tenant.Cur()).OrderBy(a => a.id).ToListAsync();
        List<OdsPlatform> plats = await this.OdsPlatform
            .Where(a => a.tenantId == Tenant.Cur()).OrderBy(a => a.id).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            OdsShopProduct l = rows[i];
            w.WriteStartObject();
            w.WriteProperty("id", l.id);
            w.WriteProperty("productId", l.productId);
            w.WriteProperty("shopId", Convert.ToString(l.shopId));
            w.WriteProperty("shop", Products.ShopName(shops, l.shopId));
            w.WriteProperty("platform", Products.PlatOfShop(shops, plats, l.shopId));
            w.WriteProperty("outerCode", Fmt.Dash(l.outerCode));
            w.WriteProperty("url", Fmt.Dash(l.url));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, rows.Count, w.ToString());
    }

    [HttpPut]
    [Route("/admin/ecbi/products/links/formconf")]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("平台链接表单配置")]
    public async void LinksFormConf() {
        List<OdsShop> shops = await this.OdsShop
            .Where(a => a.status == 1 && a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<OdsPlatform> plats = await this.OdsPlatform
            .Where(a => a.tenantId == Tenant.Cur()).OrderBy(a => a.id).ToListAsync();
        List<StrMap> sopts = new List<StrMap>();
        for (int i = 0; i < shops.Count; i = i + 1) {
            StrMap opt = new StrMap();
            opt.Set("id", Convert.ToString(shops[i].id));
            opt.Set("name", shops[i].name + "（"
                + Products.PlatName(plats, shops[i].platformId) + "）");
            sopts.Add(opt);
        }
        FormPage fp = FormPage.Of("/admin/ecbi/products/links/save")
            .SelectList("所属店铺", "shopId", sopts).Req()
            .Text("外部商品编码", "outerCode").Ph("平台侧商品 ID / 编码")
            .Text("商品链接", "url").Ph("https://...");
        CrudOps.FormConf(this, fp, "平台链接");
    }

    [HttpPost]
    [Route("/admin/ecbi/products/links/edit")]
    [Custom(Perm = PermBit.View)]
    [Description("平台链接编辑回显")]
    public async void LinksEdit() {
        int id = this.InAnyInt("id", 0);
        OdsShopProduct l = await this.OdsShopProduct
            .Where(a => a.id == id && a.tenantId == Tenant.Cur()).FirstAsync();
        if (l == null) { this.Fail(404, "0404", "链接不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", l.id);
        w.WriteProperty("productId", l.productId);
        w.WriteProperty("shopId", Convert.ToString(l.shopId));
        w.WriteProperty("outerCode", l.outerCode);
        w.WriteProperty("url", l.url);
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Route("/admin/ecbi/products/links/save")]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存链接")]
    async void LinkSave() {
        int id = this.InAnyInt("id", 0);
        int productId = this.InAnyInt("productId", 0);
        int shopId = this.InAnyInt("shopId", 0);
        string outerCode = this.InAny("outerCode");
        string url = this.InAny("url");
        if (shopId <= 0) { this.Fail(400, "0004", "请选择店铺"); return; }
        if (id <= 0 && productId <= 0) { this.Fail(400, "0004", "缺少商品"); return; }

        if (id > 0) {
            int n = await this.OdsShopProduct.Update()
                .Set(a => a.shopId, shopId)
                .Set(a => a.outerCode, outerCode)
                .Set(a => a.url, url)
                .Where(a => a.id == id && a.tenantId == Tenant.Cur())
                .ExecuteAffrowsAsync();
            if (n <= 0) { this.Fail(404, "0404", "链接不存在"); return; }
            await this.Note("编辑平台链接", "#" + Convert.ToString(id), n > 0, "");
            this.Saved("链接已保存");
            return;
        }
        OdsShopProduct l = new OdsShopProduct();
        l.productId = productId;
        l.shopId = shopId;
        l.outerCode = outerCode;
        l.url = url;
        l.tenantId = Tenant.Cur();
        l.createdAt = WebApp.NowSeconds();
        int newId = await this.OdsShopProduct.Insert(l).ExecuteIdentityAsync();
        await this.Note("新增平台链接", "#" + Convert.ToString(newId), newId > 0, "");
        this.Saved("链接已创建");
    }

    [HttpPost]
    [Route("/admin/ecbi/products/links/delete")]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除链接")]
    async void LinkDelete() {
        int id = this.InAnyInt("id", 0);
        int n = await this.OdsShopProduct.Delete()
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        if (n <= 0) { this.Fail(404, "0404", "链接不存在"); return; }
        await this.Note("删除平台链接", "#" + Convert.ToString(id), n > 0, "");
        this.Saved("链接已删除");
    }

    static int LinkCount(List<OdsShopProduct> links, int productId) {
        int n = 0;
        for (int i = 0; i < links.Count; i = i + 1) {
            if (links[i].productId == productId) { n = n + 1; }
        }
        return n;
    }

    static string ShopName(List<OdsShop> shops, int id) {
        for (int i = 0; i < shops.Count; i = i + 1) {
            if (shops[i].id == id) { return shops[i].name; }
        }
        return "—";
    }

    static string PlatName(List<OdsPlatform> plats, int id) {
        for (int i = 0; i < plats.Count; i = i + 1) {
            if (plats[i].id == id) { return plats[i].name; }
        }
        return "—";
    }

    static string PlatOfShop(List<OdsShop> shops, List<OdsPlatform> plats, int shopId) {
        for (int i = 0; i < shops.Count; i = i + 1) {
            if (shops[i].id == shopId) { return Products.PlatName(plats, shops[i].platformId); }
        }
        return "—";
    }
}
