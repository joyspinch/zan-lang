using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model.Ecbi;

namespace Zan.Web.Admin.Ecbi;

/* /admin/ecbi/platforms 平台管理：建、编、启禁。店铺与订单挂平台维度。 */
[Route("admin/ecbi/platforms/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("平台管理")]
public class Platforms : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .TbarAdd("新增平台", "/admin/ecbi/platforms/form")
            .Col("id", "ID", "num", "75")
            .Col("name", "平台名称", "text", "180")
            .Col("code", "编码", "text", "140")
            .Tag("status", "状态", "1=启用|ok,0=禁用|off", "90")
            .OpsEdit("/admin/ecbi/platforms/form")
            .Ops("切换状态", "/admin/ecbi/platforms/status", "确认切换该平台启停状态吗？", "id={id}&status={nextStatus}", "u");
    }

    static FormPage FormDef() {
        return FormPage.Of("/admin/ecbi/platforms/save")
            .Text("平台名称", "name").Req().Ph("例如：淘宝、京东、抖音")
            .Text("平台编码", "code").Ph("例如：taobao、jd、douyin")
            .Select("状态", "status", "1=启用,0=禁用").Val("1");
    }

    [HttpGet]
    [Route("/admin/ecbi/platforms")]
    [Custom(IsMenu = true, Icon = "mdi:storefront", Perm = PermBit.View)]
    [Description("平台管理")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("平台表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Platforms.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("平台列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        /* 租户硬边（#34）：列表只出本租户平台。 */
        List<OdsPlatform> rows = await this.OdsPlatform
            .Where(a => a.tenantId == Tenant.Cur()).OrderBy(a => a.id).ToListAsync();
        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            OdsPlatform p = rows[i];
            w.WriteStartObject();
            w.WriteProperty("id", p.id);
            w.WriteProperty("name", p.name);
            w.WriteProperty("code", Fmt.Dash(p.code));
            w.WriteProperty("status", Convert.ToString(p.status));
            w.WriteProperty("nextStatus", p.status == 1 ? 0 : 1);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, rows.Count, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("平台表单配置")]
    public void FormConf() {
        CrudOps.FormConf(this, Platforms.FormDef(), "平台");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("平台编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        OdsPlatform p = await this.OdsPlatform
            .Where(a => a.id == id && a.tenantId == Tenant.Cur()).FirstAsync();
        if (p == null) { this.Fail(404, "0404", "平台不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", p.id);
        w.WriteProperty("name", p.name);
        w.WriteProperty("code", p.code);
        w.WriteProperty("status", Convert.ToString(p.status));
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存平台")]
    async void Save() {
        int id = this.InAnyInt("id", 0);
        string name = this.NeedAny("name", "平台名称");
        string code = this.InAny("code");
        int status = this.InAnyInt("status", 1);
        if (status != 1) { status = 0; }

        if (id > 0) {
            int n = await this.OdsPlatform.Update()
                .Set(a => a.name, name)
                .Set(a => a.code, code)
                .Set(a => a.status, status)
                .Where(a => a.id == id && a.tenantId == Tenant.Cur())
                .ExecuteAffrowsAsync();
            if (n <= 0) { this.Fail(404, "0404", "平台不存在"); return; }
            await this.Note("编辑平台", "#" + Convert.ToString(id) + " " + name, n > 0, "");
            this.Saved("平台已保存");
            return;
        }
        OdsPlatform p = new OdsPlatform();
        p.name = name;
        p.code = code;
        p.status = status;
        p.tenantId = Tenant.Cur();
        p.createdAt = WebApp.NowSeconds();
        int newId = await this.OdsPlatform.Insert(p).ExecuteIdentityAsync();
        await this.Note("新增平台", "#" + Convert.ToString(newId) + " " + name, newId > 0, "");
        this.Saved("平台已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("启用或禁用平台")]
    async void Status() {
        int id = this.InAnyInt("id", 0);
        int status = this.InAnyInt("status", 1);
        if (status != 1) { status = 0; }
        int n = await this.OdsPlatform.Update()
            .Set(a => a.status, status)
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        if (n <= 0) { this.Fail(404, "0404", "平台不存在"); return; }
        await this.Note("启用或禁用平台", "#" + Convert.ToString(id), n > 0,
            status == 1 ? "启用" : "禁用");
        this.Saved(status == 1 ? "平台已启用" : "平台已禁用");
    }
}
