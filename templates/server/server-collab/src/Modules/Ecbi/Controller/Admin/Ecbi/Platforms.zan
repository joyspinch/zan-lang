using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Ecbi;

namespace ZanWeb.Admin.Ecbi;

/* /admin/ecbi/platforms 平台管理：建、编、启禁。店铺与订单挂平台维度。 */
[Route("admin/ecbi/platforms/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("平台管理")]
class Platforms : AdminController {
    [HttpGet]
    [Route("/admin/ecbi/platforms")]
    [Custom(IsMenu = true, Icon = "mdi:storefront", Perm = PermBit.View)]
    [Description("平台管理")]
    async void Index() {
        ViewData d = await this.Layout("平台管理");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }

        /* 租户硬边（#34）：列表只出本租户平台。 */
        List<OdsPlatform> rows = await this.OdsPlatform
            .Where(a => a.tenantId == this.TenantId()).OrderBy(a => a.id).ToListAsync();
        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            OdsPlatform p = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(p.id));
            row.Set("name", p.name);
            row.Set("code", Fmt.Dash(p.code));
            row.Set("statusText", p.status == 1 ? "启用" : "禁用");
            row.Set("statusClass", p.status == 1 ? "ok" : "off");
            row.Set("nextStatus", p.status == 1 ? "0" : "1");
            row.Set("toggleText", p.status == 1 ? "禁用" : "启用");
            items.Add(row);
        }
        d.Set("total", Convert.ToString(rows.Count));
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("平台表单")]
    async void Form() {
        int id = this.InInt("id", 0);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("dialogTitle", "新增平台");
        d.Set("new", "1");
        d.Set("status1", "selected");
        if (id > 0) {
            /* 租户硬边（#34）：跨租户平台按不存在处理。 */
            OdsPlatform p = await this.OdsPlatform
                .Where(a => a.id == id && a.tenantId == this.TenantId()).FirstAsync();
            if (p == null) { this.Fail(404, "0404", "平台不存在"); }
            d.Set("dialogTitle", "编辑平台");
            d.Set("name", p.name);
            d.Set("code", p.code);
            d.Set("edit", "1");
            d.Set("new", "");
            d.Set("status1", "");
            if (p.status == 1) { d.Set("status1", "selected"); }
            else { d.Set("status0", "selected"); }
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存平台")]
    async void Save() {
        int id = this.InInt("id", 0);
        string name = this.Need("name", "平台名称");
        string code = this.In("code");
        int status = this.InInt("status", 1);
        if (status != 1) { status = 0; }

        if (id > 0) {
            /* 租户硬边（#34）：跨租户平台更新落空即 404。 */
            int n = await this.OdsPlatform.Update()
                .Set(a => a.name, name)
                .Set(a => a.code, code)
                .Set(a => a.status, status)
                .Where(a => a.id == id && a.tenantId == this.TenantId())
                .ExecuteAffrowsAsync();
            if (n <= 0) { this.Fail(404, "0404", "平台不存在"); }
            await this.Note("编辑平台", "#" + Convert.ToString(id) + " " + name, n > 0, "");
            this.Saved("平台已保存");
            return;
        }
        OdsPlatform p = new OdsPlatform();
        p.name = name;
        p.code = code;
        p.status = status;
        p.tenantId = this.TenantId();
        p.createdAt = WebApp.NowSeconds();
        int newId = await this.OdsPlatform.Insert(p).ExecuteIdentityAsync();
        await this.Note("新增平台", "#" + Convert.ToString(newId) + " " + name, newId > 0, "");
        this.Saved("平台已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("启用或禁用平台")]
    async void Status() {
        int id = this.InInt("id", 0);
        int status = this.InInt("status", 1);
        if (status != 1) { status = 0; }
        int n = await this.OdsPlatform.Update()
            .Set(a => a.status, status)
            .Where(a => a.id == id && a.tenantId == this.TenantId())
            .ExecuteAffrowsAsync();
        if (n <= 0) { this.Fail(404, "0404", "平台不存在"); }
        await this.Note("启用或禁用平台", "#" + Convert.ToString(id), n > 0,
            status == 1 ? "启用" : "禁用");
        this.Saved(status == 1 ? "平台已启用" : "平台已禁用");
    }
}
