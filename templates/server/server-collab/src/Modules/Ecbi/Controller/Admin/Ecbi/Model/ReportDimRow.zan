using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Ecbi;

public class ReportDimRow {
    public string key;
    public long sales;
    public int orders;
    public long adCost;

    public ReportDimRow(string key, long sales, int orders, long adCost) {
        this.key = key != null ? key : "";
        this.sales = sales;
        this.orders = orders;
        this.adCost = adCost;
    }
}

