using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Ecbi;

public class ReportDimRow {
    public string key;
    public long sales;
    public int orders;
    public long adCost;

    public ReportDimRow(string key, long sales, int orders, long adCost) {
        this.key = key != null ? key : "";
        this.sales = sales;
        this.orders = orders;
        this.adCost = adCost;
    }
}

/* /admin/ecbi/reports 报表编排：定义「维度 × 指标 × 图表」，运行时按定义聚合订单/推广数据并渲染。外部数据先落到 ods_order/ods_ad，再由报表消费。 */
[Route("admin/ecbi/reports/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("报表编排")]
