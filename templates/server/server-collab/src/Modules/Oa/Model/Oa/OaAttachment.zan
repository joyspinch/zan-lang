using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 附件登记（架构 §2.3 WP-3 / T4）：多态挂载——module 是挂载键
   （oa_doc/crm_customer/flow_inst/flow_task/…），relatedId 是挂载行 id，
   任意业务详情页无需新表即可挂附件区。字节本体在
   data/uploads/t{tenantId}/{yyyyMM}/{随机名}.bin（软隔离下的目录级辅助
   隔离，客户端文件名与路径不进存储名，防遍历），本表只持登记行。 */
[Table(Name = "oa_attachment")]
[Index(Name = "ix_attach_rel", Fields = "tenantId,module,relatedId")]
class OaAttachment {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new OaAttachment() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 挂载模块：flow_inst/flow_task/crm_customer/oa_doc/…。 */
    [Column(StringLength = 16, IsNullable = false)]
    string module;

    /* 挂载行的 id。 */
    [Column(IsNullable = false)]
    int relatedId;

    /* 展示名（客户端原始文件名，仅取 basename 存库）。 */
    [Column(StringLength = 128, IsNullable = false)]
    string fileName;

    /* 存储相对路径：data/uploads/t{n}/{yyyyMM}/{随机名}.bin。 */
    [Column(StringLength = 256, IsNullable = false)]
    string path;

    /* MIME 类型（客户端声明 + 扩展名推断兜底）。 */
    [Column(StringLength = 64, IsNullable = false)]
    string mime;

    /* 字节数（框架流式落盘时的 Content-Length）。 */
    long size;

    /* 上传者账号 id。 */
    [Column(IsNullable = false)]
    int uploaderId;

    long createdAt;
}
