using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 日程事件（T11）：个人日历的存储行。数据面=本人（ownerId==me.id），
   读写均带租户双闸。提醒由 Feature.CalendarRemind.Loop 后台协程扫描
   发送（reminded 抢占式原子置位防多 worker 重发）；待办聚合经
   Feature.CalendarSources.Calendar 实时流出窗（不写 oa_todo 标记行，
   F2 定案）。relatedType/relatedId 一期只透传存储（T15 预留）。 */
[Table(Name = "oa_calendar_event")]
[Index(Name = "ix_event_owner", Fields = "tenantId,ownerId,startAt")]
class OaCalendarEvent {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new OaCalendarEvent() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 所有者：日程是个人数据，Controller 读写均限本人行。 */
    [Column(IsNullable = false)]
    int ownerId;

    /* 标题。 */
    [Column(StringLength = 128, IsNullable = false)]
    string title;

    /* 说明/备注。 */
    [Column(StringLength = 1024)]
    string description;

    /* 开始/结束时间（Unix 秒；表单墙钟按服务端时区基准换算入库）。 */
    [Column(IsNullable = false)]
    long startAt;

    [Column(IsNullable = false)]
    long endAt;

    /* 1=全天（网格事件条不显示时刻）。 */
    [Column(IsNullable = false)]
    int allDay;

    /* 关联业务类型（T15 预留，如 form_booking）：一期只透传存储。 */
    [Column(StringLength = 32)]
    string relatedType;

    /* 关联业务行 id（T15 预留）。 */
    int relatedId;

    /* 提前提醒分钟数：0=不提醒；表单枚举 0/30/60/1440。 */
    [Column(IsNullable = false)]
    int remindMinutes;

    /* 提醒已发送标记：CalendarRemind.Sweep 先 UPDATE ... SET reminded=1
       WHERE id=? AND reminded=0，命中 1 行的 worker 独得发送权。 */
    [Column(IsNullable = false)]
    int reminded;

    long createdAt;

    long updatedAt;
}
