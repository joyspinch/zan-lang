using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 公告已读明细（T12，架构定案 #62）：读时插行——用户打开公告详情且
   无本行时插入（先查后插，ORM 无 upsert 谓词）。UNIQUE 防并发双插
   落双行；未读判定=本表无我的行（公告页红点/Dashboard 卡同源）；
   管理员 Reads 弹窗即本表反查+受众总数算触达率。 */
[Table(Name = "oa_announcement_read")]
[Index(Name = "ux_ann_read", Fields = "tenantId,announcementId,userId", IsUnique = true)]
class OaAnnouncementRead {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new OaAnnouncementRead() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 公告 id。 */
    [Column(IsNullable = false)]
    int announcementId;

    /* 已读用户。 */
    [Column(IsNullable = false)]
    int userId;

    long readAt;
}
