using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 站内私信（T12，架构定案 #62）：独立表不扩 sys_notify——sys_notify 语义
   纯化为「待办型提醒」，私信历史进收件箱页。表结构即 T13 IM 单聊读写面，
   本单定死勿加冗余（sys_seq/群聊 T13 再说，§3.2 版本号机制届时评估）。
   isRead 是收件人维度状态：只按 toId 维度更新（打开会话批量清零），
   决不可按 fromId 写——否则污染对方会话视图的未读数。
   replyTo 一期恒 0（引用回复 T13 评估）。 */
[Table(Name = "oa_message")]
[Index(Name = "ix_msg_to", Fields = "tenantId,toId,isRead,id")]
class OaMessage {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new OaMessage() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 发送人。 */
    [Column(IsNullable = false)]
    int fromId;

    /* 收件人（isRead 归属维度）。 */
    [Column(IsNullable = false)]
    int toId;

    /* 正文（纯文本）。
       列型结论（沿 T9a 口径）：SQLite string 恒 TEXT 无界；MySQL 生成
       VARCHAR(2048) utf8mb4 行限需留意；保存侧 2048 软上限兜底。 */
    [Column(StringLength = 2048, IsNullable = false)]
    string content;

    /* 收件人维度：0 未读 / 1 已读；只按 toId 维度更新。 */
    [Column(IsNullable = false)]
    int isRead;

    /* 引用的消息 id；一期恒 0。 */
    [Column(IsNullable = false)]
    int replyTo;

    long createdAt;
}
