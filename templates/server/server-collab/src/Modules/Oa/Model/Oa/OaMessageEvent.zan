using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 私信回执事件（已读/送达的实时扇出源）：落库即总线——oa_message 表是
   消息总线，本表是回执总线，同款「表即总线 + 每 worker 水位扫描」定案
   （见 MessageRelay）：worker 扫本表水位之上的增量，向消息发送方扇出
   type="ack"/"read" 实时帧，跨 worker 无需抢占式路由。事件只增不改；
   落事件与本地历史（data/chat/，见 ChatLog）同点落笔。
   isRead/isAcked 是 oa_message 上的读模型状态，本表只管扇出与存证。 */
[Table(Name = "oa_message_event")]
[Index(Name = "ix_msg_ev", Fields = "tenantId,id")]
class OaMessageEvent {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，新插入路径由字段初始化器写 1）。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 涉及的消息 id；read 事件 = 本批已读的最大 id（「读到为止」语义，
       对端把 ≤ 该 id 的自己发的消息全部点亮已读）。 */
    [Column(IsNullable = false)]
    int msgId;

    /* 消息发送人 = 回执的接收方（扇出目标）。 */
    [Column(IsNullable = false)]
    int fromId;

    /* 事件行为方 = 消息收件人（谁送达/谁读了）。 */
    [Column(IsNullable = false)]
    int toId;

    /* 1 = 送达（收件人客户端确认收帧）/ 2 = 已读（打开会话或会话内新消息）。 */
    [Column(IsNullable = false)]
    int kind;

    [Column(IsNullable = false)]
    long createdAt;
}
