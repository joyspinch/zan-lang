using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 通知偏好（架构 §2.2 WP-2）：按「模块」粒度的免打扰设置。muted=1 的模块，
   Notify.Send 只落库不推实时帧——铃铛不再被打扰，历史页仍可查。
   每用户每模块至多一行（UNIQUE 索引），首条 Notify.Send 时懒创建缺省行
   （muted=0 即不静默），避免为从未收到通知的人预填全模块。 */
[Table(Name = "sys_notify_pref")]
[Index(Name = "ux_notify_pref", Fields = "tenantId,userId,module", IsUnique = true)]
class SysNotifyPref {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列）。列默认由字段初始化器保证（ORM DDL 无 DEFAULT）。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    [Column(IsNullable = false)]
    int userId;

    /* 业务域，同 sys_notify.module。 */
    [Column(StringLength = 16, IsNullable = false)]
    string module;

    /* 0 正常（默认，缺省行也是它）/ 1 免打扰：只落库不推。 */
    int muted;

    long updatedAt;
}
