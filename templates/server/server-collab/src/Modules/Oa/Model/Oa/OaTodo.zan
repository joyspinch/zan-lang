using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 待办（架构 §2.4 WP-4 / T5）：两个角色——manual 源的真待办行（本人新增的
   个人待办，聚合页直接读），以及虚拟源（flow/crm/wms/calendar/form）的
   完成/忽略标记行。虚拟源的项目不入库，由 Feature.TodoCenter.Gather 实时
   聚合；用户在聚合页点"完成/忽略"时以 (source, relatedType, relatedId)
   落一行 status=1/2 的标记，Gather 按同键过滤。flow 项目的完成状态以
   flow_task.status 为准自然同步（任务办结后源里自然消失），标记行仅兜底。 */
[Table(Name = "oa_todo")]
[Index(Name = "ix_todo_user", Fields = "tenantId,userId,status,dueAt")]
class OaTodo {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new OaTodo() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 指派给谁；0=广播（一期只做指派，广播留待后续）。 */
    [Column(IsNullable = false)]
    int userId;

    /* 来源：manual/flow/wms/crm/calendar/form（虚拟源须与注册名一致）。 */
    [Column(StringLength = 16, IsNullable = false)]
    string source;

    /* 标题。 */
    [Column(StringLength = 128, IsNullable = false)]
    string title;

    /* 一键跳转地址（聚合页整行可点）。 */
    [Column(StringLength = 256)]
    string link;

    /* 截止时间（Unix 秒）；0=无截止，聚合页排在其后有截止项之后。 */
    long dueAt;

    /* 0 待办 / 1 已完成 / 2 已忽略。 */
    [Column(IsNullable = false)]
    int status;

    /* 虚拟源回链键：模块内行类型（如 flow_task/wms_inventory）。 */
    [Column(StringLength = 16)]
    string relatedType;

    /* 虚拟源回链键：行 id。 */
    int relatedId;

    long createdAt;

    /* 完成/忽略时间。 */
    long doneAt;
}
