using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 文档（T9）：挂在空间下的富文本文档，行式块语法由 Blocks 渲染。
   版本快照存 oa_doc_rev（Save 时 +1 落一行）。列型结论（OrmDialect.Ty :360-397）：
   string 在 SQLite 恒为 TEXT（无界，StringLength 值不参与列型）；
   MySQL/MariaDB 物化为 VARCHAR(32768)，utf8mb4 下接近 65535 字节行限——
   模板默认驱动为 sqlite 不受影响，Save 侧另有 30KB 软上限兜底。 */
[Table(Name = "oa_doc")]
[Index(Name = "ix_doc_space", Fields = "tenantId,spaceId,updatedAt")]
class OaDoc {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列）。所有 new OaDoc() 插入路径写 1 基准再赋当前租户。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 所属空间（oa_space.id）。 */
    [Column(IsNullable = false)]
    int spaceId;

    /* 标题。 */
    [Column(StringLength = 128, IsNullable = false)]
    string title;

    /* 行式块语法原文（Blocks.Validate 归一后存储）。 */
    [Column(StringLength = 32768)]
    string content;

    /* 纯文本摘要（Blocks.TextOf 计算），供搜索与列表预览。 */
    [Column(StringLength = 32768)]
    string contentText;

    /* 版本号，Save 递增，与 oa_doc_rev.version 对应。 */
    [Column(IsNullable = false)]
    int version;

    /* 最后编辑人（sys_user.id）。 */
    [Column(IsNullable = false)]
    int updatedBy;

    long createdAt;

    long updatedAt;
}
