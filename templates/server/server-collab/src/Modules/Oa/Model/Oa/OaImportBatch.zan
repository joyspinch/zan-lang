using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 导入批次（架构 §2.6 WP-6 / T6）：每次 CSV 导入落一行——total/ok/fail
   计数与错误报告（JSON [{row,field,msg}]，只留前 200 条防膨胀）。导入
   分批提交（ExcelIo.BATCH=500 行/批，SQLite 锁库对策），行级错误跳过
   不回滚好行，报告完整可追溯。 */
[Table(Name = "oa_import_batch")]
class OaImportBatch {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new OaImportBatch() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 目标模块：crm_customer/crm_contact/wms_sku/ods_order/…。 */
    [Column(StringLength = 16, IsNullable = false)]
    string module;

    /* 上传文件名（仅展示，不参与存储定位）。 */
    [Column(StringLength = 128)]
    string fileName;

    /* 数据行总数 / 成功 / 失败。 */
    int total;

    int ok;

    int fail;

    /* JSON：[{"row":n,"field":f,"msg":m}]，前 200 条。 */
    [Column(StringLength = 32768)]
    string errors;

    /* 操作人账号 id。 */
    [Column(IsNullable = false)]
    int operatorId;

    long createdAt;
}
