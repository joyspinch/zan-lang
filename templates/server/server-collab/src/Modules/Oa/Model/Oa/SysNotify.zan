using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 站内通知（架构 §2.2 WP-2）：跨模块通知中心的唯一落库表——铃铛未读数与历史
   查询的数据源，实时推送走 NotifyHub（WS 主 + SSE 回退）。module 区分业务域
   （flow/wms/crm/ecbi/oa/system），kind 区分事件（assign/mention/done/alert/info）。
   旧 flow_notify 已停写：存量行由 Schema.SeedNotify 一次性迁入本表，旧表只读保留。
   落库格式为 §3.2 sys_seq 版本号机制预留（T13 IM 跨 worker 轮询时启用，单 worker
   期 id 即水位）。 */
[Table(Name = "sys_notify")]
[Index(Name = "ix_notify_user", Fields = "tenantId,userId,isRead,id")]
class SysNotify {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new SysNotify() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 收件人。 */
    [Column(IsNullable = false)]
    int userId;

    /* 业务域：flow/wms/crm/ecbi/oa/system；免打扰按此粒度设置。 */
    [Column(StringLength = 16, IsNullable = false)]
    string module;

    /* 事件类型：assign 派给你 / mention 提及 / done 完结 / alert 告警 / info 通知 / message 新私信（T12，铃铛提醒、历史在私信页）。 */
    [Column(StringLength = 16, IsNullable = false)]
    string kind;

    /* 通知标题（一句话摘要）。 */
    [Column(StringLength = 128, IsNullable = false)]
    string title;

    [Column(StringLength = 256, IsNullable = false)]
    string content;

    /* 站内跳转路径，如 /admin/flow/tasks。 */
    [Column(StringLength = 128)]
    string link;

    /* 0 未读 / 1 已读。 */
    int isRead;

    long createdAt;
}
