using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 表单定义（T14，架构定案 #70）：TEXT 存 JSON 拒 EAV（字段级动态查询
   一期裁剪）；code 租户内唯一（UNIQUE 兜底，Save 侧先查后插同语义）。
   flowDefId 直连 flow_def 不建关联表（避免第三种挂接形态），0=不绑流程。
   status 1 启用 / 0 停用；提交侧只认启用定义。
   schemaJson 列型结论（沿 T9a 口径）：SQLite string 恒 TEXT 无界；
   MySQL 生成 VARCHAR(65536) utf8mb4——单列即超 65535 字节行限，行限风险
   由保存侧 60000 字符软上限兜底（见 Forms.Save），部署 MySQL 前需评估
   （OrmDialect.Ty 无 TEXT 档可让，属引擎层约束）。 */
[Table(Name = "oa_form_def")]
[Index(Name = "ux_form_code", Fields = "tenantId,code", IsUnique = true)]
class OaFormDef {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new OaFormDef() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 机器名 [a-z0-9_]，租户内唯一（UNIQUE ux_form_code）。 */
    [Column(StringLength = 64, IsNullable = false)]
    string code;

    [Column(StringLength = 128, IsNullable = false)]
    string name;

    [Column(StringLength = 512)]
    string description;

    /* 表单 schema JSON：{"fields":[{code,label,type,required,min,max,
       maxlen,options,optionsSrc}...]}。结构由 FormSchema.Parse 校验，
       非法不入库。 */
    [Column(StringLength = 65536, IsNullable = false)]
    string schemaJson;

    /* 1 启用 / 0 停用；停用后填报入口不可再提交（历史提交详情不受影响）。 */
    [Column(IsNullable = false)]
    int status;

    /* 绑定的流程定义 id；0=不绑流程（纯数据收集）。 */
    [Column(IsNullable = false)]
    int flowDefId;

    [Column(IsNullable = false)]
    int createdBy;

    long createdAt;

    long updatedAt;
}
