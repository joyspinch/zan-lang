using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 表单提交数据（T15，架构定案 #70）：TEXT 存 JSON 拒 EAV；status 只两档
   0 草稿 / 1 已提交，审批状态按 instId 现查 flow_inst 实时推导、永不回写
   （单一事实源在 flow_inst，回写必漂移）。schemaSnapshot 提交时快照
   def.schemaJson——定义后续改版不影响历史提交详情渲染与导出（历史强一致）。
   dataJson 经标准 JSON 序列化落库（JsonValue.ToJson，textarea 换行转义为
   \n 字面量），勿手工拼接（Bug#8 同族防线）。
   dataJson/schemaSnapshot 列型结论（沿 T9a 口径）：SQLite string 恒 TEXT
   无界；MySQL 生成 VARCHAR(65536) utf8mb4 超行限——提交侧 60000 字符
   软上限兜底，部署 MySQL 前需评估（OrmDialect.Ty 引擎层约束）。 */
[Table(Name = "oa_form_data")]
[Index(Name = "ix_formdata", Fields = "tenantId,formId,status,id")]
class OaFormData {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new OaFormData() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 所属表单定义。 */
    [Column(IsNullable = false)]
    int formId;

    /* 提交数据 JSON：{"字段code":"值"} 或 checkbox 为 ["v1","v2"]。 */
    [Column(StringLength = 65536, IsNullable = false)]
    string dataJson;

    /* 提交时 def.schemaJson 快照（历史强一致：def 改版不影响本行渲染）。 */
    [Column(StringLength = 65536, IsNullable = false)]
    string schemaSnapshot;

    /* 列表摘要：首字段值折行截 60 字。 */
    [Column(StringLength = 256)]
    string summary;

    /* 0 草稿 / 1 已提交；审批状态不落本表（instId 推导）。 */
    [Column(IsNullable = false)]
    int status;

    [Column(IsNullable = false)]
    int submitterId;

    /* 发起的流程实例 id；0=未绑流程或草稿。 */
    [Column(IsNullable = false)]
    int instId;

    long createdAt;

    long updatedAt;
}
