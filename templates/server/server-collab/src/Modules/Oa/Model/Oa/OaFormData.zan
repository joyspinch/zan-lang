using System.Data.Orm;

namespace Zan.Web.Model.Oa;

/* 表单提交数据（T15）：TEXT 存 JSON；status 只两档 0 草稿 / 1 已提交，
   审批状态按 instId 查 flow_inst 实时推导。
   schemaSnapshot 提交时快照 def.schemaJson，def 改版不影响历史提交渲染。
   dataJson 经标准 JSON 序列化落库（JsonWriter.ToJson）。 */
[Table(Name = "oa_form_data")]
[Index(Name = "ix_formdata", Fields = "tenantId,formId,status,id")]
public class OaFormData {
    [Column(IsIdentity = true)]
    public int id;

    /* 归属租户 */
    [Column(IsNullable = false)]
    public int tenantId = 1;

    /* 所属表单定义 */
    [Column(IsNullable = false)]
    public int formId;

    /* 提交数据 JSON：{"字段code":"值"} 或 checkbox 为 ["v1","v2"] */
    [Column(StringLength = 65536, IsNullable = false)]
    public string dataJson;

    /* 提交时 def.schemaJson 快照 */
    [Column(StringLength = 65536, IsNullable = false)]
    public string schemaSnapshot;

    /* 列表摘要：首字段值折行截 60 字 */
    [Column(StringLength = 256)]
    public string summary;

    /* 0 草稿 / 1 已提交；审批状态按 instId 推导 */
    [Column(IsNullable = false)]
    public int status;

    [Column(IsNullable = false)]
    public int submitterId;

    /* 发起的流程实例 id；0=未绑流程或草稿 */
    [Column(IsNullable = false)]
    public int instId;

    public long createdAt;

    public long updatedAt;
}
