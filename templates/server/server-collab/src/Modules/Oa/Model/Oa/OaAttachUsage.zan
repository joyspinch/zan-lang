using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 租户附件配额计数：每租户一行，usedBytes 是配额唯一判据——
   Attachment.Save 以单条条件 UPDATE 原子预占（并发上传在同一处判定，
   affected=0 即超限），删除路径经 Attachment.Release 扣减（MAX 钳 0，
   漂移只允许向保守侧）。行由 Schema.EnsureAttachUsage 启动回填
   （按 oa_attachment 存量求和建行，幂等）。 */
[Table(Name = "oa_attach_usage")]
class OaAttachUsage {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，新插入路径由字段初始化器写 1）。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 已用字节数（登记行 size 的租户合计，含删除未及扣减的窗口差）。 */
    long usedBytes;

    long updatedAt;
}
