using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 公告（T12，架构定案 #62）：独立表不扩 sys_notify——全员公告逐人写
   通知是 500 行插入+未读数膨胀的纯噪声；触达=Dashboard 卡+登录弹窗
   一次+公告页红点。deptIds 逗号串空=本租户全员；否则部门成员读时
   现算（组织变动受众跟随、新员工见历史公告）。已读=已读明细表读时
   插行（OaAnnouncementRead），本表不存已读计数（并发计数漂移）。
   附件挂 module="announce"（T4 Attachment 特性零改动）。 */
[Table(Name = "oa_announcement")]
[Index(Name = "ix_ann_list", Fields = "tenantId,pinned,id")]
class OaAnnouncement {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new OaAnnouncement() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 标题。 */
    [Column(StringLength = 128, IsNullable = false)]
    string title;

    /* 正文（纯文本，视图转义+pre-wrap 展示）。
       列型结论（沿 T9a 口径）：SQLite string 恒 TEXT 无界；MySQL 生成
       VARCHAR(8192) utf8mb4 行限需留意；保存侧 8192 软上限兜底。 */
    [Column(StringLength = 8192)]
    string content;

    /* 受众部门 id 逗号串；空=本租户全员。包含判定用 AuthUser.Holds
       （逗号精确匹配，防 1 撞 11），成员现算走 departmentId IN 列表。 */
    [Column(StringLength = 256)]
    string deptIds;

    /* 1=置顶（列表首列排序）；仅持 Update 位者可设。 */
    [Column(IsNullable = false)]
    int pinned;

    /* 发布人；删除权=发布者本人或超管。 */
    [Column(IsNullable = false)]
    int publisherId;

    long createdAt;

    long updatedAt;
}
