using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 文档空间（T9）：文档的分组容器。readRoles/writeRoles 一期语义：
   列先建不启用——空串=本租户全员可读 / 持有 Update 位者可写；
   后续接角色名逗号串再做行级判定。空间非空（内有文档）时禁删，
   不做跨表级联（Bug#5 教训：级联必须显式受控）。 */
[Table(Name = "oa_space")]
[Index(Name = "ix_space_tenant", Fields = "tenantId,id")]
class OaSpace {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new OaSpace() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 空间名。 */
    [Column(StringLength = 64, IsNullable = false)]
    string name;

    /* 说明。 */
    [Column(StringLength = 256)]
    string description;

    /* 可读角色名逗号串；空=本租户全员可读（一期不启用）。 */
    [Column(StringLength = 256)]
    string readRoles;

    /* 可写角色名逗号串；空=持有 Update 位者可写（一期不启用）。 */
    [Column(StringLength = 256)]
    string writeRoles;

    long createdAt;

    long updatedAt;
}
