using System.Data.Orm;

namespace ZanWeb.Model.Oa;

/* 文档版本快照（T9）：每次 Save 在 oa_doc 上 version+1 的同时落一行，
   History 页按 version 倒序展示。只增不改不删（删文档时随 docId 级联，
   显式受控，Bug#5 教训）。 */
[Table(Name = "oa_doc_rev")]
[Index(Name = "ix_docrev_doc", Fields = "tenantId,docId,version")]
class OaDocRev {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列）。所有 new OaDocRev() 插入路径写 1 基准再赋当前租户。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 所属文档（oa_doc.id）。 */
    [Column(IsNullable = false)]
    int docId;

    /* 快照对应的版本号（与 oa_doc.version 一致）。 */
    [Column(IsNullable = false)]
    int version;

    /* 快照时的标题。 */
    [Column(StringLength = 128, IsNullable = false)]
    string title;

    /* 快照时的 content 原文。 */
    [Column(StringLength = 32768)]
    string content;

    /* 编辑人（sys_user.id）。 */
    [Column(IsNullable = false)]
    int editorId;

    long createdAt;
}
