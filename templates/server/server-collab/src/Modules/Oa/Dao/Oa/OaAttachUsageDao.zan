using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaAttachUsage 强类型数据访问网关（FreeSql 风格） */
class OaAttachUsageDao {
    IDbConnection db;

    OaAttachUsageDao(IDbConnection db) {
        this.db = db;
    }

    async OaAttachUsage ById(int id) {
        return await this.db.Select<OaAttachUsage>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaAttachUsage> All() {
        return await this.db.Select<OaAttachUsage>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OaAttachUsage>().CountAsync();
    }

    async int Insert(OaAttachUsage entity) {
        return await this.db.Insert<OaAttachUsage>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OaAttachUsage>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int TryAcquireQuota(int tenantId, long size, long quota, long now) {
        return await this.db.ExecuteAsync(
            "UPDATE oa_attach_usage SET usedBytes = usedBytes + "
            + Convert.ToString(size) + ", updatedAt = " + Convert.ToString(now)
            + " WHERE tenantId = " + Convert.ToString(tenantId)
            + " AND usedBytes + " + Convert.ToString(size)
            + " <= " + Convert.ToString(quota));
    }

    async void ReleaseQuota(int tenantId, long size) {
        await this.db.ExecuteAsync(
            "UPDATE oa_attach_usage SET usedBytes = MAX(0, usedBytes - "
            + Convert.ToString(size) + ") WHERE tenantId = "
            + Convert.ToString(tenantId));
    }
}
