using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Oa;

namespace Zan.Web.Dao.Oa;

/* OaAttachUsage 强类型数据访问网关（ZanSql 风格） */
public class OaAttachUsageDao : BaseRepository<OaAttachUsage> {
    public OaAttachUsageDao() : base() {}
    OaAttachUsageDao(IZanSql fsql) : base(fsql) {}
    OaAttachUsageDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async OaAttachUsage ById(int id) {
        return await this.GetExecutor().Select<OaAttachUsage>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaAttachUsage> All() {
        return await this.GetExecutor().Select<OaAttachUsage>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<OaAttachUsage>().CountAsync();
    }

    async int Insert(OaAttachUsage entity) {
        return await this.GetExecutor().Insert<OaAttachUsage>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<OaAttachUsage>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int TryAcquireQuota(int tenantId, long size, long quota, long now) {
        return await this.GetExecutor().ExecuteAsync(
            "UPDATE oa_attach_usage SET usedBytes = usedBytes + "
            + Convert.ToString(size) + ", updatedAt = " + Convert.ToString(now)
            + " WHERE tenantId = " + Convert.ToString(tenantId)
            + " AND usedBytes + " + Convert.ToString(size)
            + " <= " + Convert.ToString(quota));
    }

    async void ReleaseQuota(int tenantId, long size) {
        await this.GetExecutor().ExecuteAsync(
            "UPDATE oa_attach_usage SET usedBytes = MAX(0, usedBytes - "
            + Convert.ToString(size) + ") WHERE tenantId = "
            + Convert.ToString(tenantId));
    }
}
