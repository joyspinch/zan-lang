using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Oa;

namespace Zan.Web.Dao.Oa;

/* OaDoc 强类型数据访问网关（ZanSql 风格） */
public class OaDocDao : BaseRepository<OaDoc> {
    public OaDocDao() : base() {}
    public OaDocDao(IZanSql fsql) : base(fsql) {}
    public OaDocDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OaDoc ById(int id) {
        return await this.GetExecutor().Select<OaDoc>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OaDoc> All() {
        return await this.GetExecutor().Select<OaDoc>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OaDoc>().CountAsync();
    }

    public InsertQuery<OaDoc> Insert(OaDoc entity) {
        return this.GetExecutor().Insert<OaDoc>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OaDoc>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async List<OaDoc> Search(int tenantId, string kw, int limit) {
        return await this.GetExecutor().Select<OaDoc>()
            .Where(a => a.tenantId == tenantId
                && (a.title.Contains(kw) || a.contentText.Contains(kw)))
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }
}
