using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaDoc 强类型数据访问网关（FreeSql 风格） */
class OaDocDao : BaseRepository<OaDoc> {
    OaDocDao(IFreeSql fsql) : base(fsql) {}
    OaDocDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async OaDoc ById(int id) {
        return await this.GetExecutor().Select<OaDoc>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaDoc> All() {
        return await this.GetExecutor().Select<OaDoc>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<OaDoc>().CountAsync();
    }

    async int Insert(OaDoc entity) {
        return await this.GetExecutor().Insert<OaDoc>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<OaDoc>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async List<OaDoc> Search(int tenantId, string kw, int limit) {
        return await this.GetExecutor().Select<OaDoc>()
            .Where(a => a.tenantId == tenantId
                && (a.title.Contains(kw) || a.contentText.Contains(kw)))
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }
}
