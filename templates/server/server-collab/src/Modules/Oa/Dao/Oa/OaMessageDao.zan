using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Oa;

namespace Zan.Web.Dao.Oa;

/* OaMessage 强类型数据访问网关（ZanSql 风格） */
public class OaMessageDao : BaseRepository<OaMessage> {
    public OaMessageDao() : base() {}
    OaMessageDao(IZanSql fsql) : base(fsql) {}
    OaMessageDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async OaMessage ById(int id) {
        return await this.GetExecutor().Select<OaMessage>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaMessage> All() {
        return await this.GetExecutor().Select<OaMessage>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<OaMessage>().CountAsync();
    }

    async int Insert(OaMessage entity) {
        return await this.GetExecutor().Insert<OaMessage>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<OaMessage>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
