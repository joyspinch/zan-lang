using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaMessage 强类型数据访问网关（FreeSql 风格） */
class OaMessageDao {
    IDbConnection db;

    OaMessageDao(IDbConnection db) {
        this.db = db;
    }

    async OaMessage ById(int id) {
        return await this.db.Select<OaMessage>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaMessage> All() {
        return await this.db.Select<OaMessage>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OaMessage>().CountAsync();
    }

    async int Insert(OaMessage entity) {
        return await this.db.Insert<OaMessage>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OaMessage>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
