using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* SysNotifyPref 强类型数据访问网关（FreeSql 风格） */
class SysNotifyPrefDao : BaseRepository<SysNotifyPref> {
    SysNotifyPrefDao(IFreeSql fsql) : base(fsql) {}
    SysNotifyPrefDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async SysNotifyPref ById(int id) {
        return await this.GetExecutor().Select<SysNotifyPref>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysNotifyPref> All() {
        return await this.GetExecutor().Select<SysNotifyPref>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<SysNotifyPref>().CountAsync();
    }

    async int Insert(SysNotifyPref entity) {
        return await this.GetExecutor().Insert<SysNotifyPref>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<SysNotifyPref>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async SysNotifyPref ByModule(int tenantId, int userId, string module) {
        return await this.GetExecutor().Select<SysNotifyPref>()
            .Where(a => a.tenantId == tenantId && a.userId == userId && a.module == module)
            .FirstAsync();
    }
}
