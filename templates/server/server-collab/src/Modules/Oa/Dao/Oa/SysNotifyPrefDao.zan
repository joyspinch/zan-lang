using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Oa;

namespace Zan.Web.Dao.Oa;

/* SysNotifyPref 强类型数据访问网关（ZanSql 风格） */
public class SysNotifyPrefDao : BaseRepository<SysNotifyPref> {
    public SysNotifyPrefDao() : base() {}
    public SysNotifyPrefDao(IZanSql fsql) : base(fsql) {}
    public SysNotifyPrefDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async SysNotifyPref ById(int id) {
        return await this.GetExecutor().Select<SysNotifyPref>().Where(a => a.id == id).FirstAsync();
    }

    public async List<SysNotifyPref> All() {
        return await this.GetExecutor().Select<SysNotifyPref>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<SysNotifyPref>().CountAsync();
    }

    public InsertQuery<SysNotifyPref> Insert(SysNotifyPref entity) {
        return this.GetExecutor().Insert<SysNotifyPref>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<SysNotifyPref>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async SysNotifyPref ByModule(int tenantId, int userId, string module) {
        return await this.GetExecutor().Select<SysNotifyPref>()
            .Where(a => a.tenantId == tenantId && a.userId == userId && a.module == module)
            .FirstAsync();
    }
}
