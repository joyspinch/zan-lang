using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaCalendarEvent 强类型数据访问网关（FreeSql 风格） */
class OaCalendarEventDao {
    IDbConnection db;

    OaCalendarEventDao(IDbConnection db) {
        this.db = db;
    }

    async OaCalendarEvent ById(int id) {
        return await this.db.Select<OaCalendarEvent>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaCalendarEvent> All() {
        return await this.db.Select<OaCalendarEvent>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OaCalendarEvent>().CountAsync();
    }

    async int Insert(OaCalendarEvent entity) {
        return await this.db.Insert<OaCalendarEvent>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OaCalendarEvent>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async List<OaCalendarEvent> CandidateReminds(long now, long graceSeconds) {
        return await this.db.Select<OaCalendarEvent>()
            .Where(a => a.remindMinutes > 0 && a.reminded == 0
                && a.startAt > now - graceSeconds
                && a.startAt <= now + 86400)
            .ToListAsync();
    }

    async int MarkReminded(int id) {
        return await this.db.Update<OaCalendarEvent>()
            .Set(a => a.reminded, 1)
            .Where(a => a.id == id && a.reminded == 0)
            .ExecuteAffrowsAsync();
    }

    async List<OaCalendarEvent> UpcomingEvents(int tenantId, int ownerId, long start, long end) {
        return await this.db.Select<OaCalendarEvent>()
            .Where(a => a.tenantId == tenantId && a.ownerId == ownerId
                && a.startAt >= start && a.startAt < end)
            .OrderBy(a => a.startAt)
            .ToListAsync();
    }
}
