using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Oa;

namespace Zan.Web.Dao.Oa;

/* OaCalendarEvent 强类型数据访问网关（ZanSql 风格） */
public class OaCalendarEventDao : BaseRepository<OaCalendarEvent> {
    public OaCalendarEventDao() : base() {}
    public OaCalendarEventDao(IZanSql fsql) : base(fsql) {}
    public OaCalendarEventDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OaCalendarEvent ById(int id) {
        return await this.GetExecutor().Select<OaCalendarEvent>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OaCalendarEvent> All() {
        return await this.GetExecutor().Select<OaCalendarEvent>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OaCalendarEvent>().CountAsync();
    }

    public InsertQuery<OaCalendarEvent> Insert(OaCalendarEvent entity) {
        return this.GetExecutor().Insert<OaCalendarEvent>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OaCalendarEvent>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async List<OaCalendarEvent> CandidateReminds(long now, long graceSeconds) {
        return await this.GetExecutor().Select<OaCalendarEvent>()
            .Where(a => a.remindMinutes > 0 && a.reminded == 0
                && a.startAt > now - graceSeconds
                && a.startAt <= now + 86400)
            .ToListAsync();
    }

    public async int MarkReminded(int id) {
        return await this.GetExecutor().Update<OaCalendarEvent>()
            .Set(a => a.reminded, 1)
            .Where(a => a.id == id && a.reminded == 0)
            .ExecuteAffrowsAsync();
    }

    public async List<OaCalendarEvent> UpcomingEvents(int tenantId, int ownerId, long start, long end) {
        return await this.GetExecutor().Select<OaCalendarEvent>()
            .Where(a => a.tenantId == tenantId && a.ownerId == ownerId
                && a.startAt >= start && a.startAt < end)
            .OrderBy(a => a.startAt)
            .ToListAsync();
    }
}
