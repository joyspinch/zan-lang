using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaAnnouncementRead 强类型数据访问网关（FreeSql 风格） */
class OaAnnouncementReadDao {
    IDbConnection db;

    OaAnnouncementReadDao(IDbConnection db) {
        this.db = db;
    }

    async OaAnnouncementRead ById(int id) {
        return await this.db.Select<OaAnnouncementRead>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaAnnouncementRead> All() {
        return await this.db.Select<OaAnnouncementRead>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OaAnnouncementRead>().CountAsync();
    }

    async int Insert(OaAnnouncementRead entity) {
        return await this.db.Insert<OaAnnouncementRead>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OaAnnouncementRead>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
