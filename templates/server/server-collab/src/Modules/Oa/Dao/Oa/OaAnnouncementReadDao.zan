using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Oa;

namespace Zan.Web.Dao.Oa;

/* OaAnnouncementRead 强类型数据访问网关（ZanSql 风格） */
public class OaAnnouncementReadDao : BaseRepository<OaAnnouncementRead> {
    public OaAnnouncementReadDao() : base() {}
    public OaAnnouncementReadDao(IZanSql fsql) : base(fsql) {}
    public OaAnnouncementReadDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OaAnnouncementRead ById(int id) {
        return await this.GetExecutor().Select<OaAnnouncementRead>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OaAnnouncementRead> All() {
        return await this.GetExecutor().Select<OaAnnouncementRead>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OaAnnouncementRead>().CountAsync();
    }

    public InsertQuery<OaAnnouncementRead> Insert(OaAnnouncementRead entity) {
        return this.GetExecutor().Insert<OaAnnouncementRead>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OaAnnouncementRead>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
