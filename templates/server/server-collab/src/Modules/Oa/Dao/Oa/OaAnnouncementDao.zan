using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Oa;

namespace Zan.Web.Dao.Oa;

/* OaAnnouncement 强类型数据访问网关（ZanSql 风格） */
public class OaAnnouncementDao : BaseRepository<OaAnnouncement> {
    public OaAnnouncementDao() : base() {}
    public OaAnnouncementDao(IZanSql fsql) : base(fsql) {}
    public OaAnnouncementDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OaAnnouncement ById(int id) {
        return await this.GetExecutor().Select<OaAnnouncement>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OaAnnouncement> All() {
        return await this.GetExecutor().Select<OaAnnouncement>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OaAnnouncement>().CountAsync();
    }

    public InsertQuery<OaAnnouncement> Insert(OaAnnouncement entity) {
        return this.GetExecutor().Insert<OaAnnouncement>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OaAnnouncement>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
