using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaAnnouncement 强类型数据访问网关（FreeSql 风格） */
class OaAnnouncementDao {
    IDbConnection db;

    OaAnnouncementDao(IDbConnection db) {
        this.db = db;
    }

    async OaAnnouncement ById(int id) {
        return await this.db.Select<OaAnnouncement>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaAnnouncement> All() {
        return await this.db.Select<OaAnnouncement>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OaAnnouncement>().CountAsync();
    }

    async int Insert(OaAnnouncement entity) {
        return await this.db.Insert<OaAnnouncement>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OaAnnouncement>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
