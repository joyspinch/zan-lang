using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Oa;

namespace Zan.Web.Dao.Oa;

/* OaMessageEvent 强类型数据访问网关（ZanSql 风格） */
public class OaMessageEventDao : BaseRepository<OaMessageEvent> {
    public OaMessageEventDao() : base() {}
    public OaMessageEventDao(IZanSql fsql) : base(fsql) {}
    public OaMessageEventDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OaMessageEvent ById(int id) {
        return await this.GetExecutor().Select<OaMessageEvent>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OaMessageEvent> All() {
        return await this.GetExecutor().Select<OaMessageEvent>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OaMessageEvent>().CountAsync();
    }

    public InsertQuery<OaMessageEvent> Insert(OaMessageEvent entity) {
        return this.GetExecutor().Insert<OaMessageEvent>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OaMessageEvent>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
