using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaMessageEvent 强类型数据访问网关（FreeSql 风格） */
class OaMessageEventDao {
    IDbConnection db;

    OaMessageEventDao(IDbConnection db) {
        this.db = db;
    }

    async OaMessageEvent ById(int id) {
        return await this.db.Select<OaMessageEvent>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaMessageEvent> All() {
        return await this.db.Select<OaMessageEvent>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OaMessageEvent>().CountAsync();
    }

    async int Insert(OaMessageEvent entity) {
        return await this.db.Insert<OaMessageEvent>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OaMessageEvent>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
