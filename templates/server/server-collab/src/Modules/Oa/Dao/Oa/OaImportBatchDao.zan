using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaImportBatch 强类型数据访问网关（FreeSql 风格） */
class OaImportBatchDao : BaseRepository<OaImportBatch> {
    OaImportBatchDao(IFreeSql fsql) : base(fsql) {}
    OaImportBatchDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async OaImportBatch ById(int id) {
        return await this.GetExecutor().Select<OaImportBatch>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaImportBatch> All() {
        return await this.GetExecutor().Select<OaImportBatch>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<OaImportBatch>().CountAsync();
    }

    async int Insert(OaImportBatch entity) {
        return await this.GetExecutor().Insert<OaImportBatch>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<OaImportBatch>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async OaImportBatch ByTenantAndId(int tenantId, int id) {
        return await this.GetExecutor().Select<OaImportBatch>()
            .Where(a => a.id == id && a.tenantId == tenantId)
            .FirstAsync();
    }
}
