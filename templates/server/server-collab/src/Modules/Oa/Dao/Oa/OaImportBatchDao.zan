using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaImportBatch 强类型数据访问网关（FreeSql 风格） */
class OaImportBatchDao {
    IDbConnection db;

    OaImportBatchDao(IDbConnection db) {
        this.db = db;
    }

    async OaImportBatch ById(int id) {
        return await this.db.Select<OaImportBatch>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaImportBatch> All() {
        return await this.db.Select<OaImportBatch>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OaImportBatch>().CountAsync();
    }

    async int Insert(OaImportBatch entity) {
        return await this.db.Insert<OaImportBatch>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OaImportBatch>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async OaImportBatch ByTenantAndId(int tenantId, int id) {
        return await this.db.Select<OaImportBatch>()
            .Where(a => a.id == id && a.tenantId == tenantId)
            .FirstAsync();
    }
}
