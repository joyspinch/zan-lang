using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Oa;

namespace Zan.Web.Dao.Oa;

/* OaImportBatch 强类型数据访问网关（ZanSql 风格） */
public class OaImportBatchDao : BaseRepository<OaImportBatch> {
    public OaImportBatchDao() : base() {}
    public OaImportBatchDao(IZanSql fsql) : base(fsql) {}
    public OaImportBatchDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OaImportBatch ById(int id) {
        return await this.GetExecutor().Select<OaImportBatch>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OaImportBatch> All() {
        return await this.GetExecutor().Select<OaImportBatch>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OaImportBatch>().CountAsync();
    }

    public InsertQuery<OaImportBatch> Insert(OaImportBatch entity) {
        return this.GetExecutor().Insert<OaImportBatch>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OaImportBatch>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async OaImportBatch ByTenantAndId(int tenantId, int id) {
        return await this.GetExecutor().Select<OaImportBatch>()
            .Where(a => a.id == id && a.tenantId == tenantId)
            .FirstAsync();
    }
}
