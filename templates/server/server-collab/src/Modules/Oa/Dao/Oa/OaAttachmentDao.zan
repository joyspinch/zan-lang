using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Oa;

namespace Zan.Web.Dao.Oa;

/* OaAttachment 强类型数据访问网关（ZanSql 风格） */
public class OaAttachmentDao : BaseRepository<OaAttachment> {
    public OaAttachmentDao() : base() {}
    public OaAttachmentDao(IZanSql fsql) : base(fsql) {}
    public OaAttachmentDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OaAttachment ById(int id) {
        return await this.GetExecutor().Select<OaAttachment>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OaAttachment> All() {
        return await this.GetExecutor().Select<OaAttachment>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OaAttachment>().CountAsync();
    }

    public InsertQuery<OaAttachment> Insert(OaAttachment entity) {
        return this.GetExecutor().Insert<OaAttachment>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OaAttachment>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
