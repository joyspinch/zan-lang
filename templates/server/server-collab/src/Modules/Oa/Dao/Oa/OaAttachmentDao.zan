using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaAttachment 强类型数据访问网关（FreeSql 风格） */
class OaAttachmentDao : BaseRepository<OaAttachment> {
    OaAttachmentDao(IFreeSql fsql) : base(fsql) {}
    OaAttachmentDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async OaAttachment ById(int id) {
        return await this.GetExecutor().Select<OaAttachment>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaAttachment> All() {
        return await this.GetExecutor().Select<OaAttachment>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<OaAttachment>().CountAsync();
    }

    async int Insert(OaAttachment entity) {
        return await this.GetExecutor().Insert<OaAttachment>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<OaAttachment>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
