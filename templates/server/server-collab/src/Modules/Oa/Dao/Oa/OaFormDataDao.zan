using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaFormData 强类型数据访问网关（ZanSql 风格） */
public class OaFormDataDao : BaseRepository<OaFormData> {
    OaFormDataDao(IZanSql fsql) : base(fsql) {}
    OaFormDataDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async OaFormData ById(int id) {
        return await this.GetExecutor().Select<OaFormData>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaFormData> All() {
        return await this.GetExecutor().Select<OaFormData>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<OaFormData>().CountAsync();
    }

    async int Insert(OaFormData entity) {
        return await this.GetExecutor().Insert<OaFormData>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<OaFormData>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
