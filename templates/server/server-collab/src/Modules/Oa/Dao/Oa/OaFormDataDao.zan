using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Oa;

namespace Zan.Web.Dao.Oa;

/* OaFormData 强类型数据访问网关（ZanSql 风格） */
public class OaFormDataDao : BaseRepository<OaFormData> {
    public OaFormDataDao() : base() {}
    public OaFormDataDao(IZanSql fsql) : base(fsql) {}
    public OaFormDataDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OaFormData ById(int id) {
        return await this.GetExecutor().Select<OaFormData>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OaFormData> All() {
        return await this.GetExecutor().Select<OaFormData>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OaFormData>().CountAsync();
    }

    public InsertQuery<OaFormData> Insert(OaFormData entity) {
        return this.GetExecutor().Insert<OaFormData>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OaFormData>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
