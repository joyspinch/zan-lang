using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaFormData 强类型数据访问网关（FreeSql 风格） */
class OaFormDataDao {
    IDbConnection db;

    OaFormDataDao(IDbConnection db) {
        this.db = db;
    }

    async OaFormData ById(int id) {
        return await this.db.Select<OaFormData>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaFormData> All() {
        return await this.db.Select<OaFormData>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OaFormData>().CountAsync();
    }

    async int Insert(OaFormData entity) {
        return await this.db.Insert<OaFormData>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OaFormData>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
