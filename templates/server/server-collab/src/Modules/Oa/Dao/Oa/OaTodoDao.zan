using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaTodo 强类型数据访问网关（FreeSql 风格） */
class OaTodoDao {
    IDbConnection db;

    OaTodoDao(IDbConnection db) {
        this.db = db;
    }

    async OaTodo ById(int id) {
        return await this.db.Select<OaTodo>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaTodo> All() {
        return await this.db.Select<OaTodo>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OaTodo>().CountAsync();
    }

    async int Insert(OaTodo entity) {
        return await this.db.Insert<OaTodo>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OaTodo>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async List<OaTodo> ActiveManual(int tenantId, int userId) {
        return await this.db.Select<OaTodo>()
            .Where(a => a.tenantId == tenantId && a.userId == userId
                && a.source == "manual" && a.status == 0)
            .ToListAsync();
    }

    async List<OaTodo> DoneMarks(int tenantId, int userId) {
        return await this.db.Select<OaTodo>()
            .Where(a => a.tenantId == tenantId && a.userId == userId
                && a.status != 0 && a.source != "manual")
            .ToListAsync();
    }

    async OaTodo FindManual(int tenantId, int userId, int id) {
        return await this.db.Select<OaTodo>()
            .Where(a => a.tenantId == tenantId && a.userId == userId
                && a.id == id && a.source == "manual")
            .FirstAsync();
    }

    async OaTodo FindMark(int tenantId, int userId, string source, string relatedType, int relatedId) {
        return await this.db.Select<OaTodo>()
            .Where(a => a.tenantId == tenantId && a.userId == userId
                && a.source == source && a.relatedType == relatedType
                && a.relatedId == relatedId)
            .FirstAsync();
    }

    async int UpdateStatus(int id, int status, long doneAt) {
        return await this.db.Update<OaTodo>()
            .Set(a => a.status, status)
            .Set(a => a.doneAt, doneAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }
}
