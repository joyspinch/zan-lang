using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Oa;

namespace Zan.Web.Dao.Oa;

/* OaTodo 强类型数据访问网关（ZanSql 风格） */
public class OaTodoDao : BaseRepository<OaTodo> {
    public OaTodoDao() : base() {}
    public OaTodoDao(IZanSql fsql) : base(fsql) {}
    public OaTodoDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OaTodo ById(int id) {
        return await this.GetExecutor().Select<OaTodo>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OaTodo> All() {
        return await this.GetExecutor().Select<OaTodo>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OaTodo>().CountAsync();
    }

    public InsertQuery<OaTodo> Insert(OaTodo entity) {
        return this.GetExecutor().Insert<OaTodo>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OaTodo>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async List<OaTodo> ActiveManual(int tenantId, int userId) {
        return await this.GetExecutor().Select<OaTodo>()
            .Where(a => a.tenantId == tenantId && a.userId == userId
                && a.source == "manual" && a.status == 0)
            .ToListAsync();
    }

    public async List<OaTodo> DoneMarks(int tenantId, int userId) {
        return await this.GetExecutor().Select<OaTodo>()
            .Where(a => a.tenantId == tenantId && a.userId == userId
                && a.status != 0 && a.source != "manual")
            .ToListAsync();
    }

    public async OaTodo FindManual(int tenantId, int userId, int id) {
        return await this.GetExecutor().Select<OaTodo>()
            .Where(a => a.tenantId == tenantId && a.userId == userId
                && a.id == id && a.source == "manual")
            .FirstAsync();
    }

    public async OaTodo FindMark(int tenantId, int userId, string source, string relatedType, int relatedId) {
        return await this.GetExecutor().Select<OaTodo>()
            .Where(a => a.tenantId == tenantId && a.userId == userId
                && a.source == source && a.relatedType == relatedType
                && a.relatedId == relatedId)
            .FirstAsync();
    }

    public async int UpdateStatus(int id, int status, long doneAt) {
        return await this.GetExecutor().Update<OaTodo>()
            .Set(a => a.status, status)
            .Set(a => a.doneAt, doneAt)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }
}
