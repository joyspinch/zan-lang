using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaSpace 强类型数据访问网关（FreeSql 风格） */
class OaSpaceDao {
    IDbConnection db;

    OaSpaceDao(IDbConnection db) {
        this.db = db;
    }

    async OaSpace ById(int id) {
        return await this.db.Select<OaSpace>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaSpace> All() {
        return await this.db.Select<OaSpace>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OaSpace>().CountAsync();
    }

    async int Insert(OaSpace entity) {
        return await this.db.Insert<OaSpace>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OaSpace>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
