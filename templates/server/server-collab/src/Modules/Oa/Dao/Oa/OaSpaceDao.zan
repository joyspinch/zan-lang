using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaSpace 强类型数据访问网关（FreeSql 风格） */
class OaSpaceDao : BaseRepository<OaSpace> {
    OaSpaceDao(IFreeSql fsql) : base(fsql) {}
    OaSpaceDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async OaSpace ById(int id) {
        return await this.GetExecutor().Select<OaSpace>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaSpace> All() {
        return await this.GetExecutor().Select<OaSpace>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<OaSpace>().CountAsync();
    }

    async int Insert(OaSpace entity) {
        return await this.GetExecutor().Insert<OaSpace>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<OaSpace>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
