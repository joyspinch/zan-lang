using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Oa;

namespace Zan.Web.Dao.Oa;

/* OaSpace 强类型数据访问网关（ZanSql 风格） */
public class OaSpaceDao : BaseRepository<OaSpace> {
    public OaSpaceDao() : base() {}
    public OaSpaceDao(IZanSql fsql) : base(fsql) {}
    public OaSpaceDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async OaSpace ById(int id) {
        return await this.GetExecutor().Select<OaSpace>().Where(a => a.id == id).FirstAsync();
    }

    public async List<OaSpace> All() {
        return await this.GetExecutor().Select<OaSpace>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<OaSpace>().CountAsync();
    }

    public InsertQuery<OaSpace> Insert(OaSpace entity) {
        return this.GetExecutor().Insert<OaSpace>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<OaSpace>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
