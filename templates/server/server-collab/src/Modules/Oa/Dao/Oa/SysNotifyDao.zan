using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* SysNotify 强类型数据访问网关（FreeSql 风格） */
class SysNotifyDao {
    IDbConnection db;

    SysNotifyDao(IDbConnection db) {
        this.db = db;
    }

    async SysNotify ById(int id) {
        return await this.db.Select<SysNotify>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysNotify> All() {
        return await this.db.Select<SysNotify>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<SysNotify>().CountAsync();
    }

    async int Insert(SysNotify entity) {
        return await this.db.Insert<SysNotify>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<SysNotify>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int UnreadCount(int tenantId, int userId) {
        return await this.db.Select<SysNotify>()
            .Where(a => a.tenantId == tenantId && a.userId == userId && a.isRead == 0)
            .CountAsync();
    }
}
