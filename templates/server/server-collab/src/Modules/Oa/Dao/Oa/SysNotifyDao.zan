using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* SysNotify 强类型数据访问网关（FreeSql 风格） */
class SysNotifyDao : BaseRepository<SysNotify> {
    SysNotifyDao(IFreeSql fsql) : base(fsql) {}
    SysNotifyDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async SysNotify ById(int id) {
        return await this.GetExecutor().Select<SysNotify>().Where(a => a.id == id).FirstAsync();
    }

    async List<SysNotify> All() {
        return await this.GetExecutor().Select<SysNotify>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<SysNotify>().CountAsync();
    }

    async int Insert(SysNotify entity) {
        return await this.GetExecutor().Insert<SysNotify>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<SysNotify>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async int UnreadCount(int tenantId, int userId) {
        return await this.GetExecutor().Select<SysNotify>()
            .Where(a => a.tenantId == tenantId && a.userId == userId && a.isRead == 0)
            .CountAsync();
    }
}
