using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Oa;

namespace Zan.Web.Dao.Oa;

/* OaDocRev 强类型数据访问网关（ZanSql 风格） */
public class OaDocRevDao : BaseRepository<OaDocRev> {
    public OaDocRevDao() : base() {}
    OaDocRevDao(IZanSql fsql) : base(fsql) {}
    OaDocRevDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async OaDocRev ById(int id) {
        return await this.GetExecutor().Select<OaDocRev>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaDocRev> All() {
        return await this.GetExecutor().Select<OaDocRev>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<OaDocRev>().CountAsync();
    }

    async int Insert(OaDocRev entity) {
        return await this.GetExecutor().Insert<OaDocRev>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<OaDocRev>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
