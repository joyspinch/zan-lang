using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaDocRev 强类型数据访问网关（FreeSql 风格） */
class OaDocRevDao {
    IDbConnection db;

    OaDocRevDao(IDbConnection db) {
        this.db = db;
    }

    async OaDocRev ById(int id) {
        return await this.db.Select<OaDocRev>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaDocRev> All() {
        return await this.db.Select<OaDocRev>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OaDocRev>().CountAsync();
    }

    async int Insert(OaDocRev entity) {
        return await this.db.Insert<OaDocRev>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OaDocRev>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
