using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Oa;

namespace ZanWeb.Dao.Oa;

/* OaFormDef 强类型数据访问网关（FreeSql 风格） */
class OaFormDefDao {
    IDbConnection db;

    OaFormDefDao(IDbConnection db) {
        this.db = db;
    }

    async OaFormDef ById(int id) {
        return await this.db.Select<OaFormDef>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaFormDef> All() {
        return await this.db.Select<OaFormDef>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<OaFormDef>().CountAsync();
    }

    async int Insert(OaFormDef entity) {
        return await this.db.Insert<OaFormDef>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<OaFormDef>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
