using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Oa;

namespace Zan.Web.Dao.Oa;

/* OaFormDef 强类型数据访问网关（ZanSql 风格） */
public class OaFormDefDao : BaseRepository<OaFormDef> {
    public OaFormDefDao() : base() {}
    OaFormDefDao(IZanSql fsql) : base(fsql) {}
    OaFormDefDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async OaFormDef ById(int id) {
        return await this.GetExecutor().Select<OaFormDef>().Where(a => a.id == id).FirstAsync();
    }

    async List<OaFormDef> All() {
        return await this.GetExecutor().Select<OaFormDef>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<OaFormDef>().CountAsync();
    }

    async int Insert(OaFormDef entity) {
        return await this.GetExecutor().Insert<OaFormDef>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<OaFormDef>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
