using System;
using System.Collections;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model.Oa;
using Zan.Web.Model;

namespace Zan.Web.Admin.Oa;

/* /admin/oa/spaces 文档空间（T9）：空间 CRUD + 文档计数，非空禁删。 */
[Route("admin/oa/spaces/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("文档空间")]
public class Spaces : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .TbarAdd("新建空间", "/admin/oa/spaces/form")
            .Col("id", "ID", "num", "75")
            .Col("name", "空间名称", "text", "200")
            .Col("description", "说明", "text", "260")
            .Col("docCount", "文档数", "num", "95")
            .Col("updatedAt", "更新时间", "text", "160")
            .OpsEdit("/admin/oa/spaces/form")
            .OpsDel("/admin/oa/spaces/delete", "确认删除该文档空间吗？");
    }

    static FormPage FormDef() {
        return FormPage.Of("/admin/oa/spaces/save")
            .Text("空间名称", "name").Req().Ph("例如：研发规范 / 产品方案")
            .Area("空间说明", "description").Span().Ph("最多 256 字");
    }

    [HttpGet]
    [Route("/admin/oa/spaces")]
    [Custom(IsMenu = true, Icon = "mdi:folder-text", Perm = PermBit.View)]
    [Description("文档空间")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("文档空间表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Spaces.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("文档空间列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        List<OaSpace> rows = await this.OaSpace
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            OaSpace s = rows[i];
            int docs = await this.OaDoc
                .Where(a => a.tenantId == Tenant.Cur() && a.spaceId == s.id)
                .CountAsync();
            w.WriteStartObject();
            w.WriteProperty("id", s.id);
            w.WriteProperty("name", s.name);
            w.WriteProperty("description", Fmt.Dash(s.description));
            w.WriteProperty("docCount", docs);
            w.WriteProperty("updatedAt", Fmt.Stamp(s.updatedAt));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, rows.Count, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("空间表单配置")]
    public void FormConf() {
        CrudOps.FormConf(this, Spaces.FormDef(), "文档空间");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("空间编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        OaSpace s = await this.OaSpace
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (s == null) { this.Fail(404, "0404", "空间不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", s.id);
        w.WriteProperty("name", s.name);
        w.WriteProperty("description", s.description);
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存空间")]
    async void Save() {
        int id = this.InAnyInt("id", 0);
        string name = this.NeedAny("name", "空间名称");
        if (name.Length == 0) { this.Fail(400, "0004", "请填写空间名称"); return; }
        string description = this.InAny("description");
        if (description.Length > 256) { description = description.Substring(0, 256); }
        long now = WebApp.NowSeconds();
        if (id > 0) {
            int n = await this.OaSpace.Update()
                .Set(a => a.name, name)
                .Set(a => a.description, description)
                .Set(a => a.updatedAt, now)
                .Where(a => a.id == id && a.tenantId == Tenant.Cur())
                .ExecuteAffrowsAsync();
            if (n <= 0) { this.Fail(404, "0404", "空间不存在"); return; }
            this.Saved("空间已保存");
            return;
        }
        OaSpace s = new OaSpace();
        s.tenantId = Tenant.Cur();
        s.name = name;
        s.description = description;
        s.readRoles = "";
        s.writeRoles = "";
        s.createdAt = now;
        s.updatedAt = now;
        int newId = await this.OaSpace.Insert(s).ExecuteIdentityAsync();
        this.Saved(newId > 0 ? "空间已创建" : "保存失败");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除空间")]
    async void Delete() {
        int id = this.InAnyInt("id", 0);
        int docs = await this.OaDoc
            .Where(a => a.tenantId == Tenant.Cur() && a.spaceId == id)
            .CountAsync();
        if (docs > 0) {
            this.Fail(400, "0004", "空间内还有 " + Convert.ToString(docs)
                + " 篇文档，先删除或迁移后再删空间");
            return;
        }
        int n = await this.OaSpace.Delete()
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        this.Saved(n > 0 ? "已删除" : "空间不存在");
    }
}
