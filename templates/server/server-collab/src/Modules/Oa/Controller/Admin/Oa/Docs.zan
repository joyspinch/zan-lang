using System;
using System.Collections;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model.Oa;
using Zan.Web.Model;

namespace Zan.Web.Admin.Oa;

/* /admin/oa/docs 文档中心（T9/T10）：文档列表 + 弹窗编辑（含乐观锁）+ 版本历史子表弹窗。 */
[Route("admin/oa/docs/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("文档中心")]
public class Docs : CollabAdminController {
    static ListPage HistoryDef() {
        return ListPage.Of()
            .Col("version", "版本号", "num", "90")
            .Col("title", "标题", "text", "240")
            .Col("editor", "编辑人", "text", "120")
            .Tag("current", "状态", "1=当前版本|ok,0=历史快照|off", "105")
            .Col("createdAt", "保存时间", "text", "160");
    }

    [HttpGet]
    [Route("/admin/oa/docs")]
    [Custom(IsMenu = true, Icon = "mdi:file-document", Perm = PermBit.View)]
    [Description("文档中心")]
    async void Index() {
        await this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("文档中心表格配置")]
    public async void Conf() {
        List<OaSpace> spaces = await this.MySpaces();
        string spaceOpts = "";
        for (int i = 0; i < spaces.Count; i = i + 1) {
            if (i > 0) { spaceOpts = spaceOpts + ","; }
            spaceOpts = spaceOpts + Convert.ToString(spaces[i].id) + "=" + spaces[i].name;
        }
        ListPage lp = ListPage.Of()
            .Text("文档标题", "kw", "title", "搜索文档标题")
            .TbarAdd("新建文档", "/admin/oa/docs/form")
            .Col("id", "ID", "num", "75")
            .Col("title", "文档标题", "text", "220")
            .Col("spaceName", "所属空间", "text", "140")
            .Col("version", "版本", "num", "80")
            .Col("editor", "最近编辑", "text", "120")
            .Col("excerpt", "内容摘要", "text", "260")
            .Col("updatedAt", "更新时间", "text", "160")
            .OpsEdit("/admin/oa/docs/form")
            .Ops("版本历史", "/admin/oa/docs/history", "", "id={id}", "")
            .OpsDel("/admin/oa/docs/delete", "确认删除该文档及其全部历史版本吗？");
        if (spaceOpts.Length > 0) {
            lp.Select("文档空间", "spaceId", "spaceId", spaceOpts);
        }
        CrudOps.Conf(this, lp);
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("文档列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        ListQuery q = this.PagedAny("updatedAt", 20);
        string kw = q.Kw();
        int spaceId = this.InAnyInt("spaceId", 0);
        List<OaSpace> spaces = await this.MySpaces();
        List<OaDoc> docs = await this.OaDoc
            .Where(a => a.tenantId == Tenant.Cur())
            .WhereIf(spaceId > 0, a => a.spaceId == spaceId)
            .WhereIf(kw.Length > 0, a => a.title.Contains(kw))
            .OrderByDescending(a => a.updatedAt)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.OaDoc
            .Where(a => a.tenantId == Tenant.Cur())
            .WhereIf(spaceId > 0, a => a.spaceId == spaceId)
            .WhereIf(kw.Length > 0, a => a.title.Contains(kw))
            .CountAsync();
        List<SysUser> users = await this.SysUser.ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < docs.Count; i = i + 1) {
            OaDoc doc = docs[i];
            w.WriteStartObject();
            w.WriteProperty("id", doc.id);
            w.WriteProperty("spaceId", Convert.ToString(doc.spaceId));
            w.WriteProperty("spaceName", Docs.SpaceName(spaces, doc.spaceId));
            w.WriteProperty("title", doc.title);
            w.WriteProperty("version", doc.version);
            w.WriteProperty("editor", Docs.NameOf(users, doc.updatedBy));
            w.WriteProperty("excerpt", Prose.Excerpt(doc.contentText, 60));
            w.WriteProperty("updatedAt", Fmt.Stamp(doc.updatedAt));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    /* 文档阅读 JSON 端点（Blocks 渲染 html + 元信息）。 */
    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("阅读文档")]
    async void Read() {
        int id = this.InAnyInt("id", 0);
        OaDoc doc = await this.OaDoc
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (doc == null) { this.Fail(404, "0404", "文档不存在"); return; }
        OaSpace sp = await this.OaSpace
            .Where(a => a.id == doc.spaceId && a.tenantId == Tenant.Cur())
            .FirstAsync();
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", doc.id);
        w.WriteProperty("title", doc.title);
        w.WriteProperty("version", doc.version);
        w.WriteProperty("updatedAt", Fmt.Stamp(doc.updatedAt));
        w.WriteProperty("spaceId", doc.spaceId);
        w.WriteProperty("spaceName", sp == null ? "" : sp.name);
        w.WriteProperty("html", Blocks.Render(doc.content));
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("文档表单配置")]
    public async void FormConf() {
        List<OaSpace> spaces = await this.MySpaces();
        List<StrMap> sopts = new List<StrMap>();
        for (int i = 0; i < spaces.Count; i = i + 1) {
            StrMap m = new StrMap();
            m.Set("id", Convert.ToString(spaces[i].id));
            m.Set("name", spaces[i].name);
            sopts.Add(m);
        }
        FormPage fp = FormPage.Of("/admin/oa/docs/save")
            .Wide()
            .SelectList("所属空间", "spaceId", sopts).Req()
            .Text("文档标题", "title").Req().Ph("请输入文档标题")
            .Area("文档正文", "content").Span().Ph("支持行式块文本语法（# 标题、- 列表、``` 代码块等）");
        CrudOps.FormConf(this, fp, "文档");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("文档编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        OaDoc doc = await this.OaDoc
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (doc == null) { this.Fail(404, "0404", "文档不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", doc.id);
        w.WriteProperty("spaceId", Convert.ToString(doc.spaceId));
        w.WriteProperty("title", doc.title);
        w.WriteProperty("content", doc.content);
        w.WriteProperty("version", doc.version);
        w.WriteProperty("baseVersion", doc.version);
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存文档")]
    async void Save() {
        int id = this.InAnyInt("id", 0);
        int baseVersion = this.InAnyInt("baseVersion", 0);
        SysUser me = await this.Admin();
        string title = this.NeedAny("title", "文档标题");
        if (title.Length == 0) { this.Fail(400, "0004", "请填写文档标题"); return; }
        string content = this.InAnyRaw("content");
        string err = Blocks.Validate(content);
        if (err.Length > 0) { this.Fail(400, "0004", err); return; }
        string norm = Blocks.Normalize(content);
        string text = Blocks.TextOf(norm);
        long now = WebApp.NowSeconds();
        if (id > 0) {
            OaDoc doc = await this.OaDoc
                .Where(a => a.id == id && a.tenantId == Tenant.Cur())
                .FirstAsync();
            if (doc == null) { this.Fail(404, "0404", "文档不存在"); return; }
            if (baseVersion > 0 && doc.version != baseVersion) {
                this.Fail(409, "0409", "文档已被他人修改（当前 v"
                    + Convert.ToString(doc.version) + "），请刷新对比后重试");
                return;
            }
            int ver = doc.version + 1;
            int n = await this.OaDoc.Update()
                .Set(a => a.title, title)
                .Set(a => a.content, norm)
                .Set(a => a.contentText, text)
                .Set(a => a.version, ver)
                .Set(a => a.updatedBy, me.id)
                .Set(a => a.updatedAt, now)
                .Where(a => a.id == id && a.tenantId == Tenant.Cur())
                .ExecuteAffrowsAsync();
            if (n <= 0) { this.Fail(404, "0404", "文档不存在"); return; }
            OaDocRev rev = new OaDocRev();
            rev.tenantId = Tenant.Cur();
            rev.docId = id;
            rev.version = ver;
            rev.title = title;
            rev.content = norm;
            rev.editorId = me.id;
            rev.createdAt = now;
            await this.OaDocRev.Insert(rev).ExecuteIdentityAsync();
            this.Saved("已保存为 v" + Convert.ToString(ver));
            return;
        }
        int spaceId = this.InAnyInt("spaceId", 0);
        OaSpace sp = await this.OaSpace
            .Where(a => a.id == spaceId && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (sp == null) { this.Fail(400, "0004", "请选择有效空间"); return; }
        OaDoc nd = new OaDoc();
        nd.tenantId = Tenant.Cur();
        nd.spaceId = spaceId;
        nd.title = title;
        nd.content = norm;
        nd.contentText = text;
        nd.version = 1;
        nd.updatedBy = me.id;
        nd.createdAt = now;
        nd.updatedAt = now;
        int newId = await this.OaDoc.Insert(nd).ExecuteIdentityAsync();
        if (newId <= 0) { this.Fail(400, "0004", "保存失败"); return; }
        OaDocRev rv = new OaDocRev();
        rv.tenantId = Tenant.Cur();
        rv.docId = newId;
        rv.version = 1;
        rv.title = title;
        rv.content = norm;
        rv.editorId = me.id;
        rv.createdAt = now;
        await this.OaDocRev.Insert(rv).ExecuteIdentityAsync();
        this.Saved("文档已创建");
    }

    /* 版本历史子表（SubTableModal） */
    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("版本历史")]
    void History() {
        this.HistoryConf();
    }

    [HttpPut]
    [Route("/admin/oa/docs/history/conf")]
    [Custom(Perm = PermBit.View)]
    [Description("版本历史表格配置")]
    public void HistoryConf() {
        CrudOps.Conf(this, Docs.HistoryDef());
    }

    [HttpPost]
    [Route("/admin/oa/docs/history/list")]
    [Custom(Perm = PermBit.View)]
    [Description("版本历史列表数据")]
    public async void HistoryList() {
        if (!this.DataReady()) { return; }
        int id = this.InAnyInt("id", 0);
        OaDoc doc = await this.OaDoc
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (doc == null) { this.Fail(404, "0404", "文档不存在"); return; }
        List<OaDocRev> revs = await this.OaDocRev
            .Where(a => a.docId == doc.id && a.tenantId == Tenant.Cur())
            .OrderByDescending(a => a.version).ToListAsync();
        List<SysUser> users = await this.SysUser.ToListAsync();
        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < revs.Count; i = i + 1) {
            OaDocRev rev = revs[i];
            w.WriteStartObject();
            w.WriteProperty("id", rev.id);
            w.WriteProperty("version", rev.version);
            w.WriteProperty("title", rev.title);
            w.WriteProperty("editor", Docs.NameOf(users, rev.editorId));
            w.WriteProperty("current", rev.version == doc.version ? "1" : "0");
            w.WriteProperty("createdAt", Fmt.Stamp(rev.createdAt));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, revs.Count, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除文档")]
    async void Delete() {
        int id = this.InAnyInt("id", 0);
        OaDoc doc = await this.OaDoc
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (doc == null) { this.Fail(404, "0404", "文档不存在"); return; }
        int _r = await this.OaDocRev.Delete()
            .Where(a => a.docId == doc.id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        int n = await this.OaDoc.Delete()
            .Where(a => a.id == doc.id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        this.Saved(n > 0 ? "已删除" : "文档不存在");
    }

    private async List<OaSpace> MySpaces() {
        return await this.OaSpace
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
    }

    static string SpaceName(List<OaSpace> spaces, int id) {
        for (int i = 0; i < spaces.Count; i = i + 1) {
            if (spaces[i].id == id) { return spaces[i].name; }
        }
        return "—";
    }

    static string NameOf(List<SysUser> users, int id) {
        for (int i = 0; i < users.Count; i = i + 1) {
            if (users[i].id == id) { return Fmt.Text(users[i].nickname, users[i].username); }
        }
        return "—";
    }
}
