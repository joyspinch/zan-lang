using System;
using System.Text;
using System.Data.Orm;
using System.Web;
using ZanWeb.Model.Oa;
using ZanWeb.Model.Sys;

namespace ZanWeb.Admin.Oa;

/* 待办中心（架构 §2.4 WP-4 / T5）：聚合页读 Feature.TodoCenter.Gather
   （manual 真行 + 各注册源实时流），来源徽标 + 截止排序 + 整行跳转；
   完成/忽略：manual 改真行，虚拟源落标记行（Gather 按键过滤）。顶部
   附个人待办新增表单（manual 源的入口）。
   授权用 Login 而非 Grant（与全站 Grant 惯例的偏差，有意为之）：待办是
   纯个人视图、无跨人数据面，且新增屏走 Grant 需要角色授权迁移才能到达；
   写操作均限本人行（userId==me.id），越权无从谈起。 */
[Route("admin/oa/todocenter/[action]")]
[Custom(Authorization = CustomAuthorization.Login)]
[Description("待办中心")]
class TodoCenter : AdminController {

    /* 聚合页：按截止升序（无截止垫后），逾期行标红。 */
    [HttpGet]
    [Route("/admin/oa/todocenter")]
    [Description("待办中心")]
    async void Index() {
        User me = await this.Admin();
        ViewData d = await this.Layout("待办中心");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }
        List<TodoItem> items = await ZanWeb.TodoCenter.Gather(this.Held(),
            this.TenantId(), me);
        long now = WebApp.NowSeconds();
        List<StrMap> rows = d.AddList("rows");
        for (int i = 0; i < items.Count; i = i + 1) {
            TodoItem it = items[i];
            StrMap m = new StrMap();
            m.Set("src", TodoCenter.SrcText(it.source));
            m.Set("title", it.title);
            m.Set("link", it.link.Length > 0 ? it.link : "#");
            m.Set("due", it.dueAt > 0 ? Fmt.Day(it.dueAt) : "—");
            m.Set("overdue", it.dueAt > 0 && it.dueAt < now ? "1" : "");
            m.Set("args", TodoCenter.ArgsOf(it));
            rows.Add(m);
        }
        d.Set("empty", items.Count == 0 ? "1" : "");
        this.Page(d);
    }

    /* 新增个人待办（manual 源）。 */
    [HttpPost]
    [Description("新增待办")]
    async void Add() {
        User me = await this.Admin();
        string title = this.Need("title", "内容");
        if (title.Length == 0) { this.Fail(400, "0003", "请填写待办内容"); }
        string link = this.In("link");
        if (link.Length > 64) { link = link.Substring(0, 64); }
        OaTodo t = new OaTodo();
        t.tenantId = this.TenantId();
        t.userId = me.id;
        t.source = "manual";
        t.title = title;
        t.link = link;
        t.dueAt = 0;
        t.status = 0;
        t.relatedType = "manual";
        t.relatedId = 0;
        t.createdAt = WebApp.NowSeconds();
        t.doneAt = 0;
        await this.OaTodo.Insert(t).ExecuteIdentityAsync();
        await this.Note("新增待办", title, true, "");
        this.Saved("已添加");
    }

    /* 完成：manual 改真行；虚拟源 upsert 标记行（source/relatedType/
       relatedId 由聚合页随行携带——只接受已注册来源，防捏造键）。 */
    [HttpPost]
    [Description("完成待办")]
    async void Done() {
        if (!await this.Change(1)) { return; }
        this.Saved("已完成");
    }

    /* 忽略：同完成，仅标记值不同（屏蔽后聚合页不再出现）。 */
    [HttpPost]
    [Description("忽略待办")]
    async void Ignore() {
        if (!await this.Change(2)) { return; }
        this.Saved("已忽略");
    }

    /* Done/Ignore 公共体：入参校验 + 标记落库 + 审计。 */
    async bool Change(int status) {
        User me = await this.Admin();
        string source = this.In("source");
        if (source.Length == 0) { source = "manual"; }
        if (!ZanWeb.TodoCenter.HasSource(source)) {
            this.Fail(400, "0003", "未知待办来源");
            return false;
        }
        string relatedType = source;
        int relatedId = 0;
        if (source == "manual") {
            relatedId = this.InInt("id", 0);
            relatedType = "manual";
        } else {
            relatedType = this.In("relatedType");
            relatedId = this.InInt("relatedId", 0);
            if (relatedType.Length == 0 || relatedId == 0) {
                this.Fail(400, "0003", "缺少待办回链参数");
                return false;
            }
        }
        bool ok = await ZanWeb.TodoCenter.Mark(this.Held(), this.TenantId(),
            me.id, source, relatedType, relatedId, status, this.In("title"));
        if (!ok) {
            this.Fail(404, "0404", "待办不存在或不属于你");
            return false;
        }
        await this.Note(status == 1 ? "完成待办" : "忽略待办",
            this.In("title"), true, "");
        return true;
    }

    /* 行携带参数：manual 传 id，虚拟源传 source/relatedType/relatedId/title。 */
    static string ArgsOf(TodoItem it) {
        if (it.source == "manual") {
            return "source=manual&id=" + Convert.ToString(it.rowId)
                + "&title=" + Encoding.UrlEncode(it.title);
        }
        return "source=" + it.source + "&relatedType=" + it.relatedType
            + "&relatedId=" + Convert.ToString(it.relatedId)
            + "&title=" + Encoding.UrlEncode(it.title);
    }

    static string SrcText(string source) {
        if (source == "manual") { return "个人"; }
        if (source == "flow") { return "流程"; }
        if (source == "crm") { return "商机"; }
        if (source == "wms") { return "库存"; }
        return source;
    }
}
