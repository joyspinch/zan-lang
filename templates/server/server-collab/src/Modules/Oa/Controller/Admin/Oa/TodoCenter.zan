using System;
using System.Text;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model.Oa;
using Zan.Web.Model;

namespace Zan.Web.Admin.Oa;

/* 待办中心（架构 §2.4 WP-4 / T5）：聚合多模块待办源 + 新增个人待办 + 完成/忽略。 */
[Route("admin/oa/todocenter/[action]")]
[Custom(Authorization = CustomAuthorization.Login)]
[Description("待办中心")]
public class TodoCenter : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .TbarAdd("新增个人待办", "/admin/oa/todocenter/form")
            .Col("src", "来源", "text", "100")
            .Col("title", "待办内容", "text", "300")
            .Col("due", "截止日期", "text", "125")
            .Tag("overdue", "紧迫度", "1=已逾期|off,0=正常|ok", "95")
            .Col("link", "关联入口", "text", "180")
            .Ops("完成", "/admin/oa/todocenter/done", "确认将该待办标记为已完成吗？",
                "source={source}&id={rowId}&relatedType={relatedType}&relatedId={relatedId}&title={title}", "")
            .Ops("忽略", "/admin/oa/todocenter/ignore", "确认忽略该待办吗？",
                "source={source}&id={rowId}&relatedType={relatedType}&relatedId={relatedId}&title={title}", "");
    }

    [HttpGet]
    [Route("/admin/oa/todocenter")]
    [Custom(IsMenu = true, Icon = "mdi:checkbox-marked-circle-outline", Perm = PermBit.View)]
    [Description("待办中心")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Description("待办中心表格配置")]
    public void Conf() {
        CrudOps.Conf(this, TodoCenter.ScreenDef());
    }

    [HttpPost]
    [Description("待办中心列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        SysUser me = await this.Admin();
        List<TodoItem> items = await Zan.Web.TodoCenter.Gather(this.Held(),
            Tenant.Cur(), me);
        long now = WebApp.NowSeconds();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < items.Count; i = i + 1) {
            TodoItem it = items[i];
            w.WriteStartObject();
            w.WriteProperty("id", i + 1);
            w.WriteProperty("rowId", it.rowId);
            w.WriteProperty("source", it.source);
            w.WriteProperty("src", TodoCenter.SrcText(it.source));
            w.WriteProperty("relatedType", it.relatedType);
            w.WriteProperty("relatedId", it.relatedId);
            w.WriteProperty("title", it.title);
            w.WriteProperty("link", it.link.Length > 0 ? it.link : "—");
            w.WriteProperty("due", it.dueAt > 0 ? Fmt.Day(it.dueAt) : "—");
            w.WriteProperty("overdue", (it.dueAt > 0 && it.dueAt < now) ? "1" : "0");
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, items.Count, w.ToString());
    }

    [HttpPut]
    [Description("新增待办表单配置")]
    public void FormConf() {
        FormPage fp = FormPage.Of("/admin/oa/todocenter/add")
            .Text("待办内容", "title").Req().Ph("请输入个人待办事项")
            .Text("关联链接", "link").Ph("可选，如 /admin/crm/customers");
        CrudOps.FormConf(this, fp, "新增个人待办");
    }

    [HttpPost]
    [Description("新增待办")]
    async void Add() {
        SysUser me = await this.Admin();
        string title = this.NeedAny("title", "内容");
        if (title.Length == 0) { this.Fail(400, "0003", "请填写待办内容"); return; }
        string link = this.InAny("link");
        if (link.Length > 64) { link = link.Substring(0, 64); }
        OaTodo t = new OaTodo();
        t.tenantId = Tenant.Cur();
        t.userId = me.id;
        t.source = "manual";
        t.title = title;
        t.link = link;
        t.dueAt = 0;
        t.status = 0;
        t.relatedType = "manual";
        t.relatedId = 0;
        t.createdAt = WebApp.NowSeconds();
        t.doneAt = 0;
        await this.OaTodo.Insert(t).ExecuteIdentityAsync();
        await this.Note("新增待办", title, true, "");
        this.Saved("已添加");
    }

    [HttpPost]
    [Description("完成待办")]
    async void Done() {
        if (!await this.Change(1)) { return; }
        this.Saved("已完成");
    }

    [HttpPost]
    [Description("忽略待办")]
    async void Ignore() {
        if (!await this.Change(2)) { return; }
        this.Saved("已忽略");
    }

    private async bool Change(int status) {
        SysUser me = await this.Admin();
        string source = this.InAny("source");
        if (source.Length == 0) { source = "manual"; }
        if (!Zan.Web.TodoCenter.HasSource(source)) {
            this.Fail(400, "0003", "未知待办来源");
            return false;
        }
        string relatedType = source;
        int relatedId = 0;
        if (source == "manual") {
            relatedId = this.InAnyInt("id", 0);
            relatedType = "manual";
        } else {
            relatedType = this.InAny("relatedType");
            relatedId = this.InAnyInt("relatedId", 0);
            if (relatedType.Length == 0 || relatedId == 0) {
                this.Fail(400, "0003", "缺少待办回链参数");
                return false;
            }
        }
        string title = this.InAny("title");
        bool ok = await Zan.Web.TodoCenter.Mark(this.Held(), Tenant.Cur(),
            me.id, source, relatedType, relatedId, status, title);
        if (!ok) {
            this.Fail(404, "0404", "待办不存在或不属于你");
            return false;
        }
        await this.Note(status == 1 ? "完成待办" : "忽略待办", title, true, "");
        return true;
    }

    static string SrcText(string source) {
        if (source == "manual") { return "个人"; }
        if (source == "flow") { return "流程"; }
        if (source == "crm") { return "商机"; }
        if (source == "wms") { return "库存"; }
        if (source == "calendar") { return "日程"; }
        return source;
    }
}
