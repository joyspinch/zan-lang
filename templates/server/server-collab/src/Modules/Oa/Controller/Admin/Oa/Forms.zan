using System;
using System.Collections;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model.Flow;
using Zan.Web.Model.Oa;
using Zan.Web.Model;

namespace Zan.Web.Admin.Oa;

/* 表单定义：JSON Schema 校验、绑定流程、启停与防误删保护。 */
[Route("admin/oa/forms/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("表单定义")]
public class Forms : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .Text("表单名称", "kw", "name", "搜索表单名称")
            .TbarAdd("新建表单", "/admin/oa/forms/form")
            .Col("id", "ID", "num", "75")
            .Col("code", "表单标识", "text", "140")
            .Col("name", "表单名称", "text", "180")
            .Col("flowName", "绑定流程", "text", "150")
            .Col("subs", "提交数", "num", "90")
            .Tag("status", "状态", "1=启用|ok,0=停用|off", "85")
            .Col("description", "说明", "text", "200")
            .Col("createdAt", "创建时间", "text", "160")
            .OpsEdit("/admin/oa/forms/form")
            .Ops("启停", "/admin/oa/forms/status", "确认切换该表单启停状态吗？", "id={id}", "u")
            .OpsDel("/admin/oa/forms/delete", "确认删除该表单定义吗？");
    }

    [HttpGet]
    [Route("/admin/oa/forms")]
    [Custom(IsMenu = true, Icon = "mdi:form-textbox", Perm = PermBit.View)]
    [Description("表单定义")]
    public void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("表单定义表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Forms.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("表单定义列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        ListQuery q = this.PagedAny("id", 20);
        string kw = q.Kw();
        List<OaFormDef> rows = await this.OaFormDef
            .Where(a => a.tenantId == Tenant.Cur())
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.OaFormDef
            .Where(a => a.tenantId == Tenant.Cur())
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw)).CountAsync();
        List<FlowDef> defs = await this.FlowDef
            .Where(a => a.tenantId == Tenant.Cur()).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            OaFormDef r = rows[i];
            int subs = await this.OaFormData
                .Where(a => a.tenantId == Tenant.Cur() && a.formId == r.id)
                .CountAsync();
            w.WriteStartObject();
            w.WriteProperty("id", r.id);
            w.WriteProperty("code", r.code);
            w.WriteProperty("name", r.name);
            w.WriteProperty("description", Fmt.Dash(r.description));
            w.WriteProperty("flowName", Forms.FlowName(defs, r.flowDefId));
            w.WriteProperty("status", Convert.ToString(r.status));
            w.WriteProperty("subs", subs);
            w.WriteProperty("createdAt", Fmt.Stamp(r.createdAt));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("表单定义表单配置")]
    public async void FormConf() {
        List<FlowDef> defs = await this.FlowDef
            .Where(a => a.tenantId == Tenant.Cur()).OrderBy(a => a.id).ToListAsync();
        List<StrMap> fopts = new List<StrMap>();
        StrMap f0 = new StrMap(); f0.Set("id", "0"); f0.Set("name", "不绑流程"); fopts.Add(f0);
        for (int i = 0; i < defs.Count; i = i + 1) {
            StrMap m = new StrMap();
            m.Set("id", Convert.ToString(defs[i].id));
            m.Set("name", defs[i].status == 1 ? defs[i].name : defs[i].name + "（已停用）");
            fopts.Add(m);
        }
        FormPage fp = FormPage.Of("/admin/oa/forms/save")
            .Wide()
            .Text("表单标识", "code").Req().Ph("仅限 [a-z0-9_]，如 leave_apply")
            .Text("表单名称", "name").Req().Ph("例如：请假申请单")
            .SelectList("绑定流程", "flowDefId", fopts).Val("0")
            .Text("表单说明", "description").Ph("用途说明")
            .Area("Schema JSON", "schemaJson").Span().Ph("{\"fields\":[{\"name\":\"reason\",\"label\":\"事由\",\"type\":\"text\"}]}");
        CrudOps.FormConf(this, fp, "表单定义");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("表单定义编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        OaFormDef r = await this.OaFormDef
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (r == null) { this.Fail(404, "0404", "表单不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", r.id);
        w.WriteProperty("code", r.code);
        w.WriteProperty("name", r.name);
        w.WriteProperty("description", r.description);
        w.WriteProperty("schemaJson", r.schemaJson);
        w.WriteProperty("flowDefId", Convert.ToString(r.flowDefId));
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存表单定义")]
    public async void Save() {
        SysUser me = await this.Admin();
        int id = this.InAnyInt("id", 0);
        string code = this.NeedAny("code", "表单标识");
        string name = this.NeedAny("name", "表单名称");
        if (!FormSchema.CodeOk(code)) {
            this.Fail(400, "0004", "表单标识需为 [a-z0-9_] 且 1~64 位"); return;
        }
        if (name.Length > 128) { this.Fail(400, "0004", "表单名称过长"); return; }
        string description = this.InAny("description");
        if (description.Length > 512) { description = description.Substring(0, 512); }
        string schemaJson = this.InAnyRaw("schemaJson");
        if (schemaJson.Length > 60000) {
            this.Fail(400, "0004", "schema 过大（60000 字符上限）"); return;
        }
        FormSchemaDef _schema = FormSchema.Parse(schemaJson);
        int flowDefId = this.InAnyInt("flowDefId", 0);
        if (flowDefId > 0) {
            FlowDef fd = await this.FlowDef
                .Where(a => a.id == flowDefId && a.tenantId == Tenant.Cur())
                .FirstAsync();
            if (fd == null) { this.Fail(400, "0004", "绑定的流程不存在"); return; }
        }
        OaFormDef dup = await this.OaFormDef
            .Where(a => a.tenantId == Tenant.Cur() && a.code == code)
            .FirstAsync();
        if (dup != null && dup.id != id) {
            this.Fail(400, "0004", "表单标识已被使用"); return;
        }
        long now = WebApp.NowSeconds();
        if (id > 0) {
            OaFormDef r = await this.OaFormDef
                .Where(a => a.id == id && a.tenantId == Tenant.Cur())
                .FirstAsync();
            if (r == null) { this.Fail(404, "0404", "表单不存在"); return; }
            int subs = await this.OaFormData
                .Where(a => a.tenantId == Tenant.Cur() && a.formId == r.id)
                .CountAsync();
            if (subs > 0 && schemaJson != r.schemaJson) {
                this.Fail(400, "0004", "已有提交记录，schema 不可修改（名称/描述/流程绑定/启停不受限）");
                return;
            }
            int n = await this.OaFormDef.Update()
                .Set(a => a.code, code)
                .Set(a => a.name, name)
                .Set(a => a.description, description)
                .Set(a => a.schemaJson, schemaJson)
                .Set(a => a.flowDefId, flowDefId)
                .Set(a => a.updatedAt, now)
                .Where(a => a.id == id && a.tenantId == Tenant.Cur())
                .ExecuteAffrowsAsync();
            if (n <= 0) { this.Fail(404, "0404", "表单不存在"); return; }
            await this.Note("保存表单定义", name, true, "");
            this.Saved("表单已保存");
            return;
        }
        OaFormDef row = new OaFormDef();
        row.tenantId = Tenant.Cur();
        row.code = code;
        row.name = name;
        row.description = description;
        row.schemaJson = schemaJson;
        row.status = 1;
        row.flowDefId = flowDefId;
        row.createdBy = me.id;
        row.createdAt = now;
        row.updatedAt = now;
        int newId = await this.OaFormDef.Insert(row).ExecuteIdentityAsync();
        await this.Note("新建表单定义", name, true, "");
        this.Saved(newId > 0 ? "表单已创建" : "保存失败");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("表单启停")]
    public async void Status() {
        int id = this.InAnyInt("id", 0);
        OaFormDef r = await this.OaFormDef
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (r == null) { this.Fail(404, "0404", "表单不存在"); return; }
        int next = r.status == 1 ? 0 : 1;
        await this.OaFormDef.Update()
            .Set(a => a.status, next)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        this.Saved(next == 1 ? "已启用" : "已停用");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除表单定义")]
    public async void Delete() {
        int id = this.InAnyInt("id", 0);
        OaFormDef r = await this.OaFormDef
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (r == null) { this.Fail(404, "0404", "表单不存在"); return; }
        int subs = await this.OaFormData
            .Where(a => a.tenantId == Tenant.Cur() && a.formId == r.id)
            .CountAsync();
        if (subs > 0) {
            this.Fail(400, "0004", "已有 " + subs.ToString()
                + " 条提交记录，不可删除；如需收敛入口请停用");
            return;
        }
        await this.OaFormDef.Delete()
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        await this.Note("删除表单定义", r.name, true, "");
        this.Saved("表单已删除");
    }

    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("表单预览")]
    public async void Preview() {
        int id = this.InAnyInt("id", 0);
        OaFormDef r = await this.OaFormDef
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (r == null) { this.Fail(404, "0404", "表单不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", r.id);
        w.WriteProperty("code", r.code);
        w.WriteProperty("name", r.name);
        w.WriteProperty("schemaJson", r.schemaJson);
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    public static string FlowName(List<FlowDef> defs, int flowDefId) {
        if (flowDefId <= 0) { return "不绑流程"; }
        for (int i = 0; i < defs.Count; i = i + 1) {
            if (defs[i].id == flowDefId) { return defs[i].name; }
        }
        return "流程#" + flowDefId.ToString();
    }
}
