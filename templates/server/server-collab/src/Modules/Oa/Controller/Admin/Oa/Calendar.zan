using System;
using System.Collections;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model.Oa;
using Zan.Web.Model;

namespace Zan.Web.Admin.Oa;

/* /admin/oa/calendar 个人日程（T11）：我的日程列表与弹窗 CRUD（本人+本租户双闸）。 */
[Route("admin/oa/calendar/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("日程")]
public class Calendar : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .Text("日程标题", "kw", "title", "搜索日程标题")
            .Tab("全部日程", "range", "all")
            .Tab("今日日程", "range", "today")
            .Tab("即将开始", "range", "upcoming")
            .TbarAdd("新建日程", "/admin/oa/calendar/form")
            .Col("id", "ID", "num", "75")
            .Col("title", "日程标题", "text", "220")
            .Col("startAtText", "开始时间", "text", "160")
            .Col("endAtText", "结束时间", "text", "160")
            .Tag("allDay", "类型", "1=全天|ok,0=时段|off", "85")
            .Tag("remindMinutes", "提醒", "0=不提醒|off,30=提前30分|warn,60=提前1小时|warn,1440=提前1天|ok", "110")
            .Col("description", "说明", "text", "240")
            .OpsEdit("/admin/oa/calendar/form")
            .OpsDel("/admin/oa/calendar/delete", "确认删除该日程吗？");
    }

    static FormPage FormDef() {
        long now = WebApp.NowSeconds();
        return FormPage.Of("/admin/oa/calendar/save")
            .Wide()
            .Text("日程标题", "title").Req().Span().Ph("例如：周会 / 客户回访")
            .Text("开始时间", "startAt").Req().Ph("YYYY-MM-DD HH:MM 或 YYYY-MM-DDTHH:MM")
                .Val(Calendar.LocalStampValue(now + 3600))
            .Text("结束时间", "endAt").Req().Ph("YYYY-MM-DD HH:MM 或 YYYY-MM-DDTHH:MM")
                .Val(Calendar.LocalStampValue(now + 7200))
            .Select("是否全天", "allDay", "0=否,1=是").Val("0")
            .Select("提前提醒", "remindMinutes", "0=不提醒,30=提前30分钟,60=提前1小时,1440=提前1天").Val("30")
            .Area("日程说明", "description").Span().Ph("会议议程、地点或备注");
    }

    [HttpGet]
    [Route("/admin/oa/calendar")]
    [Custom(IsMenu = true, Icon = "mdi:calendar", Perm = PermBit.View)]
    [Description("日程")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("日程表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Calendar.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("日程列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        SysUser me = await this.Admin();
        ListQuery q = this.PagedAny("startAt", 20);
        string kw = q.Kw();
        string range = this.InAny("range");
        long now = WebApp.NowSeconds();
        long todayStart = Fmt.TodayStart(now);
        long todayEnd = todayStart + 86400;

        List<OaCalendarEvent> rows = await this.OaCalendarEvent
            .Where(a => a.tenantId == Tenant.Cur() && a.ownerId == me.id)
            .WhereIf(kw.Length > 0, a => a.title.Contains(kw))
            .WhereIf(range == "today", a => a.startAt >= todayStart && a.startAt < todayEnd)
            .WhereIf(range == "upcoming", a => a.endAt >= now)
            .OrderByDescending(a => a.startAt)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.OaCalendarEvent
            .Where(a => a.tenantId == Tenant.Cur() && a.ownerId == me.id)
            .WhereIf(kw.Length > 0, a => a.title.Contains(kw))
            .WhereIf(range == "today", a => a.startAt >= todayStart && a.startAt < todayEnd)
            .WhereIf(range == "upcoming", a => a.endAt >= now)
            .CountAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            OaCalendarEvent ev = rows[i];
            w.WriteStartObject();
            w.WriteProperty("id", ev.id);
            w.WriteProperty("title", ev.title);
            w.WriteProperty("description", Fmt.Dash(ev.description));
            w.WriteProperty("startAtText", Fmt.Stamp(ev.startAt));
            w.WriteProperty("endAtText", Fmt.Stamp(ev.endAt));
            w.WriteProperty("allDay", Convert.ToString(ev.allDay));
            w.WriteProperty("remindMinutes", Convert.ToString(ev.remindMinutes));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("日程表单配置")]
    public void FormConf() {
        CrudOps.FormConf(this, Calendar.FormDef(), "日程");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("日程编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        SysUser me = await this.Admin();
        OaCalendarEvent ev = await this.OaCalendarEvent
            .Where(a => a.id == id && a.tenantId == Tenant.Cur() && a.ownerId == me.id)
            .FirstAsync();
        if (ev == null) { this.Fail(404, "0404", "日程不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", ev.id);
        w.WriteProperty("title", ev.title);
        w.WriteProperty("description", ev.description);
        w.WriteProperty("startAt", Calendar.LocalStampValue(ev.startAt));
        w.WriteProperty("endAt", Calendar.LocalStampValue(ev.endAt));
        w.WriteProperty("allDay", Convert.ToString(ev.allDay));
        w.WriteProperty("remindMinutes", Convert.ToString(ev.remindMinutes));
        w.WriteProperty("relatedType", ev.relatedType);
        w.WriteProperty("relatedId", ev.relatedId);
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存日程")]
    async void Save() {
        int id = this.InAnyInt("id", 0);
        SysUser me = await this.Admin();
        string title = this.NeedAny("title", "日程标题");
        long startAt = Calendar.LocalStamp(this.InAny("startAt"));
        long endAt = Calendar.LocalStamp(this.InAny("endAt"));
        int remind = this.InAnyInt("remindMinutes", 0);
        if (title.Length == 0) { this.Fail(400, "0004", "请填写日程标题"); return; }
        if (startAt <= 0) { this.Fail(400, "0004", "开始时间不合法（格式 YYYY-MM-DD HH:MM）"); return; }
        if (endAt <= 0) { this.Fail(400, "0004", "结束时间不合法（格式 YYYY-MM-DD HH:MM）"); return; }
        if (endAt <= startAt) { this.Fail(400, "0004", "结束时间须晚于开始时间"); return; }
        if (remind != 0 && remind != 30 && remind != 60 && remind != 1440) {
            this.Fail(400, "0004", "提醒时间不合法"); return;
        }
        long now = WebApp.NowSeconds();
        if (id > 0) {
            int n = await this.OaCalendarEvent.Update()
                .Set(a => a.title, title)
                .Set(a => a.description, this.InAny("description"))
                .Set(a => a.startAt, startAt)
                .Set(a => a.endAt, endAt)
                .Set(a => a.allDay, this.InAnyInt("allDay", 0) == 1 ? 1 : 0)
                .Set(a => a.remindMinutes, remind)
                .Set(a => a.reminded, 0)
                .Set(a => a.updatedAt, now)
                .Where(a => a.id == id && a.tenantId == Tenant.Cur() && a.ownerId == me.id)
                .ExecuteAffrowsAsync();
            if (n <= 0) { this.Fail(404, "0404", "日程不存在"); return; }
            this.Saved("日程已保存");
            return;
        }
        OaCalendarEvent ev = new OaCalendarEvent();
        ev.tenantId = Tenant.Cur();
        ev.ownerId = me.id;
        ev.title = title;
        ev.description = this.InAny("description");
        ev.startAt = startAt;
        ev.endAt = endAt;
        ev.allDay = this.InAnyInt("allDay", 0) == 1 ? 1 : 0;
        ev.remindMinutes = remind;
        ev.reminded = 0;
        ev.relatedType = Calendar.CleanRelated(this.InAny("relatedType"));
        ev.relatedId = this.InAnyInt("relatedId", 0);
        ev.createdAt = now;
        ev.updatedAt = now;
        int newId = await this.OaCalendarEvent.Insert(ev).ExecuteIdentityAsync();
        this.Saved(newId > 0 ? "日程已创建" : "保存失败");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除日程")]
    async void Delete() {
        int id = this.InAnyInt("id", 0);
        SysUser me = await this.Admin();
        int n = await this.OaCalendarEvent.Delete()
            .Where(a => a.id == id && a.tenantId == Tenant.Cur() && a.ownerId == me.id)
            .ExecuteAffrowsAsync();
        this.Saved(n > 0 ? "已删除" : "日程不存在");
    }

    /* 支持 "YYYY-MM-DDTHH:MM" 与 "YYYY-MM-DD HH:MM[:SS]" → Unix 秒。 */
    static long LocalStamp(string s) {
        if (s == null || s.Length < 16) { return 0; }
        string sep = s.Substring(10, 1);
        if (sep != "T" && sep != " ") { return 0; }
        DateTime dt = DateTime.ParseDate(s.Substring(0, 10));
        if (dt == null) { return 0; }
        int h = DateTime.ParseDigits(s, 11, 2);
        int mi = DateTime.ParseDigits(s, 14, 2);
        if (h < 0 || h > 23 || mi < 0 || mi > 59) { return 0; }
        return dt.ToUnixSeconds() + (long)h * 3600 + (long)mi * 60
            - (long)Fmt.OffsetMinutes() * 60;
    }

    static string LocalStampValue(long epoch) {
        if (epoch <= 0) { return ""; }
        string s = Fmt.Stamp(epoch);
        return s.Substring(0, 10) + " " + s.Substring(11, 5);
    }

    static string CleanRelated(string v) {
        string s = Fmt.Text(v, "");
        if (s.Length > 32) { s = s.Substring(0, 32); }
        return s;
    }
}
