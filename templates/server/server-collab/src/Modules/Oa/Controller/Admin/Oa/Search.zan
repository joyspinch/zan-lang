using System;
using System.Collections.Generic;
using System.Json;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model;

namespace Zan.Web.Admin.Oa;

/* 全局搜索（纯 JSON 端点）：聚合器见 Framework/Search.zan。
   授权 Grant+View 门槛 + 源内屏闸双保险：各 Provider 已按 View 权限位过滤。 */
[Route("admin/oa/search/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("全局搜索")]
public class Search : CollabAdminController {

    [HttpGet]
    [Custom(Perm = PermBit.View, ApiMax = 60)]
    [Description("全局搜索")]
    public async void Query() {
        SysUser me = await this.Admin();
        List<SearchHit> hits = new List<SearchHit>();
        if (this.DbReady()) {
            hits = await Zan.Web.Search.Run(this.Held(), Tenant.Cur(), me,
                this.InAny("kw"), 5);
        }

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < hits.Count; i = i + 1) {
            SearchHit h = hits[i];
            w.WriteStartObject();
            w.WriteProperty("module", h.module);
            w.WriteProperty("group", Search.LabelOf(h.module));
            w.WriteProperty("title", h.title);
            w.WriteProperty("link", h.link.Length > 0 ? h.link : "");
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    /* 徽标中文映射（module 注册键 -> 下拉组名）。 */
    static string LabelOf(string module) {
        if (module == "crm_customer") { return "客户"; }
        if (module == "crm_contact") { return "联系人"; }
        if (module == "crm_opportunity") { return "商机"; }
        if (module == "wms_sku") { return "商品"; }
        if (module == "wms_warehouse") { return "仓库"; }
        if (module == "flow_inst") { return "流程"; }
        if (module == "oa_doc") { return "文档"; }
        return module;
    }
}
