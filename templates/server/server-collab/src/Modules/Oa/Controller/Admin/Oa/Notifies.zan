using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Threading;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model.Oa;
using Zan.Web.Model;

namespace Zan.Web.Admin.Oa;

/* 通知中心 canonical 页（架构 §2.2 WP-2 / T3）：AdminUI 列表 + WS/SSE 实时通知 + 免打扰开关。 */
[Route("admin/oa/notifies/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("通知中心")]
public class Notifies : CollabAdminController {
    static int StreamSeconds = 1800;

    static ListPage ScreenDef() {
        return ListPage.Of()
            .Tab("全部通知", "onlyUnread", "0")
            .Tab("仅看未读", "onlyUnread", "1")
            .TbarCustom("全部标为已读", "/admin/oa/notifies/read", "确认将所有未读通知标记为已读吗？")
            .TbarCustom("开启流程免打扰", "/admin/oa/notifies/mute?module=flow&on=1", "开启后流程通知将仅落库不推送，确认吗？")
            .TbarCustom("恢复流程提醒", "/admin/oa/notifies/mute?module=flow&on=0", "确认恢复流程实时推送提醒吗？")
            .Col("id", "ID", "num", "75")
            .Tag("kind", "类型", "assign=派工|warn,mention=提及|warn,done=流程|ok,alert=告警|off,message=私信|ok", "95")
            .Col("content", "通知内容", "text", "340")
            .Col("link", "关联入口", "text", "180")
            .Tag("isRead", "状态", "0=未读|warn,1=已读|ok", "85")
            .Col("createdAt", "时间", "text", "140")
            .Ops("标为已读", "/admin/oa/notifies/read", "确认将该通知标为已读吗？", "id={id}", "u");
    }

    [HttpGet]
    [Route("/admin/oa/notifies")]
    [Custom(IsMenu = true, Icon = "mdi:bell", Perm = PermBit.View)]
    [Description("通知中心")]
    public void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("通知中心表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Notifies.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("通知中心列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        SysUser me = await this.Admin();
        ListQuery q = this.PagedAny("id", 20);
        int onlyUnread = this.InAnyInt("onlyUnread", 0);

        List<SysNotify> rows = await this.SysNotify
            .Where(a => a.tenantId == Tenant.Cur() && a.userId == me.id)
            .WhereIf(onlyUnread == 1, a => a.isRead == 0)
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.SysNotify
            .Where(a => a.tenantId == Tenant.Cur() && a.userId == me.id)
            .WhereIf(onlyUnread == 1, a => a.isRead == 0)
            .CountAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            SysNotify n = rows[i];
            w.WriteStartObject();
            w.WriteProperty("id", n.id);
            w.WriteProperty("kind", n.kind);
            w.WriteProperty("content", n.content);
            w.WriteProperty("link", Fmt.Dash(n.link));
            w.WriteProperty("isRead", Convert.ToString(n.isRead));
            w.WriteProperty("createdAt", Fmt.Stamp(n.createdAt));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("未读通知")]
    public async void Unread() {
        SysUser me = await this.Admin();
        List<SysNotify> rows = await this.SysNotify
            .Where(a => a.tenantId == Tenant.Cur() && a.userId == me.id && a.isRead == 0)
            .OrderByDescending(a => a.id).Take(8).ToListAsync();
        int total = await this.SysNotify
            .Where(a => a.tenantId == Tenant.Cur() && a.userId == me.id && a.isRead == 0).CountAsync();
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("count", total.ToString());
        w.WritePropertyName("items");
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            w.WriteStartObject();
            w.WriteProperty("content", rows[i].content);
            w.WriteProperty("link", rows[i].link);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        w.WriteEndObject();
        this.Ctx().Json(w.ToJson());
    }

    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("通知事件流")]
    public async void Stream() {
        SysUser me = await this.Admin();
        HttpContext ctx = this.Ctx();
        WsSession ws = await WebWs.Upgrade(ctx);
        if (ws != null) {
            int unread = await this.SysNotify
                .Where(a => a.tenantId == Tenant.Cur() && a.userId == me.id && a.isRead == 0).CountAsync();
            JsonWriter first = new JsonWriter();
            first.WriteStartObject();
            first.WriteProperty("type", "unread");
            first.WriteProperty("count", unread);
            first.WriteEndObject();
            if (!await ws.SendText(first.ToJson())) { return; }
            Zan.Web.NotifyHub.JoinWs(me.id, ws);
            long started = WebApp.NowSeconds();
            while (ws.Open()) {
                string m = await ws.Recv();
                if (m == null) { break; }
                if (WebApp.NowSeconds() - started >= Notifies.StreamSeconds) {
                    await ws.Close(1000);
                    break;
                }
            }
            Zan.Web.NotifyHub.LeaveWs(ws);
            return;
        }
        if (!await ctx.SseOpen()) { return; }
        Zan.Web.NotifyHub.JoinSse(me.id, ctx);
        int unread2 = await this.SysNotify
            .Where(a => a.tenantId == Tenant.Cur() && a.userId == me.id && a.isRead == 0).CountAsync();
        JsonWriter firstSse = new JsonWriter();
        firstSse.WriteStartObject();
        firstSse.WriteProperty("count", unread2);
        firstSse.WriteEndObject();
        if (!await ctx.SseSend("unread", firstSse.ToJson())) {
            Zan.Web.NotifyHub.LeaveSse(ctx);
            return;
        }
        int elapsed = 0;
        while (elapsed < Notifies.StreamSeconds) {
            await Task.Delay(15000);
            elapsed = elapsed + 15;
            if (!await ctx.SseSend("", ": keep-alive")) {
                break;
            }
        }
        Zan.Web.NotifyHub.LeaveSse(ctx);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("标记已读")]
    public async void Read() {
        SysUser me = await this.Admin();
        int id = this.InAnyInt("id", 0);
        if (id > 0) {
            int _n = await this.SysNotify.Update()
                .Set(a => a.isRead, 1)
                .Where(a => a.id == id && a.tenantId == Tenant.Cur() && a.userId == me.id)
                .ExecuteAffrowsAsync();
        } else {
            int _n = await this.SysNotify.Update()
                .Set(a => a.isRead, 1)
                .Where(a => a.tenantId == Tenant.Cur() && a.userId == me.id)
                .ExecuteAffrowsAsync();
        }
        this.Saved("已标记");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("免打扰开关")]
    public async void Mute() {
        SysUser me = await this.Admin();
        string module = Fmt.Text(this.InAny("module"), "flow");
        int on = this.InAnyInt("on", 0);
        long now = WebApp.NowSeconds();
        SysNotifyPref row = await this.SysNotifyPref
            .Where(a => a.tenantId == Tenant.Cur() && a.userId == me.id && a.module == module)
            .FirstAsync();
        if (row != null) {
            int _u = await this.SysNotifyPref.Update()
                .Set(a => a.muted, on)
                .Set(a => a.updatedAt, now)
                .Where(a => a.id == row.id).ExecuteAffrowsAsync();
        } else {
            SysNotifyPref p = new SysNotifyPref();
            p.tenantId = Tenant.Cur();
            p.userId = me.id;
            p.module = module;
            p.muted = on;
            p.updatedAt = now;
            int _i = await this.SysNotifyPref.Insert(p).ExecuteIdentityAsync();
        }
        this.Saved(on == 1 ? "已开启免打扰" : "已恢复提醒");
    }
}
