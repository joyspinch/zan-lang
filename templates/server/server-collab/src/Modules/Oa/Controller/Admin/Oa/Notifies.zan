using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Threading;
using System.Web;
using ZanWeb.Model.Oa;
using ZanWeb.Model.Sys;

namespace ZanWeb.Admin.Oa;

/* 通知中心 canonical 页（架构 §2.2 WP-2 / T3）：跨模块通知统一落到 Oa 域——
   读写 sys_notify，WS/SSE 实时通道挂 NotifyHub。Flow 域旧路由
   /admin/flow/notifies 保留为兼容层：页面 301 到本页，铃铛 API（unread/
   stream/read）原路径照常服务（命名空间焊死纪律：URL 变更必留重定向）。
   免打扰开关走 sys_notify_pref：muted=1 的模块只落库不推（Notify.Muted）。 */
[Route("admin/oa/notifies/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("通知中心")]
class Notifies : AdminController {
    /* 流存活时长；标签整夜开着不应永远占协程，EventSource 会自连。 */
    static int StreamSeconds = 1800;

    [HttpGet]
    [Route("/admin/oa/notifies")]
    [Custom(IsMenu = true, Icon = "mdi:bell", Perm = PermBit.View)]
    [Description("通知中心")]
    async void Index() {
        User me = await this.Admin();
        ViewData d = await this.Layout("通知中心");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }
        ListQuery q = this.Paged("id", 20);
        /* Bug#6（本体 B）：sys_notify 历史脏数据（跨租户提及等）按 userId
           可见即死信泄漏——读面统一补 tenantId 双闸。 */
        List<SysNotify> rows = await this.SysNotify
            .Where(a => a.tenantId == this.TenantId() && a.userId == me.id)
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.SysNotify
            .Where(a => a.tenantId == this.TenantId() && a.userId == me.id).CountAsync();
        /* 免打扰现状（flow 域开关即页面上的示范位；其余模块开关随迁移渐次加入）。 */
        SysNotifyPref pref = await this.SysNotifyPref
            .Where(a => a.tenantId == this.TenantId() && a.userId == me.id
                && a.module == "flow").FirstAsync();
        bool muted = pref != null && pref.muted == 1;
        if (muted) { d.Set("muted", "1"); } else { d.Set("mutedOff", "1"); }
        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            SysNotify n = rows[i];
            StrMap m = new StrMap();
            m.Set("id", Convert.ToString(n.id));
            m.Set("kind", n.kind);
            m.Set("kindText", n.kind == "assign" ? "派工"
                : (n.kind == "mention" ? "提及"
                : (n.kind == "done" ? "流程"
                : (n.kind == "alert" ? "告警" : "通知"))));
            m.Set("content", n.content);
            m.Set("link", n.link);
            m.Set("unread", n.isRead == 0 ? "1" : "");
            m.Set("createdAt", Fmt.Day(n.createdAt));
            items.Add(m);
        }
        d.Set("empty", total == 0 ? "1" : "");
        this.Pager(d, q, total);
        this.Page(d);
    }

    /* 未读数与最新未读列表：顶栏铃铛的轻量数据源，由前端定时拉取（SSE 只推在线实时增量）。 */
    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("未读通知")]
    async void Unread() {
        User me = await this.Admin();
        /* Bug#6（本体 B）：未读数与未读列表同补租户闸（铃铛数据源）。 */
        List<SysNotify> rows = await this.SysNotify
            .Where(a => a.tenantId == this.TenantId() && a.userId == me.id
                && a.isRead == 0)
            .OrderByDescending(a => a.id).Take(8).ToListAsync();
        int total = await this.SysNotify
            .Where(a => a.tenantId == this.TenantId() && a.userId == me.id
                && a.isRead == 0).CountAsync();
        JsonValue items = JsonValue.NewArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            JsonValue o = JsonValue.NewObject();
            o.Put("content", JsonValue.NewStr(rows[i].content));
            o.Put("link", JsonValue.NewStr(rows[i].link));
            items.Append(o);
        }
        JsonValue body = JsonValue.NewObject();
        body.Put("count", JsonValue.NewStr(Convert.ToString(total)));
        body.Put("items", items);
        this.Ctx().Json(body.ToJson());
    }

    /* 实时通知通道：WebSocket 长连接为主——ctx.WsUpgrade() 在路由/权限之后升级，
       会话直接继承本路由的授权语义，升级前收到的管道帧由框架切进 WsReader。
       非 WS 请求（老代理/老客户端）回落 SSE，同一端点按 Upgrade 头自动分流。
       写方只有 NotifyHub.Push：会话循环只读，客户端 20s 文本心跳唤醒 Recv 即自动
       续期；服务端 30 分钟收口一次，前端断开后自动重连（重连重新过一遍鉴权）。 */
    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("通知事件流")]
    async void Stream() {
        User me = await this.Admin();
        HttpContext ctx = this.Ctx();
        WsSession ws = await ctx.WsUpgrade();
        if (ws != null) {
            /* 首帧同步未读数——此刻尚未登记进 NotifyHub，无并发写方，安全。
               Bug#6（本体 B）：WS 订阅首帧未读数补租户闸。 */
            int unread = await this.SysNotify
                .Where(a => a.tenantId == this.TenantId() && a.userId == me.id
                    && a.isRead == 0).CountAsync();
            if (!await ws.SendText("{\"type\":\"unread\",\"count\":"
                    + Convert.ToString(unread) + "}")) { return; }
            ZanWeb.NotifyHub.JoinWs(me.id, ws);
            long started = WebApp.NowSeconds();
            while (ws.Open()) {
                string m = await ws.Recv();
                if (m == null) { break; }
                if (WebApp.NowSeconds() - started >= Notifies.StreamSeconds) {
                    await ws.Close(1000);
                    break;
                }
                /* 入站文本（心跳 ping 等）一律忽略；协议级 ping/pong 在 Recv 内已答。 */
            }
            ZanWeb.NotifyHub.LeaveWs(ws);
            return;
        }
        /* SSE 回退通道：与 WS 同一端点，老代理/老客户端走原路。 */
        if (!await ctx.SseOpen()) { return; }
        ZanWeb.NotifyHub.JoinSse(me.id, ctx);
        /* 首帧同步一次未读数，页面打开即为最新。Bug#6（本体 B）：SSE 同补。 */
        int unread2 = await this.SysNotify
            .Where(a => a.tenantId == this.TenantId() && a.userId == me.id
                && a.isRead == 0).CountAsync();
        if (!await ctx.SseSend("unread", "{\"count\":"
                + Convert.ToString(unread2) + "}")) {
            ZanWeb.NotifyHub.LeaveSse(ctx);
            return;
        }
        int elapsed = 0;
        while (elapsed < Notifies.StreamSeconds) {
            await Task.Delay(15000);
            elapsed = elapsed + 15;
            /* 保活注释行：空闲时让代理不误判断连；NotifyHub.Push 的事件不受此影响。 */
            if (!await ctx.SseSend("", ": keep-alive")) {
                break;
            }
        }
        ZanWeb.NotifyHub.LeaveSse(ctx);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("标记已读")]
    async void Read() {
        User me = await this.Admin();
        int id = this.InInt("id", 0);
        long now = WebApp.NowSeconds();
        if (id > 0) {
            /* Bug#6（本体 B）：标记已读与读面同数据面，随读面补租户闸——
               脏死信已被读面隐藏，写面保持一致防复活路径。 */
            int _n = await this.SysNotify.Update()
                .Set(a => a.isRead, 1)
                .Where(a => a.id == id && a.tenantId == this.TenantId()
                    && a.userId == me.id)
                .ExecuteAffrowsAsync();
        } else {
            int _n = await this.SysNotify.Update()
                .Set(a => a.isRead, 1)
                .Where(a => a.tenantId == this.TenantId() && a.userId == me.id)
                .ExecuteAffrowsAsync();
        }
        this.Saved("已标记");
    }

    /* 免打扰开关：按 module 逐个控制（一期只暴露 flow；Notify.Muted 发送侧判定，
       muted=1 只落库不推）。行存在改 muted，不存在插行——偏好是稀疏数据，
       等值谓词查无即默认放行，无需为每个用户预建全模块行。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("免打扰开关")]
    async void Mute() {
        User me = await this.Admin();
        string module = Fmt.Text(this.In("module"), "flow");
        int on = this.InInt("on", 0);
        long now = WebApp.NowSeconds();
        SysNotifyPref row = await this.SysNotifyPref
            .Where(a => a.tenantId == this.TenantId() && a.userId == me.id
                && a.module == module).FirstAsync();
        if (row != null) {
            int _u = await this.SysNotifyPref.Update()
                .Set(a => a.muted, on)
                .Set(a => a.updatedAt, now)
                .Where(a => a.id == row.id).ExecuteAffrowsAsync();
        } else {
            SysNotifyPref p = new SysNotifyPref();
            p.tenantId = this.TenantId();
            p.userId = me.id;
            p.module = module;
            p.muted = on;
            p.updatedAt = now;
            int _i = await this.SysNotifyPref.Insert(p).ExecuteIdentityAsync();
        }
        this.Saved(on == 1 ? "已开启免打扰" : "已恢复提醒");
    }
}
