using System;
using System.Collections;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model.Oa;
using Zan.Web.Model;

namespace Zan.Web.Admin.Oa;

/* 公告（T12）：全员/按部门公告发布、置顶、已读回执与已读名单子表弹窗。 */
[Route("admin/oa/announcements/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("公告")]
public class Announcements : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .Text("公告标题", "kw", "title", "搜索公告标题")
            .TbarAdd("发布公告", "/admin/oa/announcements/form")
            .Col("id", "ID", "num", "75")
            .Col("title", "标题", "text", "240")
            .Tag("pinned", "置顶", "1=置顶|warn,0=普通|off", "85")
            .Tag("readState", "阅读状态", "1=已读|ok,0=未读|warn", "95")
            .Col("publisher", "发布人", "text", "120")
            .Col("createdAt", "发布时间", "text", "160")
            .Col("content", "正文摘要", "text", "240")
            .OpsEdit("/admin/oa/announcements/form")
            .Ops("标为已读", "/admin/oa/announcements/markread", "确认标记该公告为已读吗？", "id={id}", "")
            .Ops("置顶切换", "/admin/oa/announcements/pin", "确认切换该公告置顶状态吗？", "id={id}&pin={pinNext}", "u")
            .Ops("已读名单", "/admin/oa/announcements/reads", "", "id={id}", "u")
            .OpsDel("/admin/oa/announcements/delete", "确认删除该公告及已读明细吗？");
    }

    static ListPage ReadsDef() {
        return ListPage.Of()
            .Col("id", "ID", "num", "75")
            .Col("user", "已读人员", "text", "160")
            .Col("readAt", "阅读时间", "text", "180")
            .Col("reach", "触达概况", "text", "160");
    }

    [HttpGet]
    [Route("/admin/oa/announcements")]
    [Custom(IsMenu = true, Icon = "mdi:bullhorn", Perm = PermBit.View)]
    [Description("公告")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("公告表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Announcements.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("公告列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        SysUser me = await this.Admin();
        ListQuery q = this.PagedAny("id", 20);
        string kw = q.Kw();
        List<OaAnnouncement> rows = await this.OaAnnouncement
            .WhereIf(kw.Length > 0, a => a.title.Contains(kw))
            .OrderByDescending(a => a.pinned).OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.OaAnnouncement
            .WhereIf(kw.Length > 0, a => a.title.Contains(kw)).CountAsync();

        List<OaAnnouncementRead> reads = await this.OaAnnouncementRead
            .Where(a => a.userId == me.id).ToListAsync();
        List<int> pubIds = new List<int>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (!pubIds.Contains(rows[i].publisherId)) { pubIds.Add(rows[i].publisherId); }
        }
        List<SysUser> pubs = await this.SysUser
            .WhereIf(pubIds.Count > 0, a => pubIds.Contains(a.id)).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            OaAnnouncement r = rows[i];
            bool unread = Announcements.DeptHit(r, me) && !Announcements.Readed(reads, r.id);
            w.WriteStartObject();
            w.WriteProperty("id", r.id);
            w.WriteProperty("title", r.title);
            w.WriteProperty("content", r.content);
            w.WriteProperty("pinned", Convert.ToString(r.pinned));
            w.WriteProperty("pinNext", r.pinned == 1 ? 0 : 1);
            w.WriteProperty("readState", unread ? "0" : "1");
            w.WriteProperty("publisher", Announcements.NameOf(pubs, r.publisherId));
            w.WriteProperty("createdAt", Fmt.Stamp(r.createdAt));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("公告详情")]
    async void Detail() {
        SysUser me = await this.Admin();
        int id = this.InAnyInt("id", 0);
        OaAnnouncement r = await this.OaAnnouncement
            .Where(a => a.id == id).FirstAsync();
        if (r == null || !Announcements.DeptHit(r, me)) {
            this.Fail(404, "0404", "公告不存在"); return;
        }
        List<SysUser> pubs = await this.SysUser
            .Where(a => a.id == r.publisherId).ToListAsync();
        await this.EnsureRead(r, me);

        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", r.id);
        w.WriteProperty("title", r.title);
        w.WriteProperty("content", r.content);
        w.WriteProperty("publisher", pubs.Count > 0 ? Announcements.NameOf(pubs, r.publisherId) : "");
        w.WriteProperty("createdAt", Fmt.Stamp(r.createdAt));
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("标记公告已读")]
    async void MarkRead() {
        SysUser me = await this.Admin();
        int id = this.InAnyInt("id", 0);
        OaAnnouncement r = await this.OaAnnouncement
            .Where(a => a.id == id).FirstAsync();
        if (r == null || !Announcements.DeptHit(r, me)) {
            this.Fail(404, "0404", "公告不存在"); return;
        }
        await this.EnsureRead(r, me);
        this.Saved("已标记为已读");
    }

    private async void EnsureRead(OaAnnouncement r, SysUser me) {
        OaAnnouncementRead hit = await this.OaAnnouncementRead
            .Where(a => a.announcementId == r.id && a.userId == me.id).FirstAsync();
        if (hit == null) {
            OaAnnouncementRead row = new OaAnnouncementRead();
            row.tenantId = Tenant.Cur();
            row.announcementId = r.id;
            row.userId = me.id;
            row.readAt = WebApp.NowSeconds();
            await this.OaAnnouncementRead.Insert(row).ExecuteIdentityAsync();
        }
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("公告表单配置")]
    public async void FormConf() {
        FormPage fp = FormPage.Of("/admin/oa/announcements/save")
            .Wide()
            .Text("公告标题", "title").Req().Span().Ph("请输入公告标题")
            .Area("公告正文", "content").Span().Ph("支持多行文本，保留换行")
            .Text("受众部门ID", "dept").Ph("留空代表全员，多个部门 ID 逗号分隔")
            .Select("是否置顶", "pinned", "0=普通,1=置顶").Val("0");
        CrudOps.FormConf(this, fp, "公告");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("公告编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        OaAnnouncement r = await this.OaAnnouncement
            .Where(a => a.id == id).FirstAsync();
        if (r == null) { this.Fail(404, "0404", "公告不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", r.id);
        w.WriteProperty("title", r.title);
        w.WriteProperty("content", r.content);
        w.WriteProperty("dept", r.deptIds);
        w.WriteProperty("pinned", Convert.ToString(r.pinned));
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存公告")]
    async void Save() {
        SysUser me = await this.Admin();
        int id = this.InAnyInt("id", 0);
        string title = this.NeedAny("title", "公告标题");
        if (title.Length == 0) { this.Fail(400, "0004", "请填写公告标题"); return; }
        string content = this.InAnyRaw("content");
        if (content.Length > 8192) { content = content.Substring(0, 8192); }
        string deptIds = this.InAny("dept");
        if (deptIds.Length > 256) { this.Fail(400, "0004", "受众部门过多"); return; }
        int pinned = (await this.Can(PermBit.Update) && this.InAnyInt("pinned", 0) == 1) ? 1 : 0;
        long now = WebApp.NowSeconds();
        if (id > 0) {
            OaAnnouncement r = await this.OaAnnouncement
                .Where(a => a.id == id).FirstAsync();
            if (r == null) { this.Fail(404, "0404", "公告不存在"); return; }
            if (r.publisherId != me.id && me.isSuper != 1) {
                this.Fail(403, "0403", "仅发布者或管理员可编辑"); return;
            }
            int n = await this.OaAnnouncement.Update()
                .Set(a => a.title, title)
                .Set(a => a.content, content)
                .Set(a => a.deptIds, deptIds)
                .Set(a => a.pinned, pinned)
                .Set(a => a.updatedAt, now)
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            if (n <= 0) { this.Fail(404, "0404", "公告不存在"); return; }
            await this.Note("保存公告", title, true, "");
            this.Saved("公告已保存");
            return;
        }
        OaAnnouncement row = new OaAnnouncement();
        row.tenantId = Tenant.Cur();
        row.title = title;
        row.content = content;
        row.deptIds = deptIds;
        row.pinned = pinned;
        row.publisherId = me.id;
        row.createdAt = now;
        row.updatedAt = now;
        int newId = await this.OaAnnouncement.Insert(row).ExecuteIdentityAsync();
        await this.Note("发布公告", title, true, "");
        this.Saved(newId > 0 ? "公告已发布" : "保存失败");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除公告")]
    async void Delete() {
        SysUser me = await this.Admin();
        int id = this.InAnyInt("id", 0);
        OaAnnouncement r = await this.OaAnnouncement
            .Where(a => a.id == id).FirstAsync();
        if (r == null) { this.Fail(404, "0404", "公告不存在"); return; }
        if (r.publisherId != me.id && me.isSuper != 1) {
            this.Fail(403, "0403", "仅发布者或管理员可删除"); return;
        }
        int _c1 = await this.OaAnnouncementRead.Delete()
            .Where(a => a.announcementId == r.id).ExecuteAffrowsAsync();
        int _c2 = await this.OaAnnouncement.Delete()
            .Where(a => a.id == r.id).ExecuteAffrowsAsync();
        await this.Note("删除公告", r.title, true, "");
        this.Saved("已删除");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("公告置顶")]
    async void Pin() {
        int id = this.InAnyInt("id", 0);
        int pin = this.InAnyInt("pin", 1) == 1 ? 1 : 0;
        OaAnnouncement r = await this.OaAnnouncement
            .Where(a => a.id == id).FirstAsync();
        if (r == null) { this.Fail(404, "0404", "公告不存在"); return; }
        int n = await this.OaAnnouncement.Update()
            .Set(a => a.pinned, pin)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.id == r.id).ExecuteAffrowsAsync();
        await this.Note(pin == 1 ? "公告置顶" : "取消置顶", r.title, true, "");
        this.Saved(n > 0 ? (pin == 1 ? "已置顶" : "已取消置顶") : "操作失败");
    }

    /* 已读名单子表（SubTableModal） */
    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.Update)]
    [Description("已读名单")]
    void Reads() {
        this.ReadsConf();
    }

    [HttpPut]
    [Route("/admin/oa/announcements/reads/conf")]
    [Custom(Perm = PermBit.Update)]
    [Description("已读名单表格配置")]
    public void ReadsConf() {
        CrudOps.Conf(this, Announcements.ReadsDef());
    }

    [HttpPost]
    [Route("/admin/oa/announcements/reads/list")]
    [Custom(Perm = PermBit.Update)]
    [Description("已读名单列表数据")]
    public async void ReadsList() {
        if (!this.DataReady()) { return; }
        SysUser me = await this.Admin();
        int id = this.InAnyInt("id", 0);
        OaAnnouncement r = await this.OaAnnouncement
            .Where(a => a.id == id).FirstAsync();
        if (r == null) { this.Fail(404, "0404", "公告不存在"); return; }
        if (r.publisherId != me.id && me.isSuper != 1) {
            this.Fail(403, "0403", "仅发布者或管理员可查看"); return;
        }
        List<int> deptIds = Announcements.IdsOf(r.deptIds);
        List<SysUser> members = await this.SysUser
            .Where(a => a.status == 1)
            .WhereIf(deptIds.Count > 0, a => deptIds.Contains(a.departmentId))
            .ToListAsync();
        List<OaAnnouncementRead> reads = await this.OaAnnouncementRead
            .Where(a => a.announcementId == r.id)
            .OrderByDescending(a => a.id).ToListAsync();
        List<SysUser> users = await this.SysUser.ToListAsync();
        string reach = Convert.ToString(reads.Count) + " / " + Convert.ToString(members.Count);

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < reads.Count; i = i + 1) {
            OaAnnouncementRead rd = reads[i];
            w.WriteStartObject();
            w.WriteProperty("id", rd.id);
            w.WriteProperty("user", Announcements.NameOf(users, rd.userId));
            w.WriteProperty("readAt", Fmt.Stamp(rd.readAt));
            w.WriteProperty("reach", reach);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, reads.Count, w.ToString());
    }

    static bool DeptHit(OaAnnouncement r, SysUser me) {
        if (r.deptIds.Length == 0) { return true; }
        return AuthUser.Holds(r.deptIds, Convert.ToString(me.departmentId));
    }

    static bool Readed(List<OaAnnouncementRead> reads, int annId) {
        for (int i = 0; i < reads.Count; i = i + 1) {
            if (reads[i].announcementId == annId) { return true; }
        }
        return false;
    }

    private static List<int> IdsOf(string csv) {
        List<int> ids = new List<int>();
        if (csv.Length == 0) { return ids; }
        List<string> parts = csv.Split(",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (parts[i].Length == 0) { continue; }
            ids.Add(Convert.ToInt32(parts[i]));
        }
        return ids;
    }

    static string NameOf(List<SysUser> users, int id) {
        for (int i = 0; i < users.Count; i = i + 1) {
            if (users[i].id == id) { return Fmt.Text(users[i].nickname, users[i].username); }
        }
        return "—" + Convert.ToString(id);
    }
}
