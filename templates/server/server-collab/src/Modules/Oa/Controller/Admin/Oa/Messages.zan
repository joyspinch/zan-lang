using System;
using System.Collections;
using System.Data;
using System.Data.Orm;
using System.Web;
using System.Json;
using Zan.Web.AdminUi;
using Zan.Web.Model.Oa;
using Zan.Web.Model;

namespace Zan.Web.Admin.Oa;

/* 站内私信（T12）：会话列表 + 双向对话子表弹窗 + 发送 + 送达/已读回执。 */
[Route("admin/oa/messages/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("站内私信")]
public class Messages : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .TbarAdd("发送新私信", "/admin/oa/messages/form")
            .Col("peerId", "对方ID", "num", "80")
            .Col("peerName", "对话人", "text", "150")
            .Col("lastText", "最新消息", "text", "300")
            .Col("unread", "未读数", "num", "90")
            .Col("lastAt", "最近时间", "text", "160")
            .Ops("打开对话", "/admin/oa/messages/chat", "", "peer={peerId}", "");
    }

    static ListPage ChatDef() {
        return ListPage.Of()
            .TbarAdd("回复消息", "/admin/oa/messages/chat/form")
            .Col("id", "ID", "num", "75")
            .Col("who", "发送方", "text", "110")
            .Col("content", "消息内容", "text", "340")
            .Col("mark", "回执状态", "text", "95")
            .Col("at", "发送时间", "text", "160");
    }

    [HttpGet]
    [Route("/admin/oa/messages")]
    [Custom(IsMenu = true, Icon = "mdi:email", Perm = PermBit.View)]
    [Description("站内私信")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("私信会话表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Messages.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("私信会话列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        SysUser me = await this.Admin();
        List<OaMessage> rows = await this.OaMessage
            .Where(a => (a.fromId == me.id || a.toId == me.id))
            .OrderByDescending(a => a.id).ToListAsync();
        List<SysUser> users = await this.SysUser
            .Where(a => a.status == 1).ToListAsync();

        List<int> peers = new List<int>();
        List<int> unread = new List<int>();
        List<OaMessage> latest = new List<OaMessage>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            OaMessage r = rows[i];
            int peer = r.fromId == me.id ? r.toId : r.fromId;
            int at = Messages.IndexOf(peers, peer);
            if (at < 0) {
                peers.Add(peer);
                unread.Add(0);
                latest.Add(r);
                at = peers.Count - 1;
            }
            if (r.toId == me.id && r.isRead == 0) {
                unread[at] = unread[at] + 1;
            }
        }

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < peers.Count; i = i + 1) {
            OaMessage r = latest[i];
            w.WriteStartObject();
            w.WriteProperty("id", peers[i]);
            w.WriteProperty("peerId", peers[i]);
            w.WriteProperty("peerName", Messages.NameOf(users, peers[i]));
            w.WriteProperty("lastText", Messages.Excerpt(r.content, 60));
            w.WriteProperty("unread", unread[i]);
            w.WriteProperty("lastAt", Fmt.Stamp(r.createdAt));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, peers.Count, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("发送私信表单配置")]
    public async void FormConf() {
        SysUser me = await this.Admin();
        List<SysUser> users = await this.SysUser
            .Where(a => a.status == 1).OrderBy(a => a.id).ToListAsync();
        List<StrMap> uopts = new List<StrMap>();
        for (int i = 0; i < users.Count; i = i + 1) {
            if (users[i].id == me.id) { continue; }
            StrMap m = new StrMap();
            m.Set("id", Convert.ToString(users[i].id));
            m.Set("name", Fmt.Text(users[i].nickname, users[i].username));
            uopts.Add(m);
        }
        FormPage fp = FormPage.Of("/admin/oa/messages/send")
            .SelectList("收件人", "peer", uopts).Req()
            .Area("私信内容", "content").Req().Span().Ph("请输入要发送的私信内容");
        CrudOps.FormConf(this, fp, "发送私信");
    }

    /* ---- 双向对话子表弹窗（SubTableModal）---- */

    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("私信对话")]
    void Chat() {
        this.ChatConf();
    }

    [HttpPut]
    [Route("/admin/oa/messages/chat/conf")]
    [Custom(Perm = PermBit.View)]
    [Description("私信对话表格配置")]
    public void ChatConf() {
        CrudOps.Conf(this, Messages.ChatDef());
    }

    [HttpPost]
    [Route("/admin/oa/messages/chat/list")]
    [Custom(Perm = PermBit.View)]
    [Description("私信对话消息列表")]
    public async void ChatList() {
        if (!this.DataReady()) { return; }
        SysUser me = await this.Admin();
        int peerId = this.InAnyInt("peer", 0);
        SysUser peer = await this.SysUser
            .Where(a => a.id == peerId && a.status == 1).FirstAsync();
        if (peer == null) { this.Fail(404, "0404", "对方不存在或已停用"); return; }
        List<SysUser> peerList = new List<SysUser>();
        peerList.Add(peer);
        string peerName = Messages.NameOf(peerList, peer.id);

        List<OaMessage> rows = await this.OaMessage
            .Where(a => ((a.fromId == me.id && a.toId == peer.id)
                    || (a.fromId == peer.id && a.toId == me.id)))
            .OrderByDescending(a => a.id).ToListAsync();

        int maxUnread = 0;
        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            OaMessage r = rows[i];
            string mark = "—";
            if (r.fromId == me.id) {
                if (r.isRead == 1) { mark = "已读"; }
                else if (r.isAcked == 1) { mark = "已送达"; }
                else { mark = "已发送"; }
            }
            if (r.toId == me.id && r.isRead == 0 && r.id > maxUnread) {
                maxUnread = r.id;
            }
            w.WriteStartObject();
            w.WriteProperty("id", r.id);
            w.WriteProperty("who", r.fromId == me.id ? "我" : peerName);
            w.WriteProperty("content", r.content);
            w.WriteProperty("mark", mark);
            w.WriteProperty("at", Fmt.Stamp(r.createdAt));
            w.WriteEndObject();
        }
        w.WriteEndArray();

        int _n = await this.OaMessage.Update()
            .Set(a => a.isRead, 1)
            .Set(a => a.isAcked, 1)
            .Where(a => a.toId == me.id && a.fromId == peer.id && a.isRead == 0)
            .ExecuteAffrowsAsync();
        if (_n > 0 && maxUnread > 0) {
            await this.Receipt(Tenant.Cur(), maxUnread, peer.id, me.id, 2);
        }
        AdminUiProtocol.WriteListData(this, rows.Count, w.ToString());
    }

    [HttpPut]
    [Route("/admin/oa/messages/chat/formconf")]
    [Custom(Perm = PermBit.View)]
    [Description("回复私信表单配置")]
    public void ChatFormConf() {
        FormPage fp = FormPage.Of("/admin/oa/messages/send")
            .Area("回复内容", "content").Req().Span().Ph("请输入回复内容");
        CrudOps.FormConf(this, fp, "回复消息");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("发送私信")]
    async void Send() {
        SysUser me = await this.Admin();
        int peerId = this.InAnyInt("peer", 0);
        string content = this.InAnyRaw("content");
        if (content.Length == 0) { this.Fail(400, "0003", "私信内容不能为空"); return; }
        if (content.Length > 2048) { content = content.Substring(0, 2048); }
        if (peerId == me.id) { this.Fail(400, "0004", "不能给自己发私信"); return; }
        SysUser peer = await this.SysUser
            .Where(a => a.id == peerId && a.status == 1).FirstAsync();
        if (peer == null) { this.Fail(404, "0404", "对方不存在或已停用"); return; }
        OaMessage r = new OaMessage();
        r.tenantId = Tenant.Cur();
        r.fromId = me.id;
        r.toId = peer.id;
        r.content = content;
        r.isRead = 0;
        r.replyTo = 0;
        r.createdAt = WebApp.NowSeconds();
        int msgId = await this.OaMessage.Insert(r).ExecuteIdentityAsync();
        await Notify.Send(this.Held(), Tenant.Cur(), peer.id, "oa", "message",
            "新私信：" + Fmt.Text(me.nickname, me.username),
            Messages.Excerpt(content, 50),
            "/admin/oa/messages");
        this.Saved(msgId > 0 ? "已发送" : "发送失败");
    }

    [HttpPost]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("私信送达回执")]
    async void Ack() {
        SysUser me = await this.Admin();
        int id = this.InAnyInt("id", 0);
        if (id <= 0) { this.Ctx().Json(Envelope("0003")); return; }
        OaMessage r = await this.OaMessage
            .Where(a => a.id == id).FirstAsync();
        if (r == null || r.toId != me.id) {
            this.Ctx().Json(Envelope("0404"));
            return;
        }
        int n = await this.OaMessage.Update()
            .Set(a => a.isAcked, 1)
            .Where(a => a.id == r.id && a.toId == me.id && a.isAcked == 0)
            .ExecuteAffrowsAsync();
        if (n > 0) {
            await this.Receipt(Tenant.Cur(), r.id, r.fromId, me.id, 1);
        }
        this.Ctx().Json(Envelope("0000"));
    }

    [HttpPost]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("私信已读回执")]
    async void Read() {
        SysUser me = await this.Admin();
        int peerId = this.InAnyInt("peer", 0);
        if (peerId <= 0 || peerId == me.id) {
            this.Ctx().Json(Envelope("0003"));
            return;
        }
        List<OaMessage> unread = await this.OaMessage
            .Where(a => a.toId == me.id && a.fromId == peerId && a.isRead == 0)
            .OrderBy(a => a.id).ToListAsync();
        if (unread.Count == 0) { this.Ctx().Json(Envelope("0000")); return; }
        int maxId = 0;
        for (int i = 0; i < unread.Count; i = i + 1) {
            if (unread[i].id > maxId) { maxId = unread[i].id; }
        }
        await this.OaMessage.Update()
            .Set(a => a.isRead, 1)
            .Set(a => a.isAcked, 1)
            .Where(a => a.toId == me.id && a.fromId == peerId && a.isRead == 0)
            .ExecuteAffrowsAsync();
        await this.Receipt(Tenant.Cur(), maxId, peerId, me.id, 2);
        this.Ctx().Json(Envelope("0000"));
    }

    static string Envelope(string code) {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("code", code);
        w.WriteEndObject();
        return w.ToJson();
    }

    private async void Receipt(int tenantId, int msgId, int senderId, int byId, int kind) {
        OaMessageEvent ev = new OaMessageEvent();
        ev.tenantId = tenantId;
        ev.msgId = msgId;
        ev.fromId = senderId;
        ev.toId = byId;
        ev.kind = kind;
        ev.createdAt = WebApp.NowSeconds();
        await this.OaMessageEvent.Insert(ev).ExecuteIdentityAsync();
    }

    static int IndexOf(List<int> ids, int v) {
        for (int i = 0; i < ids.Count; i = i + 1) {
            if (ids[i] == v) { return i; }
        }
        return -1;
    }

    static string NameOf(List<SysUser> users, int id) {
        for (int i = 0; i < users.Count; i = i + 1) {
            if (users[i].id == id) { return Fmt.Text(users[i].nickname, users[i].username); }
        }
        return "用户" + Convert.ToString(id);
    }

    static string Excerpt(string s, int max) { return WebFmt.Excerpt(s, max); }
}
