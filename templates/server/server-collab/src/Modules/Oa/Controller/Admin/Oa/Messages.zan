using System;
using System.Collections;
using System.Data;
using System.Data.Orm;
using System.Web;
using System.Json;
using ZanWeb.Model.Oa;
using ZanWeb.Model.Sys;

namespace ZanWeb.Admin.Oa;

/* 站内私信（T12）：会话列表 + 双向聊天流 + 发送。会话列表内存按对端
   分组（内部规模依据同 TodoCenter，避开 DISTINCT SQL 谓词缺口）；
   打开会话即批量已读（收件人维度 UPDATE，勿碰 from 侧——Bug#7 同类
   谨记：isRead 只属 to）。新私信经 Notify.Send(module="oa", kind=
   "message") 走铃铛（在线即推、离线未读数），私信历史不进通知中心。
   已读/送达回执（本单）：对方客户端收帧即 Ack 置送达位、打开会话/会话
   内新消息即 Read 置已读位，都经 oa_message_event 事件表由 MessageRelay
   向发送方实时扇出 ack/read 帧；事件表只增不改，回执时序即落库即存证，
   不另设文件副本（查询全走主库，附件才落文件，见 data/uploads）。
   一期不做 SearchProvider：私信仅会话双方可见，Provider 权限语义不足。 */
[Route("admin/oa/messages/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("站内私信")]
class Messages : AdminController {
    [HttpGet]
    [Route("/admin/oa/messages")]
    [Custom(IsMenu = true, Icon = "mdi:email", Perm = PermBit.View)]
    [Description("站内私信")]
    async void Index() {
        User me = await this.Admin();
        ViewData d = await this.Layout("站内私信");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }
        /* 全量拉取（id DESC=最新在前），内存按对端分组取最新+未读数。 */
        List<OaMessage> rows = await this.OaMessage
            .Where(a => a.tenantId == this.TenantId()
                && (a.fromId == me.id || a.toId == me.id))
            .OrderByDescending(a => a.id).ToListAsync();
        List<User> users = await this.User
            .Where(a => a.tenantId == this.TenantId() && a.status == 1)
            .ToListAsync();
        List<int> peers = new List<int>();
        List<int> unread = new List<int>();
        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            OaMessage r = rows[i];
            int peer = r.fromId == me.id ? r.toId : r.fromId;
            int at = Messages.IndexOf(peers, peer);
            if (at < 0) {
                /* 首见即该会话最新一条（id DESC）。 */
                peers.Add(peer);
                unread.Add(0);
                StrMap m = new StrMap();
                m.Set("peerId", Convert.ToString(peer));
                m.Set("peerName", Messages.NameOf(users, peer));
                m.Set("lastText", Messages.Excerpt(r.content, 60));
                m.Set("mine", r.fromId == me.id ? "1" : "");
                m.Set("lastAt", Fmt.Stamp(r.createdAt));
                m.Set("unread", "0");
                items.Add(m);
                at = peers.Count - 1;
            }
            if (r.toId == me.id && r.isRead == 0) {
                unread[at] = unread[at] + 1;
            }
        }
        for (int i = 0; i < items.Count; i = i + 1) {
            items[i].Set("unread", Convert.ToString(unread[i]));
        }
        d.Set("empty", items.Count == 0 ? "1" : "");
        this.Page(d);
    }

    /* 与某人的双向流（按时间正序）+ 打开即批量已读（收件人维度）。
       对端必须本租户启用账号（跨租户/停用/不存在一律 404）。 */
    [HttpGet]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("私信对话")]
    async void Chat() {
        User me = await this.Admin();
        int peerId = this.InInt("peer", 0);
        User peer = await this.User
            .Where(a => a.id == peerId && a.tenantId == this.TenantId()
                && a.status == 1).FirstAsync();
        if (peer == null) { this.Fail(404, "0404", "对方不存在或已停用"); return; }
        List<User> peerList = new List<User>();
        peerList.Add(peer);
        string peerName = Messages.NameOf(peerList, peer.id);
        ViewData d = await this.Layout("与 " + peerName);
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }
        List<OaMessage> rows = await this.OaMessage
            .Where(a => a.tenantId == this.TenantId()
                && ((a.fromId == me.id && a.toId == peer.id)
                    || (a.fromId == peer.id && a.toId == me.id)))
            .OrderBy(a => a.id).ToListAsync();
        List<StrMap> items = d.AddList("rows");
        int maxUnread = 0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            OaMessage r = rows[i];
            StrMap m = new StrMap();
            m.Set("content", r.content);
            m.Set("mine", r.fromId == me.id ? "1" : "");
            m.Set("who", r.fromId == me.id ? "我" : peerName);
            m.Set("at", Fmt.Stamp(r.createdAt));
            m.Set("id", Convert.ToString(r.id));
            /* 回执标记（我发的消息）：已读 > 已送达，均按 toId 维度状态。 */
            string mark = "";
            if (r.fromId == me.id) {
                if (r.isRead == 1) { mark = "已读"; }
                else if (r.isAcked == 1) { mark = "已送达"; }
            }
            m.Set("mark", mark);
            if (r.toId == me.id && r.isRead == 0 && r.id > maxUnread) {
                maxUnread = r.id;
            }
            items.Add(m);
        }
        d.Set("empty", rows.Count == 0 ? "1" : "");
        d.Set("peerId", Convert.ToString(peer.id));
        d.Set("peerName", peerName);
        /* 打开即批量已读：只清 toId==me 侧，from 侧未读属于对方。
           顺带置送达位（读了必然已收到）；确有新已读才落事件，由
           MessageRelay 向对端实时扇出 type=read 帧（读到 maxUnread 为止）。 */
        int _n = await this.OaMessage.Update()
            .Set(a => a.isRead, 1)
            .Set(a => a.isAcked, 1)
            .Where(a => a.tenantId == this.TenantId()
                && a.toId == me.id && a.fromId == peer.id && a.isRead == 0)
            .ExecuteAffrowsAsync();
        if (_n > 0 && maxUnread > 0) {
            await this.Receipt(this.TenantId(), maxUnread, peer.id, me.id, 2);
        }
        this.Page(d);
    }

    /* 发送：正文必填；对端本租户启用账号校验；INSERT isRead=0 +
       Notify.Send 走铃铛（kind=message，链接回本会话）。 */
    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("发送私信")]
    async void Send() {
        User me = await this.Admin();
        int peerId = this.InInt("peer", 0);
        /* Bug#8：私信正文 textarea 多行语义，Need 内部走 In(Filter.Clean) 会剥
           换行——InRaw + 同语义空检查（原 Need 文案不变）。 */
        string content = this.InRaw("content");
        if (content.Length == 0) { this.Fail(400, "0003", "私信内容不能为空"); return; }
        if (content.Length > 2048) { content = content.Substring(0, 2048); }
        if (peerId == me.id) { this.Fail(400, "0004", "不能给自己发私信"); return; }
        User peer = await this.User
            .Where(a => a.id == peerId && a.tenantId == this.TenantId()
                && a.status == 1).FirstAsync();
        if (peer == null) { this.Fail(404, "0404", "对方不存在或已停用"); return; }
        OaMessage r = new OaMessage();
        r.tenantId = this.TenantId();
        r.fromId = me.id;
        r.toId = peer.id;
        r.content = content;
        r.isRead = 0;
        r.replyTo = 0;
        r.createdAt = WebApp.NowSeconds();
        int msgId = await this.OaMessage.Insert(r).ExecuteIdentityAsync();
        await Notify.Send(this.Held(), this.TenantId(), peer.id, "oa", "message",
            "新私信：" + Fmt.Text(me.nickname, me.username),
            Messages.Excerpt(content, 50),
            "/admin/oa/messages/chat?peer=" + Convert.ToString(me.id));
        this.Saved("已发送");
    }

    /* 送达回执：收件人客户端收到 type=message 实时帧即打点（chat.js 自动
       调，不依赖打开会话——在列表页/其他标签收到也算送达）。只按 toId
       维度写 isAcked（isRead 同款纪律，勿碰发送方状态）；首次确认才落
       事件+历史，重复调用幂等。 */
    [HttpPost]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("私信送达回执")]
    async void Ack() {
        User me = await this.Admin();
        int id = this.InInt("id", 0);
        if (id <= 0) { this.Ctx().Json(Envelope("0003")); return; }
        OaMessage r = await this.OaMessage
            .Where(a => a.id == id && a.tenantId == this.TenantId())
            .FirstAsync();
        if (r == null || r.toId != me.id) {
            this.Ctx().Json(Envelope("0404"));
            return;
        }
        int n = await this.OaMessage.Update()
            .Set(a => a.isAcked, 1)
            .Where(a => a.id == r.id && a.tenantId == this.TenantId()
                && a.toId == me.id && a.isAcked == 0)
            .ExecuteAffrowsAsync();
        if (n > 0) {
            await this.Receipt(this.TenantId(), r.id, r.fromId, me.id, 1);
        }
        this.Ctx().Json(Envelope("0000"));
    }

    /* 已读回执（实时）：打开中的会话收到新消息由前端调用——标记已读
       （顺带送达位）并落已读事件，对端在线即实时点亮「已读」。与 Chat
       打开时的批量已读同一语义，只按 toId==me 维度写。 */
    [HttpPost]
    [Custom(IsMenu = false, Perm = PermBit.View)]
    [Description("私信已读回执")]
    async void Read() {
        User me = await this.Admin();
        int peerId = this.InInt("peer", 0);
        if (peerId <= 0 || peerId == me.id) {
            this.Ctx().Json(Envelope("0003"));
            return;
        }
        List<OaMessage> unread = await this.OaMessage
            .Where(a => a.tenantId == this.TenantId()
                && a.toId == me.id && a.fromId == peerId && a.isRead == 0)
            .OrderBy(a => a.id).ToListAsync();
        if (unread.Count == 0) { this.Ctx().Json(Envelope("0000")); return; }
        int maxId = 0;
        for (int i = 0; i < unread.Count; i = i + 1) {
            if (unread[i].id > maxId) { maxId = unread[i].id; }
        }
        await this.OaMessage.Update()
            .Set(a => a.isRead, 1)
            .Set(a => a.isAcked, 1)
            .Where(a => a.tenantId == this.TenantId()
                && a.toId == me.id && a.fromId == peerId && a.isRead == 0)
            .ExecuteAffrowsAsync();
        await this.Receipt(this.TenantId(), maxId, peerId, me.id, 2);
        this.Ctx().Json(Envelope("0000"));
    }


    /* 统一信封：树构建产出 {"code":"...."}，杜绝手拼。 */
    static string Envelope(string code) {
        JsonValue o = JsonValue.NewObject();
        o.PutStr("code", code);
        return o.ToJson();
    }

    /* ---- helpers ---- */

    /* 回执事件落库：read/ack 共用。事件表即总线，MessageRelay 水位扫描
       后向消息发送方（ev.fromId）扇出实时帧；kind 1=送达 2=已读，与
       OaMessageEvent.kind 对应。只增不改，回执时序即存证（主库可查）。 */
    async void Receipt(int tenantId, int msgId, int senderId, int byId,
        int kind) {
        OaMessageEvent ev = new OaMessageEvent();
        ev.tenantId = tenantId;
        ev.msgId = msgId;
        ev.fromId = senderId;
        ev.toId = byId;
        ev.kind = kind;
        ev.createdAt = WebApp.NowSeconds();
        await this.OaMessageEvent.Insert(ev).ExecuteIdentityAsync();
    }

    static int IndexOf(List<int> ids, int v) {
        for (int i = 0; i < ids.Count; i = i + 1) {
            if (ids[i] == v) { return i; }
        }
        return -1;
    }

    /* 昵称空回退用户名；对端行缺席（已删号的历史会话）显示占位。 */
    static string NameOf(List<User> users, int id) {
        for (int i = 0; i < users.Count; i = i + 1) {
            if (users[i].id == id) { return Fmt.Text(users[i].nickname, users[i].username); }
        }
        return "用户" + Convert.ToString(id);
    }

    /* 单行摘要：换行折空格，超长截断。截断走 Fmt.Excerpt——按字节截之前
       先回退到 UTF-8 字符边界，切掉半个汉字会让整个 JSON 应答不可解析。 */
    static string Excerpt(string s, int max) { return Fmt.Excerpt(s, max); }
}
