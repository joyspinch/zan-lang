using System.Data.Orm;

namespace ZanWeb.Model.Wms;

/* 入库流水。只 INSERT 不 UPDATE：一笔入库提交后不可改，更正走反向流水。createdAt 同时是流水时序键。 */
[Table(Name = "wms_stock_in")]
class WmsStockIn {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 32, IsNullable = false)]
    string billNo;

    int warehouseId;
    int skuId;
    long qty;
    int operatorId;

    [Column(StringLength = 256)]
    string remark;

    long createdAt;
}
