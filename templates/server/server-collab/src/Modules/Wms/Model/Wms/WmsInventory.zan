using System.Data.Orm;

namespace ZanWeb.Model.Wms;

/* 当前库存汇总。由入库/出库流水汇总得出，不在业务代码里直接写——入库/出库动作改这张表的数字。 */
[Table(Name = "wms_inventory")]
class WmsInventory {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，#34）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new WmsInventory() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    int warehouseId;
    int skuId;
    long qty;

    long updatedAt;
}
