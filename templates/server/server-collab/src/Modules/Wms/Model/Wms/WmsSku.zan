using System.Data.Orm;

namespace ZanWeb.Model.Wms;

/* 商品(SKU)主数据。规格/单位在此；库存数量不在此表——当前库存由流水汇总得出（见 wms_inventory）。 */
[Table(Name = "wms_sku")]
class WmsSku {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，#34）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new WmsSku() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    [Column(StringLength = 64, IsNullable = false)]
    string sku;

    [Column(StringLength = 128, IsNullable = false)]
    string name;

    [Column(StringLength = 32)]
    string unit;

    [Column(StringLength = 256)]
    string spec;

    long createdAt;
    long updatedAt;
}
