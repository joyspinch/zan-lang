using System.Data.Orm;

namespace ZanWeb.Model.Wms;

/* 仓库主数据。wms_ 前缀=仓储域；所有业务表从第一天起带 tenant_id（默认 1），但暂不做租户隔离逻辑。 */
[Table(Name = "wms_warehouse")]
class WmsWarehouse {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，#34）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new WmsWarehouse() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    [Column(StringLength = 128)]
    string location;

    [Column(StringLength = 32)]
    string code;

    /* 1=启用；其他值不可用于出入库。 */
    int status;

    long createdAt;
    long updatedAt;
}
