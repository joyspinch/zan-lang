using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model;
using Zan.Web.Model.Wms;

namespace Zan.Web.Admin.Wms;

/* /admin/wms/stockin 入库登记：列表 + 弹窗建单（[Tx] 内原子写流水并汇总库存）。 */
[Route("admin/wms/stockin/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("入库登记")]
public class StockIn : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .TbarAdd("新建入库单", "/admin/wms/stockin/form")
            .Col("id", "ID", "num", "75")
            .Col("billNo", "入库单号", "text", "170")
            .Col("warehouse", "仓库", "text", "160")
            .Col("sku", "商品", "text", "200")
            .Col("qty", "入库数量", "num", "110")
            .Col("remark", "备注", "text", "180")
            .Col("createdAt", "入库日期", "text", "125");
    }

    [HttpGet]
    [Route("/admin/wms/stockin")]
    [Custom(IsMenu = true, Icon = "mdi:package-variant", Perm = PermBit.View)]
    [Description("入库登记")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("入库单表格配置")]
    public void Conf() {
        CrudOps.Conf(this, StockIn.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("入库单列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        ListQuery q = this.PagedAny("id", 20);
        List<WmsStockIn> rows = await this.WmsStockIn
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.WmsStockIn
            .Where(a => a.tenantId == Tenant.Cur()).CountAsync();

        List<WmsWarehouse> whs = await this.WmsWarehouse
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<WmsSku> skus = await this.WmsSku
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            WmsStockIn r = rows[i];
            w.WriteStartObject();
            w.WriteProperty("id", r.id);
            w.WriteProperty("billNo", r.billNo);
            w.WriteProperty("warehouse", StockIn.NameOf(whs, r.warehouseId));
            w.WriteProperty("sku", StockIn.NameOfSku(skus, r.skuId));
            w.WriteProperty("qty", r.qty);
            w.WriteProperty("remark", Fmt.Dash(r.remark));
            w.WriteProperty("createdAt", Fmt.Day(r.createdAt));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create)]
    [Description("入库表单配置")]
    public async void FormConf() {
        List<WmsWarehouse> whs = await this.WmsWarehouse
            .Where(a => a.tenantId == Tenant.Cur() && a.status == 1)
            .OrderBy(a => a.id).ToListAsync();
        List<WmsSku> skus = await this.WmsSku
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<StrMap> wopts = new List<StrMap>();
        for (int i = 0; i < whs.Count; i = i + 1) {
            StrMap o = new StrMap();
            o.Set("id", Convert.ToString(whs[i].id));
            o.Set("name", whs[i].name);
            wopts.Add(o);
        }
        List<StrMap> sopts = new List<StrMap>();
        for (int i = 0; i < skus.Count; i = i + 1) {
            StrMap o = new StrMap();
            o.Set("id", Convert.ToString(skus[i].id));
            o.Set("name", skus[i].name + "（" + skus[i].sku + "）");
            sopts.Add(o);
        }
        FormPage fp = FormPage.Of("/admin/wms/stockin/submit")
            .SelectList("入库仓库", "warehouseId", wopts).Req()
            .SelectList("入库商品", "skuId", sopts).Req()
            .Num("入库数量", "qty").Req().Val("1")
            .Area("备注", "remark").Span().Ph("供应商 / 批次说明");
        CrudOps.FormConf(this, fp, "新建入库单");
    }

    [HttpPost]
    [Tx]
    [Custom(Perm = PermBit.Create)]
    [Description("提交入库单")]
    async void Submit() {
        int warehouseId = this.InAnyInt("warehouseId", 0);
        int skuId = this.InAnyInt("skuId", 0);
        int qty = this.InAnyInt("qty", 0);
        string remark = this.InAny("remark");
        if (warehouseId <= 0) { this.Fail(400, "0004", "请选择仓库"); return; }
        if (skuId <= 0) { this.Fail(400, "0004", "请选择商品"); return; }
        if (qty <= 0) { this.Fail(400, "0004", "数量必须大于 0"); return; }

        WmsWarehouse wh = await this.WmsWarehouse
            .Where(a => a.id == warehouseId && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (wh == null || wh.status != 1) { this.Fail(400, "0004", "仓库不可用"); return; }
        WmsSku sku = await this.WmsSku
            .Where(a => a.id == skuId && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (sku == null) { this.Fail(400, "0004", "商品不存在"); return; }

        SysUser me = await this.Admin();
        int operatorId = me != null ? me.id : 0;

        string billNo = StockIn.NextBill();
        WmsStockIn flow = new WmsStockIn();
        flow.tenantId = Tenant.Cur();
        flow.billNo = billNo;
        flow.warehouseId = warehouseId;
        flow.skuId = skuId;
        flow.qty = (long)qty;
        flow.operatorId = operatorId;
        flow.remark = remark;
        flow.createdAt = WebApp.NowSeconds();
        int flowId = await this.WmsStockIn.Insert(flow).ExecuteIdentityAsync();
        if (flowId <= 0) { this.Fail(500, "0500", "流水写入失败"); return; }

        WmsInventory inv = await this.WmsInventory
            .Where(a => a.warehouseId == warehouseId && a.skuId == skuId
                && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (inv == null) {
            WmsInventory ni = new WmsInventory();
            ni.tenantId = Tenant.Cur();
            ni.warehouseId = warehouseId;
            ni.skuId = skuId;
            ni.qty = (long)qty;
            ni.updatedAt = WebApp.NowSeconds();
            await this.WmsInventory.Insert(ni).ExecuteIdentityAsync();
        } else {
            await this.WmsInventory.Update()
                .Set(a => a.qty, inv.qty + (long)qty)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == inv.id)
                .ExecuteAffrowsAsync();
        }
        await this.Note("入库登记", billNo + " +" + Convert.ToString(qty), true, "");
        this.Saved("入库成功：" + billNo);
    }

    private static string NextBill() {
        long t = WebApp.NowSeconds();
        return "IN" + Convert.ToString(t);
    }

    static string NameOf(List<WmsWarehouse> list, int id) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i].id == id) { return list[i].name; }
        }
        return "—";
    }

    static string NameOfSku(List<WmsSku> list, int id) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i].id == id) { return list[i].name; }
        }
        return "—";
    }
}
