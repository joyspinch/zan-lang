using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model;
using Zan.Web.Model.Wms;

namespace Zan.Web.Admin.Wms;

/* /admin/wms/inventory 库存查询：只读汇总 + Excel 导出。 */
[Route("admin/wms/inventory/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("库存查询")]
public class Inventory : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .TbarDownload("导出 Excel", "/admin/wms/inventory/export?xlsx=1")
            .Col("id", "ID", "num", "75")
            .Col("warehouse", "仓库", "text", "180")
            .Col("skuCode", "SKU 编码", "text", "150")
            .Col("sku", "商品名称", "text", "220")
            .Col("qty", "当前库存", "num", "120")
            .Col("updatedAt", "更新日期", "text", "130");
    }

    [HttpGet]
    [Route("/admin/wms/inventory")]
    [Custom(IsMenu = true, Icon = "mdi:clipboard-list", Perm = PermBit.View)]
    [Description("库存查询")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("库存表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Inventory.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("库存列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        ListQuery q = this.PagedAny("id", 20);
        List<WmsInventory> rows = await this.WmsInventory
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.WmsInventory
            .Where(a => a.tenantId == Tenant.Cur()).CountAsync();

        List<WmsWarehouse> whs = await this.WmsWarehouse
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<WmsSku> skus = await this.WmsSku
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            WmsInventory r = rows[i];
            WmsSku s = Inventory.SkuOf(skus, r.skuId);
            w.WriteStartObject();
            w.WriteProperty("id", r.id);
            w.WriteProperty("warehouse", Inventory.NameOf(whs, r.warehouseId));
            w.WriteProperty("skuCode", s != null ? Fmt.Dash(s.sku) : "—");
            w.WriteProperty("sku", Inventory.NameOfSku(skus, r.skuId));
            w.WriteProperty("qty", r.qty);
            w.WriteProperty("updatedAt", Fmt.Day(r.updatedAt));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    static string NameOf(List<WmsWarehouse> list, int id) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i].id == id) { return list[i].name; }
        }
        return "—";
    }

    static string NameOfSku(List<WmsSku> list, int id) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i].id == id) { return list[i].name; }
        }
        return "—";
    }

    [HttpGet]
    [Custom(Perm = PermBit.Export)]
    [Description("导出库存")]
    async void Export() {
        bool xlsx = this.InAnyInt("xlsx", 0) == 1;
        List<WmsInventory> rows = await this.WmsInventory
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<WmsWarehouse> whs = await this.WmsWarehouse
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<WmsSku> skus = await this.WmsSku
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();

        List<string> headers = new List<string>();
        headers.Add("仓库"); headers.Add("SKU编码"); headers.Add("商品名称");
        headers.Add("库存数量"); headers.Add("更新日期");
        List<List<string>> data = new List<List<string>>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            WmsInventory r = rows[i];
            WmsSku s = Inventory.SkuOf(skus, r.skuId);
            List<string> row = new List<string>();
            row.Add(Inventory.NameOf(whs, r.warehouseId));
            row.Add(s != null ? s.sku : "");
            row.Add(Inventory.NameOfSku(skus, r.skuId));
            row.Add(Convert.ToString(r.qty));
            row.Add(Fmt.Day(r.updatedAt));
            data.Add(row);
        }
        await ExcelIo.Download(this.Ctx(), "库存", headers, data, xlsx);
    }

    private static WmsSku SkuOf(List<WmsSku> list, int id) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i].id == id) { return list[i]; }
        }
        return null;
    }
}
