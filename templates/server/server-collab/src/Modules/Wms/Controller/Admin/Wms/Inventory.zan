using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Sys;
using ZanWeb.Model.Wms;

namespace ZanWeb.Admin.Wms;

/* /admin/wms/inventory 库存查询：只读汇总。当前库存由 wms_inventory 提供，名称在控制器内关联仓库与 SKU。 */
[Route("admin/wms/inventory/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("库存查询")]
class Inventory : AdminController {
    [HttpGet]
    [Route("/admin/wms/inventory")]
    [Custom(IsMenu = true, Icon = "mdi:clipboard-list", Perm = PermBit.View)]
    [Description("库存查询")]
    async void Index() {
        ViewData d = await this.Layout("库存查询");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }

        ListQuery q = this.Paged("id", 20);
        List<WmsInventory> rows = await this.WmsInventory
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.WmsInventory.CountAsync();

        List<WmsWarehouse> whs = await this.WmsWarehouse.OrderBy(a => a.id).ToListAsync();
        List<WmsSku> skus = await this.WmsSku.OrderBy(a => a.id).ToListAsync();

        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            WmsInventory r = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(r.id));
            row.Set("warehouse", Inventory.NameOf(whs, r.warehouseId));
            row.Set("sku", Inventory.NameOfSku(skus, r.skuId));
            row.Set("qty", Convert.ToString(r.qty));
            row.Set("updatedAt", Fmt.Day(r.updatedAt));
            items.Add(row);
        }
        this.Pager(d, q, total);
        this.Page(d);
    }

    static string NameOf(List<WmsWarehouse> list, int id) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i].id == id) { return list[i].name; }
        }
        return "—";
    }

    static string NameOfSku(List<WmsSku> list, int id) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i].id == id) { return list[i].name; }
        }
        return "—";
    }

    /* ---- T7 导出（只读汇总不开放导入，偏差记录 ②：
       库存由流水汇总得出，直接导入会绕过流水账）-------------------------- */
    [HttpGet]
    [Custom(Perm = PermBit.Export)]
    [Description("导出库存")]
    async void Export() {
        bool xlsx = this.InInt("xlsx", 0) == 1;
        List<WmsInventory> rows = await this.WmsInventory
            .OrderBy(a => a.id).ToListAsync();
        List<WmsWarehouse> whs = await this.WmsWarehouse
            .OrderBy(a => a.id).ToListAsync();
        List<WmsSku> skus = await this.WmsSku
            .OrderBy(a => a.id).ToListAsync();

        List<string> headers = new List<string>();
        headers.Add("仓库"); headers.Add("SKU编码"); headers.Add("商品名称");
        headers.Add("库存数量"); headers.Add("更新日期");
        List<List<string>> data = new List<List<string>>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            WmsInventory r = rows[i];
            WmsSku s = Inventory.SkuOf(skus, r.skuId);
            List<string> row = new List<string>();
            row.Add(Inventory.NameOf(whs, r.warehouseId));
            row.Add(s != null ? s.sku : "");
            row.Add(Inventory.NameOfSku(skus, r.skuId));
            row.Add(Convert.ToString(r.qty));
            row.Add(Fmt.Day(r.updatedAt));
            data.Add(row);
        }
        await ExcelIo.Download(this.Ctx(), "库存", headers, data, xlsx);
    }

    static WmsSku SkuOf(List<WmsSku> list, int id) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i].id == id) { return list[i]; }
        }
        return null;
    }
}
