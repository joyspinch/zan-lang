using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model;
using Zan.Web.Model.Wms;

namespace Zan.Web.Admin.Wms;

/* /admin/wms/warehouses 仓库管理：搜索、建、编、启禁。 */
[Route("admin/wms/warehouses/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("仓库管理")]
public class Warehouses : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .Text("仓库名称", "kw", "name", "按仓库名称搜索")
            .TbarAdd("新增仓库", "/admin/wms/warehouses/form")
            .Col("id", "ID", "num", "75")
            .Col("name", "仓库名称", "text", "180")
            .Col("code", "编码", "text", "130")
            .Col("location", "库位/地址", "text", "220")
            .Tag("status", "状态", "1=启用|ok,0=禁用|off", "90")
            .OpsEdit("/admin/wms/warehouses/form")
            .Ops("切换状态", "/admin/wms/warehouses/status", "确认切换该仓库启停状态吗？", "id={id}&status={nextStatus}", "u");
    }

    static FormPage FormDef() {
        return FormPage.Of("/admin/wms/warehouses/save")
            .Text("仓库名称", "name").Req().Ph("请输入仓库名称")
            .Text("仓库编码", "code").Ph("例如：WH-01")
            .Text("仓库地址", "location").Ph("仓库所在位置或地址")
            .Select("状态", "status", "1=启用,0=禁用").Val("1");
    }

    [HttpGet]
    [Route("/admin/wms/warehouses")]
    [Custom(IsMenu = true, Icon = "mdi:warehouse", Perm = PermBit.View)]
    [Description("仓库管理")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("仓库表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Warehouses.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("仓库列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        ListQuery q = this.PagedAny("id", 20);
        string kw = q.Kw();
        List<WmsWarehouse> rows = await this.WmsWarehouse
            .Where(a => a.tenantId == Tenant.Cur())
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.WmsWarehouse
            .Where(a => a.tenantId == Tenant.Cur())
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .CountAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            WmsWarehouse wh = rows[i];
            w.WriteStartObject();
            w.WriteProperty("id", wh.id);
            w.WriteProperty("name", wh.name);
            w.WriteProperty("code", Fmt.Dash(wh.code));
            w.WriteProperty("location", Fmt.Dash(wh.location));
            w.WriteProperty("status", Convert.ToString(wh.status));
            w.WriteProperty("nextStatus", wh.status == 1 ? 0 : 1);
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("仓库表单配置")]
    public void FormConf() {
        CrudOps.FormConf(this, Warehouses.FormDef(), "仓库");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("仓库编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        WmsWarehouse wh = await this.WmsWarehouse
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (wh == null) { this.Fail(404, "0404", "仓库不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", wh.id);
        w.WriteProperty("name", wh.name);
        w.WriteProperty("code", wh.code);
        w.WriteProperty("location", wh.location);
        w.WriteProperty("status", Convert.ToString(wh.status));
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存仓库")]
    async void Save() {
        int id = this.InAnyInt("id", 0);
        string name = this.NeedAny("name", "仓库名称");
        string code = this.InAny("code");
        string location = this.InAny("location");
        int status = this.InAnyInt("status", 1);
        if (status != 1) { status = 0; }

        if (id > 0) {
            int n = await this.WmsWarehouse.Update()
                .Set(a => a.name, name)
                .Set(a => a.code, code)
                .Set(a => a.location, location)
                .Set(a => a.status, status)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id && a.tenantId == Tenant.Cur())
                .ExecuteAffrowsAsync();
            await this.Note("编辑仓库", "#" + Convert.ToString(id) + " " + name, n > 0, "");
            this.Saved("仓库已保存");
            return;
        }
        WmsWarehouse wh = new WmsWarehouse();
        wh.tenantId = Tenant.Cur();
        wh.name = name;
        wh.code = code;
        wh.location = location;
        wh.status = status;
        wh.createdAt = WebApp.NowSeconds();
        wh.updatedAt = wh.createdAt;
        int newId = await this.WmsWarehouse.Insert(wh).ExecuteIdentityAsync();
        await this.Note("新增仓库", "#" + Convert.ToString(newId) + " " + name, newId > 0, "");
        this.Saved("仓库已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("启用或禁用仓库")]
    async void Status() {
        int id = this.InAnyInt("id", 0);
        int status = this.InAnyInt("status", 1);
        if (status != 1) { status = 0; }
        int n = await this.WmsWarehouse.Update()
            .Set(a => a.status, status)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        await this.Note("启用或禁用仓库", "#" + Convert.ToString(id), n > 0,
            status == 1 ? "启用" : "禁用");
        this.Saved(status == 1 ? "仓库已启用" : "仓库已禁用");
    }
}
