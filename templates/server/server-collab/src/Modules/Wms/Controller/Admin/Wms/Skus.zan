using System;
using Formats.Csv;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web;
using Zan.Web.AdminUi;
using Zan.Web.Dao.Wms;
using Zan.Web.Model;
using Zan.Web.Model.Wms;

namespace Zan.Web.Admin.Wms;

/* /admin/wms/skus 商品(SKU)主数据：搜索、建、编、删、导入导出。 */
[Route("admin/wms/skus/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("商品管理")]
public class Skus : CollabAdminController {
    static ListPage ScreenDef() {
        return ListPage.Of()
            .Text("名称 / SKU", "kw", "name|sku", "搜索商品名称或 SKU")
            .TbarAdd("新增商品", "/admin/wms/skus/form")
            .TbarDownload("导出 Excel", "/admin/wms/skus/export?xlsx=1")
            .TbarDownload("下载模板", "/admin/wms/skus/template")
            .Col("id", "ID", "num", "75")
            .Col("sku", "SKU 编码", "text", "150")
            .Col("name", "商品名称", "text", "200")
            .Col("unit", "单位", "text", "85")
            .Col("spec", "规格", "text", "200")
            .OpsEdit("/admin/wms/skus/form")
            .OpsDel("/admin/wms/skus/delete", "确认删除该商品吗？");
    }

    static FormPage FormDef() {
        return FormPage.Of("/admin/wms/skus/save")
            .Text("SKU 编码", "sku").Req().Ph("例如：SKU-0001")
            .Text("商品名称", "name").Req().Ph("请输入商品名称")
            .Text("计量单位", "unit").Ph("例如：件、箱、台")
            .Text("规格说明", "spec").Ph("例如：10cm x 20cm");
    }

    [HttpGet]
    [Route("/admin/wms/skus")]
    [Custom(IsMenu = true, Icon = "mdi:barcode", Perm = PermBit.View)]
    [Description("商品管理")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("商品表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Skus.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("商品列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        ListQuery q = this.PagedAny("id", 20);
        string kw = q.Kw();
        List<WmsSku> rows = await this.WmsSku
            .Where(a => a.tenantId == Tenant.Cur())
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw) || a.sku.Contains(kw))
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.WmsSku
            .Where(a => a.tenantId == Tenant.Cur())
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw) || a.sku.Contains(kw))
            .CountAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            WmsSku s = rows[i];
            w.WriteStartObject();
            w.WriteProperty("id", s.id);
            w.WriteProperty("sku", s.sku);
            w.WriteProperty("name", s.name);
            w.WriteProperty("unit", Fmt.Dash(s.unit));
            w.WriteProperty("spec", Fmt.Dash(s.spec));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("商品表单配置")]
    public void FormConf() {
        CrudOps.FormConf(this, Skus.FormDef(), "商品");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("商品编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        WmsSku s = await this.WmsSku
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (s == null) { this.Fail(404, "0404", "商品不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", s.id);
        w.WriteProperty("sku", s.sku);
        w.WriteProperty("name", s.name);
        w.WriteProperty("unit", s.unit);
        w.WriteProperty("spec", s.spec);
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存商品")]
    async void Save() {
        int id = this.InAnyInt("id", 0);
        string sku = this.NeedAny("sku", "SKU 编码");
        string name = this.NeedAny("name", "商品名称");
        string unit = this.InAny("unit");
        string spec = this.InAny("spec");
        if (id > 0) {
            int n = await this.WmsSku.Update()
                .Set(a => a.sku, sku)
                .Set(a => a.name, name)
                .Set(a => a.unit, unit)
                .Set(a => a.spec, spec)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id && a.tenantId == Tenant.Cur())
                .ExecuteAffrowsAsync();
            await this.Note("编辑商品", "#" + Convert.ToString(id) + " " + name, n > 0, "");
            this.Saved("商品已保存");
            return;
        }
        WmsSku s = new WmsSku();
        s.tenantId = Tenant.Cur();
        s.sku = sku;
        s.name = name;
        s.unit = unit;
        s.spec = spec;
        s.createdAt = WebApp.NowSeconds();
        s.updatedAt = s.createdAt;
        int newId = await this.WmsSku.Insert(s).ExecuteIdentityAsync();
        await this.Note("新增商品", "#" + Convert.ToString(newId) + " " + name, newId > 0, "");
        this.Saved("商品已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除商品")]
    async void Delete() {
        int id = this.InAnyInt("id", 0);
        WmsSku s = await this.WmsSku
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (s == null) { this.Fail(404, "0404", "商品不存在"); return; }
        int n = await this.WmsSku.Delete()
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        await this.Note("删除商品", "#" + Convert.ToString(id) + " " + s.name, n > 0, "");
        this.Saved("商品已删除");
    }

    /* ---- T7 导入导出（ExcelIo 公共层）----------------------------------- */

    private static List<string> Headers() {
        List<string> h = new List<string>();
        h.Add("SKU编码"); h.Add("商品名称"); h.Add("单位"); h.Add("规格");
        return h;
    }

    private static List<FieldRule> Rules() {
        List<FieldRule> r = new List<FieldRule>();
        r.Add(FieldRule.Text("SKU编码", true, 64));
        r.Add(FieldRule.Text("商品名称", true, 128));
        r.Add(FieldRule.Text("单位", false, 32));
        r.Add(FieldRule.Text("规格", false, 256));
        return r;
    }

    static string SaveRow(IDbConnection db, int tenantId, SysUser me,
                          ImportRecord rec) {
        string sku = ExcelIo.Rec(rec, "SKU编码");
        int dup = new WmsSkuDao(db).CountBySkuSync(tenantId, sku);
        if (dup > 0) { return "SKU编码=SKU 已存在：" + sku; }
        WmsSku s = new WmsSku();
        s.tenantId = tenantId;
        s.sku = sku;
        s.name = ExcelIo.Rec(rec, "商品名称");
        s.unit = ExcelIo.Rec(rec, "单位");
        s.spec = ExcelIo.Rec(rec, "规格");
        s.createdAt = WebApp.NowSeconds();
        s.updatedAt = s.createdAt;
        new WmsSkuDao(db).InsertSync(s);
        return null;
    }

    [HttpGet]
    [Custom(Perm = PermBit.Export)]
    [Description("导出商品")]
    async void Export() {
        bool xlsx = this.InAnyInt("xlsx", 0) == 1;
        List<WmsSku> rows = await this.WmsSku
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<List<string>> data = new List<List<string>>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            WmsSku s = rows[i];
            List<string> r = new List<string>();
            r.Add(s.sku); r.Add(s.name); r.Add(s.unit); r.Add(s.spec);
            data.Add(r);
        }
        await ExcelIo.Download(this.Ctx(), "商品", Skus.Headers(), data, xlsx);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create)]
    [Description("商品导入模板")]
    async void Template() {
        List<string> sample = new List<string>();
        sample.Add("SKU-0001"); sample.Add("示例商品"); sample.Add("件");
        sample.Add("10cm x 20cm");
        await ExcelIo.Template(this.Ctx(), "商品导入", Skus.Headers(), sample);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create, ApiMax = 30, Upload = true)]
    [Description("导入商品")]
    async void Import() {
        SysUser me = await this.Admin();
        if (this.ctx.UploadPath().Length == 0) {
            this.Fail(400, "1002", "没有上传内容");
            return;
        }
        string text = File.ReadAllText(this.ctx.UploadPath());
        int batchId = await ExcelIo.Import(this.Held(), Tenant.Cur(),
            me, "wms_sku", "upload.csv", Skus.Headers(),
            Skus.Rules(), Csv.Parse(text), Skus.SaveRow);
        await this.Note("导入商品", "批次#" + Convert.ToString(batchId),
            true, "");
        this.Ok(await ExcelIo.BatchReport(this.Held(), Tenant.Cur(),
            batchId));
    }
}
