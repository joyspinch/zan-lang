using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Sys;
using ZanWeb.Model.Wms;

namespace ZanWeb.Admin.Wms;

/* /admin/wms/skus 商品(SKU)主数据：搜索、建、编、删。库存数量不在此表，由流水汇总到 wms_inventory。 */
[Route("admin/wms/skus/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("商品管理")]
class Skus : AdminController {
    [HttpGet]
    [Route("/admin/wms/skus")]
    [Custom(IsMenu = true, Icon = "mdi:barcode", Perm = PermBit.View)]
    [Description("商品管理")]
    async void Index() {
        ViewData d = await this.Layout("商品管理");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }

        ListQuery q = this.Paged("id", 20);
        string kw = q.Kw();
        List<WmsSku> rows = await this.WmsSku
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw) || a.sku.Contains(kw))
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.WmsSku
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw) || a.sku.Contains(kw))
            .CountAsync();

        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            WmsSku s = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(s.id));
            row.Set("sku", s.sku);
            row.Set("name", s.name);
            row.Set("unit", Fmt.Dash(s.unit));
            row.Set("spec", Fmt.Dash(s.spec));
            items.Add(row);
        }
        this.Pager(d, q, total);
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("商品表单")]
    async void Form() {
        int id = this.InInt("id", 0);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("dialogTitle", "新增商品");
        d.Set("new", "1");
        if (id > 0) {
            WmsSku s = await this.WmsSku.Where(a => a.id == id).FirstAsync();
            if (s == null) { this.Fail(404, "0404", "商品不存在"); }
            d.Set("dialogTitle", "编辑商品");
            d.Set("sku", s.sku);
            d.Set("name", s.name);
            d.Set("unit", s.unit);
            d.Set("spec", s.spec);
            d.Set("edit", "1");
            d.Set("new", "");
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存商品")]
    async void Save() {
        int id = this.InInt("id", 0);
        string sku = this.Need("sku", "SKU 编码");
        string name = this.Need("name", "商品名称");
        string unit = this.In("unit");
        string spec = this.In("spec");
        if (id > 0) {
            int n = await this.WmsSku.Update()
                .Set(a => a.sku, sku)
                .Set(a => a.name, name)
                .Set(a => a.unit, unit)
                .Set(a => a.spec, spec)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            await this.Note("编辑商品", "#" + Convert.ToString(id) + " " + name, n > 0, "");
            this.Saved("商品已保存");
            return;
        }
        WmsSku s = new WmsSku();
        s.sku = sku;
        s.name = name;
        s.unit = unit;
        s.spec = spec;
        s.createdAt = WebApp.NowSeconds();
        s.updatedAt = s.createdAt;
        int newId = await this.WmsSku.Insert(s).ExecuteIdentityAsync();
        await this.Note("新增商品", "#" + Convert.ToString(newId) + " " + name, newId > 0, "");
        this.Saved("商品已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除商品")]
    async void Delete() {
        int id = this.InInt("id", 0);
        WmsSku s = await this.WmsSku.Where(a => a.id == id).FirstAsync();
        if (s == null) { this.Fail(404, "0404", "商品不存在"); }
        int n = await this.WmsSku.Delete().Where(a => a.id == id).ExecuteAffrowsAsync();
        await this.Note("删除商品", "#" + Convert.ToString(id) + " " + s.name, n > 0, "");
        this.Saved("商品已删除");
    }

    /* ---- T7 导入导出（ExcelIo 公共层）----------------------------------- */

    static List<string> Headers() {
        List<string> h = new List<string>();
        h.Add("SKU编码"); h.Add("商品名称"); h.Add("单位"); h.Add("规格");
        return h;
    }

    static List<FieldRule> Rules() {
        List<FieldRule> r = new List<FieldRule>();
        r.Add(FieldRule.Text("SKU编码", true, 64));
        r.Add(FieldRule.Text("商品名称", true, 128));
        r.Add(FieldRule.Text("单位", false, 32));
        r.Add(FieldRule.Text("规格", false, 256));
        return r;
    }

    /* ImportRow 处理器：同步 + 平行 List（ExcelIo.ImportRow 双重约定）。 */
    static string SaveRow(IDbConnection db, int tenantId, User me,
                          List<string> keys, List<string> vals) {
        string sku = ExcelIo.Rec(keys, vals, "SKU编码");
        int dup = db.Select<WmsSku>()
            .Where(a => a.sku == sku).Count();
        if (dup > 0) { return "SKU编码=SKU 已存在：" + sku; }
        WmsSku s = new WmsSku();
        s.sku = sku;
        s.name = ExcelIo.Rec(keys, vals, "商品名称");
        s.unit = ExcelIo.Rec(keys, vals, "单位");
        s.spec = ExcelIo.Rec(keys, vals, "规格");
        s.createdAt = WebApp.NowSeconds();
        s.updatedAt = s.createdAt;
        db.Insert<WmsSku>(s).ExecuteAffrows();
        return null;
    }

    [HttpGet]
    [Custom(Perm = PermBit.Export)]
    [Description("导出商品")]
    async void Export() {
        bool xlsx = this.InInt("xlsx", 0) == 1;
        List<WmsSku> rows = await this.WmsSku
            .OrderBy(a => a.id).ToListAsync();
        List<List<string>> data = new List<List<string>>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            WmsSku s = rows[i];
            List<string> r = new List<string>();
            r.Add(s.sku); r.Add(s.name); r.Add(s.unit); r.Add(s.spec);
            data.Add(r);
        }
        await ExcelIo.Download(this.Ctx(), "商品", Skus.Headers(), data, xlsx);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create)]
    [Description("商品导入模板")]
    async void Template() {
        List<string> sample = new List<string>();
        sample.Add("SKU-0001"); sample.Add("示例商品"); sample.Add("件");
        sample.Add("10cm x 20cm");
        await ExcelIo.Template(this.Ctx(), "商品导入", Skus.Headers(), sample);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create, ApiMax = 30, Upload = true)]
    [Description("导入商品")]
    async void Import() {
        User me = await this.Admin();
        if (this.ctx.uploadPath.Length == 0) {
            this.Fail(400, "1002", "没有上传内容");
        }
        string text = File.ReadAllText(this.ctx.uploadPath);
        int batchId = await ExcelIo.Import(this.Held(), this.TenantId(),
            me, "wms_sku", "upload.csv", Skus.Headers(),
            Skus.Rules(), Csv.Parse(text), Skus.SaveRow);
        await this.Note("导入商品", "批次#" + Convert.ToString(batchId),
            true, "");
        this.Ok(await ExcelIo.BatchReport(this.Held(), this.TenantId(),
            batchId));
    }
}
