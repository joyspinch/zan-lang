using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Wms;

namespace ZanWeb.Dao.Wms;

/* WmsInventory 强类型数据访问网关（FreeSql 风格） */
class WmsInventoryDao : BaseRepository<WmsInventory> {
    WmsInventoryDao(IFreeSql fsql) : base(fsql) {}
    WmsInventoryDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async WmsInventory ById(int id) {
        return await this.GetExecutor().Select<WmsInventory>().Where(a => a.id == id).FirstAsync();
    }

    async List<WmsInventory> All() {
        return await this.GetExecutor().Select<WmsInventory>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<WmsInventory>().CountAsync();
    }

    async int Insert(WmsInventory entity) {
        return await this.GetExecutor().Insert<WmsInventory>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<WmsInventory>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    /* 低库存行（余量升序）：不高于运营补货阈值 threshold 的库存行。
       阈值来自全局设置 wms.reorder.qty（调用方读出传入），<=0 视为
       未启用提醒，直接空表返回。 */
    async List<WmsInventory> LowStockByTenant(int tenantId, long threshold) {
        if (threshold <= 0) { return new List<WmsInventory>(); }
        return await this.GetExecutor().Select<WmsInventory>()
            .Where(a => a.tenantId == tenantId && a.qty <= threshold)
            .OrderBy(a => a.qty)
            .ToListAsync();
    }
}
