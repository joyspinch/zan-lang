using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Wms;

namespace Zan.Web.Dao.Wms;

/* WmsSku 强类型数据访问网关（ZanSql 风格） */
public class WmsSkuDao : BaseRepository<WmsSku> {
    public WmsSkuDao() : base() {}
    public WmsSkuDao(IZanSql fsql) : base(fsql) {}
    public WmsSkuDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async WmsSku ById(int id) {
        return await this.GetExecutor().Select<WmsSku>().Where(a => a.id == id).FirstAsync();
    }

    public async List<WmsSku> All() {
        return await this.GetExecutor().Select<WmsSku>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<WmsSku>().CountAsync();
    }

    public InsertQuery<WmsSku> Insert(WmsSku entity) {
        return this.GetExecutor().Insert<WmsSku>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<WmsSku>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async List<WmsSku> ByTenant(int tenantId) {
        return await this.GetExecutor().Select<WmsSku>()
            .Where(a => a.tenantId == tenantId)
            .ToListAsync();
    }

    public async List<WmsSku> Search(int tenantId, string kw, int limit) {
        return await this.GetExecutor().Select<WmsSku>()
            .Where(a => a.tenantId == tenantId
                && (a.sku.Contains(kw) || a.name.Contains(kw)))
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }

    public async int CountBySku(int tenantId, string sku) {
        return await this.GetExecutor().Select<WmsSku>()
            .Where(a => a.sku == sku && a.tenantId == tenantId)
            .CountAsync();
    }

    /* 兼容行导入或后台场景的同步版本 */
    public int CountBySkuSync(int tenantId, string sku) {
        return this.GetExecutor().Select<WmsSku>()
            .Where(a => a.sku == sku && a.tenantId == tenantId)
            .Count();
    }

    public int InsertSync(WmsSku entity) {
        return this.GetExecutor().Insert<WmsSku>(entity).ExecuteAffrows();
    }
}
