using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Wms;

namespace ZanWeb.Dao.Wms;

/* WmsSku 强类型数据访问网关（FreeSql 风格） */
class WmsSkuDao {
    IDbConnection db;

    WmsSkuDao(IDbConnection db) {
        this.db = db;
    }

    async WmsSku ById(int id) {
        return await this.db.Select<WmsSku>().Where(a => a.id == id).FirstAsync();
    }

    async List<WmsSku> All() {
        return await this.db.Select<WmsSku>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<WmsSku>().CountAsync();
    }

    async int Insert(WmsSku entity) {
        return await this.db.Insert<WmsSku>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<WmsSku>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async List<WmsSku> ByTenant(int tenantId) {
        return await this.db.Select<WmsSku>()
            .Where(a => a.tenantId == tenantId)
            .ToListAsync();
    }

    async List<WmsSku> Search(int tenantId, string kw, int limit) {
        return await this.db.Select<WmsSku>()
            .Where(a => a.tenantId == tenantId
                && (a.sku.Contains(kw) || a.name.Contains(kw)))
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }

    async int CountBySku(int tenantId, string sku) {
        return await this.db.Select<WmsSku>()
            .Where(a => a.sku == sku && a.tenantId == tenantId)
            .CountAsync();
    }

    /* 兼容行导入或后台场景的同步版本 */
    int CountBySkuSync(int tenantId, string sku) {
        return this.db.Select<WmsSku>()
            .Where(a => a.sku == sku && a.tenantId == tenantId)
            .Count();
    }

    int InsertSync(WmsSku entity) {
        return this.db.Insert<WmsSku>(entity).ExecuteAffrows();
    }
}
