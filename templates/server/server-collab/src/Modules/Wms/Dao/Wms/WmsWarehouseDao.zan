using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Wms;

namespace ZanWeb.Dao.Wms;

/* WmsWarehouse 强类型数据访问网关（FreeSql 风格） */
class WmsWarehouseDao : BaseRepository<WmsWarehouse> {
    WmsWarehouseDao(IFreeSql fsql) : base(fsql) {}
    WmsWarehouseDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async WmsWarehouse ById(int id) {
        return await this.GetExecutor().Select<WmsWarehouse>().Where(a => a.id == id).FirstAsync();
    }

    async List<WmsWarehouse> All() {
        return await this.GetExecutor().Select<WmsWarehouse>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<WmsWarehouse>().CountAsync();
    }

    async int Insert(WmsWarehouse entity) {
        return await this.GetExecutor().Insert<WmsWarehouse>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<WmsWarehouse>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async List<WmsWarehouse> Search(int tenantId, string kw, int limit) {
        return await this.GetExecutor().Select<WmsWarehouse>()
            .Where(a => a.tenantId == tenantId
                && (a.name.Contains(kw) || a.code.Contains(kw)))
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }
}
