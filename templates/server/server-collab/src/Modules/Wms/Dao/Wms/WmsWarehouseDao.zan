using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Wms;

namespace Zan.Web.Dao.Wms;

/* WmsWarehouse 强类型数据访问网关（ZanSql 风格） */
public class WmsWarehouseDao : BaseRepository<WmsWarehouse> {
    public WmsWarehouseDao() : base() {}
    public WmsWarehouseDao(IZanSql fsql) : base(fsql) {}
    public WmsWarehouseDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async WmsWarehouse ById(int id) {
        return await this.GetExecutor().Select<WmsWarehouse>().Where(a => a.id == id).FirstAsync();
    }

    public async List<WmsWarehouse> All() {
        return await this.GetExecutor().Select<WmsWarehouse>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<WmsWarehouse>().CountAsync();
    }

    public InsertQuery<WmsWarehouse> Insert(WmsWarehouse entity) {
        return this.GetExecutor().Insert<WmsWarehouse>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<WmsWarehouse>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async List<WmsWarehouse> Search(int tenantId, string kw, int limit) {
        return await this.GetExecutor().Select<WmsWarehouse>()
            .Where(a => a.tenantId == tenantId
                && (a.name.Contains(kw) || a.code.Contains(kw)))
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }
}
