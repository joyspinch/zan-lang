using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Wms;

namespace Zan.Web.Dao.Wms;

/* WmsStockIn 强类型数据访问网关（ZanSql 风格） */
public class WmsStockInDao : BaseRepository<WmsStockIn> {
    public WmsStockInDao() : base() {}
    public WmsStockInDao(IZanSql fsql) : base(fsql) {}
    public WmsStockInDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async WmsStockIn ById(int id) {
        return await this.GetExecutor().Select<WmsStockIn>().Where(a => a.id == id).FirstAsync();
    }

    public async List<WmsStockIn> All() {
        return await this.GetExecutor().Select<WmsStockIn>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<WmsStockIn>().CountAsync();
    }

    public InsertQuery<WmsStockIn> Insert(WmsStockIn entity) {
        return this.GetExecutor().Insert<WmsStockIn>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<WmsStockIn>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
