using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Wms;

namespace ZanWeb.Dao.Wms;

/* WmsStockIn 强类型数据访问网关（FreeSql 风格） */
class WmsStockInDao {
    IDbConnection db;

    WmsStockInDao(IDbConnection db) {
        this.db = db;
    }

    async WmsStockIn ById(int id) {
        return await this.db.Select<WmsStockIn>().Where(a => a.id == id).FirstAsync();
    }

    async List<WmsStockIn> All() {
        return await this.db.Select<WmsStockIn>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<WmsStockIn>().CountAsync();
    }

    async int Insert(WmsStockIn entity) {
        return await this.db.Insert<WmsStockIn>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<WmsStockIn>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
