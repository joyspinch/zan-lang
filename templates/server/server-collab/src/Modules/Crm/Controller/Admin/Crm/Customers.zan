using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Crm;

namespace ZanWeb.Admin.Crm;

/* /admin/crm/customers 客户管理：搜索、建、编、删。 */
[Route("admin/crm/customers/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("客户管理")]
class Customers : AdminController {
    [HttpGet]
    [Route("/admin/crm/customers")]
    [Custom(IsMenu = true, Icon = "mdi:account-group", Perm = PermBit.View)]
    [Description("客户管理")]
    async void Index() {
        ViewData d = await this.Layout("客户管理");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }

        ListQuery q = this.Paged("id", 20);
        string kw = q.Kw();
        /* 租户硬边（#34）：列表只出本租户行。 */
        List<CrmCustomer> rows = await this.CrmCustomer
            .Where(a => a.tenantId == this.TenantId())
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.CrmCustomer
            .Where(a => a.tenantId == this.TenantId())
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw))
            .CountAsync();

        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            CrmCustomer c = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(c.id));
            row.Set("name", c.name);
            row.Set("contact", Fmt.Dash(c.contact));
            row.Set("phone", Fmt.Dash(c.phone));
            row.Set("levelText", Customers.LevelText(c.level));
            items.Add(row);
        }
        this.Pager(d, q, total);
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("客户表单")]
    async void Form() {
        int id = this.InInt("id", 0);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("dialogTitle", "新增客户");
        d.Set("new", "1");
        d.Set("level2", "selected");
        if (id > 0) {
            CrmCustomer c = await this.CrmCustomer
                .Where(a => a.id == id && a.tenantId == this.TenantId())
                .FirstAsync();
            if (c == null) { this.Fail(404, "0404", "客户不存在"); }
            d.Set("dialogTitle", "编辑客户");
            d.Set("name", c.name);
            d.Set("contact", c.contact);
            d.Set("phone", c.phone);
            d.Set("remark", c.remark);
            d.Set("edit", "1");
            d.Set("new", "");
            d.Set("level1", "");
            d.Set("level2", "");
            d.Set("level3", "");
            if (c.level == 1) { d.Set("level1", "selected"); }
            else if (c.level == 3) { d.Set("level3", "selected"); }
            else { d.Set("level2", "selected"); }
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存客户")]
    async void Save() {
        int id = this.InInt("id", 0);
        string name = this.Need("name", "客户名称");
        string contact = this.In("contact");
        string phone = this.In("phone");
        int level = this.InInt("level", 2);
        string remark = this.In("remark");

        if (id > 0) {
            int n = await this.CrmCustomer.Update()
                .Set(a => a.name, name)
                .Set(a => a.contact, contact)
                .Set(a => a.phone, phone)
                .Set(a => a.level, level)
                .Set(a => a.remark, remark)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id && a.tenantId == this.TenantId())
                .ExecuteAffrowsAsync();
            await this.Note("编辑客户", "#" + Convert.ToString(id) + " " + name, n > 0, "");
            this.Saved("客户已保存");
            return;
        }
        CrmCustomer c = new CrmCustomer();
        c.tenantId = this.TenantId();
        c.name = name;
        c.contact = contact;
        c.phone = phone;
        c.level = level;
        c.remark = remark;
        c.createdAt = WebApp.NowSeconds();
        c.updatedAt = c.createdAt;
        int newId = await this.CrmCustomer.Insert(c).ExecuteIdentityAsync();
        await this.Note("新增客户", "#" + Convert.ToString(newId) + " " + name, newId > 0, "");
        this.Saved("客户已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除客户")]
    async void Delete() {
        int id = this.InInt("id", 0);
        CrmCustomer c = await this.CrmCustomer
            .Where(a => a.id == id && a.tenantId == this.TenantId())
            .FirstAsync();
        if (c == null) { this.Fail(404, "0404", "客户不存在"); }
        int n = await this.CrmCustomer.Delete()
            .Where(a => a.id == id && a.tenantId == this.TenantId())
            .ExecuteAffrowsAsync();
        await this.Note("删除客户", "#" + Convert.ToString(id) + " " + c.name, n > 0, "");
        this.Saved("客户已删除");
    }

    static string LevelText(int level) {
        if (level == 1) { return "重要"; }
        if (level == 3) { return "潜在"; }
        return "普通";
    }

    /* ---- T7 导入导出（ExcelIo 公共层，验收 §2.6）------------------------ */

    static List<string> Headers() {
        List<string> h = new List<string>();
        h.Add("名称"); h.Add("联系人"); h.Add("电话");
        h.Add("等级"); h.Add("备注");
        return h;
    }

    static List<FieldRule> Rules() {
        List<FieldRule> r = new List<FieldRule>();
        r.Add(FieldRule.Text("名称", true, 128));
        r.Add(FieldRule.Text("联系人", false, 64));
        r.Add(FieldRule.Text("电话", false, 32));
        r.Add(FieldRule.Text("等级", false, 0));
        r.Add(FieldRule.Text("备注", false, 256));
        return r;
    }

    static int LevelOf(string text) {
        if (text == "重要") { return 1; }
        if (text == "潜在") { return 3; }
        return 2;
    }

    /* ImportRow 处理器：同步函数 + 平行 List 行数据（双重约定见
       ExcelIo.ImportRow 注记）；同步 ORM 终端 Count/ExecuteAffrows。 */
    static string SaveRow(IDbConnection db, int tenantId, User me,
                          List<string> keys, List<string> vals) {
        string name = ExcelIo.Rec(keys, vals, "名称");
        int dup = db.Select<CrmCustomer>()
            .Where(a => a.name == name && a.tenantId == tenantId).Count();
        if (dup > 0) { return "名称=客户已存在：" + name; }
        CrmCustomer c = new CrmCustomer();
        c.tenantId = tenantId;
        c.name = name;
        c.contact = ExcelIo.Rec(keys, vals, "联系人");
        c.phone = ExcelIo.Rec(keys, vals, "电话");
        c.level = Customers.LevelOf(ExcelIo.Rec(keys, vals, "等级"));
        c.remark = ExcelIo.Rec(keys, vals, "备注");
        c.ownerId = me.id;
        c.createdAt = WebApp.NowSeconds();
        c.updatedAt = c.createdAt;
        db.Insert<CrmCustomer>(c).ExecuteAffrows();
        return null;
    }

    [HttpGet]
    [Custom(Perm = PermBit.Export)]
    [Description("导出客户")]
    async void Export() {
        bool xlsx = this.InInt("xlsx", 0) == 1;
        List<CrmCustomer> rows = await this.CrmCustomer
            .Where(a => a.tenantId == this.TenantId())
            .OrderBy(a => a.id).ToListAsync();
        List<List<string>> data = new List<List<string>>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            CrmCustomer c = rows[i];
            List<string> r = new List<string>();
            r.Add(c.name); r.Add(c.contact); r.Add(c.phone);
            r.Add(Customers.LevelText(c.level)); r.Add(c.remark);
            data.Add(r);
        }
        await ExcelIo.Download(this.Ctx(), "客户", Customers.Headers(),
            data, xlsx);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create)]
    [Description("客户导入模板")]
    async void Template() {
        List<string> sample = new List<string>();
        sample.Add("示例客户"); sample.Add("张三"); sample.Add("13800000000");
        sample.Add("普通"); sample.Add("备注文字");
        await ExcelIo.Template(this.Ctx(), "客户导入", Customers.Headers(),
            sample);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create, ApiMax = 30, Upload = true)]
    [Description("导入客户")]
    async void Import() {
        User me = await this.Admin();
        if (this.ctx.uploadPath.Length == 0) {
            this.Fail(400, "1002", "没有上传内容");
        }
        string text = File.ReadAllText(this.ctx.uploadPath);
        int batchId = await ExcelIo.Import(this.Held(), this.TenantId(),
            me, "crm_customer", "upload.csv", Customers.Headers(),
            Customers.Rules(), Csv.Parse(text), Customers.SaveRow);
        await this.Note("导入客户", "批次#" + Convert.ToString(batchId),
            true, "");
        this.Ok(await ExcelIo.BatchReport(this.Held(), this.TenantId(),
            batchId));
    }
}
