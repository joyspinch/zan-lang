using System;
using Formats.Csv;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web;
using Zan.Web.AdminUi;
using Zan.Web.Dao.Crm;
using Zan.Web.Model.Crm;

namespace Zan.Web.Admin.Crm;

/* /admin/crm/customers 客户管理：搜索、建、编、删、导入导出。 */
[Route("admin/crm/customers/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("客户管理")]
public class Customers : AdminController {
    public CrmCustomerDao CrmCustomer { get { return new CrmCustomerDao(this.Held()); } }

    static ListPage ScreenDef() {
        return ListPage.Of()
            .Text("客户名称", "kw", "name", "按客户名称搜索")
            .TbarAdd("新增客户", "/admin/crm/customers/form")
            .TbarDownload("导出 Excel", "/admin/crm/customers/export?xlsx=1")
            .TbarDownload("下载模板", "/admin/crm/customers/template")
            .Col("id", "ID", "num", "75")
            .Col("name", "客户名称", "text", "200")
            .Col("contact", "联系人", "text", "120")
            .Col("phone", "电话", "text", "140")
            .Tag("level", "客户等级", "1=重要|ok,2=普通|warn,3=潜在|off", "100")
            .Col("remark", "备注", "text", "200")
            .OpsEdit("/admin/crm/customers/form")
            .OpsDel("/admin/crm/customers/delete", "确认删除该客户吗？");
    }

    static FormPage FormDef() {
        return FormPage.Of("/admin/crm/customers/save")
            .Text("客户名称", "name").Req().Ph("请输入客户名称")
            .Text("联系人", "contact").Ph("主联系人姓名")
            .Text("电话", "phone").Ph("联系电话")
            .Select("客户等级", "level", "1=重要,2=普通,3=潜在").Val("2")
            .Area("备注", "remark").Span().Ph("客户说明或跟进备注");
    }

    [HttpGet]
    [Route("/admin/crm/customers")]
    [Custom(IsMenu = true, Icon = "mdi:account-group", Perm = PermBit.View)]
    [Description("客户管理")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("客户表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Customers.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("客户列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        ListQuery q = this.PagedAny("id", 20);
        string kw = q.Kw();
        /* 租户硬边（#34）：列表与计数复用同一 SQL 条件。 */
        SelectQuery<CrmCustomer> query = this.CrmCustomer.Select()
            .WhereEq(nameof(Zan.Web.Model.Crm.CrmCustomer.tenantId), Tenant.Cur());
        Select sql = query.inner;
        if (kw.Length > 0) {
            string name = sql.RequireCol(nameof(Zan.Web.Model.Crm.CrmCustomer.name));
            int provider = sql.Provider();
            if (provider == DbProvider.MySQL || provider == DbProvider.MariaDB) {
                sql.Where("INSTR(CAST(CONVERT(" + name + " USING utf8mb4) AS BINARY), CAST(? AS BINARY)) > 0");
            } else if (provider == DbProvider.PostgreSQL) {
                sql.Where("strpos(" + name + " COLLATE \"C\", ?) > 0");
            } else {
                sql.Where("instr(" + name + ", ?) > 0");
            }
            sql.P(kw);
        }
        sql.OrderBySafeDesc(nameof(Zan.Web.Model.Crm.CrmCustomer.id));
        List<CrmCustomer> rows = await query.Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await query.CountAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            CrmCustomer c = rows[i];
            w.WriteStartObject();
            w.WriteProperty("id", c.id);
            w.WriteProperty("name", c.name);
            w.WriteProperty("contact", Fmt.Dash(c.contact));
            w.WriteProperty("phone", Fmt.Dash(c.phone));
            w.WriteProperty("level", Convert.ToString(c.level));
            w.WriteProperty("remark", Fmt.Dash(c.remark));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("客户表单配置")]
    public void FormConf() {
        CrudOps.FormConf(this, Customers.FormDef(), "客户");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("客户编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        CrmCustomer c = await this.CrmCustomer
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (c == null) { this.Fail(404, "0404", "客户不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", c.id);
        w.WriteProperty("name", c.name);
        w.WriteProperty("contact", c.contact);
        w.WriteProperty("phone", c.phone);
        w.WriteProperty("level", Convert.ToString(c.level));
        w.WriteProperty("remark", c.remark);
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存客户")]
    async void Save() {
        int id = this.InAnyInt("id", 0);
        string name = this.NeedAny("name", "客户名称");
        string contact = this.InAny("contact");
        string phone = this.InAny("phone");
        int level = this.InAnyInt("level", 2);
        string remark = this.InAny("remark");

        if (id > 0) {
            int n = await this.CrmCustomer.Update()
                .Set(a => a.name, name)
                .Set(a => a.contact, contact)
                .Set(a => a.phone, phone)
                .Set(a => a.level, level)
                .Set(a => a.remark, remark)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id && a.tenantId == Tenant.Cur())
                .ExecuteAffrowsAsync();
            await this.Note("编辑客户", "#" + Convert.ToString(id) + " " + name, n > 0, "");
            this.Saved("客户已保存");
            return;
        }
        CrmCustomer c = new CrmCustomer();
        c.tenantId = Tenant.Cur();
        c.name = name;
        c.contact = contact;
        c.phone = phone;
        c.level = level;
        c.remark = remark;
        c.createdAt = WebApp.NowSeconds();
        c.updatedAt = c.createdAt;
        int newId = await this.CrmCustomer.Insert(c).ExecuteIdentityAsync();
        await this.Note("新增客户", "#" + Convert.ToString(newId) + " " + name, newId > 0, "");
        this.Saved("客户已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除客户")]
    async void Delete() {
        int id = this.InAnyInt("id", 0);
        CrmCustomer c = await this.CrmCustomer
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (c == null) { this.Fail(404, "0404", "客户不存在"); return; }
        int n = await this.CrmCustomer.Delete()
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        await this.Note("删除客户", "#" + Convert.ToString(id) + " " + c.name, n > 0, "");
        this.Saved("客户已删除");
    }

    static string LevelText(int level) {
        if (level == 1) { return "重要"; }
        if (level == 3) { return "潜在"; }
        return "普通";
    }

    /* ---- T7 导入导出（ExcelIo 公共层，验收 §2.6）------------------------ */

    private static List<string> Headers() {
        List<string> h = new List<string>();
        h.Add("名称"); h.Add("联系人"); h.Add("电话");
        h.Add("等级"); h.Add("备注");
        return h;
    }

    private static List<FieldRule> Rules() {
        List<FieldRule> r = new List<FieldRule>();
        r.Add(FieldRule.Text("名称", true, 128));
        r.Add(FieldRule.Text("联系人", false, 64));
        r.Add(FieldRule.Text("电话", false, 32));
        r.Add(FieldRule.Text("等级", false, 0));
        r.Add(FieldRule.Text("备注", false, 256));
        return r;
    }

    static int LevelOf(string text) {
        if (text == "重要") { return 1; }
        if (text == "潜在") { return 3; }
        return 2;
    }

    static string SaveRow(IDbConnection db, int tenantId, SysUser me,
                          ImportRecord rec) {
        string name = ExcelIo.Rec(rec, "名称");
        int dup = new CrmCustomerDao(db).CountByNameSync(tenantId, name);
        if (dup > 0) { return "名称=客户已存在：" + name; }
        CrmCustomer c = new CrmCustomer();
        c.tenantId = tenantId;
        c.name = name;
        c.contact = ExcelIo.Rec(rec, "联系人");
        c.phone = ExcelIo.Rec(rec, "电话");
        c.level = Customers.LevelOf(ExcelIo.Rec(rec, "等级"));
        c.remark = ExcelIo.Rec(rec, "备注");
        c.ownerId = me.id;
        c.createdAt = WebApp.NowSeconds();
        c.updatedAt = c.createdAt;
        new CrmCustomerDao(db).InsertSync(c);
        return null;
    }

    [HttpGet]
    [Custom(Perm = PermBit.Export)]
    [Description("导出客户")]
    async void Export() {
        bool xlsx = this.InAnyInt("xlsx", 0) == 1;
        List<CrmCustomer> rows = await this.CrmCustomer
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<List<string>> data = new List<List<string>>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            CrmCustomer c = rows[i];
            List<string> r = new List<string>();
            r.Add(c.name); r.Add(c.contact); r.Add(c.phone);
            r.Add(Customers.LevelText(c.level)); r.Add(c.remark);
            data.Add(r);
        }
        await ExcelIo.Download(this.Ctx(), "客户", Customers.Headers(),
            data, xlsx);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create)]
    [Description("客户导入模板")]
    async void Template() {
        List<string> sample = new List<string>();
        sample.Add("示例客户"); sample.Add("张三"); sample.Add("13800000000");
        sample.Add("普通"); sample.Add("备注文字");
        await ExcelIo.Template(this.Ctx(), "客户导入", Customers.Headers(),
            sample);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create, ApiMax = 30, Upload = true)]
    [Description("导入客户")]
    async void Import() {
        SysUser me = await this.Admin();
        if (this.ctx.UploadPath().Length == 0) {
            this.Fail(400, "1002", "没有上传内容");
            return;
        }
        string text = File.ReadAllText(this.ctx.UploadPath());
        int batchId = await ExcelIo.Import(this.Held(), Tenant.Cur(),
            me, "crm_customer", "upload.csv", Customers.Headers(),
            Customers.Rules(), Csv.Parse(text), Customers.SaveRow);
        await this.Note("导入客户", "批次#" + Convert.ToString(batchId),
            true, "");
        this.Ok(await ExcelIo.BatchReport(this.Held(), Tenant.Cur(),
            batchId));
    }
}
