using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web;
using Zan.Web.AdminUi;
using Zan.Web.Model.Crm;
using Zan.Web.Dao.Crm;

namespace Zan.Web.Admin.Crm;

/* /admin/crm/opportunities 商机管理：列表、建、编、删、阶段推进、报表生成。 */
[Route("admin/crm/opportunities/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("商机管理")]
public class Opportunities : AdminController {
    public CrmOpportunityDao CrmOpportunity { get { return new CrmOpportunityDao(this.Held()); } }
    public CrmCustomerDao CrmCustomer { get { return new CrmCustomerDao(this.Held()); } }

    static ListPage ScreenDef() {
        return ListPage.Of()
            .Text("商机名称", "kw", "title", "搜索商机名称")
            .Select("阶段", "stage", "stage", "1=初步接触,2=需求确认,3=方案报价,4=谈判,5=赢单,0=输单")
            .TbarAdd("新增商机", "/admin/crm/opportunities/form")
            .TbarCustom("生成报表", "/admin/crm/opportunities/mailexport", "确认生成商机 Excel 报表吗？")
            .Col("id", "ID", "num", "75")
            .Col("title", "商机名称", "text", "200")
            .Col("customer", "所属客户", "text", "160")
            .Col("amount", "金额(分)", "num", "120")
            .Tag("stage", "当前阶段", "1=初步接触|warn,2=需求确认|warn,3=方案报价|warn,4=谈判|warn,5=赢单|ok,0=输单|off", "110")
            .OpsEdit("/admin/crm/opportunities/form")
            .Ops("推进阶段", "/admin/crm/opportunities/stage", "确认将所选商机推进到下一阶段吗？", "id={id}&stage={nextStage}", "u")
            .OpsDel("/admin/crm/opportunities/delete", "确认删除该商机吗？");
    }

    [HttpGet]
    [Route("/admin/crm/opportunities")]
    [Custom(IsMenu = true, Icon = "mdi:target", Perm = PermBit.View)]
    [Description("商机管理")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("商机表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Opportunities.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("商机列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        ListQuery q = this.PagedAny("id", 20);
        string kw = q.Kw();
        string stageStr = this.InAny("stage");
        bool hasStage = stageStr.Length > 0 && stageStr != "-1";
        int stageVal = Filter.ToInt(stageStr, -1);

        /* 租户硬边（#34）：列表只出本租户行，外键解析的客户选项同链。 */
        List<CrmOpportunity> rows = await this.CrmOpportunity
            .Where(a => a.tenantId == Tenant.Cur())
            .WhereIf(kw.Length > 0, a => a.title.Contains(kw))
            .WhereIf(hasStage && stageVal >= 0, a => a.stage == stageVal)
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.CrmOpportunity
            .Where(a => a.tenantId == Tenant.Cur())
            .WhereIf(kw.Length > 0, a => a.title.Contains(kw))
            .WhereIf(hasStage && stageVal >= 0, a => a.stage == stageVal)
            .CountAsync();
        List<CrmCustomer> custs = await this.CrmCustomer
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            CrmOpportunity o = rows[i];
            w.WriteStartObject();
            w.WriteProperty("id", o.id);
            w.WriteProperty("customerId", Convert.ToString(o.customerId));
            w.WriteProperty("title", o.title);
            w.WriteProperty("customer", Opportunities.CustName(custs, o.customerId));
            w.WriteProperty("amount", o.amount);
            w.WriteProperty("stage", Convert.ToString(o.stage));
            w.WriteProperty("nextStage", Opportunities.NextStage(o.stage));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("商机表单配置")]
    public async void FormConf() {
        List<CrmCustomer> custs = await this.CrmCustomer
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<StrMap> copts = new List<StrMap>();
        for (int i = 0; i < custs.Count; i = i + 1) {
            StrMap opt = new StrMap();
            opt.Set("id", Convert.ToString(custs[i].id));
            opt.Set("name", custs[i].name);
            copts.Add(opt);
        }
        FormPage fp = FormPage.Of("/admin/crm/opportunities/save")
            .SelectList("所属客户", "customerId", copts).Req()
            .Text("商机名称", "title").Req().Ph("请输入商机名称")
            .Num("预计金额(分)", "amount").Val("0")
            .Select("商机阶段", "stage", "1=初步接触,2=需求确认,3=方案报价,4=谈判,5=赢单,0=输单").Val("1");
        CrudOps.FormConf(this, fp, "商机");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("商机编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        CrmOpportunity o = await this.CrmOpportunity
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (o == null) { this.Fail(404, "0404", "商机不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", o.id);
        w.WriteProperty("customerId", Convert.ToString(o.customerId));
        w.WriteProperty("title", o.title);
        w.WriteProperty("amount", o.amount);
        w.WriteProperty("stage", Convert.ToString(o.stage));
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存商机")]
    async void Save() {
        int id = this.InAnyInt("id", 0);
        int customerId = this.InAnyInt("customerId", 0);
        string title = this.NeedAny("title", "商机名称");
        long amount = this.InAnyLong("amount", 0);
        int stage = this.InAnyInt("stage", 1);
        if (customerId <= 0) { this.Fail(400, "0004", "请选择客户"); return; }

        if (id > 0) {
            int n = await this.CrmOpportunity.Update()
                .Set(a => a.customerId, customerId)
                .Set(a => a.title, title)
                .Set(a => a.amount, amount)
                .Set(a => a.stage, stage)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id && a.tenantId == Tenant.Cur())
                .ExecuteAffrowsAsync();
            await this.Note("编辑商机", "#" + Convert.ToString(id) + " " + title, n > 0, "");
            this.Saved("商机已保存");
            return;
        }
        CrmOpportunity o = new CrmOpportunity();
        o.tenantId = Tenant.Cur();
        o.customerId = customerId;
        o.title = title;
        o.amount = amount;
        o.stage = stage;
        o.createdAt = WebApp.NowSeconds();
        o.updatedAt = o.createdAt;
        int newId = await this.CrmOpportunity.Insert(o).ExecuteIdentityAsync();
        await this.Note("新增商机", "#" + Convert.ToString(newId) + " " + title, newId > 0, "");
        this.Saved("商机已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("推进商机阶段")]
    async void Stage() {
        int id = this.InAnyInt("id", 0);
        int stage = this.InAnyInt("stage", 1);
        CrmOpportunity o = await this.CrmOpportunity
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (o == null) { this.Fail(404, "0404", "商机不存在"); return; }
        int n = await this.CrmOpportunity.Update()
            .Set(a => a.stage, stage)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        await this.Note("推进商机", "#" + Convert.ToString(id) + " → " + Opportunities.StageText(stage), n > 0, "");
        this.Saved("已更新阶段：" + Opportunities.StageText(stage));
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除商机")]
    async void Delete() {
        int id = this.InAnyInt("id", 0);
        CrmOpportunity o = await this.CrmOpportunity
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (o == null) { this.Fail(404, "0404", "商机不存在"); return; }
        int n = await this.CrmOpportunity.Delete()
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        await this.Note("删除商机", "#" + Convert.ToString(id), n > 0, "");
        this.Saved("商机已删除");
    }

    static string CustName(List<CrmCustomer> list, int id) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i].id == id) { return list[i].name; }
        }
        return "—";
    }

    static string StageText(int stage) {
        if (stage == 1) { return "初步接触"; }
        if (stage == 2) { return "需求确认"; }
        if (stage == 3) { return "方案报价"; }
        if (stage == 4) { return "谈判"; }
        if (stage == 5) { return "赢单"; }
        return "输单";
    }

    static int NextStage(int stage) {
        if (stage >= 1 && stage < 5) { return stage + 1; }
        return stage;
    }

    [HttpPost]
    [Custom(Perm = PermBit.Export)]
    [Description("商机报表发邮箱")]
    async void MailExport() {
        string to = Fmt.Text(this.InAny("to"), "");
        List<CrmOpportunity> rows = await this.CrmOpportunity
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<CrmCustomer> custs = await this.CrmCustomer
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();

        List<string> headers = new List<string>();
        headers.Add("商机"); headers.Add("客户"); headers.Add("金额(分)");
        headers.Add("阶段");
        List<List<string>> data = new List<List<string>>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            CrmOpportunity o = rows[i];
            List<string> r = new List<string>();
            r.Add(o.title);
            r.Add(Opportunities.CustName(custs, o.customerId));
            r.Add(Convert.ToString(o.amount));
            r.Add(Opportunities.StageText(o.stage));
            data.Add(r);
        }
        List<List<string>> all = new List<List<string>>();
        all.Add(headers);
        for (int i = 0; i < data.Count; i = i + 1) { all.Add(data[i]); }

        string rel = "data/exports/商机-" + Convert.ToString(WebApp.NowSeconds())
            + ".xlsx";
        if (!Directory.Exists("data/exports")) {
            Directory.CreateDirectoryRecursive("data/exports");
        }
        File.WriteAllBytes(rel, XlsxBook.FromText(all, true).SaveToBytes());

        string mail = "离线闭环：报表已生成 " + rel;
        if (to.Length > 0) {
            if (!await Mailer.Ready()) {
                mail = "邮件服务未配置（离线闭环：报表已生成 " + rel + "）";
            } else {
                MailResult mr = await Mailer.Send(to, "商机报表",
                    "商机报表已生成：" + rel);
                mail = mr.Ok() ? "已发送至 " + to + "（报表：" + rel + "）"
                    : mr.Message();
            }
        }
        await this.Note("商机报表", mail, true, "");
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("file", rel);
        w.WriteProperty("mail", mail);
        w.WriteEndObject();
        this.Ok(w.ToJson());
    }
}
