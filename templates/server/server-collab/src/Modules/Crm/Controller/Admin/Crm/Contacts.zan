using System;
using Formats.Csv;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using Zan.Web;
using Zan.Web.AdminUi;
using Zan.Web.Dao.Crm;
using Zan.Web.Model.Crm;

namespace Zan.Web.Admin.Crm;

/* /admin/crm/contacts 联系人管理：列表(按客户名解析)、建、编、删、导入导出。 */
[Route("admin/crm/contacts/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("联系人")]
public class Contacts : AdminController {
    public CrmContactDao CrmContact { get { return new CrmContactDao(this.Held()); } }
    public CrmCustomerDao CrmCustomer { get { return new CrmCustomerDao(this.Held()); } }

    static ListPage ScreenDef() {
        return ListPage.Of()
            .Text("姓名 / 电话", "kw", "name|phone", "搜索联系人姓名或电话")
            .TbarAdd("新增联系人", "/admin/crm/contacts/form")
            .TbarDownload("导出 Excel", "/admin/crm/contacts/export?xlsx=1")
            .TbarDownload("下载模板", "/admin/crm/contacts/template")
            .Col("id", "ID", "num", "75")
            .Col("name", "姓名", "text", "140")
            .Col("customer", "所属客户", "text", "180")
            .Col("title", "职务", "text", "130")
            .Col("phone", "电话", "text", "140")
            .Col("email", "邮箱", "text", "180")
            .OpsEdit("/admin/crm/contacts/form")
            .OpsDel("/admin/crm/contacts/delete", "确认删除该联系人吗？");
    }

    [HttpGet]
    [Route("/admin/crm/contacts")]
    [Custom(IsMenu = true, Icon = "mdi:contacts", Perm = PermBit.View)]
    [Description("联系人")]
    void Index() {
        this.Conf();
    }

    [HttpPut]
    [Custom(Perm = PermBit.View)]
    [Description("联系人表格配置")]
    public void Conf() {
        CrudOps.Conf(this, Contacts.ScreenDef());
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("联系人列表数据")]
    public async void List() {
        if (!this.DataReady()) { return; }
        ListQuery q = this.PagedAny("id", 20);
        string kw = q.Kw();
        /* 租户硬边（#34）：列表只出本租户行，外键解析的客户选项同链。 */
        List<CrmContact> rows = await this.CrmContact
            .Where(a => a.tenantId == Tenant.Cur())
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw) || a.phone.Contains(kw))
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        int total = await this.CrmContact
            .Where(a => a.tenantId == Tenant.Cur())
            .WhereIf(kw.Length > 0, a => a.name.Contains(kw) || a.phone.Contains(kw))
            .CountAsync();
        List<CrmCustomer> custs = await this.CrmCustomer
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();

        JsonWriter w = new JsonWriter();
        w.WriteStartArray();
        for (int i = 0; i < rows.Count; i = i + 1) {
            CrmContact c = rows[i];
            w.WriteStartObject();
            w.WriteProperty("id", c.id);
            w.WriteProperty("customerId", Convert.ToString(c.customerId));
            w.WriteProperty("name", c.name);
            w.WriteProperty("title", Fmt.Dash(c.title));
            w.WriteProperty("phone", Fmt.Dash(c.phone));
            w.WriteProperty("email", Fmt.Dash(c.email));
            w.WriteProperty("customer", Contacts.CustName(custs, c.customerId));
            w.WriteEndObject();
        }
        w.WriteEndArray();
        AdminUiProtocol.WriteListData(this, total, w.ToString());
    }

    [HttpPut]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("联系人表单配置")]
    public async void FormConf() {
        List<CrmCustomer> custs = await this.CrmCustomer
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<StrMap> copts = new List<StrMap>();
        for (int i = 0; i < custs.Count; i = i + 1) {
            StrMap opt = new StrMap();
            opt.Set("id", Convert.ToString(custs[i].id));
            opt.Set("name", custs[i].name);
            copts.Add(opt);
        }
        FormPage fp = FormPage.Of("/admin/crm/contacts/save")
            .SelectList("所属客户", "customerId", copts).Req()
            .Text("联系人姓名", "name").Req().Ph("请输入联系人姓名")
            .Text("职务", "title").Ph("例如：采购经理")
            .Text("电话", "phone").Ph("联系电话")
            .Text("邮箱", "email").Ph("电子邮箱");
        CrudOps.FormConf(this, fp, "联系人");
    }

    [HttpPost]
    [Custom(Perm = PermBit.View)]
    [Description("联系人编辑回显")]
    public async void Edit() {
        int id = this.InAnyInt("id", 0);
        CrmContact c = await this.CrmContact
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (c == null) { this.Fail(404, "0404", "联系人不存在"); return; }
        JsonWriter w = new JsonWriter();
        w.WriteStartObject();
        w.WriteProperty("id", c.id);
        w.WriteProperty("customerId", Convert.ToString(c.customerId));
        w.WriteProperty("name", c.name);
        w.WriteProperty("title", c.title);
        w.WriteProperty("phone", c.phone);
        w.WriteProperty("email", c.email);
        w.WriteEndObject();
        AdminUiProtocol.Ok(this, w.ToString());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存联系人")]
    async void Save() {
        int id = this.InAnyInt("id", 0);
        int customerId = this.InAnyInt("customerId", 0);
        string name = this.NeedAny("name", "联系人姓名");
        string title = this.InAny("title");
        string phone = this.InAny("phone");
        string email = this.InAny("email");
        if (customerId <= 0) { this.Fail(400, "0004", "请选择所属客户"); return; }

        if (id > 0) {
            int n = await this.CrmContact.Update()
                .Set(a => a.customerId, customerId)
                .Set(a => a.name, name)
                .Set(a => a.title, title)
                .Set(a => a.phone, phone)
                .Set(a => a.email, email)
                .Where(a => a.id == id && a.tenantId == Tenant.Cur())
                .ExecuteAffrowsAsync();
            await this.Note("编辑联系人", "#" + Convert.ToString(id) + " " + name, n > 0, "");
            this.Saved("联系人已保存");
            return;
        }
        CrmContact c = new CrmContact();
        c.tenantId = Tenant.Cur();
        c.customerId = customerId;
        c.name = name;
        c.title = title;
        c.phone = phone;
        c.email = email;
        c.createdAt = WebApp.NowSeconds();
        int newId = await this.CrmContact.Insert(c).ExecuteIdentityAsync();
        await this.Note("新增联系人", "#" + Convert.ToString(newId) + " " + name, newId > 0, "");
        this.Saved("联系人已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除联系人")]
    async void Delete() {
        int id = this.InAnyInt("id", 0);
        CrmContact c = await this.CrmContact
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .FirstAsync();
        if (c == null) { this.Fail(404, "0404", "联系人不存在"); return; }
        int n = await this.CrmContact.Delete()
            .Where(a => a.id == id && a.tenantId == Tenant.Cur())
            .ExecuteAffrowsAsync();
        await this.Note("删除联系人", "#" + Convert.ToString(id) + " " + c.name, n > 0, "");
        this.Saved("联系人已删除");
    }

    static string CustName(List<CrmCustomer> list, int id) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i].id == id) { return list[i].name; }
        }
        return "—";
    }

    /* ---- T7 导入导出（ExcelIo 公共层）----------------------------------- */

    private static List<string> Headers() {
        List<string> h = new List<string>();
        h.Add("客户"); h.Add("姓名"); h.Add("职务");
        h.Add("电话"); h.Add("邮箱");
        return h;
    }

    private static List<FieldRule> Rules() {
        List<FieldRule> r = new List<FieldRule>();
        r.Add(FieldRule.Text("客户", true, 128));
        r.Add(FieldRule.Text("姓名", true, 64));
        r.Add(FieldRule.Text("职务", false, 64));
        r.Add(FieldRule.Text("电话", false, 32));
        r.Add(FieldRule.Text("邮箱", false, 128));
        return r;
    }

    static string SaveRow(IDbConnection db, int tenantId, SysUser me,
                          ImportRecord rec) {
        string custName = ExcelIo.Rec(rec, "客户");
        CrmCustomer cust = new CrmCustomerDao(db).ByNameSync(tenantId, custName);
        if (cust == null) { return "客户=客户不存在：" + custName; }
        CrmContact c = new CrmContact();
        c.tenantId = tenantId;
        c.customerId = cust.id;
        c.name = ExcelIo.Rec(rec, "姓名");
        c.title = ExcelIo.Rec(rec, "职务");
        c.phone = ExcelIo.Rec(rec, "电话");
        c.email = ExcelIo.Rec(rec, "邮箱");
        c.createdAt = WebApp.NowSeconds();
        new CrmContactDao(db).InsertSync(c);
        return null;
    }

    [HttpGet]
    [Custom(Perm = PermBit.Export)]
    [Description("导出联系人")]
    async void Export() {
        bool xlsx = this.InAnyInt("xlsx", 0) == 1;
        List<CrmContact> rows = await this.CrmContact
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<CrmCustomer> custs = await this.CrmCustomer
            .Where(a => a.tenantId == Tenant.Cur())
            .OrderBy(a => a.id).ToListAsync();
        List<List<string>> data = new List<List<string>>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            CrmContact c = rows[i];
            List<string> r = new List<string>();
            r.Add(Contacts.CustName(custs, c.customerId));
            r.Add(c.name); r.Add(c.title); r.Add(c.phone); r.Add(c.email);
            data.Add(r);
        }
        await ExcelIo.Download(this.Ctx(), "联系人", Contacts.Headers(),
            data, xlsx);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create)]
    [Description("联系人导入模板")]
    async void Template() {
        List<string> sample = new List<string>();
        sample.Add("示例客户"); sample.Add("李四"); sample.Add("采购经理");
        sample.Add("13900000000"); sample.Add("lisi@example.com");
        await ExcelIo.Template(this.Ctx(), "联系人导入", Contacts.Headers(),
            sample);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create, ApiMax = 30, Upload = true)]
    [Description("导入联系人")]
    async void Import() {
        SysUser me = await this.Admin();
        if (this.ctx.UploadPath().Length == 0) {
            this.Fail(400, "1002", "没有上传内容");
            return;
        }
        string text = File.ReadAllText(this.ctx.UploadPath());
        int batchId = await ExcelIo.Import(this.Held(), Tenant.Cur(),
            me, "crm_contact", "upload.csv", Contacts.Headers(),
            Contacts.Rules(), Csv.Parse(text), Contacts.SaveRow);
        await this.Note("导入联系人", "批次#" + Convert.ToString(batchId),
            true, "");
        this.Ok(await ExcelIo.BatchReport(this.Held(), Tenant.Cur(),
            batchId));
    }
}
