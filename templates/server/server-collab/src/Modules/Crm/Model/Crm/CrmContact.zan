using System.Data.Orm;

namespace ZanWeb.Model.Crm;

/* 客户联系人。一个客户多条联系人；customerId 为外键，删除客户时不级联（由业务代码决定）。 */
[Table(Name = "crm_contact")]
class CrmContact {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，#34）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new CrmContact() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    int customerId;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    [Column(StringLength = 64)]
    string title;

    [Column(StringLength = 32)]
    string phone;

    [Column(StringLength = 128)]
    string email;

    long createdAt;
}
