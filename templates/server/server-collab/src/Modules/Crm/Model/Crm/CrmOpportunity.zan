using System.Data.Orm;

namespace ZanWeb.Model.Crm;

/* 商机(销售管道)。stage：1 初步接触 2 需求确认 3 方案报价 4 谈判 5 赢单 0 输单。阶段推进只改 stage 字段，不删记录。 */
[Table(Name = "crm_opportunity")]
class CrmOpportunity {
    [Column(IsIdentity = true)]
    int id;

    int customerId;

    [Column(StringLength = 128, IsNullable = false)]
    string title;

    long amount;
    int stage;
    int ownerId;
    long expectedCloseAt;

    long createdAt;
    long updatedAt;
}
