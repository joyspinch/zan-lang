using System.Data.Orm;

namespace ZanWeb.Model.Crm;

/* 客户主数据。crm_ 前缀=客户域。level 仅展示用，不影响权限。 */
[Table(Name = "crm_customer")]
class CrmCustomer {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，#34）。ORM DDL 不生成 DEFAULT 子句（见 OrmDialect.Ty），
       列默认由字段初始化器保证：所有 new CrmCustomer() 插入路径写 1。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    [Column(StringLength = 128, IsNullable = false)]
    string name;

    [Column(StringLength = 64)]
    string contact;

    [Column(StringLength = 32)]
    string phone;

    /* 1=重要；2=普通；3=潜在。 */
    int level;

    int ownerId;

    [Column(StringLength = 256)]
    string remark;

    long createdAt;
    long updatedAt;
}
