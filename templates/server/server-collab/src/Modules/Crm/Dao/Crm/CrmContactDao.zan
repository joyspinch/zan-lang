using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Crm;

namespace ZanWeb.Dao.Crm;

/* CrmContact 强类型数据访问网关（FreeSql 风格） */
class CrmContactDao : BaseRepository<CrmContact> {
    CrmContactDao(IFreeSql fsql) : base(fsql) {}
    CrmContactDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async CrmContact ById(int id) {
        return await this.GetExecutor().Select<CrmContact>().Where(a => a.id == id).FirstAsync();
    }

    async List<CrmContact> All() {
        return await this.GetExecutor().Select<CrmContact>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<CrmContact>().CountAsync();
    }

    async int Insert(CrmContact entity) {
        return await this.GetExecutor().Insert<CrmContact>(entity).ExecuteIdentityAsync();
    }

    int InsertSync(CrmContact entity) {
        return this.GetExecutor().Insert<CrmContact>(entity).ExecuteAffrows();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<CrmContact>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async List<CrmContact> Search(int tenantId, string kw, int limit) {
        return await this.GetExecutor().Select<CrmContact>()
            .Where(a => a.tenantId == tenantId
                && (a.name.Contains(kw) || a.phone.Contains(kw) || a.email.Contains(kw)))
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }
}
