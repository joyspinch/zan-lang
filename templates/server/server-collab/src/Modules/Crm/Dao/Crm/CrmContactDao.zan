using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Crm;

namespace Zan.Web.Dao.Crm;

/* CrmContact 强类型数据访问网关（ZanSql 风格） */
public class CrmContactDao : BaseRepository<CrmContact> {
    public CrmContactDao() : base() {}
    public CrmContactDao(IZanSql fsql) : base(fsql) {}
    public CrmContactDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async CrmContact ById(int id) {
        return await this.GetExecutor().Select<CrmContact>().Where(a => a.id == id).FirstAsync();
    }

    public async List<CrmContact> All() {
        return await this.GetExecutor().Select<CrmContact>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<CrmContact>().CountAsync();
    }

    public InsertQuery<CrmContact> Insert(CrmContact entity) {
        return this.GetExecutor().Insert<CrmContact>(entity);
    }

    public int InsertSync(CrmContact entity) {
        return this.GetExecutor().Insert<CrmContact>(entity).ExecuteAffrows();
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<CrmContact>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async List<CrmContact> Search(int tenantId, string kw, int limit) {
        return await this.GetExecutor().Select<CrmContact>()
            .Where(a => a.tenantId == tenantId
                && (a.name.Contains(kw) || a.phone.Contains(kw) || a.email.Contains(kw)))
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }
}
