using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Crm;

namespace Zan.Web.Dao.Crm;

/* CrmCustomer 强类型数据访问网关（ZanSql 风格） */
public class CrmCustomerDao : BaseRepository<CrmCustomer> {
    public CrmCustomerDao() : base() {}
    public CrmCustomerDao(IZanSql fsql) : base(fsql) {}
    public CrmCustomerDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async CrmCustomer ById(int id) {
        return await this.GetExecutor().Select<CrmCustomer>().Where(a => a.id == id).FirstAsync();
    }

    public async List<CrmCustomer> All() {
        return await this.GetExecutor().Select<CrmCustomer>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<CrmCustomer>().CountAsync();
    }

    public InsertQuery<CrmCustomer> Insert(CrmCustomer entity) {
        return this.GetExecutor().Insert<CrmCustomer>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<CrmCustomer>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async List<CrmCustomer> Search(int tenantId, string kw, int limit) {
        return await this.GetExecutor().Select<CrmCustomer>()
            .Where(a => a.tenantId == tenantId
                && (a.name.Contains(kw) || a.contact.Contains(kw) || a.phone.Contains(kw)))
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }

    public async CrmCustomer ByName(int tenantId, string name) {
        return await this.GetExecutor().Select<CrmCustomer>()
            .Where(a => a.name == name && a.tenantId == tenantId)
            .FirstAsync();
    }

    public async int CountByName(int tenantId, string name) {
        return await this.GetExecutor().Select<CrmCustomer>()
            .Where(a => a.name == name && a.tenantId == tenantId)
            .CountAsync();
    }

    /* 兼容行导入或后台场景的同步版本 */
    public CrmCustomer ByNameSync(int tenantId, string name) {
        return this.GetExecutor().Select<CrmCustomer>()
            .Where(a => a.name == name && a.tenantId == tenantId)
            .First();
    }

    public int CountByNameSync(int tenantId, string name) {
        return this.GetExecutor().Select<CrmCustomer>()
            .Where(a => a.name == name && a.tenantId == tenantId)
            .Count();
    }

    public int InsertSync(CrmCustomer entity) {
        return this.GetExecutor().Insert<CrmCustomer>(entity).ExecuteAffrows();
    }
}
