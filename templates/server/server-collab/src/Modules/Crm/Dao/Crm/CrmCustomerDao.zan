using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Crm;

namespace ZanWeb.Dao.Crm;

/* CrmCustomer 强类型数据访问网关（FreeSql 风格） */
class CrmCustomerDao {
    IDbConnection db;

    CrmCustomerDao(IDbConnection db) {
        this.db = db;
    }

    async CrmCustomer ById(int id) {
        return await this.db.Select<CrmCustomer>().Where(a => a.id == id).FirstAsync();
    }

    async List<CrmCustomer> All() {
        return await this.db.Select<CrmCustomer>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<CrmCustomer>().CountAsync();
    }

    async int Insert(CrmCustomer entity) {
        return await this.db.Insert<CrmCustomer>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<CrmCustomer>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async List<CrmCustomer> Search(int tenantId, string kw, int limit) {
        return await this.db.Select<CrmCustomer>()
            .Where(a => a.tenantId == tenantId
                && (a.name.Contains(kw) || a.contact.Contains(kw) || a.phone.Contains(kw)))
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }

    async CrmCustomer ByName(int tenantId, string name) {
        return await this.db.Select<CrmCustomer>()
            .Where(a => a.name == name && a.tenantId == tenantId)
            .FirstAsync();
    }

    async int CountByName(int tenantId, string name) {
        return await this.db.Select<CrmCustomer>()
            .Where(a => a.name == name && a.tenantId == tenantId)
            .CountAsync();
    }

    /* 兼容行导入或后台场景的同步版本 */
    CrmCustomer ByNameSync(int tenantId, string name) {
        return this.db.Select<CrmCustomer>()
            .Where(a => a.name == name && a.tenantId == tenantId)
            .First();
    }

    int CountByNameSync(int tenantId, string name) {
        return this.db.Select<CrmCustomer>()
            .Where(a => a.name == name && a.tenantId == tenantId)
            .Count();
    }

    int InsertSync(CrmCustomer entity) {
        return this.db.Insert<CrmCustomer>(entity).ExecuteAffrows();
    }
}
