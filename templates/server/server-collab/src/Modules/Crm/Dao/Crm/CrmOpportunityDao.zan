using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Crm;

namespace Zan.Web.Dao.Crm;

/* CrmOpportunity 强类型数据访问网关（ZanSql 风格） */
public class CrmOpportunityDao : BaseRepository<CrmOpportunity> {
    public CrmOpportunityDao() : base() {}
    public CrmOpportunityDao(IZanSql fsql) : base(fsql) {}
    public CrmOpportunityDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async CrmOpportunity ById(int id) {
        return await this.GetExecutor().Select<CrmOpportunity>().Where(a => a.id == id).FirstAsync();
    }

    public async List<CrmOpportunity> All() {
        return await this.GetExecutor().Select<CrmOpportunity>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<CrmOpportunity>().CountAsync();
    }

    public InsertQuery<CrmOpportunity> Insert(CrmOpportunity entity) {
        return this.GetExecutor().Insert<CrmOpportunity>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<CrmOpportunity>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async List<CrmOpportunity> ApproachingByOwner(int tenantId, int ownerId, long horizon) {
        return await this.GetExecutor().Select<CrmOpportunity>()
            .Where(a => a.tenantId == tenantId && a.ownerId == ownerId
                && a.stage >= 1 && a.stage <= 4
                && a.expectedCloseAt > 0 && a.expectedCloseAt <= horizon)
            .OrderBy(a => a.expectedCloseAt)
            .ToListAsync();
    }

    public async List<CrmOpportunity> Search(int tenantId, string kw, int limit) {
        return await this.GetExecutor().Select<CrmOpportunity>()
            .Where(a => a.tenantId == tenantId && a.title.Contains(kw))
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }
}
