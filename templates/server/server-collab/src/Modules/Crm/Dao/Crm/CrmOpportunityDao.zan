using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Crm;

namespace ZanWeb.Dao.Crm;

/* CrmOpportunity 强类型数据访问网关（FreeSql 风格） */
class CrmOpportunityDao : BaseRepository<CrmOpportunity> {
    CrmOpportunityDao(IFreeSql fsql) : base(fsql) {}
    CrmOpportunityDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async CrmOpportunity ById(int id) {
        return await this.GetExecutor().Select<CrmOpportunity>().Where(a => a.id == id).FirstAsync();
    }

    async List<CrmOpportunity> All() {
        return await this.GetExecutor().Select<CrmOpportunity>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<CrmOpportunity>().CountAsync();
    }

    async int Insert(CrmOpportunity entity) {
        return await this.GetExecutor().Insert<CrmOpportunity>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<CrmOpportunity>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async List<CrmOpportunity> ApproachingByOwner(int tenantId, int ownerId, long horizon) {
        return await this.GetExecutor().Select<CrmOpportunity>()
            .Where(a => a.tenantId == tenantId && a.ownerId == ownerId
                && a.stage >= 1 && a.stage <= 4
                && a.expectedCloseAt > 0 && a.expectedCloseAt <= horizon)
            .OrderBy(a => a.expectedCloseAt)
            .ToListAsync();
    }

    async List<CrmOpportunity> Search(int tenantId, string kw, int limit) {
        return await this.GetExecutor().Select<CrmOpportunity>()
            .Where(a => a.tenantId == tenantId && a.title.Contains(kw))
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }
}
