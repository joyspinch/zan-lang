using System.Data.Orm;

namespace ZanWeb.Model.Bitable;

/* 多维表格的表本体（bitable_ 前缀 = 多维表格域）。
   三层结构：表（本表）/ 列（bitable_field）/ 行（bitable_record）。
   列与行都不在本表里存明细——表本体只管身份与权限口径：
     - ownerId：建表人。shared=0 时只有他（和超管）能写；
     - shared：0 = 私有（仅拥有者可写），1 = 租户共享（租户内人人可读写）；
     - archivedAt：归档时间，0 = 未归档。归档不抹行，读面一律过滤。 */
[Table(Name = "bitable_app")]
public class BitableApp {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，插入路径由字段初始化器写 1）。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 表名（客户端按字符串读）。 */
    [Column(StringLength = 128, IsNullable = false)]
    string name;

    /* 图标名（客户端按图标名渲染，如 "table"）。 */
    [Column(StringLength = 32)]
    string icon;

    /* 备注（可空；读面兜底成空串，客户端按字符串读）。 */
    [Column(StringLength = 255)]
    string description;

    /* 拥有者账号 id（写权限判定的依据）。 */
    int ownerId;

    /* 0 = 私有（仅拥有者可写）；1 = 租户共享（租户内可读写）。 */
    int shared;

    long createdAt;

    /* 最近一次改动时间（列/行写入也会顶它），列表按它看新鲜度。 */
    long updatedAt;

    /* 归档时间；0 = 未归档。 */
    long archivedAt;
}
