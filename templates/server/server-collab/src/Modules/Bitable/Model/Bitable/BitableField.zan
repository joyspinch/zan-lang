using System.Data.Orm;

namespace ZanWeb.Model.Bitable;

/* 多维表格的列定义（bitable_field）。
   一列 = 一段元数据：名字、类型、选项、显示宽度、列序。
   列序（sortOrder 升序、id 升序）就是行 cells 数组的下标——
   读面铺网格、删列摘元素都用这一个口径，故 sortOrder 不可重排，
   只能追加（新增列取当前最大值 +1）。 */
[Table(Name = "bitable_field")]
public class BitableField {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 所属表 id。 */
    int appId;

    /* 列名（客户端表格头）。 */
    [Column(StringLength = 64, IsNullable = false)]
    string name;

    /* 列类型：text | longtext | number | date | select | multi |
       checkbox | url（服务端白名单校验，不认的列型直接拒）。 */
    [Column(StringLength = 16, IsNullable = false)]
    string type;

    /* 选项集（select/multi 用）：JSON 文本，如 {"options":["A","B"]}。 */
    [Column(StringLength = 1024)]
    string options;

    /* 列序（cells 的下标口径）。 */
    int sortOrder;

    /* 显示宽度（像素）。 */
    int width;

    long createdAt;
}
