using System.Data.Orm;

namespace ZanWeb.Model.Bitable;

/* 多维表格的行（bitable_record）。
   行不按列存字段，只存一串与列一一对应的单元格值（cells，JSON 数组
   文本，如 ["需求A","3","2026-01-01"]）——列是运行期才定的，存字段名
   就要跟着改列迁移数据；按下标对齐则增删列只动这一串。
   删除走软删（deletedAt 打时间戳）：多维表格的行可能被别处引用，
   抹了就查无对证，读面一律过滤 deletedAt > 0 的行。 */
[Table(Name = "bitable_record")]
public class BitableRecord {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 所属表 id。 */
    int appId;

    /* 单元格值：JSON 数组文本，顺序与列定义一一对应。 */
    [Column(StringLength = 4096)]
    string cells;

    /* 建行者账号 id（行归属人，便于追责与"我建的"筛选）。 */
    int createdBy;

    long createdAt;

    long updatedAt;

    /* 软删时间；0 = 未删除。 */
    long deletedAt;
}
