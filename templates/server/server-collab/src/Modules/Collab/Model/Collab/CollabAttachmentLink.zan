using System.Data.Orm;

namespace ZanWeb.Model.Collab;

/* 协作附件绑定：附件与消息/任务的显式关联——授权按资源成员
   关系判定（会话成员/任务参与者），oa_attachment.module 只是治理标签，
   不是授权依据（契约「权限矩阵」节）。一字节文件至多一个绑定
   （attachmentId 唯一，Schema 原生 DDL），复用同一文件请重新上传——
   MVP 语义从简，转发/多挂随后续治理再评估。 */
[Table(Name = "collab_attachment_link")]
[Index(Name = "ix_collab_attlink", Fields = "tenantId,ownerType,ownerId")]
class CollabAttachmentLink {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，新插入路径由字段初始化器写 1）。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* → oa_attachment.id。 */
    int attachmentId;

    /* message | task。 */
    [Column(StringLength = 16, IsNullable = false)]
    string ownerType;

    /* 挂载行 id（消息 id / 任务 id）。 */
    int ownerId;

    /* 绑定操作人（= 消息发送者 / 任务动作方）。 */
    int addedBy;

    long createdAt;
}
