using System.Data.Orm;

namespace ZanWeb.Model.Collab;

/* 协作任务（A327-10）：日常协作任务的事实行——认领/进度/阻塞/转交/验收。
   与 flow_task（预定义节点顺序审批）语义严格分离，可经 flowInstId 可选关联。
   状态机：unassigned→claimed→in_progress→review→done；in_progress⇄blocked；
   除 done 外可 cancelled。overdue 由 dueAt 派生（视图），不落状态列。
   删除 = cancelled + 事件，不抹行。version 是乐观锁：每次迁移 +1，
   认领/转交等 CAS 条件 UPDATE 以它为闸（A327-03 后半）。 */
[Table(Name = "collab_task")]
[Index(Name = "ix_collab_task_st", Fields = "tenantId,status,assigneeId,dueAt")]
class CollabTask {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，新插入路径由字段初始化器写 1）。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* 所属会话；0 = 不落会话的独立任务。 */
    int conversationId;

    int createdBy;

    /* 最终责任人（验收归属）。 */
    int ownerId;

    /* 当前执行人；0 = 未分配（任务池）。 */
    int assigneeId;

    [Column(StringLength = 128, IsNullable = false)]
    string title;

    [Column(StringLength = 512)]
    string description;

    /* unassigned|claimed|in_progress|blocked|review|done|cancelled。 */
    [Column(StringLength = 16, IsNullable = false)]
    string status;

    /* 0 普通 / 1 重要 / 2 紧急 / 3 重要且紧急。 */
    int priority;

    /* 0..100；迁移随事件追加，不覆盖历史。 */
    int progress;

    /* 截止时间（Unix 秒）；0 = 无。overdue 视图派生自它。 */
    long dueAt;

    /* 阻塞原因：block 动作必填，unblock 清空。 */
    [Column(StringLength = 256)]
    string blockedReason;

    /* 关联正式流程实例；0 = 无（桥接随 A327-17）。 */
    int flowInstId;

    /* 乐观锁版本号：每次状态/责任/进度迁移 +1。 */
    int version;

    long createdAt;

    long updatedAt;

    long completedAt;
}
