using System.Data.Orm;

namespace ZanWeb.Model.Collab;

/* 协作会话成员：授权的事实源——会话读与群管理都判定在
   本表（租户硬边在先、成员关系随后、角色位最后），不借后台屏权限，也与
   Attachment.CanDownload 的 sc.Any() 宽口无关（协作资源不走那道门）。
   (tenantId,conversationId,userId) 唯一，由 Schema.EnsureCollabIndexes 的
   原生 CREATE UNIQUE INDEX 保证（ORM [Index] 无唯一形态）：重入会话 =
   原行 status left→active 条件复位，不另起行。 */
[Table(Name = "collab_member")]
[Index(Name = "ix_collab_member_user", Fields = "tenantId,userId,status,conversationId")]
class CollabMember {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，新插入路径由字段初始化器写 1）。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    int conversationId;

    int userId;

    /* owner | admin | member。 */
    [Column(StringLength = 16, IsNullable = false)]
    string role;

    /* active | left。left 保留行以存「曾参与」事实并支撑重入复位。 */
    [Column(StringLength = 16, IsNullable = false)]
    string status;

    /* 已读水位。 */
    int lastReadMsgId;

    long joinedAt;

    /* 最近一次退出时间；0 = 在会话中。 */
    long leftAt;
}
