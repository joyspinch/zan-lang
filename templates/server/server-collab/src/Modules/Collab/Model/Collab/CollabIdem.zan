using System.Data.Orm;

namespace ZanWeb.Model.Collab;

/* 协作域幂等键（契约见 README「写模型：幂等 + CAS」）：
   可重试写按 (tenantId,actorId,operation,clientRequestId) 只落一次事实。
   占位行在请求事务内以空 response 插入（唯一索引见
   Schema.EnsureCollabIndexes），事务收尾回填应答；重放时 response 非空
   原样返回（标 replayed=1），空串=上次仍在处理（409）。事务回滚会把占位
   行一并回滚，失败路径不留残键，原键可干净重试。 */
[Table(Name = "collab_idem")]
[Index(Name = "ix_collab_idem_key", Fields = "tenantId,actorId,operation,clientRequestId")]
class CollabIdem {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，新插入路径由字段初始化器写 1）。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    int actorId;

    /* 操作名，如 conversation.create / member.invite / member.leave / member.kick。 */
    [Column(StringLength = 32, IsNullable = false)]
    string operation;

    [Column(StringLength = 64, IsNullable = false)]
    string clientRequestId;

    /* 首个事实资源的类型与 id（conversation/member…），审计与排障用。 */
    [Column(StringLength = 24)]
    string resourceType;

    int resourceId;

    /* 已完成的应答 data JSON（不含 {code,msg,data} 外壳）；空串 = 占位未完成。 */
    [Column(StringLength = 512)]
    string response;

    long createdAt;
}
