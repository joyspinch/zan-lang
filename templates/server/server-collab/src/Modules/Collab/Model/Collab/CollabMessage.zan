using System.Data.Orm;

namespace ZanWeb.Model.Collab;

/* 协作消息（A327-08）：group 会话的消息事实；私聊历史仍在 oa_message（存量
   零迁移，direct 视图合成呈现）。按会话游标分页读取（before+limit），不再
   有「打开即拉全量」。撤回/删除置 deletedAt，不抹行（审计）；历史按已删除
   形态呈现。kind=text|system 一期落地；task 卡片随任务域（A327-10）、
   image/file 随附件域（A327-09）扩充。 */
[Table(Name = "collab_message")]
[Index(Name = "ix_collab_msg_conv", Fields = "tenantId,conversationId,id")]
class CollabMessage {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，新插入路径由字段初始化器写 1）。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    int conversationId;

    int senderId;

    /* text | system | task | image | file（按域扩充）。 */
    [Column(StringLength = 16, IsNullable = false)]
    string kind;

    /* 正文 ≤2048B（发送路径截断）；task/image/file 时为摘要，资源回链在各自域。 */
    [Column(StringLength = 2048, IsNullable = false)]
    string body;

    /* 引用回复：必须本会话内既有消息，否则按 0 收下（Im 同口径，不悬空）。 */
    int replyTo;

    /* 客户端幂等键（去重在 collab_idem，此列留审计对账）。 */
    [Column(StringLength = 64)]
    string clientRequestId;

    long createdAt;

    /* 撤回/删除时间；0 = 在。 */
    long deletedAt;
}
