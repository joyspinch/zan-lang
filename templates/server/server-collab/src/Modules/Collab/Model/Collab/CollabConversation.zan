using System.Data.Orm;

namespace ZanWeb.Model.Collab;

/* 协作会话（A327-07 地基，契约见 README「协作域契约（A327 提案）」）：
   group = 多人群聊；direct = 一对一私聊的协作视图——一期由 oa_message 合成
   呈现，不落行（存量零迁移）。本表只存会话事实；成员关系在 collab_member
   （授权判定的事实源），消息在 collab_message（A327-08）。
   version 供后续写模型的 expectedVersion 乐观锁（A327-03 后半），本次落列。 */
[Table(Name = "collab_conversation")]
[Index(Name = "ix_collab_conv", Fields = "tenantId,updatedAt")]
class CollabConversation {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，新插入路径由字段初始化器写 1）。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* direct | group（一期只落 group）。 */
    [Column(StringLength = 16, IsNullable = false)]
    string type;

    [Column(StringLength = 64, IsNullable = false)]
    string title;

    int creatorId;

    /* 乐观锁版本号：标题/成员面变更 +1。 */
    int version;

    long createdAt;

    long updatedAt;

    /* 归档时间；0 = 未归档。删除=归档+事件，不抹行。 */
    long archivedAt;
}
