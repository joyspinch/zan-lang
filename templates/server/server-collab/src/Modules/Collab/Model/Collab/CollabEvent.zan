using System.Data.Orm;

namespace ZanWeb.Model.Collab;

/* 协作域事件（A327-04 前半——事实侧）：与领域事实同事务落库（表即总线，
   MessageRelay 同款定案），消费端（在线扇出 + events?after= cursor 补拉）
   归 A327-04。payload 只放紧凑摘要，无长正文；读取侧必须先按会话/任务
   成员关系过滤再分发（一期无 target 表，读时判定成员资格，成本过高时
   再增 collab_event_target，见契约「事件协议」节）。 */
[Table(Name = "collab_event")]
[Index(Name = "ix_collab_event", Fields = "tenantId,id")]
class CollabEvent {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，新插入路径由字段初始化器写 1）。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    /* message.created / conversation.created / member.joined / member.left
       （task.* 随任务域扩充）。 */
    [Column(StringLength = 32, IsNullable = false)]
    string type;

    /* 事件主体（conversation/message/task…）。 */
    [Column(StringLength = 24, IsNullable = false)]
    string aggregateType;

    int aggregateId;

    /* 会话作用域：conversation 与 message 两类事件的目标会话，补拉
       （events?after=）与在线扇出都按它做成员资格过滤；任务域事件落 0
       并另带任务回链（A327-10 扩）。 */
    int conversationId;

    /* 行为方（userId）。 */
    int actorId;

    /* 紧凑摘要 JSON（如 {conversationId,messageId,senderId,excerpt}）。 */
    [Column(StringLength = 512, IsNullable = false)]
    string payload;

    long createdAt;
}
