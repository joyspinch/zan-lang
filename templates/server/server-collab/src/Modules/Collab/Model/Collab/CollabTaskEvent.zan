using System.Data.Orm;

namespace ZanWeb.Model.Collab;

/* 协作任务事件（A327-10）：只追加不更新——状态/责任/进度的每次迁移一行，
   from/to 各一对快照（审计可答「谁在何时把任务从什么状态/责任人/进度改成
   什么，理由是什么」）。OperationLog 只记入口动作（平台既有），本表承载
   领域事实；判定口径见契约「任务读写」。 */
[Table(Name = "collab_task_event")]
[Index(Name = "ix_collab_task_ev", Fields = "tenantId,taskId,id")]
class CollabTaskEvent {
    [Column(IsIdentity = true)]
    int id;

    /* 归属租户（软隔离基列，新插入路径由字段初始化器写 1）。 */
    [Column(IsNullable = false)]
    int tenantId = 1;

    int taskId;

    /* 行为方。 */
    int actorId;

    /* created|assigned|claimed|started|progress|blocked|unblocked|submitted|
       approved|rejected|transferred|cancelled。 */
    [Column(StringLength = 16, IsNullable = false)]
    string eventType;

    [Column(StringLength = 16, IsNullable = false)]
    string fromStatus;

    [Column(StringLength = 16, IsNullable = false)]
    string toStatus;

    int fromOwnerId;

    int toOwnerId;

    int fromAssigneeId;

    int toAssigneeId;

    int fromProgress;

    int toProgress;

    /* block/reject/cancel/transfer 的必填理由；其余动作可空。 */
    [Column(StringLength = 256)]
    string reason;

    /* 进度汇报/验收意见等伴随文本。 */
    [Column(StringLength = 512)]
    string content;

    [Column(StringLength = 64)]
    string clientRequestId;

    long createdAt;
}
