using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Collab;

namespace ZanWeb.Dao.Collab;

/* CollabTask 强类型数据访问网关（FreeSql 风格） */
class CollabTaskDao {
    IDbConnection db;

    CollabTaskDao(IDbConnection db) {
        this.db = db;
    }

    async CollabTask ById(int id) {
        return await this.db.Select<CollabTask>().Where(a => a.id == id).FirstAsync();
    }

    async List<CollabTask> All() {
        return await this.db.Select<CollabTask>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<CollabTask>().CountAsync();
    }

    async int Insert(CollabTask entity) {
        return await this.db.Insert<CollabTask>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<CollabTask>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
