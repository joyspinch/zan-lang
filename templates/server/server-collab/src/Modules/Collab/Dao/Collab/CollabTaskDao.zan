using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Collab;

namespace Zan.Web.Dao.Collab;

/* CollabTask 强类型数据访问网关（继承 BaseRepository<CollabTask> 通用仓储） */
public class CollabTaskDao : BaseRepository<CollabTask> {
    public CollabTaskDao() : base() {}
    CollabTaskDao(IZanSql fsql) : base(fsql) {}
    CollabTaskDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async CollabTask ById(int id) {
        return await this.GetExecutor().Select<CollabTask>().Where(a => a.id == id).FirstAsync();
    }

    async List<CollabTask> All() {
        return await this.GetExecutor().Select<CollabTask>().OrderBy(a => a.id).ToListAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<CollabTask>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
