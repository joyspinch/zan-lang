using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Collab;

namespace ZanWeb.Dao.Collab;

/* CollabMessage 强类型数据访问网关（FreeSql 风格） */
class CollabMessageDao : BaseRepository<CollabMessage> {
    CollabMessageDao(IFreeSql fsql) : base(fsql) {}
    CollabMessageDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async CollabMessage ById(int id) {
        return await this.GetExecutor().Select<CollabMessage>().Where(a => a.id == id).FirstAsync();
    }

    async List<CollabMessage> All() {
        return await this.GetExecutor().Select<CollabMessage>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<CollabMessage>().CountAsync();
    }

    async int Insert(CollabMessage entity) {
        return await this.GetExecutor().Insert<CollabMessage>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<CollabMessage>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
