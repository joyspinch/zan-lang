using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Collab;

namespace Zan.Web.Dao.Collab;

/* CollabMessage 强类型数据访问网关（ZanSql 风格） */
public class CollabMessageDao : BaseRepository<CollabMessage> {
    public CollabMessageDao() : base() {}
    public CollabMessageDao(IZanSql fsql) : base(fsql) {}
    public CollabMessageDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async CollabMessage ById(int id) {
        return await this.GetExecutor().Select<CollabMessage>().Where(a => a.id == id).FirstAsync();
    }

    public async List<CollabMessage> All() {
        return await this.GetExecutor().Select<CollabMessage>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<CollabMessage>().CountAsync();
    }

    public InsertQuery<CollabMessage> Insert(CollabMessage entity) {
        return this.GetExecutor().Insert<CollabMessage>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<CollabMessage>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
