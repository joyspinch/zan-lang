using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Collab;

namespace ZanWeb.Dao.Collab;

/* CollabConversation 强类型数据访问网关（FreeSql 风格） */
class CollabConversationDao {
    IDbConnection db;

    CollabConversationDao(IDbConnection db) {
        this.db = db;
    }

    async CollabConversation ById(int id) {
        return await this.db.Select<CollabConversation>().Where(a => a.id == id).FirstAsync();
    }

    async List<CollabConversation> All() {
        return await this.db.Select<CollabConversation>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<CollabConversation>().CountAsync();
    }

    async int Insert(CollabConversation entity) {
        return await this.db.Insert<CollabConversation>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<CollabConversation>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async CollabConversation ByTenantAndId(int tenantId, int id) {
        return await this.db.Select<CollabConversation>()
            .Where(a => a.id == id && a.tenantId == tenantId)
            .FirstAsync();
    }
}
