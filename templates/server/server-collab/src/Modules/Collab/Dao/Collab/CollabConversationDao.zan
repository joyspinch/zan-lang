using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Collab;

namespace Zan.Web.Dao.Collab;

/* CollabConversation 强类型数据访问网关（ZanSql 风格） */
public class CollabConversationDao : BaseRepository<CollabConversation> {
    public CollabConversationDao() : base() {}
    public CollabConversationDao(IZanSql fsql) : base(fsql) {}
    public CollabConversationDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async CollabConversation ById(int id) {
        return await this.GetExecutor().Select<CollabConversation>().Where(a => a.id == id).FirstAsync();
    }

    public async List<CollabConversation> All() {
        return await this.GetExecutor().Select<CollabConversation>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<CollabConversation>().CountAsync();
    }

    public InsertQuery<CollabConversation> Insert(CollabConversation entity) {
        return this.GetExecutor().Insert<CollabConversation>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<CollabConversation>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async CollabConversation ByTenantAndId(int tenantId, int id) {
        return await this.GetExecutor().Select<CollabConversation>()
            .Where(a => a.id == id && a.tenantId == tenantId)
            .FirstAsync();
    }
}
