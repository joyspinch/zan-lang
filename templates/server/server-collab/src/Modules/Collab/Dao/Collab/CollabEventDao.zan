using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Collab;

namespace Zan.Web.Dao.Collab;

/* CollabEvent 强类型数据访问网关（ZanSql 风格） */
public class CollabEventDao : BaseRepository<CollabEvent> {
    public CollabEventDao() : base() {}
    public CollabEventDao(IZanSql fsql) : base(fsql) {}
    public CollabEventDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async CollabEvent ById(int id) {
        return await this.GetExecutor().Select<CollabEvent>().Where(a => a.id == id).FirstAsync();
    }

    public async List<CollabEvent> All() {
        return await this.GetExecutor().Select<CollabEvent>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<CollabEvent>().CountAsync();
    }

    public InsertQuery<CollabEvent> Insert(CollabEvent entity) {
        return this.GetExecutor().Insert<CollabEvent>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<CollabEvent>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async CollabEvent Latest() {
        return await this.GetExecutor().Select<CollabEvent>()
            .OrderByDescending(a => a.id)
            .FirstAsync();
    }

    public async List<CollabEvent> AfterId(long mark, int take) {
        return await this.GetExecutor().Select<CollabEvent>()
            .Where(a => a.id > mark)
            .OrderBy(a => a.id)
            .Take(take)
            .ToListAsync();
    }
}
