using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Collab;

namespace ZanWeb.Dao.Collab;

/* CollabEvent 强类型数据访问网关（FreeSql 风格） */
class CollabEventDao : BaseRepository<CollabEvent> {
    CollabEventDao(IFreeSql fsql) : base(fsql) {}
    CollabEventDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async CollabEvent ById(int id) {
        return await this.GetExecutor().Select<CollabEvent>().Where(a => a.id == id).FirstAsync();
    }

    async List<CollabEvent> All() {
        return await this.GetExecutor().Select<CollabEvent>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<CollabEvent>().CountAsync();
    }

    async int Insert(CollabEvent entity) {
        return await this.GetExecutor().Insert<CollabEvent>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<CollabEvent>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async CollabEvent Latest() {
        return await this.GetExecutor().Select<CollabEvent>()
            .OrderByDescending(a => a.id)
            .FirstAsync();
    }

    async List<CollabEvent> AfterId(long mark, int take) {
        return await this.GetExecutor().Select<CollabEvent>()
            .Where(a => a.id > mark)
            .OrderBy(a => a.id)
            .Take(take)
            .ToListAsync();
    }
}
