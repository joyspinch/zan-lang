using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Collab;

namespace ZanWeb.Dao.Collab;

/* CollabMember 强类型数据访问网关（FreeSql 风格） */
class CollabMemberDao : BaseRepository<CollabMember> {
    CollabMemberDao(IFreeSql fsql) : base(fsql) {}
    CollabMemberDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async CollabMember ById(int id) {
        return await this.GetExecutor().Select<CollabMember>().Where(a => a.id == id).FirstAsync();
    }

    async List<CollabMember> All() {
        return await this.GetExecutor().Select<CollabMember>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<CollabMember>().CountAsync();
    }

    async int Insert(CollabMember entity) {
        return await this.GetExecutor().Insert<CollabMember>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<CollabMember>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    async CollabMember ByUser(int tenantId, int conversationId, int userId) {
        return await this.GetExecutor().Select<CollabMember>()
            .Where(a => a.tenantId == tenantId && a.conversationId == conversationId
                && a.userId == userId)
            .FirstAsync();
    }

    async List<CollabMember> ActiveMembers(int tenantId, int conversationId) {
        return await this.GetExecutor().Select<CollabMember>()
            .Where(a => a.tenantId == tenantId
                && a.conversationId == conversationId
                && a.status == "active")
            .ToListAsync();
    }
}
