using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Collab;

namespace Zan.Web.Dao.Collab;

/* CollabMember 强类型数据访问网关（ZanSql 风格） */
public class CollabMemberDao : BaseRepository<CollabMember> {
    public CollabMemberDao() : base() {}
    public CollabMemberDao(IZanSql fsql) : base(fsql) {}
    public CollabMemberDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async CollabMember ById(int id) {
        return await this.GetExecutor().Select<CollabMember>().Where(a => a.id == id).FirstAsync();
    }

    public async List<CollabMember> All() {
        return await this.GetExecutor().Select<CollabMember>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<CollabMember>().CountAsync();
    }

    public InsertQuery<CollabMember> Insert(CollabMember entity) {
        return this.GetExecutor().Insert<CollabMember>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<CollabMember>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }

    public async CollabMember ByUser(int tenantId, int conversationId, int userId) {
        return await this.GetExecutor().Select<CollabMember>()
            .Where(a => a.tenantId == tenantId && a.conversationId == conversationId
                && a.userId == userId)
            .FirstAsync();
    }

    public async List<CollabMember> ActiveMembers(int tenantId, int conversationId) {
        return await this.GetExecutor().Select<CollabMember>()
            .Where(a => a.tenantId == tenantId
                && a.conversationId == conversationId
                && a.status == "active")
            .ToListAsync();
    }
}
