using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Collab;

namespace Zan.Web.Dao.Collab;

/* CollabAttachmentLink 强类型数据访问网关（ZanSql 风格） */
public class CollabAttachmentLinkDao : BaseRepository<CollabAttachmentLink> {
    public CollabAttachmentLinkDao() : base() {}
    public CollabAttachmentLinkDao(IZanSql fsql) : base(fsql) {}
    public CollabAttachmentLinkDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async CollabAttachmentLink ById(int id) {
        return await this.GetExecutor().Select<CollabAttachmentLink>().Where(a => a.id == id).FirstAsync();
    }

    public async List<CollabAttachmentLink> All() {
        return await this.GetExecutor().Select<CollabAttachmentLink>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<CollabAttachmentLink>().CountAsync();
    }

    public InsertQuery<CollabAttachmentLink> Insert(CollabAttachmentLink entity) {
        return this.GetExecutor().Insert<CollabAttachmentLink>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<CollabAttachmentLink>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
