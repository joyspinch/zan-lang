using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Collab;

namespace ZanWeb.Dao.Collab;

/* CollabAttachmentLink 强类型数据访问网关（FreeSql 风格） */
class CollabAttachmentLinkDao : BaseRepository<CollabAttachmentLink> {
    CollabAttachmentLinkDao(IFreeSql fsql) : base(fsql) {}
    CollabAttachmentLinkDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async CollabAttachmentLink ById(int id) {
        return await this.GetExecutor().Select<CollabAttachmentLink>().Where(a => a.id == id).FirstAsync();
    }

    async List<CollabAttachmentLink> All() {
        return await this.GetExecutor().Select<CollabAttachmentLink>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<CollabAttachmentLink>().CountAsync();
    }

    async int Insert(CollabAttachmentLink entity) {
        return await this.GetExecutor().Insert<CollabAttachmentLink>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<CollabAttachmentLink>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
