using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Collab;

namespace Zan.Web.Dao.Collab;

/* CollabTaskEvent 强类型数据访问网关（ZanSql 风格） */
public class CollabTaskEventDao : BaseRepository<CollabTaskEvent> {
    public CollabTaskEventDao() : base() {}
    public CollabTaskEventDao(IZanSql fsql) : base(fsql) {}
    public CollabTaskEventDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    public async CollabTaskEvent ById(int id) {
        return await this.GetExecutor().Select<CollabTaskEvent>().Where(a => a.id == id).FirstAsync();
    }

    public async List<CollabTaskEvent> All() {
        return await this.GetExecutor().Select<CollabTaskEvent>().OrderBy(a => a.id).ToListAsync();
    }

    public async int Count() {
        return await this.GetExecutor().Select<CollabTaskEvent>().CountAsync();
    }

    public InsertQuery<CollabTaskEvent> Insert(CollabTaskEvent entity) {
        return this.GetExecutor().Insert<CollabTaskEvent>(entity);
    }

    public async int Delete(int id) {
        return await this.GetExecutor().Delete<CollabTaskEvent>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
