using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Collab;

namespace ZanWeb.Dao.Collab;

/* CollabTaskEvent 强类型数据访问网关（FreeSql 风格） */
class CollabTaskEventDao {
    IDbConnection db;

    CollabTaskEventDao(IDbConnection db) {
        this.db = db;
    }

    async CollabTaskEvent ById(int id) {
        return await this.db.Select<CollabTaskEvent>().Where(a => a.id == id).FirstAsync();
    }

    async List<CollabTaskEvent> All() {
        return await this.db.Select<CollabTaskEvent>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<CollabTaskEvent>().CountAsync();
    }

    async int Insert(CollabTaskEvent entity) {
        return await this.db.Insert<CollabTaskEvent>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<CollabTaskEvent>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
