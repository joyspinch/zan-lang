using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Collab;

namespace ZanWeb.Dao.Collab;

/* CollabTaskEvent 强类型数据访问网关（FreeSql 风格） */
class CollabTaskEventDao : BaseRepository<CollabTaskEvent> {
    CollabTaskEventDao(IFreeSql fsql) : base(fsql) {}
    CollabTaskEventDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async CollabTaskEvent ById(int id) {
        return await this.GetExecutor().Select<CollabTaskEvent>().Where(a => a.id == id).FirstAsync();
    }

    async List<CollabTaskEvent> All() {
        return await this.GetExecutor().Select<CollabTaskEvent>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<CollabTaskEvent>().CountAsync();
    }

    async int Insert(CollabTaskEvent entity) {
        return await this.GetExecutor().Insert<CollabTaskEvent>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<CollabTaskEvent>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
