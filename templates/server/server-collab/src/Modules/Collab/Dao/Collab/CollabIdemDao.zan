using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Collab;

namespace ZanWeb.Dao.Collab;

/* CollabIdem 强类型数据访问网关（FreeSql 风格） */
class CollabIdemDao : BaseRepository<CollabIdem> {
    CollabIdemDao(IFreeSql fsql) : base(fsql) {}
    CollabIdemDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async CollabIdem ById(int id) {
        return await this.GetExecutor().Select<CollabIdem>().Where(a => a.id == id).FirstAsync();
    }

    async List<CollabIdem> All() {
        return await this.GetExecutor().Select<CollabIdem>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<CollabIdem>().CountAsync();
    }

    async int Insert(CollabIdem entity) {
        return await this.GetExecutor().Insert<CollabIdem>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<CollabIdem>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
