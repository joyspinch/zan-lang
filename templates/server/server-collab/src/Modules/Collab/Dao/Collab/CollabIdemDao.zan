using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Collab;

namespace ZanWeb.Dao.Collab;

/* CollabIdem 强类型数据访问网关（FreeSql 风格） */
class CollabIdemDao {
    IDbConnection db;

    CollabIdemDao(IDbConnection db) {
        this.db = db;
    }

    async CollabIdem ById(int id) {
        return await this.db.Select<CollabIdem>().Where(a => a.id == id).FirstAsync();
    }

    async List<CollabIdem> All() {
        return await this.db.Select<CollabIdem>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<CollabIdem>().CountAsync();
    }

    async int Insert(CollabIdem entity) {
        return await this.db.Insert<CollabIdem>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<CollabIdem>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
