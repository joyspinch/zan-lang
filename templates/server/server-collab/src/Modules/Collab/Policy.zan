using System;
using System.Collections;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using System.Json;
using ZanWeb.Dao.Collab;
using ZanWeb.Model.Collab;

namespace ZanWeb.Modules.Collab;

/* 协作域权限矩阵（README「协作域契约」权限矩阵节的
   落地）：三层判定——租户硬边在先、资源成员关系随后、角色位最后。口径：
     - 会话行查无与跨租户同口径 404（不向跨租户泄露存在性，与平台
       「跨租户读写 404」一致）；
     - 会话读（成员列表/后续消息）仅 active member，非成员 403；
     - 群管理（加人/踢人/改名）owner|admin；admin 只能被 owner 踢；
     - owner 不可被踢、不可退出（先转让；转让随任务域落地）。
   全部静态纯判定：查询走传入连接，不做 Fail/应答（控制器负责把 false/null
   翻译成 404/403），便于后续任务域复用同一条判定链。 */
class Policy {
    /* 会话行（租户闸在先）；查无返回 null，调用方统一 404。 */
    static async CollabConversation Conversation(IDbConnection db, int tenantId,
                                                 int conversationId) {
        return await db.CollabConversation.ByTenantAndId(tenantId, conversationId);
    }

    /* 本人在会话中的成员行（含 left 行）；无行返回 null。 */
    static async CollabMember Member(IDbConnection db, int tenantId,
                                     int conversationId, int userId) {
        return await db.CollabMember.ByUser(tenantId, conversationId, userId);
    }

    static bool IsActive(CollabMember m) {
        return m != null && m.status == "active";
    }

    /* 群管理位：owner 或 admin。 */
    static bool IsAdmin(CollabMember m) {
        return Policy.IsActive(m) && (m.role == "owner" || m.role == "admin");
    }

    static bool IsOwner(CollabMember m) {
        return Policy.IsActive(m) && m.role == "owner";
    }

    /* 事件统一外形成形（在线帧与补拉同款，客户端两通道无差别）：
       eventId/event/aggregate/actor/conversationId 提到顶层，payload 原有
       字段（excerpt/userId/kicked…）保留。Set 非 Put（Put
       追加不去重）。 */
    static JsonValue Frame(CollabEvent e) {
        JsonValue o = JsonValue.ParseLenient(e.payload);
        if (o == null) { o = JsonValue.NewObject(); }
        o.Set("eventId", JsonValue.NewStr(Convert.ToString(e.id)));
        o.Set("event", JsonValue.NewStr(e.type));
        o.Set("aggregateType", JsonValue.NewStr(e.aggregateType));
        o.Set("aggregateId", JsonValue.NewStr(Convert.ToString(e.aggregateId)));
        o.Set("actorId", JsonValue.NewStr(Convert.ToString(e.actorId)));
        o.Set("conversationId", JsonValue.NewStr(Convert.ToString(e.conversationId)));
        return o;
    }
}
