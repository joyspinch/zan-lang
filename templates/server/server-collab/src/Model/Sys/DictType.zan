using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/* 一组带名字的 code/label 对（订单状态、性别等）。类型持有每项的机器名，项在 sys_dict_item 中。 */
[Table(Name = "sys_dict_type")]
class DictType {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string code;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    /* 1=可用；禁用后其项不显示。 */
    int status;

    [Column(StringLength = 255)]
    string description;

    long createdAt;
    long updatedAt;
}