using System;
using System.Net;

namespace WsGateway;

/* 连接注册表：在线客户端列表 + 推送/广播。
 * Worker 已接管握手、帧编解码、ping/pong 与分片重组；这里只登记/移除/扇出。
 * 单进程内所有回调跑在同一调度器上，列表无需加锁。 */
public class Gateway {
    static List<ClientConn> clients = new List<ClientConn>();

    public static ClientConn Add(Connection conn) {
        ClientConn c = new ClientConn(conn);
        clients.Add(c);
        return c;
    }

    /* 移除并返回该连接对应的客户端（未登记过返回 null）。 */
    public static ClientConn Remove(Connection conn) {
        int id = conn.GetId();
        for (int i = 0; i < clients.Count; i++) {
            if (clients[i].Id() == id) {
                ClientConn c = clients[i];
                clients.RemoveAt(i);
                return c;
            }
        }
        return null;
    }

    public static ClientConn Get(Connection conn) {
        int id = conn.GetId();
        for (int i = 0; i < clients.Count; i++) {
            if (clients[i].Id() == id) { return clients[i]; }
        }
        return null;
    }

    public static int Count() { return clients.Count; }

    public static List<ClientConn> All() { return clients; }

    /* 昵称是否已被别人占用（忽略大小写）。 */
    public static bool NickTaken(string nick, ClientConn self) {
        string key = nick.ToLower();
        for (int i = 0; i < clients.Count; i++) {
            if (clients[i] != self && clients[i].nick.ToLower() == key) { return true; }
        }
        return false;
    }

    /* 向所有在线客户端广播，返回投递数。 */
    public static async int Broadcast(string text) {
        int sent = 0;
        /* 先取快照：await 期间可能有人上下线，直接遍历 clients 会错位。 */
        List<ClientConn> snap = new List<ClientConn>();
        for (int i = 0; i < clients.Count; i++) { snap.Add(clients[i]); }
        for (int i = 0; i < snap.Count; i++) {
            if (await snap[i].Push(text)) { sent = sent + 1; }
        }
        return sent;
    }
}
