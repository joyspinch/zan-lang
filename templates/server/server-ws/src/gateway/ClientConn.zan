using System;
using System.Net.Sockets;

namespace WsGateway;

/* 已连接的 WebSocket 客户端：持有 socket 与 TcpClient，可由任意协程推送。 */
class ClientConn {
    int id;
    nint sock;
    TcpClient client;
    bool alive;

    ClientConn(int id, nint sock) {
        this.id = id;
        this.sock = sock;
        this.client = TcpClient.FromSocket(sock);
        this.alive = true;
    }

    static ClientConn Create(int id, nint sock) {
        return new ClientConn(id, sock);
    }
}
