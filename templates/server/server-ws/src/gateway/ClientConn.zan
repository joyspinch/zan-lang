using System;
using System.Net;

namespace WsGateway;

/* 一个在线客户端：Worker.Connection 的引用 + 业务会话状态（昵称）。
 * 连接生命周期（握手/帧循环/关闭）全在 Worker；这里只保存"这个人是谁"。 */
public class ClientConn {
    public Connection conn;
    public string nick;

    public ClientConn(Connection conn) {
        this.conn = conn;
        this.nick = "";
    }

    public int Id() { return this.conn.GetId(); }
    public bool Alive() { return !this.conn.IsClosed(); }
    public bool HasNick() { return this.nick != ""; }

    /* 显示名：起了昵称用昵称，否则用"游客#id"。 */
    public string DisplayName() {
        if (this.nick != "") { return this.nick; }
        return "游客#" + Convert.ToString(this.Id());
    }

    /* 推一条 Text 帧。必须走 WorkerWs.Push（负责 WebSocket 分帧）；
     * Connection.Send 写的是裸字节，浏览器会当成协议错误直接断开。 */
    public async bool Push(string text) {
        if (!this.Alive()) { return false; }
        return await WorkerWs.Push(this.conn, text);
    }
}
