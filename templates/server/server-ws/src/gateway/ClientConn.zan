using System;
using System.Net;
using WsGateway;

/* 在线 WebSocket 客户端：Worker.Connection 的引用，可由任意协程推送。 */
/* 连接的生命周期（握手/帧循环/关闭）全在 Worker；这里只登记与移除。 */
class ClientConn {
    Connection conn;

    ClientConn(Connection conn) {
        this.conn = conn;
    }

    static ClientConn Of(Connection conn) {
        return new ClientConn(conn);
    }

    int Id() { return this.conn.GetId(); }
    bool Alive() { return !this.conn.IsClosed(); }
    int Push(string text) { return Gateway.Push(this.conn, text); }
}
