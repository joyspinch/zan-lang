using System;
using WsGateway;

/* {{NAME}} -- gateway-worker WebSocket 服务。 */
/* main.zan 仅读取配置并启动 gateway；连接处理在 src/gateway，业务逻辑在 src/worker（ChatWorker）。config/app.json 运行时加载，不编译入二进制。 */
class Program {
    static async void Main() {
        Config.Load("config/app.json");
        Gateway gw = Gateway.Create(
            Config.Str("server", "host", "127.0.0.1"),
            Config.Int("server", "port", 8090));
        await gw.Start();
    }
}