using System;
using System.IO;
using System.Net.Http;

namespace WsGateway;

/* 极简静态文件服务：把 URL 路径映射到 wwwroot/ 下的文件。
 * 拒绝 ".." 与反斜杠，防目录穿越；"/" 映射到 index.html。
 * 生产环境大量静态资源建议放 CDN / 反向代理，这里只够发聊天页面。 */
public class StaticFiles {
    static string root = "wwwroot";

    public static void Root(string dir) { root = dir; }

    public static HttpResponse Serve(HttpRequest req) {
        if (!req.IsGet()) { return HttpResponse.MethodNotAllowed("GET"); }
        string path = req.path;
        int q = path.IndexOf("?");
        if (q >= 0) { path = path.Substring(0, q); }
        if (path == "" || path == "/") { path = "/index.html"; }
        if (path.Contains("..") || path.Contains("\\")) { return HttpResponse.NotFound(); }
        string file = root + path;
        if (!File.Exists(file)) { return HttpResponse.NotFound(); }
        byte[] data = File.ReadAllBytes(file);
        return HttpResponse.Bytes(data, data.Length, StaticFiles.ContentType(path));
    }

    static string ContentType(string path) {
        if (path.EndsWith(".html")) { return "text/html; charset=utf-8"; }
        if (path.EndsWith(".css")) { return "text/css; charset=utf-8"; }
        if (path.EndsWith(".js")) { return "text/javascript; charset=utf-8"; }
        if (path.EndsWith(".json")) { return "application/json; charset=utf-8"; }
        if (path.EndsWith(".svg")) { return "image/svg+xml"; }
        if (path.EndsWith(".png")) { return "image/png"; }
        if (path.EndsWith(".ico")) { return "image/x-icon"; }
        return "application/octet-stream";
    }
}
