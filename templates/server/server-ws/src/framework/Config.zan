using System;
using System.IO;
using System.Json;

namespace WsGateway;

/* 运行时读取 config/app.json（不编译进二进制），缺失的键回退到默认值。 */
public class Config {
    static bool loaded = false;
    static string configJson = "";

    public static void Load(string relPath) {
        loaded = true;
        List<string> cands = new List<string>();
        if (relPath.Length > 0) { cands.Add(relPath); }
        cands.Add("config/app.json");
        cands.Add("app.json");
        int i = 0;
        while (i < cands.Count) {
            if (File.Exists(cands[i])) {
                string txt = File.ReadAllText(cands[i]);
                if (txt.Length > 0) {
                    configJson = txt;
                    Console.WriteLine("[config] loaded " + cands[i]);
                    return;
                }
            }
            i = i + 1;
        }
        Console.WriteLine("[config] no config file; using built-in defaults");
    }

    public static string Str(string section, string key, string dflt) {
        if (!loaded) { Config.Load("config/app.json"); }
        if (configJson.Length == 0) { return dflt; }
        string result = dflt;
        try {
            JsonDoc.ParseScoped(configJson, (JsonDoc doc) => {
                if (doc.KindAt(0) == 5) {
                    int sec = doc.Get(0, section);
                    if (sec >= 0 && doc.KindAt(sec) == 5) {
                        result = doc.Str(sec, key, dflt);
                    }
                }
            });
        } catch (Exception) {
            return dflt;
        }
        return result;
    }

    public static int Int(string section, string key, int dflt) {
        if (!loaded) { Config.Load("config/app.json"); }
        if (configJson.Length == 0) { return dflt; }
        int result = dflt;
        try {
            JsonDoc.ParseScoped(configJson, (JsonDoc doc) => {
                if (doc.KindAt(0) == 5) {
                    int sec = doc.Get(0, section);
                    if (sec >= 0 && doc.KindAt(sec) == 5) {
                        result = (int)doc.Long(sec, key, (long)dflt);
                    }
                }
            });
        } catch (Exception) {
            return dflt;
        }
        return result;
    }
}
