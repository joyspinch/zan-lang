using System;
using System.Json;

/* 聊天协议（JSON 文本帧）。
 *   客户端 → 服务端：{"type":"nick","nick":"小明"}   改昵称
 *                    {"type":"say","text":"大家好"}  发言
 *   服务端 → 客户端：welcome / chat / system / users / error 五种，见 ChatMessage 各构造函数。
 * 协议只在这一个文件里定义，前端 wwwroot/js/client.js 与它一一对应。 */
public class ChatIn {
    public string type;
    public string nick;
    public string text;
}

public class ChatMessage {
    /* 连上后第一条：告诉客户端自己的 id 与当前显示名。 */
    public static string Welcome(int id, string name) {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject().WriteProperty("type", "welcome").WriteProperty("id", id)
            .WriteProperty("name", name).WriteEndObject();
        return w.ToJson();
    }

    public static string Chat(string from, string text) {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject().WriteProperty("type", "chat").WriteProperty("from", from)
            .WriteProperty("text", text).WriteProperty("time", ChatMessage.Now()).WriteEndObject();
        return w.ToJson();
    }

    public static string System(string text) {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject().WriteProperty("type", "system").WriteProperty("text", text)
            .WriteProperty("time", ChatMessage.Now()).WriteEndObject();
        return w.ToJson();
    }

    public static string Error(string text) {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject().WriteProperty("type", "error").WriteProperty("text", text).WriteEndObject();
        return w.ToJson();
    }

    public static string Users(List<string> names) {
        JsonWriter w = new JsonWriter();
        w.WriteStartObject().WriteProperty("type", "users").WritePropertyName("users").WriteStartArray();
        for (int i = 0; i < names.Count; i++) { w.WriteString(names[i]); }
        w.WriteEndArray().WriteEndObject();
        return w.ToJson();
    }

    static string Now() {
        return DateTime.Now().ToTimeString();
    }
}
