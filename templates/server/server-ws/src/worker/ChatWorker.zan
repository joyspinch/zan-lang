using System;
using System.Net;
using WsGateway;

/* 业务逻辑，与传输解耦：只返回要广播的文本。网关执行实际的推送。本演示为聊天室。 */
class ChatWorker {
    static async string OnOpen(Connection c, int online) {
        return "* client #" + Convert.ToString(c.GetId())
            + " joined (" + Convert.ToString(online) + " online)";
    }

    static async string OnMessage(Connection c, string msg) {
        return "[#" + Convert.ToString(c.GetId()) + "] " + msg;
    }

    static async string OnClose(Connection c, int online) {
        return "* client #" + Convert.ToString(c.GetId())
            + " left (" + Convert.ToString(online) + " online)";
    }
}
