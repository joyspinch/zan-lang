using System;

namespace WsGateway;

/* 业务逻辑，与传输解耦：只返回要广播的文本。网关执行实际的异步推送。本演示为聊天室。 */
class ChatWorker {
    static async string OnOpen(ClientConn c, int online) {
        return "* client #" + Convert.ToString(c.id)
            + " joined (" + Convert.ToString(online) + " online)";
    }

    static async string OnMessage(ClientConn c, string msg) {
        return "[#" + Convert.ToString(c.id) + "] " + msg;
    }

    static async string OnClose(ClientConn c, int online) {
        return "* client #" + Convert.ToString(c.id)
            + " left (" + Convert.ToString(online) + " online)";
    }
}
