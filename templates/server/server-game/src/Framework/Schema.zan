using System;
using System.Data;
using System.Data.Orm;
using System.Security.Cryptography;
using System.Web;
using ZanWeb.Model.Sys;
using ZanWeb.Model.Game;
using ZanWeb.Dao.Sys;

namespace ZanWeb;

/* 表结构 + 种子数据，启动时由 main.zan 一次性应用。CodeFirst (SyncStructure) 读取数据库目录发 DDL，不做每次请求触发。种子带计数保护，重复启动不变。权限仅 seed 内置角色持有哪些 action，其余从路由表派生。*/
class Schema {
    /* 创建/更新全部表并填充种子数据。数据库不可达时返回 false，服务器仍启动。*/
    static async bool Ensure(DbContext ctx) {
        IDbConnection db = await ctx.Acquire();
        if (db == null) { return false; }
        try {
            /* SQLite 启用 WAL（其他引擎无操作）：多 worker 共享文件时避免写者阻塞读者。*/
            await DbSchema.UseWriteAheadLogAsync(db);
            /* 编译期已知所有 [Table] 类，一行调用覆盖全部，新模型无需补行。*/
            await db.SyncStructureAllAsync();

            if (!await Schema.SeedAdmin(db)) { return false; }
            if (!await Schema.SeedRoles(db)) { return false; }
            if (!await Schema.SeedDepartments(db)) { return false; }
            if (!await Schema.SeedDicts(db)) { return false; }
            if (!await Schema.SeedSettings(db)) { return false; }
            if (!await Schema.SeedGame(db)) { return false; }
            return true;
        } finally {
            ctx.Release(db);
        }
    }

    /* 空库创建 bootstrap 账号；密码为开发用，部署前必须修改。*/
    static async bool SeedAdmin(IDbConnection db) {
        UserDao users = new UserDao(db);
        int have = await users.Count();
        if (have > 0) { return true; }
        string salt = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        User admin = new User();
        admin.username = "admin";
        admin.passwordSalt = salt;
        admin.passwordHash = AuthUser.PasswordHash("admin1234", salt);
        admin.nickname = "系统管理员";
        admin.status = AuthUser.Active;
        admin.isSuper = 1;
        admin.tokenVersion = 1;
        admin.createdAt = WebApp.NowSeconds();
        int _id = await users.Insert(admin);
        return _id > 0;
    }

    /* 默认口令上未改时的启动告警（A303 建议 ②）：全量比对 bootstrap
       账号的散列，命中即响亮打印——生产忘改密是真实世界里最常见的
       入侵起点。不做强锁：模板演示预期 admin/admin1234 可登录（报告
       观察项 1 原文），e2e 也依赖它；强锁留给二开按需收紧。 */
    static async void WarnBootstrapPassword() {
        IDbConnection db = await AppServices.Current().Db().Acquire();
        if (db == null) { return; }
        try {
            UserDao users = new UserDao(db);
            User admin = await users.ByUsername("admin");
            if (admin == null) { return; }
            if (AuthUser.PasswordHash("admin1234", admin.passwordSalt)
                == admin.passwordHash) {
                Console.WriteLine("[security] *** 默认口令 admin/admin1234"
                    + " 仍可登录管理后台——生产环境请立即在"
                    + " /admin/system/users 修改！ ***");
            }
        } finally {
            AppServices.Current().Db().Release(db);
        }
    }

    /* 两个内置角色：admin（全部管理）和 gm（仅游戏域）。bootstrap 账号绕过角色表，防止误操作锁死。具体权限由 SyncRoleGrants 从路由表填充。*/
    static async bool SeedRoles(IDbConnection db) {
        int have = await db.Select<Role>().CountAsync();
        if (have > 0) { return true; }
        int _admin = await Schema.AddRole(db, "系统管理员", "admin", 1,
            "除超级管理员外的全部管理权限", DataScope.RoleAll);
        int _gm = await Schema.AddRole(db, "游戏运营", "gm", 10,
            "只管理游戏域：区服、玩家、在线、公告", DataScope.RoleAll);
        return _admin > 0 && _gm > 0;
    }

    static async int AddRole(IDbConnection db, string name, string code, int rank,
                          string description, int dataScope) {
        Role r = new Role();
        r.name = name;
        r.code = code;
        r.rank = rank;
        r.status = 1;
        r.description = description;
        /* 旧行缺此列则读作 0，DataScope 视为 全部数据，升级不缩权。*/
        r.dataScope = dataScope;
        r.scopeDepts = "";
        r.createdAt = WebApp.NowSeconds();
        r.updatedAt = r.createdAt;
        return await db.Insert<Role>(r).ExecuteIdentityAsync();
    }

    static async bool Grant(IDbConnection db, int roleId, string screen, int mask,
                            long now) {
        RoleGrant g = new RoleGrant();
        g.roleId = roleId;
        g.action = screen;
        g.mask = mask;
        g.createdAt = now;
        int _id = await db.Insert<RoleGrant>(g).ExecuteIdentityAsync();
        return _id > 0;
    }

    static async bool SeedDepartments(IDbConnection db) {
        int have = await db.Select<Department>().CountAsync();
        if (have > 0) { return true; }
        if (!await Schema.AddDept(db, 0, "总部", "root", 1)) { return false; }
        if (!await Schema.AddDept(db, 1, "技术部", "tech", 2)) { return false; }
        return await Schema.AddDept(db, 1, "内容运营", "content", 3);
    }

    static async bool AddDept(IDbConnection db, int parentId, string name,
                           string code, int sortOrder) {
        Department d = new Department();
        d.parentId = parentId;
        d.name = name;
        d.code = code;
        d.leaderUserId = 0;
        d.sortOrder = sortOrder;
        d.status = 1;
        int _id = await db.Insert<Department>(d).ExecuteIdentityAsync();
        return _id > 0;
    }

    static async bool SeedDicts(IDbConnection db) {
        int have = await db.Select<DictType>().CountAsync();
        if (have > 0) { return true; }
        if (!await Schema.AddDictType(db, "user_status", "账号状态")) { return false; }
        if (!await Schema.AddDictItem(db, "user_status", "1", "启用", 1)) { return false; }
        if (!await Schema.AddDictItem(db, "user_status", "0", "禁用", 2)) { return false; }
        if (!await Schema.AddDictType(db, "player_status", "玩家状态")) { return false; }
        if (!await Schema.AddDictItem(db, "player_status", "1", "正常", 1)) { return false; }
        return await Schema.AddDictItem(db, "player_status", "0", "封禁", 2);
    }

    static async bool AddDictType(IDbConnection db, string code, string name) {
        DictType t = new DictType();
        t.code = code;
        t.name = name;
        t.status = 1;
        t.description = "";
        t.createdAt = WebApp.NowSeconds();
        t.updatedAt = t.createdAt;
        int _id = await db.Insert<DictType>(t).ExecuteIdentityAsync();
        return _id > 0;
    }

    static async bool AddDictItem(IDbConnection db, string typeCode, string value,
                            string label, int sortOrder) {
        DictItem it = new DictItem();
        it.typeCode = typeCode;
        it.value = value;
        it.label = label;
        it.sortOrder = sortOrder;
        it.status = 1;
        it.createdAt = WebApp.NowSeconds();
        it.updatedAt = it.createdAt;
        int _id = await db.Insert<DictItem>(it).ExecuteIdentityAsync();
        return _id > 0;
    }

    static async bool SeedSettings(IDbConnection db) {
        int have = await db.Select<SiteSetting>().CountAsync();
        if (have > 0) {
            return await Schema.SeedFeatureSettings(db);
        }
        if (!await Schema.AddSetting(db, "基本", "site.title", "站点名称", "Zan",
            "text", "浏览器标题与页脚使用", 1)) { return false; }
        if (!await Schema.AddSetting(db, "基本", "site.subtitle", "副标题",
            "熟悉的语法，原生的速度", "text", "", 2)) { return false; }
        if (!await Schema.AddSetting(db, "基本", "site.description", "站点描述", "",
            "textarea", "写入首页 meta description", 3)) { return false; }
        if (!await Schema.AddSetting(db, "基本", "site.keywords", "关键词", "Zan,编译型语言,ZanWeb",
            "text", "逗号分隔，写入 meta keywords", 4)) { return false; }
        if (!await Schema.AddSetting(db, "备案", "site.icp", "ICP 备案号", "",
            "text", "显示在页脚并链接到工信部查询页", 10)) { return false; }
        if (!await Schema.AddSetting(db, "备案", "site.police", "公安备案号", "",
            "text", "", 11)) { return false; }
        if (!await Schema.AddSetting(db, "页脚", "site.copyright", "版权信息", "",
            "text", "", 20)) { return false; }
        if (!await Schema.AddSetting(db, "页脚", "site.contact", "联系方式", "",
            "text", "", 21)) { return false; }
        if (!await Schema.AddSetting(db, "统计", "site.analytics", "统计代码", "",
            "textarea", "原样输出到页面底部，只接受可信来源的脚本", 30)) { return false; }
        return await Schema.SeedFeatureSettings(db);
    }

    static async bool SeedFeatureSettings(IDbConnection db) {
        if (!await Schema.EnsureSetting(db, "基本", "site.timezone", "时区偏移",
            "480", "text",
            "与 UTC 的分钟偏移，例如 480 表示 UTC+8（北京时间）；服务器在境外时按此换算显示",
            5)) { return false; }
        return true;
    }

    static async bool EnsureSetting(IDbConnection db, string groupName, string name,
                                string label, string value, string kind,
                                string tip, int sortOrder) {
        int have = await db.Select<SiteSetting>().Where(a => a.name == name).CountAsync();
        if (have > 0) { return true; }
        return await Schema.AddSetting(db, groupName, name, label, value, kind, tip, sortOrder);
    }

    static async bool AddSetting(IDbConnection db, string groupName, string name,
                             string label, string value, string kind,
                             string tip, int sortOrder) {
        SiteSetting s = new SiteSetting();
        s.groupName = groupName;
        s.name = name;
        s.label = label;
        s.value = value;
        s.kind = kind;
        s.tip = tip;
        s.sortOrder = sortOrder;
        s.updatedAt = WebApp.NowSeconds();
        int _id = await db.Insert<SiteSetting>(s).ExecuteIdentityAsync();
        return _id > 0;
    }

    /* ---- 游戏域种子 ---- */
    /* 初始区服、地图与一条欢迎公告；带计数保护，重复启动不变。第三区
       以维护态种子化，让客户端列表与 enter 拒绝路径开箱可验证。账号与
       角色不种子化：账号经 /register 或 register 协议注册，角色进区时
       创建。*/
    static async bool SeedGame(IDbConnection db) {
        int realms = await db.Select<Realm>().CountAsync();
        if (realms == 0) {
            if (!await Schema.AddRealm(db, "一区·雷霆之怒", 0, 1)) { return false; }
            if (!await Schema.AddRealm(db, "二区·烈焰天下", 0, 2)) { return false; }
            if (!await Schema.AddRealm(db, "三区·战神殿", 1, 3)) { return false; }
        } else {
            /* 旧库补倍率列：ALTER TABLE 加列后旧行是 NULL，归一到 1.0 倍
               （用 is null 判空，=0 匹配不到 NULL）。 */
            await db.ExecuteAsync("update game_realm set expRate=10000"
                + " where expRate is null or expRate=0");
            await db.ExecuteAsync("update game_realm set goldRate=10000"
                + " where goldRate is null or goldRate=0");
            await db.ExecuteAsync("update game_realm set dropRate=10000"
                + " where dropRate is null or dropRate=0");
        }
        int maps = await db.Select<GameMap>().CountAsync();
        int itemsN = await db.Select<Item>().CountAsync();
        int mobsN = await db.Select<Mob>().CountAsync();
        int dropsN = await db.Select<Drop>().CountAsync();
        if (maps == 0 || itemsN == 0 || mobsN == 0 || dropsN == 0) {
            /* 游戏目录（地图/物品/刷怪点/爆率）整体来自 M2.DB 快照——
               迷你传奇 data.dll 的原值。任一为空都整表重建；快照缺失
               则拒绝启动（空目录开不出来）。 */
            if (!await GameSnapshot.Open("data/M2.DB")) {
                Console.WriteLine("[game] catalog seeds pending but"
                    + " data/M2.DB is missing"
                    + " -- run tools/sync_csv_to_db.py first");
                return false;
            }
            if (!await Schema.SeedMaps(db)) { GameSnapshot.Close(); return false; }
            if (!await Schema.SeedItems(db)) { GameSnapshot.Close(); return false; }
            if (!await Schema.SeedMobs(db)) { GameSnapshot.Close(); return false; }
            if (!await Schema.SeedSkillsFromSnap(db)) { GameSnapshot.Close(); return false; }
            GameSnapshot.Close();
        } else {
            /* 旧库补全：种子期只有 slot/攻/防的库，按快照逐条覆写为
               原值（槽位 + 攻/魔/道/防/魔御区间 + 职业/重量/门槛/
               售价）。按名称命中，空值与非空都写一遍，幂等。 */
            if (itemsN > 0) {
                await GameSnapshot.Open("data/M2.DB");
                DbResult snap = await GameSnapshot.Table("gameitem");
                for (int i = 0; i < snap.RowCount(); i = i + 1) {
                    string nm = GameSnapshot.Str(snap, i, "name");
                    if (nm.Length == 0) { continue; }
                    Item f = Schema.ItemFromSnap(snap, i);
                    await db.Update<Item>()
                        .Set(a => a.slot, f.slot)
                        .Set(a => a.kind, f.kind)
                        .Set(a => a.atk, f.atk)
                        .Set(a => a.atkMin, f.atkMin)
                        .Set(a => a.magic, f.magic)
                        .Set(a => a.magicMin, f.magicMin)
                        .Set(a => a.tao, f.tao)
                        .Set(a => a.taoMin, f.taoMin)
                        .Set(a => a.def, f.def)
                        .Set(a => a.defMin, f.defMin)
                        .Set(a => a.mdef, f.mdef)
                        .Set(a => a.mdefMin, f.mdefMin)
                        .Set(a => a.hp, f.hp)
                        .Set(a => a.mp, f.mp)
                        .Set(a => a.jobNeed, f.jobNeed)
                        .Set(a => a.weight, f.weight)
                        .Set(a => a.minLevel, f.minLevel)
                        .Set(a => a.price, f.price)
                        .Set(a => a.picture, f.picture)
                        .Where(a => a.name == nm)
                        .ExecuteAffrowsAsync();
                }
                /* 老库补 game_map.boss：按图名对上快照 gamemap 的
                   BOSS 怪名，BOSS 链解锁用。幂等。 */
                DbResult gm = await GameSnapshot.Table("gamemap");
                DbResult gmMons = await GameSnapshot.Table("gamemonster");
                List<GameMap> rtMaps = await db.Select<GameMap>().ToListAsync();
                for (int i = 0; i < gm.RowCount(); i = i + 1) {
                    int bossId = GameSnapshot.Int(gm, i, "boss");
                    int brow = Schema.MonsterRow(gmMons, "", bossId);
                    if (brow < 0) { continue; }
                    string snapMap = GameSnapshot.Str(gm, i, "name");
                    string bossName = GameSnapshot.Str(gmMons, brow, "name");
                    for (int k = 0; k < rtMaps.Count; k = k + 1) {
                        if (rtMaps[k].name != snapMap) { continue; }
                        await db.Update<GameMap>()
                            .Set(a => a.boss, bossName)
                            .Where(a => a.id == rtMaps[k].id)
                            .ExecuteAffrowsAsync();
                        break;
                    }
                }
                /* 老库补 game_mob 攻下限/法力/魔防（内页 BOSS 面板展示
                   列）：按名称对快照 gamemonster 原值覆写，幂等。 */
                DbResult gmMons2 = await GameSnapshot.Table("gamemonster");
                for (int i = 0; i < gmMons2.RowCount(); i = i + 1) {
                    string nm = GameSnapshot.Str(gmMons2, i, "name");
                    if (nm.Length == 0) { continue; }
                    await db.Update<Mob>()
                        .Set(a => a.atkMin, GameSnapshot.Int(gmMons2, i, "za1"))
                        .Set(a => a.mp, GameSnapshot.Int(gmMons2, i, "zmp"))
                        .Set(a => a.mdef, GameSnapshot.Int(gmMons2, i, "ze2"))
                        .Where(a => a.name == nm)
                        .ExecuteAffrowsAsync();
                }
                GameSnapshot.Close();
            }
            /* 老库补 BOSS 挑战次数：新列旧行是 NULL/0，归一到每天 20 次。 */
            await db.ExecuteAsync("update game_player set bossTries=20"
                + " where bossTries is null or bossTries=0");
            if (!await Schema.SeedSkills(db)) { return false; }
        }
        int ann = await db.Select<Announce>().CountAsync();
        if (ann == 0) {
            Announce row = new Announce();
            row.title = "欢迎来到 {{NAME}}";
            row.body = "服务器刚刚开区，祝大家游戏愉快。公告由 GM 在后台发布，登录与在线都会收到推送。";
            row.enabled = 1;
            row.author = "system";
            row.createdAt = WebApp.NowSeconds();
            int _id = await db.Insert<Announce>(row).ExecuteIdentityAsync();
            if (_id <= 0) { return false; }
        }
        return true;
    }

    /* ---- 游戏目录种子：全部由 M2.DB 快照驱动，见 GameSnapshot ---- */

    /* 技能：skills 表原值 24 条（三职业各 8：4 主动 + 4 被动，伤害/
       治疗系数、冷却、耗蓝、升级花费全是原值）。快照 id 不保留；
       job 0/1/2 与原表一致。老库补种路径自己开关快照连接。 */
    static async bool SeedSkills(IDbConnection db) {
        int n = await db.Select<Skill>().CountAsync();
        if (n > 0) { return true; }
        if (!await GameSnapshot.Open("data/M2.DB")) { return false; }
        bool ok = await Schema.SeedSkillsFromSnap(db);
        GameSnapshot.Close();
        return ok;
    }

    /* 种子主体：假定快照连接已打开（冷启动路径由 SeedGame 打开）。 */
    static async bool SeedSkillsFromSnap(IDbConnection db) {
        DbResult snap = await GameSnapshot.Table("skills");
        for (int i = 0; i < snap.RowCount(); i = i + 1) {
            string name = GameSnapshot.Str(snap, i, "name");
            if (name.Length == 0) { continue; }
            Skill s = new Skill();
            s.name = name;
            s.job = GameSnapshot.Int(snap, i, "job");
            s.slot = GameSnapshot.Int(snap, i, "slot");
            s.kind = GameSnapshot.Str(snap, i, "kind");
            s.target = GameSnapshot.Str(snap, i, "target");
            s.cooldown = GameSnapshot.Int(snap, i, "cooldown");
            s.mana = GameSnapshot.Int(snap, i, "mana");
            s.damagePct = GameSnapshot.Int(snap, i, "damage_pct");
            s.damagePerLevel = GameSnapshot.Int(snap, i, "damage_per_level");
            s.healPct = GameSnapshot.Int(snap, i, "heal_pct");
            s.healPerLevel = GameSnapshot.Int(snap, i, "heal_per_level");
            s.passiveDamagePct =
                GameSnapshot.Int(snap, i, "passive_damage_pct");
            s.passiveDefensePct =
                GameSnapshot.Int(snap, i, "passive_defense_pct");
            s.maxLevel = GameSnapshot.Int(snap, i, "max_level");
            s.trainGold = GameSnapshot.Long(snap, i, "train_gold");
            s.trainIron = GameSnapshot.Int(snap, i, "train_iron");
            s.school = GameSnapshot.Str(snap, i, "school");
            s.status = 1;
            int _id = await db.Insert<Skill>(s).ExecuteIdentityAsync();
            if (_id <= 0) { return false; }
        }
        return true;
    }

    /* 地图：gamemap 原值（名称/门槛/美术键），sortOrder=快照 id，
       掉落换算按它回查运行时 id。 */
    static async bool SeedMaps(IDbConnection db) {
        int n = await db.Select<GameMap>().CountAsync();
        if (n > 0) { return true; }
        DbResult snap = await GameSnapshot.Table("gamemap");
        DbResult mons = await GameSnapshot.Table("gamemonster");
        for (int i = 0; i < snap.RowCount(); i = i + 1) {
            GameMap m = new GameMap();
            m.name = GameSnapshot.Str(snap, i, "name");
            m.minLevel = GameSnapshot.Int(snap, i, "lvl");
            m.sortOrder = GameSnapshot.Int(snap, i, "id");
            m.picture = GameSnapshot.Str(snap, i, "picture");
            /* BOSS 链：快照 boss 存 gamemonster 行 id，落库存怪名，
               Fight.LoadCatalog 按图+名圈 BOSS 怪。 */
            int bossId = GameSnapshot.Int(snap, i, "boss");
            int brow = Schema.MonsterRow(mons, "", bossId);
            m.boss = brow >= 0
                ? GameSnapshot.Str(mons, brow, "name") : "";
            m.status = 1;
            int _id = await db.Insert<GameMap>(m).ExecuteIdentityAsync();
            if (_id <= 0) { return false; }
        }
        return true;
    }

    /* 物品：gameitem 原值 732 条。快照 id 不保留（自增主键），怪物
       掉落串引用的快照 id 由 SeedMobs 经名称换算。四类归并（kind）：
       消耗→0（hp 原值）、装备·武器→1（atk=上限攻 a2）、装备·其余→2
       （def=d2）、道具/虚拟→3。价格 pirce、门槛 lvl、美术键 picture
       原样带入。data.dll 里没有药水（回复是挂机内置行为），目录即
       原版原味。 */
    /* bclass（原版二级分类）→ 穿戴槽位。非穿戴类回 -1。 */
    static int SlotOfBclass(string bclass) {
        if (bclass == "武器") { return 0; }
        if (bclass == "衣服") { return 1; }
        if (bclass == "头盔") { return 2; }
        if (bclass == "项链") { return 3; }
        if (bclass == "手镯") { return 4; }
        if (bclass == "戒指") { return 6; }
        if (bclass == "腰带") { return 8; }
        if (bclass == "靴子") { return 9; }
        if (bclass == "勋章") { return 10; }
        if (bclass == "宝石") { return 11; }
        return -1;
    }

    /* 快照一行 → 物品模板（全字段）。属性区间攻(a)/魔(b)/道(c)/
       防(d)/魔御(e) 原值全量导入——首饰勋章同样带攻（荣耀戒指
       攻10-35），战斗聚合对全部穿戴位求和。job 列 1战/2法/3道，
       换成与玩家一致的 0战/1法/2道（0=不限）。种子与老库补全共用。 */
    static ZanWeb.Model.Game.Item ItemFromSnap(DbResult snap, int i) {
        string name = GameSnapshot.Str(snap, i, "name");
        string aclass = GameSnapshot.Str(snap, i, "aclass");
        string bclass = GameSnapshot.Str(snap, i, "bclass");
        Item row = new Item();
        row.name = name;
        row.slot = Schema.SlotOfBclass(bclass);
        if (aclass == "消耗") { row.kind = 0; }
        else if (aclass == "装备") { row.kind = bclass == "武器" ? 1 : 2; }
        else { row.kind = 3; }
        row.atk = GameSnapshot.Int(snap, i, "a2");
        row.atkMin = GameSnapshot.Int(snap, i, "a1");
        row.magic = GameSnapshot.Int(snap, i, "b2");
        row.magicMin = GameSnapshot.Int(snap, i, "b1");
        row.tao = GameSnapshot.Int(snap, i, "c2");
        row.taoMin = GameSnapshot.Int(snap, i, "c1");
        row.def = GameSnapshot.Int(snap, i, "d2");
        row.defMin = GameSnapshot.Int(snap, i, "d1");
        row.mdef = GameSnapshot.Int(snap, i, "e2");
        row.mdefMin = GameSnapshot.Int(snap, i, "e1");
        row.hp = GameSnapshot.Int(snap, i, "hp");
        row.mp = GameSnapshot.Int(snap, i, "mp");
        int job = GameSnapshot.Int(snap, i, "job");
        row.jobNeed = job > 0 && job <= 3 ? job - 1 : 0;
        row.weight = GameSnapshot.Int(snap, i, "weight");
        row.price = GameSnapshot.Long(snap, i, "pirce");
        row.minLevel = GameSnapshot.Int(snap, i, "lvl");
        row.picture = GameSnapshot.Str(snap, i, "picture");
        row.status = 1;
        return row;
    }

    static async bool SeedItems(IDbConnection db) {
        int n = await db.Select<Item>().CountAsync();
        if (n > 0) { return true; }
        DbResult snap = await GameSnapshot.Table("gameitem");
        for (int i = 0; i < snap.RowCount(); i = i + 1) {
            if (GameSnapshot.Str(snap, i, "name").Length == 0) { continue; }
            Item row = Schema.ItemFromSnap(snap, i);
            int _id = await db.Insert<Item>(row).ExecuteIdentityAsync();
            if (_id <= 0) { return false; }
        }
        return true;
    }

    /* 刷怪点：结构（哪张图刷哪些怪、BOSS 是谁）完全按 gamemap 的
       present/boss 串重建；数值优先取 gamemonster 原值（data.dll 只
       带 42 只怪的数值：zhp/za2/zd2 → hp/攻/防），没有的按地图门槛
       曲线补齐——补出的数值与原值一样落库，后台可逐条调。掉落取该
       怪（缺则该图）掉落串第一个非消耗项，weight×10 记万分比；经验/
       金币按地图档位 exp、money..money×3（BOSS 经验×5）。 */
    static async bool SeedMobs(IDbConnection db) {
        int n = await db.Select<Mob>().CountAsync();
        if (n > 0) { return true; }
        DbResult mons = await GameSnapshot.Table("gamemonster");
        DbResult maps = await GameSnapshot.Table("gamemap");
        DbResult snapItems = await GameSnapshot.Table("gameitem");
        List<int> snapIds = new List<int>();
        List<string> snapNames = new List<string>();
        List<string> snapClass = new List<string>();
        for (int i = 0; i < snapItems.RowCount(); i = i + 1) {
            snapIds.Add(GameSnapshot.Int(snapItems, i, "id"));
            snapNames.Add(GameSnapshot.Str(snapItems, i, "name"));
            snapClass.Add(GameSnapshot.Str(snapItems, i, "aclass"));
        }
        List<Item> items = await db.Select<Item>().ToListAsync();
        List<GameMap> rtMaps = await db.Select<GameMap>().ToListAsync();
        for (int i = 0; i < maps.RowCount(); i = i + 1) {
            int mapId = Schema.MapIdBySort(rtMaps,
                GameSnapshot.Int(maps, i, "id"));
            if (mapId == 0) { continue; }
            int mapLvl = GameSnapshot.Int(maps, i, "lvl");
            int exp = GameSnapshot.Int(maps, i, "exp");
            long money = GameSnapshot.Long(maps, i, "money");
            string mapDrop = GameSnapshot.Str(maps, i, "item");
            List<string> names = Schema.SplitList(
                GameSnapshot.Str(maps, i, "present"), 124 /* '|' */);
            for (int k = 0; k < names.Count; k = k + 1) {
                if (!await Schema.SeedSpawn(db, mons, snapIds, snapNames,
                        snapClass, items, names[k], mapId, mapLvl,
                        exp, money, mapDrop, false)) { return false; }
            }
            string boss = GameSnapshot.Str(maps, i, "boss");
            if (boss.Length > 0) {
                int bossRow = Schema.MonsterRow(mons, "",
                    Convert.ToInt(boss));
                if (bossRow >= 0 && !await Schema.SeedSpawn(db, mons,
                        snapIds, snapNames, snapClass, items,
                        GameSnapshot.Str(mons, bossRow, "name"), mapId,
                        mapLvl, exp, money, mapDrop, true)) { return false; }
            }
        }
        return true;
    }

    /* 一个刷怪点 = 一行 Mob + 它的爆率清单（game_drop）。gamemonster
       里有原值（zhp>0）就用原值，否则按地图门槛补——合成曲线对齐真怪
       表（稻草人 200hp@2 … 赤月恶魔 3000hp@50）：普通 hp=150+45·lvl
       攻=8+1.8·lvl 防=2+0.9·lvl；BOSS hp=400+42·lvl 攻=10+3·lvl
       防=5+0.8·lvl。 */
    static async bool SeedSpawn(IDbConnection db, DbResult mons,
            List<int> snapIds, List<string> snapNames,
            List<string> snapClass, List<Item> items, string name,
            int mapId, int mapLvl, int exp, long money, string mapDrop,
            bool boss) {
        int row = Schema.MonsterRow(mons, name, 0);
        int lvl = 0;
        int hp = 0;
        int atk = 0;
        int def = 0;
        int atkMin = 0;
        int mp = 0;
        int mdef = 0;
        string picture = "";
        string drops = "";
        if (row >= 0 && GameSnapshot.Int(mons, row, "zhp") > 0) {
            lvl = GameSnapshot.Int(mons, row, "lvl");
            hp = GameSnapshot.Int(mons, row, "zhp");
            atk = Schema.AttrOf(mons, row, "za2", "za1");
            atkMin = GameSnapshot.Int(mons, row, "za1");
            def = Schema.AttrOf(mons, row, "zd2", "zd1");
            mp = GameSnapshot.Int(mons, row, "zmp");
            mdef = GameSnapshot.Int(mons, row, "ze2");
            picture = GameSnapshot.Str(mons, row, "picture");
            drops = GameSnapshot.Str(mons, row, "item");
        }
        if (hp == 0) {
            lvl = mapLvl;
            if (boss) {
                hp = 400 + 42 * mapLvl;
                atk = 10 + 3 * mapLvl;
                def = 5 + 4 * mapLvl / 5;
            } else {
                hp = 150 + 45 * mapLvl;
                atk = 8 + 9 * mapLvl / 5;
                def = 2 + 9 * mapLvl / 10;
            }
            atkMin = atk * 2 / 5;
            mp = 20 + 5 * lvl;
            mdef = def * 3 / 5;
        }
        if (drops.Length == 0) { drops = mapDrop; }
        Mob m = new Mob();
        m.name = name;
        m.mapId = mapId;
        m.level = lvl;
        m.hp = hp;
        m.atk = atk;
        m.atkMin = atkMin;
        m.def = def;
        m.mdef = mdef;
        m.mp = mp;
        m.exp = boss ? exp * 5 : exp;
        m.goldMin = money;
        m.goldMax = money * 3;
        m.respawnSec = boss ? 300 : 10;
        m.count = boss ? 1 : 4;
        m.picture = picture;
        m.status = 1;
        int _id = await db.Insert<Mob>(m).ExecuteIdentityAsync();
        if (_id <= 0) { return false; }
        return await Schema.SeedDrops(db, drops, snapIds, snapNames,
            snapClass, items, _id);
    }

    /* 爆率种子：掉落串 "快照id|数量|?|权重/..." 的全部条目逐条写入
       game_drop（权重×10 = 万分比，封顶 5000；含消耗品——原表就有，
       GM 可在爆率管理页删改）。 */
    static async bool SeedDrops(IDbConnection db, string drops,
            List<int> snapIds, List<string> snapNames,
            List<string> snapClass, List<Item> items, int mobId) {
        List<string> entries = Schema.SplitList(drops, 47 /* '/' */);
        int sort = 0;
        for (int i = 0; i < entries.Count; i = i + 1) {
            List<string> f = Schema.SplitList(entries[i], 124 /* '|' */);
            if (f.Count < 4) { continue; }
            int snapId = Convert.ToInt(f[0]);
            string nm = Schema.SnapAt(snapIds, snapNames, snapId);
            if (nm.Length == 0) { continue; }
            int rtId = Schema.ItemIdByName(items, nm);
            if (rtId == 0) { continue; }
            int rate = Convert.ToInt(f[3]) * 10;
            if (rate <= 0) { continue; }
            if (rate > 5000) { rate = 5000; }
            Drop d = new Drop();
            d.mobId = mobId;
            d.itemId = rtId;
            d.rate = rate;
            d.sort = sort;
            sort = sort + 1;
            int _id = await db.Insert<Drop>(d).ExecuteIdentityAsync();
            if (_id <= 0) { return false; }
        }
        return true;
    }

    /* 按分隔符拆串（sep 传字符码：'|'=124、'/'=47），跳过空段。 */
    static List<string> SplitList(string s, int sep) {
        List<string> parts = new List<string>();
        int start = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            if ((int)s[i] == sep) {
                if (i > start) { parts.Add(s.Substring(start, i - start)); }
                start = i + 1;
            }
        }
        if (start < s.Length) { parts.Add(s.Substring(start)); }
        return parts;
    }

    /* gamemonster 行定位：name 非空按名找（present 串是名字），否则
       按 id 找（图 boss 列存 id）。 */
    static int MonsterRow(DbResult mons, string name, int id) {
        for (int i = 0; i < mons.RowCount(); i = i + 1) {
            if (name.Length > 0) {
                if (GameSnapshot.Str(mons, i, "name") == name) { return i; }
            } else if (GameSnapshot.Int(mons, i, "id") == id) {
                return i;
            }
        }
        return -1;
    }

    /* 主属性取上限列，缺则退下限列（za2→za1 / zd2→zd1）。 */
    static int AttrOf(DbResult mons, int row, string hi, string lo) {
        int v = GameSnapshot.Int(mons, row, hi);
        if (v > 0) { return v; }
        return GameSnapshot.Int(mons, row, lo);
    }

    /* 快照 id → 并列表取值（缺 → 空串）。 */
    static string SnapAt(List<int> ids, List<string> vals, int id) {
        for (int i = 0; i < ids.Count; i = i + 1) {
            if (ids[i] == id) { return vals[i]; }
        }
        return "";
    }

    static int ItemIdByName(List<Item> items, string name) {
        for (int i = 0; i < items.Count; i = i + 1) {
            if (items[i].name == name) { return items[i].id; }
        }
        return 0;
    }

    /* 运行时地图 id：种子把快照 id 写进 sortOrder，按它回查。 */
    static int MapIdBySort(List<GameMap> maps, int sortOrder) {
        for (int i = 0; i < maps.Count; i = i + 1) {
            if (maps[i].sortOrder == sortOrder) { return maps[i].id; }
        }
        return 0;
    }


    static async bool AddRealm(IDbConnection db, string name, int state,
                            int sort) {
        return await Schema.AddRealm(db, name, state, sort, 10000, 10000,
            10000);
    }

    /* 倍率走万分比整型（10000=1.0 倍），种子默认全 1.0 倍。
       分区组：种子全归“永久区”；GM 开新区时在后台改 grp 即分出
       “公测1-10区”这类组（客户端分区窗按组两层展示）。 */
    static async bool AddRealm(IDbConnection db, string name, int state,
                            int sort, int expRate, int goldRate,
                            int dropRate) {
        Realm r = new Realm();
        r.name = name;
        r.grp = "永久区";
        r.state = state;
        r.sort = sort;
        r.expRate = expRate;
        r.goldRate = goldRate;
        r.dropRate = dropRate;
        r.createdAt = WebApp.NowSeconds();
        int _id = await db.Insert<Realm>(r).ExecuteIdentityAsync();
        return _id > 0;
    }

    static async bool AddMap(IDbConnection db, string name, int minLevel,
                          int sortOrder) {
        GameMap m = new GameMap();
        m.name = name;
        m.minLevel = minLevel;
        m.sortOrder = sortOrder;
        m.status = 1;
        int _id = await db.Insert<GameMap>(m).ExecuteIdentityAsync();
        return _id > 0;
    }

    /* ---- 路由派生授权 ---- */
    /* 存在的权限 = 路由表。部署决策写入 sys_role_grant 行。内置 admin 始终覆盖全部管理屏，内置 gm 始终覆盖游戏域屏幕。本方法只 INSERT，操作者撤销的权限不会被重新添加。*/

    /* 将 mask=0 的旧授权行按 screen 合并为一条屏掩码行；仅 mask=0 的行参与，第二次启动起即 no-op。未声明位的 action 丢弃并在 Perm.Index boot 行提示。*/
    static async bool MigrateGrants(IDbConnection db) {
        List<RoleGrant> old = await db.Select<RoleGrant>()
            .Where(a => a.mask == 0).ToListAsync();
        if (old.Count == 0) { return true; }

        List<string> keys = new List<string>();
        List<int> masks = new List<int>();
        for (int i = 0; i < old.Count; i = i + 1) {
            RoleGrant g = old[i];
            int bit = Perm.BitOf(g.action);
            if (bit == 0) { continue; }
            string key = Convert.ToString(g.roleId) + "|"
                + Perm.ScreenOf(g.action);
            int at = keys.IndexOf(key);
            if (at < 0) { keys.Add(key); masks.Add(bit); }
            else { masks[at] = masks[at] | bit; }
        }

        int _gone = await db.Delete<RoleGrant>().Where(a => a.mask == 0)
            .ExecuteAffrowsAsync();
        long now = WebApp.NowSeconds();
        for (int i = 0; i < keys.Count; i = i + 1) {
            string key = keys[i];
            int bar = key.IndexOf("|");
            int roleId = Convert.ToInt32(key.Substring(0, bar));
            string screen = key.Substring(bar + 1);
            RoleGrant have = await db.Select<RoleGrant>()
                .Where(a => a.roleId == roleId && a.action == screen)
                .FirstAsync();
            if (have != null) {
                int merged = have.mask | masks[i];
                int _n = await db.Update<RoleGrant>()
                    .Set(a => a.mask, merged)
                    .Where(a => a.id == have.id).ExecuteAffrowsAsync();
                continue;
            }
            if (!await Schema.Grant(db, roleId, screen, masks[i], now)) { return false; }
        }
        Console.WriteLine("[rbac] 旧授权已合并为 "
            + Convert.ToString(keys.Count) + " 条屏掩码");
        return true;
    }

    /* 将不再存在的旧屏键迁移到带模块前缀的新键；无匹配或多匹配的不动并在日志中标出。*/
    static async bool MigrateGrantKeys(IDbConnection db) {
        List<RoleGrant> rows = await db.Select<RoleGrant>()
            .Where(a => a.mask != 0).ToListAsync();
        int moved = 0;
        List<string> stray = new List<string>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            RoleGrant g = rows[i];
            if (Perm.MaskOf(g.action) != 0) { continue; }
            string now = Perm.Qualify(g.action);
            if (now.Length == 0) { stray.Add(g.action); continue; }
            int gid = g.id;
            int _n = await db.Update<RoleGrant>().Set(a => a.action, now)
                .Where(a => a.id == gid).ExecuteAffrowsAsync();
            moved = moved + 1;
        }
        if (moved > 0) {
            Console.WriteLine("[rbac] " + Convert.ToString(moved)
                + " 条授权已改用带模块前缀的屏键");
        }
        if (stray.Count > 0) {
            Console.WriteLine("[rbac] " + Convert.ToString(stray.Count)
                + " 条授权的屏幕已不存在，保留未动: "
                + Perm.Join(stray, 8));
        }
        return true;
    }

    /* 给内置角色补发尚未持有的受控 action。每次启动安全，永不删除。*/
    static async bool SyncRoleGrants(WebApp app) {
        IDbConnection db = await AuthUser.Lease();
        if (db == null) { return false; }
        try {
            if (!await Schema.MigrateGrants(db)) { return false; }
            if (!await Schema.MigrateGrantKeys(db)) { return false; }
            Role admin = await db.Select<Role>()
                .Where(a => a.code == "admin").FirstAsync();
            Role gm = await db.Select<Role>()
                .Where(a => a.code == "gm").FirstAsync();
            if (admin == null && gm == null) { return true; }

            List<RoleGrant> rows = await db.Select<RoleGrant>().ToListAsync();
            string adminHas = ",";
            string gmHas = ",";
            for (int i = 0; i < rows.Count; i = i + 1) {
                RoleGrant g = rows[i];
                if (admin != null && g.roleId == admin.id) {
                    adminHas = adminHas + g.action + ",";
                }
                if (gm != null && g.roleId == gm.id) {
                    gmHas = gmHas + g.action + ",";
                }
            }

            bool fillAdmin = admin != null && adminHas == ",";
            bool fillGm = gm != null && gmHas == ",";
            if (!fillAdmin && !fillGm) { return true; }

            long now = WebApp.NowSeconds();
            List<Route> routes = app.router.All();
            List<string> screens = new List<string>();
            List<int> masks = new List<int>();
            List<bool> game = new List<bool>();
            for (int i = 0; i < routes.Count; i = i + 1) {
                Route r = routes[i];
                if (r.action.Length == 0 || !r.needsAuth) { continue; }
                int bit = Perm.BitOf(r.action);
                if (bit == 0) { continue; }
                string screen = Perm.ScreenOf(r.action);
                int at = screens.IndexOf(screen);
                if (at < 0) {
                    screens.Add(screen);
                    masks.Add(bit);
                    game.Add(Schema.IsGame(r.pattern));
                } else {
                    masks[at] = masks[at] | bit;
                    if (Schema.IsGame(r.pattern)) { game[at] = true; }
                }
            }
            for (int i = 0; i < screens.Count; i = i + 1) {
                if (fillAdmin && !await Schema.Grant(db, admin.id, screens[i], masks[i], now)) {
                    return false;
                }
                if (fillGm && game[i] &&
                    !await Schema.Grant(db, gm.id, screens[i], masks[i], now)) {
                    return false;
                }
            }
            return true;
        } finally {
            AuthUser.Give(db);
        }
    }

    static bool IsGame(string pattern) {
        return pattern.StartsWith("/admin/game/");
    }

}
