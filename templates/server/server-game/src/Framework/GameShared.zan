using System;
using System.Diagnostics;
using System.Json;
using System.Net;
using System.Net.Sockets;
using System.Threading;
using System.Web;

namespace ZanWeb.Game;

/* 跨 worker 共享状态：登录令牌、管理端令牌版本缓存、HTTP 会话发号、
   在线计数。多 worker（[worker].count>1）时 HTTP 接入层水平扩，游戏世界
   （会话/tick/战斗/推送连接）固定在 1 号 worker 单写；四张表都是匿名
   共享内存：master 建好，句柄经 ZAN_SHARE_* 下发，worker 继承映射，
   机器上其它进程无法触及。

   count==1（单进程）时同样走这组表：建表者即使用者，所有中继路径被
   WorldHere() 短路为进程内直调，行为与改造前一致。

   控制通道说明：世界类操作（登录会话登记/游戏 op/管理写动作）经世界
   进程的环回 TCP 控制通道执行（GatewayWorker 同构）：世界进程在
   127.0.0.1 上从 HTTP 端口+1 起扫描第一个空闲端口监听，实际端口写进
   sys 表供其它进程发现；请求与应答都是一行紧凑 JSON + '\n'（ToJson
   不产换行，可安全分帧）。每请求一条短连接、进程间无共享连接状态，
   一次往返约 0.1-0.3ms（替换原 ops 表 2ms 轮询的 2-6ms）。世界重启
   换端口后，调用方连接失败即失效端口缓存重新发现。 */
class GameShared {
    /* 句柄在 master 与 worker 之间传递所用的名字（ZAN_SHARE_<name>）。 */
    static const string ShareTokens = "GAME_TOKENS";
    static const string ShareAuth = "GAME_AUTH";
    static const string ShareSys = "GAME_SYS";
    static const string ShareOnline = "GAME_ONLINE";

    static SharedTable tokens = null;
    static SharedTable auth = null;
    static SharedTable sys = null;
    static SharedTable online = null;

    /* 控制通道（环回 TCP）：端口发现缓存、超时与帧上限。 */
    static int rpcPort = 0;
    static int RpcConnectMs = 1000;
    static int RpcTimeoutMs = 8000;
    static int RpcMaxFrame = 1048576;

    static bool opened = false;
    /* 本进程是否世界权威（tick/会话/推送连接所在地）。 */
    static bool worldRole = false;

    /* HTTP 会话 cid 的起始段：与 TCP 连接 id（小整数）永不重叠。 */
    static long HttpCidBase = 1000000000;

    /* 登录令牌有效期（与 TokenBox 同源，10 天）。 */
    static long TokenTtlMs = 864000000;
    /* 管理端令牌版本缓存 TTL（与 AuthUser.VerTtlSec 同源）。 */
    static long AuthTtlMs = 30000;

    /* master/worker 双侧初始化：worker 侧映射 master 下发的四张表，
     * 缺一即不可用（调用方走进程内回退或明确报错）；master/单进程侧
     * 创建匿名表并登记句柄。必须在 Worker.RunAll 之前调用。 */
    static bool Open() {
        GameShared.worldRole = Cfg.Worker.count <= 1
            || ProcessHost.WorkerId() == 1;
        long ht = Worker.InheritedHandle(GameShared.ShareTokens);
        long ha = Worker.InheritedHandle(GameShared.ShareAuth);
        long hs = Worker.InheritedHandle(GameShared.ShareSys);
        long ho = Worker.InheritedHandle(GameShared.ShareOnline);
        if (ht != 0 || ha != 0 || hs != 0 || ho != 0) {
            SharedTable t = SharedTable.Attach(ht);
            SharedTable a = SharedTable.Attach(ha);
            SharedTable s = SharedTable.Attach(hs);
            SharedTable o = SharedTable.Attach(ho);
            if (!t.IsOpen() || !a.IsOpen() || !s.IsOpen() || !o.IsOpen()) {
                return false;
            }
            t.Label("game tokens");
            a.Label("game auth ver");
            s.Label("game sys");
            o.Label("game online");
            GameShared.tokens = t;
            GameShared.auth = a;
            GameShared.sys = s;
            GameShared.online = o;
            GameShared.opened = true;
            return true;
        }

        /* tokens 容量要按「峰值日登录数 × TTL 天数」给足：表满了
           SetInt 会静默失败，之后签出的 token 全都解析不到（实测
           8192 容量在数小时压测内就被打穿）。131072 ≈ 1.3 万日登录
           × 10 天，行宽 ~100B，共享段约 13MB。每账号另有一行账号
           索引（"a<id>" → cur 列存最新 token，供重登吊销），与
           token 行同表同 TTL——容量账含它，无需另开。 */
        SharedTable nt = new SharedTable("", 131072);
        nt.KeySize(40);
        nt.ColumnInt("acc");
        nt.ColumnString("cur", 40);
        if (!nt.CreateAnonymous()) { return false; }
        nt.Label("game tokens");

        SharedTable na = new SharedTable("", 1024);
        na.KeySize(40);
        na.ColumnInt("ver");
        if (!na.CreateAnonymous()) { return false; }
        na.Label("game auth ver");

        SharedTable ns = new SharedTable("", 16);
        ns.KeySize(16);
        ns.ColumnInt("v");
        if (!ns.CreateAnonymous()) { return false; }
        ns.Label("game sys");
        /* 发号段种子：worker 侧只 Increment，不重置。控制通道端口由
           世界进程启动后写进 "rpc" 行。 */
        bool _c = ns.SetInt("cid", "v", GameShared.HttpCidBase);

        SharedTable no = new SharedTable("", 256);
        no.KeySize(24);
        no.ColumnInt("n");
        if (!no.CreateAnonymous()) { return false; }
        no.Label("game online");

        Worker.ShareHandle(GameShared.ShareTokens, nt.OsHandle());
        Worker.ShareHandle(GameShared.ShareAuth, na.OsHandle());
        Worker.ShareHandle(GameShared.ShareSys, ns.OsHandle());
        Worker.ShareHandle(GameShared.ShareOnline, no.OsHandle());
        GameShared.tokens = nt;
        GameShared.auth = na;
        GameShared.sys = ns;
        GameShared.online = no;
        GameShared.opened = true;
        return true;
    }

    static bool Ready() {
        return GameShared.opened;
    }

    /* 本进程是否直接持有游戏世界：单进程恒真；多 worker 时只在 1 号
     * worker。世界类操作（世界 op/管理页写动作/登录会话登记）非本角色
     * 时必须走 WorldCall 中继。 */
    static bool WorldHere() {
        return GameShared.opened && GameShared.worldRole;
    }

    /* ---- 登录令牌（TokenBox 的存储层）----

       两行一账：token 行（键=token，acc 列=账号 id）供 token→账号
       反查；账号索引行（键="a<accountId>"，cur 列=最新 token）供
       「重登吊销旧 token」——Resolve 时 token 行查到的账号，其索引
       行不是本 token 即视为已作废。索引行与 token 行同 TTL，账号
       停止登录后一并过期回收。 */

    /* 写入失败（表满/共享内存不可用）返回 false：调用方必须让登录
       响亮失败，绝不能把一个解析不到的 token 发给客户端。 */
    static bool TokenPut(string token, int accountId) {
        if (!GameShared.Ready()) { return false; }
        if (!GameShared.tokens.SetInt(token, "acc", accountId)) { return false; }
        if (!GameShared.tokens.Expire(token, GameShared.TokenTtlMs)) {
            return false;
        }
        /* 覆写账号索引 = 吊销该账号此前的所有 token。 */
        if (!GameShared.tokens.SetString("a" + Convert.ToString(accountId),
                "cur", token)) {
            return false;
        }
        return GameShared.tokens.Expire(
            "a" + Convert.ToString(accountId), GameShared.TokenTtlMs);
    }

    /* 该账号当前有效的 token（账号索引行）；未签发过返回 ""。 */
    static string TokenCurrent(int accountId) {
        if (!GameShared.Ready()) { return ""; }
        string key = "a" + Convert.ToString(accountId);
        if (!GameShared.tokens.Exists(key)) { return ""; }
        return GameShared.tokens.GetString(key, "cur");
    }

    /* 命中返回账号 id；未知/已过期（表 TTL 回收）返回 0。 */
    static int TokenGet(string token) {
        if (!GameShared.Ready()) { return 0; }
        if (!GameShared.tokens.Exists(token)) { return 0; }
        return (int)GameShared.tokens.GetInt(token, "acc");
    }

    static void TokenDrop(string token) {
        if (!GameShared.Ready()) { return; }
        bool _d = GameShared.tokens.Delete(token);
    }

    /* ---- 管理端令牌版本缓存（AuthUser 的存储层）---- */

    /* 未命中返回 -1（调用方回源数据库）。 */
    static int AuthGet(string uid) {
        if (!GameShared.Ready()) { return -1; }
        if (!GameShared.auth.Exists(uid)) { return -1; }
        return (int)GameShared.auth.GetInt(uid, "ver");
    }

    static void AuthPut(string uid, int version) {
        if (!GameShared.Ready()) { return; }
        bool _s = GameShared.auth.SetInt(uid, "ver", version);
        bool _e = GameShared.auth.Expire(uid, GameShared.AuthTtlMs);
    }

    static void AuthDrop(string uid) {
        if (!GameShared.Ready()) { return; }
        bool _d = GameShared.auth.Delete(uid);
    }

    static void AuthClear() {
        if (!GameShared.Ready()) { return; }
        GameShared.auth.Clear();
    }

    /* ---- HTTP 会话发号（原 Gateway.httpCid）---- */

    static int NextHttpCid() {
        if (!GameShared.Ready()) { return 0; }
        return (int)GameShared.sys.Increment("cid", "v", 1);
    }

    /* ---- 在线计数（世界进程维护，各进程可读）----
     *
     * 行布局：total=在世界中的会话数；r<realmId>=各区在线；p<playerId>=1
     * 表示角色在线。写侧只在进区/退区/离开三个语义点增减，读侧供
     * 心跳、区服列表、管理页展示，不再遍历会话。 */

    static void OnlineEnter(int realmId, int playerId) {
        if (!GameShared.Ready()) { return; }
        long _t = GameShared.online.Increment("total", "n", 1);
        long _r = GameShared.online.Increment("r" + Convert.ToString(realmId),
            "n", 1);
        bool _p = GameShared.online.SetInt("p" + Convert.ToString(playerId),
            "n", 1);
    }

    static void OnlineExit(int realmId, int playerId) {
        if (!GameShared.Ready()) { return; }
        GameShared.DecFloor("total");
        GameShared.DecFloor("r" + Convert.ToString(realmId));
        bool _d = GameShared.online.Delete("p" + Convert.ToString(playerId));
    }

    static void DecFloor(string key) {
        long n = GameShared.online.Increment(key, "n", -1);
        if (n < 0) { bool _f = GameShared.online.SetInt(key, "n", 0); }
    }

    static long OnlineTotal() {
        if (!GameShared.Ready()) { return World.OnlineCount(); }
        return GameShared.online.GetInt("total", "n");
    }

    static long OnlineRealm(int realmId) {
        if (!GameShared.Ready()) { return World.RealmOnline(realmId); }
        return GameShared.online.GetInt("r" + Convert.ToString(realmId), "n");
    }

    static bool PlayerOnline(int playerId) {
        if (!GameShared.Ready()) { return World.ByChar(playerId) != null; }
        return GameShared.online.Exists("p" + Convert.ToString(playerId));
    }

    /* ---- 跨进程控制通道（环回 TCP）----
     *
     * 调用方：发现端口 → 连接 → 发一行请求 JSON → 收一行应答 → 断开；
     * 世界进程：RpcLoop 接受连接，ServeConn 逐行 Dispatch 后原连接写回。
     * 请求体里带 rpc 标记区分三类：login=登记登录会话（世界进程做顶号
     * +入表），game=完整游戏 op（token 已由调用方认领并限流），gm=管理
     * 页写动作。协议字段（rpc/acc）只在请求 JSON 一处。 */

    static JsonValue RpcFail(string why) {
        JsonValue r = JsonValue.NewObject();
        r.Set("ok", JsonValue.NewNum("0"));
        r.Set("err", JsonValue.NewStr(why));
        return r;
    }

    static async JsonValue WorldCall(string kind, JsonValue payload,
                                     int accountId) {
        if (!GameShared.Ready()) {
            return GameShared.RpcFail("共享内存不可用，请稍后再试");
        }
        payload.Set("rpc", JsonValue.NewStr(kind));
        payload.Set("acc", JsonValue.NewNum(Convert.ToString(accountId)));
        string resp = await GameShared.RoundTrip(payload.ToJson());
        if (resp == null) {
            return GameShared.RpcFail("世界进程未响应，请稍后再试");
        }
        try {
            JsonValue r = JsonValue.ParseLenient(resp);
            if (r != null && r.IsObject()) { return r; }
        } catch (Exception ex) { }
        return GameShared.RpcFail("世界进程应答异常");
    }

    /* 一次完整的请求-应答。每请求一条短连接：进程间零共享连接状态，
       坏连接/半开连接的影响面只有当次调用。两轮尝试覆盖世界重启换
       端口——首轮失败失效端口缓存，重发现后再试一次。 */
    static async string RoundTrip(string req) {
        for (int attempt = 0; attempt < 2; attempt = attempt + 1) {
            int port = await GameShared.DiscoverRpcPort();
            if (port <= 0) { return null; }
            long t0 = Stopwatch.GetMicroseconds();
            TcpClient c = await TcpClient.ConnectAsync("127.0.0.1", port,
                GameShared.RpcConnectMs, true);
            if (c == null) {
                Console.WriteLine("[gameshared] rpc connect fail port="
                    + Convert.ToString(port) + " attempt="
                    + Convert.ToString(attempt));
                GameShared.rpcPort = 0;
                continue;
            }
            string frame = req + "\n";
            int ns = await c.SendBytesAsync(frame, frame.Length);
            if (ns != frame.Length) {
                /* 部分写=帧被截断，对端永远等不到换行：换新连接重试 */
                Console.WriteLine("[gameshared] rpc short send "
                    + Convert.ToString(ns) + "/"
                    + Convert.ToString(frame.Length));
                c.Close();
                continue;
            }
            string line = await GameShared.RecvLine(c);
            c.Close();
            long dt = Stopwatch.GetMicroseconds() - t0;
            if (line == null) {
                Console.WriteLine("[gameshared] rpc no reply "
                    + Convert.ToString(dt) + "us len="
                    + Convert.ToString(frame.Length) + " attempt="
                    + Convert.ToString(attempt));
                continue;
            }
            if (dt > 200000) {
                Console.WriteLine("[gameshared] rpc slow "
                    + Convert.ToString(dt) + "us len="
                    + Convert.ToString(frame.Length));
            }
            return line;
        }
        return null;
    }

    /* 端口发现：世界进程启动后写 sys 表 "rpc" 行；未写时最多等 2s
       （世界可能还在迁移 schema）。缓存命中不再读表。 */
    static async int DiscoverRpcPort() {
        if (GameShared.rpcPort > 0) { return GameShared.rpcPort; }
        for (int i = 0; i < 100; i = i + 1) {
            if (!GameShared.Ready()) { return 0; }
            int p = (int)GameShared.sys.GetInt("rpc", "v");
            if (p > 0) { GameShared.rpcPort = p; return p; }
            await Task.Delay(20);
        }
        return 0;
    }

    /* 收一行（到 '\n' 为止）。对端先关/超时/超帧上限都返回 null。 */
    static async string RecvLine(TcpClient c) {
        string buf = "";
        while (buf.Length < GameShared.RpcMaxFrame) {
            string chunk = await c.RecvAsync(16384, GameShared.RpcTimeoutMs);
            if (chunk == null || chunk.Length == 0) { return null; }
            buf = buf + chunk;
            int nl = GameShared.IndexOfNl(buf);
            if (nl >= 0) { return buf.Substring(0, nl); }
        }
        return null;
    }

    static int IndexOfNl(string s) {
        for (int i = 0; i < s.Length; i = i + 1) {
            if ((s[i] & 255) == 10) { return i; }
        }
        return -1;
    }

    /* HTTP 登录的世界侧半场：顶号 + 建会话入世界，返回分配的 cid。 */
    static async int CallLogin(int accountId, string username, long now) {
        JsonValue m = JsonValue.NewObject();
        m.Set("user", JsonValue.NewStr(username));
        m.Set("now", JsonValue.NewNum(Convert.ToString(now)));
        JsonValue r = await GameShared.WorldCall("login", m, accountId);
        return r.Int("cid", 0);
    }

    /* 世界进程侧：监听并派发。从 HTTP 端口+1 扫第一个空闲端口（实际
       用哪个写进 sys 表，调用方不关心），每连接一个协程逐行执行。
       count==1 时全部中继路径都是进程内直调，不监听。 */
    static async void RpcLoop() {
        if (Cfg.Worker.count <= 1) { return; }
        int want = Cfg.Server.port + 1;
        TcpListener ln = null;
        for (int i = 0; i < 64 && ln == null; i = i + 1) {
            try {
                ln = TcpListener.CreateAndStart("127.0.0.1", want + i, 64);
                GameShared.rpcPort = want + i;
            } catch (Exception ex) { ln = null; }
        }
        if (ln == null) {
            Console.WriteLine("[gameshared] rpc listen failed"
                + " -- cross-worker relay unavailable");
            return;
        }
        bool _p = GameShared.sys.SetInt("rpc", "v", GameShared.rpcPort);
        Console.WriteLine("[gameshared] rpc on 127.0.0.1:"
            + Convert.ToString(GameShared.rpcPort));
        while (true) {
            nint c = await ln.AcceptAsync();
            if (c < 0) { continue; }
            Task.Spawn(GameShared.ServeConn(c));
        }
    }

    /* 单连接读循环：攒缓冲、切行、按序执行（同一连接严格 FIFO）。
       空闲 8s 或对端关闭即断——配合调用方的每请求短连接，不会有
       长期挂着的半开连接。 */
    static async void ServeConn(nint sock) {
        string buf = "";
        bool alive = true;
        while (alive && buf.Length < GameShared.RpcMaxFrame) {
            string chunk = await Socket.RecvAsync(sock, 16384,
                GameShared.RpcTimeoutMs);
            if (chunk == null || chunk.Length == 0) {
                if (Socket.LastRecvTimedOut()) {
                    Console.WriteLine("[gameshared] serve conn idle timeout"
                        + " (client gone before finish?)");
                }
                break;
            }
            buf = buf + chunk;
            int nl = GameShared.IndexOfNl(buf);
            while (nl >= 0) {
                string line = buf.Substring(0, nl);
                buf = buf.Substring(nl + 1, buf.Length - nl - 1);
                alive = await GameShared.ServeLine(sock, line);
                if (!alive) { break; }
                nl = GameShared.IndexOfNl(buf);
            }
        }
        #if WINDOWS
        Socket.ShutdownBoth(sock);
        #endif
        Socket.Close(sock);
    }

    /* 执行一行请求并把应答写回同一连接。返回 false=写失败或部分写
       （帧被截断，连接不可再用于下一行），读循环应当断开。 */
    static async bool ServeLine(nint sock, string line) {
        long t0 = Stopwatch.GetMicroseconds();
        JsonValue m = null;
        try {
            m = JsonValue.ParseLenient(line);
        } catch (Exception ex) { }
        JsonValue r;
        if (m == null || !m.IsObject()) {
            r = GameShared.RpcFail("请求格式错误");
        } else {
            /* 调用方认领过的账号 id 随请求体携带。 */
            r = await GameShared.Dispatch(m, m.Int("acc", 0));
            if (r == null) { r = GameShared.RpcFail("世界进程处理失败"); }
        }
        string outp = r.ToJson() + "\n";
        int w = await Socket.SendAsync(sock, outp, outp.Length);
        long dt = Stopwatch.GetMicroseconds() - t0;
        if (dt > 200000 || w != outp.Length) {
            Console.WriteLine("[gameshared] serve line len="
                + Convert.ToString(line.Length) + " resp="
                + Convert.ToString(outp.Length) + " sent="
                + Convert.ToString(w) + " "
                + Convert.ToString(dt) + "us");
        }
        return w == outp.Length;
    }

    static async JsonValue Dispatch(JsonValue m, int accountId) {
        string kind = m.Str("rpc", "");
        long now = WebApp.NowSeconds();
        if (kind == "login") {
            int cid = await World.EnsureHttpSession(accountId,
                m.Str("user", ""), now);
            JsonValue r = GameShared.Ok();
            r.Set("cid", JsonValue.NewNum(Convert.ToString(cid)));
            return r;
        }
        if (kind == "game") {
            Session s = World.ByAccount(accountId);
            if (s == null) {
                return GameShared.RpcFail("会话已失效，请重新登录");
            }
            s.lastSeen = now;
            return await Gateway.Op(s, m.Str("gop", ""), m, now, true, 0);
        }
        if (kind == "gm") {
            return await GameShared.Gm(m, now);
        }
        return GameShared.RpcFail("未知的中继请求");
    }

    /* 管理页写动作的世界侧执行：返回 {"ok":0/1[,"n":送达数]}。 */
    static async JsonValue Gm(JsonValue m, long now) {
        string act = m.Str("act", "");
        if (act == "adjust") {
            bool hit = World.Adjust(m.Int("playerId", 0), m.Long("gold", 0),
                m.Long("gems", 0));
            return GameShared.GmOk(hit);
        }
        if (act == "edit") {
            bool hit = World.ApplyEdit(m.Int("playerId", 0), m.Int("level", 0),
                m.Int("job", 0), m.Int("mapId", 0), m.Str("nickname", ""));
            return GameShared.GmOk(hit);
        }
        if (act == "live") {
            JsonValue lv = GameShared.LiveJson(
                World.ByChar(m.Int("playerId", 0)));
            if (lv == null) { return GameShared.GmOk(false); }
            return lv;
        }
        if (act == "saveOnline") {
            /* 页面传来的是绝对目标值：差量在世界侧对着实时内存值算，
               避免页面读到过期的库值把发奖算偏。 */
            bool saved = await GameShared.SaveOnlinePlayer(
                m.Int("playerId", 0), m.Int("level", 0), m.Int("job", 0),
                m.Int("mapId", 0), m.Str("nickname", ""),
                m.Long("gold", 0), m.Long("gems", 0),
                m.Int("giftItem", 0), m.Int("giftCount", 1));
            return GameShared.GmOk(saved);
        }
        if (act == "kick") {
            bool hit = await World.Kick(m.Int("accountId", 0),
                m.Str("reason", ""));
            return GameShared.GmOk(hit);
        }
        if (act == "broadcast") {
            int n = World.Broadcast(m.Str("from", ""), m.Str("text", ""));
            return GameShared.GmOk(true, n);
        }
        if (act == "announce") {
            int n = World.PushAnnounce(m.Str("title", ""), m.Str("body", ""));
            return GameShared.GmOk(true, n);
        }
        if (act == "sessions") {
            return World.SessionsJson();
        }
        return GameShared.RpcFail("未知的管理动作");
    }

    static JsonValue GmOk(bool hit) {
        return GameShared.GmOk(hit, 0);
    }

    static JsonValue GmOk(bool hit, int n) {
        JsonValue r = GameShared.Ok();
        r.Set("hit", JsonValue.NewNum(hit ? "1" : "0"));
        if (n > 0 || n < 0) {
            r.Set("n", JsonValue.NewNum(Convert.ToString(n)));
        }
        return r;
    }

    static JsonValue Ok() {
        JsonValue r = JsonValue.NewObject();
        r.Set("ok", JsonValue.NewNum("1"));
        return r;
    }

    /* ---- 管理页帮手（页面所在进程侧）----
     *
     * 世界角色进程内直调（含 count==1 的单进程），否则经 ops 表中继。
     * 中继失败返回 null/false，页面按"目标不在线/空列表"降级。 */

    /* 在线会话清单；行字段见 World.SessionsJson。 */
    static async JsonValue Sessions() {
        if (!GameShared.Ready()) { return null; }
        if (GameShared.WorldHere()) { return World.SessionsJson(); }
        JsonValue m = JsonValue.NewObject();
        m.Set("act", JsonValue.NewStr("sessions"));
        JsonValue r = await GameShared.WorldCall("gm", m, 0);
        if (r.Int("ok", 0) != 1) { return null; }
        return r;
    }

    /* 在线角色的实时内存值（角色表单展示用）；不在线返回 null。 */
    static async JsonValue LivePlayer(int playerId) {
        if (!GameShared.Ready()) { return null; }
        if (GameShared.WorldHere()) {
            return GameShared.LiveJson(World.ByChar(playerId));
        }
        JsonValue m = JsonValue.NewObject();
        m.Set("act", JsonValue.NewStr("live"));
        m.Set("playerId", JsonValue.NewNum(Convert.ToString(playerId)));
        JsonValue r = await GameShared.WorldCall("gm", m, 0);
        if (r.Int("hit", 0) != 1) { return null; }
        return r;
    }

    static JsonValue LiveJson(Session s) {
        if (s == null || s.row == null) { return null; }
        JsonValue lv = GameShared.Ok();
        lv.Set("hit", JsonValue.NewNum("1"));
        lv.Set("gold", JsonValue.NewNum(Convert.ToString(s.row.gold)));
        lv.Set("gems", JsonValue.NewNum(Convert.ToString(s.row.gems)));
        lv.Set("level", JsonValue.NewNum(Convert.ToString(s.row.level)));
        lv.Set("job", JsonValue.NewNum(Convert.ToString(s.row.job)));
        lv.Set("mapId", JsonValue.NewNum(Convert.ToString(s.row.mapId)));
        lv.Set("realmId", JsonValue.NewNum(Convert.ToString(s.realmId)));
        lv.Set("nickname", JsonValue.NewStr(s.row.nickname));
        return lv;
    }

    /* 保存在线角色（绝对目标值，见 Gm saveOnline）；false=不在线。 */
    static async bool SaveOnlinePlayer(int playerId, int level, int job,
                                       int mapId, string nickname,
                                       long gold, long gems,
                                       int giftItem, int giftCount) {
        if (!GameShared.Ready()) { return false; }
        if (GameShared.WorldHere()) {
            Session s = World.ByChar(playerId);
            if (s == null) { return false; }
            if (gold != s.row.gold || gems != s.row.gems) {
                World.Adjust(s.row.id, gold - s.row.gold, gems - s.row.gems);
            }
            World.ApplyEdit(s.row.id, level, job, mapId, nickname);
            if (giftItem > 0) { Fight.Gift(s, giftItem, giftCount); }
            return true;
        }
        JsonValue m = JsonValue.NewObject();
        m.Set("act", JsonValue.NewStr("saveOnline"));
        m.Set("playerId", JsonValue.NewNum(Convert.ToString(playerId)));
        m.Set("level", JsonValue.NewNum(Convert.ToString(level)));
        m.Set("job", JsonValue.NewNum(Convert.ToString(job)));
        m.Set("mapId", JsonValue.NewNum(Convert.ToString(mapId)));
        m.Set("nickname", JsonValue.NewStr(nickname));
        m.Set("gold", JsonValue.NewNum(Convert.ToString(gold)));
        m.Set("gems", JsonValue.NewNum(Convert.ToString(gems)));
        m.Set("giftItem", JsonValue.NewNum(Convert.ToString(giftItem)));
        m.Set("giftCount", JsonValue.NewNum(Convert.ToString(giftCount)));
        JsonValue r = await GameShared.WorldCall("gm", m, 0);
        return r.Int("hit", 0) == 1;
    }

    /* 踢账号下线；false=不在线或世界不可达。 */
    static async bool GmKick(int accountId, string reason) {
        if (!GameShared.Ready()) { return false; }
        if (GameShared.WorldHere()) {
            return await World.Kick(accountId, reason);
        }
        JsonValue m = JsonValue.NewObject();
        m.Set("act", JsonValue.NewStr("kick"));
        m.Set("accountId", JsonValue.NewNum(Convert.ToString(accountId)));
        m.Set("reason", JsonValue.NewStr(reason));
        JsonValue r = await GameShared.WorldCall("gm", m, 0);
        return r.Int("hit", 0) == 1;
    }

    /* 全服喊话（全部已登录会话）；返回送达数，-1=世界不可达。 */
    static async int GmBroadcast(string from, string text) {
        if (!GameShared.Ready()) { return -1; }
        if (GameShared.WorldHere()) { return World.Broadcast(from, text); }
        JsonValue m = JsonValue.NewObject();
        m.Set("act", JsonValue.NewStr("broadcast"));
        m.Set("from", JsonValue.NewStr(from));
        m.Set("text", JsonValue.NewStr(text));
        JsonValue r = await GameShared.WorldCall("gm", m, 0);
        return r.Int("n", -1);
    }

    /* 全服公告推送；返回送达数，-1=世界不可达。 */
    static async int GmAnnounce(string title, string body) {
        if (!GameShared.Ready()) { return -1; }
        if (GameShared.WorldHere()) { return World.PushAnnounce(title, body); }
        JsonValue m = JsonValue.NewObject();
        m.Set("act", JsonValue.NewStr("announce"));
        m.Set("title", JsonValue.NewStr(title));
        m.Set("body", JsonValue.NewStr(body));
        JsonValue r = await GameShared.WorldCall("gm", m, 0);
        return r.Int("n", -1);
    }
}
