using System;
using System.Collections.Generic;
using System.Security.Cryptography;

namespace ZanWeb.Game;

/* HTTP 登录令牌：token→账号 id 存在 GameShared 的匿名共享表里，任意
   worker 都能认领（多 worker 时登录落在哪个 HTTP worker，之后的游戏
   op 会落在别的 worker 上，也落在重启前的进程外——重启即失效的语义
   不再成立，客户端收到 401 自然重登）。每次登录换新 token（旧 token
   随旧会话一起作废），attach 推送通道、之后所有 /api/game 请求都凭它。
   16 随机字节 = 32 hex，不含有意义内容。过期靠表 TTL 回收，resolve
   只查不扫。 */
class TokenBox {
    /* 10 天：与 web 端登录 cookie 同量级。 */
    static long TtlSeconds = 864000;

    /* 签发新 token：同账号的旧 token 由 GameShared 的账号索引行吊销
       （Issue 覆写该行即作废旧值），resolve 时校验——重登即吊销，
       收掉「旧 token 有效至 10 天 TTL」的窗口（A303 建议 ①）。 */
    static string Issue(int accountId, long now) {
        string token = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        if (!GameShared.TokenPut(token, accountId)) { return ""; }
        return token;
    }

    /* 命中返回账号 id；过期/未知/已被新 token 顶掉返回 0。 */
    static int Resolve(string token, long now) {
        if (token.Length == 0) { return 0; }
        int accountId = GameShared.TokenGet(token);
        if (accountId <= 0) { return 0; }
        /* 账号索引行存最新 token：与本 token 不一致即已被重登吊销。 */
        string cur = GameShared.TokenCurrent(accountId);
        if (cur.Length == 0 || cur != token) { return 0; }
        return accountId;
    }
}
