using System.Data.Orm;
using Zan.Web.Model.Lic;

class AppSchema {
    public static Meta[] Models() {
        return new Meta[] {
            Meta.For<LicenseCode>(),
            Meta.For<LicenseDevice>(),
            Meta.For<LicenseGrant>(),
            Meta.For<LicenseSession>(),
            Meta.For<Product>()
        };
    }
}
