using System.Data.Orm;

namespace Zan.Web.Model.Lic;

/* 已绑定设备：激活/登录成功即 upsert 一行；解绑删除该行后设备可被换新。*/
[Table(Name = "lic_device")]
public class LicenseDevice {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int productId;

    int codeId;

    int grantId;

    [Column(StringLength = 32, IsNullable = false)]
    string deviceFp;

    [Column(StringLength = 64)]
    string subject;

    /* account / code / signed / online——展示用。*/
    [Column(StringLength = 24, IsNullable = false)]
    string mode;

    long createdAt;
}
