using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Lic;
using ZanWeb.Model;

namespace ZanWeb.Admin.Lic;

/* /admin/lic/grants 账号授权管理：给 sys_user 账号发放/调整某产品的授权
 * （期限、设备数、在线座位），也可停用。激活码自动生成的授权行也在此可见。*/
[Route("admin/lic/grants/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("账号授权")]
class Grants : AdminController {
    [HttpGet]
    [Route("/admin/lic/grants")]
    [Custom(IsMenu = true, Icon = "mdi:account-key", Perm = PermBit.View)]
    [Description("账号授权")]
    async void Index() {
        ViewData d = await this.Layout("账号授权");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }

        ListQuery q = this.Paged("id", 20);
        string kw = q.Kw();
        int productId = this.InInt("product", 0);
        List<ZanWeb.Model.Lic.Product> products = await this.Product
            .OrderBy(a => a.id).ToListAsync();
        List<StrMap> popts = d.AddList("products");
        for (int i = 0; i < products.Count; i = i + 1) {
            StrMap o = new StrMap();
            o.Set("id", Convert.ToString(products[i].id));
            o.Set("name", products[i].name);
            if (products[i].id == productId) { o.Set("selected", "selected"); }
            popts.Add(o);
        }
        d.Set("product", Convert.ToString(productId));

        long now = WebApp.NowSeconds();
        int total = await this.LicenseGrant
            .WhereIf(kw.Length > 0, a => a.account.Contains(kw))
            .WhereIf(productId > 0, a => a.productId == productId)
            .CountAsync();
        List<ZanWeb.Model.Lic.LicenseGrant> rows = await this.LicenseGrant
            .WhereIf(kw.Length > 0, a => a.account.Contains(kw))
            .WhereIf(productId > 0, a => a.productId == productId)
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            ZanWeb.Model.Lic.LicenseGrant g = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(g.id));
            row.Set("productName", Grants.ProductName(products, g.productId));
            row.Set("subject", Fmt.Dash(g.account));
            row.Set("durationText", Grants.DurationText(g.durationDays));
            row.Set("expiresText", Grants.ExpiresText(g.expiresAt, now));
            row.Set("expiresClass", Grants.ExpiresClass(g.expiresAt, now));
            row.Set("maxDevices", g.maxDevices == 0 ? "不限"
                : Convert.ToString(g.maxDevices));
            row.Set("maxSeats", g.maxSeats == 0 ? "不限"
                : Convert.ToString(g.maxSeats));
            row.Set("disabledText", g.disabled == 1 ? "停用" : "有效");
            row.Set("disabledClass", g.disabled == 1 ? "off" : "ok");
            row.Set("nextDisabled", g.disabled == 1 ? "0" : "1");
            row.Set("toggleText", g.disabled == 1 ? "启用" : "停用");
            row.Set("sourceText", g.codeId > 0 ? "激活码 " + g.codeTail : "后台发放");
            row.Set("createdAt", Fmt.Day(g.createdAt));
            items.Add(row);
        }
        this.Pager(d, q, total);
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("授权表单")]
    async void Form() {
        if (!this.DbReady()) { this.Fail(503, "2001", "数据库不可用"); }
        int id = this.InInt("id", 0);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("dialogTitle", "发放授权");
        d.Set("durationDays", "365");
        d.Set("maxDevices", "1");
        d.Set("maxSeats", "0");
        List<ZanWeb.Model.Lic.Product> products = await this.Product
            .Where(a => a.status == 1).OrderBy(a => a.id).ToListAsync();
        List<StrMap> popts = d.AddList("products");
        for (int i = 0; i < products.Count; i = i + 1) {
            StrMap o = new StrMap();
            o.Set("id", Convert.ToString(products[i].id));
            o.Set("name", products[i].name + " ("
                + products[i].productId + ")");
            if (i == 0) { o.Set("selected", "selected"); }
            popts.Add(o);
        }
        if (id > 0) {
            ZanWeb.Model.Lic.LicenseGrant g = await this.LicenseGrant
                .Where(a => a.id == id).FirstAsync();
            if (g == null) { this.Fail(404, "0404", "授权不存在"); }
            d.Set("dialogTitle", "调整授权");
            d.Set("account", g.account);
            d.Set("productId", Convert.ToString(g.productId));
            d.Set("durationDays", Convert.ToString(g.durationDays));
            d.Set("maxDevices", Convert.ToString(g.maxDevices));
            d.Set("maxSeats", Convert.ToString(g.maxSeats));
            d.Set("edit", "1");
            if (g.durationDays == 30) { d.Set("is30", "1"); }
            if (g.durationDays == 90) { d.Set("is90", "1"); }
            if (g.durationDays == 365) { d.Set("is365", "1"); }
            if (g.durationDays == 0) { d.Set("isLife", "1"); }
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存授权")]
    async void Save() {
        if (!this.DbReady()) { this.Fail(503, "2001", "数据库不可用"); }
        int id = this.InInt("id", 0);
        int productId = this.InInt("productId", 0);
        int durationDays = this.InInt("durationDays", 0);
        int maxDevices = this.InInt("maxDevices", 0);
        int maxSeats = this.InInt("maxSeats", 0);
        if (maxDevices < 0) { maxDevices = 0; }
        if (maxSeats < 0) { maxSeats = 0; }
        ZanWeb.Model.Lic.Product p = await this.Product
            .Where(a => a.id == productId).FirstAsync();
        if (p == null) { this.Fail(404, "0404", "产品不存在"); }
        long now = WebApp.NowSeconds();

        if (id > 0) {
            ZanWeb.Model.Lic.LicenseGrant have = await this.LicenseGrant
                .Where(a => a.id == id).FirstAsync();
            if (have == null) { this.Fail(404, "0404", "授权不存在"); }
            long expires = durationDays > 0
                ? have.createdAt + (long)durationDays * 86400 : 0;
            int n = await this.LicenseGrant.Update()
                .Set(a => a.durationDays, durationDays)
                .Set(a => a.expiresAt, expires)
                .Set(a => a.maxDevices, maxDevices)
                .Set(a => a.maxSeats, maxSeats)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("调整授权",
                "#" + Convert.ToString(id) + " " + p.productId, n > 0, "");
            this.Saved("授权已调整");
            return;
        }

        string account = this.Need("account", "账号");
        SysUser user = await this.SysUser
            .Where(a => a.username == account).FirstAsync();
        if (user == null) { this.Fail(404, "0404", "账号 " + account + " 不存在"); }
        ZanWeb.Model.Lic.LicenseGrant clash = await this.LicenseGrant
            .Where(a => a.productId == productId && a.userId == user.id)
            .FirstAsync();
        if (clash != null) {
            this.Fail(400, "0004", "该账号已有本产品授权（#" +
                Convert.ToString(clash.id) + "），请调整那一行");
        }
        long expires2 = durationDays > 0 ? now + (long)durationDays * 86400 : 0;
        ZanWeb.Model.Lic.LicenseGrant g = new ZanWeb.Model.Lic.LicenseGrant();
        g.productId = productId;
        g.codeId = 0;
        g.userId = user.id;
        g.account = account;
        g.durationDays = durationDays;
        g.expiresAt = expires2;
        g.maxDevices = maxDevices;
        g.maxSeats = maxSeats;
        g.disabled = 0;
        g.codeTail = "";
        g.note = "后台发放";
        g.createdAt = now;
        int newId = await this.LicenseGrant.Insert(g).ExecuteIdentityAsync();
        await this.Note("发放授权",
            p.productId + " -> " + account, newId > 0, "");
        this.Saved("授权已发放");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("启用或停用授权")]
    async void Status() {
        int id = this.InInt("id", 0);
        int disabled = this.InInt("disabled", 0);
        if (disabled != 0) { disabled = 1; }
        int n = await this.LicenseGrant.Update()
            .Set(a => a.disabled, disabled)
            .Where(a => a.id == id).ExecuteAffrowsAsync();
        await this.Note("启用或停用授权", "#" + Convert.ToString(id),
            n > 0, disabled == 1 ? "停用" : "启用");
        this.Saved(disabled == 1 ? "授权已停用，其会话心跳将被拒绝"
            : "授权已启用");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除授权")]
    async void Delete() {
        int id = this.InInt("id", 0);
        ZanWeb.Model.Lic.LicenseGrant g = await this.LicenseGrant
            .Where(a => a.id == id).FirstAsync();
        if (g == null) { this.Fail(404, "0404", "授权不存在"); }
        int _s = await this.Held().Delete<LicenseSession>()
            .Where(a => a.grantId == id).ExecuteAffrowsAsync();
        int n = await this.Held().Delete<LicenseGrant>()
            .Where(a => a.id == id).ExecuteAffrowsAsync();
        await this.Note("删除授权",
            "#" + Convert.ToString(id) + " " + g.account, n > 0, "");
        this.Saved("授权已删除，其在线会话已一并释放");
    }

    static string ProductName(List<ZanWeb.Model.Lic.Product> products,
                              int productId) {
        for (int i = 0; i < products.Count; i = i + 1) {
            if (products[i].id == productId) { return products[i].name; }
        }
        return "#" + Convert.ToString(productId);
    }

    static string DurationText(int days) {
        if (days == 0) { return "终身"; }
        if (days == 30) { return "按月"; }
        if (days == 90) { return "按季"; }
        if (days == 365) { return "按年"; }
        return Convert.ToString(days) + " 天";
    }

    static string ExpiresText(long expiresAt, long now) {
        if (expiresAt == 0) { return "终身"; }
        if (expiresAt <= now) { return "已过期"; }
        int days = (int)((expiresAt - now) / 86400);
        if (days < 1) { return "不足 1 天"; }
        return "剩 " + Convert.ToString(days) + " 天";
    }

    static string ExpiresClass(long expiresAt, long now) {
        if (expiresAt != 0 && expiresAt <= now) { return "bad"; }
        return "off";
    }
}
