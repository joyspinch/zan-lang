using System;
using System.Data;
using System.Json;
using System.Web;
using Zan.Web;
using Zan.Web.Model.Lic;

namespace Zan.Web.Admin;

/* /admin 仪表盘：授权业务当前状态——产品数、可用激活码、活跃账号授权与在线终端。 */
[Route("admin/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.Login)]
[Description("仪表盘")]
public class Dashboard : AdminController {
    /* 侧边栏条目即此属性——见 AdminController.Layout，向 MenuBuilder 询问该账号可到达的项。 */
    [HttpGet]
    [Route("/admin")]
    [Custom(IsMenu = true, Icon = "mdi:gauge")]
    [Description("仪表盘")]
    async void Index() {
        ViewData d = await this.Layout("仪表盘");

        JsonValue m = JsonValue.ParseLenient(WebHost.Current().MetricsJson());
        JsonValue req = m.Get("requests");
        if (req == null) { req = JsonValue.NewObject(); }

        d.Set("requests", Convert.ToString(req.Long("count", 0)));
        d.Set("errors", Convert.ToString(req.Long("errors", 0)));
        d.Set("avg", Fmt.Dur(req.Long("avg_us", 0)));
        d.Set("uptime", Fmt.Uptime(m.Long("uptime_ms", 0)));

        d.Set("products", "—");
        d.Set("codes", "—");
        d.Set("grants", "—");
        d.Set("online", "—");
        d.Set("devices", "—");
        if (this.DbReady()) {
            long now = WebApp.NowSeconds();
            int products = await this.Product.CountAsync();
            int codes = await this.LicenseCode
                .Where(a => a.status == 1).CountAsync();
            int grants = await this.LicenseGrant
                .Where(a => a.disabled == 0).CountAsync();
            int online = await this.LicenseSession
                .Where(a => a.lastSeen > now - 300).CountAsync();
            int devices = await this.LicenseDevice.CountAsync();
            d.Set("products", Convert.ToString(products));
            d.Set("codes", Convert.ToString(codes));
            d.Set("grants", Convert.ToString(grants));
            d.Set("online", Convert.ToString(online));
            d.Set("devices", Convert.ToString(devices));

            /* 最近激活的终端：运维第一眼看到的"谁在用"。 */
            List<Zan.Web.Model.Lic.LicenseDevice> recent = await this.LicenseDevice
                .OrderByDescending(a => a.id).Take(8).ToListAsync();
            List<StrMap> rows = d.AddList("recent");
            for (int i = 0; i < recent.Count; i = i + 1) {
                Zan.Web.Model.Lic.LicenseDevice dev = recent[i];
                StrMap row = new StrMap();
                row.Set("id", Convert.ToString(dev.id));
                row.Set("subject", Fmt.Dash(dev.subject));
                row.Set("deviceFp", Fmt.Dash(dev.deviceFp));
                row.Set("modeText", Dashboard.ModeText(dev.mode));
                row.Set("createdAt", Fmt.Stamp(dev.createdAt));
                rows.Add(row);
            }
            if (recent.Count == 0) { d.Set("noRecent", "1"); }
        } else {
            d.Set("dbDown", "1");
        }
        this.Page(d);
    }

    static string ModeText(string mode) {
        if (mode == "account") { return "账号"; }
        if (mode == "signed") { return "离线证书"; }
        if (mode == "online") { return "在线"; }
        return "激活码";
    }
}
