using System;
using System.Json;
using System.Web;
using Zan.Web;

namespace Zan.Web.Api;

/* 授权端点：路由 /api/license/activate|login|heartbeat|logout。
 * 请求/响应与 stdlib/System/Commercial/LicenseClient.zan 的契约一一对应：
 * 请求为 JSON 正文（SDK PostJson 发送），统一答 {"code","msg","data"}，
 * data={mode,subject,session,expires_at,grace_seconds}。
 * 全部匿名可调（激活码与账号密码本身就是凭证），ApiMax 限流防爆破。*/
[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("产品授权")]
public class License : ApiController {
    [HttpPost]
    [Custom(ApiMax = 30)]
    [Description("激活码激活")]
    public async void Activate() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        string bodyStr = this.Body();
        if (bodyStr.Length == 0) {
            this.Fail(400, LicenseCodes.BadInput, "bad body");
            return;
        }
        string product = "";
        string code = "";
        string deviceFp = "";
        try {
            JsonDoc.ParseScoped(bodyStr, (JsonDoc doc) => {
                if (doc.KindAt(0) == 5) {
                    product = doc.Str(0, "product", "");
                    code = doc.Str(0, "code", "");
                    deviceFp = doc.Str(0, "device_fp", "");
                }
            });
        } catch (Exception) {
            this.Fail(400, LicenseCodes.BadInput, "bad body");
            return;
        }
        JsonWriter data = new JsonWriter();
        string result = await LicenseFlow.Of(this.Held()).Activate(
            product, code, deviceFp, WebApp.NowSeconds(), data);
        if (result != LicenseCodes.Ok) {
            this.Fail(422, result, License.Reason(result));
            return;
        }
        this.Ok(data.ToJson());
    }

    [HttpPost]
    [Custom(ApiMax = 30)]
    [Description("账号密码登录授权")]
    public async void Login() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        string bodyStr = this.Body();
        if (bodyStr.Length == 0) {
            this.Fail(400, LicenseCodes.BadInput, "bad body");
            return;
        }
        string product = "";
        string account = "";
        string password = "";
        string deviceFp = "";
        try {
            JsonDoc.ParseScoped(bodyStr, (JsonDoc doc) => {
                if (doc.KindAt(0) == 5) {
                    product = doc.Str(0, "product", "");
                    account = doc.Str(0, "account", "");
                    password = doc.Str(0, "password", "");
                    deviceFp = doc.Str(0, "device_fp", "");
                }
            });
        } catch (Exception) {
            this.Fail(400, LicenseCodes.BadInput, "bad body");
            return;
        }
        JsonWriter data = new JsonWriter();
        string result = await LicenseFlow.Of(this.Held()).Login(
            product, account, password, deviceFp,
            WebApp.NowSeconds(), data);
        if (result != LicenseCodes.Ok) {
            this.Fail(422, result, License.Reason(result));
            return;
        }
        this.Ok(data.ToJson());
    }

    [HttpPost]
    [Custom(ApiMax = 120)]
    [Description("会话心跳")]
    public async void Heartbeat() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        string bodyStr = this.Body();
        if (bodyStr.Length == 0) {
            this.Fail(400, LicenseCodes.BadInput, "bad body");
            return;
        }
        string product = "";
        string deviceFp = "";
        string session = "";
        try {
            JsonDoc.ParseScoped(bodyStr, (JsonDoc doc) => {
                if (doc.KindAt(0) == 5) {
                    product = doc.Str(0, "product", "");
                    deviceFp = doc.Str(0, "device_fp", "");
                    session = doc.Str(0, "session", "");
                }
            });
        } catch (Exception) {
            this.Fail(400, LicenseCodes.BadInput, "bad body");
            return;
        }
        JsonWriter data = new JsonWriter();
        string result = await LicenseFlow.Of(this.Held()).Heartbeat(
            product, deviceFp, session, WebApp.NowSeconds(), data);
        if (result != LicenseCodes.Ok) {
            this.Fail(422, result, License.Reason(result));
            return;
        }
        this.Ok(data.ToJson());
    }

    [HttpPost]
    [Custom(ApiMax = 30)]
    [Description("登出并释放座位")]
    public async void Logout() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        string bodyStr = this.Body();
        if (bodyStr.Length == 0) {
            this.Fail(400, LicenseCodes.BadInput, "bad body");
            return;
        }
        string product = "";
        string session = "";
        try {
            JsonDoc.ParseScoped(bodyStr, (JsonDoc doc) => {
                if (doc.KindAt(0) == 5) {
                    product = doc.Str(0, "product", "");
                    session = doc.Str(0, "session", "");
                }
            });
        } catch (Exception) {
            this.Fail(400, LicenseCodes.BadInput, "bad body");
            return;
        }
        string result = await LicenseFlow.Of(this.Held()).Logout(
            product, session, WebApp.NowSeconds());
        if (result != LicenseCodes.Ok) {
            this.Fail(422, result, License.Reason(result));
            return;
        }
        JsonWriter w = new JsonWriter();
        w.StartObject();
        w.WriteProperty("released", true);
        w.EndObject();
        this.Ok(w.ToJson());
    }

    /* 业务码 -> 人话；SDK 会把这句话直接展示给最终用户。*/
    private static string Reason(string code) {
        if (code == LicenseCodes.BadInput) { return "请求参数不完整"; }
        if (code == LicenseCodes.NoProduct) { return "产品不存在或未开放授权"; }
        if (code == LicenseCodes.BadCode) { return "激活码无效"; }
        if (code == LicenseCodes.BadAccount) { return "账号或密码不正确，或该账号没有本产品的授权"; }
        if (code == LicenseCodes.Expired) { return "授权已过期，请续费或更换授权"; }
        if (code == LicenseCodes.DeviceMismatch) { return "设备绑定数已满，请联系服务方解绑后重试"; }
        if (code == LicenseCodes.SeatLimit) { return "在线终端数已达上限，请退出其他设备后再试"; }
        if (code == LicenseCodes.Revoked) { return "授权已被停用"; }
        if (code == LicenseCodes.BadSession) { return "会话无效，请重新激活"; }
        return "授权失败";
    }
}
