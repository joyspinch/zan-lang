using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Lic;

namespace ZanWeb.Dao.Lic;

/* license_session 的数据读写网关 */
class LicenseSessionDao {
    IDbConnection db;

    LicenseSessionDao(IDbConnection db) {
        this.db = db;
    }

    async LicenseSession ById(int id) {
        return await this.db.Select<LicenseSession>().Where(a => a.id == id).FirstAsync();
    }

    async List<LicenseSession> All() {
        return await this.db.Select<LicenseSession>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<LicenseSession>().CountAsync();
    }

    async int Insert(LicenseSession entity) {
        return await this.db.Insert<LicenseSession>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<LicenseSession>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
