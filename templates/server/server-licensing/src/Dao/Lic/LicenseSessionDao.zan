using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Lic;

namespace Zan.Web.Dao.Lic;

/* license_session 的数据读写网关，继承 ZanSql BaseRepository 范式 */
public class LicenseSessionDao : BaseRepository<LicenseSession> {
    public LicenseSessionDao() : base() {}
    LicenseSessionDao(IZanSql fsql) : base(fsql) {}
    LicenseSessionDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async LicenseSession ById(int id) {
        return await this.GetExecutor().Select<LicenseSession>().Where(a => a.id == id).FirstAsync();
    }

    async List<LicenseSession> All() {
        return await this.GetExecutor().Select<LicenseSession>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<LicenseSession>().CountAsync();
    }

    public InsertQuery<LicenseSession> Insert(LicenseSession entity) {
        return this.GetExecutor().Insert<LicenseSession>(entity);
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<LicenseSession>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
