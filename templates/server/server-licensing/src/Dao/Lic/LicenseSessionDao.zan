using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Lic;

namespace ZanWeb.Dao.Lic;

/* license_session 的数据读写网关，继承 FreeSql BaseRepository 范式 */
class LicenseSessionDao : BaseRepository<LicenseSession> {
    LicenseSessionDao(IFreeSql fsql) : base(fsql) {}
    LicenseSessionDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async LicenseSession ById(int id) {
        return await this.GetExecutor().Select<LicenseSession>().Where(a => a.id == id).FirstAsync();
    }

    async List<LicenseSession> All() {
        return await this.GetExecutor().Select<LicenseSession>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<LicenseSession>().CountAsync();
    }

    async int Insert(LicenseSession entity) {
        return await this.GetExecutor().Insert<LicenseSession>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<LicenseSession>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
