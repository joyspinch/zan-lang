using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Lic;

namespace ZanWeb.Dao.Lic;

/* license_code 的数据读写网关，继承 FreeSql BaseRepository 范式 */
class LicenseCodeDao : BaseRepository<LicenseCode> {
    LicenseCodeDao(IFreeSql fsql) : base(fsql) {}
    LicenseCodeDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async LicenseCode ById(int id) {
        return await this.GetExecutor().Select<LicenseCode>().Where(a => a.id == id).FirstAsync();
    }

    async List<LicenseCode> All() {
        return await this.GetExecutor().Select<LicenseCode>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<LicenseCode>().CountAsync();
    }

    async int Insert(LicenseCode entity) {
        return await this.GetExecutor().Insert<LicenseCode>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<LicenseCode>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
