using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Lic;

namespace Zan.Web.Dao.Lic;

/* license_code 的数据读写网关，继承 ZanSql BaseRepository 范式 */
public class LicenseCodeDao : BaseRepository<LicenseCode> {
    public LicenseCodeDao() : base() {}
    LicenseCodeDao(IZanSql fsql) : base(fsql) {}
    LicenseCodeDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async LicenseCode ById(int id) {
        return await this.GetExecutor().Select<LicenseCode>().Where(a => a.id == id).FirstAsync();
    }

    async List<LicenseCode> All() {
        return await this.GetExecutor().Select<LicenseCode>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<LicenseCode>().CountAsync();
    }

    public InsertQuery<LicenseCode> Insert(LicenseCode entity) {
        return this.GetExecutor().Insert<LicenseCode>(entity);
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<LicenseCode>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
