using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Lic;

namespace ZanWeb.Dao.Lic;

/* license_code 的数据读写网关 */
class LicenseCodeDao {
    IDbConnection db;

    LicenseCodeDao(IDbConnection db) {
        this.db = db;
    }

    async LicenseCode ById(int id) {
        return await this.db.Select<LicenseCode>().Where(a => a.id == id).FirstAsync();
    }

    async List<LicenseCode> All() {
        return await this.db.Select<LicenseCode>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<LicenseCode>().CountAsync();
    }

    async int Insert(LicenseCode entity) {
        return await this.db.Insert<LicenseCode>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<LicenseCode>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
