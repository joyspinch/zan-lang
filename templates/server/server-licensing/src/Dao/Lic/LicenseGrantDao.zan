using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Lic;

namespace ZanWeb.Dao.Lic;

/* license_grant 的数据读写网关 */
class LicenseGrantDao {
    IDbConnection db;

    LicenseGrantDao(IDbConnection db) {
        this.db = db;
    }

    async LicenseGrant ById(int id) {
        return await this.db.Select<LicenseGrant>().Where(a => a.id == id).FirstAsync();
    }

    async List<LicenseGrant> All() {
        return await this.db.Select<LicenseGrant>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<LicenseGrant>().CountAsync();
    }

    async int Insert(LicenseGrant entity) {
        return await this.db.Insert<LicenseGrant>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<LicenseGrant>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
