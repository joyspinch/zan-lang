using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Lic;

namespace ZanWeb.Dao.Lic;

/* license_grant 的数据读写网关，继承 FreeSql BaseRepository 范式 */
class LicenseGrantDao : BaseRepository<LicenseGrant> {
    LicenseGrantDao(IFreeSql fsql) : base(fsql) {}
    LicenseGrantDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async LicenseGrant ById(int id) {
        return await this.GetExecutor().Select<LicenseGrant>().Where(a => a.id == id).FirstAsync();
    }

    async List<LicenseGrant> All() {
        return await this.GetExecutor().Select<LicenseGrant>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<LicenseGrant>().CountAsync();
    }

    async int Insert(LicenseGrant entity) {
        return await this.GetExecutor().Insert<LicenseGrant>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<LicenseGrant>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
