using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Lic;

namespace Zan.Web.Dao.Lic;

/* license_grant 的数据读写网关，继承 ZanSql BaseRepository 范式 */
public class LicenseGrantDao : BaseRepository<LicenseGrant> {
    public LicenseGrantDao() : base() {}
    LicenseGrantDao(IZanSql fsql) : base(fsql) {}
    LicenseGrantDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async LicenseGrant ById(int id) {
        return await this.GetExecutor().Select<LicenseGrant>().Where(a => a.id == id).FirstAsync();
    }

    async List<LicenseGrant> All() {
        return await this.GetExecutor().Select<LicenseGrant>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<LicenseGrant>().CountAsync();
    }

    public InsertQuery<LicenseGrant> Insert(LicenseGrant entity) {
        return this.GetExecutor().Insert<LicenseGrant>(entity);
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<LicenseGrant>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
