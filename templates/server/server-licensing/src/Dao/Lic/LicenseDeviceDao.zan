using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Lic;

namespace ZanWeb.Dao.Lic;

/* license_device 的数据读写网关 */
class LicenseDeviceDao {
    IDbConnection db;

    LicenseDeviceDao(IDbConnection db) {
        this.db = db;
    }

    async LicenseDevice ById(int id) {
        return await this.db.Select<LicenseDevice>().Where(a => a.id == id).FirstAsync();
    }

    async List<LicenseDevice> All() {
        return await this.db.Select<LicenseDevice>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<LicenseDevice>().CountAsync();
    }

    async int Insert(LicenseDevice entity) {
        return await this.db.Insert<LicenseDevice>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<LicenseDevice>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
