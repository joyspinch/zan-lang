using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Lic;

namespace ZanWeb.Dao.Lic;

/* license_device 的数据读写网关，继承 FreeSql BaseRepository 范式 */
class LicenseDeviceDao : BaseRepository<LicenseDevice> {
    LicenseDeviceDao(IFreeSql fsql) : base(fsql) {}
    LicenseDeviceDao(IDbConnection db) : base(FreeSql.FromConnection(db)) {}

    async LicenseDevice ById(int id) {
        return await this.GetExecutor().Select<LicenseDevice>().Where(a => a.id == id).FirstAsync();
    }

    async List<LicenseDevice> All() {
        return await this.GetExecutor().Select<LicenseDevice>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<LicenseDevice>().CountAsync();
    }

    async int Insert(LicenseDevice entity) {
        return await this.GetExecutor().Insert<LicenseDevice>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<LicenseDevice>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
