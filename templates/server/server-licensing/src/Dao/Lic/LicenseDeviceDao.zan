using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Lic;

namespace Zan.Web.Dao.Lic;

/* license_device 的数据读写网关，继承 ZanSql BaseRepository 范式 */
public class LicenseDeviceDao : BaseRepository<LicenseDevice> {
    public LicenseDeviceDao() : base() {}
    LicenseDeviceDao(IZanSql fsql) : base(fsql) {}
    LicenseDeviceDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async LicenseDevice ById(int id) {
        return await this.GetExecutor().Select<LicenseDevice>().Where(a => a.id == id).FirstAsync();
    }

    async List<LicenseDevice> All() {
        return await this.GetExecutor().Select<LicenseDevice>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<LicenseDevice>().CountAsync();
    }

    public InsertQuery<LicenseDevice> Insert(LicenseDevice entity) {
        return this.GetExecutor().Insert<LicenseDevice>(entity);
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<LicenseDevice>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
