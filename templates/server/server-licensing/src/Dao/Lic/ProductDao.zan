using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using Zan.Web.Model.Lic;

namespace Zan.Web.Dao.Lic;

/* lic_product 的数据读写网关，继承 ZanSql BaseRepository 范式 */
public class ProductDao : BaseRepository<Product> {
    public ProductDao() : base() {}
    ProductDao(IZanSql fsql) : base(fsql) {}
    ProductDao(IDbConnection db) : base(ZanSql.FromConnection(db)) {}

    async Product ById(int id) {
        return await this.GetExecutor().Select<Product>().Where(a => a.id == id).FirstAsync();
    }

    async List<Product> All() {
        return await this.GetExecutor().Select<Product>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.GetExecutor().Select<Product>().CountAsync();
    }

    async int Insert(Product entity) {
        return await this.GetExecutor().Insert<Product>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.GetExecutor().Delete<Product>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
