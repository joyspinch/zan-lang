using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Lic;

namespace ZanWeb.Dao.Lic;

/* lic_product 的数据读写网关 */
class ProductDao {
    IDbConnection db;

    ProductDao(IDbConnection db) {
        this.db = db;
    }

    async Product ById(int id) {
        return await this.db.Select<Product>().Where(a => a.id == id).FirstAsync();
    }

    async List<Product> All() {
        return await this.db.Select<Product>().OrderBy(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Product>().CountAsync();
    }

    async int Insert(Product entity) {
        return await this.db.Insert<Product>(entity).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<Product>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
