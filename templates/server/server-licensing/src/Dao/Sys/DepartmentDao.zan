using System;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;

namespace ZanWeb.Dao.Sys;

/* sys_department 表数据访问网关：每表一个 DAO，专门负责该表持久化与业务查询 */
class DepartmentDao {
    IDbConnection db;

    DepartmentDao(IDbConnection db) {
        this.db = db;
    }

    async Department ById(int id) {
        return await this.db.Select<Department>().Where(a => a.id == id).FirstAsync();
    }

    async List<Department> All() {
        return await this.db.Select<Department>()
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async List<Department> Scoped(bool byDept, List<int> scopedDepts, bool mine) {
        return await this.db.Select<Department>()
            .WhereIf(byDept, a => scopedDepts.Contains(a.id))
            .WhereIf(mine, a => a.id < 0)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async List<Department> ByParent(int parentId) {
        return await this.db.Select<Department>()
            .Where(a => a.parentId == parentId)
            .OrderBy(a => a.sortOrder)
            .ToListAsync();
    }

    async int Count() {
        return await this.db.Select<Department>().CountAsync();
    }

    async int Insert(Department dept) {
        return await this.db.Insert<Department>(dept).ExecuteIdentityAsync();
    }

    async int UpdateBasic(int id, string name, string code, int parentId, int sortOrder, int status) {
        return await this.db.Update<Department>()
            .Set(a => a.name, name)
            .Set(a => a.code, code)
            .Set(a => a.parentId, parentId)
            .Set(a => a.sortOrder, sortOrder)
            .Set(a => a.status, status)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int Update(Department dept) {
        return await this.UpdateBasic(dept.id, dept.name, dept.code, dept.parentId, dept.sortOrder, dept.status);
    }

    async int Delete(int id) {
        return await this.db.Delete<Department>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
