using System;
using System.Data;
using System.Data.Orm;
using System.Security.Cryptography;
using System.Web;
using ZanWeb.Model.Lic;

namespace ZanWeb;

/* 授权域种子：示例产品 + 两枚示例激活码（月度码 1 台设备 / 终身码）。
   包 (Zan.Mvc) 的 Schema 只种 sys 域，本类在 Schema.Ensure 之后补种，
   幂等（有产品即跳过）。 */
class LicenseSeed {
    /* 幂等入口：main.zan 在 Schema.Ensure 成功后调用（自持连接）。 */
    public static async bool Ensure(IFreeSql fsql) {
        int products = await fsql.Select<Product>().CountAsync();
        if (products > 0) { return true; }
        Product demo = new Product();
        demo.productId = "demo-app";
        demo.name = "示例桌面软件";
        demo.secret = "";
        demo.status = 1;
        demo.note = "模板自带示例；在客户端 SDK 里用 Product(\"demo-app\") 指向它";
        demo.createdAt = WebApp.NowSeconds();
        int pid = await fsql.Insert<Product>(demo).ExecuteIdentityAsync();
        if (pid <= 0) { return false; }
        long now = WebApp.NowSeconds();

        /* 月度码 ZPQ-D1QJ-M8RR-K3SA（按月，1 台设备）；终身码 ETJ-3FGW-HG62-UU1D。*/
        if (!await LicenseSeed.SeedCode(fsql, pid, "ZPQ-D1QJ-M8RR-K3SA", 30, 1, now)) {
            return false;
        }
        return await LicenseSeed.SeedCode(fsql, pid, "ETJ-3FGW-HG62-UU1D", 0, 1, now);
    }

    static async bool SeedCode(IFreeSql fsql, int productId, string text,
                            int durationDays, int maxDevices, long now) {
        LicenseCode c = new LicenseCode();
        c.productId = productId;
        c.codeDigest = Hex.Encode(Sha256.Hash(text, text.Length), 32);
        c.codeTail = text;
        c.durationDays = durationDays;
        c.maxDevices = maxDevices;
        c.status = 1;
        c.redeemed = 0;
        c.redeemedAt = 0;
        c.note = "示例激活码";
        c.createdAt = now;
        int _id = await fsql.Insert<LicenseCode>(c).ExecuteIdentityAsync();
        return _id > 0;
    }
}
