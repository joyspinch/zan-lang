using System;
using System.Data.Orm;
using Zan.Web.Dao.Lic;

namespace Zan.Web.Admin;

public abstract class LicAdminController : AdminController {
    protected ProductDao Product { get { return new ProductDao(this.Held()); } }
    protected LicenseCodeDao LicenseCode { get { return new LicenseCodeDao(this.Held()); } }
    protected LicenseGrantDao LicenseGrant { get { return new LicenseGrantDao(this.Held()); } }
    protected LicenseDeviceDao LicenseDevice { get { return new LicenseDeviceDao(this.Held()); } }
    protected LicenseSessionDao LicenseSession { get { return new LicenseSessionDao(this.Held()); } }
    protected Zan.Web.Dao.SysUserDao SysUser { get { return new Zan.Web.Dao.SysUserDao(this.Held()); } }
}
