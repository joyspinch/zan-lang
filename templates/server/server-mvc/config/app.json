{
  "server": {
    "name": "{{NAME}}",
    "host": "127.0.0.1",
    "port": 8099,
    "maxBodyMB": 2,
    "globalLimitPerSec": 0
  },
  "database": {
    "driver": "sqlite",
    "sqlitePath": "app.db",
    "host": "127.0.0.1",
    "port": 3306,
    "name": "app",
    "user": "root",
    "password": "",
    "poolSize": 8
  },
  "auth": {
    "secret": ""
  },
  "worker": {
    "count": 1,
    "daemon": false
  },
  "log": {
    "access": false,
    "slowMs": 1000
  },
  "metrics": {
    "enabled": true,
    "path": "metrics.db",
    "flushSeconds": 60,
    "flushRows": 2000,
    "keepDays": 30
  },
  "cache": {
    "driver": "redis",
    "redisHost": "127.0.0.1",
    "redisPort": 6379,
    "poolSize": 8,
    "connectTimeoutMs": 3000
  }
}
