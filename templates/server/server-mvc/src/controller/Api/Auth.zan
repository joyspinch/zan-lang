using System;
using ZanWeb;
using System.Web;

namespace ZanWeb.Api;

/// <summary>Authentication endpoints. Routes: /api/auth/login, /api/auth/me.</summary>
[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("认证")]
class Auth : ApiController {
    [HttpPost]
    [Description("登录")]
    void Login() {
        string user = this.In("user");
        string pass = this.In("pass");
        Validator v = Validator.Create();
        v.Require(user, "user");
        v.MaxLen(user, 32, "user");
        v.Require(pass, "pass");
        v.MaxLen(pass, 64, "pass");
        if (!v.Ok()) {
            this.ctx.Status(422, "Unprocessable Entity");
            this.ctx.Api("1003", "validation failed", v.ErrorsJson());
            return;
        }
        if (user == "admin" && pass == "admin") {
            string token = WebHost.Current().sessions.Issue("1", WebApp.NowSeconds());
            this.ctx.SetCookie("zsession", token, 86400);
            this.Ok("{\"token\":\"" + token + "\"}");
        } else {
            this.Fail(401, "1001", "bad credentials");
        }
    }

    [HttpGet]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("当前用户")]
    void Me() {
        this.Ok("{\"uid\":\"" + this.uid + "\"}");
    }
}
