using System;
using ZanWeb;
using System.Web;
using System.Json;

namespace ZanWeb.Api;

/// <summary>Public service status. Route: /api/index/index. A module-local
/// <c>Index</c> distinct from ZanWeb.Index.Index / ZanWeb.Admin.Index.</summary>
[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("服务状态")]
class Index : ApiController {
    [HttpGet]
    [Description("服务状态")]
    void Index() {
        this.Json(WebHost.Current().StatusJson());
    }

    [HttpGet]
    [Description("健康检查")]
    void Ping() {
        JsonValue o = JsonValue.NewObject();
        o.Put("pong", JsonValue.NewNum("1"));
        this.Ok(o.ToJson());
    }
}
