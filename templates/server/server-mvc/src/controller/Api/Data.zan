using System;
using ZanWeb;

namespace ZanWeb.Api;

/// <summary>Data endpoints demonstrating request metadata: rate limit (ApiMax),
/// per-user request lock, and streamed upload. Routes: /api/data/echo,
/// /api/data/gather, and an absolute /upload override.</summary>
[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("数据")]
class Data : ApiController {
    [HttpPost]
    [Custom(ApiMax = 100)]
    [Description("回显")]
    void Echo() {
        string msg = this.In("msg");
        if (msg.Length == 0) { msg = this.Body(); }
        this.Ok("{\"echo\":\"" + JsonStr.Escape(msg) + "\"}");
    }

    [HttpPost]
    [Custom(Authorization = CustomAuthorization.ApiAuth, Lock = "user")]
    [Description("收集数据")]
    void Gather() {
        string payload = this.In("payload");
        if (payload.Length == 0) { payload = this.Body(); }
        this.Ok("{\"uid\":\"" + JsonStr.Escape(this.uid)
            + "\",\"bytes\":" + Convert.ToString(payload.Length) + "}");
    }

    [HttpPost]
    [Route("/upload")]
    [Custom(Authorization = CustomAuthorization.Login, Lock = "user", Upload = true)]
    [Description("上传")]
    void Upload() {
        string path = this.ctx.state.Get("upload_path");
        string size = this.ctx.state.Get("upload_size");
        if (path.Length == 0) {
            this.Fail(400, "1002", "no upload body");
            return;
        }
        this.Ok("{\"path\":\"" + JsonStr.Escape(path)
            + "\",\"bytes\":" + size + "}");
    }
}
