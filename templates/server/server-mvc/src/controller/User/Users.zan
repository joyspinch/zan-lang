using System;
using ZanWeb;

namespace ZanWeb.User;

/// <summary>ORM + cache demo: list users (cached) and show one by route
/// parameter. Routes: /users and /user/{id}.</summary>
[Route("[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("用户")]
class Users : Controller {
    [HttpGet]
    [Route("/users")]
    [Description("用户列表")]
    async void Index() {
        // Async action: awaits the cache lookup so the worker can serve other
        // connections while a shared Redis round-trips (memory cache resolves
        // immediately). The action is awaited by the generated route trampoline.
        string cached = await Cache.GetAsync("users:all");
        if (cached.Length > 0) {
            this.Json("{\"code\":\"0000\",\"msg\":\"ok (cache)\",\"data\":" + cached + "}");
            return;
        }
        if (!User.Ensure()) {
            this.Fail(503, "2001",
                "database not configured -- set [database] in config/app.json");
            return;
        }
        string data = User.AllJson();
        await Cache.SetTtlAsync("users:all", data, 5);
        this.Ok(data);
    }

    [HttpGet]
    [Route("/user/{id}")]
    [Description("用户详情")]
    void Show() {
        string id = this.Param("id");
        this.Ok("{\"id\":\"" + JsonStr.Escape(id)
            + "\",\"name\":\"user-" + JsonStr.Escape(id) + "\"}");
    }
}
