using System;
using ZanWeb;
using System.Web;

namespace ZanWeb.Index;

/// <summary>Landing page. The view follows the controller: View(d) renders
/// Index/View/Index.Index.html (module-qualified view key "Index.Index.Index"),
/// wrapped by the co-located layout. This controller is one of three module-local
/// classes literally named <c>Index</c> (ZanWeb.Index / ZanWeb.Api / ZanWeb.Admin),
/// kept apart by namespace-aware binding.</summary>
[Route("[controller]/[action]")]
[Description("首页")]
class Index : Controller {
    [HttpGet]
    [Route("/")]
    [Description("首页")]
    void Index() {
        ViewData d = ViewData.Create();
        d.Set("title", "{{NAME}}");
        d.Set("message", "Rendered from the in-memory template cache.");
        List<StrMap> items = d.AddList("features");
        StrMap f1 = StrMap.Create();
        f1.Set("name", "Attributes");
        f1.Set("desc", "C#-style [Route]/[Http*]/[Custom] routing");
        items.Add(f1);
        StrMap f2 = StrMap.Create();
        f2.Set("name", "Modules");
        f2.Set("desc", "controllers grouped by folder, views alongside");
        items.Add(f2);
        StrMap f3 = StrMap.Create();
        f3.Set("name", "Namespaces");
        f3.Set("desc", "same-named Index controllers per module");
        items.Add(f3);
        StrMap f4 = StrMap.Create();
        f4.Set("name", "Rich base");
        f4.Set("desc", "per-request instance + auth/login/view helpers");
        items.Add(f4);
        this.View(d);
    }
}
