using System;
using System.Data;
using System.Data.Orm;
using System.Threading;
using System.Web;
using ZanWeb.Model.Sys;

namespace ZanWeb;

/* 共享内存授权表：角色可执行哪些 action、账号持有哪些角色。数据库仍持有 sys_role_grant / sys_user_role / sys_department_role，请求路径读共享内存，零查询。角色整表加载、授权变更时重写；账号按需加载，带短租约过期。*/
class PermTable {
    static string RoleTable = "";
    static string UserTable = "";
    static long UserLeaseMs = 300000;

    static SharedTable roles = null;
    static SharedTable users = null;

    /* 创建或挂载两个共享表，命名空间与 app.SharedName 一致，确保同机多实例互不干扰。*/
    static bool Open(WebApp app) {
        PermTable.RoleTable = app.SharedName("perm.roles");
        PermTable.UserTable = app.SharedName("perm.users");
        SharedTable r = new SharedTable(PermTable.RoleTable, 256);
        r.KeySize(16);
        r.ColumnString("acts", 8192);
        r.ColumnInt("scope");
        r.ColumnString("depts", 255);
        if (!r.Create()) { r = SharedTable.Open(PermTable.RoleTable); }
        if (r == null || !r.IsOpen()) { return false; }
        r.Label("web perm roles");

        SharedTable u = new SharedTable(PermTable.UserTable, 8192);
        u.KeySize(24);
        u.ColumnInt("super");
        u.ColumnString("roles", 192);
        u.ColumnInt("scope");
        u.ColumnString("depts", 1024);
        if (!u.Create()) { u = SharedTable.Open(PermTable.UserTable); }
        if (u == null || !u.IsOpen()) { return false; }
        u.Label("web perm users");

        PermTable.roles = r;
        PermTable.users = u;
        return true;
    }

    static bool Ready() {
        return PermTable.roles != null && PermTable.users != null;
    }

    /* 从数据库重写所有角色掩码。启动时和授权变更后运行。*/
    static async void LoadRoles(IDbConnection db) {
        if (!PermTable.Ready()) { return; }
        List<Role> rows = await db.Select<Role>().ToListAsync();
        List<RoleGrant> grants = await db.Select<RoleGrant>().ToListAsync();
        await PermTable.LoadRoles(rows, grants);
    }

    /* 发布已加载的角色行（Controller 端使用，避免暴露请求连接）。*/
    static async void LoadRoles(List<Role> rows, List<RoleGrant> grants) {
        if (!PermTable.Ready()) { return; }
        if (rows == null) { rows = new List<Role>(); }
        if (grants == null) { grants = new List<RoleGrant>(); }
        PermTable.roles.Clear();
        for (int i = 0; i < rows.Count; i = i + 1) {
            Role r = rows[i];
            if (r.status != 1) { continue; }
            StringBuilder acts = new StringBuilder();
            acts.Append(",");
            for (int j = 0; j < grants.Count; j = j + 1) {
                if (grants[j].roleId != r.id) { continue; }
                if (grants[j].action.Length == 0) { continue; }
                Perm.Append(acts, grants[j].action, grants[j].mask);
            }
            string key = Convert.ToString(r.id);
            bool _ok = PermTable.roles.SetString(key, "acts", acts.ToString());
            bool _s = PermTable.roles.SetInt(key, "scope", r.dataScope);
            string depts = r.scopeDepts;
            if (depts == null) { depts = ""; }
            bool _d = PermTable.roles.SetString(key, "depts", depts);
        }
    }

    static int RoleScope(string roleId) {
        if (!PermTable.Ready()) { return 0; }
        return PermTable.roles.GetInt(roleId, "scope");
    }

    static string RoleDepts(string roleId) {
        if (!PermTable.Ready()) { return ""; }
        return PermTable.roles.GetString(roleId, "depts");
    }

    static bool RolesAllow(string roleIds, string action) {
        if (!PermTable.Ready()) { return false; }
        int bit = Perm.BitOf(action);
        if (bit == 0) { return false; }
        return (PermTable.RolesMask(roleIds, Perm.ScreenOf(action)) & bit) != 0;
    }

    static int RolesMask(string roleIds, string screen) {
        if (!PermTable.Ready() || screen.Length == 0) { return 0; }
        int mask = 0;
        List<string> ids = PermTable.Split(roleIds);
        for (int i = 0; i < ids.Count; i = i + 1) {
            string acts = PermTable.roles.GetString(ids[i], "acts");
            if (acts.Length == 0) { continue; }
            mask = mask | Perm.MaskIn(acts, screen);
        }
        return mask;
    }

    static string UserRoles(string uid) {
        if (!PermTable.Ready()) { return ""; }
        if (!PermTable.users.Exists(uid)) { return ""; }
        if (PermTable.users.GetInt(uid, "super") == 1) { return "*"; }
        return PermTable.users.GetString(uid, "roles");
    }

    static int UserScope(string uid) {
        if (!PermTable.Ready()) { return 0; }
        if (!PermTable.users.Exists(uid)) { return 0; }
        return PermTable.users.GetInt(uid, "scope");
    }

    static string UserDepts(string uid) {
        if (!PermTable.Ready()) { return ""; }
        return PermTable.users.GetString(uid, "depts");
    }

    static void SetUserScope(string uid, int mode, string depts) {
        if (!PermTable.Ready()) { return; }
        bool _m = PermTable.users.SetInt(uid, "scope", mode);
        bool _d = PermTable.users.SetString(uid, "depts", depts);
        bool _e = PermTable.users.Expire(uid, PermTable.UserLeaseMs);
    }

    static void SetUser(string uid, bool isSuper, string roleIds) {
        if (!PermTable.Ready()) { return; }
        bool _s = PermTable.users.SetInt(uid, "super", isSuper ? 1 : 0);
        bool _r = PermTable.users.SetString(uid, "roles", roleIds);
        bool _e = PermTable.users.Expire(uid, PermTable.UserLeaseMs);
    }

    static void Forget(string uid) {
        if (!PermTable.Ready()) { return; }
        bool _d = PermTable.users.Delete(uid);
    }

    static void ForgetAll() {
        if (!PermTable.Ready()) { return; }
        PermTable.users.Clear();
    }

    static List<string> Split(string joined) {
        List<string> outp = new List<string>();
        StringBuilder cur = new StringBuilder();
        for (int i = 0; i <= joined.Length; i = i + 1) {
            if (i == joined.Length || joined.Substring(i, 1) == ",") {
                string one = cur.ToString();
                if (one.Length > 0) { outp.Add(one); }
                cur = new StringBuilder();
            } else {
                cur.Append(joined.Substring(i, 1));
            }
        }
        return outp;
    }
}
