using System;
using System.Data;
using System.Data.Orm;
using System.Threading;
using System.Web;
using ZanWeb.Model.Sys;

namespace ZanWeb;

/// <summary>
/// The authorization tables in shared memory: "what may this role run" and
/// "which roles does this account hold". Both are derived data -- the database
/// still owns sys_role_grant / sys_user_role / sys_department_role -- but the
/// request path reads them out of shared memory, so answering "may this uid run
/// Users.Save?" costs no query and no per-worker duplication: every worker
/// process attaches to the same rows.
///
///   roles:  key "3"  -> acts ",Users:15,Roles:1,"         (screen -> mask)
///                      scope 2, depts ",3,7,"             (data scope)
///   users:  key "42" -> super 0|1, roles ",3,7,"          (expires, reloaded)
///                      scope 2, depts ",3,7,"             (resolved, expanded)
///
/// Roles are loaded whole on boot and rewritten when an operator changes a
/// grant, because there are few of them and every request needs them. Accounts
/// are filled in on first use with a short lease, because there can be millions
/// and only the ones signing in matter.
/// </summary>
class PermTable {
    /// Shared-memory names, filled by Open from the app's scope
    /// ("zan.web.<scope>.perm.roles" / ".perm.users"), so two servers on one
    /// machine never read each other's authorization.
    static string RoleTable = "";
    static string UserTable = "";

    /// How long an account's role set stays in shared memory before it is read
    /// from the database again. A revocation is pushed immediately (Forget), so
    /// this only bounds a change made by another process.
    static long UserLeaseMs = 300000;

    static SharedTable roles = null;
    static SharedTable users = null;

    /// <summary>Creates (or attaches to) both tables, namespaced with the rest
    /// of the app's shared memory. Called once from main before the server
    /// starts; false means shared memory is unavailable and authorization falls
    /// back to querying the database.</summary>
    static bool Open(WebApp app) {
        PermTable.RoleTable = app.SharedName("perm.roles");
        PermTable.UserTable = app.SharedName("perm.users");
        SharedTable r = new SharedTable(PermTable.RoleTable, 256);
        r.KeySize(16);
        r.ColumnString("acts", 8192);
        r.ColumnInt("scope");
        r.ColumnString("depts", 255);
        if (!r.Create()) { r = SharedTable.Open(PermTable.RoleTable); }
        if (r == null || !r.IsOpen()) { return false; }
        r.Label("web perm roles");

        SharedTable u = new SharedTable(PermTable.UserTable, 8192);
        u.KeySize(24);
        u.ColumnInt("super");
        u.ColumnString("roles", 192);
        u.ColumnInt("scope");
        u.ColumnString("depts", 1024);
        if (!u.Create()) { u = SharedTable.Open(PermTable.UserTable); }
        if (u == null || !u.IsOpen()) { return false; }
        u.Label("web perm users");

        PermTable.roles = r;
        PermTable.users = u;
        return true;
    }

    static bool Ready() {
        return PermTable.roles != null && PermTable.users != null;
    }

    /// <summary>Rewrites every role's screen masks from the database. Run on boot
    /// and after an operator changes a role's grants: a role is edited rarely
    /// and read on every request, so it is pushed rather than expired.</summary>
    static async void LoadRoles(IDbConnection db) {
        if (!PermTable.Ready()) { return; }
        List<Role> rows = await db.Select<Role>().ToListAsync();
        List<RoleGrant> grants = await db.Select<RoleGrant>().ToListAsync();
        PermTable.roles.Clear();
        for (int i = 0; i < rows.Count; i = i + 1) {
            Role r = rows[i];
            if (r.status != 1) { continue; }
            StringBuilder acts = new StringBuilder();
            acts.Append(",");
            for (int j = 0; j < grants.Count; j = j + 1) {
                if (grants[j].roleId != r.id) { continue; }
                if (grants[j].action.Length == 0) { continue; }
                Perm.Append(acts, grants[j].action, grants[j].mask);
            }
            string key = Convert.ToString(r.id);
            bool _ok = PermTable.roles.SetString(key, "acts", acts.ToString());
            bool _s = PermTable.roles.SetInt(key, "scope", r.dataScope);
            string depts = r.scopeDepts;
            if (depts == null) { depts = ""; }
            bool _d = PermTable.roles.SetString(key, "depts", depts);
        }
    }

    /// <summary>One role's sys_role.dataScope, 0 when the role is not in shared
    /// memory (disabled, or the table is unavailable).</summary>
    static int RoleScope(string roleId) {
        if (!PermTable.Ready()) { return 0; }
        return PermTable.roles.GetInt(roleId, "scope");
    }

    /// <summary>The departments a dataScope = 5 role names, as ",3,7,".</summary>
    static string RoleDepts(string roleId) {
        if (!PermTable.Ready()) { return ""; }
        return PermTable.roles.GetString(roleId, "depts");
    }

    /// <summary>Whether one of `roleIds` (",3,7,") grants `action`: the bit the
    /// action declared, looked up in that role's mask for the action's screen.
    /// An action that declared no bit (Perm.BitOf == 0) is refused -- a right
    /// nobody can grant is not a right anybody holds.</summary>
    static bool RolesAllow(string roleIds, string action) {
        if (!PermTable.Ready()) { return false; }
        int bit = Perm.BitOf(action);
        if (bit == 0) { return false; }
        return (PermTable.RolesMask(roleIds, Perm.ScreenOf(action)) & bit) != 0;
    }

    /// <summary>Every bit `roleIds` hold on one screen, OR-ed together: what the
    /// dispatcher refuses on and what the screen's buttons are rendered from,
    /// out of the one mask.</summary>
    static int RolesMask(string roleIds, string screen) {
        if (!PermTable.Ready() || screen.Length == 0) { return 0; }
        int mask = 0;
        List<string> ids = PermTable.Split(roleIds);
        for (int i = 0; i < ids.Count; i = i + 1) {
            string acts = PermTable.roles.GetString(ids[i], "acts");
            if (acts.Length == 0) { continue; }
            mask = mask | Perm.MaskIn(acts, screen);
        }
        return mask;
    }

    /// <summary>This account's roles as ",3,7,", or "" when it is not in shared
    /// memory yet (or its lease ran out) and must be read from the database.
    /// "*" means the bootstrap account, which bypasses the role tables.</summary>
    static string UserRoles(string uid) {
        if (!PermTable.Ready()) { return ""; }
        if (!PermTable.users.Exists(uid)) { return ""; }
        if (PermTable.users.GetInt(uid, "super") == 1) { return "*"; }
        return PermTable.users.GetString(uid, "roles");
    }

    /// <summary>This account's resolved data scope (DataScope.All / ByDept /
    /// Self), or 0 when it has not been worked out yet -- the department set is
    /// already expanded, so a request never walks the department tree.</summary>
    static int UserScope(string uid) {
        if (!PermTable.Ready()) { return 0; }
        if (!PermTable.users.Exists(uid)) { return 0; }
        return PermTable.users.GetInt(uid, "scope");
    }

    /// <summary>The departments that scope covers, as ",3,7,".</summary>
    static string UserDepts(string uid) {
        if (!PermTable.Ready()) { return ""; }
        return PermTable.users.GetString(uid, "depts");
    }

    /// <summary>Publishes an account's resolved scope alongside its roles, under
    /// the same lease -- so dropping the account (Forget) drops both.</summary>
    static void SetUserScope(string uid, int mode, string depts) {
        if (!PermTable.Ready()) { return; }
        bool _m = PermTable.users.SetInt(uid, "scope", mode);
        bool _d = PermTable.users.SetString(uid, "depts", depts);
        bool _e = PermTable.users.Expire(uid, PermTable.UserLeaseMs);
    }

    /// <summary>Publishes an account's roles for every worker, with a lease so a
    /// change nobody announced still lands eventually.</summary>
    static void SetUser(string uid, bool isSuper, string roleIds) {
        if (!PermTable.Ready()) { return; }
        bool _s = PermTable.users.SetInt(uid, "super", isSuper ? 1 : 0);
        bool _r = PermTable.users.SetString(uid, "roles", roleIds);
        bool _e = PermTable.users.Expire(uid, PermTable.UserLeaseMs);
    }

    /// <summary>Drops one account, so the next request rereads its roles. Used
    /// after assigning roles, disabling an account or changing its
    /// department.</summary>
    static void Forget(string uid) {
        if (!PermTable.Ready()) { return; }
        bool _d = PermTable.users.Delete(uid);
    }

    /// <summary>Drops every account: for a change that can affect many at once
    /// (a role's grants, a department's roles, a deleted role).</summary>
    static void ForgetAll() {
        if (!PermTable.Ready()) { return; }
        PermTable.users.Clear();
    }

    /// <summary>The non-empty parts of ",3,7," -- the stored form of an id
    /// set.</summary>
    static List<string> Split(string joined) {
        List<string> outp = new List<string>();
        StringBuilder cur = new StringBuilder();
        for (int i = 0; i <= joined.Length; i = i + 1) {
            if (i == joined.Length || joined.Substring(i, 1) == ",") {
                string one = cur.ToString();
                if (one.Length > 0) { outp.Add(one); }
                cur = new StringBuilder();
            } else {
                cur.Append(joined.Substring(i, 1));
            }
        }
        return outp;
    }
}
