using System;

namespace ZanWeb;

/// <summary>
/// Application service root. Db and cache are assembled once in main.zan and
/// injected through the constructor (dependency injection) — no lazy static
/// discovery. The single instance is handed to consumers via <c>Use()</c> at
/// startup and read through <c>Current()</c>, mirroring WebHost.Use/Current.
/// </summary>
class AppServices {
    static AppServices current;

    DbContext db;
    CacheContext cache;

    /// <summary>Injects the database and cache contexts (both built by the
    /// bootstrap from config/app.json).</summary>
    AppServices(DbContext db, CacheContext cache) {
        this.db = db;
        this.cache = cache;
    }

    /// <summary>Installs the assembled services for the whole process.</summary>
    static void Use(AppServices services) {
        AppServices.current = services;
    }

    /// <summary>The injected service root (set once by Use() at startup).</summary>
    static AppServices Current() {
        return AppServices.current;
    }

    DbContext Db() {
        return this.db;
    }

    CacheContext Cache() {
        return this.cache;
    }
}
