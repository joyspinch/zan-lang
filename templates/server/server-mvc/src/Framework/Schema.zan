using System;
using System.Data;
using System.Data.Orm;
using System.Security.Cryptography;
using System.Web;
using ZanWeb.Model.Sys;
using ZanWeb.Model.Blog;
using ZanWeb.Dao.Sys;
using ZanWeb.Dao.Blog;

namespace ZanWeb;

/// <summary>
/// Schema and seed data, applied ONCE at startup by main.zan — never from a
/// request. CodeFirst (SyncStructure) reads the database catalog and issues
/// DDL; doing that per request costs a round trip on every hit and lets two
/// requests race on the same CREATE/ALTER. Entities are listed here explicitly
/// so the set of tables this app owns is one readable list.
/// </summary>
class Schema {
    /// <summary>Creates/updates every table and seeds the first admin. Returns
    /// false when the database is unreachable: the server still starts, and
    /// handlers report the outage instead of the process dying at boot.</summary>
    static async bool Ensure(DbContext ctx) {
        IDbConnection db = await ctx.Acquire();
        if (db == null) { return false; }
        try {
            db.SyncStructure<AuthUserEnt>();
            db.SyncStructure<User>();
            db.SyncStructure<Post>();
            Schema.SeedAdmin(db);
            Schema.SeedPosts(db);
            return true;
        } finally {
            ctx.Release(db);
        }
    }

    static void SeedAdmin(IDbConnection db) {
        UserDao users = new UserDao(db);
        if (users.CountAccounts() > 0) { return; }
        string salt = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        AuthUserEnt admin = new AuthUserEnt();
        admin.username = "admin";
        admin.passwordSalt = salt;
        admin.passwordHash = AuthUser.PasswordHash("admin1234", salt);
        admin.role = "admin";
        admin.status = "active";
        int _id = users.InsertAccount(admin);
    }

    static void SeedPosts(IDbConnection db) {
        PostDao posts = new PostDao(db);
        if (posts.CountPublished() > 0) { return; }
        List<Post> seed = new List<Post> {
            Schema.PostOf("连接是请求级的",
                "一个请求借一条连接（this.Conn()），请求内所有查询复用它，"
                + "动作结束框架自动归还，所以业务代码里没有 Acquire/Release。"
                + "worker 之间、协程之间都不共享连接，事务不会互相串台。", "admin"),
            Schema.PostOf("查询只写在 Dao 里",
                "Controller 取参数管缓存渲染视图，Dao 负责读写"
                + "（new PostDao(await this.Conn()).Recent(20, kw)），Model 就是表结构。"
                + "类型化 ORM 让列名和类型在编译期检查，值一律参数绑定。", "admin"),
            Schema.PostOf("缓存要说清楚存在哪",
                "GetAsync/SetAsync 走 Redis，所有 worker 都看得见；"
                + "LocalGet/LocalSet 只在本进程内存里，别的 worker 看不到。"
                + "名字里就写明白，省得同步写内存、异步读 Redis。", "admin")
        };
        for (int i = 0; i < seed.Count; i = i + 1) {
            int _id = posts.Insert(seed[i]);
        }
    }

    static Post PostOf(string title, string body, string author) {
        Post p = new Post();
        p.title = title;
        p.body = body;
        p.author = author;
        p.published = 1;
        p.createdAt = WebApp.NowSeconds();
        return p;
    }
}
