using System;
using System.Data;
using System.Data.Orm;
using System.Security.Cryptography;
using System.Web;
using ZanWeb.Model.Sys;
using ZanWeb.Model.Blog;
using ZanWeb.Dao.Sys;
using ZanWeb.Dao.Blog;

namespace ZanWeb;

/// <summary>
/// Schema and seed data, applied ONCE at startup by main.zan -- never from a
/// request. CodeFirst (SyncStructure) reads the database catalog and issues
/// DDL; doing that per request costs a round trip on every hit and lets two
/// requests race on the same CREATE/ALTER.
///
/// The seeds are what makes a fresh checkout usable: an administrator, two
/// roles, a department, the site settings and a few articles. Every seed is
/// guarded by a count, so restarting an installed system changes nothing.
///
/// There is no permission seed. The rights that exist are the route table, so
/// a new screen needs no edit here; the only permission data seeded is which
/// route actions the two built-in roles hold (see SyncRoleGrants), and that is
/// read back off the routes themselves.
/// </summary>
class Schema {
    /// <summary>Creates/updates every table and seeds a usable system. Returns
    /// false when the database is unreachable: the server still starts, and
    /// handlers report the outage instead of the process dying at boot.</summary>
    static async bool Ensure(DbContext ctx) {
        IDbConnection db = await ctx.Acquire();
        if (db == null) { return false; }
        try {
            // Every [Table] class in the build, in one call: the compiler
            // knows them all, so a new model needs no line here and no model
            // can be forgotten.
            await db.SyncStructureAllAsync();

            await Schema.SeedAdmin(db);
            await Schema.SeedRoles(db);
            await Schema.SeedDepartments(db);
            await Schema.SeedDicts(db);
            await Schema.SeedSettings(db);
            await Schema.SeedBlog(db);
            return true;
        } finally {
            ctx.Release(db);
        }
    }

    /// <summary>Creates the bootstrap account on an empty database. The
    /// password is a development convenience: change it before this template is
    /// deployed anywhere reachable.</summary>
    static async void SeedAdmin(IDbConnection db) {
        UserDao users = new UserDao(db);
        int have = await users.Count();
        if (have > 0) { return; }
        string salt = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        User admin = new User();
        admin.username = "admin";
        admin.passwordSalt = salt;
        admin.passwordHash = AuthUser.PasswordHash("admin1234", salt);
        admin.nickname = "系统管理员";
        admin.status = AuthUser.Active;
        admin.isSuper = 1;
        admin.tokenVersion = 1;
        admin.createdAt = WebApp.NowSeconds();
        int _id = await users.Insert(admin);
    }

    /// <summary>Two roles that are useful the moment the system starts: one that
    /// can run the whole admin, and one that can only work on content. They are
    /// ordinary rows -- the bootstrap account bypasses them entirely, so the
    /// system is never locked out by an editing accident here. What they may do
    /// is filled in from the route table by SyncRoleGrants.</summary>
    static async void SeedRoles(IDbConnection db) {
        int have = await db.Select<Role>().CountAsync();
        if (have > 0) { return; }
        int _admin = await Schema.AddRole(db, "系统管理员", "admin", 1,
            "除超级管理员外的全部管理权限", DataScope.RoleAll);
        int _editor = await Schema.AddRole(db, "内容编辑", "editor", 10,
            "只能管理博客内容", DataScope.RoleAll);
    }

    static async int AddRole(IDbConnection db, string name, string code, int rank,
                          string description, int dataScope) {
        Role r = new Role();
        r.name = name;
        r.code = code;
        r.rank = rank;
        r.status = 1;
        r.description = description;
        // Which rows a role may read, next to what it may do. A role from before
        // this column existed reads as 0, and DataScope takes that as 全部数据,
        // so an upgrade cannot narrow rights nobody changed.
        r.dataScope = dataScope;
        r.scopeDepts = "";
        r.createdAt = WebApp.NowSeconds();
        r.updatedAt = r.createdAt;
        return await db.Insert<Role>(r).ExecuteIdentityAsync();
    }

    static async void Grant(IDbConnection db, int roleId, string screen, int mask,
                            long now) {
        RoleGrant g = new RoleGrant();
        g.roleId = roleId;
        g.action = screen;
        g.mask = mask;
        g.createdAt = now;
        int _id = await db.Insert<RoleGrant>(g).ExecuteIdentityAsync();
    }

    static async void SeedDepartments(IDbConnection db) {
        int have = await db.Select<Department>().CountAsync();
        if (have > 0) { return; }
        await Schema.AddDept(db, 0, "总部", "root", 1);
        await Schema.AddDept(db, 1, "技术部", "tech", 2);
        await Schema.AddDept(db, 1, "内容运营", "content", 3);
    }

    static async void AddDept(IDbConnection db, int parentId, string name,
                           string code, int sortOrder) {
        Department d = new Department();
        d.parentId = parentId;
        d.name = name;
        d.code = code;
        d.leaderUserId = 0;
        d.sortOrder = sortOrder;
        d.status = 1;
        int _id = await db.Insert<Department>(d).ExecuteIdentityAsync();
    }

    static async void SeedDicts(IDbConnection db) {
        int have = await db.Select<DictType>().CountAsync();
        if (have > 0) { return; }
        await Schema.AddDictType(db, "user_status", "账号状态");
        await Schema.AddDictItem(db, "user_status", "1", "启用", 1);
        await Schema.AddDictItem(db, "user_status", "0", "禁用", 2);
        await Schema.AddDictType(db, "post_status", "文章状态");
        await Schema.AddDictItem(db, "post_status", "1", "已发布", 1);
        await Schema.AddDictItem(db, "post_status", "0", "草稿", 2);
    }

    static async void AddDictType(IDbConnection db, string code, string name) {
        DictType t = new DictType();
        t.code = code;
        t.name = name;
        t.status = 1;
        t.description = "";
        t.createdAt = WebApp.NowSeconds();
        t.updatedAt = t.createdAt;
        int _id = await db.Insert<DictType>(t).ExecuteIdentityAsync();
    }

    static async void AddDictItem(IDbConnection db, string typeCode, string value,
                               string label, int sortOrder) {
        DictItem it = new DictItem();
        it.typeCode = typeCode;
        it.value = value;
        it.label = label;
        it.sortOrder = sortOrder;
        it.status = 1;
        it.createdAt = WebApp.NowSeconds();
        it.updatedAt = it.createdAt;
        int _id = await db.Insert<DictItem>(it).ExecuteIdentityAsync();
    }

    /// <summary>The fields the settings screen edits. The rows carry their own
    /// label, kind and order, so adding a setting is one line here and it
    /// appears in the admin -- there is no second list of form fields.</summary>
    static async void SeedSettings(IDbConnection db) {
        int have = await db.Select<SiteSetting>().CountAsync();
        if (have > 0) {
            await Schema.SeedFeatureSettings(db);
            return;
        }
        await Schema.AddSetting(db, "基本", "site.title", "站点名称", "Zan",
            "text", "浏览器标题与页脚使用", 1);
        await Schema.AddSetting(db, "基本", "site.subtitle", "副标题",
            "熟悉的语法，原生的速度", "text", "", 2);
        await Schema.AddSetting(db, "基本", "site.description", "站点描述", "",
            "textarea", "写入首页 meta description", 3);
        await Schema.AddSetting(db, "基本", "site.keywords", "关键词", "Zan,编译型语言,ZanWeb",
            "text", "逗号分隔，写入 meta keywords", 4);
        await Schema.AddSetting(db, "备案", "site.icp", "ICP 备案号", "",
            "text", "显示在页脚并链接到工信部查询页", 10);
        await Schema.AddSetting(db, "备案", "site.police", "公安备案号", "",
            "text", "", 11);
        await Schema.AddSetting(db, "页脚", "site.copyright", "版权信息", "",
            "text", "", 20);
        await Schema.AddSetting(db, "页脚", "site.contact", "联系方式", "",
            "text", "", 21);
        await Schema.AddSetting(db, "统计", "site.analytics", "统计代码", "",
            "textarea", "原样输出到页面底部，只接受可信来源的脚本", 30);
        await Schema.SeedFeatureSettings(db);
    }

