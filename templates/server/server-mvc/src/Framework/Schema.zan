    static async void EnsureSetting(IDbConnection db, string groupName, string name,
                                 string label, string value, string kind,
                                 string tip, int sortOrder) {
        int have = await db.Select<SiteSetting>().Where(a => a.name == name).CountAsync();
        if (have > 0) { return; }
        await Schema.AddSetting(db, groupName, name, label, value, kind, tip, sortOrder);
    }

    static async void AddSetting(IDbConnection db, string groupName, string name,
                              string label, string value, string kind,
                              string tip, int sortOrder) {
        SiteSetting s = new SiteSetting();
        s.groupName = groupName;
        s.name = name;
        s.label = label;
        s.value = value;
        s.kind = kind;
        s.tip = tip;
        s.sortOrder = sortOrder;
        s.updatedAt = WebApp.NowSeconds();
        int _id = await db.Insert<SiteSetting>(s).ExecuteIdentityAsync();
    }

    static async void SeedBlog(IDbConnection db) {
        int cats = await db.Select<Category>().CountAsync();
        if (cats == 0) {
            await Schema.AddCategory(db, "语言设计", "language", 1);
            await Schema.AddCategory(db, "服务端", "server", 2);
            await Schema.AddCategory(db, "工程实践", "practice", 3);
        }
        PostDao posts = new PostDao(db);
        int published = await posts.CountPublished();
        if (published > 0) { return; }
        List<Post> seed = new List<Post> {
            Schema.PostOf("Zan 是什么：熟悉的语法，原生的产物", 1,
                "zan,llvm,arc", 1,
                "C# 的写法，AOT 的产物：一份源码经 LLVM 直接生成机器码，"
                + "运行时不需要虚拟机，内存由编译期插入的引用计数管理。",
                "Zan 想解决的问题很具体：写业务的人希望要类、接口、泛型、"
                + "属性和 async/await 这些顺手的东西，交付的人希望拿到一个可以直接跑的"
                + "可执行文件，而不是一套需要先装运行时的环境。\n\n"
                + "语法层面，Zan 基本沿用 C# 的形状，学习成本主要花在少数几处差异上："
                + "结构体在栈上，集合写时复制，没有垃圾回收，也没有生命周期标注。\n\n"
                + "内存管理用的是自动引用计数（ARC）。计数的增减由编译器在编译期插入，"
                + "对象的析构时机因此是确定的，不会出现“过一会儿才被回收”的抖动，"
                + "这对长期驻留的服务端进程尤其重要。\n\n"
                + "编译目标是 LLVM IR，再由 LLVM 生成目标平台的机器码。"
                + "启动没有预热阶段，第一份请求和第一万份请求走的是同一份代码。"),
            Schema.PostOf("用 ZanIDE 开始第一个项目", 3,
                "zanide,上手", 0,
                "编译器、语言服务、调试器和标准库都在 IDE 里，新建项目到断点调试不需要额外配置。",
                "打开 ZanIDE，新建项目，从控制台、图形界面、服务端、库四类模板里选一个，"
                + "向导会生成一份可以直接运行的工程。\n\n"
                + "点“运行”在输出面板看结果，按 F5 进入调试：断点、单步、变量查看、"
                + "调用栈都由随 IDE 分发的调试器提供，不需要自己搭 LLDB。\n\n"
                + "要交付时用“发布”，选目标平台打包，产物是可执行文件加上它依赖的动态库，"
                + "拷到目标机器上即可运行。"),
            Schema.PostOf("ZanWeb 的路由是编译期生成的", 2,
                "zanweb,路由,attribute", 0,
                "控制器上的 [Route] / [Http*] 由编译器扫描并生成注册代码，启动时没有反射，也没有手写路由表。",
                "在 ZanWeb 里，一个接口就是一个带属性的方法：[Route] 决定路径，"
                + "[HttpGet] / [HttpPost] 决定方法，[Description] 决定它在接口文档里的说明。\n\n"
                + "编译器的属性路由阶段会扫描所有控制器与动作，把类级默认值和方法级覆盖合并，"
                + "展开 [controller] / [action] 占位，然后生成一份注册代码。"
                + "运行时要做的只是执行这份注册，因此启动过程里没有反射、没有扫描目录。\n\n"
                + "同一份属性还喂给两处：管理后台的菜单按属性和权限过滤生成，"
                + "接口文档按路径分组列出方法、说明、参数与返回值。"
                + "换句话说，加一个动作，菜单和文档会同时跟上，不存在第二份需要同步的清单。"),
            Schema.PostOf("服务端指标为什么用 SSE 而不是轮询", 2,
                "sse,监控,性能", 0,
                "一次连接换掉每秒一次的整轮请求：路由、鉴权、日志都不必为“有没有变化”重复付费。",
                "管理后台的运行监控需要秒级刷新。用轮询实现的话，每个打开的标签页每秒都要走一遍"
                + "完整请求：解析、路由匹配、会话校验、写一行访问日志，"
                + "而绝大多数回答是“和上次一样”。\n\n"
                + "改成 Server-Sent Events 之后，浏览器用 EventSource 订阅一次，"
                + "服务端每两秒推一帧快照，另外定期补一段时序数据用于绘制曲线，"
                + "空闲时发一行注释做保活，避免中间代理判定连接已死。\n\n"
                + "这类长连接不参与延迟统计：它的存活时间取决于用户什么时候关掉页面，"
                + "把它当成一次慢请求记录下来只会污染 P95。"
            )
        };
        for (int i = 0; i < seed.Count; i = i + 1) {
            int _id = await posts.Insert(seed[i]);
        }
    }

    static async void AddCategory(IDbConnection db, string name, string slug,
                               int sortOrder) {
        Category c = new Category();
        c.name = name;
        c.slug = slug;
        c.description = "";
        c.sortOrder = sortOrder;
        c.status = 1;
        c.createdAt = WebApp.NowSeconds();
        int _id = await db.Insert<Category>(c).ExecuteIdentityAsync();
    }

    static Post PostOf(string title, int categoryId, string tags, int top,
                       string summary, string body) {
        Post p = new Post();
        p.title = title;
        p.summary = summary;
        p.body = body;
        p.categoryId = categoryId;
        p.tags = tags;
        p.cover = "";
        p.author = "admin";
        p.published = 1;
        p.top = top;
        p.views = 0;
        p.createdAt = WebApp.NowSeconds();
        p.updatedAt = p.createdAt;
        return p;
    }

    // ---- route-derived grants ------------------------------------------------
    // The rights that EXIST are the route table, so nothing has to be seeded
    // for a new screen. What a deployment decides -- which role holds which of
    // them -- is rows in sys_role_grant, and the one decision made for it is
    // this: the built-in "admin" role keeps covering the whole admin as new
    // screens ship, and the built-in "editor" role keeps covering the content
    // ones. Both are filled in here, after the routes are registered, and only
    // ever by insert: a right an operator revoked stays revoked, because the
    // grant it would re-add is already accounted for below.

    /// <summary>Folds pre-mask grant rows (one action, mask 0) into one row per
    /// screen with the bits those actions declare. Runs before the built-in roles
    /// are looked at, and only over rows that still have mask 0, so it is a
    /// no-op from the second boot on. An action nobody declared a bit for has no
    /// bit to keep: it is dropped here and named by Perm.Index's boot line, which
    /// is the missing declaration showing up rather than a silent right.
    /// </summary>
    static async void MigrateGrants(IDbConnection db) {
        List<RoleGrant> old = await db.Select<RoleGrant>()
            .Where(a => a.mask == 0).ToListAsync();
        if (old.Count == 0) { return; }

        // (roleId, screen) -> bits, kept as two parallel lists: a handful of
        // roles times a handful of screens, once in the life of a database.
        List<string> keys = new List<string>();
        List<int> masks = new List<int>();
        for (int i = 0; i < old.Count; i = i + 1) {
            RoleGrant g = old[i];
            int bit = Perm.BitOf(g.action);
            if (bit == 0) { continue; }
            string key = Convert.ToString(g.roleId) + "|"
                + Perm.ScreenOf(g.action);
            int at = keys.IndexOf(key);
            if (at < 0) { keys.Add(key); masks.Add(bit); }
            else { masks[at] = masks[at] | bit; }
        }

        int _gone = await db.Delete<RoleGrant>().Where(a => a.mask == 0)
            .ExecuteAffrowsAsync();
        long now = WebApp.NowSeconds();
        for (int i = 0; i < keys.Count; i = i + 1) {
            string key = keys[i];
            int bar = key.IndexOf("|");
            int roleId = Convert.ToInt32(key.Substring(0, bar));
            string screen = key.Substring(bar + 1);
            RoleGrant have = await db.Select<RoleGrant>()
                .Where(a => a.roleId == roleId && a.action == screen)
                .FirstAsync();
            if (have != null) {
                int merged = have.mask | masks[i];
                int _n = await db.Update<RoleGrant>()
                    .Set(a => a.mask, merged)
                    .Where(a => a.id == have.id).ExecuteAffrowsAsync();
                continue;
            }
            await Schema.Grant(db, roleId, screen, masks[i], now);
        }
        Console.WriteLine("[rbac] 旧授权已合并为 "
            + Convert.ToString(keys.Count) + " 条屏掩码");
    }

    /// <summary>Grants the built-in roles the protected route actions they do
    /// not hold yet. Safe on every boot; nothing is ever removed.</summary>
    static async void SyncRoleGrants(WebApp app) {
        IDbConnection db = await AuthUser.Lease();
        if (db == null) { return; }
        try {
            await Schema.MigrateGrants(db);
            Role admin = await db.Select<Role>()
                .Where(a => a.code == "admin").FirstAsync();
            Role editor = await db.Select<Role>()
                .Where(a => a.code == "editor").FirstAsync();
            if (admin == null && editor == null) { return; }

            // What each role already holds, joined into one string per role, so
            // the loop below is a substring test rather than a query per route.
            List<RoleGrant> rows = await db.Select<RoleGrant>().ToListAsync();
            string adminHas = ",";
            string editorHas = ",";
            for (int i = 0; i < rows.Count; i = i + 1) {
                RoleGrant g = rows[i];
                if (admin != null && g.roleId == admin.id) {
                    adminHas = adminHas + g.action + ",";
                }
                if (editor != null && g.roleId == editor.id) {
                    editorHas = editorHas + g.action + ",";
                }
            }

            // A role that already holds something was set up on an earlier boot
            // or by an operator; adding to it would undo their revocations.
            bool fillAdmin = admin != null && adminHas == ",";
            bool fillEditor = editor != null && editorHas == ",";
            if (!fillAdmin && !fillEditor) { return; }

            long now = WebApp.NowSeconds();
            // One row per screen: the bits that screen actually has, which is
            // the whole of it for the admin role and the content screens for the
            // editor one.
            List<Route> routes = app.router.All();
            List<string> screens = new List<string>();
            List<int> masks = new List<int>();
            List<bool> content = new List<bool>();
            for (int i = 0; i < routes.Count; i = i + 1) {
                Route r = routes[i];
                if (r.action.Length == 0 || !r.needsAuth) { continue; }
                int bit = Perm.BitOf(r.action);
                if (bit == 0) { continue; }
                string screen = Perm.ScreenOf(r.action);
                int at = screens.IndexOf(screen);
                if (at < 0) {
                    screens.Add(screen);
                    masks.Add(bit);
                    content.Add(Schema.IsContent(r.pattern));
                } else {
                    masks[at] = masks[at] | bit;
                    if (Schema.IsContent(r.pattern)) { content[at] = true; }
                }
            }
            for (int i = 0; i < screens.Count; i = i + 1) {
                if (fillAdmin) {
                    await Schema.Grant(db, admin.id, screens[i], masks[i], now);
                }
                if (fillEditor && content[i]) {
                    await Schema.Grant(db, editor.id, screens[i], masks[i], now);
                }
            }
        } finally {
            AuthUser.Give(db);
        }
    }

    /// <summary>Whether a route belongs to the content side of the admin, which
    /// is what the built-in editor role is allowed to run.</summary>
    static bool IsContent(string pattern) {
        return pattern.StartsWith("/admin/content/") || pattern == "/admin";
    }

}
