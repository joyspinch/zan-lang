using System;
using System.Data;
using System.Web;

namespace ZanWeb;

/// <summary>
/// Controller base with injected database and cache access. Dependencies are
/// assembled in main.zan and installed via AppServices.Use(...); actions reach
/// them through this.Conn() / this.Cache() instead of static service lookup.
///
/// THE CONNECTION IS REQUEST-SCOPED. Conn() borrows one connection from the pool
/// the first time an action asks for it, every later call in the same request
/// gets that same connection, and OnAfter() gives it back when the action
/// finishes — so no business code, and no DAO, contains Acquire/Release:
///
///     PostDao dao = new PostDao(await this.Conn());
///     List&lt;Post&gt; rows = await dao.Recent(20, kw);
///     Post one = await dao.ById(id);    // same connection, no second lease
///
/// One connection per request (not per query) is also what makes transactions
/// possible at all: a transaction lives on a session, so every statement inside
/// it must run on the same connection.
///
///     if (!await this.Begin()) { ...unavailable... }
///     try {
///         int id = await new PostDao(this.Held()).Insert(p);
///         int _n = await new UserDao(this.Held()).BumpTokenVersion(uid);
///         await this.Commit();
///     } catch { await this.Rollback(); }   // Rollback is safe to call twice
///
/// BEGIN / COMMIT / ROLLBACK are statements like any other, so they are awaited
/// too — on a non-blocking driver they are round trips, and the request's
/// teardown (OnAfterAsync) therefore runs on the coroutine as well.
///
/// Override OnDone() (not OnAfterAsync()) for per-request cleanup of your own, so
/// the connection is always released.
/// </summary>
class AppController : Controller {
    IDbConnection lease;
    bool inTx;

    /// <summary>The injected database context (null before AppServices.Use).</summary>
    protected DbContext Db() {
        AppServices s = AppServices.Current();
        if (s == null) { return null; }
        return s.Db();
    }

    /// <summary>The injected cache context (null before AppServices.Use).</summary>
    protected CacheContext Cache() {
        AppServices s = AppServices.Current();
        if (s == null) { return null; }
        return s.Cache();
    }

    /// <summary>This request's connection: borrowed on first call, reused
    /// afterwards, released automatically when the action returns. null means the
    /// database is unavailable — handlers should answer 503 rather than pretend
    /// the result set was empty.</summary>
    protected async IDbConnection Conn() {
        if (this.lease != null) { return this.lease; }
        DbContext ctx = this.Db();
        if (ctx == null) { return null; }
        this.lease = await ctx.Acquire();
        return this.lease;
    }

    /// <summary>The connection already borrowed by this request, without
    /// awaiting. Only valid after Conn() or Begin() succeeded (handy inside a
    /// transaction block, where the lease is guaranteed).</summary>
    protected IDbConnection Held() {
        return this.lease;
    }

    /// <summary>The connection the table accessors run on. `this.User`,
    /// `this.Post`, ... compile into a typed query over THIS connection, which
    /// is why the lease is taken in OnBeforeAsync(): an accessor is a plain
    /// member and cannot await.
    ///
    ///     List&lt;Post&gt; rows = await this.Post
    ///         .Where(a => a.published == 1)
    ///         .OrderByDescending(a => a.id).Take(20).ToListAsync();
    ///     User u = await this.User.Read(uid);
    ///
    /// No DAO to construct, no Acquire/Release, and the field names are still
    /// checked at compile time.</summary>
    IDbConnection __Conn() {
        return this.lease;
    }

    /// <summary>Leases this request's connection before the action runs, so the
    /// table accessors have one. Costs nothing when the database is
    /// unconfigured (Conn() answers null and actions fall back to 503).</summary>
    virtual async bool OnBeforeAsync() {
        IDbConnection _db = await this.Conn();
        return this.OnBefore();
    }

    /// <summary>Whether this request has a usable database. False means the pool
    /// could not hand out a connection (unconfigured or unreachable), which is a
    /// 503 for the caller rather than an exception. Cheap: the lease was already
    /// taken in OnBeforeAsync(), so this only looks at it.</summary>
    protected bool DbReady() {
        return this.lease != null;
    }

    /// <summary>Opens a transaction on this request's connection. false means the
    /// database is unavailable and nothing was started.</summary>
    protected async bool Begin() {
        IDbConnection db = await this.Conn();
        if (db == null) { return false; }
        if (this.inTx) { return true; }
        await db.BeginTransactionAsync();
        this.inTx = true;
        return true;
    }

    /// <summary>Commits this request's transaction (no-op when none is open).</summary>
    protected async void Commit() {
        if (!this.inTx) { return; }
        this.inTx = false;
        await this.lease.CommitAsync();
    }

    /// <summary>Rolls back this request's transaction (no-op when none is open,
    /// so it is safe in an error path that may run after Commit()).</summary>
    protected async void Rollback() {
        if (!this.inTx) { return; }
        this.inTx = false;
        await this.lease.RollbackAsync();
    }

    /// <summary>Releases the request's connection, on the coroutine, so an
    /// unfinished transaction can be rolled back first: returning a connection
    /// mid-transaction would hand the next request a session holding someone
    /// else's locks, and the rollback itself is a round trip.</summary>
    virtual async void OnAfterAsync() {
        if (this.lease != null) {
            await this.Rollback();
            this.Db().Release(this.lease);
            this.lease = null;
        }
        this.OnDone();
    }

    /// <summary>Per-request cleanup for subclasses. Override this instead of
    /// OnAfterAsync(), which owns releasing the connection.</summary>
    virtual void OnDone() { }
}
