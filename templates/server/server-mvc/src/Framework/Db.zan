using System;
using System.Data;
using System.Data.MySql;
using System.Data.Postgres;
using System.Data.Redis;
using System.Data.Sqlite;

namespace ZanWeb;

/// <summary>
/// Database / Redis bootstrap driven by the [database] and [cache] sections of
/// config/app.json. main.zan calls OpenPool() / OpenRedis() ONCE per worker
/// process and injects the pools into DbContext / CacheContext — consumers never
/// open connections themselves.
///
/// Both are POOLS, not single connections: workers are separate processes (each
/// re-runs Main), and inside one worker every request is a coroutine, so a
/// shared connection would serialize the whole worker and interleave two
/// requests' transactions on one session. A pool opens its connections lazily on
/// first use, hands one out per request, and parks a coroutine (never the
/// thread) when every connection is checked out.
///
/// Nothing here fails startup: when the database or Redis is unreachable the
/// server still serves, and handlers surface a friendly error.
/// </summary>
class Db {
    /// <summary>The connection pool for the configured engine, sized by
    /// [database].poolSize. Connections open on first acquire, so calling this
    /// in the master process opens nothing.</summary>
    static DbPool OpenPool() {
        string driver = Cfg.Db.driver;
        int size = Cfg.Db.poolSize;
        if (size < 1) { size = 1; }
        if (driver == "mysql" || driver == "mariadb") {
            return MySqlConnector.Pool(Cfg.Db.host, Cfg.Db.port, Cfg.Db.name,
                Cfg.Db.user, Cfg.Db.password, size);
        }
        if (driver == "postgres" || driver == "postgresql") {
            return PgConnector.Pool(Cfg.Db.host, Cfg.Db.port, Cfg.Db.name,
                Cfg.Db.user, Cfg.Db.password, size);
        }
        return SqliteConnector.Pool(Cfg.Db.sqlitePath, size);
    }

    /// <summary>Builds the Redis pool from config, or null when [cache].driver
    /// is not "redis" (worker-local memory cache only). The pool is injected
    /// into CacheContext.</summary>
    static RedisPool OpenRedis() {
        if (Cfg.Cache.driver != "redis") { return null; }
        return new RedisPool(Cfg.Cache.redisHost,
            Cfg.Cache.redisPort, Cfg.Cache.poolSize, Cfg.Cache.connectTimeoutMs);
    }
}
