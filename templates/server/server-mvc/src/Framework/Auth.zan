using System;
using System.Data;
using System.Data.Orm;
using System.Diagnostics;
using System.Security.Cryptography;
using System.Web;
using ZanWeb.Model.Sys;
using ZanWeb.Dao.Sys;

namespace ZanWeb;

class AuthUser {
    /// <summary>sys_user.status of an account that may log in.</summary>
    static int Active = 1;

    /// <summary>Borrows a connection for one authentication lookup. The
    /// token / permission resolvers run on the request coroutine (their
    /// delegates are async), so this parks like any other request instead of
    /// blocking the worker, and it works on drivers that only offer awaited
    /// calls. null means the database is unreachable and every caller then fails
    /// closed (anonymous, nothing granted) rather than guessing.
    ///
    /// It is still one lookup per request: the RBAC phase reads the principal
    /// from the shared permission tables instead, leaving zero queries on the
    /// request path.</summary>
    static async IDbConnection Lease() {
        AppServices s = AppServices.Current();
        if (s == null) { return null; }
        return await s.Db().Acquire();
    }

    static void Give(IDbConnection db) {
        AppServices s = AppServices.Current();
        if (s == null) { return; }
        s.Db().Release(db);
    }

    static string PasswordHash(string password, string salt) {
        string material = salt + ":" + password;
        int i = 0;
        while (i < 12000) {
            material = Hex.Encode(Sha256.Hash(material + ":" + salt, material.Length + salt.Length + 1), 32);
            i = i + 1;
        }
        return material;
    }

    static async User ByUsername(string username) {
        IDbConnection db = await AuthUser.Lease();
        if (db == null) { return null; }
        try {
            return await new UserDao(db).ByUsername(username);
        } finally {
            AuthUser.Give(db);
        }
    }

    static async User ById(string uid) {
        int id = AuthUser.ToInt(uid);
        if (id <= 0) { return null; }
        IDbConnection db = await AuthUser.Lease();
        if (db == null) { return null; }
        try {
            return await new UserDao(db).ById(id);
        } finally {
            AuthUser.Give(db);
        }
    }

    /// <summary>Verifies the password and issues a cookie token. "" = rejected;
    /// the caller must not tell the client which of the two reasons applied.</summary>
    static async string Login(string username, string password) {
        User row = await AuthUser.ByUsername(username);
        if (row == null || row.status != AuthUser.Active) { return ""; }
        string actual = AuthUser.PasswordHash(password, row.passwordSalt);
        if (!AuthToken.Equal(actual, row.passwordHash)) { return ""; }
        return AuthToken.Issue(Convert.ToString(row.id), row.tokenVersion,
            WebApp.NowSeconds());
    }

    /// <summary>The account's current token version, or -1 when it cannot log in
    /// (unknown, disabled, or the database is out of capacity). A token whose
    /// version differs was issued before a password change / forced logout and is
    /// no longer valid — so the token itself carries no password material.</summary>
    static async int TokenVersion(string uid) {
        User row = await AuthUser.ById(uid);
        if (row == null || row.status != AuthUser.Active) { return -1; }
        return row.tokenVersion;
    }

    static int ToInt(string s) {
        return Filter.ToInt(s, 0);
    }

    // ---- authorization ------------------------------------------------------
    // A user holds roles (sys_user_role, plus the roles of their department),
    // a role holds route actions (sys_role_grant), and a route action is what
    // the dispatcher and the menu both ask about. That is the whole model: no
    // permission directory, no code to keep in step with the routes, and one
    // question -- "may this uid run this action?" -- answered in one place for
    // both the gateway and the sidebar, so a visible link can never 403.
    //
    // Both halves live in shared memory (PermTable), so a page that asks once
    // per menu entry costs no query and every worker process reads the same
    // rows. The database is only consulted when an account is not in the table
    // yet; a write drops it there and then.

    /// <summary>Drops one account's roles, so its next request rereads
    /// them.</summary>
    static void Forget(string uid) { PermTable.Forget(uid); }

    /// <summary>Drops every account: used after a change that can affect many at
    /// once (a department's roles, a reassignment).</summary>
    static void ForgetAll() { PermTable.ForgetAll(); }

    /// <summary>Republishes what every role may run and drops every cached
    /// account: for a change to a role, its grants or its status.</summary>
    static async void RolesChanged(IDbConnection db) {
        await PermTable.LoadRoles(db);
        PermTable.ForgetAll();
    }

    /// <summary>Refreshes role permissions from rows already read through a
    /// controller's generated table accessors.</summary>
    static async void RolesChanged(List<Role> roles, List<RoleGrant> grants) {
        await PermTable.LoadRoles(roles, grants);
        PermTable.ForgetAll();
    }

    /// <summary>The PermissionResolver the dispatcher and the menu both go
    /// through: whether this account may run that route action. The bootstrap
    /// account bypasses the lookup, which is how the first role gets granted
    /// at all.</summary>
    static async bool Allow(string uid, string action) {
        if (action.Length == 0) { return false; }
        string roleIds = await AuthUser.RolesOf(uid);
        if (roleIds == "*") { return true; }
        if (roleIds.Length == 0) { return false; }
        return PermTable.RolesAllow(roleIds, action);
    }

    /// <summary>Which buttons of one screen this account holds (see PermBit) --
    /// the same masks Allow() refuses on, so a rendered button and an accepted
    /// request are one decision. The bootstrap account holds every bit the
    /// screen actually has.</summary>
    static async int MaskOf(string uid, string screen) {
        if (screen.Length == 0) { return 0; }
        string roleIds = await AuthUser.RolesOf(uid);
        if (roleIds == "*") { return Perm.MaskOf(screen); }
        if (roleIds.Length == 0) { return 0; }
        return PermTable.RolesMask(roleIds, screen) & Perm.MaskOf(screen);
    }

    /// <summary>This account's roles as ",3,7," ("*" for the bootstrap account,
    /// "" when it is unknown, disabled or the database is unreachable -- an
    /// unresolvable account holds no rights). Read from shared memory; filled in
    /// from the database on the first request that misses.</summary>
    static async string RolesOf(string uid) {
        int id = AuthUser.ToInt(uid);
        if (id <= 0) { return ""; }

        string hit = PermTable.UserRoles(uid);
        if (hit.Length > 0) { return hit; }

        IDbConnection db = await AuthUser.Lease();
        if (db == null) { return ""; }
        try {
            User me = await db.Select<User>().Where(a => a.id == id).FirstAsync();
            if (me == null || me.status != AuthUser.Active) { return ""; }
            if (me.isSuper == 1) {
                PermTable.SetUser(uid, true, "");
                return "*";
            }
            string joined = await AuthUser.RoleIds(db, me);
            PermTable.SetUser(uid, false, joined);
            return joined;
        } finally {
            AuthUser.Give(db);
        }
    }

    /// <summary>The enabled roles this account holds -- its own and its
    /// department's, so a new hire inherits the department's rights without a
    /// second assignment -- as ",3,7,".</summary>
    static async string RoleIds(IDbConnection db, User me) {
        List<int> roleIds = new List<int>();
        List<UserRole> mine = await db.Select<UserRole>()
            .Where(a => a.userId == me.id).ToListAsync();
        for (int i = 0; i < mine.Count; i = i + 1) {
            AuthUser.AddId(roleIds, mine[i].roleId);
        }
        int dept = me.departmentId;
        if (dept > 0) {
            List<DepartmentRole> byDept = await db.Select<DepartmentRole>()
                .Where(a => a.departmentId == dept).ToListAsync();
            for (int i = 0; i < byDept.Count; i = i + 1) {
                AuthUser.AddId(roleIds, byDept[i].roleId);
            }
        }
        if (roleIds.Count == 0) { return ""; }

        StringBuilder outp = new StringBuilder();
        outp.Append(",");
        List<Role> roles = await db.Select<Role>().ToListAsync();
        for (int i = 0; i < roles.Count; i = i + 1) {
            Role r = roles[i];
            if (r.status != 1 || !AuthUser.HasId(roleIds, r.id)) { continue; }
            outp.Append(Convert.ToString(r.id));
            outp.Append(",");
        }
        string joined = outp.ToString();
        if (joined == ",") { return ""; }
        return joined;
    }

    static void AddId(List<int> list, int id) {
        if (id <= 0 || AuthUser.HasId(list, id)) { return; }
        list.Add(id);
    }

    static bool HasId(List<int> list, int id) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i] == id) { return true; }
        }
        return false;
    }

    /// <summary>Whether a comma-joined list holds the whole item `needle`. The
    /// commas are part of the comparison, so "Users.List" never matches
    /// "Users.ListAll". Used to read checkbox sets off a form.</summary>
    static bool Holds(string haystack, string needle) {
        if (needle.Length == 0) { return false; }
        return ("," + haystack + ",").Contains("," + needle + ",");
    }
}

class AuthToken {
    /// <summary>The cookie key: [auth].secret in config/app.json, overridden by
    /// the ZAN_AUTH_SECRET environment variable when that is set (so a
    /// deployment can keep the secret out of the file).</summary>
    static string Secret() { return Cfg.Auth.secret; }

    static bool Ready() { return AuthToken.Secret().Length >= 32; }

    static bool Equal(string actual, string expected) {
        int diff = actual.Length ^ expected.Length;
        int n = expected.Length;
        int i = 0;
        while (i < n) {
            int a = 0;
            if (i < actual.Length) { a = actual[i] & 255; }
            diff = diff | (a ^ (expected[i] & 255));
            i = i + 1;
        }
        return diff == 0;
    }

    static string EncodeUrl(string raw, int len) {
        string text = Base64.Encode(raw, len).Replace("+", "-").Replace("/", "_");
        while (text.Length > 0 && text.Substring(text.Length - 1) == "=") {
            text = text.Substring(0, text.Length - 1);
        }
        return text;
    }

    static byte[] DecodeUrl(string text, List<int> outLen) {
        int i = 0;
        while (i < text.Length) {
            int c = text[i] & 255;
            bool valid = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
                || (c >= 48 && c <= 57) || c == 45 || c == 95;
            if (!valid) { outLen[0] = -1; return new byte[0]; }
            i = i + 1;
        }
        string base64 = text.Replace("-", "+").Replace("_", "/");
        int rem = base64.Length & 3;
        if (rem == 1) { outLen[0] = -1; return new byte[0]; }
        if (rem == 2) { base64 = base64 + "=="; }
        else if (rem == 3) { base64 = base64 + "="; }
        return Base64.Decode(base64, outLen);
    }

    static byte[] Key() {
        string secret = AuthToken.Secret();
        return Sha256.Hash(secret, secret.Length);
    }

    /// <summary>Builds the cookie: version marker, uid, issue time and the
    /// account's tokenVersion, encrypted and authenticated with AES-GCM. No
    /// password material goes in, so the cookie cannot leak credentials and a
    /// forced logout is one integer bump.</summary>
    static string Issue(string uid, int tokenVersion, int now) {
        if (!AuthToken.Ready()) { return ""; }
        string plain = "2\t" + uid + "\t" + Convert.ToString(now) + "\t"
            + Convert.ToString(tokenVersion);
        byte[] key = AuthToken.Key();
        byte[] iv = RandomNumberGenerator.GetBytes(12);
        byte[] tag = new byte[16];
        string aad = "zan.auth.cookie.v1";
        byte[] cipher = AesGcm.Encrypt(key, 32, iv, aad, aad.Length,
            plain, plain.Length, tag);
        if (cipher == null) { return ""; }
        byte[] packed = new byte[12 + cipher.Length + 16];
        int i = 0;
        while (i < 12) { packed[i] = iv[i]; i = i + 1; }
        i = 0;
        while (i < cipher.Length) { packed[12 + i] = cipher[i]; i = i + 1; }
        i = 0;
        while (i < 16) { packed[12 + cipher.Length + i] = tag[i]; i = i + 1; }
        return AuthToken.EncodeUrl(packed, packed.Length);
    }

    static async string Resolve(string token) {
        if (token.Length < 50 || token.Length > 512) { return ""; }
        List<int> decodedLen = new List<int>(); decodedLen.Add(0);
        byte[] packed = AuthToken.DecodeUrl(token, decodedLen);
        int total = decodedLen[0];
        if (total < 29) { return ""; }
        int cipherLen = total - 28;
        byte[] iv = new byte[12];
        byte[] cipher = new byte[cipherLen];
        byte[] tag = new byte[16];
        int i = 0;
        while (i < 12) { iv[i] = packed[i]; i = i + 1; }
        i = 0;
        while (i < cipherLen) { cipher[i] = packed[12 + i]; i = i + 1; }
        i = 0;
        while (i < 16) { tag[i] = packed[12 + cipherLen + i]; i = i + 1; }
        byte[] key = AuthToken.Key();
        List<int> ok = new List<int>(); ok.Add(0);
        string aad = "zan.auth.cookie.v1";
        byte[] plainBytes = AesGcm.Decrypt(key, 32, iv, aad, aad.Length,
            cipher, cipherLen, tag, ok);
        if (ok[0] == 0 || plainBytes == null) { return ""; }
        string plain = plainBytes.ToStr(0, cipherLen);
        int first = plain.IndexOf("\t");
        int second = plain.IndexOf("\t", first + 1);
        int third = plain.IndexOf("\t", second + 1);
        if (first != 1 || plain.Substring(0, first) != "2"
            || second <= first + 1 || third <= second + 1
            || plain.IndexOf("\t", third + 1) >= 0) { return ""; }
        string uid = plain.Substring(first + 1, second - first - 1);
        int issued = Filter.ToInt(plain.Substring(second + 1, third - second - 1), 0);
        int now = WebApp.NowSeconds();
        if (issued <= 0 || issued > now + 300 || issued + 864000 <= now) { return ""; }
        int carried = Filter.ToInt(plain.Substring(third + 1), -1);
        int current = await AuthUser.TokenVersion(uid);
        // Never log the token or the uid: an access log is not a place to leak
        // credential material.
        if (carried < 0 || current < 0 || carried != current) { return ""; }
        return uid;
    }
}
