using System;

namespace ZanWeb;

/// <summary>
/// Values as a screen shows them. These are the handful of conversions every
/// list and dashboard repeats -- a timestamp as a date, bytes as MB, an empty
/// cell as an em dash -- and they are static functions on their own class
/// rather than methods on the controller base, because none of them look at the
/// request: a controller that formats a number is not a bigger controller.
/// </summary>
class Fmt {
    /// <summary>An empty cell reads as a rendering fault; an em dash reads as
    /// "not set".</summary>
    static string Dash(string v) {
        if (v == null || v.Length == 0 || v == "0") { return "—"; }
        return v;
    }

    /// <summary>`v` unless it is empty, in which case `fallback`.</summary>
    static string Text(string v, string fallback) {
        if (v == null || v.Length == 0) { return fallback; }
        return v;
    }

    /// <summary>The first whole UTF-8 character of `s`, for an avatar initial.
    /// Strings are byte indexed, so `Substring(0, 1)` would cut a multi-byte
    /// character (a CJK name) mid-sequence and render as a replacement glyph;
    /// the lead byte says how many bytes the character spans.</summary>
    static string FirstChar(string s) {
        if (s == null || s.Length == 0) { return ""; }
        int lead = s[0] & 255;
        int n = 1;
        if (lead >= 240) { n = 4; }
        else if (lead >= 224) { n = 3; }
        else if (lead >= 192) { n = 2; }
        if (n > s.Length) { n = s.Length; }
        return s.Substring(0, n);
    }

    static string Flag(bool on) {
        if (on) { return "1"; }
        return "";
    }

    static string Stamp(long seconds) {
        if (seconds <= 0) { return "-"; }
        return DateTime.FromUnixSeconds(seconds).ToString();
    }

    /// <summary>Date without the clock, for list columns where the time of day
    /// is noise.</summary>
    static string Day(long seconds) {
        if (seconds <= 0) { return "-"; }
        string s = DateTime.FromUnixSeconds(seconds).ToString();
        int sp = s.IndexOf(" ");
        if (sp > 0) { return s.Substring(0, sp); }
        return s;
    }

    static string Uptime(long ms) {
        long total = ms / 1000;
        long days = total / 86400;
        string clock = Fmt.Pad2((total % 86400) / 3600) + ":"
            + Fmt.Pad2((total % 3600) / 60) + ":"
            + Fmt.Pad2(total % 60);
        if (days > 0) { return Convert.ToString(days) + "d " + clock; }
        return clock;
    }

    /// <summary>Bytes for humans. A negative value means the platform could not
    /// report the metric, and says so instead of showing a plausible 0.</summary>
    static string Bytes(long v) {
        if (v < 0) { return "n/a"; }
        if (v < 1024) { return Convert.ToString(v) + " B"; }
        if (v < 1048576) { return Convert.ToString(v / 1024) + " KB"; }
        return Convert.ToString(v / 1048576) + "."
            + Convert.ToString((v * 10 / 1048576) % 10) + " MB";
    }

    static string Percent(long v) {
        if (v < 0) { return "n/a"; }
        return Convert.ToString(v) + "%";
    }

    static string Pad2(long v) {
        if (v < 10) { return "0" + Convert.ToString(v); }
        return Convert.ToString(v);
    }
}
