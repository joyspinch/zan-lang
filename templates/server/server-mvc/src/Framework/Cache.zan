using System;

namespace ZanWeb;

/// <summary>
/// Static facade over the injected cache context, for call sites that have no
/// controller instance to reach this.Cache() through. It only forwards, and it
/// keeps CacheContext's naming: *Async is the shared (Redis) cache every worker
/// sees, Local* is this worker's private memory.
/// </summary>
class Cache {
    static CacheContext Current() {
        AppServices s = AppServices.Current();
        if (s == null) { return null; }
        return s.Cache();
    }

    // ---- shared cache (Redis) ----

    static async string GetAsync(string key) {
        CacheContext c = Cache.Current();
        if (c == null) { return ""; }
        return await c.GetAsync(key);
    }

    static async void SetAsync(string key, string text) {
        CacheContext c = Cache.Current();
        if (c == null) { return; }
        await c.SetAsync(key, text);
    }

    static async void SetTtlAsync(string key, string text, int seconds) {
        CacheContext c = Cache.Current();
        if (c == null) { return; }
        await c.SetTtlAsync(key, text, seconds);
    }

    static async void DelAsync(string key) {
        CacheContext c = Cache.Current();
        if (c == null) { return; }
        await c.DelAsync(key);
    }

    // ---- worker-local memory ----

    static bool LocalHas(string key) {
        CacheContext c = Cache.Current();
        if (c == null) { return false; }
        return c.LocalHas(key);
    }

    static string LocalGet(string key) {
        CacheContext c = Cache.Current();
        if (c == null) { return ""; }
        return c.LocalGet(key);
    }

    static string LocalGetOr(string key, string fallback) {
        CacheContext c = Cache.Current();
        if (c == null) { return fallback; }
        return c.LocalGetOr(key, fallback);
    }

    static void LocalSet(string key, string text) {
        CacheContext c = Cache.Current();
        if (c == null) { return; }
        c.LocalSet(key, text);
    }

    static void LocalSetTtl(string key, string text, int seconds) {
        CacheContext c = Cache.Current();
        if (c == null) { return; }
        c.LocalSetTtl(key, text, seconds);
    }

    static void LocalDel(string key) {
        CacheContext c = Cache.Current();
        if (c == null) { return; }
        c.LocalDel(key);
    }
}
