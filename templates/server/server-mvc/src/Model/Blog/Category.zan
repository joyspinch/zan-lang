using System.Data.Orm;

namespace ZanWeb.Model.Blog;

/// <summary>A blog section. Posts carry the id; the public URLs carry the
/// slug, so renaming a section does not break its links.</summary>
[Table(Name = "blog_category")]
class Category {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    [Column(StringLength = 64, IsNullable = false)]
    string slug;

    [Column(StringLength = 255)]
    string description;

    int sortOrder;
    int status;
    long createdAt;
}
