using System.Data.Orm;

namespace ZanWeb.Model.Blog;

/// <summary>A reader comment. It is written with status 0 and only becomes
/// visible when an editor approves it, so an open form cannot publish anything
/// on its own.</summary>
[Table(Name = "blog_comment")]
class Comment {
    [Column(IsIdentity = true)]
    int id;

    int postId;

    [Column(StringLength = 64)]
    string author;

    [Column(StringLength = 128)]
    string email;

    [Column(StringLength = 2000, IsNullable = false)]
    string content;

    /// <summary>0 = waiting for review, 1 = published, 2 = rejected.</summary>
    int status;

    [Column(StringLength = 64)]
    string ip;

    long createdAt;
}
