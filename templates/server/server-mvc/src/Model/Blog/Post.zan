using System.Data.Orm;

namespace ZanWeb.Model.Blog;

/// <summary>
/// A blog article. The body is the article itself; `summary` is what the list
/// shows, kept as its own column so a listing never has to load (or truncate)
/// full articles.
/// </summary>
[Table(Name = "blog_post")]
class Post {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 200, IsNullable = false)]
    string title;

    /// <summary>Shown in the list and in link previews. Filled from the first
    /// lines of the body when the author leaves it empty.</summary>
    [Column(StringLength = 500)]
    string summary;

    [Column(IsNullable = false)]
    string body;

    /// <summary>blog_category.id, 0 when the article is uncategorised.</summary>
    int categoryId;

    /// <summary>Comma-separated labels. A join table would buy filtering this
    /// template does not do, at the price of two more screens to manage.</summary>
    [Column(StringLength = 255)]
    string tags;

    [Column(StringLength = 255)]
    string cover;

    [Column(StringLength = 64)]
    string author;

    /// <summary>1 = visible on the public site; 0 = draft.</summary>
    int published;

    /// <summary>1 = pinned above the rest of the list.</summary>
    int top;

    int views;

    long createdAt;
    long updatedAt;
}
