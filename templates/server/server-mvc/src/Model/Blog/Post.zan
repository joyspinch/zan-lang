using System.Data.Orm;

namespace ZanWeb.Model.Blog;

/// <summary>
/// A blog post. The entity IS the schema: [Table]/[Column] drive CodeFirst
/// (Schema.Ensure calls db.SyncStructure&lt;Post&gt;() once at startup), and the
/// compile-time ORM builds every query from these fields, so a column that does
/// not exist here is a compile error rather than a runtime one.
///
/// The field types are the SQL types: an int column stays an int all the way
/// through the query parameters and the JSON that leaves the server -- nothing
/// is stringly typed on the way in or out.
/// </summary>
[Table(Name = "blog_post")]
class Post {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 200, IsNullable = false)]
    string title;

    [Column(IsNullable = false)]
    string body;

    [Column(StringLength = 64)]
    string author;

    /// <summary>0 = draft, 1 = published.</summary>
    int published;

    /// <summary>Unix seconds.</summary>
    long createdAt;
}
