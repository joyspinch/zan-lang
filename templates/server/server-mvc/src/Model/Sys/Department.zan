using System.Data;
using System.Data.Orm;

namespace ZanWeb.Model.Sys;

[Table(Name = "sys_department")]
class Department {
    [Column(IsIdentity = true)]
    int id;

    int parentId;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    [Column(StringLength = 64, IsNullable = false)]
    string code;

    int leaderUserId;
    int sortOrder;
    int status;
    long createdAt;
    long updatedAt;
}