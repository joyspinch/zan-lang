using System.Data;
using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/// <summary>
/// auth_users 表的类型化实体。login 框架（AuthUser/AuthToken）用它做类型化
/// LINQ 查询与写入：建表、计数、插入、按用户名/主键查找全部走 dbgen 生成的
/// Select&lt;AuthUserEnt&gt;() / Insert&lt;AuthUserEnt&gt;() 链式查询，不再手拼 SQL。
/// </summary>
[Table(Name = "auth_users")]
class AuthUserEnt {
    [Column(IsIdentity = true)]
    int id;

    [Column(Name = "username", StringLength = 64, IsNullable = false)]
    string username;

    [Column(Name = "password_salt", StringLength = 64, IsNullable = false)]
    string passwordSalt;

    [Column(Name = "password_hash", StringLength = 64, IsNullable = false)]
    string passwordHash;

    [Column(Name = "role", StringLength = 16, IsNullable = false)]
    string role;

    [Column(Name = "status", StringLength = 16, IsNullable = false)]
    string status;
}
