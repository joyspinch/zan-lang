using System.Data;
using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/// <summary>
/// One right: role &lt;roleId&gt; holds &lt;mask&gt; on screen &lt;action&gt; -- one row
/// per screen, five bits per row (查看/新增/修改/删除/导出, see PermBit).
///
/// This is the only permission data the database holds. The rights that EXIST
/// are the route table, which the compiler builds from the [Route] / [Custom]
/// attributes on the controllers, so adding a screen adds its rights; what a
/// deployment decides -- which role gets which of them -- is operational data
/// and lives here. There is no permission directory in between: no code to
/// invent, no id to join through, nothing to re-seed when an action is renamed.
///
/// Rows written before the mask existed are one action each with mask 0; they
/// are folded into per-screen masks once, on boot (Schema.MigrateGrants).
/// </summary>
[Table(Name = "sys_role_grant")]
class RoleGrant {
    [Column(IsIdentity = true)]
    int id;

    int roleId;

    /// The screen as the router names it, i.e. an action without its method:
    /// "Users", or "Admin.System.Users" when a module prefix is in play.
    [Column(StringLength = 128, IsNullable = false)]
    string action;

    /// The buttons of that screen this role holds, OR-ed together. 0 marks a
    /// pre-mask row that still names a single action.
    int mask;

    long createdAt;
}
