using System.Data;
using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/// <summary>
/// One right: role &lt;roleId&gt; may run route action &lt;action&gt; ("Users.Save").
///
/// This is the only permission data the database holds. The rights that EXIST
/// are the route table, which the compiler builds from the [Route] / [Custom]
/// attributes on the controllers, so adding a screen adds its rights; what a
/// deployment decides -- which role gets which of them -- is operational data
/// and lives here. There is no permission directory in between: no code to
/// invent, no id to join through, nothing to re-seed when an action is renamed.
/// </summary>
[Table(Name = "sys_role_grant")]
class RoleGrant {
    [Column(IsIdentity = true)]
    int id;

    int roleId;

    /// The route action as the router names it: "<Controller>.<Action>".
    [Column(StringLength = 128, IsNullable = false)]
    string action;

    long createdAt;
}
