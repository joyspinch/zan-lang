using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/// <summary>
/// One write that changed something, recorded by the action that performed it.
/// Reads are not logged: they are the bulk of the traffic and none of the
/// accountability.
/// </summary>
[Table(Name = "sys_operation_log")]
class OperationLog {
    [Column(IsIdentity = true)]
    int id;

    int userId;

    [Column(StringLength = 64)]
    string username;

    /// <summary>What was done, as the permission code of the action
    /// ("sys:user:save"), so a log line and a grant read the same.</summary>
    [Column(StringLength = 128)]
    string action;

    [Column(StringLength = 128)]
    string title;

    [Column(StringLength = 8)]
    string method;

    [Column(StringLength = 255)]
    string path;

    /// <summary>Which rows the write touched, as plain text ("#7 admin").</summary>
    [Column(StringLength = 255)]
    string target;

    [Column(StringLength = 64)]
    string ip;

    /// <summary>1 = the write succeeded.</summary>
    int ok;

    [Column(StringLength = 255)]
    string message;

    long createdAt;
}
