using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/* 全站级设置：标题、关键词、ICP 备案号、统计脚本等。存于表而非 config/app.json，因为运营需在运行时通过后台修改，而 app.json 设计上只在启动时读一次。 */
[Table(Name = "sys_setting")]
class SiteSetting {
    [Column(IsIdentity = true)]
    int id;

    /* 代码读取的机器名（如 "site.title"）。 */
    [Column(StringLength = 64, IsNullable = false)]
    string name;

    [Column(StringLength = 2000)]
    string value;

    /* 该字段在设置界面的面板。 */
    [Column(StringLength = 32)]
    string groupName;

    [Column(StringLength = 64)]
    string label;

    /* 设置界面的渲染方式：text | textarea。 */
    [Column(StringLength = 16)]
    string kind;

    [Column(StringLength = 255)]
    string tip;

    int sortOrder;
    long updatedAt;
}