using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/// <summary>
/// One site-wide setting: title, keywords, ICP filing number, analytics
/// snippet, and so on. They live in a table rather than in config/app.json
/// because an operator changes them from the admin while the site is running,
/// and config/app.json is read once at startup by design.
/// </summary>
[Table(Name = "sys_setting")]
class SiteSetting {
    [Column(IsIdentity = true)]
    int id;

    /// <summary>Machine name the code reads ("site.title").</summary>
    [Column(StringLength = 64, IsNullable = false)]
    string name;

    [Column(StringLength = 2000)]
    string value;

    /// <summary>Which panel of the settings screen this field appears in.</summary>
    [Column(StringLength = 32)]
    string groupName;

    [Column(StringLength = 64)]
    string label;

    /// <summary>How the settings screen renders the field: text | textarea.</summary>
    [Column(StringLength = 16)]
    string kind;

    [Column(StringLength = 255)]
    string tip;

    int sortOrder;
    long updatedAt;
}
