using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/// <summary>A named set of code/label pairs (order status, gender, ...). The
/// type carries the machine name every item is looked up by; the items live in
/// sys_dict_item.</summary>
[Table(Name = "sys_dict_type")]
class DictType {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string code;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    /// <summary>1 = usable. A disabled type hides its items from lookups.</summary>
    int status;

    [Column(StringLength = 255)]
    string description;

    long createdAt;
    long updatedAt;
}
