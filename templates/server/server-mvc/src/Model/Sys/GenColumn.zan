using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/// <summary>
/// One designed column: its storage (kind/size/nullable/default) and its role in
/// the generated screens (which of list, filter, create and edit it appears in,
/// which control edits it, and which table it points at).
///
/// The screens read column names from here and never from the request, so a
/// generic CRUD screen can build SQL for a table it was not compiled against
/// without a caller being able to name a column of their own.
/// </summary>
[Table(Name = "sys_gen_column")]
class GenColumn {
    [Column(IsIdentity = true)]
    int id;

    int tableId;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    /// <summary>Storage kind: int | long | string | text | decimal | bool |
    /// datetime.</summary>
    [Column(StringLength = 16)]
    string kind;

    /// <summary>Length for string columns.</summary>
    int size;

    int nullable;

    [Column(StringLength = 255)]
    string defValue;

    [Column(StringLength = 64)]
    string label;

    /// <summary>Control used to edit it: text | textarea | number | select |
    /// switch | date | datetime | upload | richtext.</summary>
    [Column(StringLength = 16)]
    string widget;

    /// <summary>Dictionary type code backing a select, when the choices are an
    /// enumeration rather than another table.</summary>
    [Column(StringLength = 64)]
    string dictType;

    /// <summary>Table this column points at, and the columns of that table used
    /// as the stored value and the shown label.</summary>
    [Column(StringLength = 64)]
    string relTable;

    [Column(StringLength = 64)]
    string relValue;

    [Column(StringLength = 64)]
    string relLabel;

    int inList;
    int inFilter;
    int inCreate;
    int inEdit;
    int required;
    int sortOrder;
}
