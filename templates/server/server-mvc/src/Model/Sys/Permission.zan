using System.Data;
using System.Data.Orm;

namespace ZanWeb;

[Table(Name = "sys_permission")]
class Permission {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 128, IsNullable = false)]
    string code;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    [Column(StringLength = 128)]
    string resource;

    [Column(StringLength = 64)]
    string action;

    [Column(StringLength = 128)]
    string routeAction;

    int status;
    string description;
    long createdAt;
    long updatedAt;
}
