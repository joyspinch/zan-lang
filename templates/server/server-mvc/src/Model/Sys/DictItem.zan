using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/// <summary>One entry of a dictionary type: the stored value plus the label the
/// UI shows for it.</summary>
[Table(Name = "sys_dict_item")]
class DictItem {
    [Column(IsIdentity = true)]
    int id;

    /// <summary>sys_dict_type.code -- the type is referenced by its machine name
    /// so exporting a dictionary does not carry surrogate keys.</summary>
    [Column(StringLength = 64, IsNullable = false)]
    string typeCode;

    [Column(StringLength = 64, IsNullable = false)]
    string value;

    [Column(StringLength = 128, IsNullable = false)]
    string label;

    int sortOrder;
    int status;
    long createdAt;
    long updatedAt;
}
