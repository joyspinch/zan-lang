using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/// <summary>
/// One table designed in the admin: what it is called in the database, what the
/// generated entity is called in code, and how its management screen should
/// behave. The design is data, so the screen exists the moment the design is
/// saved -- generating .zan sources is a second, optional step for the parts a
/// generic screen cannot cover.
/// </summary>
[Table(Name = "sys_gen_table")]
class GenTable {
    [Column(IsIdentity = true)]
    int id;

    /// <summary>Physical table name ("shop_order").</summary>
    [Column(StringLength = 64, IsNullable = false)]
    string tableName;

    /// <summary>Entity/class name for generated code ("ShopOrder").</summary>
    [Column(StringLength = 64)]
    string entityName;

    /// <summary>What a person calls it ("订单").</summary>
    [Column(StringLength = 64)]
    string title;

    /// <summary>URL section the generated screen lives in ("content" ->
    /// /admin/content/&lt;table&gt;). The sidebar follows the URL, so this is where
    /// the screen sits in both.</summary>
    [Column(StringLength = 32)]
    string section;

    /// <summary>Default list ordering column, and 1 when descending.</summary>
    [Column(StringLength = 64)]
    string orderColumn;

    int orderDesc;

    /// <summary>1 when the REST endpoints under /api/data are served for this
    /// table.</summary>
    int apiEnabled;

    /// <summary>1 once the physical table has been created/updated.</summary>
    int migrated;

    long createdAt;
    long updatedAt;
    long generatedAt;
}
