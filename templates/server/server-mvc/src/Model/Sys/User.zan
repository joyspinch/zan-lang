using System.Data.Orm;

namespace ZanWeb.Model.Sys;

[Table(Name = "sys_user")]
class User {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string username;

    [Column(StringLength = 128, IsNullable = false)]
    string passwordHash;

    [Column(StringLength = 64, IsNullable = false)]
    string passwordSalt;

    [Column(StringLength = 128)]
    string nickname;

    [Column(StringLength = 128)]
    string email;

    [Column(StringLength = 32)]
    string mobile;

    int departmentId;
    int status;
    int tokenVersion;
    long createdAt;
    long updatedAt;
}
