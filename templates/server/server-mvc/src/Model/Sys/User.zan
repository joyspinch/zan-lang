using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/// <summary>
/// THE account table. Login credentials, state and identity all live here --
/// there is no second "auth" table and no session table: the cookie is a signed,
/// self-contained token, and `tokenVersion` revokes it (bump the column and every
/// token issued earlier stops resolving).
///
/// Permissions are deliberately NOT columns here: a user's rights come from the
/// roles assigned to it (sys_user_role -> sys_role_node), so granting something
/// never means altering this table. `isSuper` is the only exception -- the
/// bootstrap account that must be able to grant the very first role.
///
/// Every state field is an int, not a string: status/isSuper/tokenVersion are
/// compared and indexed as numbers, and stay numbers through the ORM and JSON.
/// </summary>
[Table(Name = "sys_user")]
class User {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string username;

    /// <summary>Iterated salted SHA-256 (see AuthUser.PasswordHash). Never
    /// returned by an API and never logged.</summary>
    [Column(StringLength = 128, IsNullable = false)]
    string passwordHash;

    [Column(StringLength = 64, IsNullable = false)]
    string passwordSalt;

    [Column(StringLength = 128)]
    string nickname;

    [Column(StringLength = 128)]
    string email;

    [Column(StringLength = 32)]
    string mobile;

    /// <summary>Which department the account belongs to; the data-permission
    /// scopes of its roles are resolved against this.</summary>
    int departmentId;

    /// <summary>1 = active. Anything else cannot log in and cannot resolve an
    /// already-issued token.</summary>
    int status;

    /// <summary>1 = bypasses permission checks. Reserved for the bootstrap
    /// account; ordinary administrators should get a role instead.</summary>
    int isSuper;

    /// <summary>Bumped to invalidate every token issued so far (password change,
    /// forced logout, disable).</summary>
    int tokenVersion;

    long createdAt;
    long updatedAt;
}
