namespace ZanWeb.Model.Sys;

/// <summary>
/// What an API is allowed to say about an account. Serializing the User entity
/// itself would ship passwordHash and passwordSalt to the client, so responses
/// project into this instead: adding a column to sys_user can never widen an
/// existing response by accident.
/// </summary>
class UserBrief {
    int id;
    string username;
    string nickname;
    int departmentId;
    int status;
    int isSuper;
}
