using System.Data;
using System.Data.Orm;

namespace ZanWeb.Model.Sys;

[Table(Name = "sys_role")]
class Role {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    [Column(StringLength = 64, IsNullable = false)]
    string code;

    int rank;
    int status;

    /// <summary>How much of a table this role may see: 1 全部 / 2 本部门 /
    /// 3 本部门及下级 / 4 仅本人 / 5 自定义部门（scopeDepts）。0 是升级前的行，
    /// 读作 1，所以加上这一列不会突然收窄既有角色。</summary>
    int dataScope;

    /// <summary>The departments dataScope = 5 means, as ",3,7," -- the same
    /// shape sys_user_role sets are cached in. A column rather than a join
    /// table: it is read as one string per role and never queried by
    /// department.</summary>
    [Column(StringLength = 255)]
    string scopeDepts;

    string description;
    long createdAt;
    long updatedAt;
}
