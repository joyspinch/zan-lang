using System.Data;
using System.Data.Orm;

namespace ZanWeb.Model.Sys;

[Table(Name = "sys_role")]
class Role {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string name;

    [Column(StringLength = 64, IsNullable = false)]
    string code;

    int rank;
    int status;
    string description;
    long createdAt;
    long updatedAt;
}
