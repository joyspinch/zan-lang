using System.Data;
using System.Data.Orm;

namespace ZanWeb;

[Table(Name = "sys_auth_session")]
class AuthSession {
    [Column(IsIdentity = true)]
    int id;

    int userId;

    [Column(StringLength = 128, IsNullable = false)]
    string tokenHash;

    long expiresAt;
    long revokedAt;

    [Column(StringLength = 64)]
    string clientIp;

    [Column(StringLength = 512)]
    string userAgent;

    long createdAt;
}
