using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/* 每次登录尝试，成功与否都记录；失败记录使暴力猜测可见。 */
[Table(Name = "sys_login_log")]
class LoginLog {
    [Column(IsIdentity = true)]
    int id;

    int userId;

    [Column(StringLength = 64)]
    string username;

    [Column(StringLength = 64)]
    string ip;

    [Column(StringLength = 255)]
    string agent;

    /* 1=登录成功，0=拒绝。 */
    int ok;

    [Column(StringLength = 128)]
    string message;

    long createdAt;
}