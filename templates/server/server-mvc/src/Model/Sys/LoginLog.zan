using System.Data.Orm;

namespace ZanWeb.Model.Sys;

/// <summary>Every sign-in attempt, successful or not. Failures are the point:
/// they are how a password-guessing run becomes visible.</summary>
[Table(Name = "sys_login_log")]
class LoginLog {
    [Column(IsIdentity = true)]
    int id;

    int userId;

    [Column(StringLength = 64)]
    string username;

    [Column(StringLength = 64)]
    string ip;

    [Column(StringLength = 255)]
    string agent;

    /// <summary>1 = signed in, 0 = refused.</summary>
    int ok;

    [Column(StringLength = 128)]
    string message;

    long createdAt;
}
