using System;
using System.Data;
using ZanWeb;
using System.Web;

// {{NAME}} -- ZanWeb enterprise web application (layered).
//
// main.zan only bootstraps the server and wires routes. Request handling lives
// in controllers (src/controller), data access in models (src/model), and the
// cross-cutting plumbing in the framework (src/framework). All runtime settings
// are parsed ONCE from config/app.json into the typed Cfg entity (Cfg.Server.*,
// Cfg.Db.*, Cfg.Worker.*, ...) and are NOT compiled into the binary -- edit the
// file and restart to change host / port / limits / database / cache / workers.
class Program {
    // Slow-request threshold (ms), loaded from [log].slowMs at startup.
    static int slowMs = 1000;

    static void Main() {
        Cfg.Load("config/app.json");

        // ---- assemble + inject dependencies ----
        // Every worker is its own process re-running Main, so each builds its
        // OWN pools here; nothing is inherited or shared across workers. Pools,
        // not single connections: inside one worker each request is a coroutine,
        // and a shared connection would serialize the worker and interleave two
        // requests' transactions on one session. Handlers get them through
        // AppServices (this.Db() / this.Cache()) and never open anything.
        DbPool pool = Db.OpenPool();
        DbContext db = DbContext.Of(pool);
        CacheContext cache = CacheContext.Of(Db.OpenRedis());
        AppServices services = new AppServices(db, cache);
        AppServices.Use(services);

        // Open a couple of connections before the first request pays for them
        // (and so the synchronous auth resolvers find one idle). idle == 0 means
        // the database is down: the server still starts and says so.
        int idle = await db.Warmup(2);
        Console.WriteLine("[db] " + Cfg.Db.driver + " pool size="
            + Convert.ToString(Cfg.Db.poolSize) + " idle=" + Convert.ToString(idle));
        if (Cfg.Cache.driver == "redis") {
            bool up = await cache.Warmup();
            if (up) {
                Console.WriteLine("[cache] redis "
                    + Cfg.Cache.redisHost + ":" + Convert.ToString(Cfg.Cache.redisPort)
                    + " (shared across workers)");
            } else {
                Console.WriteLine("[cache] redis unreachable -- reads miss,"
                    + " writes are dropped, handlers fall back to the database");
            }
        } else {
            Console.WriteLine("[cache] worker-local memory"
                + " -- correct only while [worker].count is 1");
        }

        // Schema + seed data run HERE, once, before the server accepts anything.
        // CodeFirst DDL in a request path costs a catalog round trip per hit and
        // lets two requests race on the same CREATE/ALTER.
        bool ready = await Schema.Ensure(db);
        if (!ready) {
            Console.WriteLine("[db] schema not applied (database unreachable)"
                + " -- check config/app.json [database]");
        }

        WebApp app = new WebApp(Cfg.Server.host, Cfg.Server.port);
        app.MaxBody(Cfg.Server.maxBodyMB * 1024 * 1024);
        app.GlobalLimit(Cfg.Server.globalLimitPerSec);
        WebHost.Use(app);
        app.AuthResolver(AuthToken.Resolve);
        app.PermissionResolver(AuthUser.Allow);
        app.RankResolver(AuthUser.Rank);
        app.Views("src/Controller");    // templates live next to their controllers

        // Assets (CSS/JS/fonts) come off disk, before auth and routing, cached in
        // this worker after the first hit. Nothing here is a route, so nothing
        // here can be secured or land in a menu.
        //
        // Only wwwroot/ is reachable, and only ever by that name: everything else
        // in the project — src/, config/app.json, app.db — is outside the mount,
        // so no traversal or naming trick can reach it even if a path check
        // slipped. Put a file under wwwroot/ exactly when the public internet is
        // meant to download it.
        StaticFiles.Mount(app, "/static", "wwwroot");

        // ---- lifecycle hooks (compile-time typed, run in order) ----
        // Access logging is OFF by default: a synchronous console write on every
        // request is a real throughput/CPU cost under load. Turn on [log].access
        // in app.json when you need to watch requests live.
        if (Cfg.Log.access) {
            app.Before(Program.AccessLog);
        }
        Program.slowMs = Cfg.Log.slowMs;
        app.After(Program.Metrics);

        // ---- routes ----
        // Routes are generated at COMPILE TIME from the [Route]/[Http*]/[Custom]/
        // [Description] attributes on the controller actions: the compiler's
        // attr-route pass discovers every controller + action, merges class-level
        // defaults with method-level overrides, expands [controller]/[action]
        // tokens, and synthesizes __AttrRoutes.Register(app) below. Add a
        // controller/action + attributes and rebuild -- no route table, no
        // generated file to maintain, no external tool. Custom auth ranks plug
        // in via app.RankResolver(...).
        __AttrRoutes.Register(app);

        // Single process, or N workers per config. Use
        // WebServer.RunCommand(app, Cfg.Worker.count) instead to get the
        // start / start -d / stop / restart / reload / status command line.
        int r = await WebServer.Run(app, Cfg.Worker.count, Cfg.Worker.daemon);
    }

    // ---- hooks ----

    static bool AccessLog(HttpContext ctx) {
        Console.WriteLine("[req] " + ctx.method + " " + ctx.path);
        return true;   // false would short-circuit the request
    }

    static void Metrics(HttpContext ctx, int elapsedMs) {
        if (elapsedMs > Program.slowMs) {
            Console.WriteLine("[slow] " + ctx.method + " " + ctx.path + " "
                + Convert.ToString(elapsedMs) + "ms");
        }
    }
}
