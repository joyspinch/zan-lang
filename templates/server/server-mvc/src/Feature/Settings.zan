using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb.Model.Sys;

namespace ZanWeb;

/// <summary>
/// Site-wide settings (title, keywords, ICP filing, footer, ...) read from
/// sys_setting.
///
/// They are read once per worker and kept in memory for a minute: every page
/// renders the site title and the footer, and none of them is worth a query per
/// request. A save clears the copy in the worker that handled it; the others
/// pick the change up when their copy expires.
/// </summary>
class Settings {
    static int CacheSeconds = 60;

    /// This worker's copy of sys_setting, and when it goes stale. A map, not
    /// the "name\tvalue\n..." string it used to be: reading one setting was a
    /// scan of the whole blob (a page render reads ten), and a value with a
    /// newline in it -- the analytics snippet -- had to be escaped on the way
    /// in and unescaped on the way out.
    static StrMap values;
    static long expires;

    /// <summary>Every setting, loaded once per minute per worker.</summary>
    static async StrMap All() {
        long now = WebApp.NowSeconds();
        if (Settings.values != null && now < Settings.expires) {
            return Settings.values;
        }
        IDbConnection db = await AuthUser.Lease();
        if (db == null) {
            // Unavailable database: keep serving the copy we have (stale beats
            // a site that loses its title) and retry on the next read.
            if (Settings.values != null) { return Settings.values; }
            return new StrMap();
        }
        StrMap m = new StrMap();
        try {
            List<SiteSetting> rows = await db.Select<SiteSetting>().ToListAsync();
            for (int i = 0; i < rows.Count; i = i + 1) {
                m.Set(rows[i].name, rows[i].value);
            }
        } finally {
            AuthUser.Give(db);
        }
        Settings.values = m;
        Settings.expires = now + Settings.CacheSeconds;
        return m;
    }

    /// <summary>Drops this worker's copy after a save.</summary>
    static void Forget() {
        Settings.values = null;
        Settings.expires = 0;
    }

    /// <summary>One setting, or `def` when it is unset or empty.</summary>
    static async string Get(string name, string def) {
        StrMap m = await Settings.All();
        string v = m.Get(name);
        if (v.Length == 0) { return def; }
        return v;
    }

    /// <summary>A switch setting: true unless it is stored as "0".</summary>
    static async bool On(string name, bool def) {
        string v = await Settings.Get(name, "");
        if (v.Length == 0) { return def; }
        return v != "0";
    }

    /// <summary>Copies the public-facing settings into a view: every layout
    /// shows the site name, and the footer shows the ICP filing.</summary>
    static async void Apply(ViewData d) {
        StrMap m = await Settings.All();
        d.Set("siteTitle", m.GetOr(SettingKeys.SiteTitle, "Zan"));
        d.Set("siteSubtitle", m.Get(SettingKeys.SiteSubtitle));
        d.Set("siteKeywords", m.Get(SettingKeys.SiteKeywords));
        d.Set("siteDescription", m.Get(SettingKeys.SiteDescription));
        d.Set("siteIcp", m.Get(SettingKeys.SiteIcp));
        d.Set("sitePolice", m.Get(SettingKeys.SitePolice));
        d.Set("siteCopyright", m.Get(SettingKeys.SiteCopyright));
        d.Set("siteAnalytics", m.Get(SettingKeys.SiteAnalytics));
        if (await Settings.On(SettingKeys.RegisterEnabled, false)) {
            d.Set("canRegister", "1");
        }
        if (await Settings.On(SettingKeys.ResetEnabled, true)) {
            d.Set("canReset", "1");
        }
    }
}
