using System;
using System.Diagnostics;

namespace ZanWeb;

/// <summary>
/// Who is on the site right now. Every open page holds one event stream, so
/// counting streams counts pages; the visitor count is the number of distinct
/// addresses behind them.
///
/// A worker only knows its own connections, so each one publishes what it sees
/// to the shared cache under presence:w&lt;id&gt; with a short TTL, and any worker
/// answering a request sums the slots back up. A worker that dies stops
/// republishing and its slot expires on its own -- there is nothing to clean up.
/// </summary>
class Presence {
    /// <summary>How long a published slot stays valid. Must outlive the publish
    /// interval, or the count flickers between beats.</summary>
    static int Ttl = 20;

    /// <summary>Upper bound on how many workers are polled for a total.</summary>
    static int MaxWorkers = 32;

    /// <summary>Addresses cannot be listed forever: past this many the visitor
    /// count is reported as the page count, which is the honest fallback.</summary>
    static int MaxIps = 120;

    static int pages = 0;
    static List<string> ips = new List<string>();

    /// <summary>Registers an open page from `ip`.</summary>
    static void Enter(string ip) {
        Presence.pages = Presence.pages + 1;
        Presence.ips.Add(ip);
    }

    /// <summary>Drops the page registered by the matching Enter.</summary>
    static void Leave(string ip) {
        if (Presence.pages > 0) { Presence.pages = Presence.pages - 1; }
        for (int i = 0; i < Presence.ips.Count; i = i + 1) {
            if (Presence.ips[i] == ip) { Presence.ips.RemoveAt(i); return; }
        }
    }

    /// <summary>Publishes this worker's slot: page count and the addresses
    /// behind them, so another worker can union rather than double count.</summary>
    static async void Publish() {
        string body = Convert.ToString(Presence.pages);
        int n = Presence.ips.Count;
        if (n <= Presence.MaxIps) {
            for (int i = 0; i < n; i = i + 1) {
                body = body + "," + Presence.ips[i];
            }
        }
        await Cache.SetTtlAsync(Presence.Key(ProcessHost.WorkerId()), body,
                                Presence.Ttl);
    }

    /// <summary>Open pages across all workers.</summary>
    static async int Pages() {
        int total = 0;
        for (int w = 0; w < Presence.MaxWorkers; w = w + 1) {
            string v = await Cache.GetAsync(Presence.Key(w));
            if (v.Length == 0) { continue; }
            total = total + Presence.Head(v);
        }
        if (total == 0) { return Presence.pages; }
        return total;
    }

    /// <summary>Distinct addresses across all workers. Falls back to the page
    /// count when a worker published more addresses than it lists.</summary>
    static async int Visitors() {
        string seen = ",";
        int pages = 0;
        int unlisted = 0;
        for (int w = 0; w < Presence.MaxWorkers; w = w + 1) {
            string v = await Cache.GetAsync(Presence.Key(w));
            if (v.Length == 0) { continue; }
            int count = Presence.Head(v);
            pages = pages + count;
            List<string> parts = v.Split(",");
            if (parts.Count <= 1 && count > 0) { unlisted = unlisted + count; }
            for (int i = 1; i < parts.Count; i = i + 1) {
                string ip = parts[i];
                if (ip.Length == 0) { continue; }
                if (seen.IndexOf("," + ip + ",") >= 0) { continue; }
                seen = seen + ip + ",";
            }
        }
        int distinct = 0;
        List<string> all = seen.Split(",");
        for (int i = 0; i < all.Count; i = i + 1) {
            if (all[i].Length > 0) { distinct = distinct + 1; }
        }
        distinct = distinct + unlisted;
        if (pages == 0) { return Presence.Local(); }
        if (distinct > pages) { return pages; }
        return distinct;
    }

    static int Local() {
        return Presence.pages;
    }

    static int Head(string slot) {
        int at = slot.IndexOf(",");
        string head = slot;
        if (at >= 0) { head = slot.Substring(0, at); }
        int n = 0;
        for (int i = 0; i < head.Length; i = i + 1) {
            string ch = head.Substring(i, 1);
            if (ch < "0" || ch > "9") { return 0; }
            n = n * 10 + (Convert.ToInt32(ch));
        }
        return n;
    }

    static string Key(int worker) {
        return "presence:w" + Convert.ToString(worker);
    }
}
