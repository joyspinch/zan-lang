using System;
using System.Data;
using System.Json;
using System.Net.External;
using System.Net.Http;
using System.Net.Http.Client;
using System.Text;
using System.Web;

namespace ZanWeb;

/* AI 助手：每个助手只是一段系统提示词。 */
class AiAgent {
    string code;
    string name;
    string hint;
    string icon;
    /* 是否允许将结果提交到数据库（建表）。 */
    bool apply;
    string prompt;

    AiAgent(string code, string name, string hint, string icon,
            bool apply, string prompt) {
        this.code = code;
        this.name = name;
        this.hint = hint;
        this.icon = icon;
        this.apply = apply;
        this.prompt = prompt;
    }
}

/* 预设的 AI 服务商：接口地址、模型、申请链接。 */
class AiVendor {
    string code;
    string name;
    string baseUrl;
    string model;
    string signup;

    AiVendor(string code, string name, string baseUrl, string model,
             string signup) {
        this.code = code;
        this.name = name;
        this.baseUrl = baseUrl;
        this.model = model;
        this.signup = signup;
    }
}

/* 流式返回的一段文本，用作 JSON 序列化对象。 */
class AiDeltaDoc {
    string text;
}

/* 一次对话的返回：成功返回文本，失败返回原因。 */
class AiReply {
    bool ok;
    string text;

    static AiReply Good(string text) {
        AiReply r = new AiReply();
        r.ok = true;
        r.text = text;
        return r;
    }

    static AiReply Bad(string why) {
        AiReply r = new AiReply();
        r.ok = false;
        r.text = why;
        return r;
    }
}

/* AI 入口：服务商预设、内置助手、与 OpenAI 兼容接口的调用。Key 仅存于设置表，不发送到浏览器。 */
