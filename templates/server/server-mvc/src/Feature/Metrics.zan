using System;
using System.Data;
using System.Data.Sqlite;
using System.Diagnostics;
using System.Text;
using System.Threading;
using System.Web;

namespace ZanWeb;

/// <summary>One minute of traffic for one interface: how often it was called, how
/// long it took, how badly it went, and -- for a stream -- how much was pushed
/// over it. This is the row the history screen reads and the shape kept in
/// memory between flushes.
///
/// It is also the table: the column names, the composite key `(minute, method,
/// path)` and the write statements are derived from this declaration by the
/// ORM. The monitor's read-side summaries use explicit database aggregation so
/// raw history rows never enter the process.</summary>
[Table(Name = "metrics_minute")]
class MetricMinute {
    [Column(IsPrimary = true)]
    long minute;     // epoch seconds truncated to the minute
    // The interface, as two fields rather than one joined string: the request
    // method and what served it -- a route's registration pattern
    // ("/api/index/index") or a mounted asset's path ("/static/js/admin.js").
    // A request nothing served has no name of its own and is never filed here.
    [Column(IsPrimary = true, StringLength = 16)]
    string method;
    [Column(IsPrimary = true, StringLength = 400)]
    string path;
    long calls;
    long errors;
    // MICROSECONDS, like every duration the server records: a request served
    // in 200us rounds to "0 ms", so a millisecond history of a fast endpoint
    // is a column of zeroes.
    [Column(Name = "total_us")]
    long totalUs;
    [Column(Name = "max_us")]
    long maxUs;
    /// Frames/messages pushed over a long-lived connection (SSE/WebSocket) --
    /// how a stream is measured, since its duration is not a latency.
    long frames;
    long bytes;
}

/// <summary>One day of one statement shape: how often it ran, how long it took
/// and how much of that was slow. A shape is the normalized statement (literals
/// replaced by placeholders), so `WHERE id = 7` and `WHERE id = 9` are one row
/// -- and no value a caller typed is ever stored here.</summary>
[Table(Name = "metrics_sql_day")]
class MetricSql {
    [Column(IsPrimary = true)]
    long day;        // epoch seconds truncated to midnight
    [Column(IsPrimary = true, StringLength = 400)]
    string sql;      // normalized statement shape
    long calls;
    long slow;       // executions at or over [log].slowSqlMs
    [Column(Name = "total_us")]
    long totalUs;    // MICROSECONDS, like every duration the server records
    [Column(Name = "max_us")]
    long maxUs;
}

/// <summary>One worker's published live row: which worker, how many seconds
/// ago it published, and the JSON it published. A read shape, not a table --
/// `age` is "now minus updated", computed per read.</summary>
class LiveRow {
    int worker;
    long age;
    string json;
}

/// <summary>One worker's row in the live table, overwritten in place on every
/// publish: the monitor reads ALL of them and shows the whole server, not
/// whichever worker happened to accept the page request. Keyed by worker id --
/// NOT an autoincrement id -- so a restarted worker replaces its own row
/// instead of adding a second one.</summary>
[Table(Name = "metrics_live")]
class MetricLive {
    [Column(IsPrimary = true, IsIdentity = false)]
    int worker;
    int pid;
    long updated;
    string snapshot;
    string series;
}

/// <summary>One persisted server error, for the backend error screen.</summary>
[Table(Name = "metrics_error")]
[Index(Name = "ix_metrics_error_ts", Fields = "ts")]
class MetricError {
    [Column(IsPrimary = true, IsIdentity = true)]
    long id;
    long ts;
    [Column(StringLength = 64)]
    string origin;
    string detail;
}

/// <summary>
/// The history behind the live monitor: per-minute, per-route counters and the
/// errors, kept in memory and written to their own database.
///
/// Why a second database: this is write-heavy operational data with a retention
/// policy of its own, and it must never contend with -- or be rolled back
/// alongside -- an application transaction. It is SQLite in WAL mode whatever
/// the application runs on, so the writer never blocks a reader.
///
/// Why buckets: a request costs an add to a minute bucket, never a write. The
/// buckets are flushed by one background coroutine on an interval
/// ([metrics].flushSeconds, one minute by default) or once enough of them have
/// piled up ([metrics].flushRows), and the in-memory list is capped so a
/// database that is down cannot grow the process without bound.
/// </summary>
class MetricsStore {
    static List<MetricMinute> buckets = new List<MetricMinute>();
    static List<MetricError> errors = new List<MetricError>();
    /// Statement shapes waiting to be written, accumulated per shape rather than
    /// per execution: a query that runs ten thousand times an hour is ten
    /// thousand additions to one entry, not ten thousand entries.
    static List<MetricSql> sqlBuckets = new List<MetricSql>();
    /// Hard ceiling on unflushed state: at one bucket per route per minute this
    /// is hours of traffic, and dropping the oldest beats growing forever.
    static int MaxBuckets = 8192;
    static int MaxErrors = 4096;
    /// Distinct statement shapes carried in memory. A shape past the ceiling is
    /// folded into one `OtherSql` row instead of being dropped: the day's query
    /// count has to stay a count of the queries that ran.
    static int MaxSqlShapes = 512;
    static string OtherSql = "(其他语句)";
    static DbPool pool = null;
    static bool ready = false;
    static bool flushing = false;
    static long lastSweep = 0;

    /// <summary>Opens metrics.db, creates the two tables, and starts the
    /// flusher. Called once per worker from main; a failure here leaves the
    /// server running without history rather than not running.</summary>
    static async bool Start() {
        if (!Cfg.Metrics.enabled) { return false; }
        Db.EnsureFileDir(Cfg.Metrics.path);
        MetricsStore.pool = SqliteConnector.Pool(Cfg.Metrics.path, 1);
        IDbConnection db = await MetricsStore.Lease();
        if (db == null) { return false; }
        try {
            // WAL: the flusher writes while the history screen reads.
            await DbSchema.UseWriteAheadLogAsync(db);
            // A history written by an older build measured something else: it
            // keyed a row by one `route` column holding an action name or a raw
            // request line, and it stored durations in whole milliseconds.
            // Those are different measurements, not renamed ones, so they are
            // set aside under their own name instead of being guessed into the
            // new columns -- and the new table starts clean.
            await MetricsStore.RetireLegacyMinutes(db);
            // CodeFirst: the four tables are the four entities. Missing tables
            // are created, missing columns added, declared indexes ensured --
            // which is also the upgrade path for a database an older build
            // left behind with fewer columns.
            //
            // SQL statistics are archived by DAY, not by minute: what an
            // operator asks of a statement ("how often did it run today, how
            // much of the day did it cost, how often was it slow") is a daily
            // question, and a per-minute row per shape would be a table tens of
            // times the size of the traffic history for an answer nothing reads.
            // The minute is only how OFTEN memory is emptied out -- the flusher
            // merges what it drained into today's row.
            await db.SyncStructureAsync<MetricMinute>();
            await db.SyncStructureAsync<MetricError>();
            await db.SyncStructureAsync<MetricSql>();
            await db.SyncStructureAsync<MetricLive>();
        } finally {
            MetricsStore.Give(db);
        }
        MetricsStore.ready = true;
        return true;
    }

    static async IDbConnection Lease() {
        if (MetricsStore.pool == null) { return null; }
        IDbConnection db = await MetricsStore.pool.AcquireAsync();
        if (db == null || !db.IsConnected()) {
            MetricsStore.pool.Release(db);
            return null;
        }
        return db;
    }

    static void Give(IDbConnection db) {
        if (MetricsStore.pool == null || db == null) { return; }
        MetricsStore.pool.Release(db);
    }

    /// <summary>The minute a timestamp belongs to.</summary>
    static long Minute(long sec) { return sec - (sec % 60); }

    /// <summary>The day a timestamp belongs to.</summary>
    static long Day(long sec) { return sec - (sec % 86400); }

    /// <summary>Sets aside a metrics_minute written by an older build: one that
    /// keyed a row by a single `route` column holding either an action name
    /// ("Users.Save") or a raw request line ("GET /wp-login.php"), or one that
    /// stored durations in whole milliseconds. Those rows are kept under
    /// metrics_minute_legacy rather than migrated: an action name is not a
    /// request path, and a millisecond that was already rounded to a 15ms tick
    /// cannot be turned back into microseconds -- multiplying it by 1000 would
    /// publish invented precision.</summary>
    static async void RetireLegacyMinutes(IDbConnection db) {
        try {
            bool exists = await DbSchema.TableExistsAsync(db,
                MetricMinuteCols.Table);
            if (!exists) { return; }
            // The tell is a column the current entity does not have: `route`
            // (the old key) or `total_ms` (the old unit).
            List<string> gone = new List<string> { "route", "total_ms" };
            bool old = await DbSchema.HasAnyColumnAsync(db,
                MetricMinuteCols.Table, gone);
            if (!old) { return; }
            await DbSchema.RenameTableAsync(db, MetricMinuteCols.Table,
                MetricMinuteCols.Table + "_legacy");
            Console.WriteLine("[metrics] history schema changed: previous "
                + "rows kept in metrics_minute_legacy");
        } catch (Exception ex) {
            // A history that cannot be inspected must not stop the server.
            Console.WriteLine("[metrics] legacy history check failed: "
                + ex.Message);
        }
    }

    /// <summary>Starts the flusher on the first thing worth flushing. It is
    /// started here rather than at startup because a coroutine only runs once
    /// the server is pumping its event loop: spawned from Start() it would sit
    /// unscheduled (and hold up the boot) instead of ticking.</summary>
    static void Arm() {
        if (MetricsStore.flushing || !MetricsStore.ready) { return; }
        MetricsStore.flushing = true;
        Task.Spawn(MetricsStore.Loop());
        Task.Spawn(MetricsCluster.Loop());
    }

    /// <summary>The bucket for this minute and interface, created if this is
    /// the first thing that happened to it.</summary>
    static MetricMinute Bucket(string method, string path) {
        MetricsStore.Arm();
        long m = MetricsStore.Minute((long)WebApp.NowSeconds());
        int n = MetricsStore.buckets.Count;
        // The current minute's buckets are at the end: a backwards scan finds
        // one in a handful of steps and never walks the history.
        for (int i = n - 1; i >= 0; i = i - 1) {
            MetricMinute b = MetricsStore.buckets[i];
            if (b.minute != m) { break; }
            if (b.method == method && b.path == path) { return b; }
        }
        MetricMinute b2 = new MetricMinute();
        b2.minute = m;
        b2.method = method;
        b2.path = path;
        MetricsStore.buckets.Add(b2);
        while (MetricsStore.buckets.Count > MetricsStore.MaxBuckets) {
            MetricsStore.buckets.RemoveAt(0);
        }
        return b2;
    }

    /// <summary>One finished request. `us` is the whole pipeline in
    /// microseconds; a hijacked connection (SSE/WebSocket) does not come
    /// through here -- see Pushed.</summary>
    static void Record(string method, string path, int status, long us) {
        if (!Cfg.Metrics.enabled) { return; }
        MetricMinute b = MetricsStore.Bucket(method, path);
        b.calls = b.calls + 1;
        b.totalUs = b.totalUs + us;
        if (us > b.maxUs) { b.maxUs = us; }
        if (status >= 500) { b.errors = b.errors + 1; }
    }

    /// <summary>What a long-lived connection is measured by: frames and bytes
    /// pushed, never elapsed time.</summary>
    static void Pushed(string method, string path, long frames, long bytes) {
        if (!Cfg.Metrics.enabled) { return; }
        MetricMinute b = MetricsStore.Bucket(method, path);
        b.frames = b.frames + frames;
        b.bytes = b.bytes + bytes;
    }

    /// <summary>One finished statement, folded into its shape's entry for today.
    /// `norm` is the NORMALIZED statement (ServerMetrics.NormalizeSql), so a
    /// literal a caller typed -- an address, a token, a password being checked --
    /// never reaches the database or the log. `us` is microseconds.
    ///
    /// Called from the DbTrace sink, on the coroutine that ran the statement:
    /// this adds to a list in memory and never writes, so a query costs a query.
    /// </summary>
    static void RecordSql(string norm, long us, bool slow) {
        if (!Cfg.Metrics.enabled) { return; }
        MetricsStore.Arm();
        MetricSql e = MetricsStore.SqlEntry(norm);
        e.calls = e.calls + 1;
        e.totalUs = e.totalUs + us;
        if (us > e.maxUs) { e.maxUs = us; }
        if (slow) { e.slow = e.slow + 1; }
    }

    /// <summary>Today's entry for a shape, created if this is the first time it
    /// ran. Once `MaxSqlShapes` shapes are held, everything new folds into the
    /// `OtherSql` entry -- a server generating unbounded statement shapes must
    /// not turn the monitor into a leak, and must not lose the count either.
    /// </summary>
    static MetricSql SqlEntry(string norm) {
        long d = MetricsStore.Day((long)WebApp.NowSeconds());
        for (int i = MetricsStore.sqlBuckets.Count - 1; i >= 0; i = i - 1) {
            MetricSql e = MetricsStore.sqlBuckets[i];
            if (e.day == d && e.sql == norm) { return e; }
        }
        if (MetricsStore.sqlBuckets.Count >= MetricsStore.MaxSqlShapes) {
            for (int i = 0; i < MetricsStore.sqlBuckets.Count; i = i + 1) {
                MetricSql o = MetricsStore.sqlBuckets[i];
                if (o.day == d && o.sql == MetricsStore.OtherSql) { return o; }
            }
            norm = MetricsStore.OtherSql;
        }
        MetricSql n = new MetricSql();
        n.day = d;
        n.sql = norm;
        MetricsStore.sqlBuckets.Add(n);
        return n;
    }

    /// <summary>Queues one error for the error screen. The detail is already
    /// redacted by the caller.</summary>
    static void Failed(long ts, string origin, string detail) {
        if (!Cfg.Metrics.enabled) { return; }
        MetricError e = new MetricError();
        e.ts = ts;
        e.origin = origin;
        e.detail = detail;
        MetricsStore.errors.Add(e);
        while (MetricsStore.errors.Count > MetricsStore.MaxErrors) {
            MetricsStore.errors.RemoveAt(0);
        }
    }

    /// <summary>The flusher. One coroutine per worker, awake once a second only
    /// to look at a counter.</summary>
    static async void Loop() {
        int waited = 0;
        while (true) {
            await Task.Delay(1000);
            waited = waited + 1;
            bool due = waited >= Cfg.Metrics.flushSeconds;
            bool full = MetricsStore.buckets.Count >= Cfg.Metrics.flushRows
                || MetricsStore.errors.Count >= Cfg.Metrics.flushRows
                || MetricsStore.sqlBuckets.Count >= Cfg.Metrics.flushRows;
            if (!due && !full) { continue; }
            waited = 0;
            await MetricsStore.Flush();
        }
    }

    /// <summary>Writes everything buffered in one transaction and clears it.
    /// The current minute is written too -- a worker that dies should not lose
    /// the minute it was in -- and re-flushing it later adds to the row that is
    /// already there.</summary>
    static async int Flush() {
        if (!MetricsStore.ready) { return 0; }
        if (MetricsStore.buckets.Count == 0 && MetricsStore.errors.Count == 0
            && MetricsStore.sqlBuckets.Count == 0) {
            return 0;
        }
        List<MetricMinute> mine = MetricsStore.buckets;
        List<MetricError> errs = MetricsStore.errors;
        List<MetricSql> sqls = MetricsStore.sqlBuckets;
        MetricsStore.buckets = new List<MetricMinute>();
        MetricsStore.errors = new List<MetricError>();
        MetricsStore.sqlBuckets = new List<MetricSql>();

        IDbConnection db = await MetricsStore.Lease();
        if (db == null) { return 0; }
        int written = 0;
        try {
            await db.BeginTransactionAsync();
            // Merged on write: the batch goes in as one statement and a row
            // that is already there for this (minute, method, path) takes the
            // counters ADDED to it and keeps the larger maximum. So a minute
            // re-flushed by this worker, or flushed by four workers at once,
            // ends as ONE row -- nothing raw is stored to be added up later.
            if (mine.Count > 0) {
                written = written + await db.Insert<MetricMinute>(mine)
                    .OnConflict(a => new { a.minute, a.method, a.path })
                    .SetIncr(a => a.calls)
                    .SetIncr(a => a.errors)
                    .SetIncr(a => a.totalUs)
                    .SetMax(a => a.maxUs)
                    .SetIncr(a => a.frames)
                    .SetIncr(a => a.bytes)
                    .ExecuteAffrowsAsync();
            }
            // The same merge by (day, sql): this worker flushes every minute,
            // the other workers flush their own, and all of it accumulates
            // into one row per shape per day.
            if (sqls.Count > 0) {
                written = written + await db.Insert<MetricSql>(sqls)
                    .OnConflict(a => new { a.day, a.sql })
                    .SetIncr(a => a.calls)
                    .SetIncr(a => a.slow)
                    .SetIncr(a => a.totalUs)
                    .SetMax(a => a.maxUs)
                    .ExecuteAffrowsAsync();
            }
            // Errors are events, not counters: each one is its own row, and
            // `id` is filled by the database.
            if (errs.Count > 0) {
                written = written + await db.Insert<MetricError>(errs)
                    .ExecuteAffrowsAsync();
            }
            await db.CommitAsync();
            await MetricsStore.Sweep(db);
        } catch (Exception ex) {
            await db.RollbackAsync();
            // Losing history is not worth failing a request over, and the
            // error sink itself must not recurse into the error sink.
            Console.WriteLine("[metrics] flush failed: " + ex.Message);
        } finally {
            MetricsStore.Give(db);
        }
        return written;
    }

    /// <summary>Drops anything past the retention window, at most once an
    /// hour.</summary>
    static async void Sweep(IDbConnection db) {
        long now = (long)WebApp.NowSeconds();
        if (now - MetricsStore.lastSweep < 3600) { return; }
        MetricsStore.lastSweep = now;
        long cut = now - (long)Cfg.Metrics.keepDays * 86400;
        long dayCut = MetricsStore.Day(cut);
        int _a = await db.Delete<MetricMinute>()
            .Where(a => a.minute < cut).ExecuteAffrowsAsync();
        int _b = await db.Delete<MetricError>()
            .Where(a => a.ts < cut).ExecuteAffrowsAsync();
        int _c = await db.Delete<MetricSql>()
            .Where(a => a.day < dayCut).ExecuteAffrowsAsync();
    }

    /// <summary>The statements the window was spent on, one row per shape,
    /// ranked by "calls" (how often it ran), "time" (how much of the window it
    /// cost) or "slow" (how often it was over the threshold). The window is
    /// given in seconds like every other query here and snapped to whole days,
    /// because that is the resolution the archive keeps.
    ///
    /// The database groups and ranks the day rows, so no raw archive rows are
    /// loaded into the worker.</summary>
    static async List<MetricSql> SqlTotals(long from, long to, int limit,
                                           string rank) {
        List<MetricSql> outp = new List<MetricSql>();
        if (!MetricsStore.ready) { return outp; }
        IDbConnection db = await MetricsStore.Lease();
        if (db == null) { return outp; }
        long a0 = MetricsStore.Day(from);
        long b0 = MetricsStore.Day(to);
        int order = 2;
        if (rank == "time") {
            order = 4;
        } else if (rank == "slow") {
            order = 3;
        }
        string sql = "SELECT sql, SUM(calls), SUM(slow), SUM(total_us), "
            + "MAX(max_us) FROM metrics_sql_day "
            + "WHERE day >= ? AND day <= ? "
            + "GROUP BY sql ORDER BY " + Convert.ToString(order)
            + " DESC LIMIT " + Convert.ToString(limit);
        DbParams prms = new DbParams().AddLong(a0).AddLong(b0);
        try {
            DbResult r = await db.QueryAsync(sql, prms);
            for (int i = 0; i < r.RowCount(); i = i + 1) {
                MetricSql e = new MetricSql();
                e.day = a0;
                e.sql = r.GetString(i, 0);
                e.calls = r.GetLong(i, 1);
                e.slow = r.GetLong(i, 2);
                e.totalUs = r.GetLong(i, 3);
                e.maxUs = r.GetLong(i, 4);
                outp.Add(e);
            }
        } finally {
            MetricsStore.Give(db);
        }
        return outp;
    }

    /// <summary>Aggregated history: one row per `stepSec` time bucket (a
    /// minute, an hour, a day or any other span), summed across interfaces --
    /// or over one of them when `method`/`path` filter -- newest first.
    ///
    /// The database groups, sums and limits the buckets, returning the newest
    /// bucket first.</summary>
    static async List<MetricMinute> HistoryBuckets(long from, long to,
                                                   string method, string path,
                                                   long stepSec, int limit) {
        List<MetricMinute> outp = new List<MetricMinute>();
        if (stepSec < 1) { stepSec = 60; }
        string sql = "SELECT minute - (minute % " + Convert.ToString(stepSec)
            + "), SUM(calls), SUM(errors), SUM(total_us), MAX(max_us), "
            + "SUM(frames), SUM(bytes) FROM metrics_minute "
            + "WHERE minute >= ? AND minute <= ?";
        DbParams prms = new DbParams().AddLong(from).AddLong(to);
        if (method.Length > 0) {
            sql = sql + " AND method = ?";
            prms.Add(method);
        }
        if (path.Length > 0) {
            sql = sql + " AND path = ?";
            prms.Add(path);
        }
        sql = sql + " GROUP BY minute - (minute % "
            + Convert.ToString(stepSec) + ") ORDER BY 1 DESC LIMIT "
            + Convert.ToString(limit);
        if (!MetricsStore.ready) { return outp; }
        IDbConnection db = await MetricsStore.Lease();
        if (db == null) { return outp; }
        try {
            DbResult r = await db.QueryAsync(sql, prms);
            for (int i = 0; i < r.RowCount(); i = i + 1) {
                MetricMinute b = new MetricMinute();
                b.minute = r.GetLong(i, 0);
                b.method = method;
                b.path = path;
                b.calls = r.GetLong(i, 1);
                b.errors = r.GetLong(i, 2);
                b.totalUs = r.GetLong(i, 3);
                b.maxUs = r.GetLong(i, 4);
                b.frames = r.GetLong(i, 5);
                b.bytes = r.GetLong(i, 6);
                outp.Add(b);
            }
        } finally {
            MetricsStore.Give(db);
        }
        return outp;
    }

    /// <summary>Per-interface totals over the window, busiest first: which
    /// endpoints carried the traffic, which were slow and which erred.
    /// `minute` is 0 -- these rows have no time axis.</summary>
    static async List<MetricMinute> RouteTotals(long from, long to,
                                                string method, string path,
                                                int limit) {
        return await MetricsStore.RouteTotalsBy(from, to, method, path, limit,
            "calls");
    }

    /// <summary>The same per-interface totals ranked by something else:
    /// "calls" (how often) or "time" (how much of the server's time the
    /// interface consumed). The two answer different questions -- an endpoint
    /// called twice a day can still be the one the server spends its
    /// afternoon in.
    ///
    /// The database groups, ranks and limits the interfaces.</summary>
    static async List<MetricMinute> RouteTotalsBy(long from, long to,
                                                  string method, string path,
                                                  int limit, string rank) {
        List<MetricMinute> outp = new List<MetricMinute>();
        int firstOrder = 3;
        int secondOrder = 5;
        if (rank == "time") {
            firstOrder = 5;
            secondOrder = 3;
        }
        string sql = "SELECT method, path, SUM(calls), SUM(errors), "
            + "SUM(total_us), MAX(max_us), SUM(frames), SUM(bytes) "
            + "FROM metrics_minute WHERE minute >= ? AND minute <= ?";
        DbParams prms = new DbParams().AddLong(from).AddLong(to);
        if (method.Length > 0) {
            sql = sql + " AND method = ?";
            prms.Add(method);
        }
        if (path.Length > 0) {
            sql = sql + " AND path = ?";
            prms.Add(path);
        }
        sql = sql + " GROUP BY method, path ORDER BY "
            + Convert.ToString(firstOrder) + " DESC, "
            + Convert.ToString(secondOrder) + " DESC LIMIT "
            + Convert.ToString(limit);
        if (!MetricsStore.ready) { return outp; }
        IDbConnection db = await MetricsStore.Lease();
        if (db == null) { return outp; }
        try {
            DbResult r = await db.QueryAsync(sql, prms);
            for (int i = 0; i < r.RowCount(); i = i + 1) {
                MetricMinute e = new MetricMinute();
                e.minute = 0;
                e.method = r.GetString(i, 0);
                e.path = r.GetString(i, 1);
                e.calls = r.GetLong(i, 2);
                e.errors = r.GetLong(i, 3);
                e.totalUs = r.GetLong(i, 4);
                e.maxUs = r.GetLong(i, 5);
                e.frames = r.GetLong(i, 6);
                e.bytes = r.GetLong(i, 7);
                outp.Add(e);
            }
        } finally {
            MetricsStore.Give(db);
        }
        return outp;
    }

    /// <summary>The database returns one aggregate row for the window. SQL NULL
    /// aggregate cells are exposed as zero by DbResult.GetLong; empty windows
    /// therefore retain the non-null zero row contract.</summary>
    static async MetricMinute WindowTotals(long from, long to, string method,
                                           string path) {
        MetricMinute b = new MetricMinute();
        b.minute = from;
        b.method = method;
        b.path = path;
        if (!MetricsStore.ready) { return b; }
        string sql = "SELECT SUM(calls), SUM(errors), SUM(total_us), "
            + "MAX(max_us), SUM(frames), SUM(bytes) FROM metrics_minute "
            + "WHERE minute >= ? AND minute <= ?";
        DbParams prms = new DbParams().AddLong(from).AddLong(to);
        if (method.Length > 0) {
            sql = sql + " AND method = ?";
            prms.Add(method);
        }
        if (path.Length > 0) {
            sql = sql + " AND path = ?";
            prms.Add(path);
        }
        IDbConnection db = await MetricsStore.Lease();
        if (db == null) { return b; }
        try {
            DbResult r = await db.QueryAsync(sql, prms);
            if (r.RowCount() > 0) {
                b.calls = r.GetLong(0, 0);
                b.errors = r.GetLong(0, 1);
                b.totalUs = r.GetLong(0, 2);
                b.maxUs = r.GetLong(0, 3);
                b.frames = r.GetLong(0, 4);
                b.bytes = r.GetLong(0, 5);
            }
        } finally {
            MetricsStore.Give(db);
        }
        return b;
    }

    /// <summary>Persisted errors, newest first.</summary>
    static async List<MetricError> Errors(long from, long to, int limit) {
        List<MetricError> outp = new List<MetricError>();
        if (!MetricsStore.ready) { return outp; }
        IDbConnection db = await MetricsStore.Lease();
        if (db == null) { return outp; }
        try {
            outp = await db.Select<MetricError>()
                .Where(a => a.ts >= from && a.ts <= to)
                .OrderByDescending(a => a.id)
                .Limit(limit)
                .ToListAsync();
        } finally {
            MetricsStore.Give(db);
        }
        return outp;
    }
}

/// <summary>
/// The whole server's live numbers, not one worker's. Every counter behind
/// the monitor lives in the worker process that served the request, so with
/// [worker].count > 1 a page that read its own process would show a different
/// worker on every refresh. Instead each worker publishes its snapshot into
/// metrics_live (one row per worker, overwritten in place, every couple of
/// seconds), and the reader merges every row that is still fresh: counters
/// add, maxima take the max, averages are weighted by their counts, CPU and
/// RSS add across processes. With a single worker the merge degenerates to
/// that worker's own snapshot.
/// </summary>
class MetricsCluster {
    /// How often each worker publishes, and how old a row may be before its
    /// per-second series is too stale to plot. Totals are NOT subject to this
    /// window: a cumulative counter that disappears makes the whole page jump
    /// backwards (the symptom is numbers that come and go on refresh), so a
    /// worker's last published totals keep counting until its row is replaced
    /// -- the row is keyed by worker id, so a restarted worker overwrites its
    /// own row rather than adding a second one.
    static int PublishSeconds = 2;
    static int FreshSeconds = 30;

    /// <summary>One background coroutine per worker (spawned from
    /// MetricsStore.Arm), so the row is fresh even for workers the monitor's
    /// own requests never land on.</summary>
    static async void Loop() {
        while (true) {
            await Task.Delay(MetricsCluster.PublishSeconds * 1000);
            await MetricsCluster.Publish();
        }
    }

    /// <summary>Writes this worker's snapshot + series over its own row.</summary>
    static async void Publish() {
        if (!MetricsStore.ready) { return; }
        WebApp app = WebHost.Current();
        if (app == null) { return; }
        IDbConnection db = await MetricsStore.Lease();
        if (db == null) { return; }
        try {
            MetricLive row = new MetricLive();
            row.worker = ProcessHost.WorkerId();
            row.pid = ProcessHost.Pid();
            row.updated = (long)WebApp.NowSeconds();
            row.snapshot = app.MetricsJson();
            row.series = app.MetricsSeriesJson(120);
            // One row per worker, overwritten in place: on a conflicting
            // `worker` the columns not named as counters take the new values.
            int _n = await db.Insert<MetricLive>(row)
                .OnConflict(a => a.worker)
                .ExecuteAffrowsAsync();
        } catch (Exception ex) {
            Console.WriteLine("[metrics] live publish failed: " + ex.Message);
        } finally {
            MetricsStore.Give(db);
        }
    }

    /// <summary>Every worker's published `col` ("snapshot" or "series") with
    /// how old it is, in worker order. `maxAgeSec` 0 means every row however
    /// old: for cumulative totals an old row is a lagging total, and dropping
    /// it would subtract that worker's whole history from the page. Only the
    /// per-second series passes an age limit, because a stale point plotted at
    /// "now" is a wrong point rather than a late one.</summary>
    static async List<LiveRow> LiveRows(string col, int maxAgeSec) {
        List<LiveRow> outp = new List<LiveRow>();
        if (!MetricsStore.ready) { return outp; }
        IDbConnection db = await MetricsStore.Lease();
        if (db == null) { return outp; }
        try {
            long now = (long)WebApp.NowSeconds();
            long cut = now - (long)maxAgeSec;
            bool fresh = maxAgeSec > 0;
            List<MetricLive> rows = await db.Select<MetricLive>()
                .WhereIf(fresh, a => a.updated >= cut)
                .OrderBy(a => a.worker)
                .ToListAsync();
            for (int i = 0; i < rows.Count; i = i + 1) {
                MetricLive m = rows[i];
                LiveRow w = new LiveRow();
                w.worker = m.worker;
                w.age = now - m.updated;
                if (w.age < 0) { w.age = 0; }
                // Which of the two published documents the caller asked for --
                // a field pick in Zan, not a column name in a statement.
                w.json = col == "series" ? m.series : m.snapshot;
                outp.Add(w);
            }
        } finally {
            MetricsStore.Give(db);
        }
        return outp;
    }

    /// <summary>The merged snapshot: same shape MetricsJson produces, so the
    /// page's painter does not know how many processes it is looking at. Adds
    /// `workers` (how many are live), `worker_list`, and `processes` -- one row
    /// per publishing process, which is the only part of the page that is NOT
    /// merged: a summed CPU or request count says nothing about which worker is
    /// carrying the traffic or has stopped answering.</summary>
    static async string SnapshotJson() {
        WebApp app = WebHost.Current();
        await MetricsCluster.Publish();   // this worker is always current
        List<LiveRow> rows = await MetricsCluster.LiveRows("snapshot", 0);
        List<JsonValue> ms = new List<JsonValue>();
        List<LiveRow> kept = new List<LiveRow>();
        int live = 0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            LiveRow w = rows[i];
            JsonValue m = JsonValue.ParseLenient(w.json);
            if (m == null || !m.IsObject()) { continue; }
            ms.Add(m);
            kept.Add(w);
            if (w.age <= (long)MetricsCluster.FreshSeconds) { live = live + 1; }
        }

        string own = app.MetricsJson();
        if (ms.Count <= 1) {
            // One process publishing (or no store at all): its own snapshot IS
            // the server's, and the process table has the one row this request
            // is being served by. Taken from this process rather than from its
            // published row, which is up to a publish interval old.
            JsonValue o = JsonValue.ParseLenient(own);
            if (o == null || !o.IsObject()) { return own; }
            List<JsonValue> self = new List<JsonValue>();
            self.Add(o);
            List<LiveRow> selfRow = new List<LiveRow>();
            LiveRow r = new LiveRow();
            r.worker = ProcessHost.WorkerId();
            r.age = 0;
            r.json = own;
            selfRow.Add(r);
            o.Put("processes", MetricsCluster.ProcessesJson(selfRow, self));
            // The fleet fields the merge adds, which a single worker's own
            // snapshot does not carry: without them the page reads "存活  个"
            // and cannot tell one worker from an unknown number of them.
            o.Put("workers", MetricsCluster.Num(1));
            o.Put("workers_counted", MetricsCluster.Num(1));
            o.Put("worker_list", JsonValue.NewStr(
                Convert.ToString(ProcessHost.WorkerId())));
            return o.ToJson();
        }
        JsonValue merged = JsonValue.ParseLenient(
            MetricsCluster.MergeSnapshots(ms, live));
        if (merged == null || !merged.IsObject()) { return own; }
        merged.Put("processes", MetricsCluster.ProcessesJson(kept, ms));
        return merged.ToJson();
    }

    /// <summary>One row per process behind the server: who it is (worker id,
    /// pid), how long it has been up, what it has served and what it costs.
    /// `age` is how many seconds ago the row was published and `live` whether
    /// that is still within FreshSeconds -- a worker that died keeps its row,
    /// marked stale, because a row that simply disappeared would read as "the
    /// server has fewer workers now" without saying that one stopped.</summary>
    static JsonValue ProcessesJson(List<LiveRow> rows, List<JsonValue> ms) {
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < ms.Count; i = i + 1) {
            JsonValue m = ms[i];
            long age = 0;
            int wid = (int)m.Long("worker_id", 0);
            if (i < rows.Count) {
                age = rows[i].age;
                wid = rows[i].worker;
            }
            JsonValue o = JsonValue.NewObject();
            o.Put("worker", MetricsCluster.Num(wid));
            o.Put("pid", MetricsCluster.Num(m.Long("pid", 0)));
            o.Put("uptime_ms", MetricsCluster.Num(m.Long("uptime_ms", 0)));
            o.Put("cpu_percent", MetricsCluster.Num(m.Long("cpu_percent", 0 - 1)));
            o.Put("cpu_ms", MetricsCluster.Num(m.Long("cpu_ms", 0)));
            o.Put("mem_rss_bytes", MetricsCluster.Num(m.Long("mem_rss_bytes", 0)));
            JsonValue rq = m.Get("requests");
            long n = 0;
            if (rq != null) {
                n = rq.Long("count", 0);
                o.Put("errors", MetricsCluster.Num(rq.Long("errors", 0)));
                o.Put("avg_us", MetricsCluster.Num(rq.Long("avg_us", 0)));
                o.Put("max_us", MetricsCluster.Num(rq.Long("max_us", 0)));
            }
            o.Put("requests", MetricsCluster.Num(n));
            JsonValue ld = m.Get("load");
            if (ld != null) {
                o.Put("concurrent", MetricsCluster.Num(ld.Long("concurrent", 0)));
                o.Put("streams", MetricsCluster.Num(ld.Long("streams", 0)));
            }
            JsonValue qs = m.Get("queries");
            if (qs != null) {
                o.Put("queries", MetricsCluster.Num(qs.Long("count", 0)));
            }
            o.Put("age", MetricsCluster.Num(age));
            long alive = 0;
            if (age <= (long)MetricsCluster.FreshSeconds) { alive = 1; }
            o.Put("live", MetricsCluster.Num(alive));
            arr.Append(o);
        }
        return arr;
    }

    static string MergeSnapshots(List<JsonValue> ms, int live) {
        long upt = 0;
        long cpuPct = 0;
        long rss = 0;
        long rCount = 0;
        long rErrors = 0;
        long rFailed = 0;
        long rRejected = 0;
        long rAvgW = 0;
        long rMax = 0;
        long rSlowTh = 0;
        long rSlowN = 0;
        long qCount = 0;
        long qAvgW = 0;
        long qMax = 0;
        long qSlowTh = 0;
        long qSlowN = 0;
        long lConc = 0;
        long lPeak = 0;
        long lStreams = 0;
        long lFrames = 0;
        long lBytes = 0;
        StringBuilder wl = new StringBuilder();
        JsonValue topReq = JsonValue.NewArray();
        JsonValue topSql = JsonValue.NewArray();
        for (int i = 0; i < ms.Count; i = i + 1) {
            JsonValue m = ms[i];
            if (i > 0) { wl.Append(","); }
            wl.Append(Convert.ToString(m.Long("worker_id", 0)));
            if (m.Long("uptime_ms", 0) > upt) { upt = m.Long("uptime_ms", 0); }
            long c = m.Long("cpu_percent", 0 - 1);
            if (c > 0) { cpuPct = cpuPct + c; }
            long rb = m.Long("mem_rss_bytes", 0 - 1);
            if (rb > 0) { rss = rss + rb; }
            JsonValue rq = m.Get("requests");
            if (rq != null) {
                long n = rq.Long("count", 0);
                rCount = rCount + n;
                rErrors = rErrors + rq.Long("errors", 0);
                rFailed = rFailed + rq.Long("failed", 0);
                rRejected = rRejected + rq.Long("rejected", 0);
                rAvgW = rAvgW + n * rq.Long("avg_us", 0);
                if (rq.Long("max_us", 0) > rMax) { rMax = rq.Long("max_us", 0); }
                rSlowTh = rq.Long("slow_threshold_us", 0);
                rSlowN = rSlowN + rq.Long("slow_count", 0);
            }
            JsonValue qs = m.Get("queries");
            if (qs != null) {
                long n2 = qs.Long("count", 0);
                qCount = qCount + n2;
                qAvgW = qAvgW + n2 * qs.Long("avg_us", 0);
                if (qs.Long("max_us", 0) > qMax) { qMax = qs.Long("max_us", 0); }
                qSlowTh = qs.Long("slow_threshold_us", 0);
                qSlowN = qSlowN + qs.Long("slow_count", 0);
            }
            JsonValue ld = m.Get("load");
            if (ld != null) {
                lConc = lConc + ld.Long("concurrent", 0);
                lPeak = lPeak + ld.Long("peak", 0);
                lStreams = lStreams + ld.Long("streams", 0);
                lFrames = lFrames + ld.Long("stream_frames", 0);
                lBytes = lBytes + ld.Long("stream_bytes", 0);
            }
            MetricsCluster.MergeTop(topReq, m.Get("top_requests"), "req");
            MetricsCluster.MergeTop(topSql, m.Get("top_sql"), "sql");
        }

        JsonValue requests = JsonValue.NewObject();
        requests.Put("count", MetricsCluster.Num(rCount));
        requests.Put("errors", MetricsCluster.Num(rErrors));
        requests.Put("failed", MetricsCluster.Num(rFailed));
        requests.Put("rejected", MetricsCluster.Num(rRejected));
        long rAvg = 0;
        if (rCount > 0) { rAvg = rAvgW / rCount; }
        requests.Put("avg_us", MetricsCluster.Num(rAvg));
        requests.Put("max_us", MetricsCluster.Num(rMax));
        requests.Put("slow_threshold_us", MetricsCluster.Num(rSlowTh));
        requests.Put("slow_count", MetricsCluster.Num(rSlowN));

        JsonValue queries = JsonValue.NewObject();
        queries.Put("count", MetricsCluster.Num(qCount));
        long qAvg = 0;
        if (qCount > 0) { qAvg = qAvgW / qCount; }
        queries.Put("avg_us", MetricsCluster.Num(qAvg));
        queries.Put("max_us", MetricsCluster.Num(qMax));
        queries.Put("slow_threshold_us", MetricsCluster.Num(qSlowTh));
        queries.Put("slow_count", MetricsCluster.Num(qSlowN));

        JsonValue load = JsonValue.NewObject();
        load.Put("concurrent", MetricsCluster.Num(lConc));
        load.Put("peak", MetricsCluster.Num(lPeak));
        load.Put("streams", MetricsCluster.Num(lStreams));
        load.Put("stream_frames", MetricsCluster.Num(lFrames));
        load.Put("stream_bytes", MetricsCluster.Num(lBytes));

        JsonValue o = JsonValue.NewObject();
        o.Put("uptime_ms", MetricsCluster.Num(upt));
        o.Put("pid", MetricsCluster.Num(ProcessHost.Pid()));
        o.Put("worker_id", MetricsCluster.Num(ProcessHost.WorkerId()));
        o.Put("workers", MetricsCluster.Num(live));
        // Every worker whose totals are in this merge, including ones that have
        // stopped publishing: the difference is what tells a reader that a
        // worker died rather than that traffic vanished.
        o.Put("workers_counted", MetricsCluster.Num(ms.Count));
        o.Put("worker_list", JsonValue.NewStr(wl.ToString()));
        o.Put("cpu_percent", MetricsCluster.Num(cpuPct));
        o.Put("mem_rss_bytes", MetricsCluster.Num(rss));
        o.Put("requests", requests);
        o.Put("queries", queries);
        o.Put("load", load);
        o.Put("top_requests", MetricsCluster.SortTop(topReq));
        o.Put("top_sql", MetricsCluster.SortTop(topSql));
        return o.ToJson();
    }

    /// <summary>Folds one worker's top list into the merged one: rows with the
    /// same key add their counts and total_ms, keep the larger max, and the
    /// average is recomputed from the merged totals.</summary>
    static void MergeTop(JsonValue merged, JsonValue add, string key) {
        if (add == null || !add.IsArray()) { return; }
        for (int i = 0; i < add.Count(); i = i + 1) {
            JsonValue s = add.At(i);
            string k = s.Str(key, "");
            JsonValue hit = null;
            for (int j = 0; j < merged.Count(); j = j + 1) {
                if (merged.At(j).Str(key, "") == k) { hit = merged.At(j); break; }
            }
            if (hit == null) {
                JsonValue row = JsonValue.NewObject();
                row.Put(key, JsonValue.NewStr(k));
                row.Put("count", MetricsCluster.Num(s.Long("count", 0)));
                row.Put("errors", MetricsCluster.Num(s.Long("errors", 0)));
                row.Put("failed", MetricsCluster.Num(s.Long("failed", 0)));
                row.Put("rejected", MetricsCluster.Num(s.Long("rejected", 0)));
                row.Put("total_us", MetricsCluster.Num(s.Long("total_us", 0)));
                row.Put("max_us", MetricsCluster.Num(s.Long("max_us", 0)));
                MetricsCluster.Reavg(row);
                merged.Append(row);
                continue;
            }
            hit.Set("count", MetricsCluster.Num(hit.Long("count", 0)
                + s.Long("count", 0)));
            hit.Set("errors", MetricsCluster.Num(hit.Long("errors", 0)
                + s.Long("errors", 0)));
            hit.Set("failed", MetricsCluster.Num(hit.Long("failed", 0)
                + s.Long("failed", 0)));
            hit.Set("rejected", MetricsCluster.Num(hit.Long("rejected", 0)
                + s.Long("rejected", 0)));
            hit.Set("total_us", MetricsCluster.Num(hit.Long("total_us", 0)
                + s.Long("total_us", 0)));
            if (s.Long("max_us", 0) > hit.Long("max_us", 0)) {
                hit.Set("max_us", MetricsCluster.Num(s.Long("max_us", 0)));
            }
            MetricsCluster.Reavg(hit);
        }
    }

    static void Reavg(JsonValue row) {
        long n = row.Long("count", 0);
        long avg = 0;
        if (n > 0) { avg = row.Long("total_us", 0) / n; }
        row.Set("avg_us", MetricsCluster.Num(avg));
    }

    /// <summary>Busiest first, by cumulative time, capped at 20 like the
    /// per-worker lists. Selection sort: the list is at most a few dozen
    /// rows.</summary>
    static JsonValue SortTop(JsonValue arr) {
        int n = arr.Count();
        List<JsonValue> rows = new List<JsonValue>();
        for (int i = 0; i < n; i = i + 1) { rows.Add(arr.At(i)); }
        for (int a = 0; a < rows.Count - 1; a = a + 1) {
            int best = a;
            for (int b = a + 1; b < rows.Count; b = b + 1) {
                if (rows[b].Long("total_us", 0) > rows[best].Long("total_us", 0)) {
                    best = b;
                }
            }
            if (best != a) {
                JsonValue tmp = rows[a];
                rows[a] = rows[best];
                rows[best] = tmp;
            }
        }
        JsonValue outp = JsonValue.NewArray();
        int keep = rows.Count;
        if (keep > 20) { keep = 20; }
        for (int i = 0; i < keep; i = i + 1) { outp.Append(rows[i]); }
        return outp;
    }

    /// <summary>The merged per-second series: requests and errors add, latency
    /// averages weight by requests, p95/max take the worst worker, CPU and RSS
    /// add across processes. Field names and units are the ones a single
    /// worker's MetricsSeriesJson produces (durations in microseconds, `_us`),
    /// because the page paints both shapes with the same code.</summary>
    static async string SeriesJson(int seconds) {
        WebApp app = WebHost.Current();
        List<LiveRow> rows = await MetricsCluster.LiveRows("series",
            MetricsCluster.FreshSeconds);
        if (rows.Count <= 1) { return app.MetricsSeriesJson(seconds); }
        int want = seconds;
        if (want <= 0) { want = 120; }
        long[] req = new long[want];
        long[] err = new long[want];
        long[] avgW = new long[want];
        long[] p95 = new long[want];
        long[] max = new long[want];
        long[] q = new long[want];
        long[] qavgW = new long[want];
        long[] cpu = new long[want];
        long[] rssArr = new long[want];
        int merged = 0;
        for (int i = 0; i < rows.Count; i = i + 1) {
            JsonValue s = JsonValue.ParseLenient(rows[i].json);
            if (s == null || !s.IsObject()) { continue; }
            JsonValue pts = s.Get("points");
            if (pts == null || !pts.IsArray()) { continue; }
            merged = merged + 1;
            // Each worker numbers its points from its OWN "now", so a row
            // published two seconds ago describes two seconds ago: shifting it
            // back by its age is what keeps one second of the chart made of the
            // same second from every worker (unshifted, the last buckets mix
            // full seconds with partial ones and the line flickers).
            int shift = (int)rows[i].age;
            for (int j = 0; j < pts.Count(); j = j + 1) {
                JsonValue p = pts.At(j);
                long t = p.Long("t", 1);
                if (t > 0) { continue; }
                int idx = want - 1 + (int)t - shift;    // t: -(want-1)..0
                if (idx < 0 || idx >= want) { continue; }
                long r = p.Long("req", 0);
                req[idx] = req[idx] + r;
                err[idx] = err[idx] + p.Long("err", 0);
                avgW[idx] = avgW[idx] + r * p.Long("avg_us", 0);
                if (p.Long("p95_us", 0) > p95[idx]) { p95[idx] = p.Long("p95_us", 0); }
                if (p.Long("max_us", 0) > max[idx]) { max[idx] = p.Long("max_us", 0); }
                long qn = p.Long("queries", 0);
                q[idx] = q[idx] + qn;
                qavgW[idx] = qavgW[idx] + qn * p.Long("query_avg_us", 0);
                long c = p.Long("cpu_percent", 0 - 1);
                if (c > 0) { cpu[idx] = cpu[idx] + c; }
                long rb = p.Long("mem_rss_bytes", 0 - 1);
                if (rb > 0) { rssArr[idx] = rssArr[idx] + rb; }
            }
        }
        if (merged <= 1) { return app.MetricsSeriesJson(seconds); }
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"step_ms\":1000,\"count\":");
        sb.Append(Convert.ToString(want));
        sb.Append(",\"workers\":");
        sb.Append(Convert.ToString(merged));
        sb.Append(",\"points\":[");
        for (int idx = 0; idx < want; idx = idx + 1) {
            if (idx > 0) { sb.Append(","); }
            long avg = 0;
            if (req[idx] > 0) { avg = avgW[idx] / req[idx]; }
            long qavg = 0;
            if (q[idx] > 0) { qavg = qavgW[idx] / q[idx]; }
            sb.Append("{\"t\":");
            sb.Append(Convert.ToString((long)idx - (long)want + 1));
            sb.Append(",\"req\":");
            sb.Append(Convert.ToString(req[idx]));
            sb.Append(",\"err\":");
            sb.Append(Convert.ToString(err[idx]));
            sb.Append(",\"avg_us\":");
            sb.Append(Convert.ToString(avg));
            sb.Append(",\"p95_us\":");
            sb.Append(Convert.ToString(p95[idx]));
            sb.Append(",\"max_us\":");
            sb.Append(Convert.ToString(max[idx]));
            sb.Append(",\"queries\":");
            sb.Append(Convert.ToString(q[idx]));
            sb.Append(",\"query_avg_us\":");
            sb.Append(Convert.ToString(qavg));
            sb.Append(",\"cpu_percent\":");
            sb.Append(Convert.ToString(cpu[idx]));
            sb.Append(",\"mem_rss_bytes\":");
            sb.Append(Convert.ToString(rssArr[idx]));
            sb.Append("}");
        }
        sb.Append("]}");
        return sb.ToString();
    }

    static JsonValue Num(long v) {
        return JsonValue.NewNum(Convert.ToString(v));
    }
}
