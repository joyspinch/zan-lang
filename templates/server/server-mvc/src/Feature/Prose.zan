using System;

namespace ZanWeb;

/// <summary>
/// Text helpers for article rendering. Everything here counts CHARACTERS, not
/// bytes: a Chinese character is three bytes in UTF-8, so a byte-wise
/// Substring() would cut one in half and produce a broken glyph at the end of
/// every excerpt.
/// </summary>
class Prose {
    /// <summary>Length in bytes of the UTF-8 sequence starting at `i`.</summary>
    static int RuneLen(string s, int i) {
        int b = (int)s[i] & 255;
        if (b < 128) { return 1; }
        if (b >= 240) { return 4; }
        if (b >= 224) { return 3; }
        if (b >= 192) { return 2; }
        return 1;
    }

    /// <summary>Number of characters in the string.</summary>
    static int Runes(string s) {
        int n = 0;
        int i = 0;
        while (i < s.Length) {
            i = i + Prose.RuneLen(s, i);
            n = n + 1;
        }
        return n;
    }

    /// <summary>The first `max` characters, with an ellipsis when the text was
    /// longer. Newlines collapse to spaces: an excerpt is one line.</summary>
    static string Excerpt(string s, int max) {
        string flat = s.Replace("\r", " ").Replace("\n", " ").Trim();
        int i = 0;
        int n = 0;
        while (i < flat.Length && n < max) {
            i = i + Prose.RuneLen(flat, i);
            n = n + 1;
        }
        if (i >= flat.Length) { return flat; }
        return flat.Substring(0, i) + "…";
    }

    /// <summary>Reading time in minutes, at ~400 characters a minute, never
    /// less than one.</summary>
    static int Minutes(string body) {
        int n = Prose.Runes(body) / 400;
        if (n < 1) { return 1; }
        return n;
    }

    /// <summary>The body as paragraphs: blank-line separated blocks, so an
    /// article renders as prose instead of one wall of Prose.</summary>
    static List<string> Paragraphs(string body) {
        List<string> outp = new List<string>();
        string norm = body.Replace("\r\n", "\n").Replace("\r", "\n");
        int start = 0;
        for (int i = 0; i <= norm.Length; i = i + 1) {
            bool end = i == norm.Length;
            if (!end && (norm[i] & 255) != 10) { continue; }
            string line = norm.Substring(start, i - start).Trim();
            start = i + 1;
            if (line.Length > 0) { outp.Add(line); }
        }
        return outp;
    }

    /// <summary>Splits a comma-separated tag list into trimmed values.</summary>
    static List<string> Tags(string tags) {
        List<string> outp = new List<string>();
        string norm = tags.Replace("，", ",");
        int start = 0;
        for (int i = 0; i <= norm.Length; i = i + 1) {
            bool end = i == norm.Length;
            if (!end && (norm[i] & 255) != 44) { continue; }
            string tag = norm.Substring(start, i - start).Trim();
            start = i + 1;
            if (tag.Length > 0) { outp.Add(tag); }
        }
        return outp;
    }
}
