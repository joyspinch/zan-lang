using System;

namespace ZanWeb;

/* AI 外呼目标白名单。比较完整 URL，避免 host 子串、重定向或端口变体绕过策略。 */
class AiEndpointPolicy {
    static bool IsAllowed(string url) {
        if (url == null || url.Length == 0) { return false; }
        return String.CompareOrdinal(url, "https://api.deepseek.com/v1") == 0
            || String.CompareOrdinal(url, "https://api.openai.com/v1") == 0
            || String.CompareOrdinal(url,
                "https://dashscope.aliyuncs.com/compatible-mode/v1") == 0
            || String.CompareOrdinal(url,
                "https://open.bigmodel.cn/api/paas/v4") == 0
            || String.CompareOrdinal(url, "https://api.moonshot.cn/v1") == 0
            || String.CompareOrdinal(url,
                "http://127.0.0.1:11434/v1") == 0;
    }

    static bool IsLocal(string url) {
        return url != null && String.CompareOrdinal(url,
            "http://127.0.0.1:11434/v1") == 0;
    }
}
