using System;
using System.Net.External;

namespace ZanWeb;

/* AI 外呼目标白名单。共享解析器先拒绝 userinfo、非法 authority、fragment、
 * 编码变体和危险字面量，再做 provider 的 canonical URL 精确匹配。 */
class AiEndpointPolicy {
    static bool IsAllowed(string url) {
        return AiEndpointPolicy.IsRemoteAllowed(url)
            || AiEndpointPolicy.IsLocal(url);
    }

    static bool IsRemoteAllowed(string url) {
        return AiEndpointPolicy.Exact(url,
                    "https://api.deepseek.com/v1")
            || AiEndpointPolicy.Exact(url,
                    "https://api.openai.com/v1")
            || AiEndpointPolicy.Exact(url,
                    "https://dashscope.aliyuncs.com/compatible-mode/v1")
            || AiEndpointPolicy.Exact(url,
                    "https://open.bigmodel.cn/api/paas/v4")
            || AiEndpointPolicy.Exact(url,
                    "https://api.moonshot.cn/v1");
    }

    static bool Exact(string url, string expected) {
        return url != null && url == expected
            && ExternalTargetPolicy.AllowExact(url, expected);
    }

    static bool IsLocal(string url) {
        return ExternalTargetPolicy.IsLocalAllowed(url)
            && ExternalTargetPolicy.AllowExactLocal(url,
                "http://127.0.0.1:11434/v1");
    }
}
