using System;
using System.Data;
using System.Data.Orm;
using System.Text;
using System.Web;
using ZanWeb.Model.Sys;

namespace ZanWeb;

/* 表设计器引擎：将设计（GenTable+GenColumn）生成 DDL 与 .zan 源码。标识符经 Safe() 校验，值使用参数绑定。 */
class Gen {
    /* 判断标识符是否安全：字母开头，仅含小写字母、数字与下划线。 */
    static bool Safe(string name) {
        if (name == null) { return false; }
        int n = name.Length;
        if (n == 0 || n > 64) { return false; }
        for (int i = 0; i < n; i = i + 1) {
            string ch = name.Substring(i, 1);
            bool lower = ch >= "a" && ch <= "z";
            bool digit = ch >= "0" && ch <= "9";
            if (i == 0 && !lower) { return false; }
            if (!lower && !digit && ch != "_") { return false; }
        }
        return true;
    }

    /* 将设计列转为 DbColumnDef，自动加 identity id。 */
    static List<DbColumnDef> Columns(List<GenColumn> cols) {
        List<DbColumnDef> defs = new List<DbColumnDef>();
        defs.Add(DbColumnDef.Identity("id"));
        for (int i = 0; i < cols.Count; i = i + 1) {
            GenColumn c = cols[i];
            if (c.name == "id") { continue; }
            DbColumnDef d = DbColumnDef.Of(c.name, c.kind).WithSize(c.size)
                .WithNull(c.nullable == 1);
            if (c.defValue.Length > 0) { d = d.WithDefault(c.defValue); }
            defs.Add(d);
        }
        return defs;
    }

    /* 建表或追加设计中有而表缺失的列，不删列不改类型。 */
    static async int Migrate(IDbConnection db, GenTable t, List<GenColumn> cols) {
        return await DbSchema.MigrateAsync(db, t.tableName, Gen.Columns(cols));
    }

    /* ---- 源码生成 ---- */

    /* 设计列类型到 Zan 类型的映射。 */
    static string ZanType(string kind) {
        if (kind == "int" || kind == "bool") { return "int"; }
        if (kind == "long" || kind == "datetime") { return "long"; }
        if (kind == "decimal") { return "double"; }
        return "string";
    }

    /* 生成实体类源码。 */
    static string ModelSource(GenTable t, List<GenColumn> cols) {
        StringBuilder b = new StringBuilder();
        b.Append("using System.Data.Orm;\n\nnamespace ZanWeb.Model.Gen;\n\n");
        b.Append("/// <summary>" + t.title + "。由表设计器生成，可直接修改。</summary>\n");
        b.Append("[Table(Name = \"" + t.tableName + "\")]\n");
        b.Append("class " + t.entityName + " {\n");
        b.Append("    [Column(IsIdentity = true)]\n    int id;\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            GenColumn c = cols[i];
            if (c.name == "id") { continue; }
            b.Append("\n");
            if (c.label.Length > 0) {
                b.Append("    /// <summary>" + c.label + "</summary>\n");
            }
            if (c.kind == "string") {
                b.Append("    [Column(StringLength = "
                    + Convert.ToString(Gen.Size(c)) + ")]\n");
            }
            b.Append("    " + Gen.ZanType(c.kind) + " " + c.name + ";\n");
        }
        b.Append("}\n");
        return b.ToString();
    }

    static int Size(GenColumn c) {
        if (c.size > 0) { return c.size; }
        return 255;
    }

    /* 生成管理控制器源码（列表/表单/保存/删除），命名与路由一致。 */
    /* 生成模块的 URL 路径（section/表名），侧边栏共享此 URL。 */
    static string Route(GenTable t) {
        string sec = t.section;
        if (!Gen.Safe(sec)) { sec = "content"; }
        return sec + "/" + t.tableName.Replace("_", "");
    }

    static string ControllerSource(GenTable t, List<GenColumn> cols) {
        string cls = t.entityName;
        string mdl = "ZanWeb.Model.Gen." + t.entityName;
        string route = Gen.Route(t);
        StringBuilder b = new StringBuilder();
        b.Append("using System;\nusing System.Data;\nusing System.Data.Orm;\n");
        b.Append("using System.Web;\nusing ZanWeb;\n\n");
        b.Append("namespace ZanWeb.Admin;\n\n");
        b.Append("/// <summary>" + t.title
            + " 管理。由表设计器生成，可直接修改。</summary>\n");
        b.Append("[Route(\"admin/" + route + "/[action]\")]\n");
        b.Append("[Custom(Authorization = CustomAuthorization.Grant)]\n");
        b.Append("[Description(\"" + t.title + "\")]\n");
        b.Append("class " + cls + " : AdminController {\n");

        b.Append("    [HttpGet]\n    [Route(\"/admin/" + route + "\")]\n");
        b.Append("    [Custom(IsMenu = true)]\n");
        b.Append("    [Description(\"" + t.title + "列表\")]\n");
        b.Append("    async void Index() {\n");
        b.Append("        ViewData d = await this.Layout(\"" + t.title + "\");\n");
        b.Append("        if (!this.DbReady()) { d.Set(\"dbDown\", \"1\"); this.Page(d); return; }\n");
        b.Append("        ListQuery q = this.Paged(\"id\", 20);\n");
        b.Append("        int total = await this." + cls + ".CountAsync();\n");
        b.Append("        List<" + mdl + "> rows = await this." + cls + "\n");
        b.Append("            .OrderByDescending(a => a.id)\n");
        b.Append("            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();\n");
        b.Append("        List<StrMap> list = d.AddList(\"rows\");\n");
        b.Append("        for (int i = 0; i < rows.Count; i = i + 1) {\n");
        b.Append("            " + mdl + " e = rows[i];\n");
        b.Append("            StrMap row = new StrMap();\n");
        b.Append("            row.Set(\"id\", Convert.ToString(e.id));\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            GenColumn c = cols[i];
            if (c.name == "id" || c.inList != 1) { continue; }
            if (Gen.ZanType(c.kind) == "string") {
                b.Append("            row.Set(\"" + c.name + "\", e." + c.name + ");\n");
            } else {
                b.Append("            row.Set(\"" + c.name
                    + "\", Convert.ToString(e." + c.name + "));\n");
            }
        }
        b.Append("            list.Add(row);\n        }\n");
        b.Append("        this.Pager(d, q, total);\n        this.Page(d);\n    }\n\n");

        b.Append("    [HttpGet]\n    [Description(\"" + t.title + "表单\")]\n");
        b.Append("    async void Form() {\n");
        b.Append("        int id = this.InInt(\"id\", 0);\n");
        b.Append("        ViewData d = new ViewData();\n");
        b.Append("        d.Set(\"id\", Convert.ToString(id));\n");
        b.Append("        d.Set(\"dialogTitle\", \"新增" + t.title + "\");\n");
        b.Append("        if (id > 0) {\n");
        b.Append("            " + mdl + " e = await this." + cls + ".Read(id);\n");
        b.Append("            if (e == null) { this.Fail(404, \"0404\", \"记录不存在\"); }\n");
        b.Append("            d.Set(\"dialogTitle\", \"编辑" + t.title + "\");\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            GenColumn c = cols[i];
            if (c.name == "id" || c.inEdit != 1) { continue; }
            if (Gen.ZanType(c.kind) == "string") {
                b.Append("            d.Set(\"" + c.name + "\", e." + c.name + "\");\n");
            } else {
                b.Append("            d.Set(\"" + c.name
                    + "\", Convert.ToString(e." + c.name + "));\n");
            }
        }
        b.Append("        }\n        this.Dialog(d);\n    }\n\n");

        b.Append("    [HttpPost]\n    [Description(\"保存" + t.title + "\")]\n");
        b.Append("    async void Save() {\n");
        b.Append("        int id = this.InInt(\"id\", 0);\n");
        b.Append("        " + mdl + " e = new " + mdl + "();\n");
        b.Append("        if (id > 0) {\n");
        b.Append("            " + mdl + " cur = await this." + cls + ".Read(id);\n");
        b.Append("            if (cur == null) { this.Fail(404, \"0404\", \"记录不存在\"); }\n");
        b.Append("            e = cur;\n        }\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            GenColumn c = cols[i];
            if (c.name == "id" || (c.inCreate != 1 && c.inEdit != 1)) { continue; }
            string zt = Gen.ZanType(c.kind);
            if (zt == "string") {
                if (c.required == 1) {
                    b.Append("        e." + c.name + " = this.Need(\"" + c.name
                        + "\", \"" + Gen.LabelOf(c) + "\");\n");
                } else {
                    b.Append("        e." + c.name + " = this.In(\"" + c.name + "\");\n");
                }
            } else if (zt == "int") {
                b.Append("        e." + c.name + " = this.InInt(\"" + c.name + "\", 0);\n");
            } else if (zt == "long") {
                b.Append("        e." + c.name + " = this.InLong(\"" + c.name + "\", 0);\n");
            } else {
                b.Append("        e." + c.name + " = this.InDouble(\"" + c.name + "\", 0.0);\n");
            }
        }
        b.Append("        if (id > 0) {\n");
        b.Append("            int n = await this." + cls + ".Update()\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            GenColumn c = cols[i];
            if (c.name == "id" || c.inEdit != 1) { continue; }
            b.Append("                .Set(a => a." + c.name + ", e." + c.name + ")\n");
        }
        b.Append("                .Where(a => a.id == id).ExecuteAffrowsAsync();\n");
        b.Append("            await this.Note(\"编辑" + t.title
            + "\", Convert.ToString(id), n > 0, \"\");\n");
        b.Append("            this.Saved(\"已保存\");\n            return;\n        }\n");
        b.Append("        int newId = await this." + cls
            + ".Insert(e).ExecuteIdentityAsync();\n");
        b.Append("        await this.Note(\"新增" + t.title
            + "\", Convert.ToString(newId), newId > 0, \"\");\n");
        b.Append("        this.Saved(\"已创建\");\n    }\n\n");

        b.Append("    [HttpPost]\n    [Description(\"删除" + t.title + "\")]\n");
        b.Append("    async void Delete() {\n");
        b.Append("        int id = this.InInt(\"id\", 0);\n");
        b.Append("        int n = await this." + cls
            + ".Delete().Where(a => a.id == id).ExecuteAffrowsAsync();\n");
        b.Append("        await this.Note(\"删除" + t.title
            + "\", Convert.ToString(id), n > 0, \"\");\n");
        b.Append("        this.Saved(\"已删除\");\n    }\n}\n");
        return b.ToString();
    }

    static string LabelOf(GenColumn c) {
        if (c.label.Length > 0) { return c.label; }
        return c.name;
    }

    /* 生成列表视图源码。 */
    static string ListViewSource(GenTable t, List<GenColumn> cols) {
        string route = Gen.Route(t);
        StringBuilder b = new StringBuilder();
        b.Append("<div class=\"card\">\n  <div class=\"toolbar\">\n");
        b.Append("    <b>" + t.title + "</b>\n    <span class=\"sp\"></span>\n");
        b.Append("    <a class=\"btn sm primary\" href=\"/admin/" + route
            + "/form\" data-dialog>新增</a>\n  </div>\n");
        b.Append("  <table class=\"table\">\n    <thead><tr>");
        b.Append("<th style=\"width:70px\">ID</th>");
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].inList != 1 || cols[i].name == "id") { continue; }
            b.Append("<th>" + Gen.LabelOf(cols[i]) + "</th>");
        }
        b.Append("<th class=\"ops\">操作</th></tr></thead>\n    <tbody>\n");
        b.Append("      {{#each rows}}\n      <tr><td class=\"mono\">{{id}}</td>");
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].inList != 1 || cols[i].name == "id") { continue; }
            b.Append("<td>{{" + cols[i].name + "}}</td>");
        }
        b.Append("<td class=\"ops\">");
        b.Append("<a href=\"/admin/" + route + "/form?id={{id}}\" data-dialog>编辑</a>");
        b.Append("<a href=\"#\" data-post=\"/admin/" + route
            + "/delete\" data-args=\"id={{id}}\" data-confirm=\"确定删除吗？\">删除</a>");
        b.Append("</td></tr>\n      {{/each}}\n    </tbody>\n  </table>\n");
        b.Append("  {{#if empty}}<div class=\"empty\">还没有数据</div>{{/if}}\n");
        b.Append("</div>\n");
        return b.ToString();
    }

    /* 生成表单视图源码。 */
    static string FormViewSource(GenTable t, List<GenColumn> cols) {
        string route = Gen.Route(t);
        StringBuilder b = new StringBuilder();
        b.Append("<form data-submit action=\"/admin/" + route + "/save\">\n");
        b.Append("  <input type=\"hidden\" name=\"id\" value=\"{{id}}\">\n");
        b.Append("  <div class=\"form\">\n");
        for (int i = 0; i < cols.Count; i = i + 1) {
            GenColumn c = cols[i];
            if (c.name == "id" || (c.inCreate != 1 && c.inEdit != 1)) { continue; }
            b.Append("    <label>" + Gen.LabelOf(c) + "</label>\n");
            if (c.widget == "select") {
                /* 下拉框：选项来自字典类型或关联表，通过 data-* 声明，保留当前值以防先保存后加载。 */
                string src = "";
                if (c.dictType.Length > 0) {
                    src = " data-dict=\"" + c.dictType + "\"";
                } else if (c.relTable.Length > 0) {
                    src = " data-rel-table=\"" + c.relTable + "\""
                        + " data-rel-value=\"" + c.relValue + "\""
                        + " data-rel-label=\"" + c.relLabel + "\"";
                }
                b.Append("    <select class=\"input\" name=\"" + c.name + "\""
                    + src + "><option value=\"{{" + c.name + "}}\">{{" + c.name
                    + "}}</option></select>\n");
            } else if (c.widget == "textarea" || c.kind == "text") {
                b.Append("    <textarea class=\"input\" name=\"" + c.name
                    + "\" rows=\"3\">{{" + c.name + "}}</textarea>\n");
            } else if (c.widget == "switch" || c.kind == "bool") {
                b.Append("    <select class=\"input\" name=\"" + c.name
                    + "\"><option value=\"1\">是</option><option value=\"0\">否</option></select>\n");
            } else if (c.widget == "number" || Gen.ZanType(c.kind) != "string") {
                b.Append("    <input class=\"input\" type=\"number\" name=\"" + c.name
                    + "\" value=\"{{" + c.name + "}}\">\n");
            } else {
                b.Append("    <input class=\"input\" name=\"" + c.name
                    + "\" value=\"{{" + c.name + "}}\">\n");
            }
        }
        b.Append("  </div>\n</form>\n");
        return b.ToString();
    }

    /* 生成数据访问网关（{Entity}Dao），与手写 DAO 结构一致。 */
    static string DaoSource(GenTable t, List<GenColumn> cols) {
        string ent = t.entityName;
        StringBuilder b = new StringBuilder();
        b.Append("using System;\nusing System.Data;\nusing System.Data.Orm;\n");
        b.Append("using ZanWeb.Model.Gen;\n\n");
        b.Append("namespace ZanWeb.Dao.Gen;\n\n");
        b.Append("/// <summary>" + t.title
            + " 的数据网关。由表设计器生成，可直接修改。</summary>\n");
        b.Append("class " + ent + "Dao {\n");
        b.Append("    IDbConnection db;\n\n");
        b.Append("    " + ent + "Dao(IDbConnection db) {\n");
        b.Append("        this.db = db;\n    }\n\n");

        b.Append("    async " + ent + " ById(int id) {\n");
        b.Append("        return await this.db.Select<" + ent
            + ">().Where(a => a.id == id).FirstAsync();\n    }\n\n");

        b.Append("    async List<" + ent + "> All() {\n");
        b.Append("        return await this.db.Select<" + ent
            + ">().OrderByDescending(a => a.id).ToListAsync();\n    }\n\n");

        b.Append("    async int Count() {\n");
        b.Append("        return await this.db.Select<" + ent
            + ">().CountAsync();\n    }\n\n");

        b.Append("    async int Insert(" + ent + " e) {\n");
        b.Append("        return await this.db.Insert<" + ent
            + ">(e).ExecuteIdentityAsync();\n    }\n\n");

        b.Append("    async int Update(" + ent + " e) {\n");
        string sets = "";
        for (int i = 0; i < cols.Count; i = i + 1) {
            GenColumn c = cols[i];
            if (c.name == "id") { continue; }
            sets = sets + "            .Set(a => a." + c.name + ", e." + c.name
                + ")\n";
        }
        if (sets.Length == 0) {
            b.Append("        return 0;\n    }\n\n");
        } else {
            b.Append("        return await this.db.Update<" + ent + ">()\n");
            b.Append(sets);
            b.Append("            .Where(a => a.id == e.id).ExecuteAffrowsAsync();\n");
            b.Append("    }\n\n");
        }

        b.Append("    async int Delete(int id) {\n");
        b.Append("        return await this.db.Delete<" + ent
            + ">().Where(a => a.id == id).ExecuteAffrowsAsync();\n    }\n}\n");
        return b.ToString();
    }
}
