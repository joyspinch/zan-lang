using System;
using ZanWeb;
using System.Web;
using System.Json;

namespace ZanWeb.Api;

/// <summary>Authentication endpoints. Routes: /api/auth/login, /api/auth/me.</summary>
[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("认证")]
class Auth : ApiController {
    [HttpPost]
    [Description("登录")]
    async void Login() {
        // 必填用 Need：缺参数直接以 {"code":"0003"} 结束，同时让 /api/docs 把这两个
        // 参数标成必填。Validator 留给「存在但不合法」的规则（长度、格式）。
        string user = this.Need("user", "user");
        string pass = this.Need("pass", "pass");
        Validator v = new Validator();
        v.MaxLen(user, 32, "user");
        v.MaxLen(pass, 64, "pass");
        if (!v.Ok()) {
            this.ctx.Status(422, "Unprocessable Entity");
            this.ctx.Api("1003", "validation failed", v.ErrorsJson());
            return;
        }
        string token = await AuthUser.Login(user, pass);
        if (token.Length == 0) {
            if (!AuthToken.Ready()) {
                this.Fail(503, "1002", "set ZAN_AUTH_SECRET to at least 32 characters");
                return;
            }
            this.Fail(401, "1001", "bad credentials");
            return;
        }
        this.ctx.SetCookie("zsession", token, 864000);
        JsonValue o = JsonValue.NewObject();
        o.Put("token", JsonValue.NewStr(token));
        this.Ok(o.ToJson());
    }

    [HttpGet]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("当前用户")]
    void Me() {
        JsonValue o = JsonValue.NewObject();
        o.Put("uid", JsonValue.NewStr(this.uid));
        this.Ok(o.ToJson());
    }
}
