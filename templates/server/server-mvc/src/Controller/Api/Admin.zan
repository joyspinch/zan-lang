using System;
using ZanWeb;
using System.Web;
using System.Json;

namespace ZanWeb.Api;

/* 管理端 API：菜单（权限过滤后）与仪表盘摘要，答 {code,msg,data}。
   菜单走 MenuBuilder.JsonFor —— 服务端决定可达项，前端拿到的每条链接
   都是 API 层放行的，不存在「菜单有、接口拒」的第二种事实。 */
[Route("api/admin/[action]")]
[Custom(Authorization = CustomAuthorization.Login)]
[Description("管理壳")]
class Admin : AdminController {
    [HttpGet]
    [Description("侧边栏菜单")]
    async void Menu() {
        string menu = await MenuBuilder.JsonFor(
            WebHost.Current(), this.uid, this.Ctx().path);
        this.Ok(menu);
    }

    [HttpGet]
    [Description("仪表盘摘要")]
    async void Summary() {
        JsonValue m = JsonValue.ParseLenient(WebHost.Current().MetricsJson());
        JsonValue req = m.Get("requests");
        if (req == null) { req = JsonValue.NewObject(); }

        JsonValue db = JsonValue.NewObject();
        JsonValue d = JsonValue.NewObject();
        d.Put("uptime", JsonValue.NewStr(Fmt.Uptime(m.Long("uptime_ms", 0))));
        d.Put("requests", JsonValue.NewNum(req.Long("count", 0).ToString()));
        d.Put("errors", JsonValue.NewNum(req.Long("errors", 0).ToString()));
        d.Put("avg_us", JsonValue.NewNum(req.Long("avg_us", 0).ToString()));
        d.Put("db", db);

        if (this.DbReady()) {
            db.Put("ok", JsonValue.NewBool(true));
            DataScope sc = await this.Scope();
            List<int> scoped = sc.Depts();
            int mine = sc.UserId();
            int users = await this.User
                .WhereIf(sc.ByDept(), a => scoped.Contains(a.departmentId))
                .WhereIf(sc.Mine(), a => a.id == mine)
                .CountAsync();
            int posts = await this.Post.CountAsync();
            int published = await this.Post.Where(a => a.published == 1).CountAsync();
            int comments = await this.Comment.CountAsync();
            int pending = await this.Comment.Where(a => a.status == 0).CountAsync();
            d.Put("users", JsonValue.NewNum(users.ToString()));
            d.Put("posts", JsonValue.NewNum(posts.ToString()));
            d.Put("published", JsonValue.NewNum(published.ToString()));
            d.Put("comments", JsonValue.NewNum(comments.ToString()));
            d.Put("pending", JsonValue.NewNum(pending.ToString()));
        } else {
            db.Put("ok", JsonValue.NewBool(false));
        }
        this.Ok(d.ToJson());
    }
}
