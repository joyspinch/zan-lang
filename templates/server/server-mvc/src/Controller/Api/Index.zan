using System;
using ZanWeb;
using System.Web;
using System.Json;

namespace ZanWeb.Api;

/* 公开服务状态；路由 /api/index/index；与 ZanWeb.Index.Index / ZanWeb.Admin.Index 区分的模块级 Index。 */
[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("服务状态")]
class Index : ApiController {
    [HttpGet]
    [Description("服务状态")]
    void Index() {
        this.Json(WebHost.Current().StatusJson());
    }

    [HttpGet]
    [Description("健康检查")]
    void Ping() {
        JsonValue o = JsonValue.NewObject();
        o.Put("pong", JsonValue.NewNum("1"));
        this.Ok(o.ToJson());
    }
}
