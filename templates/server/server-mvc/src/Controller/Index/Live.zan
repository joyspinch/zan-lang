using System;
using System.Web;
using ZanWeb;

namespace ZanWeb.Index;

/// <summary>
/// The public presence stream behind the "现在在线" line in the footer.
///
/// One page holds one connection for as long as it is open, which is exactly
/// what is being counted: no polling, and closing the tab is the signal that
/// the visitor left. Workers publish their own slot to the shared cache and
/// each stream reports the sum, so the number is the whole site and not the
/// worker that happened to answer.
/// </summary>
[Route("[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("在线人数")]
class Live : Controller {
    /// <summary>Seconds between frames. Presence changes slowly; a faster beat
    /// would only cost connections their idle time.</summary>
    static int Beat = 5;

    /// <summary>How long one stream lives before the browser reconnects.</summary>
    static int StreamSeconds = 1800;

    [HttpGet]
    [Route("/live/stream")]
    [Description("在线人数事件流")]
    async void Stream() {
        HttpContext ctx = this.Ctx();
        if (!await ctx.SseOpen()) { return; }
        string ip = ctx.RemoteIp();
        Presence.Enter(ip);
        int elapsed = 0;
        while (elapsed < Live.StreamSeconds) {
            await Presence.Publish();
            if (!await ctx.SseSend("presence", await Live.Frame())) { break; }
            await Task.Delay(Live.Beat * 1000);
            elapsed = elapsed + Live.Beat;
        }
        Presence.Leave(ip);
        await Presence.Publish();
    }

    /// <summary>The same numbers as one request, for anything that is not a
    /// browser.</summary>
    [HttpGet]
    [Route("/live/now")]
    [Description("在线人数快照")]
    async void Now() {
        this.Json(await Live.Frame());
    }

    static async string Frame() {
        int pages = await Presence.Pages();
        int visitors = await Presence.Visitors();
        return "{\"visitors\":" + Convert.ToString(visitors)
            + ",\"pages\":" + Convert.ToString(pages) + "}";
    }
}
