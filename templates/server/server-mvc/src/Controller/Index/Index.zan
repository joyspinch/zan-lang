using System;
using ZanWeb;
using System.Web;

namespace ZanWeb.Index;

/// <summary>Landing page. The view follows the controller: View(d) renders
/// views/Index/Index.Index.html (module-qualified view key "Index.Index.Index"),
/// wrapped by the nearest layout — this module has none, so the site-wide
/// views/layout.html applies. This controller is one of three
/// module-local classes literally named <c>Index</c> (ZanWeb.Index / ZanWeb.Api /
/// ZanWeb.Admin), kept apart by namespace-aware binding.
///
/// The page is built from data, not markup: the fact/feature/step lists are rows
/// in the ViewData, so adding one is a row here and not a copy-pasted card
/// there. The markup it feeds is the language landing page (hero, feature
/// tiles, code sample, install steps).</summary>
[Route("[controller]/[action]")]
[Description("首页")]
class Index : Controller {
    [HttpGet]
    [Route("/")]
    [Description("首页")]
    async void Index() {
        ViewData d = new ViewData();
        await Settings.Apply(d);
        d.Set("title", "Zan — 熟悉的语法，原生的速度");
        d.Set("version", "Zan 0.2.1 · ZanWeb");
        d.Set("navHome", "page");
        d.Set("tagline", "熟悉的语法。原生的速度。");
        d.Set("message", "C# 的写法，C 的产物。LLVM 直出机器码，ARC 管内存，"
            + "没有 GC 停顿、没有虚拟机、没有生命周期标注——"
            + "写业务的手感，交付系统级的性能。");
        d.Set("platformSub", "编译器、运行时、标准库、语言服务与调试器"
            + "出自同一个仓库，版本一起走，不用拼装第三方工具。");

        List<StrMap> facts = d.AddList("facts");
        Index.Fact(facts, "编译目标", "原生");
        Index.Fact(facts, "内存管理", "ARC");
        Index.Fact(facts, "运行时依赖", "无 VM");
        Index.Fact(facts, "标准库", ".zan 源码");

        // The pain each capability answers, in the reader's words first.
        List<StrMap> pains = d.AddList("pains");
        Index.Pain(pains, "学一门系统语言要先学一套新符号",
            "类、接口、泛型、属性、async/await，和你写 C# 时一样；"
            + "没有生命周期标注、没有借用检查器要哄。");
        Index.Pain(pains, "运行时太重：装虚拟机、等预热、被 GC 打断",
            "产物是一个可执行文件，启动即满速，停顿由引用计数决定而不是 GC 决定。");
        Index.Pain(pains, "接一个原生库就要另起一个 C 项目当胶水",
            "DllImport 声明一行就能调系统 API 与原生库；"
            + "反过来它自己也能当胶水——嵌入 CPython 双向互调，"
            + "Python 生态直接拿来用。");
        Index.Pain(pains, "标准库是黑盒，出问题只能猜",
            "标准库以 .zan 源码分发：跳进去就是实现，可读、可改、可断点。");

        List<StrMap> items = d.AddList("features");
        Index.Feature(items, "AOT 编译",
            "经 LLVM 直接生成机器码，启动没有预热，产物是一个可执行文件。",
            "zanc app.zan --auto-stdlib -o app.exe");
        Index.Feature(items, "确定性内存",
            "自动引用计数在编译期插入，析构时机可预测；结构体在栈上，集合写时复制。",
            "struct Point { float X; float Y; }");
        Index.Feature(items, "双向互操作",
            "DllImport 直接调系统 API 与原生库；System.Scripting 内嵌 CPython，"
            + "Zan 调 Python、Python 回调 Zan，对象引用由 ARC 统一回收。",
            "[DllImport(\"user32\")] / Python.Eval");
        Index.Feature(items, "自举编译器",
            "编译器与运行时用 C11 写成，另有一套 .zan 自举实现同源共存。",
            "src/selfhost/");
        Index.Feature(items, "源码标准库",
            "标准库以 .zan 源码分发：跳转进去就是实现，可读、可改、可调试。",
            "stdlib/System/Web/");
        Index.Feature(items, "语言服务与调试",
            "同仓提供 LSP 与 DAP：补全、跳转、诊断、断点在自带 IDE 里开箱可用。",
            "zan-lsp / zan-dap");

        // What people actually build with it -- each row is a real namespace in
        // this repository's standard library, not a roadmap item.
        List<StrMap> scenes = d.AddList("scenes");
        Index.Scene(scenes, "桌面应用",
            "Gui 提供控件、布局、样式、皮肤、动效与可视化设计器，"
            + "原生窗口后端直接绘制。",
            "Gui.App / Gui.Layout");
        Index.Scene(scenes, "游戏",
            "Game 覆盖场景、渲染、动画与 2D/卡牌/棋类/ARPG/RTS 玩法框架，"
            + "SDL3 作为底层。",
            "Game.Scene / Game.Render");
        Index.Scene(scenes, "服务端",
            "ZanWeb 一个二进制跑完站点、接口与后台：编译期路由、ORM、"
            + "缓存、连接池、多进程 worker。",
            "System.Web / System.Data.Orm");
        Index.Scene(scenes, "数据与存储",
            "MySQL、PostgreSQL、SQL Server、SQLite、Redis、TDengine、"
            + "Firebird 与 ODBC 都在标准库里。",
            "System.Data.*");
        Index.Scene(scenes, "物联网与通信",
            "HTTP/HTTPS、WebSocket、SSE、MQTT、Modbus、CoAP、SIP、"
            + "NTP、RPC 一次装齐。",
            "System.Net.*");
        Index.Scene(scenes, "自动化与智能体",
            "窗口与 UI 元素自动化、进程内 CPython 双向互调、流式 HTTP/SSE："
            + "既能驱动桌面软件，也能接住模型的流式输出。",
            "System.Automation / System.Scripting");

        List<StrMap> show = d.AddList("showcase");
        Index.Feature(show, "编译期路由",
            "控制器上的 [Route]/[Http*] 由编译器扫描生成注册表，启动零反射。",
            "[Route(\"/blog/{id}\")]");
        Index.Feature(show, "内存模板",
            "视图启动时读入内存并渲染，请求路径上没有一次文件 IO。",
            "app.Views(\"views\")");
        Index.Feature(show, "协程与连接池",
            "每个请求是一个协程，连接按请求借还，多进程 worker 各自持池。",
            "await this.Conn()");

        // Getting started is the IDE, not the toolchain: ZanIDE ships the
        // compiler, the language server and the debugger, so nothing here asks
        // the reader to build zanc first.
        List<StrMap> steps = d.AddList("steps");
        Index.Demo(steps, "打开 ZanIDE",
            "编译器、语言服务、调试器与标准库都在里面，装好即可开工。");
        Index.Demo(steps, "新建项目",
            "从控制台、图形界面、服务端、库四类模板里选一个，向导直接生成可运行的工程。");
        Index.Demo(steps, "运行 / 调试 / 发布",
            "功能区点“运行”看输出面板，F5 断点调试，“发布”一键打包目标平台。");
        this.View(d);
    }

    static void Pain(List<StrMap> rows, string pain, string fix) {
        StrMap row = new StrMap();
        row.Set("pain", pain);
        row.Set("fix", fix);
        rows.Add(row);
    }

    static void Scene(List<StrMap> rows, string name, string desc, string ns) {
        StrMap row = new StrMap();
        row.Set("name", name);
        row.Set("desc", desc);
        row.Set("ns", ns);
        rows.Add(row);
    }

    static void Fact(List<StrMap> rows, string k, string v) {
        StrMap row = new StrMap();
        row.Set("k", k);
        row.Set("v", v);
        rows.Add(row);
    }

    static void Feature(List<StrMap> rows, string name, string desc, string hint) {
        StrMap row = new StrMap();
        row.Set("name", name);
        row.Set("desc", desc);
        row.Set("hint", hint);
        rows.Add(row);
    }

    static void Demo(List<StrMap> rows, string req, string what) {
        StrMap row = new StrMap();
        row.Set("req", req);
        row.Set("what", what);
        rows.Add(row);
    }
}
