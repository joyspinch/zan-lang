using System;
using ZanWeb;
using System.Web;

namespace ZanWeb.Index;

/// <summary>Landing page. The view follows the controller: View(d) renders
/// Index/View/Index.Index.html (module-qualified view key "Index.Index.Index"),
/// wrapped by the nearest layout — this module has none, so the site-wide
/// src/Controller/layout.html applies. This controller is one of three
/// module-local classes literally named <c>Index</c> (ZanWeb.Index / ZanWeb.Api /
/// ZanWeb.Admin), kept apart by namespace-aware binding.
///
/// The page is built from data, not markup: the feature/route lists are rows in
/// the ViewData, so adding one is a row here and not a copy-pasted card there.</summary>
[Route("[controller]/[action]")]
[Description("首页")]
class Index : Controller {
    [HttpGet]
    [Route("/")]
    [Description("首页")]
    void Index() {
        ViewData d = new ViewData();
        d.Set("title", "{{NAME}}");
        d.Set("version", "ZanWeb · Web MVC");
        d.Set("navHome", "page");
        d.Set("message", "分层的服务端渲染框架：属性路由、模块化控制器、ORM + 缓存、"
            + "鉴权与限流。模板在启动时读入内存，请求路径上没有一次文件 IO。");

        List<StrMap> facts = d.AddList("facts");
        Index.Fact(facts, "路由", "编译期生成");
        Index.Fact(facts, "模板", "内存渲染");
        Index.Fact(facts, "连接", "请求级复用");
        Index.Fact(facts, "构建", "无前端构建");

        List<StrMap> items = d.AddList("features");
        Index.Feature(items, "属性路由",
            "[Route]/[Http*]/[Custom] 由编译器扫描生成注册表，启动零反射。",
            "[Route(\"/blog/{id}\")]");
        Index.Feature(items, "模块化",
            "控制器按文件夹分组，视图就放在同目录 View/ 下，命名空间与目录一致。",
            "Admin.Users.Index");
        Index.Feature(items, "分层数据",
            "Controller 取参数、Dao 管查询、Model 是表结构；连接按请求借还。",
            "await this.Conn()");
        Index.Feature(items, "统一鉴权",
            "Cookie 与 Bearer 走同一条令牌管线，权限在框架中央闸门判定。",
            "CustomAuthorization.ApiAuth");

        List<StrMap> routes = d.AddList("routes");
        Index.Demo(routes, "GET /blog", "服务端渲染的列表页，cache-aside 读 Redis");
        Index.Demo(routes, "GET /admin", "管理后台仪表盘（需登录）");
        Index.Demo(routes, "POST /api/auth/login", "user=admin&pass=…，签发加密 Cookie");
        Index.Demo(routes, "GET /api/auth/me", "回显当前身份，401 表示未登录");
        Index.Demo(routes, "GET /user/42", "路径参数绑定");
        this.View(d);
    }

    static void Fact(List<StrMap> rows, string k, string v) {
        StrMap row = new StrMap();
        row.Set("k", k);
        row.Set("v", v);
        rows.Add(row);
    }

    static void Feature(List<StrMap> rows, string name, string desc, string hint) {
        StrMap row = new StrMap();
        row.Set("name", name);
        row.Set("desc", desc);
        row.Set("hint", hint);
        rows.Add(row);
    }

    static void Demo(List<StrMap> rows, string req, string what) {
        StrMap row = new StrMap();
        row.Set("req", req);
        row.Set("what", what);
        rows.Add(row);
    }
}
