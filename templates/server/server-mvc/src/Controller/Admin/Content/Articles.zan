using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using System.Json;
using ZanWeb;
using ZanWeb.Model.Blog;

namespace ZanWeb.Admin.Content;

/* /admin/content/posts 文章管理：博客的编辑侧，与公开列表不同，草稿保留——把文章对需要发布它的人隐藏是奇怪的做法；每次写操作都清公开列表缓存，让改动立即生效。 */
[Route("admin/content/posts/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("文章管理")]
class Articles : AdminController {
    [HttpGet]
    [Route("/admin/content/posts")]
    [Custom(IsMenu = true, Icon = "mdi:file-document", Perm = PermBit.View)]
    [Description("文章管理")]
    async void Index() {
        ViewData d = await this.Layout("文章管理");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }

        /* 声明本屏搜索与工具栏：分类筛选走远程搜索单选（Pick），工具栏
           提供 发布/转草稿/删除 三个批量键。 */
        ListPage lp = ListPage.Of()
            .Text("标题", "kw", "t.title", "搜索标题")
            .Select("状态", "state", "t.published", "1=已发布,0=草稿")
            .Pick("分类", "categoryId", "t.categoryId", "/admin/content/posts/cats")
            .Time("创建日期", "createdAt", "t.createdAt")
            .TbarAdd("写文章", "/admin/content/posts/form")
            .TbarReload()
            .TbarSep()
            .TbarBatch("发布", "/admin/content/posts/batchpublish", "1", "确认发布所选文章吗？")
            .TbarBatch("转草稿", "/admin/content/posts/batchpublish", "0", "")
            .TbarDelete("/admin/content/posts/batchdelete");
        List<ListCond> conds = lp.Collect(this);
        lp.Search(this, d, "/admin/content/posts");
        lp.Toolbar(d);

        ListQuery q = this.Paged("id", 20);

        int total = await this.CountPosts(conds);
        List<Post> rows = await this.PostList(conds, q.Skip(), q.Limit());
        List<Category> cats = await this.Category.OrderBy(a => a.sortOrder).ToListAsync();

        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            Post p = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(p.id));
            row.Set("title", p.title);
            row.Set("category", Articles.CategoryName(cats, p.categoryId));
            row.Set("author", Fmt.Dash(p.author));
            row.Set("tags", Fmt.Dash(p.tags));
            row.Set("views", Convert.ToString(p.views));
            row.Set("createdAt", Fmt.Day(p.createdAt));
            row.Set("stateText", Articles.StateText(p.published));
            row.Set("stateClass", Articles.StateClass(p.published));
            row.Set("nextState", Articles.NextState(p.published));
            row.Set("toggleText", Articles.ToggleText(p.published));
            row.Set("topText", Articles.TopText(p.top));
            row.Set("nextTop", Articles.NextTop(p.top));
            if (p.top == 1) { row.Set("pinned", "1"); }
            items.Add(row);
        }

        this.Pager(d, q, total);
        /* 分页链接保留全部筛选。 */
        if (q.Page() > 1) { d.Set("prevUrl", lp.Query(conds, q.Page() - 1, q.Limit())); }
        if (q.Page() < q.Pages(total)) { d.Set("nextUrl", lp.Query(conds, q.Page() + 1, q.Limit())); }
        this.Page(d);
    }

    /* 声明条件拼参数化 WHERE：列名来自 ListPage 声明（非用户输入），
       值走占位符；取数走 this.Post 表访问器（每次访问一条新链）。 */
    static void ApplyConds(__DbQ_Post sel, List<ListCond> conds) {
        for (int i = 0; i < conds.Count; i = i + 1) {
            ListCond q = conds[i];
            if (q.kind == "LIKE") {
                sel.W("(" + q.col + " LIKE ?)");
                sel.P("%" + q.value + "%");
            } else if (q.kind == "EQ") {
                sel.W(q.col + " = ?");
                sel.Pi(Filter.ToInt(q.value, 0));
            } else if (q.kind == "GE") {
                sel.W(q.col + " >= ?");
                sel.Pl(Filter.ToLong(q.value, 0));
            } else if (q.kind == "LE") {
                sel.W(q.col + " <= ?");
                sel.Pl(Filter.ToLong(q.value, 0));
            }
        }
    }

    async int CountPosts(List<ListCond> conds) {
        __DbQ_Post sel = __DbBind.Q_Post(this.__Conn());
        Articles.ApplyConds(sel, conds);
        return await sel.CountAsync();
    }

    async List<Post> PostList(List<ListCond> conds, int skip, int limit) {
        __DbQ_Post sel = __DbBind.Q_Post(this.__Conn());
        Articles.ApplyConds(sel, conds);
        sel.OBD("t.id");
        sel.Skip(skip);
        sel.Take(limit);
        return await sel.ToListAsync();
    }

    /* 远程搜索分类选项（data-pick 契约）：?kw= 列表、?id= 单条回显。
       结果以 JSON 文本进统一信封，转义由 JsonValue.ToJson 完成。 */
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("分类选项")]
    async void Cats() {
        string kw = this.In("kw").Trim();
        string idv = this.In("id").Trim();
        if (idv.Length > 0) {
            Category c = await this.Category
                .Where(a => a.id == Filter.ToInt(idv, 0))
                .FirstAsync();
            JsonValue one = JsonValue.NewObject();
            if (c != null) {
                one.Set("id", JsonValue.NewInt(c.id));
                one.Set("label", JsonValue.NewStr(c.name));
            }
            this.Ctx().Api(Codes.Ok, "ok", one.ToJson());
            return;
        }
        List<Category> cats;
        if (kw.Length > 0) {
            cats = await this.Category
                .Where(a => a.name.Contains(kw))
                .OrderBy(a => a.sortOrder)
                .Take(20).ToListAsync();
        } else {
            cats = await this.Category
                .OrderBy(a => a.sortOrder)
                .Take(20).ToListAsync();
        }
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < cats.Count; i = i + 1) {
            JsonValue o = JsonValue.NewObject();
            o.Set("id", JsonValue.NewInt(cats[i].id));
            o.Set("label", JsonValue.NewStr(cats[i].name));
            arr.Append(o);
        }
        this.Ctx().Api(Codes.Ok, "ok", arr.ToJson());
    }

    /* 批量发布/转草稿（value=1/0）。写后清公开列表缓存，前台立即生效。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("批量发布或转草稿")]
    async void BatchPublish() {
        List<int> ids = this.Ids("ids");
        if (ids.Count == 0) { this.Fail(400, "0004", "未选择文章"); return; }
        int state = this.InInt("value", 1);
        if (state != 1) { state = 0; }
        int n = await this.Post.Update()
            .Set(a => a.published, state)
            .W("t.id IN (?)")
            .InI(ids)
            .ExecuteAffrowsAsync();
        CacheContext cache = this.Cache();
        if (cache != null) { await cache.DelAsync("blog:list"); }
        await this.Note("批量改发布状态",
            Convert.ToString(ids.Count) + " 篇文章", n > 0,
            state == 1 ? "发布" : "转草稿");
        this.Saved("已" + (state == 1 ? "发布" : "转草稿") + " " + Convert.ToString(n) + " 篇文章");
    }

    /* 批量删除；连带清评论与缓存，口径与单篇删除一致。 */
    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("批量删除文章")]
    async void BatchDelete() {
        List<int> ids = this.Ids("ids");
        if (ids.Count == 0) { this.Fail(400, "0004", "未选择文章"); return; }
        int n = await this.Post.Delete()
            .W("t.id IN (?)")
            .InI(ids)
            .ExecuteAffrowsAsync();
        for (int i = 0; i < ids.Count; i = i + 1) {
            int _c = await this.Comment.Delete().Where(a => a.postId == ids[i])
                .ExecuteAffrowsAsync();
        }
        CacheContext cache = this.Cache();
        if (cache != null) { await cache.DelAsync("blog:list"); }
        await this.Note("批量删除文章",
            Convert.ToString(ids.Count) + " 篇文章", n > 0, "");
        this.Saved("已删除 " + Convert.ToString(n) + " 篇文章");
    }

    /* 一份声明：Form 渲染与 Save 校验同源。分类选项由调用方查询传入
       （Save 校验用不到，传空列表即可）。 */
    static FormPage ArticleForm(List<StrMap> catRows) {
        return FormPage.Of("/admin/content/posts/save").Wide()
            .Text("标题", "title").Req().Max(120).Span()
            .SelectList("分类", "categoryId", catRows).Blank("未分类")
            .Text("作者", "author").Max(32)
            .Text("标签", "tags").Max(120).Ph("逗号分隔")
            .Text("封面", "cover").Max(255).Ph("图片地址，可留空")
            .Select("状态", "published", "1=发布,0=草稿").Val("1")
            .Select("置顶", "top", "0=否,1=是").Val("0")
            .Area("摘要", "summary").Max(255).Rows(2).Span()
            .Area("正文", "body").Req().Rows(14).Span()
            .Hint("正文按空行分段展示，摘要留空时自动截取正文开头。");
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("文章表单")]
    async void Form() {
        int id = this.InInt("id", 0);
        List<Category> cats = await this.Category.OrderBy(a => a.sortOrder).ToListAsync();
        List<StrMap> catRows = new List<StrMap>();
        for (int i = 0; i < cats.Count; i = i + 1) {
            StrMap o = new StrMap();
            o.Set("id", Convert.ToString(cats[i].id));
            o.Set("name", cats[i].name);
            catRows.Add(o);
        }
        FormPage fp = Articles.ArticleForm(catRows);
        ViewData d = new ViewData();
        d.Set("dialogTitle", id > 0 ? "编辑文章" : "写文章");
        if (id > 0) {
            Post p = await this.Post.ById(id);
            if (p == null) { this.Fail(404, "0404", "文章不存在"); }
            fp.Id(Convert.ToString(id));
            fp.Field("title").Val(p.title);
            fp.Field("categoryId").Val(Convert.ToString(p.categoryId));
            fp.Field("author").Val(p.author);
            fp.Field("tags").Val(p.tags);
            fp.Field("cover").Val(p.cover);
            fp.Field("published").Val(p.published == 1 ? "1" : "0");
            fp.Field("top").Val(p.top == 1 ? "1" : "0");
            fp.Field("summary").Val(p.summary);
            fp.Field("body").Val(p.body);
        } else {
            User me = await this.Admin();
            if (me != null) { fp.Field("author").Val(me.username); }
        }
        fp.Render(d);
        this.FormDialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存文章")]
    async void Save() {
        int id = this.InInt("id", 0);
        /* 声明即校验：与 Form 渲染同一份约束。 */
        FormPage fp = Articles.ArticleForm(new List<StrMap>());
        fp.Id(Convert.ToString(id));
        string invalid = fp.Validate(this);
        if (invalid.Length > 0) { this.Fail(400, "0004", invalid); }
        string title = this.Need("title", "标题");
        string body = this.NeedText("body", "正文");
        string summary = this.InText("summary");
        string tags = this.In("tags");
        string cover = this.In("cover");
        string author = this.In("author");
        int categoryId = this.InInt("categoryId", 0);
        int published = this.InInt("published", 1);
        int top = this.InInt("top", 0);
        if (published != 1) { published = 0; }
        if (top != 1) { top = 0; }
        if (summary.Length == 0) { summary = Prose.Excerpt(body, 120); }

        if (id > 0) {
            int n = await this.Post.Update()
                .Set(a => a.title, title)
                .Set(a => a.summary, summary)
                .Set(a => a.body, body)
                .Set(a => a.tags, tags)
                .Set(a => a.cover, cover)
                .Set(a => a.author, author)
                .Set(a => a.categoryId, categoryId)
                .Set(a => a.published, published)
                .Set(a => a.top, top)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            await this.Bust();
            await this.Note("编辑文章", title, n > 0, "");
            this.Saved("文章已保存");
            return;
        }
        Post p = new Post();
        p.title = title;
        p.summary = summary;
        p.body = body;
        p.tags = tags;
        p.cover = cover;
        p.author = author;
        p.categoryId = categoryId;
        p.published = published;
        p.top = top;
        p.views = 0;
        p.createdAt = WebApp.NowSeconds();
        p.updatedAt = p.createdAt;
        int newId = await this.Post.Insert(p).ExecuteIdentityAsync();
        await this.Bust();
        await this.Note("新增文章", title, newId > 0, "");
        this.Saved("文章已保存");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("发布或下架文章")]
    async void Publish() {
        int id = this.InInt("id", 0);
        int published = this.InInt("published", 1);
        if (published != 1) { published = 0; }
        Post p = await this.Post.ById(id);
        if (p == null) { this.Fail(404, "0404", "文章不存在"); }
        int n = await this.Post.Update()
            .Set(a => a.published, published)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Bust();
        await this.Note("发布或下架文章", p.title, n > 0,
            Articles.StateText(published));
        if (published == 1) { this.Saved("文章已发布"); return; }
        this.Saved("文章已下架");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("置顶文章")]
    async void Top() {
        int id = this.InInt("id", 0);
        int top = this.InInt("top", 1);
        if (top != 1) { top = 0; }
        Post p = await this.Post.ById(id);
        if (p == null) { this.Fail(404, "0404", "文章不存在"); }
        int n = await this.Post.Update()
            .Set(a => a.top, top)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Bust();
        await this.Note("置顶文章", p.title, n > 0, "");
        if (top == 1) { this.Saved("文章已置顶"); return; }
        this.Saved("已取消置顶");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除文章")]
    async void Delete() {
        string ids = this.In("ids");
        int id = this.InInt("id", 0);
        int removed = 0;
        if (ids.Length > 0) {
            List<Post> all = await this.Post.ToListAsync();
            for (int i = 0; i < all.Count; i = i + 1) {
                int pid = all[i].id;
                if (!AuthUser.Holds(ids, Convert.ToString(pid))) { continue; }
                int _n = await this.Post.Delete().Where(a => a.id == pid)
                    .ExecuteAffrowsAsync();
                int _c = await this.Comment.Delete().Where(a => a.postId == pid)
                    .ExecuteAffrowsAsync();
                removed = removed + 1;
            }
        } else {
            Post p = await this.Post.ById(id);
            if (p == null) { this.Fail(404, "0404", "文章不存在"); }
            removed = await this.Post.Delete().Where(a => a.id == id)
                .ExecuteAffrowsAsync();
            int _c = await this.Comment.Delete().Where(a => a.postId == id)
                .ExecuteAffrowsAsync();
        }
        await this.Bust();
        await this.Note("删除文章", "", removed > 0,
            Convert.ToString(removed) + " 篇");
        this.Saved("已删除 " + Convert.ToString(removed) + " 篇文章");
    }

    /* 清空缓存中的公开列表，使改动立即呈现。 */
    async void Bust() {
        CacheContext cache = this.Cache();
        if (cache == null) { return; }
        await cache.DelAsync("blog:list");
    }

    static string CategoryName(List<Category> cats, int id) {
        for (int i = 0; i < cats.Count; i = i + 1) {
            if (cats[i].id == id) { return cats[i].name; }
        }
        return "—";
    }

    static string StateText(int published) {
        if (published == 1) { return "已发布"; }
        return "草稿";
    }

    static string StateClass(int published) {
        if (published == 1) { return "ok"; }
        return "off";
    }

    static string NextState(int published) {
        if (published == 1) { return "0"; }
        return "1";
    }

    static string ToggleText(int published) {
        if (published == 1) { return "下架"; }
        return "发布";
    }

    static string TopText(int top) {
        if (top == 1) { return "取消置顶"; }
        return "置顶";
    }

    static string NextTop(int top) {
        if (top == 1) { return "0"; }
        return "1";
    }
}
