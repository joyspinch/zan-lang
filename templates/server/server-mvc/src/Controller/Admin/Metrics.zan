using System;
using ZanWeb;
using System.Web;

namespace ZanWeb.Admin;

/// <summary>Runtime diagnostics: CPU, memory, uptime, throughput + latency and
/// recent slow requests/queries. Route: /admin/metrics/index.</summary>
[Route("admin/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.ApiAuth, IsMenu = true)]
[Description("运行指标")]
class Metrics : ApiController {
    [HttpGet]
    [Description("运行指标")]
    void Index() {
        this.Json(WebHost.Current().MetricsJson());
    }

    /// <summary>The last `sec` seconds as one-second buckets, for the dashboard
    /// charts. The window is a parameter rather than a fixed size because the
    /// same endpoint answers both the live strip and a wider look back, and the
    /// aggregator already clamps it to what its ring holds.</summary>
    [HttpGet]
    [Description("运行指标时序")]
    void Series() {
        this.Json(WebHost.Current().MetricsSeriesJson(this.InInt("sec", 120)));
    }
}
