using System;
using System.Diagnostics;
using System.Json;
using System.Text;
using System.Threading;
using System.Web;
using ZanWeb;

namespace ZanWeb.Admin.Monitor;

/// <summary>
/// Server monitoring at /admin/monitor: throughput, errors, latency, queries,
/// CPU and memory as charts.
///
/// The page subscribes to /admin/monitor/stream ONCE and the server pushes a
/// snapshot every couple of seconds (Server-Sent Events). Polling would mean a
/// full request -- routing, auth resolution, a log line -- per tick per open
/// tab, to answer "has anything changed"; a stream costs one connection and
/// sends only when there is something to send. A comment line goes out between
/// snapshots so an idle proxy does not decide the connection is dead.
/// </summary>
[Route("admin/monitor/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("运行监控")]
class Monitor : AdminController {
    /// <summary>How long a stream lives before the browser is asked to
    /// reconnect. Bounded on purpose: a tab left open overnight should not hold
    /// a coroutine forever, and EventSource reconnects on its own.</summary>
    static int StreamSeconds = 1800;

    [HttpGet]
    [Route("/admin/monitor")]
    [Custom(IsMenu = true, Icon = "mdi:chart-line")]
    [Description("运行监控")]
    async void Index() {
        ViewData d = await this.Layout("运行监控");
        JsonValue m = JsonValue.ParseLenient(await MetricsCluster.SnapshotJson());
        JsonValue req = m.Get("requests");
        if (req == null) { req = JsonValue.NewObject(); }
        long workers = m.Long("workers", 1);
        d.Set("workers", Convert.ToString(workers));
        string wl = m.Str("worker_list", "");
        if (wl.Length == 0) { wl = Convert.ToString(m.Long("worker_id", 0)); }
        d.Set("worker", wl);
        d.Set("pid", Convert.ToString(m.Long("pid", 0)));
        d.Set("slow", Fmt.Dur(req.Long("slow_threshold_us", 0)));

        // The day's four figures are rendered with the page, so the first
        // paint already shows the day's total instead of this worker's counter
        // (which is 0 on a worker that has just been spawned). The page keeps
        // them current from /admin/monitor/today.
        long now = (long)WebApp.NowSeconds();
        long today = Monitor.Today(now);
        long from = Monitor.PickedDay(this.In("d"), today);
        long to = Monitor.DayEnd(from, today, now);
        int _f = await MetricsStore.Flush();
        MetricMinute day = await MetricsStore.WindowTotals(from, to, "", "");
        d.Set("day", Fmt.Day(from));
        d.Set("d", Fmt.Day(from));
        // A past day's cumulative half is finished history; the live half of
        // the page still describes right now, whichever day is being read.
        if (from < today) { d.Set("past", "1"); }
        d.Set("dayCalls", Convert.ToString(day.calls));
        d.Set("dayErrors", Convert.ToString(day.errors));
        d.Set("dayAvg", Fmt.Dur(Monitor.Avg(day.totalUs, day.calls)));
        d.Set("dayMax", Fmt.Dur(day.maxUs));
        this.Page(d);
    }

    /// <summary>The live snapshot stream. Not a menu entry: the monitor page is
    /// its user interface.</summary>
    [HttpGet]
    [Description("运行指标事件流")]
    async void Stream() {
        HttpContext ctx = this.Ctx();
        if (!await ctx.SseOpen()) { return; }

        // The first frame carries the recent history so the charts are drawn
        // full rather than filling up over the next two minutes. Every frame
        // is the merge of every live worker, not this process's own numbers.
        if (!await ctx.SseSend("series", await MetricsCluster.SeriesJson(120))) {
            return;
        }

        int elapsed = 0;
        int sinceSeries = 0;
        while (elapsed < Monitor.StreamSeconds) {
            await Task.Delay(2000);
            elapsed = elapsed + 2;
            sinceSeries = sinceSeries + 2;
            if (!await ctx.SseSend("metrics",
                    await MetricsCluster.SnapshotJson())) { return; }
            if (sinceSeries >= 10) {
                sinceSeries = 0;
                if (!await ctx.SseSend("series",
                        await MetricsCluster.SeriesJson(120))) {
                    return;
                }
            }
        }
    }

    /// How the day is bucketed on the live page: five minutes, so a whole day
    /// is 288 points -- enough to see a spike, few enough to draw.
    static long DayStep = 300;
    /// How many interfaces the day ranking shows per ordering it is taken by.
    static int DayRoutes = 20;

    /// <summary>One day -- today so far, or a picked one in full -- read from
    /// the persisted minute rows rather than from any process's counters.
    ///
    /// Why not the live snapshot: a worker's counters start at zero when it
    /// starts, so a restarted (or newly spawned) worker makes the page's
    /// totals, its ranking and its charts jump backwards -- the numbers "come
    /// and go" without anything having happened to the traffic. The minute
    /// table is written by every worker into one database, keyed by minute and
    /// interface, so it accumulates across restarts and across the fleet: the
    /// same request is counted once, whichever worker served it, and a chart
    /// drawn from it grows through the day instead of being replaced by the
    /// last two minutes of live samples.
    ///
    /// This worker's own unflushed buckets are flushed first, so the current
    /// minute is included. Another worker's are not: its last flush is at most
    /// [metrics].flushSeconds old, which is what `as_of` reports.</summary>
    static async string DayJson(long from, long to) {
        int _w = await MetricsStore.Flush();
        MetricMinute tot = await MetricsStore.WindowTotals(from, to, "", "");
        List<MetricMinute> rows = await MetricsStore.HistoryBuckets(from, to,
            "", "", Monitor.DayStep, Monitor.MaxRows);
        rows = Monitor.FillGaps(rows, from, to, Monitor.DayStep);

        // Oldest first: the chart's x axis runs forwards.
        JsonValue pts = JsonValue.NewArray();
        for (int i = rows.Count - 1; i >= 0; i = i - 1) {
            MetricMinute b = rows[i];
            JsonValue p = JsonValue.NewObject();
            p.Put("t", MetricsCluster.Num(b.minute));
            p.Put("calls", MetricsCluster.Num(b.calls));
            p.Put("errors", MetricsCluster.Num(b.errors));
            p.Put("avg_us", MetricsCluster.Num(Monitor.Avg(b.totalUs, b.calls)));
            p.Put("max_us", MetricsCluster.Num(b.maxUs));
            pts.Append(p);
        }

        JsonValue o = JsonValue.NewObject();
        o.Put("day", JsonValue.NewStr(Fmt.Day(from)));
        o.Put("from", MetricsCluster.Num(from));
        o.Put("as_of", MetricsCluster.Num(to));
        o.Put("step", MetricsCluster.Num(Monitor.DayStep));
        o.Put("calls", MetricsCluster.Num(tot.calls));
        o.Put("errors", MetricsCluster.Num(tot.errors));
        o.Put("avg_us", MetricsCluster.Num(Monitor.Avg(tot.totalUs, tot.calls)));
        o.Put("max_us", MetricsCluster.Num(tot.maxUs));
        o.Put("total_us", MetricsCluster.Num(tot.totalUs));
        o.Put("frames", MetricsCluster.Num(tot.frames));
        o.Put("bytes", MetricsCluster.Num(tot.bytes));
        o.Put("points", pts);
        o.Put("top", await Monitor.DayTop(from, to));
        return o.ToJson();
    }

    /// <summary>Today's interfaces, one row each, for a table the operator
    /// sorts by whichever column the question is about.
    ///
    /// Taken by both orderings the database can rank by and merged: the top
    /// interfaces by call count and the top ones by time spent are different
    /// sets -- the interface that ate the day is often not the busiest one --
    /// so ranking by only one of them would hide the other's leaders no matter
    /// which column the screen is then sorted by. An interface reached by both
    /// queries is kept once.</summary>
    static async JsonValue DayTop(long from, long to) {
        JsonValue arr = JsonValue.NewArray();
        Dictionary<string,int> seen = new Dictionary<string,int>();
        await Monitor.AppendDayTop(arr, seen, from, to, "calls");
        await Monitor.AppendDayTop(arr, seen, from, to, "time");
        return arr;
    }

    /// <summary>Appends today's interfaces ranked by `rank` -- "calls" (how
    /// often) or "time" (how much of the server's day the interface consumed)
    /// -- skipping the ones already in `arr`.</summary>
    static async void AppendDayTop(JsonValue arr, Dictionary<string,int> seen,
            long from, long to, string rank) {
        List<MetricMinute> tops = await MetricsStore.RouteTotalsBy(from, to,
            "", "", Monitor.DayRoutes, rank);
        for (int i = 0; i < tops.Count; i = i + 1) {
            MetricMinute b = tops[i];
            string req = b.method + " " + b.path;
            if (seen.ContainsKey(req)) { continue; }
            seen[req] = 1;
            JsonValue o = JsonValue.NewObject();
            o.Put("req", JsonValue.NewStr(req));
            o.Put("calls", MetricsCluster.Num(b.calls));
            o.Put("errors", MetricsCluster.Num(b.errors));
            o.Put("avg_us", MetricsCluster.Num(Monitor.Avg(b.totalUs, b.calls)));
            o.Put("max_us", MetricsCluster.Num(b.maxUs));
            o.Put("total_us", MetricsCluster.Num(b.totalUs));
            arr.Append(o);
        }
    }

    /// <summary>A day's cumulative figures as one request, for tooling and for
    /// the page's first paint. `d` (YYYY-MM-DD) picks the day; today by
    /// default.</summary>
    [HttpGet]
    [Description("当天累计指标")]
    async void Today() {
        long now = (long)WebApp.NowSeconds();
        long today = Monitor.Today(now);
        long from = Monitor.PickedDay(this.In("d"), today);
        this.Json(await Monitor.DayJson(from,
            Monitor.DayEnd(from, today, now)));
    }

    /// <summary>The second today started.</summary>
    static long Today(long now) { return (now / 86400) * 86400; }

    /// <summary>The day a screen asked for: the picked date when it parses and
    /// is not in the future, otherwise today. A day that has not happened has
    /// no rows, and answering with an empty screen would read as lost
    /// history.</summary>
    static long PickedDay(string day, long today) {
        long start = Monitor.DaySeconds(day);
        if (start < 0 || start > today) { return today; }
        return start;
    }

    /// <summary>Where the day being read ends: midnight for a finished day, and
    /// now for today -- a window that ran to tonight's midnight would report
    /// the hours that have not happened yet as a day with no traffic.</summary>
    static long DayEnd(long from, long today, long now) {
        if (from >= today) { return now; }
        return from + 86399;
    }

    /// <summary>The same snapshot as one request, for tooling that is not a
    /// browser.</summary>
    [HttpGet]
    [Description("运行指标快照")]
    async void Snapshot() {
        this.Json(await MetricsCluster.SnapshotJson());
    }

    [HttpGet]
    [Description("运行指标时序")]
    async void Series() {
        this.Json(await MetricsCluster.SeriesJson(this.InInt("sec", 120)));
    }

    /// <summary>The analysis the live stream cannot do: which hour (or day)
    /// carried how much traffic at what throughput and latency, and which
    /// interfaces carried it. Both tables are grouped by the database -- per
    /// time bucket (minute/hour/day via `g`) and per interface over the window
    /// -- not assembled from raw minute rows on the screen. An interface is a
    /// method and a path ("GET" + "/api/index/index"), the two filters `m` and
    /// `route` narrow to; a request no route or asset served has no path of its
    /// own and was never filed, so nothing here comes from a scanner's URL.
    /// </summary>
    [HttpGet]
    [Route("/admin/monitor/history")]
    [Custom(IsMenu = true, Icon = "mdi:chart-timeline-variant")]
    [Description("历史统计")]
    async void History() {
        ViewData d = await this.Layout("历史统计");
        string method = this.In("m");
        string route = this.In("route");
        // Two ways to pick the window, because they answer different
        // questions: `h` is "the last N hours" (what is happening now) and
        // `d`/`d2` are calendar dates (what happened that day). A dated window
        // is closed on both ends, so its buckets are the same rows every time
        // it is opened -- a rolling window's are not.
        MetricWindow w = Monitor.Window(this.In("d"), this.In("d2"),
            this.InInt("h", 24));
        string gran = Monitor.Gran(this.In("g"), w.hours);
        long step = Monitor.Step(gran);
        long from = w.from;
        long to = w.to;

        // The window is flushed first, so "the last hour" includes the minute
        // that is still being filled instead of stopping ten minutes short.
        int _w = await MetricsStore.Flush();
        List<MetricMinute> rows = await MetricsStore.HistoryBuckets(from, to,
            method, route, step, Monitor.MaxRows);
        // Two orders, because they answer different questions: which
        // interface was called most, and which one the server spent the
        // window inside. The parameter picks between them by name; it never
        // reaches the statement.
        string by = "calls";
        if (this.In("by") == "time") { by = "time"; }
        List<MetricMinute> tops = await MetricsStore.RouteTotalsBy(from, to,
            method, route, Monitor.MaxRoutes, by);
        // A dated window shows every bucket it contains, including the ones
        // with no traffic: "03:00 had nothing" is a fact about the day, and a
        // table that silently skips those hours cannot be read as a timeline.
        if (w.dated) { rows = Monitor.FillGaps(rows, from, to, step); }

        List<StrMap> items = d.AddList("rows");
        long calls = 0;
        long errors = 0;
        long peakQps10 = 0;    // peak bucket throughput, in tenths of req/s
        for (int i = 0; i < rows.Count; i = i + 1) {
            MetricMinute b = rows[i];
            calls = calls + b.calls;
            errors = errors + b.errors;
            long qps10 = b.calls * 10 / step;
            if (qps10 > peakQps10) { peakQps10 = qps10; }
            StrMap r = new StrMap();
            r.Set("bucket", Monitor.BucketLabel(b.minute, gran));
            r.Set("calls", Convert.ToString(b.calls));
            r.Set("qps", Monitor.Tenths(qps10));
            r.Set("errors", Convert.ToString(b.errors));
            r.Set("errRate", Monitor.Rate(b.errors, b.calls));
            r.Set("avg", Fmt.Dur(Monitor.Avg(b.totalUs, b.calls)));
            r.Set("max", Fmt.Dur(b.maxUs));
            r.Set("frames", Convert.ToString(b.frames));
            r.Set("bytes", Fmt.Bytes(b.bytes));
            items.Add(r);
        }

        List<StrMap> routes = d.AddList("routes");
        for (int i = 0; i < tops.Count; i = i + 1) {
            MetricMinute b = tops[i];
            StrMap r = new StrMap();
            // Two cells, because they are two things: the verb and the
            // interface. The old single "route" cell is still filled with the
            // pair so a view that has not been updated keeps rendering.
            r.Set("method", b.method);
            r.Set("path", b.path);
            r.Set("route", b.method + " " + b.path);
            r.Set("calls", Convert.ToString(b.calls));
            r.Set("share", Monitor.Rate(b.calls, calls));
            r.Set("errors", Convert.ToString(b.errors));
            r.Set("errRate", Monitor.Rate(b.errors, b.calls));
            r.Set("avg", Fmt.Dur(Monitor.Avg(b.totalUs, b.calls)));
            r.Set("max", Fmt.Dur(b.maxUs));
            r.Set("total", Fmt.Dur(b.totalUs));
            r.Set("frames", Convert.ToString(b.frames));
            r.Set("bytes", Fmt.Bytes(b.bytes));
            routes.Add(r);
        }

        d.Set("by", by);
        d.Set("by_" + by, "1");
        d.Set("hours", Convert.ToString(w.hours));
        d.Set("m", method);
        d.Set("route", route);
        d.Set("g", gran);
        d.Set("g_" + gran, "1");
        d.Set("d", w.day);
        d.Set("d2", w.day2);
        d.Set("from", Fmt.Stamp(from));
        d.Set("to", Fmt.Stamp(to));
        if (w.dated) { d.Set("dated", "1"); }
        if (w.invalid) { d.Set("badDate", "1"); }
        // The window as one label, built here rather than in the template: the
        // view engine has no {{else}}, and a KPI that reads "24 小时" for a
        // dated query would describe the wrong window.
        string label = Convert.ToString(w.hours) + " 小时";
        if (w.dated) {
            label = w.day;
            if (w.day2 != w.day) { label = label + " → " + w.day2; }
        }
        d.Set("window", label);
        d.Set("calls", Convert.ToString(calls));
        d.Set("errors", Convert.ToString(errors));
        long windowQps10 = 0;
        long span = to - from;
        if (span > 0) { windowQps10 = calls * 10 / span; }
        d.Set("avgQps", Monitor.Tenths(windowQps10));
        d.Set("peakQps", Monitor.Tenths(peakQps10));
        d.Set("shown", Convert.ToString(rows.Count));
        // A dated window always has its buckets (zero-filled), so "nothing
        // here" is about the traffic, not about how many rows came back.
        if (calls == 0) { d.Set("empty", "1"); }
        if (rows.Count >= Monitor.MaxRows) { d.Set("capped", "1"); }
        this.Page(d);
    }

    /// <summary>The same window as a file. Bounded by the same row cap as the
    /// screen, so an export cannot be used to pull the whole database in one
    /// request.</summary>
    [HttpGet]
    [Description("导出历史统计")]
    async void Export() {
        string method = this.In("m");
        string route = this.In("route");
        MetricWindow win = Monitor.Window(this.In("d"), this.In("d2"),
            this.InInt("h", 24));
        string gran = Monitor.Gran(this.In("g"), win.hours);
        long step = Monitor.Step(gran);
        long from = win.from;
        long to = win.to;
        int _w = await MetricsStore.Flush();
        List<MetricMinute> rows = await MetricsStore.HistoryBuckets(from, to,
            method, route, step, Monitor.MaxRows);
        if (win.dated) { rows = Monitor.FillGaps(rows, from, to, step); }

        if (this.In("format") == "json") {
            MetricsExportDoc doc = new MetricsExportDoc();
            doc.from = from;
            doc.to = to;
            doc.rows = new List<MetricsRowDoc>();
            doc.step_seconds = step;
            for (int i = 0; i < rows.Count; i = i + 1) {
                MetricMinute b = rows[i];
                MetricsRowDoc o = new MetricsRowDoc();
                o.bucket = b.minute;
                // What the rows were filtered to: a bucket row is a sum over
                // interfaces, so it carries the filter, not a name of its own.
                o.method = method;
                o.path = route;
                o.calls = b.calls;
                o.errors = b.errors;
                o.avg_us = Monitor.Avg(b.totalUs, b.calls);
                o.max_us = b.maxUs;
                o.frames = b.frames;
                o.bytes = b.bytes;
                doc.rows.Add(o);
            }
            this.Ctx().Download("metrics.json", "application/json",
                Json.Serialize<MetricsExportDoc>(doc));
            return;
        }

        StringBuilder sb = new StringBuilder();
        sb.Append("bucket,method,path,calls,errors,avg_us,max_us,frames,bytes\n");
        for (int i = 0; i < rows.Count; i = i + 1) {
            MetricMinute b = rows[i];
            sb.Append(Convert.ToString(b.minute));
            sb.Append(",");
            sb.Append(Monitor.Cell(method));
            sb.Append(",");
            sb.Append(Monitor.Cell(route));
            sb.Append(",");
            sb.Append(Convert.ToString(b.calls));
            sb.Append(",");
            sb.Append(Convert.ToString(b.errors));
            sb.Append(",");
            sb.Append(Convert.ToString(Monitor.Avg(b.totalUs, b.calls)));
            sb.Append(",");
            sb.Append(Convert.ToString(b.maxUs));
            sb.Append(",");
            sb.Append(Convert.ToString(b.frames));
            sb.Append(",");
            sb.Append(Convert.ToString(b.bytes));
            sb.Append("\n");
        }
        this.Ctx().Download("metrics.csv", "text/csv; charset=utf-8",
            sb.ToString());
    }

    /// <summary>Every error the server caught, as persisted by the sink the
    /// dispatcher feeds. Details are redacted before they are stored, so this
    /// screen shows no keys, tokens or passwords.</summary>
    [HttpGet]
    [Route("/admin/monitor/errors")]
    [Custom(IsMenu = true, Icon = "mdi:alert-circle-outline")]
    [Description("错误日志")]
    async void Errors() {
        ViewData d = await this.Layout("错误日志");
        int hours = Monitor.Hours(this.InInt("h", 24));
        long to = (long)WebApp.NowSeconds();
        long from = to - (long)hours * 3600;
        int _w = await MetricsStore.Flush();
        List<MetricError> rows = await MetricsStore.Errors(from, to,
            Monitor.MaxRows);
        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            MetricError e = rows[i];
            StrMap r = new StrMap();
            r.Set("id", Convert.ToString(e.id));
            r.Set("ts", Fmt.Stamp(e.ts));
            r.Set("origin", e.origin);
            r.Set("detail", e.detail);
            items.Add(r);
        }
        d.Set("hours", Convert.ToString(hours));
        d.Set("shown", Convert.ToString(rows.Count));
        if (rows.Count == 0) { d.Set("empty", "1"); }
        this.Page(d);
    }

    /// <summary>The shared memory this process has mapped, read-only: one row
    /// per table with what it holds and what it costs. A table's mapping is
    /// reserved address space -- rows are addressable without being paid for --
    /// so the size it was created with and the part of it that is actually
    /// resident are two columns, never one. The numbers are per process: every
    /// worker maps the same table at its own residency.</summary>
    [HttpGet]
    [Route("/admin/monitor/tables")]
    [Custom(IsMenu = true, Icon = "mdi:memory")]
    [Description("共享内存表")]
    async void Tables() {
        ViewData d = await this.Layout("共享内存表");
        List<StrMap> items = d.AddList("rows");
        long reserved = 0;
        long resident = 0;
        bool partial = false;
        int n = SharedTable.OpenCount();
        for (int i = 0; i < n; i = i + 1) {
            long res = SharedTable.OpenStat(i, SharedTable.STAT_RESERVED);
            long live = SharedTable.OpenStat(i, SharedTable.STAT_RESIDENT);
            long cap = SharedTable.OpenStat(i, SharedTable.STAT_CAPACITY);
            long used = SharedTable.OpenStat(i, SharedTable.STAT_COUNT);
            StrMap r = new StrMap();
            r.Set("name", SharedTable.OpenLabel(i));
            r.Set("used", Convert.ToString(used));
            r.Set("capacity", Convert.ToString(cap));
            r.Set("fill", Monitor.Rate(used, cap));
            r.Set("stride", Convert.ToString(
                SharedTable.OpenStat(i, SharedTable.STAT_ROW_STRIDE)));
            r.Set("keySize", Convert.ToString(
                SharedTable.OpenStat(i, SharedTable.STAT_KEY_SIZE)));
            r.Set("columns", Convert.ToString(
                SharedTable.OpenStat(i, SharedTable.STAT_COLUMNS)));
            r.Set("reserved", Fmt.Bytes(res));
            r.Set("resident", Fmt.Bytes(live));
            items.Add(r);
            reserved = reserved + res;
            // A platform that cannot report residency reports -1, and one
            // unknown row makes the total an underestimate rather than a lie.
            if (live < 0) { partial = true; } else { resident = resident + live; }
        }
        d.Set("count", Convert.ToString(n));
        d.Set("reserved", Fmt.Bytes(reserved));
        d.Set("resident", Fmt.Bytes(resident));
        if (partial) { d.Set("partial", "1"); }
        if (n == 0) { d.Set("empty", "1"); }
        this.Page(d);
    }

    /// <summary>The largest window and page an export or screen may ask for.
    /// A query string is not allowed to decide how much of the database one
    /// request reads.</summary>
    static int MaxRows = 5000;
    static int MaxHours = 720;
    /// How many interfaces the per-interface table shows: enough for every real
    /// API, bounded so a long route table cannot grow the page without limit.
    static int MaxRoutes = 100;

    static int Hours(int h) {
        if (h < 1) { return 1; }
        if (h > Monitor.MaxHours) { return Monitor.MaxHours; }
        return h;
    }

    /// <summary>The window a screen asked for: a calendar day (or a range of
    /// them) when `day` parses, otherwise the last `h` hours. A dated window
    /// covers whole days -- 00:00:00 through 23:59:59 -- so the same date always
    /// answers with the same buckets, and it is clamped to MaxHours like the
    /// rolling one: a query string does not get to ask for a year at a
    /// time.</summary>
    static MetricWindow Window(string day, string day2, int h) {
        MetricWindow w = new MetricWindow();
        w.day = "";
        w.day2 = "";
        w.dated = false;
        w.invalid = false;
        long start = Monitor.DaySeconds(day);
        if (day.Length > 0 && start < 0) { w.invalid = true; }
        if (start >= 0) {
            long end = Monitor.DaySeconds(day2);
            if (day2.Length > 0 && end < 0) { w.invalid = true; }
            if (end < start) { end = start; }
            long span = (end - start) / 3600 + 24;
            if (span > (long)Monitor.MaxHours) {
                end = start + ((long)Monitor.MaxHours - 24) * 3600;
                span = (long)Monitor.MaxHours;
            }
            w.from = start;
            w.to = end + 86399;
            w.hours = (int)span;
            w.dated = true;
            w.day = Fmt.Day(start);
            w.day2 = Fmt.Day(end);
            return w;
        }
        w.hours = Monitor.Hours(h);
        w.to = (long)WebApp.NowSeconds();
        w.from = w.to - (long)w.hours * 3600;
        return w;
    }

    /// <summary>"YYYY-MM-DD" as the UTC second that day starts, or -1 when it
    /// is not a date. Parsed by hand rather than trusted: this value picks the
    /// rows a page reads.</summary>
    static long DaySeconds(string s) {
        if (s == null || s.Length != 10) { return 0 - 1; }
        if (s.Substring(4, 1) != "-" || s.Substring(7, 1) != "-") {
            return 0 - 1;
        }
        int y = Monitor.Digits(s, 0, 4);
        int m = Monitor.Digits(s, 5, 2);
        int dd = Monitor.Digits(s, 8, 2);
        if (y < 1970 || m < 1 || m > 12 || dd < 1) { return 0 - 1; }
        if (dd > DateTime.DaysInMonth(y, m)) { return 0 - 1; }
        return DateTime.FromDate(y, m, dd).ToUnixSeconds();
    }

    /// <summary>`n` digits of `s` at `at` as a number, or -1 if any of them is
    /// not a digit.</summary>
    static int Digits(string s, int at, int n) {
        int v = 0;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[at + i] & 255;
            if (c < 48 || c > 57) { return 0 - 1; }
            v = v * 10 + (c - 48);
        }
        return v;
    }

    /// <summary>The same rows with every empty bucket of the window filled in
    /// as a zero row, newest first -- what makes a day 24 hours long on screen
    /// whether or not it had traffic. Bounded by MaxRows like the query
    /// itself.</summary>
    static List<MetricMinute> FillGaps(List<MetricMinute> rows, long from,
                                       long to, long step) {
        List<MetricMinute> outp = new List<MetricMinute>();
        long first = (from / step) * step;
        long last = (to / step) * step;
        int at = 0;
        for (long b = last; b >= first; b = b - step) {
            if (outp.Count >= Monitor.MaxRows) { break; }
            if (at < rows.Count && rows[at].minute == b) {
                outp.Add(rows[at]);
                at = at + 1;
                continue;
            }
            MetricMinute z = new MetricMinute();
            z.minute = b;
            z.method = "";
            z.path = "";
            outp.Add(z);
        }
        return outp;
    }

    /// <summary>The granularity, validated; unset picks the one whose table
    /// stays readable for the window (minutes up to 3h, hours up to 3 days,
    /// days beyond).</summary>
    static string Gran(string g, int hours) {
        if (g == "min" || g == "hour" || g == "day") { return g; }
        if (hours <= 3) { return "min"; }
        if (hours <= 72) { return "hour"; }
        return "day";
    }

    static long Step(string gran) {
        if (gran == "min") { return 60; }
        if (gran == "day") { return 86400; }
        return 3600;
    }

    /// <summary>The bucket as the screen names it: a day by its date, an hour
    /// as "date hh:00", a minute with its full clock.</summary>
    static string BucketLabel(long sec, string gran) {
        if (gran == "day") { return Fmt.Day(sec); }
        string s = Fmt.Stamp(sec);
        if (gran == "hour" && s.Length >= 3) {
            return s.Substring(0, s.Length - 3);
        }
        return s;
    }

    /// <summary>A count in tenths, as "12.3". Integer arithmetic: the number
    /// is for a table cell, not for further math.</summary>
    static string Tenths(long v10) {
        return Convert.ToString(v10 / 10) + "." + Convert.ToString(v10 % 10);
    }

    /// <summary>`part` of `whole` as a percentage with one decimal.</summary>
    static string Rate(long part, long whole) {
        if (whole <= 0) { return "0.0"; }
        return Monitor.Tenths(part * 1000 / whole);
    }

    /// <summary>Mean duration in microseconds, 0 for a bucket with no calls (a
    /// zero-filled hour has no average, and dividing by its 0 calls would be a
    /// fault rather than an answer).</summary>
    static long Avg(long totalUs, long calls) {
        if (calls <= 0) { return 0; }
        return totalUs / calls;
    }

    /// <summary>A CSV cell: quoted, with embedded quotes doubled, so a route
    /// name can never break the column layout.</summary>
    static string Cell(string v) {
        StringBuilder sb = new StringBuilder();
        sb.Append("\"");
        for (int i = 0; i < v.Length; i = i + 1) {
            string ch = v.Substring(i, 1);
            if ((v[i] & 255) == 34) { sb.Append("\""); }
            sb.Append(ch);
        }
        sb.Append("\"");
        return sb.ToString();
    }
}

/// <summary>What an export answers with: the window and its rows, serialized by
/// the JSON writer rather than assembled as text.</summary>
class MetricsRowDoc {
    long bucket;
    string method;
    string path;
    long calls;
    long errors;
    // Microseconds: the unit every duration the server records is kept in.
    long avg_us;
    long max_us;
    long frames;
    long bytes;
}

class MetricsExportDoc {
    long from;
    long to;
    long step_seconds;
    List<MetricsRowDoc> rows;
}

/// <summary>The time window a screen or an export is looking at, and how it was
/// asked for: `dated` distinguishes "that day" from "the last N hours", which
/// decides whether empty buckets are shown as zeros.</summary>
class MetricWindow {
    long from;
    long to;
    int hours;
    bool dated;
    bool invalid;
    string day;
    string day2;
}
