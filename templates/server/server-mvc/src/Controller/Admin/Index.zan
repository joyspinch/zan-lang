using System;
using ZanWeb;
using System.Web;

namespace ZanWeb.Admin;

/// <summary>Admin landing / menu tree. Route: /admin/index/index. A module-local
/// <c>Index</c> distinct from ZanWeb.Index.Index / ZanWeb.Api.Index.</summary>
[Route("admin/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.ApiAuth, IsMenu = true,
        MenuGroup = "系统", Rank = 50, Icon = "mdi:menu")]
[Description("管理菜单")]
class Index : Controller {
    /// The caller's own menu, not the whole route table: the server decides what
    /// is reachable so a front end cannot render a link the API would refuse.
    [HttpGet]
    [Description("菜单 JSON")]
    async void Index() {
        this.Ok(await MenuBuilder.JsonFor(WebHost.Current(), this.uid,
            this.In("active")));
    }
}
