using System;
using System.Data;
using System.Data.Orm;
using System.IO;
using System.Json;
using System.Text;
using System.Web;
using ZanWeb.Ai;
using ZanWeb.Core;
using ZanWeb.Model.Sys;
using ZanWeb.Security;
using ZanWeb.Services;
using ZanWeb.Web;
using ZanWeb.Model.Sys;

namespace ZanWeb.Admin.Dev;

/* /admin/dev/coder 表设计器：设计表（列及其在管理界面的角色）→ 建入数据库 → 通用屏不够用时写出 .zan 源码。三步各为一键，各成本不同：保存设计仅触及 sys_gen_*，迁移发 DDL，生成写文件须重建生效。不会自动丢弃或重写：设计器只做加法。 */
[Route("admin/dev/coder/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("代码生成")]
class Coder : AdminController {
    [HttpGet]
    [Route("/admin/dev/coder")]
    [Custom(IsMenu = true, Icon = "mdi:table-cog", Perm = PermBit.View)]
    [Description("表设计与生成")]
    async void Index() {
        ViewData d = await this.Layout("表设计与生成");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }

        List<GenTable> rows = await this.GenTable.OrderBy(a => a.id).ToListAsync();
        List<StrMap> list = d.AddList("tables");
        for (int i = 0; i < rows.Count; i = i + 1) {
            GenTable t = rows[i];
            int cols = await this.GenColumn.Where(a => a.tableId == t.id).CountAsync();
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(t.id));
            row.Set("tableName", t.tableName);
            row.Set("entityName", t.entityName);
            row.Set("title", t.title);
            row.Set("section", t.section);
            row.Set("columns", Convert.ToString(cols));
            row.Set("stateText", "未建表");
            row.Set("stateClass", "off");
            if (t.migrated == 1) { row.Set("stateText", "已建表"); row.Set("stateClass", "ok"); }
            if (t.apiEnabled == 1) { row.Set("api", "1"); }
            list.Add(row);
        }
        if (rows.Count == 0) { d.Set("empty", "1"); }
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("表信息表单")]
    async void TableForm() {
        int id = this.InInt("id", 0);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("dialogTitle", "新建数据表");
        d.Set("section", "content");
        d.Set("apiChecked", "checked");
        if (id > 0) {
            GenTable t = await this.GenTable.ById(id);
            if (t == null) { this.Fail(404, "0404", "设计不存在"); }
            d.Set("dialogTitle", "编辑表信息");
            d.Set("tableName", t.tableName);
            d.Set("entityName", t.entityName);
            d.Set("title", t.title);
            d.Set("section", t.section);
            d.Set("apiChecked", "");
            if (t.apiEnabled == 1) { d.Set("apiChecked", "checked"); }
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存表信息")]
    async void TableSave() {
        int id = this.InInt("id", 0);
        string tableName = this.Need("tableName", "表名");
        string title = this.Need("title", "名称");
        if (!Gen.Safe(tableName)) {
            this.Fail(400, "0004", "表名只能用小写字母、数字和下划线，且以字母开头");
        }
        string entityName = this.In("entityName");
        if (entityName.Length == 0) { entityName = Coder.Pascal(tableName); }
        /* URL 段落而非标签：侧边栏分区由此派生。 */
        string section = this.In("section");
        if (!Gen.Safe(section)) { section = "content"; }
        int api = 0;
        if (this.In("apiEnabled") == "1") { api = 1; }

        GenTable clash = await this.GenTable
            .Where(a => a.tableName == tableName).FirstAsync();
        if (clash != null && clash.id != id) {
            this.Fail(400, "0004", "表 " + tableName + " 已经设计过了");
        }
        if (id > 0) {
            int n = await this.GenTable.Update()
                .Set(a => a.tableName, tableName)
                .Set(a => a.entityName, entityName)
                .Set(a => a.title, title)
                .Set(a => a.section, section)
                .Set(a => a.apiEnabled, api)
                .Set(a => a.updatedAt, WebApp.NowSeconds())
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑表设计", tableName, n > 0, "");
            this.Saved("表信息已保存");
            return;
        }
        GenTable t = new GenTable();
        t.tableName = tableName;
        t.entityName = entityName;
        t.title = title;
        t.section = section;
        t.orderColumn = "id";
        t.orderDesc = 1;
        t.apiEnabled = api;
        t.migrated = 0;
        t.createdAt = WebApp.NowSeconds();
        t.updatedAt = t.createdAt;
        int newId = await this.GenTable.Insert(t).ExecuteIdentityAsync();
        await this.Note("新建表设计", tableName, newId > 0, "");
        this.Saved("表已创建，去添加字段");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除表设计")]
    async void TableDelete() {
        int id = this.InInt("id", 0);
        GenTable t = await this.GenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        int n = await this.GenTable.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        int _c = await this.GenColumn.Delete().Where(a => a.tableId == id)
            .ExecuteAffrowsAsync();
        await this.Note("删除表设计", t.tableName, n > 0,
            "物理表保留");
        this.Saved("设计已删除，数据库中的表保留");
    }

    [HttpGet]
    [Route("/admin/dev/coder/design")]
    [Custom(Perm = PermBit.View)]
    [Description("字段设计")]
    async void Design() {
        bool inDialog = this.In("as") == "dialog";
        ViewData d = inDialog ? new ViewData() : await this.Layout("字段设计");
        if (inDialog) { d.Set("dialogTitle", "字段设计"); await this.Buttons(d); }
        int id = this.InInt("id", 0);
        GenTable t = await this.GenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        d.Set("id", Convert.ToString(t.id));
        d.Set("tableName", t.tableName);
        d.Set("entityName", t.entityName);
        d.Set("tableTitle", t.title);
        if (t.migrated == 1) { d.Set("migrated", "1"); }
        /* AI 生成入口：服务已配置且此屏可增改时出现；权限在各动作上再拦一道。 */
        if (await Ai.Ready() && (await this.Can((int)PermBit.Create)
                || await this.Can((int)PermBit.Update))) {
            d.Set("canAi", "1");
        }

        List<GenColumn> cols = await this.GenColumn
            .Where(a => a.tableId == id).OrderBy(a => a.sortOrder).ToListAsync();
        /* 行内控件（勾选/名称/类型/控件/排序）只对可更新者可用，只读者拿到禁用态。 */
        bool canEdit = await this.Can((int)PermBit.Update);
        List<StrMap> list = d.AddList("columns");
        for (int i = 0; i < cols.Count; i = i + 1) {
            GenColumn c = cols[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(c.id));
            row.Set("name", c.name);
            row.Set("label", c.label);
            row.Set("kind", c.kind);
            row.Set("widget", c.widget);
            row.Set("sortOrder", Convert.ToString(c.sortOrder));
            row.Set("inList", Coder.Checked(c.inList));
            row.Set("inFilter", Coder.Checked(c.inFilter));
            row.Set("inCreate", Coder.Checked(c.inCreate));
            row.Set("inEdit", Coder.Checked(c.inEdit));
            row.Set("required", Coder.Checked(c.required));
            if (!canEdit) { row.Set("dis", "disabled"); }
            row.Set("rel", Coder.Rel(c));
            list.Add(row);
        }
        if (cols.Count == 0) { d.Set("empty", "1"); }
        d.Set("showBar", inDialog ? "" : "1");
        if (inDialog) { this.Dialog(d); return; }
        this.Page(d);
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("字段表单")]
    async void ColumnForm() {
        int id = this.InInt("id", 0);
        int tableId = this.InInt("tableId", 0);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("tableId", Convert.ToString(tableId));
        d.Set("dialogTitle", "新增字段");
        d.Set("size", "255");
        d.Set("sortOrder", "10");
        d.Set("inListChecked", "checked");
        d.Set("inCreateChecked", "checked");
        d.Set("inEditChecked", "checked");
        if (id > 0) {
            GenColumn c = await this.GenColumn.ById(id);
            if (c == null) { this.Fail(404, "0404", "字段不存在"); }
            d.Set("dialogTitle", "编辑字段");
            d.Set("tableId", Convert.ToString(c.tableId));
            d.Set("name", c.name);
            d.Set("label", c.label);
            d.Set("kindValue", c.kind);
            d.Set("widgetValue", c.widget);
            d.Set("size", Convert.ToString(c.size));
            d.Set("defValue", c.defValue);
            d.Set("dictType", c.dictType);
            d.Set("relTable", c.relTable);
            d.Set("relValue", c.relValue);
            d.Set("relLabel", c.relLabel);
            d.Set("sortOrder", Convert.ToString(c.sortOrder));
            d.Set("inListChecked", Coder.Checked(c.inList));
            d.Set("inFilterChecked", Coder.Checked(c.inFilter));
            d.Set("inCreateChecked", Coder.Checked(c.inCreate));
            d.Set("inEditChecked", Coder.Checked(c.inEdit));
            d.Set("requiredChecked", Coder.Checked(c.required));
            d.Set("nullableChecked", Coder.Checked(c.nullable));
        }

        /* 关联选择器列出该管理后台所知的表，使外键为选择而非手输。 */
        List<GenTable> tables = await this.GenTable.OrderBy(a => a.id).ToListAsync();
        List<StrMap> opts = d.AddList("tables");
        for (int i = 0; i < tables.Count; i = i + 1) {
            StrMap row = new StrMap();
            row.Set("tableName", tables[i].tableName);
            row.Set("title", tables[i].title);
            opts.Add(row);
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存字段")]
    async void ColumnSave() {
        int id = this.InInt("id", 0);
        int tableId = this.InInt("tableId", 0);
        string name = this.Need("name", "字段名");
        if (!Gen.Safe(name) || name == "id") {
            this.Fail(400, "0004", "字段名只能用小写字母、数字和下划线，且不能是 id");
        }
        string kind = this.In("kind");
        if (kind.Length == 0) { kind = "string"; }
        GenColumn clash = await this.GenColumn
            .Where(a => a.tableId == tableId).Where(a => a.name == name).FirstAsync();
        if (clash != null && clash.id != id) {
            this.Fail(400, "0004", "字段 " + name + " 已存在");
        }
        string relTable = this.In("relTable");
        if (relTable.Length > 0 && !Gen.Safe(relTable)) {
            this.Fail(400, "0004", "关联表名不合法");
        }
        string relValue = this.In("relValue");
        string relLabel = this.In("relLabel");
        if (relTable.Length > 0) {
            if (relValue.Length == 0) { relValue = "id"; }
            if (relLabel.Length == 0) { relLabel = "name"; }
            if (!Gen.Safe(relValue) || !Gen.Safe(relLabel)) {
                this.Fail(400, "0004", "关联字段名不合法");
            }
        }

        GenColumn c = new GenColumn();
        if (id > 0) {
            GenColumn cur = await this.GenColumn.ById(id);
            if (cur == null) { this.Fail(404, "0404", "字段不存在"); }
            c = cur;
        }
        c.tableId = tableId;
        c.name = name;
        c.kind = kind;
        c.size = this.InInt("size", 255);
        c.defValue = this.In("defValue");
        c.label = this.In("label");
        c.widget = this.In("widget");
        if (c.widget.Length == 0) { c.widget = "text"; }
        c.dictType = this.In("dictType");
        c.relTable = relTable;
        c.relValue = relValue;
        c.relLabel = relLabel;
        c.sortOrder = this.InInt("sortOrder", 10);
        c.nullable = Coder.Flag(this.In("nullable"));
        c.inList = Coder.Flag(this.In("inList"));
        c.inFilter = Coder.Flag(this.In("inFilter"));
        c.inCreate = Coder.Flag(this.In("inCreate"));
        c.inEdit = Coder.Flag(this.In("inEdit"));
        c.required = Coder.Flag(this.In("required"));

        if (id > 0) {
            int n = await this.GenColumn.Update()
                .Set(a => a.name, c.name)
                .Set(a => a.kind, c.kind)
                .Set(a => a.size, c.size)
                .Set(a => a.defValue, c.defValue)
                .Set(a => a.label, c.label)
                .Set(a => a.widget, c.widget)
                .Set(a => a.dictType, c.dictType)
                .Set(a => a.relTable, c.relTable)
                .Set(a => a.relValue, c.relValue)
                .Set(a => a.relLabel, c.relLabel)
                .Set(a => a.sortOrder, c.sortOrder)
                .Set(a => a.nullable, c.nullable)
                .Set(a => a.inList, c.inList)
                .Set(a => a.inFilter, c.inFilter)
                .Set(a => a.inCreate, c.inCreate)
                .Set(a => a.inEdit, c.inEdit)
                .Set(a => a.required, c.required)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", name, n > 0, "");
            this.Saved("字段已保存");
            return;
        }
        int newId = await this.GenColumn.Insert(c).ExecuteIdentityAsync();
        await this.Note("新增字段", name, newId > 0, "");
        this.Saved("字段已添加");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除字段")]
    async void ColumnDelete() {
        int id = this.InInt("id", 0);
        GenColumn c = await this.GenColumn.ById(id);
        if (c == null) { this.Fail(404, "0404", "字段不存在"); }
        int n = await this.GenColumn.Delete().Where(a => a.id == id)
            .ExecuteAffrowsAsync();
        await this.Note("删除字段", c.name, n > 0,
            "数据库中的列保留");
        this.Saved("字段已从设计中移除，数据库中的列保留");
    }

    /* 行内快速改：设计表里的勾选/名称/类型/控件/排序就地提交，免去为一个小开关
       开一次编辑框。只放行白名单列，每列单独校验后单独更新；列名永不来自请求，
       更新构造器按字段写死，调用方无法指定任意列。深度属性（默认值/长度/字典/
       关联）仍走编辑对话框。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("字段行内修改")]
    async void ColumnQuick() {
        int id = this.InInt("id", 0);
        string field = this.Need("field", "属性");
        string value = this.In("value");
        GenColumn c = await this.GenColumn.ById(id);
        if (c == null) { this.Fail(404, "0404", "字段不存在"); }

        if (field == "label") {
            string label = Coder.Clip(value, 64);
            if (label.Length == 0) { label = c.name; }
            int n = await this.GenColumn.Update()
                .Set(a => a.label, label)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0, "label=" + label);
            this.Ok("{}");
            return;
        }
        if (field == "sortOrder") {
            int sort = this.InInt("value", c.sortOrder);
            if (sort < 0) { sort = 0; }
            if (sort > 9999999) { sort = 9999999; }
            int n = await this.GenColumn.Update()
                .Set(a => a.sortOrder, sort)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0,
                "sortOrder=" + Convert.ToString(sort));
            this.Ok("{}");
            return;
        }
        if (field == "kind") {
            if (!Coder.InList(value, "string,text,int,long,decimal,bool,datetime")) {
                this.Fail(400, "0004", "不支持的存储类型");
            }
            int n = await this.GenColumn.Update()
                .Set(a => a.kind, value)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0, "kind=" + value);
            this.Ok("{}");
            return;
        }
        if (field == "widget") {
            if (!Coder.InList(value,
                    "text,textarea,number,select,switch,date,richtext,upload")) {
                this.Fail(400, "0004", "不支持的控件");
            }
            int n = await this.GenColumn.Update()
                .Set(a => a.widget, value)
                .Where(a => a.id == id).ExecuteAffrowsAsync();
            await this.Note("编辑字段", c.name, n > 0, "widget=" + value);
            this.Ok("{}");
            return;
        }
        if (field == "inList" || field == "inFilter" || field == "inCreate"
            || field == "inEdit" || field == "required" || field == "nullable") {
            int v = Coder.Flag(value);
            int n = 0;
            if (field == "inList") {
                n = await this.GenColumn.Update().Set(a => a.inList, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else if (field == "inFilter") {
                n = await this.GenColumn.Update().Set(a => a.inFilter, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else if (field == "inCreate") {
                n = await this.GenColumn.Update().Set(a => a.inCreate, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else if (field == "inEdit") {
                n = await this.GenColumn.Update().Set(a => a.inEdit, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else if (field == "required") {
                n = await this.GenColumn.Update().Set(a => a.required, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            } else {
                n = await this.GenColumn.Update().Set(a => a.nullable, v)
                    .Where(a => a.id == id).ExecuteAffrowsAsync();
            }
            await this.Note("编辑字段", c.name, n > 0,
                field + "=" + Convert.ToString(v));
            this.Ok("{}");
            return;
        }
        this.Fail(400, "0004", "不支持行内修改的属性");
    }

    /* AI 字段设计：一句话业务 → 整表字段草稿。AI 只出草案，且过三道关才落设计：
       服务器按设计器契约重验每一列（不信任模型输出，与数据屏同一纪律），
       人在审核表里逐列勾选，应用时对浏览器回传的清单再验一遍。 */
    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("AI 字段设计表单")]
    async void AiForm() {
        int tableId = this.InInt("tableId", 0);
        GenTable t = await this.GenTable.ById(tableId);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        if (!await Ai.Ready()) {
            this.Fail(400, "0005", "尚未配置 AI 服务，先到「站点设置 → AI」启用");
        }
        ViewData d = new ViewData();
        d.Set("tableId", Convert.ToString(tableId));
        d.Set("tableTitle", t.title);
        d.Set("tableName", t.tableName);
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("AI 生成字段设计")]
    async void AiDesign() {
        int tableId = this.InInt("tableId", 0);
        string desc = this.Need("desc", "业务描述");
        GenTable t = await this.GenTable.ById(tableId);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        if (!await Ai.Ready()) { this.Fail(400, "0005", "尚未配置 AI 服务"); }
        if (desc.Length > 2000) { desc = desc.Substring(0, 2000); }

        List<GenColumn> cols = await this.GenColumn
            .Where(a => a.tableId == tableId).OrderBy(a => a.sortOrder)
            .ToListAsync();
        /* 字典类型与已设计表作为取值范围给模型：下拉建议落在真实存在的
           字典/表上，而不是编一个不存在的类型码。 */
        List<DictType> dicts = await this.DictType
            .Where(a => a.status == 1).ToListAsync();
        List<GenTable> tables = await this.GenTable.OrderBy(a => a.id)
            .ToListAsync();

        AiReply r = await Ai.CompleteRaw(Coder.DesignPrompt(),
            Coder.DesignAsk(t, desc, cols, dicts, tables));
        if (!r.ok) { this.Fail(400, "0005", r.text); }
        JsonValue root = Coder.DesignJson(r.text);
        if (root == null || !root.IsObject()) {
            this.Fail(400, "0005", "AI 返回的内容无法解析为字段设计，请重试或换个描述");
        }
        JsonValue colsArr = root.Get("columns");
        if (colsArr == null || !colsArr.IsArray()) {
            this.Fail(400, "0005", "AI 返回的内容无法解析为字段设计，请重试或换个描述");
        }
        ColumnDraft draft = Coder.Sanitize(colsArr, cols, tables);
        if (draft.cols.Count == 0) {
            this.Fail(400, "0005", "AI 给出的字段全部无效（重名或类型不合法），请换个描述再试");
        }

        JsonValue outArr = JsonValue.NewArray();
        for (int i = 0; i < draft.cols.Count; i = i + 1) {
            outArr.Append(Coder.ColumnJson(draft.cols[i]));
        }
        JsonValue outObj = JsonValue.NewObject();
        outObj.Put("columns", outArr);
        outObj.Put("dropped", MetricsCluster.Num(draft.dropped));
        this.Ok(outObj.ToJson());
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("应用 AI 字段设计")]
    async void AiApply() {
        int tableId = this.InInt("tableId", 0);
        string listJson = this.Need("columns", "字段清单");
        GenTable t = await this.GenTable.ById(tableId);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        List<GenColumn> cols = await this.GenColumn
            .Where(a => a.tableId == tableId).OrderBy(a => a.sortOrder)
            .ToListAsync();
        List<GenTable> tables = await this.GenTable.OrderBy(a => a.id)
            .ToListAsync();
        JsonValue arr = JsonValue.ParseLenient(listJson);
        if (arr == null || !arr.IsArray()) {
            this.Fail(400, "0004", "字段清单无法解析");
        }
        /* 浏览器回传的数据同样不被信任：与生成走同一个清洗器。 */
        ColumnDraft draft = Coder.Sanitize(arr, cols, tables);
        if (draft.cols.Count == 0) {
            this.Fail(400, "0004", "没有可应用的有效字段");
        }

        int sort = 10;
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].sortOrder >= sort) { sort = cols[i].sortOrder + 10; }
        }
        int added = 0;
        for (int i = 0; i < draft.cols.Count; i = i + 1) {
            GenColumn c = draft.cols[i];
            c.tableId = tableId;
            c.sortOrder = sort;
            sort = sort + 10;
            int _id = await this.GenColumn.Insert(c).ExecuteIdentityAsync();
            added = added + 1;
        }
        await this.Note("AI 生成字段", t.tableName, added > 0,
            Convert.ToString(added) + " 个字段"
            + (draft.dropped > 0 ? "，丢弃 " + Convert.ToString(draft.dropped) : ""));
        this.Saved("已应用 " + Convert.ToString(added)
            + " 个字段，记得「同步数据库」建列");
    }

    /* 字段设计任务的系统提示词：严格 JSON 契约 + 控件配型规则。 */
    static string DesignPrompt() {
        return "你是 ZanWeb 表设计器的字段设计助手。根据业务描述为一张表设计字段，"
            + "只输出一个 JSON 对象，不要解释、不要 Markdown 代码块，格式："
            + "{\"columns\":[{\"name\":\"field_name\",\"label\":\"中文名\","
            + "\"kind\":\"string\",\"size\":255,\"widget\":\"text\","
            + "\"required\":1,\"nullable\":0,\"inList\":1,\"inFilter\":0,"
            + "\"inCreate\":1,\"inEdit\":1,\"defValue\":\"\",\"sortOrder\":10,"
            + "\"dictType\":\"\",\"relTable\":\"\",\"relValue\":\"\",\"relLabel\":\"\"}]}。"
            + "规则：name 用小写下划线，不与已有字段重复；kind 只能是 string/text/"
            + "int/long/decimal/bool/datetime；widget 只能是 text/textarea/number/"
            + "select/switch/date/richtext/upload；bool 配 switch，text 配 textarea，"
            + "int/long/decimal 配 number，datetime 配 date；枚举字段配 select 并填"
            + " dictType（只能用给出的字典类型码），引用其他表配 select 并填 relTable"
            + "（只能用给出的表名）与 relValue=id、relLabel=name；label 用简短中文；"
            + "sortOrder 按 10 递增，重要字段在前；不加主键 id 与 created_at/"
            + "updated_at（系统自动处理）；字段数量适中（8~15 个）。";
    }

    /* 用户消息：表 + 已有字段（防重复）+ 字典/表取值范围 + 业务描述。 */
    static string DesignAsk(GenTable t, string desc, List<GenColumn> cols,
                            List<DictType> dicts, List<GenTable> tables) {
        StringBuilder sb = new StringBuilder();
        sb.Append("表：");
        sb.Append(t.tableName);
        sb.Append("（");
        sb.Append(t.title);
        sb.Append("）\n");
        if (cols.Count > 0) {
            sb.Append("已有字段（不要重复，可在其基础上扩展）：");
            for (int i = 0; i < cols.Count; i = i + 1) {
                if (i > 0) { sb.Append(", "); }
                sb.Append(cols[i].name);
                sb.Append("(");
                sb.Append(cols[i].kind);
                sb.Append(")");
            }
            sb.Append("\n");
        }
        if (dicts.Count > 0) {
            sb.Append("可用字典类型：");
            for (int i = 0; i < dicts.Count; i = i + 1) {
                if (i > 0) { sb.Append(", "); }
                sb.Append(dicts[i].code);
                sb.Append("(");
                sb.Append(dicts[i].name);
                sb.Append(")");
            }
            sb.Append("\n");
        }
        if (tables.Count > 0) {
            sb.Append("可关联表：");
            for (int i = 0; i < tables.Count; i = i + 1) {
                if (i > 0) { sb.Append(", "); }
                sb.Append(tables[i].tableName);
                sb.Append("(");
                sb.Append(tables[i].title);
                sb.Append(")");
            }
            sb.Append("\n");
        }
        sb.Append("业务描述：");
        sb.Append(desc);
        return sb.ToString();
    }

    /* 模型答语 → JSON 对象：剥掉可能的代码围栏与前后闲话，取首个 { 到末个 }。 */
    static JsonValue DesignJson(string raw) {
        int a = raw.IndexOf("{");
        int b = raw.LastIndexOf("}");
        if (a < 0 || b <= a) { return null; }
        return JsonValue.ParseLenient(raw.Substring(a, b - a + 1));
    }

    /* 清洗结果：有效列 + 被丢弃数。 */
    class ColumnDraft {
        List<GenColumn> cols;
        int dropped;
    }

    /* 把清单（模型或浏览器回传）重验成设计行：名字合法性、kind/widget 白名单、
       关联表必须真实存在、标志位归一、与已有字段及批内互不重名。无效项丢弃。 */
    static ColumnDraft Sanitize(JsonValue arr, List<GenColumn> existing,
                                List<GenTable> tables) {
        ColumnDraft outp = new ColumnDraft();
        outp.cols = new List<GenColumn>();
        outp.dropped = 0;
        List<string> taken = new List<string>();
        for (int i = 0; i < existing.Count; i = i + 1) {
            taken.Add(existing[i].name);
        }
        for (int i = 0; i < arr.Count(); i = i + 1) {
            JsonValue o = arr.At(i);
            if (o == null || !o.IsObject()) { outp.dropped = outp.dropped + 1; continue; }
            string name = o.Str("name", "").Trim();
            if (!Gen.Safe(name) || name == "id" || taken.Contains(name)) {
                outp.dropped = outp.dropped + 1;
                continue;
            }
            string kind = o.Str("kind", "").Trim();
            if (!Coder.InList(kind, "string,text,int,long,decimal,bool,datetime")) {
                kind = "string";
            }
            string widget = o.Str("widget", "").Trim();
            if (!Coder.InList(widget,
                    "text,textarea,number,select,switch,date,richtext,upload")) {
                widget = Coder.WidgetOf(kind);
            }
            GenColumn c = new GenColumn();
            c.name = name;
            c.label = Coder.Clip(o.Str("label", "").Trim(), 64);
            if (c.label.Length == 0) { c.label = name; }
            c.kind = kind;
            long size = o.Long("size", 255);
            if (size < 1 || size > 4000) { size = 255; }
            c.size = (int)size;
            c.defValue = Coder.Clip(o.Str("defValue", ""), 255);
            c.widget = widget;
            c.dictType = "";
            string dict = o.Str("dictType", "").Trim();
            if (dict.Length > 0 && Gen.Safe(dict)) { c.dictType = dict; }
            c.relTable = "";
            c.relValue = "";
            c.relLabel = "";
            string rel = o.Str("relTable", "").Trim();
            bool known = false;
            if (Gen.Safe(rel)) {
                for (int k = 0; k < tables.Count; k = k + 1) {
                    if (tables[k].tableName == rel) { known = true; break; }
                }
            }
            if (known) {
                c.relTable = rel;
                c.relValue = Coder.Clip(o.Str("relValue", "").Trim(), 64);
                if (!Gen.Safe(c.relValue)) { c.relValue = "id"; }
                c.relLabel = Coder.Clip(o.Str("relLabel", "").Trim(), 64);
                if (!Gen.Safe(c.relLabel)) { c.relLabel = "name"; }
            }
            long so = o.Long("sortOrder", 0 - 1);
            if (so < 0) { so = Filter.ToInt(o.Str("sortOrder", ""), 10); }
            c.sortOrder = (int)(so > 0 ? so : 10);
            c.nullable = Coder.FlagOf(o, "nullable", 0);
            c.inList = Coder.FlagOf(o, "inList", 1);
            c.inFilter = Coder.FlagOf(o, "inFilter", 0);
            c.inCreate = Coder.FlagOf(o, "inCreate", 1);
            c.inEdit = Coder.FlagOf(o, "inEdit", 1);
            c.required = Coder.FlagOf(o, "required", 0);
            taken.Add(name);
            outp.cols.Add(c);
        }
        return outp;
    }

    static JsonValue ColumnJson(GenColumn c) {
        JsonValue o = JsonValue.NewObject();
        o.Put("name", JsonValue.NewStr(c.name));
        o.Put("label", JsonValue.NewStr(c.label));
        o.Put("kind", JsonValue.NewStr(c.kind));
        o.Put("widget", JsonValue.NewStr(c.widget));
        o.Put("size", MetricsCluster.Num(c.size));
        o.Put("defValue", JsonValue.NewStr(c.defValue));
        o.Put("dictType", JsonValue.NewStr(c.dictType));
        o.Put("relTable", JsonValue.NewStr(c.relTable));
        o.Put("relValue", JsonValue.NewStr(c.relValue));
        o.Put("relLabel", JsonValue.NewStr(c.relLabel));
        o.Put("required", MetricsCluster.Num(c.required));
        o.Put("nullable", MetricsCluster.Num(c.nullable));
        o.Put("inList", MetricsCluster.Num(c.inList));
        o.Put("inFilter", MetricsCluster.Num(c.inFilter));
        o.Put("inCreate", MetricsCluster.Num(c.inCreate));
        o.Put("inEdit", MetricsCluster.Num(c.inEdit));
        o.Put("sortOrder", MetricsCluster.Num(c.sortOrder));
        return o;
    }

    /* s 在词表（逗号分隔）中吗。 */
    static bool InList(string s, string csv) {
        if (s.Length == 0) { return false; }
        return ("," + csv + ",").Contains("," + s + ",");
    }

    /* 类型缺省控件：与手填表单的直觉一致。 */
    static string WidgetOf(string kind) {
        if (kind == "bool") { return "switch"; }
        if (kind == "text") { return "textarea"; }
        if (kind == "int" || kind == "long" || kind == "decimal") { return "number"; }
        if (kind == "datetime") { return "date"; }
        return "text";
    }

    static string Clip(string s, int max) {
        if (s.Length <= max) { return s; }
        return s.Substring(0, max);
    }

    /* JSON 标志位：数字 0/1、文本 "1"/"true"/"false" 都认，认不出用默认。 */
    static int FlagOf(JsonValue o, string key, int def) {
        long n = o.Long(key, def);
        if (n == 1) { return 1; }
        if (n == 0) { return 0; }
        string s = o.Str(key, "").ToLower();
        if (s == "1" || s == "true") { return 1; }
        if (s == "0" || s == "false") { return 0; }
        return def;
    }

    /* 将设计应用到数据库：创建表，或补其缺失列。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("同步到数据库")]
    async void Migrate() {
        int id = this.InInt("id", 0);
        GenTable t = await this.GenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        List<GenColumn> cols = await this.GenColumn
            .Where(a => a.tableId == id).OrderBy(a => a.sortOrder).ToListAsync();
        if (cols.Count == 0) { this.Fail(400, "0004", "先添加字段"); }
        IDbConnection db = await this.Conn();
        if (db == null) { this.Fail(503, "2001", "数据库不可用"); }

        int changed = await Gen.Migrate(db, t, cols);
        int _u = await this.GenTable.Update()
            .Set(a => a.migrated, 1)
            .Set(a => a.updatedAt, WebApp.NowSeconds())
            .Where(a => a.id == id).ExecuteAffrowsAsync();
        await this.Note("同步表结构", t.tableName, true,
            Convert.ToString(changed) + " 列");
        this.Saved("已同步到数据库，可以在「数据管理」里维护数据了");
    }

    /* 写出生成源码；须重建后生效，消息直接说明而非暗示已在运行中变更。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("生成代码")]
    async void Build() {
        int id = this.InInt("id", 0);
        GenTable t = await this.GenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        List<GenColumn> cols = await this.GenColumn
            .Where(a => a.tableId == id).OrderBy(a => a.sortOrder).ToListAsync();
        if (cols.Count == 0) { this.Fail(400, "0004", "先添加字段"); }

        /* 服务器从 build/ 运行，待重建源码在其上一级；gen.root 说明不同部署布局下的路径。 */
        string root = await Settings.Get(SettingKeys.GenRoot, "..");
        /* gen.root 下层级全部不存在也要能建出来（CreateDirectory 只建一层）。 */
        Directory.CreateDirectoryRecursive(root + "/src/Model/Gen");
        Directory.CreateDirectoryRecursive(root + "/src/Controller/Admin");
        Directory.CreateDirectoryRecursive(root + "/src/Controller/Front");
        Directory.CreateDirectoryRecursive(root + "/src/Dao/Gen");
        Directory.CreateDirectoryRecursive(root + "/views/Admin");
        Directory.CreateDirectoryRecursive(root + "/views/Front");
        /* Directory=URL 前缀，file=class=route 段落=view 键，故生成表处处与手写表读法一致。 */
        string modelPath = root + "/src/Model/Gen/" + t.entityName + ".zan";
        string ctlPath = root + "/src/Controller/Admin/" + t.entityName + ".zan";
        string daoPath = root + "/src/Dao/Gen/" + t.entityName + "Dao.zan";
        string listPath = root + "/views/Admin/" + t.entityName + ".Index.html";
        string formPath = root + "/views/Admin/" + t.entityName + ".Form.html";
        string frontCtlPath = root + "/src/Controller/Front/" + t.entityName
            + "Front.zan";
        string frontListPath = root + "/views/Front/" + t.entityName
            + "Front.Index.html";
        string frontShowPath = root + "/views/Front/" + t.entityName
            + "Front.Show.html";
        File.WriteAllText(modelPath, Gen.ModelSource(t, cols));
        File.WriteAllText(ctlPath, Gen.ControllerSource(t, cols));
        File.WriteAllText(daoPath, Gen.DaoSource(t, cols));
        File.WriteAllText(listPath, Gen.ListViewSource(t, cols));
        File.WriteAllText(formPath, Gen.FormViewSource(t, cols));
        File.WriteAllText(frontCtlPath, Gen.FrontControllerSource(t, cols));
        File.WriteAllText(frontListPath, Gen.FrontListViewSource(t, cols));
        File.WriteAllText(frontShowPath, Gen.FrontShowViewSource(t, cols));

        int _u = await this.GenTable.Update()
            .Set(a => a.generatedAt, WebApp.NowSeconds())
            .Where(a => a.id == id).ExecuteAffrowsAsync();
        await this.Note("生成代码", t.tableName, true, ctlPath);
        this.Saved("已生成 8 个文件（模型/后台控制器/Dao/后台视图×2"
            + "/前台控制器/前台视图×2），重新编译后生效");
    }

    /* 写出前预览设计将产生的源码。 */
    [HttpGet]
    [Custom(Perm = PermBit.View)]
    [Description("预览生成代码")]
    async void Preview() {
        int id = this.InInt("id", 0);
        GenTable t = await this.GenTable.ById(id);
        if (t == null) { this.Fail(404, "0404", "设计不存在"); }
        List<GenColumn> cols = await this.GenColumn
            .Where(a => a.tableId == id).OrderBy(a => a.sortOrder).ToListAsync();
        ViewData d = new ViewData();
        d.Set("dialogTitle", t.tableName + " 生成预览");
        d.Set("model", Gen.ModelSource(t, cols));
        d.Set("controller", Gen.ControllerSource(t, cols));
        d.Set("dao", Gen.DaoSource(t, cols));
        d.Set("list", Gen.ListViewSource(t, cols));
        d.Set("form", Gen.FormViewSource(t, cols));
        d.Set("frontController", Gen.FrontControllerSource(t, cols));
        d.Set("frontList", Gen.FrontListViewSource(t, cols));
        d.Set("frontShow", Gen.FrontShowViewSource(t, cols));
        this.Dialog(d);
    }

    static int Flag(string v) {
        if (v == "1" || v == "on") { return 1; }
        return 0;
    }

    static string Checked(int v) {
        if (v == 1) { return "checked"; }
        return "";
    }

    static string Rel(GenColumn c) {
        if (c.relTable.Length == 0) { return ""; }
        return c.relTable + "." + c.relLabel;
    }

    /* "shop_order" → "ShopOrder"。 */
    static string Pascal(string snake) {
        string outName = "";
        bool up = true;
        for (int i = 0; i < snake.Length; i = i + 1) {
            string ch = snake.Substring(i, 1);
            if (ch == "_") { up = true; continue; }
            if (up) { outName = outName + ch.ToUpper(); up = false; }
            else { outName = outName + ch; }
        }
        return outName;
    }
}
