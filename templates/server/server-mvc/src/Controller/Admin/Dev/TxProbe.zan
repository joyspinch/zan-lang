using System;
using System.Data;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Sys;

namespace ZanWeb.Admin.Dev;

/* 现代动作形态的可运行示例 /admin/dev/txprobe：Sum 展示签名参数绑定（参数在方法签名上，蹦床读并转换，缺失/畸形值以统一 400/0003 作答，与 /api/docs 同名无需同步）；Disable 展示 [Tx] 事务作用域（蹦床开事务、成功后提交、任何失败路径含 Fail() 的 ApiError 先回滚再答；保护在第一笔落库后触发，超级管理员尝试不会留下半应用的状态变更，动作体内无 Begin/Commit/Rollback）。 */
[Route("admin/dev/txprobe/[action]")]
class TxProbe : AdminController {
    [HttpGet]
    [Description("类型化参数绑定示例：两数之和")]
    void Sum(int a, int b) {
        this.Ok("{\"sum\":" + Convert.ToString(a + b) + "}");
    }

    [Tx]
    [HttpPost]
    [Description("事务作用域示例：禁用账号，任一步失败整体回滚")]
    async void Disable(int id) {
        User u = await this.User.ById(id);
        if (u == null) { this.Fail(404, "0404", "账号不存在"); }
        int _first = await this.User.SetStatus(id, 0);
        /* 第一笔已在事务内落库。此刻才查出的违规若直接中止，[Tx] 会连同上面的状态改写一起回滚。 */
        User fresh = await this.User.ById(id);
        if (fresh.isSuper == 1) { this.Fail(400, "0004", "超级管理员不能禁用"); }
        int _second = await this.User.BumpTokenVersion(id);
        this.Ok("null");
    }
}
