using System;
using System.Data;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Sys;
using ZanWeb.Dao.Sys;

namespace ZanWeb.Admin;

/// <summary>
/// Account administration at /admin/users. The list is built from
/// UserDao.AllBrief() — the projection with no password hash and no salt in it —
/// so a template accident cannot leak credential material into HTML.
///
/// Both writes are POST + redirect: a reload re-runs a GET, never the write, and
/// the outcome travels as a short code in the query string that Flash() turns
/// back into a message (see AdminController).
///
/// Disabling an account and forcing a logout are deliberately different buttons:
/// status = 0 stops future logins, while BumpTokenVersion invalidates the tokens
/// already in browsers. An account you disable but never bump keeps its live
/// sessions until they expire.
/// </summary>
[Route("admin/[controller]/[action]")]
[Description("账号管理")]
class Users : AdminController {
    [HttpGet]
    [Route("/admin/users")]
    [Description("账号列表")]
    async void Index() {
        ViewData d = await this.Layout("users", "账号管理");
        if (d == null) { return; }
        this.Flash(d, "操作已生效。", "操作未生效：账号不存在或数据库不可用。");

        IDbConnection db = await this.Conn();
        if (db == null) {
            d.Set("dbDown", "1");
            d.Set("count", "0");
            this.View(d);
            return;
        }

        List<UserBrief> rows = await new UserDao(db).AllBrief();
        List<StrMap> items = d.AddList("users");
        for (int i = 0; i < rows.Count; i = i + 1) {
            UserBrief u = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(u.id));
            row.Set("username", u.username);
            row.Set("nickname", Users.Dash(u.nickname));
            row.Set("dept", Users.Dash(Convert.ToString(u.departmentId)));
            row.Set("statusText", Users.StatusText(u.status));
            row.Set("statusClass", Users.StatusClass(u.status));
            row.Set("super", Users.Flag(u.isSuper == 1));
            row.Set("normal", Users.Flag(u.isSuper != 1));
            row.Set("nextStatus", Users.NextStatus(u.status));
            row.Set("toggleText", Users.ToggleText(u.status));
            items.Add(row);
        }
        d.Set("count", Convert.ToString(rows.Count));
        if (rows.Count == 0) { d.Set("empty", "1"); }
        this.View(d);
    }

    [HttpPost]
    [Route("/admin/users/status")]
    [Description("启用/禁用账号")]
    async void Status() {
        if (await this.Admin() == null) {
            this.Ctx().Status(403, "Forbidden").Text("forbidden");
            return;
        }
        int id = this.InInt("id", 0);
        int status = this.InInt("status", 1);
        if (status != 1) { status = 0; }
        IDbConnection db = await this.Conn();
        if (db == null || id <= 0) {
            this.Ctx().Redirect("/admin/users?bad=1");
            return;
        }
        int changed = await new UserDao(db).SetStatus(id, status);
        // A disabled account must also lose the sessions it already has,
        // otherwise the ban only applies to the next login.
        if (changed > 0 && status == 0) {
            int _n = await new UserDao(db).BumpTokenVersion(id);
        }
        this.Ctx().Redirect(Users.Back(changed));
    }

    [HttpPost]
    [Route("/admin/users/logout")]
    [Description("强制下线")]
    async void Logout() {
        if (await this.Admin() == null) {
            this.Ctx().Status(403, "Forbidden").Text("forbidden");
            return;
        }
        int id = this.InInt("id", 0);
        IDbConnection db = await this.Conn();
        if (db == null || id <= 0) {
            this.Ctx().Redirect("/admin/users?bad=1");
            return;
        }
        int changed = await new UserDao(db).BumpTokenVersion(id);
        this.Ctx().Redirect(Users.Back(changed));
    }

    static string Back(int changed) {
        if (changed > 0) { return "/admin/users?ok=1"; }
        return "/admin/users?bad=1";
    }

    static string Flag(bool on) {
        if (on) { return "1"; }
        return "";
    }

    // An empty cell reads as a rendering fault; an em dash reads as "not set".
    static string Dash(string v) {
        if (v.Length == 0 || v == "0") { return "—"; }
        return v;
    }

    static string StatusText(int status) {
        if (status == 1) { return "启用"; }
        return "禁用";
    }

    static string StatusClass(int status) {
        if (status == 1) { return "ok"; }
        return "off";
    }

    static string NextStatus(int status) {
        if (status == 1) { return "0"; }
        return "1";
    }

    static string ToggleText(int status) {
        if (status == 1) { return "禁用"; }
        return "启用";
    }
}
