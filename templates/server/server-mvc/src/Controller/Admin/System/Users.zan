using System;
using System.Data;
using System.Data.Orm;
using System.Security.Cryptography;
using System.Web;
using System.Json;
using ZanWeb;
using ZanWeb.Model.Sys;
using ZanWeb.Dao.Sys;

namespace ZanWeb.Admin.System;

/* /admin/system/users 账号管理：搜索、建、编、删、改密、分角色、启禁、强制下线；列表为投影，永非实体——不把密码散列与盐放进行，避免模板失手泄露凭证材料；禁用与强制下线有意分为两键——status=0 阻断后续登录、改 tokenVersion 使已持令牌失效，禁用两者都做，因放行已开会话的禁令不算禁令。 */
[Route("admin/system/users/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("账号管理")]
class Users : AdminController {
    [HttpGet]
    [Route("/admin/system/users")]
    [Custom(IsMenu = true, Icon = "mdi:account", Perm = PermBit.View)]
    [Description("账号管理")]
    async void Index() {
        ViewData d = await this.Layout("账号管理");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }

        /* 声明本屏搜索与工具栏：渲染、收集、分页链接三处同源（ListPage），
           改一处声明，界面与 SQL 同时生效。 */
        ListPage lp = ListPage.Of()
            .Text("账号 / 姓名 / 邮箱", "kw", "t.username|t.nickname|t.email", "搜索账号 / 姓名 / 邮箱")
            .Select("状态", "status", "t.status", "1=启用,0=禁用")
            .Time("创建日期", "createdAt", "t.createdAt")
            .TbarAdd("新增账号", "/admin/system/users/form")
            .TbarReload()
            .TbarSep()
            .TbarEnable("/admin/system/users/batchstatus")
            .TbarDisable("/admin/system/users/batchstatus")
            .TbarDelete("/admin/system/users/batchdelete");
        List<ListCond> conds = lp.Collect(this);
        lp.Search(this, d, "/admin/system/users");
        lp.Toolbar(d);

        ListQuery q = this.Paged("id", 20);

        /* 该账号角色允许可见的行，与声明条件同链。 */
        DataScope sc = await this.Scope();
        List<int> scoped = sc.Depts();
        int mine = sc.UserId();

        int total = await new UserDao(this).CountBy(
            conds, sc.ByDept(), scoped, sc.Mine(), mine);
        List<User> rows = await new UserDao(this).PagedListBy(
            conds, sc.ByDept(), scoped, sc.Mine(), mine, q.Skip(), q.Limit());

        List<Department> depts = await new DepartmentDao(this).All();
        List<Role> roles = await new RoleDao(this).All();
        List<UserRole> links = await new UserRoleDao(this).All();

        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            User u = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(u.id));
            row.Set("username", u.username);
            row.Set("nickname", Fmt.Dash(u.nickname));
            row.Set("email", Fmt.Dash(Fmt.MaskEmail(u.email)));
            row.Set("mobile", Fmt.Dash(Fmt.MaskMobile(u.mobile)));
            row.Set("dept", Users.DeptName(depts, u.departmentId));
            row.Set("roles", Users.RoleNames(roles, links, u.id));
            row.Set("statusText", Users.StatusText(u.status));
            row.Set("statusClass", Users.StatusClass(u.status));
            row.Set("nextStatus", Users.NextStatus(u.status));
            row.Set("toggleText", Users.ToggleText(u.status));
            row.Set("createdAt", Fmt.Day(u.createdAt));
            if (u.isSuper == 1) { row.Set("super", "1"); }
            items.Add(row);
        }
        this.Pager(d, q, total);
        /* 分页链接保留全部筛选——旧版只带 kw，一翻页搜索条件全丢。 */
        if (q.Page() > 1) { d.Set("prevUrl", lp.Query(conds, q.Page() - 1, q.Limit())); }
        if (q.Page() < q.Pages(total)) { d.Set("nextUrl", lp.Query(conds, q.Page() + 1, q.Limit())); }
        this.Page(d);
    }

    /* 新建/编辑对话框；片段非页，列表不动、对话框覆盖其上。 */
    /* 一份声明：Form 渲染与 Save 校验同源（新增/编辑屏 = 声明 + 两动作）。
       部门选项由调用方查询传入（Save 校验用不到，传空列表即可）。 */
    static FormPage UserForm(List<StrMap> deptRows) {
        return FormPage.Of("/admin/system/users/save")
            .Text("账号", "username").Req().Max(32).Ph("登录名")
            .Text("姓名", "nickname").Max(32)
            .Text("邮箱", "email").Max(64)
            .Text("手机", "mobile").Max(20)
            .SelectList("部门", "departmentId", deptRows).Blank("未分配")
            .Select("状态", "status", "1=启用,0=禁用").Val("1")
            .Pass("初始密码", "password").Min(8).Req().Ph("至少 8 位").OnlyNew()
            .Hint("修改密码请在列表中使用「重置密码」。").OnlyEdit();
    }

    [HttpGet]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("账号表单")]
    async void Form() {
        int id = this.InInt("id", 0);
        /* 仅该账号可写部门入选，使对话框无法提议 Save 随后拒绝的迁移；仅本人 scope 一处都不可写。 */
        DataScope sc = await this.Scope();
        List<Department> depts = await new DepartmentDao(this).Scoped(
            sc.ByDept(), sc.Depts(), sc.Mine());
        List<StrMap> deptRows = new List<StrMap>();
        for (int i = 0; i < depts.Count; i = i + 1) {
            StrMap o = new StrMap();
            o.Set("id", Convert.ToString(depts[i].id));
            o.Set("name", depts[i].name);
            deptRows.Add(o);
        }
        FormPage fp = Users.UserForm(deptRows);
        ViewData d = new ViewData();
        d.Set("dialogTitle", id > 0 ? "编辑账号" : "新增账号");
        if (id > 0) {
            User u = await this.Reach(id);
            fp.Id(Convert.ToString(id));
            fp.Field("username").Val(u.username);
            fp.Field("nickname").Val(u.nickname);
            fp.Field("email").Val(u.email);
            fp.Field("mobile").Val(u.mobile);
            fp.Field("departmentId").Val(Convert.ToString(u.departmentId));
            fp.Field("status").Val(u.status == 1 ? "1" : "0");
        }
        fp.Render(d);
        this.FormDialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Create | PermBit.Update)]
    [Description("保存账号")]
    async void Save() {
        int id = this.InInt("id", 0);
        /* 声明即校验：与 Form 渲染同一份约束（required/min/max），
           初始密码规则（新增才必填、至少 8 位）也出自声明。 */
        FormPage fp = Users.UserForm(new List<StrMap>());
        fp.Id(Convert.ToString(id));
        string invalid = fp.Validate(this);
        if (invalid.Length > 0) { this.Fail(400, "0004", invalid); }
        string username = this.Need("username", "账号");
        string nickname = this.In("nickname");
        string email = this.In("email");
        string mobile = this.In("mobile");
        int departmentId = this.InInt("departmentId", 0);
        int status = this.InInt("status", 1);
        string password = this.In("password");
        if (status != 1) { status = 0; }

        User clash = await new UserDao(this).ByUsername(username);
        if (clash != null && clash.id != id) {
            this.Fail(400, "0004", "账号 " + username + " 已存在");
        }
        /* 两端皆校验：被编账号在 scope 内、归档到的部门也在——否则仅看一部门的操作员可将账号移出自己范围。 */
        if (id > 0) { User _t = await this.Reach(id); }
        await this.Reachable(departmentId);

        if (id > 0) {
            UserDao userDao = new UserDao(this);
            int n = await userDao.UpdateProfile(id, username, nickname, email, mobile, departmentId, status, WebApp.NowSeconds());
            /* 禁用账号须使其已持会话失效，否则禁令只对下次登录生效。 */
            if (status == 0) { await this.Revoke(id); }
            AuthUser.Forget(Convert.ToString(id));
            await this.Note("编辑账号", "#" + Convert.ToString(id)
                + " " + username, n > 0, "");
            this.Saved("账号已保存");
            return;
        }

        string salt = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        User u = new User();
        u.username = username;
        u.nickname = nickname;
        u.email = email;
        u.mobile = mobile;
        u.departmentId = departmentId;
        u.passwordSalt = salt;
        u.passwordHash = AuthUser.PasswordHash(password, salt);
        u.status = status;
        u.isSuper = 0;
        u.tokenVersion = 1;
        u.createdAt = WebApp.NowSeconds();
        u.updatedAt = u.createdAt;
        UserDao userDao = new UserDao(this);
        int newId = await userDao.Insert(u);
        await this.Note("新增账号",
            "#" + Convert.ToString(newId) + " " + username, newId > 0, "");
        this.Saved("账号已创建");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("删除账号")]
    async void Delete() {
        int id = this.InInt("id", 0);
        User u = await this.Reach(id);
        if (u.isSuper == 1) {
            this.Fail(400, "0004", "超级管理员账号不能删除");
        }
        User me = await this.Admin();
        if (me != null && me.id == id) {
            this.Fail(400, "0004", "不能删除当前登录的账号");
        }
        UserDao userDao = new UserDao(this);
        int n = await userDao.Delete(id);
        int _r = await new UserRoleDao(this).DeleteByUserId(id);
        AuthUser.Forget(Convert.ToString(id));
        await this.Note("删除账号",
            "#" + Convert.ToString(id) + " " + u.username, n > 0, "");
        this.Saved("账号已删除");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("启用或禁用账号")]
    async void Status() {
        int id = this.InInt("id", 0);
        int status = this.InInt("status", 1);
        if (status != 1) { status = 0; }
        User u = await this.Reach(id);
        if (u.isSuper == 1 && status == 0) {
            this.Fail(400, "0004", "超级管理员账号不能禁用");
        }
        UserDao userDao = new UserDao(this);
        int n = await userDao.SetStatus(id, status);
        if (status == 0) { await this.Revoke(id); }
        AuthUser.Forget(Convert.ToString(id));
        await this.Note("启用或禁用账号",
            "#" + Convert.ToString(id) + " " + u.username, n > 0,
            Users.StatusText(status));
        if (status == 1) { this.Saved("账号已启用"); return; }
        this.Saved("账号已禁用，其登录状态同时失效");
    }

    /* 批量启禁：工具栏对勾选行一次提交（ids=1,2,3）。越权行零容忍——
       名单里有超管或（禁用时的）本人即整体拒绝，不做"能做多少做多少"
       的部分成功，避免操作者误以为全部生效。 */
    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("批量启禁账号")]
    async void BatchStatus() {
        List<int> ids = this.Ids("ids");
        if (ids.Count == 0) { this.Fail(400, "0004", "未选择账号"); return; }
        int status = this.InInt("value", 1);
        if (status != 1) { status = 0; }
        List<User> rows = await new UserDao(this).ByIds(ids);
        if (rows.Count == 0) { this.Fail(400, "0004", "所选账号不存在"); return; }
        User me = await this.Admin();
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].isSuper == 1) {
                this.Fail(400, "0004", "所选账号包含超级管理员，不能批量操作");
                return;
            }
            if (status == 0 && me != null && rows[i].id == me.id) {
                this.Fail(400, "0004", "所选账号包含当前登录账号，不能批量禁用");
                return;
            }
        }
        int n = await new UserDao(this).SetStatusByIds(ids, status);
        if (status == 0) {
            for (int i = 0; i < rows.Count; i = i + 1) {
                await this.Revoke(rows[i].id);
                AuthUser.Forget(Convert.ToString(rows[i].id));
            }
        }
        await this.Note("批量启禁账号",
            Convert.ToString(rows.Count) + " 个账号", n > 0,
            status == 1 ? "启用" : "禁用");
        this.Saved("已" + (status == 1 ? "启用" : "禁用") + " " + Convert.ToString(n) + " 个账号");
    }

    /* 批量删除：同零容忍口径。连带清角色关联并失效其会话。 */
    [HttpPost]
    [Custom(Perm = PermBit.Delete)]
    [Description("批量删除账号")]
    async void BatchDelete() {
        List<int> ids = this.Ids("ids");
        if (ids.Count == 0) { this.Fail(400, "0004", "未选择账号"); return; }
        List<User> rows = await new UserDao(this).ByIds(ids);
        if (rows.Count == 0) { this.Fail(400, "0004", "所选账号不存在"); return; }
        User me = await this.Admin();
        for (int i = 0; i < rows.Count; i = i + 1) {
            if (rows[i].isSuper == 1) {
                this.Fail(400, "0004", "所选账号包含超级管理员，不能批量删除");
                return;
            }
            if (me != null && rows[i].id == me.id) {
                this.Fail(400, "0004", "所选账号包含当前登录账号，不能批量删除");
                return;
            }
        }
        int n = await new UserDao(this).DeleteByIds(ids);
        for (int i = 0; i < rows.Count; i = i + 1) {
            int _r = await new UserRoleDao(this).DeleteByUserId(rows[i].id);
            AuthUser.Forget(Convert.ToString(rows[i].id));
        }
        await this.Note("批量删除账号",
            Convert.ToString(rows.Count) + " 个账号", n > 0, "");
        this.Saved("已删除 " + Convert.ToString(n) + " 个账号");
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("强制下线")]
    async void Kick() {
        int id = this.InInt("id", 0);
        User u = await this.Reach(id);
        await this.Revoke(id);
        await this.Note("强制下线",
            "#" + Convert.ToString(id) + " " + u.username, true, "");
        this.Saved("该账号的登录状态已全部失效");
    }

    /* 重置密码对话框；绝不显示当前密码——无可读内容。 */
    [HttpGet]
    [Custom(Perm = PermBit.Update)]
    [Description("重置密码表单")]
    async void PasswordForm() {
        int id = this.InInt("id", 0);
        User u = await this.Reach(id);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("username", u.username);
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("重置密码")]
    async void Password() {
        int id = this.InInt("id", 0);
        string password = this.Need("password", "新密码");
        if (password.Length < 8) {
            this.Fail(400, "0004", "密码至少 8 位");
        }
        User u = await this.Reach(id);
        string salt = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
        string hash = AuthUser.PasswordHash(password, salt);
        UserDao userDao = new UserDao(this);
        int n = await userDao.ResetPassword(id, salt, hash, u.tokenVersion + 1, WebApp.NowSeconds());
        await this.Note("重置密码",
            "#" + Convert.ToString(id) + " " + u.username, n > 0, "");
        this.Saved("密码已重置，该账号需要重新登录");
    }

    /* 分配角色对话框：所有角色、已持者打勾。 */
    [HttpGet]
    [Custom(Perm = PermBit.Update)]
    [Description("分配角色")]
    async void Roles() {
        int id = this.InInt("id", 0);
        User u = await this.Reach(id);
        ViewData d = new ViewData();
        d.Set("id", Convert.ToString(id));
        d.Set("username", u.username);
        List<Role> roles = await new RoleDao(this).All();
        List<UserRole> mine = await new UserRoleDao(this).ByUserId(id);
        List<StrMap> rows = d.AddList("roles");
        for (int i = 0; i < roles.Count; i = i + 1) {
            Role r = roles[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(r.id));
            row.Set("name", r.name);
            row.Set("code", r.code);
            row.Set("description", r.description);
            for (int j = 0; j < mine.Count; j = j + 1) {
                if (mine[j].roleId == r.id) { row.Set("checked", "checked"); }
            }
            rows.Add(row);
        }
        this.Dialog(d);
    }

    [HttpPost]
    [Custom(Perm = PermBit.Update)]
    [Description("保存角色分配")]
    async void RolesSave() {
        int id = this.InInt("id", 0);
        User u = await this.Reach(id);
        string picked = this.In("roleIds");
        UserRoleDao urDao = new UserRoleDao(this);
        int _cleared = await urDao.DeleteByUserId(id);
        List<Role> roles = await new RoleDao(this).All();
        int granted = 0;
        for (int i = 0; i < roles.Count; i = i + 1) {
            if (!AuthUser.Holds(picked, Convert.ToString(roles[i].id))) { continue; }
            UserRole link = new UserRole();
            link.userId = id;
            link.roleId = roles[i].id;
            int _n = await urDao.Insert(link);
            granted = granted + 1;
        }
        AuthUser.Forget(Convert.ToString(id));
        await this.Note("分配角色",
            "#" + Convert.ToString(id) + " " + u.username, true,
            Convert.ToString(granted) + " 个角色");
        this.Saved("角色已保存");
    }

    /* 请求有权操作的账号；超调用方数据 scope 的答与不存在的行同 404——无法列表的账号不得在对话框或 POST 中确认其存在。 */
    async User Reach(int id) {
        User u = await new UserDao(this).ById(id);
        if (u == null) { this.Fail(404, "0404", "账号不存在"); }
        DataScope sc = await this.Scope();
        if (!sc.Covers(u.id, u.departmentId)) {
            this.Fail(404, "0404", "账号不存在");
        }
        return u;
    }

    /* 拒绝不可写入的部门，使账号无法被建入或移至操作员不可见的部门。 */
    async void Reachable(int departmentId) {
        DataScope sc = await this.Scope();
        if (sc.Covers(0, departmentId)) { return; }
        this.Fail(403, "0403", "数据权限不允许操作该部门的账号");
    }

    /* 使该账号已发的所有令牌失效。 */
    async void Revoke(int id) {
        int _n = await new UserDao(this).BumpTokenVersion(id);
    }

    static string DeptName(List<Department> depts, int id) {
        for (int i = 0; i < depts.Count; i = i + 1) {
            if (depts[i].id == id) { return depts[i].name; }
        }
        return "—";
    }

    static string RoleNames(List<Role> roles, List<UserRole> links, int userId) {
        string names = "";
        for (int i = 0; i < links.Count; i = i + 1) {
            if (links[i].userId != userId) { continue; }
            for (int j = 0; j < roles.Count; j = j + 1) {
                if (roles[j].id != links[i].roleId) { continue; }
                if (names.Length > 0) { names = names + "、"; }
                names = names + roles[j].name;
            }
        }
        if (names.Length == 0) { return "—"; }
        return names;
    }

    static string StatusText(int status) {
        if (status == 1) { return "启用"; }
        return "禁用";
    }

    static string StatusClass(int status) {
        if (status == 1) { return "ok"; }
        return "off";
    }

    static string NextStatus(int status) {
        if (status == 1) { return "0"; }
        return "1";
    }

    static string ToggleText(int status) {
        if (status == 1) { return "禁用"; }
        return "启用";
    }
}
