using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Sys;

namespace ZanWeb.Admin.System;

/// <summary>
/// The audit trail: what was changed (sys_operation_log) and who signed in
/// (sys_login_log). Both are written by the code that performs the action, not
/// by a filter over every request, so a log line always means something
/// happened rather than "a URL was visited".
/// </summary>
[Route("admin/system/logs/[action]")]
[Custom(Authorization = CustomAuthorization.Grant)]
[Description("系统日志")]
class Logs : AdminController {
    [HttpGet]
    [Route("/admin/system/logs")]
    [Custom(IsMenu = true, Icon = "mdi:history")]
    [Description("操作日志")]
    async void Index() {
        ViewData d = await this.Layout("操作日志");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }

        ListQuery q = this.Paged("id", 30);
        string kw = q.Kw();
        int total = await this.OperationLog
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw)).CountAsync();
        List<OperationLog> rows = await this.OperationLog
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            OperationLog row = rows[i];
            StrMap r = new StrMap();
            r.Set("id", Convert.ToString(row.id));
            r.Set("username", Fmt.Dash(row.username));
            r.Set("title", row.title);
            r.Set("action", Fmt.Dash(row.action));
            r.Set("target", Fmt.Dash(row.target));
            r.Set("method", row.method);
            r.Set("path", row.path);
            r.Set("ip", Fmt.Dash(row.ip));
            r.Set("message", Fmt.Dash(row.message));
            r.Set("okText", Logs.OkText(row.ok));
            r.Set("okClass", Logs.OkClass(row.ok));
            r.Set("createdAt", Fmt.Stamp(row.createdAt));
            items.Add(r);
        }
        this.Pager(d, q, total);
        this.Page(d);
    }

    [HttpGet]
    [Route("/admin/system/logs/login")]
    [Custom(IsMenu = true, Icon = "mdi:login")]
    [Description("登录日志")]
    async void Login() {
        ViewData d = await this.Layout("登录日志");
        if (!this.DbReady()) { d.Set("dbDown", "1"); this.Page(d); return; }

        ListQuery q = this.Paged("id", 30);
        string kw = q.Kw();
        int total = await this.LoginLog
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw)).CountAsync();
        List<LoginLog> rows = await this.LoginLog
            .WhereIf(kw.Length > 0, a => a.username.Contains(kw))
            .OrderByDescending(a => a.id)
            .Skip(q.Skip()).Take(q.Limit()).ToListAsync();
        List<StrMap> items = d.AddList("rows");
        for (int i = 0; i < rows.Count; i = i + 1) {
            LoginLog row = rows[i];
            StrMap r = new StrMap();
            r.Set("id", Convert.ToString(row.id));
            r.Set("username", Fmt.Dash(row.username));
            r.Set("ip", Fmt.Dash(row.ip));
            r.Set("agent", Fmt.Dash(row.agent));
            r.Set("message", Fmt.Dash(row.message));
            r.Set("okText", Logs.LoginText(row.ok));
            r.Set("okClass", Logs.OkClass(row.ok));
            r.Set("createdAt", Fmt.Stamp(row.createdAt));
            items.Add(r);
        }
        this.Pager(d, q, total);
        this.Page(d);
    }

    [HttpPost]
    [Description("清空日志")]
    async void Clear() {
        string kind = this.In("kind");
        if (kind == "login") {
            int n = await this.LoginLog.Delete().Where(a => a.id > 0)
                .ExecuteAffrowsAsync();
            await this.Note("清空登录日志", "", true,
                Convert.ToString(n) + " 条");
            this.Saved("登录日志已清空");
            return;
        }
        int n = await this.OperationLog.Delete().Where(a => a.id > 0)
            .ExecuteAffrowsAsync();
        await this.Note("清空操作日志", "", true,
            Convert.ToString(n) + " 条");
        this.Saved("操作日志已清空");
    }

    static string OkText(int ok) {
        if (ok == 1) { return "成功"; }
        return "失败";
    }

    static string LoginText(int ok) {
        if (ok == 1) { return "登录成功"; }
        return "登录失败";
    }

    static string OkClass(int ok) {
        if (ok == 1) { return "ok"; }
        return "bad";
    }
}
