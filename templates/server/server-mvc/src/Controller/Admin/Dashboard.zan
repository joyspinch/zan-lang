using System;
using System.Data;
using System.Json;
using System.Web;
using ZanWeb;

namespace ZanWeb.Admin;

/// <summary>
/// The dashboard at /admin: what the system holds and how it is behaving right
/// now. The live numbers come from the same snapshot the monitor streams, so
/// the two screens cannot disagree, and they arrive over the metrics event
/// stream instead of a timed reload.
/// </summary>
[Route("admin/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.Login)]
[Description("仪表盘")]
class Dashboard : AdminController {
    /// The sidebar entry is this attribute -- see AdminController.Layout, which
    /// asks MenuBuilder for the entries this account may reach. Nothing lists the
    /// navigation a second time.
    [HttpGet]
    [Route("/admin")]
    [Custom(IsMenu = true, Icon = "mdi:gauge")]
    [Description("仪表盘")]
    async void Index() {
        ViewData d = await this.Layout("仪表盘");

        JsonValue m = JsonValue.ParseLenient(WebHost.Current().MetricsJson());
        JsonValue req = m.Get("requests");
        if (req == null) { req = JsonValue.NewObject(); }

        d.Set("requests", Convert.ToString(req.Long("count", 0)));
        d.Set("errors", Convert.ToString(req.Long("errors", 0)));
        d.Set("avgMs", Convert.ToString(req.Long("avg_ms", 0)));
        d.Set("uptime", Fmt.Uptime(m.Long("uptime_ms", 0)));

        d.Set("users", "—");
        d.Set("posts", "—");
        d.Set("published", "—");
        d.Set("drafts", "—");
        d.Set("comments", "—");
        d.Set("pending", "—");
        if (this.DbReady()) {
            int users = await this.User.CountAsync();
            int posts = await this.Post.CountAsync();
            int published = await this.Post.Where(a => a.published == 1).CountAsync();
            int comments = await this.Comment.CountAsync();
            int pending = await this.Comment.Where(a => a.status == 0).CountAsync();
            d.Set("users", Convert.ToString(users));
            d.Set("posts", Convert.ToString(posts));
            d.Set("published", Convert.ToString(published));
            d.Set("drafts", Convert.ToString(posts - published));
            d.Set("comments", Convert.ToString(comments));
            d.Set("pending", Convert.ToString(pending));

            List<ZanWeb.Model.Blog.Post> recent = await this.Post
                .OrderByDescending(a => a.id).Take(8).ToListAsync();
            List<StrMap> rows = d.AddList("recent");
            for (int i = 0; i < recent.Count; i = i + 1) {
                ZanWeb.Model.Blog.Post p = recent[i];
                StrMap row = new StrMap();
                row.Set("id", Convert.ToString(p.id));
                row.Set("title", p.title);
                row.Set("author", Fmt.Dash(p.author));
                row.Set("createdAt", Fmt.Day(p.createdAt));
                row.Set("stateText", Dashboard.StateText(p.published));
                row.Set("stateClass", Dashboard.StateClass(p.published));
                rows.Add(row);
            }
            if (recent.Count == 0) { d.Set("noRecent", "1"); }

            List<ZanWeb.Model.Sys.LoginLog> logins = await this.LoginLog
                .OrderByDescending(a => a.id).Take(8).ToListAsync();
            List<StrMap> lrows = d.AddList("logins");
            for (int i = 0; i < logins.Count; i = i + 1) {
                ZanWeb.Model.Sys.LoginLog l = logins[i];
                StrMap row = new StrMap();
                row.Set("username", Fmt.Dash(l.username));
                row.Set("ip", Fmt.Dash(l.ip));
                row.Set("createdAt", Fmt.Stamp(l.createdAt));
                row.Set("okText", Dashboard.OkText(l.ok));
                row.Set("okClass", Dashboard.OkClass(l.ok));
                lrows.Add(row);
            }
            if (logins.Count == 0) { d.Set("noLogins", "1"); }
        } else {
            d.Set("dbDown", "1");
        }
        this.Page(d);
    }

    static string StateText(int published) {
        if (published == 1) { return "已发布"; }
        return "草稿";
    }

    static string StateClass(int published) {
        if (published == 1) { return "ok"; }
        return "off";
    }

    static string OkText(int ok) {
        if (ok == 1) { return "成功"; }
        return "失败";
    }

    static string OkClass(int ok) {
        if (ok == 1) { return "ok"; }
        return "bad";
    }
}
