using System;
using System.Data;
using ZanWeb;
using System.Web;
using System.Json;
using ZanWeb.Model.Sys;
using ZanWeb.Dao.Sys;

namespace ZanWeb.User;

/// <summary>ORM + cache demo: list users (cached) and show one by route
/// parameter. Routes: /users and /user/{id}.</summary>
[Route("[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.Login)]
[Description("用户")]
class Users : AppController {
    [HttpGet]
    [Route("/users")]
    [Description("用户列表")]
    async void Index() {
        CacheContext cache = this.Cache();
        string cached = await cache.GetAsync("users:all");
        if (cached.Length > 0) {
            JsonValue o = JsonValue.NewObject();
            o.Put("code", JsonValue.NewStr("0000"));
            o.Put("msg", JsonValue.NewStr("ok (cache)"));
            JsonValue d = JsonValue.ParseLenient(cached);
            if (d != null) { o.Put("data", d); }
            this.Json(o.ToJson());
            return;
        }
        IDbConnection db = await this.Conn();
        if (db == null) {
            this.Fail(503, "2001",
                "database not configured -- set [database] in config/app.json");
            return;
        }
        // Projected, not the entity: User carries passwordHash/passwordSalt.
        List<UserBrief> rows = new UserDao(db).AllBrief();
        string data = Json.Serialize<List<UserBrief>>(rows);
        await cache.SetTtlAsync("users:all", data, 5);
        this.Ok(data);
    }

    [HttpGet]
    [Route("/user/{id}")]
    [Description("用户详情")]
    void Show() {
        string id = this.Param("id");
        JsonValue o = JsonValue.NewObject();
        o.Put("id", JsonValue.NewStr(id));
        o.Put("name", JsonValue.NewStr("user-" + id));
        this.Ok(o.ToJson());
    }
}
