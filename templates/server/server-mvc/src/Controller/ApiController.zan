using System;
using System.Web;

namespace ZanWeb;

/// <summary>
/// Base class for the JSON endpoints under /api. It adds nothing to
/// <see cref="AppController"/> beyond intent: an API controller answers
/// {"code","msg","data"} and is refused with a status code, never with a
/// redirect to a sign-in form. Both facts are decided by the dispatcher from
/// [Custom(Authorization = CustomAuthorization.ApiAuth)], so the class body
/// stays empty and the base tree stays one line deep per shell:
/// AppController -> AdminController / ApiController.
/// </summary>
class ApiController : AppController {
}
