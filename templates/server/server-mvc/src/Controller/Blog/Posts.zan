using System;
using System.Data;
using System.Data.Orm;
using System.Text;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Blog;
using ZanWeb.Dao.Blog;

namespace ZanWeb.Blog;

/// <summary>
/// The public blog: an article feed at /blog, one article at /blog/{id}.
///
/// Only published articles are visible here, and nothing on these pages can
/// write to the site except a comment -- which is stored unpublished and waits
/// for an editor. Writing articles is an admin screen, not a form on a public
/// page.
/// </summary>
[Route("[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("博客")]
class Posts : AppController {
    static int PageSize = 8;

    [HttpGet]
    [Route("/blog")]
    [Description("文章列表")]
    async void Index() {
        if (!this.DbReady()) {
            this.Fail(503, "2001", "服务暂时不可用，请稍后再试");
        }
        string kw = this.In("kw");
        string slug = this.In("cat");
        int page = this.InInt("page", 1);
        if (page < 1) { page = 1; }

        List<Category> cats = await this.Category
            .Where(a => a.status == 1).OrderBy(a => a.sortOrder).ToListAsync();
        int categoryId = 0;
        string categoryName = "";
        for (int i = 0; i < cats.Count; i = i + 1) {
            if (cats[i].slug == slug) {
                categoryId = cats[i].id;
                categoryName = cats[i].name;
            }
        }

        int total = await this.Post
            .Where(a => a.published == 1)
            .WhereIf(kw.Length > 0, a => a.title.Contains(kw))
            .WhereIf(categoryId > 0, a => a.categoryId == categoryId)
            .CountAsync();
        List<Post> rows = await this.Post
            .Where(a => a.published == 1)
            .WhereIf(kw.Length > 0, a => a.title.Contains(kw))
            .WhereIf(categoryId > 0, a => a.categoryId == categoryId)
            .OrderByDescending(a => a.top)
            .OrderByDescending(a => a.id)
            .Skip((page - 1) * Posts.PageSize).Take(Posts.PageSize)
            .ToListAsync();

        ViewData d = new ViewData();
        await Settings.Apply(d);
        string heading = "博客";
        if (categoryName.Length > 0) { heading = categoryName; }
        d.Set("title", heading);
        d.Set("heading", heading);
        d.Set("navBlog", "page");
        d.Set("kw", kw);
        d.Set("cat", slug);
        d.Set("total", Convert.ToString(total));

        List<StrMap> items = d.AddList("posts");
        for (int i = 0; i < rows.Count; i = i + 1) {
            Post p = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(p.id));
            row.Set("title", p.title);
            row.Set("summary", Posts.Summary(p));
            row.Set("author", Posts.Author(p));
            row.Set("category", Posts.CategoryName(cats, p.categoryId));
            row.Set("createdAt", Posts.Day(p.createdAt));
            row.Set("minutes", Convert.ToString(Prose.Minutes(p.body)));
            if (p.cover.Length > 0) { row.Set("cover", p.cover); }
            if (p.top == 1) { row.Set("top", "1"); }
            items.Add(row);
        }
        if (rows.Count == 0) { d.Set("empty", "1"); }

        List<StrMap> nav = d.AddList("categories");
        StrMap all = new StrMap();
        all.Set("name", "全部");
        all.Set("slug", "");
        if (slug.Length == 0) { all.Set("active", "active"); }
        nav.Add(all);
        for (int i = 0; i < cats.Count; i = i + 1) {
            StrMap c = new StrMap();
            c.Set("name", cats[i].name);
            c.Set("slug", cats[i].slug);
            if (cats[i].slug == slug) { c.Set("active", "active"); }
            nav.Add(c);
        }

        int pages = (total + Posts.PageSize - 1) / Posts.PageSize;
        d.Set("page", Convert.ToString(page));
        d.Set("pages", Convert.ToString(pages));
        if (page > 1) {
            d.Set("prev", Posts.PageLink(kw, slug, page - 1));
        }
        if (page < pages) {
            d.Set("next", Posts.PageLink(kw, slug, page + 1));
        }
        this.View(d);
    }

    [HttpGet]
    [Route("/blog/{id}")]
    [Description("文章详情")]
    async void Show() {
        int id = this.InInt("id", 0);
        if (id <= 0 || !this.DbReady()) {
            this.Fail(404, "2004", "文章不存在");
        }
        Post post = await this.Post.Read(id);
        if (post == null || post.published != 1) {
            this.Fail(404, "2004", "文章不存在");
        }
        int _v = await this.Post.Update()
            .Set(a => a.views, post.views + 1)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();

        List<Category> cats = await this.Category.ToListAsync();
        ViewData d = new ViewData();
        await Settings.Apply(d);
        d.Set("title", post.title);
        d.Set("navBlog", "page");
        d.Set("id", Convert.ToString(id));
        d.Set("heading", post.title);
        d.Set("author", Posts.Author(post));
        d.Set("category", Posts.CategoryName(cats, post.categoryId));
        d.Set("createdAt", Posts.Day(post.createdAt));
        d.Set("minutes", Convert.ToString(Prose.Minutes(post.body)));
        d.Set("views", Convert.ToString(post.views + 1));
        if (post.cover.Length > 0) { d.Set("cover", post.cover); }

        List<StrMap> paras = d.AddList("paragraphs");
        List<string> lines = Prose.Paragraphs(post.body);
        for (int i = 0; i < lines.Count; i = i + 1) {
            StrMap row = new StrMap();
            row.Set("text", lines[i]);
            paras.Add(row);
        }

        List<StrMap> tags = d.AddList("tags");
        List<string> labels = Prose.Tags(post.tags);
        for (int i = 0; i < labels.Count; i = i + 1) {
            StrMap row = new StrMap();
            row.Set("name", labels[i]);
            tags.Add(row);
        }
        if (labels.Count > 0) { d.Set("hasTags", "1"); }

        Post prev = await this.Post
            .Where(a => a.published == 1).Where(a => a.id < id)
            .OrderByDescending(a => a.id).FirstAsync();
        Post next = await this.Post
            .Where(a => a.published == 1).Where(a => a.id > id)
            .OrderBy(a => a.id).FirstAsync();
        if (prev != null) {
            d.Set("prevId", Convert.ToString(prev.id));
            d.Set("prevTitle", prev.title);
        }
        if (next != null) {
            d.Set("nextId", Convert.ToString(next.id));
            d.Set("nextTitle", next.title);
        }

        List<Comment> comments = await this.Comment
            .Where(a => a.postId == id).Where(a => a.status == 1)
            .OrderBy(a => a.id).ToListAsync();
        List<StrMap> crows = d.AddList("comments");
        for (int i = 0; i < comments.Count; i = i + 1) {
            StrMap row = new StrMap();
            row.Set("author", Posts.Nickname(comments[i].author));
            row.Set("content", comments[i].content);
            row.Set("createdAt", Posts.Day(comments[i].createdAt));
            crows.Add(row);
        }
        d.Set("commentCount", Convert.ToString(comments.Count));
        if (comments.Count == 0) { d.Set("noComments", "1"); }
        // With comments switched off the form goes away but the approved ones
        // stay readable: closing a discussion is not deleting it.
        if (await Settings.On(SettingKeys.CommentEnabled, true)) { d.Set("canComment", "1"); }
        this.View(d);
    }

    /// <summary>Takes a reader's comment. It is stored unpublished: an open
    /// form that could publish straight to the site is a spam target.</summary>
    [HttpPost]
    [Route("/blog/{id}/comment")]
    [Description("发表评论")]
    async void Reply() {
        int id = this.InInt("id", 0);
        string author = this.In("author");
        string content = this.NeedText("content", "评论内容");
        if (!this.DbReady()) {
            this.Fail(503, "2001", "服务暂时不可用，请稍后再试");
        }
        if (!await Settings.On(SettingKeys.CommentEnabled, true)) {
            this.Fail(403, "2003", "本站已关闭评论");
        }
        Post post = await this.Post.Read(id);
        if (post == null || post.published != 1) {
            this.Fail(404, "2004", "文章不存在");
        }
        if (author.Length == 0) { author = "访客"; }
        Comment c = new Comment();
        c.postId = id;
        c.author = author;
        c.email = this.In("email");
        c.content = content;
        // Review on: the comment waits for an editor. Review off: it is public
        // as soon as it is written.
        c.status = 0;
        if (!await Settings.On(SettingKeys.CommentReview, true)) { c.status = 1; }
        c.ip = this.Ctx().RemoteIp();
        c.createdAt = WebApp.NowSeconds();
        int _n = await this.Comment.Insert(c).ExecuteIdentityAsync();
        this.Ctx().Redirect("/blog/" + Convert.ToString(id) + "?commented=1");
    }

    static string PageLink(string kw, string slug, int page) {
        string q = "/blog?page=" + Convert.ToString(page);
        if (kw.Length > 0) { q = q + "&kw=" + Encoding.UrlEncode(kw); }
        if (slug.Length > 0) { q = q + "&cat=" + Encoding.UrlEncode(slug); }
        return q;
    }

    static string Summary(Post p) {
        if (p.summary.Length > 0) { return p.summary; }
        return Prose.Excerpt(p.body, 120);
    }

    static string Author(Post p) {
        if (p.author.Length > 0) { return p.author; }
        return "编辑部";
    }

    static string Nickname(string author) {
        if (author.Length > 0) { return author; }
        return "访客";
    }

    static string CategoryName(List<Category> cats, int id) {
        for (int i = 0; i < cats.Count; i = i + 1) {
            if (cats[i].id == id) { return cats[i].name; }
        }
        return "未分类";
    }

    static string Day(long seconds) {
        if (seconds <= 0) { return ""; }
        string s = DateTime.FromUnixSeconds(seconds).ToString();
        int sp = s.IndexOf(" ");
        if (sp > 0) { return s.Substring(0, sp); }
        return s;
    }
}
