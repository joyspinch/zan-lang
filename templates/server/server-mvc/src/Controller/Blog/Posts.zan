using System;
using System.Data;
using System.Json;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Blog;
using ZanWeb.Dao.Blog;
using ZanWeb.Model.Sys;
using ZanWeb.Dao.Sys;

namespace ZanWeb.Blog;

/// <summary>
/// 极简博客 —— 分层后每层只做一件事：
///
///   控制器（本文件）  取参数、管缓存、渲染视图
///   src/model/Post    实体 = 表结构，`this.Post` 就是这张表
///   src/dao/PostDao   只放复杂查询与缓存 key；日常增删改查不需要它
///
/// 表访问器：`this.Post` / `this.User` 直接就是对应数据表的类型化查询，字段名有
/// 编译期检查和自动补全，连接由框架在请求开始时借好、结束时归还——既不用 new Dao，
/// 也没有 Acquire/Release：
///
///     await this.Post.Where(a =&gt; a.published == 1).OrderByDescending(a =&gt; a.id)
///         .Take(20).ToListAsync()
///     await this.Post.Read(id)                 // 主键便捷读
///     await this.Post.Insert(p).ExecuteIdentityAsync()
///
/// 多表写入用 this.Begin()/Commit()/Rollback()（同一条连接才能在一个事务里，
/// 见 AppController）。
///
/// Redis 走 cache-aside：先读共享缓存，未命中查库并回填，写入后删 key。缓存只是
/// 加速，Redis 挂了就回落查库。
///
/// 路由 -&gt; 代码路径：/blog 由 src/controller/Blog/Posts.zan 的 Index 处理，视图是
/// views/Blog/Posts.Index.html（视图 key = 模块.控制器.动作）。
/// </summary>
[Route("[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("博客")]
class Posts : AppController {

    [HttpGet]
    [Route("/blog")]
    [Description("文章列表")]
    async void Index() {
        string kw = this.In("kw");
        CacheContext cache = this.Cache();

        // 带搜索词的结果不进缓存：key 会随用户输入无限膨胀。
        bool cacheable = kw.Length == 0;
        List<Post> rows = null;
        string source = "db";

        if (cacheable) {
            string cached = await cache.GetAsync(PostDao.ListKey);
            if (cached.Length > 0) {
                rows = Json.Deserialize<List<Post>>(cached);
                source = "cache";
            }
        }

        if (rows == null) {
            if (!this.DbReady()) {
                this.Fail(503, "2001", "数据库不可用，检查 config/app.json [database]");
                return;
            }
            rows = await this.Post
                .Where(a => a.published == 1)
                .WhereIf(kw.Length > 0, a => a.title.Contains(kw))
                .OrderByDescending(a => a.id)
                .Take(20)
                .ToListAsync();
            if (cacheable) {
                await cache.SetTtlAsync(PostDao.ListKey,
                    Json.Serialize<List<Post>>(rows), 60);
            }
        }

        ViewData d = new ViewData();
        d.Set("title", "极简博客");
        d.Set("navBlog", "page");
        d.Set("kw", kw);
        d.Set("source", source);
        d.Set("count", Convert.ToString(rows.Count));
        DbContext ctx = this.Db();
        d.Set("pool", "idle=" + Convert.ToString(ctx.IdleCount())
            + " live=" + Convert.ToString(ctx.LiveCount())
            + " waiting=" + Convert.ToString(ctx.WaitingCount()));
        d.Set("cacheKind", Posts.CacheKind(cache));
        List<StrMap> items = d.AddList("posts");
        for (int i = 0; i < rows.Count; i = i + 1) {
            Post p = rows[i];
            StrMap row = new StrMap();
            row.Set("id", Convert.ToString(p.id));
            row.Set("title", p.title);
            row.Set("author", p.author);
            row.Set("createdAt", Posts.Stamp(p.createdAt));
            items.Add(row);
        }
        this.View(d);
    }

    [HttpGet]
    [Route("/blog/{id}")]
    [Description("文章详情")]
    async void Show() {
        int id = Filter.ToInt(this.Param("id"), 0);
        if (id <= 0) {
            this.Fail(404, "2004", "文章不存在");
            return;
        }
        CacheContext cache = this.Cache();
        string key = PostDao.PostKey(id);
        string source = "cache";

        Post post = null;
        string cached = await cache.GetAsync(key);
        if (cached.Length > 0) { post = Json.Deserialize<Post>(cached); }

        if (post == null) {
            source = "db";
            if (!this.DbReady()) {
                this.Fail(503, "2001", "数据库不可用");
                return;
            }
            post = await this.Post.Read(id);
            if (post == null) {
                this.Fail(404, "2004", "文章不存在");
                return;
            }
            await cache.SetTtlAsync(key, Json.Serialize<Post>(post), 60);
        }

        ViewData d = new ViewData();
        d.Set("title", post.title);
        d.Set("navBlog", "page");
        d.Set("body", post.body);
        d.Set("author", post.author);
        d.Set("createdAt", Posts.Stamp(post.createdAt));
        d.Set("source", source);
        d.Set("cacheKind", Posts.CacheKind(cache));
        this.View(d);
    }

    [HttpPost]
    [Route("/blog/create")]
    [Description("发布文章")]
    async void Create() {
        string title = this.InText("title");
        string body = this.InText("body");
        if (title.Length == 0 || body.Length == 0) {
            this.Fail(400, "1001", "标题和正文都不能为空");
            return;
        }

        if (!this.DbReady()) {
            this.Fail(503, "2001", "数据库不可用");
            return;
        }

        // 作者取自登录身份，不取表单：客户端传来的 author 可以是任何人。
        string author = "anonymous";
        if (this.IsLogin()) {
            User me = await this.User.Read(Filter.ToInt(this.uid, 0));
            if (me != null) { author = me.username; }
        }

        Post p = new Post();
        p.title = title;
        p.body = body;
        p.author = author;
        p.published = 1;
        p.createdAt = WebApp.NowSeconds();

        int newId = await this.Post.Insert(p).ExecuteIdentityAsync();

        // 写完就让缓存失效，而不是等 TTL 到期，否则列表最长 60 秒看不到新文章。
        await this.Cache().DelAsync(PostDao.ListKey);
        this.Ctx().Redirect("/blog/" + Convert.ToString(newId));
    }

    static string CacheKind(CacheContext cache) {
        if (cache.Shared()) { return "redis (跨 worker 共享)"; }
        return "memory (仅本 worker)";
    }

    static string Stamp(long seconds) {
        return DateTime.FromUnixSeconds(seconds).ToString();
    }
}
