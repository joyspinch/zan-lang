using System;

namespace ZanWeb;

/// <summary>Process-local application services. Each worker creates its own
/// instance; shared state must live in the database or an external cache.</summary>
class AppServices {
    static AppServices current;
    DbContext db;
    CacheContext cache;

    AppServices(DbContext db, CacheContext cache) {
        this.db = db;
        this.cache = cache;
    }

    static AppServices Create() {
        return new AppServices(DbContext.Create(), CacheContext.Create());
    }

    static void Use(AppServices services) {
        AppServices.current = services;
    }

    static AppServices Current() {
        if (AppServices.current == null) {
            AppServices.current = AppServices.Create();
        }
        return AppServices.current;
    }

    DbContext Db() {
        return this.db;
    }

    CacheContext Cache() {
        return this.cache;
    }
}
