using System;
using System.Net;
using System.Diagnostics;

namespace ZanWeb;

/// <summary>
/// Server bootstrap. It reads the [worker] config section and either runs the
/// WebApp accept loop in a single process, or -- for worker.count > 1 -- hands
/// serving to the standard-library multi-process runtime (System.Net.Worker).
///
/// worker.count = 1 (default): a single process runs the coroutine event loop
///   -- each connection is already handled in its own coroutine, so one worker
///   scales to many thousands of concurrent connections. Best for development
///   (logs stream straight into the IDE terminal).
///
/// worker.count > 1: System.Net.Worker spawns `count` worker processes and a
///   supervising master (a crashed worker is respawned). Connections are spread
///   across the workers, using every CPU core, fully event-driven:
///     - Windows: the master binds and accepts on its own IOCP, then hands each
///       ACCEPTED socket to a worker round-robin via WSADuplicateSocket over a
///       dedicated per-listener channel (a listener shared across processes
///       loses IOCP completions, so workers never accept themselves).
///     - Linux/macOS: each worker binds the same port with SO_REUSEPORT and the
///       kernel load-balances new connections across the sockets.
///   The MVC request pipeline is plugged in unchanged via WebApp.ServeSock, so
///   routing/middleware/uploads all still run per connection in the worker.
///
/// worker.daemon = true (Linux): the master detaches from the controlling
///   terminal (setsid) and keeps running in the background.
/// </summary>
class Server {
    /// <summary>Boots the server according to the [worker] config section.
    /// Await this from Main.</summary>
    static async int Run(WebApp app) {
        int count = Cfg.Worker.count;
        bool daemon = Cfg.Worker.daemon;

        if (count <= 1) {
            if (daemon && ProcessHost.Daemonize()) {
                Console.WriteLine("[server] daemonized; parent process exiting.");
                return 0;
            }
            int r = await app.Start();
            return r;
        }

        // Multi-process: reuse the proven master/worker runtime. The same code
        // runs in the master and in every worker process; Worker.RunAll detects
        // its own role from the environment (ProcessHost.IsWorker).
        WebApp.SetActive(app);
        Worker w = Worker.Create("http", Cfg.Server.host, Cfg.Server.port);
        w.SetCount(count);
        w.onRawConnection = WebApp.ServeSock;
        if (daemon) { Worker.SetDaemonize(true); }
        await Worker.RunAll();
        return 0;
    }
}
