using System;
using System.Data;

namespace ZanWeb;

/// <summary>
/// Database context owned by one worker process. The connection is opened lazily
/// in the process that first uses it; it is never shared across worker processes
/// or concurrent request transactions.
/// </summary>
class DbContext {
    IDbConnection connection;
    bool tried;

    DbContext() {
        this.connection = null;
        this.tried = false;
    }

    static DbContext Create() {
        return new DbContext();
    }

    IDbConnection Connection() {
        if (this.connection != null) { return this.connection; }
        if (this.tried) { return null; }
        this.tried = true;
        this.connection = Db.Conn();
        return this.connection;
    }

    bool Ready() {
        IDbConnection db = this.Connection();
        return db != null && db.IsConnected();
    }

    void SyncIdentitySchema() {
        IDbConnection db = this.Connection();
        if (db == null || !db.IsConnected()) { return; }
        db.SyncStructureAll();
    }
}
