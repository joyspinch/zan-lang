using System;
using System.Data;

namespace ZanWeb;

/// <summary>
/// Database access for one worker process: a connection POOL plus the lease
/// protocol every call site follows. main.zan builds the pool from
/// config/app.json once and injects it here.
///
/// A request borrows a connection, runs its statements, and gives it back in a
/// finally block — the connection belongs to that request (and to its
/// transaction) for as long as it holds it, and to nobody else:
///
///   DbContext ctx = this.Db();
///   IDbConnection db = await ctx.Acquire();
///   if (db == null) { ...database unavailable... }
///   try {
///       List&lt;Post&gt; rows = db.Select&lt;Post&gt;().OrderByDescending(a =&gt; a.id).ToList();
///   } finally {
///       ctx.Release(db);
///   }
///
/// Forgetting Release() leaks the connection: the pool is capped, so a leak
/// eventually parks every request forever. The finally block is not optional.
/// </summary>
class DbContext {
    DbPool pool;

    DbContext(DbPool pool) {
        this.pool = pool;
    }

    /// <summary>Wraps the pool built by the bootstrap (main.zan).</summary>
    static DbContext Of(DbPool pool) {
        return new DbContext(pool);
    }

    /// <summary>Borrows a connection for this request; parks the coroutine while
    /// the pool is saturated. Returns null when the database is unreachable or
    /// the pool is closed — always pair with Release() in a finally.</summary>
    async IDbConnection Acquire() {
        if (this.pool == null) { return null; }
        IDbConnection db = await this.pool.AcquireAsync();
        if (db == null || !db.IsConnected()) {
            this.pool.Release(db);
            return null;
        }
        return db;
    }

    /// <summary>Borrows an already-idle connection without suspending, for the
    /// synchronous resolvers that are not coroutines. Returns null when nothing
    /// is idle, which those call sites must treat as "unavailable" (fail closed)
    /// rather than as "no data".</summary>
    IDbConnection AcquireSync() {
        if (this.pool == null) { return null; }
        IDbConnection db = this.pool.TryAcquire();
        if (db == null) { return null; }
        if (!db.IsConnected()) {
            this.pool.Release(db);
            return null;
        }
        return db;
    }

    /// <summary>Returns a connection to the pool. Safe with null, so it can sit
    /// in a finally block unconditionally.</summary>
    void Release(IDbConnection db) {
        if (this.pool == null || db == null) { return; }
        this.pool.Release(db);
    }

    /// <summary>Opens and parks <paramref name="count"/> connections at startup
    /// (before the server accepts anything), so the first request does not pay
    /// the connect cost and AcquireSync() finds a live connection. Returns the
    /// number now idle: 0 means the database is unreachable.</summary>
    async int Warmup(int count) {
        if (this.pool == null) { return 0; }
        return await this.pool.WarmupAsync(count);
    }

    /// <summary>Idle / live / waiting counters, for a health or metrics endpoint.</summary>
    int IdleCount() {
        if (this.pool == null) { return 0; }
        return this.pool.IdleCount();
    }

    int LiveCount() {
        if (this.pool == null) { return 0; }
        return this.pool.LiveCount();
    }

    int WaitingCount() {
        if (this.pool == null) { return 0; }
        return this.pool.WaitingCount();
    }

    void Close() {
        if (this.pool != null) { this.pool.Close(); }
    }
}
