using System;
using System.Data.Redis;

namespace ZanWeb;

/// <summary>
/// Cache with optional TTL. Two backends, selected by [cache].driver in
/// config/app.json:
///
///  - "memory" (default): the zero-dependency process-local StrMap below.
///  - "redis": a shared/distributed cache over System.Data.Redis. The RESP
///    client is fully async, so the async API (GetAsync/SetAsync/...) drives it
///    on the coroutine path -- an async handler awaits a cache lookup and the
///    worker keeps serving other connections while Redis round-trips.
///
/// The async API is the one to call from handlers; it transparently falls back
/// to the in-memory store when Redis is not configured or unreachable, so code
/// written against it works in either mode. The synchronous methods remain for
/// memory-only, non-coroutine callers.
/// </summary>
class Cache {
    static StrMap store = StrMap.Create();
    static StrMap expiry = StrMap.Create();   // key -> expiry epoch seconds ("0" = never)

    // Lazily-opened shared Redis connection (only when driver == "redis").
    static RedisClient rc = null;
    static bool rcTried = false;

    static int Digit(string ch) {
        string d = "0123456789";
        int i = 0;
        while (i < 10) {
            if (d.Substring(i, 1) == ch) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }

    static int ToInt(string s) {
        int v = 0;
        int i = 0;
        while (i < s.Length) {
            int d = Cache.Digit(s.Substring(i, 1));
            if (d < 0) { break; }
            v = v * 10 + d;
            i = i + 1;
        }
        return v;
    }

    static bool Alive(string key) {
        if (!store.Has(key)) { return false; }
        string e = expiry.GetOr(key, "0");
        if (e == "0") { return true; }
        if (WebApp.NowSeconds() >= Cache.ToInt(e)) {
            store.Set(key, "");
            expiry.Set(key, "0");
            return false;
        }
        return true;
    }

    static bool Has(string key) { return Cache.Alive(key); }

    static string Get(string key) {
        if (!Cache.Alive(key)) { return ""; }
        return store.Get(key);
    }

    static string GetOr(string key, string dflt) {
        if (!Cache.Alive(key)) { return dflt; }
        return store.Get(key);
    }

    static void Set(string key, string val) {
        store.Set(key, val);
        expiry.Set(key, "0");
    }

    static void SetTtl(string key, string val, int seconds) {
        store.Set(key, val);
        expiry.Set(key, Convert.ToString(WebApp.NowSeconds() + seconds));
    }

    static void Del(string key) {
        store.Set(key, "");
        expiry.Set(key, "0");
    }

    // ---- async API (Redis-backed, memory fallback) ----

    /// <summary>Returns the shared Redis connection, opening it on first use.
    /// Null when [cache].driver != "redis" or the server is unreachable, in
    /// which case the async methods fall back to the in-memory store.</summary>
    static async RedisClient Redis() {
        if (rc != null) { return rc; }
        if (rcTried) { return null; }
        rcTried = true;
        if (Cfg.Cache.driver != "redis") { return null; }
        RedisClient c = await RedisClient.ConnectAsync(
            Cfg.Cache.redisHost, Cfg.Cache.redisPort);
        // A refused/half-open socket can still report "connected"; a PING
        // round-trip confirms a real server before we trust it, otherwise we
        // fall back to the in-memory store instead of leaking RESP errors.
        bool alive = false;
        if (c != null) { alive = await c.PingAsync(); }
        if (!alive) {
            if (c != null) { c.Close(); }
            Console.WriteLine("[cache] redis unreachable ("
                + Cfg.Cache.redisHost + ":" + Convert.ToString(Cfg.Cache.redisPort)
                + ") -- using in-memory cache");
            return null;
        }
        rc = c;
        Console.WriteLine("[cache] redis connected");
        return rc;
    }

    /// <summary>Reads a key. "" on miss. Awaits Redis when configured.</summary>
    static async string GetAsync(string key) {
        RedisClient r = await Cache.Redis();
        if (r != null) { return await r.GetAsync(key); }
        return Cache.Get(key);
    }

    /// <summary>Stores a key with no expiry. Awaits Redis when configured.</summary>
    static async void SetAsync(string key, string val) {
        RedisClient r = await Cache.Redis();
        if (r != null) {
            bool _ok = await r.SetAsync(key, val);
            return;
        }
        Cache.Set(key, val);
    }

    /// <summary>Stores a key that expires after `seconds`.</summary>
    static async void SetTtlAsync(string key, string val, int seconds) {
        RedisClient r = await Cache.Redis();
        if (r != null) {
            bool _ok = await r.SetAsync(key, val);
            int _e = await r.ExpireAsync(key, seconds);
            return;
        }
        Cache.SetTtl(key, val, seconds);
    }

    /// <summary>Deletes a key. Awaits Redis when configured.</summary>
    static async void DelAsync(string key) {
        RedisClient r = await Cache.Redis();
        if (r != null) {
            int _d = await r.DelAsync(key);
            return;
        }
        Cache.Del(key);
    }
}
