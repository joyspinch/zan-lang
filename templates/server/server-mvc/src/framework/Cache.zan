using System;

namespace ZanWeb;

class Cache {
    static CacheContext Current() {
        return AppServices.Current().Cache();
    }

    static bool Has(string key) {
        return Cache.Current().Has(key);
    }

    static string Get(string key) {
        return Cache.Current().Get(key);
    }

    static string GetOr(string key, string fallback) {
        return Cache.Current().GetOr(key, fallback);
    }

    static void Set(string key, string text) {
        Cache.Current().Set(key, text);
    }

    static void SetTtl(string key, string text, int seconds) {
        Cache.Current().SetTtl(key, text, seconds);
    }

    static void Del(string key) {
        Cache.Current().Del(key);
    }

    static async string GetAsync(string key) {
        return await Cache.Current().GetAsync(key);
    }

    static async void SetAsync(string key, string text) {
        await Cache.Current().SetAsync(key, text);
    }

    static async void SetTtlAsync(string key, string text, int seconds) {
        await Cache.Current().SetTtlAsync(key, text, seconds);
    }

    static async void DelAsync(string key) {
        await Cache.Current().DelAsync(key);
    }
}
