using System;
using System.Data;
using System.Data.Orm;
using System.Json;

namespace ZanWeb;

/// <summary>
/// 元数据驱动的通用 CRUD 引擎。任何注册了 EntityMeta 的实体，其列表（分页/
/// 搜索/排序）、新增、编辑、删除都由这一套代码完成 —— 控制层只负责声明元数据
/// 与转发请求，页面由前端按元数据动态渲染。
///
/// 数据访问全部基于 System.Data.Orm（Model / ModelQuery / ModelUpdate /
/// ModelDelete / QueryBuilder）：值一律通过参数绑定传入，列名经过
/// QueryBuilder.RequireIdent 白名单校验（仅字母数字下划线），没有任何 SQL
/// 字符串拼接。固定实体（用户/角色/部门）由控制层直接使用类型化 ORM 的
/// db.Select&lt;T&gt;() / WhereIf(λ) / OrderBy(λ) / Page() 链式查询。
/// </summary>
class Crud {
    List<EntityMeta> metas;   // 已注册的实体元数据

    Crud() {
        this.metas = new List<EntityMeta>();
    }

    static Crud current;
    static Crud Current() {
        if (Crud.current == null) { Crud.current = new Crud(); }
        return Crud.current;
    }

    /// <summary>注册一个实体的元数据（幂等：同表重复注册覆盖）。</summary>
    static EntityMeta Register(EntityMeta meta) {
        Crud c = Crud.Current();
        int i = 0;
        while (i < c.metas.Count) {
            if (c.metas[i].table == meta.table) {
                c.metas[i] = meta;
                return meta;
            }
            i = i + 1;
        }
        c.metas.Add(meta);
        return meta;
    }

    /// <summary>按表名取元数据，未注册返回 null。</summary>
    static EntityMeta MetaOf(string table) {
        Crud c = Crud.Current();
        int i = 0;
        while (i < c.metas.Count) {
            if (c.metas[i].table == table) { return c.metas[i]; }
            i = i + 1;
        }
        return null;
    }

    static IDbConnection Db() {
        return AppServices.Current().Db().Connection();
    }

    /// <summary>列表查询。返回 JSON：
    /// {"code","msg","data":{"rows":[...],"total":n,"page":p,"pages":n}}。
    /// 分页/搜索/排序均由 QueryBuilder 构建（参数绑定，列名白名单）。</summary>
    static string List(string table, int page, int size, string kw,
        List<string> extraCols, List<string> extraVals) {
        EntityMeta meta = Crud.MetaOf(table);
        if (meta == null) { return Crud.ErrorJson("NOT_FOUND", "未知实体 " + table); }
        IDbConnection db = Crud.Db();
        if (db == null || !db.IsConnected()) {
            return Crud.ErrorJson("DB_DOWN", "数据库未配置");
        }
        if (page < 1) { page = 1; }
        if (size < 1 || size > 200) { size = 20; }

        // 条件：关键字模糊搜索（LIKE ?，值绑定）+ 额外等值条件
        QueryBuilder cond = QueryBuilder.From(table);
        DbParams condParams = DbParams.Create();
        Crud.ApplyConditions(cond, condParams, meta, kw, extraCols, extraVals);

        // 总数
        int total = Convert.ToInt(db.ExecuteScalar(
            cond.BuildSelectParams("COUNT(*)"), condParams));

        // 当前页
        QueryBuilder qb = QueryBuilder.From(table);
        DbParams qbParams = DbParams.Create();
        Crud.ApplyConditions(qb, qbParams, meta, kw, extraCols, extraVals);
        if (meta.orderBy.Length > 0) {
            qb.OrderBy(meta.orderBy);
        } else {
            qb.OrderByDesc(meta.key);
        }
        qb.Limit(size);
        qb.Offset((page - 1) * size);
        DbResult r = db.Query(qb.BuildSelectParams("*"), qbParams);
        List<ModelRow> rows = ModelRow.FromDbResultAll(r);

        JsonValue data = JsonValue.NewObject();
        data.Put("total", JsonValue.NewNum(Convert.ToString(total)));
        data.Put("page", JsonValue.NewNum(Convert.ToString(page)));
        int pages = 0;
        if (total > 0) { pages = (total + size - 1) / size; }
        data.Put("pages", JsonValue.NewNum(Convert.ToString(pages)));
        JsonValue arr = JsonValue.NewArray();
        int i = 0;
        while (i < rows.Count) {
            arr.Append(JsonValue.ParseLenient(rows[i].ToJson()));
            i = i + 1;
        }
        data.Put("rows", arr);
        return Crud.DataJson(data);
    }

    /// <summary>把关键字模糊搜索 + 额外等值条件应用到查询构建器。</summary>
    static void ApplyConditions(QueryBuilder qb, DbParams p, EntityMeta meta,
        string kw, List<string> extraCols, List<string> extraVals) {
        string searchSql = meta.SearchSql();
        if (searchSql.Length > 0 && kw.Length > 0) {
            qb.Where(searchSql);
            int i = 0;
            while (i < meta.searchable.Count) {
                p.Add("%" + kw + "%");
                i = i + 1;
            }
        }
        if (extraCols != null) {
            int i = 0;
            while (i < extraCols.Count && i < extraVals.Count) {
                if (extraVals[i].Length > 0) {
                    qb.WhereEq(extraCols[i], extraVals[i]);
                    p.Add(extraVals[i]);
                }
                i = i + 1;
            }
        }
    }

    /// <summary>按主键取单行，返回行 JSON；不存在返回空串。</summary>
    static string Get(string table, string id) {
        EntityMeta meta = Crud.MetaOf(table);
        if (meta == null) { return ""; }
        IDbConnection db = Crud.Db();
        if (db == null || !db.IsConnected()) { return ""; }
        Model model = Model.Define(table);
        ModelRow row = model.FindById(db, Crud.ToInt(id));
        if (row == null) { return ""; }
        string json = row.ToJson();
        if (json.Length == 0) { return ""; }
        return json;
    }

    /// <summary>校验并保存（新增或编辑，编辑时 id 非空）。</summary>
    static string Save(string table, string id, List<string> names,
        List<string> values) {
        EntityMeta meta = Crud.MetaOf(table);
        if (meta == null) { return Crud.ErrorJson("NOT_FOUND", "未知实体 " + table); }
        IDbConnection db = Crud.Db();
        if (db == null || !db.IsConnected()) {
            return Crud.ErrorJson("DB_DOWN", "数据库未配置");
        }

        // 必填校验
        int i = 0;
        while (i < names.Count) {
            FieldMeta f = meta.Field(names[i]);
            if (f != null && f.required && values[i].Length == 0) {
                return Crud.ErrorJson("VALIDATE", "请填写" + f.label);
            }
            i = i + 1;
        }

        bool isEdit = id.Length > 0 && id != "0";
        Model model = Model.Define(table);
        if (isEdit) {
            ModelUpdate upd = model.UpdateQuery(db);
            int j = 0;
            while (j < names.Count) {
                upd.Set(names[j], values[j]);
                j = j + 1;
            }
            upd.WhereEq(meta.key, id);
            int affected = upd.Execute();
            if (affected <= 0) {
                return Crud.ErrorJson("NOT_FOUND", "记录不存在或已被删除");
            }
        } else {
            ModelRow row = ModelRow.Create();
            int j = 0;
            while (j < names.Count) {
                row.Set(names[j], values[j]);
                j = j + 1;
            }
            int affected = model.Insert(db, row);
            if (affected <= 0) {
                return Crud.ErrorJson("FAILED", "保存失败");
            }
        }
        return Crud.OkJson("保存成功");
    }

    /// <summary>按主键删除（支持逗号分隔的批量 id）。</summary>
    static string Delete(string table, string ids) {
        EntityMeta meta = Crud.MetaOf(table);
        if (meta == null) { return Crud.ErrorJson("NOT_FOUND", "未知实体 " + table); }
        IDbConnection db = Crud.Db();
        if (db == null || !db.IsConnected()) {
            return Crud.ErrorJson("DB_DOWN", "数据库未配置");
        }
        List<string> list = Crud.SplitIds(ids);
        if (list.Count == 0) { return Crud.ErrorJson("VALIDATE", "缺少要删除的记录"); }
        Model model = Model.Define(table);
        int i = 0;
        while (i < list.Count) {
            model.DeleteById(db, Crud.ToInt(list[i]));
            i = i + 1;
        }
        return Crud.OkJson("删除成功");
    }

    // ---- 辅助 ----

    /// <summary>拆分逗号分隔的 id 列表，逐个校验为纯数字。</summary>
    static List<string> SplitIds(string ids) {
        List<string> outList = new List<string>();
        string[] parts = ids.Split(",");
        int i = 0;
        while (i < parts.Length) {
            string t = Filter.Clean(parts[i]);
            if (t.Length > 0 && Crud.IsDigits(t)) { outList.Add(t); }
            i = i + 1;
        }
        return outList;
    }

    static bool IsDigits(string s) {
        if (s.Length == 0) { return false; }
        int i = 0;
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
            i = i + 1;
        }
        return true;
    }

    static int ToInt(string s) {
        return Filter.ToInt(s, 0);
    }

    static string OkJson(string msg) {
        return Crud.DataJsonMsg(msg, JsonValue.NewNull());
    }

    static string ErrorJson(string code, string msg) {
        JsonValue o = JsonValue.NewObject();
        o.Put("code", JsonValue.NewStr(code));
        o.Put("msg", JsonValue.NewStr(msg));
        o.Put("data", JsonValue.NewNull());
        return o.ToJson();
    }

    static string DataJson(JsonValue data) {
        JsonValue o = JsonValue.NewObject();
        o.Put("code", JsonValue.NewStr("0000"));
        o.Put("msg", JsonValue.NewStr("ok"));
        o.Put("data", data);
        return o.ToJson();
    }

    static string DataJsonMsg(string msg, JsonValue data) {
        JsonValue o = JsonValue.NewObject();
        o.Put("code", JsonValue.NewStr("0000"));
        o.Put("msg", JsonValue.NewStr(msg));
        o.Put("data", data);
        return o.ToJson();
    }
}
