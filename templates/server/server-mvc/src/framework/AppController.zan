using System;
using System.Data;
using System.Web;

namespace ZanWeb;

/// <summary>
/// Controller base with injected database and cache accessors. Dependencies are
/// assembled in main.zan and installed via AppServices.Use(...); actions reach
/// them through this.Db() / this.Cache() instead of static service lookup.
/// The router instantiates the controller with no arguments, so the accessors
/// resolve the injected service root lazily on first use.
/// </summary>
class AppController : Controller {
    /// <summary>The injected database context (null before AppServices.Use).</summary>
    protected DbContext Db() {
        AppServices s = AppServices.Current();
        if (s == null) { return null; }
        return s.Db();
    }

    /// <summary>The injected cache context (null before AppServices.Use).</summary>
    protected CacheContext Cache() {
        AppServices s = AppServices.Current();
        if (s == null) { return null; }
        return s.Cache();
    }
}
