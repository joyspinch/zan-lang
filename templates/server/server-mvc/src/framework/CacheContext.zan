using System;
using System.Data.Redis;

namespace ZanWeb;

class CacheContext {
    StrMap store;
    StrMap expiry;
    RedisPool redis;

    CacheContext() {
        this.store = StrMap.Create();
        this.expiry = StrMap.Create();
        this.redis = null;
        if (Cfg.Cache.driver == "redis") {
            this.redis = RedisPool.Create(Cfg.Cache.redisHost,
                Cfg.Cache.redisPort, Cfg.Cache.poolSize,
                Cfg.Cache.connectTimeoutMs);
        }
    }

    static CacheContext Create() {
        return new CacheContext();
    }

    static int Digit(string ch) {
        string digits = "0123456789";
        int i = 0;
        while (i < 10) {
            if (digits.Substring(i, 1) == ch) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }

    static int ToInt(string text) {
        int result = 0;
        int i = 0;
        while (i < text.Length) {
            int digit = CacheContext.Digit(text.Substring(i, 1));
            if (digit < 0) { break; }
            result = result * 10 + digit;
            i = i + 1;
        }
        return result;
    }

    bool Alive(string key) {
        if (!this.store.Has(key)) { return false; }
        string expires = this.expiry.GetOr(key, "0");
        if (expires == "0") { return true; }
        if (WebApp.NowSeconds() >= CacheContext.ToInt(expires)) {
            this.store.Set(key, "");
            this.expiry.Set(key, "0");
            return false;
        }
        return true;
    }

    bool Has(string key) {
        return this.Alive(key);
    }

    string Get(string key) {
        if (!this.Alive(key)) { return ""; }
        return this.store.Get(key);
    }

    string GetOr(string key, string fallback) {
        if (!this.Alive(key)) { return fallback; }
        return this.store.Get(key);
    }

    void Set(string key, string text) {
        this.store.Set(key, text);
        this.expiry.Set(key, "0");
    }

    void SetTtl(string key, string text, int seconds) {
        this.store.Set(key, text);
        this.expiry.Set(key, Convert.ToString(WebApp.NowSeconds() + seconds));
    }

    void Del(string key) {
        this.store.Set(key, "");
        this.expiry.Set(key, "0");
    }

    async string GetAsync(string key) {
        if (this.redis == null) { return this.Get(key); }
        RedisClient client = await this.redis.AcquireAsync();
        if (client == null) { return this.Get(key); }
        try {
            return await client.GetAsync(key);
        } finally {
            this.redis.Release(client);
        }
    }

    async void SetAsync(string key, string text) {
        if (this.redis == null) { this.Set(key, text); return; }
        RedisClient client = await this.redis.AcquireAsync();
        if (client == null) { this.Set(key, text); return; }
        try {
            bool _ok = await client.SetAsync(key, text);
        } finally {
            this.redis.Release(client);
        }
    }

    async void SetTtlAsync(string key, string text, int seconds) {
        if (this.redis == null) { this.SetTtl(key, text, seconds); return; }
        RedisClient client = await this.redis.AcquireAsync();
        if (client == null) { this.SetTtl(key, text, seconds); return; }
        try {
            bool _ok = await client.SetAsync(key, text);
            int _expires = await client.ExpireAsync(key, seconds);
        } finally {
            this.redis.Release(client);
        }
    }

    async void DelAsync(string key) {
        if (this.redis == null) { this.Del(key); return; }
        RedisClient client = await this.redis.AcquireAsync();
        if (client == null) { this.Del(key); return; }
        try {
            int _deleted = await client.DelAsync(key);
        } finally {
            this.redis.Release(client);
        }
    }

    void Close() {
        if (this.redis != null) { this.redis.Close(); }
    }
}
