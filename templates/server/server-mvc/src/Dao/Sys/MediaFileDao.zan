using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;

namespace ZanWeb.Dao.Sys;

/* media 的数据读写网关 */
class MediaFileDao {
    IDbConnection db;

    MediaFileDao(IDbConnection db) {
        this.db = db;
    }

    async MediaFile ById(int id) {
        return await this.db.Select<MediaFile>().Where(a => a.id == id).FirstAsync();
    }

    async List<MediaFile> All() {
        return await this.db.Select<MediaFile>().OrderByDescending(a => a.id).ToListAsync();
    }

    async int Count() {
        return await this.db.Select<MediaFile>().CountAsync();
    }

    async int Insert(MediaFile file) {
        return await this.db.Insert<MediaFile>(file).ExecuteIdentityAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<MediaFile>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
