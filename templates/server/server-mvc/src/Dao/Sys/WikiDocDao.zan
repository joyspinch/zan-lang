using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;

namespace ZanWeb.Dao.Sys;

/* wiki_doc 的数据读写网关 */
class WikiDocDao {
    IDbConnection db;

    WikiDocDao(IDbConnection db) {
        this.db = db;
    }

    async WikiDoc ById(int id) {
        return await this.db.Select<WikiDoc>().Where(a => a.id == id).FirstAsync();
    }

    async List<WikiDoc> BySpace(int spaceId) {
        return await this.db.Select<WikiDoc>()
            .Where(a => a.spaceId == spaceId)
            .OrderByDescending(a => a.id)
            .ToListAsync();
    }

    async int Insert(WikiDoc doc) {
        return await this.db.Insert<WikiDoc>(doc).ExecuteIdentityAsync();
    }

    async int Update(WikiDoc doc) {
        return await this.db.Update<WikiDoc>()
            .Set(a => a.spaceId, doc.spaceId)
            .Set(a => a.title, doc.title)
            .Set(a => a.body, doc.body)
            .Set(a => a.summary, doc.summary)
            .Set(a => a.tags, doc.tags)
            .Set(a => a.status, doc.status)
            .Set(a => a.rev, doc.rev)
            .Where(a => a.id == doc.id)
            .ExecuteAffrowsAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<WikiDoc>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
