using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;

namespace ZanWeb.Dao.Sys;

/* sys_job_log 的数据读写网关 */
class SysJobLogDao {
    IDbConnection db;

    SysJobLogDao(IDbConnection db) {
        this.db = db;
    }

    async List<SysJobLog> ByJobId(int jobId, int limit) {
        return await this.db.Select<SysJobLog>()
            .Where(a => a.jobId == jobId)
            .OrderByDescending(a => a.id)
            .Take(limit)
            .ToListAsync();
    }

    async int Insert(SysJobLog log) {
        return await this.db.Insert<SysJobLog>(log).ExecuteIdentityAsync();
    }
}
