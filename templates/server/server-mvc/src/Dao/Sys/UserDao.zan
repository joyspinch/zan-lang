using System;
using System.Data;
using System.Data.Orm;

namespace ZanWeb;

/// <summary>
/// Reads and writes of the user tables. AuthUserEnt is the account used for
/// login today; User (sys_user) is the int-typed identity the RBAC phase builds
/// on. Both live here so no controller or resolver builds its own query.
/// </summary>
class UserDao {
    IDbConnection db;

    UserDao(IDbConnection db) {
        this.db = db;
    }

    // ---- accounts (login) ----

    AuthUserEnt AccountByName(string username) {
        return this.db.Select<AuthUserEnt>()
            .Where(a => a.username == username)
            .First();
    }

    AuthUserEnt AccountById(int id) {
        return this.db.Select<AuthUserEnt>()
            .Where(a => a.id == id)
            .First();
    }

    int CountAccounts() {
        return this.db.Select<AuthUserEnt>().Count();
    }

    int InsertAccount(AuthUserEnt account) {
        return this.db.Insert<AuthUserEnt>(account).ExecuteIdentity();
    }

    // ---- identities (sys_user) ----

    List<User> All() {
        return this.db.Select<User>().OrderBy(a => a.id).ToList();
    }

    User ById(int id) {
        return this.db.Select<User>().Where(a => a.id == id).ToOne();
    }
}
