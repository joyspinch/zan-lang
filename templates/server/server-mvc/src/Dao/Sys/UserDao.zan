using System;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;

namespace ZanWeb.Dao.Sys;

/// <summary>
/// Every read and write of sys_user. Login, token resolution and the admin
/// screens all come through here, so the account table has exactly one gateway.
/// A DAO is constructed with the caller's connection and owns no lifecycle.
///
/// Every method is async: the authentication resolvers run on the request
/// coroutine too, so nothing here blocks the worker while the database answers.
/// </summary>
class UserDao {
    IDbConnection db;

    UserDao(IDbConnection db) {
        this.db = db;
    }

    async User ByUsername(string username) {
        return await this.db.Select<User>()
            .Where(a => a.username == username)
            .FirstAsync();
    }

    async User ById(int id) {
        return await this.db.Select<User>().Where(a => a.id == id).FirstAsync();
    }

    /// <summary>Accounts as the API may expose them: no password material. See
    /// UserBrief.</summary>
    async List<UserBrief> AllBrief() {
        List<User> rows = await this.db.Select<User>()
            .OrderBy(a => a.id)
            .ToListAsync();
        List<UserBrief> brief = new List<UserBrief>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            brief.Add(UserDao.Brief(rows[i]));
        }
        return brief;
    }

    static UserBrief Brief(User row) {
        UserBrief b = new UserBrief();
        b.id = row.id;
        b.username = row.username;
        b.nickname = row.nickname;
        b.departmentId = row.departmentId;
        b.status = row.status;
        b.isSuper = row.isSuper;
        return b;
    }

    async int Count() {
        return await this.db.Select<User>().CountAsync();
    }

    async int Insert(User user) {
        return await this.db.Insert<User>(user).ExecuteIdentityAsync();
    }

    /// <summary>Enables (1) or disables (0) an account. A disabled account cannot
    /// log in, and AuthUser.TokenVersion stops resolving its tokens too, so the
    /// ban applies to sessions already open. Returns the number of rows changed.</summary>
    async int SetStatus(int id, int status) {
        return await this.db.Update<User>()
            .Set(a => a.status, status)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /// <summary>Invalidates every token issued for this account so far. Call it
    /// after a password change or to force a logout.</summary>
    async int BumpTokenVersion(int id) {
        User row = await this.ById(id);
        if (row == null) { return 0; }
        return await this.db.Update<User>()
            .Set(a => a.tokenVersion, row.tokenVersion + 1)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }
}
