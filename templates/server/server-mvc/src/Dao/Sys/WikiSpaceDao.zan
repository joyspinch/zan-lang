using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Sys;

namespace ZanWeb.Dao.Sys;

/* wiki_space 的数据读写网关 */
class WikiSpaceDao {
    IDbConnection db;

    WikiSpaceDao(IDbConnection db) {
        this.db = db;
    }

    async WikiSpace ById(int id) {
        return await this.db.Select<WikiSpace>().Where(a => a.id == id).FirstAsync();
    }

    async List<WikiSpace> All() {
        return await this.db.Select<WikiSpace>().OrderBy(a => a.sortOrder).ToListAsync();
    }

    async int Insert(WikiSpace space) {
        return await this.db.Insert<WikiSpace>(space).ExecuteIdentityAsync();
    }

    async int Update(WikiSpace space) {
        return await this.db.Update<WikiSpace>()
            .Set(a => a.name, space.name)
            .Set(a => a.description, space.description)
            .Set(a => a.icon, space.icon)
            .Set(a => a.departmentId, space.departmentId)
            .Set(a => a.sortOrder, space.sortOrder)
            .Set(a => a.status, space.status)
            .Where(a => a.id == space.id)
            .ExecuteAffrowsAsync();
    }

    async int Delete(int id) {
        return await this.db.Delete<WikiSpace>().Where(a => a.id == id).ExecuteAffrowsAsync();
    }
}
