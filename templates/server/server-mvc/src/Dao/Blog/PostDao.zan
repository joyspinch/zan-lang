using System;
using System.Data;
using System.Data.Orm;

namespace ZanWeb.Dao.Blog;

/* blog_post 的读写入口；控制器用业务名调用，变更只影响本文件。DAO 持有请求连接，无独立生命周期，同 action 内多 DAO 共享连接和事务。所有方法异步，全部使用 *Async 终结符。 */
class PostDao {
    IDbConnection db;

    /* 缓存键在数据层管理，控制器不持有，避免散落多文件导致失效。 */
    static string ListKey = "blog:list";

    static string PostKey(int id) {
        return "blog:post:" + Convert.ToString(id);
    }

    PostDao(IDbConnection db) {
        this.db = db;
    }

    /* 最新已发布文章，可按标题过滤（空关键字不添加条件）。 */
    async List<Post> Recent(int take, string keyword) {
        return await this.db.Select<Post>()
            .Where(a => a.published == 1)
            .WhereIf(keyword.Length > 0, a => a.title.Contains(keyword))
            .OrderByDescending(a => a.id)
            .Take(take)
            .ToListAsync();
    }

    /* 按 id 获取文章，无则返回 null。 */
    async Post ById(int id) {
        return await this.db.Select<Post>().Where(a => a.id == id).ToOneAsync();
    }

    /* 插入并返回新主键。 */
    async int Insert(Post post) {
        return await this.db.Insert<Post>(post).ExecuteIdentityAsync();
    }

    /* 最新文章（含草稿），可按标题过滤；管理后台视图。 */
    async List<Post> AllRecent(int take, string keyword) {
        return await this.db.Select<Post>()
            .WhereIf(keyword.Length > 0, a => a.title.Contains(keyword))
            .OrderByDescending(a => a.id)
            .Take(take)
            .ToListAsync();
    }

    /* 文章总数。 */
    async int CountAll() {
        return await this.db.Select<Post>().CountAsync();
    }

    /* 已发布文章数。 */
    async int CountPublished() {
        return await this.db.Select<Post>()
            .Where(a => a.published == 1)
            .CountAsync();
    }

    /* 发布(1)/隐藏(0)文章而不删除，返回影响行数。 */
    async int SetPublished(int id, int published) {
        return await this.db.Update<Post>()
            .Set(a => a.published, published)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }
}