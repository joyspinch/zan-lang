using System;
using System.Data;
using System.Data.Orm;

namespace ZanWeb.Dao.Blog;

/// <summary>
/// Every read and write of blog_post lives here. Controllers call methods with
/// business names and never build a query, so a change to how posts are stored
/// (a column, an index, a soft-delete flag, a cache) touches this file only.
///
/// A DAO is constructed with the REQUEST'S connection and holds no lifecycle of
/// its own — it neither acquires nor releases anything, so several DAOs in one
/// action share one connection and can therefore share one transaction:
///
///     PostDao posts = new PostDao(await this.Conn());
///     List&lt;Post&gt; rows = await posts.Recent(20, kw);
///
/// Every method is async and every query uses an *Async terminal. That is what
/// keeps the worker free while the database answers: on a non-blocking driver
/// (native MySQL) the coroutine parks on the socket, and on SQLite the async
/// terminal is a thin wrapper over the local file read. A synchronous terminal
/// here would stall every other request in this worker for the whole round trip
/// — and the async MySQL driver rejects synchronous calls outright.
/// </summary>
class PostDao {
    IDbConnection db;

    /// <summary>Cache keys live with the data layer, not in the controllers: the
    /// public blog and the admin screens both read and invalidate them, and two
    /// string literals in two files are one rename away from a stale page.</summary>
    static string ListKey = "blog:list";

    static string PostKey(int id) {
        return "blog:post:" + Convert.ToString(id);
    }

    PostDao(IDbConnection db) {
        this.db = db;
    }

    /// <summary>Newest published posts, optionally filtered by title. Empty
    /// keyword = no filter (WhereIf drops the condition and its parameter).</summary>
    async List<Post> Recent(int take, string keyword) {
        return await this.db.Select<Post>()
            .Where(a => a.published == 1)
            .WhereIf(keyword.Length > 0, a => a.title.Contains(keyword))
            .OrderByDescending(a => a.id)
            .Take(take)
            .ToListAsync();
    }

    /// <summary>One post by id, or null.</summary>
    async Post ById(int id) {
        return await this.db.Select<Post>().Where(a => a.id == id).ToOneAsync();
    }

    /// <summary>Inserts and returns the new identity.</summary>
    async int Insert(Post post) {
        return await this.db.Insert<Post>(post).ExecuteIdentityAsync();
    }

    /// <summary>Newest posts in any state, optionally filtered by title. This is
    /// the admin's view of the table: unlike Recent() it keeps drafts, so the
    /// screen that un-hides a post can actually see it.</summary>
    async List<Post> AllRecent(int take, string keyword) {
        return await this.db.Select<Post>()
            .WhereIf(keyword.Length > 0, a => a.title.Contains(keyword))
            .OrderByDescending(a => a.id)
            .Take(take)
            .ToListAsync();
    }

    /// <summary>Number of posts in any state.</summary>
    async int CountAll() {
        return await this.db.Select<Post>().CountAsync();
    }

    /// <summary>Number of published posts.</summary>
    async int CountPublished() {
        return await this.db.Select<Post>()
            .Where(a => a.published == 1)
            .CountAsync();
    }

    /// <summary>Publishes (1) or hides (0) a post without deleting it. Returns the
    /// number of rows changed, so a caller can tell "done" from "no such id".</summary>
    async int SetPublished(int id, int published) {
        return await this.db.Update<Post>()
            .Set(a => a.published, published)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }
}
