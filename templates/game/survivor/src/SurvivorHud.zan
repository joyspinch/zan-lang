using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Game.Foundation.Gui;
using Game.Kit;

namespace Survivor;

// 对局 HUD：全部是常驻的标准控件（Progress / Label / Image / Panel），外观由 Css() 换成本作皮肤。
// 顶部经验条、计时、等级与击杀；左上武器/被动图标行；首领血条；公告横幅；
// 角色脚下血条；怪物血条与伤害跳字按槽位复用；三选一卡片（SurvivorCards）与菜单（SurvivorMenu）盖在最上层。
public class SurvivorHud {
    public Panel root;
    public Label level;
    public Progress experience;
    public Label kills;
    public Image killIcon;
    public Label time;
    public Progress health;
    public Label best;
    public Label sound;
    public Label hint;
    public Label banner;
    public Panel bossPanel;
    public Label bossName;
    public Progress bossHealth;
    public List<Panel> weaponSlots;
    public List<Image> weaponIcons;
    public List<Label> weaponLevels;
    public List<Panel> passiveSlots;
    public List<Image> passiveIcons;
    public List<Label> passiveLevels;
    public SurvivorCards cards;
    public SurvivorMenu menu;
    public List<Progress> enemyHealth;
    public List<Label> floating;
    public HudLayer layer;
    SurvivorGame game;
    Panel healthLayer;
    Panel playLayer;
    int viewH;
    int viewW;
    int[] weaponShown;
    int[] passiveShown;

    public SurvivorHud(Gui.App app, SurvivorGame game) {
        this.game = game;
        this.weaponShown = new int[]{ -1, -1, -1, -1 };
        this.passiveShown = new int[]{ -1, -1, -1, -1 };
        app.UseCss(SurvivorHud.Css() + SurvivorCards.Css() + SurvivorMenu.Css());
        this.root = new Panel("survivor-hud");
        this.root.Class = "survivor-hud";
        this.playLayer = new Panel("survivor-play");
        this.playLayer.Class = "survivor-play";
        this.root.Add(this.playLayer);
        this.enemyHealth = new List<Progress>();
        this.healthLayer = new Panel("survivor-health-layer");
        this.healthLayer.Class = "survivor-health-layer";
        this.playLayer.Add(this.healthLayer);
        this.health = new Progress(100, 1);
        this.health.Class = "survivor-health";
        this.health.showIndicator = false;
        this.playLayer.Add(this.health);
        this.floating = new List<Label>();
        for (int i = 0; i < game.floatingTexts.capacity; i = i + 1) {
            Label number = new Label("");
            number.Class = "survivor-floating";
            number.SetShown(false);
            this.playLayer.Add(number);
            this.floating.Add(number);
        }
        // 顶部：通栏经验条 + 计时 + 等级 + 击杀
        this.experience = new Progress(0, 1);
        this.experience.Class = "survivor-experience";
        this.experience.showIndicator = false;
        this.playLayer.Add(this.experience);
        this.time = this.AddLabel("survivor-time");
        this.level = this.AddLabel("survivor-level");
        this.killIcon = new Image(SurvivorIcons.Skull());
        this.killIcon.Class = "survivor-kill-icon";
        this.playLayer.Add(this.killIcon);
        this.kills = this.AddLabel("survivor-kills");
        // 左上：武器 4 格 + 被动 4 格
        this.weaponSlots = new List<Panel>();
        this.weaponIcons = new List<Image>();
        this.weaponLevels = new List<Label>();
        this.passiveSlots = new List<Panel>();
        this.passiveIcons = new List<Image>();
        this.passiveLevels = new List<Label>();
        for (int i = 0; i < SurvivorData.MaxWeaponSlots; i = i + 1) {
            this.AddSlot(true, 16 + i * 52, 24);
        }
        for (int i = 0; i < SurvivorData.MaxPassiveSlots; i = i + 1) {
            this.AddSlot(false, 16 + i * 40, 76);
        }
        // 首领血条
        this.bossPanel = new Panel("survivor-boss");
        this.bossPanel.Class = "survivor-boss";
        this.bossName = new Label("");
        this.bossName.Class = "survivor-boss-name";
        this.bossPanel.Add(this.bossName);
        this.bossHealth = new Progress(100, 1);
        this.bossHealth.Class = "survivor-boss-health";
        this.bossHealth.showIndicator = false;
        this.bossPanel.Add(this.bossHealth);
        this.bossPanel.SetShown(false);
        this.playLayer.Add(this.bossPanel);
        this.banner = this.AddLabel("survivor-banner");
        this.banner.SetShown(false);
        this.best = this.AddLabel("survivor-meta survivor-best");
        this.best.SetShown(false);
        this.sound = this.AddLabel("survivor-meta survivor-sound");
        this.hint = new Label("WASD / ARROWS move   |   weapons fire on their own   |   grab gems to level up   |   P / ESC pause");
        this.hint.Class = "survivor-hint";
        this.hint.SetShown(false);
        this.playLayer.Add(this.hint);
        // 卡片与菜单最后加入，盖在 HUD 之上
        this.cards = new SurvivorCards();
        this.root.Add(this.cards.root);
        this.menu = new SurvivorMenu();
        this.root.Add(this.menu.root);
        this.layer = new HudLayer();
        this.layer.Add(this.root);
        // 世界用画布坐标；内容区从原生标题栏下方开始，首个事件前就提交区域
        this.layer.SetBounds(0, app.ContentTop(), app.canvas.Width(), app.canvas.Height() - app.ContentTop());
        this.layer.Bind(app);
        this.SyncState(app, 0.0);
    }

    Label AddLabel(string cls) {
        Label l = new Label("");
        l.Class = cls;
        this.playLayer.Add(l);
        return l;
    }

    void AddSlot(bool weapon, int left, int top) {
        Panel slot = new Panel(weapon ? "survivor-wslot" : "survivor-pslot");
        slot.Class = weapon ? "survivor-slot survivor-wslot" : "survivor-slot survivor-pslot";
        slot.SetProp("style", "left:" + Convert.ToString(left) + "dpx;top:" + Convert.ToString(top) + "dpx");
        Image icon = new Image("");
        icon.Class = "survivor-slot-icon";
        slot.Add(icon);
        Label lv = new Label("");
        lv.Class = "survivor-slot-lv";
        slot.Add(lv);
        this.playLayer.Add(slot);
        if (weapon) {
            this.weaponSlots.Add(slot);
            this.weaponIcons.Add(icon);
            this.weaponLevels.Add(lv);
        } else {
            this.passiveSlots.Add(slot);
            this.passiveIcons.Add(icon);
            this.passiveLevels.Add(lv);
        }
    }

    public void SetGame(SurvivorGame game) { this.game = game; }

    public void SetMeta(string bestText, bool muted) {
        this.best.SetProp("text", bestText);
        this.sound.SetProp("text", muted ? "[M] SOUND OFF" : "[M] SOUND ON");
        this.sound.Class = muted ? "survivor-meta survivor-sound survivor-muted" : "survivor-meta survivor-sound";
    }

    public void ShowHint(bool shown) { this.hint.SetShown(shown); }

    // 标题页只看世界与菜单：对局 HUD 整层收起
    public void ShowPlay(bool shown) { this.playLayer.SetShown(shown); }

    public static string Clock(double seconds) {
        int mins = (int)seconds / 60;
        int secs = (int)seconds % 60;
        return (mins < 10 ? "0" : "") + Convert.ToString(mins) + ":" + (secs < 10 ? "0" : "") + Convert.ToString(secs);
    }

    public void SyncState(Gui.App app, double dt) {
        int w = app.canvas.Width();
        this.viewW = w;
        this.viewH = app.canvas.Height() - app.ContentTop();
        this.level.SetProp("text", "LV " + Convert.ToString(game.level));
        this.kills.SetProp("text", Convert.ToString(game.killCount));
        this.time.SetProp("text", SurvivorHud.Clock(game.gameTime));
        this.experience.SetPercent(game.expToNext > 0 ? game.exp * 100 / game.expToNext : 0);
        // 角色脚下血条
        int px = game.ScreenX(game.playerX, w);
        int py = game.ScreenY(game.playerY, this.viewH);
        this.health.SetShown(!game.dead);
        this.health.SetPercent(game.HpPercent());
        this.health.Class = game.HpPercent() <= 30 ? "survivor-health survivor-health-low" : "survivor-health";
        this.health.SetProp("style", "left:" + Convert.ToString(px - 24) + "dpx;top:" + Convert.ToString(py + 10) + "dpx");
        this.SyncSlots();
        this.SyncBoss();
        this.SyncBanner();
        this.SyncEnemyHealth();
        this.SyncFloating();
        this.cards.Sync(game, dt);
        this.layer.SetBounds(0, app.ContentTop(), app.canvas.Width(), app.canvas.Height() - app.ContentTop());
        this.layer.SetVisible(app.window.GetHandle() == 0 || app.window.IsVisible());
    }

    void SyncSlots() {
        for (int i = 0; i < this.weaponSlots.Count; i = i + 1) {
            bool has = i < game.weaponOrder.Count;
            this.weaponIcons[i].SetShown(has);
            this.weaponLevels[i].SetShown(has);
            if (has) {
                int id = game.weaponOrder[i];
                int lv = game.weaponLv[id];
                if (this.weaponShown[i] != id) { this.weaponShown[i] = id; this.weaponIcons[i].Src = SurvivorIcons.Weapon(id); }
                bool max = lv >= SurvivorData.WeaponMaxLevel(id);
                this.weaponLevels[i].SetProp("text", max ? "MAX" : Convert.ToString(lv));
                this.weaponLevels[i].Class = max ? "survivor-slot-lv survivor-slot-max" : "survivor-slot-lv";
            }
            this.weaponSlots[i].Class = has ? "survivor-slot survivor-wslot" : "survivor-slot survivor-wslot survivor-slot-empty";
        }
        for (int i = 0; i < this.passiveSlots.Count; i = i + 1) {
            bool has = i < game.passiveOrder.Count;
            this.passiveIcons[i].SetShown(has);
            this.passiveLevels[i].SetShown(has);
            if (has) {
                int id = game.passiveOrder[i];
                int lv = game.passiveLv[id];
                if (this.passiveShown[i] != id) { this.passiveShown[i] = id; this.passiveIcons[i].Src = SurvivorIcons.Passive(id); }
                bool max = lv >= SurvivorData.PassiveMaxLevel(id);
                this.passiveLevels[i].SetProp("text", max ? "MAX" : Convert.ToString(lv));
                this.passiveLevels[i].Class = max ? "survivor-slot-lv survivor-slot-max" : "survivor-slot-lv";
            }
            this.passiveSlots[i].Class = has ? "survivor-slot survivor-pslot" : "survivor-slot survivor-pslot survivor-slot-empty";
        }
    }

    void SyncBoss() {
        int bi = game.bossIndex;
        bool shown = bi >= 0 && bi < game.enemies.Count && game.enemies[bi].active;
        this.bossPanel.SetShown(shown);
        if (!shown) { return; }
        Enemy b = game.enemies[bi];
        this.bossName.SetProp("text", SurvivorData.EnemyName(b.kind, b.variant));
        this.bossHealth.SetPercent(b.maxHp > 0 ? b.hp * 100 / b.maxHp : 0);
        this.bossHealth.Class = b.variant == 0 ? "survivor-boss-health" : "survivor-boss-health survivor-boss-abyss";
    }

    void SyncBanner() {
        double t = game.announceTimer;
        bool shown = t > 0.0 && game.announce != "";
        this.banner.SetShown(shown);
        if (!shown) { return; }
        // 进场 0.25 秒放大回弹，最后 0.6 秒淡出
        double age = 2.8 - t;
        double opacity = t < 0.6 ? t / 0.6 : 1.0;
        int fs = age < 0.25 ? 28 + (int)((0.25 - age) * 40.0) : 28;
        this.banner.SetProp("text", game.announce);
        this.banner.SetProp("style", "font-size:" + Convert.ToString(fs) + "dpx;opacity:" + Convert.ToString(opacity));
    }

    void SyncEnemyHealth() {
        // The game retains enemy slots; keep the corresponding controls too.
        while (this.enemyHealth.Count < game.enemies.Count) {
            Progress health = new Progress(100, 1);
            health.Class = "survivor-enemy-health";
            health.showIndicator = false;
            this.healthLayer.Add(health);
            this.enemyHealth.Add(health);
        }
        int w = this.viewW;
        for (int i = 0; i < this.enemyHealth.Count; i = i + 1) {
            Progress health = this.enemyHealth[i];
            // 重开一局后新游戏的槽位可能比控件少：多出的控件隐藏备用
            if (i >= game.enemies.Count) { health.SetShown(false); continue; }
            Enemy enemy = game.enemies[i];
            // 只给耐打的怪（蛮兵、精英）挂血条；首领用顶部大血条
            bool tanky = enemy.kind == SurvivorData.KBrute || enemy.kind == SurvivorData.KElite;
            health.SetShown(enemy.active && tanky && enemy.hp < enemy.maxHp);
            if (!health.visible) { continue; }
            health.SetPercent(enemy.maxHp > 0 ? enemy.hp * 100 / enemy.maxHp : 0);
            int top = (int)(enemy.radius * 2.0) + (enemy.kind == SurvivorData.KElite ? 40 : 30);
            health.SetProp("style", "left:" + Convert.ToString(game.ScreenX(enemy.x, w) - 18)
                + "dpx;top:" + Convert.ToString(game.ScreenY(enemy.y, this.viewH) - top) + "dpx");
        }
    }

    void SyncFloating() {
        for (int i = 0; i < this.floating.Count; i = i + 1) {
            FloatingTextPool.FloatingItem item = game.floatingTexts.items[i];
            Label number = this.floating[i];
            number.SetShown(item.active);
            if (!item.active) { continue; }
            number.SetProp("text", item.DisplayText());
            double progress = item.timer / item.lifetime;
            double opacity = progress > 0.6 ? 1.0 - (progress - 0.6) / 0.4 : 1.0;
            if (opacity < 0.0) { opacity = 0.0; }
            int fs = (int)(17.0 * item.scale);
            if (fs < 11) { fs = 11; }
            string cls = "survivor-floating";
            if (item.isCrit) { cls = "survivor-floating survivor-critical"; }
            else if (item.text.StartsWith("+")) { cls = "survivor-floating survivor-heal"; }
            else if (item.text.StartsWith("-")) { cls = "survivor-floating survivor-hurt"; }
            number.Class = cls;
            number.SetProp("style", "left:" + Convert.ToString(game.ScreenX(item.x, this.viewW) - 60) + "dpx;top:"
                + Convert.ToString(game.ScreenY(item.y, this.viewH) - 12) + "dpx;font-size:" + Convert.ToString(fs)
                + "dpx;opacity:" + Convert.ToString(opacity));
        }
    }

    public void Render(Gui.App app) {
        this.layer.Paint(app);
    }

    public void Stop() {
        this.layer.SetVisible(false);
        this.layer.Clear();
    }

    public static string Css() {
        return ".survivor-hud,.survivor-play{position:absolute;left:0;top:0;width:1280dpx;height:100%;background:transparent;padding:0;border:0}"
            + ".survivor-health-layer{position:absolute;left:0;top:0;width:100%;height:100%;background:transparent;padding:0;border:0}"
            + ".survivor-play label{position:absolute;padding:0;margin:0;border:0;background:transparent;vertical-align:top}"
            + ".survivor-time{left:540dpx;top:16dpx;width:200dpx;height:40dpx;font-size:32dpx;font-weight:bold;"
            + "text-align:center;color:#f4f1e6;text-shadow:0 2 0 rgba(0,0,0,0.85)}"
            + ".survivor-level{left:1080dpx;top:18dpx;width:184dpx;height:28dpx;font-size:22dpx;font-weight:bold;"
            + "text-align:right;color:#ffc53d;text-shadow:0 2 0 rgba(0,0,0,0.85)}"
            + "image.survivor-kill-icon{position:absolute;left:1166dpx;top:52dpx;width:20dpx;height:20dpx;padding:0;border:0;background:transparent}"
            + ".survivor-kills{left:1192dpx;top:50dpx;width:72dpx;height:24dpx;font-size:18dpx;font-weight:bold;text-align:right;"
            + "color:#e8e2cf;text-shadow:0 2 0 rgba(0,0,0,0.85)}"
            + "progress.survivor-experience{position:absolute;left:0;top:0;width:1280dpx;height:12dpx;padding:0;margin:0;"
            + "border:0;border-radius:0;background:transparent;gap:0}"
            + ".survivor-experience .progress-track{height:12dpx;background:#0d1512;border-radius:0;border-bottom:2 #10140f}"
            + ".survivor-experience .progress-fill{height:100%;background:linear-gradient(90deg,#2a9d8f,#5ff5e2);border-radius:0}"
            // 图标格：深色铁框 + 琥珀描边；空格虚化
            + ".survivor-slot{position:absolute;padding:0;margin:0;background:rgba(16,20,15,0.82);"
            + "border:2 #6b5a2e;border-radius:6dpx;box-shadow:0 2 0 rgba(0,0,0,0.6)}"
            + ".survivor-wslot{width:46dpx;height:46dpx}"
            + ".survivor-pslot{width:34dpx;height:34dpx;border-color:#2f6f66}"
            + ".survivor-slot-empty{background:rgba(16,20,15,0.66);border-color:rgba(107,90,46,0.45)}"
            + ".survivor-pslot.survivor-slot-empty{border-color:rgba(47,111,102,0.45)}"
            + "image.survivor-slot-icon{position:absolute;left:3dpx;top:3dpx;width:36dpx;height:36dpx;padding:0;border:0;background:transparent}"
            + ".survivor-pslot image.survivor-slot-icon{left:3dpx;top:3dpx;width:24dpx;height:24dpx}"
            + ".survivor-slot label.survivor-slot-lv{position:absolute;left:20dpx;top:28dpx;width:24dpx;height:16dpx;"
            + "font-size:12dpx;font-weight:bold;text-align:right;color:#fff4d0;text-shadow:0 1 0 #000}"
            + ".survivor-pslot label.survivor-slot-lv{left:6dpx;top:18dpx;width:26dpx;height:14dpx;font-size:11dpx}"
            + ".survivor-slot label.survivor-slot-max{color:#ffc53d}"
            // 首领血条
            + ".survivor-boss{position:absolute;left:340dpx;top:60dpx;width:600dpx;height:44dpx;padding:0;border:0;background:transparent}"
            + ".survivor-boss label.survivor-boss-name{left:0;top:0;width:600dpx;height:20dpx;font-size:15dpx;font-weight:bold;"
            + "letter-spacing:3dpx;text-align:center;color:#ffb4a8;text-shadow:0 2 0 #000}"
            + "progress.survivor-boss-health{position:absolute;left:0;top:22dpx;width:600dpx;height:14dpx;padding:0;margin:0;"
            + "border:2 #10140f;border-radius:3dpx;background:transparent;gap:0}"
            + ".survivor-boss-health .progress-track{height:14dpx;background:#2a1214;border-radius:2dpx}"
            + ".survivor-boss-health .progress-fill{height:100%;background:linear-gradient(90deg,#b3261e,#ff6a3d);border-radius:2dpx}"
            + ".survivor-boss-abyss .progress-fill{background:linear-gradient(90deg,#5b2bb5,#d36bff)}"
            + ".survivor-play label.survivor-banner{left:240dpx;top:116dpx;width:800dpx;height:48dpx;font-size:28dpx;font-weight:bold;"
            + "letter-spacing:2dpx;text-align:center;vertical-align:middle;color:#ffc53d;text-shadow:0 3 0 rgba(0,0,0,0.9);"
            + "background:linear-gradient(90deg,rgba(10,13,11,0),rgba(10,13,11,0.78),rgba(10,13,11,0));"
            + "border-top:1 rgba(255,197,61,0.5);border-bottom:1 rgba(255,197,61,0.5)}"
            + ".survivor-meta{height:20dpx;font-size:13dpx;color:#7d8a83}"
            + ".survivor-best{left:16dpx;top:118dpx;width:600dpx;text-align:left}"
            + ".survivor-sound{left:1060dpx;top:78dpx;width:204dpx;text-align:right;color:#3fd1c4}"
            + ".survivor-muted{color:#ff6b6b}"
            + ".survivor-hint{left:190dpx;bottom:24dpx;width:900dpx;height:34dpx;font-size:16dpx;"
            + "text-align:center;color:#ffe9b0;background:rgba(16,20,15,0.82);border:1 #6b5a2e;border-radius:6dpx}"
            // 角色脚下血条与怪物血条
            + "progress.survivor-health{position:absolute;width:48dpx;height:7dpx;padding:0;margin:0;"
            + "border:1 #10140f;border-radius:2dpx;background:transparent;gap:0}"
            + ".survivor-health .progress-track{height:7dpx;background:#3a1f24;border-radius:2dpx}"
            + ".survivor-health .progress-fill{height:100%;background:#6ee06a;border-radius:2dpx}"
            + ".survivor-health-low .progress-fill{background:#ff4d4f}"
            + "progress.survivor-enemy-health{position:absolute;width:36dpx;height:5dpx;padding:0;margin:0;"
            + "border:1 #10140f;border-radius:0;background:transparent;gap:0}"
            + ".survivor-enemy-health .progress-track{height:5dpx;background:#2a1214;border-radius:0}"
            + ".survivor-enemy-health .progress-fill{height:100%;background:#ff6a3d;border-radius:0}"
            // 伤害跳字
            + ".survivor-play label.survivor-floating{width:120dpx;height:40dpx;font-size:17dpx;font-weight:bold;text-align:center;"
            + "color:#ffffff;text-shadow:0 2 0 rgba(0,0,0,0.9)}"
            + ".survivor-play label.survivor-critical{color:#ffd54f}"
            + ".survivor-play label.survivor-heal{color:#6ee06a}"
            + ".survivor-play label.survivor-hurt{color:#ff5252}";
    }
}
