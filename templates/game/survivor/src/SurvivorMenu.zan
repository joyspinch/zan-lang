using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Survivor;

// 标题 / 暂停 / 结算三张面板共用一块游戏风格的卡片：标准 Label + Button，
// 外观全部由下方 CSS 皮肤决定（深色铁框 + 琥珀/青色强调，与 HUD 状态栏同一套色）。
// 每种面板一组固定按钮，切换面板只改显隐与文字，控件常驻不重建。
public class SurvivorMenu {
    public const int ModeNone = 0;
    public const int ModeTitle = 1;
    public const int ModePause = 2;
    public const int ModeResults = 3;

    public Panel root;
    public Label title;
    public List<Label> lines;
    public Button start;
    public Button quitGame;
    public Button resume;
    public Button restart;
    public Button quitRun;
    public Button again;
    public Button menu;
    public int mode;
    Panel card;

    public SurvivorMenu() {
        this.root = new Panel("survivor-overlay");
        this.root.Class = "survivor-overlay";
        this.card = new Panel("survivor-card");
        this.card.Class = "survivor-card";
        this.root.Add(this.card);
        this.title = new Label("");
        this.title.Class = "survivor-ov-title";
        this.card.Add(this.title);
        this.lines = new List<Label>();
        for (int i = 0; i < 7; i = i + 1) {
            Label line = new Label("");
            line.Class = "survivor-ov-line";
            line.SetProp("style", "top:" + Convert.ToString(100 + i * 36) + "dpx");
            this.card.Add(line);
            this.lines.Add(line);
        }
        this.start = this.MakeButton("START  [ENTER]", true, 30, 220);
        this.quitGame = this.MakeButton("QUIT", false, 270, 220);
        this.resume = this.MakeButton("RESUME  [P]", true, 20, 150);
        this.restart = this.MakeButton("RESTART  [R]", false, 185, 150);
        this.quitRun = this.MakeButton("QUIT  [Q]", false, 350, 150);
        this.again = this.MakeButton("PLAY AGAIN  [ENTER]", true, 30, 220);
        this.menu = this.MakeButton("MENU  [ESC]", false, 270, 220);
        this.mode = SurvivorMenu.ModeNone;
        this.root.SetShown(false);
    }

    Button MakeButton(string text, bool primary, int left, int width) {
        Button b = new Button(text);
        b.Class = primary ? "survivor-btn survivor-btn-main" : "survivor-btn";
        b.SetProp("style", "left:" + Convert.ToString(left) + "dpx;width:" + Convert.ToString(width) + "dpx");
        this.card.Add(b);
        return b;
    }

    // 切换面板：title 为卡片标题，texts/kinds 逐行（kind: "" 普通、"accent" 琥珀、
    // "key" 青色、"alert" 红色、"dim" 灰色），多出的行隐藏。
    public void Show(int mode, string heading, bool alertHeading, string[] texts, string[] kinds) {
        this.mode = mode;
        this.title.SetProp("text", heading);
        this.title.Class = alertHeading ? "survivor-ov-title survivor-ov-title-alert" : "survivor-ov-title";
        for (int i = 0; i < this.lines.Count; i = i + 1) {
            Label line = this.lines[i];
            bool has = texts != null && i < texts.Length && texts[i] != "";
            line.SetShown(has);
            if (!has) { continue; }
            line.SetProp("text", texts[i]);
            string kind = kinds != null && i < kinds.Length ? kinds[i] : "";
            line.Class = kind == "" ? "survivor-ov-line" : "survivor-ov-line survivor-ov-" + kind;
        }
        this.start.SetShown(mode == SurvivorMenu.ModeTitle);
        this.quitGame.SetShown(mode == SurvivorMenu.ModeTitle);
        this.resume.SetShown(mode == SurvivorMenu.ModePause);
        this.restart.SetShown(mode == SurvivorMenu.ModePause);
        this.quitRun.SetShown(mode == SurvivorMenu.ModePause);
        this.again.SetShown(mode == SurvivorMenu.ModeResults);
        this.menu.SetShown(mode == SurvivorMenu.ModeResults);
        this.root.SetShown(true);
    }

    // 收起面板并释放按钮焦点：隐藏的按钮不能再吃掉对局里的空格/回车。
    public void Hide() {
        this.mode = SurvivorMenu.ModeNone;
        this.start.Blur();
        this.quitGame.Blur();
        this.resume.Blur();
        this.restart.Blur();
        this.quitRun.Blur();
        this.again.Blur();
        this.menu.Blur();
        this.root.SetShown(false);
    }

    public bool Visible() { return this.mode != SurvivorMenu.ModeNone; }

    public static string Css() {
        return ".survivor-overlay{position:absolute;left:0;top:0;width:1280dpx;height:720dpx;"
            + "background:rgba(6,6,12,0.72);padding:0;border:0}"
            + ".survivor-card{position:absolute;left:380dpx;top:110dpx;width:520dpx;height:490dpx;"
            + "background:#1b1b29;border:3 #ffc53d;border-radius:0;padding:0;"
            + "box-shadow:0 0 24 rgba(255,197,61,0.35)}"
            + ".survivor-ov-title,.survivor-ov-line{position:absolute;left:0;width:520dpx;padding:0;margin:0;"
            + "border:0;background:transparent;text-align:center;vertical-align:top}"
            + ".survivor-ov-title{top:26dpx;height:56dpx;font-size:42dpx;color:#ffc53d}"
            + ".survivor-ov-title-alert{color:#ff4d4f}"
            + ".survivor-ov-line{height:30dpx;font-size:19dpx;color:#e8e8f0}"
            + ".survivor-ov-accent{color:#ffc53d}"
            + ".survivor-ov-key{color:#00e5ff}"
            + ".survivor-ov-alert{color:#ff4d4f}"
            + ".survivor-ov-dim{color:#8c8ca6}"
            + "button.survivor-btn{position:absolute;top:410dpx;height:50dpx;font-size:17dpx;"
            + "background:#26263a;color:#e8e8f0;border:2 #00e5ff;border-radius:0;box-shadow:none}"
            + "button.survivor-btn:hover{background:#30304a;border-color:#7ff3ff;color:#ffffff}"
            + "button.survivor-btn:active{background:#14141e;border-color:#00e5ff}"
            + "button.survivor-btn:focus{border-color:#ffffff;box-shadow:0 0 8 rgba(0,229,255,0.6)}"
            + "button.survivor-btn-main{background:#ffc53d;color:#14141e;border:2 #ffc53d}"
            + "button.survivor-btn-main:hover{background:#ffd666;border-color:#ffe58f;color:#14141e}"
            + "button.survivor-btn-main:active{background:#d99a1a;border-color:#d99a1a}"
            + "button.survivor-btn-main:focus{border-color:#ffffff;box-shadow:0 0 8 rgba(255,197,61,0.7)}";
    }
}
