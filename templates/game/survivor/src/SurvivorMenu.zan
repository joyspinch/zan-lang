using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;

namespace Survivor;

// 标题 / 暂停 / 结算三张面板共用一块游戏风格的卡片：标准 Label + Button + Image，
// 外观全部由下方 CSS 皮肤决定（苔石深底 + 琥珀铁框 + 青色强调，与 HUD、升级卡同一套色）。
// 标题页带选角（锁定的角色按钮禁用并写明解锁条件）；暂停页列出当前构筑；结算页列出用过的武器与伤害。
public class SurvivorMenu {
    public const int ModeNone = 0;
    public const int ModeTitle = 1;
    public const int ModePause = 2;
    public const int ModeResults = 3;

    public Panel root;
    public Label title;
    public List<Label> lines;
    public Button start;
    public Button quitGame;
    public Button resume;
    public Button restart;
    public Button quitRun;
    public Button again;
    public Button menu;
    public List<Button> heroButtons;
    public int mode;
    public int heroClicked;
    Panel card;
    Label heroHeader;
    List<Panel> heroFaces;
    List<Image> heroIcons;
    List<Label> heroNames;
    List<Label> heroBlurbs;
    List<Label> heroLocks;
    Label buildHeader;
    List<Panel> buildSlots;
    List<Image> buildIcons;
    List<Label> buildLevels;
    List<Label> buildNames;
    List<Label> buildDamage;

    public SurvivorMenu() {
        this.root = new Panel("survivor-overlay");
        this.root.Class = "survivor-overlay";
        this.card = new Panel("survivor-card");
        this.card.Class = "survivor-card";
        this.root.Add(this.card);
        this.title = new Label("");
        this.title.Class = "survivor-ov-title";
        this.card.Add(this.title);
        this.lines = new List<Label>();
        for (int i = 0; i < 8; i = i + 1) {
            Label line = new Label("");
            line.Class = "survivor-ov-line";
            this.card.Add(line);
            this.lines.Add(line);
        }
        // 选角
        this.heroHeader = new Label("CHOOSE YOUR HERO");
        this.heroHeader.Class = "survivor-ov-header";
        this.heroHeader.SetProp("style", "top:196dpx");
        this.card.Add(this.heroHeader);
        this.heroFaces = new List<Panel>();
        this.heroIcons = new List<Image>();
        this.heroNames = new List<Label>();
        this.heroBlurbs = new List<Label>();
        this.heroLocks = new List<Label>();
        this.heroButtons = new List<Button>();
        for (int i = 0; i < SurvivorData.CharacterCount; i = i + 1) { this.MakeHero(i); }
        this.heroClicked = -1;
        // 构筑（暂停）/ 用过的武器（结算）
        this.buildHeader = new Label("");
        this.buildHeader.Class = "survivor-ov-header";
        this.card.Add(this.buildHeader);
        this.buildSlots = new List<Panel>();
        this.buildIcons = new List<Image>();
        this.buildLevels = new List<Label>();
        this.buildNames = new List<Label>();
        this.buildDamage = new List<Label>();
        for (int i = 0; i < 8; i = i + 1) {
            Panel slot = new Panel("survivor-build-slot");
            slot.Class = "survivor-build-slot";
            Image icon = new Image("");
            icon.Class = "survivor-build-icon";
            slot.Add(icon);
            Label lv = new Label("");
            lv.Class = "survivor-build-lv";
            slot.Add(lv);
            this.card.Add(slot);
            Label name = new Label("");
            name.Class = "survivor-build-name";
            this.card.Add(name);
            Label dmg = new Label("");
            dmg.Class = "survivor-build-dmg";
            this.card.Add(dmg);
            this.buildSlots.Add(slot);
            this.buildIcons.Add(icon);
            this.buildLevels.Add(lv);
            this.buildNames.Add(name);
            this.buildDamage.Add(dmg);
        }
        this.start = this.MakeButton("START  [ENTER]", true, 150, 220);
        this.quitGame = this.MakeButton("QUIT", false, 390, 220);
        this.resume = this.MakeButton("RESUME  [P]", true, 60, 200);
        this.restart = this.MakeButton("RESTART  [R]", false, 280, 200);
        this.quitRun = this.MakeButton("QUIT  [Q]", false, 500, 200);
        this.again = this.MakeButton("PLAY AGAIN  [ENTER]", true, 150, 220);
        this.menu = this.MakeButton("MENU  [ESC]", false, 390, 220);
        this.mode = SurvivorMenu.ModeNone;
        this.root.SetShown(false);
    }

    void MakeHero(int i) {
        Panel face = new Panel("survivor-hero");
        face.Class = "survivor-hero";
        face.SetProp("style", "left:" + Convert.ToString(40 + i * 232) + "dpx");
        Image icon = new Image(SurvivorIcons.Character(i));
        icon.Class = "survivor-hero-icon";
        face.Add(icon);
        Label name = new Label(SurvivorData.CharacterName(i));
        name.Class = "survivor-hero-name";
        face.Add(name);
        Label blurb = new Label(SurvivorData.CharacterBlurb(i));
        blurb.Class = "survivor-hero-blurb";
        blurb.wrap = true;
        face.Add(blurb);
        Label lockText = new Label("");
        lockText.Class = "survivor-hero-lock";
        face.Add(lockText);
        Button hit = new Button("");
        hit.Class = "survivor-hero-hit";
        int idx = i;
        hit.OnClick(() => { this.heroClicked = idx; });
        face.Add(hit);
        this.card.Add(face);
        this.heroFaces.Add(face);
        this.heroIcons.Add(icon);
        this.heroNames.Add(name);
        this.heroBlurbs.Add(blurb);
        this.heroLocks.Add(lockText);
        this.heroButtons.Add(hit);
    }

    Button MakeButton(string text, bool primary, int left, int width) {
        Button b = new Button(text);
        b.Class = primary ? "survivor-btn survivor-btn-main" : "survivor-btn";
        SurvivorMenu.Place(b, left, width, 520);
        this.card.Add(b);
        return b;
    }

    static void Place(Button b, int left, int width, int top) {
        b.SetProp("style", "left:" + Convert.ToString(left) + "dpx;width:" + Convert.ToString(width) + "dpx;top:"
            + Convert.ToString(top) + "dpx");
    }

    // 切换面板：texts/kinds/tops 逐行（kind: "" 普通、"accent" 琥珀、"key" 青色、"alert" 红色、"dim" 灰色、
    // "big" 大号），多出的行隐藏
    public void Show(int mode, string heading, bool alertHeading, string[] texts, string[] kinds, int[] tops) {
        this.mode = mode;
        this.title.SetProp("text", heading);
        this.title.Class = alertHeading ? "survivor-ov-title survivor-ov-title-alert" : "survivor-ov-title";
        for (int i = 0; i < this.lines.Count; i = i + 1) {
            Label line = this.lines[i];
            bool has = texts != null && i < texts.Length && texts[i] != "";
            line.SetShown(has);
            if (!has) { continue; }
            line.SetProp("text", texts[i]);
            string kind = kinds != null && i < kinds.Length ? kinds[i] : "";
            line.Class = kind == "" ? "survivor-ov-line" : "survivor-ov-line survivor-ov-" + kind;
            int top = tops != null && i < tops.Length ? tops[i] : 100 + i * 30;
            line.SetProp("style", "top:" + Convert.ToString(top) + "dpx");
        }
        bool titleMode = mode == SurvivorMenu.ModeTitle;
        // 暂停面板矮一些（没有选角/武器统计），按钮跟着上移
        bool pause = mode == SurvivorMenu.ModePause;
        this.card.SetProp("style", pause ? "top:120dpx;height:440dpx" : "top:40dpx;height:600dpx");
        int by = pause ? 360 : 520;
        SurvivorMenu.Place(this.resume, 60, 200, by);
        SurvivorMenu.Place(this.restart, 280, 200, by);
        SurvivorMenu.Place(this.quitRun, 500, 200, by);
        this.heroHeader.SetShown(titleMode);
        for (int i = 0; i < this.heroFaces.Count; i = i + 1) { this.heroFaces[i].SetShown(titleMode); }
        if (titleMode) { this.HideBuild(); }
        this.start.SetShown(titleMode);
        this.quitGame.SetShown(titleMode);
        this.resume.SetShown(mode == SurvivorMenu.ModePause);
        this.restart.SetShown(mode == SurvivorMenu.ModePause);
        this.quitRun.SetShown(mode == SurvivorMenu.ModePause);
        this.again.SetShown(mode == SurvivorMenu.ModeResults);
        this.menu.SetShown(mode == SurvivorMenu.ModeResults);
        this.root.SetShown(true);
    }

    // 选角状态：selected = 当前角色；unlockSeconds[i] > best 的锁住
    public void SetHeroes(int selected, long bestSeconds) {
        for (int i = 0; i < this.heroFaces.Count; i = i + 1) {
            int need = SurvivorData.CharacterUnlockSeconds(i);
            bool locked = bestSeconds < (long)need;
            this.heroButtons[i].Disabled = locked;
            this.heroIcons[i].Src = locked ? SurvivorIcons.Lock() : SurvivorIcons.Character(i);
            this.heroNames[i].SetProp("text", locked ? "LOCKED" : SurvivorData.CharacterName(i));
            this.heroBlurbs[i].SetProp("text", locked ? "Survive " + SurvivorHud.Clock((double)need) + " in a single run to unlock "
                + SurvivorData.CharacterName(i) + "." : SurvivorData.CharacterBlurb(i));
            this.heroLocks[i].SetProp("text", locked ? "" : (i == selected ? "SELECTED" : "[" + Convert.ToString(i + 1) + "]"));
            string cls = "survivor-hero";
            if (locked) { cls = cls + " survivor-hero-locked"; }
            else if (i == selected) { cls = cls + " survivor-hero-sel"; }
            this.heroFaces[i].Class = cls;
            this.heroLocks[i].Class = i == selected ? "survivor-hero-lock survivor-hero-on" : "survivor-hero-lock";
        }
    }

    public int TakeHeroClick() {
        int c = this.heroClicked;
        this.heroClicked = -1;
        return c;
    }

    void HideBuild() {
        this.buildHeader.SetShown(false);
        for (int i = 0; i < this.buildSlots.Count; i = i + 1) {
            this.buildSlots[i].SetShown(false);
            this.buildNames[i].SetShown(false);
            this.buildDamage[i].SetShown(false);
        }
    }

    // detailed = 结算（只列武器：名字 + 等级 + 总伤害）；否则暂停（武器 + 被动的小图标行）
    public void ShowBuild(SurvivorGame game, bool detailed, int top) {
        this.HideBuild();
        this.buildHeader.SetShown(true);
        this.buildHeader.SetProp("text", detailed ? "WEAPONS USED" : "CURRENT BUILD");
        this.buildHeader.SetProp("style", "top:" + Convert.ToString(top) + "dpx");
        List<int> codes = new List<int>();
        for (int i = 0; i < game.weaponOrder.Count; i = i + 1) { codes.Add(game.weaponOrder[i]); }
        if (!detailed) {
            for (int i = 0; i < game.passiveOrder.Count; i = i + 1) { codes.Add(10 + game.passiveOrder[i]); }
        }
        int n = codes.Count;
        int pitch = detailed ? 170 : 64;
        int size = detailed ? 56 : 50;
        int left0 = detailed ? (760 - n * pitch) / 2 : (760 - (n * pitch - (pitch - size))) / 2;
        for (int i = 0; i < n && i < this.buildSlots.Count; i = i + 1) {
            int code = codes[i];
            bool weapon = code < 10;
            int lv = weapon ? game.weaponLv[code] : game.passiveLv[code - 10];
            int max = weapon ? SurvivorData.WeaponMaxLevel(code) : SurvivorData.PassiveMaxLevel(code - 10);
            int col = left0 + i * pitch;
            int x = detailed ? col + (pitch - size) / 2 : col;
            Panel slot = this.buildSlots[i];
            slot.SetShown(true);
            slot.Class = weapon ? "survivor-build-slot" : "survivor-build-slot survivor-build-passive";
            slot.SetProp("style", "left:" + Convert.ToString(x) + "dpx;top:" + Convert.ToString(top + 28) + "dpx;width:"
                + Convert.ToString(size) + "dpx;height:" + Convert.ToString(size) + "dpx");
            this.buildIcons[i].Src = SurvivorIcons.Option(code);
            this.buildIcons[i].SetProp("style", "width:" + Convert.ToString(size - 10) + "dpx;height:" + Convert.ToString(size - 10) + "dpx");
            this.buildLevels[i].SetProp("text", lv >= max ? "MAX" : Convert.ToString(lv));
            this.buildLevels[i].SetProp("style", "left:" + Convert.ToString(size - 32) + "dpx;top:" + Convert.ToString(size - 20) + "dpx");
            if (detailed) {
                this.buildNames[i].SetShown(true);
                this.buildNames[i].SetProp("text", SurvivorData.WeaponName(code));
                this.buildNames[i].SetProp("style", "left:" + Convert.ToString(col) + "dpx;top:" + Convert.ToString(top + 90) + "dpx");
                this.buildDamage[i].SetShown(true);
                this.buildDamage[i].SetProp("text", SurvivorMenu.Thousands(game.weaponDamage[code]) + " dmg");
                this.buildDamage[i].SetProp("style", "left:" + Convert.ToString(col) + "dpx;top:" + Convert.ToString(top + 114) + "dpx");
            }
        }
    }

    public static string Thousands(int v) {
        string s = Convert.ToString(v);
        string o = "";
        int n = s.Length;
        for (int i = 0; i < n; i = i + 1) {
            o = o + s.Substring(i, 1);
            int rest = n - i - 1;
            if (rest > 0 && rest % 3 == 0) { o = o + ","; }
        }
        return o;
    }

    // 收起面板并释放按钮焦点：隐藏的按钮不能再吃掉对局里的空格/回车。
    public void Hide() {
        this.mode = SurvivorMenu.ModeNone;
        this.start.Blur();
        this.quitGame.Blur();
        this.resume.Blur();
        this.restart.Blur();
        this.quitRun.Blur();
        this.again.Blur();
        this.menu.Blur();
        for (int i = 0; i < this.heroButtons.Count; i = i + 1) { this.heroButtons[i].Blur(); }
        this.root.SetShown(false);
    }

    public bool Visible() { return this.mode != SurvivorMenu.ModeNone; }

    public static string Css() {
        return ".survivor-overlay{position:absolute;left:0;top:0;width:1280dpx;height:100%;"
            + "background:rgba(5,8,7,0.62);padding:0;border:0}"
            + ".survivor-card{position:absolute;left:260dpx;top:40dpx;width:760dpx;height:600dpx;"
            + "background:linear-gradient(180deg,#232c27,#141a17);border:3 #c9a23a;border-radius:12dpx;padding:0;"
            + "box-shadow:0 10 0 rgba(0,0,0,0.55)}"
            + ".survivor-ov-title,.survivor-ov-line,.survivor-ov-header,.survivor-hero-name,.survivor-hero-blurb,.survivor-hero-lock,"
            + ".survivor-build-lv,.survivor-build-name,.survivor-build-dmg{position:absolute;padding:0;margin:0;border:0;"
            + "background:transparent;vertical-align:top}"
            + ".survivor-ov-title,.survivor-ov-line,.survivor-ov-header{left:0;width:760dpx;text-align:center}"
            + ".survivor-ov-title{top:22dpx;height:66dpx;font-size:56dpx;font-weight:bold;letter-spacing:6dpx;color:#ffc53d;"
            + "text-shadow:0 4 0 #5a3a00}"
            + ".survivor-ov-title-alert{color:#ff6b5b;text-shadow:0 4 0 #4a0e08}"
            + ".survivor-ov-line{height:28dpx;font-size:18dpx;color:#e3e8e4}"
            + ".survivor-ov-header{height:20dpx;font-size:13dpx;font-weight:bold;letter-spacing:4dpx;color:#7f938a}"
            + ".survivor-ov-accent{color:#ffc53d}"
            + ".survivor-ov-key{color:#5ff5e2}"
            + ".survivor-ov-alert{color:#ff6b5b;font-weight:bold}"
            + ".survivor-ov-dim{color:#7f938a;font-size:15dpx}"
            + ".survivor-ov-big{height:44dpx;font-size:34dpx;font-weight:bold;color:#f4f1e6;text-shadow:0 3 0 #000}"
            // 选角卡
            + ".survivor-hero{position:absolute;top:222dpx;width:216dpx;height:176dpx;padding:0;"
            + "background:rgba(10,14,12,0.7);border:2 #3d4a43;border-radius:10dpx}"
            + ".survivor-hero-sel{border:3 #ffc53d;background:#2a2a1e;box-shadow:0 0 16 rgba(255,197,61,0.4)}"
            + ".survivor-hero-locked{background:rgba(10,14,12,0.45);border:2 #2a322e}"
            + "image.survivor-hero-icon{position:absolute;left:76dpx;top:10dpx;width:64dpx;height:64dpx;padding:0;border:0;background:transparent}"
            + ".survivor-hero label.survivor-hero-name{left:0;top:78dpx;width:216dpx;height:26dpx;font-size:20dpx;font-weight:bold;"
            + "letter-spacing:3dpx;text-align:center;color:#f4f1e6}"
            + ".survivor-hero-locked label.survivor-hero-name{color:#6b7570}"
            + ".survivor-hero label.survivor-hero-blurb{left:14dpx;top:106dpx;width:188dpx;height:40dpx;font-size:13dpx;"
            + "line-height:18dpx;text-align:center;color:#a9b8b0}"
            + ".survivor-hero-locked label.survivor-hero-blurb{color:#8a7f6a}"
            + ".survivor-hero label.survivor-hero-lock{left:0;top:150dpx;width:216dpx;height:18dpx;font-size:12dpx;font-weight:bold;"
            + "letter-spacing:2dpx;text-align:center;color:#6f7d76}"
            + ".survivor-hero label.survivor-hero-on{color:#ffc53d}"
            + "button.survivor-hero-hit{position:absolute;left:0;top:0;width:216dpx;height:176dpx;padding:0;margin:0;"
            + "background:transparent;border:0;border-radius:8dpx;box-shadow:none;color:transparent}"
            + "button.survivor-hero-hit:hover{background:rgba(255,255,255,0.05);border:2 rgba(255,226,122,0.8)}"
            + "button.survivor-hero-hit:active{background:rgba(0,0,0,0.25)}"
            + "button.survivor-hero-hit:focus{border:2 #ffffff}"
            + "button.survivor-hero-hit:disabled{background:transparent;border:0}"
            // 构筑 / 武器格
            + ".survivor-build-slot{position:absolute;padding:0;background:rgba(10,14,12,0.8);border:2 #6b5a2e;border-radius:8dpx}"
            + ".survivor-build-passive{border-color:#2f6f66}"
            + "image.survivor-build-icon{position:absolute;left:3dpx;top:3dpx;padding:0;border:0;background:transparent}"
            + ".survivor-build-slot label.survivor-build-lv{position:absolute;width:26dpx;height:16dpx;font-size:12dpx;font-weight:bold;"
            + "text-align:right;color:#fff4d0;text-shadow:0 1 0 #000}"
            + ".survivor-card label.survivor-build-name{width:170dpx;height:22dpx;font-size:15dpx;font-weight:bold;text-align:center;color:#e3e8e4}"
            + ".survivor-card label.survivor-build-dmg{width:170dpx;height:20dpx;font-size:14dpx;text-align:center;color:#ffc53d}"
            // 按钮
            + "button.survivor-btn{position:absolute;top:520dpx;height:52dpx;padding:0;font-size:17dpx;font-weight:bold;letter-spacing:1dpx;text-align:center;"
            + "background:#1d2622;color:#e3e8e4;border:2 #3fd1c4;border-radius:8dpx;box-shadow:0 4 0 #0a0d0c}"
            + "button.survivor-btn:hover{background:#26332d;border-color:#7ff3e6;color:#ffffff}"
            + "button.survivor-btn:active{background:#121815;border-color:#3fd1c4;box-shadow:none}"
            + "button.survivor-btn:focus{border-color:#ffffff;box-shadow:0 0 10 rgba(63,209,196,0.6)}"
            + "button.survivor-btn-main{background:#ffc53d;color:#1a1408;border:2 #ffe08a;box-shadow:0 4 0 #8a5d00}"
            + "button.survivor-btn-main:hover{background:#ffd666;border-color:#fff1c2;color:#1a1408}"
            + "button.survivor-btn-main:active{background:#d99a1a;border-color:#d99a1a;box-shadow:none}"
            + "button.survivor-btn-main:focus{border-color:#ffffff;box-shadow:0 0 10 rgba(255,197,61,0.7)}";
    }
}
