using System;
using Gui;
using Game.Foundation.Gui;
using Game.Kit;
using Survivor;

public class SurvivorLoop : IGuiHostLoop {
    public SurvivorGame game;

    public void Start(GuiHost host) {
        this.game = SurvivorGame.Create();
    }

    public void Event(GuiHost host, int kind, int code) {
        if (kind == 4) { // KeyDown
            if (code == 27) { // ESC
                host.App().isRunning = false;
            } else {
                this.game.OnKeyDown(code);
            }
        } else if (kind == 5) { // KeyUp
            this.game.OnKeyUp(code);
        }
    }

    public void FixedUpdate(GuiHost host, int dt) {
        this.game.Tick((double)dt / 1000.0);
    }

    public void Update(GuiHost host, int dt) { }

    public void Render(GuiHost host, Canvas c, double alpha) {
        this.game.Render(c);
    }

    public void Stop(GuiHost host) { }
}

public class App {
    public static void Main() {
        GuiHost host = new GuiHost("Survivor Roguelite - Zan Game", 1280, 720, 60);
        host.Run(new SurvivorLoop());
    }
}
