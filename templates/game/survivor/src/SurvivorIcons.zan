using System;

namespace Survivor;

// 矢量图标（SVG data URI，交给标准 Image 控件显示）：武器、被动、角色头像、计数小图标。
// 与世界绘制同一套色板：琥珀 #ffc53d、青 #3fd1c4、深底 #10140f 描边。
public class SurvivorIcons {
    static string Svg(string body) {
        return "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='64' height='64' viewBox='0 0 64 64'>"
            + body + "</svg>";
    }

    public static string Option(int code) {
        if (code >= 0 && code < 10) { return SurvivorIcons.Weapon(code); }
        if (code >= 10 && code < 20) { return SurvivorIcons.Passive(code - 10); }
        return SurvivorIcons.Potion();
    }

    public static string Weapon(int id) {
        if (id == SurvivorData.WBolt) {
            return SurvivorIcons.Svg("<path d='M8 44 L36 26 L40 32 Z' fill='#ffb300' opacity='0.55'/>"
                + "<path d='M4 52 L34 30 L36 34 Z' fill='#ffd54f' opacity='0.4'/>"
                + "<circle cx='42' cy='24' r='15' fill='#ffd54f' opacity='0.35'/>"
                + "<circle cx='42' cy='24' r='10' fill='#10140f'/>"
                + "<circle cx='42' cy='24' r='8' fill='#ffd54f'/>"
                + "<circle cx='39' cy='21' r='3.5' fill='#ffffff'/>");
        }
        if (id == SurvivorData.WBlades) {
            return SurvivorIcons.Svg("<circle cx='32' cy='32' r='20' fill='none' stroke='#b8e0ff' stroke-width='2' opacity='0.5'/>"
                + "<path d='M32 4 C44 8 48 16 46 22 C42 16 36 12 28 12 Z' fill='#10140f'/>"
                + "<path d='M32 6 C42 9 46 15 45 20 C41 15 36 12 29 12 Z' fill='#dff1ff'/>"
                + "<path d='M60 38 C54 50 46 54 40 52 C46 48 50 42 50 34 Z' fill='#10140f'/>"
                + "<path d='M58 38 C53 48 46 52 41 51 C46 47 50 42 50 35 Z' fill='#b8e0ff'/>"
                + "<path d='M10 50 C4 38 6 28 12 24 C12 30 14 38 20 44 Z' fill='#10140f'/>"
                + "<path d='M11 48 C6 38 7 30 12 26 C12 32 15 38 20 43 Z' fill='#8fb8dd'/>"
                + "<circle cx='32' cy='32' r='6' fill='#2a9d8f'/>");
        }
        if (id == SurvivorData.WAura) {
            return SurvivorIcons.Svg("<circle cx='32' cy='32' r='28' fill='#fff1a8' opacity='0.18'/>"
                + "<circle cx='32' cy='32' r='22' fill='none' stroke='#fff1a8' stroke-width='3'/>"
                + "<circle cx='32' cy='32' r='14' fill='none' stroke='#ffd54f' stroke-width='2' opacity='0.7'/>"
                + "<circle cx='32' cy='10' r='3' fill='#fff8d6'/><circle cx='54' cy='32' r='3' fill='#fff8d6'/>"
                + "<circle cx='32' cy='54' r='3' fill='#fff8d6'/><circle cx='10' cy='32' r='3' fill='#fff8d6'/>"
                + "<circle cx='32' cy='32' r='7' fill='#ffe082'/>");
        }
        if (id == SurvivorData.WChain) {
            return SurvivorIcons.Svg("<path d='M38 2 L14 34 L28 34 L20 62 L50 24 L34 24 L44 2 Z' fill='#10140f'/>"
                + "<path d='M38 5 L18 32 L31 32 L24 56 L46 26 L31 26 L41 5 Z' fill='#8fd3ff'/>"
                + "<path d='M37 8 L24 27 L30 27 Z' fill='#f0faff'/>");
        }
        return SurvivorIcons.Svg("<circle cx='32' cy='32' r='26' fill='#ff9e57' opacity='0.18'/>"
            + "<path d='M32 4 L40 28 L32 32 Z M58 46 L34 40 L32 32 Z M8 46 L26 28 L32 32 Z' fill='#10140f' stroke='#10140f' stroke-width='4' stroke-linejoin='round'/>"
            + "<path d='M32 6 L39 28 L32 32 Z M56 45 L34 39 L32 32 Z M10 45 L27 29 L32 32 Z' fill='#ffb27a'/>"
            + "<circle cx='32' cy='32' r='7' fill='#10140f'/><circle cx='32' cy='32' r='4' fill='#ffe08a'/>");
    }

    public static string Passive(int id) {
        if (id == SurvivorData.PBoots) {
            return SurvivorIcons.Svg("<path d='M18 8 L34 8 L34 38 L54 44 C58 46 58 54 54 56 L14 56 C12 56 12 54 12 52 L16 38 Z' fill='#10140f'/>"
                + "<path d='M20 11 L31 11 L31 40 L52 46 C55 48 55 52 52 53 L16 53 L19 39 Z' fill='#8d6e52'/>"
                + "<rect x='18' y='46' width='36' height='7' rx='2' fill='#5b4636'/>"
                + "<path d='M34 16 L58 10 L52 18 L60 18 L50 26 L34 26 Z' fill='#dff1ff'/>");
        }
        if (id == SurvivorData.PMagnet) {
            return SurvivorIcons.Svg("<path d='M10 12 L26 12 L26 34 C26 42 38 42 38 34 L38 12 L54 12 L54 34 C54 58 10 58 10 34 Z' fill='#10140f'/>"
                + "<path d='M13 15 L23 15 L23 34 C23 46 41 46 41 34 L41 15 L51 15 L51 34 C51 54 13 54 13 34 Z' fill='#e53935'/>"
                + "<rect x='13' y='15' width='10' height='9' fill='#dde6f0'/><rect x='41' y='15' width='10' height='9' fill='#dde6f0'/>");
        }
        if (id == SurvivorData.PHeart) {
            return SurvivorIcons.Svg("<path d='M32 58 L6 30 C-2 18 12 2 24 10 L32 16 L40 10 C52 2 66 18 58 30 Z' fill='#10140f'/>"
                + "<path d='M32 53 L10 29 C4 19 14 7 24 13 L32 19 L40 13 C50 7 60 19 54 29 Z' fill='#ff4d6a'/>"
                + "<circle cx='20' cy='22' r='4' fill='#ffc2cc'/>");
        }
        return SurvivorIcons.Svg("<rect x='12' y='4' width='40' height='8' rx='3' fill='#c8963e'/>"
            + "<rect x='12' y='52' width='40' height='8' rx='3' fill='#c8963e'/>"
            + "<path d='M18 12 L46 12 C46 24 36 28 34 32 C36 36 46 40 46 52 L18 52 C18 40 28 36 30 32 C28 28 18 24 18 12 Z' fill='#10140f'/>"
            + "<path d='M21 14 L43 14 C43 23 35 27 33 32 C35 37 43 41 43 50 L21 50 C21 41 29 37 31 32 C29 27 21 23 21 14 Z' fill='#cfe8ff' opacity='0.85'/>"
            + "<path d='M24 18 L40 18 C38 24 34 26 32 30 C30 26 26 24 24 18 Z M23 50 L41 50 C40 44 36 42 32 40 C28 42 24 44 23 50 Z' fill='#ffc53d'/>");
    }

    public static string Potion() {
        return SurvivorIcons.Svg("<rect x='25' y='4' width='14' height='10' rx='2' fill='#8d6e52'/>"
            + "<path d='M24 14 L40 14 L40 24 C52 28 56 38 54 46 C52 56 42 60 32 60 C22 60 12 56 10 46 C8 38 12 28 24 24 Z' fill='#10140f'/>"
            + "<path d='M27 17 L37 17 L37 26 C48 30 52 38 50 46 C48 53 40 57 32 57 C24 57 16 53 14 46 C12 38 16 30 27 26 Z' fill='#ff4d6a'/>"
            + "<circle cx='24' cy='38' r='4' fill='#ffc2cc'/>");
    }

    public static string Skull() {
        return SurvivorIcons.Svg("<path d='M32 4 C16 4 6 14 6 28 C6 38 12 44 18 46 L18 58 L46 58 L46 46 C52 44 58 38 58 28 C58 14 48 4 32 4 Z' fill='#e8e2cf'/>"
            + "<circle cx='22' cy='30' r='7' fill='#14141e'/><circle cx='42' cy='30' r='7' fill='#14141e'/>"
            + "<path d='M32 38 L28 46 L36 46 Z' fill='#14141e'/>"
            + "<rect x='24' y='50' width='3' height='8' fill='#14141e'/><rect x='31' y='50' width='3' height='8' fill='#14141e'/><rect x='38' y='50' width='3' height='8' fill='#14141e'/>");
    }

    public static string Lock() {
        return SurvivorIcons.Svg("<path d='M20 28 L20 20 C20 6 44 6 44 20 L44 28' fill='none' stroke='#6b7280' stroke-width='6'/>"
            + "<rect x='12' y='28' width='40' height='30' rx='5' fill='#4b5563'/><circle cx='32' cy='41' r='5' fill='#1f2430'/>"
            + "<rect x='30' y='42' width='4' height='9' fill='#1f2430'/>");
    }

    // 角色头像（与世界里的剪影同色）
    public static string Character(int id) {
        string cloak = id == 1 ? "#4a6fa5" : (id == 2 ? "#7b4fb8" : "#2a9d8f");
        string dark = id == 1 ? "#2d4568" : (id == 2 ? "#4e2f7a" : "#1b6a61");
        string eye = id == 1 ? "#9fe7ff" : (id == 2 ? "#b6fff6" : "#ffe08a");
        string trim = id == 1 ? "#d8dee9" : (id == 2 ? "#7ff3e6" : "#ffc53d");
        string body = "<rect x='10' y='38' width='44' height='26' rx='12' fill='#10140f'/>"
            + "<rect x='13' y='40' width='38' height='24' rx='10' fill='" + dark + "'/>"
            + "<rect x='13' y='40' width='26' height='24' rx='10' fill='" + cloak + "'/>"
            + "<rect x='13' y='54' width='38' height='4' fill='" + trim + "'/>";
        string hat = "";
        if (id == 2) { hat = "<path d='M12 22 L52 22 L40 0 Z' fill='#10140f'/><path d='M15 21 L49 21 L39 3 Z' fill='" + dark + "'/>"; }
        string head = "<circle cx='32' cy='28' r='17' fill='#10140f'/>"
            + "<circle cx='32' cy='28' r='15' fill='" + (id == 1 ? "#9aa6b8" : cloak) + "'/>"
            + "<rect x='21' y='24' width='22' height='13' rx='6' fill='#0e1714'/>"
            + "<circle cx='27' cy='30' r='2.6' fill='" + eye + "'/><circle cx='37' cy='30' r='2.6' fill='" + eye + "'/>";
        if (id == 1) { head = head + "<rect x='29' y='6' width='6' height='9' fill='#e04848'/>"; }
        return SurvivorIcons.Svg(body + hat + head);
    }
}
