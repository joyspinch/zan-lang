using System;

// 奇数行向右错半格，邻接关系与棋盘的六个方向一致。
public enum TrapCatResult { Playing, Trapped, Escaped }

public class TrapCatBoard {
    const int Size = 9;
    const int Count = 81;
    const int Center = 40;

    bool[] blocked;
    int[] distance;
    int[] queue;
    int[] moveCells;
    int[] catHistory;
    int cat;
    int moves;
    int difficulty;
    long seed;
    TrapCatResult result;

    TrapCatBoard() {
        blocked = new bool[TrapCatBoard.Count];
        distance = new int[TrapCatBoard.Count];
        queue = new int[TrapCatBoard.Count];
        moveCells = new int[TrapCatBoard.Count];
        catHistory = new int[TrapCatBoard.Count];
        cat = TrapCatBoard.Center;
        result = TrapCatResult.Playing;
    }

    static bool IsEdge(int cell) {
        int row = cell / TrapCatBoard.Size;
        int col = cell % TrapCatBoard.Size;
        return row == 0 || row == TrapCatBoard.Size - 1 || col == 0 || col == TrapCatBoard.Size - 1;
    }

    static int Neighbor(int cell, int direction) {
        if (cell < 0 || cell >= TrapCatBoard.Count || direction < 0 || direction >= 6) { return -1; }
        int row = cell / TrapCatBoard.Size;
        int col = cell % TrapCatBoard.Size;
        int side = row % 2;
        if (direction == 0) { col = col - 1; }
        if (direction == 1) { col = col + 1; }
        if (direction == 2) { col = col + side - 1; row = row - 1; }
        if (direction == 3) { col = col + side; row = row - 1; }
        if (direction == 4) { col = col + side - 1; row = row + 1; }
        if (direction == 5) { col = col + side; row = row + 1; }
        if (row < 0 || row >= TrapCatBoard.Size || col < 0 || col >= TrapCatBoard.Size) { return -1; }
        return row * TrapCatBoard.Size + col;
    }

    static int InitialBlocks(int level) {
        if (level == 0) { return 18; }
        if (level == 2) { return 6; }
        return 12;
    }

    void NewRound(int level, long roundSeed) {
        difficulty = level < 0 ? 0 : (level > 2 ? 2 : level);
        seed = roundSeed;
        Random random = Random.Seeded(seed);
        int[] candidates = new int[TrapCatBoard.Count];
        int candidateCount = 0;
        for (int cell = 0; cell < TrapCatBoard.Count; cell++) {
            bool nearCat = cell == TrapCatBoard.Center;
            for (int dir = 0; dir < 6; dir++) {
                if (cell == TrapCatBoard.Neighbor(TrapCatBoard.Center, dir)) { nearCat = true; }
            }
            if (!nearCat) { candidates[candidateCount] = cell; candidateCount++; }
        }
        cat = TrapCatBoard.Center;
        moves = 0;
        result = TrapCatResult.Playing;
        // 重试只改变初始障碍，避免随机开局已经围住猫。
        for (int attempt = 0; attempt < 64; attempt++) {
            for (int cell = 0; cell < TrapCatBoard.Count; cell++) { blocked[cell] = false; }
            for (int i = candidateCount - 1; i > 0; i--) {
                int j = random.NextBelow(i + 1);
                int temp = candidates[i];
                candidates[i] = candidates[j];
                candidates[j] = temp;
            }
            for (int i = 0; i < TrapCatBoard.InitialBlocks(difficulty); i++) { blocked[candidates[i]] = true; }
            this.FindRoutes();
            if (distance[cat] > 0) { return; }
        }
        for (int cell = 0; cell < TrapCatBoard.Count; cell++) { blocked[cell] = false; }
        this.FindRoutes();
    }

    // 从所有开放边界反向 BFS，一次得到每个点到最近出口的距离。
    void FindRoutes() {
        int readIndex = 0;
        int writeIndex = 0;
        for (int cell = 0; cell < TrapCatBoard.Count; cell++) {
            distance[cell] = -1;
            if (!blocked[cell] && TrapCatBoard.IsEdge(cell)) {
                distance[cell] = 0;
                queue[writeIndex] = cell;
                writeIndex++;
            }
        }
        while (readIndex < writeIndex) {
            int current = queue[readIndex];
            readIndex++;
            for (int dir = 0; dir < 6; dir++) {
                int next = TrapCatBoard.Neighbor(current, dir);
                if (next >= 0 && !blocked[next] && distance[next] < 0) {
                    distance[next] = distance[current] + 1;
                    queue[writeIndex] = next;
                    writeIndex++;
                }
            }
        }
    }

    bool Block(int cell) {
        if (result != TrapCatResult.Playing || cell < 0 || cell >= TrapCatBoard.Count || cell == cat || blocked[cell]) { return false; }
        moveCells[moves] = cell;
        catHistory[moves] = cat;
        blocked[cell] = true;
        moves++;
        this.FindRoutes();
        if (distance[cat] < 0) { result = TrapCatResult.Trapped; return true; }
        int bestDistance = TrapCatBoard.Count;
        int chosen = -1;
        int ties = 0;
        // 以回合数派生随机源，悔棋后重复落子仍得到同一条猫的路线。
        Random random = Random.Seeded(seed + (long)moves * 104729);
        for (int dir = 0; dir < 6; dir++) {
            int next = TrapCatBoard.Neighbor(cat, dir);
            if (next >= 0 && !blocked[next] && distance[next] >= 0) {
                if (distance[next] < bestDistance) {
                    bestDistance = distance[next];
                    chosen = next;
                    ties = 1;
                } else if (distance[next] == bestDistance) {
                    ties++;
                    if (random.NextBelow(ties) == 0) { chosen = next; }
                }
            }
        }
        if (chosen < 0) { result = TrapCatResult.Trapped; return true; }
        cat = chosen;
        if (TrapCatBoard.IsEdge(cat)) { result = TrapCatResult.Escaped; }
        return true;
    }

    bool Undo() {
        if (moves == 0) { return false; }
        moves--;
        blocked[moveCells[moves]] = false;
        cat = catHistory[moves];
        result = TrapCatResult.Playing;
        this.FindRoutes();
        return true;
    }
}
