using System;
using System.Collections.Generic;

// 闯关 30 关：三章（后院 / 花园 / 屋顶），猫一章比一章聪明。
// 每关固定开局（手绘图案或种子）+ 篱笆预算 + 三星步数线。
// 数值由无头求解机器人（反复采用 TrapCatBoard.Hint）跑出：star3 = 机器人用的步数，
// 预算 = star3 + 余量（第一章 4，之后 3），再用“七成照提示”的普通玩家机器人试玩挑开局，
// 让胜率随关卡逐步下降（注释里是挑中开局时的胜率）。改了猫的规则要重跑平衡再改这张表。
public class TrapCatLevel {
    string pattern;
    long seed;
    int blocks;
    int skill;
    int leap;
    int budget;
    int star3;
    int star2;

    TrapCatLevel(string pattern, long seed, int blocks, int skill, int leap, int budget, int star3, int star2) {
        this.pattern = pattern;
        this.seed = seed;
        this.blocks = blocks;
        this.skill = skill;
        this.leap = leap;
        this.budget = budget;
        this.star3 = star3;
        this.star2 = star2;
    }

    void Apply(TrapCatBoard board) {
        board.NewCustom(seed, pattern, blocks, skill, budget, leap);
    }

    // 围住时用了 moves 步；用过提示最多两星。
    int Stars(int moves, bool hinted) {
        int stars = moves <= star3 ? 3 : (moves <= star2 ? 2 : 1);
        if (hinted && stars > 2) { stars = 2; }
        return stars;
    }
}

public class TrapCatLevels {
    const int Count = 30;
    const int PerChapter = 10;
    static List<TrapCatLevel> table;

    static void Add(string pattern, long seed, int blocks, int skill, int leap, int budget, int star3, int star2) {
        TrapCatLevels.table.Add(new TrapCatLevel(pattern, seed, blocks, skill, leap, budget, star3, star2));
    }

    static TrapCatLevel Get(int index) {
        if (TrapCatLevels.table == null) { TrapCatLevels.Build(); }
        int i = index < 0 ? 0 : (index >= TrapCatLevels.Count ? TrapCatLevels.Count - 1 : index);
        return TrapCatLevels.table[i];
    }

    static int Chapter(int index) { return index / TrapCatLevels.PerChapter; }

    static string ChapterName(int chapter) {
        if (chapter == 0) { return "后院"; }
        if (chapter == 1) { return "花园"; }
        return "屋顶";
    }

    static string SkillText(int skill) {
        if (skill == TrapCatBoard.SkillGreedy) { return "直奔出口"; }
        if (skill == TrapCatBoard.SkillWary) { return "会挑岔路"; }
        if (skill == TrapCatBoard.SkillLookahead) { return "会算两步"; }
        return "会蹦两格";
    }

    static void Build() {
        TrapCatLevels.table = new List<TrapCatLevel>();
        TrapCatLevels.Add("...........####.........#...#........#.....#..#....#....#...#....#.##............", 1017, 22, 0, 0, 7, 3, 5); // 1 普通机器人胜率 70%
        TrapCatLevels.Add("............##......#...#...#....#...#.....#............#...#....##.#............", 1148, 22, 0, 0, 11, 7, 9); // 2 普通机器人胜率 60%
        TrapCatLevels.Add("...#.#....#....#.....##....#....#.#...#...#..#.#....#.....##....#....#.....#.#...", 1279, 21, 0, 0, 9, 5, 7); // 3 普通机器人胜率 80%
        TrapCatLevels.Add("", 1546, 21, 0, 0, 12, 8, 10); // 4 普通机器人胜率 70%
        TrapCatLevels.Add("", 1762, 20, 0, 0, 18, 14, 16); // 5 普通机器人胜率 60%
        TrapCatLevels.Add("", 2003, 20, 1, 0, 15, 11, 13); // 6 普通机器人胜率 58%
        TrapCatLevels.Add("", 2024, 19, 1, 0, 17, 13, 15); // 7 普通机器人胜率 70%
        TrapCatLevels.Add("", 2019, 19, 1, 0, 10, 6, 8); // 8 普通机器人胜率 70%
        TrapCatLevels.Add("", 2099, 18, 1, 0, 14, 10, 12); // 9 普通机器人胜率 70%
        TrapCatLevels.Add("..##.#.....#.#.#...#....#...#.....#.##.....###.....#....#....#..#.#.#......#.##..", 2196, 18, 1, 0, 13, 9, 11); // 10 普通机器人胜率 60%
        TrapCatLevels.Add("", 2412, 19, 1, 0, 11, 8, 10); // 11 普通机器人胜率 50%
        TrapCatLevels.Add("", 2475, 19, 1, 0, 13, 10, 12); // 12 普通机器人胜率 60%
        TrapCatLevels.Add("", 2759, 18, 1, 0, 17, 14, 16); // 13 普通机器人胜率 50%
        TrapCatLevels.Add("", 2924, 18, 1, 0, 16, 13, 15); // 14 普通机器人胜率 50%
        TrapCatLevels.Add("", 2885, 17, 2, 0, 24, 21, 23); // 15 普通机器人胜率 50%
        TrapCatLevels.Add("", 3186, 17, 2, 0, 16, 13, 15); // 16 普通机器人胜率 70%
        TrapCatLevels.Add("", 3317, 16, 2, 0, 21, 18, 20); // 17 普通机器人胜率 40%
        TrapCatLevels.Add("", 3261, 16, 2, 0, 22, 19, 21); // 18 普通机器人胜率 70%
        TrapCatLevels.Add("", 3579, 15, 2, 0, 25, 22, 24); // 19 普通机器人胜率 60%
        TrapCatLevels.Add("...#..#...#...........#..#...#..#...#.......#..#..#....#..#..........#....#..#...", 3506, 15, 2, 0, 12, 7, 9); // 20 普通机器人胜率 10%（预算放宽到 12）
        TrapCatLevels.Add("", 3637, 21, 3, 5, 28, 25, 27); // 21 普通机器人胜率 50%
        TrapCatLevels.Add("", 3819, 21, 3, 5, 23, 20, 22); // 22 普通机器人胜率 50%
        TrapCatLevels.Add("", 3950, 20, 3, 5, 23, 20, 22); // 23 普通机器人胜率 50%
        TrapCatLevels.Add("", 4115, 20, 3, 5, 17, 14, 16); // 24 普通机器人胜率 50%
        TrapCatLevels.Add("", 4246, 19, 3, 5, 22, 19, 21); // 25 普通机器人胜率 40%
        TrapCatLevels.Add("", 4343, 19, 3, 4, 23, 20, 22); // 26 普通机器人胜率 40%
        TrapCatLevels.Add("", 4576, 18, 3, 4, 34, 31, 33); // 27 普通机器人胜率 40%
        TrapCatLevels.Add("", 4588, 18, 3, 4, 18, 15, 17); // 28 普通机器人胜率 30%
        TrapCatLevels.Add("", 4736, 17, 3, 4, 25, 22, 24); // 29 普通机器人胜率 20%
        TrapCatLevels.Add("...#..#....#.#.....#....#.........#..#.....#.#..........#....#....#.#.....#..#...", 4816, 17, 3, 4, 20, 19, 20); // 30 普通机器人胜率 70%（终关预算收紧到 20）
    }
}
