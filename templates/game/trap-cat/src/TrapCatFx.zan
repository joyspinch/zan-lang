using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Game.Foundation;

// 场景美术层（世界画面，不是控件）：草坪/花园/屋顶底图、灌木与篱笆、开局障碍、
// 提示光圈、粒子、笼子与爱心、满屏彩纸。圆点本身仍是标准 Button（CSS 皮肤），
// 这些层都不参与命中测试。矢量造型与小猫同一套描边/配色，按尺寸缓存成位图。
public class TrapCatArt {
    const string Outline = "#4f3d36";

    static string Svg(int w, int h, string body) {
        return "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " + w + " " + h + "' width='" + w + "' height='" + h + "'>" + body + "</svg>";
    }

    // 玩家种下的灌木：三团叶冠，先整体描边再填色，接缝不露线。variant 决定点缀（浆果/小花）。
    static string Bush(int variant) {
        string o = TrapCatArt.Outline;
        string dark = variant % 2 == 0 ? "#4f9147" : "#5a9a4a";
        string mid = variant % 2 == 0 ? "#6cb35a" : "#79bb5c";
        string dot = variant % 3 == 0 ? "#ff8fa3" : (variant % 3 == 1 ? "#fff1a8" : "#ffffff");
        return TrapCatArt.Svg(64, 64,
            "<ellipse cx='32' cy='57' rx='23' ry='5' fill='#1f3a22' opacity='.28'/>"
            + "<g fill='" + o + "'><circle cx='19' cy='39' r='16'/><circle cx='45' cy='39' r='16'/><circle cx='32' cy='26' r='18'/><rect x='12' y='38' width='40' height='17' rx='8'/></g>"
            + "<g fill='" + dark + "'><circle cx='19' cy='39' r='13'/><circle cx='45' cy='39' r='13'/><rect x='14' y='38' width='36' height='14' rx='7'/></g>"
            + "<circle cx='32' cy='27' r='15' fill='" + mid + "'/>"
            + "<path d='M20 24 Q26 13 37 14' fill='none' stroke='#b4e38f' stroke-width='4' stroke-linecap='round' opacity='.85'/>"
            + "<circle cx='12' cy='36' r='3' fill='#a5d982' opacity='.8'/><circle cx='50' cy='35' r='3' fill='#a5d982' opacity='.7'/>"
            + "<g fill='" + dot + "' stroke='" + o + "' stroke-width='1.2'><circle cx='24' cy='42' r='3'/><circle cx='41' cy='30' r='3'/><circle cx='46' cy='46' r='2.6'/></g>");
    }

    // 木篱笆：两根尖头木桩 + 两道横杆，脚下一撮草。
    static string Fence() {
        string o = TrapCatArt.Outline;
        return TrapCatArt.Svg(64, 64,
            "<ellipse cx='32' cy='57' rx='22' ry='5' fill='#1f3a22' opacity='.28'/>"
            + "<g stroke='" + o + "' stroke-width='3' stroke-linejoin='round'>"
            + "<path d='M14 56 L14 18 L21 9 L28 18 L28 56 Z' fill='#e7b77f'/>"
            + "<path d='M36 56 L36 18 L43 9 L50 18 L50 56 Z' fill='#dca46b'/>"
            + "<rect x='6' y='24' width='52' height='8' rx='3' fill='#c98d57'/>"
            + "<rect x='6' y='40' width='52' height='8' rx='3' fill='#c98d57'/></g>"
            + "<path d='M17 20 L17 52 M39 20 L39 52' stroke='#f6d6a6' stroke-width='2.5' stroke-linecap='round'/>"
            + "<path d='M10 58 Q13 49 16 58 M46 58 Q50 48 53 58 M26 58 Q29 51 31 58' fill='#6cb35a' stroke='" + o + "' stroke-width='1.5'/>");
    }

    // 开局障碍：后院是石头，花园是花盆，屋顶是烟囱。
    static string Prop(int chapter, int variant) {
        string o = TrapCatArt.Outline;
        if (chapter == 1) {
            string petal = variant % 2 == 0 ? "#ff9db5" : "#ffc46b";
            return TrapCatArt.Svg(64, 64,
                "<ellipse cx='32' cy='57' rx='18' ry='4.5' fill='#1f3a22' opacity='.28'/>"
                + "<g stroke='" + o + "' stroke-width='2.5' stroke-linejoin='round'>"
                + "<path d='M32 34 Q26 22 30 12' fill='none'/>"
                + "<path d='M31 30 Q18 26 16 16 Q28 17 31 30 Z' fill='#6cb35a'/><path d='M33 28 Q44 22 48 13 Q36 14 33 28 Z' fill='#5a9a4a'/>"
                + "<circle cx='22' cy='13' r='5' fill='" + petal + "'/><circle cx='30' cy='9' r='5' fill='" + petal + "'/><circle cx='38' cy='13' r='5' fill='" + petal + "'/>"
                + "<circle cx='30' cy='14' r='4' fill='#fff1a8'/>"
                + "<path d='M17 34 L47 34 L42 57 L22 57 Z' fill='#d9784f'/><rect x='14' y='31' width='36' height='8' rx='3' fill='#e98d63'/></g>"
                + "<path d='M22 43 L41 43' stroke='#f2a985' stroke-width='2.5' stroke-linecap='round'/>");
        }
        if (chapter == 2) {
            return TrapCatArt.Svg(64, 64,
                "<ellipse cx='32' cy='57' rx='19' ry='4.5' fill='#3b1f19' opacity='.3'/>"
                + "<g stroke='" + o + "' stroke-width='2.5' stroke-linejoin='round'>"
                + "<rect x='18' y='20' width='28' height='37' rx='2' fill='#b9573f'/>"
                + "<rect x='14' y='14' width='36' height='9' rx='2' fill='#8f3f30'/></g>"
                + "<path d='M18 31 L46 31 M18 42 L46 42 M30 23 L30 31 M24 31 L24 42 M38 31 L38 42 M30 42 L30 57' stroke='#e0896d' stroke-width='2'/>"
                + "<circle cx='" + (26 + variant % 3 * 4) + "' cy='8' r='4' fill='#e9e2dc' opacity='.75'/><circle cx='" + (33 + variant % 2 * 3) + "' cy='4' r='3' fill='#e9e2dc' opacity='.55'/>");
        }
        string stone = variant % 2 == 0 ? "#b4ada3" : "#a59f95";
        return TrapCatArt.Svg(64, 64,
            "<ellipse cx='32' cy='56' rx='22' ry='5' fill='#1f3a22' opacity='.28'/>"
            + "<path d='M9 52 Q7 36 18 28 Q26 18 38 22 Q52 24 56 38 Q59 52 48 55 Q30 59 9 52 Z' fill='" + stone + "' stroke='" + o + "' stroke-width='3' stroke-linejoin='round'/>"
            + "<path d='M18 33 Q24 26 33 27' fill='none' stroke='#e4ded5' stroke-width='4' stroke-linecap='round'/>"
            + "<path d='M38 44 Q44 40 48 44' fill='none' stroke='" + o + "' stroke-width='2' stroke-linecap='round' opacity='.6'/>"
            + "<path d='M12 50 Q20 45 26 51 Q18 54 12 50 Z' fill='#79bb5c' stroke='" + o + "' stroke-width='1.5'/>");
    }

    // 被围住时落下的笼子（只围住紧贴的一圈时出现）。
    static string Cage() {
        string o = TrapCatArt.Outline;
        return TrapCatArt.Svg(96, 112,
            "<g stroke='" + o + "' stroke-linejoin='round' stroke-linecap='round'>"
            + "<path d='M12 98 L12 44 Q12 10 48 10 Q84 10 84 44 L84 98' fill='none' stroke-width='9'/>"
            + "<path d='M12 98 L12 44 Q12 10 48 10 Q84 10 84 44 L84 98' fill='none' stroke='#c9a46a' stroke-width='4'/>"
            + "<path d='M30 98 L30 16 M48 98 L48 10 M66 98 L66 16' fill='none' stroke-width='7'/>"
            + "<path d='M30 98 L30 16 M48 98 L48 10 M66 98 L66 16' fill='none' stroke='#e3c48d' stroke-width='3'/>"
            + "<rect x='6' y='94' width='84' height='12' rx='5' fill='#b8864f' stroke-width='3'/>"
            + "<path d='M10 46 L86 46' fill='none' stroke-width='6'/><path d='M10 46 L86 46' fill='none' stroke='#c9a46a' stroke-width='2.5'/>"
            + "<circle cx='48' cy='6' r='5' fill='none' stroke-width='3'/></g>");
    }

    static string Heart() {
        return TrapCatArt.Svg(32, 32,
            "<path d='M16 28 Q3 19 3 11 Q3 4 10 4 Q14 4 16 9 Q18 4 22 4 Q29 4 29 11 Q29 19 16 28 Z' fill='#ff7d98' stroke='" + TrapCatArt.Outline + "' stroke-width='2.5' stroke-linejoin='round'/>"
            + "<path d='M8 10 Q9 7 12 7' fill='none' stroke='#ffd0da' stroke-width='2.5' stroke-linecap='round'/>");
    }

    // 棋盘底：木框里铺一块草坪（或花园、屋瓦），带修剪条纹、小花和草丛。
    static string Lawn(int w, int h, int chapter) {
        string top = "#b6dc8e";
        string bottom = "#86c06b";
        string stripe = "#ffffff";
        string fleck = "#5f9e4f";
        if (chapter == 1) { top = "#c4e39a"; bottom = "#93c776"; fleck = "#5a9a4a"; }
        if (chapter == 2) { top = "#f0b48d"; bottom = "#cf7d5e"; stripe = "#fff1e3"; fleck = "#a9503b"; }
        int inset = 10;
        string body = "<defs><linearGradient id='g' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='" + top + "'/><stop offset='1' stop-color='" + bottom + "'/></linearGradient>"
            + "<radialGradient id='v' cx='.5' cy='.45' r='.7'><stop offset='.6' stop-color='#000' stop-opacity='0'/><stop offset='1' stop-color='#000' stop-opacity='.18'/></radialGradient></defs>"
            + "<rect x='" + inset + "' y='" + inset + "' width='" + (w - inset * 2) + "' height='" + (h - inset * 2) + "' rx='18' fill='url(#g)'/>";
        Random r = Random.Seeded(7 + chapter * 31);
        if (chapter == 2) {
            // 屋瓦：一排排半圆鳞片。
            for (int y = inset + 14; y < h - inset; y += 22) {
                string row = "";
                int shift = (y / 22) % 2 == 0 ? 0 : 14;
                for (int x = inset + shift - 14; x < w - inset; x += 28) {
                    row = row + "M" + x + " " + y + " Q" + (x + 14) + " " + (y + 18) + " " + (x + 28) + " " + y + " ";
                }
                body = body + "<path d='" + row + "' fill='none' stroke='" + fleck + "' stroke-width='2' opacity='.35'/>";
            }
        } else {
            for (int x = inset - h; x < w; x += 56) {
                body = body + "<path d='M" + x + " " + (h - inset) + " L" + (x + 28) + " " + (h - inset) + " L" + (x + 28 + h) + " " + inset + " L" + (x + h) + " " + inset + " Z' fill='" + stripe + "' opacity='.09'/>";
            }
            for (int i = 0; i < 46; i++) {
                int x = inset + 8 + r.NextBelow(w - inset * 2 - 16);
                int y = inset + 8 + r.NextBelow(h - inset * 2 - 16);
                body = body + "<path d='M" + x + " " + y + " l2 -6 l2 6 l2 -4 l1 4' fill='none' stroke='" + fleck + "' stroke-width='1.6' stroke-linecap='round' opacity='.55'/>";
            }
            int flowers = chapter == 1 ? 22 : 10;
            for (int i = 0; i < flowers; i++) {
                int x = inset + 10 + r.NextBelow(w - inset * 2 - 20);
                int y = inset + 10 + r.NextBelow(h - inset * 2 - 20);
                string petal = i % 3 == 0 ? "#ffffff" : (i % 3 == 1 ? "#ffe17a" : "#ffa8bd");
                body = body + "<g opacity='.85'><circle cx='" + (x - 2) + "' cy='" + y + "' r='2' fill='" + petal + "'/><circle cx='" + (x + 2) + "' cy='" + y + "' r='2' fill='" + petal + "'/><circle cx='" + x + "' cy='" + (y - 2) + "' r='2' fill='" + petal + "'/><circle cx='" + x + "' cy='" + (y + 2) + "' r='2' fill='" + petal + "'/><circle cx='" + x + "' cy='" + y + "' r='1.4' fill='#f4a340'/></g>";
            }
        }
        body = body + "<rect x='" + inset + "' y='" + inset + "' width='" + (w - inset * 2) + "' height='" + (h - inset * 2) + "' rx='18' fill='url(#v)'/>"
            + "<rect x='" + (inset + 1) + "' y='" + (inset + 1) + "' width='" + (w - inset * 2 - 2) + "' height='" + (h - inset * 2 - 2) + "' rx='17' fill='none' stroke='#3c5a34' stroke-opacity='.35' stroke-width='3'/>";
        return TrapCatArt.Svg(w, h, body);
    }

    // 按 key 懒加载 SVG 位图，返回 key。
    static string Raster(string key, string svg, int w, int h) {
        if (Canvas.ImageWidth(key) <= 0) { Canvas.ImageLoadSvg(key, svg, w, h); }
        return key;
    }
}

// 粒子：落子飞叶、逃跑扬尘、围住时的星星。只存数组，按真实时间积分。
public class TrapCatParticles {
    const int Max = 160;
    double[] px;
    double[] py;
    double[] vx;
    double[] vy;
    double[] life;
    double[] span;
    int[] color;
    int[] radius;
    double[] gravity;
    int live;

    TrapCatParticles() {
        px = new double[TrapCatParticles.Max];
        py = new double[TrapCatParticles.Max];
        vx = new double[TrapCatParticles.Max];
        vy = new double[TrapCatParticles.Max];
        life = new double[TrapCatParticles.Max];
        span = new double[TrapCatParticles.Max];
        color = new int[TrapCatParticles.Max];
        radius = new int[TrapCatParticles.Max];
        gravity = new double[TrapCatParticles.Max];
    }

    void Clear() { live = 0; }

    void Emit(double x, double y, double speedX, double speedY, double seconds, int argb, int size, double fall) {
        if (live >= TrapCatParticles.Max) { return; }
        px[live] = x; py[live] = y; vx[live] = speedX; vy[live] = speedY;
        life[live] = seconds; span[live] = seconds; color[live] = argb; radius[live] = size; gravity[live] = fall;
        live++;
    }

    void Burst(Random r, int x, int y, int count, int[] palette, double speed, double seconds, int size, double fall) {
        for (int i = 0; i < count; i++) {
            double a = r.NextDouble() * 6.2831853;
            double s = speed * (0.4 + r.NextDouble() * 0.8);
            this.Emit(x, y, Math.Cos(a) * s, Math.Sin(a) * s - speed * 0.4, seconds * (0.6 + r.NextDouble() * 0.6), palette[i % palette.Length], size + r.NextBelow(3), fall);
        }
    }

    // 返回是否还有活粒子。
    bool Step(double dt) {
        int w = 0;
        for (int i = 0; i < live; i++) {
            life[i] -= dt;
            if (life[i] <= 0) { continue; }
            vy[i] += gravity[i] * dt;
            vx[i] *= 1.0 - 1.5 * dt;
            px[i] += vx[i] * dt;
            py[i] += vy[i] * dt;
            if (w != i) {
                px[w] = px[i]; py[w] = py[i]; vx[w] = vx[i]; vy[w] = vy[i];
                life[w] = life[i]; span[w] = span[i]; color[w] = color[i]; radius[w] = radius[i]; gravity[w] = gravity[i];
            }
            w++;
        }
        live = w;
        return live > 0;
    }

    void Paint(Canvas canvas) {
        for (int i = 0; i < live; i++) {
            double k = life[i] / span[i];
            int alpha = (int)(255.0 * (k > 0.5 ? 1.0 : k * 2.0));
            int argb = (alpha << 24) | (color[i] & 0xFFFFFF);
            int r = (int)(radius[i] * (0.5 + 0.5 * k)) + 1;
            canvas.FillCircle((int)px[i], (int)py[i], r, argb);
        }
    }
}

// 草坪底图：插在 BoardBg（木框）之后、圆点之前。
public class TrapCatGarden : Control {
    int chapter;
    string cachedKey = "";

    TrapCatGarden() {
        InitControl("Garden");
        SetProp("class", "board-art");
        NoOverlapCheck();
    }

    override string Kind() { return "TrapCatGarden"; }
    override void OnMeasure(App app) { prefW = 0; prefH = 0; }
    protected override Control HitTestCore(int x, int y, int pointerType, List<Control> excludedSubtrees) { return null; }

    void SetChapter(int value) { chapter = value; }

    override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        string key = "mem:trapcat-lawn-" + chapter + "-" + bw + "x" + bh;
        if (key != cachedKey) {
            if (cachedKey != "") { Canvas.EvictImage(cachedKey); }
            cachedKey = key;
        }
        TrapCatArt.Raster(key, TrapCatArt.Lawn(bw, bh, chapter), bw, bh);
        app.canvas.BlitImage(key, bx, by, bw, bh, 0, 0, 0, 0);
    }
}

// 圆点上的道具层（猫的下面）：灌木/篱笆落地弹出、开局障碍、提示光圈、飞叶。
public class TrapCatProps : Control {
    const int PopMs = 320;
    const int Kinds = 6;
    Button[] cells;
    TrapCatBoard board;
    int chapter;
    long[] placedAt;
    bool[] wasBlocked;
    int hintCell = -1;
    long hintAt;
    int nopeCell = -1;
    long nopeAt;
    int cachedSize;
    TrapCatParticles particles;
    long lastTick;
    Random random;

    TrapCatProps(Button[] boardCells, TrapCatBoard source) {
        InitControl("Props");
        SetProp("class", "board-art");
        NoOverlapCheck();
        cells = boardCells;
        board = source;
        placedAt = new long[TrapCatBoard.Count];
        wasBlocked = new bool[TrapCatBoard.Count];
        particles = new TrapCatParticles();
        random = Random.Seeded(4242);
    }

    override string Kind() { return "TrapCatProps"; }
    override void OnMeasure(App app) { prefW = 0; prefH = 0; }
    protected override Control HitTestCore(int x, int y, int pointerType, List<Control> excludedSubtrees) { return null; }

    void SetChapter(int value) { chapter = value; }

    // 新局：已有障碍直接立着，不播放弹出。
    void Reset() {
        for (int i = 0; i < TrapCatBoard.Count; i++) {
            wasBlocked[i] = board.blocked[i];
            placedAt[i] = 0;
        }
        hintCell = -1;
        nopeCell = -1;
        particles.Clear();
    }

    // 对比上次快照，新出现的障碍播放弹出 + 飞叶。
    void Sync() {
        long now = Window.GetTickMs();
        for (int i = 0; i < TrapCatBoard.Count; i++) {
            if (board.blocked[i] && !wasBlocked[i]) {
                placedAt[i] = now;
                Button c = cells[i];
                int[] leaves = new int[] { 0x6cb35a, 0x9ed47a, 0x4f9147, 0xfff1a8 };
                particles.Burst(random, c.bx + c.bw / 2, c.by + c.bh / 2, 12, leaves, c.bw * 3.2, 0.55, 2, c.bw * 9.0);
                if (i == hintCell) { hintCell = -1; }
            }
            wasBlocked[i] = board.blocked[i];
        }
        lastTick = now;
    }

    void ShowHint(int cell) { hintCell = cell; hintAt = Window.GetTickMs(); }
    void ClearHint() { hintCell = -1; }

    void Nope(int cell) { nopeCell = cell; nopeAt = Window.GetTickMs(); }

    void Puff(int x, int y, int size, int[] palette, int count) {
        particles.Burst(random, x, y, count, palette, size * 2.4, 0.7, 3, size * 2.0);
        lastTick = Window.GetTickMs();
    }

    string Key(int kind, int size) { return "mem:trapcat-prop-" + chapter + "-" + kind + "-" + size; }

    string ArtFor(int cell, int size) {
        // 玩家放的：灌木为主，每三格一段篱笆；开局障碍：本章道具。
        bool mine = board.PlacedByPlayer(cell);
        int kind = mine ? (cell % 3 == 2 ? 3 : cell % 3) : 4 + cell % 2;
        string key = this.Key(kind, size);
        if (Canvas.ImageWidth(key) <= 0) {
            string svg = kind == 3 ? TrapCatArt.Fence() : (kind < 3 ? TrapCatArt.Bush(kind) : TrapCatArt.Prop(chapter, kind));
            Canvas.ImageLoadSvg(key, svg, size, size);
        }
        return key;
    }

    override void OnPaint(App app) {
        if (cells[0].bw <= 0) { return; }
        long now = Window.GetTickMs();
        double dt = lastTick == 0 ? 0.0 : (now - lastTick) / 1000.0;
        if (dt > 0.05) { dt = 0.05; }
        lastTick = now;
        int size = cells[0].bw * 5 / 4;
        if (size != cachedSize) {
            if (cachedSize > 0) {
                for (int ch = 0; ch < 3; ch++) {
                    for (int k = 0; k < TrapCatProps.Kinds; k++) { Canvas.EvictImage("mem:trapcat-prop-" + ch + "-" + k + "-" + cachedSize); }
                }
            }
            cachedSize = size;
        }
        bool animating = false;
        Canvas canvas = app.canvas;
        // 提示光圈：在格子下面先画，灌木不会被盖住。
        if (hintCell >= 0 && !board.blocked[hintCell]) {
            Button h = cells[hintCell];
            double t = (now - hintAt) / 1000.0;
            int pulse = (int)(Math.Sin(t * 6.0) * 3.0);
            int cx = h.bx + h.bw / 2;
            int cy = h.by + h.bh / 2;
            canvas.FillRadial(cx, cy, h.bw + 6 + pulse, 0x90ffe066, 160);
            canvas.DrawCircle(cx, cy, h.bw / 2 + 5 + pulse, 0xE0ffcf3a, 3);
            int ay = h.by - 10 - (int)(Math.Abs(Math.Sin(t * 4.0)) * 6.0);
            canvas.FillCircle(cx, ay - 4, 7, 0xFFffcf3a);
            canvas.DrawCircle(cx, ay - 4, 7, 0xFF4f3d36, 2);
            canvas.DrawLine(cx, ay + 3, cx, ay + 9, 0xFF4f3d36, 3);
            animating = true;
        }
        if (nopeCell >= 0 && now - nopeAt < 300) {
            Button n = cells[nopeCell];
            int shake = (int)(Math.Sin((now - nopeAt) / 18.0) * 4.0);
            canvas.DrawCircle(n.bx + n.bw / 2 + shake, n.by + n.bh / 2, n.bw / 2 + 2, 0xD0e5533c, 3);
            animating = true;
        }
        for (int i = 0; i < TrapCatBoard.Count; i++) {
            if (!board.blocked[i]) { continue; }
            Button c = cells[i];
            int s = size;
            if (placedAt[i] != 0) {
                double t = (now - placedAt[i]) / (double)TrapCatProps.PopMs;
                if (t < 1.0) {
                    s = (int)(size * Easing.Evaluate(EaseType.BackOut, t < 0 ? 0 : t));
                    animating = true;
                } else {
                    placedAt[i] = 0;
                }
            }
            if (s <= 2) { continue; }
            string key = this.ArtFor(i, size);
            int cx = c.bx + c.bw / 2;
            int foot = c.by + c.bh / 2 + size * 26 / 64;
            canvas.BlitImage(key, cx - s / 2, foot - s * 58 / 64, s, s, 0, 0, 0, 0);
        }
        if (particles.live > 0) {
            if (particles.Step(dt)) { animating = true; }
            particles.Paint(canvas);
        }
        if (animating) { app.RequestAnimationFrameIn(bx - 20, by - 30, bw + 40, bh + 50); }
    }
}

// 猫上方的演出层：笼子落下、爱心飘起、蓄力感叹号、扬尘与星星。
public class TrapCatStage : Control {
    TrapCatSprite sprite;
    TrapCatBoard board;
    Button[] cells;
    int mode;
    long modeAt;
    int focusX;
    int focusY;
    int cellSize;
    TrapCatParticles particles;
    long lastTick;
    Random random;
    int cachedSize;

    TrapCatStage(Button[] boardCells, TrapCatBoard source, TrapCatSprite cat) {
        InitControl("Stage");
        SetProp("class", "board-art");
        NoOverlapCheck();
        cells = boardCells;
        board = source;
        sprite = cat;
        particles = new TrapCatParticles();
        random = Random.Seeded(99);
    }

    override string Kind() { return "TrapCatStage"; }
    override void OnMeasure(App app) { prefW = 0; prefH = 0; }
    protected override Control HitTestCore(int x, int y, int pointerType, List<Control> excludedSubtrees) { return null; }

    void Reset() { mode = 0; particles.Clear(); }

    // 1 = 笼子（紧贴一圈全封）；2 = 爱心（围在一片区域里）；3 = 逃跑扬尘。
    void Play(int what) {
        mode = what;
        modeAt = Window.GetTickMs();
        lastTick = modeAt;
        Button c = cells[board.cat];
        focusX = c.bx + c.bw / 2;
        focusY = c.by + c.bh / 2;
        cellSize = c.bw;
        if (what == 1 || what == 2) {
            int[] gold = new int[] { 0xffd54a, 0xfff3b0, 0xff9db5, 0xffffff };
            particles.Burst(random, focusX, focusY - cellSize / 2, 22, gold, cellSize * 4.0, 0.9, 2, cellSize * 3.0);
        }
        if (what == 3) {
            int[] dust = new int[] { 0xe8d6b5, 0xf3e7cf, 0xcdb48c };
            particles.Burst(random, focusX, focusY + cellSize / 3, 16, dust, cellSize * 2.2, 0.8, 4, 0.0);
        }
    }

    override void OnPaint(App app) {
        if (cells[0].bw <= 0) { return; }
        long now = Window.GetTickMs();
        double dt = lastTick == 0 ? 0.0 : (now - lastTick) / 1000.0;
        if (dt > 0.05) { dt = 0.05; }
        lastTick = now;
        Canvas canvas = app.canvas;
        bool animating = false;
        int size = cells[0].bw;
        if (size != cachedSize) {
            if (cachedSize > 0) {
                Canvas.EvictImage("mem:trapcat-cage-" + cachedSize);
                Canvas.EvictImage("mem:trapcat-heart-" + cachedSize);
            }
            cachedSize = size;
        }
        double t = (now - modeAt) / 1000.0;
        if (mode == 1) {
            int w = size * 2;
            int h = w * 112 / 96;
            string key = TrapCatArt.Raster("mem:trapcat-cage-" + size, TrapCatArt.Cage(), w, h);
            double f = t < 0.55 ? Easing.Evaluate(EaseType.BounceOut, t / 0.55) : 1.0;
            int bottom = focusY + size / 2 + 4;
            int top = (int)((bottom - h - size * 4) * (1.0 - f) + (bottom - h) * f);
            canvas.BlitImage(key, focusX - w / 2, top, w, h, 0, 0, 0, 0);
            if (t < 0.6) { animating = true; }
        }
        if (mode == 2 && t < 2.4) {
            int hs = size * 3 / 4;
            string key = TrapCatArt.Raster("mem:trapcat-heart-" + size, TrapCatArt.Heart(), hs, hs);
            for (int i = 0; i < 4; i++) {
                double ht = t - i * 0.35;
                if (ht < 0 || ht > 1.4) { continue; }
                double k = ht / 1.4;
                int s = (int)(hs * (k < 0.2 ? k / 0.2 : (1.0 - (k - 0.2) * 0.7)));
                int x = focusX + (int)(Math.Sin(ht * 5.0 + i) * size * 0.4) + (i % 2 == 0 ? -size / 3 : size / 3);
                int y = focusY - size - (int)(k * size * 2.2);
                if (s > 2) { canvas.BlitImage(key, x - s / 2, y - s / 2, s, s, 0, 0, 0, 0); }
            }
            animating = true;
        }
        // 下回合要蹦两格：猫头顶一个跳动的橙色感叹号。
        if (board.PounceIn() == 1 && board.result == TrapCatResult.Playing && sprite.bw > 0) {
            int cx = sprite.bx + sprite.bw / 2 + sprite.bw / 3;
            int cy = sprite.by + sprite.bh / 6 - (int)(Math.Abs(Math.Sin(now / 160.0)) * 4.0);
            int r = size / 4 + 3;
            canvas.FillCircle(cx, cy, r + 2, 0xFF4f3d36);
            canvas.FillCircle(cx, cy, r, 0xFFff9a3c);
            canvas.FillRoundRect(cx - 2, cy - r + 4, 4, r, 2, 0xFFFFFFFF);
            canvas.FillCircle(cx, cy + r - 5, 2, 0xFFFFFFFF);
            animating = true;
        }
        if (particles.live > 0) {
            if (particles.Step(dt)) { animating = true; }
            particles.Paint(canvas);
        }
        if (animating) { app.RequestAnimationFrameIn(bx - 40, by - 60, bw + 80, bh + 100); }
    }
}

// 满屏彩纸（胜利/三星）。挂在根节点最后，盖在结算卡上面但不挡点击。
public class TrapCatConfetti : Control {
    const int Pieces = 110;
    const double Seconds = 3.2;
    double[] x;
    double[] y;
    double[] vx;
    double[] vy;
    double[] spin;
    int[] color;
    long startAt;
    long lastTick;
    bool active;

    TrapCatConfetti() {
        InitControl("Confetti");
        SetProp("class", "confetti-layer");
        NoOverlapCheck();
        x = new double[TrapCatConfetti.Pieces];
        y = new double[TrapCatConfetti.Pieces];
        vx = new double[TrapCatConfetti.Pieces];
        vy = new double[TrapCatConfetti.Pieces];
        spin = new double[TrapCatConfetti.Pieces];
        color = new int[TrapCatConfetti.Pieces];
    }

    override string Kind() { return "TrapCatConfetti"; }
    override void OnMeasure(App app) { prefW = 0; prefH = 0; }
    protected override Control HitTestCore(int x, int y, int pointerType, List<Control> excludedSubtrees) { return null; }

    void Stop() { active = false; }

    void Launch(long seed) {
        Random r = Random.Seeded(seed);
        int[] palette = new int[] { 0xff7d98, 0xffd54a, 0x6cb35a, 0x5fb7e8, 0xff9a3c, 0xb48cf0 };
        for (int i = 0; i < TrapCatConfetti.Pieces; i++) {
            x[i] = r.NextDouble();
            y[i] = -0.05 - r.NextDouble() * 0.5;
            vx[i] = (r.NextDouble() - 0.5) * 0.25;
            vy[i] = 0.25 + r.NextDouble() * 0.3;
            spin[i] = r.NextDouble() * 6.28;
            color[i] = palette[i % palette.Length];
        }
        startAt = Window.GetTickMs();
        lastTick = startAt;
        active = true;
    }

    override void OnPaint(App app) {
        if (!active || bw <= 0) { return; }
        long now = Window.GetTickMs();
        double t = (now - startAt) / 1000.0;
        if (t > TrapCatConfetti.Seconds) {
            active = false;
            app.RequestAnimationFrameIn(bx, by, bw, bh);
            return;
        }
        double dt = (now - lastTick) / 1000.0;
        if (dt > 0.05) { dt = 0.05; }
        lastTick = now;
        int alpha = t > TrapCatConfetti.Seconds - 0.6 ? (int)(255.0 * (TrapCatConfetti.Seconds - t) / 0.6) : 255;
        for (int i = 0; i < TrapCatConfetti.Pieces; i++) {
            x[i] += (vx[i] + Math.Sin(t * 3.0 + i) * 0.04) * dt;
            y[i] += vy[i] * dt;
            spin[i] += dt * (4.0 + i % 5);
            if (y[i] < -0.02 || y[i] > 1.05) { continue; }
            int w = (int)(Math.Abs(Math.Cos(spin[i])) * 9.0) + 2;
            int px = bx + (int)(x[i] * bw);
            int py = by + (int)(y[i] * bh);
            app.canvas.FillRect(px - w / 2, py - 5, w, 10, (alpha << 24) | color[i]);
        }
        app.RequestAnimationFrameIn(bx, by, bw, bh);
    }
}
