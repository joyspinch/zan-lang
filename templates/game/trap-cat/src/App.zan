using System;
using System.IO;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Game.Kit;

public class {{NAME}} {
    static Form form;
    static Control root;
    static TrapCatBoard board;
    static Button[] cells;
    static Button undo;
    static TrapCatSprite catSprite;
    static int level = 1;
    static long nextSeed;

    static Control RequireControl(string id) {
        Control control = root.Find(id);
        if (control == null) { throw new Exception("Missing game control: " + id); }
        return control;
    }

    static void Main() {
        board = new TrapCatBoard();
        cells = new Button[TrapCatBoard.Count];
        nextSeed = Window.GetTickMs();
        string fixedSeed = Environment.GetEnvironmentVariable("ZAN_TRAP_CAT_SEED");
        if (fixedSeed != "") { nextSeed = Convert.ToInt32(fixedSeed); }
        form = Form.Create("围住神经猫", 600, 760);
        App app = form.GetApp();
        app.SetPartialFrames(true);
        #if ANDROID
        app.SetChromeVisible(false);
        #endif
        app.CenterWindow();
        app.EnableSkins(0);
        Html.Install();
        HtmlHandlers handlers = new HtmlHandlers();
        handlers.AddArg("cell", (string arg) => {{NAME}}.PickCell(arg));
        handlers.AddArg("difficulty", (string arg) => {{NAME}}.SetDifficulty(arg));
        handlers.Add("new-round", () => {{NAME}}.NewRound());
        handlers.Add("undo", () => {{NAME}}.Undo());
        string html = DesignDoc.ReadFile("src/TrapCat.html");
        root = app.LoadHtmlWith(html, handlers, "");
        root.DockFill();
        form.Add(root);
        for (int i = 0; i < TrapCatBoard.Count; i++) {
            cells[i] = (Button){{NAME}}.RequireControl("Cell" + Convert.ToString(i));
            cells[i].FreeLayout();
            cells[i].Tip = "封住第 " + Convert.ToString(i / TrapCatBoard.Size + 1) + " 行、第 " + Convert.ToString(i % TrapCatBoard.Size + 1) + " 个圆点";
        }
        catSprite = new TrapCatSprite(cells);
        {{NAME}}.RequireControl("Board").Add(catSprite);
        {{NAME}}.SetupBoardArt();
        undo = (Button){{NAME}}.RequireControl("Undo");
        {{NAME}}.NewRound();
        form.FrameHook(() => {{NAME}}.PublishProbes());
        form.Run();
    }

    // 棋盘底图：assets/cell.png 找不到就把 <img> 藏掉——
    // 圆点照样是圆点，模板被拷走没带图也不影响玩法。
    static void SetupBoardArt() {
        Control bg = {{NAME}}.RequireControl("BoardBg");
        string path = Assets.Find("assets/cell.png");
        if (path != null && File.Exists(path)) {
            ((Image)bg).Src = path;
            return;
        }
        bg.visible = false;
    }

    static void NewRound() {
        board.NewRound(level, nextSeed);
        nextSeed++;
        catSprite.Reset(board.cat, board.result);
        {{NAME}}.Refresh();
    }

    static void SetDifficulty(string arg) {
        level = Convert.ToInt32(arg);
        {{NAME}}.NewRound();
    }

    static void PickCell(string arg) {
        if (board.Block(Convert.ToInt32(arg))) {
            catSprite.WalkTo(board.cat, board.result);
            {{NAME}}.Refresh();
        }
    }

    static void Undo() {
        if (board.Undo()) {
            catSprite.Reset(board.cat, board.result);
            {{NAME}}.Refresh();
        }
    }

    static void Refresh() {
        for (int i = 0; i < TrapCatBoard.Count; i++) {
            Button cell = cells[i];
            string state = board.blocked[i] ? "blocked" : "open";
            if (i == board.cat) { state = "cat"; }
            cell.SetClassIn("open blocked cat", state);
            cell.Text = "";
            cell.Disabled = board.result != TrapCatResult.Playing || board.blocked[i] || i == board.cat;
        }
        for (int i = 0; i < 3; i++) {
            Control mode = {{NAME}}.RequireControl("Level" + Convert.ToString(i));
            mode.SetClassIn("selected", i == level ? "selected" : "");
        }
        undo.Disabled = board.moves == 0;
        {{NAME}}.RequireControl("Moves").SetProp("text", Convert.ToString(board.moves) + " 步");
        string headline = "猫还在寻找出口";
        string hint = "点击空圆点封路，它会沿最短路线走一步。";
        string resultClass = "playing";
        if (board.result == TrapCatResult.Trapped) {
            headline = "围住了！这只猫服气了";
            hint = "你用了 " + Convert.ToString(board.moves) + " 步切断所有出口，再来一局？";
            resultClass = "won";
        } else if (board.result == TrapCatResult.Escaped) {
            headline = "哎呀，猫溜走了";
            hint = "它已经到达边缘。可以悔棋，试试提前堵住远处的路。";
            resultClass = "lost";
        }
        {{NAME}}.RequireControl("Status").SetProp("text", headline);
        {{NAME}}.RequireControl("Hint").SetProp("text", hint);
        {{NAME}}.RequireControl("Result").SetClassIn("playing won lost", resultClass);
        form.GetApp().RequestRedraw();
    }

    static void PublishProbes() {
        if (!UiDriver.Active()) { return; }
        UiDriver.SetProbe("trap.moves", Convert.ToString(board.moves));
        UiDriver.SetProbe("trap.cat", Convert.ToString(board.cat));
        UiDriver.SetProbe("trap.level", Convert.ToString(level));
        string result = board.result == TrapCatResult.Trapped ? "won" : (board.result == TrapCatResult.Escaped ? "lost" : "playing");
        UiDriver.SetProbe("trap.result", result);
        for (int i = 0; i < TrapCatBoard.Count; i++) {
            UiDriver.SetProbe("id.Cell" + Convert.ToString(i), Convert.ToString(cells[i].wid));
        }
        for (int i = 0; i < 3; i++) {
            Button mode = (Button){{NAME}}.RequireControl("Level" + Convert.ToString(i));
            UiDriver.SetProbe("id.Level" + Convert.ToString(i), Convert.ToString(mode.wid));
        }
        UiDriver.SetProbe("id.Undo", Convert.ToString(undo.wid));
        Button restart = (Button){{NAME}}.RequireControl("NewRound");
        UiDriver.SetProbe("id.NewRound", Convert.ToString(restart.wid));
    }
}
