using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 6「沙巴克」——照原版还原（`沙巴克.png`）。
///
///   · 左（主窗 724×715）：头带（`沙巴克` 金标题 + 攻城时间/占领公会/占领时间
///     + 右侧 `申请攻沙`/`行会排名` 两钮）→ 两组奖励格（左 6 + 右 4）→
///     沙巴克攻城殿大图 `assets/ui/00205.gif`（483×328 原寸 → 1.5× 铺满），
///     图上压城主立绘 `ui/00046.jpg` + `龙卫——圣战` + `膜拜沙巴克城主` 钮
///   · 右：编号 / 行会名称 / 申请日期 三列 12 行槽（8 行有数据）+
///     页脚 `战役日志` 钮 + 标准库 Pagination
///
/// 右栏面板与邮箱页（29）是**同一块**（x 1103..1490 / 头带 47 / 行节距 50），
/// 故尺寸一律引 `Spec.Side*`（`Ml*` 的别名，见 Spec），本页只补左区尺寸与
/// 三列列宽。列表本体走共享组件 `TableUi.zan` 的 `TblPad/TblHeadAt`；
/// 奖励格走 `Slots.zan` 的 `SlotArt`——本页不自绘、不自己搭骨架。
///
/// 原版特征照抄不"修"：申请日期列被面板右缘裁掉秒的个位（原版页就这样）。
/// 申请攻沙 / 行会排名 / 膜拜 / 战役日志 的玩法未接，按本模板惯例给一句明确
/// 反馈，不假装已实现。
partial class LegendApp {

    /// 一行申请（编号即行号 +1）。
    class BashaApply {
        string guild;
        string date;
    }

    /// 8 行申请行会（照 `沙巴克.png` 逐行抄；秒的个位原版被右缘裁掉，
    /// 这里按抄到的位数存，不再补「?」）。
    static List<BashaApply> BashaData() {
        string[] guilds = new string[] {
            "哇卡卡", "天上人间", "第一个行会", "自由之翼",
            "大食堂", "永恒总会", "大口吃肉", "滥竽充数"
        };
        string[] dates = new string[] {
            "2026-08-03 00:08:1", "2026-08-03 06:49:2", "2026-08-03 07:02:3",
            "2026-08-03 07:15:4", "2026-08-03 13:49:2", "2026-08-03 13:56:1",
            "2026-08-03 19:54:1", "2026-08-03 20:47:0"
        };
        List<BashaApply> rows = new List<BashaApply>();
        for (int i = 0; i < 8; i = i + 1) {
            BashaApply r = new BashaApply();
            r.guild = guilds[i]; r.date = dates[i];
            rows.Add(r);
        }
        return rows;
    }

    /// 一处奖励格（图标号 + 堆叠数；0 = 不画角标）。
    class BashaGift {
        int picture;
        int count;
    }

    static BashaGift GiftOf(int picture, int count) {
        BashaGift g = new BashaGift();
        g.picture = picture; g.count = count;
        return g;
    }

    /// 「占领沙巴克可获得以下奖励」6 格（照图：两格空、其余带数）。
    static List<BashaGift> BashaGiftLeft() {
        List<BashaGift> v = new List<BashaGift>();
        v.Add(GiftOf(0, 0)); v.Add(GiftOf(0, 0));
        v.Add(GiftOf(27, 10000)); v.Add(GiftOf(31, 3000));
        v.Add(GiftOf(44, 30000)); v.Add(GiftOf(62, 300));
        return v;
    }

    /// 「战役中随机获得」4 格。
    static List<BashaGift> BashaGiftRight() {
        List<BashaGift> v = new List<BashaGift>();
        v.Add(GiftOf(27, 100)); v.Add(GiftOf(15, 10));
        v.Add(GiftOf(19, 0)); v.Add(GiftOf(44, 100));
        return v;
    }

    void BuildBashaPage() {
        Panel frame = Panel.Row(); frame.Class = "bh-frame";
        frame.Pad(0); frame.Gap(Spec.BhColGap());
        frame.Prefer(0, Spec.BhFrameH());
        frame.Padding(Spec.BhFramePadT(), 0, 0, 0);
        content.With(frame);
        frame.With(BashaMain());
        frame.With(BashaSide());
    }

    // ------------------------------------------------------------------
    //  左：头带 / 奖励 / 场景
    // ------------------------------------------------------------------

    Panel BashaMain() {
        Panel col = Panel.Column(); col.Class = "mk-left mk-fixed";
        col.Pad(0); col.Gap(0); col.Prefer(Spec.BhMainW(), 0);
        col.With(BashaHead());
        col.With(BashaRewards());
        col.With(TblPad(Spec.BhSceneGap()));
        col.With(BashaScene());
        return col;
    }

    /// 头带：左「标题 + 两行信息」、右两钮，整行居中。
    Panel BashaHead() {
        Panel head = Panel.Row(); head.Class = "bh-band";
        head.Pad(0); head.Gap(0); head.Prefer(0, Spec.BhHeadH());
        head.Padding(0, Spec.BhHeadPadR(), 0, Spec.BhHeadPadL());

        Panel info = Panel.Column(); info.Pad(0); info.Gap(0);
        info.Grow(); head.With(info);

        Panel r1 = Panel.Row(); r1.Pad(0); r1.Gap(Spec.BhInfoGap());
        r1.Prefer(0, Spec.BhTitleH()); info.With(r1);
        r1.With(Text("沙巴克", "bh-title", 0));
        r1.With(BashaKV("攻城时间：", "08-09 18:00", "bh-k-orange"));

        Panel r2 = Panel.Row(); r2.Pad(0); r2.Gap(Spec.BhInfoGap());
        r2.Prefer(0, Spec.BhInfoH()); info.With(r2);
        r2.With(BashaKV("占领公会：", "永恒总会", "bh-k-green"));
        r2.With(BashaKV("占领时间：", "2026-08-02 18:27:44", "bh-k-yellow"));

        Panel btns = Panel.Column(); btns.Pad(0); btns.Gap(Spec.BhBtnGap());
        btns.Prefer(Spec.BhBtnW(), 0); head.With(btns);
        btns.With(BtnDev("申请攻沙", "tbl-btn bh-btn", Spec.BhBtnW(), Spec.BhBtnH(),
            () => { BashaSay("申请攻沙需要行会会长在攻城时间内提交申请。"); }));
        btns.With(BtnDev("行会排名", "tbl-btn bh-btn", Spec.BhBtnW(), Spec.BhBtnH(),
            () => { BashaSay("行会排名见「行会」页与「排行榜」页。"); }));
        return head;
    }

    /// 「标签 + 值」一对：标签自己着色，值统一白。
    Panel BashaKV(string k, string v, string kCls) {
        Panel row = Panel.Row(); row.Pad(0); row.Gap(0);
        row.With(Text(k, "bh-k " + kCls, 0));
        row.With(Text(v, "bh-v", 0));
        return row;
    }

    /// 奖励区：左组 6 格 + 右组 4 格，各带一行金标题。
    Panel BashaRewards() {
        Panel rw = Panel.Row(); rw.Class = "bh-reward";
        rw.Pad(0); rw.Gap(Spec.BhRewardGap());
        rw.Prefer(0, Spec.BhRewardH());
        rw.Padding(0, 0, 0, Spec.BhRewardPadL());
        rw.With(BashaGiftGroup("占领沙巴克可获得以下奖励：", BashaGiftLeft()));
        Panel fill = Panel.Row(); fill.Grow(); rw.With(fill);
        rw.With(BashaGiftGroup("战役中随机获得：", BashaGiftRight()));
        return rw;
    }

    Panel BashaGiftGroup(string title, List<BashaGift> gifts) {
        Panel col = Panel.Column(); col.Pad(0); col.Gap(0);
        col.Prefer(gifts.Count * Spec.BhSlotW()
            + (gifts.Count - 1) * Spec.BhSlotGap(), 0);
        Panel t = Panel.Row(); t.Pad(0); t.Prefer(0, Spec.BhRewardTitleH());
        t.With(Text(title, "bh-reward-t", 0)); col.With(t);
        Panel row = Panel.Row(); row.Pad(0); row.Gap(Spec.BhSlotGap());
        row.Prefer(0, Spec.BhSlotH()); col.With(row);
        for (int i = 0; i < gifts.Count; i = i + 1) {
            BashaGift g = gifts[i];
            if (g.picture <= 0) {
                row.With(CellEmpty(Spec.BhSlotW(), Spec.BhSlotH()));
            } else {
                string badge = g.count > 0 ? Rules.N(g.count) : "";
                row.With(SlotArt(Spec.BhSlotW(), Spec.BhSlotH(),
                    ItemArtPath(g.picture), badge, "slot-badge"));
            }
        }
        return col;
    }

    /// 场景：整张攻城殿大图 + 压图城主立绘 / 名字 / 膜拜钮 / 右上帮助钮。
    Panel BashaScene() {
        Panel scene = Panel.Column(); scene.Class = "bh-scene";
        scene.Pad(0); scene.Prefer(Spec.BhMainW(), Spec.BhSceneH());
        Image art = new Image("assets/ui/00205.gif", "沙巴克", "fill");
        art.DockFill(); scene.Add(art);
        Panel face = Panel.Row(); face.Class = "bh-face";
        face.Pad(0); face.Prefer(Spec.BhFaceW(), Spec.BhFaceH());
        Image pic = new Image("assets/ui/00046.jpg", "城主", "cover");
        pic.DockFill(); face.Add(pic);
        scene.With(face);
        scene.With(CenterRow("龙卫——圣战", "bh-name-row", "bh-name", 0, Spec.BhNameH()));
        scene.With(CenterRow("膜拜沙巴克城主", "bh-worship-row", "bh-worship",
            Spec.BhWorshipW(), Spec.BhWorshipH()));
        Panel help = Panel.Row(); help.Class = "bh-help";
        help.Pad(0); help.Prefer(Spec.BhHelpW(), Spec.BhHelpH());
        help.With(BtnDev("?帮助", "tbl-btn bh-btn", Spec.BhHelpW(), Spec.BhHelpH(),
            () => { BashaSay("沙巴克每周六 18:00 开战，占领行会可获得全服奖励。"); }));
        scene.With(help);
        return scene;
    }

    // ------------------------------------------------------------------
    //  右：申请行会列表（与邮箱页同一块面板）
    // ------------------------------------------------------------------

    Panel BashaSide() {
        Panel col = Panel.Column(); col.Class = "bh-side mk-fill";
        col.Pad(0); col.Gap(0);

        List<string> heads = new List<string>();
        heads.Add("编号"); heads.Add("行会名称"); heads.Add("申请日期");
        List<int> ws = new List<int>();
        ws.Add(Spec.BhIdW()); ws.Add(Spec.BhGuildW()); ws.Add(Spec.BhDateW());
        col.With(TblHeadAt(heads, ws, Spec.SideHeadH(), Spec.BhCellGap(),
                           Spec.BhRowPadL()));

        col.With(TblPad(Spec.SideHeadToRow()));
        List<BashaApply> rows = BashaData();
        for (int r = 0; r < Spec.SideRows(); r = r + 1) {
            Panel row = Panel.Row(); row.Class = "tbl-row";
            row.Pad(0); row.Gap(Spec.BhCellGap());
            row.Prefer(0, Spec.SideRowH());
            row.Padding(0, Spec.BhRowPadR(), 0, Spec.BhRowPadL());
            string id = r < rows.Count ? Rules.N(r + 1) : "";
            string guild = r < rows.Count ? rows[r].guild : "";
            string date = r < rows.Count ? rows[r].date : "";
            row.With(TblCellClsAt(id, "tbl-c1", Spec.BhIdW(), "tbl-cell",
                                Spec.SideRowH()));
            row.With(TblCellClsAt(guild, "tbl-c2", Spec.BhGuildW(), "tbl-cell",
                                Spec.SideRowH()));
            row.With(TblCellClsAt(date, "tbl-c1", Spec.BhDateW(), "tbl-cell",
                                Spec.SideRowH()));
            col.With(row);
            if (r + 1 < Spec.SideRows()) { col.With(TblPad(Spec.SideRowGap())); }
        }

        col.With(TblPad(Spec.SideRowsToFoot()));
        Panel f = Panel.Row(); f.Class = "bh-sidefoot";
        f.Pad(0); f.Gap(Spec.BhFootBtnGap());
        f.Prefer(0, Spec.SideFootH());
        f.Padding(0, Spec.BhFootPadR(), 0, Spec.BhFootPadL());
        f.With(BtnDev("战役日志", "tbl-btn bh-btn", Spec.BhLogW(), Spec.SideFootH(),
            () => { BashaSay("战役日志记录本行会的历次攻城战报。"); }));
        Panel sp = Panel.Row(); sp.Class = "mk-fill"; sp.Pad(0); f.With(sp);
        SignalInt pgSig = new SignalInt(1);
        Pagination pg = new Pagination(1, pgSig);
        pg.Class = "simple";
        pg.PrevText("上一页"); pg.NextText("下一页");
        pg.Named("basha-pager");
        f.With(pg);
        col.With(f);
        return col;
    }

    /// 玩法未接：按本模板惯例给一句明确反馈。
    void BashaSay(string msg) {
        if (net.Self() != null) { net.AddChat("[系统]", msg); return; }
        g.Log(msg);
    }
}
