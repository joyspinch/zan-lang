using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 25「称谓」——照原版逐像素还原（`mir2/mir/称谓.png`）。
///
/// 10 列 × 12 行：称谓 / 需要声望 / 需要金钱 / 等级 / 攻击 / 魔法 / 道术 /
/// 防御 / 魔防 / 领取。表头带满宽青字，数据格各自成框（格间缝露出容器
/// 底色），末列「领取」是深底亮蓝框钮。页脚：左「当前称谓：无」、右
/// 「说明」钮 + 标准库 Pagination（「上一页 1/21 下一页」）。
///
/// 表格本体全部走共享组件 `TableUi.zan`（`TblBox/TblHead/TblRow/
/// TblActionRow/TblFoot`），本页只提供数据与逐列配色类名。
///
/// 配色（原版实测）：称谓橙、声望白、金钱黄、等级青；属性五列各有固定色
/// （攻击品红 / 魔法蓝 / 道术绿 / 防御黄 / 魔防紫），**值为 `0 - 0` 时统一
/// 转灰**——原版就是这样把「这一阶还没这项加成」区分出来的。
partial class LegendApp {
    /// 当前称谓页号（0 起始）：翻页后重建时 pager 从它恢复，不再回跳第 1 页。
    int titlePageNo = 0;
    /// 表头十列。
    static List<string> TitleHeads() {
        List<string> h = new List<string>();
        h.Add("称谓"); h.Add("需要声望"); h.Add("需要金钱"); h.Add("等级");
        h.Add("攻击"); h.Add("魔法"); h.Add("道术"); h.Add("防御");
        h.Add("魔防"); h.Add("领取");
        return h;
    }

    /// 一档加成（最小–最大，原版都写成「0 - 1」）。**0 - 0 一律灰**是原版
    /// 的语义（这一阶还没有这项加成），原先靠比较字符串 `val == "0 - 0"`
    /// 判定——数值化之后是 `Zero()`。
    class Pair {
        int min;
        int max;
        bool Zero() { return min == 0 && max == 0; }
        string Text() { return Rules.N(min) + " - " + Rules.N(max); }
    }

    static Pair PairOf(int min, int max) {
        Pair p = new Pair();
        p.min = min; p.max = max;
        return p;
    }

    /// 一行称谓数据。**一行一实体**——原先是 9 个平行数组（称谓 / 声望 /
    /// 金钱 / 等级 / 攻击 / 魔法 / 道术 / 防御 / 魔防）靠下标对齐，而且
    /// **魔法列的颜色是拿攻击列的值判的**（`TitleAttrCls(5, atk[r])`）：
    /// 一旦两列数值不同，魔法列的灰/彩就会错。现在每列自带自己那档加成。
    /// 等级拆成转数 + 等级（原版「1转10级」），声望/金钱存数值（原版是
    /// 万位分隔「1,0000」）。
    class TitleRow {
        string name;
        long fame;              // 需要声望
        long gold;              // 需要金钱
        int rebirth;            // 转数（0 = 未转）
        int level;
        Pair atk;
        Pair mag;
        Pair tao;
        Pair def;
        Pair mdef;
        string FameText() { return Rules.Wan(fame); }
        string GoldText() { return Rules.Wan(gold); }
        string LevelText() {
            string pre = rebirth > 0 ? Rules.N(rebirth) + "转" : "";
            return pre + Rules.N(level) + "级";
        }
    }

    /// 12 行称谓数据（照 `称谓.png` 逐行抄录）。称谓名是专名（筑基/开光/融合
    /// 各阶），不推导；数值列全部按数存。
    static List<TitleRow> titleData = null;
    static List<TitleRow> TitleData() {
        if (titleData != null) { return titleData; }
        List<TitleRow> v = new List<TitleRow>();
        v.Add(TitleRowOf("筑基·一阶", 100, 100000, 0, 1, PairOf(0, 1), PairOf(0, 1),
                         PairOf(0, 0), PairOf(0, 0), PairOf(0, 0)));
        v.Add(TitleRowOf("筑基·二阶", 1000, 500000, 0, 10, PairOf(0, 1), PairOf(0, 1),
                         PairOf(0, 1), PairOf(0, 0), PairOf(0, 0)));
        v.Add(TitleRowOf("筑基·三阶", 2000, 1000000, 0, 20, PairOf(0, 2), PairOf(0, 2),
                         PairOf(0, 2), PairOf(0, 1), PairOf(0, 0)));
        v.Add(TitleRowOf("筑基·四阶", 5000, 2000000, 0, 30, PairOf(0, 3), PairOf(0, 3),
                         PairOf(0, 3), PairOf(0, 2), PairOf(0, 1)));
        v.Add(TitleRowOf("筑基·五阶", 10000, 3000000, 0, 40, PairOf(0, 4), PairOf(0, 4),
                         PairOf(0, 4), PairOf(0, 3), PairOf(0, 2)));
        v.Add(TitleRowOf("开光·一阶", 15000, 4000000, 0, 50, PairOf(0, 5), PairOf(0, 5),
                         PairOf(0, 5), PairOf(0, 4), PairOf(0, 3)));
        v.Add(TitleRowOf("开光·二阶", 20000, 5000000, 0, 60, PairOf(0, 6), PairOf(0, 6),
                         PairOf(0, 6), PairOf(0, 5), PairOf(0, 4)));
        v.Add(TitleRowOf("开光·三阶", 50000, 10000000, 1, 10, PairOf(1, 7), PairOf(1, 7),
                         PairOf(1, 7), PairOf(1, 6), PairOf(1, 5)));
        v.Add(TitleRowOf("开光·四阶", 80000, 13500000, 1, 20, PairOf(1, 9), PairOf(1, 9),
                         PairOf(1, 9), PairOf(1, 7), PairOf(1, 6)));
        v.Add(TitleRowOf("开光·五阶", 110000, 17000000, 1, 30, PairOf(1, 11), PairOf(1, 11),
                         PairOf(1, 11), PairOf(1, 8), PairOf(1, 7)));
        v.Add(TitleRowOf("融合·一阶", 140000, 20500000, 1, 40, PairOf(1, 13), PairOf(1, 13),
                         PairOf(1, 13), PairOf(1, 9), PairOf(1, 8)));
        v.Add(TitleRowOf("融合·二阶", 170000, 24000000, 1, 50, PairOf(1, 15), PairOf(1, 15),
                         PairOf(1, 15), PairOf(1, 10), PairOf(1, 9)));
        titleData = v;
        return titleData;
    }

    static TitleRow TitleRowOf(string name, long fame, long gold, int rebirth,
                               int level, Pair atk, Pair mag, Pair tao,
                               Pair def, Pair mdef) {
        TitleRow r = new TitleRow();
        r.name = name; r.fame = fame; r.gold = gold;
        r.rebirth = rebirth; r.level = level;
        r.atk = atk; r.mag = mag; r.tao = tao; r.def = def; r.mdef = mdef;
        return r;
    }

    /// 属性列配色类名：`0 - 0` 一律灰（原版语义），否则按列取色。
    static string TitleAttrCls(int col, Pair p) {
        if (p.Zero()) { return "tbl-attr tbl-zero"; }
        if (col == 4) { return "tbl-attr tbl-atk"; }
        if (col == 5) { return "tbl-attr tbl-mag"; }
        if (col == 6) { return "tbl-attr tbl-tao"; }
        if (col == 7) { return "tbl-attr tbl-def"; }
        return "tbl-attr tbl-mdef";
    }

    void BuildTitlePage() {
        /* 联机：进页拉一次称谓表（服务端 251 行 / 21 页，页号走 page 参数）；
           应答到达 Bump 重建后走下方 playTitle 渲染分支。 */
        net.MaybeRefreshTitle();
        bool online = net.Self() != null && net.TypedTitle() != null && net.TypedTitle().Titles.Count > 0;

        Panel page0 = Panel.Column(); page0.Class = "tbl-page";
        page0.Pad(0); page0.Gap(0); page0.Grow(); content.With(page0);

        /* 表格容器上缘 = 页内容顶（原版 164），故不加任何前导留白。 */
        List<int> ws = Spec.TblNameCols();
        Panel box = TblBox(); page0.With(box);
        box.With(TblHead(TitleHeads(), ws));

        Panel headGap = Panel.Row(); headGap.Pad(0);
        headGap.Prefer(0, Spec.TblHeadGap()); box.With(headGap);

        Panel wall = Panel.Column(); wall.Pad(0); wall.Gap(Spec.TblRowGap());
        box.With(wall);

        /* 联机渲染服务端行（一行一实体照旧映射到 TitleRow）；离线保持
           演示数据。最后一页可能不足 12 行，按实际行数铺。 */
        List<TitleRow> rows;
        if (online) {
            rows = new List<TitleRow>();
            List<TitleItem> a = net.TypedTitle().Titles;
            for (int i = 0; i < a.Count; i = i + 1) {
                TitleItem x = a[i];
                rows.Add(TitleRowOf(
                    x.Name,
                    x.Fame, x.Gold,
                    x.Rebirth, x.Level,
                    PairOf(x.AtkMin, x.AtkMax),
                    PairOf(x.MagMin, x.MagMax),
                    PairOf(x.TaoMin, x.TaoMax),
                    PairOf(x.DefMin, x.DefMax),
                    PairOf(x.MdefMin, x.MdefMax)));
            }
        } else {
            rows = TitleData();
        }
        int nRows = rows.Count;
        for (int r = 0; r < nRows; r = r + 1) {
            TitleRow ti = rows[r];
            List<string> cells = new List<string>();
            cells.Add(ti.name); cells.Add(ti.FameText()); cells.Add(ti.GoldText());
            cells.Add(ti.LevelText()); cells.Add(ti.atk.Text());
            cells.Add(ti.mag.Text()); cells.Add(ti.tao.Text());
            cells.Add(ti.def.Text()); cells.Add(ti.mdef.Text());
            List<string> cls = new List<string>();
            cls.Add("tbl-c0"); cls.Add("tbl-c1"); cls.Add("tbl-c2");
            cls.Add("tbl-c3");
            cls.Add(TitleAttrCls(4, ti.atk));
            cls.Add(TitleAttrCls(5, ti.mag));
            cls.Add(TitleAttrCls(6, ti.tao));
            cls.Add(TitleAttrCls(7, ti.def));
            cls.Add(TitleAttrCls(8, ti.mdef));
            wall.With(TblActionRow(cells, cls, ws, r, "领取", "tbl-btn",
                                   () => { TitleClaim(ti); }));
        }
        box.With(TblPad(Spec.TblBottomPad()));

        Panel footGap = Panel.Row(); footGap.Pad(0);
        footGap.Prefer(0, Spec.TblFootGap()); page0.With(footGap);

        /* 页数：联机取服务端 pages（251 行 / title_page_size=12 → 21 页），
           翻页发 {"op":"title","page":N}；离线保持演示的 21。 */
        int pages = online ? net.TitlePages() : 21;
        SignalInt pgSig = new SignalInt(this.titlePageNo + 1);
        Pagination pg = new Pagination(pages, pgSig);
        pg.Class = "simple";
        pg.PrevText("上一页"); pg.NextText("下一页");
        pg.Named("title-pager");
        /* 只发请求：应答到达 Bump 重建，pager 从 titlePageNo 恢复页号。 */
        pg.Change += () => {
            if (net.Self() != null) {
                this.titlePageNo = pgSig.Get() - 1;
                if (this.titlePageNo < 0) { this.titlePageNo = 0; }
                if (this.titlePageNo > pages - 1) { this.titlePageNo = pages - 1; }
                net.TitlePage(this.titlePageNo);
            }
        };
        /* 当前称谓：联机读 self.title（领取/佩戴后随 self 下发）。 */
        string cur = "无";
        if (online) {
            PlayerState st = net.SelfState();
            if (st != null && st.Title.Length > 0) { cur = st.Title; }
        }
        page0.With(TblFoot(TblFootNote("当前称谓：", cur, "tbl-note-v"), pg));
    }

    /// 「领取」钮：联机走 unlock（声望×pct + 金币，服务端权威判定），
    /// 离线按模板惯例给明确反馈（不假装已实现）。
    void TitleClaim(TitleRow tr) {
        if (net.Self() != null) { net.TitleUnlock(tr.name); return; }
        g.Log("领取称谓：" + tr.name);
    }
}
