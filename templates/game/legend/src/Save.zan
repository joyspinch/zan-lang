using System;
using System.IO;
using System.Json;
namespace Legend;

// 数据库连接池与实体映射状态同步契约。
class SaveStore {
    string path;
    string error = "";
    bool writable = true;
    SaveStore(string file) { path = file; }
    static string DefaultPath() {
        string dir = KnownFolders.GetEnv("LEGEND_SAVE_DIR");
        if (dir == "") { dir = KnownFolders.GetEnv("LOCALAPPDATA"); if (dir == "") { dir = "."; } dir = dir + "/ZanLegend"; }
        Directory.CreateDirectoryRecursive(dir);
        return dir + "/hero-v2.json";
    }
    static JsonValue Encode(Game g) {
        JsonValue j = JsonValue.NewObject(); Rules.Put(j, "version", 10);
        Rules.Put(j, "job", g.job);
        Rules.Put(j, "level", g.level);
        Rules.Put(j, "xp", g.xp);
        Rules.Put(j, "rebirth", g.rebirth);
        Rules.Put(j, "gold", g.gold);
        Rules.Put(j, "gems", g.gems);
        Rules.Put(j, "iron", g.iron);
        Rules.Put(j, "runes", g.runes);
        JsonValue runeCounts = JsonValue.NewArray(); for (int i = 0; i < 14; i = i + 1) { runeCounts.Append(JsonValue.NewNum(Rules.N(g.runeCounts[i]))); } j.Put("runeCounts", runeCounts);
        Rules.Put(j, "legendOre", g.legendOre);
        JsonValue dragonBalls = JsonValue.NewArray(); for (int i = 0; i < 9; i = i + 1) { dragonBalls.Append(JsonValue.NewNum(Rules.N(g.dragonBalls[i]))); } j.Put("dragonBalls", dragonBalls);
        Rules.Put(j, "potions", g.potions);
        Rules.Put(j, "floor", g.floor);
        Rules.Put(j, "best", g.best);
        Rules.Put(j, "wave", g.wave);
        Rules.Put(j, "kills", g.kills);
        Rules.Put(j, "deaths", g.deaths);
        Rules.Put(j, "skill", g.skill);
        JsonValue skillRanks = JsonValue.NewArray(); JsonValue skillEquipped = JsonValue.NewArray();
        for (int i = 0; i < 8; i = i + 1) { skillRanks.Append(JsonValue.NewNum(Rules.N(g.skillRanks[i]))); skillEquipped.Append(JsonValue.NewNum(g.skillEquipped[i] ? "1" : "0")); }
        j.Put("skillRanks", skillRanks); j.Put("skillEquipped", skillEquipped);
        Rules.Put(j, "training", g.training); Rules.Put(j, "tp", g.tp);
        JsonValue inner = JsonValue.NewArray(); for (int i = 0; i < 8; i = i + 1) { inner.Append(JsonValue.NewNum(Rules.N(g.innerRanks[i]))); } j.Put("innerRanks", inner);
        JsonValue gems = JsonValue.NewArray(); for (int i = 0; i < 6; i = i + 1) { gems.Append(JsonValue.NewNum(Rules.N(g.gemRanks[i]))); } j.Put("gemRanks", gems);
        Rules.Put(j, "title", g.title);
        Rules.Put(j, "merit", g.merit);
        Rules.Put(j, "guild", g.guild);
        Rules.Put(j, "tower", g.tower);
        Rules.Put(j, "arenaWins", g.arenaWins);
        Rules.Put(j, "collection", g.collection);
        Rules.Put(j, "quest", g.quest);
        Rules.Put(j, "capacity", g.capacity);
        Rules.Put(j, "filter", g.filter);
        Rules.Put(j, "filterCoefficient", g.filterCoefficient);
        Rules.Put(j, "filterMinLevel", g.filterMinLevel);
        Rules.Put(j, "filterJobOnly", g.filterJobOnly ? 1 : 0);
        Rules.Put(j, "seed", g.seed);
        Rules.Put(j, "hp", g.hp);
        Rules.Put(j, "mp", g.mp);
        Rules.Put(j, "enemyHp", g.enemyHp);
        Rules.Put(j, "enemyMax", g.enemyMax);
        Rules.Put(j, "enemyAttack", g.enemyAttack);
        Rules.Put(j, "enemyDefense", g.enemyDefense);
        Rules.Put(j, "mode", g.mode);
        Rules.Put(j, "challenge", g.challenge);
        Rules.Put(j, "round", g.round);
        Rules.Put(j, "recovery", g.recovery);
        Rules.Put(j, "tick", g.tick);
        Rules.Put(j, "day", g.day);
        Rules.Put(j, "savedAt", g.savedAt);
        Rules.Put(j, "dailyClaim", g.dailyClaim);
        Rules.Put(j, "dailyKills", g.dailyKills);
        Rules.Put(j, "bountyClaim", g.bountyClaim);
        Rules.Put(j, "bossTries", g.bossTries);
        Rules.Put(j, "arenaTries", g.arenaTries);
        Rules.Put(j, "escortTries", g.escortTries);
        Rules.Put(j, "escortLeft", g.escortLeft);
        Rules.Put(j, "escortReward", g.escortReward);
        Rules.Put(j, "treasurePity", g.treasurePity);
        Rules.Put(j, "treasureMaps", g.treasureMaps);
        Rules.Put(j, "treasureDraws", g.treasureDraws);
        Rules.Put(j, "bossWins", g.bossWins);
        Rules.Put(j, "secrets", g.secrets);
        Rules.Put(j, "secretFloor", g.secretFloor);
        Rules.Put(j, "secretWave", g.secretWave);
        Rules.Put(j, "travelMap", g.travelMap);
        Rules.Put(j, "homeFloor", g.homeFloor); Rules.Put(j, "homeWave", g.homeWave);
        Rules.Put(j, "elementPool", g.elementPool);
        Rules.Put(j, "elementSeconds", g.elementSeconds);
        Rules.Put(j, "reputation", g.reputation);
        Rules.Put(j, "redPackets", g.redPackets);
        Rules.Put(j, "recyclePoints", g.recyclePoints);
        Rules.Put(j, "altarPersonal", g.altarPersonal);
        Rules.Put(j, "altarWorld", g.altarWorld);
        Rules.Put(j, "altarJackpots", g.altarJackpots);
        Rules.Put(j, "altarDonations", g.altarDonations);
        Rules.Put(j, "secretAutoPush", g.secretAutoPush ? 1 : 0);
        Rules.Put(j, "fieldActive", g.fieldActive ? 1 : 0);
        Rules.Put(j, "bossAutoNext", g.bossAutoNext ? 1 : 0);
        Rules.Put(j, "elementTraining", g.elementTraining ? 1 : 0);
        JsonValue elementRanks = JsonValue.NewArray(); for (int i = 0; i < 5; i = i + 1) { elementRanks.Append(JsonValue.NewNum(Rules.N(g.elementRanks[i]))); } j.Put("elementRanks", elementRanks);
        JsonValue elementXp = JsonValue.NewArray(); for (int i = 0; i < 5; i = i + 1) { elementXp.Append(JsonValue.NewNum(Rules.N(g.elementXp[i]))); } j.Put("elementXp", elementXp);

        Rules.Put(j, "recycled", g.recycled);
        Rules.Put(j, "earned", g.earned);
        Rules.Put(j, "active", g.active ? 1 : 0); Rules.Put(j, "autoPush", g.autoPush ? 1 : 0); Rules.Put(j, "autoPotion", g.autoPotion ? 1 : 0);
        j.Put("enemyName", JsonValue.NewStr(g.enemyName));
        JsonValue gear = JsonValue.NewArray(); JsonValue bag = JsonValue.NewArray(); JsonValue vault = JsonValue.NewArray(); JsonValue codex = JsonValue.NewArray();
        for (int i = 0; i < 12; i = i + 1) { if (g.equipped[i] == null) { gear.Append(JsonValue.NewObject()); } else { gear.Append(g.equipped[i].Encode()); } codex.Append(JsonValue.NewNum(Rules.N(g.collected[i]))); }
        for (int i = 0; i < g.bag.Count; i = i + 1) { bag.Append(g.bag[i].Encode()); }
        for (int i = 0; i < g.storage.Count; i = i + 1) { vault.Append(g.storage[i].Encode()); }
        JsonValue codexItems = JsonValue.NewArray(); for (int i = 0; i < g.codexItems.Count; i = i + 1) { codexItems.Append(JsonValue.NewNum(Rules.N(g.codexItems[i]))); }
        j.Put("gear", gear); j.Put("bag", bag); j.Put("storage", vault); j.Put("codex", codex); j.Put("codexItems", codexItems); return j;
    }
    static Game Decode(string text) {
        JsonValue j = JsonValue.Parse(text);
        if (!j.IsObject() || (j.Int("version", 0) != 2 && j.Int("version", 0) != 3 && j.Int("version", 0) != 4 && j.Int("version", 0) != 5 && j.Int("version", 0) != 6 && j.Int("version", 0) != 7 && j.Int("version", 0) != 8 && j.Int("version", 0) != 9 && j.Int("version", 0) != 10) || !j.Has("savedAt") || !j.Has("job")) { throw new Exception("Unsupported or incomplete save"); }
        Game g = new Game();
        g.job = Rules.Clamp(j.Int("job", g.job), -1, 2);
        g.level = Rules.Clamp(j.Int("level", g.level), 1, GameTables.current.levels.rows.Count);
        g.xp = Rules.Clamp(j.Int("xp", g.xp), 0, 1000000000);
        g.rebirth = Rules.Clamp(j.Int("rebirth", g.rebirth), 0, g.B("max_rebirth"));
        g.gold = Rules.Clamp(j.Int("gold", g.gold), 0, 1000000000);
        g.gems = Rules.Clamp(j.Int("gems", g.gems), 0, 1000000);
        g.iron = Rules.Clamp(j.Int("iron", g.iron), 0, 1000000);
        g.runes = Rules.Clamp(j.Int("runes", g.runes), 0, 1000000);
        JsonValue runeCounts = j.Get("runeCounts");
        if (runeCounts != null) {
            if (!runeCounts.IsArray() || runeCounts.Count() != 14) { throw new Exception("Invalid rune state"); }
            for (int i = 0; i < 14; i = i + 1) { g.runeCounts[i] = Rules.Clamp(runeCounts.At(i).AsInt(0), 0, 1000000); }
        }
        g.legendOre = Rules.Clamp(j.Int("legendOre", 0), 0, 1000000);
        JsonValue dragonBalls = j.Get("dragonBalls");
        if (dragonBalls != null) {
            if (!dragonBalls.IsArray() || dragonBalls.Count() != 9) { throw new Exception("Invalid dragon ball state"); }
            for (int i = 0; i < 9; i = i + 1) { g.dragonBalls[i] = Rules.Clamp(dragonBalls.At(i).AsInt(0), 0, 1000000); }
        }
        g.potions = Rules.Clamp(j.Int("potions", g.potions), 0, 9999);
        g.floor = Rules.Clamp(j.Int("floor", g.floor), 1, g.B("max_floor"));
        g.best = Rules.Clamp(j.Int("best", g.best), 1, g.B("max_floor"));
        g.wave = Rules.Clamp(j.Int("wave", g.wave), 0, g.B("wave_count"));
        g.kills = Rules.Clamp(j.Int("kills", g.kills), 0, 1000000000);
        g.deaths = Rules.Clamp(j.Int("deaths", g.deaths), 0, 1000000000);
        g.skill = Rules.Clamp(j.Int("skill", g.skill), 1, g.SkillData().Int("max_level"));
        g.InitSkills();
        JsonValue skillRanks = j.Get("skillRanks"); JsonValue skillEquipped = j.Get("skillEquipped");
        if (j.Int("version", 0) >= 5) {
            if (skillRanks == null || !skillRanks.IsArray() || skillRanks.Count() != 8 || skillEquipped == null || !skillEquipped.IsArray() || skillEquipped.Count() != 8) { throw new Exception("Invalid skill loadout"); }
            for (int i = 0; i < 8; i = i + 1) {
                g.skillRanks[i] = Rules.Clamp(skillRanks.At(i).AsInt(1), 1, g.SkillAtSlot(i).Int("max_level"));
                g.skillEquipped[i] = skillEquipped.At(i).AsInt(1) == 1;
            }
            g.skill = g.skillRanks[0];
        } else { g.skillRanks[0] = g.skill; }
        g.tp = Rules.Clamp(j.Int("tp", 0), 0, g.B("inner_tp_cap"));
        JsonValue inner = j.Get("innerRanks");
        if (inner != null) {
            if (!inner.IsArray() || inner.Count() != 8) { throw new Exception("Invalid inner power slots"); }
            for (int i = 0; i < 8; i = i + 1) { g.innerRanks[i] = Rules.Clamp(inner.At(i).AsInt(0), 0, GameTables.current.innerPower.At(i).Int("max_level")); }
        }
        JsonValue gems = j.Get("gemRanks");
        if (gems != null) {
            if (!gems.IsArray() || gems.Count() != 6) { throw new Exception("Invalid gem state"); }
            for (int i = 0; i < 6; i = i + 1) { g.gemRanks[i] = Rules.Clamp(gems.At(i).AsInt(0), 0, GameTables.current.gems.At(i).Int("max_level")); }
        }
        g.training = Rules.Clamp(j.Int("training", g.training), 0, GameTables.current.growth.At(1).Int("max_level"));
        g.title = Rules.Clamp(j.Int("title", g.title), 0, GameTables.current.growth.At(2).Int("max_level"));
        g.merit = Rules.Clamp(j.Int("merit", g.merit), 0, 1000000000);
        g.guild = Rules.Clamp(j.Int("guild", g.guild), 0, GameTables.current.growth.At(3).Int("max_level"));
        g.tower = Rules.Clamp(j.Int("tower", g.tower), 0, GameTables.current.encounters.At(2).Int("max_progress"));
        g.arenaWins = Rules.Clamp(j.Int("arenaWins", g.arenaWins), 0, 1000000000);
        g.collection = Rules.Clamp(j.Int("collection", g.collection), 0, 1000000000);
        g.quest = Rules.Clamp(j.Int("quest", g.quest), 0, GameTables.current.quests.rows.Count);
        g.capacity = Rules.Clamp(j.Int("capacity", g.capacity), g.B("initial_capacity"), g.B("max_capacity"));
        g.filter = Rules.Clamp(j.Int("filter", g.filter), 0, 4);
        g.filterCoefficient = Rules.Clamp(j.Int("filterCoefficient", g.filterCoefficient), 1, g.B("equipment_coefficient_max"));
        g.filterMinLevel = Rules.Clamp(j.Int("filterMinLevel", g.filterMinLevel), 0, GameTables.current.levels.rows.Count);
        g.filterJobOnly = j.Int("filterJobOnly", g.filterJobOnly ? 1 : 0) == 1;
        g.seed = Rules.Clamp(j.Int("seed", g.seed), 1, 2147483646);
        g.hp = Rules.Clamp(j.Int("hp", g.hp), 0, 1000000000);
        g.mp = Rules.Clamp(j.Int("mp", g.mp), 0, 1000000000);
        g.enemyHp = Rules.Clamp(j.Int("enemyHp", g.enemyHp), 0, 1000000000);
        g.enemyMax = Rules.Clamp(j.Int("enemyMax", g.enemyMax), 0, 1000000000);
        g.enemyAttack = Rules.Clamp(j.Int("enemyAttack", g.enemyAttack), 0, 1000000000);
        g.enemyDefense = Rules.Clamp(j.Int("enemyDefense", g.enemyDefense), 0, 1000000000);
        g.mode = Rules.Clamp(j.Int("mode", g.mode), 0, 4);
        g.challenge = j.Int("challenge", 0);
        if (g.mode == 1) {
            if (j.Int("version", 0) == 2) { if (g.challenge < 0 || g.challenge >= GameTables.current.bosses.rows.Count) { throw new Exception("Legacy boss index invalid"); } g.challenge = GameTables.current.bosses.rows[g.challenge].Int("id"); }
            GameTables.current.bosses.At(g.challenge);
        }
        g.round = Rules.Clamp(j.Int("round", g.round), 0, g.B("round_limit"));
        g.recovery = Rules.Clamp(j.Int("recovery", g.recovery), 0, g.B("recovery_seconds"));
        g.tick = Rules.Clamp(j.Int("tick", g.tick), 0, 2000000000);
        g.day = j.Long("day", 0); if (g.day < 0) { g.day = 0; }
        g.savedAt = j.Long("savedAt", 0); if (g.savedAt < 0) { g.savedAt = 0; }
        g.dailyClaim = Rules.Clamp(j.Int("dailyClaim", g.dailyClaim), 0, 1);
        g.dailyKills = Rules.Clamp(j.Int("dailyKills", g.dailyKills), 0, 1000000000);
        g.bountyClaim = Rules.Clamp(j.Int("bountyClaim", g.bountyClaim), 0, 1);
        g.bossTries = Rules.Clamp(j.Int("bossTries", g.bossTries), 0, g.B("boss_tries"));
        g.arenaTries = Rules.Clamp(j.Int("arenaTries", g.arenaTries), 0, g.B("arena_tries"));
        g.escortTries = Rules.Clamp(j.Int("escortTries", g.escortTries), 0, g.B("escort_tries"));
        g.escortLeft = Rules.Clamp(j.Int("escortLeft", g.escortLeft), 0, g.B("escort_seconds"));
        g.escortReward = Rules.Clamp(j.Int("escortReward", g.escortReward), 0, 1000000000);
        g.treasurePity = Rules.Clamp(j.Int("treasurePity", g.treasurePity), 0, g.B("treasure_pity") - 1);
        g.treasureMaps = Rules.Clamp(j.Int("treasureMaps", g.treasureMaps), 0, 9999);
        g.treasureDraws = Rules.Clamp(j.Int("treasureDraws", g.treasureDraws), 0, 1000000000);
        g.bossWins = Rules.Clamp(j.Int("bossWins", g.bossWins), 0, 1000000000);
        g.secrets = Rules.Clamp(j.Int("secrets", g.secrets), 0, GameTables.current.encounters.At(4).Int("max_progress"));
        g.secretFloor = Rules.Clamp(j.Int("secretFloor", g.secrets + 1), 1, GameTables.current.encounters.At(4).Int("max_progress"));
        g.secretWave = Rules.Clamp(j.Int("secretWave", 0), 0, g.B("secret_wave_count"));
        g.travelMap = Rules.Clamp(j.Int("travelMap", -1), -1, GameTables.current.maps.rows.Count - 1);
        g.homeFloor = Rules.Clamp(j.Int("homeFloor", 1), 1, g.B("max_floor"));
        g.homeWave = Rules.Clamp(j.Int("homeWave", 0), 0, g.B("wave_count"));
        g.elementPool = Rules.Clamp(j.Int("elementPool", 0), 0, g.B("element_pool_cap"));
        g.elementSeconds = Rules.Clamp(j.Int("elementSeconds", 0), 0, 1000000000);
        g.reputation = Rules.Clamp(j.Int("reputation", 0), 0, 1000000000);
        g.redPackets = Rules.Clamp(j.Int("redPackets", 0), 0, 1000000000);
        g.recyclePoints = Rules.Clamp(j.Int("recyclePoints", 0), 0, 1000000000);
        g.altarPersonal = Rules.Clamp(j.Int("altarPersonal", 0), 0, 1000000000);
        g.altarWorld = Rules.Clamp(j.Int("altarWorld", 0), 0, 1000000000);
        g.altarJackpots = Rules.Clamp(j.Int("altarJackpots", 0), 0, 1000000000);
        g.altarDonations = Rules.Clamp(j.Int("altarDonations", 0), 0, 1000000000);
        g.secretAutoPush = j.Int("secretAutoPush", 1) == 1;
        g.fieldActive = j.Int("fieldActive", 1) == 1;
        g.bossAutoNext = j.Int("bossAutoNext", 0) == 1;
        g.elementTraining = j.Int("elementTraining", 0) == 1;
        JsonValue elementRanks = j.Get("elementRanks");
        if (elementRanks != null) {
            if (!elementRanks.IsArray() || elementRanks.Count() != 5) { throw new Exception("Invalid five element state"); }
            for (int i = 0; i < 5; i = i + 1) { g.elementRanks[i] = Rules.Clamp(elementRanks.At(i).AsInt(0), 0, GameTables.current.elements.At(i).Int("max_level")); }
        }
        JsonValue elementXp = j.Get("elementXp");
        if (elementXp != null) {
            if (!elementXp.IsArray() || elementXp.Count() != 5) { throw new Exception("Invalid five element state"); }
            for (int i = 0; i < 5; i = i + 1) { g.elementXp[i] = Rules.Clamp(elementXp.At(i).AsInt(0), 0, g.ElementNeed(i)); }
        }
        g.recycled = Rules.Clamp(j.Int("recycled", g.recycled), 0, 1000000000);
        g.earned = Rules.Clamp(j.Int("earned", g.earned), 0, 1000000000);
        g.active = j.Int("active", 1) == 1; g.autoPush = j.Int("autoPush", 1) == 1; g.autoPotion = j.Int("autoPotion", 1) == 1; g.enemyName = j.Str("enemyName", "幻境守卫");
        JsonValue gear = j.Get("gear"); JsonValue bag = j.Get("bag"); JsonValue vault = j.Get("storage"); JsonValue codex = j.Get("codex");
        if (gear == null || !gear.IsArray() || gear.Count() != 12 || bag == null || !bag.IsArray() || bag.Count() > g.capacity || vault == null || !vault.IsArray() || vault.Count() > g.B("storage_capacity") || codex == null || !codex.IsArray() || codex.Count() != 12) { throw new Exception("Invalid inventory"); }
        g.collection = 0;
        for (int i = 0; i < 12; i = i + 1) {
            Equipment e = Equipment.Decode(gear.At(i)); if (e != null && e.slot != i) { throw new Exception("Invalid slot"); } g.equipped[i] = e;
            g.collected[i] = Rules.Clamp(codex.At(i).AsInt(0), 0, GameTables.current.qualities.rows.Count); g.collection = g.collection + g.collected[i];
        }
        JsonValue codexItems = j.Get("codexItems");
        if (codexItems != null) {
            if (!codexItems.IsArray() || codexItems.Count() > 100000) { throw new Exception("Invalid codex items"); }
            for (int i = 0; i < codexItems.Count(); i = i + 1) {
                int definitionId = codexItems.At(i).AsInt(0); DataRow definition = GameTables.current.items.At(definitionId);
                if (definition.Int("slot") < 0 || g.CodexHas(definitionId)) { throw new Exception("Invalid or duplicate codex item"); }
                g.codexItems.Add(definitionId);
            }
        }
        for (int i = 0; i < bag.Count(); i = i + 1) { Equipment e = Equipment.Decode(bag.At(i)); if (e == null) { throw new Exception("Invalid item"); } g.bag.Add(e); }
        for (int i = 0; i < vault.Count(); i = i + 1) { Equipment e = Equipment.Decode(vault.At(i)); if (e == null) { throw new Exception("Invalid stored item"); } g.storage.Add(e); }
        g.best = Rules.Clamp(g.best, g.floor, g.B("max_floor")); g.hp = Rules.Clamp(g.hp, 0, g.MaxHp()); g.mp = Rules.Clamp(g.mp, 0, g.MaxMp());
        if (g.job >= 0) {
            int priorHp = g.enemyHp; int priorMax = g.enemyMax; int priorRound = g.round;
            g.Spawn(); g.round = priorRound;
            if (priorMax > 0) { g.enemyHp = Rules.Bounded((long)g.enemyMax * priorHp / priorMax); }
        }
        g.enemyHp = Rules.Clamp(g.enemyHp, 0, g.enemyMax); return g;
    }
    Game Read(long now) {
        Game g = new Game(); bool found = false;
        if (File.Exists(path)) { try { g = Decode(File.ReadAllText(path)); found = true; } catch (Exception ex) { error = "主存档损坏，尝试备份。"; } }
        if (!found && File.Exists(path + ".bak")) { try { g = Decode(File.ReadAllText(path + ".bak")); found = true; error = "已从备份恢复存档。"; } catch (Exception ex) { error = "存档与备份均损坏；原文件保留，本次禁止自动覆盖。"; } }
        if (!found && (File.Exists(path) || File.Exists(path + ".bak"))) { writable = false; }
        if (found && now > g.savedAt && g.job >= 0) {
            long elapsed = now - g.savedAt; int seconds = g.B("offline_seconds"); if (elapsed < seconds) { seconds = (int)elapsed; }
            int beforeGold = g.gold; int beforeKills = g.kills; g.Advance(seconds, now); g.offlineSeconds = seconds;
            g.Log("离线 " + Rules.N(seconds / 60) + " 分钟 · 击杀 " + Rules.N(g.kills - beforeKills) + " · 金币 +" + Rules.N(g.gold - beforeGold));
        }
        if (now > g.savedAt) { g.savedAt = now; } g.ResetDay(now);
        if (error != "") { g.Log(error); } return g;
    }
    bool Write(Game g, long now) {
        if (!writable) { return false; }
        try {
            if (now > g.savedAt) { g.savedAt = now; }
            string text = Encode(g).ToJson(); string temp = path + ".tmp";
            File.WriteAllText(temp, text); Decode(File.ReadAllText(temp));
            // 数据库连接池与实体映射状态同步契约。
            if (File.Exists(path)) {
                bool valid = false; try { Decode(File.ReadAllText(path)); valid = true; } catch (Exception ex) { }
                if (valid) { File.Copy(path, path + ".bak"); }
                File.Delete(path);
            }
            File.Move(temp, path);
            if (!File.Exists(path) || File.ReadAllText(path) != text) { throw new Exception("Save replacement failed"); }
            error = ""; return true;
        } catch (Exception ex) { error = "保存失败，请检查目录权限或磁盘空间；备份仍保留。"; return false; }
    }
}
