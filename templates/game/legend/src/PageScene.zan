using System;
using Gui;
using Gui.Widget;
using Legend;

// 场景页家族内部用的无参回调（与 Gui.Action 等价，但写在 file 顶作用域，
// 让 `delegate {...}` 字面量也能解到）。
delegate void SceneFn();

// 页 2「幻境」+ 场景页家族（幻境 2 / 秘境 12 / 世界BOSS 13）——
// 照原版 1:1 还原，骨架在 `BuildSceneFamily`，每页只覆盖自己的内容：
// 标题、怪物、立绘、按钮、提示、排行榜。BOSS之家（页 3）/ 押镖（页 4）
// 是另一族（场景面板 + 怪物 + 掉落格 + 表格式右栏），各自建独立页。
// 分区（REFERENCE_AUDIT.md §5.11 实测，设备像素 = 150% 屏上的原图）：
// 内容块     x 374..1491   y 163..902
// 场景面板   x 374..1102   y 163..717
// 标题贴左上（内边距 27/20），玩家头像+气血贴右上（19/19），
// 怪物立绘在面板中下（血字 + 血条压在立绘上方），底部右下三行
// 自动重置 → 提示 → 四个按钮，左下「最高N记录」。
// 掉落格面板 x 374..1102   y 717..880（12 格 × 3 行，格 57×49 设备）
// 排行榜面板 x 1102..1491  y 163..880（10 行，行距 70.7 设备）
// 数据来源：进度/怪物取离线 `Game`，联机时玩家气血走 `net.Self()`。
// 排行榜走服务端 `scenerank`（dim 1=幻境 2=秘境 3=世界BOSS），真行
// 优先、演示行补位；离线照原版截图的演示榜渲染。
// 一处**已知差异**（数据而非界面）：原版层 1 画的怪物是白野猪的美术
// （assets/boss/00801.png），我们的 maps.csv 第 1 层配的是稻草人（00101 系
// 的 01601）。这里按我们自己的数据画——要改的是数据不是界面。
partial class LegendApp {
    /* =====================================================================
       场景页家族配置
       ===================================================================== */

    // 一个场景页的全部差异：标题、按钮、怪物、提示、排行样式、怪物区底图。
    // 每页只需填一份 SceneCfg 调 `BuildSceneFamily(cfg)`。
    class SceneCfg {
        string title;  // 标题：原版「幻境1」「秘境1」「等级64」
        string bestLabel;  // 左下「最高N记录」前缀：原版「最高幻境记录」
        string bestValue;  // 数字串
        string challengeLabel;  // 挑战钮：「挑战幻境」「挑战秘境」「挑战BOSS」
        string sweepLabel;  // 扫荡钮：「扫荡幻境」「扫荡秘境」（无则空）
        string sweepHint;  // 提示行（与右下方「提示：…」同位）
        bool showAutoReset;  // 是否显示「自动重置」复选框
        int enemyPicture;  // 怪物立绘 picture 号（0 = 空白占位）
        int enemyHp;  // 怪物当前血量
        int enemyHpMax;  // 怪物最大血量
        string enemyHpText;  // 怪物血字（已含分隔符，如 "200/200"），空=用上面两个数算
        bool isWorldBoss;  // 世界BOSS 立绘较大
    }

    /* =====================================================================
       数据：场景页家族共享
       ===================================================================== */

    // 名字颜色：原版统一配色。
    static string SceneDemoNameCls(int i) { return "scene-rank-name"; }

    // 血条配色：原版逐行换色（品红/红/绿/青/蓝/蓝绿/紫/蓝/蓝/深蓝）。
    static string SceneBarCls(int i) { return "scene-rank-bar scene-rank-bar-" + Rules.N(i % 10); }

    // 榜头像：按行轮换 6 张人物立绘。
    static string SceneRankFacePath(int i) {
        int n = 43 + i % 6;
        return "assets/ui/000" + Rules.N(n) + ".jpg";
    }

    // 榜头像边框：第 1 名金、第 2/3 名品红、其余暗品红。
    static string SceneRankFaceCls(int i) {
        if (i == 0) { return " scene-rank-face-1"; }
        if (i == 1 || i == 2) { return " scene-rank-face-2"; }
        return " scene-rank-face-3";
    }

    /* 当前场景页的榜维度（1=幻境 2=秘境 3=世界BOSS），三个入口各设一次；
       在线时 SceneRankPane 读服务端 scenerank.rows 强类型实体。 */
    int sceneDim = 1;

    // 榜行取数：全面消费服务端真实榜单（SceneRankRow 强类型实体），彻底消除平行演示数组与硬编码假玩家。
    string SceneRowName(int i, List<SceneRankRow> live, int n) {
        if (live != null && i < n) { return live[i].Name; }
        return "";
    }
    int SceneRowFloor(int i, List<SceneRankRow> live, int n) {
        if (live != null && i < n) { return live[i].Floor; }
        return 0;
    }
    int SceneRowLevel(int i, List<SceneRankRow> live, int n) {
        if (live != null && i < n) { return live[i].Level; }
        return 0;
    }

    // 玩家气血：联机以服务端 self 为准，离线用本地进度。
    string ScenePlayerHp() {
        PlayerState ps = net.SelfState();
        if (net.Self() != null && ps != null) { return Rules.N(ps.Hp) + "/" + Rules.N(ps.MaxHp); }
        return Rules.N(g.hp) + "/" + Rules.N(g.MaxHp());
    }

    // 道具图标：items.csv 的 picture → assets/item/NNNNN.png。
    // 00002.png 是 art.csv 里的空白占位图，缺图一律落它（画出来是空格）。
    string SceneItemPath(int itemId) {
        if (itemId <= 0) { return "assets/item/00002.png"; }
        return ItemArtById(itemId);
    }

    /* =====================================================================
       家族调度
       ===================================================================== */

    // 页 2 入口：幻境。
    void BuildScene() {
        this.sceneDim = 1;
        SceneCfg cfg = new SceneCfg();
        cfg.title = "幻境" + Rules.N(g.floor);
        cfg.bestLabel = "最高幻境记录：";
        cfg.bestValue = Rules.N(g.best) + "层";
        cfg.challengeLabel = "挑战幻境";
        cfg.sweepLabel = "扫荡幻境";
        cfg.sweepHint = "提示：只有终身会员才能扫荡";
        cfg.showAutoReset = true;
        DataRow m = g.EnemyData();
        cfg.enemyPicture = m.Int("picture");
        cfg.enemyHp = SceneEnemyHp();
        cfg.enemyHpMax = SceneEnemyMax();
        cfg.enemyHpText = "";
        cfg.isWorldBoss = false;
        BuildSceneFamily(cfg, delegate { SceneChallenge(); }, delegate { SceneSweep(); }, delegate { SceneHelp(); });
    }

    // 页 12 入口：秘境——与幻境同族，差异：标题、怪物、最高记录、提示文案。
    void BuildSecret() {
        this.sceneDim = 2;
        SceneCfg cfg = new SceneCfg();
        cfg.title = "秘境" + Rules.N(g.secretFloor);
        cfg.bestLabel = "最高秘境记录：";
        cfg.bestValue = Rules.N(g.secrets) + "层";
        cfg.challengeLabel = "挑战秘境";
        cfg.sweepLabel = "扫荡秘境";
        cfg.sweepHint = "提示：巅峰人物才能挑战秘境";
        cfg.showAutoReset = g.secretAutoPush;
        DataRow m = g.EnemyData();
        cfg.enemyPicture = m.Int("picture");
        cfg.enemyHp = SceneEnemyHp();
        cfg.enemyHpMax = SceneEnemyMax();
        cfg.enemyHpText = "";
        cfg.isWorldBoss = false;
        BuildSceneFamily(cfg, delegate { SecretChallenge(); }, delegate { SecretSweep(); }, delegate { SecretHelp(); });
    }

    // 页 13 入口：世界BOSS——怪物大（占位更大）、与 BOSS之家共享挑战次数、
    // 排行榜 10 行（玩家名 + "次/伤害"），与幻境共家族，但右下列出的玩家
    // 攻击/伤害。差异在 cfg + 挑战动作。
    void BuildWorldBoss() {
        this.sceneDim = 3;
        SceneCfg cfg = new SceneCfg();
        cfg.title = "等级 " + Rules.N(g.level);
        cfg.bestLabel = "剩余BOSS挑战次数：";
        cfg.bestValue = Rules.N(g.bossTries > 0 ? g.bossTries : GameTables.Value("boss_tries")) + "次";
        cfg.challengeLabel = "挑战BOSS";
        cfg.sweepLabel = "";
        cfg.sweepHint = "提示：挑战都会消耗次数";
        cfg.showAutoReset = false;
        DataRow m = g.EnemyData();
        cfg.enemyPicture = m.Int("picture");
        cfg.enemyHp = SceneEnemyHp();
        cfg.enemyHpMax = SceneEnemyMax();
        cfg.enemyHpText = "";
        cfg.isWorldBoss = true;
        BuildSceneFamily(cfg, delegate { WorldBossChallenge(); }, null, delegate { WorldBossHelp(); });
    }

    // 家族渲染：把 SceneCfg 喂进统一的场景面板/掉落/排行/底部。
    void BuildSceneFamily(SceneCfg cfg, SceneFn onChallenge, SceneFn onSweep, SceneFn onHelp) {
        int pageW = app.ClientWidth() - Spec.LeftPad() - Spec.LeftW()
            - Spec.ChatW() - Spec.ChatPadR();
        int sceneW = pageW - Spec.SceneRankW();
        if (sceneW < Spec.Px(200)) { sceneW = Spec.Px(200); }

        Panel body = Panel.Row(); body.Class = "scene-page";
        body.Pad(0); body.Gap(0); body.Grow(); content.With(body);

        /* 左列：场景面板（吃掉余量）+ 掉落面板 + 内容块下留白。下留白先入
           dock（底），掉落面板才叠在它上面——停靠容器先摆 dock 1..4。 */
        Panel leftCol = Panel.Column(); leftCol.Pad(0); leftCol.Gap(0); leftCol.Grow();
        body.With(leftCol);

        Panel scene = ScenePane(cfg, sceneW, onChallenge, onSweep, onHelp);
        scene.Grow(); leftCol.With(scene);
        Panel botPad = Panel.Column(); botPad.Prefer(0, Spec.SceneBotPad());
        botPad.AnchorBottom(); leftCol.Add(botPad);
        Panel loot = SceneLootPane(sceneW);
        loot.AnchorBottom(); leftCol.Add(loot);

        /* 右列：排行榜面板整高，底下同样留一条，底边才与掉落面板齐。 */
        Panel rankCol = Panel.Column(); rankCol.Pad(0); rankCol.Gap(0);
        rankCol.Prefer(Spec.SceneRankW(), 0); rankCol.AnchorRight(); body.Add(rankCol);
        Panel rankPad = Panel.Column(); rankPad.Prefer(0, Spec.SceneBotPad());
        rankPad.AnchorBottom(); rankCol.Add(rankPad);
        Panel rank = SceneRankPane();
        rank.Grow(); rankCol.With(rank);
    }

    // 场景面板：标题行 → 怪物区（吃余量）→ 底部操作区。
    Panel ScenePane(SceneCfg cfg, int paneW, SceneFn onChallenge, SceneFn onSweep, SceneFn onHelp) {
        Panel pane = Panel.Column(); pane.Class = "scene-panel";
        pane.Pad(0); pane.Gap(0);

        Panel head = Panel.Row(); head.Class = "scene-head";
        head.Pad(0); head.Gap(0); head.Prefer(0, Spec.SceneHeadH());
        /* 右内边距 = 头像右缩进；标题列 Grow 在头像列的右边留白里展开。 */
        head.Padding(0, Spec.SceneFaceInset(), 0, 0);
        pane.With(head);
        Panel titleCol = Panel.Column(); titleCol.Pad(0); titleCol.Gap(0); titleCol.Grow();
        titleCol.Padding(Spec.SceneTitleInsetT(), 0, 0, Spec.SceneTitleInsetL());
        head.With(titleCol);
        titleCol.With(Text(cfg.title, "scene-title", 0));
        Panel face = ScenePlayerBlock();
        face.Prefer(Spec.SceneFaceW(), 0); face.AnchorRight(); head.Add(face);

        Panel mon = SceneMonsterZone(cfg, paneW, ScenePaneHeight());
        mon.Grow(); pane.With(mon);
        Panel foot = SceneFooter(cfg, onChallenge, onSweep, onHelp);
        foot.AnchorBottom(); pane.Add(foot);
        return pane;
    }

    // 场景面板可用高度：内容块高 − 掉落面板 − 下留白。怪物区要靠它把
    // 立绘沉到面板下部（原版立绘底距底部操作区 13 设备）。
    int ScenePaneHeight() {
        return app.ClientHeight() - app.ContentTop() - Spec.ContentTopPad()
            - Spec.TopH() - Spec.BotTileRowH() - Spec.BotTileBottom()
            - Spec.SceneLootH() - Spec.SceneBotPad();
    }

    // 玩家头像块：头像框 + 框下居中的气血数字 + 数字下的气血条（原版
    // 470/470 红字，字下还有一条比字窄的红条，实测 x 1008..1053）。
    // 顶上留 20 设备：头像框并不贴面板顶，head 行比块高，缩进只能落在
    // 块自己身上。数字与血条都用 `.scene-center` 的 flex 居中——`Label`
    // 永远左对齐（`Label.OnPaint` 按 bx 画字），要居中必须靠容器排。
    Panel ScenePlayerBlock() {
        Panel col = Panel.Column(); col.Class = "scene-face-block";
        col.Pad(0); col.Gap(0);
        col.Padding(Spec.SceneFaceTop(), 0, 0, 0);
        col.With(SceneFaceFrame("assets/ui/00043.jpg",
            Spec.SceneFaceW(), Spec.SceneFaceH(), "scene-face-frame"));

        Panel g1 = Panel.Column(); g1.Prefer(0, Spec.SceneFaceTextGap()); col.With(g1);
        Panel hpRow = Panel.Row(); hpRow.Class = "scene-center"; hpRow.Pad(0);
        hpRow.Prefer(0, Spec.SceneFaceTextH()); col.With(hpRow);
        hpRow.With(Text(ScenePlayerHp(), "scene-face-hp", 0));

        Panel g2 = Panel.Column(); g2.Prefer(0, Spec.SceneFaceBarGap()); col.With(g2);
        Panel barRow = Panel.Row(); barRow.Class = "scene-center"; barRow.Pad(0);
        barRow.Prefer(0, Spec.SceneFaceBarH()); col.With(barRow);
        Panel bar = Panel.Row(); bar.Class = "scene-face-bar";
        bar.Prefer(Spec.SceneFaceBarW(), Spec.SceneFaceBarH()); barRow.With(bar);
        return col;
    }

    // 带边框的头像框：Image 的图会盖住它**自己**的样式边框（OnPaint 先画
    // 样式再按整盒 blit），所以框必须由外层容器画，图缩进边框那一圈。
    Panel SceneFaceFrame(string path, int wDevice, int hDevice, string cls) {
        int inset = Spec.SceneFramePad();
        Panel frame = Panel.Row(); frame.Class = cls;
        frame.Pad(inset); frame.Prefer(wDevice, hDevice);
        Image img = new Image(path, "角色", "cover");
        img.Prefer(wDevice - inset * 2, hDevice - inset * 2); frame.With(img);
        return frame;
    }

    // 怪物区：立绘沉在区域底部（上方留空），血字 + 血条压在立绘上。
    Panel SceneMonsterZone(SceneCfg cfg, int paneW, int paneH) {
        Panel zone = Panel.Column(); zone.Class = "scene-mon-zone";
        zone.Pad(0); zone.Gap(0);

        int blockH = Spec.SceneMonHpTextH() + Spec.SceneMonBarGap()
            + Spec.SceneMonHpBarH() + Spec.SceneMonGap() + Spec.SceneMonBoxH();
        Panel padBot = Panel.Column(); padBot.Prefer(0, Spec.SceneMonBottom());
        padBot.AnchorBottom(); zone.Add(padBot);
        Panel block = Panel.Column(); block.Class = "scene-mon";
        block.Pad(0); block.Gap(0); block.Prefer(0, blockH);
        block.AnchorBottom(); zone.Add(block);

        /* 血字与血条同宽同位：原版实测两者的左缘都是 704（字 44 宽、条 45
           宽，都居中于立绘）。字不能整宽摆在停靠列里——`Label.OnPaint` 按
           bx 画字，`Padding(left)` 又不落在它的绘制原点上（实测纹丝不动），
           所以这里用 flex 行：主轴按标签的**自然测量宽**排（不调 Prefer，
           调了 prefW=0 反而没宽），左右由容器自己的 padding 顶住。
           两个左缩进都按「自身宽度居中于面板」算：立绘框 128 宽、血条 45
           宽，所以条的左缘比立绘左缘更靠右——这正是原版的样子。 */
        int spInset = (paneW - Spec.SceneMonBoxW()) / 2;
        if (spInset < 0) { spInset = 0; }
        int hpInset = (paneW - Spec.SceneMonHpW()) / 2;
        if (hpInset < 0) { hpInset = 0; }

        Panel hpRow = Panel.Row(); hpRow.Class = "scene-hp-row";
        hpRow.Pad(0); hpRow.Prefer(0, Spec.SceneMonHpTextH());
        hpRow.Padding(0, 0, 0, hpInset);
        block.With(hpRow);
        string hpText = cfg.enemyHpText.Length > 0
            ? cfg.enemyHpText
            : Rules.N(cfg.enemyHp) + "/" + Rules.N(cfg.enemyHpMax);
        hpRow.With(Text(hpText, "scene-mon-hp", 0));
        Panel barGap = Panel.Column(); barGap.Prefer(0, Spec.SceneMonBarGap());
        block.With(barGap);
        Panel barRow = Panel.Row(); barRow.Pad(0); barRow.Prefer(0, Spec.SceneMonHpBarH());
        block.With(barRow);
        barRow.With(SpacerW(hpInset));
        int maxHp = cfg.enemyHpMax;
        int barW = Spec.SceneMonHpW();
        if (maxHp > 0) { barW = Spec.SceneMonHpW() * cfg.enemyHp / maxHp; }
        if (barW < Spec.Px(2)) { barW = Spec.Px(2); }
        Panel bar = Panel.Row(); bar.Class = "scene-mon-bar"; bar.Prefer(barW, Spec.SceneMonHpBarH());
        barRow.With(bar);
        Panel gapRow = Panel.Column(); gapRow.Prefer(0, Spec.SceneMonGap());
        block.With(gapRow);
        Panel spRow = Panel.Row(); spRow.Pad(0); spRow.Prefer(0, Spec.SceneMonBoxH());
        block.With(spRow);
        spRow.With(SpacerW(spInset));
        int pic = cfg.enemyPicture;
        Image sp = new Image(pic > 0 ? PicturePath("boss", pic) : "assets/item/00002.png",
            "怪物", "contain");
        sp.Prefer(Spec.SceneMonBoxW(), Spec.SceneMonBoxH()); spRow.With(sp);
        return zone;
    }

    // 底部操作区：从底往上码 下留白 → 按钮行 → 缝 → 提示 → 缝 → 自动重置。
    // 走 AnchorBottom 显式停靠。
    Panel SceneFooter(SceneCfg cfg, SceneFn onChallenge, SceneFn onSweep, SceneFn onHelp) {
        Panel foot = Panel.Column(); foot.Class = "scene-foot";
        foot.Pad(0); foot.Gap(0); foot.Prefer(0, Spec.SceneFootH());

        Panel btnPad = Panel.Column(); btnPad.Prefer(0, Spec.SceneBtnInsetB());
        btnPad.AnchorBottom(); foot.Add(btnPad);
        Panel btnRow = Panel.Row(); btnRow.Pad(0); btnRow.Gap(0);
        btnRow.Prefer(0, Spec.SceneBtnH());
        btnRow.Padding(0, Spec.SceneBtnInsetR(), 0, Spec.SceneBtnPadL());
        btnRow.AnchorBottom(); foot.Add(btnRow);
        /* 左：最高记录 */
        btnRow.With(Text(cfg.bestLabel + cfg.bestValue, "scene-record", 0));
        /* 右：一排按钮。先加撑条再加按钮行 */
        Panel fill = Panel.Row(); fill.Grow(); btnRow.With(fill);
        Panel btns = Panel.Row(); btns.Pad(0); btns.Gap(Spec.SceneBtnGap());
        btns.AnchorRight(); btnRow.Add(btns);
        if (cfg.showAutoReset) { btns.With(SceneAutoToggle()); }
        btns.With(SceneBtn(cfg.challengeLabel, Spec.SceneBtnChallengeW(), onChallenge));
        if (cfg.sweepLabel.Length > 0) {
            btns.With(SceneBtn(cfg.sweepLabel, Spec.SceneBtnSweepW(), onSweep));
        }
        btns.With(SceneBtn("喝油", Spec.Px(38), () => {
            int oldLuck = g.TotalLuck();
            g.DrinkBlessingOil();
            if (g.TotalLuck() > oldLuck) {
                AudioEngine.Get().PlayBlessing();
            } else {
                AudioEngine.Get().PlayPotion();
            }
        }));
        btns.With(SceneBtn("回收", Spec.Px(38), () => {
            int oldGems = g.gems;
            g.RecycleByTier(3);
            if (g.gems > oldGems) {
                AudioEngine.Get().PlayCoin();
            }
        }));
        btns.With(SceneBtn("说明", Spec.SceneBtnHelpW(), onHelp));

        Panel g1 = Panel.Column(); g1.Prefer(0, Spec.SceneFootGap1()); g1.AnchorBottom(); foot.Add(g1);
        Panel hintRow = Panel.Row(); hintRow.Pad(0); hintRow.Prefer(0, Spec.SceneHintH());
        hintRow.Padding(0, Spec.SceneHintInsetR(), 0, 0);
        hintRow.AnchorBottom(); foot.Add(hintRow);
        Panel hintFill = Panel.Row(); hintFill.Grow(); hintRow.With(hintFill);
        Label hint = Text(cfg.sweepHint, "scene-hint", 0);
        hint.AnchorRight(); hintRow.Add(hint);

        if (cfg.showAutoReset) {
            Panel g2 = Panel.Column(); g2.Prefer(0, Spec.SceneFootGap2()); g2.AnchorBottom(); foot.Add(g2);
            Panel chkRow = Panel.Row(); chkRow.Pad(0); chkRow.Prefer(0, Spec.SceneChkRowH());
            chkRow.Padding(0, Spec.SceneChkInsetR(), 0, 0);
            chkRow.AnchorBottom(); foot.Add(chkRow);
            Panel chkFill = Panel.Row(); chkFill.Grow(); chkRow.With(chkFill);
            Checkbox autoReset = SceneAutoResetCheck();
            autoReset.AnchorRight(); chkRow.Add(autoReset);
        }
        return foot;
    }

    // 场景页的按钮：Spec 里的宽度已经是设备像素，直接 Prefer（不要走
    // BtnSized——它按逻辑像素再乘一次 DPI）。
    Button SceneBtn(string label, int wDevice, SceneFn fn) {
        // 本页回调统一用 SceneFn（页内委托），Gui.Action 与它同为零元
        // 但名义类型不互转——lambda 包一层再交给 Btn。
        Button b = Btn(label, "scene-btn", () => { fn(); });
        b.Prefer(wDevice, Spec.SceneBtnH());
        return b;
    }

    // 左下「自动」钮：原版这个方框里含一个复选框 + 文字，样式与旁边三个
    // 按钮同一套（深底亮蓝框蓝字），故照 Checkbox 类 + CSS 还原。
    Checkbox SceneAutoToggle() {
        SignalBool sig = new SignalBool(false);
        Checkbox cb = Checkbox.Bind("自动", sig);
        cb.Class = "scene-toggle";
        cb.Prefer(Spec.SceneChkW(), Spec.SceneBtnH());
        return cb;
    }

    // 右下「自动重置」复选框。原版语义是场景循环的自动开关；离线把它接到
    // `Game.autoPush`（自动推层/战败退层），联机接服务端仅有的那个自动开关
    // （`bossAuto`）——服务端还没有对应 op，缺口记在 TASKS.md。
    Checkbox SceneAutoResetCheck() {
        SignalBool sig = new SignalBool(g.autoPush);
        Checkbox cb = Checkbox.Bind("自动重置", sig);
        cb.Class = "scene-check";
        cb.Prefer(Spec.Px(76), Spec.SceneChkRowH());
        cb.Change += () => {
            bool on = sig.Get();
            if (net.Self() != null) { net.SetBossAuto(on); }
            else {
                g.autoPush = on;
                g.Log(on ? "自动重置：开（战败自动退层继续）。" : "自动重置：关。");
            }
        };
        return cb;
    }

    // 掉落面板：本层掉落池铺满 12 × 3 格（原版截图里也是几种道具铺满）。
    Panel SceneLootPane(int paneW) {
        Panel pane = Panel.Column(); pane.Class = "scene-loot";
        pane.Pad(0); pane.Gap(Spec.SceneLootGapY());
        pane.Padding(Spec.SceneLootPad(), 0, Spec.SceneLootPad(), Spec.SceneLootPad());
        pane.Prefer(paneW, Spec.SceneLootH());
        List<int> ids = SceneDropIds();
        int n = ids.Count;
        for (int r = 0; r < Spec.SceneLootRows(); r = r + 1) {
            Panel row = Panel.Row(); row.Pad(0); row.Gap(Spec.SceneLootGapX());
            row.Prefer(0, Spec.SceneLootCellH()); pane.With(row);
            for (int c = 0; c < Spec.SceneLootCols(); c = c + 1) {
                int i = r * Spec.SceneLootCols() + c;
                Panel cell = Panel.Row(); cell.Class = "scene-loot-cell";
                cell.Prefer(Spec.SceneLootCellW(), Spec.SceneLootCellH()); row.With(cell);
                if (n == 0) { continue; }
                int id = ids[i % n];
                Image icon = new Image(SceneItemPath(id), "掉落", "contain");
                icon.Prefer(Spec.SceneLootCellW(), Spec.SceneLootCellH()); cell.With(icon);
            }
        }
        return pane;
    }

    // 排行榜面板：10 行「头像 + 名字（巅峰N级）第N层 + 层数血条」。
    // 在线读服务端 scenerank 强类型实体；血条按榜首进度满宽。
    Panel SceneRankPane() {
        if (net.Self() != null) { net.MaybeRefreshSceneRank(this.sceneDim); }
        List<SceneRankRow> live = net.Self() != null ? net.TypedSceneRank(this.sceneDim) : null;
        int n = live != null ? live.Count : 0;
        int topFloor = 0;
        if (n > 0) { topFloor = live[0].Floor; }
        if (topFloor <= 0) { topFloor = 1; }
        Panel pane = Panel.Column(); pane.Class = "scene-rank";
        pane.Pad(0); pane.Gap(Spec.SceneRankRowGap());
        pane.Padding(Spec.SceneRankPadT(), 0, 0, 0);
        for (int i = 0; i < Spec.SceneRankRows(); i = i + 1) {
            Panel row = Panel.Row(); row.Class = "scene-rank-row";
            row.Pad(0); row.Gap(0); row.Prefer(0, Spec.SceneRankRowH()); pane.With(row);
            Panel faceBox = Panel.Row(); faceBox.Pad(0);
            faceBox.Padding(0, 0, 0, Spec.SceneRankFacePad());
            faceBox.Prefer(Spec.SceneRankFacePad() + Spec.SceneRankFace(),
                Spec.SceneRankRowH()); row.With(faceBox);
            faceBox.With(SceneFaceFrame(SceneRankFacePath(i),
                Spec.SceneRankFace(), Spec.SceneRankFace(),
                "scene-rank-face" + SceneRankFaceCls(i)));

            Panel col = Panel.Column(); col.Pad(0); col.Gap(0); col.Grow();
            col.Padding(0, 0, 0, Spec.SceneRankTextGap()); row.With(col);
            Panel top = Panel.Column(); top.Prefer(0, Spec.SceneRankTextT()); col.With(top);
            Panel line = Panel.Row(); line.Pad(0); line.Gap(0);
            line.Prefer(0, Spec.SceneRankTextH()); col.With(line);
            string rName = SceneRowName(i, live, n);
            int rFloor = SceneRowFloor(i, live, n);
            int rLevel = SceneRowLevel(i, live, n);
            line.With(Text(rName.Length > 0 ? rName : "-", SceneDemoNameCls(i), 0));
            line.With(Text(rName.Length > 0 ? ("（巅峰" + Rules.N(rLevel) + "级）") : "", "scene-rank-lv", 0));
            line.With(Text(rFloor > 0 ? ("第" + Rules.N(rFloor) + "层") : "", "scene-rank-floor", 0));
            Panel barGap = Panel.Column(); barGap.Prefer(0, Spec.SceneRankBarGap()); col.With(barGap);
            Panel barRow = Panel.Row(); barRow.Pad(0); barRow.Prefer(0, Spec.SceneRankBarH());
            col.With(barRow);
            int barW = topFloor > 0 && rFloor > 0 ? (Spec.SceneRankBarMax() * rFloor / topFloor) : Spec.Px(4);
            if (barW > Spec.SceneRankBarMax()) { barW = Spec.SceneRankBarMax(); }
            if (barW < Spec.Px(4)) { barW = Spec.Px(4); }
            Panel bar = Panel.Row(); bar.Class = SceneBarCls(i);
            bar.Prefer(barW, Spec.SceneRankBarH()); barRow.With(bar);
        }
        return pane;
    }

    // 本层掉落池的道具 id：地图 → drop_pool → drops.csv 的 item_id。
    List<int> SceneDropIds() {
        List<int> ids = new List<int>();
        int pool = GameTables.current.Map(SceneFloor()).Int("drop_pool");
        for (int i = 0; i < GameTables.current.drops.rows.Count; i = i + 1) {
            DataRow d = GameTables.current.drops.rows[i];
            if (d.Int("pool") == pool) { ids.Add(d.Int("item_id")); }
            if (ids.Count >= Spec.SceneLootCells()) { break; }
        }
        return ids;
    }

    int SceneFloor() { return g.floor; }

    int SceneEnemyMax() {
        int live = g.enemyMax;
        if (live > 0) { return live; }
        return g.EnemyData().Int("hp");
    }

    int SceneEnemyHp() {
        if (g.enemyMax <= 0) { return SceneEnemyMax(); }
        return Rules.Clamp(g.enemyHp, 0, g.enemyMax);
    }

    /* =====================================================================
       动作（页 2 幻境的四个按钮）
       ===================================================================== */

    void SceneChallenge() {
        if (net.Self() != null) {
            MobInfo mob = net.MobCount() > 0 ? net.TypedMobAt(0) : null;
            if (mob != null) { net.AutoHunt(mob.Id, true); return; }
            net.AddChat("[系统]", "怪物列表还没拉到，稍后再试。");
            return;
        }
        g.active = true;
        g.Log("幻境第 " + Rules.N(SceneFloor()) + " 层：挂机开战。");
    }

    // 扫荡：原版非终身会员点了就只会看到这句提示（页面上那行提示也是它）。
    void SceneSweep() {
        if (net.Self() != null) { net.AddChat("[系统]", "扫荡幻境需要终身会员。"); return; }
        g.Log("扫荡幻境需要终身会员。");
    }

    void SceneHelp() {
        string text = "幻境：在幻境推层，击败守卫上一层、战败退一层；自动重置打开后会战败自动退层继续。";
        if (net.Self() != null) { net.AddChat("[系统]", text); return; }
        g.Log(text);
    }

    // 秘境：挑战 = 开始一次秘境战斗（与幻境共用 AutoHunt 路径）。
