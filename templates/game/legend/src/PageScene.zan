        if (net.Self() != null) {
            MobInfo mob = net.MobCount() > 0 ? net.TypedMobAt(0) : null;
            if (mob != null) { net.AutoHunt(mob.Id, true); return; }
            net.AddChat("[系统]", "怪物列表还没拉到，稍后再试。");
            return;
        }
        g.active = true;
        g.Log("秘境第 " + Rules.N(g.secretFloor) + " 层：开战。");
    }

    // 秘境：扫荡按钮 = 提示文案。
    void SecretSweep() {
        if (net.Self() != null) { net.AddChat("[系统]", "扫荡秘境需要巅峰等级。"); return; }
        g.Log("扫荡秘境需要巅峰等级。");
    }

    // 秘境：说明。
    void SecretHelp() {
        string text = "秘境：可挑战层数上限 = 人物等级 + 100；巅峰人物才能挑战高秘境。";
        if (net.Self() != null) { net.AddChat("[系统]", text); return; }
        g.Log(text);
    }

    // 世界BOSS：挑战。
    void WorldBossChallenge() {
        if (net.Self() != null) {
            MobInfo mob = net.MobCount() > 0 ? net.TypedMobAt(0) : null;
            if (mob != null) { net.AutoHunt(mob.Id, true); return; }
            net.AddChat("[系统]", "怪物列表还没拉到，稍后再试。");
