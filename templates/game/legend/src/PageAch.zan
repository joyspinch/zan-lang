using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 26「成就」——照原版逐像素还原（`mir2/mir/成就.png`）。
/// 版式与交易市场同一副外框（374..1491 × 164..879，`Spec.Mk*` 复用）：
/// · 顶带满宽（377..1489 × 167..204）：「成就分类」居中在左栏之上（区宽 =
/// 表格左沿 163 设备）+ 说明（左对齐、左锚 571）/ 领取 / 奖励 三个表头。
/// · 中排：左栏 389..529 —— 12 枚分类钮（40 高、节距 49），无自底色；
/// 右：表格盒 540..1489（黑底），8 行、行高 72、节距 75（与市场同）。
/// · 一行 = 说明列（两行字：成就：xx 黄 / 要求：xx 灰）+ 领取钮（86×36 居中）
/// + 四枚 `00211.png` 奖励格（66 方、节距 75、左锚 1193，空格也画框）。
/// · 页脚只有右侧分页（上一页 / 1/3 / 下一页，无跳转）。
/// 数据一行一实体（`AchRow` + 四枚 `AchReward`）：奖励图按 items.csv picture 号
/// 取素材，角标存字符串原文（「10万」「200万」原版就是这样印的）。
/// 配色（原版实测）：成就行黄 `#ffff00`、要求行灰 `#808080`、表头/钮字
/// `#00aeff`、角标白 `#f4f4f4`、行底 `#182128`、盒底 `#050708`。
partial class LegendApp {
    /// 一枚奖励：道具图 + 角标原文（空 = 无角标；picture 0 = 空格）。
    class AchReward {
        int picture;
        string count;
    }

    /// 一行成就。
    class AchRow {
        string name;  // 「10级奖励」
        string req;  // 「等级达到10级」
        List<AchReward> rewards;  // 恒 4 枚（空格 picture = 0）
        int no;  // 服务端成就定义 1 基行号（离线行 = 0）
        int state;  // 0 条件未达 / 1 可领取 / 2 已领取
        string NameText() { return "成就：" + name; }
        string ReqText() { return "要求：" + req; }
    }

    /// 第 1 页 8 行（照 `成就.png` 逐行抄录；共 3 页，其余页数据未接）。
    /// 素材对照：金币 116、蓝药 423（库内最接近）、黑铁矿石 285、BOSS卷轴 1123、
    /// 元宝袋 1121、心法书 1146、书籍包 1132、经验 1187、幸运雪莲 2620、
    /// 天书 2658、吞噬灵石(大) 1027。
    static List<AchRow> achData = null;
    static List<AchRow> AchData() {
        if (achData != null) { return achData; }
        List<AchRow> v = new List<AchRow>();
        v.Add(AchRowOf("10级奖励", "等级达到10级", 116, "10万", 0, "", 0, "", 0, ""));
        v.Add(AchRowOf("20级奖励", "等级达到20级", 116, "20万", 423, "5", 0, "", 0, ""));
        v.Add(AchRowOf("30级奖励", "等级达到30级", 285, "100", 1123, "100", 0, "", 0, ""));
        v.Add(AchRowOf("40级奖励", "等级达到40级", 1121, "100", 1146, "1000", 285, "100", 0, ""));
        v.Add(AchRowOf("50级奖励", "等级达到50级", 1146, "2000", 1123, "100", 1132, "1000", 0, ""));
        v.Add(AchRowOf("60级奖励", "等级达到60级", 116, "200万", 1187, "200万", 1132, "5000", 285, "200"));
        v.Add(AchRowOf("1转奖励", "转生达到1转", 2620, "", 1132, "10000", 2658, "2000", 2658, "2000"));
        v.Add(AchRowOf("2转奖励", "转生达到2转", 1027, "2", 1132, "30000", 2658, "10000", 2658, "10000"));
        achData = v;
        return v;
    }

    static AchReward AchRewardOf(int picture, string count) {
        AchReward w = new AchReward(); w.picture = picture; w.count = count; return w;
    }

    static AchRow AchRowOf(string name, string req, int p1, string c1, int p2, string c2,
                           int p3, string c3, int p4, string c4) {
        AchRow r = new AchRow();
        r.name = name; r.req = req;
        r.rewards = new List<AchReward>();
        r.rewards.Add(AchRewardOf(p1, c1)); r.rewards.Add(AchRewardOf(p2, c2));
        r.rewards.Add(AchRewardOf(p3, c3)); r.rewards.Add(AchRewardOf(p4, c4));
        return r;
    }

    /// 当前成就行：在线 = 服务端 ach.rows（奖励格不足 4 枚补空格），
    /// 离线 = 原版第 1 页对照。
    List<AchRow> AchRows() {
        if (net.Self() == null || net.AchsList() == null || net.AchsList().Count == 0) { return AchData(); }
        List<AchItem> all = net.AchsList();
        List<AchRow> v = new List<AchRow>();
        for (int i = 0; i < all.Count; i = i + 1) {
            AchItem m = all[i];
            AchRow r = new AchRow();
            r.name = m.Name;
            r.req = m.Req;
            r.no = i + 1;
            r.state = m.Claimed == 1 ? 2 : (m.Ok == 1 ? 1 : 0);
            r.rewards = new List<AchReward>();
            int n = m.Rewards.Count;
            for (int k = 0; k < 4; k = k + 1) {
                if (k < n) {
                    AchRewardItem w = m.Rewards[k];
                    r.rewards.Add(AchRewardOf(w.Pic, w.Badge));
                } else {
                    r.rewards.Add(AchRewardOf(0, ""));
                }
            }
            v.Add(r);
        }
        return v;
    }

    /// 左栏 12 枚分类（原版顺序，末枚原版就是「-」）。
    static List<string> AchCats() {
        List<string> c = new List<string>();
        c.Add("等级奖励"); c.Add("累计充值"); c.Add("幻境奖励"); c.Add("推图");
        c.Add("属性-攻击"); c.Add("属性-魔法"); c.Add("属性-道术"); c.Add("属性-防御");
        c.Add("属性-魔防"); c.Add("推广"); c.Add("挑战BOSS"); c.Add("-");
        return c;
    }

    void BuildAchPage() {
        if (net.Self() != null) { net.MaybeRefreshAch(); }
        Panel frame = Panel.Column(); frame.Class = "mk-frame";
        frame.Pad(0); frame.Gap(0);
        frame.Prefer(0, Spec.MkFrameH());
        frame.Padding(Spec.MkFramePadT(), Spec.MkFramePadR(), 0, Spec.MkFramePadL());
        content.With(frame);

        frame.With(AchHeadBand());

        Panel mid = Panel.Row(); mid.Class = "mk-mid mk-fill";
        mid.Pad(0); mid.Gap(Spec.MkColGap());
        mid.Padding(0, 0, 0, Spec.MkMidPadL());
        mid.With(AchLeft());
        mid.With(AchRight());
        frame.With(mid);
    }

    // 顶带：成就分类（居中在左栏上）+ 说明 / 领取 / 奖励
    Panel AchHeadBand() {
        Panel wrap = Panel.Column(); wrap.Class = "mk-fixed"; wrap.Pad(0); wrap.Gap(0);
        wrap.Prefer(0, Spec.MkBandH() + Spec.MkBandLine());
        Panel band = Panel.Row(); band.Class = "mk-band";
        band.Pad(0); band.Gap(0); band.Prefer(0, Spec.MkBandH());

        Panel lz = Panel.Row(); lz.Class = "mk-cell"; lz.Pad(0);
        lz.Prefer(Spec.AcBandLabelW(), Spec.MkBandH());
        lz.With(Text("成就分类", "mk-band-t", 0));
        band.With(lz);

        Panel h1 = Panel.Row(); h1.Class = "mk-cell-l"; h1.Pad(0);
        h1.Prefer(Spec.AcCol1W(), Spec.MkBandH());
        h1.Padding(0, 0, 0, Spec.AcHeadPadL());
        h1.With(Text("说明", "mk-band-t", 0));
        band.With(h1);

        Panel h2 = Panel.Row(); h2.Class = "mk-cell-l"; h2.Pad(0);
        h2.Prefer(Spec.AcCol2W(), Spec.MkBandH());
        h2.Padding(0, 0, 0, Spec.AcHead2PadL());
        h2.With(Text("领取", "mk-band-t", 0));
        band.With(h2);

        Panel h3 = Panel.Row(); h3.Class = "mk-cell mk-fill"; h3.Pad(0);
        h3.Prefer(0, Spec.MkBandH());
        h3.Padding(0, Spec.AcHead3PadR(), 0, 0);
        h3.With(Text("奖励", "mk-band-t", 0));
        band.With(h3);

        wrap.With(band);
        Panel line = Panel.Row(); line.Class = "mk-band-line";
        line.Pad(0); line.Prefer(0, Spec.MkBandLine()); wrap.With(line);
        return wrap;
    }

    // 左：12 枚分类钮
    Panel AchLeft() {
        Panel p = Panel.Column(); p.Class = "mk-left mk-fixed";
        p.Pad(0); p.Gap(0); p.Prefer(Spec.MkLeftW(), 0);
        p.Padding(Spec.MkBandToBtn(), 0, 0, 0);
        List<string> cats = AchCats();
        for (int i = 0; i < cats.Count; i = i + 1) {
            int pick = i;
            Button b = Btn(cats[i], "tbl-btn mk-cat", () => { AchPickCat(pick); });
            b.Prefer(0, Spec.AcCatH());
            p.With(b);
            if (i + 1 < cats.Count) { p.With(TblPad(Spec.AcCatGap())); }
        }
        return p;
    }

    // 右：表格盒 + 页脚（只有分页）
    Panel AchRight() {
        Panel col = Panel.Column(); col.Class = "mk-right mk-fill";
        col.Pad(0); col.Gap(0);
        col.With(AchTable());
        col.With(AchFoot());
        return col;
    }

    Panel AchTable() {
        Panel box = Panel.Column(); box.Class = "mk-box mk-fill";
        box.Pad(0); box.Gap(0); box.Prefer(0, 0);
        box.Padding(0, Spec.MkRowPadX(), Spec.AcBoxPadB(), Spec.MkRowPadX());
        box.With(TblPad(Spec.MkHeadToRow()));
        List<AchRow> rows = AchRows();
        for (int r = 0; r < rows.Count; r = r + 1) {
            box.With(AchRowBox(rows[r]));
            if (r + 1 < rows.Count) { box.With(TblPad(Spec.MkRowGap())); }
        }
        return box;
    }

    /// 一行：说明两行字 + 领取钮 + 四枚奖励格（空格也画框）。
    Panel AchRowBox(AchRow it) {
        Panel row = Panel.Row(); row.Class = "mk-row";
        row.Pad(0); row.Gap(0); row.Prefer(0, Spec.MkRowH());

        Panel c0 = Panel.Row(); c0.Class = "mk-cell-l"; c0.Pad(0);
        c0.Prefer(Spec.AcCol1W(), Spec.MkRowH());
        c0.Padding(0, 0, 0, Spec.AcTextPadL());
        Panel txt = Panel.Column(); txt.Pad(0); txt.Gap(0);
        txt.Padding(Spec.AcNamePadT(), 0, 0, 0);
        Label nm = Text(it.NameText(), "ac-name", 0); nm.Prefer(0, Spec.AcLineH()); txt.With(nm);
        Label rq = Text(it.ReqText(), "ac-sub", 0); rq.Prefer(0, Spec.AcLineH()); txt.With(rq);
        c0.With(txt);
        row.With(c0);

        Panel c1 = Panel.Row(); c1.Class = "mk-cell"; c1.Pad(0);
        c1.Prefer(Spec.AcCol2W(), Spec.MkRowH());
        AchRow pick = it;
        c1.With(BtnDev("领 取", "tbl-btn mk-buy", Spec.AcTakeW(), Spec.AcTakeH(),
                       () => { AchTake(pick); }));
        row.With(c1);

        Panel c2 = Panel.Row(); c2.Class = "mk-cell-l mk-fill"; c2.Pad(0);
        c2.Prefer(0, Spec.MkRowH()); c2.Gap(Spec.AcSlotGap());
        c2.Padding(0, 0, 0, Spec.AcSlotPadL());
        for (int i = 0; i < it.rewards.Count; i = i + 1) {
            AchReward w = it.rewards[i];
            string art = w.picture > 0 ? ItemArtPath(w.picture) : "";
            c2.With(SpriteCellAt("", Spec.AcSlotW(), Spec.AcSlotW(), art,
                                 w.count, "slot-badge ac-badge",
                                 Spec.MkBadgeX(), Spec.MkBadgeY()));
        }
        row.With(c2);
        return row;
    }

    /// 页脚：无自底色，只有右侧分页（原版无跳转输入）。
    Panel AchFoot() {
        Panel f = Panel.Row(); f.Class = "mk-foot mk-fixed";
        f.Pad(0); f.Gap(0);
        f.Prefer(0, Spec.MkFootH());
        f.Padding(Spec.MkFootPadT(), Spec.MkFootPadR(), 0, Spec.MkFootPadL());
        Panel sp = Panel.Row(); sp.Class = "mk-fill"; sp.Pad(0); f.With(sp);
        SignalInt pgSig = new SignalInt(1);
        Pagination pg = new Pagination(Spec.AcPages(), pgSig);
        pg.Class = "simple";
        pg.PrevText("上一页"); pg.NextText("下一页");
        pg.Named("ach-pager");
        f.With(pg);
        return f;
    }

    // 动作：在线领取走服务端校验（未达标/重复领取由服务端拒绝并入聊天）；
    // 其余分类服务端未开，照惯例给明确反馈。
    void AchSay(string msg) {
        if (net.Self() != null) { net.AddChat("[系统]", msg); return; }
        g.Log(msg);
    }
    void AchPickCat(int i) {
        if (i == 0 && net.Self() != null) { net.RefreshAch(); return; }
        AchSay("成就：" + AchCats()[i] + (i == 0 ? "（离线模式）" : "（数据未接）"));
    }
    void AchTake(AchRow r) {
        if (net.Self() == null || r.no <= 0) { AchSay("成就：领取「" + r.name + "」（玩法未接）"); return; }
        if (r.state == 2) { AchSay("成就：「" + r.name + "」奖励已领取"); return; }
        net.AchTake(r.no);
    }
}
