    static int RankSlotCount() { return 10; }
    static int RankSlotX(int i) {
        if (i < 4) { return Px(131); }              // 右列
        if (i < 6) { return Px(5); }                // 左列
        if (i == 6) { return Px(5); }               // 底行
        if (i == 7) { return Px(46); }
        if (i == 8) { return Px(88); }
        return Px(131);
    }
    static int RankSlotY(int i) {
        if (i == 0) { return Px(43); }
        if (i == 1) { return Px(81); }
        if (i == 2) { return Px(132); }
        if (i == 3) { return Px(171); }
        if (i == 4) { return Px(132); }
        if (i == 5) { return Px(171); }
        return Px(210);                             // 底行
    }
