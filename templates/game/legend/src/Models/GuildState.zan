using System;
using Gui.Component;

public class GuildState {
    int myGuild;
    List<GuildItem> guilds;

    GuildState() {
        this.myGuild = 0;
        this.guilds = new List<GuildItem>();
    }

    int MyGuild { get { return myGuild; } set { myGuild = value; } }
    List<GuildItem> Guilds { get { return guilds; } }
}

// 攻城城市项强类型实体。
