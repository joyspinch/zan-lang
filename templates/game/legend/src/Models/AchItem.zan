using System;
using Gui.Component;

public class AchItem {
    string name;
    string req;
    int claimed;
    int ok;
    List<AchRewardItem> rewards;

    AchItem(string name, string req, int claimed, int ok) {
        this.name = name != null ? name : "";
        this.req = req != null ? req : "";
        this.claimed = claimed;
        this.ok = ok;
        this.rewards = new List<AchRewardItem>();
    }

    string Name { get { return name; } }
    string Req { get { return req; } }
    int Claimed { get { return claimed; } set { claimed = value; } }
    int Ok { get { return ok; } set { ok = value; } }
    List<AchRewardItem> Rewards { get { return rewards; } }
}

// 爵位榜行强类型实体。
