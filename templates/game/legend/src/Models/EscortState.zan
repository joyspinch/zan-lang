using System;
using Gui.Component;

public class EscortState {
    int tries;
    int stage;
    int left;
    int reward;

    EscortState() {
        this.tries = 0;
        this.stage = 0;
        this.left = 0;
        this.reward = 0;
    }

    int Tries { get { return tries; } set { tries = value; } }
    int Stage { get { return stage; } set { stage = value; } }
    int Left { get { return left; } set { left = value; } }
    int Reward { get { return reward; } set { reward = value; } }
}

// 行会项强类型实体。
