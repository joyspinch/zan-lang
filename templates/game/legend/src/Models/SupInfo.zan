using System;
using Gui.Component;

public class SupInfo {
    string title;  // 金标题：武器之攻 / 铠甲之首 …
    string sub;  // 小字条件说明：武器（攻击天赋>总系数>攻击值）
    string owner;  // 主人
    int itemId;  // items.csv 道具号（取图标）
    int badge;  // 道具图角标（0 = 原版这格没角标）
    bool copy;  // 是否可复制（原版：武器与铠甲不可复制）
    int fee;  // 复制费（灵符）
}
