using System;
using Gui.Component;

public class TowerRival {
    string name;
    int floor;
    int level;

    TowerRival(string name, int floor, int level) {
        this.name = name != null ? name : "";
        this.floor = floor;
        this.level = level;
    }

    string Name { get { return name; } }
    int Floor { get { return floor; } }
    int Level { get { return level; } }
}

// 爬塔玩法状态强类型实体（替代动态 JsonValue playTower）。
