using System;
using Gui.Component;

public class TowerState {
    int floor;
    int tries;
    int maxTries;
    List<TowerRival> rivals;

    TowerState() {
        this.floor = 0;
        this.tries = 0;
        this.maxTries = 10;
        this.rivals = new List<TowerRival>();
    }

    int Floor { get { return floor; } set { floor = value; } }
    int Tries { get { return tries; } set { tries = value; } }
    int MaxTries { get { return maxTries; } set { maxTries = value; } }
    List<TowerRival> Rivals { get { return rivals; } }
}

