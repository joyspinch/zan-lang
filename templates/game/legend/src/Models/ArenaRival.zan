using System;
using Gui.Component;

public class ArenaRival {
    int rank;
    string name;
    bool me;

    ArenaRival(int rank, string name, bool me) {
        this.rank = rank;
        this.name = name != null ? name : "";
        this.me = me;
    }

    int Rank { get { return rank; } }
    string Name { get { return name; } }
    bool Me { get { return me; } }
}

// 竞技场状态强类型实体（替代动态 JsonValue playArena）。
