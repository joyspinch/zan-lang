using System;
using Gui.Component;

public class MarketItem {
    int id;
    int itemId;
    string name;
    int count;
    long price;
    string seller;
    long age;
    bool mine;

    MarketItem(int id, int itemId, string name, int count, long price, string seller, long age, bool mine) {
        this.id = id;
        this.itemId = itemId;
        this.name = name != null ? name : "";
        this.count = count;
        this.price = price;
        this.seller = seller != null ? seller : "";
        this.age = age;
        this.mine = mine;
    }

    int Id { get { return id; } }
    int ItemId { get { return itemId; } }
    string Name { get { return name; } }
    int Count { get { return count; } }
    long Price { get { return price; } }
    string Seller { get { return seller; } }
    long Age { get { return age; } }
    bool Mine { get { return mine; } }
}

// 成就奖励项强类型实体。
