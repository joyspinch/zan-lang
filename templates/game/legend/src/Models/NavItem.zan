using System;
using Gui.Component;

public class NavItem {
    int id;
    string name;
    string icon;
    string label;
    int x;
    int w;

    NavItem(int id, string name, string icon, string label, int x, int w) {
        this.id = id;
        this.name = name != null ? name : "";
        this.icon = icon != null ? icon : "";
        this.label = label != null ? label : "";
        this.x = x;
        this.w = w;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    string Icon { get { return icon; } }
    string Label { get { return label; } }
    int X { get { return x; } }
    int W { get { return w; } }
}

// 装备与物品槽位强类型实体。
