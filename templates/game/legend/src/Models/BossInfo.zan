using System;
using Gui.Component;

public class BossInfo {
    int id;
    int tpl;
    string name;
    int minLevel;
    int rebirth;
    long hp;
    long maxHp;
    int mp;
    int atkMin;
    int atkMax;
    int def;
    int mdef;
    int mapId;
    int exp;
    string gold;
    bool alive;
    long respawnIn;
    string drop;
    string picture;
    int tries;

    BossInfo(int id, string name, int minLevel, int rebirth, long maxHp) {
        this.id = id;
        this.tpl = id;
        this.name = name != null ? name : "";
        this.minLevel = minLevel;
        this.rebirth = rebirth;
        this.maxHp = maxHp;
        this.hp = maxHp;
        this.mp = 0;
        this.atkMin = 0;
        this.atkMax = 0;
        this.def = 0;
        this.mdef = 0;
        this.mapId = 0;
        this.exp = 0;
        this.gold = "";
        this.alive = true;
        this.respawnIn = 0;
        this.drop = "";
        this.picture = "";
        this.tries = 3;
    }

    int Id { get { return id; } }
    int Tpl { get { return tpl; } set { tpl = value; } }
    string Name { get { return name; } }
    int MinLevel { get { return minLevel; } set { minLevel = value; } }
    int Rebirth { get { return rebirth; } set { rebirth = value; } }
    long Hp { get { return hp; } set { hp = value; } }
    long MaxHp { get { return maxHp; } set { maxHp = value; } }
    int Mp { get { return mp; } set { mp = value; } }
    int AtkMin { get { return atkMin; } set { atkMin = value; } }
    int AtkMax { get { return atkMax; } set { atkMax = value; } }
    int Def { get { return def; } set { def = value; } }
    int Mdef { get { return mdef; } set { mdef = value; } }
    int MapId { get { return mapId; } set { mapId = value; } }
    int Exp { get { return exp; } set { exp = value; } }
    string Gold { get { return gold; } set { gold = value; } }
    bool Alive { get { return alive; } set { alive = value; } }
    long RespawnIn { get { return respawnIn; } set { respawnIn = value; } }
    string Drop { get { return drop; } set { drop = value; } }
    string Picture { get { return picture; } set { picture = value; } }
    int Tries { get { return tries; } set { tries = value; } }
}

// 表数据 BOSS 详情强类型实体（替代 PageBossHome/表查询中对 bosses.csv 的动态 DataRow.Int 访问）。
