using System;
using Gui.Component;

public class TableUiColSpec {
    public string title;
    public int width;

    public TableUiColSpec(string title, int width) {
        this.title = title != null ? title : "";
        this.width = width;
    }

    public static TableUiColSpec Of(string title, int width) {
        return new TableUiColSpec(title, width);
    }
}

// 强类型表格单元格实体：消除 cells 与 classes、widths 的平行列表反模式。
