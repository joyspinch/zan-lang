using System;
using Gui.Component;

public class WuxingRowItem {
    int id;
    string name;
    int itemId;
    int rank;
    int xp;
    int need;
    int cap;

    WuxingRowItem(int id, string name, int itemId, int rank, int xp, int need, int cap) {
        this.id = id;
        this.name = name != null ? name : "";
        this.itemId = itemId;
        this.rank = rank;
        this.xp = xp;
        this.need = need;
        this.cap = cap;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    int ItemId { get { return itemId; } }
    int Rank { get { return rank; } }
    int Xp { get { return xp; } }
    int Need { get { return need; } }
    int Cap { get { return cap; } }
}

// 五行修炼玩法状态强类型实体（替代动态 JsonValue playWuxing）。
