using System;
using Gui.Component;

public class AchRewardItem {
    int pic;
    string badge;

    AchRewardItem(int pic, string badge) {
        this.pic = pic;
        this.badge = badge != null ? badge : "";
    }

    int Pic { get { return pic; } }
    string Badge { get { return badge; } }
}

// 成就条目强类型实体（替代动态 JsonValue playAch 项）。
