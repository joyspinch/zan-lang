using System;
using Gui.Component;

public class BagSkillEntry {
    int slot;
    string name;
    int rank;
    int maxLv;
    int costGold;
    bool owned;

    BagSkillEntry(int slot, string name, int rank, int maxLv, int costGold, bool owned) {
        this.slot = slot;
        this.name = name != null ? name : "";
        this.rank = rank;
        this.maxLv = maxLv;
        this.costGold = costGold;
        this.owned = owned;
    }
}
