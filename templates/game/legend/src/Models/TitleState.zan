using System;
using Gui.Component;

public class TitleState {
    int activeTitle;
    int totalPages;
    List<TitleItem> titles;

    TitleState() {
        this.activeTitle = 0;
        this.totalPages = 1;
        this.titles = new List<TitleItem>();
    }

    int ActiveTitle { get { return activeTitle; } set { activeTitle = value; } }
    int TotalPages { get { return totalPages; } set { totalPages = value; } }
    List<TitleItem> Titles { get { return titles; } }
}

// 五行修炼单行强类型实体（服务端权威事实驱动：id/name/itemId/rank/xp/need/cap）。
