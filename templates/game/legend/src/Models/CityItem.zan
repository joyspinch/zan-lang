using System;
using Gui.Component;

public class CityItem {
    int id;
    string name;
    string owner;
    string guild;
    int income;
    int cost;
    string date;

    CityItem(int id, string name, string owner, string guild, int income, int cost, string date) {
        this.id = id;
        this.name = name != null ? name : "";
        this.owner = owner != null ? owner : "";
        this.guild = guild != null ? guild : "";
        this.income = income;
        this.cost = cost;
        this.date = date != null ? date : "";
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    string Owner { get { return owner; } }
    string Guild { get { return guild; } }
    int Income { get { return income; } }
    int Cost { get { return cost; } }
    string Date { get { return date; } }
}

// 沙巴克奖励强类型实体。
