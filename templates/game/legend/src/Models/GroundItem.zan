using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Game.Arpg;

public class GroundItem {
    Equipment item;
    string name;
    int tier;
    int x;
    int y;
    bool hasPillar;
    string pillarClass;
    Label widget;
    int life;

    static GroundItem Create(Equipment eq, int x, int y) {
        GroundItem gi = new GroundItem();
        gi.item = eq;
        gi.name = eq.Name();
        gi.tier = eq.tier;
        gi.x = x;
        gi.y = y;
        gi.life = 200;  // 存活帧数
        gi.hasPillar = false;
        gi.pillarClass = "";

        if (eq.tier >= 5 || eq.HasAffix()) {
            gi.hasPillar = true;
            gi.pillarClass = "fct-pillar-gold";
        } else if (eq.tier == 4) {
            gi.hasPillar = true;
            gi.pillarClass = "fct-pillar-orange";
        } else if (eq.tier == 3) {
            gi.hasPillar = true;
            gi.pillarClass = "fct-pillar-purple";
        }
        return gi;
    }
}
