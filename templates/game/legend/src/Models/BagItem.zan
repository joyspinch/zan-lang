using System;
using Gui.Component;

public class BagItem {
    int slot;
    int itemId;
    string name;
    int count;
    int quality;
    int itemType;
    int kind;
    int price;
    int recyclePrice;
    int picture;

    BagItem(int slot, int itemId, string name, int count) {
        this.slot = slot;
        this.itemId = itemId;
        this.name = name != null ? name : "";
        this.count = count;
        this.quality = 0;
        this.itemType = 0;
        this.kind = 0;
        this.price = 0;
        this.recyclePrice = 0;
        this.picture = 0;
    }

    int Slot { get { return slot; } set { slot = value; } }
    int ItemId { get { return itemId; } set { itemId = value; } }
    string Name { get { return name; } set { name = value; } }
    int Count { get { return count; } set { count = value; } }
    int Quality { get { return quality; } set { quality = value; } }
    int ItemType { get { return itemType; } set { itemType = value; } }
    int Kind { get { return kind; } set { kind = value; } }
    int Price { get { return price; } set { price = value; } }
    int RecyclePrice { get { return recyclePrice; } set { recyclePrice = value; } }
    int Picture { get { return picture; } set { picture = value; } }
}

// 怪物与首领强类型数据实体。
