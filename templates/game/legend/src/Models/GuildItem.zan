using System;
using Gui.Component;

public class GuildItem {
    int id;
    string name;
    string leader;
    int members;
    int memberCap;
    int fund;
    bool mine;

    GuildItem(int id, string name, string leader, int members, int memberCap, int fund, bool mine) {
        this.id = id;
        this.name = name != null ? name : "";
        this.leader = leader != null ? leader : "";
        this.members = members;
        this.memberCap = memberCap;
        this.fund = fund;
        this.mine = mine;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    string Leader { get { return leader; } }
    int Members { get { return members; } }
    int MemberCap { get { return memberCap; } }
    int Fund { get { return fund; } }
    bool Mine { get { return mine; } }
}

// 行会玩法状态强类型实体（替代动态 JsonValue playGuild）。
