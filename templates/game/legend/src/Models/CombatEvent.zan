using System;

public class CombatEvent {
    int damage;
    bool isCrit;
    bool isLuckMax;
    string skillName;
    bool isMiss;
    bool isPoison;
    bool isPlayerAttack;
    int targetX;
    int targetY;

    static CombatEvent PlayerStrike(int dmg, bool crit, bool luckMax, string skill, int tx, int ty) {
        CombatEvent ev = new CombatEvent();
        ev.damage = dmg;
        ev.isCrit = crit;
        ev.isLuckMax = luckMax;
        ev.skillName = skill;
        ev.isMiss = false;
        ev.isPoison = false;
        ev.isPlayerAttack = true;
        ev.targetX = tx;
        ev.targetY = ty;
        return ev;
    }

    static CombatEvent MonsterStrike(int dmg, int tx, int ty) {
        CombatEvent ev = new CombatEvent();
        ev.damage = dmg;
        ev.isCrit = false;
        ev.isLuckMax = false;
        ev.skillName = "";
        ev.isMiss = false;
        ev.isPoison = false;
        ev.isPlayerAttack = false;
        ev.targetX = tx;
        ev.targetY = ty;
        return ev;
    }

    static CombatEvent Miss(int tx, int ty) {
        CombatEvent ev = new CombatEvent();
        ev.damage = 0;
        ev.isMiss = true;
        ev.isPlayerAttack = true;
        ev.targetX = tx;
        ev.targetY = ty;
        return ev;
    }
}
