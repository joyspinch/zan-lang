

public class CombatDamagePopup {
    string text;
    string cssClass;
    int x;
    int y;
    int startY;
    int life;
    int maxLife;
    Label label;
    bool alive;

    static CombatDamagePopup Create(string text, string cssClass, int x, int y, int duration) {
        CombatDamagePopup p = new CombatDamagePopup();
        p.text = text;
        p.cssClass = cssClass;
        p.x = x;
        p.y = y;
        p.startY = y;
        p.life = duration;
        p.maxLife = duration;
        p.alive = true;
        return p;
    }

    void Update() {
        if (!alive) { return; }
        // 向上平滑漂浮
        y = y - 3;
        life = life - 1;
        if (life <= 0) {
            alive = false;
        }
        if (label != null) {
            label.Place(x, y);
        }
    }
}
