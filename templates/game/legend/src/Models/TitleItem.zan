using System;
using Gui.Component;

public class TitleItem {
    int id;
    string name;
    long fame;
    long gold;
    int rebirth;
    int level;
    int atkMin;
    int atkMax;
    int magMin;
    int magMax;
    int taoMin;
    int taoMax;
    int defMin;
    int defMax;
    int mdefMin;
    int mdefMax;
    bool active;
    bool unlocked;

    TitleItem(int id, string name, long fame, long gold, int rebirth, int level,
              int atkMin, int atkMax, int magMin, int magMax,
              int taoMin, int taoMax, int defMin, int defMax,
              int mdefMin, int mdefMax, bool active, bool unlocked) {
        this.id = id;
        this.name = name != null ? name : "";
        this.fame = fame;
        this.gold = gold;
        this.rebirth = rebirth;
        this.level = level;
        this.atkMin = atkMin;
        this.atkMax = atkMax;
        this.magMin = magMin;
        this.magMax = magMax;
        this.taoMin = taoMin;
        this.taoMax = taoMax;
        this.defMin = defMin;
        this.defMax = defMax;
        this.mdefMin = mdefMin;
        this.mdefMax = mdefMax;
        this.active = active;
        this.unlocked = unlocked;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    long Fame { get { return fame; } }
    long Gold { get { return gold; } }
    int Rebirth { get { return rebirth; } }
    int Level { get { return level; } }
    int AtkMin { get { return atkMin; } }
    int AtkMax { get { return atkMax; } }
    int MagMin { get { return magMin; } }
    int MagMax { get { return magMax; } }
    int TaoMin { get { return taoMin; } }
    int TaoMax { get { return taoMax; } }
    int DefMin { get { return defMin; } }
    int DefMax { get { return defMax; } }
    int MdefMin { get { return mdefMin; } }
    int MdefMax { get { return mdefMax; } }
    bool Active { get { return active; } set { active = value; } }
    bool Unlocked { get { return unlocked; } set { unlocked = value; } }
}

// 称号系统玩法状态强类型实体（替代动态 JsonValue playTitle）。
