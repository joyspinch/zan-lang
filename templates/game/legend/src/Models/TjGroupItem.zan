using System;
using Gui.Component;

public class TjGroupItem {
    int gno;
    int coeff;
    int complete;
    List<int> slots;

    TjGroupItem(int gno, int coeff, int complete) {
        this.gno = gno;
        this.coeff = coeff;
        this.complete = complete;
        this.slots = new List<int>();
    }

    int Gno { get { return gno; } }
    int Coeff { get { return coeff; } set { coeff = value; } }
    int Complete { get { return complete; } set { complete = value; } }
    List<int> Slots { get { return slots; } }
}

// 神兵图鉴玩法状态强类型实体（替代动态 JsonValue playTj）。
