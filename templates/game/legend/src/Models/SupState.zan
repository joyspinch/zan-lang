using System;
using Gui.Component;

public class SupState {
    int bonus;
    List<SupGridItem> rows;

    SupState() {
        this.bonus = 0;
        this.rows = new List<SupGridItem>();
    }

    int Bonus { get { return bonus; } set { bonus = value; } }
    List<SupGridItem> Rows { get { return rows; } }
}

// 神兵图鉴单组槽位强类型实体。
