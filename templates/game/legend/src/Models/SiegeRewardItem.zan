using System;
using Gui.Component;

public class SiegeRewardItem {
    int picture;
    int count;

    SiegeRewardItem(int picture, int count) {
        this.picture = picture;
        this.count = count;
    }

    int Picture { get { return picture; } }
    int Count { get { return count; } }
}

// 攻城玩法状态强类型实体（替代动态 JsonValue playSiege）。
