using System;
using Gui.Component;

public class MentorMateItem {
    string name;
    int level;
    int cnt;

    MentorMateItem(string name, int level, int cnt) {
        this.name = name != null ? name : "";
        this.level = level;
        this.cnt = cnt;
    }

    string Name { get { return name; } }
    int Level { get { return level; } }
    int Cnt { get { return cnt; } }
}

// 师徒系统玩法状态强类型实体（替代动态 JsonValue playMentor）。
