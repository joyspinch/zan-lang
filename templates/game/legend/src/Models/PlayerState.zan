using System;
using Gui.Component;

public class PlayerState {
    int id;
    string name;
    int realm;
    int level;
    long exp;
    long expNext;
    int hp;
    int maxHp;
    int mp;
    int maxMp;
    int atk;
    int def;
    long gold;
    long ingots;
    int kills;
    int mapId;
    int mapUnlocked;
    int x;
    int y;
    long fame;
    long merit;
    long spirit;
    int job;
    string title;
    int weaponStar;
    int armorStar;

    PlayerState() {
        this.id = 0;
        this.name = "";
        this.realm = 1;
        this.level = 1;
        this.exp = 0;
        this.expNext = 100;
        this.hp = 100;
        this.maxHp = 100;
        this.mp = 50;
        this.maxMp = 50;
        this.atk = 10;
        this.def = 5;
        this.gold = 0;
        this.ingots = 0;
        this.kills = 0;
        this.mapId = 1;
        this.mapUnlocked = 1;
        this.x = 0;
        this.y = 0;
        this.fame = 0;
        this.merit = 0;
        this.spirit = 0;
        this.job = 0;
        this.title = "";
        this.weaponStar = 0;
        this.armorStar = 0;
    }

    int Id { get { return id; } set { id = value; } }
    string Name { get { return name; } set { name = value; } }
    int Realm { get { return realm; } set { realm = value; } }
    int Level { get { return level; } set { level = value; } }
    long Exp { get { return exp; } set { exp = value; } }
    long ExpNext { get { return expNext; } set { expNext = value; } }
    int Hp { get { return hp; } set { hp = value; } }
    int MaxHp { get { return maxHp; } set { maxHp = value; } }
    int Mp { get { return mp; } set { mp = value; } }
    int MaxMp { get { return maxMp; } set { maxMp = value; } }
    int Atk { get { return atk; } set { atk = value; } }
    int Def { get { return def; } set { def = value; } }
    long Gold { get { return gold; } set { gold = value; } }
    long Ingots { get { return ingots; } set { ingots = value; } }
    int Kills { get { return kills; } set { kills = value; } }
    int MapId { get { return mapId; } set { mapId = value; } }
    int MapUnlocked { get { return mapUnlocked; } set { mapUnlocked = value; } }
    int X { get { return x; } set { x = value; } }
    int Y { get { return y; } set { y = value; } }
    long Fame { get { return fame; } set { fame = value; } }
    long Merit { get { return merit; } set { merit = value; } }
    long Spirit { get { return spirit; } set { spirit = value; } }
    int Job { get { return job; } set { job = value; } }
    string Title { get { return title; } set { title = value; } }
    int WeaponStar { get { return weaponStar; } set { weaponStar = value; } }
    int ArmorStar { get { return armorStar; } set { armorStar = value; } }
}

// 导航项强类型实体（替代 navigation.csv 运行时动态 DataRow 查找）。
