using System;
using Gui.Component;

public class RankItem {
    int rank;
    int playerId;
    string name;
    int level;
    long value;
    int job;
    long exp;

    RankItem(int rank, int playerId, string name, int level, long value, int job, long exp) {
        this.rank = rank;
        this.playerId = playerId;
        this.name = name != null ? name : "";
        this.level = level;
        this.value = value;
        this.job = job;
        this.exp = exp;
    }

    int Rank { get { return rank; } }
    int PlayerId { get { return playerId; } }
    string Name { get { return name; } }
    int Level { get { return level; } }
    long Value { get { return value; } }
    int Job { get { return job; } }
    long Exp { get { return exp; } }
}

// 竞技场对手强类型实体。
