using System;
using Gui.Component;

public class WuxingState {
    int pool;
    int poolCap;
    List<WuxingRowItem> rows;

    WuxingState() {
        this.pool = 0;
        this.poolCap = 0;
        this.rows = new List<WuxingRowItem>();
    }

    int Pool { get { return pool; } set { pool = value; } }
    int PoolCap { get { return poolCap; } set { poolCap = value; } }
    List<WuxingRowItem> Rows { get { return rows; } }
}

// 祭坛系统玩法状态强类型实体（替代动态 JsonValue playAltar）。
