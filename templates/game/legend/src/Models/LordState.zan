using System;
using Gui.Component;

public class LordState {
    int myTier;
    int myContrib;
    int myBonus;
    int mySpeed;
    int myExp;
    List<LordRankRow> rows;

    LordState() {
        this.myTier = 4;
        this.myContrib = 0;
        this.myBonus = 0;
        this.mySpeed = 0;
        this.myExp = 0;
        this.rows = new List<LordRankRow>();
    }

    int MyTier { get { return myTier; } set { myTier = value; } }
    int MyContrib { get { return myContrib; } set { myContrib = value; } }
    int MyBonus { get { return myBonus; } set { myBonus = value; } }
    int MySpeed { get { return mySpeed; } set { mySpeed = value; } }
    int MyExp { get { return myExp; } set { myExp = value; } }
    List<LordRankRow> Rows { get { return rows; } }
}

// 至尊殿堂格位强类型实体（服务端权威事实：title/sub/itemId/itemName/owner/value/copyable/fee）。
