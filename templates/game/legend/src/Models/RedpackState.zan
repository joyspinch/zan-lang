using System;
using Gui.Component;

public class RedpackState {
    int active;
    int left;
    int grab;
    int pool;
    int taken;

    RedpackState() {
        this.active = 0;
        this.left = 0;
        this.grab = 0;
        this.pool = 0;
        this.taken = 0;
    }

    int Active { get { return active; } set { active = value; } }
    int Left { get { return left; } set { left = value; } }
    int Grab { get { return grab; } set { grab = value; } }
    int Pool { get { return pool; } set { pool = value; } }
    int Taken { get { return taken; } set { taken = value; } }
}

// 称号系统单项强类型实体。
