using System;
using Gui.Component;

public class ShopItem {
    int id;
    string name;
    int price;
    int picture;
    int kind;

    ShopItem(int id, string name, int price, int picture, int kind) {
        this.id = id;
        this.name = name != null ? name : "";
        this.price = price;
        this.picture = picture;
        this.kind = kind;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    int Price { get { return price; } }
    int Picture { get { return picture; } }
    int Kind { get { return kind; } }
}

// 排行榜单项强类型实体（替代 rank 回复中的动态 JsonValue 项）。
