using System;
using Gui.Component;

public class StarRowItem {
    string name;
    int level;
    int map;
    bool lit;

    StarRowItem(string name, int level, int map, bool lit) {
        this.name = name != null ? name : "";
        this.level = level;
        this.map = map;
        this.lit = lit;
    }

    string Name { get { return name; } }
    int Level { get { return level; } }
    int Map { get { return map; } }
    bool Lit { get { return lit; } }
}

// 将星图谱玩法状态强类型实体（替代动态 JsonValue playStars）。
