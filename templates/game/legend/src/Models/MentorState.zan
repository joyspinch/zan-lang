using System;
using Gui.Component;

public class MentorState {
    string master;
    bool canTake;
    List<MentorMateItem> mates;

    MentorState() {
        this.master = "";
        this.canTake = false;
        this.mates = new List<MentorMateItem>();
    }

    string Master { get { return master; } set { master = value; } }
    bool CanTake { get { return canTake; } set { canTake = value; } }
    List<MentorMateItem> Mates { get { return mates; } }
}

// 红包系统玩法状态强类型实体（替代动态 JsonValue playRedpack）。
