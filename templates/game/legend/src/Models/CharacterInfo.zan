using System;
using Gui.Component;

public class CharacterInfo {
    int id;
    string name;
    int level;
    int job;

    CharacterInfo(int id, string name, int level, int job) {
        this.id = id;
        this.name = name != null ? name : "";
        this.level = level;
        this.job = job;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    int Level { get { return level; } }
    int Job { get { return job; } }
}

// 个人/野外 BOSS 元数据强类型实体（替代 bosses 回复中的动态 JsonValue 项）。
