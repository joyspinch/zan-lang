using System;
using Gui.Component;

public class SupGridItem {
    string title;
    string sub;
    int itemId;
    string itemName;
    string owner;
    int value;
    bool copyable;
    int fee;

    SupGridItem(string title, string sub, int itemId, string itemName, string owner, int value, bool copyable, int fee) {
        this.title = title != null ? title : "";
        this.sub = sub != null ? sub : "";
        this.itemId = itemId;
        this.itemName = itemName != null ? itemName : "";
        this.owner = owner != null ? owner : "";
        this.value = value;
        this.copyable = copyable;
        this.fee = fee;
    }

    string Title { get { return title; } }
    string Sub { get { return sub; } }
    int ItemId { get { return itemId; } }
    string ItemName { get { return itemName; } }
    string Owner { get { return owner; } }
    int Value { get { return value; } }
    bool Copyable { get { return copyable; } }
    int Fee { get { return fee; } }
}

// 至尊殿堂玩法状态强类型实体（替代动态 JsonValue playSup）。
