using System;
using Gui.Component;

public class SceneRankRow {
    string name;
    int floor;
    int level;

    SceneRankRow(string name, int floor, int level) {
        this.name = name != null ? name : "";
        this.floor = floor;
        this.level = level;
    }

    string Name { get { return name; } }
    int Floor { get { return floor; } }
    int Level { get { return level; } }
}
