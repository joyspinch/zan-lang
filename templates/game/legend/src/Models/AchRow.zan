using System;
using Gui.Component;

public class AchRow {
    string name;  // 「10级奖励」
    string req;  // 「等级达到10级」
    List<AchReward> rewards;  // 恒 4 枚（空格 picture = 0）
    int no;  // 服务端成就定义 1 基行号（离线行 = 0）
    int state;  // 0 条件未达 / 1 可领取 / 2 已领取
    string NameText() { return "成就：" + name; }
    string ReqText() { return "要求：" + req; }
}
