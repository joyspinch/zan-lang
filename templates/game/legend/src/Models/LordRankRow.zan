using System;
using Gui.Component;

public class LordRankRow {
    int tier;
    string name;
    int contrib;
    bool self;

    LordRankRow(int tier, string name, int contrib, bool self) {
        this.tier = tier;
        this.name = name != null ? name : "";
        this.contrib = contrib;
        this.self = self;
    }

    int Tier { get { return tier; } }
    string Name { get { return name; } }
    int Contrib { get { return contrib; } }
    bool Self { get { return self; } }
}

// 爵位系统状态强类型实体（替代动态 JsonValue playLord）。
