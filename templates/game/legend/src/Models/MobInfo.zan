using System;
using Gui.Component;

public class MobInfo {
    int id;
    int tpl;
    string name;
    int level;
    int hp;
    int maxHp;
    int atk;
    int def;
    bool alive;
    int respawnIn;

    MobInfo(int id, string name, int level, int maxHp) {
        this.id = id;
        this.tpl = id;
        this.name = name != null ? name : "";
        this.level = level;
        this.maxHp = maxHp;
        this.hp = maxHp;
        this.atk = 5;
        this.def = 2;
        this.alive = true;
        this.respawnIn = 0;
    }

    int Id { get { return id; } }
    int Tpl { get { return tpl; } set { tpl = value; } }
    string Name { get { return name; } }
    int Level { get { return level; } }
    int Hp { get { return hp; } set { hp = value; } }
    int MaxHp { get { return maxHp; } }
    int Atk { get { return atk; } }
    int Def { get { return def; } }
    bool Alive { get { return alive; } set { alive = value; } }
    int RespawnIn { get { return respawnIn; } set { respawnIn = value; } }
}

// 地图区域元数据强类型实体。
