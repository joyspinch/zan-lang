using System;
using Gui.Component;

public class AltarState {
    int personal;
    int cap;
    int globalProgress;
    int globalCap;

    AltarState() {
        this.personal = 0;
        this.cap = 0;
        this.globalProgress = 0;
        this.globalCap = 0;
    }

    int Personal { get { return personal; } set { personal = value; } }
    int Cap { get { return cap; } set { cap = value; } }
    int GlobalProgress { get { return globalProgress; } set { globalProgress = value; } }
    int GlobalCap { get { return globalCap; } set { globalCap = value; } }
}

// 将星图谱单星位强类型实体。
