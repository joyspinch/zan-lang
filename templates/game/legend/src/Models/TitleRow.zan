using System;
using Gui.Component;

public class TitleRow {
    string name;
    long fame;  // 需要声望
    long gold;  // 需要金钱
    int rebirth;  // 转数（0 = 未转）
    int level;
    Pair atk;
    Pair mag;
    Pair tao;
    Pair def;
    Pair mdef;
    string FameText() { return Rules.Wan(fame); }
    string GoldText() { return Rules.Wan(gold); }
    string LevelText() {
        string pre = rebirth > 0 ? Rules.N(rebirth) + "转" : "";
        return pre + Rules.N(level) + "级";
    }
}
