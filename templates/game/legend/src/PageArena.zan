using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 1「PK竞技场」——照原版还原，规格见 Spec / REFERENCE_AUDIT §5.5。
///
///   · 上半是 8 列 × 2 行 = 16 张挑战卡，每卡：头像 → 名字（黄）→
///     「排名: N」（绿标签 / 青数字）→「挑战」钮（深底亮蓝框蓝字）
///   · 前三名的头像带彩框（金 / 品红 / 青），其余名次不带框
///   · 下半一条整宽分隔线切成两块：左「系统/提示」日志面板（5 行规则说明
///     + 底部一行橙字提示），右统计面板（我的排名/挑战次数/挑战时间/累计
///     战功 + 领取战功/刷新数据 两钮）
///   · 卡阵贴主区左上（与地图页同一条竖向节奏：上留白 = MapMargin），
///     下段贴主区底（页高多出来的部分全给日志面板，与原版一致）
///
/// 卡上的人名/名次：服务端 arena.rows（本区战功榜）优先，没有就退回原版
/// 截图上的演示榜——离线壳（LEGEND_OFFLINE=1）不拨号，页面也得能看出布局，
/// 和地图页的素材兜底是同一套思路。
partial class LegendApp {
    /// 离线演示榜：原版截图上的 16 个名字。
    static string[] ArenaDemoNames() {
        return new string[] {
            "龙卫——天尊", "无敌绵羊", "龙卫——圣战", "漆星天使",
            "大白菜", "龙卫——法神", "风之魔装神机", "无敌奶爸",
            "学会微笑", "燃烧你的梦", "布衣侯", "爱上你是个错",
            "虾仁猪心", "99", "哪呀哪呀鹅哦", "看见啥的就是"
        };
    }

    /// 离线演示榜的名次：原版截图是「前 8 名 + 2036..2043」。
    static int[] ArenaDemoRanks() {
        return new int[] {
            1, 2, 3, 4, 5, 6, 7, 8,
            2036, 2037, 2038, 2039, 2040, 2041, 2042, 2043
        };
    }

    /// 头像素材：原版这一格画的是该玩家的职业/性别立绘，我们手上的立绘
    /// 就是 ui/00043..00048.jpg 这 6 张（62×60，与 71×68 的卡位近 1:1），
    /// 按卡序轮换。
    static string ArenaFacePath(int i) {
        int n = 43 + i % 6;
        return "assets/ui/000" + Rules.N(n) + ".jpg";
    }

    /// 第 i 张卡的服务端强类型实体行；没有（离线 / 服务端还没给榜）返回 null。
    ArenaRival ArenaRowAt(int i) {
        ArenaState a = net.TypedArena();
        if (a == null || a.Rows == null || i >= a.Rows.Count) { return null; }
        return a.Rows[i];
    }

    string ArenaName(int i) {
        ArenaRival r = ArenaRowAt(i);
        if (r != null) { return r.Name; }
        return ArenaDemoNames()[i % Spec.ArenaCards()];
    }

    int ArenaRank(int i) {
        ArenaRival r = ArenaRowAt(i);
        if (r != null) { return r.Rank; }
        return ArenaDemoRanks()[i % Spec.ArenaCards()];
    }

    /// 挑战时间：服务端目前不下发「上次挑战时刻」（只有每日重置用的
    /// arenaTryDate），先显示构建本页时的本地时刻——原版这一栏也是本地
    /// 时间格式。服务端补下发后这里换成取 arena.time（TASKS.md 已记缺口）。
    static string ArenaClock() {
        DateTime t = DateTime.Now();
        return Rules.N(t.year) + "-" + Rules.N(t.month).PadLeft(2, "0") + "-"
            + Rules.N(t.day).PadLeft(2, "0") + " "
            + Rules.N(t.hour).PadLeft(2, "0") + ":"
            + Rules.N(t.minute).PadLeft(2, "0") + ":"
            + Rules.N(t.second).PadLeft(2, "0");
    }

    void BuildArena() {
        net.MaybeRefreshArena();

        int wallW = Spec.ArenaWallW();
        int wallH = Spec.ArenaWallH();
        /* 宽高按**运行期画布**算（同地图页：页面必须在窗口拿到最终尺寸后
           重建，否则这里拿到的是 resize 前的旧画布）。 */
        int pageW = app.ClientWidth() - Spec.LeftPad() - Spec.LeftW()
            - Spec.ChatW() - Spec.ChatPadR();
        int pageH = app.ClientHeight() - app.ContentTop() - Spec.ContentTopPad()
            - Spec.TopH() - Spec.BotTileRowH() - Spec.BotTileBottom();

        int leftInset = (pageW - wallW) / 2;
        if (leftInset < Spec.MapMargin()) { leftInset = Spec.MapMargin(); }

        Panel body = Panel.Column(); body.Class = "arena-page";
        body.Pad(0); body.Gap(0); body.Grow(); content.With(body);

        /* 上留白（dock=1，必须用 With）→ 卡阵行（定高）→ 卡阵与下段之间
           的留白 → 下段（Grow，dock=5 吃满余量、贴页底）。停靠容器先摆
           dock 1..4 再摆 5，所以下段天然落在最后。 */
        Panel top = Panel.Column(); top.Prefer(0, Spec.MapMargin());
        body.With(top);

        Panel gridRow = Panel.Row(); gridRow.Pad(0); gridRow.Gap(0);
        gridRow.Prefer(0, wallH); body.With(gridRow);
        gridRow.With(SpacerW(leftInset));
        Panel grid = Panel.Column(); grid.Class = "arena-wall";
        grid.Pad(0); grid.Gap(Spec.ArenaRowGap()); grid.Prefer(wallW, wallH);
        gridRow.With(grid);
        for (int r = 0; r < Spec.ArenaRows(); r = r + 1) {
            Panel row = Panel.Row(); row.Class = "arena-row";
            row.Pad(0); row.Gap(Spec.ArenaColGap());
            row.Prefer(0, Spec.ArenaEntryH()); grid.With(row);
            for (int c = 0; c < Spec.ArenaCols(); c = c + 1) {
                int i = r * Spec.ArenaCols() + c;
                row.With(ArenaCard(i));
            }
        }

        Panel tail = Panel.Column(); tail.Prefer(0, Spec.MapMargin());
        body.With(tail);

        Panel band = Panel.Row(); band.Class = "arena-band";
        band.Pad(0); band.Gap(0); band.Grow(); body.With(band);
        /* 左日志 / 右统计。统计面板 AnchorRight（dock=4）而不是 With */
        band.With(ArenaLogPane(leftInset));
        Panel stats = ArenaStatsPane();
        stats.AnchorRight(); band.Add(stats);
    }

    /// 一张挑战卡。名次 1..3 的头像带彩框（原版：金 / 品红 / 青）。
    Panel ArenaCard(int i) {
        int rank = ArenaRank(i);
        string name = ArenaName(i);

        Panel card = Panel.Column(); card.Class = "arena-card";
        card.Pad(0); card.Gap(Spec.ArenaTextGap());
        card.Prefer(Spec.ArenaCardW(), Spec.ArenaEntryH());

        Image face = new Image(ArenaFacePath(i), name, "cover");
        face.Class = rank == 1 ? "arena-face arena-face-1"
            : rank == 2 ? "arena-face arena-face-2"
            : rank == 3 ? "arena-face arena-face-3" : "arena-face";
        face.Prefer(Spec.ArenaCardW(), Spec.ArenaCardH());
        card.With(face);

        /* 名字与排名行都占满卡宽：卡在交叉轴上居中对齐（挑战钮要居中），
           这两行必须撑满才不会跟着缩成内容宽——原版里它们是贴卡左缘的。 */
        Label nm = Text(name, "arena-name", 0);
        nm.Prefer(Spec.ArenaCardW(), Spec.ArenaNameH()); card.With(nm);

        Panel rk = Panel.Row(); rk.Class = "arena-rank";
        rk.Pad(0); rk.Gap(Spec.Px(2)); rk.Prefer(Spec.ArenaCardW(), Spec.ArenaRankH());
        rk.With(Text("排名:", "arena-rank-k", 0));
        rk.With(Text(Rules.N(rank), "arena-rank-v", 0));
        card.With(rk);

        /* 挑战编号 = 卡序 + 1（服务端 rival 1..16），点哪张打哪张。 */
        int rival = i + 1;
        card.With(BtnSized("挑战", "arena-challenge", 65, 17, () => {
            net.ArenaFight(rival);
        }));
        return card;
    }

    /// 左下日志面板：5 行规则说明贴顶，橙字提示贴底。
    Panel ArenaLogPane(int inset) {
        Panel pane = Panel.Column(); pane.Class = "arena-log";
        pane.Gap(0); pane.Grow(); pane.Padding(0, 0, 0, inset);
        Panel top = Panel.Column(); top.Prefer(0, Spec.ArenaLogTop()); pane.With(top);
        pane.With(ArenaLogLine("「系统」", "arena-tag-sys", "欢迎来到PK竞技场！", "arena-log-text"));
        pane.With(ArenaLogLine("「提示」", "arena-tag-tip", "第1名：每小时1000战功（最高战功）", "arena-log-text"));
        pane.With(ArenaLogLine("「提示」", "arena-tag-tip", "第2名：800战功 / 第3名：600战功 / 第4名：500战功", "arena-log-text"));
        pane.With(ArenaLogLine("「提示」", "arena-tag-tip", "第5-8名：400战功 / 第8-50名：300战功 / 第50-100名：200战功", "arena-log-text"));
        pane.With(ArenaLogLine("「提示」", "arena-tag-tip", "战功计算会精确到分钟，低于一分钟无法领取。", "arena-log-text"));
        Panel fill = Panel.Column(); fill.Grow(); pane.With(fill);
        /* 提示行贴底：AnchorBottom（dock=2）从底边往上码，先加底缝再加提示行。 */
        Panel botPad = Panel.Column(); botPad.Prefer(0, Spec.ArenaPadBot());
        botPad.AnchorBottom(); pane.Add(botPad);
        Panel hint = Panel.Row(); hint.Class = "arena-hint";
        hint.Pad(0); hint.Prefer(0, Spec.ArenaLogRowH());
        hint.AnchorBottom(); pane.Add(hint);
        hint.With(Text("击败对手会获得100战功，失败获得20战功，排名前100的玩家每小时会额外获得战功。",
            "arena-hint-text", 0));
        return pane;
    }

    Panel ArenaLogLine(string tag, string tagCls, string body, string bodyCls) {
        Panel r = Panel.Row(); r.Pad(0); r.Gap(Spec.Px(2));
        r.Prefer(0, Spec.ArenaLogRowH());
        r.With(Text(tag, tagCls, 0));
        r.With(Text(body, bodyCls, 0));
        return r;
    }

    /// 右下统计面板：4 行数值贴顶，两个钮贴底（左边一条竖线与日志面板分开）。
    Panel ArenaStatsPane() {
        ArenaState a = net.TypedArena();
        int tries = a != null ? a.Tries : 0;
        int pts = a != null ? a.Pts : 0;
        int myRank = 0;
        for (int i = 0; i < Spec.ArenaCards(); i = i + 1) {
            ArenaRival r = ArenaRowAt(i);
            if (r != null && r.Me) { myRank = r.Rank; }
        }
        string rankText = "—";
        if (myRank > 0) { rankText = Rules.N(myRank); }
        else if (a == null || a.Rows.Count == 0) { rankText = "2043"; }   // 离线：照原版截图

        Panel pane = Panel.Column(); pane.Class = "arena-stats";
        pane.Gap(0); pane.Prefer(Spec.ArenaStatsW(), 0);
        pane.Padding(0, 0, 0, Spec.Px(9));      // 竖线到文字的左内边距
        Panel top = Panel.Column(); top.Prefer(0, Spec.ArenaStatsTop()); pane.With(top);
        pane.With(ArenaStatRow("我的排名:", rankText, "arena-stat-k", "arena-stat-v"));
        pane.With(ArenaStatRow("挑战次数:", Rules.N(tries), "arena-stat-k", "arena-stat-v"));
        pane.With(ArenaStatRow("挑战时间:", ArenaClock(), "arena-stat-k2", "arena-stat-v2"));
        pane.With(ArenaStatRow("累计战功:", Rules.N(pts), "arena-stat-k", "arena-stat-v"));
        Panel fill = Panel.Column(); fill.Grow(); pane.With(fill);

        Panel btnPad = Panel.Column(); btnPad.Prefer(0, Spec.ArenaPadBot());
        pane.With(btnPad);
        Panel box = Panel.Row(); box.Class = "arena-btnbox";
        box.Pad(0); box.Gap(Spec.Px(18)); box.Prefer(0, Spec.ArenaBtnBoxH());
        pane.With(box);
        /* 领取战功：原版按小时结算，服务端还没有这个 op（TASKS.md 已记），
           先照实回一句，不做假领取。 */
        box.With(BtnSized("领取战功", "arena-plain", 87, 28, () => {
            net.AddChat("[系统]", "战功按小时由服务端结算，本版暂未开放手动领取。");
        }));
        box.With(BtnSized("刷新数据", "arena-plain", 87, 28, () => {
            net.ReloadArena();
        }));
        return pane;
    }

    Panel ArenaStatRow(string k, string v, string kCls, string vCls) {
        Panel r = Panel.Row(); r.Pad(0); r.Gap(Spec.Px(4));
        r.Prefer(0, Spec.ArenaStatsRowH());
        r.With(Text(k, kCls, 0));
        r.With(Text(v, vCls, 0));
        return r;
    }
}
