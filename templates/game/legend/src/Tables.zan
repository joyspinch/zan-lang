using System;
using System.Csv;
using System.IO;
namespace Legend;

// Static content is loaded once, fully validated, and only then published.
// Save files contain instance state; never copy definitions into player saves.
class DataRow {
    string location;
    Dictionary<string, string> fields = new Dictionary<string, string>();
    string Text(string key) {
        if (!fields.ContainsKey(key)) { throw new Exception(location + ": missing column " + key); }
        return fields[key];
    }
    int Int(string key) { return DataTable.Integer(Text(key), location + ": " + key); }
    long Long(string key) { return (long)Int(key); }
}
class DataTable {
    string name;
    List<DataRow> rows = new List<DataRow>();
    Dictionary<string, DataRow> index = new Dictionary<string, DataRow>();
    static int Integer(string value, string context) {
        if (value.Length == 0) { throw new Exception(context + ": empty integer"); }
        int start = value.Substring(0, 1) == "-" ? 1 : 0;
        if (start == value.Length) { throw new Exception(context + ": invalid integer"); }
        long n = 0;
        for (int i = start; i < value.Length; i = i + 1) {
            int digit = value[i] & 255;
            if (digit < 48 || digit > 57) { throw new Exception(context + ": invalid integer " + value); }
            n = n * 10 + digit - 48;
            if (n > 2147483647) { throw new Exception(context + ": integer overflow"); }
        }
        return start == 1 ? 0 - (int)n : (int)n;
    }
    DataRow Get(string id) {
        if (!index.ContainsKey(id)) { throw new Exception(name + ": unknown id " + id); }
        return index[id];
    }
    DataRow At(int id) { return Get(Convert.ToString(id)); }
    string[] Names() { string[] result = new string[rows.Count]; for (int i = 0; i < rows.Count; i = i + 1) { result[i] = rows[i].Text("name"); } return result; }
    // schema entries are "column" (required nonempty text) or "column:min:max".
    static DataTable Load(string path, string schema) {
        if (!File.Exists(path)) { throw new Exception("Configuration missing: " + path); }
        string text = File.ReadAllText(path);
        if (text.Length > 0 && text.Substring(0, 1) == "﻿") { text = text.Substring(1, text.Length - 1); }
        // stdlib Csv is deliberately permissive; reject malformed quoting here first.
        bool quoted = false; bool closed = false; bool atStart = true;
        for (int i = 0; i < text.Length; i = i + 1) {
            string ch = text.Substring(i, 1);
            if (quoted) {
                if (ch == "\"") {
                    if (i + 1 < text.Length && text.Substring(i + 1, 1) == "\"") { i = i + 1; }
                    else { quoted = false; closed = true; }
                }
            } else if (ch == "," || ch == "\n" || ch == "\r") { atStart = true; closed = false; }
            else if (ch == "\"" && atStart && !closed) { quoted = true; atStart = false; }
            else {
                if (closed || ch == "\"") { throw new Exception(path + ": malformed CSV quotes"); }
                atStart = false;
            }
        }
        if (quoted) { throw new Exception(path + ": unclosed CSV quote"); }
        CsvTable parsed = Csv.Parse(text);
        if (parsed.RowCount() < 1) { throw new Exception(path + ": empty table"); }
        List<string> header = parsed.Header(); List<string> spec = schema.Split(",");
        foreach (string column in header) {
            int count = 0; foreach (string other in header) { if (other == column) { count = count + 1; } }
            if (column.Length == 0 || count != 1) { throw new Exception(path + ": duplicate or empty header " + column); }
        }
        if (header.Count != spec.Count) { throw new Exception(path + ": schema column count mismatch"); }
        foreach (string entry in spec) {
            string key = entry.Split(":")[0]; bool found = false;
            foreach (string column in header) { if (key == column) { found = true; } }
            if (!found) { throw new Exception(path + ": missing column " + key); }
        }
        DataTable table = new DataTable(); table.name = path;
        List<List<string>> dataRows = parsed.Rows();
        for (int r = 0; r < dataRows.Count; r = r + 1) {
            List<string> values = dataRows[r]; string context = path + ": row " + Convert.ToString(r + 2);
            if (values.Count != header.Count) { throw new Exception(context + ": column count mismatch"); }
            DataRow row = new DataRow(); row.location = context;
            for (int c = 0; c < header.Count; c = c + 1) { row.fields.Add(header[c], values[c]); }
            foreach (string entry in spec) {
                List<string> bits = entry.Split(":"); string value = row.Text(bits[0]);
                if (bits.Count == 3) {
                    int n = Integer(value, context + ": " + bits[0]);
                    if (n < Integer(bits[1], context) || n > Integer(bits[2], context)) { throw new Exception(context + ": out of range " + bits[0]); }
                } else if (value.Length == 0) { throw new Exception(context + ": empty " + bits[0]); }
            }
            string id = row.Text("id");
            if (spec[0].StartsWith("id:" ) && id != Convert.ToString(Integer(id, context))) { throw new Exception(context + ": ID must be canonical decimal"); }
            if (table.index.ContainsKey(id)) { throw new Exception(context + ": duplicate id " + id); }
            table.index.Add(id, row); table.rows.Add(row);
        }
        return table;
    }
}
class GameTables {
    static GameTables current;
    DataTable slots; DataTable qualities; DataTable items; DataTable maps; DataTable monsters; DataTable bosses;
    DataTable jobs; DataTable skills; DataTable levels; DataTable drops; DataTable forge; DataTable shop; DataTable balance;
    DataTable elements; DataTable recycle; DataTable recyclePrices;
    DataTable innerPower; DataTable gems; DataTable sets; DataTable attributes; DataTable quests; DataTable rebirth; DataTable growth; DataTable encounters;
    int Rule(string id) { return balance.Get(id).Int("value"); }
    /* 秘境可挑战上限：原版是「人物等级+100」的动态值（说明.txt L35），
       旧表固定 100 且 schema 钉死 1..100。progress_cap_mode 决定用哪种。
       服务端 Rules.ProgressCap 用同一份判断。 */
    static int ProgressCap(DataRow encounter, int level) {
        if (encounter.Text("progress_cap_mode") == "level_plus") {
            long cap = (long)level + encounter.Long("max_progress");
            long hard = Value("progress_cap_hard");
            return (int)(cap > hard ? hard : cap);
        }
        return encounter.Int("max_progress");
    }
    int TianShuBonus(string key) {
        if (key == "hp") { return Rule("tianshu_hp_per_coefficient"); }
        if (key == "mp") { return Rule("tianshu_mp_per_coefficient"); }
        if (key == "attack_min") { return Rule("tianshu_attack_min_per_coefficient"); }
        if (key == "attack_max") { return Rule("tianshu_attack_max_per_coefficient"); }
        if (key == "magic_min") { return Rule("tianshu_magic_min_per_coefficient"); }
        if (key == "magic_max") { return Rule("tianshu_magic_max_per_coefficient"); }
        if (key == "tao_min") { return Rule("tianshu_tao_min_per_coefficient"); }
        if (key == "tao_max") { return Rule("tianshu_tao_max_per_coefficient"); }
        if (key == "defense_min") { return Rule("tianshu_defense_min_per_coefficient"); }
        if (key == "defense_max") { return Rule("tianshu_defense_max_per_coefficient"); }
        if (key == "magic_defense_min") { return Rule("tianshu_magic_defense_min_per_coefficient"); }
        if (key == "magic_defense_max") { return Rule("tianshu_magic_defense_max_per_coefficient"); }
        return 0;
    }
    static int Value(string id) { return current.Rule(id); }
    static void Initialize(string directory) { GameTables candidate = Read(directory); current = candidate; }
    static GameTables Read(string dir) {
        GameTables t = new GameTables();
        t.slots = DataTable.Load(dir + "/slots.csv", "id:0:11,name,group:0:11");
        t.qualities = DataTable.Load(dir + "/qualities.csv", "id:0:4,name,weight:1:100000,coefficient_min:1:10,coefficient_max:1:10,stat_pct:0:10000");
        t.items = DataTable.Load(dir + "/items.csv", "id:1:1000000,name,slot:-1:11,min_level:1:1500,picture,category,hp:0:100000000,mp:0:100000000,attack_min:0:100000000,attack_max:0:100000000,magic_min:0:100000000,magic_max:0:100000000,tao_min:0:100000000,tao_max:0:100000000,defense_min:0:100000000,defense_max:0:100000000,magic_defense_min:0:100000000,magic_defense_max:0:100000000,required_job:-1:2,required_rebirth:0:10,weight:0:1000000,sell_price:0:100000000,stack_limit:1:100000000,description");
        t.monsters = DataTable.Load(dir + "/monsters.csv", "id:1:1000000,name,min_level:1:1500,rebirth:0:10,hp:1:100000000,picture,mp:0:100000000,attack_min:0:100000000,attack_max:0:100000000,magic_min:0:100000000,magic_max:0:100000000,tao_min:0:100000000,tao_max:0:100000000,defense_min:0:100000000,defense_max:0:100000000,magic_defense_min:0:100000000,magic_defense_max:0:100000000,attack_school");
        t.bosses = DataTable.Load(dir + "/bosses.csv", "id:1:1000000,name,min_level:1:1500,rebirth:0:10,hp:1:100000000,picture,gold:0:1000000,xp:0:1000000,xp_floor:0:10000,iron:0:1000000,yuan:0:1000000,runes:0:1000000,quality:0:4,drop_pool:1:1000000,mp:0:100000000,attack_min:0:100000000,attack_max:0:100000000,magic_min:0:100000000,magic_max:0:100000000,tao_min:0:100000000,tao_max:0:100000000,defense_min:0:100000000,defense_max:0:100000000,magic_defense_min:0:100000000,magic_defense_max:0:100000000,attack_school");
        t.maps = DataTable.Load(dir + "/maps.csv", "id:1:1000000,name,start_floor:1:10000,min_level:1:1500,rebirth:0:10,monster_id:1:1000000,gold:0:1000000,xp:0:1000000,drop_pool:1:1000000");
        t.jobs = DataTable.Load(dir + "/jobs.csv", "id:0:2,name,hp_base:1:100000,hp_level:0:1000,mp_base:1:100000,mp_level:0:1000,damage_taken_pct:1:100,pet_attack_pct:0:100,skill_id:1:1000000,weapon_id:1:1000000,armor_id:1:1000000,helmet_id:1:1000000,attack_school,attack_min_base:0:100000,attack_min_level:0:100000,attack_max_base:0:100000,attack_max_level:0:100000,magic_min_base:0:100000,magic_min_level:0:100000,magic_max_base:0:100000,magic_max_level:0:100000,tao_min_base:0:100000,tao_min_level:0:100000,tao_max_base:0:100000,tao_max_level:0:100000,defense_min_base:0:100000,defense_min_level:0:100000,defense_max_base:0:100000,defense_max_level:0:100000,magic_defense_min_base:0:100000,magic_defense_min_level:0:100000,magic_defense_max_base:0:100000,magic_defense_max_level:0:100000");
        t.skills = DataTable.Load(dir + "/skills.csv", "id:1:1000000,name,job:0:2,slot:0:7,kind,target,cooldown:0:3600,mana:0:100000,damage_pct:0:1000,damage_per_level:0:100,heal_pct:0:100,heal_per_level:0:10,passive_damage_pct:0:100,passive_defense_pct:0:100,max_level:1:100,train_gold:0:1000000,train_iron:0:1000000,school");
        t.levels = DataTable.Load(dir + "/levels.csv", "id:1:1500,xp:1:100000000");
        t.drops = DataTable.Load(dir + "/drops.csv", "id:1:1000000,pool:1:1000000,item_id:1:1000000,weight:1:100000");
        t.forge = DataTable.Load(dir + "/forge.csv", "id:0:100,name,operation,gold:0:1000000,iron:0:1000000,yuan:0:1000000,runes:0:1000000,scale,limit:1:20,success_pct:1:100,failure");
        t.shop = DataTable.Load(dir + "/shop.csv", "id:0:1000000,name,reward,quantity:1:1000000,gold:0:1000000,iron:0:1000000,yuan:0:1000000,capacity_gold:0:10000");
        t.balance = DataTable.Load(dir + "/balance.csv", "id,value:0:1000000000");
        t.quests = DataTable.Load(dir + "/quests.csv", "id:0:1000,name,metric,target:1:1000000,gold:0:1000000,yuan:0:1000000,iron:0:1000000");
        t.rebirth = DataTable.Load(dir + "/rebirth.csv", "id:1:10,min_level:1:1500,min_floor:1:10000,gold:0:1000000000");
        t.growth = DataTable.Load(dir + "/growth.csv", "id:1:3,name,max_level:1:100,gold:0:1000000,gold_per_level:0:100000,iron:0:1000000,merit:0:1000000,merit_per_level:0:100000,reward_merit:0:1000000,reward_iron:0:1000000");
        t.encounters = DataTable.Load(dir + "/encounters.csv", "id:2:4,name,progress,min_level:1:1500,min_rebirth:0:10,max_progress:1:100000,progress_cap_mode,hp_base:1:10000000,hp_linear:0:100000,hp_square:0:10000,attack_base:0:100000,attack_linear:0:10000,defense_base:0:100000,defense_linear:0:10000,gold:0:1000000,gold_linear:0:100000,xp:0:1000000,xp_floor:0:10000,iron:0:1000000,yuan:0:1000000,runes:0:1000000,quality:0:4,drop_pool:1:1000000,attack_school,attack_min_pct:0:100,defense_min_pct:0:100,magic_defense_base:0:1000000,magic_defense_linear:0:1000000,magic_defense_min_pct:0:100");
        t.attributes = DataTable.Load(dir + "/attributes.csv", "id,name,score_weight:0:10000,upgrade_pct:0:100,skill_flat:0:1000,training_flat:0:1000,collection_flat:0:1000,rebirth_flat:0:100000,rebirth_pct:0:100,title_pct:0:100");
        t.innerPower = DataTable.Load(dir + "/inner_power.csv", "id:0:7,name,stat,value_per_level:1:1000,max_level:1:100,tp:1:100000,tp_per_level:0:1000,iron:0:100000");
        t.gems = DataTable.Load(dir + "/gems.csv", "id:0:5,name,stat,value_per_level:1:10000,max_level:1:100,gold:0:1000000,iron:0:100000,yuan:0:100000,synthesis_gold:1:1000000,synthesis_iron:1:100000,synthesis_yuan:1:100000,synthesis_max_level:1:100");
        t.elements = DataTable.Load(dir + "/elements.csv", "id:0:4,name,picture,stat,value_per_level:1:10000,max_level:1:100,xp_base:1:100000,xp_step:0:10000,upgrade_iron:0:100000,upgrade_iron_step:0:100000,upgrade_yuan:0:100000,upgrade_yuan_step:0:100000");
        t.sets = DataTable.Load(dir + "/sets.csv", "id:0:100,name,required:1:12,items,stat,value:1:100000");
        t.recycle = DataTable.Load(dir + "/recycle.csv", "id:0:6,name,numerator:1:1000000,denominator:1:1000000,cap:1:1000000000");
        t.recyclePrices = DataTable.Load(dir + "/recycle_prices.csv", "id:1:1000000,gold:0:100000000");
        t.Validate(); return t;
    }
    void Require(bool condition, string message) { if (!condition) { throw new Exception("Configuration: " + message); } }
    void Validate() {
        Require(elements.rows.Count == 5 && recycle.rows.Count == 7, "five elements and seven recycle currencies required");
        for (int i = 0; i < 5; i = i + 1) { DataRow element = elements.At(i); attributes.Get(element.Text("stat")); Require(element.Int("upgrade_iron") >= 0 && element.Int("upgrade_iron_step") >= 0 && element.Int("upgrade_yuan") >= 0 && element.Int("upgrade_yuan_step") >= 0, element.location + ": upgrade costs must be non-negative"); }
        foreach (DataRow row in sets.rows) { attributes.Get(row.Text("stat")); List<string> ids = row.Text("items").Split("|"); Require(ids.Count >= row.Int("required"), row.location + ": set has fewer items than required"); foreach (string token in ids) { int itemId = DataTable.Integer(token, row.location + ": items"); Require(items.At(itemId).Int("slot") >= 0, row.location + ": set item must be equipment"); } }
        for (int i = 0; i < 7; i = i + 1) { recycle.At(i); }
        foreach (DataRow item in items.rows) { if (item.Int("slot") >= 0) { recyclePrices.At(item.Int("id")); } }
        foreach (DataRow price in recyclePrices.rows) { Require(items.At(price.Int("id")).Int("slot") >= 0, "recycle price requires equipment"); }
        Require(Rule("element_pool_cap") > 0 && Rule("element_xp_per_second") > 0, "element pool/rate must be positive");
        Require(Rule("secret_wave_count") > 0 && Rule("secret_mob_hp_pct") > 0 && Rule("secret_mob_hp_pct") <= 100, "secret wave configuration invalid");
        Require(innerPower.rows.Count == 8, "inner power requires eight slots");
        Require(gems.rows.Count == 6, "gem system requires six slots");
        for (int i = 0; i < 6; i = i + 1) { DataRow gem = gems.At(i); attributes.Get(gem.Text("stat")); Require(gem.Int("synthesis_max_level") < gem.Int("max_level"), gem.location + ": synthesis must stop before ordinary upgrade cap"); }
        for (int i = 0; i < 8; i = i + 1) { attributes.Get(innerPower.At(i).Text("stat")); }
        Require(Rule("inner_tp_cap") > 0, "inner TP cap must be positive"); Rule("inner_tp_per_kill");
        List<string> attributeIds = "hp,mp,attack_min,attack_max,magic_min,magic_max,tao_min,tao_max,defense_min,defense_max,magic_defense_min,magic_defense_max".Split(",");
        Require(attributes.rows.Count == attributeIds.Count, "attribute schema mismatch");
        foreach (string id in attributeIds) { attributes.Get(id); }
        foreach (DataRow j in jobs.rows) { CheckSchool(j.Text("attack_school"), j.location); }
        foreach (DataRow ability in skills.rows) {
            CheckSkillSchool(ability.Text("school"), ability.Text("kind"), ability.location);
            Require(ability.Int("job") >= 0 && ability.Int("job") < 3, ability.location + ": unknown skill job");
            Require(ability.Int("slot") >= 0 && ability.Int("slot") < 8, ability.location + ": skill slot must be 0..7");
            Require(ability.Text("kind") == "active" || ability.Text("kind") == "passive", ability.location + ": unsupported skill kind");
            Require(ability.Text("target") == "enemy" || ability.Text("target") == "self", ability.location + ": unsupported skill target");
            Require(ability.Text("kind") == "passive" || ability.Int("cooldown") > 0, ability.location + ": active skill cooldown must be positive");
        }
        for (int jobIndex = 0; jobIndex < 3; jobIndex = jobIndex + 1) {
            for (int slotIndex = 0; slotIndex < 8; slotIndex = slotIndex + 1) {
                int matches = 0; foreach (DataRow ability in skills.rows) { if (ability.Int("job") == jobIndex && ability.Int("slot") == slotIndex) { matches = matches + 1; } }
                Require(matches == 1, "skill loadout must define exactly one skill per job and slot");
            }
        }
        foreach (DataRow m in monsters.rows) { CheckSchool(m.Text("attack_school"), m.location); CheckRanges(m); }
        foreach (DataRow m in bosses.rows) { CheckSchool(m.Text("attack_school"), m.location); CheckRanges(m); }
        Require(slots.rows.Count == 12 && qualities.rows.Count == 5 && jobs.rows.Count == 3, "save schema requires 12 slots, 5 qualities, 3 jobs");
        for (int i = 0; i < 12; i = i + 1) { slots.At(i); }
        for (int i = 0; i < 5; i = i + 1) { DataRow q = qualities.At(i); Require(q.Int("coefficient_min") <= q.Int("coefficient_max"), q.location + ": coefficient range"); }
        for (int i = 1; i <= levels.rows.Count; i = i + 1) { levels.At(i); }
        foreach (DataRow r in items.rows) { if (r.Int("slot") >= 0) { slots.At(r.Int("slot")); } }
        for (int i = 0; i < 3; i = i + 1) {
            DataRow j = jobs.At(i); skills.At(j.Int("skill_id"));
            Require(items.At(j.Int("weapon_id")).Int("slot") == 0, j.location + ": starter weapon slot");
            Require(items.At(j.Int("armor_id")).Int("slot") == 1, j.location + ": starter armor slot");
            Require(items.At(j.Int("helmet_id")).Int("slot") == 2, j.location + ": starter helmet slot");
        }
        for (int i = 0; i < quests.rows.Count; i = i + 1) { DataRow q = quests.At(i); string m = q.Text("metric"); Require(m == "kills" || m == "level" || m == "best" || m == "recycled" || m == "skill" || m == "bossWins" || m == "rebirth", q.location + ": unsupported quest metric"); }
        for (int i = 1; i <= rebirth.rows.Count; i = i + 1) { rebirth.At(i); }
        for (int i = 1; i <= 3; i = i + 1) { growth.At(i); }
        for (int i = 2; i <= 4; i = i + 1) { DataRow e = encounters.At(i); CheckSchool(e.Text("attack_school"), e.location); string p = e.Text("progress"); Require(p == "tower" || p == "rebirth" || p == "secrets", e.location + ": unsupported progression"); Require(PoolWeight(e.Int("drop_pool")) > 0, e.location + ": missing pool"); }
        foreach (DataRow boss in bosses.rows) { Require(PoolWeight(boss.Int("drop_pool")) > 0, boss.location + ": missing pool"); }
        foreach (DataRow slot in slots.rows) { Require(slots.At(slot.Int("group")).Int("group") == slot.Int("group"), slot.location + ": group must reference a canonical slot"); }
        int last = 0;
        foreach (DataRow m in maps.rows) {
            Require(m.Int("start_floor") > last, m.location + ": map floors must increase"); last = m.Int("start_floor");
            monsters.At(m.Int("monster_id")); int total = 0;
            foreach (DataRow d in drops.rows) { if (d.Int("pool") == m.Int("drop_pool")) { total = total + d.Int("weight"); } }
            Require(total > 0 && total <= 100000000, m.location + ": missing/oversized drop pool");
        }
        Require(maps.rows[0].Int("start_floor") == 1, "first map must start at floor 1");
        foreach (DataRow d in drops.rows) { Require(items.At(d.Int("item_id")).Int("slot") >= 0, d.location + ": equipment pool contains non-equipment"); }
        foreach (DataRow r in forge.rows) {
            string op = r.Text("operation"); string scale = r.Text("scale");
            Require(op == "upgrade" || op == "reroll" || op == "improve" || op == "tier", r.location + ": unsupported forge operation");
            Require(scale == "upgrade" || scale == "coefficient" || scale == "fixed", r.location + ": unsupported cost scale");
            Require(op != "tier" || r.Int("limit") < qualities.rows.Count, r.location + ": tier limit");
            Require((op != "reroll" && op != "improve") || r.Int("limit") <= 10, r.location + ": coefficient limit");
            Require(r.Int("success_pct") >= 1 && r.Int("success_pct") <= 100, r.location + ": success percentage");
            Require(r.Text("failure") == "keep" || r.Text("failure") == "downgrade", r.location + ": unsupported failure result");
            Require(op != "reroll" || r.Text("failure") == "downgrade", r.location + ": reroll must declare downgrade failure");
        }
        foreach (DataRow r in shop.rows) { string reward = r.Text("reward"); bool runeReward = reward.StartsWith("rune") && reward != "runes"; if (runeReward) { int runeLevel = DataTable.Integer(reward.Substring(4, reward.Length - 4), r.location + ": rune reward"); Require(runeLevel >= 1 && runeLevel <= 14, r.location + ": rune reward must be 1#..14#"); } bool ballReward = reward.StartsWith("ball"); if (ballReward) { int star = DataTable.Integer(reward.Substring(4, reward.Length - 4), r.location + ": dragon ball reward"); Require(star >= 1 && star <= 9, r.location + ": dragon ball reward must be 1..9 star"); } Require(reward == "potions" || reward == "iron" || reward == "capacity" || reward == "runes" || reward == "gold" || reward == "ore" || ballReward || runeReward, r.location + ": unsupported reward"); }
        foreach (string baseKey in "legend_sword_base,legend_robe_male_base,legend_robe_female_base".Split(",")) { Require(items.At(Rule(baseKey)).Int("slot") >= 0, "legend base must be equipment: " + baseKey); }
        int legendFirst = Rule("legend_first_form"); int legendForms = Rule("legend_form_count");
        Require(legendForms >= 2 && legendForms <= 9, "legend form count bounds");
        for (int i = 0; i < legendForms * 3; i = i + 1) { Require(items.At(legendFirst + i).Int("slot") == (i < legendForms ? 0 : 1), "legend form chain slots"); }
        // Limits are validation constraints for safe arithmetic/save layouts, not balancing defaults.
        // 键清单与 `server-legend/src/Framework/Rules.zan` 的 `RequiredKeys()`
        // 逐字一致：两侧用同一份 balance.csv，缺一个就是配置不完整。
        List<string> required = ("inner_tp_per_kill,inner_tp_cap,initial_gold,initial_gems,initial_iron,initial_potions,"
            + "initial_capacity,max_capacity,storage_capacity,max_floor,max_rebirth,offline_seconds,"
            + "boss_tries,arena_tries,escort_tries,wave_count,guardian_hp_pct,guardian_attack_pct,"
            + "drop_chance,iron_chance,potion_chance,critical_chance,critical_damage_pct,mp_regen,"
            + "potion_trigger_pct,potion_heal_pct,recovery_seconds,round_limit,equipment_coefficient_max,"
            + "treasure_pity,initial_treasure_maps,daily_treasure_maps,treasure_gold,treasure_gems,"
            + "treasure_iron,treasure_runes,treasure_potions,daily_gold,daily_yuan,daily_potions,"
            + "bounty_kills,bounty_gold,bounty_runes,first_clear_yuan,between_wave_heal_pct,escort_gold,"
            + "escort_seconds,escort_reward,escort_level_gold,escort_guild_gold,escort_merit,"
            + "arena_power_base,arena_power_win,arena_power_rival,arena_win_merit,arena_lose_merit,"
            + "arena_win_gold,arena_win_reputation,arena_lose_reputation,element_pool_cap,"
            + "element_xp_per_second,secret_wave_count,secret_mob_hp_pct,tianshu_hp_per_coefficient,"
            + "tianshu_mp_per_coefficient,tianshu_attack_min_per_coefficient,"
            + "tianshu_attack_max_per_coefficient,tianshu_magic_min_per_coefficient,"
            + "tianshu_magic_max_per_coefficient,tianshu_tao_min_per_coefficient,"
            + "tianshu_tao_max_per_coefficient,tianshu_defense_min_per_coefficient,"
            + "tianshu_defense_max_per_coefficient,tianshu_magic_defense_min_per_coefficient,"
            + "tianshu_magic_defense_max_per_coefficient,altar_personal_cap,altar_world_cap,"
            + "altar_gold_cost,altar_gold_gain,altar_yuan_cost,altar_yuan_gain,altar_yuan_large_cost,"
            + "altar_yuan_large_gain,altar_iron_cost,altar_iron_gain,altar_personal_reward_gold,"
            + "altar_personal_reward_yuan,altar_personal_reward_reputation,altar_world_reward_gold,"
            + "altar_world_reward_yuan,altar_world_reward_merit,legend_sword_base,legend_robe_male_base,"
            + "legend_robe_female_base,legend_first_form,legend_form_count,rune_word_ore,rune_word_rune,"
            + "form_growth_balls,form_growth_rune,tower_tries,progress_cap_hard,incoming_random_min,"
            + "incoming_random_range,tower_merit,tower_gold_base,tower_gold_per_floor,tower_xp_base,"
            + "tower_xp_per_floor,tower_foe_atk_base,tower_foe_atk_per_floor,tower_foe_hp_base,"
            + "tower_foe_hp_per_floor,guild_create_gold,guild_create_item,guild_max_members,"
            + "siege_attack_gold,siege_base_chance,siege_power_div,siege_hold_seconds,market_fee_pct,"
            + "market_min_price,redpack_min_yuan,redpack_max_yuan,redpack_share_pct,"
            + "mentor_apprentice_max_level,mentor_take_level,mentor_master_rebirth,mentor_take_gold,"
            + "mentor_take_xp,mentor_max_apprentices,mentor_max_masters,star_activate_gold,"
            + "star_points_per_rebirth,star_points_max,lord_donate_yuan,title_unlock_rep_pct,"
            + "floor_scale_per_100,floor_scale_cap,drop_value_pivot,forge_gold_per_star,"
            + "forge_iron_per_star,forge_max_star,arena_def_offset,arena_power_scale,arena_rival_count,arena_win_scale,"
            + "altar_buff_seconds,altar_buff_mult_pct,auto_batch_sec,auto_max_rounds,boss_max_rounds,boss_sweep_max,city_count,"
            + "city_income_base,city_income_step,city_page_size,codex_page_size,title_page_size,death_hp_pct,"
            + "forge_star_attack,forge_star_defense,guild_name_max,guild_name_min,mentor_take_reputation,"
            + "sell_price_pct,shop_buy_max,siege_level_power,tower_win_atk_scale,tower_win_def_base,"
            + "tower_win_floor_div,tower_rival_cards,treasure_cost,world_boss_big_item_pct,world_boss_damage_pct,"
            + "world_boss_defense,world_boss_exp,world_boss_gold_max,world_boss_gold_min,world_boss_hp,"
            + "world_boss_kill_gold,world_boss_level,world_boss_respawn_seconds,world_boss_top_item_pct").Split(",");
        // 小值上限是防手滑的单位错误；货币量级的键（行会创建费）单列断言。
        foreach (string key in required) { if (key != "guild_create_gold") { Require(Rule(key) <= 1000000, "balance value too large: " + key); } }
        // 货币量级的费用不适用上面的小数值上限（行会创建费 = 客户端页脚写明的 500W）。
        Require(Rule("guild_create_gold") > 0 && Rule("guild_create_gold") <= 1000000000, "guild creation cost out of range");
        Require(Rule("wave_count") > 0 && Rule("treasure_pity") > 0, "zero divisor/range");
        Require(rebirth.rows.Count >= Rule("max_rebirth"), "missing rebirth levels");
        Require(Rule("max_floor") >= last && Rule("max_floor") <= 10000 && Rule("max_rebirth") <= 10, "progression bounds");
        Require(Rule("initial_capacity") > 0 && Rule("initial_capacity") <= Rule("max_capacity") && Rule("max_capacity") <= 120 && Rule("storage_capacity") <= 120, "inventory bounds");
        Require(Rule("offline_seconds") <= 86400 && Rule("equipment_coefficient_max") <= 10 && Rule("equipment_coefficient_max") > 0, "simulation bounds");
    }
    void CheckSchool(string school, string context) { Require(school == "attack" || school == "magic" || school == "tao", context + ": unknown attack school"); }
    void CheckSkillSchool(string school, string kind, string context) {
        if (kind == "passive") { Require(school == "attack" || school == "magic" || school == "tao" || school == "defense" || school == "magic_defense", context + ": unknown skill school"); }
        else { CheckSchool(school, context); }
    }
    void CheckRanges(DataRow row) {
        foreach (string group in "attack,magic,tao,defense,magic_defense".Split(",")) { Require(row.Int(group + "_min") <= row.Int(group + "_max"), row.location + ": inverted " + group + " range"); }
    }
    int PoolWeight(int pool) { long total = 0; foreach (DataRow d in drops.rows) { if (d.Int("pool") == pool) { total = total + d.Int("weight"); } } Require(total <= 100000000, "oversized drop pool"); return (int)total; }
    DataRow Map(int floor) { DataRow result = maps.rows[0]; foreach (DataRow row in maps.rows) { if (row.Int("start_floor") <= floor) { result = row; } } return result; }
}

