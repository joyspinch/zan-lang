using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 7「城池争霸」——照原版还原（城池争夺.png），规格见 Spec / REFERENCE_AUDIT §5.4。
///
///   · 2 列 × 4 行城池卡（§5.4 旧表写 4×3 是早期粗记，照图改正）：
///     左头像立绘 + 「攻占城池」钮；右情景块（assets/city/N.gif 打底，
///     城池/条件/产出 三行压图）+ 城主行（城主 | 名字 | 时间 三格细框）
///   · 底部：左两行灰说明；右 [说明] + 标准库 Pagination（原版 1/5）
///   · 卡阵直接铺主区（与 PK竞技场同一条竖向节奏：上留白 = MapMargin），
///     不走 mk-frame 浮窗骨架
///
/// M2.DB 的 GameCity（城池）模板数据层没有载入（Tables 只认 CSV），照
/// 图鉴页惯例把原版截图上的 8 城逐行抄进 CityData()。攻占/说明钮玩法
/// 未接，按模板惯例给明确反馈，不假装已实现。
partial class LegendApp {

    class CityInfo {
        string name;            // 「钱庄(1)」
        int cost;               // 条件/产出的金币数
        string owner;           // 城主名
        string date;            // 攻占时间
        int cityId;             // 服务端城池号（在线 >0：攻占 op 用）
    }

    /// 第 1 页 8 城（照 `城池争夺.png` 逐行抄录；原版共 5 页，2..5 页无对照图）。
    static List<CityInfo> CityData() {
        string[] owners = new string[] {
            "神月", "郭峻", "风车车", "上善若水君",
            "无敌绵羊", "龙卫——天尊", "龙卫——圣战", "龙卫——法神"
        };
        string[] dates = new string[] {
            "2026-08-03 22:00:25", "2026-08-01 23:43:41", "2026-08-03 22:22:47",
            "2026-08-04 22:10:55", "2026-08-01 22:02:12", "2026-08-05 16:46:39",
            "2026-08-04 14:09:15", "2026-08-04 14:10:52"
        };
        int[] costs = new int[] {
            500000, 1000000, 1500000, 2000000,
            2250000, 2500000, 2750000, 3000000
        };
        List<CityInfo> rows = new List<CityInfo>();
        for (int i = 0; i < 8; i = i + 1) {
            CityInfo r = new CityInfo();
            r.name = "钱庄(" + Rules.N(i + 1) + ")";
            r.cost = costs[i];
            r.owner = owners[i];
            r.date = dates[i];
            rows.Add(r);
        }
        return rows;
    }

    /// 头像：与竞技场同一套立绘（ui/00043..00048.jpg）按卡序轮换。
    static string CityFacePath(int i) {
        int n = 43 + i % 6;
        return "assets/ui/000" + Rules.N(n) + ".jpg";
    }

    /// 情景块底图：assets/city/00000..00007.gif 与原版卡序一一对应。
    static string CityScenePath(int i) {
        return "assets/city/" + Rules.N(i).PadLeft(5, "0") + ".gif";
    }

    /// 在线城池行：siege 应答 cities[] → CityInfo（owner/date/income/cost 全服务端）。
    static CityInfo CityLiveRowOf(JsonValue c) {
        CityInfo r = new CityInfo();
        r.cityId = c.Int("id", 0);
        r.name = "钱庄(" + Rules.N(r.cityId) + ")";
        r.cost = c.Int("cost", 0);
        r.owner = c.Str("owner", "");
        if (r.owner.Length == 0) { r.owner = "暂无"; }
        r.date = c.Str("date", "");
        if (r.date.Length == 0) { r.date = "暂无"; }
        return r;
    }

    /// 当前卡阵数据：在线 = siege 应答 cities[]，离线 = 原版对照抄录。
    List<CityInfo> CityRows() {
        SiegeState s = net.Self() != null ? net.TypedSiege() : null;
        if (s == null || s.Cities == null || s.Cities.Count == 0) { return CityData(); }
        List<CityInfo> v = new List<CityInfo>();
        for (int i = 0; i < s.Cities.Count; i = i + 1) {
            CityItem c = s.Cities[i];
            CityInfo ci = new CityInfo();
            ci.cityId = c.Id;
            ci.name = c.Name;
            ci.cost = c.Cost;
            ci.owner = c.Owner.Length > 0 ? c.Owner : "虚位以待";
            ci.date = c.Date.Length > 0 ? c.Date : "暂无";
            v.Add(ci);
        }
        return v;
    }

    void BuildCityPage() {
        if (net.Self() != null) { net.MaybeRefreshSiege(); }
        int pageW = app.ClientWidth() - Spec.LeftPad() - Spec.LeftW()
            - Spec.ChatW() - Spec.ChatPadR();
        /* 原版卡阵不是居中摆的：左留白 15 / 右 27（内容宽比卡阵宽出的
           部分全在右侧），照实给左缩进，不照竞技场的居中公式。 */
        int leftInset = Spec.CityPadL();

        Panel body = Panel.Column(); body.Class = "city-page";
        body.Pad(0); body.Gap(0); body.Grow(); content.With(body);

        Panel top = Panel.Column();
        top.Prefer(0, Spec.MapMargin() + Spec.CityTopAdj());
        body.With(top);

        Panel gridRow = Panel.Row(); gridRow.Pad(0); gridRow.Gap(0);
        gridRow.Prefer(0, Spec.CityWallH()); body.With(gridRow);
        gridRow.With(SpacerW(leftInset));
        Panel grid = Panel.Column(); grid.Class = "city-wall";
        grid.Pad(0); grid.Gap(Spec.CityRowGap());
        grid.Prefer(Spec.CityWallW(), Spec.CityWallH());
        gridRow.With(grid);
        List<CityInfo> rows = CityRows();
        for (int r = 0; r < Spec.CityRows(); r = r + 1) {
            Panel row = Panel.Row(); row.Class = "city-row";
            row.Pad(0); row.Gap(Spec.CityColGap());
            row.Prefer(0, Spec.CityInfoH()); grid.With(row);
            for (int c = 0; c < Spec.CityCols(); c = c + 1) {
                int i = r * Spec.CityCols() + c;
                if (i >= rows.Count) { break; }
                row.With(CityCard(i, rows[i]));
            }
        }

        Panel fillmid = Panel.Column(); fillmid.Grow(); body.With(fillmid);

        /* 底部：底缝先占底，页脚压在其上（锚定底部次序）。 */
        Panel footPad = Panel.Column(); footPad.Prefer(0, Spec.CityPadB());
        footPad.AnchorBottom(); body.Add(footPad);
        Panel foot = Panel.Row(); foot.Class = "city-foot";
        foot.Pad(0); foot.Gap(Spec.Px(3));
        foot.Prefer(0, Spec.CityFootH());
        foot.Padding(0, Spec.CityFootPadR(), 0, Spec.CityFootPadL());
        foot.AnchorBottom(); body.Add(foot);
        Panel desc = Panel.Column(); desc.Pad(0); desc.Gap(Spec.Px(2));
        desc.Prefer(Spec.CityDescW(), 0); foot.With(desc);
        Label d1 = Text("申请攻占城池需要收取相关费用，这些挑战费用将会有部分直接存入城池，当城主变更时会清空",
            "city-desc", 0);
        d1.Prefer(Spec.CityDescW(), Spec.Px(15)); desc.With(d1);
        Label d2 = Text("城池资源，并将资源以邮件形式发放给上任城主，每人最多只允许占领一个城池。",
            "city-desc", 0);
        d2.Prefer(Spec.CityDescW(), Spec.Px(15)); desc.With(d2);
        Panel gfill = Panel.Row(); gfill.Grow(); foot.With(gfill);
        foot.With(BtnDev("说明", "city-say", Spec.CitySayW(), Spec.CityBtnH(),
            () => { CitySay("申请攻占城池需要收取相关费用，每人最多只允许占领一个城池。"); }));
        SignalInt pgSig = new SignalInt(1);
        Pagination pg = new Pagination(Spec.CityPages(), pgSig);
        pg.Class = "simple";
        pg.PrevText("上一页"); pg.NextText("下一页");
        pg.Named("city-pager");
        foot.With(pg);
    }

    /// 一张城池卡：左头像列（立绘 + 攻占城池），右情景块 + 城主行。
    Panel CityCard(int i, CityInfo r) {
        Panel card = Panel.Row(); card.Class = "city-card";
        card.Pad(0); card.Gap(Spec.CityAvaInfoGap());
        card.Prefer(Spec.CityAvaW() + Spec.CityAvaInfoGap() + Spec.CityInfoW(),
            Spec.CityInfoH());

        Panel ava = Panel.Column(); ava.Class = "city-avacol";
        ava.Pad(0); ava.Gap(Spec.Px(3));
        ava.Prefer(Spec.CityAvaW(), Spec.CityInfoH());
        Image face = new Image(CityFacePath(i), r.owner, "cover");
        face.Class = "city-ava";
        face.Prefer(Spec.CityAvaW(), Spec.CityAvaH());
        ava.With(face);
        int pick = i;
        ava.With(BtnDev("攻占城池", "city-attack", Spec.CityBtnW(), Spec.CityBtnH(),
            () => { CityAttack(pick); }));
        card.With(ava);

        Panel info = Panel.Column(); info.Pad(0); info.Gap(Spec.Px(2));
        info.Prefer(Spec.CityInfoW(), Spec.CityInfoH());
        Panel scene = Panel.Column(); scene.Class = "city-scene";
        scene.Pad(0);
        scene.Prefer(0, Spec.CitySceneH());
        Image bg = new Image(CityScenePath(i), r.name, "fill");
        bg.Grow(); scene.With(bg);
        /* 三行字压在情景图上：city-l* 是 position:absolute，脱离停靠流
           （同经验条数值/地图瓦片名的压图套路），情景图铺满。 */
        scene.With(Text("城池：" + r.name, "city-l1", 0));
        scene.With(Text("条件：金币×" + Rules.N(r.cost), "city-l2", 0));
        /* 在线产出 = 服务端 income（每城递增）；离线沿用原版条件数。 */
        SiegeState s = net.Self() != null ? net.TypedSiege() : null;
        int income = r.cost;
        if (s != null && s.Cities != null && r.cityId >= 1 && r.cityId <= s.Cities.Count) {
            income = s.Cities[r.cityId - 1].Income;
        }
        scene.With(Text("产出：金币×" + Rules.N(income) + "/小时", "city-l3", 0));
        info.With(scene);

        Panel zz = Panel.Row(); zz.Pad(0); zz.Gap(Spec.Px(4));
        zz.Prefer(0, Spec.CityOwnerH());
        /* 三格都是「细框 + 格心字」（原版实测字心 = 格心）。框必须由容器
           画：`Label.OnPaint` 只画字、不画样式，写在 `.city-zz*` 上的背景/
           边框在 Label 身上根本不落笔；字居中同理只能靠容器的 flex 排。 */
        zz.With(CenterRow("城主", "city-zz-cell", "city-zz",
            Spec.CityZz1W(), Spec.CityOwnerH()));
        zz.With(CenterRow(r.owner, "city-zz-cell", "city-zz-name",
            Spec.CityZzNameW(), Spec.CityOwnerH()));
        zz.With(CenterRow(r.date, "city-zz-cell", "city-zz-date",
            Spec.CityZzDateW(), Spec.CityOwnerH()));
        info.With(zz);
        card.With(info);
        return card;
    }

    // ------------------------------------------------------------------
    //  动作（玩法未接：按本模板惯例给明确反馈，不假装已实现）
    // ------------------------------------------------------------------
    void CitySay(string msg) {
        if (net.Self() != null) { net.AddChat("[系统]", msg); return; }
        g.Log(msg);
    }

    void CityAttack(int i) {
        List<CityInfo> rows = CityRows();
        if (i < 0 || i >= rows.Count) { return; }
        if (net.Self() != null && rows[i].cityId > 0) {
            net.SiegeAttack(rows[i].cityId);
            return;
        }
        CitySay("攻占「" + rows[i].name + "」（离线演示，攻占费 金币×" + Rules.N(rows[i].cost) + "）");
    }
}
