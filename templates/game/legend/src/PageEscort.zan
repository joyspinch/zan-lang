using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 4「押镖」——照原版 `押镖.png` 1:1 还原。
///
/// 与 BOSS之家同骨架（场景 + 怪物立绘 + 掉落格 + 表格右栏），但右栏是
/// 2 行镖车列表（编号 / 镖车信息 / 劫镖 钮）；左下两行「剩余押镖/物漂次数」；
/// 底部 3 键（开始押镖 / 我的镖车 / 说明）。
///
/// REFERENCE_AUDIT.md §4.1 表 4: 押镖
partial class LegendApp {
    void BuildEscort() {
        /* 联机：进页拉一次押镖态（次数/在途/倒计时服务端权威）。 */
        net.MaybeRefreshEscort();
        int pageW = app.ClientWidth() - Spec.LeftPad() - Spec.LeftW()
            - Spec.ChatW() - Spec.ChatPadR();
        int rightW = Spec.Px(389);
        int leftW = pageW - rightW;
        if (leftW < Spec.Px(360)) { leftW = Spec.Px(360); }

        Panel body = Panel.Row(); body.Class = "scene-page";
        body.Pad(0); body.Gap(0); body.Grow(); content.With(body);

        /* 左列：场景面板 + 掉落面板。 */
        Panel leftCol = Panel.Column(); leftCol.Pad(0); leftCol.Gap(0); leftCol.Grow();
        body.With(leftCol);
        Panel scene = EscortScenePane(leftW);
        scene.Grow(); leftCol.With(scene);
        Panel botPad = Panel.Column(); botPad.Prefer(0, Spec.SceneBotPad());
        botPad.DockBottom(); leftCol.Add(botPad);
        Panel loot = SceneLootPane(leftW);
        loot.DockBottom(); leftCol.Add(loot);

        /* 右列：镖车表（2 行）+ 分页 1/N。 */
        Panel rightCol = Panel.Column(); rightCol.Pad(0); rightCol.Gap(0);
        rightCol.Prefer(rightW, 0); rightCol.DockRight(); body.Add(rightCol);
        Panel rankPad = Panel.Column(); rankPad.Prefer(0, Spec.SceneBotPad());
        rankPad.DockBottom(); rightCol.Add(rankPad);
        Panel table = EscortTable();
        table.Grow(); rightCol.With(table);
    }

    Panel EscortScenePane(int paneW) {
        Panel pane = Panel.Column(); pane.Class = "scene-panel";
        pane.Pad(0); pane.Gap(0);

        Panel head = Panel.Row(); head.Class = "scene-head";
        head.Pad(0); head.Gap(0); head.Prefer(0, Spec.SceneHeadH());
        head.Padding(0, Spec.SceneFaceInset(), 0, 0);
        pane.With(head);
        Panel face = ScenePlayerBlock();
        face.Prefer(Spec.SceneFaceW(), 0); face.DockRight(); head.Add(face);
        Panel titleCol = Panel.Column(); titleCol.Pad(0); titleCol.Gap(0); titleCol.Grow();
        titleCol.Padding(Spec.SceneTitleInsetT(), 0, 0, Spec.SceneTitleInsetL());
        head.With(titleCol);
        titleCol.With(Text("镖车", "scene-title", 0));

        Panel mon = EscortMonsterZone(paneW, ScenePaneHeight());
        mon.Grow(); pane.With(mon);
        Panel foot = EscortFooter();
        foot.DockBottom(); pane.Add(foot);
        return pane;
    }

    Panel EscortMonsterZone(int paneW, int paneH) {
        Panel zone = Panel.Column(); zone.Class = "scene-mon-zone";
        zone.Pad(0); zone.Gap(0);

        int blockH = Spec.SceneMonHpTextH() + Spec.SceneMonBarGap()
            + Spec.SceneMonHpBarH() + Spec.SceneMonGap() + Spec.SceneMonBoxH();
        Panel padBot = Panel.Column(); padBot.Prefer(0, Spec.SceneMonBottom());
        padBot.DockBottom(); zone.Add(padBot);
        Panel block = Panel.Column(); block.Class = "scene-mon";
        block.Pad(0); block.Gap(0); block.Prefer(0, blockH);
        block.DockBottom(); zone.Add(block);

        int hpInset = (paneW - Spec.SceneMonHpW()) / 2;
        if (hpInset < 0) { hpInset = 0; }
        int spInset = (paneW - Spec.SceneMonBoxW()) / 2;
        if (spInset < 0) { spInset = 0; }

        int escortHp = g.escortLeft > 0 ? g.escortLeft : 100;
        int escortMax = GameTables.Value("escort_seconds");

        Panel hpRow = Panel.Row(); hpRow.Class = "scene-hp-row";
        hpRow.Pad(0); hpRow.Prefer(0, Spec.SceneMonHpTextH());
        hpRow.Padding(0, 0, 0, hpInset); block.With(hpRow);
        hpRow.With(Text(Rules.N(escortHp) + "/" + Rules.N(escortMax), "scene-mon-hp", 0));
        Panel barGap = Panel.Column(); barGap.Prefer(0, Spec.SceneMonBarGap());
        block.With(barGap);
        Panel barRow = Panel.Row(); barRow.Pad(0); barRow.Prefer(0, Spec.SceneMonHpBarH());
        block.With(barRow);
        barRow.With(SpacerW(hpInset));
        int barW = Spec.SceneMonHpW();
        if (escortMax > 0) { barW = Spec.SceneMonHpW() * escortHp / escortMax; }
        if (barW < Spec.Px(2)) { barW = Spec.Px(2); }
        Panel bar = Panel.Row(); bar.Class = "scene-mon-bar";
        bar.Prefer(barW, Spec.SceneMonHpBarH()); barRow.With(bar);
        Panel gapRow = Panel.Column(); gapRow.Prefer(0, Spec.SceneMonGap());
        block.With(gapRow);
        Panel spRow = Panel.Row(); spRow.Pad(0); spRow.Prefer(0, Spec.SceneMonBoxH());
        block.With(spRow);
        spRow.With(SpacerW(spInset));
        /* 镖车立绘用 BOSS 美术（镖车是个 NPC，picture 用 monsters.csv 中一辆）。 */
        Image sp = new Image("assets/item/00002.png", "镖车", "contain");
        sp.Prefer(Spec.SceneMonBoxW(), Spec.SceneMonBoxH()); spRow.With(sp);
        return zone;
    }

    /// 底部：左下两行（押镖/物漂 剩余次数）；底部 3 键（开始押镖 / 我的镖车 / 说明）。
    Panel EscortFooter() {
        Panel foot = Panel.Column(); foot.Class = "scene-foot";
        foot.Pad(0); foot.Gap(0); foot.Prefer(0, Spec.SceneFootH());

        Panel btnPad = Panel.Column(); btnPad.Prefer(0, Spec.SceneBtnInsetB());
        btnPad.DockBottom(); foot.Add(btnPad);
        Panel btnRow = Panel.Row(); btnRow.Pad(0); btnRow.Gap(0);
        btnRow.Prefer(0, Spec.SceneBtnH());
        btnRow.Padding(0, Spec.SceneBtnInsetR(), 0, Spec.SceneBtnPadL());
        btnRow.DockBottom(); foot.Add(btnRow);
        /* 右：3 个按钮（开始押镖 / 我的镖车 / 说明）。 */
        Panel fill = Panel.Row(); fill.Grow(); btnRow.With(fill);
        Panel btns = Panel.Row(); btns.Pad(0); btns.Gap(Spec.SceneBtnGap());
        btns.DockRight(); btnRow.Add(btns);
        btns.With(SceneBtn("开始押镖", Spec.SceneBtnChallengeW(), () => { EscortStart(); }));
        btns.With(SceneBtn("我的镖车", Spec.Px(80), () => { EscortMine(); }));
        btns.With(SceneBtn("说明", Spec.SceneBtnHelpW(), () => { EscortHelp(); }));

        /* 两行剩余次数（贴左下）。 */
        Panel g1 = Panel.Column(); g1.Prefer(0, Spec.SceneFootGap1()); g1.DockBottom(); foot.Add(g1);
        Panel leftRow = Panel.Column(); leftRow.Pad(0); leftRow.Gap(0);
        leftRow.Padding(0, 0, 0, Spec.SceneBtnPadL());
        leftRow.DockBottom(); foot.Add(leftRow);
        /* 次数：联机读服务端 escort 态（escort_tries=5 起始），离线读本地。 */
        int tries = GameTables.Value("escort_tries");
        JsonValue es = net.Self() != null ? net.PlayEscort() : null;
        if (es != null) {
            tries = es.Int("tries", tries);
        } else if (g.escortTries > 0) {
            tries = g.escortTries;
        }
        leftRow.With(Text("剩余押镖次数：" + Rules.N(tries) + "次", "scene-record", 0));
        leftRow.With(Text("剩余物漂次数：0次", "scene-record", 0));
        return foot;
    }

    /// 镖车表（编号 / 镖车信息 / 劫镖）。
    Panel EscortTable() {
        Panel p = Panel.Column(); p.Class = "bosshome-table";
        p.Pad(0); p.Gap(0);
        p.Padding(Spec.SceneRankPadT(), 0, 0, 0);

        /* 表头。 */
        Panel head = Panel.Row(); head.Class = "table-head";
        head.Pad(0); head.Gap(0); head.Prefer(0, Spec.SceneRankTextH());
        head.Padding(0, Spec.SceneRankFacePad(), 0, Spec.SceneRankFacePad());
        Label c1 = Text("编号", "table-head-cell", 0); c1.Prefer(Spec.Px(60), 0); head.With(c1);
        Label c2 = Text("镖车信息", "table-head-cell", 0); c2.Grow(); head.With(c2);
        p.With(head);

        /* 2 行镖车（演示数据；联机从 net.EscortList 取）。 */
        string[] names = new string[] { "李大爷的[普通镖车]", "万万[普通镖车]" };
        for (int r = 0; r < 2; r = r + 1) {
            Panel tr = Panel.Row();
            tr.Class = "table-row";
            tr.Pad(0); tr.Gap(0); tr.Prefer(0, Spec.SceneRankTextH());
            tr.Padding(0, Spec.SceneRankFacePad(), 0, Spec.SceneRankFacePad());
            Label n1 = Text(Rules.N(r + 1), "table-cell", 0); n1.Prefer(Spec.Px(60), 0); tr.With(n1);
            Label n2 = Text(names[r], "table-cell", 0); n2.Grow(); tr.With(n2);
            Button rob = Btn("劫镖", "table-rob", () => { EscortRob(r); });
            rob.Prefer(Spec.Px(60), 0); tr.With(rob);
            p.With(tr);
        }

        /* 分页。 */
        Panel pager = Panel.Row(); pager.Class = "scene-pager";
        pager.Pad(0); pager.Gap(Spec.Px(8));
        pager.Prefer(0, Spec.SceneChkRowH());
        pager.Padding(0, Spec.SceneRankFacePad(), 0, Spec.SceneRankFacePad());
        Button refresh = Btn("刷新镖车", "scene-btn", () => { EscortRefresh(); });
        refresh.Prefer(Spec.Px(80), Spec.SceneChkRowH()); pager.With(refresh);
        Label pp = Text("1", "scene-pager-text", 0); pp.Prefer(Spec.Px(20), 0); pager.With(pp);
        p.With(pager);
        return p;
    }

    void EscortStart() {
        if (net.Self() != null) { net.EscortGo(); return; }
        g.Escort();
    }
    /// 我的镖车：联机在途（stage==1）即交镖结算（escort_collect）；
    /// 否则报当前无镖车。离线只给本地反馈。
    void EscortMine() {
        JsonValue es = net.Self() != null ? net.PlayEscort() : null;
        if (es != null && es.Int("stage", 0) == 1) {
            net.EscortCollect();
            return;
        }
        if (net.Self() != null) { net.AddChat("[系统]", "当前没有进行中的镖车。"); return; }
        g.Log("我的镖车：当前没有进行中的镖车。");
    }
    void EscortRefresh() {
        if (net.Self() != null) { net.ReloadEscort(); return; }
        BuildPage();
    }
    void EscortHelp() {
        int n = GameTables.Value("escort_tries"); int secs = GameTables.Value("escort_seconds");
        string text = "押镖：每天签到重置 " + Rules.N(n) + " 次，每次 " + Rules.N(secs) + " 秒。镖车可能被劫——劫镖胜利可夺取部分奖励。";
        if (net.Self() != null) { net.AddChat("[系统]", text); return; }
        g.Log(text);
    }
    void EscortRob(int row) {
        if (net.Self() != null) { net.AddChat("[系统]", "劫镖中..."); return; }
        g.Log("劫镖中...");
    }
}
