using System;
using Gui;
using Gui.Widget;
using Legend;

// 页 24「爵位」——照原版逐像素还原（`mir2/mir/爵位.png`）。
// 12 列 × 12 行：爵位 / 玩家 / 累计贡献 / 气血 / 法力 / 攻击 / 魔法 / 道术 /
// 防御 / 魔防 / 速度 / 经验加成。表头带满宽青字；**第 4 行（国公·焱森粥熟夷）
// 是「自己」的整行紫红高亮底 `#570d41`**（原版里连格缝也是紫红，说明是高亮
// 整行背景而不是逐格填色）；页脚比称谓页多一组「元宝: [100] [捐献]」与
// 两条状态文字（累计捐献 / 我的爵位）。
// 表格本体走共享组件 `TableUi.zan`，本页只给数据、逐列配色类名与页脚左组。
// 配色（原版实测）：爵位橙、玩家青、累计贡献黄；**七列属性值按爵位分档上色**
// ——亲王红 / 国公橙 / 侯爵绿 / 伯爵浅灰，这是原版区分品阶的语义色，不是
// 逐列固定色（与称谓页的五列固定色**不同**）；速度与经验加成同为黄。
partial class LegendApp {
    // 表头十二列。
    static List<string> LordHeads() {
        List<string> h = new List<string>();
        h.Add("爵位"); h.Add("玩家"); h.Add("累计贡献");
        h.Add("气血"); h.Add("法力"); h.Add("攻击"); h.Add("魔法");
        h.Add("道术"); h.Add("防御"); h.Add("魔防");
        h.Add("速度"); h.Add("经验加成");
        return h;
    }

    // 属性列分档配色类名：tier 0 亲王 / 1 国公 / 2 侯爵 / 3 伯爵。
    static string LordAttrCls(int tier) {
        if (tier == 0) { return "lord-attr lord-t0"; }
        if (tier == 1) { return "lord-attr lord-t1"; }
        if (tier == 2) { return "lord-attr lord-t2"; }
        return "lord-attr lord-t3";
    }

    // 一行爵位数据。**一行一实体**——原先是 6 个平行数组（爵位名 / 玩家 /
    // 累计贡献 / 加成 / 速度 / 经验）靠下标对齐。爵位名由 `tier` 推出，
    // 贡献与加成存数值（贡献原版写「50,1300」= 万位分隔），「自己」是**行的
    // 一个属性**（原版高亮那一行），不是写死的下标——接真实数据后就是
    // `row.playerId == self.id`。
    class LordRow {
        int tier;  // 0 亲王 / 1 国公 / 2 侯爵 / 3 伯爵
        string player;
        long contribution;
        int bonusPct;  // 七项属性加成（气血/法力/攻击/魔法/道术/防御/魔防）
        int speedPct;
        int expPct;
        bool self;
        string NameText() {
            if (tier == 0) { return "亲王"; }
            if (tier == 1) { return "国公"; }
            if (tier == 2) { return "侯爵"; }
            return "伯爵";
        }
        string ContributionText() { return Rules.Wan(contribution); }
        string BonusText() { return Rules.Percent(bonusPct); }
        string SpeedText() { return Rules.Percent(speedPct); }
        string ExpText() { return Rules.Percent(expPct); }
    }

    // 当前榜行：全部消费服务端爵位榜实体（st.Rows + 我的 me），消除客户端硬编码假玩家。
    List<LordRow> LordRows() {
        if (net.Self() == null || net.TypedLord() == null || net.TypedLord().Rows == null) { return new List<LordRow>(); }
        LordState st = net.TypedLord();
        List<LordRow> v = new List<LordRow>();
        for (int i = 0; i < st.Rows.Count; i = i + 1) {
            LordRankRow m = st.Rows[i];
            LordRow r = new LordRow();
            r.tier = m.Tier;
            r.player = m.Name;
            r.contribution = m.Contrib;
            r.self = m.Self;
            r.bonusPct = r.self ? st.MyBonus : LordTierVal(r.tier, "lord_bonus");
            r.speedPct = r.self ? st.MySpeed : LordTierVal(r.tier, "lord_speed");
            r.expPct = r.self ? st.MyExp : LordTierVal(r.tier, "lord_exp");
            v.Add(r);
        }
        return v;
    }

    // 档位键取值：tier 0 亲王 → lord_*4，tier 3 伯爵 → lord_*1。
    static int LordTierVal(int tier, string key) {
        int n = 4 - tier;
        if (n < 1) { n = 1; }
        if (n > 4) { n = 4; }
        return GameTables.Value(key + Convert.ToString(n));
    }

    // 我的爵位名（无贡献 = 无）。
    string LordMyTierName() {
        if (net.Self() == null || net.TypedLord() == null) { return "无"; }
        LordState st = net.TypedLord();
        if (st.MyContrib <= 0) { return "无"; }
        int tier = st.MyTier;
        if (tier == 0) { return "亲王"; }
        if (tier == 1) { return "国公"; }
        if (tier == 2) { return "侯爵"; }
        if (tier == 3) { return "伯爵"; }
        return "平民";
    }

    // 我的累计贡献（在线读 me，离线无）。
    string LordMyContrib() {
        if (net.Self() == null || net.TypedLord() == null) { return "无"; }
        return Rules.Wan(net.TypedLord().MyContrib);
    }

    void BuildLordPage() {
        if (net.Self() != null) { net.MaybeRefreshLord(); }
        Panel page0 = Panel.Column(); page0.Class = "tbl-page";
        page0.Pad(0); page0.Gap(0); page0.Grow(); content.With(page0);

        List<int> ws = Spec.TblLordCols();
        Panel box = TblBox(); page0.With(box);
        box.With(TblHead(LordHeads(), ws));

        Panel headGap = Panel.Row(); headGap.Pad(0);
        headGap.Prefer(0, Spec.TblHeadGap()); box.With(headGap);

        Panel wall = Panel.Column(); wall.Pad(0); wall.Gap(Spec.TblRowGap());
        box.With(wall);

        List<LordRow> rows = LordRows();
        if (rows.Count == 0) {
            List<string> cells = new List<string>();
            cells.Add("-"); cells.Add("暂无爵位数据，请通过下方参与捐献获取爵位");
            cells.Add("-");
            for (int i = 0; i < 7; i = i + 1) { cells.Add("-"); }
            cells.Add("-"); cells.Add("-");

            List<string> cls = new List<string>();
            cls.Add("lord-c0"); cls.Add("lord-c1"); cls.Add("lord-c2");
            for (int i = 0; i < 7; i = i + 1) { cls.Add("lord-attr lord-t3"); }
            cls.Add("lord-cy"); cls.Add("lord-cy");

            wall.With(TblRowCls(cells, cls, ws, 0, "tbl-row", "tbl-cell"));
        } else {
            for (int r = 0; r < Spec.TblRows(); r = r + 1) {
                if (r >= rows.Count) { break; }
                LordRow lo = rows[r];
                List<string> cells = new List<string>();
                cells.Add(lo.NameText()); cells.Add(lo.player);
                cells.Add(lo.ContributionText());
                for (int i = 0; i < 7; i = i + 1) { cells.Add(lo.BonusText()); }
                cells.Add(lo.SpeedText()); cells.Add(lo.ExpText());

                List<string> cls = new List<string>();
                cls.Add("lord-c0"); cls.Add("lord-c1"); cls.Add("lord-c2");
                for (int i = 0; i < 7; i = i + 1) { cls.Add(LordAttrCls(lo.tier)); }
                cls.Add("lord-cy"); cls.Add("lord-cy");

                wall.With(TblRowCls(cells, cls, ws, r,
                                    lo.self ? "tbl-row-hl" : "tbl-row",
                                    lo.self ? "tbl-cell tbl-cell-hl" : "tbl-cell"));
            }
        }
        box.With(TblPad(Spec.TblBottomPad()));

        Panel footGap = Panel.Row(); footGap.Pad(0);
        footGap.Prefer(0, Spec.TblFootGap()); page0.With(footGap);

        SignalInt pgSig = new SignalInt(1);
        Pagination pg = new Pagination(5, pgSig);
        pg.Class = "simple";
        pg.PrevText("上一页"); pg.NextText("下一页");
        pg.Named("lord-pager");
        page0.With(TblFootCustom(LordFootLeft(), pg));
    }

    // 页脚左组：元宝组 / 累计捐献组 / 我的爵位组。三组用**定宽盒**摆位
    // （实测左缘 392 / 671 / 916），组间距离不等，用 Gap 凑不出来；两段宽度
    // 已扣掉页脚容器的 4 设备缝。
    Panel LordFootLeft() {
        Panel left = Panel.Row(); left.Pad(0); left.Gap(0);
        left.Prefer(0, Spec.TblFootH());

        Panel g1 = Panel.Row(); g1.Pad(0); g1.Gap(Spec.TblColGap());
        g1.Prefer(Spec.LordFootCol1W(), Spec.TblFootH());
        Label k = Text("元宝:", "tbl-note-k", 0);
        k.Prefer(Spec.LordFootLblW(), Spec.TblFootH());
        g1.With(k);
        Input yuan = new Input("");
        yuan.Class = "lord-input";
        yuan.Prefer(Spec.LordFootBoxW(), Spec.TblFootH());
        yuan.SetText("100");
        yuan.Named("lord-yuan");
        g1.With(yuan);
        g1.With(BtnDev("捐献", "lord-donate", Spec.LordFootBoxW(),
                       Spec.TblFootH(), () => { LordDonate(yuan); }));
        left.With(g1);

        Panel g2 = Panel.Row(); g2.Pad(0); g2.Gap(0);
        g2.Prefer(Spec.LordFootCol2W(), Spec.TblFootH());
        g2.With(TblFootNote("累计捐献：", LordMyContrib(), "lord-note-o"));
        left.With(g2);

        left.With(TblFootNote("我的爵位：", LordMyTierName(), "lord-note-p"));
        return left;
    }

    // 「捐献」钮：在线走服务端 lord donate（校验元宝与下限），离线给明确反馈。
    void LordDonate(Input yuan) {
        string amount = yuan.GetText();
        if (amount.Length == 0) { amount = "0"; }
        if (net.Self() == null) { g.Log("捐献元宝：" + amount); return; }
        int n = Convert.ToInt(amount);
        if (n <= 0) { net.AddChat("[系统]", "请输入要捐献的元宝数量"); return; }
        net.LordDonate(n);
    }
}
