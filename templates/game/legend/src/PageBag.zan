using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 20「背包」——照原版逐像素还原。
///
/// 原版实测（mir2/mir/背包.png 整页 + 背包-天书/内功/宝石/技能.png 四张特写）：
///   · 整页分**上下两段**，中间一条分隔线
///   · 上段：左「人物立绘 + 环绕装备格」/ 中「6×6 = 36 格物品栏」/ 右「竖排 9 个功能钮」
///   · 下段：顶部 6 个 tab —— 取出 / 说明 / 天书 / 内功 / 宝石 / 技能
///   · 下段左侧固定：「法师(3)」槽位 + 战士/法师/道士 + 男/女 + 创建英雄/取消
///
/// 布局纪律：定宽格子一律用 `Panel.Row + Gap` 手排，
/// 不用 `Grid.Of(n)`（它会把子项等分成容器宽，定宽卡片会被拉变形）。
partial class LegendApp {
    /// 下段当前 tab：0=取出 1=说明 2=天书 3=内功 4=宝石 5=技能
    int bagTab = 0;

    /// 仓库视图：whMode=物品栏切到仓库（联机读服务端 wh 行，离线读
    /// `g.storage`）；whPick=入库选择模式（点背包物品整叠入库）。
    /// 加锁/使用(A) 无对应玩法后端，本轮保持诚实占位（提示进聊天）。
    bool whMode = false;
    bool whPick = false;

    /* ---- 本页局部实测尺寸 ----
       尺寸常量全在 `Spec.Bag*`（唯一事实来源，逻辑像素 → Spec.Px 设备
       像素），页面里不再写死像素值。 */

    Panel bagLower;              // 下段容器（切 tab 只重建它）

    void BuildBag() {
        Panel page0 = Panel.Column(); page0.Class = "bag-page";
        page0.Pad(0); page0.Gap(0); page0.Grow(); content.With(page0);
        /* 上段距内容区顶 11 设备（原版 163→174）。`.bag-page` 的 CSS 声明了
           `padding:0`，会盖掉代码的 Pad()（StylePadT 不看 padSet），所以
           这里用一个定高空行而不是 padding。 */
        Panel padTop = Panel.Row(); padTop.Prefer(0, Spec.Px(7)); page0.With(padTop);
        /* 左内边距 20 设备（原版背包面板距内容区左缘 373→394）：`.bag-page`
           的 CSS 声明了 `padding:0`，会盖掉代码的 Pad()，所以走前导撑条。 */
        Panel wrap = Panel.Row(); wrap.Pad(0); wrap.Gap(0); page0.With(wrap);
        wrap.With(SpacerW(Spec.BagPagePad()));
        Panel col = Panel.Column(); col.Pad(0); col.Gap(0); col.Grow(); wrap.With(col);

        /* 上段：定高（= 立绘整图高 375 设备，1:1），宽度靠左自然排——原版
           背包是定宽面板，多出来的横向空间是背景，不拉伸（见 Spec §背包）。
           **Pad 必须为 0**：立绘高度靠 flex 的 stretch 拿到容器高，
           加了内边距它就会被压矮、底行装备格跟着上移。 */
        Panel top = Panel.Row(); top.Class = "bag-top";
        top.Pad(0); top.Gap(Spec.BagBlockGap());
        top.Prefer(0, Spec.BagTopH()); col.With(top);
        BuildBagTop(top);

        /* 下段：**不吃上段那 13 设备左缩进**——原版下段的 tab 行/建角列
           （x 380 起）比上部立绘（x 394 起）靠左 13，挂在 page0 直下即可。
           Grow 沿垂直方向（page0 是 column，垂直是第二维）。 */
        bagLower = Panel.Column(); bagLower.Class = "bag-lower";
        bagLower.Pad(0); bagLower.Gap(0);
        bagLower.Grow(); page0.With(bagLower);
        BuildBagLower();
    }

    void RebuildBagLower() {
        if (bagLower == null) { return; }
        bagLower.RemoveAll();
        BuildBagLower();
    }

    // =====================================================================
    //  上段：立绘（含 12 装备格）+ 功能钮列 + 物品栏
    // =====================================================================
    void BuildBagTop(Panel top) {
        /* 原版布局（背包.png 实测）从左到右：
             ① 人物立绘 + 12 个装备格
             ② 8 个功能按钮竖列（切换仓库/入库(F)/加锁/使用(A)/整理/
                放入图鉴/——/一键熔炼/卖出(X)）—— 夹在立绘和物品栏
                之间，不是在最右端
             ③ 6 列 × 7 行物品栏（容量 36，多出的行是空框）
             ④ 右侧留白（原版定宽面板，见 Spec §背包） */
        Panel portrait = Panel.Row(); portrait.Class = "bag-portrait";
        portrait.Pad(0); portrait.Prefer(Spec.BagPortraitW(), Spec.BagTopH());
        top.With(portrait);
        /* 立绘用整图 `00009.jpg`（168×250）：男子 + 12 个空格框已压好，
           1:1 撑满。装备 = 画在这些空框里的道具——**不再自己画格框**
           （自己画会跟底图的框差几个像素，正是「装备格子显示有问题」）。 */
        Image pic = new Image("assets/ui/00009.jpg", "人物+装备环", "cover");
        pic.DockFill(); portrait.Add(pic);
        for (int i = 0; i < 12; i = i + 1) {
            Equipment worn = g != null ? g.equipped[i] : null;
            Panel cell = EquipArt(Spec.BagSlotW(), Spec.BagSlotH(), worn);
            cell.DockManual();
            cell.Place(Spec.BagEquipX(i), Spec.BagEquipY(i));
            portrait.Add(cell);
        }

        /* ② 8 个功能按钮：按钮大小 = 文字 + 皮肤内边距，由测量自算
           （gui-design 硬规则：文字控件的宽高不手写，Prefer 钉死会裁字）。 */
        Panel acts = Panel.Column(); acts.Class = "bag-acts";
        acts.Gap(Spec.BagActGap()); acts.Prefer(Spec.BagActW(), 0); top.With(acts);
        string[] labels = new string[] { "切换仓库", "入库(F)", "加锁", "使用(A)",
                            "整理", "放入图鉴", "一键熔炼", "卖出(X)" };
        /* 视图状态直接落在按钮文字上：仓库视图 / 入库选择模式一眼可见，
           不引入新皮肤类（.bag-act 的样式面保持原样）。 */
        if (this.whMode) { labels[0] = "返回背包"; }
        if (this.whPick) { labels[1] = "入库中…"; }
        for (int i = 0; i < 8; i = i + 1) {
            if (i == 6) {
                Panel sep = Panel.Row(); sep.Prefer(0, Spec.BagActBigGap());
                acts.With(sep);
            }
            int bIdx = i;
            Button b = Btn(labels[i], "bag-act", () => { BagAct(bIdx); });
            b.Prefer(Spec.BagActW(), Spec.BagActH()); acts.With(b);
        }

        /* ③ 物品栏：**整张背景图** `assets/ui/00083.jpg`（488×249，里面
           就是 11 列 × 7 行的暗格 + 细边线，与原版格阵一一对应），
           `stretch` 撑满；道具再按格位叠上去。
           原版的格子**不是一格格画出来的**（用户实测指出，见
           REFERENCE_AUDIT §5.11）：空格用的是同一张底图，只有有道具的
           格子才多一个道具精灵。之前拿 `00211.png` 逐格拼是自绘式误解
           ——00211 是「取出」表那种石块格，不是主物品栏的格。 */
        Panel mid = Panel.Row(); mid.Class = "bag-grid";
        mid.Pad(0); mid.Prefer(Spec.BagGridW(), Spec.BagGridH()); top.With(mid);
        Image bg = new Image(BagGridPath(), "物品栏", "stretch");
        bg.DockFill(); mid.Add(bg);
        for (int i = 0; i < Spec.BagCols() * Spec.BagRows(); i = i + 1) {
            int c = i % Spec.BagCols();
            int r = i / Spec.BagCols();
            int x0 = (c * Spec.BagGridW()) / Spec.BagCols();
            int x1 = ((c + 1) * Spec.BagGridW()) / Spec.BagCols();
            int y0 = (r * Spec.BagGridH()) / Spec.BagRows();
            int y1 = ((r + 1) * Spec.BagGridH()) / Spec.BagRows();
            Panel cell = BagCellView(i, x1 - x0, y1 - y0);
            cell.DockManual(); cell.Place(x0, y0);
            mid.Add(cell);
        }
    }

    /// 物品栏里第 i 格（行优先，0 起）：有道具画道具，没有就什么都不画
    /// （格的暗底与边线由背景图 `00083.jpg` 提供）。
    /// 联机 live-first：背包/仓库格直接读服务端行（PageRecycle 同款），
    /// 离线才读本地存档 `g.bag`/`g.storage`。有道具的格子可点：
    /// 入库选择模式点背包物品=入库，仓库视图点物品=取回。
    Panel BagCellView(int i, int w, int h) {
        if (net.Self() != null) {
            JsonValue b = whMode ? net.WhAt(i) : net.BagAt(i);
            if (b == null) { return SlotArt(w, h, "", "", ""); }
            Panel c = ItemArtCell(w, h, b.Int("id", 0), b.Int("count", 1));
            int idx = i;
            c.OnClick(() => { BagCellTap(idx); });
            return c;
        }
        Equipment e = null;
        if (whMode) { if (i >= 0 && i < g.storage.Count) { e = g.storage[i]; } }
        else if (g != null && i >= 0 && i < g.bag.Count) { e = g.bag[i]; }
        Panel p = EquipArt(w, h, e);
        if (e != null) { int idx = i; p.OnClick(() => { BagCellTap(idx); }); }
        return p;
    }

    /// 服务端物品行（id+count）→ 主物品栏格：只叠图标+角标（同 EquipArt
    /// 的画法，不带 00211 石框——主格的框画在 00083 整图里）。
    Panel ItemArtCell(int wDevice, int hDevice, int itemId, int count) {
        string art = itemId > 0 ? ItemArtById(itemId) : "";
        return SlotArt(wDevice, hDevice, art,
            count > 1 ? Rules.N(count) : "", "slot-badge");
    }

    /// 物品栏点击：入库选择模式点背包物品=整叠入库；仓库视图点物品=
    /// 整叠取回。其余情况不动作（穿戴/详情弹窗未还原，不假装有）。
    void BagCellTap(int i) {
        if (net.Self() != null) {
            JsonValue b = whMode ? net.WhAt(i) : net.BagAt(i);
            if (b == null) { return; }
            int itemId = b.Int("id", 0);
            int count = b.Int("count", 1);
            if (itemId <= 0 || count <= 0) { return; }
            if (whMode) { net.WhMove(itemId, count, false); }
            else if (whPick) { net.WhMove(itemId, count, true); }
            return;
        }
        if (whMode) { g.Store(i, true); this.Rebuild(); }
        else if (whPick) { g.Store(i, false); this.Rebuild(); }
    }

    // =====================================================================
    //  下段：tab 行 + 内容（左固定面板随 tab 变）
    // =====================================================================
    /// 原版实测（背包.png 全屏 1:1）：tab 行横贯整窗，左端是
    /// 「法师(3) | 创建 | 创建」三个 tab，右端 6 个 tab（取出…技能）贴
    /// 窗口右缘 1450 收尾，中间留空——**不是**紧跟建角列左对齐。
    void BuildBagLower() {
        Panel tabRow = Panel.Row(); tabRow.Class = "bag-tabs";
        tabRow.Gap(0); tabRow.Prefer(0, Spec.BagTabH()); bagLower.With(tabRow);

        Button heroTab = Btn("法师(3)", "bag-tab bag-tab-on", () => { });
        heroTab.Prefer(Spec.BagHeroTabW(), Spec.BagTabH()); tabRow.With(heroTab);
        tabRow.With(SpacerW(Spec.BagTabSep()));
        Button mk1 = Btn("创建", "bag-tab", () => { });
        mk1.Prefer(Spec.BagTabW(), Spec.BagTabH()); tabRow.With(mk1);
        tabRow.With(SpacerW(Spec.BagTabSep()));
        Button mk2 = Btn("创建", "bag-tab", () => { });
        mk2.Prefer(Spec.BagTabW(), Spec.BagTabH()); tabRow.With(mk2);

        Panel tabGap = Panel.Row(); tabGap.Class = "bag-fill"; tabRow.With(tabGap);

        string[] names = new string[] { "取出", "说明", "天书", "内功", "宝石", "技能" };
        for (int i = 0; i < 6; i = i + 1) {
            int idx = i;
            Button t = Btn(names[i], i == bagTab ? "bag-tab bag-tab-on" : "bag-tab", () => {
                bagTab = idx; RebuildBagLower();
            });
            t.Prefer(Spec.BagTabW(), Spec.BagTabH()); tabRow.With(t);
        }

        Panel body = Panel.Row(); body.Class = "bag-tab-body";
        body.Pad(0); body.Gap(0); body.Grow(); bagLower.With(body);
        if (bagTab == 0) { BuildBagTabTake(body); return; }
        if (bagTab == 1) { BuildBagTabHelp(body); return; }
        if (bagTab == 2) { BuildBagTabTianshu(body); return; }
        if (bagTab == 3) { BuildBagTabNeigong(body); return; }
        if (bagTab == 4) { BuildBagTabGem(body); return; }
        BuildBagTabSkill(body);
    }

    /// 下段左侧固定列：取出页 = 战斗属性面板；天书/内功/宝石/技能 =
    /// 建角面板（职业/性别 + 创建英雄/取消）。原版就是这么切分的：
    /// 背包.png（取出）左列只有战斗属性，建角面板只在天书系 tab 出现。
    Panel BagLeftPanel() {
        if (bagTab == 0 || bagTab == 1) { return BagFightPanel(); }
        return BagCreatePanel();
    }

    /// 左侧「战斗属性」面板：攻击/魔法/道术/防御/魔防/幸运 六行。
    /// 数值取自角色当前属性（`g.Stat*`），与角色页同源。
    Panel BagFightPanel() {
        Panel p = Panel.Column(); p.Class = "bag-fight";
        p.Gap(Spec.Px(3)); p.Pad(Spec.Px(5)); p.Prefer(Spec.BagFightW(), 0);
        p.With(Text("战斗属性", "bag-fight-title", 16));
        p.With(BagFightLine("攻击", BagPair("attack"), "bag-fight-a"));
        p.With(BagFightLine("魔法", BagPair("magic"), "bag-fight-b"));
        p.With(BagFightLine("道术", BagPair("tao"), "bag-fight-c"));
        p.With(BagFightLine("防御", BagPair("defense"), "bag-fight-d"));
        p.With(BagFightLine("魔防", BagPair("magic_defense"), "bag-fight-e"));
        /* 幸运没有对应属性（attributes.csv 只有 hp/mp/三系攻击/防御/魔防），
           原版这行也恒为「+ 0」。 */
        p.With(BagFightLine("幸运", "+ 0", "bag-fight-f"));
        return p;
    }

    /// 「min - max」——原版战斗属性行是「2 - 10」这种带空格的写法；
    /// `Game.StatPair` 用的是无空格短横，别直接拿来拼这一页。
    string BagPair(string group) {
        return Rules.N(g.Stat(group + "_min")) + " - " + Rules.N(g.StatMax(group));
    }

    /// 战斗属性一行「标签: 值」——标签按原版配色（攻青/魔蓝/道绿/防黄/魔防紫/幸运橙）。
    Panel BagFightLine(string label, string value, string cls) {
        Panel r = Panel.Row(); r.Gap(Spec.Px(3)); r.Prefer(0, Spec.Px(17));
        Label k = Text(label + ":", cls, 15); k.Prefer(Spec.Px(46), 0); r.With(k);
        r.With(Text(value, "bag-fight-v", 15));
        return r;
    }

    /// 左侧建角面板（天书/内功/宝石/技能 tab 用）。
    Panel BagCreatePanel() {
        Panel p = Panel.Column(); p.Class = "bag-create";
        p.Gap(Spec.Px(4)); p.Pad(Spec.Px(4)); p.Prefer(Spec.BagCreateW(), 0);

        Panel jobs = Panel.Row(); jobs.Gap(Spec.Px(6)); jobs.Prefer(0, Spec.Px(48));
        jobs.With(BagPickIcon("战士", 0));
        jobs.With(BagPickIcon("法师", 1));
        jobs.With(BagPickIcon("道士", 2));
        p.With(jobs);

        Panel sexes = Panel.Row(); sexes.Gap(Spec.Px(6)); sexes.Prefer(0, Spec.Px(48));
        sexes.With(BagPickIcon("男", 3));
        sexes.With(BagPickIcon("女", 4));
        p.With(sexes);

        Panel okRow = Panel.Row(); okRow.Gap(Spec.Px(4)); okRow.Prefer(0, Spec.Px(23));
        okRow.With(Btn("创建英雄", "bag-primary", () => { }));
        okRow.With(Btn("取消", "bag-plain", () => { }));
        p.With(okRow);
        return p;
    }

    /// 单个空位格：石框精灵（`00211.png`）+ 居中问号。原版的问号是
    /// 客户端字体画的占位符，素材包里没有对应精灵（已按签名比对排除，
    /// 见 REFERENCE_AUDIT §5.11），所以这里叠一个文字问号。
    Panel QCell(int w, int h) {
        Panel s = SpriteCell("bag-cell", w, h, "", "", "");
        Label q = Text("?", "bag-q-mark", 18);
        q.DockManual(); q.Place(w / 2 - Spec.Px(5), h / 2 - Spec.Px(8));
        s.Add(q);
        return s;
    }

    /// 职业/性别选择图标：原版是**石块贴图 + 黑色徽记**（战=交叉剑 /
    /// 法=法杖 / 道=钩秤 / 男=箭头 / 女=♀）。石块底用真素材 `00211.png`，
    /// 徽记用文字近似（徽记精灵不在 ui 包内，已比对排除）。
    Panel BagPickIcon(string name, int idx) {
        Panel p = Panel.Column(); p.Class = "bag-pick";
        p.Gap(Spec.Px(2)); p.Prefer(Spec.Px(38), 0);
        p.With(SpriteCell("bag-pick-cell", Spec.Px(38), Spec.Px(31),
            "", "", ""));
        p.With(Text(name, "bag-pick-name", 14));
        p.OnClick(() => { });
        return p;
    }

    // =====================================================================
    //  下段 6 个 tab 的内容
    // =====================================================================

    /// 取出：左「战斗属性」面板 + 右 4 行 × 2 组空位表。
    /// 原版每组 = 石框格(带?) + 「空 / 0/100」+ 右对齐「0/0 / TP:0」+ 升级钮。
    void BuildBagTabTake(Panel host) {
        Panel row = Panel.Row(); row.Class = "bag-body";
        row.Pad(Spec.Px(4)); row.Gap(Spec.Px(3));
        row.Grow(); host.With(row);
        row.With(BagFightPanel());

        Panel table = Panel.Column(); table.Class = "bag-fill";
        table.Gap(0); row.With(table);
        for (int r = 0; r < 4; r = r + 1) {
            Panel line = Panel.Row(); line.Gap(Spec.BagRowGap());
            line.Prefer(0, Spec.BagRowH()); table.With(line);
            line.With(BagTableGroup(r * 2));
            line.With(BagTableGroup(r * 2 + 1));
        }
    }

    /// 取出表的一格组：格 + 名称/进度 + 数量/TP + 升级钮。
    Panel BagTableGroup(int slot) {
        Panel gp = Panel.Row(); gp.Class = "bag-grp"; gp.Gap(Spec.Px(4));
        gp.Prefer(Spec.BagGroupW(), 0);
        gp.With(QCell(Spec.BagLowCellW(), Spec.BagLowCellH()));

        Panel mid = Panel.Column(); mid.Class = "bag-fill"; mid.Gap(0); gp.With(mid);
        Panel l1 = Panel.Row(); l1.Prefer(0, Spec.Px(18)); mid.With(l1);
        l1.With(Text("空", "bag-tab-name", 15));
        Panel l2 = Panel.Row(); l2.Prefer(0, Spec.Px(17)); mid.With(l2);
        l2.With(Text("0/100", "bag-tab-xp", 14));

        Panel num = Panel.Column(); num.Gap(0); num.Prefer(Spec.Px(62), 0); gp.With(num);
        Panel n1 = Panel.Row(); n1.Class = "bag-row-r"; n1.Prefer(0, Spec.Px(18));
        n1.With(Text("0/0", "bag-tab-num", 15)); num.With(n1);
        Panel n2 = Panel.Row(); n2.Class = "bag-row-r"; n2.Prefer(0, Spec.Px(17));
        n2.With(Text("TP:0", "bag-tab-tp", 14)); num.With(n2);

        Button up = Btn("升级", "bag-up", () => { });
        up.Prefer(Spec.BagUpW(), Spec.BagUpH()); gp.With(up);
        return gp;
    }

    /// 说明：纯文本区。
    void BuildBagTabHelp(Panel host) {
        Panel row = Panel.Row(); row.Class = "bag-body";
        row.Pad(Spec.Px(4)); row.Gap(Spec.Px(3));
        row.Grow(); host.With(row);
        row.With(BagFightPanel());
        Panel col = Panel.Column(); col.Pad(Spec.Px(5)); col.Gap(Spec.Px(4));
        col.Grow(); row.With(col);
        col.With(Text("背包说明", "yellow strong", 16));
        col.With(Text("左键选中格子，再点右侧功能钮操作。", "secondary", 14));
        col.With(Text("仓库分 5 页，用「切换仓库」翻页。", "secondary", 14));
        col.With(Text("「放入图鉴」会把选中的装备登记进神兵图鉴。", "secondary", 14));
    }

    /// 天书：左建角面板 + 4 列 × 2 行格（每格「取出」钮）+ 右侧属性面板。
    void BuildBagTabTianshu(Panel host) {
        Panel root0 = Panel.Row(); root0.Class = "bag-body";
        root0.Pad(Spec.Px(4)); root0.Gap(Spec.Px(3));
        root0.Grow(); host.With(root0);
        root0.With(BagCreatePanel());

        Panel left = Panel.Column(); left.Class = "bag-fill";
        left.Gap(Spec.Px(5)); root0.With(left);
        for (int r = 0; r < 2; r = r + 1) {
            Panel row = Panel.Row(); row.Gap(Spec.Px(5));
            row.Prefer(0, Spec.Px(49)); left.With(row);
            for (int c = 0; c < 4; c = c + 1) {
                Panel cell = Panel.Column(); cell.Gap(Spec.Px(3));
                cell.Prefer(Spec.Px(45), 0);
                cell.With(QCell(Spec.Px(38), Spec.Px(31)));
                cell.With(Btn("取出", "bag-mini", () => { }));
                row.With(cell);
            }
        }

        /* 右侧属性面板：攻击/魔法/道术/防御/魔防/负重。 */
        Panel stats = Panel.Column(); stats.Class = "bag-stats";
        stats.Gap(6); stats.Prefer(230, 0); root0.With(stats);
        string[] keys = new string[] { "攻击", "魔法", "道术", "防御", "魔防" };
        for (int i = 0; i < 5; i = i + 1) {
            stats.With(BagStatRow(keys[i] + ":", "+0%"));
        }
        stats.With(BagStatRow("负重:", "0/0"));
    }

    /// 一行「标签: 值框」。
    Panel BagStatRow(string k, string v) {
        Panel r = Panel.Row(); r.Gap(6); r.Prefer(0, 30);
        Label lk = Text(k, "bag-stat-k", 14); lk.Prefer(56, 0); r.With(lk);
        Panel box = Panel.Row(); box.Class = "bag-stat-box";
        box.Pad(0); box.Grow();
        Label lv = Text(v, "bag-stat-v", 14); lv.Grow(); box.With(lv);
        r.With(box);
        return r;
    }

    /// 内功：左建角面板 + 中立绘 + 右侧 2 张卡（金钟罩 / 铁布衫）。
    void BuildBagTabNeigong(Panel host) {
        Panel root0 = Panel.Row(); root0.Pad(Spec.Px(4)); root0.Gap(Spec.Px(3));
        root0.Grow(); host.With(root0);
        root0.With(BagCreatePanel());

        Panel art = Panel.Row(); art.Class = "bag-neigong-art";
        art.Pad(0); art.Prefer(Spec.Px(190), 0); root0.With(art);
        Image im = new Image(NeigongArtPath(), "内功", "cover");
        im.DockFill(); art.Add(im);
        Panel cards = Panel.Row(); cards.Class = "bag-cards bag-fill";
        cards.Gap(Spec.Px(5)); root0.With(cards);
        cards.With(NeigongCard("金钟罩"));
        cards.With(NeigongCard("铁布衫"));
    }

    /// 内功立绘：原版是一张紫色打坐武僧插画。抽出的素材包里没有这张
    /// （show 包全是时装/翅膀立绘，逐张比对过），只能沿用 art.csv 的
    /// 占位约定；已在 REFERENCE_AUDIT §5.11 登记为素材缺口。
    static string NeigongArtPath() { return "assets/show/00002.png"; }

    Panel NeigongCard(string name) {
        Panel c = Panel.Column(); c.Class = "bag-neigong bag-fill";
        c.Gap(6); c.Pad(8);
        c.With(BagKv("内功:", name, "bag-nei-name"));
        c.With(BagKv("等级:", "0", ""));
        c.With(BagKv("效果:", "+0%防御", ""));
        c.With(BagKv("战功:", "2.0000", ""));
        c.With(BagKv("金币:", "1000.0000", ""));
        Button up = Btn("升级", "bag-primary", () => { });
        up.Prefer(0, 34); c.With(up);
        return c;
    }

    /// 一行「键: 值」（值可高亮）。
    Panel BagKv(string k, string v, string vcls) {
        Panel r = Panel.Row(); r.Gap(6); r.Prefer(0, 28);
        Label lk = Text(k, "bag-kv-k", 14); lk.Prefer(50, 0); r.With(lk);
        Label lv = Text(v, vcls.Length > 0 ? vcls : "bag-kv-v", 14); lv.Grow(); r.With(lv);
        return r;
    }

    /// 宝石：左建角面板 + 2 组 × 4 行，每行 = 装备类型格 + 4 个锁位。
    /// 原版未开的孔位画的是**锁精灵**（`00255.png`），不是空框。
    void BuildBagTabGem(Panel host) {
        Panel root0 = Panel.Row(); root0.Class = "bag-body";
        root0.Pad(Spec.Px(4)); root0.Gap(Spec.Px(5));
        root0.Grow(); host.With(root0);
        root0.With(BagCreatePanel());
        for (int col = 0; col < 2; col = col + 1) {
            Panel c = Panel.Column(); c.Class = "bag-fill";
            c.Gap(Spec.Px(4)); root0.With(c);
            for (int row = 0; row < 4; row = row + 1) {
                Panel r = Panel.Row(); r.Gap(Spec.Px(4)); r.Prefer(0, Spec.Px(29));
                r.With(ItemCellById("bag-cell", Spec.Px(25), Spec.Px(25), 0, 0));
                for (int s = 0; s < 4; s = s + 1) {
                    r.With(SpriteCell("bag-cell", Spec.Px(23), Spec.Px(23),
                        LockPath(), "", ""));
                }
                c.With(r);
            }
        }
    }

    /// 技能：左建角面板 + 2 列 × 4 行。
    /// 每项 = 图标 + 名称(0) + 进度条 + 经验/TP + Lv + 升级钮。
    void BuildBagTabSkill(Panel host) {
        Panel root0 = Panel.Row(); root0.Class = "bag-body";
        root0.Pad(Spec.Px(4)); root0.Gap(Spec.Px(4));
        root0.Grow(); host.With(root0);
        root0.With(BagCreatePanel());
        bool[] owned = new bool[] { true, true, true, true, true, true, false, false };
        string[] names = new string[] { "强化攻击", "强化魔法", "强化道术", "强化生命",
                           "强化防御", "强化魔防", "空", "空" };
        for (int col = 0; col < 2; col = col + 1) {
            Panel c = Panel.Column(); c.Class = "bag-fill";
            c.Gap(8); root0.With(c);
            for (int row = 0; row < 4; row = row + 1) {
                int i = col * 4 + row;
                c.With(BagSkillRow(names[i], owned[i]));
            }
        }
    }

    Panel BagSkillRow(string name, bool owned) {
        Panel r = Panel.Row(); r.Class = "bag-skill";
        r.Gap(8); r.Pad(4); r.Prefer(0, 50);

        r.With(ItemCellById("bag-cell", Spec.Px(25), Spec.Px(25), 0, 0));

        Panel mid = Panel.Column(); mid.Class = "bag-fill";
        mid.Gap(2); r.With(mid);
        Panel line1 = Panel.Row(); line1.Gap(6); line1.Prefer(0, 18); mid.With(line1);
        line1.With(Text(name + "(0)", "bag-skill-name", 14));
        Progress bar = new Progress(owned ? 42 : 0, 2);
        bar.Prefer(0, 8); bar.Grow(); mid.With(bar);
        Panel line2 = Panel.Row(); line2.Gap(6); line2.Prefer(0, 18); mid.With(line2);
        line2.With(Text(owned ? "106/250" : "0/100", "bag-skill-xp", 12));
        line2.With(Text("TP:0", "bag-skill-tp", 12));

        Panel right = Panel.Column(); right.Gap(2); right.Prefer(56, 0); r.With(right);
        right.With(Text(owned ? "Lv.2" : "0/0", "bag-skill-lv", 14));
        right.With(Btn("升级", "bag-mini", () => { }));
        return r;
    }

    /// 8 个竖排功能钮的回调。已实装的：切换仓库（双源视图，联机顺手
    /// 守卫拉一次 wh）、入库(F)（选择模式开关）、整理（离线
    /// `g.SortInventory`，联机背包顺序由服务端保管不动）。加锁/使用(A)/
    /// 放入图鉴/一键熔炼/卖出(X) 尚无对应玩法后端，保持诚实占位
    /// （提示进聊天，不假装成功）。下标 = 上方 labels[] 顺序。
    void BagAct(int idx) {
        bool online = net.Self() != null;
        if (idx == 0) {
            this.whMode = !this.whMode;
            this.whPick = false;
            if (online) { net.MaybeRefreshWh(); }
            this.Rebuild();
            return;
        }
        if (idx == 1) {
            if (this.whMode) {
                string tip = "仓库视图：点物品取回背包；入库请先返回背包。";
                if (online) { net.AddChat("[系统]", tip); } else { g.Log(tip); }
                return;
            }
            this.whPick = !this.whPick;
            string msg = this.whPick ? "入库模式：点背包物品整叠存入仓库，再点「入库中…」退出。"
                                     : "入库模式已关闭。";
            if (online) { net.AddChat("[系统]", msg); } else { g.Log(msg); }
            this.Rebuild();
            return;
        }
        if (idx == 4) {
            if (online) { net.AddChat("[系统]", "联机背包顺序由服务器保管，无需整理。"); return; }
            g.SortInventory(this.whMode);
            this.Rebuild();
            return;
        }
        string stub = idx == 2 ? "加锁/解锁。"
            : idx == 3 ? "使用(A)。"
            : idx == 5 ? "放入图鉴。"
            : idx == 6 ? "一键熔炼。" : "卖出(X)。";
        if (online) { net.AddChat("[系统]", stub); return; }
        g.Log(stub);
    }
}
