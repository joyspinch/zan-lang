using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 28「帮助」——照原版还原（`帮助.png`）。
///
///   · 左：竖排分类列表 12 项（10 个分类 + 2 个空槽；`传说塔`/`符文之语` 带红
///     `new` 上标，选中态整块蓝底白字）
///   · 右上：两段标题 + 四行正文（正文里的青色小标题 / 黄色公式是同一条里
///     换色的，靠一整行拆成多个 `Label` 排，见 `HelpBody()`）
///   · 右下：`传统装备 | 公式` 两列表格（表头 61 设备、行节距 49.3 设备；
///     原版最后一行被主区底边裁掉，这里留一个空行照抄）
///
/// 左列走共享组件 `TableUi.ListColOf`（按「列表类页面写一个组件把数据列出来」
/// 的口径），表格走 `TblHeadAt/TblCellClsAt`；本页只给数据与类名。
/// 配色为原版实测：选中 `#00679b`、常态 `#2b2b2b`、正文 `#dcdcdc`、
/// 小标题/物品名青、公式里的 `13#/14#` 黄（**原版是黄字加下划线**——本模板
/// 的文字控件不吃 `text-decoration`，只还原颜色，登记为已知偏差）。
partial class LegendApp {

    /// 一个帮助分类（空槽 name 为 ""）。
    class HelpCat {
        string name;
        bool isNew;
    }

    static HelpCat HelpCatOf(string name, bool isNew) {
        HelpCat c = new HelpCat();
        c.name = name; c.isNew = isNew;
        return c;
    }

    /// 12 个分类（照 `帮助.png` 逐格抄；后两格原版是空槽）。
    /// 只有「符文之语」有原版对照内容，其余分类点了只切选中态 + 记一句。
    static List<HelpCat> HelpCats() {
        List<HelpCat> v = new List<HelpCat>();
        v.Add(HelpCatOf("新手帮助", false));
        v.Add(HelpCatOf("常见问题", false));
        v.Add(HelpCatOf("进阶玩法", false));
        v.Add(HelpCatOf("公式算法", false));
        v.Add(HelpCatOf("地图BOSS", false));
        v.Add(HelpCatOf("交易权限", false));
        v.Add(HelpCatOf("传说塔", true));
        v.Add(HelpCatOf("红包", false));
        v.Add(HelpCatOf("符文之语", true));
        v.Add(HelpCatOf("会员介绍", false));
        v.Add(HelpCatOf("", false));
        v.Add(HelpCatOf("", false));
        return v;
    }

    /// 当前选中分类（默认第 9 格「符文之语」，与原版对照图一致）。
    int helpSel = 8;

    /// 正文一行（`title` = true 是青蓝小标题）。分段用的是共享组件
    /// `TableUi.TextSeg/TextSegOf`（帮助/铁匠铺/寻宝都是「一段里嵌几个彩色词」）。
    class HelpLine {
        bool title;
        List<TextSeg> segs;
    }

    static HelpLine HelpTitle(string t) {
        HelpLine l = new HelpLine();
        l.title = true; l.segs = new List<TextSeg>();
        l.segs.Add(TextSegOf(t, "help-title"));
        return l;
    }

    static HelpLine HelpText(List<TextSeg> segs) {
        HelpLine l = new HelpLine();
        l.title = false; l.segs = segs;
        return l;
    }

    /// 符文之语档的正文（照 `帮助.png` 逐字抄；青=小标题/术语，黄=公式）。
    static List<HelpLine> HelpBody() {
        List<HelpLine> v = new List<HelpLine>();
        v.Add(HelpTitle("1、符文之语是什么？"));
        List<TextSeg> l1 = new List<TextSeg>();
        l1.Add(TextSegOf("符文之语", "help-k"));
        l1.Add(TextSegOf("是指数字#符文随机组合并生成出来的物品公式称之为符文之语。", "help-txt"));
        v.Add(HelpText(l1));
        List<TextSeg> l2 = new List<TextSeg>();
        l2.Add(TextSegOf("符文之语", "help-k"));
        l2.Add(TextSegOf("具有严格的顺序性，不能随意放置。", "help-txt"));
        v.Add(HelpText(l2));
        v.Add(HelpTitle("2、符文升级与降级？"));
        List<TextSeg> l3 = new List<TextSeg>();
        l3.Add(TextSegOf("符文升级：", "help-k"));
        l3.Add(TextSegOf("3个同号符文可以升级成一个高级符文，例如：", "help-txt"));
        l3.Add(TextSegOf("1#+1#+1#=2#", "help-hl"));
        v.Add(HelpText(l3));
        List<TextSeg> l4 = new List<TextSeg>();
        l4.Add(TextSegOf("符文降级：", "help-k"));
        l4.Add(TextSegOf("2#", "help-hl"));
        l4.Add(TextSegOf("或以上的符文 + 黑铁矿石 *10=低一号的符文。", "help-txt"));
        v.Add(HelpText(l4));
        return v;
    }

    /// 公式表一行（`name` 为空 = 原版那种「只有公式、没有传统装备名」的续行）。
    class HelpFormula {
        string name;
        string formula;
    }

    static HelpFormula HelpFormulaOf(string n, string f) {
        HelpFormula r = new HelpFormula();
        r.name = n; r.formula = f;
        return r;
    }

    /// 公式表 9 行（照图逐行抄；原版第 10 行被主区底边裁得只剩字顶，留空）。
    static List<HelpFormula> HelpTable() {
        List<HelpFormula> v = new List<HelpFormula>();
        v.Add(HelpFormulaOf("传说武器", "赤血魔剑 + 传说矿石*2000 + 13#"));
        v.Add(HelpFormulaOf("传说男衣", "城主战袍(男) + 传说矿石*2000 + 13#"));
        v.Add(HelpFormulaOf("传说女衣", "城主战袍(女) + 传说矿石*2000 + 13#"));
        v.Add(HelpFormulaOf("形态增长", "传说装备[第一形态] + 龙珠1★*100 + 13#"));
        v.Add(HelpFormulaOf("", "每个形态需要同等级的加龙珠*100和一颗13#号"));
        v.Add(HelpFormulaOf("最终传说装备", "传说装备[第九形态] + 龙珠9★*100 + 13#"));
        v.Add(HelpFormulaOf("传说洗炼", "传说[第九形态] + 传说矿石*2000 + 14#"));
        v.Add(HelpFormulaOf("", "武器(攻击天赋50%-80%) 男衣(防御30%-80%) 女衣(魔防30%-80%)"));
        v.Add(HelpFormulaOf("", ""));
        return v;
    }

    void BuildHelpPage() {
        List<HelpCat> cats = HelpCats();
        List<Panel> makers = new List<Panel>();
        for (int i = 0; i < cats.Count; i = i + 1) {
            makers.Add(HelpTabItem(cats[i]));
        }

        Panel body = Panel.Column(); body.Class = "help-page";
        body.Pad(0); body.Gap(0); body.Grow(); content.With(body);
        Panel row = Panel.Row(); row.Pad(0); row.Gap(0);
        row.Padding(Spec.HpPadT(), 0, 0, Spec.HpPadL()); body.With(row);
        row.With(ListColOf(makers, Spec.HpTabW(), Spec.HpTabH(), Spec.HpTabGap(),
            "help-tab", "help-tab-on", helpSel, (int i) => { HelpPick(i, cats); }));
        row.With(SpacerW(Spec.HpTabToBody()));
        Panel right = Panel.Column(); right.Pad(0); right.Gap(0);
        right.Grow(); row.With(right);
        right.With(HelpInfo());
        right.With(HelpFormulaTable());
    }

    /// 一个分类项：名字 + （可选）红色 `new` 上标。
    Panel HelpTabItem(HelpCat c) {
        Panel r = Panel.Row(); r.Pad(0); r.Gap(Spec.Px(1));
        r.With(Text(c.name, "help-tab-t", 0));
        if (c.isNew) { r.With(Text("new", "help-new", 0)); }
        return r;
    }

    void HelpPick(int i, List<HelpCat> cats) {
        if (cats[i].name == "") { return; }
        helpSel = i;
        if (i != 8) {
            HelpSay("「" + cats[i].name + "」本版没有原版对照内容，暂只展示「符文之语」档。");
        }
        BuildPage(); Refresh();
    }

    /// 右上：标题 + 正文行。
    Panel HelpInfo() {
        Panel col = Panel.Column(); col.Pad(0); col.Gap(0);
        col.Prefer(Spec.HpBodyW(), Spec.HpInfoH());
        List<HelpLine> lines = HelpBody();
        for (int i = 0; i < lines.Count; i = i + 1) {
            HelpLine l = lines[i];
            col.With(TextSegRow(l.segs, "help-row",
                                l.title ? Spec.HpTitleH() : Spec.HpLineH()));
        }
        return col;
    }

    /// 右下：`传统装备 | 公式` 两列表（表体每行下一条行线，走容器底色露出）。
    ///
    /// 外面套一层 Row 是有原因的：Column 的子节点沿列轴停靠时**必定占满整行
    /// 宽**，直接挂在右栏下面时表头蓝带会被拉到页面右沿（实测 1511，原版
    /// 1429）。放进 Row 后列宽按 `prefW` 取，正好 = 两列宽之和 792 设备。
    Panel HelpFormulaTable() {
        Panel outer = Panel.Row(); outer.Pad(0); outer.Gap(0);
        Panel col = Panel.Column(); col.Pad(0); col.Gap(0);
        outer.With(col);

        List<string> heads = new List<string>();
        heads.Add("传统装备"); heads.Add("公式");
        List<int> ws = new List<int>();
        ws.Add(Spec.HpCol0W()); ws.Add(Spec.HpCol1W());
        col.With(TblHeadAt(heads, ws, Spec.HpHeadH(), 0,
                           Spec.HpColPadL()));

        List<HelpFormula> rows = HelpTable();
        for (int r = 0; r < Spec.HpRows(); r = r + 1) {
            HelpFormula f = r < rows.Count ? rows[r] : null;
            Panel row = Panel.Row(); row.Class = "help-frow";
            row.Pad(0); row.Gap(0); row.Prefer(0, Spec.HpRowH());
            string n = f != null ? f.name : "";
            string fm = f != null ? f.formula : "";
            row.With(TblCellClsAt(n, "help-c0", Spec.HpCol0W(), "help-cell",
                                  Spec.HpRowH()));
            row.With(TblCellClsAt(fm, "help-c1", Spec.HpCol1W(), "help-cell",
                                  Spec.HpRowH()));
            col.With(row);
        }
        return outer;
    }

    /// 玩法未接（帮助是纯说明页，点分类只切选中态）：按本模板惯例给一句反馈。
    void HelpSay(string msg) {
        if (net.Self() != null) { net.AddChat("[系统]", msg); return; }
        g.Log(msg);
    }
}
