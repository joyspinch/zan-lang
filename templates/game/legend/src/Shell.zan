using System;
using Gui;
using Gui.Widget;
using Legend;

// 左栏「角色信息」+ 右侧聊天区 + 底部状态行。
// 原版实测结构见 REFERENCE_AUDIT.md「左栏」一节。
partial class LegendApp {
    /* ---- 左栏 ----
       逐项实测（Spec 里的 Hero、Exp、Stat 一组 getter 的注释写了出处），全部按
       「内容区相对逻辑像素」落位：整块不用 Gap 自适应，而是给出每段的
       固定高度，这样行距才和原版一样是等距的。 */
    void BuildProfile(Panel side) {
        side.Class = "profile";
        PlayerState ps = net.SelfState();

        /* 头像块：头像 64×57，右侧三行（名字/称谓/行会）与头像等高。 */
        Panel head = Panel.Row(); head.Class = "hero-head";
        head.Padding(Spec.HeroTopPad(), 0, 0, Spec.HeroPadL()); head.Gap(Spec.HeroTextGap());
        head.Prefer(0, Spec.HeroHeadH()); side.With(head);
        Image avatar = new Image("assets/ui/00043.jpg", "角色", "cover");
        avatar.Prefer(Spec.HeroAvatarW(), Spec.HeroAvatarH()); head.With(avatar);
        Panel headCol = Panel.Column(); headCol.Gap(0); headCol.Grow(); head.With(headCol);
        string nm = (ps != null && ps.Name.Length > 0) ? ps.Name : "无名";
        heroName = Text(nm, "hero-name", 0);
        heroName.Prefer(0, Spec.HeroNameH()); headCol.With(heroName);
        heroTitle = Text("称谓：无", "hero-kv", 0);
        heroTitle.Prefer(0, Spec.HeroKvH()); headCol.With(heroTitle);
        heroGuild = Text("行会：无", "hero-kv", 0);
        heroGuild.Prefer(0, Spec.HeroKvH()); headCol.With(heroGuild);

        /* 经验行：「经验：」+ 条（数值压在条内居中）+ 升级钮。 */
        Panel expRow = Panel.Row(); expRow.Class = "hero-exp";
        expRow.Padding(0, Spec.Px(12), 0, Spec.HeroPadL()); expRow.Gap(0);
        expRow.Prefer(0, Spec.ExpRowH()); side.With(expRow);
        Panel expLabel = Panel.Row(); expLabel.Pad(0); expLabel.Prefer(Spec.ExpLabelW(), 0);
        expRow.With(expLabel);
        Label ek = Text("经验：", "el-exp", 0); ek.Grow(); expLabel.With(ek);
        Panel barBox = Panel.Row(); barBox.Class = "exp-box";
        barBox.Prefer(Spec.ExpBarW(), Spec.ExpBarH()); expRow.With(barBox);
        expBar = new Progress(0, 1); expBar.Prefer(Spec.ExpBarW(), Spec.ExpBarH());
        barBox.With(expBar);
        expText = Text("0/0", "exp-over", 0); expText.Grow(); barBox.With(expText);
        Panel expFill = Panel.Row(); expFill.Grow(); expRow.With(expFill);
        expRow.With(BtnSized("升级", "level-up", 32, 19, () => { }));

        /* 数值区：5 行 × 24；左列定宽 StatColW（右列正好起在第 133 逻辑像素），
           第 4、5 行的右半是「每日福利 / 充值 刷新」——与数值行逐行对齐。 */
        Panel grid = Panel.Column(); grid.Class = "hero-grid";
        grid.Pad(0); grid.Gap(0);
        grid.Prefer(0, Spec.StatRowH() * 5); side.With(grid);
        Panel r1 = StatRow(grid);
        heroHp = StatCell(r1, "生命：", "kv-hp", "0", true);
        heroFame = StatCell(r1, "声望：", "kv-fame", "0", false);
        Panel r2 = StatRow(grid);
        heroMp = StatCell(r2, "法力：", "kv-mp", "0", true);
        heroMerit = StatCell(r2, "战功：", "kv-merit", "0", false);
        Panel r3 = StatRow(grid);
        heroLv = StatCell(r3, "等级：", "kv-lv", "1级", true);
        heroSpirit = StatCell(r3, "灵符：", "kv-spirit", "0", false);
        Panel r4 = StatRow(grid);
        heroGold = StatCell(r4, "金币：", "kv-gold", "0", true);
        Panel q1 = Panel.Row(); q1.Grow(); q1.Gap(0); r4.With(q1);
        Panel q1f = Panel.Row(); q1f.Grow(); q1.With(q1f);
        q1.With(BtnSized("每日福利", "daily", 65, 19, () => { }));
        Panel r5 = StatRow(grid);
        heroYuan = StatCell(r5, "元宝：", "kv-yuan", "0", true);
        Panel q2 = Panel.Row(); q2.Grow(); q2.Gap(Spec.Px(5)); r5.With(q2);
        Panel q2f = Panel.Row(); q2f.Grow(); q2.With(q2f);
        q2.With(BtnSized("充值", "recharge", 28, 19, () => { }));
        q2.With(BtnSized("刷新", "refresh", 28, 19, () => { BuildPage(); Refresh(); }));

        /* 分隔线 → 信息流（一直铺到底簇上沿）。 */
        Panel sep = Panel.Row(); sep.Class = "side-sep";
        sep.Prefer(0, Spec.SepH()); side.With(sep);
        Panel feedBox = Panel.Column(); feedBox.Class = "hero-feed";
        feedBox.Pad(0); feedBox.Gap(0);
        feedBox.Grow(); side.With(feedBox);
        newsFeed = Text("", "hero-feed-text", 0);
        newsFeed.Grow(); feedBox.With(newsFeed);
    }

    // 数值区一行（高 StatRowH；左右留白与经验行一致，行内两列对齐）。
    Panel StatRow(Panel grid) {
        Panel r = Panel.Row(); r.Class = "hero-row";
        r.Padding(0, Spec.Px(7), 0, Spec.HeroPadL()); r.Gap(0);
        r.Prefer(0, Spec.StatRowH()); grid.With(r);
        return r;
    }

    // 数值格：彩色标签（「生命：」）+ 白色数值。left=true 用定宽左列，
    // 否则占满余下宽度（右列的文字因此逐行对齐在 StatColW 处）。
    Label StatCell(Panel row, string kw, string cls, string v, bool left) {
        Panel cell = Panel.Row(); cell.Pad(0); cell.Gap(0);
        if (left) { cell.Prefer(Spec.StatColW(), 0); } else { cell.Grow(); }
        row.With(cell);
        Label k = Text(kw, "hero-kv " + cls, 0);
        k.Prefer(Spec.StatLabelW(), 0); cell.With(k);
        Label val = Text(v, "hero-kv hero-vv", 0);
        val.Grow(); cell.With(val);
        return val;
    }

    /* ---- 右侧聊天区 ----
       面板满高（内容 y 0..610）；底部输入行与左栏底簇同一水平线。 */
    RichText chatText;
    Panel chatPanel_;
    void BuildChat(Panel panel) {
        chatPanel_ = panel;
        panel.Class = "chat-panel"; panel.Pad(Spec.Px(6)); panel.Gap(Spec.Px(4));
        /* 富文本聊天：多色段（[聊天]灰 + 玩家名配色 + 正文白）在
           一段流式排版里折行不断色，Label 拼不出来。 */
        chatText = new RichText();
        chatText.SetFontPx(Spec.ChatFontPx());
        chatText.scrollBar = new SignalInt(0);
        chatText.Grow(); panel.With(chatText);
        /* 输入行贴内容区底 */
        Panel tail = Panel.Column(); tail.Prefer(0, Spec.BotStatBottom());
        tail.AnchorBottom(); panel.Add(tail);
        Panel sendRow = Panel.Row(); sendRow.Class = "chat-send-row";
        sendRow.Gap(Spec.Px(4)); sendRow.Prefer(0, Spec.ChatSendH());
        sendRow.AnchorBottom(); panel.Add(sendRow);
        Input box = new Input("说点什么"); box.Grow(); sendRow.With(box);
        sendRow.With(Btn("发送", "chat-send", () => { }));
    }

    /* ---- 每帧刷新左栏数值（标签是定色定宽的文字，只有数值段在变）---- */
    void Refresh() {
        /* 聊天先刷：离线（Self 为空）时聊天区也要跟着 SeedDemoChat 走。 */
        if (chatText != null) { chatText.SetMarkup(net.ChatDump()); }
        PlayerState ps = net.SelfState();
        if (net.Self() == null || ps == null) { return; }
        if (heroHp != null) { heroHp.Text = Rules.N(ps.Hp); }
        if (heroMp != null) { heroMp.Text = Rules.N(ps.Mp); }
        if (heroLv != null) { heroLv.Text = Rules.N(ps.Level) + "级"; }
        if (heroGold != null) { heroGold.Text = Rules.N(ps.Gold); }
        if (heroYuan != null) { heroYuan.Text = Rules.N(ps.Ingots); }
        if (heroFame != null) { heroFame.Text = Rules.N(ps.Fame); }
        if (heroMerit != null) { heroMerit.Text = Rules.N(ps.Merit); }
        if (heroSpirit != null) { heroSpirit.Text = Rules.N(ps.Spirit); }
        if (heroName != null) { heroName.Text = ps.Name.Length > 0 ? ps.Name : "无名"; }
        long exp = ps.Exp; long expNext = ps.ExpNext;
        if (expBar != null) {
            int pct = expNext > 0 ? (int)((exp * 100) / expNext) : 0;
            if (pct < 0) { pct = 0; } if (pct > 100) { pct = 100; }
            expBar.percent = pct;
        }
        if (expText != null) { expText.Text = Rules.N(exp) + "/" + Rules.N(expNext); }
        if (newsFeed != null) { newsFeed.Text = net.FeedDump(); }

    }

    /* ---- 登录窗（占位，稍后按原版三窗流程还原）---- */
    void ConnectPublished(string dataDir) {
        string addr = KnownFolders.GetEnv("LEGEND_SERVER");
        if (addr.Length == 0) {
            string f = dataDir + "/server.txt";
            if (File.Exists(f)) {
                string line = File.ReadAllText(f).Trim();
                int bar = line.IndexOf("|");
                if (bar >= 0) { srvPass = line.Substring(bar + 1, line.Length - bar - 1); line = line.Substring(0, bar); }
                addr = line;
            }
        }
        if (addr.Length == 0) { addr = srvAddr; }
        net.ConnectAddr(addr, srvPass);
    }
}
