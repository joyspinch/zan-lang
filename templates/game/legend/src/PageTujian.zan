using System;
using Gui;
using Gui.Widget;
using Legend;

// 页 23「图鉴」——照原版逐像素还原（`mir2/mir/图鉴.png`）。
// 版式与交易市场同一副外框（374..1491 × 164..879，`Spec.Mk*` 复用），但
// 本页**没有表头带、没有左栏**：整框一面 `#1d2633`，内容直接摆上去——
// · 主区 6 组卡阵：每组 = 组标题行（《图鉴：祈祷》 系数：0 【属性】…，
// 灰 `#9aa0a8`，标题/系数/属性三段按原版列位 401/579/702 分格）
// + 9 枚装备格（`00211.png` 拉伸 67×60、格缝 16，空槽照画）。
// 组节距 115：首组标题字心 y192、首行格顶 211（与 Mk* 表格同格起）。
// · 右栏 1160..1489：神兵图鉴 艺术字横图（`00208.jpg`，225×50）+ 7 条
// 说明（浅灰 `#c4c6ca`，折行按原版断点手排 `\n`，行距取字体默认）
// + 底部右侧分页（上一页 / 1/9 / 下一页）。
// 数据一行一实体（`TjGroup`）：组名/属性行照原图抄录；槽内装备取
// items.csv 同名套装——祈祷 5 件全部对上原版槽位；沃玛/祖玛原版套装
// 不在库内，用同期装备近似填充（原版素材里套装件共用图，跨组复用同
// 库内图标是常态）。翻页共 9 页，其余页数据未接。
// 已知偏差：原版说明文字里「神兵图鉴/激活/无法取出」等关键字是红绿
// 多色，标准库 `Label` 只支持单色，整段取浅灰一色（`§5.3g` 同惯例登记）。
partial class LegendApp {
    // 一组图鉴：组名 + 属性行 + 9 枚槽（0 = 空槽照画框）。
    class TjGroup {
        string name;  // 「祈祷」
        string attrs;  // 「【属性】防御：0-0」（离线静态对照）
        string kind;  // 服务端加成通道：def=防御，atk=攻击
        int[] items;  // 装备 id（items.csv），0 = 空槽
        int[] defs;  // 该组定义格（静态），0 = 非定义格不接受放入
        int gno;  // 服务端组号（0 基）
        int coeff;  // 服务端系数（已放格数 ×10，离线 0）
        int done;  // 服务端 complete（集齐激活，离线 0）
        string TitleText() { return "《图鉴：" + name + "》"; }
    }

    // 第 1 页 6 组（照 `图鉴.png` 逐行抄录；共 9 页，其余页数据未接）。
    // 套装对照：祈祷之刃/手镯/项链/戒指/头盔 = 124..127/128；
    // 沃玛组用同期武器 9 件近似；祖玛组用同期防具首饰 9 件近似；
    // 圣战 166..169、法神 170..173、天尊 174..177。
    // kind 是服务端加成通道：法神/天尊原版标签是魔法/道术，但战斗数值
    // 没有魔道通道，服务端把它们的套装加成落攻击——属性行文案仍照原版，
    // 只把首个数值换成真加成（用户裁定：文案保原版，不因通道改标）。
    static List<TjGroup> tjData = null;
    static List<TjGroup> TjData() {
        if (tjData != null) { return tjData; }
        List<TjGroup> v = new List<TjGroup>();
        v.Add(TjGroupOf("祈祷", "def", "【属性】防御：0-0",
                        124, 125, 126, 127, 128, 0, 0, 0, 0));
        v.Add(TjGroupOf("沃玛", "atk", "【属性】攻击：0-0 魔法：0-0 道术：0-0",
                        45, 33, 32, 117, 119, 136, 135, 121, 122));
        v.Add(TjGroupOf("祖玛", "atk", "【属性】攻击：0-0 魔法：0-0 道术：0-0",
                        123, 142, 146, 145, 129, 54, 91, 172, 177));
        v.Add(TjGroupOf("圣战", "atk", "【属性】攻击：0-0",
                        166, 167, 168, 169, 0, 0, 0, 0, 0));
        v.Add(TjGroupOf("法神", "atk", "【属性】魔法：0-0",
                        170, 171, 172, 173, 0, 0, 0, 0, 0));
        v.Add(TjGroupOf("天尊", "atk", "【属性】道术：0-0",
                        174, 175, 176, 177, 0, 0, 0, 0, 0));
        tjData = v;
        return v;
    }

    static TjGroup TjGroupOf(string name, string kind, string attrs, int i0, int i1, int i2, int i3,
                             int i4, int i5, int i6, int i7, int i8) {
        TjGroup g = new TjGroup();
        g.name = name; g.kind = kind; g.attrs = attrs;
        g.items = new int[] { i0, i1, i2, i3, i4, i5, i6, i7, i8 };
        g.defs = new int[] { i0, i1, i2, i3, i4, i5, i6, i7, i8 };
        return g;
    }

    // 当前组列表：在线 = 服务端 tj.groups（已放格覆盖，未放格空框），
    // 离线 = 原版对照（整组抄录展示）。克隆行覆盖，不动静态缓存。
    List<TjGroup> TjRows() {
        List<TjGroup> rows = TjData();
        if (net.Self() == null || net.TypedTj() == null || net.TypedTj().Groups.Count == 0) { return rows; }
        List<TjGroupItem> groups = net.TypedTj().Groups;
        List<TjGroup> v = new List<TjGroup>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            TjGroup src = rows[i];
            TjGroup g = TjGroupOf(src.name, src.kind, src.attrs, 0, 0, 0, 0, 0, 0, 0, 0, 0);
            g.gno = i;
            for (int k = 0; k < 9; k = k + 1) { g.items[k] = 0; }
            if (i < groups.Count) {
                TjGroupItem m = groups[i];
                for (int k = 0; k < m.Slots.Count && k < 9; k = k + 1) {
                    int it = m.Slots[k];
                    if (it > 0) { g.items[k] = it; }
                }
                g.coeff = m.Coeff;
                g.done = m.Complete;
            }
            v.Add(g);
        }
        return v;
    }

    // 右栏 7 条说明（照 `图鉴.png` 逐行抄录，`\n` 按原版断点手排；
    // 条间空一行）。原版关键字多色，这里单色近似。
    static string TjRules() {
        return "1、集齐神兵图鉴中任意组图鉴要求的装\n备，就可以激活相对应的属性；\n\n" +
               "2、放入神兵图鉴的装备无法取出，只能\n用更高系数的装备替换；\n\n" +
               "3、在同一组图鉴中，图鉴品质取决于最\n低品质的装备，图鉴品质会直接影响图鉴\n属性加成；\n\n" +
               "4、所有图鉴的属性都会以被动属性加成\n在人物属性中；\n\n" +
               "5、没有系数的装备无法放入神兵图鉴；\n\n" +
               "6、加成的属性=系数*基数/10，每组神兵\n的基数不同；\n\n" +
               "7、巅峰之后的图鉴装备通过铁匠铺-符文\n之语洗练系数，不要用黑铁强化！可以洗\n练的满系数=装备等级/5，推荐洗到低于\n满系数10以内";
    }

    void BuildTujianPage() {
        if (net.Self() != null) { net.MaybeRefreshTj(); }
        Panel frame = Panel.Column(); frame.Class = "mk-frame";
        frame.Pad(0); frame.Gap(0);
        frame.Prefer(0, Spec.MkFrameH());
        frame.Padding(Spec.MkFramePadT(), Spec.MkFramePadR(), 0, Spec.MkFramePadL());
        content.With(frame);

        Panel mid = Panel.Row(); mid.Class = "mk-mid mk-fill";
        mid.Pad(0); mid.Gap(0);
        mid.With(TjGrid());
        mid.With(TjRight());
        frame.With(mid);
    }

    // 主区：6 组 = 组标题行 + 9 枚装备格
    Panel TjGrid() {
        Panel col = Panel.Column(); col.Class = "mk-fill";
        col.Pad(0); col.Gap(0);
        col.With(TblPad(Spec.TjGridTopPad()));
        List<TjGroup> groups = TjRows();
        for (int i = 0; i < groups.Count; i = i + 1) {
            col.With(TjTitleRow(groups[i]));
            col.With(TblPad(Spec.TjTitleToSlots()));
            col.With(TjSlotRow(groups[i]));
            if (i + 1 < groups.Count) { col.With(TblPad(Spec.TjGroupPadB())); }
        }
        return col;
    }

    // 属性行：离线 = 原版静态对照；在线 = 原版文案不动，只把首个
    // 「0-0」换成真加成（规则键 tj_baseN：集齐组 +base/10，与
    // Fight.Def/Atk 的口径一致）。法神/天尊的加成服务端落攻击，但
    // 文案保持原版的魔法/道术——用户裁定：文案保原版，不因通道改标。
    string TjAttrsOf(TjGroup g) {
        if (net.Self() == null) { return g.attrs; }
        int b = g.done == 1 ? GameTables.Value("tj_base" + Convert.ToString(g.gno + 1)) / 10 : 0;
        string num = Convert.ToString(b) + "-" + Convert.ToString(b);
        int at = g.attrs.IndexOf("0-0");
        if (at < 0) { return g.attrs; }
        return g.attrs.Substring(0, at) + num + g.attrs.Substring(at + 3);
    }

    // 组标题行：《图鉴：X》（401）+ 系数：0（579）+ 【属性】…（702 起）。
    Panel TjTitleRow(TjGroup g) {
        Panel row = Panel.Row(); row.Class = "mk-fixed"; row.Pad(0); row.Gap(0);
        row.Prefer(0, Spec.TjTitleH());
        row.Padding(0, 0, 0, Spec.TjSlotPadL());

        Panel c1 = Panel.Row(); c1.Class = "mk-cell-l"; c1.Pad(0);
        c1.Prefer(Spec.TjTitle1W(), Spec.TjTitleH());
        c1.With(Text(g.TitleText(), "tj-line", 0));
        row.With(c1);

        Panel c2 = Panel.Row(); c2.Class = "mk-cell-l"; c2.Pad(0);
        c2.Prefer(Spec.TjTitle2W(), Spec.TjTitleH());
        c2.With(Text("系数：" + Rules.N(g.coeff), "tj-line", 0));
        row.With(c2);

        Panel c3 = Panel.Row(); c3.Class = "mk-cell-l mk-fill"; c3.Pad(0);
        c3.Prefer(0, Spec.TjTitleH());
        c3.With(Text(TjAttrsOf(g), "tj-line", 0));
        row.With(c3);
        return row;
    }

    // 9 枚装备格：00211 底拉伸 67×60，空槽照画（原版空位也是格框）。
    // 行走手动摆位（停靠列会把子项宽度均分压小，实测槽被压成 62 设备），
    // 图标 fit=none 原尺寸居中——原版槽内图标不放大。
    Panel TjSlotRow(TjGroup g) {
        Panel row = Panel.Row(); row.Class = "mk-fixed";
        row.Pad(0); row.Gap(0);
        row.Prefer(0, Spec.TjSlotH());
        for (int i = 0; i < g.items.Length; i = i + 1) {
            string art = g.items[i] > 0 ? ItemArtById(g.items[i]) : "";
            int pick = i;
            Panel cell = Panel.Row(); cell.Pad(0);
            cell.Prefer(Spec.TjSlotW(), Spec.TjSlotH());
            Image bg = new Image("assets/ui/00211.png", "格底", "stretch");
            bg.Grow(); cell.Add(bg);
            if (art.Length > 0) {
                Image ic = new Image(art, "装备", "none");
                ic.Grow(); cell.Add(ic);
            }
            /* 在线空的定义格可点放入：服务端校验背包与格位，放入无法取出。 */
            if (g.defs[i] > 0 && g.items[i] == 0) {
                cell.OnClick(() => { TjPut(g, pick); });
            }
            cell.Float(Spec.TjSlotX(i), 0);
            row.Add(cell);
        }
        return row;
    }

    void TjPut(TjGroup grp, int slot) {
        if (net.Self() == null) { TjSay("图鉴收集：放入「" + grp.name + "」（离线模式）"); return; }
        net.TjPut(grp.gno, slot);
    }

    void TjSay(string msg) {
        if (net.Self() != null) { net.AddChat("[系统]", msg); return; }
        g.Log(msg);
    }

    // 右栏：神兵图鉴 艺术字 + 7 条说明 + 分页（1/9）
    Panel TjRight() {
        Panel col = Panel.Column(); col.Class = "mk-fixed";
        col.Pad(0); col.Gap(0); col.Prefer(Spec.TjRightW(), 0);

        Panel artCell = Panel.Row(); artCell.Class = "mk-fixed"; artCell.Pad(0);
        artCell.Prefer(0, Spec.TjArtH());
        artCell.Padding(0, 0, 0, Spec.TjArtPadL());
        Image art = new Image("assets/ui/00208.jpg", "神兵图鉴", "fill");
        art.Grow(); artCell.Add(art);
        col.With(artCell);

        Panel rules = Panel.Row(); rules.Class = "mk-fixed"; rules.Pad(0);
        rules.Prefer(0, Spec.TjRulesH());
        rules.Padding(0, Spec.TjRulesPadR(), 0, Spec.TjRulesPadL());
        Label rl = Text(TjRules(), "tj-rule", 0);
        rl.wrap = true;
        rl.Grow(); rules.Add(rl);
        col.With(rules);

        Panel sp = Panel.Row(); sp.Class = "mk-fill"; sp.Pad(0); col.With(sp);

        Panel f = Panel.Row(); f.Class = "mk-foot mk-fixed";
        f.Pad(0); f.Gap(0);
        f.Prefer(0, Spec.MkFootH());
        f.Padding(0, Spec.TjFootPadR(), 0, 0);
        Panel fsp = Panel.Row(); fsp.Class = "mk-fill"; fsp.Pad(0); f.With(fsp);
        SignalInt pgSig = new SignalInt(1);
        Pagination pg = new Pagination(Spec.TjPages(), pgSig);
        pg.Class = "simple";
        pg.PrevText("上一页"); pg.NextText("下一页");
        pg.Named("tujian-pager");
        f.With(pg);
        col.With(f);
        return col;
    }
}
