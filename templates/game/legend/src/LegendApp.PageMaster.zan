using System;
using Gui;
using Gui.Widget;
using Legend;

// 页 11「师徒」——照原版还原（`师徒.png`）。
// 主区两块（坐标口径同页 15：`参考图坐标 − 内容框原点 (374,164)`）：
// ① **左绑定面板**（374 → 1101，宽 727）——纯控件页，**没有整张底图**：
// 顶行 `请输入对方名称：` + 输入框 + 灰色提示 `请输入对方完整的名字` +
// `[绑定师徒关系]`；中段左右两列各 6 个「键」格（参考图里值全是空的，
// 值由服务端下发）；下段 `今日师徒活跃度：` + 轨道 `0/100` +
// `[领取今日经验]`；末段 `师徒系统说明：` + 10 行正文。
// ② **右结伴名单**（1101 → 1490，宽 389）——**一份 10 行数据列表**：
// 头像 + `名字（巅峰N级）` + `徒弟: N人` + 一条按人数比例的条。
// 与用户口径一致（「列表类不是写一个组件列表输出即可吗」「很多数据最终都是靠
// 服务端下发的，现在是要做 UI 的准备工作」）：名单是**数据列表**——`MsMate`
// 只给「头像 / 名字 / 等级 / 徒弟数」，结构与字段定死、值先占位；条的长度按
// 人数比例算（实测线性：53 人 = 满格 300，每多 1 人 +5.64 设备）。
partial class LegendApp {

    // ---------------------------------------------------------------- 数据

    // 绑定输入草稿：`框.data = 字段` 实时绑定，控件重建值仍在。
    string msName = "";

    // 一个「键」格：键名 + 值（值空串 = 只画键；在线有服务端字段的键
    // 由页面填）。`cls` 决定键的颜色。
    class MsKey {
        string text;
        string cls;
        string value;
    }

    static MsKey MsKeyOf(string text, string cls) {
        MsKey k = new MsKey();
        k.text = text; k.cls = cls;
        return k;
    }

    // 结伴名单一行：`avatar` = `assets/ui/<avatar>.png` 的 5 位档号，
    // `level` = 巅峰等级，`cnt` = 徒弟人数，`tier` = 比例条色号（1..10）。
    class MsMate {
        string avatar;
        string name;
        int level;
        int cnt;
        int tier;
    }

    static MsMate MsMateOf(string avatar, string name, int level, int cnt,
                           int tier) {
        MsMate m = new MsMate();
        m.avatar = avatar; m.name = name; m.level = level; m.cnt = cnt;
        m.tier = tier;
        return m;
    }

    // 键的颜色按参考图逐行取样：橙 / 青 / 绿 / 粉紫 / 蓝紫 / 黄
    // （`ms-k1..6`）。左右两列的键名不同、颜色一一对应。
    static List<MsKey> MsKeys(bool left) {
        List<MsKey> v = new List<MsKey>();
        string a = left ? "师父名称" : "徒弟名称";
        string b = left ? "师父等级" : "徒弟等级";
        string d = left ? "师父ID" : "徒弟ID";
        string e = left ? "成功出师" : "拜师时间";
        v.Add(MsKeyOf(a + "：", "ms-k1"));
        v.Add(MsKeyOf(b + "：", "ms-k2"));
        v.Add(MsKeyOf("会员等级：", "ms-k3"));
        v.Add(MsKeyOf(d + "：", "ms-k4"));
        v.Add(MsKeyOf(e + "：", "ms-k5"));
        v.Add(MsKeyOf("最后离线：", "ms-k6"));
        return v;
    }

    // 师徒系统说明的 10 行正文。原版是网页客户端，**断点是确定的**——照参考图
    // 逐行抄（不是让引擎按宽度折行：字体微调会让断点漂）。
    static List<string> MsHelpLines() {
        List<string> v = new List<string>();
        v.Add("1、师徒系统可以促进玩家间的交流，能让新玩家快速融入游戏中；");
        v.Add("2、徒弟每天可以收获大量的经验，而师父则可以获得大量的声望和高级符文；");
        v.Add("3、师父每天挑战幻境挑战世界BOSS都会增加活跃度，活跃度达到100%时，徒弟领取储");
        v.Add("备经验翻倍，最高可以获得400%的升级所需经验的储备经验；");
        v.Add("4、徒弟每升10级，师父都可以获得声望奖励，根据徒弟的会员等级翻倍声望奖励，终");
        v.Add("身会员(小龙珠)提高2倍，超级终身会员(大龙珠)提高3倍；");
        v.Add("5、师父除了帮助徒弟快速入门，还应该给予徒弟物资上的帮助；");
        v.Add("6、如果对自己的徒弟/师父不满，可以单方面解除师徒关系，但在接下来24小时内，");
        v.Add("无法再次拜师/收徒，所以在绑定关系前请仔细想清楚；");
        v.Add("7、拜师条件：等级≤60级，出师条件：80级，师父条件：2转；");
        return v;
    }

    // ---------------------------------------------------------------- 版面

    void BuildMasterPage() {
        /* 在线进页才拉（Maybe 守卫：有缓存不再发，防 Bump 重建循环）。 */
        if (net.Self() != null) { net.MaybeRefreshMentor(); }
        Panel stage = Panel.Row(); stage.Class = "ms-page";
        stage.Pad(0); stage.Gap(0);
        content.With(stage);
        /* 主区舞台撑满内容框 */
        stage.Grow();
        stage.With(MasterBind());
        stage.With(MasterRoster());
    }

    // ---------------------------------------------------------------- 左：绑定

    Panel MasterBind() {
        Panel p = Panel.Row(); p.Class = "ms-bind";
        p.Pad(0); p.Gap(0);
        p.Prefer(Spec.MsBindW(), 0);

        // 左面板实测是**两块**：上块 #243040 深底信息卡（175..528，x 392..1090，
        // 卡内 506 处一条分隔线）盖住输入行+格阵+活跃度行，说明栏直接铺页底
        // #1d2633——不拆的话下半截会比原版亮一档。卡是绝对定位的背景层，
        // 先 add 保住 z 序，子项坐标一律仍按「相对左面板」给，不必整体平移。
        Panel top = Panel.Row(); top.Class = "ms-top";
        top.Pad(0); top.Gap(0);
        top.Prefer(Spec.MsBindW(), Spec.MsTopY() + Spec.MsTopH());
        top.Float(0, 0);
        p.Add(top);
        Panel card = Panel.Row(); card.Class = "ms-card";
        card.Pad(0); card.Gap(0);
        card.Prefer(Spec.MsTopW(), Spec.MsTopH());
        card.Float(Spec.MsTopX(), Spec.MsTopY());
        top.Add(card);

        // ① 顶行：标签 + 输入框 + 灰色提示 + 绑定钮
        MsLabelOn(top, "请输入对方名称：", "ms-label", Spec.MsPadL(), Spec.MsRowY(),
                  Spec.MsRowH());
        Input inp = new Input("");
        inp.Class = "ms-in";
        inp.Prefer(Spec.MsInputW(), Spec.MsRowH());
        /* `框.data = 字段` 实时绑定：控件重建值仍在（LoginWin 同法）。 */
        inp.data = this.msName;
        inp.Float(Spec.MsInputX(), Spec.MsRowY());
        top.Add(inp);
        MsLabelOn(top, "请输入对方完整的名字", "ms-ph", Spec.MsHintX(), Spec.MsRowY(),
                  Spec.MsRowH());
        Button go = BtnDev("绑定师徒关系", "ms-go", Spec.MsGoW(), Spec.MsRowH(),
                           () => { MasterBindGo(); });
        go.Float(Spec.MsGoX(), Spec.MsRowY());
        top.Add(go);

        // ② 两列各 6 个键格：在线「师父名称/成功出师」读服务端 mentor 实体
        // （master 名 + canTake），其余键服务端没有对应字段，保持空值
        // 不臆造；离线全空（占位）。
        MentorState mt = net.Self() != null ? net.TypedMentor() : null;
        List<MsKey> lk = MsKeys(true);
        if (mt != null) {
            string master = mt.Master;
            bool canTake = mt.CanTake;
            for (int i = 0; i < lk.Count; i = i + 1) {
                if (lk[i].text.StartsWith("师父名称")) { lk[i].value = master.Length > 0 ? master : "无"; }
                if (lk[i].text.StartsWith("成功出师")) { lk[i].value = canTake ? "可出师" : "未达成"; }
            }
        }
        MsKeyColumn(top, lk, Spec.MsPadL());
        MsKeyColumn(top, MsKeys(false), Spec.MsCell2X());

        // ③ 今日师徒活跃度：标签 + 轨道（0/100 居中）+ 领奖钮
        MsLabelOn(top, "今日师徒活跃度：", "ms-actlabel", Spec.MsPadL(),
                  Spec.MsActY(), Spec.MsRowH());
        MasterActivity(top);
        Panel sep = Panel.Row(); sep.Class = "ms-sep";
        sep.Pad(0); sep.Gap(0);
        sep.Prefer(Spec.MsTopW(), Spec.MsSepH());
        sep.Float(Spec.MsTopX(), Spec.MsSepY());
        p.Add(sep);

        // ④ 师徒系统说明
        MsLabelOn(p, "师徒系统说明：", "ms-htitle", Spec.MsHelpPadL(),
                  Spec.MsHelpTitleY(), 18);
        List<string> lines = MsHelpLines();
        for (int i = 0; i < lines.Count; i = i + 1) {
            Panel row = MsTextRow(lines[i], "ms-htext", Spec.MsBindW(), 18);
            row.Float(0, Spec.MsHelpFirstY() + i * Spec.MsHelpLineH());
            p.Add(row);
        }
        return p;
    }

    // 在左面板上手摆一个定高标签（标签不折行时在盒内垂直居中）。
    void MsLabelOn(Panel p, string text, string cls, int x, int y, int h) {
        Label l = Text(text, cls, 0);
        l.Prefer(Spec.MsBindW() - x, h);
        l.Float(x, y);
        p.Add(l);
    }

    // 一列键格：格面 25、缝 10（节距 35，实测格面 #1d2633 246..268、缝 #243040 270..279）。
    // 值画在格内右侧（在线有服务端字段的键才有值）。
    void MsKeyColumn(Panel p, List<MsKey> keys, int x) {
        for (int i = 0; i < keys.Count; i = i + 1) {
            Panel cell = Panel.Row(); cell.Class = "ms-cell";
            cell.Pad(0); cell.Gap(0);
            cell.Prefer(Spec.MsCellW(), Spec.MsCellH());
            cell.Padding(0, 0, 0, Spec.MsCellPadL());
            cell.With(Text(keys[i].text, keys[i].cls, 0));
            if (keys[i].value != null && keys[i].value.Length > 0) {
                Label v = Text(keys[i].value, "ms-kv", 0);
                v.Grow();
                cell.With(v);
            }
            cell.Float(x, Spec.MsCellTop()
                          + i * (Spec.MsCellH() + Spec.MsCellGap()));
            p.Add(cell);
        }
    }

    // 活跃度行：原版是一条深色轨道，`0/100` 居中，右侧领奖钮。
    // 进度值是服务端下发的（此处 0），条本身是标准库 `Progress`。
    void MasterActivity(Panel p) {
        Progress pb = new Progress(0, 1);
        pb.ShowText(false);
        pb.Class = "ms-act";
        pb.Prefer(Spec.MsTrackW(), Spec.MsRowH());
        pb.Float(Spec.MsTrackX(), Spec.MsActY());
        p.Add(pb);
        /* 轨道上的 `0/100`：Progress 的指示文本是**百分比**（`Format` 只吃
           `{0}`），画不出 `当前/上限`，所以数值用一个定宽居中行叠在上面。 */
        Panel num = Panel.Row(); num.Class = "ms-actnum";
        num.Pad(0); num.Gap(0);
        num.Prefer(Spec.MsTrackW(), Spec.MsRowH());
        num.With(Text("0/100", "ms-acttext", 0));
        num.Float(Spec.MsTrackX(), Spec.MsActY());
        p.Add(num);
        Button daily = BtnDev("领取今日经验", "ms-go", Spec.MsGoW(), Spec.MsRowH(),
                            () => { MasterDailyGo(); });
        daily.Float(Spec.MsGoX(), Spec.MsActY());
        p.Add(daily);
    }

    // 一行单段正文（左缩进 + 定高，供说明栏与名单复用共用的 `TextSegRow`）。
    Panel MsTextRow(string text, string cls, int wDevice, int hDevice) {
        List<TextSeg> segs = new List<TextSeg>();
        segs.Add(TextSegOf(text, cls));
        return TextSegRow(segs, "ms-textrow", hDevice);
    }

    // ---------------------------------------------------------------- 右：名单

    Panel MasterRoster() {
        Panel p = Panel.Row(); p.Class = "ms-roster";
        p.Pad(0); p.Gap(0);
        p.Grow();
        /* 全面消费服务端 mentor.mates 强类型实体（MentorMateItem），消除客户端假名单硬编码。 */
        MentorState mt = net.TypedMentor();
        List<MentorMateItem> mates = mt != null ? mt.Mates : null;
        int n = mates != null ? mates.Count : 0;
        if (n == 0) {
            Panel empty = Panel.Row(); empty.Class = "ms-mrow";
            empty.Pad(0); empty.Prefer(Spec.MsListW(), Spec.MsListRowH());
            Label t = Text("还没有人结伴：拜师/收徒后在这里上榜", "ms-name", 0);
            t.Prefer(Spec.MsListW(), 18);
            t.Float(Spec.MsNameX(), Spec.MsListTop() + Spec.Px(8));
            p.Add(empty);
            p.Add(t);
            return p;
        }
        string[] faces = new string[] { "00112", "00113", "00114", "00115", "00116" };
        int maxCnt = 1;
        for (int i = 0; i < n; i = i + 1) {
            int c = mates[i].Cnt;
            if (c > maxCnt) { maxCnt = c; }
        }
        for (int i = 0; i < n && i < 10; i = i + 1) {
            MentorMateItem m = mates[i];
            MsMate row = MsMateOf(faces[i % faces.Length], m.Name,
                m.Level, m.Cnt, (i % 10) + 1);
            Panel r = MsMateRow(row, maxCnt);
            r.Float(0, Spec.MsListTop() + i * Spec.MsListRowH());
            p.Add(r);
        }
        return p;
    }

    // 名单一行：头像 + `名字（巅峰N级）` + 右侧 `徒弟: N人` + 人数比例条。
    Panel MsMateRow(MsMate m, int maxCnt) {
        Panel row = Panel.Row(); row.Class = "ms-mrow";
        row.Pad(0); row.Gap(0);
        row.Prefer(Spec.MsListW(), Spec.MsListRowH());

        Image pic = new Image(MsAvatarPath(m), "头像", "cover");
        pic.Class = "ms-avatar";
        pic.Prefer(Spec.MsAvatarW(), Spec.MsAvatarH());
        pic.Float(Spec.MsAvatarX(), 0);
        row.Add(pic);

        Label nm = Text(m.name + "（巅峰" + m.level + "级）", "ms-name", 0);
        nm.Prefer(Spec.MsCntRight() - Spec.MsNameX(), 18);
        nm.Float(Spec.MsNameX(), Spec.MsNameY());
        row.Add(nm);

        // 右对齐的「徒弟: N人」——靠 flex 容器的 justify-content 贴右缘。
        Panel cnt = Panel.Row(); cnt.Class = "ms-cnt";
        cnt.Pad(0); cnt.Gap(0);
        cnt.Prefer(Spec.MsCntW(), 18);
        cnt.With(Text("徒弟: " + m.cnt + "人", "ms-cnttext", 0));
        cnt.Float(Spec.MsNameX(), Spec.MsNameY());
        row.Add(cnt);

        int pct = m.cnt * 100 / maxCnt;
        Progress bar = new Progress(pct, 1);
        bar.ShowText(false);
        bar.Class = "ms-bar ms-bar-" + m.tier;
        bar.Prefer(Spec.MsBarW(), Spec.MsBarH());
        bar.Float(Spec.MsNameX(), Spec.MsBarY());
        row.Add(bar);
        return row;
    }

    static string MsAvatarPath(MsMate m) {
        return "assets/ui/" + m.avatar + ".png";
    }

    // ---------------------------------------------------------------- 动作

    // 拜师：在线读输入框走服务端 mentor op（等级/门徒上限都在那边裁决）。
    void MasterBindGo() {
        if (net.Self() != null) {
            string name = this.msName.Trim();
            if (name.Length == 0) { MsSay("先输入对方的完整名字。"); return; }
            net.MentorBow(name);
            return;
        }
        MsSay("绑定师徒关系：等对方确认（结果待服务端下发）。");
    }

    // 领取：在线 = 服务端出师（canTake 与等级由服务端裁决，错误进聊天）。
    void MasterDailyGo() {
        if (net.Self() != null) { net.MentorTake(); return; }
        MsSay("领取今日经验：今日活跃度 0/100（结果待服务端下发）。");
    }

    void MsSay(string msg) {
        if (net.Self() != null) { net.AddChat("[系统]", msg); return; }
        g.Log(msg);
    }
}
