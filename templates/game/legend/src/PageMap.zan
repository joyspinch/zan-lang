using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 0「地图传送」——照原版还原，规格见 Spec / REFERENCE_AUDIT §5.4。
/// · 主体是一整块 4 列 × 5 行 = 20 张地图卡，一屏放完
/// · 每卡 160×70（= 地图素材原始尺寸），列距 20、行距 15
/// · 地图截图铺满整格，**图名压在卡片右上角**（白字黑描边）
/// · 只有「当前所在」那张是彩色，其余 19 张一律灰度
/// · 卡阵 + 页码行算一整块在主区居中，四边留白相等（用户要求「等边框」）
/// · 页码用标准库 Pagination（用户明确「分页有分页组件」），左缘与卡阵对齐
/// · 原版页码是两个自绘数字方块，这里是有意改用组件的偏离项
/// 原版这一页**没有**：价格、转生档位、气血天赋、进入/激活按钮、
/// 图谱积分、冲400补。一个都不要画。
partial class LegendApp {
    /* 地图卡素材路径：每张图有 3 档视觉（idx = (id-1)*3），
       gray=true 取 _g 灰度版——灰度是素材自带的，不做运行时滤镜。 */
    string MapThumbPath(int id, bool gray) {
        int idx = (id - 1) * 3;
        if (idx < 0) { idx = 0; }
        string path = "assets/map/" + Rules.N(idx).PadLeft(5, "0")
            + (gray ? "_g" : "") + ".jpg";
        if (File.Exists(path)) { return path; }
        return "assets/map/00000" + (gray ? "_g" : "") + ".jpg";
    }

    void BuildMapTravel() {
        PlayerState st = net.SelfState();
        int curMap = st != null ? st.MapId : 1;
        int unlocked = st != null && st.MapUnlocked > 0 ? st.MapUnlocked : 1;
        int total = net.MapCount();
        if (total <= 0) { total = 35; }

        int per = Spec.MapPerPage();
        int pages = (total + per - 1) / per; if (pages < 1) { pages = 1; }
        if (mapPage >= pages) { mapPage = pages - 1; }
        if (mapPage < 0) { mapPage = 0; }

        Panel body = Panel.Column(); body.Class = "map-page";
        body.Pad(0); body.Gap(0); body.Grow(); content.With(body);

        int from = mapPage * per;
        int to = total < from + per ? total : from + per;
        int rows = (to - from + Spec.MapCols() - 1) / Spec.MapCols();

        /* 卡阵：每行 4 张定宽卡片（不能用 Grid.Of(4)，那会等分拉伸卡片）。
           行必须给固定高 MapCardH：Grow() 的行是 dock=5，停靠容器把同一
           剩余区发给**每一个** dock=5 子项 —— 5 行会重叠成一格，卡片被
           撑到整屏高（实测踩过）。 */
        int wallW = Spec.MapCols() * Spec.MapCardW()
            + (Spec.MapCols() - 1) * Spec.MapColGap();
        int wallH = rows * Spec.MapCardH() + (rows - 1) * Spec.MapRowGap();

        /* 卡阵贴主区左上（用户：「应该左上」）；页码贴主区底、与卡阵左缘对齐
           （原版页码本来就在左下，用户：「分页应该固定到下面」）。宽高按
           **运行期画布**算——页面必须在窗口拿到最终尺寸后才重建，否则这里是
           resize 之前的旧画布：实测按启动初值算出 494×427，只有真实主区
           （1138×788）的一半，两个 inset 都撞到下限，卡阵被顶到左上角。 */
        int pageW = app.ClientWidth() - Spec.LeftPad() - Spec.LeftW()
            - Spec.ChatW() - Spec.ChatPadR();
        int pageH = app.ClientHeight() - app.ContentTop() - Spec.ContentTopPad()
            - Spec.TopH() - Spec.BotTileRowH() - Spec.BotTileBottom();
        int leftInset = (pageW - wallW) / 2;
        if (leftInset < Spec.MapMargin()) { leftInset = Spec.MapMargin(); }
        /* 卡阵贴主区**左上**（用户：「地图还是垂直居中的啊，应该左上」）；
           页码贴主区底（用户：「分页应该固定到下面」）、与卡阵左缘对齐，
           底距与左右留白同值 MapMargin。窗口压得很矮时页码与卡阵之间保底
           一个卡阵行距。 */
        int topInset = Spec.MapMargin();
        int pagerGap = pageH - Spec.MapMargin() - Spec.PagerH() - topInset - wallH;
        if (pagerGap < Spec.MapRowGap()) { pagerGap = Spec.MapRowGap(); }

        /* 上留白（dock=1）→ 中段（Row，Grow/dock=5：左平移 + 卡阵/页码块）。
           停靠容器先摆 dock 1..4 再摆 5，所以上留白必须靠 With（dock=1）；
           中段剩下的底部余量就是页码之下的底缝。 */
        Panel top = Panel.Column(); top.Prefer(0, topInset); body.With(top);

        Panel mid = Panel.Row(); mid.Pad(0); mid.Gap(0); mid.Grow(); body.With(mid);
        mid.With(SpacerW(leftInset));

        /* 块宽 = 卡阵宽（固定，不再 Grow）：块内卡片行与页码行共用同一个左缘，
           页码不再偏移；块整体随 leftInset 居中。块高 = 卡阵 + 页码间距 + 页码，
           在 mid 里顶端对齐 → 卡阵上下留白相等，页码落在块底。 */
        Panel block = Panel.Column(); block.Pad(0); block.Gap(0);
        block.Prefer(wallW, wallH + pagerGap + Spec.PagerH()); mid.With(block);

        Panel wall = Panel.Column(); wall.Class = "map-wall";
        wall.Gap(Spec.MapRowGap()); wall.Prefer(0, wallH); block.With(wall);
        for (int r = 0; r < rows; r = r + 1) {
            Panel row = Panel.Row(); row.Class = "map-row"; row.Gap(Spec.MapColGap());
            row.Prefer(0, Spec.MapCardH()); wall.With(row);
            for (int c = 0; c < Spec.MapCols(); c = c + 1) {
                int i = from + r * Spec.MapCols() + c;
                if (i >= to) { break; }
                row.With(MapCard(i, curMap, unlocked));
            }
        }

        Panel pagerGapBox = Panel.Column(); pagerGapBox.Prefer(0, pagerGap);
        block.With(pagerGapBox);

        /* 页码：用标准库 Pagination 组件（用户：「分页有分页组件」），不再自绘
           数字方块。槽位高取 PagerH，与 blockH 的预算同一个来源。 */
        SignalInt pgSig = new SignalInt(mapPage + 1);
        Pagination pg = new Pagination(pages, pgSig);
        pg.Named("map-pager");
        pg.Change += () => {
            mapPage = pgSig.Get() - 1;
            BuildPage(); Refresh();
        };
        Panel pagerSlot = Panel.Column(); pagerSlot.Pad(0); pagerSlot.Gap(0);
        pagerSlot.Prefer(0, Spec.PagerH()); block.With(pagerSlot);
        pagerSlot.With(pg);
    }

    /* 一张地图卡：截图铺满 + 图名压右上角 + 整卡可点。 */
    Panel MapCard(int i, int curMap, int unlocked) {
        MapInfo mp = net.TypedMapAt(i);
        int id = mp != null ? mp.Id : i + 1;
        string name = mp != null ? mp.Name : "地图";
        bool here = id == curMap;
        bool open = id <= unlocked;

        /* 原版卡片 = 160×70 定宽定高。 */
        Panel card = Panel.Row(); card.Class = here ? "map-tile map-tile-here"
            : open ? "map-tile map-tile-open" : "map-tile";
        card.Pad(0); card.Gap(0);
        card.Prefer(Spec.MapCardW(), Spec.MapCardH());
        card.Named("map-card-" + Rules.N(id));
        Image thumb = new Image(MapThumbPath(id, !here), name, "cover");
        thumb.Grow(); card.With(thumb);
        /* 图名**不**自己画：地图素材右上角就烤着名字（实测 00000.jpg /
           00003_g.jpg 的 20..140 像素区里就是「银杏小村」「比奇省」白字黑
           描边）。之前这里又贴了一个 Label，名字画两遍，而且用的是兜底字串
           「地图」——离线取不到 mp 时满屏都是「地图」。 */

        int mid = id;
        /* 三分支点击语义（照旧版原样）：进图前先置 netInnerMap，内页
           才看得到这张图的 BOSS。旧版漏了这步赋值（内页永远看 1 号图），
           这里每条入口都补上。 */
        if (!here) {
            if (open) {
                /* 解锁图：照原版点卡即进图，落到这张图的内页。 */
                card.OnClick(() => {
                    netInnerMap = mid; net.MoveTo(mid);
                    net.OpenMapPage(mid); Navigate(31);
                });
            } else {
                /* 锁定的图也接点击：服务端闸门会回报原因（尚未解锁：
                   先在上一张图的内页挑战并击败 BOSS），不能点了没反应。 */
                card.OnClick(() => { netInnerMap = mid; net.MoveTo(mid); });
            }
        } else {
            /* 当前图：直接看内页（重进不需要移动）。 */
            card.OnClick(() => { netInnerMap = mid; net.OpenMapPage(mid); Navigate(31); });
        }
        return card;
    }
}
