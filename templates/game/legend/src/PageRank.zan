using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 9「排行榜」——照原版逐像素还原（`mir2/mir/排行榜.png`）。
///
/// 页面 = 左**人物预览面板** + 右**页签行 + 6 列表格**。
///
/// 左预览面板（宽 279 设备）：立绘卡 + 属性盒，两盒都 1 设备蓝框。
///   · 立绘卡底图 `assets/ui/00010.jpg`（168×250，原图 1.5 倍上屏）——
///     **10 个空格框已经烘在这张图里**（右列 4 + 左列 2 + 底行 4），
///     所以这里只按原图格框坐标叠 10 个道具图标（`Slots.SlotArt`，
///     透明底、不盖框）。与包裹页用 `00009.jpg` 的做法同源，**不裁截图**。
///   · 属性盒 10 行文字（标题 + 等级/生命/法力/攻击/魔法/道术/防御/魔防/
///     幸运）。原版每行的标签与数值**同色系**，只有「属性」列的经验数
///     标签比数值深一档，所以属性盒一行一个 `Label` 就够。
///
/// 右列页签 6 枚（等级/攻击/魔法/道术/称谓/金币排行榜）——原版 6 枚
/// **没有选中态差异**，故同皮；点击只切本页演示的当前榜名（玩法未接，
/// 见 `RankPickTab`，不假装已实现）。
///
/// 表格走共享组件 `TableUi`，但有四处与称谓/爵位/行会不同（都在 Spec 里）：
///   · 行高恒定 39 设备、节距 43（不带 0.5 取整补偿）→ `TblRowBoxesAt`
///   · 表头带 39 设备、带下 2 设备蓝线、左内缩 8 → `TblHeadAt`
///   · 容器外框是蓝 `#1e5588`（其他表格页是灰 `#3d4756`）→ `.rank-box`
///   · 页脚**没有「说明」钮**、左内缩 4 设备、页数 1/10
///
/// 配色（原版实测）：排名/职业白、玩家/等级青 `#00f0f0`、ID 品红
/// `#ff4060`、属性标签黄、属性数值更亮一档的黄。
partial class LegendApp {
    /// 6 枚页签（原版从「等级排行榜」起）。
    static List<string> RankTabs() {
        List<string> t = new List<string>();
        t.Add("等级排行榜"); t.Add("攻击排行榜"); t.Add("魔法排行榜");
        t.Add("道术排行榜"); t.Add("称谓排行榜"); t.Add("金币排行榜");
        return t;
    }

    /// 一行排行榜数据。**一行一实体**：这一屏每一行本来就是同一个玩家的
    /// 名 / 职业 / ID / 巅峰等级 / 经验，拆成 5 个平行 List 只能靠下标对齐
    /// （某个列表长度对不上就静默串行），而且等级、经验一旦存成字符串，
    /// 6 枚页签（等级 / 攻击 / 魔法 / 道术 / 称谓 / 金币）按数值排序就无从
    /// 谈起。故等级、经验存**数值**，只在显示时拼字。
    class RankRow {
        string name;
        string job;
        int id;
        int peak;       // 巅峰等级（列上显示「巅峰N级」）
        long exp;       // 「属性」列的经验值（15 位，超 int32）
        string LevelText() { return "巅峰" + Rules.N(peak) + "级"; }
        string ExpText() { return Convert.ToString(exp); }
    }

    /// 12 行榜单数据（照 `排行榜.png` 逐行抄录；名次即下标 + 1）。
    static List<RankRow> rankData = null;
    static List<RankRow> RankData() {
        if (rankData != null) { return rankData; }
        List<RankRow> v = new List<RankRow>();
        v.Add(RankRowOf("龙卫——天尊", "道士", 31048, 1500, 604765589748973));
        v.Add(RankRowOf("龙卫——圣战", "道士", 21507, 1500, 360821362898660));
        v.Add(RankRowOf("龙卫——法神", "道士", 22385, 1500, 324672831162518));
        v.Add(RankRowOf("大白花", "道士", 11644, 1500, 197066729187269));
        v.Add(RankRowOf("名将——翔天", "道士", 28016, 1500, 171794553759349));
        v.Add(RankRowOf("漆黑天使", "道士", 27685, 1500, 16269681332877));
        v.Add(RankRowOf("花花是我大哥", "战士", 33159, 1500, 75932638499667));
        v.Add(RankRowOf("上善青萍道君", "道士", 21034, 1500, 73795807587313));
        v.Add(RankRowOf("无敌绵羊", "战士", 16261, 1500, 5149435940628));
        v.Add(RankRowOf("无敌奶糖", "战士", 18702, 1425, 2744626411667));
        v.Add(RankRowOf("遗忘者", "道士", 41012, 1334, 561304301882));
        v.Add(RankRowOf("风之魔装机神", "法师", 21056, 1324, 3621945665808));
        rankData = v;
        return rankData;
    }

    static RankRow RankRowOf(string name, string job, int id, int peak, long exp) {
        RankRow r = new RankRow();
        r.name = name; r.job = job; r.id = id; r.peak = peak; r.exp = exp;
        return r;
    }

    /// 立绘卡上 10 个格位要叠的道具——**按 picture 号**给（不是道具号）：
    /// 原版这一屏穿的是「上古」一套 + 会员龙珠。最后两枚在原版素材库里
    /// 没有能一一对应的条目（玫瑰花束、银底绿纹戒指），取颜色与器型最
    /// 接近的真实素材，登记在 `REFERENCE_AUDIT.md`，不裁截图顶替。
    static List<int> RankSlotPictures() {
        List<int> p = new List<int>();
        p.Add(2810);                                // 右列 y43   上古项链
        p.Add(1340);                                // 右列 y81   玫瑰花束（无同名道具）
        p.Add(2809);                                // 右列 y132  上古护腕
        p.Add(2808);                                // 右列 y171  上古戒指
        p.Add(2809);                                // 左列 y132  上古护腕
        p.Add(2808);                                // 左列 y171  上古戒指
        p.Add(2597);                                // 底行 x5    超级会员龙珠
        p.Add(2812);                                // 底行 x46   上古腰带
        p.Add(2813);                                // 底行 x88   上古战靴
        p.Add(2814);                                // 底行 x131  戒指（银底绿纹，最接近）
        return p;
    }

    /// 属性盒里的 9 行（标题除外）。原版标签与数值同色系，整行一个 Label。
    static List<string> RankStatLines() {
        List<string> v = new List<string>();
        v.Add("等级：巅峰1500级");
        v.Add("生命：197726");
        v.Add("法力：45246");
        v.Add("攻击：937 - 25822");
        v.Add("魔法：935 - 25168");
        v.Add("道术：1105 - 135929");
        v.Add("防御：2359 - 29506");
        v.Add("魔防：2364 - 36882");
        v.Add("幸运：+ 9");
        return v;
    }

    /// 9 行属性的配色类（实测逐行不同：等级粉、生命橙、法力藕荷、攻击青、
    /// 魔法蓝、道术绿、防御黄、魔防紫、幸运橙）。
    static List<string> RankStatCls() {
        List<string> v = new List<string>();
        v.Add("rank-st-lv"); v.Add("rank-st-hp"); v.Add("rank-st-mp");
        v.Add("rank-st-atk"); v.Add("rank-st-mag"); v.Add("rank-st-tao");
        v.Add("rank-st-def"); v.Add("rank-st-mdef"); v.Add("rank-st-luck");
        return v;
    }

    /// 当前高亮的榜名（页签只做演示：原版 6 枚没有选中态，这里点了只换
    /// 左面板标题，数据不动——玩法未接）。
    int rankTab = 0;

    void BuildRankPage() {
        /* 联机：进页拉一次等级榜（RefreshRank 自带 null 守卫，防重建循环）。 */
        net.RefreshRank();
        Panel page0 = Panel.Row(); page0.Class = "rank-page";
        page0.Pad(0); page0.Gap(Spec.RankColGap());
        page0.Padding(Spec.RankPagePadT(), Spec.RankPagePadR(), 0,
                      Spec.RankPagePadL());
        page0.Grow(); content.With(page0);

        page0.With(RankLeftPanel());
        page0.With(RankRightCol());
    }

    // ------------------------------------------------------------------
    //  左：人物预览面板
    // ------------------------------------------------------------------
    /// 左面板：1 设备蓝框 + 底 `#243040`，内边距 10、两盒之间 7。
    /// 高度显式给 710 设备（= 实测 167..876）——**不能**写 `Prefer(w, 0)`：
    /// 布局把「声明高度 ≤ 0」当作撑满可用空间，面板会被拉满整页高。
    /// 页面 Row 上的 `.rank-page { align-items: flex-start }` 也是为此：
    /// 否则 `align-items` 默认 stretch 仍会把它拉高。
    Panel RankLeftPanel() {
        Panel p = Panel.Column(); p.Class = "rank-panel";
        p.Pad(Spec.RankPanelPad()); p.Gap(Spec.RankPanelGap());
        p.Prefer(Spec.RankLeftW(), Spec.RankLeftH());
        p.With(RankArtCard());
        p.With(RankStatsBox());
        return p;
    }

    /// 立绘卡：1 设备蓝框 + 底图 `00010.jpg` 铺满（内缩 1 设备给边框让位），
    /// 再按原图逻辑坐标叠 10 个道具图标（Float 手动摆位）。
    /// 标题「第一个行会 会长」压在卡左上角，与底图同层。
    Panel RankArtCard() {
        Panel card = Panel.Row(); card.Class = "rank-art";
        card.Pad(Spec.Px(1)); card.Prefer(Spec.RankArtW(), Spec.RankArtH());

        Image pic = new Image("assets/ui/00010.jpg", "人物+装备环", "stretch");
        pic.Grow(); card.Add(pic);

        List<int> pics = RankSlotPictures();
        for (int i = 0; i < Spec.RankSlotCount(); i = i + 1) {
            Panel ic = SlotArt(Spec.RankSlotW(), Spec.RankSlotH(),
                               ItemArtPath(pics[i]), "", "");
            ic.Float(Spec.RankSlotX(i), Spec.RankSlotY(i));
            card.Add(ic);
        }

        Label t = Text("第一个行会 会长", "rank-art-t", 0);
        t.Float(Spec.Px(1), Spec.Px(2));
        t.Prefer(0, Spec.Px(12));
        card.Add(t);
        return card;
    }

    /// 属性盒：1 设备蓝框 + 底 `#171e29`；顶留白 9、左内缩 30。
    /// 高度**显式给足**（306 设备）——容器 prefH 只由子项测量得出，顶部
    /// 内边距不计入（同 `TableUi.TblBox` 的坑），所以顶部留白用定高撑条。
    Panel RankStatsBox() {
        Panel b = Panel.Column(); b.Class = "rank-stats";
        b.Pad(0); b.Gap(0); b.Prefer(0, Spec.RankStatsH());
        b.With(TblPad(Spec.RankStatsPadT()));
        b.With(RankStatLine(RankTitleText(), "rank-st-t", Spec.RankTitleH()));
        List<string> lines = RankStatLines();
        List<string> cs = RankStatCls();
        for (int i = 0; i < lines.Count; i = i + 1) {
            b.With(RankStatLine(lines[i], cs[i], Spec.RankStatH()));
        }
        return b;
    }

    /// 左面板标题：原版是「玩家名(称号)」，比正文大一号、黄色。
    /// 联机取自己（名字 + self.title，无称谓给「无」）；离线保持演示。
    string RankTitleText() {
        PlayerState st = net.SelfState();
        if (st != null && st.Id > 0) {
            string ti = st.Title;
            string name = st.Name != "" ? st.Name : "旅人";
            return name + "(" + (ti.Length > 0 ? ti : "无") + ")";
        }
        List<RankRow> rows = RankData();
        return rows[0].name + "(鸿蒙·主宰)";
    }

    /// 属性盒里的一行：定高 + 左内缩，文字左对齐（`Label` 认不出 text-align，
    /// 这里用**容器左对齐**——行是 `Panel.Row()` 默认贴左，正是原版的样子）。
    Panel RankStatLine(string s, string cls, int hDevice) {
        Panel r = Panel.Row(); r.Class = "rank-stat";
        r.Pad(0); r.Prefer(0, hDevice);
        r.Padding(0, 0, 0, Spec.RankStatsPadL());
        Label t = Text(s, cls, 0);
        t.Prefer(0, hDevice);
        r.With(t);
        return r;
    }

    // ------------------------------------------------------------------
    //  右：页签 + 表格 + 页脚
    // ------------------------------------------------------------------
    Panel RankRightCol() {
        Panel col = Panel.Column(); col.Class = "rank-col";
        col.Pad(0); col.Gap(0); col.Grow();
        col.With(TblPad(Spec.RankTabTop()));
        col.With(RankTabRow());

        Panel tabGap = Panel.Row(); tabGap.Pad(0);
        tabGap.Prefer(0, Spec.RankTabToBox()); col.With(tabGap);

        col.With(RankTable());

        Panel footGap = Panel.Row(); footGap.Pad(0);
        footGap.Prefer(0, Spec.RankFootGap()); col.With(footGap);

        SignalInt pgSig = new SignalInt(1);
        Pagination pg = new Pagination(Spec.RankPages(), pgSig);
        pg.Class = "simple";
        pg.PrevText("上一页"); pg.NextText("下一页");
        pg.Named("rank-pager");
        col.With(TblFootOpt(RankFootNote(), pg, Spec.RankFootPadL(), false));
        return col;
    }

    /// 页签行：6 枚等分（`Grow`）填满与表框同宽的 824 设备，缝 10。
    Panel RankTabRow() {
        Panel row = Panel.Row(); row.Class = "rank-tabs";
        row.Pad(0); row.Gap(Spec.RankTabGap());
        row.Prefer(0, Spec.RankTabH());
        List<string> tabs = RankTabs();
        for (int i = 0; i < tabs.Count; i = i + 1) {
            int pick = i;
            Button b = Btn(tabs[i], "tbl-btn rank-tab", () => { RankPickTab(pick); });
            b.Grow(); b.Prefer(0, Spec.RankTabH());
            row.With(b);
        }
        return row;
    }

    /// 表格：表头带 → 2 设备蓝线 → 6 设备缝 → 12 行 → 10 设备底留白。
    /// 「属性」列是**两个 Label**（标签黄深一档、数值黄亮一档），所以这一
    /// 列的格子自己拼；行骨架与格子底色仍走 `TableUi`。
    Panel RankTable() {
        Panel box = Panel.Column(); box.Class = "tbl-box rank-box";
        box.Pad(0); box.Gap(0);
        box.With(TblPad(Spec.TblHeadTopPad()));
        List<int> ws = Spec.RankCols();
        box.With(TblHeadAt(RankHeads(), ws, Spec.RankHeadH(), Spec.RankColGap(),
                           Spec.TblPadL()));

        Panel line = Panel.Row(); line.Class = "rank-head-line";
        line.Pad(0); line.Prefer(0, Spec.RankHeadLine()); box.With(line);

        Panel headGap = Panel.Row(); headGap.Pad(0);
        headGap.Prefer(0, Spec.RankHeadGap()); box.With(headGap);

        Panel wall = Panel.Column(); wall.Pad(0); wall.Gap(Spec.TblRowGap());
        box.With(wall);

        /* 联机：等级榜前 10 名来自服务端（优先消费强类型 RankItem 实体，消除动态 JsonValue 树散布）；
           离线保持演示 12 行。 */
        bool online = net.Self() != null && net.RankCount() > 0;
        List<RankRow> rows = RankData();
        int nRows = online ? net.RankCount() : rows.Count;
        for (int r = 0; r < nRows; r = r + 1) {
            string nm; string lvlTxt; string idTxt; string jobTxt; string expTxt;
            if (online) {
                RankItem rk = net.TypedRankAt(r);
                if (rk != null) {
                    nm = rk.Name;
                    lvlTxt = "巅峰" + Rules.N(rk.Level) + "级";
                    idTxt = Rules.N(rk.PlayerId);
                    jobTxt = net.JobNameOf(rk.Job);
                    expTxt = Convert.ToString(rk.Exp);
                } else {
                    nm = ""; lvlTxt = ""; idTxt = ""; jobTxt = ""; expTxt = "";
                }
            } else {
                RankRow pl = rows[r];
                nm = pl.name; lvlTxt = pl.LevelText(); idTxt = Rules.N(pl.id);
                jobTxt = pl.job; expTxt = pl.ExpText();
            }
            List<Panel> cells = new List<Panel>();
            cells.Add(TblCellClsAt(Rules.N(r + 1), "rank-c0", ws[0], "tbl-cell",
                                   Spec.RankRowH()));
            cells.Add(TblCellClsAt(nm, "rank-c1", ws[1], "tbl-cell",
                                   Spec.RankRowH()));
            cells.Add(TblCellClsAt(lvlTxt, "rank-c2", ws[2], "tbl-cell",
                                   Spec.RankRowH()));
            cells.Add(TblCellClsAt(idTxt, "rank-c3", ws[3], "tbl-cell",
                                   Spec.RankRowH()));
            cells.Add(TblCellClsAt(jobTxt, "rank-c4", ws[4], "tbl-cell",
                                   Spec.RankRowH()));
            cells.Add(RankAttrCell(expTxt, ws[5]));
            wall.With(TblRowBoxesAt(cells, Spec.RankRowH(), Spec.TblColGap(),
                                    Spec.TblPadL(), "tbl-row"));
        }
        box.With(TblPad(Spec.RankBottomPad()));
        return box;
    }

    static List<string> RankHeads() {
        List<string> h = new List<string>();
        h.Add("排名"); h.Add("玩家"); h.Add("等级"); h.Add("ID");
        h.Add("职业"); h.Add("属性");
        return h;
    }

    /// 「属性」列格子：左对齐的「经验：」+ 数值两个 Label。
    /// 左对齐靠格子的 `justify-content: flex-start`（`.rank-cell-l`）——
    /// 居中格子的 flex 会让两个标签挤到中间，与实测左缘差 90+ 设备。
    Panel RankAttrCell(string val, int wDevice) {
        Panel c = Panel.Row(); c.Class = "tbl-cell rank-cell-l";
        c.Pad(0); c.Prefer(wDevice, Spec.RankRowH());
        Label k = Text("经验：", "rank-attr-k", 0);
        k.Prefer(0, Spec.RankRowH());
        c.With(k);
        Label v = Text(val, "rank-attr-v", 0);
        v.Prefer(0, Spec.RankRowH());
        c.With(v);
        return c;
    }

    /// 页脚左侧说明（原版这一页**没有**「说明」钮，只有这句灰字）。
    Panel RankFootNote() {
        Panel p = Panel.Row(); p.Pad(0);
        p.Prefer(0, Spec.TblFootH());
        Label t = Text("排行榜每小时刷新一次，查看装备是实时信息。", "rank-note", 0);
        t.Prefer(0, Spec.TblFootH());
        p.With(t);
        return p;
    }

    /// 页签点击：等级榜已接服务端（重拉 + 重建）；其余 5 榜服务端尚无
    /// 对应玩法，只把左面板标题换成所选榜名，给出明确反馈（不假装已实现）。
    void RankPickTab(int i) {
        rankTab = i;
        if (i == 0 && net.Self() != null) {
            net.ReloadRank();
            BuildPage();
            Refresh();
            return;
        }
        List<string> tabs = RankTabs();
        string msg = "排行榜：" + tabs[i] + "（数据未接）";
        if (net.Self() != null) { net.AddChat("[系统]", msg); return; }
        g.Log(msg);
    }

    /// 当前榜名（左面板标题用；未选时取第一枚）。
    string RankTabName() {
        List<string> tabs = RankTabs();
        return tabs[rankTab >= 0 && rankTab < tabs.Count ? rankTab : 0];
    }
}
