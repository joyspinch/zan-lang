    SiegeState() {
        this.owner = "";
        this.guild = "";
        this.holdSeconds = 0;
        this.cities = new List<CityItem>();
        this.rewardsOccupied = new List<SiegeRewardItem>();
        this.rewardsRandom = new List<SiegeRewardItem>();
    }

    string Owner { get { return owner; } set { owner = value; } }
    string Guild { get { return guild; } set { guild = value; } }
    int HoldSeconds { get { return holdSeconds; } set { holdSeconds = value; } }
    List<CityItem> Cities { get { return cities; } }
    List<SiegeRewardItem> RewardsOccupied { get { return rewardsOccupied; } }
    List<SiegeRewardItem> RewardsRandom { get { return rewardsRandom; } }
}

