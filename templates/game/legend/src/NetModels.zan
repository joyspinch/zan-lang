}

/// <summary>
/// 区服信息强类型数据实体（替代动态 JsonValue realms 树）。
/// </summary>
class RealmInfo {
    int id;
    string name;
    string grp;
    int state;
    int online;
    int expRate;
    int goldRate;
    int dropRate;

    RealmInfo(int id, string name, string grp, int state, int online,
              int expRate, int goldRate, int dropRate) {
        this.id = id;
        this.name = name != null ? name : "";
        this.grp = grp != null ? grp : "永久区";
        this.state = state;
        this.online = online;
        this.expRate = expRate;
        this.goldRate = goldRate;
        this.dropRate = dropRate;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    string Grp { get { return grp; } }
    int State { get { return state; } }
    int Online { get { return online; } }
    int ExpRate { get { return expRate; } }
    int GoldRate { get { return goldRate; } }
    int DropRate { get { return dropRate; } }
}

/// <summary>
/// 角色摘要强类型实体（替代 characters 回复中的动态 JsonValue 项）。
