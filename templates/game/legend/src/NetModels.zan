/// <summary>
/// 邮件条目强类型实体（替代动态 JsonValue playMail 项）。
/// </summary>
class MailItem {
    int id;
    string title;
    string sender;
    string date;
    string body;
    int claimed;
    List<int> items;

    MailItem(int id, string title, string sender, string date, string body, int claimed) {
        this.id = id;
        this.title = title != null ? title : "";
        this.sender = sender != null ? sender : "";
        this.date = date != null ? date : "";
        this.body = body != null ? body : "";
        this.claimed = claimed;
        this.items = new List<int>();
    }

    int Id { get { return id; } }
    string Title { get { return title; } }
    string Sender { get { return sender; } }
    string Date { get { return date; } }
    string Body { get { return body; } }
    int Claimed { get { return claimed; } set { claimed = value; } }
    List<int> Items { get { return items; } }
}

