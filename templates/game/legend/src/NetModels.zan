using System;
using System.Collections.Generic;

namespace Legend;

/// <summary>
/// 玩家角色自身状态强类型实体（彻底替代原动态 JsonValue self）。
/// 直接字段寻址，零每帧动态哈希查找与装箱分配开销。
/// </summary>
class PlayerState {
    int id;
    string name;
    int realm;
    int level;
    long exp;
    long expNext;
    int hp;
    int maxHp;
    int mp;
    int maxMp;
    int atk;
    int def;
    long gold;
    long ingots;
    int kills;
    int mapId;
    int mapUnlocked;
    int x;
    int y;
    long fame;
    long merit;
    long spirit;
    int job;
    string title;
    int weaponStar;
    int armorStar;

    PlayerState() {
        this.id = 0;
        this.name = "";
        this.realm = 1;
        this.level = 1;
        this.exp = 0;
        this.expNext = 100;
        this.hp = 100;
        this.maxHp = 100;
        this.mp = 50;
        this.maxMp = 50;
        this.atk = 10;
        this.def = 5;
        this.gold = 0;
        this.ingots = 0;
        this.kills = 0;
        this.mapId = 1;
        this.mapUnlocked = 1;
        this.x = 0;
        this.y = 0;
        this.fame = 0;
        this.merit = 0;
        this.spirit = 0;
        this.job = 0;
        this.title = "";
        this.weaponStar = 0;
        this.armorStar = 0;
    }

    int Id { get { return id; } set { id = value; } }
    string Name { get { return name; } set { name = value; } }
    int Realm { get { return realm; } set { realm = value; } }
    int Level { get { return level; } set { level = value; } }
    long Exp { get { return exp; } set { exp = value; } }
    long ExpNext { get { return expNext; } set { expNext = value; } }
    int Hp { get { return hp; } set { hp = value; } }
    int MaxHp { get { return maxHp; } set { maxHp = value; } }
    int Mp { get { return mp; } set { mp = value; } }
    int MaxMp { get { return maxMp; } set { maxMp = value; } }
    int Atk { get { return atk; } set { atk = value; } }
    int Def { get { return def; } set { def = value; } }
    long Gold { get { return gold; } set { gold = value; } }
    long Ingots { get { return ingots; } set { ingots = value; } }
    int Kills { get { return kills; } set { kills = value; } }
    int MapId { get { return mapId; } set { mapId = value; } }
    int MapUnlocked { get { return mapUnlocked; } set { mapUnlocked = value; } }
    int X { get { return x; } set { x = value; } }
    int Y { get { return y; } set { y = value; } }
    long Fame { get { return fame; } set { fame = value; } }
    long Merit { get { return merit; } set { merit = value; } }
    long Spirit { get { return spirit; } set { spirit = value; } }
    int Job { get { return job; } set { job = value; } }
    string Title { get { return title; } set { title = value; } }
    int WeaponStar { get { return weaponStar; } set { weaponStar = value; } }
    int ArmorStar { get { return armorStar; } set { armorStar = value; } }
}

/// <summary>
/// 导航项强类型实体（替代 navigation.csv 运行时动态 DataRow 查找）。
/// </summary>
class NavItem {
    int id;
    string name;
    string icon;
    string label;
    int x;
    int w;

    NavItem(int id, string name, string icon, string label, int x, int w) {
        this.id = id;
        this.name = name != null ? name : "";
        this.icon = icon != null ? icon : "";
        this.label = label != null ? label : "";
        this.x = x;
        this.w = w;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    string Icon { get { return icon; } }
    string Label { get { return label; } }
    int X { get { return x; } }
    int W { get { return w; } }
}

/// <summary>
/// 装备与物品槽位强类型实体。
/// </summary>
class BagItem {
    int slot;
    int itemId;
    string name;
    int count;
    int quality;
    int itemType;

    BagItem(int slot, int itemId, string name, int count) {
        this.slot = slot;
        this.itemId = itemId;
        this.name = name != null ? name : "";
        this.count = count;
        this.quality = 0;
        this.itemType = 0;
    }

    int Slot { get { return slot; } set { slot = value; } }
    int ItemId { get { return itemId; } set { itemId = value; } }
    string Name { get { return name; } set { name = value; } }
    int Count { get { return count; } set { count = value; } }
    int Quality { get { return quality; } set { quality = value; } }
    int ItemType { get { return itemType; } set { itemType = value; } }
}

/// <summary>
/// 怪物与首领强类型数据实体。
/// </summary>
class MobInfo {
    int id;
    int tpl;
    string name;
    int level;
    int hp;
    int maxHp;
    int atk;
    int def;
    bool alive;
    int respawnIn;

    MobInfo(int id, string name, int level, int maxHp) {
        this.id = id;
        this.tpl = id;
        this.name = name != null ? name : "";
        this.level = level;
        this.maxHp = maxHp;
        this.hp = maxHp;
        this.atk = 5;
        this.def = 2;
        this.alive = true;
        this.respawnIn = 0;
    }

    int Id { get { return id; } }
    int Tpl { get { return tpl; } set { tpl = value; } }
    string Name { get { return name; } }
    int Level { get { return level; } }
    int Hp { get { return hp; } set { hp = value; } }
    int MaxHp { get { return maxHp; } }
    int Atk { get { return atk; } }
    int Def { get { return def; } }
    bool Alive { get { return alive; } set { alive = value; } }
    int RespawnIn { get { return respawnIn; } set { respawnIn = value; } }
}

/// <summary>
/// 地图区域元数据强类型实体。
/// </summary>
class MapInfo {
    int id;
    string name;
    int minLevel;
    int mobCount;

    MapInfo(int id, string name, int minLevel) {
        this.id = id;
        this.name = name != null ? name : "";
        this.minLevel = minLevel;
        this.mobCount = 0;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    int MinLevel { get { return minLevel; } }
