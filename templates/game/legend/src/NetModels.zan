/// <summary>
/// 竞技场状态强类型实体（替代动态 JsonValue playArena）。
/// </summary>
class ArenaState {
    int tries;
    int wins;
    int pts;
    int power;
    long time;
    List<ArenaRival> rows;

    ArenaState() {
        this.tries = 0;
        this.wins = 0;
        this.pts = 0;
        this.power = 0;
        this.time = 0;
        this.rows = new List<ArenaRival>();
    }

    int Tries { get { return tries; } set { tries = value; } }
    int Wins { get { return wins; } set { wins = value; } }
    int Pts { get { return pts; } set { pts = value; } }
    int Power { get { return power; } set { power = value; } }
    long Time { get { return time; } set { time = value; } }
    List<ArenaRival> Rows { get { return rows; } }
}

