/// <summary>
/// 个人/野外 BOSS 元数据强类型实体（替代 bosses 回复中的动态 JsonValue 项）。
/// </summary>
class BossInfo {
    int id;
    string name;
    int minLevel;
    int rebirth;
    long hp;
    long maxHp;
    int tries;

    BossInfo(int id, string name, int minLevel, int rebirth, long maxHp) {
        this.id = id;
        this.name = name != null ? name : "";
        this.minLevel = minLevel;
        this.rebirth = rebirth;
        this.maxHp = maxHp;
        this.hp = maxHp;
        this.tries = 3;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    int MinLevel { get { return minLevel; } }
    int Rebirth { get { return rebirth; } }
    long Hp { get { return hp; } set { hp = value; } }
    long MaxHp { get { return maxHp; } }
    int Tries { get { return tries; } set { tries = value; } }
}

/// <summary>
/// 表数据 BOSS 详情强类型实体（替代 PageBossHome/表查询中对 bosses.csv 的动态 DataRow.Int 访问）。
/// </summary>
class BossDetail {
    int id;
    string name;
    int picture;
    int hp;
    int mp;
    int minLevel;
    int rebirth;
    int attackMin;
    int attackMax;
    int magicMin;
    int magicMax;
    int taoMin;
    int taoMax;
    int defenseMin;
    int defenseMax;
    int magicDefenseMin;
    int magicDefenseMax;

    BossDetail(
        int id,
        string name,
        int picture,
        int hp,
        int mp,
        int minLevel,
        int rebirth,
        int attackMin,
        int attackMax,
        int magicMin,
        int magicMax,
        int taoMin,
        int taoMax,
        int defenseMin,
        int defenseMax,
        int magicDefenseMin,
        int magicDefenseMax
    ) {
        this.id = id;
        this.name = name != null ? name : "";
        this.picture = picture;
        this.hp = hp;
        this.mp = mp;
        this.minLevel = minLevel;
        this.rebirth = rebirth;
        this.attackMin = attackMin;
        this.attackMax = attackMax;
        this.magicMin = magicMin;
        this.magicMax = magicMax;
        this.taoMin = taoMin;
        this.taoMax = taoMax;
        this.defenseMin = defenseMin;
        this.defenseMax = defenseMax;
        this.magicDefenseMin = magicDefenseMin;
        this.magicDefenseMax = magicDefenseMax;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    int Picture { get { return picture; } }
    int Hp { get { return hp; } }
    int Mp { get { return mp; } }
    int MinLevel { get { return minLevel; } }
    int Rebirth { get { return rebirth; } }
    int AttackMin { get { return attackMin; } }
    int AttackMax { get { return attackMax; } }
    int MagicMin { get { return magicMin; } }
    int MagicMax { get { return magicMax; } }
    int TaoMin { get { return taoMin; } }
    int TaoMax { get { return taoMax; } }
    int DefenseMin { get { return defenseMin; } }
    int DefenseMax { get { return defenseMax; } }
    int MagicDefenseMin { get { return magicDefenseMin; } }
    int MagicDefenseMax { get { return magicDefenseMax; } }
}

/// <summary>
/// 地图内页 BOSS 面板强类型实体（替代动态 JsonValue bossPage）。
/// </summary>
class MapBossPage {
    int tries;
    int hpLeft;
    BossDetail boss;

    MapBossPage() {
        this.tries = 0;
        this.hpLeft = 0;
        this.boss = null;
    }

    int Tries { get { return tries; } set { tries = value; } }
    int HpLeft { get { return hpLeft; } set { hpLeft = value; } }
    BossDetail Boss { get { return boss; } set { boss = value; } }
}

/// <summary>
/// 世界 BOSS 运行时状态强类型实体（替代 wboss 回复中的动态 JsonValue）。
/// </summary>
class WorldBossState {
    string name;
    int level;
    string topPlayer;
    long topDamage;
    bool alive;
    long hp;
    long maxHp;
    long respawnIn;

    WorldBossState() {
        this.name = "玛雅之神·幻影";
        this.level = 100;
        this.topPlayer = "虚位以待";
        this.topDamage = 0;
        this.alive = true;
        this.hp = 1000000;
        this.maxHp = 1000000;
        this.respawnIn = 0;
    }

    string Name { get { return name; } set { name = value; } }
    int Level { get { return level; } set { level = value; } }
    string TopPlayer { get { return topPlayer; } set { topPlayer = value; } }
    long TopDamage { get { return topDamage; } set { topDamage = value; } }
    bool Alive { get { return alive; } set { alive = value; } }
    long Hp { get { return hp; } set { hp = value; } }
    long MaxHp { get { return maxHp; } set { maxHp = value; } }
    long RespawnIn { get { return respawnIn; } set { respawnIn = value; } }
}

