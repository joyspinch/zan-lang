using System;
using System.Json;
namespace Legend;

// All actions are validated here. UI buttons are not the authority for cost checks.
class Game {
    int job = -1;
    int level = 1;
    int xp;
    int rebirth;
    int gold = GameTables.Value("initial_gold");
    int gems = GameTables.Value("initial_gems");
    int iron = GameTables.Value("initial_iron");
    int runes;
    int[] runeCounts = new int[14];
    int legendOre;
    int[] dragonBalls = new int[9];
    int potions = GameTables.Value("initial_potions");
    int floor = 1;
    int best = 1;
    int wave;
    int kills;
    int deaths;
    int skill = 1;
    int[] skillRanks = new int[8]; bool[] skillEquipped = new bool[8];
    int training;
    int tp;
    int[] innerRanks = new int[8];
    int[] gemRanks = new int[6];
    int title;
    int merit;
    int guild;
    int tower;
    int arenaWins;
    int collection;
    int quest;
    int capacity = GameTables.Value("initial_capacity");
    int filter;
    int filterCoefficient = 1; int filterMinLevel; bool filterJobOnly;
    int seed = 170927;
    bool active = true;
    bool autoPush = true;
    bool autoPotion = true;
    int hp;
    int mp;
    int enemyHp;
    int enemyMax;
    int enemyAttack;
    int enemyDefense;
    string enemyName = "";
    int mode; // 0 field, 1 personal boss, 2 tower, 3 local world boss, 4 secret
    int challenge;
    int round;
    int recovery;
    int tick;
    long day;
    long savedAt;
    int dailyClaim;
    int dailyKills;
    int bountyClaim;
    int bossTries = GameTables.Value("boss_tries");
    int arenaTries = GameTables.Value("arena_tries");
    int escortTries = GameTables.Value("escort_tries");
    int escortLeft;
    int escortReward;
    int treasurePity;
    int treasureMaps = GameTables.Value("initial_treasure_maps");
    int treasureDraws;
    int bossWins;
    int secrets;
    int secretFloor = 1; int secretWave; bool secretAutoPush = true;
    bool fieldActive = true; bool bossAutoNext;
    int travelMap = -1;
    int homeFloor = 1; int homeWave;
    int[] elementRanks = new int[5]; int[] elementXp = new int[5];
    int elementPool; int elementSeconds; bool elementTraining;
    int reputation; int redPackets; int recyclePoints;
    int altarPersonal; int altarWorld; int altarJackpots; int altarDonations;
    int recycled;
    int earned;
    int offlineSeconds;
    string notice = "选择职业，踏入幻境。";
    List<Equipment> bag = new List<Equipment>();
    List<Equipment> storage = new List<Equipment>();
    Equipment[] equipped = new Equipment[12];
    int[] collected = new int[12];
    List<int> codexItems = new List<int>();
    List<string> logs = new List<string>();

    int Random(int bound) { seed = (int)(((long)seed * 48271) % 2147483647); return seed % bound; }
    void Log(string text) { notice = text; logs.Add(text); if (logs.Count > 16) { logs.RemoveAt(0); } }
    int B(string key) { return GameTables.Value(key); }
    DataRow JobData() { return GameTables.current.jobs.At(job < 0 ? 0 : job); }
    DataRow SkillData() { return GameTables.current.skills.At(JobData().Int("skill_id")); }
    DataRow SkillAtSlot(int slot) {
        DataRow fallback = SkillData();
        foreach (DataRow row in GameTables.current.skills.rows) { if (row.Int("job") == job && row.Int("slot") == slot) { return row; } }
        return fallback;
    }
    int SkillRank(int slot) { if (slot < 0 || slot >= 8) { return 0; } return slot == 0 && skillRanks[slot] <= 0 ? skill : (skillRanks[slot] <= 0 ? 1 : skillRanks[slot]); }
    bool IsSkillEquipped(int slot) { return slot >= 0 && slot < 8 && skillEquipped[slot]; }
    void InitSkills() { for (int i = 0; i < 8; i = i + 1) { skillRanks[i] = 1; skillEquipped[i] = true; } skill = 1; }
    void ToggleSkill(int slot) {
        if (job < 0 || slot < 0 || slot >= 8) { return; }
        if (IsSkillEquipped(slot) && SkillAtSlot(slot).Text("kind") == "active") {
            int active = 0; for (int i = 0; i < 8; i = i + 1) { if (IsSkillEquipped(i) && SkillAtSlot(i).Text("kind") == "active") { active = active + 1; } }
            if (active <= 1) { Log("至少保留一个主动技能装备。每回合按槽位顺序施放可用技能。"); return; }
        }
        skillEquipped[slot] = !skillEquipped[slot]; Log((skillEquipped[slot] ? "装备" : "卸下") + "技能：" + SkillAtSlot(slot).Text("name"));
    }
    int NeedXp() { return GameTables.current.levels.At(level).Int("xp"); }
    int GearPower() { int n = 0; foreach (Equipment e in equipped) { if (e != null) { n = Rules.Bounded((long)n + e.Power()); } } return n; }
    string AttackSchool() { return JobData().Text("attack_school"); }
    int Stat(string key) {
        DataRow j = JobData(); DataRow rule = GameTables.current.attributes.Get(key);
        long value = (long)j.Int(key + "_base") + (long)level * j.Int(key + "_level");
        foreach (Equipment e in equipped) { if (e != null && e.CanWear(job, level, rebirth)) { value = value + e.Stat(key); } }
        foreach (DataRow inner in GameTables.current.innerPower.rows) { if (inner.Text("stat") == key) { value = value + (long)innerRanks[inner.Int("id")] * inner.Int("value_per_level"); } }
        foreach (DataRow e in GameTables.current.elements.rows) { if (e.Text("stat") == key) { value = value + (long)elementRanks[e.Int("id")] * e.Int("value_per_level"); } }
        foreach (DataRow gem in GameTables.current.gems.rows) { if (gem.Text("stat") == key) { value = value + (long)gemRanks[gem.Int("id")] * gem.Int("value_per_level"); } }
        value = value + SetBonus(key);
        bool offense = key == AttackSchool() + "_min" || key == AttackSchool() + "_max";
        value = value + (offense ? (long)SkillRank(0) * rule.Int("skill_flat") : 0) + (long)training * rule.Int("training_flat") + (long)collection * rule.Int("collection_flat") + (long)rebirth * rule.Int("rebirth_flat");
        long passive = 0;
        foreach (DataRow ability in GameTables.current.skills.rows) {
            if (ability.Int("job") == job && IsSkillEquipped(ability.Int("slot")) && ability.Text("kind") == "passive") {
                if (offense) { passive = passive + (long)SkillRank(ability.Int("slot")) * ability.Int("passive_damage_pct"); }
                if (key == "defense" || key == "magic_defense") { passive = passive + (long)SkillRank(ability.Int("slot")) * ability.Int("passive_defense_pct"); }
            }
        }
        long scaled = value * (100 + rebirth * rule.Int("rebirth_pct") + title * rule.Int("title_pct")) / 100;
        return Rules.Bounded(scaled + passive);
    }
    int StatMax(string group) { int lo = Stat(group + "_min"); int hi = Stat(group + "_max"); return hi < lo ? lo : hi; }
    string StatPair(string group) { return Rules.N(Stat(group + "_min")) + "–" + Rules.N(StatMax(group)); }
    int RollRange(int lo, int hi) { return hi <= lo ? lo : lo + Random(hi - lo + 1); }
    int RollStat(string group) { return RollRange(Stat(group + "_min"), StatMax(group)); }
    int Attack() { return StatMax(AttackSchool()); }
    int Defense() { return StatMax("defense"); }
    int MaxHp() { return Stat("hp"); }
    int MaxMp() { return Stat("mp"); }
    int Power() {
        long value = 0;
        foreach (DataRow rule in GameTables.current.attributes.rows) { value = value + (long)Stat(rule.Text("id")) * rule.Int("score_weight") / 100; }
        return Rules.Bounded(value);
    }
    // Combat definitions are resolved by ID, not stale attribute snapshots in saves.
    DataRow EnemyData() { return mode == 1 ? GameTables.current.bosses.At(challenge) : GameTables.current.monsters.At(GameTables.current.Map(floor).Int("monster_id")); }
    string EnemySchool() { return mode >= 2 ? GameTables.current.encounters.At(mode).Text("attack_school") : EnemyData().Text("attack_school"); }
    int EnemyStat(string group, bool maximum) {
        int value = 0;
        if (mode >= 2) {
            DataRow e = GameTables.current.encounters.At(mode); int progress = EncounterProgress(e);
            string key = group == "defense" || group == "magic_defense" ? group : "attack";
            value = Rules.Bounded((long)e.Int(key + "_base") + (long)progress * e.Int(key + "_linear"));
            if (!maximum) { value = (int)((long)value * e.Int(key + "_min_pct") / 100); }
        } else {
            value = EnemyData().Int(group + (maximum ? "_max" : "_min"));
            if (mode == 0 && wave >= B("wave_count") && group != "defense" && group != "magic_defense") { value = Rules.Bounded((long)value * B("guardian_attack_pct") / 100); }
        }
        return value;
    }
    int RollEnemy(string group) { return RollRange(EnemyStat(group, false), EnemyStat(group, true)); }
    int Hit(int attack, int defense) { return Rules.Clamp(attack - defense, 1, 10000000); }
    int Strike(string school, int percent) { return Hit(Rules.Bounded((long)RollStat(school) * percent / 100), RollEnemy(school == "attack" ? "defense" : "magic_defense")); }
    void Gold(int amount) { gold = Rules.Bounded((long)gold + amount); if (amount > 0) { earned = Rules.Bounded((long)earned + amount); } }
    bool Pay(int coins, int ore, int yuan) {
        if (coins < 0 || ore < 0 || yuan < 0 || gold < coins || iron < ore || gems < yuan) { Log("资源不足：需要金币 " + Rules.N(coins) + " / 黑铁 " + Rules.N(ore) + " / 元宝 " + Rules.N(yuan)); return false; }
        gold = gold - coins; iron = iron - ore; gems = gems - yuan; return true;
    }
    int RuneCount(int level) { return level < 1 || level > 14 ? 0 : runeCounts[level - 1]; }
    void AddRune(int level, int amount) {
        if (level < 1 || level > 14 || amount <= 0) { return; }
        runeCounts[level - 1] = Rules.Clamp((long)runeCounts[level - 1] + amount, 0, 1000000);
    }
    bool SynthesizeRune(int level) {
        if (level < 1 || level > 11) { Log("1#至11#符文才可合成更高等级。"); return false; }
        if (runeCounts[level - 1] < 3) { Log(Rules.N(level) + "#符文不足，需要3枚同级符文。"); return false; }
        runeCounts[level - 1] = runeCounts[level - 1] - 3;
        runeCounts[level] = Rules.Clamp((long)runeCounts[level] + 1, 0, 1000000);
        Log(Rules.N(level) + "#符文合成成功，获得1枚" + Rules.N(level + 1) + "#符文。"); return true;
    }
    bool DowngradeRune(int level) {
        if (level < 2 || level > 12) { Log("2#至12#符文才可降级。"); return false; }
        if (runeCounts[level - 1] < 1 || iron < 10) { Log("符文降级需要1枚当前符文和10黑铁。"); return false; }
        runeCounts[level - 1] = runeCounts[level - 1] - 1;
        iron = iron - 10;
        runeCounts[level - 2] = Rules.Clamp((long)runeCounts[level - 2] + 1, 0, 1000000);
        Log(Rules.N(level) + "#符文降级成功，获得1枚" + Rules.N(level - 1) + "#符文。"); return true;
    }
    bool ConsumeRune(int level, int amount) {
        if (level < 1 || level > 14 || RuneCount(level) < amount) { return false; }
        runeCounts[level - 1] = Rules.Clamp((long)runeCounts[level - 1] - amount, 0, 1000000); return true;
    }
    int DragonBallCount(int star) { return star < 1 || star > 9 ? 0 : dragonBalls[star - 1]; }
    void AddDragonBall(int star, int amount) {
        if (star < 1 || star > 9 || amount <= 0) { return; }
        dragonBalls[star - 1] = Rules.Clamp((long)dragonBalls[star - 1] + amount, 0, 1000000);
    }
    // Rune-word legendaries are contiguous definition blocks: three chains of legend_form_count forms.
    bool IsLegendForm(Equipment e) { return e != null && e.definitionId >= B("legend_first_form") && e.definitionId < B("legend_first_form") + B("legend_form_count") * 3; }
    int LegendFormStep(Equipment e) { return (e.definitionId - B("legend_first_form")) % B("legend_form_count") + 1; }
    bool IsLegendBase(int index, int kind) {
        if (index < 0 || index >= bag.Count || kind < 0 || kind > 2) { return false; }
        int baseId = kind == 0 ? B("legend_sword_base") : (kind == 1 ? B("legend_robe_male_base") : B("legend_robe_female_base"));
        return bag[index].definitionId == baseId;
    }
    string BagItemAt(int index) { return index >= 0 && index < bag.Count ? bag[index].Name() : ""; }
    bool LegendReady(int kind, int index) {
        if (!IsLegendBase(index, kind) || bag[index].locked) { return false; }
        return legendOre >= B("rune_word_ore") && RuneCount(B("rune_word_rune")) >= 1;
    }
    bool GrowReady(int index) {
        if (index < 0 || index >= bag.Count) { return false; }
        Equipment e = bag[index];
        if (!IsLegendForm(e) || e.locked) { return false; }
        int step = LegendFormStep(e);
        return step < B("legend_form_count") && DragonBallCount(step) >= B("form_growth_balls") && RuneCount(B("form_growth_rune")) >= 1;
    }
    // 公开配方：传说武器/衣 = 基础装备 + 传说矿石 + 13#（产品文档 7.4；系数/品阶/强化由模板规则保留）。
    bool CraftLegend(int kind, int index) {
        if (job < 0 || kind < 0 || kind > 2 || index < 0 || index >= bag.Count) { return false; }
        Equipment sourceBase = bag[index];
        if (!IsLegendBase(index, kind)) { Log("请先在背包选中配方要求的基础装备。"); return false; }
        if (sourceBase.locked) { Log("锻造基础已锁定，请先解锁。"); return false; }
        int oreCost = B("rune_word_ore"); int runeLevel = B("rune_word_rune");
        if (legendOre < oreCost) { Log("传说矿石不足，需要 " + Rules.N(oreCost) + "，本次未消耗任何材料。"); return false; }
        if (RuneCount(runeLevel) < 1) { Log(Rules.N(runeLevel) + "#符文不足，本次未消耗任何材料。"); return false; }
        int resultId = B("legend_first_form") + kind * B("legend_form_count");
        legendOre = legendOre - oreCost; ConsumeRune(runeLevel, 1);
        Equipment legendary = new Equipment(); legendary.definitionId = resultId; legendary.slot = sourceBase.slot; legendary.tier = sourceBase.tier;
        legendary.coefficient = sourceBase.coefficient; legendary.level = sourceBase.level; legendary.upgrade = sourceBase.upgrade;
        bag.RemoveAt(index); bag.Add(legendary);
        hp = Rules.Clamp(hp, 0, MaxHp()); mp = Rules.Clamp(mp, 0, MaxMp());
        Log("符文之语合成成功：" + sourceBase.Name() + " → " + legendary.Name() + "。消耗传说矿石 " + Rules.N(oreCost) + " 与1枚" + Rules.N(runeLevel) + "#符文。"); return true;
    }
    // 形态增长：传说装备[第N形态] + 龙珠N★×配置数量 + 新13# → 下一形态，保留系数/品阶/强化。
    bool GrowLegendForm(int index) {
        if (job < 0 || index < 0 || index >= bag.Count) { return false; }
        Equipment e = bag[index];
        if (!IsLegendForm(e)) { Log("请先在背包选中一件传说形态装备。"); return false; }
        if (e.locked) { Log("传说装备已锁定，请先解锁。"); return false; }
        int step = LegendFormStep(e);
        if (step >= B("legend_form_count")) { Log("已至第九形态；更高形态依赖传奇黄材料，模板未收录，不能增长。"); return false; }
        int runeLevel = B("form_growth_rune"); int ballCost = B("form_growth_balls");
        if (DragonBallCount(step) < ballCost) { Log("龙珠" + Rules.N(step) + "★不足，需要 " + Rules.N(ballCost) + " 颗，本次未消耗任何材料。"); return false; }
        if (RuneCount(runeLevel) < 1) { Log(Rules.N(runeLevel) + "#符文不足，本次未消耗任何材料。"); return false; }
        dragonBalls[step - 1] = dragonBalls[step - 1] - ballCost; ConsumeRune(runeLevel, 1);
        e.definitionId = e.definitionId + 1;
        hp = Rules.Clamp(hp, 0, MaxHp()); mp = Rules.Clamp(mp, 0, MaxMp());
        Log("形态增长成功：" + e.Name() + "（第 " + Rules.N(step + 1) + " 形态）。消耗龙珠" + Rules.N(step) + "★ ×" + Rules.N(ballCost) + " 与1枚" + Rules.N(runeLevel) + "#符文。"); return true;
    }
    Equipment CreateItem(int definitionId, int tier, int atLevel) {
        DataRow d = GameTables.current.items.At(definitionId);
        if (d.Int("slot") < 0) { throw new Exception("Cannot equip non-equipment item " + Rules.N(definitionId)); }
        DataRow quality = GameTables.current.qualities.At(tier);
        Equipment e = new Equipment(); e.definitionId = definitionId; e.slot = d.Int("slot"); e.tier = tier;
        e.level = Rules.Clamp(atLevel, 1, GameTables.current.levels.rows.Count);
        e.coefficient = quality.Int("coefficient_min") + Random(quality.Int("coefficient_max") - quality.Int("coefficient_min") + 1); return e;
    }
    Equipment Make(int slot, int tier, int atLevel) {
        int group = GameTables.current.slots.At(slot).Int("group"); int id = 0; int minimum = 0;
        foreach (DataRow d in GameTables.current.items.rows) {
            if (d.Int("slot") == group && d.Int("min_level") <= atLevel && (id == 0 || d.Int("min_level") > minimum)) { id = d.Int("id"); minimum = d.Int("min_level"); }
        }
        if (id == 0) { foreach (DataRow d in GameTables.current.items.rows) { if (d.Int("slot") == group) { id = d.Int("id"); break; } } }
        Equipment e = CreateItem(id, tier, atLevel); e.slot = slot; return e;
    }
    void Choose(int selected) {
        if (job >= 0 || !GameTables.current.jobs.index.ContainsKey(Rules.N(selected))) { return; }
        job = selected; InitSkills(); DataRow j = JobData(); equipped[0] = CreateItem(j.Int("weapon_id"), 0, 1);
        bag.Add(CreateItem(j.Int("armor_id"), 1, 1)); bag.Add(CreateItem(j.Int("helmet_id"), 0, 1));
        hp = MaxHp(); mp = MaxMp(); Spawn(); Log("欢迎，" + Rules.Job(job) + "。初始装备由职业配置表发放。");
    }
    void GainXp(int amount) {
        xp = xp + amount;
        while (level < GameTables.current.levels.rows.Count && xp >= NeedXp()) { xp = xp - NeedXp(); level = level + 1; hp = MaxHp(); mp = MaxMp(); Log("等级提升至 " + Rules.N(level) + "，生命与法力已恢复。"); }
        if (level >= GameTables.current.levels.rows.Count) { xp = 0; }
    }
    void ResetDay(long now) {
        long d = now / 86400;
        if (d <= day) { return; }
        day = d; dailyClaim = 0; bountyClaim = 0; dailyKills = 0;
        bossTries = B("boss_tries"); arenaTries = B("arena_tries"); escortTries = B("escort_tries"); treasureDraws = 0;
    }
    void Spawn() {
        round = 0;
        int f = floor;
        DataRow m = GameTables.current.Map(floor);
        DataRow monster = GameTables.current.monsters.At(m.Int("monster_id"));
        enemyName = Rules.Monster(f, wave >= B("wave_count"));
        enemyMax = monster.Int("hp");
        if (wave >= B("wave_count")) { enemyMax = Rules.Bounded((long)enemyMax * B("guardian_hp_pct") / 100); }
        if (mode == 1) {
            DataRow boss = GameTables.current.bosses.At(challenge);
            enemyName = boss.Text("name"); enemyMax = boss.Int("hp");
        }
        if (mode >= 2) {
            DataRow e = GameTables.current.encounters.At(mode); int progress = EncounterProgress(e);
            enemyName = e.Text("name") + " · " + Rules.N(progress);
            enemyMax = Rules.Bounded((long)e.Int("hp_base") + (long)progress * e.Int("hp_linear") + (long)progress * progress * e.Int("hp_square"));
            enemyAttack = Rules.Bounded((long)e.Int("attack_base") + (long)progress * e.Int("attack_linear"));
            enemyDefense = Rules.Bounded((long)e.Int("defense_base") + (long)progress * e.Int("defense_linear"));
        }
        if (mode == 4) {
            enemyName = "秘境第 " + Rules.N(secretFloor) + " 层 · " + (secretWave >= B("secret_wave_count") ? "守关首领" : "秘境游荡者");
            if (secretWave < B("secret_wave_count")) { enemyMax = Rules.Bounded((long)enemyMax * B("secret_mob_hp_pct") / 100); }
        }
        enemyAttack = EnemyStat(EnemySchool(), true); enemyDefense = EnemyStat("defense", true);
        enemyHp = enemyMax;
    }
    int EncounterProgress(DataRow e) { string p = e.Text("progress"); if (p == "tower") { return tower + 1; } if (p == "secrets") { return secretFloor; } return rebirth; }
    void Loot(int guaranteed) { LootPool(guaranteed, GameTables.current.Map(floor).Int("drop_pool"), true); }
    void LootPool(int guaranteed, int pool, bool applyFilter) {
        int total = 0; foreach (DataRow q in GameTables.current.qualities.rows) { total = total + q.Int("weight"); }
        int roll = Random(total); int tier = 0;
        foreach (DataRow q in GameTables.current.qualities.rows) { roll = roll - q.Int("weight"); if (roll < 0) { tier = q.Int("id"); break; } }
        if (tier < guaranteed) { tier = guaranteed; }
        total = 0;
        foreach (DataRow row in GameTables.current.drops.rows) { if (row.Int("pool") == pool) { total = total + row.Int("weight"); } }
        roll = Random(total); int itemId = 0;
        foreach (DataRow row in GameTables.current.drops.rows) { if (row.Int("pool") == pool) { roll = roll - row.Int("weight"); if (roll < 0) { itemId = row.Int("item_id"); break; } } }
        Equipment e = CreateItem(itemId, tier, level);
        if ((e.slot == 4 || e.slot == 6) && Random(2) == 1) { e.slot = e.slot + 1; }
        if (applyFilter && !KeepDrop(e)) { return; }
        if (bag.Count >= capacity) { Log("背包已满，掉落未拾取。"); return; }
        bag.Add(e); Log("拾获 " + e.Name() + " · " + Rules.Quality(e.tier));
    }
    void Victory() {
        tp = Rules.Clamp(tp + B("inner_tp_per_kill"), 0, B("inner_tp_cap"));
        kills = Rules.Clamp(kills + 1, 0, 1000000000); dailyKills = dailyKills + 1;
        if (mode == 4) {
            DataRow reward = GameTables.current.encounters.At(4);
            if (secretWave >= B("secret_wave_count")) {
                Gold(Rules.Bounded((long)reward.Int("gold") + (long)secretFloor * reward.Int("gold_linear")));
                GainXp(reward.Int("xp") + secretFloor * reward.Int("xp_floor"));
                iron = Rules.Clamp(iron + reward.Int("iron"), 0, 1000000);
                gems = Rules.Clamp(gems + reward.Int("yuan"), 0, 1000000); runes = Rules.Clamp(runes + reward.Int("runes"), 0, 1000000);
                LootPool(reward.Int("quality"), reward.Int("drop_pool"), true);
                if (secretFloor > secrets) { secrets = secretFloor; }
                Log("秘境第 " + Rules.N(secretFloor) + " 层通关，独立结算奖励。"); secretWave = 0;
                if (secretAutoPush && secretFloor < reward.Int("max_progress")) { secretFloor = secretFloor + 1; }
                else if (secretAutoPush) { active = false; Log("已到秘境配置上限，停留秘境等待操作。"); }
            } else { secretWave = secretWave + 1; GainXp(reward.Int("xp")); }
            hp = MaxHp(); mp = MaxMp(); Spawn(); return;
        }
        if (mode != 0) {
            int wonMode = mode;
            DataRow reward = mode == 1 ? GameTables.current.bosses.At(challenge) : GameTables.current.encounters.At(mode);
            int rewardGold = reward.Int("gold"); if (mode >= 2) { rewardGold = Rules.Bounded((long)rewardGold + (long)EncounterProgress(reward) * reward.Int("gold_linear")); }
            mode = 0; Gold(rewardGold); iron = Rules.Clamp(iron + reward.Int("iron"), 0, 1000000); gems = Rules.Clamp(gems + reward.Int("yuan"), 0, 1000000); runes = Rules.Clamp(runes + reward.Int("runes"), 0, 1000000);
            if (wonMode == 1) { bossWins = bossWins + 1; } if (wonMode == 2) { tower = tower + 1; } if (wonMode == 4) { secrets = secrets + 1; }
            GainXp(reward.Int("xp") + floor * reward.Int("xp_floor")); LootPool(reward.Int("quality"), reward.Int("drop_pool"), true); Log("首领击败！已按配置结算奖励。"); active = fieldActive;
            hp = MaxHp(); mp = MaxMp(); Spawn();
            if (wonMode == 1 && bossAutoNext) {
                for (int i = 0; i < GameTables.current.bosses.rows.Count - 1; i = i + 1) {
                    if (GameTables.current.bosses.rows[i].Int("id") == challenge) { Challenge(1, i + 1); return; }
                }
                Log("本轮个人 BOSS 列表已挑战完毕。");
            }
            return;
        }
        DataRow rewardMap = GameTables.current.Map(floor); Gold(rewardMap.Int("gold")); GainXp(rewardMap.Int("xp"));
        if (Random(100) < B("drop_chance") || wave >= B("wave_count")) { Loot(0); }
        if (Random(100) < B("iron_chance")) { iron = Rules.Clamp(iron + 1, 0, 1000000); }
        if (Random(100) < B("potion_chance")) { potions = Rules.Clamp(potions + 1, 0, 9999); }
        if (wave >= B("wave_count")) {
            wave = 0; hp = MaxHp(); mp = MaxMp();
            if (travelMap >= 0) { Log(LocationName() + "驻守：这一轮波次清剿完毕，继续驻守刷怪；幻境推层在返回后继续。"); }
            else if (autoPush && floor < B("max_floor") && CanEnter(GameTables.current.Map(floor + 1))) { floor = floor + 1; if (floor > best) { best = floor; gems = Rules.Clamp(gems + B("first_clear_yuan"), 0, 1000000); Log("突破幻境 " + Rules.N(floor - 1) + "层 · 首通元宝 +" + Rules.N(B("first_clear_yuan"))); } }
        } else { wave = wave + 1; hp = Rules.Clamp(Rules.Bounded((long)hp + (long)MaxHp() * B("between_wave_heal_pct") / 100), 0, MaxHp()); }
        Spawn();
    }
    void Step(long now) {
        ResetDay(now);
        if (job >= 0 && elementTraining && elementPool < B("element_pool_cap")) {
            elementPool = Rules.Clamp(Rules.Bounded((long)elementPool + B("element_xp_per_second")), 0, B("element_pool_cap"));
            elementSeconds = Rules.Clamp(elementSeconds + 1, 0, 1000000000);
        }
        if (escortLeft > 0) { escortLeft = escortLeft - 1; if (escortLeft == 0) { Gold(escortReward); merit = Rules.Bounded((long)merit + B("escort_merit")); Log("镖车平安抵达！金币 +" + Rules.N(escortReward) + "，声望 +" + Rules.N(B("escort_merit"))); } }
        if (job < 0 || !active) { return; }
        tick = tick >= 2000000000 ? 0 : tick + 1;
        if (recovery > 0) { recovery = recovery - 1; if (recovery == 0) { hp = MaxHp(); mp = MaxMp(); Spawn(); } return; }
        if (enemyHp <= 0) { Spawn(); }
        round = round + 1;
        mp = Rules.Clamp(mp + B("mp_regen"), 0, MaxMp());
        if (autoPotion && (long)hp * 100 < (long)MaxHp() * B("potion_trigger_pct") && potions > 0) { potions = potions - 1; hp = Rules.Clamp(Rules.Bounded((long)hp + (long)MaxHp() * B("potion_heal_pct") / 100), 0, MaxHp()); }
        int damage = Strike(AttackSchool(), 100);
        bool critical = Random(100) < B("critical_chance");
        if (critical) { damage = Rules.Bounded((long)damage * B("critical_damage_pct") / 100); }
        for (int slot = 0; slot < 8; slot = slot + 1) {
            DataRow ability = SkillAtSlot(slot); int rank = SkillRank(slot);
            if (IsSkillEquipped(slot) && ability.Text("kind") == "active" && ability.Int("cooldown") > 0 && tick % ability.Int("cooldown") == 0 && mp >= ability.Int("mana")) {
                mp = mp - ability.Int("mana");
                damage = Rules.Bounded((long)damage + Strike(ability.Text("school"), ability.Int("damage_pct") + rank * ability.Int("damage_per_level")));
                hp = Rules.Clamp(Rules.Bounded((long)hp + (long)MaxHp() * (ability.Int("heal_pct") + rank * ability.Int("heal_per_level")) / 100), 0, MaxHp());
                break;
            }
        }
        if (JobData().Int("pet_attack_pct") > 0) { damage = Rules.Bounded((long)damage + Strike(AttackSchool(), JobData().Int("pet_attack_pct"))); }
        damage = Rules.Clamp(damage, 1, 10000000); enemyHp = enemyHp - damage;
        if (enemyHp <= 0) { Victory(); return; }
        int incoming = Hit(RollEnemy(EnemySchool()), RollStat(EnemySchool() == "attack" ? "defense" : "magic_defense"));
        incoming = (int)((long)incoming * JobData().Int("damage_taken_pct") / 100);
        hp = hp - incoming;
        if (hp <= 0 || round >= B("round_limit")) {
            hp = 0; deaths = deaths + 1; recovery = B("recovery_seconds");
            if (mode == 0 && autoPush && floor > 1) { floor = floor - 1; }
            if (mode == 4) { secretWave = 0; if (secretAutoPush && secretFloor > 1) { secretFloor = secretFloor - 1; } }
            else if (mode == 0) { wave = 0; }
            // Keep a failed challenge isolated until revival/explicit withdrawal.
            Log("战斗失利，" + Rules.N(B("recovery_seconds")) + "秒后复活。装备不丢失。");
        }
    }
    void Advance(int seconds, long until) { seconds = Rules.Clamp(seconds, 0, B("offline_seconds")); for (int i = 0; i < seconds; i = i + 1) { Step(until - seconds + i + 1); } }
    void Wear(int index) {
        if (index < 0 || index >= bag.Count) { return; }
        Equipment e = bag[index]; if (!e.CanWear(job, level, rebirth)) { Log("未达到装备需求：等级、职业或转生不符。"); return; } Equipment old = equipped[e.slot];
        equipped[e.slot] = e; bag.RemoveAt(index); if (old != null) { bag.Add(old); }
        hp = Rules.Clamp(hp, 0, MaxHp()); mp = Rules.Clamp(mp, 0, MaxMp()); Log("已穿戴 " + e.Name());
    }
    void Unequip(int slot) {
        if (slot < 0 || slot >= 12 || equipped[slot] == null) { return; }
        if (bag.Count >= capacity) { Log("背包已满，无法卸下装备。"); return; }
        bag.Add(equipped[slot]); equipped[slot] = null;
        hp = Rules.Clamp(hp, 0, MaxHp()); mp = Rules.Clamp(mp, 0, MaxMp()); Log("装备已卸下并放入背包。");
    }
    void Sell(int index) {
        if (index < 0 || index >= bag.Count) { return; }
        Equipment e = bag[index]; if (e.locked) { Log("此装备已锁定，请先解锁。"); return; }
        int price = GameTables.current.items.At(e.definitionId).Int("sell_price");
        if (price <= 0) { Log("该物品不可出售。"); return; }
        if ((long)gold + price > 1000000000) { Log("金币已达上限，请先使用金币。"); return; }
        Gold(price); bag.RemoveAt(index); Log("出售 " + e.Name() + " · 金币 +" + Rules.N(price));
    }
    void SortInventory(bool vault) {
        List<Equipment> items = vault ? storage : bag;
        // Stable insertion sort: slot first, then the current profession's score.
        for (int i = 1; i < items.Count; i = i + 1) {
            Equipment e = items[i]; int j = i - 1;
            while (j >= 0 && (items[j].slot > e.slot || (items[j].slot == e.slot && items[j].Score(AttackSchool()) < e.Score(AttackSchool())))) { items[j + 1] = items[j]; j = j - 1; }
            items[j + 1] = e;
        }
        Log(vault ? "仓库已整理；未改变穿戴。" : "背包已整理；未改变穿戴。");
    }
    int InnerCost(int slot) { DataRow r = GameTables.current.innerPower.At(slot); return r.Int("tp") + innerRanks[slot] * r.Int("tp_per_level"); }
    DataRow GemData(int id) { return GameTables.current.gems.At(id); }
    int GemGoldCost(int id) { DataRow r = GemData(id); return r.Int("gold") + gemRanks[id] * r.Int("gold") / 2; }
    int GemIronCost(int id) { return GemData(id).Int("iron") + gemRanks[id]; }
    int GemYuanCost(int id) { return GemData(id).Int("yuan") + gemRanks[id]; }
    int GemSynthesisGoldCost(int id) { DataRow r = GemData(id); return r.Int("synthesis_gold") + gemRanks[id] * r.Int("synthesis_gold") / 2; }
    int GemSynthesisIronCost(int id) { DataRow r = GemData(id); return r.Int("synthesis_iron") + gemRanks[id]; }
    int GemSynthesisYuanCost(int id) { DataRow r = GemData(id); return r.Int("synthesis_yuan") + gemRanks[id]; }
    void SynthesizeGem(int id) {
        if (job < 0 || id < 0 || id >= 6) { return; }
        DataRow r = GemData(id); int rank = gemRanks[id];
        if (rank >= r.Int("synthesis_max_level")) { Log("该宝石已达到合成上限，请使用普通升级。"); return; }
        int goldCost = GemSynthesisGoldCost(id); int ironCost = GemSynthesisIronCost(id); int yuanCost = GemSynthesisYuanCost(id);
        if (!Pay(goldCost, ironCost, yuanCost)) { return; }
        gemRanks[id] = rank + 1;
        Log(r.Text("name") + "合成至 " + Rules.N(gemRanks[id]) + "级，属性已生效。");
    }
    void UpgradeGem(int id) {
        if (job < 0 || id < 0 || id >= 6) { return; }
        DataRow r = GemData(id);
        if (gemRanks[id] >= r.Int("max_level")) { Log("该宝石已满级。"); return; }
        int goldCost = GemGoldCost(id); int ironCost = GemIronCost(id); int yuanCost = GemYuanCost(id);
        if (!Pay(goldCost, ironCost, yuanCost)) { return; }
        gemRanks[id] = gemRanks[id] + 1;
        Log(r.Text("name") + "提升至 " + Rules.N(gemRanks[id]) + "级，属性已生效。");
    }
    void InheritTianShu(int index) {
        // The worn book is the destination; the selected bag book is consumed only after every check passes.
        if (job < 0 || index < 0 || index >= bag.Count) { return; }
        Equipment source = bag[index]; Equipment target = equipped[11];
        if (target == null || source == null || source.slot != 11 || target.slot != 11) { Log("需要穿戴目标天书，并在背包选择传承材料。"); return; }
        if (source.locked) { Log("传承材料已锁定，请先解锁。"); return; }
        if (source.coefficient <= target.coefficient) { Log("传承材料系数必须高于当前天书，未消耗。"); return; }
        int before = target.coefficient; target.coefficient = source.coefficient;
        bag.RemoveAt(index); hp = Rules.Clamp(hp, 0, MaxHp()); mp = Rules.Clamp(mp, 0, MaxMp());
        Log("天书传承成功：系数 " + Rules.N(before) + " → " + Rules.N(target.coefficient) + "，材料已消耗。");
    }
    void TrainInner(int slot) {
        if (job < 0 || slot < 0 || slot >= 8) { return; }
        DataRow r = GameTables.current.innerPower.At(slot);
        if (innerRanks[slot] >= r.Int("max_level")) { Log("此内功已满级。"); return; }
        int cost = InnerCost(slot);
        if (tp < cost || iron < r.Int("iron")) { Log("内功升级需要 TP " + Rules.N(cost) + " / 黑铁 " + Rules.N(r.Int("iron"))); return; }
        tp = tp - cost; iron = iron - r.Int("iron"); innerRanks[slot] = innerRanks[slot] + 1;
        Log(r.Text("name") + "提升至 " + Rules.N(innerRanks[slot]) + "级，属性已生效。");
    }
    void BestGear() {
        for (int slot = 0; slot < 12; slot = slot + 1) {
            int selected = -1; int power = -1; if (equipped[slot] != null) { power = equipped[slot].Score(AttackSchool()); }
            for (int i = 0; i < bag.Count; i = i + 1) { if (bag[i].slot == slot && bag[i].CanWear(job, level, rebirth) && bag[i].Score(AttackSchool()) > power) { selected = i; power = bag[i].Score(AttackSchool()); } }
            if (selected >= 0) { Wear(selected); }
        }
        Log("已按部位穿戴最高强度装备；锁定装备不会被分解。");
    }
    bool KeepDrop(Equipment e) {
        if (e == null || e.tier < filter || e.coefficient < filterCoefficient || (filterMinLevel > 0 && e.level < filterMinLevel)) { return false; }
        DataRow d = GameTables.current.items.At(e.definitionId); int required = d.Int("required_job");
        return !filterJobOnly || required < 0 || required == job;
    }
    void CycleFilterLevel() {
        if (filterMinLevel == 0) { filterMinLevel = 10; }
        else if (filterMinLevel == 10) { filterMinLevel = 20; }
        else if (filterMinLevel == 20) { filterMinLevel = 40; }
        else if (filterMinLevel == 40) { filterMinLevel = 60; }
        else if (filterMinLevel == 60) { filterMinLevel = 80; }
        else { filterMinLevel = 0; }
    }
    void CycleFilterCoefficient() { filterCoefficient = filterCoefficient >= B("equipment_coefficient_max") ? 1 : filterCoefficient + 1; }
    int ElementNeed(int id) { DataRow e = GameTables.current.elements.At(id); return e.Int("xp_base") + elementRanks[id] * e.Int("xp_step"); }
    int ElementIronCost(int id) { DataRow e = GameTables.current.elements.At(id); return e.Int("upgrade_iron") + elementRanks[id] * e.Int("upgrade_iron_step"); }
    int ElementYuanCost(int id) { DataRow e = GameTables.current.elements.At(id); return e.Int("upgrade_yuan") + elementRanks[id] * e.Int("upgrade_yuan_step"); }
    void InjectElement(int id) {
        if (job < 0 || id < 0 || id >= 5) { return; }
        if (elementRanks[id] >= GameTables.current.elements.At(id).Int("max_level")) { Log("该五行已满级。"); return; }
        int amount = ElementNeed(id) - elementXp[id]; if (amount > elementPool) { amount = elementPool; }
        if (amount <= 0) { Log("经验已满请升级，或先开始修炼积累经验。"); return; }
        elementPool = elementPool - amount; elementXp[id] = elementXp[id] + amount; Log("已注入修炼经验 " + Rules.N(amount));
    }
    void UpgradeElement(int id) {
        if (job < 0 || id < 0 || id >= 5) { return; }
        DataRow e = GameTables.current.elements.At(id);
        if (elementRanks[id] >= e.Int("max_level") || elementXp[id] < ElementNeed(id)) { Log("经验不足或已满级，请先注入。"); return; }
        int ironCost = ElementIronCost(id); int yuanCost = ElementYuanCost(id);
        if (!Pay(0, ironCost, yuanCost)) { Log("突破材料不足，五行经验未消耗。"); return; }
        elementXp[id] = elementXp[id] - ElementNeed(id); elementRanks[id] = elementRanks[id] + 1;
        Log(e.Text("name") + "行升至 " + Rules.N(elementRanks[id]) + " 级，消耗黑铁 " + Rules.N(ironCost) + " / 元宝 " + Rules.N(yuanCost) + "，属性已生效。");
    }
    void LeaveChallenge() {
        if (mode == 0) { return; } if (recovery > 0) { Log("请等待复活，不能通过退出跳过恢复。"); return; }
        mode = 0; active = fieldActive; Spawn(); Log("已退出挑战，恢复原挂机状态；秘境进度保留。");
    }
    int RecyclePrice(Equipment e, int currency) {
        if (e == null || currency < 0 || currency > 6) { return 0; }
        DataRow r = GameTables.current.recycle.At(currency);
        return Rules.Bounded((long)GameTables.current.recyclePrices.At(e.definitionId).Int("gold") * r.Int("numerator") / r.Int("denominator"));
    }
    int RecycleBalance(int currency) {
        if (currency == 0) { return gold; } if (currency == 1) { return xp; } if (currency == 2) { return merit; }
        if (currency == 3) { return reputation; } if (currency == 4) { return redPackets; } if (currency == 5) { return gems; } return recyclePoints;
    }
    int RecycleEligibleCount(int currency) {
        if (currency < 0 || currency > 6) { return 0; }
        int count = 0;
        for (int i = 0; i < bag.Count; i = i + 1) { if (!bag[i].locked && RecyclePrice(bag[i], currency) > 0) { count = count + 1; } }
        return count;
    }
    void RecycleAs(Equipment target, int currency) {
        if (job < 0 || target == null || currency < 0 || currency > 6) { return; }
        int index = -1; for (int i = 0; i < bag.Count; i = i + 1) { if (bag[i] == target) { index = i; } }
        if (index < 0) { Log("装备已移动，请重新选择。身上与仓库物品不会被回收。"); return; }
        if (target.locked) { Log("此装备已锁定，请先解锁。"); return; }
        int amount = RecyclePrice(target, currency); DataRow r = GameTables.current.recycle.At(currency);
        if (amount <= 0) { Log("此装备不能兑换该币种，请切换分类。"); return; }
        if ((long)RecycleBalance(currency) + amount > r.Int("cap") || (currency == 1 && level >= GameTables.current.levels.rows.Count)) { Log("余额或等级已达上限，不扣除装备。"); return; }
        bag.RemoveAt(index); recycled = Rules.Bounded((long)recycled + 1);
        if (currency == 0) { Gold(amount); } else if (currency == 1) { GainXp(amount); } else if (currency == 2) { merit = merit + amount; }
        else if (currency == 3) { reputation = reputation + amount; } else if (currency == 4) { redPackets = redPackets + amount; }
        else if (currency == 5) { gems = gems + amount; } else { recyclePoints = recyclePoints + amount; }
        Log("回收 " + target.Name() + " ×1 → " + r.Text("name") + " +" + Rules.N(amount));
    }
    void AddRecycleBalance(int currency, int amount) {
        if (currency == 0) { Gold(amount); } else if (currency == 1) { GainXp(amount); } else if (currency == 2) { merit = Rules.Bounded((long)merit + amount); }
        else if (currency == 3) { reputation = Rules.Bounded((long)reputation + amount); } else if (currency == 4) { redPackets = Rules.Bounded((long)redPackets + amount); }
        else if (currency == 5) { gems = Rules.Clamp(gems + amount, 0, 1000000); } else { recyclePoints = Rules.Bounded((long)recyclePoints + amount); }
    }
    bool RecycleBatch(List<Equipment> targets, int currency) {
        if (job < 0 || targets == null || targets.Count == 0 || currency < 0 || currency > 6) { return false; }
        DataRow r = GameTables.current.recycle.At(currency); long reward = 0;
        for (int t = 0; t < targets.Count; t = t + 1) {
            Equipment target = targets[t]; int index = -1;
            for (int i = 0; i < bag.Count; i = i + 1) { if (bag[i] == target) { index = i; } }
            if (index < 0 || target.locked || RecyclePrice(target, currency) <= 0) { Log("选中的装备已移动、锁定或不能兑换，未消耗任何装备。"); return false; }
            for (int prior = 0; prior < t; prior = prior + 1) { if (targets[prior] == target) { Log("批量回收列表存在重复装备，未消耗任何装备。"); return false; } }
            reward = reward + RecyclePrice(target, currency);
        }
        if (reward <= 0 || (long)RecycleBalance(currency) + reward > r.Int("cap") || (currency == 1 && level >= GameTables.current.levels.rows.Count)) { Log("余额或等级已达上限，未消耗任何装备。"); return false; }
        for (int removed = 0; removed < targets.Count; removed = removed + 1) {
            int removeIndex = -1;
            for (int i = 0; i < bag.Count; i = i + 1) { if (bag[i] == targets[removed]) { removeIndex = i; break; } }
            if (removeIndex >= 0) { bag.RemoveAt(removeIndex); recycled = Rules.Bounded((long)recycled + 1); }
        }
        AddRecycleBalance(currency, (int)reward); Log("批量回收 " + Rules.N(targets.Count) + " 件 → " + r.Text("name") + " +" + Rules.N((int)reward)); return true;
    }
    void Recycle(int index) { if (index >= 0 && index < bag.Count) { RecycleAs(bag[index], 0); } }
    bool IsRecycleWeak(Equipment e) {
        if (e == null || e.locked || e.tier > 1 || e.slot < 0 || e.slot >= 12) { return false; }
        Equipment worn = equipped[e.slot]; return worn != null && worn.Score(AttackSchool()) >= e.Score(AttackSchool());
    }
    int RecycleWeakCount() {
        int count = 0; for (int i = 0; i < bag.Count; i = i + 1) { if (IsRecycleWeak(bag[i])) { count = count + 1; } } return count;
    }
    int RecycleWeakGold() {
        int reward = 0; for (int i = 0; i < bag.Count; i = i + 1) { if (IsRecycleWeak(bag[i])) { reward = Rules.Bounded((long)reward + RecyclePrice(bag[i], 0)); } } return reward;
    }
    void RecycleWeak() {
        int count = RecycleWeakCount(); int reward = RecycleWeakGold(); DataRow currency = GameTables.current.recycle.At(0);
        if (count <= 0) { Log("没有符合条件的低级装备可熔炼。"); return; }
        if ((long)gold + reward > currency.Int("cap")) { Log("批量熔炼收益将超过金币上限，未消耗装备。"); return; }
        for (int i = bag.Count - 1; i >= 0; i = i - 1) { if (IsRecycleWeak(bag[i])) { bag.RemoveAt(i); recycled = Rules.Bounded((long)recycled + 1); } }
        Gold(reward); Log("一键熔炼 " + Rules.N(count) + " 件 → " + currency.Text("name") + " +" + Rules.N(reward));
    }
    void Store(int index, bool withdraw) {
        if (withdraw) {
            if (index < 0 || index >= storage.Count) { return; } if (bag.Count >= capacity) { Log("背包已满。"); return; }
            bag.Add(storage[index]); storage.RemoveAt(index); Log("装备已取回背包。");
        } else {
            if (index < 0 || index >= bag.Count) { return; } if (storage.Count >= B("storage_capacity")) { Log("仓库已满（48格）。"); return; }
            storage.Add(bag[index]); bag.RemoveAt(index); Log("装备已存入仓库。");
        }
    }
    string ForgePreview(int slot, int method) {
        if (slot < 0 || slot >= equipped.Length || equipped[slot] == null) { return "请先穿戴要锻造的装备。"; }
        if (!GameTables.current.forge.index.ContainsKey(Rules.N(method))) { return "未配置此锻造方式。"; }
        DataRow recipe = GameTables.current.forge.At(method); Equipment e = equipped[slot];
        string op = recipe.Text("operation"); int limit = recipe.Int("limit");
        if ((op == "upgrade" && e.upgrade >= limit) || (op == "improve" && e.coefficient >= limit) || (op == "tier" && e.tier >= limit)) { return "此装备已达该配方上限。"; }
        int scale = 1; if (recipe.Text("scale") == "upgrade") { scale = e.upgrade + 1; } if (recipe.Text("scale") == "coefficient") { scale = e.coefficient; }
        int runeCost = recipe.Int("runes") * scale;
        string failure = recipe.Text("failure") == "downgrade" ? "失败：系数 -1（最低为 1）" : "失败：属性保持不变";
        return recipe.Text("name") + " · " + e.Name() + "\n费用：金币 " + Rules.N(recipe.Int("gold") * scale) + " / 黑铁 " + Rules.N(recipe.Int("iron") * scale) + " / 元宝 " + Rules.N(recipe.Int("yuan") * scale) + " / 符文 " + Rules.N(runeCost) + "\n成功率：" + Rules.N(recipe.Int("success_pct")) + "% · " + failure;
    }
    void Forge(int slot, int method) {
        if (slot < 0 || slot >= equipped.Length || equipped[slot] == null) { Log("先穿戴这个部位的装备。"); return; }
        if (!GameTables.current.forge.index.ContainsKey(Rules.N(method))) { Log("未配置此配方。"); return; }
        DataRow recipe = GameTables.current.forge.At(method); Equipment e = equipped[slot];
        string op = recipe.Text("operation"); int limit = recipe.Int("limit");
        if ((op == "upgrade" && e.upgrade >= limit) || (op == "improve" && e.coefficient >= limit) || (op == "tier" && e.tier >= limit)) { Log("已达配方上限。"); return; }
        int scale = 1; if (recipe.Text("scale") == "upgrade") { scale = e.upgrade + 1; } if (recipe.Text("scale") == "coefficient") { scale = e.coefficient; }
        int runeCost = recipe.Int("runes") * scale;
        if (runes < runeCost) { Log("符文不足，本次未扣除其它资源。"); return; }
        if (!Pay(recipe.Int("gold") * scale, recipe.Int("iron") * scale, recipe.Int("yuan") * scale)) { return; }
        runes = runes - runeCost;
        bool success = recipe.Int("success_pct") >= 100 || Random(100) < recipe.Int("success_pct");
        if (!success) {
            if (recipe.Text("failure") == "downgrade") { e.coefficient = Rules.Clamp(e.coefficient - 1, 1, limit); Log(recipe.Text("name") + "失败：" + e.Name() + "系数下降至 " + Rules.N(e.coefficient) + "。材料已消耗。"); }
            else { Log(recipe.Text("name") + "失败：" + e.Name() + "属性保持不变，材料已消耗。"); }
            return;
        }
        if (op == "upgrade") { e.upgrade = e.upgrade + 1; }
        if (op == "reroll") { e.coefficient = 1 + Random(limit); }
        if (op == "improve") { e.coefficient = e.coefficient + 1; }
        if (op == "tier") { e.tier = e.tier + 1; }
        hp = Rules.Clamp(hp, 0, MaxHp()); mp = Rules.Clamp(mp, 0, MaxMp());
        Log(recipe.Text("name") + "成功：" + e.Name());
    }
    bool CodexHas(int definitionId) { for (int i = 0; i < codexItems.Count; i = i + 1) { if (codexItems[i] == definitionId) { return true; } } return false; }
    int CodexCount() { return codexItems.Count; }
    int SetCount(DataRow row) { int count = 0; foreach (string token in row.Text("items").Split("|")) { if (CodexHas(DataTable.Integer(token, "set item"))) { count = count + 1; } } return count; }
    int SetBonus(string key) { int bonus = 0; foreach (DataRow row in GameTables.current.sets.rows) { if (row.Text("stat") == key && SetCount(row) >= row.Int("required")) { bonus = bonus + row.Int("value"); } } return bonus; }
    string SetSummary() {
        string text = "套装收藏（" + Rules.N(CodexCount()) + "件）：";
        foreach (DataRow row in GameTables.current.sets.rows) { int count = SetCount(row); text = text + "\n" + row.Text("name") + " " + Rules.N(count) + "/" + Rules.N(row.Int("required")) + (count >= row.Int("required") ? " · 已激活：" + GameTables.current.attributes.Get(row.Text("stat")).Text("name") + " +" + Rules.N(row.Int("value")) : " · 未激活"); }
        return text;
    }
    void Collect(int index) {
        if (index < 0 || index >= bag.Count) { return; }
        Equipment e = bag[index];
        if (e.locked) { Log("请先解除装备锁定。"); return; }
        if (CodexHas(e.definitionId)) { Log("此件装备定义已收录，装备未消耗。"); return; }
        int rank = e.tier + 1;
        if (collected[e.slot] >= rank) { Log("此部位已收录同级或更高品质，装备未消耗。"); return; }
        collection = collection + rank - collected[e.slot]; collected[e.slot] = rank;
        codexItems.Add(e.definitionId); bag.RemoveAt(index); Log("已消耗装备，提升此部位图鉴等级。");
    }
    void TrainSkill(int slot) {
        if (job < 0 || slot < 0 || slot >= 8) { return; }
        DataRow ability = SkillAtSlot(slot); int rank = SkillRank(slot);
        if (rank >= ability.Int("max_level")) { Log("技能已满级。"); return; }
        if (!Pay(rank * ability.Int("train_gold"), rank * ability.Int("train_iron"), 0)) { return; }
        skillRanks[slot] = rank + 1; if (slot == 0) { skill = skillRanks[slot]; } Log(ability.Text("name") + "提升至 " + Rules.N(skillRanks[slot]) + "级。");
    }
    void Train(int kind) {
        if (kind == 0) { TrainSkill(0); }
        if (kind < 1 || kind > 3) { return; }
        DataRow recipe = GameTables.current.growth.At(kind); int rank = kind == 1 ? training : (kind == 2 ? title : guild);
        if (rank >= recipe.Int("max_level")) { Log("已达配置上限。"); return; }
        int cost = recipe.Int("merit") + rank * recipe.Int("merit_per_level");
        if (merit < cost) { Log("声望不足，需要 " + Rules.N(cost)); return; }
        if (!Pay(recipe.Int("gold") + rank * recipe.Int("gold_per_level"), recipe.Int("iron"), 0)) { return; }
        merit = Rules.Bounded((long)merit - cost + recipe.Int("reward_merit")); iron = Rules.Clamp(iron + recipe.Int("reward_iron"), 0, 1000000);
        if (kind == 1) { training = training + 1; } if (kind == 2) { title = title + 1; } if (kind == 3) { guild = guild + 1; }
        Log(recipe.Text("name") + "提升一级。");
    }
    void Challenge(int kind, int index) {
        if (job < 0 || recovery > 0 || mode != 0) { Log("请等待当前挑战或复活结束。"); return; }
        if (kind == 1) { if (index < 0 || index >= GameTables.current.bosses.rows.Count) { return; } DataRow boss = GameTables.current.bosses.rows[index]; if (level < boss.Int("min_level") || rebirth < boss.Int("rebirth")) { Log("等级或转生不足。需要等级 " + Rules.N(boss.Int("min_level")) + " / 转生 " + Rules.N(boss.Int("rebirth"))); return; } if (bossTries <= 0) { Log("今日个人 BOSS 次数用尽。"); return; } bossTries = bossTries - 1; }
        else if (kind >= 2 && kind <= 4) {
            DataRow e = GameTables.current.encounters.At(kind);
            int cap = GameTables.ProgressCap(e, level);
            if (level < e.Int("min_level") || rebirth < e.Int("min_rebirth") || EncounterProgress(e) > cap) { Log("未满足等级/转生条件，或已达挑战上限。"); return; }
            /* 世界BOSS 与 BOSS之家 共享同一池（说明.txt L45/L53）。 */
            if (kind == 3) { if (bossTries <= 0) { Log("今日次数用尽。"); return; } bossTries = bossTries - 1; }
        } else { return; }
        fieldActive = active; mode = kind; challenge = kind == 1 ? GameTables.current.bosses.rows[index].Int("id") : 0; active = true; hp = MaxHp(); mp = MaxMp(); Spawn(); Log("挑战开始：" + enemyName + "。逃离不返还次数。");
    }
    bool CanEnter(DataRow map) { return level >= map.Int("min_level") && rebirth >= map.Int("rebirth"); }
    string LocationName() { return travelMap >= 0 ? GameTables.current.maps.rows[travelMap].Text("name") : "幻境"; }
    void Travel(int map) {
        if (job < 0) { Log("请先创建角色。"); return; }
        if (mode != 0 || recovery > 0) { Log("先结束当前战斗或复活。"); return; }
        if (map < 0 || map >= GameTables.current.maps.rows.Count) { Log("地图不存在。"); return; }
        DataRow destination = GameTables.current.maps.rows[map]; int target = destination.Int("start_floor");
        if (target > best || level < destination.Int("min_level") || rebirth < destination.Int("rebirth")) { Log("无法传送到 " + destination.Text("name") + "：需要等级 " + Rules.N(destination.Int("min_level")) + "、" + Rules.N(destination.Int("rebirth")) + "转、幻境记录 " + Rules.N(target) + "层。"); return; }
        if (travelMap == map) { Log("已驻守在 " + destination.Text("name") + "。"); return; }
        // 幻境推层轨道只在离开幻境时保存；野外换点不改写它。
        if (travelMap < 0) { homeFloor = floor; homeWave = wave; }
        travelMap = map; floor = target; wave = 0; Spawn();
        Log("传送到 " + destination.Text("name") + "驻守；幻境推层进度保留在第 " + Rules.N(homeFloor) + " 层，可随时返回。");
    }
    void ReturnHome() {
        if (travelMap < 0) { Log("当前就在幻境。"); return; }
        if (mode != 0 || recovery > 0) { Log("先结束当前战斗或复活。"); return; }
        travelMap = -1; floor = homeFloor; wave = homeWave; Spawn();
        Log("已返回幻境第 " + Rules.N(floor) + " 层，推层进度恢复。");
    }
    void Arena(int rival) {
        if (job < 0 || rival < 0 || rival > 2 || arenaTries <= 0) { Log("竞技场每日5次，明日再来。"); return; }
        arenaTries = arenaTries - 1;
        int opponent = Rules.Bounded((long)B("arena_power_base") + (long)(arenaWins + 1) * B("arena_power_win") + (long)rival * B("arena_power_rival"));
        bool win = (long)Power() * (B("incoming_random_min") + Random(B("incoming_random_range"))) / 100 >= opponent;
        if (win) { arenaWins = arenaWins + 1; merit = Rules.Bounded((long)merit + B("arena_win_merit")); Gold(B("arena_win_gold")); Log("击败本地 NPC！已按配置发放奖励。"); }
        else { merit = Rules.Bounded((long)merit + B("arena_lose_merit")); Log("本地 NPC 挑战失败，已按配置发放参与声望。"); }
    }
    int AltarPersonalCap() { return B("altar_personal_cap"); }
    int AltarWorldCap() { return B("altar_world_cap"); }
    string AltarSummary() { return "个人进度 " + Rules.N(altarPersonal) + "/" + Rules.N(AltarPersonalCap()) + " · 本地共建 " + Rules.N(altarWorld) + "/" + Rules.N(AltarWorldCap()) + " · 已触发共建奖励 " + Rules.N(altarJackpots) + "次"; }
    void ResolveAltarWorld() {
        while (altarWorld >= AltarWorldCap()) {
            altarWorld = altarWorld - AltarWorldCap(); altarJackpots = Rules.Bounded((long)altarJackpots + 1);
            Gold(B("altar_world_reward_gold")); gems = Rules.Clamp(gems + B("altar_world_reward_yuan"), 0, 1000000); merit = Rules.Bounded((long)merit + B("altar_world_reward_merit"));
            Log("本地祭坛共建达成，已发放共建奖励；真实全服排行仍需服务端。");
        }
    }
    void DonateAltar(int kind) {
        if (job < 0) { Log("请先创建角色。"); return; }
        int points = 0; bool paid = false;
        if (kind == 0) { paid = Pay(B("altar_gold_cost"), 0, 0); points = B("altar_gold_gain"); }
        else if (kind == 1) { paid = Pay(0, 0, B("altar_yuan_cost")); points = B("altar_yuan_gain"); }
        else if (kind == 2) { paid = Pay(0, 0, B("altar_yuan_large_cost")); points = B("altar_yuan_large_gain"); }
        else if (kind == 3) { paid = Pay(0, B("altar_iron_cost"), 0); points = B("altar_iron_gain"); }
        else { return; }
        if (!paid) { return; }
        altarPersonal = Rules.Bounded((long)altarPersonal + points); altarWorld = Rules.Bounded((long)altarWorld + points); altarDonations = Rules.Bounded((long)altarDonations + 1);
        ResolveAltarWorld(); Log("祭坛捐献成功：个人与本地共建进度 +" + Rules.N(points) + "。");
    }
    void ClaimAltarPersonal() {
        if (altarPersonal < AltarPersonalCap()) { Log("个人祭坛进度尚未达到领取线。"); return; }
        altarPersonal = altarPersonal - AltarPersonalCap(); Gold(B("altar_personal_reward_gold")); gems = Rules.Clamp(gems + B("altar_personal_reward_yuan"), 0, 1000000); reputation = Rules.Bounded((long)reputation + B("altar_personal_reward_reputation"));
        Log("个人祭坛奖励已领取；溢出进度保留。");
    }
    int ShopRuneLevel(string reward) {
        if (reward == "rune1") { return 1; } if (reward == "rune2") { return 2; } if (reward == "rune3") { return 3; } if (reward == "rune4") { return 4; }
        if (reward == "rune5") { return 5; } if (reward == "rune6") { return 6; } if (reward == "rune7") { return 7; } if (reward == "rune8") { return 8; }
        if (reward == "rune9") { return 9; } if (reward == "rune10") { return 10; } if (reward == "rune11") { return 11; } if (reward == "rune12") { return 12; }
        if (reward == "rune13") { return 13; } if (reward == "rune14") { return 14; } return 0;
    }
    int ShopBallStar(string reward) {
        if (reward == "ball1") { return 1; } if (reward == "ball2") { return 2; } if (reward == "ball3") { return 3; } if (reward == "ball4") { return 4; }
        if (reward == "ball5") { return 5; } if (reward == "ball6") { return 6; } if (reward == "ball7") { return 7; } if (reward == "ball8") { return 8; }
        if (reward == "ball9") { return 9; } return 0;
    }
    void Shop(int item) {
        if (!GameTables.current.shop.index.ContainsKey(Rules.N(item))) { return; }
        DataRow offer = GameTables.current.shop.At(item); string reward = offer.Text("reward"); int quantity = offer.Int("quantity"); int runeLevel = ShopRuneLevel(reward); int ballStar = ShopBallStar(reward);
        if ((reward == "potions" && potions > 9999 - quantity) || (reward == "iron" && iron > 1000000 - quantity) || (reward == "runes" && runes > 1000000 - quantity) || (reward == "capacity" && capacity > B("max_capacity") - quantity) || (reward == "gold" && gold > 1000000000 - quantity) || (runeLevel > 0 && RuneCount(runeLevel) > 1000000 - quantity) || (reward == "ore" && legendOre > 1000000 - quantity) || (ballStar > 0 && DragonBallCount(ballStar) > 1000000 - quantity)) { Log("空间或资源容量不足。"); return; }
        if (!Pay(offer.Int("gold") + capacity * offer.Int("capacity_gold"), offer.Int("iron"), offer.Int("yuan"))) { return; }
        if (reward == "potions") { potions = potions + quantity; } if (reward == "iron") { iron = iron + quantity; }
        if (reward == "capacity") { capacity = capacity + quantity; } if (reward == "runes") { runes = runes + quantity; } if (runeLevel > 0) { AddRune(runeLevel, quantity); }
        if (reward == "ore") { legendOre = Rules.Clamp((long)legendOre + quantity, 0, 1000000); } if (ballStar > 0) { AddDragonBall(ballStar, quantity); }
        if (reward == "gold") { Gold(quantity); } Log("购买成功：" + offer.Text("name"));
    }
    void Daily() { if (dailyClaim != 0) { Log("今日福利已领取。"); return; } dailyClaim = 1; Gold(B("daily_gold")); gems = Rules.Clamp(gems + B("daily_yuan"), 0, 1000000); potions = Rules.Clamp(potions + B("daily_potions"), 0, 9999); treasureMaps = Rules.Clamp(treasureMaps + B("daily_treasure_maps"), 0, 9999); Log("今日福利已按配置发放，藏宝图 +" + Rules.N(B("daily_treasure_maps")) + "。"); }
    void Bounty() { if (dailyKills < B("bounty_kills") || bountyClaim != 0) { Log("未达到每日悬赏目标，或奖励已领取。"); return; } bountyClaim = 1; Gold(B("bounty_gold")); runes = Rules.Clamp(runes + B("bounty_runes"), 0, 1000000); Log("每日悬赏奖励已发放。"); }
    string QuestText() { if (quest >= GameTables.current.quests.rows.Count) { return "配置主线已完成"; } DataRow q = GameTables.current.quests.At(quest); return q.Text("name") + " · " + q.Text("metric") + " / " + Rules.N(q.Int("target")); }
    int Metric(string name) { if (name == "kills") { return kills; } if (name == "level") { return level; } if (name == "best") { return best; } if (name == "recycled") { return recycled; } if (name == "skill") { return skill; } if (name == "bossWins") { return bossWins; } return rebirth; }
    bool QuestReady() { if (quest >= GameTables.current.quests.rows.Count) { return false; } DataRow q = GameTables.current.quests.At(quest); return Metric(q.Text("metric")) >= q.Int("target"); }
    void ClaimQuest() { if (!QuestReady()) { Log("主线目标尚未达成。"); return; } DataRow q = GameTables.current.quests.At(quest); quest = quest + 1; Gold(q.Int("gold")); gems = Rules.Clamp(gems + q.Int("yuan"), 0, 1000000); iron = Rules.Clamp(iron + q.Int("iron"), 0, 1000000); Log("主线奖励已领取。"); }
    void Escort() {
        if (escortLeft > 0 || escortTries <= 0) { Log("镖车仍在路上或今日次数已用完。"); return; }
        if (!Pay(B("escort_gold"), 0, 0)) { return; } escortTries = escortTries - 1; escortLeft = B("escort_seconds"); escortReward = Rules.Bounded((long)B("escort_reward") + (long)level * B("escort_level_gold") + (long)guild * B("escort_guild_gold")); Log("镖车出发，" + Rules.N(escortLeft) + "秒后自动结算，离线同样有效。");
    }
    string TreasureSlot(int slot) {
        if (slot == 0) { return "金币 · " + Rules.N(B("treasure_gold")); }
        if (slot == 1) { return "元宝 · " + Rules.N(B("treasure_gems")); }
        if (slot == 2) { return "黑铁 · " + Rules.N(B("treasure_iron")); }
        if (slot == 3) { return "符文 · " + Rules.N(B("treasure_runes")); }
        if (slot == 4) { return "药水 · " + Rules.N(B("treasure_potions")); }
        return "装备 · 精良";
    }
    void Treasure() {
        if (treasureMaps <= 0) { Log("藏宝图不足，请通过每日福利或玩法获取。"); return; }
        int slot = Random(6);
        if (slot == 5 && bag.Count >= capacity) { Log("本次藏宝图指向装备，但背包已满，未消耗藏宝图。"); return; }
        treasureMaps = treasureMaps - 1; treasureDraws = treasureDraws + 1;
        if (slot == 0) { Gold(B("treasure_gold")); }
        if (slot == 1) { gems = Rules.Clamp(gems + B("treasure_gems"), 0, 1000000); }
        if (slot == 2) { iron = Rules.Clamp(iron + B("treasure_iron"), 0, 1000000); }
        if (slot == 3) { runes = Rules.Clamp(runes + B("treasure_runes"), 0, 1000000); }
        if (slot == 4) { potions = Rules.Clamp(potions + B("treasure_potions"), 0, 9999); }
        if (slot == 5) { LootPool(1, GameTables.current.Map(floor).Int("drop_pool"), false); }
        Log("藏宝图寻宝：" + TreasureSlot(slot) + "；今日已抽 " + Rules.N(treasureDraws) + " 次。");
    }
    void Rebirth() {
        if (rebirth >= B("max_rebirth")) { Log("已达配置转生上限。"); return; }
        DataRow r = GameTables.current.rebirth.At(rebirth + 1);
        if (level < r.Int("min_level") || best < r.Int("min_floor") || mode != 0) { Log("转生需等级 " + Rules.N(r.Int("min_level")) + " / 幻境 " + Rules.N(r.Int("min_floor"))); return; }
        if (!Pay(r.Int("gold"), 0, 0)) { return; }
        rebirth = rebirth + 1; level = 1; xp = 0; floor = 1; best = 1; wave = 0; recovery = 0;
        hp = MaxHp(); mp = MaxMp(); Spawn(); Log("转生成功！保留装备与养成，属性加成已更新。");
    }
}
