using System;
using Gui;
using Gui.Widget;
using Legend;

// 页 17「回收系统」——照原版逐像素还原（`mir2/mir/回收系统.png`）。
// 版式与交易市场/成就同一副外框（374..1491 × 164..879，`Spec.Mk*` 复用）：
// · 顶带满宽（167..205）：「回收分类」居中在左栏之上 + 道具 / 回收价格 /
// 操作 三个表头——道具居中于行首图标格（心 580）、回收价格左锚 628 与
// 行内单价对齐、操作居中于行右操作区（心 1352）。
// · 中排：左栏 389..529 —— 12 枚分类钮（40 高、节距 49）：金币/经验/
// 战功/声望/红包/元宝/积分 + 5 枚「-」（原版就是空占位钮）；
// 右：表格盒 540..1489（黑底），8 行、行高 72、节距 75（Mk* 同格），
// 只有前 4 行有数据，后 4 行原版就是空行（只有行底）。
// · 一行 = 图标格（`00211.png` 拉伸 76×67，几乎占满行）+ 名称（黄）/
// 单价（灰）两行字 + 数量输入框（82×33 蓝框）+ 最大钮（58×33）
// + 回收钮（87×33），操作区在行右 1236..1470、行内垂直居中。
// · 页脚无自底色，只有右侧分页（上一页 / 1/1 / 下一页）。
// 数据一行一实体（`RcRow`）：名称与单价原文照 `回收系统.png` 逐行抄录，
// 图标按 items.csv 的 picture 取素材（屠龙 58、嗜魂法杖 59、赤血魔剑 67、
// 幸运雪莲 2620）。真正回收走 `Game.RecycleAs`（页 20 背包入口），本页
// 的行是回收价目展示，按钮给「玩法未接」反馈不假装已实现。
// 配色（原版实测）：名称黄 `#ffff00`、单价灰 `#939d91`、输入框边
// `#1d5486`、输入字/钮字 `#02a0e1`（钮复用 `.tbl-btn .mk-buy`）。
partial class LegendApp {
    // 一行回收价目（null = 原版的空行，只画行底）。
    // 在线行：id/count 来自服务端背包（kind=3 材料），单价取本地
    // recycle_prices.csv（与服务端同一份，sync_rules 单向同步）。
    class RcRow {
        string name;  // 「屠龙」
        string price;  // 「1000000」原文，无分隔符
        int picture;  // items.csv picture 号
        int id;  // 材料 id（在线 >0；离线展示行 0 = 不可结账）
        int count;  // 背包数量（在线 >0）
        string PriceText() { return "单价：" + price + "金币"; }
    }

    static RcRow RcRowOf(string name, string price, int picture) {
        RcRow r = new RcRow();
        r.name = name; r.price = price; r.picture = picture;
        return r;
    }

    static Dictionary<int, int> rcPriceMap = null;
    static RcRow RcPriceRowOf(int itemId, string name, int picture, int count) {
        RcRow r = new RcRow();
        r.id = itemId; r.count = count;
        r.name = name; r.picture = picture;
        if (rcPriceMap == null) {
            Dictionary<int, int> m = new Dictionary<int, int>();
            DataTable t = GameTables.current.recyclePrices;
            for (int i = 0; i < t.rows.Count; i = i + 1) {
                m.Add(t.rows[i].Int("id"), t.rows[i].Int("gold"));
            }
            rcPriceMap = m;
        }
        int gold = 0;
        if (rcPriceMap.ContainsKey(itemId)) { gold = rcPriceMap[itemId]; }
        if (gold <= 0) {
            gold = GameTables.current.items.At(itemId).Int("sell_price") / 2;
        }
        r.price = Rules.N(gold);
        return r;
    }

    // 当前页（在线行多于 8 行时翻页）。
    int rcPageNo = 0;

    // 回收数据行：全部来自真实背包（服务端优先消费强类型 BagItem，单机消费本地背包）。
    // 彻底消除硬编码假回收数据。
    List<RcRow> RcLiveRows() {
        List<RcRow> v = new List<RcRow>();
        if (net.Self() != null) {
            for (int i = 0; i < net.BagCount(); i = i + 1) {
                BagItem bi = net.TypedBagAt(i);
                if (bi != null) {
                    if (bi.Count <= 0) { continue; }
                    int itemId = bi.ItemId;
                    int kind = bi.Kind;
                    int pic = bi.Picture;
                    string name = bi.Name;
                    if (kind == 0 && pic == 0 && GameTables.current != null) {
                        DataRow def = GameTables.current.items.At(itemId);
                        if (def != null) {
                            kind = def.Int("kind");
                            pic = def.Int("picture");
                            if (name.Length == 0) { name = def.Text("name"); }
                        }
                    }
                    if (kind != 3) { continue; }
                    if (bi.RecyclePrice > 0) {
                        RcRow r = new RcRow();
                        r.id = itemId;
                        r.count = bi.Count;
                        r.name = name;
                        r.picture = pic;
                        r.price = Rules.N(bi.RecyclePrice);
                        v.Add(r);
                    } else {
                        v.Add(RcPriceRowOf(itemId, name, pic, bi.Count));
                    }
                }
            }
        } else if (g != null && g.bag != null) {
            for (int i = 0; i < g.bag.Count; i = i + 1) {
                Equipment eq = g.bag[i];
                if (eq != null) {
                    DataRow def = GameTables.current.items.At(eq.definitionId);
                    if (def != null && def.Int("kind") == 3) {
                        string name = def.Text("name");
                        v.Add(RcPriceRowOf(eq.definitionId, name, def.Int("picture"), 1));
                    }
                }
            }
        }
        return v;
    }

    // 左栏 12 枚分类（原版顺序：7 个币种 + 5 枚「-」占位）。
    static List<string> RcCats() {
        List<string> c = new List<string>();
        c.Add("金币"); c.Add("经验"); c.Add("战功"); c.Add("声望");
        c.Add("红包"); c.Add("元宝"); c.Add("积分"); c.Add("-");
        c.Add("-"); c.Add("-"); c.Add("-"); c.Add("-");
        return c;
    }

    void BuildRecyclePage() {
        if (net.Self() != null) { net.MaybeRefreshBag(); }
        Panel frame = Panel.Column(); frame.Class = "mk-frame";
        frame.Pad(0); frame.Gap(0);
        frame.Prefer(0, Spec.MkFrameH());
        frame.Padding(Spec.MkFramePadT(), Spec.MkFramePadR(), 0, Spec.MkFramePadL());
        content.With(frame);

        frame.With(RcHeadBand());

        Panel mid = Panel.Row(); mid.Class = "mk-mid mk-fill";
        mid.Pad(0); mid.Gap(Spec.MkColGap());
        mid.Padding(0, 0, 0, Spec.MkMidPadL());
        mid.With(RcLeft());
        mid.With(RcRight());
        frame.With(mid);
    }

    // 顶带：回收分类（居中在左栏上）+ 道具 / 回收价格 / 操作
    Panel RcHeadBand() {
        Panel wrap = Panel.Column(); wrap.Class = "mk-fixed"; wrap.Pad(0); wrap.Gap(0);
        wrap.Prefer(0, Spec.MkBandH() + Spec.MkBandLine());
        Panel band = Panel.Row(); band.Class = "mk-band";
        band.Pad(0); band.Gap(0); band.Prefer(0, Spec.MkBandH());

        Panel lz = Panel.Row(); lz.Class = "mk-cell"; lz.Pad(0);
        lz.Prefer(Spec.RcBandLabelW(), Spec.MkBandH());
        lz.With(Text("回收分类", "mk-band-t", 0));
        band.With(lz);

        Panel h1 = Panel.Row(); h1.Class = "mk-cell"; h1.Pad(0);
        h1.Prefer(Spec.RcHead1W(), Spec.MkBandH());
        h1.With(Text("道具", "mk-band-t", 0));
        band.With(h1);

        Panel h2 = Panel.Row(); h2.Class = "mk-cell-l"; h2.Pad(0);
        h2.Prefer(Spec.RcHead2W(), Spec.MkBandH());
        h2.Padding(0, 0, 0, Spec.RcHead2PadL());
        h2.With(Text("回收价格", "mk-band-t", 0));
        band.With(h2);

        Panel h3 = Panel.Row(); h3.Class = "mk-cell mk-fill"; h3.Pad(0);
        h3.Prefer(0, Spec.MkBandH());
        h3.Padding(0, Spec.RcHead3PadR(), 0, 0);
        h3.With(Text("操作", "mk-band-t", 0));
        band.With(h3);

        wrap.With(band);
        Panel line = Panel.Row(); line.Class = "mk-band-line";
        line.Pad(0); line.Prefer(0, Spec.MkBandLine()); wrap.With(line);
        return wrap;
    }

    // 左：12 枚分类钮（末 5 枚原版就是「-」）
    Panel RcLeft() {
        Panel p = Panel.Column(); p.Class = "mk-left mk-fixed";
        p.Pad(0); p.Gap(0); p.Prefer(Spec.MkLeftW(), 0);
        p.Padding(Spec.MkBandToBtn(), 0, 0, 0);
        List<string> cats = RcCats();
        for (int i = 0; i < cats.Count; i = i + 1) {
            int pick = i;
            Button b = Btn(cats[i], "tbl-btn mk-cat", () => { RcPickCat(pick); });
            b.Prefer(0, Spec.MkCatH());
            p.With(b);
            if (i + 1 < cats.Count) { p.With(TblPad(Spec.MkCatGap())); }
        }
        return p;
    }

    // 右：表格盒（8 行，前 4 行数据）+ 页脚（只有分页 1/1）
    Panel RcRight() {
        Panel col = Panel.Column(); col.Class = "mk-right mk-fill";
        col.Pad(0); col.Gap(0);
        col.With(RcTable());
        col.With(RcFoot());
        return col;
    }

    Panel RcTable() {
        Panel box = Panel.Column(); box.Class = "mk-box mk-fill";
        box.Pad(0); box.Gap(0); box.Prefer(0, 0);
        box.Padding(0, Spec.MkRowPadX(), Spec.MkBoxPadB(), Spec.MkRowPadX());
        box.With(TblPad(Spec.MkHeadToRow()));
        List<RcRow> rows = RcLiveRows();
        /* 在线行多于一页时按当前页切片（回收系统页 8 行/页）。 */
        int pages = RcPageCount(rows.Count);
        if (this.rcPageNo > pages - 1) { this.rcPageNo = pages - 1; }
        if (this.rcPageNo < 0) { this.rcPageNo = 0; }
        int off = this.rcPageNo * Spec.RcRows();
        for (int r = 0; r < Spec.RcRows(); r = r + 1) {
            int i = off + r;
            box.With(RcRowBox(i < rows.Count ? rows[i] : null));
            if (r + 1 < Spec.RcRows()) { box.With(TblPad(Spec.MkRowGap())); }
        }
        return box;
    }

    static int RcPageCount(int n) {
        int pages = (n + Spec.RcRows() - 1) / Spec.RcRows();
        return pages > 0 ? pages : 1;
    }

    // 一行：图标格 + 名称/单价 + 数量输入框 + 最大/回收（null = 空行）。
    Panel RcRowBox(RcRow it) {
        Panel row = Panel.Row(); row.Class = "mk-row";
        row.Pad(0); row.Gap(0); row.Prefer(0, Spec.MkRowH());
        if (it == null) { return row; }

        Panel c0 = Panel.Row(); c0.Class = "mk-cell-l"; c0.Pad(0);
        c0.Prefer(Spec.RcIconColW(), Spec.MkRowH());
        c0.Padding(Spec.MkIconPadT(), 0, 0, 0);
        c0.With(SpriteCellAt("", Spec.RcIconW(), Spec.RcIconH(),
                             ItemArtPath(it.picture), "", "", 0, 0));
        row.With(c0);

        Panel c1 = Panel.Row(); c1.Class = "mk-cell-l"; c1.Pad(0);
        c1.Prefer(Spec.RcTextW(), Spec.MkRowH());
        Panel txt = Panel.Column(); txt.Pad(0); txt.Gap(0);
        txt.Padding(Spec.RcNamePadT(), 0, 0, 0);
        Label nm = Text(it.name, "ac-name", 0); nm.Prefer(0, Spec.RcLineH()); txt.With(nm);
        Label pr = Text(it.PriceText(), "rc-sub", 0); pr.Prefer(0, Spec.RcLineH()); txt.With(pr);
        c1.With(txt);
        row.With(c1);

        Panel sp = Panel.Row(); sp.Class = "mk-fill"; sp.Pad(0); row.With(sp);

        RcRow pick = it;
        bool live = pick != null && pick.id > 0;
        Panel c2 = Panel.Row(); c2.Class = "mk-cell"; c2.Pad(0);
        c2.Prefer(Spec.RcCtrlW(), Spec.MkRowH());
        c2.Gap(Spec.RcCtrlGap());
        c2.Padding(0, Spec.RcCtrlPadR(), 0, 0);
        Input qty = new Input(live ? Rules.N(pick.count) : "0"); qty.Class = "rc-input";
        qty.Prefer(Spec.RcInputW(), Spec.RcCtrlH()); c2.With(qty);
        c2.With(BtnDev("最 大", "tbl-btn mk-buy", Spec.RcBtnW(), Spec.RcCtrlH(),
                       () => { RcMax(pick, qty); }));
        c2.With(BtnDev("回 收", "tbl-btn mk-buy", Spec.RcRecycleW(), Spec.RcCtrlH(),
                       () => { RcRecycle(pick, qty); }));
        row.With(c2);
        return row;
    }

    // 页脚：无自底色，只有右侧分页（在线行多才翻页）。
    Panel RcFoot() {
        Panel f = Panel.Row(); f.Class = "mk-foot mk-fixed";
        f.Pad(0); f.Gap(0);
        f.Prefer(0, Spec.MkFootH());
        f.Padding(Spec.MkFootPadT(), Spec.RcFootPadR(), 0, Spec.MkFootPadL());
        Panel sp = Panel.Row(); sp.Class = "mk-fill"; sp.Pad(0); f.With(sp);
        int pages = net.Self() != null
            ? RcPageCount(RcLiveRows().Count) : 1;
        SignalInt pgSig = new SignalInt(this.rcPageNo + 1);
        Pagination pg = new Pagination(pages, pgSig);
        pg.Class = "simple";
        pg.PrevText("上一页"); pg.NextText("下一页");
        pg.Named("recycle-pager");
        pg.Change += () => {
            this.rcPageNo = pgSig.Get() - 1;
            if (this.rcPageNo < 0) { this.rcPageNo = 0; }
            BuildPage(); Refresh();
        };
        f.With(pg);
        return f;
    }

    // 动作
    void RcSay(string msg) {
        if (net.Self() != null) { net.AddChat("[系统]", msg); return; }
        g.Log(msg);
    }
    void RcPickCat(int i) { RcSay("回收按 " + RcCats()[i] + " 单独结账未开放：回收把七种收益一次结清。"); }
    void RcMax(RcRow r, Input qty) {
        if (r == null || r.id <= 0) { RcSay("这一行是展示行。"); return; }
        qty.SetText(Rules.N(r.count));
    }
    void RcRecycle(RcRow r, Input qty) {
        if (net.Self() == null) { RcSay("回收：「" + r.name + "」×1（离线请在背包页回收）。"); return; }
        if (r == null || r.id <= 0) { RcSay("这一行是展示行。"); return; }
        int n = DataTable.Integer(qty.GetText(), "回收数量");
        if (n <= 0) { RcSay("数量要大于 0。"); return; }
        net.RecycleOne(r.id, n);
    }
}
