using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 19「至尊殿堂」——照原版还原（至尊极品宝鉴.png），规格见 Spec / REFERENCE_AUDIT §5.4。
/// 卡阵几何与页 7「城池争霸」**逐像素相同**（实测两页卡体：情景带 183..287、
/// 资主行 292..313、行节距 153 设备、列 400/945），故直接复用 Spec 的 City*
/// 一套尺寸，只换卡内件：
/// · 左：立绘 + 「登记装备」钮（对应城池页的「攻占城池」）
/// · 右：情景块（assets/city/N.gif 打底）上压 金标题 + 小字条件说明 + 右上
/// 金框道具图（带 +N 角标）；下一条三格：主人 | 名字 | 「武器与铠甲无法
/// 复制」或「复制费：N灵符 + [复制]」
/// · 页脚两带：左「经验加成：0% +(仅幻境和秘境有效)」，中两条规则说明，
/// 右「上一页 [1/5] 下一页」+「[帮助][取回已落榜装备]」
/// 道具图按原版对照图上的道具型取 items.csv 的图标（题面 124/133/189 =
/// 攻/法/道武器，25 铠甲、41 头盔、51 项链、58 手镯、49 戒指）；登记/复制/
/// 帮助/取回玩法未接，按本模板惯例给明确反馈，不假装已实现。
partial class LegendApp {

    class SupInfo {
        string title;  // 金标题：武器之攻 / 铠甲之首 …
        string sub;  // 小字条件说明：武器（攻击天赋>总系数>攻击值）
        string owner;  // 主人
        int itemId;  // items.csv 道具号（取图标）
        int badge;  // 道具图角标（0 = 原版这格没角标）
        bool copy;  // 是否可复制（原版：武器与铠甲不可复制）
        int fee;  // 复制费（灵符）
    }

    class SupSlotConfig {
        string title;
        string sub;
        int defaultItem;
        bool copyable;
        int fee;
    }

    static SupSlotConfig SupCfgOf(string title, string sub, int defaultItem, bool copyable, int fee) {
        SupSlotConfig c = new SupSlotConfig();
        c.title = title;
        c.sub = sub;
        c.defaultItem = defaultItem;
        c.copyable = copyable;
        c.fee = fee;
        return c;
    }

    static List<SupSlotConfig> supConfigs = null;
    static List<SupSlotConfig> SupConfigs() {
        if (supConfigs != null) { return supConfigs; }
        List<SupSlotConfig> list = new List<SupSlotConfig>();
        list.Add(SupCfgOf("武器之攻", "武器（攻击天赋>总系数>攻击值）", 124, false, 0));
        list.Add(SupCfgOf("武器之法", "武器（魔法天赋>总系数>魔法值）", 133, false, 0));
        list.Add(SupCfgOf("武器之道", "武器（道术天赋>总系数>道术值）", 189, false, 0));
        list.Add(SupCfgOf("铠甲之首", "铠甲（防御天赋>总系数>防御值）", 25, false, 0));
        list.Add(SupCfgOf("头盔之首", "头盔（防御天赋>总系数>防御值）", 41, true, 100));
        list.Add(SupCfgOf("项链之首", "项链（主属性>总系数）", 51, true, 100));
        list.Add(SupCfgOf("手镯之首", "手镯（主属性>总系数）", 58, true, 100));
        list.Add(SupCfgOf("戒指之首", "戒指（主属性>总系数）", 49, true, 10));
        supConfigs = list;
        return supConfigs;
    }

    /// 离线单机演示数据（统一「虚位以待」，严格隔离）。
    static List<SupInfo> SupOfflineDemoData() {
        List<SupInfo> rows = new List<SupInfo>();
        List<SupSlotConfig> cfgs = SupConfigs();
        for (int i = 0; i < cfgs.Count; i = i + 1) {
            SupSlotConfig cfg = cfgs[i];
            SupInfo r = new SupInfo();
            r.title = cfg.title;
            r.sub = cfg.sub;
            r.owner = "虚位以待";
            r.itemId = cfg.defaultItem;
            r.badge = 0;
            r.copy = cfg.copyable;
            r.fee = cfg.fee;
            rows.Add(r);
        }
        return rows;
    }

    /// 当前殿堂格：在线消费服务端 sup.rows 强类型实体（权威下发 title/sub/itemId/owner/value/copyable/fee）；单机离线隔离演示。
    List<SupInfo> SupRows() {
        bool online = net.Self() != null;
        if (!online) { return SupOfflineDemoData(); }
        if (net.TypedSup() == null || net.TypedSup().Rows.Count == 0) {
            return new List<SupInfo>();
        }
        List<SupGridItem> rows = net.TypedSup().Rows;
        List<SupInfo> v = new List<SupInfo>();
        for (int i = 0; i < rows.Count; i = i + 1) {
            SupGridItem m = rows[i];
            SupInfo r = new SupInfo();
            r.title = m.Title;
            r.sub = m.Sub;
            int itemId = m.ItemId;
            string owner = m.Owner;
            bool none = owner.Length == 0 || itemId <= 0;
            r.owner = none ? "虚位以待" : owner;
            r.itemId = itemId;
            r.badge = none ? 0 : m.Value;
            r.copy = m.Copyable;
            r.fee = m.Fee;
            v.Add(r);
        }
        return v;
    }

    void BuildSupremePage() {
        if (net.Self() != null) { net.MaybeRefreshSup(); }
        int leftInset = Spec.CityPadL();

        Panel body = Panel.Column(); body.Class = "sup-page";
        body.Pad(0); body.Gap(0); body.Grow(); content.With(body);

        Panel top = Panel.Column(); top.Prefer(0, Spec.MapMargin());
        body.With(top);

        Panel gridRow = Panel.Row(); gridRow.Pad(0); gridRow.Gap(0);
        gridRow.Prefer(0, Spec.CityWallH()); body.With(gridRow);
        gridRow.With(SpacerW(leftInset));
        Panel grid = Panel.Column(); grid.Class = "sup-wall";
        grid.Pad(0); grid.Gap(Spec.CityRowGap());
        grid.Prefer(Spec.CityWallW(), Spec.CityWallH());
        gridRow.With(grid);
        List<SupInfo> rows = SupRows();
        bool online = net.Self() != null;
        if (online && rows.Count == 0) {
            Panel empty = Panel.Row(); empty.Pad(0); empty.Prefer(Spec.CityWallW(), Spec.CityWallH());
            empty.With(Text("正在同步至尊殿堂榜首数据...", "sup-foot-text", 0));
            grid.With(empty);
        } else {
            for (int r = 0; r < Spec.CityRows(); r = r + 1) {
                Panel row = Panel.Row(); row.Class = "sup-row";
                row.Pad(0); row.Gap(Spec.CityColGap());
                row.Prefer(0, Spec.CityInfoH()); grid.With(row);
                for (int c = 0; c < Spec.CityCols(); c = c + 1) {
                    int i = r * Spec.CityCols() + c;
                    if (i >= rows.Count) { break; }
                    row.With(SupCard(i, rows[i]));
                }
            }
        }

        Panel fillmid = Panel.Column(); fillmid.Grow(); body.With(fillmid);

        Panel footPad = Panel.Column(); footPad.Prefer(0, Spec.SupFootPadB());
        footPad.AnchorBottom(); body.Add(footPad);
        Panel foot = Panel.Row(); foot.Class = "sup-foot";
        foot.Pad(0); foot.Gap(0);
        foot.Prefer(0, Spec.SupFootH());
        foot.Padding(0, Spec.SupFootPadR(), 0, Spec.SupFootPadL());
        foot.AnchorBottom(); body.Add(foot);
        foot.With(SupGainPane());
        foot.With(SpacerW(Spec.Px(20)));
        foot.With(SupRulesPane());
        Panel ffill = Panel.Row(); ffill.Grow(); foot.With(ffill);
        foot.With(SupRightPane());
    }

    /// 页脚左列：经验加成（在线 = 服务端已持有格数 ×5%，离线 0%）+ 小字。
    Panel SupGainPane() {
        string gain = "0%";
        if (net.Self() != null && net.TypedSup() != null) {
            gain = Rules.N(net.TypedSup().Bonus) + "%";
        }
        Panel col = Panel.Column(); col.Class = "sup-gain";
        col.Pad(0); col.Gap(Spec.Px(3));
        col.Prefer(Spec.SupGainW(), 0);
        Panel row = Panel.Row(); row.Pad(0); row.Gap(Spec.Px(4));
        row.Prefer(0, Spec.Px(15));
        row.With(Text("经验加成：", "sup-gain-k", 0));
        row.With(Text(gain, "sup-gain-v", 0));
        col.With(row);
        Label note = Text("(仅幻境和秘境有效)", "sup-gain-note", 0);
        note.Prefer(Spec.SupGainW(), Spec.Px(12)); col.With(note);
        return col;
    }

    /// 页脚中列：两条登记规则。
    Panel SupRulesPane() {
        Panel col = Panel.Column(); col.Class = "sup-rules";
        col.Pad(0); col.Gap(Spec.Px(2));
        col.Prefer(Spec.SupRuleW(), 0);
        Label r1 = Text("1、极品殿堂只收录最好的装备和天书，可以供他人复制并收取手续费；",
            "sup-rule", 0);
        r1.Prefer(Spec.SupRuleW(), Spec.Px(20)); col.With(r1);
        Label r2 = Text("2、每成功登记一件装备可以获得5%的经验加成，最高50%；",
            "sup-rule", 0);
        r2.Prefer(Spec.SupRuleW(), Spec.Px(20)); col.With(r2);
        return col;
    }

    /// 页脚右列：上分页、下两钮（与规则两行同高）。
    Panel SupRightPane() {
        Panel col = Panel.Column(); col.Class = "sup-right";
        col.Pad(0); col.Gap(Spec.Px(2));
        col.Prefer(Spec.SupRightW(), 0);
        Panel rowA = Panel.Row(); rowA.Pad(0); rowA.Gap(Spec.Px(2));
        rowA.Prefer(0, Spec.Px(20));
        Panel afill = Panel.Row(); afill.Grow(); rowA.With(afill);
        SignalInt pgSig = new SignalInt(1);
        Pagination pg = new Pagination(Spec.SupPages(), pgSig);
        pg.Class = "simple";
        pg.PrevText("上一页"); pg.NextText("下一页");
        pg.Named("sup-pager");
        rowA.With(pg);
        col.With(rowA);
        Panel rowB = Panel.Row(); rowB.Pad(0); rowB.Gap(Spec.Px(5));
        rowB.Prefer(0, Spec.Px(20));
        Panel bfill = Panel.Row(); bfill.Grow(); rowB.With(bfill);
        rowB.With(BtnDev("帮助", "sup-plain", Spec.SupBtnW(), Spec.Px(20),
            () => { SupSay("极品殿堂：登记最好的装备与天书，他人可复制并支付手续费。"); }));
        rowB.With(BtnDev("取回已落榜装备", "sup-plain", Spec.SupBtn2W(), Spec.Px(20),
            () => { SupSay("取回已落榜装备（玩法未接：本版没有落榜回收服务端通道）"); }));
        col.With(rowB);
        return col;
    }

    /// 一张殿堂卡：左立绘 + 登记钮；右情景块（金标题/说明/道具图）+ 主人行。
    Panel SupCard(int i, SupInfo r) {
        Panel card = Panel.Row(); card.Class = "sup-card";
        card.Pad(0); card.Gap(Spec.CityAvaInfoGap());
        card.Prefer(Spec.CityAvaW() + Spec.CityAvaInfoGap() + Spec.CityInfoW(),
            Spec.CityInfoH());
        card.Named("sup-card-" + Rules.N(i));

        Panel ava = Panel.Column(); ava.Class = "sup-avacol";
        ava.Pad(0); ava.Gap(Spec.Px(3));
        ava.Prefer(Spec.CityAvaW(), Spec.CityInfoH());
        Image face = new Image(CityFacePath(i), r.owner, "cover");
        face.Class = "sup-ava";
        face.Prefer(Spec.CityAvaW(), Spec.CityAvaH());
        ava.With(face);
        int pick = i;
        ava.With(BtnDev("登记装备", "sup-reg", Spec.CityBtnW(), Spec.CityBtnH(),
            () => { SupReg(pick); }));
        card.With(ava);

        Panel info = Panel.Column(); info.Pad(0); info.Gap(Spec.Px(2));
        info.Prefer(Spec.CityInfoW(), Spec.CityInfoH());
        Panel scene = Panel.Column(); scene.Class = "sup-scene";
        scene.Pad(0); scene.Prefer(0, Spec.CitySceneH());
        Image bg = new Image(CityScenePath(i), r.title, "fill");
        bg.Grow(); scene.Add(bg);
        /* 标题 / 条件说明 / 道具图都压在图底上（position:absolute 套路）。 */
        Label ti = Text(r.title, "sup-title", 0);
        ti.Prefer(Spec.CityInfoW(), Spec.Px(20)); scene.With(ti);
        Label sb = Text(r.sub, "sup-sub", 0);
        sb.Prefer(Spec.CityInfoW(), Spec.Px(14)); scene.With(sb);
        scene.With(SupIcon(r));
        info.With(scene);
        info.With(SupOwnerRow(r));
        card.With(info);
        return card;
    }

    /// 右上金框道具图 + 角标（原版只有部分格子带 +N 角标）。
    Panel SupIcon(SupInfo r) {
        Panel box = Panel.Column(); box.Class = "sup-icon";
        box.Pad(0); box.Prefer(Spec.SupIconSize(), Spec.SupIconSize());
        Image art = new Image(ItemArtById(r.itemId), r.title, "contain");
        art.Grow(); box.Add(art);
        if (r.badge > 0) {
            Label b = Text("+" + Rules.N(r.badge), "sup-badge", 0);
            box.With(b);
        }
        return box;
    }

    /// 主人行三格：主人 | 名字 | 「无法复制」或「复制费 + [复制]」。
    /// 三格都是「细框 + 格心字」，框与居中同样靠 CenterRow 的容器（Label
    /// 既不画背景/边框，也不吃 `text-align`——同城池页城主行的注释）。
    Panel SupOwnerRow(SupInfo r) {
        Panel zz = Panel.Row(); zz.Pad(0); zz.Gap(Spec.Px(4));
        zz.Prefer(0, Spec.CityOwnerH());
        zz.With(CenterRow("主人", "sup-zz-cell", "sup-zz",
            Spec.CityZz1W(), Spec.CityOwnerH()));
        zz.With(CenterRow(r.owner, "sup-zz-cell", "sup-zz-name",
            Spec.CityZzNameW(), Spec.CityOwnerH()));
        if (r.copy) {
            int noteW = Spec.CityInfoW() - Spec.CityZz1W() - Spec.CityZzNameW()
                - Spec.SupCopyBtnW() - Spec.Px(12);
            zz.With(CenterRow("复制费：" + Rules.N(r.fee) + "灵符",
                "sup-zz-cell", "sup-zz-note", noteW, Spec.CityOwnerH()));
            zz.With(BtnDev("复制", "sup-copy", Spec.SupCopyBtnW(), Spec.CityOwnerH(),
                () => { SupSay("复制（玩法未接：需 " + Rules.N(r.fee) + " 灵符）"); }));
        } else {
            int noteW = Spec.CityInfoW() - Spec.CityZz1W() - Spec.CityZzNameW()
                - Spec.Px(8);
            zz.With(CenterRow("武器与铠甲无法复制", "sup-zz-cell", "sup-zz-note",
                noteW, Spec.CityOwnerH()));
        }
        return zz;
    }

    // 动作（玩法未接：按本模板惯例给明确反馈，不假装已实现）
    void SupSay(string msg) {
        if (net.Self() != null) { net.AddChat("[系统]", msg); return; }
        g.Log(msg);
    }

    void SupReg(int i) {
        List<SupInfo> rows = SupRows();
        if (i < 0 || i >= rows.Count) { return; }
        if (net.Self() == null) {
            SupSay("登记「" + rows[i].title + "」（离线模式：登记需要服务端校验装备栏）");
            return;
        }
        net.SupReg(i);
    }
}
