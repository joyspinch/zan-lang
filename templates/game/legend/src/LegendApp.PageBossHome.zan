using System;
using Gui;
using Gui.Widget;
using Legend;

// 页 3「BOSS之家」——照原版 `BOSS之家.png` 1:1 还原。
// 与场景页家族（幻境/秘境/世界BOSS）不同：左半 = 玩家头像 + 10 行属性栏
// （气血/法力/等级/转生/攻击/魔法/道术/防御/魔防/幸运）+ 怪物立绘
// + 掉落格；右半 = BOSS 表格（编号/BOSS名称/等级，12 行 × 3 页 = 28 BOSS）；
// 底部 = 说明（带空输入框）/ 自动 / 挑战BOSS。
// REFERENCE_AUDIT.md §4.1 表 3: BOSS之家
// 左：BOSS 大图 + 属性栏；右：编号/BOSS名称/等级 表格（12 行）；
// 底：掉落格 + 自动/挑战BOSS。
// 怪物立绘取自当前选中的 BOSS（行 1 默认 = 沃玛教主 picture=4）。
partial class LegendApp {
    /* =====================================================================
       数据
       ===================================================================== */

    // BOSS 列表的当前页（0..2，每页 12 行，28 BOSS）。
    int bossHomePage = 0;

    // 当前选中的 BOSS 行（0..11 相对当前页）。点表格里的某行就置这里。
    int bossHomeRow = 0;

    // 当前选中的 BOSS（全局 id = page*12 + row + 1）。
    int bossHomeId() { return bossHomePage * 12 + bossHomeRow + 1; }

    BossDetail BossHomeBoss() {
        if (net.Self() != null && net.BossCount() > 0) {
            int idx = bossHomePage * 12 + bossHomeRow;
            if (idx >= 0 && idx < net.BossCount()) {
                BossInfo bi = net.TypedBossAt(idx);
                if (bi != null) {
                    int pic = DataTable.Integer(bi.Picture, "picture");
                    if (pic <= 0) { pic = bi.Tpl > 0 ? bi.Tpl : bi.Id; }
                    return new BossDetail(
                        bi.Tpl > 0 ? bi.Tpl : bi.Id,
                        bi.Name,
                        pic,
                        (int)bi.MaxHp,
                        bi.Mp,
                        bi.MinLevel,
                        bi.Rebirth,
                        bi.AtkMin,
                        bi.AtkMax,
                        0,
                        0,
                        0,
                        0,
                        bi.Def,
                        bi.Def,
                        bi.Mdef,
                        bi.Mdef
                    );
                }
            }
        }
        int id = bossHomeId();
        if (id < 1 || id > GameTables.current.bosses.rows.Count) {
            return GameTables.current.BossDetailAt(1);
        }
        return GameTables.current.BossDetailAt(id);
    }

    // BOSS 之家的 BOSS 列表总数（在线优先使用服务端下发 BOSS 列表长度）。
    int BossHomeTotal() {
        if (net.Self() != null && net.BossCount() > 0) {
            return net.BossCount();
        }
        int n = GameTables.current.bosses.rows.Count;
        return n < 28 ? n : 28;
    }
    int BossHomePageCount() {
        int n = BossHomeTotal();
        return (n + 11) / 12;
    }

    /* =====================================================================
       页面
       ===================================================================== */

    void BuildBossHome() {
        if (net.Self() != null) { net.MaybeRefreshBosses(); }
        int pageW = app.ClientWidth() - Spec.LeftPad() - Spec.LeftW()
            - Spec.ChatW() - Spec.ChatPadR();
        // 与场景页的列宽对齐：左列 = 整块 - 排行榜；这里右栏稍宽（388 设备
        // = 原版 BOSS 表格宽），左列 = 余量。
        int rightW = Spec.Px(389);
        int leftW = pageW - rightW;
        if (leftW < Spec.Px(360)) { leftW = Spec.Px(360); }

        Panel body = Panel.Row(); body.Class = "scene-page";
        body.Pad(0); body.Gap(0); body.Grow(); content.With(body);

        /* 左列：场景面板（玩家头像 + 属性栏 + 怪物立绘 + 底部操作区）。 */
        Panel leftCol = Panel.Column(); leftCol.Pad(0); leftCol.Gap(0); leftCol.Grow();
        body.With(leftCol);
        Panel scene = BossHomeScenePane(leftW);
        scene.Grow(); leftCol.With(scene);
        Panel botPad = Panel.Column(); botPad.Prefer(0, Spec.SceneBotPad());
        botPad.AnchorBottom(); leftCol.Add(botPad);
        Panel loot = SceneLootPane(leftW);
        loot.AnchorBottom(); leftCol.Add(loot);

        /* 右列：BOSS 表格 12 行 + 分页 1/N。 */
        Panel rightCol = Panel.Column(); rightCol.Pad(0); rightCol.Gap(0);
        rightCol.Prefer(rightW, 0); rightCol.AnchorRight(); body.Add(rightCol);
        Panel rankPad = Panel.Column(); rankPad.Prefer(0, Spec.SceneBotPad());
        rankPad.AnchorBottom(); rightCol.Add(rankPad);
        Panel table = BossHomeTable();
        table.Grow(); rightCol.With(table);
    }

    // 场景面板：左上 = 玩家头像 + 框下 470/470 气血；右侧 = 10 行属性列；
    // 中下 = 怪物立绘 + 血字 + 血条；底部 = 说明/自动/挑战BOSS。
    Panel BossHomeScenePane(int paneW) {
        Panel pane = Panel.Column(); pane.Class = "scene-panel";
        pane.Pad(0); pane.Gap(0);

        Panel head = Panel.Row(); head.Class = "scene-head";
        head.Pad(0); head.Gap(0); head.Prefer(0, Spec.SceneHeadH());
        head.Padding(0, Spec.SceneFaceInset(), 0, 0);
        pane.With(head);
        Panel face = ScenePlayerBlock();
        face.Prefer(Spec.SceneFaceW(), 0); face.AnchorRight(); head.Add(face);
        Panel titleCol = Panel.Column(); titleCol.Pad(0); titleCol.Gap(0); titleCol.Grow();
        head.With(titleCol);

        /* 中段：怪物立绘 + 属性栏。 */
        Panel mon = BossHomeMonsterZone(paneW, ScenePaneHeight());
        mon.Grow(); pane.With(mon);
        /* 底部：3 个按钮（左：说明 + 空输入框，中：自动，右：挑战BOSS）。 */
        Panel foot = BossHomeFooter();
        foot.AnchorBottom(); pane.Add(foot);
        return pane;
    }

    // 怪物区：右 = 10 行属性列（左对齐在面板右半部），左下 = 怪物立绘 +
    // 血字 + 血条。
    Panel BossHomeMonsterZone(int paneW, int paneH) {
        Panel zone = Panel.Row(); zone.Class = "scene-mon-zone";
        zone.Pad(0); zone.Gap(0);

        /* 怪物区（占左半）。 */
        Panel mon = Panel.Column(); mon.Class = "bosshome-mon";
        mon.Pad(0); mon.Gap(0); mon.Grow();
        mon.Padding(0, 0, Spec.SceneMonBottom(), 0);
        zone.With(mon);

        BossDetail b = BossHomeBoss();
        int pic = b.Picture;
        int maxHp = b.Hp;
        int curHp = g.enemyMax > 0 ? g.enemyHp : maxHp;
        if (curHp > maxHp) { curHp = maxHp; }

        int blockH = Spec.SceneMonHpTextH() + Spec.SceneMonBarGap()
            + Spec.SceneMonHpBarH() + Spec.SceneMonGap() + Spec.SceneMonBoxH();
        Panel padBot = Panel.Column(); padBot.Prefer(0, Spec.SceneMonBottom());
        padBot.AnchorBottom(); mon.Add(padBot);
        Panel block = Panel.Column(); block.Class = "scene-mon";
        block.Pad(0); block.Gap(0); block.Prefer(0, blockH);
        block.AnchorBottom(); mon.Add(block);

        int hpInset = (paneW - rightOfSplit(paneW) - Spec.SceneMonHpW()) / 2;
        if (hpInset < 0) { hpInset = 0; }
        int spInset = (paneW - rightOfSplit(paneW) - Spec.SceneMonBoxW()) / 2;
        if (spInset < 0) { spInset = 0; }

        Panel hpRow = Panel.Row(); hpRow.Class = "scene-hp-row";
        hpRow.Pad(0); hpRow.Prefer(0, Spec.SceneMonHpTextH());
        hpRow.Padding(0, 0, 0, hpInset); block.With(hpRow);
        hpRow.With(Text(Rules.N(curHp) + "/" + Rules.N(maxHp), "scene-mon-hp", 0));
        Panel barGap = Panel.Column(); barGap.Prefer(0, Spec.SceneMonBarGap());
        block.With(barGap);
        Panel barRow = Panel.Row(); barRow.Pad(0); barRow.Prefer(0, Spec.SceneMonHpBarH());
        block.With(barRow);
        barRow.With(SpacerW(hpInset));
        int barW = Spec.SceneMonHpW();
        if (maxHp > 0) { barW = Spec.SceneMonHpW() * curHp / maxHp; }
        if (barW < Spec.Px(2)) { barW = Spec.Px(2); }
        Panel bar = Panel.Row(); bar.Class = "scene-mon-bar";
        bar.Prefer(barW, Spec.SceneMonHpBarH()); barRow.With(bar);
        Panel gapRow = Panel.Column(); gapRow.Prefer(0, Spec.SceneMonGap());
        block.With(gapRow);
        Panel spRow = Panel.Row(); spRow.Pad(0); spRow.Prefer(0, Spec.SceneMonBoxH());
        block.With(spRow);
        spRow.With(SpacerW(spInset));
        Image sp = new Image(pic > 0 ? PicturePath("boss", pic) : "assets/item/00002.png",
            b.Name, "contain");
        sp.Prefer(Spec.SceneMonBoxW(), Spec.SceneMonBoxH()); spRow.With(sp);

        /* 属性栏：占右半 380 设备，10 行两列对齐。 */
        Panel stat = BossHomeStatPanel();
        stat.Prefer(Spec.Px(280), 0);
        stat.AnchorRight(); zone.Add(stat);

        return zone;
    }

    // 属性栏的右边界（用于怪物立绘居中算 inset）。
    int rightOfSplit(int paneW) { return Spec.Px(280); }

    // 10 行属性：气血/法力/等级/转生/攻击/魔法/道术/防御/魔防/幸运。
    Panel BossHomeStatPanel() {
        BossDetail b = BossHomeBoss();
        int hp = b.Hp;
        int mp = b.Mp;
        int lv = b.MinLevel;
        int rebirth = b.Rebirth;
        int atkMin = b.AttackMin;
        int atkMax = b.AttackMax;
        int magMin = b.MagicMin;
        int magMax = b.MagicMax;
        int taoMin = b.TaoMin;
        int taoMax = b.TaoMax;
        int defMin = b.DefenseMin;
        int defMax = b.DefenseMax;
        int mdefMin = b.MagicDefenseMin;
        int mdefMax = b.MagicDefenseMax;

        Panel p = Panel.Column(); p.Class = "bosshome-stat";
        p.Pad(0); p.Gap(Spec.Px(2));
        p.Padding(Spec.SceneTitleInsetT(), 0, 0, 0);
        p.With(StatLine("气血", Rules.N(hp), "red"));
        p.With(StatLine("法力", Rules.N(mp), "blue"));
        p.With(StatLine("等级", Rules.N(lv) + "级", "green"));
        p.With(StatLine("转生", Rules.N(rebirth), "magenta"));
        p.With(StatLine("攻击", Rules.N(atkMin) + " - " + Rules.N(atkMax), "red"));
        p.With(StatLine("魔法", Rules.N(magMin) + " - " + Rules.N(magMax), "blue"));
        p.With(StatLine("道术", Rules.N(taoMin) + " - " + Rules.N(taoMax), "magenta"));
        p.With(StatLine("防御", Rules.N(defMin) + " - " + Rules.N(defMax), "red"));
        p.With(StatLine("魔防", Rules.N(mdefMin) + " - " + Rules.N(mdefMax), "magenta"));
        p.With(StatLine("幸运", "2", "magenta"));
        return p;
    }

    Panel StatLine(string label, string value, string valCls) {
        Panel row = Panel.Row(); row.Class = "stat-line";
        row.Pad(0); row.Gap(0); row.Prefer(0, Spec.Px(20));
        Label l = Text(label + "：", "stat-label", 0);
        l.Prefer(Spec.Px(60), 0); row.With(l);
        Label v = Text(value, valCls, 0);
        v.Grow(); row.With(v);
        return row;
    }

    // 底部：左 说明 + 空输入框；中 自动（复选框）；右 挑战BOSS。
    Panel BossHomeFooter() {
        Panel foot = Panel.Column(); foot.Class = "scene-foot";
        foot.Pad(0); foot.Gap(0); foot.Prefer(0, Spec.SceneFootH());

        Panel btnPad = Panel.Column(); btnPad.Prefer(0, Spec.SceneBtnInsetB());
        btnPad.AnchorBottom(); foot.Add(btnPad);
        Panel btnRow = Panel.Row(); btnRow.Pad(0); btnRow.Gap(0);
        btnRow.Prefer(0, Spec.SceneBtnH());
        btnRow.Padding(0, Spec.SceneBtnInsetR(), 0, Spec.SceneBtnPadL());
        btnRow.AnchorBottom(); foot.Add(btnRow);
        /* 左：说明 + 输入框。 */
        Button help = Btn("说明", "scene-btn", () => { BossHomeHelp(); });
        help.Prefer(Spec.Px(60), Spec.SceneBtnH()); btnRow.With(help);
        Input empty = new Input(""); empty.Prefer(Spec.Px(80), Spec.SceneBtnH());
        btnRow.With(empty);
        Panel fill = Panel.Row(); fill.Grow(); btnRow.With(fill);
        /* 中：自动复选框。 */
        Checkbox autoCb = SceneAutoResetCheck();
        autoCb.Prefer(Spec.SceneChkW(), Spec.SceneBtnH()); btnRow.With(autoCb);
        /* 右：挑战BOSS。 */
        Button fight = Btn("挑战BOSS", "scene-btn", () => { BossHomeFight(); });
        fight.Prefer(Spec.SceneBtnChallengeW(), Spec.SceneBtnH());
        btnRow.With(fight);

        /* 提示行（与幻境同位）。 */
        Panel g1 = Panel.Column(); g1.Prefer(0, Spec.SceneFootGap1()); g1.AnchorBottom(); foot.Add(g1);
        Panel hintRow = Panel.Row(); hintRow.Pad(0); hintRow.Prefer(0, Spec.SceneHintH());
        hintRow.Padding(0, Spec.SceneHintInsetR(), 0, 0);
        hintRow.AnchorBottom(); foot.Add(hintRow);
        Panel hintFill = Panel.Row(); hintFill.Grow(); hintRow.With(hintFill);
        Label hint = Text("提示：挑战都会消耗次数", "scene-hint", 0);
        hint.AnchorRight(); hintRow.Add(hint);

        /* 剩余次数（与幻境左下「最高记录」同位）。 */
        Panel g2 = Panel.Column(); g2.Prefer(0, Spec.SceneFootGap2()); g2.AnchorBottom(); foot.Add(g2);
        Panel leftRow = Panel.Row(); leftRow.Pad(0); leftRow.Prefer(0, Spec.SceneChkRowH());
        leftRow.Padding(0, 0, 0, Spec.SceneBtnPadL());
        leftRow.AnchorBottom(); foot.Add(leftRow);
        int left = g.bossTries > 0 ? g.bossTries : GameTables.Value("boss_tries");
        Label leftL = Text("剩余BOSS挑战次数：" + Rules.N(left) + "次", "scene-record", 0);
        leftRow.With(leftL);

        return foot;
    }

    // BOSS 表格 12 行（编号 / BOSS名称 / 等级）。
    Panel BossHomeTable() {
        Panel p = Panel.Column(); p.Class = "bosshome-table";
        p.Pad(0); p.Gap(0);
        p.Padding(Spec.SceneRankPadT(), 0, 0, 0);

        /* 表头。 */
        Panel head = Panel.Row(); head.Class = "table-head";
        head.Pad(0); head.Gap(0); head.Prefer(0, Spec.SceneRankTextH());
        head.Padding(0, Spec.SceneRankFacePad(), 0, Spec.SceneRankFacePad());
        Label c1 = Text("编号", "table-head-cell", 0); c1.Prefer(Spec.Px(60), 0); head.With(c1);
        Label c2 = Text("BOSS名称", "table-head-cell", 0); c2.Grow(); head.With(c2);
        Label c3 = Text("等级", "table-head-cell", 0); c3.Prefer(Spec.Px(60), 0); head.With(c3);
        p.With(head);

        /* 12 行。 */
        int startId = bossHomePage * 12 + 1;
        for (int r = 0; r < 12; r = r + 1) {
            int idx = bossHomePage * 12 + r;
            int id = startId + r;
            string name = "";
            int lv = 0;
            if (net.Self() != null && net.BossCount() > 0) {
                if (idx < net.BossCount()) {
                    BossInfo bi = net.TypedBossAt(idx);
                    if (bi != null) {
                        id = bi.Tpl > 0 ? bi.Tpl : (idx + 1);
                        name = bi.Name;
                        lv = bi.MinLevel;
                    }
                }
            } else {
                BossDetail detail = (id >= 1 && id <= GameTables.current.bosses.rows.Count)
                    ? GameTables.current.BossDetailAt(id) : null;
                lv = detail != null ? detail.MinLevel : 0;
                name = detail != null ? detail.Name : "";
            }
            Panel tr = Panel.Row();
            tr.Class = r == bossHomeRow ? "table-row table-row-active" : "table-row";
            tr.Pad(0); tr.Gap(0); tr.Prefer(0, Spec.SceneRankTextH());
            tr.Padding(0, Spec.SceneRankFacePad(), 0, Spec.SceneRankFacePad());
            int rowIdx = r;
            tr.OnClick(() => { bossHomeRow = rowIdx; BuildPage(); });
            Label n1 = Text(Rules.N(id), "table-cell", 0); n1.Prefer(Spec.Px(60), 0); tr.With(n1);
            Label n2 = Text(name, "table-cell", 0); n2.Grow(); tr.With(n2);
            Label n3 = Text(name.Length > 0 ? (Rules.N(lv) + "级") : "", "table-cell", 0); n3.Prefer(Spec.Px(60), 0); tr.With(n3);
            p.With(tr);
        }

        /* 分页 1/N。 */
        Panel pager = Panel.Row(); pager.Class = "scene-pager";
        pager.Pad(0); pager.Gap(Spec.Px(8));
        pager.Prefer(0, Spec.SceneChkRowH());
        pager.Padding(0, Spec.SceneRankFacePad(), 0, Spec.SceneRankFacePad());
        Button prev = Btn("上一页", "scene-btn", () => {
            if (bossHomePage > 0) { bossHomePage = bossHomePage - 1; bossHomeRow = 0; BuildPage(); }
        });
        prev.Prefer(Spec.Px(70), Spec.SceneChkRowH()); pager.With(prev);
        Label pp = Text(Rules.N(bossHomePage + 1) + "/" + Rules.N(BossHomePageCount()),
            "scene-pager-text", 0); pp.Prefer(Spec.Px(40), 0); pager.With(pp);
        Button next = Btn("下一页", "scene-btn", () => {
            if (bossHomePage + 1 < BossHomePageCount()) { bossHomePage = bossHomePage + 1; bossHomeRow = 0; BuildPage(); }
        });
        next.Prefer(Spec.Px(70), Spec.SceneChkRowH()); pager.With(next);
        p.With(pager);

        return p;
    }

    /* =====================================================================
       动作
       ===================================================================== */

    void BossHomeFight() {
        if (net.Self() != null) {
            net.AddChat("[系统]", "BOSS之家 需先击败该 BOSS 解锁再挑战。");
            return;
        }
        if (g.bossTries <= 0) { g.Log("今日 BOSS 挑战次数已用完。"); return; }
        g.bossTries = g.bossTries - 1;
        g.active = true;
        g.Log("BOSS之家 挑战：" + BossHomeBoss().Name);
    }

    void BossHomeHelp() {
        string text = "BOSS之家：挑战次数与世界BOSS 共享。每天 20 次。打输 BOSS 留血接着挑战，胜利解锁下一只。";
        if (net.Self() != null) { net.AddChat("[系统]", text); return; }
        g.Log(text);
    }
}
