using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 16「将星图谱」——照原版还原（将星图谱.png），规格见 Spec / REFERENCE_AUDIT §5.4。
/// · 左侧 13 格分类分栏（8 个分类 + 5 个「待开放」，原版后 5 格只画一个小横杠）
/// · 右侧 5 列 × 2 行图谱卡：tupu 立绘 120×170（素材原寸，卡面即原图）
/// + 三层压图文字（等级角标 / 气血天赋 / 名字）+ 下方「[价格][激活]」条
/// · 页脚：左「图谱积分：0」，右 [说明] + 标准库 Pagination（原版 1/1）
/// 只有第 1 格「古代美女」有原版对照图，其余分类原版没导出数据：分栏可切
/// 选中态但不换卡阵内容（不臆造原版的筛选规则，同商店页货币 tab 的处理），
/// 点其余分类按本模板对未接功能的惯例给一句明确反馈。
partial class LegendApp {

    /// 分类分栏选中项（默认第 1 格「古代美女」，原版对照图就是这一档）。
    int starTab = 0;

    /// 卡阵页号（在线一行一张 boss 星位，10 张/页）。
    int starPageNo = 0;

    /// 星位行数据：在线全面消费服务端 stars 实体列表（StarRowItem）；单机离线隔离回退。
    List<StarRowItem> StarRows() {
        bool online = net.Self() != null;
        if (online) {
            StarState st = net.TypedStars();
            if (st != null && st.Rows != null) {
                return st.Rows;
            }
            return new List<StarRowItem>();
        }
        List<StarRowItem> list = new List<StarRowItem>();
        if (GameTables.current != null && GameTables.current.bosses != null) {
            DataTable tb = GameTables.current.bosses;
            for (int i = 0; i < tb.rows.Count && i < 35; i = i + 1) {
                DataRow dr = tb.rows[i];
                list.Add(new StarRowItem(dr.Text("name"), dr.Int("level"), dr.Int("map_id"), false));
            }
        }
        return list;
    }

    static int StarRowCount(List<StarRowItem> rows) {
        return rows != null ? rows.Count : 0;
    }

    /// 分类分栏 13 格（照 `将星图谱.png` 逐格抄录）。
    static string[] StarTabs() {
        return new string[] {
            "古代美女", "上古神剑", "十大神器", "三国演义", "英雄联盟",
            "水浒传", "王者荣耀", "待开放", "-", "-", "-", "-", "-"
        };
    }

    static string StarArtPath(int art) {
        return "assets/tupu/" + Rules.N(art).PadLeft(5, "0") + ".jpg";
    }

    void BuildStarPage() {
        /* 在线进页才拉星位（Maybe 守卫：有缓存不再发）。 */
        if (net.Self() != null) { net.RefreshStars(); }
        Panel body = Panel.Column(); body.Class = "star-page";
        body.Pad(0); body.Gap(0); body.Grow(); content.With(body);

        Panel top = Panel.Column(); top.Prefer(0, Spec.StarTopPad());
        body.With(top);

        /* 主带：左分栏 + 右卡阵。两侧都是定宽定高块，直接一条 Row 摆齐。 */
        Panel main = Panel.Row(); main.Pad(0); main.Gap(0); body.With(main);
        main.With(SpacerW(Spec.StarPadL()));

        Panel tabs = Panel.Column(); tabs.Class = "star-tabs";
        tabs.Pad(0); tabs.Gap(Spec.StarTabGap());
        tabs.Prefer(Spec.StarTabW(), 0); main.With(tabs);
        string[] names = StarTabs();
        for (int i = 0; i < Spec.StarTabs(); i = i + 1) {
            tabs.With(StarTab(i, names[i]));
        }

        main.With(SpacerW(Spec.StarTabToWall()));

        Panel wall = Panel.Column(); wall.Class = "star-wall";
        wall.Pad(0); wall.Gap(Spec.StarRowGap());
        wall.Prefer(Spec.StarCardW() * 5 + Spec.StarColGap() * 4, 0);
        main.With(wall);
        /* 卡阵数据：全面使用真实星位实体（按页切 10 张），杜绝硬编码假卡牌。 */
        bool online = net.Self() != null;
        List<StarRowItem> rows = StarRows();
        int nRows = StarRowCount(rows);
        int pages = (nRows + 9) / 10;
        if (pages < 1) { pages = 1; }
        if (this.starPageNo > pages - 1) { this.starPageNo = pages - 1; }
        if (online && nRows == 0) {
            Panel empty = Panel.Row(); empty.Pad(0);
            empty.Prefer(Spec.StarCardW() * 5 + Spec.StarColGap() * 4, Spec.StarCardH() * 2);
            empty.With(Text("正在同步将星图谱数据...", "star-foot-l", 0));
            wall.With(empty);
        } else {
            for (int r = 0; r < 2; r = r + 1) {
                Panel row = Panel.Row(); row.Class = "star-row";
                row.Pad(0); row.Gap(Spec.StarColGap());
                row.Prefer(0, Spec.StarCardH()); wall.With(row);
                for (int c = 0; c < 5; c = c + 1) {
                    int i = r * 5 + c;
                    int k = this.starPageNo * 10 + i;
                    if (k >= nRows) { break; }
                    row.With(StarLiveCard(k, rows[k]));
                }
            }
        }

        Panel fill = Panel.Column(); fill.Grow(); body.With(fill);

        /* 页脚贴页底（同商店/城池页的 dock=2 次序：先 Add 的先占底）。 */
        Panel footPad = Panel.Column(); footPad.Prefer(0, Spec.StarFootPadB());
        footPad.AnchorBottom(); body.Add(footPad);
        Panel foot = Panel.Row(); foot.Class = "star-foot";
        foot.Pad(0); foot.Gap(Spec.Px(3));
        foot.Prefer(0, Spec.StarFootH());
        foot.Padding(0, Spec.StarFootPadR(), 0, Spec.StarFootPadL());
        foot.AnchorBottom(); body.Add(foot);
        /* 在线页脚 = 点亮进度 + 服务端页数翻页；离线保持原版「图谱积分：0」。 */
        int litCount = 0;
        if (rows != null) {
            for (int i = 0; i < nRows; i = i + 1) {
                if (rows[i].Lit) { litCount = litCount + 1; }
            }
        }
        foot.With(Text(rows != null ? "已点亮：" : "图谱积分：", "star-score-k", 0));
        foot.With(Text(rows != null
            ? Rules.N(litCount) + " / " + Rules.N(nRows) : "0", "star-score-v", 0));
        Panel gfill = Panel.Row(); gfill.Grow(); foot.With(gfill);
        foot.With(BtnDev("说明", "star-say", Spec.StarSayW(), Spec.Px(20),
            () => { StarSay(); }));
        SignalInt pgSig = new SignalInt(this.starPageNo + 1);
        Pagination pg = new Pagination(pages, pgSig);
        pg.Class = "simple";
        pg.PrevText("上一页"); pg.NextText("下一页");
        pg.Named("star-pager");
        pg.Change += () => {
            this.starPageNo = pgSig.Get() - 1;
            if (this.starPageNo < 0) { this.starPageNo = 0; }
            BuildPage(); Refresh();
        };
        foot.With(pg);
    }

    /// 在线一张星位卡：立绘用该图地图缩略图，点亮态压「已点亮」章，
    /// 未点亮给「前往讨伐」（跳地图内页打 BOSS，胜即点亮）。
    Panel StarLiveCard(int i, StarRowItem r) {
        int mapId = r.Map;
        bool lit = r.Lit;
        string name = r.Name.Length > 0 ? r.Name : "？？";
        string badge = Rules.N(r.Level) + "级";

        Panel card = Panel.Column(); card.Class = "star-card";
        card.Pad(0); card.Gap(Spec.StarArtGap());
        card.Prefer(Spec.StarCardW(), Spec.StarCardH());
        card.Named("star-live-" + Rules.N(i));

        Panel art = Panel.Column(); art.Class = "star-art";
        art.Pad(0); art.Prefer(Spec.StarCardW(), Spec.StarArtH());
        Image frame = new Image("assets/ui/00257.png", name, "fill");
        frame.Grow(); art.Add(frame);
        Panel inner = Panel.Column(); inner.Class = "star-inner-layer";
        inner.Pad(0);
        Image pic = new Image(MapThumbPath(mapId, false), name, "cover");
        pic.Grow(); inner.Add(pic);
        art.With(inner);
        art.With(CenterRow(badge, "star-ov star-ov-badge", "star-badge",
            0, Spec.Px(13)));
        art.With(CenterRow(lit ? "已点亮" : "未点亮",
            "star-ov star-ov-talent", "star-talent", 0, Spec.Px(13)));
        art.With(CenterRow(name, "star-ov star-ov-name", "star-name",
            0, Spec.Px(14)));
        card.With(art);

        Panel price = Panel.Row(); price.Class = "star-price";
        price.Pad(0); price.Gap(0); price.Prefer(Spec.StarCardW(), Spec.StarPriceH());
        price.With(CenterRow(lit ? "图谱已点亮" : "讨伐该图BOSS点亮",
            "star-price-v", "star-price-t", 0, Spec.StarPriceH()));
        if (!lit && mapId > 0) {
            price.With(BtnDev("前往讨伐", "star-act", Spec.StarPriceBtnW(), Spec.StarPriceH(),
                () => { netInnerMap = mapId; net.OpenMapPage(mapId); Navigate(31); }));
        }
        card.With(price);
        return card;
    }

    /// 一格分类：选中态亮一档；其余分类原版没数据，点了只改选中态 + 记一句。
    Panel StarTab(int i, string name) {
        bool dash = name == "-";
        Panel tab = Panel.Row();
        tab.Class = i == starTab ? "star-tab star-tab-on"
            : (dash ? "star-tab star-tab-dash" : "star-tab");
        tab.Pad(0); tab.Prefer(Spec.StarTabW(), Spec.StarTabH());
        tab.Named("star-tab-" + Rules.N(i));
        if (!dash) {
            int pick = i;
            tab.OnClick(() => { StarPick(pick); });
        }
        /* 分栏字居中（原版这一列字都对格心中）：Label 不吃 text-align，
           `.star-tab` 自己是 flex 容器，居中靠它排。 */
        tab.With(Text(name, "star-tab-text", 0));
        return tab;
    }

    void StarPick(int i) {
        starTab = i;
        if (i != 0) {
            StarSay2("「" + StarTabs()[i] + "」图谱本版没有原版对照数据，暂只展示「古代美女」档。");
        }
        BuildPage(); Refresh();
    }

    // 动作（玩法说明与反馈）
    void StarSay() {
        if (net.Self() != null) {
            StarSay2("每张地图的BOSS是一个图谱位，讨伐胜利即点亮；点亮的图谱是征战足迹。");
            return;
        }
        StarSay2("每张地图的BOSS是一个图谱位，击败BOSS后点亮图谱。");
    }

    void StarSay2(string msg) {
        if (net.Self() != null) { net.AddChat("[系统]", msg); return; }
        g.Log(msg);
    }
}
