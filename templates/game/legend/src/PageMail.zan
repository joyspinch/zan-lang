using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 29「邮箱」——照原版逐像素还原（`mir2/mir/邮箱.png`）。
///
/// 版式 = 715 设备高的浮窗外框（374..1491 × 164..879，与交易市场同框）：
///   · 左（376..1100）：三行「标签 | 输入」框（邮件标题 绿 / 发 件 人 青 /
///     发送日期 红，一枚蓝框里左标签区 + 1 设备竖线 + 输入区）+ 右侧一枚跨三行
///     的「删除」钮；下面正文框（392..1085 × 303..738，底 `#171e29`）；再下
///     8 枚附件格（`00211.png` 通用格 66×66，节距 69）+「提取道具」高钮；
///     最底一行灰字提示 +「清空已领邮件」「一键领取」。
///   · 右（1103..1489）：「编号 / 邮件标题」头带（47 高）+ 12 行两格空行
///     （`#101e2d`，节距 50，末行品红 `#570d41` = 当前选中）+ 页脚
///     「刷新邮件」+ 标准库 Pagination 1/1。
///
/// 数据一行一实体（`MailRow`）；原图邮箱为空，所以 `MailData()` 为空表、
/// 12 行都是占位空行，选中行下标照原图取末行。
partial class LegendApp {
    /// 一封邮件。
    class MailRow {
        int id;
        string title;
        string sender;
        string date;        // yyyy-MM-dd HH:mm
        string body;
        List<int> items;    // 附件道具图号（items.csv picture），最多 8 个
        int claimed;        // 附件是否已领（服务端态，离线行 = 0）
    }

    static List<MailRow> mailData = null;
    static List<MailRow> MailData() {
        if (mailData != null) { return mailData; }
        mailData = new List<MailRow>();
        return mailData;
    }

    /// 当前邮件列表：在线 = 服务端邮箱（≤50 封新信在前），离线 = 空表。
    List<MailRow> MailRows() {
        if (net.Self() == null || net.MailsList() == null || net.MailsList().Count == 0) { return MailData(); }
        List<MailItem> all = net.MailsList();
        List<MailRow> v = new List<MailRow>();
        for (int i = 0; i < all.Count; i = i + 1) {
            MailItem m = all[i];
            MailRow r = new MailRow();
            r.id = m.Id;
            r.title = m.Title;
            r.sender = m.Sender;
            r.date = m.Date;
            r.body = m.Body;
            r.claimed = m.Claimed;
            r.items = new List<int>();
            for (int k = 0; k < m.Items.Count && k < 8; k = k + 1) {
                r.items.Add(m.Items[k]);
            }
            v.Add(r);
        }
        return v;
    }

    /// 当前选中邮件（下标越界收敛到末行——原图选中态就在末行）。
    MailRow MailCur() {
        List<MailRow> rows = MailRows();
        if (rows.Count == 0) { mailSel = 11; return null; }
        if (mailSel < 0 || mailSel >= rows.Count) { mailSel = rows.Count - 1; }
        return rows[mailSel];
    }

    static int mailSel = 11;    // 原图：第 12 行（末行）品红选中

    void BuildMailPage() {
        if (net.Self() != null) { net.MaybeRefreshMail(); }
        Panel frame = Panel.Row(); frame.Class = "ml-frame";
        frame.Pad(0); frame.Gap(Spec.MlColGap());
        frame.Prefer(0, Spec.MlFrameH());
        frame.Padding(Spec.MlFramePadT(), 0, 0, 0);
        content.With(frame);
        frame.With(MailLeft());
        frame.With(MailRight());
    }

    // ------------------------------------------------------------------
    //  左：三行标签框 + 删除 + 正文 + 附件格 + 页脚
    // ------------------------------------------------------------------
    Panel MailLeft() {
        Panel p = Panel.Column(); p.Class = "ml-left mk-fixed";
        p.Pad(0); p.Gap(0); p.Prefer(Spec.MlLeftW(), 0);
        // 停靠列里子项一律拉满列宽——正文/附件行/页脚的右沿 1085 用列的右内边距给
        p.Padding(Spec.MlLeftPadT(), Spec.MlLeftPadR(), 0, Spec.MlLeftPadL());

        MailRow cur = MailCur();

        // 三行字段 + 跨三行的删除钮
        Panel top = Panel.Row(); top.Class = "ml-fields"; top.Pad(0); top.Gap(Spec.MlDelGap());
        Panel fields = Panel.Column(); fields.Class = "mk-fixed"; fields.Pad(0); fields.Gap(0);
        fields.Prefer(Spec.MlFieldW(), 0);
        fields.With(MailField("邮件标题:", "ml-lab-green", cur == null ? "" : cur.title));
        fields.With(TblPad(Spec.MlFieldGap()));
        fields.With(MailField("发 件 人:", "ml-lab-cyan", cur == null ? "" : cur.sender));
        fields.With(TblPad(Spec.MlFieldGap()));
        fields.With(MailField("发送日期:", "ml-lab-red", cur == null ? "" : cur.date));
        top.With(fields);
        top.With(BtnDev("删除", "tbl-btn ml-btn", Spec.MlDelW(), Spec.MlDelH(), () => { MailDelete(); }));
        p.With(top);

        p.With(TblPad(Spec.MlFieldToBody()));
        Panel body = Panel.Column(); body.Class = "ml-body"; body.Pad(0);
        body.Prefer(0, Spec.MlBodyH());
        if (cur != null && cur.body.Length > 0) {
            body.Padding(Spec.MlBodyPad(), Spec.MlBodyPad(), Spec.MlBodyPad(), Spec.MlBodyPad());
            body.With(Text(cur.body, "ml-body-t", 0));
        }
        p.With(body);

        // 附件格 ×8 + 提取道具
        p.With(TblPad(Spec.MlBodyToSlots()));
        Panel sl = Panel.Row(); sl.Class = "ml-slots"; sl.Pad(0); sl.Gap(Spec.MlSlotGap());
        sl.Prefer(0, Spec.MlSlotH());
        sl.Padding(0, 0, 0, Spec.MlSlotPadL());
        for (int i = 0; i < 8; i = i + 1) {
            string art = "";
            if (cur != null && i < cur.items.Count) { art = ItemArtPath(cur.items[i]); }
            sl.With(SpriteCell("", Spec.MlSlotW(), Spec.MlSlotH(), art, "", ""));
        }
        Panel sp = Panel.Row(); sp.Class = "mk-fill"; sp.Pad(0); sl.With(sp);
        sl.With(BtnDev("提取道具", "tbl-btn ml-btn", Spec.MlTakeW(), Spec.MlTakeH(), () => { MailTakeItems(); }));
        p.With(sl);

        // 提示 + 清空已领邮件 + 一键领取
        p.With(TblPad(Spec.MlSlotsToFoot()));
        Panel f = Panel.Row(); f.Class = "ml-foot"; f.Pad(0); f.Gap(Spec.MlBtnGap());
        f.Prefer(0, Spec.MlFootH());
        f.Padding(0, 0, 0, Spec.MlHintPadL());
        Panel hint = Panel.Row(); hint.Class = "mk-fill ml-hint-row"; hint.Pad(0);
        hint.With(Text("领取道具时请注意背包是否有足够的空闲位置。", "ml-hint", 0));
        f.With(hint);
        f.With(BtnDev("清空已领邮件", "tbl-btn ml-btn", Spec.MlClearW(), Spec.MlFootH(), () => { MailClearRead(); }));
        f.With(BtnDev("一键领取", "tbl-btn ml-btn", Spec.MlTakeAllW(), Spec.MlFootH(), () => { MailTakeAll(); }));
        p.With(f);
        return p;
    }

    /// 一行字段框：蓝框里「标签区 | 1 设备竖线 | 输入区」，输入区与框同底色。
    Panel MailField(string label, string labCls, string value) {
        Panel box = Panel.Row(); box.Class = "ml-field"; box.Pad(0); box.Gap(0);
        box.Prefer(0, Spec.MlFieldH());
        Panel lz = Panel.Row(); lz.Class = "ml-field-label"; lz.Pad(0);
        lz.Prefer(Spec.MlLabelW(), 0);
        lz.Padding(0, 0, 0, Spec.MlLabelPadL());
        lz.With(Text(label, labCls, 0));
        box.With(lz);
        Panel dv = Panel.Row(); dv.Class = "ml-divider"; dv.Pad(0);
        dv.Prefer(Spec.Px(1), 0);
        box.With(dv);
        // 输入框默认高度比 33 的框高，会盖掉框的上下边线——压到框内高
        Input inp = new Input(value); inp.Class = "ml-input mk-fill";
        inp.Prefer(0, Spec.MlInputH());
        box.With(inp);
        return box;
    }

    // ------------------------------------------------------------------
    //  右：编号 / 邮件标题 列表 + 刷新 + 分页
    // ------------------------------------------------------------------
    Panel MailRight() {
        Panel col = Panel.Column(); col.Class = "ml-right mk-fill";
        col.Pad(0); col.Gap(0);

        Panel head = Panel.Row(); head.Class = "ml-head"; head.Pad(0); head.Gap(Spec.MlCellGap());
        head.Prefer(0, Spec.MlHeadH());
        head.Padding(0, Spec.MlRowPadR(), 0, Spec.MlRowPadL());
        Panel h0 = Panel.Row(); h0.Class = "mk-cell"; h0.Pad(0); h0.Prefer(Spec.MlIdW(), Spec.MlHeadH());
        h0.With(Text("编号", "ml-head-t", 0)); head.With(h0);
        Panel h1 = Panel.Row(); h1.Class = "mk-cell mk-fill"; h1.Pad(0); h1.Prefer(0, Spec.MlHeadH());
        h1.With(Text("邮件标题", "ml-head-t", 0)); head.With(h1);
        col.With(head);

        col.With(TblPad(Spec.MlHeadToRow()));
        List<MailRow> rows = MailRows();
        for (int r = 0; r < Spec.MlRows(); r = r + 1) {
            col.With(MailRowBox(r < rows.Count ? rows[r] : null, r == mailSel, r));
            if (r + 1 < Spec.MlRows()) { col.With(TblPad(Spec.MlRowGap())); }
        }

        col.With(TblPad(Spec.MlRowsToFoot()));
        Panel f = Panel.Row(); f.Class = "ml-rfoot"; f.Pad(0); f.Gap(0);
        f.Prefer(0, Spec.MlRFootH());
        f.Padding(0, Spec.MlRFootPadR(), 0, Spec.MlRefreshPadL());
        f.With(BtnDev("刷新邮件", "tbl-btn ml-btn", Spec.MlRefreshW(), Spec.MlRFootH(), () => { MailRefresh(); }));
        Panel sp = Panel.Row(); sp.Class = "mk-fill"; sp.Pad(0); f.With(sp);
        SignalInt pgSig = new SignalInt(1);
        Pagination pg = new Pagination(Spec.MlPages(), pgSig);
        pg.Class = "simple";
        pg.PrevText("上一页"); pg.NextText("下一页");
        pg.Named("mail-pager");
        f.With(pg);
        col.With(f);
        return col;
    }

    /// 一行两格（编号 | 标题），空邮件也画格；选中行品红。
    Panel MailRowBox(MailRow m, bool sel, int idx) {
        Panel row = Panel.Row(); row.Class = "ml-row"; row.Pad(0); row.Gap(Spec.MlCellGap());
        row.Prefer(0, Spec.MlRowH());
        row.Padding(0, Spec.MlRowPadR(), 0, Spec.MlRowPadL());
        string cellCls = sel ? "mk-cell ml-cell-sel" : "mk-cell ml-cell";
        Panel c0 = Panel.Row(); c0.Class = cellCls; c0.Pad(0); c0.Prefer(Spec.MlIdW(), Spec.MlRowH());
        if (m != null) { c0.With(Text(Rules.N(m.id), "ml-row-t", 0)); }
        row.With(c0);
        Panel c1 = Panel.Row(); c1.Class = (sel ? "mk-cell-l ml-cell-sel" : "mk-cell-l ml-cell") + " mk-fill";
        c1.Pad(0); c1.Prefer(0, Spec.MlRowH());
        c1.Padding(0, 0, 0, Spec.MlTitlePadL());
        if (m != null) { c1.With(Text(m.title, "ml-row-t", 0)); }
        row.With(c1);
        int pick = idx;
        row.OnClick(() => { MailPick(pick); });
        return row;
    }

    // ------------------------------------------------------------------
    //  动作：在线走服务端 mail op（领取/删除/清空都回新列表）；离线照
    //  惯例给明确反馈。
    // ------------------------------------------------------------------
    void MailSay(string msg) {
        if (net.Self() != null) { net.AddChat("[系统]", msg); return; }
        g.Log(msg);
    }
    void MailPick(int i) {
        mailSel = i;
        List<MailRow> rows = MailRows();
        if (net.Self() != null && i >= 0 && i < rows.Count) { this.Rebuild(); return; }
        MailSay("邮箱：选中第 " + Rules.N(i + 1) + " 行（无邮件）");
        this.Rebuild();
    }
    void MailDelete() {
        MailRow cur = MailCur();
        if (net.Self() != null && cur != null) { net.MailDel(cur.id); return; }
        MailSay("邮箱：删除（无选中邮件）");
    }
    void MailTakeItems() {
        MailRow cur = MailCur();
        if (net.Self() != null && cur != null) {
            if (cur.claimed == 1) { MailSay("该邮件的附件已领取过"); return; }
            net.MailTake(cur.id);
            return;
        }
        MailSay("邮箱：提取道具（无附件）");
    }
    void MailClearRead() {
        if (net.Self() != null) { net.MailClear(); return; }
        MailSay("邮箱：清空已领邮件（未接）");
    }
    void MailTakeAll() {
        if (net.Self() != null) { net.MailTakeAll(); return; }
        MailSay("邮箱：一键领取（未接）");
    }
    void MailRefresh() {
        if (net.Self() != null) { net.RefreshMail(); return; }
        MailSay("邮箱：刷新邮件（未接）");
    }
}
