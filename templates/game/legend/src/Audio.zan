using System;
using System.IO;

namespace Legend;

delegate int PlaySoundFunc(string name, nint mod, int flags);

// 传奇原版音效引擎：基于 winmm PlaySoundA 实现零阻塞异步音效播放
class AudioEngine {
    static AudioEngine instance;
    PlaySoundFunc playSound;
    bool available = false;
    public bool enabled = true;
    string assetBase = "";

    public static AudioEngine Get() {
        if (instance == null) {
            instance = new AudioEngine();
            instance.Init();
        }
        return instance;
    }

    void Init() {
        #if WINDOWS
        nint winmm = Interop.Load("winmm.dll");
        if (winmm != 0) {
            nint addr = Interop.Symbol(winmm, "PlaySoundA");
            if (addr != 0) {
                playSound = (PlaySoundFunc)addr;
                available = true;
            }
        }
        #endif
        // 定位 assets/wav 目录
        string[] candidates = new string[] {
            "templates/game/legend/assets/wav",
            "assets/wav",
            "../assets/wav",
            "../../assets/wav"
        };
        foreach (string c in candidates) {
            if (Directory.Exists(c)) {
                assetBase = c;
                break;
            }
        }
    }

    public void Play(string soundFile) {
        if (!enabled || !available || playSound == null) { return; }
        string fullPath = assetBase.Length > 0 ? (assetBase + "/" + soundFile) : soundFile;
        if (!File.Exists(fullPath)) { return; }
        // 核心契约与语义定义。
        playSound(fullPath, 0, 0x00020001);
    }

    public void PlaySwing() { Play("swing.wav"); }
    public void PlayHit() { Play("hit.wav"); }
    public void PlayCrit() { Play("crit.wav"); }
    public void PlayFireSlash() { Play("fire_slash.wav"); }
    public void PlayCrescent() { Play("crescent.wav"); }
    public void PlayLightning() { Play("lightning.wav"); }
    public void PlayPoison() { Play("poison.wav"); }
    public void PlayCoin() { Play("coin.wav"); }
    public void PlayLoot() { Play("loot.wav"); }
    public void PlayPotion() { Play("potion.wav"); }
    public void PlayBlessing() { Play("blessing.wav"); }
    public void PlayBtnClick() { Play("btn_click.wav"); }
    public void PlayTeleport() { Play("teleport.wav"); }

    public void PlayMonsterDie(string mobName) {
        if (mobName.Contains("稻草人") || mobName.Contains("鸡") || mobName.Contains("鹿")) {
            Play("die_scarecrow.wav");
        } else if (mobName.Contains("骷髅")) {
            Play("die_skeleton.wav");
        } else if (mobName.Contains("僵尸")) {
            Play("die_zombie.wav");
        } else if (mobName.Contains("野猪") || mobName.Contains("猪")) {
            Play("die_pig.wav");
        } else if (mobName.Contains("沃玛")) {
            Play("die_woma.wav");
        } else if (mobName.Contains("尸王")) {
            Play("die_corpse_king.wav");
        } else if (mobName.Contains("祖玛")) {
            Play("die_zuma.wav");
        } else if (mobName.Contains("赤月") || mobName.Contains("恶魔")) {
            Play("die_chiyue.wav");
        } else {
            Play("die_skeleton.wav");
        }
    }
}
