using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 8「传说塔」——照原版还原（传说塔.png），规格见 Spec / REFERENCE_AUDIT §5.4。
///
///   · 左：塔图 `assets/ui/00266.jpg`（原素材自带金字「传说塔」+ 宝塔，272×414
///     逻辑铺满），图上压两套绝对定位文字——六层标签（塔顶/第五层…第一层，
///     一列贴在塔身左沿）与右上「当前层数：1 / 我的层数：0」
///   · 左下「挑战次数：[0/10] [传说塔说明]」与右边名单最后一行同高
///   · 右：5 列 × 3 行挑战名单（立绘 + 名字 + 服务器：永久 + [挑战]）
///
/// 塔图用的是素材库里的整张塔图（原版那一张没有被导出），落位按原版实测的
/// 塔身占位给足，图上六层标签仍逐层照原版位置压。挑战/说明钮玩法未接，按本
/// 模板惯例给明确反馈，不假装已实现。
partial class LegendApp {

    /// 15 个挑战者（照 `传说塔.png` 逐行抄录，全部「服务器：永久」）。
    static string[] TowerNames() {
        return new string[] {
            "贝鲁盖米尔", "破坏者", "钢铁之孤狼", "蓝魔", "逆风飞扬",
            "魔鬼筋肉人", "参战一下", "郭峻", "大块头", "曲颈向天歌",
            "画饼", "鹅鹅鹅鹅鹅", "我嫩爹", "曾经独行", "知秋一叶"
        };
    }

    /// 六层标签（自上而下）。
    static string[] TowerLayers() {
        return new string[] { "塔顶", "第五层", "第四层", "第三层", "第二层", "第一层" };
    }

    /// 立绘：与竞技场/城池页同一套（ui/00043..00048.jpg）按格序轮换。
    static string TowerFacePath(int i) {
        int n = 43 + i % 6;
        return "assets/ui/000" + Rules.N(n) + ".jpg";
    }

    Panel VGap(int h) { Panel s = Panel.Column(); s.Prefer(0, h); return s; }

    void BuildTowerPage() {
        Panel body = Panel.Column(); body.Class = "tower-page";
        body.Pad(0); body.Gap(0); body.Grow(); content.With(body);

        Panel top = Panel.Column(); top.Prefer(0, Spec.TowerTopPad());
        body.With(top);

        Panel main = Panel.Row(); main.Pad(0); main.Gap(0);
        main.Prefer(0, Spec.TowerMainH()); body.With(main);
        main.With(SpacerW(Spec.TowerPadL()));

        /* 左列：塔图（+ 压图文字）→ 撑条 → 挑战次数行。撑条把底行压到与右边
           名单最后一行同高（原版这两条本来就在同一水平线上）。 */
        Panel left = Panel.Column(); left.Pad(0); left.Gap(0);
        left.Prefer(Spec.TowerArtW(), Spec.TowerMainH()); main.With(left);
        Panel scene = Panel.Column(); scene.Class = "tower-scene";
        scene.Pad(0); scene.Prefer(Spec.TowerArtW(), Spec.TowerArtH());
        left.With(scene);
        Image art = new Image("assets/ui/00266.jpg", "传说塔", "fill");
        art.DockFill(); scene.Add(art);
        string[] layers = TowerLayers();
        for (int i = 0; i < 6; i = i + 1) {
            /* 层名在格心里（原版实测字心≈格心）：Label 不吃 text-align，
               居中靠 `.tower-lab-row` 的 flex 排。 */
            scene.With(CenterRow(layers[i],
                "tower-lab-row tower-lab-" + Rules.N(i + 1), "tower-lab",
                Spec.TowerLabW(), Spec.TowerLabH()));
        }
        Label lv1 = Text("当前层数：1", "tower-lv tower-lv-1", 0);
        lv1.Prefer(Spec.Px(77), Spec.TowerLvH()); scene.With(lv1);
        Label lv2 = Text("我的层数：0", "tower-lv tower-lv-2", 0);
        lv2.Prefer(Spec.Px(77), Spec.TowerLvH()); scene.With(lv2);
        /* 撑条不是 Grow()：停靠流里 dock=5 的子项是**第二趟**排的，放在
           流中不占位（实测 Grow 撑条后面的底行会贴到塔图下沿，比原版高
           38 设备）。用固定高撑条把底行压到主带底（原版这行与名单末行
           同高）。 */
        left.With(VGap(Spec.TowerBottomGap()));
        left.With(TowerBottomRow());

        main.With(SpacerW(Spec.TowerArtToGrid()));

        Panel grid = Panel.Column(); grid.Class = "tower-grid";
        /* 名单顶偏移走内边距：停靠流的 Gap 会**在每个子项之间**生效，
           顶上放撑条会被多算一次行缝（实测多 31 设备）。 */
        grid.Padding(Spec.TowerGridTopPad(), 0, 0, 0);
        grid.Gap(Spec.TowerRowGap());
        grid.Prefer(Spec.TowerGridW(), 0); main.With(grid);
        string[] who = TowerNames();
        for (int r = 0; r < Spec.TowerRows(); r = r + 1) {
            Panel row = Panel.Row(); row.Class = "tower-row";
            row.Pad(0); row.Gap(Spec.TowerColGap());
            row.Prefer(0, Spec.TowerEntryH()); grid.With(row);
            for (int c = 0; c < Spec.TowerCols(); c = c + 1) {
                int i = r * Spec.TowerCols() + c;
                if (i >= who.Count) { break; }
                row.With(TowerEntry(i, who[i]));
            }
        }

        Panel fill = Panel.Column(); fill.Grow(); body.With(fill);
    }

    /// 左下：挑战次数 + 数值框 + 说明钮。
    Panel TowerBottomRow() {
        Panel row = Panel.Row(); row.Class = "tower-count";
        row.Pad(0); row.Gap(0); row.Prefer(0, Spec.TowerBottomH());
        Label k = Text("挑战次数：", "tower-count-k", 0);
        k.Prefer(Spec.TowerCountLabelW(), Spec.TowerBottomH()); row.With(k);
        row.With(SpacerW(Spec.TowerCountGap()));
        /* 次数框：白字在黑框里居中（原版实测字心 = 框心）。 */
        row.With(CenterRow("0/10", "tower-count-v", "tower-count-t",
            Spec.TowerCountBoxW(), Spec.TowerBottomH()));
        row.With(SpacerW(Spec.Px(7)));
        row.With(BtnDev("传说塔说明", "tower-say", Spec.TowerSayW(), Spec.TowerBottomH(),
            () => { TowerSay(); }));
        return row;
    }

    /// 一个挑战者：立绘 + 名字 + 服务器行 + [挑战]。
    Panel TowerEntry(int i, string name) {
        Panel e = Panel.Column(); e.Class = "tower-entry";
        e.Pad(0); e.Gap(0); e.Prefer(Spec.TowerAvaW(), Spec.TowerEntryH());
        e.Named("tower-entry-" + Rules.N(i));
        Image face = new Image(TowerFacePath(i), name, "cover");
        face.Class = "tower-ava";
        face.Prefer(Spec.TowerAvaW(), Spec.TowerAvaH());
        e.With(face);
        e.With(VGap(Spec.TowerNameGap()));
        /* 名字居中在立绘下方（原版实测字心 = 立绘中线）。 */
        e.With(CenterRow(name, "tower-name-row", "tower-name",
            Spec.TowerAvaW(), Spec.TowerNameH()));
        e.With(VGap(Spec.TowerSrvGap()));
        /* 占位撑条：绝对定位行不吃流高，用它把「服务器行」的高度留在
           流里。撑条与绝对行刻意叠在一起（同角标叠图的惯例），挂免检牌。 */
        Panel srvHold = VGap(Spec.TowerSrvH()); srvHold.NoOverlapCheck();
        e.With(srvHold);
        Panel srv = Panel.Row(); srv.Class = "tower-srv";
        srv.Pad(0); srv.Gap(0); srv.Prefer(Spec.TowerSrvW(), Spec.TowerSrvH());
        /* 两个标签各留 3~5 设备余量：Label 的 prefW 与绘制期的
           MeasureText 是两条度量路径，贴边时 MeasureText 大 1 就吃成
           「永…」（实测第一版就少了个「久」）。 */
        Label srvK = Text("服务器：", "tower-srv-k", 0);
        srvK.Prefer(Spec.TowerSrvKW(), Spec.TowerSrvH()); srv.With(srvK);
        Label srvV = Text("永久", "tower-srv-v", 0);
        srvV.Prefer(Spec.TowerSrvVW(), Spec.TowerSrvH()); srv.With(srvV);
        e.With(srv);
        e.With(VGap(Spec.TowerBtnGap()));
        int pick = i;
        e.With(BtnDev("挑战", "tower-fight", Spec.TowerBtnW(), Spec.TowerBtnH(),
            () => { TowerFight(pick); }));
        return e;
    }

    // ------------------------------------------------------------------
    //  动作（玩法未接：按本模板惯例给明确反馈，不假装已实现）
    // ------------------------------------------------------------------
    void TowerSay() {
        TowerSay2("传说塔每层都有守卫，击败当层守卫可以进入下一层，每天可挑战 10 次。");
    }

    void TowerSay2(string msg) {
        if (net.Self() != null) { net.AddChat("[系统]", msg); return; }
        g.Log(msg);
    }

    void TowerFight(int i) {
        string[] who = TowerNames();
        if (i < 0 || i >= who.Count) { return; }
        TowerSay2("挑战「" + who[i] + "」（玩法未接：传说塔需要服务端逐层推进）");
    }
}
