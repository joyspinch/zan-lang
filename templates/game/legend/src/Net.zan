                    this.playWuxing = a;
                    if (this.typedWuxing == null) { this.typedWuxing = new WuxingState(); }
                    this.typedWuxing.Pool = a.Int("pool", 0);
                    this.typedWuxing.PoolCap = a.Int("poolCap", 0);
                    this.typedWuxing.Rows.Clear();
                    JsonValue rows = a.Get("rows");
                    if (rows != null && rows.IsArray()) {
                        for (int i = 0; i < rows.Count(); i = i + 1) {
                            JsonValue s = rows.At(i);
