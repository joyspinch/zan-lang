    /* 图鉴明细：kind=items/mobs 分页（每页 20 条，服务端切页）。 */
    void RefreshCodexPage(string kind, int page) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "codexpage");
        body.PutStr("kind", kind);
        body.PutInt("page", page);
        this.Op(body.ToJson(), (JsonValue r) => {
            JsonValue rows = r.Get("rows");
            if (rows != null && rows.IsArray()) {
                this.codexKind = kind;
                this.codexPageNo = page;
                this.codexTotal = r.Int("total", 0);
                this.codexPage = rows;
                this.Bump();
            }
        });
    }

    void RefreshTitle() {
        this.Op("{\"op\":\"title\"}", (JsonValue r) => { this.TakeTitleReply(r); });
    }

    /* 称谓数据入缓存：行 + 服务端页数（251 行 / 21 页，pager 按它渲染）。 */
    void TakeTitleReply(JsonValue r) {
        if (!this.TakeSelf(r)) { return; }
        JsonValue rows = r.Get("rows");
        if (rows != null && rows.IsArray()) {
            this.playTitle = rows;
            this.playTitlePages = r.Int("pages", 1);
            if (this.playTitlePages < 1) { this.playTitlePages = 1; }
            if (this.typedTitle == null) { this.typedTitle = new TitleState(); }
            this.typedTitle.TotalPages = this.playTitlePages;
            this.typedTitle.Titles.Clear();
            for (int i = 0; i < rows.Count(); i = i + 1) {
                JsonValue x = rows.At(i);
                if (x != null && x.IsObject()) {
                    this.typedTitle.Titles.Add(new TitleItem(
                        x.Int("id", i + 1),
                        x.Str("name", ""),
                        x.Long("fame", 0),
                        x.Long("gold", 0),
                        x.Int("rebirth", 0),
                        x.Int("level", 0),
                        x.Int("atkMin", 0),
                        x.Int("atkMax", 0),
                        x.Int("magMin", 0),
                        x.Int("magMax", 0),
                        x.Int("taoMin", 0),
                        x.Int("taoMax", 0),
                        x.Int("defMin", 0),
                        x.Int("defMax", 0),
                        x.Int("mdefMin", 0),
                        x.Int("mdefMax", 0),
                        x.Int("active", 0) == 1,
                        x.Int("unlocked", 0) == 1
                    ));
                }
            }
            this.Bump();
        }
    }

    /* 页面进页拉取：只在没数据时发一次，防 Bump 重建循环重拉。 */
    void MaybeRefreshTitle() {
        if (this.playTitle != null) { return; }
        this.RefreshTitle();
    }

    /* 翻页：{"op":"title","page":N}。playTitle 保留旧页直到应答整包
       替换（置空会让重建期的 Maybe 守卫再拉一次第 0 页）。 */
    void TitlePage(int n) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "title");
        body.PutInt("page", n);
        this.Op(body.ToJson(), (JsonValue r) => { this.TakeTitleReply(r); });
    }

    void TitleUnlock(string name) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "title");
        body.PutStr("unlock", name);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (this.TakeSelf(r)) { this.AddFeed("称谓「" + name + "」已解锁！"); this.RefreshTitle(); }
        });
    }

    void TitleWear(string name) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "title");
        body.PutStr("wear", name);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (this.TakeSelf(r)) {
                this.AddFeed(name == "无" ? "已摘下称谓。" : "已佩戴称谓「" + name + "」。");
                this.RefreshTitle();
            }
        });
    }

    /* ---- Batch F：成就(ach) / 爵位(lord) / 邮箱(mail) / 至尊殿堂(sup)。---- */

    void RefreshAch() {
        this.Op("{\"op\":\"ach\"}", (JsonValue r) => {
            if (this.TakeSelf(r)) {
                JsonValue rows = r.Get("rows");
                if (rows != null && rows.IsArray()) {
                    this.playAch = rows;
                    this.typedAchs.Clear();
                    for (int i = 0; i < rows.Count(); i = i + 1) {
                        JsonValue m = rows.At(i);
                        if (m != null && m.IsObject()) {
                            AchItem ai = new AchItem(
                                m.Str("name", ""),
                                m.Str("req", ""),
                                m.Int("claimed", 0),
                                m.Int("ok", 0)
                            );
                            JsonValue rws = m.Get("rewards");
                            if (rws != null && rws.IsArray()) {
                                for (int k = 0; k < rws.Count(); k = k + 1) {
                                    JsonValue w = rws.At(k);
                                    if (w != null && w.IsObject()) {
                                        ai.Rewards.Add(new AchRewardItem(w.Int("pic", 0), w.Str("badge", "")));
                                    }
                                }
                            }
                            this.typedAchs.Add(ai);
                        }
                    }
                    this.Bump();
                }
            }
        });
    }

    /* 页面进页拉取的守卫版。 */
    void MaybeRefreshAch() {
        if (this.playAch != null) { return; }
        this.RefreshAch();
    }

    /* take = 服务端成就定义的 1 基行号（客户端第 1 页一行对一行）。 */
    void AchTake(int no) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "ach");
        body.PutInt("take", no);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (this.TakeSelf(r)) {
                this.AddFeed("成就奖励已领取！");
                this.RefreshBag();
                this.RefreshAch();
            }
        });
    }

    void RefreshLord() {
        this.Op("{\"op\":\"lord\"}", (JsonValue r) => {
            if (this.TakeSelf(r)) {
                this.playLord = r;
                if (this.typedLord == null) { this.typedLord = new LordState(); }
                JsonValue me = r.Get("me");
                if (me != null && me.IsObject()) {
                    this.typedLord.MyTier = me.Int("tier", 4);
                    this.typedLord.MyContrib = me.Int("contrib", 0);
                    this.typedLord.MyBonus = me.Int("bonus", 0);
                    this.typedLord.MySpeed = me.Int("speed", 0);
                    this.typedLord.MyExp = me.Int("exp", 0);
                } else {
                    this.typedLord.MyTier = 4;
                    this.typedLord.MyContrib = 0;
                    this.typedLord.MyBonus = 0;
                    this.typedLord.MySpeed = 0;
                    this.typedLord.MyExp = 0;
                }
                this.typedLord.Rows.Clear();
                JsonValue rows = r.Get("rows");
                if (rows != null && rows.IsArray()) {
                    for (int i = 0; i < rows.Count(); i = i + 1) {
                        JsonValue m = rows.At(i);
                        if (m != null && m.IsObject()) {
                            this.typedLord.Rows.Add(new LordRankRow(
                                m.Int("tier", 3),
                                m.Str("name", ""),
                                m.Int("contrib", 0),
                                m.Int("self", 0) == 1
                            ));
                        }
                    }
                }
                this.Bump();
            }
        });
    }

    void MaybeRefreshLord() {
        if (this.playLord != null) { return; }
        this.RefreshLord();
    }

