                    this.playMentor = a;
                    if (this.typedMentor == null) { this.typedMentor = new MentorState(); }
                    this.typedMentor.Master = a.Str("master", "");
                    this.typedMentor.CanTake = a.Int("canTake", 0) == 1;
                    this.typedMentor.Mates.Clear();
                    JsonValue mates = a.Get("mates");
                    if (mates != null && mates.IsArray()) {
