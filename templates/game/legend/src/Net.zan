using System.Net.Http;
using System.Net.External;
using System.Net.Sockets;
using System.Security.Cryptography;
using System.Text;
using System.Threading;
using Gui;
using Legend;

/* 一条 op 回复的回调。*/
delegate void NetReply(JsonValue r);

// 联机会话加密：与 templates/server/server-legend/src/Game/Secure.zan 同一套线格式。
// 握手三行明文（连接通告 → hello → 切密通告，均不含秘密）之后，双向每行一条
// Base64(密文 ‖ 16字节tag) 帧；HKDF 派生双向独立密钥；序号进 IV 与 AAD，
// 接收端按严格相等校验，对不上即重放/注入，立即断开。
// 收发拆成两个实例：ForSend 只碰 txKey/txSeq（网络线程专用），
// ForRecv 只碰 rxKey/rxSeq（UI 线程专用），两边字段互不共享。
class Secure {
    byte[] txKey;
    byte[] rxKey;
    long txSeq;
    long rxSeq;
    string dirTx;
    string dirRx;

    /* 用共享 secret 与双向随机数派生主密钥；参数不足返回 null。*/
    static byte[] MasterOf(string secret, string cnonce, string snonce) {
        if (secret.Length == 0 || snonce.Length < 16 || cnonce.Length < 16) { return null; }
        return Hkdf.Derive(cnonce + snonce, (cnonce + snonce).Length,
            secret, secret.Length, "zan-game-v2", "zan-game-v2".Length, 32);
    }

    /* 发送侧（C2S）：只在网络线程上使用。*/
    static Secure ForSend(byte[] master) {
        if (master == null) { return null; }
        Secure c = new Secure();
        c.txKey = Hkdf.Expand(master, "zan-game-c2s", "zan-game-c2s".Length, 32);
        c.dirTx = "C";
        c.txSeq = 0;
        return c;
    }

    /* 接收侧（S2C）：只在 UI 线程上使用。*/
    static Secure ForRecv(byte[] master) {
        if (master == null) { return null; }
        Secure c = new Secure();
        c.rxKey = Hkdf.Expand(master, "zan-game-s2c", "zan-game-s2c".Length, 32);
        c.dirRx = "S";
        c.rxSeq = 0;
        return c;
    }

    static string Secret = "zan-game-dev-secret";

    /* 加密一条明文（JSON），返回一行 Base64 帧（不含行尾）。*/
    string Seal(string plain) {
        long seq = this.txSeq;
        this.txSeq = seq + 1;
        byte[] iv = Secure.Iv(seq);
        string aad = Secure.Aad(this.dirTx, seq);
        byte[] tag = new byte[16];
        byte[] ct = AesGcm.Encrypt(this.txKey, 32, iv, aad, aad.Length,
            plain, plain.Length, tag);
        if (ct == null) { return ""; }
        byte[] frame = new byte[ct.Length + 16];
        for (int i = 0; i < ct.Length; i = i + 1) { frame[i] = ct[i] & 255; }
        for (int i = 0; i < 16; i = i + 1) { frame[ct.Length + i] = tag[i] & 255; }
        return Base64.Encode(frame, frame.Length);
    }

    /* 解一条帧；序号不连续或认证失败返回 null（调用方必须断开）。*/
    string Open(string frame) {
        List<int> n = new List<int>();
        n.Add(0);
        byte[] buf = Base64.Decode(frame, n);
        if (buf == null || n[0] < 16) { return null; }
        int ctLen = n[0] - 16;
        byte[] tag = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { tag[i] = buf[ctLen + i] & 255; }
        long seq = this.rxSeq;
        byte[] iv = Secure.Iv(seq);
        string aad = Secure.Aad(this.dirRx, seq);
        List<int> ok = new List<int>();
        ok.Add(0);
        byte[] pt = AesGcm.Decrypt(this.rxKey, 32, iv, aad, aad.Length,
            buf, ctLen, tag, ok);
        if (pt == null || ok[0] != -1) { return null; }
        this.rxSeq = seq + 1;
        return pt.ToStr(0, ctLen);
    }

    static byte[] Iv(long seq) {
        byte[] iv = new byte[12];
        for (int i = 0; i < 8; i = i + 1) {
            iv[i] = Bits.Shr64(seq, 8 * (7 - i)) & 255;
        }
        return iv;
    }

    static string Aad(string dir, long seq) {
        byte[] a = new byte[9];
        a[0] = dir[0] & 255;
        for (int i = 0; i < 8; i = i + 1) {
            a[1 + i] = Bits.Shr64(seq, 8 * (7 - i)) & 255;
        }
        return a.ToStr(0, 9);
    }
}

// 联机接入层：HTTP 操作 + TCP 推送通道 → 世界状态缓存。
// 架构照「能 HTTP 的都 HTTP」：一问一答的 op（登录/背包/商店/BOSS 挑战…）
// 全走 POST /api/game/<op>，应答即时配对回调——没有共享回复队列，不存在
// 错位；TCP 长连接只做推送通道（登录拿到 token 后 attach），收聊天、
// 公告、挂机结算这类即时通知。线程模型：Gui 主线程不驱动 IO 反应器，
// 一条专用后台线程全包（同 Gui.ImageHttp 的做法）——HTTP POST 在 await
// 期间让出、按队列串行发送（op 的应答顺序与发出顺序一致），套接字收发
// 同循环轮询；收到的每一行经 App.Post 投回 UI 线程解密、解析、改状态。
// 所有 GameNet 状态字段仅由 UI 线程读写（带 w 前缀/secTx/wrx 的字段除外，
// 各归各线程）。会话保活：服务端按「最后一次 HTTP 操作」计心跳，网络
// 线程每 25 秒补一条 state（顺带刷新 self），推送通道另发 TCP hb。
class GameNet {
    /* 推送通道线程持有（其余字段仅 UI 线程访问）。*/
    nint wsock = -1;
    Secure secTx;
    bool wenc;
    string wrx = "";
    /* 推送通道关闭令牌：Drop 在 UI 线程置 1，网络线程每轮检查后
       摘通道（原子量，替代旧的跨线程 "!close" 队列项）。 */
    AtomicInt pushClose;
    string cHost = "";
    /* HTTP 网关端口（地址栏 host:port 的 port）；推送通道端口由 login
       应答下发（pushPort），与 HTTP 同主机。 */
    int hPort = 48099;
    int pushPort;
    /* 服务器连接密码：推送通道 hello 随 cnonce 一并上送，由服务端校验。*/
    string cPass = "";

    /* ---- HTTP 作业通道（静态；DataTable.HttpSource 定式）----
     * rt_co.c 的协程 ready 队列是 M:1 无锁全局队列，await 只允许活在
     * 一个线程上。早期版本在原生网络线程里 await HttpClient，与 UI 线
     * 的帧循环并发排程，实测会静默丢子任务（characters 的 DoPost 帧
     * 连续丢失，探针见 _scratch/uidrv2/ph45*~47c）。现在 HTTP 全部走
     * 这条静态通道：UI 线程 Op() 入队，空闲即退的静态 worker 逐条
     * await 取回（唯一 await 位），完成项回静态完成队列，UI 线程每帧
     * PollHttp() 并入。推送通道线程因此不含任何 await。 */
    static List<HttpReq> httpQ;
    static List<HttpReq> httpDone;
    static nint httpLock;
    static bool httpUp;
    /* worker 的目标地址（Connect 写、HttpFetchOne 读）。*/
    static string wantHost = "";
    static int wantPort;

    /* UI 侧状态。sec 只在 UI 线程使用（S2C 方向）。*/
    App app;
    bool connected;
    bool connecting;
    bool ready;
    int gen;
    Secure sec;
    /* 登录令牌：HTTP op 全凭它；推送通道断线由网络线程每 10 秒重拨
       （token 在就拨），Drop 清 token 即停。 */
    string token = "";
    bool pushUp;
    bool threadUp;

    /* 连接阶段：0 未连接，1 服务器可达（探活 realms 成功），2 推送
       通道已建立，3 已登录（HTTP），4 已进区。 */
    int stage;
    string error = "";
    /* 调试：最近一条 HTTP 应答（UI 线程 Poll 时写），经探针 net-http
       外显，远程定位传输层问题用。 */
    string httpLog = "";
    long lastPollAt;
    int uid;
    string user = "";
    int realmId = 1;
    string realmName = "";
    /* 分区窗选中的区没有角色（enter 被拒）：登录窗据此切到建角页。 */
    bool needCreate;
    bool NeedCreate() { return this.needCreate; }
    JsonValue self;
    JsonValue realms;
    JsonValue mobs;
    JsonValue maps;
    JsonValue bag;
    /* 玩法页数据缓存：BOSS 之家 / 商店 / 排行 / 图鉴 / 世界 BOSS / 公告。 */
    JsonValue bosses;
    JsonValue shop;
    JsonValue rank;
    JsonValue codex;
    JsonValue wboss;
    JsonValue announces;
    JsonValue lastFight;
    List<string> chat = new List<string>();
    List<string> feed = new List<string>();
    /* 本地演示动画状态：挂机战况不再逐秒来自服务器（批量结算），
       这条时间线由客户端按怪物图鉴和自身攻防自演，仅供观看；收益
       以服务端 ev idlesum 结算为权威。autoMob 是当前挂机怪物 id。 */
    int autoMob;
    int demoHp;
    int demoWait;
    int demoTick;
    /* 地图内页：当前打开的图 id、BOSS 面板（bossinfo 回复）、战报行
       （bossfight 整场回合的 log 原样上屏）；bossAuto=「结束后自动
       挑战BOSS」勾选态，回复回调里读它决定要不要接着磨。 */
    JsonValue bossPage;
    List<string> bossLog = new List<string>();
    int bossMap;
    bool bossAuto;

    /* 玩法页数据缓存（Play 模块的 op）：arena/escort/guild/siege/tower/
       wuxing/mentor/altar/stars/redpack/market/title + codex 明细分页。 */
    JsonValue playArena;
    JsonValue playEscort;
    JsonValue playGuild;
    JsonValue playSiege;
    JsonValue playTower;
    JsonValue playWuxing;
    JsonValue playMentor;
    JsonValue playAltar;
    JsonValue playStars;
    JsonValue playRedpack;
    JsonValue playMarket;
    JsonValue playTitle;
    /* Batch F：成就/爵位/邮箱/至尊殿堂（ach/lord/mail/sup）。 */
    JsonValue playAch;
    JsonValue playLord;
    JsonValue playMail;
    JsonValue playSup;
    /* Batch G：图鉴套装收集（tj）。 */
    JsonValue playTj;
    /* 场景页家族进度榜（scenerank）：按维度各缓存一份，
       1=幻境（地图解锁层）2=秘境（五行总层数）3=世界BOSS（伤害）。 */
    JsonValue playScene1;
    JsonValue playScene2;
    JsonValue playScene3;
    /* 仓库（wh）：列表缓存，行 {id,name,kind,slot,count}，服务端内联
       模板信息，客户端直接出格子。 */
    JsonValue playWh;
    int playTitlePages;
    JsonValue codexPage;
    int codexPageNo;
    string codexKind = "items";
    int codexTotal;
    /* 寻宝记录格：最近抽得的道具号（新在前，最多 36 格）。draw 回复带
       itemId，记录格按它取图标——只回名字对不上素材。 */
    List<int> drawItemIds = new List<int>();

    static string[] JobNames = new string[] { "战士", "法师", "道士" };

    bool Connected() { return this.connected; }
    bool Ready() { return this.ready; }
    int Stage() { return this.stage; }
    string Error() { return this.error; }
    bool InWorld() { return this.stage >= 4 && this.self != null; }
    PlayerState typedSelf = new PlayerState();
    PlayerState SelfState() { return this.typedSelf; }
    List<RealmInfo> typedRealms = new List<RealmInfo>();
    List<MobInfo> typedMobs = new List<MobInfo>();
    List<MapInfo> typedMaps = new List<MapInfo>();
    List<BagItem> typedBag = new List<BagItem>();
    List<BagItem> typedWh = new List<BagItem>();
    List<BossInfo> typedBosses = new List<BossInfo>();
    List<ShopItem> typedShop = new List<ShopItem>();
    List<RankItem> typedRank = new List<RankItem>();
    WorldBossState typedWBoss = new WorldBossState();
    MapBossPage typedBossPage = new MapBossPage();
    ArenaState typedArena = new ArenaState();
    EscortState typedEscort = new EscortState();
    GuildState typedGuild = new GuildState();
    SiegeState typedSiege = new SiegeState();
    TowerState typedTower = new TowerState();
    LordState typedLord = new LordState();
    SupState typedSup = new SupState();
    TjState typedTj = new TjState();
    MentorState typedMentor = new MentorState();
    RedpackState typedRedpack = new RedpackState();
    TitleState typedTitle = new TitleState();
    WuxingState typedWuxing = new WuxingState();
    AltarState typedAltar = new AltarState();
    StarState typedStars = new StarState();
    List<SceneRankRow> typedScene1 = new List<SceneRankRow>();
    List<SceneRankRow> typedScene2 = new List<SceneRankRow>();
    List<SceneRankRow> typedScene3 = new List<SceneRankRow>();
    List<MailItem> typedMails = new List<MailItem>();
    List<MarketItem> typedMarkets = new List<MarketItem>();
    List<AchItem> typedAchs = new List<AchItem>();

    ArenaState TypedArena() { return this.typedArena; }
    EscortState TypedEscort() { return this.typedEscort; }
    GuildState TypedGuild() { return this.typedGuild; }
    SiegeState TypedSiege() { return this.typedSiege; }
    TowerState TypedTower() { return this.typedTower; }
    LordState TypedLord() { return this.typedLord; }
    SupState TypedSup() { return this.typedSup; }
    TjState TypedTj() { return this.typedTj; }
    MentorState TypedMentor() { return this.typedMentor; }
    RedpackState TypedRedpack() { return this.typedRedpack; }
    TitleState TypedTitle() { return this.typedTitle; }
    WuxingState TypedWuxing() { return this.typedWuxing; }
    AltarState TypedAltar() { return this.typedAltar; }
    StarState TypedStars() { return this.typedStars; }
    List<SceneRankRow> TypedSceneRank(int dim) {
        if (dim == 2) { return this.typedScene2; }
        if (dim == 3) { return this.typedScene3; }
        return this.typedScene1;
    }
    List<MailItem> MailsList() { return this.typedMails; }
    List<MarketItem> MarketsList() { return this.typedMarkets; }
    List<AchItem> AchsList() { return this.typedAchs; }

    List<RealmInfo> RealmsList() { return this.typedRealms; }
    List<MobInfo> MobsList() { return this.typedMobs; }
    List<MapInfo> MapsList() { return this.typedMaps; }
    List<BagItem> BagList() { return this.typedBag; }
    List<BagItem> WhList() { return this.typedWh; }
    List<BossInfo> BossesList() { return this.typedBosses; }
    List<ShopItem> ShopList() { return this.typedShop; }
    List<RankItem> RankList() { return this.typedRank; }
    WorldBossState TypedWBoss() { return this.typedWBoss; }
    MapBossPage TypedBossPage() { return this.typedBossPage; }

    RealmInfo TypedRealmAt(int i) {
        if (i >= 0 && i < this.typedRealms.Count) { return this.typedRealms[i]; }
        return null;
    }
    MobInfo TypedMobAt(int i) {
        if (i >= 0 && i < this.typedMobs.Count) { return this.typedMobs[i]; }
        return null;
    }
    MapInfo TypedMapAt(int i) {
        if (i >= 0 && i < this.typedMaps.Count) { return this.typedMaps[i]; }
        return null;
    }
    BagItem TypedBagAt(int i) {
        if (i >= 0 && i < this.typedBag.Count) { return this.typedBag[i]; }
        return null;
    }
    BagItem TypedWhAt(int i) {
        if (i >= 0 && i < this.typedWh.Count) { return this.typedWh[i]; }
        return null;
    }
    BossInfo TypedBossAt(int i) {
        if (i >= 0 && i < this.typedBosses.Count) { return this.typedBosses[i]; }
        return null;
    }
    ShopItem TypedShopAt(int i) {
        if (i >= 0 && i < this.typedShop.Count) { return this.typedShop[i]; }
        return null;
    }
    RankItem TypedRankAt(int i) {
        if (i >= 0 && i < this.typedRank.Count) { return this.typedRank[i]; }
        return null;
    }

    JsonValue Self() { return this.self; }
    JsonValue LastFight() { return this.lastFight; }
    int AutoMobId() { return this.autoMob; }
    int RealmCount() {
        if (this.typedRealms.Count > 0) { return this.typedRealms.Count; }
        return this.realms != null && this.realms.IsArray() ? this.realms.Count() : 0;
    }
    int MobCount() {
        if (this.typedMobs.Count > 0) { return this.typedMobs.Count; }
        return this.mobs != null && this.mobs.IsArray() ? this.mobs.Count() : 0;
    }
    int MapCount() {
        if (this.typedMaps.Count > 0) { return this.typedMaps.Count; }
        return this.maps != null && this.maps.IsArray() ? this.maps.Count() : 0;
    }
    int BagCount() {
        if (this.typedBag.Count > 0) { return this.typedBag.Count; }
        return this.bag != null && this.bag.IsArray() ? this.bag.Count() : 0;
    }
    int BossCount() {
        if (this.typedBosses.Count > 0) { return this.typedBosses.Count; }
        return this.bosses != null && this.bosses.IsArray() ? this.bosses.Count() : 0;
    }
    JsonValue RealmAt(int i) { return this.realms != null ? this.realms.At(i) : null; }
    JsonValue MobAt(int i) { return this.mobs != null ? this.mobs.At(i) : null; }
    JsonValue MapAt(int i) { return this.maps != null ? this.maps.At(i) : null; }
    JsonValue BossAt(int i) { return this.bosses != null ? this.bosses.At(i) : null; }
    int ShopCount() {
        if (this.typedShop.Count > 0) { return this.typedShop.Count; }
        return this.shop != null && this.shop.IsArray() ? this.shop.Count() : 0;
    }
    JsonValue ShopAt(int i) { return this.shop != null ? this.shop.At(i) : null; }
    int RankCount() {
        if (this.typedRank.Count > 0) { return this.typedRank.Count; }
        return this.rank != null && this.rank.IsArray() ? this.rank.Count() : 0;
    }
    JsonValue RankAt(int i) { return this.rank != null ? this.rank.At(i) : null; }
    JsonValue Codex() { return this.codex; }
    JsonValue WBoss() { return this.wboss; }
    int AnnounceCount() { return this.announces != null && this.announces.IsArray() ? this.announces.Count() : 0; }
    JsonValue AnnounceAt(int i) { return this.announces != null ? this.announces.At(i) : null; }
    JsonValue BagAt(int i) { return this.bag != null ? this.bag.At(i) : null; }
    string RealmName() { return this.realmName; }
    /* 当前/想要进入的区服 id（登录窗建角步用它记玩家的选择）。 */
    int RealmId() { return this.realmId; }
    /* 当前区服倍率（万分比，进区后随 self 下发）；未进区回 0。 */
    int ExpRate() { return this.self != null ? this.self.Int("expRate", 0) : 0; }
    int GoldRate() { return this.self != null ? this.self.Int("goldRate", 0) : 0; }
    int DropRate() { return this.self != null ? this.self.Int("dropRate", 0) : 0; }
    /* 阶段或世界数据变化时递增，LegendApp 借此重建联机页。*/
    int dataVersion;
    int DataVersion() { return this.stage * 1000 + this.dataVersion; }
    void Bump() { this.dataVersion = this.dataVersion + 1; }

    string StatusText() {
        if (this.stage >= 4) {
            return this.realmName + " · " + this.SelfLine();
        }
        if (this.stage >= 3) {
            return "已登录：" + this.user + (this.pushUp ? "，推送已连接。" : "，推送连接中…");
        }
        if (this.stage >= 1) { return "服务器可达，请登录。"; }
        if (this.connecting) { return "正在连接 " + this.cHost + "…"; }
        if (this.error.Length > 0) { return "未连接（" + this.error + "）"; }
        return "未连接。点击服务器直接连接；离线玩法不受影响。";
    }

    /* 弹窗里显示的一行提示：最近的服务器消息/错误。*/
    string LastChat() {
        return this.chat.Count > 0 ? this.chat[this.chat.Count - 1] : "";
    }

    /// 服务端 job 0/1/2 -> 职业名（排行榜等页共用）。
    public string JobNameOf(int job) {
        return job >= 0 && job < 3 ? JobNames[job] : "旅人";
    }

    string SelfLine() {
        if (this.self == null && this.typedSelf.Id <= 0) { return ""; }
        int job = this.typedSelf.Job;
        string jobName = this.JobNameOf(job);
        string name = this.typedSelf.Name != "" ? this.typedSelf.Name : "旅人";
        return name + " · " + jobName + " · "
            + Convert.ToString(this.typedSelf.Level) + "级 · 血 "
            + Convert.ToString(this.typedSelf.Hp) + "/"
            + Convert.ToString(this.typedSelf.MaxHp) + " · 金 "
            + Convert.ToString(this.typedSelf.Gold) + " · 攻 "
            + Convert.ToString(this.typedSelf.Atk) + " · 防 "
            + Convert.ToString(this.typedSelf.Def) + " · 强化 ★"
            + Convert.ToString(this.typedSelf.WeaponStar) + "/"
            + Convert.ToString(this.typedSelf.ArmorStar);
    }

    string FightLine() {
        if (this.lastFight == null) { return this.InWorld() ? "尚未开战。选一只怪开始挂机。" : ""; }
        JsonValue f = this.lastFight;
        string t = f.Str("mob", "怪物") + "：造成 " + Convert.ToString(f.Int("dmg", 0))
            + " 伤害，怪物余血 " + Convert.ToString(f.Int("mobhp", 0))
            + "；我方受击 " + Convert.ToString(f.Int("mdmg", 0))
            + "，余血 " + Convert.ToString(f.Int("hp", 0));
        if (f.Int("killed", 0) == 1) { t = t + "\n击杀！经验 +" + Convert.ToString(f.Int("exp", 0)) + "，自动刷新下一只。"; }
        if (f.Int("levelup", 0) > 0) { t = t + "\n升级到 " + Convert.ToString(f.Int("levelup", 0)) + " 级！"; }
        if (f.Str("drop", "").Length > 0) { t = t + "\n掉落：" + f.Str("drop", ""); }
        if (f.Int("die", 0) == 1) { t = t + "\n你倒下了，已被送回城休整，挂机停止。"; }
        return t;
    }

    string ChatDump() {
        string t = "";
        for (int i = 0; i < this.chat.Count; i = i + 1) {
            t = t + (i > 0 ? "\n" : "") + this.chat[i];
        }
        return t;
    }

    string FeedDump() {
        string t = "";
        for (int i = this.feed.Count - 1; i >= 0; i = i - 1) {
            t = t + (t.Length > 0 ? "\n" : "") + this.feed[i];
        }
        return t.Length > 0 ? t : "暂无战况，去沙巴克开挂机吧。";
    }

    void AddChat(string who, string text) {
        string line;
        if (who == "[系统]" || who == "[公告]") {
            line = "#H" + who + "#W " + EscRich(text);
        } else {
            line = "#H[聊天] " + NameColor(who) + who + "#W " + EscRich(text);
        }
        this.chat.Add(line);
        if (this.chat.Count > 40) { this.chat.RemoveAt(0); }
    }

    /* 玩家名颜色：按名字散列从固定色板挑一个（色板取自原版聊天截图
       的玩家名配色）。 */
    static string[] ChatColors = new string[] {
        "#L", "#G", "#Y", "#c(0xFFB070FF)", "#R", "#c(0xFF60C8FF)",
        "#c(0xFFFF80DF)"
    };

    static string NameColor(string who) {
        int h = 0;
        for (int i = 0; i < who.Length; i = i + 1) {
            h = h + who[i];
        }
        return ChatColors[h % ChatColors.Length];
    }

    /* 正文里的 '#' 转义成 '##'，避免被富文本当标签吃掉。 */
    static string EscRich(string text) {
        string t = "";
        for (int i = 0; i < text.Length; i = i + 1) {
            if (text.Substring(i, 1) == "#") { t = t + "##"; }
            else { t = t + text.Substring(i, 1); }
        }
        return t;
    }

    /* 离线壳的演示聊天：不拨号也能验证聊天区配色与折行
       （LEGEND_OFFLINE=1 时在启动后播一次）。 */
    void SeedDemoChat() {
        this.AddChat("[s31.海草你嘻嘻嘻]", "我记得之前的新区，貌似是去年国庆开的？");
        this.AddChat("[s21.梦幻进行曲]", "一年也就2个区，今年是没开新区的吗");
        this.AddChat("[s11.静怀不归路]", "各位大佬们 晚上好啊，一天没上了，刷刷副本先");
        this.AddChat("[s21.名枝——影月]", "疯狂星期四 冲冲冲！");
        this.AddChat("[系统]", "欢迎来到迷你传奇，祝大家游戏愉快。");
    }

    void AddFeed(string text) {
        this.feed.Add(text);
        if (this.feed.Count > 16) { this.feed.RemoveAt(0); }
    }

    /* 本地演示动画（每秒由主循环驱动）：照原版，挂机的逐秒战况是
       客户端自演的——按图鉴血量和自身攻防演一场，不产生任何收益、
       不发任何网络包；真收益由服务端每 60 秒 ev idlesum 批量下发。
       攻击行每 3 拍记一条，击杀/重生即时记，避免刷屏。 */
    void DemoRound() {
        if (!this.InWorld() || this.autoMob <= 0 || this.typedSelf == null) { return; }
        MobInfo mob = null;
        for (int i = 0; i < this.MobCount(); i = i + 1) {
            MobInfo mo = this.TypedMobAt(i);
            if (mo == null) { continue; }
            if (mo.Tpl != this.autoMob) { continue; }
            if (mob == null || mo.Alive) {
                mob = mo;
                if (mo.Alive) { break; }
            }
        }
        if (mob == null) { return; }
        if (this.demoWait > 0) { this.demoWait = this.demoWait - 1; return; }
        if (!mob.Alive) {
            this.AddFeed("[演示] " + (mob.Name.Length > 0 ? mob.Name : "怪物") + " 还在重生（"
                + Convert.ToString(mob.RespawnIn) + " 秒后）");
            this.demoWait = 2;
            return;
        }
        if (this.demoHp <= 0 || this.demoHp > mob.MaxHp) {
            this.demoHp = mob.MaxHp > 0 ? mob.MaxHp : 100;
        }
        int dmg = this.typedSelf.Atk - mob.Level;
        if (dmg < 1) { dmg = 1; }
        this.demoHp = this.demoHp - dmg;
        this.demoTick = this.demoTick + 1;
        string name = mob.Name.Length > 0 ? mob.Name : "怪物";
        if (this.demoHp <= 0) {
            this.AddFeed("[演示] 击杀 " + name + "（收益以服务端结算为准）");
            this.demoHp = 0;
            this.demoWait = 2;
        } else if (this.demoTick % 3 == 1) {
            this.AddFeed("[演示] 交战 " + name + "：你的伤害 " + Convert.ToString(dmg)
                + "，余血 " + Convert.ToString(this.demoHp));
        }
    }

    /* ---- 连接生命周期 ---- */

    /* UI 线程启动时注入 App：网络线程靠它把行投回 UI。*/
    void Attach(App a) { this.app = a; }

    /* UI 线程：发起连接。真正的工作（HTTP 探活/操作 + 推送通道）都在
       后台线程做，主线程绝不阻塞。gatePass 是推送通道的服务器连接
       密码（门禁），不是账号密码。*/
    void Connect(string host, int port, string gatePass) {
        this.cHost = host;
        this.hPort = port;
        this.cPass = gatePass;
        this.error = "";
        this.connecting = true;
        this.gen = this.gen + 1;
        /* HTTP worker 的目标地址（静态槽位，worker 启动前写好）。*/
        GameNet.wantHost = host;
        GameNet.wantPort = port;
        if (this.pushClose == null) { this.pushClose = new AtomicInt(0); }
        this.pushClose.Store(0);
        if (!this.threadUp) {
            this.threadUp = true;
            GameNet.worker = this;
            Thread.Start(GameNet.ThreadEntry);
        }
        this.AddChat("[系统]", "正在连接 " + host + ":" + Convert.ToString(port) + "…");
    }

    /* 登录窗第一步的“连接服务器”：host:port 串（缺省端口 48099，HTTP
       网关；推送通道端口随登录应答下发）+ 连接密码。解析后立刻 POST
       realms 探活：可达即进入登录表单，顺带把区服列表备好。*/
    bool ConnectAddr(string addr, string gatePass) {
        string a = addr.Trim();
        int colon = a.IndexOf(":");
        string host = a;
        int port = 48099;
        if (colon >= 0) {
            host = a.Substring(0, colon);
            port = Convert.ToInt32(a.Substring(colon + 1));
        }
        if (host.Length < 1 || port <= 0 || port > 65535) {
            this.AddChat("[系统]", "服务器地址应为 host:端口，如 127.0.0.1:48099。");
            return false;
        }
        this.Connect(host, port, gatePass);
        this.Op("{\"op\":\"realms\"}", (JsonValue r) => {
            this.connecting = false;
            if (r.Int("ok", 0) == 1) {
                this.connected = true;
                if (this.stage < 1) { this.stage = 1; }
                JsonValue rows = r.Get("realms");
                if (rows != null && rows.IsArray() && rows.Count() > 0) {
                    this.realms = rows;
                    this.typedRealms.Clear();
                    for (int ri = 0; ri < rows.Count(); ri = ri + 1) {
                        JsonValue item = rows.At(ri);
                        if (item != null) {
                            RealmInfo rf = new RealmInfo(
                                item.Int("id", 0),
                                item.Str("name", ""),
                                item.Str("grp", "永久区"),
                                item.Int("state", 0),
                                item.Int("online", 0),
                                item.Int("expRate", 100),
                                item.Int("goldRate", 100),
                                item.Int("dropRate", 100)
                            );
                            this.typedRealms.Add(rf);
                        }
                    }
                }
                this.AddChat("[系统]", "服务器可达，请登录。");
            } else {
                this.error = r.Str("err", "服务器不可达");
                this.AddChat("[系统]", "连接失败：" + this.error);
            }
            this.Bump();
        });
        return true;
    }

    /* 经静态中转拿到当前会话实例（线程入口是静态方法组）。*/
    static GameNet worker;
    static void ThreadEntry() { GameNet.worker.NetMain(); }

    /* 推送通道线程主体：纯阻塞套接字，不含任何 await（协程只活在
     * UI 线程——见 HTTP 作业通道注释）。拨号、握手、心跳、收包、
     * 看门狗；HTTP 操作由静态 HttpWorkerEntry 承担。只搬字节，
     * 解密、解析、改状态都经 App.Post 投回 UI 线程。*/
    void NetMain() {
        Socket.Initialize();
        byte[] buf = new byte[16385];
        this.wenc = false;
        long lastRecv = DateTime.UtcNow().epoch;
        long lastHb = lastRecv;
        long lastPushTry = 0;
        bool run = true;
        while (run) {
            long now = DateTime.UtcNow().epoch;
            /* 关闭令牌：Drop（登出/401）要求摘掉推送通道。 */
            if (this.pushClose != null && this.pushClose.Load() == 1) {
                if (this.wsock >= 0) { Socket.Close(this.wsock); this.wsock = -1; }
                this.wenc = false;
                this.wrx = "";
                this.pushClose.Store(0);
            }
            /* 推送通道：登录令牌在手、通道没连上，每 10 秒重拨一次。 */
            if (this.token.Length > 0 && this.pushPort > 0 && this.wsock < 0
                    && now - lastPushTry >= 10) {
                lastPushTry = now;
                this.PushDial();
            }
            /* 推送通道心跳：服务端按连接清僵尸（Gateway.SweepIdle）。 */
            if (this.wsock >= 0 && this.wenc && now - lastHb >= 30) {
                JsonValue hb = JsonValue.NewObject();
                hb.PutStr("op", "hb");
                if (!this.WSendText(this.secTx.Seal(hb.ToJson()) + "\n")) {
                    this.PostLinkDown("推送通道发送失败");
                } else {
                    lastHb = now;
                }
            }
            /* 接收：把就绪数据全部读走，按行处理。*/
            if (this.wsock >= 0) {
                while (Socket.IsReadable(this.wsock)) {
                    int n = Socket.Recv(this.wsock, buf, 16384);
                    if (n <= 0) { this.PostLinkDown("与服务器的推送通道已断开"); break; }
                    lastRecv = DateTime.UtcNow().epoch;
                    this.wrx = this.wrx + buf.ToStr(0, n);
                    while (true) {
                        int nl = this.wrx.IndexOf("\n");
                        if (nl < 0) { break; }
                        string line = this.wrx.Substring(0, nl);
                        this.wrx = this.wrx.Substring(nl + 1);
                        if (line.Length == 0) { continue; }
                        if (!this.wenc) {
                            string kind = this.OnWorkerLine(line);
                            if (kind == "stop") { break; }
                            if (kind == "swallow") { continue; }
                        }
                        string lineF = line;
                        this.app.Post(() => { this.OnLine(lineF); });
                    }
                    if (this.wsock < 0) { break; }
                }
            } else {
                lastRecv = now;
            }
            if (this.wsock >= 0 && now - lastRecv >= 150) {
                this.PostLinkDown("150 秒没有收到服务器数据");
            }
            Thread.Sleep(20);
        }
        if (this.wsock >= 0) { Socket.Close(this.wsock); this.wsock = -1; }
    }

    /* 网络线程：拨推送通道（阻塞式一次连接）。握手与 attach 由收发泵
     * 按行推进：服务器通告（snonce）→ OnWorkerLine 发 hello → enc 通告
     * → attach。失败静默：外层每 10 秒重试。 */
    void PushDial() {
        if (this.wsock >= 0) { return; }
        nint sock = Socket.CreateTcp();
        if (sock < 0) { return; }
        int rc = Socket.Connect(sock, this.cHost, this.pushPort);
        if (rc != 0) { Socket.Close(sock); return; }
        Socket.SetNonBlocking(sock);
        this.wsock = sock;
        this.wrx = "";
        this.wenc = false;
    }

    /* 网络线程：握手期的一行。返回 "swallow"（本行不投 UI）、
     * "stop"（断开退出）或 "post"（继续投 UI）。服务端通告在此
     * 消化：生成 cnonce、派生双向密钥、发出 hello；enc 通告一到
     * 就把本连接认领为推送通道（attach）。S2C 半边经 Post 交给
     * UI，收发两半自此各归一个线程。*/
    string OnWorkerLine(string line) {
        if (line.IndexOf("\"snonce\"") >= 0) {
            JsonValue m = null;
            try { m = JsonValue.ParseLenient(line); } catch (Exception) { m = null; }
            string snonce = m != null ? m.Str("snonce", "") : "";
            string cnonce = Hex.Encode(RandomNumberGenerator.GetBytes(16), 16);
            byte[] master = Secure.MasterOf(Secure.Secret, cnonce, snonce);
            this.secTx = Secure.ForSend(master);
            Secure rx = Secure.ForRecv(master);
            if (this.secTx == null || rx == null) {
                this.PostLinkDown("握手派生失败");
                return "stop";
            }
            JsonValue hello = JsonValue.NewObject();
            hello.PutStr("op", "hello");
            hello.PutStr("enc", "aes-gcm");
            hello.PutStr("cnonce", cnonce);
            hello.PutStr("pass", this.cPass);
            if (!this.WSendText(hello.ToJson() + "\n")) {
                this.PostLinkDown("发送失败");
                return "stop";
            }
            this.app.Post(() => { this.OnHandshake(rx); });
            return "swallow";
        }
        if (line.IndexOf("\"enc\"") >= 0) {
            /* 加密通告：切换发送加密，随即认领推送通道（应答带
               push:1，走解密路径回 UI）。 */
            this.wenc = true;
            JsonValue attach = JsonValue.NewObject();
            attach.PutStr("op", "attach");
            attach.PutStr("token", this.token);
            if (this.WSendText(this.secTx.Seal(attach.ToJson()) + "\n")) {
                return "swallow";
            }
            this.PostLinkDown("推送通道发送失败");
            return "stop";
        }
        return "post";
    }

    /* 网络线程：同步发送一小段文本；套接字为非阻塞，小帧一次
     * 系统调用即可完成，偶发 would-block 重试几次。*/
    bool WSendText(string data) {
        if (this.wsock < 0) { return false; }
        for (int attempt = 0; attempt < 50; attempt = attempt + 1) {
            int n = Socket.Send(this.wsock, data, data.Length);
            if (n == data.Length) { return true; }
            if (attempt < 49) { Thread.Sleep(10); }
        }
        return false;
    }

    /* UI 线程：提交一条 HTTP op（入静态队列，必要时拉起 worker）。*/
    void Op(string json, NetReply onReply) {
        if (this.cHost.Length == 0) { this.AddChat("[系统]", "请先连接服务器。"); return; }
        HttpReq req = new HttpReq();
        req.json = this.Seal(json);
        req.cb = onReply;
        GameNet.HttpSubmit(req);
    }

    static void HttpSubmit(HttpReq req) {
        if (GameNet.httpLock == 0) {
            GameNet.httpLock = Mutex.Create();
            GameNet.httpQ = new List<HttpReq>();
            GameNet.httpDone = new List<HttpReq>();
        }
        bool need = false;
        Mutex.Lock(GameNet.httpLock);
        GameNet.httpQ.Add(req);
        need = !GameNet.httpUp;
        GameNet.httpUp = true;
        Mutex.Unlock(GameNet.httpLock);
        GameNet.Trace("S:" + GameNet.OpName(req.json));
        if (need && !Thread.Start(GameNet.HttpWorkerEntry)) {
            Mutex.Lock(GameNet.httpLock);
            GameNet.httpUp = false;
            Mutex.Unlock(GameNet.httpLock);
            req.err = "网络线程启动失败";
            Mutex.Lock(GameNet.httpLock);
            GameNet.httpDone.Add(req);
            Mutex.Unlock(GameNet.httpLock);
        }
    }

    /* HTTP worker 入口：静态方法组（实例方法组/闭包喂 Thread.Start 会
       编译通过、调用即崩）。队列空即退出，下一次提交重新拉起——与
       DataTable.HttpSource/ImageHttp 同款；循环体里只有一处 await。 */
    static void HttpWorkerEntry() {
        Socket.Initialize();
        while (true) {
            HttpReq req = null;
            Mutex.Lock(GameNet.httpLock);
            if (GameNet.httpQ.Count > 0) {
                req = GameNet.httpQ[0];
                GameNet.httpQ.RemoveAt(0);
            } else {
                GameNet.httpUp = false;
                Mutex.Unlock(GameNet.httpLock);
                return;
            }
            Mutex.Unlock(GameNet.httpLock);
            GameNet.Trace("K:" + GameNet.OpName(req.json));
            await GameNet.HttpFetchOne(req);
        }
    }

    /* 取回一条 op：传输层任何失败都变成应答里的 err——绝不静默吞掉
       （回调不回来，UI 停在旧状态）。结果进完成队列，由 UI 线程的
       PollHttp 并入；协程帧只经静态方法往返，不触碰实例状态。 */
    static async int HttpFetchOne(HttpReq req) {
        GameNet.Trace("F:" + GameNet.OpName(req.json));
        string err = "";
        string body = null;
        int status = 0;
        try {
            /* 每请求新建连接：stdlib HttpSource/ImageHttp 同款。复用
               keep-alive 在大应答（state）之后会串帧，实测 characters
               应答体被污染。loopback 建连成本可忽略。 */
            HttpClient nh = new HttpClient(GameNet.wantHost, GameNet.wantPort);
            nh.SetHeader("Content-Type", "application/json");
            /* 游戏服务器是自托管明文 HTTP：放行 loopback + 明文（远程
               目标仍走 HTTPS 语义，不受影响）。 */
            nh.SetCallPolicy(ExternalCallPolicy.Default()
                .AllowLocalHttp()
                .TotalTimeout(6000).ResponseLimit(1024 * 1024));
            HttpResponse resp = await nh.SendBytesAsync("POST",
                "/api/game/" + GameNet.OpName(req.json), req.json);
            status = resp.statusCode;
            body = resp.body;
        } catch (Exception ex) {
            err = ex.Message;
        }
        req.status = status;
        req.respBody = body;
        req.err = err;
        Mutex.Lock(GameNet.httpLock);
        GameNet.httpDone.Add(req);
        Mutex.Unlock(GameNet.httpLock);
        GameNet.Trace("D:" + GameNet.OpName(req.json));
        return 0;
    }

    /* 调试探针：HTTP 通道各站日志（S 入队/K 取走/F 取数/D 完成/R 并入）。*/
    static void Trace(string tag) {
        Mutex.Lock(GameNet.httpLock);
        GameNet.traceBuf = (tag + " | " + GameNet.traceBuf);
        if (GameNet.traceBuf.Length > 260) { GameNet.traceBuf = GameNet.traceBuf.Substring(0, 260); }
        Mutex.Unlock(GameNet.httpLock);
    }
    static string traceBuf = "";

    /* UI 线程每帧：并入完成的 HTTP 应答（401/429/解析都在
       OnHttpReply），并发起 25 秒会话保活轮询——服务端按「最后一次
       HTTP 操作」计心跳，光挂着推送通道不算；顺带把 self 刷成服务端
       权威值，金币/血量不因漏收推送停在旧值。 */
    void PollHttp() {
        try {
            if (UiDriver.Active()) { UiDriver.SetProbe("net-http2", GameNet.traceBuf); }
        } catch (Exception) { }
        long now = DateTime.UtcNow().epoch;
        if (this.token.Length > 0 && now - this.lastPollAt >= 25) {
            this.lastPollAt = now;
            GameNet.HttpSubmit(GameNet.StateReq(this));
        }
        if (GameNet.httpLock == 0 || GameNet.httpDone.Count == 0) { return; }
        List<HttpReq> batch = null;
        Mutex.Lock(GameNet.httpLock);
        if (GameNet.httpDone.Count > 0) {
            batch = GameNet.httpDone;
            GameNet.httpDone = new List<HttpReq>();
        }
        Mutex.Unlock(GameNet.httpLock);
        if (batch == null) { return; }
        for (int i = 0; i < batch.Count; i = i + 1) {
            HttpReq req = batch[i];
            this.httpLog = ("R:" + GameNet.OpName(req.json)) + " | " + this.httpLog;
            if (this.httpLog.Length > 220) { this.httpLog = this.httpLog.Substring(0, 220); }
            this.OnHttpReply(req.cb, req.respBody, req.status, req.err);
        }
    }

    /* 从 op 的 JSON 体里取 op 名（路由即 /api/game/<op>）。请求体
       全部由 JsonValue 树构建产出，这里改走解析取值，不再按引号
       位置做文本外科手术。 */
    static string OpName(string json) {
        JsonValue m = null;
        try { m = JsonValue.ParseLenient(json); } catch (Exception) { m = null; }
        string op = m != null ? m.Str("op", "") : "";
        return op.Length > 0 ? op : "state";
    }

    /* 25 秒保活轮询用的 state 请求：应答与 ev state 同一合入规则。 */
    static HttpReq StateReq(GameNet net) {
        HttpReq poll = new HttpReq();
        poll.json = net.Seal("{\"op\":\"state\"}");
        poll.cb = (JsonValue r) => {
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { net.self = st; net.Bump(); }
        };
        return poll;
    }

    /* UI 线程：把 HTTP 应答交给回调。401=会话失效（整体退回未连接），
       429=限流，其余按 body 交回调；body 解析失败也合成错误。 */
    void OnHttpReply(NetReply cb, string body, int status, string err) {
        if (cb == null) { return; }
        this.httpLog = ("op:" + Convert.ToString(status) + "/"
            + Convert.ToString(body == null ? -1 : body.Length)
            + (err.Length > 0 ? "!" + err : "")) + " | " + this.httpLog;
        if (this.httpLog.Length > 220) { this.httpLog = this.httpLog.Substring(0, 220); }
        try {
            if (UiDriver.Active()) { UiDriver.SetProbe("net-http", this.httpLog); }
        } catch (Exception) { }
        if (err.Length > 0) { cb(GameNet.SyntheticErr("网络错误：" + err)); return; }
        if (status == 401) {
            this.Drop("登录已过期，请重新登录");
            cb(GameNet.SyntheticErr("登录已过期，请重新登录"));
            return;
        }
        if (status == 429) { cb(GameNet.SyntheticErr("操作过于频繁，请稍后再试")); return; }
        if (status != 200) {
            cb(GameNet.SyntheticErr("服务器错误 HTTP " + Convert.ToString(status)));
            return;
        }
        JsonValue m = null;
        try { m = JsonValue.ParseLenient(body); } catch (Exception) { m = null; }
        if (m == null || !m.IsObject()) { cb(GameNet.SyntheticErr("应答不是合法 JSON")); return; }
        cb(m);
    }

    static JsonValue SyntheticErr(string why) {
        JsonValue r = JsonValue.NewObject();
        r.Set("ok", JsonValue.NewNum("0"));
        r.Set("err", JsonValue.NewStr(why));
        return r;
    }

    /* 以下回调都经 App.Post 在 UI 线程执行。gen 保证旧会话的
     * 迟到回调不会污染新一轮连接。*/

    /* 推送通道链路问题（对端断开/看门狗）：只摘通道，会话还在
       （HTTP 操作照常），网络线程稍后自动重拨。 */
    void PostLinkDown(string reason) {
        if (this.wsock >= 0) { Socket.Close(this.wsock); this.wsock = -1; }
        this.wenc = false;
        this.wrx = "";
        string r = reason;
        this.app.Post(() => { this.OnPushDown(r); });
    }

    void OnHandshake(Secure rx) { this.sec = rx; }

    void OnPushDown(string reason) {
        if (!this.pushUp) { return; }
        this.pushUp = false;
        this.ready = false;
        this.sec = null;
        this.AddChat("[系统]", "推送通道断开：" + reason + "。操作不受影响，自动重连中。");
        this.Bump();
    }

    void Drop(string reason) {
        this.connected = false;
        this.connecting = false;
        this.ready = false;
        this.pushUp = false;
        this.stage = 0;
        this.sec = null;
        this.token = "";
        /* 未发出的 HTTP op 直接作废；在途/已完成的让它们自然走完
           （回调只改 UI 状态，token 已清，不会再发起新请求）。 */
        if (GameNet.httpLock != 0) {
            Mutex.Lock(GameNet.httpLock);
            GameNet.httpQ.Clear();
            Mutex.Unlock(GameNet.httpLock);
        }
        /* 摘推送通道：网络线程看到关闭令牌自行收口。 */
        if (this.pushClose != null) { this.pushClose.Store(1); }
        this.self = null;
        this.realms = null;
        this.mobs = null;
        this.maps = null;
        this.bag = null;
        this.bosses = null;
        this.shop = null;
        this.rank = null;
        this.codex = null;
        this.wboss = null;
        this.announces = null;
        this.lastFight = null;
        this.bossPage = null;
        this.bossLog.Clear();
        this.bossLogVer = this.bossLogVer + 1;   /* 断开也要让内页知道战报清空了 */
        this.bossMap = 0;
        this.autoMob = 0;
        this.demoHp = 0; this.demoWait = 0; this.demoTick = 0;
        this.playArena = null; this.playEscort = null; this.playGuild = null;
        this.playSiege = null; this.playTower = null; this.playWuxing = null;
        this.playMentor = null; this.playAltar = null; this.playStars = null;
        this.playRedpack = null; this.playMarket = null; this.playTitle = null;
        this.playAch = null; this.playLord = null; this.playMail = null;
        this.playSup = null; this.playTj = null;
        this.playScene1 = null; this.playScene2 = null; this.playScene3 = null;
        this.playWh = null;
        this.codexPage = null; this.codexPageNo = 0; this.codexTotal = 0;
        this.uid = 0;
        /* realmId 不清零：断线重连分区窗仍默认选中上次玩过的区。 */
        this.realmName = "";
        this.needCreate = false;
        /* 保留本次连接里更早的错误（如服务器密码不正确）：它才是
           用户要看的断开原因；reason 只在没有更早错误时兜底。*/
        if (this.error.Length == 0) { this.error = reason; }
        this.AddChat("[系统]", "连接断开：" + reason + "。离线模式继续可用。");
    }

    /* ---- 行解析与握手 ---- */

    /* UI 线程：网络线程投来的原始行。推送通道建立后先解帧再解析；
     * 解不开 = 被篡改/重放，摘通道重连。*/
    void OnLine(string line) {
        if (this.sec != null) {
            string plain = this.sec.Open(line);
            if (plain == null) {
                this.pushUp = false;
                this.ready = false;
                this.sec = null;
                this.AddChat("[系统]", "加密帧校验失败，重连推送通道。");
                return;
            }
            line = plain;
        }
        this.HandleLine(line);
    }

    void HandleLine(string line) {
        JsonValue m = null;
        try { m = JsonValue.ParseLenient(line); } catch (Exception) { m = null; }
        if (m == null || !m.IsObject()) { return; }
        if (m.Int("push", 0) == 1) {
            /* attach 应答：推送通道就绪（聊天/公告/idlesum 恢复实时）。 */
            this.pushUp = true;
            this.ready = true;
            this.AddChat("[系统]", "推送通道已建立（AES-256-GCM · HKDF-SHA256 · 序号防重放）。");
            this.Bump();
            return;
        }
        if (m.Int("enc", 0) == 1) { return; }
        if (m.Str("ev", "").Length > 0) { this.OnEvent(m); return; }
        if (m.Int("ok", 1) == 0) {
            this.error = m.Str("err", "未知错误");
            this.AddChat("[系统]", "服务器：" + this.error);
        }
    }

    void SyncPlayerState(JsonValue st) {
        if (st == null) { return; }
        if (this.typedSelf == null) { this.typedSelf = new PlayerState(); }
        this.typedSelf.Id = st.Int("id", this.typedSelf.Id);
        this.typedSelf.Name = st.Str("name", this.typedSelf.Name);
        this.typedSelf.Realm = st.Int("realm", this.typedSelf.Realm);
        this.typedSelf.Level = st.Int("level", this.typedSelf.Level);
        this.typedSelf.Exp = (long)st.Int("exp", (int)this.typedSelf.Exp);
        this.typedSelf.ExpNext = (long)st.Int("expnext", (int)this.typedSelf.ExpNext);
        this.typedSelf.Hp = st.Int("hp", this.typedSelf.Hp);
        this.typedSelf.MaxHp = st.Int("maxhp", this.typedSelf.MaxHp);
        this.typedSelf.Mp = st.Int("mp", this.typedSelf.Mp);
        this.typedSelf.MaxMp = st.Int("maxmp", this.typedSelf.MaxMp);
        this.typedSelf.Atk = st.Int("atk", this.typedSelf.Atk);
        this.typedSelf.Def = st.Int("def", this.typedSelf.Def);
        this.typedSelf.Gold = (long)st.Int("gold", (int)this.typedSelf.Gold);
        this.typedSelf.Ingots = (long)st.Int("ingots", (int)this.typedSelf.Ingots);
        this.typedSelf.Kills = st.Int("kills", this.typedSelf.Kills);
        this.typedSelf.MapId = st.Int("map", this.typedSelf.MapId);
        this.typedSelf.MapUnlocked = st.Int("mapUnlocked", this.typedSelf.MapUnlocked);
        this.typedSelf.Fame = (long)st.Int("fame", (int)this.typedSelf.Fame);
        this.typedSelf.Merit = (long)st.Int("merit", (int)this.typedSelf.Merit);
        this.typedSelf.Spirit = (long)st.Int("spirit", (int)this.typedSelf.Spirit);
        this.typedSelf.Job = st.Int("job", this.typedSelf.Job);
        this.typedSelf.Title = st.Str("title", this.typedSelf.Title);
        this.typedSelf.WeaponStar = st.Int("weaponStar", this.typedSelf.WeaponStar);
        this.typedSelf.ArmorStar = st.Int("armorStar", this.typedSelf.ArmorStar);
    }

    /* ---- 事件（服务端驱动的世界推送） ---- */

    void OnEvent(JsonValue m) {
        string ev = m.Str("ev", "");
        if (ev == "state") {
            JsonValue st = m.Get("self");
            if (st != null && st.IsObject()) {
                this.self = st;
                this.SyncPlayerState(st);
                this.Bump();
            }
            return;
        }
        if (ev == "fight") {
            this.lastFight = m;
            if (this.self != null && m.Int("hp", -1) >= 0) {
                this.self.Set("hp", JsonValue.NewNum(Convert.ToString(m.Int("hp", 0))));
                this.typedSelf.Hp = m.Int("hp", 0);
            }
            /* 累计击杀随 fight 推送同步（服务端权威值），任务进度即走吧。 */
            if (this.self != null && m.Int("killed", 0) == 1) {
                this.self.Set("kills", JsonValue.NewNum(Convert.ToString(
                    m.Int("kills", this.self.Int("kills", 0) + 1))));
                this.typedSelf.Kills = this.typedSelf.Kills + 1;
                /* 金币走增量累加（fight 带本次所得，任务奖励已由服务端
                   并进那一击的值），self 的金币显示才不会停在进场旧值。 */
                this.self.Set("gold", JsonValue.NewNum(Convert.ToString(
                    this.self.Int("gold", 0) + m.Int("gold", 0))));
                this.typedSelf.Gold = this.typedSelf.Gold + (long)m.Int("gold", 0);
            }
            /* 等级/经验绝对值随战况下发（服务端进度戳）：经验条逐杀
               增长，不必等升级快照才刷新。 */
            if (this.self != null) {
                if (m.Get("level") != null) {
                    this.self.Set("level", JsonValue.NewNum(
                        Convert.ToString(m.Int("level", 0))));
                    this.typedSelf.Level = m.Int("level", this.typedSelf.Level);
                }
                if (m.Get("expNow") != null) {
                    this.self.Set("exp", JsonValue.NewNum(
                        Convert.ToString(m.Int("expNow", 0))));
                    this.typedSelf.Exp = (long)m.Int("expNow", (int)this.typedSelf.Exp);
                }
                if (m.Get("expNext") != null) {
                    this.self.Set("expnext", JsonValue.NewNum(
                        Convert.ToString(m.Int("expNext", 0))));
                    this.typedSelf.ExpNext = (long)m.Int("expNext", (int)this.typedSelf.ExpNext);
                }
            }
            string t = "交战 " + m.Str("mob", "怪物") + "：伤害 " + Convert.ToString(m.Int("dmg", 0))
                + " · 受击 " + Convert.ToString(m.Int("mdmg", 0))
                + " · 余血 " + Convert.ToString(m.Int("hp", 0));
            if (m.Int("killed", 0) == 1) { t = t + " · 击杀 经验+" + Convert.ToString(m.Int("exp", 0)); }
            this.AddFeed(t);
            return;
        }
        if (ev == "levelup") {
            /* 升级事件带整份 self（等级/血量上限/经验曲线都变了），与
               op 回复同一个替换规则。 */
            JsonValue st = m.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.AddFeed(m.Str("text", "升级！")); return;
        }
        if (ev == "drop") {
            JsonValue bg = m.Get("bag");
            if (bg != null && bg.IsArray()) { this.bag = bg; this.Bump(); }
            this.AddFeed(m.Str("text", "获得掉落")); return;
        }
        if (ev == "die") { this.AddFeed(m.Str("text", "你倒下了，挂机已停止。")); return; }
        if (ev == "idlesum") {
            /* 挂机批量结算（默认 60 秒一条）：整份 self+bag 以服务端
               为准整体替换，逐秒的本地演示只管演出不记账。 */
            JsonValue st = m.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            JsonValue bg = m.Get("bag");
            if (bg != null && bg.IsArray()) { this.bag = bg; }
            this.AddFeed("[结算] " + m.Str("text", ""));
            this.Bump();
            return;
        }
        if (ev == "chat") { this.AddChat("[" + m.Str("from", "玩家") + "]", m.Str("text", "")); return; }
        if (ev == "move" || ev == "walk") { this.AddChat("[系统]", m.Str("text", "")); return; }
        if (ev == "announce") {
            this.AddChat("[公告]", m.Str("title", "") + " " + m.Str("body", ""));
            /* 红包雨公告 → 拉一次红包池（全服可抢的悬浮入口数据源）。 */
            if (this.Self() != null && m.Str("body", "").IndexOf("红包") >= 0) {
                this.RefreshRedpack();
            }
            return;
        }
        if (ev == "kick") { this.Drop(m.Str("reason", "被服务器断开（顶号或封禁）")); }
    }

    /* ---- 发送 ---- */

    string Host() { return this.cHost; }

    /* HTTP 会话没有连接可认：每个 op 体都要带 token。请求体是
       JsonValue 树序列化出的对象文本，token 在这唯一出口统一注入：
       解析回树、Set 后重序列化，不按文本位置做外科手术。token 是
       服务端签发的 32 位十六进制，值本身安全，但注入仍走树以防
       未来 token 形态变化。 */
    string Seal(string json) {
        if (this.token.Length == 0) { return json; }
        JsonValue m = null;
        try { m = JsonValue.ParseLenient(json); } catch (Exception) { m = null; }
        if (m == null || !m.IsObject()) { return json; }
        m.Set("token", JsonValue.NewStr(this.token));
        return m.ToJson();
    }

    /* ---- UI 动作 ---- */

    /* 注册：照原版「创建新账号」只收 账号/密码/邮箱（密保可空，服务端
       两者都空=不设置）。结果存 formMsg 给登录窗建号页提示行（聊天流
       同步留一份）。 */
    string formMsg = "";
    string FormMsg() { return this.formMsg; }
    void SetFormMsg(string s) { this.formMsg = s; }
    void Register(string user, string pass, string email) {
        if (user.Length < 3 || pass.Length < 6) { this.AddChat("[系统]", "账号需 ≥3 字符，密码需 ≥6 位。"); return; }
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "register");
        body.PutStr("user", user);
        body.PutStr("pass", pass);
        body.PutStr("email", email);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) == 1) {
                this.formMsg = "注册成功，请登录。";
                this.AddChat("[系统]", this.formMsg);
            } else {
                this.formMsg = "注册失败：" + r.Str("err", "未知错误");
                this.AddChat("[系统]", this.formMsg);
            }
            this.Bump();
        });
    }

    /* 登录成功：token 入手（此后 HTTP op 全凭它；网络线程发现 token
       就自动拨推送通道），拿区服列表（应答自带）后停在「分区」选择
       页——照原版不自动进区，玩家选分区→区服才进。 */
    void Login(string user, string pass) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "login");
        body.PutStr("user", user);
        body.PutStr("pass", pass);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) {
                /* 失败必须落到 formMsg：登录窗没有聊天区，只 AddChat 等于
                   把失败吞掉（服务端 err 只有这里能到界面）。 */
                this.formMsg = "登录失败：" + r.Str("err", "未知错误");
                this.AddChat("[系统]", this.formMsg);
                this.Bump();
                return;
            }
            this.uid = r.Int("uid", 0);
            this.user = user;
            this.token = r.Str("token", "");
            this.pushPort = r.Int("pushPort", 0);
            this.stage = 3;
            this.needCreate = false;
            JsonValue rows = r.Get("realms");
            if (rows != null && rows.IsArray() && rows.Count() > 0) {
                this.realms = rows;
                this.typedRealms.Clear();
                for (int ri = 0; ri < rows.Count(); ri = ri + 1) {
                    JsonValue item = rows.At(ri);
                    if (item != null) {
                        RealmInfo rf = new RealmInfo(
                            item.Int("id", 0),
                            item.Str("name", ""),
                            item.Str("grp", "永久区"),
                            item.Int("state", 0),
                            item.Int("online", 0),
                            item.Int("expRate", 100),
                            item.Int("goldRate", 100),
                            item.Int("dropRate", 100)
                        );
                        this.typedRealms.Add(rf);
                    }
                }
            }
            this.AddChat("[系统]", "登录成功，请选择分区进入。");
            this.Bump();
        });
    }

    /* 修改密码（密保找回）：forgot 拿问题，reset 校验答案并改密。
       结果存字段，登录窗「修改密码」页直接读。 */
    string forgotQuestion = "";
    string forgotMsg = "";
    bool resetOk; string resetMsg = "";
    string ForgotQuestion() { return this.forgotQuestion; }
    string ForgotMsg() { return this.forgotMsg; }
    bool ResetOk() { return this.resetOk; }
    string ResetMsg() { return this.resetMsg; }
    void Forgot(string user) {
        this.forgotQuestion = ""; this.forgotMsg = "";
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "forgot");
        body.PutStr("user", user);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) == 1) { this.forgotQuestion = r.Str("question", ""); }
            else { this.forgotMsg = r.Str("err", "未知错误"); }
            this.Bump();
        });
    }
    void Reset(string user, string answer, string newpass) {
        this.resetMsg = "";
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "reset");
        body.PutStr("user", user);
        body.PutStr("answer", answer);
        body.PutStr("newpass", newpass);
        this.Op(body.ToJson(), (JsonValue r) => {
            this.resetOk = r.Int("ok", 0) == 1;
            this.resetMsg = this.resetOk ? r.Str("msg", "密码已重置，请用新密码登录")
                : r.Str("err", "未知错误");
            this.Bump();
        });
    }

    /* 修改密码（登录窗「修改密码」页）：账号 + **原密码** + 新密码。
       与 reset 的区别是验原密码而不是密保答案——照原版那页的字段来。
       mail=1 是那颗「发送新密码到注册邮箱」：本服务不带邮件投递，故照实
       回一句没发信，绝不在没发的情况下说已发。 */
    void ChangePass(string user, string oldpass, string newpass, bool mail) {
        this.formMsg = "";
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "changepw");
        body.PutStr("user", user);
        body.PutStr("oldpass", oldpass);
        body.PutStr("newpass", newpass);
        body.PutBool("mail", mail);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) == 1) {
                this.formMsg = r.Str("msg", "密码已修改，请用新密码登录");
                string mm = r.Str("mailmsg", "");
                if (mm.Length > 0) { this.formMsg = this.formMsg + "（" + mm + "）"; }
            } else {
                this.formMsg = "修改密码失败：" + r.Str("err", "未知错误");
            }
            this.AddChat("[系统]", this.formMsg);
            this.Bump();
        });
    }

    /* 选择角色页：characters 列表缓存（进页拉一次，删除后重拉）+
       删除角色。使用 CharacterInfo 实体提升确定性。 */
    JsonValue chars; bool charsReady;
    List<CharacterInfo> typedChars = new List<CharacterInfo>();
    List<CharacterInfo> CharsList() { return this.typedChars; }
    CharacterInfo TypedCharAt(int i) {
        if (i >= 0 && i < this.typedChars.Count) { return this.typedChars[i]; }
        return null;
    }
    int CharCount() {
        if (this.typedChars.Count > 0) { return this.typedChars.Count; }
        return this.chars != null && this.chars.IsArray() ? this.chars.Count() : 0;
    }
    JsonValue CharAt(int i) { return this.chars != null ? this.chars.At(i) : null; }
    bool CharsReady() { return this.charsReady; }
    void RefreshChars(int realmId) {
        this.chars = null;
        this.typedChars.Clear();
        this.charsReady = false;
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "characters");
        body.PutInt("realm", realmId);
        this.Op(body.ToJson(), (JsonValue r) => {
            JsonValue rows = r.Get("rows");
            if (rows != null && rows.IsArray()) {
                this.chars = rows;
                this.typedChars.Clear();
                for (int ci = 0; ci < rows.Count(); ci = ci + 1) {
                    JsonValue item = rows.At(ci);
                    if (item != null) {
                        CharacterInfo chi = new CharacterInfo(
                            item.Int("id", 0),
                            item.Str("name", ""),
                            item.Int("level", 1),
                            item.Int("job", 0)
                        );
                        this.typedChars.Add(chi);
                    }
                }
            }
            this.charsReady = true;
            this.Bump();
        });
    }
    void DelChar(int realmId) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "delchar");
        body.PutInt("realm", realmId);
        this.Op(body.ToJson(), (JsonValue r) => {
            this.AddChat("[系统]", r.Int("ok", 0) == 1 ? "角色已删除。"
                : "删除失败：" + r.Str("err", "未知错误"));
            this.RefreshChars(realmId);
        });
    }

    /* 进区：分区窗点区服调用。有角色直接进世界（self 带回）；没角色
       服务端拒绝，needCreate 置位，登录窗切到建角页。 */
    void EnterRealm(int id, string name) {
        this.realmId = id;
        this.realmName = name;
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "enter");
        body.PutInt("realm", id);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) {
                /* 该区还没有角色：置标记，登录窗切到建角页（照原版选区
                   后没角色就先建角）。*/
                this.needCreate = true;
                this.formMsg = r.Str("err", "请先创建角色");
                this.AddChat("[系统]", this.formMsg);
                this.self = null;
                this.Bump();
                return;
            }
            this.needCreate = false;
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.stage = 4;
            this.AfterEnter();
        });
    }

    /* 建角入口：先拉一次区服列表把区名/倍率备好，再 create 到当前
       选中区（realmId 可被建角窗的区服列表改过）；服务端建角即进入
       世界（self 直接带回来）。 */
    void CreateChar(string name, int job, int gender) {
        if (name.Length < 2) { this.AddChat("[系统]", "角色名需 2 个字符以上。"); return; }
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "create");
        body.PutInt("realm", this.realmId);
        body.PutStr("name", name);
        body.PutInt("job", job);
        body.PutInt("gender", gender);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) {
                this.formMsg = "创建角色失败：" + r.Str("err", "未知错误");
                this.AddChat("[系统]", this.formMsg);
                this.Bump();
                return;
            }
            this.needCreate = false;
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.stage = 4;
            this.AddChat("[系统]", "角色已创建并进入 " + this.realmName + "。");
            this.AfterEnter();
        });
    }

    void AfterEnter() {
        this.lastFight = null;
        this.feed.Clear();
        this.AddFeed("进入 " + this.realmName + "，战况将实时显示在这里。");
        this.RefreshWorld();
        this.RefreshBag();
    }

    /* 进区/换图后刷新怪物与地图缓存（一次各一条小回复）。*/
    void RefreshWorld() {
        this.Op("{\"op\":\"mobs\"}", (JsonValue r) => {
            JsonValue rows = r.Get("rows");
            if (rows != null && rows.IsArray()) {
                this.mobs = rows;
                this.typedMobs.Clear();
                for (int mi = 0; mi < rows.Count(); mi = mi + 1) {
                    JsonValue item = rows.At(mi);
                    if (item != null) {
                        MobInfo mb = new MobInfo(
                            item.Int("id", 0),
                            item.Str("name", ""),
                            item.Int("level", 1),
                            item.Int("hp", 100)
                        );
                        mb.Tpl = item.Int("tpl", mb.Id);
                        mb.Alive = item.Int("alive", 1) == 1;
                        mb.RespawnIn = item.Int("respawnIn", 0);
                        this.typedMobs.Add(mb);
                    }
                }
                this.Bump();
            }
        });
        this.Op("{\"op\":\"maps\"}", (JsonValue r) => {
            JsonValue rows = r.Get("maps");
            if (rows == null) { rows = r.Get("rows"); }
            if (rows != null && rows.IsArray()) {
                this.maps = rows;
                this.typedMaps.Clear();
                for (int mpi = 0; mpi < rows.Count(); mpi = mpi + 1) {
                    JsonValue item = rows.At(mpi);
                    if (item != null) {
                        MapInfo mp = new MapInfo(
                            item.Int("id", 0),
                            item.Str("name", ""),
                            item.Int("level", 1)
                        );
                        this.typedMaps.Add(mp);
                    }
                }
                this.Bump();
            }
        });
    }

    /* ---- 背包与穿戴 ---- */

    /* 背包：物品列表 + 最新 self（金币/穿装随行更新）。*/
    /* 背包缓存为空才拉（BuildPage 里调用，防 Bump 重建死循环）。 */
    void MaybeRefreshBag() {
        if (this.bag != null) { return; }
        this.RefreshBag();
    }

    void RefreshBag() {
        this.Op("{\"op\":\"bag\"}", (JsonValue r) => {
            JsonValue rows = r.Get("items");
            if (rows != null && rows.IsArray()) {
                this.bag = rows;
                this.typedBag.Clear();
                for (int bi = 0; bi < rows.Count(); bi = bi + 1) {
                    JsonValue item = rows.At(bi);
                    if (item != null) {
                        BagItem bg = new BagItem(
                            item.Int("slot", bi),
                            item.Int("itemId", item.Int("id", 0)),
                            item.Str("name", ""),
                            item.Int("count", 1)
                        );
                        this.typedBag.Add(bg);
                    }
                }
            }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) {
                this.self = st;
                this.SyncPlayerState(st);
            }
            this.Bump();
        });
    }

    void EquipItem(int itemId) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "equip");
        body.PutInt("item", itemId);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "穿戴失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.AddFeed("装备已穿上。");
            this.RefreshBag();
        });
    }

    /* 卸下：slot 为服务端穿戴位代码（0武器 1衣服 2头盔 3项链 4手镯
       6戒指 8腰带 9靴子 10勋章 11宝石）。 */
    void TakeOff(int slot) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "takeoff");
        body.PutInt("slot", slot);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "卸下失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.AddFeed("已卸下。");
            this.RefreshBag();
        });
    }

    /* 穿戴明细（self.worn）：穿戴中的物品不在背包，属性由 self 就地带全。 */
    int WornCount() {
        JsonValue w = this.self != null ? this.self.Get("worn") : null;
        return w != null && w.IsArray() ? w.Count() : 0;
    }

    JsonValue WornAt(int i) {
        JsonValue w = this.self != null ? this.self.Get("worn") : null;
        if (w == null || !w.IsArray()) { return null; }
        return w.At(i);
    }

    JsonValue WornInSlot(int slot) {
        for (int i = 0; i < this.WornCount(); i = i + 1) {
            JsonValue w = this.WornAt(i);
            if (w != null && w.Int("slot", -1) == slot) { return w; }
        }
        return null;
    }

    void UseItem(int itemId) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "use");
        body.PutInt("item", itemId);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "使用失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.RefreshBag();
        });
    }

    void SellItem(int itemId) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "sell");
        body.PutInt("item", itemId);
        body.PutInt("count", 1);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "卖出失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.RefreshBag();
        });
    }

    /* ---- 玩法页数据：BOSS / 排行 / 商店 / 图鉴 / 世界 BOSS / 公告 ---- */
    /* 各页首次构建时数据缓存为空则拉一次；回复 Bump 后心跳整页重建，
       数据就位。Drop 时全部清空，重连后按页重拉。 */

    void MaybeRefreshBosses() {
        if (this.bosses != null) { return; }
        this.Op("{\"op\":\"bosses\"}", (JsonValue r) => {
            JsonValue rows = r.Get("rows");
            if (rows != null && rows.IsArray()) {
                this.bosses = rows;
                this.typedBosses.Clear();
                for (int bi = 0; bi < rows.Count(); bi = bi + 1) {
                    JsonValue item = rows.At(bi);
                    if (item != null) {
                        BossInfo bsi = new BossInfo(
                            item.Int("id", 0),
                            item.Str("name", ""),
                            item.Int("min_level", 1),
                            item.Int("rebirth", 0),
                            (long)item.Int("hp", 10000)
                        );
                        this.typedBosses.Add(bsi);
                    }
                }
                this.Bump();
            }
        });
    }

    void MaybeRefreshShop() {
        if (this.shop != null) { return; }
        this.Op("{\"op\":\"shop\"}", (JsonValue r) => {
            JsonValue rows = r.Get("shop");
            if (rows != null && rows.IsArray()) {
                this.shop = rows;
                this.typedShop.Clear();
                for (int si = 0; si < rows.Count(); si = si + 1) {
                    JsonValue item = rows.At(si);
                    if (item != null) {
                        ShopItem it = new ShopItem(
                            item.Int("id", 0),
                            item.Str("name", ""),
                            item.Int("price", 0),
                            item.Int("picture", 0),
                            item.Int("kind", 0)
                        );
                        this.typedShop.Add(it);
                    }
                }
                this.Bump();
            }
        });
    }

    /* 商店购买：服务端按 items 表金价计费、直接入背包。 */
    void ShopBuyItem(int itemId, int count) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "buy");
        body.PutInt("item", itemId);
        body.PutInt("count", count);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "购买失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.RefreshBag();
            this.Bump();
        });
    }

    /* 沙巴克争夺（siege op 的 sha 分支，头带「申请攻沙」）。 */
    void SiegeSha() {
        this.Op("{\"op\":\"siege\",\"sha\":1}", (JsonValue r) => {
            if (this.TakeSelf(r)) {
                JsonValue a = r.Get("siege");
                if (a != null && a.IsObject()) { this.playSiege = a; }
                this.AddFeed(r.Str("log", "攻沙结束"));
                this.Bump();
            }
        });
    }

    /* 排行榜/世界BOSS 状态：进页时为空才拉（回复 Bump 重建一次后
       数据就位，不再循环）；手动刷新走 Reload*。 */
    void RefreshRank() {
        if (this.rank != null) { return; }
        this.Op("{\"op\":\"rank\"}", (JsonValue r) => {
            JsonValue rows = r.Get("rows");
            if (rows != null && rows.IsArray()) {
                this.rank = rows;
                this.typedRank.Clear();
                for (int ri = 0; ri < rows.Count(); ri = ri + 1) {
                    JsonValue item = rows.At(ri);
                    if (item != null) {
                        RankItem rk = new RankItem(
                            item.Int("rank", ri + 1),
                            item.Int("uid", item.Int("id", item.Int("playerId", 0))),
                            item.Str("name", ""),
                            item.Int("level", 1),
                            (long)item.Int("val", item.Int("value", 0)),
                            item.Int("job", 0),
                            item.Long("exp", 0)
                        );
                        this.typedRank.Add(rk);
                    }
                }
                this.Bump();
            }
        });
    }

    void ReloadRank() { this.rank = null; this.RefreshRank(); }

    void ReloadBosses() { this.bosses = null; this.MaybeRefreshBosses(); }

    void MaybeRefreshCodex() {
        if (this.codex != null) { return; }
        this.Op("{\"op\":\"codex\"}", (JsonValue r) => {
            JsonValue cx = r.Get("codex");
            if (cx != null && cx.IsObject()) { this.codex = cx; this.Bump(); }
        });
    }

    void MaybeRefreshAnnounces() {
        if (this.announces != null) { return; }
        this.Op("{\"op\":\"announces\"}", (JsonValue r) => {
            JsonValue rows = r.Get("rows");
            if (rows != null && rows.IsArray()) { this.announces = rows; this.Bump(); }
        });
    }

    /* 世界 BOSS：进页拉一次状态；hit=1 是攻击一轮（状态与 self 一并
       回来，Bump 后页面血条刷新）。 */
    void RefreshWBoss() {
        if (this.wboss != null) { return; }
        this.Op("{\"op\":\"wboss\"}", (JsonValue r) => {
            JsonValue w = r.Get("wboss");
            if (w != null && w.IsObject()) {
                this.wboss = w;
                this.typedWBoss.Name = w.Str("name", "玛雅之神·幻影");
                this.typedWBoss.Level = w.Int("level", 100);
                this.typedWBoss.TopPlayer = w.Str("top", "虚位以待");
                this.typedWBoss.TopDamage = (long)w.Int("topDmg", 0);
                this.typedWBoss.Alive = w.Int("alive", 1) == 1;
                this.typedWBoss.Hp = (long)w.Int("hp", 0);
                this.typedWBoss.MaxHp = (long)w.Int("maxHp", 1000000);
                this.typedWBoss.RespawnIn = (long)w.Int("respawnIn", 0);
                this.Bump();
            }
        });
    }

    void WBossHit() {
        this.Op("{\"op\":\"wboss\",\"hit\":1}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddFeed("攻击失败：" + r.Str("err", "未知错误")); return; }
            JsonValue w = r.Get("wboss");
            if (w != null && w.IsObject()) {
                this.wboss = w;
                this.typedWBoss.Name = w.Str("name", this.typedWBoss.Name);
                this.typedWBoss.Level = w.Int("level", this.typedWBoss.Level);
                this.typedWBoss.TopPlayer = w.Str("top", this.typedWBoss.TopPlayer);
                this.typedWBoss.TopDamage = (long)w.Int("topDmg", (int)this.typedWBoss.TopDamage);
                this.typedWBoss.Alive = w.Int("alive", 1) == 1;
                this.typedWBoss.Hp = (long)w.Int("hp", (int)this.typedWBoss.Hp);
                this.typedWBoss.MaxHp = (long)w.Int("maxHp", (int)this.typedWBoss.MaxHp);
                this.typedWBoss.RespawnIn = (long)w.Int("respawnIn", (int)this.typedWBoss.RespawnIn);
            }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) {
                this.self = st;
                this.SyncPlayerState(st);
            }
            JsonValue f = r.Get("fight");
            if (f != null && f.IsObject()) {
                this.AddFeed("世界BOSS：伤害 " + Convert.ToString(f.Int("dmg", 0))
                    + " · 累计 " + Convert.ToString(f.Int("mydmg", 0))
                    + (f.Int("killed", 0) == 1 ? " · 击杀！大奖已发！" : ""));
                if (f.Str("drop", "").Length > 0) { this.AddFeed("击杀掉落：" + f.Str("drop", "")); }
            }
            this.Bump();
        });
    }

    /* ---- 玩法页（Play 模块 op）：进页拉一次缓存，动作回复就地合入。
       强类型模型：各页面均通过 Typed<Name>() 访问强类型实体状态，JsonValue 仅保留在协议网络传输边界。
       统一形状：play_<op> 缓存 + MaybeRefresh<Name>() + 动作方法。---- */

    int TitlePages() { return this.playTitlePages > 0 ? this.playTitlePages : 1; }
    JsonValue Rank() { return this.rank; }
    JsonValue CodexPage() { return this.codexPage; }
    int CodexPageNo() { return this.codexPageNo; }
    int CodexTotal() { return this.codexTotal; }

    /* 动作回复的公共收尾：self 变了就换，错误入聊天。 */
    bool TakeSelf(JsonValue r) {
        JsonValue st = r.Get("self");
        if (st != null && st.IsObject()) { this.self = st; }
        if (r.Int("ok", 0) != 1) {
            this.AddChat("[系统]", r.Str("err", "未知错误"));
            return false;
        }
        return true;
    }

    void UpdateArenaState(JsonValue a) {
        if (a == null || !a.IsObject()) { return; }
        this.playArena = a;
        if (this.typedArena == null) { this.typedArena = new ArenaState(); }
        this.typedArena.Tries = a.Int("tries", this.typedArena.Tries);
        this.typedArena.Wins = a.Int("wins", this.typedArena.Wins);
        this.typedArena.Pts = a.Int("pts", this.typedArena.Pts);
        this.typedArena.Power = a.Int("power", this.typedArena.Power);
        this.typedArena.Time = (long)a.Int("time", (int)this.typedArena.Time);
        JsonValue rows = a.Get("rows");
        if (rows != null && rows.IsArray()) {
            this.typedArena.Rows.Clear();
            for (int i = 0; i < rows.Count(); i = i + 1) {
                JsonValue r = rows.At(i);
                if (r != null && r.IsObject()) {
                    ArenaRival ar = new ArenaRival(
                        r.Int("rank", i + 1),
                        r.Str("name", "无名"),
                        r.Int("me", 0) == 1
                    );
                    this.typedArena.Rows.Add(ar);
                }
            }
        }
    }

    void UpdateEscortState(JsonValue a) {
        if (a == null || !a.IsObject()) { return; }
        this.playEscort = a;
        if (this.typedEscort == null) { this.typedEscort = new EscortState(); }
        this.typedEscort.Tries = a.Int("tries", this.typedEscort.Tries);
        this.typedEscort.Stage = a.Int("stage", this.typedEscort.Stage);
        this.typedEscort.Left = a.Int("left", this.typedEscort.Left);
        this.typedEscort.Reward = a.Int("reward", this.typedEscort.Reward);
    }

    void MaybeRefreshArena() {
        if (this.playArena != null) { return; }
        this.Op("{\"op\":\"arena\"}", (JsonValue r) => {
            JsonValue a = r.Get("arena");
            if (a != null && a.IsObject()) {
                this.UpdateArenaState(a);
                this.Bump();
            }
        });
    }

    /* 竞技场「刷新数据」：丢掉缓存再拉一次（战功/次数/挑战榜都是服务端
       权威）。回复到达时 Bump 会让主循环整页重建，新数据自然显示出来。 */
    void ReloadArena() {
        this.playArena = null;
        this.MaybeRefreshArena();
    }

    void ArenaFight(int rival) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "arena");
        body.PutInt("fight", rival);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (this.TakeSelf(r)) {
                JsonValue a = r.Get("arena");
                if (a != null && a.IsObject()) {
                    this.UpdateArenaState(a);
                }
                this.AddFeed(r.Str("log", "战斗结束"));
                this.Bump();
            }
        });
    }

    void MaybeRefreshEscort() {
        if (this.playEscort != null) { return; }
        this.Op("{\"op\":\"escort\"}", (JsonValue r) => {
            JsonValue a = r.Get("escort");
            if (a != null && a.IsObject()) {
                this.UpdateEscortState(a);
                this.Bump();
            }
        });
    }

    /* 押镖是倒计时玩法：进页强制重拉（缓存只兜本次会话首帧）。 */
    void ReloadEscort() { this.playEscort = null; this.MaybeRefreshEscort(); }

    void EscortGo() {
        this.Op("{\"op\":\"escort\",\"go\":1}", (JsonValue r) => {
            if (this.TakeSelf(r)) {
                JsonValue a = r.Get("escort");
                if (a != null && a.IsObject()) {
                    this.UpdateEscortState(a);
                }
                this.AddFeed("镖车出发了，60 秒后到达。");
                this.Bump();
            }
        });
    }

    void EscortCollect() {
        this.Op("{\"op\":\"escort\",\"collect\":1}", (JsonValue r) => {
            if (this.TakeSelf(r)) {
                JsonValue a = r.Get("escort");
                if (a != null && a.IsObject()) {
                    this.UpdateEscortState(a);
                }
                this.AddFeed("交镖成功，入账 " + Convert.ToString(r.Int("gain", 0)) + " 金币。");
                this.Bump();
            }
        });
    }

    void UpdateGuildState(JsonValue rows) {
        if (rows == null || !rows.IsArray()) { return; }
        this.playGuild = rows;
        if (this.typedGuild == null) { this.typedGuild = new GuildState(); }
        this.typedGuild.Guilds.Clear();
        for (int i = 0; i < rows.Count(); i = i + 1) {
            JsonValue g = rows.At(i);
            if (g != null && g.IsObject()) {
                GuildItem gi = new GuildItem(
                    g.Int("id", 0),
                    g.Str("name", ""),
                    g.Str("master", g.Str("leader", "")),
                    g.Int("members", 0),
                    g.Int("memberCap", 50),
                    g.Int("goods", g.Int("fund", 0)),
                    g.Int("mine", 0) == 1
                );
                this.typedGuild.Guilds.Add(gi);
            }
        }
    }

    void UpdateSiegeState(JsonValue a) {
        if (a == null || !a.IsObject()) { return; }
        this.playSiege = a;
        if (this.typedSiege == null) { this.typedSiege = new SiegeState(); }
        this.typedSiege.Owner = a.Str("owner", "");
        this.typedSiege.Guild = a.Str("guild", "");
        this.typedSiege.HoldSeconds = a.Int("holdSeconds", 0);
        JsonValue cities = a.Get("cities");
        if (cities != null && cities.IsArray()) {
            this.typedSiege.Cities.Clear();
            for (int i = 0; i < cities.Count(); i = i + 1) {
                JsonValue c = cities.At(i);
                if (c != null && c.IsObject()) {
                    CityItem ci = new CityItem(
                        c.Int("id", i + 1),
                        c.Str("name", ""),
                        c.Str("owner", ""),
                        c.Str("guild", ""),
                        c.Int("income", 0),
                        c.Int("cost", 0),
                        c.Str("date", "")
                    );
                    this.typedSiege.Cities.Add(ci);
                }
            }
        }
    }

    void UpdateTowerState(JsonValue a) {
        if (a == null || !a.IsObject()) { return; }
        this.playTower = a;
        if (this.typedTower == null) { this.typedTower = new TowerState(); }
        this.typedTower.Floor = a.Int("floor", 0);
        this.typedTower.Tries = a.Int("tries", 0);
        this.typedTower.MaxTries = a.Int("maxTries", 10);
        JsonValue rivals = a.Get("rivals");
        if (rivals != null && rivals.IsArray()) {
            this.typedTower.Rivals.Clear();
            for (int i = 0; i < rivals.Count(); i = i + 1) {
                JsonValue r = rivals.At(i);
                if (r != null && r.IsObject()) {
                    TowerRival tr = new TowerRival(
                        r.Str("name", ""),
                        r.Int("floor", 0),
                        r.Int("level", 0)
                    );
                    this.typedTower.Rivals.Add(tr);
                }
            }
        }
    }

    void RefreshGuild() {
        this.Op("{\"op\":\"guild\"}", (JsonValue r) => {
            if (this.TakeSelf(r)) {
                JsonValue rows = r.Get("rows");
                if (rows != null && rows.IsArray()) {
                    this.UpdateGuildState(rows);
                    this.Bump();
                }
            }
        });
    }

