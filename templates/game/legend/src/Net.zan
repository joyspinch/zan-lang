                this.AddFeed("购买成功，物品已入背包。");
                this.RefreshBag();
                this.RefreshMarket();
            }
        });
    }

    void MarketCancel(int rowId) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "market");
        body.PutInt("cancel", rowId);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (this.TakeSelf(r)) {
                this.AddFeed("已下架，物品退回背包。");
                this.RefreshBag();
