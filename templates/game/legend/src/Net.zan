    void MarketSell(int itemId, int count, int price) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "market");
        body.PutInt("sellItem", itemId);
        body.PutInt("count", count);
        body.PutInt("price", price);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (this.TakeSelf(r)) {
                this.AddFeed("挂单成功，等待买家。");
                this.RefreshBag();
                this.RefreshMarket();
            }
        });
    }

