    void RefreshMail() {
        this.Op("{\"op\":\"mail\"}", (JsonValue r) => {
            if (this.TakeSelf(r)) {
                JsonValue rows = r.Get("rows");
                if (rows != null && rows.IsArray()) {
                    this.playMail = rows;
                    this.typedMails.Clear();
                    for (int i = 0; i < rows.Count(); i = i + 1) {
                        JsonValue m = rows.At(i);
                        if (m != null && m.IsObject()) {
                            MailItem mi = new MailItem(
                                m.Int("id", 0),
                                m.Str("title", ""),
                                m.Str("sender", ""),
                                m.Str("date", ""),
                                m.Str("body", ""),
                                m.Int("claimed", 0)
                            );
                            JsonValue its = m.Get("items");
                            if (its != null && its.IsArray()) {
                                for (int k = 0; k < its.Count() && k < 8; k = k + 1) {
                                    mi.Items.Add(its.At(k).Int("pic", 0));
                                }
                            }
                            this.typedMails.Add(mi);
                        }
                    }
                    this.Bump();
                }
            }
        });
    }

    /* 页面进页拉取的守卫版（刷新邮件钮走 RefreshMail 强刷）。 */
    void MaybeRefreshMail() {
        if (this.playMail != null) { return; }
        this.RefreshMail();
    }

    void MailTake(int id) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "mail");
        body.PutInt("take", id);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (this.TakeSelf(r)) {
                this.AddFeed("附件已提取到背包。");
                this.RefreshBag();
                this.RefreshMail();
            }
        });
    }

    void MailTakeAll() {
        this.Op("{\"op\":\"mail\",\"takeall\":1}", (JsonValue r) => {
            if (this.TakeSelf(r)) {
                this.AddFeed("全部附件已提取到背包。");
                this.RefreshBag();
                this.RefreshMail();
            }
        });
    }

    void MailDel(int id) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "mail");
        body.PutInt("del", id);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (this.TakeSelf(r)) { this.AddFeed("邮件已删除。"); this.RefreshMail(); }
        });
    }

    void MailClear() {
        this.Op("{\"op\":\"mail\",\"clear\":1}", (JsonValue r) => {
            if (this.TakeSelf(r)) { this.AddFeed("已清空全部已领邮件。"); this.RefreshMail(); }
        });
    }

    void RefreshSup() {
        this.Op("{\"op\":\"sup\"}", (JsonValue r) => {
            if (this.TakeSelf(r)) {
                this.playSup = r;
                if (this.typedSup == null) { this.typedSup = new SupState(); }
                this.typedSup.Bonus = r.Int("bonus", 0);
                this.typedSup.Rows.Clear();
                JsonValue rows = r.Get("rows");
                if (rows != null && rows.IsArray()) {
                    for (int i = 0; i < rows.Count(); i = i + 1) {
                        JsonValue m = rows.At(i);
                        if (m != null && m.IsObject()) {
                            this.typedSup.Rows.Add(new SupGridItem(
                                m.Str("title", ""),
                                m.Int("itemId", 0),
                                m.Str("owner", ""),
                                m.Int("value", 0)
                            ));
                        }
                    }
                }
                this.Bump();
            }
        });
    }

    void MaybeRefreshSup() {
        if (this.playSup != null) { return; }
        this.RefreshSup();
    }

    /* reg = 殿堂格号（0 基，与页面卡片同序）：以对应装备位的当前穿戴登记。 */
    void SupReg(int slot) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "sup");
        body.PutInt("reg", slot);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (this.TakeSelf(r)) {
                this.AddFeed("登记成功，经验加成已更新！");
                this.RefreshSup();
            }
        });
    }

    void RefreshTj() {
        this.Op("{\"op\":\"tj\"}", (JsonValue r) => {
            if (this.TakeSelf(r)) {
                JsonValue groups = r.Get("groups");
                if (groups != null && groups.IsArray()) {
                    this.playTj = groups;
                    if (this.typedTj == null) { this.typedTj = new TjState(); }
                    this.typedTj.Groups.Clear();
                    for (int i = 0; i < groups.Count(); i = i + 1) {
                        JsonValue m = groups.At(i);
                        if (m != null && m.IsObject()) {
                            TjGroupItem gi = new TjGroupItem(
                                i,
                                m.Int("coeff", 0),
                                m.Int("complete", 0)
                            );
                            JsonValue slots = m.Get("slots");
                            if (slots != null && slots.IsArray()) {
                                for (int k = 0; k < slots.Count() && k < 9; k = k + 1) {
                                    gi.Slots.Add(slots.At(k).Int("item", 0));
                                }
                            }
                            this.typedTj.Groups.Add(gi);
                        }
                    }
                    this.Bump();
                }
            }
        });
    }

    void MaybeRefreshTj() {
        if (this.playTj != null) { return; }
        this.RefreshTj();
    }

    /* 场景页家族进度榜：dim 1=幻境 2=秘境 3=世界BOSS。每维独立缓存，
       页面构建时守卫拉取（SceneRankRows 取行，空=服务端还没人上榜）。 */
    void RefreshSceneRank(int dim) {
        this.Op("{\"op\":\"scenerank\",\"dim\":" + Convert.ToString(dim) + "}",
            (JsonValue r) => {
            if (this.TakeSelf(r)) {
                JsonValue rows = r.Get("rows");
                if (rows != null && rows.IsArray()) {
                    List<SceneRankRow> target = dim == 2 ? this.typedScene2 : (dim == 3 ? this.typedScene3 : this.typedScene1);
                    target.Clear();
                    for (int i = 0; i < rows.Count(); i = i + 1) {
                        JsonValue s = rows.At(i);
                        if (s != null && s.IsObject()) {
                            target.Add(new SceneRankRow(
                                s.Str("name", "?"),
                                s.Int("floor", 0),
                                s.Int("level", 0)
                            ));
                        }
                    }
                    if (dim == 2) { this.playScene2 = rows; }
                    else if (dim == 3) { this.playScene3 = rows; }
                    else { this.playScene1 = rows; }
                    this.Bump();
                }
            }
        });
    }

    void MaybeRefreshSceneRank(int dim) {
        if (dim == 2 && this.playScene2 != null) { return; }
        if (dim == 3 && this.playScene3 != null) { return; }
        if (dim <= 1 && this.playScene1 != null) { return; }
        this.RefreshSceneRank(dim);
    }

    JsonValue SceneRankRows(int dim) {
        if (dim == 2) { return this.playScene2; }
        if (dim == 3) { return this.playScene3; }
        return this.playScene1;
    }

    /* 仓库（wh）：{}=拉列表；入库/出库回复同形（wh+bag+self 整份下发），
       公共收尾一并换缓存。入库/出库都是整叠，count 防双花在服务端
       条件更新里裁决，失败错误经 TakeSelf 进聊天。 */
    bool TakeWh(JsonValue r) {
        if (!this.TakeSelf(r)) { return false; }
        JsonValue wh = r.Get("wh");
        if (wh != null && wh.IsArray()) {
            this.playWh = wh;
            this.typedWh.Clear();
            for (int wi = 0; wi < wh.Count(); wi = wi + 1) {
                JsonValue item = wh.At(wi);
                if (item != null) {
                    BagItem bg = new BagItem(
                        item.Int("slot", wi),
                        item.Int("itemId", item.Int("id", 0)),
                        item.Str("name", ""),
                        item.Int("count", 1)
                    );
                    this.typedWh.Add(bg);
                }
            }
        }
        JsonValue bgRows = r.Get("bag");
        if (bgRows != null && bgRows.IsArray()) {
            this.bag = bgRows;
            this.typedBag.Clear();
            for (int bi = 0; bi < bgRows.Count(); bi = bi + 1) {
                JsonValue item = bgRows.At(bi);
                if (item != null) {
                    BagItem bg = new BagItem(
                        item.Int("slot", bi),
                        item.Int("itemId", item.Int("id", 0)),
                        item.Str("name", ""),
                        item.Int("count", 1)
                    );
                    this.typedBag.Add(bg);
                }
            }
        }
        this.Bump();
        return true;
    }

    void RefreshWh() {
        this.Op("{\"op\":\"wh\"}", (JsonValue r) => { this.TakeWh(r); });
    }

    void MaybeRefreshWh() {
        if (this.playWh != null) { return; }
        this.RefreshWh();
    }

    JsonValue PlayWh() { return this.playWh; }
    int WhCount() { return this.playWh != null && this.playWh.IsArray() ? this.playWh.Count() : 0; }
    JsonValue WhAt(int i) { return this.playWh != null ? this.playWh.At(i) : null; }

    /* into=true 入库（背包→仓库），false 出库（仓库→背包）。 */
    void WhMove(int itemId, int count, bool into) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "wh");
        body.PutInt(into ? "in" : "out", itemId);
        body.PutInt("count", count);
        this.Op(body.ToJson(), (JsonValue r) => { this.TakeWh(r); });
    }

    /* put = 组号 slot = 格号：服务端从背包找该格对应装备放入（消耗，
       放入无法取出），失败错误进聊天。 */
    void TjPut(int group, int slot) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "tj");
        body.PutInt("put", group);
        body.PutInt("slot", slot);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (this.TakeSelf(r)) {
                this.AddFeed("装备已放入图鉴（放入无法取出）。");
                this.RefreshBag();
                this.RefreshTj();
            }
        });
    }

    void Forge(string slot) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "forge");
        body.PutStr("slot", slot);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "强化失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.AddFeed("强化成功，属性已提升。");
            this.Bump();
        });
    }

    void DrawTreasure() {
        this.Op("{\"op\":\"draw\"}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "寻宝失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.AddFeed("寻宝抽得【" + r.Str("item", "??") + "】！");
            this.drawItemIds.Insert(0, r.Int("itemId", 0));
            if (this.drawItemIds.Count > 36) { this.drawItemIds.RemoveAt(36); }
            this.RefreshBag();
            this.Bump();
        });
    }

    /* 寻宝记录格：最近抽得的道具号（新在前）。 */
    int DrawLogCount() { return this.drawItemIds.Count; }
    int DrawLogAt(int i) { return this.drawItemIds[i]; }

    void RecycleAll() {
        this.Op("{\"op\":\"recycle\"}", (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "回收失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.AddFeed("材料回收完成，入账 " + Convert.ToString(r.Int("gain", 0)) + " 金币。");
            this.RefreshBag();
            this.Bump();
        });
    }

    /* 回收系统页按行回收：只结账指定材料，count>0 时限数量。 */
    void RecycleOne(int itemId, int count) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "recycle");
        body.PutInt("item", itemId);
        body.PutInt("count", count);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "回收失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.AddFeed("回收完成，入账 " + Convert.ToString(r.Int("gain", 0)) + " 金币。");
            this.RefreshBag();
            this.Bump();
        });
    }

    void AutoHunt(int mobId, bool on) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "auto");
        if (on) { body.PutInt("mob", mobId); body.PutInt("on", 1); } else { body.PutInt("on", 0); }
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) == 1) {
                this.autoMob = on ? mobId : 0;
                this.demoHp = 0; this.demoWait = 0; this.demoTick = 0;
                this.AddFeed(on ? "自动挂机开启：战况是本地演示，收益由服务端每 60 秒批量结算。"
                                : "自动挂机已停止。");
            } else { this.AddChat("[系统]", "挂机失败：" + r.Str("err", "未知错误")); }
            this.Bump();
        });
    }

    /* ---- 地图内页（进图后的页面）：BOSS 挑战/扫荡/战报 ---- */

    JsonValue BossPage() { return this.bossPage; }
    int BossMap() { return this.bossMap; }
    int BossLogCount() { return this.bossLog.Count; }
    string BossLogAt(int i) { return this.bossLog[i]; }
    bool BossAuto() { return this.bossAuto; }

    /* 战报版本：地图内页拿它判断「这 5 行要不要重排」。战报是服务端
       bossfight 的回合日志（离线时由客户端自演），改动只有三处——本函数、
       TakeBossReply、BossSweep——都递增它，页面就不必逐行比字符串。 */
    int bossLogVer;
    int BossLogVer() { return this.bossLogVer; }

    /* 地图内页自演战报：一行一条（原版行格式见参考图 地图-进入.png）。
       离线壳没有服务端回合日志，整条战报由客户端按场景动画写进来。 */
    void LogBattle(string s) {
        this.bossLog.Add(s);
        if (this.bossLog.Count > 16) { this.bossLog.RemoveAt(0); }
        this.bossLogVer = this.bossLogVer + 1;
    }

    /* 进图第一屏：把参考图那 5 行原样铺一次（钉耙猫死/稻草人出现/战斗中/
       稻草人死/稻草人出现），这样冻结帧能和原图逐行对版式。 */
    void SeedDemoMap(int mapId) {
        this.bossMap = mapId;
        this.bossLog.Clear();
        this.LogBattle("[提示]钉耙猫 死亡，清理战场，继续探索…");
        this.LogBattle("[信息]稻草人 出现在 ↗(X: 357, Y: 199)，接近目标…");
        this.LogBattle("[战斗]正在战斗中…");
        this.LogBattle("[提示]稻草人 死亡，清理战场，继续探索…");
        this.LogBattle("[信息]稻草人 出现在 ↘(X: 352, Y: 257)，接近目标…");
    }

    void SetBossAuto(bool on) {
        this.bossAuto = on;
        this.AddFeed(on ? "结束后自动挑战BOSS：开（败了自动接着磨）。"
                        : "结束后自动挑战BOSS：关。");
    }

    void SyncBossPage(JsonValue p) {
        if (p == null || !p.IsObject()) { return; }
        if (this.typedBossPage == null) { this.typedBossPage = new MapBossPage(); }
        this.typedBossPage.Tries = p.Int("tries", 0);
        JsonValue bo = p.Get("boss");
        if (bo != null && bo.IsObject()) {
            this.typedBossPage.HpLeft = bo.Int("hpLeft", 0);
            int maxHp = bo.Int("hp", 1);
            if (maxHp <= 0) { maxHp = 1; }
            int pic = Convert.ToInt(bo.Str("picture", "0"));
            this.typedBossPage.Boss = new BossDetail(
                bo.Int("id", 0),
                bo.Str("name", "BOSS"),
                pic,
                maxHp,
                bo.Int("mp", 0),
                bo.Int("level", 1),
                bo.Int("rebirth", 0),
                bo.Int("atkMin", 0),
                bo.Int("atk", 0),
                bo.Int("magMin", 0),
                bo.Int("mag", 0),
                bo.Int("taoMin", 0),
                bo.Int("tao", 0),
                bo.Int("defMin", 0),
                bo.Int("def", 0),
                bo.Int("mdefMin", 0),
                bo.Int("mdef", 0)
            );
        }
    }

    /* bossfight/bossweep 回复的公共合入：面板与 self 整份替换，log
       有则整屏替换（扫荡无 log，战报保留原内容）。 */
    void TakeBossReply(JsonValue r) {
        JsonValue p = r.Get("page");
        if (p != null && p.IsObject()) { this.bossPage = p; this.SyncBossPage(p); }
        JsonValue st = r.Get("self");
        if (st != null && st.IsObject()) { this.self = st; }
        JsonValue lg = r.Get("log");
        if (lg != null && lg.IsArray()) {
            this.bossLog.Clear();
            for (int i = 0; i < lg.Count(); i = i + 1) {
                JsonValue ln = lg.At(i);
                string s = ln != null ? ln.AsString("") : "";
                if (s.Length > 0) { this.bossLog.Add(s); }
            }
        }
        this.Bump();
    }

    /* 打开地图内页：拉一次 BOSS 面板（挑战/扫荡回复自带新面板）。 */
    void OpenMapPage(int mapId) {
        this.bossMap = mapId;
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "bossinfo");
        body.PutInt("map", mapId);
        this.Op(body.ToJson(), (JsonValue r) => {
                JsonValue p = r.Get("page");
                if (r.Int("ok", 0) != 1) {
                    this.AddFeed("BOSS面板拉取失败：" + r.Str("err", "未知错误"));
                    return;
                }
                if (p != null && p.IsObject()) { this.bossPage = p; this.SyncBossPage(p); this.Bump(); }
            });
    }

    /* 挑战一场：服务端整场打完，回复带逐轮战报。勾了自动挑战且打输
       且还有次数就接着递归磨（BOSS 留血，玩家每场满血，磨得动）。 */
    void BossFight(int mapId) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "bossfight");
        body.PutInt("map", mapId);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) {
                this.AddFeed("挑战失败：" + r.Str("err", "未知错误"));
                return;
            }
            this.TakeBossReply(r);
            if (this.bossAuto && r.Int("win", 0) != 1
                    && this.self != null && this.self.Int("tries", 0) > 0) {
                this.BossFight(mapId);
            }
        });
    }

    void BossSweep(int mapId, int count) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "bossweep");
        body.PutInt("map", mapId);
        body.PutInt("count", count);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) {
                this.AddFeed("扫荡失败：" + r.Str("err", "未知错误"));
                return;
            }
            this.bossLog.Add("[扫荡] " + r.Str("text", "完成"));
            if (this.bossLog.Count > 16) { this.bossLog.RemoveAt(0); }
            this.TakeBossReply(r);
        });
    }

    void Hunt(int mobId) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "hunt");
        body.PutInt("mob", mobId);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "开战失败：" + r.Str("err", "未知错误")); return; }
            JsonValue f = r.Get("fight");
            if (f != null && f.IsObject()) { this.lastFight = f; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
        });
    }

    void UsePotion() {
        this.Op("{\"op\":\"use\",\"item\":1}", (JsonValue r) => {
            this.AddChat("[系统]", r.Int("ok", 0) == 1 ? "嗑药成功。" : "嗑药失败：" + r.Str("err", "未知错误"));
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
        });
    }

    void MoveTo(int mapId) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "move");
        body.PutInt("map", mapId);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddFeed("移动失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            /* 换图后怪物/地图缓存要重拉（mob 列表按当前图过滤）。 */
            this.RefreshWorld();
            this.Bump();
        });
    }

    void BuyItem(int itemId) {
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "buy");
        body.PutInt("item", itemId);
        body.PutInt("count", 1);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "购买失败：" + r.Str("err", "未知错误")); return; }
            JsonValue st = r.Get("self");
            if (st != null && st.IsObject()) { this.self = st; }
            this.AddFeed("购买成功，物品已入背包。");
            this.RefreshBag();
            this.Bump();
        });
    }

    void Say(string text) {
        if (text.Length == 0) { return; }
        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "say");
        body.PutStr("text", text);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (r.Int("ok", 0) != 1) { this.AddChat("[系统]", "发送失败：" + r.Str("err", "未知错误")); }
        });
    }

    void Logout() {
        this.Drop("主动断开");
    }
}

/* 一条待发的 HTTP op：json 即请求体（{"op":...,...}，Seal 已注入
   token）。worker 填写应答三件套，UI 线程 PollHttp 并入；网络错误/
   限流/401 也合成 {"ok":0,"err"} 回给 cb——回调必达，UI 不会停在
   旧状态。*/
class HttpReq {
    string json;
    NetReply cb;
    /* worker 填写、UI 线程 PollHttp 读取的应答三件套。 */
    int status;
    string respBody;
    string err;
}
