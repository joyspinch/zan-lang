    void RefreshMarket() {
        this.Op("{\"op\":\"market\"}", (JsonValue r) => {
            if (this.TakeSelf(r)) {
                JsonValue rows = r.Get("rows");
                if (rows != null && rows.IsArray()) {
                    this.playMarket = rows;
                    this.typedMarkets.Clear();
                    for (int i = 0; i < rows.Count(); i = i + 1) {
                        JsonValue m = rows.At(i);
                        if (m != null && m.IsObject()) {
                            MarketItem mi = new MarketItem(
                                m.Int("id", 0),
                                m.Int("itemId", 0),
                                m.Str("name", "?"),
                                m.Int("count", 1),
                                (long)m.Int("price", 0),
                                m.Str("seller", ""),
                                (long)m.Int("age", 0),
                                m.Int("mine", 0) == 1
                            );
                            this.typedMarkets.Add(mi);
                        }
                    }
                    this.Bump();
                }
            }
        });
    }

