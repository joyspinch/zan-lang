        JsonValue body = JsonValue.NewObject();
        body.PutStr("op", "lord");
        body.PutInt("donate", yuan);
        this.Op(body.ToJson(), (JsonValue r) => {
            if (this.TakeSelf(r)) {
                this.AddFeed("捐献成功，贡献度已累计。");
                this.RefreshLord();
            }
        });
