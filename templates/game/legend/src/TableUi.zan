using System;
using Gui;
using Gui.Widget;
using Legend;

/// 通用「表格」组件——称谓 / 爵位 / 排行榜 / 图鉴 / 交易市场 / 回收系统
/// 这些「表头 + N 行数据 + 页脚」的页面全走这里。
///
/// 组合自标准库 Gui 组件（Panel / Label / Button / Pagination），**不自绘**：
/// 画布直绘（`Table.RenderHeader` 那套静态渲染助手）拿不到停靠布局，也没有
/// CSS 皮肤、命中区域与设计器属性——写出来的表格换不了皮、点不了。
///
/// 实测几何全在 `Spec.Tbl*`（唯一事实来源，逻辑像素 → Px 设备像素）。
/// 结构（自页内容顶起算，见 Spec 注释里的实测表）：
///
///     容器 #1d2633 + 1 设备外框 #3d4756，满页宽
///       表头带 #103555（满宽；带内文字仍按数据列栅格左缩 12 设备）
///       6 设备缝
///       12 行 #121f2d（行高 45、行缝 4.5、列缝 4.5）
///       6 设备底缝
///     18 设备缝 → 页脚（左说明文字 / 右「说明」钮 + 标准库 Pagination）
///
/// 布局纪律（踩过的坑）：
///  1. 表头带要**满宽**而文字要**内缩**：内缩走 `Padding(0,0,0,TblPadL)`，
///     不要用前导撑条——停靠容器给每个子项之间都算一份 Gap，前导撑条会变成
///     「撑条 + 缝」，整行右移一缝（商店页实测右移 9/21 设备）。
///  2. 行与行之间的缝靠行容器（Column）的 `Gap`，行内列缝靠行（Row）的
///     `Gap`；两个值同实测 4.5 设备，别混用。
partial class LegendApp {
    /// 表格容器：满宽，底色 + 外框由 `.tbl-box` 给。上下留白**不能**走容器
    /// `Padding`——容器的 prefH 只由子项测量得出，底部内边距不计入，最后一
    /// 行会贴到外框上（实测表底 802，应 811）。改由两个定高撑条显式占位。
    Panel TblBox() {
        Panel box = Panel.Column(); box.Class = "tbl-box";
        box.Pad(0); box.Gap(0);
        box.With(TblPad(Spec.TblHeadTopPad()));
        return box;
    }

    /// 定高透明撑条（表格上下留白用）。
    Panel TblPad(int hDevice) {
        Panel p = Panel.Row(); p.Pad(0); p.Prefer(0, hDevice);
        return p;
    }

    /// 行高的 0.5 设备取整补偿：实测行节距 49.5 设备（33 逻辑），整数设备
    /// 像素下只能 49/50 交替——原版自己也是交替的（行顶 214/263/313/362…
    /// 差 49/50/50 混排）。全用 49 会让第 12 行比原版低 6 设备、表格底框
    /// 落到 804（应 811）。
    static int TblRowHAt(int r) { return Spec.TblRowH() + (r % 2); }

    /// 一个格子：定宽 + 定高、文字居中。`cls` 给文字着色（`.tbl-c0` …）；
    /// `boxCls` 给格子底色（高亮行的格子要透明，露出整行紫红底）。
    ///
    /// **居中靠格子的 flex `justify-content`，不靠 `text-align`**：stdlib
    /// `Label.OnPaint` 直接在盒子左缘 `DrawText`，`text-align` 对它无效
    /// （实测第一版表格整列文字贴左、与原版差 29 设备）。格子挂
    /// `.tbl-cell`（`display:flex; justify-content:center`）后，标签按自身
    /// 测量宽参与 flex 排布，才真正居中。
    /// 同上，但行高由调用方给**设备像素**：各页行高并不统一——称谓/爵位/
    /// 行会节距 49.5（45/46 交替），排行榜节距 43（恒定 39，**不需要**取整
    /// 补偿）。骨架只有这一份，`TblCellCls` 的默认值就是旧行为。
    Panel TblCellClsAt(string text, string cls, int wDevice, string boxCls,
                       int hDevice) {
        Panel c = Panel.Row(); c.Class = boxCls;
        c.Pad(0); c.Prefer(wDevice, hDevice);
        Label t = Text(text, cls, 0);
        t.Grow();
        c.With(t);
        return c;
    }

    Panel TblCellCls(string text, string cls, int wDevice, string boxCls) {
        return TblCellClsAt(text, cls, wDevice, boxCls, Spec.TblRowH());
    }

    Panel TblCell(string text, string cls, int wDevice) {
        return TblCellCls(text, cls, wDevice, "tbl-cell");
    }

    /// 内容不是文字而是一个**自定义子盒**的格子（行会页「等级」列的红椭圆
    /// 徽章那类）。子盒仍靠格子的 flex `justify-content/align-items` 居中：
    /// 子盒自己 `Prefer` 定尺寸即可，**不要**在格子里 `With()` 一个撑满的
    /// 盒子（`With` 会把它按 dock 贴边并拉满行高）。
    Panel TblCellBox(Panel child, int wDevice) {
        Panel c = Panel.Row(); c.Class = "tbl-cell";
        c.Pad(0); c.Prefer(wDevice, Spec.TblRowH());
        c.With(child);
        return c;
    }

    /// 表头带：满宽底色 + 内缩 12 设备的定宽格 + 居中青字。列数 = heads.Count，
    /// 列宽由调用方给（各页列数不同：称谓 10 列、爵位 12 列）。
    Panel TblHead(List<string> heads, List<int> ws) {
        return TblHeadAt(heads, ws, Spec.TblHeadH(), Spec.TblColGap(),
                         Spec.TblPadL());
    }

    /// 同上，但带高/列缝/左内缩由调用方给**设备像素**（排行榜带高 39、
    /// 左内缩 8，与称谓页的 41/12 不同）。
    Panel TblHeadAt(List<string> heads, List<int> ws, int hDevice, int gap,
                    int padL) {
        Panel band = Panel.Row(); band.Class = "tbl-head";
        band.Pad(0); band.Gap(gap);
        band.Prefer(0, hDevice);
        band.Padding(0, 0, 0, padL);
        for (int i = 0; i < heads.Count; i = i + 1) {
            Panel c = Panel.Row(); c.Class = "tbl-head-c";
            c.Pad(0);
            c.Prefer(ws[i], hDevice);
            Label t = Text(heads[i], "tbl-head-t", 0);
            t.Grow();
            c.With(t);
            band.With(c);
        }
        return band;
    }

    /// 数据行：cells 与 classes 一一对应，列宽由调用方给。`rowCls` 是整行的
    /// 皮肤类、`boxCls` 是格子底色类（原版高亮行「自己」是整行紫红
    /// `#570d41`——连格缝都是紫红，所以格子必须透明，只靠行底显色）。
    Panel TblRowCls(List<string> cells, List<string> classes, List<int> ws,
                    int r, string rowCls, string boxCls) {
        List<Panel> boxes = new List<Panel>();
        for (int i = 0; i < cells.Count; i = i + 1) {
            string cls = i < classes.Count ? classes[i] : "tbl-c";
            boxes.Add(TblCellCls(cells[i], cls, ws[i], boxCls));
        }
        return TblRowBoxes(boxes, r, rowCls);
    }

    Panel TblRow(List<string> cells, List<string> classes, List<int> ws, int r) {
        return TblRowCls(cells, classes, ws, r, "tbl-row", "tbl-cell");
    }

    /// 数据行（格子由调用方自己拼）：行骨架——行类、行高（含 0.5 设备节距
    /// 补偿）、列缝、左内缩——仍然只在这里写一次，页面只负责造格子。给
    /// 「中间某列不是纯文字」的页面用（行会：等级列是红椭圆徽章、申请列
    /// 是按钮）。
    Panel TblRowBoxes(List<Panel> cells, int r, string rowCls) {
        return TblRowBoxesAt(cells, TblRowHAt(r), Spec.TblColGap(),
                             Spec.TblPadL(), rowCls);
    }

    /// 行骨架的唯一实现：行高取**已算好的设备像素**，列缝/左内缩也由调用方
    /// 给。分两套路子是为了不改各页已经对过的像素——称谓/爵位/行会走
    /// `TblRowBoxes`（49/50 交替），排行榜走这里（恒定 39）。
    Panel TblRowBoxesAt(List<Panel> cells, int rowHDevice, int gap, int padL,
                        string rowCls) {
        Panel row = Panel.Row(); row.Class = rowCls;
        row.Pad(0); row.Gap(gap);
        row.Prefer(0, rowHDevice);
        row.Padding(0, 0, 0, padL);
        for (int i = 0; i < cells.Count; i = i + 1) { row.With(cells[i]); }
        return row;
    }

    /// 带操作钮的数据行：前 N-1 格数据，末列一个定尺寸按钮（原版「领取」
    /// /「申请」/「回收」这类）。按钮按实测 82×27 设备随行高等比缩放，
    /// **在格内居中**——用 `Add` + `Place` 手动摆位：`With` 会把 dock 改成
    /// 3（贴左），按钮就贴到格子左缘、还拉满行高（与实测差 9/9 设备）。
    Panel TblActionRow(List<string> cells, List<string> classes, List<int> ws,
                       int r, string btn, string btnCls, Action fn) {
        return TblActionRowW(cells, classes, ws, r, btn, btnCls,
                             Spec.TblRowH() * 82 / 45,
                             Spec.TblRowH() * 27 / 45, fn);
    }

    /// 同上，但按钮尺寸由调用方给**设备像素**（原版各页的钮宽并不统一：
    /// 称谓「领取」82、行会「申请」97；高低则都是 27）。
    Panel TblActionRowW(List<string> cells, List<string> classes, List<int> ws,
                        int r, string btn, string btnCls, int bw, int bh,
                        Action fn) {
        List<Panel> boxes = new List<Panel>();
        for (int i = 0; i < cells.Count; i = i + 1) {
            string cls = i < classes.Count ? classes[i] : "tbl-c";
            boxes.Add(TblCellCls(cells[i], cls, ws[i], "tbl-cell"));
        }
        int last = ws.Count - 1;
        boxes.Add(TblActionCell(btn, btnCls, bw, bh, ws[last], TblRowHAt(r), fn));
        return TblRowBoxes(boxes, r, "tbl-row");
    }

    /// 操作钮的**格子**：定宽定高，钮在格内水平垂直居中。钮用 `Add` +
    /// `Float` 摆位。
    Panel TblActionCell(string btn, string btnCls, int bw, int bh,
                        int cellW, int cellH, Action fn) {
        Panel box = Panel.Row(); box.Pad(0);
        box.Prefer(cellW, cellH);
        Button b = BtnDev(btn, btnCls, bw, bh, fn);
        b.Float((cellW - bw) / 2, (cellH - bh) / 2);
        box.Add(b);
        return box;
    }

    /// 页脚左端的状态文字（原版「当前称谓：无」——键白、值彩）。
    Panel TblFootNote(string key, string val, string valCls) {
        Panel p = Panel.Row(); p.Class = "tbl-note"; p.Pad(0); p.Gap(0);
        p.Prefer(0, Spec.TblFootH());
        Label k = Text(key, "tbl-note-k", 0); k.Prefer(0, Spec.TblFootH());
        p.With(k);
        Label v = Text(val, valCls, 0); v.Prefer(0, Spec.TblFootH());
        p.With(v);
        return p;
    }

    /// 表格页页脚：左侧任意内容 + 撑条 + 右「说明」钮 + 标准库 Pagination。
    /// `left` 为 null 时只剩右侧组。`pg` 由调用方持有（切页回调里重建页面）。
    Panel TblFootCustom(Panel left, Pagination pg) {
        return TblFootOpt(left, pg, Spec.TblFootPadL(), true);
    }

    /// 同上，但左内缩与「说明」钮都可调：原版各页页脚不全一样——称谓/爵位
    /// 有「说明」钮、左内缩 18 设备；行会**没有**「说明」钮、左内缩 25 设备。
    Panel TblFootOpt(Panel left, Pagination pg, int padL, bool note) {
        Panel foot = Panel.Row(); foot.Class = "tbl-foot";
        foot.Pad(0); foot.Gap(Spec.TblColGap());
        foot.Prefer(0, Spec.TblFootH());
        foot.Padding(0, Spec.TblFootPadR(), 0, padL);
        if (left != null) { foot.With(left); }
        Panel fill = Panel.Row(); fill.Class = "bag-fill"; foot.With(fill);
        if (note) {
            foot.With(BtnDev("说明", "tbl-btn", Spec.TblFootNoteW(),
                             Spec.TblFootH(), null));
        }
        if (pg != null) { foot.With(pg); }
        return foot;
    }

    /// 表格页页脚（左端单个状态文字）：`TblFootCustom` 的常用简写。
    Panel TblFoot(Panel note, Pagination pg) {
        return TblFootCustom(note, pg);
    }

    // ------------------------------------------------------------------
    //  竖排列表（帮助 28 的分类 tab / 设置 30 / 铁匠铺 21 的功能列表共用）
    // ------------------------------------------------------------------

    /// 竖排列表：每项一个定宽定高盒子 + 居中文字，带选中态与点击回调。
    ///
    /// 「列表类页面写一个组件把数据列出来即可」——这类页面（帮助/设置/铁匠铺
    /// 的功能与分类）结构完全一样，只有项文案、尺寸、选中态配色不同，所以只有
    /// 这一份实现；页面只给 `items` + 尺寸 + 类名。
    ///
    /// 居中同样不能靠 `Label` 的 `text-align`（`Label.OnPaint` 从左缘画），
    /// 靠项盒子的 flex `justify-content`（见 `.list-item`）。
    Panel ListCol(List<string> items, int itemW, int itemH, int gap,
                  string cls, string selCls, int sel, string textCls,
                  System.Linq.Action<int> pick) {
        Panel col = Panel.Column(); col.Class = "list-col";
        col.Pad(0); col.Gap(gap);
        col.Prefer(itemW, 0);
        for (int i = 0; i < items.Count; i = i + 1) {
            int idx = i;
            Panel it = Panel.Row();
            it.Class = i == sel ? cls + " " + selCls : cls;
            it.Pad(0); it.Prefer(itemW, itemH);
            it.Named("list-item-" + Rules.N(i));
            if (pick != null) { it.OnClick(() => { pick(idx); }); }
            it.With(Text(items[i], textCls, 0));
            col.With(it);
        }
        return col;
    }

    /// 同上，但项的内容由调用方给（图标 + 文字那类项）：`makers[i]` 返回该项
    /// 的子盒，本函数只管盒子的尺寸 / 选中态 / 点击。
    Panel ListColOf(List<Panel> makers, int itemW, int itemH, int gap,
                    string cls, string selCls, int sel, System.Linq.Action<int> pick) {
        Panel col = Panel.Column(); col.Class = "list-col";
        col.Pad(0); col.Gap(gap);
        col.Prefer(itemW, 0);
        for (int i = 0; i < makers.Count; i = i + 1) {
            int idx = i;
            Panel it = Panel.Row();
            it.Class = i == sel ? cls + " " + selCls : cls;
            it.Pad(0); it.Prefer(itemW, itemH);
            it.Named("list-item-" + Rules.N(i));
            if (pick != null) { it.OnClick(() => { pick(idx); }); }
            it.With(makers[i]);
            col.With(it);
        }
        return col;
    }

    /// 一行里的一段文字（同一条里要换色的部分拆成多段）——帮助页正文、铁匠铺
    /// 洗炼说明、寻宝规则那类「一段里嵌几个彩色词」的版式共用。
    class TextSeg {
        string text;
        string cls;
    }

    static TextSeg TextSegOf(string t, string c) {
        TextSeg s = new TextSeg();
        s.text = t; s.cls = c;
        return s;
    }

    /// 把一串分段排成一行（左起依次贴排，`rowCls` 控行高/行底色）。
    Panel TextSegRow(List<TextSeg> segs, string rowCls, int hDevice) {
        Panel row = Panel.Row(); row.Class = rowCls;
        row.Pad(0); row.Gap(0);
        row.Prefer(0, hDevice);
        for (int i = 0; i < segs.Count; i = i + 1) {
            row.With(Text(segs[i].text, segs[i].cls, 0));
        }
        return row;
    }
}
