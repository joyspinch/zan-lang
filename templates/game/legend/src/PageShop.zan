using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 27「商店」——照原版还原，规格见 Spec / REFERENCE_AUDIT §5.4。
///
///   · 顶行：4 个货币 tab（元宝 / 金币 / 推广币 / 灵符）+ 右端「激活码：」输入框 + 「使用」
///   · 主体：**3 列**商品卡（卡 230×53 逻辑 = 345×79 设备，列距 14、行距 12），
///     卡片阵一直排到聊天面板左沿（内容区右界 1490 设备，不是地图页那种窄区）
///   · 每卡 = 左图标石框 + 右上「名称 / 金边价格胶囊」+ 右下「数量 + 值 + +/− + 购买」
///   · 一页 6 行 × 3 = 18 张
///   · 页脚：左「元宝：N」，右「兑换元宝」+ 标准库 Pagination（用户「分页有分页组件」）
///
/// 数据是模板运行时表 `data/shop.csv`（原版商城没有对应原表，M2.DB 里
/// 只有 GameSc=图鉴套装、GameFw=符文配方、GameCity=城池，都不是商城），
/// 每张卡的价格取该行非零的那一档：元宝价优先，其次金币。
/// 货币 tab 在模板数据里没有「同物品多币种定价」语义，故只做选中态，
/// 不拿它过滤列表（不臆造原版没有的规则）。「使用」「兑换元宝」同理：
/// 原版对应的是激活码校验与充值兑换，模板没有这条通道，做成纯展示钮。
partial class LegendApp {
    int shopPage = 0;
    /// 货币 tab 的选中项（0..3）；-1 = 未选（原版默认无选中态）。
    int shopPayTab = 0 - 1;
    /// 每张卡自己的「数量」选择（0 表示还没动过，按 1 显示）。
    int[] shopQty = new int[64];

    int ShopCount(int i) {
        if (i < 0 || i >= 64) { return 1; }
        int n = shopQty[i];
        return n < 1 ? 1 : n;
    }

    /* ---- 素材 ----
       商品图标按 reward 语义挑道具表里的真图（原版商城图标就是这些
       道具图）：药水用红瓶、黑铁用矿石、扩容用仓库扩充卷、符文/龙珠
       按等级取对应道具号。 */
    static string ShopArtPath(string reward) {
        if (reward == "potions") { return "assets/item/01347.png"; }
        if (reward == "iron") { return ItemArtById(223); }
        if (reward == "capacity") { return ItemArtById(548); }
        if (reward == "runes") { return ItemArtById(347); }
        if (reward == "gold") { return ItemArtById(1); }
        if (reward == "ore") { return ItemArtById(569); }
        if (reward.StartsWith("rune")) {
            int lv = ShopRuneLevelOf(reward);
            if (lv > 0) { return ItemArtById(500 + lv); }
        }
        if (reward.StartsWith("ball")) {
            int st = ShopBallStarOf(reward);
            if (st > 0) { return ItemArtById(643 + st); }
        }
        return "assets/item/00002.png";
    }

    static int ShopRuneLevelOf(string reward) {
        for (int i = 1; i <= 14; i = i + 1) {
            if (reward == "rune" + Rules.N(i)) { return i; }
        }
        return 0;
    }

    static int ShopBallStarOf(string reward) {
        for (int i = 1; i <= 9; i = i + 1) {
            if (reward == "ball" + Rules.N(i)) { return i; }
        }
        return 0;
    }

    /// 价格图标：元宝价用元宝图，金币价用金币图（道具表 2 / 1 号）。
    static string ShopCoinPath(bool yuan) { return ItemArtById(yuan ? 2 : 1); }

    /// 卡片标题：原版卡片上写的是纯物品名，不带数量后缀
    /// （`data/shop.csv` 的 name 里带了「×10」这类份数说明，显示时去掉）。
    static string ShopTitle(string name) {
        int cut = name.IndexOf(" ×");
        if (cut <= 0) { return name; }
        return name.Substring(0, cut);
    }

    int ShopStep(int i, int d) {
        int n = ShopCount(i) + d;
        if (n < 1) { n = 1; }
        if (n > 99) { n = 99; }
        if (i >= 0 && i < 64) { shopQty[i] = n; }
        return n;
    }

    void ShopBuy(int i) {
        int n = ShopCount(i);
        /* 在线：服务端 items 目录（金价计费、直接入背包）。
           离线：本地 shop.csv 语义（reward 发放）。优先使用强类型 ShopItem。 */
        ShopItem si = net.Self() != null ? net.TypedShopAt(i) : null;
        if (si != null) { net.ShopBuyItem(si.Id, n); return; }
        if (i < 0 || i >= GameTables.current.shop.rows.Count) { return; }
        for (int k = 0; k < n; k = k + 1) { g.Shop(i); }
        Rebuild();
    }

    void BuildShop() {
        if (net.Self() != null) { net.MaybeRefreshShop(); }
        bool live = net.Self() != null && net.ShopCount() > 0;
        int total = live ? net.ShopCount() : GameTables.current.shop.rows.Count;
        int per = Spec.ShopPerPage();
        int cols = Spec.ShopCols();
        int pages = (total + per - 1) / per;
        if (pages < 1) { pages = 1; }
        if (shopPage >= pages) { shopPage = pages - 1; }
        if (shopPage < 0) { shopPage = 0; }

        Panel body = Panel.Column(); body.Class = "shop-page";
        body.Pad(0); body.Gap(0); body.Grow(); content.With(body);

        Panel top = Panel.Column(); top.Prefer(0, Spec.ShopTopPad()); body.With(top);

        /* 货币行：4 个 tab 左对齐；右端「激活码：」+ 输入框 + 「使用」
           （原版这一行横贯整个内容框，与卡片阵共用同一条基准线）。 */
        Panel curr = Panel.Row(); curr.Class = "shop-curr-row";
        curr.Pad(0); curr.Gap(Spec.ShopCurrGap());
        curr.Prefer(0, Spec.ShopCurrH()); body.With(curr);
        /* 左右内缩走 Padding，**不要**用首尾撑条：停靠容器给每个子项之间都算
           一份 Gap，首撑条也会被算成「撑条 + 缝」，实测货币行整体右移 9 设备
           （= 一个 ShopCurrGap），卡阵同理右移 21。 */
        curr.Padding(0, Spec.ShopCurrPadR(), 0, Spec.ShopCurrPadL());
        string[] cur = new string[] { "元宝", "金币", "推广币", "灵符" };
        for (int i = 0; i < 4; i = i + 1) {
            int pick = i;
            Panel tab = Panel.Row();
            tab.Class = i == shopPayTab ? "shop-curr shop-curr-on" : "shop-curr";
            tab.Pad(0); tab.Prefer(Spec.ShopCurrW(), Spec.ShopCurrH());
            tab.Named("shop-curr-" + Rules.N(i));
            tab.OnClick(() => { shopPayTab = pick; BuildPage(); Refresh(); });
            Label l = Text(cur[i], "shop-curr-text", 0);
            l.Grow(); tab.With(l);
            curr.With(tab);
        }
        Panel fill = Panel.Row(); fill.Class = "bag-fill"; curr.With(fill);
        Label ck = Text("激活码：", "shop-code-k", 0);
        ck.Prefer(Spec.ShopCodeKeyW(), Spec.ShopCurrH()); curr.With(ck);
        Input code = new Input(""); code.Prefer(Spec.ShopCodeW(), Spec.ShopCurrH());
        code.Named("shop-code"); curr.With(code);
        curr.With(BtnDev("使用", "shop-use", Spec.ShopUseW(), Spec.ShopCurrH(), null));

        Panel gap = Panel.Column(); gap.Prefer(0, Spec.ShopCurrToCard()); body.With(gap);

        /* 卡片阵：3 列定宽卡（不能用 Grid，会等分拉伸）。行给固定高，
           Grow 的行是 dock=5、会拿到同一份剩余矩形而重叠（同地图页）。 */
        int from = shopPage * per;
        int to = total < from + per ? total : from + per;
        int rows = (to - from + cols - 1) / cols;
        Panel wall = Panel.Column(); wall.Class = "shop-wall";
        wall.Pad(0); wall.Gap(Spec.ShopCardGapY()); body.With(wall);
        for (int r = 0; r < rows; r = r + 1) {
            Panel row = Panel.Row(); row.Class = "shop-row";
            row.Pad(0); row.Gap(Spec.ShopCardGapX());
            row.Prefer(0, Spec.ShopCardH()); wall.With(row);
            row.Padding(0, 0, 0, Spec.ShopPadL());
            for (int c = 0; c < cols; c = c + 1) {
                int i = from + r * cols + c;
                if (i >= to) { break; }
                row.With(ShopCard(i));
            }
        }

        /* 页脚贴页底：左「元宝：N」、右「兑换元宝」+ 标准库 Pagination。
           走 AnchorBottom */
        Panel footPad = Panel.Column(); footPad.Prefer(0, Spec.ShopFootPadB());
        footPad.AnchorBottom(); body.Add(footPad);
        Panel foot = Panel.Row(); foot.Class = "shop-foot";
        foot.Pad(0); foot.Gap(Spec.ShopCurrGap());
        foot.Prefer(0, Spec.ShopFootH());
        foot.AnchorBottom(); body.Add(foot);
        foot.Padding(0, Spec.ShopFootPadR(), 0, Spec.ShopFootPadL());
        PlayerState ps = net.SelfState();
        int yuan = ps != null ? Convert.ToInt32(ps.Ingots) : 0;
        Label wallet = Text("元宝：" + Rules.N(yuan), "shop-wallet", 0);
        wallet.Prefer(0, Spec.ShopFootH()); foot.With(wallet);
        Panel ffill = Panel.Row(); ffill.Class = "bag-fill"; foot.With(ffill);
        foot.With(BtnDev("兑换元宝", "shop-exch", Spec.ShopExchW(), Spec.ShopFootH(), null));
        SignalInt pgSig = new SignalInt(shopPage + 1);
        Pagination pg = new Pagination(pages, pgSig);
        /* simple = 「上一页 [1/2] 下一页」紧凑条，正是原版页脚的样子
           （非 simple 模式在只有 1 页时会退化成一个巨大方块）。 */
        pg.Class = "simple";
        pg.PrevText("上一页"); pg.NextText("下一页");
        pg.Named("shop-pager");
        pg.Change += () => {
            shopPage = pgSig.Get() - 1;
            BuildPage(); Refresh();
        };
        foot.With(pg);
    }

    Panel ShopLiveItemCard(ShopItem item, int slotIdx) {
        if (item == null) { return ShopCardItem(0, 0, "", slotIdx); }
        return ShopCardItem(item.Id, item.Price, item.Name, slotIdx);
    }

    Panel ShopCardItem(int itemId, int price, string name, int slotIdx) {
        Panel card = Panel.Row(); card.Class = "shop-card";
        card.Pad(0); card.Gap(Spec.ShopIconGap());
        card.Prefer(Spec.ShopCardW(), Spec.ShopCardH());
        card.Named("shop-card-" + Rules.N(slotIdx));
        card.With(SpacerW(Spec.ShopCardPadL()));

        Panel box = Panel.Row(); box.Class = "shop-icon";
        box.Pad(Spec.Px(1)); box.Prefer(Spec.ShopIconW(), Spec.ShopIconH());
        Image ic = new Image(ItemArtById(itemId), name, "contain");
        ic.Grow(); box.Add(ic);
        card.With(box);

        Panel col = Panel.Column(); col.Pad(0); col.Gap(Spec.ShopRowGap()); col.Grow(); card.With(col);

        Panel nameRow = Panel.Row(); nameRow.Class = "shop-name-row";
        nameRow.Pad(0); nameRow.Gap(0); nameRow.Prefer(0, Spec.ShopNameH());
        col.With(nameRow);
        Label nm = Text(name, "shop-name", 0);
        nameRow.With(nm);
        Panel priceP = Panel.Row(); priceP.Class = "shop-price";
        priceP.Pad(Spec.Px(2)); priceP.Gap(Spec.Px(2));
        priceP.Prefer(Spec.ShopPillW(), Spec.ShopPillH()); nameRow.With(priceP);
        Image coin = new Image(ShopCoinPath(false), "货币", "contain");
        coin.Prefer(Spec.ShopCoinW(), Spec.ShopCoinW()); priceP.With(coin);
        Label pv = Text(Rules.N(price), "shop-price-v", 0);
        pv.Grow(); priceP.With(pv);
        nameRow.With(SpacerW(Spec.ShopPillPadR()));

        Panel qty = Panel.Row(); qty.Class = "shop-qty";
        qty.Pad(0); qty.Gap(Spec.Px(3)); qty.Prefer(0, Spec.ShopQtyH()); col.With(qty);
        Label qk = Text("数量", "shop-qty-k", 0);
        qk.Prefer(Spec.ShopQtyKeyW(), 0); qty.With(qk);
        qty.With(BtnDev("+", "shop-num", Spec.ShopNumW(), Spec.ShopQtyH(),
            () => { ShopStep(slotIdx, 1); Rebuild(); }));
        Label qv = Text(Rules.N(ShopCount(slotIdx)), "shop-val", 0);
        qv.Prefer(Spec.ShopValW(), 0); qty.With(qv);
        qty.With(BtnDev("-", "shop-num", Spec.ShopNumW(), Spec.ShopQtyH(),
            () => { ShopStep(slotIdx, -1); Rebuild(); }));
        Panel qfill = Panel.Row(); qfill.Class = "shop-qty-fill"; qty.With(qfill);
        qty.With(BtnDev("购买", "shop-buy", Spec.ShopBuyW(), Spec.ShopQtyH(),
            () => { ShopBuy(slotIdx); }));
        card.With(SpacerW(Spec.ShopCardPadR()));
        return card;
    }

    /// 一张商品卡：图标石框 + 右上名称/价格 + 右下数量/购买。
    /// 在线 = 服务端 items 目录（金价胶囊，走强类型 ShopItem 实体）；离线 = shop.csv reward 语义。
    Panel ShopCard(int i) {
        ShopItem si = net.Self() != null ? net.TypedShopAt(i) : null;
        if (si != null) { return ShopCardItem(si.Id, si.Price, si.Name, i); }
        DataRow offer = GameTables.current.shop.rows[i];
        int yuan = offer.Int("yuan");
        int gold = offer.Int("gold");
        int iron = offer.Int("iron");

        Panel card = Panel.Row(); card.Class = "shop-card";
        card.Pad(0); card.Gap(Spec.ShopIconGap());
        card.Prefer(Spec.ShopCardW(), Spec.ShopCardH());
        card.Named("shop-card-" + Rules.N(i));
        card.With(SpacerW(Spec.ShopCardPadL()));

        Panel box = Panel.Row(); box.Class = "shop-icon";
        box.Pad(Spec.Px(1)); box.Prefer(Spec.ShopIconW(), Spec.ShopIconH());
        Image ic = new Image(ShopArtPath(offer.Text("reward")), offer.Text("name"), "contain");
        ic.Grow(); box.Add(ic);
        card.With(box);

        Panel col = Panel.Column(); col.Pad(0); col.Gap(Spec.ShopRowGap()); col.Grow(); card.With(col);

        /* 上行：名称（黄）+ 右端金边价格胶囊。名称要吃掉中间空档 →
           必须走 Flex 的 `flex-grow`：停靠路径里 `Grow()` 是 dock=5、会被
           排到最后并拿到整行矩形（实测踩过，见 gui-design skill 规则 7）。 */
        Panel nameRow = Panel.Row(); nameRow.Class = "shop-name-row";
        nameRow.Pad(0); nameRow.Gap(0); nameRow.Prefer(0, Spec.ShopNameH());
        col.With(nameRow);
        Label nm = Text(ShopTitle(offer.Text("name")), "shop-name", 0);
        nameRow.With(nm);
        Panel price = Panel.Row(); price.Class = "shop-price";
        price.Pad(Spec.Px(2)); price.Gap(Spec.Px(2));
        price.Prefer(Spec.ShopPillW(), Spec.ShopPillH()); nameRow.With(price);
        Image coin = new Image(ShopCoinPath(yuan > 0), "货币", "contain");
        coin.Prefer(Spec.ShopCoinW(), Spec.ShopCoinW()); price.With(coin);
        int amount = yuan > 0 ? yuan : (gold > 0 ? gold : iron);
        Label pv = Text(Rules.N(amount), "shop-price-v", 0);
        pv.Grow(); price.With(pv);
        nameRow.With(SpacerW(Spec.ShopPillPadR()));

        /* 下行：数量 + [值] + +/− + 购买。购买钮靠右用 .shop-qty-fill 撑，
           右缘与上行胶囊错开（原版购买钮更贴卡右）。 */
        Panel qty = Panel.Row(); qty.Class = "shop-qty";
        qty.Pad(0); qty.Gap(Spec.Px(3)); qty.Prefer(0, Spec.ShopQtyH()); col.With(qty);
        Label qk = Text("数量", "shop-qty-k", 0);
        qk.Prefer(Spec.ShopQtyKeyW(), 0); qty.With(qk);
        int idx = i;
        qty.With(BtnDev("+", "shop-num", Spec.ShopNumW(), Spec.ShopQtyH(),
            () => { ShopStep(idx, 1); Rebuild(); }));
        Label qv = Text(Rules.N(ShopCount(i)), "shop-val", 0);
        qv.Prefer(Spec.ShopValW(), 0); qty.With(qv);
        qty.With(BtnDev("-", "shop-num", Spec.ShopNumW(), Spec.ShopQtyH(),
            () => { ShopStep(idx, -1); Rebuild(); }));
        Panel qfill = Panel.Row(); qfill.Class = "shop-qty-fill"; qty.With(qfill);
        qty.With(BtnDev("购买", "shop-buy", Spec.ShopBuyW(), Spec.ShopQtyH(),
            () => { ShopBuy(idx); }));
        card.With(SpacerW(Spec.ShopCardPadR()));
        return card;
    }
}
