using System;
using Gui;
using Gui.Widget;
using Legend;

/// 页 14「祭坛」——照原版还原（`祭坛.png`）。
/// · 主窗左（724×715）：左 4 格 + 右 4 格「捐献档」方框夹着中央「圣坛之火」大图
/// （280×435），下方两行进度（我的进度 0/1000、祭坛进度 14230/8000）各带一个
/// 重置钮，左下 `祭坛捐献`/`玩法说明`、右下 `补领昨日`/`祭坛奖励`，底部
/// 12×3 道具格阵（原版只有第 1 格有 1 件道具）
/// · 右：功绩榜 10 行（头像 57×55 + `名字（巅峰N级）` + 绿色功绩数 + 进度条）
/// · 本页**没有页脚**（原版没有分页器，格阵直接贴窗口底）
/// 右栏面板与邮箱页（29）/沙巴克页（6）是同一块，尺寸引 `Spec.Side*`；道具格
/// 走 `Slots.zan` 的 `CellEmpty/SlotArt`；捐献档/进度行/榜单行是本页的组合（各页
/// 结构不同，不硬套表格组件）。
/// 已知偏差：中央「圣坛之火」的整图**素材库里没有**（把精灵区归一化后对 6000+
/// 张素材做过整体匹配，最好成绩 MAD 36.3、无区分度）。这里用尺寸最接近的
/// `ui/00266.jpg`（279×439，传说塔那张）占位，**内容是错的**，等补图后只换
/// `AltarArtPath()` 一处即可。
partial class LegendApp {

    /// 圣坛之火大图（原版那张没导出，见文件头"已知偏差"）。
    static string AltarArtPath() { return "assets/ui/00266.jpg"; }

    /// 一档捐献：框内两行——道具名（对上原版编号）+ `N进度+M`。
    class AltarSlot {
        int order;
        string name;
        int gain;
    }

    static AltarSlot AltarSlotOf(int order, string name, int gain) {
        AltarSlot s = new AltarSlot();
        s.order = order; s.name = name; s.gain = gain;
        return s;
    }

    /// 左列 4 档（照图：③ 天书 +1、⑦ 一级宝石 +1——原版编号不按版面位置排）。
    static List<AltarSlot> AltarLeft() {
        List<AltarSlot> v = new List<AltarSlot>();
        v.Add(AltarSlotOf(1, "金条×1", 1));
        v.Add(AltarSlotOf(2, "金砖×1", 2));
        v.Add(AltarSlotOf(3, "天书×1", 1));
        v.Add(AltarSlotOf(7, "一级宝石", 1));
        return v;
    }

    /// 右列 4 档（第 4 格是「批量捐献」+ 数值输入框，单独画）。
    static List<AltarSlot> AltarRight() {
        List<AltarSlot> v = new List<AltarSlot>();
        v.Add(AltarSlotOf(4, "黑铁×500", 4));
        v.Add(AltarSlotOf(5, "100元宝×1", 5));
        v.Add(AltarSlotOf(6, "1000元宝×1", 50));
        return v;
    }

    /// 功绩榜一行（名字 / 等级 / 功绩 / 条长占比 / 条色档）。
    class AltarRank {
        string name;
        int level;
        int merit;
        int ratio;  // 0..100（相对榜首）
        int tone;  // 1..10 → `.alt-bar-N`
        string face;  // 头像素材
    }

    static AltarRank AltarRankOf(string name, int level, int merit, int ratio,
                                 int tone, string face) {
        AltarRank r = new AltarRank();
        r.name = name; r.level = level; r.merit = merit;
        r.ratio = ratio; r.tone = tone; r.face = face;
        return r;
    }

    /// 功绩榜数据：全面消费服务端真实排行（RankItem）实体，消除假玩家硬编码。
    List<AltarRank> AltarRankData() {
        List<AltarRank> v = new List<AltarRank>();
        int cnt = net.RankCount();
        if (cnt > 0) {
            RankItem top = net.TypedRankAt(0);
            long topVal = top != null && top.Exp > 0 ? (top.Exp / 100000000) : 1;
            if (topVal < 1) { topVal = 1; }
            for (int i = 0; i < cnt && i < 10; i = i + 1) {
                RankItem rk = net.TypedRankAt(i);
                if (rk == null) { continue; }
                long mVal = rk.Exp / 100000000;
                int ratio = (int)(mVal * 100 / topVal);
                if (ratio > 100) { ratio = 100; }
                if (ratio < 5) { ratio = 5; }
                int tone = i + 1;
                if (tone > 10) { tone = 10; }
                string face = "000" + Rules.N(43 + i % 6);
                v.Add(AltarRankOf(rk.Name, rk.Level, (int)mVal, ratio, tone, face));
            }
        } else if (g != null) {
            v.Add(AltarRankOf("本地玩家", g.level, g.NeedXp() / 10000, 100, 1, "00045"));
        }
        return v;
    }

    void BuildAltarPage() {
        if (net.Self() != null) {
            net.MaybeRefreshAltar();
            net.RefreshRank();
        }
        Panel frame = Panel.Row(); frame.Class = "bh-frame";
        frame.Pad(0); frame.Gap(Spec.BhColGap());
        frame.Prefer(0, Spec.BhFrameH());
        frame.Padding(Spec.BhFramePadT(), 0, 0, 0);
        content.With(frame);
        frame.With(AltarMain());
        frame.With(AltarRankSide());
    }

    // 左：捐献档 + 圣坛之火 + 进度行 + 道具格阵

    Panel AltarMain() {
        Panel col = Panel.Column(); col.Class = "mk-left mk-fixed";
        col.Pad(0); col.Gap(0); col.Prefer(Spec.BhMainW(), 0);

        col.With(TblPad(Spec.AlTopPad()));
        col.With(AltarBand());
        col.With(AltarOps());
        col.With(TblPad(Spec.AlGridPadT()));
        col.With(AltarGrid());
        return col;
    }

    /// 中带：左 tab 列 + 圣坛之火大图 + 右 tab 列（三者顶对齐）。
    Panel AltarBand() {
        Panel band = Panel.Row(); band.Pad(0); band.Gap(0);
        band.Prefer(0, Spec.AlArtH());
        band.With(SpacerW(Spec.AlTabPadL()));
        band.With(AltarSlotCol(AltarLeft(), -1));
        band.With(SpacerW(Spec.AlArtGapL()));
        Panel art = Panel.Column(); art.Class = "alt-art";
        art.Pad(0); art.Prefer(Spec.AlArtW(), Spec.AlArtH());
        Image img = new Image(AltarArtPath(), "圣坛之火", "cover");
        img.Grow(); art.Add(img);
        band.With(art);
        band.With(SpacerW(Spec.AlArtGapR()));
        band.With(AltarSlotCol(AltarRight(), 1));
        return band;
    }

    /// 一列捐献档（4 格；`qty` > 0 时末格换成「批量捐献 + 输入框」）。
    Panel AltarSlotCol(List<AltarSlot> slots, int qty) {
        Panel col = Panel.Column(); col.Pad(0); col.Gap(Spec.AlTabGap());
        col.Prefer(Spec.AlTabW(), 0);
        for (int i = 0; i < slots.Count; i = i + 1) {
            col.With(AltarSlotBox(slots[i]));
        }
        if (qty > 0) { col.With(AltarBatchBox()); }
        return col;
    }

    /// 捐献档的在线动作：order 1=金条→金币档 / 4=黑铁→矿石档 /
    /// 5=100元宝 / 6=1000元宝（大额档）——服务端 altar op 的四种捐献；
    /// 其余档位（金砖/天书/宝石）服务端无对应语义，保持诚实反馈。
    void AltarDonateSlot(AltarSlot s) {
        if (net.Self() == null) {
            AltarSay("捐献 " + s.name + "：进度 +" + Rules.N(s.gain));
            return;
        }
        if (s.order == 1) { net.AltarDonate("gold"); return; }
        if (s.order == 4) { net.AltarDonate("iron"); return; }
        if (s.order == 5) { net.AltarDonate("yuan"); return; }
        if (s.order == 6) { net.AltarDonate("large"); return; }
        AltarSay("捐献 " + s.name + "：该档位暂无服务端通道。");
    }

    Panel AltarSlotBox(AltarSlot s) {
        Panel box = Panel.Column(); box.Class = "alt-tab";
        box.Pad(0); box.Gap(0); box.Prefer(Spec.AlTabW(), Spec.AlTabH());
        box.Named("alt-tab-" + Rules.N(s.order));
        box.OnClick(() => { AltarDonateSlot(s); });
        Panel l1 = Panel.Row(); l1.Class = "alt-tab-row"; l1.Pad(0);
        l1.Prefer(0, Spec.Px(21)); l1.With(Text(s.name, "alt-tab-n", 0));
        box.With(l1);
        Panel l2 = Panel.Row(); l2.Class = "alt-tab-row"; l2.Pad(0);
        l2.Prefer(0, Spec.Px(21));
        l2.With(Text(AltarOrderMark(s.order) + "进度+" + Rules.N(s.gain),
            "alt-tab-g", 0));
        box.With(l2);
        return box;
    }

    /// 原版编号用的是带圈数字（①…⑦）。
    static string AltarOrderMark(int order) {
        string[] marks = new string[] {
            "①", "②", "③", "④", "⑤", "⑥", "⑦"
        };
        if (order < 1 || order > 7) { return ""; }
        return marks[order - 1];
    }

    /// 「批量捐献」格：品红标签 + 蓝色数值框（原版值 1）。
    Panel AltarBatchBox() {
        Panel box = Panel.Column(); box.Class = "alt-tab";
        box.Pad(0); box.Gap(0); box.Prefer(Spec.AlTabW(), Spec.AlTabH());
        Panel l1 = Panel.Row(); l1.Class = "alt-tab-row"; l1.Pad(0);
        l1.Prefer(0, Spec.Px(21)); l1.With(Text("批量捐献", "alt-batch", 0));
        box.With(l1);
        Panel l2 = Panel.Row(); l2.Pad(0); l2.Prefer(0, Spec.Px(21));
        Input qty = new Input("数量");
        qty.Class = "alt-input";
        qty.Prefer(Spec.Px(57), Spec.Px(19));
        qty.SetText("1");
        l2.With(qty);
        box.With(l2);
        return box;
    }

    /// 进度两行 + 左右各一个双行按钮框。
    /// 进度两行 + 左右各一个双行按钮框。在线 = altar 应答：
    /// 我的进度 personal/cap（兑换重置=claim）、祭坛进度 global/worldCap。
    Panel AltarOps() {
        string mineText = "0/1000";
        string worldText = "0/8000";
        AltarState a = net.Self() != null ? net.TypedAltar() : null;
        if (a != null) {
            mineText = Rules.N(a.Personal) + "/" + Rules.N(a.Cap);
            worldText = Rules.N(a.GlobalProgress) + "/" + Rules.N(a.GlobalCap);
        }
        Panel row = Panel.Row(); row.Pad(0); row.Gap(0);
        row.Prefer(0, Spec.AlOpsBtnH());
        row.With(SpacerW(Spec.AlOpsPadL()));
        row.With(AltarTwinBtn("祭坛捐献", "玩法说明", () => {
            AltarSay("祭坛捐献：投入金条/黑铁/元宝提升进度，增益打怪收益 ×1.1。");
        }, () => {
            AltarSay("祭坛玩法：个人进度到线后「兑换重置」领取奖励。");
        }));
        row.With(SpacerW(Spec.AlOpsGap()));
        Panel kvs = Panel.Column(); kvs.Pad(0); kvs.Gap(Spec.Px(1));
        kvs.Prefer(Spec.AlKvLabelW() + Spec.AlKvKvGap() + Spec.AlKvBoxW()
            + Spec.AlKvBtnGap() + Spec.AlKvBtnW(), 0);
        kvs.With(AltarKv("我的进度:", mineText, "alt-kv-k1", "兑换重置",
            () => {
                if (net.Self() != null) { net.AltarClaim(); return; }
                AltarSay("兑换重置：把已投入的祭坛进度兑换成奖励。");
            }));
        kvs.With(AltarKv("祭坛进度:", worldText, "alt-kv-k2", "重置幻境",
            () => { AltarSay("重置幻境：服务端暂无幻境重置语义。"); }));
        row.With(kvs);
        Panel fill = Panel.Row(); fill.Grow(); row.With(fill);
        row.With(AltarTwinBtn("补领昨日", "祭坛奖励", () => {
            AltarSay("补领昨日：补领昨日未领的祭坛奖励。");
        }, () => {
            AltarSay("祭坛奖励：查看祭坛进度奖励表。");
        }));
        row.With(SpacerW(Spec.AlOpsPadL()));
        return row;
    }

    /// 一个双行按钮框（原版是一个框里两行青字；这里拆成两个同宽钮叠放）。
    Panel AltarTwinBtn(string top, string bottom, Action a, Action b) {
        Panel col = Panel.Column(); col.Pad(0); col.Gap(Spec.Px(1));
        col.Prefer(Spec.AlOpsBtnW(), 0);
        int half = Spec.AlOpsBtnH() / 2 - 1;
        col.With(BtnDev(top, "alt-btn", Spec.AlOpsBtnW(), half, a));
        col.With(BtnDev(bottom, "alt-btn", Spec.AlOpsBtnW(), half, b));
        return col;
    }

    /// 「标签: 值框 按钮」一行。
    Panel AltarKv(string k, string v, string kCls, string btn, Action a) {
        Panel row = Panel.Row(); row.Pad(0); row.Gap(0);
        row.Prefer(0, Spec.AlKvH());
        Panel kl = Panel.Row(); kl.Pad(0); kl.Prefer(Spec.AlKvLabelW(), Spec.AlKvH());
        kl.With(Text(k, "alt-kv-k " + kCls, 0)); row.With(kl);
        row.With(SpacerW(Spec.AlKvKvGap()));
        Panel box = Panel.Row(); box.Class = "alt-kv-box";
        box.Pad(0); box.Prefer(Spec.AlKvBoxW(), Spec.AlKvH());
        box.With(Text(v, "alt-kv-v", 0)); row.With(box);
        row.With(SpacerW(Spec.AlKvBtnGap()));
        row.With(BtnDev(btn, "alt-btn", Spec.AlKvBtnW(), Spec.AlKvH(), a));
        return row;
    }

    /// 底部 12×3 道具格阵（原版只有第 1 格有 1 件道具）。
    Panel AltarGrid() {
        Panel col = Panel.Column(); col.Pad(0); col.Gap(Spec.AlGridRowGap());
        col.Padding(0, 0, 0, Spec.AlGridPadL());
        for (int r = 0; r < Spec.AlGridRows(); r = r + 1) {
            Panel row = Panel.Row(); row.Pad(0); row.Gap(Spec.AlGridColGap());
            row.Prefer(0, Spec.AlGridSlotH()); col.With(row);
            for (int c = 0; c < Spec.AlGridCols(); c = c + 1) {
                bool first = r == 0 && c == 0;
                if (first) {
                    row.With(SlotArt(Spec.AlGridSlotW(), Spec.AlGridSlotH(),
                        ItemArtPath(11), "1", "slot-badge"));
                } else {
                    row.With(CellEmpty(Spec.AlGridSlotW(), Spec.AlGridSlotH()));
                }
            }
        }
        return col;
    }

    // 右：功绩榜

    Panel AltarRankSide() {
        Panel col = Panel.Column(); col.Class = "bh-side mk-fill";
        col.Pad(0); col.Gap(Spec.Px(1));
        col.Padding(Spec.AlRankPadT(), 0, 0, 0);
        List<AltarRank> rows = AltarRankData();
        for (int i = 0; i < Spec.AlRankRows(); i = i + 1) {
            if (i < rows.Count) { col.With(AltarRankRow(rows[i], i)); }
        }
        return col;
    }

    Panel AltarRankRow(AltarRank r, int i) {
        Panel row = Panel.Row(); row.Class = "alt-rank";
        row.Pad(0); row.Gap(Spec.Px(4));
        row.Prefer(0, Spec.AlRankRowH());
        Panel ava = Panel.Row(); ava.Class = i == 0 ? "alt-ava alt-ava-1" : "alt-ava";
        ava.Pad(0); ava.Prefer(Spec.AlRankAvaW(), Spec.AlRankAvaH());
        Image face = new Image("assets/ui/" + r.face + ".jpg", r.name, "cover");
        face.Grow(); ava.Add(face);
        row.With(ava);
        Panel info = Panel.Column(); info.Pad(0); info.Gap(0); info.Grow();
        Panel l1 = Panel.Row(); l1.Pad(0); l1.Gap(0);
        l1.Prefer(0, Spec.Px(15)); info.With(l1);
        l1.With(Text(r.name + "（巅峰" + Rules.N(r.level) + "级）", "alt-name", 0));
        Panel sp = Panel.Row(); sp.Grow(); l1.With(sp);
        l1.With(Text(Rules.N(r.merit), "alt-merit", 0));
        l1.With(Text("进度", "alt-merit", 0));
        info.With(AltarBar(r));
        row.With(info);
        return row;
    }

    /// 进度条：固定轨宽 + 按占比撑出的填充（占比按榜首归一）。
    Panel AltarBar(AltarRank r) {
        Panel track = Panel.Row(); track.Class = "alt-bar";
        track.Pad(0); track.Prefer(Spec.AlRankBarW(), Spec.AlRankBarH());
        int w = Spec.AlRankBarW() * r.ratio / 100;
        if (w < 1) { w = 1; }
        Panel fill = Panel.Row(); fill.Class = "alt-bar-fill alt-bar-" + Rules.N(r.tone);
        fill.Pad(0); fill.Prefer(w, Spec.AlRankBarH());
        track.With(fill);
        return track;
    }

    /// 玩法未接：按本模板惯例给一句明确反馈。
    void AltarSay(string msg) {
        if (net.Self() != null) { net.AddChat("[系统]", msg); return; }
        g.Log(msg);
    }
}
