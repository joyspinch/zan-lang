using System;
using Gui;
using Gui.Widget;
using Legend;

/// 通用「格子」组件——装备格 / 物品栏 / 掉落格 / 宝石位 / 技能图标全走这里。
/// 一个格子 = 外框（底色与边框由 CSS 类给）+ 图标 +（可选）左上角小字。
/// 小字按原版语义取：装备是**强化等级**（原版背包格里的 +5/+10），
/// 消耗品是**堆叠数量**（166/162）。同一个位置只显示一个。
/// 两条布局纪律（都是实测踩出来的）：
/// 1. 图标必须**撑满内容框**（`Grow`），不能按外框尺寸 `Prefer`
/// ——外框比内容框大一圈边框，按外框给尺寸的图标会压到格线上
/// （掉落格实测：图标盖住格线，看着像格子大小不一）。
/// 2. 数量角标用 `Float` **叠**在左上角；占一整行会把
/// 图标挤小，而原版是压在图标上的。
/// 格子只认「道具号 + 数量」，不认识背包/掉落/仓库这些来源——调用方
/// 自己决定填什么，这样同一套皮在任何页面都不会走样。
partial class LegendApp {
    /// 图标相对外框的内缩：正好一个 CSS 边框宽（外框画在盒子边缘）。
    static int SlotInset() { return Spec.Px(1); }

    /// 道具图标路径：items.csv 的 picture → assets/item/NNNNN.png。
    /// 00002.png 是 art.csv 里的空白占位图，缺图一律落它（画出来是空格）。
    static string ItemArtPath(int picture) {
        if (picture <= 0) { return "assets/item/00002.png"; }
        string path = "assets/item/" + Rules.N(picture).PadLeft(5, "0") + ".png";
        if (System.IO.File.Exists(path)) { return path; }
        return "assets/item/00002.png";
    }

    /// 道具号 → 图标路径（按 items.csv 的 picture 列）。
    static string ItemArtById(int itemId) {
        if (itemId <= 0) { return "assets/item/00002.png"; }
        return ItemArtPath(GameTables.current.ItemPicture(itemId));
    }

    /// 角标文案：装备 +强化 优先，其次 ×堆叠（原版背包格里 `+5` 黄、`166` 白）。
    static string SlotBadge(Equipment e, int count) {
        if (e != null) {
            if (e.upgrade > 0) { return "+" + Rules.N(e.upgrade); }
            if (e.coefficient > 1) { return Rules.N(e.coefficient); }
            if (count > 1) { return Rules.N(count); }
            return "";
        }
        if (count > 1) { return Rules.N(count); }
        return "";
    }

    /// 角标配色：强化黄、堆叠白（原版实测）。
    static string SlotBadgeCls(Equipment e) {
        return (e != null && e.upgrade > 0) ? "slot-badge slot-badge-up" : "slot-badge";
    }

    /// 空格子：只有外框（原版没道具的位置也是画了框的）。
    static Panel SlotBox(string cls, int wDevice, int hDevice) {
        Panel s = Panel.Row(); s.Class = cls;
        s.Pad(0); s.Prefer(wDevice, hDevice);
        return s;
    }

    /// 道具格子：外框 + 图标撑满内容框 + 左上角角标。`artPath` 为空时**不挂
    /// Image**——挂一个空 `Src` 的图会走占位分支，把 `Alt`（"道具"）画在格子
    /// 正中；空格的语义是「只有框」，任何字都是多余的。
    Panel ItemSlot(string cls, int wDevice, int hDevice,
                   string artPath, string badge) {
        Panel s = Panel.Row(); s.Class = cls;
        s.Pad(SlotInset()); s.Prefer(wDevice, hDevice);
        if (artPath.Length > 0) {
            Image ic = new Image(artPath, "道具", "contain");
            ic.Grow(); s.Add(ic);
        }
        if (badge.Length > 0) {
            Label t = Text(badge, "slot-badge", 0);
            t.Float(SlotInset(), 0);
            t.Prefer(0, Spec.Px(11));
            s.Add(t);
        }
        return s;
    }

    /// **只叠道具**的格位——底图（立绘整图 / 物品栏整图）里已经画好格框时用。
    /// 自带底色或边框会把底图的框盖掉，所以这里只有图标 + 角标，透明底。
    Panel SlotArt(int wDevice, int hDevice, string artPath, string badge, string badgeCls) {
        Panel s = Panel.Row(); s.Pad(0); s.Prefer(wDevice, hDevice);
        if (artPath.Length > 0) {
            Image ic = new Image(artPath, "道具", "contain");
            ic.Grow(); s.Add(ic);
        }
        if (badge.Length > 0) {
            Label t = Text(badge, badgeCls.Length > 0 ? badgeCls : "slot-badge", 0);
            t.Float(0, 0);
            t.Prefer(0, Spec.Px(11));
            s.Add(t);
        }
        return s;
    }

    /// 装备对象 → 叠在立绘空格框里的道具（e == null 就是纯空框，什么都不加）。
    Panel EquipArt(int wDevice, int hDevice, Equipment e) {
        if (e == null) { return SlotArt(wDevice, hDevice, "", "", ""); }
        return SlotArt(wDevice, hDevice, ItemArtById(e.definitionId),
            SlotBadge(e, 1), SlotBadgeCls(e));
    }

    /// **带格框精灵**的格子：底 = `00211.png`（原版通用物品格子，45×43
    /// 石质斜边），叠道具图标 + 左上角角标。物品栏 / 取出格 / 宝石格 /
    /// 技能格全用它——原版这些格子的像素就是这张图拉伸出来的。
    Panel SpriteCell(string cls, int wDevice, int hDevice,
                     string artPath, string badge, string badgeCls) {
        return SpriteCellAt(cls, wDevice, hDevice, artPath, badge, badgeCls, 0, 0);
    }

    /// 同 SpriteCell，但角标从格子左上角再内缩 (bx, by) 设备像素——交易市场
    /// 的角标画在格框斜边里侧（内缩 10×12），物品栏的贴角（0,0）。
    Panel SpriteCellAt(string cls, int wDevice, int hDevice,
                       string artPath, string badge, string badgeCls, int bx, int by) {
        Panel s = Panel.Row();
        if (cls.Length > 0) { s.Class = cls; }
        s.Pad(0); s.Prefer(wDevice, hDevice);
        Image bg = new Image(CellEmptyPath(), "格底", "stretch");
        bg.Grow(); s.Add(bg);
        if (artPath.Length > 0) {
            Image ic = new Image(artPath, "道具", "contain");
            ic.Grow(); s.Add(ic);
        }
        if (badge.Length > 0) {
            Label t = Text(badge, badgeCls.Length > 0 ? badgeCls : "slot-badge", 0);
            t.Float(bx, by);
            t.Prefer(0, Spec.Px(11));
            s.Add(t);
        }
        return s;
    }

    /// 装备对象 → 带格框精灵的格子（e == null 就是纯空格框）。
    Panel EquipCell(string cls, int wDevice, int hDevice, Equipment e) {
        if (e == null) { return SpriteCell(cls, wDevice, hDevice, "", "", ""); }
        return SpriteCell(cls, wDevice, hDevice, ItemArtById(e.definitionId),
            SlotBadge(e, 1), SlotBadgeCls(e));
    }

    /// 道具号 → 带格框精灵的格子（itemId <= 0 出空格框）。
    Panel ItemCellById(string cls, int wDevice, int hDevice, int itemId, int count) {
        if (itemId <= 0) { return SpriteCell(cls, wDevice, hDevice, "", "", ""); }
        return SpriteCell(cls, wDevice, hDevice, ItemArtById(itemId),
            count > 1 ? Rules.N(count) : "", "slot-badge");
    }

    /// 按道具号出格子（picture <= 0 出空格）。
    Panel ItemSlotById(string cls, int wDevice, int hDevice, int itemId, int count) {
        if (itemId <= 0) { return SlotBox(cls, wDevice, hDevice); }
        return ItemSlot(cls, wDevice, hDevice, ItemArtById(itemId),
            count > 1 ? Rules.N(count) : "");
    }

    /// 按装备对象出格子：e == null 出空环格；否则走品级色精灵。
    Panel EquipSlot(int wDevice, int hDevice, Equipment e, int quality) {
        if (e == null) { return RingEmpty(wDevice, hDevice); }
        return RingCell(wDevice, hDevice, ItemArtById(e.definitionId),
            SlotBadge(e, 1), quality);
    }

    /// **格框精灵路径**（实测像素为准；`tools/minimir/ui_index_map.csv`
    /// 的 `module_guess` 字段只是猜的——见 REFERENCE_AUDIT §11.0）：
    /// - **`00083.jpg` (488×249 = 5×8 = 40 物品格整图)** — **6×6 物品
    /// 栏的整张底图**。`stretch` 撑满中段 grid 区，5×8 自然形成网格
    /// 视觉，省掉 36 个单格拼装。
    /// - **`00082.jpg` (488×249)** — 同 5×8 = 40 格的暗红变体（页
    /// 9 排行榜 / 23 图鉴列表的整图底）。
    /// - **`00211.png` (45×43)** — 单个物品格（用户提到的「石头底」）。
    /// - `00063.png` (72×70) — 排行榜行（大格）背景。
    /// - `00132/00134.png` (735×30) — 焦点/选中标志（通用）。
    static string BagGridPath() { return "assets/ui/00083.jpg"; }
    static string TableGridPath() { return "assets/ui/00082.jpg"; }
    static string CellEmptyPath() { return "assets/ui/00211.png"; }
    /// 未开孔位的锁精灵（宝石页每行 4 个锁位用它，实测原版就是挂在
    /// 格子上的锁，不是空框）。
    static string LockPath() { return "assets/ui/00255.png"; }
    static string BigRarityPath(int quality) {
        int n = 61;
        if (quality == 2) { n = 62; }
        else if (quality == 3) { n = 63; }
        else if (quality >= 4) { n = 64; }
        return "assets/ui/" + Rules.N(n).PadLeft(5, "0") + ".png";
    }
    static string FocusPath() { return "assets/ui/00132.png"; }

    /// 6×6 物品栏底图：`00083.jpg`（5×8 = 40 格整图）`stretch` 撑满。
    /// 调用方给定 6×6 中段的实际宽高（device 像素），就拿到一张完整网格
    /// 视觉的底图。原版 背包-技能.png 内的 6×6 区域像素分布与 00083
    /// 拉伸到同尺寸后一致。
    static Panel BagGrid(int wDevice, int hDevice) {
        Panel s = Panel.Row(); s.Pad(0); s.Prefer(wDevice, hDevice);
        Image bg = new Image(BagGridPath(), "包裹", "stretch");
        bg.Grow(); s.Add(bg);
        return s;
    }

    /// 表格整图底：5×8 grid（488×249）`stretch` 撑满表格区。排行榜 /
    /// 图鉴 / 邮箱等列表都用。
    static Panel TableGrid(int wDevice, int hDevice) {
        Panel s = Panel.Row(); s.Pad(0); s.Prefer(wDevice, hDevice);
        Image bg = new Image(TableGridPath(), "表", "stretch");
        bg.Grow(); s.Add(bg);
        return s;
    }

    /// 单个空物品格底图（`00211.png`）—— 现在 6×6 整图已用 BagGrid，
    /// 不再需要单格；如果个别弹窗/小窗口仍要 1×1 格再用。
    static Panel CellEmpty(int wDevice, int hDevice) {
        Panel s = Panel.Row(); s.Pad(0); s.Prefer(wDevice, hDevice);
        Image bg = new Image(CellEmptyPath(), "格", "stretch");
        bg.Grow(); s.Add(bg);
        return s;
    }

    /// 装备环空格：单格 `00211.png`（人物立绘两侧 6 个大环，每环独立）。
    /// 已被整图 00009/00010.jpg（人物+6 环压好）替代，保留以备个别页用。
    static Panel RingEmpty(int wDevice, int hDevice) {
        Panel s = Panel.Row(); s.Pad(0); s.Prefer(wDevice, hDevice);
        Image bg = new Image(CellEmptyPath(), "格", "stretch");
        bg.Grow(); s.Add(bg);
        return s;
    }

    /// 物品格（带图标 + 角标）：底 = `00211.png`，叠图标 + 角标。
    Panel ItemCell(int wDevice, int hDevice,
                  string artPath, string badge, int quality) {
        Panel s = Panel.Row(); s.Pad(0); s.Prefer(wDevice, hDevice);
        Image bg = new Image(CellEmptyPath(), "格底", "stretch");
        bg.Grow(); s.Add(bg);
        Image ic = new Image(artPath, "道具", "contain");
        ic.Grow(); s.Add(ic);
        if (badge.Length > 0) {
            Label t = Text(badge, "slot-badge", 0);
            t.Float(SlotInset(), 0);
            t.Prefer(0, Spec.Px(11));
            s.Add(t);
        }
        return s;
    }

    /// 大格（装备环 / 宝石 / 技能）。
    Panel RingCell(int wDevice, int hDevice,
                   string artPath, string badge, int quality) {
        Panel s = Panel.Row(); s.Pad(0); s.Prefer(wDevice, hDevice);
        Image bg = new Image(BigRarityPath(quality), "品级", "stretch");
        bg.Grow(); s.Add(bg);
        Image ic = new Image(artPath, "道具", "contain");
        ic.Grow(); s.Add(ic);
        if (badge.Length > 0) {
            Label t = Text(badge, "slot-badge", 0);
            t.Float(SlotInset(), 0);
            t.Prefer(0, Spec.Px(11));
            s.Add(t);
        }
        return s;
    }
}
