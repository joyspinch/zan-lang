using System;
using Game.Audio;
using Game.Foundation;
using Gui;

// 应用层外壳：程序化音效 + 静音偏好。只由场景（视图层）调用——
// SnGame 的模拟步进从不碰音频，无头回放（SnakeSim）根本不建它。
public class SnShell {
    AudioBus bus;
    SfxBank sfx;
    Profile prof;

    static SnShell Create(Profile prof) {
        SnShell s = new SnShell();
        s.prof = prof;
        s.bus = new AudioBus();
        s.sfx = new SfxBank(s.bus);
        s.sfx.AddPresets(new string[] { "click", "success" });
        // 蛇蛇乐自己的声音：清脆短促的吞豆"啵"、长一截的狂热上扬、
        // 低沉的冲刺呼啸、对手炸成能量豆的闷爆、阵亡下滑。
        s.sfx.AddSynth("eat", SfxPresets.Coin().WithSweep(1180.0, 1980.0).WithDuration(0.040).WithGain(0.10));
        s.sfx.AddSynth("fever", SfxPresets.PowerUp().WithSweep(392.0, 1568.0).WithDuration(0.38));
        s.sfx.AddSynth("boost", SfxPresets.Launch().WithSweep(150.0, 480.0).WithDuration(0.14));
        s.sfx.AddSynth("kill", SfxPresets.Explode().WithDuration(0.16));
        s.sfx.AddSynth("death", SfxPresets.Fail().WithDuration(0.55));
        // 道具拾取的上行琶音、护盾碎裂的高频碎响、威胁升级的低沉警报。
        s.sfx.AddSynth("power", SfxPresets.PowerUp().WithSweep(660.0, 1760.0).WithDuration(0.22).WithGain(0.8));
        s.sfx.AddSynth("shield", SfxPresets.Hit().WithSweep(2200.0, 600.0).WithDuration(0.25));
        s.sfx.AddSynth("alarm", SfxPresets.Error().WithSweep(220.0, 330.0).WithDuration(0.30).WithGain(0.7));
        s.sfx.AddSynth("select", SfxPresets.Select().WithDuration(0.08));
        s.bus.SetSfxMuted(prof.Muted());
        s.sfx.Warm();
        return s;
    }

    bool Muted() { return this.bus.IsSfxMuted(); }

    void ToggleMute() {
        bool muted = !this.bus.IsSfxMuted();
        this.bus.SetSfxMuted(muted);
        this.prof.SetMuted(muted);
        this.Play("click");
    }

    // 每帧推进音效限频冷却（各场景 Update 里调）。
    void Tick(int dtMs) { this.bus.Update(dtMs); }

    void Play(string name) { this.sfx.Play(name); }

    // HTML 场景回填文案：<p>/<h1> 装载成 Typography 而不是 Element，
    // 统一按 id 找控件、SetProp("text") 改字，找不到就跳过。
    static void Text(Control root, string id, string t) {
        if (root == null) { return; }
        Control c = root.Find(id);
        if (c != null) { c.SetProp("text", t); }
    }
    void Play(string name, double gain, int cooldownMs) { this.sfx.Play(name, gain, cooldownMs); }
}
