using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class SnMenuScene : HtmlScene {
    SnGame g;
    Element stats;
    string bgPath;
    string titlePath;

    SnMenuScene(SnGame g) { this.g = g; }

    override string HtmlFile() { return "assets/scenes/menu.html"; }

    // 真美术层：背景与标题图画在画布上，HTML 层只留文字与按钮。
    // HTML 引擎不支持 url() 背景图，图片只能走画布这条道。
    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        int vw = SnGame.VW();
        int vh = SnGame.VH();
        CDraw.Clear(c, vw, vh, CDraw.Argb(255, 6, 12, 24));
        if (this.bgPath == null) { this.bgPath = Assets.Find("assets/menu_bg.png"); }
        if (this.titlePath == null) { this.titlePath = Assets.Find("assets/title.png"); }
        if (this.bgPath != null) {
            // 背景按 cover 铺满：裁源取景，不拉伸变形也不留黑边。
            int iw = Canvas.ImageWidth(this.bgPath);
            int ih = Canvas.ImageHeight(this.bgPath);
            if (iw > 0 && ih > 0) {
                int sx = 0;
                int sy = 0;
                int sw = iw;
                int sh = ih;
                if (iw * vh > ih * vw) {
                    sw = ih * vw / vh;
                    sx = (iw - sw) / 2;
                } else {
                    sh = iw * vh / vw;
                    sy = (ih - sh) / 2;
                }
                CDraw.BlitImageSrc(c, this.bgPath, 0, 0, vw, vh, sx, sy, sw, sh);
            }
        }
        if (this.titlePath != null) {
            int iw = Canvas.ImageWidth(this.titlePath);
            int ih = Canvas.ImageHeight(this.titlePath);
            if (iw > 0 && ih > 0) {
                int tw = vw * 2 / 5;
                int th = tw * ih / iw;
                CDraw.BlitImage(c, this.titlePath, (vw - tw) / 2, vh / 7, tw, th);
            }
        }
    }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("start", () => this.router.Go("play"));
    }

    override void OnEnter(Control root) {
        this.stats = null;
        if (root != null) {
            Control el = root.Find("stats");
            if (el != null && el is Element) { this.stats = (Element)el; }
        }
        if (this.stats != null) {
            this.stats.SetText("最高分 " + this.g.prof.high + " · 最长 " + this.g.prof.longest
                + " · 累计击败 " + this.g.prof.kills);
        }
    }

    override void Event(int kind, int key) {
        if (kind != 4) { return; }
        if (key == 27) { this.router.Exit(); }
        if (key == 13 || key == 32) { this.router.Go("play"); }
    }
}

// 对局：纯 canvas 场景（HtmlFile 为空，无边画布世界直绘）。
// 转向跟随鼠标，按住左键/空格冲刺；死亡后路由到结算场景。
