using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

// 主菜单：画布画插画背景与标题，HTML 放标语、开始按钮、皮肤选择卡与战绩。
// 皮肤按钮是标准 Button：已解锁 = 色板渐变底，锁住 = disabled 并显示解锁条件，
// 当前选中加白框；选择写进档案（Profile.SetSkin）。
public class SnMenuScene : HtmlScene {
    SnGame g;
    Control root;
    string bgPath;
    string titlePath;

    SnMenuScene(SnGame g) { this.g = g; }

    override string HtmlFile() { return "assets/scenes/menu.html"; }

    // 真美术层：背景与标题图画在画布上，HTML 层只留文字与按钮。
    // HTML 引擎不支持 url() 背景图，图片只能走画布这条道。
    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        int vw = SnGame.VW();
        int vh = SnGame.VH();
        CDraw.Clear(c, vw, vh, CDraw.Argb(255, 6, 12, 24));
        if (this.bgPath == null) { this.bgPath = Assets.Find("assets/menu_bg.png"); }
        if (this.titlePath == null) { this.titlePath = Assets.Find("assets/title.png"); }
        if (this.bgPath != null) {
            // 背景按 cover 铺满：裁源取景，不拉伸变形也不留黑边。
            int iw = CDraw.ImageWidth(c, this.bgPath);
            int ih = CDraw.ImageHeight(c, this.bgPath);
            if (iw > 0 && ih > 0) {
                int sx = 0;
                int sy = 0;
                int sw = iw;
                int sh = ih;
                if (iw * vh > ih * vw) {
                    sw = ih * vw / vh;
                    sx = (iw - sw) / 2;
                } else {
                    sh = iw * vh / vw;
                    sy = (ih - sh) / 2;
                }
                CDraw.BlitImageSrc(c, this.bgPath, 0, 0, vw, vh, sx, sy, sw, sh);
            }
        }
        // 下半屏压暗，皮肤卡与战绩文字更清楚。
        CDraw.FillVGrad(c, 0, vh / 2, vw, vh / 2, CDraw.Argb(0, 4, 8, 22), CDraw.Argb(170, 4, 8, 22));
        if (this.titlePath != null) {
            int iw = CDraw.ImageWidth(c, this.titlePath);
            int ih = CDraw.ImageHeight(c, this.titlePath);
            if (iw > 0 && ih > 0) {
                int tw = vw * 2 / 5;
                int th = tw * ih / iw;
                int bob = (Window.GetTickMs() / 30) % 80;
                if (bob > 40) { bob = 80 - bob; }
                CDraw.BlitImage(c, this.titlePath, (vw - tw) / 2, vh / 8 + bob / 8, tw, th);
            }
        }
    }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("start", () => this.Start());
        handlers.AddArg("skin", (string a) => this.PickSkin(Convert.ToInt32(a)));
    }

    override void OnEnter(Control root) {
        this.root = root;
        Profile p = this.g.prof;
        if (p.games == 0) {
            SnShell.Text(root, "stats", "第一次来？吃豆变长，别让蛇头撞上大蛇的身体或围墙");
        } else {
            string rk = p.topRank > 0 ? " · 最佳排名 #" + p.topRank : "";
            SnShell.Text(root, "stats", "最高分 " + p.high + " · 最长 " + p.longest
                + " · 已玩 " + p.games + " 局 · 累计击败 " + p.kills + rk);
        }
        this.SyncSkins();
        this.SyncMute();
    }

    void SyncSkins() {
        if (this.root == null) { return; }
        Profile p = this.g.prof;
        int cur = p.Skin();
        for (int k = 0; k < SnSkins.Count; k = k + 1) {
            Control b = this.root.Find("skin" + k);
            if (b == null) { continue; }
            bool open = SnSkins.Unlocked(k, p.high, p.kills);
            b.SetProp("disabled", open ? "false" : "true");
            b.SetProp("text", open ? SnSkins.Name(k) : SnSkins.Requirement(k));
            b.SetProp("class", k == cur ? "skin skin-sel" : "skin");
            // 内联样式：固定宽度、色板渐变底、深色色板配白字、选中加白框。
            string st = "width:116px";
            if (open) {
                st = st + ";background:" + SnSkins.Swatch(k) + ";color:" + (k == 3 ? "#fff4e0" : "#0b1020");
                if (k == cur) { st = st + ";border:3px solid #ffffff"; }
            }
            b.SetProp("style", st);
        }
        string goal = SnSkins.NextGoal(p.high, p.kills);
        SnShell.Text(this.root, "skindesc", "当前皮肤：" + SnSkins.Name(cur) + (goal.Length > 0 ? " · " + goal : " · 全部皮肤已解锁"));
    }

    void PickSkin(int k) {
        Profile p = this.g.prof;
        if (!SnSkins.Unlocked(k, p.high, p.kills)) { return; }
        if (this.g.shell != null) { this.g.shell.Play("select"); }
        p.SetSkin(k);
        this.SyncSkins();
    }

    // ←/→ 在已解锁皮肤间循环。
    void CycleSkin(int dir) {
        Profile p = this.g.prof;
        int k = p.Skin();
        for (int i = 0; i < SnSkins.Count; i = i + 1) {
            k = (k + dir + SnSkins.Count) % SnSkins.Count;
            if (SnSkins.Unlocked(k, p.high, p.kills)) { this.PickSkin(k); return; }
        }
    }

    void SyncMute() {
        bool muted = this.g.shell != null && this.g.shell.Muted();
        SnShell.Text(this.root, "mute", "回车/空格 开始 · ←/→ 换皮肤 · Esc 退出 · M 音效：" + (muted ? "关" : "开"));
    }

    void Start() {
        if (this.g.shell != null) { this.g.shell.Play("click"); }
        this.g.resuming = false;
        this.router.Go("play");
    }

    override void OnExit() { this.root = null; }

    override void Update(int dtMs) {
        if (this.g.shell != null) { this.g.shell.Tick(dtMs); }
    }

    override void Event(int kind, int key) {
        if (kind != 4) { return; }
        if (key == 27) { this.router.Exit(); }
        if (key == 13 || key == 32) { this.Start(); }
        if (key == 37) { this.CycleSkin(-1); }
        if (key == 39) { this.CycleSkin(1); }
        if (key == 77 && this.g.shell != null) { this.g.shell.ToggleMute(); this.SyncMute(); }
    }
}
