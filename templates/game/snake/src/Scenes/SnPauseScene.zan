using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

// 暂停：HTML 面板叠在定格的对局画面上（世界不步进，只重画最后一帧）。
// 继续 = 回 play 场景续局（g.resuming），重开 = 回 play 场景新开一局。
public class SnPauseScene : HtmlScene {
    SnGame g;
    Control root;

    SnPauseScene(SnGame g) { this.g = g; }

    override string HtmlFile() { return "assets/scenes/pause.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("resume", () => this.Resume());
        handlers.Add("restart", () => this.Restart());
        handlers.Add("menu", () => this.ToMenu());
    }

    override void OnEnter(Control root) {
        this.g.EnterHud(this.router.Host().App());
        this.root = root;
        SnShell.Text(root, "score", "得分 " + this.g.score.Get() + " · 长度 " + this.g.me.length);
        SnShell.Text(root, "info", "排名 #" + Math.Min(this.g.rank, this.g.rankCount) + " / " + this.g.rankCount
            + " · 威胁 " + this.g.threat + "（" + SnGame.ThreatName(this.g.threat) + "）· 截杀 " + this.g.kills);
        this.SyncMute();
    }

    void SyncMute() {
        bool muted = this.g.shell != null && this.g.shell.Muted();
        SnShell.Text(this.root, "mute", "P/Esc 继续 · R 重开 · M 音效：" + (muted ? "关" : "开"));
    }

    void Click() { if (this.g.shell != null) { this.g.shell.Play("click"); } }

    void Resume() {
        this.Click();
        this.g.resuming = true;
        this.router.Go("play");
    }
    void Restart() {
        this.Click();
        this.g.resuming = false;
        this.router.Go("play");
    }
    void ToMenu() {
        this.Click();
        this.g.resuming = false;
        this.router.Go("menu");
    }

    override void OnExit() { this.root = null; this.g.ExitHud(); }

    override void Update(int dtMs) {
        if (this.g.shell != null) { this.g.shell.Tick(dtMs); }
        this.g.SyncHud(Window.GetTickMs());
    }

    override void Event(int kind, int key) {
        if (kind != 4) { return; }
        if (key == 27 || key == 80 || key == 13) { this.Resume(); }
        if (key == 82) { this.Restart(); }
        if (key == 77 && this.g.shell != null) { this.g.shell.ToggleMute(); this.SyncMute(); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        CDraw.Clear(c, SnGame.VW(), SnGame.VH(), CDraw.Argb(255, 10, 13, 26));
        this.g.DrawPlay(Window.GetTickMs());
        this.g.RenderHud(host.App());
    }
}
