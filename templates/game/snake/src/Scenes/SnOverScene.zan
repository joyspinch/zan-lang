using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class SnOverScene : HtmlScene {
    SnGame g;
    Element headline;
    Element scoreEl;
    Element subEl;
    Element cheerEl;
    Element bestEl;

    SnOverScene(SnGame g) { this.g = g; }

    override string HtmlFile() { return "assets/scenes/over.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("retry", () => this.Retry());
        handlers.Add("menu", () => this.ToMenu());
    }

    override void OnEnter(Control root) {
        this.g.EnterHud(this.router.Host().App());
        this.headline = null;
        this.scoreEl = null;
        this.subEl = null;
        this.cheerEl = null;
        this.bestEl = null;
        if (root != null) {
            this.headline = SnOverScene.AsElement(root, "headline");
            this.scoreEl = SnOverScene.AsElement(root, "score");
            this.subEl = SnOverScene.AsElement(root, "sub");
            this.cheerEl = SnOverScene.AsElement(root, "cheer");
            this.bestEl = SnOverScene.AsElement(root, "best");
        }
        if (this.g.newBest && this.g.shell != null) { this.g.shell.Play("success"); }
        if (this.headline != null) {
            this.headline.SetText(this.g.newBest ? "NEW BEST · 新纪录！" : this.g.deathBy);
        }
        if (this.scoreEl != null) {
            this.scoreEl.SetText("得分 " + this.g.score.Get());
        }
        if (this.bestEl != null) {
            this.bestEl.SetText((this.g.newBest ? this.g.deathBy + " · " : "最高 " + this.g.prof.high + " · ")
                + "最长 " + this.g.prof.longest + " · 第 " + this.g.prof.games + " 局");
        }
        if (this.subEl != null) {
            this.subEl.SetText("长度 " + this.g.me.length + " · 击败 " + this.g.kills
                + " · " + SnGame.TierName(this.g.titleTier));
        }
        if (this.cheerEl != null) {
            string cheer = "再来一局，超越自己！";
            if (this.g.newBest) { cheer = "你就是新的贪吃王！"; }
            if (this.g.kills >= 3) { cheer = "猎蛇高手，名不虚传！"; }
            this.cheerEl.SetText(cheer);
        }
    }

    static Element AsElement(Control root, string id) {
        Control c = root.Find(id);
        if (c != null && c is Element) { return (Element)c; }
        return null;
    }

    void Click() { if (this.g.shell != null) { this.g.shell.Play("click"); } }
    void Retry() { this.Click(); this.router.Go("play"); }
    void ToMenu() { this.Click(); this.router.Go("menu"); }

    override void OnExit() { this.g.ExitHud(); }
    override void Update(int dtMs) {
        if (this.g.shell != null) { this.g.shell.Tick(dtMs); }
        this.g.SyncHud(Window.GetTickMs());
    }

    override void Event(int kind, int key) {
        if (kind != 4) { return; }
        if (key == 27) { this.ToMenu(); }
        if (key == 13 || key == 32) { this.Retry(); }
        if (key == 77 && this.g.shell != null) { this.g.shell.ToggleMute(); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        CDraw.Clear(c, SnGame.VW(), SnGame.VH(), CDraw.Argb(255, 10, 13, 26));
        this.g.DrawPlay(Window.GetTickMs());
        this.g.RenderHud(host.App());
    }
}
