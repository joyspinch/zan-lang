using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class SnOverScene : HtmlScene {
    SnGame g;

    SnOverScene(SnGame g) { this.g = g; }

    override string HtmlFile() { return "assets/scenes/over.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("retry", () => this.Retry());
        handlers.Add("menu", () => this.ToMenu());
    }

    override void OnEnter(Control root) {
        this.g.EnterHud(this.router.Host().App());
        SnGame g = this.g;
        Profile p = g.prof;
        if (g.newBest && g.shell != null) { g.shell.Play("success"); }
        bool byWall = g.killerName == null || g.killerName.Length == 0;
        SnShell.Text(root, "headline", g.newBest ? "NEW BEST · 新纪录！" : (byWall ? "撞上了竞技场边界" : "被 " + g.killerName + " 截杀"));
        string killer = "竞技场边界可不讲情面——留意屏幕边缘的红光";
        if (!byWall) {
            killer = "致命一击：" + g.killerName + "（" + SnSkins.PersonaName(g.killerPersona) + "型）· " + SnOverScene.Advice(g.killerPersona);
        }
        SnShell.Text(root, "killer", killer);
        SnShell.Text(root, "score", "" + g.score.Get());
        int best = g.bestRank < 99 ? g.bestRank : g.rank;
        SnShell.Text(root, "rank", "最终排名 #" + Math.Min(g.rank, g.rankCount) + " / " + g.rankCount
            + " · 本局最高 #" + best);
        SnShell.Text(root, "best", (g.newBest ? "刷新最高分！" : "最高 " + p.high) + " · 最长 " + p.longest
            + " · 第 " + p.games + " 局" + (p.topRank > 0 ? " · 历史最佳 #" + p.topRank : ""));
        SnShell.Text(root, "sub", "长度 " + g.me.length + " · 截杀 " + g.kills + " · 道具 " + g.powersTaken
            + " · 威胁 " + g.threat + " 级 · " + SnGame.TierName(g.titleTier));
        string unlock = "";
        for (int i = 0; i < g.unlockedNow.Count; i = i + 1) {
            unlock = unlock + (i > 0 ? "、" : "") + SnSkins.Name(g.unlockedNow[i]);
        }
        if (unlock.Length > 0) {
            unlock = "解锁新皮肤：" + unlock + "！回菜单换上";
        } else {
            unlock = SnSkins.NextGoal(p.high, p.kills);
            if (unlock.Length == 0) { unlock = "全部皮肤已解锁——去冲击排行榜第一吧"; }
        }
        SnShell.Text(root, "unlock", unlock);
        string cheer = "再来一局，超越自己！";
        if (best == 1) { cheer = "登顶全场，王冠是你的！"; }
        if (g.kills >= 3) { cheer = "猎蛇高手，名不虚传！"; }
        if (g.newBest) { cheer = "你就是新的贪吃王！"; }
        SnShell.Text(root, "cheer", cheer);
    }

    // 针对凶手性格的一句提示：让失败变成下一局的抉择。
    static string Advice(int persona) {
        if (persona == 2) { return "猎杀者会预判你的走位，别和它平行跑"; }
        if (persona == 3) { return "缠绕者在绕圈收口，看到紫色合围就冲刺突围"; }
        return "谨慎者只在比你大很多时才出手，先长大再说";
    }

    void Click() { if (this.g.shell != null) { this.g.shell.Play("click"); } }
    void Retry() { this.Click(); this.router.Go("play"); }
    void ToMenu() { this.Click(); this.router.Go("menu"); }

    override void OnExit() { this.g.ExitHud(); }
    override void Update(int dtMs) {
        if (this.g.shell != null) { this.g.shell.Tick(dtMs); }
        this.g.SyncHud(Window.GetTickMs());
    }

    override void Event(int kind, int key) {
        if (kind != 4) { return; }
        if (key == 27) { this.ToMenu(); }
        if (key == 13 || key == 32) { this.Retry(); }
        if (key == 77 && this.g.shell != null) { this.g.shell.ToggleMute(); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        CDraw.Clear(c, SnGame.VW(), SnGame.VH(), CDraw.Argb(255, 10, 13, 26));
        this.g.DrawPlay(Window.GetTickMs());
        this.g.RenderHud(host.App());
    }
}
