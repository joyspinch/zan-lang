using System;

// 皮肤与性格配色表：菜单选皮肤、对局绘制、档案解锁判定共用一份。
// 颜色一律打包成 0xRRGGBB。玩家皮肤刻意避开三种 AI 性格色
// （天蓝 = 谨慎者、猩红 = 猎杀者、紫罗兰 = 缠绕者），一眼分清敌我。
public class SnSkins {
    const int Count = 5;

    static string Name(int k) {
        if (k == 1) { return "落日"; }
        if (k == 2) { return "冰晶"; }
        if (k == 3) { return "熔岩"; }
        if (k == 4) { return "极光"; }
        return "薄荷";
    }

    // 解锁条件：最高分或累计击败。0 号默认解锁。
    static bool Unlocked(int k, int best, int kills) {
        if (k == 1) { return best >= 400; }
        if (k == 2) { return kills >= 10; }
        if (k == 3) { return best >= 1200; }
        if (k == 4) { return kills >= 40; }
        return true;
    }

    static string Requirement(int k) {
        if (k == 1) { return "最高分 400"; }
        if (k == 2) { return "累计击败 10"; }
        if (k == 3) { return "最高分 1200"; }
        if (k == 4) { return "累计击败 40"; }
        return "默认";
    }

    // 下一款还没解锁的皮肤及差距；全解锁返回空串。
    static string NextGoal(int best, int kills) {
        for (int k = 1; k < SnSkins.Count; k = k + 1) {
            if (SnSkins.Unlocked(k, best, kills)) { continue; }
            int need = 0;
            if (k == 1) { need = 400 - best; }
            if (k == 2) { need = 10 - kills; }
            if (k == 3) { need = 1200 - best; }
            if (k == 4) { need = 40 - kills; }
            string unit = (k == 2 || k == 4) ? "次击败" : "分";
            return "下一款皮肤「" + SnSkins.Name(k) + "」：" + SnSkins.Requirement(k) + "（还差 " + need + " " + unit + "）";
        }
        return "";
    }

    // 菜单皮肤按钮的 CSS 渐变（与对局里的身体配色同源）。
    static string Swatch(int k) {
        if (k == 1) { return "linear-gradient(90deg,#ffbe50,#ff5a8c)"; }
        if (k == 2) { return "linear-gradient(90deg,#e6f6ff,#78c8ff)"; }
        if (k == 3) { return "linear-gradient(90deg,#3c282c,#ff8c28)"; }
        if (k == 4) { return "linear-gradient(90deg,#78ffc8,#8c96ff,#ff8cdc)"; }
        return "linear-gradient(90deg,#5aebbe,#2fae8d)";
    }

    static int Pack(int r, int g, int b) { return (r << 16) | (g << 8) | b; }
    static int R(int c) { return (c >> 16) & 255; }
    static int G(int c) { return (c >> 8) & 255; }
    static int B(int c) { return c & 255; }

    static int Mix(int a, int b, int t, int den) {
        if (den <= 0) { return a; }
        int r = SnSkins.R(a) + (SnSkins.R(b) - SnSkins.R(a)) * t / den;
        int g = SnSkins.G(a) + (SnSkins.G(b) - SnSkins.G(a)) * t / den;
        int bl = SnSkins.B(a) + (SnSkins.B(b) - SnSkins.B(a)) * t / den;
        return SnSkins.Pack(r, g, bl);
    }

    // 头部主色（死亡能量豆、粒子、小地图用）。
    static int Base(int k) {
        if (k == 1) { return SnSkins.Pack(255, 170, 80); }
        if (k == 2) { return SnSkins.Pack(200, 236, 255); }
        if (k == 3) { return SnSkins.Pack(255, 140, 40); }
        if (k == 4) { return SnSkins.Pack(140, 255, 210); }
        return SnSkins.Pack(90, 235, 190);
    }

    // 第 i 节（0 = 头）的颜色；n = 总节数；now 驱动流动花纹。
    static int Segment(int k, int i, int n, int now) {
        if (k == 1) {
            int c = SnSkins.Mix(SnSkins.Pack(255, 196, 86), SnSkins.Pack(255, 84, 138), i, n + 1);
            if (i % 5 == 2) { c = SnSkins.Mix(c, SnSkins.Pack(170, 40, 90), 1, 3); }
            return c;
        }
        if (k == 2) {
            int band = (i / 2) % 3;
            if (band == 1) { return SnSkins.Pack(122, 200, 255); }
            return SnSkins.Pack(214, 242, 255);
        }
        if (k == 3) {
            int glow = (i + now / 120) % 4;
            if (glow == 0) { return SnSkins.Pack(255, 150, 46); }
            if (glow == 1) { return SnSkins.Pack(170, 70, 34); }
            return SnSkins.Pack(64, 44, 48);
        }
        if (k == 4) {
            int t = (i * 18 + now / 12) % 360;
            if (t < 120) { return SnSkins.Mix(SnSkins.Pack(120, 255, 200), SnSkins.Pack(140, 150, 255), t, 120); }
            if (t < 240) { return SnSkins.Mix(SnSkins.Pack(140, 150, 255), SnSkins.Pack(255, 140, 220), t - 120, 120); }
            return SnSkins.Mix(SnSkins.Pack(255, 140, 220), SnSkins.Pack(120, 255, 200), t - 240, 120);
        }
        int b = SnSkins.Pack(90, 235, 190);
        if (i % 4 == 1) { b = SnSkins.Pack(170, 255, 226); }
        return b;
    }

    // ----- AI 性格 -----
    static string PersonaName(int p) {
        if (p == 1) { return "谨慎"; }
        if (p == 2) { return "猎杀"; }
        if (p == 3) { return "缠绕"; }
        return "";
    }
    static int PersonaColor(int p) {
        if (p == 1) { return SnSkins.Pack(90, 176, 255); }
        if (p == 2) { return SnSkins.Pack(255, 72, 96); }
        if (p == 3) { return SnSkins.Pack(180, 106, 255); }
        return SnSkins.Pack(255, 214, 110);
    }
    static string PersonaCss(int p) {
        if (p == 1) { return "#5ab0ff"; }
        if (p == 2) { return "#ff4860"; }
        if (p == 3) { return "#b46aff"; }
        return "#ffd66e";
    }

    // ----- 道具 -----
    static string PowerName(int p) {
        if (p == 1) { return "磁铁"; }
        if (p == 2) { return "护盾"; }
        return "双倍";
    }
    static int PowerColor(int p) {
        if (p == 1) { return SnSkins.Pack(255, 96, 120); }
        if (p == 2) { return SnSkins.Pack(96, 230, 255); }
        return SnSkins.Pack(255, 214, 80);
    }
    static int PowerMs(int p) {
        if (p == 1) { return 9000; }
        if (p == 2) { return 12000; }
        return 10000;
    }
}
