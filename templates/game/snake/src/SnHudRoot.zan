using System;
using Gui;
using Gui.Widget;

class SnHudRoot : Panel {
    weak SnHud owner;
    SnHudRoot(SnHud owner) : base("snake-hud") { this.owner = owner; }
    public override void Arrange(int x, int y, int w, int h) {
        SnHud hud = this.owner;
        if (hud != null) { hud.Layout(w, h); }
        base.Arrange(x, y, w, h);
    }
    // Display-only HUD must never claim steering/boost input, even over labels.
    public override Control HitTest(int x, int y, int pointerType) { return null; }
}
