using System;
using Gui;
using Gui.Widget;

// Toroidal radar uses retained standard panels for its player/enemy markers.
class SnMinimap : Panel {
    weak SnGame game;
    List<Panel> markers;
    Panel player;

    SnMinimap(SnGame game) : base("snake-minimap") {
        this.game = game;
        this.markers = new List<Panel>();
        this.player = this.Marker();
        this.player.Class = "snake-minimap-dot snake-minimap-player";
    }

    Panel Marker() {
        Panel marker = new Panel("snake-minimap-dot");
        marker.Class = "snake-minimap-dot";
        this.Add(marker);
        return marker;
    }

    void Sync() {
        SnGame game = this.game;
        if (game == null) { return; }
        while (this.markers.Count < game.foes.Count) { this.markers.Add(this.Marker()); }
        for (int i = 0; i < this.markers.Count; i = i + 1) {
            bool shown = i < game.foes.Count;
            if (shown) { shown = game.foes[i].alive; }
            this.markers[i].SetShown(shown);
        }
    }

    public override void Arrange(int x, int y, int width, int height) {
        SnGame game = this.game;
        if (game != null) {
            int pad = width * 4 / 168;
            int innerWidth = width - pad * 2;
            int innerHeight = height - pad * 2;
            for (int i = 0; i < this.markers.Count && i < game.foes.Count; i = i + 1) {
                Worm worm = game.foes[i];
                if (!worm.alive) { continue; }
                int dx = SnGame.WrapP(worm.seg[0].x, SnGame.WW()) * innerWidth / SnGame.WW();
                int dy = SnGame.WrapP(worm.seg[0].y, SnGame.WH()) * innerHeight / SnGame.WH();
                int radius = (int)Math.Max(1, width * (worm.kind == 1 ? 3 : 2) / 168);
                this.Place(this.markers[i], pad + dx, pad + dy, radius,
                    "rgba(" + worm.cr + "," + worm.cg + "," + worm.cb + ",0.92)");
            }
            int px = SnGame.WrapP(game.me.headX / 256, SnGame.WW()) * innerWidth / SnGame.WW();
            int py = SnGame.WrapP(game.me.headY / 256, SnGame.WH()) * innerHeight / SnGame.WH();
            this.Place(this.player, pad + px, pad + py, (int)Math.Max(1, width * 3 / 168), "#8cffd2");
        }
        base.Arrange(x, y, width, height);
    }

    void Place(Panel marker, int x, int y, int radius, string color) {
        string style = "left:" + (x - radius) + "dpx;top:" + (y - radius)
            + "dpx;width:" + (radius * 2) + "dpx;height:" + (radius * 2) + "dpx;background:" + color;
        if (marker.inlineStyleCss != style) { marker.SetProp("style", style); }
    }
}
