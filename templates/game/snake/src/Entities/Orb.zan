using System;

// 豆子：普通豆（kind 0）、死亡能量豆（kind 1，带死者颜色、从死亡点炸开飞到落点）、
// 限时道具球（kind 2，power 1 磁铁 / 2 护盾 / 3 双倍）。
public class Orb {
    int x;  // world px（最终落点；吞噬判定只认它）
    int y;
    int size;  // radius px, 4..10
    int hue;  // palette index（普通豆）
    int phase;  // pulse phase offset
    int kind;  // 0 普通 1 死亡能量豆 2 道具
    int power;  // kind 2：1 磁铁 2 护盾 3 双倍
    int cr;  // kind 1：死者身体颜色
    int cg;
    int cb;
    int ox;  // kind 1：炸开起点（死亡位置），绘制时 ease-out 飞向 x,y
    int oy;
    int bornAt;  // 模拟时钟 ms
}
