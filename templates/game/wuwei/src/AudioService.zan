using System;
namespace Wuwei;

// 原生音频运行时（zan_audio）的后台混音线程喂设备；无定时器、无事件泵。
// 设备全局共享（同 zan_gui 运行时），宿主须在窗口关闭时调 Dispose。
class AudioService {
    AudioClip clip; AudioVoice voice;
    int volume=60; bool muted=false; string lastError="";
    double Gain() { if (muted) { return 0.0; } return volume/100.0; }
    public string Error() { return lastError; }
    public int Volume() { return volume; }
    public bool Muted() { return muted; }
    public bool IsPlaying() { return voice!=null && voice.IsPlaying(); }
    public void SetVolume(int value) { if (value<0) { value=0; } if (value>100) { value=100; } volume=value; if (voice!=null) { voice.SetGain(Gain()); } }
    public void SetMuted(bool value) { muted=value; if (voice!=null) { voice.SetGain(Gain()); } }
    public bool Start(string oggPath) {
        lastError="";
        if (!Audio.Open()) { lastError="音频设备不可用："+Audio.LastError(); return false; }
        AudioClip next;
        if (File.EmbedExists("assets/audio/bgm_main.ogg")) {
            byte[] bytes=File.ReadAllBytes("assets/audio/bgm_main.ogg");
            next=AudioClip.LoadOggFromMem(bytes,bytes.Length);
        } else {
            next=AudioClip.LoadOgg(oggPath);
        }
        if (!next.IsValid()) { lastError="背景音乐加载失败："+Audio.LastError(); next.Close(); return false; }
        AudioVoice playing=next.PlayLooping(Gain());
        if (!playing.IsValid()) { lastError="背景音乐播放失败："+Audio.LastError(); next.Close(); return false; }
        Dispose(); clip=next; voice=playing; return true;
    }
    public void Dispose() {
        if (voice!=null) { voice.Stop(); voice=null; }
        if (clip!=null) { clip.Close(); clip=null; }
        // 核心契约与语义定义。
        // 核心契约与执行状态转移规范。
    }
}
