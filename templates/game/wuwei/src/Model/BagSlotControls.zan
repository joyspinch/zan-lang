using System;
using System.IO;
using Gui;
using Gui.Widget;
using Gui.Backend;
using Wuwei;

public class BagSlotControls {
    public Image image;
    public Label name;
    public Label detail;
    public Button use;
    public Button sell;
    public Button recycle;

    public BagSlotControls(Image image, Label name, Label detail, Button use, Button sell, Button recycle) {
        this.image = image;
        this.name = name;
        this.detail = detail;
        this.use = use;
        this.sell = sell;
        this.recycle = recycle;
    }
}
