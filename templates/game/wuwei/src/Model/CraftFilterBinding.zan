using System;
using System.IO;
using Gui;
using Gui.Widget;
using Gui.Backend;
using Wuwei;

public class CraftFilterBinding {
    public Button button;
    public string key;

    public CraftFilterBinding(Button button, string key) {
        this.button = button;
        this.key = key != null ? key : "";
    }
}

