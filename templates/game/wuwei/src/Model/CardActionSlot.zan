using System;
using System.IO;
using Gui;
using Gui.Widget;
using Gui.Backend;
using Wuwei;

public class CardActionSlot {
    public Label name;
    public Label detail;
    public Image image;
    public Button button;

    public CardActionSlot(Label name, Label detail, Image image, Button button) {
        this.name = name;
        this.detail = detail;
        this.image = image;
        this.button = button;
    }
}

