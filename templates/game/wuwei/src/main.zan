                mSlot.label.Text=item.Name+"    ·    "+item.Text("price")+" 灵石";
                bool canBuy=!Model.NeedsPrestige&&Model.Stones>=item.Num("price")&&Model.Level>=item.Int("req")&&Model.ItemCount(item.Id)<Model.Data.Rule("stack_limit");
                mSlot.button.Disabled=!canBuy;
                mSlot.button.Tip=item.Text("desc")+"\n价格 "+item.Text("price")+" 灵石 · 需境界 "+item.Text("req")+" 层"+(canBuy?"":(Model.Level<item.Int("req")?" · 境界不足":(Model.Stones<item.Num("price")?" · 灵石不足":" · 已达行囊上限")));
            }else{
                mSlot.label.Text="";
            }
        }
        for(int i=0;i<7;i=i+1){
