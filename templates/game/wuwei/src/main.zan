            bool on=Model.Equipment.ContainsKey(slot);
            string title=i==0?"兵器":i==1?"法冠":i==2?"法袍":i==3?"灵履":i==4?"护腕":i==5?"护符":"灵戒";
            LabeledButtonSlot eqSlot=EquippedSlots[i];
            eqSlot.label.Text=title+" · "+(on?ItemName(Model.Equipment[slot]):"空栏");
            eqSlot.button.visible=on;
            eqSlot.button.Disabled=!on;
        }
        GearText.Text="攻击 "+Number(Model.Attack())+"   防御 "+Number(Model.Defense())+"   气血 "+Number(Model.Hp)+" / "+Number(Model.MaxHp())+"    阵法："+(Model.Formation==""?"未布置":ItemName(Model.Formation))+" · 灵酒："+(Model.WineSeconds>0?ItemName(Model.Wine)+" "+Number(Model.WineSeconds)+"秒":"未饮用");
        if(StatVals.Count>=7){StatVals[0].Text=Model.RealmName()+" "+Number(Model.Layer())+"层";StatVals[1].Text=Number(Model.Hp)+" / "+Number(Model.MaxHp());StatVals[2].Text=Number(Model.Attack());StatVals[3].Text=Number(Model.Defense());StatVals[4].Text=Model.Activity==1?"闭关":Model.Activity==2?"历练":Model.Activity==3?"百艺":"静养";StatVals[5].Text=Model.SectIndex<0?"未加入":Model.Data.Sects[Model.SectIndex].Name;StatVals[6].Text="因果 "+Number(Model.Karma)+" · "+Number(Model.Rebirths)+"世";}
        if(StatVals.Count>=8&&StatVals[7]!=null){StatVals[7].Text=Model.SpiritRootName();}
        string loot="";int start=Model.Log.Count-6;if(start<0){start=0;}for(int i=start;i<Model.Log.Count;i=i+1){loot=loot+Model.Log[i];}for(int i=0;i<6;i=i+1){if(i<Model.Log.Count-start){LootLabels[i].Text=Model.Log[start+i];}else{LootLabels[i].Text="";}}
        MusicStatus.Text="山中清音 · 音量 "+Number(Music.Volume())+"% · "+(Music.Muted()?"已静音":Music.IsPlaying()?"播放中":"未播放")+(Music.Error()!=""?" · "+Music.Error():"");
        for(int i=0;i<Model.Data.SectTasks.Count;i=i+1){
            Row t=Model.Data.SectTasks[i];
            bool own=Model.SectIndex>=0 && t.Text("sect")==Model.Data.Sects[Model.SectIndex].Id;
            LabeledButtonSlot taskSlot=TaskSlots[i];
            taskSlot.label.Text=t.Name+"\n进度 "+Number(Model.SectTaskProgress(i))+" / "+t.Text("target")+" · 奖励 "+t.Text("reward")+" 贡献";
            taskSlot.button.Disabled=!own || Model.SectTaskProgress(i)<t.Num("target");
        }
        for(int i=0;i<Model.Data.Talents.Count;i=i+1){
            LabeledButtonSlot talSlot=TalentSlots[i];
            talSlot.label.Text=Model.Data.Talents[i].Name+" · "+Number(Model.TalentLevel(i))+"级 · 消耗 "+Number(Model.TalentCost(i))+"因果";
            bool canUp=!Model.NeedsPrestige&&Model.TalentLevel(i)<100&&Model.Karma>=Model.TalentCost(i);
            talSlot.button.Disabled=!canUp;
            talSlot.button.Tip="升至 "+Number(Model.TalentLevel(i)+1)+" 级 · 消耗 "+Number(Model.TalentCost(i))+" 因果"+(canUp?"":(Model.TalentLevel(i)>=100?" · 已至百级圆满":" · 因果不足"));
        }
        EndingText.Text=Model.Ascended?"飞升 · 山海归一\n九重天劫已渡，长生之路终成。仍可巡游万界、完成图鉴，或携因果再续一世。":Model.NeedsPrestige?"寿元已尽 · 此世已成往事\n请在下方确认转生，保留因果与永久天赋，再续仙缘。":"天门未开 · 前往绝境，逐一渡过九重试炼。\n击败最终天劫，即可成就飞升结局。";
        for(int i=0;i<3;i=i+1){
            Row v=Model.SectVaultRow(i);
            LabeledButtonSlot vSlot=VaultSlots[i];
            if(v!=null){
                vSlot.label.Text=v.Name+" · "+Number(Model.SectVaultCost(i))+"贡献\n"+v.Text("desc");
                vSlot.button.Disabled=Model.SectIndex<0 || Model.Contribution<Model.SectVaultCost(i) || Model.Level<v.Int("req");
            }else{
                vSlot.label.Text="拜入宗门后查看本宗宝库";
                vSlot.button.Disabled=true;
            }
        }
        ArenaStatus.Text=(Model.ArenaAvailable()?"论剑开放":"论剑尚未开放")+" · 胜场 "+Number(Model.ArenaWins())+" · 战力 "+Number(Model.ArenaPower())+"\n每 "+Number(Model.ArenaCycleSeconds())+"秒开放 "+Number(Model.ArenaWindowSeconds())+"秒 · 距下轮 "+Number(Model.ArenaCycleSeconds()-(Model.PlayedSeconds-Model.ArenaCycle()*Model.ArenaCycleSeconds()))+"秒";
        for(int i=0;i<3;i=i+1){
            Row a=Model.ArenaOpponent(i);
            LabeledButtonSlot aSlot=ArenaSlots[i];
            if(a!=null){
                aSlot.label.Text=a.Name+" · 战力 "+a.Text("power")+" · 奖励 "+a.Text("reward")+"贡献"+(Model.ArenaOpponentWon(i)?" · 已胜":"");
                aSlot.button.Disabled=!Model.ArenaAvailable() || Model.ArenaOpponentAttempted(i) || Model.Level<a.Int("req");
            }else{
                aSlot.label.Text="拜入宗门后解锁同道论剑";
                aSlot.button.Disabled=true;
            }
        }
        RefreshCodex();
        SectText.Text=Model.SectIndex<0?"筑基之后，可择一宗门。正魔殊途，皆可求长生。":"已入 "+Model.Data.Sects[Model.SectIndex].Name+" · 贡献 "+Number(Model.Contribution)+" · 心法 "+Number(Model.SectManual)+"层";
        for(int i=0;i<Model.Data.Sects.Count;i=i+1){Row r=Model.Data.Sects[i];bool mine=Model.SectIndex==i;bool joined=Model.SectIndex>=0;bool can=!Model.NeedsPrestige&&!joined&&Model.Level>=r.Int("req");SectButtons[i].Disabled=!can;SectButtons[i].Text=mine?"本宗":"拜入宗门";SectButtons[i].Tip=r.Text("desc")+"\n境界需求 "+r.Text("req")+" 层"+(mine?" · 已拜入本宗":(joined?" · 一世只择一宗":""));}
        int trainCost=(Model.SectManual+1)*520;bool canTrain=!Model.NeedsPrestige&&Model.SectIndex>=0&&Model.Contribution>=trainCost&&Model.SectManual<99;sectTrain.Disabled=!canTrain;sectTrain.Text="研习宗门心法 · "+Number(trainCost)+" 贡献";sectTrain.Tip=(Model.SectIndex<0?"需先拜入宗门":(Model.SectManual>=99?"心法已至 99 层圆满":(Model.Contribution<trainCost?"贡献不足 · 尚差 "+Number(trainCost-(int)Model.Contribution):"消耗贡献，精进本宗心法")));
        KarmaText.Text="因果 "+Number(Model.Karma)+"    ·    已历 "+Number(Model.Rebirths)+"世";autoHeal.Text=Model.AutoHeal?"自动服药：开启":"自动服药：关闭";SaveText.Text=SaveStatus+"\n"+SavePath;
        if(EpiphanyBox!=null){EpiphanyBox.visible=Model.HasEpiphany();}
        if(TribulationInfoLbl!=null&&StartTribulationBtn!=null){
            if(Model.InTribulation()){
                StartTribulationBtn.Text="运功抵御雷劫（第 "+Number(Model.TribulationWave)+" 重）";
                TribulationInfoLbl.Text="⚡ 劫雷轰顶！当前第 "+Number(Model.TribulationWave)+" / 3 重天劫";
            }else{
                StartTribulationBtn.Text="渡劫破境";
                TribulationInfoLbl.Text="本境十二层圆满后，可引动九天雷劫淬体破境。";
            }
        }
        if(CombatLog2!=null){
            int cCount=Model.CombatLog.Count;
            if(CombatLog0!=null){CombatLog0.Text=cCount>=3?Model.CombatLog[cCount-3]:"";}
            if(CombatLog1!=null){CombatLog1.Text=cCount>=2?Model.CombatLog[cCount-2]:"";}
            CombatLog2.Text=cCount>=1?"⚔ "+Model.CombatLog[cCount-1]:"暂无战报，静候战机...";
        }
        if(AdventureBox!=null){
            bool hasAdv=Model.HasAdventure();
            AdventureBox.visible=hasAdv;
            if(hasAdv){
                if(AdventureDescLbl!=null){AdventureDescLbl.Text=Model.AdventureTitle+" "+Model.AdventureDesc;}
                if(AdvChoiceABtn!=null){AdvChoiceABtn.Text=Model.AdventureChoiceA;}
                if(AdvChoiceBBtn!=null){AdvChoiceBBtn.Text=Model.AdventureChoiceB;}
            }
        }
    }
    static void FillMapSlots(List<CardActionSlot> slots,int mode,int page) {
        for(int s=0;s<3;s=s+1){
            int gi=MapRowAt(mode,page*3+s);
            CardActionSlot slot=slots[s];
            slot.button.visible=gi>=0;
            if(gi>=0){
                Row m=Model.Data.Maps[gi];
                slot.name.Text=m.Name;
                slot.detail.Text=m.Text("desc")+"\n境界要求："+m.Text("req")+"层";
                slot.image.Src=ArtPath(m.Text("image"));
                slot.button.Text=Model.MapUnlocked(gi)?"前往历练":"尚未解锁";
                slot.button.Disabled=!Model.MapUnlocked(gi);
            }else{
                slot.name.Text="云深不知处";
                slot.detail.Text="前方再无地图";
                slot.image.Src=ArtPath("qingzhu_ridge.png");
            }
        }
    }
    static void RefreshCodex() {
        for(int s=0;s<4;s=s+1){int ai=AchPage*AchPerPage()+s;Row a=ai<Model.AchievementCount()?Model.AchievementRow(ai):null;if(a!=null){AchLabels[s].Text=(Model.AchievementUnlocked(ai)?"已达成 · ":"修行中 · ")+a.Name+"  "+Number(Model.AchievementProgress(ai))+" / "+a.Text("target")+"\n"+a.Text("desc");}else{AchLabels[s].Text="";}}
        AchCounter.Text="第 "+Number(AchPage+1)+" / "+Number((Model.AchievementCount()+AchPerPage()-1)/AchPerPage())+" 页";
        for(int s=0;s<6;s=s+1){int index=CodexPage*6+s;if(index<Model.Data.Enemies.Count){Row e=Model.Data.Enemies[index];CodexLabels[s].Text=e.Name+" · 已击败 "+Number(Model.Count(Model.EnemyKills,e.Id))+"次\n气血 "+e.Text("hp")+" · 攻击 "+e.Text("atk")+" · 掉落 "+ItemName(e.Text("drop"));}else{index=index-Model.Data.Enemies.Count;if(index<Model.Data.Items.Count){Row r=Model.Data.Items[index];CodexLabels[s].Text=r.Name+" · 持有 "+Number(Model.ItemCount(r.Id))+"件\n"+r.Text("desc");}else{CodexLabels[s].Text="本卷终";}}}
        CodexCounter.Text="第 "+Number(CodexPage+1)+" / "+Number((Model.Data.Enemies.Count+Model.Data.Items.Count+5)/6)+"卷";
    }
    // 快捷键：Space 开始/暂停当前活动，Esc 打开系统页（侧栏有说明）。
    // 沿用 IDE 的做法：每帧读 App.EventKind + window.EventKeyCode。
    // 未实现 F11 全屏——Gui 标准库没有该 API，不为此发明接口。
    static void PumpKeys() {
        App app=Window.GetApp();
        int kind=app.EventKind();
        if(kind!=4 || !Ready || InMenu){return;}
        int kc=app.window.EventKeyCode();
        if(kc==32){
            if(Model.Activity==0){Result(Model.StartCultivation());}
            else {Model.StopActivity();Model.Say("已停下手中事务",true);}
            Refresh();
        }
        else if(kc==27){SelectSection(6);}
    }
    // 核心契约与语义定义。
    static void LoadFrame() {
        PumpKeys();
        PublishProbes();if(Ready){return;}
        if(LoadStep==0){LoadStep=1;}
        else if(LoadStep==1){Model.Init(Root+"/data");LoadStep=2;OpeningText.Text="资源加载中 · 修行数据已解密";}
        else if(LoadStep==2){ArtPath("main_menu_bg.webp");ArtPath("title_calligraphy.webp");LoadStep=3;OpeningText.Text="资源加载中 · 山海画卷已展开";}
        else if(LoadStep==3){LoadSave();LoadStep=4;OpeningText.Text="资源加载中 · 清音与仙缘已就绪";}
        else {Build();Opening.visible=false;LoadStep=5;}
        OpeningBar.SetPercent((LoadStep-1)*25);Window.GetApp().RequestRedraw();Window.GetApp().RequestWakeIn(1);
    }
    static void Build() {
        Window.GetApp().UseSkin("wuwei");Window.GetApp().SetChromeButtons(false,false,true,true);
        // 设计稿建树：__BuildForm 生成 Menu/Shell 整棵树（body 下两个顶层
        // 字段按 data-dock 停靠），挂上窗口后由 Attach 做业务装配。
        // 坑：App.html 必须显式作编译输入（zanc 不自动发现入口旁的 .html）。
        // 漏传时生成字段全部缺席，裸名 Menu 经"全库唯一简单名"兜底命中
        // 系统底层交互与数据流转契约
        // ——错误里印全限定类型名就是命中的导入类型；撞这类"成员错"先
        // 核对设计稿在不在输入里。
        Window.Add(__BuildForm());
        __WireForm(Window);
        Attach();
        Ready=true;Refresh();Clock=Stopwatch.StartNew();Window.Every(250,()=>{Heartbeat();});Window.Every(30000,()=>{SaveGame(false);});Window.OnExit(()=>{SaveGame(false);Music.Dispose();});
    }
    static void Main() {
        Root=Skin.ExeDir();Model=new Wuwei.Game();
        try {
            Window=Form.Create("无为修仙传",1280,800);Window.GetApp().UseSkin("wuwei");
            Opening=Panel.Root("loading");Opening.Class="loading";Opening.DockFill();Window.With(Opening);
            Label title=MakeLabel("无为修仙传","loading-title text-3xl",72);title.Place(340,270);title.Prefer(600,72);Opening.With(title);
            OpeningText=MakeLabel("资源加载中 · 准备山海画卷","loading-text",36);OpeningText.Place(340,382);OpeningText.Prefer(600,36);Opening.With(OpeningText);
            OpeningBar=new Progress(0,1);OpeningBar.Class="loading-progress";OpeningBar.ShowText(false);OpeningBar.Place(340,434);OpeningBar.Prefer(600,22);Opening.With(OpeningBar);
            Window.FrameHook(()=>{LoadFrame();});Window.Run();
        }
        catch(Exception e){Form error=Form.Create("无为修仙 · 需要处理",720,280);Panel p=Panel.Column();p.Class="p-4";p.DockFill();p.With(MakeLabel("游戏未能启动："+e.Message+"\n请检查数据包、素材与运行目录，然后重新构建。","",176));error.With(p);error.Run();}
    }
    // Loading 屏是设计稿建成前的临时树，手搭几个控件即可；
    // 尺寸走逻辑字段 + Prefer，与旧 Size() 辅助同款。
    static Label MakeLabel(string value,string cls,int height) {
        Label l=new Label(value);l.Class=cls;l.logH=height;l.Prefer(0,height);return l;
    }
}
