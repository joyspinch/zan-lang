        }
        CraftText.Text=(Model.Activity==3?Model.Data.Recipes[Model.RecipeIndex].Name+" · "+Number(Model.CraftProgress)+" / "+Number(Model.CraftDuration())+"秒":"百艺闲置 · 选择配方后自动继续制作")+"    ·    当前分类 "+CraftLabel(CraftFilter);
        CraftBar.SetPercent(Model.Activity==3?(int)(Model.CraftProgress*100/Model.CraftDuration()):0);
        CombatText.Text=Model.Activity==2?Model.Data.Enemies[Model.EnemyIndex].Name+"    气血 "+Number(Model.EnemyHp)+" / "+Number(Model.EnemyMaxHp):"收剑听风    ·    本世胜场 "+Number(Model.Kills);
        WorkBar.SetPercent(Model.Activity==2?(int)(Model.EnemyHp*100/Model.EnemyMaxHp):0);
        BagTotal=0;foreach(string id in Model.Inventory.Keys){Row item=Model.ItemRow(id);if(Model.ItemCount(id)>0 && BagMatches(item)){BagTotal=BagTotal+1;}}
        if(BagPage*BagSlots>=BagTotal){BagPage=BagTotal>0?(BagTotal-1)/BagSlots:0;}
        BagIds.Clear();int offset=0;foreach(string id in Model.Inventory.Keys){Row item=Model.ItemRow(id);if(Model.ItemCount(id)>0 && BagMatches(item)){if(offset>=BagPage*BagSlots && BagIds.Count<BagSlots){BagIds.Add(id);}offset=offset+1;}}
        for(int s=0;s<BagSlots;s=s+1){
            bool exists=s<BagIds.Count;
            BagSlotControls bc=BagControls[s];
            bc.use.visible=exists;
            bc.sell.visible=exists;
            bc.image.visible=exists;
            bc.recycle.visible=exists;
            if(exists){
                string id=BagIds[s];
                Row item=Model.ItemRow(id);
                if(item==null){continue;}
                bc.name.Text=ItemName(id)+" × "+Number(Model.ItemCount(id));
                bc.detail.Text=ItemDetail(id);
                bc.image.Src=ArtPath(item.Text("image")==""?"herb_dew_grass.png":item.Text("image"));
                bool usable=UsableItem(item,id);
                bc.use.Disabled=Model.NeedsPrestige||Model.Level<item.Int("req")||!usable;
                bc.use.Tip=ItemDetail(id)+(usable?"":"\n此物用于制作或破境，不可直接使用");
                bool gear=item.Text("slot")!="";
                bc.recycle.Disabled=!gear;
                bc.recycle.Tip=gear?"分解为灵石与淬炼材料":"仅装备可分解";
            }else{
                bc.name.Text=s==0?"此分类暂无物品":"空位";
