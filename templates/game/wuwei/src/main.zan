using System;
using System.IO;
using Gui;
using Gui.Widget;
using Gui.Backend;
using Wuwei;

// 界面结构全部由 src/App.html 设计稿声明（GenForm 展开成 partial 类的
// 类型化字段），本文件只做 code-behind：生命周期、事件注册、模型状态
// 刷新、存档与键盘。中部页面改为 flex 纵列 + grow 卡片，控件高度由
// 布局分配，不再出现滚动条与页底死空间。

/// <summary>
/// 标签页导航绑定实体（消除 TabBtns / TabPages 平行列表反模式）。
/// </summary>
class TabNavBinding {
    public Button button;
    public int page;

    public TabNavBinding(Button button, int page) {
        this.button = button;
        this.page = page;
    }
}

/// <summary>
/// 生产百艺分类标签绑定实体（消除 CraftBtns / CraftKeys 平行列表反模式）。
/// </summary>
class CraftFilterBinding {
    public Button button;
    public string key;

    public CraftFilterBinding(Button button, string key) {
        this.button = button;
        this.key = key != null ? key : "";
    }
}

/// <summary>
/// 任务/功能行控件绑定实体（消除 TaskLabels / TaskButtons 等平行列表反模式）。
/// </summary>
class LabeledButtonSlot {
    public Label label;
    public Button button;

    public LabeledButtonSlot(Label label, Button button) {
        this.label = label;
        this.button = button;
    }
}

/// <summary>
/// 地图/配方卡片槽位控件绑定实体（消除 MapNames / MapDetails / MapImages / MapButtons 平行列表反模式）。
/// </summary>
class CardActionSlot {
    public Label name;
    public Label detail;
    public Image image;
    public Button button;

    public CardActionSlot(Label name, Label detail, Image image, Button button) {
        this.name = name;
        this.detail = detail;
        this.image = image;
        this.button = button;
    }
}

/// <summary>
/// 背包格子控件组实体（消除 BagImages / BagNames / BagDetails / BagUse / BagSell / BagRecycle 平行列表反模式）。
/// </summary>
class BagSlotControls {
    public Image image;
    public Label name;
    public Label detail;
    public Button use;
    public Button sell;
    public Button recycle;

    public BagSlotControls(Image image, Label name, Label detail, Button use, Button sell, Button recycle) {
        this.image = image;
        this.name = name;
        this.detail = detail;
        this.use = use;
        this.sell = sell;
        this.recycle = recycle;
    }
}

partial class WuweiApp {
    static Form Window;
    static Panel Opening; static Label OpeningText; static Progress OpeningBar;
    static Wuwei.Game Model;
    static string Root;
    static int Page=0;
    static int Section=0;
    static int MapPage=0;
    static int MapDPage=0;
    static int MapEPage=0;
    static int RecipePage=0;
    static string CraftFilter="fishing";
    static int SkillPage=0;
    static int BagPage=0;
    static int MarketPage=0;
    static bool PrestigeArmed=false;
    static string SaveStatus="尚未保存";
    static bool SaveBlocked=false;
    static string SavePath="";
    static string JourneyName="仙缘 1";
    static ProfileStore Profiles; static AudioService Music; static int ActiveSlot=1; static bool InMenu=true;
    static int MenuPage=0; static int LoadStep=0; static bool Ready=false;
    static int BagFilter=0; static int BagTotal=0; static int CodexPage=0; static int AchPage=0; static int MenuAwardPage=0;
    static double LastTick=0;
    static Stopwatch Clock;
    // 删档确认弹窗（保留式 LayerState，静态构造一次保证 id 稳定）。
    // DeleteArmed=待删槽位，0 表示没有弹窗在等答案。
    static int DeleteArmed=0;
    static LayerState DeleteDialog=LayerState.Confirm("删除仙缘","将永久删除该仙缘的存档与备份，无法恢复。确定删除？",2);
    // code-behind 侧的运行时控件名册：字段由 App.html 生成（见生成类），
    // 采用强类型槽位实体封装，消除平行列表反模式。
    static List<Button> Nav=new List<Button>();
    static List<TabNavBinding> TabNavBindings=new List<TabNavBinding>();
    static List<CraftFilterBinding> CraftFilterBindings=new List<CraftFilterBinding>();
    static List<Flex> SectionBars=new List<Flex>();
    static List<Flex> Pages=new List<Flex>();
    static List<Label> ProfileLabels=new List<Label>();
    static List<Button> SlotDelete=new List<Button>();
    static List<Label> AchMenu=new List<Label>();
    static List<Label> AchLabels=new List<Label>();
    static List<Label> CodexLabels=new List<Label>();
    static List<LabeledButtonSlot> TaskSlots=new List<LabeledButtonSlot>();
    static List<LabeledButtonSlot> TalentSlots=new List<LabeledButtonSlot>();
    static List<LabeledButtonSlot> VaultSlots=new List<LabeledButtonSlot>();
    static List<LabeledButtonSlot> ArenaSlots=new List<LabeledButtonSlot>();
    static List<Button> SectButtons=new List<Button>();
    static List<CardActionSlot> MapSlots=new List<CardActionSlot>();
    static List<CardActionSlot> MapDSlots=new List<CardActionSlot>();
    static List<CardActionSlot> MapESlots=new List<CardActionSlot>();
    static List<CardActionSlot> SkillSlotsList=new List<CardActionSlot>();
    static List<CardActionSlot> RecipeSlots=new List<CardActionSlot>();
    static List<BagSlotControls> BagControls=new List<BagSlotControls>();
    static List<string> BagIds=new List<string>();
    static List<LabeledButtonSlot> MarketSlotsList=new List<LabeledButtonSlot>();
    static int BagSlots=8; static int MarketSlots=6; static int SkillSlots=10;
    static List<LabeledButtonSlot> EquippedSlots=new List<LabeledButtonSlot>();
    static List<Label> StatVals=new List<Label>(); static List<Label> LootLabels=new List<Label>();
    static List<string> GearSlots=new List<string>();
    static DialogHost Dialogs;
    // 探针面名册：gameplay.ui 的 clickid @name 目标全部收口到这里，
    // Attach 时从生成字段（类型化、编译期校验）抓引用。
    static List<Button> ProbeButtons=new List<Button>();
    static Flex EpiphanyBox; static Button ClaimEpiphanyBtn;
    static Label TribulationInfoLbl; static Button StartTribulationBtn;
    static Label CombatLog0; static Label CombatLog1; static Label CombatLog2;
    static Flex AdventureBox; static Label AdventureDescLbl;
    static Button AdvChoiceABtn; static Button AdvChoiceBBtn;
    static Label MeditationLog0; static Label MeditationLog1; static Label MeditationLog2;
    static Label SkillTotalMasteryLbl; static Label SkillBonusAtkLbl;
    static Label SkillBonusDefLbl; static Label SkillBonusQiLbl;
    static Label SkillBonusHpLbl; static Label SkillBonusXpLbl;
    static Label SkillMasteryInsightLbl;

    static void Heartbeat() {
        double now=Clock.ElapsedSeconds();
        if(!InMenu){Model.Tick(now-LastTick);}
        LastTick=now;Refresh();
    }
    // 删除确认弹窗的渲染与答案消费：由 DialogHost.OnPaint 在保留树的
    // 绘制阶段调用（每帧、事件仍为“当前事件”），点击与回车都能在同
    // 一帧被读取。action 1=删除，2/3=取消或关闭。心跳定时器不行：
    // PumpTasks 阶段事件已被清零，回车赶不上键盘门槛。
    static void PumpDeleteDialog() {
        if(DeleteArmed==0){return;}
        Layer.Render(Window.GetApp(),DeleteDialog);
        int a=DeleteDialog.action;
        if(a==0){return;}
        int slot=DeleteArmed;DeleteArmed=0;DeleteDialog.action=0;DeleteDialog.open=false;
        if(a==1){DeleteSlot(slot);}
        Window.GetApp().RequestRedraw();
    }
    static void DeleteSlot(int slot) {
        if(!InMenu || slot<1 || slot>5){return;}
        if(slot==ActiveSlot && !Profiles.Metadata(slot).Exists){return;}
        if(!Profiles.Delete(slot)){MenuStatus.Text=Profiles.Error();Refresh();return;}
        if(ActiveSlot==slot){SavePath="";}
        MenuStatus.Text="仙缘 "+Number(slot)+" 已删除，该槽位回到空白。";
        RefreshProfiles();Refresh();
    }
    static void AskDelete(int slot) {
        if(!InMenu || DeleteArmed!=0){return;}
        DeleteDialog.title="删除仙缘 "+Number(slot);
        DeleteDialog.okText="删除";
        DeleteDialog.cancelText="保留";
        DeleteArmed=slot;
        DeleteDialog.Open();
        Window.GetApp().RequestRedraw();
    }

    static string Number(double n) { return Convert.ToString((int)n); }
    static void SelectPage(int p) { PrestigeArmed=false;prestige.Text="转生 · 再续仙缘";Page=p;Refresh(); }
    static void SelectSection(int s) { Section=s;SelectPage(SectionDefault(s)); }
    static int SectionDefault(int s) { return s==0?0:s==1?4:s==2?7:s==3?8:s==4?10:s==5?13:14; }
    static void Result(bool ok) {Refresh();}
    static void SaveNow() { SaveGame(true); }
    static void SaveGame(bool manual) {
        if(InMenu){return;}
        if(SaveBlocked){SaveStatus="存档已保护，禁止覆盖。请切换空白仙缘。";}
        else {
            if(manual){Model.ManualSaves=Model.ManualSaves+1;}
            Model.SavedUnixSeconds=DateTime.UtcNow().ToUnixSeconds();
            if(Profiles.Write(ActiveSlot,Model.Serialize(),JourneyName,Model.RealmName()+" "+Number(Model.Layer())+"层")){SaveStatus="仙缘 "+Number(ActiveSlot)+" · 保存成功";}
            else {if(manual){Model.ManualSaves=Model.ManualSaves-1;}SaveStatus=Profiles.Error();}
        }
        if(manual){Model.Say(SaveStatus,!SaveBlocked);}Refresh();
    }
    static void LoadSave() { Profiles=new ProfileStore();Music=new AudioService();Music.Start(Root+"/assets/audio/bgm_main.ogg");string settings=Profiles.SettingsRead();if(settings!=""){List<string> bits=settings.Split(",");if(bits.Count==2){try{int volume=Convert.ToInt32(bits[0]);if(volume>=0 && volume<=100){Music.SetVolume(volume);}Music.SetMuted(bits[1]=="1");}catch(Exception e){SaveStatus="音量设置无效，使用默认值";}}} }
    static void OpenSlot(int slot,bool onlyNew) {
        ProfileInfo info=Profiles.Metadata(slot);
        if(onlyNew && (info.Exists || info.Error!="")){MenuStatus.Text="此仙缘已有存档或读取失败，绝不覆盖。请选择空白仙缘。";return;}
        string payload=Profiles.Read(slot);
        if(Profiles.Error()!=""){MenuStatus.Text=Profiles.Error();return;}
        Wuwei.Game candidate=new Wuwei.Game();candidate.Init(Root+"/data");
        if(payload!="" && !candidate.LoadState(payload)){MenuStatus.Text="此仙缘存档无效，原文件已保护。请选择其他仙缘。";return;}
        if(!InMenu){SaveGame(false);if(Profiles.Error()!=""){MenuStatus.Text="原仙缘保存失败，已取消切换。";return;}}
        long now=DateTime.UtcNow().ToUnixSeconds();if(payload!="" && candidate.SavedUnixSeconds>0 && now>candidate.SavedUnixSeconds){candidate.SimulateOffline((double)(now-candidate.SavedUnixSeconds));}
        Model=candidate;Model.InteractiveEvents=true;ActiveSlot=slot;JourneyName=info.Name==""?"仙缘 "+Number(slot):info.Name;profileName.SetText(JourneyName);SaveBlocked=false;SaveStatus=payload==""?"新仙缘已开启 · 每30秒自动保存":"仙缘载入成功 · 离线收益已结算";
        SavePath=Profiles.SlotPath(slot);InMenu=false;BagPage=0;BagFilter=0;Section=0;MapPage=0;MapDPage=0;MapEPage=0;RecipePage=0;CraftFilter="fishing";SelectPage(0);
    }
    static void NewJourney() { for(int i=1;i<=5;i=i+1){ProfileInfo info=Profiles.Metadata(i);if(!info.Exists && info.Error==""){OpenSlot(i,true);return;}}MenuStatus.Text="五段仙缘均有存档；请继续已有仙缘。新游戏不会删除任何存档。"; }
    static void ShowMenu() {SaveGame(false);if(Profiles.Error()!=""){return;}InMenu=true;MenuPage=0;PrestigeArmed=false;prestige.Text="转生 · 再续仙缘";RefreshProfiles();Refresh();}
    static void RefreshProfiles() {for(int i=0;i<5;i=i+1){ProfileInfo info=Profiles.Metadata(i+1);string title=info.Exists&&info.Name!=""&&info.Name!="仙缘 "+Number(i+1)?info.Name+"  ·  ":"";ProfileLabels[i].Text="仙缘 "+Number(i+1)+(title!=""?"  ·  "+info.Name:"")+"  ·  "+(info.Exists?info.Summary:"空白 · 开启新旅程")+(info.Error!=""?" · 已保护":"");if(i>0){SlotDelete[i-1].visible=info.Exists;}}}
    static void SaveMusic() {if(!InMenu){Model.SetMusicAdjusted();}if(!Profiles.SettingsWrite(Number(Music.Volume())+","+(Music.Muted()?"1":"0"))){Model.Say(Profiles.Error(),false);}Refresh();}
    static void ChangeVolume(int delta) {Music.SetVolume(Music.Volume()+delta);SaveMusic();}
    static void OpenMenuPage(int page) {MenuPage=page;RefreshProfiles();Refresh();}
    static int AchPerPage() { return 4; }
    static void ClampAchPages() {
        int count=Model.AchievementCount();
        if(MenuAwardPage*AchPerPage()>=count){MenuAwardPage=count>0?(count-1)/AchPerPage():0;}
        if(AchPage*AchPerPage()>=count){AchPage=count>0?(count-1)/AchPerPage():0;}
    }
    static string MapKey(int mode) { return mode==0?"wild":(mode==1?"danger":"extreme"); }
    static int MapCount(int mode) { int n=0;for(int i=0;i<Model.Data.Maps.Count;i=i+1){if(Model.Data.Maps[i].Text("mode")==MapKey(mode)){n=n+1;}}return n; }
    static int MapRowAt(int mode,int index) { int n=0;for(int i=0;i<Model.Data.Maps.Count;i=i+1){if(Model.Data.Maps[i].Text("mode")==MapKey(mode)){if(n==index){return i;}n=n+1;}}return 0-1; }
    static int RecipeCount() { int n=0;for(int i=0;i<Model.Data.Recipes.Count;i=i+1){if(Model.Data.Recipes[i].Text("skill")==CraftFilter){n=n+1;}}return n; }
    static int RecipeRowAt(int index) { int n=0;for(int i=0;i<Model.Data.Recipes.Count;i=i+1){if(Model.Data.Recipes[i].Text("skill")==CraftFilter){if(n==index){return i;}n=n+1;}}return 0-1; }
    static int ClampPage(int page,int count) { if(count<=0){return 0;}if(page*3>=count){return (count-1)/3;}return page; }
    static void CraftCategory(string skill) { CraftFilter=skill;RecipePage=0;Refresh(); }
    static string CraftLabel(string key) {
        if (key == "fishing") { return "垂钓"; }
        if (key == "herbalism") { return "采药"; }
        if (key == "mining") { return "采矿"; }
        if (key == "brewing") { return "酿造"; }
        if (key == "forging") { return "炼器"; }
        if (key == "alchemy") { return "炼丹"; }
        if (key == "talismans") { return "符箓"; }
        if (key == "formations") { return "阵法"; }
        return key;
    }
    static void MapAction(int mode,int slot) {
        int page=MapPage;if(mode==1){page=MapDPage;}if(mode==2){page=MapEPage;}
        int gi=MapRowAt(mode,page*3+slot);if(gi>=0){Result(Model.StartBattle(gi));}
    }
    static void SkillAction(int slot) { Result(Model.UpgradeSkill(slot)); }
    static void RecipeAction(int slot) { int gi=RecipeRowAt(RecipePage*3+slot);if(gi>=0){Result(Model.StartCraft(gi));} }
    static void UseAction(int slot) { if (slot<BagIds.Count) { if (!Model.UseItem(BagIds[slot])) { Model.Say("此物暂不可使用：请检查境界、气血或配方材料",false); }Refresh(); } }
    static void SellAction(int slot) { if (slot<BagIds.Count) { Result(Model.Sell(BagIds[slot],1)); } }
    static void BuyAction(int slot) { Result(Model.Buy(MarketPage*3+slot)); }
    static void Rebirth() {
        if (!PrestigeArmed) { PrestigeArmed=true;prestige.Text="确认转生 · 重置本世进度";Model.Say("再次点击确认：本世修为与物品重置，天赋及因果保留",true); }
        else { Model.Prestige();PrestigeArmed=false;prestige.Text="转生 · 再续仙缘"; }
        Refresh();
    }
    static int MaxSectRows(List<Row> rows) {int maximum=0;foreach(Row sect in Model.Data.Sects){int count=0;foreach(Row row in rows){if(row.Text("sect")==sect.Id){count=count+1;}}if(count>maximum){maximum=count;}}return maximum;}
    static void FilterBag(int filter) {BagFilter=filter;BagPage=0;Refresh();}
    static bool BagMatches(Row r) {if(r==null){return BagFilter==0;}string t=r.Text("type");return BagFilter==0 || (BagFilter==1 && t=="equipment") || (BagFilter==2 && (t=="alchemy" || t=="pill" || t=="consumable" || t=="breakthrough")) || (BagFilter==3 && (t=="resource" || t=="material")) || (BagFilter==4 && t!="equipment" && t!="alchemy" && t!="pill" && t!="consumable" && t!="breakthrough" && t!="resource" && t!="material");}
    static string ItemName(string id) {return Model.ItemName(id);}
    static string Delta(double n) {return (n>=0?"+":"")+Number(n);}
    static string ItemDetail(string id) {
        Row r=Model.ItemRow(id);
        if(r==null){return "";}string result=r.Text("desc");
        if(r.Text("slot")!="") {Row old=null;string slot=r.Text("slot");if(Model.Equipment.ContainsKey(slot)){old=Model.ItemRow(Model.Equipment[slot]);}
            result=result+"\n攻击 "+Number(Model.GearStat(id,"atk"))+"  防御 "+Number(Model.GearStat(id,"def"))+"  气血 "+Number(Model.GearStat(id,"hp"));
            result=result+"\n对比"+(old==null?"空栏":old.Name)+"：攻 "+Delta(Model.GearStat(id,"atk")-(old==null?0:Model.GearStat(Model.Equipment[slot],"atk")))+" / 防 "+Delta(Model.GearStat(id,"def")-(old==null?0:Model.GearStat(Model.Equipment[slot],"def")))+" / 血 "+Delta(Model.GearStat(id,"hp")-(old==null?0:Model.GearStat(Model.Equipment[slot],"hp")));}
        return result+"\n境界需求 "+r.Text("req")+"层 · 售价 "+Number(Wuwei.Game.Max(1,r.Num("price")*0.35))+" 灵石";
    }
    // 核心契约与语义定义。
    // 核心契约与语义定义。
    static bool UsableItem(Row r,string id) {
        if(r==null){return false;}
        if(id=="treasure_box"||id=="blank_jade_slip"){return true;}
        string t=r.Text("type");
        return t=="equipment"||t=="manual"||t=="formation"||t=="formations"||t=="talisman"||t=="wine"||t=="consumable"||t=="alchemy"||t=="pill"||r.Text("slot")!="";
    }
    static string RecipeDetail(int index) {
        Row r=Model.Data.Recipes[index];string detail=r.Text("desc")+"\n杂学 "+Number(Model.ArtLevel(r.Text("skill")))+" / 需求 "+r.Text("unlock")+"级 · "+r.Text("duration")+"秒\n熟练度 "+Number(Model.Count(Model.Mastery,r.Id))+" · 产出 "+ItemName(r.Text("result"));
        bool cost=false;foreach(Row c in Model.Data.Ingredients){if(c.Text("recipe")==r.Id){cost=true;string id=c.Text("item");detail=detail+"\n"+(id=="stones"?"灵石":ItemName(id))+" "+Number(id=="stones"?Model.Stones:Model.ItemCount(id))+" / "+c.Text("count");}}
        return detail+(cost?"":"\n无需材料 · 可持续采集");
    }
    static Dictionary<string,string> ArtCache=new Dictionary<string,string>();
    static string ToWebp(string file) {
        if(file.Length>4 && file.Substring(file.Length-4)==".png"){return file.Substring(0,file.Length-4)+".webp";}
        return file;
    }
    static string ArtPath(string file) {
        file=ToWebp(file);
        if(ArtCache.ContainsKey(file)){return ArtCache[file];}
        string source="assets/images/"+file;
        if(File.EmbedExists(source)){byte[] bytes=File.ReadAllBytes(source);string key="mem:wuwei:"+file;Canvas.ImageLoadMem(key,bytes,bytes.Length);ArtCache[file]=key;return key;}
        return Root+"/assets/images/"+file;
    }
    static int SectionOfPage(int page) { return page<=2?0:page<=6?1:page==7?2:page<=9?3:page<=12?4:page==13?5:6; }

    // ---- 设计稿事件注册：处理器名与 App.html 的 data-on-click 一一对应 ----
    static void WireEvents() {
        Window.On("menuStart",()=>{OpenMenuPage(1);});
        Window.On("menuSettings",()=>{OpenMenuPage(2);});
        Window.On("menuAchievements",()=>{OpenMenuPage(3);});
        Window.On("menuExit",()=>{Window.GetApp().isRunning=false;});
        Window.On("slotsBack",()=>{OpenMenuPage(0);});
        Window.On("menuContinue",()=>{OpenSlot(ActiveSlot,false);});
        Window.On("menuNew",()=>{NewJourney();});
        for(int i=1;i<=5;i=i+1){int slot=i;Window.On("profile"+Number(slot),()=>{OpenSlot(slot,false);});}
        for(int i=2;i<=5;i=i+1){int slot=i;Window.On("profileDelete"+Number(slot),()=>{AskDelete(slot);});}
        Window.On("menuVolumeDown",()=>{ChangeVolume(-10);});
        Window.On("menuMute",()=>{Music.SetMuted(!Music.Muted());SaveMusic();});
        Window.On("menuVolumeUp",()=>{ChangeVolume(10);});
        Window.On("menuAudioBack",()=>{OpenMenuPage(0);});
        Window.On("menuAwardsBack",()=>{OpenMenuPage(0);});
        Window.On("menuAwardsPrev",()=>{if(MenuAwardPage>0){MenuAwardPage=MenuAwardPage-1;}Refresh();});
        Window.On("menuAwardsNext",()=>{if((MenuAwardPage+1)*AchPerPage()<Model.AchievementCount()){MenuAwardPage=MenuAwardPage+1;}Refresh();});
        for(int i=0;i<7;i=i+1){int index=i;Window.On("nav"+Number(i),()=>{SelectSection(index);});}
        for(int i=0;i<16;i=i+1){if(i==7||i==13){continue;}int target=i;Window.On("tab"+Number(i),()=>{SelectPage(target);});}
        Window.On("fish",()=>{CraftCategory("fishing");});
        Window.On("herbs",()=>{CraftCategory("herbalism");});
        Window.On("mining",()=>{CraftCategory("mining");});
        Window.On("brew",()=>{CraftCategory("brewing");});
        Window.On("forge",()=>{CraftCategory("forging");});
        Window.On("alchemy",()=>{CraftCategory("alchemy");});
        Window.On("talisman",()=>{CraftCategory("talismans");});
        Window.On("formation",()=>{CraftCategory("formations");});
        Window.On("cultivate",()=>{Result(Model.StartCultivation());});
        Window.On("rest",()=>{Model.StopActivity();Model.Say("已出关，静养气血",true);Refresh();});
        Window.On("breakthrough",()=>{Result(Model.Breakthrough());});
        Window.On("questClaim",()=>{Result(Model.ClaimQuest());});
        Window.On("battleStop",()=>{Model.StopActivity();Model.Say("已离开战场，静养气血",true);Refresh();});
        for(int i=0;i<3;i=i+1){int s0=i;Window.On("map"+Number(i),()=>{MapAction(0,s0);});Window.On("mapd"+Number(i),()=>{MapAction(1,s0);});Window.On("mape"+Number(i),()=>{MapAction(2,s0);});Window.On("recipe"+Number(i),()=>{RecipeAction(s0);});}
        for(int i=0;i<SkillSlots;i=i+1){int s0=i;Window.On("skill"+Number(i),()=>{SkillAction(s0);});}
        for(int i=0;i<BagSlots;i=i+1){int s0=i;Window.On("itemUse"+Number(i),()=>{UseAction(s0);});Window.On("itemSell"+Number(i),()=>{SellAction(s0);});Window.On("recycle"+Number(i),()=>{if(s0<BagIds.Count){if(!Model.RecycleGear(BagIds[s0])){Model.Say("仅可分解行囊中的装备",false);}Refresh();}});}
        for(int i=0;i<MarketSlots;i=i+1){int s0=i;Window.On("buy"+Number(i),()=>{BuyAction(s0);});}
        Window.On("mapsPrev",()=>{if(MapPage>0){MapPage=MapPage-1;}Refresh();});
        Window.On("mapsNext",()=>{if((MapPage+1)*3<MapCount(0)){MapPage=MapPage+1;}Refresh();});
        Window.On("mapdPrev",()=>{if(MapDPage>0){MapDPage=MapDPage-1;}Refresh();});
        Window.On("mapdNext",()=>{if((MapDPage+1)*3<MapCount(1)){MapDPage=MapDPage+1;}Refresh();});
        Window.On("mapePrev",()=>{if(MapEPage>0){MapEPage=MapEPage-1;}Refresh();});
        Window.On("mapeNext",()=>{if((MapEPage+1)*3<MapCount(2)){MapEPage=MapEPage+1;}Refresh();});
        Window.On("skillsPrev",()=>{if(SkillPage>0){SkillPage=SkillPage-1;}Refresh();});
        Window.On("skillsNext",()=>{if((SkillPage+1)*3<Model.Data.Skills.Count){SkillPage=SkillPage+1;}Refresh();});
        Window.On("recipesPrev",()=>{if(RecipePage>0){RecipePage=RecipePage-1;}Refresh();});
        Window.On("recipesNext",()=>{if((RecipePage+1)*3<RecipeCount()){RecipePage=RecipePage+1;}Refresh();});
        Window.On("craftStop",()=>{Model.StopActivity();Model.Say("已停下手中事务",true);Refresh();});
        for(int i=0;i<5;i=i+1){int f=i;Window.On("bagFilter"+Number(i),()=>{FilterBag(f);});}
        for(int i=0;i<7;i=i+1){int g=i;string slot=GearSlots[g];Window.On("unequip"+Number(i),()=>{if(!Model.Unequip(slot)){Model.Say("行囊已满或此栏未装备，无法卸下",false);}Refresh();});}
        Window.On("bagPrev",()=>{if(BagPage>0){BagPage=BagPage-1;}Refresh();});
        Window.On("bagNext",()=>{if((BagPage+1)*BagSlots<BagTotal){BagPage=BagPage+1;}Refresh();});
        Window.On("marketPrev",()=>{if(MarketPage>0){MarketPage=MarketPage-1;}Refresh();});
        Window.On("marketNext",()=>{if((MarketPage+1)*MarketSlots<Model.Data.Market.Count){MarketPage=MarketPage+1;}Refresh();});
        for(int i=0;i<Model.Data.Sects.Count;i=i+1){int index=i;Window.On("sect"+Number(i),()=>{Result(Model.JoinSect(index));});}
        Window.On("sectTrain",()=>{if(!Model.TrainSect()){Model.Say("请先加入宗门，并积累520贡献",false);}Refresh();});
        for(int i=0;i<Model.Data.SectTasks.Count;i=i+1){int index=i;Window.On("sectTask"+Number(i),()=>{Result(Model.ClaimSectTask(index));});}
        for(int i=0;i<3;i=i+1){int index=i;Window.On("vault"+Number(i),()=>{Result(Model.ExchangeSectVault(index));});}
        for(int i=0;i<3;i=i+1){int index=i;Window.On("arena"+Number(i),()=>{Result(Model.ArenaFightOpponent(index));});}
        for(int i=0;i<Model.Data.Talents.Count;i=i+1){int index=i;Window.On("talent"+Number(i),()=>{Result(Model.UpgradeTalent(index));});}
        Window.On("prestige",()=>{Rebirth();});
        Window.On("renameProfile",()=>{string name=profileName.GetText();if(name.Length>0 && name.Length<=40){JourneyName=name;SaveNow();}else{Model.Say("仙缘名请输入1至40个字符",false);Refresh();}});
        Window.On("save",()=>{SaveNow();});
        Window.On("autoHeal",()=>{Model.AutoHeal=!Model.AutoHeal;Refresh();});
        Window.On("volumeDown",()=>{ChangeVolume(-10);});
        Window.On("musicMute",()=>{Music.SetMuted(!Music.Muted());SaveMusic();});
        Window.On("volumeUp",()=>{ChangeVolume(10);});
        Window.On("profiles",()=>{ShowMenu();});
        Window.On("achPrev",()=>{if(AchPage>0){AchPage=AchPage-1;}Refresh();});
        Window.On("achNext",()=>{if((AchPage+1)*AchPerPage()<Model.AchievementCount()){AchPage=AchPage+1;}Refresh();});
        Window.On("codexPrev",()=>{if(CodexPage>0){CodexPage=CodexPage-1;}Refresh();});
        Window.On("codexNext",()=>{if((CodexPage+1)*6<Model.Data.Enemies.Count+Model.Data.Items.Count){CodexPage=CodexPage+1;}Refresh();});
        Window.On("claimEpiphany",()=>{Model.ClaimEpiphany();Refresh();});
        Window.On("startTribulation",()=>{if(Model.InTribulation()){Model.EndureTribulation();}else{Model.StartTribulation();}Refresh();});
        Window.On("advChoiceA",()=>{Model.ResolveAdventure(0);Refresh();});
        Window.On("advChoiceB",()=>{Model.ResolveAdventure(1);Refresh();});
    }

    // 设计稿建树走 __BuildForm()（生成代码，Build 时由本类手动调用）。
    // 本程序自管 Form 生命周期（设计稿不是首输入，没有生成的 Main），
    // 生成器约定的 OnLoad 钩子留空，装配统一走 Attach()。
    static void OnLoad(Form form) { }
    static void Attach() {
        DialogHost.Pump=PumpDeleteDialog;
        Dialogs=new DialogHost();Dialogs.name="dialogHostHost";Dialogs.DockFill();dialogHost.With(Dialogs);
        for(int i=0;i<7;i=i+1){Nav.Add((Button)Shell.Find("nav"+Number(i)));}
        for(int i=0;i<16;i=i+1){Pages.Add((Flex)center.Find("pageScroll"+Number(i)));}
        for(int i=0;i<7;i=i+1){SectionBars.Add((Flex)subnavs.Find("SectionBar"+Number(i)));}
        for(int i=0;i<16;i=i+1){
            if(i==7||i==13){continue;}
            Button tbtn = (Button)subnavs.Find("tab"+Number(i));
            TabNavBindings.Add(new TabNavBinding(tbtn, i));
        }
        CraftFilterBindings.Add(new CraftFilterBinding(fish, "fishing"));
        CraftFilterBindings.Add(new CraftFilterBinding(herbs, "herbalism"));
        CraftFilterBindings.Add(new CraftFilterBinding(mining, "mining"));
        CraftFilterBindings.Add(new CraftFilterBinding(brew, "brewing"));
        CraftFilterBindings.Add(new CraftFilterBinding(forge, "forging"));
        CraftFilterBindings.Add(new CraftFilterBinding(alchemy, "alchemy"));
        CraftFilterBindings.Add(new CraftFilterBinding(talisman, "talismans"));
        CraftFilterBindings.Add(new CraftFilterBinding(formation, "formations"));
        for(int i=0;i<3;i=i+1){
            MapSlots.Add(new CardActionSlot((Label)center.Find("mapName"+Number(i)), (Label)center.Find("mapDesc"+Number(i)), (Image)center.Find("mapArt"+Number(i)), (Button)center.Find("map"+Number(i))));
            MapDSlots.Add(new CardActionSlot((Label)center.Find("mapdName"+Number(i)), (Label)center.Find("mapdDesc"+Number(i)), (Image)center.Find("mapdArt"+Number(i)), (Button)center.Find("mapd"+Number(i))));
            MapESlots.Add(new CardActionSlot((Label)center.Find("mapeName"+Number(i)), (Label)center.Find("mapeDesc"+Number(i)), (Image)center.Find("mapeArt"+Number(i)), (Button)center.Find("mape"+Number(i))));
            RecipeSlots.Add(new CardActionSlot((Label)center.Find("recipeName"+Number(i)), (Label)center.Find("recipeDesc"+Number(i)), (Image)center.Find("recipeArt"+Number(i)), (Button)center.Find("recipe"+Number(i))));
            VaultSlots.Add(new LabeledButtonSlot((Label)center.Find("vaultLabel"+Number(i)), (Button)center.Find("vault"+Number(i))));
            ArenaSlots.Add(new LabeledButtonSlot((Label)center.Find("arenaLabel"+Number(i)), (Button)center.Find("arena"+Number(i))));
        }
        for(int i=0;i<SkillSlots;i=i+1){
            SkillSlotsList.Add(new CardActionSlot((Label)center.Find("skillName"+Number(i)), (Label)center.Find("skillDesc"+Number(i)), (Image)center.Find("skillArt"+Number(i)), (Button)center.Find("skill"+Number(i))));
        }
        for(int i=0;i<MarketSlots;i=i+1){
            MarketSlotsList.Add(new LabeledButtonSlot((Label)center.Find("marketName"+Number(i)), (Button)center.Find("buy"+Number(i))));
        }
        for(int i=0;i<6;i=i+1){
            TaskSlots.Add(new LabeledButtonSlot((Label)center.Find("taskLabel"+Number(i)), (Button)center.Find("sectTask"+Number(i))));
            CodexLabels.Add((Label)center.Find("codexSlot"+Number(i)));LootLabels.Add((Label)rightbar.Find("loot"+Number(i)));
        }
        for(int i=0;i<4;i=i+1){
            AchLabels.Add((Label)center.Find("achSlot"+Number(i)));
            AchMenu.Add((Label)Menu.Find("achMenu"+Number(i)));
            TalentSlots.Add(new LabeledButtonSlot((Label)center.Find("talentLabel"+Number(i)), (Button)center.Find("talent"+Number(i))));
        }
        for(int i=0;i<7;i=i+1){
            EquippedSlots.Add(new LabeledButtonSlot((Label)center.Find("gearLabel"+Number(i)), (Button)center.Find("unequip"+Number(i))));
        }
        for(int i=0;i<8;i=i+1){StatVals.Add((Label)rightbar.Find("statVal"+Number(i)));}
        for(int i=0;i<BagSlots;i=i+1){
            BagControls.Add(new BagSlotControls((Image)center.Find("bagArt"+Number(i)), (Label)center.Find("bagName"+Number(i)), (Label)center.Find("bagDesc"+Number(i)), (Button)center.Find("itemUse"+Number(i)), (Button)center.Find("itemSell"+Number(i)), (Button)center.Find("recycle"+Number(i))));
        }
        for(int i=0;i<5;i=i+1){ProfileLabels.Add((Label)Slots.Find("profileLabel"+Number(i+1)));}
        for(int i=2;i<=5;i=i+1){SlotDelete.Add((Button)Slots.Find("profileDelete"+Number(i)));}
        for(int i=0;i<Model.Data.Sects.Count;i=i+1){SectButtons.Add((Button)center.Find("sect"+Number(i)));}
        for(int i=0;i<7;i=i+1){GearSlots.Add(i==0?"weapon":i==1?"head":i==2?"robe":i==3?"boots":i==4?"bracers":i==5?"amulet":"ring");}
        SeedProbeButtons();
        ArtAssign();
        WireEvents();
    }
    // gameplay.ui 的 clickid @name 通过 id.<name> 探针解析；把测试面用
    // 到的按钮全部收编进 ProbeButtons（类型化字段直取，不走字符串 Find）。
    static void SeedProbeButtons() {
        ProbeButtons.Add(menuStart);ProbeButtons.Add(menuSettings);ProbeButtons.Add(menuAchievements);ProbeButtons.Add(menuExit);
        ProbeButtons.Add(slotsBack);ProbeButtons.Add(menuContinue);ProbeButtons.Add(menuNew);
        ProbeButtons.Add(profile1);ProbeButtons.Add(profile2);ProbeButtons.Add(profile3);ProbeButtons.Add(profile4);ProbeButtons.Add(profile5);
        ProbeButtons.Add(profileDelete2);ProbeButtons.Add(profileDelete3);ProbeButtons.Add(profileDelete4);ProbeButtons.Add(profileDelete5);
        ProbeButtons.Add(menuVolumeDown);ProbeButtons.Add(menuMute);ProbeButtons.Add(menuVolumeUp);
        ProbeButtons.Add(menuAudioBack);ProbeButtons.Add(menuAwardsBack);ProbeButtons.Add(menuAwardsPrev);ProbeButtons.Add(menuAwardsNext);
        ProbeButtons.Add(cultivate);ProbeButtons.Add(rest);ProbeButtons.Add(breakthrough);ProbeButtons.Add(questClaim);ProbeButtons.Add(battleStop);ProbeButtons.Add(craftStop);
        ProbeButtons.Add(sectTrain);ProbeButtons.Add(prestige);ProbeButtons.Add(renameProfile);ProbeButtons.Add(save);ProbeButtons.Add(autoHeal);
        ProbeButtons.Add(volumeDown);ProbeButtons.Add(musicMute);ProbeButtons.Add(volumeUp);ProbeButtons.Add(profiles);
        ProbeButtons.Add(achPrev);ProbeButtons.Add(achNext);ProbeButtons.Add(codexPrev);ProbeButtons.Add(codexNext);
        ProbeButtons.Add(bagPrev);ProbeButtons.Add(bagNext);ProbeButtons.Add(marketPrev);ProbeButtons.Add(marketNext);
        ProbeButtons.Add(mapsPrev);ProbeButtons.Add(mapsNext);ProbeButtons.Add(mapdPrev);ProbeButtons.Add(mapdNext);
        ProbeButtons.Add(mapePrev);ProbeButtons.Add(mapeNext);ProbeButtons.Add(skillsPrev);ProbeButtons.Add(skillsNext);
        ProbeButtons.Add(recipesPrev);ProbeButtons.Add(recipesNext);
        Button[] filters=new Button[]{bagFilter0,bagFilter1,bagFilter2,bagFilter3,bagFilter4};
        for(int i=0;i<filters.Length;i=i+1){ProbeButtons.Add(filters[i]);}
        for(int i=0;i<Nav.Count;i=i+1){ProbeButtons.Add(Nav[i]);}
        for(int i=0;i<TabNavBindings.Count;i=i+1){ProbeButtons.Add(TabNavBindings[i].button);}
        for(int i=0;i<CraftFilterBindings.Count;i=i+1){ProbeButtons.Add(CraftFilterBindings[i].button);}
        for(int i=0;i<3;i=i+1){ProbeButtons.Add(MapSlots[i].button);ProbeButtons.Add(MapDSlots[i].button);ProbeButtons.Add(MapESlots[i].button);}
        for(int i=0;i<SkillSlots;i=i+1){ProbeButtons.Add(SkillSlotsList[i].button);}
        for(int i=0;i<3;i=i+1){ProbeButtons.Add(RecipeSlots[i].button);}
        for(int i=0;i<BagSlots;i=i+1){ProbeButtons.Add(BagControls[i].use);ProbeButtons.Add(BagControls[i].sell);ProbeButtons.Add(BagControls[i].recycle);}
        for(int i=0;i<MarketSlots;i=i+1){ProbeButtons.Add(MarketSlotsList[i].button);}
        for(int i=0;i<7;i=i+1){ProbeButtons.Add(EquippedSlots[i].button);}
        for(int i=0;i<6;i=i+1){ProbeButtons.Add(TaskSlots[i].button);}
        for(int i=0;i<4;i=i+1){ProbeButtons.Add(TalentSlots[i].button);}
        for(int i=0;i<3;i=i+1){ProbeButtons.Add(VaultSlots[i].button);ProbeButtons.Add(ArenaSlots[i].button);}
        for(int i=0;i<SectButtons.Count;i=i+1){ProbeButtons.Add(SectButtons[i]);}
        for(int i=0;i<SlotDelete.Count;i=i+1){ProbeButtons.Add(SlotDelete[i]);}
        EpiphanyBox=(Flex)center.Find("epiphanyBox");
        ClaimEpiphanyBtn=(Button)center.Find("claimEpiphany");
        TribulationInfoLbl=(Label)center.Find("TribulationInfo");
        StartTribulationBtn=(Button)center.Find("startTribulation");
        CombatLog0=(Label)center.Find("CombatLogLine0");
        CombatLog1=(Label)center.Find("CombatLogLine1");
        CombatLog2=(Label)center.Find("CombatLogLine2");
        MeditationLog0=(Label)center.Find("MeditationLogLine0");
        MeditationLog1=(Label)center.Find("MeditationLogLine1");
        MeditationLog2=(Label)center.Find("MeditationLogLine2");
        AdventureBox=(Flex)center.Find("adventureBox");
        AdventureDescLbl=(Label)center.Find("AdventureDesc");
        AdvChoiceABtn=(Button)center.Find("advChoiceA");
        AdvChoiceBBtn=(Button)center.Find("advChoiceB");
        SkillTotalMasteryLbl=(Label)center.Find("SkillTotalMastery");
        SkillBonusAtkLbl=(Label)center.Find("SkillBonusAtk");
        SkillBonusDefLbl=(Label)center.Find("SkillBonusDef");
        SkillBonusQiLbl=(Label)center.Find("SkillBonusQi");
        SkillBonusHpLbl=(Label)center.Find("SkillBonusHp");
        SkillBonusXpLbl=(Label)center.Find("SkillBonusXp");
        SkillMasteryInsightLbl=(Label)center.Find("SkillMasteryInsight");
        if(ClaimEpiphanyBtn!=null){ProbeButtons.Add(ClaimEpiphanyBtn);}
        if(StartTribulationBtn!=null){ProbeButtons.Add(StartTribulationBtn);}
        if(AdvChoiceABtn!=null){ProbeButtons.Add(AdvChoiceABtn);}
        if(AdvChoiceBBtn!=null){ProbeButtons.Add(AdvChoiceBBtn);}
    }
    // 设计稿里的静态图 src 是相对路径，运行时按嵌入资源改写成 mem: 键
    // （LoadFrame 第 2 步已预热的同一张图）；动态槽位图由 Refresh 逐帧喂。
    static void ArtAssign() {
        menuBackground.Src=ArtPath("main_menu_bg.webp");
        menuTitle.Src=ArtPath("title_calligraphy.webp");
        worldBackground.Src=ArtPath("qingzhu_ridge.webp");
        navLogo.Src=ArtPath("logo.webp");
        culIcon.Src=ArtPath("icon_mind_skill.webp");
        breakIcon.Src=ArtPath("alchemy_breakthrough_pill.webp");
    }

    static void PublishProbes() {
        // 核心契约与语义定义。
        // 核心契约与语义定义。
        if(!UiDriver.Active()){return;}
        UiDriver.SetProbe("ready",Ready?"1":"0");UiDriver.SetProbe("loadStep",Number(LoadStep));if(!Ready){return;}
        UiDriver.SetProbe("menuPage",Number(MenuPage));
        UiDriver.SetProbe("menu",InMenu?"1":"0");UiDriver.SetProbe("profile",Number(ActiveSlot));UiDriver.SetProbe("bagFilter",Number(BagFilter));UiDriver.SetProbe("prestigeArmed",PrestigeArmed?"1":"0");UiDriver.SetProbe("ascended",Model.Ascended?"1":"0");UiDriver.SetProbe("musicVolume",Number(Music.Volume()));UiDriver.SetProbe("page",Number(Page));UiDriver.SetProbe("section",Number(Section));UiDriver.SetProbe("activity",Number(Model.Activity));UiDriver.SetProbe("level",Number(Model.Level));UiDriver.SetProbe("stones",Number(Model.Stones));UiDriver.SetProbe("saveStatus",SaveStatus);
        UiDriver.SetProbe("recipeFilter",CraftFilter);UiDriver.SetProbe("recipePage",Number(RecipePage));UiDriver.SetProbe("recipePages",Number((RecipeCount()+2)/3));
        string slotSkills="";for(int s=0;s<3;s=s+1){int gi=RecipeRowAt(RecipePage*3+s);slotSkills=slotSkills+(gi>=0?Model.Data.Recipes[gi].Text("skill"):"-")+(s<2?" ":"");}
        UiDriver.SetProbe("recipeSkills",slotSkills);
        UiDriver.SetProbe("musicPlaying",Music.IsPlaying()?"1":"0");UiDriver.SetProbe("musicError",Music.Error());
        UiDriver.SetProbe("embeddedArt",File.EmbedExists("assets/images/main_menu_bg.webp")?"1":"0");UiDriver.SetProbe("embeddedMusic",File.EmbedExists("assets/audio/bgm_main.ogg")?"1":"0");UiDriver.SetProbe("embeddedBaseSkin",File.EmbedExists("skins/base.css")?"1":"0");
        UiDriver.SetProbe("menuArtLoaded",Canvas.ImageWidth(ArtPath("main_menu_bg.webp"))>0 && Canvas.ImageHeight(ArtPath("main_menu_bg.webp"))>0?"1":"0");
        UiDriver.SetProbe("autoHeal",Model.AutoHeal?"1":"0");UiDriver.SetProbe("musicAdjusted",Number(Model.Count(Model.RunState,"music_adjusted")));UiDriver.SetProbe("manualSaves",Number(Model.ManualSaves));
        UiDriver.SetProbe("deleteAsk",DeleteArmed>0?"1":"0");
        // 核心契约与语义定义。
        for(int i=0;i<ProbeButtons.Count;i=i+1){
            Button b=ProbeButtons[i];
            UiDriver.SetProbe("id."+b.name,Number(b.wid));
        }
    }

    static void Refresh() {
        if(Model==null || Model.Data==null){return;}
        PublishProbes();
        ClampAchPages();
        Shell.visible=!InMenu;Menu.visible=InMenu;
        Landing.visible=MenuPage==0;Slots.visible=MenuPage==1;MenuSettings.visible=MenuPage==2;MenuAchievements.visible=MenuPage==3;
        MenuMusicStatus.Text="音量 "+Number(Music.Volume())+"% · "+(Music.Muted()?"已静音":Music.IsPlaying()?"播放中":"未播放")+(Music.Error()!=""?" · "+Music.Error():"");
        for(int s=0;s<4;s=s+1){int ai=MenuAwardPage*AchPerPage()+s;Row a=ai<Model.AchievementCount()?Model.AchievementRow(ai):null;if(a!=null){AchMenu[s].Text=(Model.AchievementUnlocked(ai)?"已达成 · ":"未达成 · ")+a.Name+"\n"+a.Text("desc");}else{AchMenu[s].Text="";AchMenu[s].visible=false;}}
        MenuAwardCounter.Text="第 "+Number(MenuAwardPage+1)+" / "+Number((Model.AchievementCount()+AchPerPage()-1)/AchPerPage())+" 页";
        for(int i=0;i<7;i=i+1){string want=(!InMenu && Section==i)?"navsec navsec-current medium":"navsec medium";if(Nav[i].Class!=want){Nav[i].Class=want;}}
        for(int i=0;i<7;i=i+1){SectionBars[i].visible=!InMenu && Section==i;}
        for(int i=0;i<TabNavBindings.Count;i=i+1){
            TabNavBinding tb=TabNavBindings[i];
            string want=(!InMenu && Page==tb.page)?"tab tab-current medium":"tab medium";
            if(tb.button.Class!=want){tb.button.Class=want;}
        }
        for(int i=0;i<CraftFilterBindings.Count;i=i+1){
            CraftFilterBinding cb=CraftFilterBindings[i];
            string want=(!InMenu && CraftFilter==cb.key)?"tab tab-current medium":"tab medium";
            if(cb.button.Class!=want){cb.button.Class=want;}
        }
        if(InMenu){return;}
        for(int i=0;i<16;i=i+1){Pages[i].visible=i==Page;}
        NameText.Text=JourneyName;
        RealmText.Text=Model.RealmName()+" "+Number(Model.Layer())+" 层";
        AgeText.Text="年龄 "+Number(Model.Age());
        LifeText.Text="寿元 "+Number(Model.Lifespan()-Model.Age())+" 年";
        StonesText.Text="灵石 "+Number(Model.Stones);
        XpText.Text="修为 "+Number(Model.Xp);
        ActivityText.Text=Model.Activity==1?"【入定闭关】引气通经，周天运转":Model.Activity==2?"【山海历练】纵剑斩妖，行侠四方":Model.Activity==3?"【修习百艺】参悟造化，丹符双绝":"【洞府静养】灵台澄澈，调和龙虎";
        Notice.Text=Model.LastMessage;
        QiText.Text="真元充盈："+Number(Model.Qi)+" / "+Number(Model.QiNeed())+"  ("+(Model.QiNeed()>0?Number((int)(Model.Qi*100/Model.QiNeed())):"0")+"%)";
        QiRateText.Text="周天转化效率：每秒凝练 "+Number(Model.CultivationRate())+" 点真元 · 灵气温润通达";
        if(MeditationLog0!=null&&MeditationLog1!=null&&MeditationLog2!=null){
            int mcount=Model.MeditationLog.Count;
            MeditationLog0.Text=mcount>=3?Model.MeditationLog[mcount-3]:"";
            MeditationLog1.Text=mcount>=2?Model.MeditationLog[mcount-2]:"";
            MeditationLog2.Text=mcount>=1?Model.MeditationLog[mcount-1]:(Model.Activity==1?"【大周天运转】引天地菁华贯注百会，真元游走奇经八脉。":"【洞府静室】燃一炉檀香，静候入定吐纳运转周天。");
        }
        bool breakReady=!Model.NeedsPrestige&&Model.Layer()==12&&Model.Realm()<8&&Model.Qi>=Model.QiNeed();
        string pillName=Model.Realm()<8?Model.Data.Realms[Model.Realm()].Text("pill"):"";bool hasPill=pillName!=""&&Model.ItemCount(pillName)>0;
        breakthrough.Disabled=!breakReady||!hasPill;
        breakthrough.Tip=!breakReady?(Model.Layer()!=12?"需当前境界修至十二层圆满":(Model.Realm()<8?"需闭关进度圆满 · 当前 "+Number(Model.Qi)+" / "+Number(Model.QiNeed()):"此境已至巅峰")):(hasPill?("条件齐备 · 消耗一枚"+ItemName(pillName)+"即可破境"):("缺少 "+(pillName==""?"破境丹":ItemName(pillName))+" · 绝境首领首杀必得"));
        BreakInfo.Text=Model.RealmName()+" "+Number(Model.Layer())+"层 · "+breakthrough.Tip;
        cultivate.Disabled=Model.NeedsPrestige||Model.Activity==1;cultivate.Tip=Model.Activity==1?"已在闭关中 · 可出关休息":"将修为经验转化为闭关进度，圆满后可破境";rest.Disabled=Model.Activity==0;rest.Tip=Model.Activity==0?"当前静养，无需出关":"结束当前闭关，静养恢复";battleStop.Disabled=Model.Activity!=2;craftStop.Disabled=Model.Activity!=3;
        QiBar.SetPercent((int)(Model.Qi*100/Model.QiNeed()));HpBar.SetPercent((int)(Model.Hp*100/Model.MaxHp()));
        if(Model.QuestIndex<Model.Data.Quests.Count){Row q=Model.Data.Quests[Model.QuestIndex];QuestTitle.Text=q.Text("chapter")+"\n"+q.Name;QuestBody.Text=q.Text("objective");QuestReward.Text="奖励  灵石 "+q.Text("stones")+" · 修为 "+q.Text("xp");QuestBar.SetPercent((int)(Model.QuestProgress()*100/q.Num("target")));questClaim.Disabled=Model.QuestProgress()<q.Num("target");}else{QuestTitle.Text="仙途未尽";QuestBody.Text="传承已收，余路由你。";questClaim.Disabled=true;}
        MapPage=ClampPage(MapPage,MapCount(0));MapDPage=ClampPage(MapDPage,MapCount(1));MapEPage=ClampPage(MapEPage,MapCount(2));
        MapCounter.Text="第 "+Number(MapPage+1)+" / "+Number((MapCount(0)+2)/3)+" 页";
        MapDCounter.Text="第 "+Number(MapDPage+1)+" / "+Number((MapCount(1)+2)/3)+" 页";
        MapECounter.Text="第 "+Number(MapEPage+1)+" / "+Number((MapCount(2)+2)/3)+" 页";
        FillMapSlots(MapSlots,0,MapPage);
        FillMapSlots(MapDSlots,1,MapDPage);
        FillMapSlots(MapESlots,2,MapEPage);
        SkillCounter.Text="十大真传功法全览";
        int totalSkillMastery=0;
        for(int s=0;s<SkillSlots;s=s+1){
            bool exists=s<Model.Data.Skills.Count;
            CardActionSlot skSlot=SkillSlotsList[s];
            skSlot.button.visible=exists;
            skSlot.image.visible=exists;
            if(exists){
                Row sk=Model.Data.Skills[s];
                int slevel=Model.Skill(sk.Id);
                totalSkillMastery=totalSkillMastery+slevel;
                skSlot.name.Text=sk.Name+" · "+Number(slevel)+"层";
                skSlot.image.Src=ArtPath(sk.Text("icon"));
                skSlot.detail.Text=sk.Text("desc")+"\n需求 "+sk.Text("req")+" 层 · 上限 "+sk.Int("max_level")+" 层";
                if(slevel>=sk.Int("max_level")){
                    skSlot.button.Text="已臻圆满";
                }else{
                    skSlot.button.Text="参悟 ("+Number(Model.SkillCost(s))+")";
                }
                skSlot.button.Tip=sk.Text("desc")+"\n境界需求 "+sk.Text("req")+" 层 · 上限 "+sk.Int("max_level")+" 层 · 消耗 "+Number(Model.SkillCost(s))+" 修为";
                skSlot.button.Disabled=Model.NeedsPrestige||Model.Level<sk.Int("req")||slevel>=sk.Int("max_level")||Model.Xp<Model.SkillCost(s);
            }
        }
        if(SkillTotalMasteryLbl!=null){
            SkillTotalMasteryLbl.Text="当前已悟透："+Number(totalSkillMastery)+" 重天道秘录";
        }
        if(SkillBonusAtkLbl!=null){
            SkillBonusAtkLbl.Text="攻伐：+"+Number(Model.Skill("attack")*2);
        }
        if(SkillBonusDefLbl!=null){
            SkillBonusDefLbl.Text="免伤："+Number(Model.Skill("guard")*0.6)+"%";
        }
