            SkillBonusQiLbl.Text="聚气：+"+Number(Model.Skill("mind")*10)+"%";
        }
        if(SkillBonusHpLbl!=null){
            SkillBonusHpLbl.Text="气血：+"+Number(Model.Skill("spring")*0.8)+"%";
        }
        if(SkillBonusXpLbl!=null){
            SkillBonusXpLbl.Text="阅历：+"+Number(Model.Skill("spirit_refining")*5)+"%";
        }
        if(SkillMasteryInsightLbl!=null){
            string insight="初窥门径 · 大道三千各蕴玄机，参悟十方秘典可奠定无暇仙基。";
            if(totalSkillMastery>=150){insight="天人合一 · 诸般神通道法融会贯通，肉身神魂无漏无垢，直指长生大道！";}
            else if(totalSkillMastery>=80){insight="炉火纯青 · 杀伐御敌吐纳尽皆了然于心，周天真元凝炼纯粹，气象万千。";}
            else if(totalSkillMastery>=30){insight="融会贯通 · 经脉百骸皆有道韵流转，举手投足暗合天地法则，威能卓绝。";}
            else if(totalSkillMastery>=10){insight="略有小成 · 吞吐灵机神意初聚，对攻伐身法已有独到领会，根基渐稳。";}
            SkillMasteryInsightLbl.Text=insight;
        }
        RecipePage=ClampPage(RecipePage,RecipeCount());
        RecipeCounter.Text="第 "+Number(RecipePage+1)+" / "+Number((RecipeCount()+2)/3)+" 页";
        for(int s=0;s<3;s=s+1){
            int ri=RecipeRowAt(RecipePage*3+s);
            CardActionSlot rSlot=RecipeSlots[s];
            rSlot.button.visible=ri>=0;
            if(ri>=0){
                Row r=Model.Data.Recipes[ri];
                rSlot.name.Text=r.Name;
                rSlot.image.Src=ArtPath(r.Text("image"));
                rSlot.detail.Text=r.Text("desc")+"\n杂学 "+Number(Model.ArtLevel(r.Text("skill")))+" / 需求 "+r.Text("unlock")+" · "+r.Text("duration")+"秒";
                rSlot.button.Text=r.Text("kind")=="gather"?"开始采集":"开始制作";
                rSlot.button.Disabled=Model.NeedsPrestige||!Model.CanCraft(ri);
                rSlot.button.Tip=RecipeDetail(ri)+(Model.CanCraft(ri)?"":"\n材料或杂学等级不足，暂不可开始");
            }else{
                rSlot.name.Text="百艺尽览";
                rSlot.detail.Text="";
