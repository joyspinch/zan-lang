        BagCounter.Text="筛选 "+Number(BagTotal)+" / 行囊 "+Number(Model.Inventory.Count)+" 类 · 第 "+Number(BagPage+1)+" / "+Number(maxBagPage)+" 页";
        int maxMPage=Model.Data.Market.Count<=0?1:(Model.Data.Market.Count+MarketSlots-1)/MarketSlots;
        MarketCounter.Text="第 "+Number(MarketPage+1)+" / "+Number(maxMPage)+" 页";
        for(int s=0;s<MarketSlots;s=s+1){
