using System;
using System.Text;
namespace Wuwei;

// Headless deterministic model. All clocks are real seconds; UI calls Tick with elapsed time.
// Activity: 0 rest, 1 cultivation, 2 battle, 3 craft. Offline follows the identical fixed-step path.
class Game {
    public Tables Data;
    // Save/UI layer assigns UTC epoch seconds immediately before Serialize.
    public long SavedUnixSeconds=0;
    public int Level=1; public double Xp=0; public double Qi=0; public double Stones=0;
    public double Hp=100; public double AgeSeconds=0; public double PlayedSeconds=0;
    public int Activity=0; public int MapIndex=0; public int EnemyIndex=0; public int Wave=1;
    public double EnemyHp=0; public double EnemyMaxHp=0; public double PlayerClock=0; public double EnemyClock=0;
    public int RecipeIndex=0; public double CraftProgress=0; public double Recovery=0; public double StepRemainder=0;
    public int SectIndex=-1; public int SectManual=0; public double Contribution=0;
    public int QuestIndex=0; public double CultivationSeconds=0; public int Kills=0; public int TotalKills=0;
    public int CraftCount=0; public int GatherCount=0; public int Purchases=0; public int ManualSaves=0;
    public int BossKills=0; public int Rebirths=0; public int Karma=0; public int LifetimeKarma=0;
    public int SpiritRoot=0; public int Constitution=0; public int Insight=0; public int Fortune=0;
    public double PermanentHp=0; public double PermanentAttack=0; public double PermanentDefense=0;
    public bool NeedsPrestige=false; public bool Ascended=false; public bool AutoHeal=true;
    public string Formation=""; public int FormationStars=1; public string Wine=""; public double WineSeconds=0;
    public string LastMessage="仙途初启。先历练积累修为，再闭关提升境界。";
    public int Seed=27183;
    public Dictionary<string,int> Inventory=new Dictionary<string,int>();
    public Dictionary<string,int> SkillLevels=new Dictionary<string,int>();
    public Dictionary<string,int> ArtLevels=new Dictionary<string,int>();
    public Dictionary<string,int> ArtXp=new Dictionary<string,int>();
    public Dictionary<string,int> Mastery=new Dictionary<string,int>();
    public Dictionary<string,int> EnemyKills=new Dictionary<string,int>();
    public Dictionary<string,int> MapKills=new Dictionary<string,int>();
    public Dictionary<string,int> Crafted=new Dictionary<string,int>();
    public Dictionary<string,int> BossClears=new Dictionary<string,int>();
    public Dictionary<string,int> SectClaims=new Dictionary<string,int>();
    public Dictionary<string,string> Equipment=new Dictionary<string,string>();
    public Dictionary<string,int> Achievements=new Dictionary<string,int>();
    public Dictionary<string,int> AchievementStats=new Dictionary<string,int>();
    public Dictionary<string,int> Collections=new Dictionary<string,int>();
    public Dictionary<string,int> ArenaState=new Dictionary<string,int>();
    public Dictionary<string,int> RunState=new Dictionary<string,int>();
    public Dictionary<string,int> GearQualities=new Dictionary<string,int>();
    public Dictionary<string,int> WineTimers=new Dictionary<string,int>();
    public Dictionary<string,string> GearBases=new Dictionary<string,string>();
    public Dictionary<string,string> Loadout=new Dictionary<string,string>();
    public List<string> Log=new List<string>();
    public List<string> CombatLog=new List<string>();
    public string LastCombatLog="";
    public int TribulationWave=0;
    public int AdventureEvent=0;
    public string AdventureTitle="";
    public string AdventureDesc="";
    public string AdventureChoiceA="";
    public string AdventureChoiceB="";
    public double AdventureClock=0;
    public double EpiphanyClock=0;

    public void AddCombat(string msg) {
        LastCombatLog=msg;
        CombatLog.Add(msg);
        if (CombatLog.Count>40) { CombatLog.RemoveAt(0); }
    }
    public bool HasEpiphany() { return Count(RunState,"epiphany")>0; }
    public bool TriggerEpiphany() {
        if (Activity==1 && Count(RunState,"epiphany")==0) {
            RunState["epiphany"]=1;
            Say("【灵光一闪】闭关中忽感天地大道，点击顿悟可炼化大笔修为！",true);
            return true;
        }
        return false;
    }
    public bool ClaimEpiphany() {
        if (Count(RunState,"epiphany")==0) { return false; }
        RunState["epiphany"]=0;
        double reward=Max(30,QiNeed()*0.15*(1+Insight*0.05));
        Xp=Xp+reward;
        Qi=Min(QiNeed(),Qi+reward);
        Say("【顿悟天地】心神通明，一念破执，瞬间炼化修为 +"+Convert.ToString((int)reward)+"！",true);
        return true;
    }
    public string SpiritRootName() {
        if (SpiritRoot<=0) { return "四系杂灵根"; }
        if (SpiritRoot==1) { return "三系真灵根"; }
        if (SpiritRoot==2) { return "双系地灵根"; }
        if (SpiritRoot==3) { return "单系天灵根"; }
        return "混元天灵根";
    }
    public bool InTribulation() { return TribulationWave>0; }
    public bool StartTribulation() {
        if (NeedsPrestige || Layer()!=12 || Realm()>=8 || Qi<QiNeed()) { return Say("尚未达到破境渡劫条件",false); }
        string pill=Data.Realms[Realm()].Text("pill");
        if (ItemCount(pill)<1) { return Say("缺少破境丹，绝境首领首杀必得",false); }
        TribulationWave=1;
        StopActivity();
        AddCombat("【劫云压顶】九天雷云聚拢，紫电滚滚！大境界天劫降临，请硬抗三道雷劫！");
        return Say("天劫降临，运功抵御雷劫！",true);
    }
    public bool EndureTribulation() {
        if (TribulationWave<=0 || TribulationWave>3) { return false; }
        double rawDmg=100+Realm()*180+TribulationWave*60;
        double dmg=Max(20,rawDmg*100/(100+Defense()*1.2));
        if (ConsumeTalisman("talisman_golden_armor")) { dmg=dmg*0.5; AddCombat("【金甲符护体】金光大作，削弱了雷劫五成威力！"); }
        Hp=Hp-dmg;
        AddCombat("【轰隆！】第 "+Convert.ToString(TribulationWave)+" 道天雷劈落，击碎护体罡气，造成 -"+Convert.ToString((int)dmg)+" 气血！");
        if (Hp<=0) {
            Hp=Max(10,MaxHp()*0.2);
            TribulationWave=0;
            AddCombat("【渡劫未竟】雷威浩荡，护身玉符碎裂保住一命！请巩固底蕴再行渡劫。");
            return Say("渡劫受创，退回打坐调息",false);
        }
        if (TribulationWave==3) {
            TribulationWave=0;
            string pill=Data.Realms[Realm()].Text("pill");
            TakeItem(pill,1);
            Qi=0;Level=Level+1;Hp=MaxHp();GainKarma(5);
            AddCombat("【雷云消散】漫天祥云垂落，九色灵雨涤荡肉身！成功晋升 "+RealmName()+"！");
            return Say("渡劫功成 · 晋升 "+RealmName(),true);
        }
        TribulationWave=TribulationWave+1;
        return true;
    }
    public bool HasAdventure() { return AdventureEvent>0; }
    public void TriggerAdventure() {
        if (AdventureEvent>0) { return; }
        int ev=1+Random(4);
        AdventureEvent=ev;
        if (ev==1) {
            AdventureTitle="【古仙遗府】";
            AdventureDesc="你在密林隐蔽处发现一座古修洞府，外围残留微弱禁制波动。";
            AdventureChoiceA="强行破禁（搜刮宝物，消耗部分气血）";
            AdventureChoiceB="参悟阵纹（静心观摩，增加修为感悟）";
        } else if (ev==2) {
            AdventureTitle="【灵泉异果】";
            AdventureDesc="幽潭深处生长着一株散发微光的朱果，周围似乎有微弱灵气流转。";
            AdventureChoiceA="冒险采摘（夺得灵果，瞬间暴涨修为）";
            AdventureChoiceB="谨慎绕行（收敛心神，不招惹因果）";
        } else if (ev==3) {
            AdventureTitle="【负伤道友】";
            AdventureDesc="一名宗门同道倒在石壁旁，血流不止，向你微弱呼救。";
            AdventureChoiceA="赠药救治（消耗1颗回春丹，获赠灵石与因果）";
            AdventureChoiceB="取其行囊（夺取灵石，但天道因果受损）";
        } else {
            AdventureTitle="【大能残魂】";
            AdventureDesc="一道游离于天地间的大能游魂掠过，审视着你的道心。";
            AdventureChoiceA="诚心请益（聆听教诲，收获大量感悟）";
            AdventureChoiceB="谨守灵台（守元固本，气血完全回复）";
        }
        Say("【山海奇遇】历练途中触发："+AdventureTitle,true);
    }
    public bool ResolveAdventure(int choice) {
        if (AdventureEvent==0) { return false; }
        int ev=AdventureEvent;
        AdventureEvent=0;
        if (ev==1) {
            if (choice==0) {
                Hp=Max(10,Hp-MaxHp()*0.2);
                int lootStones=50+Level*10;
                Stones=Stones+lootStones;
                AddItem("ore_iron",2);
                Say("你强行震碎洞府禁制，虽被轻伤，但搜获 "+Convert.ToString(lootStones)+" 灵石与精矿！",true);
            } else {
                double xpGain=QiNeed()*0.1;
                Xp=Xp+xpGain;
                GainKarma(2);
                Say("你细心推演禁制生克，心得大进（修为 +"+Convert.ToString((int)xpGain)+"，因果 +2）！",true);
            }
        } else if (ev==2) {
            if (choice==0) {
                double boost=QiNeed()*0.15;
                Xp=Xp+boost;
                Qi=Min(QiNeed(),Qi+boost);
                Say("你灵敏采得朱果服下，周身灵气奔腾暴涨 +"+Convert.ToString((int)boost)+"！",true);
            } else {
                Say("你收敛气息悄然退去，道心古井无波，未沾因果。",true);
            }
        } else if (ev==3) {
            if (choice==0) {
                if (TakeItem("alchemy_heal_pill",1)) {
                    GainKarma(5);
                    Stones=Stones+100;
                    Say("道友感激涕零，赠你 100 灵石以表谢意，天道因果 +5！",true);
                } else {
                    Say("你囊中无回春丹，只得留下金疮药草后匆匆离去。",false);
                }
            } else {
                int steal=80+Level*15;
                Stones=Stones+steal;
                Karma=(int)Max(0,Karma-4);
                Say("你取走其随身行囊（灵石 +"+Convert.ToString(steal)+"），但因果有损（因果 -4）。",false);
            }
        } else {
            if (choice==0) {
                double gain=CultivationRate()*30;
                Xp=Xp+gain;
                Say("高人残魂微微点头，传你一段吐纳口诀，修为增加 +"+Convert.ToString((int)gain)+"！",true);
            } else {
                Hp=MaxHp();
                Say("你严守识海灵台清明，心境沉稳，气血自然回满！",true);
            }
        }
        return true;
    }

    public void Init(string directory) { Data=Tables.Load(directory); ResetRun(); }
    public static double Min(double a,double b) { return a < b ? a : b; }
    public static double Max(double a,double b) { return a > b ? a : b; }
    public int Count(Dictionary<string,int> map,string key) { if (!map.ContainsKey(key)) { return 0; } return map[key]; }
    public void Bump(Dictionary<string,int> map,string key,int amount) { map[key]=Count(map,key)+amount; }
    public bool Say(string message,bool result) { if (Data!=null) {UpdateAchievements();}LastMessage=message; Log.Add(message); if (Log.Count > 40) { Log.RemoveAt(0); } return result; }
    public int Realm() { return (Level-1)/12; }
    public int Layer() { return (Level-1)%12+1; }
    public string RealmName() { return Data.Realms[Realm()].Name; }
    public int Skill(string id) { return Count(SkillLevels,id); }
    public int ArtLevel(string id) { return (int)Max(1,Count(ArtLevels,id)); }
    public double Age() { return 16+AgeSeconds/240; }
    public double Lifespan() {
        int r=Realm(); double baseYears=Data.Realms[r].Num("lifespan");
        double next=r == 8 ? 100000 : r == 0 ? 150 : Data.Realms[r+1].Num("lifespan");
        return baseYears+(next-baseYears)*(Layer()-1)/(r == 0 || r == 8 ? 11 : 12)+Constitution*6+Skill("longevity")/2;
    }
    public double Gear(string stat) { double value=0; foreach (string id in Equipment.Values) {value=value+GearStat(id,stat);} return value; }
    public double MaxHp() { return (100+(Level-1)*17+Realm()*55+PermanentHp+Gear("hp"))*(1+Skill("spring")*0.008)*(1+Constitution*0.06)*(1+FormationEffect("hp")); }
    public double Attack() { return (12+(Level-1)*3.2+Realm()*8+Skill("attack")*2.5+PermanentAttack+Gear("atk"))*(SectIndex == 1 ? 1+SectManual*0.015 : 1)*WineMultiplier("atk")*(1+FormationEffect("atk")); }
    public double Defense() { return (2+(Level-1)*1.15+Realm()*4+PermanentDefense+Gear("def"))*(1+FormationEffect("defense"))*WineMultiplier("defense")*(1+Constitution*0.04)*(SectIndex == 0 ? 1+SectManual*0.01 : 1); }
    public double Power() { return Attack()*4+Defense()*3+MaxHp()*0.2; }
    public double QiNeed() { Row r=Data.Realms[Realm()]; if (Layer() == 12 && Realm() < 8) { return r.Num("breakthrough"); } return r.Num("base")+r.Num("step")*(Layer()-1); }
    public double CultivationRate() { return Max(1,(int)((10+Realm()*4)*(1+Skill("mind")*0.1)*(1+SpiritRoot*0.05)*(SectIndex == 0 ? 1+SectManual*0.01 : 1)*(QuestIndex >= Data.Quests.Count ? 1.05 : 1)*(1+FormationEffect("qi"))*WineMultiplier("qi"))); }
    public int Random(int max) { Seed=(Seed*25173+13849)%65536; return Seed%max; }
    public void ResetRun() {
        Level=1;Xp=Data.Rule("initial_xp");Qi=0;Stones=Data.Rule("initial_stones");AgeSeconds=0;
        Activity=0;MapIndex=0;EnemyIndex=0;Wave=1;EnemyHp=0;EnemyMaxHp=0;PlayerClock=0;EnemyClock=0;
        RecipeIndex=0;CraftProgress=0;Recovery=0;StepRemainder=0;SectIndex=-1;SectManual=0;Contribution=0;
        QuestIndex=0;CultivationSeconds=0;Kills=0;CraftCount=0;GatherCount=0;Purchases=0;ManualSaves=0;BossKills=0;
        PermanentHp=0;PermanentAttack=0;PermanentDefense=0;NeedsPrestige=false;Ascended=false;
        Formation="";FormationStars=1;Wine="";WineSeconds=0;
        CombatLog.Clear();LastCombatLog="";TribulationWave=0;AdventureEvent=0;AdventureClock=0;EpiphanyClock=0;
        ArenaState.Clear();RunState.Clear();GearBases.Clear();GearQualities.Clear();WineTimers.Clear();Loadout.Clear();Inventory.Clear();SkillLevels.Clear();ArtLevels.Clear();ArtXp.Clear();Mastery.Clear();EnemyKills.Clear();MapKills.Clear();Crafted.Clear();BossClears.Clear();SectClaims.Clear();Equipment.Clear();
        SkillLevels["attack"]=1;SkillLevels["guard"]=1;SkillLevels["mind"]=1;
        AddItem("alchemy_heal_pill",3);Hp=MaxHp();
    }
    public int ItemCount(string id) { return Count(Inventory,id); }
    public bool AddItem(string id,int amount) {
        if (amount <= 0 || id == "" || ItemRow(id)==null) { return false; }
        Row item=ItemRow(id);
        if (item.Text("slot")!="" && !GearBases.ContainsKey(id)) {
            if (Inventory.Count+amount>(int)Data.Rule("bag_capacity")) {return false;}
            for (int i=0;i<amount;i=i+1) {Bump(RunState,"gear_serial",1);string uid=id+"#"+Convert.ToString(Count(RunState,"gear_serial"));int roll=Random(10000)-Fortune*15;int quality=(int)Max(item.Int("quality"),roll<100 ? 4 : roll<500 ? 3 : roll<1500 ? 2 : roll<4500 ? 1 : 0);GearBases[uid]=id;GearQualities[uid]=quality;Inventory[uid]=1;if (quality==4) {StatMax("SPECIAL_RARITY",1);}}return true;
        }
        if (ItemCount(id) == 0 && Inventory.Count >= (int)Data.Rule("bag_capacity")) { return Say("行囊已满",false); }
        Inventory[id]=(int)Min(Data.Rule("stack_limit"),ItemCount(id)+amount); return true;
    }
    public bool TakeItem(string id,int amount) { if (amount <= 0 || ItemCount(id)<amount) { return false; } int n=ItemCount(id)-amount; if (n == 0) { Inventory.Remove(id); } else { Inventory[id]=n; } return true; }
    public void StopActivity() { Activity=0;CraftProgress=0;PlayerClock=0;EnemyClock=0; }
    public bool StartCultivation() { if (NeedsPrestige || Xp<=0 || Qi>=QiNeed() || Level>=108) { return Say("修为不足或已至圆满",false); } StopActivity();Activity=1;return Say("开始闭关，修为化为根基",true); }
    public bool MapUnlocked(int index) { return index>=0 && index<Data.Maps.Count && Level>=Data.Maps[index].Int("req"); }
    public bool StartBattle(int index) { if (NeedsPrestige || !MapUnlocked(index) || Recovery>0) { return Say("境界不足或正在疗伤",false); } StopActivity();Activity=2;MapIndex=index;Wave=1;Spawn();return Say("前往"+Data.Maps[index].Name,true); }
    public void Spawn() {
        Row map=Data.Maps[MapIndex]; EnemyIndex=map.Int("first_enemy")+(map.Text("mode") == "extreme" ? 0 : Random(map.Int("enemy_count")));
        Row enemy=Data.Enemies[EnemyIndex]; double scale=enemy.Num("scale");
        if (map.Text("mode") == "extreme" && Wave<9) { scale=scale*(0.35+Wave*0.045); }
        EnemyMaxHp=enemy.Num("hp")*scale;EnemyHp=EnemyMaxHp;PlayerClock=0;EnemyClock=0;BattleTalismans();
    }
    public double EnemyScale() { Row m=Data.Maps[MapIndex]; return Data.Enemies[EnemyIndex].Num("scale")*(m.Text("mode") == "extreme" && Wave<9 ? 0.35+Wave*0.045 : 1); }
    public void GainKarma(int n) { Karma=Karma+n;LifetimeKarma=LifetimeKarma+n; }
    public void Victory() {
        Row e=Data.Enemies[EnemyIndex];Row m=Data.Maps[MapIndex];Kills=Kills+1;TotalKills=TotalKills+1;
        // Expedition first-clear grants an immediate reward; repeated victories build map mastery.
        if (Count(MapKills,m.Id)==0) {Stones=Stones+e.Num("stone")*3;Say("首次踏破 · "+m.Name,true);}
        if (m.Text("mode")!="extreme" || Wave==9) {Bump(EnemyKills,e.Id,1);}Bump(MapKills,m.Id,1);if (Count(RunState,"swift")>0) {Bump(RunState,"swift",-1);}
        Xp=Xp+e.Num("xp")*(1+Insight*0.05+Skill("spirit_refining")*0.01);
        Stones=Stones+e.Num("stone")*(1+Fortune*0.04+Skill("fate_divination")*0.01);
        if (Random(100)<Data.Rule("drop_percent")+Fortune) { AddItem(e.Text("drop"),1); }
        AddItem("dew_grass",1); AddItem("red_copper",1);
        if (m.Text("mode") == "danger") { GainKarma(1); }
        if (m.Text("mode") == "extreme") {
            if (Wave == 9) {
                BossKills=BossKills+1;GainKarma(10);
                if (m.Text("pill") != "") {string pill=m.Text("pill");Inventory[pill]=(int)Min(999,ItemCount(pill)+1);}
                Bump(BossClears,m.Id,1);
                if (m.Int("ordinal") == 8) { Ascended=true; }
                StopActivity();Say("九重试炼已破："+e.Name,true); return;
            }
            Wave=Wave+1; Hp=Min(MaxHp(),Hp+MaxHp()*0.05);
        }
        Spawn();
    }
    public bool Breakthrough() {
        if (NeedsPrestige || Layer()!=12 || Realm()>=8 || Qi<QiNeed()) { return Say("尚未达到破境条件",false); }
        string pill=Data.Realms[Realm()].Text("pill");if (!TakeItem(pill,1)) { return Say("缺少破境丹，绝境首领首杀必得",false); }
        Qi=0;Level=Level+1;Hp=MaxHp();GainKarma(5);StopActivity();return Say("破境成功 · "+RealmName(),true);
    }
    public double SkillCost(int index) { if (index<0 || index>=Data.Skills.Count) { return 0; } return Data.Rule("skill_cost")+Skill(Data.Skills[index].Id)*Data.Rule("skill_step"); }
    public bool UpgradeSkill(int index) {
        if (NeedsPrestige || index<0 || index>=Data.Skills.Count) { return false; } Row s=Data.Skills[index];double cost=SkillCost(index);
        if (Level<s.Int("req") || Skill(s.Id)>=s.Int("max_level") || Xp<cost) { return Say("参悟所需修为或境界不足",false); }
        Xp=Xp-cost;Bump(SkillLevels,s.Id,1);return Say(s.Name+"参悟更进一步",true);
    }
    public bool CanCraft(int index) {
        if (index<0 || index>=Data.Recipes.Count) { return false; } Row r=Data.Recipes[index];
        if (r.Text("kind")=="boss_drop" || ArtLevel(r.Text("skill"))<r.Int("unlock")) { return false; }
        foreach (Row cost in Data.Ingredients) { if (cost.Text("recipe") == r.Id) { if (cost.Text("item") == "stones") { if (Stones<cost.Int("count")) { return false; } } else if (ItemCount(cost.Text("item"))<cost.Int("count")) { return false; } } } return true;
    }
    public bool StartCraft(int index) { if (NeedsPrestige || !CanCraft(index)) { return Say("杂学等级或材料不足",false); } StopActivity();RecipeIndex=index;Activity=3;return Say("开始"+Data.Recipes[index].Name,true); }
    public double CraftDuration() { Row r=Data.Recipes[RecipeIndex];return Max(1,r.Num("duration")*(1-(MasteryStar(r.Id)-1)*0.05)/((1+(ArtLevel(r.Text("skill"))-1)*0.003)*WineMultiplier("craft")*(r.Text("kind")=="gather" ? WineMultiplier("gather") : 1)*(1+FormationEffect("craft")))); }
    public void CompleteCraft() {
        if (!CanCraft(RecipeIndex)) { StopActivity();Say("材料不足，已停止制作",false);return; }
        Row r=Data.Recipes[RecipeIndex];
        if (Inventory.Count>=(int)Data.Rule("bag_capacity") && ItemCount(r.Text("result"))==0) {StopActivity();Say("行囊已满",false);return;}
        foreach (Row cost in Data.Ingredients) { if (cost.Text("recipe") == r.Id) { if (cost.Text("item") == "stones") { Stones=Stones-cost.Int("count"); } else { TakeItem(cost.Text("item"),cost.Int("count")); } } }
        AddItem(r.Text("result"),1);Bump(Crafted,r.Id,1);Bump(Mastery,r.Id,1);CraftCount=CraftCount+1;if (r.Text("kind")=="formation") {if (Formation=="") {Formation=r.Id;}if (Formation==r.Id) {FormationStars=MasteryStar(r.Id);}}
        if (r.Text("kind") == "gather") { GatherCount=GatherCount+1; if (r.Text("rare")!="" && Random(100)<12+Fortune) { AddItem(r.Text("rare"),1); } }
        string art=r.Text("skill");Bump(ArtXp,art,(int)((6+r.Int("unlock")/4)*WineMultiplier("artxp")*(1+FormationEffect("artxp"))*(1+Insight*0.05+Skill("arts_insight")*0.006)));
        while (Count(ArtXp,art)>=(25+ArtLevel(art)*18) && ArtLevel(art)<99) { ArtXp[art]=Count(ArtXp,art)-(25+ArtLevel(art)*18);ArtLevels[art]=ArtLevel(art)+1; }
    }
    public bool UseItem(string id) {
        Row r=ItemRow(id);if (NeedsPrestige || r == null || ItemCount(id)<1 || Level<(int)Max(1,r.Int("req"))) { return false; }
        string type=r.Text("type");
        if (type == "equipment" || r.Text("slot")!="") { string slot=r.Text("slot");if (slot == "") { slot="weapon"; }string old=Equipment.ContainsKey(slot) ? Equipment[slot] : "";TakeItem(id,1);if (old!="") { AddItem(old,1); }Equipment[slot]=id;Hp=Min(Hp,MaxHp());return Say("装备 "+r.Name,true); }
        if (id=="treasure_box") {if (!GiveGear(Data.Enemies[Random(Data.Enemies.Count)].Text("drop"),3)) {return false;}TakeItem(id,1);return true;}
        if (id=="blank_jade_slip") {string skill=Data.Skills[Random(Data.Skills.Count)].Id;if (Skill(skill)>=99) {return false;}TakeItem(id,1);Bump(SkillLevels,skill,1);return true;}
        if (type == "manual") { string skill=r.Text("skill");if (skill == "" || Skill(skill)>=99) { return false; }TakeItem(id,1);Bump(SkillLevels,skill,1);return Say("参悟 "+r.Name,true); }
        if (type == "formation" || type == "formations") {TakeItem(id,1);Formation=id;FormationStars=MasteryStar(id);return Say("布置 "+r.Name,true);}
        if (type == "talisman") {Loadout["talisman"]=id;return Say("装配 "+r.Name,true);}
        if (type == "wine") {TakeItem(id,1);Wine=id;WineSeconds=180;WineTimers[id]=720;return Say("饮下 "+r.Name,true);}
        if (type == "consumable") { string effect=r.Text("effect"); if (effect=="heal_half") { Hp=Min(MaxHp(),Hp+MaxHp()*0.5); } else if (effect=="qi") { Xp=Xp+r.Num("amount"); } else if (effect=="xp_quarter") { Xp=Xp+QiNeed()*0.25; } else if (effect=="lifespan") { AgeSeconds=Max(0,AgeSeconds-240); } else { return false; } TakeItem(id,1); return Say("使用 "+r.Name,true); }
        if (type == "alchemy" || type == "pill") {
            string effect=r.Text("effect");
            if (id=="taicang_pill") {Xp=Xp+3000;PermanentDefense=Min(100,PermanentDefense+1);Hp=MaxHp();}
            else if (id=="youming_pill") {Xp=Xp+3000;PermanentAttack=Min(120,PermanentAttack+1);}
            else if (effect=="heal") {if (Hp>=MaxHp()) {return false;}Hp=Min(MaxHp(),Hp+MaxHp()*0.35);}
            else if (effect=="hp") {if (PermanentHp>=600) {return false;}PermanentHp=Min(600,PermanentHp+4);}
            else if (effect=="atk") {if (PermanentAttack>=120) {return false;}PermanentAttack=Min(120,PermanentAttack+1);}
            else if (effect=="def") {if (PermanentDefense>=100) {return false;}PermanentDefense=Min(100,PermanentDefense+1);}
            else if (effect=="age" || effect=="lifespan") {AgeSeconds=Max(0,AgeSeconds-240);}
            else if (effect=="qi") {Xp=Xp+40;}
            else if (effect=="qi_pill") {Xp=Xp+QiNeed()*0.25;}
            else if (effect=="xp_500") {Xp=Xp+500;}
            else if (effect=="xp_10000") {Xp=Xp+10000;}
            else if (effect=="all") {if (PermanentHp>=600 && PermanentAttack>=120 && PermanentDefense>=100) {return false;}PermanentHp=Min(600,PermanentHp+3);PermanentAttack=Min(120,PermanentAttack+1);PermanentDefense=Min(100,PermanentDefense+1);}
            else {return false;}
            TakeItem(id,1);return Say("服用 "+r.Name,true);
        }
        return Say("此物用于制作或破境",false);
    }
    public bool Buy(int index) { if (NeedsPrestige || index<0 || index>=Data.Market.Count) { return false; }Row r=Data.Market[index];if (Stones<r.Num("price") || Level<r.Int("req") || ItemCount(r.Id)>=Data.Rule("stack_limit")) { return Say("灵石不足或商品尚未解锁",false); }if (!AddItem(r.Id,1)) { return false; }Stones=Stones-r.Num("price");Purchases=Purchases+1;Collect("market",r.Id);return Say("购得 "+r.Name,true); }
    public bool Sell(string id,int quantity) { Row r=ItemRow(id);if (r == null || !TakeItem(id,quantity)) { return false; }Stones=Stones+Max(1,r.Num("price")*0.35)*quantity;return Say("售出 "+r.Name,true); }
    public bool JoinSect(int index) { if (NeedsPrestige || SectIndex>=0 || index<0 || index>=Data.Sects.Count || Level<Data.Sects[index].Int("req")) { return Say("筑基后方可择宗，一世只择一宗",false); }SectIndex=index;return Say("拜入 "+Data.Sects[index].Name,true); }
    public bool TrainSect() { if (SectIndex<0 || Contribution<520*(SectManual+1) || SectManual>=99) { return false; }Contribution=Contribution-520*(SectManual+1);SectManual=SectManual+1;return Say("宗门心法精进",true); }
    public double SectTaskProgress(int index) { if (index<0 || index>=Data.SectTasks.Count) { return 0; }Row t=Data.SectTasks[index];double n=t.Text("kind") == "kills" ? Kills : t.Text("kind") == "craft" ? CraftCount : CultivationSeconds;return Max(0,n-Count(SectClaims,t.Id)*t.Num("target")); }
    public bool ClaimSectTask(int index) { if (SectIndex<0 || index<0 || index>=Data.SectTasks.Count) { return false; }Row t=Data.SectTasks[index];if (t.Text("sect")!=Data.Sects[SectIndex].Id || SectTaskProgress(index)<t.Num("target")) { return false; }Bump(SectClaims,t.Id,1);Contribution=Contribution+t.Num("reward");return Say("宗门任务完成",true); }
    public double QuestProgress() {
        if (QuestIndex>=Data.Quests.Count) { return 0; }
        if (QuestIndex==15) {int processed=0;int star=1;foreach (Row r in Data.Recipes) {if (r.Text("kind")!="gather") {processed=processed+Count(Crafted,r.Id);}star=(int)Max(star,MasteryStar(r.Id));}return Max(ArtLevel("fishing"),Max(ArtLevel("herbalism"),ArtLevel("mining")))>=5 && processed>=3 && star>=2 ? Data.Quests[QuestIndex].Num("target") : 0;}
        if (QuestIndex==16) {int talismans=0;int formations=0;foreach (Row r in Data.Recipes) {if (r.Text("skill")=="talismans") {talismans=talismans+Count(Crafted,r.Id);}if (r.Text("skill")=="formations") {formations=formations+Count(Crafted,r.Id);}}return talismans>0 && formations>0 && Formation!="" ? 1 : 0;}
        if (QuestIndex==17) {return Level>=12 ? Count(MapKills,"10") : 0;}
        if (QuestIndex==19) {return Level>=12 ? BossKills : 0;}
        if (QuestIndex==20) {return Data.Quests[QuestIndex].Num("target");}
        string m=Data.Quests[QuestIndex].Text("metric");
        if (m == "cultivate") { return Qi>=20 ? CultivationSeconds : 0; }if (m == "mind") { return Skill("mind"); }
        if (m == "equipment") { return Equipment.Count; }if (m == "gather") { return GatherCount; }if (m == "craft") { return CraftCount; }
        if (m == "purchases") { return Purchases; }if (m == "saves") { return Count(RunState,"music_adjusted")>0 ? ManualSaves : 0; }if (m == "level") { return Level; }
        if (m == "sect") { return SectIndex>=0 ? 1 : 0; }if (m == "formation") { return Formation!="" ? 1 : 0; }if (m == "bosses") { return BossKills; }
        if (m == "break_ready") { return Realm()>0 || (Level==12 && Qi>=QiNeed() && ItemCount(Data.Realms[0].Text("pill"))>0) ? 1 : 0; }
        if (m == "first_map") { return (Count(EnemyKills,"0")>0 ? 1 : 0)+(Count(EnemyKills,"1")>0 ? 1 : 0)+(Count(EnemyKills,"2")>0 ? 1 : 0); }
        if (m == "three_danger") { return Min(Count(MapKills,"10"),Min(Count(MapKills,"11"),Count(MapKills,"12"))); }
        List<string> bits=m.Split(":");if (bits.Count == 2) {if (bits[0] == "enemy") {return Count(EnemyKills,bits[1]);}if (bits[0] == "map") {return Count(MapKills,bits[1]);}if (bits[0] == "crafted") {return Count(Crafted,bits[1]);}}
        return 0;
    }
    public bool ClaimQuest() {
        if (NeedsPrestige || QuestIndex>=Data.Quests.Count || QuestProgress()<Data.Quests[QuestIndex].Num("target")) {return Say("任务尚未完成",false);}
        Row q=Data.Quests[QuestIndex];Stones=Stones+q.Num("stones");Xp=Xp+q.Num("xp");
        foreach (Row reward in Data.QuestRewards) {if (reward.Int("quest")==QuestIndex) {string item=reward.Text("item");int amount=reward.Int("count");
            if (item=="contribution") {Contribution=Contribution+amount;}
            else if (item=="skills") {foreach (string key in SkillLevels.Keys) {SkillLevels[key]=(int)Min(99,SkillLevels[key]+amount);}}
            else if (item=="equipment") {for (int i=0;i<amount;i=i+1) {GiveGear(Data.Enemies[QuestIndex==2 ? 0 : 3].Text("drop"),QuestIndex==2 ? 0 : 3);}}
            else {AddItem(item,amount);}
        }}QuestIndex=QuestIndex+1;UpdateAchievements();return Say("完成任务 · "+q.Name,true);
    }
    public int TalentLevel(int index) { return index==0 ? SpiritRoot : index==1 ? Constitution : index==2 ? Insight : Fortune; }
    public int TalentCost(int index) { int n=TalentLevel(index)+1;return n*(n+1)/2; }
    public bool UpgradeTalent(int index) { if (index<0 || index>=4 || TalentLevel(index)>=100 || Karma<TalentCost(index)) { return Say("因果不足",false); }Karma=Karma-TalentCost(index);if (index==0) {SpiritRoot=SpiritRoot+1;}else if (index==1) {Constitution=Constitution+1;}else if (index==2) {Insight=Insight+1;}else {Fortune=Fortune+1;}return Say("因果化为永久天赋",true); }
    public bool Prestige() { UpdateAchievements();Rebirths=Rebirths+1;UpdateAchievements();ResetRun();return Say("轮回再启，因果与天赋长存",true); }
    public void Tick(double seconds) {
        if (seconds<=0 || seconds!=seconds) { return; }StepRemainder=StepRemainder+Min(seconds,Data.Rule("offline_cap"));
        while (StepRemainder>=0.25) {StepRemainder=StepRemainder-0.25;Step(0.25);}
    }
    public double SimulateOffline(double seconds) { double duration=Max(0,Min(seconds,Data.Rule("offline_cap")));Tick(duration);Say("离线历练已结算，最多八小时",true);return duration; }
    public void Step(double dt) {
        if (NeedsPrestige) { return; }UpdateAchievements();AgeSeconds=AgeSeconds+dt;PlayedSeconds=PlayedSeconds+dt;
        if (Age()>=Lifespan()) {NeedsPrestige=true;StopActivity();Say("寿元已尽，请转生延续仙缘",true);return;}
        WineSeconds=Max(0,WineSeconds-dt);foreach (string id in WineTimers.Keys) {WineTimers[id]=(int)Max(0,WineTimers[id]-1);}Hp=Min(MaxHp(),Hp+MaxHp()*FormationEffect("regen")*dt);
        if (Recovery>0) {Recovery=Max(0,Recovery-dt);Hp=Min(MaxHp(),Hp+MaxHp()*dt/Data.Rule("recovery_seconds"));return;}
        if (Activity!=2) {Hp=Min(MaxHp(),Hp+MaxHp()*0.002*dt);}
        if (Activity==1) {
            double amount=Min(CultivationRate()*dt,Min(Xp,Max(0,QiNeed()-Qi)));Xp=Xp-amount;Qi=Qi+amount;CultivationSeconds=CultivationSeconds+dt;
            EpiphanyClock=EpiphanyClock+dt;
            if (EpiphanyClock>=25 && Count(RunState,"epiphany")==0) {
                EpiphanyClock=0;
                if (Random(100)<45) { TriggerEpiphany(); }
            }
            if (Qi>=QiNeed() && Layer()<12 && Level<108) {Qi=0;Level=Level+1;Hp=MaxHp();Say("修为精进，晋升一层",true);}
            if (Xp<=0 || Qi>=QiNeed() || Level>=108) {Activity=0;}return;
        }
        if (Activity==3) {CraftProgress=CraftProgress+dt;if (CraftProgress>=CraftDuration()) {CraftProgress=CraftProgress-CraftDuration();CompleteCraft();}return;}
        if (Activity!=2) {return;}
        AdventureClock=AdventureClock+dt;
        if (AdventureClock>=45 && AdventureEvent==0) {
            AdventureClock=0;
            if (Random(100)<35) { TriggerAdventure(); }
        }
        Row e=Data.Enemies[EnemyIndex];PlayerClock=PlayerClock+dt;EnemyClock=EnemyClock+dt;
        double interval=(Count(RunState,"swift")>0 ? 0.78 : 1)*Max(0.36,1.2-Level*0.0078)*Max(0.55,1-Skill("flowing_cloud")*0.004);
        if (PlayerClock>=interval) {
            PlayerClock=PlayerClock-interval;
            double hit=Attack()*(0.9+Random(201)*0.001);
            bool isCrit=Random(1000)<Min(600,100+Skill("attack")*6);
            if (isCrit) {hit=hit*(1.7+Skill("army_breaker")*0.012);}
            double dealt=Max(1,hit*100/(100+e.Num("def")*EnemyScale()*0.65));
            EnemyHp=EnemyHp-dealt;
            string wpName=(Equipment.ContainsKey("weapon") && ItemRow(Equipment["weapon"])!=null) ? ItemRow(Equipment["weapon"]).Name : "双拳";
            if (isCrit) {
                AddCombat("【会心一击】灵气贯注，"+wpName+"破空爆鸣直取【"+e.Name+"】命门，造成 -"+Convert.ToString((int)dealt)+" 暴击伤害！");
            } else {
                AddCombat("你施展招式，"+wpName+"剑光闪烁袭向【"+e.Name+"】，造成 -"+Convert.ToString((int)dealt)+" 伤害。");
            }
        }
        if (EnemyHp<=0) {
            AddCombat("【斩杀大捷】你一击斩落【"+e.Name+"】，平复灵气收纳战利品！");
            Victory();
            return;
        }
        if (EnemyClock>=e.Num("interval")*(1+FormationEffect("enemy_interval"))) {
            EnemyClock=EnemyClock-e.Num("interval")*(1+FormationEffect("enemy_interval"));
            if (Random(1000)>=Min(600,Skill("flowing_cloud")*3+FormationEffect("dodge")*1000)) {
                double hit=e.Num("atk")*EnemyScale()*(1-Min(0.55,Skill("guard")*0.006))*(0.9+Random(201)*0.001);
                double damage=Max(1,hit*100/(100+Defense()))*(1-Min(0.6,FormationEffect("reduction")));
                if (ConsumeTalisman("talisman_golden_armor")) {damage=damage*Effect("talisman_golden_armor","armor");AddCombat("【金甲符】护体金光大盛，替你化解大半冲击！");}
                if (damage>MaxHp()*0.2 && ConsumeTalisman("talisman_guard")) {damage=damage*Effect("talisman_guard","guard");}
                Hp=Hp-damage;
                AddCombat("【"+e.Name+"】狂怒反击扑杀，罡风震荡，你受到 -"+Convert.ToString((int)damage)+" 伤害！");
                if (Hp<=MaxHp()*0.5 && ConsumeTalisman("talisman_heal")) {Hp=Min(MaxHp(),Hp+MaxHp()*Effect("talisman_heal","heal"));AddCombat("【回春符】灵力涌入气海，气血大笔恢复！");}
                if (Hp<=0 && ConsumeTalisman("talisman_rebirth")) {Hp=MaxHp()*Effect("talisman_rebirth","revive");AddCombat("【涅槃符】金莲护命，逆转死生，气血回满！");}
            } else {
                AddCombat("【身法如影】你脚踏虚空幻化流云残影，轻盈避开了【"+e.Name+"】的凶猛一扑！");
            }
        }
        if (AutoHeal && Hp>0 && Hp<=MaxHp()*0.35 && ItemCount("alchemy_heal_pill")>0) {UseItem("alchemy_heal_pill");}
        if (Hp<=0) {
            Hp=1;StopActivity();Recovery=Data.Rule("recovery_seconds");Stones=Max(0,Stones*0.95);
            AddCombat("【力竭受挫】气血亏竭，你捏碎神符脱离战场（损失5%灵石）。");
            Say("力竭败退，休养后再战（损失5%灵石）",false);
        }
    }

    // Schema 1 CSV payload: strict unique keys, finite ranges, unknown fields rejected.
    // Parsing happens on an isolated candidate; live state changes only after all checks pass.
    public static void SaveRow(List<List<string>> rows,string group,string key,string value) {
        List<string> r=new List<string>();r.Add(group);r.Add(key);r.Add(value);rows.Add(r);
    }
    public static double SavedNumber(string text,double low,double high) {
        if (text.Length==0 || text.Length>40) { throw new Exception("Invalid saved number"); }
        bool digit=false;int dots=0;
        for (int i=0;i<text.Length;i=i+1) {
            int ch=text[i]&255;
            if (ch>=48 && ch<=57) {digit=true;}
            else if (ch==46) {dots=dots+1;if (dots>1) {throw new Exception("Invalid saved number");}}
            else if (!(ch==45 && i==0)) {throw new Exception("Invalid saved number");}
        }
        double n=Convert.ToDouble(text);
        if (!digit || n!=n || n<low || n>high) {throw new Exception("Saved number out of range");}return n;
    }
    public string Serialize() {
        UpdateAchievements();
        List<List<string>> rows=new List<List<string>>();SaveRow(rows,"schema","version","2");
        SaveRow(rows,"state","SavedUnixSeconds",Convert.ToString(SavedUnixSeconds));
        SaveRow(rows,"state","Level",Convert.ToString(Level));
        SaveRow(rows,"state","Xp",Convert.ToString(Xp));
        SaveRow(rows,"state","Qi",Convert.ToString(Qi));
        SaveRow(rows,"state","Stones",Convert.ToString(Stones));
        SaveRow(rows,"state","Hp",Convert.ToString(Hp));
        SaveRow(rows,"state","AgeSeconds",Convert.ToString(AgeSeconds));
        SaveRow(rows,"state","PlayedSeconds",Convert.ToString(PlayedSeconds));
        SaveRow(rows,"state","Activity",Convert.ToString(Activity));
        SaveRow(rows,"state","MapIndex",Convert.ToString(MapIndex));
        SaveRow(rows,"state","EnemyIndex",Convert.ToString(EnemyIndex));
        SaveRow(rows,"state","Wave",Convert.ToString(Wave));
        SaveRow(rows,"state","EnemyHp",Convert.ToString(EnemyHp));
        SaveRow(rows,"state","EnemyMaxHp",Convert.ToString(EnemyMaxHp));
        SaveRow(rows,"state","PlayerClock",Convert.ToString(PlayerClock));
        SaveRow(rows,"state","EnemyClock",Convert.ToString(EnemyClock));
        SaveRow(rows,"state","RecipeIndex",Convert.ToString(RecipeIndex));
        SaveRow(rows,"state","CraftProgress",Convert.ToString(CraftProgress));
        SaveRow(rows,"state","Recovery",Convert.ToString(Recovery));
        SaveRow(rows,"state","StepRemainder",Convert.ToString(StepRemainder));
        SaveRow(rows,"state","SectIndex",Convert.ToString(SectIndex));
        SaveRow(rows,"state","SectManual",Convert.ToString(SectManual));
        SaveRow(rows,"state","Contribution",Convert.ToString(Contribution));
        SaveRow(rows,"state","QuestIndex",Convert.ToString(QuestIndex));
        SaveRow(rows,"state","CultivationSeconds",Convert.ToString(CultivationSeconds));
        SaveRow(rows,"state","Kills",Convert.ToString(Kills));
        SaveRow(rows,"state","TotalKills",Convert.ToString(TotalKills));
        SaveRow(rows,"state","CraftCount",Convert.ToString(CraftCount));
        SaveRow(rows,"state","GatherCount",Convert.ToString(GatherCount));
        SaveRow(rows,"state","Purchases",Convert.ToString(Purchases));
        SaveRow(rows,"state","ManualSaves",Convert.ToString(ManualSaves));
        SaveRow(rows,"state","BossKills",Convert.ToString(BossKills));
        SaveRow(rows,"state","Rebirths",Convert.ToString(Rebirths));
        SaveRow(rows,"state","Karma",Convert.ToString(Karma));
        SaveRow(rows,"state","LifetimeKarma",Convert.ToString(LifetimeKarma));
        SaveRow(rows,"state","SpiritRoot",Convert.ToString(SpiritRoot));
        SaveRow(rows,"state","Constitution",Convert.ToString(Constitution));
        SaveRow(rows,"state","Insight",Convert.ToString(Insight));
        SaveRow(rows,"state","Fortune",Convert.ToString(Fortune));
        SaveRow(rows,"state","PermanentHp",Convert.ToString(PermanentHp));
        SaveRow(rows,"state","PermanentAttack",Convert.ToString(PermanentAttack));
        SaveRow(rows,"state","PermanentDefense",Convert.ToString(PermanentDefense));
        SaveRow(rows,"state","NeedsPrestige",(NeedsPrestige ? "1" : "0"));
        SaveRow(rows,"state","Ascended",(Ascended ? "1" : "0"));
        SaveRow(rows,"state","AutoHeal",(AutoHeal ? "1" : "0"));
        SaveRow(rows,"state","Formation",Formation);
        SaveRow(rows,"state","FormationStars",Convert.ToString(FormationStars));
        SaveRow(rows,"state","Wine",Wine);
        SaveRow(rows,"state","WineSeconds",Convert.ToString(WineSeconds));
        SaveRow(rows,"state","LastMessage",LastMessage);
        SaveRow(rows,"state","Seed",Convert.ToString(Seed));
        foreach (string key in Inventory.Keys) {SaveRow(rows,"Inventory",key,Convert.ToString(Inventory[key]));}
        foreach (string key in SkillLevels.Keys) {SaveRow(rows,"SkillLevels",key,Convert.ToString(SkillLevels[key]));}
        foreach (string key in ArtLevels.Keys) {SaveRow(rows,"ArtLevels",key,Convert.ToString(ArtLevels[key]));}
        foreach (string key in ArtXp.Keys) {SaveRow(rows,"ArtXp",key,Convert.ToString(ArtXp[key]));}
        foreach (string key in Mastery.Keys) {SaveRow(rows,"Mastery",key,Convert.ToString(Mastery[key]));}
        foreach (string key in EnemyKills.Keys) {SaveRow(rows,"EnemyKills",key,Convert.ToString(EnemyKills[key]));}
        foreach (string key in MapKills.Keys) {SaveRow(rows,"MapKills",key,Convert.ToString(MapKills[key]));}
        foreach (string key in Crafted.Keys) {SaveRow(rows,"Crafted",key,Convert.ToString(Crafted[key]));}
        foreach (string key in BossClears.Keys) {SaveRow(rows,"BossClears",key,Convert.ToString(BossClears[key]));}
        foreach (string key in SectClaims.Keys) {SaveRow(rows,"SectClaims",key,Convert.ToString(SectClaims[key]));}
        foreach (string key in Equipment.Keys) {SaveRow(rows,"Equipment",key,Equipment[key]);}
        foreach (string key in Achievements.Keys) {SaveRow(rows,"Achievements",key,Convert.ToString(Achievements[key]));}
        foreach (string key in AchievementStats.Keys) {SaveRow(rows,"AchievementStats",key,Convert.ToString(AchievementStats[key]));}
        foreach (string key in Collections.Keys) {SaveRow(rows,"Collections",key,Convert.ToString(Collections[key]));}
        foreach (string key in ArenaState.Keys) {SaveRow(rows,"ArenaState",key,Convert.ToString(ArenaState[key]));}
        foreach (string key in RunState.Keys) {SaveRow(rows,"RunState",key,Convert.ToString(RunState[key]));}
        foreach (string key in GearQualities.Keys) {SaveRow(rows,"GearQualities",key,Convert.ToString(GearQualities[key]));}
        foreach (string key in WineTimers.Keys) {SaveRow(rows,"WineTimers",key,Convert.ToString(WineTimers[key]));}
        foreach (string key in GearBases.Keys) {SaveRow(rows,"GearBases",key,GearBases[key]);}
        foreach (string key in Loadout.Keys) {SaveRow(rows,"Loadout",key,Loadout[key]);}
        return Csv.Serialize(rows);
    }
    public bool LoadState(string payload) {
        try {
            if (payload.Length>2000000) {return false;}
            List<List<string>> rows=Csv.Parse(payload);
            if (rows.Count<2 || rows[0].Count!=3 || rows[0][0]!="schema" || rows[0][1]!="version" || (rows[0][2]!="1" && rows[0][2]!="2")) {return false;}
            Game candidate=new Game();candidate.Data=Data;
            Dictionary<string,bool> seen=new Dictionary<string,bool>();int scalarCount=0;
            for (int i=1;i<rows.Count;i=i+1) {
                List<string> row=rows[i];if (row.Count!=3) {return false;}
                string group=row[0];string key=row[1];string value=row[2];string identity=group+":"+key;
                if (seen.ContainsKey(identity) || key.Length>128 || value.Length>2048) {return false;}seen.Add(identity,true);
                if (group=="state") {
                    scalarCount=scalarCount+1;
                    if (key=="SavedUnixSeconds") {double number=SavedNumber(value,0,4102444800);if (number!=(long)number) {return false;}candidate.SavedUnixSeconds=(long)number;}
                    else if (key=="Level") {double number=SavedNumber(value,1,108);if (number!=(int)number) {return false;}candidate.Level=(int)number;}
                    else if (key=="Xp") {candidate.Xp=SavedNumber(value,0,1000000000000);}
                    else if (key=="Qi") {candidate.Qi=SavedNumber(value,0,1000000000000);}
                    else if (key=="Stones") {candidate.Stones=SavedNumber(value,0,1000000000000);}
                    else if (key=="Hp") {candidate.Hp=SavedNumber(value,0,1000000000000);}
                    else if (key=="AgeSeconds") {candidate.AgeSeconds=SavedNumber(value,0,1000000000000);}
                    else if (key=="PlayedSeconds") {candidate.PlayedSeconds=SavedNumber(value,0,1000000000000);}
                    else if (key=="Activity") {double number=SavedNumber(value,0,3);if (number!=(int)number) {return false;}candidate.Activity=(int)number;}
                    else if (key=="MapIndex") {double number=SavedNumber(value,0,Data.Maps.Count-1);if (number!=(int)number) {return false;}candidate.MapIndex=(int)number;}
                    else if (key=="EnemyIndex") {double number=SavedNumber(value,0,Data.Enemies.Count-1);if (number!=(int)number) {return false;}candidate.EnemyIndex=(int)number;}
                    else if (key=="Wave") {double number=SavedNumber(value,1,9);if (number!=(int)number) {return false;}candidate.Wave=(int)number;}
                    else if (key=="EnemyHp") {candidate.EnemyHp=SavedNumber(value,0,1000000000000);}
                    else if (key=="EnemyMaxHp") {candidate.EnemyMaxHp=SavedNumber(value,0,1000000000000);}
                    else if (key=="PlayerClock") {candidate.PlayerClock=SavedNumber(value,0,1000000000000);}
                    else if (key=="EnemyClock") {candidate.EnemyClock=SavedNumber(value,0,1000000000000);}
                    else if (key=="RecipeIndex") {double number=SavedNumber(value,0,Data.Recipes.Count-1);if (number!=(int)number) {return false;}candidate.RecipeIndex=(int)number;}
                    else if (key=="CraftProgress") {candidate.CraftProgress=SavedNumber(value,0,1000000000000);}
                    else if (key=="Recovery") {candidate.Recovery=SavedNumber(value,0,1000000000000);}
                    else if (key=="StepRemainder") {candidate.StepRemainder=SavedNumber(value,0,0.24999999999);}
                    else if (key=="SectIndex") {double number=SavedNumber(value,-1,1);if (number!=(int)number) {return false;}candidate.SectIndex=(int)number;}
                    else if (key=="SectManual") {double number=SavedNumber(value,0,99);if (number!=(int)number) {return false;}candidate.SectManual=(int)number;}
                    else if (key=="Contribution") {candidate.Contribution=SavedNumber(value,0,1000000000000);}
                    else if (key=="QuestIndex") {double number=SavedNumber(value,0,Data.Quests.Count);if (number!=(int)number) {return false;}candidate.QuestIndex=(int)number;}
                    else if (key=="CultivationSeconds") {candidate.CultivationSeconds=SavedNumber(value,0,1000000000000);}
                    else if (key=="Kills") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.Kills=(int)number;}
                    else if (key=="TotalKills") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.TotalKills=(int)number;}
                    else if (key=="CraftCount") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.CraftCount=(int)number;}
                    else if (key=="GatherCount") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.GatherCount=(int)number;}
                    else if (key=="Purchases") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.Purchases=(int)number;}
                    else if (key=="ManualSaves") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.ManualSaves=(int)number;}
                    else if (key=="BossKills") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.BossKills=(int)number;}
                    else if (key=="Rebirths") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.Rebirths=(int)number;}
                    else if (key=="Karma") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.Karma=(int)number;}
                    else if (key=="LifetimeKarma") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.LifetimeKarma=(int)number;}
                    else if (key=="SpiritRoot") {double number=SavedNumber(value,0,100);if (number!=(int)number) {return false;}candidate.SpiritRoot=(int)number;}
                    else if (key=="Constitution") {double number=SavedNumber(value,0,100);if (number!=(int)number) {return false;}candidate.Constitution=(int)number;}
                    else if (key=="Insight") {double number=SavedNumber(value,0,100);if (number!=(int)number) {return false;}candidate.Insight=(int)number;}
                    else if (key=="Fortune") {double number=SavedNumber(value,0,100);if (number!=(int)number) {return false;}candidate.Fortune=(int)number;}
                    else if (key=="PermanentHp") {candidate.PermanentHp=SavedNumber(value,0,600);}
                    else if (key=="PermanentAttack") {candidate.PermanentAttack=SavedNumber(value,0,120);}
                    else if (key=="PermanentDefense") {candidate.PermanentDefense=SavedNumber(value,0,100);}
                    else if (key=="NeedsPrestige") {if (value!="0" && value!="1") {return false;}candidate.NeedsPrestige=value=="1";}
                    else if (key=="Ascended") {if (value!="0" && value!="1") {return false;}candidate.Ascended=value=="1";}
                    else if (key=="AutoHeal") {if (value!="0" && value!="1") {return false;}candidate.AutoHeal=value=="1";}
                    else if (key=="Formation") {candidate.Formation=value;}
                    else if (key=="FormationStars") {double number=SavedNumber(value,1,10);if (number!=(int)number) {return false;}candidate.FormationStars=(int)number;}
                    else if (key=="Wine") {candidate.Wine=value;}
                    else if (key=="WineSeconds") {candidate.WineSeconds=SavedNumber(value,0,1000000000000);}
                    else if (key=="LastMessage") {candidate.LastMessage=value;}
                    else if (key=="Seed") {double number=SavedNumber(value,0,65535);if (number!=(int)number) {return false;}candidate.Seed=(int)number;}
                    else {return false;}
                }
                else if (group=="Inventory") {double number=SavedNumber(value,0,999);if (number!=(int)number) {return false;}candidate.Inventory[key]=(int)number;}
                else if (group=="SkillLevels") {double number=SavedNumber(value,0,99);if (number!=(int)number) {return false;}candidate.SkillLevels[key]=(int)number;}
                else if (group=="ArtLevels") {double number=SavedNumber(value,0,99);if (number!=(int)number) {return false;}candidate.ArtLevels[key]=(int)number;}
                else if (group=="ArtXp") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.ArtXp[key]=(int)number;}
                else if (group=="Mastery") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.Mastery[key]=(int)number;}
                else if (group=="EnemyKills") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.EnemyKills[key]=(int)number;}
                else if (group=="MapKills") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.MapKills[key]=(int)number;}
                else if (group=="Crafted") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.Crafted[key]=(int)number;}
                else if (group=="BossClears") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.BossClears[key]=(int)number;}
                else if (group=="SectClaims") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}if (key!="arena_wins" && Data.Find(Data.SectTasks,key)==null && key.IndexOf("arena:")!=0) {return false;}candidate.SectClaims[key]=(int)number;}
                else if (group=="Achievements") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.Achievements[key]=(int)number;}
                else if (group=="AchievementStats") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.AchievementStats[key]=(int)number;}
                else if (group=="Collections") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.Collections[key]=(int)number;}
                else if (group=="ArenaState") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.ArenaState[key]=(int)number;}
                else if (group=="RunState") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.RunState[key]=(int)number;}
                else if (group=="GearQualities") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.GearQualities[key]=(int)number;}
                else if (group=="WineTimers") {double number=SavedNumber(value,0,1000000000);if (number!=(int)number) {return false;}candidate.WineTimers[key]=(int)number;}
                else if (group=="GearBases") {candidate.GearBases[key]=value;}
                else if (group=="Loadout") {candidate.Loadout[key]=value;}
                else if (group=="Equipment") {candidate.Equipment[key]=value;}
                else {return false;}
            }
            if (scalarCount!=51) {return false;}
            foreach (string id in candidate.GearBases.Keys) {Row r=Data.Find(Data.Items,candidate.GearBases[id]);if (r==null || r.Text("slot")=="" || !candidate.GearQualities.ContainsKey(id) || candidate.GearQualities[id]>4 || id.IndexOf(candidate.GearBases[id]+"#")!=0) {return false;}}
            foreach (string id in candidate.GearQualities.Keys) {if (!candidate.GearBases.ContainsKey(id)) {return false;}}
            foreach (string id in candidate.Achievements.Keys) {if (Data.Find(Data.Achievements,id)==null || candidate.Achievements[id]!=1) {return false;}}
            foreach (string id in candidate.ArenaState.Keys) {if (Data.Find(Data.Arena,id)==null) {return false;}}
            foreach (string id in candidate.WineTimers.Keys) {Row r=Data.Find(Data.Items,id);if (r==null || r.Text("type")!="wine" || candidate.WineTimers[id]>720) {return false;}}
            foreach (string key in candidate.Loadout.Keys) {Row r=Data.Find(Data.Items,candidate.Loadout[key]);if (key!="talisman" || r==null || r.Text("type")!="talisman") {return false;}}
            if (rows[0][2]=="1" && candidate.Wine!="" && candidate.WineSeconds>0) {candidate.WineTimers[candidate.Wine]=(int)Min(720,candidate.WineSeconds*4);}
            if (candidate.Qi>candidate.QiNeed() || candidate.Hp>candidate.MaxHp()+Max(0.001,candidate.MaxHp()*0.00001) || candidate.Karma>candidate.LifetimeKarma || candidate.TotalKills<candidate.Kills) {return false;}
            if (candidate.Activity==2 && (!candidate.MapUnlocked(candidate.MapIndex) || candidate.EnemyHp<=0 || candidate.EnemyHp>candidate.EnemyMaxHp || Data.Enemies[candidate.EnemyIndex].Int("map")!=candidate.MapIndex)) {return false;}
            if (candidate.NeedsPrestige && candidate.Activity!=0) {return false;}
            foreach (string id in candidate.Inventory.Keys) {if (candidate.ItemRow(id)==null) {return false;}}
            foreach (string id in candidate.SkillLevels.Keys) {if (Data.Find(Data.Skills,id)==null) {return false;}}
            foreach (string id in candidate.EnemyKills.Keys) {if (Data.Find(Data.Enemies,id)==null) {return false;}}
            foreach (string id in candidate.MapKills.Keys) {if (Data.Find(Data.Maps,id)==null) {return false;}}
            foreach (string id in candidate.BossClears.Keys) {Row map=Data.Find(Data.Maps,id);if (map==null || map.Text("mode")!="extreme") {return false;}}
            foreach (string id in candidate.Mastery.Keys) {if (Data.Find(Data.Recipes,id)==null) {return false;}}
            foreach (string id in candidate.Crafted.Keys) {if (Data.Find(Data.Recipes,id)==null) {return false;}}
            foreach (string id in candidate.SectClaims.Keys) {if (id!="arena_wins" && id.IndexOf("arena:")!=0 && Data.Find(Data.SectTasks,id)==null) {return false;}}
            foreach (string id in candidate.ArtLevels.Keys) {bool found=false;foreach (Row recipe in Data.Recipes) {if (recipe.Text("skill")==id) {found=true;}}if (!found) {return false;}}
            foreach (string id in candidate.ArtXp.Keys) {bool found=false;foreach (Row recipe in Data.Recipes) {if (recipe.Text("skill")==id) {found=true;}}if (!found) {return false;}}
            foreach (string slot in candidate.Equipment.Keys) {Row r=candidate.ItemRow(candidate.Equipment[slot]);if (r==null || r.Text("slot")!=slot) {return false;}}
            if (candidate.Formation!="" && Data.Find(Data.Items,candidate.Formation)==null) {return false;}
            if (candidate.Wine!="" && Data.Find(Data.Items,candidate.Wine)==null) {return false;}
            SavedUnixSeconds=candidate.SavedUnixSeconds;
            Level=candidate.Level;
            Xp=candidate.Xp;
            Qi=candidate.Qi;
            Stones=candidate.Stones;
            Hp=candidate.Hp;
            AgeSeconds=candidate.AgeSeconds;
            PlayedSeconds=candidate.PlayedSeconds;
            Activity=candidate.Activity;
            MapIndex=candidate.MapIndex;
            EnemyIndex=candidate.EnemyIndex;
            Wave=candidate.Wave;
            EnemyHp=candidate.EnemyHp;
            EnemyMaxHp=candidate.EnemyMaxHp;
            PlayerClock=candidate.PlayerClock;
            EnemyClock=candidate.EnemyClock;
            RecipeIndex=candidate.RecipeIndex;
            CraftProgress=candidate.CraftProgress;
            Recovery=candidate.Recovery;
            StepRemainder=candidate.StepRemainder;
            SectIndex=candidate.SectIndex;
            SectManual=candidate.SectManual;
            Contribution=candidate.Contribution;
            QuestIndex=candidate.QuestIndex;
            CultivationSeconds=candidate.CultivationSeconds;
            Kills=candidate.Kills;
            TotalKills=candidate.TotalKills;
            CraftCount=candidate.CraftCount;
            GatherCount=candidate.GatherCount;
            Purchases=candidate.Purchases;
            ManualSaves=candidate.ManualSaves;
            BossKills=candidate.BossKills;
            Rebirths=candidate.Rebirths;
            Karma=candidate.Karma;
            LifetimeKarma=candidate.LifetimeKarma;
            SpiritRoot=candidate.SpiritRoot;
            Constitution=candidate.Constitution;
            Insight=candidate.Insight;
            Fortune=candidate.Fortune;
            PermanentHp=candidate.PermanentHp;
            PermanentAttack=candidate.PermanentAttack;
            PermanentDefense=candidate.PermanentDefense;
            NeedsPrestige=candidate.NeedsPrestige;
            Ascended=candidate.Ascended;
            AutoHeal=candidate.AutoHeal;
            Formation=candidate.Formation;
            FormationStars=candidate.FormationStars;
            Wine=candidate.Wine;
            WineSeconds=candidate.WineSeconds;
            LastMessage=candidate.LastMessage;
            Seed=candidate.Seed;
            Inventory=candidate.Inventory;
            SkillLevels=candidate.SkillLevels;
            ArtLevels=candidate.ArtLevels;
            ArtXp=candidate.ArtXp;
            Mastery=candidate.Mastery;
            EnemyKills=candidate.EnemyKills;
            MapKills=candidate.MapKills;
            Crafted=candidate.Crafted;
            BossClears=candidate.BossClears;
            SectClaims=candidate.SectClaims;
            Achievements=candidate.Achievements;
            AchievementStats=candidate.AchievementStats;
            Collections=candidate.Collections;
            ArenaState=candidate.ArenaState;
            RunState=candidate.RunState;
            GearQualities=candidate.GearQualities;
            WineTimers=candidate.WineTimers;
            GearBases=candidate.GearBases;
            Loadout=candidate.Loadout;
            Equipment=candidate.Equipment;
            return true;
        } catch (Exception ex) {return false;}
    }

    public Row AchievementRow(int index) {return index>=0 && index<Data.Achievements.Count ? Data.Achievements[index] : null;}
    public Row ArenaOpponentRow(int index) {return ArenaOpponent(index);}
    public int AchievementCount() { return Data.Achievements.Count; }
    public string AchievementName(int index) { return index>=0 && index<AchievementCount() ? Data.Achievements[index].Name : ""; }
    public int AchievementProgress(int index) { UpdateAchievements();if (index<0 || index>=AchievementCount()) {return 0;}return Count(AchievementStats,Data.Achievements[index].Text("metric")); }
    public bool AchievementUnlocked(int index) { UpdateAchievements();return index>=0 && index<AchievementCount() && Count(Achievements,Data.Achievements[index].Id)>0; }
    public void StatMax(string key,int value) {AchievementStats[key]=(int)Max(Count(AchievementStats,key),value);}
    public void Collect(string kind,string id) {Collections[kind+":"+id]=1;}
    public int Collected(string kind) {int n=0;foreach (string key in Collections.Keys) {if (key.IndexOf(kind+":")==0) {n=n+1;}}return n;}
    public void UpdateAchievements() {
        StatMax("STAT_CULTIVATION_STAGE",Level);StatMax("STAT_TOTAL_KILLS",TotalKills);StatMax("STAT_REINCARNATION_COUNT",Rebirths);
        StatMax("SPECIAL_RETREAT",CultivationSeconds>0 ? 1 : 0);StatMax("SPECIAL_EQUIPMENT",Equipment.Count);StatMax("SPECIAL_QUEST",QuestIndex>=Data.Quests.Count ? 1 : 0);
        StatMax("SPECIAL_APTITUDES",(SpiritRoot>0 ? 1 : 0)+(Constitution>0 ? 1 : 0)+(Insight>0 ? 1 : 0)+(Fortune>0 ? 1 : 0));
        foreach (Row e in Data.Enemies) {if (Count(EnemyKills,e.Id)>0) {Row m=Data.Maps[e.Int("map")];Collect(m.Text("mode"),e.Id);if (m.Text("mode")=="extreme") {if (m.Int("ordinal")<8) {Collect("major",e.Id);}else {StatMax("SPECIAL_EMISSARY",1);}}}}
        foreach (Row r in Data.Recipes) {if (Count(Crafted,r.Id)>0) {Collect(r.Text("skill"),r.Id);}}
        StatMax("STAT_UNIQUE_WILD_ENEMIES",Collected("wild"));StatMax("STAT_UNIQUE_DANGER_ENEMIES",Collected("danger"));StatMax("STAT_UNIQUE_BOSSES",Collected("extreme"));StatMax("STAT_MAJOR_BOSSES_DEFEATED",Collected("major"));
        StatMax("STAT_UNIQUE_FISHING",Collected("fishing"));StatMax("STAT_UNIQUE_HERBALISM",Collected("herbalism"));StatMax("STAT_UNIQUE_MINING",Collected("mining"));StatMax("STAT_UNIQUE_BREWING",Collected("brewing"));StatMax("STAT_UNIQUE_FORGING",Collected("forging"));StatMax("STAT_UNIQUE_ALCHEMY",Collected("alchemy"));StatMax("STAT_UNIQUE_TALISMAN",Collected("talismans"));StatMax("STAT_UNIQUE_FORMATION",Collected("formations"));StatMax("STAT_UNIQUE_MARKET_PURCHASES",Collected("market"));
        foreach (Row a in Data.Achievements) {if (Count(AchievementStats,a.Text("metric"))>=a.Int("target")) {Achievements[a.Id]=1;}}
    }
    public Row SectVaultRow(int index) {if (SectIndex<0 || index<0) {return null;}int n=0;foreach (Row r in Data.SectVault) {if (r.Text("sect")==Data.Sects[SectIndex].Id) {if (n==index) {return r;}n=n+1;}}return null;}
    public int SectVaultCount() {int n=0;if (SectIndex>=0) {foreach (Row r in Data.SectVault) {if (r.Text("sect")==Data.Sects[SectIndex].Id) {n=n+1;}}}return n;}
    public string SectVaultItem(int index) {Row r=SectVaultRow(index);return r==null ? "" : r.Id;}
    public double SectVaultCost(int index) {Row r=SectVaultRow(index);return r==null ? 0.0 : r.Num("cost")*(r.Text("type")=="manual" ? SectManual+1 : 1);}
    public bool ExchangeSectVault(int index) {Row r=SectVaultRow(index);double cost=SectVaultCost(index);if (NeedsPrestige || r==null || Level<r.Int("req") || Contribution<cost) {return false;}if (r.Text("type")=="manual") {if (SectManual>=99) {return false;}SectManual=SectManual+1;}else if (!AddItem(r.Id,1)) {return false;}Contribution=Contribution-cost;return Say("兑换 "+r.Name,true);}
    public double ArenaPower() {return Attack()*2+Defense()*3+MaxHp()*0.15;}
    public double ArenaCycleSeconds() {return Data.Rule("arena_cycle");}
    public double ArenaWindowSeconds() {return Data.Rule("arena_window");}
    public int ArenaCycle() {return (int)(PlayedSeconds/ArenaCycleSeconds());}
    public bool ArenaAvailable() {return !NeedsPrestige && Recovery<=0 && SectIndex>=0 && Level>=13 && PlayedSeconds-ArenaCycle()*ArenaCycleSeconds()<ArenaWindowSeconds();}
    public Row ArenaOpponent(int index) {if (SectIndex<0 || index<0) {return null;}int n=0;foreach (Row r in Data.Arena) {if (r.Text("sect")==Data.Sects[SectIndex].Id) {if (n==index) {return r;}n=n+1;}}return null;}
    public int ArenaOpponentCount() {int n=0;if (SectIndex>=0) {foreach (Row r in Data.Arena) {if (r.Text("sect")==Data.Sects[SectIndex].Id) {n=n+1;}}}return n;}
    public string ArenaOpponentId(int index) {Row r=ArenaOpponent(index);return r==null ? "" : r.Id;}
    public bool ArenaOpponentWon(int index) {return ArenaOpponentId(index)!="" && Count(ArenaState,ArenaOpponentId(index))==ArenaCycle()+1;}
    public int ArenaWins() {return Count(RunState,"arena_wins");}
    public bool ArenaFight() {for (int i=0;i<ArenaOpponentCount();i=i+1) {if (!ArenaOpponentAttempted(i)) {return ArenaFightOpponent(i);}}return false;}
    public bool ArenaOpponentAttempted(int index) {string id=ArenaOpponentId(index);return id!="" && Count(RunState,"arena:"+id)==ArenaCycle()+1;}
    public bool ArenaFightOpponent(int index) {Row r=ArenaOpponent(index);if (!ArenaAvailable() || r==null || ArenaOpponentAttempted(index) || Level<r.Int("req")) {return false;}RunState["arena:"+r.Id]=ArenaCycle()+1;if (ArenaPower()*(0.92+Random(161)*0.001)<r.Num("power")*(0.92+Random(161)*0.001)) {return Say("切磋失利，下轮再战",false);}ArenaState[r.Id]=ArenaCycle()+1;Bump(RunState,"arena_wins",1);Contribution=Contribution+r.Num("reward");return Say("切磋获胜 · "+r.Name,true);}
    public bool GiveGear(string baseId,int minimumQuality) {if (!AddItem(baseId,1)) {return false;}string id=baseId+"#"+Convert.ToString(Count(RunState,"gear_serial"));if (!GearBases.ContainsKey(id)) {return false;}GearQualities[id]=(int)Min(4,Max(minimumQuality,GearQuality(id)));if (GearQualities[id]==4) {StatMax("SPECIAL_RARITY",1);}return true;}
    public bool Unequip(string slot) {if (!Equipment.ContainsKey(slot) || Inventory.Count>=(int)Data.Rule("bag_capacity")) {return false;}string id=Equipment[slot];if (!AddItem(id,1)) {return false;}Equipment.Remove(slot);Hp=Min(Hp,MaxHp());return true;}
    public string ItemBaseId(string id) {return GearBases.ContainsKey(id) ? GearBases[id] : id;}
    public Row ItemRow(string id) {return Data.Find(Data.Items,ItemBaseId(id));}
    public int GearQuality(string id) {Row r=ItemRow(id);return GearQualities.ContainsKey(id) ? GearQualities[id] : r==null ? 0 : r.Int("quality");}
    public double GearStat(string id,string stat) {Row r=ItemRow(id);return r==null ? 0.0 : r.Num(stat)*(GearBases.ContainsKey(id) ? Data.Qualities[GearQuality(id)].Num("scale") : 1);}
    public string ItemName(string id) {Row r=ItemRow(id);return r==null ? id : (GearBases.ContainsKey(id) ? Data.Qualities[GearQuality(id)].Name+" · " : "")+r.Name;}
    public bool CompareGear(string id,string slot) {Row r=ItemRow(id);if (r==null || r.Text("slot")!=slot) {return false;}string old=Equipment.ContainsKey(slot) ? Equipment[slot] : "";return GearStat(id,"atk")*4+GearStat(id,"def")*3+GearStat(id,"hp")*0.2>GearStat(old,"atk")*4+GearStat(old,"def")*3+GearStat(old,"hp")*0.2;}
    public bool RecycleGear(string id) {Row r=ItemRow(id);if (r==null || r.Text("slot")=="" || !TakeItem(id,1)) {return false;}Stones=Stones+Max(5,(5+Level*1.5+GearStat(id,"atk")*2+GearStat(id,"def")*2+GearStat(id,"hp")*0.15)*(1+GearQuality(id)*0.35));return true;}
    public int MasteryStar(string id) {int star=1;foreach (Row r in Data.MasteryStars) {if (Count(Mastery,id)>=r.Int("threshold")) {star=r.Int("id");}}return star;}
    public double Effect(string id,string stat) {Row r=Data.Find(Data.Effects,id);return r==null ? 0.0 : r.Num(stat);}
    public double FormationEffect(string stat) {return Effect(Formation,stat)*FormationStars;}
    public double WineMultiplier(string stat) {double n=1;foreach (string id in WineTimers.Keys) {if (WineTimers[id]>0) {n=n*(1+Effect(id,stat));}}return n;}
    public void SetMusicAdjusted() {RunState["music_adjusted"]=1;}
    public bool ConsumeTalisman(string id) {return Loadout.ContainsKey("talisman") && Loadout["talisman"]==id && TakeItem(id,1);}
    public void BattleTalismans() {if (!Loadout.ContainsKey("talisman")) {return;}string id=Loadout["talisman"];if ((Effect(id,"opening")>0 || Effect(id,"swift")>0) && ConsumeTalisman(id)) {EnemyHp=Max(1,EnemyHp-EnemyMaxHp*Effect(id,"opening"));if (Effect(id,"swift")>0) {RunState["swift"]=(int)Effect(id,"swift");}}}
}
