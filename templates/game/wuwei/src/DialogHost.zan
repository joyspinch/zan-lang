using Gui;

/// 全窗透明宿主控件：挂在 Menu 树的最后一位，OnPaint 里泵删除确认
/// 弹窗。Layer 对话框的键盘消费要求按键是“当前事件”（app.EventKind()==4，
/// Layer.RenderDialog 1472 行门槛），而心跳定时器跑在 PumpTasks 阶段，
/// 届时 Win32Shell.ClearEvent() 已把事件清零——回车永远赶不上。
/// 保留树的绘制阶段则不然：RenderTree 在 RenderFrame 的渲染通路里
/// 执行，事件仍然有效，点击与回车都能在同一帧被读取（IDE 的
/// IdeSurface 与 gallery 的帧体末尾渲染对话框正是同一模式）。
class DialogHost : Control {
    /// 泵回调由 main.zan 在 BuildMenu 时挂上（闭包转发
    /// WuweiApp.PumpDeleteDialog）；无头模型测试编译 src/*.zan 时不带
    /// main.zan，此钩子保持 null，DialogHost 即为纯空件。
    static Action Pump;

    DialogHost() {
        this.InitControl("dialogHost", 5);
    }

    /// 平铺类型：皮肤的全局边框/阴影外壳不给它框盒子。
    override string StyleType() { return "empty"; }

    override void OnPaint(App app) {
        if (Pump != null) { Pump(); }
    }
}
