using System;
using System.Csv;
using System.IO;
namespace Wuwei;

// 核心契约与语义定义。
class Row {
    public string Id = "";
    public string Name = "";
    public Dictionary<string,string> Fields = new Dictionary<string,string>();
    public string Text(string key) { if (!Fields.ContainsKey(key)) { return ""; } return Fields[key]; }
    public double Num(string key) { string s = Text(key); if (s == "") { return 0; } return Convert.ToDouble(s); }
    public int Int(string key) { return (int)Num(key); }
}
class Tables {
    public List<Row> Realms; public List<Row> Maps; public List<Row> Enemies;
    public List<Row> Recipes; public List<Row> Ingredients; public List<Row> Skills;
    public List<Row> Items; public List<Row> Quests; public List<Row> Sects;
    public List<Row> SectTasks; public List<Row> Market; public List<Row> Talents; public List<Row> Balance;
    public List<Row> Achievements; public List<Row> SectVault; public List<Row> Arena; public List<Row> Effects; public List<Row> Qualities; public List<Row> MasteryStars; public List<Row> QuestRewards;
    public static List<Row> Read(string path) {
        string text=File.ReadAllText(path);
        if (File.EmbedExists("wuwei-data/realms.csv")) {
            SaveStore codec=new SaveStore("");
            text=codec.Decode(text);
        }
        CsvTable parsed = Csv.Parse(text);
        if (parsed.RowCount() < 1) { throw new Exception("Empty data table: " + path); }
        List<Row> result = new List<Row>(); List<string> header = parsed.Header();
        Dictionary<string,bool> ids = new Dictionary<string,bool>();
        List<List<string>> dataRows = parsed.Rows();
        for (int i = 0; i < dataRows.Count; i = i + 1) {
            List<string> values = dataRows[i];
            if (values.Count != header.Count) { throw new Exception("CSV column mismatch: " + path); }
            Row r = new Row();
            for (int j = 0; j < header.Count; j = j + 1) {
                if (r.Fields.ContainsKey(header[j])) { throw new Exception("Duplicate CSV header: " + path); }
                r.Fields.Add(header[j],values[j]);
            }
            r.Id = r.Text("id"); r.Name = r.Text("name");
            if (r.Id == "" || ids.ContainsKey(r.Id)) { throw new Exception("Duplicate/empty data ID: " + path); }
            ids.Add(r.Id,true); result.Add(r);
        }
        return result;
    }
    public static Tables Load(string directory) {
        Tables t = new Tables();
        // 核心契约与语义定义。
        string d = directory;
        if (File.EmbedExists("wuwei-data/realms.csv")) { d = "wuwei-data"; }
        t.Realms=Read(d+"/realms.csv"); t.Maps=Read(d+"/maps.csv"); t.Enemies=Read(d+"/enemies.csv");
        t.Recipes=Read(d+"/recipes.csv"); t.Ingredients=Read(d+"/ingredients.csv"); t.Skills=Read(d+"/skills.csv");
        t.Items=Read(d+"/items.csv"); t.Quests=Read(d+"/quests.csv"); t.Sects=Read(d+"/sects.csv");
        t.SectTasks=Read(d+"/sect_tasks.csv"); t.Market=Read(d+"/market.csv"); t.Talents=Read(d+"/talents.csv"); t.Balance=Read(d+"/balance.csv");
        t.Achievements=Read(d+"/achievements.csv");t.SectVault=Read(d+"/sect_vault.csv");t.Arena=Read(d+"/arena.csv");t.Effects=Read(d+"/effects.csv");t.Qualities=Read(d+"/qualities.csv");t.MasteryStars=Read(d+"/mastery_stars.csv");t.QuestRewards=Read(d+"/quest_rewards.csv");
        if (t.Realms.Count != 9 || t.Skills.Count != 10 || t.Talents.Count != 4) { throw new Exception("Unsupported Wuwei table schema"); }
        foreach (Row m in t.Maps) {
            if (m.Int("req") < 1 || m.Int("req") > 108 || m.Int("enemy_count") < 1 || m.Int("first_enemy") < 0 || m.Int("first_enemy")+m.Int("enemy_count") > t.Enemies.Count) { throw new Exception("Invalid map: " + m.Name); }
        }
        foreach (Row e in t.Enemies) { if (e.Num("hp") <= 0 || e.Num("interval") < 0.1 || e.Num("scale") <= 0) { throw new Exception("Invalid enemy: " + e.Name); } }
        foreach (Row r in t.Recipes) { if (r.Num("duration") < 0.1 || r.Int("unlock") < 1) { throw new Exception("Invalid recipe: " + r.Name); } }
        return t;
    }
    public Row Find(List<Row> rows,string id) { foreach (Row r in rows) { if (r.Id == id) { return r; } } return null; }
    public double Rule(string id) { Row r=Find(Balance,id); if (r == null) { throw new Exception("Missing balance: "+id); } return r.Num("value"); }
}
