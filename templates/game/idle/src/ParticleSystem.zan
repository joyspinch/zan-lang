using System;
using System.Collections.Generic;
using Gui;
using Game.Graphics;

// 金币喷发与火花：离屏画布烘焙两张带透明的矢量精灵（金币 / 光点），
// 再用 SpriteBatch 每类一次提交。金币按翻转相位压扁宽度，看起来在空中打转。
// 烘焙失败（没有 GPU 精灵通道）时退回逐个 FillCircle，效果不变只是慢一点。
public class ParticleSystem {
    List<Particle> particles;
    SpriteBatch coinBatch;
    SpriteBatch sparkBatch;
    Canvas bakeCanvas;
    int coinSprite;
    int sparkSprite;
    bool baked;
    Random rnd;

    ParticleSystem() {
        particles = new List<Particle>();
        coinBatch = SpriteBatch.Create(384);
        sparkBatch = SpriteBatch.Create(384);
        rnd = new Random();
        coinSprite = 0;
        sparkSprite = 0;
        baked = false;
        bakeCanvas = null;
    }

    static ParticleSystem Create() {
        return new ParticleSystem();
    }

    // 在离屏透明画布上画金币与光点并烘焙成精灵（只做一次）。
    void EnsureBaked() {
        if (baked) { return; }
        baked = true;
        bakeCanvas = new Canvas(64, 32);
        Canvas c = bakeCanvas;
        c.Clear(0x00000000);
        // 金币：暗金边 → 金面 → 内圈压纹 → 左上高光
        c.FillCircle(16, 16, 15, 0xFF8A4B08);
        c.FillCircle(16, 15, 13, 0xFFF2B32A);
        c.FillCircle(16, 16, 9, 0xFFD98E12);
        c.FillCircle(16, 15, 8, 0xFFFFD45A);
        c.FillRect(14, 10, 4, 11, 0xFFC97A0C);
        c.FillCircle(11, 10, 3, 0xCCFFF6D0);
        coinSprite = c.BakeSprite("idle:coin2", 0, 0, 32, 32);
        if (coinSprite <= 0) { coinSprite = c.SpriteHandle("idle:coin2"); }
        // 光点：柔边径向 + 白芯
        c.FillRadial(48, 16, 15, 0xFFFFC060, 200);
        c.FillCircle(48, 16, 4, 0xFFFFF4D8);
        sparkSprite = c.BakeSprite("idle:spark2", 32, 0, 32, 32);
        if (sparkSprite <= 0) { sparkSprite = c.SpriteHandle("idle:spark2"); }
    }

    // 点击点喷一把金币 + 火花；floor 是金币落地弹跳的 y（0 = 不弹）。
    void Burst(double x, double y, int coins, double floor) {
        double degToRad = 3.14159265 / 180.0;
        for (int i = 0; i < coins; i = i + 1) {
            double angle = (double)(200 + rnd.NextBelow(140)) * degToRad;   // 向上扇形
            double speed = 160.0 + (double)rnd.NextBelow(220);
            double vx = Math.Cos(angle) * speed;
            double vy = Math.Sin(angle) * speed - 80.0;
            double dur = 0.9 + (double)rnd.NextBelow(50) * 0.01;
            double sz = 15.0 + (double)rnd.NextBelow(8);
            Particle p = Particle.Spawn(x, y, vx, vy, dur, sz, (int)0xFFFFFFFF, 0);
            p.SetSpin((double)rnd.NextBelow(628) * 0.01, 9.0 + (double)rnd.NextBelow(80) * 0.1);
            p.SetFloor(floor);
            particles.Add(p);
        }
        for (int i = 0; i < coins / 2 + 3; i = i + 1) {
            double vx = (double)(rnd.NextBelow(320) - 160);
            double vy = (double)(rnd.NextBelow(260) - 200);
            double dur = 0.25 + (double)rnd.NextBelow(25) * 0.01;
            particles.Add(Particle.Spawn(x, y, vx, vy, dur, 12.0 + (double)rnd.NextBelow(10), (int)0xFFFFE6A0, 1));
        }
    }

    // 环形火星（金矿石敲开 / 超载点火）：一圈向外飞的火花。
    void Ring(double x, double y, int count, int tint) {
        double step = 6.2831853 / (double)count;
        for (int i = 0; i < count; i = i + 1) {
            double a = step * (double)i;
            double speed = 220.0 + (double)rnd.NextBelow(80);
            particles.Add(Particle.Spawn(x, y, Math.Cos(a) * speed, Math.Sin(a) * speed - 60.0, 0.55, 14.0, tint, 1));
        }
    }

    // 矿洞底的余烬：慢慢上飘、淡出。
    void Ember(double x, double y) {
        double vx = (double)(rnd.NextBelow(30) - 15);
        double vy = 0.0 - (double)(25 + rnd.NextBelow(35));
        double dur = 1.6 + (double)rnd.NextBelow(120) * 0.01;
        particles.Add(Particle.Spawn(x, y, vx, vy, dur, 7.0 + (double)rnd.NextBelow(6), (int)0xFFFF8A3A, 2));
    }

    bool HasActiveParticles {
        get { return particles.Count > 0; }
    }

    int ActiveCount { get { return particles.Count; } }

    void Update(double dt) {
        int i = 0;
        while (i < particles.Count) {
            if (!particles[i].Step(dt)) {
                particles.RemoveAt(i);
            } else {
                i = i + 1;
            }
        }
    }

    // 两层各一次提交：先光点（垫在下面），再金币。
    void Render(Canvas c) {
        if (particles.Count == 0) { return; }
        EnsureBaked();
        bool sprites = coinSprite > 0 && sparkSprite > 0;
        sparkBatch.Begin();
        coinBatch.Begin();
        for (int i = 0; i < particles.Count; i = i + 1) {
            Particle p = particles[i];
            double pgr = p.Progress;
            double fade = p.IsCoin ? (pgr < 0.75 ? 1.0 : (1.0 - pgr) * 4.0) : 1.0 - pgr;
            int alpha = (int)(fade * 255.0);
            if (alpha <= 0) { continue; }
            if (alpha > 255) { alpha = 255; }
            int rgb = p.Tint & 0x00FFFFFF;
            int tint = (alpha << 24) | rgb;
            // SpriteBatch 的染色是 0xAABBGGRR：交换红蓝两个通道。
            int abgr = (alpha << 24) | ((rgb & 0xFF) << 16) | (rgb & 0xFF00) | ((rgb >> 16) & 0xFF);
            double sz = p.IsCoin ? p.Size : p.Size * (1.0 - pgr * 0.5);
            double w = sz;
            if (p.IsCoin) {
                w = sz * Math.Abs(Math.Cos(p.Spin));
                if (w < 2.0) { w = 2.0; }
            }
            if (!sprites) {
                int col = p.IsCoin ? ((alpha << 24) | 0xF2B32A) : tint;
                c.FillCircle((int)p.X, (int)p.Y, (int)(w * 0.5) + 1, col);
                continue;
            }
            float dx = (float)(p.X - w * 0.5);
            float dy = (float)(p.Y - sz * 0.5);
            if (p.IsCoin) {
                coinBatch.Add(dx, dy, (float)w, (float)sz, 0.0f, 0.0f, 32.0f, 32.0f, abgr);
            } else {
                sparkBatch.Add(dx, dy, (float)w, (float)sz, 0.0f, 0.0f, 32.0f, 32.0f, abgr);
            }
        }
        if (sprites) {
            sparkBatch.Draw(c, sparkSprite);
            coinBatch.Draw(c, coinSprite);
        }
    }

    void Dispose() {
        if (coinBatch != null) { coinBatch.Dispose(); coinBatch = null; }
        if (sparkBatch != null) { sparkBatch.Dispose(); sparkBatch = null; }
        if (bakeCanvas != null) { bakeCanvas.Destroy(); bakeCanvas = null; }
    }
}
