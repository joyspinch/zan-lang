using System;

// 成就表：这座矿场的 16 个成就（名字 / 说明 / 判定种类 / 门槛）。
//
// 每解锁一个，全局产出永久 +2%（转生也保留）。判定在 MineEconomy.CheckAchievements，
// 这里只放内容——换游戏只改这张表。
//
// 判定种类：0 手动开采次数 · 1 矿机总等级 · 2 秒产 · 3 累计开采 · 4 单座矿机最高等级 ·
//           5 敲开金矿石次数 · 6 熔炉超载次数 · 7 转生次数 · 8 持有地心晶
public class MineAchievements {
    public const int Count = 16;

    static string[] s_names;
    static string[] s_descs;
    static int[] s_kinds;
    static double[] s_goals;

    static void Ensure() {
        if (s_names != null) { return; }
        s_names = new string[16] {
            "第一镐", "铁臂矿工", "开矿立业", "矿业集团", "地心帝国", "涓涓细流", "金流滚滚", "熔金洪流",
            "百万富矿", "十亿矿脉", "精工细作", "百炼成钢", "淘金客", "炉火纯青", "涅槃", "晶石收藏家"
        };
        s_descs = new string[16] {
            "手动开采 1 次", "手动开采 500 次", "矿机总等级达到 10", "矿机总等级达到 100",
            "矿机总等级达到 400", "秒产达到 100", "秒产达到 10K", "秒产达到 1M",
            "累计开采 1M 金币", "累计开采 1B 金币", "任一矿机升到 Lv25", "任一矿机升到 Lv100",
            "敲开 5 块金矿石", "启动熔炉超载 10 次", "完成第一次地心转生", "持有 50 枚地心晶"
        };
        s_kinds = new int[16] { 0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 4, 4, 5, 6, 7, 8 };
        s_goals = new double[16] {
            1.0, 500.0, 10.0, 100.0, 400.0, 100.0, 10000.0, 1000000.0,
            1000000.0, 1000000000.0, 25.0, 100.0, 5.0, 10.0, 1.0, 50.0
        };
    }

    public static string Name(int id) { Ensure(); return s_names[id]; }
    public static string Desc(int id) { Ensure(); return s_descs[id]; }
    public static int Kind(int id) { Ensure(); return s_kinds[id]; }
    public static double Goal(int id) { Ensure(); return s_goals[id]; }
}
