using System;
using System.Collections.Generic;
using Game.Idle;

// 采矿矩阵内容表：这座游戏的八座矿机（名字 / 描述 / 基础价 / 每级基础产出）。
//
// 机制（成本曲线 1.15 倍率、产出）在 Game.Idle 包里；里程碑翻倍、转生、成就加成在
// MineEconomy；这里只有"这个游戏有什么矿机"——换游戏只改这张表。
// 价位大约每座 ×10~15，产出回本时间逐座拉长，后两座是转生前的冲刺目标。
public class MineCatalog {
    public const int Count = 8;

    static List<IdleBuilding> Create() {
        List<IdleBuilding> list = new List<IdleBuilding>();
        list.Add(new IdleBuilding(0, "机械鹤嘴锄", "强化基础挖掘动力", 15, 1));
        list.Add(new IdleBuilding(1, "蒸汽矿井", "自动化深层矿石提取", 100, 8));
        list.Add(new IdleBuilding(2, "熔岩钻头", "穿透玄武岩层直取地心", 1100, 45));
        list.Add(new IdleBuilding(3, "地热精炼厂", "借地核热能加速提纯", 12000, 260));
        list.Add(new IdleBuilding(4, "量子对撞机", "直接合成纯净暗金矿", 130000, 1800));
        list.Add(new IdleBuilding(5, "戴森采矿站", "恒星级自动化采矿矩阵", 1400000, 14000));
        list.Add(new IdleBuilding(6, "地幔虹吸塔", "把熔融地幔整层抽上地表", 20000000, 110000));
        list.Add(new IdleBuilding(7, "星核熔炉", "点燃一颗人造恒星来熔矿", 330000000, 900000));
        return list;
    }

    // 卡片上的矿机图标（单字符，跟随皮肤字号）。
    static string Icon(int id) {
        if (id == 0) { return "⚒"; }
        if (id == 1) { return "♨"; }
        if (id == 2) { return "⚙"; }
        if (id == 3) { return "♆"; }
        if (id == 4) { return "⚛"; }
        if (id == 5) { return "☀"; }
        if (id == 6) { return "♒"; }
        return "✹";
    }
}
