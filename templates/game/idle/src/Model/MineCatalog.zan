using System;
using System.Collections.Generic;
using Game.Idle;

// 采矿矩阵内容表：这座游戏的六座矿机（名字 / 描述 / 基础价 / 基础产出）。
//
// 机制（升级曲线、点击产出、每秒产出、离线结算）在 Game.Idle 包里；
// 这里只有"这个游戏有什么矿机"——换游戏只改这张表。
public class MineCatalog {
    static List<IdleBuilding> Create() {
        List<IdleBuilding> list = new List<IdleBuilding>();
        list.Add(new IdleBuilding(0, "机械鹤嘴锄", "强化基础挖掘动力 (+1/s)", 15, 1));
        list.Add(new IdleBuilding(1, "蒸汽矿井", "自动化深层矿石提取 (+8/s)", 100, 8));
        list.Add(new IdleBuilding(2, "熔岩钻头", "穿透玄武岩层地心挖掘 (+45/s)", 1100, 45));
        list.Add(new IdleBuilding(3, "地热精炼厂", "利用地核能源加速提纯 (+260/s)", 12000, 260));
        list.Add(new IdleBuilding(4, "量子对撞机", "直接合成纯净暗金矿 (+1800/s)", 130000, 1800));
        list.Add(new IdleBuilding(5, "戴森球采矿站", "恒星级自动化采矿矩阵 (+14000/s)", 1400000, 14000));
        return list;
    }
}
