using System;
using System.Collections.Generic;

public class Building {
    int id;
    string name;
    string desc;
    int level;
    long baseCost;
    long baseDps;
    double costMult;

    static Building Create(int id, string name, string desc, long baseCost, long baseDps) {
        Building b = new Building();
        b.id = id;
        b.name = name;
        b.desc = desc;
        b.level = 0;
        b.baseCost = baseCost;
        b.baseDps = baseDps;
        b.costMult = 1.15;
        return b;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    string Desc { get { return desc; } }
    int Level { get { return level; } }

    long Cost {
        get {
            double c = (double)baseCost * Math.Pow(costMult, (double)level);
            return (long)c;
        }
    }

    long Dps {
        get {
            return baseDps * (long)level;
        }
    }

    void Upgrade() {
        level = level + 1;
    }
}

