using System;
using System.Collections.Generic;
using Gui;
using Gui.Rendering;

public class Particle {
    double x;
    double y;
    double vx;
    double vy;
    double life;
    double maxLife;
    double invMaxLife;
    double size;
    int tint;
    bool isCoin;

    static Particle Spawn(double x, double y, double vx, double vy, double duration, double size, int tint, bool isCoin) {
        Particle p = new Particle();
        p.x = x;
        p.y = y;
        p.vx = vx;
        p.vy = vy;
        p.life = duration;
        p.maxLife = duration;
        p.invMaxLife = duration > 0.0001 ? 1.0 / duration : 1.0;
        p.size = size;
        p.tint = tint;
        p.isCoin = isCoin;
        return p;
    }

    bool Step(double dt) {
        life = life - dt;
        if (life <= 0.0) { return false; }
        x = x + vx * dt;
        y = y + vy * dt;
        vy = vy + 300.0 * dt;  // 重力加速度
        return true;
    }

    double Progress { get { return 1.0 - (life * invMaxLife); } }
    double X { get { return x; } }
    double Y { get { return y; } }
    double Size { get { return size; } }
    int Tint { get { return tint; } }
    bool IsCoin { get { return isCoin; } }
}

// 高性能粒子发射与批量渲染器（使用 SpriteBatch 统一合批）。
