using System;
using System.Collections.Generic;
using Gui;

// 一颗粒子：金币（会翻转、受重力、落到矿洞底会弹一下）或火花/余烬（只飘不弹）。
public class Particle {
    double x;
    double y;
    double vx;
    double vy;
    double life;
    double maxLife;
    double invMaxLife;
    double size;
    double spin;       // 金币翻转相位（弧度）
    double spinSpeed;
    double floorY;     // 落地线（金币弹跳用；0 = 不弹）
    int tint;
    int kind;          // 0 金币 1 火花 2 余烬（向上飘）

    static Particle Spawn(double x, double y, double vx, double vy, double duration, double size, int tint, int kind) {
        Particle p = new Particle();
        p.x = x;
        p.y = y;
        p.vx = vx;
        p.vy = vy;
        p.life = duration;
        p.maxLife = duration;
        p.invMaxLife = duration > 0.0001 ? 1.0 / duration : 1.0;
        p.size = size;
        p.tint = tint;
        p.kind = kind;
        p.spin = 0.0;
        p.spinSpeed = 0.0;
        p.floorY = 0.0;
        return p;
    }

    void SetSpin(double phase, double speed) {
        spin = phase;
        spinSpeed = speed;
    }

    void SetFloor(double y) { floorY = y; }

    bool Step(double dt) {
        life = life - dt;
        if (life <= 0.0) { return false; }
        x = x + vx * dt;
        y = y + vy * dt;
        spin = spin + spinSpeed * dt;
        if (kind == 2) {
            vy = vy - 20.0 * dt;          // 余烬：热气上浮
            vx = vx * (1.0 - 0.8 * dt);
        } else {
            vy = vy + 620.0 * dt;         // 重力
            vx = vx * (1.0 - 0.6 * dt);
        }
        if (floorY > 0.0 && y > floorY && vy > 0.0) {
            y = floorY;
            vy = 0.0 - vy * 0.42;         // 落地弹一下
            vx = vx * 0.7;
            spinSpeed = spinSpeed * 0.6;
        }
        return true;
    }

    double Progress { get { return 1.0 - (life * invMaxLife); } }
    double X { get { return x; } }
    double Y { get { return y; } }
    double Size { get { return size; } }
    double Spin { get { return spin; } }
    int Tint { get { return tint; } }
    int Kind { get { return kind; } }
    bool IsCoin { get { return kind == 0; } }
}
