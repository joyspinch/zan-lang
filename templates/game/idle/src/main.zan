using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Gui.Animation;
using Game.Foundation;
using Game.Idle;

public class Program {
    // 离线收益上限（小时）与自动存档间隔（毫秒）。
    const double OfflineCapHours = 8.0;
    const int AutosaveMs = 20000;

    Form form;
    App app;
    IdleState state;
    ParticleSystem particles;

    // 外壳：玩家档案（统计/静音）、经济存档、音效
    GameProfile profile;
    IdleSaveGame save;
    AudioBus bus;
    SfxBank sfx;
    bool muted;
    bool firstSession;

    // 界面控件
    Label lblGold;
    Label lblDps;
    Label lblClickPower;
    Label lblStatus;
    Button btnMute;
    List<BuildingUiRow> buildingUiRows;
    Progress autoMineBar;
    MineCoreView coreView;

    // 统计 / 离线收益弹窗（标准 Modal 控件）
    Modal statsModal;
    Label statGold;
    Label statDps;
    Label statLifetime;
    Label statBestDps;
    Label statClicks;
    Label statSessions;
    Label statSave;
    Modal welcomeModal;
    Label welcomeGold;
    Label welcomeTime;
    bool welcomePending;

    // 核心反应炉动画与打击动效系统
    double coreScale = 1.0;
    Tween coreTween;
    double autoProgress = 0.0;
    SquashAndStretch coreJuice;
    FloatingTextManager fctManager;

    // 实时结算 / 存档 / 统计同步的游标
    int lastTickMs;
    int lastAudioMs;
    double syncedEarned;
    long syncedClicks;
    double nextMilestone;
    int statusUntilMs;

    static void Main() {
        Program p = new Program();
        p.Run();
    }

    void Run() {
        form = Form.CreateDark("放置矿工 · 地心开采 (Idle Miner)", 1024, 640);
        app = form.GetApp();
        app.UseSkin("graphite");
        UiDriver.Enable(app);
        Canvas.SetBackend(1);  // 启用 GL 硬件加速后端

        // 绑定 AnimationTimeline，按需驱动出帧
        AnimationTimeline.Shared.BindApp(app);

        state = new IdleState(MineCatalog.Create());
        particles = ParticleSystem.Create();
        coreJuice = SquashAndStretch.Create();
        fctManager = FloatingTextManager.Create(64);
        buildingUiRows = new List<BuildingUiRow>();

        OpenShell();
        long offlineGold = LoadEconomy();

        BuildUi();
        BuildStatsModal();
        BuildWelcomeModal(offlineGold);
        UpdateLabels();

        lastTickMs = Window.GetTickMs();
        lastAudioMs = lastTickMs;

        // 核心游戏逻辑时钟：按真实流逝时间结算（窗口失焦/最小化时定时器可能被
        // 降频，按实际毫秒补算才不少给钱；放置游戏不暂停）。
        form.Every(100, () => {
            int now = Window.GetTickMs();
            double dt = (double)(now - lastTickMs) / 1000.0;
            lastTickMs = now;
            if (dt < 0.0) { dt = 0.0; }
            if (dt > 60.0) { dt = 60.0; }
            state.Tick(dt);

            // 步进打击物理振荡与飘字池
            coreJuice.Update(0.1);
            fctManager.Update(0.1);

            // 更新自动采矿进度条
            autoProgress = autoProgress + 0.1;
            if (autoProgress >= 1.0) {
                autoProgress = 0.0;
            }
            if (autoMineBar != null) {
                autoMineBar.SetPercent((int)(autoProgress * 100.0));
            }

            // 更新粒子与重绘
            if (particles.HasActiveParticles || fctManager.ActiveCount > 0) {
                if (particles.HasActiveParticles) {
                    particles.Update(0.1);
                }
                app.RequestRedraw();
            }

            CheckMilestone();
            UpdateLabels();
        });

        // 自动存档
        form.Every(AutosaveMs, () => { Persist(); });

        form.FrameHook(() => { OnFrame(); });
        // M 静音：没被控件消费的按键（焦点落空或在按钮上）都走这里。
        app.OnUnhandledKey((int code) => { if (code == 77) { ToggleMute(); } });
        // 失焦：顺手存一档（继续挂机收益，不暂停）。
        app.OnWindowBlur(() => { Persist(); });

        form.OnExit(() => {
            Persist();
            particles.Dispose();
            sfx.Dispose();
        });

        form.Run();
    }

    // ---- 外壳：档案 / 存档 / 音效 ---------------------------------------

    void OpenShell() {
        profile = GameProfile.Open("idle");
        firstSession = profile.Counter("sessions") == 0;
        profile.Add("sessions", 1);
        profile.Save();

        bus = new AudioBus();
        sfx = new SfxBank(bus);
        // 本游戏的声音：轻敲矿石（很轻、限频）、买到矿机（金币）、钱不够（错误）、
        // 里程碑（升级音）、离线收益到账（成功）、普通按钮（选择）。
        sfx.AddSynth("ore", SfxPresets.Hit().WithGain(0.10));
        sfx.AddSynth("coin", SfxPresets.Coin().WithSweep(1180.0, 1980.0));
        sfx.AddPresets(new string[] { "error", "powerup", "success", "select" });
        sfx.Warm();
        muted = profile.Flag("muted", false);
        bus.SetSfxMuted(muted);

        save = IdleSaveGame.Open();
    }

    // 读档并结算离线收益，返回本次离线入账的金币（没有则 0）。
    long LoadEconomy() {
        long savedAt = save.Load(state);
        syncedEarned = state.totalEarned;
        syncedClicks = state.clicks;
        long offline = 0;
        if (savedAt > 0) {
            OfflineRewardCalculator calc = OfflineRewardCalculator.Create(OfflineCapHours, state.TotalDps);
            long elapsedSec;
            long cappedSec;
            double rewardGold;
            calc.CalculateReward(savedAt, IdleSaveGame.NowSec(), out elapsedSec, out cappedSec, out rewardGold);
            if (cappedSec >= 30 && rewardGold >= 1.0) {
                state.AddGold(rewardGold);
                offline = ClampLong(rewardGold);
                welcomePending = true;
                offlineElapsed = elapsedSec;
                offlineCapped = cappedSec;
            }
        }
        // 已越过的里程碑不重复庆祝
        nextMilestone = 1000.0;
        while (nextMilestone <= state.totalEarned) { nextMilestone = nextMilestone * 10.0; }
        return offline;
    }
    long offlineElapsed;
    long offlineCapped;

    // 落盘：经济存档 + 统计（累计开采、点击、最高秒产）。
    void Persist() {
        long nowSec = IdleSaveGame.NowSec();
        save.Save(state, nowSec);
        double earnedDelta = state.totalEarned - syncedEarned;
        if (earnedDelta >= 1.0) {
            long add = ClampLong(earnedDelta);
            profile.Add("mined", add);
            syncedEarned = syncedEarned + (double)add;
        }
        if (state.clicks > syncedClicks) {
            profile.Add("clicks", state.clicks - syncedClicks);
            syncedClicks = state.clicks;
        }
        // SubmitBest 刷新纪录时自己会落盘；否则这里补一次
        if (!profile.SubmitBest("bestGps", ClampLong(state.TotalDps))) {
            profile.Save();
        }
    }

    void Play(string name) { sfx.Play(name); }

    void ToggleMute() {
        muted = !muted;
        bus.SetSfxMuted(muted);
        profile.SetFlag("muted", muted);
        if (btnMute != null) { btnMute.Text = muted ? "🔇 静音 (M)" : "🔊 音效 (M)"; }
        ShowStatus(muted ? "音效已关闭（按 M 恢复）" : "音效已开启");
        if (!muted) { Play("select"); }
        app.RequestRedraw();
    }

    // 每圈主循环：推进音效冷却、读 M 键、失焦即存档、首帧弹离线收益。
    void OnFrame() {
        int now = Window.GetTickMs();
        int dms = now - lastAudioMs;
        lastAudioMs = now;
        if (dms > 0) { bus.Update(dms); }

        if (welcomePending && welcomeModal != null) {
            welcomePending = false;
            welcomeModal.Show();
            app.overlayHost.Push(app, null, welcomeModal, true);
            Play("success");
        }

        if (statusUntilMs != 0 && now >= statusUntilMs) {
            statusUntilMs = 0;
            lblStatus.Text = DefaultStatus();
            app.RequestRedraw();
        }
        PublishProbes();
    }

    string DefaultStatus() {
        if (firstSession && state.TotalDps <= 0.0) {
            return "新手提示：点矿晶开采金币 → 右侧升级矿机，之后关掉游戏也在挖（离线最多 8 小时）。M 键静音。";
        }
        return "每 20 秒自动存档 · 离线收益最多 8 小时 · M 键静音";
    }

    void ShowStatus(string text) {
        if (lblStatus == null) { return; }
        lblStatus.Text = text;
        statusUntilMs = Window.GetTickMs() + 3000;
        if (statusUntilMs == 0) { statusUntilMs = 1; }
    }

    void CheckMilestone() {
        if (state.totalEarned < nextMilestone) { return; }
        double reached = nextMilestone;
        while (nextMilestone <= state.totalEarned) { nextMilestone = nextMilestone * 10.0; }
        Play("powerup");
        ShowStatus("🏆 里程碑：累计开采 " + FormatNumber(reached) + " 金币！");
        if (coreView != null) {
            fctManager.SpawnGold((double)(coreView.bx + coreView.bw / 2 - 30), (double)(coreView.by + 30), FormatNumber(reached) + "!");
        }
    }

    void PublishProbes() {
        if (!UiDriver.Active()) { return; }
        UiDriver.SetProbe("idle.gold", Convert.ToString(ClampLong(state.gold)));
        UiDriver.SetProbe("idle.muted", muted ? "1" : "0");
        UiDriver.SetProbe("idle.levels", LevelsText());
        UiDriver.SetProbe("idle.persistent", save.Persistent() ? "1" : "0");
        UiDriver.SetProbe("idle.welcome", welcomeModal != null && welcomeModal.IsOpen() ? "1" : "0");
    }

    string LevelsText() {
        string s = "";
        for (int i = 0; i < state.buildings.Count; i = i + 1) {
            if (i > 0) { s = s + ","; }
            s = s + Convert.ToString(state.buildings[i].level);
        }
        return s;
    }

    // ---- 界面 -----------------------------------------------------------

    void BuildUi() {
        Panel root = Panel.Column();
        root.Pad(16);
        root.Gap(12);
        form.Add(root);

        // 1. 顶部资源栏
        Panel topBar = Panel.Row();
        topBar.Class = "card";
        topBar.Pad(12);
        topBar.Gap(20);
        topBar.Prefer(0, 64);
        root.With(topBar);

        Label title = new Label("⚒ 放置矿工");
        title.Class = "title strong";
        topBar.With(title);

        lblGold = new Label("金币: 0");
        lblGold.Class = "large strong yellow";
        topBar.With(lblGold);

        lblDps = new Label("秒产: +0/s");
        lblDps.Class = "medium green";
        topBar.With(lblDps);

        lblClickPower = new Label("单次挖掘: +1");
        lblClickPower.Class = "medium cyan";
        topBar.With(lblClickPower);

        Button btnStats = new Button("📊 采矿统计");
        btnStats.Class = "secondary";
        btnStats.OnClick(() => {
            Play("select");
            OpenStats();
        });
        topBar.With(btnStats);

        btnMute = new Button(muted ? "🔇 静音 (M)" : "🔊 音效 (M)");
        btnMute.Class = "secondary";
        btnMute.Tip = "开关音效（快捷键 M）";
        btnMute.OnClick(() => {
            ToggleMute();
        });
        topBar.With(btnMute);

        // 2. 主体区（双栏：左侧开采核心，右侧建筑生产线）
        Panel mainRow = Panel.Row();
        mainRow.Gap(16);
        mainRow.Grow();
        root.With(mainRow);

        // 左栏：矿石操作台
        Panel leftCol = Panel.Column();
        leftCol.Class = "card";
        leftCol.Pad(16);
        leftCol.Gap(14);
        leftCol.Prefer(340, 0);
        mainRow.With(leftCol);

        Label coreTitle = new Label("地心矿晶核心");
        coreTitle.Class = "title medium";
        leftCol.With(coreTitle);

        // 自定义矿石核心视图
        coreView = new MineCoreView(this);
        coreView.Prefer(300, 200);
        coreView.OnClick(() => {
            DoMine(coreView.bx + coreView.bw / 2, coreView.by + coreView.bh / 2);
        });
        leftCol.With(coreView);

        Button btnMine = new Button("🔨 立即开采");
        btnMine.Class = "primary large";
        btnMine.Prefer(0, 48);
        btnMine.OnClick(() => {
            DoMine(coreView.bx + coreView.bw / 2, coreView.by + coreView.bh / 2);
        });
        leftCol.With(btnMine);

        Label lblAuto = new Label("自动开采循环");
        lblAuto.Class = "secondary small";
        leftCol.With(lblAuto);

        autoMineBar = new Progress(0, 1);
        autoMineBar.SetPercent(0);
        autoMineBar.Prefer(0, 16);
        leftCol.With(autoMineBar);

        lblStatus = new Label(DefaultStatus());
        lblStatus.Class = "secondary small";
        lblStatus.SetWrap(true);
        leftCol.With(lblStatus);

        // 右栏：工业建筑列表
        Panel rightCol = Panel.Column();
        rightCol.Class = "card";
        rightCol.Pad(12);
        rightCol.Gap(8);
        rightCol.Grow();
        mainRow.With(rightCol);

        Label listTitle = new Label("自动化生产矩阵");
        listTitle.Class = "title medium";
        rightCol.With(listTitle);

        List<IdleBuilding> list = state.Buildings;
        for (int i = 0; i < list.Count; i = i + 1) {
            IdleBuilding b = list[i];
            int idx = i;

            Panel item = Panel.Row();
            item.Class = "subcard";
            item.Pad(8);
            item.Gap(12);
            item.Prefer(0, 62);
            rightCol.With(item);

            Panel infoCol = Panel.Column();
            infoCol.Gap(2);
            infoCol.Grow();
            item.With(infoCol);

            Label nameLbl = new Label(b.Name);
            nameLbl.Class = "strong";
            infoCol.With(nameLbl);

            Label descLbl = new Label(b.Desc);
            descLbl.Class = "secondary tiny";
            infoCol.With(descLbl);

            Label lvLbl = new Label("Lv." + Convert.ToString(b.Level));
            lvLbl.Class = "cyan strong";
            item.With(lvLbl);

            Label costLbl = new Label("💰 " + Convert.ToString(b.Cost));
            costLbl.Class = "yellow";
            item.With(costLbl);

            // 买不起时不禁用按钮：点下去要有"钱不够"的反馈，而不是毫无反应。
            Button btnBuy = new Button("升级");
            btnBuy.Class = "primary";
            btnBuy.Prefer(70, 36);
            btnBuy.OnClick(() => {
                TryUpgrade(idx);
            });
            item.With(btnBuy);
            buildingUiRows.Add(new BuildingUiRow(btnBuy, lvLbl, costLbl));
        }
    }

    void BuildStatsModal() {
        statsModal = new Modal("📊 采矿统计");
        statsModal.Width(460);
        Panel body = Panel.Column();
        body.Gap(8);
        statGold = StatLine(body);
        statDps = StatLine(body);
        statBestDps = StatLine(body);
        statLifetime = StatLine(body);
        statClicks = StatLine(body);
        statSessions = StatLine(body);
        statSave = StatLine(body);
        statSave.Class = "secondary small";
        statSave.SetWrap(true);
        statsModal.Content(body);
        statsModal.OkText("关闭");
        statsModal.Actions(new List<Control> { statsModal.okBtn });
        statsModal.OnOk(() => { statsModal.Hide(); });
    }

    Label StatLine(Panel into) {
        Label l = new Label("");
        l.Class = "medium";
        into.With(l);
        return l;
    }

    void OpenStats() {
        // 打开前先把统计同步进档案，面板上的"累计"才是最新的
        Persist();
        statGold.Text = "当前金币：" + FormatNumber(state.Gold);
        statDps.Text = "当前秒产：+" + FormatNumber(state.TotalDps) + "/s";
        statBestDps.Text = "最高秒产：+" + FormatNumber((double)profile.Best("bestGps")) + "/s";
        statLifetime.Text = "累计开采：" + FormatNumber((double)profile.Counter("mined")) + " 金币";
        statClicks.Text = "手动开采：" + Convert.ToString(profile.Counter("clicks")) + " 次";
        statSessions.Text = "上线次数：" + Convert.ToString(profile.Counter("sessions"));
        statSave.Text = save.Persistent()
            ? "存档：" + save.Directory() + "（每 20 秒、失焦与退出时自动保存）"
            : "存档：未找到用户数据目录，本次进度不会保存";
        statsModal.Show();
        app.overlayHost.Push(app, null, statsModal, true);
        app.RequestRedraw();
    }

    void BuildWelcomeModal(long offlineGold) {
        welcomeModal = new Modal("⛏ 欢迎回来！");
        welcomeModal.Width(420);
        Panel body = Panel.Column();
        body.Gap(10);
        Label lead = new Label("你不在的时候，矿机一直在挖：");
        lead.Class = "secondary";
        body.With(lead);
        welcomeGold = new Label("+" + FormatNumber((double)offlineGold) + " 金币");
        welcomeGold.Class = "title strong yellow";
        body.With(welcomeGold);
        string away = "离线 " + OfflineRewardCalculator.FormatDuration(offlineElapsed);
        if (offlineElapsed > offlineCapped) {
            away = away + "（收益按上限 " + OfflineRewardCalculator.FormatDuration(offlineCapped) + " 结算）";
        }
        welcomeTime = new Label(away);
        welcomeTime.Class = "secondary small";
        welcomeTime.SetWrap(true);
        body.With(welcomeTime);
        welcomeModal.Content(body);
        welcomeModal.OkText("收下");
        welcomeModal.Actions(new List<Control> { welcomeModal.okBtn });
        welcomeModal.OnOk(() => {
            welcomeModal.Hide();
            Play("coin");
        });
    }

    // 手动点击矿石开采。
    void DoMine(double x, double y) {
        state.Mine();
        Play("ore");

        // 1. 触发弹簧阻尼打击感挤压与回弹
        coreJuice.Trigger(0.35);

        // 2. 每 5 下一次"暴击"跳字（纯视觉节奏），金币飘字是真实入账
        bool isCrit = state.clicks % 5 == 0;
        fctManager.SpawnDamage(x - 20.0, y - 15.0, state.ClickPower * (isCrit ? 2 : 1), isCrit);
        fctManager.SpawnGold(x + 10.0, y - 25.0, Convert.ToString(state.ClickPower));

        // 3. 矿晶动画
        coreScale = 1.25;
        if (coreTween != null) { coreTween.Stop(); }
        coreTween = AnimationTimeline.To(1.25f, 1.0f, 350, EaseType.BackOut, (float val) => {
            coreScale = (double)val;
            app.RequestRedraw();
        });

        // 4. 喷射飞行动画金币与火花
        particles.Burst(x, y, 6);

        CheckMilestone();
        UpdateLabels();
        app.RequestRedraw();
    }

    void TryUpgrade(int idx) {
        IdleBuilding b = state.buildings[idx];
        double cost = (double)b.Cost;
        if (state.UpgradeBuilding(idx)) {
            Play("coin");
            ShowStatus("✔ " + b.Name + " 升到 Lv." + Convert.ToString(b.Level) + "，秒产 +" + FormatNumber(state.TotalDps) + "/s");
            firstSession = false;
        } else {
            Play("error");
            ShowStatus("金币不足：" + b.Name + " 还差 " + FormatNumber(cost - state.gold));
        }
        UpdateLabels();
        app.RequestRedraw();
    }

    // 由 MineCoreView 驱动绘制动态矿石、打击形变、粒子和高性能飘字。
    void RenderMiningArea(Canvas c, int bx, int by, int bw, int bh) {
        int cx = bx + bw / 2;
        int cy = by + bh / 2;

        // 根据 coreJuice 的弹性缩放与 coreScale 计算动态核心尺寸
        int baseR = (int)(55.0 * coreScale);
        int rx = (int)((double)baseR * coreJuice.ScaleX);
        int ry = (int)((double)baseR * coreJuice.ScaleY);
        int r = (rx + ry) / 2;

        // 外层能量光晕
        c.FillCircle(cx, cy, r + 15, 0x22F59E0B);
        c.FillCircle(cx, cy, r + 8, 0x44F59E0B);

        // 晶体六边形或多层圆环（响应打击缩放）
        c.FillCircle(cx, cy, r, 0xFFD97706);
        c.DrawCircle(cx, cy, r, 0xFFFDE68A, 3);
        c.FillCircle(cx, cy, (int)(r * 0.7), 0xFFF59E0B);
        c.FillCircle(cx, cy, (int)(r * 0.4), 0xFFFEF3C7);

        // 绘制粒子
        particles.Render(c);

        // 绘制高性能无 GC 飘字
        fctManager.Render(c, null);
    }

    void UpdateLabels() {
        if (lblGold != null) {
            lblGold.Text = "金币: " + FormatNumber(state.Gold);
        }
        if (lblDps != null) {
            lblDps.Text = "秒产: +" + FormatNumber(state.TotalDps) + "/s";
        }
        if (lblClickPower != null) {
            lblClickPower.Text = "单次挖掘: +" + Convert.ToString(state.ClickPower);
        }

        List<IdleBuilding> list = state.Buildings;
        for (int i = 0; i < list.Count; i = i + 1) {
            IdleBuilding b = list[i];
            if (i < buildingUiRows.Count) {
                BuildingUiRow row = buildingUiRows[i];
                row.levelLabel.Text = "Lv." + Convert.ToString(b.Level);
                row.costLabel.Text = "💰 " + FormatNumber((double)b.Cost);
                bool canAfford = state.CanAfford(b);
                if (canAfford != row.affordable) {
                    row.affordable = canAfford;
                    row.buyButton.SwitchClass("primary", canAfford);
                    row.buyButton.SwitchClass("secondary", !canAfford);
                }
            }
        }
    }

    static long ClampLong(double n) {
        if (!(n > 0.0)) { return 0; }
        if (n >= 9.0e18) { return 9000000000000000000L; }
        return (long)n;
    }

    // 千进制后缀（K/M/B/T/Qa…），长线放置超过 B 也不会显示成 "1000.0B"。
    string FormatNumber(double n) {
        if (n < 0.0) { return "-" + BigNum.Short(ClampLong(0.0 - n)); }
        return BigNum.Short(ClampLong(n));
    }
}
