using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Animation;
using Gui.Rendering;
using Game.Idle;

public class MineCoreView : Control {
    Program host;

    MineCoreView(Program host) {
        this.InitControl("minecore", 1);
        this.host = host;
    }

    override void OnPaint(App app) {
        base.OnPaint(app);
        Canvas c = app.canvas;
        host.RenderMiningArea(c, this.bx, this.by, this.bw, this.bh);
    }
}

