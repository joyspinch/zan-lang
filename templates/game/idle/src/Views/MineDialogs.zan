using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Game.Foundation;
using Game.Idle;

// 游戏里的四个弹窗（全是标准 Modal，样式走 MineSkin 的 mn-modal）：
//   欢迎回来（离线收益）· 采矿统计 · 成就墙 · 地心转生确认（显示本次能拿多少地心晶）。
public class MineDialogs {
    public Modal welcome;
    public Modal stats;
    public Modal achievements;
    public Modal prestige;

    Label welcomeGold;
    Label welcomeTime;

    List<Label> statLines;

    List<Panel> achTiles;
    List<Progress> achBars;
    Label achSummary;

    Label prGain;
    Label prMult;
    Label prKeep;

    public MineDialogs() {
        statLines = new List<Label>();
        achTiles = new List<Panel>();
        achBars = new List<Progress>();
        this.BuildWelcome();
        this.BuildStats();
        this.BuildAchievements();
        this.BuildPrestige();
    }

    static void Skin(Modal m, string extra) {
        m.modalBox.ClassName = "modal-surface mn-modal" + extra;
        m.okBtn.ClassName = "mn-cta";
        m.cancelBtn.ClassName = "mn-btn";
    }

    static Label Txt(string text, string cls) {
        Label l = new Label(text);
        l.Class = cls;
        return l;
    }

    // ---- 欢迎回来 ---------------------------------------------------------

    void BuildWelcome() {
        welcome = new Modal("⚒ 欢迎回来，矿长！");
        welcome.Width(440);
        Skin(welcome, "");
        Panel body = Panel.Column();
        body.Gap(8);
        body.With(Txt("你不在的时候，矿机一直在挖：", "mn-text"));
        welcomeGold = Txt("+0 金币", "mn-gold mn-center");
        body.With(welcomeGold);
        welcomeTime = Txt("", "mn-dim mn-center");
        welcomeTime.SetWrap(true);
        body.With(welcomeTime);
        welcome.Content(body);
        welcome.OkText("收下金币");
        welcome.okBtn.name = "welcomeOk";
        welcome.Actions(new List<Control> { welcome.okBtn });
    }

    public void SetWelcome(double gold, long elapsed, long capped, double capHours) {
        welcomeGold.Text = "+" + MineFormat.Num(gold) + " 金币";
        string away = "离线 " + OfflineRewardCalculator.FormatDuration(elapsed);
        if (elapsed > capped) {
            away = away + "（矿仓最多存 " + Convert.ToString((int)capHours) + " 小时的产出）";
        }
        welcomeTime.Text = away;
    }

    // ---- 统计 -------------------------------------------------------------

    void BuildStats() {
        stats = new Modal("📊 采矿统计");
        stats.Width(480);
        Skin(stats, "");
        Panel body = Panel.Column();
        body.Gap(7);
        for (int i = 0; i < 9; i = i + 1) {
            Label l = Txt("", "mn-text");
            body.With(l);
            statLines.Add(l);
        }
        statLines[8].Class = "mn-dim";
        statLines[8].SetWrap(true);
        stats.Content(body);
        stats.OkText("关闭");
        stats.Actions(new List<Control> { stats.okBtn });
    }

    public void RefreshStats(MineEconomy e, GameProfile profile, IdleSaveGame save) {
        statLines[0].Text = "当前金币：" + MineFormat.Num(e.Gold) + "　　本轮累计：" + MineFormat.Num(e.RunEarned);
        statLines[1].Text = "当前秒产：+" + MineFormat.Num(e.Dps) + "/秒　　单次开采：+" + MineFormat.Num(e.ClickPower);
        statLines[2].Text = "最高秒产：+" + MineFormat.Num((double)profile.Best("bestGps")) + "/秒";
        statLines[3].Text = "终身开采：" + MineFormat.Num(e.lifetimeEarned) + " 金币";
        statLines[4].Text = "手动开采：" + BigNum.Grouped(e.Clicks) + " 次　　金矿石：" + Convert.ToString(e.goldenClicks) + " 块";
        statLines[5].Text = "地心转生：" + Convert.ToString(e.prestiges) + " 次　　地心晶：" + Convert.ToString(e.crystals) + " 枚";
        statLines[6].Text = "成就：" + Convert.ToString(e.AchievementCount) + " / " + Convert.ToString(MineAchievements.Count)
            + "　　永久加成：全产出 " + MineFormat.Pct(e.PermanentMult);
        statLines[7].Text = "上线次数：" + Convert.ToString(profile.Counter("sessions")) + "　　熔炉超载：" + Convert.ToString(e.overdriveUses) + " 次";
        statLines[8].Text = save.Persistent()
            ? "存档：" + save.Directory() + "（每 20 秒、失焦与退出时自动保存）"
            : "存档：未找到用户数据目录，本次进度不会保存";
    }

    // ---- 成就墙 -----------------------------------------------------------

    void BuildAchievements() {
        achievements = new Modal("🏆 成就");
        achievements.Width(724);
        Skin(achievements, "");
        Panel body = Panel.Column();
        body.Gap(8);
        achSummary = Txt("", "mn-dim");
        body.With(achSummary);
        Panel row = null;
        for (int i = 0; i < MineAchievements.Count; i = i + 1) {
            if (i % 3 == 0) {
                row = Panel.Row();
                row.Gap(8);
                body.With(row);
            }
            Panel tile = Panel.Column();
            tile.Class = "mn-ach";
            tile.With(Txt(MineAchievements.Name(i), "mn-ach-name"));
            tile.With(Txt(MineAchievements.Desc(i), "mn-ach-desc"));
            Progress bar = new Progress(0, 1);
            bar.Class = "mn-ach-bar";
            bar.IsShowText = false;
            tile.With(bar);
            row.With(tile);
            achTiles.Add(tile);
            achBars.Add(bar);
        }
        achievements.Content(body);
        achievements.OkText("关闭");
        achievements.Actions(new List<Control> { achievements.okBtn });
    }

    public void RefreshAchievements(MineEconomy e) {
        int n = e.AchievementCount;
        achSummary.Text = "已解锁 " + Convert.ToString(n) + " / " + Convert.ToString(MineAchievements.Count)
            + "　·　每个成就让全部产出永久 +2%，转生也不会清零（当前 " + MineFormat.Pct(1.0 + 0.02 * (double)n) + "）";
        for (int i = 0; i < MineAchievements.Count; i = i + 1) {
            bool on = e.HasAchievement(i);
            achTiles[i].SwitchClass("mn-ach-on", on);
            achBars[i].SetPercent((int)(e.AchievementProgress(i) * 100.0));
        }
    }

    // ---- 地心转生确认 -----------------------------------------------------

    void BuildPrestige() {
        prestige = new Modal("◆ 地心转生");
        prestige.Width(470);
        Skin(prestige, " mn-modal-crystal");
        prestige.okBtn.ClassName = "mn-prestige";
        prestige.okBtn.name = "prestigeOk";
        Panel body = Panel.Column();
        body.Gap(8);
        body.With(Txt("熔掉整座矿场，把这一轮的矿脉压成地心晶：", "mn-text"));
        prGain = Txt("+0 ◆", "mn-gain");
        body.With(prGain);
        prMult = Txt("", "mn-crystal-big");
        body.With(prMult);
        prKeep = Txt("", "mn-dim");
        prKeep.SetWrap(true);
        body.With(prKeep);
        Label warn = Txt("清空：金币、全部矿机等级、正在生效的增益。", "mn-warn");
        warn.SetWrap(true);
        body.With(warn);
        prestige.Content(body);
        prestige.OkText("◆ 转生");
        prestige.CancelText("再挖一会");
        prestige.Actions(new List<Control> { prestige.cancelBtn, prestige.okBtn });
    }

    public void RefreshPrestige(MineEconomy e) {
        long gain = e.PendingCrystals;
        long after = e.crystals + gain;
        prGain.Text = "+" + Convert.ToString(gain) + " ◆ 地心晶";
        double now = 1.0 + MineEconomy.CrystalBonus * (double)e.crystals;
        double next = 1.0 + MineEconomy.CrystalBonus * (double)after;
        prMult.Text = "地心晶加成：全产出 " + MineFormat.Pct(now) + "  →  " + MineFormat.Pct(next);
        prKeep.Text = "保留：地心晶（共 " + Convert.ToString(after) + " 枚）、成就与统计。"
            + "多挖一会再转生能拿更多：地心晶 = √(本轮累计 ÷ 10M)。";
    }
}
