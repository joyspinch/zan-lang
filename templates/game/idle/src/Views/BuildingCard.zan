using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Game.Idle;

// 一张矿机卡：整张卡就是一个标准 Button（点卡即按当前模式购买），内容是一列卡面——
// 图标 + 名字 + 等级徽章 / 当前秒产 + 价格 / 到下一个里程碑的进度条。
// 买得起时整卡描金发光（mn-card-ok），没勘探到的矿机显示成问号卡（mn-card-locked），
// 刚过里程碑的徽章转亮（mn-badge-hot）。样式全在 MineSkin 里，这里只切语义类。
public class BuildingCard {
    public Button button;
    Label icon;
    Label name;
    Label badge;
    Label rate;
    Label cost;
    Progress ms;
    Label msText;
    int index;
    // 上次刷新的状态（变了才切类，避免每 100ms 重算样式）
    int lastState;
    string lastCost;
    string lastRate;
    int lastLevel;
    int lastPct;
    string lastMs;

    public BuildingCard(int index) {
        this.index = index;
        this.lastState = -1;
        this.lastCost = "";
        this.lastRate = "";
        this.lastLevel = -1;
        this.lastPct = -1;
        this.lastMs = "";

        Panel face = Panel.Column();
        face.Class = "mn-card-body";

        Panel head = Panel.Row();
        head.Class = "mn-card-head";
        icon = new Label(MineCatalog.Icon(index));
        icon.Class = "mn-card-icon";
        head.With(icon);
        name = new Label("");
        name.Class = "mn-card-name";
        head.With(name);
        badge = new Label("Lv 0");
        badge.Class = "mn-badge";
        head.With(badge);
        face.With(head);

        Panel mid = Panel.Row();
        mid.Class = "mn-card-mid";
        rate = new Label("");
        rate.Class = "mn-card-rate";
        mid.With(rate);
        cost = new Label("");
        cost.Class = "mn-card-cost";
        mid.With(cost);
        face.With(mid);

        Panel foot = Panel.Row();
        foot.Class = "mn-card-foot";
        ms = new Progress(0, 1);
        ms.Class = "mn-ms";
        ms.IsShowText = false;
        foot.With(ms);
        msText = new Label("");
        msText.Class = "mn-card-ms";
        foot.With(msText);
        face.With(foot);

        button = new Button(face);
        button.Class = "mn-card";
        button.name = "build" + Convert.ToString(index);
    }

    // 矿机是否已"勘探到"：第一座总是，之后前一座有等级或自己有等级。
    public static bool Revealed(MineEconomy e, int i) {
        if (i == 0) { return true; }
        if (e.Buildings[i].level > 0) { return true; }
        return e.Buildings[i - 1].level > 0;
    }

    public void Refresh(MineEconomy e) {
        IdleBuilding b = e.Buildings[index];
        bool shown = Revealed(e, index);
        bool ok = shown && e.CanBuy(index);
        int state = !shown ? 2 : (ok ? 1 : 0);
        if (state != lastState) {
            lastState = state;
            button.SwitchClass("mn-card-ok", state == 1);
            button.SwitchClass("mn-card-locked", state == 2);
            cost.SwitchClass("mn-card-cost-off", state != 1);
            name.Text = shown ? b.Name : "未勘探矿脉";
            icon.Text = shown ? MineCatalog.Icon(index) : "?";
            button.Tip = shown ? b.Desc + "（点卡购买）" : "先买下上一座矿机，才能勘探到这里";
        }
        if (b.level != lastLevel) {
            lastLevel = b.level;
            badge.Text = "Lv " + Convert.ToString(b.level);
            badge.SwitchClass("mn-badge-zero", b.level == 0);
            badge.SwitchClass("mn-badge-hot", MineEconomy.MilestonesAt(b.level) > 0);
        }

        string r;
        if (!shown) {
            r = "？？？";
        } else if (b.level == 0) {
            r = "每级 +" + MineFormat.Num((double)b.baseDps * e.PermanentMult) + "/秒";
        } else {
            r = "+" + MineFormat.Num(e.BuildingDps(index)) + "/秒";
        }
        if (r != lastRate) { lastRate = r; rate.Text = r; }

        int n = e.BuyCount(index);
        string cs = "◉ " + MineFormat.Num(e.CostFor(index, n));
        if (n > 1) { cs = cs + "  ×" + Convert.ToString(n); }
        if (cs != lastCost) { lastCost = cs; cost.Text = cs; }

        int prev = MineEconomy.PrevMilestone(b.level);
        int next = MineEconomy.NextMilestone(b.level);
        int pct = (b.level - prev) * 100 / (next - prev);
        if (pct != lastPct) { lastPct = pct; ms.SetPercent(pct); }
        string mt = "Lv" + Convert.ToString(next) + " ×2";
        if (mt != lastMs) { lastMs = mt; msText.Text = mt; }
    }
}
