using System;
using Game.Idle;

// 数字的展示文本：三位有效数字 + 千进制后缀（12.3K / 4.56M / 789B），
// 顶栏大数字在百万以下用千分位全写（123,456），读起来更"有分量"。
public class MineFormat {
    // 三位有效数字：999 → "999"，1234 → "1.23K"，45678 → "45.7K"，1.2e9 → "1.20B"。
    public static string Num(double v) {
        if (!(v > 0.0)) { return "0"; }
        if (v < 1000.0) { return Convert.ToString((long)Math.Floor(v)); }
        int tier = 0;
        double s = v;
        while (s >= 1000.0 && tier < 11) {
            s = s / 1000.0;
            tier = tier + 1;
        }
        string body;
        if (s >= 100.0) {
            body = Convert.ToString((long)Math.Floor(s));
        } else if (s >= 10.0) {
            long t = (long)Math.Floor(s * 10.0);
            body = Convert.ToString(t / 10) + "." + Convert.ToString(t % 10);
        } else {
            long t = (long)Math.Floor(s * 100.0);
            long f = t % 100;
            body = Convert.ToString(t / 100) + "." + (f < 10 ? "0" : "") + Convert.ToString(f);
        }
        return body + BigNum.Suffix(tier);
    }

    // 顶栏金币：百万以下千分位全写，以上走三位有效数字。
    public static string Big(double v) {
        if (!(v > 0.0)) { return "0"; }
        if (v < 1000000.0) { return BigNum.Grouped((long)Math.Floor(v)); }
        return Num(v);
    }

    // 秒数 → "1:05" / "12s"。
    public static string Secs(double s) {
        int n = (int)Math.Ceiling(s);
        if (n < 0) { n = 0; }
        if (n < 60) { return Convert.ToString(n) + "s"; }
        int m = n / 60;
        int r = n % 60;
        return Convert.ToString(m) + ":" + (r < 10 ? "0" : "") + Convert.ToString(r);
    }

    // 倍率 → "×2.34" / "+34%"。
    public static string Pct(double mult) {
        long p = (long)Math.Floor((mult - 1.0) * 100.0 + 0.5);
        return "+" + Convert.ToString(p) + "%";
    }
}
