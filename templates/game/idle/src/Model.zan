using System;
using System.Collections.Generic;

namespace IdleGame;

/// <summary>
/// 生产建筑定义与实时状态。
/// </summary>
class Building {
    int id;
    string name;
    string desc;
    int level;
    long baseCost;
    long baseDps;
    double costMult;

    static Building Create(int id, string name, string desc, long baseCost, long baseDps) {
        Building b = new Building();
        b.id = id;
        b.name = name;
        b.desc = desc;
        b.level = 0;
        b.baseCost = baseCost;
        b.baseDps = baseDps;
        b.costMult = 1.15;
        return b;
    }

    int Id { get { return id; } }
    string Name { get { return name; } }
    string Desc { get { return desc; } }
    int Level { get { return level; } }

    long Cost {
        get {
            double c = (double)baseCost * Math.Pow(costMult, (double)level);
            return (long)c;
        }
    }

    long Dps {
        get {
            return baseDps * (long)level;
        }
    }

    void Upgrade() {
        level = level + 1;
    }
}

/// <summary>
/// 游戏数据状态机。
/// </summary>
class GameState {
    double gold;
    double totalEarned;
    long clicks;
    int diamonds;
    List<Building> buildings;

    static GameState CreateDefault() {
        GameState s = new GameState();
        s.gold = 0.0;
        s.totalEarned = 0.0;
        s.clicks = 0;
        s.diamonds = 10;
        s.buildings = new List<Building>();

        s.buildings.Add(Building.Create(0, "机械鹤嘴锄", "强化基础挖掘动力 (+1/s)", 15, 1));
        s.buildings.Add(Building.Create(1, "蒸汽矿井", "自动化深层矿石提取 (+8/s)", 100, 8));
        s.buildings.Add(Building.Create(2, "熔岩钻头", "穿透玄武岩层地心挖掘 (+45/s)", 1100, 45));
        s.buildings.Add(Building.Create(3, "地热精炼厂", "利用地核能源加速提纯 (+260/s)", 12000, 260));
        s.buildings.Add(Building.Create(4, "量子对撞机", "直接合成纯净暗金矿 (+1800/s)", 130000, 1800));
        s.buildings.Add(Building.Create(5, "戴森球采矿站", "恒星级自动化采矿矩阵 (+14000/s)", 1400000, 14000));
        return s;
    }

    double Gold { get { return gold; } }
    double TotalEarned { get { return totalEarned; } }
    long Clicks { get { return clicks; } }
    int Diamonds { get { return diamonds; } }
    List<Building> Buildings { get { return buildings; } }

    long ClickPower {
        get {
            long p = 1;
            // 每一个建筑等级额外提供 1% 点击威力加成
            for (int i = 0; i < buildings.Count; i = i + 1) {
                p = p + (long)(buildings[i].Level * 2);
            }
            return p;
        }
    }

    double TotalDps {
        get {
            double sum = 0.0;
            for (int i = 0; i < buildings.Count; i = i + 1) {
                sum = sum + (double)buildings[i].Dps;
            }
            return sum;
        }
    }

    long Mine() {
        clicks = clicks + 1;
        long gain = ClickPower;
        gold = gold + (double)gain;
        totalEarned = totalEarned + (double)gain;
        return gain;
    }

    void AddGold(double amount) {
        if (amount > 0.0) {
            gold = gold + amount;
            totalEarned = totalEarned + amount;
        }
    }

    bool CanAfford(Building b) {
        return gold >= (double)b.Cost;
    }

    bool UpgradeBuilding(int index) {
        if (index < 0 || index >= buildings.Count) { return false; }
        Building b = buildings[index];
        long cost = b.Cost;
        if (gold >= (double)cost) {
            gold = gold - (double)cost;
            b.Upgrade();
            return true;
        }
        return false;
    }

    void Tick(double dt) {
        double dps = TotalDps;
        if (dps > 0.0 && dt > 0.0) {
            double gain = dps * dt;
            gold = gold + gain;
            totalEarned = totalEarned + gain;
        }
    }
}
