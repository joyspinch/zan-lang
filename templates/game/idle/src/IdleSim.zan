using System;
using Game.Foundation;
using Game.Idle;

// 回放与回归（docs/ZAN_STANDARD.md S26/S27）：放置经济（Game.Idle.IdleState + 本游戏的
// MineCatalog 矿机表）以界面同样的 100ms 一帧无头推进。经济无随机，种子不参与。
// replays/ 下的回放由 `zan-check` 重放、逐校验点比对；Bot 是模糊测试用的机器人。
// 改了矿机价格或产出后回放分叉，就重新录制（见 README）。
//
// 输入编码：0 无操作；1 手动开采一次；10 + i 升级第 i 座矿机（钱不够时无效）。
public class IdleSim : IReplaySim {
    IdleState state;

    public void Reset(long seed) { state = new IdleState(MineCatalog.Create()); }

    public void Step(int frame, int input) {
        if (input == 1) {
            state.Mine();
        } else if (input >= 10 && input < 10 + state.buildings.Count) {
            state.UpgradeBuilding(input - 10);
        }
        state.Tick(0.1);
    }

    public int StateChecksum() {
        StateHasher h = new StateHasher();
        h.Real(state.gold).Real(state.totalEarned).Long(state.clicks);
        for (int i = 0; i < state.buildings.Count; i = i + 1) { h.Int(state.buildings[i].level); }
        return h.Value();
    }

    // 钱不会花成负数
    [Invariant]
    public bool GoldNotNegative() { return state.gold >= 0; }

    // 手里的钱不会多于累计赚到的钱（花钱只减少 gold）
    [Invariant]
    public bool GoldWithinEarned() { return state.gold <= state.totalEarned + 0.001; }

    // 机器人：狂点开采，攒到钱就随机升级一座矿机
    public static int Bot(DeterministicRandom rng, int frame) {
        int roll = rng.NextBelow(100);
        if (roll < 60) { return 1; }
        if (roll < 75) { return 10 + rng.NextBelow(6); }
        return 0;
    }
}
