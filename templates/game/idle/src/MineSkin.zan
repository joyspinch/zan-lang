using System;

// 放置矿工的游戏皮肤："熔岩矿洞"——焦黑岩板 + 熔金 + 余烬橙，转生层用冷色的地心晶青。
//
// 界面全部是标准控件（Panel / Label / Button / Progress / Modal），这里只给语义类上色——
// 不自绘、不重画控件。整张样式表随 exe 内嵌（app.UseCss）；注意 app.UseSkin 会盖掉
// UseCss，所以本游戏不再叠桌面皮肤，未声明的部分落回 Gui 内嵌的 base.css。
//
// 语义类一览（前缀 mn-）：
//   页面    mn-root · mn-header · mn-panel · mn-col · mn-row · mn-fill · mn-mid · mn-spacer
//   文字    mn-logo · mn-logo-sub · mn-cap · mn-gold · mn-rate · mn-h2 · mn-dim · mn-text · mn-status
//   顶栏    mn-stat（金币/秒产块）· mn-crystal-chip · mn-crystal · mn-chip（小按钮）
//   操作    mn-cta（熔金主按钮）· mn-btn（岩板按钮）· mn-boost(-on) · mn-prestige · mn-seg(-on)
//   增益    mn-buff + mn-buff-od / mn-buff-rush
//   矿机卡  mn-card(-ok/-locked) · mn-card-* · mn-badge(-zero/-hot) · mn-ms
//   转生    mn-depth（进度条）· mn-gain · mn-crystal-big
//   成就    mn-ach(-on) · mn-ach-name · mn-ach-desc · mn-ach-bar
//   弹窗    mn-modal（Modal 的面板）
public class MineSkin {
    public static string Css() {
        return MineSkin.PageCss() + MineSkin.TextCss() + MineSkin.ButtonCss()
            + MineSkin.CardCss() + MineSkin.MetaCss() + MineSkin.ModalCss();
    }

    // 页面底与面板：焦黑岩板 + 暖色描边，顶栏像一块嵌着熔金的铸铁铭牌。
    static string PageCss() {
        return "window{background:#0c0705}"
            + "stack.mn-root{flex-grow:1;background:linear-gradient(to bottom,#1d120c,#090504)}"
            + "stack.mn-fill{flex-grow:1}"
            + "stack.mn-spacer{flex-grow:1}"
            + "stack.mn-mid{align-items:center}"
            + "stack.mn-panel{background:linear-gradient(to bottom,#28180f,#130b07);"
            + "border:1 #5c3a22;border-radius:14;box-shadow:0 6 18 rgba(0,0,0,0.6)}"
            + "stack.mn-header{background:linear-gradient(to bottom,#341f12,#170d08);"
            + "border:1 #8a5a2c;border-radius:14;box-shadow:0 4 16 rgba(0,0,0,0.65);align-items:center}"
            + "stack.mn-stat{align-items:flex-start;gap:0}"
            + "stack.mn-crystal-chip{align-items:center;gap:6;height:40;padding-left:14;padding-right:14;"
            + "border-radius:20;background:linear-gradient(to bottom,#123a3a,#0a2020);border:1 #3fb3a8;"
            + "box-shadow:0 0 12 rgba(80,220,200,0.28)}"
            + "stack.mn-buffs{align-items:center;gap:6;height:30}"
            + "minecore{background:transparent}";
    }

    // 字体层级：大数字熔金发光，正文羊皮纸色，说明文字暗金褐。
    static string TextCss() {
        return "label.mn-logo{font-size:22;font-weight:700;color:#ffcf6e;text-shadow:0 2 10 rgba(255,110,20,0.6)}"
            + "label.mn-logo-sub{font-size:11;color:#c07a3a;letter-spacing:3}"
            + "label.mn-cap{font-size:11;color:#a88466;letter-spacing:2}"
            + "label.mn-gold{font-size:30;font-weight:700;color:#ffd34d;text-shadow:0 0 14 rgba(255,150,30,0.7)}"
            + "label.mn-rate{font-size:19;font-weight:700;color:#ffad5c;text-shadow:0 0 8 rgba(255,110,20,0.45)}"
            + "label.mn-click{font-size:13;color:#e8c9a0}"
            + "label.mn-h2{font-size:17;font-weight:700;color:#f2c063}"
            + "label.mn-text{font-size:14;color:#eedcc0}"
            + "label.mn-dim{font-size:12;color:#a88a6c}"
            + "label.mn-center{text-align:center}"
            + "label.mn-status{font-size:13;color:#e9cfa6;background:#120a06;border:1 #4a2e1a;border-radius:8;"
            + "padding-left:10;padding-right:10;padding-top:6;padding-bottom:6}"
            + "label.mn-status-hot{color:#2a1206;background:linear-gradient(to bottom,#ffd77a,#e0861e);border-color:#fff0c0}"
            + "label.mn-crystal{font-size:16;font-weight:700;color:#8ff2e6}"
            + "label.mn-crystal-sub{font-size:11;color:#5fc4b8}"
            + "label.mn-buff{height:26;padding-left:10;padding-right:10;border-radius:13;font-size:12;font-weight:700;"
            + "vertical-align:middle;color:#2a1206}"
            + "label.mn-buff-od{background:linear-gradient(to bottom,#ff8a4a,#c4220a);color:#fff0e0;border:1 #ffb080;"
            + "box-shadow:0 0 10 rgba(255,70,20,0.6)}"
            + "label.mn-buff-rush{background:linear-gradient(to bottom,#ffe680,#d49a10);border:1 #fff6c0;"
            + "box-shadow:0 0 10 rgba(255,210,60,0.6)}"
            + "label.mn-buff-idle{background:#1a100a;color:#8a6c50;border:1 #3a2616;font-weight:400}";
    }

    // 按钮：熔金主按钮、岩板按钮、顶栏小钮、超载钮、转生钮、分段开关；五态齐全。
    static string ButtonCss() {
        return "button.mn-cta,button.mn-btn,button.mn-chip,button.mn-boost,button.mn-prestige,button.mn-seg"
            + "{height:40;padding-left:18;padding-right:18;font-size:15;border-radius:10;-zan-sheen:0}"
            + "button.mn-btn label.button-caption,button.mn-chip label.button-caption,button.mn-seg label.button-caption"
            + "{color:#f1e4cc;background:transparent}"
            + "button.mn-cta label.button-caption{color:#2a1206;font-weight:700;background:transparent}"
            + "button.mn-boost label.button-caption{color:#fff0e0;font-weight:700;background:transparent}"
            + "button.mn-prestige label.button-caption{color:#062a28;font-weight:700;background:transparent}"
            + "button.mn-cta:disabled label.button-caption,button.mn-boost:disabled label.button-caption,"
            + "button.mn-prestige:disabled label.button-caption,button.mn-btn:disabled label.button-caption{color:#8a7864}"
            // 岩板按钮 / 小钮
            + "button.mn-btn,button.mn-chip{background:linear-gradient(to bottom,#3b2618,#221410);"
            + "border:1 #7a5232;box-shadow:0 2 6 rgba(0,0,0,0.5)}"
            + "button.mn-btn:hover,button.mn-chip:hover{background:linear-gradient(to bottom,#4e321e,#2e1b12);"
            + "border-color:#e0a04a;box-shadow:0 0 10 rgba(255,150,50,0.35)}"
            + "button.mn-btn:active,button.mn-chip:active{background:#170d09;border-color:#ff8a3d;box-shadow:none}"
            + "button.mn-btn:focus,button.mn-chip:focus{border-color:#ffcf6e;box-shadow:0 0 8 rgba(255,170,60,0.6)}"
            + "button.mn-btn:disabled,button.mn-chip:disabled{background:#1a110c;border-color:#3a281c;box-shadow:none}"
            + "button.mn-chip{height:34;padding-left:12;padding-right:12;font-size:13;border-radius:17}"
            // 熔金主按钮
            + "button.mn-cta{font-size:17;background:linear-gradient(to bottom,#ffd06a,#de6a1a);border:1 #ffe4a6;"
            + "box-shadow:0 0 16 rgba(255,130,30,0.5)}"
            + "button.mn-cta:hover{background:linear-gradient(to bottom,#ffe292,#f08428);border-color:#fff3cf;"
            + "box-shadow:0 0 24 rgba(255,160,50,0.75)}"
            + "button.mn-cta:active{background:linear-gradient(to bottom,#d88a2e,#a84a16);border-color:#ffcf6e;"
            + "box-shadow:none;transform:scale(0.97)}"
            + "button.mn-cta:focus{border:2 #fff6dc;box-shadow:0 0 18 rgba(255,220,140,0.8)}"
            + "button.mn-cta:disabled{background:#2a1d15;border-color:#4a3a2c;box-shadow:none}"
            // 熔炉超载：就绪 = 赤红脉冲，开着 = 白热，冷却 = 禁用灰岩
            + "button.mn-boost{background:linear-gradient(to bottom,#e2502a,#8a1a08);border:1 #ff9a70;"
            + "box-shadow:0 0 14 rgba(255,70,20,0.5)}"
            + "button.mn-boost:hover{background:linear-gradient(to bottom,#ff6a3a,#a8240c);border-color:#ffc0a0;"
            + "box-shadow:0 0 22 rgba(255,90,30,0.75)}"
            + "button.mn-boost:active{background:#6a1406;box-shadow:none}"
            + "button.mn-boost:focus{border:2 #ffd0b8}"
            + "button.mn-boost-on{background:linear-gradient(to bottom,#fff0c0,#ff8a2a);border:2 #ffffff;"
            + "box-shadow:0 0 26 rgba(255,170,60,0.9)}"
            + "button.mn-boost-on label.button-caption{color:#4a1400}"
            + "button.mn-boost:disabled,button.mn-boost-off{background:#22150e;border-color:#4a3020;box-shadow:none}"
            + "button.mn-boost-off:hover{background:#2c1b12;border-color:#7a4a2a}"
            + "button.mn-boost-off label.button-caption{color:#a08068}"
            // 地心转生：冷色晶石
            + "button.mn-prestige{background:linear-gradient(to bottom,#8ff2e6,#2a9a90);border:1 #d0fff8;"
            + "box-shadow:0 0 16 rgba(80,230,210,0.55)}"
            + "button.mn-prestige:hover{background:linear-gradient(to bottom,#b0fff4,#38b4a8);"
            + "box-shadow:0 0 24 rgba(120,255,230,0.8)}"
            + "button.mn-prestige:active{background:#1f7a72;box-shadow:none}"
            + "button.mn-prestige:focus{border:2 #ffffff}"
            + "button.mn-prestige{padding-left:10;padding-right:10}"
            + "button.mn-prestige:disabled,button.mn-prestige-off{background:#0f2422;border-color:#24504c;box-shadow:none}"
            + "button.mn-prestige-off:hover{background:#143230;border-color:#3a7a72}"
            + "button.mn-prestige-off label.button-caption{color:#5a9a92}"
            // 分段开关（×1 / ×10 / 最大）
            + "button.mn-seg{height:30;padding-left:12;padding-right:12;font-size:13;border-radius:8;"
            + "background:#1a100a;border:1 #4a2e1a}"
            + "button.mn-seg:hover{background:#2e1c12;border-color:#c07a3a}"
            + "button.mn-seg:active{background:#120a06}"
            + "button.mn-seg:focus{border-color:#ffcf6e}"
            + "button.mn-seg-on{background:linear-gradient(to bottom,#ffcc5c,#d8701e);border-color:#ffe2a0;"
            + "box-shadow:0 0 10 rgba(255,140,40,0.5)}"
            + "button.mn-seg-on label.button-caption{color:#2a1206;font-weight:700}"
            + "button.mn-seg-on:hover{background:linear-gradient(to bottom,#ffd87a,#e8802a)}";
    }

    // 矿机卡：整张卡是一个 Button。买得起 = 熔金描边 + 发光；未勘探 = 暗淡问号卡。
    static string CardCss() {
        return "button.mn-card{flex-grow:1;flex-basis:0;height:92;padding:0;flex-direction:column;align-items:stretch;"
            + "justify-content:flex-start;gap:0;border-radius:12;-zan-sheen:0;"
            + "background:linear-gradient(to bottom,#2c1a10,#160d08);border:1 #5a3a22;"
            + "box-shadow:0 4 10 rgba(0,0,0,0.55)}"
            + "button.mn-card:hover{border-color:#d08a40;background:linear-gradient(to bottom,#3a2416,#1c110a);"
            + "box-shadow:0 0 14 rgba(255,150,50,0.4)}"
            + "button.mn-card:active{transform:scale(0.98);background:#140b07;box-shadow:none}"
            + "button.mn-card:focus{border-color:#ffcf6e}"
            + "button.mn-card-ok{border:2 #ffb347;background:linear-gradient(to bottom,#45280f,#1e1008);"
            + "box-shadow:0 0 16 rgba(255,150,40,0.55)}"
            + "button.mn-card-ok:hover{border-color:#ffe08a;box-shadow:0 0 24 rgba(255,190,80,0.8)}"
            + "button.mn-card-locked{opacity:0.55;border:1 #3a2616;background:#110a06;box-shadow:none}"
            + "stack.mn-card-body{padding-left:12;padding-right:12;padding-top:9;padding-bottom:9;gap:5;align-items:stretch}"
            + "stack.mn-card-head{align-items:center;gap:8}"
            + "stack.mn-card-mid{align-items:center;gap:6}"
            + "stack.mn-card-foot{align-items:center;gap:8}"
            + "label.mn-card-icon{width:26;height:26;border-radius:7;font-size:15;text-align:center;vertical-align:middle;"
            + "color:#ffd27a;background:linear-gradient(to bottom,#4a2c16,#24140b);border:1 #7a5232}"
            + "button.mn-card-ok label.mn-card-icon{background:linear-gradient(to bottom,#ffcc5c,#d0701e);color:#2a1206;"
            + "border-color:#ffe2a0}"
            + "label.mn-card-name{flex-grow:1;font-size:15;font-weight:700;color:#f5e2c0}"
            + "label.mn-badge{height:22;padding-left:9;padding-right:9;border-radius:11;font-size:12;font-weight:700;"
            + "vertical-align:middle;color:#ffe9c0;background:#3a2414;border:1 #8a5a2c}"
            + "label.mn-badge-zero{color:#8a6c50;background:#1a100a;border-color:#3a2616}"
            + "label.mn-badge-hot{color:#2a1206;background:linear-gradient(to bottom,#ffd77a,#e0861e);border-color:#fff0c0;"
            + "box-shadow:0 0 8 rgba(255,160,50,0.6)}"
            + "label.mn-card-rate{flex-grow:1;font-size:13;color:#ffad5c}"
            + "label.mn-card-cost{font-size:14;font-weight:700;color:#ffd34d}"
            + "label.mn-card-cost-off{color:#8a6c50}"
            + "label.mn-card-ms{font-size:11;color:#a88a6c;min-width:62;text-align:right}"
            + "progress.mn-ms{flex-grow:1}"
            + ".mn-ms .progress-track{height:6;border-radius:3;background:#0e0805;border:1 #3a2616}"
            + ".mn-ms .progress-fill{height:6;border-radius:3;background:linear-gradient(to right,#c4561a,#ffcc5c)}";
    }

    // 转生 / 成就 / 统计行。
    static string MetaCss() {
        return "progress.mn-depth{flex-grow:1}"
            + ".mn-depth .progress-track{height:12;border-radius:6;background:#081514;border:1 #24504c}"
            + ".mn-depth .progress-fill{height:12;border-radius:6;background:linear-gradient(to right,#1f8a80,#8ff2e6)}"
            + "label.mn-gain{font-size:34;font-weight:700;color:#8ff2e6;text-align:center;"
            + "text-shadow:0 0 14 rgba(80,230,210,0.7)}"
            + "label.mn-crystal-big{font-size:15;color:#d8fff8;text-align:center}"
            + "label.mn-warn{font-size:13;color:#ff9a7a}"
            + "stack.mn-ach{width:216;height:58;padding-left:10;padding-right:10;padding-top:7;padding-bottom:7;gap:3;"
            + "border-radius:10;background:#140c08;border:1 #3a2616}"
            + "stack.mn-ach-on{background:linear-gradient(to bottom,#3e2812,#1e1208);border:1 #e0a04a;"
            + "box-shadow:0 0 10 rgba(255,160,50,0.3)}"
            + "label.mn-ach-name{font-size:14;font-weight:700;color:#7a6450}"
            + "stack.mn-ach-on label.mn-ach-name{color:#ffd27a}"
            + "label.mn-ach-desc{font-size:11;color:#7a6450}"
            + "stack.mn-ach-on label.mn-ach-desc{color:#e0c49a}"
            + "progress.mn-ach-bar{width:100%}"
            + ".mn-ach-bar .progress-track{height:4;border-radius:2;background:#0a0604}"
            + ".mn-ach-bar .progress-fill{height:4;border-radius:2;background:#c07a3a}";
    }

    // 弹窗：同一块岩板材质，标题熔金，遮罩压暗。
    static string ModalCss() {
        return "modal::mask{background:rgba(6,3,2,0.72)}"
            + "card.mn-modal{background:linear-gradient(to bottom,#2e1c12,#140b07);border:2 #a86a30;border-radius:16;"
            + "box-shadow:0 0 40 rgba(255,120,30,0.3)}"
            + "card.mn-modal-crystal{border-color:#3fb3a8;box-shadow:0 0 40 rgba(80,230,210,0.3)}"
            + ".mn-modal label.card-title{font-size:20;font-weight:700;color:#ffcf6e}"
            + ".mn-modal-crystal label.card-title{color:#8ff2e6}"
            + ".mn-modal button.modal-close{color:#c09a70}"
            + ".mn-modal button.modal-close:hover{background:#3a2414;color:#ffe0b0}";
    }
}
