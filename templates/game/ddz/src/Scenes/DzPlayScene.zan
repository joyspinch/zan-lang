using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class DzPlayScene : HtmlScene {
    DdzGame g;

    DzPlayScene(DdzGame g) { this.g = g; }

    override void OnEnter(Control root) {
        this.g.StartRound(Window.GetTickMs());
    }

    override void Event(int kind, int key) {
        GuiHost host = this.router.Host();
        // 指针坐标经 host.MouseX/Y 反变换回舞台逻辑坐标（桌面视口
        // letterbox / 手机驱动反变换都在宿主之下完成）。
        if (kind == 1) {
            this.g.mouseX = host.MouseX();
            this.g.mouseY = host.MouseY();
        } else if (kind == 2 && key == 0) {
            this.g.mouseX = host.MouseX();
            this.g.mouseY = host.MouseY();
            this.g.OnDown(this.g.mouseX, this.g.mouseY, Window.GetTickMs());
        } else if (kind == 4) {
            if (key == 27) { this.router.Go("menu"); }
            else if (key == 13) { this.g.TryPlaySelected(Window.GetTickMs()); }
            else if (key == 32) { this.g.TryPass(Window.GetTickMs()); }
            else if (key == 67) { this.g.ClearSelection(Window.GetTickMs()); }
        }
    }

    override void FixedStep(int dtMs) {
        this.g.Tick(Window.GetTickMs());
        // 一局分出胜负（Finish 置 scene=3）后切结算；切换在帧首应用，
        // 本场景随即使停。
        if (this.g.scene == 3) { this.router.Go("over"); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.DrawTable(Window.GetTickMs());
    }
}

// 结算：HTML 面板叠在定格的牌桌上——Render 继续画 DrawTableBase（牌局
// 已停，画面定格），body 半透明压暗，按钮/文案由 HTML 层承担。
