using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class DzOverScene : HtmlScene {
    DdzGame g;

    DzOverScene(DdzGame g) { this.g = g; }

    override string HtmlFile() { return "assets/scenes/over.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("again", () => this.router.Go("play"));
        handlers.Add("menu", () => this.router.Go("menu"));
    }

    override void OnEnter(Control root) {
        Element headline = DzOverScene.AsElement(root, "headline");
        Element subEl = DzOverScene.AsElement(root, "sub");
        Element cheerEl = DzOverScene.AsElement(root, "cheer");
        string head; string cheer;
        if (this.g.winner == 1) {
            head = "胜利！赢 " + this.g.deltaBeans + " 豆";
            cheer = "手气正旺，再来一局！";
            if (this.g.prof.streak >= 3) { cheer = this.g.prof.streak + " 连胜！豆子滚滚来"; }
        } else {
            head = "惜败，输 " + this.g.deltaBeans + " 豆";
            cheer = "记牌回想一下，翻盘就在下局";
        }
        if (headline != null) { headline.SetText(head); }
        if (subEl != null) { subEl.SetText("豆 " + this.g.prof.beans + " · 倍数 x" + this.g.mult); }
        if (cheerEl != null) { cheerEl.SetText(cheer); }
    }

    static Element AsElement(Control root, string id) {
        Control c = root.Find(id);
        if (c != null && c is Element) { return (Element)c; }
        return null;
    }

    override void Event(int kind, int key) {
        if (kind != 4) { return; }
        if (key == 27) { this.router.Go("menu"); }
        if (key == 13 || key == 32) { this.router.Go("play"); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.DrawTableBase(Window.GetTickMs());
    }
}
