// 游戏循环帧同步与渲染调度契约
// 系统底层交互与数据流转契约
// 核心契约与语义定义。
// 游戏实体调度与交互逻辑。
// 核心契约与语义定义。
// SceneRouter+HtmlScene 版：菜单/对局/结算三个场景由 SceneRouter 路由，
// 菜单与结算的按钮/文案走 HTML 层（assets/scenes/*.html），牌桌与手牌
// 走 Game.Kit.CanvasPrims 直绘，不依赖 SDL。
using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

namespace Ddz;

class DdzProfile {
    int beans;
    int wins;
    int losses;
    int streak;
    int bestStreak;
    bool loaded;

    static string Path() { return "ddz_profile.txt"; }
    static int ParseInt(string s, int start) {
        int i = start; int v = 0; bool any = false;
        while (i < s.Length) { int c = s[i] & 255; if (c >= 48 && c <= 57) { v = v * 10 + (c - 48); any = true; i = i + 1; } else { i = s.Length; } }
        if (!any) { return 0; }
        return v;
    }
    static int ReadKey(List<string> lines, string key, int fb) {
        for (int i = 0; i < lines.Count; i = i + 1) {
            string ln = lines[i]; int eq = -1;
            for (int j = 0; j < ln.Length; j = j + 1) { if (ln[j] == 61) { eq = j; j = ln.Length; } }
            if (eq > 0) { if (ln.Substring(0, eq) == key) { return DdzProfile.ParseInt(ln, eq + 1); } }
        }
        return fb;
    }
    static DdzProfile Load() {
        DdzProfile p = new DdzProfile();
        p.beans = 200;
        if (!File.Exists(DdzProfile.Path())) { return p; }
        List<string> lines = File.ReadAllLines(DdzProfile.Path());
        p.beans = DdzProfile.ReadKey(lines, "beans", 200);
        p.wins = DdzProfile.ReadKey(lines, "wins", 0);
        p.losses = DdzProfile.ReadKey(lines, "losses", 0);
        p.streak = DdzProfile.ReadKey(lines, "streak", 0);
        p.bestStreak = DdzProfile.ReadKey(lines, "bestStreak", 0);
        return p;
    }
    void Save() {
        string s = "beans=" + this.beans + "\nwins=" + this.wins
            + "\nlosses=" + this.losses + "\nstreak=" + this.streak
            + "\nbestStreak=" + this.bestStreak + "\n";
        File.WriteAllText(DdzProfile.Path(), s);
    }
    string Title() {
        if (this.beans >= 3000) { return "地主王"; }
        if (this.beans >= 1500) { return "庄园主"; }
        if (this.beans >= 800) { return "掌柜"; }
        if (this.beans >= 400) { return "佃户"; }
        return "长工";
    }
}

class DdzPopup {
    int x; int y; string text; int bornAt; int cr; int cg; int cb;
}
class DdzParticle {
    int x; int y; int vx; int vy; int bornAt; int cr; int cg; int cb;
}
class PlayerCard {
    int card;
    bool selected;
}

// 斗地主牌型枚举：单张/对子/顺子/连对/三带/炸弹/火箭。
// 核心契约与语义定义。
class Combo {
    int type;
    int key;  // dominant value
    int len;  // straight length / pair-straight pairs
    List<int> cards;
    static Combo None() { Combo c = new Combo(); c.type = 0; c.cards = new List<int>(); return c; }
}

class DdzGame {
    Canvas c;
    DdzProfile prof;
    Rng rng;

    // 牌面编码：点数*4 + 花色。
    List<PlayerCard> hand0;  // player (bottom)
    List<int> hand1;  // right AI
    List<int> hand2;  // left AI
    List<int> bottom;  // 3 landlord cards
    int scene;  // 0 menu, 1 bidding, 2 play, 3 over
    int landlord;  // 0/1/2
    int bid;  // 1..3
    int bidTurn;
    int bidBest;
    int bidBestWho;
    int bidCount;
    int turn;  // whose move
    int lastWho;  // who owns the current table combo (-1 free lead)
    Combo table;  // combo to beat
    Combo shown0; Combo shown1; Combo shown2;  // last played per seat (for display)
    bool passed1; bool passed2; bool passed0;
    int mult;  // bombs double
    int winner;  // 1 you win beans, 2 you lose
    int deltaBeans;
    int aiActAt;
    int mouseX;
    int mouseY;
    int toastAt;
    string toastText;
    List<DdzPopup> pops;
    List<DdzParticle> parts;
    string menuBg;  // asset paths (null = 画布回退画法)
    string titlePath;
    string tablePath;
    string cardBackPath;
    string avatarLPath;
    string avatarRPath;
    string avatarMePath;
    string cardFacePath;
    string pipSpade;
    string pipHeart;
    string pipDiamond;
    string pipClub;
    string jokerSmall;
    string jokerBig;
    string menuBg2;  // 新美术（旧资产名一律不动，新文件名优先，缺则回退旧图/画布）
    string title2Path;
    string tablePath2;
    string panel2;
    string cardFace2;
    string cardBack2;
    string joker2;
    string avatarMe2;
    string avatarL2;
    string avatarR2;
    bool texTried;
    bool demo;
    int demoAt;
    int diff;  // 0 easy, 1 normal, 2 hard
    int deadline;  // player turn countdown (ms timestamp)

    // 视口按宿主舞台每帧延展（宽窗多看宽度）：VW/VH 是当前帧的舞台
    // 逻辑尺寸，帧首在 SyncStage 更新——布局锚定它即可满铺任意窗口，
    // 否则长轴超出的部分就是宿主 margin 底色的空条。
    static int VW() { return vw > 0 ? vw : 1280; }
    static int VH() { return vh > 0 ? vh : 720; }
    // 竖屏（舞台高>宽：手机竖屏或竖长窗口）：手牌/座位/按钮全部以
    // VW/VH 居中换算；横屏维持原 1280×720 布局锚点。
    static bool Portrait() { return DdzGame.VW() < DdzGame.VH(); }
    static int CX() { return DdzGame.VW() / 2; }
    // 对局动作/叫分按钮的行 y 与 x 起点（绘制与 OnDown 共用）。
    // 竖屏整组抬到手牌上方（按钮/状态条不再压住手牌，牌面完整可点）；
    // 横屏动作行维持原位，叫分行从牌面里挪到牌上方。
    static int ActY() { return DdzGame.Portrait() ? DdzGame.VH() - 368 : DdzGame.VH() - 240; }
    static int HandY() { return DdzGame.VH() - 200; }
    static int BidY() { return DdzGame.Portrait() ? DdzGame.VH() - 368 : DdzGame.VH() - 280; }

    // 帧首对齐宿主延展舞台（GuiHost.Render 回调开头调用）。
    void SyncStage(GuiHost host) {
        DdzGame.vw = host.StageWidth();
        DdzGame.vh = host.StageHeight();
    }
    static int vw;
    static int vh;

    static DdzGame Create(GuiHost h) {
        DdzGame g = new DdzGame();
        g.prof = DdzProfile.Load();
        g.rng = Rng.Seed((long)Window.GetTickMs() + 97531246);
        g.scene = 1;
        g.mouseX = DdzGame.CX();
        g.mouseY = 360;
        g.pops = new List<DdzPopup>();
        g.parts = new List<DdzParticle>();
        g.toastAt = -9999;
        g.table = Combo.None();
        g.diff = 1;
        g.demo = File.Exists("ddz_demo.txt");
        return g;
    }

    void EnsureTex() {
        if (this.texTried) { return; }
        this.texTried = true;
        this.menuBg = DdzGame.FindAsset("assets/menu_bg.png");
        this.titlePath = DdzGame.FindAsset("assets/title.png");
        this.tablePath = DdzGame.FindAsset("assets/table_bg.png");
        this.cardBackPath = DdzGame.FindAsset("assets/card_back.png");
        this.avatarLPath = DdzGame.FindAsset("assets/avatar_left.png");
        this.avatarRPath = DdzGame.FindAsset("assets/avatar_right.png");
        this.avatarMePath = DdzGame.FindAsset("assets/avatar_me.png");
        this.cardFacePath = DdzGame.FindAsset("assets/card_face.png");
        this.pipSpade = DdzGame.FindAsset("assets/pip_spade.png");
        this.pipHeart = DdzGame.FindAsset("assets/pip_heart.png");
        this.pipDiamond = DdzGame.FindAsset("assets/pip_diamond.png");
        this.pipClub = DdzGame.FindAsset("assets/pip_club.png");
        this.jokerSmall = DdzGame.FindAsset("assets/joker_small.png");
        this.jokerBig = DdzGame.FindAsset("assets/joker_big.png");
        this.menuBg2 = DdzGame.FindAsset("assets/menu_bg2.png");
        this.title2Path = DdzGame.FindAsset("assets/title2.png");
        this.tablePath2 = DdzGame.FindAsset("assets/table_bg2.png");
        this.panel2 = DdzGame.FindAsset("assets/panel2.png");
        this.cardFace2 = DdzGame.FindAsset("assets/card_face2.png");
        this.cardBack2 = DdzGame.FindAsset("assets/card_back2.png");
        this.joker2 = DdzGame.FindAsset("assets/joker2.png");
        this.avatarMe2 = DdzGame.FindAsset("assets/avatar_me2.png");
        this.avatarL2 = DdzGame.FindAsset("assets/avatar_l2.png");
        this.avatarR2 = DdzGame.FindAsset("assets/avatar_r2.png");
    }
    static string FindAsset(string path) {
        string p = Assets.Find(path);
        if (!File.Exists(p)) { return null; }
        return p;
    }

    // 全出血 cover：居中裁剪贴满舞台（长短边都铺满，不留 letterbox 条）。
    static void BlitCover(Canvas c, string path, int dw, int dh) {
        int iw = Canvas.ImageWidth(path);
        int ih = Canvas.ImageHeight(path);
        if (iw <= 0 || ih <= 0) { return; }
        int sw = iw;
        int sh = sw * dh / dw;
        if (sh > ih) { sh = ih; sw = sh * dw / dh; }
        string src = CDraw.BlitSource(c, path);
        if (src == null) { return; }
        c.BlitImage(src, CDraw.MapX(CDraw.originX), CDraw.MapY(CDraw.originY),
                    CDraw.MapW(dw), CDraw.MapW(dh),
                    (iw - sw) / 2, (ih - sh) / 2, sw, sh);
    }

    void Toast(string t, int now) { this.toastText = t; this.toastAt = now; }
    void AddPop(int px, int py, string t, int now, int cr, int cg, int cb) {
        if (this.pops.Count > 12) { this.pops.RemoveAt(0); }
        DdzPopup p = new DdzPopup();
        p.x = px; p.y = py; p.text = t; p.bornAt = now;
        p.cr = cr; p.cg = cg; p.cb = cb;
        this.pops.Add(p);
    }
    void Burst(int px, int py, int n, int now, int cr, int cg, int cb) {
        if (this.parts.Count > 200) { return; }
        for (int i = 0; i < n; i = i + 1) {
            DdzParticle p = new DdzParticle();
            p.x = px * 256; p.y = py * 256;
            int a = this.rng.Range(0, 16);
            int spd = 60 + this.rng.Range(0, 170);
            int ux = 0; int uy = 0;
            int q = a % 4;
            if (q == 0) { ux = 256; uy = (a / 4 - 2) * 128; }
            if (q == 1) { ux = -256; uy = (a / 4 - 2) * 128; }
            if (q == 2) { uy = 256; ux = (a / 4 - 2) * 128; }
            if (q == 3) { uy = -256; ux = (a / 4 - 2) * 128; }
            p.vx = ux * spd / 256;
            p.vy = uy * spd / 256;
            p.bornAt = now;
            p.cr = cr; p.cg = cg; p.cb = cb;
            this.parts.Add(p);
        }
    }

    // ----- deal ------------------------------------------------------------

    static int Val(int card) { return card / 4; }

    void SortHand(List<int> h) {
        int i = 1;
        while (i < h.Count) {
            int c = h[i];
            int j = i - 1;
            while (j >= 0 && h[j] > c) { h[j + 1] = h[j]; j = j - 1; }
            h[j + 1] = c;
            i = i + 1;
        }
    }

    void SortPlayerHand() {
        int i = 1;
        while (i < this.hand0.Count) {
            PlayerCard c = this.hand0[i];
            int j = i - 1;
            while (j >= 0 && this.hand0[j].card > c.card) { this.hand0[j + 1] = this.hand0[j]; j = j - 1; }
            this.hand0[j + 1] = c;
            i = i + 1;
        }
    }

    List<int> PlayerCards() {
        List<int> cards = new List<int>();
        for (int i = 0; i < this.hand0.Count; i = i + 1) { cards.Add(this.hand0[i].card); }
        return cards;
    }

    void ClearPlayerSelection() {
        for (int i = 0; i < this.hand0.Count; i = i + 1) { this.hand0[i].selected = false; }
    }

    void RemovePlayerCards(List<int> cards) {
        for (int i = 0; i < cards.Count; i = i + 1) {
            for (int j = 0; j < this.hand0.Count; j = j + 1) {
                if (this.hand0[j].card == cards[i]) { this.hand0.RemoveAt(j); j = this.hand0.Count; }
            }
        }
    }

    void StartRound(int now) {
        List<int> deck = new List<int>();
        int v = 3;
        while (v <= 15) {
            for (int s = 0; s < 4; s = s + 1) { deck.Add(v * 4 + s); }
            v = v + 1;
        }
        deck.Add(64);  // small joker (16*4)
        deck.Add(68);  // big joker (17*4)
        int i = deck.Count - 1;
        while (i > 0) {
            int j = this.rng.Range(0, i + 1);
            int t = deck[i]; deck[i] = deck[j]; deck[j] = t;
            i = i - 1;
        }
        this.hand0 = new List<PlayerCard>();
        this.hand1 = new List<int>();
        this.hand2 = new List<int>();
        this.bottom = new List<int>();
        i = 0;
        while (i < 51) {
            if (i % 3 == 0) { PlayerCard pc = new PlayerCard(); pc.card = deck[i]; this.hand0.Add(pc); }
            if (i % 3 == 1) { this.hand1.Add(deck[i]); }
            if (i % 3 == 2) { this.hand2.Add(deck[i]); }
            i = i + 1;
        }
        this.bottom.Add(deck[51]); this.bottom.Add(deck[52]); this.bottom.Add(deck[53]);
        this.SortPlayerHand();
        this.SortHand(this.hand1);
        this.SortHand(this.hand2);
        this.scene = 1;
        this.bid = 0;
        this.bidBest = 0;
        this.bidBestWho = -1;
        this.bidCount = 0;
        this.bidTurn = this.rng.Range(0, 3);
        this.mult = 1;
        this.winner = 0;
        this.table = Combo.None();
        this.shown0 = Combo.None(); this.shown1 = Combo.None(); this.shown2 = Combo.None();
        this.lastWho = -1;
        this.pops = new List<DdzPopup>();
        this.parts = new List<DdzParticle>();
        this.Toast("叫分开始，谁是地主？", now);
        this.aiActAt = now + 700;
        if (this.demo) { this.demoAt = now + 400; }
    }

    // ----- bidding ---------------------------------------------------------

    int HandStrength(List<int> h) {
        int s = 0;
        int[] cnt = new int[18];
        for (int i = 0; i < h.Count; i = i + 1) {
            int v = DdzGame.Val(h[i]);
            cnt[v] = cnt[v] + 1;
            if (v == 15) { s = s + 6; }
            if (v == 14) { s = s + 3; }
            if (v == 16) { s = s + 8; }
            if (v == 17) { s = s + 10; }
        }
        int v2 = 3;
        while (v2 <= 15) {
            if (cnt[v2] == 4) { s = s + 14; }
            if (cnt[v2] == 3) { s = s + 4; }
            v2 = v2 + 1;
        }
        if (cnt[16] > 0 && cnt[17] > 0) { s = s + 10; }
        return s;
    }

    void AiBid(int now) {
        List<int> h = this.hand1;
        if (this.bidTurn == 2) { h = this.hand2; }
        int s = this.HandStrength(h);
        int want = 0;
        if (s >= 34) { want = 3; }
        else if (s >= 26) { want = 2; }
        else if (s >= 18) { want = 1; }
        if (want <= this.bidBest) { want = 0; }
        this.ApplyBid(this.bidTurn, want, now);
    }

    void ApplyBid(int who, int score, int now) {
        string name = "你";
        if (who == 1) { name = "右家"; }
        if (who == 2) { name = "左家"; }
        if (score > 0) {
            this.Toast(name + " 叫 " + score + " 分", now);
            this.bidBest = score;
            this.bidBestWho = who;
        } else {
            this.Toast(name + " 不叫", now);
        }
        this.bidCount = this.bidCount + 1;
        if (this.bidBest == 3 || this.bidCount >= 3) {
            if (this.bidBestWho < 0) {
                this.Toast("无人叫地主，重新发牌", now);
                this.StartRound(now);
                return;
            }
            this.BecomeLandlord(this.bidBestWho, now);
            return;
        }
        this.bidTurn = (this.bidTurn + 1) % 3;
        this.aiActAt = now + 700;
    }

    void BecomeLandlord(int who, int now) {
        this.landlord = who;
        this.bid = this.bidBest;
        int i = 0;
        if (who == 0) {
            while (i < 3) { PlayerCard pc = new PlayerCard(); pc.card = this.bottom[i]; this.hand0.Add(pc); i = i + 1; }
            this.SortPlayerHand();
        } else {
            List<int> h = this.hand1;
            if (who == 2) { h = this.hand2; }
            while (i < 3) { h.Add(this.bottom[i]); i = i + 1; }
            this.SortHand(h);
        }
        this.scene = 2;
        this.turn = who;
        this.deadline = now + 25000;
        this.lastWho = -1;
        this.table = Combo.None();
        string name = "你";
        if (who == 1) { name = "右家"; }
        if (who == 2) { name = "左家"; }
        this.Toast(name + " 成为地主，亮底牌！", now);
        this.aiActAt = now + 900;
        if (this.demo) { this.demoAt = now + 600; }
    }

    // 核心契约与执行状态转移规范。

    static Combo Classify(List<int> cards) {
        Combo no = Combo.None();
        int n = cards.Count;
        if (n == 0) { return no; }
        int[] cnt = new int[18];
        for (int i = 0; i < n; i = i + 1) { int v = DdzGame.Val(cards[i]); cnt[v] = cnt[v] + 1; }
        Combo c = new Combo();
        c.cards = cards;
        if (n == 1) { c.type = 1; c.key = DdzGame.Val(cards[0]); return c; }
        if (n == 2) {
            if (cnt[16] == 1 && cnt[17] == 1) { c.type = 9; c.key = 17; return c; }
            if (cnt[DdzGame.Val(cards[0])] == 2) { c.type = 2; c.key = DdzGame.Val(cards[0]); return c; }
            return no;
        }
        // 核心契约与执行状态转移规范。
        int trip = -1; int quad = -1; int pairV = -1; int single = -1;
        int distinct = 0;
        int v2 = 3;
        while (v2 <= 17) {
            if (cnt[v2] > 0) { distinct = distinct + 1; }
            if (cnt[v2] == 4) { quad = v2; }
            if (cnt[v2] == 3) { trip = v2; }
            if (cnt[v2] == 2) { pairV = v2; }
            if (cnt[v2] == 1) { single = v2; }
            v2 = v2 + 1;
        }
        if (n == 3) { if (trip >= 0) { c.type = 3; c.key = trip; return c; } return no; }
        if (n == 4) {
            if (quad >= 0) { c.type = 8; c.key = quad; return c; }
            if (trip >= 0) { c.type = 4; c.key = trip; return c; }
            return no;
        }
        if (n == 5 && trip >= 0 && pairV >= 0) { c.type = 5; c.key = trip; return c; }
        // 顺子牌型判定。
        if (n >= 5 && distinct == n) {
            int lo = 0; int hi = 0;
            v2 = 3;
            while (v2 <= 14) {
                if (cnt[v2] > 0) { if (lo == 0) { lo = v2; } hi = v2; }
                if (cnt[v2] > 1 || (v2 > 14 && cnt[v2] > 0)) { return no; }
                v2 = v2 + 1;
            }
            if (cnt[15] > 0 || cnt[16] > 0 || cnt[17] > 0) { return no; }
            if (hi - lo + 1 == n) { c.type = 6; c.key = hi; c.len = n; return c; }
            return no;
        }
        // 连对牌型判定。
        if (n >= 6 && n % 2 == 0) {
            int lo = 0; int hi = 0; bool ok = true;
            v2 = 3;
            while (v2 <= 17) {
                if (cnt[v2] > 0) {
                    if (cnt[v2] != 2 || v2 > 14) { ok = false; }
                    if (lo == 0) { lo = v2; }
                    hi = v2;
                }
                v2 = v2 + 1;
            }
            if (ok && (hi - lo + 1) * 2 == n) { c.type = 7; c.key = hi; c.len = n / 2; return c; }
        }
        return no;
    }

    static bool Beats(Combo a, Combo b) {
        // 牌型大小与压牌规则比对。
        if (a.type == 0) { return false; }
        if (b.type == 0) { return true; }
        if (a.type == 9) { return true; }
        if (b.type == 9) { return false; }
        if (a.type == 8 && b.type != 8) { return true; }
        if (b.type == 8 && a.type != 8) { return false; }
        if (a.type != b.type) { return false; }
        if ((a.type == 6 || a.type == 7) && a.len != b.len) { return false; }
        return a.key > b.key;
    }

    // 核心契约与执行状态转移规范。

    // 从手牌检索所有可出牌型候选项。
    List<Combo> Candidates(List<int> h, Combo tbl) {
        List<Combo> res = new List<Combo>();
        int[] cnt = new int[18];
        for (int i = 0; i < h.Count; i = i + 1) { cnt[DdzGame.Val(h[i])] = cnt[DdzGame.Val(h[i])] + 1; }
        // 提取指定张数的同点数手牌组合。
        int v = 3;
        while (v <= 17) {
            if (cnt[v] >= 1) { this.AddCand(res, h, v, 1, tbl); }
            if (cnt[v] >= 2) { this.AddCand(res, h, v, 2, tbl); }
            if (cnt[v] >= 3) { this.AddCand(res, h, v, 3, tbl); this.AddTripKick(res, h, v, cnt, tbl); }
            if (cnt[v] >= 4) { this.AddCand(res, h, v, 4, tbl); }
            v = v + 1;
        }
        // rocket
        if (cnt[16] > 0 && cnt[17] > 0) {
            List<int> cs = new List<int>();
            cs.Add(64); cs.Add(68);
            Combo c = DdzGame.Classify(cs);
            if (DdzGame.Beats(c, tbl)) { res.Add(c); }
        }
        // straights
        int len = 5;
        while (len <= 12) {
            int lo = 3;
            while (lo + len - 1 <= 14) {
                bool ok = true;
                int k = 0;
                for (; k < len; k = k + 1) { if (cnt[lo + k] < 1) { ok = false; k = len; } }
                if (ok) {
                    List<int> cs = new List<int>();
                    k = 0;
                    while (k < len) { cs.Add(this.PickCard(h, lo + k, cs)); k = k + 1; }
                    Combo c = DdzGame.Classify(cs);
                    if (c.type == 6 && DdzGame.Beats(c, tbl)) { res.Add(c); }
                }
                lo = lo + 1;
            }
            len = len + 1;
        }
        // 核心契约与执行状态转移规范。
        len = 3;
        while (len <= 8) {
            int lo = 3;
            while (lo + len - 1 <= 14) {
                bool ok = true;
                int k = 0;
                for (; k < len; k = k + 1) { if (cnt[lo + k] < 2) { ok = false; k = len; } }
                if (ok) {
                    List<int> cs = new List<int>();
                    k = 0;
                    while (k < len) {
                        cs.Add(this.PickCard(h, lo + k, cs));
                        cs.Add(this.PickCard(h, lo + k, cs));
                        k = k + 1;
                    }
                    Combo c = DdzGame.Classify(cs);
                    if (c.type == 7 && DdzGame.Beats(c, tbl)) { res.Add(c); }
                }
                lo = lo + 1;
            }
            len = len + 1;
        }
        return res;
    }

    int PickCard(List<int> h, int v, List<int> used) {
        for (int i = 0; i < h.Count; i = i + 1) {
            int card = h[i];
            if (DdzGame.Val(card) == v) {
                bool taken = false;
                for (int j = 0; j < used.Count; j = j + 1) { if (used[j] == card) { taken = true; j = used.Count; } }
                if (!taken) { return card; }
            }
        }
        return -1;
    }

    void AddCand(List<Combo> res, List<int> h, int v, int k, Combo tbl) {
        List<int> cs = new List<int>();
        for (int i = 0; i < k; i = i + 1) { cs.Add(this.PickCard(h, v, cs)); }
        Combo c = DdzGame.Classify(cs);
        if (c.type != 0 && DdzGame.Beats(c, tbl)) { res.Add(c); }
    }

    void AddTripKick(List<Combo> res, List<int> h, int v, int[] cnt, Combo tbl) {
        // 组装三带一与三带二候选项。
        int kick = 3;
        while (kick <= 17) {
            if (kick != v && cnt[kick] >= 1) {
                List<int> cs = new List<int>();
                for (int i = 0; i < 3; i = i + 1) { cs.Add(this.PickCard(h, v, cs)); }
                cs.Add(this.PickCard(h, kick, cs));
                Combo c = DdzGame.Classify(cs);
                if (c.type == 4 && DdzGame.Beats(c, tbl)) { res.Add(c); kick = 18; }
            }
            kick = kick + 1;
        }
        kick = 3;
        while (kick <= 15) {
            if (kick != v && cnt[kick] >= 2) {
                List<int> cs = new List<int>();
                for (int i = 0; i < 3; i = i + 1) { cs.Add(this.PickCard(h, v, cs)); }
                cs.Add(this.PickCard(h, kick, cs));
                cs.Add(this.PickCard(h, kick, cs));
                Combo c = DdzGame.Classify(cs);
                if (c.type == 5 && DdzGame.Beats(c, tbl)) { res.Add(c); kick = 18; }
            }
            kick = kick + 1;
        }
    }

    Combo AiChoose(int who, int now) {
        List<int> h = this.hand1;
        if (who == 2) { h = this.hand2; }
        bool leading = this.lastWho < 0 || this.lastWho == who;
        Combo tbl = this.table;
        if (leading) { tbl = Combo.None(); }
        List<Combo> cands = this.Candidates(h, tbl);
        if (cands.Count == 0) { return Combo.None(); }
        // 初级 AI：保守跟牌策略。
        if (this.diff == 0) {
            if (!leading && this.rng.Range(0, 10) < 4) { return Combo.None(); }
            Combo pick = null;
            int ws = 1000000;
            for (int wi = 0; wi < cands.Count; wi = wi + 1) {
                Combo c = cands[wi];
                int s = c.key * 10 + c.cards.Count;
                if (c.type >= 8) { s = s + 5000; }
                if (s < ws) { ws = s; pick = c; }
            }
            if (!leading && pick != null && pick.type >= 8 && this.rng.Range(0, 10) < 8) { return Combo.None(); }
            return pick;
        }
        // 友方队友大牌不压牌策略。
        if (!leading && this.lastWho != who) {
            bool partner = (who != this.landlord) && (this.lastWho != this.landlord) && (this.lastWho != 0 || this.landlord == 0);
            bool lastIsPartner = (who != this.landlord) && (this.lastWho != this.landlord);
            if (lastIsPartner && this.table.key >= 12 && this.table.type <= 2) { return Combo.None(); }
        }
        // 贪心策略：出最小符合条件的有效手牌。
        Combo best = null;
        int bestScore = -1000000;
        for (int i = 0; i < cands.Count; i = i + 1) {
            Combo c = cands[i];
            int s = 0;
            s = s - c.key * 6;
            s = s + c.cards.Count * 30;  // shed more cards
            if (c.type == 8) { s = s - 400; }  // hold bombs
            if (c.type == 9) { s = s - 600; }
            if (c.key >= 15) { s = s - 90; }  // hold 2s / jokers
            if (h.Count <= 6) { s = s + c.cards.Count * 60; }
            if (this.diff == 2) {
                // 高级 AI：优先走大长牌与压制。
                s = s + c.cards.Count * 25;
                if (h.Count <= 9) { s = s + c.cards.Count * 50; }
            }
            if (s > bestScore) { bestScore = s; best = c; }
        }
        // 节约炸弹判定。
        if (!leading && best != null && (best.type == 8 || best.type == 9)) {
            int oppMin = this.hand0.Count;
            if (this.landlord != 0) {
                // 农民优先阻击地主。
                int hold = 8;
                if (this.diff == 2) { hold = 5; }
                if (this.lastWho != this.landlord && this.rng.Range(0, 10) < hold) { return Combo.None(); }
            }
            if (this.diff == 2 && this.landlord == 0 && this.hand0.Count <= 5) {
                // 终局阻截地主冲刺出牌。
            } else if (this.diff == 2 && !leading && this.table.cards.Count < 2 && this.table.key < 14) {
                return Combo.None();
            }
        }
        return best;
    }

    // 核心契约与执行状态转移规范。

    void RemoveCards(List<int> h, List<int> cs) {
        for (int i = 0; i < cs.Count; i = i + 1) {
            for (int j = 0; j < h.Count; j = j + 1) {
                if (h[j] == cs[i]) { h.RemoveAt(j); j = h.Count; }
            }
        }
    }

    void PlayCombo(int who, Combo c, int now) {
        int cardsLeft = 0;
        if (who == 0) {
            this.RemovePlayerCards(c.cards);
            cardsLeft = this.hand0.Count;
        } else {
            List<int> h = this.hand1;
            if (who == 2) { h = this.hand2; }
            this.RemoveCards(h, c.cards);
            cardsLeft = h.Count;
        }
        this.table = c;
        this.lastWho = who;
        if (who == 0) { this.shown0 = c; }
        if (who == 1) { this.shown1 = c; }
        if (who == 2) { this.shown2 = c; }
        if (c.type == 8) {
            this.mult = this.mult * 2;
            this.Toast("炸弹！倍数 x" + this.mult, now);
            this.Burst(DdzGame.CX(), 330, 46, now, 255, 150, 60);
        }
        if (c.type == 9) {
            this.mult = this.mult * 2;
            this.Toast("王炸！！倍数 x" + this.mult, now);
            this.Burst(DdzGame.CX(), 330, 60, now, 255, 90, 90);
        }
        if (cardsLeft == 2) {
            string name = "你只剩";
            if (who == 1) { name = "右家只剩"; }
            if (who == 2) { name = "左家只剩"; }
            this.Toast(name + " 2 张牌！", now);
        }
        if (cardsLeft == 1) {
            string name = "你只剩";
            if (who == 1) { name = "右家只剩"; }
            if (who == 2) { name = "左家只剩"; }
            this.Toast(name + " 1 张牌！！", now);
        }
        if (cardsLeft == 0) { this.Finish(who, now); return; }
        this.NextTurn(now);
    }

    void PassTurn(int who, int now) {
        if (who == 0) { this.shown0 = Combo.None(); }
        if (who == 1) { this.shown1 = Combo.None(); }
        if (who == 2) { this.shown2 = Combo.None(); }
        this.NextTurn(now);
    }

    void NextTurn(int now) {
        this.turn = (this.turn + 1) % 3;
        if (this.turn == this.lastWho) {
            // 全部过牌，重置主动出牌权。
            this.table = Combo.None();
        }
        this.aiActAt = now + 650 + this.rng.Range(0, 500);
        this.deadline = now + 25000;
        if (this.demo) { this.demoAt = now + 420; }
    }

    void Finish(int who, int now) {
        bool youWin = false;
        if (this.landlord == 0) { youWin = (who == 0); }
        else { youWin = (who != this.landlord); }
        int pot = this.bid * 10 * this.mult;
        if (this.landlord == 0) { pot = pot * 2; }  // landlord stakes double
        this.deltaBeans = pot;
        if (youWin) {
            this.prof.beans = this.prof.beans + pot;
            this.prof.wins = this.prof.wins + 1;
            this.prof.streak = this.prof.streak + 1;
            if (this.prof.streak > this.prof.bestStreak) { this.prof.bestStreak = this.prof.streak; }
            this.winner = 1;
            this.Burst(DdzGame.CX(), 300, 70, now, 255, 210, 100);
        } else {
            this.prof.beans = this.prof.beans - pot;
            if (this.prof.beans < 0) { this.prof.beans = 0; }
            this.prof.losses = this.prof.losses + 1;
            this.prof.streak = 0;
            this.winner = 2;
        }
        this.prof.Save();
        this.scene = 3;
    }

    // 核心契约与执行状态转移规范。

    List<int> Selected() {
        List<int> cs = new List<int>();
        for (int i = 0; i < this.hand0.Count; i = i + 1) {
            if (this.hand0[i].selected) { cs.Add(this.hand0[i].card); }
        }
        return cs;
    }

    void TryPlaySelected(int now) {
        if (this.turn != 0 || this.scene != 2) { return; }
        List<int> cs = this.Selected();
        if (cs.Count == 0) { this.Toast("先选牌再出", now); return; }
        Combo c = DdzGame.Classify(cs);
        if (c.type == 0) { this.Toast("不是合法牌型", now); return; }
        bool leading = this.lastWho < 0 || this.lastWho == 0;
        if (!leading && !DdzGame.Beats(c, this.table)) { this.Toast("压不过上家", now); return; }
        this.PlayCombo(0, c, now);
    }

    void TryPass(int now) {
        if (this.turn != 0 || this.scene != 2) { return; }
        bool leading = this.lastWho < 0 || this.lastWho == 0;
        if (leading) { this.Toast("你先出，不能不出", now); return; }
        this.ClearPlayerSelection();
        this.PassTurn(0, now);
    }

    bool AnySelected() {
        for (int i = 0; i < this.hand0.Count; i = i + 1) {
            if (this.hand0[i].selected) { return true; }
        }
        return false;
    }

    void ClearSelection(int now) {
        if (this.turn != 0 || this.scene != 2) { return; }
        if (!this.AnySelected()) { this.Toast("没有选中的牌", now); return; }
        this.ClearPlayerSelection();
    }

    // 手牌扇形弧度与坐标排版。
    int HandX(int i, int count) {
        int cw = 96;
        int gap = 52;
        if (count > 14) { gap = 46; }
        int total = (count - 1) * gap + cw;
        if (total > DdzGame.VW() - 40) { gap = (DdzGame.VW() - 40 - cw) / (count - 1); total = (count - 1) * gap + cw; }
        return DdzGame.CX() - total / 2 + i * gap;
    }

    // 牌桌画布点击：叫分按钮（scene 1）与出牌/不出/取消 + 手牌选牌
    // （scene 2）。菜单/结算按钮走 HTML 场景层，不经过这里。
    void OnDown(int cx, int cy, int now) {
        if (this.scene == 1) {
            if (this.bidTurn == 0) {
                int ay = DdzGame.BidY();
                int bx0 = DdzGame.CX() - (4 * 116 + 3 * 20) / 2;
                if (CDraw.PointIn(cx, cy, bx0, ay, 116, 56)) { this.ApplyBid(0, 0, now); return; }
                if (CDraw.PointIn(cx, cy, bx0 + 136, ay, 116, 56) && this.bidBest < 1) { this.ApplyBid(0, 1, now); return; }
                if (CDraw.PointIn(cx, cy, bx0 + 272, ay, 116, 56) && this.bidBest < 2) { this.ApplyBid(0, 2, now); return; }
                if (CDraw.PointIn(cx, cy, bx0 + 408, ay, 116, 56)) { this.ApplyBid(0, 3, now); return; }
            }
            return;
        }
        // scene 2
        if (this.turn == 0) {
            int ay = DdzGame.ActY();
            if (CDraw.PointIn(cx, cy, DdzGame.CX() - 215, ay, 130, 54)) { this.TryPlaySelected(now); return; }
            if (CDraw.PointIn(cx, cy, DdzGame.CX() - 65, ay, 130, 54)) { this.TryPass(now); return; }
            if (CDraw.PointIn(cx, cy, DdzGame.CX() + 85, ay, 130, 54)) { this.ClearSelection(now); return; }
        }
        // 手牌点击选取命中测试（顶层优先）。
        int n = this.hand0.Count;
        int i = n - 1;
        while (i >= 0) {
            int x = this.HandX(i, n);
            int y = DdzGame.HandY();
            if (this.hand0[i].selected) { y = y - 36; }
            int w = 96;
            if (i < n - 1) { w = this.HandX(i + 1, n) - x; }
            if (CDraw.PointIn(cx, cy, x, y, w, 130)) {
                this.hand0[i].selected = !this.hand0[i].selected;
                return;
            }
            i = i - 1;
        }
    }

    void Tick(int now) {
        if (this.scene == 1 && this.bidTurn != 0 && now >= this.aiActAt) {
            this.AiBid(now);
            return;
        }
        if (this.scene == 1 && this.bidTurn == 0 && this.demo && now >= this.demoAt) {
            int want = 0;
            int s = this.HandStrength(this.PlayerCards());
            if (s >= 18) { want = 3; }
            this.ApplyBid(0, want, now);
            return;
        }
        if (this.scene == 2 && this.turn != 0 && now >= this.aiActAt) {
            Combo c = this.AiChoose(this.turn, now);
            bool leading = this.lastWho < 0 || this.lastWho == this.turn;
            if (c == null || c.type == 0) {
                if (leading) {
                    // 必出牌时默认出最小单牌。
                    List<int> h = this.hand1;
                    if (this.turn == 2) { h = this.hand2; }
                    List<int> cs = new List<int>();
                    cs.Add(h[0]);
                    this.PlayCombo(this.turn, DdzGame.Classify(cs), now);
                } else {
                    string name = "右家";
                    if (this.turn == 2) { name = "左家"; }
                    this.Toast(name + " 不出", now);
                    this.PassTurn(this.turn, now);
                }
            } else {
                this.PlayCombo(this.turn, c, now);
            }
            return;
        }
        if (this.scene == 2 && this.turn == 0 && !this.demo && now >= this.deadline) {
            // 倒计时超时自动托管出牌。
            bool leading = this.lastWho < 0 || this.lastWho == 0;
            this.ClearPlayerSelection();
            if (leading) {
                List<int> cs = new List<int>();
                cs.Add(this.hand0[0].card);
                this.Toast("超时，自动出最小单张", now);
                this.PlayCombo(0, DdzGame.Classify(cs), now);
            } else {
                this.Toast("超时，自动不出", now);
                this.PassTurn(0, now);
            }
            return;
        }
        if (this.scene == 2 && this.turn == 0 && this.demo && now >= this.demoAt) {
            bool leading = this.lastWho < 0 || this.lastWho == 0;
            Combo tbl = this.table;
            if (leading) { tbl = Combo.None(); }
            List<Combo> cands = this.Candidates(this.PlayerCards(), tbl);
            if (cands.Count == 0) {
                if (leading) { return; }
                this.PassTurn(0, now);
            } else {
                Combo best = cands[0];
                int bs = -1000000;
                for (int i = 0; i < cands.Count; i = i + 1) {
                    Combo c = cands[i];
                    int s = 0 - c.key * 6 + c.cards.Count * 30;
                    if (c.type >= 8) { s = s - 500; }
                    if (s > bs) { bs = s; best = c; }
                }
                this.PlayCombo(0, best, now);
            }
        }
    }

    // ----- rendering ---------------------------------------------------------

    static string RankName(int v) {
        if (v == 11) { return "J"; }
        if (v == 12) { return "Q"; }
        if (v == 13) { return "K"; }
        if (v == 14) { return "A"; }
        if (v == 15) { return "2"; }
        if (v == 16) { return "王"; }
        if (v == 17) { return "王"; }
        return "" + v;
    }

    string PipTex(int suit) {
        if (suit == 0) { return this.pipSpade; }
        if (suit == 1) { return this.pipHeart; }
        if (suit == 2) { return this.pipDiamond; }
        return this.pipClub;
    }

    void DrawCard(int x, int y, int card, bool raised) {
        int v = DdzGame.Val(card);
        int suit = card % 4;
        CDraw.RoundRectFill(this.c, x + 3, y + 5, 96, 130, 10, 20, 12, 8, 110);
        if (this.cardFace2 != null) {
            CDraw.BlitImage(this.c, this.cardFace2, x, y, 96, 130);
        } else if (this.cardFacePath != null) {
            CDraw.BlitImage(this.c, this.cardFacePath, x, y, 96, 130);
        } else {
            CDraw.RoundRectFill(this.c, x, y, 96, 130, 10, 250, 246, 238, 255);
            CDraw.RingRect(this.c, x, y, 96, 130, 2, 205, 194, 176, 255);
        }
        if (raised) { CDraw.RingRect(this.c, x, y, 96, 130, 2, 255, 190, 80, 255); }
        int cr = 40; int cg = 40; int cb = 48;
        if (v == 16) { cr = 90; cg = 90; cb = 110; }
        else if (v == 17) { cr = 200; cg = 60; cb = 44; }
        else if (suit == 1 || suit == 2) { cr = 200; cg = 60; cb = 44; }
        if (v >= 16) {
            string jk = this.joker2;
            if (jk == null) { jk = this.jokerSmall; }
            if (v == 17 && this.jokerBig != null) { jk = this.jokerBig; }
            CText.Draw(this.c, "王", x + 10, y + 8, 3, cr, cg, cb, 255);
            if (v == 16) { CText.Draw(this.c, "小", x + 12, y + 52, 2, 90, 90, 110, 255); }
            if (v == 17) { CText.Draw(this.c, "大", x + 12, y + 52, 2, 200, 60, 44, 255); }
            if (jk != null) { CDraw.BlitImage(this.c, jk, x + 36, y + 32, 54, 86); }
            return;
        }
        CText.Draw(this.c, DdzGame.RankName(v), x + 10, y + 8, 3, cr, cg, cb, 255);
        string pip = this.PipTex(suit);
        if (pip != null) {
            CDraw.BlitImage(this.c, pip, x + 12, y + 46, 22, 22);
            CDraw.BlitImage(this.c, pip, x + 40, y + 70, 46, 46);
            return;
        }
        // 核心契约与执行状态转移规范。
        int px = x + 22; int py = y + 66;
        if (suit == 0) {
            CDraw.FillCircle(this.c, px - 5, py, 6, cr, cg, cb, 255);
            CDraw.FillCircle(this.c, px + 5, py, 6, cr, cg, cb, 255);
            CDraw.FillCircle(this.c, px, py - 7, 7, cr, cg, cb, 255);
            CDraw.FillRect(this.c, px - 2, py, 4, 12, CDraw.Argb(255, cr, cg, cb));
        } else if (suit == 1) {
            CDraw.FillCircle(this.c, px - 5, py - 3, 6, cr, cg, cb, 255);
            CDraw.FillCircle(this.c, px + 5, py - 3, 6, cr, cg, cb, 255);
            CDraw.FillCircle(this.c, px, py + 6, 7, cr, cg, cb, 255);
        } else if (suit == 2) {
            CDraw.FillCircle(this.c, px, py - 7, 6, cr, cg, cb, 255);
            CDraw.FillCircle(this.c, px - 6, py + 2, 6, cr, cg, cb, 255);
            CDraw.FillCircle(this.c, px + 6, py + 2, 6, cr, cg, cb, 255);
            CDraw.FillRect(this.c, px - 2, py + 2, 4, 10, CDraw.Argb(255, cr, cg, cb));
        } else {
            CDraw.FillCircle(this.c, px, py - 5, 6, cr, cg, cb, 255);
            CDraw.FillCircle(this.c, px, py + 5, 6, cr, cg, cb, 255);
            CDraw.FillCircle(this.c, px - 5, py, 6, cr, cg, cb, 255);
            CDraw.FillCircle(this.c, px + 5, py, 6, cr, cg, cb, 255);
        }
    }

    void DrawCardBack(int x, int y) {
        CDraw.RoundRectFill(this.c, x + 2, y + 4, 76, 104, 9, 20, 12, 8, 110);
        if (this.cardBack2 != null) {
            CDraw.BlitImage(this.c, this.cardBack2, x, y, 76, 104);
            return;
        }
        if (this.cardBackPath != null) {
            CDraw.BlitImage(this.c, this.cardBackPath, x, y, 76, 104);
            return;
        }
        CDraw.RoundRectFill(this.c, x, y, 76, 104, 9, 70, 40, 100, 255);
        CDraw.RingRect(this.c, x, y, 76, 104, 2, 140, 100, 190, 255);
        CDraw.FillCircle(this.c, x + 38, y + 52, 22, 110, 70, 160, 255);
        CDraw.FillCircle(this.c, x + 38, y + 52, 12, 160, 110, 220, 255);
    }

    void DrawShown(Combo c, int cx, int cy) {
        if (c == null || c.type == 0) { return; }
        int n = c.cards.Count;
        int gap = 34;
        int total = (n - 1) * gap + 96;
        int x = cx - total / 2;
        for (int i = 0; i < n; i = i + 1) {
            this.DrawCard(x + i * gap, cy, c.cards[i], false);
        }
    }

    void DrawSeat(int who, int x, int y, int count) {
        string name = "右家";
        string face = this.avatarR2;
        if (face == null) { face = this.avatarRPath; }
        if (who == 2) {
            name = "左家";
            face = this.avatarL2;
            if (face == null) { face = this.avatarLPath; }
        }
        CDraw.RoundRectFill(this.c, x, y, 190, 96, 12, 40, 28, 16, 210);
        CDraw.RingRect(this.c, x, y, 190, 96, 2, 214, 178, 120, 90);
        int tx = x + 18;
        if (face != null) {
            CDraw.RoundRectFill(this.c, x + 10, y + 12, 72, 72, 10, 26, 18, 10, 255);
            CDraw.BlitImage(this.c, face, x + 12, y + 14, 68, 68);
            CDraw.RingRect(this.c, x + 10, y + 12, 72, 72, 2, 214, 178, 120, 150);
            tx = x + 94;
        }
        CText.Draw(this.c, name, tx, y + 14, 2, 240, 224, 195, 255);
        if (this.scene >= 2 && this.landlord == who) {
            CText.Draw(this.c, "地主", tx, y + 40, 2, 255, 200, 90, 255);
        }
        CText.Draw(this.c, "余 " + count + " 张", tx, y + 64, 2, 200, 190, 170, 255);
    }

    // 桌面底图：新美术全出血 cover → 旧图拉伸 → menu backdrop → 纯色。
    void DrawTableBg() {
        if (this.tablePath2 != null) {
            DdzGame.BlitCover(this.c, this.tablePath2, DdzGame.VW(), DdzGame.VH());
            CDraw.FillRect(this.c, 0, 0, DdzGame.VW(), DdzGame.VH(), CDraw.Argb(60, 14, 10, 6));
        } else if (this.tablePath != null) {
            CDraw.BlitImage(this.c, this.tablePath, 0, 0, DdzGame.VW(), DdzGame.VH());
            CDraw.FillRect(this.c, 0, 0, DdzGame.VW(), DdzGame.VH(), CDraw.Argb(60, 14, 10, 6));
        } else if (this.menuBg != null) {
            CKitUi.Backdrop(this.c, this.menuBg, DdzGame.VW(), DdzGame.VH());
            CDraw.FillRect(this.c, 0, 0, DdzGame.VW(), DdzGame.VH(), CDraw.Argb(170, 18, 12, 8));
        }
    }

    void DrawTable(int now) {
        this.EnsureTex();
        CDraw.Clear(this.c, DdzGame.VW(), DdzGame.VH(), CDraw.Argb(255, 26, 18, 12));
        this.DrawTableBg();
        CDraw.FillCircle(this.c, DdzGame.CX(), DdzGame.VH() / 3, 460, 255, 190, 110, 12);
        // seats（竖屏：左右家沿顶/侧边收纳；横屏保持原位）
        if (DdzGame.Portrait()) {
            this.DrawSeat(2, 16, 60, this.hand2.Count);
            this.DrawSeat(1, DdzGame.VW() - 206, 60, this.hand1.Count);
        } else {
            this.DrawSeat(2, 30, 60, this.hand2.Count);
            this.DrawSeat(1, 1060, 60, this.hand1.Count);
        }
        // 核心契约与执行状态转移规范。
        int i = 0;
        int show1 = this.hand1.Count;
        if (show1 > 6) { show1 = 6; }
        int backsX = DdzGame.Portrait() ? DdzGame.VW() - 150 : 1120;
        for (; i < show1; i = i + 1) { this.DrawCardBack(backsX, 170 + i * 34); }
        i = 0;
        int show2 = this.hand2.Count;
        if (show2 > 6) { show2 = 6; }
        int backsX2 = DdzGame.Portrait() ? 60 : 84;
        while (i < show2) { this.DrawCardBack(backsX2, 170 + i * 34); i = i + 1; }
        // 叫牌结束展示底牌。
        if (this.scene >= 2) {
            i = 0;
            while (i < 3) {
                this.DrawCard(DdzGame.CX() - 96 + i * 68, 24, this.bottom[i], false);
                i = i + 1;
            }
        }
        // 核心契约与执行状态转移规范。
        this.DrawShown(this.shown2, DdzGame.CX() - 240, 240);
        this.DrawShown(this.shown1, DdzGame.CX() + 240, 240);
        this.DrawShown(this.shown0, DdzGame.CX(), 360);
        // 核心契约与执行状态转移规范。
        if (this.scene >= 1) {
            int n = this.hand0.Count;
            i = 0;
            while (i < n) {
                int x = this.HandX(i, n);
                int y = DdzGame.HandY();
                if (this.scene == 2 && this.hand0[i].selected) { y = y - 36; }
                this.DrawCard(x, y, this.hand0[i].card, this.scene == 2 && this.hand0[i].selected);
                i = i + 1;
            }
            string faceMe = this.avatarMe2;
            if (faceMe == null) { faceMe = this.avatarMePath; }
            if (faceMe != null) {
                CDraw.RoundRectFill(this.c, 20, DdzGame.ActY() - 4, 72, 72, 10, 26, 18, 10, 255);
                CDraw.BlitImage(this.c, faceMe, 22, DdzGame.ActY() - 2, 68, 68);
                CDraw.RingRect(this.c, 20, DdzGame.ActY() - 4, 72, 72, 2, 214, 178, 120, 150);
            }
            if (this.scene >= 2 && this.landlord == 0) {
                CText.Draw(this.c, "地主 · 你", 100, DdzGame.ActY() + 22, 2, 255, 200, 90, 255);
            }
        }
        // status strip（横屏原位；竖屏贴手牌上方居中）
        int ssY = DdzGame.Portrait() ? DdzGame.ActY() + 58 : 662;
        CDraw.RoundRectFill(this.c, 20, ssY, DdzGame.VW() - 40, 46, 10, 30, 22, 14, 190);
        CText.Draw(this.c, this.prof.Title() + " · 豆 " + this.prof.beans
            + " · 连胜 " + this.prof.streak
            + " · 倍数 x" + this.mult + " · 底分 " + this.bid, 40, ssY + 10, 2, 230, 214, 185, 255);
        // 核心契约与执行状态转移规范。
        if (this.scene == 2 && this.turn == 0) {
            int ay = DdzGame.ActY();
            CFx.GoldButton(this.c, this.mouseX, this.mouseY, DdzGame.CX() - 215, ay, 130, 54, "出牌", 2, 1);
            CFx.GoldButton(this.c, this.mouseX, this.mouseY, DdzGame.CX() - 65, ay, 130, 54, "不出", 2, 0);
            CFx.GoldButton(this.c, this.mouseX, this.mouseY, DdzGame.CX() + 85, ay, 130, 54, "取消", 2, 0);
            if (!this.demo) {
                int left = (this.deadline - now + 999) / 1000;
                if (left < 0) { left = 0; }
                int tr = 255; int tg = 214; int tb = 150;
                if (left <= 5) { tg = 110; tb = 90; }
                CText.DrawCenteredShadow(this.c, "倒计时 " + left + " 秒", DdzGame.CX(), ay - 30, 2, tr, tg, tb, 255);
            }
        }
        if (this.scene == 2 && this.turn != 0) {
            string nm = "右家思考中…";
            if (this.turn == 2) { nm = "左家思考中…"; }
            CText.DrawCenteredShadow(this.c, nm, DdzGame.CX(), DdzGame.ActY() - 16, 2, 255, 214, 150, 255);
        }
        if (this.scene == 1) {
            CText.DrawCenteredShadow(this.c, "叫分：谁当地主？", DdzGame.CX(), DdzGame.BidY() - 70, 3, 255, 218, 160, 255);
            if (this.bidTurn == 0) {
                int ay = DdzGame.BidY();
                int bx0 = DdzGame.CX() - (4 * 116 + 3 * 20) / 2;
                CFx.GoldButton(this.c, this.mouseX, this.mouseY, bx0, ay, 116, 56, "不叫", 2, 0);
                int k1 = 1; if (this.bidBest >= 1) { k1 = 0; }
                int k2 = 1; if (this.bidBest >= 2) { k2 = 0; }
                CFx.GoldButton(this.c, this.mouseX, this.mouseY, bx0 + 136, ay, 116, 56, "1 分", 2, k1);
                CFx.GoldButton(this.c, this.mouseX, this.mouseY, bx0 + 272, ay, 116, 56, "2 分", 2, k2);
                CFx.GoldButton(this.c, this.mouseX, this.mouseY, bx0 + 408, ay, 116, 56, "3 分", 2, 1);
            } else {
                string nm = "右家考虑中…";
                if (this.bidTurn == 2) { nm = "左家考虑中…"; }
                CText.DrawCenteredShadow(this.c, nm, DdzGame.CX(), DdzGame.BidY() - 8, 2, 230, 214, 185, 255);
            }
        }
        this.DrawFx(now);
    }

    void DrawFx(int now) {
        int i = 0;
        while (i < this.parts.Count) {
            DdzParticle p = this.parts[i];
            int age = now - p.bornAt;
            if (age > 900) { this.parts.RemoveAt(i); continue; }
            int px = (p.x + p.vx * age / 4) / 256;
            int py = (p.y + p.vy * age / 4) / 256 + age * age / 26000;
            int alpha = 235 - age * 235 / 900;
            CDraw.FillCircle(this.c, px, py, 3, p.cr, p.cg, p.cb, alpha);
            i = i + 1;
        }
        i = 0;
        while (i < this.pops.Count) {
            DdzPopup p = this.pops[i];
            int age = now - p.bornAt;
            if (age > 1400) { this.pops.RemoveAt(i); continue; }
            int alpha = 255 - age * 255 / 1400;
            CText.DrawCentered(this.c, p.text, p.x, p.y - age / 14, 2, p.cr, p.cg, p.cb, alpha);
            i = i + 1;
        }
        if (now - this.toastAt < 2200) {
            CText.DrawCenteredShadow(this.c, this.toastText, DdzGame.CX(), DdzGame.VH() / 2 - 120, 2, 255, 224, 150, 255);
        }
    }

    // 牌桌底盘背景绘制。
    void DrawTableBase(int now) {
        this.EnsureTex();
        CDraw.Clear(this.c, DdzGame.VW(), DdzGame.VH(), CDraw.Argb(255, 26, 18, 12));
        this.DrawTableBg();
        if (DdzGame.Portrait()) {
            this.DrawSeat(2, 16, 60, this.hand2.Count);
            this.DrawSeat(1, DdzGame.VW() - 206, 60, this.hand1.Count);
        } else {
            this.DrawSeat(2, 30, 60, this.hand2.Count);
            this.DrawSeat(1, 1060, 60, this.hand1.Count);
        }
        this.DrawShown(this.shown0, DdzGame.CX(), 360);
    }

    // 菜单画布层：美术背景 + 标题（开始/难度按钮与战绩行走 DzMenuScene 的
    // HTML 层）。
    void DrawMenuArt() {
        this.EnsureTex();
        int vw = DdzGame.VW();
        int vh = DdzGame.VH();
        CDraw.Clear(this.c, vw, vh, CDraw.Argb(255, 24, 16, 10));
        if (this.menuBg2 != null) {
            DdzGame.BlitCover(this.c, this.menuBg2, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(110, 18, 10, 6));
        } else {
            CKitUi.Backdrop(this.c, this.menuBg, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(120, 14, 10, 6));
        }
        CFx.Vignette(this.c, vw, vh, 90);
        if (this.title2Path != null) {
            CDraw.BlitImage(this.c, this.title2Path, vw / 2 - 300, 30, 600, 200);
        } else if (this.titlePath != null) {
            CDraw.BlitImage(this.c, this.titlePath, vw / 2 - 300, 30, 600, 200);
        } else {
            CText.DrawCenteredShadow(this.c, "斗地主", vw / 2, 70, 9, 245, 232, 205, 255);
        }
    }
}

// 主菜单：画布层只画美术背景与标题（DdzGame.DrawMenuArt），开始/难度
// 按钮与战绩行走 HTML 层；难度按钮选定即开局，开始按钮沿用当前难度。
class DzMenuScene : HtmlScene {
    DdzGame g;

    DzMenuScene(DdzGame g) { this.g = g; }

    override string HtmlFile() { return "assets/scenes/menu.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("start", () => this.router.Go("play"));
        handlers.Add("easy", () => this.Pick(0));
        handlers.Add("normal", () => this.Pick(1));
        handlers.Add("hard", () => this.Pick(2));
    }

    void Pick(int d) {
        this.g.diff = d;
        this.router.Go("play");
    }

    override void OnEnter(Control root) {
        Element stats = DzMenuScene.AsElement(root, "stats");
        if (stats != null) {
            stats.SetText(this.g.prof.Title() + " · 豆 " + this.g.prof.beans
                + " · 胜 " + this.g.prof.wins + " 负 " + this.g.prof.losses
                + " · 最长连胜 " + this.g.prof.bestStreak);
        }
    }

    static Element AsElement(Control root, string id) {
        Control c = root.Find(id);
        if (c != null && c is Element) { return (Element)c; }
        return null;
    }

    override void Event(int kind, int key) {
        if (kind == 4 && key == 27) { this.router.Exit(); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.DrawMenuArt();
    }
}

// 牌桌：纯 canvas 场景（HtmlFile 为空，无 HTML 层）——叫分、出牌、手牌
// 选牌都在画布上。每次进场开新局（菜单入场 / 结算再来一局都走这里），
// 一局分出胜负后路由到结算场景。
class DzPlayScene : HtmlScene {
    DdzGame g;

    DzPlayScene(DdzGame g) { this.g = g; }

    override void OnEnter(Control root) {
        this.g.StartRound(Window.GetTickMs());
    }

    override void Event(int kind, int key) {
        GuiHost host = this.router.Host();
        // 指针坐标经 host.MouseX/Y 反变换回舞台逻辑坐标（桌面视口
        // letterbox / 手机驱动反变换都在宿主之下完成）。
        if (kind == 1) {
            this.g.mouseX = host.MouseX();
            this.g.mouseY = host.MouseY();
        } else if (kind == 2 && key == 0) {
            this.g.mouseX = host.MouseX();
            this.g.mouseY = host.MouseY();
            this.g.OnDown(this.g.mouseX, this.g.mouseY, Window.GetTickMs());
        } else if (kind == 4) {
            if (key == 27) { this.router.Go("menu"); }
            else if (key == 13) { this.g.TryPlaySelected(Window.GetTickMs()); }
            else if (key == 32) { this.g.TryPass(Window.GetTickMs()); }
            else if (key == 67) { this.g.ClearSelection(Window.GetTickMs()); }
        }
    }

    override void FixedStep(int dtMs) {
        this.g.Tick(Window.GetTickMs());
        // 一局分出胜负（Finish 置 scene=3）后切结算；切换在帧首应用，
        // 本场景随即使停。
        if (this.g.scene == 3) { this.router.Go("over"); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.DrawTable(Window.GetTickMs());
    }
}

// 结算：HTML 面板叠在定格的牌桌上——Render 继续画 DrawTableBase（牌局
// 已停，画面定格），body 半透明压暗，按钮/文案由 HTML 层承担。
class DzOverScene : HtmlScene {
    DdzGame g;

    DzOverScene(DdzGame g) { this.g = g; }

    override string HtmlFile() { return "assets/scenes/over.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("again", () => this.router.Go("play"));
        handlers.Add("menu", () => this.router.Go("menu"));
    }

    override void OnEnter(Control root) {
        Element headline = DzOverScene.AsElement(root, "headline");
        Element subEl = DzOverScene.AsElement(root, "sub");
        Element cheerEl = DzOverScene.AsElement(root, "cheer");
        string head; string cheer;
        if (this.g.winner == 1) {
            head = "胜利！赢 " + this.g.deltaBeans + " 豆";
            cheer = "手气正旺，再来一局！";
            if (this.g.prof.streak >= 3) { cheer = this.g.prof.streak + " 连胜！豆子滚滚来"; }
        } else {
            head = "惜败，输 " + this.g.deltaBeans + " 豆";
            cheer = "记牌回想一下，翻盘就在下局";
        }
        if (headline != null) { headline.SetText(head); }
        if (subEl != null) { subEl.SetText("豆 " + this.g.prof.beans + " · 倍数 x" + this.g.mult); }
        if (cheerEl != null) { cheerEl.SetText(cheer); }
    }

    static Element AsElement(Control root, string id) {
        Control c = root.Find(id);
        if (c != null && c is Element) { return (Element)c; }
        return null;
    }

    override void Event(int kind, int key) {
        if (kind != 4) { return; }
        if (key == 27) { this.router.Go("menu"); }
        if (key == 13 || key == 32) { this.router.Go("play"); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.DrawTableBase(Window.GetTickMs());
    }
}

class DzApp {
    static void Main() {
        // 手机竖屏：GuiHost 逻辑宽高比定外壳方向。斗地主手牌带较宽，
        // 竖屏舞台给到 760 宽防手牌挤压。
        SceneRouter router = SceneRouter.CreateFixed("斗地主", 760, 1280, 16);
        DdzGame g = DdzGame.Create(router.Host());
        router.Register("menu", new DzMenuScene(g));
        router.Register("play", new DzPlayScene(g));
        router.Register("over", new DzOverScene(g));
        // demo 标记（ddz_demo.txt）直接进牌桌自弈供截图/无头验证。
        router.Run(g.demo ? "play" : "menu");
    }
}
