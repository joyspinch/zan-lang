        techs[1] = new TechDef("热工学", "解锁熔炉、钢/硅配方、取水、管道与蓄电池。", 0, 35, 25, 8, 0, 0, 0);
        techs[2] = new TechDef("晶格工程", "解锁装配机、油井、钛晶与石油裂解配方。", 1, 40, 30, 0, 12, 15, 0);
        techs[3] = new TechDef("弹道校准", "炮塔伤害增加 50%，射程增加 1 格。", 1, 30, 30, 0, 12, 20, 0);
        techs[4] = new TechDef("物流增压", "传送带与矿机效率增加 50%。", 2, 40, 20, 10, 20, 20, 5);
        techs[5] = new TechDef("炉心扩张", "建造半径从 15 增至全地图，核心耐久增加 1200。", 2, 80, 60, 0, 25, 40, 12);
