        enemies[0] = new EnemyDef("裂壳游兽", 65, 28, 12, 35, 3);
        enemies[1] = new EnemyDef("穿岩重兽", 200, 18, 28, 45, 8);
        enemies[2] = new EnemyDef("玄岩巨像", 1800, 12, 70, 40, 50);
        waves = new WaveDef[20];
        for (int i = 0; i < 20; i = i + 1) {
            int boss = (i + 1) % 5 == 0 ? 2 : -1;
            waves[i] = new WaveDef(4 + i * 2, ForgeGrid.Max(12, 45 - i), 100 + i * 12, boss);
        }
    }
}

class ForgeTile {
    TerrainKind terrain;
    int ore;
    int reserve;
    ForgeTile() { terrain = TerrainKind.Ground; ore = -1; reserve = 0; }
}

class ForgeBuilding {
    BlockKind kind;
    int direction;
    int hp;
    int progress;
    int recipe;
    int cooldown;
    int energy;
    int water;
    int oil;
    int efficiency;
    int network;
    int roundRobin;
    int targetMode;
    int fuelTicks;
    int mergeCursor;
    int feedCursor;
    int lastRecipe;
    Stock stock;
    int[] cargo;
    int[] travel;
    int[] received;
    ForgeBuilding() {
        stock = new Stock(); cargo = new int[4]; travel = new int[4]; received = new int[4]; Reset();
    }
    void Reset() {
        kind = BlockKind.Empty; direction = 0; hp = 0; progress = 0; recipe = 0;
        cooldown = 0; energy = 0; water = 0; oil = 0; efficiency = 0; network = -1;
        roundRobin = 0; targetMode = 0; fuelTicks = 0; mergeCursor = 0; feedCursor = 0;
        lastRecipe = 0; stock.Clear();
        for (int i = 0; i < 4; i = i + 1) { cargo[i] = 0; travel[i] = 0; received[i] = -1; }
    }
}

class ForgeEnemy {
    bool active;
    int kind;
    int x;
    int y;
    int hp;
    int maxHp;
    int cooldown;
    int generation;
    ForgeEnemy() { active = false; generation = 0; }
}

class ForgeBullet {
    bool active;
    int x;
    int y;
    int target;
    int generation;
    int damage;
    int life;
    ForgeBullet() { active = false; }
}

class ForgeEvent {
    ForgeEventKind kind;
    int cell;
    int value;
    int tick;
    ForgeEvent() { tick = -1; }
}

class ForgeEvents {
    ForgeEvent[] entries;
    int sequence;
    ForgeEvents() {
        entries = new ForgeEvent[64]; sequence = 0;
        for (int i = 0; i < 64; i = i + 1) { entries[i] = new ForgeEvent(); }
    }
    void Emit(ForgeEventKind kind, int cell, int value, int tick) {
        ForgeEvent e = entries[sequence % 64];
        e.kind = kind; e.cell = cell; e.value = value; e.tick = tick;
        sequence = sequence + 1;
    }
}

class ForgeGrid {
    static int TileSize() { return 32; }
    static int Unit() { return 1000; }
    static int Dx(int direction) { if (direction == 0) { return 1; } if (direction == 2) { return -1; } return 0; }
    static int Dy(int direction) { if (direction == 1) { return 1; } if (direction == 3) { return -1; } return 0; }
    static int WorldToCell(int world) { return world < 0 ? -1 : world / 1000; }
    static int Center(int cell) { return cell * 1000 + 500; }
    static int Max(int a, int b) { return a > b ? a : b; }
    static int Min(int a, int b) { return a < b ? a : b; }
    static int Abs(int v) { return v < 0 ? -v : v; }
    static int Clamp(int v, int lo, int hi) { if (v < lo) { return lo; } if (v > hi) { return hi; } return v; }
}

class ForgeWorld {
    int width;
    int height;
    int seed;
    int tick;
    int coreCell;
    int coreMaxHp;
    int wave;
    int nextWaveTicks;
    int spawnRemaining;
    int spawnCooldown;
    int bulletCursor;
    bool bossPending;
    bool waveActive;
    bool defeated;
    bool victory;
    int enemyCount;
    int kills;
    int produced;
    int powerSupply;
    int powerDemand;
    int batteryStored;
    bool topologyDirty;
    bool pathsDirty;
    ForgeCatalog catalog;
    ForgeTile[] tiles;
    ForgeBuilding[] buildings;
    ForgeEnemy[] enemies;
    ForgeBullet[] bullets;
    Stock resources;
    bool[] researched;
    ForgeEvents events;
    ForgeWorld(int mapWidth, int mapHeight, int mapSeed) {
        width = mapWidth; height = mapHeight; seed = mapSeed; catalog = new ForgeCatalog();
        tiles = new ForgeTile[width * height]; buildings = new ForgeBuilding[width * height];
        for (int i = 0; i < width * height; i = i + 1) { tiles[i] = new ForgeTile(); buildings[i] = new ForgeBuilding(); }
        enemies = new ForgeEnemy[192]; bullets = new ForgeBullet[384];
        for (int i = 0; i < 192; i = i + 1) { enemies[i] = new ForgeEnemy(); }
        for (int i = 0; i < 384; i = i + 1) { bullets[i] = new ForgeBullet(); }
        resources = new Stock(); researched = new bool[6]; researched[0] = true;
        events = new ForgeEvents(); coreCell = (height / 2) * width + width / 2;
        coreMaxHp = 2400; nextWaveTicks = 3500; topologyDirty = true; pathsDirty = true;
    }
    int Index(int x, int y) { if (x < 0 || y < 0 || x >= width || y >= height) { return -1; } return y * width + x; }
    int Neighbor(int cell, int dir) { return Index(cell % width + ForgeGrid.Dx(dir), cell / width + ForgeGrid.Dy(dir)); }
    bool Unlocked(BlockKind kind) { return researched[catalog.blocks[(int)kind].tech]; }
    bool InBuildRange(int cell) {
        if (researched[5]) { return true; }
        return ForgeGrid.Abs(cell % width - coreCell % width) <= 15 && ForgeGrid.Abs(cell / width - coreCell / width) <= 15;
    }
    string BuildError(int cell, BlockKind kind) {
        if (defeated || victory) { return "本局已结束，请开始新的远征。"; }
        if (cell < 0 || cell >= width * height) { return "超出地图边界。"; }
        if (kind == BlockKind.Empty || kind == BlockKind.Core) { return "请选择建造项目。"; }
        if (!Unlocked(kind)) { return "请先在科技面板完成前置研究。"; }
        if (!InBuildRange(cell)) { return "超出建造半径，研究炉心扩张可解锁。"; }
        if (buildings[cell].kind != BlockKind.Empty) { return "这里已有建筑。"; }
        ForgeTile t = tiles[cell];
        if (kind == BlockKind.Pump) { if (t.terrain != TerrainKind.Water) { return "取水泵需要建在水面。"; } }
        else if (kind == BlockKind.OilPump) { if (t.terrain != TerrainKind.Oil) { return "油井需要建在油层。"; } }
        else if (t.terrain == TerrainKind.Rock || t.terrain == TerrainKind.Water) { return "该地形不可建造。"; }
        if (kind == BlockKind.Drill && (t.ore < 0 || t.reserve <= 0)) { return "钻头需要未耗尽的矿脉。"; }
        if (cell % width <= 1 || cell % width >= width - 2 || cell / width <= 1 || cell / width >= height - 2) { return "敌军入口需要保持畅通。"; }
        for (int i = 0; i < 192; i = i + 1) {
            ForgeEnemy e = enemies[i];
            if (e.active && Index(ForgeGrid.WorldToCell(e.x), ForgeGrid.WorldToCell(e.y)) == cell) { return "敌人占据此处，无法建造。"; }
        }
        if (!resources.Has(catalog.blocks[(int)kind].cost)) { return "核心资源不足，请接通矿脉输送线。"; }
        return "";
    }
    bool Build(int cell, BlockKind kind, int direction) {
        if (BuildError(cell, kind) != "") { return false; }
        if (!resources.Pay(catalog.blocks[(int)kind].cost)) { return false; }
        Place(cell, kind, direction);
        events.Emit(ForgeEventKind.Built, cell, (int)kind, tick);
        return true;
    }
    void Place(int cell, BlockKind kind, int direction) {
        ForgeBuilding b = buildings[cell]; b.Reset(); b.kind = kind;
        b.direction = direction % 4; b.hp = catalog.blocks[(int)kind].hp;
        if (kind == BlockKind.Assembler) { b.recipe = 2; }
        topologyDirty = true; pathsDirty = true;
    }
    bool Remove(int cell, bool refund) {
        if (cell < 0 || cell >= width * height) { return false; }
        ForgeBuilding b = buildings[cell];
        if (b.kind == BlockKind.Empty || b.kind == BlockKind.Core) { return false; }
        if (refund) {
            Stock cost = catalog.blocks[(int)b.kind].cost;
            for (int i = 0; i < 6; i = i + 1) { resources.Add(i, cost.Get(i) / 2 + b.stock.Get(i)); }
            for (int i = 0; i < 4; i = i + 1) { if (b.cargo[i] > 0) { resources.Add(b.cargo[i] - 1, 1); } }
        }
        b.Reset(); topologyDirty = true; pathsDirty = true;
        events.Emit(ForgeEventKind.Removed, cell, 0, tick); return true;
    }
    bool Research(int tech) {
        if (tech <= 0 || tech >= 6 || researched[tech] || defeated || victory) { return false; }
        TechDef def = catalog.techs[tech];
        if (!researched[def.parent] || !resources.Pay(def.cost)) { return false; }
        researched[tech] = true;
        if (tech == 5) { coreMaxHp = coreMaxHp + 1200; buildings[coreCell].hp = buildings[coreCell].hp + 1200; }
        events.Emit(ForgeEventKind.Researched, coreCell, tech, tick); return true;
    }
    bool Feed(int cell, int item, int quantity) {
        if (cell < 0 || cell >= width * height || item < 0 || item >= 6 || quantity < 1) { return false; }
        ForgeBuilding b = buildings[cell];
        if (b.kind == BlockKind.Empty || b.kind == BlockKind.Core || b.stock.Total() + quantity > 24) { return false; }
        if (!resources.Take(item, quantity)) { return false; }
        b.stock.Add(item, quantity); return true;
    }
}
