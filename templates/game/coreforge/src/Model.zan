using System;

namespace Coreforge;

enum ItemKind { Copper, Lead, Graphite, Silicon, Steel, Titanium }
enum TerrainKind { Ground, Rock, Water, Oil }
enum BlockKind { Empty, Core, Drill, Belt, Router, Furnace, Assembler, Generator, Battery, Turret, Wall, Pump, Pipe, Relay, OilPump }
enum ForgeEventKind { Built, Removed, Produced, WaveStarted, WaveCleared, EnemyKilled, Researched, CoreLost }

class Stock {
    int[] amount;
    Stock() { amount = new int[6]; }
    int Get(int item) { return amount[item]; }
    void Add(int item, int n) { amount[item] = amount[item] + n; }
    bool Take(int item, int n) {
        if (n < 0 || amount[item] < n) { return false; }
        amount[item] = amount[item] - n;
        return true;
    }
    bool Has(Stock cost) {
        for (int i = 0; i < 6; i = i + 1) { if (amount[i] < cost.amount[i]) { return false; } }
        return true;
    }
    bool Pay(Stock cost) {
        if (!Has(cost)) { return false; }
        for (int i = 0; i < 6; i = i + 1) { amount[i] = amount[i] - cost.amount[i]; }
        return true;
    }
    int Total() {
        int n = 0;
        for (int i = 0; i < 6; i = i + 1) { n = n + amount[i]; }
        return n;
    }
    void Clear() { for (int i = 0; i < 6; i = i + 1) { amount[i] = 0; } }
}

class BlockDef {
    BlockKind kind;
    string name;
    string help;
    int hp;
    int tech;
    int powerUse;
    int powerRadius;
    int capacity;
    Stock cost;
    BlockDef(BlockKind k, string title, string description, int health, int unlock, int draw, int radius, int copper, int lead, int steel) {
        kind = k; name = title; help = description; hp = health; tech = unlock;
        powerUse = draw; powerRadius = radius; capacity = 24;
        cost = new Stock(); cost.Add(0, copper); cost.Add(1, lead); cost.Add(4, steel);
    }
}

class RecipeDef {
    string name;
    BlockKind machine;
    int tech;
    Stock input;
    int output;
    int quantity;
    int ticks;
    int water;
    int oil;
    RecipeDef(string title, BlockKind block, int unlock, int a, int an, int b, int bn, int result, int n, int duration, int waterCost, int oilCost) {
        name = title; machine = block; tech = unlock; input = new Stock();
        input.Add(a, an); input.Add(b, bn); output = result; quantity = n;
        ticks = duration; water = waterCost; oil = oilCost;
    }
}

class TechDef {
    string name;
    string help;
    int parent;
    Stock cost;
    TechDef(string title, string description, int before, int copper, int lead, int graphite, int silicon, int steel, int titanium) {
        name = title; help = description; parent = before; cost = new Stock();
        cost.Add(0, copper); cost.Add(1, lead); cost.Add(2, graphite);
        cost.Add(3, silicon); cost.Add(4, steel); cost.Add(5, titanium);
    }
}

class EnemyDef {
    string name;
    int hp;
    int speed;
    int damage;
    int cooldown;
    int reward;
    EnemyDef(string title, int health, int movement, int attack, int interval, int bounty) {
        name = title; hp = health; speed = movement; damage = attack; cooldown = interval; reward = bounty;
    }
}

class WaveDef {
    int count;
    int interval;
    int strength;
    int boss;
    WaveDef(int units, int cadence, int scaling, int bossType) {
        count = units; interval = cadence; strength = scaling; boss = bossType;
    }
}

class ForgeCatalog {
    BlockDef[] blocks;
    RecipeDef[] recipes;
    TechDef[] techs;
    EnemyDef[] enemies;
    WaveDef[] waves;
    string[] items;
    ForgeCatalog() {
        items = new string[6];
        items[0] = "铜"; items[1] = "铅"; items[2] = "石墨";
        items[3] = "硅"; items[4] = "钢"; items[5] = "钛";
        blocks = new BlockDef[15];
        blocks[0] = new BlockDef(BlockKind.Empty, "选择", "点击建筑查看运行状态。", 0, 0, 0, 0, 0, 0, 0);
        blocks[1] = new BlockDef(BlockKind.Core, "炉心", "储存输送来的物品；保护它并研究扩张。", 2400, 0, 0, 4, 0, 0, 0);
        blocks[2] = new BlockDef(BlockKind.Drill, "矿脉钻头", "建在矿脉上，沿箭头输出矿石；无电也能低速运转。", 180, 0, 4, 3, 12, 0, 0);
        blocks[3] = new BlockDef(BlockKind.Belt, "传送带", "每格四个物品位；朝向决定输出，相邻支路可合流。", 80, 0, 0, 0, 1, 0, 0);
        blocks[4] = new BlockDef(BlockKind.Router, "分流器", "在可接收的三个出口间轮流分配，堵塞时自动换路。", 130, 0, 0, 0, 5, 2, 0);
        blocks[5] = new BlockDef(BlockKind.Furnace, "电弧熔炉", "消耗电力：铜铅合成钢，石墨和铜合成硅。", 220, 1, 12, 3, 22, 12, 0);
        blocks[6] = new BlockDef(BlockKind.Assembler, "晶格装配机", "水冷钢硅结晶制钛；石油裂解制石墨。", 240, 2, 20, 3, 30, 20, 12);
        blocks[7] = new BlockDef(BlockKind.Generator, "热差发电机", "基础产能 32；每次耗 1 石墨与水可提高到 64。", 240, 0, 0, 4, 18, 8, 0);
        blocks[8] = new BlockDef(BlockKind.Battery, "蓄电池", "存储电网余能，在供不应求时自动补充。", 200, 1, 0, 4, 12, 22, 0);
        blocks[9] = new BlockDef(BlockKind.Turret, "脉冲炮塔", "传送带供铜或铅弹药；通电提高射速，水冷进一步提速。", 300, 0, 6, 3, 22, 12, 0);
        blocks[10] = new BlockDef(BlockKind.Wall, "合金墙", "阻挡敌人并吸收攻击；敌人被封路后会拆墙。", 650, 0, 0, 0, 5, 5, 0);
        blocks[11] = new BlockDef(BlockKind.Pump, "取水泵", "建在水面上，向四周管道与工厂输水。", 160, 1, 4, 3, 14, 8, 0);
        blocks[12] = new BlockDef(BlockKind.Pipe, "双通道管道", "相邻连通，各自运输水和石油，容量 100。", 90, 1, 0, 0, 2, 1, 0);
        blocks[13] = new BlockDef(BlockKind.Relay, "电力中继", "连接半径五格内的电力建筑，延伸电网。", 120, 0, 0, 5, 5, 8, 0);
        blocks[14] = new BlockDef(BlockKind.OilPump, "油井", "建在油层上，为装配机供给石油。", 190, 2, 8, 3, 20, 16, 8);
        recipes = new RecipeDef[4];
        recipes[0] = new RecipeDef("合金钢", BlockKind.Furnace, 1, 0, 2, 1, 1, 4, 2, 100, 0, 0);
        recipes[1] = new RecipeDef("精炼硅", BlockKind.Furnace, 1, 2, 2, 0, 1, 3, 2, 140, 0, 0);
        recipes[2] = new RecipeDef("水冷钛晶", BlockKind.Assembler, 2, 4, 2, 3, 2, 5, 1, 180, 12, 0);
        recipes[3] = new RecipeDef("石油裂解", BlockKind.Assembler, 2, 0, 0, 0, 0, 2, 3, 100, 0, 12);
        techs = new TechDef[6];
