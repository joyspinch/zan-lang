using System;

public class ForgeBullet {
    bool active;
    int x;
    int y;
    int target;
    int generation;
    int damage;
    int life;
    // >0 的命中触发溅射（臼炮曲射），数值只作旗标；溅射范围见 ForgeCombat.BlastRadius。
    int blast;
    ForgeBullet() { active = false; blast = 0; }
}

// 纯视觉粒子：不进存档，模拟暂停时冻结。kind 见 ForgeWorld.SpawnEffect。
