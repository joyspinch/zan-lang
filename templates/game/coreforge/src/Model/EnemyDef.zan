using System;

public class EnemyDef {
    string name;
    int hp;
    int speed;
    int damage;
    int cooldown;
    int reward;
    EnemyDef(string title, int health, int movement, int attack, int interval, int bounty) {
        name = title; hp = health; speed = movement; damage = attack; cooldown = interval; reward = bounty;
    }
}
