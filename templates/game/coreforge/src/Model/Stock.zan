using System;

public class Stock {
    int[] amount;
    Stock() { amount = new int[6]; }
    int Get(int item) { return amount[item]; }
    void Add(int item, int n) { amount[item] = amount[item] + n; }
    bool Take(int item, int n) {
        if (n < 0 || amount[item] < n) { return false; }
        amount[item] = amount[item] - n;
        return true;
    }
    bool Has(Stock cost) {
        for (int i = 0; i < 6; i = i + 1) { if (amount[i] < cost.amount[i]) { return false; } }
        return true;
    }
    bool Pay(Stock cost) {
        if (!Has(cost)) { return false; }
        for (int i = 0; i < 6; i = i + 1) { amount[i] = amount[i] - cost.amount[i]; }
        return true;
    }
    int Total() {
        int n = 0;
        for (int i = 0; i < 6; i = i + 1) { n = n + amount[i]; }
        return n;
    }
    void Clear() { for (int i = 0; i < 6; i = i + 1) { amount[i] = 0; } }
}
