using System;

public class ForgeBuilding {
    BlockKind kind;
    int direction;
    int hp;
    int progress;
    int recipe;
    int cooldown;
    int energy;
    int water;
    int oil;
    int efficiency;
    int network;
    int roundRobin;
    int targetMode;
    int fuelTicks;
    int mergeCursor;
    int feedCursor;
    int lastRecipe;
    // 力场护盾的当前屏障值（仅 Shield 建筑；上限为盾墙耐久的 3 倍，见 ForgeCombat）。
    int shield;
    Stock stock;
    int[] cargo;
    int[] travel;
    int[] received;
    ForgeBuilding() {
        stock = new Stock(); cargo = new int[4]; travel = new int[4]; received = new int[4]; Reset();
    }
    void Reset() {
        kind = BlockKind.Empty; direction = 0; hp = 0; progress = 0; recipe = 0;
        cooldown = 0; energy = 0; water = 0; oil = 0; efficiency = 0; network = -1;
        roundRobin = 0; targetMode = 0; fuelTicks = 0; mergeCursor = 0; feedCursor = 0;
        lastRecipe = 0; shield = 0; stock.Clear();
        for (int i = 0; i < 4; i = i + 1) { cargo[i] = 0; travel[i] = 0; received[i] = -1; }
    }
}
