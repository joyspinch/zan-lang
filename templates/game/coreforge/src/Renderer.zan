using System;
using Gui;

namespace Coreforge;

class ForgeCamera {
    int viewportX;
    int viewportY;
    int viewportW;
    int viewportH;
    double x;
    double y;
    double zoom;
    int shakeX;
    int shakeY;

    ForgeCamera() { zoom = 1.0; shakeX = 0; shakeY = 0; }

    void SetShake(int sx, int sy) { shakeX = sx; shakeY = sy; }

    // 核心契约与语义定义。
    int ScreenX(int world1000) {
        return viewportX + shakeX + (int)Math.Round(viewportW * 0.5 + (world1000 / 1000.0 - x) * ForgeGrid.TileSize() * zoom);
    }
    int ScreenY(int world1000) {
        return viewportY + shakeY + (int)Math.Round(viewportH * 0.5 + (world1000 / 1000.0 - y) * ForgeGrid.TileSize() * zoom);
    }
    int CellAt(ForgeWorld w, int mx, int my) {
        mx = mx - shakeX; my = my - shakeY;
        if (viewportW <= 0 || viewportH <= 0 || mx < viewportX || my < viewportY ||
            mx >= viewportX + viewportW || my >= viewportY + viewportH) { return -1; }
        double pixels = ForgeGrid.TileSize() * zoom;
        int tx = (int)Math.Floor(x + (mx - viewportX - viewportW * 0.5) / pixels);
        int ty = (int)Math.Floor(y + (my - viewportY - viewportH * 0.5) / pixels);
        return w.Index(tx, ty);
    }
    void Pan(double dxPixels, double dyPixels) {
        double pixels = ForgeGrid.TileSize() * zoom;
        x = x - dxPixels / pixels;
        y = y - dyPixels / pixels;
    }
    void ZoomAt(double factor, int mx, int my) {
        if (!(factor > 0.0)) { return; }
        double pixels = ForgeGrid.TileSize() * zoom;
        double anchorX = x + (mx - viewportX - viewportW * 0.5) / pixels;
        double anchorY = y + (my - viewportY - viewportH * 0.5) / pixels;
        zoom = Math.Max(0.45, Math.Min(2.2, zoom * factor));
        pixels = ForgeGrid.TileSize() * zoom;
        x = anchorX - (mx - viewportX - viewportW * 0.5) / pixels;
        y = anchorY - (my - viewportY - viewportH * 0.5) / pixels;
    }
    void SetViewport(int x, int y, int w, int h) {
        viewportX = x; viewportY = y;
        viewportW = ForgeGrid.Max(0, w); viewportH = ForgeGrid.Max(0, h);
    }
    void Focus(ForgeWorld w) {
        x = w.coreCell % w.width + 0.5;
        y = w.coreCell / w.width + 0.5;
    }
}

class ForgeRenderer {
    Canvas canvas;
    int originX;
    int originY;
    double scale;
    bool ghost;
    int ghostTint;
    int aimBudget;
    int[] aimCell;
    int[] aimTarget;
    int[] aimGeneration;
    int[] aimTick;
    // 蓝图会话态：标量由 Interface 每帧写入；数组在 Attach 时共享同一存储。
    int bpState;
    bool bpDrag;
    int bpAnchor;
    int bpCount;
    int[] bpDX;
    int[] bpDY;
    int[] bpKind;
    int[] bpDir;

    ForgeRenderer() {
        aimCell = new int[1024]; aimTarget = new int[1024];
        aimGeneration = new int[1024]; aimTick = new int[1024];
        for (int i = 0; i < 1024; i = i + 1) { aimCell[i] = -1; aimTarget[i] = -1; aimTick[i] = -1; }
    }

    int S(int value) { return (int)Math.Round(value * scale); }
    int Stroke(int value) { return ForgeGrid.Max(1, S(value)); }
    int Ink(int color) {
        if (!ghost) { return color; }
        int red = (((color >> 16) & 255) + ((ghostTint >> 16) & 255)) / 2;
        int green = (((color >> 8) & 255) + ((ghostTint >> 8) & 255)) / 2;
        int blue = ((color & 255) + (ghostTint & 255)) / 2;
        return 0x99000000 | (red << 16) | (green << 8) | blue;
    }
    void Rect(int x, int y, int w, int h, int color) {
        canvas.FillRect(originX + S(x), originY + S(y), ForgeGrid.Max(1, S(x + w) - S(x)), ForgeGrid.Max(1, S(y + h) - S(y)), Ink(color));
    }
    void Frame(int x, int y, int w, int h, int color, int thickness) {
        canvas.DrawRect(originX + S(x), originY + S(y), ForgeGrid.Max(1, S(x + w) - S(x)), ForgeGrid.Max(1, S(y + h) - S(y)), Ink(color), Stroke(thickness));
    }
    void Line(int x0, int y0, int x1, int y1, int color, int thickness) {
        canvas.DrawLine(originX + S(x0), originY + S(y0), originX + S(x1), originY + S(y1), Ink(color), Stroke(thickness));
    }
    void Disc(int x, int y, int radius, int color) {
        canvas.FillCircle(originX + S(x), originY + S(y), Stroke(radius), Ink(color));
    }
    void Ring(int x, int y, int radius, int color, int thickness) {
        canvas.DrawCircle(originX + S(x), originY + S(y), Stroke(radius), Ink(color), Stroke(thickness));
    }
    void Sector(int x, int y, int inner, int outer, int start, int end, int color) {
        canvas.FillSector(originX + S(x), originY + S(y), S(inner), Stroke(outer), start, end, Ink(color));
    }
    void Glow(int x, int y, int radius, int color, int alpha) {
        if (!ghost) { canvas.FillRadial(originX + S(x), originY + S(y), Stroke(radius), color, alpha); }
    }
    void AtCell(ForgeWorld w, ForgeCamera camera, int cell) {
        scale = camera.zoom;
        originX = camera.ScreenX((cell % w.width) * 1000);
        originY = camera.ScreenY((cell / w.width) * 1000);
    }
    bool Visible(ForgeCamera camera, int x, int y, int margin) {
        return x + margin >= camera.viewportX && y + margin >= camera.viewportY &&
            x - margin < camera.viewportX + camera.viewportW && y - margin < camera.viewportY + camera.viewportH;
    }
    int RotX(int x, int y, int direction) {
        if (direction == 1) { return 32 - y; }
        if (direction == 2) { return 32 - x; }
        if (direction == 3) { return y; }
        return x;
    }
    int RotY(int x, int y, int direction) {
        if (direction == 1) { return x; }
        if (direction == 2) { return 32 - y; }
        if (direction == 3) { return 32 - x; }
        return y;
    }
    void TurnRect(int x, int y, int w, int h, int direction, int color) {
        int x0 = RotX(x, y, direction); int y0 = RotY(x, y, direction);
        int x1 = RotX(x + w, y + h, direction); int y1 = RotY(x + w, y + h, direction);
        Rect(ForgeGrid.Min(x0, x1), ForgeGrid.Min(y0, y1), ForgeGrid.Abs(x1 - x0), ForgeGrid.Abs(y1 - y0), color);
    }
    void TurnLine(int x0, int y0, int x1, int y1, int direction, int color, int thickness) {
        Line(RotX(x0, y0, direction), RotY(x0, y0, direction), RotX(x1, y1, direction), RotY(x1, y1, direction), color, thickness);
    }
    void Arrow(int x, int y, int direction, int color) {
        TurnLine(x - 3, y - 3, x, y, direction, color, 1);
        TurnLine(x, y, x - 3, y + 3, direction, color, 1);
    }
    int ItemColor(int item) {
        if (item == 0) { return 0xFFE8A05D; }
        if (item == 1) { return 0xFFB5A3C9; }
        if (item == 2) { return 0xFF7C8792; }
        if (item == 3) { return 0xFF9DE8CA; }
        if (item == 4) { return 0xFFC0CCD3; }
        if (item == 5) { return 0xFF7ECAEC; }
        return 0xFFE2D5B5;
    }
    int TurretRange(ForgeWorld w) { return w.researched[3] ? 7 : 6; }

    void Plate(int color) {
        Rect(4, 6, 27, 26, 0x70202628);
        Rect(4, 2, 24, 28, 0xFF182529);
        Rect(2, 5, 28, 22, 0xFF182529);
        Rect(5, 4, 22, 24, color);
        Rect(4, 7, 24, 17, color);
        Line(6, 4, 25, 4, 0xFF8C998E, 1);
        Line(4, 7, 4, 23, 0xFF586A67, 1);
        Line(6, 28, 26, 28, 0xFF101E23, 2);
        if (scale >= 0.7) {
            Rect(6, 6, 2, 2, 0xFFB1B4A1); Rect(24, 6, 2, 2, 0xFFB1B4A1);
            Rect(6, 24, 2, 2, 0xFF17252A); Rect(24, 24, 2, 2, 0xFF17252A);
        }
    }
    void Corners(int color, int inset) {
        int high = 32 - inset;
        Line(inset, inset + 6, inset, inset, color, 2); Line(inset, inset, inset + 6, inset, color, 2);
        Line(high - 6, inset, high, inset, color, 2); Line(high, inset, high, inset + 6, color, 2);
        Line(inset, high - 6, inset, high, color, 2); Line(inset, high, inset + 6, high, color, 2);
        Line(high - 6, high, high, high, color, 2); Line(high, high, high, high - 6, color, 2);
    }

    void Terrain(ForgeWorld w, ForgeCamera camera, int cell) {
        ForgeTile tile = w.tiles[cell];
        int tx = cell % w.width; int ty = cell / w.width;
        int hash = (tx * 7349 + ty * 9151 + (w.seed & 65535) * 31) & 1023;
        AtCell(w, camera, cell);
        int width = camera.ScreenX((tx + 1) * 1000) - originX;
        int height = camera.ScreenY((ty + 1) * 1000) - originY;
        // 地面三层变化：区域基色（大尺度色块）→ 格内抖动 → 碎屑装饰，
        // 让地图读起来是"地貌"而不是棋盘。
        int region = ((tx / 5) * 73856093 ^ (ty / 5) * 19349663 ^ (w.seed & 65535)) & 1023;
        int ground = region % 3 == 0 ? 0xFF5A5340 : region % 3 == 1 ? 0xFF524C3A : 0xFF5E5743;
        if (hash % 7 == 0) { ground = 0xFF605845; }
        else if (hash % 7 == 1) { ground = 0xFF4E4938; }
        canvas.FillRect(originX, originY, width, height, ground);
        if (tile.terrain == TerrainKind.Water || tile.terrain == TerrainKind.Oil) {
            bool water = tile.terrain == TerrainKind.Water;
            int liquid = water ? 0xFF2E5F63 : 0xFF332A44;
            if (hash % 3 == 0) { liquid = water ? 0xFF33686C : 0xFF3A2F4E; }
            canvas.FillRect(originX, originY, width, height, liquid);
            for (int d = 0; d < 4; d = d + 1) {
                int adjacent = w.Neighbor(cell, d);
                if (adjacent < 0 || w.tiles[adjacent].terrain != tile.terrain) {
                    TurnRect(29, 0, 3, 32, d, water ? 0xFF5C6E58 : 0xFF5A4B55);
                    TurnLine(28, 2, 28, 29, d, water ? 0xFF7FB8A8 : 0xFF8A7492, 1);
                }
            }
            if (hash % 3 == 0 && scale >= 0.6) {
                int ripple = (w.tick / 12 + hash) % 7;
                if (water) {
                    Line(5, 9 + ripple, 14, 9 + ripple, 0xFF4E8A84, 1);
                    Line(17, 18 + ripple, 25, 18 + ripple, 0xFF427A76, 1);
                } else {
                    Sector(15, 17, 7, 8, 195 + ripple, 285 + ripple, 0xFF7A5F84);
                    Line(11, 11, 17, 9, 0xFF8A7A66, 1);
                }
            }
        } else if (scale >= 0.65) {
            int gritX = 3 + hash % 24; int gritY = 3 + (hash / 7) % 24;
            Rect(gritX, gritY, 3, 1, 0xFF6E6450);
            if (hash % 3 == 0) { Rect((gritX + 11) % 27, (gritY + 9) % 27, 2, 2, 0xFF69614C); }
            if (hash % 4 == 0) {
                Line(3, 24, 12, 21, 0xFF3E4436, 1);
                Line(12, 21, 17, 22, 0xFF3E4436, 1);
            }
            if (hash % 6 == 0) {
                // 草簇：三短笔的暗绿，让荒原有一丝生机。
                int gx = 5 + hash % 20; int gy = 5 + (hash / 3) % 20;
                Line(gx, gy, gx - 2, gy - 4, 0xFF6E7A46, 1);
                Line(gx, gy, gx, gy - 5, 0xFF7A8550, 1);
                Line(gx, gy, gx + 2, gy - 4, 0xFF646F40, 1);
            }
        }
        if (tile.terrain == TerrainKind.Rock) { Rock(hash); }
        if (tile.ore >= 0 && tile.reserve > 0) { Ore(tile.ore, hash); }
    }
    void Rock(int hash) {
        int offset = hash % 3;
        Disc(18, 20, 13, 0x7030392F);
        Rect(8, 7, 18, 20, 0xFF343E3C);
        Rect(5, 11, 24, 11, 0xFF343E3C);
        Sector(16, 16, 0, 12, 195, 305, 0xFF788073);
        Sector(16, 16, 0, 12, 305, 360, 0xFF56665D);
        Sector(16, 16, 0, 12, 0, 100, 0xFF56665D);
        Sector(16, 16, 0, 12, 100, 195, 0xFF46544C);
        Line(5, 13, 13 + offset, 5, 0xFF95947C, 1);
        Line(13 + offset, 5, 22, 8, 0xFF93947E, 1);
        Line(16, 16, 25, 10, 0xFF8A8F7A, 1);
        Line(16, 16, 19, 26, 0xFF2A3734, 1);
        Rect(3, 25, 5, 3, 0xFF5C6657);
        if (hash % 2 == 0) { Rect(25, 3, 4, 3, 0xFF707465); }
    }
    void Ore(int item, int hash) {
        int color = ItemColor(item);
        // 矿脉底光：整格淡淡的物品色，缩放再小也能读出矿脉走向。
        Rect(1, 1, 30, 30, ((color & 0x00FFFFFF) | 0x2E000000));
        for (int i = 0; i < 5; i = i + 1) {
            int px = 5 + (hash + i * 13) % 22;
            int py = 5 + (hash / 5 + i * 11) % 21;
            Rect(px - 4, py - 3, 9, 8, 0xFF2E3734);
            if (item == 2) {
                Rect(px - 3, py - 4, 5, 8, 0xFF3E4C5C);
                Line(px - 3, py - 4, px + 1, py - 6, color, 2);
                Line(px + 1, py - 6, px + 4, py - 1, 0xFFAEB9BD, 1);
                Rect(px - 2, py - 1, 2, 2, color);
            } else {
                Rect(px - 3, py - 3, 7, 6, color);
                Rect(px - 2, py - 4, 4, 3, item == 0 ? 0xFFFFCE8E : 0xFFE4EEE0);
                Line(px, py + 2, px + 4, py + 1, item == 0 ? 0xFF976746 : 0xFF566270, 1);
                if (i == 2) { Rect(px + 2, py - 1, 3, 3, color); }
            }
        }
    }
    void Grid(ForgeWorld w, ForgeCamera camera, int left, int top, int right, int bottom) {
        if (scale < 0.6) { return; }
        int x0 = camera.ScreenX(left * 1000); int y0 = camera.ScreenY(top * 1000);
        int x1 = camera.ScreenX((right + 1) * 1000); int y1 = camera.ScreenY((bottom + 1) * 1000);
        for (int tx = left; tx <= right + 1; tx = tx + 1) {
            int px = camera.ScreenX(tx * 1000);
            canvas.DrawLine(px, y0, px, y1, 0x14202929, 1);
        }
        for (int ty = top; ty <= bottom + 1; ty = ty + 1) {
            int py = camera.ScreenY(ty * 1000);
            canvas.DrawLine(x0, py, x1, py, 0x14202929, 1);
        }
    }

    void Belt(ForgeWorld w, int cell, int direction) {
        // 弯道衔接：哪条侧边有朝本格进料的传送带，就画四分之一圆弧
        // 把进料边中点连到输出边中点（与 CanReceive 的进料边同一语义）。
        bool left = SideFed(w, cell, (direction + 3) % 4);
        bool right = SideFed(w, cell, (direction + 1) % 4);
        if (left) { BeltCorner(w, direction, true); }
        if (right) { BeltCorner(w, direction, false); }
        // 纯直线（独立带、钻头直供或后方直进）；直进 + 侧进 = T 衔接，两层都画。
        bool straight = SideFed(w, cell, (direction + 2) % 4);
        if (straight || (!left && !right)) { BeltLane(w, direction); }
    }

    // 世界边 side 上是否有朝本格来的传送带（邻格是带且指向本格）。
    bool SideFed(ForgeWorld w, int cell, int side) {
        int x = cell % w.width + ForgeGrid.Dx(side);
        int y = cell / w.width + ForgeGrid.Dy(side);
        if (x < 0 || y < 0 || x >= w.width || y >= w.height) { return false; }
        ForgeBuilding n = w.buildings[w.Index(x, y)];
        return n.kind == BlockKind.Belt && n.direction == (side + 2) % 4;
    }

    // 弯道：以局部坐标 (32, 0|32)（输出边与进料边的夹角顶点）为圆心，
    // 半径 16 的四分之一弧把两条边中点连起来，分层复刻直带的
    // 底影/带面/内槽/护栏配色；两枚刻度沿线滑动。
    void BeltCorner(ForgeWorld w, int direction, bool fromNorth) {
        int cy = fromNorth ? 0 : 32;
        int a0 = 180;  // 进料边中点
        int a1 = fromNorth ? 90 : 270;  // 输出边中点
        BeltArc(32, cy, 17, a0, a1, direction, 0x80232A28, 24);
        BeltArc(32, cy, 16, a0, a1, direction, 0xFF293738, 22);
        BeltArc(32, cy, 16, a0, a1, direction, 0xFF182B2D, 14);
        BeltArc(32, cy, 6, a0, a1, direction, 0xFF9F966E, 3);
        BeltArc(32, cy, 26, a0, a1, direction, 0xFF6A7058, 2);
        int sweep = a1 - a0;
        int phase = (w.tick / 2) % 16;
        for (int k = 0; k < 2; k = k + 1) {
            int at = a0 + sweep * (phase + k * 8) / 16;
            BeltArc(32, cy, 16, at, at + sweep / 9, direction, 0xFF415353, 14);
        }
        // 进料边金色端标（与直带入口端标同族）。
        TurnLine(22, cy, 10, cy, direction, 0xFFDBBA70, 3);
    }

    // 局部极坐标弧段折线（0°=东，屏幕 y 向下顺时针增），经方向旋转落格。
    void BeltArc(int cx, int cy, int r, int a0, int a1, int direction, int color, int thickness) {
        int steps = ForgeGrid.Max(2, ForgeGrid.Abs(a1 - a0) / 9);
        int px = 0; int py = 0;
        for (int i = 0; i <= steps; i = i + 1) {
            double rad = (a0 + (a1 - a0) * i / steps) * 0.017453292519943295;
            int x = cx + (int)Math.Round(Math.Cos(rad) * r);
            int y = cy + (int)Math.Round(Math.Sin(rad) * r);
            if (i > 0) { TurnLine(px, py, x, y, direction, color, thickness); }
            px = x; py = y;
        }
    }

    void BeltLane(ForgeWorld w, int direction) {
        TurnRect(0, 7, 32, 21, direction, 0x80232A28);
        TurnRect(0, 5, 32, 22, direction, 0xFF293738);
        TurnRect(0, 9, 32, 14, direction, 0xFF182B2D);
        TurnRect(0, 5, 32, 3, direction, 0xFF9F966E);
        TurnRect(0, 25, 32, 2, direction, 0xFF6A7058);
        int phase = w.tick % 8;
        for (int tx = phase; tx < 32; tx = tx + 8) {
            TurnRect(tx, 10, 1, 12, direction, 0xFF415353);
        }
        int chevron = (w.tick / 2) % 16;
        Arrow(chevron, 16, direction, 0xFFA8A66C); Arrow(chevron + 16, 16, direction, 0xFFA8A66C);
        TurnRect(2, 5, 3, 2, direction, 0xFFDBBA70);
    }
    void Drill(ForgeWorld w, ForgeBuilding b, int direction) {
        Plate(0xFF74735C);
        Rect(8, 7, 16, 18, 0xFF253839);
        Line(6, 9, 25, 24, 0xFFD5AE63, 3);
        Line(6, 24, 25, 9, 0xFFAD8750, 3);
        Disc(16, 16, 9, 0xFF172B31);
        double angle = (b.efficiency > 0 || ghost) ? w.tick * 0.16 : 0.4;
        for (int tooth = 0; tooth < 4; tooth = tooth + 1) {
            double theta = angle + tooth * 1.57079632679;
            int dx = (int)Math.Round(Math.Cos(theta) * 7.0);
            int dy = (int)Math.Round(Math.Sin(theta) * 7.0);
            Line(16 + dx / 3, 16 + dy / 3, 16 + dx, 16 + dy, 0xFFBACAC0, 3);
        }
        Disc(16, 16, 3, 0xFF6DD4BC);
        TurnRect(27, 12, 5, 8, direction, 0xFF1E3133);
        Arrow(31, 16, direction, 0xFFE0B263);
    }
    void Router(ForgeBuilding b, int direction) {
        Plate(0xFF7E7354);
        for (int d = 0; d < 4; d = d + 1) { TurnRect(23, 12, 9, 8, d, 0xFF293B3B); }
        Disc(16, 16, 8, 0xFFB4985E);
        Disc(16, 16, 5, 0xFF253C3F);
        Line(12, 16, 20, 16, 0xFFE3CE8A, 2); Line(16, 12, 16, 20, 0xFFE3CE8A, 2);
        Arrow(29, 16, direction, 0xFFF0BE64);
        Arrow(29, 16, (direction + 1) % 4, 0xFF7CADA0);
        Arrow(29, 16, (direction + 3) % 4, 0xFF7CADA0);
        Disc(16, 16, 2, b.roundRobin % 2 == 0 ? 0xFFFFD78B : 0xFFE8B96A);
    }
    void Furnace(ForgeWorld w, ForgeBuilding b, int direction) {
        Plate(0xFF6F6260);
        Rect(7, 6, 18, 19, 0xFF232D34);
        Rect(10, 8, 12, 14, 0xFF59383A);
        bool active = b.efficiency > 0 && b.progress > 0;
        if (active || ghost) {
            Glow(16, 15, 19, 0xFFE8A062, 60);
            Rect(11, 10, 10, 10, 0xFFD37648);
            Rect(13, 12, 6, 6, 0xFFFFD997);
            Line(9, 9, 13, 13 + w.tick % 3, 0xFFE8EDBA, 1);
            Line(24, 9, 19, 14, 0xFFE8EDBA, 1);
        } else { Rect(12, 11, 8, 8, 0xFF8B5844); }
        Rect(5, 7, 4, 17, 0xFF9AA397); Rect(23, 7, 4, 17, 0xFF9AA397);
        Rect(5, 10, 4, 3, 0xFF444D4F); Rect(23, 10, 4, 3, 0xFF444D4F);
        Rect(7, 25, 18, 3, 0xFFC29658);
        TurnRect(27, 12, 5, 8, direction, 0xFF314244);
        Arrow(31, 16, direction, 0xFFDFC18A);
    }
    void Assembler(ForgeWorld w, ForgeBuilding b, int direction) {
        Plate(0xFF526B70);
        Rect(8, 8, 16, 16, 0xFF20363F);
        Frame(10, 10, 12, 12, 0xFF82C6C4, 1);
        Rect(13, 12, 7, 8, b.progress > 0 ? 0xFF9DE2D4 : 0xFF507C83);
        Line(13, 12, 19, 18, 0xFFDBF1DF, 1);
        int slide = b.progress > 0 && b.efficiency > 0 ? (w.tick / 3) % 6 : 2;
        Rect(6, 6, 4, 8 + slide, 0xFFB7B792);
        Rect(8, 11 + slide, 7, 3, 0xFFD0C9A1);
        Rect(22, 18 - slide, 4, 9, 0xFF9CAAAA);
        Rect(17, 18 - slide, 8, 3, 0xFFCDCEA8);
        Rect(7, 26, 18, 2, b.water > 0 ? 0xFF73C6C1 : 0xFF344B55);
        TurnRect(27, 12, 5, 8, direction, 0xFF283F44);
        Arrow(31, 16, direction, 0xFFBBDCCE);
    }
    void Generator(ForgeWorld w, ForgeBuilding b) {
        Plate(0xFF74785C);
        Rect(8, 6, 16, 20, 0xFF263B3C);
        Rect(10, 7, 12, 18, 0xFFB58E52);
        for (int i = 0; i < 4; i = i + 1) {
            Rect(7, 8 + i * 5, 18, 2, 0xFFD0B878);
            Rect(7, 10 + i * 5, 3, 2, 0xFF5C7367);
        }
        int pulse = (w.tick / 6) % 3;
        Rect(14, 7, 4, 19, b.fuelTicks > 0 ? 0xFFACEDBC : 0xFF80BCA4);
        Rect(14, 10 + pulse * 5, 4, 3, 0xFFE1F0BE);
        Rect(26, 10, 3, 12, 0xFF283B3D);
        Rect(26, 12, 3, 3, 0xFF7FE0C1);
    }
    void Battery(ForgeBuilding b) {
        Plate(0xFF5B7268);
        Rect(8, 5, 5, 3, 0xFFCCBD8F); Rect(19, 5, 5, 3, 0xFFCCBD8F);
        Rect(7, 9, 18, 15, 0xFF1F3439);
        int charge = (int)Math.Min(4.0, b.energy / 3000000.0);
        for (int i = 0; i < 4; i = i + 1) {
            Rect(9 + i * 4, 11, 3, 10, i < charge ? 0xFF9FD9A7 : 0xFF43584D);
            if (i < charge) { Rect(9 + i * 4, 11, 3, 2, 0xFFD4EDB5); }
        }
        Line(11, 26, 21, 26, 0xFFB4AB70, 2);
    }
    void Core(ForgeWorld w) {
        int pulse = (w.tick / 5) % 12;
        if (pulse > 6) { pulse = 12 - pulse; }
        Glow(16, 16, 44 + pulse * 2, 0xFFE9B45F, 66);
        Glow(16, 16, 24, 0xFFFFD98F, 60);
        Ring(16, 16, 22, 0x606EC7B8, 1);
        Plate(0xFF947C52);
        Rect(7, 5, 18, 22, 0xFF273B3F);
        Rect(5, 9, 22, 14, 0xFF273B3F);
        Ring(16, 16, 10, 0xFFBE985A, 3);
        Sector(16, 16, 8, 10, w.tick % 360, w.tick % 360 + 105, 0xFFB6E8CF);
        Disc(16, 16, 6, 0xFFEDA65B);
        Disc(15, 15, 4, 0xFFFFDA8F);
        Disc(15, 14, 2, 0xFFFFF2C1);
        Rect(13, 2, 6, 4, 0xFFC6B180); Rect(13, 26, 6, 4, 0xFFC6B180);
        Rect(2, 13, 4, 6, 0xFF7CC6B4); Rect(26, 13, 4, 6, 0xFF7CC6B4);
    }
    void Wall(ForgeWorld w, int cell, ForgeBuilding b) {
        Rect(2, 5, 30, 27, 0x80262A25);
        Rect(1, 1, 30, 28, 0xFF303D3B);
        Rect(2, 2, 28, 23, 0xFF92947A);
        Rect(4, 4, 24, 17, 0xFFA0A089);
        Line(4, 4, 27, 4, 0xFFD0C6A0, 1);
        Rect(2, 24, 28, 5, 0xFF626E59);
        for (int d = 0; d < 4; d = d + 1) {
            int other = w.Neighbor(cell, d);
            if (!ghost && other >= 0 && w.buildings[other].kind == BlockKind.Wall) {
                TurnRect(27, 7, 5, 17, d, 0xFF92947A);
            } else { TurnLine(28, 7, 28, 23, d, 0xFF596754, 1); }
        }
        Line(12, 5, 12, 19, 0xFF79856D, 1);
        Line(12, 13, 27, 13, 0xFF79856D, 1);
        if (b.hp > 0 && b.hp < w.catalog.blocks[(int)BlockKind.Wall].hp / 2 && !ghost) {
            Line(21, 3, 17, 11, 0xFF394C44, 2); Line(17, 11, 20, 18, 0xFF394C44, 1);
        }
    }
    void Pump(ForgeWorld w, ForgeBuilding b, bool oil) {
        Plate(oil ? 0xFF635A69 : 0xFF557F79);
        Rect(4, 13, 24, 7, oil ? 0xFF312B40 : 0xFF23454D);
        Disc(16, 16, 10, 0xFF243941);
        Ring(16, 16, 8, oil ? 0xFFB49BBB : 0xFF9CCABC, 2);
        if (oil) {
            Line(8, 24, 16, 8, 0xFFA3ACA0, 3);
            Line(24, 24, 16, 8, 0xFF6D8B80, 3);
            int bob = b.efficiency > 0 ? (w.tick / 5) % 4 : 1;
            Line(8, 9 + bob, 26, 7 - bob, 0xFFDCB97A, 3);
            Line(25, 8 - bob, 25, 22, 0xFFDBBD91, 1);
            Disc(16, 10, 2, 0xFFE5CEA2);
        } else {
            int angle = b.efficiency > 0 ? (w.tick * 5) % 360 : 20;
            Sector(16, 16, 2, 7, angle, angle + 90, 0xFF78C9C0);
            Sector(16, 16, 2, 7, angle + 180, angle + 270, 0xFF78C9C0);
            Disc(16, 16, 2, 0xFFE0DDAD);
        }
    }
    bool FluidBlock(BlockKind kind) {
        return kind == BlockKind.Pipe || kind == BlockKind.Pump || kind == BlockKind.OilPump ||
            kind == BlockKind.Generator || kind == BlockKind.Furnace || kind == BlockKind.Assembler || kind == BlockKind.Turret;
    }
    void Pipe(ForgeWorld w, int cell, ForgeBuilding b) {
        for (int d = 0; d < 4; d = d + 1) {
            int other = w.Neighbor(cell, d);
            if (ghost || (other >= 0 && FluidBlock(w.buildings[other].kind))) {
                TurnRect(14, 10, 18, 15, d, 0x70232F30);
                TurnRect(14, 9, 18, 13, d, 0xFF3B5454);
                TurnRect(16, 11, 16, 3, d, b.water > 0 ? 0xFF68BEB5 : 0xFF617C72);
                TurnRect(16, 17, 16, 3, d, b.oil > 0 ? 0xFFAF86BE : 0xFF626570);
                TurnRect(25, 9, 3, 13, d, 0xFF9A9F86);
            }
        }
        Rect(9, 9, 14, 14, 0xFF263F43);
        Frame(10, 10, 12, 12, 0xFF9AA998, 2);
        Rect(13, 12, 6, 3, b.water > 0 ? 0xFF85D9C8 : 0xFF4E6A65);
        Rect(13, 17, 6, 3, b.oil > 0 ? 0xFFB797CB : 0xFF5A5A69);
    }
    void Relay(ForgeWorld w, ForgeBuilding b) {
        Rect(10, 12, 18, 18, 0x60222C2B);
        Disc(16, 19, 10, 0xFF354B49);
        Ring(16, 19, 8, 0xFF9B9675, 2);
        Rect(13, 7, 6, 15, 0xFF839888);
        Line(9, 8, 23, 8, 0xFFD1C69B, 3);
        Line(9, 8, 9, 14, 0xFF354B4D, 2); Line(23, 8, 23, 14, 0xFF354B4D, 2);
        Disc(9, 6, 3, b.network >= 0 ? 0xFF8FD9C1 : 0xFFAB8E58);
        Disc(23, 6, 3, b.network >= 0 ? 0xFF8FD9C1 : 0xFFAB8E58);
        if (b.network >= 0 && w.tick % 60 < 20) { Line(11, 5, 21, 5, 0x9093D8BF, 1); }
    }

    int Aim(ForgeWorld w, int cell, bool priority, bool antiAir) {
        int slot = cell % 1024;
        if (aimCell[slot] != cell) { aimCell[slot] = cell; aimTarget[slot] = -1; aimTick[slot] = -1; }
        int previous = aimTarget[slot];
        if (previous >= 0 && (!w.enemies[previous].active || w.enemies[previous].generation != aimGeneration[slot])) { aimTarget[slot] = -1; }
        if (w.enemyCount == 0) { aimTarget[slot] = -1; return -1; }
        // 核心契约与语义定义。
        bool due = aimTick[slot] < 0 || aimTick[slot] > w.tick || w.tick - aimTick[slot] >= 7;
        if (due && (priority || aimBudget > 0)) {
            aimBudget = aimBudget - 1;
            aimTick[slot] = w.tick;
            int wx = ForgeGrid.Center(cell % w.width); int wy = ForgeGrid.Center(cell / w.width);
            double range = TurretRange(w) * 1000.0;
            double nearest = range * range;
            int target = -1;
            for (int i = 0; i < w.enemies.Length; i = i + 1) {
                ForgeEnemy e = w.enemies[i];
                if (!e.active) { continue; }
                if (!antiAir && e.kind == 3) { continue; }
                double dx = e.x - wx; double dy = e.y - wy;
                double distance = dx * dx + dy * dy;
                if (distance <= nearest) { nearest = distance; target = i; }
            }
            aimTarget[slot] = target;
            if (target >= 0) { aimGeneration[slot] = w.enemies[target].generation; }
        }
        return aimTarget[slot];
    }
    // 把炮塔身管方向解析成单位向量：锁定目标时朝目标，否则朝安置朝向。
    void AimVector(ForgeWorld w, int cell, int direction, bool antiAir) {
        aimDX = ForgeGrid.Dx(direction); aimDY = ForgeGrid.Dy(direction);
        if (ghost) { return; }
        int target = Aim(w, cell, false, antiAir);
        if (target < 0) { return; }
        double dx = w.enemies[target].x - ForgeGrid.Center(cell % w.width);
        double dy = w.enemies[target].y - ForgeGrid.Center(cell / w.width);
        double distance = Math.Sqrt(dx * dx + dy * dy);
        if (distance > 0.0) { aimDX = dx / distance; aimDY = dy / distance; }
    }
    double aimDX;
    double aimDY;
    bool Weapon(BlockKind kind) {
        return ForgeCombat.TurretFamily(kind) || kind == BlockKind.Prism;
    }
    void Turret(ForgeWorld w, int cell, ForgeBuilding b, int direction) {
        if (b.kind == BlockKind.Scatter) { ScatterTurret(w, cell, b, direction); return; }
        if (b.kind == BlockKind.Sniper) { SniperTurret(w, cell, b, direction); return; }
        if (b.kind == BlockKind.Mortar) { MortarTurret(w, cell, b, direction); return; }
        Plate(0xFF6E7970);
        Disc(16, 17, 10, 0xFF1E3138);
        Ring(16, 16, 8, 0xFFB5A579, 2);
        AimVector(w, cell, direction, true);
        double dx = aimDX; double dy = aimDY;
        int muzzleX = 16 + (int)Math.Round(dx * 16.0); int muzzleY = 16 + (int)Math.Round(dy * 16.0);
        int breechX = 16 - (int)Math.Round(dx * 4.0); int breechY = 16 - (int)Math.Round(dy * 4.0);
        Line(breechX + 2, breechY + 3, muzzleX + 2, muzzleY + 3, 0x70222D2C, 7);
        Line(breechX, breechY, muzzleX, muzzleY, 0xFF172D36, 7);
        Line(breechX - 1, breechY - 1, muzzleX - 1, muzzleY - 1, 0xFFB9BC97, 4);
        Line(16, 16, muzzleX, muzzleY, 0xFF617E7B, 2);
        Disc(15, 15, 5, 0xFF85988A);
        Disc(14, 14, 2, b.stock.Get(0) + b.stock.Get(1) > 0 ? 0xFFCBDBA3 : 0xFFC88E56);
        Line(muzzleX - (int)Math.Round(dy * 3.0), muzzleY + (int)Math.Round(dx * 3.0),
            muzzleX + (int)Math.Round(dy * 3.0), muzzleY - (int)Math.Round(dx * 3.0), 0xFF2C484F, 2);
    }
    // 苍穹散射：双管并排，管身短粗，弹色偏铜。
    void ScatterTurret(ForgeWorld w, int cell, ForgeBuilding b, int direction) {
        Plate(0xFF6B6458);
        Disc(16, 17, 10, 0xFF2A2620);
        Ring(16, 16, 8, 0xFFC0925E, 2);
        AimVector(w, cell, direction, true);
        double dx = aimDX; double dy = aimDY;
        int muzzleX = 16 + (int)Math.Round(dx * 15.0); int muzzleY = 16 + (int)Math.Round(dy * 15.0);
        int breechX = 16 - (int)Math.Round(dx * 3.0); int breechY = 16 - (int)Math.Round(dy * 3.0);
        int sideX = (int)Math.Round(-dy * 3.0); int sideY = (int)Math.Round(dx * 3.0);
        Line(breechX + sideX + 2, breechY + sideY + 2, muzzleX + sideX, muzzleY + sideY, 0x70222818, 5);
        Line(breechX + sideX, breechY + sideY, muzzleX + sideX, muzzleY + sideY, 0xFF332B1E, 5);
        Line(breechX - sideX + 2, breechY - sideY + 2, muzzleX - sideX, muzzleY - sideY, 0xFF332B1E, 5);
        Line(breechX + sideX - 1, breechY + sideY - 1, muzzleX + sideX - 1, muzzleY + sideY - 1, 0xFFC9A05E, 2);
        Disc(16, 16, 5, 0xFF9A8A66);
        Disc(15, 15, 2, b.stock.Get(0) + b.stock.Get(1) > 0 ? 0xFFE8B06A : 0xFFC88E56);
    }
    // 穿云狙炮：细长身管伸出格外一截，镜筒高光。
    void SniperTurret(ForgeWorld w, int cell, ForgeBuilding b, int direction) {
        Plate(0xFF5F6E74);
        Disc(16, 17, 10, 0xFF16222E);
        Ring(16, 16, 8, 0xFF8FA9C9, 2);
        AimVector(w, cell, direction, true);
        double dx = aimDX; double dy = aimDY;
        int muzzleX = 16 + (int)Math.Round(dx * 19.0); int muzzleY = 16 + (int)Math.Round(dy * 19.0);
        int breechX = 16 - (int)Math.Round(dx * 6.0); int breechY = 16 - (int)Math.Round(dy * 6.0);
        Line(breechX + 1, breechY + 2, muzzleX + 1, muzzleY + 2, 0x70162028, 4);
        Line(breechX, breechY, muzzleX, muzzleY, 0xFF10202C, 4);
        Line(breechX, breechY, muzzleX, muzzleY, 0xFF9FB8C9, 1);
        Line(16 - (int)Math.Round(dx * 2.0), 16 - (int)Math.Round(dy * 2.0),
            16 + (int)Math.Round(dx * 8.0), 16 + (int)Math.Round(dy * 8.0), 0xFFD7E5EE, 1);
        Disc(16 - (int)Math.Round(dx * 8.0) - (int)Math.Round(dy * 4.0),
            16 - (int)Math.Round(dy * 8.0) + (int)Math.Round(dx * 4.0), 2, 0xFF9DE8E0);
        Disc(16, 16, 4, 0xFF6F8899);
        Disc(16, 16, 2, b.stock.Get(1) > 0 ? 0xFFC7D9EC : 0xFFC88E56);
    }
    // 崩地臼炮：粗短仰角筒口，宽基座；身管只对地目标转动。
    void MortarTurret(ForgeWorld w, int cell, ForgeBuilding b, int direction) {
        Plate(0xFF716A56);
        Disc(16, 16, 12, 0xFF2C281E);
        Ring(16, 16, 9, 0xFFB59F6A, 2);
        AimVector(w, cell, direction, false);
        double dx = aimDX; double dy = aimDY;
        int muzzleX = 16 + (int)Math.Round(dx * 10.0); int muzzleY = 16 + (int)Math.Round(dy * 10.0);
        int breechX = 16 - (int)Math.Round(dx * 3.0); int breechY = 16 - (int)Math.Round(dy * 3.0);
        Line(breechX + 2, breechY + 2, muzzleX + 2, muzzleY + 2, 0x70221E12, 9);
        Line(breechX, breechY, muzzleX, muzzleY, 0xFF2E2A1C, 9);
        Line(breechX - 1, breechY - 1, muzzleX - 1, muzzleY - 1, 0xFF8F7F5A, 3);
        Disc(muzzleX, muzzleY, 4, 0xFF17140D);
        Disc(muzzleX - 1, muzzleY - 1, 2, b.stock.Get(2) > 0 ? 0xFFD9C48A : 0xFF6E6448);
        for (int bolt = 0; bolt < 4; bolt = bolt + 1) {
            double theta = bolt * 1.57079632679 + 0.78539816339;
            Line(16 + (int)Math.Round(Math.Cos(theta) * 7.0), 16 + (int)Math.Round(Math.Sin(theta) * 7.0),
                16 + (int)Math.Round(Math.Cos(theta) * 11.0), 16 + (int)Math.Round(Math.Sin(theta) * 11.0), 0xFF6E6248, 2);
        }
    }
    // 铁蜂机巢：起降坪 + 组装坞；备料组装时指示灯闪烁并亮进度弧，满编待机。
    void DroneFab(ForgeWorld w, ForgeBuilding b) {
        Plate(0xFF66745E);
        Rect(6, 6, 20, 20, 0xFF22343A);
        Ring(16, 16, 10, 0xFF8FA08A, 2);
        Line(12, 12, 12, 20, 0xFF9FB39B, 2);
        Line(20, 12, 20, 20, 0xFF9FB39B, 2);
        Line(12, 16, 20, 16, 0xFF9FB39B, 2);
        bool ready = b.stock.Get(0) >= 8 && b.stock.Get(1) >= 5 && b.stock.Get(3) >= 4;
        bool capped = w.ActiveUnits() >= ForgeGrid.DroneLimit();
        bool busy = !ghost && b.efficiency > 0 && ready && !capped;
        if (busy) { Glow(16, 16, 20, 0xFF9DE8CA, 42); }
        Rect(23, 4, 3, 3, busy && (w.tick / 8) % 2 == 0 ? 0xFF9DE8CA : 0xFF3E5C55);
        int deg = ForgeGrid.Min(359, b.progress * 360 / 300000);
        if (deg > 0) { Sector(16, 16, 11, 13, -90, -90 + deg, 0xFFB7F2D8); }
    }
    // 棱镜聚焦塔：悬浮水晶棱柱，通电锁定时棱面过载发光；光束本体在 Beams 画。
    void PrismTower(ForgeWorld w, int cell, ForgeBuilding b, int direction) {
        Plate(0xFF5E6A80);
        Disc(16, 17, 10, 0xFF1C2438);
        Ring(16, 16, 8, 0xFF8E9CC4, 2);
        AimVector(w, cell, direction, true);
        double dx = aimDX; double dy = aimDY;
        bool hot = !ghost && b.efficiency > 0 && w.enemyCount > 0;
        if (hot) { Glow(16, 14, 18, 0xFFCF8AF2, 55); }
        int bob = ((w.tick / 3 + cell) % 4) - 2;
        int cy = 14 + bob;
        Line(16, cy - 8, 22, cy, 0xFFB9A8E8, 2);
        Line(22, cy, 16, cy + 8, 0xFF8F7CC9, 2);
        Line(16, cy + 8, 10, cy, 0xFF8F7CC9, 2);
        Line(10, cy, 16, cy - 8, 0xFFB9A8E8, 2);
        Line(16, cy - 8, 16, cy + 8, hot ? 0xFFF2E4FF : 0xFFD9CCF5, 1);
        int ringX = 16 + (int)Math.Round(dx * 9.0);
        int ringY = cy + (int)Math.Round(dy * 9.0);
        Ring(ringX, ringY, 3, hot ? 0xFFE8CFF5 : 0xFF7C86A8, 1);
        Disc(16, cy, 2, hot ? 0xFFF2E4FF : 0xFFB9A8E8);
    }
    // 修复投影：绿色医疗十字悬于发射环上，通电修复时十字呼吸发光、外环扫掠。
    void RepairTower(ForgeWorld w, int cell, ForgeBuilding b) {
        Plate(0xFF5E7A66);
        Disc(16, 17, 10, 0xFF18291E);
        Ring(16, 16, 8, 0xFF9BCAA0, 2);
        bool on = !ghost && b.efficiency > 0;
        if (on) { Glow(16, 13, 16, 0xFF9DE8B0, 40); }
        int sweep = (w.tick / 2 + cell) % 360;
        if (on) { Sector(16, 16, 10, 12, sweep, sweep + 80, 0x669DE8B0); }
        int bob = ((w.tick / 4 + cell) % 4) - 2;
        int cy = 13 + bob;
        Line(16, cy - 6, 16, cy + 6, 0xFFBDE8C4, 3);
        Line(10, cy, 22, cy, 0xFFBDE8C4, 3);
        Line(16, cy - 6, 16, cy + 6, on ? 0xFFE9FFF0 : 0xFF8FBF9A, 1);
        Line(10, cy, 22, cy, on ? 0xFFE9FFF0 : 0xFF8FBF9A, 1);
        Disc(16, 21, 3, 0xFF3E5C4A);
    }
    // 过护投影：琥珀转子加速旋转化作过载光轮，通电时中央迸发辉光。
    void OverdriveTower(ForgeWorld w, int cell, ForgeBuilding b) {
        Plate(0xFF7A6A5E);
        Disc(16, 17, 10, 0xFF2A2118);
        Ring(16, 16, 8, 0xFFE0A85E, 2);
        bool on = !ghost && b.efficiency > 0;
        int spin = (w.tick / (on ? 1 : 3) + cell * 7) % 360;
        for (int vane = 0; vane < 3; vane = vane + 1) {
            int a = spin + vane * 120;
            double rad = a * 0.017453292519943295;
            int x1 = 16 + (int)Math.Round(Math.Cos(rad) * 4.0);
            int y1 = 13 + (int)Math.Round(Math.Sin(rad) * 4.0);
            int x2 = 16 + (int)Math.Round(Math.Cos(rad) * 9.0);
            int y2 = 13 + (int)Math.Round(Math.Sin(rad) * 9.0);
            Line(x1, y1, x2, y2, on ? 0xFFF2B968 : 0xFF9A7C4E, 2);
        }
        if (on) { Glow(16, 13, 14, 0xFFF2C06A, 55); }
        Disc(16, 13, 3, on ? 0xFFFFE4B0 : 0xFF6E5A3E);
        Disc(16, 22, 3, 0xFF4E3E28);
    }
    // 力场护盾：青色发生器，盾值存续时整圈力场泡微光呼吸，破碎后只剩发生器本体。
    void ShieldTower(ForgeWorld w, int cell, ForgeBuilding b) {
        Plate(0xFF5E6E7A);
        Disc(16, 17, 10, 0xFF16222E);
        Ring(16, 16, 8, 0xFF7ECAEC, 2);
        bool on = !ghost && b.efficiency > 0;
        if (on) { Glow(16, 14, 14, 0xFF9DE4F2, 45); }
        Line(16, 7, 22, 14, 0xFF9DE4F2, 2);
        Line(22, 14, 16, 21, 0xFF9DE4F2, 2);
        Line(16, 21, 10, 14, 0xFF9DE4F2, 2);
        Line(10, 14, 16, 7, 0xFF9DE4F2, 2);
        Disc(16, 14, 2, on ? 0xFFE4F8FF : 0xFF5E8FA0);
        // 力场泡：半径与战斗判定同为 3 格圆；盾值归零后泡消失，只剩发生器。
        if (on && b.shield > 0) {
            Disc(16, 16, 96, 0x307ECAEC);
            Disc(16, 16, 64, 0x187ECAEC);
            int breathe = 96 - 2 + ((w.tick / 6) % 3);
            Ring(16, 16, breathe, 0xBB7ECAEC, 2);
            Ring(16, 16, 96, 0x557ECAEC, 1);
        }
    }
    void Building(ForgeWorld w, ForgeCamera camera, int cell, BlockKind kind, ForgeBuilding b, int direction) {
        AtCell(w, camera, cell);
        if (kind == BlockKind.Core) { Core(w); }
        else if (kind == BlockKind.Belt) { Belt(w, cell, direction); }
        else if (kind == BlockKind.Drill) { Drill(w, b, direction); }
        else if (kind == BlockKind.Router) { Router(b, direction); }
        else if (kind == BlockKind.Furnace) { Furnace(w, b, direction); }
        else if (kind == BlockKind.Assembler) { Assembler(w, b, direction); }
        else if (kind == BlockKind.Generator) { Generator(w, b); }
        else if (kind == BlockKind.Battery) { Battery(b); }
        else if (ForgeCombat.TurretFamily(kind)) { Turret(w, cell, b, direction); }
        else if (kind == BlockKind.DroneFab) { DroneFab(w, b); }
        else if (kind == BlockKind.Prism) { PrismTower(w, cell, b, direction); }
        else if (kind == BlockKind.Repair) { RepairTower(w, cell, b); }
        else if (kind == BlockKind.Overdrive) { OverdriveTower(w, cell, b); }
        else if (kind == BlockKind.Shield) { ShieldTower(w, cell, b); }
        else if (kind == BlockKind.Wall) { Wall(w, cell, b); }
        else if (kind == BlockKind.Pump) { Pump(w, b, false); }
        else if (kind == BlockKind.OilPump) { Pump(w, b, true); }
        else if (kind == BlockKind.Pipe) { Pipe(w, cell, b); }
        else if (kind == BlockKind.Relay) { Relay(w, b); }
        if (!ghost && kind != BlockKind.Empty && w.catalog.blocks[(int)kind].powerUse > 0) {
            int status = b.efficiency >= 1000 ? 0xFF8EDDAD : (b.efficiency > 0 ? 0xFFE2BB6F : 0xFFDC805F);
            Rect(23, 24, 4, 2, 0xFF1E3033); Rect(24, 24, 2, 2, status);
        }
    }
    void Cargo(ForgeWorld w, ForgeCamera camera, int cell) {
        ForgeBuilding b = w.buildings[cell];
        int dx = ForgeGrid.Dx(b.direction); int dy = ForgeGrid.Dy(b.direction);
        // 弯道格（有侧向带进料且无直进）上的货物沿衔接弧走，不再切弯。
        bool corner = false;
        bool fromNorth = false;
        if (b.kind == BlockKind.Belt) {
            bool left = SideFed(w, cell, (b.direction + 3) % 4);
            bool right = SideFed(w, cell, (b.direction + 1) % 4);
            corner = (left || right) && !SideFed(w, cell, (b.direction + 2) % 4);
            fromNorth = left;
        }
        for (int slot = 0; slot < b.cargo.Length; slot = slot + 1) {
            if (b.cargo[slot] <= 0) { continue; }
            // 核心契约与语义定义。
            int travel = ForgeGrid.Max(0, ForgeGrid.Min(999, b.travel[slot]));
            int px; int py;
            if (corner && travel < 999) {
                double rad = (180 + (fromNorth ? -90 : 90) * travel / 999) * 0.017453292519943295;
                int lx = 32 + (int)Math.Round(Math.Cos(rad) * 16);
                int ly = (fromNorth ? 0 : 32) + (int)Math.Round(Math.Sin(rad) * 16);
                int rx = RotX(lx, ly, b.direction); int ry = RotY(lx, ly, b.direction);
                px = camera.ScreenX((cell % w.width) * 1000 + rx * 1000 / 32);
                py = camera.ScreenY((cell / w.width) * 1000 + ry * 1000 / 32);
            } else {
                int wx = ForgeGrid.Center(cell % w.width) + dx * (travel - 500);
                int wy = ForgeGrid.Center(cell / w.width) + dy * (travel - 500);
                px = camera.ScreenX(wx); py = camera.ScreenY(wy);
            }
            int size = ForgeGrid.Max(3, (int)Math.Round(6.0 * camera.zoom));
            int edge = ForgeGrid.Max(1, (int)Math.Round(camera.zoom));
            int half = size / 2;
            canvas.FillRect(px - half, py - half + edge, size + edge, size + edge, 0xC018292D);
            canvas.FillRect(px - half, py - half, size, size, ItemColor(b.cargo[slot] - 1));
            canvas.FillRect(px - half, py - half, size - edge, edge, 0xFFDCE2C8);
            if (b.cargo[slot] == 3 && size >= 4) {
                canvas.DrawLine(px - half, py + half - 1, px + half - 1, py - half + 1, 0xFF384651, 1);
            }
        }
    }

    void Health(ForgeCamera camera, int px, int py, int width, int hp, int maxHp, int color) {
        if (maxHp <= 0) { return; }
        int fill = (int)(width * Math.Max(0.0, Math.Min(1.0, hp / (double)maxHp)));
        int height = ForgeGrid.Max(2, (int)Math.Round(camera.zoom * 2.0));
        canvas.FillRect(px - width / 2 - 1, py - 1, width + 2, height + 2, 0xDD17282D);
        canvas.FillRect(px - width / 2, py, width, height, 0xFF534D42);
        if (fill > 0) { canvas.FillRect(px - width / 2, py, fill, height, color); }
    }
    void Enemy(ForgeWorld w, ForgeCamera camera, ForgeEnemy e, int index) {
        int px = camera.ScreenX(e.x); int py = camera.ScreenY(e.y);
        double size = e.kind == 2 ? 1.6 : e.kind == 3 ? 0.95 : e.kind == 4 ? 0.72 : (e.kind == 1 ? 1.0 : 0.7);
        scale = camera.zoom * size;
        if (!Visible(camera, px, py, Stroke(23))) { return; }
        originX = px - S(16); originY = py - S(16);
        int centerX = ForgeGrid.Center(w.coreCell % w.width); int centerY = ForgeGrid.Center(w.coreCell / w.width);
        double angle = Math.Atan2(centerY - e.y, centerX - e.x);
        double forwardX = Math.Cos(angle); double forwardY = Math.Sin(angle);
        double sideX = -forwardY; double sideY = forwardX;
        if (e.kind == 3) {
            // 掠翼飞虫：悬停浮沉 + 双翼扑扇 + 地面投影，读作“空中单位”。
            int bob = ((w.tick / 2 + index * 3) % 6) - 3;
            Disc(16, 24, 8, 0x38151311);
            int lift = bob - 4;
            int flap = (w.tick / 2 + index) % 2 == 0 ? 1 : -1;
            for (int wing = -1; wing <= 1; wing = wing + 2) {
                int rootX = 16 + (int)Math.Round(sideX * 3.0 * wing);
                int rootY = 16 + lift + (int)Math.Round(sideY * 3.0 * wing);
                int tipX = rootX + (int)Math.Round(sideX * 14.0 * wing) - (int)Math.Round(forwardX * 3.0);
                int tipY = rootY + (int)Math.Round(sideY * 14.0 * wing) - (int)Math.Round(forwardY * 3.0) + flap * 2;
                Line(rootX, rootY, tipX, tipY, 0xFF8FA3BC, 3);
                Line(tipX, tipY, tipX - (int)Math.Round(sideX * 4.0 * wing), tipY - flap * 3, 0xFF5E6E84, 2);
                Line(tipX, tipY, rootX + (int)Math.Round(forwardX * 4.0), rootY + (int)Math.Round(forwardY * 4.0), 0xB0A8BAD0, 1);
            }
            Disc(16, 16 + lift, 7, 0xFF37313E);
            Sector(16, 15 + lift, 0, 6, 190, 320, 0xFF8E93AC);
            Sector(16, 15 + lift, 0, 6, 0, 190, 0xFF5C5F76);
            int head3X = 16 + (int)Math.Round(forwardX * 5.0); int head3Y = 15 + lift + (int)Math.Round(forwardY * 5.0);
            Disc(head3X, head3Y, 3, 0xFF453D52);
            Line(head3X - (int)Math.Round(sideX), head3Y - (int)Math.Round(sideY),
                head3X - (int)Math.Round(forwardX * 3.0), head3Y - (int)Math.Round(forwardY * 3.0), 0xFFD9A05A, 1);
            if (e.hp < e.maxHp) { Health(camera, px, py - Stroke(19), Stroke(22), e.hp, e.maxHp, 0xFFB7AED8); }
            return;
        }
        if (e.kind == 4) {
            // 灰烬奔兽：低伏细长躯干四足疾奔，腹腔熔火提示“自爆体”。
            int gait4 = (w.tick / 2 + index * 5) % 6;
            if (gait4 > 3) { gait4 = 6 - gait4; }
            for (int leg = 0; leg < 2; leg = leg + 1) {
                for (int side = -1; side <= 1; side = side + 2) {
                    double fore = (leg - 1) * 8.0;
                    double stride = (leg % 2 == 0 ? gait4 - 1 : 1 - gait4) * 2.5;
                    int rootX = 16 + (int)Math.Round(forwardX * fore + sideX * 3.0 * side);
                    int rootY = 16 + (int)Math.Round(forwardY * fore + sideY * 3.0 * side);
                    int footX = rootX + (int)Math.Round(forwardX * stride) - (int)Math.Round(forwardX * 2.0);
                    int footY = rootY + (int)Math.Round(forwardY * stride) - (int)Math.Round(forwardY * 2.0) + 5;
                    Line(rootX, rootY, footX, footY, 0xFF3A3038, 2);
                }
            }
            int deg = ((int)(angle * 57.29577951308) % 360 + 360) % 360;
            Sector(16, 16, 0, 7, deg + 150, deg + 210, 0xFF5A4438);
            Sector(16, 16, 0, 7, deg - 30, deg + 30, 0xFF6E5243);
            Disc(16, 16, 4, 0xFF33291F);
            Glow(16, 16, 9 + gait4, 0xFFE8703A, 90);
            int head4X = 16 + (int)Math.Round(forwardX * 7.0); int head4Y = 16 + (int)Math.Round(forwardY * 7.0);
            Disc(head4X, head4Y, 3, 0xFF2A211C);
            Disc(head4X, head4Y, 1, 0xFFFFC27A);
            if (e.hp < e.maxHp) { Health(camera, px, py - Stroke(17), Stroke(20), e.hp, e.maxHp, 0xFFE8A26A); }
            return;
        }
        int gait = (w.tick / 3 + index * 7) % 8;
        if (gait > 4) { gait = 8 - gait; }
        Disc(18, 21, 12, 0x60202B29);
        for (int leg = 0; leg < 3; leg = leg + 1) {
            for (int side = -1; side <= 1; side = side + 2) {
                double fore = (leg - 1) * 7.0;
                double stride = ((leg + index) % 2 == 0 ? gait - 2 : 2 - gait) * 1.0;
                int rootX = 16 + (int)Math.Round(forwardX * fore + sideX * 5.0 * side);
                int rootY = 16 + (int)Math.Round(forwardY * fore + sideY * 5.0 * side);
                int kneeX = 16 + (int)Math.Round(forwardX * (fore + stride - 2.0) + sideX * 12.0 * side);
                int kneeY = 16 + (int)Math.Round(forwardY * (fore + stride - 2.0) + sideY * 12.0 * side);
                int footX = kneeX - (int)Math.Round(forwardX * 5.0) + (int)Math.Round(sideX * 2.0 * side);
                int footY = kneeY - (int)Math.Round(forwardY * 5.0) + (int)Math.Round(sideY * 2.0 * side);
                Line(rootX, rootY, kneeX, kneeY, e.kind == 0 ? 0xFF513D40 : 0xFF36343F, 3);
                Line(kneeX, kneeY, footX, footY, e.kind == 0 ? 0xFFB58868 : 0xFFA49D98, 2);
            }
        }
        Disc(16, 16, 10, 0xFF312E39);
        Sector(16, 15, 0, 9, 190, 320, e.kind == 0 ? 0xFFAD7863 : 0xFF808189);
        Sector(16, 15, 0, 9, 320, 360, e.kind == 0 ? 0xFF79544F : 0xFF565767);
        Sector(16, 15, 0, 9, 0, 190, e.kind == 0 ? 0xFF79544F : 0xFF565767);
        if (e.kind >= 1) {
            for (int plate = -1; plate <= 1; plate = plate + 1) {
                int armorX = 16 + (int)Math.Round(forwardX * plate * 5.0);
                int armorY = 15 + (int)Math.Round(forwardY * plate * 5.0);
                Line(armorX - (int)Math.Round(sideX * 6.0), armorY - (int)Math.Round(sideY * 6.0),
                    armorX + (int)Math.Round(sideX * 6.0), armorY + (int)Math.Round(sideY * 6.0), 0xFFB4B1A3, 2);
            }
        }
        int headX = 16 + (int)Math.Round(forwardX * 8.0); int headY = 16 + (int)Math.Round(forwardY * 8.0);
        Disc(headX, headY, 5, e.kind == 2 ? 0xFF3A2D44 : 0xFF49353D);
        Disc(headX + (int)Math.Round(sideX * 2.0), headY + (int)Math.Round(sideY * 2.0), 1, 0xFFF8BC86);
        Disc(headX - (int)Math.Round(sideX * 2.0), headY - (int)Math.Round(sideY * 2.0), 1, 0xFFF8BC86);
        if (e.kind == 2) {
            Glow(16, 16, 18, 0xFFB888B3, 42);
            Disc(16, 15, 4, 0xFFBA7DA3); Disc(15, 14, 2, 0xFFF5C5CB);
            Ring(16, 16, 13, 0x80C7979D, 1);
        }
        if (e.hp < e.maxHp || e.kind == 2) {
            Health(camera, px, py - Stroke(19), Stroke(25), e.hp, e.maxHp, e.kind == 2 ? 0xFFD896B5 : 0xFFE1AD7B);
        }
    }
    // 敌巢：出兵口的肉瘤巢体，呼吸脉动；被拔除后留焦痕残骸。
    void Nests(ForgeWorld w, ForgeCamera camera) {
        for (int lane = 0; lane < w.nests.Length; lane = lane + 1) {
            ForgeNest n = w.nests[lane];
            int cell = w.Index(n.x, n.y);
            if (cell < 0) { continue; }
            AtCell(w, camera, cell);
            if (!Visible(camera, originX + S(16), originY + S(16), S(30))) { continue; }
            if (!n.active) {
                Rect(4, 10, 24, 16, 0x58201E1A);
                Rect(8, 12, 16, 10, 0x80140F0C);
                Rect(10, 6, 4, 4, 0x803A2E22);
                Rect(18, 20, 5, 3, 0x803A2E22);
                continue;
            }
            int pulse = (w.tick / 6 + lane * 3) % 8;
            if (pulse > 4) { pulse = 8 - pulse; }
            Glow(16, 16, 26 + pulse * 2, 0xFFD86A5A, 40);
            Disc(16, 17, 13, 0x90201A16);
            Disc(12, 13, 7, 0xFF6E4448);
            Disc(21, 14, 6, 0xFF5E3A40);
            Disc(16, 21, 6, 0xFF66404A);
            Disc(16, 15, 6, 0xFF7E5054);
            Disc(16, 16, 3, 0xFF2A181C);
            Ring(16, 16, 4 + pulse / 2, 0xFFC97A6A, 1);
            if (n.hp < n.maxHp) {
                Health(camera, camera.ScreenX(ForgeGrid.Center(n.x)), camera.ScreenY(n.y * 1000) - S(6),
                  ForgeGrid.Max(14, (int)(camera.zoom * 26.0)), n.hp, n.maxHp, 0xFFE58F7B);
            }
        }
    }
    // 铁蜂无人机：青色菱形机身 + 高频旋翼虚影，友军识别色；受损显血条。
    void Units(ForgeWorld w, ForgeCamera camera) {
        for (int i = 0; i < w.units.Length; i = i + 1) {
            ForgeUnit u = w.units[i];
            if (!u.active) { continue; }
            int px = camera.ScreenX(u.x); int py = camera.ScreenY(u.y);
            if (!Visible(camera, px, py, Stroke(20))) { continue; }
            scale = camera.zoom;
            originX = px - S(16); originY = py - S(16);
            int bob = ((w.tick / 2 + i * 5) % 6) - 3;
            Disc(16, 24, 7, 0x30181E20);
            int cy = 16 + bob - 3;
            Line(8, cy, 24, cy, 0x409DE8CA, 1);
            Line(16, cy - 8, 16, cy + 8, 0x409DE8CA, 1);
            Line(16, cy - 6, 21, cy, 0xFF7FD8C8, 2);
            Line(21, cy, 16, cy + 6, 0xFF4FA898, 2);
            Line(16, cy + 6, 11, cy, 0xFF4FA898, 2);
            Line(11, cy, 16, cy - 6, 0xFF7FD8C8, 2);
            Disc(16, cy, 2, 0xFFCFF5E8);
            if (u.hp < u.maxHp) { Health(camera, px, py - Stroke(12), Stroke(14), u.hp, u.maxHp, 0xFF8FD9C1); }
        }
    }
    // 棱镜光束：效率不足或无锁定即熄火；外晕/主束/白芯三层 + 端点光斑。
    void Beams(ForgeWorld w, ForgeCamera camera) {
        for (int cell = 0; cell < w.buildings.Length; cell = cell + 1) {
            ForgeBuilding b = w.buildings[cell];
            if (b.kind != BlockKind.Prism || b.hp <= 0 || b.efficiency <= 0 || w.enemyCount <= 0) { continue; }
            int target = Aim(w, cell, false, true);
            if (target < 0 || !w.enemies[target].active) { continue; }
            ForgeEnemy e = w.enemies[target];
            int x0 = camera.ScreenX(ForgeGrid.Center(cell % w.width));
            int y0 = camera.ScreenY(ForgeGrid.Center(cell / w.width));
            int x1 = camera.ScreenX(e.x);
            int y1 = camera.ScreenY(e.y);
            canvas.DrawLine(x0, y0, x1, y1, 0x50CF8AF2, ForgeGrid.Max(2, (int)Math.Round(7.0 * camera.zoom)));
            canvas.DrawLine(x0, y0, x1, y1, 0xC0B98AF2, ForgeGrid.Max(1, (int)Math.Round(3.0 * camera.zoom)));
            canvas.DrawLine(x0, y0, x1, y1, 0xFFF2E4FF, ForgeGrid.Max(1, (int)Math.Round(1.2 * camera.zoom)));
            Glow(x1, y1, ForgeGrid.Max(6, (int)Math.Round(10.0 * camera.zoom)), 0xFFCF8AF2, 70);
        }
    }
    void Bullets(ForgeWorld w, ForgeCamera camera) {
        int radius = ForgeGrid.Max(1, (int)Math.Round(camera.zoom * 2.0));
        for (int i = 0; i < w.bullets.Length; i = i + 1) {
            ForgeBullet bullet = w.bullets[i];
            if (!bullet.active) { continue; }
            int px = camera.ScreenX(bullet.x); int py = camera.ScreenY(bullet.y);
            if (!Visible(camera, px, py, radius * 5)) { continue; }
            int endX = px; int endY = py;
            if (bullet.target >= 0 && bullet.target < w.enemies.Length) {
                ForgeEnemy e = w.enemies[bullet.target];
                if (e.active && e.generation == bullet.generation) {
                    double dx = e.x - bullet.x; double dy = e.y - bullet.y;
                    double distance = Math.Sqrt(dx * dx + dy * dy);
                    if (distance > 0.0) {
                        endX = px - (int)Math.Round(dx / distance * camera.zoom * 8.0);
                        endY = py - (int)Math.Round(dy / distance * camera.zoom * 8.0);
                    }
                }
            }
            canvas.DrawLine(endX, endY, px, py, 0x90F3CB8B, ForgeGrid.Max(1, radius));
            canvas.FillCircle(px, py, radius + 1, 0xA0C88F5A);
            canvas.FillCircle(px, py, radius, 0xFFFFEDBF);
            Glow(px, py, radius * 5, 0xFFE8B06A, 46);
        }
    }

    void Effects(ForgeWorld w, ForgeCamera camera) {
        int fs = ForgeGrid.Max(9, (int)Math.Round(11.0 * camera.zoom));
        for (int i = 0; i < w.effects.Length; i = i + 1) {
            ForgeEffect e = w.effects[i];
            if (!e.active) { continue; }
            int px = camera.ScreenX(e.x); int py = camera.ScreenY(e.y);
            if (!Visible(camera, px, py, S(40))) { continue; }
            int alpha = ForgeGrid.Max(0, ForgeGrid.Min(255, e.life * 255 / ForgeGrid.Max(1, e.maxLife)));
            int tint = e.color & 0x00FFFFFF;
            if (e.kind == 0) {
                // 枪口焰：亮核 + 外圈，一拍即散。
                Glow(px, py, S(14), tint, alpha * 60 / 255);
                canvas.FillCircle(px, py, Stroke(e.size + 2), ((alpha * 220 / 255) << 24) | tint);
                canvas.FillCircle(px, py, ForgeGrid.Max(1, Stroke(e.size) / 2), ((alpha) << 24) | 0xFFFFF3CE);
            } else if (e.kind == 1) {
                // 火花：速度方向的短射线。
                int len = ForgeGrid.Max(2, e.size + 2);
                canvas.DrawLine(px, py, px - e.vx * len / 240, py - e.vy * len / 240 - 1, ((alpha) << 24) | tint, ForgeGrid.Max(1, Stroke(1)));
                canvas.FillCircle(px, py, ForgeGrid.Max(1, Stroke(e.size) / 2), ((alpha) << 24) | tint);
            } else if (e.kind == 2) {
                // 爆炸：扩张环 + 闪光核。
                int age = e.maxLife - e.life;
                int radius = Stroke(e.size + age * 3);
                Glow(px, py, radius + S(10), tint, alpha * 70 / 255);
                canvas.DrawCircle(px, py, radius, ((alpha * 200 / 255) << 24) | tint, ForgeGrid.Max(1, Stroke(2)));
                if (alpha > 120) { canvas.FillCircle(px, py, Stroke(e.size), ((alpha) << 24) | 0xFFFFE9B8); }
            } else if (e.kind == 3) {
                // 烟尘：渐大渐淡的灰团。
                int grow = (e.maxLife - e.life) / 4;
                canvas.FillCircle(px, py, Stroke(e.size + grow), ((alpha * 130 / 255) << 24) | tint);
            } else if (e.kind == 4) {
                // 浮动奖励：+N 随高度淡出。
                string text = "+" + Convert.ToString(e.value);
                canvas.DrawText(px - Canvas.MeasureText(text, fs) / 2, py, text, ((alpha) << 24) | tint, fs);
            }
        }
    }

    void Portals(ForgeWorld w, ForgeCamera camera) {
        for (int lane = 0; lane < 3; lane = lane + 1) {
            int cell = ForgeMap.SpawnCell(w, lane);
            if (cell < 0 || cell >= w.width * w.height) { continue; }
            int direction = lane == 0 ? 0 : (lane == 1 ? 1 : 2);
            int dx = ForgeGrid.Dx(direction); int dy = ForgeGrid.Dy(direction);
            for (int step = 1; step <= 4; step = step + 1) {
                int mark = w.Index(cell % w.width + dx * step, cell / w.width + dy * step);
                if (mark < 0) { continue; }
                AtCell(w, camera, mark);
                if (!Visible(camera, originX + S(16), originY + S(16), S(24))) { continue; }
                TurnLine(2, 7, 15, 7, direction, 0x407E7160, 1);
                TurnLine(2, 25, 15, 25, direction, 0x407E7160, 1);
                Arrow(18, 16, direction, w.waveActive ? 0xA0CF9070 : 0x60997F68);
            }
            AtCell(w, camera, cell);
            if (!Visible(camera, originX + S(16), originY + S(16), S(35))) { continue; }
            int spin = (w.tick / 2 + lane * 40) % 360;
            Glow(16, 16, 30, 0xFFC7828C, w.waveActive ? 55 : 25);
            Disc(16, 16, 18, 0xFF302C35);
            Ring(16, 16, 17, 0xFF765562, 2);
            for (int rim = 0; rim < 3; rim = rim + 1) {
                Sector(16, 16, 15, 17, spin + rim * 120, spin + rim * 120 + 68, w.waveActive ? 0xFFE1A5A5 : 0xFFAF818A);
            }
            Disc(16, 16, 11, 0xFF1F2630);
            TurnLine(8, 9, 14, 16, direction, 0xFFAD7A88, 2);
            TurnLine(14, 16, 8, 23, direction, 0xFFAD7A88, 2);
            TurnLine(18, 9, 24, 16, direction, 0xFFD1A19C, 2);
            TurnLine(24, 16, 18, 23, direction, 0xFFD1A19C, 2);
        }
    }
    void Range(ForgeWorld w, ForgeCamera camera, int cell, BlockKind kind, int color) {
        if (cell < 0 || cell >= w.width * w.height) { return; }
        int radius = 0;
        if (ForgeCombat.TurretFamily(kind) || kind == BlockKind.Prism) { radius = TurretRange(w); }
        if (kind == BlockKind.Repair || kind == BlockKind.Overdrive || kind == BlockKind.Shield) {
            radius = w.catalog.blocks[(int)kind].powerRadius;
        }
        if (radius <= 0) { return; }
        int px = camera.ScreenX(ForgeGrid.Center(cell % w.width));
        int py = camera.ScreenY(ForgeGrid.Center(cell / w.width));
        int size = (int)Math.Round(radius * ForgeGrid.TileSize() * camera.zoom);
        canvas.FillCircle(px, py, size, (color & 0x00FFFFFF) | 0x09000000);
        canvas.DrawCircle(px, py, size, (color & 0x00FFFFFF) | 0x85000000, 1);
        int notch = ForgeGrid.Max(3, (int)Math.Round(5.0 * camera.zoom));
        canvas.DrawLine(px - notch, py - size, px + notch, py - size, color, 1);
        canvas.DrawLine(px - notch, py + size, px + notch, py + size, color, 1);
        canvas.DrawLine(px - size, py - notch, px - size, py + notch, color, 1);
        canvas.DrawLine(px + size, py - notch, px + size, py + notch, color, 1);
    }
    void Power(ForgeWorld w, ForgeCamera camera, int cell, bool selected) {
        ForgeBuilding b = w.buildings[cell];
        BlockDef def = w.catalog.blocks[(int)b.kind];
        if (def.powerRadius <= 0) { return; }
        AtCell(w, camera, cell);
        int color = b.network >= 0 ? 0xFF83CFAE : 0xFFDBAA68;
        Rect(1, 1, 30, 30, (color & 0x00FFFFFF) | 0x18000000);
        Frame(1, 1, 30, 30, (color & 0x00FFFFFF) | 0x65000000, 1);
        if (selected) {
            Ring(16, 16, def.powerRadius * 32, (color & 0x00FFFFFF) | 0x65000000, 1);
        }
    }
    void Events(ForgeWorld w, ForgeCamera camera) {
        for (int i = 0; i < w.events.entries.Length; i = i + 1) {
            ForgeEvent effect = w.events.entries[i];
            int age = w.tick - effect.tick;
            if (effect.tick < 0 || age < 0 || age > 20 || effect.cell < 0 || effect.cell >= w.width * w.height) { continue; }
            if (effect.kind != ForgeEventKind.Built && effect.kind != ForgeEventKind.Removed && effect.kind != ForgeEventKind.EnemyKilled) { continue; }
            AtCell(w, camera, effect.cell);
            if (!Visible(camera, originX + S(16), originY + S(16), S(40))) { continue; }
            int alpha = (20 - age) * 8;
            int color = effect.kind == ForgeEventKind.EnemyKilled ? 0x00D0A488 : 0x00A6DAC0;
            if (effect.kind == ForgeEventKind.Removed) { color = 0x00D6B77B; }
            Ring(16, 16, 8 + age, color | (alpha << 24), 1);
            if (effect.kind == ForgeEventKind.EnemyKilled || effect.kind == ForgeEventKind.Removed) {
                for (int spark = 0; spark < 4; spark = spark + 1) {
                    int d = 5 + age;
                    int dx = ForgeGrid.Dx(spark); int dy = ForgeGrid.Dy(spark);
                    Line(16 + dx * d, 16 + dy * d, 16 + dx * (d + 3), 16 + dy * (d + 3), color | (alpha << 24), 1);
                }
            }
        }
    }
    // ---- 蓝图叠加层：框选矩形与粘贴幽灵预览 ----

    void Marquee(ForgeWorld w, ForgeCamera camera, int anchor, int cursor) {
        int ax = anchor % w.width; int ay = anchor / w.width;
        int cx = cursor % w.width; int cy = cursor / w.width;
        int x0 = ForgeGrid.Min(ax, cx); int y0 = ForgeGrid.Min(ay, cy);
        scale = camera.zoom;
        originX = camera.ScreenX(x0 * 1000); originY = camera.ScreenY(y0 * 1000);
        double pixels = ForgeGrid.TileSize() * camera.zoom;
        int pw = ForgeGrid.Max(1, (int)Math.Round((ForgeGrid.Abs(ax - cx) + 1) * pixels));
        int ph = ForgeGrid.Max(1, (int)Math.Round((ForgeGrid.Abs(ay - cy) + 1) * pixels));
        canvas.FillRect(originX, originY, pw, ph, 0x244DBF93);
        canvas.DrawRect(originX, originY, pw, ph, 0xB44DBF93, Stroke(1));
    }

    void Blueprint(ForgeWorld w, ForgeCamera camera, int anchor) {
        int ax = anchor % w.width; int ay = anchor / w.width;
        for (int i = 0; i < bpCount; i = i + 1) {
            int x = ax + bpDX[i]; int y = ay + bpDY[i];
            if (x < 0 || y < 0 || x >= w.width || y >= w.height) { continue; }
            int cell = y * w.width + x;
            BlockKind kind = (BlockKind)bpKind[i];
            bool ok = w.BuildError(cell, kind) == "";
            AtCell(w, camera, cell);
            if (!Visible(camera, originX + S(16), originY + S(16), S(40))) { continue; }
            ghost = true; ghostTint = ok ? 0xFF9DE4C2 : 0xFFEF967C;
            Rect(0, 0, 32, 32, ok ? 0x244DBF93 : 0x30CF765A);
            Building(w, camera, cell, kind, w.buildings[cell], bpDir[i]);
            Corners(ghostTint, 0);
            ghost = false;
        }
        // 蓝图包围框：一眼看清粘贴的占地范围。
        int minX = 0; int minY = 0; int maxX = 0; int maxY = 0;
        for (int i = 0; i < bpCount; i = i + 1) {
            if (bpDX[i] < minX) { minX = bpDX[i]; }
            if (bpDY[i] < minY) { minY = bpDY[i]; }
            if (bpDX[i] > maxX) { maxX = bpDX[i]; }
            if (bpDY[i] > maxY) { maxY = bpDY[i]; }
        }
        scale = camera.zoom;
        originX = camera.ScreenX((ax + minX) * 1000); originY = camera.ScreenY((ay + minY) * 1000);
        double pixels = ForgeGrid.TileSize() * camera.zoom;
        canvas.DrawRect(originX, originY, (int)Math.Round((maxX - minX + 1) * pixels),
          (int)Math.Round((maxY - minY + 1) * pixels), 0xCC9DE4C2, Stroke(1));
    }

    void Placement(ForgeWorld w, ForgeCamera camera, int cell, BlockKind selected, int direction, bool erase) {
        if (cell < 0 || cell >= w.width * w.height) { return; }
        AtCell(w, camera, cell);
        ForgeBuilding existing = w.buildings[cell];
        if (erase) {
            bool removable = existing.kind != BlockKind.Empty && existing.kind != BlockKind.Core;
            int color = removable ? 0xFFEFA37B : 0xFF938A7B;
            Rect(0, 0, 32, 32, removable ? 0x45D88760 : 0x259D9485);
            Corners(color, 1);
            if (removable) { Line(10, 10, 22, 22, color, 2); Line(22, 10, 10, 22, color, 2); }
            return;
        }
        if (selected == BlockKind.Empty || selected == BlockKind.Core) { Corners(0xFFD5D4AC, 1); return; }
        bool valid = w.BuildError(cell, selected) == "";
        int tint = valid ? 0xFF9DE4C2 : 0xFFEF967C;
        Rect(0, 0, 32, 32, valid ? 0x304DBF93 : 0x45CF765A);
        ghost = true; ghostTint = tint;
        Building(w, camera, cell, selected, existing, direction);
        ghost = false;
        Corners(tint, 0);
        // 核心契约与语义定义。
        TurnLine(7, 25, 18, 25, direction, 0xDD223538, 4);
        TurnLine(18, 25, 18, 16, direction, 0xDD223538, 4);
        TurnLine(18, 16, 30, 16, direction, 0xDD223538, 4);
        TurnLine(7, 25, 18, 25, direction, tint, 2);
        TurnLine(18, 25, 18, 16, direction, tint, 2);
        TurnLine(18, 16, 30, 16, direction, tint, 2);
        Arrow(30, 16, direction, tint);
    }

    void Draw(Canvas c, ForgeWorld w, ForgeCamera camera, int hoverCell, BlockKind selected, int direction, bool erase, int inspectCell, bool powerOverlay) {
        if (camera.viewportW <= 0 || camera.viewportH <= 0 || w.width <= 0 || w.height <= 0) { return; }
        canvas = c; scale = camera.zoom; ghost = false; aimBudget = 12;
        c.PushClip(camera.viewportX, camera.viewportY, camera.viewportW, camera.viewportH);
        c.FillRect(camera.viewportX, camera.viewportY, camera.viewportW, camera.viewportH, 0xFF202D30);
        double pixels = ForgeGrid.TileSize() * camera.zoom;
        int left = ForgeGrid.Max(0, (int)Math.Floor(camera.x - camera.viewportW * 0.5 / pixels) - 2);
        int top = ForgeGrid.Max(0, (int)Math.Floor(camera.y - camera.viewportH * 0.5 / pixels) - 2);
        int right = ForgeGrid.Min(w.width - 1, (int)Math.Ceiling(camera.x + camera.viewportW * 0.5 / pixels) + 2);
        int bottom = ForgeGrid.Min(w.height - 1, (int)Math.Ceiling(camera.y + camera.viewportH * 0.5 / pixels) + 2);
        for (int ty = top; ty <= bottom; ty = ty + 1) {
            for (int tx = left; tx <= right; tx = tx + 1) { Terrain(w, camera, ty * w.width + tx); }
        }
        if (left <= right && top <= bottom) { Grid(w, camera, left, top, right, bottom); }
        int mapX = camera.ScreenX(0); int mapY = camera.ScreenY(0);
        c.DrawRect(mapX, mapY, camera.ScreenX(w.width * 1000) - mapX, camera.ScreenY(w.height * 1000) - mapY, 0xFF716E55, 1);
        Portals(w, camera);
        Nests(w, camera);
        if (inspectCell >= 0 && inspectCell < w.buildings.Length) {
            Range(w, camera, inspectCell, w.buildings[inspectCell].kind, 0xFF9BCABC);
            if (Weapon(w.buildings[inspectCell].kind)) { Aim(w, inspectCell, true, w.buildings[inspectCell].kind != BlockKind.Mortar); }
        }
        if (hoverCell >= 0 && hoverCell < w.buildings.Length && !erase) {
            BlockKind rangeKind = selected == BlockKind.Empty ? w.buildings[hoverCell].kind : selected;
            if (hoverCell != inspectCell || selected != BlockKind.Empty) { Range(w, camera, hoverCell, rangeKind, 0xFFE0C58B); }
            if (Weapon(w.buildings[hoverCell].kind)) { Aim(w, hoverCell, true, w.buildings[hoverCell].kind != BlockKind.Mortar); }
        }
        if (powerOverlay) {
            for (int ty = top; ty <= bottom; ty = ty + 1) {
                for (int tx = left; tx <= right; tx = tx + 1) {
                    int cell = ty * w.width + tx;
                    if (w.buildings[cell].kind != BlockKind.Empty) { Power(w, camera, cell, cell == hoverCell || cell == inspectCell); }
                }
            }
        }
        for (int ty = top; ty <= bottom; ty = ty + 1) {
            for (int tx = left; tx <= right; tx = tx + 1) {
                int cell = ty * w.width + tx;
                ForgeBuilding b = w.buildings[cell];
                if (b.kind != BlockKind.Empty) { Building(w, camera, cell, b.kind, b, b.direction); }
            }
        }
        for (int ty = top; ty <= bottom; ty = ty + 1) {
            for (int tx = left; tx <= right; tx = tx + 1) {
                int cell = ty * w.width + tx;
                ForgeBuilding b = w.buildings[cell];
                if (b.kind == BlockKind.Empty) { continue; }
                Cargo(w, camera, cell);
                int maxHp = b.kind == BlockKind.Core ? w.coreMaxHp : w.catalog.blocks[(int)b.kind].hp;
                if (b.hp < maxHp || cell == inspectCell) {
                    Health(camera, camera.ScreenX(ForgeGrid.Center(tx)), camera.ScreenY(ty * 1000) - ForgeGrid.Max(3, (int)(camera.zoom * 4.0)),
                        ForgeGrid.Max(12, (int)(camera.zoom * 26.0)), b.hp, maxHp, b.hp * 3 < maxHp ? 0xFFE39B78 : 0xFFA5D3A9);
                }
                // 过护标记：缓存仍新鲜且加成超过基线时，格角点亮琥珀双箭头。
                if (w.boostTick[cell] + 3 >= w.tick && w.boostPow[cell] > 1000) {
                    AtCell(w, camera, cell);
                    Line(24, 5, 27, 8, 0xFFF2C06A, 2);
                    Line(27, 8, 24, 11, 0xFFF2C06A, 2);
                    Line(28, 5, 31, 8, 0xFFF2C06A, 2);
                    Line(31, 8, 28, 11, 0xFFF2C06A, 2);
                }
            }
        }
        for (int i = 0; i < w.enemies.Length; i = i + 1) {
            if (w.enemies[i].active) { Enemy(w, camera, w.enemies[i], i); }
        }
        Beams(w, camera);
        Units(w, camera);
        Bullets(w, camera);
        Effects(w, camera);
        Events(w, camera);
        if (inspectCell >= 0 && inspectCell < w.buildings.Length) {
            AtCell(w, camera, inspectCell); Corners(0xFFB4DCCE, -2);
        }
        if (bpState == 2 && bpCount > 0 && hoverCell >= 0 && hoverCell < w.width * w.height) { Blueprint(w, camera, hoverCell); }
        if (bpState == 1 && bpDrag && bpAnchor >= 0 && hoverCell >= 0 && hoverCell < w.width * w.height) { Marquee(w, camera, bpAnchor, hoverCell); }
        Placement(w, camera, hoverCell, selected, direction, erase);
        c.PopClip();
    }
}
