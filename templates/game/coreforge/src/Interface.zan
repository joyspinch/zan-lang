using System;
using System.Collections.Generic;
using Gui;
using Game.Core;

namespace Coreforge;

// 炉心边境 · 直绘 HUD。RTS/动作类的每帧热 HUD 走代码直绘
// （game-dev skill 的性能边界）：世界全屏铺底，半透明熔核面板
// 叠加其上，零原生控件。命中区域表在绘制时重建（immediate-mode
// 登记），Input 按区域分发；图元只来自 Canvas 标准绘制原语。

/// HUD 命中区域（绘制期登记，输入期查询）。
class HudZone {
    public int id;
    public int x;
    public int y;
    public int w;
    public int h;
    public bool enabled;
    public bool active;

    HudZone(int id, int x, int y, int w, int h, bool enabled, bool active) {
        this.id = id; this.x = x; this.y = y; this.w = w; this.h = h;
        this.enabled = enabled; this.active = active;
    }
    static HudZone Create(int id, int x, int y, int w, int h, bool enabled, bool active) {
        return new HudZone(id, x, y, w, h, enabled, active);
    }
}

class ForgeInterface {
    // ---- 区域 id（0 = 无） ----
    const int ZPause = 1;
    const int ZSpeed = 2;
    const int ZLaunch = 3;
    const int ZTech = 4;
    const int ZPower = 5;
    const int ZSave = 6;
    const int ZLoad = 7;
    const int ZFocus = 8;
    const int ZNew = 9;
    const int ZRotate = 10;
    const int ZDemolish = 11;
    const int ZCancel = 12;
    const int ZBuildBase = 16;   // + 方块 id（2..14）
    const int ZTechBase = 32;    // + 科技 id（1..5）
    const int ZRecipe = 40;
    const int ZTarget = 41;
    const int ZFeed = 42;

    // ---- 熔核配色（与 Renderer.ItemColor 同源的物品色） ----
    const int CPanel = 0xB4140F0A;
    const int CPanelBorder = 0xFF4D3D24;
    const int CAmber = 0xFFE08A3C;
    const int CAmberHi = 0xFFF2A558;
    const int CText = 0xFFF3EAD9;
    const int CSecondary = 0xFFCDBB97;
    const int CTertiary = 0xFF93825F;
    const int CDanger = 0xFFCF5A35;
    const int COk = 0xFF8FAE4E;
    const int COnAmber = 0xFF1A130A;
    const int CBtn = 0xD9221B10;
    const int CBtnHover = 0xFF2C2417;
    const int CBtnBorder = 0xFF3D3019;

    App app;
    ForgeSimulation sim;
    ForgeCamera camera;
    ForgeRenderer renderer;
    List<HudZone> zones;
    BlockKind selected;
    int direction;
    int inspectCell;
    int hoverCell;
    int speed;
    bool paused;
    bool erase;
    bool powerOverlay;
    bool showTech;
    bool newRunArmed;
    bool leftDown;
    bool rightDown;
    int pressedZone;
    int downCell;
    int lastCell;
    int mouseX;
    int mouseY;
    int previousX;
    int previousY;
    int gestureFlag;
    int lastUiTick;
    int lastEvent;
    int messageUntil;
    bool[] keys;
    string status;
    string savePath;
    string title;
    double uiScale;
    int clientW;
    int clientH;
    int chromeTop;

    ForgeInterface(App host, string path) {
        app = host; savePath = path; title = "炉心边境 · COREFORGE";
        sim = new ForgeSimulation(1709); camera = new ForgeCamera(); camera.Focus(sim.world);
        renderer = new ForgeRenderer(); selected = BlockKind.Empty; speed = 1;
        inspectCell = sim.world.coreCell; hoverCell = -1; lastCell = -1; downCell = -1;
        zones = new List<HudZone>();
        keys = new bool[256];
        status = "从铜矿到炮塔：沿箭头连接输送线，守住炉心。";
        mouseX = -1; mouseY = -1;
    }

    // ---- 单一缩放 helper：自绘路径的一切尺寸过它（D16 纪律） ----
    int S(int v) { return ForgeGrid.Max(1, (int)(v * uiScale + 0.5)); }
    int Sx(int v) { return (int)(v * uiScale + 0.5); }

    string N(int v) { return Convert.ToString(v); }

    // ================= 帧绘制 =================
    void Render() {
        Canvas c = app.canvas;
        clientW = app.ClientWidth(); clientH = app.ClientHeight();
        chromeTop = app.ContentTop();
        uiScale = clientW / 1280.0;
        zones.Clear();
        // 世界全屏铺底（chrome 之下）——游戏画面本体。
        camera.SetViewport(0, chromeTop, clientW, clientH - chromeTop);
        renderer.Draw(c, sim.world, camera, hoverCell, selected, direction, erase, inspectCell, powerOverlay);
        TopBar(c);
        if (showTech) { TechPanel(c); }
        else { BuildPalette(c); }
        DetailPanel(c);
        StatusRow(c);
        WaveBanner(c);
        Tooltip(c);
    }

    void Panel(Canvas c, int x, int y, int w, int h) {
        c.FillRect(x, y, w, h, CPanel);
        c.DrawRect(x, y, w, h, CPanelBorder, 1);
    }

    /// 画一个按钮并登记命中区域。返回区域右边界 x。
    int Button(Canvas c, int id, int x, int y, int w, int h, string label,
               bool enabled, bool active, int textColor) {
        bool hover = enabled && InRect(mouseX, mouseY, x, y, w, h);
        int bg = active ? CAmber : hover ? CBtnHover : CBtn;
        int border = active ? CAmber : hover ? 0xFF6B5327 : CBtnBorder;
        c.FillRect(x, y, w, h, bg);
        c.DrawRect(x, y, w, h, border, 1);
        int fs = S(13);
        int tx = x + (w - Canvas.MeasureText(label, fs)) / 2;
        int ty = y + (h - Canvas.FontHeight(fs)) / 2;
        int fg = !enabled ? CTertiary : active ? COnAmber : textColor;
        c.DrawText(tx, ty, label, fg, fs);
        if (!enabled) { c.DrawRect(x, y, w, h, 0x3093825F, 1); }
        zones.Add(HudZone.Create(id, x, y, w, h, enabled, active));
        return x + w;
    }

    bool InRect(int px, int py, int x, int y, int w, int h) {
        return px >= x && py >= y && px < x + w && py < y + h;
    }

    int ChipColor(int item) {
        if (item == 0) { return 0xFFE8A05D; }
        if (item == 1) { return 0xFFB5A3C9; }
        if (item == 2) { return 0xFF7C8792; }
        if (item == 3) { return 0xFF9DE8CA; }
        if (item == 4) { return 0xFFC0CCD3; }
        if (item == 5) { return 0xFF7ECAEC; }
        return 0xFFE2D5B5;
    }

    /// 方块图标的强调色（与世界美术同族的简化映射）。
    int BlockAccent(int id) {
        if (id == 2) { return 0xFFE8A05D; }   // 钻头：铜
        if (id == 3) { return 0xFFC0CCD3; }   // 传送带：钢
        if (id == 4) { return 0xFFB5A3C9; }   // 分流器：铅
        if (id == 5) { return 0xFFE08A3C; }   // 熔炉：熔核
        if (id == 6) { return 0xFF9DE8CA; }   // 装配机：硅
        if (id == 7) { return 0xFFF2A558; }   // 发电机：暖琥珀
        if (id == 8) { return 0xFF8FAE4E; }   // 蓄电池：苔绿
        if (id == 9) { return 0xFFCF5A35; }   // 炮塔：赤铜
        if (id == 10) { return 0xFF8A8F96; }  // 墙：岩灰
        if (id == 11) { return 0xFF6F95A8; }  // 泵：水蓝
        if (id == 12) { return 0xFF587D8B; }  // 管道：深青
        if (id == 13) { return 0xFFD9A13C; }  // 中继：警示金
        if (id == 14) { return 0xFF9A7DB8; }  // 油井：油紫
        return CTertiary;
    }

    /// 建筑小图形：调色板图标与世界美术同族的极简字形。
    /// 全部用标准图元，(x,y) 为 size×size 瓦片左上角。
    void BlockIcon(Canvas c, int id, int x, int y, int size, int color) {
        int cx = x + size / 2;
        int cy = y + size / 2;
        int u = ForgeGrid.Max(2, size / 8);
        if (id == 2) {          // 钻头：下三角 + 顶杆
            c.DrawLine(cx, y + u, cx, cy - u, color, u);
            c.FillRect(cx - size / 4, cy - u, size / 2, u * 2, color);
            c.FillRect(cx - size / 4 + u, cy + u, size / 2 - u * 2, u * 2, color);
        } else if (id == 3) {   // 传送带：两道人字箭头
            for (int k = 0; k < 2; k = k + 1) {
                int ax = x + u + k * (size / 2);
                c.DrawLine(ax, y + u * 2, ax + size / 4, cy, color, u);
                c.DrawLine(ax + size / 4, cy, ax, y + size - u * 2, color, u);
            }
        } else if (id == 4) {   // 分流器：中心点 + 三向短线
            c.FillRect(cx - u, cy - u, u * 2, u * 2, color);
            c.DrawLine(cx, cy, cx, y + u, color, u);
            c.DrawLine(cx, cy, x + u, y + size - u, color, u);
            c.DrawLine(cx, cy, x + size - u, y + size - u, color, u);
        } else if (id == 5) {   // 熔炉：炉口火苗
            c.DrawRect(x + u * 2, y + u, size - u * 4, size - u * 2, color, u);
            c.FillRect(cx - u, cy, u * 2, size / 4, color);
            c.FillRect(cx - u * 2, cy + size / 4, u * 4, u, color);
        } else if (id == 6) {   // 装配机：四点晶格
            c.FillRect(x + u * 2, y + u * 2, u * 2, u * 2, color);
            c.FillRect(x + size - u * 4, y + u * 2, u * 2, u * 2, color);
            c.FillRect(x + u * 2, y + size - u * 4, u * 2, u * 2, color);
            c.FillRect(x + size - u * 4, y + size - u * 4, u * 2, u * 2, color);
            c.DrawRect(cx - u, cy - u, u * 2, u * 2, color, 1);
        } else if (id == 7) {   // 发电机：闪电
            c.DrawLine(cx + u * 2, y + u, cx - u * 2, cy, color, u);
            c.DrawLine(cx - u * 2, cy, cx + u * 2, cy + u, color, u);
            c.DrawLine(cx + u * 2, cy + u, cx - u, y + size - u, color, u);
        } else if (id == 8) {   // 蓄电池：电池壳 + 电平
            c.DrawRect(x + u * 2, y + u * 2, size - u * 4, size - u * 3, color, u);
            c.FillRect(cx - u, y + u, u * 2, u, color);
            c.FillRect(x + u * 3, y + size - u * 4, size - u * 6, u * 2, color);
        } else if (id == 9) {   // 炮塔：圆座 + 炮管
            c.DrawCircle(cx, cy, size / 3, color, u);
            c.FillCircle(cx, cy, u + 1, color);
            c.DrawLine(cx, cy, cx + size / 2 - u, cy, color, u + 1);
        } else if (id == 10) {  // 合金墙：砖缝
            c.DrawRect(x + u, y + u, size - u * 2, size - u * 2, color, u);
            c.DrawLine(x + u, cy, x + size - u, cy, color, 1);
            c.DrawLine(cx, y + u, cx, cy, color, 1);
            c.DrawLine(x + u * 2, cy, x + u * 2, y + size - u, color, 1);
        } else if (id == 11) {  // 取水泵：水滴
            c.FillCircle(cx, cy + u, size / 3, color);
            c.FillRect(cx - u, y + u * 2, u * 2, u * 2, color);
        } else if (id == 12) {  // 管道：双平行管
            c.DrawLine(x + u, cy - u, x + size - u, cy - u, color, u);
            c.DrawLine(x + u, cy + u * 2, x + size - u, cy + u * 2, color, u);
        } else if (id == 13) {  // 电力中继：塔架
            c.DrawLine(cx, y + u, cx, y + size - u, color, u);
            c.DrawLine(cx - size / 3, y + size - u, cx, cy - u, color, u);
            c.DrawLine(cx + size / 3, y + size - u, cx, cy - u, color, u);
            c.FillCircle(cx, y + u, u, color);
        } else if (id == 14) {  // 油井：井架 + 油滴
            c.DrawLine(x + u, y + size - u, cx, y + u, color, u);
            c.DrawLine(cx, y + u, x + size - u, y + size - u, color, u);
            c.FillCircle(cx, y + size - u * 3, u + 1, color);
        }
    }

    void TopBar(Canvas c) {
        int h = S(72) + chromeTop;
        c.FillRect(0, chromeTop, clientW, h - chromeTop, 0xE6140F0A);
        int fsBrand = S(20);
        c.DrawText(S(16), chromeTop + S(10), "炉心边境", CAmber, fsBrand);
        int brandW = Canvas.MeasureText("炉心边境", fsBrand);
        c.DrawText(S(16) + brandW + S(14), chromeTop + S(18), "C O R E F O R G E", CTertiary, S(11));

        // 资源芯片：主线库存一排，色块与世界物品同源。
        int cx = Sx(310);
        int chipFs = S(13);
        int[] chipItems = new int[] { 0, 1, 2, 5 };
        for (int i = 0; i < chipItems.Length; i = i + 1) {
            int item = chipItems[i];
            int amount = sim.world.resources.Get(item);
            string text = sim.world.catalog.items[item] + " " + N(amount);
            c.FillRect(cx, chromeTop + S(16), S(12), S(12), ChipColor(item));
            c.DrawRect(cx, chromeTop + S(16), S(12), S(12), 0x40000000, 1);
            c.DrawText(cx + S(18), chromeTop + S(14), text, amount > 0 ? CText : CTertiary, chipFs);
            cx = cx + S(18) + Canvas.MeasureText(text, chipFs) + S(18);
        }

        // 炉心耐久条。
        ForgeWorld w = sim.world;
        int hpBarX = Sx(310);
        int hpBarY = chromeTop + S(44);
        c.FillRect(hpBarX, hpBarY, S(220), S(10), 0xFF221B10);
        int hpPct = ForgeGrid.Max(0, w.buildings[w.coreCell].hp) * 100 / w.coreMaxHp;
        int hpFill = S(220) * hpPct / 100;
        c.FillRect(hpBarX, hpBarY, hpFill, S(10), hpPct > 40 ? CAmber : CDanger);
        c.DrawRect(hpBarX, hpBarY, S(220), S(10), CBtnBorder, 1);
        string hpText = "炉心 " + N(hpPct) + "% · 电力 " + N(w.powerSupply) + " / " + N(w.powerDemand)
          + " · 储能 " + N(w.batteryStored / 1000) + "k";
        c.DrawText(hpBarX + S(228), hpBarY - S(3), hpText, CSecondary, S(12));

        // 右侧两排工具按钮（自右向左排布）。
        int bh = S(26);
        int bx = clientW - S(16);
        bx = ButtonRow2(c, bx, chromeTop + S(40), bh);
        bx = ButtonRow1(c, bx, chromeTop + S(8), bh);
        int row1Left = clientW - S(16) - (S(72) * 3 + S(6) * 2);
        DrawWaveText(c, row1Left - S(14), chromeTop + S(14));

        // 熔线（签名位）：两段渐弱的琥珀细线。
        c.FillRect(0, h, clientW / 3, S(2), CAmber);
        c.FillRect(clientW / 3, h, clientW - clientW / 3, S(2), 0x50E08A3C);
    }

    int ButtonRow1(Canvas c, int right, int y, int h) {
        int w = S(72);
        int gap = S(6);
        int x = right - w;
        string pauseLabel = paused ? "继续" : "暂停";
        Button(c, ZPause, x, y, w, h, pauseLabel, true, paused, CSecondary); x = x - gap - w;
        Button(c, ZSpeed, x, y, w, h, "×" + N(speed), true, speed > 1, CSecondary); x = x - gap - w;
        bool canLaunch = !sim.world.waveActive && !sim.world.defeated && !sim.world.victory;
        return Button(c, ZLaunch, x, y, w, h, "迎敌", canLaunch, false, 0xFFD9A13C);
    }

    int ButtonRow2(Canvas c, int right, int y, int h) {
        int w = S(66);
        int gap = S(6);
        int x = right - w;
        Button(c, ZNew, x, y, w, h, "新远征", true, newRunArmed, CDanger); x = x - gap - w;
        Button(c, ZFocus, x, y, w, h, "回炉心", true, false, CSecondary); x = x - gap - w;
        Button(c, ZLoad, x, y, w, h, "读档", true, false, CSecondary); x = x - gap - w;
        Button(c, ZSave, x, y, w, h, "保存", true, false, CSecondary); x = x - gap - w;
        Button(c, ZTech, x, y, w, h, "科技", true, showTech, CSecondary); x = x - gap - w;
        Button(c, ZPower, x, y, w, h, "电网", true, powerOverlay, CSecondary);
        return x;
    }

    void DrawWaveText(Canvas c, int right, int y) {
        ForgeWorld w = sim.world;
        string text;
        int color;
        if (w.defeated) { text = "炉心失守"; color = CDanger; }
        else if (w.victory) { text = "远征胜利"; color = CAmber; }
        else if (w.waveActive) {
            text = "第 " + N(w.wave) + " 波 · 敌军 " + N(w.enemyCount) + " · 待抵达 " + N(w.spawnRemaining);
            color = CDanger;
        } else {
            text = "第 " + N(w.wave) + " / 20 波 · 准备 " + N((w.nextWaveTicks + 49) / 50) + " 秒";
            color = CSecondary;
        }
        int fs = S(14);
        c.DrawText(right - Canvas.MeasureText(text, fs) - S(14), y, text, color, fs);
    }

    void BuildPalette(Canvas c) {
        int bw = S(88);
        int bh = S(66);
        int gap = S(4);
        int count = 13;
        int total = count * bw + (count - 1) * gap;
        int x0 = (clientW - total) / 2;
        int y = clientH - S(104);
        c.FillRect(0, y - S(6), clientW, S(110), 0x80100C07);
        for (int k = 2; k < 15; k = k + 1) {
            int x = x0 + (k - 2) * (bw + gap);
            bool unlocked = sim.world.Unlocked((BlockKind)k);
            bool active = !erase && selected == (BlockKind)k;
            bool hover = unlocked && InRect(mouseX, mouseY, x, y, bw, bh);
            int bg = active ? CAmber : hover ? CBtnHover : CBtn;
            c.FillRect(x, y, bw, bh, bg);
            c.DrawRect(x, y, bw, bh, active ? CAmber : hover ? 0xFF6B5327 : CBtnBorder, 1);
            int icon = S(28);
            int ix = x + (bw - icon) / 2;
            int iy = y + S(6);
            c.FillRect(ix, iy, icon, icon, 0xFF251E14);
            c.DrawRect(ix, iy, icon, icon, active ? COnAmber : BlockAccent(k), 1);
            BlockIcon(c, k, ix + S(3), iy + S(3), icon - S(6),
              active ? COnAmber : BlockAccent(k));
            string name = sim.world.catalog.blocks[k].name;
            int fs = S(12);
            int label = active ? COnAmber : unlocked ? CSecondary : CTertiary;
            c.DrawText(x + (bw - Canvas.MeasureText(name, fs)) / 2, y + bh - S(18), name, label, fs);
            zones.Add(HudZone.Create(ZBuildBase + k, x, y, bw, bh, unlocked, active));
        }
    }

    void TechPanel(Canvas c) {
        int w = S(380);
        int x = S(16);
        int y = chromeTop + S(88);
        int rowH = S(42);
        int h = S(46) + 5 * rowH + S(30);
        Panel(c, x, y, w, h);
        c.FillRect(x, y, w, S(2), CAmber);
        c.DrawText(x + S(14), y + S(10), "研究与扩张", CAmber, S(15));
        for (int i = 1; i < 6; i = i + 1) {
            TechDef t = sim.world.catalog.techs[i];
            int ry = y + S(40) + (i - 1) * rowH;
            bool done = sim.world.researched[i];
            bool enabled = !done && sim.world.researched[t.parent] && sim.world.resources.Has(t.cost);
            bool hover = enabled && InRect(mouseX, mouseY, x + S(12), ry, w - S(24), rowH - S(6));
            c.FillRect(x + S(12), ry, w - S(24), rowH - S(6),
              done ? 0xFF1D2412 : hover ? CBtnHover : CBtn);
            c.DrawRect(x + S(12), ry, w - S(24), rowH - S(6),
              done ? 0xFF3A4A22 : hover ? 0xFF6B5327 : CBtnBorder, 1);
            string head = (done ? "已完成 · " : enabled ? "研究 · " : "锁定 · ") + t.name;
            c.DrawText(x + S(24), ry + S(6), head, done ? COk : enabled ? CText : CTertiary, S(13));
            c.DrawText(x + S(24), ry + S(22), Cost(t.cost), CTertiary, S(11));
            zones.Add(HudZone.Create(ZTechBase + i, x + S(12), ry, w - S(24), rowH - S(6), enabled, false));
        }
        c.DrawText(x + S(14), y + h - S(24), "前置完成后，用核心库存换取扩张。", CTertiary, S(12));
    }

    void DetailPanel(Canvas c) {
        string body = DetailBody();
        if (body == "") { return; }
        int wpx = S(292);
        int x = clientW - wpx - S(12);
        int y = chromeTop + S(88);
        int pad = S(12);
        int fs = S(13);
        int textW = wpx - pad * 2;
        List<string> lines = TextWrap.Lines(body, textW, fs);
        bool hasContext = RecipeBtn() != "" || TargetBtn() || FeedBtn();
        int h = pad * 2 + Canvas.FontHeight(S(15)) + S(4) + lines.Count * Canvas.FontHeight(fs)
          + (hasContext ? S(30) : 0);
        Panel(c, x, y, wpx, h);
        c.FillRect(x, y, wpx, S(2), CAmber);
        c.DrawText(x + pad, y + pad - S(2), DetailTitle(), CAmber, S(15));
        for (int i = 0; i < lines.Count; i = i + 1) {
            c.DrawText(x + pad, y + pad + Canvas.FontHeight(S(15)) + S(4) + i * Canvas.FontHeight(fs),
              lines[i], CText, fs);
        }
        if (hasContext) {
            int by = y + h - S(30);
            int bw = S(84);
            int bx = x + wpx - pad - bw;
            if (FeedBtn()) {
                Button(c, ZFeed, bx, by, bw, S(24), FeedLabel(), true, false, CSecondary);
                bx = bx - S(4) - bw;
            }
            if (TargetBtn()) {
                Button(c, ZTarget, bx, by, bw, S(24), TargetLabel(), true, false, CSecondary);
                bx = bx - S(4) - bw;
            }
            if (RecipeBtn() != "") { Button(c, ZRecipe, bx, by, bw, S(24), RecipeBtn(), true, false, CSecondary); }
        }
    }

    string DetailTitle() {
        ForgeWorld w = sim.world;
        if (selected != BlockKind.Empty) {
            return w.catalog.blocks[(int)selected].name + " · " + Facing();
        }
        if (inspectCell >= 0 && inspectCell < w.width * w.height) {
            ForgeBuilding b = w.buildings[inspectCell];
            if (b.kind != BlockKind.Empty) { return w.catalog.blocks[(int)b.kind].name; }
            ForgeTile t = w.tiles[inspectCell];
            if (t.ore >= 0) { return w.catalog.items[t.ore] + "矿脉"; }
            if (t.terrain == TerrainKind.Water) { return "水域"; }
            if (t.terrain == TerrainKind.Oil) { return "石油层"; }
        }
        return "";
    }

    string DetailBody() {
        ForgeWorld w = sim.world;
        if (selected != BlockKind.Empty) {
            BlockDef def = w.catalog.blocks[(int)selected];
            return def.help + "\n建造消耗：" + Cost(def.cost);
        }
        if (inspectCell >= 0 && inspectCell < w.width * w.height) {
            ForgeBuilding b = w.buildings[inspectCell];
            ForgeTile t = w.tiles[inspectCell];
            if (b.kind != BlockKind.Empty) {
                string details = "HP " + N(b.hp) + " · 效率 " + N(b.efficiency / 10) + "%"
                  + "\n水 " + N(b.water) + " / 油 " + N(b.oil)
                  + "\n库存 " + Cost(b.stock);
                if (b.kind == BlockKind.Furnace || b.kind == BlockKind.Assembler) {
                    RecipeDef recipe = w.catalog.recipes[b.recipe];
                    details = details + "\n" + recipe.name + "：" + Cost(recipe.input)
                      + " → " + w.catalog.items[recipe.output] + " ×" + N(recipe.quantity);
                }
                return details;
            }
            if (t.ore >= 0) { return "储量 " + N(t.reserve) + "\n选择矿脉钻头进行开采。"; }
            if (t.terrain == TerrainKind.Water) { return "研究热工学后建造取水泵。"; }
            if (t.terrain == TerrainKind.Oil) { return "研究晶格工程后建造油井。"; }
        }
        return "";
    }

    string RecipeBtn() {
        if (inspectCell < 0 || inspectCell >= sim.world.width * sim.world.height) { return ""; }
        ForgeBuilding b = sim.world.buildings[inspectCell];
        if (b.kind != BlockKind.Furnace && b.kind != BlockKind.Assembler) { return ""; }
        return sim.world.catalog.recipes[b.recipe].name;
    }
    bool TargetBtn() {
        if (inspectCell < 0 || inspectCell >= sim.world.width * sim.world.height) { return false; }
        return sim.world.buildings[inspectCell].kind == BlockKind.Turret;
    }
    bool FeedBtn() {
        if (inspectCell < 0 || inspectCell >= sim.world.width * sim.world.height) { return false; }
        BlockKind k = sim.world.buildings[inspectCell].kind;
        return k == BlockKind.Turret || k == BlockKind.Generator
          || k == BlockKind.Furnace || k == BlockKind.Assembler;
    }
    string TargetLabel() {
        ForgeBuilding b = sim.world.buildings[inspectCell];
        string mode = b.targetMode == 0 ? "最近" : b.targetMode == 1 ? "最弱" : "最强";
        return "索敌 " + mode;
    }
    string FeedLabel() {
        ForgeBuilding b = sim.world.buildings[inspectCell];
        if (b.kind == BlockKind.Generator) { return "投入石墨"; }
        if (b.kind == BlockKind.Turret) { return "投入弹药"; }
        return "投入原料";
    }

    void StatusRow(Canvas c) {
        int y = clientH - S(28);
        c.FillRect(0, y, clientW, S(28), 0xE6140F0A);
        c.FillRect(0, y, clientW, 1, CBtnBorder);
        string text = paused ? "已暂停 · 可以规划、建造和研究。" : status;
        c.DrawText(S(16), y + S(7), text, CSecondary, S(13));
        int bw = S(88);
        int bh = S(22);
        int bx = clientW - S(16) - bw;
        Button(c, ZCancel, bx, y + S(3), bw, bh, "取消 Q", true, false, CSecondary);
        bx = bx - S(6) - bw;
        Button(c, ZDemolish, bx, y + S(3), bw, bh, "拆除 X", true, erase, CSecondary);
        bx = bx - S(6) - bw;
        Button(c, ZRotate, bx, y + S(3), bw, bh, "旋转 R", true, false, CSecondary);
    }

    void WaveBanner(Canvas c) {
        ForgeWorld w = sim.world;
        if (!w.waveActive || w.defeated || w.victory) { return; }
        int pulse = 0xB4 + (w.tick % 50) * 50 / 50;
        string text = "⚑ 第 " + N(w.wave) + " 波 · 守住炉心";
        int fs = S(16);
        int tw = Canvas.MeasureText(text, fs);
        int x = (clientW - tw) / 2;
        int y = chromeTop + S(84);
        c.FillRect(x - S(14), y - S(4), tw + S(28), Canvas.FontHeight(fs) + S(8), (pulse << 24) | 0x140F0A);
        c.DrawText(x, y, text, 0xFFCF5A35, fs);
    }

    void Tooltip(Canvas c) {
        if (showTech) { return; }
        int zone = ZoneAt(mouseX, mouseY);
        if (zone < ZBuildBase || zone >= ZBuildBase + 15) { return; }
        int id = zone - ZBuildBase;
        BlockDef def = sim.world.catalog.blocks[id];
        string text = def.name + "\n" + def.help + "\n建造消耗：" + Cost(def.cost);
        int w = S(270);
        int fs = S(12);
        List<string> lines = TextWrap.Lines(text, w - S(20), fs);
        int h = S(10) + lines.Count * Canvas.FontHeight(fs) + S(10);
        int x = mouseX + S(14);
        int y = mouseY + S(14);
        if (x + w > clientW) { x = mouseX - w - S(10); }
        if (y + h > clientH - S(104)) { y = mouseY - h - S(10); }
        Panel(c, x, y, w, h);
        for (int i = 0; i < lines.Count; i = i + 1) {
            c.DrawText(x + S(10), y + S(10) + i * Canvas.FontHeight(fs), lines[i],
              i == 0 ? CAmber : CSecondary, fs);
        }
    }

    string Cost(Stock stock) {
        string text = "";
        for (int i = 0; i < 6; i = i + 1) {
            if (stock.Get(i) > 0) {
                if (text != "") { text = text + "  "; }
                text = text + sim.world.catalog.items[i] + " " + N(stock.Get(i));
            }
        }
        return text;
    }

    string Facing() {
        if (direction == 0) { return "向东 →"; }
        if (direction == 1) { return "向南 ↓"; }
        if (direction == 2) { return "向西 ←"; }
        return "向北 ↑";
    }

    // ================= 命中与动作 =================
    int ZoneAt(int x, int y) {
        for (int i = 0; i < zones.Count; i = i + 1) {
            HudZone z = zones[i];
            if (InRect(x, y, z.x, z.y, z.w, z.h)) { return z.id; }
        }
        return 0;
    }

    void Activate(int id) {
        if (id == ZPause) { paused = !paused; newRunArmed = false; }
        else if (id == ZSpeed) { speed = speed == 1 ? 2 : speed == 2 ? 4 : 1; }
        else if (id == ZLaunch) { sim.combat.StartWave(); }
        else if (id == ZTech) { showTech = !showTech; }
        else if (id == ZPower) { powerOverlay = !powerOverlay; }
        else if (id == ZSave) { Save(); }
        else if (id == ZLoad) { Load(); }
        else if (id == ZFocus) { camera.Focus(sim.world); }
        else if (id == ZNew) { NewRun(); }
        else if (id == ZRotate) { Rotate(); }
        else if (id == ZDemolish) { erase = !erase; selected = BlockKind.Empty; }
        else if (id == ZCancel) { Cancel(); }
        else if (id == ZRecipe) { CycleRecipe(); }
        else if (id == ZTarget) { CycleTarget(); }
        else if (id == ZFeed) { Feed(); }
        else if (id >= ZTechBase && id < ZTechBase + 6) { Research(id - ZTechBase); }
        else if (id >= ZBuildBase && id < ZBuildBase + 15) {
            selected = (BlockKind)(id - ZBuildBase);
            erase = false;
            showTech = false;
        }
    }

    void Message(string text) {
        status = text;
        messageUntil = sim.world.tick + 250;
    }

    void Cancel() {
        selected = BlockKind.Empty;
        erase = false;
        leftDown = false;
        newRunArmed = false;
    }

    void Rotate() {
        direction = (direction + 1) % 4;
        if (selected == BlockKind.Empty && inspectCell >= 0) {
            ForgeBuilding b = sim.world.buildings[inspectCell];
            if (b.kind != BlockKind.Empty && b.kind != BlockKind.Core) { b.direction = (b.direction + 1) % 4; }
        }
    }

    void Research(int id) {
        if (id < 1 || id > 5) { return; }
        if (sim.world.Research(id)) { Message("研究完成：" + sim.world.catalog.techs[id].name); }
        else { Message("研究条件未满足，请检查前置科技与核心库存。"); }
    }

    void CycleRecipe() {
        if (inspectCell < 0) { return; }
        ForgeBuilding b = sim.world.buildings[inspectCell];
        if (b.kind == BlockKind.Furnace) { b.recipe = b.recipe == 0 ? 1 : 0; }
        else if (b.kind == BlockKind.Assembler) { b.recipe = b.recipe == 2 ? 3 : 2; }
        b.progress = 0;
    }

    void CycleTarget() {
        if (inspectCell >= 0) {
            ForgeBuilding b = sim.world.buildings[inspectCell];
            b.targetMode = (b.targetMode + 1) % 3;
        }
    }

    void Feed() {
        if (inspectCell < 0) { return; }
        ForgeBuilding b = sim.world.buildings[inspectCell];
        bool ok = false;
        if (b.kind == BlockKind.Turret) { ok = sim.world.Feed(inspectCell, 0, 6); }
        else if (b.kind == BlockKind.Generator) { ok = sim.world.Feed(inspectCell, 2, 4); }
        else if (b.kind == BlockKind.Furnace || b.kind == BlockKind.Assembler) {
            Stock inputs = sim.world.catalog.recipes[b.recipe].input;
            if (b.stock.Total() + inputs.Total() <= 24 && sim.world.resources.Has(inputs)) {
                ok = sim.world.resources.Pay(inputs);
                if (ok) { for (int i = 0; i < 6; i = i + 1) { b.stock.Add(i, inputs.Get(i)); } }
            }
        }
        Message(ok ? "已投入原料。持续生产请连接输送带与管道。" : "资源不足或建筑输入仓已满。");
    }

    void Save() {
        Message(ForgeSave.Save(sim.world, savePath) ? "已保存远征。" : "保存失败，请检查存档目录写入权限。");
    }

    void Load() {
        ForgeWorld? loaded = ForgeSave.Load(savePath);
        if (loaded == null) { Message("未找到有效存档，当前远征继续。"); return; }
        sim = new ForgeSimulation(loaded);
        inspectCell = loaded.coreCell;
        camera.Focus(loaded);
        leftDown = false;
        rightDown = false;
        lastCell = -1;
        paused = true;
        lastEvent = loaded.events.sequence;
        Message("存档已恢复，当前暂停；按空格继续。");
    }

    void NewRun() {
        // 两次点击确认保护进行中的远征；暂停或取消解除待命。
        if (!newRunArmed) {
            newRunArmed = true;
            paused = true;
            Message("已暂停。再次点击新远征将重新开始；可先保存当前远征。");
            return;
        }
        newRunArmed = false;
        sim = new ForgeSimulation(sim.world.seed + 37);
        camera.Focus(sim.world);
        inspectCell = sim.world.coreCell;
        selected = BlockKind.Empty;
        erase = false;
        paused = false;
        lastEvent = 0;
        leftDown = false;
        rightDown = false;
        Message("新的荒原已就绪。先规划运输，再扩张防线。");
    }

    // ================= 输入 =================
    bool OverWorld(int x, int y) {
        return x >= 0 && y >= chromeTop && x < clientW && y < clientH;
    }

    void PaintCell(int cell) {
        if (cell < 0 || cell == lastCell) { return; }
        lastCell = cell;
        if (erase) {
            if (sim.world.Remove(cell, true)) { Message("已拆除，材料与库存已回收。"); }
        } else if (selected != BlockKind.Empty) {
            string error = sim.world.BuildError(cell, selected);
            if (error == "") { sim.world.Build(cell, selected, direction); }
            else { Message(error); }
        } else {
            inspectCell = cell;
        }
    }

    void PaintLine(int from, int to) {
        if (from < 0 || to < 0) { return; }
        int x = from % sim.world.width;
        int y = from / sim.world.width;
        int tx = to % sim.world.width;
        int ty = to / sim.world.width;
        int guard = 0;
        while ((x != tx || y != ty) && guard < 84) {
            if (x != tx) { direction = tx > x ? 0 : 2; x = x + ForgeGrid.Dx(direction); }
            else { direction = ty > y ? 1 : 3; y = y + ForgeGrid.Dy(direction); }
            PaintCell(sim.world.Index(x, y));
            guard = guard + 1;
        }
    }

    void Input(int kind, int x, int y, int button, int code, int mods, int flag) {
        previousX = mouseX; previousY = mouseY;
        mouseX = x; mouseY = y;
        clientW = app.ClientWidth(); clientH = app.ClientHeight();
        uiScale = clientW / 1280.0;
        if (zones.Count == 0 && app.canvas != null) { Render(); }
        bool over = OverWorld(x, y);
        hoverCell = over ? camera.CellAt(sim.world, x, y) : -1;
        if (kind == 4 || kind == 5) {
            if (code >= 0 && code < 256) {
                bool repeat = keys[code];
                keys[code] = kind == 4;
                if (kind == 4 && !repeat) {
                    if (code == 32) { paused = !paused; newRunArmed = false; }
                    else if (code == 82) { Rotate(); }
                    else if (code == 81 || code == 27) { Cancel(); }
                    else if (code == 88) { erase = !erase; selected = BlockKind.Empty; }
                    else if (code == 84) { showTech = !showTech; }
                    else if (code == 49) { selected = BlockKind.Drill; erase = false; showTech = false; }
                    else if (code == 50) { selected = BlockKind.Belt; erase = false; showTech = false; }
                    else if (code == 51) { selected = BlockKind.Turret; erase = false; showTech = false; }
                }
            }
        } else if (kind == 13 && over) {
            // 桌面滚轮：每 ±120 格 1.12 倍。原生捏合（mods=1）携带
            // 120*log2(距离比)，2^(code/120) 与手指距离精确一致。
            double factor = mods == 1 ? Math.Pow(2.0, (double)code / 120.0)
              : Math.Pow(1.12, (double)code / 120.0);
            camera.ZoomAt(factor, x, y);
        } else if (kind == 2) {
            if (button == 0) {
                int zone = ZoneAt(x, y);
                if (zone != 0) { pressedZone = zone; }
                else if (over) { leftDown = true; downCell = hoverCell; lastCell = -1; }
            }
            if (button == 1 && over && ZoneAt(x, y) == 0) { rightDown = true; }
        } else if (kind == 1) {
            if (flag > 0) {
                // 每个手势的第一个事件是基准点，不是位移。
                if (flag == gestureFlag && over) { camera.Pan(x - previousX, y - previousY); }
                gestureFlag = flag;
                leftDown = false;
            } else if (rightDown) { camera.Pan(x - previousX, y - previousY); }
            else if (leftDown && over && hoverCell != downCell) {
                if (selected == BlockKind.Belt || selected == BlockKind.Pipe
                  || selected == BlockKind.Wall || erase) {
                    PaintCell(downCell);
                    PaintLine(downCell, hoverCell);
                    downCell = hoverCell;
                }
            }
        } else if (kind == 3) {
            if (button == 0) {
                int zone = ZoneAt(x, y);
                if (pressedZone != 0 && zone == pressedZone) { Activate(pressedZone); }
                else if (pressedZone == 0 && flag == 0 && over) { PaintCell(hoverCell); }
            }
            pressedZone = 0;
            leftDown = false;
            rightDown = false;
            gestureFlag = 0;
            downCell = -1;
            lastCell = -1;
        }
    }

    void TickCamera(int deltaMs) {
        double move = (double)deltaMs * 0.65;
        if (keys[65] || keys[37]) { camera.Pan(move, 0); }
        if (keys[68] || keys[39]) { camera.Pan(-move, 0); }
        if (keys[87] || keys[38]) { camera.Pan(0, move); }
        if (keys[83] || keys[40]) { camera.Pan(0, -move); }
    }

    void TickUi() {
        ForgeWorld w = sim.world;
        if (w.events.sequence > lastEvent) {
            int start = ForgeGrid.Max(lastEvent, w.events.sequence - 64);
            for (int i = start; i < w.events.sequence; i = i + 1) {
                ForgeEvent e = w.events.entries[i % 64];
                if (e.kind == ForgeEventKind.WaveStarted) { Message("敌军接近！检查炮塔弹药与电力，保护运输线。"); }
                if (e.kind == ForgeEventKind.WaveCleared) { Message("波次已清理。补充弹药，趁间歇扩建生产线。"); }
                if (e.kind == ForgeEventKind.CoreLost) { Message("炉心失守。可以读取存档，或开始新的远征。"); }
            }
            lastEvent = w.events.sequence;
        }
        if (messageUntil != 0 && w.tick > messageUntil) {
            status = "";
            messageUntil = 0;
        }
    }
}
