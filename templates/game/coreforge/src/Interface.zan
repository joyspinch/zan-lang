using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Game.Core;

namespace Coreforge;

// 炉心边境 · HUD code-behind。
// chrome（顶栏/工具栏/目标/详情/科技/建造栏/状态栏/波幅横幅/结算幕）
// 系统底层交互与数据流转契约
// 编译期由 GenForm 生成 partial class CoreforgeHud；本文件负责把
// 生成的静态控件树接进游戏：Attach 注册表单事件，RefreshHud 每帧
// 把模拟状态回写到控件（wuwei 式 .Text/.visible 习惯），HudConsumes
// 为世界输入划出遮蔽区。世界画面（游戏本体）仍由 Renderer 直绘；
// 小地图与边缘预警是画布上仅剩的两块热 HUD——它们是每帧变化
// 的游戏坐标内容，进控件树反而要每帧重建。

partial class CoreforgeHud {
    // 生成器装载钩子：动态面板初始全部隐藏，RefreshHud 按状态显隐。
    static void OnLoad(Form form) {
        EndVeil.visible = false;
        BriefVeil.visible = false;
        Banner.visible = false;
        Tech.visible = false;
        Detail.visible = false;
        Objectives.visible = false;
    }
}

class ForgeInterface {
    App app;
    Form hud;
    ForgeSimulation sim;
    ForgeCamera camera;
    ForgeRenderer renderer;
    BlockKind selected;
    int direction;
    int inspectCell;
    int hoverCell;
    int speed;
    bool paused;
    bool erase;
    bool powerOverlay;
    bool showTech;
    bool newRunArmed;
    bool leftDown;
    bool rightDown;
    bool miniArmed;
    int downCell;
    int lastCell;
    int mouseX;
    int mouseY;
    int previousX;
    int previousY;
    int gestureFlag;
    int lastUiTick;
    int lastEvent;
    int messageUntil;
    bool[] keys;
    string status;
    string savePath;
    string title;
    double uiScale;
    int clientW;
    int clientH;
    int chromeTop;
    int miniX;
    int miniY;
    int miniW;
    int miniH;
    // 蓝图：0=未启用，1=框选中，2=已捕获待粘贴。会话态，不入存档。
    int bpState;
    bool bpDrag;
    int bpAnchor;
    int bpCursor;
    int bpCount;
    int[] bpDX;
    int[] bpDY;
    int[] bpKind;
    int[] bpDir;
    bool rightPanned;
    // 开局简报幕：新远征/再度远征后先选难度再出发。首启不弹（冒烟与自动测试确定性）。
    bool briefing;
    int pendingDifficulty;
    // 下一波兵种构成缓存（Preview 填充，画布预告条读取）。
    int[] preview;

    ForgeInterface(App host, string path) {
        app = host; savePath = path; title = "炉心边境 · COREFORGE";
        sim = new ForgeSimulation(1709); camera = new ForgeCamera(); camera.Focus(sim.world);
        renderer = new ForgeRenderer(); selected = BlockKind.Empty; speed = 1;
        inspectCell = sim.world.coreCell; hoverCell = -1; lastCell = -1; downCell = -1;
        keys = new bool[256];
        bpDX = new int[256]; bpDY = new int[256]; bpKind = new int[256]; bpDir = new int[256];
        preview = new int[5];
        status = "从铜矿到炮塔：沿箭头连接输送线，守住炉心。";
        mouseX = -1; mouseY = -1;
    }

    // ---- 单一缩放 helper：小地图等画布 HUD 的一切尺寸过它（纪律） ----
    int S(int v) { return ForgeGrid.Max(1, (int)(v * uiScale + 0.5)); }
    int Sx(int v) { return (int)(v * uiScale + 0.5); }

    string N(int v) { return Convert.ToString(v); }

    // ================= 事件接线 =================

    // 把设计稿声明的 data-on-click 处理器接到模拟动作上。
    void Attach(Form form) {
        hud = form;
        form.On("hudPause", () => TogglePause());
        form.On("hudSpeed", () => { speed = speed == 1 ? 2 : speed == 2 ? 4 : 1; newRunArmed = false; });
        form.On("hudLaunch", () => { if (!sim.world.waveActive && !sim.world.defeated && !sim.world.victory) { sim.combat.StartWave(); } });
        form.On("hudPower", () => powerOverlay = !powerOverlay);
        form.On("hudTech", () => showTech = !showTech);
        form.On("hudSave", () => Save());
        form.On("hudLoad", () => Load());
        form.On("hudHome", () => camera.Focus(sim.world));
        form.On("hudNew", () => NewRun());
        form.On("hudRecipe", () => CycleRecipe());
        form.On("hudTarget", () => CycleTarget());
        form.On("hudFeed", () => Feed());
        form.On("hudRotate", () => Rotate());
        form.On("hudDemolish", () => { erase = !erase; selected = BlockKind.Empty; });
        form.On("hudCancel", () => Cancel());
        form.On("hudAgain", () => RestartRun());
        form.On("hudLoad2", () => Load());
        form.On("hudTech1", () => Research(1));
        form.On("hudTech2", () => Research(2));
        form.On("hudTech3", () => Research(3));
        form.On("hudTech4", () => Research(4));
        form.On("hudTech5", () => Research(5));
        form.On("hudTech6", () => Research(6));
        form.On("hudTech7", () => Research(7));
        form.On("hudTech8", () => Research(8));
        form.On("hudTech9", () => Research(9));
        form.On("hudTech10", () => Research(10));
        form.On("hudTech11", () => Research(11));
        form.On("hudTech12", () => Research(12));
        form.On("hudTech13", () => Research(13));
        form.On("hudTech14", () => Research(14));
        form.On("hudDrones", () => CycleDrones());
        form.On("hudBlueprint", () => ToggleBlueprint());
        form.On("hudEndless", () => ContinueEndless());
        form.On("hudDiff0", () => { pendingDifficulty = 0; });
        form.On("hudDiff1", () => { pendingDifficulty = 1; });
        form.On("hudDiff2", () => { pendingDifficulty = 2; });
        form.On("hudDepart", () => DepartBriefing());
        // 蓝图数组是引用：让渲染器直接读同一份存储，避免每帧拷贝。
        renderer.bpDX = bpDX; renderer.bpDY = bpDY; renderer.bpKind = bpKind; renderer.bpDir = bpDir;
        form.On("hudB2", () => SelectBlock(2));
        form.On("hudB3", () => SelectBlock(3));
        form.On("hudB4", () => SelectBlock(4));
        form.On("hudB5", () => SelectBlock(5));
        form.On("hudB6", () => SelectBlock(6));
        form.On("hudB7", () => SelectBlock(7));
        form.On("hudB8", () => SelectBlock(8));
        form.On("hudB9", () => SelectBlock(9));
        form.On("hudB10", () => SelectBlock(10));
        form.On("hudB11", () => SelectBlock(11));
        form.On("hudB12", () => SelectBlock(12));
        form.On("hudB13", () => SelectBlock(13));
        form.On("hudB14", () => SelectBlock(14));
        form.On("hudB15", () => SelectBlock(15));
        form.On("hudB16", () => SelectBlock(16));
        form.On("hudB17", () => SelectBlock(17));
        form.On("hudB18", () => SelectBlock(18));
        form.On("hudB19", () => SelectBlock(19));
        form.On("hudB20", () => SelectBlock(20));
        form.On("hudB21", () => SelectBlock(21));
        form.On("hudB22", () => SelectBlock(22));
    }

    // 铁蜂全军模式切换：守卫（拦截来犯）↔ 进攻（拔除敌巢出兵口）。
    void CycleDrones() {
        sim.world.droneMode = !sim.world.droneMode;
        Message(sim.world.droneMode
          ? "铁蜂转入进攻：将飞向最近的存活敌巢并拔除出兵口。"
          : "铁蜂转入守卫：拦截逼近炉心的来犯敌人。");
    }

    // ================= 蓝图复制/粘贴 =================

    // B 键 / 工具栏：未启用→进入框选；已捕获→收起。
    void ToggleBlueprint() {
        if (bpState == 0) {
            bpState = 1; bpCount = 0; bpDrag = false;
            selected = BlockKind.Empty; erase = false; showTech = false;
            Message("蓝图框选：按住左键框住要复制的建筑，松开完成捕获。");
        } else {
            bpState = 0; bpCount = 0; bpDrag = false;
            Message("蓝图工具已收起。");
        }
    }

    // 松开左键：框内所有非炉心建筑按相对左上角的偏移记入蓝图。
    void CaptureRegion() {
        ForgeWorld w = sim.world;
        bpDrag = false;
        int ax = bpAnchor % w.width; int ay = bpAnchor / w.width;
        int cx = bpCursor % w.width; int cy = bpCursor / w.width;
        int x0 = ForgeGrid.Min(ax, cx); int x1 = ForgeGrid.Max(ax, cx);
        int y0 = ForgeGrid.Min(ay, cy); int y1 = ForgeGrid.Max(ay, cy);
        bpCount = 0;
        for (int y = y0; y <= y1; y = y + 1) {
            for (int x = x0; x <= x1; x = x + 1) {
                if (bpCount >= 256) { break; }
                ForgeBuilding b = w.buildings[w.Index(x, y)];
                if (b.kind == BlockKind.Empty || b.kind == BlockKind.Core) { continue; }
                bpDX[bpCount] = x - x0; bpDY[bpCount] = y - y0;
                bpKind[bpCount] = (int)b.kind; bpDir[bpCount] = b.direction;
                bpCount = bpCount + 1;
            }
        }
        if (bpCount == 0) { Message("框内没有建筑：按住左键框住要复制的部分。"); return; }
        bpState = 2;
        Message("蓝图已捕获 " + N(bpCount) + " 座建筑：左键粘贴（可多处粘贴），R 旋转，Q 收起。");
    }

    // 把蓝图粘到以 anchor 为左上角的区域；越界/占位/缺资源的格子跳过。
    void PasteAt(int anchor) {
        if (bpCount == 0 || anchor < 0) { return; }
        ForgeWorld w = sim.world;
        int ax = anchor % w.width; int ay = anchor / w.width;
        int placed = 0; int skipped = 0;
        for (int i = 0; i < bpCount; i = i + 1) {
            int x = ax + bpDX[i]; int y = ay + bpDY[i];
            if (x < 0 || y < 0 || x >= w.width || y >= w.height) { skipped = skipped + 1; continue; }
            BlockKind kind = (BlockKind)bpKind[i];
            if (w.BuildError(w.Index(x, y), kind) != "") { skipped = skipped + 1; continue; }
            w.Build(w.Index(x, y), kind, bpDir[i]);
            placed = placed + 1;
        }
        Message("蓝图粘贴 " + N(placed) + " 座" + (skipped > 0 ? "，跳过 " + N(skipped) + " 处（占位或资源不足）。" : "。"));
    }

    // R 键：顺时针旋转 90°——位移向量与建筑朝向同步旋转，再归到非负象限。
    void RotateBlueprint() {
        for (int i = 0; i < bpCount; i = i + 1) {
            int dx = bpDX[i]; int dy = bpDY[i];
            bpDX[i] = -dy; bpDY[i] = dx;
            bpDir[i] = (bpDir[i] + 1) % 4;
        }
        int minX = 0; int minY = 0;
        for (int i = 0; i < bpCount; i = i + 1) {
            if (bpDX[i] < minX) { minX = bpDX[i]; }
            if (bpDY[i] < minY) { minY = bpDY[i]; }
        }
        for (int i = 0; i < bpCount; i = i + 1) {
            bpDX[i] = bpDX[i] - minX; bpDY[i] = bpDY[i] - minY;
        }
        Message("蓝图已旋转 90°。");
    }

    // 结算幕"无尽坚守"：撤下胜利幕，波表转公式生成、强度无限爬升。
    void ContinueEndless() {
        sim.world.victory = false;
        sim.world.endless = true;
        sim.world.nextWaveTicks = ForgeCombat.BetweenWaveTicks();
        paused = false;
        lastEvent = sim.world.events.sequence;
        Message("无尽坚守已开启：波次不再有终点，敌军将持续变强。");
    }

    void SelectBlock(int id) {
        selected = (BlockKind)id;
        erase = false;
        showTech = false;
        newRunArmed = false;
    }

    void TogglePause() {
        paused = !paused;
        newRunArmed = false;
    }

    // 结算幕里的"再度远征"：跳过二次确认，直接进入开局简报选难度。
    void RestartRun() {
        newRunArmed = false;
        ArmBriefing(sim.world.seed + 37);
    }

    // 重置一局并在简报幕上待命：世界已就绪但暂停，出发按钮落难度开战。
    void ArmBriefing(int seed) {
        sim = new ForgeSimulation(seed);
        camera.Focus(sim.world);
        inspectCell = sim.world.coreCell;
        selected = BlockKind.Empty;
        erase = false;
        paused = true;
        briefing = true;
        pendingDifficulty = 1;
        lastEvent = 0;
        leftDown = false;
        rightDown = false;
        bpState = 0; bpDrag = false; bpCount = 0;
    }

    // 简报幕"出发"：难度生效，撤幕开战。
    void DepartBriefing() {
        briefing = false;
        sim.world.difficulty = pendingDifficulty;
        paused = false;
        lastEvent = sim.world.events.sequence;
        Message(difficultyLabel(pendingDifficulty) + "远征出发：先接通铜矿运输线，炉心交给你了。");
    }

    string difficultyLabel(int d) {
        if (d <= 0) { return "平静 · "; }
        if (d >= 2) { return "严酷 · "; }
        return "标准 · ";
    }

    // ================= 帧渲染 =================

    void Render() {
        Canvas c = app.canvas;
        clientW = app.ClientWidth(); clientH = app.ClientHeight();
        chromeTop = app.ContentTop();
        uiScale = clientW / 1280.0;
        // 世界全屏铺底（HUD 控件树之下）——游戏画面本体。
        camera.SetViewport(0, chromeTop, clientW, clientH - chromeTop);
        ApplyShake();
        // 蓝图会话态喂给渲染器画框选矩形与幽灵预览（数组已在 Attach 共享）。
        renderer.bpState = bpState; renderer.bpCount = bpCount;
        renderer.bpAnchor = bpAnchor; renderer.bpDrag = bpDrag;
        renderer.Draw(c, sim.world, camera, hoverCell, selected, direction, erase, inspectCell, powerOverlay);
        ThreatArrows(c);
        Minimap(c);
        WavePreview(c);
        RefreshHud();
    }

    // 屏震衰减：确定性位移（取 world.tick 哈希），无随机数。
    void ApplyShake() {
        int mag = sim.world.shake;
        if (mag <= 0) { camera.SetShake(0, 0); return; }
        int sx = ((sim.world.tick * 73 + 31) % 17 - 8) * mag / 8;
        int sy = ((sim.world.tick * 137 + 71) % 13 - 6) * mag / 8;
        camera.SetShake(sx, sy);
    }

    // ---- 小地图：画布上唯一的战略视图，点击跳转视角 ----
    void Minimap(Canvas c) {
        ForgeWorld w = sim.world;
        int tile = S(4);
        miniW = w.width * tile;
        miniH = w.height * tile;
        miniX = clientW - miniW - S(12);
        // 底部 HUD 共 102 设计像素（建造栏 74 + 状态栏 28），小地图必须收在其上。
        miniY = clientH - S(102) - miniH - S(12);
        c.FillRect(miniX - S(3), miniY - S(3), miniW + S(6), miniH + S(6), 0xB4140F0A);
        c.DrawRect(miniX - S(3), miniY - S(3), miniW + S(6), miniH + S(6), 0xFF4D3D24, 1);
        for (int cell = 0; cell < w.width * w.height; cell = cell + 1) {
            ForgeBuilding b = w.buildings[cell];
            int color;
            if (b.kind != BlockKind.Empty) { color = BlockAccent((int)b.kind); }
            else {
                ForgeTile t = w.tiles[cell];
                if (t.ore >= 0) { color = ChipColor(t.ore); }
                else if (t.terrain == TerrainKind.Water) { color = 0xFF2E5F63; }
                else if (t.terrain == TerrainKind.Oil) { color = 0xFF332A44; }
                else { color = 0xFF37321F; }
            }
            c.FillRect(miniX + (cell % w.width) * tile, miniY + (cell / w.width) * tile, tile, tile, color);
        }
        // 敌情红点。
        for (int i = 0; i < w.enemies.Length; i = i + 1) {
            ForgeEnemy e = w.enemies[i];
            if (!e.active) { continue; }
            int px = miniX + e.x / (1000 / tile);
            int py = miniY + e.y / (1000 / tile);
            c.FillRect(px - 1, py - 1, tile + 1, tile + 1, 0xFFFF6A4A);
        }
        // 敌巢（出兵口）：紫红大点，拔除后消失——战略一目了然。
        for (int lane = 0; lane < 3; lane = lane + 1) {
            ForgeNest n = w.nests[lane];
            if (!n.active) { continue; }
            c.FillRect(miniX + n.x * tile - 1, miniY + n.y * tile - 1, tile + 2, tile + 2, 0xFFE86A6A);
            c.DrawRect(miniX + n.x * tile - 1, miniY + n.y * tile - 1, tile + 2, tile + 2, 0xFFFFD2B8, 1);
        }
        // 铁蜂：友军青点。
        for (int i = 0; i < w.units.Length; i = i + 1) {
            ForgeUnit u = w.units[i];
            if (!u.active) { continue; }
            c.FillRect(miniX + u.x / (1000 / tile), miniY + u.y / (1000 / tile), tile, tile, 0xFF8FD9C1);
        }
        // 炉心亮点。
        int corePx = miniX + (w.coreCell % w.width) * tile;
        int corePy = miniY + (w.coreCell / w.width) * tile;
        c.FillRect(corePx, corePy, tile, tile, 0xFFFFD98F);
        // 视口框。
        int vw = (int)(clientW / (ForgeGrid.TileSize() * camera.zoom)) * tile;
        int vh = (int)((clientH - chromeTop) / (ForgeGrid.TileSize() * camera.zoom)) * tile;
        int vx = miniX + (int)(camera.x * tile) - vw / 2;
        int vy = miniY + (int)(camera.y * tile) - vh / 2;
        c.DrawRect(vx, vy, vw, vh, 0x90F3EAD9, 1);
    }

    // ---- 边缘预警：进攻或临近时指向三条敌军通道 ----
    void ThreatArrows(Canvas c) {
        ForgeWorld w = sim.world;
        if (w.defeated || w.victory) { return; }
        if (!w.waveActive && w.nextWaveTicks > 1500) { return; }
        int alpha = 150 + (int)(w.tick % 40) * 2;
        if (alpha > 235) { alpha = 235; }
        int color = (alpha << 24) | 0xCF5A35;
        for (int lane = 0; lane < 3; lane = lane + 1) {
            if (!w.nests[lane].active) { continue; }  // 巢穴已拔除的通道永绝敌人，无需预警
            int cell = ForgeMap.SpawnCell(w, lane);
            int cx = camera.ScreenX((cell % w.width) * 1000 + 500);
            int cy = camera.ScreenY((cell / w.width) * 1000 + 500);
            // 出生口在视口内就不必预警；在视口外则把箭头钳到视口边缘。
            int mx = ForgeGrid.Clamp(cx, chromeTop + S(26), clientW - S(26));
            int my = ForgeGrid.Clamp(cy, chromeTop + S(56), clientH - S(112));
            if (cx == mx && cy == my) { continue; }
            int a = S(11);
            if (cx < mx) {  // 西通道：箭头朝左
                c.DrawLine(mx + a, my - a, mx, my, color, S(3));
                c.DrawLine(mx, my, mx + a, my + a, color, S(3));
            } else if (cx > mx) {  // 东通道：箭头朝右
                c.DrawLine(mx - a, my - a, mx, my, color, S(3));
                c.DrawLine(mx, my, mx - a, my + a, color, S(3));
            } else if (cy < my) {  // 北通道：箭头朝上
                c.DrawLine(mx - a, my + a, mx, my, color, S(3));
                c.DrawLine(mx, my, mx + a, my + a, color, S(3));
            } else {
                c.DrawLine(mx - a, my - a, mx, my, color, S(3));
                c.DrawLine(mx, my, mx + a, my - a, color, S(3));
            }
        }
    }

    // ---- 波次预告条：准备期挂在 HUD 两行之下（顶栏46+工具栏34）， ----
    // 兵种构成 + 数量 + 倒计时；不能画在 chromeTop+8 以内，会被控件树盖住。
    // 与出兵共用 ForgeCombat.Preview 公式，预告即真相；难度标签随档显示。
    void WavePreview(Canvas c) {
        ForgeWorld w = sim.world;
        if (briefing || w.defeated || w.victory || w.waveActive) { return; }
        int nests = 0;
        for (int i = 0; i < w.nests.Length; i = i + 1) { if (w.nests[i].active) { nests = nests + 1; } }
        if (nests == 0) { return; }  // 出兵口已全拔除：无波可预告
        int next = w.wave + 1;
        ForgeCombat.Preview(w, next, preview);
        bool boss = ForgeCombat.WaveBoss(w, next) >= 0;
        int used = 0;
        for (int k = 0; k < 5; k = k + 1) { if (preview[k] > 0) { used = used + 1; } }
        int pad = S(14);
        int chip = S(52);
        int headW = S(96) + (w.difficulty == 1 ? 0 : S(52));
        int countdownW = S(48);
        int width = pad + headW + used * chip + (boss ? S(56) : 0) + countdownW + pad;
        int height = S(38);
        int x = clientW / 2 - width / 2;
        int y = chromeTop + S(92);
        c.FillRect(x, y, width, height, 0xE01A130A);
        c.DrawRect(x, y, width, height, 0xFF4D3D24, 1);
        int cy = y + height / 2 + S(5);
        string tag = w.difficulty == 0 ? " · 平静" : w.difficulty == 2 ? " · 严酷" : "";
        c.DrawText(x + pad, cy, "第 " + N(next) + " 波来袭" + tag, 0xFFF2A558, S(14));
        int cx = x + pad + headW;
        int midY = y + height / 2;
        for (int k = 0; k < 5; k = k + 1) {
            if (preview[k] <= 0) { continue; }
            c.FillCircle(cx + S(5), midY, S(4), KindColor(k));
            c.DrawCircle(cx + S(5), midY, S(4), 0xFF14100B, 1);
            c.DrawText(cx + S(13), cy, "×" + N(preview[k]), 0xFFF3EAD9, S(13));
            cx = cx + chip;
        }
        if (boss) {
            c.DrawText(cx, cy, "⚠ 首领压阵", 0xFFFF9D6C, S(13));
            cx = cx + S(56);
        }
        string countdown = N((w.nextWaveTicks + 49) / 50) + "s";
        c.DrawText(x + width - pad - Canvas.MeasureText(countdown, S(14)), cy, countdown, 0xFFCDBB97, S(14));
    }

    int KindColor(int kind) {
        if (kind == 0) { return 0xFFC9A06A; }
        if (kind == 1) { return 0xFF9F8AC9; }
        if (kind == 2) { return 0xFFE86A8A; }
        if (kind == 3) { return 0xFF8FC9E8; }
        return 0xFFE89A5A;
    }

    // ---- 建造栏图标的强调色（与世界美术同族，小地图/预警共用） ----
    int ChipColor(int item) {
        if (item == 0) { return 0xFFE8A05D; }
        if (item == 1) { return 0xFFB5A3C9; }
        if (item == 2) { return 0xFF7C8792; }
        if (item == 3) { return 0xFF9DE8CA; }
        if (item == 4) { return 0xFFC0CCD3; }
        if (item == 5) { return 0xFF7ECAEC; }
        return 0xFFE2D5B5;
    }

    int BlockAccent(int id) {
        if (id == 2) { return 0xFFE8A05D; }  // 钻头：铜
        if (id == 3) { return 0xFFC0CCD3; }  // 传送带：钢
        if (id == 4) { return 0xFFB5A3C9; }  // 分流器：铅
        if (id == 5) { return 0xFFE08A3C; }  // 熔炉：熔核
        if (id == 6) { return 0xFF9DE8CA; }  // 装配机：硅
        if (id == 7) { return 0xFFF2A558; }  // 发电机：暖琥珀
        if (id == 8) { return 0xFF8FAE4E; }  // 蓄电池：苔绿
        if (id == 9) { return 0xFFCF5A35; }  // 炮塔：赤铜
        if (id == 10) { return 0xFF8A8F96; }  // 墙：岩灰
        if (id == 11) { return 0xFF6F95A8; }  // 泵：水蓝
        if (id == 12) { return 0xFF587D8B; }  // 管道：深青
        if (id == 13) { return 0xFFD9A13C; }  // 中继：警示金
        if (id == 14) { return 0xFF9A7DB8; }  // 油井：油紫
        if (id == 15) { return 0xFFC9836A; }  // 散射：双管铜棕
        if (id == 16) { return 0xFF7FA8D9; }  // 狙击：镜筒青蓝
        if (id == 17) { return 0xFFB0894A; }  // 臼炮：臼身土金
        if (id == 18) { return 0xFF7FBF9E; }  // 铁蜂机巢：坪面青绿
        if (id == 19) { return 0xFFB9A8E8; }  // 棱镜塔：水晶紫
        if (id == 20) { return 0xFF8FD9A8; }  // 修复投影：医疗绿
        if (id == 21) { return 0xFFF2C06A; }  // 过护投影：过载琥珀
        if (id == 22) { return 0xFF7ECAEC; }  // 力场护盾：力场青
        return 0xFF93825F;
    }

    // ================= 每帧 HUD 回写 =================

    void RefreshHud() {
        ForgeWorld w = sim.world;
        // 顶栏资源。
        CoreforgeHud.rCopper.Text = w.catalog.items[0] + " " + N(w.resources.Get(0));
        CoreforgeHud.rLead.Text = w.catalog.items[1] + " " + N(w.resources.Get(1));
        CoreforgeHud.rGraphite.Text = w.catalog.items[2] + " " + N(w.resources.Get(2));
        CoreforgeHud.rTitanium.Text = w.catalog.items[5] + " " + N(w.resources.Get(5));
        // 波次文案：进攻期换热色。
        bool hot = false;
        string waveLabel;
        if (w.defeated) { waveLabel = "炉心失守"; }
        else if (w.victory) { waveLabel = "远征胜利"; }
        else if (w.waveActive) {
            hot = true;
            waveLabel = "第 " + N(w.wave) + " 波 · 敌军 " + N(w.enemyCount) + " · 待抵达 " + N(w.spawnRemaining);
        } else {
            waveLabel = w.endless
              ? "第 " + N(w.wave + 1) + " 波 · 无尽 · 准备 " + N((w.nextWaveTicks + 49) / 50) + " 秒"
              : "第 " + N(w.wave) + " / 20 波 · 准备 " + N((w.nextWaveTicks + 49) / 50) + " 秒";
        }
        CoreforgeHud.waveText.Text = waveLabel;
        CoreforgeHud.waveText.SetClassIn("cf-wave cf-wave-hot", hot ? "cf-wave-hot" : "cf-wave");
        // 炉心耐久与电网。
        int hpPct = ForgeGrid.Max(0, w.buildings[w.coreCell].hp) * 100 / w.coreMaxHp;
        CoreforgeHud.hpBar.SetPercent(hpPct);
        CoreforgeHud.hpText.Text = "炉心 " + N(hpPct) + "% · 电力 " + N(w.powerSupply) + " / " + N(w.powerDemand)
          + " · 储能 " + N(w.batteryStored / 1000) + "k · 铁蜂 " + N(w.ActiveUnits()) + "/" + N(ForgeGrid.DroneLimit());
        // 铁蜂模式按钮：守卫/进攻全局切换。
        CoreforgeHud.btnDrones.Text = w.droneMode ? "铁蜂·进攻" : "铁蜂·守卫";
        CoreforgeHud.btnDrones.SetClassIn("cf-mini-on", w.droneMode ? "cf-mini-on" : "");
        CoreforgeHud.btnDrones.visible = w.researched[10] && !w.defeated && !w.victory;
        // 蓝图按钮：常驻文案避免工具栏回流；状态靠高亮与世界叠加层表达。
        CoreforgeHud.btnBlueprint.SetClassIn("cf-mini-on", bpState != 0 ? "cf-mini-on" : "");
        CoreforgeHud.btnBlueprint.Disabled = w.defeated;
        // 节奏按钮。
        CoreforgeHud.btnPause.Text = paused ? "继续" : "暂停";
        CoreforgeHud.btnPause.SetClassIn("cf-on", paused ? "cf-on" : "");
        CoreforgeHud.btnSpeed.Text = "×" + N(speed);
        CoreforgeHud.btnSpeed.SetClassIn("cf-on", speed > 1 ? "cf-on" : "");
        CoreforgeHud.btnLaunch.Disabled = w.waveActive || w.defeated || w.victory;
        // 全局开关态。
        CoreforgeHud.btnPower.SetClassIn("cf-mini-on", powerOverlay ? "cf-mini-on" : "");
        CoreforgeHud.btnTech.SetClassIn("cf-mini-on", showTech ? "cf-mini-on" : "");
        CoreforgeHud.btnDemolish.SetClassIn("cf-mini-on", erase ? "cf-mini-on" : "");
        CoreforgeHud.btnNew.Text = newRunArmed ? "确认重启？" : "新远征";
        // 建造栏：只显示已解锁的方块，选中态换底色。
        Button[] palette = new Button[21] { CoreforgeHud.pb2, CoreforgeHud.pb3, CoreforgeHud.pb4, CoreforgeHud.pb5, CoreforgeHud.pb6,
          CoreforgeHud.pb7, CoreforgeHud.pb8, CoreforgeHud.pb9, CoreforgeHud.pb10, CoreforgeHud.pb11,
          CoreforgeHud.pb12, CoreforgeHud.pb13, CoreforgeHud.pb14, CoreforgeHud.pb15, CoreforgeHud.pb16, CoreforgeHud.pb17,
          CoreforgeHud.pb18, CoreforgeHud.pb19, CoreforgeHud.pb20, CoreforgeHud.pb21, CoreforgeHud.pb22 };
        for (int k = 2; k < 23; k = k + 1) {
            Button pb = palette[k - 2];
            bool unlocked = sim.world.Unlocked((BlockKind)k);
            pb.visible = unlocked;
            pb.SetClassIn("cf-build-on", !erase && selected == (BlockKind)k ? "cf-build-on" : "");
        }
        // 远征目标（完成即收起，让位科技面板）。
        int belts = 0; int drills = 0; int furnaces = 0; int turrets = 0; int power = 0;
        for (int i = 0; i < w.buildings.Length; i = i + 1) {
            BlockKind k = w.buildings[i].kind;
            if (k == BlockKind.Belt) { belts = belts + 1; }
            else if (k == BlockKind.Drill) { drills = drills + 1; }
            else if (k == BlockKind.Furnace) { furnaces = furnaces + 1; }
            else if (ForgeCombat.TurretFamily(k)) { turrets = turrets + 1; }
            else if (k == BlockKind.Generator || k == BlockKind.Battery) { power = power + 1; }
        }
        bool[] done = new bool[5];
        done[0] = belts >= 6;
        done[1] = drills >= 6;
        done[2] = furnaces >= 1;
        done[3] = turrets >= 4 && power >= 1;
        done[4] = w.wave > 3 || w.victory;
        Label[] obj = new Label[5] { CoreforgeHud.obj0, CoreforgeHud.obj1, CoreforgeHud.obj2, CoreforgeHud.obj3, CoreforgeHud.obj4 };
        string[] objText = new string[5] {
            "铺设 6 段传送带（" + N(ForgeGrid.Min(belts, 6)) + "/6）",
            "运行 6 座钻头（" + N(ForgeGrid.Min(drills, 6)) + "/6）",
            "建造 1 座熔炉" + (done[2] ? "" : "，把矿石炼成建材"),
            "4 座炮塔 + 1 座供电（" + N(ForgeGrid.Min(turrets, 4)) + "/4）",
            "打退第 3 波进攻" + (done[4] ? "" : "，迎敌按钮提前开战"),
        };
        bool allDone = true;
        for (int i = 0; i < 5; i = i + 1) {
            if (!done[i]) { allDone = false; }
            obj[i].Text = (done[i] ? "✔ " : "· ") + objText[i];
            obj[i].SetClassIn("cf-obj cf-obj-done", done[i] ? "cf-obj-done" : "cf-obj");
        }
        CoreforgeHud.Objectives.visible = !allDone && !showTech && !w.defeated && !w.victory;
        // 科技面板。
        CoreforgeHud.Tech.visible = showTech && !w.defeated && !w.victory;
        Button[] techRow = new Button[14] { CoreforgeHud.tech1, CoreforgeHud.tech2, CoreforgeHud.tech3, CoreforgeHud.tech4, CoreforgeHud.tech5,
          CoreforgeHud.tech6, CoreforgeHud.tech7, CoreforgeHud.tech8, CoreforgeHud.tech9, CoreforgeHud.tech10, CoreforgeHud.tech11,
          CoreforgeHud.tech12, CoreforgeHud.tech13, CoreforgeHud.tech14 };
        for (int i = 1; i <= 14; i = i + 1) {
            TechDef t = w.catalog.techs[i];
            bool finished = w.researched[i];
            bool ready = !finished && w.researched[t.parent] && w.resources.Has(t.cost);
            techRow[i - 1].Text = (finished ? "✔ 已完成 · " : ready ? "▶ 研究 · " : "🔒 锁定 · ") + t.name + "　" + Cost(t.cost);
            techRow[i - 1].Disabled = !ready;
        }
        // 选中/点检详情。
        string body = DetailBody();
        CoreforgeHud.Detail.visible = body != "";
        CoreforgeHud.detTitle.Text = DetailTitle();
        CoreforgeHud.detBody.Text = body;
        CoreforgeHud.btnRecipe.visible = RecipeBtn() != "";
        CoreforgeHud.btnTarget.visible = TargetBtn();
        CoreforgeHud.btnFeed.visible = FeedBtn();
        // 波幅横幅。
        bool bannerOn = w.waveActive && !w.defeated && !w.victory;
        CoreforgeHud.Banner.visible = bannerOn;
        CoreforgeHud.bannerText.Text = "⚑ 第 " + N(w.wave) + " 波 · 守住炉心";
        // 状态栏。
        CoreforgeHud.statusText.Text = paused ? "已暂停 · 可以规划、建造和研究。" : status;
        // 结算幕。
        bool ended = w.defeated || w.victory;
        CoreforgeHud.EndVeil.visible = ended;
        if (ended) {
            CoreforgeHud.endTitle.Text = w.victory ? "远征胜利" : "炉心失守";
            int minutes = w.tick / 50 / 60;
            int seconds = w.tick / 50 % 60;
            CoreforgeHud.endStats.Text = "坚守 " + N(ForgeGrid.Max(0, w.wave - 1)) + " 波 · 击杀 " + N(w.kills)
              + " · 生产 " + N(w.produced) + " · 历时 " + N(minutes) + " 分 " + N(seconds) + " 秒";
            CoreforgeHud.btnEndless.visible = w.victory;
        }
        // 开局简报幕：新远征/再度远征后选难度；出发前世界已就绪并暂停。
        CoreforgeHud.BriefVeil.visible = briefing;
        if (briefing) {
            CoreforgeHud.diff0.SetClassIn("cf-diff-on", pendingDifficulty == 0 ? "cf-diff-on" : "");
            CoreforgeHud.diff1.SetClassIn("cf-diff-on", pendingDifficulty == 1 ? "cf-diff-on" : "");
            CoreforgeHud.diff2.SetClassIn("cf-diff-on", pendingDifficulty == 2 ? "cf-diff-on" : "");
            CoreforgeHud.briefHint.Text = pendingDifficulty == 0 ? "敌军数量 85% · 强度 80% —— 熟悉生产线的好时机"
              : pendingDifficulty == 2 ? "敌军数量 120% · 强度 130% —— 老兵的试炼场"
              : "敌军数量与强度均为基准值";
        }
    }

    // ================= 详情文案 =================

    string DetailTitle() {
        ForgeWorld w = sim.world;
        if (selected != BlockKind.Empty) {
            return w.catalog.blocks[(int)selected].name + " · " + Facing();
        }
        if (inspectCell >= 0 && inspectCell < w.width * w.height) {
            ForgeBuilding b = w.buildings[inspectCell];
            if (b.kind != BlockKind.Empty) { return w.catalog.blocks[(int)b.kind].name; }
            ForgeTile t = w.tiles[inspectCell];
            if (t.ore >= 0) { return w.catalog.items[t.ore] + "矿脉"; }
            if (t.terrain == TerrainKind.Water) { return "水域"; }
            if (t.terrain == TerrainKind.Oil) { return "石油层"; }
        }
        return "";
    }

    string DetailBody() {
        ForgeWorld w = sim.world;
        if (selected != BlockKind.Empty) {
            BlockDef def = w.catalog.blocks[(int)selected];
            return def.help + "\n建造消耗：" + Cost(def.cost);
        }
        if (inspectCell >= 0 && inspectCell < w.width * w.height) {
            ForgeBuilding b = w.buildings[inspectCell];
            ForgeTile t = w.tiles[inspectCell];
            if (b.kind != BlockKind.Empty) {
                string stockLine = Cost(b.stock);
                string details = "HP " + N(b.hp) + " · 效率 " + N(b.efficiency / 10) + "%"
                  + "\n水 " + N(b.water) + " / 油 " + N(b.oil);
                if (b.kind == BlockKind.Shield) {
                    details = "力场 " + N(ForgeGrid.Max(0, b.shield)) + " / " + N(w.catalog.blocks[(int)BlockKind.Shield].hp * 3)
                      + " · 效率 " + N(b.efficiency / 10) + "%"
                      + "\n" + (b.efficiency > 0 ? "供电正常，力场缓慢重张。" : "断电中：力场不再恢复。");
                }
                if (stockLine != "") { details = details + "\n库存 " + stockLine; }
                if (b.kind == BlockKind.Furnace || b.kind == BlockKind.Assembler) {
                    RecipeDef recipe = w.catalog.recipes[b.recipe];
                    details = details + "\n" + recipe.name + "：" + Cost(recipe.input)
                      + " → " + w.catalog.items[recipe.output] + " ×" + N(recipe.quantity);
                }
                return details;
            }
            if (t.ore >= 0) { return "储量 " + N(t.reserve) + "\n选择矿脉钻头进行开采。"; }
            if (t.terrain == TerrainKind.Water) { return "研究热工学后建造取水泵。"; }
            if (t.terrain == TerrainKind.Oil) { return "研究晶格工程后建造油井。"; }
        }
        return "";
    }

    string RecipeBtn() {
        if (inspectCell < 0 || inspectCell >= sim.world.width * sim.world.height) { return ""; }
        ForgeBuilding b = sim.world.buildings[inspectCell];
        if (b.kind != BlockKind.Furnace && b.kind != BlockKind.Assembler) { return ""; }
        return sim.world.catalog.recipes[b.recipe].name;
    }
    bool TargetBtn() {
        if (inspectCell < 0 || inspectCell >= sim.world.width * sim.world.height) { return false; }
        BlockKind k = sim.world.buildings[inspectCell].kind;
        return ForgeCombat.TurretFamily(k) || k == BlockKind.Prism;
    }
    bool FeedBtn() {
        if (inspectCell < 0 || inspectCell >= sim.world.width * sim.world.height) { return false; }
        BlockKind k = sim.world.buildings[inspectCell].kind;
        return ForgeCombat.TurretFamily(k) || k == BlockKind.Generator
          || k == BlockKind.Furnace || k == BlockKind.Assembler || k == BlockKind.DroneFab;
    }
    string TargetLabel() {
        ForgeBuilding b = sim.world.buildings[inspectCell];
        string mode = b.targetMode == 0 ? "最近" : b.targetMode == 1 ? "最弱" : "最强";
        return "索敌 " + mode;
    }
    string FeedLabel() {
        ForgeBuilding b = sim.world.buildings[inspectCell];
        if (b.kind == BlockKind.Generator) { return "投入石墨"; }
        if (ForgeCombat.TurretFamily(b.kind)) { return "投入弹药"; }
        if (b.kind == BlockKind.DroneFab) { return "投入机体材料"; }
        return "投入原料";
    }

    string Cost(Stock stock) {
        string text = "";
        for (int i = 0; i < 6; i = i + 1) {
            if (stock.Get(i) > 0) {
                if (text != "") { text = text + "  "; }
                text = text + sim.world.catalog.items[i] + " " + N(stock.Get(i));
            }
        }
        return text;
    }

    string Facing() {
        if (direction == 0) { return "向东 →"; }
        if (direction == 1) { return "向南 ↓"; }
        if (direction == 2) { return "向西 ←"; }
        return "向北 ↑";
    }

    // ================= HUD 遮蔽与控件点击 =================

    // 世界输入的遮蔽区：chrome 容器（控件树已接管命中与处理）
    // 加上画布小地图。返回 true 的点不再进入世界绘制逻辑。
    bool HudConsumes(int x, int y) {
        if (x < 0 || y < 0) { return false; }
        if (InRect(x, y, CoreforgeHud.Topbar.bx, CoreforgeHud.Topbar.by, CoreforgeHud.Topbar.bw, CoreforgeHud.Topbar.bh)) { return true; }
        if (InRect(x, y, CoreforgeHud.Toolbar.bx, CoreforgeHud.Toolbar.by, CoreforgeHud.Toolbar.bw, CoreforgeHud.Toolbar.bh)) { return true; }
        if (CoreforgeHud.Objectives.visible && InRect(x, y, CoreforgeHud.Objectives.bx, CoreforgeHud.Objectives.by, CoreforgeHud.Objectives.bw, CoreforgeHud.Objectives.bh)) { return true; }
        if (CoreforgeHud.Detail.visible && InRect(x, y, CoreforgeHud.Detail.bx, CoreforgeHud.Detail.by, CoreforgeHud.Detail.bw, CoreforgeHud.Detail.bh)) { return true; }
        if (CoreforgeHud.Tech.visible && InRect(x, y, CoreforgeHud.Tech.bx, CoreforgeHud.Tech.by, CoreforgeHud.Tech.bw, CoreforgeHud.Tech.bh)) { return true; }
        if (CoreforgeHud.Banner.visible && InRect(x, y, CoreforgeHud.Banner.bx, CoreforgeHud.Banner.by, CoreforgeHud.Banner.bw, CoreforgeHud.Banner.bh)) { return true; }
        if (InRect(x, y, CoreforgeHud.Palette.bx, CoreforgeHud.Palette.by, CoreforgeHud.Palette.bw, CoreforgeHud.Palette.bh)) { return true; }
        if (InRect(x, y, CoreforgeHud.Statusbar.bx, CoreforgeHud.Statusbar.by, CoreforgeHud.Statusbar.bw, CoreforgeHud.Statusbar.bh)) { return true; }
        if (CoreforgeHud.EndVeil.visible) { return true; }
        if (CoreforgeHud.BriefVeil.visible) { return true; }
        if (InRect(x, y, miniX, miniY, miniW, miniH)) { return true; }
        return false;
    }

    // 自测通道：按控件名找节点并触发它的 click 处理器——与真实
    // 鼠标点击走同一条 form.Call 路径。
    void ClickHud(string controlName) {
        if (hud == null) { return; }
        Control target = FindNamed(hud, controlName);
        if (target == null) { Console.WriteLine("ClickHud " + controlName + " not found"); return; }
        string handler = target.GetHandler("Click");
        if (handler == "") { Console.WriteLine("ClickHud " + controlName + " no handler"); return; }
        hud.Call(handler);
    }

    Control FindNamed(Control node, string name) {
        if (node.name == name) { return node; }
        for (int i = 0; i < node.children.Count; i = i + 1) {
            Control found = FindNamed(node.children[i], name);
            if (found != null) { return found; }
        }
        return null;
    }

    bool InRect(int px, int py, int x, int y, int w, int h) {
        return px >= x && py >= y && px < x + w && py < y + h;
    }

    // ================= 动作 =================

    void Message(string text) {
        status = text;
        messageUntil = sim.world.tick + 250;
    }

    void Cancel() {
        selected = BlockKind.Empty;
        erase = false;
        leftDown = false;
        newRunArmed = false;
        if (bpState != 0) { bpState = 0; bpDrag = false; bpCount = 0; }
    }

    void Rotate() {
        if (bpState == 2) { RotateBlueprint(); return; }
        direction = (direction + 1) % 4;
        if (selected == BlockKind.Empty && inspectCell >= 0) {
            ForgeBuilding b = sim.world.buildings[inspectCell];
            if (b.kind != BlockKind.Empty && b.kind != BlockKind.Core) { b.direction = (b.direction + 1) % 4; }
        }
    }

    void Research(int id) {
        if (id < 1 || id > 14) { return; }
        if (sim.world.Research(id)) { Message("研究完成：" + sim.world.catalog.techs[id].name); }
        else { Message("研究条件未满足，请检查前置科技与核心库存。"); }
    }

    void CycleRecipe() {
        if (inspectCell < 0) { return; }
        ForgeBuilding b = sim.world.buildings[inspectCell];
        if (b.kind == BlockKind.Furnace) { b.recipe = b.recipe == 0 ? 1 : 0; }
        else if (b.kind == BlockKind.Assembler) { b.recipe = b.recipe == 2 ? 3 : 2; }
        b.progress = 0;
    }

    void CycleTarget() {
        if (inspectCell >= 0) {
            ForgeBuilding b = sim.world.buildings[inspectCell];
            b.targetMode = (b.targetMode + 1) % 3;
        }
    }

    void Feed() {
        if (inspectCell < 0) { return; }
        ForgeBuilding b = sim.world.buildings[inspectCell];
        bool ok = false;
        if (b.kind == BlockKind.Sniper) { ok = sim.world.Feed(inspectCell, 1, 6); }
        else if (b.kind == BlockKind.Mortar) { ok = sim.world.Feed(inspectCell, 2, 4); }
        else if (ForgeCombat.TurretFamily(b.kind)) { ok = sim.world.Feed(inspectCell, 0, 6); }
        else if (b.kind == BlockKind.Generator) { ok = sim.world.Feed(inspectCell, 2, 4); }
        else if (b.kind == BlockKind.DroneFab) {
            // 一次投足一架机体的全套材料；不足一套时提示走输送带。
            Stock droneCost = ForgeFactory.DroneCost();
            if (b.stock.Total() + droneCost.Total() <= 24 && sim.world.resources.Has(droneCost)) {
                ok = sim.world.resources.Pay(droneCost);
                if (ok) { for (int i = 0; i < 6; i = i + 1) { b.stock.Add(i, droneCost.Get(i)); } }
            }
        }
        else if (b.kind == BlockKind.Furnace || b.kind == BlockKind.Assembler) {
            Stock inputs = sim.world.catalog.recipes[b.recipe].input;
            if (b.stock.Total() + inputs.Total() <= 24 && sim.world.resources.Has(inputs)) {
                ok = sim.world.resources.Pay(inputs);
                if (ok) { for (int i = 0; i < 6; i = i + 1) { b.stock.Add(i, inputs.Get(i)); } }
            }
        }
        Message(ok ? "已投入原料。持续生产请连接输送带与管道。" : "资源不足或建筑输入仓已满。");
    }

    void Save() {
        Message(ForgeSave.Save(sim.world, savePath) ? "已保存远征。" : "保存失败，请检查存档目录写入权限。");
    }

    void Load() {
        ForgeWorld? loaded = ForgeSave.Load(savePath);
        if (loaded == null) { Message("未找到有效存档，当前远征继续。"); return; }
        sim = new ForgeSimulation(loaded);
        inspectCell = loaded.coreCell;
        camera.Focus(loaded);
        leftDown = false;
        rightDown = false;
        lastCell = -1;
        bpState = 0; bpDrag = false; bpCount = 0;
        briefing = false;
        paused = true;
        lastEvent = loaded.events.sequence;
        Message("存档已恢复，当前暂停；按空格继续。");
    }

    void NewRun() {
        // 两次点击确认保护进行中的远征；暂停或取消解除待命。
        if (!newRunArmed) {
            newRunArmed = true;
            paused = true;
            Message("已暂停。再次点击新远征将重新开始；可先保存当前远征。");
            return;
        }
        newRunArmed = false;
        ArmBriefing(sim.world.seed + 37);
    }

    // ================= 世界输入 =================

    bool OverWorld(int x, int y) {
        return x >= 0 && y >= chromeTop && x < clientW && y < clientH;
    }

    void PaintCell(int cell) {
        if (cell < 0 || cell == lastCell) { return; }
        lastCell = cell;
        if (erase) {
            if (sim.world.Remove(cell, true)) { Message("已拆除，材料与库存已回收。"); }
        } else if (selected != BlockKind.Empty) {
            string error = sim.world.BuildError(cell, selected);
            if (error == "") { sim.world.Build(cell, selected, direction); }
            else { Message(error); }
        } else {
            inspectCell = cell;
        }
    }

    void PaintLine(int from, int to) {
        if (from < 0 || to < 0) { return; }
        int x = from % sim.world.width;
        int y = from / sim.world.width;
        int tx = to % sim.world.width;
        int ty = to / sim.world.width;
        int guard = 0;
        while ((x != tx || y != ty) && guard < 84) {
            if (x != tx) { direction = tx > x ? 0 : 2; x = x + ForgeGrid.Dx(direction); }
            else { direction = ty > y ? 1 : 3; y = y + ForgeGrid.Dy(direction); }
            PaintCell(sim.world.Index(x, y));
            guard = guard + 1;
        }
    }

    // 小地图跳转：把视口中心移到 cell。
    void JumpToCell(int cell) {
        if (cell < 0) { return; }
        ForgeWorld w = sim.world;
        double tx = cell % w.width + 0.5;
        double ty = cell / w.width + 0.5;
        double pixels = ForgeGrid.TileSize() * camera.zoom;
        camera.Pan((camera.x - tx) * pixels, (camera.y - ty) * pixels);
    }

    void Input(int kind, int x, int y, int button, int code, int mods, int flag) {
        previousX = mouseX; previousY = mouseY;
        mouseX = x; mouseY = y;
        clientW = app.ClientWidth(); clientH = app.ClientHeight();
        uiScale = clientW / 1280.0;
        bool over = OverWorld(x, y);
        bool hud = HudConsumes(x, y);
        hoverCell = over && !hud ? camera.CellAt(sim.world, x, y) : -1;
        if (kind == 4 || kind == 5) {
            if (code >= 0 && code < 256) {
                bool repeat = keys[code];
                keys[code] = kind == 4;
                if (kind == 4 && !repeat) {
                    if (code == 32) { TogglePause(); }
                    else if (code == 82) { Rotate(); }
                    else if (code == 81 || code == 27) { Cancel(); }
                    else if (code == 88) { erase = !erase; selected = BlockKind.Empty; }
                    else if (code == 84) { showTech = !showTech; }
                    else if (code == 66) { ToggleBlueprint(); }
                    else if (code == 49) { SelectBlock((int)BlockKind.Drill); }
                    else if (code == 50) { SelectBlock((int)BlockKind.Belt); }
                    else if (code == 51) { SelectBlock((int)BlockKind.Turret); }
                }
            }
        } else if (kind == 13 && over && !hud) {
            // 桌面滚轮：每 ±120 格 1.12 倍。原生捏合（mods=1）携带
            // 120*log2(距离比)，2^(code/120) 与手指距离精确一致。
            double factor = mods == 1 ? Math.Pow(2.0, (double)code / 120.0)
              : Math.Pow(1.12, (double)code / 120.0);
            camera.ZoomAt(factor, x, y);
        } else if (kind == 2) {
            if (button == 0) {
                if (hud) { miniArmed = false; }
                else if (InRect(x, y, miniX, miniY, miniW, miniH)) { miniArmed = true; }
                else {
                    leftDown = true; downCell = hoverCell; lastCell = -1;
                    if (bpState == 1 && hoverCell >= 0) { bpAnchor = hoverCell; bpCursor = hoverCell; bpDrag = true; }
                }
            }
            if (button == 1 && over && !hud) { rightDown = true; rightPanned = false; }
        } else if (kind == 1) {
            if (flag > 0) {
                // 每个手势的第一个事件是基准点，不是位移；
                // 起点压在 chrome/小地图上的手势不拖世界。
                if (flag == gestureFlag && over && !hud && !HudConsumes(previousX, previousY)) { camera.Pan(x - previousX, y - previousY); }
                gestureFlag = flag;
                leftDown = false;
            } else if (rightDown) {
                camera.Pan(x - previousX, y - previousY);
                rightPanned = true;
            }
            else if (leftDown && bpState == 1 && hoverCell >= 0) { bpCursor = hoverCell; }
            else if (leftDown && over && hoverCell != downCell) {
                if (selected == BlockKind.Belt || selected == BlockKind.Pipe
                  || selected == BlockKind.Wall || erase) {
                    PaintCell(downCell);
                    PaintLine(downCell, hoverCell);
                    downCell = hoverCell;
                }
            }
        } else if (kind == 3) {
            if (button == 0) {
                if (miniArmed && InRect(x, y, miniX, miniY, miniW, miniH)) {
                    int cell = MiniCellAt(x, y);
                    if (cell >= 0) { JumpToCell(cell); }
                } else if (!hud && flag == 0 && over && bpState == 2) { PasteAt(hoverCell); }
                else if (!hud && flag == 0 && over && bpState == 0) { PaintCell(hoverCell); }
            }
            if (bpState == 1 && bpDrag) { CaptureRegion(); }
            if (button == 1 && rightDown && bpState != 0 && !rightPanned) { ToggleBlueprint(); }
            rightPanned = false;
            miniArmed = false;
            leftDown = false;
            rightDown = false;
            gestureFlag = 0;
            downCell = -1;
            lastCell = -1;
        }
    }

    int MiniCellAt(int x, int y) {
        ForgeWorld w = sim.world;
        int tile = S(4);
        int tx = (x - miniX) / tile;
        int ty = (y - miniY) / tile;
        if (tx < 0 || ty < 0 || tx >= w.width || ty >= w.height) { return -1; }
        return w.Index(tx, ty);
    }

    void TickCamera(int deltaMs) {
        double move = (double)deltaMs * 0.65;
        if (keys[65] || keys[37]) { camera.Pan(move, 0); }
        if (keys[68] || keys[39]) { camera.Pan(-move, 0); }
        if (keys[87] || keys[38]) { camera.Pan(0, move); }
        if (keys[83] || keys[40]) { camera.Pan(0, -move); }
    }

    void TickUi() {
        ForgeWorld w = sim.world;
        if (w.events.sequence > lastEvent) {
            int start = ForgeGrid.Max(lastEvent, w.events.sequence - 64);
            for (int i = start; i < w.events.sequence; i = i + 1) {
                ForgeEvent e = w.events.entries[i % 64];
                if (e.kind == ForgeEventKind.WaveStarted) { Message("敌军接近！检查炮塔弹药与电力，保护运输线。"); }
                if (e.kind == ForgeEventKind.WaveCleared) { Message("波次已清理。补充弹药，趁间歇扩建生产线。"); }
                if (e.kind == ForgeEventKind.CoreLost) { Message("炉心失守。可以读取存档，或开始新的远征。"); }
            }
            lastEvent = w.events.sequence;
        }
        if (messageUntil != 0 && w.tick > messageUntil) {
            status = "";
            messageUntil = 0;
        }
    }
}
