        names.Add("SMIN.VXL");
        names.Add("GACNST.SHP");
        names.Add("GAPOWR.SHP");
        names.Add("GAREFN.SHP");
        names.Add("unittem.pal");
        names.Add("isotem.pal");
        names.Add("CAMEO.PAL");
        names.Add("SIDEBAR.PAL");
        names.Add("GIICON.SHP");
        names.Add("E1ICON.SHP");
        names.Add("CMINICON.SHP");
        names.Add("SMINICON.SHP");
        names.Add("HARVICON.SHP");
        names.Add("MTNKICON.SHP");
        names.Add("GACNSTICON.SHP");
        names.Add("GAPOWRICON.SHP");
        names.Add("CNSTICON.SHP");
        names.Add("AHRVICON.SHP");
        names.Add("POWRICON.SHP");
        names.Add("REFICON.SHP");
        names.Add("GWEPICON.SHP");
        names.Add("BRRKICON.SHP");
        names.Add("TECHICON.SHP");
        names.Add("NWEPICON.SHP");
        names.Add("NREFICON.SHP");
        names.Add("AYARICON.SHP");
        names.Add("GTNKICON.SHP");
        names.Add("MCVICON.SHP");
        names.Add("SMCVICON.SHP");
        names.Add("YPCVICON.SHP");
        names.Add("GDGIICON.SHP");
        names.Add("SNIPICON.SHP");
        names.Add("ENGNICON.SHP");
        names.Add("FLKTICON.SHP");
        names.Add("DOGICON.SHP");
        names.Add("ADOGICON.SHP");
        names.Add("SHKICON.SHP");
        names.Add("BRUTICON.SHP");
        names.Add("YCLNICON.SHP");
        names.Add("INITICON.SHP");
        names.Add("DESOICON.SHP");
        names.Add("CLEGICON.SHP");
        names.Add("TRSTICON.SHP");
        names.Add("LUNRICON.SHP");
        names.Add("JJETICON.SHP");
        names.Add("SPYICON.SHP");
        names.Add("YENGICON.SHP");
        names.Add("SEALICON.SHP");
        names.Add("TANYICON.SHP");
        names.Add("BRISICON.SHP");
        names.Add("PSICICON.SHP");
        names.Add("E2ICON.SHP");
        names.Add("WEEDICON.SHP");
        names.Add("TEMPERAT.INI");
        names.Add("ART.INI");
        names.Add("ARTMD.INI");
        names.Add("SNOW.INI");
        names.Add("URBAN.INI");
        for (int i = 0; i < names.Count; i = i + 1) {
            List<int> len = new List<int>();
            len.Add(0);
            byte[] raw = vfs.Read(names[i], len);
            if (len[0] <= 0) {
                Console.WriteLine("dump miss " + names[i]);
                continue;
            }
            File.WriteBytes("build/_vfs/" + names[i], raw.ToStr(0, len[0]),
                            len[0]);
            Console.WriteLine("dump " + names[i] + " " + Convert.ToString(len[0]));
        }
