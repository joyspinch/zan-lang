    // RA2_SELFTEST_SIDE=soviet runs the same walk as the player's side, so
    // the sidebars' faction tints (Soviet red vs the Allied default) land in
    // the dumps for a visual check.
    static bool SelfTestSoviet() {
        string v = Ra2App.getenv("RA2_SELFTEST_SIDE");
        return v != null && v == "soviet";
    }

    // RA2_SELFTEST_TARGET=options swaps the walk from "menu -> setup ->
    // game" to "menu -> options", so the Options screen gets its own
    // screenshot without paying the cost of the load chain.
    static string SelfTestTarget() {
        string v = Ra2App.getenv("RA2_SELFTEST_TARGET");
        if (v == null) { return ""; }
        return v;
    }

    static int PreviewW() { return 396; }
    static int PreviewH() { return 212; }
    static int MiniW() { return 220; }
    static int MiniH() { return 140; }

    // The load screen's LS800 backdrop, cached by PCX name so flipping
    // countries in setup does not re-decode every frame. Falls back to the
    // generic LOAD.PCX art when the install ships no LS800 for the country.
    static R2Tex LoadingBackdrop(Vfs vfs, string reg) {
        string name = Screens.LsBackdrop(reg);
        if (Ra2App.loadBackdrop != null
         && name == Ra2App.loadBackdropName) { return Ra2App.loadBackdrop; }
        Ra2App.loadBackdrop = null;
        Ra2App.loadBackdropName = "";
        R2Tex tex = ShellArt.LoadPcx(vfs, name, "ra2:loadbg");
        if (tex == null && name != "LOAD.PCX") {
            tex = ShellArt.LoadPcx(vfs, "LOAD.PCX", "ra2:loadbg");
            if (tex != null) { name = "LOAD.PCX"; }
        }
        Ra2App.loadBackdrop = tex;
        Ra2App.loadBackdropName = name;
        return tex;
    }

    // The rules' per-side load colour, [Colors] AlliedLoad / SovietLoad /
    // YuriLoad as 0..255 HSV triplets -- the exact triplets the original's
    // Color.fromHsv turned into the loading screen's bar and caption tint.
    // Defaults stand in when the install's rulesmd.ini lacks the key.
    static void RulesLoadColor(AssetDb db, int side, List<int> rgb) {
        string key = side == Side.Allied() ? "AlliedLoad"
                   : side == Side.Soviet() ? "SovietLoad" : "YuriLoad";
        bool got = false;
        Ra2.Formats.IniDocument rules = db != null ? db.Rules() : null;
        if (rules != null) {
            Ra2.Formats.IniSection colors = rules.Section("Colors");
            if (colors != null) {
                string raw = colors.Get(key);
                if (raw != null && raw.Length > 0) {
                    List<string> parts = raw.Split(',');
                    List<int> hsv = new List<int>();
                    for (int i = 0; i < parts.Count && i < 3; i = i + 1) {
                        hsv.Add(Convert.ToInt32(parts[i].Trim()));
                    }
                    if (hsv.Count == 3) {
                        Screens.HsvToRgb(hsv[0], hsv[1], hsv[2], rgb);
                        got = true;
                    }
                }
            }
        }
        if (!got) {
            if (side == Side.Allied()) {
                Screens.Ra2AppLikeSet(rgb, 255, 110, 110);
            } else if (side == Side.Soviet()) {
                Screens.Ra2AppLikeSet(rgb, 200, 150, 255);
            } else {
                Screens.Ra2AppLikeSet(rgb, 150, 180, 255);
            }
        }
    }

    // The camera is an integer zoom (1:2, 1:1, 2:1); the terrain is drawn
    // into a full-res canvas and the view then scales the span to the window,
    // so a mouse coordinate needs the inverse to land on the terrain pixel.
    static int ScaleX(int viewX, int num, int den) { return viewX * num / den; }
    static int ScaleY(int viewY, int num, int den) { return viewY * num / den; }

    /// <summary>The in-game right sidebar. With the side's shell art present
    /// this is the retail sidebar piece for piece; without it -- an install
    /// whose side mixes are missing -- the drawn fallback below still gives
    /// a working build menu.</summary>
    static void DrawSidebar(R2Canvas r, GameController game, ObjectArt art,
                            SidebarShell shell, int mouseX, int mouseY) {
        if (shell != null && shell.Ok()) {
            Ra2App.DrawShellSidebar(r, game, art, shell, mouseX, mouseY);
            return;
        }
        int x = Ra2App.ViewW() - 296;
        int y = 16;
        int side = game.Side();
        int n = game.World().Catalog().CountFor(game.World(), side);
        StructureCatalog catalog = game.World().Catalog();
        List<int> tint = new List<int>();
        Ra2App.SideUiTint(side, tint);
        // Flat original-style chrome: one dark panel behind everything, no
        // per-button rounded cards. The row of buttons draws itself over it.
        R2Panel.RoundRectFill(r, x, y - 4, 296, Ra2App.BuildMenuH(game) + 26,
                           6, tint[0], tint[1], tint[2], 216);
        R2Text.Draw(r, "建造", x + 14, y + 2, 2, 236, 208, 120, 255);
        int armed = game.BuildingId();
        int i = 0;
        for (; i < n; i = i + 1) {
            int bx = Ra2App.BuildBtnX(i);
            int by = Ra2App.BuildBtnY(i);
            bool unlocked = game.BuildUnlocked(i);
            Ra2App.TileButton(r, mouseX, mouseY, bx, by,
                              Ra2App.BtnW(), Ra2App.BtnH(),
                              i == armed ? 2 : 0, side);
            // The original's cameo tile: a native 60x48 ICON.SHP portrait
            // decoded under CAMEO.PAL, centred in the 62x49 button. Locked
            // entries stay dark like the original's greyed slots.
            Texture icon = null;
            if (unlocked) {
                icon = art.StructureCameoTexture(
                    catalog.TypeFor(game.World(), side, i));
            }
            int labelY = by + Ra2App.BtnH() - 14;
            if (icon != null) {
                int iw = icon.Width();
                int ih = icon.Height();
                R2Tex iconTex = Ra2Ui.TexOf(
                    "ra2:scameo" + Convert.ToString(side) + ":"
                    + Convert.ToString(i), icon);
                r.DrawTexture(iconTex, bx + (Ra2App.BtnW() - iw) / 2,
                              by + (Ra2App.BtnH() - ih) / 2, iw, ih);
                labelY = by + Ra2App.BtnH() - 12;
            }
            string label = StructureLabel(game.World(), catalog, side, i);
            // The tile is 62 wide: a Chinese label past four glyphs clips
            // over the neighbouring button, so trim to what fits.
            while (label.Length > 0
                   && R2Text.Width(r, label, 1) > Ra2App.BtnW() - 4) {
                label = label.Substring(0, label.Length - 1);
            }
            R2Text.DrawCentered(r, label,
                              bx + Ra2App.BtnW() / 2, labelY, 1,
                              unlocked ? 236 : 96, unlocked ? 236 : 102,
                              unlocked ? 236 : 112, 255);
        }
        string powerText = "电力 " + Convert.ToString(game.Power());
        if (game.LowPower()) { powerText = "电力 不足!"; }
        int infoY = y + Ra2App.BuildMenuH(game) + 4;
        R2Text.Draw(r, "资金 " + Convert.ToString(game.Money())
                  + "   敌方 " + Convert.ToString(game.AiMoneyTotal()),
                  x + 14, infoY, 2, 170, 178, 192, 255);
        R2Text.Draw(r, powerText, x + 14, infoY + 20, 2,
                  game.LowPower() ? 232 : 170,
                  game.LowPower() ? 92 : 178,
                  game.LowPower() ? 92 : 192, 255);
        // The 卖/修 pair -- the original's dollar-sign cursor and wrench as
        // two sidebar toggles. The armed one lights up (kind 2) until the
        // next map click spends it or a right click cancels it.
        int srY = infoY + 44;
        int sellKind = game.SellModeArmed() ? 2 : 0;
        int repairKind = game.RepairModeArmed() ? 2 : 0;
        Ra2App.TileButton(r, mouseX, mouseY, Ra2App.SellBtnX(), srY, 62, 26,
                          sellKind, side);
        R2Text.DrawCentered(r, "卖", Ra2App.SellBtnX() + 31, srY + 7, 2,
                          236, 236, 236, 255);
        Ra2App.TileButton(r, mouseX, mouseY, Ra2App.RepairBtnX(), srY, 62, 26,
                          repairKind, side);
        R2Text.DrawCentered(r, "修", Ra2App.RepairBtnX() + 31, srY + 7, 2,
                          236, 236, 236, 255);
        Ra2App.DrawProduction(r, game, art, mouseX, mouseY);
    }

    // ---- the retail sidebar shell ------------------------------------------

    // The left edge of the active sidebar: the shell's credits width when the
    // side art is present, the fallback panel's otherwise. Set when a game
    // loads, read by every sidebar hit test.
    static int sidebarX0 = -1;

    // The cameo card's paging, in pages of whole slot rows; reset whenever
    // the item list shrinks past it.
    static int cardPage = 0;

    // The structures card's page, the original's tab pair: 0 建筑物,
    // 1 防御设施. The infantry and vehicle tabs light from the producer's
    // trainees; they are not clickable until unit cards list base-wide.
    static int buildTab = 0;

    // The in-game game menu (Esc), the original's SIDEBTTN stack over the
    // sidebar: screen 0 is home, 1 the 放弃任务 confirm. menuPressed is the
    // button under a held left click -- its art's frame 1.
    static bool gameMenu = false;
    static int gameMenuScreen = 0;
    static int menuPressed = -1;
    static Strings menuUi;

    /// <summary>The shell's layout lines, straight from the retail
    /// composition: credits strip, top strip and radar bezel stack down the
    /// right edge, the side1 cap ends the fixed chrome, whole side2 bands
    /// fill what is left, and side3 plus the addon strip close the bottom.
    /// Writes x0, radarBottom, side1Bottom, side3Top and the band count to
    /// rc in that order.</summary>
    static void ShellRects(SidebarShell shell, List<int> rc) {
        int radarBottom = shell.H("CREDITS.SHP") + shell.H("TOP.SHP")
            + shell.H("RADAR.SHP");
        int side1Bottom = radarBottom + shell.H("SIDE1.SHP");
        int side2H = shell.H("SIDE2.SHP");
        int rows = (Ra2App.ViewH() - side1Bottom - shell.H("SIDE3.SHP")
                    - shell.H("ADDON.SHP")) / side2H;
        if (rows < 1) { rows = 1; }
        rc.Add(Ra2App.sidebarX0);
        rc.Add(radarBottom);
        rc.Add(side1Bottom);
        rc.Add(side1Bottom + side2H * rows);
        rc.Add(rows);
    }

    /// <summary>One shell piece to the screen: the cached SHP frame as a
    /// registered canvas image key.</summary>
    static void Blit(R2Canvas r, SidebarShell shell, string name,
                     int frame, int x, int y) {
        Texture t = shell.Piece(name, frame);
        if (t == null) { return; }
        R2Tex tex = Ra2Ui.TexOf("ra2:side:" + name + "#"
                                + Convert.ToString(frame), t);
        r.DrawTexture(tex, x, y, t.Width(), t.Height());
    }

    /// <summary>The cameo card's tile size: the progress clock's frame, the
    /// 60x48 box every cameo is drawn in, two columns and a 3/2 pixel gutter
    /// -- the spacing the original's card uses.</summary>
    static int CardTileW(SidebarShell shell) { return shell.W("GCLOCK2.SHP"); }
    static int CardTileH(SidebarShell shell) { return shell.H("GCLOCK2.SHP"); }
    static int CardCols() { return 2; }
    static int CardSlots(SidebarShell shell, List<int> rc) {
        return rc[4] * Ra2App.CardCols();
    }

    /// <summary>The card lists only what can actually be built. TechLevel=-1
    /// is the install's own "never buildable" flag and covers the construction
    /// yards ([GACNST] TechLevel=-1), so the structures tab starts at the
    /// power plant the way the original's does. The tab pair splits the rest
    /// the way the original's 建筑物/防御设施 tabs do: armed structures on the
    /// defence page, the rest on buildings.</summary>
    static bool IsBuildItem(StructureType t, int tab) {
        if (t == null) { return false; }
        if (t.TechLevel() < 0) { return false; }
        return tab == 1 ? t.HasWeapon() : !t.HasWeapon();
    }

    /// <summary>How many of the side's catalog entries are card items on
    /// this tab.</summary>
    static int BuildItemCount(GameController game, int tab) {
        int n = game.World().Catalog().CountFor(game.World(), game.Side());
        int c = 0;
        for (int i = 0; i < n; i = i + 1) {
            if (Ra2App.IsBuildItem(game.World().Catalog().TypeFor(
                    game.World(), game.Side(), i), tab)) { c = c + 1; }
        }
        return c;
    }

    /// <summary>The catalog index of the card's k-th build item on this tab,
    /// or -1.</summary>
    static int BuildItemAt(GameController game, int k, int tab) {
        int n = game.World().Catalog().CountFor(game.World(), game.Side());
        for (int i = 0; i < n; i = i + 1) {
            if (!Ra2App.IsBuildItem(game.World().Catalog().TypeFor(
                    game.World(), game.Side(), i), tab)) { continue; }
            if (k == 0) { return i; }
            k = k - 1;
        }
        return -1;
    }

    /// <summary>Which category tab sits under the cursor, 0..3, or -1. The
    /// tabs close the side1 cap, one pressed pixel apart.</summary>
    static int HitTab(SidebarShell shell, List<int> rc, int mx, int my) {
        int tabW = shell.W("TAB00.SHP");
        for (int t = 0; t < 4; t = t + 1) {
            string tab = "TAB0" + Convert.ToString(t) + ".SHP";
            int ty = rc[2] - shell.H(tab) - 3;
            if (R2Panel.PointIn(mx, my, rc[0] + 26 + (tabW + 1) * t, ty,
                             tabW, shell.H(tab))) { return t; }
        }
        return 0 - 1;
    }

    /// <summary>Which card slot sits under the cursor, counting from the top
    /// of the current page, or -1. The same geometry DrawShellSidebar draws,
    /// so a tile lights exactly where its click lands.</summary>
    static int HitCardSlot(GameController game, SidebarShell shell, int mx,
                           int my, int items) {
        List<int> rc = new List<int>();
        Ra2App.ShellRects(shell, rc);
        int tw = Ra2App.CardTileW(shell);
        int th = Ra2App.CardTileH(shell);
        int slots = Ra2App.CardSlots(shell, rc);
        for (int s = 0; s < slots; s = s + 1) {
            int idx = s + Ra2App.cardPage * slots;
            if (idx >= items) { break; }
            int tx = rc[0] + 22 + (tw + 3) * (s % Ra2App.CardCols());
            int ty = rc[2] + 1 + (th + 2) * (s / Ra2App.CardCols());
            if (R2Panel.PointIn(mx, my, tx, ty, tw, th)) { return idx; }
        }
        return -1;
    }

    /// <summary>The page-up/page-down pair beside the side3 footer, or -1
    /// for down, 1 for up -- the paging direction under the cursor.</summary>
    static int HitCardScroll(SidebarShell shell, int mx, int my) {
        List<int> rc = new List<int>();
        Ra2App.ShellRects(shell, rc);
        int w = shell.W("R-DN.SHP");
        int h = shell.H("R-DN.SHP");
        int x = rc[0] + 38;
        int y = rc[3] + 7;
        if (R2Panel.PointIn(mx, my, x, y, w, h)) { return -1; }
        if (R2Panel.PointIn(mx, my, x + w, y, shell.W("R-UP.SHP"),
                         shell.H("R-UP.SHP"))) { return 1; }
        return 0;
    }

    /// <summary>The power pip strip: whole empty pips stack up the left edge
    /// of the card band, then red drain from the bottom, yellow buffer, and
    /// green surplus to the top -- the split the original's bar draws from
    /// supply versus drain.</summary>
    static void DrawPowerPips(R2Canvas r, GameController game,
                              SidebarShell shell, List<int> rc) {
        Texture pip = shell.Piece("POWERP.SHP", 0);
        if (pip == null) { return; }
        int pw = pip.Width();
        int ph = pip.Height();
        int height = rc[4] * shell.H("SIDE2.SHP");
        int n = height / (ph + 1);
        if (n < 1) { return; }
        List<int> flow = new List<int>();
        flow.Add(0);
        flow.Add(0);
        game.World().PowerFlow(game.Side(), flow);
        int supply = flow[0];
        int drain = flow[1];
        int c = supply > drain ? supply : drain;
        int redN = 0;
        int yellowN = 0;
        if (c > 0) {
            redN = drain * 100 / c * n / 100;
            int buf = supply - drain;
            if (buf > 100) { buf = 100; }
            if (buf < 0) { buf = 0; }
            yellowN = buf * 100 / c * n / 100;
        }
        int greenN = n - redN - yellowN;
        int x = rc[0] + 5;
        int yBase = rc[2] + height - ph;
        int step = ph + 1;
        for (int i = 0; i < n; i = i + 1) {
            int frame = 0;
            if (i < redN) { frame = 3; }
            else if (i < redN + yellowN) { frame = 2; }
            else if (i < n) { frame = 1; }
            Ra2App.Blit(r, shell, "POWERP.SHP", frame, x, yBase - step * i);
        }
    }

    /// <summary>The retail sidebar, piece for piece: the side's own shell
    /// art fills the right strip, the credits readout rides the top strip,
    /// the radar bezel wraps the minimap, repair/sell sit under it, and the
    /// band below carries the power pips and the two-column cameo card --
    /// the side's buildings normally, the selected producer's units while
    /// one is selected, each tile the shipped cameo with the progress clock
    /// riding it as it trains.</summary>
    static void DrawShellSidebar(R2Canvas r, GameController game,
                                 ObjectArt art, SidebarShell shell,
                                 int mouseX, int mouseY) {
        List<int> rc = new List<int>();
        Ra2App.ShellRects(shell, rc);
        int x0 = rc[0];
        // The game menu replaces the sidebar's working parts with the
        // SIDEBTTN stack, the way the original's menu screen hides radar,
        // power and card and shows its buttons over the bare shell.
        if (Ra2App.gameMenu) {
            Ra2App.DrawGameMenu(r, game, shell, rc, mouseX, mouseY);
            return;
        }
        // The shell art is full of deliberate transparency -- the band
        // tiles' surroundings are holes -- and the retail game keeps the
        // map viewport short of the sidebar, so the backdrop behind the
        // strip is plain black rather than battlefield. The strip's own
        // pieces cover it except where the retail look is black anyway.
        r.SetColor(0, 0, 0, 255);
        r.FillRect(x0, 0, Ra2App.ViewW() - x0, Ra2App.ViewH());
        int creditsH = shell.H("CREDITS.SHP");
        Ra2App.Blit(r, shell, "CREDITS.SHP", 0, x0, 0);
        Ra2App.Blit(r, shell, "TOP.SHP", 0, x0, creditsH);
        // The radar box: the SIDE chrome frames it, and RADAR.SHP itself is
        // the offline radar SCREEN -- its first frame is the house emblem on
        // a starburst, the picture retail shows while the radar is down. The
        // live radar draws the minimap here instead, so blitting that emblem
        // underneath leaves its wings poking out around the map. The screen
        // area is left black and the minimap is painted on top.
        r.SetColor(0, 0, 0, 255);
        r.FillRect(x0, creditsH + shell.H("TOP.SHP"), shell.W("RADAR.SHP"),
                   shell.H("RADAR.SHP"));
        Ra2App.Blit(r, shell, "SIDE1.SHP", 0, x0, rc[1]);
        for (int i = 0; i < rc[4]; i = i + 1) {
            int y = rc[2] + shell.H("SIDE2.SHP") * i;
            Ra2App.Blit(r, shell, "SIDE2B.SHP", 0, x0, y);
            Ra2App.Blit(r, shell, "SIDE2.SHP", 0, x0, y);
        }
        Ra2App.Blit(r, shell, "SIDE3.SHP", 0, x0, rc[3]);
        Ra2App.Blit(r, shell, "ADDON.SHP", 0, x0,
                    rc[3] + shell.H("SIDE3.SHP"));

        // Credits on the strip, diplomacy and options on the top plate --
        // the buttons draw their shipped chrome, though diplomacy has no
        // table to open in a skirmish against the machine.
        R2Text.Draw(r, Convert.ToString(game.Money()), x0 + 12, 3, 1,
                  250, 226, 96, 255);
        Ra2App.Blit(r, shell, "DIPLOBTN.SHP", 0, x0 + 12, creditsH + 4);
        Ra2App.Blit(r, shell, "OPTBTN.SHP", 0,
                    x0 + 12 + shell.W("DIPLOBTN.SHP"), creditsH + 4);

        // Repair and sell below the radar, the armed toggle on its pressed
        // frame.
        int rw = shell.W("REPAIR.SHP");
        Ra2App.Blit(r, shell, "REPAIR.SHP", game.RepairModeArmed() ? 1 : 0,
                    x0 + 20, rc[1] + 8);
        Ra2App.Blit(r, shell, "SELL.SHP", game.SellModeArmed() ? 1 : 0,
                    x0 + 20 + rw, rc[1] + 8);

        // The category tabs closing the side1 cap, the active one pressed:
        // while a producer is selected whichever of its lines the trainees
        // belong to -- infantry on the infantry tab, everything else on
        // vehicles -- otherwise the structures page the tabs have picked.
        int unitMode = Ra2App.ProdCount(game);
        int tabW = shell.W("TAB00.SHP");
        int activeTab = Ra2App.buildTab;
        if (unitMode > 0) {
            WorldObject sel = game.World().ObjectAt(game.World().SelectedIndex());
            UnitType first = game.World().Units().TypeFor(game.World(),
                sel.Side(), Ra2App.ProdUnitAt(game, 0));
            activeTab = first != null && first.HasSeq() ? 2 : 3;
        }
        for (int t = 0; t < 4; t = t + 1) {
            string tab = "TAB0" + Convert.ToString(t) + ".SHP";
            Ra2App.Blit(r, shell, tab, t == activeTab ? 1 : 0,
                        x0 + 26 + (tabW + 1) * t,
                        rc[2] - shell.H(tab) - 3);
        }

        // The page pair beside the footer; frame 0 is at rest, and paging
        // lights nothing -- the original dims them instead when there is
        // nothing to page.
        Ra2App.Blit(r, shell, "R-DN.SHP", 0, x0 + 38, rc[3] + 7);
        Ra2App.Blit(r, shell, "R-UP.SHP", 0, x0 + 38 + shell.W("R-DN.SHP"),
                    rc[3] + 7);

        Ra2App.DrawPowerPips(r, game, shell, rc);

        // The card itself. tile is the clock's 60x48 frame; the shipped
        // cameo fills it, locked entries darken under a half cover, the
        // armed build gets the outline, and a training line carries the
        // clock at its progress frame.
        int tw = Ra2App.CardTileW(shell);
        int th = Ra2App.CardTileH(shell);
        int slots = Ra2App.CardSlots(shell, rc);
        bool unitModeOn = unitMode > 0;
        int items = unitModeOn ? unitMode
            : Ra2App.BuildItemCount(game, Ra2App.buildTab);
        if (Ra2App.cardPage * slots >= items) { Ra2App.cardPage = 0; }
        WorldObject producer = unitModeOn
            ? game.World().ObjectAt(game.World().SelectedIndex()) : null;
        int clockFrames = shell.FrameCount("GCLOCK2.SHP");
        for (int s = 0; s < slots; s = s + 1) {
            int idx = s + Ra2App.cardPage * slots;
            if (idx >= items) { break; }
            int tx = x0 + 22 + (tw + 3) * (s % Ra2App.CardCols());
            int ty = rc[2] + 1 + (th + 2) * (s / Ra2App.CardCols());
            bool unlocked = false;
            bool armed = false;
            int clockAt = -1;
            Texture cameo = null;
            if (unitModeOn) {
                int id = Ra2App.ProdUnitAt(game, idx);
                UnitType u = game.World().Units().TypeFor(game.World(),
                    producer.Side(), id);
                if (u == null) { continue; }
                unlocked = game.UnitUnlocked(id);
                cameo = art.CameoTexture(u);
                if (cameo == null) { cameo = art.UnitIconTexture(u, producer.Side()); }
                if (idx == 0 && producer.ProdCount() > 0) {
                    int total = u.BuildTime();
                    int left = producer.ProdLeftAt(0);
                    if (total > 0 && left > 0 && clockFrames > 1) {
                        int pct = (total - left) * 100 / total;
                        int f = (pct * (clockFrames - 1) + 99) / 100;
                        if (f < 1) { f = 1; }
                        clockAt = f % clockFrames;
                    }
                }
            } else {
                int bi = Ra2App.BuildItemAt(game, idx, Ra2App.buildTab);
                if (bi < 0) { continue; }
                unlocked = game.BuildUnlocked(bi);
                armed = game.BuildingId() == bi;
                cameo = art.StructureCameoTexture(
                    game.World().Catalog().TypeFor(game.World(), game.Side(),
                                                   bi));
            }
            if (cameo == null) { continue; }
            // Real cameos are exactly the tile's 60x48; a fallback portrait
            // baked from field art is bigger, so it scales to fit rather
            // than spilling over its neighbours.
            int cw = cameo.Width();
            int ch = cameo.Height();
            int dw = cw;
            int dh = ch;
            if (dw > tw) { dh = dh * tw / dw; dw = tw; }
            if (dh > th) { dw = dw * th / dh; dh = th; }
            R2Tex tex = Ra2Ui.RegisterMutable("ra2:cameo", cameo);
            r.DrawTexture(tex, tx + (tw - dw) / 2, ty + (th - dh) / 2,
                          dw, dh);
            if (clockAt >= 0) {
                Ra2App.Blit(r, shell, "GCLOCK2.SHP", clockAt, tx, ty);
            }
            if (!unlocked) {
                r.SetColor(0, 0, 0, 128);
                r.FillRect(tx, ty, tw, th);
            }
            if (armed) {
                r.SetColor(244, 220, 90, 255);
                r.DrawRect(tx - 1, ty - 1, tw + 2, th + 2);
            }
        }
        // The queue depth on the tile being trained, top right like the
        // original's counter.
        if (unitModeOn && producer.ProdCount() > 1) {
            string count = Convert.ToString(producer.ProdCount());
            R2Text.DrawShadow(r, count, x0 + 22 + tw - 10
                            - R2Text.Width(r, count, 1),
                            rc[2] + 4, 1, 240, 240, 240, 255);
        }
    }

    // ---- in-game game menu (Esc) ------------------------------------------

    /// <summary>How many buttons the game menu shows: home runs 选项/全屏/
    /// 放弃任务 with 返回任务 pinned last; the confirm screen swaps 退出
    /// in for the middle three.</summary>
    static int MenuButtonCount() {
        return Ra2App.gameMenuScreen == 0 ? 4 : 2;
    }

    /// <summary>One button's y: the stack runs down from the card area's
    /// top and the last button sits on its floor -- the original anchors
    /// the bottom entry at repeaterHeight * repeaterCount - 2.</summary>
    static int MenuButtonY(SidebarShell shell, List<int> rc, int i) {
        int bh = shell.H("SIDEBTTN.SHP");
        int top = rc[2] + 1;
        int menuH = rc[4] * (Ra2App.CardTileH(shell) + 2) - 2;
        if (i == Ra2App.MenuButtonCount() - 1) { return top + menuH - bh; }
        return top + bh * i;
    }

    /// <summary>Which game-menu button sits under the cursor, or -1.</summary>
    static int HitMenuButton(SidebarShell shell, List<int> rc, int mx, int my) {
        int bw = shell.W("SIDEBTTN.SHP");
        int bh = shell.H("SIDEBTTN.SHP");
        for (int i = 0; i < Ra2App.MenuButtonCount(); i = i + 1) {
            if (R2Panel.PointIn(mx, my, rc[0] + 22,
                             Ra2App.MenuButtonY(shell, rc, i), bw, bh)) {
                return i;
            }
        }
        return 0 - 1;
    }

    /// <summary>The game menu over the bare sidebar shell: radar, power and
    /// card give way to the SIDEBTTN stack the way the original's menu
    /// screen hides them. Button press state rides menuPressed.</summary>
    static void DrawGameMenu(R2Canvas r, GameController game,
                             SidebarShell shell, List<int> rc,
                             int mouseX, int mouseY) {
        int x0 = rc[0];
        r.SetColor(0, 0, 0, 255);
        r.FillRect(x0, 0, Ra2App.ViewW() - x0, Ra2App.ViewH());
        Ra2App.Blit(r, shell, "CREDITS.SHP", 0, x0, 0);
        Ra2App.Blit(r, shell, "SIDE3.SHP", 0, x0, rc[3]);
        Ra2App.Blit(r, shell, "ADDON.SHP", 0, x0, rc[3] + shell.H("SIDE3.SHP"));
        R2Text.Draw(r, Convert.ToString(game.Money()), x0 + 12, 3, 1,
                  250, 226, 96, 255);

        Strings ui = Ra2App.menuUi;
        List<string> labels = new List<string>();
        if (Ra2App.gameMenuScreen == 0) {
            labels.Add(ui != null ? ui.Or("GUI:Options", "选项") : "选项");
            labels.Add(ui != null ? ui.Or("GUI:Fullscreen", "全屏") : "全屏");
            labels.Add(ui != null ? ui.Or("GUI:AbortMission", "放弃任务")
                       : "放弃任务");
        } else {
            labels.Add(ui != null ? ui.Or("GUI:Quit", "退出") : "退出");
        }
        labels.Add(ui != null ? ui.Or("GUI:ResumeMission", "返回任务")
                   : "返回任务");

        int bw = shell.W("SIDEBTTN.SHP");
        int bh = shell.H("SIDEBTTN.SHP");
        int hover = Ra2App.HitMenuButton(shell, rc, mouseX, mouseY);
        for (int i = 0; i < labels.Count; i = i + 1) {
            int by = Ra2App.MenuButtonY(shell, rc, i);
            // 选项 is the one dead entry: no options table to open yet, so
            // it ships dimmed like the main menu's unimplemented rows. The
            // plate's own frames carry the states: red at rest, crimson
            // under the click, yellow under the cursor.
            bool enabled = !(Ra2App.gameMenuScreen == 0 && i == 0);
            int frame = 0;
            if (Ra2App.menuPressed == i && enabled) { frame = 1; }
            else if (hover == i && enabled) { frame = 2; }
            Ra2App.Blit(r, shell, "SIDEBTTN.SHP", frame, x0 + 22, by);
            if (!enabled) {
                r.SetColor(0, 0, 0, 128);
                r.FillRect(x0 + 22, by, bw, bh);
            }
            string label = labels[i];
            R2Text.DrawShadow(r, label,
                            x0 + 22 + (bw - R2Text.Width(r, label, 1)) / 2,
                            by + (bh - 12) / 2 + 1, 1, 240, 240, 240, 255);
        }
    }

    // ---- original-style sidebar geometry ----------------------------------

    // Two columns of cameo tiles, the original build grid's shape: each tile
    // is a 62x49 button whose picture area matches the 60x48 cameo box.
    static int BtnW() { return 62; }
    static int BtnH() { return 49; }
    static int SideX() { return Ra2App.ViewW() - 296; }
    static int BuildCols() { return 2; }
    static int BuildBtnX(int i) {
        return Ra2App.SideX() + 14 + (i % Ra2App.BuildCols()) * (Ra2App.BtnW() + 12);
    }
    static int BuildBtnY(int i) {
        return 16 + 24 + (i / Ra2App.BuildCols()) * (Ra2App.BtnH() + 6);
    }
    static int BuildRows(GameController game) {
        int n = game.World().Catalog().CountFor(game.World(), game.Side());
        return (n + Ra2App.BuildCols() - 1) / Ra2App.BuildCols();
    }
    static int BuildMenuH(GameController game) {
        return 24 + Ra2App.BuildRows(game) * (Ra2App.BtnH() + 6);
    }

    static int SellBtnX() { return Ra2App.SideX() + 14; }
    static int RepairBtnX() { return Ra2App.SideX() + 84; }

    /// <summary>The 卖/修 row's y, riding the build menu's row count the way
    /// ProdPanelY does, so the hit test matches what was drawn.</summary>
    static int SellRepairY(GameController game) {
        return 16 + Ra2App.BuildMenuH(game) + 4 + 44;
    }

    /// <summary>-1 none, 0 sell, 1 repair: which sidebar toggle sits under
    /// the cursor. With the shell art the pair rides below the radar bezel
    /// the way the original places it; otherwise the fallback panel's row.</summary>
    static int HitSellRepair(GameController game, SidebarShell shell, int mx,
                             int my) {
        if (shell != null && shell.Ok()) {
            List<int> rc = new List<int>();
            Ra2App.ShellRects(shell, rc);
            int rx = rc[0] + 20;
            int ry = rc[1] + 8;
            if (R2Panel.PointIn(mx, my, rx, ry, shell.W("REPAIR.SHP"),
                             shell.H("REPAIR.SHP"))) { return 1; }
            if (R2Panel.PointIn(mx, my, rx + shell.W("REPAIR.SHP"), ry,
                             shell.W("SELL.SHP"), shell.H("SELL.SHP"))) {
                return 0;
            }
            return -1;
        }
        int sy = Ra2App.SellRepairY(game);
        if (my >= sy && my < sy + 26) {
            if (mx >= Ra2App.SellBtnX() && mx < Ra2App.SellBtnX() + 62) { return 0; }
            if (mx >= Ra2App.RepairBtnX() && mx < Ra2App.RepairBtnX() + 62) { return 1; }
        }
        return -1;
    }

    /// <summary>The flat cameo-tile button: a raised bevel the way the
    /// original's sidebar tiles read -- dark base, one light top/left edge,
    /// one dark bottom/right edge, no rounded corners, no glow. kind:
    /// 0 normal, 2 armed; hover lightens the base.</summary>
    static void TileButton(R2Canvas r, int mx, int my, int x, int y,
                           int w, int h, int kind, int side) {
        List<int> tint = new List<int>();
        Ra2App.SideUiTint(side, tint);
        bool hov = R2Panel.PointIn(mx, my, x, y, w, h);
        int br = tint[0]; int bg = tint[1]; int bb = tint[2];
        if (hov) { br = tint[3]; bg = tint[4]; bb = tint[5]; }
        if (kind == 2) { br = 224; bg = 176; bb = 66; }
        // Border and base: a flat plate with a hairline frame.
        R2Panel.RoundRectFill(r, x - 1, y - 1, w + 2, h + 2, 0, 10, 12, 18, 240);
        R2Panel.RoundRectFill(r, x, y, w, h, 0, br, bg, bb, 255);
        // Bevel: light top edge, dark bottom edge, one pixel each.
        R2Panel.RoundRectFill(r, x, y, w, 2, 0, 255, 255, 255, hov ? 60 : 34);
        R2Panel.RoundRectFill(r, x, y + h - 2, w, 2, 0, 0, 0, 0, 110);
    }

    /// <summary>The button's chrome without its label, so a caller can put an
    /// icon inside and draw the text where it fits. kind: 0 normal, 1 accent,
    /// 2 selected.</summary>
    /// <summary>The house's UI palette -- 盟军 steel blue, 苏军 red, 尤里
    /// purple, the colours each side's sidebar wore in the original. Fills
    /// nine slots: 0-2 panel base, 3-5 panel hover, 6-8 hover glow.</summary>
    static void SideUiTint(int side, List<int> rgb) {
        int p0 = 26; int p1 = 36; int p2 = 54;
        int h0 = 42; int h1 = 56; int h2 = 80;
        int g0 = 110; int g1 = 160; int g2 = 230;
        if (side == Side2.Soviet()) {
            p0 = 56; p1 = 22; p2 = 22;
            h0 = 84; h1 = 32; h2 = 32;
            g0 = 240; g1 = 110; g2 = 90;
        } else if (side == Side2.Yuri()) {
            p0 = 44; p1 = 26; p2 = 60;
            h0 = 62; h1 = 38; h2 = 82;
            g0 = 190; g1 = 120; g2 = 240;
        }
        Ra2App.TintSet(rgb, 0, p0, p1, p2);
        Ra2App.TintSet(rgb, 3, h0, h1, h2);
        Ra2App.TintSet(rgb, 6, g0, g1, g2);
    }

    /// <summary>The minimap dot colour for a house: the player is green
    /// (handled by the caller); each AI house gets a distinct hostile hue so
    /// an 8-way free-for-all reads at a glance.</summary>
    static void MiniDotTint(int house, List<int> rgb) {
        int r = 232; int g = 60; int b = 60;
        if (house == 1) { r = 232; g = 60; b = 60; }        // red
        else if (house == 2) { r = 230; g = 130; b = 40; }  // orange
        else if (house == 3) { r = 60; g = 140; b = 232; }  // blue
        else if (house == 4) { r = 220; g = 80; b = 200; }  // magenta
        else if (house == 5) { r = 230; g = 200; b = 50; }  // yellow
        else if (house == 6) { r = 60; g = 210; b = 200; }  // cyan
        else if (house == 7) { r = 240; g = 240; b = 240; } // white
        Ra2App.TintSet(rgb, 0, r, g, b);
    }

    static void TintSet(List<int> rgb, int at, int r, int g, int b) {
        while (rgb.Count < at + 3) { rgb.Add(0); }
        rgb[at] = r;
        rgb[at + 1] = g;
        rgb[at + 2] = b;
    }

    static bool InSidebar(int mx) {
        return mx >= (Ra2App.sidebarX0 >= 0 ? Ra2App.sidebarX0
                                            : Ra2App.ViewW() - 296);
    }

    /// <summary>The production panel sits below the build menu: the selected
    /// structure's trainable units as cameo rows -- portrait left, name and
    /// price right, a progress bar over the row being trained. Its top
    /// follows the build menu's row count, which differs per side.</summary>
    static int ProdPanelY(GameController game) {
        return 16 + Ra2App.BuildMenuH(game) + 4 + 44 + 40;
    }
    static int ProdBtnW() { return 268; }
    static int ProdBtnH() { return 48; }
    static int ProdBtnX(int i) { return Ra2App.SideX() + 14; }
    static int ProdBtnY(GameController game, int i) {
        return Ra2App.ProdPanelY(game) + 24 + i * (Ra2App.ProdBtnH() + 6);
    }

    /// <summary>How many units the selected structure can train, or 0 when
    /// nothing producing is selected.</summary>
    static int ProdCount(GameController game) {
        WorldObject sel = game.World().Selected();
        if (sel == null || sel.Kind() != ObjKind.Structure()) { return 0; }
        if (sel.Side() != game.Side()) { return 0; }   // enemy buildings hide
        StructureType t = game.World().Catalog().TypeFor(game.World(), sel.Side(), sel.BuildId());
        if (t == null) { return 0; }
        List<int> prod = t.Produces();
        if (prod == null) { return 0; }
        return prod.Count;
    }

    static int ProdUnitAt(GameController game, int i) {
        WorldObject sel = game.World().Selected();
        if (sel == null) { return -1; }
        StructureType t = game.World().Catalog().TypeFor(game.World(), sel.Side(), sel.BuildId());
        if (t == null) { return -1; }
        List<int> prod = t.Produces();
        if (prod == null || i >= prod.Count) { return -1; }
        return prod[i];
    }

    /// <summary>The unit id under the cursor in the production panel, or -1
    /// when nothing produces is selected or the cursor is elsewhere.</summary>
    static int HitProduction(GameController game, int mx, int my) {
        int n = Ra2App.ProdCount(game);
        for (int i = 0; i < n; i = i + 1) {
            if (R2Panel.PointIn(mx, my, Ra2App.ProdBtnX(i),
                             Ra2App.ProdBtnY(game, i),
                             Ra2App.ProdBtnW(), Ra2App.ProdBtnH())) {
                return Ra2App.ProdUnitAt(game, i);
            }
        }
        return -1;
    }

    static void DrawProduction(R2Canvas r, GameController game,
                               ObjectArt art, int mouseX, int mouseY) {
        int n = Ra2App.ProdCount(game);
        if (n == 0) { return; }
        int x = Ra2App.SideX();
        int y = Ra2App.ProdPanelY(game);
        WorldObject sel = game.World().ObjectAt(game.World().SelectedIndex());
        List<int> ptint = new List<int>();
        Ra2App.SideUiTint(sel.Side(), ptint);
        R2Panel.RoundRectFill(r, x, y, 296,
                 20 + n * (Ra2App.ProdBtnH() + 6) + 8,
                 6, ptint[0], ptint[1], ptint[2], 216);
        R2Text.Draw(r, "训练", x + 14, y + 4, 2, 236, 208, 120, 255);
        for (int i = 0; i < n; i = i + 1) {
            int id = Ra2App.ProdUnitAt(game, i);
            int bx = Ra2App.ProdBtnX(i);
            int by = Ra2App.ProdBtnY(game, i);
            UnitType u = game.World().Units().TypeFor(game.World(), sel.Side(), id);
            if (u == null) { continue; }
            bool unlocked = game.UnitUnlocked(id);
            int kind = 0;
            if (u.Cost() > game.Money()) { kind = 1; }
            // One cameo row per trainable unit: the shipped portrait tile at
            // its native 60x48 on the left, name and price stacked beside it
            // -- the original's production layout. Locked entries stay
            // text-only.
            Ra2App.TileButton(r, mouseX, mouseY, bx, by, Ra2App.ProdBtnW(),
                              Ra2App.ProdBtnH(), kind, sel.Side());
            int textX = bx + 8;
            if (unlocked) {
                // The real cameo portrait first; the field art only when the
                // install carries no portrait for this unit.
                Texture icon = art.CameoTexture(u);
                if (icon == null) { icon = art.UnitIconTexture(u, sel.Side()); }
                if (icon != null) {
                    int iw = icon.Width();
                    int ih = icon.Height();
                    int maxW = 60;
                    int maxH = 44;
                    int sc = 1;
                    int cw = iw;
                    int ch = ih;
                    while ((cw > maxW || ch > maxH) && sc < 8) {
                        sc = sc + 1;
                        cw = iw / sc;
                        ch = ih / sc;
                    }
                    R2Tex iconTex = Ra2Ui.TexOf(
                        "ra2:uicon" + Convert.ToString(u.Reg()), icon);
                    r.DrawTexture(iconTex, bx + 4 + (maxW - cw) / 2,
                                  by + 2 + (maxH - ch) / 2, cw, ch);
                    textX = bx + maxW + 10;
                }
            }
            string name = unlocked ? u.Label() : "?" + u.Label();
            R2Text.Draw(r, name, textX, by + 8, 2,
                      unlocked ? 228 : 96, unlocked ? 228 : 102,
                      unlocked ? 228 : 112, 255);
            R2Text.Draw(r, Convert.ToString(u.Cost()), textX, by + 26, 2,
                      unlocked ? 236 : 96, unlocked ? 208 : 102,
                      unlocked ? 120 : 112, 255);
            // The first queued unit's progress, drawn as a thin bar over the
            // row so the player sees training ticking.
            if (i == 0 && sel.ProdCount() > 0) {
                int total = u.BuildTime();
                int left = sel.ProdLeftAt(0);
                int fill = 0;
                if (total > 0) { fill = (total - left) * (Ra2App.ProdBtnW() - 8) / total; }
                R2Panel.RoundRectFill(r, bx + 4, by + Ra2App.ProdBtnH() - 7,
                                   fill, 4, 0, 120, 200, 120, 200);
            }
        }
    }

    /// <summary>Draws the build placement ghost: the armed structure's
    /// footprint outlined at the cell under the cursor, green when the spot is
    /// free and red when blocked, so the player sees where a click will land
    /// before committing.</summary>
    static void DrawGhost(Texture canvas, GameController game, int mouseX,
                          int mouseY, int originX, int originY, Camera cam) {
        int buildId = game.BuildingId();
        if (buildId < 0) { return; }
        StructureType t = game.World().Catalog().TypeFor(game.World(), game.Side(), buildId);
        if (t == null) { return; }
        int wx = cam.X() + Ra2App.ScaleX(mouseX, cam.ZoomNum(), cam.ZoomDen());
        int wy = cam.Y() + Ra2App.ScaleY(mouseY, cam.ZoomNum(), cam.ZoomDen());
        List<int> xy = new List<int>();
        xy.Add(0);
        xy.Add(0);
        IsoProjection.CellAt(wx + originX, wy + originY, xy);
        int cx = xy[0];
        int cy = xy[1];
        bool ok = game.World().CanPlaceBuilding(game.Side(), buildId, cx, cy);
        int r = ok ? 80 : 232;
        int g = ok ? 200 : 60;
        int b = ok ? 80 : 60;
        int a = 110;
        for (int dy = 0; dy < t.FootprintH(); dy = dy + 1) {
            for (int dx = 0; dx < t.FootprintW(); dx = dx + 1) {
                int scx = IsoProjection.ScreenX(cx + dx, cy + dy) - originX - cam.X();
                int scy = IsoProjection.ScreenY(cx + dx, cy + dy, 0) - originY - cam.Y();
                Ra2App.FillDiamond(canvas, scx, scy, r, g, b, a);
            }
        }
    }

    /// <summary>Fills the isometric diamond of one cell on the CPU canvas.</summary>
    static void FillDiamond(Texture canvas, int cx, int cy, int r, int g,
                            int b, int a) {
        int hw = IsoProjection.HalfW();
        int hh = IsoProjection.HalfH();
        for (int y = 0; y < IsoProjection.TileH(); y = y + 1) {
            int half = hw - (y < hh ? y : IsoProjection.TileH() - 1 - y)
                       * hw / hh;
            for (int x = hw - half; x < hw + half; x = x + 1) {
                int px = cx + x;
                int py = cy + y;
                if (px >= 0 && py >= 0 && px < canvas.Width()
                 && py < canvas.Height()) {
                    canvas.SetPixel(py * canvas.Width() + px, r, g, b, a);
                }
            }
        }
    }

    /// <summary>Shows what the selected object is: name, health and its
    /// combat or power stats, drawn under the top HUD panel. When several
    /// units are selected, shows the group size instead of one name.</summary>
    static void DrawSelectionInfo(R2Canvas r, GameController game) {
        int n = game.World().SelectionCount();
        if (n <= 0) { return; }
        if (n > 1) {
            R2Text.DrawShadow(r, "已选 " + Convert.ToString(n) + " 个单位",
                            12, 44, 2, 236, 236, 236, 230);
            return;
        }
        string info = game.SelectedInfo();
        if (info == null || info.Length == 0) { return; }
        R2Text.DrawShadow(r, info, 12, 44, 2, 236, 236, 236, 230);
    }

    /// <summary>A centred pause banner while the game clock is stopped.
    /// The plate follows the original's message box: dark field, thin gold
    /// frame, gold text.</summary>
    static void DrawPaused(R2Canvas r, GameController game, int viewW,
                           int viewH) {
        if (!game.Paused()) { return; }
        R2Panel.RoundRectFill(r, 0, 0, viewW, viewH, 0, 4, 6, 12, 90);
        Ra2App.MessageBoxPlate(r, viewW / 2 - 210, viewH / 2 - 92, 420, 128);
        R2Text.DrawCenteredShadow(r, "已暂停  (按 P 继续)", viewW / 2,
                                viewH / 2 - 62, 4, 236, 208, 120, 255);
    }

    /// <summary>The original's message-box chrome: a dark plate with a thin
    /// double gold frame, used by the pause and result overlays.</summary>
    static void MessageBoxPlate(R2Canvas r, int x, int y, int w, int h) {
        R2Panel.RoundRectFill(r, x, y, w, h, 4, 20, 24, 34, 242);
        r.SetColor(236, 208, 120, 255);
        r.DrawRect(x + 3, y + 3, w - 6, h - 6);
        r.DrawRect(x + 5, y + 5, w - 10, h - 10);
    }

    /// <summary>A small hint under the cursor when move-attack is armed, so the
    /// player knows the next click is an attack-move rather than a select.</summary>
    static void DrawMoveAttackHint(R2Canvas r, GameController game, int mx,
                                   int my) {
        if (!game.MoveAttackArmed()) { return; }
        Ra2App.ModeHint(r, "移动攻击", mx, my);
    }

    /// <summary>The armed-mode cursor tag: a small coloured chip beside the
    /// pointer naming what the next click will do (move-attack, sell,
    /// repair).</summary>
    static void ModeHint(R2Canvas r, string label, int mx, int my) {
        int w = 120;
        int h = 24;
        int x = mx + 16;
        int y = my + 16;
        if (x + w > Ra2App.ViewW()) { x = mx - w - 16; }
        if (y + h > Ra2App.ViewH()) { y = my - h - 16; }
        R2Panel.RoundRectFill(r, x, y, w, h, 6, 200, 60, 60, 220);
        R2Text.DrawCentered(r, label, x + w / 2, y + 5, 2,
                          255, 255, 255, 255);
    }

    /// <summary>Sell/repair cursor chips, mirroring the move-attack one:
    /// the dollar tag when 卖 is armed, the wrench tag when 修 is.</summary>
    static void DrawSellRepairHint(R2Canvas r, GameController game, int mx,
                                   int my) {
        if (game.SellModeArmed()) { Ra2App.ModeHint(r, "变卖", mx, my); }
        else if (game.RepairModeArmed()) { Ra2App.ModeHint(r, "修理", mx, my); }
    }

    // The minimap's fog-of-war overlay: black patches over every
    // unexplored cell, rebuilt off the render path -- the version catch-up
    // coalesces to one walk every 400ms the way the terrain recomposite
    // coalesces ore changes. Stale by a fraction of a second at worst.
    static R2Tex miniShroud;
    static int miniShroudVersion = 0 - 1;
    static int miniShroudFullVersion = 0 - 1;
    static int miniShroudMs = 0 - 1000000;

    /// <summary>The in-game minimap: terrain backdrop, a frame showing the
    /// current view, and dots for every object -- green for the player's,
    /// red for the enemy's. Drawn into the sidebar's lower corner.</summary>
    static void DrawMinimap(R2Canvas r, R2Tex minimap, World world,
                            GameController game, Camera cam,
                            MapRenderer terrain, int mx, int my,
                            bool clicked, int x, int y, int w, int h) {
        if (minimap == null) { return; }
        r.DrawTexture(minimap, x, y, w, h);
        // The fog of war: unexplored ground stays black on the radar and
        // nothing on it shows a dot -- not for the player, not for the AI
        // houses. Explored ground keeps its terrain, the way RA2's shroud
        // never re-fogs.
        MapShroud shroud = world.ShroudOf(game.Side());
        if (shroud != null) {
            int nowMs = Window.GetTickMs();
            if (shroud.FullVersion() != Ra2App.miniShroudFullVersion
             || (shroud.Version() != Ra2App.miniShroudVersion
                 && nowMs - Ra2App.miniShroudMs >= 400)) {
                Ra2App.miniShroudFullVersion = shroud.FullVersion();
                Ra2App.miniShroudVersion = shroud.Version();
                Ra2App.miniShroudMs = nowMs;
                Texture canvas = Texture.Create(Ra2App.MiniW(), Ra2App.MiniH());
                Ra2App.memset(canvas.Pixels(), 0, canvas.ByteLength());
                int mw = terrain.WorldWidth();
                int mh = terrain.WorldHeight();
                int cw2 = world.Width();
                int ch2 = world.Height();
                for (int cy = 0; cy < ch2; cy = cy + 1) {
                    for (int cx = 0; cx < cw2; cx = cx + 1) {
                        if (shroud.At(cx, cy) != MapShroud.Unexplored()) {
                            continue;
                        }
                        int wx = IsoProjection.ScreenX(cx, cy)
                               - terrain.OriginX();
                        int wy = IsoProjection.ScreenY(cx, cy, 0)
                               - terrain.OriginY();
                        int px = wx * Ra2App.MiniW() / mw;
                        int py = wy * Ra2App.MiniH() / mh;
                        for (int dy = 0; dy < 2; dy = dy + 1) {
                            for (int dx = 0; dx < 2; dx = dx + 1) {
                                int ax = px + dx;
                                int ay = py + dy;
                                if (ax < 0 || ay < 0 || ax >= Ra2App.MiniW()
                                 || ay >= Ra2App.MiniH()) { continue; }
                                canvas.SetPixel(ay * Ra2App.MiniW() + ax,
                                    0, 0, 0, 255);
                            }
                        }
                    }
                }
                Ra2App.miniShroud = Ra2Ui.RegisterMutable("ra2:minishroud",
                                                          canvas);
                canvas.Close();
            }
            if (Ra2App.miniShroud != null) {
                r.DrawTexture(Ra2App.miniShroud, x, y, w, h);
            }
        }
        // A hairline frame.
        r.SetColor(150, 158, 172, 255);
        r.DrawRect(x, y, w, h);

        // The visible region as a rectangle on the minimap.
        int vx = cam.X() * w / terrain.WorldWidth();
        int vy = cam.Y() * h / terrain.WorldHeight();
        int vw = cam.SpanW() * w / terrain.WorldWidth();
        int vh = cam.SpanH() * h / terrain.WorldHeight();
        if (vw < 4) { vw = 4; }
        if (vh < 4) { vh = 4; }
        r.SetColor(236, 208, 120, 255);
        r.DrawRect(x + vx, y + vy, vw, vh);

        // Object dots: each object projects to one minimap pixel.
        List<int> tint = new List<int>();
        for (int i = 0; i < world.ObjectCount(); i = i + 1) {
            WorldObject o = world.ObjectAt(i);
            if (o.IsDead()) { continue; }
            if (shroud != null
             && shroud.At(o.X(), o.Y()) == MapShroud.Unexplored()) {
                continue;
            }
            int wx = IsoProjection.ScreenX(o.X(), o.Y()) - terrain.OriginX();
            int wy = IsoProjection.ScreenY(o.X(), o.Y(), 0) - terrain.OriginY();
            int px = x + wx * w / terrain.WorldWidth();
            int py = y + wy * h / terrain.WorldHeight();
            if (px < x || py < y || px >= x + w
             || py >= y + h) { continue; }
            // Per-house dot colours: the player is green, the AIs get
            // distinct hues so an 8-way free-for-all reads on the minimap.
            bool mine = o.Side() == game.Side();
            if (mine) {
                r.SetColor(120, 200, 60, 255);
            } else {
                Ra2App.MiniDotTint(o.Side(), tint);
                r.SetColor(tint[0], tint[1], tint[2], 255);
            }
            r.FillRect(px, py, 3, 3);
        }

        // Click jumps the camera to the clicked point.
        if (clicked && R2Panel.PointIn(mx, my, x, y, w, h)) {
            int cwx = (mx - x) * terrain.WorldWidth() / w;
            int cwy = (my - y) * terrain.WorldHeight() / h;
            cam.MoveTo(cwx - cam.SpanW() / 2, cwy - cam.SpanH() / 2);
        }
    }

    /// <summary>Converts two view coordinates to cells and box-selects all own
    /// units inside, or shift-adds the units to the existing selection.</summary>
    static void BoxSelect(GameController game, MapRenderer terrain, Camera cam,
                          int x0, int y0, int x1, int y1, bool add) {
        if (game == null || terrain == null || cam == null) { return; }
        List<int> a = new List<int>();
        List<int> b = new List<int>();
        a.Add(0); a.Add(0); b.Add(0); b.Add(0);
        Ra2App.ViewToCell(terrain, cam, x0, y0, a);
        Ra2App.ViewToCell(terrain, cam, x1, y1, b);
        if (add) {
            // Shift-drag: select units in the box without clearing the rest.
            World w = game.World();
            int loX = a[0] < b[0] ? a[0] : b[0];
            int hiX = a[0] > b[0] ? a[0] : b[0];
            int loY = a[1] < b[1] ? a[1] : b[1];
            int hiY = a[1] > b[1] ? a[1] : b[1];
            for (int i = 0; i < w.ObjectCount(); i = i + 1) {
                WorldObject o = w.ObjectAt(i);
                if (o.Side() != game.Side() || o.Kind() != ObjKind.Unit()) { continue; }
                if (o.X() >= loX && o.X() <= hiX && o.Y() >= loY && o.Y() <= hiY) {
                    w.AddToSelection(o.X(), o.Y());
                }
            }
        } else {
            game.World().SelectBox(a[0], a[1], b[0], b[1], game.Side());
        }
    }

    /// <summary>Shift-click: add whatever is under the cursor to the current
    /// selection.</summary>
    static void ClickAdd(GameController game, MapRenderer terrain, Camera cam,
                         int mx, int my) {
        if (game == null || terrain == null || cam == null) { return; }
        List<int> c = new List<int>();
        c.Add(0); c.Add(0);
        Ra2App.ViewToCell(terrain, cam, mx, my, c);
        game.World().AddToSelection(c[0], c[1]);
    }

    /// <summary>Screen (view) coordinates to a cell.</summary>
    static void ViewToCell(MapRenderer terrain, Camera cam, int mx, int my,
                           List<int> outCell) {
        int wx = cam.X() + Ra2App.ScaleX(mx, cam.ZoomNum(), cam.ZoomDen());
        int wy = cam.Y() + Ra2App.ScaleY(my, cam.ZoomNum(), cam.ZoomDen());
        IsoProjection.CellAt(wx + terrain.OriginX(), wy + terrain.OriginY(),
                             outCell);
    }

    /// <summary>Draws the selection rectangle while a left-drag is in progress.</summary>
    static void DrawBox(R2Canvas r, int x0, int y0, int x1, int y1) {
        int loX = x0 < x1 ? x0 : x1;
        int hiX = x0 > x1 ? x0 : x1;
        int loY = y0 < y1 ? y0 : y1;
        int hiY = y0 > y1 ? y0 : y1;
        r.SetColor(120, 200, 120, 40);
        r.FillRect(loX, loY, hiX - loX, hiY - loY);
        r.SetColor(180, 236, 180, 255);
        r.DrawRect(loX, loY, hiX - loX, hiY - loY);
    }

    /// <summary>End-of-game overlay: who won, and a hint that Esc leaves.
    /// Styled as the original's message box -- dark plate, gold frame.</summary>
    static void DrawResult(R2Canvas r, int result, int viewW, int viewH) {
        if (result == 0) { return; }
        R2Panel.RoundRectFill(r, 0, 0, viewW, viewH, 0, 4, 6, 12, 180);
        string title = "战败";
        int tc = 232;
        if (result == 1) { title = "胜利"; tc = 120; }
        if (result == 3) { title = "僵持"; tc = 170; }
        int pw = 420;
        int ph = 220;
        int px = viewW / 2 - pw / 2;
        int py = viewH / 2 - ph / 2;
        Ra2App.MessageBoxPlate(r, px, py, pw, ph);
        R2Text.DrawCenteredShadow(r, title, viewW / 2, py + 50, 6, tc, 236, 208, 255);
        R2Text.DrawCentered(r, "按 Esc 返回", viewW / 2, py + 150, 3,
                          170, 178, 192, 255);
    }

    static string StructureLabel(World world, StructureCatalog catalog, int side, int buildId) {
        StructureType t = catalog.TypeFor(world, side, buildId);
        if (t == null) { return ""; }
        return t.Label();
    }

    /// <summary>A thumbnail of a map's terrain, or null when it will not open.
    /// The theater is loaded and dropped here: a preview touches every tile
    /// once, and keeping the art around for eighteen maps would dwarf the
    /// memory the game itself uses.</summary>
    static R2Tex BuildPreview(R2Canvas r, AssetDb db, Vfs vfs, string name) {
        MapFile m = db.MapNamed(name);
        if (m == null) { return null; }
        Theater th = Theater.Load(vfs, db, m.Theater());
        MapRenderer mr = MapRenderer.Create(m.Terrain(), th);

        Texture canvas = Texture.Create(Ra2App.PreviewW(), Ra2App.PreviewH());
        Ra2App.memset(canvas.Pixels(), 0, canvas.ByteLength());
        mr.RenderPreview(canvas);

        R2Tex tex = Ra2Ui.RegisterMutable("ra2:preview", canvas);
        canvas.Close();
        th.Close();
        return tex;
    }

    /// <summary>Builds the in-game minimap backdrop: a small version of the
    /// terrain, rendered once when a game loads. The object dots and view
    /// frame are drawn over it every frame.</summary>
    static R2Tex BuildMinimap(R2Canvas r, MapRenderer terrain) {
        Texture canvas = Texture.Create(Ra2App.MiniW(), Ra2App.MiniH());
        Ra2App.memset(canvas.Pixels(), 0, canvas.ByteLength());
        terrain.RenderPreview(canvas);
        R2Tex tex = Ra2Ui.RegisterMutable("ra2:minimap", canvas);
        canvas.Close();
        return tex;
    }

    static void Main() {
        string dir = Ra2App.DataDir();
        string missing = Ra2App.MissingArchive(dir);
        if (missing != "") {
            Console.WriteLine("missing asset archive: " + missing);
            Console.WriteLine("place your Red Alert 2 install in " + dir);
            return;
        }

        // The window, event pump and present all come from the Gui native
        // shell now (Game.Foundation.Gui); the loop below is the game.
        GuiHost host = new GuiHost("Red Alert 2 -- Zan", Ra2App.ViewW(),
                                   Ra2App.ViewH(), 16);
        Ra2Loop loop = new Ra2Loop();
        loop.Dir = dir;
        host.Run(loop);
    }
}

/// <summary>The game's main-loop callback: owns the whole shell/game state
/// the original single-loop version kept in locals, and drives it from the
/// Gui host's event/simulate/render callbacks.</summary>
class Ra2Loop : IGuiHostLoop {
    string Dir;

    // ---- authored once at Start -------------------------------------------
    Vfs vfs;
    AssetDb db;
    List<string> maps;
    Shell shell;
    ShellArt art;
    Strings ui;

    // ---- shell / game state that lives across frames ----------------------
    MapFile map;
    Theater theater;
    MapRenderer terrain;
    Camera cam;
    Texture canvas;
    R2Tex screen;
    World world;
    ObjectArt objArt;
    SidebarShell sideShell;
    GameController game;
    R2Tex minimap;
    int loadedIndex;
    // How many of the map's own neutral units were placed at load, for the
    // load report. The smudge count rides the world (see World.SmudgeCount).
    int mapUnitPlaced;
    // The rules the current game loaded under, kept so map-object placement
    // can reach the install's own type declarations.
    Rules rulesRef;
    // Battle audio: sound/EVA/theme tables are the player install's own
    // assets, read per game start like the reference's onGameStart -- the
    // side picks whose EVA voice column speaks. An install without the
    // tables loads empty and stays silent rather than failing.
    SndEngine snd;
    bool dirty;
    int drawn;
    // The world's ore counter as the scene canvas last saw it: ore sprites
    // bake into the terrain layer, so growth and harvesting are scene
    // changes and the layer must recomposite before the next present.
    int seenOreVersion;
    // When the layer last refreshed for ore: harvesting reshapes the field a
    // few cells at a time, so the refresh coalesces instead of riding every
    // mining tick.
    int lastOreCompositeMs;

    R2Tex preview;
    int previewIndex;

    int mouseX;
    int mouseY;
    bool mouseSeen;
    int panStep;
    bool selfTest;
    int frames;
    WorldObject minerObj;
    int tankIdx = 0 - 1;   // parked grizzly, for the frame-14 camera re-pan
    int duelX;
    int duelY;             // the probe duel site, for the corridor boom shot
    int oreX;
    int oreY;

    int dragStartX;
    int dragStartY;
    bool dragging;

    int lastMs;
    int accMs;

    // Input the Event callback collected, spent once per Render frame.
    bool clicked;
    bool rightClicked;
    int wheelDelta;
    int keyCode;
    bool keyDown;

    /// <summary>Start: everything the old Main did before its while loop.</summary>
    public void Start(GuiHost host) {
        this.vfs = AssetDb.MountInstall(this.Dir);
        if (Ra2App.DumpAssetsArmed()) { Ra2App.DumpAssets(this.vfs); }
        this.db = AssetDb.Load(this.vfs);
        this.maps = this.db.SkirmishMaps();
        Console.WriteLine("maps=" + Convert.ToString(this.maps.Count));

        this.shell = Shell.Create(this.maps.Count);
        this.art = ShellArt.Load(this.vfs);
        Console.WriteLine("shell art title=" + Convert.ToString(this.art.HasTitle())
            + " buttons=" + Convert.ToString(this.art.HasBtns())
            + " dialog=" + Convert.ToString(this.art.HasDialog()));
        this.ui = Strings.Load(this.vfs);
        Ra2App.menuUi = this.ui;

        this.loadedIndex = -1;
        this.previewIndex = -1;
        this.panStep = Ra2App.scrollStep;
        this.selfTest = Ra2App.SelfTestArmed();
        this.lastMs = -1;
    }

    /// <summary>Event: kind 1=move 2=down 3=up (button in code), 4/5=key.</summary>
    public void Event(GuiHost host, int kind, int code) {
        if (kind == 1) {
            this.mouseX = host.MouseX();
            this.mouseY = host.MouseY();
            this.mouseSeen = true;
            // The build ghost follows the cursor, so a move while a build is
            // armed must recomposite the canvas. So does a box-select drag,
            // to show the live selection rectangle.
            if (this.shell.CurrentScene() == 2 && this.game != null
             && (this.game.BuildingId() >= 0 || this.dragging)) {
                this.dirty = true;
            }
            return;
        }
        if (kind == 2) {
            this.mouseX = host.MouseX();
            this.mouseY = host.MouseY();
            this.mouseSeen = true;
            if (code == 0) {
                if (this.shell.CurrentScene() == 2 && Ra2App.gameMenu
                 && this.game != null && this.game.Result() == 0
                 && this.sideShell != null && this.sideShell.Ok()) {
                    // The menu's button takes the press; its action fires on
                    // the release, like the original's.
                    List<int> mrc = new List<int>();
                    Ra2App.ShellRects(this.sideShell, mrc);
                    Ra2App.menuPressed = Ra2App.HitMenuButton(
                        this.sideShell, mrc, this.mouseX, this.mouseY);
                } else if (this.shell.CurrentScene() == 2 && this.game != null
                 && !Ra2App.InSidebar(this.mouseX)) {
                    // Start a potential box drag; on release, if the mouse
                    // barely moved it is a click-select.
                    this.dragging = true;
                    this.dragStartX = this.mouseX;
                    this.dragStartY = this.mouseY;
                } else if (this.shell.CurrentScene() == 2
                        && Ra2App.gameMenu) {
                    // Menu up without shell art: nothing to press.
                } else {
                    this.clicked = true;
                }
            } else if (code == 1) {
                if (!Ra2App.gameMenu) { this.rightClicked = true; }
                this.dragging = false;
            }
            return;
        }
        if (kind == 3) {
            this.mouseX = host.MouseX();
            this.mouseY = host.MouseY();
            if (code == 0 && Ra2App.gameMenu) {
                // The action fires when the button comes up over the same
                // entry it went down on, the original's click.
                if (Ra2App.menuPressed >= 0 && this.sideShell != null
                 && this.sideShell.Ok() && this.game != null
                 && this.game.Result() == 0) {
                    List<int> mrc = new List<int>();
                    Ra2App.ShellRects(this.sideShell, mrc);
                    if (Ra2App.HitMenuButton(this.sideShell, mrc, this.mouseX,
                                             this.mouseY) == Ra2App.menuPressed) {
                        if (Ra2App.gameMenuScreen == 0) {
                            if (Ra2App.menuPressed == 1) {
                                host.RequestStop();
                            } else if (Ra2App.menuPressed == 2) {
                                Ra2App.gameMenuScreen = 1;
                            } else if (Ra2App.menuPressed == 3) {
                                Ra2App.gameMenu = false;
                            }
                        } else {
                            if (Ra2App.menuPressed == 0) {
                                Ra2App.gameMenu = false;
                                Ra2App.gameMenuScreen = 0;
                                this.shell.Back();
                            } else if (Ra2App.menuPressed == 1) {
                                Ra2App.gameMenuScreen = 0;
                            }
                        }
                    }
                }
                Ra2App.menuPressed = -1;
            }
            if (code == 0 && this.dragging) {
                this.dragging = false;
                // A drag of a few pixels is a box select; otherwise it is a
                // plain click.
                int dx = this.mouseX - this.dragStartX;
                if (dx < 0) { dx = 0 - dx; }
                int dy = this.mouseY - this.dragStartY;
                if (dy < 0) { dy = 0 - dy; }
                bool shiftNow = host.Input().Down("select");
                if (dx > 6 || dy > 6) {
                    Ra2App.BoxSelect(this.game, this.terrain, this.cam,
                                     this.dragStartX, this.dragStartY,
                                     this.mouseX, this.mouseY, shiftNow);
                } else if (shiftNow) {
                    // Shift-click: add to the selection.
                    Ra2App.ClickAdd(this.game, this.terrain, this.cam,
                                    this.mouseX, this.mouseY);
                } else {
                    this.clicked = true;
                }
            }
            return;
        }
        if (kind == 4) {
            this.OnKeyDown(host, code);
        }
    }

    /// <summary>Keyboard: the same bindings the original scancode switch
    /// carried, now on Gui's Windows VK codes.</summary>
    void OnKeyDown(GuiHost host, int vk) {
        if (vk == 122) { return; }                       // F11: handled by App
        if (vk == 27) {                                  // Esc
            if (this.shell.CurrentScene() == 0) { host.RequestStop(); }
            else if (this.shell.CurrentScene() == 2 && this.game != null
                 && this.game.Result() == 0 && this.sideShell != null
                 && this.sideShell.Ok()) {
                // The game menu: Esc opens it, Esc over the confirm step
                // steps back to its home first.
                if (Ra2App.gameMenu && Ra2App.gameMenuScreen == 1) {
                    Ra2App.gameMenuScreen = 0;
                } else {
                    Ra2App.gameMenu = !Ra2App.gameMenu;
                    Ra2App.gameMenuScreen = 0;
                }
                Ra2App.menuPressed = -1;
            }
            else {
                Ra2App.gameMenu = false;
                Ra2App.gameMenuScreen = 0;
                this.shell.Back();
            }
            return;
        }
        if (this.shell.CurrentScene() == 1) {
            if (vk == 38) { this.shell.SelectMap(-1); }   // up
            if (vk == 40) { this.shell.SelectMap(1); }    // down
            if (vk == 13) {                               // Enter
                Ra2App.gameMenu = false;
                Ra2App.gameMenuScreen = 0;
                this.shell.StartGame();
            }
            return;
        }
        if (this.shell.CurrentScene() == 2 && this.cam != null
         && !Ra2App.gameMenu) {
            if (vk == 37) { this.cam.MoveBy(0 - this.panStep, 0); this.dirty = true; }
            if (vk == 39) { this.cam.MoveBy(this.panStep, 0); this.dirty = true; }
            if (vk == 38) { this.cam.MoveBy(0, 0 - this.panStep); this.dirty = true; }
            if (vk == 40) { this.cam.MoveBy(0, this.panStep); this.dirty = true; }
            if (vk == 107 || vk == 187) { this.cam.ZoomBy(1); this.dirty = true; }
            if (vk == 109 || vk == 189) { this.cam.ZoomBy(-1); this.dirty = true; }
            if (vk == 32 && this.game != null) { this.game.StepOnce(); this.dirty = true; }
            if (vk == 80 && this.game != null) {         // P
                this.game.TogglePause();
            }
            if (vk == 65 && this.game != null) {         // A
                this.game.ToggleMoveAttack();
            }
            // F: deploy. The original's key for unfolding an MCV into its
            // construction yard and for sitting a GI down in his emplacement.
            if (vk == 70 && this.game != null) {         // F
                if (this.game.DeploySelected()) { this.dirty = true; }
            }
            // Squads: Ctrl+1..0 saves the current selection, plain 1..0
            // recalls it.
            int num = -1;
            if (vk >= 49 && vk <= 57) { num = vk - 49; }        // 1..9
            if (vk == 48) { num = 9; }                          // 0
            if (num >= 0 && this.game != null) {
                if (host.Input().Down("ctrl")) { this.game.SaveSquad(num); }
                else { this.game.RecallSquad(num); }
            }
        }
    }

    public void FixedUpdate(GuiHost host, int dt) { }

    /// <summary>Per-frame: the game clock, input spending, redraw, present.
    /// This is the body of the old while-loop with the host callbacks split
    /// out.</summary>
    public void Update(GuiHost host, int dt) {
        // The per-frame work lives in Render: the host passes the frame's
        // canvas there, and the scene draws (terrain composite, HUD, the
        // self-test walk) are what advance the visible state. The game's own
        // logic clock is ticked from the render path, and its redraw need
        // reaches the composite through GameController.NeedsRedraw -- which
        // only fires on a tick that actually moved, shot or produced
        // something. Forcing dirty here re-composited and re-encoded the
        // full scene every frame whether or not anything changed, which is
        // where the frame budget went.
    }

    public void Stop(GuiHost host) {
        if (this.terrain != null) {
            this.canvas = null;
            this.theater.Close();
            this.objArt.Close();
        }
        this.screen = null;
        this.minimap = null;
        this.preview = null;
        this.art.Close();
        this.ui.Close();
        this.db.Close();
    }

    // =====================================================================
    // Main-loop implementation: the per-frame draw adapter, the scene draws,
    // the game update, and the self-test walk. Split out of the original
    // single while-loop so the Gui host can drive it (Start / Event / Update /
    // Render / Stop).
    // =====================================================================

    /// <summary>The draw adapter for the current frame. The host hands a
    /// Canvas to Render every frame (it may swap the surface), so this is
    /// rebuilt rather than cached.</summary>
    R2Canvas R;

    /// <summary>The host's canvas for the current frame. The self-test reads
    /// its pixels for the BMP dumps, so Render stashes it for the walk.</summary>
    Canvas C;

    /// <summary>Per-frame render: the shell scene or the playing scene, then
    /// the self-test's screenshot gates.</summary>
    public void Render(GuiHost host, Canvas c, double alpha) {
        this.C = c;
        this.R = R2Canvas.Create(c);
        // The stage for this frame: StageViewport has already mapped the
        // window, so this is the extended logical size the layout hangs
        // off. On a 16:9 window it is exactly 1280x720.
        Ra2App.SetStage(host.StageWidth(), host.StageHeight());
        if (this.shell.CurrentScene() == 2) {
            this.RenderGame(host);
        } else {
            this.RenderShell(host);
        }

        // The self-test walk: the script fires on the *current* frame count
        // (not after an increment), and a screen change is re-rendered before
        // the shot so the capture belongs to the new scene. A previous
        // ordering -- shot first, script after -- caused several screens to
        // be photographed before they were drawn, so single/skirmish/lobby
        // captures all came out byte-identical.
        if (this.selfTest) {
            this.SelfTestScript(host);
            if (this.shell.CurrentScene() == 2) {
                this.RenderGame(host);
            } else {
                this.RenderShell(host);
            }
            this.SelfTestShots(host);
        }

        // The click is spent by the frame it drew; clear it for the next.
        this.clicked = false;
        this.rightClicked = false;
        if (this.selfTest) { this.frames = this.frames + 1; }
    }

    /// <summary>The reference's Fullscreen entry toggles the window's full
    /// screen state (`HomeScreen.toggleFullscreen`). The Zan stdlib exposes no
    /// dedicated fullscreen API, so this rides the window's maximize toggle --
    /// the closest available state -- and the entry is only offered when the
    /// host actually has a window to drive.</summary>
    static void ToggleFullscreen(GuiHost host) {
        if (host == null || host.app == null) { return; }
        host.app.window.ToggleMaximize();
    }

    /// <summary>The shell scenes: menu (0), options (5), loading (3) and
    /// skirmish setup (1).</summary>
    void RenderShell(GuiHost host) {
        if (this.shell.CurrentScene() == 0) {
            int act = Screens.DrawMainMenu(this.R, this.art, this.ui,
                Ra2App.ViewW(), Ra2App.ViewH(), this.mouseX, this.mouseY, this.clicked);
            // The reference's home list goes straight to its target: Skirmish
            // is a top-level entry (`HomeScreen.ts:55` goToScreen(Skirmish)),
            // not nested under a single-player page.
            if (act == 1) { this.shell.OpenSkirmish(); }
            if (act == 2) { this.shell.OpenOptions(); }
            if (act == 4) { Ra2Loop.ToggleFullscreen(host); }
        } else if (this.shell.CurrentScene() == 6) {
            // The map picker, pushed by 选图 (Scene.MapSelect). Its own
            // sidebar carries 使用地图 / 导入地图 / 取消.
            List<string> selMaps = this.maps;
            R2Tex selPreview = this.preview;
            int sact = Screens.DrawMapSelect(this.R, this.art, this.shell,
                selMaps, selPreview, this.ui, Ra2App.ViewW(), Ra2App.ViewH(),
                this.mouseX, this.mouseY, this.clicked);
            if (sact == 1) {
                this.shell.UseMap();
                this.dirty = true;
            } else if (sact == 3) {
                this.shell.CancelMap();
                this.dirty = true;
            }
        } else if (this.shell.CurrentScene() == 5) {
            int act = Screens.DrawOptions(this.R, this.art, this.shell, this.ui,
                this.mouseX, this.mouseY, this.clicked, Ra2App.ViewW(), Ra2App.ViewH(),
                Ra2App.scrollStep);
            if (act >= 10 && act < 20) {
                Ra2App.scrollStep = (act - 10 + 1) * 16;
            }
        } else if (this.shell.CurrentScene() == 3) {
            // The loading screen: the LS800 backdrop draws while the map
            // itself is not yet built; when the bar tops out, EnterGame
            // flips to Playing and the normal game-load path below runs
            // on that frame.
            int per = this.selfTest ? 50 : 4;
            int pct = Ra2App.loadFrames * per;
            if (pct > 100) { pct = 100; }
            List<int> lrgb = new List<int>();
            Ra2App.RulesLoadColor(this.db, this.shell.SideIndex(), lrgb);
            R2Tex backdrop = Ra2App.LoadingBackdrop(this.vfs, this.shell.CountryReg());
            Screens.DrawLoading(this.R, this.art, backdrop, this.shell, this.ui,
                this.maps[this.shell.MapIndex()], pct, lrgb[0], lrgb[1], lrgb[2],
                Ra2App.ViewW(), Ra2App.ViewH());
            Ra2App.loadFrames = Ra2App.loadFrames + 1;
            if (pct >= 100) {
                Ra2App.loadFrames = 0;
                this.shell.EnterGame();
            }
        } else if (this.shell.CurrentScene() == 1) {
            Console.WriteLine("selftest DrawSkirmish scene=1 maps="
                + Convert.ToString(this.maps.Count));
            if (this.previewIndex != this.shell.MapIndex()) {
                this.preview = null;
                this.preview = Ra2App.BuildPreview(this.R, this.db, this.vfs,
                                              this.maps[this.shell.MapIndex()]);
                this.previewIndex = this.shell.MapIndex();
            }
            int act = Screens.DrawSkirmish(this.R, this.art, this.shell,
                this.maps, this.preview, this.ui, Ra2App.ViewW(), Ra2App.ViewH(),
                this.mouseX, this.mouseY, this.clicked);
            if (act == 1) {
                Ra2App.gameMenu = false;
                Ra2App.gameMenuScreen = 0;
                this.shell.StartGame();
            }
            if (act == 2) { this.shell.Back(); }
            if (act == 3) { this.shell.OpenMapSelect(); this.dirty = true; }
        }
    }

    /// <summary>The playing scene: load the map when it changed, advance the
    /// logic clock, spend input, composite the terrain, then draw the HUD.</summary>
    void RenderGame(GuiHost host) {
        if (this.loadedIndex != this.shell.MapIndex()) {
            this.LoadGame();
        }
        this.AdvanceClock();
        this.SpendGameInput();
        // Sound upkeep: EVA queue discipline, music advance, world-voice
        // volume fades -- wall-clock work riding the frame, and the
        // positional listener follows the camera each frame.
        if (this.snd != null && this.cam != null) {
            this.snd.SetViewport(this.cam.X(), this.cam.Y(),
                                 this.cam.SpanW(), this.cam.SpanH());
            this.snd.Update(Window.GetTickMs());
        }
        // Ore grew or was harvested: its sprites bake into the terrain layer,
        // so a changed counter means the scene canvas is stale. The refresh
        // coalesces to one composite every 300ms -- a working miner would
        // otherwise re-encode the full scene several times a second for a
        // change the eye can barely catch. A trailing refresh is guaranteed
        // because the counter only catches up when the composite runs.
        if (this.world != null
         && this.world.OreVersion() != this.seenOreVersion) {
            int nowMs = Window.GetTickMs();
            if (nowMs - this.lastOreCompositeMs >= 300) {
                this.lastOreCompositeMs = nowMs;
                this.seenOreVersion = this.world.OreVersion();
                this.dirty = true;
            }
        }
        this.CompositeTerrain();
        this.DrawGameHud(host);

        // Edge panning: hold the cursor against a screen edge to scroll the
        // view that way, except over the sidebar. Headless self-test runs
        // leave the mouse at (0,0), which would walk the camera to a map
        // corner before the first dump -- pan only after a real mouse motion
        // has been seen.
        if (this.cam != null && !Ra2App.InSidebar(this.mouseX)
         && this.mouseSeen && !Ra2App.gameMenu) {
            int edge = 12;
            if (this.mouseY < edge) { this.cam.MoveBy(0, 0 - this.panStep); this.dirty = true; }
            if (this.mouseY > Ra2App.ViewH() - edge) { this.cam.MoveBy(0, this.panStep); this.dirty = true; }
            if (this.mouseX < edge) { this.cam.MoveBy(0 - this.panStep, 0); this.dirty = true; }
        }
    }

    /// <summary>Places the map's own neutral scenery: the [Units],
    /// [Infantry] and [Aircraft] entries the map file declares, keeping only
    /// the Neutral-owned ones (mirroring the reference's
    /// createInitialMapTechnos -- the players' force comes from the
    /// waypoints, so a house-owned map entry is the campaign's business).
    ///
    /// A reg resolves through the side rosters first and the rules' neutral
    /// scenery list second, so a map that parks a real tank is drawn as that
    /// tank and a map that parks a pickup truck gets the civ entry.
    ///
    /// The direction is RA2's 0..255 counter-clockwise byte; the reference
    /// maps it as (-direction / 256) * 360 degrees, which on the engine's
    /// 8-point clockwise ring lands on 8 - round(dir * 8 / 256). Health is
    /// the entry's own 0..256 fraction of the archetype's.</summary>
    void PlaceMapUnits() {
        int placed = 0;
        int uN = this.map.UnitCount();
        for (int i = 0; i < uN; i = i + 1) {
            List<string> f = new List<string>();
            if (!this.map.UnitEntry(i, f)) { continue; }
            if (f[0] != "Neutral") { continue; }
            if (this.PlaceOneMapUnit(f[1], f[2], f[3], f[4], f[5], "vehicle")) {
                placed = placed + 1;
            }
        }
        // Infantry share the shape but carry a sub-cell between the cell
        // and the direction: owner,name,health,rx,ry,subCell,?,dir,tag,...
        // The sub-cell (0-4, the four corners and the centre of a cell) is
        // what lets several soldiers stand on one tile; the world's grid is
        // one unit per cell, so the facing still comes through and the
        // sub-cell is left to the original's finer placement.
        int iN = this.map.InfantryCount();
        for (int i = 0; i < iN; i = i + 1) {
            List<string> f = new List<string>();
            if (!this.map.InfantryEntry(i, f)) { continue; }
            if (f[0] != "Neutral") { continue; }
            if (this.PlaceOneMapUnit(f[1], f[2], f[3], f[4], f[7], "infantry")) {
                placed = placed + 1;
            }
        }
        // Aircraft carry the vehicle shape; the shipped maps declare none,
        // but the reader is here so a map that does is not silently emptied.
        int aN = this.map.AircraftCount();
        for (int i = 0; i < aN; i = i + 1) {
            List<string> f = new List<string>();
            if (!this.map.AircraftEntry(i, f)) { continue; }
            if (f[0] != "Neutral") { continue; }
            if (this.PlaceOneMapUnit(f[1], f[2], f[3], f[4], f[5], "aircraft")) {
                placed = placed + 1;
            }
        }
        this.mapUnitPlaced = placed;
    }

    /// <summary>Places one map object by its reg, health byte and direction
    /// byte. Returns false when the reg names nothing the rules carry or the
    /// cell is unavailable.
    ///
    /// Three resolution paths, in the reference's order: a side roster unit
    /// (a map that parks a real tank draws as that tank), the rules' own
    /// neutral scenery list, and finally the install's declared type list --
    /// a map may place any reg the install declares in [VehicleTypes] /
    /// [InfantryTypes] / [AircraftTypes] even when nothing trains it (a taxi,
    /// a monkey, a construction excavator), which the reference answers with
    /// ensureMapObjectDefaults.</summary>
    bool PlaceOneMapUnit(string reg, string hpS, string xS, string yS,
                         string dirS, string kind) {
        string name = reg.ToUpper();
        int x = Convert.ToInt32(xS);
        int y = Convert.ToInt32(yS);
        int facing = Ra2App.MapDirectionToFacing(Convert.ToInt32(dirS));
        int hp256 = Convert.ToInt32(hpS);
        // Scenery resolves through the rules' neutral list, which knows its
        // own hp; a reg nothing carries falls to the install's declared type
        // list. Either way the resolved archetype supplies the hp scale.
        int civId = this.world.Units().CivUnitIdOf(name);
        if (civId >= 0) {
            UnitType ct = this.world.Units().CivUnitType(civId);
            int chp = ct == null ? 0 : ct.Hp() * hp256 / 256;
            return this.world.SpawnCivUnit(civId, x, y, chp, facing) >= 0;
        }
        UnitType ut = this.rulesRef.MapObjectUnitType(this.world.Units(),
                                                      name, kind);
        if (ut == null) { return false; }
        int hp = ut.Hp() * hp256 / 256;
        return this.world.SpawnMapUnitType(ut, x, y, hp, facing) >= 0;
    }

    /// <summary>Records the map's [Smudge] decals (craters, burn marks) on
    /// the world so the terrain renderer draws them. A smudge has no owner
    /// and no object slot in the original either -- it is a decal layer --
    /// so it never becomes a WorldObject.</summary>
    void PlaceMapSmudges() {
        int n = this.map.SmudgeCount();
        for (int i = 0; i < n; i = i + 1) {
            List<string> f = new List<string>();
            if (!this.map.SmudgeEntry(i, f)) { continue; }
            this.world.AddSmudge(f[0].ToUpper(), Convert.ToInt32(f[1]),
                                 Convert.ToInt32(f[2]));
        }
    }

    /// <summary>The mobile construction vehicle's regkey for a faction: every
    /// skirmish house opens on one and unfolds it into its construction yard.
    /// The install's rules name the trio AMCV/SMCV/PCV; Yuri's Revenge reuses
    /// the Soviet hull under PCV.</summary>
    static string McvReg(int faction) {
        if (faction == Side2.Soviet()) { return "SMCV"; }
        if (faction == Side2.Yuri()) { return "PCV"; }
        return "AMCV";
    }

    /// <summary>The structure regkey an MCV unfolds into, so the opener can
    /// test that the yard actually fits where the vehicle is put down.</summary>
    string McvTargetReg(int side, int unitId) {
        UnitType mu = this.world.Units().TypeFor(this.world, side, unitId);
        if (mu == null) { return null; }
        return mu.DeploysInto();
    }

    /// <summary>The build id the MCV's deploy target occupies in a side's own
    /// structure list, or -1.</summary>
    int McvTargetId(int side, int unitId) {
        string reg = this.McvTargetReg(side, unitId);
        if (reg == null || reg.Length == 0) { return -1; }
        return this.world.Catalog().IdOfReg(this.world, side, reg);
    }

    /// <summary>A start cell for a house's MCV near a map waypoint: the
    /// nearest cell where the construction yard that vehicle unfolds into
    /// actually fits, tested at the very anchor the deploy will pick. The
    /// unfold probes its anchor list from the most centred outwards, so the
    /// MCV cell is accepted only when the centred placement is free -- that
    /// is the one the opener then reserves for the opening squad, and the
    /// one the deploy finds waiting when the player presses F.</summary>
    bool FindMcvSpot(int side, int unitId, int wx, int wy, List<int> outXy) {
        int yardId = this.McvYardId(side, unitId);
        StructureType t = this.world.Catalog().TypeFor(this.world, side, yardId);
        if (t == null) { return false; }
        for (int r = 0; r <= 8; r = r + 1) {
            for (int dy = -r; dy <= r; dy = dy + 1) {
                for (int dx = -r; dx <= r; dx = dx + 1) {
                    int adx = dx < 0 ? -dx : dx;
                    int ady = dy < 0 ? -dy : dy;
                    if (r > 0 && adx != r && ady != r) { continue; }
                    int x = wx + dx;
                    int y = wy + dy;
                    if (!this.world.Passable(x, y)) { continue; }
                    if (!this.McvSpotFits(side, yardId, t, x, y)) { continue; }
                    outXy.Add(x);
                    outXy.Add(y);
                    return true;
                }
            }
        }
        return false;
    }

    /// <summary>The MCV spot for a house with no usable waypoint: the
    /// furthest-flat-corner scan PlaceEnemyBase used, so a fallback base
    /// still lands opposite the player's start.</summary>
    bool FindMcvSpotAnywhere(int side, int unitId, List<int> outXy) {
        int yardId = this.McvYardId(side, unitId);
        StructureType t = this.world.Catalog().TypeFor(this.world, side, yardId);
        if (t == null) { return false; }
        int bestX = -1;
        int bestY = -1;
        for (int y = 0; y < this.world.Height(); y = y + 1) {
            for (int x = 0; x < this.world.Width(); x = x + 1) {
                if (!this.world.Passable(x, y)) { continue; }
                if (!this.McvSpotFits(side, yardId, t, x, y)) { continue; }
                if (bestX < 0 || x + y > bestX + bestY) {
                    bestX = x;
                    bestY = y;
                }
            }
        }
        if (bestX < 0) { return false; }
        outXy.Add(bestX);
        outXy.Add(bestY);
        return true;
    }

    /// <summary>The yard's build id for a house's MCV, or 0 (the roster's
    /// own construction yard) when the rules name no deploy target.</summary>
    int McvYardId(int side, int unitId) {
        int targetId = this.McvTargetId(side, unitId);
        return targetId >= 0 ? targetId : 0;
    }

    /// <summary>Whether the centred deploy anchor for an MCV standing at
    /// (x,y) fits. See FindMcvSpot.</summary>
    bool McvSpotFits(int side, int yardId, StructureType t, int x, int y) {
        int ax = x - t.FootprintW() / 2;
        int ay = y - t.FootprintH() / 2;
        return this.world.CanPlaceBuilding(side, yardId, ax, ay);
    }

    /// <summary>The rectangle the MCV at (x,y) will occupy once deployed,
    /// written to outRect as x,y,w,h, using the same centred anchor the
    /// deploy probes first. The opener hands this to the squad spawn so the
    /// soldiers stand clear of the unfold. Leaves outRect empty when the
    /// target is unknown.</summary>
    void McvFootprintRect(int side, int unitId, int x, int y, List<int> outRect) {
        int yardId = this.McvYardId(side, unitId);
        StructureType t = this.world.Catalog().TypeFor(this.world, side, yardId);
        if (t == null) { return; }
        outRect.Add(x - t.FootprintW() / 2);
        outRect.Add(y - t.FootprintH() / 2);
        outRect.Add(t.FootprintW());
        outRect.Add(t.FootprintH());
    }

    /// <summary>Builds the world the setup screen asked for: terrain, the
    /// rules-driven catalogs, the player's base and every open AI house, the
    /// neutral map structures, and the controller. Runs on the first frame of
    /// a game, or when the player backs out and picks a different map.</summary>
    void LoadGame() {

        // Load on the first frame of a game, or when the player backed
        // out and picked a different map.
        if (this.loadedIndex != this.shell.MapIndex()) {
            if (this.terrain != null) {
                this.screen = null;
                this.canvas = null;
                theater.Close();
                this.objArt.Close();
                this.minimap = null;
            }
            this.map = this.db.MapNamed(this.maps[this.shell.MapIndex()]);
            theater = Theater.Load(this.vfs, this.db, this.map.Theater());
            this.terrain = MapRenderer.Create(this.map.Terrain(), theater);
            this.terrain.SetTerrain(this.map);
            // A fresh game: an empty world over the map's terrain, the
            // player's side, and the starter base. The bases sit on the
            // map's own waypoints -- the old hardcoded (1,2) is outside
            // the playable diamond on most shipped maps, which would
            // strand the base on void terrain. The unit stays selected
            // so its click orders a move immediately.
            // The catalogs come from the Rules: the transcribed RA2
            // defaults, with the install's own RULES.INI layered on
            // top when the data dir carries one. The install's CSF
            // string table rides along so sidebar labels read the
            // original text (RA2MD.CSF, falling back to RA2.CSF).
            Rules rules = Rules.LoadWith(this.db.Rules(), this.db.Strings());
            this.rulesRef = rules;
            // The art ini carries each infantry's frame layout (its
            // Sequence= section); layered on after the rules so the
            // Image= keys the art sections use are already known.
            rules.ApplyArtIni(this.db.Art());
            this.world = World.Create(this.map.Terrain(),
                                 StructureCatalog.CreateWith(rules),
                                 UnitCatalog.CreateWith(rules));
            // The theater's own water table decides what counts as water, so
            // a snow or urban map classifies by its own ids instead of by
            // temperate's. This is what keeps every building but the
            // WaterBound shipyard off the sea.
            this.world.SetWaterRanges(theater.WaterRanges());
            // The theater also classifies terrain: each cell's land class
            // and ramp flag come from the TMP template of the tile it
            // placed, which is how the reference decides passability and
            // what makes a cliff edge distinguishable from a ramp.
            this.world.SetTheater(theater);
            // One pass over the map's overlay plane, the reference's
            // createInitialMapOverlays one cell at a time: GEM fields into
            // the world's ore grid (data byte = amount, the type naming
            // gold ore or the doubled crystal), Wall=yes types up as live
            // wall pieces at their rules Strength, low-bridge cells into
            // the bridge seed table, and everything else parked as a
            // static decal (rocks, fences, crates, tracks). High bridges
            // wait for an elevation layer; the invisible placeholders the
            // reference spawns for repair targeting carry no art and are
            // skipped with them.
            for (int oy = 0; oy < this.world.Height(); oy = oy + 1) {
                for (int ox = 0; ox < this.world.Width(); ox = ox + 1) {
                    int ov = this.map.OverlayAt(ox, oy);
                    if (ov < 0) { continue; }
                    if (rules.IsTiberiumOverlay(ov)) {
                        this.world.SetOre(ox, oy,
                             this.map.OverlayDataAt(ox, oy),
                             rules.OreValue(ov), ov);
                    } else if (rules.IsWallOverlay(ov)) {
                        this.world.SetWall(ox, oy, ov);
                    } else if (World.IsLowBridgeId(ov)) {
                        this.world.SeedBridgeCell(ox, oy, ov,
                             this.map.OverlayDataAt(ox, oy));
                    } else if (World.IsHighBridgeId(ov)
                            || World.IsBridgePlaceholderId(ov)) {
                        // deferred with the elevation layer
                    } else {
                        this.world.SetStaticOverlay(ox, oy, ov,
                             this.map.OverlayDataAt(ox, oy));
                    }
                }
            }
            this.world.FinishBridges();
            // The [Terrain] objects: scenery cells register (ore may not
            // spawn under them) and the SpawnsTiberium types become the
            // tiberium trees whose rolls grow the fields -- the
            // reference's TiberiumTreeTrait on TIBTRE01..03.
            for (int ti = 0; ti < this.map.TerrainCount(); ti = ti + 1) {
                int tx = this.map.TerrainX(ti);
                int ty = this.map.TerrainY(ti);
                this.world.SetMapTerrain(tx, ty);
                int cd = rules.TerrainGrowthTicks(this.map.TerrainType(ti));
                if (cd > 0) { this.world.AddTibTree(tx, ty, cd); }
            }
            this.objArt = ObjectArt.Create(this.vfs, this.db, this.map.Theater());
            int side = this.shell.SideIndex();
            // The shell art is per side: the allied set lives in
            // SIDEC01.MIX, the Soviet set in SIDEC02.MIX -- Yuri's
            // Revenge gives Yuri no shell of his own, he wears the
            // Soviet one like in the retail game. A side without a
            // set leaves sideShell null and the drawn sidebar takes
            // over.
            this.sideShell = SidebarShell.Load(this.vfs, side != Side2.Allied());
            Ra2App.sidebarX0 = this.sideShell.Ok()
                ? Ra2App.ViewW() - this.sideShell.W("CREDITS.SHP")
                : Ra2App.ViewW() - 296;
            // The skirmish screen's start-spot pick: waypoints 0..7
            // are the map's start positions, 0 means 随机 -- any free
            // spot, drawn here as a rotation over the map's own
            // waypoints so consecutive games open in different
            // corners -- and the two houses must not share one.
            int spot = 0;
            if (this.shell.StartPosIndex() > 0) {
                spot = this.shell.StartPosIndex() - 1;
            } else {
                spot = (int)(Window.GetTickMs() / 997 % 8);
            }
            List<int> start = new List<int>();
            int sx = 1;
            int sy = 2;
            if (this.map.StartCell(spot, start) && start.Count >= 2) {
                sx = start[0];
                sy = start[1];
            }
            // The house opens on a mobile construction vehicle, as the
            // original does: no pre-placed base. The vehicle stands on the
            // nearest cell where the construction yard it unfolds into
            // actually fits, so the deploy always has room, and it starts
            // selected -- F (or the deploy order) unfolds it on the spot.
            int mcvId = this.world.Units().IdOfReg(this.world, side,
                                                   this.McvReg(side));
            List<int> mcvSpot = new List<int>();
            int mcv = 0 - 1;
            if (mcvId >= 0) {
                if (this.FindMcvSpot(side, mcvId, sx, sy, mcvSpot)) {
                    mcv = this.world.SpawnUnit(side, mcvId, mcvSpot[0],
                                               mcvSpot[1]);
                } else if (this.FindMcvSpotAnywhere(side, mcvId, mcvSpot)) {
                    mcv = this.world.SpawnUnit(side, mcvId, mcvSpot[0],
                                               mcvSpot[1]);
                }
            }
            // The opening squad, sized by the setup screen's 部队数: each
            // walks out on the ground around the vehicle, keeping off the
            // cells the yard will occupy when the vehicle unfolds. Without an
            // MCV (an install whose rules name none) the old pre-placed
            // starter base stands in, so the game still opens.
            List<int> mcvRect = new List<int>();
            if (mcv >= 0) {
                WorldObject m0 = this.world.ObjectAt(mcv);
                this.McvFootprintRect(side, mcvId, m0.X(), m0.Y(), mcvRect);
            }
            int yardIdx = 0 - 1;
            if (mcv >= 0) {
                int rvx = mcvRect.Count >= 4 ? mcvRect[0] : 0;
                int rvy = mcvRect.Count >= 4 ? mcvRect[1] : 0;
                int rvw = mcvRect.Count >= 4 ? mcvRect[2] : 0;
                int rvh = mcvRect.Count >= 4 ? mcvRect[3] : 0;
                int su = 0;
                while (su < this.shell.UnitCount()) {
                    WorldObject m = this.world.ObjectAt(mcv);
                    int u = this.world.SpawnNearCellAvoid(side, 0, m.X(), m.Y(),
                                                          rvx, rvy, rvw, rvh);
                    if (u < 0) { break; }
                    su = su + 1;
                }
            } else {
                yardIdx = this.world.PlaceBase(side, sx, sy);
                if (yardIdx < 0) { yardIdx = this.world.PlaceBase(side, 1, 2); }
                int su = 0;
                while (yardIdx >= 0 && su < this.shell.UnitCount()) {
                    if (this.world.SpawnNear(yardIdx, 0) < 0) { break; }
                    su = su + 1;
                }
            }
            int scout = mcv >= 0 ? mcv : yardIdx;
            if (scout >= 0) {
                WorldObject s = this.world.ObjectAt(scout);
                this.world.SelectAt(s.X(), s.Y());
            }
            // Every open enemy slot gets a house. A house id is a slot in
            // the world's 8-entry tables, and the player already holds
            // `side`, so the AIs take the ids after it (wrapping) -- giving
            // them 1..N instead would hand the player's own slot away on a
            // Soviet or Yuri start, swapping the roster under them.
            // Factions rotate after the player's so the roster mix mirrors
            // the original's slots. Houses -- not factions -- are the sides
            // in the war, so two AIs on one faction still fight each other;
            // the world's NearestEnemy treats every foreign non-neutral
            // house as hostile, which is the free-for-all.
            List<int> aiHouses = new List<int>();
            List<int> aiDiffs = new List<int>();
            int nextHouse = side + 1;
            for (int s = 0; s < 7; s = s + 1) {
                if (!this.shell.EnemyOpen(s)) { continue; }
                if (nextHouse >= 8) { nextHouse = 0; }
                if (nextHouse == side) { nextHouse = nextHouse + 1; }
                aiHouses.Add(nextHouse);
                aiDiffs.Add(this.shell.EnemyDifficulty(s));
                nextHouse = nextHouse + 1;
            }
            this.world.SetFactions(side, aiHouses);

            // Start spots: the player's waypoint first, then each AI
            // takes the next free waypoint. A taken-spot set replaces
            // the old single-enemy scan; when the map runs out of
            // waypoints the leftover AIs fall back to the far corner,
            // diagonal offsets keeping them from stacking on one spot.
            int aiN = aiHouses.Count;
            int a = 0;
            int fallback = 0;
            // Waypoints handed out so far; a later AI never reuses
            // one. Index 0 tracks the player's own spot.
            bool[] spotTaken = new bool[8];
            for (int w = 0; w < 8; w = w + 1) { spotTaken[w] = false; }
            spotTaken[spot] = true;
            while (a < aiN) {
                int aiSide = aiHouses[a];
                List<int> eStart = new List<int>();
                int eSpot = 0 - 1;
                for (int w = 0; w < 8 && eSpot < 0; w = w + 1) {
                    if (spotTaken[w]) { continue; }
                    eStart = new List<int>();
                    if (this.map.StartCell(w, eStart) && eStart.Count >= 2) {
                        eSpot = w;
                    }
                }
                if (eSpot >= 0) { spotTaken[eSpot] = true; }
                // Every AI house opens on its own MCV, like the player's:
                // the vehicle goes down where its yard fits and the AI's
                // own deploy step (deploy_mcv_commands) unfolds it once the
                // game starts ticking.
                int aiMcvId = this.world.Units().IdOfReg(this.world, aiSide,
                    this.McvReg(this.world.FactionOf(aiSide)));
                List<int> aiSpot = new List<int>();
                int aiMcv = 0 - 1;
                int aiYard = 0 - 1;
                if (aiMcvId >= 0 && eSpot >= 0
                 && this.FindMcvSpot(aiSide, aiMcvId, eStart[0], eStart[1],
                                     aiSpot)) {
                    aiMcv = this.world.SpawnUnit(aiSide, aiMcvId, aiSpot[0],
                                                 aiSpot[1]);
                } else if (aiMcvId >= 0
                        && this.FindMcvSpotAnywhere(aiSide, aiMcvId, aiSpot)) {
                    aiMcv = this.world.SpawnUnit(aiSide, aiMcvId, aiSpot[0],
                                                 aiSpot[1]);
                } else {
                    // No MCV art or no room anywhere: the old pre-placed
                    // base keeps the AI in the game.
                    if (eSpot >= 0) {
                        aiYard = this.world.PlaceBase(aiSide, eStart[0],
                                                 eStart[1]);
                    } else {
                        int fy = 0 - 1 - fallback * 6;
                        int fyy = fy < 0 ? 0 - fy : 0;
                        aiYard = this.world.PlaceBase(aiSide,
                            this.world.Width() - 4 - fallback * 5,
                            fyy > 0 ? fyy : 1);
                        fallback = fallback + 1;
                        if (aiYard < 0) { this.world.PlaceEnemyBase(aiSide); }
                    }
                }
                // The AI's squad stands clear of its own yard's footprint
                // for the same reason the player's does: its deploy step
                // must find the anchor free.
                List<int> aiRect = new List<int>();
                if (aiMcv >= 0) {
                    WorldObject m0 = this.world.ObjectAt(aiMcv);
                    this.McvFootprintRect(aiSide, aiMcvId, m0.X(), m0.Y(),
                                          aiRect);
                }
                int au = 0;
                while (au < this.shell.UnitCount()) {
                    int u = 0 - 1;
                    if (aiMcv >= 0) {
                        WorldObject m = this.world.ObjectAt(aiMcv);
                        u = this.world.SpawnNearCellAvoid(aiSide, 0, m.X(),
                            m.Y(), aiRect.Count >= 4 ? aiRect[0] : 0,
                            aiRect.Count >= 4 ? aiRect[1] : 0,
                            aiRect.Count >= 4 ? aiRect[2] : 0,
                            aiRect.Count >= 4 ? aiRect[3] : 0);
                    } else if (aiYard >= 0) {
                        u = this.world.SpawnNear(aiYard, 0);
                    }
                    if (u < 0) { break; }
                    au = au + 1;
                }
                a = a + 1;
            }
            // Neutral civilian structures from the map's [Structures]:
            // oil derricks, hospitals and city props an engineer can
            // take for his side. House-owned entries are skipped --
            // the skirmish bases come from the waypoints, not the
            // map's scripted layout. Regs the Rules' civ catalog does
            // not know have no stats and no art, so they stay out.
            int civCount = this.map.StructureCount();
            for (int ci = 0; ci < civCount; ci = ci + 1) {
                List<string> f = new List<string>();
                if (!this.map.StructureEntry(ci, f)) { continue; }
                if (f[0] != "Neutral") { continue; }
                int civId = this.world.Catalog().CivIdOf(f[1]);
                if (civId < 0) { continue; }
                StructureType ct = this.world.Catalog().CivType(civId);
                if (ct == null) { continue; }
                int chp = Convert.ToInt32(f[2]);
                int hp = ct.Hp() * chp / 256;
                this.world.PlaceCivStructure(civId, Convert.ToInt32(f[3]),
                                        Convert.ToInt32(f[4]), hp);
            }
            // Pre-placed neutral units and map smudges. The reference
            // (game/Game.ts createInitialMapTechnos / createInitialMapSmudges)
            // reads [Units], [Infantry] and [Aircraft] the same way it reads
            // [Structures] and keeps only the Neutral-owned ones: on a
            // skirmish map those are the scenery -- parked cars, wandering
            // cows -- while the players' own force comes from the waypoints.
            // These were never read at all before, which is why a shipped map
            // loaded empty: MP03T4 alone parks 45 vehicles and 2 cows.
            //
            // The entries carry their own health (0..256 scale) and a compass
            // direction on RA2's 0..255 counter-clockwise ring, which is what
            // makes a queue of parked cars point different ways instead of
            // all looking north.
            this.PlaceMapUnits();
            this.PlaceMapSmudges();
            this.game = GameController.CreateMulti(this.world, side, aiHouses,
                aiDiffs, this.shell.StartCredits());
            this.game.SetShortGame(this.shell.ShortGame());
            this.terrain.SetWorld(this.world, this.objArt, side);
            // Fog of war: one shroud per house, seeded from the map, with
            // every house's opening forces revealing their sight circles.
            this.world.InitShrouds();
            // Goodie crates: the lobby switch, the rim scan and the
            // population floor. The first tick tops the field up.
            this.world.InitCrates(this.shell.Crates());
            // Battle audio: the reference's onGameStart starts the normal
            // playlist and builds EVA against the local side (its voice
            // column in eva.ini). Tables come from the install through the
            // VFS; shuffle stays off until an options screen exists.
            this.snd = SndEngine.Load(this.vfs, this.db.Rules(), side);
            this.snd.MusicNormal(false);
            // The world fires weapon reports at the trigger pull; the
            // controller's order/selection hooks answer through the same
            // engine.
            this.world.SetSoundSink(this.snd);
            this.cam = Camera.Create(Ra2App.ViewW(), Ra2App.ViewH(),
                                this.terrain.WorldWidth(), this.terrain.WorldHeight());
            // Start the camera on the player's own base, not the map
            // centre -- a 6000px-wide map centred on open ground looks
            // like a dead fixed view. The centre is the house's own opening
            // piece: its MCV when the rules gave it one (the spot search may
            // have walked it off the waypoint), else the pre-placed yard. The
            // cell projects to a world pixel; centre on it.
            {
                int viewX = sx;
                int viewY = sy;
                if (mcv >= 0) {
                    WorldObject mv = this.world.ObjectAt(mcv);
                    viewX = mv.X();
                    viewY = mv.Y();
                } else if (yardIdx >= 0) {
                    WorldObject yd = this.world.ObjectAt(yardIdx);
                    viewX = yd.X();
                    viewY = yd.Y();
                }
                int yardX = IsoProjection.ScreenX(viewX, viewY) - this.terrain.OriginX();
                int yardY = IsoProjection.ScreenY(viewX, viewY, 0) - this.terrain.OriginY();
                this.cam.MoveTo(yardX - this.cam.SpanW() / 2,
                           yardY - this.cam.SpanH() / 2);
            }
            this.canvas = Texture.Create(Ra2App.ViewW(), Ra2App.ViewH());
            if (this.minimap != null) { this.minimap = null; }
            this.minimap = Ra2App.BuildMinimap(this.R, this.terrain);
            this.loadedIndex = this.shell.MapIndex();
            this.dirty = true;
            Console.WriteLine("loaded " + this.maps[this.loadedIndex]
                + " " + this.map.Theater()
                + " cells=" + Convert.ToString(this.terrain.CellCount())
                + " this.world=" + Convert.ToString(this.terrain.WorldWidth())
                + "x" + Convert.ToString(this.terrain.WorldHeight())
                + " side=" + Side.NameOf(side)
                + " obj=" + Convert.ToString(this.world.ObjectCount())
                + " mapUnits=" + Convert.ToString(this.mapUnitPlaced)
                + " smudge=" + Convert.ToString(this.world.SmudgeCount()));
        }

        // Real time: each full chunk that accumulated since the
    }

    /// <summary>Real time: each full chunk accumulated since the last frame
    /// spends one logic tick, up to a small burst cap so a lagging frame
    /// never fast-forwards the battle. The chunk length is the setup screen's
    /// 游戏速度: 6 runs at the original's pace, each step slower stretches the
    /// tick by a third. While paused or after the result the clock only
    /// re-anchors.</summary>
    void AdvanceClock() {

            // Real time: each full chunk that accumulated since the
            // last frame spends one logic tick, up to a small burst cap so
            // a lagging frame never fast-forwards the battle. The chunk
            // length is the setup screen's 游戏速度: 6 runs at the
            // original's pace, each step slower stretches the tick by a
            // third. While paused or after the result is decided the
            // clock just re-anchors.
            int nowMs = Window.GetTickMs();
            int tickMs = 66 + (6 - this.shell.GameSpeed()) * 33;
            if (this.game != null && !this.game.Paused() && this.game.Result() == 0
             && !Ra2App.gameMenu) {
                if (this.lastMs >= 0) { this.accMs = this.accMs + (nowMs - this.lastMs); }
                this.lastMs = nowMs;
                int steps = 0;
                int pt0 = Window.GetTickMs();
                while (this.accMs >= tickMs && steps < 4) {
                    this.game.Tick();
                    this.accMs = this.accMs - tickMs;
                    steps = steps + 1;
                    this.dirty = true;
                }
                if (Ra2App.profOn > 0 && steps > 0) {
                    Ra2App.profTick = Ra2App.profTick + (Window.GetTickMs() - pt0);
                }
                if (this.accMs > tickMs * 4) { this.accMs = 0; }
            } else {
                this.lastMs = nowMs;
                this.accMs = 0;
            }

            // Clicks become world commands (place, select, move) before the
            // frame is drawn, so the response is immediate. Once a side
            // has won, input freezes -- only Esc remains.
            if (this.clicked && this.game != null && this.game.Result() == 0) {
                // The game menu has the sidebar: its buttons act on
                // their own release, nothing else takes this click.
                if (Ra2App.gameMenu) {
                    this.clicked = false;
                // Build menu entries live on the right sidebar; clicks there
                // arm a build (or, on the production panel, queue a unit).
                // Everything else maps to a cell.
                } else if (Ra2App.InSidebar(this.mouseX)) {
                    int sr = Ra2App.HitSellRepair(this.game, this.sideShell,
                                                  this.mouseX, this.mouseY);
                    List<int> crc = new List<int>();
                    if (this.sideShell != null && this.sideShell.Ok()) {
                        Ra2App.ShellRects(this.sideShell, crc);
                    }
                    if (sr == 0) { this.game.ToggleSell(); }
                    else if (sr == 1) { this.game.ToggleRepair(); }
                    else if (this.sideShell != null && this.sideShell.Ok()
                         && Ra2App.HitTab(this.sideShell, crc, this.mouseX,
                                          this.mouseY) >= 0) {
                        // The tab pair picks the structures card's
                        // page: plain buildings or armed defences.
                        int tab = Ra2App.HitTab(this.sideShell, crc, this.mouseX,
                                                this.mouseY);
                        if (tab < 2 && Ra2App.buildTab != tab) {
                            Ra2App.buildTab = tab;
                            Ra2App.cardPage = 0;
                        }
                    } else if (this.sideShell != null && this.sideShell.Ok()
                         && Ra2App.HitCardScroll(this.sideShell, this.mouseX,
                                                 this.mouseY) != 0) {
                        // The page pair beside the footer: up or down a
                        // page of card slots.
                        Ra2App.cardPage = Ra2App.cardPage
                            + (Ra2App.HitCardScroll(this.sideShell, this.mouseX,
                                                    this.mouseY) < 0 ? 1 : -1);
                        if (Ra2App.cardPage < 0) { Ra2App.cardPage = 0; }
                    } else if (this.sideShell != null && this.sideShell.Ok()) {
                        // The card: a selected producer's trainees, or
                        // the side's buildings, the same tiles that are
                        // drawn.
                        bool units = Ra2App.ProdCount(this.game) > 0;
                        int items = units
                            ? Ra2App.ProdCount(this.game)
                            : Ra2App.BuildItemCount(this.game,
                                                    Ra2App.buildTab);
                        int slot = Ra2App.HitCardSlot(this.game, this.sideShell,
                                                      this.mouseX, this.mouseY,
                                                      items);
                        if (slot >= 0) {
                            if (units) {
                                this.game.OnClickUnit(
                                    Ra2App.ProdUnitAt(this.game, slot));
                            } else {
                                this.game.OnClickBuild(
                                    Ra2App.BuildItemAt(this.game, slot,
                                                       Ra2App.buildTab));
                            }
                        }
                    } else {
                    int pid = Ra2App.HitProduction(this.game, this.mouseX, this.mouseY);
                    if (pid >= 0) {
                        this.game.OnClickUnit(pid);
                    } else {
                    // The build grid: two columns of cameo tiles, the
                    // same geometry DrawSidebar draws.
                    int bid = -1;
                    for (int bi = 0; bi < this.game.World().Catalog()
                                        .CountFor(this.game.World(), this.game.Side()); bi = bi + 1) {
                        if (R2Panel.PointIn(this.mouseX, this.mouseY,
                                         Ra2App.BuildBtnX(bi),
                                         Ra2App.BuildBtnY(bi),
                                         Ra2App.BtnW(), Ra2App.BtnH())) {
                            bid = bi;
                            break;
                        }
                    }
                    if (bid >= 0) {
                        this.game.OnClickBuild(bid);
                    }
                    }
                    }
                } else if (this.cam != null) {
                    int wx = this.cam.X() + Ra2App.ScaleX(this.mouseX, this.cam.ZoomNum(), this.cam.ZoomDen());
                    int wy = this.cam.Y() + Ra2App.ScaleY(this.mouseY, this.cam.ZoomNum(), this.cam.ZoomDen());
                    List<int> xy = new List<int>();
                    xy.Add(0);
                    xy.Add(0);
                    IsoProjection.CellAt(wx + this.terrain.OriginX(),
                                         wy + this.terrain.OriginY(), xy);
                    this.game.OnClickCell(xy[0], xy[1]);
                }
                this.dirty = true;
            }
            if (this.rightClicked && this.game != null && this.cam != null
             && this.game.Result() == 0) {
                if (Ra2App.InSidebar(this.mouseX)) {
                    // The sidebar takes no map orders: a right click
                    // drops an armed build or sell/repair, and over a
                    // production card it cancels one queued instance --
                    // the original's dequeue, refund included.
                    this.game.OnRightClickSidebar();
                    if (this.sideShell != null && this.sideShell.Ok()) {
                        bool units = Ra2App.ProdCount(this.game) > 0;
                        int items = units
                            ? Ra2App.ProdCount(this.game)
                            : Ra2App.BuildItemCount(this.game,
                                                    Ra2App.buildTab);
                        int slot = Ra2App.HitCardSlot(this.game, this.sideShell,
                                                      this.mouseX, this.mouseY,
                                                      items);
                        if (slot >= 0 && units) {
                            this.game.OnRightClickUnit(
                                Ra2App.ProdUnitAt(this.game, slot));
                        }
                    }
                } else {
                    int wx = this.cam.X() + Ra2App.ScaleX(this.mouseX, this.cam.ZoomNum(), this.cam.ZoomDen());
                    int wy = this.cam.Y() + Ra2App.ScaleY(this.mouseY, this.cam.ZoomNum(), this.cam.ZoomDen());
                    List<int> xy = new List<int>();
                    xy.Add(0);
                    xy.Add(0);
                    IsoProjection.CellAt(wx + this.terrain.OriginX(),
                                         wy + this.terrain.OriginY(), xy);
                    this.game.OnRightClick(xy[0], xy[1]);
                }
                this.dirty = true;
            }
            if (this.game != null && this.game.NeedsRedraw()) { this.dirty = true; }
    }

    /// <summary>Spends this frame's click and right-click: sidebar build/
    /// train/queue actions, or a map cell order. Input freezes once a side
    /// has won -- only Esc remains.</summary>
    void SpendGameInput() {

            // Real time: each full chunk that accumulated since the
            // last frame spends one logic tick, up to a small burst cap so
            // a lagging frame never fast-forwards the battle. The chunk
            // length is the setup screen's 游戏速度: 6 runs at the
            // original's pace, each step slower stretches the tick by a
            // third. While paused or after the result is decided the
            // clock just re-anchors.
            int nowMs = Window.GetTickMs();
            int tickMs = 66 + (6 - this.shell.GameSpeed()) * 33;
            if (this.game != null && !this.game.Paused() && this.game.Result() == 0
             && !Ra2App.gameMenu) {
                if (this.lastMs >= 0) { this.accMs = this.accMs + (nowMs - this.lastMs); }
                this.lastMs = nowMs;
                int steps = 0;
                int pt0 = Window.GetTickMs();
                while (this.accMs >= tickMs && steps < 4) {
                    this.game.Tick();
                    this.accMs = this.accMs - tickMs;
                    steps = steps + 1;
                    this.dirty = true;
                }
                if (Ra2App.profOn > 0 && steps > 0) {
                    Ra2App.profTick = Ra2App.profTick + (Window.GetTickMs() - pt0);
                }
                if (this.accMs > tickMs * 4) { this.accMs = 0; }
            } else {
                this.lastMs = nowMs;
                this.accMs = 0;
            }

            // Clicks become world commands (place, select, move) before the
            // frame is drawn, so the response is immediate. Once a side
            // has won, input freezes -- only Esc remains.
            if (this.clicked && this.game != null && this.game.Result() == 0) {
                // The game menu has the sidebar: its buttons act on
                // their own release, nothing else takes this click.
                if (Ra2App.gameMenu) {
                    this.clicked = false;
                // Build menu entries live on the right sidebar; clicks there
                // arm a build (or, on the production panel, queue a unit).
                // Everything else maps to a cell.
                } else if (Ra2App.InSidebar(this.mouseX)) {
                    int sr = Ra2App.HitSellRepair(this.game, this.sideShell,
                                                  this.mouseX, this.mouseY);
                    List<int> crc = new List<int>();
                    if (this.sideShell != null && this.sideShell.Ok()) {
                        Ra2App.ShellRects(this.sideShell, crc);
                    }
                    if (sr == 0) { this.game.ToggleSell(); }
                    else if (sr == 1) { this.game.ToggleRepair(); }
                    else if (this.sideShell != null && this.sideShell.Ok()
                         && Ra2App.HitTab(this.sideShell, crc, this.mouseX,
                                          this.mouseY) >= 0) {
                        // The tab pair picks the structures card's
                        // page: plain buildings or armed defences.
                        int tab = Ra2App.HitTab(this.sideShell, crc, this.mouseX,
                                                this.mouseY);
                        if (tab < 2 && Ra2App.buildTab != tab) {
                            Ra2App.buildTab = tab;
                            Ra2App.cardPage = 0;
                        }
                    } else if (this.sideShell != null && this.sideShell.Ok()
                         && Ra2App.HitCardScroll(this.sideShell, this.mouseX,
                                                 this.mouseY) != 0) {
                        // The page pair beside the footer: up or down a
                        // page of card slots.
                        Ra2App.cardPage = Ra2App.cardPage
                            + (Ra2App.HitCardScroll(this.sideShell, this.mouseX,
                                                    this.mouseY) < 0 ? 1 : -1);
                        if (Ra2App.cardPage < 0) { Ra2App.cardPage = 0; }
                    } else if (this.sideShell != null && this.sideShell.Ok()) {
                        // The card: a selected producer's trainees, or
                        // the side's buildings, the same tiles that are
                        // drawn.
                        bool units = Ra2App.ProdCount(this.game) > 0;
                        int items = units
                            ? Ra2App.ProdCount(this.game)
                            : Ra2App.BuildItemCount(this.game,
                                                    Ra2App.buildTab);
                        int slot = Ra2App.HitCardSlot(this.game, this.sideShell,
                                                      this.mouseX, this.mouseY,
                                                      items);
                        if (slot >= 0) {
                            if (units) {
                                this.game.OnClickUnit(
                                    Ra2App.ProdUnitAt(this.game, slot));
                            } else {
                                this.game.OnClickBuild(
                                    Ra2App.BuildItemAt(this.game, slot,
                                                       Ra2App.buildTab));
                            }
                        }
                    } else {
                    int pid = Ra2App.HitProduction(this.game, this.mouseX, this.mouseY);
                    if (pid >= 0) {
                        this.game.OnClickUnit(pid);
                    } else {
                    // The build grid: two columns of cameo tiles, the
                    // same geometry DrawSidebar draws.
                    int bid = -1;
                    for (int bi = 0; bi < this.game.World().Catalog()
                                        .CountFor(this.game.World(), this.game.Side()); bi = bi + 1) {
                        if (R2Panel.PointIn(this.mouseX, this.mouseY,
                                         Ra2App.BuildBtnX(bi),
                                         Ra2App.BuildBtnY(bi),
                                         Ra2App.BtnW(), Ra2App.BtnH())) {
                            bid = bi;
                            break;
                        }
                    }
                    if (bid >= 0) {
                        this.game.OnClickBuild(bid);
                    }
                    }
                    }
                } else if (this.cam != null) {
                    int wx = this.cam.X() + Ra2App.ScaleX(this.mouseX, this.cam.ZoomNum(), this.cam.ZoomDen());
                    int wy = this.cam.Y() + Ra2App.ScaleY(this.mouseY, this.cam.ZoomNum(), this.cam.ZoomDen());
                    List<int> xy = new List<int>();
                    xy.Add(0);
                    xy.Add(0);
                    IsoProjection.CellAt(wx + this.terrain.OriginX(),
                                         wy + this.terrain.OriginY(), xy);
                    this.game.OnClickCell(xy[0], xy[1]);
                }
                this.dirty = true;
            }
            if (this.rightClicked && this.game != null && this.cam != null
             && this.game.Result() == 0) {
                if (Ra2App.InSidebar(this.mouseX)) {
                    // The sidebar takes no map orders: a right click
                    // drops an armed build or sell/repair, and over a
                    // production card it cancels one queued instance --
                    // the original's dequeue, refund included.
                    this.game.OnRightClickSidebar();
                    if (this.sideShell != null && this.sideShell.Ok()) {
                        bool units = Ra2App.ProdCount(this.game) > 0;
                        int items = units
                            ? Ra2App.ProdCount(this.game)
                            : Ra2App.BuildItemCount(this.game,
                                                    Ra2App.buildTab);
                        int slot = Ra2App.HitCardSlot(this.game, this.sideShell,
                                                      this.mouseX, this.mouseY,
                                                      items);
                        if (slot >= 0 && units) {
                            this.game.OnRightClickUnit(
                                Ra2App.ProdUnitAt(this.game, slot));
                        }
                    }
                } else {
                    int wx = this.cam.X() + Ra2App.ScaleX(this.mouseX, this.cam.ZoomNum(), this.cam.ZoomDen());
                    int wy = this.cam.Y() + Ra2App.ScaleY(this.mouseY, this.cam.ZoomNum(), this.cam.ZoomDen());
                    List<int> xy = new List<int>();
                    xy.Add(0);
                    xy.Add(0);
                    IsoProjection.CellAt(wx + this.terrain.OriginX(),
                                         wy + this.terrain.OriginY(), xy);
                    this.game.OnRightClick(xy[0], xy[1]);
                }
                this.dirty = true;
            }
            if (this.game != null && this.game.NeedsRedraw()) { this.dirty = true; }
    }

    /// <summary>Recomposites the terrain canvas when the view moved, then
    /// uploads it -- the visible map. Terrain is static, so nothing is
    /// re-rendered on frames where the camera did not change.</summary>
    void CompositeTerrain() {

            // Terrain is static, so the canvas is only recomposited when
            // the camera actually moved.
            if (this.dirty) {
                // Opaque black, not a zero fill: the terrain only covers the
                // map's diamond, so a transparent clear leaves the host's
                // previous frame showing through the empty corners (it read as
                // a bright magenta wedge at the viewport edge). The retail
                // look past the map border is flat black.
                Ra2App.ClearOpaqueBlack(this.canvas);
                int pf0 = Window.GetTickMs();
                this.drawn = this.terrain.RenderInto(this.canvas, this.cam.X(), this.cam.Y());
                if (this.game != null) {
                    Ra2App.DrawGhost(this.canvas, this.game, this.mouseX, this.mouseY,
                                     this.terrain.OriginX(), this.terrain.OriginY(),
                                     this.cam);
                }
                int pf1 = Window.GetTickMs();
                this.screen = Ra2Ui.RegisterMutable("ra2:scene", this.canvas);
                int pf2 = Window.GetTickMs();
                if (Ra2App.profOn > 0) {
                    Ra2App.profTer = Ra2App.profTer + (pf1 - pf0);
                    Ra2App.profUp = Ra2App.profUp + (pf2 - pf1);
                    if (pf1 - pf0 > Ra2App.profTerMax) {
                        Ra2App.profTerMax = pf1 - pf0;
                    }
                }
                this.dirty = false;
                // The world's redraw vote rides the same consume: without
                // this the flag stays set forever after the first moving
                // tick and the gate never gates.
                if (this.game != null) { this.game.ClearRedraw(); }
            }
    }

    /// <summary>Everything drawn over the terrain: the composited map, the
    /// sidebar, the minimap in its radar bezel, the selection box, then the
    /// HUD text lines and hints.</summary>
    void DrawGameHud(GuiHost host) {
            int pfA = Window.GetTickMs();
            this.R.DrawTexture(this.screen, 0, 0,
                Ra2App.ViewW(), Ra2App.ViewH());
            // Live objects over the terrain layer: units, buildings and
            // combat effects draw from the world's current state every
            // frame through memoized sprites, so nothing here needs the
            // scene canvas recomposited.
            ObjectRenderer.RenderToCanvas(this.world, this.objArt, this.R,
                                 this.cam.X(), this.cam.Y(),
                                 this.terrain.OriginX(), this.terrain.OriginY(),
                                 this.shell.SideIndex());
            // The fog of war over everything live: unexplored ground hides
            // its units, structures and effects under the black decal.
            this.terrain.RenderShroudToCanvas(this.R, this.cam.X(), this.cam.Y(),
                                 this.world.ShroudOf(this.shell.SideIndex()));
            if (this.game != null) {
                Ra2App.DrawSidebar(this.R, this.game, this.objArt,
                                   this.sideShell, this.mouseX, this.mouseY);
                // The minimap rides inside the radar bezel when the
                // shell art is up -- the inset the retail radar leaves
                // -- and the fallback panel's corner box otherwise.
                int mmX = Ra2App.sidebarX0 >= 0 ? Ra2App.sidebarX0
                                                : Ra2App.ViewW() - 296;
                int mmY = 4;
                int mmW = Ra2App.ViewW() - mmX - 28;
                int mmH = 130;
                if (this.sideShell != null && this.sideShell.Ok()) {
                    mmX = mmX + 13;
                    mmY = this.sideShell.H("CREDITS.SHP")
                        + this.sideShell.H("TOP.SHP");
                    mmW = this.sideShell.W("RADAR.SHP") - 28;
                    mmH = this.sideShell.H("RADAR.SHP");
                } else {
                    mmX = mmX + 8;
                    mmY = Ra2App.ViewH() - Ra2App.MiniH() - 30;
                    mmW = Ra2App.MiniW();
                    mmH = Ra2App.MiniH();
                }
                // The game menu hides the radar, so its minimap goes
                // with it.
                if (Ra2App.gameMenu) {
                    mmW = 0 - 1;
                }
                if (mmW > 0) {
                    Ra2App.DrawMinimap(this.R, this.minimap, this.world, this.game,
                                   this.cam, this.terrain, this.mouseX, this.mouseY, this.clicked,
                                   mmX, mmY, mmW, mmH);
                }
                if (this.dragging) {
                    Ra2App.DrawBox(this.R, this.dragStartX, this.dragStartY,
                                   this.mouseX, this.mouseY);
                }
            }
            Screens.DrawHud(this.R, this.maps[this.loadedIndex],
                Side.NameOf(this.shell.SideIndex()), this.terrain.CellCount(), this.drawn,
                Ra2App.ViewW(), Ra2App.ViewH());
            if (this.game != null) {
                Ra2App.DrawSelectionInfo(this.R, this.game);
                Ra2App.DrawResult(this.R, this.game.Result(),
                    Ra2App.ViewW(), Ra2App.ViewH());
                Ra2App.DrawPaused(this.R, this.game,
                    Ra2App.ViewW(), Ra2App.ViewH());
                Ra2App.DrawMoveAttackHint(this.R, this.game, this.mouseX,
                                          this.mouseY);
                Ra2App.DrawSellRepairHint(this.R, this.game, this.mouseX,
                                          this.mouseY);
            }
            if (Ra2App.profOn > 0) {
                int pfB = Window.GetTickMs();
                Ra2App.profDraw = Ra2App.profDraw + (pfB - pfA);
                if (pfB - pfA > Ra2App.profDrawMax) {
                    Ra2App.profDrawMax = pfB - pfA;
                }
                Ra2App.profN = Ra2App.profN + 1;
            }
    }

    /// <summary>Self-test screenshots: read the just-drawn frame while it is
    /// still the current surface.</summary>
    void SelfTestShots(GuiHost host) {
        Canvas c = this.C;

        // --selftest walks the whole flow without a human at the keyboard:
        // menu, setup, then a rendered frame of the first map.
        if (this.selfTest) {
            // Screenshot dumps read the renderer's pixels, so they must
            // run while the finished frame is still the current target.
            // After host.End() presents, the swapchain hands back an
            // arbitrary buffer -- the menu shot used to survive by luck
            // of the rotation while the skirmish one came back blank.
            if (this.frames == 2) {
                Ra2App.DumpScreen(Ra2App.ShotPath("ra2_shot_menu.bmp"),
                                  c);
            }
            // The Options walk: RA2_SELFTEST_TARGET=options opens the
            // Options screen on frame 2 and dumps it on frame 4.
            if (this.frames == 4
                && Ra2App.SelfTestTarget() == "options") {
                Console.WriteLine("selftest options scene="
                    + Convert.ToString(this.shell.CurrentScene())
                    + " hasShellBg="
                    + Convert.ToString(this.art != null
                        && this.art.HasShellBg() ? 1 : 0));
                Ra2App.DumpScreen(Ra2App.ShotPath("ra2_shot_options.bmp"),
                                  c);
            }
            if (this.frames == 4) {
                Ra2App.DumpScreen(Ra2App.ShotPath("ra2_shot_single.bmp"),
                                  c);
            }
            // The skirmish shot fires while the setup screen is up (frame 5,
            // before the country dropdown opens at 6). The map-picker shot
            // is taken by the walk itself, on the frame it pushes the
            // picker, because the picker's lifetime is driven by flags.
            if (this.frames == 5) {
                Console.WriteLine("selftest shot5 scene="
                    + Convert.ToString(this.shell.CurrentScene())
                    + " hasShellBg="
                    + Convert.ToString(this.art != null
                        && this.art.HasShellBg() ? 1 : 0));
                Ra2App.DumpScreen(Ra2App.ShotPath("ra2_shot_skirmish.bmp"),
                                  c);
            }
            if (this.frames == 6) {
                Ra2App.DumpScreen(Ra2App.ShotPath("ra2_shot_lobby.bmp"),
                                  c);
            }
            // The map picker is pushed on frame 7 (visible) and committed on
            // frame 8 (which pops back to setup). Shot 7 catches it open
            // with the filter applied; shot 9 catches the setup screen the
            // picker popped back to.
            if (this.frames == 7) {
                Ra2App.DumpScreen(Ra2App.ShotPath("ra2_shot_mapsel.bmp"),
                                  c);
            }
            if (this.frames == 9 && Ra2App.mapSelUsed) {
                Ra2App.DumpScreen(
                    Ra2App.ShotPath("ra2_shot_mapsel_used.bmp"), c);
            }
        }
    }

    /// <summary>The self-test walk: menu, setup, a game, a stress spawn, and
    /// the two-sided perf corridor -- all without a human at the keyboard.</summary>
    void SelfTestScript(GuiHost host) {
        Canvas c = this.C;

        string target = Ra2App.SelfTestTarget();
        if (target == "options") {
            // Menu -> Options -> Back: the simplest demo of an unimplemented
            // home entry, captured without paying the load chain.
            if (this.frames == 2) { this.shell.OpenOptions(); }
            return;
        }

        // The reference's home list has Skirmish at the top level, so the
        // walk goes menu -> setup directly (`HomeScreen.ts:55`).
        if (this.frames == 4) { this.shell.OpenSkirmish(); }
        // Frame 5 lingers on the setup screen; frame 6 opens the country
        // dropdown for the frame-7 shot.
        if (this.frames == 6) { this.shell.SetCountryListOpen(true); }
        if (this.frames == 7) { this.shell.SelectMap(1); }
        // The map picker: frame 7 pushes it with a filter and sort applied;
        // the following frame commits the choice with 使用地图, which must
        // pop back to setup with the new index. The shots are taken by
        // SelfTestShots on the frames the screens are actually up -- dumping
        // from here would capture the canvas from before the re-render.
        if (this.frames == 7 && !Ra2App.mapSelOpened) {
            Ra2App.mapSelOpened = true;
            this.shell.OpenMapSelect();
            this.shell.SetPickSearch("MP");
            this.shell.SetPickSort(1);
            Console.WriteLine("selftest mapsel scene="
                + Convert.ToString(this.shell.CurrentScene())
                + " pickMap=" + Convert.ToString(this.shell.PickMap())
                + " sort=" + Convert.ToString(this.shell.PickSort())
                + " search=" + this.shell.PickSearch()
                + " maps=" + Convert.ToString(this.maps.Count));
        }
        if (this.frames == 8 && Ra2App.mapSelOpened && !Ra2App.mapSelUsed) {
            Ra2App.mapSelUsed = true;
            this.shell.SetPickSearch("");
            // RA2_SELFTEST_MAP=SNOW (or TEMPERATE/URBAN, or a literal map
            // name) pins the walk to a map of that theatre, so the winter
            // palette and arctic art get exercised end to end.
            int pickIdx = 2;
            string want = Ra2App.getenv("RA2_SELFTEST_MAP");
            if (want != null && want.Length > 0) {
                want = want.ToUpper();
                for (int mi = 0; mi < this.maps.Count; mi = mi + 1) {
                    MapFile mf = this.db.MapNamed(this.maps[mi]);
                    if (mf == null) { continue; }
                    bool hit = this.maps[mi].ToUpper().IndexOf(want) >= 0
                        || mf.Theater().ToUpper() == want;
                    if (hit) { pickIdx = mi; break; }
                }
                // No skirmish map of that theatre in the pool: hunt the
                // shipped campaign maps (the MIX ids are hashes, so the
                // names must be guessed) and swap one in for the walk.
                MapFile picked0 = this.db.MapNamed(this.maps[pickIdx]);
                if (picked0 != null && picked0.Theater().ToUpper() != want) {
                    string[] guesses = new string[] {
                        "ALLIED01.MAP", "ALLIED02.MAP", "ALLIED03.MAP",
                        "ALLIED04.MAP", "ALLIED05.MAP", "ALLIED06.MAP",
                        "ALLIED07.MAP", "ALLIED08.MAP", "ALLIED09.MAP",
                        "ALLIED10.MAP", "ALLIED11.MAP", "ALLIED12.MAP",
                        "SOVIET01.MAP", "SOVIET02.MAP", "SOVIET03.MAP",
                        "SOVIET04.MAP", "SOVIET05.MAP", "SOVIET06.MAP",
                        "SOVIET07.MAP", "SOVIET08.MAP", "SOVIET09.MAP",
                        "SOVIET10.MAP", "SOVIET11.MAP", "SOVIET12.MAP",
                        "ALL01MD.MAP", "ALL02MD.MAP", "ALL03MD.MAP",
                        "ALL04MD.MAP", "ALL05MD.MAP", "ALL06MD.MAP",
                        "ALL07MD.MAP", "SOV01MD.MAP", "SOV02MD.MAP",
                        "SOV03MD.MAP", "SOV04MD.MAP", "SOV05MD.MAP",
                        "SOV06MD.MAP", "SOV07MD.MAP", "INT01.MAP",
                        "INT02.MAP", "INT03.MAP", "MOR01.MAP", "MOR02.MAP",
                        "MOR03.MAP", "MOR04.MAP", "BOOT.MAP", "LOBBY.MAP"};
                    for (int gi = 0; gi < guesses.Length; gi = gi + 1) {
                        MapFile cf = this.db.MapNamed(guesses[gi]);
                        if (cf == null) { continue; }
                        if (cf.Theater().ToUpper() == want) {
                            this.maps[pickIdx] = guesses[gi];
                            break;
                        }
                    }
                }
            }
            this.shell.SetPickMap(pickIdx, this.maps.Count);
            MapFile picked = this.db.MapNamed(this.maps[pickIdx]);
            Console.WriteLine("selftest mapsel theatre="
                + Convert.ToString(picked == null ? "?" : picked.Theater()));
            Console.WriteLine("selftest mapsel use="
                + Convert.ToString(this.shell.PickMap()));
            this.shell.UseMap();
            Console.WriteLine("selftest mapsel back scene="
                + Convert.ToString(this.shell.CurrentScene())
                + " mapIndex=" + Convert.ToString(this.shell.MapIndex()));
        }
        // The Soviet run: the sidebar's red chrome and the Soviet
        // roster ride shell's side flag, so flipping it before
        // StartGame re-themes the whole game view. Frame 9 keeps the
        // Allied shot already dumped; the Soviet game_ui dump comes
        // at frame 15 below.
        if (this.frames == 7 && Ra2App.SelfTestSoviet()) {
            this.shell.SetSide(Side.Soviet());
        }
        if (this.frames == 9) { this.shell.StartGame(); }
        // Frame 9: mid-load, the bar part-way with the LS800 backdrop
        // up -- the loading screen's regression shot. The bar fills
        // 50% per selftest frame, so frame 11's 100% flips to Playing
        // and the game builds on that frame; the rest of the script
        // runs two frames later than it did before the load screen.
        if (this.frames == 9) {
            Ra2App.DumpScreen(this.shell.SideIndex() == 0
                              ? Ra2App.ShotPath("ra2_shot_loading.bmp")
                              : Ra2App.ShotPath("ra2_shot_loading_sov.bmp"),
                              c);
        }
        // Once the game is running, arm the second build (a power
        // plant), place it at (12,12), then fast-forward a few hundred
        // ticks so the enemy AI builds, trains and starts attacking.
        // The printed state proves the skirmish is actually running.
        // The game comes up on its mobile construction vehicle: shoot it,
        // then unfold it with the deploy key -- the original's opening move,
        // and the construction yard every later step needs. The load screen
        // decides which frame the world appears on, so these gate on flags
        // rather than frame numbers.
        if (this.selfTest && this.game != null && !Ra2App.deployTried) {
            Ra2App.deployTried = true;
            Ra2App.deployFrame = this.frames;
            Ra2App.ProbeUnlocked(this.game, "beforeDeploy");
            Ra2App.DumpScreen(this.shell.SideIndex() == 0
                              ? Ra2App.ShotPath("ra2_shot_mcv.bmp")
                              : Ra2App.ShotPath("ra2_shot_mcv_sov.bmp"), c);
            bool dep = this.game.DeploySelected();
            Console.WriteLine("selftest deploy " + (dep ? "ok" : "refused")
                + " objects=" + Convert.ToString(this.world.ObjectCount()));
            Ra2App.ProbeUnlocked(this.game, "afterDeploy");
            Ra2App.ProbeGroundRule(this.world, this.shell.SideIndex(), 1);
            Ra2App.ProbeTerrain(this.world);
            Ra2App.ProbeCameos(this.game, this.objArt, this.db);
            if (Ra2App.DumpAssetsArmed()) {
                Ra2App.DumpVehicleSprites(this.objArt);
            }
        }
        if (this.selfTest && Ra2App.deployTried
         && this.frames > Ra2App.deployFrame && this.game != null) {
            if (!Ra2App.yardShown) {
                Ra2App.yardShown = true;
                Console.WriteLine("selftest shellstate yard sideShell="
                    + Convert.ToString(this.sideShell == null ? -1
                                       : this.sideShell.Ok() ? 1 : 0)
                    + " gameMenu=" + Convert.ToString(Ra2App.gameMenu ? 1 : 0));
                Ra2App.DumpScreen(this.shell.SideIndex() == 0
                                  ? Ra2App.ShotPath("ra2_shot_yard.bmp")
                                  : Ra2App.ShotPath("ra2_shot_yard_sov.bmp"), c);
            }
            if (!Ra2App.buildArmed) {
                Ra2App.buildArmed = true;
                this.game.OnClickBuild(1);
            }
        }
        if (this.frames == 13 && this.game != null) {
            // Place the armed power plant on the first cell beside the
            // house's own construction yard that will take it. This is how a
            // player builds, and it is the only reliable target now that
            // placement honours the terrain: the old fixed (12,12) lands in
            // water on half the shipped maps, which silently dropped the
            // order and left the money untouched.
            int px = 12;
            int py = 12;
            int side0 = this.shell.SideIndex();
            for (int i = 0; i < this.world.ObjectCount(); i = i + 1) {
                WorldObject o0 = this.world.ObjectAt(i);
                if (o0.Side() != side0 || o0.Kind() != ObjKind.Structure()
                 || o0.IsDead() || o0.BuildId() != 0) { continue; }
                StructureType yt = this.world.TypeOf(o0);
                if (yt == null) { continue; }
                bool found = false;
                for (int dy = -1; dy <= yt.FootprintH() && !found; dy = dy + 1) {
                    for (int dx = -1; dx <= yt.FootprintW() && !found; dx = dx + 1) {
                        int cx = o0.X() + dx;
                        int cy = o0.Y() + dy;
                        if (this.world.CanPlaceBuilding(side0, 1, cx, cy)) {
                            px = cx;
                            py = cy;
                            found = true;
                        }
                    }
                }
                if (found) { break; }
            }
            this.game.OnClickCell(px, py);
            // Park one tank per side beside the player's base so the
            // voxel bake lands in the frame dump; the printed ids
            // prove the roster-to-catalog wiring end to end.
            int mtnk = Ra2App.UnitIdOfReg(this.world, 0, "MTNK");
            int htnk = Ra2App.UnitIdOfReg(this.world, 1, "HTNK");
            List<int> at = new List<int>();
            int bx = 10;
            int by = 10;
            if (this.map.StartCell(0, at) && at.Count >= 2) {
                bx = at[0] + 3;
                by = at[1] + 2;
            }
            int ta = -1;
            int tb = -1;
            for (int r = 0; r < 10 && ta < 0; r = r + 1) {
                ta = this.world.SpawnUnit(0, mtnk, bx + r, by);
                if (ta < 0) { ta = this.world.SpawnUnit(0, mtnk, bx, by + r); }
            }
            for (int r = 0; r < 10 && tb < 0; r = r + 1) {
                tb = this.world.SpawnUnit(1, htnk, bx + r, by + 2);
                if (tb < 0) { tb = this.world.SpawnUnit(1, htnk, bx, by + 2 + r); }
            }
            this.tankIdx = ta;
            Console.WriteLine("selftest tanks mtnk="
                + Convert.ToString(ta) + " htnk=" + Convert.ToString(tb));
            if (ta >= 0) {
                WorldObject o = this.world.ObjectAt(ta);
                Console.WriteLine("selftest mtnk at "
                    + Convert.ToString(o.X()) + ","
                    + Convert.ToString(o.Y()) + " hp="
                    + Convert.ToString(o.Hp()));
            }
            if (tb >= 0) {
                WorldObject o = this.world.ObjectAt(tb);
                Console.WriteLine("selftest htnk at "
                    + Convert.ToString(o.X()) + ","
                    + Convert.ToString(o.Y()) + " hp="
                    + Convert.ToString(o.Hp()));
            }
            // March the grizzly along the cell diagonal -- the game's
            // south, straight down the screen -- so the facing the
            // bake shows provably tracks the direction the unit
            // drives.
            if (ta >= 0 && this.game != null) {
                WorldObject o = this.world.ObjectAt(ta);
                this.world.SelectAt(o.X(), o.Y());
                this.game.OnRightClick(o.X() + 4, o.Y() + 4);
            }
            // A miner on the map's own ore field -- the seeded GEM
            // overlays. The frame-12 fast-forward then runs real
            // mining passes against it, and the printed cargo proves
            // the economy loop end to end on shipped data.
            List<int> oreAt = new List<int>();
            List<int> seed0 = new List<int>();
            int seedX = 10;
            int seedY = 10;
            if (this.map.StartCell(0, seed0) && seed0.Count >= 2) {
                seedX = seed0[0];
                seedY = seed0[1];
            }
            if (this.world.FindOre(seedX, seedY, oreAt)) {
                this.oreX = oreAt[0];
                this.oreY = oreAt[1];
                int pside = this.shell.SideIndex();
                string mreg = pside == 0 ? "CMIN"
                            : pside == 2 ? "SMIN" : "HARV";
                int mid = Ra2App.UnitIdOfReg(this.world, pside, mreg);
                for (int r2 = 0; r2 < 6 && this.minerObj == null; r2 = r2 + 1) {
                    int minerId = this.world.SpawnUnit(pside, mid,
                                                  this.oreX, this.oreY + r2);
                    if (minerId < 0) {
                        minerId = this.world.SpawnUnit(pside, mid,
                                                  this.oreX + r2, this.oreY);
                    }
                    if (minerId >= 0) {
                        this.minerObj = this.world.ObjectAt(minerId);
                    }
                }
            }
            // Bring the parked tanks on-camera: the base start sits at the
            // shot's right edge, so without a pan the dump proves nothing
            // about the live object layer. Centre the grizzly in the view.
            if (ta >= 0) {
                WorldObject o = this.world.ObjectAt(ta);
                int sx = IsoProjection.ScreenX(o.X(), o.Y())
                       - this.terrain.OriginX() - this.cam.X();
                int sy = IsoProjection.ScreenY(o.X(), o.Y(), 0)
                       - this.terrain.OriginY() - this.cam.Y();
                this.cam.MoveBy(sx - Ra2App.ViewW() / 2 + 80,
                                sy - Ra2App.ViewH() / 2);
            }
            // Projectile flight timing: a fresh grizzly fires at a victim
            // parked inside gun range. The hit must land when the shell
            // arrives, not when the trigger pulls -- the probe ticks the
            // world inside this frame so the timing is deterministic.
            int shId = Ra2App.UnitIdOfReg(this.world, 0, "MTNK");
            // Fire from a quiet mid-map cell: base guard scans must not
            // march the victim out from under the shell while it flies.
            int pa = 0 - 1;
            int qx = this.world.Width() / 2;
            int qy = this.world.Height() / 2;
            // Duel beside the player's start: the map center can be a
            // lake or a forest on theater maps, but a spawn point is
            // always buildable ground.
            List<int> da = new List<int>();
            if (this.map.StartCell(0, da) && da.Count >= 2) {
                qx = da[0] + 6;
                qy = da[1] + 4;
            }
            for (int r = 0; r < 24 && pa < 0; r = r + 1) {
                pa = this.world.SpawnUnit(0, shId, qx + r, qy);
                if (pa < 0) { pa = this.world.SpawnUnit(0, shId, qx, qy + r); }
                if (pa < 0 && r > 0) {
                    pa = this.world.SpawnUnit(0, shId, qx - r, qy);
                }
                if (pa < 0) { pa = this.world.SpawnUnit(0, shId, qx, qy - r); }
            }
            if (pa >= 0) {
                WorldObject sh = this.world.ObjectAt(pa);
                Weapon pw = sh.UnitType() != null
                          ? sh.UnitType().Primary() : null;
                int dist = 4;
                if (pw != null && pw.Range() > 1) {
                    dist = pw.Range() - 1;
                }
                if (dist > 7) { dist = 7; }
                int pv = 0 - 1;
                for (int r = 0; r < 8 && pv < 0; r = r + 1) {
                    if (this.world.Passable(sh.X() + dist, sh.Y() + r)) {
                        pv = this.world.SpawnUnit(1, htnk, sh.X() + dist,
                                                  sh.Y() + r);
                    }
                }
                if (pv >= 0 && pw != null) {
                    WorldObject vic = this.world.ObjectAt(pv);
                    int hp0 = vic.Hp();
                    this.world.AttackObject(pa, vic);
                    int k = 0;
                    while (this.world.ProjectileCount() == 0 && k < 8) {
                        this.world.Tick();
                        k = k + 1;
                    }
                    bool fired = this.world.ProjectileCount() > 0;
                    if (fired) {
                        // Hold the duel on camera: the shell is in the air
                        // between shooter and victim, and the frame-14 dump
                        // catches it mid-flight.
                        int mx = (sh.X() + vic.X()) / 2;
                        int my = (sh.Y() + vic.Y()) / 2;
                        int sx = IsoProjection.ScreenX(mx, my)
                               - this.terrain.OriginX() - this.cam.X();
                        int sy = IsoProjection.ScreenY(mx, my, 0)
                               - this.terrain.OriginY() - this.cam.Y();
                        this.cam.MoveBy(sx - Ra2App.ViewW() / 2,
                                        sy - Ra2App.ViewH() / 2);
                    }
                    int hpMid = vic.Hp();
                    while (this.world.ProjectileCount() > 0 && k < 90) {
                        this.world.Tick();
                        k = k + 1;
                    }
                    int hpEnd = vic.Hp();
                    this.duelX = sh.X() + 1;
                    this.duelY = sh.Y() + 1;
                    // The anim render path, proved with shipped art: a
                    // small blast plays right beside the duel for the
                    // frame-14 dump.
                    this.world.SpawnAnim("EXPLOSML", sh.X() + 1.5,
                                         sh.Y() + 1.5);
                    Console.WriteLine("selftest proj range="
                        + Convert.ToString(pw.Range())
                        + " dist=" + Convert.ToString(dist)
                        + " fired=" + (fired ? "1" : "0")
                        + " flight=" + Convert.ToString(k)
                        + " hp0=" + Convert.ToString(hp0)
                        + " hpMid=" + Convert.ToString(hpMid)
                        + " hpEnd=" + Convert.ToString(hpEnd)
                        + " vicAt=" + Convert.ToString(vic.X()) + ","
                        + Convert.ToString(vic.Y())
                        + " PIFFPIFF=" + Convert.ToString(
                            this.world.ProbeAnimFrames("PIFFPIFF"))
                        + " EXPLOSML=" + Convert.ToString(
                            this.world.ProbeAnimFrames("EXPLOSML"))
                        + " SGRYSMK1=" + Convert.ToString(
                            this.world.ProbeAnimFrames("SGRYSMK1")));
                    if (!fired || hpMid != hp0 || hpEnd >= hp0) {
                        Console.WriteLine("selftest FAIL proj: shell must"
                            + " fly before it bites");
                    }
                    // Damage smoke: wound the shooter below half and give
                    // the smoke cadence twenty ticks -- the grey column
                    // must be up and live before the frame-14 dump.
                    sh.TakeDamage(sh.MaxHp() * 3 / 4);
                    for (int t2 = 0; t2 < 20; t2 = t2 + 1) {
                        this.world.Tick();
                    }
                    int puffs = this.world.AnimFxCount();
                    Console.WriteLine("selftest smoke puffs="
                        + Convert.ToString(puffs));
                    if (puffs < 1) {
                        Console.WriteLine("selftest FAIL smoke: a unit"
                            + " under half health must vent SGRYSMK1");
                    }
                    // Building fires: wound a player structure below half;
                    // its DamageFireOffset spots must light up with the
                    // shipped FIRE01..03 looping anims.
                    int burnId = this.world.ProbeAnimFrames("FIRE01");
                    int burned = 0;
                    if (burnId > 0) {
                        for (int bi = 0; bi < this.world.ObjectCount()
                                      && burned < 3; bi = bi + 1) {
                            WorldObject bo = this.world.ObjectAt(bi);
                            if (bo.Kind() != ObjKind.Structure()
                             || bo.Side() != 0 || bo.MaxHp() <= 0) {
                                continue;
                            }
                            bo.TakeDamage(bo.MaxHp() * 3 / 4);
                            burned = burned + 1;
                        }
                        for (int t3 = 0; t3 < 24; t3 = t3 + 1) {
                            this.world.Tick();
                        }
                    }
                    int blazes = this.world.LoopAnimCount();
                    Console.WriteLine("selftest fires burned="
                        + Convert.ToString(burned)
                        + " fire01=" + Convert.ToString(burnId)
                        + " blazes=" + Convert.ToString(blazes));
                    if (burned > 0 && blazes < 1) {
                        Console.WriteLine("selftest FAIL fires: a"
                            + " damaged structure must burn at its"
                            + " DamageFireOffset spots");
                    }
                    // Infantry deaths: two troopers, one rifle-killed
                    // (Die1 + corpse anim) and one explosively (Die2),
                    // must both leave play-once death fx behind.
                    int giId = Ra2App.UnitIdOfReg(this.world, 0, "GGI");
                    int killed = 0;
                    int gx = 12;
                    int gy = 12;
                    if (giId >= 0) {
                        if (at.Count >= 2) {
                            gx = at[0] + 5;
                            gy = at[1] + 3;
                        }
                        for (int gi = 0; gi < 8 && killed < 2; gi = gi + 1) {
                            int g = this.world.SpawnUnit(0, giId,
                                gx + gi, gy);
                            if (g < 0
                             && (g = this.world.SpawnUnit(0, giId, gx,
                                                          gy + gi)) < 0) {
                                continue;
                            }
                            WorldObject gw = this.world.ObjectAt(g);
                            gw.TakeDamageAs(gw.Hp(), killed == 0 ? 1 : 2);
                            killed = killed + 1;
                        }
                        for (int t5 = 0; t5 < 12; t5 = t5 + 1) {
                            this.world.Tick();
                        }
                    }
                    // Sample the death cells, not the whole map: an
                    // AI rush elsewhere must not leak into this count.
                    int dc0 = killed > 0 ? gx : 0 - 1;
                    int dc1 = killed > 0 ? gy : 0 - 1;
                    int corpses = this.world.OnceFxCountAt(dc0, dc1);
                    Console.WriteLine("selftest fxdet corpses=["
                        + this.world.OnceFxDump() + "]");
                    if (killed > 0) {
                        for (int t5 = 0; t5 < 24; t5 = t5 + 1) {
                            this.world.Tick();
                        }
                    }
                    int bodies = this.world.OnceFxCountAt(dc0, dc1);
                    Console.WriteLine("selftest fxdet bodies=["
                        + this.world.OnceFxDump() + "]");
                    if (killed > 0) {
                        for (int t5 = 0; t5 < 9; t5 = t5 + 1) {
                            this.world.Tick();
                        }
                    }
                    int gone = this.world.OnceFxCountAt(dc0, dc1);
                    Console.WriteLine("selftest fxdet gone=["
                        + this.world.OnceFxDump() + "]");
                    Console.WriteLine("selftest deaths killed="
                        + Convert.ToString(killed)
                        + " corpses=" + Convert.ToString(corpses)
                        + " bodies=" + Convert.ToString(bodies)
                        + " gone=" + Convert.ToString(gone));
                    if (killed > 0 && corpses < 1) {
                        Console.WriteLine("selftest FAIL deaths: a"
                            + " killed trooper must play his death"
                            + " sequence");
                    }
                    if (killed > 0 && bodies < 1) {
                        Console.WriteLine("selftest FAIL deaths: the"
                            + " death sequence must hand over to a"
                            + " DeadBodies corpse anim");
                    }
                    if (gone != 0) {
                        Console.WriteLine("selftest FAIL deaths: the"
                            + " corpse anim must finish and clear");
                    }
                    // Suppression: a non-lethal warhead hit on a standing
                    // trooper drops him prone for 30 ticks, then he
                    // rises again.
                    int prId = Ra2App.UnitIdOfReg(this.world, 0, "GGI");
                    int proneOk = 0;
                    Warhead prWh = this.world.Rules().WarheadNamed("Super");
                    if (prId >= 0 && prWh != null && at.Count >= 2) {
                        int pg = this.world.SpawnUnit(0, prId,
                            at[0] + 20, at[1] + 6);
                        if (pg < 0) {
                            pg = this.world.SpawnUnit(0, prId,
                                at[0] + 12, at[1] + 8);
                        }
                        if (pg >= 0) {
                            WorldObject pw = this.world.ObjectAt(pg);
                            this.world.SplashAround(1, prWh,
                                pw.X(), pw.Y(), pw, pw.Hp() / 4);
                            proneOk = pw.SuppTicks() > 0 ? 1 : 0;
                            // A live battlefield may re-suppress him, so
                            // the pass is "he rose at least once": a new
                            // hit can only land after the 30 ticks ran
                            // out.
                            for (int t6 = 0; t6 < 60 && proneOk == 1;
                                 t6 = t6 + 1) {
                                this.world.Tick();
                                if (pw.SuppTicks() <= 0) { proneOk = 2; }
                            }
                        }
                    }
                    Console.WriteLine("selftest prone dropped="
                        + Convert.ToString(proneOk));
                    if (proneOk != 2) {
                        Console.WriteLine("selftest FAIL prone: a"
                            + " suppressed trooper must go down and"
                            + " rise again");
                    }
                    // Deploy transitions: a Deployer trooper sits down
                    // through the Deploy block (depPoseSeq 0 ticks out,
                    // then the deployed stance stands), and packs back up
                    // through Undeploy on the second toggle -- the
                    // reference's getStanceTransitionSequenceBy pairing.
                    int dgiId = Ra2App.UnitIdOfReg(this.world, 0, "E1");
                    int depOk = 0;
                    if (dgiId >= 0 && at.Count >= 2) {
                        // The war around the yard can swallow a lone
                        // trooper mid-transition (the deaths probe already
                        // proved stray AI kills land inside 45 ticks), so
                        // each candidate starts clear of enemies and a
                        // death during the walk just tries the next spot.
                        for (int da = 0; da < 12 && depOk == 0; da = da + 1) {
                            int dgx = at[0] + 16 + da * 4;
                            int dgy = at[1] + 8;
                            int dg = this.world.SpawnUnit(0, dgiId,
                                dgx, dgy);
                            if (dg >= 0 && this.world.NearestEnemyIn(
                                    dgx, dgy, 0, 12) >= 0) {
                                this.world.ObjectAt(dg).TakeDamage(
                                    this.world.ObjectAt(dg).Hp());
                                dg = 0 - 1;
                            }
                            if (dg < 0) { continue; }
                            WorldObject dw = this.world.ObjectAt(dg);
                            int hadTrans = dw.UnitType().HasDeploySeq()
                                && dw.UnitType().HasUndeploySeq() ? 1 : 0;
                            this.world.DeployObject(dg);
                            int inTrans = dw.DepPoseTicks() > 0
                                && dw.DepPoseSeq() == 0 ? 1 : 0;
                            int satDown = 0;
                            for (int t7 = 0; t7 < 60 && satDown == 0;
                                 t7 = t7 + 1) {
                                this.world.Tick();
                                if (dw.IsDead()) { break; }
                                if (dw.Deployed()
                                 && dw.DepPoseTicks() <= 0) { satDown = 1; }
                            }
                            if (hadTrans != 1 || inTrans != 1
                             || satDown != 1 || dw.IsDead()) {
                                Console.WriteLine("selftest deployseq try"
                                    + Convert.ToString(da)
                                    + " down="
                                    + Convert.ToString(inTrans)
                                    + " sat="
                                    + Convert.ToString(satDown)
                                    + " lost=" + (dw.IsDead() ? "1" : "0"));
                                continue;
                            }
                            this.world.DeployObject(dg);
                            int outTrans = dw.DepPoseTicks() > 0
                                && dw.DepPoseSeq() == 1 ? 1 : 0;
                            int stoodUp = 0;
                            for (int t7 = 0; t7 < 30 && stoodUp == 0;
                                 t7 = t7 + 1) {
                                this.world.Tick();
                                if (dw.IsDead()) { break; }
                                if (!dw.Deployed()
                                 && dw.DepPoseTicks() <= 0) { stoodUp = 1; }
                            }
                            depOk = outTrans == 1 && stoodUp == 1 ? 1 : 0;
                            Console.WriteLine("selftest deployseq art="
                                + Convert.ToString(hadTrans)
                                + " down=" + Convert.ToString(inTrans)
                                + " sat=" + Convert.ToString(satDown)
                                + " up=" + Convert.ToString(outTrans)
                                + " stood=" + Convert.ToString(stoodUp)
                                + " try=" + Convert.ToString(da));
                        }
                    }
                    Console.WriteLine("selftest deployseq ok="
                        + Convert.ToString(depOk));
                    if (depOk != 1) {
                        Console.WriteLine("selftest FAIL deployseq: a"
                            + " Deployer must sit through the Deploy"
                            + " block and pack through Undeploy");
                    }
                    // Smudges: the ground scars a blast leaves. The table
                    // must parse from the install's [SmudgeTypes], the art
                    // flags must read off the animation sections (TWLT070
                    // is crater+scorch, S_CLSN16 crater-only), a placed
                    // decal must land in the world list, and a crater bite
                    // must strip its bails off a tiberium pile. The live
                    // window then waits for the war itself to leave one --
                    // S_CLSN/AP fire on every rush, so eligible ground
                    // gets hit fast.
                    int smOk = 1;
                    int smRegs = this.world.Rules().SmudgeRegCount();
                    int smTwlt = this.world.Rules().AnimArtFlags("TWLT070");
                    int smClsn = this.world.Rules().AnimArtFlags("S_CLSN16");
                    int smC12 = this.world.Rules().SmudgeRegIndex("CRATER12");
                    int smB03 = this.world.Rules().SmudgeRegIndex("BURNT03");
                    Console.WriteLine("selftest smudge regs="
                        + Convert.ToString(smRegs)
                        + " twlt=" + Convert.ToString(smTwlt)
                        + " clsn=" + Convert.ToString(smClsn)
                        + " c12=" + Convert.ToString(smC12)
                        + " b03=" + Convert.ToString(smB03));
                    if (smRegs <= 0 || (smTwlt & 1) == 0 || (smTwlt & 2) == 0
                     || (smClsn & 1) == 0 || (smClsn & 2) != 0 || smC12 < 0
                     || smB03 < 0) {
                        smOk = 0;
                    }
                    if (smOk == 1 && (this.world.Rules().SmudgeCraterAt(smC12) != true
                     || this.world.Rules().SmudgeBurnAt(smC12) == true
                     || this.world.Rules().SmudgeWidthAt(smC12) != 2
                     || this.world.Rules().SmudgeHeightAt(smC12) != 2
                     || this.world.Rules().SmudgeBurnAt(smB03) != true
                     || this.world.Rules().SmudgeCraterAt(smB03) == true)) {
                        smOk = 0;
                    }
                    // A deterministic placement: find one eligible cell,
                    // fire a crater-bearing blast's decal at it, and the
                    // world list must grow by exactly one reg.
                    int smX2 = 0 - 1;
                    int smY2 = 0 - 1;
                    int w2 = this.world.Width();
                    int h2 = this.world.Height();
                    for (int sy = 8; sy < h2 - 8 && smX2 < 0; sy = sy + 1) {
                        for (int sx = 8; sx < w2 - 8; sx = sx + 1) {
                            if (this.world.SmudgeCanLand(sx, sy)) {
                                smX2 = sx;
                                smY2 = sy;
                                break;
                            }
                        }
                    }
                    int smBefore = this.world.SmudgeCount();
                    string smPlaced = "";
                    if (smOk == 1 && smX2 >= 0) {
                        this.world.SpawnSmudge("TWLT070", smX2, smY2);
                        if (this.world.SmudgeCount() == smBefore + 1) {
                            smPlaced = this.world.SmudgeNameAt(smBefore);
                        }
                    }
                    // The ore bite: seed a pile, let an S_CLSN blast strip
                    // its fixed 6, then a rolled blast take 1..6 more.
                    int smOre = 0 - 1;
                    if (smOk == 1 && smX2 >= 0) {
                        int smOv = 0 - 1;
                        for (int i = 0; i < 255; i = i + 1) {
                            if (this.world.Rules().IsTiberiumOverlay(i)) {
                                smOv = i;
                                break;
                            }
                        }
                        if (smOv >= 0) {
                            this.world.SetOre(smX2, smY2, 9, 1, smOv);
                            this.world.DestroyOre("S_CLSN16", smX2, smY2);
                            int afterFixed = this.world.OreAt(smX2, smY2);
                            this.world.DestroyOre("TWLT070", smX2, smY2);
                            int afterRoll = this.world.OreAt(smX2, smY2);
                            smOre = afterFixed == 3 && afterRoll >= 0
                                 && afterRoll <= 2 ? 1 : 0;
                        }
                    }
                    // Live wiring: the running battle must eventually mark
                    // the ground on its own.
                    int smLive = 0;
                    int smLive0 = this.world.SmudgeCount();
                    for (int t8 = 0; t8 < 1500 && smLive == 0; t8 = t8 + 1) {
                        this.world.Tick();
                        if (this.world.SmudgeCount() > smLive0) { smLive = 1; }
                    }
                    Console.WriteLine("selftest smudge place="
                        + (smPlaced.Length > 0 ? 1 : 0)
                        + " reg=" + smPlaced
                        + " ore=" + Convert.ToString(smOre)
                        + " live=" + Convert.ToString(smLive)
                        + " total=" + Convert.ToString(this.world.SmudgeCount()));
                    if (smOk != 1 || smPlaced.Length == 0 || smOre != 1
                     || smLive != 1) {
                        Console.WriteLine("selftest FAIL smudge: a blast"
                            + " must scar clear ground and bite the ore"
                            + " it lands on");
                    }
                    // Shroud: the fog of war starts covering everything the
                    // houses have not stood near, the player's own opening
                    // force has revealed its sight circles around the base,
                    // and a scout dropped into the dark opens the ground it
                    // stands on and everything it walks past.
                    MapShroud psh = this.world.ShroudOf(this.game.Side());
                    int shTotal = this.world.Width() * this.world.Height();
                    int shExplored0 = 0;
                    for (int cy = 0; cy < this.world.Height(); cy = cy + 1) {
                        for (int cx = 0; cx < this.world.Width(); cx = cx + 1) {
                            if (psh.At(cx, cy) != MapShroud.Unexplored()) {
                                shExplored0 = shExplored0 + 1;
                            }
                        }
                    }
                    // A scout into the dark: park a rifleman of the
                    // viewer's own house on an unexplored cell, let the
                    // reveal queue flush, and the cell plus its sight halo
                    // must come up lit. The house matters: reveals land on
                    // the owner's shroud, and orders are refused for units
                    // that are not the commander's.
                    int shRing = 0;
                    int shMarch = 0;
                    bool shOrdered = false;
                    int ph = this.game.Side();
                    int e1 = Ra2App.UnitIdOfReg(this.world, ph, "E1");
                    if (e1 < 0) { e1 = Ra2App.UnitIdOfReg(this.world, ph, "E2"); }
                    int dgx2 = 0 - 1;
                    int dgy2 = 0 - 1;
                    // A second dark+passable cell far from the first: the
                    // march candidate. Maps with water can refuse a fixed
                    // direction, so the probe walks to another scanned
                    // dark cell before falling back to short hops.
                    int dbx2 = 0 - 1;
                    int dby2 = 0 - 1;
                    for (int cy = 8; cy < this.world.Height() - 8
                      && (dgx2 < 0 || dbx2 < 0); cy = cy + 1) {
                        for (int cx = 8; cx < this.world.Width() - 8;
                          cx = cx + 1) {
                            if (psh.At(cx, cy) == MapShroud.Unexplored()
                             && this.world.PassableForRoute(cx, cy, false)) {
                                if (dgx2 < 0) {
                                    dgx2 = cx;
                                    dgy2 = cy;
                                }
                                else if (cx - dgx2 >= 8 || dgx2 - cx >= 8
                                      || cy - dgy2 >= 8 || dgy2 - cy >= 8) {
                                    dbx2 = cx;
                                    dby2 = cy;
                                    break;
                                }
                            }
                        }
                    }
                    if (psh != null && e1 >= 0 && dgx2 >= 0) {
                        int scout = this.world.SpawnUnit(ph, e1, dgx2, dgy2);
                        if (scout >= 0) {
                            this.world.Tick();
                            WorldObject so = this.world.ObjectAt(scout);
                            int sight = so.UnitType().Sight();
                            for (int dy = 0 - sight; dy <= sight; dy = dy + 1) {
                                for (int dx = 0 - sight; dx <= sight; dx = dx + 1) {
                                    if (psh.At(dgx2 + dx, dgy2 + dy)
                                     != MapShroud.Unexplored()) {
                                        shRing = shRing + 1;
                                    }
                                }
                            }
                            // The march: select the scout and order him
                            // toward the map centre; every cell step re-
                            // casts his sight circle, so the house's lit
                            // area grows past the spawn ring.
                            int litNow = 0;
                            for (int cy = 0; cy < this.world.Height();
                              cy = cy + 2) {
                                for (int cx = 0; cx < this.world.Width();
                                  cx = cx + 2) {
                                    if (psh.At(cx, cy)
                                     != MapShroud.Unexplored()) {
                                        litNow = litNow + 1;
                                    }
                                }
                            }
                            this.world.ClearSelection();
                            this.world.AddSelectionByObject(so);
                            if (dbx2 >= 0) {
                                shOrdered = this.world.OrderMove(dbx2, dby2);
                            }
                            if (!shOrdered) {
                                shOrdered = this.world.OrderMove(dgx2 + 5,
                                                                 dgy2);
                            }
                            if (!shOrdered) {
                                shOrdered = this.world.OrderMove(dgx2,
                                                                 dgy2 + 5);
                            }
                            if (!shOrdered) {
                                shOrdered = this.world.OrderMove(dgx2 - 5,
                                                                 dgy2);
                            }
                            if (!shOrdered) {
                                shOrdered = this.world.OrderMove(dgx2,
                                                                 dgy2 - 5);
                            }
                            for (int t9 = 0; t9 < 300 && shOrdered;
                              t9 = t9 + 1) {
                                this.world.Tick();
                                if (so.IsDead()) { break; }
                            }
                            int litAfter = 0;
                            for (int cy = 0; cy < this.world.Height();
                              cy = cy + 2) {
                                for (int cx = 0; cx < this.world.Width();
                                  cx = cx + 2) {
                                    if (psh.At(cx, cy)
                                     != MapShroud.Unexplored()) {
                                        litAfter = litAfter + 1;
                                    }
                                }
                            }
                            shMarch = litAfter > litNow ? 1 : 0;
                            Console.WriteLine("selftest shroud scout at="
                                + Convert.ToString(dgx2) + ","
                                + Convert.ToString(dgy2)
                                + " ring=" + Convert.ToString(shRing)
                                + " march=" + Convert.ToString(shMarch)
                                + " ordered=" + (shOrdered ? "1" : "0")
                                + " lost=" + (so.IsDead() ? "1" : "0"));
                            if (!so.IsDead()) {
                                so.TakeDamage(so.Hp());
                            }
                            int prevSel = this.world.SelectedIndex();
                            this.world.ClearSelection();
                            if (prevSel >= 0) {
                                WorldObject ps = this.world.ObjectAt(prevSel);
                                if (ps != null && !ps.IsDead()) {
                                    this.world.AddToSelection(ps.X(), ps.Y());
                                }
                            }
                        }
                    }
                    Console.WriteLine("selftest shroud cells="
                        + Convert.ToString(shTotal)
                        + " explored=" + Convert.ToString(shExplored0)
                        + " ring=" + Convert.ToString(shRing)
                        + " march=" + Convert.ToString(shMarch));
                    if (psh == null || shExplored0 <= 0
                     || shExplored0 >= shTotal || shRing < 1
                     || (shOrdered && shMarch != 1)) {
                        Console.WriteLine("selftest FAIL shroud: the map"
                            + " must start mostly dark, the base lit, and"
                            + " a marching scout must open the ground it"
                            + " walks (an order refused on every candidate"
                            + " skips the march leg -- pathing owns that)");
                    }
                    // Crates: the generator's pickup loop on the live map.
                    // A walker ordered onto a pinned money crate must eat
                    // it and queue a credit event for the wallet drain.
                    // An order refused on every candidate is a map shape,
                    // reported above and owned by pathing.
                    bool crOk = false;
                    bool crRan = false;
                    Rules crules = this.world.Rules();
                    int moneyPow = 0 - 1;
                    for (int pi = 0; pi < crules.PowerupCount();
                      pi = pi + 1) {
                        if (crules.PowerupTypeAt(pi)
                         == Rules.PowerupMoney()) {
                            moneyPow = pi;
                        }
                    }
                    int crx = 0 - 1;
                    int cry = 0 - 1;
                    int crx2 = 0 - 1;
                    int cry2 = 0 - 1;
                    int crx3 = 0 - 1;
                    int cry3 = 0 - 1;
                    for (int cy = 8; cy < this.world.Height() - 8
                      && crx3 < 0; cy = cy + 1) {
                        for (int cx = 8; cx < this.world.Width() - 8;
                          cx = cx + 1) {
                            if (this.world.CrateCanPlace(cx, cy)) {
                                if (crx < 0) { crx = cx; cry = cy; }
                                else if (crx2 < 0) { crx2 = cx; cry2 = cy; }
                                else { crx3 = cx; cry3 = cy; break; }
                            }
                        }
                    }
                    if (moneyPow >= 0 && crx >= 0 && e1 >= 0) {
                        for (int cand = 0; cand < 3 && !crOk;
                          cand = cand + 1) {
                            int ccx = cand == 0 ? crx
                                : cand == 1 ? crx2 : crx3;
                            int ccy = cand == 0 ? cry
                                : cand == 1 ? cry2 : cry3;
                            if (ccx < 0) { continue; }
                            int wxx = ccx + 2;
                            if (!this.world.CrateCanPlace(wxx, ccy)) {
                                continue;
                            }
                            int walker = this.world.SpawnUnit(ph, e1, wxx,
                                ccy);
                            if (walker < 0) { continue; }
                            if (!this.world.SpawnCratePinned(ccx, ccy,
                                moneyPow, 9000)) {
                                WorldObject dw = this.world
                                    .ObjectAt(walker);
                                if (dw != null && !dw.IsDead()) {
                                    dw.TakeDamage(dw.Hp());
                                }
                                this.world.Tick();
                                continue;
                            }
                            crRan = true;
                            WorldObject wo = this.world.ObjectAt(walker);
                            this.world.ClearSelection();
                            this.world.AddSelectionByObject(wo);
                            bool ordered = this.world.OrderMove(ccx, ccy);
                            int evBefore = this.world.EventCount();
                            int ranTo = 0 - 1;
                            for (int t10 = 0; t10 < 200 && ordered;
                              t10 = t10 + 1) {
                                this.world.Tick();
                                ranTo = t10;
                                if (wo.IsDead()) { break; }
                                // 只有正数的入账才算箱子发钱:维修账单也
                                // 走 kind-1(负数),而且早先探针的旧事件还
                                // 躺在队列里,所以从 evBefore 起扫、只认
                                // amount>0。
                                bool gotEvt = false;
                                for (int ei = evBefore; ei < this.world
                                  .EventCount(); ei = ei + 1) {
                                    if (this.world.EventKindAt(ei) == 1
                                     && this.world.EventAmountAt(ei) > 0) {
                                        gotEvt = true;
                                        break;
                                    }
                                }
                                if (gotEvt) { break; }
                            }
                            int moneyEvts = 0;
                            for (int ei = evBefore; ei < this.world
                              .EventCount(); ei = ei + 1) {
                                if (this.world.EventKindAt(ei) == 1
                                 && this.world.EventAmountAt(ei) > 0) {
                                    moneyEvts = moneyEvts + 1;
                                }
                            }
                            crOk = moneyEvts > 0;
                            Console.WriteLine("selftest crates cell="
                                + Convert.ToString(ccx) + ","
                                + Convert.ToString(ccy)
                                + " ordered=" + (ordered ? "1" : "0")
                                + " moneyEvents="
                                + Convert.ToString(moneyEvts)
                                + " left="
                                + Convert.ToString(this.world.CrateCount())
                                + " dead=" + (wo.IsDead() ? "1" : "0")
                                + " hp=" + (wo.IsDead() ? 0 - 1 : wo.Hp())
                                + " ranTo=" + Convert.ToString(ranTo)
                                + " frozen="
                                + (wo.Frozen() > 0 ? "1" : "0")
                                + " route=" + (wo.HasRoute() ? "1" : "0")
                                + " sx=" + Convert.ToString(wo.X())
                                + " sy=" + Convert.ToString(wo.Y()));
                            if (!wo.IsDead()) { wo.TakeDamage(wo.Hp()); }
                            this.world.Tick();
                        }
                        this.world.ClearSelection();
                    }
                    if (crRan && !crOk) {
                        Console.WriteLine("selftest FAIL crates: a walked"
                            + " money crate must be consumed and queue a"
                            + " credit event (an order refused is a map"
                            + " shape, reported above)");
                    }
                    // Building idle anims: every finished structure whose
                    // art ships IdleAnim must have its loop live (the
                    // damaged variant where one ships and we wounded the
                    // building above).
                    int idlEl = this.world.IdleEligibleCount();
                    int idlLive = this.world.IdleLoopCount();
                    Console.WriteLine("selftest idles eligible="
                        + Convert.ToString(idlEl)
                        + " live=" + Convert.ToString(idlLive));
                    if (idlLive != idlEl) {
                        Console.WriteLine("selftest FAIL idles: every"
                            + " IdleAnim structure must show its loop");
                    }
                    // Walls: stand a three-piece run, read the connection
                    // masks (N + 2E + 4S + 8W), break the middle piece and
                    // watch the ends reconnect to lone walls -- the
                    // reference's wallTypes + WallTrait pairing.
                    Rules wrules = this.world.Rules();
                    int wallIdx = 0 - 1;
                    for (int wi = 0; wi < wrules.OverlayTypeCount(); wi = wi + 1) {
                        if (wrules.IsWallOverlay(wi)) { wallIdx = wi; break; }
                    }
                    if (wallIdx >= 0) {
                        int wx = at[0] + 24;
                        int wy = at[1] + 6;
                        int wtries = 0;
                        while (wtries < 16
                         && (this.world.OccupantAt(wx, wy) >= 0
                          || this.world.OccupantAt(wx + 1, wy) >= 0
                          || this.world.OccupantAt(wx + 2, wy) >= 0)) {
                            wx = wx + 1;
                            wtries = wtries + 1;
                        }
                        this.world.SetWall(wx, wy, wallIdx);
                        this.world.SetWall(wx + 1, wy, wallIdx);
                        this.world.SetWall(wx + 2, wy, wallIdx);
                        // A horizontal run: the west end grows a face
                        // east (2), the middle both ways (E+W = 10), the
                        // east end west (8).
                        int wallOk = this.world.WallDataAt(wx, wy) == 2
                                  && this.world.WallDataAt(wx + 1, wy) == 10
                                  && this.world.WallDataAt(wx + 2, wy) == 8
                                  ? 1 : 0;
                        Console.WriteLine("selftest walls seeded="
                            + Convert.ToString(this.world.WallCellCount())
                            + " run=" + Convert.ToString(wallOk)
                            + " art=" + wrules.OverlayName(wallIdx)
                            + " frames=" + Convert.ToString(
                                this.theater.OverlayFrameCount(
                                    wrules.OverlayName(wallIdx))));
                        // The middle piece takes a lethal hit; the ends
                        // each soak half (WallTrait's linked damage) and
                        // the run reconnects around the gap.
                        int wstr = wrules.OverlayStrength(wallIdx);
                        if (wstr <= 0) { wstr = 10; }
                        this.world.DamageWallAt(wx + 1, wy, wstr);
                        wallOk = wallOk == 1
                              && this.world.WallOvAt(wx + 1, wy) < 0
                              && this.world.WallDataAt(wx, wy) == 0
                              && this.world.WallDataAt(wx + 2, wy) == 0
                              ? 2 : wallOk;
                        Console.WriteLine("selftest walls after break="
                            + Convert.ToString(this.world.WallCellCount())
                            + " run=" + Convert.ToString(wallOk));
                        if (wallOk != 2) {
                            Console.WriteLine("selftest FAIL walls: a"
                                + " broken piece must drop out and its"
                                + " neighbours reconnect their faces");
                        }
                    } else {
                        Console.WriteLine("selftest walls: no wall"
                            + " overlay in the rules, skipped");
                    }
                    // Tiberium growth: register a tree with a one-tick
                    // cooldown, roll it, and demand a new pile with the
                    // reference's deterministic overlay id (OreSpread's
                    // cell hash into TIB01..12) on bare ground nearby.
                    int gx = 0 - 1;
                    int gy = 0 - 1;
                    int w = this.terrain.WorldWidth();
                    int h = this.terrain.WorldHeight();
                    for (int sy = 1; sy < h - 1 && gx < 0; sy = sy + 1) {
                        for (int sx2 = 1; sx2 < w - 1; sx2 = sx2 + 1) {
                            if (this.world.TibCanPlace(sx2, sy)) {
                                gx = sx2;
                                gy = sy;
                                break;
                            }
                        }
                    }
                    int growOk = 0;
                    if (gx >= 0) {
                        this.world.AddTibTree(gx, gy, 1);
                        this.world.TickTiberiumGrowth();
                        for (int dy = -2; dy <= 2 && growOk == 0; dy = dy + 1) {
                            for (int dx = -2; dx <= 2; dx = dx + 1) {
                                int px = gx + dx;
                                int py = gy + dy;
                                if (this.world.OreAt(px, py) <= 0) {
                                    continue;
                                }
                                int ovid = this.world.OreOvAt(px, py);
                                int want = 102 + World.OreSpreadIndex(px, py);
                                if (ovid == want
                                 && this.world.OreValueAt(px, py) == 1) {
                                    growOk = 1;
                                }
                                break;
                            }
                        }
                    }
                    Console.WriteLine("selftest tibgrow tree="
                        + Convert.ToString(gx) + "," + Convert.ToString(gy)
                        + " ok=" + Convert.ToString(growOk));
                    if (growOk != 1) {
                        Console.WriteLine("selftest FAIL tibgrow: a"
                            + " rolled tree must raise a Riparius pile"
                            + " with the OreSpread variant id");
                    }
                    // Low bridges: a three-piece run chains into the head
                    // ids the reference's updateOverlayData writes (94/74/
                    // 92), a middle kill dominoes nothing (both ends
                    // intact) and the dangling ends rewrite to 95/93, the
                    // span reads Road over anything, and the last head's
                    // fall clears the run.
                    int bx2 = at[0] + 24;
                    int by2 = at[1] + 10;
                    int btries = 0;
                    while (btries < 16
                     && (this.world.OccupantAt(bx2, by2) >= 0
                      || this.world.OccupantAt(bx2, by2 + 1) >= 0
                      || this.world.OccupantAt(bx2, by2 + 2) >= 0)) {
                        bx2 = bx2 + 1;
                        btries = btries + 1;
                    }
                    this.world.SetBridgePiece(bx2, by2, true, 1);
                    this.world.SetBridgePiece(bx2, by2 + 1, true, 0);
                    this.world.SetBridgePiece(bx2, by2 + 2, true, 2);
                    this.world.ReconnectBridgeAll();
                    int id0 = this.world.BridgeIdAt(0);
                    int id1 = this.world.BridgeIdAt(1);
                    int id2 = this.world.BridgeIdAt(2);
                    // The span's land class reads Road while the pieces
                    // stand -- that is what lets a ground unit cross
                    // water on the bridge (checked before the kills).
                    int road = this.world.CellLandClassAt(bx2, by2)
                               == LandType.Road() ? 1 : 0;
                    int bstr = this.world.Rules().BridgeStrength();
                    this.world.DamageBridgeAt(bx2, by2 + 1, bstr);
                    int mid2 = this.world.BridgePieceCount() == 2
                            && this.world.BridgeIdAt(0) == 95
                            && this.world.BridgeIdAt(1) == 93 ? 1 : 0;
                    this.world.DamageBridgeAt(bx2, by2, bstr);
                    int mid3 = this.world.BridgePieceCount() == 1 ? 1 : 0;
                    this.world.DamageBridgeAt(bx2, by2 + 2, bstr);
                    int bridgeOk = id0 == 94 && id1 == 74 && id2 == 92
                                && mid2 == 1 && mid3 == 1
                                && this.world.BridgePieceCount() == 0
                                && road == 1 ? 1 : 0;
                    Console.WriteLine("selftest bridges ids="
                        + Convert.ToString(id0) + "/"
                        + Convert.ToString(id1) + "/"
                        + Convert.ToString(id2)
                        + " domino=" + Convert.ToString(mid2)
                        + " tail=" + Convert.ToString(mid3)
                        + " road=" + Convert.ToString(road)
                        + " run=" + Convert.ToString(bridgeOk));
                    if (bridgeOk != 1) {
                        Console.WriteLine("selftest FAIL bridges: the"
                            + " chain ids, the domino rule and the road"
                            + " land must match the reference's Bridges");
                    }
                } else {
                    Console.WriteLine("selftest FAIL proj: spawn refused");
                }
            }
        }
        if (this.frames == 14) {
            // The duel from frame 13: shell mid-flight between shooter and
            // victim, its explosion anim right behind it.
            Ra2App.DumpScreen(Ra2App.ShotPath("ra2_shot_proj.bmp"), c);
            // Back to the parked grizzly for the established tank shot.
            if (this.tankIdx >= 0 && this.world != null) {
                WorldObject o = this.world.ObjectAt(this.tankIdx);
                if (o != null) {
                    int sx = IsoProjection.ScreenX(o.X(), o.Y())
                           - this.terrain.OriginX() - this.cam.X();
                    int sy = IsoProjection.ScreenY(o.X(), o.Y(), 0)
                           - this.terrain.OriginY() - this.cam.Y();
                    this.cam.MoveBy(sx - Ra2App.ViewW() / 2 + 80,
                                    sy - Ra2App.ViewH() / 2);
                }
            }
            // Dump before the fast-forward so the parked tanks are
            // captured without combat effects over them.
            Console.WriteLine("selftest shellstate frame=14 sideShell="
                + Convert.ToString(this.sideShell == null ? -1
                                   : this.sideShell.Ok() ? 1 : 0)
                + " gameMenu=" + Convert.ToString(Ra2App.gameMenu ? 1 : 0));
            int pside = this.shell.SideIndex();
            Ra2App.DumpScreen(pside == 0
                              ? Ra2App.ShotPath("ra2_shot_tanks.bmp")
                              : Ra2App.ShotPath("ra2_shot_tanks_sov.bmp"),
                              c);
            // Then put a producing structure on screen and select it,
            // so the next frame's dump shows the training panel: the
            // unit icons, prices and the queue progress bar it draws.
            // The starter base carries none, so drop a war factory
            // beside the start -- its panel exercises the voxel icon
            // bakes, which the barracks' infantry icons do not.
            if (this.game != null) {
                int pileId = -1;
                StructureCatalog cat = this.game.World().Catalog();
                for (int ci = 0; ci < cat.CountFor(this.world, pside); ci = ci + 1) {
                    StructureType ct = cat.TypeFor(this.world, pside, ci);
                    string reg = pside == 0 ? "GAWEAP" : "NAWEAP";
                    if (ct != null && ct.Reg() == reg) {
                        pileId = ci;
                    }
                }
                int newId = -1;
                if (pileId >= 0) {
                    List<int> sc0 = new List<int>();
                    if (this.map.StartCell(pside, sc0) && sc0.Count >= 2) {
                        for (int r = 0; r < 8 && newId < 0; r = r + 1) {
                            newId = this.world.PlaceStructure(pside, pileId,
                                sc0[0] + 2 + r, sc0[1] - 4);
                            if (newId < 0) {
                                newId = this.world.PlaceStructure(pside, pileId,
                                    sc0[0] - 3, sc0[1] + r);
                            }
                        }
                    }
                }
                WorldObject prod = newId >= 0
                    ? this.world.ObjectAt(newId) : null;
                if (prod == null) {
                    for (int oi = 0; oi < this.world.ObjectCount()
                            && prod == null; oi = oi + 1) {
                        WorldObject o = this.world.ObjectAt(oi);
                        if (o == null || o.Side() != pside
                         || o.Kind() != ObjKind.Structure()) { continue; }
                        StructureType st = cat.TypeFor(this.world, pside,
                            o.BuildId());
                        if (st != null && st.Produces() != null
                         && st.Produces().Count > 0) {
                            prod = o;
                        }
                    }
                }
                if (prod != null) {
                    this.world.AddSelectionByObject(prod);
                }
            }
            int stepped = 0;
            while (stepped < 200 && this.game != null && this.game.Result() == 0) {
                this.game.Tick();
                stepped = stepped + 1;
            }
            // Aim the closing dump at ore that is still in the
            // ground: the miner may have emptied the first field, so
            // re-scan from where it stands.
            if (this.cam != null) {
                List<int> live = new List<int>();
                int fx0 = this.minerObj != null ? this.minerObj.X() : this.oreX;
                int fy0 = this.minerObj != null ? this.minerObj.Y() : this.oreY;
                if (this.oreX >= 0 && this.world.FindOre(fx0, fy0, live)) {
                    int pox = IsoProjection.ScreenX(live[0], live[1])
                              - this.terrain.OriginX();
                    int poy = IsoProjection.ScreenY(live[0], live[1], 0)
                              - this.terrain.OriginY();
                    this.cam.MoveTo(pox - this.cam.SpanW() / 2,
                               poy - this.cam.SpanH() / 2);
                    this.dirty = true;
                }
            }
        }
        if (this.frames == 15) {
            // Frame 15 drew the post-fast-forward world (with the
            // selected structure's training panel); capture it, then
            // report and leave.
            Ra2App.DumpScreen(this.shell.SideIndex() == 0
                              ? Ra2App.ShotPath("ra2_shot_game_ui.bmp")
                              : Ra2App.ShotPath("ra2_shot_game_ui_sov.bmp"),
                              c);
            int objCount = this.world == null ? -1 : this.world.ObjectCount();
            int money = this.game == null ? -1 : this.game.Money();
            int aiMoney = this.game == null ? -1 : this.game.AiMoney();
            int sel = this.game == null ? -1 : this.game.World().SelectedIndex();
            int result = this.game == null ? -1 : this.game.Result();
            int oreHere = this.oreX >= 0 ? this.world.OreAt(this.oreX, this.oreY) : -1;
            int cargo = this.minerObj != null && !this.minerObj.IsDead()
                ? this.minerObj.Cargo() : -1;
            int storage = this.minerObj != null && !this.minerObj.IsDead()
                && this.minerObj.UnitType() != null
                ? this.minerObj.UnitType().Storage() : 0 - 1;
            Console.WriteLine("selftest ore at "
                + Convert.ToString(this.oreX) + "," + Convert.ToString(this.oreY)
                + " amt=" + Convert.ToString(oreHere)
                + " cargo=" + Convert.ToString(cargo)
                + " storage=" + Convert.ToString(storage)
                + " bails=" + Convert.ToString(
                    this.minerObj != null ? this.minerObj.Bails() : 0 - 1));
            Console.WriteLine("selftest scene=" + Convert.ToString(this.shell.CurrentScene())
                + " this.drawn=" + Convert.ToString(this.drawn)
                + " previewBuilt=" + Convert.ToString(this.previewIndex >= 0)
                + " this.map=" + this.maps[this.shell.MapIndex()]
                + " obj=" + Convert.ToString(objCount)
                + " money=" + Convert.ToString(money)
                + " aiMoney=" + Convert.ToString(aiMoney)
                + " sel=" + Convert.ToString(sel)
                + " result=" + Convert.ToString(result));
            // The sidebar's newer interactions, proved on live state:
            // queue two of a unit on the selected producer, cancel
            // one with the right click (the refund must land), and
            // count the structures card's two tab pages.
            if (this.game != null && this.world != null) {
                WorldObject prod = this.world.Selected();
                if (prod != null && prod.Kind() == ObjKind.Structure()
                 && prod.ProdCount() == 0) {
                    StructureType st = this.world.Catalog().TypeFor(this.world,
                        prod.Side(), prod.BuildId());
                    List<int> lines = st != null ? st.Produces() : null;
                    if (lines != null && lines.Count > 0) {
                        int uid = 0 - 1;
                        int m0 = this.game.Money();
                        for (int pi = 0; pi < lines.Count && uid < 0;
                             pi = pi + 1) {
                            this.game.OnClickUnit(lines[pi]);
                            if (prod.ProdCount() > 0) { uid = lines[pi]; }
                        }
                        if (uid >= 0) {
                            this.game.OnClickUnit(uid);
                            int queued = prod.ProdCount();
                            this.game.OnRightClickUnit(uid);
                            Console.WriteLine("selftest queue uid="
                                + Convert.ToString(uid)
                                + " queued=" + Convert.ToString(queued)
                                + " afterCancel="
                                + Convert.ToString(prod.ProdCount())
                                + " netPaid="
                                + Convert.ToString(this.game.Money() - m0));
                        } else {
                            Console.WriteLine("selftest queue none-unlocked");
                        }
                    }
                }
                Console.WriteLine("selftest tabs buildings="
                    + Convert.ToString(Ra2App.BuildItemCount(this.game, 0))
                    + " defence="
                    + Convert.ToString(Ra2App.BuildItemCount(this.game, 1)));
            }
            // Leave the game menu open across the flip: the next
            // frame draws it over the sidebar for the capture.
            Ra2App.gameMenu = true;
            Ra2App.gameMenuScreen = 0;
            this.dirty = true;
        }
        if (this.frames == 16) {
            // Frame 16 drew the game menu (the Esc screen) over the
            // sidebar; capture it, then close the walk out. The
            // Soviet leg re-enters here a second time, so this is
            // also where the flipped-side check actually stops it.
            Ra2App.DumpScreen(this.shell.SideIndex() == 0
                              ? Ra2App.ShotPath("ra2_shot_gamemenu.bmp")
                              : Ra2App.ShotPath("ra2_shot_gamemenu_sov.bmp"),
                              c);
            Console.WriteLine("selftest gamemenu open="
                + Convert.ToString(Ra2App.gameMenu ? 1 : 0)
                + " this.screen=" + Convert.ToString(Ra2App.gameMenuScreen)
                + " buttons="
                + Convert.ToString(Ra2App.MenuButtonCount()));
            int sfc = this.sideShell != null
                ? this.sideShell.FrameCount("SIDEBTTN.SHP") : 0;
            Console.WriteLine("selftest sidebttn this.frames="
                + Convert.ToString(sfc) + " "
                + Convert.ToString(this.sideShell.W("SIDEBTTN.SHP")) + "x"
                + Convert.ToString(this.sideShell.H("SIDEBTTN.SHP")));
            // The menu column plate is SDBTNANM, not MNBTTN: report the sheet
            // the shell loaded so a regression back to the dialog button is
            // caught here rather than by eye.
            if (this.art != null) {
                Console.WriteLine("selftest menucol hasSlotFrames="
                    + Convert.ToString(this.art.HasSlotFrames() ? 1 : 0)
                    + " hasMpBtn="
                    + Convert.ToString(this.art.HasMpBtn() ? 1 : 0)
                    + " hasWarnLoop="
                    + Convert.ToString(this.art.HasWarnLoop() ? 1 : 0)
                    + " warnLoop="
                    + Convert.ToString(this.art.WarnLoopCount())
                    + " hasPanelSlide="
                    + Convert.ToString(this.art.HasPanelSlide() ? 1 : 0));
                for (int f = 0; f < 17; f = f + 1) {
                    R2Tex slotTex = this.art.SlotFrame(f);
                    if (slotTex == null) { continue; }
                    Console.WriteLine("selftest slotframe f"
                        + Convert.ToString(f) + "="
                        + Convert.ToString(slotTex.W()) + "x"
                        + Convert.ToString(slotTex.H()));
                }
            }
            for (int f = 0; f < sfc && f < 12; f = f + 1) {
                this.sideShell.DumpPiece(this.sideShell.Piece("SIDEBTTN.SHP", f),
                                    "build/sidebttn_f"
                                    + Convert.ToString(f) + ".ppm");
            }
            // Step to the 放弃任务 confirm: the next frame draws its
            // own button set for the second capture.
            Ra2App.gameMenuScreen = 1;
            this.dirty = true;
        }
        // stressLeft <= 0: while the perf corridor holds the counter at 17
        // (frames-- undoes the increment below), this gate must stay shut,
        // or it re-fires every corridor frame -- the "measurement" would be
        // one frame long and the Soviet flip would race the still-armed
        // corridor, deadlocking the walk before StartGame.
        if (this.frames == 17 && Ra2App.stressLeft <= 0) {
            Ra2App.DumpScreen(this.shell.SideIndex() == 0
                              ? Ra2App.ShotPath("ra2_shot_quit.bmp")
                              : Ra2App.ShotPath("ra2_shot_quit_sov.bmp"),
                              c);
            Console.WriteLine("selftest quitconfirm buttons="
                + Convert.ToString(Ra2App.MenuButtonCount()));
            Ra2App.gameMenu = false;
            Ra2App.gameMenuScreen = 0;
            // Stress block: ring-sweep spawn around the player's yard
            // to load the renderer with up to 150 units, then let the
            // perf corridor below time 40 frames of tick+draw.
            int pside2 = this.shell.SideIndex();
            // The spawn only happens where it means something: the first
            // Allied landing (measured by the corridor below) and the
            // Soviet landing. The post-corridor landing skips it so the
            // measured frame is not perturbed by a second ring of units.
            if (Ra2App.SelfTestSoviet() || pside2 != Side.Allied()
             || Ra2App.stressDone < 1) {
            int yardAt = 0 - 1;
            for (int oi = 0; oi < this.world.ObjectCount(); oi = oi + 1) {
                WorldObject oo = this.world.ObjectAt(oi);
                if (oo != null && oo.Side() == pside2
                 && oo.Kind() == ObjKind.Structure()) {
                    yardAt = oi;
                }
            }
            int spawned = 0;
            if (yardAt >= 0) {
                WorldObject yard = this.world.ObjectAt(yardAt);
                int cx = yard.X();
                int cy = yard.Y();
                int sid = Ra2App.UnitIdOfReg(this.world, pside2,
                    pside2 == 0 ? "MTNK" : "HTNK");
                for (int ring = 2; ring <= 40 && spawned < 150;
                     ring = ring + 1) {
                    for (int dx = 0 - ring; dx <= ring; dx = dx + 1) {
                        for (int dy = 0 - ring; dy <= ring;
                             dy = dy + 1) {
                            if (dx != ring && dx != 0 - ring
                             && dy != ring && dy != 0 - ring) {
                                continue;
                            }
                            if (spawned >= 150) { break; }
                            if (this.world.Passable(cx + dx, cy + dy)) {
                                if (this.world.SpawnUnit(pside2, sid,
                                        cx + dx, cy + dy) >= 0) {
                                    spawned = spawned + 1;
                                }
                            }
                        }
                    }
                }
            }
            // Then start the fight: every fresh tank charges the nearest
            // hostile, so the profiled corridor is a battle, not a parade
            // ground -- shots, splash damage, walk frames and the retarget
            // scans all under the clock the player would feel.
            for (int oi = 0; oi < this.world.ObjectCount(); oi = oi + 1) {
                WorldObject oo = this.world.ObjectAt(oi);
                if (oo == null || oo.Side() != pside2
                 || oo.Kind() != ObjKind.Unit()) { continue; }
                if (oo.UnitType() == null
                 || oo.UnitType().Primary() == null) { continue; }
                int foe = this.world.NearestEnemy(pside2, oo.X(), oo.Y());
                if (foe >= 0) {
                    this.world.AttackObject(oi, this.world.ObjectAt(foe));
                }
            }
            Console.WriteLine("selftest stress spawned="
                + Convert.ToString(spawned));
            }
            if (Ra2App.SelfTestSoviet()
             || this.shell.SideIndex() != Side.Allied()) {
                // The Soviet leg's landing (or a standalone Soviet run):
                // report its perf line and stop.
                if (Ra2App.profN > 0) {
                    Console.WriteLine("selftest perf this.frames="
                        + Convert.ToString(Ra2App.profN)
                        + " worldAvgMs=" + Convert.ToString(
                            Ra2App.profTick / Ra2App.profN)
                        + " drawAvgMs=" + Convert.ToString(
                            Ra2App.profDraw / Ra2App.profN)
                        + " drawMaxMs=" + Convert.ToString(
                            Ra2App.profDrawMax)
                        + " terrAvgMs=" + Convert.ToString(
                            Ra2App.profTer / Ra2App.profN)
                        + " terrMaxMs=" + Convert.ToString(
                            Ra2App.profTerMax)
                        + " upAvgMs=" + Convert.ToString(
                            Ra2App.profUp / Ra2App.profN)
                        + " pathCalls=" + Convert.ToString(
                            this.world.PathCalls()));
                    if (Ra2App.profDraw / Ra2App.profN > 16
                     || Ra2App.profTick / Ra2App.profN > 150) {
                        Console.WriteLine("selftest FAIL perf: drawAvg="
                            + Convert.ToString(Ra2App.profDraw / Ra2App.profN)
                            + "ms (budget 16) worldAvg="
                            + Convert.ToString(Ra2App.profTick / Ra2App.profN)
                            + "ms (budget 150)");
                    }
                }
                host.RequestStop();
            } else if (Ra2App.stressDone < 1) {
                // First Allied landing: arm the corridor -- 40 in-game
                // frames of tick+draw over the 150 spawned units. The
                // jump-back re-enters this gate with stressDone==1, which
                // reports and flips to the Soviet leg. Arming must not
                // race the Soviet rewind, so the flip happens on the
                // post-corridor landing instead of here.
                Ra2App.profOn = 1;
                Ra2App.profN = 0;
                Ra2App.profTick = 0;
                Ra2App.profDraw = 0;
                Ra2App.profDrawMax = 0;
                Ra2App.profTer = 0;
                Ra2App.profTerMax = 0;
                Ra2App.profUp = 0;
                Ra2App.stressLeft = 40;
                this.dirty = true;
            } else {
                // Corridor done: report, then rewind into the Soviet leg
                // (frames 4 walks the shell again; StartGame rebuilds the
                // world, so the nulls here are safe -- no landing can
                // fire before frame 17 is reached in-game again).
                if (Ra2App.profN > 0) {
                    Console.WriteLine("selftest perf this.frames="
                        + Convert.ToString(Ra2App.profN)
                        + " worldAvgMs=" + Convert.ToString(
                            Ra2App.profTick / Ra2App.profN)
                        + " drawAvgMs=" + Convert.ToString(
                            Ra2App.profDraw / Ra2App.profN)
                        + " drawMaxMs=" + Convert.ToString(
                            Ra2App.profDrawMax)
                        + " terrAvgMs=" + Convert.ToString(
                            Ra2App.profTer / Ra2App.profN)
                        + " terrMaxMs=" + Convert.ToString(
                            Ra2App.profTerMax)
                        + " upAvgMs=" + Convert.ToString(
                            Ra2App.profUp / Ra2App.profN)
                        + " pathCalls=" + Convert.ToString(
                            this.world.PathCalls()));
                    if (Ra2App.profDraw / Ra2App.profN > 16
                     || Ra2App.profTick / Ra2App.profN > 150) {
                        Console.WriteLine("selftest FAIL perf: drawAvg="
                            + Convert.ToString(Ra2App.profDraw / Ra2App.profN)
                            + "ms (budget 16) worldAvg="
                            + Convert.ToString(Ra2App.profTick / Ra2App.profN)
                            + "ms (budget 150)");
                    }
                }
                this.shell.SetSide(Side.Soviet());
                this.shell.Back();
                this.loadedIndex = -1;
                this.preview = null;
                this.game = null;
                this.cam = null;
                this.world = null;
                this.minerObj = null;
                this.oreX = -1;
                this.oreY = -1;
                // The opener's flags are static, so the Soviet leg has to
                // clear them or it would walk the whole second run with no
                // MCV shot and no deploy.
                Ra2App.deployTried = false;
                Ra2App.deployFrame = 0;
                Ra2App.yardShown = false;
                Ra2App.buildArmed = false;
                this.frames = 4;
            }
            Ra2App.stressDone = Ra2App.stressDone + 1;
        }
        // The perf corridor: after the stress spawn, hold the loop
        // in place for stressLeft frames of normal tick+draw (the
        // counters above accumulate), then jump back to the frames==17
        // gate, which prints the perf line and flips to the Soviet
        // leg (or quits the standalone Soviet run). The counter
        // increments before this script runs, so park on 16: the
        // next frame sees 17 and the gate fires.
        if (Ra2App.stressLeft > 0) {
            Ra2App.stressLeft = Ra2App.stressLeft - 1;
            if (Ra2App.stressLeft == 21) {
                // Pan a frame before the dump: the canvas this frame's
                // dump captures was composed before this update ran. Aim
                // the camera where the war actually is -- the recent
                // impact sites when guns are firing, the whole army's
                // centroid while it still marches.
                int pside = this.shell.SideIndex();
                int cx2 = 0;
                int cy2 = 0;
                int fn = this.world.ProjectileCount();
                for (int pi = 0; pi < fn; pi = pi + 1) {
                    Projectile pr = this.world.ProjectileAt(pi);
                    cx2 = cx2 + (int)pr.Px();
                    cy2 = cy2 + (int)pr.Py();
                }
                if (fn == 0) {
                    fn = this.world.AnimFxCount();
                }
                for (int ai = 0; ai < this.world.AnimFxCount();
                     ai = ai + 1) {
                    FxAnim a = this.world.AnimFxAt(ai);
                    cx2 = cx2 + (int)a.Px();
                    cy2 = cy2 + (int)a.Py();
                }
                if (fn == 0) {
                    for (int oi = 0; oi < this.world.ObjectCount();
                         oi = oi + 1) {
                        WorldObject oo = this.world.ObjectAt(oi);
                        if (oo == null || oo.Kind() != ObjKind.Unit()
                         || oo.IsDead()) {
                            continue;
                        }
                        cx2 = cx2 + oo.X();
                        cy2 = cy2 + oo.Y();
                        fn = fn + 1;
                    }
                }
                if (fn > 0 && this.game != null) {
                    int sx = IsoProjection.ScreenX(cx2 / fn, cy2 / fn)
                           - this.terrain.OriginX() - this.cam.X();
                    int sy = IsoProjection.ScreenY(cx2 / fn, cy2 / fn, 0)
                           - this.terrain.OriginY() - this.cam.Y();
                    this.cam.MoveBy(sx - Ra2App.ViewW() / 2,
                                    sy - Ra2App.ViewH() / 2);
                }
            }
            if (Ra2App.stressLeft == 35 && this.world != null) {
                // Pose the anim layer's screenshot proof: a shipped blast
                // at the duel site, set to its peak frame this update so
                // the next frame's render shows it in full flower.
                string boom = "EXPLOLRG";
                if (this.world.ProbeAnimFrames(boom) <= 0) {
                    boom = "EXPLOMED";
                }
                if (this.world.ProbeAnimFrames(boom) > 0
                 && this.world.SpawnAnim(boom, this.duelX, this.duelY)) {
                    this.world.AnimTick(this.world.AnimFxCount() - 1, 14);
                }
                // Pose the tesla layer too: a shipped CoilBolt arc from
                // the parked grizzly to a victim parked beside it, live
                // for the next frame's boom dump.
                Weapon tz = this.world.Rules().WeaponNamed("CoilBolt");
                int vuid = Ra2App.UnitIdOfReg(this.world, 1, "HTNK");
                if (tz != null && this.tankIdx >= 0 && vuid >= 0) {
                    WorldObject a = this.world.ObjectAt(this.tankIdx);
                    int vb = this.world.SpawnUnit(1, vuid, a.X() + 4,
                                                  a.Y() + 2);
                    if (vb >= 0) {
                        this.world.SpawnBeam(a, this.world.ObjectAt(vb), tz);
                    }
                }
                // Pose the wall layer too: a run of the first shipped
                // wall beside the duel -- intact faces east/west -- with
                // one piece wounded under ConditionYellow so the damaged
                // connection set shows in the same dump.
                Rules srules = this.world.Rules();
                int swo = 0 - 1;
                for (int wi = 0; wi < srules.OverlayTypeCount(); wi = wi + 1) {
                    if (srules.IsWallOverlay(wi)) { swo = wi; break; }
                }
                if (swo >= 0) {
                    for (int wi = 0; wi < 12; wi = wi + 1) {
                        this.world.SetWall(this.duelX + 2 + wi,
                                           this.duelY + 1, swo);
                    }
                    int sstr = srules.OverlayStrength(swo);
                    if (sstr > 3) {
                        this.world.DamageWallAt(this.duelX + 3,
                                                this.duelY + 6,
                                                sstr - sstr / 4);
                    }
                    // Walls bake into the terrain layer: vote the recompose
                    // now so the next frame's dump carries the art (the
                    // ore refresh's 300ms coalesce would miss the dump).
                    this.dirty = true;
                }
                // Pose the infantry death layer: two troopers fall at
                // the duel site (one rifle death, one explosive), their
                // die sequences crossing the next frames' dumps.
                int ggi = Ra2App.UnitIdOfReg(this.world, 0, "GGI");
                if (ggi >= 0) {
                    for (int di = 0; di < 6; di = di + 1) {
                        int g = this.world.SpawnUnit(0, ggi,
                            this.duelX + 1 + di, this.duelY + 3);
                        if (g < 0) { continue; }
                        WorldObject gw = this.world.ObjectAt(g);
                        if (di == 0) {
                            // The first one only gets pinned: he lies
                            // prone among the corpses, alive.
                            gw.TakeDamageAs(gw.Hp() / 3, 1);
                            this.world.SuppressTrooper(gw);
                            continue;
                        }
                        gw.TakeDamageAs(gw.Hp(), di % 2 == 0 ? 1 : 2);
                    }
                }
                int sx = IsoProjection.ScreenX(this.duelX, this.duelY)
                       - this.terrain.OriginX() - this.cam.X();
                int sy = IsoProjection.ScreenY(this.duelX, this.duelY, 0)
                       - this.terrain.OriginY() - this.cam.Y();
                this.cam.MoveBy(sx - Ra2App.ViewW() / 2,
                                sy - Ra2App.ViewH() / 2);
            }
            if (Ra2App.stressLeft == 34) {
                // The posed blast, one frame on.
                Ra2App.DumpScreen(Ra2App.ShotPath("ra2_shot_boom.bmp"), c);
            }
            if (Ra2App.stressLeft == 32) {
                // The falling troopers, their die sequences mid-play.
                Ra2App.DumpScreen(Ra2App.ShotPath("ra2_shot_deaths.bmp"), c);
            }
            if (Ra2App.stressLeft == 12) {
                // Mid-melee: rounds in flight, arcs and impact art over
                // the fight -- the projectile layer's screenshot proof.
                int pside = this.shell.SideIndex();
                Ra2App.DumpScreen(pside == 0
                                  ? Ra2App.ShotPath("ra2_shot_battle.bmp")
                                  : Ra2App.ShotPath("ra2_shot_battle_sov.bmp"),
                                  c);
            }
            if (Ra2App.stressLeft == 0) {
                this.frames = 16;
            } else {
                // Hold: park the frame counter so no other gate
                // fires while the corridor runs.
                this.frames = this.frames - 1;
            }
        }
    }
}
