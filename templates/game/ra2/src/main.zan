using System;
using System.Collections.Generic;
using System.IO;
using Gui;
using Game.Foundation.Gui;
using Ra2.Assets;
using Ra2.Formats;
using Ra2.Render;
using Ra2.Game;
using Ra2.Ui;

namespace Ra2;

// The RA2 HD demo: main menu -> skirmish setup -> terrain view.
//
// Assets are never redistributed. The player supplies their own copy of the
// game under data/, which is gitignored.
class Ra2App {
    // memset rather than a byte loop: the canvas is 3.7 MB and clearing it in
    // Zan costs more than drawing the frame.
    [DllImport("crt")]
    static extern void memset(string p, int v, int n);

    /// <summary>Clears a texture to opaque black (alpha 255). A plain zero
    /// fill leaves alpha 0, i.e. transparent, and the terrain canvas does not
    /// cover its own corners -- the map is a diamond inside a rectangle -- so
    /// the uncovered area has to read as black rather than as a hole onto
    /// whatever the host last drew there.</summary>
    static void ClearOpaqueBlack(Texture t) {
        byte[] px = t.Pixels();
        int n = t.ByteLength();
        for (int i = 0; i + 3 < n; i = i + 4) {
            px[i] = 0; px[i + 1] = 0; px[i + 2] = 0; px[i + 3] = 255;
        }
    }

    /// <summary>Turns a map entry's direction byte into the engine's 8-point
    /// facing. RA2 stores a map object's facing as a 0..255 byte counting
    /// counter-clockwise from north; the reference converts it as
    /// (-direction / 256) * 360 degrees, and on this engine's clockwise ring
    /// that is 8 - round(direction * 8 / 256), taken modulo 8. A 0 byte is
    /// north either way, which is what most map entries carry.</summary>
    static int MapDirectionToFacing(int dir) {
        if (dir < 0) { dir = 0; }
        dir = dir % 256;
        int step = (dir * 8 + 128) / 256;
        int f = (8 - step) % 8;
        if (f < 0) { f = f + 8; }
        return f;
    }

    // Writes a 24-bit BMP of the canvas at its actual size, so the shell
    // screens -- which draw straight to the frame -- can be captured. Used by
    // the self-test to emit regression screenshots of the menu, setup and
    // game screens.
    static void DumpScreen(string path, Canvas c) {
        // The dump path lands in build/, which a clean checkout does not
        // have yet -- a self-test run from the repo root crashes on
        // the write unless the directory exists first.
        int slash = path.Length - 1;
        while (slash >= 0 && path.Substring(slash, 1) != "/") { slash = slash - 1; }
        if (slash > 0) { Directory.CreateDirectoryRecursive(path.Substring(0, slash)); }
        int w = c.Width();
        int h = c.Height();
        if (w <= 0 || h <= 0) {
            Console.WriteLine("selftest dump FAILED (canvas " + Convert.ToString(w)
                + "x" + Convert.ToString(h) + ") " + path);
            return;
        }
        int rowBytes = w * 3;
        int pad = (4 - (rowBytes % 4)) % 4;
        int imageBytes = (rowBytes + pad) * h;
        byte[] bmp = new byte[54 + imageBytes];
        bmp[0] = (byte)0x42;
        bmp[1] = (byte)0x4D;
        Ra2App.PutU32(bmp, 2, 54 + imageBytes);
        Ra2App.PutU32(bmp, 10, 54);
        Ra2App.PutU32(bmp, 14, 40);
        Ra2App.PutI32(bmp, 18, w);
        Ra2App.PutI32(bmp, 22, h);
        bmp[26] = (byte)1;
        bmp[28] = (byte)24;
        // BMP rows run bottom-up, so row y of the file is canvas row h-1-y;
        // the pixel read is that same row, not the flipped one again.
        for (int y = 0; y < h; y = y + 1) {
            int dstRow = 54 + y * (rowBytes + pad);
            int srcY = h - 1 - y;
            for (int x = 0; x < w; x = x + 1) {
                int argb = c.GetPixel(x, srcY);
                bmp[dstRow + x * 3] = (byte)(argb & 0xFF);
                bmp[dstRow + x * 3 + 1] = (byte)((argb >> 8) & 0xFF);
                bmp[dstRow + x * 3 + 2] = (byte)((argb >> 16) & 0xFF);
            }
        }
        File.WriteAllBytes(path, bmp);
        // A screenshot that cannot be read is worse than none: a silent
        // short write used to leave a 1-byte file that the review chain then
        // reported as a black screen. Assert the size the header promised.
        long wrote = File.GetSize(path);
        if (wrote != 54 + imageBytes) {
            Console.WriteLine("selftest dump FAILED (wrote " + Convert.ToString(wrote)
                + ", want " + Convert.ToString(54 + imageBytes) + ") " + path);
            return;
        }
        // Report how much of the frame is not the letterbox background, so a
        // capture of a blank or all-black screen is visible in the log
        // instead of only in the image.
        int litSamples = 0;
        int allSamples = 0;
        int step = w / 32;
        if (step < 1) { step = 1; }
        for (int y = h / 16; y < h; y = y + h / 16) {
            for (int x = step; x < w; x = x + step) {
                int argb = c.GetPixel(x, y);
                int rr = (argb >> 16) & 0xFF;
                int gg = (argb >> 8) & 0xFF;
                int bb = argb & 0xFF;
                allSamples = allSamples + 1;
                if (rr + gg + bb > 30) { litSamples = litSamples + 1; }
            }
        }
        Console.WriteLine("selftest dump " + path + " " + Convert.ToString(w)
            + "x" + Convert.ToString(h) + " lit="
            + Convert.ToString(litSamples) + "/"
            + Convert.ToString(allSamples));
    }

    /// <summary>Writes a 24-bit BMP of an in-memory Texture. The screen dumps
    /// go through DumpScreen (a Gui surface); a baked sprite lives in a
    /// Texture, which has no surface to read back, so the header is written
    /// here the same way.</summary>
    static void DumpTexture(string path, Texture t) {
        int slash = path.Length - 1;
        while (slash >= 0 && path.Substring(slash, 1) != "/") { slash = slash - 1; }
        if (slash > 0) { Directory.CreateDirectoryRecursive(path.Substring(0, slash)); }
        int w = t.Width();
        int h = t.Height();
        if (w <= 0 || h <= 0) { return; }
        int rowBytes = w * 3;
        int pad = (4 - (rowBytes % 4)) % 4;
        int imageBytes = (rowBytes + pad) * h;
        byte[] bmp = new byte[54 + imageBytes];
        bmp[0] = (byte)0x42;
        bmp[1] = (byte)0x4D;
        Ra2App.PutU32(bmp, 2, 54 + imageBytes);
        Ra2App.PutU32(bmp, 10, 54);
        Ra2App.PutU32(bmp, 14, 40);
        Ra2App.PutI32(bmp, 18, w);
        Ra2App.PutI32(bmp, 22, h);
        bmp[26] = (byte)1;
        bmp[28] = (byte)24;
        for (int y = 0; y < h; y = y + 1) {
            int dstRow = 54 + y * (rowBytes + pad);
            for (int x = 0; x < w; x = x + 1) {
                int argb = t.PixelAt(x, h - 1 - y);
                bmp[dstRow + x * 3] = (byte)(argb & 0xFF);
                bmp[dstRow + x * 3 + 1] = (byte)((argb >> 8) & 0xFF);
                bmp[dstRow + x * 3 + 2] = (byte)((argb >> 16) & 0xFF);
            }
        }
        File.WriteAllBytes(path, bmp);
    }

    static void PutU32(byte[] b, int at, int v) {
        b[at] = (byte)(v & 0xFF);
        b[at + 1] = (byte)((v >> 8) & 0xFF);
        b[at + 2] = (byte)((v >> 16) & 0xFF);
        b[at + 3] = (byte)((v >> 24) & 0xFF);
    }

    /// <summary>A side's unit id for a rules registry key, -1 when the side
    /// cannot build it. Lets the selftest name a unit instead of hardcoding
    /// menu positions.</summary>
    static int UnitIdOfReg(World world, int side, string reg) {
        for (int i = 0; i < world.Units().ListFor(world, side).Count; i = i + 1) {
            UnitType t = world.Units().TypeFor(world, side, i);
            if (t != null && t.Reg() == reg) { return i; }
        }
        return -1;
    }

    static void PutI32(byte[] b, int at, int v) {
        b[at] = (byte)(v & 0xFF);
        b[at + 1] = (byte)((v >> 8) & 0xFF);
        b[at + 2] = (byte)((v >> 16) & 0xFF);
        b[at + 3] = (byte)((v >> 24) & 0xFF);
    }

    // The drawing stage. The host maps the window onto a logical surface
    // with ONE scale (the short axis matches the 1280x720 design), so the
    // long axis extends into extra logical room; StageViewport republishes
    // that extended size each frame and the template anchors every layout
    // to it. Resizing the window therefore never reflows anything -- the
    // whole picture scales uniformly, and the shell's 4:3 base stays
    // centred because BaseRect fits it inside whatever W/H it is handed.
    static int vw;
    static int vh;

    static int ViewW() { return vw > 0 ? vw : 1280; }
    static int ViewH() { return vh > 0 ? vh : 720; }

    /// <summary>Adopts the host's stage for this frame (called at the top of
    /// Render, before any layout reads ViewW/ViewH).</summary>
    static void SetStage(int w, int h) {
        if (w > 0 && h > 0) { vw = w; vh = h; }
    }

    // Loading-screen and options state: the frames the load screen has run
    // (drives the bar), the cached LS800 backdrop (closed when a different
    // country loads), and the edge-scroll step the 选项 page's slider sets.
    static int loadFrames;
    static R2Tex loadBackdrop;
    static string loadBackdropName;
    static int scrollStep = 64;

    // Perf corridor accumulators, armed by the selftest's stress leg: 40
    // frames of tick and draw cost over the loaded world, printed as the
    // "selftest perf" line.
    static int profOn;
    static int profN;
    static int profTick;
    static int profDraw;
    static int profDrawMax;
    static int profTer;
    static int profTerMax;
    static int profUp;
    static int stressLeft;
    static int stressDone;
    // The self-test opener: the world is up on its MCV, so shoot it, unfold
    // it (deploy), and arm the first building once the yard stands. Frame
    // numbers are not fixed here -- the load screen decides when the world
    // appears -- so the walk gates on these flags instead.
    static bool deployTried;
    static int deployFrame;
    static bool yardShown;
    static bool buildArmed;
    // The map-picker walk runs once; its frames re-fire when the shell loops.
    static bool mapSelOpened;
    static bool mapSelUsed;

    // Locates data/ regardless of the working directory the game was launched
    // from (repo root, build/, or a double-click on the exe). Falls back to the
    // repo-relative path so the "missing assets" hint still names the spot the
    // player should fill.
    static string DataDir() {
        string rel = "data";
        if (File.Exists(rel + "/ra2.mix")) { return rel; }
        if (File.Exists("../" + rel + "/ra2.mix")) { return "../" + rel; }
        if (File.Exists("../../" + rel + "/ra2.mix")) { return "../../" + rel; }
        return rel;
    }

    // Returns the name of the first required archive that is missing, or "".
    static string MissingArchive(string dir) {
        if (!File.Exists(dir + "/ra2.mix")) { return "ra2.mix"; }
        if (!File.Exists(dir + "/language.mix")) { return "language.mix"; }
        if (!File.Exists(dir + "/multi.mix")) { return "multi.mix"; }
        return "";
    }

    // zanc has no command-line argument accessor, so the self-test is armed
    // through the environment: RA2_SELFTEST=1 walks menu -> setup -> a
    // rendered frame and exits, which is what CI and a quick smoke run need.
    [DllImport("crt")]
    static extern string getenv(string name);

    static bool SelfTestArmed() {
        string v = Ra2App.getenv("RA2_SELFTEST");
        return v != null && v.Length > 0 && v != "0";
    }

    // Every self-test run writes its screenshots into its own directory,
    // named for the process, so a stale capture can never be mistaken for a
    // fresh one -- reading an old shot from a shared build/ directory cost
    // this project several rounds of chasing bugs that were not there.
    // RA2_SHOT_TAG overrides the suffix for a caller that wants a stable
    // name.
    static string ShotTag;

    static string ShotDir() {
        if (Ra2App.ShotTag == null) {
            string tag = Ra2App.getenv("RA2_SHOT_TAG");
            if (tag == null || tag.Length == 0) {
                tag = Convert.ToString(Window.GetTickMs() % 1000000);
            }
            Ra2App.ShotTag = "build/run" + tag;
        }
        return Ra2App.ShotTag;
    }

    /// <summary>The path a self-test screenshot should be written to. Always
    /// inside the run's own directory (see ShotDir).</summary>
    static string ShotPath(string name) {
        return Ra2App.ShotDir() + "/" + name;
    }

    // RA2_DUMP_ASSETS=1 copies a short list of shipped art out of the install's
    // mixes, so a decoder under test can be checked against the raw bytes by an
    // outside tool. Dev aid only; the game itself never needs it.
    static bool DumpAssetsArmed() {
        string v = Ra2App.getenv("RA2_DUMP_ASSETS");
        return v != null && v.Length > 0 && v != "0";
    }

    // Dev aid: the shipped ground rules, asserted rather than assumed.
    //  - a ground unit cannot cross water, and no ordinary structure may sit
    //    on it either (buildableOnWater must be 0);
    //  - the WaterBound shipyard is the one exception: if the map carries
    //    water it must accept the yard somewhere (waterYard>0), and it must
    //    never accept dry land (landYard must be 0).
    // The two "must be 0" counts are what a wrong water table would break.
    // Dev aid: the terrain model, asserted rather than eyeballed.
    //
    // A miner was driving onto cliffs because passability asked only "may a
    // unit BE in this cell" and never "may it GO from here to there". The
    // numbers below are the assertion that the transition rule is live:
    //
    //   cliffCells   -- cells whose land class is Cliff. A ground unit must
    //                   never be standing on one, and CanStep must never
    //                   accept one as a destination.
    //   illegalSteps -- height-changing steps accepted without a ramp. Must
    //                   be 0 for a land unit.
    //   rampSteps    -- height-changing steps accepted through a ramp. Must
    //                   be > 0 on a map that has any ramp, or the rule is
    //                   simply refusing everything and paths would vanish.
    //   reachable    -- cells the route search can reach from the start
    //                   position, so "0 illegal" cannot be the trivial
    //                   result of a search that finds nothing at all.
    static void ProbeTerrain(World world) {
        int cliffCells = 0;
        int unitsOnCliff = 0;
        int illegal = 0;
        int rampSteps = 0;
        int legalFlats = 0;
        int rampCells = 0;
        int ttKnown = 0;
        int ttUnknown = 0;

        for (int y = 0; y < world.Height(); y = y + 1) {
            for (int x = 0; x < world.Width(); x = x + 1) {
                if (world.CellIsCliff(x, y)) { cliffCells = cliffCells + 1; }
                if (world.CellRampAt(x, y) != 0) { rampCells = rampCells + 1; }
                int tt = world.CellTerrainType(x, y);
                if (tt < 0) { ttUnknown = ttUnknown + 1; } else { ttKnown = ttKnown + 1; }
                // The four orthogonal steps out of this cell.
                for (int d = 0; d < 4; d = d + 1) {
                    int nx = x;
                    int ny = y;
                    if (d == 0) { nx = x + 1; }
                    else if (d == 1) { nx = x - 1; }
                    else if (d == 2) { ny = y + 1; }
                    else { ny = y - 1; }
                    if (!world.InBounds(nx, ny)) { continue; }
                    if (!world.CanStep(x, y, nx, ny, false)) { continue; }
                    int dz = world.LevelAt(x, y) - world.LevelAt(nx, ny);
                    if (dz == 0) {
                        legalFlats = legalFlats + 1;
                    } else if (world.CellRampAt(x, y) != 0
                            || world.CellRampAt(nx, ny) != 0) {
                        rampSteps = rampSteps + 1;
                    } else if (world.CellRough(x, y)) {
                        rampSteps = rampSteps + 1;
                    } else {
                        illegal = illegal + 1;
                    }
                }
            }
        }

        // Each unit's own cell must be legal ground.
        for (int i = 0; i < world.ObjectCount(); i = i + 1) {
            if (!world.IsUnitIndex(i)) { continue; }
            int ux = world.ObjectX(i);
            int uy = world.ObjectY(i);
            if (world.CellIsCliff(ux, uy)) { unitsOnCliff = unitsOnCliff + 1; }
        }

        // Reachability from the first unit, so a vacuous 0 is visible.
        int reachable = world.ReachableFromFirstUnit();

        Console.WriteLine("selftest terrain cliffCells="
            + Convert.ToString(cliffCells)
            + " rampCells=" + Convert.ToString(rampCells)
            + " unitsOnCliff=" + Convert.ToString(unitsOnCliff)
            + " illegalSteps=" + Convert.ToString(illegal)
            + " rampSteps=" + Convert.ToString(rampSteps)
            + " legalFlats=" + Convert.ToString(legalFlats)
            + " ttKnown=" + Convert.ToString(ttKnown)
            + " ttUnknown=" + Convert.ToString(ttUnknown)
            + " reachable=" + Convert.ToString(reachable));
    }

    static void ProbeGroundRule(World world, int side, int buildId) {
        int blocked = 0;
        int bad = 0;
        int fx = 0 - 1;
        int fy = 0 - 1;
        int water = 0;
        int waterYard = 0;
        int landYard = 0;
        int yard = world.IdOfReg(side, "GAYARD");
        if (yard < 0) { yard = world.IdOfReg(side, "NAYARD"); }
        if (yard < 0) { yard = world.IdOfReg(side, "YAYARD"); }
        for (int y = 0; y < world.Height(); y = y + 1) {
            for (int x = 0; x < world.Width(); x = x + 1) {
                bool isW = world.CellIsWater(x, y);
                if (!isW && !world.PassableForRoute(x, y, false)) {
                    blocked = blocked + 1;
                    if (world.CanPlaceBuilding(side, buildId, x, y)) {
                        bad = bad + 1;
                        if (fx < 0) { fx = x; fy = y; }
                    }
                }
                if (!isW) {
                    if (yard >= 0 && world.CanPlaceBuilding(side, yard, x, y)) {
                        landYard = landYard + 1;
                    }
                    continue;
                }
                water = water + 1;
                if (yard >= 0 && world.CanPlaceBuilding(side, yard, x, y)) {
                    waterYard = waterYard + 1;
                }
            }
        }
        Console.WriteLine("selftest groundRule impassable="
            + Convert.ToString(blocked)
            + " buildableOnImpassable=" + Convert.ToString(bad)
            + " first=" + Convert.ToString(fx) + "," + Convert.ToString(fy)
            + " water=" + Convert.ToString(water)
            + " waterYard=" + Convert.ToString(waterYard)
            + " landYard=" + Convert.ToString(landYard)
            + " yardId=" + Convert.ToString(yard));
        string names = "";
        for (int i = 0; i < 40; i = i + 1) {
            StructureType st = world.CatalogType(side, i);
            if (st == null) { continue; }
            names = names + st.Reg() + (st.WaterBound() ? "*" : "") + " ";
        }
        Console.WriteLine("selftest catalog side=" + Convert.ToString(side)
            + " n=" + Convert.ToString(names.Trim()));
    }

    // Dev aid: the basic build rule, asserted. Before the MCV has unfolded
    // nothing in the sidebar may be unlocked -- the shipped tree gates every
    // structure behind the construction yard (GAPOWR is Prerequisite=GACNST,
    // and the rest chain off it). After the deploy at least the power plant
    // must be unlocked. Prints the count and the unlocked regs.
    static void ProbeUnlocked(GameController game, string tag) {
        int n = 0;
        string names = "";
        for (int i = 0; i < 40; i = i + 1) {
            StructureType t = game.World().CatalogType(game.Side(), i);
            if (t == null) { continue; }
            if (t.TechLevel() < 0) { continue; }
            if (!game.BuildUnlocked(i)) { continue; }
            n = n + 1;
            names = names + t.Reg() + " ";
        }
        Console.WriteLine("selftest unlocked " + tag + " n=" + Convert.ToString(n)
            + " " + names.Trim());
    }

    // Dev aid: every sidebar portrait of both sides, resolved and decoded the
    // way the sidebar draws it. A line per entry names the reg, the art key
    // the Cameo= reader produced, and "ok"/"MISSING" for the texture. A
    // MISSING is exactly the "wrong art on the card" bug: the card falls back
    // to a guessed <reg>ICON.SHP that the install does not carry.
    static void ProbeCameos(GameController game, ObjectArt art, AssetDb db) {
        Ra2.Formats.IniDocument artIni = db.Art();
        Ra2.Formats.IniSection ggi = artIni.Section("GGI");
        string hits = "";
        for (int i = 0; i < artIni.Count(); i = i + 1) {
            string nm = artIni.SectionAt(i).Name();
            if (nm.Length >= 3 && nm.Substring(0, 3).ToUpper() == "GGI") {
                hits = hits + "[" + nm + "]";
            }
        }
        Console.WriteLine("selftest artprobe GGI section="
            + (ggi == null ? "null" : "found")
            + " entries=" + (ggi == null ? "-" : Convert.ToString(ggi.Count()))
            + " cameo=" + (ggi == null ? "-" : ggi.Get("Cameo"))
            + " artSections=" + Convert.ToString(artIni.Count())
            + " ggiHits=" + hits
            + " mdSections=" + Convert.ToString(db.LoadIni("ARTMD.INI").Count())
            + " mdGGI=" + (db.LoadIni("ARTMD.INI").Section("GGI") == null
                            ? "null" : "found")
            + " baseSections=" + Convert.ToString(db.LoadIni("ART.INI").Count())
            + " rulesMd=" + Convert.ToString(db.LoadIni("RULESMD.INI").Count())
            + " artMdBytes=" + Convert.ToString(Ra2App.ProbeReadLen(db, "ARTMD.INI")));
        Console.WriteLine("selftest artprobe head="
            + Ra2App.ProbeReadHead(db, "ARTMD.INI"));
        for (int s = 0; s < 3; s = s + 1) {
            List<UnitType> us = game.World().Units().ListFor(game.World(), s);
            for (int i = 0; i < us.Count; i = i + 1) {
                UnitType u = us[i];
                Texture tx = art.CameoTexture(u);
                Console.WriteLine("selftest cameo side=" + Convert.ToString(s)
                    + " " + u.Reg()
                    + " art=" + (u.ArtKey() == null ? "-" : u.ArtKey())
                    + " key=" + (u.Cameo() == null ? "-" : u.Cameo())
                    + " " + (tx == null ? "MISSING" : "ok"));
            }
            List<StructureType> bs = game.World().Catalog().ListFor(game.World(), s);
            for (int i = 0; i < bs.Count; i = i + 1) {
                StructureType b = bs[i];
                Texture tx = art.StructureCameoTexture(b);
                Console.WriteLine("selftest cameo side=" + Convert.ToString(s)
                    + " BUILD " + b.Reg()
                    + " key=" + (b.Cameo() == null ? "-" : b.Cameo())
                    + " " + (tx == null ? "MISSING" : "ok"));
            }
        }
    }

    /// <summary>Dev aid: the raw vfs read length of a file, or -1.</summary>
    static int ProbeReadLen(AssetDb db, string name) {
        List<int> len = new List<int>();
        len.Add(0);
        db.Files().Read(name, len);
        return len[0];
    }

    static string ProbeReadHead(AssetDb db, string name) {
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = db.Files().Read(name, len);
        if (len[0] <= 0) { return "(empty)"; }
        int n = len[0] < 24 ? len[0] : 24;
        return raw.ToStr(0, n);
    }

    /// <summary>Dev aid: writes the engine's own baked voxel sprites, one BMP
    /// per model+facing, so an offline sheet can diff them against the
    /// reference engine's projection (build/_vfs/refvxl.py). A whole-frame
    /// screenshot hides exactly the thing under test -- a vehicle's size and
    /// hull shape.</summary>
    static void DumpVehicleSprites(ObjectArt art) {
        List<string> models = new List<string>();
        models.Add("GTNK.VXL");
        models.Add("GTNKTUR.VXL");
        models.Add("MTNK.VXL");
        models.Add("MCV.VXL");
        models.Add("FV.VXL");
        models.Add("SREF.VXL");
        models.Add("TNKD.VXL");
        models.Add("CMIN.VXL");
        models.Add("HARV.VXL");
        for (int m = 0; m < models.Count; m = m + 1) {
            VxlImage img = art.RawVxl(models[m]);
            if (img != null) {
                VxlLimb l = img.Main();
                string zt = "";
                for (int z = 0; z < l.SizeZ() && z < 6; z = z + 1) {
                    zt = zt + Convert.ToString(l.FilledAtZ(z)) + " ";
                }
                Console.WriteLine("selftest vox " + models[m]
                    + " size=" + Convert.ToString(l.SizeX()) + "x"
                    + Convert.ToString(l.SizeY()) + "x"
                    + Convert.ToString(l.SizeZ())
                    + " filled=" + Convert.ToString(l.FilledCount())
                    + " z0..5=" + zt);
            }
            for (int f = 0; f < 8; f = f + 1) {
                Texture t = art.VehicleTexture(models[m], f, 0);
                if (t == null) { continue; }
                Console.WriteLine("selftest bake " + models[m] + " f"
                    + Convert.ToString(f) + " " + ObjectArt.LastBakeStats());
                Ra2App.DumpTexture("build/_vox/" + models[m] + "_f"
                    + Convert.ToString(f) + ".bmp", t);
            }
        }
        Console.WriteLine("selftest dumped vehicles="
            + Convert.ToString(models.Count));
    }

