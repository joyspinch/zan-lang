using System;
using System.Collections.Generic;
using Ra2.Formats;

namespace Ra2.Game;

/// <summary>The eleven armour classes a warhead can be strong or weak
/// against, in the order RA2's Verses= lists them. Every warhead carries one
/// percentage per class; a shot multiplies its damage by the target's
/// percentage before it lands. The values are the game's own, so a flak-jacket
/// conscript really shrugs off rifle fire less than a bare-skinned GI and a
/// hollow-point sniper round barely scratches a tank but deletes infantry.</summary>
class ArmorClass {
    static int None() { return 0; }        // unarmoured infantry
    static int Flak() { return 1; }        // flak jackets
    static int Plate() { return 2; }       // heavy infantry plating
    static int Light() { return 3; }       // light vehicles
    static int Medium() { return 4; }
    static int Heavy() { return 5; }
    static int Wood() { return 6; }        // weak structures
    static int Steel() { return 7; }
    static int Concrete() { return 8; }
    static int Special1() { return 9; }    // terror drones and friends
    static int Special2() { return 10; }
    static int Count() { return 11; }

    /// <summary>The armour class an INI Armour= value names, or None when the
    /// name is unknown.</summary>
    static int Parse(string name) {
        string n = name.ToLower().Trim();
        if (n == "flak") { return ArmorClass.Flak(); }
        if (n == "plate") { return ArmorClass.Plate(); }
        if (n == "light") { return ArmorClass.Light(); }
        if (n == "medium") { return ArmorClass.Medium(); }
        if (n == "heavy") { return ArmorClass.Heavy(); }
        if (n == "wood") { return ArmorClass.Wood(); }
        if (n == "steel") { return ArmorClass.Steel(); }
        if (n == "concrete") { return ArmorClass.Concrete(); }
        if (n == "special_1") { return ArmorClass.Special1(); }
        if (n == "special_2") { return ArmorClass.Special2(); }
        return ArmorClass.None();
    }
}

/// <summary>How a weapon's damage lands: one multiplier per armour class plus
/// the special behaviours RA2 builds out of warheads -- dogs instakill
/// infantry, chrono beams freeze, Yuri's pulse converts, Ivan plants a bomb.
/// CellSpread 0 hits the target alone; anything wider splashes (unused by the
/// ground warheads that matter here except the desolator's eruption).</summary>
class Warhead {
    string name;
    List<int> verse;      // 11 percentages, indexed by ArmorClass
    int spread;           // splash radius in cells, 0 = single target
    bool killsInfantry;   // an infantry hit dies regardless of the damage
    bool mindControl;     // converts a living unit to the shooter's side
    bool freeze;          // the hit unit stands frozen for a while
    bool plantsBomb;      // sticks a timed bomb on the target
    int infDeath;         // InfDeath=: which infantry death art this
                          // warhead triggers (InfDeathType)
    List<string> animList;  // impact art, small to large by damage tier
    bool conventional;      // Conventional=yes: bullets/shells (water splash)
    // ElectricAssault=: the weapon firing through this warhead plays its
    // report at a quarter volume (the reference's SoundHandler volume gate).
    bool electricAssault;

    static Warhead Create(string name, string verses) {
        Warhead w = new Warhead();
        w.name = name;
        w.verse = Rules.ParsePercents(verses);
        w.spread = 0;
        w.killsInfantry = false;
        w.mindControl = false;
        w.freeze = false;
        w.plantsBomb = false;
        w.infDeath = 0;
        w.conventional = false;
        w.electricAssault = false;
        return w;
    }

    string Name() { return this.name; }
    int Spread() { return this.spread; }
    bool KillsInfantry() { return this.killsInfantry; }
    bool MindControl() { return this.mindControl; }
    bool Freeze() { return this.freeze; }
    bool PlantsBomb() { return this.plantsBomb; }
    void SetSpread(int cells) { this.spread = cells; }

    /// <summary>The impact art list, ordered small to large: the detonation
    /// picks AnimList[damage/25], so a rifle piff and a battleship shell
    /// share one list and land on different entries.</summary>
    void SetAnimList(List<string> names) { this.animList = names; }
    int AnimCount() { return this.animList == null ? 0 : this.animList.Count; }
    bool Conventional() { return this.conventional; }
    void SetConventional(bool v) { this.conventional = v; }
    bool ElectricAssault() { return this.electricAssault; }
    void SetElectricAssault(bool on) { this.electricAssault = on; }
    string AnimAt(int i) { return this.animList[i]; }
    void SetKillsInfantry(bool on) { this.killsInfantry = on; }
    void SetMindControl(bool on) { this.mindControl = on; }
    void SetFreeze(bool on) { this.freeze = on; }
    void SetPlantsBomb(bool on) { this.plantsBomb = on; }
    int InfDeath() { return this.infDeath; }
    void SetInfDeath(int v) { this.infDeath = v; }

    /// <summary>The damage percentage against an armour class, 0-200.</summary>
    int Verse(int armor) {
        if (armor < 0 || armor >= this.verse.Count) { return 100; }
        return this.verse[armor];
    }

    void SetVerse(int armor, int percent) {
        if (armor >= 0 && armor < this.verse.Count) {
            this.verse[armor] = percent;
        }
    }
}

/// <summary>A named gun: how hard it hits, how often, from how far away, and
/// through which warhead. ROF is kept in ticks (the game runs at fifteen
/// ticks a second, RA2's logic frame rate, so the INI's frame counts carry
/// over unchanged).</summary>
class Weapon {
    string name;
    int damage;
    int rof;       // ticks between shots
    int range;     // cells (manhattan)
    Warhead warhead;
    // Projectile flight. Speed is the INI's own unit (100 = one cell a
    // tick, the reference caps at one tile per tick); the projectile type
    // carries the shape and guidance of the round itself.
    int speed;
    ProjectileType proj;
    // Beam guns -- prism (IsLaser), tesla (IsElectricBolt), radiation and
    // chrono (IsRadBeam): the light drawn from firer to target IS the
    // shot, so they hit the instant they fire instead of launching a round.
    bool isLaser;
    bool isElectricBolt;
    bool isRadBeam;
    int laserDuration;
    // Report=: the sound.ini names the shot calls, comma-listed; the fire
    // event picks one at random (the reference's WeaponRules.report).
    List<string> report;

    static Weapon Create(string name, int damage, int rof, int range,
                         Warhead warhead) {
        Weapon w = new Weapon();
        w.name = name;
        w.damage = damage;
        w.rof = rof;
        w.range = range;
        w.warhead = warhead;
        w.speed = 100;
        w.laserDuration = 15;
        w.report = new List<string>();
        return w;
    }

    string Name() { return this.name; }
    int Damage() { return this.damage; }
    int Rof() { return this.rof; }
    int Range() { return this.range; }
    Warhead Warhead() { return this.warhead; }
    void SetDamage(int dmg) { this.damage = dmg; }
    void SetRof(int rof) { this.rof = rof; }
    void SetRange(int range) { this.range = range; }
    void SetWarhead(Warhead w) { this.warhead = w; }
    int Speed() { return this.speed; }
    void SetSpeed(int speed) { this.speed = speed; }
    ProjectileType Proj() { return this.proj; }
    void SetProj(ProjectileType p) { this.proj = p; }
    bool IsLaser() { return this.isLaser; }
    bool IsElectricBolt() { return this.isElectricBolt; }
    bool IsRadBeam() { return this.isRadBeam; }
    int ReportCount() { return this.report == null ? 0 : this.report.Count; }
    string ReportAt(int i) { return this.report[i]; }
    void SetReport(List<string> names) { this.report = names; }
    void SetBeamFlags(bool laser, bool bolt, bool rad) {
        this.isLaser = laser;
        this.isElectricBolt = bolt;
        this.isRadBeam = rad;
    }
    int LaserDuration() { return this.laserDuration; }
    void SetLaserDuration(int ticks) { this.laserDuration = ticks; }

    /// <summary>A beam gun: the shot is light, not a travelling round, so
    /// damage lands this tick and the renderer draws the ray.</summary>
    bool IsBeamWeapon() {
        return this.isLaser || this.isElectricBolt || this.isRadBeam;
    }
}

/// <summary>A projectile type straight out of RULES' [Projectiles] sections:
/// what the round looks like (Image=, "" when none or Inviso) and how it
/// flies. Arcing rounds loft on a gravity parabola (tank shells); rounds
/// with ROT are guided missiles that steer ROT×1.40625° a tick and
/// accelerate from rest; everything else flies straight at the weapon's
/// Speed. A weapon whose projectile has no ini section flies the defaults,
/// exactly like the reference engine's getOrCreateSection fallback.</summary>
class ProjectileType {
    string name;
    string image;      // SHP art name, "" = nothing drawn
    bool arcing;
    bool inviso;
    int rot;           // ini ROT, 0 = unguided
    int acceleration;  // leptons/tick gained per tick (default 3)
    bool subjectToWalls;
    string trailer;    // art Trailer= anim dropped along the flight path
    int trailerDelay;  // art SpawnDelay= ticks between puffs

    static ProjectileType Create(string name) {
        ProjectileType p = new ProjectileType();
        p.name = name;
        p.image = "";
        p.rot = 0;
        p.acceleration = 3;
        p.subjectToWalls = true;
        p.trailer = "";
        p.trailerDelay = 3;
        return p;
    }

    string Name() { return this.name; }
    string Image() { return this.image; }
    bool Arcing() { return this.arcing; }
    bool Inviso() { return this.inviso; }
    int Rot() { return this.rot; }
    int Acceleration() { return this.acceleration; }
    void SetImage(string image) { this.image = image; }
    void SetArcing(bool on) { this.arcing = on; }
    void SetInviso(bool on) { this.inviso = on; }
    void SetRot(int rot) { this.rot = rot; }
    void SetAcceleration(int a) { this.acceleration = a; }
    bool Homing() { return this.rot > 0 && !this.arcing; }
    string Trailer() { return this.trailer; }
    int TrailerDelay() { return this.trailerDelay; }
    void SetTrailer(string t) { this.trailer = t; }
    void SetTrailerDelay(int d) { this.trailerDelay = d; }
}

/// <summary>What a soldier (or drone) is, straight out of RULES.INI: cost and
/// health, the guns he carries, who trains him and which buildings must stand
/// first. Prereq tokens are the [General] alias names (POWER, FACTORY,
/// BARRACKS, RADAR, TECH, PROC) or a concrete building regkey; the catalog
/// resolves them to build ids per side.</summary>
/// <summary>The eight TechnoRules voice keys, exactly the strings the
/// reference reads per techno: sound.ini section names the unit answers
/// selection and orders with. Empty = the type carries no line.</summary>
class TechnoVoices {
    string select;
    string move;
    string attack;
    string feedback;
    string specialAttack;
    string enter;
    string capture;
    string crashing;

    static TechnoVoices Create() {
        TechnoVoices v = new TechnoVoices();
        v.select = "";
        v.move = "";
        v.attack = "";
        v.feedback = "";
        v.specialAttack = "";
        v.enter = "";
        v.capture = "";
        v.crashing = "";
        return v;
    }

    string Select() { return this.select; }
    string Move() { return this.move; }
    string Attack() { return this.attack; }
    string Feedback() { return this.feedback; }
    string SpecialAttack() { return this.specialAttack; }
    string Enter() { return this.enter; }
    string Capture() { return this.capture; }
    string Crashing() { return this.crashing; }

    /// <summary>The techno's own rules section, one key at a time exactly
    /// like the reference's TechnoRules read. Absent keys read empty.</summary>
    void ReadIni(IniSection s) {
        this.select = s.Get("VoiceSelect");
        this.move = s.Get("VoiceMove");
        this.attack = s.Get("VoiceAttack");
        this.feedback = s.Get("VoiceFeedback");
        this.specialAttack = s.Get("VoiceSpecialAttack");
        this.enter = s.Get("VoiceEnter");
        this.capture = s.Get("VoiceCapture");
        this.crashing = s.Get("VoiceCrashing");
    }
}

class UnitDef {
    string reg;        // E1, DOG, ...
    string label;      // the Chinese sidebar name
    int cost;
    int hp;
    int speed;         // RA2 speed class: 4 foot, 8 fast foot, 10 drone
    int armor;         // ArmorClass
    Weapon primary;    // null = unarmed (engineer, spy)
    Weapon secondary;  // picked per shot when its verse beats the primary's
    string producer;   // building regkey that trains this unit
    List<string> prereq;
    int sideMask;      // 1 allied, 2 soviet, 3 both
    int role;          // UnitRole
    bool mindImmune;   // dogs and Tanya shrug off mind control
    string shp;
    string turretVxl;  // turret art (<unit>TUR.VXL), null = fixed superstructure
    // Deploy semantics, the shipped rules' own keys: DeploysInto=<building>
    // turns the unit into that structure in place (the MCVs), Deployer=yes
    // marks the infantry that toggles a deployed stance (the GI).
    string deploysInto;
    bool deployer;
    // DamageParticleSystems=/DamageSmokeOffset= from the unit's own rules
    // section: which wounded units vent smoke, and from where (256ths).
    List<string> damageParticles;
    int smokeOffX;
    int smokeOffY;
    // The harvester hold in bails, the shipped rules' Storage= key (CMIN
    // and SMIN 20, HARV 40). Zero for everything that does not mine.
    int storage;

    // The sight range in cells, the shipped rules' Sight= key (TechnoRules
    // caps it at 11, engineers 6, everything unlisted sees 1). Drives the
    // shroud reveal circle.
    int sight;

    // The shipped rules' CrateGoodie= key (TechnoRules, default no): a
    // vehicle marked this way is in the pool the unit crate rolls from.
    // No retail vehicle ships with the flag; custom rule sets can.
    bool crateGoodie;

    // The TechnoRules voice keys (VoiceSelect= and friends), sound.ini
    // names read from the install's own section.
    TechnoVoices voices;

    static UnitDef Create(string reg, string label, int cost, int hp,
                          int speed, int armor, Weapon primary,
                          string producer, int sideMask, string shp) {
        UnitDef d = new UnitDef();
        d.reg = reg;
        d.label = label;
        d.cost = cost;
        d.hp = hp;
        d.speed = speed;
        d.armor = armor;
        d.primary = primary;
        d.secondary = null;
        d.producer = producer;
        d.prereq = new List<string>();
        d.sideMask = sideMask;
        d.role = UnitRole.None();
        d.mindImmune = false;
        d.shp = shp;
        d.turretVxl = null;
        d.artKey = reg;
        d.voices = TechnoVoices.Create();
        d.newTheater = false;
        d.deploysInto = null;
        d.deployer = false;
        d.storage = 0;
        d.sight = 1;
        d.crateGoodie = false;
        return d;
    }

    string Reg() { return this.reg; }
    string Label() { return this.label; }
    int Cost() { return this.cost; }
    int Hp() { return this.hp; }
    int Speed() { return this.speed; }
    int Armor() { return this.armor; }
    Weapon Primary() { return this.primary; }
    Weapon Secondary() { return this.secondary; }
    string Producer() { return this.producer; }
    List<string> Prereq() { return this.prereq; }
    int SideMask() { return this.sideMask; }
    int Storage() { return this.storage; }
    void SetStorage(int v) { this.storage = v; }
    int Sight() { return this.sight; }
    void SetSight(int v) { this.sight = v; }
    bool CrateGoodie() { return this.crateGoodie; }
    void SetCrateGoodie(bool on) { this.crateGoodie = on; }
    TechnoVoices Voices() { return this.voices; }
    int Role() { return this.role; }
    bool MindImmune() { return this.mindImmune; }
    string Shp() { return this.shp; }
    string TurretVxl() { return this.turretVxl; }
    void SetSecondary(Weapon w) { this.secondary = w; }
    void SetRole(int role) { this.role = role; }
    void SetMindImmune(bool on) { this.mindImmune = on; }
    void AddPrereq(string token) { this.prereq.Add(token); }
    void SetCost(int cost) { this.cost = cost; }
    void SetHp(int hp) { this.hp = hp; }
    void SetSpeed(int speed) { this.speed = speed; }
    void SetArmor(int armor) { this.armor = armor; }
    void SetShp(string shp) { this.shp = shp; }
    void SetTurretVxl(string vxl) { this.turretVxl = vxl; }
    void SetPrimary(Weapon w) { this.primary = w; }
    void SetLabel(string label) { this.label = label; }
    string DeploysInto() { return this.deploysInto; }
    void SetDeploysInto(string reg) { this.deploysInto = reg; }
    List<string> DamageParticles() { return this.damageParticles; }
    void SetDamageParticles(List<string> v) { this.damageParticles = v; }
    int SmokeOffX() { return this.smokeOffX; }
    void SetSmokeOffX(int v) { this.smokeOffX = v; }
    int SmokeOffY() { return this.smokeOffY; }
    void SetSmokeOffY(int v) { this.smokeOffY = v; }
    bool Deployer() { return this.deployer; }
    void SetDeployer(bool on) { this.deployer = on; }

    // ---- Infantry art sequences, from the art ini's Sequence= section
    // (e.g. [GI] Sequence=GISequence, [GISequence] Walk=8,6,6). The frame
    // layout differs per troop: the renderer picks walk/idle frames from
    // these starts instead of assuming one layout. Defaults are the common
    // layout (ready ring at 0, walk blocks of six from 8).
    string artKey;
    bool newTheater;
    int readyStart = 0;
    int walkStart = 8;
    int walkFrames = 6;
    bool hasSeq;
    // The deployed (sat-down) pose, from the same sequence: GISequence's
    // Deployed=292,1,1 is a one-frame block per facing, so the stand ring
    // is 292 + facing. Absent for troops that cannot deploy.
    int deployedStart = 0;
    int deployedFrames = 1;
    bool hasDeployed;
    // The sidebar portrait's shipped stem, from the art section's Cameo= key
    // ([CMIN] Cameo=AHRVICON, [GI] Cameo=GIICON). Empty when the art section
    // carries none, in which case the portrait is <artkey>ICON.SHP.
    string cameo;
    int techLevel = 1;    // rules TechLevel=; -1 means "never buildable"

    string ArtKey() { return this.artKey; }
    void SetArtKey(string key) { this.artKey = key; }
    string Cameo() { return this.cameo; }
    void SetCameo(string c) { this.cameo = c; }
    void SetPrereqTokens(List<string> tokens) {
        this.prereq = new List<string>();
        for (int i = 0; i < tokens.Count; i = i + 1) {
            this.prereq.Add(tokens[i]);
        }
    }
    int TechLevel() { return this.techLevel; }
    void SetTechLevel(int l) { this.techLevel = l; }
    bool NewTheater() { return this.newTheater; }
    void SetNewTheater(bool on) { this.newTheater = on; }
    int ReadyStart() { return this.readyStart; }
    int WalkStart() { return this.walkStart; }
    int WalkFrames() { return this.walkFrames; }
    bool HasSeq() { return this.hasSeq; }
    int DeployedStart() { return this.deployedStart; }
    int DeployedFrames() { return this.deployedFrames; }
    bool HasDeployedSeq() { return this.hasDeployed; }
    void SetReadySeq(int start) {
        this.readyStart = start;
        this.hasSeq = true;
    }
    void SetWalkSeq(int start, int frames) {
        if (frames < 1) { frames = 1; }
        this.walkStart = start;
        this.walkFrames = frames;
        this.hasSeq = true;
    }
    void SetDeployedSeq(int start, int frames) {
        if (frames < 1) { frames = 1; }
        this.deployedStart = start;
        this.deployedFrames = frames;
        this.hasDeployed = true;
    }

    // The Deploy/Undeploy transition blocks and the DeployedFire pose,
    // copied to the world-side UnitType with the rest of the sequence set.
    bool hasDeploy;
    int deployStart;
    int deployFrames;
    bool hasUndeploy;
    int undeployStart;
    int undeployFrames;
    bool hasDeployedFire;
    int deployedFireStart;
    int deployedFireFrames;
    int deployedFireMult;

    bool HasDeploySeq() { return this.hasDeploy; }
    int DeployStart() { return this.deployStart; }
    int DeployFrames() { return this.deployFrames; }
    bool HasUndeploySeq() { return this.hasUndeploy; }
    int UndeployStart() { return this.undeployStart; }
    int UndeployFrames() { return this.undeployFrames; }
    bool HasDeployedFireSeq() { return this.hasDeployedFire; }
    int DeployedFireStart() { return this.deployedFireStart; }
    int DeployedFireFrames() { return this.deployedFireFrames; }
    int DeployedFireMult() { return this.deployedFireMult; }

    void SetDeploySeq(int start, int frames) {
        this.hasDeploy = true;
        this.deployStart = start;
        this.deployFrames = frames < 1 ? 1 : frames;
    }
    void SetUndeploySeq(int start, int frames) {
        this.hasUndeploy = true;
        this.undeployStart = start;
        this.undeployFrames = frames < 1 ? 1 : frames;
    }
    void SetDeployedFireSeq(int start, int frames, int mult) {
        this.hasDeployedFire = true;
        this.deployedFireStart = start;
        this.deployedFireFrames = frames < 1 ? 1 : frames;
        this.deployedFireMult = mult;
    }
    // Firing pose and the two death sequences, from the same section
    // (GISequence FireUp=156,6,6, Die1=244,10,6, Die2=340,10,6): the fire
    // block plays once per shot, the death block once, ending on the
    // fallen pose the corpse keeps.
    int fireStart;
    int fireFrames = 6;
    int fireMult = 6;
    bool hasFire;
    int die1Start;
    int die1Frames = 10;
    int die1Mult;
    bool hasDie1;
    int die2Start;
    int die2Frames = 10;
    int die2Mult;
    bool hasDie2;
    bool HasFire() { return this.hasFire; }
    int FireStart() { return this.fireStart; }
    int FireFrames() { return this.fireFrames; }
    int FireMult() { return this.fireMult; }
    bool HasDie1() { return this.hasDie1; }
    int Die1Start() { return this.die1Start; }
    int Die1Frames() { return this.die1Frames; }
    int Die1Mult() { return this.die1Mult; }
    bool HasDie2() { return this.hasDie2; }
    int Die2Start() { return this.die2Start; }
    int Die2Frames() { return this.die2Frames; }
    int Die2Mult() { return this.die2Mult; }
    // The sequence's third number is the facing multiplier: the frame
    // block repeats per facing with this stride (6 for a walk cycle, 0
    // for a shared sequence like Die1, 1 for the one-frame poses).
    void SetFireSeq(int start, int frames, int mult) {
        if (frames < 1) { frames = 1; }
        this.fireStart = start;
        this.fireFrames = frames;
        this.fireMult = mult;
        this.hasFire = true;
    }
    void SetDie1Seq(int start, int frames, int mult) {
        if (frames < 1) { frames = 1; }
        this.die1Start = start;
        this.die1Frames = frames;
        this.die1Mult = mult;
        this.hasDie1 = true;
    }
    void SetDie2Seq(int start, int frames, int mult) {
        if (frames < 1) { frames = 1; }
        this.die2Start = start;
        this.die2Frames = frames;
        this.die2Mult = mult;
        this.hasDie2 = true;
    }
    // The prone family, flattened (Prone, Crawl, Down, Up, FireProne) --
    // start,frames,mult per block, frames 0 for a block the art omits.
    List<int> proneSeqs;
    bool HasProne() { return this.proneSeqs != null
                   && this.proneSeqs.Count >= 15; }
    int ProneAt(int i) { return this.proneSeqs[i]; }
    void SetProneSeqs(List<int> flat) {
        this.proneSeqs = new List<int>();
        for (int i = 0; i < 15; i = i + 1) {
            this.proneSeqs.Add(i < flat.Count ? flat[i] : 0);
        }
    }

    /// <summary>Cells the unit covers per tick. RA2's speed classes map to
    /// foot soldiers at one cell and fast movers (dogs, terror drones) at
    /// two.</summary>
    int Steps() {
        int s = this.speed / 4;
        if (s < 1) { s = 1; }
        return s;
    }
}

/// <summary>Special behaviours a unit can carry in place of a gun.</summary>
class UnitRole {
    static int None() { return 0; }
    static int Engineer() { return 1; }   // captures the building he reaches
    static int Spy() { return 2; }        // infiltrates: steals or blackouts
    static int Harvester() { return 3; }  // mines ore, unloads at a refinery
}

/// <summary>What a building is: footprint, health, cost, its power ledger
/// entry, its gun if it has one, and the tech it needs before the sidebar
/// offers it. Refineries (and captured oil derricks) are the economy: they
/// trickle credits every tick, replacing any passive income.</summary>
class BuildingDef {
    List<string> damageParticles; // DamageParticleSystems= (smoke gate)
    int smokeOffX;                // DamageSmokeOffset= x, 256ths of a cell
    int smokeOffY;                // DamageSmokeOffset= y
    string reg;        // GACNST, NAPOWR, ...
    string label;
    string shp;
    int fw;
    int fh;
    int hp;
    int cost;
    int power;         // supplied when built (plants)
    int drain;         // consumed while operating
    int armor;         // ArmorClass
    Weapon weapon;     // null = no gun
    bool powered;      // needs a positive power balance to work (defences)
    bool refinery;     // hands out a free harvester on completion
    int sideMask;      // 1 allied, 2 soviet, 4 neutral civilian
    List<string> prereq;
    string artKey;     // art ini section: the Image= override or the regkey
    bool newTheater;   // art ships one SHP per theater, second letter swaps
    string cameo;      // art.ini Cameo= key: the sidebar portrait's SHP stem
    int techLevel = 1; // rules TechLevel=; -1 means "never buildable"
    // rules WaterBound=: the structure floats, so its footprint must be water
    // instead of ground. Only the shipyard carries it in the shipped rules.
    bool waterBound;

    // The TechnoRules voice keys, sound.ini names from the install's own
    // section (buildings answer selection like units do).
    TechnoVoices voices;

    // The sight range in cells, the shipped rules' Sight= key (capped at
    // 11, default 1). Drives the shroud reveal circle.
    int sight;

    // The shipped rules' ConstructionYard= key (BuildingRules, default no):
    // the free-MCV crate branch checks the owner still has one standing
    // before it hands out a replacement MCV.
    bool conYard;

    static BuildingDef Create(string reg, string label, string shp, int fw,
                              int fh, int hp, int cost, int power, int drain,
                              int armor, int sideMask) {
        BuildingDef d = new BuildingDef();
        d.reg = reg;
        d.label = label;
        d.shp = shp;
        d.fw = fw;
        d.fh = fh;
        d.hp = hp;
        d.cost = cost;
        d.power = power;
        d.drain = drain;
        d.armor = armor;
        d.weapon = null;
        d.powered = false;
        d.refinery = false;
        d.waterBound = false;
        d.sight = 1;
        d.conYard = false;
        d.sideMask = sideMask;
        d.prereq = new List<string>();
        d.artKey = reg;
        d.newTheater = false;
        d.voices = TechnoVoices.Create();
        return d;
    }

    string Reg() { return this.reg; }
    string Label() { return this.label; }
    string Shp() { return this.shp; }
    void SetShp(string shp) { this.shp = shp; }
    TechnoVoices Voices() { return this.voices; }
    bool IsConYard() { return this.conYard; }
    void SetConYard(bool on) { this.conYard = on; }
    string ArtKey() { return this.artKey; }
    void SetArtKey(string key) { this.artKey = key; }
    string Cameo() { return this.cameo; }
    void SetCameo(string cameo) { this.cameo = cameo; }
    bool NewTheater() { return this.newTheater; }
    void SetNewTheater(bool on) { this.newTheater = on; }
    int FootprintW() { return this.fw; }
    int FootprintH() { return this.fh; }
    void SetFootprint(int w, int h) {
        if (w > 0) { this.fw = w; }
        if (h > 0) { this.fh = h; }
    }
    int Hp() { return this.hp; }
    int Cost() { return this.cost; }
    int Power() { return this.power; }
    int Drain() { return this.drain; }
    int Armor() { return this.armor; }
    Weapon Weapon() { return this.weapon; }
    bool Powered() { return this.powered; }
    bool IsRefinery() { return this.refinery; }
    bool WaterBound() { return this.waterBound; }
    void SetWaterBound(bool on) { this.waterBound = on; }
    int Sight() { return this.sight; }
    void SetSight(int v) { this.sight = v; }
    List<string> DamageParticles() { return this.damageParticles; }
    void SetDamageParticles(List<string> v) { this.damageParticles = v; }
    int SmokeOffX() { return this.smokeOffX; }
    void SetSmokeOffX(int v) { this.smokeOffX = v; }
    int SmokeOffY() { return this.smokeOffY; }
    void SetSmokeOffY(int v) { this.smokeOffY = v; }
    int SideMask() { return this.sideMask; }
    List<string> Prereq() { return this.prereq; }
    /// <summary>Replaces the built-in prereq tokens with the install's own
    /// Prerequisite= line. The shipped tree is what gates the sidebar -- most
    /// importantly every structure names GACNST, so nothing can be built
    /// before the MCV has been unfolded into a construction yard.</summary>
    void SetPrereqTokens(List<string> tokens) {
        this.prereq = new List<string>();
        for (int i = 0; i < tokens.Count; i = i + 1) {
            this.prereq.Add(tokens[i]);
        }
    }
    int TechLevel() { return this.techLevel; }
    void SetTechLevel(int l) { this.techLevel = l; }
    void SetWeapon(Weapon w) { this.weapon = w; }
    void SetPowered(bool on) { this.powered = on; }
    void SetRefinery(bool on) { this.refinery = on; }
    void AddPrereq(string token) { this.prereq.Add(token); }
    void SetCost(int cost) { this.cost = cost; }
    void SetHp(int hp) { this.hp = hp; }
    void SetPower(int power) { this.power = power; }
    void SetDrain(int drain) { this.drain = drain; }
    void SetLabel(string label) { this.label = label; }
}

/// <summary>The whole ruleset: every warhead, weapon, soldier and building of
/// the ground war, the tech-tree aliases, the AI's build lists and the economy
/// constants. The defaults are the real RA2 numbers transcribed, so a game
/// without an install (the tests) plays with exactly the balance the shipped
/// RULES.INI describes; with an install, Load() re-reads that very file and
/// overrides whatever it still defines.</summary>
class Rules {
    List<Warhead> warheads;
    List<Weapon> weapons;
    List<ProjectileType> projectiles;
    List<string> splashList;   // [CombatDamage] SplashList: water impact art
    double gravity;
    bool alternateArcticArt;   // [General] AlternateArcticArt: A-suffix art
    List<string> fireTypes;    // [AudioVisual] DamageFireTypes: burning
                               // buildings pick one of these at random            // ini Gravity= (leptons/tick²), retail 6
    List<string> deadBodies;   // [AudioVisual] DeadBodies: the corpse
                               // anims a fallen trooper leaves (retail
                               // DEATH_A..DEATH_F)
    string infantryExplode = "S_BANG34";   // InfDeath ExplodeAlt
    string flamingInfantry = "FLAMEGUY";   // InfDeath Fire
    string infantryHeadPop = "YURIDIE";    // InfDeath HeadExplode
    string infantryNuked = "NUKEDIE";      // InfDeath Nuke
    string infantryVirus = "VIRUSD";       // InfDeath Virus
    string infantryMutate = "GENDEATH";    // InfDeath Mutate
    string infantryBrute = "BRUTDIE";      // InfDeath Brute
    string electroAnim;        // the [Animations] list's 2nd entry: the
                               // InfDeath Electro death anim (retail ELECTRO)
    int conditionYellow = 50;  // [AudioVisual] ConditionYellow=%: at or
                               // below this share of health a building
                               // shows its damaged frame (retail 50)
    int conditionRed = 25;     // [AudioVisual] ConditionRed=%: drives the
                               // fire state, not another sprite frame
    int proneDamagePct = 100;  // [General] ProneDamage=, the damage share
                               // a prone trooper takes (retail default 1.0)
    List<UnitDef> units;
    List<BuildingDef> buildings;   // both sides interleaved, menu order per side
    List<BuildingDef> civs;        // neutral structures from the map
    CsfTable strings;              // the install's UI text, or null

    // Tech-tree aliases, the [General] Prerequisite* lists.
    List<string> preqPower;
    List<string> preqFactory;
    List<string> preqBarracks;
    List<string> preqRadar;
    List<string> preqTech;
    List<string> preqProc;

    // The [AI] build lists.
    List<string> aiConst;
    List<string> aiPower;
    List<string> aiRefinery;
    List<string> aiBarracks;
    List<string> aiWeapons;
    List<string> aiTech;
    List<string> aiRadar;
    List<string> aiDefense;

    // Economy.
    int startMoney;
    int oilIncome;        // credits per captured oil derrick per tick
    int oilCapture;       // one-shot bonus for grabbing an oil derrick
    int bombDamage;       // Ivan's bomb
    int bombDelay;        // ticks before Ivan's bomb goes off
    int splashScale;      // splash damage at the impact point, % of direct dmg
    int blackoutTicks;    // spy-infiltrated power plant downtime
    int freezeTicks;      // chrono-beam freeze duration
    int refundPercent;    // sell refund, percent of the building's cost
    int repairPercent;    // full repair cost, percent of the full price
    int repairStep;       // hit points one repair step heals
    int repairRateTicks;  // ticks between repair steps

    // The [OverlayTypes] list, in rules order: the names the map overlay
    // plane's byte values index into. The GEM* entries are RA2's ore fields.
    List<string> overlayTypes;

    // The [SmudgeTypes] table: the decal regs a blast can leave on the
    // ground (craters, burn marks), in rules order. Each reg's own section
    // carries the facts the reference's SmudgeRules parses -- Burn=, Crater=,
    // Width= and Height= (both default 1) -- read here into parallel lists.
    List<string> smudgeTypes;
    List<int> smudgeBurn;
    List<int> smudgeCrater;
    List<int> smudgeWidth;
    List<int> smudgeHeight;

    // Art flag lookups for the impact animations (the reference reads
    // Crater=/Scorch=/ForceBigCraters= off each animation's art section).
    // Animations repeat every shot, so the parse caches: names seen and
    // their bits -- 1 crater, 2 scorch, 4 force-big-craters.
    List<string> animFlagNames;
    List<int> animFlagBits;

    // Ore regrowth, the shipped [General] TiberiumGrows / TiberiumSpreads /
    // GrowthRate keys: whether fields richen and spread, and how many
    // minutes pass between growth passes.
    bool oreGrows;
    bool oreSpreads;
    int growthRate;

    // ---- the goodie crates -------------------------------------------------
    // The [General] crate keys and the [Powerups] table (the reference's
    // CrateRules + PowerupsRules): how many crates the field carries, what
    // they look like on land and water, and the weighted powerup table the
    // roll draws from. Shares weight the roll, the anim names the pickup
    // flourish, Water= gates the sea crates, Data= the payload.
    int crateMaximum;
    int crateMinimum;
    int crateRadius;
    int crateRegen;
    string unitCrateType;   // null = roll the CrateGoodie vehicles instead
    string crateImg;        // the land crate overlay reg (CRATE1)
    string waterCrateImg;   // the water crate overlay reg (CRATE2)
    bool freeMCV;
    List<int> powerupTypes;
    List<int> powerupShares;
    List<string> powerupAnims;
    List<bool> powerupWater;
    List<string> powerupData;

    // The explosion crate's warheads, the [CombatDamage] C4Warhead /
    // FlameDamage keys -- the reference stores them as the ini's warhead
    // name strings and looks them up by name at the crate. The shipped ini
    // supplies the names; this port's transcription has no fire warhead
    // yet, so both default to the general-purpose HE.
    string c4Warhead = "HE";
    string flameDamage = "HE";

    // The neutral scenery units: the civilian vehicles and animals the
    // official maps park and scatter ([Units]/[Infantry] entries owned by
    // Neutral). They sit outside the three build rosters -- a map's cars and
    // cows are never trainable -- so they get their own list, mirroring how
    // civs holds the untrainable civilian structures. Art is the reg's own
    // name (every one of these is Voxel=yes or a plain SHP with no Image=
    // override), so nothing but the stats and a name is needed here.
    List<UnitDef> civUnits;

    // The install's own ini documents, kept so map-object discovery can read
    // them after loading (see MapObjectUnitType). Null when the game runs on
    // the transcribed defaults alone.
    IniDocument sourceIni;
    IniDocument artIni;

    static Rules Create() {
        Rules r = new Rules();
        r.warheads = new List<Warhead>();
        r.weapons = new List<Weapon>();
        r.projectiles = new List<ProjectileType>();
        r.splashList = new List<string>();
        r.fireTypes = new List<string>();
        r.gravity = 6.0;
        r.units = new List<UnitDef>();
        r.buildings = new List<BuildingDef>();
        r.civs = new List<BuildingDef>();
        r.civUnits = new List<UnitDef>();
        r.overlayTypes = new List<string>();
        r.oreGrows = true;
        r.oreSpreads = true;
        r.growthRate = 5;
        r.crateMaximum = 5;
        r.crateMinimum = 1;
        r.crateRadius = 2;
        r.crateRegen = 1;
        r.unitCrateType = null;
        r.crateImg = "CRATE1";
        r.waterCrateImg = "CRATE2";
        r.freeMCV = true;
        r.powerupTypes = new List<int>();
        r.powerupShares = new List<int>();
        r.powerupAnims = new List<string>();
        r.powerupWater = new List<bool>();
        r.powerupData = new List<string>();
        r.DefaultPowerups();
        r.bridgeStrength = 1500;
        return r;
    }

    // ---- lookups -----------------------------------------------------------

    List<Warhead> Warheads() { return this.warheads; }
    /// <summary>The [Warheads] entry a name addresses -- the crate
    /// powerups pick their warheads by name (the [CombatDamage] C4Warhead /
    /// FlameDamage keys), the reference's rules.getWarhead.</summary>
    Warhead WarheadByName(string reg) {
        if (reg == null || reg.Length == 0) { return null; }
        for (int i = 0; i < this.warheads.Count; i = i + 1) {
            if (this.warheads[i].Name() == reg) { return this.warheads[i]; }
        }
        return null;
    }
    List<Weapon> Weapons() { return this.weapons; }
    List<UnitDef> Units() { return this.units; }
    List<BuildingDef> Buildings() { return this.buildings; }
    List<BuildingDef> Civs() { return this.civs; }
    List<UnitDef> CivUnits() { return this.civUnits; }
    List<string> PreqPower() { return this.preqPower; }
    List<string> PreqFactory() { return this.preqFactory; }
    List<string> PreqBarracks() { return this.preqBarracks; }
    List<string> PreqRadar() { return this.preqRadar; }
    List<string> PreqTech() { return this.preqTech; }
    List<string> PreqProc() { return this.preqProc; }
    List<string> AiConst() { return this.aiConst; }
    List<string> AiPower() { return this.aiPower; }
    List<string> AiRefinery() { return this.aiRefinery; }
    List<string> AiBarracks() { return this.aiBarracks; }
    List<string> AiWeapons() { return this.aiWeapons; }
    List<string> AiTech() { return this.aiTech; }
    List<string> AiRadar() { return this.aiRadar; }
    List<string> AiDefense() { return this.aiDefense; }
    int StartMoney() { return this.startMoney; }
    int OilIncome() { return this.oilIncome; }
    int OilCapture() { return this.oilCapture; }
    int BombDamage() { return this.bombDamage; }
    int BombDelay() { return this.bombDelay; }
    int SplashScale() { return this.splashScale; }
    int BlackoutTicks() { return this.blackoutTicks; }
    int FreezeTicks() { return this.freezeTicks; }
    int RefundPercent() { return this.refundPercent; }
    int RepairPercent() { return this.repairPercent; }
    int RepairStep() { return this.repairStep; }
    int RepairRateTicks() { return this.repairRateTicks; }
    int CrateMaximum() { return this.crateMaximum; }
    int CrateMinimum() { return this.crateMinimum; }
    int CrateRadius() { return this.crateRadius; }
    int CrateRegen() { return this.crateRegen; }
    string UnitCrateType() { return this.unitCrateType; }
    string CrateImg() { return this.crateImg; }
    string WaterCrateImg() { return this.waterCrateImg; }
    bool FreeMCV() { return this.freeMCV; }
    string C4Warhead() { return this.c4Warhead; }
    string FlameDamage() { return this.flameDamage; }
    int PowerupCount() { return this.powerupTypes.Count; }
    int PowerupTypeAt(int i) { return this.powerupTypes[i]; }
    int PowerupSharesAt(int i) { return this.powerupShares[i]; }
    string PowerupAnimsAt(int i) { return this.powerupAnims[i]; }
    bool PowerupWaterAt(int i) { return this.powerupWater[i]; }
    string PowerupDataAt(int i) { return this.powerupData[i]; }

    /// <summary>The shipped rules' PowerupType order: the enum the
    /// [Powerups] table's keys name and the crate grant switches on.</summary>
    static int PowerupArmor() { return 0; }
    static int PowerupFirepower() { return 1; }
    static int PowerupHealBase() { return 2; }
    static int PowerupMoney() { return 3; }
    static int PowerupReveal() { return 4; }
    static int PowerupSpeed() { return 5; }
    static int PowerupVeteran() { return 6; }
    static int PowerupUnit() { return 7; }
    static int PowerupInvulnerability() { return 8; }
    static int PowerupIonStorm() { return 9; }
    static int PowerupGas() { return 10; }
    static int PowerupTiberium() { return 11; }
    static int PowerupPod() { return 12; }
    static int PowerupCloak() { return 13; }
    static int PowerupDarkness() { return 14; }
    static int PowerupExplosion() { return 15; }
    static int PowerupICBM() { return 16; }
    static int PowerupNapalm() { return 17; }
    static int PowerupSquad() { return 18; }

    /// <summary>A [Powerups] key to its PowerupType, or -1 when the key is
    /// not one of the shipped names.</summary>
    static int PowerupTypeOf(string name) {
        if (name == null) { return 0 - 1; }
        string n = name.Trim().ToUpper();
        if (n == "ARMOR") { return PowerupArmor(); }
        if (n == "FIREPOWER") { return PowerupFirepower(); }
        if (n == "HEALBASE") { return PowerupHealBase(); }
        if (n == "MONEY") { return PowerupMoney(); }
        if (n == "REVEAL") { return PowerupReveal(); }
        if (n == "SPEED") { return PowerupSpeed(); }
        if (n == "VETERAN") { return PowerupVeteran(); }
        if (n == "UNIT") { return PowerupUnit(); }
        if (n == "INVULNERABILITY") { return PowerupInvulnerability(); }
        if (n == "IONSTORM") { return PowerupIonStorm(); }
        if (n == "GAS") { return PowerupGas(); }
        if (n == "TIBERIUM") { return PowerupTiberium(); }
        if (n == "POD") { return PowerupPod(); }
        if (n == "CLOAK") { return PowerupCloak(); }
        if (n == "DARKNESS") { return PowerupDarkness(); }
        if (n == "EXPLOSION") { return PowerupExplosion(); }
        if (n == "ICBM") { return PowerupICBM(); }
        if (n == "NAPALM") { return PowerupNapalm(); }
        if (n == "SQUAD") { return PowerupSquad(); }
        return 0 - 1;
    }

    /// <summary>The retail [Powerups] table, transcribed: the shipped
    /// shares, anims, water gates and payloads. The four systems this port
    /// has not migrated -- IonStorm, Gas, Pod, Squad -- are simply absent,
    /// the same crates the reference's UNSUPPORTED_POWERUP_TYPES skips.</summary>
    void DefaultPowerups() {
        this.InstallPowerup(PowerupArmor(), 30, null, false, "2");
        this.InstallPowerup(PowerupFirepower(), 30, null, false, "2");
        this.InstallPowerup(PowerupHealBase(), 30, null, false, "0");
        this.InstallPowerup(PowerupMoney(), 100, null, false, "10000");
        this.InstallPowerup(PowerupReveal(), 30, null, false, "0");
        this.InstallPowerup(PowerupSpeed(), 30, null, false, "2");
        this.InstallPowerup(PowerupVeteran(), 30, null, false, "1");
        this.InstallPowerup(PowerupUnit(), 100, null, false, "0");
        this.InstallPowerup(PowerupInvulnerability(), 2, null, false, "0");
        this.InstallPowerup(PowerupICBM(), 2, null, false, "0");
        this.InstallPowerup(PowerupExplosion(), 10, "CRATEEXPLODE", false,
                            "500");
        this.InstallPowerup(PowerupNapalm(), 10, "CRATENAPALM", false, "600");
        this.InstallPowerup(PowerupTiberium(), 30, null, true, "0");
    }

    void InstallPowerup(int type, int shares, string anim, bool water,
                        string data) {
        this.powerupTypes.Add(type);
        this.powerupShares.Add(shares);
        this.powerupAnims.Add(anim);
        this.powerupWater.Add(water);
        this.powerupData.Add(data);
    }

    /// <summary>The [OverlayTypes] name at an index -- "GEM01" for the first
    /// ore overlay -- or "" when the index is out of range. The render layer
    /// uses it to find the overlay's art file.</summary>
    string OverlayName(int idx) {
        if (idx < 0 || idx >= this.overlayTypes.Count) { return ""; }
        return this.overlayTypes[idx];
    }

    /// <summary>Whether a map overlay index carries ore: its [OverlayTypes]
    /// name begins with GEM (RA2 has no separate ORE_* types). Unknown
    /// indices are never ore.</summary>
    bool IsOreOverlay(int idx) {
        if (idx < 0 || idx >= this.overlayTypes.Count) { return false; }
        string name = this.overlayTypes[idx];
        if (name.Length < 3) { return false; }
        return (name[0] & 0xDF) == 'G' && (name[1] & 0xDF) == 'E'
            && (name[2] & 0xDF) == 'M';
    }

    // Tiberium overlay union, cached like the wall facts: the GEM* names
    // the port already treats as ore, plus every type whose own section
    // declares Tiberium=yes (the TIB01..12 fields the reference's growth
    // spawns). -1 not looked up, 0 no, 1 yes.
    List<int> overlayTibCache;

    // Land= / NoUseTileLandType= per overlay type, cached: low byte the
    // LandType value (255 = none declared), bit 8 the NoUseTileLandType
    // flag. A static overlay with both overrides the tile's own land class
    // -- that is what makes a fence or a sand-rock impassable and a low
    // bridge driveable over water (the reference's tile-land rules).
    List<int> overlayLandCache;

    // Terrain growth facts per terrain type name, cached like the overlay
    // tables: the cooldown in ticks between spawn rolls for the types that
    // declare SpawnsTiberium=yes (TIBTRE01..03, AnimationProbability .003
    // -> 333 ticks), -1 for everything else. The reference's TerrainRules
    // reads the same keys; a probability of zero never fires, exactly as
    // the reference's floor(1/0) idle does.
    List<string> terrainGrowNames;
    List<int> terrainGrowCds;

    // The [CombatDamage] BridgeStrength: every bridge piece's hit points
    // (1500 shipped). A field default so the transcribed rules stand alone.
    int bridgeStrength;

    /// <summary>How many smudge regs the [SmudgeTypes] table holds.</summary>
    int SmudgeRegCount() { return this.smudgeTypes == null ? 0 : this.smudgeTypes.Count; }

    /// <summary>The smudge reg name at an index, uppercased at parse.</summary>
    string SmudgeRegAt(int idx) {
        if (idx < 0 || idx >= this.SmudgeRegCount()) { return ""; }
        return this.smudgeTypes[idx];
    }

    bool SmudgeBurnAt(int idx) {
        return idx >= 0 && idx < this.SmudgeRegCount() && this.smudgeBurn[idx] == 1;
    }

    bool SmudgeCraterAt(int idx) {
        return idx >= 0 && idx < this.SmudgeRegCount() && this.smudgeCrater[idx] == 1;
    }

    int SmudgeWidthAt(int idx) {
        return idx >= 0 && idx < this.SmudgeRegCount() ? this.smudgeWidth[idx] : 1;
    }

    int SmudgeHeightAt(int idx) {
        return idx >= 0 && idx < this.SmudgeRegCount() ? this.smudgeHeight[idx] : 1;
    }

    /// <summary>The smudge reg index for a name -- "CRATER12" -> its
    /// [SmudgeTypes] slot -- or -1 when the table carries no such reg.</summary>
    int SmudgeRegIndex(string name) {
        if (name == null || name.Length == 0) { return 0 - 1; }
        string key = name.ToUpper();
        for (int i = 0; i < this.SmudgeRegCount(); i = i + 1) {
            if (this.smudgeTypes[i] == key) { return i; }
        }
        return 0 - 1;
    }

    /// <summary>An impact animation's art flags: bit 0 the Crater= decal
    /// gate, bit 1 Scorch= (burn regs join the crater pick), bit 2
    /// ForceBigCraters= (the 2x2 crater size). The reference reads the same
    /// three off the animation's art section (ObjectArt.ts:230-232); a
    /// section that does not exist carries none. Parsed once per name --
    /// blasts repeat every shot.</summary>
    int AnimArtFlags(string name) {
        if (name == null || name.Length == 0) { return 0; }
        string key = name.ToUpper();
        if (this.animFlagNames != null) {
            for (int i = 0; i < this.animFlagNames.Count; i = i + 1) {
                if (this.animFlagNames[i] == key) { return this.animFlagBits[i]; }
            }
        }
        int bits = 0;
        if (this.artIni != null) {
            IniSection sec = this.artIni.Section(key);
            if (sec != null) {
                if (Rules.YesNo(sec.GetOr("Crater", "no"))) { bits = bits + 1; }
                if (Rules.YesNo(sec.GetOr("Scorch", "no"))) { bits = bits + 2; }
                if (Rules.YesNo(sec.GetOr("ForceBigCraters", "no"))) { bits = bits + 4; }
            }
        }
        if (this.animFlagNames == null) {
            this.animFlagNames = new List<string>();
            this.animFlagBits = new List<int>();
        }
        this.animFlagNames.Add(key);
        this.animFlagBits.Add(bits);
        return bits;
    }

    /// <summary>Whether a map overlay index carries tiberium: a GEM name,
    /// or its own section declares Tiberium=yes. Unknown indices never
    /// do.</summary>
    bool IsTiberiumOverlay(int idx) {
        if (idx < 0 || idx >= this.overlayTypes.Count) { return false; }
        if (this.overlayTibCache == null) {
            this.overlayTibCache = new List<int>();
        }
        while (this.overlayTibCache.Count <= idx) {
            this.overlayTibCache.Add(0 - 1);
        }
        int cached = this.overlayTibCache[idx];
        if (cached >= 0) { return cached == 1; }
        bool tib = this.IsOreOverlay(idx)
            || Rules.YesNo(this.SourceIniSection(this.overlayTypes[idx])
                .GetOr("Tiberium", "no"));
        this.overlayTibCache[idx] = tib ? 1 : 0;
        return tib;
    }

    /// <summary>The overlay type's land override, packed as the caches
    /// above document. The reference's OverlayRules reads Land= and
    /// NoUseTileLandType= off the same section.</summary>
    int OverlayLandFlags(int idx) {
        if (idx < 0 || idx >= this.overlayTypes.Count) { return 255; }
        if (this.overlayLandCache == null) {
            this.overlayLandCache = new List<int>();
        }
        while (this.overlayLandCache.Count <= idx) {
            this.overlayLandCache.Add(0 - 1);
        }
        int cached = this.overlayLandCache[idx];
        if (cached >= 0) { return cached; }
        IniSection s = this.SourceIniSection(this.overlayTypes[idx]);
        bool noTile = s.Get("NoUseTileLandType").Length > 0;
        int land = Rules.LandFromName(s.Get("Land"));
        int packed = (land >= 0 ? land : 255) | (noTile ? 256 : 0);
        this.overlayLandCache[idx] = packed;
        return packed;
    }

    /// <summary>A rules Land= name to its LandType value, -1 when the name
    /// is empty or unknown (the reference's enum lookup raises; a renderer
    /// and a movement grid must keep going).</summary>
    static int LandFromName(string nm) {
        if (nm == null) { return 0 - 1; }
        string s = nm.ToUpper();
        if (s == "CLEAR") { return LandType.Clear(); }
        if (s == "ROAD") { return LandType.Road(); }
        if (s == "ROCK") { return LandType.Rock(); }
        if (s == "BEACH") { return LandType.Beach(); }
        if (s == "ROUGH") { return LandType.Rough(); }
        if (s == "RAILROAD") { return LandType.Railroad(); }
        if (s == "WEEDS") { return LandType.Weeds(); }
        if (s == "WATER") { return LandType.Water(); }
        if (s == "WALL") { return LandType.Wall(); }
        if (s == "TIBERIUM") { return LandType.Tiberium(); }
        if (s == "CLIFF") { return LandType.Cliff(); }
        return 0 - 1;
    }

    /// <summary>Ticks between spawn rolls for a terrain type that grows
    /// tiberium (SpawnsTiberium=yes), from its AnimationProbability: the
    /// reference's floor(1/prob). -1 when the type grows nothing or the
    /// probability is zero (a zero prob never fires in the reference
    /// either -- floor(1/0) never counts up to it).</summary>
    int TerrainGrowthTicks(string name) {
        if (name == null || name.Length == 0) { return 0 - 1; }
        if (this.terrainGrowNames == null) {
            this.terrainGrowNames = new List<string>();
            this.terrainGrowCds = new List<int>();
        }
        for (int i = 0; i < this.terrainGrowNames.Count; i = i + 1) {
            if (this.terrainGrowNames[i] == name) {
                return this.terrainGrowCds[i];
            }
        }
        IniSection s = this.SourceIniSection(name);
        int cd = 0 - 1;
        if (Rules.YesNo(s.GetOr("SpawnsTiberium", "no"))) {
            // ".003" parses as 0 in a bare atof; give it the leading zero.
            string pv = s.GetOr("AnimationProbability", "0").Trim();
            if (pv.Length > 0 && pv[0] == 46) { pv = "0" + pv; }
            double p = pv.Length > 0 ? Convert.ToDouble(pv) : 0.0;
            if (p > 0) { cd = (int)Math.Floor(1.0 / p); }
        }
        this.terrainGrowNames.Add(name);
        this.terrainGrowCds.Add(cd);
        return cd;
    }

    int BridgeStrength() { return this.bridgeStrength; }

    // Overlay wall facts, read from the type's own rules section and
    // cached: -1 not looked up, 0 no, 1 yes.
    List<int> overlayWallCache;

    /// <summary>How many [OverlayTypes] the rules name.</summary>
    int OverlayTypeCount() { return this.overlayTypes.Count; }

    /// <summary>Whether a map overlay index is a wall (its rules section
    /// declares Wall=yes: the Allied/Soviet concrete walls, sandbags,
    /// fences). The reference's OverlayRules reads the same key.</summary>
    bool IsWallOverlay(int idx) {
        if (idx < 0 || idx >= this.overlayTypes.Count) { return false; }
        if (this.overlayWallCache == null) {
            this.overlayWallCache = new List<int>();
        }
        while (this.overlayWallCache.Count <= idx) {
            this.overlayWallCache.Add(0 - 1);
        }
        int cached = this.overlayWallCache[idx];
        if (cached >= 0) { return cached == 1; }
        bool wall = Rules.YesNo(this.SourceIniSection(
            this.overlayTypes[idx]).GetOr("Wall", "no"));
        this.overlayWallCache[idx] = wall ? 1 : 0;
        return wall;
    }

    /// <summary>The overlay type's own section, or an empty one when the
    /// rules never named it (the DUMMY filler types).</summary>
    IniSection SourceIniSection(string name) {
        if (this.sourceIni == null || name == null || name.Length == 0) {
            return IniSection.Create("");
        }
        IniSection s = this.sourceIni.Section(name);
        return s != null ? s : IniSection.Create("");
    }

    /// <summary>A wall overlay's hit points, from its rules Strength=
    /// (the shipped concrete walls carry 300). The reference's
    /// OverlayRules defaults 0, and so do we.</summary>
    int OverlayStrength(int idx) {
        if (idx < 0 || idx >= this.overlayTypes.Count) { return 0; }
        return this.SourceIniSection(this.overlayTypes[idx])
            .GetIntOr("Strength", 0);
    }

    /// <summary>A wall overlay's armour class, from its Armor= (the shipped
    /// walls are concrete). The reference resolves unknown names to None.</summary>
    int OverlayArmor(int idx) {
        if (idx < 0 || idx >= this.overlayTypes.Count) {
            return ArmorClass.None();
        }
        return ArmorClass.Parse(this.SourceIniSection(this.overlayTypes[idx])
            .GetOr("Armor", ""));
    }

    /// <summary>Credits one unit of an overlay's ore is worth. The first six
    /// GEM overlays are plain gold ore, the last six the sparkly crystal
    /// fields the original pays double for.</summary>
    int OreValue(int idx) {
        // The growth's own fields are Riparius -- plain gold ore, worth 25
        // a bail like the shipped [Riparius] Value=.
        if (idx >= 102 && idx <= 113) { return 1; }
        int first = this.FirstOreOverlay();
        if (first < 0 || idx < first + 6) { return 1; }
        return 2;
    }

    /// <summary>The lowest ore overlay index, -1 when the rules list none.</summary>
    int FirstOreOverlay() {
        for (int i = 0; i < this.overlayTypes.Count; i = i + 1) {
            if (this.IsOreOverlay(i)) { return i; }
        }
        return -1;
    }

    bool OreGrows() { return this.oreGrows; }
    bool OreSpreads() { return this.oreSpreads; }

    /// <summary>Minutes between ore growth passes, the shipped GrowthRate.</summary>
    int GrowthRateMinutes() { return this.growthRate; }

    /// <summary>The movement ledger's cell price, the reference's
    /// CELL_MOVE_COST: a unit banks its rules Speed every tick and steps one
    /// cell whenever the bank reaches this.</summary>
    static int CellMoveCost() { return 64; }

    /// <summary>An INI boolean: yes/true/1 are on, anything else off.</summary>
    static bool YesNo(string v) {
        if (v == null || v.Length == 0) { return false; }
        int c = v[0] & 0xDF;
        return c == 'Y' || c == 'T' || v[0] == '1';
    }

    /// <summary>The leading integer of a value like "5" or "5.0 minutes",
    /// 0 when none. INI growth rates are written both ways.</summary>
    static int LeadingInt(string v) {
        if (v == null) { return 0; }
        int at = 0;
        while (at < v.Length && (v[at] == 32 || v[at] == 9)) { at = at + 1; }
        int sign = 1;
        if (at < v.Length && (v[at] == 45 || v[at] == 43)) {
            if (v[at] == 45) { sign = -1; }
            at = at + 1;
        }
        int n = 0;
        while (at < v.Length && v[at] >= 48 && v[at] <= 57) {
            n = n * 10 + (v[at] - 48);
            at = at + 1;
        }
        return n * sign;
    }

    Warhead WarheadNamed(string name) {
        string key = name.ToUpper();
        for (int i = 0; i < this.warheads.Count; i = i + 1) {
            if (this.warheads[i].Name() == name
             || this.warheads[i].Name() == key) {
                return this.warheads[i];
            }
        }
        // Warheads outside the pre-seeded catalog (the absolute-damage
        // [Super] among them) resolve from their own rules section, the
        // way WeaponNamed resolves its roster-external guns.
        IniDocument ini = this.sourceIni;
        if (ini == null) { return null; }
        IniSection s = ini.Section(name);
        if (s == null) { s = ini.Section(key); }
        if (s == null) { return null; }
        Warhead w = Warhead.Create(key, s.Get("Verses"));
        if (s.Contains("CellSpread")) {
            w.SetSpread(s.GetIntOr("CellSpread", 0));
        }
        if (s.Contains("ElectricAssault")) {
            w.SetElectricAssault(Rules.YesNo(s.Get("ElectricAssault")));
        }
        if (s.Contains("InfDeath")) {
            w.SetInfDeath(Rules.LeadingInt(s.Get("InfDeath")));
        }
        string anims = s.Get("AnimList");
        if (anims.Length > 0) {
            w.SetAnimList(Rules.Csv(anims.ToUpper()));
        }
        this.warheads.Add(w);
        return w;
    }

    Weapon WeaponNamed(string name) {
        string key = name.ToUpper();
        for (int i = 0; i < this.weapons.Count; i = i + 1) {
            if (this.weapons[i].Name() == key) { return this.weapons[i]; }
        }
        // Weapons outside the roster catalog -- the base-defence bolts
        // (CoilBolt, ElectricBolt) among them -- still resolve from their
        // own rules section, built with the same defaults the shared
        // catalog weapons start from.
        IniDocument ini = this.sourceIni;
        if (ini == null) { return null; }
        IniSection s = ini.Section(name);
        if (s == null) { s = ini.Section(key); }
        if (s == null) { return null; }
        Weapon w = Weapon.Create(key, s.GetIntOr("Damage", 0),
                                 s.GetIntOr("ROF", 50),
                                 Rules.ParseRange(s.Get("Range")),
                                 this.WarheadNamed(s.Get("Warhead")));
        this.weapons.Add(w);
        string pj = s.Get("Projectile");
        if (pj.Length > 0) {
            w.SetProj(this.ProjectileFromIni(pj, ini));
        }
        bool laser = Rules.YesNo(s.Get("IsLaser"));
        bool bolt = Rules.YesNo(s.Get("IsElectricBolt"));
        bool rad = Rules.YesNo(s.Get("IsRadBeam"));
        if (laser || bolt || rad) { w.SetBeamFlags(laser, bolt, rad); }
        string spd = s.Get("Speed");
        if (spd.Length > 0) { w.SetSpeed(s.GetIntOr("Speed", w.Speed())); }
        string rep = s.Get("Report");
        if (rep.Length > 0) { w.SetReport(Rules.Csv(rep)); }
        return w;
    }

    /// <summary>Resolves a weapon's Projectile= to a projectile type, taking
    /// flags from the install's own section when it carries one and plain
    /// defaults when it does not (the reference synthesizes an empty section
    /// for pointers at types like YR's InvisibleLow). Cached, so the ini is
    /// read once per type.</summary>
    ProjectileType ProjectileFromIni(string name, IniDocument ini) {
        string key = name.ToUpper();
        for (int i = 0; i < this.projectiles.Count; i = i + 1) {
            if (this.projectiles[i].Name() == key) {
                return this.projectiles[i];
            }
        }
        ProjectileType p = ProjectileType.Create(key);
        this.projectiles.Add(p);
        IniSection s = ini.Section(name);
        if (s != null) {
            string img = s.Get("Image");
            if (img.Length > 0 && img.ToLower() != "none") {
                p.SetImage(img.ToUpper());
            }
            if (Rules.YesNo(s.Get("Inviso"))) { p.SetInviso(true); }
            if (Rules.YesNo(s.Get("Arcing"))) { p.SetArcing(true); }
            if (s.Contains("ROT")) { p.SetRot(s.GetIntOr("ROT", p.Rot())); }
            if (s.Contains("Acceleration")) {
                p.SetAcceleration(s.GetIntOr("Acceleration",
                                            p.Acceleration()));
            }
            if (Rules.YesNo(s.Get("SubjectToWalls")) == false
             && s.Contains("SubjectToWalls")) {
                p.subjectToWalls = false;
            }
        }
        return p;
    }

    /// <summary>The projectile every weapon flies when its section (or the
    /// weapon's whole firing line) predates the install: an invisible,
    /// unguided straight round -- the reference's all-flags default.</summary>
    ProjectileType DefaultProjectile() {
        if (this.projectiles.Count == 0) {
            this.projectiles.Add(ProjectileType.Create("INVISIBLE"));
            this.projectiles[0].SetInviso(true);
        }
        return this.projectiles[0];
    }

    /// <summary>Gravity for arcing shots, from [AudioVisual] Gravity= in
    /// cells/tick². The retail file carries 6 leptons/tick²; dividing by
    /// 256 leptons a cell puts the tank-shell arc at the shallow dome the
    /// original draws.</summary>
    double GravityCells() { return this.gravity / 256.0; }

    /// <summary>The shipped rules carry AlternateArcticArt=yes: on snow
    /// maps objects whose art ships an arctic variant (the image name with
    /// an A before the extension) draw that variant. The reference's
    /// ObjectArt keys the same swap off inSnowTheater.</summary>
    bool AlternateArcticArt() { return this.alternateArcticArt; }
    List<string> FireTypes() { return this.fireTypes; }

    /// <summary>[AudioVisual] ConditionYellow=% (retail 50): a building at
    /// or below this share of health counts damaged.</summary>
    int ConditionYellowPct() { return this.conditionYellow; }

    /// <summary>[AudioVisual] ConditionRed=% (retail 25): the heavy damage
    /// state. The sprite has no third damage frame -- red shares yellow's.</summary>
    int ConditionRedPct() { return this.conditionRed; }

    /// <summary>The death ANIM for a warhead's InfDeath value -- the
    /// reference's getDeathAnim switch (sequenceMap.ts). Gunfire and
    /// Explode play the trooper's own Die1/Die2 sprite sequence instead,
    /// so they map to no anim here.</summary>
    string DeathAnimName(int infDeath) {
        if (infDeath == 3) { return this.infantryExplode; }
        if (infDeath == 4) { return this.flamingInfantry; }
        if (infDeath == 5) {
            return this.electroAnim == null ? "" : this.electroAnim;
        }
        if (infDeath == 6) { return this.infantryHeadPop; }
        if (infDeath == 7) { return this.infantryNuked; }
        if (infDeath == 8) { return this.infantryVirus; }
        if (infDeath == 9) { return this.infantryMutate; }
        if (infDeath == 10) { return this.infantryBrute; }
        return "";
    }

    /// <summary>A random DeadBodies corpse anim (DEATH_A..F), the pick
    /// keyed off a caller-supplied clock so runs stay deterministic.</summary>
    /// <summary>The damage share (percent) a prone trooper takes.</summary>
    int ProneDamagePct() { return this.proneDamagePct; }

    string DeathBodyName(int pick) {
        if (this.deadBodies == null || this.deadBodies.Count == 0) {
            return "";
        }
        return this.deadBodies[pick % this.deadBodies.Count];
    }

    /// <summary>The building's constant IdleAnim= loop from its art section,
    /// "" when the section or the anim's own art section is absent -- the
    /// reference skips a building anim whose animation art never shipped.</summary>
    string IdleAnimName(string reg) {
        if (this.artIni == null || reg == null) { return ""; }
        IniSection s = this.artIni.Section(reg);
        if (s == null) { return ""; }
        string name = s.Get("IdleAnim").Trim().ToUpper();
        if (name.Length == 0) { return ""; }
        return this.artIni.Section(name) != null ? name : "";
    }

    /// <summary>IdleAnimDamaged=: the damaged-state idle variant, gated the
    /// same way. A building without one keeps its healthy idle while hurt,
    /// exactly like the reference's missing-damaged-art fallback.</summary>
    string IdleAnimDamagedName(string reg) {
        if (this.artIni == null || reg == null) { return ""; }
        IniSection s = this.artIni.Section(reg);
        if (s == null) { return ""; }
        string name = s.Get("IdleAnimDamaged").Trim().ToUpper();
        if (name.Length == 0) { return ""; }
        return this.artIni.Section(name) != null ? name : "";
    }

    /// <summary>IdleAnimX/Y= lepton offsets for the idle loop.</summary>
    List<int> IdleAnimOffsets(string reg) {
        List<int> offs = new List<int>();
        if (this.artIni == null || reg == null) { return offs; }
        IniSection s = this.artIni.Section(reg);
        if (s == null) { return offs; }
        offs.Add(Rules.LeadingInt(s.GetOr("IdleAnimX", "0")));
        offs.Add(Rules.LeadingInt(s.GetOr("IdleAnimY", "0")));
        return offs;
    }

    /// <summary>DamageFireOffset0..N from a building's art section, as
    /// flat x,y pairs in 256ths of a cell (the ini's leptons). Empty when
    /// the art carries no fire spots -- the loop stops at the first
    /// absent index, the way the reference walks them.</summary>
    List<int> DamageFireOffsets(string reg) {
        List<int> pairs = new List<int>();
        if (this.artIni == null || reg == null) { return pairs; }
        IniSection s = this.artIni.Section(reg);
        if (s == null) { return pairs; }
        int idx = 0;
        for (;;) {
            string raw = s.Get("DamageFireOffset"
                + Convert.ToString(idx));
            if (raw.Length == 0) { break; }
            List<string> parts = Rules.Csv(raw);
            if (parts.Count < 2) { break; }
            pairs.Add(Rules.LeadingInt(parts[0]));
            pairs.Add(Rules.LeadingInt(parts[1]));
            idx = idx + 1;
        }
        return pairs;
    }

    /// <summary>The water-impact animation for damage tier damage/50 -- the
    /// reference's splashList pick for conventional warheads that burst in
    /// water. Empty until the install's rules carry the list.</summary>
    int SplashCount() {
        return this.splashList == null ? 0 : this.splashList.Count;
    }

    string SplashAt(int i) { return this.splashList[i]; }

    UnitDef UnitNamed(string reg) {
        for (int i = 0; i < this.units.Count; i = i + 1) {
            if (this.units[i].Reg() == reg) { return this.units[i]; }
        }
        return null;
    }

    BuildingDef BuildingNamed(string reg) {
        for (int i = 0; i < this.buildings.Count; i = i + 1) {
            if (this.buildings[i].Reg() == reg) { return this.buildings[i]; }
        }
        return null;
    }

    BuildingDef CivNamed(string reg) {
        for (int i = 0; i < this.civs.Count; i = i + 1) {
            if (this.civs[i].Reg() == reg) { return this.civs[i]; }
        }
        return null;
    }

    /// <summary>The units a side fields, in sidebar order. Bit weights are
    /// 1 allied, 2 soviet, 4 yuri -- Yuri mirrors the shipped rules where
    /// every Yuri unit names exactly one Owner house.</summary>
    List<UnitDef> UnitsForSide(int side) {
        int bit = side == Side2.Allied() ? 1
                : side == Side2.Soviet() ? 2 : 4;
        List<UnitDef> outList = new List<UnitDef>();
        for (int i = 0; i < this.units.Count; i = i + 1) {
            UnitDef d = this.units[i];
            if ((d.SideMask() & bit) != 0) { outList.Add(d); }
        }
        return outList;
    }

    /// <summary>The buildable structures a side has, in sidebar order.</summary>
    List<BuildingDef> BuildingsForSide(int side) {
        int bit = side == Side2.Allied() ? 1
                : side == Side2.Soviet() ? 2 : 4;
        List<BuildingDef> outList = new List<BuildingDef>();
        for (int i = 0; i < this.buildings.Count; i = i + 1) {
            BuildingDef d = this.buildings[i];
            if ((d.SideMask() & bit) != 0) { outList.Add(d); }
        }
        return outList;
    }

    /// <summary>Resolves a prereq token list (aliases like RADAR or concrete
    /// regkeys) to build-id slots against a side's building list: one slot
    /// per token, each slot holding the build ids of any building the token
    /// accepts. Empty slots (the token names nothing the side can build) are
    /// dropped -- they could never be satisfied.</summary>
    static List<List<int>> ResolvePrereqs(Rules rules, List<string> tokens,
                                          List<BuildingDef> bdefs) {
        List<List<int>> slots = new List<List<int>>();
        for (int i = 0; i < tokens.Count; i = i + 1) {
            List<string> regs = rules.ResolveToken(tokens[i]);
            List<int> slot = new List<int>();
            for (int j = 0; j < regs.Count; j = j + 1) {
                for (int b = 0; b < bdefs.Count; b = b + 1) {
                    if (bdefs[b].Reg() == regs[j]) { slot.Add(b); }
                }
            }
            if (slot.Count > 0) { slots.Add(slot); }
        }
        return slots;
    }

    /// <summary>Resolves one prereq token (an alias like RADAR or a concrete
    /// regkey like GATECH) to the regkeys it stands for.</summary>
    List<string> ResolveToken(string token) {
        if (token == "POWER") { return this.preqPower; }
        if (token == "FACTORY") { return this.preqFactory; }
        if (token == "BARRACKS") { return this.preqBarracks; }
        if (token == "RADAR") { return this.preqRadar; }
        if (token == "TECH") { return this.preqTech; }
        if (token == "PROC") { return this.preqProc; }
        List<string> one = new List<string>();
        one.Add(token);
        return one;
    }

    // ---- pacing ------------------------------------------------------------

    /// <summary>Production ticks a unit spends in the queue, proportional to
    /// its price the way RA2's build speed is: a 200-credit GI takes 150
    /// ticks, ten seconds at the game's fifteen ticks a second.</summary>
    /// <summary>Unit production pace, the reference's fixed PRODUCE_TICKS:
    /// every order walks out of its factory 20 ticks after it is paid, the
    /// prototype rhythm the reference engine ships, cost notwithstanding.</summary>
    static int UnitBuildTicks(int cost) { return 20; }

    /// <summary>Building placement is instant in the reference engine: the
    /// structure lands at full health the tick the order is placed, so there
    /// is no construction phase to pace. Kept as a hook returning 0.</summary>
    static int BuildingBuildTicks(int cost) {
        return 0;
    }

    /// <summary>A neutral scenery unit (a map's car, a map's cow). These
    /// never enter a build roster: SideMask is 0 and the producer is empty.
    /// `shp` is the art file the shipped rules resolve to -- the reg's own
    /// name for every one of them, since none carries an Image= override.</summary>
    static UnitDef CivUnit(string reg, string label, int hp, string shp,
                           int speed, int armor) {
        UnitDef d = UnitDef.Create(reg, label, 0, hp, speed,
                                   armor, null, "", 0, shp);
        d.SetRole(UnitRole.None());
        return d;
    }

    // ---- the defaults: RULES.INI transcribed -------------------------------

    /// <summary>The full ruleset with the shipped RA2 values. Tests run
    /// against this alone, so the balance is locked even where no install
    /// exists; the real game then layers its own RULES.INI on top.</summary>
    static Rules Default() {
        Rules r = Rules.Create();

        // -- warheads: the eleven-verse tables --------------------------------
        r.warheads.Add(Warhead.Create("SA",
            "100,80,70,50,25,25,75,50,25,100,100"));
        r.warheads.Add(Warhead.Create("SSA",
            "100,100,70,60,40,40,75,50,25,100,100"));
        r.warheads.Add(Warhead.Create("HollowPoint",
            "200,100,100,1,1,1,1,1,1,1,100"));
        r.warheads.Add(Warhead.Create("Shock",
            "100,100,100,85,100,100,50,50,50,200,100"));
        r.warheads.Add(Warhead.Create("ElectricAssault",
            "0,0,0,0,0,0,100,100,100,50,100"));
        r.warheads.Add(Warhead.Create("AP",
            "25,25,25,75,100,100,65,45,60,60,100"));
        r.warheads.Add(Warhead.Create("FlakGuyWH",
            "150,100,50,60,10,10,70,30,20,100,100"));
        Warhead flak = Warhead.Create("FlakWH",
            "100,100,50,60,10,10,70,30,20,100,100");
        flak.SetSpread(1);
        r.warheads.Add(flak);
        Warhead psi = Warhead.Create("PsiPulse",
            "100,100,100,0,0,0,0,0,0,0,0");
        psi.SetSpread(3);
        r.warheads.Add(psi);
        Warhead ctrl = Warhead.Create("Controller",
            "100,100,100,100,100,100,0,0,0,100,100");
        ctrl.SetMindControl(true);
        r.warheads.Add(ctrl);
        Warhead chrono = Warhead.Create("ChronoBeam",
            "100,100,100,100,100,100,100,100,100,100,100");
        chrono.SetFreeze(true);
        r.warheads.Add(chrono);
        r.warheads.Add(Warhead.Create("Parasite",
            "100,100,100,100,100,100,0,0,0,0,0"));
        Warhead dog = Warhead.Create("ParasiteDog",
            "100,100,100,0,0,0,0,0,0,0,0");
        dog.SetKillsInfantry(true);
        r.warheads.Add(dog);
        r.warheads.Add(Warhead.Create("RadBeamWarhead",
            "100,100,100,20,15,10,0,0,0,100,100"));
        Warhead erupt = Warhead.Create("RadEruptionWarhead",
            "100,100,100,20,15,10,0,0,0,100,100");
        erupt.SetSpread(10);
        r.warheads.Add(erupt);
        r.warheads.Add(Warhead.Create("HE",
            "100,90,80,70,35,35,75,40,20,80,100"));
        Warhead bomb = Warhead.Create("IvanBombWH",
            "100,100,100,100,100,100,100,100,100,100,100");
        bomb.SetPlantsBomb(true);
        r.warheads.Add(bomb);
        r.warheads.Add(Warhead.Create("SapperWH",
            "0,0,0,0,0,0,100,100,100,0,0"));
        // YR additions: the guardian GI's missiles and Boris's AK hit armour
        // with very different verse tables than the rifles they sit beside.
        r.warheads.Add(Warhead.Create("GUARDWH",
            "20,20,20,100,50,100,10,10,10,100,100"));
        r.warheads.Add(Warhead.Create("BORISWH",
            "200,200,100,50,50,50,1,1,1,100,100"));
        r.warheads.Add(Warhead.Create("PJABWH",
            "100,100,100,50,25,25,25,40,15,100,100"));
        // Tank-gun and tesla warheads, the shipped [Verses] tables.
        r.warheads.Add(Warhead.Create("ApocAP",
            "25,25,25,75,100,100,100,100,70,60,100"));
        r.warheads.Add(Warhead.Create("UltraAP",
            "2,2,2,100,40,100,2,2,2,2,100"));
        r.warheads.Add(Warhead.Create("Electric",
            "100,100,100,85,100,100,50,50,50,200,100"));
        r.warheads.Add(Warhead.Create("CometWH",
            "100,100,100,75,50,50,200,200,200,100,100"));
        r.warheads.Add(Warhead.Create("FlakTWH",
            "150,125,100,60,10,10,30,20,10,100,100"));
        // Yuri's Revenge warheads, the shipped [Verses] tables. GattWH is
        // the gattling family's anti-armour-weak rounds; Virus nearly
        // ignores everything but infantry; LocomotorBeam is the
        // Magnetron's hull-lifting beam (a slow heavy hit here); AntiB
        // only bites structures, the Floating Disk's drain.
        r.warheads.Add(Warhead.Create("GattWH",
            "100,80,70,50,30,10,10,5,3,200,50"));
        r.warheads.Add(Warhead.Create("DiskWH",
            "100,100,100,50,50,50,100,100,100,100,100"));
        Warhead loco = Warhead.Create("LocomotorBeam",
            "0,0,0,100,100,100,0,0,0,100,0");
        r.warheads.Add(loco);
        r.warheads.Add(Warhead.Create("MagneShakeWH",
            "0,0,0,0,100,0,100,100,100,0,0"));
        r.warheads.Add(Warhead.Create("VirusWH",
            "100,100,100,1,1,1,1,1,1,1,100"));
        r.warheads.Add(Warhead.Create("Battering",
            "100,100,100,0,0,0,20,20,20,200,100"));
        r.warheads.Add(Warhead.Create("Smashing",
            "0,0,0,100,20,100,0,0,0,0,0"));
        r.warheads.Add(Warhead.Create("AntiB",
            "0,0,0,0,0,0,100,100,100,0,0"));
        r.warheads.Add(Warhead.Create("HARVWH",
            "100,80,70,50,20,20,20,15,10,400,100"));

        // -- weapons: damage, ROF ticks, range cells, warhead ----------------
        r.weapons.Add(Weapon.Create("M60", 15, 20, 4, r.WarheadNamed("SA")));
        r.weapons.Add(Weapon.Create("M1Carbine", 15, 25, 4,
            r.WarheadNamed("SA")));
        r.weapons.Add(Weapon.Create("BadTeeth", 30, 30, 2,
            r.WarheadNamed("ParasiteDog")));
        r.weapons.Add(Weapon.Create("AWP", 125, 150, 14,
            r.WarheadNamed("HollowPoint")));
        r.weapons.Add(Weapon.Create("ElectricBolt", 50, 60, 3,
            r.WarheadNamed("Shock")));
        r.weapons.Add(Weapon.Create("AssaultBolt", 10, 25, 2,
            r.WarheadNamed("ElectricAssault")));
        r.weapons.Add(Weapon.Create("FlakGuyGun", 20, 20, 5,
            r.WarheadNamed("FlakGuyWH")));
        r.weapons.Add(Weapon.Create("MindControl", 10, 200, 7,
            r.WarheadNamed("Controller")));
        r.weapons.Add(Weapon.Create("PsiWave", 250, 50, 1,
            r.WarheadNamed("PsiPulse")));
        r.weapons.Add(Weapon.Create("NeutronRifle", 8, 120, 5,
            r.WarheadNamed("ChronoBeam")));
        r.weapons.Add(Weapon.Create("DoublePistols", 125, 10, 6,
            r.WarheadNamed("HollowPoint")));
        r.weapons.Add(Weapon.Create("Sapper", 200, 45, 1,
            r.WarheadNamed("SapperWH")));
        r.weapons.Add(Weapon.Create("IvanBomber", 400, 50, 2,
            r.WarheadNamed("IvanBombWH")));
        r.weapons.Add(Weapon.Create("RadBeamWeapon", 125, 50, 6,
            r.WarheadNamed("RadBeamWarhead")));
        r.weapons.Add(Weapon.Create("RadEruptionWeapon", 1, 60, 4,
            r.WarheadNamed("RadEruptionWarhead")));
        r.weapons.Add(Weapon.Create("DroneJump", 50, 60, 2,
            r.WarheadNamed("Parasite")));
        r.weapons.Add(Weapon.Create("Vulcan2", 50, 26, 6,
            r.WarheadNamed("SA")));
        r.weapons.Add(Weapon.Create("CoilBolt", 200, 80, 7,
            r.WarheadNamed("Shock")));
        r.weapons.Add(Weapon.Create("FlakWeapon", 40, 20, 12,
            r.WarheadNamed("FlakWH")));
        // YR additions, the shipped [Weapon] values.
        r.weapons.Add(Weapon.Create("MissileLauncher", 40, 40, 8,
            r.WarheadNamed("GUARDWH")));
        r.weapons.Add(Weapon.Create("AKM", 65, 20, 7,
            r.WarheadNamed("BORISWH")));
        r.weapons.Add(Weapon.Create("MP5", 30, 20, 6,
            r.WarheadNamed("SA")));
        // Tank guns, the shipped [105mm] / [120mm] damage, ROF and range.
        r.weapons.Add(Weapon.Create("105mm", 75, 30, 6,
            r.WarheadNamed("AP")));
        r.weapons.Add(Weapon.Create("120mm", 90, 65, 6,
            r.WarheadNamed("AP")));
        // The wider vehicle arsenal, shipped values. V3Launcher's damage
        // rides its spawned rocket in the original; this engine resolves
        // shots directly, so the launcher carries the rocket's payload.
        r.weapons.Add(Weapon.Create("120mmx", 100, 80, 6,
            r.WarheadNamed("ApocAP")));
        r.weapons.Add(Weapon.Create("MammothTusk", 50, 80, 8,
            r.WarheadNamed("HE")));
        r.weapons.Add(Weapon.Create("V3Launcher", 200, 150, 18,
            r.WarheadNamed("HE")));
        r.weapons.Add(Weapon.Create("TankBolt", 135, 75, 4,
            r.WarheadNamed("Electric")));
        r.weapons.Add(Weapon.Create("SABOT", 150, 70, 5,
            r.WarheadNamed("UltraAP")));
        r.weapons.Add(Weapon.Create("Comet", 100, 100, 10,
            r.WarheadNamed("CometWH")));
        r.weapons.Add(Weapon.Create("FlakTrackGun", 25, 25, 5,
            r.WarheadNamed("FlakTWH")));
        r.weapons.Add(Weapon.Create("HoverMissile", 25, 50, 6,
            r.WarheadNamed("HE")));
        // The War Miner's nose gun, the shipped [20mmRapid]: an
        // anti-infantry deterrent, so mining under fire is not free.
        r.weapons.Add(Weapon.Create("20mmRapid", 30, 20, 5,
            r.WarheadNamed("HARVWH")));
        // The Yuri arsenal, the shipped YR [Weapon] values. Ranges are the
        // fractional cell values rounded up. The gattling tank's flak-mode
        // AAGattling rides as its secondary; the Magnetron's shake is the
        // anti-structure complement to its beam; the Master Mind and the
        // Psychic Tower reuse the Controller warhead, so their shots
        // convert rather than kill.
        r.weapons.Add(Weapon.Create("PsychicJab", 25, 15, 5,
            r.WarheadNamed("PJABWH")));
        r.weapons.Add(Weapon.Create("Punch", 100, 60, 2,
            r.WarheadNamed("Battering")));
        r.weapons.Add(Weapon.Create("Smash", 100, 60, 2,
            r.WarheadNamed("Smashing")));
        r.weapons.Add(Weapon.Create("Virusgun", 125, 100, 10,
            r.WarheadNamed("VirusWH")));
        r.weapons.Add(Weapon.Create("AGGattling", 25, 16, 6,
            r.WarheadNamed("GattWH")));
        r.weapons.Add(Weapon.Create("AAGattling", 25, 16, 8,
            r.WarheadNamed("GattWH")));
        r.weapons.Add(Weapon.Create("ATGun", 65, 60, 5,
            r.WarheadNamed("AP")));
        r.weapons.Add(Weapon.Create("DiskLaser", 90, 80, 7,
            r.WarheadNamed("DiskWH")));
        r.weapons.Add(Weapon.Create("DiskDrain", 1, 50, 2,
            r.WarheadNamed("AntiB")));
        r.weapons.Add(Weapon.Create("MagneticBeam", 200, 20, 12,
            r.WarheadNamed("LocomotorBeam")));
        r.weapons.Add(Weapon.Create("MagneShake", 80, 110, 10,
            r.WarheadNamed("MagneShakeWH")));
        r.weapons.Add(Weapon.Create("MindControlTank", 3, 10, 6,
            r.WarheadNamed("Controller")));
        r.weapons.Add(Weapon.Create("MindControlTower", 3, 100, 7,
            r.WarheadNamed("Controller")));

        // -- the roster -------------------------------------------------------
        // Order matters: each side's menu ids come from filtering this list,
        // so both sides open on their rifleman (E1/E2) before the shared dog
        // and engineer slot in at 1 and 2. The stripped install carries no
        // vehicle art, so the Allied war runs entirely on foot.
        UnitDef gi = UnitDef.Create("E1", "美国大兵", 200, 125, 4,
            ArmorClass.None(), r.WeaponNamed("M60"), "GAPILE", 1, "GI.SHP");
        gi.SetDeployer(true);
        r.units.Add(gi);
        UnitDef ggi = UnitDef.Create("GGI", "重装大兵", 400, 100, 3,
            ArmorClass.None(), r.WeaponNamed("M60"), "GAPILE", 1, "GGI.SHP");
        ggi.SetSecondary(r.WeaponNamed("MissileLauncher"));
        ggi.SetDeployer(true);
        r.units.Add(ggi);
        r.units.Add(UnitDef.Create("E2", "动员兵", 100, 125, 4,
            ArmorClass.Flak(), r.WeaponNamed("M1Carbine"), "NAHAND", 2,
            "CONS.SHP"));
        UnitDef dogA = UnitDef.Create("ADOG", "警犬", 200, 100, 8,
            ArmorClass.None(), r.WeaponNamed("BadTeeth"), "GAPILE", 3,
            "DOG.SHP");
        dogA.SetMindImmune(true);
        r.units.Add(dogA);
        UnitDef eng = UnitDef.Create("ENGINEER", "工程师", 500, 75, 4,
            ArmorClass.None(), null, "GAPILE", 3, "ENGINEER.SHP");
        eng.SetRole(UnitRole.Engineer());
        r.units.Add(eng);
        UnitDef snipe = UnitDef.Create("SNIPE", "狙击手", 600, 125, 4,
            ArmorClass.Flak(), r.WeaponNamed("AWP"), "GAPILE", 1, "SNIPE.SHP");
        snipe.AddPrereq("RADAR");
        r.units.Add(snipe);
        // The SEAL, the allied commando: MP5 rounds and the same C4 charge
        // Tanya carries, an hour earlier in the tech ladder.
        UnitDef seal = UnitDef.Create("SEAL", "海豹部队", 1000, 200, 6,
            ArmorClass.None(), r.WeaponNamed("MP5"), "GAPILE", 1, "SEAL.SHP");
        seal.SetSecondary(r.WeaponNamed("Sapper"));
        seal.AddPrereq("TECH");
        r.units.Add(seal);
        UnitDef spy = UnitDef.Create("SPY", "间谍", 1000, 100, 4,
            ArmorClass.Flak(), null, "GAPILE", 1, "SPY.SHP");
        spy.SetRole(UnitRole.Spy());
        spy.AddPrereq("TECH");
        r.units.Add(spy);
        UnitDef cleg = UnitDef.Create("CLEG", "超时空军团兵", 1500, 125, 5,
            ArmorClass.None(), r.WeaponNamed("NeutronRifle"), "GAPILE", 1,
            "CLEG.SHP");
        cleg.AddPrereq("TECH");
        r.units.Add(cleg);
        // The regkey is TANY, the shipped section name, so the install's own
        // stats and UIName override the transcribed defaults.
        UnitDef tanya = UnitDef.Create("TANY", "谭雅", 1000, 125, 5,
            ArmorClass.Flak(), r.WeaponNamed("DoublePistols"), "GAPILE", 1,
            "TANY.SHP");
        tanya.SetSecondary(r.WeaponNamed("Sapper"));
        tanya.SetMindImmune(true);
        tanya.AddPrereq("TECH");
        r.units.Add(tanya);
        // The Grizzly, the allied main battle tank: a 105mm AP gun behind
        // heavy armour, turned out by the war factory. Art is the voxel
        // model the install names under its Image key, GTNK.
        UnitDef mtnk = UnitDef.Create("MTNK", "灰熊坦克", 700, 300, 7,
            ArmorClass.Heavy(), r.WeaponNamed("105mm"), "GAWEAP", 1,
            "GTNK.VXL");
        // Turret=yes in the shipped rules; the art section GTNK turns the
        // turret model into GTNKTUR.VXL, which the install carries.
        mtnk.SetTurretVxl("GTNKTUR.VXL");
        r.units.Add(mtnk);
        // The Mobile Construction Vehicle: every battle opens on one per
        // house, unfolded on the spot into its construction yard -- the
        // shipped [AMCV] DeploysInto key is what makes that legal.
        UnitDef amcv = UnitDef.Create("AMCV", "机动基地车", 3000, 1000, 4,
            ArmorClass.Heavy(), null, "GAWEAP", 1, "MCV.VXL");
        amcv.SetDeploysInto("GACNST");
        r.units.Add(amcv);
        // The rest of the allied motor pool in factory-menu order: the IFV's
        // missile rack, the Tank Destroyer's armour-piercing SABOT and the
        // Prism Tank's long-range beam.
        UnitDef fv = UnitDef.Create("FV", "甲弹斗车", 600, 200, 10,
            ArmorClass.Light(), r.WeaponNamed("HoverMissile"), "GAWEAP", 1,
            "FV.VXL");
        fv.SetTurretVxl("FVTUR.VXL");
        r.units.Add(fv);
        UnitDef tnkd = UnitDef.Create("TNKD", "坦克杀手", 900, 400, 5,
            ArmorClass.Heavy(), r.WeaponNamed("SABOT"), "GAWEAP", 1,
            "TNKD.VXL");
        tnkd.AddPrereq("RADAR");
        r.units.Add(tnkd);
        UnitDef sref = UnitDef.Create("SREF", "棱镜坦克", 1200, 150, 4,
            ArmorClass.Light(), r.WeaponNamed("Comet"), "GAWEAP", 1,
            "SREF.VXL");
        sref.SetTurretVxl("SREFTUR.VXL");
        sref.AddPrereq("TECH");
        r.units.Add(sref);
        // The Chrono Miner, the allied harvester: the shipped [CMIN] stats.
        // The original teleports back to its refinery to unload; this engine
        // drives the route instead, documented as a substitution until a
        // chrono layer exists.
        UnitDef cmin = UnitDef.Create("CMIN", "超时空采矿车", 1400, 1000, 4,
            ArmorClass.Medium(), null, "GAWEAP", 1, "CMIN.VXL");
        cmin.SetStorage(20);
        cmin.SetRole(UnitRole.Harvester());
        r.units.Add(cmin);

        // Soviet infantry, plus the terror drone the war factory turns out.
        UnitDef shk = UnitDef.Create("SHK", "磁暴步兵", 500, 130, 4,
            ArmorClass.Plate(), r.WeaponNamed("ElectricBolt"), "NAHAND", 2,
            "SHK.SHP");
        shk.SetSecondary(r.WeaponNamed("AssaultBolt"));
        r.units.Add(shk);
        UnitDef flakt = UnitDef.Create("FLAKT", "防空步兵", 300, 100, 4,
            ArmorClass.Flak(), r.WeaponNamed("FlakGuyGun"), "NAHAND", 2,
            "FLAKT.SHP");
        flakt.AddPrereq("RADAR");
        r.units.Add(flakt);
        UnitDef ivan = UnitDef.Create("IVAN", "疯狂伊文", 600, 125, 4,
            ArmorClass.None(), r.WeaponNamed("IvanBomber"), "NAHAND", 2,
            "IVAN.SHP");
        ivan.AddPrereq("RADAR");
        r.units.Add(ivan);
        UnitDef deso = UnitDef.Create("DESO", "辐射工兵", 600, 150, 4,
            ArmorClass.Plate(), r.WeaponNamed("RadBeamWeapon"), "NAHAND", 2,
            "DESO.SHP");
        deso.SetSecondary(r.WeaponNamed("RadEruptionWeapon"));
        deso.AddPrereq("RADAR");
        r.units.Add(deso);
        UnitDef yuri = UnitDef.Create("YURI", "尤里", 1200, 100, 4,
            ArmorClass.None(), r.WeaponNamed("MindControl"), "NAHAND", 2,
            "YURI.SHP");
        yuri.SetSecondary(r.WeaponNamed("PsiWave"));
        yuri.AddPrereq("TECH");
        r.units.Add(yuri);
        // Boris, the Soviet answer to Tanya: an AK that chews vehicles and a
        // hero's immunity to mind control. His flare marker needs the
        // airstrike system, so he fights with the rifle alone for now.
        UnitDef boris = UnitDef.Create("BORIS", "精英战斗兵", 1500, 200, 5,
            ArmorClass.Flak(), r.WeaponNamed("AKM"), "NAHAND", 2, "BORIS.SHP");
        boris.SetMindImmune(true);
        boris.AddPrereq("TECH");
        r.units.Add(boris);
        // The Rhino, the Soviet answer to the Grizzly: one speed slower,
        // 200 more hit points, a harder-hitting 120mm. Behind it the factory
        // turns out the Flak Track, the V3 rocket carrier, the Tesla tank
        // and the Apocalypse; the terror drone keeps the menu's last slot.
        UnitDef htnk = UnitDef.Create("HTNK", "犀牛坦克", 900, 400, 6,
            ArmorClass.Heavy(), r.WeaponNamed("120mm"), "NAWEAP", 2,
            "HTNK.VXL");
        htnk.SetTurretVxl("HTNKTUR.VXL");
        r.units.Add(htnk);
        // The Soviet Mobile Construction Vehicle, the shipped [SMCV]:
        // DeploysInto=NACNST, the same seed-and-unfold opening as the
        // Allied side's.
        UnitDef smcv = UnitDef.Create("SMCV", "机动基地车", 3000, 1000, 4,
            ArmorClass.Heavy(), null, "NAWEAP", 2, "MCV.VXL");
        smcv.SetDeploysInto("NACNST");
        r.units.Add(smcv);
        r.units.Add(UnitDef.Create("HTK", "防空履带车", 500, 180, 8,
            ArmorClass.Heavy(), r.WeaponNamed("FlakTrackGun"), "NAWEAP", 2,
            "HTK.VXL"));
        UnitDef v3 = UnitDef.Create("V3", "V3导弹车", 800, 150, 4,
            ArmorClass.Light(), r.WeaponNamed("V3Launcher"), "NAWEAP", 2,
            "V3.VXL");
        v3.AddPrereq("RADAR");
        r.units.Add(v3);
        UnitDef ttnk = UnitDef.Create("TTNK", "磁能坦克", 1200, 300, 6,
            ArmorClass.Heavy(), r.WeaponNamed("TankBolt"), "NAWEAP", 2,
            "TTNK.VXL");
        ttnk.SetTurretVxl("TTNKTUR.VXL");
        ttnk.AddPrereq("RADAR");
        r.units.Add(ttnk);
        // The Apocalypse: the ship's Image key borrows the MTNK voxel, the
        // biggest model in the install, with the twin 120mmx and the Tusk
        // missiles of the shipped rules.
        UnitDef apoc = UnitDef.Create("APOC", "天啟坦克", 1750, 800, 4,
            ArmorClass.Heavy(), r.WeaponNamed("120mmx"), "NAWEAP", 2,
            "MTNK.VXL");
        apoc.SetSecondary(r.WeaponNamed("MammothTusk"));
        apoc.AddPrereq("TECH");
        r.units.Add(apoc);
        // The War Miner, the Soviet harvester: the shipped [HARV] stats,
        // including the nose gun that makes mining under fire survivable.
        // The harvester role drives the mine-and-unload loop in World.
        UnitDef harv = UnitDef.Create("HARV", "武装采矿车", 1400, 1000, 4,
            ArmorClass.Heavy(), r.WeaponNamed("20mmRapid"), "NAWEAP", 2,
            "HARV.VXL");
        harv.SetTurretVxl("HARVTUR.VXL");
        harv.SetStorage(40);
        harv.SetRole(UnitRole.Harvester());
        r.units.Add(harv);
        r.units.Add(UnitDef.Create("DRON", "恐怖机器人", 500, 100, 10,
            ArmorClass.Special1(), r.WeaponNamed("DroneJump"), "NAWEAP", 2,
            "DRON.SHP"));

        // -- the Yuri roster, the shipped YR [YuriCountry] entries. Side 4
        // in the mask: every Yuri unit names exactly one Owner house. The
        // install carries every unit's art (infantry SHP in CONQMD, vehicle
        // VXL in LOCALMD, the gattling/lasher/disc turrets alongside), so
        // the Image= chain resolves directly; the Slave Miner (mines, no
        // refinery dock in this engine) is the Yuri harvester and PCV the
        // deployable MCV.
        UnitDef init = UnitDef.Create("INIT", "尤里新兵", 200, 100, 4,
            ArmorClass.None(), r.WeaponNamed("PsychicJab"), "YABRCK", 4,
            "INIT.SHP");
        r.units.Add(init);
        UnitDef brute = UnitDef.Create("BRUTE", "狂獸人", 500, 200, 6,
            ArmorClass.Plate(), r.WeaponNamed("Punch"), "YABRCK", 4,
            "BRUTE.SHP");
        brute.SetSecondary(r.WeaponNamed("Smash"));
        r.units.Add(brute);
        UnitDef virus = UnitDef.Create("VIRUS", "病毒狙擊手", 700, 100, 4,
            ArmorClass.None(), r.WeaponNamed("Virusgun"), "YABRCK", 4,
            "VIRUS.SHP");
        virus.AddPrereq("RADAR");
        r.units.Add(virus);
        UnitDef yuriPrime = UnitDef.Create("YURIPR", "尤里X", 1500, 150, 6,
            ArmorClass.Flak(), r.WeaponNamed("MindControl"), "YABRCK", 4,
            "YURI.SHP");
        yuriPrime.SetSecondary(r.WeaponNamed("PsiWave"));
        yuriPrime.SetMindImmune(true);
        yuriPrime.AddPrereq("TECH");
        r.units.Add(yuriPrime);
        // The Lasher, the Yuri light tank: Image=LTNK with the LTNKTUR
        // turret, both present in the install's LOCALMD.
        UnitDef ltnk = UnitDef.Create("LTNK", "狂風坦克", 700, 300, 7,
            ArmorClass.Heavy(), r.WeaponNamed("ATGun"), "YAWEAP", 4,
