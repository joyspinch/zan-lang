        // -- economy -----------------------------------------------------------
        r.startMoney = 10000;
        r.oilIncome = 1;
        r.oilCapture = 1000;
        r.bombDamage = 400;
        r.bombDelay = 300;
        r.splashScale = 50;
        r.blackoutTicks = 300;
        r.freezeTicks = 90;
        // The shipped [General] sell/repair block: half the price back for a
        // sold building, a full repair costing 15% of it, 8 hp per repair
        // step. RepairRate=.016 minutes is one step a second at the 1:1
        // tick pacing the rest of the economy already runs on.
        r.refundPercent = 50;
        r.repairPercent = 15;
        r.repairStep = 8;
        r.repairRateTicks = 60;
        return r;
    }

    // ---- reading the player's RULES.INI --------------------------------------

    /// <summary>The ruleset for a real game: the transcribed defaults, then
    /// whatever the install's own RULES.INI still defines layered on top. A
    /// null or empty document leaves the defaults untouched, which keeps the
    /// tests -- and machines without an install -- on the exact shipped
    /// balance.</summary>
    static Rules Load(IniDocument ini) {
        Rules r = Rules.Default();
        if (ini == null || ini.Count() == 0) { return r; }
        r.ApplyIni(ini);
        return r;
    }

    /// <summary>Load with the install's string table alongside the rules, so
    /// sidebar labels read exactly what the original game showed.</summary>
    static Rules LoadWith(IniDocument ini, CsfTable strings) {
        Rules r = Rules.Default();
        r.strings = strings;
        if (ini == null || ini.Count() == 0) { return r; }
        // Kept so map-object discovery can read the install's own type
        // declarations and reg sections later (see MapObjectUnitType).
        r.sourceIni = ini;
        r.ApplyIni(ini);
        return r;
    }

    /// <summary>Registers a unit that a map names but no roster carries: the
    /// reference's ensureMapObjectDefaults. A map may place any reg the
    /// install declares in [VehicleTypes] / [InfantryTypes] / [AircraftTypes],
    /// including scenery that is never trainable (a taxi, a monkey, a
    /// construction excavator). The reference looks the reg up in the declared
    /// type list and, when it is there, builds a rules entry from its section
    /// with Strength 400 / TechLevel -1 / Insignificant yes as the defaults.
    ///
    /// Returns the new archetype, or null when the install declares no such
    /// reg -- a genuinely unknown name stays unplaced rather than becoming a
    /// phantom.
    ///
    /// The kind matters: the same name could in principle appear in two
    /// lists, and a vehicle's art is a voxel while an infantry's is a sprite,
    /// so only the list the map's section came from is searched.</summary>
    UnitType MapObjectUnitType(UnitCatalog catalog, string reg, string kind) {
        if (reg == null || reg.Length == 0) { return null; }
        string name = reg.ToUpper();
        string listSec = "";
        if (kind == "infantry") { listSec = "InfantryTypes"; }
        else if (kind == "aircraft") { listSec = "AircraftTypes"; }
        else { listSec = "VehicleTypes"; }
        bool declared = false;
        if (this.sourceIni != null) {
            IniSection list = this.sourceIni.Section(listSec);
            if (list != null) {
                for (int i = 0; i < list.Count(); i = i + 1) {
                    if (list.EntryAt(i).Value().Trim().ToUpper() == name) {
                        declared = true;
                    }
                }
            }
        }
        if (!declared) { return null; }
        IniSection s = this.sourceIni.Section(name);
        int hp = 400;
        int speed = 4;
        int armor = ArmorClass.None();
        string shp = name;
        if (s != null) {
            if (s.Contains("Strength")) { hp = s.GetIntOr("Strength", hp); }
            if (s.Contains("Speed")) { speed = s.GetIntOr("Speed", speed); }
            string arm = s.Get("Armor");
            if (arm.Length > 0) { armor = ArmorClass.Parse(arm); }
            string img = s.Get("Image");
            if (img.Length > 0) { shp = img.ToUpper(); }
        }
        bool voxel = true;
        if (this.sourceIni != null) {
            IniSection artSec = null;
            if (this.artIni != null) { artSec = this.artIni.Section(name); }
            if (artSec != null) {
                string v = artSec.Get("Voxel");
                voxel = v.Length > 0 && Rules.YesNo(v);
                string img2 = artSec.Get("Image");
                if (img2.Length > 0) { shp = img2.ToUpper(); }
            }
        }
        // The art file's extension: a voxel model or a sprite.
        string file = shp + (voxel ? ".VXL" : ".SHP");
        UnitType t = UnitType.Create(name, name, 0, 0, hp, file, armor,
                                     null, null, 0, UnitRole.None(), true);
        t.SetArtKey(name);
        return t;
    }

    /// <summary>The extension an Image= override keeps: a voxel unit stays
    /// voxel, a shape unit stays shape, so [APOC] Image=HTNK under a voxel
    /// default resolves to HTNK.VXL while infantry resolve to .SHP.</summary>
    static string ArtExtension(string shp) {
        if (shp == null) { return ".SHP"; }
        int dot = shp.Length - 4;
        if (dot < 0) { return ".SHP"; }
        bool vxl = true;
        string want = ".VXL";
        for (int i = 0; i < 4; i = i + 1) {
            if ((shp[dot + i] & 0xDF) != (want[i] & 0xDF)) { vxl = false; break; }
        }
        return vxl ? ".VXL" : ".SHP";
    }

    void ApplyIni(IniDocument ini) {
        // Gravity steers every arcing shot; the retail file carries it under
        // [AudioVisual].
        IniSection av = ini.Section("AudioVisual");
        if (av != null && av.Contains("Gravity")) {
            this.gravity = av.GetIntOr("Gravity", 6);
        }
        if (av != null) {
            string fires = av.Get("DamageFireTypes");
            if (fires.Length > 0) {
                this.fireTypes = Rules.Csv(fires.ToUpper());
            }
            int cy = Rules.LeadingInt(av.GetOr("ConditionYellow", ""));
            if (cy > 0) { this.conditionYellow = cy; }
            int cr = Rules.LeadingInt(av.GetOr("ConditionRed", ""));
            if (cr > 0) { this.conditionRed = cr; }
            if (av.Contains("DeadBodies")) {
                this.deadBodies = Rules.Csv(av.Get("DeadBodies").ToUpper());
            }
            string da = av.Get("InfantryExplode");
            if (da.Length > 0) { this.infantryExplode = da.ToUpper(); }
            da = av.Get("FlamingInfantry");
            if (da.Length > 0) { this.flamingInfantry = da.ToUpper(); }
            da = av.Get("InfantryHeadPop");
            if (da.Length > 0) { this.infantryHeadPop = da.ToUpper(); }
            da = av.Get("InfantryNuked");
            if (da.Length > 0) { this.infantryNuked = da.ToUpper(); }
            da = av.Get("InfantryVirus");
            if (da.Length > 0) { this.infantryVirus = da.ToUpper(); }
            da = av.Get("InfantryMutate");
            if (da.Length > 0) { this.infantryMutate = da.ToUpper(); }
            da = av.Get("InfantryBrute");
            if (da.Length > 0) { this.infantryBrute = da.ToUpper(); }
        }
        // ProneDamage ships as a fixed number ("1.0") or a percent
        // ("50%"); either way the shipped file leaves it commented out.
        IniSection gen = ini.Section("General");
        if (gen != null) {
            string pd = gen.Get("ProneDamage");
            if (pd.Length > 0) {
                int pct = pd.Trim().EndsWith("%")
                    ? Rules.LeadingInt(pd)
                    : Rules.LeadingInt(pd) * 100;
                if (pct > 0) { this.proneDamagePct = pct; }
            }
            // The crate layer's [General] keys (the reference's CrateRules).
            this.crateMaximum = gen.GetIntOr("CrateMaximum", this.crateMaximum);
            this.crateMinimum = gen.GetIntOr("CrateMinimum", this.crateMinimum);
            this.crateRadius = gen.GetIntOr("CrateRadius", this.crateRadius);
            this.crateRegen = gen.GetIntOr("CrateRegen", this.crateRegen);
            string uct = gen.Get("UnitCrateType");
            if (uct.Length > 0 && uct.ToUpper() != "<NONE>") {
                this.unitCrateType = uct.ToUpper();
            }
            string ci = gen.Get("CrateImg");
            if (ci.Length > 0) { this.crateImg = ci.ToUpper(); }
            string wci = gen.Get("WaterCrateImg");
            if (wci.Length > 0) { this.waterCrateImg = wci.ToUpper(); }
            string fmv = gen.Get("FreeMCV");
            if (fmv.Length > 0) { this.freeMCV = Rules.YesNo(fmv); }
        }
        // The [Powerups] table: an install that ships one replaces the
        // transcribed defaults wholesale, exactly the reference's
        // PowerupsRules.readIni. Unsupported crate types are skipped.
        IniSection pws = ini.Section("Powerups");
        if (pws != null && pws.Count() > 0) {
            this.powerupTypes = new List<int>();
            this.powerupShares = new List<int>();
            this.powerupAnims = new List<string>();
            this.powerupWater = new List<bool>();
            this.powerupData = new List<string>();
            for (int i = 0; i < pws.Count(); i = i + 1) {
                string key = pws.EntryAt(i).Key().ToUpper();
                int pt = Rules.PowerupTypeOf(key);
                if (pt < 0) { continue; }
                if (pt == Rules.PowerupIonStorm() || pt == Rules.PowerupGas()
                 || pt == Rules.PowerupPod() || pt == Rules.PowerupSquad()) {
                    continue;
                }
                string val = pws.EntryAt(i).Value();
                List<string> parts = new List<string>();
                int at2 = 0;
                while (at2 <= val.Length) {
                    int comma = val.IndexOf(",", at2);
                    string part;
                    if (comma < 0) {
                        part = val.Substring(at2, val.Length - at2);
                        parts.Add(part.Trim());
                        break;
                    }
                    part = val.Substring(at2, comma - at2);
                    parts.Add(part.Trim());
                    at2 = comma + 1;
                }
                if (parts.Count < 4) { continue; }
                int shares = Rules.LeadingInt(parts[0]);
                string anim = parts[1].ToLower() == "<none>" || parts[1] == ""
                    ? null : parts[1].ToUpper();
                bool water = parts[2].ToLower() == "yes";
                string data = parts[3];
                this.powerupTypes.Add(pt);
                this.powerupShares.Add(shares);
                this.powerupAnims.Add(anim);
                this.powerupWater.Add(water);
                this.powerupData.Add(data);
            }
        }
        // The electro death anim is the [Animations] list's second entry
        // (the reference spreads the rules' animation table into a set and
        // takes names[1] -- retail's list starts TWLT100, ELECTRO).
        IniSection an = ini.Section("Animations");
        if (an != null) {
            List<string> vals = new List<string>();
            for (int i = 0; i < an.Count(); i = i + 1) {
                string v = an.EntryAt(i).Value().Trim().ToUpper();
                if (v.Length == 0 || v[0] == 59) { continue; }
                bool have = false;
                for (int k = 0; k < vals.Count; k = k + 1) {
                    if (vals[k] == v) { have = true; break; }
                }
                if (!have) { vals.Add(v); }
            }
            if (vals.Count > 1) { this.electroAnim = vals[1]; }
        }
        IniSection cd = ini.Section("CombatDamage");
        if (cd != null) {
            string spl = cd.Get("SplashList");
            if (spl.Length > 0) {
                this.splashList = Rules.Csv(spl.ToUpper());
            }
            // The explosion crate's warheads: the reference's
            // combatDamage.c4Warhead / .flameDamage, warhead names.
            string c4n = cd.Get("C4Warhead");
            if (c4n.Length > 0) { this.c4Warhead = c4n; }
            string fln = cd.Get("FlameDamage");
            if (fln.Length > 0) { this.flameDamage = fln; }
        }
        // Warheads first: weapons relink against them below.
        for (int i = 0; i < this.warheads.Count; i = i + 1) {
            Warhead w = this.warheads[i];
            IniSection s = ini.Section(w.Name());
            if (s == null) { continue; }
            string verses = s.Get("Verses");
            if (verses.Length > 0) {
                List<int> v = Rules.ParsePercents(verses);
                for (int a = 0; a < v.Count && a < ArmorClass.Count();
                     a = a + 1) {
                    w.SetVerse(a, v[a]);
                }
            }
            if (s.Contains("CellSpread")) {
                w.SetSpread(s.GetIntOr("CellSpread", w.Spread()));
            }
            if (s.Contains("Conventional")) {
                w.SetConventional(Rules.YesNo(s.Get("Conventional")));
            }
            if (s.Contains("ElectricAssault")) {
                w.SetElectricAssault(Rules.YesNo(s.Get("ElectricAssault")));
            }
            string anims = s.Get("AnimList");
            if (anims.Length > 0) {
                w.SetAnimList(Rules.Csv(anims.ToUpper()));
            }
            if (s.Contains("InfDeath")) {
                w.SetInfDeath(Rules.LeadingInt(s.Get("InfDeath")));
            }
        }
        for (int i = 0; i < this.weapons.Count; i = i + 1) {
            Weapon w = this.weapons[i];
            IniSection s = ini.Section(w.Name());
            if (s == null) { continue; }
            if (s.Contains("Damage")) { w.SetDamage(s.GetIntOr("Damage", w.Damage())); }
            if (s.Contains("ROF")) { w.SetRof(s.GetIntOr("ROF", w.Rof())); }
            string range = s.Get("Range");
            if (range.Length > 0) { w.SetRange(Rules.ParseRange(range)); }
            string wh = s.Get("Warhead");
            if (wh.Length > 0 && this.WarheadNamed(wh) != null) {
                w.SetWarhead(this.WarheadNamed(wh));
            }
            string spd = s.Get("Speed");
            if (spd.Length > 0) { w.SetSpeed(s.GetIntOr("Speed", w.Speed())); }
            string pj = s.Get("Projectile");
            if (pj.Length > 0) {
                w.SetProj(this.ProjectileFromIni(pj, ini));
            }
            bool laser = Rules.YesNo(s.Get("IsLaser"));
            bool bolt = Rules.YesNo(s.Get("IsElectricBolt"));
            bool rad = Rules.YesNo(s.Get("IsRadBeam"));
            if (laser || bolt || rad) { w.SetBeamFlags(laser, bolt, rad); }
            if (s.Contains("LaserDuration")) {
                w.SetLaserDuration(s.GetIntOr("LaserDuration",
                                              w.LaserDuration()));
            }
            string rep = s.Get("Report");
            if (rep.Length > 0) { w.SetReport(Rules.Csv(rep)); }
        }
        for (int i = 0; i < this.units.Count; i = i + 1) {
            UnitDef d = this.units[i];
            IniSection s = ini.Section(d.Reg());
            if (s == null) { continue; }
            if (s.Contains("Cost")) { d.SetCost(s.GetIntOr("Cost", d.Cost())); }
            if (s.Contains("Strength")) { d.SetHp(s.GetIntOr("Strength", d.Hp())); }
            if (s.Contains("Speed")) { d.SetSpeed(s.GetIntOr("Speed", d.Speed())); }
            d.SetDamageParticles(Rules.Csv(
                s.Get("DamageParticleSystems").ToUpper()));
            List<int> offU = new List<int>();
            Rules.ParseOffsetPair(s.Get("DamageSmokeOffset"), offU);
            if (offU.Count >= 2) {
                d.SetSmokeOffX(offU[0]);
                d.SetSmokeOffY(offU[1]);
            }
            if (s.Contains("Storage")) {
                d.SetStorage(s.GetIntOr("Storage", d.Storage()));
            }
            // Sight= caps at the reference's MAX_SIGHT (11); engineers'
            // 6 is handled by the needsEngineer default there, unlisted
            // types keep 1.
            if (s.Contains("Sight")) {
                int sv = s.GetIntOr("Sight", d.Sight());
                d.SetSight(sv > 11 ? 11 : sv);
            }
            string armor = s.Get("Armor");
            if (armor.Length > 0) { d.SetArmor(ArmorClass.Parse(armor)); }
            // The shipped tech tree, not a transcription of it: the rules
            // line names concrete regkeys and the [General] aliases (POWER,
            // PROC, RADAR, BARRACKS, TECH), and the resolver below turns each
            // token into the side's build ids.
            if (s.Contains("Prerequisite")) {
                d.SetPrereqTokens(Rules.Csv(s.Get("Prerequisite").ToUpper()));
            }
            if (s.Contains("TechLevel")) {
                d.SetTechLevel(s.GetIntOr("TechLevel", d.TechLevel()));
            }
            string image = s.Get("Image");
            if (image.Length > 0) {
                d.SetShp(image + Rules.ArtExtension(d.Shp()));
                d.SetArtKey(image.ToUpper());
            } else {
                d.SetArtKey(d.Reg());
            }
            string nt = s.Get("NewTheater");
            if (nt.Length > 0 && Rules.YesNo(nt)) { d.SetNewTheater(true); }
            string primary = s.Get("Primary");
            if (primary.Length > 0 && this.WeaponNamed(primary) != null) {
                d.SetPrimary(this.WeaponNamed(primary));
            }
            string secondary = s.Get("Secondary");
            if (secondary.Length > 0 && this.WeaponNamed(secondary) != null) {
                d.SetSecondary(this.WeaponNamed(secondary));
            }
            // Deploy semantics ride the install's own sections: the MCVs'
            // DeploysInto target and the infantry's Deployer flag, both
            // exactly the keys the shipped rulesmd.ini carries.
            string dep = s.Get("DeploysInto");
            if (dep.Length > 0) { d.SetDeploysInto(dep.ToUpper()); }
            string deployer = s.Get("Deployer");
            if (deployer.Length > 0) { d.SetDeployer(Rules.YesNo(deployer)); }
            // Order/selection voices: sound.ini names, the reference's
            // TechnoRules voice keys one read at a time.
            d.Voices().ReadIni(s);
        }
        // The neutral scenery units layer the same way, so an install that
        // restats its cows or gives a car an Image= override is honoured.
        for (int i = 0; i < this.civUnits.Count; i = i + 1) {
            UnitDef d = this.civUnits[i];
            IniSection s = ini.Section(d.Reg());
            if (s == null) { continue; }
            if (s.Contains("Strength")) { d.SetHp(s.GetIntOr("Strength", d.Hp())); }
            if (s.Contains("Speed")) { d.SetSpeed(s.GetIntOr("Speed", d.Speed())); }
            string armorC = s.Get("Armor");
            if (armorC.Length > 0) { d.SetArmor(ArmorClass.Parse(armorC)); }
            string imageC = s.Get("Image");
            if (imageC.Length > 0) {
                d.SetShp(imageC + Rules.ArtExtension(d.Shp()));
                d.SetArtKey(imageC.ToUpper());
            }
            d.Voices().ReadIni(s);
        }
        for (int i = 0; i < this.buildings.Count; i = i + 1) {
            BuildingDef d = this.buildings[i];
            IniSection s = ini.Section(d.Reg());
            if (s == null) { continue; }
            if (s.Contains("Cost")) { d.SetCost(s.GetIntOr("Cost", d.Cost())); }
            if (s.Contains("Strength")) { d.SetHp(s.GetIntOr("Strength", d.Hp())); }
            if (s.Contains("Sight")) {
                int sv = s.GetIntOr("Sight", d.Sight());
                d.SetSight(sv > 11 ? 11 : sv);
            }
            // The install's power key is SIGNED and single: positive output,
            // negative drain, and there is no Drain= key in the retail rules
            // at all. The transcribed table keeps the two apart, so split the
            // sign here. Assigning the raw value to Power alone (which is what
            // this did) left the built-in drain in place and pushed consumers
            // negative, so every barracks/war factory/refinery counted twice
            // and the sidebar's supply number silently fell.
            if (s.Contains("Power")) {
                int pw = s.GetIntOr("Power", d.Power());
                if (pw >= 0) { d.SetPower(pw); d.SetDrain(0); }
                else { d.SetPower(0); d.SetDrain(0 - pw); }
            } else if (s.Contains("Drain")) {
                d.SetDrain(s.GetIntOr("Drain", d.Drain()));
            }
            string image = s.Get("Image");
            if (image.Length > 0) {
                d.SetShp(image + Rules.ArtExtension(d.Shp()));
                d.SetArtKey(image.ToUpper());
            }
            // The same shipped tech tree the units and the card list use: a
            // structure's Prerequisite= is why the sidebar is dead until the
            // construction yard stands (GAPOWR is Prerequisite=GACNST, and
            // every other structure chains off it).
            if (s.Contains("Prerequisite")) {
                d.SetPrereqTokens(Rules.Csv(s.Get("Prerequisite").ToUpper()));
            }
            if (s.Contains("TechLevel")) {
                d.SetTechLevel(s.GetIntOr("TechLevel", d.TechLevel()));
            }
            // WaterBound= is the shipyard's floating flag: its footprint must
            // be water, never land. Everything else in the shipped rules
            // stands on ground.
            string wb = s.Get("WaterBound");
            if (wb.Length > 0) { d.SetWaterBound(Rules.YesNo(wb)); }
            string ntB = s.Get("NewTheater");
            if (ntB.Length > 0 && Rules.YesNo(ntB)) { d.SetNewTheater(true); }
            d.SetDamageParticles(Rules.Csv(
                s.Get("DamageParticleSystems").ToUpper()));
            List<int> offB = new List<int>();
            Rules.ParseOffsetPair(s.Get("DamageSmokeOffset"), offB);
            if (offB.Count >= 2) {
                d.SetSmokeOffX(offB[0]);
                d.SetSmokeOffY(offB[1]);
            }
            d.Voices().ReadIni(s);
        }
        IniSection general = ini.Section("General");
        if (general != null) {
            this.alternateArcticArt = Rules.YesNo(
                general.GetOr("AlternateArcticArt", "no"));
            this.oreGrows = Rules.YesNo(general.GetOr("TiberiumGrows", "yes"));
            this.oreSpreads = Rules.YesNo(general.GetOr("TiberiumSpreads",
                                                        "yes"));
            this.growthRate = Rules.LeadingInt(general.GetOr("GrowthRate",
                                                             "5"));
        }
        IniSection combat = ini.Section("CombatDamage");
        if (combat != null && combat.Contains("BridgeStrength")) {
            this.bridgeStrength = combat.GetIntOr("BridgeStrength",
                                                  this.bridgeStrength);
            this.preqPower = Rules.CsvOr(general, "PrerequisitePower",
                                         this.preqPower);
            this.preqFactory = Rules.CsvOr(general, "PrerequisiteFactory",
                                           this.preqFactory);
            this.preqBarracks = Rules.CsvOr(general, "PrerequisiteBarracks",
                                            this.preqBarracks);
            this.preqRadar = Rules.CsvOr(general, "PrerequisiteRadar",
                                         this.preqRadar);
            this.preqTech = Rules.CsvOr(general, "PrerequisiteTech",
                                        this.preqTech);
            this.preqProc = Rules.CsvOr(general, "PrerequisiteProc",
                                        this.preqProc);
            this.refundPercent = Rules.LeadingInt(general.GetOr(
                "RefundPercent", Convert.ToString(this.refundPercent)));
            this.repairPercent = Rules.LeadingInt(general.GetOr(
                "RepairPercent", Convert.ToString(this.repairPercent)));
            this.repairStep = Rules.LeadingInt(general.GetOr(
                "RepairStep", Convert.ToString(this.repairStep)));
        }
        IniSection ai = ini.Section("AI");
        if (ai != null) {
            this.aiConst = Rules.CsvOr(ai, "BuildConst", this.aiConst);
            this.aiPower = Rules.CsvOr(ai, "BuildPower", this.aiPower);
            this.aiRefinery = Rules.CsvOr(ai, "BuildRefinery", this.aiRefinery);
            this.aiBarracks = Rules.CsvOr(ai, "BuildBarracks", this.aiBarracks);
            this.aiWeapons = Rules.CsvOr(ai, "BuildWeapons", this.aiWeapons);
            this.aiTech = Rules.CsvOr(ai, "BuildTech", this.aiTech);
            this.aiRadar = Rules.CsvOr(ai, "BuildRadar", this.aiRadar);
            this.aiDefense = Rules.CsvOr(ai, "BuildDefense", this.aiDefense);
        }
        // The overlay type table: keys 1..n map to indices 0..n-1, exactly
        // how the map's OverlayPack bytes index it (GEM01 is key 28,
        // therefore byte value 27, in this install's rules).
        IniSection ov = ini.Section("OverlayTypes");
        if (ov != null) {
            this.overlayTypes = new List<string>();
            for (int i = 0; i < ov.Count(); i = i + 1) {
                string name = ov.EntryAt(i).Value().Trim();
                int semi = -1;
                for (int c = 0; c < name.Length; c = c + 1) {
                    if (name[c] == 59) { semi = c; break; }
                }
                if (semi >= 0) { name = name.Substring(0, semi).Trim(); }
                this.overlayTypes.Add(name);
            }
        }
        // The smudge table: numbered keys like OverlayTypes, and each reg's
        // own section (the same ini) carries Burn=/Crater=/Width=/Height=.
        // The section lookup is exact-match, so the reg name uppercases
        // first -- the shipped sections are all caps.
        IniSection smt = ini.Section("SmudgeTypes");
        if (smt != null) {
            this.smudgeTypes = new List<string>();
            this.smudgeBurn = new List<int>();
            this.smudgeCrater = new List<int>();
            this.smudgeWidth = new List<int>();
            this.smudgeHeight = new List<int>();
            for (int i = 0; i < smt.Count(); i = i + 1) {
                string name = smt.EntryAt(i).Value().Trim();
                int semi = -1;
                for (int c = 0; c < name.Length; c = c + 1) {
                    if (name[c] == 59) { semi = c; break; }
                }
                if (semi >= 0) { name = name.Substring(0, semi).Trim(); }
                if (name.Length == 0) { continue; }
                name = name.ToUpper();
                this.smudgeTypes.Add(name);
                IniSection sec = ini.Section(name);
                this.smudgeBurn.Add(sec != null && Rules.YesNo(sec.GetOr("Burn", "no")) ? 1 : 0);
                this.smudgeCrater.Add(sec != null && Rules.YesNo(sec.GetOr("Crater", "no")) ? 1 : 0);
                List<int> w = sec != null ? Rules.LeadingInts(sec.GetOr("Width", "1")) : new List<int>();
                List<int> hh = sec != null ? Rules.LeadingInts(sec.GetOr("Height", "1")) : new List<int>();
                this.smudgeWidth.Add(w.Count > 0 ? w[0] : 1);
                this.smudgeHeight.Add(hh.Count > 0 ? hh[0] : 1);
            }
        }
        // Sidebar names come from the install's own string table, the same
        // labels the original menu showed: each unit/building's UIName points
        // at a CSF label (Name:E1 -> 美国大兵). Only overrides; anything the
        // table lacks keeps the transcribed default.
        if (this.strings != null) {
            for (int i = 0; i < this.units.Count; i = i + 1) {
                UnitDef d = this.units[i];
                IniSection s = ini.Section(d.Reg());
                if (s == null) { continue; }
                string ui = s.Get("UIName");
                if (ui.Length == 0) { continue; }
                string text = this.strings.Lookup(ui);
                if (text != null && text.Length > 0) { d.SetLabel(text); }
            }
            for (int i = 0; i < this.buildings.Count; i = i + 1) {
                BuildingDef d = this.buildings[i];
                IniSection s = ini.Section(d.Reg());
                if (s == null) { continue; }
                string ui = s.Get("UIName");
                if (ui.Length == 0) { continue; }
                string text = this.strings.Lookup(ui);
                if (text != null && text.Length > 0) { d.SetLabel(text); }
            }
        }
    }

    /// <summary>Applies the art ini (ART.INI with ARTMD.INI layered on top):
    /// each infantry's Sequence= section tells where its walk and stand
    /// frames start, and the walk cycle's length -- e.g. [GI]
    /// Sequence=GISequence, [GISequence] Walk=8,6,6 Ready=0,1,1. Without
    /// this, every trooper would march through the wrong frames. Buildings
    /// flagged NewTheater=yes ship one sprite per theater, addressed by the
    /// file name's second letter (GAtcnst for temperate); the renderer swaps
    /// that letter against the loaded map's theater.</summary>
    void ApplyArtIni(IniDocument art) {
        if (art == null) { return; }
        this.artIni = art;
        for (int i = 0; i < this.buildings.Count; i = i + 1) {
            BuildingDef d = this.buildings[i];
            if (d.ArtKey() == null) { continue; }
            IniSection section = art.Section(d.ArtKey());
            if (section == null) { continue; }
            string nt = section.Get("NewTheater");
            if (nt.Length > 0 && Rules.YesNo(nt)) { d.SetNewTheater(true); }
            // The sidebar portrait's art file, the way the reference engine
            // resolves it: the art section's Cameo= stem + ICON.SHP.
            string cameo = section.Get("Cameo");
            if (cameo.Length > 0) { d.SetCameo(cameo.ToUpper()); }
            // The footprint lives in the art, not the rules: Foundation=WxH.
            // It is what the placement ghost stamps on the cell grid and what
            // the drawn SHP's anchor is centred against, so a hand-typed
            // value that disagrees (the yard is 4x4, not 4x3; the war factory
            // 5x3, not 3x2) puts the art and the occupancy on different
            // cells. The art's own number wins.
            string found = section.Get("Foundation");
            if (found.Length > 0) {
                List<int> fwh = Rules.LeadingInts(Rules.FoundationTokens(found));
                if (fwh.Count >= 2) { d.SetFootprint(fwh[0], fwh[1]); }
            }
        }
        for (int i = 0; i < this.units.Count; i = i + 1) {
            UnitDef d = this.units[i];
            if (d.ArtKey() == null) { continue; }
            IniSection section = art.Section(d.ArtKey());
            if (section == null) { continue; }
            string nt = section.Get("NewTheater");
            if (nt.Length > 0 && Rules.YesNo(nt)) { d.SetNewTheater(true); }
            // The portrait's shipped stem, read the way the original reads it:
            // the art section named by the unit's Image= key. The install's
            // data is explicit about it -- [CMIN] Cameo=AHRVICON,
            // [ENGINEER] Cameo=ENGNICON, [GGI] Cameo=GDGIICON -- so guessing
            // <reg>ICON.SHP from the rules name picks the wrong picture (or
            // no picture) for a dozen units. A ';' list picks its first name.
            string cameo = section.Get("Cameo");
            if (cameo.Length > 0) { d.SetCameo(Rules.FirstToken(cameo)); }
            string seqName = section.Get("Sequence");
            if (seqName.Length == 0) { continue; }
            IniSection seq = art.Section(seqName);
            if (seq == null) { continue; }
            List<int> ready = Rules.LeadingInts(seq.Get("Ready"));
            if (ready.Count >= 1) { d.SetReadySeq(ready[0]); }
            List<int> walk = Rules.LeadingInts(seq.Get("Walk"));
            if (walk.Count >= 2) { d.SetWalkSeq(walk[0], walk[1]); }
            // The sat-down pose the Deployer=yes troops toggle into. Its
            // block is one frame per facing (GISequence Deployed=292,1,1),
            // so frame = start + facing.
            List<int> dep = Rules.LeadingInts(seq.Get("Deployed"));
            if (dep.Count >= 2) { d.SetDeployedSeq(dep[0], dep[1]); }
            // The two transitions the reference's
            // getStanceTransitionSequenceBy picks: Deploy plays once going
            // down (GISequence Deploy=300,15,0), Undeploy once coming back
            // up (276,2,2 -- the same block Up shares).
            List<int> dpl = Rules.LeadingInts(seq.Get("Deploy"));
            if (dpl.Count >= 2) { d.SetDeploySeq(dpl[0], dpl[1]); }
            List<int> und = Rules.LeadingInts(seq.Get("Undeploy"));
            if (und.Count >= 2) { d.SetUndeploySeq(und[0], und[1]); }
            // DeployedFire: the emplacement's own firing block (315,6,6) --
            // the pose a deployed GI shoots from, not the standing FireUp.
            List<int> dfire = Rules.LeadingInts(seq.Get("DeployedFire"));
            if (dfire.Count >= 2) {
                d.SetDeployedFireSeq(dfire[0], dfire[1],
                                     dfire.Count >= 3 ? dfire[2] : dfire[1]);
            }
            List<int> fire = Rules.LeadingInts(seq.Get("FireUp"));
            if (fire.Count >= 2) {
                d.SetFireSeq(fire[0], fire[1],
                             fire.Count >= 3 ? fire[2] : fire[1]);
            }
            List<int> d1 = Rules.LeadingInts(seq.Get("Die1"));
            if (d1.Count >= 2) {
                d.SetDie1Seq(d1[0], d1[1], d1.Count >= 3 ? d1[2] : 0);
            }
            List<int> d2 = Rules.LeadingInts(seq.Get("Die2"));
            if (d2.Count >= 2) {
                d.SetDie2Seq(d2[0], d2[1], d2.Count >= 3 ? d2[2] : 0);
            }
            // The suppression family: still pose, prone walk, the drop
            // and rise transitions, and the prone firing block.
            List<int> pr = new List<int>();
            string[] pkeys = new string[] { "Prone", "Crawl", "Down",
                                            "Up", "FireProne" };
            for (int k = 0; k < 5; k = k + 1) {
                List<int> v = Rules.LeadingInts(seq.Get(pkeys[k]));
                pr.Add(v.Count >= 1 ? v[0] : 0);
                pr.Add(v.Count >= 2 ? v[1] : 0);
                pr.Add(v.Count >= 3 ? v[2] : 0);
            }
            d.SetProneSeqs(pr);
        }
        // A projectile's smoke trail is art-ini data (Trailer= anim dropped
        // every SpawnDelay= ticks along the flight path), so it resolves
        // here, after the art document is in.
        for (int i = 0; i < this.projectiles.Count; i = i + 1) {
            ProjectileType p = this.projectiles[i];
            IniSection psec = art.Section(p.Name());
            if (psec == null && p.Image().Length > 0) {
                psec = art.Section(p.Image());
            }
            if (psec == null) { continue; }
            string tr = psec.Get("Trailer");
            if (tr.Length > 0 && tr.ToLower() != "none") {
                p.SetTrailer(tr.ToUpper());
            }
            p.SetTrailerDelay(psec.GetIntOr("SpawnDelay", p.TrailerDelay()));
        }
    }

    /// <summary>Leading comma-separated integers of "8,6,6" into [8,6];
    /// stops at the first token that starts with a non-number. Empty input
    /// yields an empty list.</summary>
    static List<int> LeadingInts(string s) {
        List<int> vals = new List<int>();
        if (s == null) { return vals; }
        List<string> parts = Rules.Csv(s);
        for (int i = 0; i < parts.Count; i = i + 1) {
            string part = parts[i];
            if (part.Length == 0 || part[0] < 48 || part[0] > 57) { break; }
            vals.Add(Rules.LeadingInt(part));
        }
        return vals;
    }

    // ---- small string helpers ------------------------------------------------

    /// <summary>The first name in a ';'-separated list ([YURI]
    /// Cameo=YCLNICON;YURIICON), uppercased. The whole string when it has no
    /// semicolon.</summary>
    static string FirstToken(string s) {
        if (s == null) { return ""; }
        for (int i = 0; i < s.Length; i = i + 1) {
            if (s.Substring(i, 1) == ";") {
                return s.Substring(0, i).Trim().ToUpper();
            }
        }
        return s.Trim().ToUpper();
    }

    /// <summary>"4x4" / "5 x 3" into "4,4" / "5,3" so the shared integer
    /// reader can take a Foundation= value. Only the first two numbers
    /// matter; the reference's foundations are all plain rectangles.</summary>
    static string FoundationTokens(string s) {
        if (s == null) { return ""; }
        string outS = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == "x" || ch == "X") { outS = outS + ","; continue; }
            outS = outS + ch;
        }
        return outS;
    }

    /// <summary>"a,b, c" into ["a","b","c"], dropping blanks.</summary>
    /// <summary>First two comma ints of an offset triple, in raw ini
    /// units (leptons). The values run negative -- LeadingInts stops at
    /// the '-' -- so the parts parse one by one.</summary>
    static void ParseOffsetPair(string raw, List<int> into) {
        List<string> parts = Rules.Csv(raw == null ? "" : raw);
        if (parts.Count < 2) { return; }
        into.Add(Rules.LeadingInt(parts[0]));
        into.Add(Rules.LeadingInt(parts[1]));
    }

    /// <summary>The unit rules section declared by <paramref name="reg"/>,
    /// or null. Per-techno keys (DamageParticleSystems and friends) live
    /// on the def, not on any global list.</summary>
    UnitDef UnitDefNamed(string reg) {
        if (reg == null) { return null; }
        for (int i = 0; i < this.units.Count; i = i + 1) {
            if (this.units[i].Reg() == reg) { return this.units[i]; }
        }
        return null;
    }

    /// <summary>The building rules section declared by
    /// <paramref name="reg"/>, or null.</summary>
    BuildingDef BuildingDefNamed(string reg) {
        if (reg == null) { return null; }
        for (int i = 0; i < this.buildings.Count; i = i + 1) {
            if (this.buildings[i].Reg() == reg) { return this.buildings[i]; }
        }
        return null;
    }

    static List<string> Csv(string s) {
        List<string> parts = new List<string>();
        int start = 0;
        for (int i = 0; i <= s.Length; i = i + 1) {
            if (i == s.Length || s.Substring(i, 1) == ",") {
                if (i > start) {
                    string part = s.Substring(start, i - start).Trim();
                    if (part.Length > 0) { parts.Add(part); }
                }
                start = i + 1;
            }
        }
        return parts;
    }

    static List<string> CsvOr(IniSection s, string key, List<string> fallback) {
        string raw = s.Get(key);
        if (raw.Length == 0) { return fallback; }
        return Rules.Csv(raw);
    }

    /// <summary>"100%,80%,..." into [100,80,...]; a bare number works too.</summary>
    static List<int> ParsePercents(string s) {
        List<int> parts = new List<int>();
        int start = 0;
        for (int i = 0; i <= s.Length; i = i + 1) {
            if (i == s.Length || s.Substring(i, 1) == ",") {
                if (i > start) {
                    string part = s.Substring(start, i - start).Trim();
                    if (part.Length > 0) {
                        if (part.Substring(part.Length - 1, 1) == "%") {
                            part = part.Substring(0, part.Length - 1);
                        }
                        parts.Add(Convert.ToInt32(part));
                    }
                }
                start = i + 1;
            }
        }
        return parts;
    }

    /// <summary>RA2 ranges are fractional ("5.5"); the grid wants whole
    /// cells, rounded up so a gunner keeps his published reach.</summary>
    static int ParseRange(string s) {
        string t = s.Trim();
        int dot = -1;
        for (int i = 0; i < t.Length; i = i + 1) {
            if (t.Substring(i, 1) == ".") { dot = i; break; }
        }
        if (dot < 0) { return Convert.ToInt32(t); }
        int whole = Convert.ToInt32(t.Substring(0, dot));
        string frac = t.Substring(dot + 1, t.Length - dot - 1).Trim();
        if (frac.Length > 0 && frac != "0") { whole = whole + 1; }
        return whole;
    }
}
