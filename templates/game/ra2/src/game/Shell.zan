using System;
using System.Collections.Generic;

namespace Ra2.Game;

/// <summary>Which screen the shell is showing.</summary>
class Scene {
    static int MainMenu() { return 0; }
    static int SkirmishSetup() { return 1; }
    static int Playing() { return 2; }
}

/// <summary>The two RA2 sides a player can pick.</summary>
class Side {
    static int Allied() { return 0; }
    static int Soviet() { return 1; }

    static string NameOf(int side) {
        if (side == Side.Soviet()) { return "苏联"; }
        return "盟军";
    }
}

/// <summary>Shell state: which screen is up, and what the player has chosen
/// on the skirmish setup screen.</summary>
///
/// Kept apart from rendering so the flow -- menu to setup to game, and back --
/// can be tested without a window. The screens themselves only read this and
/// call the transitions.
class Shell {
    int scene;
    int mapIndex;
    int side;
    int mapCount;
    bool quit;

    static Shell Create(int mapCount) {
        Shell s = new Shell();
        s.scene = Scene.MainMenu();
        s.mapIndex = 0;
        s.side = Side.Allied();
        s.mapCount = mapCount;
        s.quit = false;
        return s;
    }

    int CurrentScene() { return this.scene; }
    int MapIndex() { return this.mapIndex; }
    int SideIndex() { return this.side; }
    int MapCount() { return this.mapCount; }
    bool WantsQuit() { return this.quit; }

    void Quit() { this.quit = true; }

    /// <summary>Main menu -> skirmish setup.</summary>
    void OpenSkirmish() {
        if (this.mapCount > 0) { this.scene = Scene.SkirmishSetup(); }
    }

    /// <summary>Setup -> playing. Refused when the install has no maps, so the
    /// shell cannot enter a game with nothing to load.</summary>
    bool StartGame() {
        if (this.mapCount == 0) { return false; }
        this.scene = Scene.Playing();
        return true;
    }

    /// <summary>Back out one screen. From the game that means the setup
    /// screen, from setup the main menu; the main menu has nowhere to go.</summary>
    void Back() {
        if (this.scene == Scene.Playing()) {
            this.scene = Scene.SkirmishSetup();
            return;
        }
        if (this.scene == Scene.SkirmishSetup()) {
            this.scene = Scene.MainMenu();
        }
    }

    /// <summary>Moves the map selection, wrapping at both ends so the arrow
    /// keys cycle rather than sticking.</summary>
    void SelectMap(int delta) {
        if (this.mapCount <= 0) { return; }
        int n = this.mapIndex + delta;
        while (n < 0) { n = n + this.mapCount; }
        this.mapIndex = n % this.mapCount;
    }

    void SelectMapAt(int index) {
        if (index < 0 || index >= this.mapCount) { return; }
        this.mapIndex = index;
    }

    void SetSide(int side) {
        if (side == Side.Allied() || side == Side.Soviet()) { this.side = side; }
    }

    void ToggleSide() {
        if (this.side == Side.Allied()) { this.side = Side.Soviet(); }
        else { this.side = Side.Allied(); }
    }
}
