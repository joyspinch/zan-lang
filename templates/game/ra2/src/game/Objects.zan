using System;
using System.Collections.Generic;
using Ra2.Formats;
using Ra2.Assets;

namespace Ra2.Game;

/// <summary>The sides, mirroring the shell's selection. Yuri (2) is the
/// third skirmish side; Neutral (3) owns the map's civilian structures: they
/// can be captured by engineers but never act, and nobody needs them
/// destroyed to win.</summary>
class Side2 {
    static int Allied() { return 0; }
    static int Soviet() { return 1; }
    static int Yuri() { return 2; }
    static int Neutral() { return 3; }
    static int Count() { return 3; }
}

/// <summary>A built thing in the world: a structure or a movable unit.
/// Only the game state lives here -- art, hit-testing and drawing belong to
/// the render layer, which reads these fields.</summary>
class WorldObject {
    int kind;        // ObjKind: Structure or Unit
    int side;        // Side2
    int x;           // current cell
    int y;
    int hp;
    int maxHp;
    int buildId;     // index into the type tables (StructureType / UnitType)
    UnitType unitType;   // a unit's archetype; null for structures
    int unitId;          // index into UnitCatalog for a unit; -1 for structures
    int target;          // object index under attack, or -1
    int reload;          // ticks until the next shot
    bool selected;
    int smokeTicks;      // ticks spent venting damage smoke (80s cap)
    List<FxAnim> fires;  // the burning anims seeded while damaged
    List<FxAnim> idles;  // the structure's constant IdleAnim loop
    string idleName;     // which idle variant is live ("" none)
    int fireTicks;       // ticks left in the firing pose (infantry)
    int suppTicks;       // suppression: the trooper stays prone while > 0
    int poseTicks;       // ticks left in the Down/Up transition
    int poseSeq;         // 0 dropping prone, 1 rising
    int deposeTicks;     // ticks left in the Deploy/Undeploy transition
    int deposeSeq;       // 0 sitting down, 1 packing up
    // (accessors DepPoseTicks/DepPoseSeq below read these)
    int infDeath = 1;    // the killing warhead's InfDeath (retail default
                         // Gunfire on the object; the warhead overwrites)
    // How the object died, the reference's DeathType: Normal by default,
    // Crush when a crusher ran it over. The crush path matters to the
    // renderer (a crushed trooper leaves no corpse) and to the game
    // (a crushed wall plays its own squish key instead of the die cry).
    int deathType = 0;
    // The crushing hull's rocking request, the reference's Vehicle.rocking:
    // a vehicle that flattens a wall gets a brief tilt, its facing and
    // intensity carried here for the renderer. rockFactor is in thousandths
    // (500 = the reference's 0.5). rockTicks counts down; 0 = no rocking.
    int rockTicks = 0;
    int rockFacing = 0;
    int rockFactor = 0;
    // The live Crusher= flag, the reference's Techno.crusher: seeded from
    // the type at spawn and flipped on by the veteran CRUSHER ability at
    // promotion (VeteranTrait.handlePromotion).
    bool crusher = false;
    // A trooper's suppression pause after a near miss (the reference's
    // isPanicked), which the scatter order also sets.
    bool panicked = false;

    // Movement (units only): the planned route as cells, and how far along it
    // the unit has walked this frame.
    List<int> pathX;
    List<int> pathY;
    int pathAt;
    int animFrame;      // walk-cycle frame counter (units only)
    int facing;         // 0-7 compass direction the unit faces
    int turretFacing;   // 0-8: compass ring, 8 = resetting toward the body
    int turretTurn;     // ticks until the turret takes its next step
    // The reference's movement ledger: each tick adds the rules Speed, and
    // every CELL_MOVE_COST (64) banked buys one cell step. A Speed=4 rifleman
    // thus advances a cell every 16 ticks instead of teleporting.
    int moveAccum;
    // Move-attack: a destination cell the unit walks to, attacking any enemy
    // it comes across on the way. -1 when inactive.
    int maX;
    int maY;

    // Veterancy, the reference's VeteranTrait: the rank (0 rookie, 1
    // veteran, 2 elite), accumulated experience and the crate upgrade
    // multipliers (1 = unboosted; a crate sets one and it lasts for life).
    int veteranLevel;
    int veteranXp;
    int crateArmor;
    int crateFirepower;
    int crateSpeed;

    // Production (structures only): the unit ids being trained and the ticks
    // remaining before each is ready to walk out of the building.
    List<int> prodQueue;
    List<int> prodLeft;

    // Construction (structures only): ticks since placement. While this is
    // below the building's build time, the renderer shows the construction
    // animation instead of the finished structure.
    int builtTicks;

    // Special-weapon state: a chrono beam leaves the target frozen for a few
    // ticks; Ivan sticks a timed bomb on whatever he reaches.
    int frozen;        // ticks the object stays frozen, 0 = free
    int bombTimer;     // ticks until the planted bomb detonates, -1 = none
    // A superweapon building's charge bank: ticks of powered uptime since
    // the last launch, capped at the rules SwRecharge. Ready when full.
    int swCharge;

    // Render cache (filled by the renderer, read back next frame): a packed
    // identity of everything that picks the body (and turret) sprite. When
    // the packed value matches, the frame reuses the last texture and never
    // builds a sprite key nor searches the shared memo -- that search is what
    // made hundred-unit battles crawl. Dies with the object, so it can never
    // dangle across the world's index compaction.
    int artStampA;
    Ra2.Render.R2Tex artTexA;
    int artStampB;
    Ra2.Render.R2Tex artTexB;
    bool civ;          // a map civilian structure (lives in the civ catalog)

    // Harvester state (units with the harvester role): credits in the hold,
    // a countdown that paces mining passes and unloading, and a retry delay
    // that keeps a stranded harvester from re-running whole-map pathing
    // every single tick.
    int cargo;
    int bails;           // bails mined since the last unload (Storage=)
    int dockTimer;
    int routeCooldown;

    // Structures under the wrench: true while the owner pays to patch the
    // building up. Cleared automatically at full health.
    bool repairing;
    int repairAt;      // world tick of the next repair step
    int repairCarry;   // unbilled fraction of a credit from the last step

    // Deployer infantry only: true while the trooper is sat down in his
    // emplacement. A deployed soldier holds his ground -- the movement loop
    // skips him and a fresh move order stands him back up.
    bool deployed;

    static WorldObject CreateStructure(int side, int buildId, int x, int y,
                                       int hp) {
        WorldObject o = new WorldObject();
        o.kind = ObjKind.Structure();
        o.side = side;
        o.buildId = buildId;
        o.unitType = null;
        o.unitId = -1;
        o.x = x;
        o.y = y;
        o.hp = hp;
        o.maxHp = hp;
        o.target = -1;
        o.reload = 0;
        o.selected = false;
        o.pathX = null;
        o.prodQueue = new List<int>();
        o.prodLeft = new List<int>();
        o.builtTicks = 0;
        o.frozen = 0;
        o.bombTimer = -1;
        o.swCharge = 0;
        o.civ = false;
        o.cargo = 0;
        o.dockTimer = 0;
        o.routeCooldown = 0;
        o.repairing = false;
        o.repairAt = 0;
        o.repairCarry = 0;
        o.deployed = false;
        o.deposeTicks = 0;
        o.deposeSeq = 0;
        o.veteranLevel = 0;
        o.veteranXp = 0;
        o.crateArmor = 1;
        o.crateFirepower = 1;
        o.crateSpeed = 1;
        o.deathType = DeathType.Normal();
        o.rockTicks = 0;
        o.rockFacing = 0;
        o.rockFactor = 0;
        o.panicked = false;
        return o;
    }

    static WorldObject CreateUnit(int side, int unitId, int x, int y, int hp,
                                  UnitType ut) {
        WorldObject o = new WorldObject();
        o.kind = ObjKind.Unit();
        o.side = side;
        o.buildId = -1;
        o.unitType = ut;
        o.unitId = unitId;
        o.x = x;
        o.y = y;
        o.hp = hp;
        o.maxHp = hp;
        o.target = -1;
        o.reload = 0;
        o.selected = false;
        o.pathX = null;
        o.prodQueue = null;
        o.prodLeft = null;
        o.builtTicks = 0;
        o.animFrame = 0;
        o.facing = 0;
        o.turretFacing = 0;
        o.turretTurn = 0;
        o.maX = -1;
        o.maY = -1;
        o.frozen = 0;
        o.bombTimer = -1;
        o.swCharge = 0;
        o.civ = false;
        o.cargo = 0;
        o.dockTimer = 0;
        o.routeCooldown = 0;
        o.repairing = false;
        o.repairAt = 0;
        o.repairCarry = 0;
        o.deployed = false;
        o.deposeTicks = 0;
        o.deposeSeq = 0;
        o.veteranLevel = 0;
        o.veteranXp = 0;
        o.crateArmor = 1;
        o.crateFirepower = 1;
        o.crateSpeed = 1;
        o.deathType = DeathType.Normal();
        o.rockTicks = 0;
        o.rockFacing = 0;
        o.rockFactor = 0;
        o.crusher = ut != null && ut.Crusher();
        o.panicked = false;
        return o;
    }

    int Kind() { return this.kind; }
    int Side() { return this.side; }
    int X() { return this.x; }
    int Y() { return this.y; }
    int Hp() { return this.hp; }
    int MaxHp() { return this.maxHp; }
    int BuildId() { return this.buildId; }
    int UnitId() { return this.unitId; }
    bool IsSelected() { return this.selected; }
    void SetSelected(bool sel) { this.selected = sel; }
    UnitType UnitType() { return this.unitType; }
    bool Amphibious() {
        return this.unitType != null
            && (this.unitType.Amphibious() || this.unitType.Flying());
    }

    /// <summary>True for a unit whose archetype flies: it plans routes over
    /// water, cliffs and walls, steps without touching the occupancy index,
    /// and only AntiAir guns may acquire it as a target.</summary>
    bool IsFlying() {
        return this.unitType != null && this.unitType.Flying();
    }
    int TargetIndex() { return this.target; }
    void SetTarget(int idx) { this.target = idx; }
    int Reload() { return this.reload; }
    void SetReload(int ticks) { this.reload = ticks; }
    void TakeDamage(int dmg) { this.hp = this.hp - dmg; if (this.hp < 0) { this.hp = 0; } }
    void SetHp(int hp) { this.hp = hp; if (this.hp > this.maxHp) { this.hp = this.maxHp; } }
    bool IsDead() { return this.hp <= 0; }
    int FireTicks() { return this.fireTicks; }
    void SetFireTicks(int v) { this.fireTicks = v; }
    int SuppTicks() { return this.suppTicks; }
    int PoseTicks() { return this.poseTicks; }
    int PoseSeq() { return this.poseSeq; }
    int DepPoseTicks() { return this.deposeTicks; }
    int DepPoseSeq() { return this.deposeSeq; }

    /// <summary>Suppress the trooper: he drops prone for 30 ticks (the
    /// reference's SuppressionTrait), playing the Down block first; a
    /// trooper already down just stays down.</summary>
    void SetSuppTicks(int v) {
        if (v > this.suppTicks && this.suppTicks <= 0) {
            this.poseSeq = 0;
            this.poseTicks = this.PoseBlockFrames(0) * 2;
        }
        if (v > this.suppTicks) { this.suppTicks = v; }
    }

    /// <summary>Frames of a prone transition block: 0 the Down drop,
    /// 1 the Up rise; 0 when the art omits it.</summary>
    int PoseBlockFrames(int seq) {
        if (this.unitType == null || !this.unitType.HasProne()) {
            return 0;
        }
        return seq == 0 ? this.unitType.ProneAt(8)
                        : this.unitType.ProneAt(11);
    }
    int InfDeath() { return this.infDeath; }
    void SetInfDeath(int d) { this.infDeath = d; }
    int DeathType() { return this.deathType; }
    void SetDeathType(int t) { this.deathType = t; }
    bool Crusher() { return this.crusher; }
    void SetCrusher(bool on) { this.crusher = on; }
    bool Panicked() { return this.panicked; }
    void SetPanicked(bool on) { this.panicked = on; }
    /// <summary>Requests the crush rocking, the reference's
    /// Vehicle.applyRocking: a hull already rocking keeps its remaining
    /// ticks rather than restarting, and the run lasts ROCKING_TICKS. The
    /// reference also exempts consideredAircraft; the port models no
    /// aircraft yet, so that clause waits with them.</summary>
    void ApplyRocking(int facing, int factor) {
        if (this.rockTicks <= 0) { this.rockTicks = WorldObject.RockingTicks(); }
        this.rockFacing = facing;
        this.rockFactor = factor;
    }
    /// <summary>The reference's ROCKING_TICKS: how many ticks a rocking
    /// hull takes to settle.</summary>
    static int RockingTicks() { return 34; }
    int RockTicks() { return this.rockTicks; }
    int RockFacing() { return this.rockFacing; }
    int RockFactor() { return this.rockFactor; }
    void SetRockTicks(int t) { this.rockTicks = t; }
    /// <summary>Damage that also records which warhead is killing the
    /// object, so an infantry death can pick its art the way the
    /// reference's Warhead.inflictDamage does.</summary>
    void TakeDamageAs(int dmg, int death) {
        this.hp = this.hp - dmg;
        if (this.hp < 0) { this.hp = 0; }
        if (death > 0) { this.infDeath = death; }
    }
    /// <summary>Drops the attack order. The route dies with it: a soldier
    /// whose target just fell keeps walking to the death cell otherwise --
    /// tgt gone, route still set -- instead of re-engaging what is around
    /// him.</summary>
    void StopAttack() {
        this.target = -1;
        this.reload = 0;
        this.pathX = null;
        this.pathY = null;
        this.pathAt = 0;
    }

    /// <summary>Flips the object's owner -- a captured building or a
    /// mind-controlled soldier. The archetype stays the same; only the side
    /// changes.</summary>
    void SetSide(int side) { this.side = side; }

    int Frozen() { return this.frozen; }
    int MoveAccum() { return this.moveAccum; }
    void SetMoveAccum(int v) { this.moveAccum = v; }

    int VeteranLevel() { return this.veteranLevel; }
    void SetVeteranLevel(int lvl) { this.veteranLevel = lvl; }
    int VeteranXp() { return this.veteranXp; }
    void SetVeteranXp(int xp) { this.veteranXp = xp; }
    int CrateArmor() { return this.crateArmor; }
    void SetCrateArmor(int mult) { this.crateArmor = mult; }
    int CrateFirepower() { return this.crateFirepower; }
    void SetCrateFirepower(int mult) { this.crateFirepower = mult; }
    int CrateSpeed() { return this.crateSpeed; }
    void SetCrateSpeed(int mult) { this.crateSpeed = mult; }
    void SetFrozen(int ticks) { this.frozen = ticks; }
    int BombTimer() { return this.bombTimer; }
    void SetBombTimer(int ticks) { this.bombTimer = ticks; }
    int SwCharge() { return this.swCharge; }
    void SetSwCharge(int ticks) { this.swCharge = ticks; }
    void AdvanceSwCharge(int cap) {
        if (this.swCharge < cap) { this.swCharge = this.swCharge + 1; }
    }

    /// <summary>The renderer's per-object sprite cache: compare the packed
    /// identity, reuse the texture on a match, rebuild on a change. Slot A
    /// carries the body, slot B the turret.</summary>
    int ArtStampA() { return this.artStampA; }
    Ra2.Render.R2Tex ArtTexA() { return this.artTexA; }
    void SetArtCacheA(int stamp, Ra2.Render.R2Tex tex) {
        this.artStampA = stamp;
        this.artTexA = tex;
    }
    int ArtStampB() { return this.artStampB; }
    Ra2.Render.R2Tex ArtTexB() { return this.artTexB; }
    void SetArtCacheB(int stamp, Ra2.Render.R2Tex tex) {
        this.artStampB = stamp;
        this.artTexB = tex;
    }
    bool IsCiv() { return this.civ; }
    void SetCiv(bool on) { this.civ = on; }
    int Cargo() { return this.cargo; }
    void SetCargo(int credits) { this.cargo = credits; }
    int Bails() { return this.bails; }
    void SetBails(int v) { this.bails = v; }
    bool Repairing() { return this.repairing; }
    void SetRepairing(bool on) {
        this.repairing = on;
        this.repairAt = 0;
        this.repairCarry = 0;
    }
    int RepairAtTick() { return this.repairAt; }
    void SetRepairAtTick(int t) { this.repairAt = t; }
    int DockTimer() { return this.dockTimer; }
    void SetDockTimer(int ticks) { this.dockTimer = ticks; }
    /// <summary>True while a failed route search is still in its cooldown,
    /// so the harvester idles instead of rescanning the whole map.</summary>
    bool RouteRetry() { return this.routeCooldown > 0; }
    int RouteCooldown() { return this.routeCooldown; }
    void SetRouteCooldown(int ticks) { this.routeCooldown = ticks; }

    // ---- deploy ---------------------------------------------------------

    bool Deployed() { return this.deployed; }
    void SetDeployed(bool on) { this.deployed = on; }

    /// <summary>Unfolds the unit into the structure it DeploysInto, in place
    /// -- the reference engine's GameCommand::Deploy. The archetype becomes
    /// the building, every order and movement field is dropped, and the
    /// health fraction carries over, so a damaged MCV yields a damaged yard.
    /// The yard arrives finished (builtTicks = its build time): the original
    /// unfolds one instantly, and an unfinished yard would not count as the
    /// tech root its owner needs.</summary>
    void MorphIntoStructure(int buildId, int hp, int maxHp, int buildTime) {
        this.kind = ObjKind.Structure();
        this.buildId = buildId;
        this.unitType = null;
        this.unitId = -1;
        this.hp = hp;
        this.maxHp = maxHp;
        this.target = -1;
        this.reload = 0;
        this.pathX = null;
        this.pathY = null;
        this.pathAt = 0;
        this.animFrame = 0;
        this.facing = 0;
        this.turretFacing = 0;
        this.turretTurn = 0;
        this.maX = -1;
        this.maY = -1;
        this.prodQueue = new List<int>();
        this.prodLeft = new List<int>();
        this.builtTicks = buildTime;
        this.frozen = 0;
        this.bombTimer = -1;
        this.cargo = 0;
        this.dockTimer = 0;
        this.routeCooldown = 0;
        this.deposeTicks = 0;
        this.deposeSeq = 0;
        this.repairing = false;
        this.repairAt = 0;
        this.repairCarry = 0;
        this.deployed = false;
    }

    // ---- production ------------------------------------------------------

    bool HasProduction() { return this.prodQueue != null && this.prodQueue.Count > 0; }
    int ProdCount() { return this.prodQueue == null ? 0 : this.prodQueue.Count; }
    int ProdUnitAt(int i) { return this.prodQueue[i]; }
    int ProdLeftAt(int i) { return this.prodLeft[i]; }
    void SetProdLeftAt(int i, int ticks) { this.prodLeft[i] = ticks; }

    /// <summary>Enqueues a unit of unitId that will finish in `ticks`
    /// production ticks. Only structures carry a queue.</summary>
    void QueueUnit(int unitId, int ticks) {
        this.prodQueue.Add(unitId);
        this.prodLeft.Add(ticks);
    }

    /// <summary>Drops the finished entry at the head of the queue.</summary>
    void PopProd() {
        this.prodQueue.RemoveAt(0);
        this.prodLeft.RemoveAt(0);
    }

    /// <summary>Drops one queued entry, the right-click cancel's cut.</summary>
    void CancelProdAt(int i) {
        if (this.prodQueue == null || i < 0 || i >= this.prodQueue.Count) {
            return;
        }
        this.prodQueue.RemoveAt(i);
        this.prodLeft.RemoveAt(i);
    }

    /// <summary>Clears the whole queue. A captured building must not finish
    /// its old owner's queue: the ids reference the captor's enemy roster, so
    /// a Soviet war factory's SHK would otherwise spawn as an Allied sniper.</summary>
    void ClearProduction() {
        if (this.prodQueue == null) { return; }
        this.prodQueue = new List<int>();
        this.prodLeft = new List<int>();
    }

    // ---- construction -----------------------------------------------------

    int BuiltTicks() { return this.builtTicks; }
    void AdvanceBuilt() { this.builtTicks = this.builtTicks + 1; }
    /// <summary>True while the structure is still being built. A freshly
    /// placed building renders its construction animation until this clears.</summary>
    bool UnderConstruction(int buildTime) { return this.builtTicks < buildTime; }

    void SetCell(int x, int y) { this.x = x; this.y = y; }

    /// <summary>The ground cell a unit is currently moving toward.</summary>
    bool HasRoute() { return this.pathX != null && this.pathX.Count > 0; }

    /// <summary>The walk-cycle frame, advanced while the unit moves. Drives
    /// the SHP animation frame selection.</summary>
    int AnimFrame() { return this.animFrame; }
    void AdvanceAnim() { this.animFrame = this.animFrame + 1; }

    /// <summary>Move-attack destination, or -1 when inactive.</summary>
    bool MoveAttacking() { return this.maX >= 0; }
    int MoveAttackX() { return this.maX; }
    int MoveAttackY() { return this.maY; }

    /// <summary>Sets a move-attack destination the unit walks toward while
    /// engaging anything hostile on the way.</summary>
    void SetMoveAttack(int x, int y) { this.maX = x; this.maY = y; }
    void ClearMoveAttack() { this.maX = -1; this.maY = -1; }

    /// <summary>Compass direction the unit faces, on the TS/RA2 ring: 0
    /// north, 1 NE, 2 east, 3 SE, 4 south, 5 SW, 6 west, 7 NW. Derived from
    /// the last move step so the renderer can pick the right sprite
    /// facing.</summary>
    int Facing() { return this.facing; }
    void SetFacing(int f) {
        if (f < 0) { f = 0; }
        if (f > 7) { f = 7; }
        this.facing = f;
    }

    /// <summary>The turret's own compass facing, on the same ring as the
    /// body. A turreted vehicle turns this toward its target while the hull
    /// keeps its travel facing, and lets it drift back when the fight ends.
    /// Unturreted units always report the body facing.</summary>
    int TurretFacing() {
        if (this.unitType == null || this.unitType.TurretVxl() == null) {
            return this.facing;
        }
        return this.turretFacing;
    }

    void SetTurretFacing(int f) {
        if (f < 0) { f = 0; }
        if (f > 7) { f = 7; }
        this.turretFacing = f;
    }

    /// <summary>Advances the turret one compass step toward `want`, paced by
    /// the turret turn counter (one step every six ticks, like the shipped
    /// ROT pacing). Returns the facing after the step.</summary>
    int TurnTurretToward(int want) {
        if (this.turretTurn > 0) {
            this.turretTurn = this.turretTurn - 1;
            return this.turretFacing;
        }
        this.turretTurn = 5;
        if (this.turretFacing == want) { return this.turretFacing; }
        // Walk the shorter arc around the eight-point ring.
        int up = (want - this.turretFacing + 8) % 8;
        if (up <= 4) {
            this.turretFacing = (this.turretFacing + 1) % 8;
        } else {
            this.turretFacing = (this.turretFacing + 7) % 8;
        }
        return this.turretFacing;
    }

    /// <summary>Compass direction from this unit's cell to (x,y), for the
    /// turret to aim at. Same conversion as FacingOf.</summary>
    int FacingToward(int x, int y) {
        return WorldObject.FacingOf(x - this.x, y - this.y);
    }

    /// <summary>Maps a step direction (dx,dy in cell space) onto the eight
    /// compass directions of the TS/RA2 ring (0=N, 1=NE, 2=E, 3=SE, 4=S,
    /// 5=SW, 6=W, 7=NW).
    /// A cell step is not a screen step: the isometric projection turns cell
    /// +x into screen down-right and +y into screen down-left. Convert first,
    /// then snap the screen vector to the compass rose by its dominant axis,
    /// with diagonals when neither axis dominates. The old half-step
    /// comparisons classified (1,0) as south; the dominant-axis test puts
    /// every step on its true octant.</summary>
    static int FacingOf(int dx, int dy) {
        int sx = dx - dy;          // screen right
        int sy = (dx + dy) * 2;    // screen down
        if (sx == 0 && sy == 0) { return 4; }
        int ax = sx < 0 ? 0 - sx : sx;
        int ay = sy < 0 ? 0 - sy : sy;
        if (ax > ay * 2) { return sx > 0 ? 2 : 6; }    // east / west
        if (ay > ax * 2) { return sy > 0 ? 4 : 0; }    // south / north
        if (sx > 0) { return sy > 0 ? 3 : 1; }         // SE / NE
        return sy > 0 ? 5 : 7;                         // SW / NW
    }

    /// <summary>The planned route as "x,y x,y ...", for tests to inspect.</summary>
    string RouteString() {
        if (!this.HasRoute()) { return ""; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < this.pathX.Count; i = i + 1) {
            if (i > 0) { sb.Append(" "); }
            sb.Append(Convert.ToString(this.pathX[i]));
            sb.Append(",");
            sb.Append(Convert.ToString(this.pathY[i]));
        }
        return sb.ToString();
    }

    void SetRoute(List<int> xs, List<int> ys) {
        // A fresh order stands a sat-down trooper back up: the original's
        // deployed GI packs his emplacement the moment he is told to move,
        // and the Undeploy block plays over the transition first.
        if (xs != null && xs.Count > 0 && this.deployed) {
            this.deployed = false;
            this.StartUndeployPose();
        }
        this.pathX = xs;
        this.pathY = ys;
        this.pathAt = 0;
    }

    /// <summary>Starts the Undeploy transition art (the pack-up block);
    /// a no-op when the art ships none.</summary>
    void StartUndeployPose() {
        if (this.unitType == null || !this.unitType.HasUndeploySeq()) {
            return;
        }
        this.deposeSeq = 1;
        this.deposeTicks = this.unitType.UndeploySeqFrames() * 2;
    }

    /// <summary>Starts the Deploy transition art (the sit-down block);
    /// the deployed stance itself flips when the block runs out, like the
    /// reference's transition-then-stance sequencing.</summary>
    void StartDeployPose() {
        if (this.unitType == null) { return; }
        if (this.unitType.HasDeploySeq()) {
            this.deposeSeq = 0;
            this.deposeTicks = this.unitType.DeploySeqFrames() * 2;
            return;
        }
        // No transition art shipped: sit down on the spot.
        this.deployed = true;
    }

    /// <summary>The next cell on the route, or -1 when finished.</summary>
    int StepCellX() {
        if (!this.HasRoute()) { return -1; }
        return this.pathX[this.pathAt];
    }

    int StepCellY() {
        if (!this.HasRoute()) { return -1; }
        return this.pathY[this.pathAt];
    }

    /// <summary>Advances one cell along the route. Returns false when the
    /// route is empty or the unit just reached the end.</summary>
    bool Advance() {
        if (!this.HasRoute()) { return false; }
        int idx = this.pathAt;
        if (idx >= this.pathX.Count) { return false; }
        this.x = this.pathX[idx];
        this.y = this.pathY[idx];
        this.pathAt = idx + 1;
        if (this.pathAt >= this.pathX.Count) {
            this.pathX = null;
            this.pathY = null;
        }
        return true;
    }
}

/// <summary>Thing categories.</summary>
class ObjKind {
    static int Structure() { return 0; }
    static int Unit() { return 1; }
}

/// <summary>How an object died, the reference's DeathType enum. Normal is
/// the default; Crush marks a run-over death (no corpse art, the squish
/// sound instead of the die cry).</summary>
class DeathType {
    static int None() { return 0; }
    static int Normal() { return 1; }
    static int Demolish() { return 2; }
    static int Crush() { return 3; }
    static int Temporal() { return 4; }
    static int Sink() { return 5; }
}

/// <summary>One unit archetype: the numbers a placed soldier fights with.
/// Everything is built from the Rules (the RULES.INI values), so damage lands
/// through the weapon's warhead against the target's armour instead of as a
/// flat number. Damage()/Range()/Cooldown() expose the primary weapon for the
/// info panel and old call sites; combat itself reads the weapons
/// directly.</summary>
class UnitType {
    string reg;        // E1, DOG, ...
    string label;
    int cost;          // credits to train
    int buildTime;     // ticks the production queue spends on it
    int hp;            // full health
    bool amphibious;   // can move over water (kept for the interface; unused)
    string shpName;    // SHP art file
    string turretVxl;  // turret art (<unit>TUR.VXL), null = fixed superstructure
    int armor;         // ArmorClass the warhead verses are applied against
    Weapon primary;    // null = unarmed (engineer, spy)
    Weapon secondary;  // picked per shot when its verse beats the primary's
    int steps;         // cells covered per tick
    int role;          // UnitRole: engineer captures, spy infiltrates
    bool mindImmune;   // dogs and Tanya shrug off mind control
    // Infantry art sequence (from the art ini's Sequence= section): where
    // the stand ring and the walk blocks start, and how long a walk block
    // is. Without it the sprite carries no troop layout to read.
    bool hasSeq;
    int readyStart;
    int walkStart;
    int walkFrames;
    // The deployed pose's frame block (Sequence Deployed=), a one-frame
    // block per facing for the troops that can sit down.
    bool hasDeployedSeq;
    int deployedStart;
    int deployedFrames;
    string artKey;     // art ini section: Image= override or the regkey
    bool newTheater;   // art swaps the name's second letter per theater
    string cameo;      // art.ini Cameo= stem: the sidebar portrait SHP
    int techLevel;     // rules TechLevel=; -1 means "never buildable"
    // Tech tree: prereq slots resolved to build ids of this side's catalog.
    // Every slot needs one living built building from its list.
    List<List<int>> prereqs;
    // Deploy semantics off the rules: DeploysInto names the structure this
    // unit becomes in place (the MCVs), deployer marks the infantry whose
    // deploy is a stance toggle (the GI sitting down).
    string deploysInto;
    bool deployer;
    // The rules Speed= value: the reference feeds it to a per-tick move
    // accumulator that buys one cell per 64 banked, so the raw number, not
    // the per-tick step count, is what drives pace.
    int speed;
    // The harvester hold in bails (the rules' Storage=); 0 off the miners.
    int storage;
    // The shroud reveal radius (rules Sight=, default 1).
    int sight;
    // Order/selection voices (the rules' VoiceSelect= and friends).
    TechnoVoices voices;
    // The TechnoRules sound keys, plain sound.ini names ("" = unset): the
    // spawn chirp, the deploy stance toggle's two directions, the death cry.
    string createSound;
    string deploySound;
    string undeploySound;
    string dieSound;
    // The per-unit veteran/elite ability lists, copied off the def (elite
    // already holds the veteran union).
    List<int> veteranAbilities;
    List<int> eliteAbilities;
    // The crush facts, copied off the def: Crusher= (this unit runs over
    // crushable things under its tracks), Crushable= (this unit can be run
    // over), CrushSound= (the sound.ini squish key, "" = unset) and Weight=
    // (the rocking falloff a heavy hull uses on a crushed wall). `infantry`
    // is the reference's ObjectType classification (membership in the
    // install's [InfantryTypes]), which the corpse/death-art paths key off.
    bool crusher;
    bool crushable;
    string crushSound;
    int weight;
    bool infantry;
    int speedType;     // SpeedType: only Track/Hover hulls roll over things
    // The flying flag off the def (the Jumpjet/Disguised locomotor class):
    // crosses water, cliffs, walls and buildings, never occupies a tile and
    // is engageable only by AntiAir guns.
    bool flying;

    static UnitType Create(string reg, string label, int cost, int buildTime,
                           int hp, string shpName, int armor, Weapon primary,
                           Weapon secondary, int steps, int role,
                           bool mindImmune) {
        UnitType t = new UnitType();
        t.reg = reg;
        t.label = label;
        t.cost = cost;
        t.buildTime = buildTime;
        t.hp = hp;
        t.amphibious = false;
        t.shpName = shpName;
        t.turretVxl = null;
        t.armor = armor;
        t.primary = primary;
        t.secondary = secondary;
        t.steps = steps;
        t.speed = steps * 4;
        if (t.speed < 4) { t.speed = 4; }
        t.role = role;
        t.mindImmune = mindImmune;
        t.prereqs = new List<List<int>>();
        t.artKey = null;
        t.newTheater = false;
        t.cameo = null;
        t.techLevel = 1;
        t.sight = 1;
        t.deploysInto = null;
        t.deployer = false;
        t.storage = 0;
        t.hasSeq = false;
        t.readyStart = 0;
        t.walkStart = 0;
        t.walkFrames = 0;
        t.hasDeployedSeq = false;
        t.deployedStart = 0;
        t.deployedFrames = 1;
        t.voices = TechnoVoices.Create();
        t.createSound = "";
        t.deploySound = "";
        t.undeploySound = "";
        t.dieSound = "";
        t.veteranAbilities = new List<int>();
        t.eliteAbilities = new List<int>();
        t.crusher = false;
        t.crushable = false;
        t.crushSound = "";
        t.weight = 1;
        t.infantry = false;
        t.speedType = SpeedType.Wheel();
        t.flying = false;
        return t;
    }

    string Reg() { return this.reg; }
    string Label() { return this.label; }
    int Cost() { return this.cost; }
    int BuildTime() { return this.buildTime; }
    int Hp() { return this.hp; }
    TechnoVoices Voices() { return this.voices; }
    void SetVoices(TechnoVoices v) { this.voices = v; }
    string CreateSound() { return this.createSound; }
    string DeploySound() { return this.deploySound; }
    string UndeploySound() { return this.undeploySound; }
    string DieSound() { return this.dieSound; }
    void SetSoundKeys(string createSnd, string deploySnd, string undeploySnd,
                      string dieSnd) {
        this.createSound = createSnd;
        this.deploySound = deploySnd;
        this.undeploySound = undeploySnd;
        this.dieSound = dieSnd;
    }
    List<int> VeteranAbilities() { return this.veteranAbilities; }
    List<int> EliteAbilities() { return this.eliteAbilities; }
    void SetVeteranAbilities(List<int> vet, List<int> elite) {
        this.veteranAbilities = vet;
        this.eliteAbilities = elite;
    }
    bool Crusher() { return this.crusher; }
    void SetCrusher(bool on) { this.crusher = on; }
    bool Crushable() { return this.crushable; }
    string CrushSound() { return this.crushSound; }
    int Weight() { return this.weight; }
    bool Infantry() { return this.infantry; }
    int SpeedTypeValue() { return this.speedType; }
    bool Flying() { return this.flying; }
    void SetFlying(bool on) { this.flying = on; }
    void SetCrushKeys(bool crusher, bool crushable, string crushSound,
                      int weight, bool infantry) {
        this.crusher = crusher;
        this.crushable = crushable;
        this.crushSound = crushSound;
        this.weight = weight;
        this.infantry = infantry;
    }
    void SetSpeedType(int st) { this.speedType = st; }
    bool Amphibious() { return this.amphibious; }
    string ShpName() { return this.shpName; }
    string TurretVxl() { return this.turretVxl; }
    void SetTurretVxl(string vxl) { this.turretVxl = vxl; }
    int ArmorClass() { return this.armor; }
    Weapon Primary() { return this.primary; }
    Weapon Secondary() { return this.secondary; }
    int Steps() { return this.steps; }
    int Speed() { return this.speed; }
    void SetSpeed(int speed) { this.speed = speed; }
    int Storage() { return this.storage; }
    void SetStorage(int v) { this.storage = v; }
    int Sight() { return this.sight; }
    void SetSight(int v) { this.sight = v; }
    int Role() { return this.role; }
    bool MindImmune() { return this.mindImmune; }
    List<List<int>> Prereqs() { return this.prereqs; }
    void SetPrereqs(List<List<int>> prereqs) { this.prereqs = prereqs; }

    bool HasSeq() { return this.hasSeq; }
    int ReadyStart() { return this.readyStart; }
    int WalkStart() { return this.walkStart; }
    int WalkFrames() { return this.walkFrames; }
    bool HasDeployedSeq() { return this.hasDeployedSeq; }
    int DeployedStart() { return this.deployedStart; }
    int DeployedFrames() { return this.deployedFrames; }
    string ArtKey() { return this.artKey; }
    void SetArtKey(string key) { this.artKey = key; }
    bool NewTheater() { return this.newTheater; }
    void SetNewTheater(bool on) { this.newTheater = on; }
    string Cameo() { return this.cameo; }
    void SetCameo(string c) { this.cameo = c; }
    int TechLevel() { return this.techLevel; }
    void SetTechLevel(int l) { this.techLevel = l; }
    string DeploysInto() { return this.deploysInto; }
    void SetDeploysInto(string reg) { this.deploysInto = reg; }
    bool Deployer() { return this.deployer; }
    void SetDeployer(bool on) { this.deployer = on; }
    void SetSequence(bool has, int ready, int walk, int frames) {
        this.hasSeq = has;
        this.readyStart = ready;
        this.walkStart = walk;
        this.walkFrames = frames;
    }
    void SetDeployedSequence(bool has, int start, int frames) {
        this.hasDeployedSeq = has;
        this.deployedStart = start;
        this.deployedFrames = frames < 1 ? 1 : frames;
    }
    // The Deploy/Undeploy transition blocks and the DeployedFire pose,
    // the reference's getStanceTransitionSequenceBy and DeployedFire
    // sequence picks for the troops that toggle an emplacement.
    bool hasDeploySeq;
    int deploySeqStart;
    int deploySeqFrames;
    bool hasUndeploySeq;
    int undeploySeqStart;
    int undeploySeqFrames;
    bool hasDeployedFire;
    int deployedFireStart;
    int deployedFireFrames;
    int deployedFireMult;
    bool HasDeploySeq() { return this.hasDeploySeq; }
    int DeploySeqStart() { return this.deploySeqStart; }
    int DeploySeqFrames() { return this.deploySeqFrames; }
    bool HasUndeploySeq() { return this.hasUndeploySeq; }
    int UndeploySeqStart() { return this.undeploySeqStart; }
    int UndeploySeqFrames() { return this.undeploySeqFrames; }
    bool HasDeployedFire() { return this.hasDeployedFire; }
    int DeployedFireStart() { return this.deployedFireStart; }
    int DeployedFireFrames() { return this.deployedFireFrames; }
    int DeployedFireMult() { return this.deployedFireMult; }
    void SetDeploySequences(bool hasD, int ds, int df,
                            bool hasU, int us, int uf) {
        this.hasDeploySeq = hasD;
        this.deploySeqStart = ds;
        this.deploySeqFrames = df < 1 ? 1 : df;
        this.hasUndeploySeq = hasU;
        this.undeploySeqStart = us;
        this.undeploySeqFrames = uf < 1 ? 1 : uf;
    }
    void SetDeployedFireSeq(bool has, int start, int frames, int mult) {
        this.hasDeployedFire = has;
        this.deployedFireStart = start;
        this.deployedFireFrames = frames < 1 ? 1 : frames;
        this.deployedFireMult = mult;
    }
    // The firing pose and the two death sequences, copied from the
    // rules-side UnitDef once its art section has been read.
    int fireStart;
    int fireFrames = 6;
    int fireMult = 6;
    bool hasFire;
    int die1Start;
    int die1Frames = 10;
    int die1Mult;
    bool hasDie1;
    int die2Start;
    int die2Frames = 10;
    int die2Mult;
    bool hasDie2;
    void SetCombatSequences(UnitDef d) {
        if (d.HasProne()) {
            this.proneSeqs = new List<int>();
            for (int i = 0; i < 15; i = i + 1) {
                this.proneSeqs.Add(d.ProneAt(i));
            }
        }
        this.hasFire = d.HasFire();
        this.fireStart = d.FireStart();
        this.fireFrames = d.FireFrames() < 1 ? 1 : d.FireFrames();
        this.fireMult = d.FireMult();
        this.hasDie1 = d.HasDie1();
        this.die1Start = d.Die1Start();
        this.die1Frames = d.Die1Frames() < 1 ? 1 : d.Die1Frames();
        this.die1Mult = d.Die1Mult();
        this.hasDie2 = d.HasDie2();
        this.die2Start = d.Die2Start();
        this.die2Frames = d.Die2Frames() < 1 ? 1 : d.Die2Frames();
        this.die2Mult = d.Die2Mult();
    }
    List<int> proneSeqs;
    bool HasProne() { return this.proneSeqs != null
                   && this.proneSeqs.Count >= 15; }
    int ProneAt(int i) { return this.proneSeqs[i]; }
    bool HasFire() { return this.hasFire; }
    int FireStart() { return this.fireStart; }
    int FireFrames() { return this.fireFrames; }
    int FireMult() { return this.fireMult; }
    bool HasDie1() { return this.hasDie1; }
    int Die1Start() { return this.die1Start; }
    int Die1Frames() { return this.die1Frames; }
    int Die1Mult() { return this.die1Mult; }
    bool HasDie2() { return this.hasDie2; }
    int Die2Start() { return this.die2Start; }
    int Die2Frames() { return this.die2Frames; }
    int Die2Mult() { return this.die2Mult; }

    /// <summary>Primary-weapon damage for the info panel; 0 for the unarmed
    /// specialists.</summary>
    int Damage() {
        if (this.primary == null) { return 0; }
        return this.primary.Damage();
    }

    /// <summary>Primary-weapon range; engineers and spies work at arm's
    /// length (one cell) on the building they capture or infiltrate.</summary>
    int Range() {
        if (this.primary != null) { return this.primary.Range(); }
        if (this.role != UnitRole.None()) { return 1; }
        return 0;
    }

    int Cooldown() {
        if (this.primary == null) { return 10; }
        return this.primary.Rof();
    }
}

/// <summary>The units a side can train, in menu order, built from the Rules.
/// The Allied roster runs on foot (the install carries no Allied vehicle
/// art): GI, attack dog, engineer, sniper, spy, chrono legionnaire and Tanya.
/// The Soviets field the conscript, dog, engineer, tesla trooper, flak
/// trooper, crazy Ivan, desolator, Yuri and the terror drone out of the war
/// factory.</summary>
class UnitCatalog {
    List<UnitType> allied;
    List<UnitType> soviet;
    List<UnitType> yuri;
    // The neutral scenery archetypes, built lazily from the rules' civUnits.
    List<UnitType> civTypes;
    Rules rules;

    /// <summary>The catalog from the transcribed RA2 defaults -- what the
    /// tests and installs without a rules file run against.</summary>
    static UnitCatalog Create() {
        return UnitCatalog.CreateWith(Rules.Default());
    }

    static UnitCatalog CreateWith(Rules rules) {
        UnitCatalog c = new UnitCatalog();
        c.rules = rules;
        c.civTypes = null;
        c.allied = UnitCatalog.BuildSide(rules, Side2.Allied());
        c.soviet = UnitCatalog.BuildSide(rules, Side2.Soviet());
        c.yuri = UnitCatalog.BuildSide(rules, Side2.Yuri());
        return c;
    }

    static List<UnitType> BuildSide(Rules rules, int side) {
        List<UnitType> l = new List<UnitType>();
        List<UnitDef> defs = rules.UnitsForSide(side);
        List<BuildingDef> bdefs = rules.BuildingsForSide(side);
        for (int i = 0; i < defs.Count; i = i + 1) {
            UnitDef d = defs[i];
            UnitType t = UnitType.Create(d.Reg(), d.Label(), d.Cost(),
                Rules.UnitBuildTicks(d.Cost()), d.Hp(), d.Shp(), d.Armor(),
                d.Primary(), d.Secondary(), d.Steps(), d.Role(),
                d.MindImmune());
            t.SetTurretVxl(d.TurretVxl());
            t.SetStorage(d.Storage());
            t.SetPrereqs(Rules.ResolvePrereqs(rules, d.Prereq(), bdefs));
            t.SetSequence(d.HasSeq(), d.ReadyStart(), d.WalkStart(),
                          d.WalkFrames());
            t.SetDeployedSequence(d.HasDeployedSeq(), d.DeployedStart(),
                                  d.DeployedFrames());
            t.SetDeploySequences(d.HasDeploySeq(), d.DeployStart(),
                                 d.DeployFrames(), d.HasUndeploySeq(),
                                 d.UndeployStart(), d.UndeployFrames());
            t.SetDeployedFireSeq(d.HasDeployedFireSeq(),
                                 d.DeployedFireStart(),
                                 d.DeployedFireFrames(),
                                 d.DeployedFireMult());
            t.SetCombatSequences(d);
            t.SetArtKey(d.ArtKey());
            t.SetNewTheater(d.NewTheater());
            t.SetCameo(d.Cameo());
            t.SetTechLevel(d.TechLevel());
            t.SetDeploysInto(d.DeploysInto());
            t.SetDeployer(d.Deployer());
            t.SetSpeed(d.Speed() > 0 ? d.Speed() : d.Steps() * 4);
            t.SetSight(d.Sight());
            t.SetVoices(d.Voices());
            t.SetSoundKeys(d.CreateSound(), d.DeploySound(),
                           d.UndeploySound(), d.DieSound());
            t.SetVeteranAbilities(d.VeteranAbilities(), d.EliteAbilities());
            t.SetCrushKeys(d.Crusher(), d.Crushable(), d.CrushSound(),
                           d.Weight(), d.Infantry());
            t.SetSpeedType(d.SpeedTypeValue());
            t.SetFlying(d.Flying());
            l.Add(t);
        }
        return l;
    }

    Rules Rules() { return this.rules; }

    /// <summary>A side's units, in build order. `side` is a house id in the
    /// multi-house skirmish, so roster selection rides the faction table;
    /// the campaign's one-house-per-side default maps 0/1/2 straight
    /// through.</summary>
    List<UnitType> ListFor(World world, int side) {
        int f = world == null ? side : world.FactionOf(side);
        if (f == Side2.Soviet()) { return this.soviet; }
        if (f == Side2.Yuri()) { return this.yuri; }
        return this.allied;
    }

    UnitType TypeFor(World world, int side, int unitId) {
        List<UnitType> l = this.ListFor(world, side);
        if (unitId < 0 || unitId >= l.Count) { return null; }
        return l[unitId];
    }

    /// <summary>The unit id a regkey names in a side's roster, or -1. The
    /// opener needs it to spawn the mobile construction vehicle the rules
    /// name for a house (AMCV/SMCV/PCV).</summary>
    int IdOfReg(World world, int side, string reg) {
        if (reg == null || reg.Length == 0) { return -1; }
        List<UnitType> l = this.ListFor(world, side);
        for (int i = 0; i < l.Count; i = i + 1) {
            if (l[i] != null && l[i].Reg() == reg) { return i; }
        }
        return -1;
    }

    /// <summary>The side's harvester unit id, -1 when it fields none. The
    /// refinery hands out one of these on completion, as the shipped
    /// buildings always have.</summary>
    int HarvesterIdFor(World world, int side) {        List<UnitType> l = this.ListFor(world, side);
        for (int i = 0; i < l.Count; i = i + 1) {
            if (l[i] != null && l[i].Role() == UnitRole.Harvester()) {
                return i;
            }
        }
        return -1;
    }

    /// <summary>The neutral scenery units (a map's cars and livestock) as
    /// archetypes, built once from the rules' own civUnits list. They are not
    /// in any side's roster -- SpawnCivUnit resolves against this list and
    /// tags the object as civilian, the way a civ structure already
    /// works.</summary>
    List<UnitType> CivTypes() {
        if (this.civTypes != null) { return this.civTypes; }
        this.civTypes = new List<UnitType>();
        List<UnitDef> defs = this.rules.CivUnits();
        for (int i = 0; i < defs.Count; i = i + 1) {
            UnitDef d = defs[i];
            UnitType t = UnitType.Create(d.Reg(), d.Label(), d.Cost(),
                Rules.UnitBuildTicks(d.Cost()), d.Hp(), d.Shp(), d.Armor(),
                d.Primary(), d.Secondary(), d.Steps(), d.Role(),
                d.MindImmune());
            t.SetTurretVxl(d.TurretVxl());
            t.SetSequence(d.HasSeq(), d.ReadyStart(), d.WalkStart(),
                          d.WalkFrames());
            t.SetArtKey(d.ArtKey());
            t.SetNewTheater(d.NewTheater());
            t.SetSpeed(d.Speed() > 0 ? d.Speed() : d.Steps() * 4);
            t.SetSight(d.Sight());
            t.SetCrushKeys(d.Crusher(), d.Crushable(), d.CrushSound(),
                           d.Weight(), d.Infantry());
            t.SetSpeedType(d.SpeedTypeValue());
            this.civTypes.Add(t);
        }
        return this.civTypes;
    }

    /// <summary>The civ-list id a scenery unit's regkey names, or -1. The
    /// lookup the map's [Units]/[Infantry] entries resolve through: a reg
    /// no side trains (CAR, COW, ...) is still placeable when the rules
    /// carry it.</summary>
    int CivUnitIdOf(string reg) {
        List<UnitType> l = this.CivTypes();
        for (int i = 0; i < l.Count; i = i + 1) {
            if (l[i].Reg() == reg) { return i; }
        }
        return -1;
    }

    /// <summary>A scenery unit's archetype by its civ-list id, null when out
    /// of range.</summary>
    UnitType CivUnitType(int civId) {
        List<UnitType> l = this.CivTypes();
        if (civId < 0 || civId >= l.Count) { return null; }
        return l[civId];
    }

    /// <summary>Whether a reg is one the side's roster trains. Distinguishes
    /// a real trainable unit (E1, HTNK) from a scenery reg a map might name,
    /// so the two resolve through the right list.</summary>
    int RosterIdOf(World world, int side, string reg) {
        List<UnitType> l = this.ListFor(world, side);
        for (int i = 0; i < l.Count; i = i + 1) {
            if (l[i].Reg() == reg) { return i; }
        }
        return -1;
    }
}

/// <summary>One building archetype: the fields a placed structure needs,
/// built from the Rules. Its gun (defence buildings only) is a real weapon
/// with a warhead, so a pillbox's Vulcan chews infantry but struggles against
/// anything plated. Health is left to the caller (a just-built structure
/// starts at full).</summary>
class StructureType {
    string reg;          // GACNST, NAPOWR, ...
    string shpName;      // image file, e.g. "GACNST.SHP"
    bool newTheater;     // art swaps the name's second letter per theater
    string cameo;        // art.ini Cameo= stem: the sidebar portrait SHP
    int techLevel;       // rules TechLevel=; -1 means "never buildable"
    int footprintW;      // footprint in cells
    int footprintH;
    int hp;              // full health
    int cost;
    string label;
    int buildTime;       // ticks of construction before completion
    int power;           // power supplied when built (plants)
    int drain;           // power consumed while operating
    int armor;           // ArmorClass the warhead verses hit
    Weapon weapon;       // auto-attack gun, or null
    bool powered;        // needs a healthy power grid to work (defences)
    bool refinery;       // trickles credits every tick
    List<int> produces;  // unit ids this building can train, or null
    List<List<int>> prereqs;   // tech slots, see UnitType
    bool waterBound;     // floats: its footprint must be water (the shipyard)
    // The superweapon this building fires once charged (0 nuke, 1 storm,
    // -1 none), the shipped SuperWeapon= key.
    int superWeapon;
    int sight;           // the shroud reveal radius (rules Sight=, default 1)
    bool conYard;        // rules ConstructionYard=: the free-MCV crate gate
    TechnoVoices voices; // order/selection voices off the def
    string slamSound;    // TechnoRules SlamSound=: the placement thud
    string dieSound;     // TechnoRules DieSound=: the death cry (falls back
                         // to the BuildingDieSound key when unset)
    bool crushable;      // rules Crushable= (default no: buildings are run
                         // over only when their section says so)
    string crushSound;   // rules CrushSound=: the squish key when run over
    // Lamp pool facts, the reference's TechnoRules light reads: how far the
    // building's light reaches in leptons (LightVisibility, 256 per cell),
    // how strong it is (LightIntensity -- negative for the NEGLAMP posts,
    // which darken) and its tint per channel.
    int lightVisibility;
    double lightIntensity;
    double lightRedTint;
    double lightGreenTint;
    double lightBlueTint;
    bool isLightpost;    // InvisibleInGame=: the post renders nothing and
                         // only its light exists (the IN*LAMP family)

    static StructureType Create(BuildingDef d) {
        StructureType t = new StructureType();
        t.reg = d.Reg();
        t.shpName = d.Shp();
        t.newTheater = d.NewTheater();
        t.cameo = d.Cameo();
        t.techLevel = d.TechLevel();
        t.footprintW = d.FootprintW();
        t.footprintH = d.FootprintH();
        t.hp = d.Hp();
        t.cost = d.Cost();
        t.label = d.Label();
        t.buildTime = Rules.BuildingBuildTicks(d.Cost());
        t.power = d.Power();
        t.drain = d.Drain();
        t.armor = d.Armor();
        t.weapon = d.Weapon();
        t.powered = d.Powered();
        t.refinery = d.IsRefinery();
        t.produces = null;
        t.prereqs = new List<List<int>>();
        t.waterBound = d.WaterBound();
        t.superWeapon = d.SuperWeapon();
        t.sight = d.Sight();
        t.conYard = d.IsConYard();
        t.techLevel = d.TechLevel();
        t.voices = d.Voices();
        t.slamSound = d.SlamSound();
        t.dieSound = d.DieSound();
        t.crushable = d.Crushable();
        t.crushSound = d.CrushSound();
        t.lightVisibility = d.LightVisibility();
        t.lightIntensity = d.LightIntensity();
        t.lightRedTint = d.LightRedTint();
        t.lightGreenTint = d.LightGreenTint();
        t.lightBlueTint = d.LightBlueTint();
        t.isLightpost = d.InvisibleInGame();
        return t;
    }

    string Reg() { return this.reg; }
    string ShpName() { return this.shpName; }
    bool NewTheater() { return this.newTheater; }
    string Cameo() { return this.cameo; }
    void SetCameo(string c) { this.cameo = c; }
    int TechLevel() { return this.techLevel; }
    void SetTechLevel(int l) { this.techLevel = l; }
    TechnoVoices Voices() { return this.voices; }
    string SlamSound() { return this.slamSound; }
    string DieSound() { return this.dieSound; }
    bool Crushable() { return this.crushable; }
    string CrushSound() { return this.crushSound; }
    int LightVisibility() { return this.lightVisibility; }
    double LightIntensity() { return this.lightIntensity; }
    double LightRedTint() { return this.lightRedTint; }
    double LightGreenTint() { return this.lightGreenTint; }
    double LightBlueTint() { return this.lightBlueTint; }
    bool IsLightpost() { return this.isLightpost; }
    int FootprintW() { return this.footprintW; }
    int FootprintH() { return this.footprintH; }
    int Hp() { return this.hp; }
    int Cost() { return this.cost; }
    string Label() { return this.label; }
    int BuildTime() { return this.buildTime; }
    int Power() { return this.power; }
    int Drain() { return this.drain; }
    int ArmorClass() { return this.armor; }
    Weapon Weapon() { return this.weapon; }
    bool Powered() { return this.powered; }
    bool IsRefinery() { return this.refinery; }
    bool IsConYard() { return this.conYard; }
    bool WaterBound() { return this.waterBound; }
    int SuperWeapon() { return this.superWeapon; }
    int Sight() { return this.sight; }
    bool HasWeapon() { return this.weapon != null; }
    List<List<int>> Prereqs() { return this.prereqs; }
    void SetPrereqs(List<List<int>> prereqs) { this.prereqs = prereqs; }
    void SetProduces(List<int> produces) { this.produces = produces; }

    int Damage() {
        if (this.weapon == null) { return 0; }
        return this.weapon.Damage();
    }
    int Range() {
        if (this.weapon == null) { return 0; }
        return this.weapon.Range();
    }
    int Cooldown() {
        if (this.weapon == null) { return 0; }
        return this.weapon.Rof();
    }

    /// <summary>The unit ids this building trains, or null when it is not a
    /// production structure (yard, power, refinery, lab).</summary>
    List<int> Produces() { return this.produces; }
}

/// <summary>The structures a side can build, in menu order, built from the
/// Rules. The Allied base runs without a war factory (the install carries no
/// Allied vehicle art): yard, power, refinery, barracks, tech centre,
/// airfield-as-radar, pillbox and wall. The Soviets get the full ladder up
/// to the war factory's terror drones, plus the laser turret, tesla coil and
/// flak cannon. The neutral list holds the maps' civilian structures.</summary>
class StructureCatalog {
    List<StructureType> allied;
    List<StructureType> soviet;
    List<StructureType> yuri;
    List<StructureType> civ;
    Rules rules;

    /// <summary>The catalog from the transcribed RA2 defaults -- what the
    /// tests and installs without a rules file run against.</summary>
    static StructureCatalog Create() {
        return StructureCatalog.CreateWith(Rules.Default());
    }

    static StructureCatalog CreateWith(Rules rules) {
        StructureCatalog c = new StructureCatalog();
        c.rules = rules;
        c.allied = StructureCatalog.BuildSide(rules, Side2.Allied());
        c.soviet = StructureCatalog.BuildSide(rules, Side2.Soviet());
        c.yuri = StructureCatalog.BuildSide(rules, Side2.Yuri());
        c.civ = StructureCatalog.BuildCiv(rules);
        return c;
    }

    static List<StructureType> BuildSide(Rules rules, int side) {
        List<StructureType> l = new List<StructureType>();
        List<BuildingDef> defs = rules.BuildingsForSide(side);
        List<UnitDef> udefs = rules.UnitsForSide(side);
        for (int i = 0; i < defs.Count; i = i + 1) {
            BuildingDef d = defs[i];
            StructureType t = StructureType.Create(d);
            t.SetPrereqs(Rules.ResolvePrereqs(rules, d.Prereq(), defs));
            // This building trains every unit whose producer is its regkey.
            List<int> produces = null;
            for (int u = 0; u < udefs.Count; u = u + 1) {
                if (udefs[u].Producer() == d.Reg()) {
                    if (produces == null) { produces = new List<int>(); }
                    produces.Add(u);
                }
            }
            t.SetProduces(produces);
            l.Add(t);
        }
        return l;
    }

    static List<StructureType> BuildCiv(Rules rules) {
        List<StructureType> l = new List<StructureType>();
        List<BuildingDef> defs = rules.Civs();
        for (int i = 0; i < defs.Count; i = i + 1) {
            l.Add(StructureType.Create(defs[i]));
        }
        return l;
    }

    Rules Rules() { return this.rules; }

    /// <summary>A side's structures, in build order. House id + faction
    /// table, see the unit catalog's ListFor.</summary>
    List<StructureType> ListFor(World world, int side) {
        int f = world == null ? side : world.FactionOf(side);
        if (f == Side2.Soviet()) { return this.soviet; }
        if (f == Side2.Yuri()) { return this.yuri; }
        return this.allied;
    }

    int CountFor(World world, int side) { return this.ListFor(world, side).Count; }

    StructureType TypeFor(World world, int side, int buildId) {
        List<StructureType> l = this.ListFor(world, side);
        if (buildId < 0 || buildId >= l.Count) { return null; }
        return l[buildId];
    }

    int CivCount() { return this.civ.Count; }

    /// <summary>A neutral civilian structure's type by its id in the civ
    /// list, or null when the id is out of range.</summary>
    StructureType CivType(int civId) {
        if (civId < 0 || civId >= this.civ.Count) { return null; }
        return this.civ[civId];
    }

    /// <summary>The civ-list id a civilian regkey names, or -1.</summary>
    int CivIdOf(string reg) {
        for (int i = 0; i < this.civ.Count; i = i + 1) {
            if (this.civ[i].Reg() == reg) { return i; }
        }
        return -1;
    }

    /// <summary>The build id a side's own catalog gives a regkey, or -1. A
    /// deployable's target (AMCV -&gt; GACNST) is named by reg in the rules,
    /// so unfolding needs this lookup to find the building's slot.</summary>
    int IdOfReg(World world, int side, string reg) {
        if (reg == null || reg.Length == 0) { return -1; }
        List<StructureType> l = this.ListFor(world, side);
        for (int i = 0; i < l.Count; i = i + 1) {
            if (l[i].Reg() == reg) { return i; }
        }
        return -1;
    }
}

/// <summary>The world: a grid over the map's cells, the objects on it, and the
/// rules of occupancy and movement. Pure logic, no SDL -- a test can drive a
/// whole game here.</summary>
///
/// Cells are indexed x + y * width. A cell is occupied when a structure's
/// footprint covers it or a unit stands on it. Movement is a breadth-first
/// search over the passable grid, which keeps the path tight around buildings
/// without the bookkeeping of a weighted A*.
class World {
    // Battle audio sink, set by the app once the game's own SndEngine is
    // built. Null in the winchain's rule-only worlds, which then stay
    // silent.
    SndEngine sndSink;
    int width;
    int height;
    IsoMap iso;
    StructureCatalog catalog;
    UnitCatalog units;
    List<WorldObject> objects;
    int[] occupancy;     // object index + 1, or 0 when free
    int selectedIndex;   // primary (first) selection; -1 when nothing selected
    List<int> selection; // all selected indices, first is the primary
    int worldTick;       // ticks elapsed since creation, for periodic rules
    // Reused breadth-first scratch for FindPathMulti (see the comment there).
    // Kept on the world so a battle's constant re-pathing never allocates.
    byte[] pathSeen;
    int[] pathPrev;
    List<int> pathQx;
    List<int> pathQy;
    int pathGen;
    int pathCalls;       // dev: selftest perf line reports the search volume
    int pathPopCap;      // 0 = unbounded; combat repaths bound their flood
    int smokeClock;      // world-tick counter for the damage-smoke cadence
    int pathBestSlot;    // explored cell closest to the goal (cap fallback)
    int pathBestD;
    int pathGoalX;
    int pathGoalY;
    // The theater's water tile-id ranges as first,count pairs. Null until
    // the theater loads, in which case IsWater falls back to temperate's
    // own 314..327. See Theater.WaterRanges.
    List<int> waterRanges;

    // The map lighting engine (see Lighting.zan): the [Lighting] block's
    // ambient/level/tint, the per-cell lamp pools, and the compute() the
    // renderer shades sprites with. Never null.
    Lighting lighting;

    // The lamp buildings that currently cast a pool, with the lights each
    // one placed -- the reference's lampLights map. Kept so a lamp dying
    // takes exactly its own light off the cells it lit, leaving any
    // neighbouring lamp's pool on the shared cells intact. Parallel lists:
    // lampSources[i] placed lampLights[i].
    List<WorldObject> lampSources;
    List<List<TileLight>> lampLights;
    // The cells each lamp's lights went onto, parallel to lampLights, so a
    // removal knows where to take them off.
    List<List<int>> lampSpots;
    List<List<int>> lampSpotsY;

    // The theater whose TMP templates classify each cell's land type and
    // ramp flag. Null is tolerated: CellLand then falls back to the
    // set-name ranges above, so a map still plays without its theater art.
    Theater theater;

    // House -> faction map. A house is who owns the stuff (0..7, one per
    // skirmish slot); a faction is what tech roster it draws from (Side2
    // 0/1/2). The original campaign's one-house-per-side is just houses
    // 0..2 mapped straight through, set by default in Create; a multi-AI
    // skirmish rewrites the tail so each AI house rides a rotating faction.
    int[] factions;

    // FactionOf(house): the tech roster a house builds from. Out-of-range
    // houses (Neutral) fall back to the Allied roster, which nothing but
    // display code ever asks for.
    int FactionOf(int house) {
        if (this.factions == null || house < 0
         || house >= this.factions.Length) { return Side2.Allied(); }
        return this.factions[house];
    }

    // Sets the house->faction table at game start. playerHouse keeps its
    // identity; every AI house rotates through the factions after it so two
    // AIs can share a faction yet still fight each other (houses, not
    // factions, are the sides in a war).
    void SetFactions(int playerHouse, List<int> aiHouses) {
        this.factions = new int[8];
        for (int i = 0; i < 8; i = i + 1) { this.factions[i] = i % 3; }
        this.factions[playerHouse] = playerHouse % 3;
        for (int i = 0; i < aiHouses.Count; i = i + 1) {
            int h = aiHouses[i];
            if (h < 0 || h >= 8) { continue; }
            this.factions[h] = (playerHouse + 1 + i) % 3;
        }
    }

    // Rounds in flight, one-shot anims and beams: the projectile layer.
    // Damage lands when the round DETONATES, not when the trigger is pulled
    // -- the reference's Projectile state machine, Travel -> Detonation.
    List<Projectile> projectiles;
    List<FxAnim> anims;
    List<FxBeam> beams;
    // The superweapons in flight: nukes falling on their mark (a short
    // ballistic wait the retail game fills with the off-map missile) and
    // the lightning storms raging around theirs, plus the nuke flash's
    // lighting effect while it runs.
    List<SuperNuke> nukes;
    List<SuperStorm> storms;
    NukeLightingFx nukeFx;
    int nukeFxStart;
    bool nukeFxOn;
    // SHP frame counts for the anims already probed (the world reads the
    // sprite header once per anim name; the renderer reuses its own cache).
    List<string> animNames;
    List<int> animFrames;

    // Combat effects for the renderer: a flat list of (kind, cellX, cellY,
    // life) quadruples. Spawned on shots and kills, aged in Tick, drawn by the
    // render layer.
    List<int> effects;

    // Money-affecting events the world itself cannot apply (it owns no
    // credits): triples of (kind, side, amount). Kind 1 grants credits --
    // a spy's heist or a captured oil derrick's signing bonus. The game
    // controller drains the list every tick.
    List<int> events;

    // Per-side power blackouts in ticks remaining: a spy in a power plant
    // shuts the grid down, which takes powered defences offline and halves
    // production exactly like a low-power state.
    List<int> blackout;

    // One low-power flag per house (8), recomputed once per tick by
    // CacheLowPower at the top of Tick. SideLowPower reads this cache so a
    // full-house skirmish doesn't rescan every building for every one of
    // its structures.
    bool[] lowPowerCache;
    int lowPowerTick;

    // The ore fields, in the same diamond cell space as the iso terrain.
    // RA2 stores them as GEM overlays on the map; seeding copies the amount
    // (the overlay's data byte) and the credits per unit here, and the
    // harvester loop depletes and regrows the cells from this grid.
    int[] oreAmt;
    int[] oreVal;
    int oreLeft;         // cells carrying ore, for the growth pass
    int oreVersion;      // bumped on every ore mutation: the terrain layer
                         // bakes ore art, so a change means recomposite
    // Walls: the overlay pieces that stand and fight -- per-cell overlay
    // type id (-1 none), remaining hit points, and the connection bitmask
    // the reference's wallTypes builds (N + 2E + 4S + 8W). World owns the
    // live state; the map file keeps only what shipped on disk. Every
    // mutation bumps oreVersion: the terrain layer bakes the wall art in.
    int[] wallOv;
    int[] wallHp;
    int[] wallData;
    // Per-cell overlay type for the ore fields (the GEM id the map shipped
    // or the TIB id the growth spawned, -1 otherwise): the art variant is
    // per-cell state, not derivable from amount+value.
    int[] oreOv;
    // Static overlays: the map's non-ore, non-wall, non-bridge decal art
    // (rocks, fences, crates, drums, tracks) -- per-cell type id (-1 none)
    // and data byte (the art frame). No health, no occupancy: decals with
    // a land override, exactly the reference's flat overlay layer.
    int[] statOv;
    int[] statData;
    // Low bridges: live pieces chained head-to-tail. The overlay id lives
    // on every cell the piece's art covers (anchor + 2 along the axis) so
    // a land query finds it anywhere on the span; the anchor cell alone
    // carries the piece flags in brData (head 0 none / 1 start / 2 end,
    // bit 4 axis-Y, bit 8 anchor) and brAnchors lists the anchors in
    // placement order. Hit points are the [CombatDamage] BridgeStrength.
    int[] brOv;
    int[] brHp;
    int[] brData;
    List<int> brAnchors;
    // The tiberium trees (TIBTRE01..03 terrain objects): their cells and
    // per-tree cooldown ticks. On expiry each tree rolls the reference's
    // spawn -- one free Clear/Road/Rough cell in radius 1-2, else one bail
    // onto an existing pile nearby.
    List<int> tibTreeX;
    List<int> tibTreeY;
    List<int> tibTreeCd;
    List<int> tibTreeCd0;
    // Cells the map carried a [Terrain] object on: ore may not spawn under
    // scenery (the reference's createInitialMapOverlays skips tiberium
    // where terrain stands, and TiberiumTrait.canBePlacedOn demands a bare
    // tile).
    byte[] hasTerrain;
    // The low-bridge seeding table: map cells carrying a low-bridge overlay
    // (id, value) so the value==1 pieces can check their neighbours' 0/2
    // pattern -- the reference's createInitialMapOverlays bridge pass.
    List<int> segSlot;
    List<int> segVal;
    List<int> segId;

    // Map smudges: the craters and burn marks a map declares in its own
    // [Smudge] section. Name + cell, no owner and no occupancy -- a decal
    // only, drawn by the renderer under everything that moves.
    List<string> smudgeName;
    List<int> smudgeX;
    List<int> smudgeY;

    static World Create(IsoMap iso, StructureCatalog catalog, UnitCatalog units) {
        World w = new World();
        w.iso = iso;
        w.width = iso.Width();
        w.height = iso.Height();        w.catalog = catalog;
        w.units = units;
        w.objects = new List<WorldObject>();
        w.selectedIndex = -1;
        w.selection = new List<int>();
        w.worldTick = 0;
        w.effects = new List<int>();
        w.projectiles = new List<Projectile>();
        w.anims = new List<FxAnim>();
        w.beams = new List<FxBeam>();
        w.animNames = new List<string>();
        w.animFrames = new List<int>();
        w.events = new List<int>();
        // One blackout slot per house (8), not per faction: a spy blacks out
        // the house whose plant he walked into.
        w.blackout = new List<int>();
        for (int b = 0; b < 8; b = b + 1) { w.blackout.Add(0); }
        w.lowPowerCache = new bool[8];
        w.lowPowerTick = -1;
        w.nukes = new List<SuperNuke>();
        w.storms = new List<SuperStorm>();
        w.nukeFx = NukeLightingFx.CreateNuke();
        w.nukeFxOn = false;
        // Campaign-shaped default: houses 0..2 are their own factions. A
        // multi-AI skirmish overwrites this via SetFactions.
        w.factions = new int[8];
        for (int f = 0; f < 8; f = f + 1) { w.factions[f] = f % 3; }
        w.occupancy = new int[w.width * w.height];
        for (int i = 0; i < w.occupancy.Length; i = i + 1) {
            w.occupancy[i] = 0;
        }
        w.oreAmt = new int[w.width * w.height];
        w.oreVal = new int[w.width * w.height];
        for (int i = 0; i < w.oreAmt.Length; i = i + 1) {
            w.oreAmt[i] = 0;
            w.oreVal[i] = 0;
        }
        w.wallOv = new int[w.width * w.height];
        w.wallHp = new int[w.width * w.height];
        w.wallData = new int[w.width * w.height];
        for (int i = 0; i < w.wallOv.Length; i = i + 1) {
            w.wallOv[i] = 0 - 1;
            w.wallHp[i] = 0;
            w.wallData[i] = 0;
        }
        w.oreOv = new int[w.width * w.height];
        w.statOv = new int[w.width * w.height];
        w.statData = new int[w.width * w.height];
        w.brOv = new int[w.width * w.height];
        w.brHp = new int[w.width * w.height];
        w.brData = new int[w.width * w.height];
        for (int i = 0; i < w.oreOv.Length; i = i + 1) {
            w.oreOv[i] = 0 - 1;
            w.statOv[i] = 0 - 1;
            w.statData[i] = 0;
            w.brOv[i] = 0 - 1;
            w.brHp[i] = 0;
            w.brData[i] = 0;
        }
        w.brAnchors = new List<int>();
        w.tibTreeX = new List<int>();
        w.tibTreeY = new List<int>();
        w.tibTreeCd = new List<int>();
        w.tibTreeCd0 = new List<int>();
        w.hasTerrain = new byte[w.width * w.height];
        w.segSlot = new List<int>();
        w.segVal = new List<int>();
        w.segId = new List<int>();
        w.oreLeft = 0;
        // Map smudges -- the battle scars the map itself ships ([Smudge]
        // entries). They are pure ground decals with no owner and no object
        // slot, so they live in their own flat list: name, x, y triples.
        w.smudgeName = new List<string>();
        w.smudgeX = new List<int>();
        w.smudgeY = new List<int>();
        // The lighting: the map's own [Lighting] block is installed by
        // SetMapLighting once the map is known; until then the engine runs
        // the reference's defaults (ambient 1, no tint), so a world built
        // straight from Rules still shades like daylight.
        w.lighting = Lighting.Create(null);
        w.lampSources = new List<WorldObject>();
        w.lampLights = new List<List<TileLight>>();
        w.lampSpots = new List<List<int>>();
        w.lampSpotsY = new List<List<int>>();
        return w;
    }

    int Width() { return this.width; }
    int Height() { return this.height; }
    int ObjectCount() { return this.objects.Count; }
    WorldObject ObjectAt(int index) { return this.objects[index]; }
    int SelectedIndex() { return this.selectedIndex; }

    // ---- map smudges ------------------------------------------------------

    /// <summary>Records one map smudge decal. The name is the rules' own reg
    /// (CRATER07, BURNT02); the renderer resolves the art from it. Out-of-
    /// range cells are dropped: a map's smudge list occasionally names a cell
    /// past the playable diamond. Explosions append here too -- a decal is
    /// the same thing whether the map shipped it or a shell just made it --
    /// and the version bump is what tells the terrain layer to bake it in.</summary>
    void AddSmudge(string name, int x, int y) {
        if (name == null || name.Length == 0) { return; }
        if (!this.InBounds(x, y)) { return; }
        this.smudgeName.Add(name);
        this.smudgeX.Add(x);
        this.smudgeY.Add(y);
        this.oreVersion = this.oreVersion + 1;
    }

    int SmudgeCount() { return this.smudgeName.Count; }
    string SmudgeNameAt(int i) { return this.smudgeName[i]; }
    int SmudgeXAt(int i) { return this.smudgeX[i]; }
    int SmudgeYAt(int i) { return this.smudgeY[i]; }

    // Deterministic picks for the smudge roll (which valid reg a blast
    // leaves, how many ore bails a crater bites). The reference rolls its
    // game RNG (generateRandomInt); this port keeps every match
    // reproducible for the selftest, so the roll hashes a salt that
    // advances with each call -- a different result every call, the same
    // sequence every run.
    int smudgeSalt;

    int WorldRand(int n) {
        if (n <= 1) { return 0; }
        double h = (this.smudgeSalt * 0.1031 + this.worldTick * 0.0618)
                   * 43758.5453;
        h = h - Math.Floor(h);
        this.smudgeSalt = this.smudgeSalt + 1;
        int v = (int)(h * n);
        if (v < 0) { v = 0; }
        if (v >= n) { v = n - 1; }
        return v;
    }

    /// <summary>A 0..1 roll on the same deterministic hash the crate
    /// layer's fractions ride on (the reference's generateRandom).</summary>
    double WorldRandFrac() {
        return this.WorldRand(1000) / 1000.0;
    }

    /// <summary>Whether a blast on this cell would scar the ground -- the
    /// reference's AnimTerrainEffect.spawnSmudges preconditions: Clear land
    /// only, flat (ramp 0), inside the bounds, and no non-unit object on
    /// the tile. Infantry and vehicles do not block -- the original drops
    /// the crater right under them -- but scenery, walls, every overlay
    /// (bridges, ore) and structures do.</summary>
    bool SmudgeCanLand(int x, int y) {
        if (!this.InBounds(x, y)) { return false; }
        IsoTile t = this.iso.At(x, y);
        if (t == null) { return false; }
        LandType lt = this.CellLand(t);
        if (lt == null || lt.Value() != LandType.Clear()) { return false; }
        if (this.CellRampAt(x, y) != 0) { return false; }
        if (this.HasMapTerrain(x, y)) { return false; }
        int slot = this.CellSlot(x, y);
        if (this.IsWallCell(x, y)) { return false; }
        if (this.statOv[slot] >= 0 || this.brOv[slot] >= 0) { return false; }
        if (this.OreAt(x, y) > 0) { return false; }
        int occ = this.OccupantAt(x, y);
        if (occ >= 0 && this.objects[occ].Kind() == ObjKind.Structure()) {
            return false;
        }
        return true;
    }

    /// <summary>The reference's AnimTerrainEffect.spawnSmudges: when the
    /// blast's animation art carries Crater=, roll which smudge reg the
    /// ground takes. Crater regs match the art's crater size (2x2 when
    /// ForceBigCraters=, else 1x1); when the art is also Scorch=, the burn
    /// regs join the pick; a Width=/Height= oversized reg needs a southern
    /// neighbour ring to sit on. One random match wins and becomes a decal.</summary>
    void SpawnSmudge(string animName, int x, int y) {
        Rules rules = this.Rules();
        if (rules == null || rules.SmudgeRegCount() == 0) { return; }
        if (!this.SmudgeCanLand(x, y)) { return; }
        int flags = rules.AnimArtFlags(animName);
        if ((flags & 1) == 0) { return; }
        int craterSize = (flags & 4) != 0 ? 2 : 1;
        bool isScorch = (flags & 2) != 0;
        bool hasNeighbors = this.InBounds(x - 1, y + 1)
            && this.InBounds(x, y + 1) && this.InBounds(x + 1, y + 1);
        List<int> valid = new List<int>();
        for (int i = 0; i < rules.SmudgeRegCount(); i = i + 1) {
            bool crater = rules.SmudgeCraterAt(i)
                && rules.SmudgeWidthAt(i) == craterSize
                && rules.SmudgeHeightAt(i) == craterSize;
            bool burn = isScorch && rules.SmudgeBurnAt(i);
            if (!crater && !burn) { continue; }
            if ((rules.SmudgeWidthAt(i) > 1 || rules.SmudgeHeightAt(i) > 1)
             && !hasNeighbors) {
                continue;
            }
            valid.Add(i);
        }
        if (valid.Count == 0) { return; }
        string pick = rules.SmudgeRegAt(valid[this.WorldRand(valid.Count)]);
        this.AddSmudge(pick, x, y);
    }

    /// <summary>The reference's AnimTerrainEffect.destroyOre: a crater
    /// bite takes half the tiberium pile it lands on -- bailCount is
    /// ceil(maxBails / 2) = 6 of the TiberiumTrait's 11; the S_CLSN blasts
    /// strip that whole bite, every other blast rolls 1..6. An emptied
    /// pile unspawns (SetOre with amount 0).</summary>
    void DestroyOre(string animName, int x, int y) {
        int amt = this.OreAt(x, y);
        if (amt <= 0) { return; }
        Rules rules = this.Rules();
        int ov = this.OreOvAt(x, y);
        if (rules == null || ov < 0 || !rules.IsTiberiumOverlay(ov)) { return; }
        if ((rules.AnimArtFlags(animName) & 1) == 0) { return; }
        string upper = animName != null ? animName.ToUpper() : "";
        string clsn = "S_CLSN";
        bool fixedBite = upper.Length >= clsn.Length;
        for (int i = 0; fixedBite && i < clsn.Length; i = i + 1) {
            if (upper[i] != clsn[i]) { fixedBite = false; }
        }
        int take = fixedBite ? 6 : 1 + this.WorldRand(6);
        int val = this.OreValueAt(x, y);
        int left = amt - take;
        if (left < 0) { left = 0; }
        this.SetOre(x, y, left, val, ov);
    }

    // ---- fog of war (the reference's MapShroudTrait) -----------------------

    // One shroud per skirmish house (0..7). Alliances merge shrouds in the
    // reference; this port fights free-for-all, so a house's knowledge is
    // its own until an alliance slice arrives.
    List<MapShroud> shrouds;

    /// <summary>Builds the per-house shrouds over the map grid and does the
    /// reference's init reveal: every combatant's own forces (and their
    /// allies') reveal their sight circles once, then the queues flush.
    /// Neutral scenery reveals nothing.</summary>
    void InitShrouds() {
        this.shrouds = new List<MapShroud>();
        for (int h = 0; h < 8; h = h + 1) {
            this.shrouds.Add(MapShroud.Create(this.width, this.height));
            this.shrouds[h].SeedElevation(this);
        }
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            this.ShroudRevealObject(this.objects[i]);
        }
        for (int h = 0; h < 8; h = h + 1) {
            this.shrouds[h].Update();
        }
    }

    /// <summary>The house's fog of war, or null outside the skirmish
    /// houses (Neutral sees and is seen without a shroud of its own).</summary>
    MapShroud ShroudOf(int house) {
        if (house < 0 || house >= 8) { return null; }
        if (this.shrouds == null) { return null; }
        MapShroud s = this.shrouds[house];
        return s;
    }
    /// <summary>Queues the sight reveal one object casts for its owner --
    /// the reference's revealFrom on spawn, tile change and elevation
    /// change. Walls are buildings in name only: their sight is zero and
    /// they reveal nothing, exactly like the reference's wallTrait skip.</summary>
    void ShroudRevealObject(WorldObject o) {
        if (o == null || o.IsDead()) { return; }
        int house = o.Side();
        if (house == Side2.Neutral()) { return; }
        MapShroud s = this.ShroudOf(house);
        if (s == null) { return; }
        int sight = 0;
        if (o.Kind() == ObjKind.Structure()) {
            StructureType t = this.catalog.TypeFor(this, house, o.BuildId());
            sight = t != null ? t.Sight() : 0;
        }
        else {
            UnitType ut = o.UnitType();
            sight = ut != null ? ut.Sight() : 0;
            // The veteran SIGHT factor, capped like the rules' own cap.
            if (sight > 0) {
                sight = sight * this.VetSightPermille(o) / 1000;
                if (sight < 1) { sight = 1; }
                if (sight > 11) { sight = 11; }
            }
        }
        s.RevealFrom(o.X(), o.Y(), this.LevelAt(o.X(), o.Y()), sight);
    }

    // ---- veterancy (the reference's VeteranTrait) ---------------------------

    /// <summary>The promotion threshold in XP: the target's cost times the
    /// [General] VeteranRatio= (per-mille) plus one -- the reference's
    /// constructor maths kept integral.</summary>
    int PromoteThreshold(WorldObject o) {
        int cost = 0;
        if (o.Kind() == ObjKind.Unit() && o.UnitType() != null) {
            cost = o.UnitType().Cost();
        } else if (o.Kind() == ObjKind.Structure()) {
            StructureType t = this.TypeOf(o);
            cost = t != null ? t.Cost() : 0;
        }
        return cost * this.Rules().VeteranRatioM() / 1000 + 1;
    }

    /// <summary>Whether the ability sits on the unit's list for its rank:
    /// the reference's hasVeteranAbility -- the veteran list gates rank 1,
    /// the elite list (which unions the veteran one) ranks 2+.</summary>
    bool HasVetAbility(WorldObject o, int ability) {
        if (o.Kind() != ObjKind.Unit() || o.UnitType() == null) { return false; }
        if (o.VeteranLevel() == VetLevel.Veteran()) {
            return o.UnitType().VeteranAbilities().Contains(ability);
        }
        if (o.VeteranLevel() >= VetLevel.Elite()) {
            return o.UnitType().EliteAbilities().Contains(ability);
        }
        return false;
    }

    /// <summary>The multipliers, per-mille: 1000 unless the rank gates the
    /// matching ability, then the veteran rules' factor.</summary>
    int VetSpeedPermille(WorldObject o) {
        return this.HasVetAbility(o, VetAbility.Faster())
            ? this.Rules().VeteranSpeedM() : 1000;
    }
    int VetArmorPermille(WorldObject o) {
        return this.HasVetAbility(o, VetAbility.Stronger())
            ? this.Rules().VeteranArmorM() : 1000;
    }
    int VetFirepowerPermille(WorldObject o) {
        return this.HasVetAbility(o, VetAbility.Firepower())
            ? this.Rules().VeteranCombatM() : 1000;
    }
    int VetRofPermille(WorldObject o) {
        return this.HasVetAbility(o, VetAbility.Rof())
            ? this.Rules().VeteranRofM() : 1000;
    }
    int VetSightPermille(WorldObject o) {
        return this.HasVetAbility(o, VetAbility.Sight())
            ? this.Rules().VeteranSightM() : 1000;
    }

    /// <summary>The total damage package a shooter fires with, per-mille:
    /// the veteran FIREPOWER factor (per-mille) times the crate firepower
    /// bonus (a raw x1/x2 multiplier) -- the reference's
    /// baseDamageMultiplier product.</summary>
    int FirepowerPermilleOf(WorldObject shooter) {
        return this.VetFirepowerPermille(shooter) * shooter.CrateFirepower();
    }

    /// <summary>The victim's damage intake adjustment, the reference's
    /// warhead impact order: the veteran STRONGER factor divides first,
    /// then the crate armour bonus. Applied after the verse so the shipped
    /// damage pipeline order is kept.</summary>
    int VictimArmorAdjust(WorldObject victim, int dmg) {
        int d = dmg * 1000 / this.VetArmorPermille(victim);
        return d / victim.CrateArmor();
    }

    /// <summary>The XP award for a kill, the reference's
    /// NotifyTargetDestroy path: the victim's cost times (its rank + 1).
    /// Friendly fire and self-hits pay nothing; a rank at the cap banks
    /// nothing. Promotion plays the shipped rank-up sound through the
    /// sink's UnitPromote event.</summary>
    void AwardKillXP(WorldObject killer, WorldObject victim) {
        if (killer == null || killer.IsDead()
         || killer.Kind() != ObjKind.Unit()
         || killer.UnitType() == null) { return; }
        if (victim == null || victim.Side() == Side2.Neutral()
         || victim.Side() == killer.Side()) { return; }
        int cap = this.Rules().VeteranCap();
        if (killer.VeteranLevel() >= cap) { return; }
        int cost = 0;
        if (victim.Kind() == ObjKind.Unit() && victim.UnitType() != null) {
            cost = victim.UnitType().Cost();
        } else if (victim.Kind() == ObjKind.Structure()) {
            StructureType t = this.TypeOf(victim);
            cost = t != null ? t.Cost() : 0;
        }
        if (cost <= 0) { return; }
        this.GainVetXp(killer, cost * (victim.VeteranLevel() + 1));
    }

    /// <summary>Banks XP and promotes on crossing the threshold, the
    /// reference's gainXP: the overflow carries, each level spend is one
    /// threshold, and the level never passes the cap.</summary>
    void GainVetXp(WorldObject o, int amount) {
        o.SetVeteranXp(o.VeteranXp() + amount);
        int thresh = this.PromoteThreshold(o);
        if (o.VeteranXp() < thresh) { return; }
        int cap = this.Rules().VeteranCap();
        int newLevel = o.VeteranLevel() + o.VeteranXp() / thresh;
        if (newLevel > cap) { newLevel = cap; }
        int gain = newLevel - o.VeteranLevel();
        if (gain <= 0) { return; }
        o.SetVeteranXp(o.VeteranXp() - gain * thresh);
        o.SetVeteranLevel(newLevel);
        this.HandlePromotion(o);
        if (this.sndSink != null) {
            this.sndSink.PromoteFeedback(o.Side(), newLevel);
        }
    }

    /// <summary>The ability effects a fresh rank grants, the reference's
    /// handlePromotion. Only CRUSHER is live in this engine: the rest --
    /// SELF_HEAL, CLOAK, EXPLODES, RADAR_INVISIBLE, SENSORS, FEARLESS, C4,
    /// GUARD_AREA -- need systems still to migrate, and their abilities are
    /// read straight off the veteran lists wherever they are consulted.</summary>
    void HandlePromotion(WorldObject o) {
        if (o == null || o.Kind() != ObjKind.Unit()) { return; }
        if (this.HasVetAbility(o, VetAbility.Crusher()) && !o.Crusher()) {
            o.SetCrusher(true);
        }
    }

    /// <summary>The opening-squad rank switch, the reference's
    /// applyInitialVeteran: with the [General] InitialVeteran= flag a
    /// starting unit opens at Elite. Only units carry the trait; the
    /// country's VeteranUnits= fallback to Veteran has no port-side
    /// counterpart yet, and factory production never consults this.</summary>
    void ApplyInitialVeteran(WorldObject o) {
        if (!this.Rules().InitialVeteran()) { return; }
        if (o == null || o.Kind() != ObjKind.Unit()) { return; }
        o.SetVeteranLevel(VetLevel.Elite());
    }

    // ---- crushing (the reference's MoveTrait crusher pass) -----------------

    /// <summary>Whether `o` carries the Crusher= flag: the type's own key,
    /// flipped on at promotion by the veteran CRUSHER ability. This is the
    /// reference's `gameObject.crusher` -- the flag alone, with no
    /// locomotion check. The tracked/hover class gate belongs to the
    /// movement obstacle test (CanCrushInto), exactly where the reference
    /// puts it.</summary>
    bool HasCrusherFlag(WorldObject o) {
        return o != null && o.Kind() == ObjKind.Unit() && o.Crusher();
    }

    /// <summary>Whether `o` may roll over crushable things: the Crusher=
    /// flag and a locomotion class that rolls -- the reference's MoveTask
    /// gate, `[SpeedType.Track, SpeedType.Hover].includes(speedType) &&
    /// unit.crusher`. A wheeled vehicle is stopped by a sandbag line even
    /// when a veteran ability hands it the flag.</summary>
    bool IsCrusher(WorldObject o) {
        if (o == null || o.Kind() != ObjKind.Unit() || o.UnitType() == null) {
            return false;
        }
        if (!o.Crusher()) { return false; }
        return SpeedType.CrusherClass(o.UnitType().SpeedTypeValue());
    }

    /// <summary>Whether a crusher driving onto (x,y) flattens `o`: the
    /// reference's crush filter -- crushable, and either non-techno
    /// scenery or a non-friendly (friendly units are never run over). A
    /// paratrooper still under canopy is exempt in the reference; this
    /// engine has no paradrop stance yet, so that clause waits with it.</summary>
    bool CrushApplies(WorldObject crusher, WorldObject o) {
        if (o == null || o.IsDead() || o == crusher) { return false; }
        if (o.Kind() == ObjKind.Unit() && o.UnitType() != null) {
            if (!o.UnitType().Crushable()) { return false; }
        } else if (o.Kind() == ObjKind.Structure()) {
            StructureType t = this.TypeOf(o);
            if (t == null || !t.Crushable()) { return false; }
        } else {
            return false;
        }
        // areFriendly: same owner (or allied) things are spared, so only
        // neutrals and enemies go under the tracks.
        return !this.AreFriendly(crusher, o);
    }

    /// <summary>The reference's Game.areFriendly: same owner or allied.
    /// This engine has no alliance graph yet, so same-side stands in --
    /// the port's own areFriendly call sites all reduce to it.</summary>
    bool AreFriendly(WorldObject a, WorldObject b) {
        if (a == null || b == null) { return false; }
        return a.Side() == b.Side();
    }

    /// <summary>Whether the hull at `o` may drive into the occupied or
    /// walled cell (nx,ny) instead of queueing behind it -- the reference's
    /// MoveTask obstacle pass: a crushable obstacle is passable when the
    /// unit is a crusher and the thing is not friendly (or is scenery).</summary>
    bool CanCrushInto(WorldObject o, int nx, int ny) {
        if (!this.IsCrusher(o)) { return false; }
        // A wall piece the overlay rules call Crushable= (sandbags, the
        // fences) flattens; the concrete walls stop even a crusher.
        if (this.IsWallCell(nx, ny)) {
            return this.Rules().OverlayCrushable(this.WallOvAt(nx, ny));
        }
        int occ = this.occupancy[this.CellSlot(nx, ny)];
        if (occ == 0) { return false; }
        WorldObject e = this.objects[occ - 1];
        if (e == null || e.IsDead()) { return false; }
        if (e.Kind() == ObjKind.Structure()) { return false; }
        return this.CrushApplies(o, e);
    }

    /// <summary>Runs the crusher pass over the cell the hull just entered,
    /// the reference's MoveTrait tile-change block: every crushable thing
    /// on the tile is destroyed with DeathType.Crush -- infantry leave no
    /// corpse (their death art is skipped) and the hull that flattens a
    /// wall takes the rocking tilt. Friendly units and the hull itself are
    /// exempt. The pass keys off the flag alone, the reference's
    /// `if (gameObject.crusher)`: the class gate lives in the movement
    /// test that decides whether the hull may enter at all.</summary>
    void CrushOnCell(WorldObject crusher, int x, int y) {
        if (!this.HasCrusherFlag(crusher)) { return; }
        int i = 0;
        while (i < this.objects.Count) {
            WorldObject o = this.objects[i];
            if (o == null || o.X() != x || o.Y() != y) { i = i + 1; continue; }
            if (!this.CrushApplies(crusher, o)) { i = i + 1; continue; }
            if (o.Kind() == ObjKind.Unit() && o.UnitType() != null) {
                o.SetInfDeath(0);   // no death art: the corpse never plays
            }
            o.SetDeathType(DeathType.Crush());
            this.SndCrushFeedback(o);
            this.AwardKillXP(crusher, o);
            o.SetHp(0);
            i = i + 1;
        }
        // The wall piece under the tracks, if any: a vehicle flattening a
        // crushable wall rocks over the debris, the reference's
        // `applyRocking(0, 0.5)` on the overlay branch.
        if (this.IsWallCell(x, y)) {
            this.CrushWallAt(crusher, x, y);
        }
    }

    /// <summary>The squish a crushed thing plays: its own CrushSound= key
    /// when the section names one (infantry ship InfantrySquish). The
    /// reference reads the key into ObjectRules but never plays it -- the
    /// retail game does, so the port routes it through the sound sink and
    /// the gap is recorded in the README rather than silently dropped.</summary>
    void SndCrushFeedback(WorldObject victim) {
        if (this.sndSink == null) { return; }
        string key = null;
        if (victim.Kind() == ObjKind.Unit() && victim.UnitType() != null) {
            key = victim.UnitType().CrushSound();
        } else if (victim.Kind() == ObjKind.Structure()) {
            StructureType t = this.TypeOf(victim);
            if (t != null) { key = t.CrushSound(); }
        }
        if (key == null || key.Length == 0) { return; }
        this.sndSink.CrushSoundFeedback(key, victim.Side(), victim.X(),
                                        victim.Y());
    }

    /// <summary>Flattens a wall piece under the hull: the reference's crush
    /// pass treats a crushable wall overlay like any other victim -- it is
    /// destroyed outright (no linked half-damage to its neighbours, which
    /// only a warhead hit spreads) and the vehicle that ran it over rocks.
    /// The reference's `if (this.bodyVxlBuilder)` gate is a voxel-model
    /// check; the rocking request is stored on the hull either way and the
    /// render layer draws it for the models it can tilt.</summary>
    void CrushWallAt(WorldObject crusher, int x, int y) {
        int ov = this.WallOvAt(x, y);
        if (ov < 0) { return; }
        if (!this.Rules().OverlayCrushable(ov)) { return; }
        if (this.sndSink != null) {
            string key = this.Rules().OverlayCrushSound(ov);
            if (key != null && key.Length > 0) {
                this.sndSink.CrushSoundFeedback(key, crusher.Side(), x, y);
            }
        }
        // The hull tilts over the debris, the reference's
        // `applyRocking(0, 0.5)` -- factor 500 in thousandths.
        crusher.ApplyRocking(0, 500);
        this.BreakWallAt(x, y);
    }

    /// <summary>Takes a wall piece down without the linked half-damage a
    /// warhead hit spreads (WallTrait's onDamage only runs for damage; a
    /// crush destroys the overlay outright). Neighbours rebuild their
    /// connection faces around the gap.</summary>
    void BreakWallAt(int x, int y) {
        if (!this.IsWallCell(x, y)) { return; }
        int slot = this.CellSlot(x, y);
        this.wallOv[slot] = 0 - 1;
        this.wallHp[slot] = 0;
        this.wallData[slot] = 0;
        this.oreVersion = this.oreVersion + 1;
        this.ReconnectWallAt(x, y - 1);
        this.ReconnectWallAt(x + 1, y);
        this.ReconnectWallAt(x, y + 1);
        this.ReconnectWallAt(x - 1, y);
    }

    // ---- veterancy crates (grantVeteran/Armor/Firepower/SpeedPowerup) ------

    /// <summary>Whether the crate upgrade applies to this picker: the
    /// reference's gate is the matching bonus still at 1 (unboosted) -- an
    /// already-boosted army does not stack a second crate of the kind. The
    /// veteran crate instead needs headroom below the cap.</summary>
    bool CrateUpgradeApplies(WorldObject unit, int crateType) {
        if (unit.Kind() != ObjKind.Unit() || unit.UnitType() == null) {
            return false;
        }
        if (crateType == Rules.PowerupVeteran()) {
            return unit.VeteranLevel() < this.Rules().VeteranCap();
        }
        if (crateType == Rules.PowerupArmor()) {
            return unit.CrateArmor() == 1;
        }
        if (crateType == Rules.PowerupFirepower()) {
            return unit.CrateFirepower() == 1;
        }
        if (crateType == Rules.PowerupSpeed()) {
            return unit.CrateSpeed() == 1;
        }
        return false;
    }

    /// <summary>The rank crate, grantVeteranPowerup: every own unit within
    /// CrateRadius promotes by the crate's Data= levels, capped.</summary>
    void GrantCrateVeteran(WorldObject unit, int pow, int x, int y) {
        int levels = this.rules_dataInt(this.Rules().PowerupDataAt(pow), 1);
        if (levels < 1) { levels = 1; }
        List<WorldObject> around = this.UnitsInCrateRadius(unit, x, y);
        for (int i = 0; i < around.Count; i = i + 1) {
            WorldObject o = around[i];
            int cap = this.Rules().VeteranCap();
            int nl = o.VeteranLevel() + levels;
            if (nl > cap) { nl = cap; }
            if (nl > o.VeteranLevel()) {
                o.SetVeteranLevel(nl);
                this.HandlePromotion(o);
            }
        }
    }

    /// <summary>The three stat crates, the grant*Powerup triple: every own
    /// in-radius unit whose matching bonus is still 1 picks the crate's
    /// Data= multiplier up for life.</summary>
    void GrantCrateStat(WorldObject unit, int pow, int x, int y,
                        int crateType) {
        int mult = this.rules_dataInt(this.Rules().PowerupDataAt(pow), 1);
        if (mult < 1) { mult = 1; }
        List<WorldObject> around = this.UnitsInCrateRadius(unit, x, y);
        for (int i = 0; i < around.Count; i = i + 1) {
            WorldObject o = around[i];
            if (crateType == Rules.PowerupArmor()
             && o.CrateArmor() == 1) { o.SetCrateArmor(mult); }
            else if (crateType == Rules.PowerupFirepower()
                  && o.CrateFirepower() == 1) { o.SetCrateFirepower(mult); }
            else if (crateType == Rules.PowerupSpeed()
                  && o.CrateSpeed() == 1) { o.SetCrateSpeed(mult); }
        }
    }

    /// <summary>The crate radius walk, getUnitsInCrateRadius: every own
    /// living unit within [CrateRules] CrateRadius= cells of the crate --
    /// Euclidean, the reference's RangeHelper.tileDistance comparing tile
    /// centres with Vector2.distanceTo, kept integral by squaring both
    /// sides.</summary>
    List<WorldObject> UnitsInCrateRadius(WorldObject unit, int x, int y) {
        List<WorldObject> outList = new List<WorldObject>();
        int radius = this.Rules().CrateRadius();
        int r2 = radius * radius;
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o == null || o.IsDead() || o.Side() != unit.Side()
             || o.Kind() != ObjKind.Unit()) { continue; }
            int dx = x - o.X();
            int dy = y - o.Y();
            if (dx * dx + dy * dy <= r2) {
                outList.Add(o);
            }
        }
        return outList;
    }

    // The goodie crates: live records in parallel lists (cell x, cell y,
    // the rolled powerup index, ticks until the crate despawns), the init
    // scan's rim columns, and the lobby switch. The reference spawns the
    // crate as an overlay object carrying its PowerupType; the port keeps
    // that state here and the render layer reads the same lists.
    bool cratesOn;
    List<int> crateX;
    List<int> crateY;
    List<int> cratePow;
    List<int> crateTicks;
    List<int> crateEdgeX;
    List<int> crateEdgeY;
    bool crateEdgeWater;
    int crateMin;

    // The controller owns the wallets, so it mirrors them here after
    // draining the money events; the free-MCV crate branch reads this to
    // gate the grant on credits. One tick stale at worst.
    List<int> creditSnap;

    /// <summary>Builds the crate layer, the reference's init: the column
    /// scan collects each column's first and last landable cell (the rim
    /// the spawn bias favours), records whether any land rim exists at all,
    /// and sizes the population floor to crateMinimum per human -- this
    /// port's skirmish seats exactly one. Nothing spawns here; the first
    /// tick tops the field up.</summary>
    void InitCrates(bool on) {
        this.cratesOn = on;
        this.crateX = new List<int>();
        this.crateY = new List<int>();
        this.cratePow = new List<int>();
        this.crateTicks = new List<int>();
        this.crateEdgeX = new List<int>();
        this.crateEdgeY = new List<int>();
        this.crateEdgeWater = false;
        this.creditSnap = new List<int>();
        int landEdges = 0;
        for (int x = 0; x < this.width; x = x + 1) {
            int firstY = 0 - 1;
            int lastY = 0 - 1;
            bool waterStart = false;
            bool waterEnd = false;
            for (int y = 0; y < this.height; y = y + 1) {
                IsoTile tile = this.iso.At(x, y);
                if (tile != null && this.CrateCanPlace(x, y)) {
                    bool isWater = this.IsWater(tile);
                    if (firstY < 0) {
                        if (isWater) {
                            waterStart = true;
                            waterEnd = true;
                        } else {
                            firstY = y;
                            lastY = y;
                        }
                    } else {
                        if (!isWater) { lastY = y; }
                        waterEnd = isWater;
                    }
                } else if (firstY >= 0 && tile == null) {
                    break;   // the reference's column walk stops at a gap
                }
            }
            if (firstY >= 0) {
                this.crateEdgeX.Add(x);
                this.crateEdgeY.Add(firstY);
                if (lastY >= 0 && lastY != firstY) {
                    this.crateEdgeX.Add(x);
                    this.crateEdgeY.Add(lastY);
                }
                if (!waterStart && !waterEnd) { landEdges = landEdges + 1; }
            }
        }
        this.crateEdgeWater = landEdges == 0;
        this.crateMin = this.Rules().CrateMinimum();
    }

    void SetCreditSnap(int side, int amount) {
        if (side < 0) { return; }
        if (this.creditSnap == null) { this.creditSnap = new List<int>(); }
        while (this.creditSnap.Count <= side) { this.creditSnap.Add(0); }
        this.creditSnap[side] = amount;
    }

    int CreditSnap(int side) {
        if (side < 0 || side >= this.creditSnap.Count) { return 0; }
        return this.creditSnap[side];
    }

    /// <summary>Whether a crate may sit on this cell, the reference's
    /// canPlaceCrateOnTile: in bounds, no ground object on the tile (walls,
    /// scenery, ore, bridges, a crate already there), amphibiously
    /// passable ground or water, never the Shore strip, and flat.</summary>
    bool CrateCanPlace(int x, int y) {
        if (!this.InBounds(x, y)) { return false; }
        int slot = this.CellSlot(x, y);
        if (this.occupancy[slot] != 0) { return false; }
        if (this.IsWallCell(x, y)) { return false; }
        if (this.statOv[slot] >= 0 || this.brOv[slot] >= 0
         || this.oreOv[slot] >= 0) { return false; }
        if (this.CrateAt(x, y) >= 0) { return false; }
        if (!this.PassableForRoute(x, y, true)) { return false; }
        IsoTile t = this.iso.At(x, y);
        if (t == null) { return false; }
        LandType lt = this.CellLand(t);
        if (lt != null && lt.Value() == LandType.Beach()) { return false; }
        if (this.CellRampAt(x, y) != 0) { return false; }
        return true;
    }

    /// <summary>The crate record on a cell, or -1.</summary>
    int CrateAt(int x, int y) {
        if (this.crateX == null) { return 0 - 1; }
        for (int i = 0; i < this.crateX.Count; i = i + 1) {
            if (this.crateX[i] == x && this.crateY[i] == y) { return i; }
        }
        return 0 - 1;
    }

    void RemoveCrateAt(int i) {
        this.crateX.RemoveAt(i);
        this.crateY.RemoveAt(i);
        this.cratePow.RemoveAt(i);
        this.crateTicks.RemoveAt(i);
        // The terrain layer bakes the crate art in like the ore and walls,
        // so a despawn is a scene change.
        this.oreVersion = this.oreVersion + 1;
    }

    /// <summary>Read-only views for the render layer, which bakes the
    /// crates into the terrain canvas from the live lists.</summary>
    List<int> CrateXList() { return this.crateX; }
    List<int> CrateYList() { return this.crateY; }
    int CrateCount() {
        return this.crateX != null ? this.crateX.Count : 0;
    }

    /// <summary>The crate heartbeat, the reference's onTick: expired crates
    /// despawn, and while the lobby keeps crates on the field is topped
    /// back up to the floor.</summary>
    void TickCrates() {
        if (this.crateX == null) { return; }
        for (int i = this.crateX.Count - 1; i >= 0; i = i - 1) {
            int left = this.crateTicks[i] - 1;
            if (left <= 0) { this.RemoveCrateAt(i); }
            else { this.crateTicks[i] = left; }
        }
        if (this.cratesOn) {
            int guard = 0;
            while (this.crateX.Count < this.crateMin && guard < 8) {
                guard = guard + 1;
                if (!this.SpawnCrateRandom()) { break; }
            }
        }
    }

    /// <summary>One random crate attempt, the reference's spawnCrateAtRandom:
    /// two thirds of the rolls (one third off an all-water rim) draw from
    /// the rim columns, otherwise from the open field, with up to 100
    /// placement tries before a dense scan stands in for the reference's
    /// read of the occupation map's empty tiles.</summary>
    bool SpawnCrateRandom() {
        double share = 2.0 / 3.0;
        if (this.crateEdgeWater) { share = 1.0 / 3.0; }
        bool useEdge = this.crateEdgeX.Count > 0
                    && this.WorldRandFrac() < share;
        for (int a = 0; a < 100; a = a + 1) {
            int x = 0;
            int y = 0;
            if (useEdge) {
                int k = this.WorldRand(this.crateEdgeX.Count);
                x = this.crateEdgeX[k];
                y = this.crateEdgeY[k];
            } else {
                x = this.WorldRand(this.width);
                y = this.WorldRand(this.height);
            }
            if (this.CrateCanPlace(x, y)) { return this.SpawnCrateAt(x, y); }
        }
        int total = this.width * this.height;
        int start = this.WorldRand(total);
        for (int i = 0; i < total; i = i + 1) {
            int cell = (start + i) % total;
            int cx = cell % this.width;
            int cy = cell / this.width;
            if (this.CrateCanPlace(cx, cy)) { return this.SpawnCrateAt(cx, cy); }
        }
        return false;
    }

    /// <summary>Places one crate and rolls its powerup, the reference's
    /// spawnCrateAt: the crate lives 60 * crateRegen * 30 * (0.5 + 1.5 *
    /// rand) ticks before it despawns unclaimed.</summary>
    bool SpawnCrateAt(int x, int y) {
        if (!this.CrateCanPlace(x, y)) { return false; }
        int pow = this.ChoosePowerup(this.IsWater(this.iso.At(x, y)));
        if (pow < 0) { return false; }
        this.crateX.Add(x);
        this.crateY.Add(y);
        this.cratePow.Add(pow);
        int ticks = 60 * this.Rules().CrateRegen() * 30;
        ticks = (int)(ticks * (0.5 + 1.5 * this.WorldRandFrac()));
        this.crateTicks.Add(ticks);
        this.oreVersion = this.oreVersion + 1;
        return true;
    }

    /// <summary>A crate with a pinned powerup and lifetime: the shipped
    /// game only rolls, but the selftest's determinism wants both fixed.</summary>
    bool SpawnCratePinned(int x, int y, int pow, int ticks) {
        if (!this.CrateCanPlace(x, y)) { return false; }
        this.crateX.Add(x);
        this.crateY.Add(y);
        this.cratePow.Add(pow);
        this.crateTicks.Add(ticks);
        this.oreVersion = this.oreVersion + 1;
        return true;
    }

    /// <summary>The share-weighted roll, the reference's choosePowerup:
    /// water crates draw only from the water-allowed powerups, and the
    /// pick is an inclusive roll across the summed shares.</summary>
    int ChoosePowerup(bool water) {
        Rules rules = this.Rules();
        int total = 0;
        int count = rules.PowerupCount();
        for (int i = 0; i < count; i = i + 1) {
            if (water && !rules.PowerupWaterAt(i)) { continue; }
            total = total + rules.PowerupSharesAt(i);
        }
        if (total <= 0) { return 0 - 1; }
        int roll = this.WorldRand(total + 1);
        int sum = 0;
        for (int i = 0; i < count; i = i + 1) {
            if (water && !rules.PowerupWaterAt(i)) { continue; }
            sum = sum + rules.PowerupSharesAt(i);
            if (roll < sum) { return i; }
        }
        return 0 - 1;
    }

    /// <summary>The pickup check a unit runs on every cell it steps onto,
    /// the reference's pickupCrate: the crate is consumed, its powerup
    /// resolves, and while the lobby keeps crates on the taken crate is
    /// replaced at once. Neutral scenery -- cows, cars -- never picks up.</summary>
    void PickupCrateAt(WorldObject o) {
        if (o == null || o.IsDead()) { return; }
        if (o.Side() == Side2.Neutral()) { return; }
        if (this.crateX == null || this.crateX.Count == 0) { return; }
        int i = this.CrateAt(o.X(), o.Y());
        if (i < 0) { return; }
        int pow = this.cratePow[i];
        int cx = this.crateX[i];
        int cy = this.crateY[i];
        this.RemoveCrateAt(i);
        this.GrantPowerup(o, pow, cx, cy);
        if (this.cratesOn) { this.SpawnCrateRandom(); }
    }

    /// <summary>Resolves a rolled powerup, the reference's grantPowerup.
    /// The live set is what this engine has systems for: money, heal base,
    /// reveal, darkness, the free unit, the two bombs and the ore drop.
    /// The bonuses that need systems still to migrate -- veteran
    /// promotion, the armour/firepower/speed multipliers, cloak, the two
    /// superweapon gifts -- fail their grant, and a failed crate degrades
    /// to money exactly like the reference's own failure path.</summary>
    void GrantPowerup(WorldObject unit, int pow, int x, int y) {
        Rules rules = this.Rules();
        int side = unit.Side();
        int type = pow >= 0 && pow < rules.PowerupCount()
                 ? rules.PowerupTypeAt(pow) : 0 - 1;
        bool ok = false;
        if (type == Rules.PowerupMoney()) {
            ok = true;
            this.GrantMoneyCrate(side, rules.PowerupDataAt(pow));
        } else if (type == Rules.PowerupHealBase()) {
            ok = true;
            for (int i = 0; i < this.objects.Count; i = i + 1) {
                WorldObject o = this.objects[i];
                if (o == null || o.IsDead() || o.Side() != side) { continue; }
                o.SetHp(o.MaxHp());
            }
        } else if (type == Rules.PowerupReveal()) {
            ok = true;
            MapShroud s = this.ShroudOf(side);
            if (s != null) { s.RevealAll(); }
        } else if (type == Rules.PowerupDarkness()) {
            ok = true;
            MapShroud s = this.ShroudOf(side);
            if (s != null) {
                s.Reset();
                // resetShroud re-reveals the owner's own forces afterwards;
                // the queued reveals flush in this tick's shroud update.
                for (int i = 0; i < this.objects.Count; i = i + 1) {
                    WorldObject o = this.objects[i];
                    if (o == null || o.IsDead() || o.Side() != side) { continue; }
                    this.ShroudRevealObject(o);
                }
            }
        } else if (type == Rules.PowerupUnit()) {
            ok = this.GrantCrateUnit(unit, x, y);
        } else if (type == Rules.PowerupVeteran()) {
            ok = this.CrateUpgradeApplies(unit, type);
            if (ok) { this.GrantCrateVeteran(unit, pow, x, y); }
        } else if (type == Rules.PowerupArmor()
                || type == Rules.PowerupFirepower()
                || type == Rules.PowerupSpeed()) {
            ok = this.CrateUpgradeApplies(unit, type);
            if (ok) { this.GrantCrateStat(unit, pow, x, y, type); }
        } else if (type == Rules.PowerupExplosion()
                || type == Rules.PowerupNapalm()) {
            ok = this.GrantCrateBoom(unit, pow, x, y);
        } else if (type == Rules.PowerupTiberium()) {
            ok = this.GrantCrateOre(x, y);
        }
        // The pickup speaks for the RESOLVED outcome: a grant that failed
        // degrades to money above, so the money crate is the one heard. A
        // hostile pickup stays silent (the reference's isHostilePickup).
        int resolvedType = ok ? type : Rules.PowerupMoney();
        if (!ok) {
            for (int i = 0; i < rules.PowerupCount(); i = i + 1) {
                if (rules.PowerupTypeAt(i) == Rules.PowerupMoney()
                 && rules.PowerupSharesAt(i) > 0) {
                    this.GrantMoneyCrate(side, rules.PowerupDataAt(i));
                    break;
                }
            }
        }
        this.SndCrateFeedback(side, x, y, resolvedType);
    }

    /// <summary>The money payout, the reference's grantMoneyPowerup: the
    /// data field scaled into 55%..145% of itself, queued for the
    /// controller's wallet (the world owns no credits).</summary>
    void GrantMoneyCrate(int side, string data) {
        int amount = this.rules_dataInt(data, 10000);
        double roll = 0.55 + 2.0 * this.WorldRandFrac() * 0.45;
        this.events.Add(1);
        this.events.Add(side);
        this.events.Add((int)(amount * roll));
    }

    /// <summary>A rules Data= payload as a plain integer, the default when
    /// the field is missing or not numeric.</summary>
    int rules_dataInt(string s, int dflt) {
        if (s == null || s.Length == 0) { return dflt; }
        int v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 0xFF;
            if (c < 48 || c > 57) { return dflt; }
            v = v * 10 + (c - 48);
        }
        return v;
    }

    /// <summary>The two live bombs, the reference's grantExplosionPowerup:
    /// the crate's data is raw damage through the [CombatDamage] warhead --
    /// FlameDamage for napalm, C4Warhead for the rest -- detonated on the
    /// picker's own cell. The wave is friendly to nobody: the reference
    /// detonates with friendly fire allowed, so the picker's troops, the
    /// neighbours' and the neutrals all take it. SplashAround's falloff
    /// maths, minus its shooter-side exemption. An unresolved warhead
    /// fails the grant, degrading the crate to money.</summary>
    bool GrantCrateBoom(WorldObject unit, int pow, int x, int y) {
        Rules rules = this.Rules();
        int type = rules.PowerupTypeAt(pow);
        string whName = type == Rules.PowerupNapalm()
                      ? rules.FlameDamage() : rules.C4Warhead();
        Warhead wh = rules.WarheadByName(whName);
        if (wh == null) { return false; }
        int dmg = this.rules_dataInt(rules.PowerupDataAt(pow), 500);
        if (dmg <= 0) { dmg = 500; }
        int zero = this.OccupantAt(x, y);
        if (zero >= 0) {
            WorldObject d = this.objects[zero];
            int armor = this.ArmorOf(d);
            int zd = dmg * wh.Verse(armor) / 100;
            zd = this.VictimArmorAdjust(d, zd);
            d.TakeDamageAs(zd, wh.InfDeath());
            this.SndBuildingDamage(d, zd);
            this.SuppressTrooper(d);
        }
        if (wh.Spread() <= 0) { return true; }
        int radius = wh.Spread() + 2;
        int half = this.Rules().SplashScale() > 0
            ? this.Rules().SplashScale() : 50;
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (i == zero || o == null || o.IsDead()) { continue; }
            int vx = o.X() - x;
            if (vx < 0) { vx = 0 - vx; }
            int vy = o.Y() - y;
            if (vy < 0) { vy = 0 - vy; }
            if (vx > radius || vy > radius) { continue; }
            int d2 = vx + vy;
            if (d2 > radius) { continue; }
            int damp = (radius - d2) * (dmg * half / 100) / radius;
            if (damp <= 0) { continue; }
            damp = this.VictimArmorAdjust(o, damp);
            o.TakeDamageAs(damp, wh.InfDeath());
            this.SndBuildingDamage(o, damp);
            this.SuppressTrooper(o);
        }
        return true;
    }

    /// <summary>The ore drop, the reference's grantTiberiumPowerup: up to
    /// six rolls land within two cells of the crate, each growing one
    /// value-3 bail wherever flat land takes it -- the growth pass's own
    /// placement primitive.</summary>
    bool GrantCrateOre(int x, int y) {
        bool ok = false;
        for (int a = 0; a < 6; a = a + 1) {
            int tx = x + this.WorldRand(5) - 2;
            int ty = y + this.WorldRand(5) - 2;
            if (this.TibTrySpawn(tx, ty)) { ok = true; }
        }
        return ok;
    }

    /// <summary>The free unit, the reference's grantUnitPowerup: a
    /// commander with no construction yard and no base unit gets his MCV
    /// back once his wallet covers what his side's starting base cost
    /// (the build-power and build-refinery lists); anyone else rolls the
    /// CrateGoodie vehicles, or the [General] UnitCrateType override when
    /// the rules name one. The unit walks out onto the first free cell
    /// around the crate, the reference's RadialTileFinder probe.</summary>
    bool GrantCrateUnit(WorldObject unit, int x, int y) {
        Rules rules = this.Rules();
        bool hasYard = false;
        bool hasBase = false;
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o == null || o.IsDead() || o.Side() != unit.Side()) { continue; }
            if (o.Kind() == ObjKind.Structure()) {
                StructureType st = this.TypeOf(o);
                if (st != null && st.IsConYard()) { hasYard = true; }
            } else {
                UnitType ut = o.UnitType();
                if (ut != null && ut.DeploysInto() != null
                 && ut.DeploysInto().Length > 0) { hasBase = true; }
            }
        }
        if (!hasYard && rules.FreeMCV() && !hasBase) {
            if (this.CreditSnap(unit.Side())
             >= this.StartingBaseCost(unit.Side())) {
                UnitDef mcv = this.FindMcvDef(unit.Side());
                if (mcv != null) {
                    return this.SpawnDefNear(mcv, unit.Side(), x, y);
                }
                return false;
            }
            // An empty wallet falls through to the goodie roll, the
            // reference's own path when the credits do not cover it.
        }
        string forced = rules.UnitCrateType();
        if (forced != null && forced.Length > 0) {
            for (int i = 0; i < rules.Units().Count; i = i + 1) {
                if (rules.Units()[i].Reg() == forced) {
                    return this.SpawnDefNear(rules.Units()[i], unit.Side(), x, y);
                }
            }
            return false;
        }
        bool water = this.IsWater(this.iso.At(x, y));
        List<UnitDef> pool = new List<UnitDef>();
        if (!water) {
            for (int i = 0; i < rules.Units().Count; i = i + 1) {
                UnitDef d = rules.Units()[i];
                if (d.CrateGoodie()) { pool.Add(d); }
            }
        }
        if (pool.Count == 0) { return false; }
        return this.SpawnDefNear(pool[this.WorldRand(pool.Count)], unit.Side(),
                                 x, y);
    }

    /// <summary>What the reference charges the free MCV against: the cost
    /// of the side's share of the AI's build-power and build-refinery
    /// lists -- the starting base the commander is presumed to have lost.</summary>
    int StartingBaseCost(int side) {
        Rules rules = this.Rules();
        int bit = side == Side2.Allied() ? 1
                : side == Side2.Soviet() ? 2 : 4;
        int cost = 0;
        cost = cost + this.BaseListCost(rules.AiPower(), bit);
        cost = cost + this.BaseListCost(rules.AiRefinery(), bit);
        return cost;
    }

    int BaseListCost(List<string> regs, int bit) {
        Rules rules = this.Rules();
        int cost = 0;
        for (int i = 0; i < regs.Count; i = i + 1) {
            for (int b = 0; b < rules.Buildings().Count; b = b + 1) {
                BuildingDef d = rules.Buildings()[b];
                if (d.Reg() == regs[i] && (d.SideMask() & bit) != 0) {
                    cost = cost + d.Cost();
                }
            }
        }
        return cost;
    }

    /// <summary>The side's deployable construction vehicle, the free-MCV
    /// crate's gift (AMCV, SMCV, PCV in the shipped rules).</summary>
    UnitDef FindMcvDef(int side) {
        Rules rules = this.Rules();
        int bit = side == Side2.Allied() ? 1
                : side == Side2.Soviet() ? 2 : 4;
        for (int i = 0; i < rules.Units().Count; i = i + 1) {
            UnitDef d = rules.Units()[i];
            if (d.DeploysInto() != null && d.DeploysInto().Length > 0
             && (d.SideMask() & bit) != 0) { return d; }
        }
        return null;
    }

    /// <summary>Spawns a rules-level vehicle archetype for a house near the
    /// crate, through its roster slot when the side trains it and from the
    /// archetype itself when it does not -- the reference's
    /// createUnitForPlayer is roster-blind the same way.</summary>
    bool SpawnDefNear(UnitDef d, int side, int x, int y) {
        if (d == null) { return false; }
        int uid = this.units.IdOfReg(this, side, d.Reg());
        if (uid >= 0) {
            return this.SpawnUnitNear(side, uid, x, y, 3) >= 0;
        }
        for (int s = 0; s < 8; s = s + 1) {
            int oid = this.units.IdOfReg(this, s, d.Reg());
            if (oid >= 0) {
                UnitType ut = this.units.ListFor(this, s)[oid];
                return this.SpawnMapUnit(side, oid, x, y, ut.Hp(), 0, ut) >= 0;
            }
        }
        return false;
    }

    /// <summary>SpawnUnit with a Manhattan-ring probe out to radius cells:
    /// the crate's unit walks out onto the first free passable cell around
    /// the crate, the reference's RadialTileFinder (width 1, radius 3).</summary>
    int SpawnUnitNear(int side, int unitId, int x, int y, int radius) {
        for (int d = 0; d <= radius; d = d + 1) {
            for (int dx = 0 - d; dx <= d; dx = dx + 1) {
                int rest = d - (dx < 0 ? 0 - dx : dx);
                int sx = x + dx;
                if (this.UnitSpawnOk(sx, y + rest)) {
                    return this.SpawnUnit(side, unitId, sx, y + rest);
                }
                if (rest != 0 && this.UnitSpawnOk(sx, y - rest)) {
                    return this.SpawnUnit(side, unitId, sx, y - rest);
                }
            }
        }
        return 0 - 1;
    }

    bool UnitSpawnOk(int x, int y) {
        if (!this.InBounds(x, y)) { return false; }
        if (this.occupancy[this.CellSlot(x, y)] != 0) { return false; }
        if (this.IsWallCell(x, y)) { return false; }
        return this.PassableForRoute(x, y, false);
    }

    StructureCatalog Catalog() { return this.catalog; }
    UnitCatalog Units() { return this.units; }
    Rules Rules() { return this.units.Rules(); }

    /// <summary>The archetype of a placed structure, routing civilian
    /// structures to the civ catalog where they live.</summary>
    StructureType TypeOf(WorldObject o) {
        if (o.IsCiv()) { return this.catalog.CivType(o.BuildId()); }
        return this.catalog.TypeFor(this, o.Side(), o.BuildId());
    }

    /// <summary>The archetype of a unit, routing a civilian scenery unit to
    /// the civ unit list where it lives. Mirrors TypeOf for structures: a
    /// map's cow has no roster slot, so a plain side lookup would read past
    /// the end of the roster and hand back some other unit's stats. Units
    /// carry their catalog slot in unitId (a structure's buildId stays -1 on
    /// one), which is why this reads UnitId and not BuildId.</summary>
    UnitType UnitTypeOf(WorldObject o) {
        if (o.IsCiv()) { return this.units.CivUnitType(o.UnitId()); }
        return o.UnitType();
    }

    /// <summary>Spawns a neutral scenery unit (a map's car, a map's cow) by
    /// its civ-list id. Tagged civilian like a civ structure, so the
    /// renderer resolves its art through the civ list and the game logic
    /// leaves it alone.</summary>
    int SpawnCivUnit(int civId, int x, int y, int hp, int facing) {
        UnitType u = this.units.CivUnitType(civId);
        if (u == null) { return -1; }
        if (!this.InBounds(x, y)) { return -1; }
        if (this.occupancy[this.CellSlot(x, y)] != 0
         || this.IsWallCell(x, y)) {
            if (!this.InBounds(x + 1, y)
             || this.occupancy[this.CellSlot(x + 1, y)] != 0) {
                return -1;
            }
            x = x + 1;
        }
        int startHp = hp;
        if (startHp <= 0 || startHp > u.Hp()) { startHp = u.Hp(); }
        WorldObject o = WorldObject.CreateUnit(Side2.Neutral(), civId, x, y,
                                               startHp, u);
        o.SetCiv(true);
        o.SetFacing(facing);
        o.SetTurretFacing(facing);
        // IsCiv() is what keeps it inert: the controller's targeting and
        // movement loops already skip civilian objects, so a scenery unit
        // parks where the map put it.
        return this.AddObject(o);
    }

    // ---- events ---------------------------------------------------------

    /// <summary>Queues a credit grant for a side (kind 1). The controller
    /// applies it to the right wallet when it drains the queue.</summary>
    void AddMoneyEvent(int side, int amount) {
        this.events.Add(1);
        this.events.Add(side);
        this.events.Add(amount);
    }

    /// <summary>Queues a spy theft (kind 2): side steals half the credits of
    /// fromSide. The controller holds both wallets, so it settles the books
    /// when it drains the queue.</summary>
    void AddStealEvent(int side, int fromSide) {
        this.events.Add(2);
        this.events.Add(side);
        this.events.Add(fromSide);
    }

    int EventCount() { return this.events.Count / 3; }
    int EventKindAt(int i) { return this.events[i * 3]; }
    int EventSideAt(int i) { return this.events[i * 3 + 1]; }
    int EventAmountAt(int i) { return this.events[i * 3 + 2]; }
    void ClearEvents() { this.events = new List<int>(); }

    // ---- power state ------------------------------------------------------

    /// <summary>True while a side's grid is blacked out by spy sabotage.</summary>
    bool SideBlackout(int side) {
        if (side < 0 || side >= this.blackout.Count) { return false; }
        return this.blackout[side] > 0;
    }

    void SetBlackout(int side, int ticks) {
        if (side >= 0 && side < this.blackout.Count) {
            this.blackout[side] = ticks;
        }
    }

    /// <summary>True when a side runs short of power: the balance is negative
    /// or the grid is blacked out. Powers the production penalty and takes
    /// powered defences offline. Reads the cache filled by CacheLowPower
    /// once per tick; falls back to a live scan for out-of-band callers
    /// (tests, the controller) whose house was never cached.</summary>
    bool SideLowPower(int side) {
        if (side >= 0 && side < 8 && this.lowPowerTick == this.worldTick) {
            return this.lowPowerCache[side];
        }
        return this.PowerBalance(side) < 0 || this.SideBlackout(side);
    }

    /// <summary>Computes every house's low-power state once per tick. With
    /// up to eight houses the per-building scans are the hottest repeated
    /// work in the tick, so the production loop and the defence loop both
    /// read this cache instead of rescanning for each structure.</summary>
    void CacheLowPower() {
        if (this.lowPowerTick == this.worldTick) { return; }
        for (int s = 0; s < 8; s = s + 1) {
            this.lowPowerCache[s] = this.PowerBalance(s) < 0
                                    || this.SideBlackout(s);
        }
        this.lowPowerTick = this.worldTick;
    }

    // ---- ore fields --------------------------------------------------------

    /// <summary>Seeds one cell's ore: amt is the overlay's data byte (0
    /// clears), val the credits per unit, ov the cell's overlay type id
    /// (the art variant, -1 when the caller does not know).</summary>
    void SetOre(int x, int y, int amt, int val, int ov) {
        if (!this.InBounds(x, y)) { return; }
        int slot = this.CellSlot(x, y);
        bool was = this.oreAmt[slot] > 0;
        this.oreAmt[slot] = amt;
        this.oreVal[slot] = amt > 0 ? val : 0;
        this.oreOv[slot] = amt > 0 ? ov : 0 - 1;
        if (amt > 0 && !was) { this.oreLeft = this.oreLeft + 1; }
        if (amt <= 0 && was) { this.oreLeft = this.oreLeft - 1; }
        // The terrain layer bakes ore art in, so any change is a scene
        // change; the loop watches this counter instead of recompositing
        // speculatively.
        this.oreVersion = this.oreVersion + 1;
    }

    int OreVersion() { return this.oreVersion; }

    // ---- Walls ----------------------------------------------------------

    /// <summary>Stands a wall piece up at a cell: full Strength hit points
    /// (the reference's OverlayRules wall spawn), then the piece and its
    /// cardinal neighbours rebuild their connection masks.</summary>
    void SetWall(int x, int y, int ovIdx) {
        if (ovIdx < 0 || !this.InBounds(x, y)) { return; }
        int slot = this.CellSlot(x, y);
        this.wallOv[slot] = ovIdx;
        this.wallHp[slot] = this.Rules().OverlayStrength(ovIdx);
        this.wallData[slot] = 0;
        this.oreVersion = this.oreVersion + 1;
        this.ReconnectWallAt(x, y);
        this.ReconnectWallAt(x + 1, y);
        this.ReconnectWallAt(x - 1, y);
        this.ReconnectWallAt(x, y + 1);
        this.ReconnectWallAt(x, y - 1);
    }

    bool IsWallCell(int x, int y) {
        return this.wallOv != null && this.InBounds(x, y)
            && this.wallOv[this.CellSlot(x, y)] >= 0;
    }

    bool IsWallOfType(int x, int y, int ov) {
        return this.IsWallCell(x, y)
            && this.wallOv[this.CellSlot(x, y)] == ov;
    }

    /// <summary>The wall overlay type at a cell, -1 when none stands.</summary>
    int WallOvAt(int x, int y) {
        return this.IsWallCell(x, y) ? this.wallOv[this.CellSlot(x, y)]
                                     : 0 - 1;
    }

    /// <summary>The wall's connection mask (N + 2E + 4S + 8W) -- the frame
    /// the renderer draws.</summary>
    int WallDataAt(int x, int y) {
        return this.IsWallCell(x, y) ? this.wallData[this.CellSlot(x, y)] : 0;
    }

    int WallHpAt(int x, int y) {
        return this.IsWallCell(x, y) ? this.wallHp[this.CellSlot(x, y)] : 0;
    }

    /// <summary>Whether the wall has slipped under ConditionYellow: the
    /// reference's Overlay computeFrame then draws the damaged connection
    /// set (frame + 16, or + 1 when the art never shipped a full intact
    /// set).</summary>
    bool WallDamagedAt(int x, int y) {
        if (!this.IsWallCell(x, y)) { return false; }
        int max = this.Rules().OverlayStrength(
            this.wallOv[this.CellSlot(x, y)]);
        if (max <= 0) { return false; }
        return this.wallHp[this.CellSlot(x, y)] * 100
            <= max * this.Rules().ConditionYellowPct();
    }

    /// <summary>Recomputes a wall's connection mask from its same-type
    /// cardinal neighbours -- the reference's connectWall. A piece's mask
    /// counts only walls of its own overlay type, so a concrete wall does
    /// not grow a face toward a fence.</summary>
    void ReconnectWallAt(int x, int y) {
        if (!this.IsWallCell(x, y)) { return; }
        int ov = this.wallOv[this.CellSlot(x, y)];
        int conn = 0;
        if (this.IsWallOfType(x, y - 1, ov)) { conn = conn + 1; }
        if (this.IsWallOfType(x + 1, y, ov)) { conn = conn + 2; }
        if (this.IsWallOfType(x, y + 1, ov)) { conn = conn + 4; }
        if (this.IsWallOfType(x - 1, y, ov)) { conn = conn + 8; }
        this.wallData[this.CellSlot(x, y)] = conn;
    }

    /// <summary>Hits the wall at a cell: the damage soaks into the piece
    /// (already armoured by the caller), and -- the reference's WallTrait
    /// linked damage -- each cardinal wall neighbour of the same type takes
    /// half, one level, no chain. A piece at zero comes down and its
    /// neighbours rebuild their faces around the gap.</summary>
    void DamageWallAt(int x, int y, int dmg) {
        this.DamageWallDepth(x, y, dmg, 0);
    }

    void DamageWallDepth(int x, int y, int dmg, int depth) {
        if (dmg <= 0 || !this.IsWallCell(x, y)) { return; }
        int slot = this.CellSlot(x, y);
        int ov = this.wallOv[slot];
        this.wallHp[slot] = this.wallHp[slot] - dmg;
        if (this.wallHp[slot] <= 0) {
            this.wallOv[slot] = 0 - 1;
            this.wallHp[slot] = 0;
            this.wallData[slot] = 0;
        }
        this.oreVersion = this.oreVersion + 1;
        if (depth <= 0) {
            int half = dmg / 2;
            if (half > 0) {
                if (this.IsWallOfType(x, y - 1, ov)) {
                    this.DamageWallDepth(x, y - 1, half, 1);
                }
                if (this.IsWallOfType(x + 1, y, ov)) {
                    this.DamageWallDepth(x + 1, y, half, 1);
                }
                if (this.IsWallOfType(x, y + 1, ov)) {
                    this.DamageWallDepth(x, y + 1, half, 1);
                }
                if (this.IsWallOfType(x - 1, y, ov)) {
                    this.DamageWallDepth(x - 1, y, half, 1);
                }
            }
        }
        // Faces: the piece (if it still stands) and its neighbours rebuild
        // their connection masks around whatever just changed.
        this.ReconnectWallAt(x, y);
        this.ReconnectWallAt(x, y - 1);
        this.ReconnectWallAt(x + 1, y);
        this.ReconnectWallAt(x, y + 1);
        this.ReconnectWallAt(x - 1, y);
    }

    /// <summary>Live wall pieces on the field -- the selftest's seed
    /// check.</summary>
    int WallCellCount() {
        if (this.wallOv == null) { return 0; }
        int n = 0;
        for (int i = 0; i < this.wallOv.Length; i = i + 1) {
            if (this.wallOv[i] >= 0) { n = n + 1; }
        }
        return n;
    }

    // ---- static overlays ------------------------------------------------

    /// <summary>Parks one static overlay decal (rock, fence, crate, drum,
    /// track) with its data byte -- the art frame.</summary>
    void SetStaticOverlay(int x, int y, int ov, int data) {
        if (ov < 0 || !this.InBounds(x, y)) { return; }
        int slot = this.CellSlot(x, y);
        this.statOv[slot] = ov;
        this.statData[slot] = data;
        this.oreVersion = this.oreVersion + 1;
    }

    int StaticOvAt(int x, int y) {
        if (!this.InBounds(x, y)) { return 0 - 1; }
        return this.statOv[this.CellSlot(x, y)];
    }

    int StaticDataAt(int x, int y) {
        if (!this.InBounds(x, y)) { return 0; }
        return this.statData[this.CellSlot(x, y)];
    }

    int StaticOverlayCount() {
        if (this.statOv == null) { return 0; }
        int n = 0;
        for (int i = 0; i < this.statOv.Length; i = i + 1) {
            if (this.statOv[i] >= 0) { n = n + 1; }
        }
        return n;
    }

    // ---- low bridges (the reference's Bridges + BridgeOverlayTypes) -----

    static bool IsLowBridgeId(int id) {
        return (id >= 74 && id <= 99) || (id >= 205 && id <= 230);
    }

    static bool IsBridgePlaceholderId(int id) {
        return id == 100 || id == 101 || id == 231 || id == 232;
    }

    static bool IsHighBridgeId(int id) {
        return id == 24 || id == 25 || id == 237 || id == 238;
    }

    /// <summary>X-bridges chain along map-Y (their art runs the other
    /// diagonal) -- the reference's isXBridge id classes.</summary>
    static bool IsXBridgeId(int id) {
        if (id == 74 || id == 205) { return true; }
        if (id >= 74 && id <= 82) { return true; }
        if (id >= 92 && id <= 95) { return true; }
        if (id >= 205 && id <= 213) { return true; }
        if (id >= 223 && id <= 226) { return true; }
        return false;
    }

    static bool IsLowBridgeHeadId(int id) {
        return (id >= 92 && id <= 99) || (id >= 223 && id <= 230);
    }

    static bool IsLowBridgeHeadStartId(int id) {
        return (id >= 94 && id <= 97) || (id >= 225 && id <= 228);
    }

    /// <summary>Stands one low-bridge piece at an anchor cell: the piece
    /// covers its anchor and two cells along its axis, the anchor carries
    /// the piece flags, and hit points are the rules' BridgeStrength.
    /// Used by the map seed and the selftest probe alike; ids rewrite in
    /// ReconnectBridgeAll once the run's neighbours are known.</summary>
    void SetBridgePiece(int x, int y, bool axisY, int head) {
        if (!this.InBounds(x, y)) { return; }
        int id = 74;             // placeholder id; the reconnect rewrites it
        int slot = this.CellSlot(x, y);
        // One overlay object per piece, on the anchor cell exactly like the
        // map ships it: the id, the hit points and the piece flags all live
        // here. The art (and the Road land class) spans three cells, but
        // that is render/projection state -- the grid keeps the anchor.
        this.brOv[slot] = id;
        this.brHp[slot] = this.Rules().BridgeStrength();
        this.brData[slot] = (head & 3) | (axisY ? 4 : 0) | 8;
        this.brAnchors.Add(slot);
        this.oreVersion = this.oreVersion + 1;
    }

    bool IsBridgeAnchor(int x, int y) {
        if (!this.InBounds(x, y)) { return false; }
        int slot = this.CellSlot(x, y);
        return this.brOv[slot] >= 0 && (this.brData[slot] & 8) != 0;
    }

    /// <summary>The piece flags at a covered cell's piece: walks back along
    /// the axis to the anchor. 0 when no piece covers the cell.</summary>
    int BridgeFlagsAt(int x, int y) {
        if (!this.InBounds(x, y)) { return 0; }
        int slot = this.CellSlot(x, y);
        if (this.brOv[slot] >= 0) { return this.brData[slot]; }
        // A covered cell of a piece's three-cell span (not an anchor)
        // walks back up the diagonal to its anchor: the art covers the
        // two cells behind the anchor too, so a land query anywhere on
        // the span answers. The diagonal test keeps a piece of the other
        // axis from claiming the cell.
        for (int k = 1; k <= 2; k = k + 1) {
            int cx = x - k;
            int cy = y - k;
            if (!this.InBounds(cx, cy)) { break; }
            int cs = this.CellSlot(cx, cy);
            if (this.brOv[cs] >= 0 && (this.brData[cs] & 8) != 0) {
                return this.brData[cs];
            }
        }
        return 0;
    }

    int BridgePieceCount() { return this.brAnchors.Count; }

    /// <summary>The bridge piece's overlay id at anchor index i (the
    /// renderer's and the probe's read).</summary>
    int BridgeIdAt(int i) {
        if (i < 0 || i >= this.brAnchors.Count) { return 0 - 1; }
        return this.brOv[this.brAnchors[i]];
    }

    int BridgeSlotAt(int i) {
        if (i < 0 || i >= this.brAnchors.Count) { return 0 - 1; }
        return this.brAnchors[i];
    }

    /// <summary>Removes one piece: its anchor cell clears, its neighbours
    /// re-read the run.</summary>
    void ClearBridgePiece(int slot) {
        this.brOv[slot] = 0 - 1;
        this.brHp[slot] = 0;
        this.brData[slot] = 0;
        for (int i = this.brAnchors.Count - 1; i >= 0; i = i - 1) {
            if (this.brAnchors[i] == slot) { this.brAnchors.RemoveAt(i); }
        }
    }

    /// <summary>Drops a unit standing on a collapsed bridge cell: the
    /// reference's BridgeTrait onDestroy drowns (destroys) everyone whose
    /// footing goes out from under them.</summary>
    void SinkUnitAt(int x, int y) {
        if (!this.InBounds(x, y)) { return; }
        int occ = this.occupancy[this.CellSlot(x, y)];
        if (occ <= 0) { return; }
        WorldObject o = this.objects[occ - 1];
        if (o.Kind() != ObjKind.Unit() || o.IsDead()) { return; }
        o.TakeDamageAs(o.Hp(), 0);
    }

    /// <summary>Records one map low-bridge cell for the seed pass: every
    /// non-placeholder piece reports (cell, value, id), the value==1 cells
    /// become the live pieces.</summary>
    void SeedBridgeCell(int x, int y, int id, int value) {
        this.segSlot.Add(this.CellSlot(x, y));
        this.segVal.Add(value);
        this.segId.Add(id);
    }

    /// <summary>The seed pass's second half, the reference's bridge
    /// assembly: each value==1 cell becomes a piece one cell back (where
    /// its neighbour segment reads 0 ahead or 2 behind), then every piece
    /// rewrites its id from the chain. High bridges are deferred until an
    /// elevation layer exists.</summary>
    void FinishBridges() {
        for (int i = 0; i < this.segSlot.Count; i = i + 1) {
            if (this.segVal[i] != 1) { continue; }
            int slot = this.segSlot[i];
            int id = this.segId[i];
            int x = slot % this.width;
            int y = slot / this.width;
            bool axisY = World.IsXBridgeId(id);
            int px = axisY ? x : x - 1;
            int py = axisY ? y - 1 : y;
            int nx = axisY ? x : x + 1;
            int ny = axisY ? y + 1 : y;
            int pv = this.SegmentValueAt(px, py);
            int nv = this.SegmentValueAt(nx, ny);
            if (pv == 0 || nv == 2) {
                int head = World.IsLowBridgeHeadStartId(id) ? 1
                    : World.IsLowBridgeHeadId(id) ? 2 : 0;
                this.SetBridgePiece(px, py, axisY, head);
            }
        }
        this.segSlot.Clear();
        this.segVal.Clear();
        this.segId.Clear();
        this.ReconnectBridgeAll();
    }

    int SegmentValueAt(int x, int y) {
        if (!this.InBounds(x, y)) { return 0 - 1; }
        int slot = this.CellSlot(x, y);
        for (int i = 0; i < this.segSlot.Count; i = i + 1) {
            if (this.segSlot[i] == slot) { return this.segVal[i]; }
        }
        return 0 - 1;
    }

    /// <summary>The reference's Bridges.updateOverlayData for every piece:
    /// each piece's overlay id rewrites from its own and its neighbours'
    /// wounds -- the damaged set (4/5/6) and the dangling-head ids -- so
    /// the drawn frame always tells the run's true state.</summary>
    void ReconnectBridgeAll() {
        for (int i = 0; i < this.brAnchors.Count; i = i + 1) {
            this.ReconnectBridgeAt(this.brAnchors[i]);
        }
    }

    void ReconnectBridgeAt(int slot) {
        if (slot < 0 || slot >= this.brOv.Length) { return; }
        if (this.brOv[slot] < 0 || (this.brData[slot] & 8) == 0) { return; }
        int x = slot % this.width;
        int y = slot / this.width;
        int flags = this.brData[slot];
        bool axisY = (flags & 4) != 0;
        int head = flags & 3;
        bool concrete = this.brOv[slot] >= 205;
        int min = concrete ? 205 : 74;
        int maxHp = this.Rules().BridgeStrength();
        bool damaged = this.brHp[slot] * 2 <= maxHp;
        // Neighbour pieces sit one cell along the axis, heads excluded
        // from the "middle" counting the way the reference reads them.
        int preSlot = this.CellSlot(axisY ? x : x - 1, axisY ? y - 1 : y);
        int nxtSlot = this.CellSlot(axisY ? x : x + 1, axisY ? y + 1 : y);
        bool hasPrev = this.brOv[preSlot] >= 0 && preSlot != slot;
        bool hasNext = this.brOv[nxtSlot] >= 0 && nxtSlot != slot;
        bool prevDamaged = hasPrev && this.brHp[preSlot] * 2 <= maxHp;
        bool nextDamaged = hasNext && this.brHp[nxtSlot] * 2 <= maxHp;
        int value;
        if (head == 1) {
            if (hasNext) {
                value = damaged ? 6 : nextDamaged ? 5 : 20;
            } else {
                value = 21;
            }
        } else if (head == 2) {
            if (hasPrev) {
                value = damaged ? 6 : prevDamaged ? 4 : 18;
            } else {
                value = 19;
            }
        } else {
            // The reference swaps prev/next for non-X bridges so the
            // art's own front/back reads the run in one direction.
            bool aPrev = axisY ? hasPrev : hasNext;
            bool aNext = axisY ? hasNext : hasPrev;
            bool aPrevDamaged = axisY ? prevDamaged : nextDamaged;
            bool aNextDamaged = axisY ? nextDamaged : prevDamaged;
            if (aPrev && aNext) {
                value = damaged || (aPrevDamaged && aNextDamaged) ? 6
                    : aPrevDamaged ? 4 : aNextDamaged ? 5 : 0;
            } else if (aPrev) {
                value = 8;
            } else if (aNext) {
                value = 7;
            } else {
                value = 0;
            }
            if (!axisY) { value = value + 9; }
        }
        this.brOv[slot] = min + value;
    }

    /// <summary>Hits the bridge piece covering a cell. A piece at zero
    /// collapses and the domino takes its fragment: the reference's
    /// findDominoPieces -- walk both ways from the break; a side that
    /// never meets a head piece comes down with it, a run with intact
    /// ends on both sides loses only the broken piece. Units standing on
    /// the fallen cells go with it.</summary>
    void DamageBridgeAt(int x, int y, int dmg) {
        if (dmg <= 0) { return; }
        int flags = this.BridgeFlagsAt(x, y);
        if (flags == 0) { return; }
        bool axisY = (flags & 4) != 0;
        int ax = x;
        int ay = y;
        for (int k = 0; k <= 2; k = k + 1) {
            int cx = x - k;
            int cy = y - k;
            if (this.IsBridgeAnchor(cx, cy)) { ax = cx; ay = cy; break; }
        }
        int slot = this.CellSlot(ax, ay);
        this.brHp[slot] = this.brHp[slot] - dmg;
        if (this.brHp[slot] > 0) {
            this.oreVersion = this.oreVersion + 1;
            this.ReconnectBridgeAt(slot);
            this.ReconnectBridgeAt(this.CellSlot(axisY ? ax : ax - 1,
                                                 axisY ? ay - 1 : ay));
            this.ReconnectBridgeAt(this.CellSlot(axisY ? ax : ax + 1,
                                                 axisY ? ay + 1 : ay));
            return;
        }
        // The domino: the broken piece itself always comes down; each
        // side that walks outward without ever meeting a head piece is
        // headless and falls with it (the reference's findDominoPieces
        // returns empty only when both ends are intact -- and then only
        // the broken piece dies).
        List<int> doomed = new List<int>();
        doomed.Add(slot);
        bool forwardEnd = false;
        int cx2 = ax;
        int cy2 = ay;
        for (int step = 0; step < 4096; step = step + 1) {
            cx2 = axisY ? cx2 : cx2 + 1;
            cy2 = axisY ? cy2 + 1 : cy2;
            if (!this.IsBridgeAnchor(cx2, cy2)) { break; }
            if ((this.BridgeFlagsAt(cx2, cy2) & 3) != 0) {
                forwardEnd = true;
                break;
            }
            doomed.Add(this.CellSlot(cx2, cy2));
        }
        bool backwardEnd = false;
        cx2 = ax;
        cy2 = ay;
        for (int step = 0; step < 4096; step = step + 1) {
            cx2 = axisY ? cx2 : cx2 - 1;
            cy2 = axisY ? cy2 - 1 : cy2;
            if (!this.IsBridgeAnchor(cx2, cy2)) { break; }
            if ((this.BridgeFlagsAt(cx2, cy2) & 3) != 0) {
                backwardEnd = true;
                break;
            }
            doomed.Add(this.CellSlot(cx2, cy2));
        }
        for (int i = 0; i < doomed.Count; i = i + 1) {
            int ds = doomed[i];
            int dxp = ds % this.width;
            int dyp = ds / this.width;
            bool dAxisY = (this.brData[ds] & 4) != 0;
            for (int k = 0; k < 3; k = k + 1) {
                int cx = dAxisY ? dxp : dxp + k;
                int cy = dAxisY ? dyp + k : dyp;
                if (!this.InBounds(cx, cy)) { break; }
                this.SinkUnitAt(cx, cy);
            }
            this.ClearBridgePiece(ds);
        }
        this.oreVersion = this.oreVersion + 1;
        this.ReconnectBridgeAll();
    }

    /// <summary>Breadth-first path searches since the world was created --
    /// the selftest's perf line reports it so the search volume of a battle
    /// stays visible.</summary>
    int PathCalls() { return this.pathCalls; }

    /// <summary>How much ore sits at a cell, 0 when none.</summary>
    int OreAt(int x, int y) {
        if (!this.InBounds(x, y)) { return 0; }
        return this.oreAmt[this.CellSlot(x, y)];
    }

    int OreValueAt(int x, int y) {
        if (!this.InBounds(x, y)) { return 0; }
        return this.oreVal[this.CellSlot(x, y)];
    }

    /// <summary>The ore cell's overlay type id (GEM01.. / TIB01..), -1 when
    /// none or unknown. The renderer draws the id's own art the way the
    /// original draws each overlay object by its type.</summary>
    int OreOvAt(int x, int y) {
        if (!this.InBounds(x, y)) { return 0 - 1; }
        return this.oreOv[this.CellSlot(x, y)];
    }

    /// <summary>A mining pass: takes up to take units from the cell and
    /// returns how many were actually taken.</summary>
    int TakeOre(int x, int y, int take) {
        if (!this.InBounds(x, y)) { return 0; }
        int slot = this.CellSlot(x, y);
        int amt = this.oreAmt[slot];
        if (amt <= 0) { return 0; }
        if (take > amt) { take = amt; }
        this.oreAmt[slot] = amt - take;
        if (this.oreAmt[slot] <= 0) {
            this.oreAmt[slot] = 0;
            this.oreVal[slot] = 0;
            this.oreLeft = this.oreLeft - 1;
        }
        return take;
    }

    // ---- tiberium growth (the reference's TiberiumTreeTrait) -----------

    /// <summary>Registers a terrain object cell. Scenery blocks ore spawn
    /// and registers growth when the type declares SpawnsTiberium=yes.</summary>
    void SetMapTerrain(int x, int y) {
        if (!this.InBounds(x, y)) { return; }
        this.hasTerrain[this.CellSlot(x, y)] = 1;
    }

    bool HasMapTerrain(int x, int y) {
        return this.InBounds(x, y)
            && this.hasTerrain[this.CellSlot(x, y)] != 0;
    }

    /// <summary>Registers one tiberium tree with its spawn cooldown in
    /// ticks (the rules' floor(1/AnimationProbability)); the slot keeps
    /// the initial period in tibTreeCd until the first fire re-arms it.</summary>
    void AddTibTree(int x, int y, int cdTicks) {
        if (!this.InBounds(x, y) || cdTicks <= 0) { return; }
        this.tibTreeX.Add(x);
        this.tibTreeY.Add(y);
        this.tibTreeCd.Add(cdTicks);
        this.tibTreeCd0.Add(cdTicks);
    }

    int TibTreeCount() { return this.tibTreeX.Count; }

    /// <summary>The deterministic overlay-variant offset the reference's
    /// OreSpread.calculateOverlayId derives from the cell: a float hash of
    /// the coordinates folded to 0..11, added to the type's first overlay
    /// id. Same cell, same variant, every game.</summary>
    static int OreSpreadIndex(int x, int y) {
        double t = (((y - 9) / 2.0) % 12) * (((y - 8) / 2.0) % 12) % 12;
        double u = (((x - 13) / 2.0) % 12) * (((x - 12) / 2.0) % 12) % 12;
        double v = Math.Floor(t - u + 120000.0);
        int n = (int)v;
        n = n - n / 12 * 12;
        if (n < 0) { n = n + 12; }
        return n;
    }

    /// <summary>The reference's TiberiumTrait.canBePlacedOn: bare ground
    /// (Clear, Road or Rough), no scenery, no structure, no wall, no ore.
    /// Units do not block -- the original splices new ore under standing
    /// vehicles.</summary>
    bool TibCanPlace(int x, int y) {
        if (!this.InBounds(x, y)) { return false; }
        if (this.HasMapTerrain(x, y)) { return false; }
        if (this.occupancy[this.CellSlot(x, y)] != 0) { return false; }
        if (this.IsWallCell(x, y)) { return false; }
        if (this.brOv[this.CellSlot(x, y)] >= 0) { return false; }
        if (this.statOv[this.CellSlot(x, y)] >= 0) { return false; }
        if (this.OreAt(x, y) > 0) { return false; }
        IsoTile t = this.iso.At(x, y);
        if (t == null) { return false; }
        LandType lt = this.CellLand(t);
        if (lt == null) { return false; }
        int v = lt.Value();
        return v == LandType.Clear() || v == LandType.Road()
            || v == LandType.Rough();
    }

    /// <summary>One tree's spawn roll, the reference's TiberiumTreeTrait
    /// tick: rings at radius 1 then 2 in the RadialTileFinder's walk order;
    /// the first placeable cell takes a new Riparius pile (value byte 3),
    /// otherwise the first pile that can still richen takes one bail.
    /// TiberiumGrows gates the whole pass, as shipped.</summary>
    void TibTreeSpawn(int tx, int ty) {
        for (int r = 1; r <= 2; r = r + 1) {
            int left = tx - r;
            int right = tx + r;
            int top = ty - r;
            int bottom = ty + r;
            // The RadialTileFinder's ring order: bottom row right-to-left,
            // right column up, top row left-to-right, left column down.
            for (int xx = right; xx >= left; xx = xx - 1) {
                if (this.TibTrySpawn(xx, bottom)) { return; }
            }
            for (int yy = bottom - 1; yy >= top; yy = yy - 1) {
                if (this.TibTrySpawn(right, yy)) { return; }
            }
            for (int xx = left; xx <= right - 1; xx = xx + 1) {
                if (this.TibTrySpawn(xx, top)) { return; }
            }
            for (int yy = top + 1; yy <= bottom - 1; yy = yy + 1) {
                if (this.TibTrySpawn(left, yy)) { return; }
            }
            // No bare cell this ring: the first existing pile whose bail
            // count can still grow (bailCount + 1 <= maxBails) gains one.
            for (int xx = right; xx >= left; xx = xx - 1) {
                if (this.TibTryBail(xx, bottom)) { return; }
            }
            for (int yy = bottom - 1; yy >= top; yy = yy - 1) {
                if (this.TibTryBail(right, yy)) { return; }
            }
            for (int xx = left; xx <= right - 1; xx = xx + 1) {
                if (this.TibTryBail(xx, top)) { return; }
            }
            for (int yy = top + 1; yy <= bottom - 1; yy = yy + 1) {
                if (this.TibTryBail(left, yy)) { return; }
            }
        }
    }

    bool TibTrySpawn(int x, int y) {
        if (!this.TibCanPlace(x, y)) { return false; }
        this.SetOre(x, y, 3, 1, 102 + World.OreSpreadIndex(x, y));
        return true;
    }

    bool TibTryBail(int x, int y) {
        if (!this.InBounds(x, y)) { return false; }
        int slot = this.CellSlot(x, y);
        int amt = this.oreAmt[slot];
        // bailCount = value + 1, maxBails 11: a bail still fits while
        // value <= 9 -- the reference's bailCount + 1 <= maxBails.
        if (amt < 1 || amt > 9) { return false; }
        this.oreAmt[slot] = amt + 1;
        this.oreVersion = this.oreVersion + 1;
        return true;
    }

    /// <summary>Per-tree cooldown rolls, run every tick -- the trees'
    /// AnimationProbability cadence, not the unused GrowthRate. Trees may
    /// carry different periods, so the fire re-arms from the period the
    /// tree was registered with (tibTreePeriod holds the last one handed
    /// to AddTibTree, which registration order makes each tree's own).</summary>
    void TickTiberiumGrowth() {
        for (int i = 0; i < this.tibTreeX.Count; i = i + 1) {
            int cd = this.tibTreeCd[i] - 1;
            if (cd > 0) { this.tibTreeCd[i] = cd; continue; }
            this.TibTreeSpawn(this.tibTreeX[i], this.tibTreeY[i]);
            this.tibTreeCd[i] = this.tibTreeCd0[i];
        }
    }

    /// <summary>How many credits a full ore hold is worth -- the shipped
    /// harvester payload the original unloads at the refinery.</summary>
    static int OreCapacity() { return 700; }

    /// <summary>The miner's hold in bails against its type's Storage=:
    /// the shipped [CMIN]/[SMIN] 20 and [HARV] 40. A unit with no type
    /// falls back to the old full-hold constant.</summary>
    int StorageOf(WorldObject o) {
        UnitType t = o.UnitType();
        return t != null && t.Storage() > 0 ? t.Storage()
                                            : World.OreCapacity();
    }

    /// <summary>One harvester's mine-and-unload loop, run every tick. With
    /// room in the hold it mines the cell underfoot and, when that runs
    /// dry, seeks the nearest ore; with a full hold it docks at the nearest
    /// own refinery and pours the cargo into the side's funds. The original
    /// drives the harvester INTO the refinery while it unloads and lets the
    /// chrono miner teleport home; this engine docks on the adjacent ring
    /// and drives everything, documented as a substitution.</summary>
    void TickHarvester(WorldObject o) {
        if (o.Frozen() > 0) { return; }
        // A failed route search idles the harvester for a while; mining and
        // unloading stay gated on the dock countdown.
        if (o.RouteCooldown() > 0) { o.SetRouteCooldown(o.RouteCooldown() - 1); }
        // A countdown paces mining passes and unloading.
        if (o.DockTimer() > 0) {
            o.SetDockTimer(o.DockTimer() - 1);
            if (o.DockTimer() == 0 && o.Bails() >= this.StorageOf(o)) {
                this.AddMoneyEvent(o.Side(), o.Cargo());
                o.SetCargo(0);
                o.SetBails(0);
            }
            return;
        }
        if (o.Bails() >= this.StorageOf(o)) {
            if (this.AtRefineryDock(o)) {
                o.SetDockTimer(360);
                return;
            }
            // A failed refinery search (none owned, or none pathable) parks
            // the harvester on a cooldown, exactly like the ore search: the
            // fallback is a whole-map BFS, not something to repeat per tick.
            if (!o.HasRoute() && !o.RouteRetry()) {
                if (this.RouteToRefinery(o)) { return; }
                o.SetRouteCooldown(45);
            }
            return;
        }
        // Room in the hold: mine underfoot, or go find ore.
        if (!o.HasRoute()) {
            int amt = this.OreAt(o.X(), o.Y());
            if (amt > 0) {
                // One bail per pass, the reference's GatherOreTask cadence
                // (a 1/60-minute wait between bails): a gold bail pays the
                // shipped Value=25, a crystal bail the doubled 50 -- our
                // OreValue 1 and 2 times 25.
                int val = this.OreValueAt(o.X(), o.Y());
                int taken = this.TakeOre(o.X(), o.Y(), 1);
                if (taken > 0) {
                    o.SetCargo(o.Cargo() + val * 25);
                    o.SetBails(o.Bails() + 1);
                }
                o.SetDockTimer(36);
                return;
            }
            if (!this.RouteToOre(o)) { o.SetDockTimer(45); }
        }
    }

    /// <summary>The nearest ore cell to (cx, cy), scanned ring by ring out
    /// to 40 cells; fills slots 0 and 1 of outXy and returns true when one
    /// exists. The renderer and the selftest use this to aim at a field;
    /// the harvester's own search is RouteToOre, which also demands a path.
    /// </summary>
    bool FindOre(int cx, int cy, List<int> outXy) {
        int span = this.width > this.height ? this.width : this.height;
        for (int r = 0; r <= span; r = r + 1) {
            for (int dy = -r; dy <= r; dy = dy + 1) {
                for (int dx = -r; dx <= r; dx = dx + 1) {
                    int adx = dx < 0 ? -dx : dx;
                    int ady = dy < 0 ? -dy : dy;
                    if (adx != r && ady != r) { continue; }
                    int x = cx + dx;
                    int y = cy + dy;
                    if (this.OreAt(x, y) > 0) {
                        World.SetSlot2(outXy, x, y);
                        return true;
                    }
                }
            }
        }
        return false;
    }

    static void SetSlot2(List<int> list, int a, int b) {
        while (list.Count < 2) { list.Add(0); }
        list[0] = a;
        list[1] = b;
    }

    /// <summary>Routes a unit to the nearest ore cell within 30 cells of
    /// its position, expanding rings outwards. Returns false when the scan
    /// finds nothing reachable.</summary>
    bool RouteToOre(WorldObject o) {
        List<int> px = new List<int>();
        List<int> py = new List<int>();
        for (int r = 0; r <= 30; r = r + 1) {
            for (int dy = -r; dy <= r; dy = dy + 1) {
                for (int dx = -r; dx <= r; dx = dx + 1) {
                    // Only this radius's ring: inner rings were scanned.
                    int adx = dx < 0 ? -dx : dx;
                    int ady = dy < 0 ? -dy : dy;
                    if (adx != r && ady != r) { continue; }
                    int x = o.X() + dx;
                    int y = o.Y() + dy;
                    if (this.OreAt(x, y) <= 0) { continue; }
                    if (!this.PassableForRoute(x, y, o.Amphibious())) {
                        continue;
                    }
                    if (this.FindPath(o.X(), o.Y(), x, y, px, py,
                                      o.Amphibious())) {
                        o.SetRoute(px, py);
                        o.ClearMoveAttack();
                        return true;
                    }
                }
            }
        }
        return false;
    }

    /// <summary>Routes a loaded harvester to a free cell beside the nearest
    /// finished refinery it owns. Returns false -- leaving the harvester to
    /// retry on a later tick -- when it owns none or none is reachable.</summary>
    bool RouteToRefinery(WorldObject o) {
        WorldObject best = null;
        int bestDist = 0;
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject r = this.objects[i];
            if (r.Kind() != ObjKind.Structure() || r.Side() != o.Side()) {
                continue;
            }
            if (r.IsDead()) { continue; }
            StructureType t = this.TypeOf(r);
            if (t == null || !t.IsRefinery()) { continue; }
            if (r.BuiltTicks() < t.BuildTime()) { continue; }
            int dist = (r.X() - o.X()) * (r.X() - o.X())
                     + (r.Y() - o.Y()) * (r.Y() - o.Y());
            if (best == null || dist < bestDist) {
                best = r;
                bestDist = dist;
            }
        }
        if (best == null) { return false; }
        List<int> cell = new List<int>();
        this.FindSpawnCell(best, cell);
        if (cell.Count < 2) { return false; }
        List<int> px = new List<int>();
        List<int> py = new List<int>();
        if (!this.FindPath(o.X(), o.Y(), cell[0], cell[1], px, py,
                           o.Amphibious())) {
            return false;
        }
        o.SetRoute(px, py);
        o.ClearMoveAttack();
        return true;
    }

    /// <summary>Whether the harvester stands on the docking ring of a
    /// finished own refinery.</summary>
    bool AtRefineryDock(WorldObject o) {
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject r = this.objects[i];
            if (r.Kind() != ObjKind.Structure() || r.Side() != o.Side()) {
                continue;
            }
            if (r.IsDead()) { continue; }
            StructureType t = this.TypeOf(r);
            if (t == null || !t.IsRefinery()) { continue; }
            if (r.BuiltTicks() < t.BuildTime()) { continue; }
            if (o.X() >= r.X() - 1 && o.X() <= r.X() + t.FootprintW()
             && o.Y() >= r.Y() - 1 && o.Y() <= r.Y() + t.FootprintH()) {
                return true;
            }
        }
        return false;
    }

    // ---- tech tree ----------------------------------------------------------

    /// <summary>True when a side owns, built and alive, at least one building
    /// from every prereq slot. This is the sidebar's gate: a unit or building
    /// only becomes purchasable once its tech stands.</summary>
    bool SatisfiesPrereqs(int side, List<List<int>> prereqs) {
        for (int i = 0; i < prereqs.Count; i = i + 1) {
            List<int> slot = prereqs[i];
            bool any = false;
            for (int j = 0; j < slot.Count; j = j + 1) {
                if (this.SideHasBuiltStructure(side, slot[j])) { any = true; break; }
            }
            if (!any) { return false; }
        }
        return true;
    }

    bool SideHasBuiltStructure(int side, int buildId) {
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Side() != side || o.Kind() != ObjKind.Structure()
             || o.IsDead() || o.BuildId() != buildId || o.IsCiv()) { continue; }
            StructureType t = this.catalog.TypeFor(this, side, buildId);
            if (t != null && o.BuiltTicks() >= t.BuildTime()) { return true; }
        }
        return false;
    }

    // ---- occupancy -----------------------------------------------------

    int CellSlot(int x, int y) {
        if (x < 0 || y < 0 || x >= this.width || y >= this.height) { return -1; }
        return y * this.width + x;
    }

    bool InBounds(int x, int y) { return this.CellSlot(x, y) >= 0; }

    /// <summary>True when a structure's footprint fits and its anchor cells
    /// are all free AND solid ground. The footprint is anchored at its
    /// top-left; a placement that runs off the map edge is rejected outright.
    /// The surface is the structure's own: a WaterBound structure (the
    /// shipyard, the only one in the shipped rules) must sit entirely on
    /// water, and everything else entirely on ground -- so a yard can never
    /// unfold with half its footprint floating on the sea, and only the
    /// shipyard can stand in it.</summary>
    bool CanPlace(StructureType t, int x, int y) {
        bool water = t.WaterBound();
        for (int dy = 0; dy < t.FootprintH(); dy = dy + 1) {
            for (int dx = 0; dx < t.FootprintW(); dx = dx + 1) {
                if (!this.InBounds(x + dx, y + dy)) { return false; }
                if (this.occupancy[this.CellSlot(x + dx, y + dy)] != 0
                 || this.IsWallCell(x + dx, y + dy)) {
                    return false;
                }
                IsoTile c = this.iso.At(x + dx, y + dy);
                if (water) {
                    if (!this.IsWater(c)) { return false; }
                } else if (!this.IsGround(c) || this.IsWater(c)) {
                    return false;
                }
            }
        }
        return true;
    }

    /// <summary>Public wrapper for the ghost preview: can the armed structure
    /// be placed with its anchor at (x,y)?</summary>
    bool CanPlaceBuilding(int side, int buildId, int x, int y) {
        StructureType t = this.catalog.TypeFor(this, side, buildId);
        if (t == null) { return false; }
        return this.CanPlace(t, x, y);
    }

    /// <summary>Places a structure, occupying its footprint. Returns the new
    /// object's index, or -1 when the footprint does not fit.</summary>
    int PlaceStructure(int side, int buildId, int x, int y) {
        StructureType t = this.catalog.TypeFor(this, side, buildId);
        if (t == null) { return -1; }
        if (!this.CanPlace(t, x, y)) { return -1; }
        WorldObject o = WorldObject.CreateStructure(side, buildId, x, y, t.Hp());
        int idx = this.AddObject(o);
        this.ShroudRevealObject(o);
        // The placement thud, handleBuildingPlaceSound: the rules
        // SlamSound= or the BuildingSlam key, played through the fog.
        string slam = t.SlamSound();
        if (slam == null || slam.Length == 0) { slam = "BuildingSlam"; }
        this.SndEffect(slam, o);
        return idx;
    }

    /// <summary>Runs a unit's Deploy on the object at idx. Two semantics live
    /// under that one key in the rules, both taken from the reference engine:
    ///
    ///  - DeploysInto (the MCVs): the unit unfolds into that structure on the
    ///    spot. The anchor is probed around the unit's cell so its cell ends
    ///    up inside the new footprint; with no room anywhere the deploy is
    ///    refused, the reference's CannotDeploy.
    ///  - Deployer (the GI): the stance toggle. He sits down where he stands
    ///    and roots there, or stands back up.
    ///
    /// Returns the object's index on success, -1 when refused.</summary>
    int DeployObject(int idx) {
        if (idx < 0 || idx >= this.objects.Count) { return -1; }
        WorldObject o = this.objects[idx];
        if (o == null || o.IsDead() || o.Kind() != ObjKind.Unit()) { return -1; }
        UnitType ut = o.UnitType();
        if (ut == null) { return -1; }
        string target = ut.DeploysInto();
        if (target != null && target.Length > 0) {
            int buildId = this.catalog.IdOfReg(this, o.Side(), target);
            if (buildId < 0) { return -1; }
            StructureType t = this.catalog.TypeFor(this, o.Side(), buildId);
            if (t == null) { return -1; }
            // Vacate the unit's own cell first: the replacement covers it.
            int oldSlot = this.CellSlot(o.X(), o.Y());
            int was = this.occupancy[oldSlot];
            this.occupancy[oldSlot] = 0;
            List<int> at = new List<int>();
            if (!this.FitDeployAnchor(t, o.X(), o.Y(), at)) {
                this.occupancy[oldSlot] = was;      // put the unit back
                return -1;
            }
            int ax = at[0];
            int ay = at[1];
            int maxHp = t.Hp();
            int hp = maxHp;
            if (o.MaxHp() > 0 && o.Hp() > 0) {
                hp = maxHp * o.Hp() / o.MaxHp();
                if (hp < 1) { hp = 1; }
            }
            o.MorphIntoStructure(buildId, hp, maxHp, t.BuildTime());
            o.SetCell(ax, ay);
            // The building takes the index the unit already had, so no other
            // object's index moves: only its footprint cells need stamping.
            for (int dy = 0; dy < t.FootprintH(); dy = dy + 1) {
                for (int dx = 0; dx < t.FootprintW(); dx = dx + 1) {
                    this.occupancy[this.CellSlot(ax + dx, ay + dy)] = idx + 1;
                }
            }
            this.ShroudRevealObject(o);
            // The MCV's unfold, the UnitDeployUndeploy event's deploy leg:
            // the rules DeploySound=, skipped when unset.
            this.SndEffect(ut.DeploySound(), o);
            return idx;
        }
        if (ut.Deployer()) {
            if (!o.Deployed()) {
                o.StopAttack();
                o.StartDeployPose();
                this.SndEffect(ut.DeploySound(), o);
            } else {
                o.SetDeployed(false);
                o.StopAttack();
                o.StartUndeployPose();
                this.SndEffect(ut.UndeploySound(), o);
            }
            return idx;
        }
        return -1;
    }

    /// <summary>The anchor a unit at (x,y) unfolds into for structure type t:
    /// the placements whose footprint covers the unit's own cell, tried from
    /// the most centred outwards. Fills outXy with the anchor and returns
    /// true, or leaves it empty when no candidate fits.</summary>
    bool FitDeployAnchor(StructureType t, int x, int y, List<int> outXy) {
        int fw = t.FootprintW();
        int fh = t.FootprintH();
        List<int> offs = new List<int>();
        offs.Add(0 - (fw / 2));
        if (0 - (fw - 1) != 0 - (fw / 2)) { offs.Add(0 - (fw - 1)); }
        if (offs[0] != 0 && offs[offs.Count - 1] != 0) { offs.Add(0); }
        List<int> offsy = new List<int>();
        offsy.Add(0 - (fh / 2));
        if (0 - (fh - 1) != 0 - (fh / 2)) { offsy.Add(0 - (fh - 1)); }
        if (offsy[0] != 0 && offsy[offsy.Count - 1] != 0) { offsy.Add(0); }
        for (int i = 0; i < offs.Count; i = i + 1) {
            for (int j = 0; j < offsy.Count; j = j + 1) {
                int ax = x + offs[i];
                int ay = y + offsy[j];
                if (ax + fw <= x || ax > x) { continue; }   // cell not covered
                if (ay + fh <= y || ay > y) { continue; }
                if (this.CanPlace(t, ax, ay)) {
                    outXy.Add(ax);
                    outXy.Add(ay);
                    return true;
                }
            }
        }
        return false;
    }

    /// <summary>Sells the structure at a cell: frees its footprint and every
    /// index bookkeeping RemoveDead does (selection, attackers, the grid),
    /// then queues the owner half the price back through the money events.
    /// Returns the refund, or -1 when the cell holds nothing sellable -- no
    /// structure, someone else's, still under construction, or a map
    /// civilian (the original will not buy those back either).</summary>
    int SellStructureAt(int side, int x, int y) {
        List<int> hit = new List<int>();
        this.ObjectsAt(x, y, hit);
        if (hit.Count == 0) { return -1; }
        WorldObject o = this.objects[hit[0]];
        if (o.Side() != side || o.Kind() != ObjKind.Structure()
         || o.IsDead() || o.IsCiv()) { return -1; }
        StructureType t = this.TypeOf(o);
        if (t == null) { return -1; }
        if (o.UnderConstruction(t.BuildTime())) { return -1; }
        int refund = t.Cost() * this.Rules().RefundPercent() / 100;
        this.AddMoneyEvent(side, refund);
        // The sell chime, the no-shroud SellSound key: the owner hears it
        // even under black ground.
        this.SndEffect("SellSound", o);
        this.Demolish(o);
        return refund;
    }

    /// <summary>Removes one structure from the field without a death
    /// explosion -- the sell path. The same bookkeeping RemoveDead does for
    /// a corpse: footprint freed, selection and attackers re-pointed, the
    /// grid's index+1 entries rewritten for the shrink.</summary>
    void Demolish(WorldObject o) {
        int i = this.IndexOfObject(o);
        if (i < 0) { return; }
        this.ClearLampLights(o);
        StructureType t = this.TypeOf(o);
        for (int dy = 0; dy < t.FootprintH(); dy = dy + 1) {
            for (int dx = 0; dx < t.FootprintW(); dx = dx + 1) {
                this.occupancy[this.CellSlot(o.X() + dx, o.Y() + dy)] = 0;
            }
        }
        if (this.selectedIndex == i) {
            this.selectedIndex = -1;
        } else if (this.selectedIndex > i) {
            this.selectedIndex = this.selectedIndex - 1;
        }
        int si = 0;
        while (si < this.selection.Count) {
            int sel = this.selection[si];
            if (sel == i) {
                this.selection.RemoveAt(si);
                continue;
            }
            if (sel > i) { this.selection[si] = sel - 1; }
            si = si + 1;
        }
        if (this.selectedIndex < 0 && this.selection.Count > 0) {
            this.selectedIndex = this.selection[0];
        }
        for (int j = 0; j < this.objects.Count; j = j + 1) {
            WorldObject other = this.objects[j];
            int tj = other.TargetIndex();
            if (tj == i) { other.StopAttack(); }
            else if (tj > i) { other.SetTarget(tj - 1); }
        }
        this.objects.RemoveAt(i);
        for (int c = 0; c < this.occupancy.Length; c = c + 1) {
            if (this.occupancy[c] > i + 1) {
                this.occupancy[c] = this.occupancy[c] - 1;
            }
        }
    }

    /// <summary>Places a neutral civilian structure (from the map's
    /// [Structures] section) at full or partial health. Returns the new
    /// object's index, or -1 when the id is unknown or the footprint does
    /// not fit.</summary>
    int PlaceCivStructure(int civId, int x, int y, int hp) {
        StructureType t = this.catalog.CivType(civId);
        if (t == null) { return -1; }
        if (!this.CanPlace(t, x, y)) { return -1; }
        int startHp = hp;
        if (startHp <= 0 || startHp > t.Hp()) { startHp = t.Hp(); }
        WorldObject o = WorldObject.CreateStructure(Side2.Neutral(), civId,
                                                    x, y, startHp);
        o.SetCiv(true);
        return this.AddObject(o);
    }

    /// <summary>Spawns a unit of unitId on one cell, refusing when the id is
    /// unknown, the cell is taken, or the cell is outside the playable area.
    /// Health comes from the unit's archetype.</summary>
    int SpawnUnit(int side, int unitId, int x, int y) {
        UnitType u = this.units.TypeFor(this, side, unitId);
        if (u == null) { return -1; }
        if (!this.InBounds(x, y)) { return -1; }
        // A flyer materialises in the air: no tile to block, none occupied.
        if (!u.Flying()
         && (this.occupancy[this.CellSlot(x, y)] != 0
             || this.IsWallCell(x, y))) { return -1; }
        WorldObject o = WorldObject.CreateUnit(side, unitId, x, y, u.Hp(), u);
        int idx = this.AddObject(o);
        this.ShroudRevealObject(o);
        // The spawn chirp (CreateSound=) -- the ObjectSpawn event. The
        // battle's opening population goes through here before the app
        // installs the sink, so only later spawns (crates, the free-MCV
        // event) are heard, matching the reference's subscribe-after-load.
        this.SndSpawnSound(o);
        return idx;
    }

    /// <summary>Spawns a unit for a pre-placed map entry whose archetype the
    /// caller resolved itself (a reg no roster carries, discovered from the
    /// install's declared type lists). Works like the unitId form below but
    /// takes the archetype directly, since there is no catalog slot to look
    /// it up by. The object is tagged civilian so the renderer resolves its
    /// art the same way and the game logic leaves it parked.</summary>
    int SpawnMapUnitType(UnitType ut, int x, int y, int hp, int facing) {
        if (ut == null) { return -1; }
        if (!this.InBounds(x, y)) { return -1; }
        if (this.occupancy[this.CellSlot(x, y)] != 0
         || this.IsWallCell(x, y)) {
            if (!this.InBounds(x + 1, y)
             || this.occupancy[this.CellSlot(x + 1, y)] != 0) {
                return -1;
            }
            x = x + 1;
        }
        int startHp = hp;
        if (startHp <= 0 || startHp > ut.Hp()) { startHp = ut.Hp(); }
        WorldObject o = WorldObject.CreateUnit(Side2.Neutral(), -1, x, y,
                                               startHp, ut);
        o.SetCiv(true);
        o.SetFacing(facing);
        o.SetTurretFacing(facing);
        return this.AddObject(o);
    }

    /// <summary>Spawns a unit for a pre-placed map entry ([Units] /
    /// [Infantry] / [Aircraft]). Unlike SpawnUnit this carries the entry's own
    /// health and the compass facing it shipped with, which is what makes a
    /// map's parked cars and wandering cows read the way the original's do
    /// instead of all facing north at full health.
    ///
    /// A cell already taken is not fatal here: a map packs its scenery into
    /// clusters, so the cell beside the entry is tried before giving up (the
    /// original's spawn just overwrites, but overwriting would corrupt the
    /// occupancy index the rest of the world trusts).</summary>
    int SpawnMapUnit(int side, int unitId, int x, int y, int hp, int facing,
                     UnitType ut) {
        if (ut == null) { return -1; }
        if (!this.InBounds(x, y)) { return -1; }
        if (this.occupancy[this.CellSlot(x, y)] != 0
         || this.IsWallCell(x, y)) {
            if (!this.InBounds(x + 1, y)
             || this.occupancy[this.CellSlot(x + 1, y)] != 0) {
                return -1;
            }
            x = x + 1;
        }
        int startHp = hp;
        if (startHp <= 0 || startHp > ut.Hp()) { startHp = ut.Hp(); }
        WorldObject o = WorldObject.CreateUnit(side, unitId, x, y, startHp, ut);
        o.SetFacing(facing);
        o.SetTurretFacing(facing);
        int idx = this.AddObject(o);
        this.ShroudRevealObject(o);
        return idx;
    }

    int SpawnMapUnit(int side, int unitId, int x, int y, int hp, int facing) {
        UnitType u = this.units.TypeFor(this, side, unitId);
        return this.SpawnMapUnit(side, unitId, x, y, hp, facing, u);
    }

    /// <summary>A cell's land class, resolved the way the reference resolves
    /// it: from the TMP template of the tile the cell placed
    /// (`TileCollection.ts:100-113`).
    ///
    /// When the theater cannot answer -- a tile from a set whose art this
    /// install lacks, or the 0xFFFF clear-terrain sentinel -- the fallback
    /// keeps the old set-name heuristic so a partly-installed theater still
    /// plays. A null return means "no opinion", never "impassable".
    ///
    /// The elevation byte is deliberately NOT consulted here. It used to
    /// be: `IsGround` rejected any cell above a hardcoded level 7, which is
    /// neither the reference's rule nor a workable one. Two cells either
    /// side of a cliff edge share an elevation byte, so no height
    /// comparison can distinguish "stand here" from "drive off the edge".
    /// The land class and the ramp flag are what carry that information.</summary>
    LandType CellLand(IsoTile t) {
        if (t == null) { return null; }
        LandType ov = this.OverlayLandAt(t.X(), t.Y());
        if (ov != null) { return ov; }
        if (this.theater != null) {
            LandType lt = this.theater.CellLandType(t.Tile(), t.SubTile());
            if (lt != null) { return lt; }
        }
        // Fallback: classify by the theater's set-name table, then by the
        // built-in temperate ranges when even that is unavailable.
        if (this.IsWater(t)) { return LandType.Of(LandType.Water()); }
        if (this.IsBridge(t)) { return LandType.Of(LandType.Road()); }
        if (t.IsClear()) { return LandType.Of(LandType.Clear()); }
        return LandType.Of(LandType.Rock());
    }

    /// <summary>The land override a static overlay or bridge piece lays
    /// on a cell: only types that declare NoUseTileLandType with a Land=
    /// class replace the terrain's own (the reference's tile-land rule).
    /// Low bridges read Road over water, fences and rocks read Rock.</summary>
    LandType OverlayLandAt(int x, int y) {
        if (!this.InBounds(x, y)) { return null; }
        int slot = this.CellSlot(x, y);
        int ov = this.brOv[slot] >= 0 ? this.brOv[slot] : this.statOv[slot];
        if (ov < 0) { return null; }
        int flags = this.Rules().OverlayLandFlags(ov);
        if ((flags & 256) == 0 || (flags & 255) == 255) { return null; }
        return LandType.Of(flags & 255);
    }

    /// <summary>A cell's land class value, -1 when nothing classifies it
    /// (the probes and the bridge checks read this).</summary>
    int CellLandClassAt(int x, int y) {
        if (!this.InBounds(x, y)) { return 0 - 1; }
        LandType lt = this.CellLand(this.iso.At(x, y));
        return lt != null ? lt.Value() : 0 - 1;
    }

    /// <summary>A cell's ramp flag: non-zero means a graded slope, the only
    /// terrain a ground unit may use to change height.</summary>
    int CellRamp(IsoTile t) {
        if (t == null || this.theater == null) { return 0; }
        return this.theater.CellRampType(t.Tile(), t.SubTile());
    }

    // ---- accessors for the terrain probe -----------------------------

    bool CellIsCliff(int x, int y) {
        if (!this.InBounds(x, y)) { return false; }
        LandType lt = this.CellLand(this.iso.At(x, y));
        return lt != null && lt.IsCliffClass();
    }

    int CellRampAt(int x, int y) {
        if (!this.InBounds(x, y)) { return 0; }
        return this.CellRamp(this.iso.At(x, y));
    }

    int CellTerrainType(int x, int y) {
        if (!this.InBounds(x, y) || this.theater == null) { return -1; }
        IsoTile t = this.iso.At(x, y);
        if (t == null) { return -1; }
        return this.theater.CellTerrainType(t.Tile(), t.SubTile());
    }

    bool CellRough(int x, int y) {
        if (!this.InBounds(x, y)) { return false; }
        LandType lt = this.CellLand(this.iso.At(x, y));
        return lt != null && lt.IsRoughClass();
    }

    int LevelAt(int x, int y) {
        if (!this.InBounds(x, y)) { return 0; }
        IsoTile t = this.iso.At(x, y);
        if (t == null) { return 0; }
        return t.Level();
    }

    int ObjectX(int i) {
        if (i < 0 || i >= this.objects.Count) { return 0; }
        return this.objects[i].X();
    }

    int ObjectY(int i) {
        if (i < 0 || i >= this.objects.Count) { return 0; }
        return this.objects[i].Y();
    }

    bool IsUnitIndex(int i) {
        if (i < 0 || i >= this.objects.Count) { return false; }
        return this.objects[i].Kind() == ObjKind.Unit();
    }

    /// <summary>Cells reachable from the first unit's position by the same
    /// rule movement uses. Reported by the terrain probe so a "0 illegal
    /// steps" result cannot be a search that reaches nothing.</summary>
    int ReachableFromFirstUnit() {
        if (this.objects.Count == 0) { return 0; }
        int sx = this.objects[0].X();
        int sy = this.objects[0].Y();
        if (!this.InBounds(sx, sy)) { return 0; }
        int cells = this.width * this.height;
        byte[] seen = new byte[cells];
        List<int> qx = new List<int>();
        List<int> qy = new List<int>();
        qx.Add(sx);
        qy.Add(sy);
        seen[this.CellSlot(sx, sy)] = 1;
        int n = 0;
        int head = 0;
        while (head < qx.Count) {
            int cx = qx[head];
            int cy = qy[head];
            head = head + 1;
            n = n + 1;
            for (int d = 0; d < 4; d = d + 1) {
                int nx = cx;
                int ny = cy;
                if (d == 0) { nx = cx + 1; }
                else if (d == 1) { nx = cx - 1; }
                else if (d == 2) { ny = cy + 1; }
                else { ny = cy - 1; }
                int slot = this.CellSlot(nx, ny);
                if (slot < 0 || seen[slot] != 0) { continue; }
                if (!this.CanStep(cx, cy, nx, ny, false)) { continue; }
                seen[slot] = 1;
                qx.Add(nx);
                qy.Add(ny);
            }
        }
        return n;
    }

    /// <summary>True when a cell is solid ground a unit can stand on.
    ///
    /// Expressed as the land class, matching the reference's rule: cliff
    /// faces and walls are not ground, water is not ground for a land unit,
    /// and rough/road/beach/clear all are. Nothing here compares heights.</summary>
    bool IsGround(IsoTile t) {
        if (t == null) { return false; }
        LandType lt = this.CellLand(t);
        if (lt == null) { return false; }
        return lt.GroundPassable();
    }
    /// <summary>True when a tile is a body of water. The ranges come from the
    /// theater's own tile-set table ("Water" 314-327, "ZMM Water" 769-782,
    /// the water caves and waterfalls), so a snow or urban map classifies its
    /// water by its own ids instead of by temperate's numbers. The built-in
    /// temperate range stands in until the table arrives.</summary>
    bool IsWater(IsoTile t) {
        // A cell the map's IsoMapPack5 never records (the diamond's corners
        // on sparse maps) is outside the playable area, not sea.
        if (t == null) { return false; }
        int id = t.Tile();
        if (id == 0xFFFF) { return false; }
        if (this.waterRanges != null && this.waterRanges.Count >= 2) {
            for (int i = 0; i + 1 < this.waterRanges.Count; i = i + 2) {
                if (id >= this.waterRanges[i]
                 && id < this.waterRanges[i] + this.waterRanges[i + 1]) {
                    return true;
                }
            }
            return false;
        }
        return id >= 314 && id < 328;
    }

    /// <summary>Installs the theater's water-id ranges as first,count pairs.</summary>
    void SetWaterRanges(List<int> ranges) { this.waterRanges = ranges; }

    /// <summary>Installs the theater whose TMP templates classify terrain.
    /// Must be called before any passability query for the land-class rule
    /// to apply; until then CellLand falls back to the set-name ranges.</summary>
    void SetTheater(Theater t) { this.theater = t; }

    // ---- lighting ---------------------------------------------------------

    /// <summary>The lighting engine, for the renderer's shade lookups and
    /// for the effects/triggers that override the ambient.</summary>
    Lighting Lights() { return this.lighting; }

    /// <summary>The per-channel shading factors for an object at its cell,
    /// as a 3-list (r, g, b). `type` is the art's LightingType class: units
    /// and structures take Ambient, ground decals take Full. The height
    /// term rides the object's cell level so a unit on a cliff catches the
    /// level step the reference gives it. Units and aircraft take their
    /// [AudioVisual] Extra*Light nudge on top -- the shipped .2 that makes
    /// a hull read a touch brighter than the ground under it; structures
    /// take none, the reference's Building.updateBaseLight.</summary>
    List<double> ShadeFor(WorldObject o, int type) {
        int h = 0;
        if (o != null && this.iso != null) {
            IsoTile t = this.iso.At(o.X(), o.Y());
            if (t != null) { h = t.Level(); }
        }
        List<double> sh = this.ShadeAt(o == null ? 0 : o.X(),
                                       o == null ? 0 : o.Y(), h, type);
        if (o == null || o.Kind() != ObjKind.Unit()) { return sh; }
        UnitType u = this.UnitTypeOf(o);
        if (u == null) { return sh; }
        int extraM = u.Infantry() ? this.Rules().ExtraInfantryLightM()
                                  : this.Rules().ExtraUnitLightM();
        if (extraM == 0) { return sh; }
        // The reference adds it as a delta to the cell's multiplier, so a
        // dim cell brightens by the same amount a bright one does.
        double add = (double)extraM / 1000.0;
        List<double> out3 = new List<double>();
        out3.Add(sh[0] + add);
        out3.Add(sh[1] + add);
        out3.Add(sh[2] + add);
        return out3;
    }

    /// <summary>The per-channel shading factors for a cell, as a 3-list.</summary>
    List<double> ShadeAt(int x, int y, int height, int type) {
        if (this.lighting == null) {
            List<double> one = new List<double>();
            one.Add(1.0);
            one.Add(1.0);
            one.Add(1.0);
            return one;
        }
        return this.lighting.Compute(type, x, y, height);
    }

    /// <summary>Installs the map's [Lighting] block as the engine's base,
    /// the reference's Lighting(mapLightingTrait). Called once the map is
    /// known; a world that never gets one keeps the reference defaults.</summary>
    void SetMapLighting(MapLighting m) {
        if (m == null) { return; }
        this.lighting.SetBase(m);
    }

    /// <summary>Whether a structure type casts a lamp pool: its rules carry
    /// a LightVisibility and a non-zero LightIntensity. The shipped GALITE
    /// (a visible street lamp) and the IN*LAMP/NEGLAMP family
    /// (InvisibleInGame posts) are the ones that qualify; NEGLAMP's
    /// intensity is negative, so it darkens.</summary>
    bool IsLampType(StructureType t) {
        if (t == null) { return false; }
        if (t.LightVisibility() <= 0) { return false; }
        double i = t.LightIntensity();
        return i >= 0.001 || i <= 0.0 - 0.001;
    }

    /// <summary>Seeds a lamp building's pool onto every cell within
    /// LightVisibility leptons, the reference's WorldView.addLampLights:
    /// the radius is visibility/256 cells, and each cell in it gets
    /// (visibility - 256*distance)/visibility of the lamp's tint and
    /// intensity -- a linear falloff to nothing at the rim. The lights
    /// placed are remembered per lamp so a later death can take exactly
    /// those off again.</summary>
    void SeedLampLights(WorldObject o) {
        if (o == null || o.Kind() != ObjKind.Structure()) { return; }
        StructureType t = this.TypeOf(o);
        if (!this.IsLampType(t)) { return; }
        for (int k = 0; k < this.lampSources.Count; k = k + 1) {
            if (this.lampSources[k] == o) { return; }   // already seeded
        }
        List<TileLight> placed = new List<TileLight>();
        List<int> px = new List<int>();
        List<int> py = new List<int>();
        double radius = t.LightVisibility() / 256.0;
        int maxDelta = (int)Math.Ceiling(radius);
        int cx = o.X();
        int cy = o.Y();
        for (int dx = 0 - maxDelta; dx <= maxDelta; dx = dx + 1) {
            for (int dy = 0 - maxDelta; dy <= maxDelta; dy = dy + 1) {
                int tx = cx + dx;
                int ty = cy + dy;
                if (!this.InBounds(tx, ty)) { continue; }
                double dist = Math.Sqrt((double)(dx * dx + dy * dy));
                if (dist >= radius) { continue; }
                double effect = ((double)t.LightVisibility() - 256.0 * dist)
                                / (double)t.LightVisibility();
                TileLight light = TileLight.Create(
                    effect * t.LightRedTint(),
                    effect * t.LightGreenTint(),
                    effect * t.LightBlueTint(),
                    effect * t.LightIntensity());
                this.lighting.AddTileLight(tx, ty, light);
                placed.Add(light);
                px.Add(tx);
                py.Add(ty);
            }
        }
        this.lampSources.Add(o);
        this.lampLights.Add(placed);
        this.lampSpots.Add(px);
        this.lampSpotsY.Add(py);
    }

    /// <summary>Takes a dead lamp's pool off its cells, the reference's
    /// onLampRemoved: without this a destroyed street lamp keeps lighting
    /// the street forever. Only this lamp's own entries come off, so a cell
    /// two lamps share stays lit by the survivor.</summary>
    void ClearLampLights(WorldObject o) {
        if (o == null) { return; }
        int at = 0 - 1;
        for (int k = 0; k < this.lampSources.Count; k = k + 1) {
            if (this.lampSources[k] == o) { at = k; break; }
        }
        if (at < 0) { return; }
        List<TileLight> placed = this.lampLights[at];
        List<int> px = this.lampSpots[at];
        List<int> py = this.lampSpotsY[at];
        for (int k = 0; k < placed.Count; k = k + 1) {
            this.lighting.RemoveTileLight(px[k], py[k], placed[k]);
        }
        this.lampSources.RemoveAt(at);
        this.lampLights.RemoveAt(at);
        this.lampSpots.RemoveAt(at);
        this.lampSpotsY.RemoveAt(at);
    }

    /// <summary>Re-seeds every lamp on the field: called when a save/load or
    /// a scenario rebuild repopulates the world, so the pools match the
    /// buildings that exist. A no-op when nothing is a lamp.</summary>
    void ReseedLamps() {
        this.lighting.ClearTileLights();
        this.lampSources = new List<WorldObject>();
        this.lampLights = new List<List<TileLight>>();
        this.lampSpots = new List<List<int>>();
        this.lampSpotsY = new List<List<int>>();
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o != null && !o.IsDead()) { this.SeedLampLights(o); }
        }
    }

    /// <summary>Seeds lamps as a structure spawns, the reference's
    /// onLampSpawned hook.</summary>
    void OnStructureSpawned(WorldObject o) {
        this.SeedLampLights(o);
    }

    /// <summary>Per-cell water test for callers that only have a coordinate
    /// (the dev ground-rule probe).</summary>
    bool CellIsWater(int x, int y) {
        if (!this.InBounds(x, y)) { return false; }
        IsoTile t = this.iso.At(x, y);
        if (t == null) { return false; }
        return this.IsWater(t);
    }

    /// <summary>The build-slot id a side's catalog gives a registration name,
    /// or -1. Used to ask placement questions about a named structure (the
    /// shipyard) without hardcoding its slot.</summary>
    int IdOfReg(int side, string reg) {
        if (this.catalog == null) { return 0 - 1; }
        return this.catalog.IdOfReg(this, side, reg);
    }

    /// <summary>A side's structure archetype by build slot (dev probes and
    /// the sidebar both need to walk the catalog).</summary>
    StructureType CatalogType(int side, int buildId) {
        if (this.catalog == null) { return null; }
        return this.catalog.TypeFor(this, side, buildId);
    }

    /// <summary>True when a tile is a bridge the ground units can cross. The
    /// temperate theater's wood/overpass bridge sets (Ovrps 277-292) span
    /// water; they sit on the water tiles' level, so without this carve-out
    /// every water crossing would be impassable and maps with a water divide
    /// would trap the two bases apart.</summary>
    bool IsBridge(IsoTile t) {
        if (t == null) { return false; }
        int id = t.Tile();
        if (id == 0xFFFF) { return false; }
        if (id >= 277 && id < 293) { return true; }   // Ovrps
        if (id >= 804 && id < 806) { return true; }   // wbrdge
        if (id >= 821 && id < 837) { return true; }   // Ovrpsb
        return false;
    }

    /// <summary>True when a structure's footprint sits on flat, walkable
    /// ground. Building placement only checks bounds and occupancy, but a
    /// base worth having needs its units to be able to walk out.</summary>
    bool FlatFit(StructureType t, int x, int y) {
        for (int dy = 0; dy < t.FootprintH(); dy = dy + 1) {
            for (int dx = 0; dx < t.FootprintW(); dx = dx + 1) {
                if (!this.InBounds(x + dx, y + dy)) { return false; }
                if (this.occupancy[this.CellSlot(x + dx, y + dy)] != 0
                 || this.IsWallCell(x + dx, y + dy)) {
                    return false;
                }
                if (!this.IsGround(this.iso.At(x + dx, y + dy))) { return false; }
            }
        }
        return true;
    }

    int AddObject(WorldObject o) {
        // A flying unit lives above the grid: the occupancy index stays
        // untouched, so ground columns walk under it and two flyers never
        // collide. Click selection finds them through ObjectsAt's flyer
        // sweep instead.
        if (!o.IsFlying()) {
            this.occupancy[this.CellSlot(o.X(), o.Y())]
                = this.objects.Count + 1;
        }
        this.objects.Add(o);
        // A lamp building lights its neighbourhood the moment it appears,
        // the reference's onObjectSpawned hook in WorldView.
        this.OnStructureSpawned(o);
        // A structure's footprint is its whole footprint; a unit is one cell.
        if (o.Kind() == ObjKind.Structure()) {
            StructureType t = this.TypeOf(o);
            for (int dy = 0; dy < t.FootprintH(); dy = dy + 1) {
                for (int dx = 0; dx < t.FootprintW(); dx = dx + 1) {
                    this.occupancy[this.CellSlot(o.X() + dx, o.Y() + dy)]
                        = this.objects.Count;
                }
            }
        }
        return this.objects.Count - 1;
    }

    /// <summary>Moves an existing object onto a cell without the occupancy
    /// bookkeeping the spawn paths do -- the reference's tile occupation
    /// holds several objects on one tile (a hull and the infantry under
    /// it), which is exactly the state the crush pass reads. Used by the
    /// probes to stage that overlap.</summary>
    void PlaceObjectAt(WorldObject o, int x, int y) {
        if (o == null || !this.InBounds(x, y)) { return; }
        o.SetCell(x, y);
    }

    /// <summary>Enqueues a unit of unitId on a structure's production queue.
    /// Returns false when the index is not a structure or the unit id is not
    /// one the structure can train. The money is the caller's business.</summary>
    bool QueueUnit(int structIdx, int unitId) {
        if (structIdx < 0 || structIdx >= this.objects.Count) { return false; }
        WorldObject o = this.objects[structIdx];
        if (o.Kind() != ObjKind.Structure()) { return false; }
        StructureType t = this.TypeOf(o);
        List<int> prod = t.Produces();
        if (prod == null) { return false; }
        bool can = false;
        for (int i = 0; i < prod.Count; i = i + 1) {
            if (prod[i] == unitId) { can = true; }
        }
        if (!can) { return false; }
        UnitType u = this.units.TypeFor(this, o.Side(), unitId);
        if (u == null) { return false; }
        o.QueueUnit(unitId, u.BuildTime());
        return true;
    }

    /// <summary>Cancels the newest queued instance of a unit on one
    /// structure, the right-click dequeue. True when an entry went.</summary>
    bool CancelQueuedUnit(int structIdx, int unitId) {
        if (structIdx < 0 || structIdx >= this.objects.Count) { return false; }
        WorldObject o = this.objects[structIdx];
        if (o.Kind() != ObjKind.Structure()) { return false; }
        for (int i = o.ProdCount() - 1; i >= 0; i = i - 1) {
            if (o.ProdUnitAt(i) == unitId) {
                o.CancelProdAt(i);
                return true;
            }
        }
        return false;
    }

    /// <summary>Writes the first free flat cell around a structure's footprint
    /// (the ring one cell out from it) to outCell, or leaves outCell empty
    /// when every neighbour is taken. A finished unit spawns here.</summary>
    void FindSpawnCell(WorldObject o, List<int> outCell) {
        StructureType t = this.TypeOf(o);
        // Scan the four rings around the footprint, but hand out the free
        // cell nearest the structure's centre rather than the first hit of
        // the scan: a scan-order pick strings an opening squad out along the
        // scanline, while a nearest pick clusters it around the building the
        // way the original's start units gather around their yard.
        int cx = o.X() + t.FootprintW() / 2;
        int cy = o.Y() + t.FootprintH() / 2;
        int bestX = 0 - 1;
        int bestY = 0;
        int bestD = 0;
        for (int r = 1; r <= 4; r = r + 1) {
            int x0 = o.X() - r;
            int y0 = o.Y() - r;
            int x1 = o.X() + t.FootprintW() - 1 + r;
            int y1 = o.Y() + t.FootprintH() - 1 + r;
            for (int y = y0; y <= y1; y = y + 1) {
                for (int x = x0; x <= x1; x = x + 1) {
                    // Only this radius's annulus: the inner square was
                    // already scanned on a tighter ring.
                    if (x > x0 && x < x1 && y > y0 && y < y1) { continue; }
                    if (!o.IsFlying() && !this.Passable(x, y)) { continue; }
                    if (o.IsFlying() && !this.InBounds(x, y)) { continue; }
                    int dx = x - cx;
                    int dy = y - cy;
                    if (dx < 0) { dx = 0 - dx; }
                    if (dy < 0) { dy = 0 - dy; }
                    int d = dx * 1000 + dy;
                    if (bestX < 0 || d < bestD) {
                        bestD = d;
                        bestX = x;
                        bestY = y;
                    }
                }
            }
        }
        if (bestX >= 0) {
            outCell.Add(bestX);
            outCell.Add(bestY);
        }
    }

    /// <summary>The cell is passable for a ground unit: inside the playable
    /// area, solid ground or a bridge, and nothing occupies it. Amphibious
    /// units (hovercraft) additionally pass water.</summary>
    bool Passable(int x, int y) {
        return this.PassableFor(x, y, false);
    }

    bool PassableFor(int x, int y, bool amphibious) {
        return this.PassableForF(x, y, amphibious, false);
    }

    /// <summary>The flying-aware form: an airborne unit's destination only
    /// needs to be on the map -- water, cliffs, walls and parked units are
    /// all beneath it.</summary>
    bool PassableForF(int x, int y, bool amphibious, bool flying) {
        if (!this.InBounds(x, y)) { return false; }
        if (flying) { return true; }
        IsoTile t = this.iso.At(x, y);
        if (t == null) { return false; }
        if (!this.IsGround(t) && !this.IsBridge(t)) {
            if (!(amphibious && this.IsWater(t))) { return false; }
        }
        return this.occupancy[this.CellSlot(x, y)] == 0;
    }

    /// <summary>Passability for route planning: fellow soldiers are not
    /// walls. A column plans around terrain and buildings, and the walkers
    /// queue at step time instead. Treating the army itself as impassable
    /// locks a massed force inside its own base -- every route out of a
    /// crowded camp fails the search, so an attack order moves nobody.
    /// Structures keep blocking: a route through a wall is a lie.</summary>
    bool PassableForRoute(int x, int y, bool amphibious) {
        return this.PassableForRouteF(x, y, amphibious, false);
    }

    /// <summary>The flying-aware route check: the sky is empty everywhere
    /// on the map, so the sweep plans straight over water, cliffs, walls
    /// and whole buildings.</summary>
    bool PassableForRouteF(int x, int y, bool amphibious, bool flying) {
        if (flying) { return this.InBounds(x, y); }
        if (!this.InBounds(x, y)) { return false; }
        IsoTile t = this.iso.At(x, y);
        if (t == null) { return false; }
        if (!this.IsGround(t) && !this.IsBridge(t)) {
            if (!(amphibious && this.IsWater(t))) { return false; }
        }
        int occ = this.occupancy[this.CellSlot(x, y)];
        if (occ == 0) { return true; }
        WorldObject o = this.objects[occ - 1];
        return o.Kind() != ObjKind.Structure() && !o.IsDead();
    }

    /// <summary>Objects overlapping a cell, with the structure's footprint
    /// expanded so a click on any of its cells selects it. Appends to outIds.</summary>
    void ObjectsAt(int x, int y, List<int> outIds) {
        int oi = this.OccupantAt(x, y);
        if (oi >= 0) { outIds.Add(oi); return; }
        // A footprint's anchor cell may lie off the clicked cell's footprint;
        // check the surrounding anchor cells.
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Kind() != ObjKind.Structure()) { continue; }
            StructureType t = this.TypeOf(o);
            for (int dy = 0; dy < t.FootprintH(); dy = dy + 1) {
                for (int dx = 0; dx < t.FootprintW(); dx = dx + 1) {
                    if (o.X() + dx == x && o.Y() + dy == y) { outIds.Add(i); }
                }
            }
        }
        // Flyers never sit in the occupancy index: a click under one sweeps
        // the (short) airborne list directly.
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.IsDead() || !o.IsFlying()) { continue; }
            if (o.X() == x && o.Y() == y) { outIds.Add(i); }
        }
    }

    /// <summary>The object whose footprint or unit cell covers (x, y), or -1.</summary>
    int OccupantAt(int x, int y) {
        int slot = this.CellSlot(x, y);
        if (slot < 0) { return -1; }
        int v = this.occupancy[slot];
        if (v == 0) { return -1; }
        return v - 1;
    }

    /// <summary>The object currently under attack, or null when the index is
    /// stale (the target was destroyed and the attacker has not reacquired).</summary>
    WorldObject Target(WorldObject o) {
        int idx = o.TargetIndex();
        if (idx < 0 || idx >= this.objects.Count) { return null; }
        WorldObject t = this.objects[idx];
        if (t.IsDead()) { return null; }
        return t;
    }

    /// <summary>The first living object of the opposite side under a cell. A
    /// right-click on any footprint cell of an enemy building attacks it.</summary>
    WorldObject EnemyAt(int x, int y, int side) {
        List<int> ids = new List<int>();
        this.ObjectsAt(x, y, ids);
        for (int i = 0; i < ids.Count; i = i + 1) {
            WorldObject o = this.objects[ids[i]];
            if (o.Side() != side && !o.IsDead()) { return o; }
        }
        return null;
    }

    /// <summary>Orders the selected unit to attack the object under a cell.
    /// Returns false when nothing is selected, it is not a unit, the cell holds
    /// no enemy, or the enemy is already the current target.</summary>
    bool OrderAttack(int x, int y) {
        bool any = false;
        int commanderSide = -1;
        if (this.selection.Count > 0) {
            int p = this.selection[0];
            if (p >= 0 && p < this.objects.Count) {
                commanderSide = this.objects[p].Side();
            }
        }
        WorldObject enemy = null;
        if (commanderSide >= 0) {
            enemy = this.EnemyAt(x, y, commanderSide);
        }
        if (enemy == null) { return false; }
        int eIdx = this.objects.IndexOf(enemy);
        for (int s = 0; s < this.selection.Count; s = s + 1) {
            int idx = this.selection[s];
            if (idx < 0 || idx >= this.objects.Count) { continue; }
            WorldObject sel = this.objects[idx];
            if (sel.Kind() != ObjKind.Unit()) { continue; }
            if (sel.Side() != commanderSide) { continue; }
            if (idx == eIdx || eIdx == sel.TargetIndex()) { continue; }
            sel.SetTarget(eIdx);
            sel.SetReload(0);
            // Re-route so the unit walks into range when the enemy is far; the
            // chase happens each tick, so a moving target is followed.
            sel.SetRoute(null, null);
            any = true;
        }
        return any;
    }

    /// <summary>Direct attack order, for the AI: unit `attackerIdx` targets
    /// object `t` regardless of selection. Returns false when the attacker is
    /// not a live unit or the target is not in the world.</summary>
    bool AttackObject(int attackerIdx, WorldObject t) {
        if (attackerIdx < 0 || attackerIdx >= this.objects.Count) { return false; }
        WorldObject o = this.objects[attackerIdx];
        if (o.Kind() != ObjKind.Unit()) { return false; }
        // An order at a flyer only sticks when the trooper carries an AA
        // gun -- rifles aimed at a zeppelin would be a promise to fire
        // straight up and hit nothing.
        if (t != null && t.IsFlying()) {
            Weapon w = this.PickWeapon(o.UnitType(), t);
            if (w == null) { return false; }
        }
        int idx = this.objects.IndexOf(t);
        if (idx < 0 || idx == o.TargetIndex()) { return false; }
        o.SetTarget(idx);
        o.SetReload(0);
        o.SetRoute(null, null);
        return true;
    }

    /// <summary>The index of the living object of `side`'s opponent nearest to
    /// (x,y), or -1 when the opponent has nothing left on the map. Neutral
    /// civilian structures are invisible here: nobody shoots at them on his
    /// own, they are only touched by an explicit order (an engineer's
    /// capture).</summary>
    int NearestEnemy(int side, int x, int y) {
        int best = -1;
        int bestD = -1;
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Side() == side || o.Side() == Side2.Neutral()
             || o.IsDead()) { continue; }
            int d = this.Distance(x, y, o.X(), o.Y());
            if (bestD < 0 || d < bestD) { bestD = d; best = i; }
        }
        return best;
    }

    /// <summary>The nearest enemy a walker can actually reach: a
    /// breadth-first sweep over route-passable ground that stops the moment
    /// it bumps an enemy footprint. Units whose orders point at a building
    /// that is walled off or perched behind uncrossable terrain chew on this
    /// fallback instead of standing idle for the rest of the war.</summary>
    int NearestReachableEnemy(int sx, int sy, int side, bool amphibious) {
        int cells = this.width * this.height;
        byte[] seen = new byte[cells];
        List<int> qx = new List<int>();
        List<int> qy = new List<int>();
        int startSlot = this.CellSlot(sx, sy);
        if (startSlot < 0) { return -1; }
        seen[startSlot] = 1;
        qx.Add(sx);
        qy.Add(sy);
        int head = 0;
        while (head < qx.Count) {
            int cx = qx[head];
            int cy = qy[head];
            head = head + 1;
            for (int d = 0; d < 4; d = d + 1) {
                int nx = cx;
                int ny = cy;
                if (d == 0) { nx = cx + 1; }
                else if (d == 1) { nx = cx - 1; }
                else if (d == 2) { ny = cy + 1; }
                else { ny = cy - 1; }
                int slot = this.CellSlot(nx, ny);
                if (slot < 0 || seen[slot] != 0) { continue; }
                seen[slot] = 1;
                int occ = this.occupancy[slot];
                if (occ != 0) {
                    WorldObject e = this.objects[occ - 1];
                    if (!e.IsDead() && e.Side() != side
                     && e.Side() != Side2.Neutral()) {
                        return occ - 1;
                    }
                }
                if (!this.PassableForRoute(nx, ny, amphibious)) { continue; }
                qx.Add(nx);
                qy.Add(ny);
            }
        }
        return -1;
    }

    /// <summary>Nearest enemy within `radius` cells, or -1. Used by the
    /// move-attack scan so a unit only stops for hostiles close enough to
    /// matter. Skips neutrals like NearestEnemy.</summary>
    int NearestEnemyIn(int x, int y, int side, int radius) {
        return this.NearestEnemyInAir(x, y, side, radius, true);
    }

    /// <summary>The AA-aware form: a shooter whose guns cannot reach the
    /// sky never acquires a flying target. Ground targets still outrank
    /// airborne ones when both are in radius, so an AA gun keeps shooting
    /// infantry instead of chasing a distant zeppelin.</summary>
    int NearestEnemyInAir(int x, int y, int side, int radius, bool canHitAir) {
        int best = -1;
        int bestD = -1;
        int bestFly = -1;
        int bestFlyD = -1;
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Side() == side || o.Side() == Side2.Neutral()
             || o.IsDead()) { continue; }
            int d = this.Distance(x, y, o.X(), o.Y());
            if (d > radius) { continue; }
            if (o.IsFlying()) {
                if (canHitAir && (bestFlyD < 0 || d < bestFlyD)) {
                    bestFlyD = d;
                    bestFly = i;
                }
                continue;
            }
            if (bestD < 0 || d < bestD) { bestD = d; best = i; }
        }
        if (best >= 0) { return best; }
        return bestFly;
    }

    /// <summary>True when `side` has no living structure left. That is the
    /// game's win condition: a side without buildings is a side without a
    /// base, even if a stray unit is still walking around.</summary>
    bool SideEliminated(int side) {
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Side() == side && o.Kind() == ObjKind.Structure() && !o.IsDead()) {
                return false;
            }
        }
        return true;
    }

    /// <summary>The side's power balance: power plants supply, everything else
    /// drains. A negative balance means production and construction slow down
    /// -- the classic low-power state that punishes overbuilding.</summary>
    int PowerBalance(int side) {
        List<int> flow = new List<int>();
        flow.Add(0);
        flow.Add(0);
        this.PowerFlow(side, flow);
        return flow[0] - flow[1];
    }

    /// <summary>The side's power supply and drain, written to flow[0] and
    /// flow[1] -- the two numbers the sidebar's power pips plot against each
    /// other, the way the original's bar splits red drain from green
    /// surplus.</summary>
    void PowerFlow(int side, List<int> flow) {
        int supply = 0;
        int drain = 0;
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Side() != side || o.Kind() != ObjKind.Structure() || o.IsDead()) {
                continue;
            }
            // A building only contributes once it has finished constructing.
            StructureType t = this.TypeOf(o);
            if (t == null) { continue; }
            if (o.BuiltTicks() < t.BuildTime()) { continue; }
            supply = supply + t.Power();
            drain = drain + t.Drain();
        }
        while (flow.Count < 2) { flow.Add(0); }
        flow[0] = supply;
        flow[1] = drain;
    }

    /// <summary>Writes a spot for a structure to outXy, preferring the ring
    /// around the side's existing buildings and falling back to a whole-map
    /// scan. The AI builds by expansion, so its base grows rather than
    /// sprouting buildings all over the map.</summary>
    /// <summary>True when the footprint at (x,y) keeps a one-cell corridor
    /// from every standing building -- no cardinally adjacent neighbour.
    /// Bases grow with streets between the houses, the way the real AI
    /// builds: every defence stays approachable and no unit locks itself
    /// inside its own yard. A solid block of construction buries its inner
    /// towers where no attacker can ever reach them, and a defence that
    /// cannot die makes a war that cannot end.</summary>
    bool Spaced(StructureType t, int x, int y) {
        int fw = t.FootprintW();
        int fh = t.FootprintH();
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Kind() != ObjKind.Structure() || o.IsDead()) { continue; }
            StructureType ot = this.TypeOf(o);
            int ox = o.X();
            int oy = o.Y();
            int ow = ot.FootprintW();
            int oh = ot.FootprintH();
            // Cardinal adjacency: the horizontal gap is at most nil while the
            // rows overlap, or the vertical gap is at most nil while the
            // columns overlap. Diagonally touching corners still leave a
            // walkable way around, so those are allowed.
            if (x <= ox + ow && ox <= x + fw && y < oy + oh && oy < y + fh) {
                return false;
            }
            if (y <= oy + oh && oy <= y + fh && x < ox + ow && ox < x + fw) {
                return false;
            }
        }
        return true;
    }

    bool AiPlaceSpot(int side, StructureType t, List<int> outXy) {
        // Anchors around every own building, wide enough for the corridor:
        // a spaced fit is taken on sight; the first tight fit is remembered
        // as a fallback for maps too cramped for streets.
        int fbX = 0 - 1;
        int fbY = 0 - 1;
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Side() != side || o.Kind() != ObjKind.Structure()) { continue; }
            StructureType ot = this.TypeOf(o);
            for (int dy = 0 - t.FootprintH() - 1; dy <= ot.FootprintH() + 1; dy = dy + 1) {
                for (int dx = 0 - t.FootprintW() - 1; dx <= ot.FootprintW() + 1; dx = dx + 1) {
                    int ax = o.X() + dx;
                    int ay = o.Y() + dy;
                    if (!this.FlatFit(t, ax, ay)) { continue; }
                    if (this.Spaced(t, ax, ay)) {
                        outXy.Add(ax);
                        outXy.Add(ay);
                        return true;
                    }
                    if (fbX < 0) { fbX = ax; fbY = ay; }
                }
            }
        }
        for (int y = 0; y < this.height; y = y + 1) {
            for (int x = 0; x < this.width; x = x + 1) {
                if (!this.FlatFit(t, x, y)) { continue; }
                if (this.Spaced(t, x, y)) {
                    outXy.Add(x);
                    outXy.Add(y);
                    return true;
                }
                if (fbX < 0) { fbX = x; fbY = y; }
            }
        }
        if (fbX >= 0) {
            outXy.Add(fbX);
            outXy.Add(fbY);
            return true;
        }
        return false;
    }

    /// <summary>Finds a flat anchor so a yard footprint covers (wx, wy): the
    /// waypoint the base is meant to occupy. The offsets are tried centred
    /// first, then peeled outward, so a waypoint that sits on a cliff still
    /// lands the base as close to it as the terrain allows. When nothing near
    /// fits, the whole map is scanned for the flat area nearest to the
    /// waypoint. Writes the anchor to outXy; false only when the map has no
    /// flat 4x3 area at all.</summary>
    bool YardAnchor(int side, int wx, int wy, List<int> outXy) {
        StructureType yard = this.catalog.TypeFor(this, side, 0);
        if (yard == null) { return false; }
        for (int dy = 0; dy < yard.FootprintH(); dy = dy + 1) {
            for (int dx = 0; dx < yard.FootprintW(); dx = dx + 1) {
                if (this.FlatFit(yard, wx - dx, wy - dy)) {
                    outXy.Add(wx - dx);
                    outXy.Add(wy - dy);
                    return true;
                }
            }
        }
        int bestX = -1;
        int bestY = -1;
        int bestD = -1;
        for (int y = 0; y < this.height; y = y + 1) {
            for (int x = 0; x < this.width; x = x + 1) {
                if (!this.FlatFit(yard, x, y)) { continue; }
                int dx = x - wx;
                if (dx < 0) { dx = 0 - dx; }
                int dy = y - wy;
                if (dy < 0) { dy = 0 - dy; }
                if (bestD < 0 || dx + dy < bestD) { bestD = dx + dy; bestX = x; bestY = y; }
            }
        }
        if (bestX < 0) { return false; }
        outXy.Add(bestX);
        outXy.Add(bestY);
        return true;
    }

    /// <summary>Drops a side's starter base -- construction yard, power plant
    /// and a guard unit -- with the yard anchored at (ax, ay). Returns the
    /// yard's object index, or -1 when the anchor cannot be used.</summary>
    int PlaceBaseAt(int side, int ax, int ay) {
        StructureType yard = this.catalog.TypeFor(this, side, 0);
        if (yard == null) { return -1; }
        if (!this.FlatFit(yard, ax, ay)) { return -1; }
        int yardIdx = this.PlaceStructure(side, 0, ax, ay);
        if (yardIdx < 0) { return -1; }
        // Power plant beside the yard, trying each side in turn.
        StructureType power = this.catalog.TypeFor(this, side, 1);
        if (power != null) {
            int px = ax;
            int py = ay;
            if (this.FlatFit(power, ax - power.FootprintW(), ay)) {
                px = ax - power.FootprintW(); py = ay;
            } else if (this.FlatFit(power, ax + yard.FootprintW(), ay)) {
                px = ax + yard.FootprintW(); py = ay;
            } else if (this.FlatFit(power, ax, ay - power.FootprintH())) {
                px = ax; py = ay - power.FootprintH();
            } else if (this.FlatFit(power, ax, ay + yard.FootprintH())) {
                px = ax; py = ay + yard.FootprintH();
            } else {
                px = -1;
            }
            if (px >= 0) { this.PlaceStructure(side, 1, px, py); }
        }
        // A guard infantry so the base is not empty even before the AI trains.
        if (yardIdx < this.objects.Count) {
            List<int> cell = new List<int>();
            this.FindSpawnCell(this.objects[yardIdx], cell);
            if (cell.Count >= 2) { this.SpawnUnit(side, 0, cell[0], cell[1]); }
        }
        return yardIdx;
    }

    /// <summary>Places a side's starter base so its yard covers the cell
    /// (wx, wy) -- the map's waypoint for that player. Returns the yard's
    /// object index, or -1 when no anchor fits anywhere.</summary>
    int PlaceBase(int side, int wx, int wy) {
        List<int> xy = new List<int>();
        if (!this.YardAnchor(side, wx, wy, xy)) { return -1; }
        return this.PlaceBaseAt(side, xy[0], xy[1]);
    }

    /// <summary>Spawns a unit of unitId on a free cell next to a structure,
    /// the way a finished unit walks out of a factory. Returns the new
    /// object's index, or -1 when every neighbour is taken.</summary>
    int SpawnNear(int structIdx, int unitId) {
        if (structIdx < 0 || structIdx >= this.objects.Count) { return -1; }
        List<int> cell = new List<int>();
        this.FindSpawnCell(this.objects[structIdx], cell);
        if (cell.Count < 2) { return -1; }
        return this.SpawnUnit(this.objects[structIdx].Side(), unitId,
                              cell[0], cell[1]);
    }

    /// <summary>Spawns a unit on the first free flat cell around a point on
    /// the ground, scanning ring by ring outwards. The opening squad forms up
    /// this way around its house's MCV -- a unit, not a building, so
    /// SpawnNear's footprint search does not apply.</summary>
    int SpawnNearCell(int side, int unitId, int x, int y) {
        return this.SpawnNearCellAvoid(side, unitId, x, y, 0, 0, 0, 0);
    }

    /// <summary>As above, but never on a cell inside a reserved rectangle.
    /// The opener reserves the footprint its MCV will unfold into: a soldier
    /// standing there would block the deploy, and in the original the yard
    /// simply appears around the vehicle. A zero-sized rectangle reserves
    /// nothing.</summary>
    int SpawnNearCellAvoid(int side, int unitId, int x, int y,
                           int rvX, int rvY, int rvW, int rvH) {
        for (int r = 1; r <= 8; r = r + 1) {
            for (int dy = -r; dy <= r; dy = dy + 1) {
                for (int dx = -r; dx <= r; dx = dx + 1) {
                    int adx = dx < 0 ? -dx : dx;
                    int ady = dy < 0 ? -dy : dy;
                    if (adx != r && ady != r) { continue; }
                    int cx = x + dx;
                    int cy = y + dy;
                    if (!this.InBounds(cx, cy)) { continue; }
                    if (rvW > 0 && cx >= rvX && cx < rvX + rvW
                     && cy >= rvY && cy < rvY + rvH) { continue; }
                    if (!this.IsGround(this.iso.At(cx, cy))) { continue; }
                    int u = this.SpawnUnit(side, unitId, cx, cy);
                    if (u >= 0) { return u; }
                }
            }
        }
        return -1;
    }

    /// <summary>Drops an enemy starter base at the far end of the map, used
    /// when the map has no second waypoint. The corner diagonal is tried
    /// first so the base sits opposite the player's start; if that line of
    /// cells is water or cliff, the whole map is scanned for the flat area
    /// with the largest x+y. Returns the number of objects placed, or -1
    /// when no anchor for the yard fits.</summary>
    int PlaceEnemyBase(int side) {
        StructureType yard = this.catalog.TypeFor(this, side, 0);
        if (yard == null) { return -1; }
        int ax = -1;
        int ay = -1;
        int wx = this.width - yard.FootprintW() - 2;
        int wy = this.height - yard.FootprintH() - 2;
        for (int d = 0; d <= this.width + this.height; d = d + 1) {
            int cx = wx - d;
            int cy = wy - d;
            if (cx < 0) { cx = 0; }
            if (cy < 0) { cy = 0; }
            if (this.FlatFit(yard, cx, cy)) { ax = cx; ay = cy; break; }
        }
        if (ax < 0) {
            // Fallback: the far corner is under water or a cliff on some maps,
            // so take the flat area furthest from the top-left start.
            for (int y = 0; y < this.height; y = y + 1) {
                for (int x = 0; x < this.width; x = x + 1) {
                    if (this.FlatFit(yard, x, y)) {
                        if (ax < 0 || x + y > ax + ay) { ax = x; ay = y; }
                    }
                }
            }
        }
        if (ax < 0) { return -1; }
        int before = this.objects.Count;
        this.PlaceBaseAt(side, ax, ay);
        return this.objects.Count - before;
    }

    // ---- selection -------------------------------------------------------

    /// <summary>Selects the first object under a cell, replacing any prior
    /// selection. Returns the new primary index, or -1 when nothing was
    /// there.</summary>
    int SelectAt(int x, int y) {
        List<int> hit = new List<int>();
        this.ObjectsAt(x, y, hit);
        this.ClearSelection();
        if (hit.Count > 0) {
            int idx = hit[0];
            this.selectedIndex = idx;
            this.selection.Add(idx);
            this.objects[idx].SetSelected(true);
        }
        return this.selectedIndex;
    }

    /// <summary>Adds the object under a cell to the current selection without
    /// clearing it (Shift-click). Returns its index, or -1 when nothing was
    /// there or it is already selected.</summary>
    int AddToSelection(int x, int y) {
        List<int> hit = new List<int>();
        this.ObjectsAt(x, y, hit);
        if (hit.Count == 0) { return -1; }
        int idx = hit[0];
        if (this.IsSelectedIdx(idx)) { return -1; }
        this.selection.Add(idx);
        this.objects[idx].SetSelected(true);
        return idx;
    }

    /// <summary>Selects every own unit whose cell lies inside the rectangle
    /// (x0,y0)-(x1,y1), inclusive, replacing any prior selection. Structures
    /// are only selected when their anchor lies in the box. Returns how many
    /// were selected.</summary>
    int SelectBox(int x0, int y0, int x1, int y1, int side) {
        int loX = x0 < x1 ? x0 : x1;
        int hiX = x0 > x1 ? x0 : x1;
        int loY = y0 < y1 ? y0 : y1;
        int hiY = y0 > y1 ? y0 : y1;
        this.ClearSelection();
        int n = 0;
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Side() != side || o.IsDead()) { continue; }
            if (o.Kind() != ObjKind.Unit()) { continue; }
            if (o.X() >= loX && o.X() <= hiX && o.Y() >= loY && o.Y() <= hiY) {
                if (this.selectedIndex < 0) {
                    this.selectedIndex = i;
                }
                this.selection.Add(i);
                o.SetSelected(true);
                n = n + 1;
            }
        }
        return n;
    }

    /// <summary>True when the object index is in the current selection.</summary>
    bool IsSelectedIdx(int idx) {
        for (int i = 0; i < this.selection.Count; i = i + 1) {
            if (this.selection[i] == idx) { return true; }
        }
        return false;
    }

    /// <summary>How many objects are selected.</summary>
    int SelectionCount() { return this.selection.Count; }

    /// <summary>The selected objects as references, for the squad system.
    /// The caller must not modify the returned list's contents.</summary>
    List<WorldObject> SelectedObjects() {
        List<WorldObject> outList = new List<WorldObject>();
        for (int i = 0; i < this.selection.Count; i = i + 1) {
            int idx = this.selection[i];
            if (idx >= 0 && idx < this.objects.Count) {
                outList.Add(this.objects[idx]);
            }
        }
        return outList;
    }

    /// <summary>The current index of an object, or -1 when it is no longer in
    /// the world (destroyed and removed). Squads survive unit deaths by
    /// re-resolving references to indices on recall.</summary>
    int IndexOfObject(WorldObject o) {
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            if (this.objects[i] == o) { return i; }
        }
        return -1;
    }

    /// <summary>Adds a specific object to the selection if it is still alive,
    /// resolving its reference to an index. Used when recalling a squad.</summary>
    bool AddSelectionByObject(WorldObject o) {
        if (o == null || o.IsDead()) { return false; }
        int idx = this.IndexOfObject(o);
        if (idx < 0 || this.IsSelectedIdx(idx)) { return false; }
        if (this.selectedIndex < 0) { this.selectedIndex = idx; }
        this.selection.Add(idx);
        o.SetSelected(true);
        return true;
    }

    /// <summary>Clears the whole selection.</summary>
    void ClearSelection() {
        for (int i = 0; i < this.selection.Count; i = i + 1) {
            int idx = this.selection[i];
            if (idx >= 0 && idx < this.objects.Count) {
                this.objects[idx].SetSelected(false);
            }
        }
        this.selection = new List<int>();
        this.selectedIndex = -1;
    }

    WorldObject Selected() {
        if (this.selectedIndex < 0 || this.selectedIndex >= this.objects.Count) {
            return null;
        }
        return this.objects[this.selectedIndex];
    }

    /// <summary>Battle audio: the sink the app installed for this game, or
    /// null in the silent rule-only worlds.</summary>
    void SetSoundSink(SndEngine snd) { this.sndSink = snd; }
    SndEngine SoundSink() { return this.sndSink; }

    /// <summary>The selected object's voice lines, null when it has none
    /// (nothing selected, a foreign house, or an unarmed prop).</summary>
    TechnoVoices SelectedVoices() {
        WorldObject o = this.Selected();
        if (o == null) { return null; }
        if (o.Kind() == ObjKind.Unit()) {
            UnitType u = o.UnitType();
            if (u == null) { return null; }
            return u.Voices();
        }
        if (o.Kind() == ObjKind.Structure()) {
            StructureType st = this.TypeOf(o);
            if (st == null) { return null; }
            return st.Voices();
        }
        return null;
    }

    /// <summary>The player's order acknowledgment from the selected unit --
    /// the reference's SoundHandler.handleOrderPushed: VoiceAttack on an
    /// attack order, VoiceMove on a move, one per 250ms feedback window.</summary>
    void PlayOrderFeedback(bool attack) {
        if (this.sndSink == null) { return; }
        TechnoVoices v = this.SelectedVoices();
        if (v == null) { return; }
        this.sndSink.PlayOrderVoice(v,
            attack ? SndEngine.FeedbackAttack() : SndEngine.FeedbackMove(),
            Window.GetTickMs());
    }

    /// <summary>The player's selection acknowledgment -- the reference's
    /// handleSelectionChangeEvent: VoiceSelect per newly selected own unit,
    /// sharing the order feedback's 250ms window.</summary>
    void PlaySelectFeedback() {
        if (this.sndSink == null) { return; }
        TechnoVoices v = this.SelectedVoices();
        if (v == null) { return; }
        this.sndSink.PlaySelectVoice(v, Window.GetTickMs());
    }

    // ---- SoundHandler 事件位 ----------------------------------------------
    // reference 的 handleObjectSpawn/BuildingPlace/ObjectDestroy/
    // InflictDamage/UnitDeployUndeploy 事件的世界侧落点。

    /// <summary>One positional world effect, the reference's
    /// worldSound.playEffect: the local player's unexplored ground mutes it
    /// unless the key is on the shipped no-shroud list (or Global, which
    /// ShroudedOut exempts). Null names silently skip.</summary>
    void SndEffect(string key, WorldObject at) {
        if (this.sndSink == null || key == null || key.Length == 0) { return; }
        MapShroud s = this.ShroudOf(this.sndSink.LocalSide());
        if (s != null && this.sndSink.ShroudedOut(key, at.X(), at.Y(), s)) {
            return;
        }
        this.sndSink.PlayEffect(key, at.X(), at.Y(), at.Side(), 1.0, 0.0);
    }

    /// <summary>The coordinate form for effects with no owning object --
    /// the storm's thunder, the nuke's descent. Same shroud gate as
    /// SndEffect.</summary>
    void SndEffectAt(string key, int x, int y, int side) {
        if (this.sndSink == null || key == null || key.Length == 0) { return; }
        MapShroud s = this.ShroudOf(this.sndSink.LocalSide());
        if (s != null && this.sndSink.ShroudedOut(key, x, y, s)) {
            return;
        }
        this.sndSink.PlayEffect(key, x, y, side, 1.0, 0.0);
    }

    /// <summary>A techno spawning: the rules CreateSound= at its cell
    /// (handleObjectSpawnSound). Structures place with the slam instead.</summary>
    void SndSpawnSound(WorldObject o) {
        if (this.sndSink == null || o.UnitType() == null) { return; }
        this.SndEffect(o.UnitType().CreateSound(), o);
    }

    /// <summary>A techno dying: the rules DieSound=, buildings falling back
    /// to the BuildingDieSound key, plus EVA_UnitLost for an own unit --
    /// the reference's handleObjectDestroySound. The looping weapon reports
    /// ride the follow mechanism, which retires them when the shooter's
    /// health hits zero.</summary>
    void SndDeathFeedback(WorldObject o) {
        if (this.sndSink == null) { return; }
        string die = null;
        if (o.Kind() == ObjKind.Unit() && o.UnitType() != null) {
            die = o.UnitType().DieSound();
        } else if (o.Kind() == ObjKind.Structure()) {
            StructureType t = this.TypeOf(o);
            if (t != null) {
                die = t.DieSound();
                if (die == null || die.Length == 0) { die = "BuildingDieSound"; }
            }
        }
        this.SndEffect(die, o);
        if (o.Kind() == ObjKind.Unit()) {
            this.sndSink.UnitLostFeedback(o.Side());
        }
    }

    /// <summary>A building crossing a damage condition, the reference's
    /// handleDamageSound: BuildingDamageSound when this hit dropped the
    /// health to or under the [AudioVisual] yellow/red percents from above.
    /// `dmgTaken` is the raw hit, before the health floor clamps it.</summary>
    void SndBuildingDamage(WorldObject o, int dmgTaken) {
        if (this.sndSink == null || dmgTaken <= 0) { return; }
        if (o.Kind() != ObjKind.Structure() || o.IsDead()) { return; }
        StructureType t = this.TypeOf(o);
        if (t == null) { return; }
        Rules r = this.Rules();
        if (SndEngine.DamageCross(o.Hp(), o.MaxHp(), dmgTaken,
                                  r.ConditionYellowPct(),
                                  r.ConditionRedPct())) {
            this.SndEffect("BuildingDamageSound", o);
        }
    }

    /// <summary>A crate resolving: sound for the resolved type at the crate
    /// cell (a failed grant degrades to money, so the money crate speaks),
    /// silent for a hostile pickup -- the reference's handleCratePickupSound.</summary>
    void SndCrateFeedback(int side, int x, int y, int crateType) {
        if (this.sndSink == null) { return; }
        this.sndSink.CratePickupFeedback(side, x, y, crateType, this.Rules());
    }

    /// <summary>The side of the currently selected object, or -1 when nothing
    /// is selected. Lets the controller refuse to command enemy units.</summary>
    int SelectedSide() {
        WorldObject o = this.Selected();
        if (o == null) { return -1; }
        return o.Side();
    }

    /// <summary>Details about the selected object for the info panel: name,
    /// health, and a couple of distinguishing lines. Returns an empty string
    /// when nothing is selected.</summary>
    string SelectedInfo() {
        WorldObject o = this.Selected();
        if (o == null) { return ""; }
        StringBuilder sb = new StringBuilder();
        if (o.Kind() == ObjKind.Structure()) {
            StructureType t = this.TypeOf(o);
            if (t == null) { return ""; }
            sb.Append(t.Label());
            sb.Append("  血量 " + Convert.ToString(o.Hp()) + "/"
                      + Convert.ToString(o.MaxHp()));
            if (t.Power() > 0) {
                sb.Append("  供电+" + Convert.ToString(t.Power()));
            } else if (t.Drain() > 0) {
                sb.Append("  耗电-" + Convert.ToString(t.Drain()));
            }
            if (t.Produces() != null) {
                sb.Append("  可训练");
            }
            if (o.UnderConstruction(t.BuildTime())) {
                sb.Append("  (建造中)");
            }
            if (o.Repairing()) {
                sb.Append("  (修理中)");
            }
        } else {
            UnitType u = o.UnitType();
            if (u == null) { return ""; }
            sb.Append(u.Label());
            sb.Append("  血量 " + Convert.ToString(o.Hp()) + "/"
                      + Convert.ToString(o.MaxHp()));
            if (u.Damage() > 0) {
                sb.Append("  攻击 " + Convert.ToString(u.Damage())
                          + "  射程 " + Convert.ToString(u.Range()));
            } else {
                sb.Append("  (无攻击)");
            }
            if (u.Amphibious()) { sb.Append("  两栖"); }
        }
        if (o.Side() == Side2.Neutral()) { sb.Append("  [中立]"); }
        else if (o.Side() == Side2.Soviet()) { sb.Append("  [苏联]"); }
        else if (o.Side() == Side2.Yuri()) { sb.Append("  [尤里]"); }
        else { sb.Append("  [盟军]"); }
        return sb.ToString();
    }

    // ---- projectiles --------------------------------------------------------

    /// <summary>Launches a round from the shooter at the target. The aim is
    /// locked to the target's cell at fire time (guided rounds keep tracking
    /// their mark); speed and guidance come from the weapon's projectile
    /// type, converted from the reference's lepton space -- one cell a tick
    /// at Speed=100, gravity in cells per tick squared.</summary>
    void SpawnProjectile(WorldObject shooter, WorldObject target, Weapon w) {
        ProjectileType pt = w.Proj();
        if (pt == null) { pt = this.Rules().DefaultProjectile(); }
        Projectile p = new Projectile();
        p.px = shooter.X();
        p.py = shooter.Y();
        p.pz = 0.0;
        p.sx = p.px;
        p.sy = p.py;
        p.ax = target.X();
        p.ay = target.Y();
        double dx = p.ax - p.px;
        double dy = p.ay - p.py;
        p.total = Math.Sqrt(dx * dx + dy * dy);
        if (p.total < 0.25) { p.total = 0.25; }
        p.dirX = dx / p.total;
        p.dirY = dy / p.total;
        double v = w.Speed() / 100.0;
        if (v > 1.0) { v = 1.0; }        // the reference caps at one tile/tick
        if (v < 0.05) { v = 0.05; }
        if (pt.Arcing()) {
            // Reference arc tuning: (1 + g/6)/2 of the gun's speed, and
            // long lobs speed up so the shell does not hang all day.
            double graw = this.Rules().gravity;
            v = v * (1.0 + graw / 6.0) / 2.0;
            if (p.total > 8.0) {
                v = v * (1.0 + (p.total / 8.0) * 0.5);
            }
        }
        p.maxSpeed = v;
        p.speed = v;
        p.weapon = w;
        p.type = pt;
        p.side = shooter.Side();
        p.shooter = this.IndexOfObject(shooter);
        p.target = this.IndexOfObject(target);
        p.dmgPermille = 1000;
        if (p.target < 0) {
            // The mark was lost between trigger and launch: the round flies
            // to the cell it was aimed at and bursts there.
            p.target = 0 - 1;
        }
        p.dmgPermille = 1000;
        if (shooter != null) {
            p.dmgPermille = this.FirepowerPermilleOf(shooter);
        }
        if (!pt.Homing()) {
            // Unguided rounds hold their fire-time course.
            p.target = 0 - 1;        }
        this.projectiles.Add(p);
    }

    /// <summary>Advances every round one tick and lands the ones that
    /// arrived. Order in the list never matters, so arrivals swap-remove.
    /// </summary>
    void TickProjectiles() {
        int i = 0;
        while (i < this.projectiles.Count) {
            Projectile p = this.projectiles[i];
            bool landed;
            if (p.type.Homing()) { landed = this.StepHoming(p); }
            else if (p.type.Arcing()) { landed = this.StepArcing(p); }
            else { landed = this.StepStraight(p); }
            p.ticks = p.ticks + 1;
            string tr = p.type.Trailer();
            if (tr.Length > 0) {
                p.trailerClock = p.trailerClock + 1;
                if (p.trailerClock >= p.type.TrailerDelay()) {
                    p.trailerClock = 0;
                    this.SpawnAnim(tr, p.px, p.py);
                }
            }
            if (p.ticks > 300) { landed = true; }
            if (landed) {
                this.DetonateProjectile(p);
                int last = this.projectiles.Count - 1;
                this.projectiles[i] = this.projectiles[last];
                this.projectiles.RemoveAt(last);
            } else {
                i = i + 1;
            }
        }
    }

    /// <summary>A wall on the round's current cell stops it: the round
    /// bursts on the wall, its aim snapped onto the wall cell so the
    /// detonation soaks the piece. Lobbed arcs fly over -- only the flat
    /// steppers call this.</summary>
    bool WallStops(Projectile p) {
        int cx = (int)Math.Round(p.px);
        int cy = (int)Math.Round(p.py);
        if (!this.IsWallCell(cx, cy)) { return false; }
        p.ax = cx;
        p.ay = cy;
        return true;
    }

    /// <summary>Straight flight: constant speed toward the locked aim. The
    /// reference snaps the last step onto a target that held still, which
    /// is what landing directly on the aim cell models.</summary>
    bool StepStraight(Projectile p) {
        double step = Math.Min(p.speed, p.total - p.flown);
        p.px = p.px + p.dirX * step;
        p.py = p.py + p.dirY * step;
        p.flown = p.flown + step;
        if (this.WallStops(p)) { return true; }
        return p.flown >= p.total;
    }

    /// <summary>Arcing flight: the same ground course, with the height the
    /// reference's ballistic formula gives -- a gravity dome
    /// (g/2v^2) * x * (D-x) over the straight course, in cells.</summary>
    bool StepArcing(Projectile p) {
        double step = Math.Min(p.speed, p.total - p.flown);
        p.px = p.px + p.dirX * step;
        p.py = p.py + p.dirY * step;
        p.flown = p.flown + step;
        double g = this.Rules().GravityCells();
        double v = Math.Max(p.speed, 0.05);
        p.pz = (g / (2.0 * v * v)) * p.flown * (p.total - p.flown);
        return p.flown >= p.total;
    }

    /// <summary>Guided flight: accelerate, steer ROT degrees a tick onto the
    /// mark's live cell, arrive when the remaining gap is under a tick's
    /// travel. A mark that dies mid-flight stops steering the round; it
    /// lands where it was headed.</summary>
    bool StepHoming(Projectile p) {
        WorldObject t = p.target >= 0 && p.target < this.objects.Count
                      ? this.objects[p.target] : null;
        if (t != null && t.IsDead()) { t = null; }
        double tx = t != null ? t.X() : p.ax;
        double ty = t != null ? t.Y() : p.ay;
        double dx = tx - p.px;
        double dy = ty - p.py;
        double dist = Math.Sqrt(dx * dx + dy * dy);
        if (dist <= p.speed) { return true; }
        // Steer the heading toward the mark: the reference turns
        // (ROT/256)*360 degrees a tick.
        double wantX = dist > 0.0001 ? dx / dist : p.dirX;
        double wantY = dist > 0.0001 ? dy / dist : p.dirY;
        double cross = p.dirX * wantY - p.dirY * wantX;
        double dot = p.dirX * wantX + p.dirY * wantY;
        double maxTurn = p.type.Rot() * 3.14159265358979 / 256.0;
        double cos = Math.Cos(maxTurn);
        double sin = Math.Sin(maxTurn);
        if (dot >= cos) {
            // The mark is inside this tick's turn budget: lock onto it.
            p.dirX = wantX;
            p.dirY = wantY;
        } else {
            // Rotate the full budget toward it (cross sign picks the side).
            if (cross < 0) { sin = 0 - sin; }
            p.dirX = p.dirX * cos - p.dirY * sin;
            p.dirY = p.dirX * sin + p.dirY * cos;
        }
        double nx = p.dirX * cos - p.dirY * sin;
        double ny = p.dirX * sin + p.dirY * cos;
        p.dirX = nx;
        p.dirY = ny;
        p.speed = Math.Min(p.maxSpeed,
                           p.speed + p.type.Acceleration() / 256.0);
        p.px = p.px + p.dirX * p.speed;
        p.py = p.py + p.dirY * p.speed;
        p.flown = p.flown + p.speed;
        // Walls only stop rounds that fly the ground line: a missile
        // chasing a flyer is above the wall line the whole way.
        WorldObject mark = p.target >= 0 && p.target < this.objects.Count
                         ? this.objects[p.target] : null;
        if ((mark == null || !mark.IsFlying()) && this.WallStops(p)) {
            return true;
        }
        return false;
    }

    /// <summary>The round lands: the warhead bites the mark (or the ground
    /// it was aimed at), and the impact art plays -- the warhead's own
    /// AnimList entry for the damage tier, or the procedural ring when the
    /// install carries no such sprite.</summary>
    void DetonateProjectile(Projectile p) {
        WorldObject t = p.target >= 0 && p.target < this.objects.Count
                      ? this.objects[p.target] : null;
        if (t != null && t.IsDead()) { t = null; }
        Weapon w = p.weapon;
        WorldObject shooter = p.shooter >= 0 && p.shooter < this.objects.Count
                            ? this.objects[p.shooter] : null;
        if (shooter != null && shooter.IsDead()) { shooter = null; }
        int gx = (int)Math.Round(p.ax);
        if (gx < 0) { gx = 0; }
        if (gx > this.width - 1) { gx = this.width - 1; }
        int gy = (int)Math.Round(p.ay);
        if (gy < 0) { gy = 0; }
        if (gy > this.height - 1) { gy = this.height - 1; }
        Warhead wh = w.Warhead();
        WorldObject hit = t;
        if (t != null) {
            this.ApplyShotSide(p.side, shooter, w, t, p.dmgPermille);
        } else {
            // Ground strike: whoever stands at the impact cell takes the
            // full bore -- that is where the round burst -- and the
            // neighbours the falloff splash, so an artillery miss still
            // punishes a crowd. The occupant lookup is what keeps
            // no-spread warheads (AP) from fizzling on the ground.
            int zero = this.OccupantAt(gx, gy);
            WorldObject direct = zero >= 0 ? this.objects[zero] : null;
            if (direct != null && (direct.Side() == p.side
             || direct.Side() == Side2.Neutral())) { direct = null; }
            hit = direct;
            if (direct != null) {
                int armor = this.ArmorOf(direct);
                int dmg = w.Damage() * p.dmgPermille / 1000
                    * wh.Verse(armor) / 100;
                this.SplashAround(p.side, wh, gx, gy, direct, dmg, shooter);
            } else {
                int dmg = w.Damage() * p.dmgPermille / 1000
                    * wh.Verse(4) / 100;
                // A wall on the burst cell soaks the round first: its own
                // armour class picks the verse (the shipped walls are
                // concrete), and WallTrait's linked damage spreads half to
                // the cardinal neighbours. The splash still spills past it.
                if (this.IsWallCell(gx, gy)) {
                    int warmor = this.Rules().OverlayArmor(
                        this.WallOvAt(gx, gy));
                    this.DamageWallAt(gx, gy,
                        w.Damage() * wh.Verse(warmor) / 100);
                }
                this.SplashAround(p.side, wh, gx, gy, null, dmg, shooter);
            }
        }
        // The impact art follows the reference exactly: a conventional
        // warhead that lands in water (missing everything, or hitting a
        // building, which does not sink) plays the combat-damage splash
        // list by damage tier; otherwise the warhead's own AnimList, and
        // a warhead with no list -- the tank shells' AP -- shows nothing
        // at all, as shipped.
        string anim = null;
        if (w.Damage() > 0 && wh.Conventional() && t == null
         && this.IsWater(this.iso.At(gx, gy))
         && (hit == null || hit.Kind() == ObjKind.Structure())) {
            int n = this.Rules().SplashCount();
            if (n > 0) {
                int idx = w.Damage() / 50;
                if (idx > n - 1) { idx = n - 1; }
                anim = this.Rules().SplashAt(idx);
            }
        }
        if (anim == null) { anim = this.PickWarheadAnim(w); }
        if (anim != null) { this.SpawnAnim(anim, p.ax, p.ay); }
        // The ground zone bite (Warhead.detonate -> AnimTerrainEffect): a
        // crater-bearing blast first tears up the tiberium it lands on,
        // then leaves its decal. The reference's other call here -- the
        // area-effect smudge -- is undefined at every shipped detonation
        // site, so the animation's own Crater=/Scorch= art is what drives
        // the pick, exactly as shipped. Water takes neither.
        if (anim != null && !this.IsWater(this.iso.At(gx, gy))) {
            this.DestroyOre(anim, gx, gy);
            this.SpawnSmudge(anim, gx, gy);
        }
    }

    /// <summary>The warhead's impact anim for the damage tier: the
    /// reference picks AnimList[damage/25] -- bigger bores bring bigger
    /// fireballs, in the order the rules list them.</summary>
    string PickWarheadAnim(Weapon w) {
        Warhead wh = w.Warhead();
        int n = wh.AnimCount();
        if (n == 0) { return null; }
        int idx = w.Damage() / 25;
        if (idx >= n) { idx = n - 1; }
        if (idx < 0) { idx = 0; }
        return wh.AnimAt(idx);
    }

    /// <summary>Spawns a one-shot anim on a cell. The frame count comes from
    /// the sprite header (probed once per name); false when the install
    /// carries no such SHP, so the caller can fall back.</summary>
    bool SpawnAnim(string name, double cx, double cy) {
        int frames = this.ProbeAnimFrames(name);
        if (frames <= 0) { return false; }
        FxAnim a = new FxAnim();
        a.name = name;
        a.px = cx;
        a.py = cy;
        a.frames = frames;
        this.anims.Add(a);
        return true;
    }

    /// <summary>Spawns a looping anim -- the damage fires, which cycle
    /// their frames until killed. Null when the install lacks the shape.
    /// </summary>
    FxAnim SpawnAnimLoop(string name, double cx, double cy) {
        int frames = this.ProbeAnimFrames(name);
        if (frames <= 0) { return null; }
        FxAnim a = new FxAnim();
        a.name = name;
        a.px = cx;
        a.py = cy;
        a.frames = frames;
        a.loop = true;
        this.anims.Add(a);
        return a;
    }

    int ProbeAnimFrames(string name) {
        for (int i = 0; i < this.animNames.Count; i = i + 1) {
            if (this.animNames[i] == name) { return this.animFrames[i]; }
        }
        int frames = 0 - 1;
        Theater th = this.theater;
        if (th != null && th.Vfs() != null) {
            List<int> len = new List<int>();
            len.Add(0);
            byte[] raw = th.Vfs().Read(name + ".SHP", len);
            if (len[0] > 0) {
                ShpImage shp = ShpImage.Parse(raw, len[0]);
                frames = shp.FrameCount();
            }
        }
        this.animNames.Add(name);
        this.animFrames.Add(frames);
        return frames;
    }

    /// <summary>A beam gun's ray, from firer to mark. Lasers hold for the
    /// weapon's LaserDuration; tesla and radiation beams flash briefly.
    /// </summary>
    void SpawnBeam(WorldObject shooter, WorldObject target, Weapon w) {
        FxBeam b = new FxBeam();
        b.x0 = shooter.X();
        b.y0 = shooter.Y();
        b.x1 = target.X();
        b.y1 = target.Y();
        int kind = 0;                       // laser red
        if (w.IsElectricBolt()) { kind = 1; }
        else if (w.IsRadBeam()) { kind = 2; }
        b.kind = kind;
        // Laser holds for its own duration; tesla and rad flash for the
        // reference's one second of logic time (15 ticks at the base rate).
        b.life = w.IsLaser() ? w.LaserDuration() : 15;
        b.age = 0;
        b.seed = (shooter.X() * 31 + shooter.Y() * 17
                  + this.beams.Count) * 0.371;
        this.beams.Add(b);
    }

    /// <summary>Sets the age of a live impact animation -- the selftest
    /// uses it to pose a shipped blast at its peak frame for a screenshot.
    /// </summary>
    void AnimTick(int i, int t) { this.anims[i].ticks = t; }

    void TickFx() {
        int i = 0;
        while (i < this.anims.Count) {
            FxAnim a = this.anims[i];
            if (a.dead) { this.anims.RemoveAt(i); continue; }
            a.ticks = a.ticks + 1;
            if (a.loop) {
                // Damage fires cycle: frame 0 follows the last frame.
                if (a.ticks >= a.frames * 2) { a.ticks = 0; }
                i = i + 1;
                continue;
            }
            if (a.once) {
                if (a.ticks < a.frames * 2) { i = i + 1; continue; }
                // The death sequence finished: morph into the corpse
                // anim (DEATH_A..F) when one is queued, else drop.
                if (a.then.Length > 0) {
                    int nf = this.ProbeAnimFrames(a.then);
                    if (nf > 0) {
                        a.name = a.then;
                        a.frames = nf;
                        a.unitShp = "";
                        a.then = "";
                        a.ticks = 0;
                        i = i + 1;
                        continue;
                    }
                }
                this.anims.RemoveAt(i);
                continue;
            }
            // One-shot: play every frame, hold the last briefly, drop.
            int life = a.frames * 2 + 4;
            if (a.ticks >= life) {
                this.anims.RemoveAt(i);
            } else {
                i = i + 1;
            }
        }
        i = 0;
        while (i < this.beams.Count) {
            FxBeam b = this.beams[i];
            b.life = b.life - 1;
            b.age = b.age + 1;
            if (b.life <= 0) { this.beams.RemoveAt(i); }
            else { i = i + 1; }
        }
    }

    /// <summary>Damage smoke, the reference's DamageSmokePlugin: every
    /// vehicle or structure under half health vents the shipped grey
    /// smoke column (SGRYSMK1) -- one puff every 8 ticks, each drifting
    /// slightly off the object's centre -- until 80s of game time or a
    /// repair ends it. Gated on [General] DamageParticleSystems.</summary>
    void TickDamageSmoke() {
        this.smokeClock = this.smokeClock + 1;
        if (this.smokeClock % 8 != 1) { return; }
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o == null) { continue; }
            // Infantry do not smoke; they have their own death anims.
            if (o.UnitType() != null
             && o.UnitType().ShpName().Length > 0) { continue; }
            if (o.MaxHp() <= 0) { continue; }
            bool damaged = o.Hp() * 2 < o.MaxHp();
            // The reference's Building fire state keys off
            // [AudioVisual] ConditionYellow, not the smoke plugin's
            // hardcoded half -- at 50 retail they agree, per-mod they may
            // not.
            bool fireHurt = o.Hp() * 100
                <= o.MaxHp() * this.Rules().ConditionYellowPct();
            // Structures also catch fire, the reference's Building fire
            // objects: one DamageFireTypes anim at each art-declared
            // DamageFireOffset spot, looping until the building repairs
            // or dies. The pick is the reference's random choice among
            // FIRE01..FIRE03, keyed off the clock here.
            if (o.Kind() == ObjKind.Structure()) {
                // The art's IdleAnim= loop runs whenever the structure
                // stands finished: it swaps to IdleAnimDamaged= while
                // damaged (keeping the healthy anim when no damaged art
                // shipped, like the reference) and stops on death. Only
                // BuiltTicks-done structures show it -- during the Buildup
                // rise the reference hides the idle.
                StructureType sti = this.TypeOf(o);
                string idleWant = "";
                if (sti != null && !o.IsDead()
                 && o.BuiltTicks() >= sti.BuildTime()) {
                    idleWant = this.Rules().IdleAnimName(sti.Reg());
                    if (idleWant.Length > 0 && fireHurt) {
                        string dn =
                            this.Rules().IdleAnimDamagedName(sti.Reg());
                        if (dn.Length > 0) { idleWant = dn; }
                    }
                }
                if (o.idleName == null || idleWant != o.idleName) {
                    if (o.idles != null) {
                        for (int f = 0; f < o.idles.Count; f = f + 1) {
                            o.idles[f].Kill();
                        }
                        o.idles.Clear();
                    }
                    o.idleName = idleWant;
                    if (idleWant.Length > 0) {
                        List<int> iofs =
                            this.Rules().IdleAnimOffsets(sti.Reg());
                        double ix = iofs.Count >= 2
                            ? iofs[0] / 256.0 : 0.0;
                        double iy = iofs.Count >= 2
                            ? iofs[1] / 256.0 : 0.0;
                        FxAnim ia = this.SpawnAnimLoop(idleWant,
                            o.X() + ix, o.Y() + iy);
                        if (ia != null) {
                            // A never-assigned List field has no backing
                            // list: Add must not be its first touch, so
                            // (re)seeding always hands the object a fresh
                            // list first.
                            o.idles = new List<FxAnim>();
                            o.idles.Add(ia);
                        }
                    }
                }
                if (!fireHurt || o.IsDead()) {
                    if (o.fires != null && o.fires.Count > 0) {
                        for (int f = 0; f < o.fires.Count; f = f + 1) {
                            o.fires[f].Kill();
                        }
                    }
                    o.fires = null;
                } else if (o.fires == null || o.fires.Count == 0) {
                    StructureType st = this.TypeOf(o);
                    List<string> fts = this.Rules().FireTypes();
                    if (st != null && fts.Count > 0) {
                        List<int> offs =
                            this.Rules().DamageFireOffsets(st.Reg());
                        if (offs.Count >= 2) {
                            string fn = fts[(this.smokeClock + i)
                                % fts.Count];
                            List<FxAnim> fl = new List<FxAnim>();
                            for (int f = 0; f + 1 < offs.Count; f = f + 2) {
                                FxAnim fa = this.SpawnAnimLoop(fn,
                                    o.X() + offs[f] / 256.0,
                                    o.Y() + offs[f + 1] / 256.0);
                                if (fa != null) { fl.Add(fa); }
                            }
                            if (fl.Count > 0) { o.fires = fl; }
                        }
                    }
                }
            }
            if (o.IsDead()) { continue; }
            if (!damaged) { o.smokeTicks = 0; continue; }
            // The reference's smoke gate is per object: only the technos
            // whose own rules section declares DamageParticleSystems vent
            // smoke, from the section's DamageSmokeOffset.
            List<string> dps = null;
            int sox = 0;
            int soy = 0;
            if (o.Kind() == ObjKind.Structure()) {
                StructureType stq = this.TypeOf(o);
                if (stq != null) {
                    BuildingDef bd =
                        this.Rules().BuildingDefNamed(stq.Reg());
                    if (bd != null) {
                        dps = bd.DamageParticles();
                        sox = bd.SmokeOffX();
                        soy = bd.SmokeOffY();
                    }
                }
            } else if (o.UnitType() != null) {
                UnitDef ud = this.Rules().UnitDefNamed(
                    o.UnitType().Reg());
                if (ud != null) {
                    dps = ud.DamageParticles();
                    sox = ud.SmokeOffX();
                    soy = ud.SmokeOffY();
                }
            }
            if (dps == null || dps.Count == 0) { continue; }
            if (o.smokeTicks >= 5000) { continue; }
            o.smokeTicks = o.smokeTicks + 8;
            double jx = ((this.smokeClock * 13 + i * 37) % 7 - 3) / 16.0;
            double jy = ((this.smokeClock * 17 + i * 29) % 7 - 3) / 16.0;
            this.SpawnAnim("SGRYSMK1", o.X() + sox / 256.0 + jx,
                           o.Y() + soy / 256.0 + jy);
        }
    }

    // ---- combat effects -----------------------------------------------------

    /// <summary>Muzzle flash at a cell: a brief bright dot on the shooter's
    /// position.</summary>
    void SpawnFlash(int x, int y) {
        this.effects.Add(0);
        this.effects.Add(x);
        this.effects.Add(y);
        this.effects.Add(3);
    }

    /// <summary>A kill: a longer-lived explosion ring at the victim's cell.</summary>
    void SpawnExplosion(int x, int y) {
        this.effects.Add(1);
        this.effects.Add(x);
        this.effects.Add(y);
        this.effects.Add(14);
    }

    /// <summary>How many effects are live, for the renderer.</summary>
    int EffectCount() { return this.effects.Count / 4; }

    /// <summary>Effect i's kind (0 flash, 1 explosion).</summary>
    int EffectKind(int i) { return this.effects[i * 4]; }

    int EffectX(int i) { return this.effects[i * 4 + 1]; }

    int EffectY(int i) { return this.effects[i * 4 + 2]; }

    int EffectLife(int i) { return this.effects[i * 4 + 3]; }

    // ---- projectile / fx accessors for the renderer -------------------------

    int ProjectileCount() { return this.projectiles.Count; }

    Projectile ProjectileAt(int i) { return this.projectiles[i]; }

    int AnimFxCount() { return this.anims.Count; }

    /// <summary>Looping anims live right now -- the damage fires.</summary>
    int LoopAnimCount() {
        int n = 0;
        for (int i = 0; i < this.anims.Count; i = i + 1) {
            if (this.anims[i].loop) { n = n + 1; }
        }
        return n;
    }

    FxAnim AnimFxAt(int i) { return this.anims[i]; }

    /// <summary>Structures that should be showing an IdleAnim loop right
    /// now -- finished, alive, and whose art ships the anim (with the
    /// damaged variant when hurt and one exists). The selftest pairs this
    /// with IdleLoopCount to prove every eligible structure stays covered.</summary>
    int IdleEligibleCount() {
        int n = 0;
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o == null || o.Kind() != ObjKind.Structure()
             || o.IsDead() || o.MaxHp() <= 0) { continue; }
            StructureType st = this.TypeOf(o);
            if (st == null || o.BuiltTicks() < st.BuildTime()) { continue; }
            string want = this.Rules().IdleAnimName(st.Reg());
            if (want.Length > 0
             && o.Hp() * 100 <= o.MaxHp()
                    * this.Rules().ConditionYellowPct()) {
                string dn = this.Rules().IdleAnimDamagedName(st.Reg());
                if (dn.Length > 0) { want = dn; }
            }
            // The anim must actually ship in this install (the reference
            // gates on the animation object existing) -- some art sections
            // name SHPs the player's mixes do not carry.
            if (want.Length > 0 && this.ProbeAnimFrames(want) > 0) {
                n = n + 1;
            }
        }
        return n;
    }

    /// <summary>Troopers currently suppressed (prone).</summary>
    int SuppressedCount() {
        int n = 0;
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o != null && !o.IsDead() && o.SuppTicks() > 0) {
                n = n + 1;
            }
        }
        return n;
    }

    /// <summary>Play-once death fx currently alive -- the infantry death
    /// sequences and the corpse anims they morph into.</summary>
    int OnceFxCount() {
        int n = 0;
        for (int i = 0; i < this.anims.Count; i = i + 1) {
            if (this.anims[i].once) { n = n + 1; }
        }
        return n;
    }
    /// <summary>Once-fx alive on one cell. The selftest's deaths probe
    /// counts only its own kills: a war map keeps generating unrelated
    /// deaths (an AI rush shooting a defender), and a global sample would
    /// catch a bystander's death sequence mid-play and blame the corpse
    /// lifecycle for it.</summary>
    int OnceFxCountAt(int x, int y) {
        int n = 0;
        for (int i = 0; i < this.anims.Count; i = i + 1) {
            FxAnim a = this.anims[i];
            if (a.once && (int)a.px == x && (int)a.py == y) { n = n + 1; }
        }
        return n;
    }

    /// <summary>Selftest diagnostic: every live once-fx as
    /// name@x,y:ticks/frames -- a death sequence is labelled by the unit's
    /// own SHP until the corpse morph renames it to the DeadBodies art.</summary>
    string OnceFxDump() {
        string s = "";
        for (int i = 0; i < this.anims.Count; i = i + 1) {
            FxAnim a = this.anims[i];
            if (!a.once) { continue; }
            string nm = a.name;
            if (nm.Length == 0) { nm = a.unitShp == null ? "" : a.unitShp; }
            s = s + nm + "@"
                + Convert.ToString((int)a.px) + ","
                + Convert.ToString((int)a.py)
                + ":" + Convert.ToString(a.ticks)
                + "/" + Convert.ToString(a.frames) + " ";
        }
        return s;
    }

    /// <summary>Idle loops actually live across all structures.</summary>
    int IdleLoopCount() {
        int n = 0;
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o == null || o.idles == null) { continue; }
            n = n + o.idles.Count;
        }
        return n;
    }

    int BeamCount() { return this.beams.Count; }

    FxBeam BeamAt(int i) { return this.beams[i]; }

    /// <summary>Ages every effect and drops the expired ones.</summary>
    void TickEffects() {
        int i = 0;
        while (i < this.effects.Count / 4) {
            int at = i * 4;
            this.effects[at + 3] = this.effects[at + 3] - 1;
            if (this.effects[at + 3] <= 0) {
                this.effects.RemoveAt(at);
                this.effects.RemoveAt(at);
                this.effects.RemoveAt(at);
                this.effects.RemoveAt(at);
            } else {
                i = i + 1;
            }
        }
    }

    // ---- movement --------------------------------------------------------

    /// <summary>The side of the selection's lead object -- the only side an
    /// order may command. A selection that mixes in enemies (shift-clicked
    /// for inspection) still moves only the commander's own units.</summary>
    int SelectionCommanderSide() {
        if (this.selection.Count == 0) { return -1; }
        int p = this.selection[0];
        if (p < 0 || p >= this.objects.Count) { return -1; }
        return this.objects[p].Side();
    }

    /// <summary>Orders every selected unit to move to a cell. The path is found
    /// over passable cells only, so it walks around buildings; a unit inside a
    /// structure's footprint cannot be reached and the order is ignored.
    /// Returns true when at least one unit accepted the order.</summary>
    bool OrderMove(int x, int y) {
        bool any = false;
        int count = 0;
        int commander = this.SelectionCommanderSide();
        for (int s = 0; s < this.selection.Count; s = s + 1) {
            int idx = this.selection[s];
            if (idx < 0 || idx >= this.objects.Count) { continue; }
            WorldObject sel = this.objects[idx];
            if (sel.Kind() != ObjKind.Unit()) { continue; }
            if (sel.Side() != commander) { continue; }   // never steer a foe
            // Spread a group out: each unit after the first targets a cell
            // a few steps away so they do not all pile onto one tile.
            int tx = x;
            int ty = y;
            if (count > 0) {
                int ring = (count + 3) / 4;
                int side = (count - 1) % 4;
                if (side == 0) { ty = y + ring; }
                else if (side == 1) { tx = x + ring; }
                else if (side == 2) { ty = y - ring; }
                else { tx = x - ring; }
            }
            if (!this.PassableForF(tx, ty, sel.Amphibious(),
                                   sel.IsFlying())) { continue; }
            List<int> px = new List<int>();
            List<int> py = new List<int>();
            if (!this.FindPathF(sel.X(), sel.Y(), tx, ty, px, py,
                                sel.Amphibious(), sel.IsFlying())) { continue; }
            sel.SetRoute(px, py);
            sel.ClearMoveAttack();
            any = true;
            count = count + 1;
        }
        return any;
    }

    /// <summary>Orders every selected unit to move-attack a cell: walk there,
    /// engaging any enemy found along the way (the classic A-move). Returns
    /// true when at least one unit accepted the order.</summary>
    bool OrderMoveAttack(int x, int y) {
        bool any = false;
        int count = 0;
        int commander = this.SelectionCommanderSide();
        for (int s = 0; s < this.selection.Count; s = s + 1) {
            int idx = this.selection[s];
            if (idx < 0 || idx >= this.objects.Count) { continue; }
            WorldObject sel = this.objects[idx];
            if (sel.Kind() != ObjKind.Unit()) { continue; }
            if (sel.Side() != commander) { continue; }   // never steer a foe
            int tx = x;
            int ty = y;
            if (count > 0) {
                int ring = (count + 3) / 4;
                int side = (count - 1) % 4;
                if (side == 0) { ty = y + ring; }
                else if (side == 1) { tx = x + ring; }
                else if (side == 2) { ty = y - ring; }
                else { tx = x - ring; }
            }
            if (!this.PassableForF(tx, ty, sel.Amphibious(),
                                   sel.IsFlying())) { continue; }
            List<int> px = new List<int>();
            List<int> py = new List<int>();
            if (!this.FindPathF(sel.X(), sel.Y(), tx, ty, px, py,
                                sel.Amphibious(), sel.IsFlying())) { continue; }
            sel.SetRoute(px, py);
            sel.SetMoveAttack(tx, ty);
            any = true;
            count = count + 1;
        }
        return any;
    }
    /// <summary>Steps the world one tick: specials thaw and bombs count down,
    /// every unit with a target fires through its warhead when in range,
    /// defence buildings shoot on their own, units walk their speed class and
    /// production structures advance their queues. Returns the triple (moved,
    /// fired, produced) as [moved, fired, produced], so a test can see
    /// combat, movement and production working side by side.</summary>
    // ---- 超级武器 -----------------------------------------------------------
    // 核弹发射井与天气控制机的世界侧:充能(建成+非低电压每 tick +1,
    // 零售 [NukeSpecial]/[LightningStormSpecial] RechargeTime=10 分钟 =
    // 9000 tick)、释放、核弹 75 tick 引信后的爆心结算,以及风暴在
    // LightningStormDuration 窗口内每 15 tick 一道闪电。
    // reference 的 SpecialWeaponTrait + NukeLightingFx + ion storm。

    /// <summary>The house's superweapon of `kind` (0 nuke, 1 storm) is
    /// ready: some finished silo has run its recharge to full.</summary>
    bool ReadySuper(int side, int kind) {
        int cap = this.Rules().SwRecharge();
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Side() != side || o.Kind() != ObjKind.Structure()
             || o.IsDead()) { continue; }
            StructureType t = this.TypeOf(o);
            if (t == null || t.SuperWeapon() != kind) { continue; }
            if (o.BuiltTicks() < t.BuildTime()) { continue; }
            if (o.SwCharge() >= cap) { return true; }
        }
        return false;
    }

    /// <summary>Fires the charged superweapon at a cell: spends the first
    /// full silo's charge and arms the strike -- the nuke gets a 75-tick
    /// fuse (the retail missile's flight time), the storm opens its
    /// LightningStormDuration window. Off-map cells clamp to the edge.</summary>
    bool FireSuper(int side, int kind, int gx, int gy) {
        int cap = this.Rules().SwRecharge();
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Side() != side || o.Kind() != ObjKind.Structure()
             || o.IsDead()) { continue; }
            StructureType t = this.TypeOf(o);
            if (t == null || t.SuperWeapon() != kind) { continue; }
            if (o.BuiltTicks() < t.BuildTime()) { continue; }
            if (o.SwCharge() < cap) { continue; }
            o.SetSwCharge(0);
            if (gx < 0) { gx = 0; }
            if (gy < 0) { gy = 0; }
            if (gx >= this.width) { gx = this.width - 1; }
            if (gy >= this.height) { gy = this.height - 1; }
            if (kind == 1) {
                this.storms.Add(SuperStorm.Create(side, gx, gy,
                                                  this.Rules().LightningDuration()));
                this.SndEffectAt("StormSound", gx, gy, side);
            } else {
                this.nukes.Add(SuperNuke.Create(side, gx, gy, 75));
                this.SndEffectAt("NukeDown", gx, gy, side);
            }
            return true;
        }
        return false;
    }

    /// <summary>The per-tick superweapon work: finished silos charge unless
    /// their house runs low power (the retail low-power stall), nuke fuses
    /// count down to detonation, storms drop a bolt on their fuse, and the
    /// flash lighting walks back to the map's own ambient.</summary>
    void TickSuperWeapons() {
        int cap = this.Rules().SwRecharge();
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Kind() != ObjKind.Structure() || o.IsDead()) { continue; }
            StructureType t = this.TypeOf(o);
            if (t == null || t.SuperWeapon() < 0) { continue; }
            if (o.BuiltTicks() < t.BuildTime()) { continue; }
            if (o.SwCharge() < cap && this.PowerBalance(o.Side()) < 0) { continue; }
            o.AdvanceSwCharge(cap);
        }
        for (int i = this.nukes.Count - 1; i >= 0; i = i - 1) {
            SuperNuke n = this.nukes[i];
            n.timer = n.timer - 1;
            if (n.timer <= 0) {
                this.DetonateNuke(n.gx, n.gy, n.side);
                this.nukes.RemoveAt(i);
            }
        }
        for (int i = this.storms.Count - 1; i >= 0; i = i - 1) {
            SuperStorm st = this.storms[i];
            st.ticks = st.ticks - 1;
            if (st.ticks <= 0) { this.storms.RemoveAt(i); continue; }
            st.fuse = st.fuse - 1;
            if (st.fuse <= 0) {
                st.fuse = 15;
                this.StrikeLightning(st);
            }
        }
        if (this.nukeFxOn && this.nukeFx != null) {
            List<int> res = new List<int>();
            res.Add(0);
            double ms = (this.worldTick - this.nukeFxStart) * 1000.0 / 15.0;
            if (this.nukeFx.UpdateNuke(ms, 1, res)) {
                this.nukeFx.SetRunning(false);
                this.lighting.ApplyAmbientOverride(null);
                this.nukeFxOn = false;
            }
        }
    }

    /// <summary>The strike's lighting flash: the effect seeds from the map's
    /// ambient as it stands right now (a night map flashes from dark, not
    /// from black) and holds the lighting override while it runs.</summary>
    void TriggerNukeFlash() {
        if (this.nukeFx == null || this.lighting == null) { return; }
        this.nukeFx.ReArm(0.0, this.lighting.MapLightingNow());
        this.lighting.ApplyAmbientOverride(this.nukeFx.Lighting());
        this.nukeFx.SetRunning(true);
        this.nukeFxOn = true;
        this.nukeFxStart = this.worldTick;
    }

    /// <summary>The nuke lands: flash, fireball and shock-ring art, then
    /// the payload -- retail [Nuke] Damage=1000 over CRNUKEWH's spread --
    /// and every wall in the blast circle razed. The blast answers to no
    /// flag: friends and neutrals inside the radius go down with the
    /// enemies, flying units pass above it.</summary>
    void DetonateNuke(int gx, int gy, int side) {
        this.TriggerNukeFlash();
        this.SpawnAnim("MININUKE", gx + 0.5, gy + 0.5);
        this.SpawnAnim("RING1", gx + 0.5, gy + 0.5);
        this.SndEffectAt("NukeDown", gx, gy, side);
        Warhead wh = this.Rules().WarheadNamed("CRNUKEWH");
        if (wh == null) { return; }
        this.SuperSplash(wh, gx, gy, 1000);
        int radius = wh.Spread() + 2;
        for (int dx = 0 - radius; dx <= radius; dx = dx + 1) {
            for (int dy = 0 - radius; dy <= radius; dy = dy + 1) {
                if (dx * dx + dy * dy > radius * radius) { continue; }
                this.DamageWallAt(gx + dx, gy + dy, 1000000);
            }
        }
    }

    /// <summary>The special-weapon splash: unlike the weapon splash it
    /// answers to no allegiance -- every house's ground objects inside the
    /// radius take the blast with SplashAround's linear falloff, flying
    /// units pass. The centre cell takes the damage whole.</summary>
    void SuperSplash(Warhead wh, int cx, int cy, int dmg) {
        int radius = wh.Spread() + 2;
        int half = this.Rules().SplashScale() > 0
            ? this.Rules().SplashScale() : 50;
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.IsDead() || o.IsFlying()) { continue; }
            int vx = o.X() - cx;
            if (vx < 0) { vx = 0 - vx; }
            int vy = o.Y() - cy;
            if (vy < 0) { vy = 0 - vy; }
            if (vx > radius || vy > radius) { continue; }
            int d = vx + vy;
            if (d > radius) { continue; }
            int damp = d == 0 ? dmg
                : dmg * (radius - d) / radius * half / 100;
            if (damp <= 0) { continue; }
            int pd = damp;
            if (this.IsTrooper(o) && o.SuppTicks() > 0) {
                pd = damp * this.Rules().ProneDamagePct() / 100;
            }
            pd = this.VictimArmorAdjust(o, pd);
            o.TakeDamageAs(pd, wh.InfDeath());
            this.SndBuildingDamage(o, pd);
        }
    }

    /// <summary>One storm bolt: a random cell within LightningCellSpread of
    /// the storm's mark takes the IonWH payload (retail LightningDamage=
    /// 250, same no-allegiance splash as the nuke), a bolt flashes down
    /// from the cell's upper-left sky, the thunder plays.</summary>
    void StrikeLightning(SuperStorm st) {
        int spread = this.Rules().LightningSpread();
        int lx = st.gx + this.WorldRand(2 * spread + 1) - spread;
        int ly = st.gy + this.WorldRand(2 * spread + 1) - spread;
        if (lx < 0) { lx = 0; }
        if (ly < 0) { ly = 0; }
        if (lx >= this.width) { lx = this.width - 1; }
        if (ly >= this.height) { ly = this.height - 1; }
        FxBeam b = new FxBeam();
        b.x0 = lx - 2;
        b.y0 = ly - 2;
        b.x1 = lx + 0.5;
        b.y1 = ly + 0.5;
        b.kind = 1;          // the electric bolt, tesla blue
        b.life = 15;
        b.age = 0;
        b.seed = (this.worldTick * 31 + st.side * 17 + this.beams.Count) * 0.371;
        this.beams.Add(b);
        Warhead wh = this.Rules().WarheadNamed("IonWH");
        if (wh != null) {
            this.SuperSplash(wh, lx, ly, this.Rules().LightningDamage());
        }
        this.SndEffectAt("LightningSounds", lx, ly, st.side);
    }

    List<int> Tick() {
        int moved = 0;
        int fired = 0;
        this.worldTick = this.worldTick + 1;
        // Blackouts count down even when everything else stands still.
        for (int s = 0; s < this.blackout.Count; s = s + 1) {
            if (this.blackout[s] > 0) { this.blackout[s] = this.blackout[s] - 1; }
        }
        // Frozen objects thaw; Ivan's bombs count down and detonate.
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Frozen() > 0) { o.SetFrozen(o.Frozen() - 1); }
            if (o.BombTimer() >= 0) {
                int bt = o.BombTimer();
                if (bt == 0) {
                    o.TakeDamage(this.Rules().BombDamage());
                    this.SpawnExplosion(o.X(), o.Y());
                    o.SetBombTimer(-1);
                } else {
                    o.SetBombTimer(bt - 1);
                }
            }
        }
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Kind() != ObjKind.Unit()) { continue; }
            // A chrono-frozen soldier neither shoots nor walks.
            if (o.Frozen() > 0) { continue; }
            // Move-attack: while walking toward the order's destination, the
            // unit keeps an eye out for enemies within its range plus a small
            // reach; the first one it spots becomes the target and it stands
            // to fire. On arrival the move-attack order is spent. The scan
            // itself is staggered across units and ticks -- the reference's
            // targeting runs on per-unit timers, not a same-tick sweep, and
            // N armed walkers sweeping every tick is what made big battles
            // quadratic.
            if (o.MoveAttacking() && this.Target(o) == null && o.HasRoute()
             && (this.worldTick + i) % 8 == 0) {
                int e = this.NearestEnemyInAir(o.X(), o.Y(), o.Side(),
                                               o.UnitType().Range() + 3,
                                               this.CanHitAir(o.UnitType()));
                if (e >= 0) {
                    this.AttackObject(i, this.objects[e]);
                }
            }
            // A spent move-attack: the route is gone (spent on arrival, or
            // cancelled by StopAttack) and nothing is targeted, so the flag
            // is stale. Clear it, or the guard stance below never fires --
            // the unit would idle with an order it can no longer follow.
            if (o.MoveAttacking() && !o.HasRoute() && this.Target(o) == null) {
                o.ClearMoveAttack();
            }
            WorldObject t = this.Target(o);
            // A mind-control bolt or an engineer's capture can flip a target
            // to the shooter's side between ticks; drop such stale orders.
            if (t != null && t.Side() == o.Side()) { o.StopAttack(); t = null; }
            // Guard stance: an idle soldier with a gun watches the ground
            // around it and engages anything hostile that strays close, so a
            // garrisoned base defends itself while the player looks
            // elsewhere. The response radius is wider than the weapon's
            // reach -- the soldier spots an intruder, walks to meet him and
            // opens up once in range. Units with orders -- a route or a
            // move-attack -- keep their focus instead. Same stagger as the
            // move-attack scan: unit i looks on ticks where (tick+i)%8==0,
            // so a hundred-strong idle army costs a dozen scans a tick, not
            // a hundred, and no soldier waits more than half a second to
            // react.
            if (t == null && !o.MoveAttacking() && !o.HasRoute()
             && o.UnitType().Primary() != null
             && (this.worldTick + i) % 8 == 0) {
                int e = this.NearestEnemyInAir(o.X(), o.Y(), o.Side(),
                                               o.UnitType().Range() + 4,
                                               this.CanHitAir(o.UnitType()));
                if (e >= 0) {
                    this.AttackObject(i, this.objects[e]);
                    t = this.objects[e];
                }
            }
            if (t != null) {
                if (this.InRange(o, t)) {
                    // Stand and fire: the unit stops walking while it has a
                    // reachable target, so it does not walk into melee.
                    o.SetRoute(null, null);
                    // A turreted vehicle slews its gun toward the target while
                    // the hull keeps its travel facing.
                    if (o.UnitType().TurretVxl() != null) {
                        o.TurnTurretToward(o.FacingToward(t.X(), t.Y()));
                    }
                    // A sitting-down or mid-packing man holds his fire --
                    // the reference's DeployerTrait fires only from the
                    // Deployed state, never during the transitions.
                    if (o.Deployed() || o.deposeTicks > 0) {
                        if (o.deposeTicks > 0) { continue; }
                    }
                    // Steady fire: reload ticks down each frame, and a shot
                    // lands when the counter reaches zero.
                    int r = o.Reload();
                    if (r <= 0) {
                        if (this.FireUnit(o, t)) {
                            fired = fired + 1;
                            // The firing pose: one pass through the art's
                            // fire block per shot (two ticks a frame, like
                            // every other sprite clock here) -- the
                            // emplacement shoots from DeployedFire, the
                            // standing man from FireUp.
                            if (o.Deployed()
                             && o.UnitType().HasDeployedFire()) {
                                o.SetFireTicks(
                                    o.UnitType().DeployedFireFrames() * 2);
                            } else if (o.UnitType().HasFire()) {
                                o.SetFireTicks(
                                    o.UnitType().FireFrames() * 2);
                            }
                        }
                    } else {
                        o.SetReload(r - 1);
                    }
                } else {
                    // Too far: walk toward the target. Movement happens in the
                    // second pass, so a fresh path is laid here. A building is
                    // reached when any footprint cell is reached -- the anchor
                    // can be ringed by the building's own footprint and
                    // neighbouring structures, which would strand the unit.
                    o.SetReload(0);
                    // Re-pathing is staggered like the target scans: an
                    // army arriving at its routes' ends must not throw a
                    // hundred full-map breadth-first searches at one tick.
                    // Unit i asks on (tick+i)%8, so the search volume per
                    // tick stays at the army size divided by eight.
                    if (!this.HasRoute(o)
                     && (this.worldTick + i) % 8 == 0) {
                        List<int> px = new List<int>();
                        List<int> py = new List<int>();
                        // A furball must not flood the whole map per search:
                        // combat repaths run with a pop budget and settle for
                        // the closest reachable cell when the budget runs
                        // out -- the army keeps flowing, and the next
                        // staggered turn refines the route.
                        this.pathPopCap = 6000;
                        bool routed = this.FindPathToF(o.X(), o.Y(), t,
                                                       px, py, o.Amphibious(),
                                                       o.IsFlying());
                        this.pathPopCap = 0;
                        if (routed) {
                            o.SetRoute(px, py);
                        } else if ((this.worldTick + i) % 40 == 0) {
                            // The ordered target cannot be reached -- a
                            // building sealed in by other structures has no
                            // free cell to stand on. Hunt the nearest enemy
                            // the unit CAN walk to instead of idling out the
                            // war. Throttled so a stuck army re-scans in
                            // staggered turns, not all on one tick.
                            this.pathPopCap = 6000;
                            int alt = this.NearestReachableEnemy(
                                o.X(), o.Y(), o.Side(), o.Amphibious());
                            this.pathPopCap = 0;
                            if (alt >= 0 && alt != o.TargetIndex()) {
                                this.AttackObject(i, this.objects[alt]);
                            }
                        }
                    }
                }
            } else {
                // No live target (never set, destroyed, or out of sight): the
                // turret drifts back to the hull facing, one step per turn.
                o.SetReload(0);
                if (o.UnitType().TurretVxl() != null
                 && o.TurretFacing() != o.Facing()) {
                    o.TurnTurretToward(o.Facing());
                }
            }
        }
        // Defence buildings fire at the nearest enemy within range on their
        // own, using the building's reload counter like a unit's. Powered
        // defences (tesla coils, laser turrets, flak cannons) go offline on a
        // low-power grid or a blackout; the pillbox has no such weakness.
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject b = this.objects[i];
            if (b.Kind() != ObjKind.Structure()) { continue; }
            StructureType bt = this.TypeOf(b);
            if (bt == null || !bt.HasWeapon()) { continue; }
            if (b.BuiltTicks() < bt.BuildTime()) { continue; }   // not built yet
            if (bt.Powered() && this.SideLowPower(b.Side())) {
                b.SetReload(0);
                continue;
            }
            // Keep a live target, or reacquire the nearest enemy in range.
            WorldObject tgt = this.Target(b);
            if (tgt != null && tgt.Side() == b.Side()) { b.StopAttack(); tgt = null; }
            if (tgt == null) {
                int e = this.NearestEnemyInAir(b.X(), b.Y(), b.Side(),
                                               bt.Range(),
                                               bt.Weapon().AntiAir());
                if (e >= 0) { b.SetTarget(e); tgt = this.objects[e]; }
            }
            if (tgt == null) { b.SetReload(0); continue; }
            int rr = b.Reload();
            if (rr <= 0) {
                this.FireWeapon(b, bt.Weapon(), tgt);
                // Buildings are not Trainable= in the shipped rules, so
                // their cooldown never carries a veteran ROF factor.
                b.SetReload(bt.Cooldown());
                fired = fired + 1;
            } else {
                b.SetReload(rr - 1);
            }
        }
        // Movement, the reference's ledger: each tick a unit banks its rules
        // Speed and every CELL_MOVE_COST (64) banked buys one cell along the
        // route. A Speed=4 rifleman advances a cell every 16 ticks, a
        // Speed=9 dog every 7 -- and each step still needs a free cell, so a
        // blocked unit waits while its bank keeps growing, exactly like the
        // original.
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Kind() != ObjKind.Unit()) { continue; }
            if (o.fireTicks > 0) { o.fireTicks = o.fireTicks - 1; }
            if (o.poseTicks > 0) { o.poseTicks = o.poseTicks - 1; }
            // The rocking settles, the reference's Vehicle.update: the
            // counter runs down and the request dies with it.
            if (o.rockTicks > 0) { o.SetRockTicks(o.RockTicks() - 1); }
            if (o.deposeTicks > 0) {
                o.deposeTicks = o.deposeTicks - 1;
                // The sit-down block ran out: the emplacement stands.
                if (o.deposeTicks <= 0 && o.deposeSeq == 0
                 && !o.Deployed()) {
                    o.SetDeployed(true);
                }
            }
            if (o.suppTicks > 0) {
                o.suppTicks = o.suppTicks - 1;
                if (o.suppTicks <= 0 && !o.IsDead()) {
                    // Back on his feet: the rise plays before the stand
                    // ring takes over again.
                    o.poseSeq = 1;
                    o.poseTicks = o.PoseBlockFrames(1) * 2;
                }
            }
            if (o.Frozen() > 0 || o.Deployed() || o.deposeTicks > 0
             || !o.HasRoute()) { continue; }
            // The ledger banks the boosted speed: the veteran FASTER factor
            // times the crate speed bonus (the reference's baseSpeed
            // product, minus the damaged-vehicle crawl still to migrate).
            // The factors multiply into one boost ratio in thousandths of
            // stock (1000 = unboosted) so the bank stays in stock units.
            int boost = this.VetSpeedPermille(o) * o.CrateSpeed() / 1000;
            if (boost < 1) { boost = 1; }
            int bank = o.MoveAccum() + o.UnitType().Speed() * boost;
            while (bank >= Rules.CellMoveCost() && o.HasRoute()) {
                bank = bank - Rules.CellMoveCost();
                int nx = o.StepCellX();
                int ny = o.StepCellY();
                if (nx < 0) { break; }
                // The step gate, the reference's obstacle pass: a cell held
                // by a unit stops the column, a wall stops it -- unless the
                // hull is a crusher, which rolls straight over a crushable
                // blocker (a wall it may flatten, an enemy it may run down)
                // instead of queueing behind it.
                // A flyer steps over everything: the ground's crowds,
                // walls and buildings are all beneath its flight line.
                bool flying = o.IsFlying();
                bool crushStep = !flying && this.CanCrushInto(o, nx, ny);
                if (!flying
                 && this.occupancy[this.CellSlot(nx, ny)] != 0
                 && !crushStep) { break; }
                if (!flying
                 && this.IsWallCell(nx, ny) && !crushStep) { break; }
                int oldX = o.X();
                int oldY = o.Y();
                if (!flying) {
                    this.occupancy[this.CellSlot(oldX, oldY)] = 0;
                }
                o.Advance();
                // Each cell step re-casts the sight circle: the reference's
                // tile-occupation change fires revealFrom per move.
                this.ShroudRevealObject(o);
                o.AdvanceAnim();
                int stepFacing = WorldObject.FacingOf(o.X() - oldX, o.Y() - oldY);
                o.SetFacing(stepFacing);
                // A travelling turreted vehicle's gun follows the hull only
                // while it has no target of its own to track.
                if (o.UnitType().TurretVxl() != null && o.TargetIndex() < 0) {
                    o.SetTurretFacing(stepFacing);
                }
                if (!flying) {
                    this.occupancy[this.CellSlot(o.X(), o.Y())] = i + 1;
                }
                // The hull is in the new cell: the crush pass runs before
                // the crate hook, the reference's onTileChange order.
                this.CrushOnCell(o, o.X(), o.Y());
                // A crate underfoot is consumed by the walker, the
                // reference's move hook into pickupCrate.
                this.PickupCrateAt(o);
                moved = moved + 1;
            }
            o.SetMoveAccum(bank);
        }
        // Harvesters run the mine-and-unload loop: mine the cell underfoot,
        // haul a full hold to the nearest own refinery, unload, repeat. The
        // fields regrow on the rules' GrowthRate cadence.
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Kind() != ObjKind.Unit()) { continue; }
            if (o.UnitType() == null
             || o.UnitType().Role() != UnitRole.Harvester()) { continue; }
            this.TickHarvester(o);
        }
        if (this.Rules().OreGrows()) {
            this.TickTiberiumGrowth();
        }
        // Production: every structure with a queue counts its head down and,
        // when one finishes, walks the new unit out onto a free neighbour. If
        // every neighbour is taken the finished unit waits at zero rather than
        // being lost, so a boxed-in factory still delivers eventually. Every
        // structure also advances its own construction progress.
        int produced = 0;
        // A side short of power (or blacked out) produces at half speed;
        // the per-house flags were cached once at the top of the tick.
        this.CacheLowPower();
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o.Kind() != ObjKind.Structure()) { continue; }
            // The structure-construction Ready flip, the reference's
            // handleProductionQueueUpdate on the Structures queue: the
            // player's own house hears EVA_ConstructionComplete once.
            StructureType bt = this.TypeOf(o);
            int prevBuilt = o.BuiltTicks();
            o.AdvanceBuilt();
            if (this.sndSink != null && bt != null
             && prevBuilt < bt.BuildTime()
             && o.BuiltTicks() >= bt.BuildTime()) {
                this.sndSink.StructureReadyFeedback(o.Side());
            }
            // The wrench: a repairing structure heals one RepairStep every
            // RepairRateTicks. The cost rides the same schedule: a full
            // patch is RepairPercent of the building's price, so every hp
            // healed bills that share of the price (a fractional credit
            // carries to the next step, rounding out exactly at full
            // health). The controller settles the money events, so the
            // world stays wallet-free; when the owner cannot pay, the
            // repair stalls -- Repairing() stays on, no progress -- like
            // being broke mid-repair in the original.
            if (o.Repairing() && o.Hp() < o.MaxHp()
             && this.worldTick >= o.repairAt) {
                StructureType rt = this.TypeOf(o);
                if (rt != null) {
                    int heal = this.Rules().RepairStep();
                    if (o.Hp() + heal > o.MaxHp()) { heal = o.MaxHp() - o.Hp(); }
                    // fullPrice * healedHp / maxHp, keeping the fraction:
                    // numerators accumulate in repairAt's sibling, carry.
                    int numer = rt.Cost() * this.Rules().RepairPercent() * heal;
                    int billNumer = numer + o.repairCarry;
                    int stepCost = billNumer / (o.MaxHp() * 100);
                    o.repairCarry = billNumer % (o.MaxHp() * 100);
                    if (stepCost > 0) { this.AddMoneyEvent(o.Side(), 0 - stepCost); }
                    o.SetHp(o.Hp() + heal);
                    // One wrench-patch chirp per step, the reference's
                    // per-step BuildingRepairedSound.
                    this.SndEffect("BuildingRepairedSound", o);
                    o.SetRepairAtTick(this.worldTick + this.Rules().RepairRateTicks());
                }
            }
            if (o.Repairing() && o.Hp() >= o.MaxHp()) { o.SetRepairing(false); }
            // A finished refinery delivers one free harvester, as the
            // shipped buildings always have -- the ore loop starts the
            // moment the refinery opens, without a manual click.
            if (bt != null && bt.IsRefinery()
             && o.BuiltTicks() == bt.BuildTime()) {
                int hid = this.units.HarvesterIdFor(this, o.Side());
                if (hid >= 0) {
                    UnitType hu = this.units.TypeFor(this, o.Side(), hid);
                    List<int> hcell = new List<int>();
                    this.FindSpawnCell(o, hcell);
                    if (hcell.Count >= 2 && hu != null) {
                        WorldObject h = WorldObject.CreateUnit(o.Side(), hid,
                            hcell[0], hcell[1], hu.Hp(), hu);
                        this.AddObject(h);
                        this.ShroudRevealObject(h);
                        // The free harvester completes a production too:
                        // spawn chirp and, for the player, Unit ready.
                        this.SndSpawnSound(h);
                        if (this.sndSink != null) {
                            this.sndSink.UnitReadyFeedback(h.Side());
                        }
                    }
                }
            }
            if (!o.HasProduction()) { continue; }
            if (this.SideLowPower(o.Side()) && this.worldTick % 2 == 0) {
                continue;   // every other tick
            }
            int left = o.ProdLeftAt(0);
            if (left > 0) { o.SetProdLeftAt(0, left - 1); continue; }
            int unitId = o.ProdUnitAt(0);
            List<int> cell = new List<int>();
            this.FindSpawnCell(o, cell);
            if (cell.Count < 2) { continue; }
            UnitType u = this.units.TypeFor(this, o.Side(), unitId);
            if (u == null) { continue; }
            WorldObject n = WorldObject.CreateUnit(o.Side(), unitId, cell[0],
                                                   cell[1], u.Hp(), u);
            this.AddObject(n);
            this.ShroudRevealObject(n);
            // Factory output opens rookie. The reference's production gate
            // is canProduceVeteran (a captured spy's veteran factory flag
            // or the country's VeteranInfantry= list) promoting to Veteran
            // -- never the Elite rank, and not the InitialVeteran rules
            // flag, which belongs to the opening squad. Neither country
            // lists nor veteran-factory spies are ported yet, so every
            // factory here stays a plain one.
            // The factory output: the spawn chirp (CreateSound=) and, for
            // the player's own house, the Unit ready announcement -- the
            // FactoryProduceUnit event.
            this.SndSpawnSound(n);
            if (this.sndSink != null) {
                this.sndSink.UnitReadyFeedback(n.Side());
            }
            o.PopProd();
            produced = produced + 1;
        }
        this.RemoveDead();
        this.TickProjectiles();
        this.TickEffects();
        this.TickFx();
        this.TickDamageSmoke();
        // The queued sight reveals apply once per logic tick, the
        // reference's MapShroudTrait.onTick -> shroud.update() cadence.
        if (this.shrouds != null) {
            for (int h = 0; h < this.shrouds.Count; h = h + 1) {
                this.shrouds[h].Update();
            }
        }
        // The crates age and repopulate behind the shroud flush, the
        // reference's CrateGeneratorTrait riding the same tick.
        this.TickCrates();
        // The map's ambient walks toward whatever a scenario asked for
        // (an ion storm darkening the map, a nuke flash), the reference's
        // MapLightingTrait.onTick.
        this.lighting.TickAmbient();
        // The superweapons: charging silos, falling nukes and raging storms.
        this.TickSuperWeapons();
        List<int> result = new List<int>();
        result.Add(moved);
        result.Add(fired);
        result.Add(produced);
        return result;
    }

    // ---- combat resolution ---------------------------------------------------

    /// <summary>The armour class a shot hits: the unit's for soldiers, the
    /// building's for structures. The warhead's verse for this class scales
    /// the damage.</summary>
    int ArmorOf(WorldObject t) {
        if (t.Kind() == ObjKind.Unit()) { return t.UnitType().ArmorClass(); }
        StructureType st = this.TypeOf(t);
        if (st == null) { return ArmorClass.Wood(); }
        return st.ArmorClass();
    }

    /// <summary>The gun a unit fires at this target: the secondary when its
    /// warhead hurts the target's armour more than the primary's (a tesla
    /// trooper's assault bolt against buildings, Tanya's sapper charge),
    /// otherwise the primary.</summary>
    /// <summary>Whether the archetype carries any gun that can reach the
    /// sky -- the acquisition gate for scans, before any target exists to
    /// pick a weapon against.</summary>
    bool CanHitAir(UnitType u) {
        if (u == null) { return false; }
        return (u.Primary() != null && u.Primary().AntiAir())
            || (u.Secondary() != null && u.Secondary().AntiAir());
    }

    Weapon PickWeapon(UnitType u, WorldObject t) {
        Weapon p = u.Primary();
        Weapon s = u.Secondary();
        // A flying mark can only be engaged by the AA gun, so the gate runs
        // before the single-gun early returns: a rifleman (no secondary)
        // aiming at a zeppelin would otherwise pick his rifle and dump
        // shots into the sky.
        if (t.IsFlying()) {
            if (p != null && p.AntiAir()) { return p; }
            if (s != null && s.AntiAir()) { return s; }
            return null;
        }
        if (p == null) { return s; }
        if (s == null) { return p; }
        int armor = this.ArmorOf(t);
        if (s.Warhead().Verse(armor) > p.Warhead().Verse(armor)) { return s; }
        return p;
    }

    /// <summary>A unit lets fly at a target it is in range of. Specialists
    /// act instead of shooting: an engineer captures the building he stands
    /// beside, a spy infiltrates it. Returns true when a shot (or an action)
    /// landed, for the fired counter.</summary>
    bool FireUnit(WorldObject o, WorldObject t) {
        UnitType u = o.UnitType();
        if (u.Role() == UnitRole.Engineer()) {
            if (t.Kind() != ObjKind.Structure() || t.Side() == o.Side()) {
                o.SetReload(20);
                return false;
            }
            this.EngineerCapture(o, t);
            return true;
        }
        if (u.Role() == UnitRole.Spy()) {
            if (t.Kind() != ObjKind.Structure() || t.Side() == o.Side()) {
                o.SetReload(20);
                return false;
            }
            this.SpyInfiltrate(o, t);
            return true;
        }
        Weapon w = this.PickWeapon(u, t);
        if (w == null) { o.SetReload(20); return false; }
        this.FireWeapon(o, w, t);
        // The veteran ROF factor multiplies the cooldown (the reference's
        // getRateOfFire), floored at one tick.
        int rof = w.Rof() * this.VetRofPermille(o) / 1000;
        o.SetReload(rof > 1 ? rof : 1);
        return true;
    }

    /// <summary>One trigger pull, shared by units and defence structures.
    /// Beam guns (prism, tesla, radiation) hit this tick -- the light is the
    /// shot. Everything else launches a round: the warhead lands when the
    /// projectile reaches its mark, so a distant target sees the shell
    /// coming, exactly like the reference's flight-time model.</summary>
    void FireWeapon(WorldObject shooter, Weapon w, WorldObject t) {
        if (this.sndSink != null) { this.sndSink.PlayReport(w, shooter); }
        if (w.IsBeamWeapon()) {
            this.ApplyShot(shooter, w, t);
            this.SpawnBeam(shooter, t, w);
        } else {
            this.SpawnProjectile(shooter, t, w);
        }
        this.SpawnFlash(shooter.X(), shooter.Y());
    }

    /// <summary>Lands one shot: the shooter's firepower package (the
    /// veteran FIREPOWER factor times the crate bonus) scales the base
    /// damage, then the special effects land -- a dog's bite kills infantry
    /// outright, a chrono beam freezes, Yuri's pulse converts, Ivan sticks
    /// a bomb.</summary>
    void ApplyShot(WorldObject shooter, Weapon w, WorldObject t) {
        this.ApplyShotSide(shooter.Side(), shooter, w, t,
                           this.FirepowerPermilleOf(shooter));
    }

    /// <summary>The shot-landing core. `side` rides separately from the
    /// shooter object because a projectile can outlive its firer: the round
    /// keeps the allegiance it was fired with even after the shooter is
    /// rubble, so splash still skips friends and mind control still flips.
    /// `dmgPermille` is the shooter's firepower package, captured at fire
    /// time so a round keeps its boost mid-flight like the reference's
    /// projectile-captured veteranDamageMult.</summary>
    void ApplyShotSide(int side, WorldObject shooter, Weapon w, WorldObject t,
                       int dmgPermille) {
        Warhead wh = w.Warhead();
        int armor = this.ArmorOf(t);
        int dmg = w.Damage() * dmgPermille / 1000 * wh.Verse(armor) / 100;
        if (wh.KillsInfantry() && t.Kind() == ObjKind.Unit()) {
            dmg = t.Hp();   // dogs take infantry down regardless of health
        }
        this.SplashAround(side, wh, t.X(), t.Y(), t, dmg, shooter);
        if (t.IsDead()) { return; }
        if (wh.Freeze() && t.Kind() == ObjKind.Unit()) {
            t.SetFrozen(this.Rules().FreezeTicks());
        }
        if (wh.MindControl() && t.Kind() == ObjKind.Unit()
         && !t.UnitType().MindImmune() && t.Side() != side) {
            t.SetSide(side);
            t.StopAttack();
        }
        if (wh.PlantsBomb() && t.BombTimer() < 0) {
            t.SetBombTimer(this.Rules().BombDelay());
        }
        // Retaliation: a soldier who takes a hit turns on whoever dealt it.
        // Explicit orders are kept -- only a unit without a target reacts --
        // and a mind-flip lands first, so a converted soldier never turns on
        // his new master. A round whose shooter died mid-flight cannot be
        // retaliated against.
        if (shooter != null && t.Kind() == ObjKind.Unit()
         && t.TargetIndex() < 0
         && t.UnitType().Primary() != null && side != t.Side()) {
            int sIdx = this.IndexOfObject(shooter);
            if (sIdx >= 0) { t.SetTarget(sIdx); }
        }
    }

    /// <summary>Lands a warhead at (cx,cy) around its target: the primary
    /// damage hits the target itself, and a warhead with CellSpread>0 hits
    /// every other object standing within that many cells. Splash falls off
    /// linearly to zero at the spread radius, scales by each victim's armour
    /// verse like a direct shot, and skips friends and neutrals -- the
    /// original punishes careless artillery, it does not friendly-fire a
    /// whole squad. Special effects stay direct-hit only.</summary>
    /// <summary>Whether the object is foot-soldier art (the infantry
    /// checks ride the unit archetype's SHP name, like the renderer).</summary>
    bool IsTrooper(WorldObject o) {
        return o.Kind() == ObjKind.Unit() && o.UnitType() != null
            && o.UnitType().ShpName().Length > 0;
    }

    /// <summary>The reference's suppression rule: a non-lethal warhead
    /// hit suppresses infantry that is standing idle or already down --
    /// moving troopers push through. Deployed and frozen men do not
    /// budge.</summary>
    void SuppressTrooper(WorldObject o) {
        if (o.IsDead() || o.Kind() != ObjKind.Unit()
         || o.UnitType() == null || o.UnitType().ShpName().Length == 0
         || !o.UnitType().HasProne() || o.Deployed() || o.Frozen() > 0
         || o.IsFlying()) {
            return;
        }
        if (!o.HasRoute() || o.SuppTicks() > 0) {
            o.SetSuppTicks(30);
        }
    }

    void SplashAround(int side, Warhead wh, int cx, int cy,
                      WorldObject t, int dmg, WorldObject shooter) {
        if (t != null) {
            int pd = dmg;
            if (this.IsTrooper(t) && t.SuppTicks() > 0) {
                pd = dmg * this.Rules().ProneDamagePct() / 100;
            }
            pd = this.VictimArmorAdjust(t, pd);
            t.TakeDamageAs(pd, wh.InfDeath());
            this.SndBuildingDamage(t, pd);
            if (t.IsDead()) { this.AwardKillXP(shooter, t); }
            this.SuppressTrooper(t);
        }
        if (wh.Spread() <= 0) { return; }
        int radius = wh.Spread() + 2;   // cells around the impact point
        for (int i = 0; i < this.objects.Count; i = i + 1) {
            WorldObject o = this.objects[i];
            if (o == t || o.IsDead() || o.Side() == side
             || o.Side() == Side2.Neutral()) { continue; }
            // A ground burst's shrapnel stays under the flight line: only
            // the direct hit (the `t` above) can be an aircraft.
            if (o.IsFlying()) { continue; }
            int vx = o.X() - cx;
            int vy = o.Y() - cy;
            if (vx < 0) { vx = 0 - vx; }
            if (vy < 0) { vy = 0 - vy; }
            if (vx > radius || vy > radius) { continue; }
            int d = vx + vy;
            if (d > radius) { continue; }
            int armor = this.ArmorOf(o);
            int half = this.Rules().SplashScale() > 0
                ? this.Rules().SplashScale() : 50;
            int scaled = dmg * half / 100;
            int damp = (radius - d) * scaled / radius;
            if (damp <= 0) { continue; }
            int pd = damp;
            if (this.IsTrooper(o) && o.SuppTicks() > 0) {
                pd = damp * this.Rules().ProneDamagePct() / 100;
            }
            pd = this.VictimArmorAdjust(o, pd);
            o.TakeDamageAs(pd, wh.InfDeath());
            this.SndBuildingDamage(o, pd);
            if (o.IsDead()) { this.AwardKillXP(shooter, o); }
            this.SuppressTrooper(o);
        }
    }

    /// <summary>An engineer takes the building he reached: it flips to his
    /// side with everything it has (a captured derrick keeps trickling
    /// credits for its new owner). Grabbing a neutral oil derrick also pays
    /// the capture bonus. The engineer is spent on the job.</summary>
    void EngineerCapture(WorldObject o, WorldObject t) {
        bool wasNeutral = t.Side() == Side2.Neutral();
        StructureType tt = this.TypeOf(t);
        // The invader's production is not inherited: its queue references the
        // old owner's roster ids.
        t.ClearProduction();
        t.SetSide(o.Side());
        if (wasNeutral && tt != null && tt.IsRefinery()) {
            this.AddMoneyEvent(o.Side(), this.Rules().OilCapture());
        }
        this.SpawnFlash(t.X(), t.Y());
        o.TakeDamage(o.Hp());
    }

    /// <summary>A spy slips into an enemy building: a refinery pays out half
    /// its owner's credits (the controller settles the books when it drains
    /// the event queue), a power plant blacks the grid out. The spy is spent
    /// on the job.</summary>
    void SpyInfiltrate(WorldObject o, WorldObject t) {
        StructureType tt = this.TypeOf(t);
        int enemy = t.Side();
        if (tt != null && tt.IsRefinery()) {
            this.AddStealEvent(o.Side(), enemy);
        } else if (tt != null && tt.Power() > 0) {
            this.SetBlackout(enemy, this.Rules().BlackoutTicks());
        }
        this.SpawnFlash(t.X(), t.Y());
        o.TakeDamage(o.Hp());
    }

    /// <summary>True when a unit can shoot a target: both are alive and the
    /// target is within the unit's range in cells. A building's distance is
    /// measured to its nearest footprint cell, so a unit firing from beside
    /// the far corner of a large structure counts as in range.</summary>
    bool InRange(WorldObject o, WorldObject t) {
        if (o.IsDead() || t.IsDead()) { return false; }
        return this.DistanceTo(o.X(), o.Y(), t) <= o.UnitType().Range();
    }

    int DistanceTo(int x, int y, WorldObject t) {
        if (t.Kind() != ObjKind.Structure()) {
            return this.Distance(x, y, t.X(), t.Y());
        }
        StructureType ft = this.TypeOf(t);
        int best = -1;
        for (int dy = 0; dy < ft.FootprintH(); dy = dy + 1) {
            for (int dx = 0; dx < ft.FootprintW(); dx = dx + 1) {
                int d = this.Distance(x, y, t.X() + dx, t.Y() + dy);
                if (best < 0 || d < best) { best = d; }
            }
        }
        return best;
    }

    int Distance(int ax, int ay, int bx, int by) {
        int dx = ax - bx; if (dx < 0) { dx = 0 - dx; }
        int dy = ay - by; if (dy < 0) { dy = 0 - dy; }
        return dx + dy;
    }

    bool HasRoute(WorldObject o) { return o.HasRoute(); }

    /// <summary>Clears destroyed objects: their occupancy (unit cell and
    /// structure footprint) is freed and the slots after them shift down, so
    /// object indices stay dense. A destroyed selection is cleared.</summary>
    /// <summary>An infantry death, the reference's onRemove dance: Gunfire
    /// plays the art's Die1 sequence and Explode Die2 -- once through the
    /// frames, then a random [AudioVisual] DeadBodies corpse anim
    /// (DEATH_A..F) -- while every other InfDeath plays its death anim
    /// (S_BANG34, FLAMEGUY, ELECTRO, ...) over the spot. With none shipped
    /// the trooper simply goes, exactly like the reference's missing-art
    /// bail-outs.</summary>
    void SpawnInfantryDeath(WorldObject o, int idx) {
        int death = o.InfDeath();
        UnitType ut = o.UnitType();
        if (death == 1 || death == 2) {
            bool d2 = death == 2;
            int start = d2 ? ut.Die2Start() : ut.Die1Start();
            int frames = d2 ? ut.Die2Frames() : ut.Die1Frames();
            bool has = d2 ? ut.HasDie2() : ut.HasDie1();
            if (!has || frames <= 0) { return; }
            string shp = ut.ShpName();
            if (ut.NewTheater() && this.Rules().AlternateArcticArt()
             && this.theater != null
             && this.theater.Name() == "SNOW") {
                int dot = shp.Length - 4;
                if (dot > 0) {
                    string alt = shp.Substring(0, dot) + "A"
                        + shp.Substring(dot);
                    if (this.ProbeAnimFrames(alt) > 0) { shp = alt; }
                }
            }
            FxAnim a = new FxAnim();
            a.unitShp = shp;
            a.unitSide = o.Side();
            a.seqStart = start;
            a.seqFrames = frames;
            a.seqMult = d2 ? ut.Die2Mult() : ut.Die1Mult();
            a.facing = o.Facing();
            a.px = o.X();
            a.py = o.Y();
            a.frames = frames;
            a.once = true;
            a.then = this.Rules().DeathBodyName(this.smokeClock + idx);
            this.anims.Add(a);
            return;
        }
        string an = this.Rules().DeathAnimName(death);
        if (an.Length > 0 && this.ProbeAnimFrames(an) > 0) {
            this.SpawnAnim(an, o.X(), o.Y());
        }
    }

    void RemoveDead() {
        int i = 0;
        while (i < this.objects.Count) {
            WorldObject o = this.objects[i];
            if (!o.IsDead()) { i = i + 1; continue; }
            // A dead lamp takes its pool off the street with it, the
            // reference's onObjectRemoved hook; without this the cells it
            // lit stay bright forever.
            this.ClearLampLights(o);
            this.SndDeathFeedback(o);
            // A trooper does not pop: the reference plays his death art
            // (sequence or anim) and leaves the corpse. A crushed one
            // leaves nothing at all -- the reference's renderer skips the
            // death sequence for DeathType.Crush, and InfDeathType.None
            // finds no death anim either.
            if (o.Kind() == ObjKind.Unit() && o.UnitType() != null
             && o.UnitType().ShpName().Length > 0
             && o.DeathType() != DeathType.Crush()) {
                this.SpawnInfantryDeath(o, i);
            } else if (o.DeathType() != DeathType.Crush()) {
                this.SpawnExplosion(o.X(), o.Y());
            }
            // Free the unit's cell or the structure's whole footprint. The
            // cell is only cleared when this object still holds it: a
            // crushed victim shares its tile with the hull that ran it
            // over, and the occupancy slot belongs to the crusher.
            if (o.Kind() == ObjKind.Structure()) {
                StructureType t = this.TypeOf(o);
                for (int dy = 0; dy < t.FootprintH(); dy = dy + 1) {
                    for (int dx = 0; dx < t.FootprintW(); dx = dx + 1) {
                        this.occupancy[this.CellSlot(o.X() + dx, o.Y() + dy)] = 0;
                    }
                }
            } else if (this.occupancy[this.CellSlot(o.X(), o.Y())] == i + 1) {
                this.occupancy[this.CellSlot(o.X(), o.Y())] = 0;
            }
            if (this.selectedIndex == i) {
                this.selectedIndex = -1;
            } else if (this.selectedIndex > i) {
                this.selectedIndex = this.selectedIndex - 1;
            }
            // Drop the removed index from the selection list and shift the
            // later ones down.
            int si = 0;
            while (si < this.selection.Count) {
                int sel = this.selection[si];
                if (sel == i) {
                    this.selection.RemoveAt(si);
                    continue;
                }
                if (sel > i) {
                    this.selection[si] = sel - 1;
                }
                si = si + 1;
            }
            if (this.selectedIndex < 0 && this.selection.Count > 0) {
                this.selectedIndex = this.selection[0];
            }
            // Point attackers away from the vacated slot: a target at `i` is
            // gone, and any target past it shifts down with the list. Without
            // this, a new object spawned at `i` would be shot at by mistake.
            // Flying rounds hold object indices too: a shot whose victim
            // just died falls to a ground strike at its locked aim cell, and
            // every later index shifts down with the list.
            for (int k = 0; k < this.projectiles.Count; k = k + 1) {
                Projectile p = this.projectiles[k];
                if (p.target == i) { p.target = 0 - 1; }
                else if (p.target > i) { p.target = p.target - 1; }
                if (p.shooter == i) { p.shooter = 0 - 1; }
                else if (p.shooter > i) { p.shooter = p.shooter - 1; }
            }
            for (int j = 0; j < this.objects.Count; j = j + 1) {
                WorldObject other = this.objects[j];
                int tj = other.TargetIndex();
                if (tj == i) { other.StopAttack(); }
                else if (tj > i) { other.SetTarget(tj - 1); }
            }
            this.objects.RemoveAt(i);
            // The grid stores index+1, and every object behind the removed
            // one slid up a slot: rewrite those entries or the next click
            // dereferences a stale index -- an off-by-one occupant, or a
            // segfault when the last object was the one removed.
            for (int c = 0; c < this.occupancy.Length; c = c + 1) {
                if (this.occupancy[c] > i + 1) {
                    this.occupancy[c] = this.occupancy[c] - 1;
                }
            }
        }
    }

    /// <summary>Breadth-first search from (sx,sy) to (tx,ty) over passable
    /// cells, writing the cell path (excluding the start) to px/py. Returns
    /// false when no route exists. The grid is a few thousand cells, so the
    /// visited marks are a flat byte array sized to the map.</summary>
    bool FindPath(int sx, int sy, int tx, int ty, List<int> px, List<int> py,
                  bool amphibious) {
        return this.FindPathF(sx, sy, tx, ty, px, py, amphibious, false);
    }

    /// <summary>The flying-aware form: a flyer's sweep ignores terrain and
    /// structures alike, so it plots a straight cardinal walk to the goal.</summary>
    bool FindPathF(int sx, int sy, int tx, int ty, List<int> px, List<int> py,
                   bool amphibious, bool flying) {
        List<int> gx = new List<int>();
        List<int> gy = new List<int>();
        gx.Add(tx);
        gy.Add(ty);
        return this.FindPathMultiF(sx, sy, gx, gy, px, py, amphibious, flying);
    }

    /// <summary>True when a ground unit can walk from (sx,sy) to (tx,ty).
    /// Used by the AI to decide whether the enemy base is reachable by land or
    /// only by an amphibious crossing.</summary>
    bool LandReachable(int sx, int sy, int tx, int ty) {
        List<int> px = new List<int>();
        List<int> py = new List<int>();
        return this.FindPath(sx, sy, tx, ty, px, py, false);
    }

    /// <summary>Path to a target object. A unit is reached when its own cell
    /// is reached; a structure when any cell of its footprint is reached --
    /// the anchor can be ringed by the building's own cells and neighbouring
    /// structures, which a single-goal search would never reach.</summary>
    bool FindPathTo(int sx, int sy, WorldObject target, List<int> px, List<int> py,
                    bool amphibious) {
        return this.FindPathToF(sx, sy, target, px, py, amphibious, false);
    }

    /// <summary>The flying-aware form of the target path.</summary>
    bool FindPathToF(int sx, int sy, WorldObject target, List<int> px,
                     List<int> py, bool amphibious, bool flying) {
        List<int> gx = new List<int>();
        List<int> gy = new List<int>();
        if (target.Kind() == ObjKind.Structure() && !flying) {
            StructureType t = this.TypeOf(target);
            for (int dy = 0; dy < t.FootprintH(); dy = dy + 1) {
                for (int dx = 0; dx < t.FootprintW(); dx = dx + 1) {
                    gx.Add(target.X() + dx);
                    gy.Add(target.Y() + dy);
                }
            }
        } else {
            gx.Add(target.X());
            gy.Add(target.Y());
        }
        return this.FindPathMultiF(sx, sy, gx, gy, px, py, amphibious, flying);
    }

    /// <summary>Breadth-first search from (sx,sy) to the nearest of several
    /// goal cells. A goal cell may be occupied -- a unit stands on its own
    /// cell and a building on its footprint -- so the walker stops on a free
    /// cell beside it and fires from there. Cardinal steps only; diagonals
    /// would let a path hug a wall in a way the square footprints do not
    /// represent.</summary>
    bool FindPathMulti(int sx, int sy, List<int> gx, List<int> gy,
                       List<int> px, List<int> py, bool amphibious) {
        return this.FindPathMultiF(sx, sy, gx, gy, px, py, amphibious, false);
    }

    /// <summary>The flying-aware core: with `flying` set the expansion uses
    /// PassableForRouteF, so terrain, walls and structures never bend the
    /// route.</summary>
    bool FindPathMultiF(int sx, int sy, List<int> gx, List<int> gy,
                        List<int> px, List<int> py, bool amphibious,
                        bool flying) {
        int cells = this.width * this.height;
        // Reused breadth-first scratch. Allocating a fresh visited map and
        // three queues per call -- and priming prev with one Add per cell --
        // made a charging army's re-pathing eat whole frames. A generation
        // stamp stands in for clearing: marks double per call (visited even,
        // goal odd) and always outrank the stale ones, so nothing needs to
        // be wiped until the byte wraps.
        if (this.pathSeen == null || this.pathSeen.Length < cells + 1) {
            this.pathSeen = new byte[cells + 1];
            this.pathPrev = new int[cells + 1];
            this.pathQx = new List<int>();
            this.pathQy = new List<int>();
            this.pathGen = 0;
        }
        int gen = this.pathGen + 1;
        if (gen > 100) {
            for (int i = 0; i < cells + 1; i = i + 1) { this.pathSeen[i] = 0; }
            gen = 1;
        }
        this.pathGen = gen;
        this.pathCalls = this.pathCalls + 1;
        byte[] seen = this.pathSeen;
        int[] prev = this.pathPrev;
        List<int> qx = this.pathQx;
        List<int> qy = this.pathQy;
        qx.Clear();
        qy.Clear();
        int vmark = gen * 2;
        int gmark = gen * 2 + 1;

        int startSlot = this.CellSlot(sx, sy);
        if (startSlot < 0) { return false; }
        seen[startSlot] = (byte)vmark;
        qx.Add(sx);
        qy.Add(sy);
        prev[startSlot] = startSlot;

        // Goals carry their own mark, distinct from the visited one, and are
        // never enqueued -- the walker's last step is the free cell beside a
        // goal, or the goal itself when it is passable.
        for (int g = 0; g < gx.Count; g = g + 1) {
            int gs = this.CellSlot(gx[g], gy[g]);
            if (gs == startSlot) { return true; }
            if (gs >= 0) { seen[gs] = (byte)gmark; }
        }

        // Open field charges do not need a flood: the monotone walk below
        // settles most of them in a straight stroke, so the queue only runs
        // when terrain or a crowd actually forces a detour.
        // A flyer's route is the straight monotone walk every time -- the
        // sky holds no detours -- so the flood below never runs for one.
        if (flying && gx.Count == 1) {
            if (this.MonotoneRouteF(sx, sy, gx[0], gy[0], true, px, py,
                                    amphibious, true)) {
                return true;
            }
            return this.MonotoneRouteF(sx, sy, gx[0], gy[0], false, px, py,
                                       amphibious, true);
        }
        if (gx.Count == 1
         && this.MonotoneRoute(sx, sy, gx[0], gy[0], true, px, py,
                               amphibious)) {
            return true;
        }
        if (gx.Count == 1
         && this.MonotoneRoute(sx, sy, gx[0], gy[0], false, px, py,
                               amphibious)) {
            return true;
        }
        int cap = this.pathPopCap;
        if (cap > 0) {
            this.pathBestSlot = 0 - 1;
            this.pathBestD = 0x7fffffff;
            this.pathGoalX = gx[0];
            this.pathGoalY = gy[0];
        }
        int head = 0;
        int goal = -1;
        while (head < qx.Count && (cap <= 0 || head < cap)) {
            int cx = qx[head];
            int cy = qy[head];
            head = head + 1;
            int cs = this.CellSlot(cx, cy);
            goal = this.StepGoalFrom(seen, prev, qx, qy, vmark, gmark,
                                     cx, cy, cx + 1, cy, cs, amphibious);
            if (goal >= 0) { break; }
            goal = this.StepGoalFrom(seen, prev, qx, qy, vmark, gmark,
                                     cx, cy, cx - 1, cy, cs, amphibious);
            if (goal >= 0) { break; }
            goal = this.StepGoalFrom(seen, prev, qx, qy, vmark, gmark,
                                     cx, cy, cx, cy + 1, cs, amphibious);
            if (goal >= 0) { break; }
            goal = this.StepGoalFrom(seen, prev, qx, qy, vmark, gmark,
                                     cx, cy, cx, cy - 1, cs, amphibious);
            if (goal >= 0) { break; }
        }
        if (goal < 0 && cap > 0 && this.pathBestSlot >= 0
         && this.pathBestSlot != startSlot) {
            // The flood hit its budget: route to the explored cell nearest
            // the goal instead of giving up, so a capped melee keeps an
            // army flowing toward the fight. The chain is intact -- the
            // best cell was visited this call.
            goal = this.pathBestSlot;
        }
        if (goal < 0) { return false; }

        // Reconstruct start -> goal. prev points at the previous cell, so
        // walk back from the goal and reverse. Only cells marked this call
        // are on the chain, so the reused prev needs no priming.
        List<int> rx = new List<int>();
        List<int> ry = new List<int>();
        int cur = goal;
        while (cur != startSlot) {
            rx.Add(cur % this.width);
            ry.Add(cur / this.width);
            cur = prev[cur];
            if (cur < 0) { return false; }
        }
        for (int i = rx.Count - 1; i >= 0; i = i - 1) {
            px.Add(rx[i]);
            py.Add(ry[i]);
        }
        return true;
    }

    /// <summary>Whether a ground unit may move from cell (ax,ay) to (bx,by).
    ///
    /// This is the check that was missing, and its absence is why a miner
    /// drove onto a cliff. `PassableForRoute` answers "may a unit BE here",
    /// which is a property of the destination alone. Movement needs "may a
    /// unit GO from here to there", which is a property of the pair.
    ///
    /// The rule, following the reference: a height change is legal only
    /// through a ramp. Concretely, a step is refused when
    ///
    ///   * either end is not ground for this unit (cliff face, wall, water
    ///     for a land unit), or
    ///   * the two ends sit at different elevations and neither end is a
    ///     ramp, or
    ///   * the destination is a cliff face -- the overhang art of a cliff
    ///     occupies the cell above its base, and a unit that steps there is
    ///     drawn inside the rock.
    ///
    /// Elevation is compared as the map's own level byte, the same field the
    /// editor writes for raised terrain. A ramp's two ends differ by a whole
    /// step and are both flagged, so a ramp connects its top and bottom and
    /// nothing else does.</summary>
    bool CanStep(int ax, int ay, int bx, int by, bool amphibious) {
        if (!this.InBounds(ax, ay) || !this.InBounds(bx, by)) { return false; }
        // A diagonal step must not cut a corner between two blocked cells:
        // the unit would pass through the shared vertex of two cliff faces.
        int dx = bx - ax;
        int dy = by - ay;
        if (dx != 0 && dy != 0) {
            if (!this.PassableForRoute(ax + dx, ay, amphibious)) {
                return false;
            }
            if (!this.PassableForRoute(ax, ay + dy, amphibious)) {
                return false;
            }
        }
        if (!this.PassableForRoute(bx, by, amphibious)) { return false; }
        IsoTile a = this.iso.At(ax, ay);
        IsoTile b = this.iso.At(bx, by);
        if (a == null || b == null) { return false; }

        // A cliff face is never enterable, whatever its footprint says.
        LandType lb = this.CellLand(b);
        if (lb != null && lb.IsCliffClass()) { return false; }

        // Amphibious units ignore the elevation rule: a hovercraft climbs
        // the shore in the original, and the reference exempts it the same
        // way (it has no ramp requirement on the water/land boundary).
        if (amphibious) { return true; }

        if (a.Level() == b.Level()) { return true; }
        // A height change: legal only when a ramp is involved. The ramp may
        // be at either end -- maps flag the graded cell, and which end of a
        // two-cell ramp carries the flag varies by tile set.
        if (this.CellRamp(a) != 0 || this.CellRamp(b) != 0) { return true; }
        LandType la = this.CellLand(a);
        if (la != null && la.IsRoughClass()) {
            // Rough ground is the game's natural slope; the reference lets
            // units traverse it without a ramp tile.
            return true;
        }
        return false;
    }

    /// <summary>Looks at the cell (nx,ny) from the expanding cell (fromSlot).
    /// When it is a goal, links it to fromSlot and returns its slot so the
    /// search can stop. When it is unvisited and passable, enqueues it.
    /// Returns -1 when nothing happened.</summary>
    int StepGoal(byte[] seen, List<int> prev, List<int> qx, List<int> qy,
                 int nx, int ny, int fromSlot, bool amphibious) {
        int slot = this.CellSlot(nx, ny);
        if (slot < 0) { return -1; }
        if (seen[slot] == 2) {
            prev[slot] = fromSlot;
            return slot;
        }
        if (seen[slot] != 0) { return -1; }
        if (!this.PassableForRoute(nx, ny, amphibious)) { return -1; }
        seen[slot] = 1;
        prev[slot] = fromSlot;
        qx.Add(nx);
        qy.Add(ny);
        return -1;
    }

    /// <summary>StepGoal with the source cell supplied, so the expansion
    /// refuses illegal height changes. The route search calls this instead
    /// of the source-less form above; the two differ only in the CanStep
    /// gate, which is what keeps a column on its own level.</summary>
    int StepGoalFrom(byte[] seen, int[] prev, List<int> qx, List<int> qy,
                     int vmark, int gmark,
                     int fx, int fy, int nx, int ny, int fromSlot,
                     bool amphibious) {
        int slot = this.CellSlot(nx, ny);
        if (slot < 0) { return -1; }
        if (seen[slot] == gmark) {
            if (!this.CanStep(fx, fy, nx, ny, amphibious)) { return -1; }
            prev[slot] = fromSlot;
            return slot;
        }
        if (seen[slot] >= vmark) { return -1; }
        if (!this.CanStep(fx, fy, nx, ny, amphibious)) { return -1; }
        seen[slot] = (byte)vmark;
        prev[slot] = fromSlot;
        if (this.pathPopCap > 0) {
            int dgx = nx > this.pathGoalX ? nx - this.pathGoalX
                                          : this.pathGoalX - nx;
            int dgy = ny > this.pathGoalY ? ny - this.pathGoalY
                                          : this.pathGoalY - ny;
            int d = dgx + dgy;
            if (d < this.pathBestD) {
                this.pathBestD = d;
                this.pathBestSlot = slot;
            }
        }
        qx.Add(nx);
        qy.Add(ny);
        return -1;
    }

    /// <summary>The open-field route: walk monotonically toward the goal
    /// along one axis then the other, keeping every step to the same
    /// adjacency rules the search uses. True when the whole walk is legal
    /// right now -- a charge across open ground never needs the flood, and
    /// a route blocked anywhere falls through to the search unchanged.</summary>
    bool MonotoneRoute(int sx, int sy, int tx, int ty, bool xFirst,
                       List<int> px, List<int> py, bool amphibious) {
        return this.MonotoneRouteF(sx, sy, tx, ty, xFirst, px, py,
                                   amphibious, false);
    }

    /// <summary>The flying-aware form: the sky has no step gates, so the
    /// straight monotone walk always succeeds.</summary>
    bool MonotoneRouteF(int sx, int sy, int tx, int ty, bool xFirst,
                        List<int> px, List<int> py, bool amphibious,
                        bool flying) {
        int cx = sx;
        int cy = sy;
        px.Clear();
        py.Clear();
        while (cx != tx || cy != ty) {
            int nx = cx;
            int ny = cy;
            bool stepX = xFirst ? cx != tx : cy == ty;
            if (stepX) {
                nx = nx + (tx > cx ? 1 : 0 - 1);
            } else {
                ny = ny + (ty > cy ? 1 : 0 - 1);
            }
            if (!flying && !this.CanStep(cx, cy, nx, ny, amphibious)) {
                return false;
            }
            px.Add(nx);
            py.Add(ny);
            cx = nx;
            cy = ny;
        }
        return px.Count > 0;
    }
}

/// <summary>A round in flight, in cell coordinates (floats -- the visuals
/// interpolate between cells) plus an elevation for arcing shots. Carries
/// its weapon and allegiance so the warhead lands correctly even if the
/// firer dies while the shell is in the air.</summary>
class Projectile {
    double px;            // position, cells
    double py;
    double pz;            // height above ground, cells (arcing)
    double sx;            // launch cell
    double sy;
    double ax;            // locked aim cell
    double ay;
    double dirX;          // flight direction, unit vector in cell space
    double dirY;
    double speed;         // cells/tick now
    double maxSpeed;
    double total;         // launch -> aim distance at fire time
    double flown;         // distance travelled
    Weapon weapon;
    ProjectileType type;
    int shooter;          // object index, -1 once the firer is gone
    int side;             // the allegiance the round flies under
    int target;           // object index for guided rounds, -1 otherwise
    int ticks;
    int trailerClock;     // ticks since the last smoke puff
    // The firepower package captured at fire time, in per-mille (1000 =
    // stock): the veteran FIREPOWER factor times the shooter's crate
    // firepower bonus -- the reference's veteranDamageMult and
    // crateBonuses.firepower riding the projectile.
    int dmgPermille;

    double Px() { return this.px; }
    double Py() { return this.py; }
    double Pz() { return this.pz; }
    double DirX() { return this.dirX; }
    double DirY() { return this.dirY; }
    ProjectileType Type() { return this.type; }
    int SideOf() { return this.side; }
}

/// <summary>A one-shot impact animation playing on a cell: the warhead's
/// AnimList art, frame-stepped by the world and drawn from the install's
/// own SHP frames.</summary>
class FxAnim {
    double px;
    double py;
    string name;
    int frames;    // from the SHP header; 0 = art missing (never drawn)
    int ticks;
    bool loop;     // damage fires cycle their frames until killed
    bool dead;     // swept by TickFx
    bool once;     // play the frames once and go (death sequences)
    string unitShp;   // corpse mode: the fallen trooper's own SHP drawn
    int unitSide;     // through its owner's remapped palette, the death
    int seqStart;     // sequence's start/frames/mult picking the frames
    int seqFrames;
    int seqMult;
    int facing;
    string then;   // a follow-up anim to morph into (the DeadBodies art)

    double Px() { return this.px; }
    double Py() { return this.py; }
    string Name() { return this.name; }
    int Frames() { return this.frames; }
    int Frame() {
        int f = this.ticks / 2;
        if (f > this.frames - 1) { f = this.frames - 1; }
        return f;
    }
    void Kill() { this.dead = true; }
    string UnitShp() { return this.unitShp; }
    int UnitSide() { return this.unitSide; }
    int SeqStart() { return this.seqStart; }
    int SeqFrames() { return this.seqFrames; }
    int SeqMult() { return this.seqMult; }
    int Facing() { return this.facing; }
    bool Once() { return this.once; }
}

/// <summary>A beam gun's ray, in cell coordinates. kind: 0 laser (prism
/// red), 1 electric bolt (tesla blue), 2 rad beam (rad green).</summary>
class FxBeam {
    double x0;
    double y0;
    double x1;
    double y1;
    int kind;
    int life;
    int age;           // ticks since the bolt fired, drives the flicker
    double seed;       // per-bolt phase so strands never jitter alike

    double X0() { return this.x0; }
    double Y0() { return this.y0; }
    double X1() { return this.x1; }
    double Y1() { return this.y1; }
    int Kind() { return this.kind; }
    int Age() { return this.age; }
    double Seed() { return this.seed; }
}

/// <summary>A launched nuke in flight: owner, aim cell and the fuse ticks
/// left before DetonateNuke levels the block.</summary>
class SuperNuke {
    int gx;
    int gy;
    int side;
    int timer;

    static SuperNuke Create(int side, int gx, int gy, int timer) {
        SuperNuke n = new SuperNuke();
        n.side = side;
        n.gx = gx;
        n.gy = gy;
        n.timer = timer;
        return n;
    }
}

/// <summary>A raging lightning storm: owner, aim cell, the ticks left in
/// the LightningStormDuration window and the fuse to the next bolt
/// (15 ticks, the reference's strike interval).</summary>
class SuperStorm {
    int gx;
    int gy;
    int side;
    int ticks;
    int fuse;

    static SuperStorm Create(int side, int gx, int gy, int ticks) {
        SuperStorm st = new SuperStorm();
        st.side = side;
        st.gx = gx;
        st.gy = gy;
        st.ticks = ticks;
        st.fuse = 1;   // the first bolt lands right away
        return st;
    }
}
