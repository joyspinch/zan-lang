using System;
using System.Collections.Generic;

namespace Ra2.Game;

/// <summary>The interactive game: it owns the world and answers input. It is
/// kept pure state -- the window, camera and drawing live in the app layer --
/// so a test can drive a whole game here without a window.</summary>
class GameController {
    World world;
    int side;
    int money;
    // One wallet/skill/build-cursor per AI house (house id -> slot), plus
    // the roster of the AI houses this controller drives. The classic
    // one-enemy game is houses[1] with the rest of the arrays unused.
    List<int> aiHouses;
    int[] aiWallets;
    int[] aiDiffs;
    int[] aiBuildIdx;
    int building;        // buildId armed for placement, or -1
    bool moveAttack;     // A key armed: next map click is a move-attack order
    bool sellMode;       // sidebar 卖 armed: next own-structure click sells it
    bool repairMode;     // sidebar 修 armed: next own-structure click repairs
    bool shortGame;      // 快速游戏: wrecking the base ends it, units or no
    int tick;            // ticks since the game started
    int result;          // 0 playing, 1 player won, 2 player lost
    bool paused;
    bool dirty;
    // Squads: up to 10 numbered groups of selected units (Ctrl+number to save,
    // number to recall). Stored as object references so a unit that dies is
    // simply skipped on recall.
    List<List<WorldObject>> squads;

    static GameController Create(World world, int side) {
        return GameController.CreateWith(world, side,
                                         world.Rules().StartMoney(),
                                         Difficulty.Normal());
    }

    /// <summary>The skirmish setup's starting conditions: both houses open on
    /// the chosen credits, and the AI fights at the chosen skill. The skill
    /// scales the AI's trickle income and how often it makes build and train
    /// decisions -- the honest way to make 冷酷的敌人 brutal and 简单的敌人
    /// beatable.</summary>
    static GameController CreateWith(World world, int side, int credits,
                                     int aiDiff) {
        List<int> houses = new List<int>();
        houses.Add((side + 1) % Side2.Count());
        List<int> diffs = new List<int>();
        diffs.Add(aiDiff);
        return GameController.CreateMulti(world, side, houses, diffs, credits);
    }

    /// <summary>The multi-opponent form: each AI house gets its own wallet,
    /// skill and build-order cursor, all opening at the same credits. The
    /// world's faction table must already be set (World.SetFactions).</summary>
    static GameController CreateMulti(World world, int side, List<int> houses,
                                      List<int> diffs, int credits) {
        GameController g = new GameController();
        g.world = world;
        g.side = side;
        // The player's wallet opens at the skirmish screen's credits; from
        // then on money only enters through refineries, captured oil
        // derricks and a spy's theft.
        g.money = credits;
        g.aiHouses = new List<int>();
        g.aiWallets = new int[8];
        g.aiDiffs = new int[8];
        g.aiBuildIdx = new int[8];
        for (int i = 0; i < houses.Count && i < 7; i = i + 1) {
            int h = houses[i];
            if (h == side || h < 0 || h >= 8) { continue; }
            g.aiHouses.Add(h);
            g.aiWallets[h] = credits;
            g.aiDiffs[h] = i < diffs.Count ? diffs[i] : Difficulty.Normal();
        }
        g.tick = 0;
        g.result = 0;
        g.paused = false;
        g.building = -1;
        g.moveAttack = false;
        g.sellMode = false;
        g.repairMode = false;
        g.squads = new List<List<WorldObject>>();
        int sq = 0;
        while (sq < 10) { g.squads.Add(new List<WorldObject>()); sq = sq + 1; }
        g.dirty = true;
        return g;
    }

    World World() { return this.world; }
    int Side() { return this.side; }
    int Money() { return this.money; }
    // First AI house's wallet: kept for the sidebar's single-enemy line.
    int AiMoney() {
        return this.aiHouses.Count > 0
            ? this.aiWallets[this.aiHouses[0]] : 0;
    }

    // Every AI house's credits combined, the sidebar's 多方 opponent line.
    int AiMoneyTotal() {
        int sum = 0;
        for (int i = 0; i < this.aiHouses.Count; i = i + 1) {
            sum = sum + this.aiWallets[this.aiHouses[i]];
        }
        return sum;
    }
    int TickCount() { return this.tick; }
    /// <summary>0 while the game is on, 1 when the player destroyed the enemy
    /// base, 2 when the enemy destroyed the player's.</summary>
    int Result() { return this.result; }
    bool NeedsRedraw() { return this.dirty; }
    void ClearRedraw() { this.dirty = false; }
    int BuildingId() { return this.building; }
    bool SellModeArmed() { return this.sellMode; }
    bool RepairModeArmed() { return this.repairMode; }
    int Power() { return this.world.PowerBalance(this.side); }
    bool LowPower() { return this.Power() < 0; }
    string SelectedInfo() { return this.world.SelectedInfo(); }
    bool Paused() { return this.paused; }

    /// <summary>Toggles the game clock. While paused, ticks do not advance, so
    /// neither the AI nor production nor combat moves; the player can still
    /// scroll the camera.</summary>
    void TogglePause() {
        this.paused = !this.paused;
        this.dirty = true;
    }

    /// <summary>The setup screen's 快速游戏: with it on, razing every enemy
    /// structure wins outright; with it off, any surviving enemy units keep
    /// the fight going too.</summary>
    void SetShortGame(bool on) { this.shortGame = on; }

    /// <summary>Steps the game one tick regardless of pause -- the space key's
    /// single step for inspecting a frozen moment. The pause state is
    /// restored, so the clock stays stopped afterwards.</summary>
    void StepOnce() {
        bool was = this.paused;
        this.paused = false;
        this.Tick();
        this.paused = was;
        this.dirty = true;
    }

    /// <summary>Stores the current selection into squad slot `slot` (0-9),
    /// keyed by Ctrl+number.</summary>
    void SaveSquad(int slot) {
        if (slot < 0 || slot >= this.squads.Count) { return; }
        List<WorldObject> fresh = this.world.SelectedObjects();
        this.squads[slot] = fresh;
    }

    /// <summary>Recalls squad `slot` (0-9): selects its living units, skipping
    /// any that were destroyed since the group was saved. Returns how many
    /// were selected.</summary>
    int RecallSquad(int slot) {
        if (slot < 0 || slot >= this.squads.Count) { return 0; }
        List<WorldObject> sq = this.squads[slot];
        this.world.ClearSelection();
        int n = 0;
        for (int i = 0; i < sq.Count; i = i + 1) {
            if (this.world.AddSelectionByObject(sq[i])) { n = n + 1; }
        }
        this.dirty = true;
        return n;
    }

    /// <summary>Steps the game one tick: money events settle, refineries and
    /// derricks trickle, the AI plans, then the world moves, fights and
    /// produces, and the win/lose condition is checked. Returns how many
    /// units moved. No redraw vote here: moving units draw live over the
    /// terrain layer every frame, and the scene canvas only recomposites on
    /// camera moves, ore or smudge changes.</summary>
    int Tick() {
        if (this.paused) { return 0; }
        this.tick = this.tick + 1;
        this.DrainEvents();
        this.Economy();
        this.UpdateAi();
        List<int> r = this.world.Tick();
        this.CheckResult();
        return r[0];
    }

    // ---- economy -----------------------------------------------------------

    /// <summary>Applies the world's money events to the wallets: kind 1 is a
    /// grant or, with a negative amount, a debit (the repair wrench's per-
    /// step bill and the sell refund both ride this path); kind 2 is a spy
    /// theft where the victim's side is carried in the amount slot; kind 3
    /// is the free-MCV crate request, granted only if the wallet covers
    /// the side's starting base.</summary>
    void DrainEvents() {
        int n = this.world.EventCount();
        for (int i = 0; i < n; i = i + 1) {
            int kind = this.world.EventKindAt(i);
            int side = this.world.EventSideAt(i);
            int amount = this.world.EventAmountAt(i);
            if (kind == 1) {
                if (side == this.side) {
                    this.money = this.money + amount;
                    if (amount < 0 && this.money < 0) {
                        this.money = 0;   // a bill cannot drive the wallet under
                    }
                } else if (this.IsAiHouse(side)) {
                    this.aiWallets[side] = this.aiWallets[side] + amount;
                    if (amount < 0 && this.aiWallets[side] < 0) {
                        this.aiWallets[side] = 0;
                    }
                }
            } else if (kind == 2) {
                int victim = amount;
                int thief = side;
                int victimMoney = this.WalletOf(victim);
                int stolen = victimMoney / 2;
                this.TakeFromWallet(victim, stolen);
                this.GiveToWallet(thief, stolen);
            } else if (kind == 3) {
                // The crate layer's free-MCV branch: the wallet has to
                // cover what the side's starting base cost before the MCV
                // walks out of the crate. The reference gates the grant on
                // credits without spending them.
                int cx = amount / 1000;
                int cy = amount % 1000;
                if (this.WalletOf(side) >= this.world.StartingBaseCost(side)) {
                    UnitDef mcv = this.world.FindMcvDef(side);
                    if (mcv != null) {
                        int uid = this.world.Units().IdOfReg(this.world, side,
                                                             mcv.Reg());
                        if (uid >= 0) {
                            this.world.SpawnUnitNear(side, uid, cx, cy, 3);
                        }
                    }
                }
            }
        }
        if (n > 0) {
            this.world.ClearEvents();
            this.dirty = true;
        }
        // The crate layer reads the wallets through this mirror -- the
        // world itself owns no credits, so the controller lends it the
        // numbers once a tick.
        for (int s = 0; s < 8; s = s + 1) {
            if (s == this.side || this.IsAiHouse(s)) {
                this.world.SetCreditSnap(s, this.WalletOf(s));
            }
        }
    }

    // Wallet helpers: one place knows how the per-house wallets map to the
    // player's own credits. Neutral-side events (a captured derrick that
    // flips through a civil structure) land nowhere -- only houses have cash.
    bool IsAiHouse(int house) {
        return this.aiHouses != null && this.aiHouses.Contains(house);
    }

    int WalletOf(int house) {
        if (house == this.side) { return this.money; }
        if (this.IsAiHouse(house)) { return this.aiWallets[house]; }
        return 0;
    }

    void GiveToWallet(int house, int amount) {
        if (house == this.side) { this.money = this.money + amount; }
        else if (this.IsAiHouse(house)) {
            this.aiWallets[house] = this.aiWallets[house] + amount;
        }
    }

    void TakeFromWallet(int house, int amount) {
        if (house == this.side) { this.money = this.money - amount; }
        else if (this.IsAiHouse(house)) {
            this.aiWallets[house] = this.aiWallets[house] - amount;
        }
    }

    /// <summary>Credits flow from work done, never from thin air: harvesters
    /// queue their unload through the world's money events, and a captured
    /// oil derrick (the only civilian structure the controller knows by
    /// name) trickles its shipped income. A base without miners starves,
    /// exactly like the real game.</summary>
    void Economy() {
        Rules rules = this.world.Rules();
        for (int s = 0; s < Side2.Count() + 1; s = s + 1) {
            if (s != this.side && !this.IsAiHouse(s)) { continue; }
            int income = 0;
            for (int i = 0; i < this.world.ObjectCount(); i = i + 1) {
                WorldObject o = this.world.ObjectAt(i);
                if (o.Side() != s || o.Kind() != ObjKind.Structure()
                 || o.IsDead()) { continue; }
                StructureType t = this.world.TypeOf(o);
                if (t == null) { continue; }
                if (o.BuiltTicks() < t.BuildTime()) { continue; }
                if (t.Reg() == "CAOILD") {
                    income = income + rules.OilIncome();
                }
            }
            if (income == 0) { continue; }
            if (s == this.side) { this.money = this.money + income; }
            else {
                // The AI's derrick trickle rides the skill multiplier too,
                // so a 简单的敌人 really is poorer, not just slower.
                this.aiWallets[s] = this.aiWallets[s]
                    + (int)(income * Difficulty.Multiplier(this.aiDiffs[s]));
            }
        }
    }

    // ---- player commands ---------------------------------------------------

    /// <summary>Left click on the map: place the armed build if there is one,
    /// sell or repair an own structure when that mode is armed, issue a
    /// move-attack order if A is armed, otherwise select whatever occupies
    /// the cell.</summary>
    void OnClickCell(int x, int y) {
        if (this.building >= 0) {
            this.Place(x, y);
            return;
        }
        if (this.sellMode) {
            this.sellMode = false;
            this.SellAt(x, y);
            return;
        }
        if (this.repairMode) {
            this.repairMode = false;
            this.RepairAt(x, y);
            return;
        }
        if (this.moveAttack) {
            this.moveAttack = false;
            this.world.OrderMoveAttack(x, y);
            this.dirty = true;
            return;
        }
        this.world.SelectAt(x, y);
        this.dirty = true;
    }

    /// <summary>Arms or disarms the move-attack mode (the A key).</summary>
    void ToggleMoveAttack() {
        this.moveAttack = !this.moveAttack;
        this.building = -1;   // mutually exclusive with build placement
        this.ClearSellRepair();
        this.dirty = true;
    }

    bool MoveAttackArmed() { return this.moveAttack; }

    /// <summary>The sidebar's 卖 button: the next click on an own finished
    /// structure sells it for half its price. Armed one click at a time,
    /// and mutually exclusive with the other armed modes.</summary>
    void ToggleSell() {
        this.sellMode = !this.sellMode;
        if (this.sellMode) {
            this.repairMode = false;
            this.building = -1;
            this.moveAttack = false;
        }
        this.dirty = true;
    }

    /// <summary>The sidebar's 修 button: the next click on an own damaged
    /// structure starts the wrench -- RepairStep hit points every
    /// RepairRateTicks, paid per step, until full health or bankruptcy.</summary>
    void ToggleRepair() {
        this.repairMode = !this.repairMode;
        if (this.repairMode) {
            this.sellMode = false;
            this.building = -1;
            this.moveAttack = false;
        }
        this.dirty = true;
    }

    void ClearSellRepair() {
        this.sellMode = false;
        this.repairMode = false;
    }

    /// <summary>Sells the structure under the cell. The refund lands
    /// immediately; a sell also cancels the building's repair and any queue
    /// it was running -- the money already spent on both is gone, as in the
    /// original.</summary>
    bool SellAt(int x, int y) {
        int refund = this.world.SellStructureAt(this.side, x, y);
        this.dirty = true;
        return refund >= 0;
    }

    /// <summary>Starts (or, on an already-repairing building, stops) the
    /// wrench on the structure under the cell. Only own, damaged, finished
    /// buildings take the order -- a click elsewhere just drops the mode.</summary>
    bool RepairAt(int x, int y) {
        List<int> hit = new List<int>();
        this.world.ObjectsAt(x, y, hit);
        for (int i = 0; i < hit.Count; i = i + 1) {
            WorldObject o = this.world.ObjectAt(hit[i]);
            if (o.Side() != this.side || o.Kind() != ObjKind.Structure()
             || o.IsDead() || o.IsCiv()) { continue; }
            StructureType t = this.world.TypeOf(o);
            if (t == null || o.UnderConstruction(t.BuildTime())) { continue; }
            if (o.Hp() >= o.MaxHp()) { continue; }   // nothing to patch
            o.SetRepairing(!o.Repairing());
            this.dirty = true;
            return true;
        }
        return false;
    }

    /// <summary>Left click on a build-menu entry: arm it for placement. A
    /// click on a different entry while one is armed swaps it. Entries whose
    /// tech tree is not satisfied stay dark and ignore the click.</summary>
    void OnClickBuild(int buildId) {
        if (this.building != buildId && !this.BuildUnlocked(buildId)) {
            this.dirty = true;
            return;
        }
        if (this.building == buildId) { this.building = -1; }   // toggle off
        else { this.building = buildId; }
        this.moveAttack = false;
        this.ClearSellRepair();
        this.dirty = true;
    }

    /// <summary>True when the building's prereq slots all stand. The sidebar
    /// uses it to darken locked entries; cost is settled at placement time,
    /// so being broke does not lock a menu slot.</summary>
    bool BuildUnlocked(int buildId) {
        StructureType t = this.world.Catalog().TypeFor(this.world, this.side, buildId);
        if (t == null) { return false; }
        return this.world.SatisfiesPrereqs(this.side, t.Prereqs());
    }

    /// <summary>True when a unit's tech tree is satisfied -- the production
    /// panel's gate.</summary>
    bool UnitUnlocked(int unitId) {
        UnitType u = this.world.Units().TypeFor(this.world, this.side, unitId);
        if (u == null) { return false; }
        return this.world.SatisfiesPrereqs(this.side, u.Prereqs());
    }

    /// <summary>Left click on a production-menu entry: queue the unit for the
    /// selected production structure and deduct its cost. Picking a unit
    /// cancels any armed build, so a misclick does not half-build something.
    /// Units whose prereqs do not stand cannot be queued.</summary>
    void OnClickUnit(int unitId) {
        this.building = -1;
        this.ClearSellRepair();
        WorldObject sel = this.world.Selected();
        if (sel == null || sel.Kind() != ObjKind.Structure()) { return; }
        if (sel.Side() != this.side) { return; }   // cannot train from enemy
        int idx = this.world.SelectedIndex();
        StructureType t = this.world.TypeOf(sel);
        List<int> prod = t.Produces();
        if (prod == null) { return; }
        bool can = false;
        for (int i = 0; i < prod.Count; i = i + 1) {
            if (prod[i] == unitId) { can = true; }
        }
        if (!can) { return; }
        UnitType u = this.world.Units().TypeFor(this.world, sel.Side(), unitId);
        if (u == null) { return; }
        if (!this.world.SatisfiesPrereqs(this.side, u.Prereqs())) { return; }
        if (this.money < u.Cost()) { return; }
        if (!this.world.QueueUnit(idx, unitId)) { return; }
        this.money = this.money - u.Cost();
        this.dirty = true;
    }

    /// <summary>Right click: cancel a pending build, order the selected unit
    /// to attack an enemy under the cell when there is one, else move. Only
    /// the player's own units can be commanded -- an enemy selection is
    /// informational and cannot be moved or fired.</summary>
    void OnRightClick(int x, int y) {
        if (this.building >= 0) { this.building = -1; }
        else if (this.sellMode || this.repairMode) { this.ClearSellRepair(); }
        else if (this.world.SelectedSide() == this.side) {
            if (!this.world.OrderAttack(x, y)) { this.world.OrderMove(x, y); }
        }
        this.dirty = true;
    }

    /// <summary>Right click on the sidebar itself: drop an armed build or an
    /// armed sell/repair, never a map order -- the click had no cell under
    /// it.</summary>
    void OnRightClickSidebar() {
        if (this.building >= 0) { this.building = -1; }
        else if (this.sellMode || this.repairMode) { this.ClearSellRepair(); }
        this.dirty = true;
    }

    /// <summary>Right click on a production card: cancel one queued instance
    /// and refund its cost, the original's dequeue.</summary>
    void OnRightClickUnit(int unitId) {
        WorldObject sel = this.world.Selected();
        if (sel == null || sel.Kind() != ObjKind.Structure()) { return; }
        if (sel.Side() != this.side) { return; }
        UnitType u = this.world.Units().TypeFor(this.world, sel.Side(), unitId);
        if (u == null) { return; }
        if (!this.world.CancelQueuedUnit(this.world.SelectedIndex(), unitId)) {
            return;
        }
        this.money = this.money + u.Cost();
        this.dirty = true;
    }

    /// <summary>Places the armed build at a cell. Deducts the cost, or clears
    /// the arm when the spot is taken or the credits are short.</summary>
    bool Place(int x, int y) {
        StructureCatalog catalog = this.world.Catalog();
        int buildId = this.building;
        if (buildId < 0) { return false; }
        StructureType t = catalog.TypeFor(this.world, this.side, buildId);
        if (t == null) { return false; }
        // No yard, no construction: the arm drops, exactly like a broke
        // order. A base whose construction yard fell stays fallen -- that is
        // the lever that lets an assault end a war instead of sieging an
        // enemy who rebuilds his wall forever from a full treasury.
        if (!this.HasRegBuilding(this.side, this.world.Rules().AiConst())) {
            this.building = -1;
            return false;
        }
        if (this.money < t.Cost()) { this.building = -1; return false; }
        if (this.world.PlaceStructure(this.side, buildId, x, y) < 0) {
            this.building = -1;
            return false;
        }
        this.money = this.money - t.Cost();
        this.building = -1;
        this.dirty = true;
        return true;
    }

    // ---- opponent AI -------------------------------------------------------

    /// <summary>The side the classic one-enemy skirmish AI plays: the next
    /// side round-robin after the player's, so each choice meets a different
    /// opponent. Multi-AI games bypass this and drive every house in
    /// aiHouses directly.</summary>
    int EnemySide() {
        return this.aiHouses.Count > 0 ? this.aiHouses[0]
            : (this.side + 1) % Side2.Count();
    }

    /// <summary>Runs the enemy's turn: the AI follows the [AI] section's
    /// build order from the Rules (power, refinery, barracks, more power,
    /// war factory, radar, tech, defences), trains the armed regulars its
    /// production buildings offer, and sends every idle unit at the nearest
    /// player object. The AI is honest -- it follows the same placement,
    /// production, prereq and combat rules as the player.</summary>
    void UpdateAi() {
        if (this.result != 0) { return; }
        // Each AI house runs its own decision loop: separate wallets, skill
        // levels and build orders, so two 冷酷的敌人 grow at full pace
        // independently instead of sharing one brain's budget.
        for (int a = 0; a < this.aiHouses.Count; a = a + 1) {
            this.UpdateAiHouse(this.aiHouses[a], this.world.Rules());
        }
    }

    /// <summary>One AI house's decisions: build on its own cadence, train on
    /// its own cadence, then send every idle unit at the nearest hostile of
    /// ANY house -- in a free-for-all that includes the other AIs.</summary>
    void UpdateAiHouse(int aiSide, Rules rules) {
        double mult = Difficulty.Multiplier(this.aiDiffs[aiSide]);
        int buildEvery = (int)(15.0 / mult);
        int trainEvery = (int)(20.0 / mult);
        if (buildEvery < 1) { buildEvery = 1; }
        if (trainEvery < 1) { trainEvery = 1; }
        if (this.tick % buildEvery == 0) { this.AiBuildStep(aiSide, rules); }
        if (this.tick % trainEvery == 0) { this.AiTrainStep(aiSide, rules); }
        // Unfold the base before anything else: the reference engine runs
        // deploy_mcv_commands ahead of its build order, because a house with
        // no construction yard can build nothing (AiBuyFromList bails out on
        // a yardless house). Each AI starts on one MCV, exactly like the
        // player, so this is what raises its base.
        if (!this.HasRegBuilding(aiSide, rules.AiConst())) {
            this.AiDeployMcv(aiSide);
        }        // Attack: every unit without a live target acquires the nearest
        // hostile object. The world's chase logic then walks it into range.
        for (int i = 0; i < this.world.ObjectCount(); i = i + 1) {
            WorldObject o = this.world.ObjectAt(i);
            if (o.Side() != aiSide || o.Kind() != ObjKind.Unit()) { continue; }
            if (this.world.Target(o) != null) { continue; }
            // Stagger the omniscient scan so N idle armies cost N scans per
            // 15 ticks instead of N per tick: house+index spreads the hits.
            if ((this.tick + i + aiSide) % 15 != 0) { continue; }
            int enemy = this.world.NearestEnemy(aiSide, o.X(), o.Y());
            if (enemy >= 0) {
                this.world.AttackObject(i, this.world.ObjectAt(enemy));
            }
        }
    }

    /// <summary>Unfolds a house's mobile construction vehicle: the first own
    /// unit whose rules carry DeploysInto is deployed where it stands. The
    /// reference's deploy_mcv_commands does the same walk over its entities;
    /// a house that already has a yard never reaches here.</summary>
    void AiDeployMcv(int aiSide) {
        for (int i = 0; i < this.world.ObjectCount(); i = i + 1) {
            WorldObject o = this.world.ObjectAt(i);
            if (o.Side() != aiSide || o.Kind() != ObjKind.Unit()) { continue; }
            if (o.IsDead() || o.UnitType() == null) { continue; }
            string into = o.UnitType().DeploysInto();
            if (into == null || into.Length == 0) { continue; }
            if (this.world.DeployObject(i) >= 0) { return; }
        }
    }

    /// <summary>The player's deploy key (F, the original's binding): every
    /// selected unit of the player's own house runs its Deploy -- an MCV
    /// unfolds into its construction yard on the spot, a GI sits down into
    /// his emplacement or stands back up. Returns true when at least one
    /// deploy went through.</summary>
    bool DeploySelected() {
        bool any = false;
        List<WorldObject> sel = this.world.SelectedObjects();
        for (int i = 0; i < sel.Count; i = i + 1) {
            WorldObject o = sel[i];
            if (o.Side() != this.side || o.Kind() != ObjKind.Unit()) { continue; }
            int idx = this.world.IndexOfObject(o);
            if (idx < 0) { continue; }
            if (this.world.DeployObject(idx) >= 0) { any = true; }
        }
        if (any) { this.dirty = true; }
        return any;
    }

    /// <summary>One step of the AI's construction. The first pass walks the
    /// fixed build order; after that the AI tops up power when the grid runs
    /// thin, adds a second refinery, and keeps sprinkling defences.</summary>
    void AiBuildStep(int aiSide, Rules rules) {
        if (this.aiBuildIdx[aiSide] < 8) {
            List<List<string>> order = new List<List<string>>();
            order.Add(rules.AiPower());
            order.Add(rules.AiRefinery());
            order.Add(rules.AiBarracks());
            order.Add(rules.AiPower());
            order.Add(rules.AiWeapons());
            order.Add(rules.AiRadar());
            order.Add(rules.AiTech());
            order.Add(rules.AiDefense());
            if (this.AiBuyFromList(aiSide, order[this.aiBuildIdx[aiSide]],
                                   false)) {
                this.aiBuildIdx[aiSide] = this.aiBuildIdx[aiSide] + 1;
            }
            return;
        }
        // Replace production buildings the enemy destroyed: a base whose
        // barracks burned down never trains again otherwise.
        if (!this.HasRegBuilding(aiSide, rules.AiBarracks())) {
            this.AiBuyFromList(aiSide, rules.AiBarracks(), false);
            return;
        }
        if (!this.HasRegBuilding(aiSide, rules.AiWeapons())) {
            this.AiBuyFromList(aiSide, rules.AiWeapons(), false);
            return;
        }
        // Top-ups buy additional copies, so they pass allowMany: with it
        // off, "already owns one" reads as done and the AI deadlocks -- a
        // tesla coil drags the grid negative, the power top-up sees the
        // plant it already has and never builds the second one.
        if (this.world.PowerBalance(aiSide) < 150) {
            if (this.AiBuyFromList(aiSide, rules.AiPower(), true)) { return; }
        }
        if (this.CountRefineries(aiSide) < 2) {
            if (this.AiBuyFromList(aiSide, rules.AiRefinery(), true)) { return; }
        }
        // Defences ring the base, but two limits keep the AI from turtling
        // itself into bankruptcy: it only builds a tower when it holds a
        // reserve (so unit training never starves), and the ring stops at
        // four towers -- an endless wall turns the endgame into a siege the
        // infantry-heavy roster cannot crack.
        if (this.CountDefenses(aiSide, rules) < 4
         && this.aiWallets[aiSide] > 1200) {
            this.AiBuyFromList(aiSide, rules.AiDefense(), true);
        }
    }

    /// <summary>Buys the first buildable entry of an [AI] reg list. Regs the
    /// side's roster does not carry are skipped; a list with nothing for this
    /// side counts as done so the build order never stalls on it (the Allied
    /// base has no war factory, yet BuildWeapons names one). Returns true
    /// when the step should advance -- bought, or nothing to buy.</summary>
    bool AiBuyFromList(int side, List<string> regs, bool allowMany) {
        // The AI follows the same construction rule as the player: once its
        // yard is down, nothing is rebuilt. Without this the AI sits on its
        // treasury and re-raises every knocked-down defence forever, turning
        // the endgame into an unwinnable siege.
        if (!this.HasRegBuilding(side, this.world.Rules().AiConst())) {
            return false;
        }
        StructureCatalog catalog = this.world.Catalog();
        int count = catalog.CountFor(this.world, side);
        for (int i = 0; i < regs.Count; i = i + 1) {
            int buildId = -1;
            for (int b = 0; b < count; b = b + 1) {
                StructureType t = catalog.TypeFor(this.world, side, b);
                if (t != null && t.Reg() == regs[i]) { buildId = b; break; }
            }
            if (buildId < 0) { continue; }   // not in this side's roster
            StructureType t2 = catalog.TypeFor(this.world, side, buildId);
            if (t2 == null) { return true; }
            if (!allowMany && this.HasStructure(side, buildId)) { return true; }
            if (!this.world.SatisfiesPrereqs(side, t2.Prereqs())) {
                return false;   // tech missing: retry on a later step
            }
            if (this.aiWallets[side] < t2.Cost()) { return false; }
            List<int> xy = new List<int>();
            if (!this.world.AiPlaceSpot(side, t2, xy)) { return false; }
            if (this.world.PlaceStructure(side, buildId, xy[0], xy[1]) < 0) {
                return false;
            }
            this.aiWallets[side] = this.aiWallets[side] - t2.Cost();
            return true;
        }
        return true;
    }

    /// <summary>Trains one unit for the AI when the army is under eight:
    /// first the barracks' armed regulars, then the war factory's. Each
    /// candidate must pass the same prereq and cost checks as the player's
    /// clicks. Harvesters outrank the army cap: two per finished refinery,
    /// because a base without miners starves before it can fight.</summary>
    void AiTrainStep(int aiSide, Rules rules) {
        int refs = this.CountRefineries(aiSide);
        int miners = 0;
        for (int i = 0; i < this.world.ObjectCount(); i = i + 1) {
            WorldObject o = this.world.ObjectAt(i);
            if (o.Side() != aiSide || o.Kind() != ObjKind.Unit()
             || o.IsDead()) { continue; }
            if (o.UnitType() != null
             && o.UnitType().Role() == UnitRole.Harvester()) {
                miners = miners + 1;
            }
        }
        if (miners < refs * 2 && this.AiQueueHarvester(aiSide)) { return; }
        // The army cap rides the skill: a 冷酷的敌人 fields more before
        // it stops training, a 简单的敌人 fewer.
        int cap = this.aiDiffs[aiSide] == Difficulty.Brutal() ? 10
                : this.aiDiffs[aiSide] == Difficulty.Easy() ? 6 : 8;
        if (this.AiArmySize(aiSide) >= cap) { return; }
        StructureCatalog catalog = this.world.Catalog();
        int count = catalog.CountFor(this.world, aiSide);
        for (int pass = 0; pass < 2; pass = pass + 1) {
            for (int b = 0; b < count; b = b + 1) {
                StructureType t = catalog.TypeFor(this.world, aiSide, b);
                if (t == null || t.Produces() == null
                 || t.Produces().Count == 0) { continue; }
                bool isBarracks = GameController.RegIn(rules.AiBarracks(),
                                                       t.Reg());
                bool isWeapons = GameController.RegIn(rules.AiWeapons(),
                                                      t.Reg());
                if (pass == 0 ? !isBarracks : !isWeapons) { continue; }
                int idx = this.FindStructure(aiSide, b);
                if (idx < 0) { continue; }
                WorldObject obj = this.world.ObjectAt(idx);
                if (obj.BuiltTicks() < t.BuildTime()) { continue; }
                if (obj.ProdCount() > 0) { continue; }
                int unitId = this.AiPickUnit(aiSide, t);
                if (unitId < 0) { continue; }
                UnitType u = this.world.Units().TypeFor(this.world, aiSide, unitId);
                if (u == null) { continue; }
                if (!this.world.SatisfiesPrereqs(aiSide, u.Prereqs())) {
                    continue;
                }
                if (this.aiWallets[aiSide] < u.Cost()) { continue; }
                if (this.world.QueueUnit(idx, unitId)) {
                    this.aiWallets[aiSide] = this.aiWallets[aiSide] - u.Cost();
                    return;
                }
            }
        }
    }

    /// <summary>Queues a harvester at the side's first idle, finished war
    /// factory. Returns false when the factory is busy, missing or broke --
    /// the step retries on a later tick.</summary>
    bool AiQueueHarvester(int aiSide) {
        StructureCatalog catalog = this.world.Catalog();
        for (int b = 0; b < catalog.CountFor(this.world, aiSide); b = b + 1) {
            StructureType t = catalog.TypeFor(this.world, aiSide, b);
            if (t == null || t.Produces() == null
             || !GameController.RegIn(this.world.Rules().AiWeapons(), t.Reg())) {
                continue;
            }
            int idx = this.FindStructure(aiSide, b);
            if (idx < 0) { continue; }
            WorldObject obj = this.world.ObjectAt(idx);
            if (obj.BuiltTicks() < t.BuildTime() || obj.ProdCount() > 0) {
                continue;
            }
            List<int> prod = t.Produces();
            for (int i = 0; i < prod.Count; i = i + 1) {
                UnitType u = this.world.Units().TypeFor(this.world, aiSide, prod[i]);
                if (u == null || u.Role() != UnitRole.Harvester()) { continue; }
                if (this.aiWallets[aiSide] < u.Cost()) { return false; }
                if (this.world.QueueUnit(idx, prod[i])) {
                    this.aiWallets[aiSide] = this.aiWallets[aiSide] - u.Cost();
                    return true;
                }
            }
        }
        return false;
    }

    /// <summary>The first armed regular a structure trains: engineers and
    /// spies are specialists, not attackers, so the AI skips them.</summary>
    int AiPickUnit(int aiSide, StructureType t) {
        List<int> prod = t.Produces();
        for (int i = 0; i < prod.Count; i = i + 1) {
            UnitType u = this.world.Units().TypeFor(this.world, aiSide, prod[i]);
            if (u == null || u.Role() != UnitRole.None()) { continue; }
            if (u.Primary() == null) { continue; }
            return prod[i];
        }
        return -1;
    }

    static bool RegIn(List<string> list, string reg) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i] == reg) { return true; }
        }
        return false;
    }

    int FindStructure(int side, int buildId) {
        for (int i = 0; i < this.world.ObjectCount(); i = i + 1) {
            WorldObject o = this.world.ObjectAt(i);
            if (o.Side() == side && o.Kind() == ObjKind.Structure()
             && o.BuildId() == buildId && !o.IsDead()) { return i; }
        }
        return -1;
    }

    bool HasStructure(int side, int buildId) {
        return this.FindStructure(side, buildId) >= 0;
    }

    int CountRefineries(int side) {
        int n = 0;
        for (int i = 0; i < this.world.ObjectCount(); i = i + 1) {
            WorldObject o = this.world.ObjectAt(i);
            if (o.Side() != side || o.Kind() != ObjKind.Structure()
             || o.IsDead()) { continue; }
            StructureType t = this.world.TypeOf(o);
            if (t != null && t.IsRefinery()) { n = n + 1; }
        }
        return n;
    }

    int CountDefenses(int side, Rules rules) {
        List<string> regs = rules.AiDefense();
        int n = 0;
        for (int i = 0; i < this.world.ObjectCount(); i = i + 1) {
            WorldObject o = this.world.ObjectAt(i);
            if (o.Side() != side || o.Kind() != ObjKind.Structure()
             || o.IsDead()) { continue; }
            StructureType t = this.world.TypeOf(o);
            if (t != null && GameController.RegIn(regs, t.Reg())) { n = n + 1; }
        }
        return n;
    }

    /// <summary>True when the side owns a building whose reg is in the list.
    /// A reg the roster does not carry counts as owned, so a side without a
    /// war factory never waits on one.</summary>
    bool HasRegBuilding(int side, List<string> regs) {
        StructureCatalog catalog = this.world.Catalog();
        int count = catalog.CountFor(this.world, side);
        bool anyInRoster = false;
        for (int i = 0; i < regs.Count; i = i + 1) {
            for (int b = 0; b < count; b = b + 1) {
                StructureType t = catalog.TypeFor(this.world, side, b);
                if (t == null || t.Reg() != regs[i]) { continue; }
                anyInRoster = true;
                if (this.HasStructure(side, b)) { return true; }
            }
        }
        return !anyInRoster;
    }

    int AiArmySize(int side) {
        int n = 0;
        for (int i = 0; i < this.world.ObjectCount(); i = i + 1) {
            WorldObject o = this.world.ObjectAt(i);
            if (o.Side() == side && o.Kind() == ObjKind.Unit() && !o.IsDead()) {
                n = n + 1;
            }
        }
        return n;
    }

    /// <summary>Sets the result when the base situation is decided: the
    /// player wins when EVERY AI house is down to no structures (and, off
    /// the quick game, no units either), and loses the same way. In a
    /// free-for-all the AIs take each other's bases into account -- an AI
    /// destroyed by its rival stays destroyed and counts toward the win.
    /// There is no draw -- a side that cannot reach the others simply has
    /// to build a way through, or lose its base first.</summary>
    void CheckResult() {
        if (this.result != 0) { return; }
        bool allDown = true;
        for (int i = 0; i < this.aiHouses.Count; i = i + 1) {
            int h = this.aiHouses[i];
            if (this.world.SideEliminated(h)
             && (this.shortGame || !this.WorldHasUnits(h))) { continue; }
            allDown = false;
            break;
        }
        if (allDown) {
            this.result = 1;
            return;
        }
        if (this.world.SideEliminated(this.side)
         && (this.shortGame || !this.WorldHasUnits(this.side))) {
            this.result = 2;
            return;
        }
    }

    /// <summary>Whether the side still fields a living unit -- the half of
    /// the win condition that 快速游戏 switches off.</summary>
    bool WorldHasUnits(int side) {
        for (int i = 0; i < this.world.ObjectCount(); i = i + 1) {
            WorldObject o = this.world.ObjectAt(i);
            if (o.Side() == side && o.Kind() == ObjKind.Unit()
             && !o.IsDead()) {
                return true;
            }
        }
        return false;
    }
}
