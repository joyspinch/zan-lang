using System;
using System.Collections.Generic;
using Ra2.Formats;

namespace Ra2.Game;

/// <summary>The output channels a sound can ride. Each carries its own
/// options volume and mute flag; the master multiplies everything. The
/// numbering matches the shipped mixer serialization.</summary>
class Ch {
    static int Master() { return 0; }
    static int Ui() { return 1; }
    static int Ambient() { return 2; }
    static int Effect() { return 3; }
    static int Voice() { return 4; }
    static int Music() { return 5; }
    static int CreditTicks() { return 6; }
    static int Count() { return 7; }
}

/// <summary>The shipped SoundKey enum names, in enum order. Only these
/// route through the rules' [AudioVisual] mapping; any other string is a
/// sound.ini section name directly -- the reference's getSoundKey
/// discriminator between UI event keys and raw table names.</summary>
class SndKeys {
    static List<string> names;

    static List<string> Build() {
        List<string> n = new List<string>();
        n.Add("CreateInfantrySound");
        n.Add("CreateUnitSound");
        n.Add("CreateAircraftSound");
        n.Add("SpySatActivationSound");
        n.Add("SpySatDeactivationSound");
        n.Add("UpgradeVeteranSound");
        n.Add("UpgradeEliteSound");
        n.Add("BaseUnderAttackSound");
        n.Add("BuildingGarrisonedSound");
        n.Add("BuildingRepairedSound");
        n.Add("CheerSound");
        n.Add("PlaceBeaconSound");
        n.Add("StartPlanningModeSound");
        n.Add("EndPlanningModeSound");
        n.Add("AddPlanningModeCommandSound");
        n.Add("ExecutePlanSound");
        n.Add("CratePromoteSound");
        n.Add("CrateMoneySound");
        n.Add("CrateRevealSound");
        n.Add("CrateFireSound");
        n.Add("CrateArmourSound");
        n.Add("CrateSpeedSound");
        n.Add("CrateUnitSound");
        n.Add("GUIMainButtonSound");
        n.Add("GUIBuildSound");
        n.Add("GUITabSound");
        n.Add("GUIOpenSound");
        n.Add("GUICloseSound");
        n.Add("GUIMoveOutSound");
        n.Add("GUIMoveInSound");
        n.Add("GUIComboOpenSound");
        n.Add("GUIComboCloseSound");
        n.Add("GUICheckboxSound");
        n.Add("ScoreAnimSound");
        n.Add("SinkingSound");
        n.Add("ImpactWaterSound");
        n.Add("ImpactLandSound");
        n.Add("BombTickingSound");
        n.Add("ChronoInSound");
        n.Add("ChronoOutSound");
        n.Add("BombAttachSound");
        n.Add("YuriMindControlSound");
        n.Add("DigSound");
        n.Add("CloakSound");
        n.Add("SellSound");
        n.Add("GameClosed");
        n.Add("IncomingMessage");
        n.Add("MessageCharTyped");
        n.Add("SystemError");
        n.Add("OptionsChanged");
        n.Add("GameForming");
        n.Add("PlayerLeft");
        n.Add("PlayerJoined");
        n.Add("Construction");
        n.Add("BuildingDieSound");
        n.Add("BuildingSlam");
        n.Add("RadarOn");
        n.Add("RadarOff");
        n.Add("MovieOn");
        n.Add("MovieOff");
        n.Add("ScoldSound");
        n.Add("TeslaCharge");
        n.Add("TeslaZap");
        n.Add("BuildingDamageSound");
        n.Add("ChuteSound");
        n.Add("GenericClick");
        n.Add("GenericBeep");
        n.Add("BuildingDrop");
        n.Add("StopSound");
        n.Add("GuardSound");
        n.Add("ScatterSound");
        n.Add("DeploySound");
        n.Add("StormSound");
        n.Add("LightningSounds");
        n.Add("ShellButtonSlideSound");
        n.Add("QuickMatchTimer");
        return n;
    }

    static bool IsSoundKeyName(string key) {
        if (SndKeys.names == null) { SndKeys.names = SndKeys.Build(); }
        for (int i = 0; i < SndKeys.names.Count; i = i + 1) {
            if (SndSpecText.SameWord(SndKeys.names[i], key)) { return true; }
        }
        return false;
    }
}

/// <summary>Per-channel volumes and mutes, the options screen's sliders.
/// Volumes are 0..1; mute is a separate switch so a slider position
/// survives unmuting.</summary>
class SndMixer {
    double[] volumes;
    bool[] mutes;

    static SndMixer Create() {
        SndMixer m = new SndMixer();
        m.volumes = new double[Ch.Count()];
        m.mutes = new bool[Ch.Count()];
        for (int i = 0; i < Ch.Count(); i = i + 1) {
            m.volumes[i] = 1.0;
            m.mutes[i] = false;
        }
        return m;
    }

    void SetVolume(int channel, double volume) {
        if (channel < 0 || channel >= Ch.Count()) { return; }
        this.volumes[channel] = volume;
    }

    double GetVolume(int channel) {
        if (channel < 0 || channel >= Ch.Count()) { return 1.0; }
        return this.volumes[channel];
    }

    void SetMuted(int channel, bool muted) {
        if (channel < 0 || channel >= Ch.Count()) { return; }
        this.mutes[channel] = muted;
    }

    bool IsMuted(int channel) {
        if (channel < 0 || channel >= Ch.Count()) { return false; }
        return this.mutes[channel];
    }

    /// <summary>The gain a play on this channel should run at, master
    /// included; mute folds in as zero. The master's live mute rides the
    /// device volume so it cuts already-sounding voices too.</summary>
    double ChannelGain(int channel) {
        if (channel < 0 || channel >= Ch.Count()) { return 0.0; }
        if (this.IsMuted(channel)) { return 0.0; }
        return this.volumes[channel];
    }

    /// <summary>The "[channel,gain;...]" string the options store keeps.</summary>
    string Serialize() {
        string s = "";
        for (int i = 0; i < Ch.Count(); i = i + 1) {
            if (i > 0) { s = s + ";"; }
            s = s + Convert.ToString(i) + ","
                + Convert.ToString(this.volumes[i]);
        }
        return s;
    }

    void Unserialize(string data) {
        if (data == null) { return; }
        int at = 0;
        while (at < data.Length) {
            int semi = data.IndexOf(';', at);
            if (semi < 0) { semi = data.Length; }
            int comma = data.IndexOf(',', at);
            if (comma > at && comma < semi) {
                string ch = data.Substring(at, comma - at).Trim();
                string v = data.Substring(comma + 1, semi - comma - 1)
                    .Trim();
                this.SetVolume(SndSpecText.ToInt(ch, 0 - 1),
                    SndSpecText.ToDouble(v, 1.0));
            }
            at = semi + 1;
        }
    }
}

/// <summary>sound.ini text helpers shared by the spec parsers: tolerant
/// number reads and the enum vocabularies the shipped file uses.</summary>
class SndSpecText {
    static int ToInt(string s, int fallback) {
        if (s == null || s.Length == 0) { return fallback; }
        string t = s.Trim();
        if (t.Length == 0) { return fallback; }
        int sign = 1;
        int at = 0;
        if (t[0] == 45) { sign = 0 - 1; at = 1; }
        else if (t[0] == 43) { at = 1; }
        int v = 0;
        bool any = false;
        for (int i = at; i < t.Length; i = i + 1) {
            int c = t[i] & 0xFF;
            if (c < 48 || c > 57) { break; }
            v = v * 10 + (c - 48);
            any = true;
        }
        return any ? sign * v : fallback;
    }

    static double ToDouble(string s, double fallback) {
        if (s == null || s.Length == 0) { return fallback; }
        return double.Parse(s.Trim());
    }

    /// <summary>True when the whole value reads as a plain integer (the
    /// number-array parser's accept test).</summary>
    static bool IsInt(string s) {
        if (s == null || s.Trim().Length == 0) { return false; }
        string t = s.Trim();
        int at = t[0] == 45 || t[0] == 43 ? 1 : 0;
        if (at >= t.Length) { return false; }
        for (int i = at; i < t.Length; i = i + 1) {
            int c = t[i] & 0xFF;
            if (c < 48 || c > 57) { return false; }
        }
        return true;
    }

    /// <summary>Whitespace-split, keeping order, dropping empties.</summary>
    static List<string> Tokens(string s) {
        List<string> outp = new List<string>();
        if (s == null) { return outp; }
        int i = 0;
        while (i < s.Length) {
            int c = s[i] & 0xFF;
            if (c == 32 || c == 9 || c == 13 || c == 10) {
                i = i + 1;
                continue;
            }
            int start = i;
            while (i < s.Length) {
                int d = s[i] & 0xFF;
                if (d == 32 || d == 9 || d == 13 || d == 10) { break; }
                i = i + 1;
            }
            outp.Add(s.Substring(start, i - start));
        }
        return outp;
    }

    static bool SameWord(string a, string b) {
        if (a == null || b == null || a.Length != b.Length) { return false; }
        for (int i = 0; i < a.Length; i = i + 1) {
            int x = a[i] & 0xFF;
            int y = b[i] & 0xFF;
            if (x >= 97 && x <= 122) { x = x - 32; }
            if (y >= 97 && y <= 122) { y = y - 32; }
            if (x != y) { return false; }
        }
        return true;
    }

    // Control= 开关位(位掩码),reference 的 SoundControl。
    static int ControlLoop() { return 1; }
    static int ControlRandom() { return 2; }
    static int ControlPredelay() { return 4; }
    static int ControlInterrupt() { return 8; }
    static int ControlAttack() { return 16; }
    static int ControlDecay() { return 32; }
    static int ControlAmbient() { return 64; }

    static int ControlOf(string word) {
        if (SndSpecText.SameWord(word, "Loop")) {
            return SndSpecText.ControlLoop();
        }
        if (SndSpecText.SameWord(word, "Random")) {
            return SndSpecText.ControlRandom();
        }
        if (SndSpecText.SameWord(word, "Predelay")) {
            return SndSpecText.ControlPredelay();
        }
        if (SndSpecText.SameWord(word, "Interrupt")) {
            return SndSpecText.ControlInterrupt();
        }
        if (SndSpecText.SameWord(word, "Attack")) {
            return SndSpecText.ControlAttack();
        }
        if (SndSpecText.SameWord(word, "Decay")) {
            return SndSpecText.ControlDecay();
        }
        if (SndSpecText.SameWord(word, "Ambient")) {
            return SndSpecText.ControlAmbient();
        }
        return 0;
    }

    // Type= 空间类型位,reference 的 SoundType。
    static int TypeGlobal() { return 1; }
    static int TypeNormal() { return 2; }
    static int TypeScreen() { return 4; }
    static int TypeLocal() { return 8; }
    static int TypePlayer() { return 16; }
    static int TypeUnshroud() { return 32; }
    static int TypeShroud() { return 64; }

    static int TypeOf(string word) {
        if (SndSpecText.SameWord(word, "Global")) {
            return SndSpecText.TypeGlobal();
        }
        if (SndSpecText.SameWord(word, "Normal")) {
            return SndSpecText.TypeNormal();
        }
        if (SndSpecText.SameWord(word, "Screen")) {
            return SndSpecText.TypeScreen();
        }
        if (SndSpecText.SameWord(word, "Local")) {
            return SndSpecText.TypeLocal();
        }
        if (SndSpecText.SameWord(word, "Player")) {
            return SndSpecText.TypePlayer();
        }
        if (SndSpecText.SameWord(word, "Unshroud")) {
            return SndSpecText.TypeUnshroud();
        }
        if (SndSpecText.SameWord(word, "Shroud")) {
            return SndSpecText.TypeShroud();
        }
        return 0;
    }

    // Priority= 阈值,reference 的 SoundPriority。
    static int PriorityLowest() { return 0; }
    static int PriorityLow() { return 1; }
    static int PriorityNormal() { return 2; }
    static int PriorityHigh() { return 3; }
    static int PriorityCritical() { return 4; }

    static int PriorityOf(string word) {
        if (SndSpecText.SameWord(word, "Lowest")) {
            return SndSpecText.PriorityLowest();
        }
        if (SndSpecText.SameWord(word, "Low")) {
            return SndSpecText.PriorityLow();
        }
        if (SndSpecText.SameWord(word, "Normal")) {
            return SndSpecText.PriorityNormal();
        }
        if (SndSpecText.SameWord(word, "High")) {
            return SndSpecText.PriorityHigh();
        }
        if (SndSpecText.SameWord(word, "Critical")) {
            return SndSpecText.PriorityCritical();
        }
        return 0 - 1;
    }
}

/// <summary>One sound.ini entry: which WAVs it may play, how loud, how the
/// distance shapes it, and how many copies may overlap.</summary>
class SoundSpec {
    string name;
    int controlBits;
    List<string> sounds;
    int volume;
    bool delaySet;
    int delayMin;
    int delayMax;
    int priority;
    int typeBits;
    bool fShiftSet;
    int fShiftMin;
    int fShiftMax;
    int limit;
    int loop;
    int range;
    int minVolume;
    bool vShiftSet;
    int vShiftMin;
    int vShiftMax;
    int attack;
    int decay;

    bool HasControl(int bit) { return (this.controlBits & bit) != 0; }
    bool HasType(int bit) { return (this.typeBits & bit) != 0; }
}

/// <summary>sound.ini as a whole: the [Defaults] block, the [SoundList]
/// roster, and one parsed section per listed sound. A file missing either
/// of the two required sections parses to an empty set -- the game then
/// plays no sounds, exactly like the shipped engine's missing-section
/// path.</summary>
class SoundSpecs {
    List<SoundSpec> specs;
    List<string> order;
    int defMinVolume;
    int defRange;
    int defVolume;
    int defLimit;
    int defTypes;
    int defPriority;

    static SoundSpecs Create() {
        SoundSpecs s = new SoundSpecs();
        s.specs = new List<SoundSpec>();
        s.order = new List<string>();
        s.defMinVolume = 0;
        s.defRange = 0;
        s.defVolume = 100;
        s.defLimit = 0;
        s.defTypes = 0;
        s.defPriority = SndSpecText.PriorityNormal();
        return s;
    }

    /// <summary>Parses the merged sound.ini document. Sound names come from
    /// the [SoundList] values in listed order; a listed name without its own
    /// section is skipped with the shipped engine's warning path.</summary>
    static SoundSpecs Parse(IniDocument ini) {
        SoundSpecs s = SoundSpecs.Create();
        IniSection defaults = ini.Section("Defaults");
        if (defaults == null) { return s; }
        s.defMinVolume = defaults.GetIntOr("MinVolume", 0);
        s.defRange = defaults.GetIntOr("Range", 0);
        s.defVolume = defaults.GetIntOr("Volume", 100);
        s.defLimit = defaults.GetIntOr("Limit", 0);
        s.defPriority = SndSpecText.PriorityNormal();
        List<string> dp = SndSpecText.Tokens(defaults.Get("Priority"));
        for (int i = 0; i < dp.Count; i = i + 1) {
            int p = SndSpecText.PriorityOf(dp[i]);
            if (p >= 0) {
                s.defPriority = p;
                break;
            }
        }
        s.defTypes = 0;
        List<string> dt = SndSpecText.Tokens(defaults.Get("Type"));
        for (int i = 0; i < dt.Count; i = i + 1) {
            s.defTypes = s.defTypes | SndSpecText.TypeOf(dt[i]);
        }
        IniSection list = ini.Section("SoundList");
        if (list == null) { return s; }
        for (int i = 0; i < list.Count(); i = i + 1) {
            string soundName = list.EntryAt(i).Value().Trim();
            if (soundName.Length == 0) { continue; }
            bool dup = false;
            for (int k = 0; k < s.order.Count; k = k + 1) {
                if (SndSpecText.SameWord(s.order[k], soundName)) {
                    dup = true;
                    break;
                }
            }
            if (dup) { continue; }
            IniSection sec = ini.Section(soundName);
            if (sec == null) { continue; }
            s.order.Add(soundName);
            s.specs.Add(SoundSpecs.ReadSpec(soundName, sec, s));
        }
        return s;
    }

    static SoundSpec ReadSpec(string name, IniSection sec, SoundSpecs defs) {
        SoundSpec sp = new SoundSpec();
        sp.name = name;
        sp.sounds = new List<string>();
        sp.controlBits = 0;
        sp.typeBits = 0;
        sp.volume = defs.defVolume;
        sp.priority = defs.defPriority;
        sp.limit = defs.defLimit;
        sp.range = defs.defRange;
        sp.minVolume = defs.defMinVolume;
        sp.loop = 0;
        sp.delaySet = false;
        sp.fShiftSet = false;
        sp.vShiftSet = false;
        sp.attack = 0;
        sp.decay = 0;
        sp.delayMin = 0;
        sp.delayMax = 0;
        sp.fShiftMin = 0;
        sp.fShiftMax = 0;
        sp.vShiftMin = 0;
        sp.vShiftMax = 0;
        // Range=-2 是无衰减的正无穷。
        int range = sec.GetIntOr("Range", defs.defRange);
        sp.range = range == 0 - 2 ? 2147483647 : range;
        List<string> ctrl = SndSpecText.Tokens(sec.Get("Control"));
        for (int i = 0; i < ctrl.Count; i = i + 1) {
            sp.controlBits = sp.controlBits
                | SndSpecText.ControlOf(ctrl[i]);
        }
        // Sounds= 一行里也能内嵌 "Control=..." 截断,reference 的
        // parseSoundNames 语义:$ 前缀去引用,截断点之前才是文件名。
        List<string> soundTokens = SndSpecText.Tokens(sec.Get("Sounds"));
        int cut = soundTokens.Count;
        for (int i = 0; i < soundTokens.Count; i = i + 1) {
            string t = soundTokens[i];
            bool isCut = t.Length > 8
                && SndSpecText.SameWord(t.Substring(0, 7), "control")
                && t[7] == 61;
            if (!isCut && SndSpecText.SameWord(t, "control")
             && i + 1 < soundTokens.Count
             && soundTokens[i + 1].Length > 0 && soundTokens[i + 1][0] == 61) {
                isCut = true;
            }
            if (isCut) {
                cut = i;
                break;
            }
        }
        for (int i = 0; i < cut; i = i + 1) {
            string t = soundTokens[i];
            if (t.Length > 0 && t[0] == 36) { t = t.Substring(1); }
            if (t.Length == 0) { continue; }
            sp.sounds.Add(t);
        }
        // 大小写两种 Volume 键都收,reference 的读取顺序。
        string volRaw = sec.Get("Volume");
        if (volRaw.Length == 0) { volRaw = sec.Get("volume"); }
        if (volRaw.Length > 0) {
            sp.volume = SndSpecText.ToInt(volRaw, defs.defVolume);
        }
        List<string> delay = SndSpecText.Tokens(sec.Get("Delay"));
        if (delay.Count > 0) {
            sp.delaySet = true;
            sp.delayMin = SndSpecText.ToInt(delay[0], 0);
            sp.delayMax = delay.Count > 1
                ? SndSpecText.ToInt(delay[1], sp.delayMin) : sp.delayMin;
        }
        List<string> pri = SndSpecText.Tokens(sec.Get("Priority"));
        for (int i = 0; i < pri.Count; i = i + 1) {
            int p = SndSpecText.PriorityOf(pri[i]);
            if (p >= 0) {
                sp.priority = p;
                break;
            }
        }
        List<string> types = SndSpecText.Tokens(sec.Get("Type"));
        for (int i = 0; i < types.Count; i = i + 1) {
            sp.typeBits = sp.typeBits | SndSpecText.TypeOf(types[i]);
        }
        // 一个 Screen/Local/Global 都没有时,把 Defaults 里第一个这类
        // 类型补进来,reference 的 fallback 规则。
        int spatial = SndSpecText.TypeGlobal() | SndSpecText.TypeScreen()
            | SndSpecText.TypeLocal();
        if ((sp.typeBits & spatial) == 0) {
            int fallback = defs.defTypes & spatial;
            if (fallback != 0) {
                for (int bit = 1; bit <= 4; bit = bit << 1) {
                    if ((fallback & bit) != 0) {
                        sp.typeBits = sp.typeBits | bit;
                        break;
                    }
                }
            }
        }
        List<string> fshift = SndSpecText.Tokens(sec.Get("FShift"));
        if (fshift.Count > 0) {
            sp.fShiftSet = true;
            sp.fShiftMin = SndSpecText.ToInt(fshift[0], 0);
            sp.fShiftMax = fshift.Count > 1
                ? SndSpecText.ToInt(fshift[1], sp.fShiftMin) : sp.fShiftMin;
        }
        sp.limit = sec.GetIntOr("Limit", defs.defLimit);
        sp.loop = sec.GetIntOr("Loop", 0);
        sp.minVolume = sec.GetIntOr("MinVolume", defs.defMinVolume);
        string vshiftRaw = sec.Get("Vshift");
        if (vshiftRaw.Length == 0) { vshiftRaw = sec.Get("VShift"); }
        List<string> vshift = SndSpecText.Tokens(vshiftRaw);
        if (vshift.Count > 0) {
            sp.vShiftSet = true;
            sp.vShiftMin = SndSpecText.ToInt(vshift[0], 0);
            sp.vShiftMax = vshift.Count > 1
                ? SndSpecText.ToInt(vshift[1], sp.vShiftMin) : sp.vShiftMin;
        }
        sp.attack = sec.GetIntOr("Attack", 0);
        sp.decay = sec.GetIntOr("Decay", 0);
        return sp;
    }

    int Count() { return this.specs.Count; }

    /// <summary>Case-insensitive lookup by sound.ini section name.</summary>
    SoundSpec Spec(string name) {
        if (name == null || name.Length == 0) { return null; }
        for (int i = 0; i < this.specs.Count; i = i + 1) {
            if (SndSpecText.SameWord(this.specs[i].name, name)) {
                return this.specs[i];
            }
        }
        return null;
    }

    SoundSpec At(int i) { return this.specs[i]; }
}
