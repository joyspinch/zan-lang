using System;
using System.Collections.Generic;
using Ra2.Formats;

namespace Ra2.Assets;

/// <summary>An RGBA8888 image in memory, four bytes per pixel.</summary>
///
/// Palette index 0 is transparent everywhere in RA2's art, so it becomes a
/// fully transparent pixel rather than whatever colour sits in slot 0.
class Texture {

    byte[] pixels;
    int width;
    int height;

    static Texture Create(int width, int height) {
        Texture t = new Texture();
        t.width = width;
        t.height = height;
        t.pixels = new byte[width * height * 4 + 1];
        return t;
    }

    /// <summary>Converts an 8-bit palette-index buffer to RGBA.</summary>
    static Texture FromIndexed(string indices, int width, int height, Palette pal) {
        Texture t = Texture.Create(width, height);
        int n = width * height;
        for (int i = 0; i < n; i = i + 1) {
            int idx = indices[i] & 0xFF;
            if (idx != 0) {
                t.SetPixel(i, pal.R8(idx), pal.G8(idx), pal.B8(idx), 255);
            }
        }
        return t;
    }

    /// <summary>As FromIndexed, but for TMP terrain tiles: index 0 and the
    /// native magenta key (6-bit 63,0,63) are both transparent. Terrain art
    /// uses magenta, not index 0, for the holes around a tile's diamond --
    /// decoding with FromIndexed leaves those as raw magenta, which painted
    /// bright pink wedges at the map's edges (no SHP index-4 shadow slot
    /// exists in terrain art, so that case does not apply here).</summary>
    static Texture FromIndexedTmp(string indices, int width, int height,
                                  Palette pal) {
        Texture t = Texture.Create(width, height);
        int n = width * height;
        for (int i = 0; i < n; i = i + 1) {
            int idx = indices[i] & 0xFF;
            if (idx != 0 && !pal.IsMagenta(idx)) {
                t.SetPixel(i, pal.R8(idx), pal.G8(idx), pal.B8(idx), 255);
            }
        }
        return t;
    }

    /// <summary>As FromIndexed, but with the TS/RA2 SHP conventions: index
    /// 0 is transparent, index 4 -- the shadow slot the unit palettes carry
    /// as a reserved placeholder colour -- decodes to the translucent black
    /// the engine paints for a sprite's baked shadow, and the native magenta
    /// key (6-bit 63,0,63) marks transparency in palettes that kept it.</summary>
    static Texture FromIndexedShp(string indices, int width, int height,
                                  Palette pal) {
        Texture t = Texture.Create(width, height);
        int n = width * height;
        for (int i = 0; i < n; i = i + 1) {
            int idx = indices[i] & 0xFF;
            if (idx == 4) {
                t.SetPixel(i, 0, 0, 0, 110);
            } else if (idx != 0 && !pal.IsMagenta(idx)) {
                t.SetPixel(i, pal.R8(idx), pal.G8(idx), pal.B8(idx), 255);
            }
        }
        return t;
    }

    /// <summary>Converts a PCX image, which carries its own 8-bit palette.</summary>
    ///
    /// Unlike sprite art, a shell backdrop is fully opaque -- index 0 is a real
    /// colour there, not transparency -- so every pixel is written.
    static Texture FromPcx(PcxImage img) {
        Texture t = Texture.Create(img.Width(), img.Height());
        int n = img.Width() * img.Height();
        byte[] idx = img.Indices();
        for (int i = 0; i < n; i = i + 1) {
            int v = idx[i] & 0xFF;
            t.SetPixel(i, img.R(v), img.G(v), img.B(v), 255);
        }
        return t;
    }

    int Width() { return this.width; }
    int Height() { return this.height; }
    byte[] Pixels() { return this.pixels; }
    int ByteLength() { return this.width * this.height * 4; }

    void SetPixel(int at, int r, int g, int b, int a) {
        int o = at * 4;
        this.pixels[o] = (byte)r;
        this.pixels[o + 1] = (byte)g;
        this.pixels[o + 2] = (byte)b;
        this.pixels[o + 3] = (byte)a;
    }

    /// <summary>The packed 0xAARRGGBB value of a pixel.</summary>
    int PixelAt(int x, int y) {
        if (x < 0 || y < 0 || x >= this.width || y >= this.height) { return 0; }
        int o = (y * this.width + x) * 4;
        return ((this.pixels[o + 3] & 0xFF) << 24) | ((this.pixels[o] & 0xFF) << 16)
             | ((this.pixels[o + 1] & 0xFF) << 8) | (this.pixels[o + 2] & 0xFF);
    }

    /// <summary>Copies another texture in at (dx, dy), skipping transparent
    /// pixels so overlapping sprites composite correctly. The clip window
    /// and per-row offsets are resolved once up front -- the terrain
    /// composite calls this once per visible cell, so the inner loop runs
    /// the row span with no per-pixel bounds checks.</summary>
    void Blit(Texture src, int dx, int dy) {
        int sw = src.Width();
        int sh = src.Height();
        byte[] sp = src.Pixels();
        byte[] dp = this.pixels;
        int x0 = dx < 0 ? 0 - dx : 0;
        int y0 = dy < 0 ? 0 - dy : 0;
        int x1 = dx + sw > this.width ? this.width - dx : sw;
        int y1 = dy + sh > this.height ? this.height - dy : sh;
        if (x0 >= x1 || y0 >= y1) { return; }
        int so = (y0 * sw + x0) * 4;
        int to = ((dy + y0) * this.width + dx + x0) * 4;
        int rowStepS = sw * 4;
        int rowStepD = this.width * 4;
        for (int y = y0; y < y1; y = y + 1) {
            int s = so;
            int t = to;
            for (int x = x0; x < x1; x = x + 1) {
                if (sp[s + 3] != 0) {
                    dp[t] = sp[s];
                    dp[t + 1] = sp[s + 1];
                    dp[t + 2] = sp[s + 2];
                    dp[t + 3] = sp[s + 3];
                }
                s = s + 4;
                t = t + 4;
            }
            so = so + rowStepS;
            to = to + rowStepD;
        }
    }

    void Close() {
        this.pixels = null;
        this.width = 0;
        this.height = 0;
    }

    /// <summary>As Blit, but each source pixel's colour is scaled by the
    /// per-mille factors (1000 = unchanged) -- how the engine applies the
    /// map lighting to a sprite: tint * intensity, the reference's
    /// per-vertex colour multiply. Alpha rides through untouched, so a
    /// sprite's baked shadow stays a shadow.</summary>
    void BlitShaded(Texture src, int dx, int dy, int rM, int gM, int bM) {
        int sw = src.Width();
        int sh = src.Height();
        byte[] sp = src.Pixels();
        byte[] dp = this.pixels;
        int x0 = dx < 0 ? 0 - dx : 0;
        int y0 = dy < 0 ? 0 - dy : 0;
        int x1 = dx + sw > this.width ? this.width - dx : sw;
        int y1 = dy + sh > this.height ? this.height - dy : sh;
        if (x0 >= x1 || y0 >= y1) { return; }
        int so = (y0 * sw + x0) * 4;
        int to = ((dy + y0) * this.width + dx + x0) * 4;
        int rowStepS = sw * 4;
        int rowStepD = this.width * 4;
        for (int y = y0; y < y1; y = y + 1) {
            int s = so;
            int t = to;
            for (int x = x0; x < x1; x = x + 1) {
                if (sp[s + 3] != 0) {
                    int r = (sp[s] & 0xFF) * rM / 1000;
                    int g = (sp[s + 1] & 0xFF) * gM / 1000;
                    int b = (sp[s + 2] & 0xFF) * bM / 1000;
                    dp[t] = (byte)(r > 255 ? 255 : r);
                    dp[t + 1] = (byte)(g > 255 ? 255 : g);
                    dp[t + 2] = (byte)(b > 255 ? 255 : b);
                    dp[t + 3] = sp[s + 3];
                }
                s = s + 4;
                t = t + 4;
            }
            so = so + rowStepS;
            to = to + rowStepD;
        }
    }
}
