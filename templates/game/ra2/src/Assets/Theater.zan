using System;
using System.Collections.Generic;
using Ra2.Formats;
using Ra2.Game;

namespace Ra2.Assets;

/// <summary>One entry of a theater's tile set table.</summary>
///
/// A set groups the variants of one kind of ground -- "Cliff Set", "Shore
/// Pieces". Tile ids in IsoMapPack5 are a single sequence running across all
/// sets in declaration order, so a set owns the ids [firstId, firstId+count).
class TileSet {
    string name;
    string fileName;
    int count;
    int firstId;

    string Name() { return this.name; }
    string FileName() { return this.fileName; }
    int Count() { return this.count; }
    int FirstId() { return this.firstId; }
    bool Contains(int tileId) {
        return tileId >= this.firstId && tileId < this.firstId + this.count;
    }
}

/// <summary>A theater's terrain art: the tile set table from its .ini plus the
/// TMP templates the sets name, decoded to RGBA on demand.</summary>
///
/// Templates are cached because a map draws the same few hundred tiles over
/// and over, and each decode is a palette conversion over ~1800 pixels.
class TileCacheEntry {
    int key;
    Texture texture;
    int offsetX;
    int offsetY;
}

/// <summary>A decoded TMP template kept for terrain queries. Null `tmp`
/// means "looked up and absent", which is distinct from "not looked up".</summary>
class TileTemplateEntry {
    int key;
    TmpTemplate tmp;
}

/// <summary>One subtile's terrain classification, lifted out of the TMP
/// header so callers that only ask "what is this cell" do not hold the
/// whole template.</summary>
class SubTileInfo {
    int terrainType;
    int rampType;
    int height;

    int TerrainType() { return this.terrainType; }
    int RampType() { return this.rampType; }
    int Height() { return this.height; }
}

class Theater {
    Vfs vfs;

    /// <summary>The install's virtual file system, for game-side art probes
    /// (impact anim frame counts) that do not belong to the render side.</summary>
    Vfs Vfs() { return this.vfs; }
    string name;
    string extension;
    Palette palette;
    List<TileSet> sets;
    int tileCount;

    // A null texture means "looked up and not present", which is distinct
    // from "not looked up yet".
    List<TileCacheEntry> cache;

    // Decoded TMP templates, keyed by tile id. Separate from `cache` above
    // because terrain classification needs the template's header (terrain
    // type, ramp flag, height) without ever building an RGBA texture.
    List<TileTemplateEntry> tmpCache;

    /// <summary>The theater matching a map's Theater= value. Falls back to
    /// temperate, which every install has.</summary>
    static Theater Load(Vfs vfs, AssetDb db, string theaterName) {
        Theater t = new Theater();
        t.vfs = vfs;
        t.name = theaterName.ToUpper();
        t.sets = new List<TileSet>();
        t.cache = new List<TileCacheEntry>();
        t.tmpCache = new List<TileTemplateEntry>();

        string ini = Theater.IniNameFor(t.name);
        t.extension = Theater.ExtensionFor(t.name);
        t.palette = db.PaletteNamed(Theater.PaletteNameFor(t.name));

        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = vfs.Read(ini, len);
        if (len[0] == 0) { return t; }
        IniDocument doc = IniParser.Parse(raw);

        int setIndex = 0;
        int nextId = 0;
        while (true) {
            IniSection s = doc.Section("TileSet" + Theater.Pad4(setIndex));
            if (s == null) { break; }
            TileSet ts = new TileSet();
            ts.name = s.GetOr("SetName", "");
            ts.fileName = s.GetOr("FileName", "");
            ts.count = s.GetIntOr("TilesInSet", 0);
            ts.firstId = nextId;
            t.sets.Add(ts);
            nextId = nextId + ts.count;
            setIndex = setIndex + 1;
        }
        t.tileCount = nextId;
        return t;
    }

    static string Pad4(int n) {
        string s = Convert.ToString(n);
        while (s.Length < 4) { s = "0" + s; }
        return s;
    }

    // Theater art is keyed off three names that do not follow one rule, so
    // they are spelled out rather than derived.
    static string IniNameFor(string theater) {
        if (theater == "SNOW") { return "SNOW.INI"; }
        if (theater == "URBAN") { return "URBAN.INI"; }
        if (theater == "NEWURBAN") { return "URBANN.INI"; }
        if (theater == "LUNAR") { return "LUNAR.INI"; }
        if (theater == "DESERT") { return "DESERT.INI"; }
        return "TEMPERAT.INI";
    }

    /// The suffix of a theater's TMP files: CLEAR01.TEM for temperate,
    /// CLEAR01.SNO for snow, and so on.
    static string ExtensionFor(string theater) {
        if (theater == "SNOW") { return ".SNO"; }
        if (theater == "URBAN") { return ".URB"; }
        if (theater == "NEWURBAN") { return ".UBN"; }
        if (theater == "LUNAR") { return ".LUN"; }
        if (theater == "DESERT") { return ".DES"; }
        return ".TEM";
    }

    static string PaletteNameFor(string theater) {
        if (theater == "SNOW") { return "ISOSNO.PAL"; }
        if (theater == "URBAN") { return "ISOURB.PAL"; }
        if (theater == "NEWURBAN") { return "ISOUBN.PAL"; }
        if (theater == "LUNAR") { return "ISOLUN.PAL"; }
        if (theater == "DESERT") { return "ISODES.PAL"; }
        return "ISOTEM.PAL";
    }

    string Name() { return this.name; }
    Palette TilePalette() { return this.palette; }
    int SetCount() { return this.sets.Count; }
    TileSet SetAt(int i) { return this.sets[i]; }
    int TileCount() { return this.tileCount; }

    /// <summary>The tile-id ranges that are water, as first,count pairs, read
    /// off this theater's own set table: every set whose name says water
    /// ("Water" 314-327, "ZMM Water" 769-782, "Water Caves", the waterfalls)
    /// counts, and the bridge sets do not -- a bridge spans water but a
    /// vehicle drives over it. This is what decides where a building may
    /// stand, so a snow or urban map needs its own table, not temperate's
    /// numbers.</summary>
    List<int> WaterRanges() {
        List<int> outRanges = new List<int>();
        for (int i = 0; i < this.sets.Count; i = i + 1) {
            TileSet ts = this.sets[i];
            if (ts.Count() <= 0) { continue; }
            string nm = ts.Name().ToLower();
            if (!Theater.HasWord(nm, "water")) { continue; }
            if (Theater.HasWord(nm, "bridge")) { continue; }
            outRanges.Add(ts.FirstId());
            outRanges.Add(ts.Count());
        }
        return outRanges;
    }

    static bool HasWord(string hay, string word) {
        int n = word.Length;
        if (n == 0 || hay.Length < n) { return false; }
        for (int i = 0; i + n <= hay.Length; i = i + 1) {
            if (hay.Substring(i, n) == word) { return true; }
        }
        return false;
    }

    /// Cell records use 0xFFFF to mean "no tile chosen", which the engine draws
    /// as plain clear terrain rather than as a hole -- on MP02T2 that is 1551
    /// cells, and treating it as missing art punches black diamonds through the
    /// middle of the map.
    static int ClearTile = 0xFFFF;

    /// <summary>The set owning a tile id, or null when the id is out of range.
    /// Sets are contiguous and in order, so this is a scan over ~80 entries.</summary>
    static int NormalizeTile(int tileId) {
        if (tileId == Theater.ClearTile) { return 0; }
        return tileId;
    }

    TileSet SetForTile(int tileId) {
        int id = Theater.NormalizeTile(tileId);
        for (int i = 0; i < this.sets.Count; i = i + 1) {
            if (this.sets[i].Contains(id)) { return this.sets[i]; }
        }
        return null;
    }

    /// <summary>The TMP file backing a tile id, e.g. tile 49 -> "CLIFF01.TEM".
    /// The variant number is the tile's offset within its set, one-based.</summary>
    string FileForTile(int tileId) {
        TileSet ts = this.SetForTile(tileId);
        if (ts == null) { return ""; }
        if (ts.FileName().Length == 0) { return ""; }
        int variant = Theater.NormalizeTile(tileId) - ts.FirstId() + 1;
        string num = Convert.ToString(variant);
        if (variant < 10) { num = "0" + num; }
        return ts.FileName().ToUpper() + num + this.extension;
    }

    /// <summary>A tile's graphic as RGBA, or null when the theater has no art
    /// for it. Cached; the caller must not free the result.</summary>
    ///
    /// The base diamond and the extra (cliff/bridge overhang) graphic are
    /// composited into one texture, with the origin shifted so the extra art
    /// fits: a cliff's overhang reaches above and left of the diamond, and
    /// dropping it leaves a transparent hole wherever raised ground rose above
    /// its neighbours. DrawOffsetX/Y report the shift so the renderer can
    /// place the result against the cell's apex.
    Texture TileTexture(int tileId, int subTile) {
        int key = tileId * 256 + subTile;
        for (int i = 0; i < this.cache.Count; i = i + 1) {
            if (this.cache[i].key == key) { return this.cache[i].texture; }
        }

        Texture tex = null;
        int offX = 0;
        int offY = 0;
        // The clear-terrain sentinel keeps whatever subtile the cell recorded,
        // which need not exist in CLEAR01; fall back to the first.
        int sub = subTile;
        if (tileId == Theater.ClearTile) { sub = 0; }
        string file = this.FileForTile(tileId);
        if (file.Length > 0 && this.palette != null) {
            List<int> len = new List<int>();
            len.Add(0);
            byte[] raw = this.vfs.Read(file, len);
            if (len[0] > 0) {
                TmpTemplate tmp = TmpTemplate.Parse(raw, len[0]);
                if (sub < tmp.TileCount()) {
                    TmpTile t = tmp.TileAt(sub);
                    if (Theater.Trace()) {
                        Console.WriteLine("tex tile=" + Convert.ToString(tileId)
                            + " sub=" + Convert.ToString(sub) + " " + file
                            + " extra=" + (t != null && t.HasExtra() ? 1 : 0)
                            + " off=" + (t != null ? t.ExtraOff() : 0)
                            + " rect=" + (t != null ? t.ExtraOffsetX() : 0) + ","
                            + (t != null ? t.ExtraOffsetY() : 0)
                            + " " + (t != null ? t.ExtraWidth() : 0) + "x"
                            + (t != null ? t.ExtraHeight() : 0));
                    }
                    int baseW = tmp.TileWidth();
                    int baseH = tmp.TileHeight();

                    // Union of the diamond (at 0,0) and the extra rectangle.
                    int minX = 0;
                    int minY = 0;
                    int maxX = baseW;
                    int maxY = baseH;
                    if (t != null && t.HasExtra()) {
                        int ex = t.ExtraOffsetX();
                        int ey = t.ExtraOffsetY();
                        if (ex < minX) { minX = ex; }
                        if (ey < minY) { minY = ey; }
                        if (ex + t.ExtraWidth() > maxX) { maxX = ex + t.ExtraWidth(); }
                        if (ey + t.ExtraHeight() > maxY) { maxY = ey + t.ExtraHeight(); }
                    }
                    offX = minX;
                    offY = minY;

                    tex = Texture.Create(maxX - minX, maxY - minY);
                    // The extra art goes down first: the diamond is the ground
                    // surface and has to sit on top of the overhang behind it.
                    if (t != null && t.HasExtra()) {
                        byte[] ei = tmp.DecodeExtra(sub);
                        Texture etex = Texture.FromIndexedTmp(ei, t.ExtraWidth(),
                                                              t.ExtraHeight(), this.palette);
                        tex.Blit(etex, t.ExtraOffsetX() - minX, t.ExtraOffsetY() - minY);
                        etex.Close();
                    }
                    byte[] idx = tmp.DecodeTile(sub);
                    Texture btex = Texture.FromIndexedTmp(idx, baseW, baseH, this.palette);
                    tex.Blit(btex, 0 - minX, 0 - minY);
                    btex.Close();
                }
            }
        }

        TileCacheEntry entry = new TileCacheEntry();
        entry.key = key;
        entry.texture = tex;
        entry.offsetX = offX;
        entry.offsetY = offY;
        this.cache.Add(entry);
        return tex;
    }

    /// <summary>The TMP template backing a tile id, decoded on demand and
    /// kept. Terrain classification asks for this for nearly every cell of
    /// the map, so the decode is cached separately from the RGBA texture --
    /// a passability query must not pay a palette conversion, and must
    /// still answer on a headless run where no texture is ever built.</summary>
    TmpTemplate TileTemplate(int tileId) {
        for (int i = 0; i < this.tmpCache.Count; i = i + 1) {
            if (this.tmpCache[i].key == tileId) { return this.tmpCache[i].tmp; }
        }
        TileTemplateEntry e = new TileTemplateEntry();
        e.key = tileId;
        e.tmp = null;
        string file = this.FileForTile(tileId);
        if (file.Length > 0) {
            List<int> len = new List<int>();
            len.Add(0);
            byte[] raw = this.vfs.Read(file, len);
            if (len[0] > 0) { e.tmp = TmpTemplate.Parse(raw, len[0]); }
        }
        this.tmpCache.Add(e);
        return e.tmp;
    }

    /// <summary>Where a cached tile's texture sits relative to the cell apex.
    /// Non-zero when a cliff's overhang reaches above or left of the diamond.</summary>
    int DrawOffsetX(int tileId, int subTile) {
        int i = this.CacheSlot(tileId, subTile);
        if (i < 0) { return 0; }
        return this.cache[i].offsetX;
    }

    // ---- terrain classification -------------------------------------
    //
    // The reference reads a cell's terrain class from the TMP template the
    // cell's tile id names (`TileCollection.ts:100-113`: `getTileImage`
    // then `tileImage.terrainType`, with `isCliffTile` as a second
    // opinion). This port does the same, so a cell's land class comes from
    // the art the map actually placed rather than from an id range.

    /// <summary>A cell's TMP terrain-type byte, or -1 when the tile has no
    /// art. The sentinel is distinct from every real byte (0..15).</summary>
    int CellTerrainType(int tileId, int subTile) {
        SubTileInfo si = this.SubTileOf(tileId, subTile);
        if (si == null) { return -1; }
        return si.terrainType;
    }

    /// <summary>A cell's ramp flag. Non-zero is the only legal way for a
    /// ground unit to change height, which is why it is read per cell and
    /// not derived from the elevation byte.</summary>
    int CellRampType(int tileId, int subTile) {
        SubTileInfo si = this.SubTileOf(tileId, subTile);
        if (si == null) { return 0; }
        return si.rampType;
    }

    /// <summary>A cell's own height byte from its TMP template. This is the
    /// template's elevation, not the map's level byte: the pack's `level`
    /// is a per-cell override the editor writes for raised terrain, while
    /// the template height classifies the art.</summary>
    int CellTemplateHeight(int tileId, int subTile) {
        SubTileInfo si = this.SubTileOf(tileId, subTile);
        if (si == null) { return 0; }
        return si.height;
    }

    /// <summary>A cell's land class, or null when the tile is the map's
    /// clear-terrain sentinel or has no art.
    ///
    /// A null answer means "unknown", not "impassable": the caller falls
    /// back to the set-name heuristic so a partly-installed theater still
    /// renders and plays.</summary>
    LandType CellLandType(int tileId, int subTile) {
        int tt = this.CellTerrainType(tileId, subTile);
        if (tt < 0) { return null; }
        return LandType.Of(LandType.FromTerrainType(tt));
    }

    /// <summary>The classification triple of one subtile, or null.</summary>
    SubTileInfo SubTileOf(int tileId, int subTile) {
        TmpTemplate tmp = this.TileTemplate(tileId);
        if (tmp == null) { return null; }
        int sub = subTile;
        if (tileId == Theater.ClearTile) { sub = 0; }
        if (sub < 0 || sub >= tmp.TileCount()) { return null; }
        TmpTile t = tmp.TileAt(sub);
        if (t == null) { return null; }
        SubTileInfo si = new SubTileInfo();
        si.terrainType = t.TerrainType();
        si.rampType = t.RampType();
        si.height = t.Height();
        return si;
    }
    int DrawOffsetY(int tileId, int subTile) {
        int i = this.CacheSlot(tileId, subTile);
        if (i < 0) { return 0; }
        return this.cache[i].offsetY;
    }

    int CacheSlot(int tileId, int subTile) {
        int key = tileId * 256 + subTile;
        for (int i = 0; i < this.cache.Count; i = i + 1) {
            if (this.cache[i].key == key) { return i; }
        }
        return -1;
    }

    // Terrain-object sprites ([Terrain] trees and rocks), cached by name the
    // way tiles are cached by id: a busy map repeats the same few species.
    List<string> tSpriteNames;
    List<Texture> tSpriteTex;
    // Map smudge decals (craters, burn marks), cached by reg name.
    List<string> smSpriteNames;
    List<Texture> smSpriteTex;

    /// <summary>The terrain object's frame-0 sprite, or null when the theater
    /// has no art for the name. Cached; the caller must not free it.</summary>
    ///
    /// Terrain objects are Theater=yes art: the shipped trees live in the
    /// theater mixes under the theater's own extension (TREE05.TEM in
    /// TEMPERAT.MIX), so the extension first, the plain SHP second.
    Texture TerrainSprite(string name) {
        if (this.tSpriteNames == null) {
            this.tSpriteNames = new List<string>();
            this.tSpriteTex = new List<Texture>();
        }
        int hit = -1;
        for (int i = 0; i < this.tSpriteNames.Count; i = i + 1) {
            if (this.tSpriteNames[i] == name) { hit = i; break; }
        }
        // A cached null means the install carries neither file for this
        // name; that is sticky (the mounts will not grow the file), so it
        // skips the retry rather than falling through to re-read.
        if (hit >= 0) { return this.tSpriteTex[hit]; }
        Texture tex = this.LoadTerrainFrame(name + this.extension);
        if (tex == null) {
            tex = this.LoadTerrainFrame(name + ".SHP");
        }
        this.tSpriteNames.Add(name);
        this.tSpriteTex.Add(tex);
        return tex;
    }

    Texture LoadTerrainFrame(string file) {
        return this.LoadShpFrameAt(file, 0);
    }

    /// <summary>A map smudge decal's art (CRATER07, BURNT02), or null when
    /// the install carries none. Smudge art is Theater=yes, so the shipped
    /// file puts the theater's own letter in the name's second slot --
    /// CRATER07.SHP becomes CRAtER07.SHP on a temperate map, and the theater
    /// extension (CRATER07.TEM) is the other spelling -- so all three
    /// spellings are tried before giving up. Every smudge name is cached,
    /// misses included: the fallback decal is the caller's, and a re-read per
    /// draw would cost more than the miss.</summary>
    Texture SmudgeSprite(string name) {
        if (this.smSpriteNames == null) {
            this.smSpriteNames = new List<string>();
            this.smSpriteTex = new List<Texture>();
        }
        int hit = -1;
        for (int i = 0; i < this.smSpriteNames.Count; i = i + 1) {
            if (this.smSpriteNames[i] == name) { hit = i; break; }
        }
        if (hit >= 0) { return this.smSpriteTex[hit]; }
        Texture tex = this.LoadShpFrameAt(name + this.extension, 0);
        if (tex == null) {
            tex = this.LoadShpFrameAt(name + ".SHP", 0);
        }
        if (tex == null) {
            string th = Theater.TheaterLetter(this.name);
            if (th.Length > 0 && name.Length >= 2) {
                // Second character is the theater slot in these names.
                string alt = name.Substring(0, 1) + th
                           + name.Substring(2);
                tex = this.LoadShpFrameAt(alt + this.extension, 0);
                if (tex == null) { tex = this.LoadShpFrameAt(alt + ".SHP", 0); }
            }
        }
        this.smSpriteNames.Add(name);
        this.smSpriteTex.Add(tex);
        return tex;
    }

    /// <summary>The one-letter theater code RA2 puts in a Theater=yes art
    /// file's second character slot: t temperate, a snow, u urban, l lunar,
    /// d desert. Empty when the theater is not one of those.</summary>
    static string TheaterLetter(string theater) {
        if (theater == "TEMPERATE") { return "t"; }
        if (theater == "SNOW") { return "a"; }
        if (theater == "URBAN" || theater == "NEWURBAN") { return "u"; }
        if (theater == "LUNAR") { return "l"; }
        if (theater == "DESERT") { return "d"; }
        return "";
    }

    // ---- map overlays (ore, walls, bridges) -------------------------------

    /// Overlay art is Theater=yes too: the shipped ore lives in the theater
    /// mixes as GEM01.TEM .. GEM12.TEM, 60x60 with 24 frames -- one frame per
    /// wealth level. rulesmd.ini's [GEM01..12] Theater=yes is the flag that
    /// says so, and the engine does not look for a plain GEM01.SHP. Each
    /// overlay sprite is cached by {name, frame}; a busy field repeats the
    /// same handful of (kind, amount) pairs, so a small cache serves a whole
    /// map.
    List<string> oNames;
    List<int> oFrames;
    List<Texture> oTex;

    /// <summary>The overlay's sprite at a given frame, or null when the
    /// theater has no art for the name. Cached; the caller must not free
    /// it.</summary>
    Texture OverlaySprite(string name, int frame) {
        if (this.oNames == null) {
            this.oNames = new List<string>();
            this.oFrames = new List<int>();
            this.oTex = new List<Texture>();
        }
        int hit = -1;
        for (int i = 0; i < this.oNames.Count; i = i + 1) {
            if (this.oNames[i] == name && this.oFrames[i] == frame) {
                hit = i; break;
            }
        }
        // A cached null means neither the theater-suffixed nor the plain SHP
        // holds the name; sticky, so it is not re-read every frame.
        if (hit >= 0) { return this.oTex[hit]; }
        Texture tex = this.LoadShpFrameAt(name + this.extension, frame);
        if (tex == null) {
            tex = this.LoadShpFrameAt(name + ".SHP", frame);
        }
        this.oNames.Add(name);
        this.oFrames.Add(frame);
        this.oTex.Add(tex);
        return tex;
    }

    /// <summary>How many usable frames an overlay's art carries (the ore
    /// wealth levels), or 0 when the install has no art for the name. The
    /// shipped GEM files declare 24 frames but only the leading ones carry
    /// pixels -- the tail is empty -- so the count is the leading run of
    /// non-empty frames, which is what a wealth byte can index. Read once per
    /// name so a per-frame draw can clamp to it.</summary>
    List<string> oCountNames;
    List<int> oCounts;

    int OverlayFrameCount(string name) {
        if (this.oCountNames == null) {
            this.oCountNames = new List<string>();
            this.oCounts = new List<int>();
        }
        for (int i = 0; i < this.oCountNames.Count; i = i + 1) {
            if (this.oCountNames[i] == name) { return this.oCounts[i]; }
        }
        int n = 0;
        ShpImage shp = this.OpenShp(name + this.extension);
        if (shp == null) { shp = this.OpenShp(name + ".SHP"); }
        if (shp != null) {
            for (int f = 0; f < shp.FrameCount(); f = f + 1) {
                ShpFrame fr = shp.FrameAt(f);
                if (fr == null || fr.IsEmpty()) { break; }
                n = n + 1;
            }
        }
        if (n < 0) { n = 0; }
        this.oCountNames.Add(name);
        this.oCounts.Add(n);
        return n;
    }

    // The low bridges' assembled art: the reference's buildVirtualBridgeFile
    // stitches LOBRDG01..26 (wood) or LOBRDB01..26 (concrete) -- one SHP per
    // piece variant -- into one virtual file whose frame k is variant k, so
    // a piece draws its own id as a frame index. Each variant is its own SHP
    // here, cached by (type, frame); the sprite is the piece's whole
    // three-cell span.
    List<int> loBrKeys;
    List<Texture> loBrTex;

    /// <summary>The low-bridge variant sprite for a bridge type and frame
    /// (the piece's overlay value), or null when the install carries none.
    /// Cached; the caller must not free it.</summary>
    Texture LowBridgeSprite(bool concrete, int frame) {
        if (frame < 0) { frame = 0; }
        if (frame > 25) { frame = 25; }
        int key = (concrete ? 1 : 0) * 100 + frame;
        if (this.loBrKeys == null) {
            this.loBrKeys = new List<int>();
            this.loBrTex = new List<Texture>();
        }
        for (int i = 0; i < this.loBrKeys.Count; i = i + 1) {
            if (this.loBrKeys[i] == key) { return this.loBrTex[i]; }
        }
        string name = (concrete ? "LOBRDB" : "LOBRDG")
            + (frame + 1 < 10 ? "0" : "") + Convert.ToString(frame + 1);
        Texture tex = this.LoadShpFrameAt(name + this.extension, 0);
        if (tex == null) { tex = this.LoadShpFrameAt(name + ".SHP", 0); }
        this.loBrKeys.Add(key);
        this.loBrTex.Add(tex);
        return tex;
    }

    ShpImage OpenShp(string file) {
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.vfs.Read(file, len);
        if (len[0] == 0) { return null; }
        return ShpImage.Parse(raw, len[0]);
    }

    Texture LoadShpFrameAt(string file, int frame) {
        if (this.palette == null) { return null; }
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.vfs.Read(file, len);
        if (len[0] == 0) { return null; }
        ShpImage shp = ShpImage.Parse(raw, len[0]);
        int want = frame;
        if (want < 0) { want = 0; }
        if (want >= shp.FrameCount()) { want = shp.FrameCount() - 1; }
        ShpFrame f = shp.FrameAt(want);
        if (f == null || f.IsEmpty()) { return null; }
        byte[] idx = shp.DecodeFrame(want);
        if (shp.Width() > f.Width() || shp.Height() > f.Height()
         || f.X() != 0 || f.Y() != 0) {
            Texture full = Texture.Create(shp.Width(), shp.Height());
            Texture part = Texture.FromIndexed(idx, f.Width(), f.Height(),
                                               this.palette);
            full.Blit(part, f.X(), f.Y());
            part.Close();
            return full;
        }
        return Texture.FromIndexed(idx, f.Width(), f.Height(), this.palette);
    }

    [DllImport("crt")]
    static extern string getenv(string name);

    static bool Trace() {
        string v = Theater.getenv("RA2_TRACE");
        return v != null && v.Length > 0 && v != "0";
    }

    void Close() {
        for (int i = 0; i < this.cache.Count; i = i + 1) {
            if (this.cache[i].texture != null) { this.cache[i].texture.Close(); }
        }
        this.cache = new List<TileCacheEntry>();
        if (this.tSpriteTex != null) {
            for (int i = 0; i < this.tSpriteTex.Count; i = i + 1) {
                if (this.tSpriteTex[i] != null) { this.tSpriteTex[i].Close(); }
            }
            this.tSpriteTex = new List<Texture>();
        }
        if (this.oTex != null) {
            for (int i = 0; i < this.oTex.Count; i = i + 1) {
                if (this.oTex[i] != null) { this.oTex[i].Close(); }
            }
            this.oTex = new List<Texture>();
        }
    }
}
