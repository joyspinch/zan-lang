using System;
using System.Collections.Generic;
using Ra2.Assets;
using Ra2.Formats;
using Ra2.Game;

namespace Ra2.Render;

/// <summary>Converts object art -- an SHP frame plus a palette -- to the RGBA
/// textures the renderer blits. Units use the temperate unit palette when the
/// install carries it (unit.pal and unitsno.pal share its 256-slot layout and
/// serve as fallbacks); buildings use the theater palette.</summary>
class ObjectArt {
    Vfs vfs;
    AssetDb db;
    Palette unitPal;
    // Dev aid: the last BakeFacing's projection stats, read by the
    // self-test's decode audit.
    static string bakeStats;
    // The allied unit palette: unitPal with the remap slots recoloured from
    // soviet red to the allied player colour. Built on first use.
    Palette alliedPal;
    // The Soviet unit palette: remap slots recoloured to the shipped Red
    // house colour. Built on first use.
    Palette sovietPal;
    // The Yuri unit palette: remap slots recoloured to the third side's
    // shipped Purple house colour. Built on first use.
    Palette yuriPal;
    Palette theaterPal;
    // The theater palette with the remap slots recoloured per faction --
    // Remapable building art paints its owner-coloured areas from palette
    // entries 16-31, which ship as a bright magenta ramp. Built on first
    // use, one variant per side; neutral structures keep the raw palette.
    Palette theaterAllied;
    Palette theaterSoviet;
    Palette theaterYuri;
    // The loaded map's theater name ("TEMPERATE", "SNOW", ...): NewTheater
    // art files swap their name's second letter against it.
    string theaterName;

    // Per-building art.ini facts, cached by reg: whether the SHP's tail is
    // shadow frames (half the image count is never drawn as art) and the
    // image the Buildup= key names (the real construction animation).
    List<string> bldRegNames;
    List<int> bldShadow;
    List<string> bldBuildup;
    int conditionYellow = 50;  // cached [AudioVisual] ConditionYellow=%

    // SHP name + frame + palette -> decoded texture. The palette is part of
    // the key: unit sprites decode under a per-side palette (the remap
    // slots differ), so two sides share a name and frame but not the pixels.
    // Frame 0 of a building's SHP is the complete structure; the later
    // frames are the construction animation. A missing name is cached as
    // null, which is distinct from "not looked up".
    List<string> shpNames;
    List<int> shpFrames;
    List<Palette> shpPals;
    List<Texture> shpCache;

    // SHP name -> frame count, for the construction-stage mapping.
    List<string> countNames;
    List<int> countVals;

    // Vehicle voxel art: the parsed models, then one baked texture per
    // (model, facing). A bake is a few thousand voxel projections, so the
    // eight facings a vehicle uses are rendered once and reused.
    List<string> vxlNames;
    List<VxlImage> vxlCache;
    List<string> vehNames;
    List<int> vehFacings;
    List<int> vehSides;
    List<Texture> vehTex;

    // Sidebar cameos: <ART>ICON.SHP decoded under CAMEO.PAL (the palette the
    // portraits ship with in CAMEO.MIX; SIDEBAR.PAL is only the stand-in),
    // cached by name. A missing name caches as null so an absent portrait
    // falls back to field art once. Both the unit and the structure path
    // come through LoadCameoShp, so the palette no longer depends on which
    // one happened to draw first.
    Palette cameoPal;
    Palette animPal;     // anim.pal: every impact/smoke anim's own palette
    List<string> cameoNames;
    List<Texture> cameoTex;

    static ObjectArt Create(Vfs vfs, AssetDb db, string theaterName) {
        ObjectArt a = new ObjectArt();
        a.vfs = vfs;
        a.db = db;
        a.theaterName = theaterName == null || theaterName.Length == 0
            ? "TEMPERATE" : theaterName.ToUpper();
        a.shpNames = new List<string>();
        a.shpFrames = new List<int>();
        a.shpPals = new List<Palette>();
        a.shpCache = new List<Texture>();
        a.countNames = new List<string>();
        a.countVals = new List<int>();
        a.vxlNames = new List<string>();
        a.vxlCache = new List<VxlImage>();
        a.vehNames = new List<string>();
        a.vehFacings = new List<int>();
        a.vehSides = new List<int>();
        a.vehTex = new List<Texture>();
        a.cameoPal = null;
        a.cameoNames = new List<string>();
        a.cameoTex = new List<Texture>();
        // The object palette follows the theatre, exactly as the reference
        // keeps one unit palette per theatre (Theater.ts unitPalette):
        // unitsno.pal is the cold ramp that reads as frost on armour and
        // structures -- the shipped game's "snow on every unit" of winter
        // maps -- uniturb.pal the urban one. Temperate stays the fallback
        // for stripped installs (unit.pal / unitsno.pal share the layout).
        string unitPalName = "unittem.pal";
        if (a.theaterName == "SNOW") { unitPalName = "unitsno.pal"; }
        else if (a.theaterName == "URBAN") { unitPalName = "uniturb.pal"; }
        else if (a.theaterName == "NEWURBAN") { unitPalName = "unitubn.pal"; }
        else if (a.theaterName == "DESERT") { unitPalName = "unitdes.pal"; }
        else if (a.theaterName == "LUNAR") { unitPalName = "unitlun.pal"; }
        a.unitPal = db.PaletteNamed(unitPalName);
        if (a.unitPal == null) { a.unitPal = db.PaletteNamed("unittem.pal"); }
        if (a.unitPal == null) { a.unitPal = db.PaletteNamed("unit.pal"); }
        if (a.unitPal == null) { a.unitPal = db.PaletteNamed("unitsno.pal"); }
        a.alliedPal = null;
        a.sovietPal = null;
        a.yuriPal = null;
        a.theaterAllied = null;
        a.theaterSoviet = null;
        a.theaterYuri = null;
        a.bldRegNames = new List<string>();
        a.bldShadow = new List<int>();
        a.bldBuildup = new List<string>();
        IniSection av = db.Rules().Section("AudioVisual");
        if (av != null) {
            int cy = Rules.LeadingInt(av.GetOr("ConditionYellow", ""));
            if (cy > 0) { a.conditionYellow = cy; }
        }
        // Buildings use the same object palette the units do. The reference
        // renderer is explicit about it (ra-map/src/structure_paint.rs: the
        // object palette is unittem.pal, the iso theater palette only a
        // fallback), and the shipped sprites agree: decoding GACNST.SHP's
        // first frame under isotem.pal reproduces the saturated static the
        // yard used to draw as, while unittem.pal gives the grey-and-red
        // construction yard. The iso palette belongs to terrain tiles and
        // smears, not to object art.
        a.theaterPal = a.unitPal;
        if (a.theaterPal == null) { a.theaterPal = db.PaletteNamed("isotem.pal"); }
        if (a.theaterPal == null) { a.theaterPal = db.PaletteNamed("isosno.pal"); }
        // Anims are baked against anim.pal (the theater loads it as its
        // dedicated anim palette); rendering them through the side-remapped
        // unit or theatre palette smears the greys into house colours.
        a.animPal = db.PaletteNamed("anim.pal");
        return a;
    }

    /// <summary>The texture for a structure at a construction progress. The
    /// construction skeleton lives in the art's Buildup= image (a separate
    /// SHP whose frames play from bare site to full building), so a partially
    /// built structure shows that animation and the finished one the main
    /// sprite's frame 0. The main sprite's own tail frames are the shadow
    /// masks and damage states, never construction stages.</summary>
    Texture StructureTexture(int faction, int buildId, StructureCatalog catalog,
                             int progress, int buildTime) {
        return this.StructureTextureOf(catalog.TypeFor(null, faction, buildId),
                                       faction, progress, buildTime,
                                       1, 1);
    }

    /// <summary>The archetype-driven form of StructureTexture: the renderer
    /// resolves the type itself (civ buildings live in the civ catalog), so
    /// it hands the type in directly. hp/maxHp pick the damage frame once
    /// the structure is up; the owner's side picks the remapped palette.</summary>
    Texture StructureTextureOf(StructureType t, int side, int progress,
                               int buildTime, int hp, int maxHp) {
        if (t == null) { return null; }
        string name = t.ShpName();
        if (t.NewTheater()) { name = this.NewTheaterName(name); }
        int visible = this.VisibleFrameCount(t.Reg(), name);
        Palette pal = this.TheaterPalFor(side);
        if (buildTime > 0 && progress < buildTime) {
            // The Buildup= image carries the rising skeleton. Its frames
            // play forward: the earliest progress shows frame 0, and the
            // last frame sits just before the real building takes over.
            string mk = this.BuildupImage(t.Reg());
            if (mk.Length > 0) {
                int mn = this.ShapeFrameCount(mk);
                if (mn > 0) {
                    int stage = progress * mn / buildTime;
                    if (stage >= mn) { stage = mn - 1; }
                    return this.ShapeTextureFrame(mk, stage, pal);
                }
            }
            // No buildup art shipped: hold the finished sprite dim for the
            // wait rather than guess at unrelated frames.
            return this.ShapeTextureFrame(name, 0, pal);
        }
        // Finished: frame 0 healthy, frame 1 damaged. The retail mapping
        // (Building.ts computeDamageType + updateMainObjFrame) is exactly
        // two sprite states: intact above [AudioVisual] ConditionYellow,
        // the damaged frame at or below it -- ConditionRed only drives the
        // fires and smoke, red shares yellow's frame. Frame 2, where a
        // sprite carries one, is the garrisoned state, not "critical".
        int frame = 0;
        if (maxHp > 0 && visible >= 2) {
            int pct = hp * 100 / maxHp;
            if (pct < 0) { pct = 0; }
            frame = pct <= this.conditionYellow ? 1 : 0;
            if (frame >= visible) { frame = visible - 1; }
        }
        return this.ShapeTextureFrame(name, frame, pal);
    }

    /// <summary>How many frames of the structure's sprite are real art. TS/RA2
    /// building sprites pack a shadow mask block behind the image frames, so
    /// a Shadow=yes art section (the default for these sprites) halves the
    /// count; the masks must never be drawn as the building.</summary>
    int VisibleFrameCount(string reg, string shpName) {
        int n = this.ShapeFrameCount(shpName);
        if (n < 2) { return n; }
        int slot = -1;
        for (int i = 0; i < this.bldRegNames.Count; i = i + 1) {
            if (this.bldRegNames[i] == reg) { slot = i; break; }
        }
        if (slot < 0) {
            slot = this.bldRegNames.Count;
            this.bldRegNames.Add(reg);
            bool shadow = true;
            IniSection s = this.db.Art().Section(reg);
            if (s != null && s.Contains("Shadow")) {
                string v = s.GetOr("Shadow", "yes").Trim().ToLower();
                shadow = v != "no" && v != "false";
            }
            this.bldShadow.Add(shadow ? 1 : 0);
            this.bldBuildup.Add(this.LoadBuildupName(reg, s));
            return this.bldShadow[slot] == 1 ? n / 2 : n;
        }
        return this.bldShadow[slot] == 1 ? n / 2 : n;
    }

    /// <summary>The cached Buildup= image name for a reg, resolved to a file
    /// the install actually carries ("" when none). Callers read the art
    /// facts through VisibleFrameCount first, which fills the cache.</summary>
    string BuildupImage(string reg) {
        for (int i = 0; i < this.bldRegNames.Count; i = i + 1) {
            if (this.bldRegNames[i] == reg) {
                return this.bldBuildup[i];
            }
        }
        return "";
    }

    /// <summary>Resolves a building's art Buildup= key to a file name:
    /// the theater spelling first, the plain one second, "" when the install
    /// carries neither.</summary>
    string LoadBuildupName(string reg, IniSection art) {
        if (art == null) { return ""; }
        string img = art.GetOr("Buildup", "");
        if (img.Length < 2) { return ""; }
        string file = img.ToUpper() + ".SHP";
        string theater = this.NewTheaterName(file);
        if (theater != file && this.vfs.Contains(theater)) { return theater; }
        if (this.vfs.Contains(file)) { return file; }
        return "";
    }

    /// <summary>Resolves the file a structure's art really ships as.
    /// NewTheater=yes buildings carry one sprite per theater -- the file
    /// name's second letter is the theater's own (temperate "t", snow "a",
    /// urban "u", lunar "l", desert "d"), so GACNST.SHP on a temperate map
    /// reads GAtcnst.shp -- with the plain name as the fallback when that
    /// theater's file is absent. Mirrors the reference engine's
    /// new_theater_shp_name.</summary>
    /// <summary>The snow-theatre art swap: the shipped rules carry
    /// AlternateArcticArt=yes, so on a snow map an object whose art ships an
    /// arctic variant -- the image name with an A before the extension --
    /// draws that variant, and everything else keeps the common art.
    /// Mirrors the reference's inSnowTheater imageName suffix.</summary>
    string ArcticName(string name) {
        if (this.theaterName != "SNOW") { return name; }
        IniSection general = this.db.Rules().Section("General");
        if (general == null
         || !Rules.YesNo(general.GetOr("AlternateArcticArt", "no"))) {
            return name;
        }
        int dot = name.Length - 4;
        if (dot < 1) { return name; }
        string alt = name.Substring(0, dot) + "A" + name.Substring(dot);
        return this.vfs.Contains(alt) ? alt : name;
    }

    string NewTheaterName(string shpName) {
        int dot = shpName.Length - 4;
        if (dot < 2) { return shpName; }
        string letter = "t";
        string th = this.theaterName;
        if (th == "SNOW") { letter = "a"; }
        else if (th == "URBAN" || th == "NEWURBAN") { letter = "u"; }
        else if (th == "LUNAR") { letter = "l"; }
        else if (th == "DESERT") { letter = "d"; }
        byte[] one = new byte[1];
        one[0] = (byte)(letter[0] & 0xFF);
        string name = shpName.Substring(0, 1)
            + one.ToStr(0, 1) + shpName.Substring(2, dot - 2) + ".SHP";
        if (this.vfs.Contains(name)) { return name; }
        return shpName;
    }

    /// <summary>A unit's art. The stripped install carries a few unit sprites
    /// (dog, spy, sniper); units whose SHP name is empty get a side-coloured
    /// placeholder drawn by the renderer instead.
    ///
    /// Infantry SHPs lay their frames out as the art ini's Sequence= section
    /// describes: a ring of stand poses (one per facing, Ready=0 for GI),
    /// then the walk cycle as one block of frames per facing (Walk=8,6,6 --
    /// start 8, six frames a block). The sprite ring runs counter-clockwise
    /// from north -- N, NW, W, SW, S, SE, E, NE, read off the shipped GI.SHP
    /// -- while the engine's facing ring runs clockwise, so the block a
    /// facing lands on is its mirror (8 - facing). Vehicles are voxels and
    /// bake per facing below.</summary>
    Texture UnitTexture(UnitType ut, bool moving, int animFrame, int facing,
                        int side) {
        return this.UnitTexture(ut, moving, animFrame, facing, side, false);
    }

    /// <summary>As above, with the deployer stance: a sat-down trooper draws
    /// the sequence's Deployed block (GISequence Deployed=292,1,1 -- one
    /// frame per facing) instead of the standing ring.</summary>
    Texture UnitTexture(UnitType ut, bool moving, int animFrame, int facing,
                        int side, bool deployed) {
        return this.UnitTexture(ut, moving, animFrame, facing, side,
                                deployed, 0, 0);
    }

    /// <summary>The firing pose: while fireTicks runs, the sequence's
    /// FireUp block plays once across the countdown, then the trooper
    /// returns to his stand ring. proneState packs the suppression
    /// layer: bit0 suppressed, bit1 the Down/Up pick, bit2 a transition
    /// playing, bits 3+ its two-tick phase.</summary>
    Texture UnitTexture(UnitType ut, bool moving, int animFrame, int facing,
                        int side, bool deployed, int fireTicks,
                        int proneState) {
        if (ut == null) { return null; }
        string name = this.ArcticName(ut.ShpName());
        if (name == null || name.Length == 0) { return null; }
        if (ObjectArt.IsVxlName(name)) {
            return this.VehicleTexture(name, facing, side);
        }
        int ring = (8 - (facing % 8)) % 8;
        int count = this.ShapeFrameCount(name);
        if (deployed && ut.HasDeployedSeq()) {
            int sit = ut.DeployedStart() + ring * ut.DeployedFrames();
            if (sit < count) {
                return this.ShapeTextureFrame(name, sit,
                                              this.UnitPalFor(side));
            }
        }
        if (ut.HasProne() && (proneState & 1) != 0) {
            // Suppressed: the drop/rise transition first, then the prone
            // family -- the still pose, the crawl when moving, the prone
            // firing block while his gun runs.
            if ((proneState & 4) != 0) {
                int seq = (proneState >> 1) & 1;
                int ts = ut.ProneAt(seq == 0 ? 6 : 9);
                int tf = ut.ProneAt(seq == 0 ? 7 : 10);
                int tm = ut.ProneAt(seq == 0 ? 8 : 11);
                if (tf > 0) {
                    int idx = tf - 1 - ((proneState >> 3) & 63);
                    if (idx < 0) { idx = 0; }
                    int tfr = ts + ring * tm + idx;
                    if (tfr < count) {
                        return this.ShapeTextureFrame(name, tfr,
                                                      this.UnitPalFor(side));
                    }
                }
            }
            if (fireTicks > 0) {
                int ffs = ut.ProneAt(12);
                int ffp = ut.ProneAt(13);
                int ffm = ut.ProneAt(14);
                if (ffp > 0) {
                    int pf = ffs + ring * ffm
                        + (ut.FireFrames() - 1 - fireTicks / 2);
                    if (pf < count) {
                        return this.ShapeTextureFrame(name, pf,
                                                      this.UnitPalFor(side));
                    }
                }
            }
            if (moving) {
                int cs = ut.ProneAt(3);
                int cf = ut.ProneAt(4);
                int cm = ut.ProneAt(5);
                if (cf > 0) {
                    int cfr = cs + ring * cm + (animFrame % cf);
                    if (cfr < count) {
                        return this.ShapeTextureFrame(name, cfr,
                                                      this.UnitPalFor(side));
                    }
                }
            }
            int ps = ut.ProneAt(0);
            int pp = ut.ProneAt(1);
            int pm = ut.ProneAt(2);
            if (pp > 0) {
                int pfr = ps + ring * pm;
                if (pfr < count) {
                    return this.ShapeTextureFrame(name, pfr,
                                                  this.UnitPalFor(side));
                }
            }
        }
        if (fireTicks > 0 && ut.HasFire()) {
            int ff = ut.FireFrames() - 1 - fireTicks / 2;
            if (ff < 0) { ff = 0; }
            int fframe = ut.FireStart() + ring * ut.FireMult() + ff;
            if (fframe < count) {
                return this.ShapeTextureFrame(name, fframe,
                                              this.UnitPalFor(side));
            }
        }
        if (ut.HasSeq()) {
            if (moving) {
                int per = ut.WalkFrames();
                int frame = ut.WalkStart() + ring * per + (animFrame % per);
                if (frame >= count) { return this.ShapeTextureFrame(name,
                    ut.ReadyStart() + ring, this.UnitPalFor(side)); }
                return this.ShapeTextureFrame(name, frame,
                                              this.UnitPalFor(side));
            }
            int stand = ut.ReadyStart() + ring;
            if (stand < count) {
                return this.ShapeTextureFrame(name, stand,
                                              this.UnitPalFor(side));
            }
            return this.ShapeTextureFrame(name, 0, this.UnitPalFor(side));
        }
        // No sequence known for this sprite: it is not troop art (the old
        // guard tower crew, civilians), so a single still frame serves.
        return this.ShapeTextureFrame(name, 0, this.UnitPalFor(side));
    }

    /// <summary>A fallen trooper's frame: the death sequence block for
    /// his facing, drawn through his owner's remapped palette. Blocks sit
    /// at start + facing * facingMult (the sequence's stride -- 0 for the
    /// shared death sequences, so they play the same frames whatever way
    /// he faced).</summary>
    Texture CorpseTexture(string shp, int side, int start, int frames,
                          int mult, int idx, int facing) {
        int ring = (8 - (facing % 8)) % 8;
        int frame = start + ring * mult + idx;
        if (frame >= this.ShapeFrameCount(shp)) { return null; }
        return this.ShapeTextureFrame(shp, frame, this.UnitPalFor(side));
    }

    /// <summary>Whether a unit art name names a voxel model rather than
    /// SHP sprite. Case folded, so Image= overrides of any case match.</summary>
    static bool IsVxlName(string name) {
        int dot = name.Length - 4;
        if (dot < 0) { return false; }
        string want = ".VXL";
        for (int i = 0; i < 4; i = i + 1) {
            if ((name[dot + i] & 0xDF) != (want[i] & 0xDF)) { return false; }
        }
        return true;
    }

    /// <summary>The sidebar icon for a trainable unit. The original draws the
    /// unit's cameo portrait, a separate <c>*ICON.SHP</c> per object, but this
    /// trimmed install carries none of them -- every <c>*ICON.SHP</c> is
    /// absent from its mixes while the palettes survived. The button therefore
    /// shows the unit's own field art: the voxel hull baked at the
    /// south-west facing (the cameo viewpoint) for vehicles, the still pose
    /// for infantry.</summary>
    Texture UnitIconTexture(UnitType ut, int side) {
        if (ut == null) { return null; }
        string name = this.ArcticName(ut.ShpName());
        if (name == null || name.Length == 0) { return null; }
        if (ObjectArt.IsVxlName(name)) {
            return this.VehicleTexture(name, 5, side);
        }
        if (this.ShapeFrameCount(name) <= 0) { return null; }
        return this.ShapeTextureFrame(name, 0, this.UnitPalFor(side));
    }

    /// <summary>The sidebar portrait for a trainable unit: the art section's
    /// own Cameo= stem, resolved to <c>&lt;stem&gt;ICON.SHP</c> -- the install
    /// names the picture, it is not derived from the rules name. [CMIN]
    /// draws AHRVICON.SHP, [ENGINEER] ENGNICON.SHP, [GGI] GDGIICON.SHP, and
    /// the Grizzly's art key GTNK draws GTNKICON.SHP; reading
    /// <c>&lt;reg&gt;ICON.SHP</c> instead misses all of those and lands on a
    /// different portrait or on nothing. The portraits decode under
    /// CAMEO.PAL, the palette shipped alongside them in the CAMEO mixes.</summary>
    Texture CameoTexture(UnitType ut) {
        if (ut == null) { return null; }
        string key = ut.Cameo();
        if (key == null || key.Length == 0) {
            string art = ut.ArtKey() != null && ut.ArtKey().Length > 0
                ? ut.ArtKey() : ut.Reg();
            key = art + "ICON";
        }
        string name = key + ".SHP";
        for (int i = 0; i < this.cameoNames.Count; i = i + 1) {
            if (this.cameoNames[i] == name) { return this.cameoTex[i]; }
        }
        // The same loader the structure cameos use: CAMEO.PAL first, the
        // sidebar palette only as the stand-in. Reading the portraits under
        // SIDEBAR.PAL (which is what this path used to do) turns every card
        // into multicoloured noise -- the two palettes are not the same
        // table, and the shipped ICON.SHPs are authored for CAMEO.PAL.
        Texture tex = this.LoadCameoShp(name);
        if (tex == null) {
            string art = ut.ArtKey() != null && ut.ArtKey().Length > 0
                ? ut.ArtKey() : ut.Reg();
            string plain = art + "ICON.SHP";
            if (plain != name) { tex = this.LoadCameoShp(plain); }
        }
        this.cameoNames.Add(name);
        this.cameoTex.Add(tex);
        return tex;
    }

    /// <summary>The build-menu portrait for a structure: the original draws
    /// the art section's Cameo= image -- a dedicated 60x48 ICON.SHP decoded
    /// under CAMEO.PAL -- not a scaled-down field sprite. The name comes
    /// from the rules pipeline (BuildingDef.Cameo, the art Cameo= stem);
    /// installs without the key fall back to the reg's own
    /// <reg>ICON.SHP, with the generic CNSTICON for the two yards whose art
    /// ships no cameo, and the world sprite as the last resort.</summary>
    Texture StructureCameoTexture(StructureType t) {
        if (t == null) { return null; }
        string reg = t.Reg();
        // The art Cameo= key carries the full shipped stem -- "POWRICON",
        // "gwepicon" -- not a prefix to concatenate on, so it is used
        // verbatim (uppercased for the VFS) unless it lacks the ICON tail.
        string stem = t.Cameo() != null ? t.Cameo().ToUpper() : "";
        string primary;
        if (stem.Length > 0) {
            bool endsIcon = stem.Length >= 4
                && stem.Substring(stem.Length - 4) == "ICON";
            primary = endsIcon ? stem + ".SHP" : stem + "ICON.SHP";
        } else if (reg == "GACNST" || reg == "NACNST") {
            primary = "CNSTICON.SHP";
        } else {
            primary = reg + "ICON.SHP";
        }
        // Same-name cache the unit cameos share: a miss is stored as null
        // so a missing portrait costs one lookup and then falls back.
        for (int i = 0; i < this.cameoNames.Count; i = i + 1) {
            if (this.cameoNames[i] == primary) { return this.cameoTex[i]; }
        }
        string fallback;
        if (reg == "GACNST" || reg == "NACNST") {
            fallback = "CNSTICON.SHP";
        } else {
            fallback = reg + "ICON.SHP";
        }
        Texture tex = this.LoadCameoShp(primary);
        if (tex == null && fallback != primary) {
            tex = this.LoadCameoShp(fallback);
        }
        if (tex == null) {
            tex = this.StructureTextureOf(t, 0, 1, 1, t.Hp(), t.Hp());
        }
        this.cameoNames.Add(primary);
        this.cameoTex.Add(tex);
        return tex;
    }

    /// <summary>One ICON.SHP decoded under CAMEO.PAL (the portrait palette
    /// the originals ship in CAMEO.MIX), SIDEBAR.PAL as the stand-in when
    /// the install carries only the sidebar palette. Null when absent.</summary>
    Texture LoadCameoShp(string name) {
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.vfs.Read(name, len);
        if (len[0] <= 0) { return null; }
        if (this.cameoPal == null) {
            this.cameoPal = this.db.PaletteNamed("CAMEO.PAL");
            if (this.cameoPal == null) {
                this.cameoPal = this.db.PaletteNamed("SIDEBAR.PAL");
            }
        }
        if (this.cameoPal == null) { return null; }
        ShpImage shp = ShpImage.Parse(raw, len[0]);
        if (shp.FrameCount() <= 0) { return null; }
        byte[] idx = shp.DecodeFrameCanvas(0);
        return Texture.FromIndexedShp(idx, shp.Width(), shp.Height(),
                                      this.cameoPal);
    }

    /// <summary>The unit palette for a side. Remappable art stores its
    /// player-colour pixels in palette slots 16..31, and the raw palette
    /// carries the soviet red ramp there; the allied side gets those slots
    /// recoloured to its player colour (the rules [Colors] Gold entry, the
    /// first skirmish slot's default) so friend and foe read apart on the
    /// field. Yuri's slots recolour to its shipped DarkRed house colour --
    /// the purple the third side wears. The soviet palette is the file as
    /// shipped.</summary>
    Palette UnitPalFor(int side) {
        if (side == Side2.Allied()) {
            if (this.unitPal == null) { return null; }
            if (this.alliedPal == null) {
                this.alliedPal = this.RemappedFromColors("Gold");
            }
            return this.alliedPal;
        }
        if (side == Side2.Yuri()) {
            if (this.unitPal == null) { return null; }
            if (this.yuriPal == null) {
                this.yuriPal = this.RemappedFromColors("Purple");
            }
            return this.yuriPal;
        }
        if (side == Side2.Soviet()) {
            if (this.unitPal == null) { return null; }
            if (this.sovietPal == null) {
                this.sovietPal = this.RemappedFromColors("Red");
            }
            return this.sovietPal;
        }
        return this.unitPal;
    }

    /// <summary>The theater palette variant a structure draws under: the
    /// Remapable art's owner-coloured areas come from palette entries 16-31,
    /// which only read as the right colours once remapped to the owner's
    /// house colour. Neutral structures keep the shipped palette.</summary>
    Palette TheaterPalFor(int side) {
        if (this.theaterPal == null) { return null; }
        if (side == Side2.Allied()) {
            if (this.theaterAllied == null) {
                this.theaterAllied = this.RemapTheaterFromColors("Gold");
            }
            return this.theaterAllied;
        }
        if (side == Side2.Soviet()) {
            if (this.theaterSoviet == null) {
                this.theaterSoviet = this.RemapTheaterFromColors("Red");
            }
            return this.theaterSoviet;
        }
        if (side == Side2.Yuri()) {
            if (this.theaterYuri == null) {
                this.theaterYuri = this.RemapTheaterFromColors("Purple");
            }
            return this.theaterYuri;
        }
        return this.theaterPal;
    }

    /// <summary>The unit palette with its remap slots recoloured to the
    /// named [Colors] entry, built once.</summary>
    Palette RemappedFromColors(string colorName) {
        int hue = 30;
        int sat = 100;
        IniSection colors = this.db.Rules().Section("Colors");
        if (colors != null) {
            List<int> hsv = ObjectArt.ParseHsvTriple(colors.Get(colorName));
            if (hsv.Count == 3) {
                hue = hsv[0];
                sat = hsv[1];
            }
        }
        return this.unitPal.Remapped(hue, sat);
    }

    /// <summary>The theater palette with its remap slots recoloured to the
    /// named [Colors] entry, built once.</summary>
    Palette RemapTheaterFromColors(string colorName) {
        int hue = 30;
        int sat = 100;
        IniSection colors = this.db.Rules().Section("Colors");
        if (colors != null) {
            List<int> hsv = ObjectArt.ParseHsvTriple(colors.Get(colorName));
            if (hsv.Count == 3) {
                hue = hsv[0];
                sat = hsv[1];
            }
        }
        return this.theaterPal.Remapped(hue, sat);
    }

    /// <summary>"32,100,255" -> 32,100,255. Stops at an inline ';' comment;
    /// returns whatever numbers were found, so a malformed value degrades to
    /// the caller's fallback.</summary>
    static List<int> ParseHsvTriple(string s) {
        List<int> vals = new List<int>();
        if (s == null) { return vals; }
        int cur = 0;
        bool any = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 0xFF;
            if (c >= 48 && c <= 57) {
                cur = cur * 10 + (c - 48);
                any = true;
            } else if (c == 59) {
                break;
            } else if (any) {
                vals.Add(cur);
                cur = 0;
                any = false;
            }
        }
        if (any) { vals.Add(cur); }
        return vals;
    }

    /// <summary>The baked texture for a vehicle at one of the eight compass
    /// facings, rendered on first use and cached. The side picks the unit
    /// palette, so the remappable voxels bake in their owner's colour.</summary>
    Texture VehicleTexture(string name, int facing, int side) {
        name = this.ArcticName(name);
        for (int i = 0; i < this.vehNames.Count; i = i + 1) {
            if (this.vehNames[i] == name && this.vehFacings[i] == facing
             && this.vehSides[i] == side) {
                return this.vehTex[i];
            }
        }
        Texture tex = null;
        VxlImage img = this.VxlNamed(name);
        if (img != null && this.UnitPalFor(side) != null) {
            tex = ObjectArt.BakeFacing(img, this.UnitPalFor(side), facing);
        }
        this.vehNames.Add(name);
        this.vehFacings.Add(facing);
        this.vehSides.Add(side);
        this.vehTex.Add(tex);
        return tex;
    }

    /// <summary>The baked turret texture for a turreted vehicle: the same
    /// voxel bake as the hull, from the turret model, at the turret's own
    /// facing. Cached under a "TUR:" key in the vehicle cache, so the same
    /// list serves both; the prefix keeps turret and hull entries apart even
    /// when a model shares its name with its hull.</summary>
    Texture TurretTexture(string turretVxl, int facing, int side) {
        turretVxl = this.ArcticName(turretVxl);
        string key = "TUR:" + turretVxl;
        for (int i = 0; i < this.vehNames.Count; i = i + 1) {
            if (this.vehNames[i] == key && this.vehFacings[i] == facing
             && this.vehSides[i] == side) {
                return this.vehTex[i];
            }
        }
        Texture tex = null;
        VxlImage img = this.VxlNamed(turretVxl);
        if (img != null && this.UnitPalFor(side) != null) {
            tex = ObjectArt.BakeFacing(img, this.UnitPalFor(side), facing);
        }
        this.vehNames.Add(key);
        this.vehFacings.Add(facing);
        this.vehSides.Add(side);
        this.vehTex.Add(tex);
        return tex;
    }

    /// <summary>The parsed voxel model for an art name, cached; null when the
    /// install does not carry the file or it is not a VXL.</summary>
    VxlImage VxlNamed(string name) {
        for (int i = 0; i < this.vxlNames.Count; i = i + 1) {
            if (this.vxlNames[i] == name) { return this.vxlCache[i]; }
        }
        VxlImage img = null;
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.vfs.Read(name, len);
        if (len[0] > 0) {
            img = VxlImage.Parse(raw, len[0]);
            if (img.LimbCount() == 0) { img = null; }
        }
        this.vxlNames.Add(name);
        this.vxlCache.Add(img);
        return img;
    }

    /// <summary>Dev aid: the parsed main limb of a voxel model, for the
    /// self-test's decode audit (voxel counts per z slice against the
    /// independent Python decoder).</summary>
    VxlImage RawVxl(string name) {
        return this.VxlNamed(name);
    }

    /// <summary>Dev aid: stats of the most recent BakeFacing call.</summary>
    static string LastBakeStats() {
        return bakeStats;
    }

    /// <summary>Bakes one compass facing of a voxel model with the reference
    /// engine's voxel projection, one screen pixel per model unit:
    ///
    ///   yaw  : rotate (x,y) by facing*45 degrees, counter-clockwise
    ///   sx   = x - y            (2:1 dimetric, unit pitch)
    ///   sy   = (x + y) / 2 - z  (z up the screen)
    ///
    /// Each voxel's model point is bounds_min + (grid * extent/size), exactly
    /// the reference's section_point; the bare grid would put a model whose
    /// box is off-centre (MTNK's x runs -27.9..30.3) a voxel or two away from
    /// where the game draws it. Depth is x+y+z, painter-sorted far to near.
    /// Every voxel shades by the normal index the format stores for it, with
    /// the retail formula
    ///   shade = 0.8 + 1.3 * saturate(dot(normal, sunDir))
    /// (CNCMaps VxlRenderer Ambient 0.8 / Diffuse 1.3), diffuse only, no
    /// specular -- that is what gives a hull its continuous shading and edge
    /// highlights.</summary>
    static Texture BakeFacing(VxlImage img, Palette pal, int facing) {
        VxlLimb l = img.Main();
        if (l == null) { return null; }
        int sx = l.SizeX();
        int sy = l.SizeY();
        int sz = l.SizeZ();
        // Model-space step per grid index, per axis (reference
        // section_axis_scale): extent/size, or 1 when the box is unset.
        double scx = l.BoundsExtent(0) / (double)sx;
        double scy = l.BoundsExtent(1) / (double)sy;
        double scz = l.BoundsExtent(2) / (double)sz;
        if (!(scx > 0.0)) { scx = 1.0; }
        if (!(scy > 0.0)) { scy = 1.0; }
        if (!(scz > 0.0)) { scz = 1.0; }
        double bx = l.BoundsMin(0);
        double by = l.BoundsMin(1);
        double bz = l.BoundsMin(2);
        // Reference yaw_point: steps = facing/32, angle = steps*45deg, CCW.
        double yaw = (double)(facing % 8) * 3.14159265358979 / 4.0;
        double cos = Math.Cos(yaw);
        double sin = Math.Sin(yaw);

        // Project every filled voxel once; the extents size the canvas and
        // the depth key orders the painter sort.
        int n = 0;
        int total = sx * sy * sz;
        int[] gx = new int[total];
        int[] gy = new int[total];
        int[] gz = new int[total];
        int[] keys = new int[total];
        double minPx = 0.0; double maxPx = 0.0;
        double minPy = 0.0; double maxPy = 0.0;
        bool any = false;
        for (int y = 0; y < sy; y = y + 1) {
            for (int x = 0; x < sx; x = x + 1) {
                for (int z = 0; z < sz; z = z + 1) {
                    if (l.VoxelAt(x, y, z) < 0) { continue; }
                    double mx = bx + (double)x * scx;
                    double my = by + (double)y * scy;
                    double mz = bz + (double)z * scz;
                    double rx = mx * cos - my * sin;
                    double ry = mx * sin + my * cos;
                    // The reference rounds each model coordinate to an int
                    // before projecting, so the sprite lands on the same
                    // pixels the game does.
                    int xi = (int)Math.Round(rx);
                    int yi = (int)Math.Round(ry);
                    int zi = (int)Math.Round(mz);
                    double px = (double)(xi - yi);
                    double py = (double)((xi + yi) / 2 - zi);
                    if (!any) {
                        minPx = px; maxPx = px; minPy = py; maxPy = py;
                        any = true;
                    } else {
                        if (px < minPx) { minPx = px; }
                        if (px > maxPx) { maxPx = px; }
                        if (py < minPy) { minPy = py; }
                        if (py > maxPy) { maxPy = py; }
                    }
                    gx[n] = x; gy[n] = y; gz[n] = z;
                    // Painter key: depth x+y+z, quantised so ties keep a
                    // stable order.
                    keys[n] = (xi + yi + zi) * 16;
                    n = n + 1;
                }
            }
        }
        if (n == 0) { return null; }

        int pad = 4;
        int w = (int)(maxPx - minPx) + pad * 2 + 1;
        int h = (int)(maxPy - minPy) + pad * 2 + 1;
        // Dev aid: the self-test's decode audit reads this after each bake.
        bakeStats = "n=" + Convert.ToString(n)
            + " w=" + Convert.ToString(w) + " h=" + Convert.ToString(h)
            + " px=" + Convert.ToString((int)minPx) + ".."
            + Convert.ToString((int)maxPx)
            + " py=" + Convert.ToString((int)minPy) + ".."
            + Convert.ToString((int)maxPy)
            + " b=" + Convert.ToString((int)(bx * 100.0)) + ","
            + Convert.ToString((int)(by * 100.0)) + ","
            + Convert.ToString((int)(bz * 100.0)) + " e="
            + Convert.ToString((int)(l.BoundsExtent(0) * 100.0)) + ","
            + Convert.ToString((int)(l.BoundsExtent(1) * 100.0)) + ","
            + Convert.ToString((int)(l.BoundsExtent(2) * 100.0));

        Texture tex = Texture.Create(w, h);

        // Counting sort by depth key, ascending: farthest drawn first.
        int kmin = 1 << 30;
        int kmax = -(1 << 30);
        for (int i = 0; i < n; i = i + 1) {
            if (keys[i] < kmin) { kmin = keys[i]; }
            if (keys[i] > kmax) { kmax = keys[i]; }
        }
        int span = kmax - kmin + 1;
        int[] counts = new int[span + 1];
        for (int i = 0; i < n; i = i + 1) {
            counts[keys[i] - kmin] = counts[keys[i] - kmin] + 1;
        }
        int acc = 0;
        for (int i = 0; i < span; i = i + 1) {
            int c = counts[i];
            counts[i] = acc;
            acc = acc + c;
        }
        int[] order = new int[n];
        for (int i = 0; i < n; i = i + 1) {
            order[counts[keys[i] - kmin]] = i;
            counts[keys[i] - kmin] = counts[keys[i] - kmin] + 1;
        }

        // Stamp far-to-near, shading each voxel by its stored normal. The
        // reference's PaletteLambertMaterial does exactly this in a shader:
        //   shade = 0.8 + 1.3 * saturate(dot(normal, lightDir))
        // (CNCMaps VxlRenderer Ambient 0.8 / Diffuse 1.3), diffuse only, no
        // specular. Lighting from an occupancy gradient -- what the本体 used
        // to do -- cannot reproduce edges or curved hulls, so we use the real
        // per-voxel normal index the format ships.
        List<double[]> ntab = VxlNormals.Table(l.NormalType());
        // Light dir, reference WorldScene LIGHT_OFFSET (-87.012, 204.338,
        // 195.409). In that frame +Y is up; the voxel grid here puts +Z up
        // (z pushes a voxel up the screen), so the axes swap to keep the sun
        // in the same screen-relative direction.
        double lx = -87.012; double ly = 195.409; double lz = 204.338;
        double llen = Math.Sqrt(lx * lx + ly * ly + lz * lz);
        lx = lx / llen; ly = ly / llen; lz = lz / llen;
        for (int i = 0; i < n; i = i + 1) {
            int vi = order[i];
            int x = gx[vi]; int y = gy[vi]; int z = gz[vi];
            double[] nrm = VxlNormals.At(ntab, l.NormalAt(x, y, z));
            double dot;
            if (nrm == null) {
                dot = 0.0;
            } else {
                // Reference normal is (x, y_up, z_depth); grid is (x, y, z_up).
                dot = nrm[0] * lx + nrm[2] * ly + nrm[1] * lz;
            }
            if (dot < 0.0) { dot = 0.0; }
            double shade = 0.8 + 1.3 * dot;
            if (shade > 1.35) { shade = 1.35; }
            int color = l.VoxelAt(x, y, z);
            int r = (int)((double)pal.R8(color) * shade);
            int g = (int)((double)pal.G8(color) * shade);
            int b = (int)((double)pal.B8(color) * shade);
            double mx = bx + (double)x * scx;
            double my = by + (double)y * scy;
            double mz = bz + (double)z * scz;
            double rx = mx * cos - my * sin;
            double ry = mx * sin + my * cos;
            int xi = (int)Math.Round(rx);
            int yi = (int)Math.Round(ry);
            int zi = (int)Math.Round(mz);
            int px = (xi - yi) - (int)minPx + pad;
            int py = ((xi + yi) / 2 - zi) - (int)minPy + pad;
            // One screen pixel per model unit, the reference's pitch. A
            // single pixel can leave a seam where two voxels project into
            // the same column, so the four neighbours are filled too; the
            // painter sort makes the nearest write win either way.
            for (int dy = 0; dy <= 1; dy = dy + 1) {
                for (int dx = 0; dx <= 1; dx = dx + 1) {
                    int tx = px + dx;
                    int ty = py + dy;
                    if (tx >= 0 && ty >= 0 && tx < w && ty < h) {
                        tex.SetPixel(ty * w + tx, r, g, b, 255);
                    }
                }
            }
        }
        return tex;
    }

    /// <summary>The sprite for a round in flight, one frame from the
    /// projectile type's own directional SHP. The reference maps its flying
    /// direction to its facing ring with a 45-degree phase (frame 0 of the
    /// baked art points a step off north), so n-frame art maps the same
    /// way; art the install doesn't carry yields null and the round simply
    /// doesn't draw, the way the original's Inviso rounds behave.</summary>
    Texture ProjectileTexture(ProjectileType pt, int facing, int side) {
        string name = pt.Image();
        if (name.Length == 0) { return null; }
        string file = name + ".SHP";
        int count = this.ShapeFrameCount(file);
        if (count <= 0) { return null; }
        int deg = ((facing * 45 - 45) % 360 + 360) % 360;
        int frame = deg * count / 360;
        if (frame >= count) { frame = count - 1; }
        return this.ShapeTextureFrame(file, frame, this.UnitPalFor(side));
    }

    /// <summary>One frame of a warhead's impact animation under the theatre
    /// palette -- the explosion and crater art is theatre-tinted the same
    /// way the terrain is. Null when the install lacks the SHP.</summary>
    Texture AnimTexture(string name, int frame, int side) {
        // The rules name animations bare ("EXPLOSML"); every shape on the
        // art side is keyed and read with its .SHP extension on.
        string file = name + ".SHP";
        int count = this.ShapeFrameCount(file);
        if (count <= 0) { return null; }
        if (frame < 0) { frame = 0; }
        if (frame >= count) { frame = count - 1; }
        Palette pal = this.animPal != null
                    ? this.animPal : this.TheaterPalFor(side);
        return this.ShapeTextureFrame(file, frame, pal);
    }

    /// <summary>How many frames a shape carries, 0 when absent. Drives the
    /// construction animation mapping. Kept in its own cache: the texture
    /// cache's "frame" slot holds a frame index, not a count, so a name-only
    /// lookup there could hand back a frame number as a count.</summary>
    int ShapeFrameCount(string shpName) {
        for (int i = 0; i < this.countNames.Count; i = i + 1) {
            if (this.countNames[i] == shpName) { return this.countVals[i]; }
        }
        int n = 0;
        List<int> len = new List<int>();
        len.Add(0);
        byte[] raw = this.vfs.Read(shpName, len);
        if (len[0] > 0) {
            ShpImage shp = ShpImage.Parse(raw, len[0]);
            n = shp.FrameCount();
        }
        this.countNames.Add(shpName);
        this.countVals.Add(n);
        return n;
    }

    Texture ShapeTextureFrame(string shpName, int frame, Palette pal) {
        for (int i = 0; i < this.shpNames.Count; i = i + 1) {
            if (this.shpNames[i] == shpName && this.shpFrames[i] == frame
             && this.shpPals[i] == pal) {
                return this.shpCache[i];
            }
        }
        Texture tex = null;
        if (pal != null) {
            List<int> len = new List<int>();
            len.Add(0);
            byte[] raw = this.vfs.Read(shpName, len);
            if (len[0] > 0) {
                ShpImage shp = ShpImage.Parse(raw, len[0]);
                ShpFrame f = shp.FrameAt(frame);
                if (f != null && !f.IsEmpty()) {
                    byte[] idx = shp.DecodeFrame(frame);
                    // Troop frames sit at their own offset inside the
                    // sprite's bounding box, and the box is what aligns the
                    // frames of a cycle -- a walk sprite's feet stay planted
                    // only if every frame lands at its shipped offset.
                    // Buildings fill their box exactly, so this composes to
                    // the plain decode for them.
                    if (shp.Width() > f.Width() || shp.Height() > f.Height()
                     || f.X() != 0 || f.Y() != 0) {
                        Texture full = Texture.Create(shp.Width(),
                                                      shp.Height());
                        Texture part = Texture.FromIndexedShp(idx, f.Width(),
                                                           f.Height(), pal);
                        full.Blit(part, f.X(), f.Y());
                        part.Close();
                        tex = full;
                    } else {
                        tex = Texture.FromIndexedShp(idx, f.Width(), f.Height(),
                                                  pal);
                    }
                }
            }
        }
        this.shpNames.Add(shpName);
        this.shpFrames.Add(frame);
        this.shpPals.Add(pal);
        this.shpCache.Add(tex);
        return tex;
    }

    int IndexOfName(List<string> names, string name) {
        for (int i = 0; i < names.Count; i = i + 1) {
            if (names[i] == name) { return i; }
        }
        return -1;
    }

    void Close() {
        for (int i = 0; i < this.shpCache.Count; i = i + 1) {
            if (this.shpCache[i] != null) { this.shpCache[i].Close(); }
        }
        this.shpCache = new List<Texture>();
        for (int i = 0; i < this.vehTex.Count; i = i + 1) {
            if (this.vehTex[i] != null) { this.vehTex[i].Close(); }
        }
        this.vehTex = new List<Texture>();
        for (int i = 0; i < this.cameoTex.Count; i = i + 1) {
            if (this.cameoTex[i] != null) { this.cameoTex[i].Close(); }
        }
        this.cameoTex = new List<Texture>();
    }
}

/// <summary>Draws the world's objects into a terrain canvas in painter's
/// order, plus a selection ring and the placeholder unit sprite. Pure drawing:
/// where an object sits comes from World, how it looks from ObjectArt.</summary>
class ObjectRenderer {
    /// <summary>The placeholder glyph for objects whose SHP the install does
    /// not carry: a diamond of the owner's colour with a darker outline.
    /// Specialists (engineers, spies) draw small, regular soldiers at the
    /// default size, and structures without art as neutral blocks; the two
    /// side colours keep friend and foe apart on the terrain.</summary>
    static Texture Placeholder(int side, UnitType u) {
        int w = 24;
        if (u != null && u.Role() != UnitRole.None()) { w = 18; }
        int h = w;
        Texture tex = Texture.Create(w, h);
        int r = 46;
        int g = 128;
        int b = 214;
        if (side == Side2.Soviet()) { r = 224; g = 52; b = 48; }
        else if (side == Side2.Yuri()) { r = 154; g = 60; b = 200; }
        else if (side == Side2.Neutral()) { r = 128; g = 128; b = 136; }
        for (int y = 0; y < h; y = y + 1) {
            for (int x = 0; x < w; x = x + 1) {
                bool outline = ((x + y) & 3) < 2;
                if (!outline) { continue; }
                tex.SetPixel(y * w + x, r, g, b, 255);
            }
        }
        return tex;
    }

    /// <summary>Draws every object into the canvas. Returns the number drawn,
    /// mirroring MapRenderer.RenderInto's contract for the caller to report.</summary>
    static int Render(World world, ObjectArt art, Texture canvas, int camX,
                      int camY, int originX, int originY, int playerSide) {
        int drawn = 0;
        List<WorldObject> vis = new List<WorldObject>();
        for (int i = 0; i < world.ObjectCount(); i = i + 1) {
            vis.Add(world.ObjectAt(i));
        }
        ObjectRenderer.SortByDepth(vis);
        for (int i = 0; i < vis.Count; i = i + 1) {
            if (ObjectRenderer.DrawOne(world, art, vis[i], canvas, camX, camY,
                                       originX, originY, playerSide)) {
                drawn = drawn + 1;
            }
        }
        // Combat effects (muzzle flashes, explosions) draw on top so a shot or
        // kill is visible over the sprites involved.
        ObjectRenderer.DrawEffects(world, canvas, camX, camY, originX, originY);
        return drawn;
    }

    /// <summary>The live half of the world draw: objects straight onto the
    /// frame, over the composited terrain texture. Sprite picking mirrors
    /// DrawOne exactly, but each sprite registers once under its identity
    /// (type, side, facing, frame, damage) and later frames blit the cached
    /// image -- so a battlefield whose units move costs a few dozen small
    /// blits, not a recomposite and re-encode of the whole scene canvas.</summary>
    static int RenderToCanvas(World world, ObjectArt art, R2Canvas r,
                              int camX, int camY, int originX, int originY,
                              int playerSide) {
        if (world == null || art == null) { return 0; }
        // One buffer reused across frames: allocating a fresh list (and
        // letting the sorter churn it) every frame is exactly the per-frame
        // garbage a hundred-unit battle cannot afford.
        if (ObjectRenderer.drawBuf == null) {
            ObjectRenderer.drawBuf = new List<WorldObject>();
        }
        List<WorldObject> vis = ObjectRenderer.drawBuf;
        int n = 0;
        int cw = r.OutW();
        int ch = r.OutH();
        for (int i = 0; i < world.ObjectCount(); i = i + 1) {
            WorldObject o = world.ObjectAt(i);
            // Cull before the depth sort: the sort then covers the few dozen
            // objects on screen instead of the whole map's population.
            int wx = IsoProjection.ScreenX(o.X(), o.Y()) - originX - camX;
            if (wx > cw + 128 || wx < 0 - 128) { continue; }
            int wy = IsoProjection.ScreenY(o.X(), o.Y(), 0) - originY - camY;
            if (wy > ch + 128 || wy < 0 - 128) { continue; }
            if (n < vis.Count) { vis[n] = o; } else { vis.Add(o); }
            n = n + 1;
        }
        // Release the buffer's stale tail: ARC keeps a referenced dead object
        // alive, and a shrinking battle would otherwise pin its corpses.
        for (int i = n; i < vis.Count; i = i + 1) { vis[i] = null; }
        ObjectRenderer.InsertionSortByDepth(vis, n);
        int drawn = 0;
        for (int i = 0; i < n; i = i + 1) {
            if (ObjectRenderer.DrawOneToCanvas(world, art, vis[i], r, camX,
                                               camY, originX, originY,
                                               playerSide)) {
                drawn = drawn + 1;
            }
        }
        ObjectRenderer.DrawEffectsToCanvas(world, r, camX, camY,
                                           originX, originY);
        ObjectRenderer.DrawFxLayer(world, art, r, camX, camY,
                                   originX, originY, playerSide);
        return drawn;
    }

    /// <summary>The persistent draw list RenderToCanvas reuses; declared
    /// here so the buffer outlives frames and never reallocates mid-battle.
    /// </summary>
    static List<WorldObject> drawBuf;

    /// <summary>Insertion sort on the first `n` entries. The visible set
    /// changes by a step or two between frames, so nearly-sorted is the
    /// common case -- insertion's best line -- where selection sort pays its
    /// quadratic cost no matter how ordered the input already is.</summary>
    static void InsertionSortByDepth(List<WorldObject> objs, int n) {
        for (int i = 1; i < n; i = i + 1) {
            WorldObject key = objs[i];
            int kd = ObjectRenderer.Depth(key);
            int j = i - 1;
            while (j >= 0 && ObjectRenderer.Depth(objs[j]) > kd) {
                objs[j + 1] = objs[j];
                j = j - 1;
            }
            objs[j + 1] = key;
        }
    }

    /// <summary>One object onto the frame canvas. The anchor math, sprite
    /// choice and overlays match DrawOne; only the blit target differs.</summary>
    static bool DrawOneToCanvas(World world, ObjectArt art, WorldObject o,
                                R2Canvas r, int camX, int camY, int originX,
                                int originY, int playerSide) {
        int wx = IsoProjection.ScreenX(o.X(), o.Y()) - originX - camX;
        int wy = IsoProjection.ScreenY(o.X(), o.Y(), 0) - originY - camY;
        int cw = R2CanvasStageW(r);
        int ch = R2CanvasStageH(r);
        if (wx > cw + 128 || wx < 0 - 128 || wy > ch + 128 || wy < 0 - 128) {
            return false;
        }

        Texture tex = null;
        UnitType u = null;
        R2Tex img = null;
        if (o.Kind() == ObjKind.Structure()) {
            StructureType t = world.TypeOf(o);
            if (t != null) {
                // Sprite identity: construction progress, then raw hp. A
                // finished building's stamp never changes, so it blits from
                // the cache without building a key or touching the memo.
                int stamp = (o.BuiltTicks() & 1023)
                          | ((o.Hp() & 2047) << 10)
                          | (o.Side() << 21);
                img = o.ArtStampA() == stamp ? o.ArtTexA() : null;
                if (img == null) {
                    tex = art.StructureTextureOf(t, o.Side(), o.BuiltTicks(),
                                                 t.BuildTime(), o.Hp(),
                                                 t.Hp());
                    if (tex != null) {
                        // The key mirrors StructureTextureOf's decision
                        // tree: construction stage, else damage state. hp
                        // (not the derived tier) keeps two states from ever
                        // sharing a slot.
                        string key;
                        if (t.BuildTime() > 0
                         && o.BuiltTicks() < t.BuildTime()) {
                            key = "ra2:obj:bu:" + t.Reg() + ":" + o.Side()
                                + ":" + Convert.ToString(o.BuiltTicks());
                        } else {
                            key = "ra2:obj:st:" + t.Reg() + ":" + o.Side()
                                + ":" + Convert.ToString(o.Hp());
                        }
                        img = Ra2Ui.TexOf(key, tex);
                        o.SetArtCacheA(stamp, img);
                    }
                }
                if (img != null) {
                    // A structure's frame carries its own anchor, as in
                    // DrawOne.
                    r.DrawTexture(img, wx - img.W() / 2, wy - img.H(),
                                  img.W(), img.H());
                }
            }
        } else {
            u = world.UnitTypeOf(o);
            if (u != null) {
                // Identity: facing, walk frame, stance, side. AnimFrame only
                // advances on a step, so a battle's steady state -- units
                // standing or reloading -- rides the cache entirely.
                int proneState = (o.SuppTicks() > 0 ? 1 : 0)
                               | ((o.PoseSeq() & 1) << 1)
                               | (o.PoseTicks() > 0 ? 4 : 0)
                               | ((o.PoseTicks() / 2 & 63) << 3);
                int stamp = (o.Facing() & 15)
                          | ((o.AnimFrame() & 65535) << 4)
                          | ((o.HasRoute() ? 1 : 0) << 20)
                          | ((o.Deployed() ? 1 : 0) << 21)
                          | ((o.Side() & 3) << 22)
                          | ((proneState & 255) << 24);
                img = o.ArtStampA() == stamp ? o.ArtTexA() : null;
                if (img == null) {
                    tex = art.UnitTexture(u, o.HasRoute(), o.AnimFrame(),
                                          o.Facing(), o.Side(), o.Deployed(),
                                          o.FireTicks(), proneState);
                    if (tex != null) {
                        string key = "ra2:obj:u:" + u.Reg() + ":" + o.Side()
                            + ":" + Convert.ToString(o.Facing()) + ":"
                            + Convert.ToString(o.AnimFrame())
                            + (o.Deployed() ? ":d"
                                            : (o.HasRoute() ? ":w" : ":s"));
                        img = Ra2Ui.TexOf(key, tex);
                        o.SetArtCacheA(stamp, img);
                    }
                }
                if (img != null) {
                    // The reference's mobile anchor: the sprite's box
                    // centres on the cell diamond's centre.
                    r.DrawTexture(img,
                        wx + IsoProjection.TileW() / 2 - img.W() / 2,
                        wy + IsoProjection.TileH() / 2 - img.H() / 2,
                        img.W(), img.H());
                    // The turret is a second limb of the same model: its own
                    // voxels carry the vehicle's model origin, so centring
                    // its box on the same cell centre stacks it on the hull
                    // the way the reference composites body+turret.
                    if (u.TurretVxl() != null) {
                        int tstamp = (o.TurretFacing() & 15)
                                   | (o.Side() << 4);
                        R2Tex timg = o.ArtStampB() == tstamp
                                   ? o.ArtTexB() : null;
                        if (timg == null) {
                            Texture tur = art.TurretTexture(u.TurretVxl(),
                                                            o.TurretFacing(),
                                                            o.Side());
                            if (tur != null) {
                                timg = Ra2Ui.TexOf("ra2:obj:tur:"
                                    + u.TurretVxl() + ":"
                                    + Convert.ToString(o.TurretFacing())
                                    + ":" + Convert.ToString(o.Side()), tur);
                                o.SetArtCacheB(tstamp, timg);
                            }
                        }
                        if (timg != null) {
                            r.DrawTexture(timg,
                                wx + IsoProjection.TileW() / 2 - timg.W() / 2,
                                wy + IsoProjection.TileH() / 2 - timg.H() / 2,
                                timg.W(), timg.H());
                        }
                    }
                }
            }
        }
        if (img == null) {
            // No usable sprite: the side-coloured placeholder. Rare, and by
            // definition uncached -- there is nothing to remember.
            Texture ph = ObjectRenderer.Placeholder(o.Side(), u);
            R2Tex pimg = Ra2Ui.TexOf("ra2:obj:ph:" + Convert.ToString(o.Side())
                + ":" + Convert.ToString(u == null ? 0 : u.Role()), ph);
            r.DrawTexture(pimg, wx - ph.Width() / 2, wy - ph.Height(),
                          ph.Width(), ph.Height());
            ph.Close();
        }

        if (o.IsSelected()) {
            if (o.Side() == playerSide) {
                ObjectRenderer.DrawRingC(r, wx, wy, 30, 255, 80);
            } else {
                ObjectRenderer.DrawRingC(r, wx, wy, 232, 60, 60);
            }
        }
        if (o.Hp() < o.MaxHp() && o.MaxHp() > 0) {
            int bw = 30;
            int bx = wx - bw / 2;
            int by = wy - 34;
            r.SetColor(0, 0, 0, 160);
            r.FillRect(bx - 1, by, bw + 2, 1);
            r.FillRect(bx - 1, by + 2, bw + 2, 1);
            r.FillRect(bx - 1, by + 1, 1, 1);
            r.FillRect(bx + bw, by + 1, 1, 1);
            int fill = bw * o.Hp() / o.MaxHp();
            int hr = 62;
            int hg = 224;
            int hb = 74;
            if (fill < bw / 2) { hr = 232; hg = 60; hb = 60; }
            else if (fill < bw * 3 / 4) { hr = 236; hg = 200; hb = 60; }
            r.SetColor(hr, hg, hb, 255);
            if (fill > 0) { r.FillRect(bx, by + 1, fill, 1); }
            if (fill < bw) {
                r.SetColor(160, 0, 0, 255);
                r.FillRect(bx + fill, by + 1, bw - fill, 1);
            }
            r.SetColor(255, 255, 255, 255);
        }
        return true;
    }

    /// <summary>The projectile layer: rounds in flight, impact animations
    /// and beam rays, all over the units. Sprites come from the install's
    /// own SHP art through the same cached frame decoder the units use; a
    /// round the install gives no art for draws nothing (Inviso rounds
    /// never draw), exactly like the original's invisible bullets.</summary>
    static void DrawFxLayer(World world, ObjectArt art, R2Canvas r,
                            int camX, int camY, int originX, int originY,
                            int playerSide) {
        if (world == null || art == null) { return; }
        int cw = r.OutW();
        int ch = r.OutH();
        for (int i = 0; i < world.ProjectileCount(); i = i + 1) {
            Projectile p = world.ProjectileAt(i);
            ProjectileType pt = p.Type();
            if (pt.Inviso() || pt.Image().Length == 0) { continue; }
            int sx = FxScreenX(p.Px(), p.Py(), originX, camX);
            int sy = FxScreenY(p.Px(), p.Py(), p.Pz(), originY, camY);
            if (sx < 0 - 64 || sx > cw + 64 || sy < 0 - 64
             || sy > ch + 64) { continue; }
            // The sprite rings run counter-clockwise from north, one frame
            // per 360/n degrees; the direction the round actually flies
            // picks the frame, the way the reference maps its 32 facings.
            int facing = WorldObject.FacingOf(
                (int)(p.DirX() * 1000.0), (int)(p.DirY() * 1000.0));
            Texture tex = art.ProjectileTexture(pt, facing, p.SideOf());
            if (tex == null) { continue; }
            R2Tex img = Ra2Ui.TexOf("ra2:fx:pj:" + pt.Name() + ":"
                + Convert.ToString(facing) + ":" + Convert.ToString(p.SideOf()),
                tex);
            r.DrawTexture(img,
                sx + IsoProjection.TileW() / 2 - tex.Width() / 2,
                sy + IsoProjection.TileH() / 2 - tex.Height() / 2,
                tex.Width(), tex.Height());
        }
        for (int i = 0; i < world.AnimFxCount(); i = i + 1) {
            FxAnim a = world.AnimFxAt(i);
            if (a.Frames() <= 0) { continue; }
            int sx = FxScreenX(a.Px(), a.Py(), originX, camX);
            int sy = FxScreenY(a.Px(), a.Py(), 0, originY, camY);
            if (sx < 0 - 96 || sx > cw + 96 || sy < 0 - 96
             || sy > ch + 96) { continue; }
            Texture tex;
            string key;
            if (a.UnitShp() != null && a.UnitShp().Length > 0) {
                tex = art.CorpseTexture(a.UnitShp(), a.UnitSide(),
                                        a.SeqStart(), a.SeqFrames(),
                                        a.SeqMult(), a.Frame(),
                                        a.Facing());
                key = "ra2:fx:corpse:" + a.UnitShp() + ":"
                    + Convert.ToString(a.UnitSide()) + ":"
                    + Convert.ToString(a.SeqStart()) + ":"
                    + Convert.ToString(a.Frame()) + ":"
                    + Convert.ToString(a.Facing());
            } else {
                tex = art.AnimTexture(a.Name(), a.Frame(), playerSide);
                key = "ra2:fx:an:" + a.Name() + ":"
                    + Convert.ToString(a.Frame());
            }
            if (tex == null) { continue; }
            R2Tex img = Ra2Ui.TexOf(key, tex);
            // Impact art sits centred on the tile it detonated over.
            r.DrawTexture(img,
                sx + IsoProjection.TileW() / 2 - tex.Width() / 2,
                sy + IsoProjection.TileH() / 2 - tex.Height() / 2,
                tex.Width(), tex.Height());
        }
        for (int i = 0; i < world.BeamCount(); i = i + 1) {
            FxBeam b = world.BeamAt(i);
            int x0 = FxScreenX(b.X0(), b.Y0(), originX, camX)
                   + IsoProjection.TileW() / 2;
            int y0 = FxScreenY(b.X0(), b.Y0(), 0, originY, camY)
                   + IsoProjection.TileH() / 2;
            int x1 = FxScreenX(b.X1(), b.Y1(), originX, camX)
                   + IsoProjection.TileW() / 2;
            int y1 = FxScreenY(b.X1(), b.Y1(), 0, originY, camY)
                   + IsoProjection.TileH() / 2;
            if (b.Kind() == 1) {
                // Tesla: the reference's TeslaFx draws three jagged
                // strands -- two inner, one brighter sheath -- each ten
                // points down the line, midpoints swayed by a sine whose
                // amplitude swells around the middle and whose phase
                // races with age, so the bolt crackles per frame.
                DrawTeslaBolt(r, x0, y0, x1, y1, b.Age(), b.Seed(), 0);
                DrawTeslaBolt(r, x0, y0, x1, y1, b.Age(),
                              b.Seed() + 2.1, 0);
                DrawTeslaBolt(r, x0, y0, x1, y1, b.Age(),
                              b.Seed() + 4.2, 1);
                continue;
            }
            int hr = 255;
            int hg = 40;
            int hb = 40;
            if (b.Kind() == 2) { hr = 90; hg = 225; hb = 90; }
            r.SetColor(hr, hg, hb, 230);
            int adx = x1 > x0 ? x1 - x0 : x0 - x1;
            int ady = y1 > y0 ? y1 - y0 : y0 - y1;
            int steps = (adx > ady ? adx : ady) / 3;
            if (steps < 1) { steps = 1; }
            for (int k = 0; k <= steps; k = k + 1) {
                int x = x0 + (x1 - x0) * k / steps;
                int y = y0 + (y1 - y0) * k / steps;
                r.FillRect(x - 1, y, 3, 2);
            }
            r.SetColor(255, 255, 255, 255);
        }
    }

    /// <summary>One jagged lightning run. Ten points down the line; the
    /// middle eight sway on the line's perpendicular by sin(phase) plus a
    /// slower cos on top, both squeezed by a sin(t*pi) envelope that pins
    /// the ends. Pass 1 is the brighter outer sheath.</summary>
    static void DrawTeslaBolt(R2Canvas r, int x0, int y0, int x1, int y1,
                              int age, double seed, int pass) {
        double dx = x1 - x0;
        double dy = y1 - y0;
        double dist = Math.Sqrt(dx * dx + dy * dy);
        if (dist < 1.0) { dist = 1.0; }
        double px = (0.0 - dy) / dist;
        double py = dx / dist;
        double amp = dist * 0.02;
        if (amp < 2.0) { amp = 2.0; }
        if (pass == 1) {
            r.SetColor(235, 245, 255, 210);
        } else {
            r.SetColor(130, 190, 255, 190);
        }
        int[] xs = new int[10];
        int[] ys = new int[10];
        for (int k = 0; k < 10; k = k + 1) {
            double t = k / 9.0;
            int x = x0 + (int)(dx * t);
            int y = y0 + (int)(dy * t);
            if (k > 0 && k < 9) {
                double env = Math.Sin(t * 3.14159265);
                double phase = age * 18.0 + seed + t * 12.5663706;
                double off = Math.Sin(phase) * amp * env
                           + Math.Cos(phase * 1.31) * amp * env * 0.6;
                x = x + (int)(px * off);
                y = y + (int)(py * off);
            }
            xs[k] = x;
            ys[k] = y;
        }
        // Stroke the jag through: every pair of neighbouring points joins
        // through interpolated dots so the bolt reads as one crackling
        // line, the way the reference's line geometry renders.
        int w = pass == 1 ? 1 : 0;
        for (int k = 0; k < 9; k = k + 1) {
            int ax = xs[k];
            int ay = ys[k];
            int bx = xs[k + 1];
            int by = ys[k + 1];
            int adx = bx > ax ? bx - ax : ax - bx;
            int ady = by > ay ? by - ay : ay - by;
            int steps = adx > ady ? adx : ady;
            if (steps < 1) { steps = 1; }
            for (int q = 0; q <= steps; q = q + 1) {
                int x = ax + (bx - ax) * q / steps;
                int y = ay + (by - ay) * q / steps;
                r.FillRect(x - w / 2, y - w / 2, w + 1, w + 1);
            }
        }
        r.SetColor(255, 255, 255, 255);
    }

    /// <summary>Float cell coordinates through the iso projection, the same
    /// mapping the integer cell version uses.</summary>
    static int FxScreenX(double cx, double cy, int originX, int camX) {
        return (int)((cx - cy) * IsoProjection.HalfW()) - originX - camX;
    }

    static int FxScreenY(double cx, double cy, double pz, int originY,
                         int camY) {
        return (int)((cx + cy) * IsoProjection.HalfH() - pz * 15.0)
             - originY - camY;
    }

    /// <summary>The diamond selection ring, drawn as one-pixel fills on the
    /// frame canvas -- the same four-edge diamond DrawRing stamps into a
    /// texture (radius 15, apex to apex).</summary>
    static void DrawRingC(R2Canvas r, int cx, int cy, int cr, int cg, int cb) {
        r.SetColor(cr, cg, cb, 255);
        for (int i = 0; i <= 15; i = i + 1) {
            r.FillRect(cx + i, cy - 15 + i, 1, 1);
            r.FillRect(cx + 15 - i, cy + i, 1, 1);
            r.FillRect(cx - i, cy + 15 - i, 1, 1);
            r.FillRect(cx - 15 + i, cy - i, 1, 1);
        }
    }

    /// <summary>Stage-space extents of the frame canvas, for culling.</summary>
    static int R2CanvasStageW(R2Canvas r) { return r.OutW(); }
    static int R2CanvasStageH(R2Canvas r) { return r.OutH(); }

    /// <summary>Combat effects onto the frame canvas: flashes as bright dots,
    /// explosions as rings sized by their remaining life.</summary>
    static void DrawEffectsToCanvas(World world, R2Canvas r, int camX, int camY,
                                    int originX, int originY) {
        for (int i = 0; i < world.EffectCount(); i = i + 1) {
            int kind = world.EffectKind(i);
            int x = world.EffectX(i);
            int y = world.EffectY(i);
            int life = world.EffectLife(i);
            int wx = IsoProjection.ScreenX(x, y) - originX - camX;
            int wy = IsoProjection.ScreenY(x, y, 0) - originY - camY;
            if (wx < -64 || wy < -64 || wx > r.OutW() + 64
             || wy > r.OutH() + 64) {
                continue;
            }
            if (kind == 0) {
                r.SetColor(255, 236, 120, 220);
                r.FillRect(wx - 1, wy - 1, 3, 3);
            } else {
                int radius = 18 - life * 2;
                if (radius < 2) { radius = 2; }
                int alpha = 120 + life * 8;
                if (alpha > 240) { alpha = 240; }
                r.SetColor(232, 120 + life * 6, 40, alpha);
                for (int k = 0; k <= radius; k = k + 1) {
                    int hy = (radius - k) / 2;
                    r.FillRect(wx + k, wy + hy, 1, 1);
                    r.FillRect(wx - k, wy + hy, 1, 1);
                    r.FillRect(wx + k, wy - hy, 1, 1);
                    r.FillRect(wx - k, wy - hy, 1, 1);
                }
                if (life > 8) {
                    r.SetColor(255, 200, 60, 200);
                    r.FillRect(wx - 2, wy - 2, 4, 4);
                }
            }
        }
        r.SetColor(255, 255, 255, 255);
    }

    /// <summary>Draws live combat effects: flashes are bright dots, explosions
    /// are expanding rings whose size and fade track the remaining life.</summary>
    static void DrawEffects(World world, Texture canvas, int camX, int camY,
                            int originX, int originY) {
        for (int i = 0; i < world.EffectCount(); i = i + 1) {
            int kind = world.EffectKind(i);
            int x = world.EffectX(i);
            int y = world.EffectY(i);
            int life = world.EffectLife(i);
            int wx = IsoProjection.ScreenX(x, y) - originX - camX;
            int wy = IsoProjection.ScreenY(x, y, 0) - originY - camY;
            if (wx < -64 || wy < -64 || wx > canvas.Width() + 64
             || wy > canvas.Height() + 64) { continue; }
            if (kind == 0) {
                // Muzzle flash: a bright yellow dot at the cell apex.
                ObjectRenderer.DrawDot(canvas, wx, wy, 2, 255, 236, 120, 220);
            } else {
                // Explosion: a ring whose radius grows as life fades, plus a
                // hot core in the first few ticks.
                int radius = 18 - life * 2;
                if (radius < 2) { radius = 2; }
                int alpha = 120 + life * 8;
                if (alpha > 240) { alpha = 240; }
                ObjectRenderer.DrawRing2(canvas, wx, wy, radius,
                                         232, 120 + life * 6, 40, alpha);
                if (life > 8) {
                    ObjectRenderer.DrawDot(canvas, wx, wy, 4, 255, 200, 60, 200);
                }
            }
        }
    }

    /// <summary>Fills a filled disc of radius r centred at (cx,cy).</summary>
    static void DrawDot(Texture canvas, int cx, int cy, int r, int cr, int cg,
                        int cb, int ca) {
        for (int dy = 0 - r; dy <= r; dy = dy + 1) {
            int half = ObjectRenderer.Isqrt(r * r - dy * dy);
            for (int dx = 0 - half; dx <= half; dx = dx + 1) {
                int px = cx + dx;
                int py = cy + dy;
                if (px >= 0 && py >= 0 && px < canvas.Width()
                 && py < canvas.Height()) {
                    canvas.SetPixel(py * canvas.Width() + px, cr, cg, cb, ca);
                }
            }
        }
    }

    /// <summary>Integer square root.</summary>
    static int Isqrt(int n) {
        if (n <= 0) { return 0; }
        int x = n;
        int y = (x + 1) / 2;
        while (y < x) {
            x = y;
            y = (x + n / x) / 2;
        }
        return x;
    }

    /// <summary>Draws a diamond ring of radius r (matching the tile shape)
    /// centred at (cx,cy), in the four cardinal points.</summary>
    static void DrawRing2(Texture canvas, int cx, int cy, int r, int cr, int cg,
                          int cb, int ca) {
        for (int i = 0; i <= r; i = i + 1) {
            ObjectRenderer.SetPx(canvas, cx + i, cy + (r - i) / 2, cr, cg, cb, ca);
            ObjectRenderer.SetPx(canvas, cx - i, cy + (r - i) / 2, cr, cg, cb, ca);
            ObjectRenderer.SetPx(canvas, cx + i, cy - (r - i) / 2, cr, cg, cb, ca);
            ObjectRenderer.SetPx(canvas, cx - i, cy - (r - i) / 2, cr, cg, cb, ca);
        }
    }

    static void SetPx(Texture canvas, int x, int y, int cr, int cg, int cb,
                      int ca) {
        if (x >= 0 && y >= 0 && x < canvas.Width() && y < canvas.Height()) {
            canvas.SetPixel(y * canvas.Width() + x, cr, cg, cb, ca);
        }
    }

    /// <summary>Sorts objects back-to-front by x+y so a nearer object covers
    /// the ones behind it, matching the terrain's painter order.</summary>
    static void SortByDepth(List<WorldObject> objs) {
        int n = objs.Count;
        // Selection sort; object counts are tens, not thousands.
        for (int i = 0; i < n - 1; i = i + 1) {
            int best = i;
            for (int j = i + 1; j < n; j = j + 1) {
                if (ObjectRenderer.Depth(objs[j]) < ObjectRenderer.Depth(objs[best])) {
                    best = j;
                }
            }
            if (best != i) {
                WorldObject tmp = objs[i];
                objs[i] = objs[best];
                objs[best] = tmp;
            }
        }
    }

    static int Depth(WorldObject o) { return o.X() + o.Y(); }

    static bool DrawOne(World world, ObjectArt art, WorldObject o, Texture canvas,
                        int camX, int camY, int originX, int originY,
                        int playerSide) {
        int wx = IsoProjection.ScreenX(o.X(), o.Y()) - originX - camX;
        int wy = IsoProjection.ScreenY(o.X(), o.Y(), 0) - originY - camY;
        if (wx > canvas.Width() + 128 || wx < -128
         || wy > canvas.Height() + 128 || wy < -128) {
            return false;
        }

        Texture tex = null;
        UnitType u = null;
        if (o.Kind() == ObjKind.Structure()) {
            // TypeOf routes civilian structures to the civ catalog; a plain
            // side lookup would miss them and drop the sprite.
            StructureType t = world.TypeOf(o);
            if (t != null) {
                tex = art.StructureTextureOf(t, o.Side(), o.BuiltTicks(),
                                                t.BuildTime(), o.Hp(),
                                                t.Hp());
            }
        } else {
            // Units draw their real sprite when the install has the art,
            // otherwise the side-coloured placeholder. UnitTypeOf routes a
            // map's civilian scenery (cars, cows) to the civ unit list, the
            // way TypeOf does for civ structures.
            u = world.UnitTypeOf(o);
            tex = art.UnitTexture(u, o.HasRoute(), o.AnimFrame(), o.Facing(),
                                  o.Side(), o.Deployed());
        }
        if (tex != null) {
            if (u != null) {
                // A mobile's bounding-box centre lands on the cell diamond's
                // centre -- where the reference engine puts the blit
                // (iso_to_screen + (-w/2 + TILE_W/2, -h/2 + TILE_H/2)).
                // Anchoring the hull's *bottom* on the cell apex instead
                // (what this did) floats a vehicle half a cell too high.
                canvas.Blit(tex,
                    wx + IsoProjection.TileW() / 2 - tex.Width() / 2,
                    wy + IsoProjection.TileH() / 2 - tex.Height() / 2);
            } else {
                // A structure's own frame carries its anchor: the SHP's
                // frame y places the building's visual ground below the apex,
                // and its x centres it on the cell.
                canvas.Blit(tex, wx + (0 - tex.Width() / 2),
                            wy + (0 - tex.Height()));
            }
        }
        // A turreted vehicle's gun mounts over the hull: bake the turret
        // model at its own facing and stamp it on the same anchor, so the
        // gun slews independently of the body. A turret the install lacks
        // falls back to the hull sprite alone, like the original without art.
        if (u != null && tex != null && u.TurretVxl() != null) {
            Texture tur = art.TurretTexture(u.TurretVxl(), o.TurretFacing(),
                                            o.Side());
            if (tur != null) {
                // The turret is a second limb of the same model: its own
                // voxels carry the vehicle's model origin, so centring its
                // box on the same cell centre stacks it on the hull the way
                // the reference composites body+turret into one sprite.
                canvas.Blit(tur,
                    wx + IsoProjection.TileW() / 2 - tur.Width() / 2,
                    wy + IsoProjection.TileH() / 2 - tur.Height() / 2);
            }
        }
        if (tex == null) {
            Texture ph = ObjectRenderer.Placeholder(o.Side(), u);
            int pw = ph.Width();
            canvas.Blit(ph, wx - pw / 2, wy - pw);
            ph.Close();
        }

        if (o.IsSelected()) {
            // Own units get a green ring, enemy units a red one, so the
            // player can tell at a glance whose selection this is.
            if (o.Side() == playerSide) {
                ObjectRenderer.DrawRing(canvas, wx, wy, 30, 255, 80);
            } else {
                ObjectRenderer.DrawRing(canvas, wx, wy, 232, 60, 60);
            }
        }
        // A health bar above every damaged thing: a dark backing strip and a
        // fill that shrinks as hit points fall. The fill goes green, then
        // yellow, then red as health drops, so danger reads at a glance.
        // Full-health objects get no bar, so the terrain stays clean until a
        // fight breaks out.
        if (o.Hp() < o.MaxHp() && o.MaxHp() > 0) {
            int bw = 30;
            int bx = wx - bw / 2;
            int by = wy - 34;
            // A damaged thing can stand above the viewport (the bar's row is
            // 34px up), and SetPixel writes straight into the canvas buffer
            // with no clipping -- an unguarded write there is an
            // array-index-out-of-bounds at runtime. Skip the whole bar when
            // any row it touches is off-canvas.
            int rowW = canvas.Width();
            int colH = canvas.Height();
            bool fits = by >= 0 && by + 2 < colH && bx - 1 >= 0
                     && bx + bw < rowW;
            if (fits) {
            canvas.SetPixel((by + 1) * rowW + (bx - 1), 0, 0, 0, 160);
            canvas.SetPixel((by + 1) * rowW + (bx + bw), 0, 0, 0, 160);
            int fill = bw * o.Hp() / o.MaxHp();
            for (int i = 0; i <= bw + 1; i = i + 1) {
                canvas.SetPixel(by * rowW + (bx - 1 + i), 0, 0, 0, 160);
                canvas.SetPixel((by + 2) * rowW + (bx - 1 + i), 0, 0, 0, 160);
            }
            int hr = 62;
            int hg = 224;
            int hb = 74;
            if (fill < bw / 2) { hr = 232; hg = 60; hb = 60; }
            else if (fill < bw * 3 / 4) { hr = 236; hg = 200; hb = 60; }
            for (int i = 0; i < fill; i = i + 1) {
                canvas.SetPixel((by + 1) * rowW + (bx + i), hr, hg, hb, 255);
            }
            if (fill < bw) {
                canvas.SetPixel((by + 1) * rowW + (bx + fill), 160, 0, 0, 255);
            }
            }
        }
        return true;
    }

    /// <summary>A diamond outline around a unit or building's anchor, so the
    /// selection is visible against any ground. Four edges closing at the four
    /// apexes, matching the isometric tile shape.</summary>
    static void DrawRing(Texture canvas, int cx, int cy, int cr, int cg,
                         int cb) {
        int a = 255;
        // Top -> right, right -> bottom, bottom -> left, left -> top. Each edge
        // runs r steps from one apex to the next.
        for (int i = 0; i <= 15; i = i + 1) {
            canvas.SetPixel((cy - 15 + i) * canvas.Width() + (cx + i), cr, cg, cb, a);
            canvas.SetPixel((cy + i) * canvas.Width() + (cx + 15 - i), cr, cg, cb, a);
            canvas.SetPixel((cy + 15 - i) * canvas.Width() + (cx - i), cr, cg, cb, a);
            canvas.SetPixel((cy - i) * canvas.Width() + (cx - 15 + i), cr, cg, cb, a);
        }
    }
}
