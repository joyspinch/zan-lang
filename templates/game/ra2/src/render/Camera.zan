using System;
using System.Collections.Generic;
using SDL3;

namespace Ra2.Render;

/// <summary>A pan/zoom view onto the rendered terrain.</summary>
///
/// The terrain is composited once into a texture far larger than the window
/// (a 105x95 map is 6300x2865), so the camera is a scroll offset plus an
/// integer zoom rather than anything that re-renders the map.
class Camera {
    int x;          // top-left of the view, in terrain pixels
    int y;
    int zoomNum;    // zoom as a fraction, so 1:1 and 2:1 are exact
    int zoomDen;
    int viewW;
    int viewH;
    int worldW;
    int worldH;

    static Camera Create(int viewW, int viewH, int worldW, int worldH) {
        Camera c = new Camera();
        c.viewW = viewW;
        c.viewH = viewH;
        c.worldW = worldW;
        c.worldH = worldH;
        c.zoomNum = 1;
        c.zoomDen = 1;
        // Start centred: a map's interesting half is the middle of the diamond.
        c.x = (worldW - viewW) / 2;
        c.y = (worldH - viewH) / 2;
        c.Clamp();
        return c;
    }

    int X() { return this.x; }
    int Y() { return this.y; }
    int ZoomNum() { return this.zoomNum; }
    int ZoomDen() { return this.zoomDen; }

    /// <summary>Width of the terrain region visible at the current zoom.
    /// Zooming in shows fewer terrain pixels, not more.</summary>
    int SpanW() { return this.viewW * this.zoomDen / this.zoomNum; }
    int SpanH() { return this.viewH * this.zoomDen / this.zoomNum; }

    void MoveBy(int dx, int dy) {
        this.x = this.x + dx;
        this.y = this.y + dy;
        this.Clamp();
    }

    /// <summary>Jumps the view so its top-left sits at (tx,ty), clamped to the
    /// terrain. Used by the minimap.</summary>
    void MoveTo(int tx, int ty) {
        this.x = tx;
        this.y = ty;
        this.Clamp();
    }

    /// <summary>Steps through 1:2, 1:1, 2:1. Keeps the point under the centre
    /// of the view fixed, which is what makes keyboard zoom feel anchored.</summary>
    void ZoomBy(int step) {
        int cx = this.x + this.SpanW() / 2;
        int cy = this.y + this.SpanH() / 2;
        int level = Camera.LevelOf(this.zoomNum, this.zoomDen) + step;
        if (level < 0) { level = 0; }
        if (level > 2) { level = 2; }
        if (level == 0) { this.zoomNum = 1; this.zoomDen = 2; }
        if (level == 1) { this.zoomNum = 1; this.zoomDen = 1; }
        if (level == 2) { this.zoomNum = 2; this.zoomDen = 1; }
        this.x = cx - this.SpanW() / 2;
        this.y = cy - this.SpanH() / 2;
        this.Clamp();
    }

    static int LevelOf(int num, int den) {
        if (num == 1 && den == 2) { return 0; }
        if (num == 2 && den == 1) { return 2; }
        return 1;
    }

    /// <summary>Keeps the view inside the terrain. When the terrain is smaller
    /// than the view on an axis it is centred instead, so a small map does not
    /// stick to the top-left corner.</summary>
    void Clamp() {
        int spanW = this.SpanW();
        int spanH = this.SpanH();
        if (spanW >= this.worldW) {
            this.x = (this.worldW - spanW) / 2;
        } else {
            if (this.x < 0) { this.x = 0; }
            if (this.x > this.worldW - spanW) { this.x = this.worldW - spanW; }
        }
        if (spanH >= this.worldH) {
            this.y = (this.worldH - spanH) / 2;
        } else {
            if (this.y < 0) { this.y = 0; }
            if (this.y > this.worldH - spanH) { this.y = this.worldH - spanH; }
        }
    }
}
