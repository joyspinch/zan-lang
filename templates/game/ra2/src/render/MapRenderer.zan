using System;
using System.Collections.Generic;
using Ra2.Assets;
using Ra2.Formats;
using Ra2.Game;

namespace Ra2.Render;

/// <summary>Draws the visible part of a map's terrain into a view-sized image.</summary>
///
/// The whole map is far larger than any window -- a 105x95 map projects to
/// 6300x2865, which is 72 MB as an RGBA texture and close to the maximum
/// texture size on older GPUs. Only a window's worth is ever on screen, so the
/// terrain is never composited whole: each frame blits the cells that fall
/// inside the camera and skips the rest.
///
/// Cells are drawn back-to-front in x+y order. In an isometric view that is
/// the painter's order: a cell with a larger x+y is nearer the viewer and its
/// diamond overlaps the ones behind it, so raised ground and cliff faces only
/// occlude correctly when the far side is laid down first. The order is
/// computed once at load rather than per frame.
class MapRenderer {
    IsoMap iso;
    Theater theater;
    List<int> order;      // cell indices, back to front
    int originX;          // world (0,0) in projected pixels
    int originY;
    int worldW;
    int worldH;
    World world;          // objects drawn on top; null until the game sets one
    ObjectArt art;
    int playerSide;       // Side2 of the human player, for selection colours
    int gemFirst;         // first ore overlay index, -1 when the rules list none
    // Per-cell draw records, resolved once at load: the projected screen
    // position relative to the origin, the tile texture and its draw
    // offsets. RenderInto then reads them instead of re-projecting every
    // cell and re-resolving the texture each frame -- the composite is the
    // game's frame-budget hotspot, and the projection math per cell was
    // most of its cost.
    List<int> cellSx;
    List<int> cellSy;
    List<Texture> cellTex;
    List<int> cellOx;
    List<int> cellOy;
    // [Terrain] scatter (trees, rocks), sorted back-to-front like cells: the
    // parallel arrays hold cell x, cell y, level and the art name.
    List<int> terrX;
    List<int> terrY;
    List<int> terrLevel;
    List<string> terrName;
    // Static overlays + low bridges, pre-projected into painter order at
    // SetWorld time so the terrain recomposite walks flat arrays (a busy
    // field recomposites often; per-draw projection there is what showed
    // in the frame budget). Static: cell + art name + data frame. Bridge:
    // middle-cell screen spot + type + variant value.
    List<int> stOvIdx;
    List<string> stOvName;
    List<int> stOvData;
    List<int> brMidX;
    List<int> brMidY;
    List<int> brKind;     // 0 wood, 1 concrete
    List<int> brValue;
    // Map smudges ([Smudge] decals: craters, burn marks), in painter order
    // like the terrain scatter. Resolved once at load into screen positions
    // and art, so RenderInto's loop is array reads.
    List<int> smX;
    List<int> smY;
    List<string> smName;
    // Name -> decal texture, built on first draw. The install this builds
    // against carries no smudge art at all, so every entry resolves to the
    // procedural decal; the cache still keys by name so an install that does
    // ship CRATER*.SHP gets its own art per reg.
    List<string> smTexNames;
    List<Texture> smTex;

    /// <summary>The pixel size of a map's full diamond, and the offset that
    /// shifts it into positive coordinates.</summary>
    ///
    /// Cell (0,0) projects to x=0 but cell (0,span) projects to -span*30, so
    /// the left half of the map sits at negative x. The bounds come from the
    /// cells the map actually carries rather than the declared size, because
    /// IsoMapPack5 covers the whole (w+h) square.
    static void Bounds(IsoMap iso, List<int> out4) {
        int minX = 0;
        int maxX = 0;
        int minY = 0;
        int maxY = 0;
        bool any = false;
        for (int i = 0; i < iso.Count(); i = i + 1) {
            IsoTile t = iso.TileAt(i);
            int sx = IsoProjection.ScreenX(t.X(), t.Y());
            int sy = IsoProjection.ScreenY(t.X(), t.Y(), t.Level());
            if (!any) {
                minX = sx; maxX = sx; minY = sy; maxY = sy;
                any = true;
            }
            if (sx < minX) { minX = sx; }
            if (sx > maxX) { maxX = sx; }
            if (sy < minY) { minY = sy; }
            if (sy > maxY) { maxY = sy; }
        }
        // maxX/maxY are apex positions; a tile extends a further tile past them.
        MapRenderer.SetSlot(out4, 0, minX);
        MapRenderer.SetSlot(out4, 1, minY);
        MapRenderer.SetSlot(out4, 2, maxX - minX + IsoProjection.TileW());
        MapRenderer.SetSlot(out4, 3, maxY - minY + IsoProjection.TileH());
    }

    static MapRenderer Create(IsoMap iso, Theater theater) {
        MapRenderer m = new MapRenderer();
        m.iso = iso;
        m.theater = theater;
        List<int> b = new List<int>();
        MapRenderer.Bounds(iso, b);
        m.originX = b[0];
        m.originY = b[1];
        m.worldW = b[2];
        m.worldH = b[3];
        m.order = MapRenderer.BuildOrder(iso);
        m.world = null;
        m.art = null;
        m.BuildCellRecords();
        return m;
    }

    /// <summary>Walks the painter order once and stores each cell's screen
    /// position, tile texture and draw offsets, so RenderInto's hot loop is
    /// array reads and a cull test.</summary>
    void BuildCellRecords() {
        this.cellSx = new List<int>();
        this.cellSy = new List<int>();
        this.cellTex = new List<Texture>();
        this.cellOx = new List<int>();
        this.cellOy = new List<int>();
        for (int i = 0; i < this.order.Count; i = i + 1) {
            IsoTile t = this.iso.TileAt(this.order[i]);
            this.cellSx.Add(IsoProjection.ScreenX(t.X(), t.Y())
                            - this.originX);
            this.cellSy.Add(IsoProjection.ScreenY(t.X(), t.Y(), t.Level())
                            - this.originY);
            Texture tile = this.theater.TileTexture(t.Tile(), t.SubTile());
            this.cellTex.Add(tile);
            if (tile != null) {
                // Cliff overhangs extend above and left of the diamond, so
                // the texture's own origin is offset from the cell apex.
                this.cellOx.Add(this.theater.DrawOffsetX(t.Tile(),
                                                         t.SubTile()));
                this.cellOy.Add(this.theater.DrawOffsetY(t.Tile(),
                                                         t.SubTile()));
            } else {
                this.cellOx.Add(0);
                this.cellOy.Add(0);
            }
        }
    }

    /// <summary>Gives the renderer the game's objects to draw. The map renderer
    /// is created before a game's world exists, so this is set when a game
    /// starts and never unset within a game.</summary>
    void SetWorld(World world, ObjectArt art, int playerSide) {
        this.world = world;
        this.art = art;
        this.playerSide = playerSide;
        // The ore art: the first ore overlay index (rulesmd.ini's GEM01 is
        // [OverlayTypes] key 28 -> index 27). The draw picks GEM(1+first) for
        // gold and GEM(7+first) for the doubled crystal fields, then uses the
        // cell's amount as the SHP frame.
        Rules rules = world.Rules();
        this.gemFirst = rules != null ? rules.FirstOreOverlay() : -1;
        this.ProjectOverlays();
    }

    /// <summary>Pre-projects the world's static overlays and bridge
    /// pieces into painter order (x+y, then level) -- the SetTerrain
    /// pattern. Called from SetWorld and after any wholesale bridge or
    /// overlay change the world reports; the per-cell ore/wall loops
    /// stay where they are (they carry live per-frame state: amounts,
    /// connection masks, damaged frames).</summary>
    void ProjectOverlays() {
        if (this.world == null) { return; }
        this.stOvIdx = new List<int>();
        this.stOvName = new List<string>();
        this.stOvData = new List<int>();
        this.brMidX = new List<int>();
        this.brMidY = new List<int>();
        this.brKind = new List<int>();
        this.brValue = new List<int>();
        Rules rules = this.world.Rules();
        List<int> keys = new List<int>();
        int span = this.world.Width() > this.world.Height()
            ? this.world.Width() : this.world.Height();
        // A linear walk over the world grid is too big (512x512 worst
        // case); the order indices give painter order for free.
        for (int i = 0; i < this.order.Count; i = i + 1) {
            IsoTile t = this.iso.TileAt(this.order[i]);
            int ov = this.world.StaticOvAt(t.X(), t.Y());
            if (ov < 0 || rules == null) { continue; }
            string name = rules.OverlayName(ov);
            if (name == null || name.Length == 0) { continue; }
            int key = t.X() + t.Y();
            int at = 0;
            while (at < keys.Count && keys[at] <= key) { at = at + 1; }
            keys.Insert(at, key);
            this.stOvIdx.Insert(at, this.order[i]);
            this.stOvName.Insert(at, name);
            this.stOvData.Insert(at, this.world.StaticDataAt(t.X(), t.Y()));
        }
        for (int bi = 0; bi < this.world.BridgePieceCount(); bi = bi + 1) {
            int slot = this.world.BridgeSlotAt(bi);
            if (slot < 0) { continue; }
            int btx = slot % this.world.Width();
            int bty = slot / this.world.Width();
            int id = this.world.BridgeIdAt(bi);
            if (id < 0) { continue; }
            int fx = this.world.BridgeFlagsAt(btx, bty);
            bool axisY = (fx & 4) != 0;
            int midX = axisY ? btx : btx + 1;
            int midY = axisY ? bty + 1 : bty;
            int key = midX + midY;
            int at = 0;
            while (at < keys.Count && keys[at] <= key) { at = at + 1; }
            keys.Insert(at, key);
            this.brMidX.Insert(at, midX);
            this.brMidY.Insert(at, midY);
            this.brKind.Insert(at, id >= 205 ? 1 : 0);
            this.brValue.Insert(at, id - (id >= 205 ? 205 : 74));
        }
    }

    /// <summary>Takes the map's [Terrain] objects, sorted into painter order
    /// (x+y, then level) so a tree in front covers the one behind it.</summary>
    void SetTerrain(MapFile map) {
        this.terrX = new List<int>();
        this.terrY = new List<int>();
        this.terrLevel = new List<int>();
        this.terrName = new List<string>();
        List<int> keys = new List<int>();
        for (int i = 0; i < map.TerrainCount(); i = i + 1) {
            int x = map.TerrainX(i);
            int y = map.TerrainY(i);
            int lvl = 0;
            IsoTile cell = this.iso.At(x, y);
            if (cell != null) { lvl = cell.Level(); }
            int key = (x + y) * 64 + lvl;
            int at = 0;
            while (at < keys.Count && keys[at] <= key) { at = at + 1; }
            keys.Insert(at, key);
            this.terrX.Insert(at, x);
            this.terrY.Insert(at, y);
            this.terrLevel.Insert(at, lvl);
            this.terrName.Insert(at, map.TerrainType(i));
        }
    }

    /// <summary>Takes the map's [Smudge] decals into painter order (x+y), so a
    /// crater in front covers the one behind it the way the scatter does.
    /// These come from the map file, not the world: a smudge has no owner, no
    /// health and no occupancy, so it never becomes a world object.</summary>
    void SetSmudges(MapFile map) {
        this.smX = new List<int>();
        this.smY = new List<int>();
        this.smName = new List<string>();
        List<int> keys = new List<int>();
        for (int i = 0; i < map.SmudgeCount(); i = i + 1) {
            List<string> f = new List<string>();
            if (!map.SmudgeEntry(i, f)) { continue; }
            int x = Convert.ToInt32(f[1]);
            int y = Convert.ToInt32(f[2]);
            int key = x + y;
            int at = 0;
            while (at < keys.Count && keys[at] <= key) { at = at + 1; }
            keys.Insert(at, key);
            this.smX.Insert(at, x);
            this.smY.Insert(at, y);
            this.smName.Insert(at, f[0].ToUpper());
        }
    }

    int WorldWidth() { return this.worldW; }    int WorldHeight() { return this.worldH; }
    int CellCount() { return this.order.Count; }
    int OriginX() { return this.originX; }
    int OriginY() { return this.originY; }

    /// <summary>Cell indices sorted back-to-front by x+y, then by elevation.</summary>
    ///
    /// Bucketed rather than compared: the key is a small dense integer, so
    /// this is linear and needs no comparator. The buckets are singly-linked
    /// through a flat next[] array so a 20k-cell map does not allocate a List
    /// per bucket.
    ///
    /// Elevation is folded into the key beneath x+y. A raised cell is drawn
    /// `level * 15` pixels higher than flat ground, which uncovers the space
    /// it would otherwise have filled; the cells behind and below it have to
    /// be laid down first for that gap to be painted over. Ordering by x+y
    /// alone left transparent diamonds wherever a cliff rose above its
    /// neighbours -- every hole on MP01T4 sat on a cell with level > 0.
    static List<int> BuildOrder(IsoMap iso) {
        int maxDepth = 0;
        int maxLevel = 0;
        int i = 0;
        for (; i < iso.Count(); i = i + 1) {
            IsoTile t = iso.TileAt(i);
            int d = t.X() + t.Y();
            if (d > maxDepth) { maxDepth = d; }
            if (t.Level() > maxLevel) { maxLevel = t.Level(); }
        }
        int levels = maxLevel + 1;
        int maxKey = maxDepth * levels + maxLevel;

        List<int> heads = new List<int>();
        int k = 0;
        for (; k <= maxKey; k = k + 1) { heads.Add(-1); }
        List<int> next = new List<int>();
        i = 0;
        while (i < iso.Count()) { next.Add(-1); i = i + 1; }
        i = iso.Count() - 1;
        while (i >= 0) {
            IsoTile t = iso.TileAt(i);
            int key = (t.X() + t.Y()) * levels + t.Level();
            next[i] = heads[key];
            heads[key] = i;
            i = i - 1;
        }

        List<int> order = new List<int>();
        k = 0;
        while (k <= maxKey) {
            int at = heads[k];
            while (at >= 0) {
                order.Add(at);
                at = next[at];
            }
            k = k + 1;
        }
        return order;
    }

    /// <summary>Blits every cell that falls inside the camera into `canvas`,
    /// which the caller sizes to the view and clears. Returns the number of
    /// cells actually drawn, so a caller can see the culling working.</summary>
    int RenderInto(Texture canvas, int camX, int camY) {
        int drawn = 0;
        int cw = canvas.Width();
        int ch = canvas.Height();
        bool trace = RenderTrace();
        // Generous reject margins: a tile is anchored at its apex and
        // extends one tile right and down, and cliff art reaches further
        // still.
        int marginW = IsoProjection.TileW() * 2;
        int marginH = IsoProjection.TileH() * 4;
        for (int i = 0; i < this.order.Count; i = i + 1) {
            int sx = this.cellSx[i] - camX;
            int sy = this.cellSy[i] - camY;
            if (sx > 0 - marginW && sx < cw
             && sy > 0 - marginH && sy < ch) {
                Texture tile = this.cellTex[i];
                if (tile != null) {
                    canvas.Blit(tile, sx + this.cellOx[i],
                                sy + this.cellOy[i]);
                    drawn = drawn + 1;
                }
                if (trace && sx >= 280 && sx <= 580 && sy >= 130 && sy <= 360) {
                    IsoTile t = this.iso.TileAt(this.order[i]);
                    Console.WriteLine("cell " + Convert.ToString(t.X()) + ","
                        + Convert.ToString(t.Y()) + " lvl="
                        + Convert.ToString(t.Level()) + " tile="
                        + Convert.ToString(t.Tile()) + " sub="
                        + Convert.ToString(t.SubTile()) + " at "
                        + Convert.ToString(sx) + "," + Convert.ToString(sy)
                        + (tile == null ? " NULLTEX" : ""));
                }
            }
        }

        // Map smudges draw right after the ground: a crater is part of the
        // terrain, so trees and everything that moves go over it.
        if (this.smX != null) {
            for (int i = 0; i < this.smX.Count; i = i + 1) {
                int sx = IsoProjection.ScreenX(this.smX[i], this.smY[i])
                       - this.originX - camX;
                int sy = IsoProjection.ScreenY(this.smX[i], this.smY[i], 0)
                       - this.originY - camY;
                if (sx <= 0 - IsoProjection.TileW() || sx >= cw
                 || sy <= 0 - IsoProjection.TileH() || sy >= ch) {
                    continue;
                }
                Texture decal = this.SmudgeTexture(this.smName[i]);
                if (decal == null) { continue; }
                canvas.Blit(decal, sx + IsoProjection.TileW() / 2
                                   - decal.Width() / 2,
                            sy + IsoProjection.TileH() / 2
                                   - decal.Height() / 2);
                drawn = drawn + 1;
            }
        }

        // Terrain scatter draws after the flat tiles: trees and rocks stand
        // on the ground and must cover the tiles behind them, but sit under
        // anything that moves.
        if (this.terrX != null) {
            for (int i = 0; i < this.terrX.Count; i = i + 1) {
                int sx = IsoProjection.ScreenX(this.terrX[i], this.terrY[i])
                       - this.originX - camX;
                int sy = IsoProjection.ScreenY(this.terrX[i], this.terrY[i],
                                               this.terrLevel[i])
                       - this.originY - camY;
                if (sx <= 0 - IsoProjection.TileW() * 2 || sx >= cw
                 || sy <= 0 - IsoProjection.TileH() * 6 || sy >= ch) {
                    continue;
                }
                string name = this.terrName[i];
                if (name.Length == 0) { continue; }
                Texture spr = this.theater.TerrainSprite(name);
                if (spr == null) { continue; }
                // A scatter sprite stands on its cell: the art's bottom-centre
                // sits at the diamond's centre.
                int px = sx + IsoProjection.TileW() / 2 - spr.Width() / 2;
                int py = sy + IsoProjection.TileH() / 2 - spr.Height();
                canvas.Blit(spr, px, py);
                drawn = drawn + 1;
            }
        }

        // Ore fields lie on the ground, under everything that moves. The art
        // is the install's own GEM overlay: GEM01.TEM .. GEM12.TEM, 60x60 with
        // 24 frames, one frame per wealth level -- the original picks the frame
        // straight from the overlay's value byte, so a cell's ore amount maps
        // to the frame that draws exactly that density.
        if (this.world != null) {
            int gemFirst = this.gemFirst;
            for (int i = 0; i < this.order.Count; i = i + 1) {
                IsoTile t = this.iso.TileAt(this.order[i]);
                int amt = this.world.OreAt(t.X(), t.Y());
                if (amt <= 0) { continue; }
                int sx = IsoProjection.ScreenX(t.X(), t.Y()) - this.originX
                       - camX;
                int sy = IsoProjection.ScreenY(t.X(), t.Y(), t.Level())
                       - this.originY - camY;
                if (sx > 0 - IsoProjection.TileW() && sx < cw
                 && sy > 0 - IsoProjection.TileH() && sy < ch) {
                    int kind = this.world.OreValueAt(t.X(), t.Y()) >= 2 ? 1 : 0;
                    // The cell's own overlay id first (the growth's TIB01..
                    // fields are not GEM art); the GEM pair by value, then
                    // the procedural lumps, as before.
                    Texture ore = null;
                    int oov = this.world.OreOvAt(t.X(), t.Y());
                    if (oov >= 0) {
                        string on = this.world.Rules().OverlayName(oov);
                        if (on != null && on.Length > 0) {
                            int oframes = this.theater.OverlayFrameCount(on);
                            if (oframes > 0) {
                                int of = amt;
                                if (of >= oframes) { of = oframes - 1; }
                                ore = this.theater.OverlaySprite(on, of);
                            }
                        }
                    }
                    if (ore == null) {
                        ore = this.OreTexture(gemFirst + kind * 6, amt);
                    }
                    if (ore == null) {
                        int bucket = amt >= 12 ? 7 : amt * 8 / 12;
                        ore = this.OreSprite(bucket, kind);
                    }
                    // Overlay art sits on the cell bottom-aligned: the 60x60
                    // GEM canvas carries its grain cluster at the very bottom
                    // (content spans y 31..58), so the canvas' bottom edge lands
                    // on the tile's bottom corner. Anchoring on the canvas
                    // centre instead lifted the field half a tile up and
                    // scattered the grains clear off the terrain. The
                    // procedural fallback is tile-sized (60x30), where the
                    // bottom-aligned form is the same as centring.
                    int px = sx + IsoProjection.TileW() / 2 - ore.Width() / 2;
                    int py = sy + IsoProjection.TileH() - ore.Height();
                    canvas.Blit(ore, px, py);
                    drawn = drawn + 1;
                }
            }
        }

        // Low bridges span their cells: one assembled sprite per piece,
        // centred on the middle cell of its three-cell span (the
        // reference's container offset -- anchor plus one and a half tiles
        // along the span). The piece's overlay id picks the variant frame
        // from the assembled LOBRDG/LOBRDB set, so a wounded or dangling
        // piece draws the damaged or dropped-end art the chain state
        // names. Bridge art rides over the water tiles it crosses and
        // under everything that moves.
        if (this.brMidX != null) {
            for (int bi = 0; bi < this.brMidX.Count; bi = bi + 1) {
                int msx = IsoProjection.ScreenX(this.brMidX[bi],
                                                this.brMidY[bi])
                        - this.originX - camX;
                int msy = IsoProjection.ScreenY(this.brMidX[bi],
                                                this.brMidY[bi], 0)
                        - this.originY - camY;
                Texture spr = this.theater.LowBridgeSprite(
                    this.brKind[bi] == 1, this.brValue[bi]);
                if (spr == null) { continue; }
                int px = msx + IsoProjection.TileW() / 2 - spr.Width() / 2;
                int py = msy + IsoProjection.TileH() / 2 - spr.Height() / 2;
                canvas.Blit(spr, px, py);
                drawn = drawn + 1;
            }
        }

        // Walls stand on their cells like the ore under them: the world's
        // live wall grid (seeded from the map, mutated by the battle) is
        // the authority. The data plane is the connection mask -- N + 2E
        // + 4S + 8W, the reference's wallTypes frame order -- and a hurt
        // wall draws the damaged connection set: frame + 16, or + 1 when
        // the art never shipped a full intact set (the reference's
        // Overlay computeFrame).
        if (this.world != null) {
            Rules wrules = this.world.Rules();
            for (int i = 0; i < this.order.Count; i = i + 1) {
                IsoTile t = this.iso.TileAt(this.order[i]);
                int ov = this.world.WallOvAt(t.X(), t.Y());
                if (ov < 0) { continue; }
                int sx = IsoProjection.ScreenX(t.X(), t.Y()) - this.originX
                       - camX;
                int sy = IsoProjection.ScreenY(t.X(), t.Y(), t.Level())
                       - this.originY - camY;
                if (sx <= 0 - IsoProjection.TileW() || sx >= cw
                 || sy <= 0 - IsoProjection.TileH() || sy >= ch) {
                    continue;
                }
                string name = wrules != null ? wrules.OverlayName(ov) : "";
                if (name.Length == 0) { continue; }
                int frames = this.theater.OverlayFrameCount(name);
                if (frames <= 0) { continue; }
                int frame = this.world.WallDataAt(t.X(), t.Y());
                if (this.world.WallDamagedAt(t.X(), t.Y())) {
                    frame = frame + (frames < 16 ? 1 : 16);
                }
                if (frame >= frames) { frame = frames - 1; }
                Texture spr = this.theater.OverlaySprite(name, frame);
                if (spr == null) { continue; }
                // Overlay art sits bottom-aligned on the diamond (the ore
                // loop's anchor): the wall base meets the tile's bottom
                // corner.
                int px = sx + IsoProjection.TileW() / 2 - spr.Width() / 2;
                int py = sy + IsoProjection.TileH() - spr.Height();
                canvas.Blit(spr, px, py);
                drawn = drawn + 1;
            }
        }

        // Static overlays -- the map's rocks, fences, crates and tracks
        // that are neither ore, wall nor bridge -- draw bottom-aligned on
        // their cells like the walls do, the data byte picking the art
        // frame. They are decals: no health, no occupancy, but their
        // Land= overrides the ground class, which is what sinks a unit's
        // passability into a rock or holds a fence line.
        if (this.stOvName != null) {
            for (int i = 0; i < this.stOvName.Count; i = i + 1) {
                IsoTile t = this.iso.TileAt(this.stOvIdx[i]);
                int sx = IsoProjection.ScreenX(t.X(), t.Y()) - this.originX
                       - camX;
                int sy = IsoProjection.ScreenY(t.X(), t.Y(), t.Level())
                       - this.originY - camY;
                if (sx <= 0 - IsoProjection.TileW() || sx >= cw
                 || sy <= 0 - IsoProjection.TileH() || sy >= ch) {
                    continue;
                }
                int frames = this.theater.OverlayFrameCount(
                    this.stOvName[i]);
                if (frames <= 0) { continue; }
                int frame = this.stOvData[i];
                if (frame >= frames) { frame = frames - 1; }
                if (frame < 0) { frame = 0; }
                Texture spr = this.theater.OverlaySprite(this.stOvName[i],
                                                         frame);
                if (spr == null) { continue; }
                int px = sx + IsoProjection.TileW() / 2 - spr.Width() / 2;
                int py = sy + IsoProjection.TileH() - spr.Height();
                canvas.Blit(spr, px, py);
                drawn = drawn + 1;
            }
        }

        // Objects do NOT bake into this canvas: the terrain layer only
        // changes when the camera, the ore or a smudge does, so the
        // expensive full-frame recomposite+encode runs on those events
        // alone. Units draw live over the composited terrain every frame
        // (ObjectRenderer.RenderToCanvas) -- a moving unit costs a handful
        // of small blits instead of a whole-screen rebuild.
        return drawn;
    }

    static void SetSlot(List<int> list, int slot, int v) {
        while (list.Count <= slot) { list.Add(0); }
        list[slot] = v;
    }

    /// <summary>The decal texture for a smudge reg. The shipped art is
    /// CRATER*.SHP / BURNT*.SHP under the theater's palette, with the
    /// theater's own letter in the file name's second slot (CRAtER07.SHP on
    /// a temperate map) since every smudge art section is Theater=yes. The
    /// install this runs against ships none of them, so the procedural decal
    /// is the normal path here; the art path is kept because the original's
    /// look comes from those files and an install that has them should use
    /// them.
    ///
    /// The procedural form keys off the name: CRATER* is a dark ringed pit,
    /// BURNT* a blackened scorch whose size grows with the reg's number --
    /// which is exactly the progression the shipped art follows (CRATER11/12
    /// and BURNT07/08 are the 2x2 "Width=" oversized ones in the rules).
    /// Which of the two a name is matters more than its exact number: a
    /// crater reads as a pit, a burn as a stain.</summary>
    Texture SmudgeTexture(string name) {
        if (this.smTex == null) {
            this.smTexNames = new List<string>();
            this.smTex = new List<Texture>();
        }
        for (int i = 0; i < this.smTexNames.Count; i = i + 1) {
            if (this.smTexNames[i] == name) { return this.smTex[i]; }
        }
        Texture tex = this.theater.SmudgeSprite(name);
        bool crater = MapRenderer.HasPrefix(name, "CRATER");
        bool burnt = MapRenderer.HasPrefix(name, "BURNT");
        if (tex == null && (crater || burnt)) {
            tex = MapRenderer.ProceduralSmudge(name, crater);
        }
        this.smTexNames.Add(name);
        this.smTex.Add(tex);
        return tex;
    }

    static bool HasPrefix(string s, string p) {
        if (s == null || s.Length < p.Length) { return false; }
        for (int i = 0; i < p.Length; i = i + 1) {
            if (s[i] != p[i]) { return false; }
        }
        return true;
    }

    /// <summary>The trailing number of a reg ("CRATER07" -> 7), 0 when it has
    /// none. Sizes the procedural decal like the shipped art does.</summary>
    static int TrailingNumber(string s) {
        int n = 0;
        bool any = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 0xFF;
            if (c >= 48 && c <= 57) {
                n = n * 10 + (c - 48);
                any = true;
            }
        }
        return any ? n : 0;
    }

    /// <summary>A drawn stand-in for a smudge decal, on a tile-sized canvas.
    /// A crater is a dark pit with a lit rim on its north-west side (the sun
    /// side, matching the object shading); a burn is a soft black stain. The
    /// third value in a smudge entry is a frame byte, but nothing in this
    /// install's rules varies the art per frame, so one shape each is right.
    /// Alpha is per-pixel so the decal blends into the ground instead of
    /// stamping a square.</summary>
    static Texture ProceduralSmudge(string name, bool crater) {
        int w = IsoProjection.TileW();
        int h = IsoProjection.TileH();
        int size = ProceduralSmudgeSize(name, crater);
        Texture tex = Texture.Create(w, h);
        int cx = w / 2;
        int cy = h / 2;
        // The iso diamond's inscribed ellipse, in half-extents.
        int rx = size;
        int ry = size / 2;
        for (int y = 0; y < h; y = y + 1) {
            for (int x = 0; x < w; x = x + 1) {
                int dx = x - cx;
                int dy = (y - cy) * 2;
                int d = MapRenderer.Ellipse(dx, dy, rx, ry);
                if (d > 100) { continue; }
                int a;
                int r;
                int g;
                int b;
                if (crater) {
                    // A pit: near-black floor, with a rim that brightens
                    // toward the north-west (negative dx, negative dy).
                    if (d > 78) {
                        int lit = (0 - dx) + (0 - dy);
                        int lr = 150;
                        int lg = 138;
                        int lb = 120;
                        if (lit > 0) { lr = 190; lg = 178; lb = 156; }
                        r = lr; g = lg; b = lb;
                        a = 150;
                    } else {
                        r = 26; g = 24; b = 22;
                        a = 170 - d;
                        if (a < 90) { a = 90; }
                    }
                } else {
                    // A burn: soot that fades out toward the edge.
                    r = 20; g = 18; b = 17;
                    a = 130 - d;
                    if (a < 20) { continue; }
                }
                tex.SetPixel(y * w + x, r, g, b, a);
            }
        }
        return tex;
    }

    /// <summary>How wide a procedural smudge spreads, in pixels of half-axis.
    /// The bigger reg numbers are the bigger decals, and the two 2x2 craters
    /// (CRATER11/12) are wider still -- the rules mark those Width=2.</summary>
    static int ProceduralSmudgeSize(string name, bool crater) {
        int n = MapRenderer.TrailingNumber(name);
        int half = crater ? 12 : 10;
        int grow = n / 4;
        int size = half + grow;
        if (crater && n >= 11) { size = size + 6; }
        if (size > IsoProjection.TileW() / 2) { size = IsoProjection.TileW() / 2; }
        return size;
    }

    /// <summary>Scaled distance from an ellipse's centre: 0 at the centre,
    /// 100 on the edge, beyond 100 outside. Integer math so no float creeps
    /// into the per-pixel loop.</summary>
    static int Ellipse(int dx, int dy, int rx, int ry) {
        if (rx <= 0 || ry <= 0) { return 999; }
        int v = (dx * 100 / rx) * (dx * 100 / rx)
              + (dy * 100 / ry) * (dy * 100 / ry);
        if (v > 10000) { return 999; }
        return v / 100;
    }

    [DllImport("crt")]
    static extern string getenv(string name);

    static bool RenderTrace() {
        string v = RenderTraceEnv();
        return v != null && v.Length > 0 && v != "0";
    }

    static string RenderTraceEnv() {
        return getenv("RA2_TRACE");
    }

    // The ore sprite cache: eight wealth buckets per kind (gold ore, gem
    // crystal), built on first use. Bucket 0 is a bare scatter, bucket 7 a
    // packed field -- the drawn density tracks the cell's ore amount the way
    // the original's overlay frames do. Only the fallback path uses these:
    // the install ships the real GEM art, so they appear only when a theater
    // lacks it.
    List<Texture> oreSprites;

    /// <summary>The install's own ore overlay art: the GEM SHP for a cell's
    /// overlay kind, at the frame its amount selects. `overlayIndex` is the
    /// rules' [OverlayTypes] index (gemFirst for gold, gemFirst+6 for crystal);
    /// the frame is the ore amount, clamped to the art's frame count -- the
    /// original stores 12 wealth levels per GEM in a 24-frame file whose tail
    /// frames are empty, and the cell's value byte is the frame number.
    /// Returns null when the theater has no art for the name, so the caller
    /// can fall back to the procedural lumps.</summary>
    Texture OreTexture(int overlayIndex, int amount) {
        if (overlayIndex < 0 || this.theater == null || this.world == null) {
            return null;
        }
        Rules rules = this.world.Rules();
        if (rules == null) { return null; }
        string name = rules.OverlayName(overlayIndex);
        if (name == null || name.Length == 0) { return null; }
        int frames = this.theater.OverlayFrameCount(name);
        if (frames <= 0) { return null; }
        int frame = amount;
        if (frame >= frames) { frame = frames - 1; }
        if (frame < 0) { frame = 0; }
        return this.theater.OverlaySprite(name, frame);
    }

    /// <summary>The ore sprite for a wealth bucket and kind. Kind 0 is the
    /// plain gold ore (GEM01..06), kind 1 the doubled-value crystal fields
    /// (GEM07..12): golds versus icy blues, readable at a glance.</summary>
    Texture OreSprite(int bucket, int kind) {
        if (this.oreSprites == null) { this.oreSprites = new List<Texture>(); }
        int slot = bucket * 2 + kind;
        // The list fills in whatever order buckets are first demanded, so a
        // high slot can be materialised before a low one. A null in the slot
        // means "not built yet", never "no art" -- fall through and build it.
        if (slot < this.oreSprites.Count && this.oreSprites[slot] != null) {
            return this.oreSprites[slot];
        }
        while (this.oreSprites.Count <= slot) { this.oreSprites.Add(null); }

        int w = IsoProjection.TileW();
        int h = IsoProjection.TileH();
        Texture tex = Texture.Create(w, h);
        int cx = w / 2;
        int cy = h / 2;
        int lumps = 2 + bucket;
        for (int i = 0; i < lumps; i = i + 1) {
            // A fixed pseudo-scatter: same every game, spread inside the
            // diamond by rejecting points off its inscribed ellipse.
            int px = (i * 37 + bucket * 13 + kind * 7 + 5) % (w - 4) + 2;
            int py = (i * 23 + bucket * 5 + kind * 3 + 2) % (h - 2) + 1;
            for (int tries = 0; tries < 6; tries = tries + 1) {
                int dx = (px - cx) * h;
                int dy = (py - cy) * w;
                if (dx * dx / (w * w) + dy * dy / (h * h) <= 1) { break; }
                if (px > cx) { px = px - 1; } else { px = px + 1; }
                if (py > cy) { py = py - 1; } else { py = py + 1; }
            }
            // A lump: a 2x2 body with one bright face, gold or ice.
            int br = kind == 1 ? 96 : 198;
            int bg = kind == 1 ? 180 : 146;
            int bb = kind == 1 ? 240 : 58;
            for (int yy = 0; yy < 2; yy = yy + 1) {
                for (int xx = 0; xx < 2; xx = xx + 1) {
                    tex.SetPixel((py + yy) * w + px + xx, br, bg, bb, 255);
                }
            }
            tex.SetPixel(py * w + px, kind == 1 ? 224 : 240,
                         kind == 1 ? 244 : 202, kind == 1 ? 252 : 122, 255);
        }
        this.oreSprites[slot] = tex;
        return tex;
    }

    /// <summary>Draws a whole-map thumbnail into a canvas of any size.</summary>
    ///
    /// One pixel per cell rather than a scaled-down render: a map is thousands
    /// of tiles and compositing them all just to shrink the result would cost
    /// a second per preview. The colour is sampled from the tile's own art, so
    /// water reads blue and cliffs grey without a lookup table.
    void RenderPreview(Texture canvas) {
        int cw = canvas.Width();
        int ch = canvas.Height();
        if (cw <= 0 || ch <= 0) { return; }

        for (int i = 0; i < this.order.Count; i = i + 1) {
            IsoTile t = this.iso.TileAt(this.order[i]);
            // Project, then squeeze the map's own bounds into the canvas.
            int wx = IsoProjection.ScreenX(t.X(), t.Y()) - this.originX;
            int wy = IsoProjection.ScreenY(t.X(), t.Y(), t.Level()) - this.originY;
            int px = wx * cw / this.worldW;
            int py = wy * ch / this.worldH;
            if (px >= 0 && py >= 0 && px < cw && py < ch) {
                Texture tile = this.theater.TileTexture(t.Tile(), t.SubTile());
                if (tile != null) {
                    // The diamond's centre is the most representative pixel;
                    // its corners are transparent.
                    int c = tile.PixelAt(tile.Width() / 2, tile.Height() / 2);
                    if (((c >> 24) & 0xFF) != 0) {
                        canvas.SetPixel(py * cw + px, (c >> 16) & 0xFF,
                                        (c >> 8) & 0xFF, c & 0xFF, 255);
                    }
                }
            }
        }
    }
}
